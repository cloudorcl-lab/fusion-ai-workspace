  "workflowCode": "ORA_NL_SEGMENTS_V20",
  "name": "Natural Language Segments",
  "description": "The Natural Language Segments enables users to query enterprise data without writing SQL manually.\nUsers can input natural language queries (e.g., “Show me the top 10 customers by revenue last quarter”), and the system translates these into executable SQL statements targeting underlying logical data model.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
