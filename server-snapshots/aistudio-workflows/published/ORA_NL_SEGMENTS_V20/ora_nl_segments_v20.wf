        {
          "metadata": {
            "name": "Get Conversation ID",
            "returnType": "array",
            "sourceCode": "let chatHistory = $context.$system.$chatHistory;\nif (!chatHistory) return null;\n\n// Split by AI: and take the last block\nconst aiBlocks = chatHistory.split('AI:');\nconst lastAIBlock = aiBlocks[aiBlocks.length - 1];\n\n// Normalize escaped content\nconst normalized = lastAIBlock\n  .replace(/\\\\n/g, '\\n')\n  .replace(/\\\\t/g, ' ')\n  .replace(/\\\\\"/g, '\"')\n  .replace(/&lt;/g, '<')\n  .replace(/&gt;/g, '>')\n  .replace(/&amp;/g, '&')\n  .replace(/&#39;/g, \"'\")\n  .replace(/&quot;/g, '\"');\n\n// Regex to extract SQL Query\nconst sqlRegex = /<b[^>]*>\\s*SQL Query:\\s*(?:<\\/b>)?\\s*([\\s\\S]*?)(?=<br>|<\\/b>)/i;\n              \n\n// Regex to extract conversationID\nconst convIdRegex = /<b[^>]*>\\s*conversationID\\s*([A-Za-z0-9-]+)\\s*<\\/b>/i;\n\n// Regex to extract sql explain\nconst explainRegex = /<b[^>]*>\\s*explain:\\s*([\\s\\S]*?)\\s*<\\/b>/i;\n\n  \n\n// Apply regex\nconst sqlMatch = normalized.match(sqlRegex);\nconst convMatch = normalized.match(convIdRegex);\nconst explainMatch = normalized.match(explainRegex);\n\n// Return extracted values\n\nconst result = [\n  convMatch ? convMatch[1] : null,\n  sqlMatch ? sqlMatch[1].trim() : null,\n  explainMatch ? explainMatch[1].trim() : null\n\n];\n\nreturn result;"
          },
          "outcomes": {
            "success": "1764570404585"
          },
          "code": "GET_CONVERSATION_ID",
          "id": "1764570306489",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
