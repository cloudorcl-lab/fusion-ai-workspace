            "name": "getOptyESPayload",
            "returnType": "object",
            "sourceCode": "let partyNumber = $context.$triggers.REST.$input?.action?.config?.accountNumber;\n \nconst output = {}; \noutput.filter = {\n     'op': '$and', \n     'criteria': [{\n           'op': '$eq', \n           'attribute': 'CustomerAccount.PartyNumber', \n           'value': partyNumber\n      }] \n}; \n\nreturn output;"
