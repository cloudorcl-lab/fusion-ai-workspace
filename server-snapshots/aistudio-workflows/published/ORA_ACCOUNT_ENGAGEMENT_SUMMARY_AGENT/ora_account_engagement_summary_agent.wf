          "id": "1775512232049",
          "code": "GENERATE_TOP_SUMMARY",
          "type": "LLM",
          "inputs": [
            {
              "id": "1775512232049_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": ""
            },
            {
              "id": "1775512232049_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Analyze the following engagement data sources and generate a concise, high-level summary:\n\nOpportunity Engagement Data:\n{{$context.$nodes.CONSOLIDATEENGAGEMENTS.$output}}\n\nContact Engagement Data:\n{{$context.$nodes.ACCOUNT_CONTACT_SUMMARY.$output.output}}\n\nAccount Engagement Data:\n{{$context.$nodes.ACCOUNT_SUMMARY.$output.output}}\n\nInstructions:\n- Synthesize insights across all inputs; do not analyze them independently.\n- Highlight key themes, patterns, and overall engagement trends.\n- Identify any risks, opportunities, or notable signals.\n- Explicitly mention if data is missing, incomplete, or insufficient.\n- Keep the summary concise, clear, and business-focused (3–5 sentences).\n- Do not repeat raw data; focus on insights and interpretation."
            }
          ]
        },
        {
          "metadata": {
            "name": "prepareFinalResponse",
            "returnType": "object",
            "sourceCode": "return {\n  opportunity_engagement: $context.$nodes.CONSOLIDATEENGAGEMENTS.$output,\n  contact_engagement: $context.$nodes.ACCOUNT_CONTACT_SUMMARY.$output.output,\n  direct_account_engagement: $context.$nodes.ACCOUNT_SUMMARY.$output.output\n};"
          },
          "outcomes": {
            "success": "1775499777134"
          },
          "diagram": {
            "x": 5695,
            "y": 8422
          },
          "code": "PREPAREFINALRESPONSE",
          "id": "1775235471936",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Summary Persistence Payload",
            "sourceCode": "const accountData = $context.$nodes.GETACCOUNTDATA.$output?.[0];\n\nif (!accountData) {\n  return null;\n}\n\nconst accountDetails = {\n  accountId: accountData.PartyId,\n  accountNumber: accountData.PartyNumber,\n  accountName: accountData.PartyName\n};\n\n \nconst finalResponse = $context.$nodes.PREPAREFINALRESPONSE.$output?.result;\n\nconst topSummary = $context.$nodes.GENERATE_TOP_SUMMARY.$output;\n\nconst expiryTime = new Date(Date.now() + 2592000000).toISOString();\n \nconst payload = {\n  schemaVersion: \"1.0\",\n  what: {\n    title: `${accountDetails.accountName} — Engagement Summary`,\n    summary: topSummary, \n    facts: {\n      opportunity_engagement: finalResponse?.opportunity_engagement,\n      contact_engagement: finalResponse?.contact_engagement,\n      direct_account_engagement: finalResponse?.direct_account_engagement\n    }\n  }\n};\n\nreturn [\n  {\n    \"$operation\": \"MERGE\",\n    \"$lookupBy\": {\n      outcomeType: \"SUMMARY\",\n      outcomeSubtype: \"STATE_SUMMARY\",\n      category: \"ENGAGEMENT\",\n      primaryObjectType: \"ACCOUNT\",\n      primaryObjectAltKey: accountDetails.accountNumber\n    },\n    outcomeType: \"SUMMARY\",\n    outcomeSubtype: \"STATE_SUMMARY\",\n    category: \"ENGAGEMENT\",\n    primaryObjectType: \"ACCOUNT\",\n    primaryObjectKey: accountDetails.accountId,\n    primaryObjectAltKey: accountDetails.accountNumber,\n    status: \"ACTIVE\",\n    urgency: \"LOW\",\n    generatedBy: \"agent:AccountEngagementSummaryAgent/v1\",\n    agentJobKey: $context.$workflow.$traceId,\n    effectiveDate: `${$context.$system.$currentDateTime}Z`,\n    expiryTime,\n    payload: JSON.stringify(payload)\n  }\n];",
            "returnType": "array"
          },
          "diagram": {
            "x": 5693.5,
            "y": 8644
          },
          "outcomes": {
            "success": "1775501374433"
          },
          "id": "1775499777134",
          "code": "SUMMARY_PERSISTENCE_PAYLOAD",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "name": "Data Validation Code",
            "sourceCode": "const payload = $context.$nodes.SUMMARY_PERSISTENCE_PAYLOAD?.$output?.result;\nconst actualData = $context.$nodes.PREPAREFINALRESPONSE?.$output?.result;\n\n// payload must exist\nif (payload == null) {\n  return false;\n}\n\n// actualData must exist and contain required keys\nif (\n  actualData &&\n  typeof actualData === \"object\" &&\n  Object.prototype.hasOwnProperty.call(actualData, \"opportunity_engagement\") &&\n  Object.prototype.hasOwnProperty.call(actualData, \"contact_engagement\") &&\n  Object.prototype.hasOwnProperty.call(actualData, \"direct_account_engagement\")\n) {\n  return true;\n}\n\nreturn false;",
            "returnType": "boolean"
          },
          "diagram": {
            "x": 5695,
            "y": 8866
          },
          "outcomes": {
            "success": "1775501480364"
          },
          "id": "1775501374433",
          "code": "DATA_VALIDATION_CODE",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
