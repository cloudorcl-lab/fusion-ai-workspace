        {
          "metadata": {
            "name": "chunkOptyNumbers",
            "returnType": "object",
            "sourceCode": "const rawOpportunityIds = $context.$nodes.GETOPTYNUMBERS.$output.result;\n\n  const opportunityIdsArray = Array.isArray(rawOpportunityIds)\n    ? rawOpportunityIds\n    : (rawOpportunityIds != null && String(rawOpportunityIds).trim() !== \"\"\n        ? String(rawOpportunityIds).split(\",\").map(id => id.trim()).filter(id => id !== \"\")\n        : []);\n\n  const batchSizeRaw = $context.$triggers.REST.$input.action.config.opportunityBatchSize;\n  const optyBatchSize = Number(batchSizeRaw) || 20;\n\n  const collections = [];\n\n  for (let i = 0; i < opportunityIdsArray.length; i += optyBatchSize) {\n    const batch = opportunityIdsArray.slice(i, i + optyBatchSize);\n    collections.push(batch);\n  }\n\n  return collections;"
          },
          "outcomes": {
            "success": "1775165305317"
          },
