                    "returnType": "string",
                    "sourceCode": " var raw = $context.$nodes.LOOPOPPORTUNITIES.$currentItem;\n\n  var objectAltKeys = [];\n\n  if (Array.isArray(raw)) {\n    objectAltKeys = raw;\n  } else if (raw != null && String(raw).trim() !== \"\") {\n    objectAltKeys = String(raw).split(\",\");\n  }\n\n  objectAltKeys = objectAltKeys\n    .map(function(item) {\n      if (item != null && typeof item === \"object\") {\n        return item.OptyNumber || item.optyNumber || item.OpportunityNumber || item.opportunityNumber || \"\";\n      }\n\n      return item;\n    })\n    .map(function(value) {\n      return String(value).trim();\n    })\n    .filter(function(value) {\n      return value !== \"\";\n    });\n\n  var payload = {\n    objectType: \"OPPORTUNITY\",\n    objectAltKeys: objectAltKeys\n  };\n\n  return JSON.stringify(payload);\n"
