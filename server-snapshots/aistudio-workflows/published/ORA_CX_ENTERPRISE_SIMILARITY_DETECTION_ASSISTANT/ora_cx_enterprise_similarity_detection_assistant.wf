            "returnType": "object",
            "sourceCode": "let query = {};\nif($context.$triggers.REST.$input.isCreateFlow) {\n    let summary = $context.$triggers.REST.$input.isBundle? $context.$nodes.ORA_CX_ENTERPRISE_COMBINE_PRODUCT_OFFERING_SUMMARIES_FOR_BUNDLE.$output.result:$context.$nodes.ORA_CX_ENTERPRISE_COMBINE_PRODUCT_OFFERING_SUMMARIES_FOR_ATOMIC.$output.result;\n    query = summary;\n}\nelse {\n    query = $context.$triggers.REST.$input.offer;\n}\n\nreturn query;"
