        {
          "metadata": {
            "name": "Component Pricing Filter Offering POP Array",
            "returnType": "array",
            "sourceCode": "let filteredPOPArray = [];\nlet popArray = $context.$variables.OfferPayloadPOP || [];\n\nfor (let i = 0; i < popArray.length; i += 1) {\n  const item = popArray[i] || {};\n  const hasIsBundlePrice = Object.prototype.hasOwnProperty.call(item, \"isBundlePrice\");\n\n  if (hasIsBundlePrice) {\n    filteredPOPArray.push(item);\n  } else {\n    const pt = item.priceType;\n    if (\n      pt === \"PENALTY\" ||\n      pt === \"PENALTY_PRICE_PLAN\" ||\n      pt === \"ALTERATION\" ||\n      pt === \"ALTERATION_PRICE_PLAN\"\n    ) {\n      filteredPOPArray.push(item);\n    }\n  }\n}\n\nreturn filteredPOPArray;"
          },
          "outcomes": {
            "success": "1776840106749"
          },
          "code": "ORA_CX_ENTERPRISE_COMPONENT_PRICING_FILTER_OFFERING_POP_ARRAY",
