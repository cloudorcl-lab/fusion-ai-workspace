          },
          "id": "1776262653879",
          "code": "PARSE_CONTRACTS_DEVIATING_CLAUSES_INPUT",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "name": "Prepare Update Contracts Payload",
            "returnType": "object",
            "sourceCode": "const loopOutput = $context.$nodes.ITERATE_OVER_ELIGIBLE_CONTRACTS_DEVIATING_CLAUSES.$output?.result ?? $context.$nodes.ITERATE_OVER_ELIGIBLE_CONTRACTS_DEVIATING_CLAUSES.$output ?? [];\nconst loopResults = Array.isArray(loopOutput) ? loopOutput : [];\n\nconst parseMaybeJson = (value) => {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  try {\n    return JSON.parse(value);\n  } catch (error) {\n    return value;\n  }\n};\n\nconst severityMap = {\n  \"no risk\": \"0_NO_RISK\",\n  \"low risk\": \"1_LOW_RISK\",\n  \"medium risk\": \"2_MEDIUM_RISK\",\n  \"high risk\": \"3_HIGH_RISK\",\n  \"critical\": \"4_CRITICAL\"\n};\n\n// Normalize each policy result so downstream batching works with a stable shape.\nconst normalizedItems = loopResults.map((rawItem, index) => {\n  const item = parseMaybeJson(rawItem);\n  const severityText = typeof item?.Severity === \"string\" ? item.Severity.trim() : null;\n  const normalizedSeverity = severityText || null;\n  const severityCode = normalizedSeverity ? severityMap[normalizedSeverity.toLowerCase()] ?? null : null;\n\n  return {\n    sequence: index + 1,\n    ContractId: item?.ContractId ?? null,\n    ContractNumber: item?.ContractNumber ?? null,\n    Severity: normalizedSeverity,\n    SeverityCode: severityCode\n  };\n});\n\nconst batchPayload = [];\nconst contractsEvaluated = [];\nconst contractsNotEvaluated = [];\n\n// Separate contracts that can be updated from those that should only appear in final output.\nnormalizedItems.forEach((item) => {\n  if (item.SeverityCode) {\n    const payloadItem = {\n      id: `part_${item.ContractId}`,\n      operation: \"upsert\",\n      path: \"/contracts\",\n      payload: {\n        ContractId: item.ContractId,\n        SeverityCode: item.SeverityCode,\n        EligibleForRiskScoringYn: \"N\"\n      }\n    };\n\n    batchPayload.push(payloadItem);\n    contractsEvaluated.push({\n      ContractId: item.ContractId,\n      ContractNumber: item.ContractNumber,\n      Severity: item.Severity,\n      SeverityCode: item.SeverityCode,\n      requestId: payloadItem.id\n    });\n  } else {\n    contractsNotEvaluated.push({\n      ContractId: item.ContractId,\n      ContractNumber: item.ContractNumber,\n      Severity: item.Severity\n    });\n  }\n});\n\n// UpdateContractsInBatch is invoked with batches of 50 payload entries.\nconst batchPayloadChunks = [];\nfor (let index = 0; index < batchPayload.length; index += 50) {\n  batchPayloadChunks.push({\n    parts: batchPayload.slice(index, index + 50)\n  });\n}\n\nlet payload = {\n  contractsEvaluated,\n  contractsNotEvaluated,\n  batchPayload,\n  batchPayloadChunks,\n  numberOfContractsEvaluatedForRiskSeverity: contractsEvaluated.length,\n  numberOfContractsNotEvaluatedForRiskSeverity: contractsNotEvaluated.length\n};\n\nreturn payload;"
          },
          "diagram": {
            "x": 2241.6074342920406,
            "y": 1470.5300702357572
          },
