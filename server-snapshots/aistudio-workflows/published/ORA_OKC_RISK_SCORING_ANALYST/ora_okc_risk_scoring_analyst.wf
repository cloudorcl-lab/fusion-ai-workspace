          "outcomes": {
            "success": "1776315000003"
          },
          "id": "1776315000004",
          "code": "ITERATE_OVER_CONTRACT_UPDATE_BATCHES_OF_50",
          "type": "LOOP",
          "inputs": [
            {
              "id": "1776315000004_collection",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.PREPARE_UPDATE_CONTRACTS_PAYLOAD.$output.result.batchPayloadChunks}}"
            }
          ]
        },
        {
          "metadata": {
            "name": "Final Output",
            "returnType": "object",
            "sourceCode": "const preparedOutput = $context.$nodes.PREPARE_UPDATE_CONTRACTS_PAYLOAD.$output?.result ?? {};\nconst contractsEvaluated = Array.isArray(preparedOutput.contractsEvaluated) ? preparedOutput.contractsEvaluated : [];\nconst contractsNotEvaluated = Array.isArray(preparedOutput.contractsNotEvaluated) ? preparedOutput.contractsNotEvaluated : [];\n\nconst parseMaybeJson = (value) => {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  try {\n    return JSON.parse(value);\n  } catch (error) {\n    return value;\n  }\n};\n\nconst getResponseItems = (response) => {\n  if (Array.isArray(response)) {\n    return response;\n  }\n\n  if (Array.isArray(response?.items)) {\n    return response.items;\n  }\n\n  if (Array.isArray(response?.result)) {\n    return response.result;\n  }\n\n  if (Array.isArray(response?.data)) {\n    return response.data;\n  }\n\n  if (Array.isArray(response?.contracts)) {\n    return response.contracts;\n  }\n\n  return [];\n};\n\nconst rawUpdateLoopOutput = $context.$nodes.ITERATE_OVER_CONTRACT_UPDATE_BATCHES_OF_50?.$output?.result\n  ?? $context.$nodes.ITERATE_OVER_CONTRACT_UPDATE_BATCHES_OF_50?.$output\n  ?? [];\n\nconst updateLoopResults = Array.isArray(rawUpdateLoopOutput)\n  ? rawUpdateLoopOutput\n  : rawUpdateLoopOutput\n    ? [rawUpdateLoopOutput]\n    : [];\n\n// Flatten responses from each batch execution into a single list for final mapping.\nconst responseItems = updateLoopResults.flatMap((rawBatchResponse) => {\n  const parsedBatchResponse = parseMaybeJson(rawBatchResponse);\n  const normalizedBatchResponse = parseMaybeJson(\n    parsedBatchResponse?.output?.result\n    ?? parsedBatchResponse?.result\n    ?? parsedBatchResponse?.output\n    ?? parsedBatchResponse\n    ?? null\n  );\n\n  return getResponseItems(normalizedBatchResponse);\n});\n\nconst evaluatedContracts = contractsEvaluated.map((item, index) => {\n  const responseItem = responseItems[index];\n\n  if (responseItem && typeof responseItem === \"object\") {\n    return {\n      ...responseItem,\n      ContractNumber: item.ContractNumber,\n      Severity: item.Severity\n    };\n  }\n\n  return {\n    ContractNumber: item.ContractNumber,\n    Severity: item.Severity\n  };\n});\n\nconst finalContracts = [\n  ...evaluatedContracts,\n  ...contractsNotEvaluated.map((item) => ({\n    ContractNumber: item.ContractNumber,\n    Severity: item.Severity\n  }))\n];\n\nlet contractsOutput = {\n  Contracts: finalContracts,\n  NumberOfContractsEvaluatedForRiskSeverity: preparedOutput.numberOfContractsEvaluatedForRiskSeverity ?? evaluatedContracts.length,\n  NumberOfContractsNotEvaluatedForRiskSeverity: preparedOutput.numberOfContractsNotEvaluatedForRiskSeverity ?? contractsNotEvaluated.length\n};\n\nreturn contractsOutput;"
          },
