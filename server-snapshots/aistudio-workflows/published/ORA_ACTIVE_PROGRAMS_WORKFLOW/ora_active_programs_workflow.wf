        {
          "metadata": {
            "name": "Refine Program Data",
            "returnType": "array",
            "sourceCode": "let result = [];\ntry {\n  const programs = $context.$nodes?.GET_ACTIVE_PROGRAMS?.$output?.items || [];\n  // Filter programs with at least 1 tactic and limit to 5\n  const filteredPrograms = programs.filter(program => {\n    const automations = program?.automations?.items || [];\n    return automations.length > 0;\n  }).slice(0, 5);\n\n  result = filteredPrograms.map(program => {\n    const automations = program?.automations?.items || [];\n    const totalTactics = automations.length;\n    let tacticsExceeds = 0;\n    let tacticsBelowExpectation = 0;\n\n    automations.forEach(tactic => {\n      const metrics = tactic?.metrics?.items || [];\n      const enterAutomationMetric = metrics.find(m => m.eventType === \"enterAutomation\");\n      const meetTacticSuccessCriteriaMetric = metrics.find(m => m.eventType === \"meetTacticSuccessCriteria\");\n      const enterCount = enterAutomationMetric ? Number(enterAutomationMetric.eventCount) : 0;\n      const meetCount = meetTacticSuccessCriteriaMetric ? Number(meetTacticSuccessCriteriaMetric.eventCount) : 0;\n      let successPercentage = 0;\n      if (enterCount > 0) {\n        successPercentage = meetCount / enterCount;\n      }\n      if (successPercentage >= 0.05) {\n        tacticsExceeds += 1;\n      } else {\n        tacticsBelowExpectation += 1;\n      }\n    });\n\n    let subtitle = \"\";\n    if (totalTactics > 0 && tacticsExceeds >= (totalTactics / 2)) {\n      subtitle = tacticsExceeds + \" out of \" + totalTactics + \" tactics exceed expected success rates.\"; \n    } else {\n      subtitle = tacticsBelowExpectation + \" out of \" + totalTactics + \" tactics show below expected success rates.\";\n    }\n\n    let priority = \"\";\n    let badgeText = \"\";\n    if (totalTactics > 0 && tacticsExceeds >= (totalTactics/2)) {\n      priority = \"success\";\n      badgeText = \"On track\";\n    } else {\n      priority = \"warning\";\n      badgeText = \"Needs Review\";\n    }\n\n    return {\n      id: program.id,\n      name: program.name,\n      totalTactics: totalTactics,\n      tacticsExceeds: tacticsExceeds,\n      tacticsBelowExpectation: tacticsBelowExpectation,\n      subtitle: subtitle,\n      priority: priority,\n      badgeText: badgeText\n    };\n  });\n} catch (error) {\n  result = [];\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776900157691"
          },
          "code": "REFINE_PROGRAM_DATA",
          "id": "1778558533626",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
