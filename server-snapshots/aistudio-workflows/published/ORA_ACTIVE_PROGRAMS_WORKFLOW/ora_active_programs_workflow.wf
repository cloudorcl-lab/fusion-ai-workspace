          },
          "code": "GET_ACTIVE_PROGRAMS",
          "id": "1776900129468",
          "inputs": [
            {
              "id": "1776900129468_childProductIds",
              "name": "childProductIds",
              "value": "{{$context.$nodes.SET_CHILD_IDS.$output.result}}",
