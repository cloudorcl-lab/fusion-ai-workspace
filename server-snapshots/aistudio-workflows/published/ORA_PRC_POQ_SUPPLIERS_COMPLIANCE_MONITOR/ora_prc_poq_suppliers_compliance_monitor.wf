        {
          "metadata": {
            "businessObjectCode": "ORA_PRC_SUPPLIERQU_POQQUALIFICATIONS",
            "functionName": "GetActiveQualificationsForSuppliers",
            "processJson": true,
            "name": "Get Tier C Qualifications"
          },
          "outcomes": {
            "success": "1776073640261"
          },
          "diagram": {
            "x": 6074.225204762904,
            "y": 6450.0106011173375
          },
          "code": "GET_TIER_C_QUALIFICATIONS",
          "id": "1776073555584",
          "inputs": [
            {
              "id": "1776073568951_1",
              "name": "qualificationNames",
              "type": "string",
              "value": "{{$context.$nodes.TIER_C_QUALIFICATION_AREA_STRING.$output.result}}"
            },
            {
              "id": "1776073568952_2",
              "name": "supplierIds",
              "type": "string",
              "value": "{{$context.$nodes.TIRE_C_SUPPLIERIDS_STRING.$output.result}}"
            },
            {
              "id": "1776073568953_3",
              "name": "limit",
              "type": "string",
              "value": "500"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"QualificationId\": { \"type\": \"string\" },\n          \"QualificationOutcome\": { \"type\": \"string\" },\n          \"SupplierId\": { \"type\": \"string\" }\n        },\n        \"required\": [\n          \"QualificationId\",\n          \"QualificationOutcome\",\n          \"SupplierId\"\n        ]\n      }\n    }\n  },\n  \"required\": [\"items\"]\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Tier A Classification Code",
            "returnType": "string",
            "sourceCode": "// Inputs:\n// input1 = requiredOutcomes\n// input2 = suppliers\n// input3 = qualifications\n\nconst requiredOutcomes = $context.$nodes.TIER_A_SUPPLIER_QUALIFICATION_REQUIREMENTS_POLICY_NODE.$output[\"Supplier Qualification Requirements\"] ?? [];\nconst suppliers = $context.$nodes.GET_TIER_A_SUPPLIERS.$output?.items ?? [];\nconst qualifications = $context.$nodes.GET_TIER_A_QUALIFICATIONS.$output?.items ?? [];\n\n// Counters\nlet compliantCount = 0;\nlet nonCompliantCount = 0;\nlet noQualificationsCount = 0;\n\n// Build lookup: QualificationArea -> Set of allowed RequiredOutcome values\nconst requiredOutcomeMap = new Map();\n\nfor (const row of requiredOutcomes) {\n  const area = String(row?.QualificationArea ?? \"\").trim();\n  const requiredOutcomeRaw = String(row?.RequiredOutcome ?? \"\").trim();\n\n  if (!area) continue;\n\n  const allowedOutcomes = requiredOutcomeRaw\n    .split(\",\")\n    .map(v => v.trim())\n    .filter(Boolean);\n\n  requiredOutcomeMap.set(area, new Set(allowedOutcomes));\n}\n\n// Unique suppliers by SupplierId\nconst uniqueSupplierIds = [...new Set(\n  suppliers\n    .map(s => String(s?.SupplierId ?? \"\").trim())\n    .filter(Boolean)\n)];\n\nfor (const supplierId of uniqueSupplierIds) {\n  // Find all qualifications for this supplier\n  const supplierQualifications = qualifications.filter(q =>\n    String(q?.SupplierId ?? \"\").trim() === supplierId\n  );\n\n  // Rule 1: no qualifications\n  if (supplierQualifications.length === 0) {\n    noQualificationsCount++;\n    continue;\n  }\n\n  let isNonCompliant = false;\n\n  // Rule 2: check all linked qualifications\n  for (const qual of supplierQualifications) {\n    const qualificationName = String(qual?.QualificationName ?? \"\").trim();\n    const qualificationOutcome = String(qual?.QualificationOutcome ?? \"\").trim();\n\n    const allowedOutcomes = requiredOutcomeMap.get(qualificationName);\n\n    // If no matching policy row exists for this qualification area,\n    // treat as non-compliant (safe default).\n    if (!allowedOutcomes) {\n      isNonCompliant = true;\n      nonCompliantCount++;\n      break;\n    }\n\n    // Exact match against one of the comma-separated allowed outcomes\n    if (!allowedOutcomes.has(qualificationOutcome)) {\n      isNonCompliant = true;\n      nonCompliantCount++;\n      break;\n    }\n  }\n\n  // Rule 3: all qualifications matched\n  if (!isNonCompliant) {\n    compliantCount++;\n  }\n}\n\n// Return as comma-separated string\nreturn `${compliantCount},${nonCompliantCount},${noQualificationsCount}`;"
          },
          "outcomes": {
            "success": "1776073859604"
          },
          "diagram": {
            "x": 4682.225204762904,
            "y": 6672.010601117337
          },
          "code": "TIER_A_CLASSIFICATION_CODE",
          "id": "1776072497608",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Tier B Classification Code",
            "returnType": "string",
            "sourceCode": "// Inputs:\n// input1 = requiredOutcomes\n// input2 = suppliers\n// input3 = qualifications\n\nconst requiredOutcomes = $context.$nodes.TIER_B_SUPPLIER_QUALIFICATION_REQUIREMENTS_POLICY_NODE.$output[\"Supplier Qualification Requirements\"] ?? [];\nconst suppliers = $context.$nodes.GET_TIER_B_SUPPLIERS.$output?.items ?? [];\nconst qualifications = $context.$nodes.GET_TIER_B_QUALIFICATIONS.$output?.items ?? [];\n\n// Counters\nlet compliantCount = 0;\nlet nonCompliantCount = 0;\nlet noQualificationsCount = 0;\n\n// Build lookup: QualificationArea -> Set of allowed RequiredOutcome values\nconst requiredOutcomeMap = new Map();\n\nfor (const row of requiredOutcomes) {\n  const area = String(row?.QualificationArea ?? \"\").trim();\n  const requiredOutcomeRaw = String(row?.RequiredOutcome ?? \"\").trim();\n\n  if (!area) continue;\n\n  const allowedOutcomes = requiredOutcomeRaw\n    .split(\",\")\n    .map(v => v.trim())\n    .filter(Boolean);\n\n  requiredOutcomeMap.set(area, new Set(allowedOutcomes));\n}\n\n// Unique suppliers by SupplierId\nconst uniqueSupplierIds = [...new Set(\n  suppliers\n    .map(s => String(s?.SupplierId ?? \"\").trim())\n    .filter(Boolean)\n)];\n\nfor (const supplierId of uniqueSupplierIds) {\n  // Find all qualifications for this supplier\n  const supplierQualifications = qualifications.filter(q =>\n    String(q?.SupplierId ?? \"\").trim() === supplierId\n  );\n\n  // Rule 1: no qualifications\n  if (supplierQualifications.length === 0) {\n    noQualificationsCount++;\n    continue;\n  }\n\n  let isNonCompliant = false;\n\n  // Rule 2: check all linked qualifications\n  for (const qual of supplierQualifications) {\n    const qualificationName = String(qual?.QualificationName ?? \"\").trim();\n    const qualificationOutcome = String(qual?.QualificationOutcome ?? \"\").trim();\n\n    const allowedOutcomes = requiredOutcomeMap.get(qualificationName);\n\n    // If no matching policy row exists for this qualification area,\n    // treat as non-compliant (safe default).\n    if (!allowedOutcomes) {\n      isNonCompliant = true;\n      nonCompliantCount++;\n      break;\n    }\n\n    // Exact match against one of the comma-separated allowed outcomes\n    if (!allowedOutcomes.has(qualificationOutcome)) {\n      isNonCompliant = true;\n      nonCompliantCount++;\n      break;\n    }\n  }\n\n  // Rule 3: all qualifications matched\n  if (!isNonCompliant) {\n    compliantCount++;\n  }\n}\n\n// Return as comma-separated string\nreturn `${compliantCount},${nonCompliantCount},${noQualificationsCount}`;"
          },
          "outcomes": {
            "success": "1776073859604"
          },
          "diagram": {
            "x": 5378.225204762904,
            "y": 6672.010601117337
          },
          "code": "TIER_B_CLASSIFICATION_CODE",
          "id": "1776073168379",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Tier C Classification Code",
            "returnType": "string",
            "sourceCode": "// Inputs:\n// input1 = requiredOutcomes\n// input2 = suppliers\n// input3 = qualifications\n\nconst requiredOutcomes = $context.$nodes.TIER_C_SUPPLIER_QUALIFICATION_REQUIREMENTS_POLICY_NODE.$output[\"Supplier Qualification Requirements\"] ?? [];\nconst suppliers = $context.$nodes.GET_TIER_C_SUPPLIERS.$output?.items ?? [];\nconst qualifications = $context.$nodes.GET_TIER_C_QUALIFICATIONS.$output?.items ?? [];\n\n// Counters\nlet compliantCount = 0;\nlet nonCompliantCount = 0;\nlet noQualificationsCount = 0;\n\n// Build lookup: QualificationArea -> Set of allowed RequiredOutcome values\nconst requiredOutcomeMap = new Map();\n\nfor (const row of requiredOutcomes) {\n  const area = String(row?.QualificationArea ?? \"\").trim();\n  const requiredOutcomeRaw = String(row?.RequiredOutcome ?? \"\").trim();\n\n  if (!area) continue;\n\n  const allowedOutcomes = requiredOutcomeRaw\n    .split(\",\")\n    .map(v => v.trim())\n    .filter(Boolean);\n\n  requiredOutcomeMap.set(area, new Set(allowedOutcomes));\n}\n\n// Unique suppliers by SupplierId\nconst uniqueSupplierIds = [...new Set(\n  suppliers\n    .map(s => String(s?.SupplierId ?? \"\").trim())\n    .filter(Boolean)\n)];\n\nfor (const supplierId of uniqueSupplierIds) {\n  // Find all qualifications for this supplier\n  const supplierQualifications = qualifications.filter(q =>\n    String(q?.SupplierId ?? \"\").trim() === supplierId\n  );\n\n  // Rule 1: no qualifications\n  if (supplierQualifications.length === 0) {\n    noQualificationsCount++;\n    continue;\n  }\n\n  let isNonCompliant = false;\n\n  // Rule 2: check all linked qualifications\n  for (const qual of supplierQualifications) {\n    const qualificationName = String(qual?.QualificationName ?? \"\").trim();\n    const qualificationOutcome = String(qual?.QualificationOutcome ?? \"\").trim();\n\n    const allowedOutcomes = requiredOutcomeMap.get(qualificationName);\n\n    // If no matching policy row exists for this qualification area,\n    // treat as non-compliant (safe default).\n    if (!allowedOutcomes) {\n      isNonCompliant = true;\n      nonCompliantCount++;\n      break;\n    }\n\n    // Exact match against one of the comma-separated allowed outcomes\n    if (!allowedOutcomes.has(qualificationOutcome)) {\n      isNonCompliant = true;\n      nonCompliantCount++;\n      break;\n    }\n  }\n\n  // Rule 3: all qualifications matched\n  if (!isNonCompliant) {\n    compliantCount++;\n  }\n}\n\n// Return as comma-separated string\nreturn `${compliantCount},${nonCompliantCount},${noQualificationsCount}`;"
          },
          "outcomes": {
            "success": "1776073859604"
          },
          "diagram": {
            "x": 6074.225204762904,
            "y": 6672.010601117337
          },
          "code": "TIER_C_CLASSIFICATION_CODE",
