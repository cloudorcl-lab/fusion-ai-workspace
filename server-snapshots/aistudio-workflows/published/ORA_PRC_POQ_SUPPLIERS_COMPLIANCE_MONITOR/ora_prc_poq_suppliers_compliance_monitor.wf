        {
          "metadata": {
            "name": "Tier A SupplierNumber String",
            "returnType": "string",
            "sourceCode": "const data = $context.$nodes.SUPPLIERS_DATA_POLICY_NODE.$output.result || [];\nconst tierA = $context.$variables.TierA;\n\nconst result = data\n  .filter(item => item?.SupplierTier === tierA) // keep only TierA suppliers\n  .map(item => item?.SupplierNumber)\n  .filter(Boolean)\n  .map(value => `'${value}'`)              // wrap in single quotes\n  .map(value => encodeURIComponent(value)) // URL encode\n  .join(\",\");                              // comma separated\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776072241435"
          },
          "diagram": {
            "x": 4676.225204762904,
            "y": 5340.0106011173375
          },
