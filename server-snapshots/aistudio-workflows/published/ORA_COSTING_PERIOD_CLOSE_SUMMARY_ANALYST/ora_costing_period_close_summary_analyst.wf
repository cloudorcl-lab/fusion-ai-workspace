  "name": "Costing Period Close Summary Analyst",
  "description": "Agent team for writing a summary while closing  period for the cost accounting sub ledger. The summary outlines key account values, adjustments, exceptions, and observations related to the closing process.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
