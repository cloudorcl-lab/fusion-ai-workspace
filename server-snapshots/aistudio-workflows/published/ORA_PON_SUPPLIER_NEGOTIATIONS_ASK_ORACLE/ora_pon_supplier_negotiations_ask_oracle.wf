          },
          "code": "ANALYZE_USER_QUERY",
          "id": "1765389903246",
          "inputs": [
            {
              "id": "1765389903248_1",
              "name": "prompt",
              "type": "string",
              "value": "Analyze the input message coming here {{$context.$system.$inputMessage}} and determine if the user is requesting for one of the following actions: pause negotiation, resume negotiation, extend negotiation, close negotiation, change close date or send message (reminder) to suppliers (participants). Resume means to execute an action, not to summarize a negotiation, both are different.\n\nIf the request is about one of the previous actions return the value \"LIFECYCLE\". Otherwise return \"QUERY\"."
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"result\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "User Query Options"
          },
          "outcomes": {
            "LIFECYCLE": "1771461167412",
            "QUERY": "1770248928919",
            "ERROR": "1765390074568"
          },
          "code": "USER_QUERY_OPTIONS",
          "convergenceTargetId": "end",
          "id": "1765389944287",
          "inputs": [
            {
              "id": "1765389944289_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$nodes.ANALYZE_USER_QUERY.$output.result}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
            "name": "Query Error Handler",
            "returnType": "string",
            "sourceCode": "return   \"Not able to execute the action\";"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "QUERY_ERROR_HANDLER",
