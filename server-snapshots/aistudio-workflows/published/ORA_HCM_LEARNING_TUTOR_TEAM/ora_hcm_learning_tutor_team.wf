        },
        {
          "metadata": {
            "name": "Compute Dates Code",
            "returnType": "array",
            "sourceCode": "const sessionTimeoutMinutes = 30;\nconst nowEpochMs = Date.now();\nconst nowDate = new Date(nowEpochMs);\nconst nowMinus30EpochMs = nowEpochMs - (sessionTimeoutMinutes * 60 * 1000);\nconst nowMinus30 = new Date(nowMinus30EpochMs);\nconst sessionItems = $context.$nodes.GET_USER_SESSION_DETAILS.$output.items || [];\nconst firstItem = sessionItems[0] || {};\nconst userInfo = {\n  PersonNumber: firstItem.PersonNumber,\n  DisplayName: firstItem.DisplayName,\n  FirstName: firstItem.FirstName,\n  LastName: firstItem.LastName,\n  EmailAddress: firstItem.EmailAddress,\n  Language: firstItem.Language,\n  Currency: firstItem.Currency,\n  DateFormat: firstItem.DateFormat,\n  NumberFormat: firstItem.NumberFormat,\n  TimeFormat: firstItem.TimeFormat,\n  TimeZone: firstItem.TimeZone,\n  ServerTime: firstItem.ServerTime,\n  Territory: firstItem.Territory\n};\nconst result = {\n  nowDate,\n  nowMinus30,\n  nowEpochMs,\n  nowMinus30EpochMs,\n  userInfo,\n  subjectId: userInfo.PersonNumber || null\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1766043367190"
          },
          "code": "COMPUTE_DATES_CODE",
          "convergenceTargetId": "1765570064385",
          "id": "1765561173070",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
