            },
            {
              "id": "1765653348607",
              "name": "userInfo",
              "value": "{{$context.$nodes.COMPUTE_DATES_CODE.$output.result.userInfo}}"
            },
            {
              "id": "1765563850967",
              "name": "nowMinus30",
              "value": "{{$context.$nodes.COMPUTE_DATES_CODE.$output.result.nowMinus30}}"
            },
            {
              "id": "1765509867084",
              "name": "subjectId",
              "value": "{{$context.$nodes.COMPUTE_DATES_CODE.$output.result.subjectId}}"
            },
            {
              "id": "1765509860943_llmKnowledgeEnabled",
              "name": "llmKnowledgeEnabled",
              "type": "boolean",
              "value": false
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Process Chat History",
            "returnType": "array",
            "sourceCode": "const chat = $context.$system.$chatHistory;\n\n// Split into churns by \"USER:\" and keep non-empty chunks\nconst chunks = chat.split(/\\bUSER:\\s*/).map(s => s.trim()).filter(Boolean);\n\nconst items = chunks.map(chunk => {\n    const aiPos = chunk.indexOf(\"AI:\");\n    let userText = \"\";\n    let aiSection = \"\";\n\n    if (aiPos >= 0) {\n        userText = chunk.slice(0, aiPos).trim();\n        aiSection = chunk.slice(aiPos + \"AI:\".length).trim();\n    } else {\n        userText = chunk.trim();\n    }\n\n    return { USER: userText, AI: aiSection };\n});\n\nreturn items;"
          },
          "outcomes": {
            "success": "1765570064385"
          },
          "code": "PROCESS_CHAT_HISTORY_CODE",
          "id": "1765563923868",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
