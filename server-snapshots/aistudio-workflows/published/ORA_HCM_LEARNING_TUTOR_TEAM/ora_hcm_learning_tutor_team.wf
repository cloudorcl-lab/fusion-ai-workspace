            "name": "Trim Catalog Search Results",
            "returnType": "array",
            "sourceCode": "let catalogResults = [];\nconst catalogNodeOutput = ($context.$nodes.GET_CATALOG_RECOMMENDATIONS && $context.$nodes.GET_CATALOG_RECOMMENDATIONS.$output) || {};\nlet rawResults = catalogNodeOutput.output;\nlet ragSearchResults = {};\nragSearchResults.count = 0;\nragSearchResults.items = [];\nragSearchResults.result = [];\n\nif (typeof rawResults == 'string') {\n    // Note: WFA agent is adding <a href=\"\"> around links causing the parsing to fail. Workaround is to remove the anchor tags.\n    rawResults = rawResults.replace(\n        /<a\\b[^>]*\\bhref=([\"'])([^\"']*)\\1[^>]*>[\\s\\S]*?<\\/a>/gi,\n        '$2'\n    );\n\n    try {\n        ragSearchResults = JSON.parse(rawResults);\n    } catch (err) {\n        const message = err instanceof Error ? err.message : String(err);\n        const stack = err instanceof Error ? err.stack : undefined;\n    }\n} else if (rawResults && typeof rawResults == 'object') {\n    ragSearchResults = rawResults;\n}\n\nif (Array.isArray(ragSearchResults.result)) {\n    catalogResults = ragSearchResults.result;\n} else if (Array.isArray(ragSearchResults.items)) {\n    catalogResults = ragSearchResults.items;\n}\n\nconst hasValue = (value) => value !== undefined && value !== null && String(value).trim() !== '';\nconst firstValue = (...values) => values.find(hasValue);\nconst escapeHtml = (value) => String(value)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\nconst escapeAttr = (value) => escapeHtml(value);\nconst labelKey = (value) => hasValue(value) ? String(value).trim().toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '') : '';\nconst labelMap = {\n    'articulo': 'Article',\n    'libro': 'Book',\n    'video': 'Video',\n    'evento de aprendizaje': 'Learning Event',\n    'ruta de aprendizaje': 'Learning Path',\n    'curso': 'Course',\n    'curso en linea': 'Online Course',\n    'aprendizaje autodirigido': 'Self-Paced Learning',\n    'departamento de aprendizaje': 'Learning Department'\n};\nconst codeMap = {\n    ORA_ARTICLE: 'Article',\n    ORA_BOOK: 'Book',\n    ORA_VIDEO: 'Video',\n    ORA_COURSE: 'Course',\n    ORA_CLASS: 'Learning Event',\n    ORA_LEARNING_EVENT: 'Learning Event',\n    ORA_LEARNING_PATH: 'Learning Path',\n    ORA_SPECIALIZATION: 'Learning Path',\n    ORA_ONLINE_COURSE: 'Online Course',\n    ORA_SELF_PACED: 'Self-Paced Learning',\n    ORA_ELEARNING: 'Self-Paced Learning'\n};\nconst normalizeCatalogLabel = (value) => hasValue(value) ? (labelMap[labelKey(value)] || String(value).trim()) : '';\nconst formatFromCode = (value) => codeMap[String(value || '').trim()] || '';\nconst dateOnly = (value) => hasValue(value) ? String(value).trim().replace(/^(\\d{4}-\\d{2}-\\d{2}).*$/, '$1') : '';\nconst formatDate = (value) => dateOnly(value).split('-').length === 3 ? dateOnly(value).split('-')[2] + '/' + dateOnly(value).split('-')[1] + '/' + dateOnly(value).split('-')[0] : dateOnly(value);\nconst isRated = (average, count) => Number.isFinite(Number(count)) && Number(count) > 0 && Number.isFinite(Number(average)) && Number(average) > 0;\nconst lineSpan = (content, style) => hasValue(content) ? '<span style=\"' + style + '\">' + content + '</span>' : '';\nconst catalogTile = (titleHtml, formatText, detailsText, summaryText, reasonText) => hasValue(titleHtml) ? '<!--CATALOG_TILE_START--><span data-catalog-recommendation=\"true\" style=\"display:block; width:100%; max-width:none; border:1px solid rgba(130, 130, 130, 0.3); border-radius:12px; padding:14px; margin:10px 0 14px 0; background:inherit; box-sizing:border-box; white-space:normal; vertical-align:top;\">' + lineSpan(titleHtml, 'font-size:14px; line-height:1.3; font-weight:500;') + (hasValue(formatText) ? '<br>' + lineSpan(formatText, 'font-size:13px; line-height:1.35;') : '') + (hasValue(detailsText) ? '<br>' + lineSpan(detailsText, 'font-size:12px; line-height:1.35; opacity:0.72;') : '') + (hasValue(summaryText) ? '<br><br>' + lineSpan(summaryText, 'font-size:13px; line-height:1.45;') : '') + (hasValue(reasonText) ? '<br><br>' + lineSpan(reasonText, 'font-size:13px; line-height:1.45;') : '') + '</span><!--CATALOG_TILE_END-->' : '';\n\nconst trimmedResults = catalogResults.map(({\n    learningItemTitle,\n    learningItemTypeMeaning,\n    learningItemTypeMeaningv2,\n    learningItemType,\n    learningItemTypev2,\n    learningFormatMeaning,\n    learningItemDisplayType,\n    learningItemDisplayTypeMeaning,\n    learningItemSubType,\n    learningItemSubTypeMeaning,\n    learningItemDetailsDeepLink,\n    learningItemExpectedEffortInHours,\n    expectedEffort,\n    durationMeaning,\n    effortDisplay,\n    cost,\n    price,\n    priceDisplay,\n    learningItemPriceCurrency,\n    learningItemRatingAverage,\n    learningItemRatingCount,\n    learningItemPublishedDate,\n    learningItemPublisherDisplayName,\n    learningItemPublisherName,\n    liShortDescription,\n    aiReason\n}) => ({\n    learningItemTitle,\n    learningItemTypeMeaning,\n    learningItemTypeMeaningv2,\n    learningItemType,\n    learningItemTypev2,\n    learningFormatMeaning,\n    learningItemDisplayType,\n    learningItemDisplayTypeMeaning,\n    learningItemSubType,\n    learningItemSubTypeMeaning,\n    learningItemDetailsDeepLink,\n    learningItemExpectedEffortInHours,\n    expectedEffort,\n    durationMeaning,\n    effortDisplay,\n    cost,\n    price,\n    priceDisplay,\n    learningItemPriceCurrency,\n    learningItemRatingAverage,\n    learningItemRatingCount,\n    learningItemPublishedDate,\n    learningItemPublisherDisplayName,\n    learningItemPublisherName,\n    liShortDescription,\n    aiReason,\n    catalogRecommendationDisplay: catalogTile(\n        (hasValue(learningItemDetailsDeepLink) && hasValue(learningItemTitle))\n            ? '<a href=\"' + escapeAttr(learningItemDetailsDeepLink) + '\" target=\"_blank\" style=\"text-decoration:none; color:#5b6fd6;\">' + escapeHtml(learningItemTitle) + '</a>'\n            : (hasValue(learningItemTitle) ? escapeHtml(learningItemTitle) : ''),\n        [\n            firstValue(\n                formatFromCode(learningItemDisplayType),\n                formatFromCode(learningItemSubType),\n                formatFromCode(learningItemTypev2),\n                formatFromCode(learningItemType),\n                normalizeCatalogLabel(learningFormatMeaning),\n                normalizeCatalogLabel(learningItemDisplayTypeMeaning),\n                normalizeCatalogLabel(learningItemSubTypeMeaning),\n                normalizeCatalogLabel(learningItemTypeMeaningv2),\n                normalizeCatalogLabel(learningItemTypeMeaning)\n            ),\n            firstValue(learningItemExpectedEffortInHours, expectedEffort, durationMeaning, effortDisplay)\n        ].filter(hasValue).map((value) => escapeHtml(String(value).trim())).join(' . '),\n        [\n            (hasValue(firstValue(normalizeCatalogLabel(learningItemPublisherDisplayName), normalizeCatalogLabel(learningItemPublisherName))) && hasValue(formatDate(learningItemPublishedDate)))\n                ? 'Published By ' + escapeHtml(firstValue(normalizeCatalogLabel(learningItemPublisherDisplayName), normalizeCatalogLabel(learningItemPublisherName))) + ' . On ' + escapeHtml(formatDate(learningItemPublishedDate))\n                : (hasValue(firstValue(normalizeCatalogLabel(learningItemPublisherDisplayName), normalizeCatalogLabel(learningItemPublisherName)))\n                    ? 'Published By ' + escapeHtml(firstValue(normalizeCatalogLabel(learningItemPublisherDisplayName), normalizeCatalogLabel(learningItemPublisherName)))\n                    : (hasValue(formatDate(learningItemPublishedDate)) ? 'Published On ' + escapeHtml(formatDate(learningItemPublishedDate)) : '')),\n            isRated(learningItemRatingAverage, learningItemRatingCount) ? 'Rating: ' + escapeHtml(String(learningItemRatingAverage).trim()) : '',\n            hasValue(firstValue(cost, price, priceDisplay)) ? escapeHtml(String(firstValue(cost, price, priceDisplay)).trim()) : ''\n        ].filter(hasValue).join('; '),\n        hasValue(liShortDescription) ? escapeHtml(String(liShortDescription).trim()) : '',\n        hasValue(aiReason) ? 'Reason: ' + escapeHtml(String(aiReason).trim()) : ''\n    )\n}));\n\nreturn trimmedResults;"
          },
          "outcomes": {
            "success": "1765564262610"
          },
          "code": "TRIM_CATALOG_SEARCH_RESULTS",
          "convergenceTargetId": "1765564262610",
          "id": "1765996848134",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
