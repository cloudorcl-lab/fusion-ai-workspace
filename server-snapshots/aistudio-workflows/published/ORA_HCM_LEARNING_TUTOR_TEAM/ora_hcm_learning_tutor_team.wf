        {
          "metadata": {
            "errorNodeId": "1766019733812",
            "name": "Prepare Payload Code",
            "returnType": "object",
            "sourceCode": "const rawPayload = $context.$nodes.EXTRACT_EXTERNAL_RECORD_DEATAILS.$output || {};\nconst payload = {};\n\nfor (const [key, val] of Object.entries(rawPayload)) {\n  if (val !== null && val !== undefined) {\n    payload[key] = val;\n  }\n}\n\nconst title = \"Learning Tutor transcript\";\npayload.learningItemType = \"ORA_NON_CATALOG\";\npayload.assignmentStatus = \"ORA_ASSN_REC_COMPLETE\";\n\nconst escHtml = (s) => s\n  .replace(/&/g, \"&amp;\")\n  .replace(/</g, \"<\")\n  .replace(/>/g, \">\")\n  .replace(/\\r?\\n/g, \"<br>\");\n\nconst normPunct = (s) => s\n  .replace(/[‘’]/g, \"'\")\n  .replace(/[“”]/g, '\"')\n  .replace(/[–—‑]/g, \"-\")\n  .replace(/→/g, \"->\")\n  .replace(/←/g, \"<-\")\n  .replace(/[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]/g, \"\");\n\nconst applyInlineMarkdown = (text) => {\n  let output = String(text || \"\")\n    .replace(/(^|[\\s(>])\\*([A-Za-z][^*\\n]*?)([.!?;,])\\*(?=$|[\\s).,!?:;<])/g, \"$1<em>$2</em>$3\")\n    .replace(/(^|[\\s(>])_([A-Za-z][^_\\n]*?)([.!?;,])_(?=$|[\\s).,!?:;<])/g, \"$1<em>$2</em>$3\");\n\n  for (let i = 0; i < 3; i += 1) {\n    const previousOutput = output;\n    output = output\n      .replace(/\\*\\*([^*\\n][^*]*?)\\*\\*/g, \"<strong>$1</strong>\")\n      .replace(/__([^_\\n][^_]*?)__/g, \"<strong>$1</strong>\")\n      .replace(/(^|[\\s(>])\\*([^*\\n][^*]*?)\\*(?=$|[\\s).,!?:;<])/g, \"$1<em>$2</em>\")\n      .replace(/(^|[\\s(>])_([^_\\n][^_]*?)_(?=$|[\\s).,!?:;<])/g, \"$1<em>$2</em>\")\n      .replace(/\\`([^\\`\\n]+)\\`/g, '<code class=\"md-code\">$1</code>');\n\n    if (output === previousOutput) {\n      break;\n    }\n  }\n\n  return output;\n};\n\nconst isLikelyHeading = (line, nextLine) => {\n  const text = String(line || \"\").trim();\n  const next = String(nextLine || \"\").trim();\n  if (!text || !next) return false;\n  if (/^(?:[-*+]\\s|\\d+[.)]\\s|>\\s?|#{1,6}\\s)/.test(text)) return false;\n  if (/^[a-z]/.test(text)) return false;\n  if (/[.!?]$/.test(text)) return false;\n  if (text.length > 90) return false;\n  return true;\n};\n\nconst getListMatch = (block) => String(block || \"\").match(/^(<(ol|ul)[^>]*class=\"md-list\"[^>]*>)([\\s\\S]*)<\\/\\2>$/);\n\nconst countListItems = (innerHtml) => (String(innerHtml || \"\").match(/<li>/g) || []).length;\n\nconst setOrderedListNumbering = (block, start) => {\n  const listHtml = String(block || \"\");\n  const normalizedStart = start && start > 1 ? start : 1;\n  const withStart = normalizedStart > 1\n    ? (/ start=\"\\d+\"/.test(listHtml)\n        ? listHtml.replace(/ start=\"\\d+\"/, ' start=\"' + normalizedStart + '\"')\n        : listHtml.replace('<ol class=\"md-list\"', '<ol class=\"md-list\" start=\"' + normalizedStart + '\"'))\n    : listHtml.replace(/ start=\"\\d+\"/, \"\");\n\n  let itemIndex = 0;\n  return withStart.replace(/<li(?: value=\"\\d+\")?>/g, () => {\n    const value = normalizedStart + itemIndex;\n    itemIndex += 1;\n    return '<li value=\"' + value + '\">';\n  });\n};\n\nconst mergeAdjacentLists = (blocks) => {\n  const merged = [];\n\n  for (let i = 0; i < blocks.length; i += 1) {\n    const block = blocks[i];\n\n    if (block === '<div class=\"md-space\"></div>') {\n      const prevMatch = getListMatch(merged[merged.length - 1]);\n      const nextMatch = getListMatch(blocks[i + 1]);\n      if (prevMatch && nextMatch && prevMatch[2] === nextMatch[2]) {\n        continue;\n      }\n    }\n\n    const currentMatch = getListMatch(block);\n    const lastMatch = getListMatch(merged[merged.length - 1]);\n    if (currentMatch && lastMatch && currentMatch[2] === lastMatch[2]) {\n      merged[merged.length - 1] = lastMatch[1] + lastMatch[3] + currentMatch[3] + '</' + currentMatch[2] + '>';\n      continue;\n    }\n\n    merged.push(block);\n  }\n\n  return merged;\n};\n\nconst isSupportingHeadingBlock = (block) => {\n  const headingMatch = String(block || \"\").match(/^<div class=\"md-heading [^\"]+\">([\\s\\S]*)<\\/div>$/);\n  if (!headingMatch) {\n    return false;\n  }\n  const text = headingMatch[1].replace(/<[^>]+>/g, \"\").trim();\n  return /:/.test(text) || /^\\(.+\\)$/.test(text);\n};\n\nconst normalizeOrderedListStarts = (blocks) => {\n  let nextOrderedStart = null;\n\n  return blocks.map((block) => {\n    const listMatch = getListMatch(block);\n    if (listMatch && listMatch[2] === 'ol') {\n      const count = countListItems(listMatch[3]);\n      const explicitStartMatch = listMatch[1].match(/ start=\"(\\d+)\"/);\n      let start = explicitStartMatch ? parseInt(explicitStartMatch[1], 10) : 1;\n\n      if ((!explicitStartMatch || start <= 1) && nextOrderedStart && nextOrderedStart > 1) {\n        start = nextOrderedStart;\n      }\n\n      nextOrderedStart = start + count;\n      return setOrderedListNumbering(block, start);\n    }\n\n    if (/^<hr class=\"md-rule\">$/.test(block)) {\n      nextOrderedStart = null;\n      return block;\n    }\n\n    if (/^<div class=\"md-heading /.test(block)) {\n      if (!isSupportingHeadingBlock(block)) {\n        nextOrderedStart = null;\n      }\n      return block;\n    }\n\n    if (listMatch && listMatch[2] === 'ul') {\n      return block;\n    }\n\n    if (/^<div class=\"md-space\"><\\/div>$/.test(block) || /^<div class=\"md-paragraph\">/.test(block) || /^<blockquote class=\"md-quote\">/.test(block)) {\n      return block;\n    }\n\n    nextOrderedStart = null;\n    return block;\n  });\n};\n\nconst formatStoredAiHtml = (html) => {\n  const lines = String(html || \"\").split(\"<br>\");\n  const blocks = [];\n  let paragraphLines = [];\n  let listType = \"\";\n  let listItems = [];\n  let orderedListStart = 1;\n  let quoteLines = [];\n  let pendingListBreak = false;\n\n  const flushParagraph = () => {\n    if (!paragraphLines.length) return;\n    const text = applyInlineMarkdown(paragraphLines.join(\" \").replace(/\\s+/g, \" \").trim());\n    if (text) {\n      blocks.push('<div class=\"md-paragraph\">' + text + '</div>');\n    }\n    paragraphLines = [];\n  };\n\n  const flushList = () => {\n    if (!listType || !listItems.length) {\n      listType = \"\";\n      listItems = [];\n      orderedListStart = 1;\n      return;\n    }\n    const startAttr = listType === \"ol\" && orderedListStart > 1 ? ' start=\"' + orderedListStart + '\"' : \"\";\n    const itemsHtml = listItems.map((item, index) => {\n      const valueAttr = listType === \"ol\" ? ' value=\"' + (orderedListStart + index) + '\"' : \"\";\n      return '<li' + valueAttr + '>' + applyInlineMarkdown(item) + '</li>';\n    }).join(\"\");\n    blocks.push('<' + listType + ' class=\"md-list\"' + startAttr + '>' + itemsHtml + '</' + listType + '>');\n    listType = \"\";\n    listItems = [];\n    orderedListStart = 1;\n  };\n\n  const formatQuoteContent = (lines) => {\n    const quoteBlocks = [];\n    let quoteParagraphLines = [];\n    let quoteListType = \"\";\n    let quoteListItems = [];\n\n    const flushQuoteParagraph = () => {\n      if (!quoteParagraphLines.length) return;\n      const text = applyInlineMarkdown(quoteParagraphLines.join(\" \").replace(/\\s+/g, \" \").trim());\n      if (text) {\n        quoteBlocks.push('<div class=\"md-paragraph\">' + text + '</div>');\n      }\n      quoteParagraphLines = [];\n    };\n\n    const flushQuoteList = () => {\n      if (!quoteListType || !quoteListItems.length) {\n        quoteListType = \"\";\n        quoteListItems = [];\n        return;\n      }\n      quoteBlocks.push('<' + quoteListType + ' class=\"md-list\">' + quoteListItems.map((item) => '<li>' + applyInlineMarkdown(item) + '</li>').join(\"\") + '</' + quoteListType + '>');\n      quoteListType = \"\";\n      quoteListItems = [];\n    };\n\n    for (const rawLine of lines) {\n      const trimmedLine = String(rawLine || \"\").trim();\n      if (!trimmedLine) {\n        flushQuoteParagraph();\n        flushQuoteList();\n        continue;\n      }\n\n      const quoteBulletMatch = trimmedLine.match(/^[-*+]\\s+(.+)$/);\n      if (quoteBulletMatch) {\n        flushQuoteParagraph();\n        if (quoteListType && quoteListType !== \"ul\") flushQuoteList();\n        quoteListType = \"ul\";\n        quoteListItems.push(quoteBulletMatch[1].trim());\n        continue;\n      }\n\n      const quoteOrderedMatch = trimmedLine.match(/^\\d+[.)]\\s+(.+)$/);\n      if (quoteOrderedMatch) {\n        flushQuoteParagraph();\n        if (quoteListType && quoteListType !== \"ol\") flushQuoteList();\n        quoteListType = \"ol\";\n        quoteListItems.push(quoteOrderedMatch[1].trim());\n        continue;\n      }\n\n      flushQuoteList();\n      quoteParagraphLines.push(trimmedLine);\n    }\n\n    flushQuoteParagraph();\n    flushQuoteList();\n    return quoteBlocks.join(\"\");\n  };\n\n  const flushQuote = () => {\n    if (!quoteLines.length) return;\n    const quoteHtml = formatQuoteContent(quoteLines);\n    if (quoteHtml) {\n      blocks.push('<blockquote class=\"md-quote\">' + quoteHtml + '</blockquote>');\n    }\n    quoteLines = [];\n  };\n\n  const flushAll = () => {\n    flushParagraph();\n    flushList();\n    flushQuote();\n  };\n\n  for (let i = 0; i < lines.length; i += 1) {\n    const rawLine = lines[i];\n    const trimmed = String(rawLine || \"\").trim();\n    const nextTrimmed = String(lines[i + 1] || \"\").trim();\n\n    if (!trimmed) {\n      if (quoteLines.length) {\n        flushQuote();\n        if (blocks.length > 0 && blocks[blocks.length - 1] !== '<div class=\"md-space\"></div>') {\n          blocks.push('<div class=\"md-space\"></div>');\n        }\n        continue;\n      }\n      if (listType && listItems.length) {\n        pendingListBreak = true;\n        continue;\n      }\n      flushParagraph();\n      if (blocks.length > 0 && blocks[blocks.length - 1] !== '<div class=\"md-space\"></div>') {\n        blocks.push('<div class=\"md-space\"></div>');\n      }\n      continue;\n    }\n\n    if (pendingListBreak) {\n      const isAnotherListItem = /^[-*+]\\s+/.test(trimmed) || /^\\d+[.)]\\s+/.test(trimmed);\n      if (!isAnotherListItem) {\n        flushList();\n        if (blocks.length > 0 && blocks[blocks.length - 1] !== '<div class=\"md-space\"></div>') {\n          blocks.push('<div class=\"md-space\"></div>');\n        }\n      }\n      pendingListBreak = false;\n    }\n\n    if (/^(?:---|\\*\\*\\*|___)$/.test(trimmed)) {\n      flushAll();\n      blocks.push('<hr class=\"md-rule\">');\n      continue;\n    }\n\n    const atxHeading = trimmed.match(/^(#{1,6})\\s+(.+)$/);\n    if (atxHeading) {\n      flushAll();\n      const level = Math.min(atxHeading[1].length, 3);\n      blocks.push('<div class=\"md-heading md-heading-' + level + '\">' + applyInlineMarkdown(atxHeading[2].trim()) + '</div>');\n      continue;\n    }\n\n    const quoteMatch = trimmed.match(/^>\\s?(.*)$/);\n    if (quoteMatch) {\n      flushParagraph();\n      flushList();\n      quoteLines.push(quoteMatch[1].trim());\n      continue;\n    }\n    flushQuote();\n\n    const bulletMatch = trimmed.match(/^[-*+]\\s+(.+)$/);\n    if (bulletMatch) {\n      flushParagraph();\n      if (listType && listType !== \"ul\") flushList();\n      listType = \"ul\";\n      listItems.push(bulletMatch[1].trim());\n      continue;\n    }\n\n    const orderedMatch = trimmed.match(/^(\\d+)[.)]\\s+(.+)$/);\n    if (orderedMatch) {\n      flushParagraph();\n      if (listType && listType !== \"ol\") flushList();\n      if (listType !== \"ol\" || !listItems.length) {\n        orderedListStart = parseInt(orderedMatch[1], 10) || 1;\n      }\n      listType = \"ol\";\n      listItems.push(orderedMatch[2].trim());\n      continue;\n    }\n\n    if (listType && listItems.length) {\n      const looksLikeNewBlock = isLikelyHeading(trimmed, nextTrimmed);\n      if (!looksLikeNewBlock) {\n        listItems[listItems.length - 1] += ' ' + trimmed;\n        continue;\n      }\n      flushList();\n    }\n\n    if (isLikelyHeading(trimmed, nextTrimmed)) {\n      flushParagraph();\n      const level = blocks.length === 0 ? 1 : 2;\n      blocks.push('<div class=\"md-heading md-heading-' + level + '\">' + applyInlineMarkdown(trimmed) + '</div>');\n      continue;\n    }\n\n    paragraphLines.push(trimmed);\n  }\n\n  flushAll();\n  return normalizeOrderedListStarts(mergeAdjacentLists(blocks)).join(\"\");\n};\n\nconst chatTurns = ($context.$nodes.PROCESS_CHAT_HISTORY_CODE.$output || {}).result || [];\nconst userTpl = '<div class=\"msg user\"><div class=\"meta\">USER</div><div class=\"body\">__U__</div></div>';\nconst aiTpl = '<div class=\"msg ai\"><div class=\"meta\">AI</div><div class=\"body\">__A__</div></div>';\n\nlet convoHtml = \"\";\n\nfor (const turn of chatTurns) {\n  let userRaw = String((turn || {}).USER ?? \"\").replace(/\\uFEFF|ï»¿/g, \"\");\n  for (let i = 0; i < 3; i += 1) {\n    let candidate = userRaw;\n    try { candidate = decodeURIComponent(escape(userRaw)); } catch (err) {}\n    if (!candidate || candidate === userRaw) {\n      break;\n    }\n    userRaw = candidate;\n  }\n  userRaw = normPunct(userRaw);\n  let userText = escHtml(userRaw);\n\n  let aiInput = String((turn || {}).AI ?? \"\").replace(/\\uFEFF|ï»¿/g, \"\");\n  for (let i = 0; i < 3; i += 1) {\n    let candidate = aiInput;\n    try { candidate = decodeURIComponent(escape(aiInput)); } catch (err) {}\n    if (!candidate || candidate === aiInput) {\n      break;\n    }\n    aiInput = candidate;\n  }\n  aiInput = normPunct(aiInput);\n\n  const anchorRegex = /<a\\b[^>]*\\bhref=([\"'])([^\"']*)\\1[^>]*>([\\s\\S]*?)<\\/a>/gi;\n  const urlRegex = /https?:\\/\\/[^\\s<>\"']+/gi;\n  const aiAnchors = [];\n  let aiWithTokens = \"\";\n  let lastIndex = 0;\n  let tokenCounter = 0;\n\n  while (true) {\n    const match = anchorRegex.exec(aiInput);\n    const segment = match ? aiInput.slice(lastIndex, match.index) : aiInput.slice(lastIndex);\n\n    let segOut = \"\";\n    let segIdx = 0;\n    while (true) {\n      const m = urlRegex.exec(segment);\n      if (!m) {\n        segOut += segment.slice(segIdx);\n        break;\n      }\n\n      segOut += segment.slice(segIdx, m.index);\n\n      let hrefRaw = String(m[0] ?? \"\");\n      for (let i = 0; i < 3; i += 1) {\n        let candidate = hrefRaw;\n        try { candidate = decodeURIComponent(escape(hrefRaw)); } catch (err) {}\n        if (!candidate || candidate === hrefRaw) {\n          break;\n        }\n        hrefRaw = candidate;\n      }\n      hrefRaw = normPunct(hrefRaw);\n\n      const token = \"__ANCHOR_TOKEN_\" + tokenCounter + \"__\";\n      tokenCounter += 1;\n\n      if (/^https?:\\/\\//i.test(hrefRaw)) {\n        const safeHref = hrefRaw\n          .replace(/&/g, \"&amp;\")\n          .replace(/\"/g, \"%22\")\n          .replace(/</g, \"\")\n          .replace(/>/g, \"\")\n          .replace(/'/g, \"%27\");\n        const safeText = escHtml(hrefRaw);\n        aiAnchors.push({ token, html: '<a href=\"' + safeHref + '\" target=\"_blank\" rel=\"noopener noreferrer\">' + safeText + '</a>' });\n        segOut += token;\n      } else {\n        segOut += m[0];\n      }\n\n      segIdx = urlRegex.lastIndex;\n    }\n    urlRegex.lastIndex = 0;\n\n    aiWithTokens += segOut;\n\n    if (!match) {\n      break;\n    }\n\n    let hrefRaw = String(match[2] ?? \"\").trim();\n    let textRaw = String(match[3] ?? \"\");\n\n    for (let i = 0; i < 3; i += 1) {\n      let hCandidate = hrefRaw;\n      let tCandidate = textRaw;\n      try { hCandidate = decodeURIComponent(escape(hrefRaw)); } catch (err) {}\n      try { tCandidate = decodeURIComponent(escape(textRaw)); } catch (err) {}\n      const sameH = (!hCandidate || hCandidate === hrefRaw);\n      const sameT = (!tCandidate || tCandidate === textRaw);\n      if (sameH && sameT) {\n        break;\n      }\n      if (!sameH) hrefRaw = hCandidate;\n      if (!sameT) textRaw = tCandidate;\n    }\n\n    hrefRaw = normPunct(hrefRaw);\n    textRaw = normPunct(textRaw);\n\n    const token = \"__ANCHOR_TOKEN_\" + tokenCounter + \"__\";\n    tokenCounter += 1;\n\n    let safeAnchorHtml = escHtml(textRaw);\n    if (/^https?:\\/\\//i.test(hrefRaw)) {\n      const safeHref = hrefRaw\n        .replace(/&/g, \"&amp;\")\n        .replace(/\"/g, \"%22\")\n        .replace(/</g, \"\")\n        .replace(/>/g, \"\")\n          .replace(/'/g, \"%27\");\n      safeAnchorHtml = '<a href=\"' + safeHref + '\" target=\"_blank\" rel=\"noopener noreferrer\">' + safeAnchorHtml + '</a>';\n    }\n\n    aiAnchors.push({ token, html: safeAnchorHtml });\n    aiWithTokens += token;\n    lastIndex = anchorRegex.lastIndex;\n  }\n\n  let aiText = escHtml(aiWithTokens);\n  for (const anchor of aiAnchors) {\n    aiText = aiText.replace(anchor.token, anchor.html);\n  }\n  aiText = formatStoredAiHtml(aiText);\n\n  userText = userTpl.replace(\"__U__\", userText);\n  aiText = aiTpl.replace(\"__A__\", aiText);\n  convoHtml += userText + aiText;\n}\n\nconst htmlDoc = '<!doctype html><html><head><meta charset=\"utf-8\"><title>' + title + '</title><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><style>body{font-family:Arial,sans-serif;margin:20px;background:#f5f7fb}.chat{max-width:800px;margin:0 auto;display:flex;flex-direction:column;gap:10px}.msg{max-width:70%;padding:10px 12px;border-radius:12px;border:1px solid #e0e0e0;background:#fff}.msg.user{align-self:flex-start;background:#d7ebff;border-color:#b5d6fb}.msg.ai{align-self:flex-start;background:#fff;border-color:#e0e0e0}.meta{font-size:12px;color:#666;margin-bottom:4px}.body{white-space:normal;word-wrap:break-word}.body a{color:#0b5fff;text-decoration:none}.body a:hover{text-decoration:underline}.body strong{font-weight:700}.md-code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;background:#eef2ff;border-radius:4px;padding:1px 4px}.md-paragraph{margin:0 0 8px 0;line-height:1.5}.md-heading{font-weight:700;line-height:1.3;margin:6px 0 8px 0}.md-heading-1{font-size:20px}.md-heading-2{font-size:18px}.md-heading-3{font-size:16px}.md-list{margin:0 0 10px 20px;padding:0}.md-list li{margin:0 0 6px 0;line-height:1.5}.md-rule{border:0;border-top:1px solid #d9e1f2;margin:10px 0}.md-space{height:6px}.md-quote{margin:0 0 10px 0;padding:8px 12px;border-left:3px solid #b8c7e6;background:#f8fbff;color:#334155}</style></head><body><div class=\"chat\">' + convoHtml + '</div></body></html>';\n\nlet base64ChatHistory = \"\";\nif (typeof TextEncoder !== \"undefined\") {\n  const bytes = new TextEncoder().encode(htmlDoc);\n  let binary = \"\";\n  const chunkSize = 32768;\n  for (let i = 0; i < bytes.length; i += chunkSize) {\n    binary += String.fromCharCode(...bytes.subarray(i, i + chunkSize));\n  }\n  base64ChatHistory = btoa(binary);\n} else {\n  const utf8Binary = encodeURIComponent(htmlDoc).replace(/%([0-9A-F]{2})/g, (_, p1) => String.fromCharCode(parseInt(p1, 16)));\n  base64ChatHistory = btoa(utf8Binary);\n}\n\npayload.enrollmentRelatedMaterials = [\n  {\n    DatatypeCode: \"FILE\",\n    Title: title,\n    Description: title,\n    FileName: \"LearningTutorTranscript.html\",\n    ContentRepositoryFileShared: false,\n    FileContents: base64ChatHistory\n  }\n];\n\nreturn payload;"
