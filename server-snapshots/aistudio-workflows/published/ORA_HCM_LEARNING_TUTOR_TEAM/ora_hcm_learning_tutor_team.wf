            "returnType": "object",
            "sourceCode": "let learningRecord = $context.$nodes.RECORD_EXTERNAL_LEARNING.$output;\n\nconst keys = [\"learningItemNumber\",\"learningItemTitle\",\"actualScore\",\"actualEffortInHours\",\"assignmentStatusMeaning\",\"assignmentJustification\",\"assignmentDetailsDeepLink\"];\n\nconst trimmedResults = Object.fromEntries(keys.map(k => [k, learningRecord[k]]).filter(([, v]) => v != null));\n\nreturn trimmedResults;"
