          "id": "1765510438640",
          "inputs": [
            {
              "id": "1765510438644_1",
              "name": "condition",
              "type": "string",
              "value": "{{String($context.$nodes.TRANSCRIPT_HELPER.$output || \"\").includes(\"Confirmed to Record: Yes\") || (($context.$system.$inputMessage || \"\").toLowerCase().trim() === \"yes\") || (($context.$system.$inputMessage || \"\").toLowerCase().includes(\"record the learning\")) || (($context.$system.$inputMessage || \"\").toLowerCase().includes(\"record these details\")) || (($context.$system.$inputMessage || \"\").toLowerCase().includes(\"all good\") && ($context.$system.$inputMessage || \"\").toLowerCase().includes(\"record\"))}}"
            }
          ],
          "type": "CONDITION"
        },
        {
