              "scope": "JOB",
              "type": "string",
              "value": "{{$context.$system.$inputMessage}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Load Cash Position Display Contracts",
            "returnType": "object",
            "sourceCode": "$context.$variables = $context.$variables || {};\n\nconst tableContracts = {\n  cashPositionSummary: [\n    \"LegalEntity\",\n    \"Currency\",\n    \"AccountCount\",\n    \"AtRiskAccounts\",\n    \"OpeningBalance\",\n    \"ClearedReceipts\",\n    \"ClearedPayments\",\n    \"IntradayClosingBalance\",\n    \"ExpectedReceipts\",\n    \"ScheduledPayments\",\n    \"FinalCashPosition\",\n    \"TargetBalance\",\n    \"SurplusOrDeficit\"\n  ],\n  cashPositionAccount: [\n    \"LegalEntity\",\n    \"Currency\",\n    \"BankAccount\",\n    \"OpeningBalance\",\n    \"ClearedReceipts\",\n    \"ClearedPayments\",\n    \"IntradayClosingBalance\",\n    \"ExpectedReceipts\",\n    \"ScheduledPayments\",\n    \"FinalCashPosition\",\n    \"TargetBalance\",\n    \"SurplusOrDeficit\"\n  ],\n  bankBalanceDetail: [\n    \"LegalEntity\",\n    \"BalanceAmount\",\n    \"Bank\",\n    \"BankBranch\",\n    \"BankAccount\",\n    \"LastKnownBalanceDate\",\n    \"TargetBalance\",\n    \"AgeInDays\",\n    \"VarianceAmount\",\n    \"BalanceCurrency\"\n  ],\n  bankBalanceByBankSummary: [\n    \"Bank\",\n    \"BalanceCurrency\",\n    \"BankAccountCount\",\n    \"LegalEntityCount\",\n    \"TotalBalanceAmount\",\n    \"TotalTargetBalance\",\n    \"TotalVarianceAmount\",\n    \"LatestBalanceDate\"\n  ],\n  bankBalanceByCurrencySummary: [\n    \"BalanceCurrency\",\n    \"BankCount\",\n    \"BankAccountCount\",\n    \"LegalEntityCount\",\n    \"TotalBalanceAmount\",\n    \"TotalTargetBalance\",\n    \"TotalVarianceAmount\",\n    \"LatestBalanceDate\"\n  ],\n  shortfallAccounts: [\n    \"LegalEntity\",\n    \"Bank\",\n    \"BankBranch\",\n    \"BankAccount\",\n    \"BalanceCurrency\",\n    \"BalanceAmount\",\n    \"TargetBalance\",\n    \"VarianceAmount\",\n    \"ShortfallAmount\",\n    \"LastKnownBalanceDate\",\n    \"BalanceType\"\n  ],\n  surplusAccounts: [\n    \"LegalEntity\",\n    \"Bank\",\n    \"BankBranch\",\n    \"BankAccount\",\n    \"BalanceCurrency\",\n    \"BalanceAmount\",\n    \"TargetBalance\",\n    \"VarianceAmount\",\n    \"SurplusAmount\",\n    \"LastKnownBalanceDate\",\n    \"BalanceType\"\n  ],\n  intradayStatementLines: [\n    \"LegalEntity\",\n    \"Bank\",\n    \"BankAccount\",\n    \"FlowDirection\",\n    \"Amount\",\n    \"BalanceCurrency\",\n    \"BookingDate\",\n    \"ValueDate\",\n    \"TransactionTime\",\n    \"TransactionType\",\n    \"TransactionCode\",\n    \"Description\",\n    \"SourceReference\"\n  ]\n};\n\nconst tableDefaults = {\n  Get_overall_current_cash_position: [\n    {\n      heading: \"Cash Position by Legal Entity and Currency\",\n      sourceRowKey: \"cashPositionSummaryRows\",\n      contractKey: \"cashPositionSummary\"\n    },\n    {\n      heading: \"Top Accounts Driving Today's Position\",\n      sourceRowKey: \"cashPositionTopContributorRows\",\n      contractKey: \"cashPositionAccount\"\n    }\n  ],\n  Get_current_cash_position_by_legal_entity: [\n    {\n      heading: \"Cash Position for the Requested Legal Entity\",\n      sourceRowKey: \"cashPositionSummaryRows\",\n      contractKey: \"cashPositionSummary\"\n    },\n    {\n      heading: \"Cash Position for Bank Accounts\",\n      sourceRowKey: \"cashPositionAccountRows\",\n      contractKey: \"cashPositionAccount\"\n    }\n  ],\n  Get_current_cash_position_by_bank_account: [\n    {\n      heading: \"Cash Position for the Requested Bank Account\",\n      sourceRowKey: \"rows\",\n      contractKey: \"cashPositionAccount\"\n    }\n  ],\n  Get_balance_shortfall_details: [\n    {\n      heading: \"Cash Position Shortfall Accounts\",\n      sourceRowKey: \"shortfallRows\",\n      contractKey: \"shortfallAccounts\"\n    }\n  ],\n  Get_surplus_balance_accounts: [\n    {\n      heading: \"Surplus Accounts\",\n      sourceRowKey: \"rows\",\n      contractKey: \"surplusAccounts\"\n    }\n  ],\n  \"Get_intra-day_details\": [\n    {\n      heading: \"Intraday Statement Lines\",\n      sourceRowKey: \"rows\",\n      contractKey: \"intradayStatementLines\"\n    }\n  ],\n  Get_balances_by_bank: [\n    {\n      heading: \"Bank Balance Summary\",\n      sourceRowKey: \"rows\",\n      contractKey: \"bankBalanceByBankSummary\"\n    }\n  ],\n  Get_balances_by_currency: [\n    {\n      heading: \"Bank Balance Summary by Currency\",\n      sourceRowKey: \"rows\",\n      contractKey: \"bankBalanceByCurrencySummary\"\n    }\n  ],\n  Get_specific_bank_account_balance: [\n    {\n      heading: \"Bank Balance Details\",\n      sourceRowKey: \"rows\",\n      contractKey: \"bankBalanceDetail\"\n    }\n  ],\n  bankBalanceDefault: [\n    {\n      heading: \"Bank Balance Details\",\n      sourceRowKey: \"rows\",\n      contractKey: \"bankBalanceDetail\"\n    }\n  ]\n};\n\n$context.$variables.cashPositionDisplayTableContracts = tableContracts;\n$context.$variables.cashPositionDisplayTableDefaults = tableDefaults;\n\nreturn {\n  tableContracts,\n  tableDefaults\n};"
          },
          "outcomes": {
            "success": "1775972909080"
          },
          "code": "LOAD_CASH_POSITION_DISPLAY_CONTRACTS",
