 - left._absFinalCashPosition);\n\n  const summaryGroups = {};\n  accountRows.forEach((row) => {\n    const summaryKey = buildKey(row.LegalEntity, \"\", row.Currency);\n    if (!summaryGroups[summaryKey]) {\n      summaryGroups[summaryKey] = {\n        LegalEntity: row.LegalEntity,\n        Currency: row.Currency,\n        AccountCount: 0,\n        OpeningBalance: 0,\n        ClearedReceipts: 0,\n        ClearedPayments: 0,\n        IntradayClosingBalance: 0,\n        ExpectedReceipts: 0,\n        ScheduledPayments: 0,\n        FinalCashPosition: 0,\n        TargetBalance: 0,\n        SurplusOrDeficit: 0,\n        _hasTargetBalance: false\n      };\n    }\n\n    const summary = summaryGroups[summaryKey];\n    if (normalizeText(row.BankAccount) !== \"unassigned\") {\n      summary.AccountCount += 1;\n    }\n    summary.OpeningBalance += row.OpeningBalance;\n    summary.ClearedReceipts += row.ClearedReceipts;\n    summary.ClearedPayments += row.ClearedPayments;\n    summary.IntradayClosingBalance += row.IntradayClosingBalance;\n    summary.ExpectedReceipts += row.ExpectedReceipts;\n    summary.ScheduledPayments += row.ScheduledPayments;\n    summary.FinalCashPosition += row.FinalCashPosition;\n    if (row.TargetBalance !== null) {\n      summary.TargetBalance += row.TargetBalance;\n      summary._hasTargetBalance = true;\n    }\n  });\n\n  const summaryRows = Object.keys(summaryGroups)\n    .map((groupKey) => {\n      const summary = summaryGroups[groupKey];\n      return {\n        LegalEntity: summary.LegalEntity,\n        Currency: summary.Currency,\n        AccountCount: summary.AccountCount,\n        OpeningBalance: roundMoney(summary.OpeningBalance),\n        ClearedReceipts: roundMoney(summary.ClearedReceipts),\n        ClearedPayments: roundMoney(summary.ClearedPayments),\n        IntradayClosingBalance: roundMoney(summary.IntradayClosingBalance),\n        ExpectedReceipts: roundMoney(summary.ExpectedReceipts),\n        ScheduledPayments: roundMoney(summary.Sc