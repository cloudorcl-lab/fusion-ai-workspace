          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
        },
        {
          "metadata": {
            "name": "Return Display Formatter Result",
            "returnType": "object",
            "sourceCode": "const AGENT_NAME = \"Cash Position Inquiry Assistant\";\n\nconst tryParseJson = (value) => {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  try {\n    return JSON.parse(value);\n  } catch (e) {\n    return value;\n  }\n};\n\nconst isObject = (value) => value !== null && typeof value === \"object\" && !Array.isArray(value);\n\nconst unwrapResult = (value) => {\n  let normalized = tryParseJson(value);\n  let depth = 0;\n\n  while (\n    isObject(normalized) &&\n    Object.prototype.hasOwnProperty.call(normalized, \"result\") &&\n    depth < 8\n  ) {\n    normalized = tryParseJson(normalized.result);\n    depth += 1;\n  }\n\n  return normalized;\n};\n\nconst formatterNode = $context.$nodes.FIN_AR_DISPLAY_FORMATTER;\nconst formatterOutput = formatterNode ? formatterNode.$output : null;\nconst normalizedOutput = unwrapResult(formatterOutput);\nconst candidate = isObject(normalizedOutput) && typeof normalizedOutput.output !== \"undefined\"\n  ? unwrapResult(normalizedOutput.output)\n  : normalizedOutput;\n\nif (isObject(candidate) && Array.isArray(candidate.agent_response)) {\n  return {\n    ...candidate,\n    agent: candidate.agent || AGENT_NAME\n  };\n}\n\nreturn {\n  agent: AGENT_NAME,\n  agent_response: [\n    {\n      display_type: \"text\",\n      display_sequence: 1,\n      text: \"Something went wrong while preparing the cash position response. Please try again.\"\n    }\n  ]\n};"
          },
