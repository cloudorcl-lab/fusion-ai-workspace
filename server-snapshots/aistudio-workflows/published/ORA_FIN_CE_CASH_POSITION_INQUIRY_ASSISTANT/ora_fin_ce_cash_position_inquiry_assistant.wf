{
  "workflowId": "300000331058432",
  "workflowCode": "ORA_FIN_CE_CASH_POSITION_INQUIRY_ASSISTANT",
  "name": "Cash Position Inquiry Assistant",
  "description": "Provides a consolidated overview of cash positions and bank balances by referencing prior-day and intraday statements, expected receipts, and scheduled disbursements; responds to insight alerts highlighting balances below targets, identifying stale bank balances and surfacing anomalies.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
