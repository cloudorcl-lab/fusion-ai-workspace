unt - outflowAmount;\n  return {\n    intradayInflowAmount: roundMoney(inflowAmount),\n    intradayOutflowAmount: roundMoney(outflowAmount),\n    intradayNetFlowAmount: roundMoney(Math.abs(netFlow)),\n    intradayNetFlowDirection: netFlow < 0 ? \"OUTFLOW\" : (netFlow > 0 ? \"INFLOW\" : \"NEUTRAL\")\n  };\n};\n\nlet activeRows = filteredRows;\nlet requiresAccountSelection = false;\nlet selectedAccount = appliedFilters.bankAccounts.length ? appliedFilters.bankAccounts[0] : \"\";\n\nif (selectedQueryCode === \"GETINTRADAYDETAILS\") {\n  activeRows = normalizeIntradayRows(filteredRows);\n  if (!appliedFilters.bankAccounts.length) {\n    if (impactedAccounts.length > 1) {\n      activeRows = [];\n      requiresAccountSelection = true;\n    } else if (impactedAccounts.length === 1) {\n      selectedAccount = impactedAccounts[0];\n      activeRows = activeRows.filter((row) => matchesAny(row.BankAccount, [selectedAccount]));\n    } else {\n      activeRows = [];\n    }\n  }\n} else if (selectedRoute === \"INTRADAY_SCOPE_DISCOVERY\") {\n  activeRows = [];\n  requiresAccountSelection = impactedAccounts.length !== 1;\n  if (!requiresAccountSelection && impactedAccounts.length === 1) {\n    selectedAccount = impactedAccounts[0];\n  }\n} else if (resolvedIntent === \"Get_balance_shortfall_details\") {\n  activeRows = shortfallRows;\n} else if (resolvedIntent === \"Get_surplus_balance_accounts\") {\n  activeRows = surplusRows.slice(0, 3);\n}\n\nconst hasStaleBalances = selectedQueryCode === \"GETSTALEORMISSINGBANKBALANCES\"\n  ? filteredRows.length > 0\n  : filteredRows.some((row) => {\n      const age = Number(row.AgeInDays);\n      return !Number.isNaN(age) && age > 0;\n    });\n\nconst hasShortfallAccounts = shortfallRows.some((row) => normalizeNumberOrNull(row.ShortfallAmount) !== null);\nconst intradayFlowSummary = selectedQueryCode === \"GETINTRADAYDETAILS\"\n  ? buildIntradayFlowSummary(activeRows)\n  : {\n      intradayInflowAmount: null,\n      intradayOutflowAmount: nul