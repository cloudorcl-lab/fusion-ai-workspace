            "name": "Build Cash Position Display Template",
            "returnType": "object",
            "sourceCode": "const AGENT_NAME = \"Cash Position Inquiry Assistant\";\n\nconst tryParseJson = (value) => {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  try {\n    return JSON.parse(value);\n  } catch (e) {\n    return value;\n  }\n};\n\nconst isObject = (value) => value !== null && typeof value === \"object\" && !Array.isArray(value);\n\nconst unwrapNodeOutput = (value) => {\n  const normalized = tryParseJson(value);\n\n  if (isObject(normalized) && Object.prototype.hasOwnProperty.call(normalized, \"result\")) {\n    return normalized.result;\n  }\n\n  return normalized;\n};\n\nconst getNodeOutput = (nodeCode) => {\n  const node = $context.$nodes[nodeCode];\n  return node ? unwrapNodeOutput(node.$output) : null;\n};\n\nconst normalizeString = (value) => {\n  if (value === null || value === undefined) {\n    return \"\";\n  }\n\n  return String(value).trim();\n};\n\nconst normalizeArray = (value) => Array.isArray(value) ? value : [];\n\nconst buildId = (prefix, index) => `${prefix}_${String(index + 1)}`;\n\nconst normalizeRows = (rows, columnOrder) => {\n  const sourceRows = normalizeArray(rows).filter(isObject);\n  const explicitColumns = normalizeArray(columnOrder)\n    .filter((field) => typeof field === \"string\" && field.trim().length)\n    .map((field) => field.trim())\n    .filter((field) => field.charAt(0) !== \"_\");\n\n  if (!explicitColumns.length) {\n    return sourceRows.map((row) => {\n      const normalized = {};\n      Object.keys(row).forEach((field) => {\n        if (field.charAt(0) !== \"_\") {\n          normalized[field] = row[field];\n        }\n      });\n      return normalized;\n    });\n  }\n\n  return sourceRows.map((row) => {\n    const normalized = {};\n    explicitColumns.forEach((field) => {\n      normalized[field] = Object.prototype.hasOwnProperty.call(row, field) ? row[field] : \"\";\n    });\n    return normalized;\n  });\n};\n\nconst normalizedResult = getNodeOutput(\"NORMALIZE_CASH_POSITION_RESULTS\") || {};\nconst validationResult = getNodeOutput(\"VALIDATE_CASH_POSITION_REQUEST\") || {};\nconst guardedDisplayPlan = getNodeOutput(\"GUARD_CASH_POSITION_DISPLAY_PLAN\") || {};\nconst classifiedIntent = validationResult.resolvedIntent || getNodeOutput(\"CASH_POSITION_INTENT_CLASSIFIER\") || \"Clarify_request\";\nconst isOffTopicRequest = validationResult.selectedQueryCode === \"OFF_TOPIC_REQUEST\" || classifiedIntent === \"Out_of_scope\";\nconst rawBusinessBlocks = isOffTopicRequest\n  ? getNodeOutput(\"OFF_TOPIC_RESPONSE_GENERATOR\")\n  : getNodeOutput(\"CASH_POSITION_RESPONSE_GENERATOR\");\nconst businessBlocks = normalizeArray(tryParseJson(rawBusinessBlocks));\nconst plannedTables = normalizeArray(guardedDisplayPlan.tables).filter(isObject);\n\nconst tableByHeading = {};\nplannedTables.forEach((table) => {\n  const heading = normalizeString(table.heading);\n  if (heading) {\n    tableByHeading[heading] = table;\n  }\n});\n\nconst resolveTableRows = (block, plannedTable) => {\n  if (\n    isObject(plannedTable) &&\n    typeof plannedTable.sourceRowKey === \"string\" &&\n    Array.isArray(normalizedResult[plannedTable.sourceRowKey])\n  ) {\n    return normalizedResult[plannedTable.sourceRowKey];\n  }\n\n  return block.content;\n};\n\nconst messages = [];\n\nbusinessBlocks.forEach((block) => {\n  if (!isObject(block) || typeof block.type !== \"string\") {\n    return;\n  }\n\n  if (block.type === \"text\") {\n    const content = normalizeArray(block.content)\n      .filter((item) => typeof item === \"string\" && item.trim().length)\n      .join(\" \")\n      .trim();\n    if (!content) {\n      return;\n    }\n\n    messages.push({\n      id: buildId(\"cash_position_text\", messages.length),\n      type: \"text\",\n      contentPolicy: \"preserve\",\n      data: content\n    });\n    return;\n  }\n\n  if (block.type === \"table\") {\n    const heading = normalizeString(block.heading) || \"Cash Position Details\";\n    const plannedTable = tableByHeading[heading];\n    const columnOrder = isObject(plannedTable) && Array.isArray(plannedTable.columns) && plannedTable.columns.length\n      ? plannedTable.columns\n      : block.columns;\n    const rows = normalizeRows(resolveTableRows(block, plannedTable), columnOrder);\n    if (!rows.length) {\n      return;\n    }\n\n    messages.push({\n      id: buildId(\"cash_position_table\", messages.length),\n      type: \"table\",\n      title: heading,\n      formattingMode: \"preAuthored\",\n      data: rows,\n      chatDisplayConfig: {\n        limitRowsInChat: true,\n        rowLimit: 5\n      },\n      authoringHints: \"Use the supplied cash-position column order and render this table without LLM table authoring.\"\n    });\n    return;\n  }\n\n  if (block.type === \"actions\") {\n    const actions = normalizeArray(block.content)\n      .filter((item) => typeof item === \"string\" && item.trim().length)\n      .map((item) => item.trim());\n    if (!actions.length) {\n      return;\n    }\n\n    messages.push({\n      id: buildId(\"cash_position_actions\", messages.length),\n      type: \"action\",\n      formattingMode: \"preAuthored\",\n      data: actions\n    });\n  }\n});\n\nif (!messages.length) {\n  messages.push({\n    id: \"cash_position_no_data\",\n    type: \"text\",\n    contentPolicy: \"preserve\",\n    data: \"No matching balances were found.\"\n  });\n}\n\nreturn {\n  workflowName: AGENT_NAME,\n  messages\n};"
          },
