            "name": "FORMAT SMART VIEW RESPONSE",
            "returnType": "object",
            "sourceCode": "let balance_agent_response = $context.$nodes.LEDGER_BALANCE_EXPLANATION_ASSISTANCE.$output;\nlet smartViewLink = $context.$nodes.GET_SMARTVIEW_LINK.$output.outputFormat;\nlet toolTimeStamp;\n\nfor(const obj of balance_agent_response) {\n    if(obj['type']) {\n        toolTimeStamp = obj['toolTimeStamp'];\n    }\n}\n\n\nlet agent_response_schema = [\n    {\n        \"type\" : \"metadata\",\n        \"intent\" : \"smartView\",\n        \"toolTimeStamp\" : toolTimeStamp \n    },\n    {\n        \"display_type\" : \"text\",\n        \"data\" : smartViewLink\n    }\n]\nreturn agent_response_schema;"
          },
          "outcomes": {
