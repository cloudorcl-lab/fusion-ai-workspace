        {
          "metadata": {
            "errorNodeId": "1767903158028",
            "name": "Summarization Pre Processor",
            "returnType": "object",
            "sourceCode": "let agentOutput;\nlet agentName;\nlet category;\n\nif ($context.$nodes.HELP_TOPIC_ASSISTANCE.$output) {\n    agentOutput = $context.$nodes.HELP_TOPIC_ASSISTANCE.$output;\n    agentName = \"ora_fin_gl_help_topic_assistant\";\n    category = \"help\";\n}\nelse if ($context.$nodes.GENERAL_LEDGER_FUNCTIONS_ASSISTANCE.$output) {\n    agentOutput = $context.$nodes.GENERAL_LEDGER_FUNCTIONS_ASSISTANCE.$output;\n    agentName = \"ora_fin_gl_general_ledger_functions_assistant\";\n    category = \"glf\";\n}\nelse if ($context.$nodes.JOURNAL_ACTIVITY_EXPLANATION_ASSISTANCE.$output) {\n    agentOutput = $context.$nodes.JOURNAL_ACTIVITY_EXPLANATION_ASSISTANCE.$output;\n    agentName = \"ora_fin_gl_journals_assistant\";\n    category = \"journal\";\n}\nelse if ($context.$nodes.LEDGER_BALANCE_EXPLANATION_ASSISTANCE.$output) {\n    if ($context.$nodes.FORMAT_SMART_VIEW_RESPONSE.$output) {\n        agentOutput = $context.$nodes.FORMAT_SMART_VIEW_RESPONSE.$output.result;\n    } else {\n        agentOutput = $context.$nodes.LEDGER_BALANCE_EXPLANATION_ASSISTANCE.$output;\n    }\n    agentName = \"ora_fin_gl_balance_inquiry_and_analysis_assistant\";\n    category = \"balances\";\n}\nelse if ($context.$nodes.FINANCIAL_REPORTING_ASSISTANCE.$output) {\n    agentOutput = $context.$nodes.FINANCIAL_REPORTING_ASSISTANCE.$output;\n    agentName = \"ora_fin_gl_financial_reporting_assistant\";\n    category = \"report\";\n}\nelse if ($context.$nodes.SUBLEDGER_SUPPORTING_DETAILS_ASSISTANCE.$output) {\n    agentOutput = $context.$nodes.SUBLEDGER_SUPPORTING_DETAILS_ASSISTANCE.$output;\n    agentName = \"ora_fin_gl_subledger_supporting_details_assistant\";\n    category = \"subledger\";\n}\nelse if ($context.$nodes.FINANCIAL_INSIGHTS_EXPLANATION_ASSISTANCE.$output) {\n    agentOutput = $context.$nodes.FINANCIAL_INSIGHTS_EXPLANATION_ASSISTANCE.$output;\n    let ctx = $context.$triggers.REST.$input.additional_context;\n\n    if (ctx && ctx.hasOwnProperty(\"bossExtract\")) {\n        let query = ctx[\"bossExtract\"][\"queries\"][0];\n\n        if (query.hasOwnProperty(\"analyticViews\")) {\n            let analyticViews = query[\"analyticViews\"];\n\n            if (analyticViews.includes(\"ora_erp_core_accountedTransactions_runtime_x__JournalSummary\")) {\n                agentName = \"ora_fin_gl_journals_assistant\";\n                category = \"journal\";\n            } else if (analyticViews.includes(\"oraErpCoreAccountBalancesRuntime\")) {\n                agentName = \"ora_fin_gl_balance_inquiry_and_analysis_assistant\";\n                category = \"balances\";\n            } else {\n                agentName = \"ora_fin_gl_subledger_supporting_details_assistant\";\n                category = \"subledger\";\n            }\n        } else {\n            let viewQueries = query[\"viewQueries\"];\n\n            if (\n                viewQueries.includes(\"payablesAccountedInvoiceDetail\") ||\n                viewQueries.includes(\"payablesAccountedPrepaymentDetail\") ||\n                viewQueries.includes(\"receivablesAccountedCoreTransactionDetail\") ||\n                viewQueries.includes(\"receivablesAccountedCreditMemoApplicationDetail\") ||\n                viewQueries.includes(\"receivablesAccountedMiscellaneousReceiptDetail\") ||\n                viewQueries.includes(\"receivablesAccountedStandardReceiptDetail\") ||\n                viewQueries.includes(\"receivablesAccountedAdjustmentDetail\") ||\n                viewQueries.includes(\"payablesAccountedPaymentDetail\")\n            ) {\n                agentName = \"ora_fin_gl_subledger_supporting_details_assistant\";\n                category = \"subledger\";\n            } else if (\n                viewQueries.includes(\"generalLedgerJournalDetail\") ||\n                viewQueries.includes(\"journalActionLogDetails\") ||\n                viewQueries.includes(\"journalHeaderDetail\")\n            ) {\n                agentName = \"ora_fin_gl_journals_assistant\";\n                category = \"journal\";\n            } else {\n                agentName = \"ora_fin_gl_process_exceptions_assistant\";\n                category = \"exceptions\";\n            }\n        }\n    } else {\n        agentName = \"ora_fin_fun_insights_assistant\";\n        category = \"insights\";\n    }\n}\nelse if ($context.$nodes.PROCESS_EXCEPTIONS_ASSISTANCE.$output) {\n    agentOutput = $context.$nodes.PROCESS_EXCEPTIONS_ASSISTANCE.$output;\n    agentName = \"ora_fin_gl_process_exceptions_assistant\";\n    category = \"exceptions\";\n}\nelse if ($context.$nodes.EXPORT_TO_EXCEL_ASSISTANCE.$output) {\n    agentOutput = $context.$nodes.EXPORT_TO_EXCEL_ASSISTANCE.$output;\n    agentName = \"ora_fin_gl_export_to_excel_assistant\";\n    category = \"exportexcel\";\n}\nelse if ($context.$nodes.HIERARCHY_MANAGER_ASSISTANT.$output) {\n    agentOutput = $context.$nodes.HIERARCHY_MANAGER_ASSISTANT.$output;\n    agentName = \"ora_fin_gl_hierarchy_manager_assistant\";\n    category = \"hierarchy\";\n}\n\nlet normalizedAgentOutput = agentOutput;\nlet keepNormalizingAgentOutput = true;\n\nwhile (keepNormalizingAgentOutput) {\n    keepNormalizingAgentOutput = false;\n\n    if (\n        normalizedAgentOutput &&\n        typeof normalizedAgentOutput === \"object\" &&\n        !Array.isArray(normalizedAgentOutput) &&\n        Object.prototype.hasOwnProperty.call(normalizedAgentOutput, \"result\")\n    ) {\n        normalizedAgentOutput = normalizedAgentOutput.result;\n        keepNormalizingAgentOutput = true;\n        continue;\n    }\n\n    if (\n        normalizedAgentOutput &&\n        typeof normalizedAgentOutput === \"object\" &&\n        !Array.isArray(normalizedAgentOutput) &&\n        typeof normalizedAgentOutput.value === \"string\"\n    ) {\n        normalizedAgentOutput = normalizedAgentOutput.value;\n        keepNormalizingAgentOutput = true;\n    }\n}\n\nif (Array.isArray(normalizedAgentOutput)) {\n    agentOutput = normalizedAgentOutput;\n} else if (typeof normalizedAgentOutput === \"string\") {\n    try {\n        const parsedOutput = JSON.parse(normalizedAgentOutput);\n\n        if (Array.isArray(parsedOutput)) {\n            agentOutput = parsedOutput;\n        }\n    } catch (error) {\n        // Use the original string as a text response below.\n    }\n\n    if (!Array.isArray(agentOutput)) {\n        agentOutput = [\n            {\n                display_type: \"text\",\n                data: normalizedAgentOutput\n            }\n        ];\n    }\n} else {\n    agentOutput = normalizedAgentOutput;\n}\n\nlet textOnly = true;\nlet agentResponseArr = [];\nlet itemCount = 1;\nlet toolTimeStamp;\nlet intent;\nlet metadataObj = null;\nlet selectedHierarchies;\n\nfor (const obj of agentOutput) {\n    if (obj[\"type\"]) {\n        metadataObj = obj;\n        toolTimeStamp = obj[\"toolTimeStamp\"];\n        intent = obj[\"intent\"];\n    } else {\n        if (obj[\"display_type\"] !== \"text\" && obj[\"display_type\"] !== \"action\") {\n            textOnly = false;\n        } else {\n            if (obj[\"display_type\"] === \"text\") {\n                let currItem = {\n                    display_type: \"text\",\n                    display_sequence: itemCount,\n                    text: obj.data\n                };\n\n                agentResponseArr.push(currItem);\n            } else {\n                let currItem = {\n                    display_type: \"action\",\n                    display_sequence: itemCount,\n                    actions: {\n                        items: obj.data\n                    }\n                };\n\n                agentResponseArr.push(currItem);\n            }\n\n            itemCount += 1;\n        }\n    }\n}\n\nconst selectedLedger =\n    $context.$nodes.FILTER_DIFFERENT_COA_LEDGERS?.$output?.result || null;\nconst selectedLedgerName = selectedLedger ? selectedLedger.ledgerName : null;\nconst hierarchyManagerOutput = $context.$nodes.HIERARCHY_MANAGER_ASSISTANT?.$output ?? [];\n\nfor (const obj of hierarchyManagerOutput) {\n    if (\n        obj?.type === \"metadata\" &&\n        typeof obj?.selectedHierarchies === \"string\" &&\n        obj.selectedHierarchies.trim() !== \"\"\n    ) {\n        selectedHierarchies = obj.selectedHierarchies;\n        break;\n    }\n}\n\nif (!(typeof selectedHierarchies === \"string\" && selectedHierarchies.trim() !== \"\")) {\n    const syntaxTemplateHierarchyOutput =\n        $context.$nodes.DERIVE_SYNTAX_TEMPLATE_SELECTED_HIERARCHIES?.$output;\n    let syntaxTemplateSelectedHierarchies = \"\";\n\n    if (\n        typeof syntaxTemplateHierarchyOutput?.result?.selectedHierarchies === \"string\" &&\n        syntaxTemplateHierarchyOutput.result.selectedHierarchies.trim() !== \"\"\n    ) {\n        syntaxTemplateSelectedHierarchies =\n            syntaxTemplateHierarchyOutput.result.selectedHierarchies;\n    } else if (\n        typeof syntaxTemplateHierarchyOutput?.selectedHierarchies === \"string\" &&\n        syntaxTemplateHierarchyOutput.selectedHierarchies.trim() !== \"\"\n    ) {\n        syntaxTemplateSelectedHierarchies =\n            syntaxTemplateHierarchyOutput.selectedHierarchies;\n    }\n\n    if (syntaxTemplateSelectedHierarchies) {\n        selectedHierarchies = syntaxTemplateSelectedHierarchies;\n    }\n}\n\nif (metadataObj) {\n    if (selectedLedgerName) {\n        metadataObj[\"user_chosen_ledgers\"] = selectedLedgerName;\n    } else if (Object.prototype.hasOwnProperty.call(metadataObj, \"user_chosen_ledgers\")) {\n        delete metadataObj[\"user_chosen_ledgers\"];\n    }\n\n    if (typeof selectedHierarchies === \"string\") {\n        metadataObj[\"selectedHierarchies\"] = selectedHierarchies;\n    } else if (Object.prototype.hasOwnProperty.call(metadataObj, \"selectedHierarchies\")) {\n        delete metadataObj[\"selectedHierarchies\"];\n    }\n}\n\nconst response = {};\n\nif (textOnly) {\n    response[\"requiresllm\"] = false;\n    response[\"agentResponse\"] = agentResponseArr;\n    response[\"metadata\"] = {\n        agentName: agentName,\n        category: category\n    };\n\n    if (toolTimeStamp) {\n        response[\"metadata\"][\"timeStamp\"] = toolTimeStamp;\n        response[\"metadata\"][\"intent\"] = intent;\n    }\n\n    if (selectedLedgerName) {\n        response[\"metadata\"][\"user_chosen_ledgers\"] = selectedLedgerName;\n    }\n\n    if (typeof selectedHierarchies === \"string\") {\n        response[\"metadata\"][\"selectedHierarchies\"] = selectedHierarchies;\n    }\n\n} else {\n    response[\"requiresllm\"] = true;\n    response[\"agentOutput\"] = agentOutput;\n    response[\"agentName\"] = agentName;\n}\n\nreturn response;"
          },
