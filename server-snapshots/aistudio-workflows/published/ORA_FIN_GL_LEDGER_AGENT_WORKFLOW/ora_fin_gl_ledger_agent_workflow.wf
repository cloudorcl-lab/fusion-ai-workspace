            "sourceCode": "const selectedLedger =\n  $context.$nodes.FILTER_DIFFERENT_COA_LEDGERS?.$output?.result ??\n  $context.$nodes.LEDGER_SELECTION_LLM?.$output?.selectedLedger ??\n  null;\n\nconst chartOfAccountsId = String(\n  selectedLedger?.chartOfAccountsId ??\n  $context.$triggers.REST.$input.additional_context?.chartOfAccountsId ??\n  0\n);\n\n// use this value downstream\nreturn chartOfAccountsId;"
