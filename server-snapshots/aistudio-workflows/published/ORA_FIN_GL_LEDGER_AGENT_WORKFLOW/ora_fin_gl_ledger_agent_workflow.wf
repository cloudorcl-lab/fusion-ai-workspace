            "returnType": "boolean",
            "sourceCode": "const boOutput = $context.$nodes.PRODUCE_FINAL_JSON.$output;\nif(!('agent_response' in boOutput)){\n   return false;\n}\nelse if(boOutput['agent_response'].length === 0){\n   return false;\n}\nreturn true;"
          },
          "outcomes": {
