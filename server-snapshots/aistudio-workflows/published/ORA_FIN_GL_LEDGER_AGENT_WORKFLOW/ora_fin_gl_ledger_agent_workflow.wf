        {
          "metadata": {
            "errorNodeId": "1767903158028",
            "name": "Syntax Template Selected Hierarchies Derivation",
            "returnType": "object",
            "sourceCode": "let filter = \"\";\nlet queryEntry = $context.$triggers.REST.$input.additional_context?.queries?.[0];\n\nif (typeof queryEntry?.query?.filter === \"string\") {\n    filter = queryEntry.query.filter;\n}\n\nlet rawCoaDetails =\n    $context.$nodes.GET_COA_DETAILS_FOR_SYNTAX_TEMPLATE_FILTER?.$output?.result;\nlet coaRows = [];\n\nif (Array.isArray(rawCoaDetails)) {\n    coaRows = rawCoaDetails;\n} else if (Array.isArray(rawCoaDetails?.result)) {\n    coaRows = rawCoaDetails.result;\n}\n\nlet qualifierDimensionMap = new Object();\n\nfor (let i = 0; i < coaRows.length; i += 1) {\n    let segment = coaRows[i];\n    let segmentCode = segment?.segmentCode || \"\";\n    let dimensionAlias = String(segmentCode).replace(/[_\\-\\s]/g, \"\");\n\n    if (!dimensionAlias) {\n        continue;\n    }\n\n    let dimensionName =\n        dimensionAlias.charAt(0).toLowerCase() + dimensionAlias.slice(1);\n    let labels = [];\n    let segmentLabels = segment?.segmentLabels;\n\n    if (Array.isArray(segmentLabels)) {\n        for (let j = 0; j < segmentLabels.length; j += 1) {\n            let labelFromArray = String(segmentLabels[j]).trim();\n            if (labelFromArray) {\n                labels.push(labelFromArray);\n            }\n        }\n    } else if (typeof segmentLabels === \"string\") {\n        let labelsText = segmentLabels.replace(/^\\[/, \"\").replace(/\\]$/, \"\");\n        let rawLabels = labelsText.split(\",\");\n\n        for (let j = 0; j < rawLabels.length; j += 1) {\n            let labelFromString = rawLabels[j].trim();\n            if (labelFromString) {\n                labels.push(labelFromString);\n            }\n        }\n    }\n\n    for (let j = 0; j < labels.length; j += 1) {\n        let qualifierLabel = labels[j];\n\n        if (!qualifierDimensionMap[qualifierLabel]) {\n            qualifierDimensionMap[qualifierLabel] = dimensionName;\n        }\n    }\n}\n\nlet tuples = [];\n\nif (typeof filter === \"string\" && filter.trim() !== \"\") {\n    let treeVersionPattern =\n        /([A-Za-z_$][A-Za-z0-9_$.]*)\\.(?:treeVersionName|treeFilter)\\s*=\\s*'((?:''|[^'])*)'/gi;\n    let match;\n\n    while ((match = treeVersionPattern.exec(filter)) !== null) {\n        let dimensionName = String(match[1] || \"\")\n            .trim()\n            .replace(/Hierarchy$/i, \"\")\n            .replace(/R(?=[A-Z])/g, \"\");\n\n        if (dimensionName === \"glAccount\") {\n            dimensionName = qualifierDimensionMap.GL_ACCOUNT || dimensionName;\n        } else if (dimensionName === \"glBalancing\") {\n            dimensionName = qualifierDimensionMap.GL_BALANCING || dimensionName;\n        }\n\n        let treeVersionName = String(match[2] || \"\").replace(/''/g, \"'\").trim();\n\n        if (!dimensionName || !treeVersionName) {\n            continue;\n        }\n\n        let existingIndex = -1;\n\n        for (let i = 0; i < tuples.length; i += 1) {\n            if (tuples[i].dimensionName === dimensionName) {\n                existingIndex = i;\n                break;\n            }\n        }\n\n        let tuple = new Object();\n        tuple.dimensionName = dimensionName;\n        tuple.treeVersionName = treeVersionName;\n\n        if (existingIndex >= 0) {\n            tuples[existingIndex] = tuple;\n        } else {\n            tuples.push(tuple);\n        }\n    }\n}\n\nlet selectedHierarchyParts = [];\n\nfor (let i = 0; i < tuples.length; i += 1) {\n    selectedHierarchyParts.push(\n        \"(\" + tuples[i].dimensionName + \"||\" + tuples[i].treeVersionName + \")\"\n    );\n}\n\nlet selectedHierarchies = selectedHierarchyParts.join(\",\");\n\nlet result = new Object();\nresult.selectedHierarchies = selectedHierarchies;\n\nreturn result;"
          },
          "outcomes": {
            "success": "1778143964952"
          },
