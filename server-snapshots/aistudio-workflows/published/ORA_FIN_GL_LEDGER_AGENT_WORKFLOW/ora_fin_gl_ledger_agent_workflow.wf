        {
          "metadata": {
            "errorNodeId": "1767903158028",
            "name": "Construct Smart View Payload",
            "returnType": "object",
            "sourceCode": "let smartViewPayloadSchema = {\n    colAxisDimensionList: \"col axis from worker's agent\",\n    rowAxisDimensionList: \"row axis from worker's agent\",\n    analyticViews: \"analyticView from worker's agent\",\n    filter: \"filter from worker's agent\",\n    select: \"select string from worker's agent\",\n    lastBreakdownBy: \"\"\n};\n\nlet agentOutput = $context.$nodes.LEDGER_BALANCE_EXPLANATION_ASSISTANCE.$output;\n\nconst fields = [\"colAxisDimensionList\", \"rowAxisDimensionList\", \"analyticViews\", \"filter\", \"select\", \"lastBreakdownBy\"];\n\nfor (const obj of agentOutput) {\n    if (obj.display_type === 'text' && fields.includes(obj.fieldName)) {\n        smartViewPayloadSchema[obj.fieldName] = obj.data;\n    }\n}\n\nreturn smartViewPayloadSchema;"
          },
          "outcomes": {
            "success": "1768562430319"
          },
          "code": "CONSTRUCT_SMART_VIEW_PAYLOAD",
