        {
          "metadata": {
            "errorNodeId": "1767903158028",
            "name": "Check Hierarchy Manager Output",
            "returnType": "object",
            "sourceCode": "let result = {\n    shouldRouteToAgents: true,\n    targetAgentOverride: false\n};\n\nlet agentOutput = $context.$nodes.HIERARCHY_MANAGER_ASSISTANT?.$output;\n\nif (agentOutput) {\n    for (const obj of agentOutput) {\n        const intent = obj[\"intent\"];\n\n        if (intent === \"directResponse\") {\n            result = {\n                shouldRouteToAgents: false,\n                targetAgentOverride: false\n            };\n            break;\n        }\n\n        if (intent === \"agentRouting\") {\n            result = {\n                shouldRouteToAgents: true,\n                targetAgentOverride: false\n            };\n\n            if (typeof obj[\"targetAgent\"] === \"string\" && obj[\"targetAgent\"] !== \"\") {\n                result.targetAgent = obj[\"targetAgent\"];\n                result.targetAgentOverride = true;\n            }\n\n            break;\n        }\n    }\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1775833401957"
          },
          "code": "HIERACHY_OVERRIDE_REQUEST_IDENTIFIER",
          "id": "1775833222753",
          "inputs": [],
