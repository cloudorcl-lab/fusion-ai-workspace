        {
          "metadata": {
            "errorNodeId": "1767903158028",
            "name": "Deterministic Routing Decision",
            "returnType": "string",
            "sourceCode": "let ctx = $context.$triggers.REST.$input.additional_context;\nlet hist = $context.$system.$chatHistory;\n\nif (ctx.hasOwnProperty(\"bossExtract\") && hist.length === 0) {\n  return \"ora_fin_fun_insights_assistant\";\n}\nif (ctx.hasOwnProperty(\"inquiryTargetObjectType\") && ctx[\"inquiryTargetObjectType\"] != null) {\n  let inquiryTargetObjectType = ctx[\"inquiryTargetObjectType\"];\n  if (inquiryTargetObjectType === \"balances\") {\n    return \"ora_fin_gl_balance_inquiry_and_analysis_assistant\";\n  }\n  if (inquiryTargetObjectType === \"journals\") {\n    return \"ora_fin_gl_journals_assistant\";\n  }\n  if (inquiryTargetObjectType === \"subledgers\") {\n    return \"ora_fin_gl_subledger_supporting_details_assistant\";\n  }\n  if (inquiryTargetObjectType === \"reports\") {\n    return \"ora_fin_gl_financial_reporting_assistant\";\n  }\n}\nreturn \"unknown\";"
          },
          "outcomes": {
            "success": "1770417697508"
          },
          "code": "DETERMINISTIC_ROUTING_DECISION",
          "id": "1771395628441",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1767903158028",
            "name": "FORMAT FALLBACK LLM RESPONSE",
            "returnType": "object",
            "sourceCode": "let formatFallBackLlmResponseInput = $context.$nodes.SUMMARIZATION_NODE.$output;\nlet obj =\n  typeof formatFallBackLlmResponseInput === \"string\"\n    ? JSON.parse(formatFallBackLlmResponseInput)\n    : formatFallBackLlmResponseInput;\n\nconst NON_LEAF_NODE_STYLE_TAG_PREFIX = \"<span style='font-weight: 600;'>\";\nconst NON_LEAF_NODE_STYLE_TAG_SUFFIX = \"</span>\";\n\nif (obj && Array.isArray(obj.agent_response)) {\n  for (let i = 0; i < obj.agent_response.length; i++) {\n    const ar = obj.agent_response[i];\n\n    if (ar && ar.display_type === \"table\" && ar.rows && Array.isArray(ar.rows.items)) {\n      const items = ar.rows.items;\n\n      for (let r = 0; r < items.length; r++) {\n        const row = items[r];\n        if (!row || typeof row !== \"object\") continue;\n\n        const keys = Object.keys(row);\n        for (let k = 0; k < keys.length; k++) {\n          const field = keys[k];\n          const val = row[field];\n\n          if (val == null) continue;\n          if (typeof val !== \"string\") continue;\n          if (val.trim().length === 0) continue;\n\n          const firstIdx = val.indexOf(\"||\");\n          if (firstIdx === -1) continue;\n\n          const secondIdx = val.indexOf(\"||\", firstIdx + 2);\n          if (secondIdx !== -1) continue;\n\n          const left = val.slice(0, firstIdx).trim();\n          const right = val.slice(firstIdx + 2).trim();\n\n          if (right !== \"0\" && right !== \"1\") continue;\n\n          if (right === \"0\") {\n            row[field] = NON_LEAF_NODE_STYLE_TAG_PREFIX + left + NON_LEAF_NODE_STYLE_TAG_SUFFIX;\n          } else {\n            row[field] = left;\n          }\n        }\n      }\n    }\n  }\n}\n\n\nreturn obj;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "FORMAT_FALLBACK_LLM_RESPONSE",
          "id": "1773326870136",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Construct Context Object 2",
            "returnType": "object",
            "sourceCode": "const input = $context.$system.$inputMessage;\nlet additionalContext = { ...$context.$triggers.REST.$input.additional_context };\n\nconst selectedLedger =\n  $context.$nodes.FILTER_DIFFERENT_COA_LEDGERS?.$output?.result ?? null;\n\nif (selectedLedger) {\n  additionalContext.ledgerId = selectedLedger.ledgerId;\n  additionalContext.ledgerContext = selectedLedger.ledgerName;\n  additionalContext.ledgerCategory = selectedLedger.ledgerCategory;\n  additionalContext.chartOfAccountsId = selectedLedger.chartOfAccountsId;\n  additionalContext.analyticView = selectedLedger.avName;\n}\n\n\nconst hierarchyOutput = $context.$nodes.HIERARCHY_MANAGER_ASSISTANT?.$output ?? [];\nlet selectedHierarchies = \"\";\nlet footerText = \"\";\nlet scopeChange = \"\";\n\n\nfor (const obj of hierarchyOutput) {\n  if (obj?.type === \"metadata\") {\n    if (typeof obj?.selectedHierarchies === \"string\") {\n      selectedHierarchies = obj.selectedHierarchies;\n    }\n    if (typeof obj?.footerText === \"string\") {\n      footerText = obj.footerText;\n    }\n    if (typeof obj?.scopeChange === \"string\") {\n      scopeChange = obj.scopeChange;\n    }\n    break;\n  }\n}\n\nif (selectedHierarchies != \"\") {\n  additionalContext.selectedHierarchies = selectedHierarchies;\n}\n\nif (footerText != \"\") {\n  additionalContext.footerText = footerText;\n}\n\nif (scopeChange != \"\") {\n  additionalContext.scopeChange = scopeChange;\n}\n\nif ( $context.$variables.routingDecision === \"ora_fin_gl_subledger_supporting_details_assistant\" ) {\n  const { analyticView, ...rest } = additionalContext;\n  additionalContext = rest;\n}\n\n\nconst context = JSON.stringify(additionalContext);\nconst history = $context.$system.$chatHistory;\n\nreturn \"<USER_MESSAGE>\" + input + \"</USER_MESSAGE>\\n<CONTEXT>\" + context + \"</CONTEXT>\\n<CHAT_HISTORY>\" + history + \"</CHAT_HISTORY>\";"
          },
          "outcomes": {
            "success": "1775738776970"
          },
          "code": "CONSTRUCT_CONTEXT_OBJECT_2",
          "id": "1775738321232",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
