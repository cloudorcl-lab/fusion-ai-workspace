{
  "workflowId": "300000327004294",
  "workflowCode": "ORA_COSTING_RELATED_SUB_LEDGER_STATUS_INQUIRY_ASSISTANT",
  "name": "Costing Related Subledger Status Inquiry Assistant",
  "description": "This agent retrieves the current accounting period status for subledgers associated with a specified ledger, including General Ledger (GL), Accounts Payable (AP), and Accounts Receivable (AR).\n\nCapabilities\n* Returns the open or closed status of GL, AP, and AR for a given ledger and accounting period\n* Calculates the number of days remaining until the period close deadline\n* Determines whether the period is eligible for closure based on subledger statuses\n* Indicates when the period cannot be closed due to one or more subledgers remaining open\n\nDecision Logic\n* If any subledger period (GL, AP, or AR) is open, period close is not allowed\n* If all subledger periods are closed, period close is allowed (status-based validation only)\n\nScope Boundaries\n* Does not perform or initiate period closing\n* Does not evaluate or resolve close exceptions\n* Does not provide remediation guidance\n* Does not address accounting policies or full close workflows\n\nWhen to Use\nUse this agent when the user:\n* Asks for subledger period status\n* Wants to know how many days remain before period close\n* Asks whether a period can be closed based on GL, AP, and AR status\n* Requests ledger-specific period status information",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
