            "returnType": "object",
            "sourceCode": "return {\n  agent_response: [\n    {\n      display_type: \"text\",\n      display_sequence: 1,\n      text:\n        \"I cannot process the request at this time. I can assist with detailed invoice inquiries.<br/>You can ask me questions such as:<br/><br/>'Show overdue invoices where exception exists.'<br/>'Show invoices with approval status Approved.'<br/>'List invoices with validation status Incomplete for supplier Vision Operations and Invoice Creation Date From past 7 days.'\"\n    },\n    {\n      display_type: \"canvas\",\n      display_sequence: 2,\n      canvas_content: \"\"\n    }\n  ]\n};"
          },
