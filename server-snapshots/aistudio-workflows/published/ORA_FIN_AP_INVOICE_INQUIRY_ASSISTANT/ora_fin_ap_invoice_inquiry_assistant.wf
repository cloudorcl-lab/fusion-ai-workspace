        {
          "metadata": {
            "name": "Check Inquiry Valid Rejected Invoice",
            "returnType": "boolean",
            "sourceCode": "let filters = $context.$variables.extractedFilters || [];\n\nif (typeof filters === \"string\") {\n  try {\n    filters = JSON.parse(filters);\n  } catch (e) {\n    return false;\n  }\n}\n\nfunction isSupportedFilterList(filters) {\n  const supportedAttributes = new Set([\n    \"invoiceId\",\n    \"documentStreamDetail.streamDetailId\",\n    \"documentStreamDetail.name\",\n    \"documentStreamDetail.stream.lookupCode\",\n    \"documentStreamDetail.stream.meaning\",\n    \"invoiceNumber\",\n    \"supplier.name\",\n    \"invoiceAmount\",\n    \"businessUnit.name\",\n    \"supplierSite.name\",\n    \"purchaseOrderNumber\",\n    \"timeCreated\",\n    \"stagedInvoiceStatus.meaning\",\n    \"stagedInvoiceStatus.lookupCode\",\n    \"invoiceStatus.lookupCode\",\n    \"invoiceStatus.meaning\",\n    \"invoiceTypeCode.meaning\",\n    \"invoiceSource.meaning\",\n    \"invoiceCurrency.currencyCode\",\n    \"exception.lookupCode\",\n    \"exception.meaning\"\n  ]);\n\n  if (!Array.isArray(filters)) {\n    return false;\n  }\n\n  for (const filter of filters) {\n    if (!filter || typeof filter !== \"object\") {\n      return false;\n    }\n\n    const attributeName = String(filter.attributeName || \"\").trim();\n\n    if (!supportedAttributes.has(attributeName)) {\n      return false;\n    }\n  }\n\n  return true;\n}\n\nreturn isSupportedFilterList(filters);"
          },
          "outcomes": {
            "success": "1780297036528"
          },
          "code": "FIN_AP_CHECK_INQUIRY_VALID_REJECTED_INVOICE",
          "id": "1780296675041",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
