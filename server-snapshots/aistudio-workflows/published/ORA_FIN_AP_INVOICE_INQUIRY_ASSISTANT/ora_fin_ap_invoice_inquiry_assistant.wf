        {
          "metadata": {
            "name": "Check Inquiry Valid Standard Invoice",
            "returnType": "boolean",
            "sourceCode": "let filters = $context.$variables.extractedFilters || [];\n\nif (typeof filters === \"string\") {\n  try {\n    filters = JSON.parse(filters);\n  } catch (e) {\n    return false;\n  }\n}\n\nfunction isSupportedFilterList(filters) {\n  const supportedAttributes = new Set([\n    \"invoiceId\",\n    \"streamDetailId\",\n    \"documentName\",\n    \"streamCode\",\n    \"stream\",\n    \"invoiceNumber\",\n    \"supplierName\",\n    \"invoiceAmount\",\n    \"dueDate\",\n    \"businessUnit\",\n    \"supplierSite\",\n    \"purchaseOrderNumber\",\n    \"creationDate\",\n    \"status\",\n    \"statusCode\",\n    \"approvalStatusCode\",\n    \"approvalStatus\",\n    \"paidStatusCode\",\n    \"paidStatus\",\n    \"invoiceStatusCode\",\n    \"invoiceStatus\",\n    \"type\",\n    \"source\",\n    \"currencyCode\",\n    \"exceptionCode\",\n    \"exception\",\n    \"accountCodingStatus\",\n    \"accountCodingStatusCode\",\n    \"fundsStatus\",\n    \"fundsStatusCode\"\n  ]);\n\n  if (!Array.isArray(filters)) {\n    return false;\n  }\n\n  if (filters.length === 0) {\n    return false;\n  }\n\n  for (const filter of filters) {\n    if (!filter || typeof filter !== \"object\") {\n      return false;\n    }\n\n    const attributeName = String(filter.attributeName || \"\").trim();\n\n    if (!supportedAttributes.has(attributeName)) {\n      return false;\n    }\n  }\n\n  return true;\n}\n\nreturn isSupportedFilterList(filters);"
          },
          "outcomes": {
            "success": "1780297001696"
          },
          "code": "FIN_AP_CHECK_INQUIRY_VALID_STANDARD_INVOICE",
          "id": "1780296614280",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
