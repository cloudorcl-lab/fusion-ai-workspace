          },
          "outcomes": {
            "success": "1781084969356"
          },
          "code": "FIN_AP_EXECUTE_INSIGHT_BQL",
          "convergenceTargetId": "1781082778368",
          "id": "1781074919894",
          "inputs": [
            {
              "id": "1781074963951_1",
              "name": "extraction_query_json_object",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.FLOWINPUT}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Return Insight Flow"
          },
          "outcomes": {},
          "code": "FIN_AP_RETURN_INSIGHT_FLOW",
          "convergenceTargetId": "1777618768205",
          "id": "1781083358484",
          "inputs": [
            {
              "id": "1781083358485_1",
              "name": "returnValue",
              "type": "string",
              "value": "{{$context.$nodes.FIN_AP_MERGE_INSIGHT_RESULT.$output.result}}"
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "name": "Merge Insight Result",
            "returnType": "array",
            "sourceCode": "const tableNode = $context.$nodes.FIN_AP_BUILD_INSIGHT_TABLE;\nconst filterNode = $context.$nodes.FIN_AP_BUILD_INSIGHT_FILTER;\n\nconst tableResult = tableNode && tableNode.$output\n  ? tableNode.$output.result || []\n  : [];\n\nconst filterResult = filterNode && filterNode.$output\n  ? filterNode.$output.result || {}\n  : {};\n\nconst chatContent = Array.isArray(tableResult) ? tableResult : [];\n\nconst responseText = String(filterResult.responseText || \"\").trim();\n\nreturn {\n  agent_response: [\n    {\n      display_type: \"text\",\n      display_sequence: 1,\n      text: \"Here is the summary for insight requested.\"\n    },\n    {\n      display_type: \"canvas\",\n      display_sequence: 2,\n      canvas_content: {\n        filters: filterResult.filters || [],\n        serviceFilter: filterResult.serviceFilter || \"\",\n        serviceEndpoint: filterResult.serviceEndpoint || \"\"\n      }\n    },\n    ...chatContent,\n    ...(responseText\n      ? [\n          {\n            display_type: \"text\",\n            display_sequence: chatContent.length + 3,\n            text: responseText\n          }\n        ]\n      : [])\n  ]\n};"
          },
          "outcomes": {
            "success": "1781083358484"
          },
          "code": "FIN_AP_MERGE_INSIGHT_RESULT",
          "id": "1781084572732",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Build Insight Filter",
            "returnType": "array",
            "sourceCode": "const STANDARD_ENDPOINT =\n  \"/api/boss/extraction/queries/ora/erpCore/payablesInvoices/v1:550/$en/payablesInvoiceTransactions\";\n\nconst REJECTED_ENDPOINT =\n  \"/api/boss/data/objects/ora/erpCore/payablesInvoices/v1:550/$en/payablesStagedInvoiceDetails\";\n\nfunction parseMaybeJson(value) {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  try {\n    return JSON.parse(value);\n  } catch (e) {\n    return value;\n  }\n}\n\nfunction escapeFilterValue(value) {\n  return String(value).replace(/'/g, \"''\");\n}\n\nfunction getSupplier(row) {\n  return String(\n    row?.supplierName ||\n    row?.SUPPLIERNAME ||\n    row?.supplierDisplay ||\n    row?.SUPPLIERDISPLAY ||\n    row?.Supplier ||\n    row?.supplier ||\n    \"\"\n  ).trim();\n}\n\nfunction getDateMinusDays(days) {\n  const currentDateText = String($context.$system?.$currentDate || \"\").trim();\n  const currentDate = currentDateText\n    ? new Date(`${currentDateText}T00:00:00.000Z`)\n    : new Date();\n\n  currentDate.setUTCDate(currentDate.getUTCDate() - days);\n\n  return currentDate.toISOString().slice(0, 10);\n}\n\nfunction formatDateValue(attributeName, value, operator) {\n  const text = String(value);\n\n  if (\n    (attributeName === \"creationDate\" || attributeName === \"timeCreated\") &&\n    /^\\d{4}-\\d{2}-\\d{2}$/.test(text)\n  ) {\n    if (operator === \"greater than or equal to\") {\n      return `${text}T00:00:00.000Z`;\n    }\n\n    if (operator === \"less than or equal to\") {\n      return `${text}T23:59:59.999Z`;\n    }\n\n    if (operator === \"less than\") {\n      return `${text}T00:00:00.000Z`;\n    }\n\n    if (operator === \"greater than\") {\n      return `${text}T23:59:59.999Z`;\n    }\n  }\n\n  return text;\n}\n\nconst operatorMap = {\n  equals: \"=\",\n  \"not equals\": \"!=\",\n  \"greater than\": \">\",\n  \"less than\": \"<\",\n  \"greater than or equal to\": \">=\",\n  \"less than or equal to\": \"<=\"\n};\n\nconst insightName = String(\n  $context.$triggers?.REST?.$input?.FLOWINSIGHTNAME ||\n  $context.$parameters?.FLOWINSIGHTNAME ||\n  \"\"\n).toLowerCase();\n\nconst isRejected = insightName.includes(\"reject\");\nlet rows = parseMaybeJson($context.$nodes.FIN_AP_EXECUTE_INSIGHT_BQL.$output);\n\nif (rows && typeof rows.output === \"string\") {\n  rows = parseMaybeJson(rows.output);\n}\n\nif (!Array.isArray(rows)) {\n  rows = [];\n}\n\nconst suppliers = Array.from(\n  new Set(\n    rows\n      .map(getSupplier)\n      .filter(value => value)\n      .filter(value => !/^others\\s*\\(/i.test(value))\n      .filter(value => !/^unknown supplier$/i.test(value))\n  )\n);\n\nconst filters = [];\n\nif (isRejected) {\n  filters.push({\n    attributeName: \"stagedInvoiceStatus.lookupCode\",\n    attributeValue: \"REJECTED\"\n  });\n}\n\nfilters.push({\n  attributeName: isRejected ? \"timeCreated\" : \"creationDate\",\n  attributeValue: getDateMinusDays(30),\n  operator: \"greater than or equal to\"\n});\n\nif (!isRejected) {\n  filters.push({\n    attributeName: \"exception\",\n    attributeValue: \"Policy Violations\"\n  });\n}\n\nif (suppliers.length > 0) {\n  filters.push({\n    attributeName: isRejected ? \"supplier.name\" : \"supplierName\",\n    attributeValue: suppliers,\n    operator: \"IN\"\n  });\n}\n\nconst serviceFilter = filters\n  .map(filter => {\n    if (Array.isArray(filter.attributeValue)) {\n      return `(${filter.attributeName} IN (${filter.attributeValue\n        .map(value => `'${escapeFilterValue(value)}'`)\n        .join(\",\")}))`;\n    }\n\n    const operator = filter.operator || \"equals\";\n    const symbol = operatorMap[operator] || \"=\";\n    const value = formatDateValue(filter.attributeName, filter.attributeValue, operator);\n\n    return `(${filter.attributeName} ${symbol} '${escapeFilterValue(value)}')`;\n  })\n  .join(\" AND \");\n\nconst responseText = isRejected\n  ? \"Rejected invoices for top suppliers created in the last 30 days are displayed in the canvas. To make corrections, click Download and update the invoices.\"\n  : \"Here are invoices with policy violations for top suppliers created for last 30 days.\";\n\nreturn {\n  filters,\n  serviceFilter,\n  serviceEndpoint: isRejected ? REJECTED_ENDPOINT : STANDARD_ENDPOINT,\n  responseText\n};"
          },
          "outcomes": {
            "success": "1781085041353"
          },
          "code": "FIN_AP_BUILD_INSIGHT_FILTER",
          "id": "1781084969356",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Build Insight Table",
            "returnType": "array",
            "sourceCode": "function parseMaybeJson(value) {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  try {\n    return JSON.parse(value);\n  } catch (e) {\n    return value;\n  }\n}\n\nfunction getValue(row, ...keys) {\n  for (const key of keys) {\n    if (row?.[key] !== undefined && row?.[key] !== null) {\n      return row[key];\n    }\n  }\n\n  return \"\";\n}\n\nlet rows = parseMaybeJson($context.$nodes.FIN_AP_EXECUTE_INSIGHT_BQL.$output);\n\nif (rows && typeof rows.output === \"string\") {\n  rows = parseMaybeJson(rows.output);\n}\n\nif (!Array.isArray(rows)) {\n  rows = [];\n}\n\nconst groupedRows = {};\n\nfor (const row of rows) {\n  const observation = String(\n    getValue(row, \"observation\", \"OBSERVATION\", \"Observation\")\n  ).trim();\n\n  const supplierDisplay = String(\n    getValue(row, \"supplierDisplay\", \"SUPPLIERDISPLAY\", \"Supplier Display\")\n  ).trim();\n\n  const invoiceCount = getValue(row, \"invoiceCount\", \"INVOICECOUNT\", \"Invoice Count\");\n\n  if (!observation || !supplierDisplay) {\n    continue;\n  }\n\n  if (!groupedRows[observation]) {\n    groupedRows[observation] = [];\n  }\n\n  groupedRows[observation].push({\n    \"Top Suppliers\": supplierDisplay,\n    \"Invoices\": invoiceCount\n  });\n}\n\nconst columns = {\n  items: [\n    {\n      headerText: \"Top Suppliers\",\n      field: \"Top Suppliers\",\n      id: \"Top Suppliers\",\n      resizable: \"enabled\",\n      className: \"\",\n      template: \"\"\n    },\n    {\n      headerText: \"Invoices\",\n      field: \"Invoices\",\n      id: \"Invoices\",\n      resizable: \"enabled\",\n      className: \"\",\n      template: \"\"\n    }\n  ]\n};\n\nconst tableContent = Object.keys(groupedRows).map((observation, index) => ({\n  display_type: \"table\",\n  display_sequence: index + 3,\n  heading: `Observation: ${observation}`,\n  rows: {\n    items: groupedRows[observation]\n  },\n  columns,\n  keyAttributes: {\n    items: [\"Top Suppliers\"]\n  },\n  accessibility: {\n    \"row.accessible-row-header\": \"Top Suppliers\"\n  }\n}));\n\nreturn tableContent;"
          },
          "outcomes": {
            "success": "1781084572732"
          },
          "code": "FIN_AP_BUILD_INSIGHT_TABLE",
