          "code": "FIN_AP_SET_FILTER_REJECTED_INVOICE",
          "id": "1780298106606",
          "inputs": [
            {
              "id": "1780298115495",
              "name": "extractedFilters",
              "scope": "JOB",
              "type": "array",
