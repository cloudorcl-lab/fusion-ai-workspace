          "code": "GET_BUSINESS_UNIT_ID",
          "id": "1774965575052",
          "inputs": [
            {
              "id": "1774965592098_1",
              "name": "BUName",
              "type": "string",
              "value": "{{$context.$nodes.GET_USER_DETAILS.$output.items[0].BusinessUnit}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Return Business Unit ID",
            "returnType": "object",
            "sourceCode": "const BUDetails = $context.$nodes.GET_BUSINESS_UNIT_ID.$output;\nconst SelfServiceUserResponse = $context.$nodes.GET_SELFSERVICE_USER.$output;\n\nconst items = SelfServiceUserResponse?.items || [];\nconst SelfServiceUserDetails = items[0]; // base user info\n\n// Build unique role codes\nconst UserRoles = [...new Set(items.map(item => item.RelationshipTypeCd))];\n\n// Build unique role meanings\nconst UserRoleMeanings = [...new Set(items.map(item => item.RelationshipTypeCdMeaning))];\n\nlet userPersona = \"\";\n\nif (SelfServiceUserDetails?.LoginId === \"ssresource@example.com\") {\n  userPersona = \"Buyer\";\n}\n\nif (SelfServiceUserDetails?.LoginId === \"ssresource1@example.com\") {\n  userPersona = \"FinanceManager\";\n}\n\nreturn {\n  LoginId: SelfServiceUserDetails?.LoginId,\n  Email: SelfServiceUserDetails?.EmailAddress,\n  BusinessUnitId: BUDetails?.items?.[0]?.BusinessUnitId,\n  AccountPartyNumber: SelfServiceUserDetails?.AccountPartyNumber,\n  AccountPartyId: SelfServiceUserDetails?.AccountPartyId,\n  ContactPartyId: SelfServiceUserDetails?.ContactPartyId,\n  ContactPartyNumber: SelfServiceUserDetails?.ContactPartyNumber,\n  AccountPartyName: SelfServiceUserDetails?.AccountPartyName,\n  ContactPartyName: SelfServiceUserDetails?.ContactPartyName,\n  UserPersona: userPersona,\n  UserRoles: UserRoles,\n  UserRoleMeanings: UserRoleMeanings\n};"
          },
          "outcomes": {
            "success": "1776727658999"
          },
          "code": "RETURN_BUSINESS_UNIT_ID",
          "id": "1774965634333",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
