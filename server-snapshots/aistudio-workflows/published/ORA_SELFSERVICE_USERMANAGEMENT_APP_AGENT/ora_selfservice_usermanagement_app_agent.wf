        {
          "metadata": {
            "name": "Create Query for Request Search",
            "returnType": "object",
            "sourceCode": "let qObj = {};\n//process request status\nlet inputStatusCd =  $context.$variables.queryRequestStatus || \"\";\n\nif(inputStatusCd){\n    let statusCd;\n    const approveRegex = new RegExp(\"Approve\", 'i');\n    const rejectRegex= new RegExp(\"reject\", 'i');\n    const pendingRegex = new RegExp(\"pending\", 'i');\n    let isApprove = approveRegex.test(inputStatusCd);\n    let isReject = rejectRegex.test(inputStatusCd);\n    let isPending = pendingRegex.test(inputStatusCd);\n    if(isApprove){\n        statusCd = \"ORA_CSS_APPROVED\";\n    } else if(isReject){\n        statusCd = \"ORA_CSS_REJECTED\";\n    }else if(isPending){\n        statusCd = \"ORA_CSS_PENDING\";\n    }\n    if (statusCd) {\n    qObj.StatusCd = statusCd;\n    }\n}\n\n//process account name\nlet inputAccount = $context.$variables.accountName || \"\"; \nif(inputAccount){\n    qObj.AccountKey = inputAccount;\n}\n//Process Email\nlet inputEmail = $context.$variables.email || \"\";\nif(inputEmail){\n    qObj.EmailAddress = inputEmail;\n}\n\n//process Name\nlet firstName = $context.$variables.firstName || \"\";\nif(firstName) {\n    qObj.PersonFirstName=firstName;\n}\nlet lastName = $context.$variables.lastName || \"\";\nif(lastName) {\n    qObj.PersonLastName=lastName;\n}\n\n// ----- Date-specific checks for CreationDate (calendar-days / ranges) -----\n// Expected variables produced by the date-intent prompt:\n//   hasDateTimeIntent (boolean)\n//   rangeStart (UTC ISO string: YYYY-MM-DDTHH:mm:ssZ) - inclusive\n//   rangeEndExclusive (UTC ISO string: YYYY-MM-DDTHH:mm:ssZ) - exclusive\n\nlet hasDateTimeIntent = ($context.$variables.hasDateTimeIntent === true);\nlet rangeStart = $context.$variables.rangeStart || \"\";\nlet rangeEndExclusive = $context.$variables.rangeEndExclusive || \"\";\n\n// Add CreationDate filters into qObj as special keys, then translate to operators\nif (hasDateTimeIntent) {\n  if (rangeStart) {\n    // CreationDate >= rangeStart\n    qObj.__creationDateGte = rangeStart;\n  }\n  if (rangeEndExclusive) {\n    // CreationDate < rangeEndExclusive\n    qObj.__creationDateLt = rangeEndExclusive;\n  }\n}\n\n//create query param from qObj (with date operator support)\nconst res = Object.entries(qObj)\n  .map(([key, value]) => {\n    // Date-specific operators (added)\n    if (key === \"__creationDateGte\") return `CreationDate>='${value}'`;\n    if (key === \"__creationDateLt\")  return `CreationDate<'${value}'`;\n\n    // Existing behavior for all other fields\n    return `${key} LIKE '${value}'`;\n  })\n  .join(' AND ');\n\nreturn {res};"
          },
          "outcomes": {
            "success": "1772183634300"
          },
          "code": "CREATE_QUERY_FOR_REQUEST_SEARCH",
          "id": "1772184781077",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Search Users Payload",
            "returnType": "object",
            "sourceCode": "let qObj = {};\n//process request status\nlet inputStatusCd =  $context.$variables.queryIntent|| \"\";\n\n//process account name\nlet inputAccount = $context.$variables.accountName || \"\"; \nif(inputAccount){\n    qObj.Account = inputAccount;\n}\n//Process Email\nlet inputEmail = $context.$variables.email || \"\";\nif(inputEmail){\n    qObj.EmailAddress = inputEmail;\n}\n\n//process Name\nlet firstName = $context.$variables.firstName || \"\";\nlet lastName = $context.$variables.lastName || \"\";\nif(firstName ) {\n    qObj.Name=firstName;\n}\n\nif(lastName) {\n    qObj.Name=lastName;\n}\nif(firstName && lastName) {\n    qObj.Name=firstName+\" \"+lastName;\n}\n\nlet queryRoles= $context.$variables.queryRole || \"\";\nif(queryRoles){\nqObj.RoleName=queryRoles;\n}\n\n// ----- Date-specific checks for CreationDate (calendar-days / ranges) -----\n// Expected variables produced by the date-intent prompt:\n//   hasDateTimeIntent (boolean)\n//   rangeStart (UTC ISO string: YYYY-MM-DDTHH:mm:ssZ) - inclusive\n//   rangeEndExclusive (UTC ISO string: YYYY-MM-DDTHH:mm:ssZ) - exclusive\n\nlet hasDateTimeIntent = ($context.$variables.hasDateTimeIntent === true);\nlet rangeStart = $context.$variables.rangeStart || \"\";\nlet rangeEndExclusive = $context.$variables.rangeEndExclusive || \"\";\n\n// Add CreationDate filters into qObj as special keys, then translate to operators\nif (hasDateTimeIntent) {\n  if (rangeStart) {\n    // CreationDate >= rangeStart\n    qObj.__creationDateGte = rangeStart;\n  }\n  if (rangeEndExclusive) {\n    // CreationDate < rangeEndExclusive\n    qObj.__creationDateLt = rangeEndExclusive;\n  }\n}\n\n//create query param from qObj (with date operator support)\nconst res = Object.entries(qObj)\n  .map(([key, value]) => {\n    // Date-specific operators (added)\n    if (key === \"__creationDateGte\") return `CreationDate>='${value}'`;\n    if (key === \"__creationDateLt\")  return `CreationDate<'${value}'`;\n\n    // Existing behavior for all other fields\n    return `${key} LIKE '%${value}%'`;\n  })\n  .join(' AND ');\n\nreturn {inputStatusCd,res,queryRoles};"
          },
          "outcomes": {
            "success": "1772619242565"
          },
          "code": "SEARCH_USERS_PAYLOAD",
          "id": "1772616469702",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
