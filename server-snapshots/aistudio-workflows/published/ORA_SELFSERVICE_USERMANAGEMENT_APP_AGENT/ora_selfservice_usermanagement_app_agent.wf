        {
          "metadata": {
            "name": "GetUserDetailsPanel_Code",
            "returnType": "array",
            "sourceCode": "let payload = $context.$nodes.GETMYROLES.$output; \n\n// Transform the payload\nconst transformed = Object.values(\n    payload.items.reduce((acc, item) => {\n        const accountId = item.AccountPartyId;\n        if (!acc[accountId]) {\n            acc[accountId] = {\n                AccountPartyId: item.AccountPartyId,\n                AccountPartyName: item.AccountPartyName,\n                ContactPartyName: item.ContactPartyName,\n                EmailAddress: item.EmailAddress,\n                Roles: new Set()\n            };\n        }\n        acc[accountId].Roles.add(item.RelationshipTypeCdMeaning);\n        return acc;\n    }, {})\n).map(account => ({\n    ...account,\n    Roles: Array.from(account.Roles).join(', ')\n}));\n\nreturn transformed;"
          },
          "outcomes": {
            "success": "1771523889578"
          },
          "code": "GETUSERDETAILSPANELCODE",
          "id": "1774973007643",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
