        {
          "metadata": {
            "name": "update roles payload",
            "returnType": "array",
            "sourceCode": "let currentRoles = $context.$nodes.GET_USER_ROLES.$output.items;\nlet userData = $context.$nodes.GET_USER_DETAILS.$output;\nlet parts = [];\nlet submissionInfo = $context.$nodes.CODE_IS_FORM_SUBMIT.$output.result;\nlet payloadStr = submissionInfo.payload;\nlet formInput = JSON.parse(payloadStr);\nformInput.forEach(item => {\n  let foundItem = currentRoles.find(roleItem => roleItem.RelationshipTypeCd === item.id);\n  if(item.value === \"yes\"){\n    if(!foundItem){\n      let createPayload = {};\n      createPayload.id = `CreateNewRole${item.id}`;\n      createPayload.path = \"/selfServiceRoles/\";\n      createPayload.operation = \"create\";\n      let payload = {};\n      payload.AccountPartyId = userData.AccountPartyId;\n      payload.ContactPartyId = userData.ContactPartyId;\n      payload.RelationshipTypeCd = item.id;\n      createPayload.payload = payload;\n      parts.push(createPayload);\n    }\n  } else if(item.value === \"no\"){\n    if(foundItem){\n      let deletePayload = {};\n      deletePayload.id = `Delete${item.id}`;\n      deletePayload.path = `/selfServiceRoles/${foundItem.RoleId}`;\n      deletePayload.operation = \"delete\";\n      parts.push(deletePayload);\n    }\n  }\n});\nreturn parts;"
          },
          "outcomes": {
            "success": "1773087647315"
          },
          "code": "UPDATE_ROLES_PAYLOAD",
