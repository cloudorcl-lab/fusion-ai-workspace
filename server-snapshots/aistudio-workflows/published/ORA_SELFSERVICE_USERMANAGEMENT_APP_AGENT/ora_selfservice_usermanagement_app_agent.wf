          "id": "1771947805806",
          "inputs": [
            {
              "id": "1771947805808_1",
              "name": "prompt",
              "type": "string",
              "value": "Input = {{$context.$nodes.GET_INTENT_LLM.$output}} :\n\nStrictly Show the widget title as \"New Self‑Service User Request\"\nStrictly Show the widget description text as \"Enter the user’s details below, then select Submit to send an access request for approval.\"\nStrictly use the values for <accountName>, <email>, <firstName> and <lastName> from the input if value is available\n<accountName>= {{$context.$variables.accountName}} \n<email> = {{$context.$variables.email}} \n<firstName>  = {{$context.$variables.firstName}} \n<lastName> = {{$context.$variables.lastName}} \n\ngenerate a recordWidget with id=create_form and readonly=false and fields:\nfields: [\n        { id: \"account\", label: \"Account Key\", value:<accountName>, type: \"text\" },\n        { id: \"email\", label: \"Email\", value:<email>, type: \"text\" },\n        { id: \"firstName\", label: \"First Name\", value:<firstName>, type: \"text\" },\n        { id: \"lastName\", label: \"Last Name\", value:<lastName>,  type: \"text\" }\n]\n\nOutput rules\n\n{\n  \"patternId\": \"recordWidget\",\n  \"title\" : \"New Self‑Service User Request\",\n  \"description\": \"Enter the user’s details below, then select Submit to send an access request for approval.\",\n  \"config\": {\n    \"id\": \"create_form\",\n    \"readOnly\": false,\n    \"fields\": [\n      {\n        \"id\": \"account\",\n        \"type\": \"text\",\n        \"label\": \"Account Key\",\n        \"value\": <accountName>\n      },\n      {\n        \"id\": \"email\",\n        \"type\": \"text\",\n        \"label\": \"Email\",\n        \"value\": <email>\n      },\n{\n        \"id\": \"firstName\",\n        \"type\": \"text\",\n        \"label\": \"First Name\",\n        \"value\": <firstName>\n      },\n{\n        \"id\": \"lastName\",\n        \"type\": \"text\",\n        \"label\": \"Last Name\",\n        \"value\": <lastName>\n      }\n    \n    ]\n  }\n}"
            }
          ],
          "type": "LLM"
        },
