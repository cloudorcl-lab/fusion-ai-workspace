            "name": "SetOutputMode",
            "returnType": "string",
            "sourceCode": "const input = $context?.$app?.$OraAppContext;\n\nlet obj = {};\nif (typeof input === \"string\" && input.trim() !== \"\") {\n  try {\n    obj = JSON.parse(input);\n  } catch (e) {\n    obj = {};\n  }\n}\n\nconst mode = obj.mode ?? \"ui\";\nreturn mode;"
          },
          "outcomes": {
