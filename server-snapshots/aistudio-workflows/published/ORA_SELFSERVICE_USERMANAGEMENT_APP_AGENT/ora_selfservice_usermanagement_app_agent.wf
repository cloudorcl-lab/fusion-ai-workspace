        {
          "metadata": {
            "name": "Code Is Form Submit",
            "returnType": "object",
            "sourceCode": "const input = $context.$app.$OraAction;\nconst match = input.match(/<oraFormSubmit\\s+id=[\"']([^\"']*)[\"'][^>]*>(.*?)<\\/oraFormSubmit>/s);\nlet isForm = false;\nlet formId=\"\";\nlet type =\"\";\nlet payload;\nlet additionalData;\nif (match) {\n  formId = match[1];      \n  payload = match[2];\n  isForm = true;\n  if(formId.startsWith(\"rejectRequest\")) {\n   \nadditionalData = formId;\n formId = \"pending\";\n    type = \"Reject\"\n    } else if(formId.startsWith(\"approveRequest\") ){\n   \nadditionalData = formId;\n formId = \"pending\";\n    type = \"Approve\";\n    } else if(formId.startsWith(\"updateRole\")){\n        additionalData = formId;\n        formId = \"updateRoles\";\n    }\n}\nreturn {isForm, formId, payload, type, additionalData};"
          },
          "outcomes": {
            "success": "1771583862198"
          },
          "code": "CODE_IS_FORM_SUBMIT",
          "id": "1771578632027",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
