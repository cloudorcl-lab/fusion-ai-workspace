          "metadata": {
            "name": "EvaluateUserDetails",
            "returnType": "object",
            "sourceCode": "let roles = $context.$nodes.GETMYROLES.$output.items || [];\nlet isDelegatedAdmin = false;\nlet contactPartyId;\nisDelegatedAdmin = roles.some(item => item.RelationshipTypeCd === \"ORA_CSS_ACC_ADMIN\");\ncontactPartyId = roles?.[0]?.ContactPartyId;\nif(roles.length ==0){\nisDelegatedAdmin=true;\n}\nreturn {isDelegatedAdmin, contactPartyId};"
          },
          "outcomes": {
            "success": "1771494466120"
          },
          "code": "EVALUATEUSERDETAILS",
          "id": "1773753387907",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
