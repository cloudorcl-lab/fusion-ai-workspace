        {
          "metadata": {
            "name": "Risk Score Code",
            "returnType": "object",
            "sourceCode": "let riskScore = 30;\nconst riskReasons = [];\nlet email = $context.$nodes.GET_REGISTRATION_DETAILS_IA.$output.EmailAddress;\nlet emailArray = email.split('@');\nlet domain = emailArray[1];\nlet genericDomains = [\"gmail.com\", \"outlook.com\", \"yahoo.com\", \"icloud.com\", \"hotmail.com\"];\nlet isGenericEmail = false;\nif(genericDomains.includes(domain)){\n  isGenericEmail = true;\n  riskScore -= 10;\n  riskReasons.push(\"Requester's email id is generic, needs review.\");\n}\n\nlet domainCount = $context.$nodes.SEARCH_REGISTRATION_REQUESTS.$output.count;\nif(domainCount == 0){\n  riskScore -= 10;\n  riskReasons.push(\"No other user registered so far with this email domain name.\");\n}\nlet isEmailExist = $context.$nodes.PROCESSGETUSERS.$output.result.isFound;\nif(!isEmailExist){\n  riskScore -= 10;\n  riskReasons.push(\"This user is not part of any other accounts.\");\n}\n\nreturn {riskScore, riskReasons};"
          },
          "outcomes": {
            "success": "1773400131108"
          },
          "code": "RISK_SCORE_CODE",
          "id": "1773124784397",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
