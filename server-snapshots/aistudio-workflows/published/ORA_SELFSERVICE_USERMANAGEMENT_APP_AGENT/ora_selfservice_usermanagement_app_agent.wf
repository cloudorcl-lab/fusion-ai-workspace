            "returnType": "object",
            "sourceCode": "let data = $context.$nodes.GETUSERIDBO.$output; \nlet isFound = false;\nlet userId;\nlet accountPartyId;\nlet actionId;\n// Check if items array is not empty and has at least one element\nif (data.items && data.items.length > 0) {\n    userId = data.items[0].UserId;\n    accountPartyId=data.items[0].AccountPartyId;\n    actionId=userId+\",\"+accountPartyId;\n}\n\n// Return the Relationship array (or empty array if not found)\nreturn {userId, accountPartyId,actionId};"
          },
