          "metadata": {
            "name": "Approve and Reject Submission",
            "returnType": "object",
            "sourceCode": "let submissionInfo = $context.$nodes.CODE_IS_FORM_SUBMIT.$output.result;\n\nlet  submitAction= submissionInfo.type;\n\nlet payload = submissionInfo.payload;\n\nlet  regId=\"\";\n\nlet comment=\"\";\n\nlet submitOperation=\"\";\n\n\nlet jsonObject = JSON.parse(payload);\n\njsonObject.forEach(item => {\n \n if(item.id === \"comment\"){\n      comment = item.value;\n} \n});\n\nif(submitAction === \"Reject\"){\nsubmitOperation = \"ORA_CSS_REJECTED\";\n} \n else if(submitAction === \"Approve\"){\nsubmitOperation = \"ORA_CSS_APPROVED\";\n}\n\nlet additionalData = $context.$nodes.CODE_IS_FORM_SUBMIT.$output.result.additionalData;\nlet tempArray = additionalData.split(\"~\");\nregId = tempArray[1];\n\n\nreturn {submitOperation,regId,comment,additionalData};"
          },
