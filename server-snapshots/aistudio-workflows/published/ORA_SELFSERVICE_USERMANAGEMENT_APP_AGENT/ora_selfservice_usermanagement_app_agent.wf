            "name": "CREATE_PAYLOAD",
            "returnType": "object",
            "sourceCode": "let submissionInfo = $context.$nodes.CODE_IS_FORM_SUBMIT.$output.result;\n\nlet payloadStr = submissionInfo.payload;\nlet payload = JSON.parse(payloadStr);\nlet account=\"\";\nlet firstName =\"\";\nlet lastName =\"\" ;\nlet email =\"\";\npayload.forEach(item => {\n    if(item.id === \"account\"){\n      account = item.value;\n    } else if(item.id === \"firstName\"){\n      firstName = item.value;\n    } else if(item.id === \"lastName\"){\n      lastName = item.value;\n    } else if(item.id === \"email\"){\n      email = item.value;\n    }\n});\n\nreturn {account,firstName,lastName,email};"
          },
