          "code": "IDENTIFY_RELEVANT_BUSINESS_DRIVERS",
          "id": "1783709001001",
          "inputs": [
            {
              "id": "1783709001001_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a business-driver selector for a generic data-planning workflow.\n\nObjective\nSelect only the business driver keys that are relevant to the current user question before the main data planner runs.\n\nInputs\n- Original/current user question: `{{$context.$system.$inputMessage}}`\n- Context-aware rewritten user message, when supplied by the parent workflow: `{{$context.$triggers.REST.$input.rewrittenUserMessage}}`\n- Compact selected business intent and candidate shape cards JSON: `{{$context.$nodes.COMPACT_DATA_PLANNER_INPUT.$output.result}}`\n- Named entity references: `{{$context.$triggers.REST.$input.resolvedEntities}}`\n\nRules\n- Use only the compact planner input. Do not invent shapes, fields, filters, lookup codes, business drivers, or intent keys.\n- Work generically for any business intent and shape. Do not hardcode PPR, status, payment, supplier, invoice, or any one use case.\n- A business driver is relevant when its key, name, description, when, filters, extraFilterExpressions, notes, fieldsToReturn, or intentSliceKey directly helps plan the user request.\n- Evaluate both the original/current user question and the context-aware rewritten user message. The rewritten message may add context from history, but the original/current user question remains authoritative for exact filter words that may have been dropped or paraphrased by rewriting.\n- Prefer the most specific matching driver over a generic fallback driver when both are relevant. A driver is more specific when its key/name/when/description/filters/notes match a concrete status, lifecycle stage, error state, business category, exception type, metric, or output slice from the request. A generic driver is one that matches only a broad pattern such as \"by status\", \"by date\", \"details\", \"summary\", or a catch-all listing pattern.\n- If one specific driver covers the user request and a generic driver also covers it, select the specific driver only. Include the generic driver only when it contributes required fields/instructions not present in the specific driver or when the specific driver explicitly depends on the generic driver.\n- If multiple specific drivers match the same request, select the one with the closest exact value/category match. If they are equally close and conflicting, return an empty array for that shape instead of guessing.\n- If the user provides an exact filter value and a shape filter exposes displayedFieldLookupCodes, use those lookup codes as capability evidence for selecting the related business driver. Do not validate final query syntax here.\n- Prefer the smallest useful set of drivers. Usually select 1 to 3 keys per shape.\n- If no business driver is relevant for a shape, return an empty array for that shape key.\n- Do not select a driver only because it is generally useful; it must be relevant to this turn.\n- Do not answer the user and do not create a data plan.\n\nOutput strictly one valid JSON object with exactly this schema and no extra text:\n{\n  \"relevantBusinessDriverKeysByShape\": {\n    \"<shapeKey>\": [\"<driverKey>\"]\n  },\n  \"reason\": \"short explanation of the selected driver keys\"\n}"
            },
            {
              "id": "1783709001001_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "You identify only relevant business driver keys from compact shape metadata."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"relevantBusinessDriverKeysByShape\": {\n      \"type\": \"object\",\n      \"additionalProperties\": {\n        \"type\": \"array\",\n        \"items\": {\n          \"type\": \"string\"\n        }\n      }\n    },\n    \"reason\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"relevantBusinessDriverKeysByShape\",\n    \"reason\"\n  ],\n  \"additionalProperties\": false\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Prune Compact Data Planner Input",
            "returnType": "object",
            "sourceCode": "function parseMaybeJson(value) {\n  if (value == null) return null;\n  if (typeof value === \"object\") return value;\n  if (typeof value === \"string\") {\n    var text = value.trim();\n    if (!text) return null;\n    try {\n      return JSON.parse(text);\n    } catch (e) {\n      var fenced = text.match(/^```(?:json)?\\s*([\\s\\S]*?)\\s*```$/i);\n      if (fenced && fenced[1]) {\n        try { return JSON.parse(fenced[1].trim()); } catch (ignored) {}\n      }\n      return value;\n    }\n  }\n  return value;\n}\n\nfunction asObject(value) {\n  value = parseMaybeJson(value);\n  return value && typeof value === \"object\" && !Array.isArray(value) ? value : {};\n}\n\nfunction asArray(value) {\n  value = parseMaybeJson(value);\n  if (value == null) return [];\n  return Array.isArray(value) ? value : [value];\n}\n\nfunction cloneValue(value) {\n  value = parseMaybeJson(value);\n  if (value == null) return value;\n  return JSON.parse(JSON.stringify(value));\n}\n\nfunction getNodeResult(nodeCode) {\n  var nodes = ($context && $context.$nodes) || {};\n  var node = nodes[nodeCode] || {};\n  var output = node.$output || node.output || {};\n  if (output && output.result !== undefined) return parseMaybeJson(output.result);\n  return parseMaybeJson(output);\n}\n\nfunction keySet(keys) {\n  var out = {};\n  asArray(keys).forEach(function (key) {\n    key = key == null ? \"\" : String(key).trim();\n    if (key) out[key] = true;\n  });\n  return out;\n}\n\nvar compactPlannerInput = cloneValue(getNodeResult(\"COMPACT_DATA_PLANNER_INPUT\")) || {};\nvar selection = asObject(getNodeResult(\"IDENTIFY_RELEVANT_BUSINESS_DRIVERS\"));\nvar selectedByShape = asObject(selection.relevantBusinessDriverKeysByShape);\n\ncompactPlannerInput.shapes = asArray(compactPlannerInput.shapes).map(function (shape) {\n  shape = cloneValue(shape) || {};\n  var shapeKey = shape.key || shape.name || null;\n  var selectedKeys = keySet(selectedByShape[shapeKey]);\n  var selectedCount = Object.keys(selectedKeys).length;\n  var originalDrivers = asArray(shape.businessDrivers);\n  var keptDrivers = selectedCount\n    ? originalDrivers.filter(function (driver) {\n        driver = asObject(driver);\n        return !!selectedKeys[driver.key || driver.name];\n      })\n    : [];\n\n  shape.businessDriverSelection = {\n    selectedKeys: Object.keys(selectedKeys),\n    originalCount: originalDrivers.length,\n    keptCount: keptDrivers.length,\n    selectionReason: selection.reason || null\n  };\n  shape.businessDrivers = keptDrivers;\n  return shape;\n});\n\ncompactPlannerInput.relevantBusinessDriverKeysByShape = selectedByShape;\ncompactPlannerInput.businessDriverSelectionReason = selection.reason || null;\nvar result = compactPlannerInput;\nreturn result;"
          },
          "outcomes": {
            "success": "1777456053695"
          },
          "diagram": {
