ramOffer.responseDate\"        ]      },      \"sortableAttributes\": [        \"invoiceId\",        \"installmentNumber\",        \"dueDate\",        \"unpaidAmount\",        \"installmentAmount\",        \"paymentPriority\",        \"holdReason\",        \"invoiceTransaction.invoiceNumber\",        \"invoiceTransaction.invoiceCurrency.currencyCode\",        \"invoiceTransaction.paymentCurrency.currencyCode\",        \"invoiceTransaction.businessUnit.name\",        \"invoiceTransaction.businessUnit.id\",        \"invoiceTransaction.paymentTerm.paymentTerm\",        \"invoiceTransaction.paymentTerm.termId\",        \"invoiceTransaction.legalEntity.legalEntityId\",        \"invoiceTransaction.legalEntity.legalEntityName\",        \"invoiceTransaction.invoiceTypeCode.lookupCode\",        \"invoiceTransaction<Invoice>.supplier.supplierId\",        \"invoiceTransaction<Invoice>.supplier.name\",        \"invoiceTransaction<Invoice>.supplierSite.name\",        \"invoiceTransaction.paymentStatusCode.lookupCode\",        \"invoiceTransaction.paymentStatusCode.meaning\",        \"invoiceTransaction.validationStatus.lookupCode\",        \"invoiceTransaction.validationStatus.meaning\",        \"invoiceTransaction.approvalStatus.lookupCode\",        \"invoiceTransaction.approvalStatus.meaning\",        \"invoiceTransaction.fundsStatus.lookupCode\",        \"invoiceTransaction.fundsStatus.meaning\",        \"paymentProcessRequest.checkrunId\",        \"paymentProcessRequest.checkrunName\",        \"paymentMethod.code\",        \"paymentMethod.paymentMethodName\",        \"paymentMethod.paymentMode.lookupCode\",        \"paymentMethod.paymentMode.meaning\",        \"externalBankAccount.maskedAccountNumber\",        \"financeProgramOffer.responseDate\"      ],      \"filterConditions\": [        {          \"name\": \"invoiceId\",          \"attribute\": \"invoiceId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user identifies the invoice by internal invoice id.\"        },        {          \"name\": \"invoiceTransaction.invoiceNumber\",          \"attribute\": \"invoiceTransaction.invoiceNumber\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about the pending installments for a specific invoice number.\"        },        {          \"name\": \"installmentNumber\",          \"attribute\": \"installmentNumber\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user drills into a specific installment on an invoice.\"        },        {          \"name\": \"dueDate\",          \"attribute\": \"dueDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use for pending, overdue, due-soon, or next-week installment schedule questions.\"        },        {          \"name\": \"onHoldFlag\",          \"attribute\": \"onHoldFlag\",          \"type\": \"boolean\",          \"possibleValues\": [],          \"usage\": \"Use when the user wants installments on hold or wants hold-related drill-down.\"        },        {          \"name\": \"holdReason\",          \"attribute\": \"holdReason\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for installments blocked by a specific hold reason.\"        },        {          \"name\": \"remitToSupplierName\",          \"attribute\": \"remitToSupplierName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters installment schedules by supplier or remit-to supplier name.\"        },        {          \"name\": \"firstDiscountDate\",          \"attribute\": \"firstDiscountDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for installments eligible for first discount within a date window.\"        },        {          \"name\": \"discountAmountRemaining\",          \"attribute\": \"discountAmountRemaining\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user wants installments with remaining discount value.\"        },        {          \"name\": \"paymentPriority\",          \"attribute\": \"paymentPriority\",          \"type\": \"int32\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for high-priority installments.\"        },        {          \"name\": \"invoiceTransaction.invoiceCurrency.currencyCode\",          \"attribute\": \"invoiceTransaction.invoiceCurrency.currencyCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by invoice currency or compares invoice currency to payment currency.\"        },        {          \"name\": \"invoiceTransaction.invoiceTypeCode.lookupCode\",          \"attribute\": \"invoiceTransaction.invoiceTypeCode.lookupCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"STANDARD\"          ],          \"usage\": \"Use STANDARD for the default standalone installment drilldown so credit memos and other non-standard invoice types are excluded.\"        },        {          \"name\": \"invoiceTransaction.paymentCurrency.currencyCode\",          \"attribute\": \"invoiceTransaction.paymentCurrency.currencyCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment currency or looks for currency mismatches before selection.\"        },        {          \"name\": \"invoiceToPaymentConversionRate\",          \"attribute\": \"invoiceToPaymentConversionRate\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user wants the invoice-to-payment conversion context for an installment.\"        },        {          \"name\": \"invoiceTransaction.businessUnit.name\",          \"attribute\": \"invoiceTransaction.businessUnit.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes installment schedules to one business unit.\"        },        {          \"name\": \"invoiceTransaction.businessUnit.id\",          \"attribute\": \"invoiceTransaction.businessUnit.id\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the business unit is resolved to an internal id.\"        },        {          \"name\": \"invoiceTransaction.legalEntity.legalEntityId\",          \"attribute\": \"invoiceTransaction.legalEntity.legalEntityId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes installment schedules to one legal entity.\"        },        {          \"name\": \"paymentProcessRequest.checkrunId\",          \"attribute\": \"paymentProcessRequest.checkrunId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks which installment schedules are already tied to a specific payment process request id.\"        },        {          \"name\": \"paymentProcessRequest.checkrunName\",          \"attribute\": \"paymentProcessRequest.checkrunName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks which installment schedules are already tied to a specific payment process request name.\"        },        {          \"name\": \"paymentMethod.code\",          \"attribute\": \"paymentMethod.code\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about installment schedules for a payment method.\"        },        {          \"name\": \"paymentMethod.paymentMethodName\",          \"attribute\": \"paymentMethod.paymentMethodName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about installment schedules by the readable payment method name.\"        },        {          \"name\": \"paymentMethod.paymentMode.lookupCode\",          \"attribute\": \"paymentMethod.paymentMode.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user distinguishes installment schedules by payment mode.\"        },        {          \"name\": \"invoiceTransaction.paymentTerm.termId\",          \"attribute\": \"invoiceTransaction.paymentTerm.termId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters installment schedules by payment term.\"        },        {          \"name\": \"invoiceTransaction<Invoice>.supplier.supplierId\",          \"attribute\": \"invoiceTransaction<Invoice>.supplier.supplierId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the supplier is resolved to an internal supplier id.\"        },        {          \"name\": \"invoiceTransaction<Invoice>.supplier.name\",          \"attribute\": \"invoiceTransaction<Invoice>.supplier.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for installment schedules for one supplier.\"        },        {          \"name\": \"invoiceTransaction<Invoice>.supplierSite.name\",          \"attribute\": \"invoiceTransaction<Invoice>.supplierSite.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes the schedule to a specific supplier site.\"        },        {          \"name\": \"unpaidAmount\",          \"attribute\": \"unpaidAmount\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for installment schedules above an unpaid-amount threshold.\"        },        {          \"name\": \"invoiceTransaction<Invoice>.supplier.supplierType.lookupCode\",          \"attribute\": \"invoiceTransaction<Invoice>.supplier.supplierType.lookupCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"ATTORNEY\",            \"CONTRACTOR\",            \"FEDERAL\",            \"GOVERNMENT\",            \"INSURANCE\",            \"Internal\",            \"MANUFACTURING\",            \"PCF_Supplier_Type1\",            \"PCF_Supplier_Type2\",            \"PCF_Supplier_Type3\",            \"PCF_Supplier_Type4\",            \"PCF_Supplier_Type5\",            \"POZ TEST SUPPLIER TYPE\",            \"PUBLIC SECTOR COMPANIES\",            \"SERVICES\",            \"SUB-CONTRACTOR\",            \"SUPPLIER\",            \"TAX AUTHORITY\",            \"TRANSPORTADOR\",            \"TRUST\",            \"UTILITY\"          ],          \"usage\": \"Use when the user asks for installment schedules scoped to a seeded supplier type.\"        },        {          \"name\": \"invoiceTransaction.validationStatus.lookupCode\",          \"attribute\": \"invoiceTransaction.validationStatus.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters installment schedules by invoice validation status.\"        },        {          \"name\": \"invoiceTransaction.approvalStatus.lookupCode\",          \"attribute\": \"invoiceTransaction.approvalStatus.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters installment schedules by invoice approval status.\"        }      ],      \"dateFilterGuidance\": {        \"description\": \"Use dueDate for pending or upcoming installment schedule questions. For discount-window questions, compare the requested horizon against firstDiscountDate, secondDiscountDate, and thirdDiscountDate in the outer query.\",        \"patterns\": [          {            \"userRequest\": \"pending or overdue installments\",            \"clause\": \"apply the date filter to dueDate\"          },          {            \"userRequest\": \"discount available within the next <N> days\",            \"example\": \"within the next 5 days\",            \"clause\": \"check whether firstDiscountDate, secondDiscountDate, or thirdDiscountDate falls within the requested date window\"          }        ]      },      \"extractionQuery\": null,      \"businessDrivers\": [        {          \"name\": \"installmentDrilldownDefault\",          \"description\": \"Retrieve standalone invoice installment drilldown rows for a supplier, business unit, and invoice currency.\",          \"when\": \"User asks for installment drilldown or installment details outside a specific PPR/payment-run selected, rejected, or failed context.\",          \"fieldsToReturn\": [            \"invoiceTransaction.invoiceNumber\",            \"installmentNumber\",            \"invoiceTransaction.paymentTerm.paymentTerm\",            \"externalBankAccount.maskedAccountNumber\",            \"unpaidAmount\",            \"invoiceTransaction.invoiceCurrency.currencyCode\",            \"firstDiscountDate\",            \"paymentMethod.paymentMethodName\",            \"firstDiscountAmount\",            \"dueDate\"          ],          \"extraFilterExpressions\": [            \"invoiceTransaction.businessUnit.id=<BUSINESS_UNIT_ID> or invoiceTransaction.businessUnit.name='<BUSINESS_UNIT_NAME>'\",            \"invoiceTransaction.invoiceCurrency.currencyCode='<INVOICE_CURRENCY_CODE>'\",            \"invoiceTransaction<Invoice>.supplier.supplierId=<SUPPLIER_ID> or invoiceTransaction<Invoice>.supplier.name='<SUPPLIER_NAME>'\",            \"invoiceTransaction.legalEntity.legalEntityId=<LEGAL_ENTITY_ID> when legal entity is provided\",            \"invoiceTransaction.paymentTerm.termId=<PAYMENT_TERM_ID> when payment terms are provided\",            \"invoiceTransaction.invoiceTypeCode.lookupCode='STANDARD'\"          ],          \"sortBy\": [            {              \"attribute\": \"unpaidAmount\",              \"direction\": \"desc\"            }          ],          \"notes\": \"Currency is sourced from invoiceTransaction.invoiceCurrency.currencyCode. For runtime execution, prefer payablesPaymentScheduleDetailExtraction because it contains the static-discount computation and ORDER BY unpaidAmount DESC before ROWNUM<=20.\"        },        {          \"name\": \"pendingInstallmentsByInvoice\",          \"description\": \"Retrieve the pending or upcoming installment schedule for one invoice.\",          \"when\": \"User asks what installments remain for an invoice and when they are due.\",          \"fieldsToReturn\": [            \"invoiceTransaction.invoiceNumber\",            \"installmentNumber\",            \"dueDate\",            \"unpaidAmount\",            \"installmentAmount\",            \"onHoldFlag\",            \"holdReason\"          ],          \"extraFilterExpressions\": [            \"invoiceTransaction.invoiceNumber='<INVOICE_NUMBER_FROM_USER>'\"          ],          \"notes\": \"Add invoiceId when the user provides the internal invoice identifier instead of the invoice number.\"        },        {          \"name\": \"discountEligibleSoon\",          \"description\": \"Find installment schedules with available early-payment discounts inside a requested horizon.\",          \"when\": \"User asks for installments with discounts available within the next few days and wants the savings amount.\",          \"fieldsToReturn\": [            \"invoiceTransaction.invoiceNumber\",            \"installmentNumber\",            \"dueDate\",            \"firstDiscountDate\",            \"firstDiscountAmount\",            \"secondDiscountDate\",            \"secondDiscountAmount\",            \"thirdDiscountDate\",            \"thirdDiscountAmount\",            \"discountAmountRemaining\",            \"remitToSupplierName\"          ],          \"extraFilterExpressions\": [            \"one of firstDiscountDate, secondDiscountDate, or thirdDiscountDate falls within the requested date window\",            \"discountAmountRemaining>0\"          ],          \"notes\": \"Calculate the total savings by summing the discount amount associated with the discount date that matches the requested window. When `discountAPR` is null, apply the seeded static-discount logic driven by `invoiceTransaction<Invoice>.supplierSite.alwaysTakeDiscount` and `invoiceTransaction<Invoice>.supplierSite.payDateBasisCode`.\"        },        {          \"name\": \"installmentsOnHoldOrBlocked\",          \"description\": \"Review installment schedules blocked by holds or invoice status conditions.\",          \"when\": \"User asks which installments are on hold, blocked, or otherwise not ready for payment scheduling.\",          \"fieldsToReturn\": [            \"invoiceTransaction.invoiceNumber\",            \"installmentNumber\",            \"dueDate\",            \"onHoldFlag\",            \"holdDate\",            \"holdReason\",            \"invoiceTransaction.validationStatus.meaning\",            \"invoiceTransaction.approvalStatus.meaning\",            \"invoiceTransaction.fundsStatus.meaning\"          ],          \"extraFilterExpressions\": [            \"onHoldFlag = 'Y' or holdReason!=null\",            \"onHoldFlag=true or holdReason!=null\"          ],          \"notes\": \"Use the status lookups to explain whether the block is a hold, validation condition, approval state, or funds state.\"        },        {          \"name\": \"installmentScheduleBySupplier\",          \"description\": \"Retrieve the installment schedule for a supplier or remit-to supplier before payment-run selection.\",          \"when\": \"User asks for the pending installments for one supplier and their due dates.\",          \"fieldsToReturn\": [            \"remitToSupplierName\",            \"invoiceTransaction.invoiceNumber\",            \"installmentNumber\",            \"dueDate\",            \"unpaidAmount\",            \"paymentMethod.paymentMethodName\",            \"paymentMethod.paymentMode.meaning\"          ],          \"extraFilterExpressions\": [            \"remitToSupplierName='<SUPPLIER_NAME_FROM_USER>'\"          ],          \"notes\": \"This is the pre-selection or schedule-detail view. Switch to selectedPaymentInstallments or paymentRunInstallments once the question is about a specific PPR.\"        },        {          \"name\": \"invoicesReadyForPayment\",          \"description\": \"Retrieve the invoices reay for payment.\",          \"when\": \"User asks to Show me all invoices ready for payment\",          \"fieldsToReturn\": [            \"remitToSupplierName\",            \"invoiceTransaction.invoiceNumber\",            \"installmentNumber\",            \"dueDate\",            \"unpaidAmount\",            \"paymentMethod.paymentMethodName\",            \"paymentMethod.paymentMode.meaning\"          ],          \"extraFilterExpressions\": [            \"invoiceTransaction.paymentStatusCode.lookupCode in ('N', 'P') and  onHoldFlag = false\"          ],          \"notes\": \" 'N' denotes Not paid & 'P' denotes Partially paid \"        }      ],      \"additionalInstructions\": [        \"Use this shape for invoice-installment schedule detail before selection or when the question is independent of a specific payment run.\",        \"For standalone installment drilldown, require business unit, invoice currency, and supplier; display Currency from invoiceTransaction.invoiceCurrency.currencyCode.\",        \"For standalone installment drilldown, apply invoiceTransaction.invoiceTypeCode.lookupCode='STANDARD' by default.\",        \"For standalone installment drilldown, sort by unpaidAmount descending and prefer payablesPaymentScheduleDetailExtraction for runtime execution because it contains the capped ordered extraction pattern.\",        \"Use selectedPaymentInstallments or paymentRunInstallments when the user asks for the actual payment amount in a PPR, the formed payment, or the resulting payment file.\",        \"For discount-window questions, evaluate firstDiscountDate, secondDiscountDate, and thirdDiscountDate against the requested horizon and use the matching discount amount column for the savings calculation.\",        \"discountAmountRemaining is the best native indicator of discount value still available on the installment.\",        \"remitToSupplierName is the best user-facing supplier label exposed directly by this view.\",        \"When the source shape requires supplier, supplier-site, or remit-to detail under `invoiceTransaction`, use subtype-expanded paths with the discriminator marker `<Invoice>` such as `invoiceTransaction<Invoice>.supplier.name` instead of `<PayablesInvoice>`.\",        \"For static-discount reasoning when `discountAPR` is null, use `invoiceTransaction<Invoice>.supplierSite.alwaysTakeDiscount`, `invoiceTransaction<Invoice>.supplierSite.payDateBasisCode`, and the matching first, second, or third discount date and amount from the seeded source definition.\",        \"This shape does not expose first-time-supplier indicators or bank-account-validation-complete flags. Those scenarios need additional supplier or payment-instrument sources.\"      ]    },    \"bankRejectedInstallmentsOnHold\": {      \"key\": \"bankRejectedInstallmentsOnHold\",      \"name\": \"bankRejectedInstallmentsOnHold\",      \"type\": \"EXTRACTION\",      \"module\": \"oraErpCorePaymentsFundsDisbursement\",      \"businessObject\": \"PayablesDocumentPayable\",      \"description\": \"Runtime extraction for installment-level impact analysis when bank acknowledgment rejections leave installments on hold. Use this shape for Payment Execution Inquiry questions that need bank rejection code and reason, days on hold, payment file creation/status, payment system, disbursement bank account, payment status/amount, supplier, supplier site, invoice, and installment detail in one table.\",      \"exampleQuestions\": [        \"Show installments on hold due to bank acknowledgment rejections\",        \"Which installments are on hold because the bank rejected the payment file last week?\",        \"List bank rejected payment-file installments by rejection code with payment and supplier detail\",        \"Show bank rejected payments between 2026-01-01 and 2026-01-31 and the installments they put on hold\"      ],      \"fields\": {        \"fields\": [          \"bankRejectionCode\",          \"bankRejectionReason\",          \"daysOnHold\",          \"paymentFileReference\",          \"fileCreationDate\",          \"fileStatus\",          \"paymentSystem\",          \"disbursementBankAccount\",          \"paymentNumber\",          \"paymentStatus\",          \"paymentAmount\",          \"supplierOrParty\",          \"supplierSite\",          \"invoiceNumber\",          \"installmentNumber\",          \"installmentDueDate\",          \"installmentAmount\"        ],        \"fieldAlias\": {          \"Bank Rejection Code\": \"bankRejectionCode\",          \"Bank Rejection Reason\": \"bankRejectionReason\",          \"Days on hold\": \"daysOnHold\",          \"Payment File reference\": \"paymentFileReference\",          \"File Creation Date\": \"fileCreationDate\",          \"File Status\": \"fileStatus\",          \"Payment System\": \"paymentSystem\",          \"Disbursement Bank Account\": \"disbursementBankAccount\",          \"Payment Number\": \"paymentNumber\",          \"Payment Status\": \"paymentStatus\",          \"Payment Amount\": \"paymentAmount\",          \"Supplier or Party\": \"supplierOrParty\",          \"Supplier Site\": \"supplierSite\",          \"Invoice Number\": \"invoiceNumber\",          \"Installment Number\": \"installmentNumber\",          \"Installment Due Date\": \"installmentDueDate\",          \"Installment Amount\": \"installmentAmount\"        }      },      \"supportedFilters\": [        {          \"name\": \"fileCreationDate\",          \"attribute\": \"timeCreated\",          \"type\": \"dateTime\",          \"possibleValues\": [],          \"usage\": \"Required for this inquiry. Apply the user's Start Date and End Date to the payment file timeCreated attribute from the disbursementPaymentInstructions view using resolved ISO date-time bounds.\",          \"valueFromUser\": \"Start Date and End Date\"        },        {          \"name\": \"paymentStatus.lookupCode\",          \"attribute\": \"payablesDisbursementPayment.paymentStatus.lookupCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"REJECTED\",            \"RETURNED\",            \"VOID_BY_OVERFLOW\",            \"VOIDED\"          ],          \"usage\": \"Use the relevant bank-rejected payment-status bucket. Prefer REJECTED and RETURNED when the user says bank rejected; include voided statuses only when the business status data uses voiding to represent returned bank payments.\",          \"valueFromUser\": \"Relevant bank rejected statuses\"        },        {          \"name\": \"paymentFileProcessingStatus.lookupCode\",          \"attribute\": \"payablesDisbursementPayment.payablesPaymentFile.paymentFileProcessingStatus.lookupCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"REJECTED\",            \"PARTIALLY_ACKNOWLEDGED\",            \"PENDING_ACTION_ACK_FAILURE\",            \"TRANSMISSION_FAILED\"          ],          \"usage\": \"Use when the rejection is surfaced at payment-file or bank-acknowledgement level.\",          \"valueFromUser\": \"Payment File Status\"        },        {          \"name\": \"bankRejectionCode\",          \"attribute\": \"payablesDisbursementPayment.bepErrorCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by a specific bank rejection or BEP error code.\",          \"valueFromUser\": \"Bank Rejection Code\"        },        {          \"name\": \"paymentFileReference\",          \"attribute\": \"payablesDisbursementPayment.payablesPaymentFile.paymentInstructionId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user identifies a specific payment file reference.\",          \"valueFromUser\": \"Payment File reference\"        }      ],      \"dateFilterGuidance\": {        \"description\": \"For this inquiry, apply the user's Start Date and End Date to fileCreationDate, which comes from disbursementPaymentInstructions.timeCreated. Resolve relative dates before query generation and emit Oracle DATE literals in YYYY-MM-DD form.\",        \"patterns\": [          {            \"userRequest\": \"between Start Date and End Date\",            \"clause\": \"fileCreationDate >= DATE '<START_DATE_ISO>' and fileCreationDate < DATE '<END_DATE_PLUS_ONE_DAY_ISO>'\"          }        ]      },      \"extractionQuery\": {        \"viewQueries\": {          \"paymentRunInstallments\": {            \"module\": \"oraErpCorePaymentsFundsDisbursement\",            \"businessObject\": \"PayablesDocumentPayable\",            \"view\": \"paymentRunInstallments\",            \"fieldAliases\": {              \"payablesDisbursementPayment.bepErrorCode\": \"bankRejectionCode\",              \"payablesDisbursementPayment.bepErrorMessageText\": \"bankRejectionReason\",              \"payablesDisbursementPayment.payablesPaymentFile.paymentInstructionId\": \"paymentFileReference\",              \"payablesDisbursementPayment.payablesPaymentFile.paymentFileProcessingStatus.meaning\": \"fileStatus\",              \"bankAccount.name\": \"disbursementBankAccount\",              \"payablesDisbursementPayment.payablesPayment.paymentNumber\": \"paymentNumber\",              \"payablesDisbursementPayment.paymentStatus.meaning\": \"paymentStatus\",              \"payablesDisbursementPayment.paymentStatus.lookupCode\": \"paymentStatusCode\",              \"payablesDisbursementPayment.paymentAmount\": \"paymentAmount\",              \"payeeParty.name\": \"supplierOrParty\",              \"supplierSite.name\": \"supplierSite\",              \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\": \"invoiceNumber\",              \"payablesInvoiceInstallment.installmentNumber\": \"installmentNumber\",              \"payablesInvoiceInstallment.dueDate\": \"installmentDueDate\",              \"payablesInvoiceInstallment.installmentAmount\": \"installmentAmount\"            }          },          \"paymentFiles\": {            \"module\": \"oraErpCorePaymentsFundsDisbursement\",            \"businessObject\": \"PayablesPaymentFile\",            \"view\": \"disbursementPaymentInstructions\",            \"fieldAliases\": {              \"paymentInstructionId\": \"paymentFileReference\",              \"timeCreated\": \"fileCreationDate\",              \"accountPaymentProfile.systemPaymentProfile.paymentSystem.paymentSystemName\": \"paymentSystem\"            }          }        },        \"select\": \"select p.bankRejectionCode, p.bankRejectionReason, TRUNC(SYSDATE) - TRUNC(f.fileCreationDate) as daysOnHold, p.paymentFileReference, f.fileCreationDate, p.fileStatus, f.paymentSystem, p.disbursementBankAccount, p.paymentNumber, p.paymentStatus, p.paymentAmount, p.supplierOrParty, p.supplierSite, p.invoiceNumber, p.installmentNumber, p.installmentDueDate, p.installmentAmount from paymentRunInstallments p join paymentFiles f on p.paymentFileReference = f.paymentFileReference where f.fileCreationDate >= DATE '<START_DATE_ISO>' and f.fileCreationDate < DATE '<END_DATE_PLUS_ONE_DAY_ISO>' and (p.paymentStatusCode in ('REJECTED','RETURNED') or p.fileStatus in ('Rejected','Partially acknowledged','Pending action for acknowledgement failure','Transmission failed')) and (p.bankRejectionCode is not null or p.bankRejectionReason is not null) order by daysOnHold desc, p.bankRejectionCode asc, p.installmentAmount asc, p.paymentAmount desc\"      },      \"businessDrivers\": [        {          \"name\": \"bankRejectedInstallmentsOnHoldByFileCreationDate\",          \"description\": \"Return installment-level rows on hold because of bank-rejected payments or payment files within a payment-file creation date range.\",          \"when\": \"User asks to show installments on hold due to bank acknowledgment rejections, bank rejected payments, rejected payment files, or bank acknowledgments between a Start Date and End Date.\",          \"fieldsToReturn\": [            \"bankRejectionCode\",            \"bankRejectionReason\",            \"daysOnHold\",            \"paymentFileReference\",            \"fileCreationDate\",            \"fileStatus\",            \"paymentSystem\",            \"disbursementBankAccount\",            \"paymentNumber\",            \"paymentStatus\",            \"paymentAmount\",            \"supplierOrParty\",            \"supplierSite\",            \"invoiceNumber\",            \"installmentNumber\",            \"installmentDueDate\",            \"installmentAmount\"          ],          \"extraFilterExpressions\": [            \"fileCreationDate between <START_DATE_FROM_USER> and <END_DATE_FROM_USER>\",            \"payablesDisbursementPayment.paymentStatus.lookupCode in ('REJECTED','RETURNED') or fileStatus in ('Rejected','Partially acknowledged','Pending action for acknowledgement failure','Transmission failed')\",            \"bankRejectionCode is not null or bankRejectionReason is not null\"          ],          \"notes\": \"Sort rows by daysOnHold descending, bankRejectionCode ascending, installmentAmount ascending, and paymentAmount descending. Derive daysOnHold as the elapsed days from fileCreationDate to the database current date unless a hold date is explicitly exposed by a future source.\"        }      ],      \"additionalInstructions\": [        \"Use the provided extractionQuery.select as the query template and replace the Start Date and End Date placeholders with concrete YYYY-MM-DD values inside the DATE literals before execution.\",        \"Use viewQueries.paymentRunInstallments as the FROM source with a stable alias.\",        \"The output must be installment-level: one row per invoice installment affected by the rejected payment or payment file.\",        \"For the analyst table, return exactly the business columns listed in the fields alias map.\",        \"Apply the Start Date and End Date to payment-file creation date, not payment date or installment due date.\",        \"Apply the bank rejected status bucket using the payment status lookup code internally and payment-file status when available. Do not return paymentStatusCode as an output column.\",        \"Compute daysOnHold from fileCreationDate to the as-of date used by the runtime query. If a future source exposes a specific hold start date, prefer that date.\",        \"Order the result by daysOnHold descending, bankRejectionCode ascending, installmentAmount ascending, and paymentAmount descending.\",        \"Always limit the final result set to 20 rows unless the user asks for a different limit.\"      ]    },    \"payablesPaymentProcessRequestTemplateLists\": {      \"key\": \"payablesPaymentProcessRequestTemplateLists\",      \"name\": \"payablesPaymentProcessRequestTemplateLists\",      \"type\": \"BV\",      \"shapeRole\": \"detail\",      \"module\": \"oraErpCorePayablesSetup\",      \"businessObject\": \"PayablesPaymentProcessRequestTemplate\",      \"api\": \"objects/ora/erpCore/payablesSetup/v1/payablesPaymentProcessRequestTemplateLists\",      \"description\": \"Use this BV shape to list payment process request templates and their basic payment-mode and accelerated-invoice setup. Use it when the user asks which PPR templates exist or wants to find templates appropriate for EFT, check, offer-accepted, or accelerated-payment scenarios.\",      \"exampleQuestions\": [        \"What PPR templates are available for EFT payments?\",        \"Show active payment process request templates with dynamic discount enabled.\",        \"Which active templates can be used for accepted supplier offers or accelerated invoices?\",        \"List payment run templates by payment mode.\"      ],      \"fields\": {        \"fields\": [          \"templateId\",          \"templateName\",          \"description\",          \"inactiveDate\",          \"acceleratedInvoicesCode\",          \"type.lookupCode\",          \"type.meaning\",          \"paymentMode.lookupCode\",          \"paymentMode.meaning\",          \"paymentMethod.code\"        ],        \"accessors\": {          \"type\": {            \"shape\": \"Lookup\",            \"fields\": [              \"lookupCode\",              \"lookupType\",              \"meaning\"            ]          },          \"paymentMode\": {            \"shape\": \"Lookup\",            \"fields\": [              \"lookupCode\",              \"lookupType\",              \"meaning\"            ]          },          \"paymentMethod\": {            \"shape\": \"PaymentMethod\",            \"fields\": [              \"code\"            ]          }        },        \"fieldAlias\": {          \"Template Id\": \"templateId\",          \"Template Name\": \"templateName\",          \"Description\": \"description\",          \"Inactive Date\": \"inactiveDate\",          \"Accelerated Invoices Code\": \"acceleratedInvoicesCode\",          \"Template Type Code\": \"type.lookupCode\",          \"Template Type\": \"type.meaning\",          \"Payment Mode Code\": \"paymentMode.lookupCode\",          \"Payment Mode\": \"paymentMode.meaning\",          \"Payment Method Code\": \"paymentMethod.code\"        }      },      \"fieldSelection\": {        \"base\": [          \"templateId\",          \"templateName\",          \"description\",          \"inactiveDate\",          \"type.meaning\",          \"paymentMode.meaning\"        ],        \"optional\": [          \"acceleratedInvoicesCode\",          \"type.lookupCode\",          \"paymentMode.lookupCode\",          \"paymentMethod.code\"        ]      },      \"sortableAttributes\": [        \"templateId\",        \"type.lookupCode\",        \"type.meaning\",        \"paymentMode.lookupCode\",        \"paymentMode.meaning\"      ],      \"filterConditions\": [        {          \"name\": \"templateId\",          \"attribute\": \"templateId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides the template id.\"        },        {          \"name\": \"templateName\",          \"attribute\": \"templateName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user searches for a PPR template by name.\"        },        {          \"name\": \"inactiveDate\",          \"attribute\": \"inactiveDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for active versus inactive templates.\"        },        {          \"name\": \"type.lookupCode\",          \"attribute\": \"type.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters templates by template type.\"        },        {          \"name\": \"paymentMode.lookupCode\",          \"attribute\": \"paymentMode.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for payment mode, check, or other payment-mode-specific templates\"        },        {          \"name\": \"paymentMethod.code\",          \"attribute\": \"paymentMethod.code\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides or asks for the seeded payment method code on a PPR template, such as EFT, check, or another payment-method-specific template.\"        },        {          \"name\": \"acceleratedInvoicesCode\",          \"attribute\": \"acceleratedInvoicesCode\",          \"type\": \"string\",          \"possibleValues\": [            \"ORA_DD_ALL\",            \"ORA_DD_NO\",            \"ORA_DD_ONLY\",            \"ORA_DD_YES\",            \"ORA_EXCLUDE\",            \"ORA_EXCLUSIVE\",            \"ORA_INCLUDE\"          ],          \"usage\": \"Use when the user asks for templates supporting accelerated or early-payment invoice handling.\"        }      ],      \"dateFilterGuidance\": null,      \"extractionQuery\": null,      \"businessDrivers\": [        {          \"name\": \"findTemplatesByPaymentMethod\",          \"description\": \"List templates for a particular payment method such as EFT.\",          \"when\": \"User asks which PPR templates are available for a payment method.\",          \"fieldsToReturn\": [],          \"extraFilterExpressions\": [            \"paymentMethod.lookupCode='<PAYMENT_MODE_CODE>' or paymentMethod.meaning='<PAYMENT_MODE_NAME>'\",            \"paymentMethod.lookupCode='<Payment Method>' or paymentMethod.meaning='<Payment Method>'\",            \"inactiveDate=null \"          ],          \"notes\": \" Sort by templateId \"        },        {          \"name\": \"findActiveTemplates\",          \"description\": \"List templates that are currently usable.\",          \"when\": \"User asks for available or active PPR templates.\",          \"fieldsToReturn\": [],          \"extraFilterExpressions\": [            \"inactiveDate=null or inactiveDate>=<TODAY>\"          ],          \"notes\": \"\"        },        {          \"name\": \"templatesForAcceleratedOffers\",          \"description\": \"Find active templates that are candidates for accelerated-invoice or accepted-offer payment runs.\",          \"when\": \"User asks which template should be used for supplier offers accepted recently, early-payment programs, or accelerated invoices.\",          \"fieldsToReturn\": [            \"templateId\",            \"templateName\",            \"description\",            \"paymentMode.meaning\",            \"acceleratedInvoicesCode\",            \"type.meaning\"          ],          \"extraFilterExpressions\": [            \"inactiveDate=null or inactiveDate>=<TODAY>\",            \"acceleratedInvoicesCode in (<ACCELERATED_POLICY_CODES_FROM_USER_OR_PLANNER>)\"          ],          \"notes\": \"Pair this template discovery with invoiceInstallmentDetails to identify the specific installments or suppliers that still have discount opportunities.\"        }      ],      \"additionalInstructions\": [        \"Use this shape for template discovery only. Do not infer current PPR execution status from template metadata.\",        \"Use `acceleratedInvoicesCode` as the source-controlled indicator for accelerated-invoice behavior and combine it with `paymentMode` when recommending a template.\",        \"For EFT template discovery, prefer payablesPaymentProcessRequestTemplateListExtraction over this BV so the query can use paymentMethodCode = 'EFT' and inactiveDate IS NULL exactly.\"      ]    },    \"creditMemosBySupplierAging\": {      \"key\": \"creditMemosBySupplierAging\",      \"name\": \"creditMemosBySupplierAging\",      \"type\": \"EXTRACTION\",      \"module\": \"oraErpCorePayablesInvoices\",      \"businessObject\": \"PayablesInvoiceInstallment\",      \"description\": \"Use this runtime extraction when the user wants credit memos by supplier with invoice date, credit memo age based on invoice date, invoice amount, unpaid amount, hold/status context, and related payment number, date, and amount details.\",      \"exampleQuestions\": [        \"Show me the credit memos for supplier 'Advanced Network Devices'?\",        \"Show credit memos with Supplier and aging for credit memo dates from 2026-01-01 to 2026-06-10.\",        \"Show credit memos for Supplier with aging.\",        \"Show credit memos for Vision Operations with aging.\",        \"Show credit memos for All Suppliers with aging.\",        \"Show credit memos with aging.\",        \"List unpaid credit memos for supplier ABC by age.\",        \"Which credit memos for this supplier are still unpaid and how old are they?\"      ],      \"fields\": {        \"fields\": [          \"invoiceNumber\",          \"invoiceType\",          \"supplierName\",          \"supplierSiteName\",          \"invoiceDate\",          \"creditMemoAgeDays\",          \"invoiceAmount\",          \"unpaidAmount\",          \"validationStatus\",          \"approvalStatus\",          \"holds\",          \"paymentNumbers\",          \"paymentDates\",          \"paymentAmounts\"        ],        \"fieldAlias\": {          \"Invoice Number\": \"invoiceNumber\",          \"Invoice Type\": \"invoiceType\",          \"Supplier/Party\": \"supplierName\",          \"Supplier Site\": \"supplierSiteName\",          \"Invoice Date\": \"invoiceDate\",          \"Credit Memo Age (Days)\": \"creditMemoAgeDays\",          \"Invoice Amount\": \"invoiceAmount\",          \"Unpaid Amount\": \"unpaidAmount\",          \"Validation Status\": \"validationStatus\",          \"Approval Status\": \"approvalStatus\",          \"Holds\": \"holds\",          \"Payment Number\": \"paymentNumbers\",          \"Payment Date\": \"paymentDates\",          \"Payment Amount\": \"paymentAmounts\"        }      },      \"supportedFilters\": [        {          \"name\": \"supplierName\",          \"attribute\": \"supplierName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a concrete supplier name, such as Advanced Network Devices. If the user says Supplier as a generic placeholder, All, All Suppliers, every supplier, or does not provide a supplier, leave the supplierName filter unrestrictive.\",          \"valueFromUser\": \"Supplier/Party\"        },        {          \"name\": \"invoiceDate\",          \"attribute\": \"invoiceDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for credit memos with invoice dates in a specific date range.\",          \"valueFromUser\": \"Invoice Date or date range\"        },        {          \"name\": \"creditMemoAgeDays\",          \"attribute\": \"creditMemoAgeDays\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for credit memos older than, newer than, or grouped by a number of aging days. The age is computed from invoice date.\",          \"valueFromUser\": \"Credit Memo Age (Days)\"        },        {          \"name\": \"unpaidAmount\",          \"attribute\": \"unpaidAmount\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for unpaid, partially unpaid, or open credit memos.\",          \"valueFromUser\": \"Unpaid Amount\"        }      ],      \"dateFilterGuidance\": {        \"description\": \"Use invoiceDate for credit memo date filtering. Credit Memo Age (Days) is derived from invoice date. When the user provides start and end dates, resolve them to quoted YYYY-MM-DD literals and apply the same inclusive date window to both viewQuery filters before execution. When the user does not mention a date window, resolve the default last-six-month window into quoted YYYY-MM-DD literals using the response as-of date before building the viewQuery filters. The date placeholders in extractionQuery.viewQueries.filter are internal templates only; never return them in the constructed extraction payload. Do not emit SQL date functions such as ADD_MONTHS or SYSDATE in viewQuery filters.\",        \"patterns\": [          {            \"userRequest\": \"no credit memo date range mentioned\",            \"clause\": \"creditMemosForSupplier.filter: invoiceTransaction.invoiceDate >= '<resolved_start_date_YYYY-MM-DD>' and invoiceTransaction.invoiceDate <= '<resolved_end_date_YYYY-MM-DD>'; supplierSitePayments.filter: paymentDate >= '<resolved_start_date_YYYY-MM-DD>' and paymentDate <= '<resolved_end_date_YYYY-MM-DD>'\"          },          {            \"userRequest\": \"credit memos older than <N> days\",            \"clause\": \"filter or compute creditMemoAgeDays from invoiceDate using the resolved as-of date\"          },          {            \"userRequest\": \"credit memos in a specific invoice date range\",            \"clause\": \"creditMemosForSupplier.filter: invoiceTransaction.invoiceDate >= '<start_date_YYYY-MM-DD>' and invoiceTransaction.invoiceDate <= '<end_date_YYYY-MM-DD>'; supplierSitePayments.filter: paymentDate >= '<start_date_YYYY-MM-DD>' and paymentDate <= '<end_date_YYYY-MM-DD>'\"          }        ]      },      \"extractionQuery\": {        \"viewQueries\": {          \"creditMemosForSupplier\": {            \"view\": \"payablesPaymentScheduleDetail\",            \"businessObject\": \"PayablesInvoiceInstallment\",            \"module\": \"oraErpCorePayablesInvoices\",            \"fieldAliases\": {              \"invoiceId\": \"invoiceId\",              \"invoiceTransaction.invoiceNumber\": \"invoiceNumber\",              \"installmentNumber\": \"installmentNumber\",              \"invoiceTransaction.invoiceDate\": \"invoiceDate\",              \"invoiceTransaction.timeCreated\": \"invoiceCreationDate\",              \"invoiceTransaction.invoiceTypeCode.lookupCode\": \"invoiceTypeCode\",              \"invoiceTransaction.invoiceTypeCode.meaning\": \"invoiceType\",              \"invoiceTransaction.paymentStatusCode.lookupCode\": \"paidStatusCode\",              \"invoiceTransaction<Invoice>.supplier.supplierId\": \"supplierId\",              \"invoiceTransaction<Invoice>.supplier.name\": \"supplierName\",              \"invoiceTransaction<Invoice>.supplierSite.id\": \"supplierSiteId\",              \"invoiceTransaction<Invoice>.supplierSite.name\": \"supplierSiteName\",              \"invoiceCurrencyGrossAmount\": \"invoiceAmount\",              \"unpaidAmount\": \"unpaidAmount\",              \"invoiceTransaction.validationStatus.meaning\": \"validationStatus\",              \"invoiceTransaction.approvalStatus.meaning\": \"approvalStatus\",              \"onHoldFlag\": \"onHoldFlag\",              \"holdReason\": \"holdReason\"            },            \"filter\": \"invoiceTransaction.invoiceTypeCode.lookupCode IN ( 'CREDIT' ) and invoiceTransaction.paymentStatusCode.lookupCode IN ( 'N','P' ) and invoiceTransaction.invoiceDate >= '<resolved_start_date_YYYY-MM-DD>' and invoiceTransaction.invoiceDate <= '<resolved_end_date_YYYY-MM-DD>'\"          },          \"supplierSitePayments\": {            \"view\": \"payablesPaymentDetail\",            \"businessObject\": \"PayablesPayment\",            \"module\": \"oraErpCorePayablesPayments\",            \"fieldAliases\": {              \"paymentNumber\": \"paymentNumber\",              \"paymentDate\": \"paymentDate\",              \"paymentAmount\": \"paymentAmount\",              \"supplier.supplierId\": \"supplierId\",              \"supplier.name\": \"supplierName\",              \"supplierSite.id\": \"supplierSiteId\",              \"supplierSite.name\": \"supplierSiteName\",              \"voidDate\": \"voidDate\"            },            \"filter\": \"paymentDate >= '<resolved_start_date_YYYY-MM-DD>' and paymentDate <= '<resolved_end_date_YYYY-MM-DD>'\"          }        },        \"select\": \"SELECT invoiceNumber, invoiceType, supplierName, supplierSiteName, invoiceDate, creditMemoAgeDays, invoiceAmount, unpaidAmount, validationStatus, approvalStatus, holds, paymentNumbers, paymentDates, paymentAmounts FROM (SELECT c.invoiceNumber AS invoiceNumber, c.invoiceType AS invoiceType, c.supplierName AS supplierName, c.supplierSiteName AS supplierSiteName, c.invoiceDate AS invoiceDate, CASE WHEN c.invoiceDate IS NULL THEN NULL ELSE TRUNC(SYSDATE) - TRUNC(c.invoiceDate) END AS creditMemoAgeDays, c.invoiceAmount AS invoiceAmount, c.unpaidAmount AS unpaidAmount, c.validationStatus AS validationStatus, c.approvalStatus AS approvalStatus, CASE WHEN c.onHoldFlag = 'Y' THEN NVL(c.holdReason, 'On hold') ELSE c.holdReason END AS holds, LISTAGG(p.paymentNumber, ', ') WITHIN GROUP (ORDER BY p.paymentDate DESC, p.paymentNumber) AS paymentNumbers, LISTAGG(TO_CHAR(p.paymentDate, 'YYYY-MM-DD'), ', ') WITHIN GROUP (ORDER BY p.paymentDate DESC, p.paymentNumber) AS paymentDates, LISTAGG(TRIM(TO_CHAR(p.paymentAmount)), ', ') WITHIN GROUP (ORDER BY p.paymentDate DESC, p.paymentNumber) AS paymentAmounts FROM creditMemosForSupplier c JOIN (SELECT DISTINCT supplierId, supplierSiteId, paymentNumber, paymentDate, paymentAmount, voidDate FROM supplierSitePayments WHERE paymentNumber IS NOT NULL AND paymentDate IS NOT NULL AND voidDate IS NULL) p ON p.supplierId = c.supplierId AND p.supplierSiteId = c.supplierSiteId AND p.paymentDate > c.invoiceDate GROUP BY c.invoiceNumber, c.invoiceType, c.supplierName, c.supplierSiteName, c.invoiceDate, c.invoiceCreationDate, c.invoiceAmount, c.unpaidAmount, c.onHoldFlag, c.holdReason, c.validationStatus, c.approvalStatus ORDER BY creditMemoAgeDays DESC, c.unpaidAmount ASC, MAX(p.paymentDate) DESC) WHERE ROWNUM<=20\",        \"return\": [          {            \"name\": \"invoiceNumber\",            \"type\": \"string\"          },          {            \"name\": \"invoiceType\",            \"type\": \"string\"          },          {            \"name\": \"supplierName\",            \"type\": \"string\"          },          {            \"name\": \"supplierSiteName\",            \"type\": \"string\"          },          {            \"name\": \"invoiceDate\",            \"type\": \"date\"          },          {            \"name\": \"creditMemoAgeDays\",            \"type\": \"int64\"          },          {            \"name\": \"invoiceAmount\",            \"type\": \"string\"          },          {            \"name\": \"unpaidAmount\",            \"type\": \"string\"          },          {            \"name\": \"validationStatus\",            \"type\": \"string\"          },          {            \"name\": \"approvalStatus\",            \"type\": \"string\"          },          {            \"name\": \"holds\",            \"type\": \"string\"          },          {            \"name\": \"paymentNumbers\",            \"type\": \"string\"          },          {            \"name\": \"paymentDates\",            \"type\": \"string\"          },          {            \"name\": \"paymentAmounts\",            \"type\": \"string\"          }        ]      },      \"businessDrivers\": [        {          \"name\": \"Credit Memo Aging By Supplier\",          \"description\": \"Retrieve credit memos for one supplier, calculate the credit memo age in days from invoice date, show invoice amount and unpaid amount, derive hold/status context, and list related payment numbers, dates, and amounts.\",          \"when\": \"User asks to show credit memos by supplier aging.\",          \"fieldsToReturn\": [            \"invoiceNumber\",            \"invoiceType\",            \"supplierName\",            \"supplierSiteName\",            \"invoiceDate\",            \"creditMemoAgeDays\",            \"invoiceAmount\",            \"unpaidAmount\",            \"validationStatus\",            \"approvalStatus\",            \"holds\",            \"paymentNumbers\",            \"paymentDates\",            \"paymentAmounts\"          ],          \"extraFilterExpressions\": [            \"creditMemosForSupplier viewQuery filter must include invoiceTransaction.invoiceTypeCode.lookupCode IN ( 'CREDIT' )\",            \"creditMemosForSupplier viewQuery filter must include invoiceTransaction.paymentStatusCode.lookupCode IN ( 'N','P' )\",            \"When the user provides a date range, creditMemosForSupplier viewQuery filter must include invoiceTransaction.invoiceDate >= '<start_date_YYYY-MM-DD>' and invoiceTransaction.invoiceDate <= '<end_date_YYYY-MM-DD>' with resolved quoted dates from the user request\",            \"When the user provides a date range, supplierSitePayments viewQuery filter must include paymentDate >= '<start_date_YYYY-MM-DD>' and paymentDate <= '<end_date_YYYY-MM-DD>' with resolved quoted dates from the user request\",            \"When the user does not mention any date, creditMemosForSupplier viewQuery filter must use resolved quoted date literals for the default last-six-month window: invoiceTransaction.invoiceDate >= '<resolved_start_date_YYYY-MM-DD>' and invoiceTransaction.invoiceDate <= '<resolved_end_date_YYYY-MM-DD>'\",            \"When the user does not mention any date, supplierSitePayments viewQuery filter must use resolved quoted date literals for the default last-six-month window: paymentDate >= '<resolved_start_date_YYYY-MM-DD>' and paymentDate <= '<resolved_end_date_YYYY-MM-DD>'\",            \"Before returning the constructed extraction payload, replace all date placeholders in viewQuery filters with concrete quoted YYYY-MM-DD literals; a payload that still contains angle-bracket date placeholders is invalid\",            \"Do not remove the default six-month date predicates to avoid unresolved placeholders; compute the default dates and keep the predicates\",            \"supplierName from the generated supplier name when the user provides a concrete supplier, for example Advanced Network Devices; otherwise do not apply supplier-based filtering for generic Supplier, All Suppliers, every supplier, or no supplier\",            \"payment rows from supplierSitePayments joined by supplierId and supplierSiteId with paymentDate after the credit memo invoiceDate\",            \"return only credit memo rows where at least one later supplier-site payment exists\",            \"exclude voided payment rows using voidDate IS NULL\",            \"limit the ordered outer result to 20 rows using ROWNUM<=20\"          ],          \"notes\": \"Use this driver for the requested credit memo aging output. If the user provides start and end dates, resolve them into quoted YYYY-MM-DD literals and place them in both viewQuery filters: creditMemosForSupplier filters invoiceTransaction.invoiceDate inclusively and supplierSitePayments filters paymentDate inclusively. If the user does not mention any date, resolve the default last-six-month window into quoted YYYY-MM-DD literals and place those literals in both viewQuery filters. Never return unresolved date placeholders in the constructed extraction payload, and do not remove the date predicates to avoid resolving them. Do not emit ADD_MONTHS, SYSDATE, or other SQL date functions in viewQuery filters. Filter by supplierName only when the user provides a concrete supplier, such as Advanced Network Devices. Treat Supplier used as a generic placeholder, All, All Suppliers, every supplier, or no supplier as an all-supplier request and do not add any supplierName or c.supplierName predicate. Return paymentNumbers, paymentDates, and paymentAmounts as comma-separated display columns ordered by payment date descending. Derive payment details from PayablesPayment, sourced from AP checks, for payments to the same supplier and supplier site after the credit memo invoice date. Join using supplierId and supplierSiteId rather than supplier or site names.\"        }      ],      \"additionalInstructions\": [        \"Bind supplierName only when the user provides a concrete supplier, such as Advanced Network Devices. If the user says Supplier as a generic placeholder, All, All Suppliers, every supplier, or does not provide a supplier, do not add any supplierName or c.supplierName predicate.\",        \"Always restrict the invoice side to credit memos strictly in the creditMemosForSupplier viewQuery filter using invoiceTransaction.invoiceTypeCode.lookupCode IN ( 'CREDIT' ) and invoiceTransaction.paymentStatusCode.lookupCode IN ( 'N','P' ). Do not use invoiceTransaction.invoiceTypeCode = 'CREDIT' or invoiceTransaction.paymentStatusCode without .lookupCode for these filters, and do not include these invoice type or payment-status filters in the final generated SELECT statement.\",        \"When the user asks for credit memo dates from start_date to end_date, resolve both dates to YYYY-MM-DD and include single-quoted literals in both viewQuery filters: creditMemosForSupplier uses invoiceTransaction.invoiceDate >= start_date and  invoiceTransaction.invoiceDate <= end_date, and supplierSitePayments uses paymentDate >= start_date and  paymentDate <= end_date.\",        \"Always apply the date filter at the viewQuery filter level, irrespective of whether the user asks for a specific date filter: creditMemosForSupplier uses invoiceTransaction.invoiceDate >= start_date and  invoiceTransaction.invoiceDate <= end_date, and supplierSitePayments uses paymentDate >= start_date and  paymentDate <= end_date.\",        \"Do not include date-based filters in the final generated SELECT statement; date filtering must be applied only in the relevant viewQuery filters.\",        \"Always apply filters at the viewQuery filter level after applying any required data transformation.\",        \"ViewQuery filtering is mandatory for every request, including supplier-only requests such as Show credit memos for Advanced Network Devices and all-supplier requests. If no date is provided, still apply the resolved default last-six-month date filters in creditMemosForSupplier.filter and supplierSitePayments.filter; apply supplierName only when a concrete supplier is provided.\",        \"When the user does not mention any date, resolve the default last-six-month window into quoted YYYY-MM-DD literals before execution: creditMemosForSupplier uses invoiceTransaction.invoiceDate >= '<resolved_start_date_YYYY-MM-DD>' and invoiceTransaction.invoiceDate <= '<resolved_end_date_YYYY-MM-DD>', and supplierSitePayments uses paymentDate >= '<resolved_start_date_YYYY-MM-DD>' and paymentDate <= '<resolved_end_date_YYYY-MM-DD>'.\",        \"Before returning or executing the constructed extraction payload, replace every date placeholder in creditMemosForSupplier.filter and supplierSitePayments.filter with concrete quoted YYYY-MM-DD literals. Never return a payload containing angle-bracket date placeholders.\",        \"If no date is provided, do not remove the date filters. Compute the default six-month start date from the response as-of date and use the response as-of date as the end date.\",        \"Never emit ADD_MONTHS, SYSDATE, CURRENT_DATE, TRUNC, TO_DATE, or other SQL date functions in viewQuery filters for this shape; viewQuery filters can interpret unsupported functions as field names such as ADD_MONTHS. Always precompute date bounds and emit quoted YYYY-MM-DD literals.\",        \"Treat Credit Memo Age (Days) as the number of days from invoiceDate to the response as-of date.\",        \"Return the detail columns in the same order defined by fields.fieldAlias unless the user explicitly asks for a summary.\",        \"Render paymentNumbers, paymentDates, and paymentAmounts as comma-separated values. Return only credit memos that have at least one matching supplier-site payment after the credit memo invoice date.\",        \"Derive payment information from PayablesPayment/payablesPaymentDetail, the AP checks-backed payment source. Join payments to credit memos by supplierId and supplierSiteId, require paymentDate > invoiceDate, and exclude voided payments with voidDate IS NULL.\",        \"Always limit the outer query to 20 rows using where ROWNUM<=20.\"      ]    },    \"payablesPaymentProcessRequestTemplateListExtraction\": {      \"key\": \"payablesPaymentProcessRequestTemplateListExtraction\",      \"name\": \"payablesPaymentProcessRequestTemplateListExtraction\",      \"type\": \"EXTRACTION\",      \"module\": \"oraErpCorePayablesSetup\",      \"businessObject\": \"PayablesPaymentProcessRequestTemplate\",      \"description\": \"Runtime extraction wrapper for the payablesPaymentProcessRequestTemplateLists BV. Use this BV shape primarily for summary queries about the payment process request template landscape, such as counts by payment mode, template type, or accelerated-invoice policy. Use it when the user wants a rollup of available template coverage rather than a single template lookup.\",      \"exampleQuestions\": [        \"How many PPR templates are available for EFT payments by template type?\",        \"Show active payment process request templates with dynamic discount enabled.\",        \"Which active templates can be used for accepted supplier offers or accelerated invoices?\",        \"List payment run templates by payment mode.\"      ],      \"fields\": {        \"fields\": [          \"templateId\",          \"templateName\",          \"description\",          \"inactiveDate\",          \"acceleratedInvoicesCode\",          \"typeLookupCode\",          \"typeMeaning\",          \"paymentModeLookupCode\",          \"paymentModeMeaning\",          \"paymentMethodCode\"        ],        \"fieldAlias\": {          \"Template Id\": \"templateId\",          \"Template Name\": \"templateName\",          \"Description\": \"description\",          \"Inactive Date\": \"inactiveDate\",          \"Accelerated Invoices Code\": \"acceleratedInvoicesCode\",          \"Template Type Code\": \"typeLookupCode\",          \"Template Type\": \"typeMeaning\",          \"Payment Mode Code\": \"paymentModeLookupCode\",          \"Payment Mode\": \"paymentModeMeaning\",          \"Payment Method Code\": \"paymentMethodCode\"        }      },      \"supportedFilters\": [        {          \"name\": \"templateId\",          \"attribute\": \"templateId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides the template id.\",          \"valueFromUser\": \"Template Id\"        },        {          \"name\": \"templateName\",          \"attribute\": \"templateName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user searches for a PPR template by name.\",          \"valueFromUser\": \"Template Name\"        },        {          \"name\": \"inactiveDate\",          \"attribute\": \"inactiveDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for active versus inactive templates.\",          \"valueFromUser\": \"Inactive Date or date range\"        },        {          \"name\": \"type.lookupCode\",          \"attribute\": \"type.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters templates by template type.\",          \"valueFromUser\": \"Template Type Code\"        },        {          \"name\": \"paymentMode.lookupCode\",          \"attribute\": \"paymentMode.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for payment mode, check, or other payment-mode-specific templates.\",          \"valueFromUser\": \"Payment Mode Code\"        },        {          \"name\": \"paymentMethod.code\",          \"attribute\": \"paymentMethod.code\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides or asks for the seeded payment method code on a PPR template.eg Use when the user asks for EFT, check, or other payment-method-specific templates.\",          \"valueFromUser\": \"Payment Method Code\"        },        {          \"name\": \"acceleratedInvoicesCode\",          \"attribute\": \"acceleratedInvoicesCode\",          \"type\": \"string\",          \"possibleValues\": [            \"ORA_DD_ALL\",            \"ORA_DD_NO\",            \"ORA_DD_ONLY\",            \"ORA_DD_YES\",            \"ORA_EXCLUDE\",            \"ORA_EXCLUSIVE\",            \"ORA_INCLUDE\"          ],          \"usage\": \"Use when the user asks for templates supporting accelerated or early-payment invoice handling.\",          \"valueFromUser\": \"Accelerated Invoices Code\"        }      ],      \"dateFilterGuidance\": null,      \"extractionQuery\": {        \"viewQueries\": {          \"payablesPaymentProcessRequestTemplateList\": {            \"module\": \"oraErpCorePayablesSetup\",            \"businessObject\": \"PayablesPaymentProcessRequestTemplate\",            \"view\": \"payablesPaymentProcessRequestTemplateList\",            \"fieldAliases\": {              \"templateId\": \"templateId\",              \"templateName\": \"templateName\",              \"description\": \"description\",              \"inactiveDate\": \"inactiveDate\",              \"acceleratedInvoicesCode\": \"acceleratedInvoicesCode\",              \"type.lookupCode\": \"typeLookupCode\",              \"type.meaning\": \"typeMeaning\",              \"paymentMode.lookupCode\": \"paymentModeLookupCode\",              \"paymentMode.meaning\": \"paymentModeMeaning\",              \"paymentMethod.code\": \"paymentMethodCode\"            }          }        },        \"select\": \"{select_statement}\"      },      \"businessDrivers\": [        {          \"name\": \"findTemplatesByPaymentMethod\",          \"description\": \"List templates for a particular payment method such as EFT.\",          \"when\": \"User asks which PPR templates are available for a payment method \",          \"fieldsToReturn\": [            \"templateId\",            \"templateName\",            \"description\",            \"paymentModeMeaning\",            \"typeMeaning\",            \"acceleratedInvoicesCode\",            \"paymentMethodCode\"          ],          \"extraFilterExpressions\": [            \"paymentMethodCode = '<PAYMENT_METHOD_CODE_FROM_USER>'\",            \"inactiveDate IS NULL\",            \"limit: 20\"          ],          \"notes\": \"For EFT template questions, set paymentMethodCode = 'EFT' and inactiveDate IS NULL, include ROWNUM <= 20 in extraction SQL, and always emit query context. EFT is a payment method code, not an entity-resolution target. Do not answer unsupported or narrative-only.\"        },        {          \"name\": \"findActiveTemplates\",          \"description\": \"List templates that are currently usable.\",          \"when\": \"User asks for available or active PPR templates.\",          \"fieldsToReturn\": [],          \"extraFilterExpressions\": [            \"inactiveDate is null or inactiveDate>=<TODAY>\"          ],          \"notes\": \"\"        },        {          \"name\": \"templatesForAcceleratedOffers\",          \"description\": \"Find active templates that are candidates for accelerated-invoice or accepted-offer payment runs.\",          \"when\": \"User asks which template should be used for supplier offers accepted recently, early-payment programs, or accelerated invoices.\",          \"fieldsToReturn\": [            \"templateId\",            \"templateName\",            \"description\",            \"paymentModeMeaning\",            \"acceleratedInvoicesCode\",            \"typeMeaning\"          ],          \"extraFilterExpressions\": [            \"inactiveDate is null or inactiveDate>=<TODAY>\",            \"acceleratedInvoicesCode in (<ACCELERATED_POLICY_CODES_FROM_USER_OR_PLANNER>)\"          ],          \"notes\": \"Pair this template discovery with invoiceInstallmentDetails to identify the specific installments or suppliers that still have discount opportunities.\"        }      ],      \"additionalInstructions\": [        \"Generate the full SELECT statement and place it into {select_statement} before execution.\",        \"Use viewQueries.payablesPaymentProcessRequestTemplateList as the FROM source with alias consistent in the SQL (for example payablesPaymentProcessRequestTemplateList).\",        \"The inner subselect should project all aliases used by the outer SELECT and WHERE.\",        \"Apply supported filters and date filters as needed, using supportedFilters and entity resolution.\",        \"Always limit the outer query to 20 rows using where ROWNUM<=20.\",        \"Use this shape for template discovery only. Do not infer current PPR execution status from template metadata.\",        \"Use `acceleratedInvoicesCode` as the source-controlled indicator for accelerated-invoice behavior and combine it with `paymentMode` when recommending a template.\",        \"Treat business-driver filters as the required semantic core, not a closed-form query. When the user adds explicit constraints such as date or date range, PPR name/id, supplier, business unit, currency, amount, status, payment method, bank account, or payment file, add those filters when the selected shape exposes the field. A user-provided date filter overrides the default recency window. Do not drop required status, null-rate, source-shape, or sorting rules unless the user explicitly asks for a different lifecycle/source and the selected shape supports it.\",        \"If a requested filter, grouping, or output field is not exposed by the selected shape, do not invent a field or silently drop the constraint. Choose another supported shape that exposes it, or state the limitation while returning the closest supported query context.\",        \"For 'What PPR templates are available for EFT payments?', use payablesPaymentProcessRequestTemplateListExtraction with paymentMethodCode = 'EFT' AND inactiveDate IS NULL AND ROWNUM <= 20. Always emit query context.\"      ],      \"fieldSelectionRuleUsage\": {        \"match\": \"Choose the closest questionExamples entry for the user request.\",        \"fields\": \"Use the matching fields value exactly and preserve order.\",        \"paraphrases\": \"Use the same fields for paraphrased or equivalent requests.\",        \"addFieldsOnlyWhen\": \"The user explicitly asks for more displayed columns, or the field is required for filter, sort, group, key, or deeplink handling.\"      },      \"fieldSelectionRules\": [        {          \"questionExamples\": [            \"What PPR templates are available for EFT payments?\"          ],          \"queryType\": \"extraction\",          \"fields\": \"templateId,templateName,description,paymentModeMeaning,typeMeaning,acceleratedInvoicesCode,paymentMethodCode\",          \"fieldOrderLocked\": true,          \"shape\": \"payablesPaymentProcessRequestTemplateListExtraction\",          \"filters\": \"paymentMethodCode = 'EFT' AND inactiveDate IS NULL AND ROWNUM <= 20\",          \"notes\": \"Exact supported query: SELECT templateId, templateName, description, paymentModeMeaning, typeMeaning, acceleratedInvoicesCode, paymentMethodCode FROM payablesPaymentProcessRequestTemplateList WHERE paymentMethodCode = 'EFT' AND inactiveDate IS NULL AND ROWNUM <= 20. EFT is a payment method code, not an entity-resolution target. Always emit query context.\"        }      ]    }  }"
            },
            {
              "id": "1776062701897",
              "name": "businessIntent",
              "value": "[    {      \"key\": \"payablesInvoice.answerInstallmentDrilldownQuestions\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"parentSkillKey\": \"payablesInvoice.findInvoices\",      \"name\": \"Answer installment drilldown questions\",      \"intentDomainKnowledge\": \"Invoice installment drilldown questions retrieve unpaid or pending invoice installment schedule rows before payment-run selection. The drilldown is scoped by business unit, invoice currency, and supplier, and returns invoice, installment, payment-term, bank, unpaid amount, discount, payment method, and due-date details. This intent is independent of PPR-selected, rejected, failed, or proposed-payment diagnostics.\",      \"description\": \"User wants to list or inspect invoice installment schedule details for a supplier, business unit, and invoice currency, including due dates, unpaid amount, gross amount, payment method, bank account, supplier site, payment terms, and available static discount information.\",      \"nlpExamples\": [        \"Show me installment drill down business unit Vision Operations, currency USD\",        \"Fetch installment drill down for supplier Advanced Network Devices, business unit Vision Operations, currency USD\",        \"Show unpaid installments for supplier Advanced Network Devices for BU VISION RRF BU, USD, due in the next 10 days\",        \"Installment Details Fetch\",        \"Show me invoice installments for supplier GE Capital in USD for business unit Vision Operations\"      ],      \"data\": {        \"goal\": \"Return row-level invoice installment schedule details for the requested supplier, business unit, and invoice currency, ordered by highest unpaid amount first.\",        \"slices\": [          \"Default installment detail list from payablesPaymentScheduleDetailExtraction for unpaid STANDARD invoice installments.\",          \"Optional date-window filtering by schedule due date when the user provides a due-date range or relative horizon.\",          \"Optional legal entity and payment-term filters when those entities are explicitly provided.\"        ]      },      \"promptInstruction\": \"Use this intent for standalone invoice installment drilldown before or outside a payment process request. Require business unit, invoice currency, and supplier unless already resolved in context. Use `payablesPaymentScheduleDetailExtraction` as the primary runtime shape and `invoiceInstallmentDetails` as the supporting BV definition. Apply `invoiceTransaction.businessUnit.id` or business unit name, `invoiceTransaction.invoiceCurrency.currencyCode`, and supplier id or supplier name filters. Apply `invoiceTransaction.invoiceTypeCode.lookupCode = 'STANDARD'` for the default drilldown so credit memos and non-standard invoice types are not mixed into the result. Return the default columns in this order: Invoice Number / Installment Number, Payment Terms, Bank, Unpaid Amount, Currency, Discount Date, Payment Method, Discount Amount, Due Date. Source Currency from `invoiceTransaction.invoiceCurrency.currencyCode`. Order rows by Unpaid Amount descending before applying the 20-row limit. If the user asks about installments selected, unselected, rejected, failed, blocked inside a PPR, proposed payments, payment-run diagnostics, missing conversion rates, document validation, or PPR operational flow, do not use this intent; route to the relevant payment process request intent.\",      \"summarizationGuidelines\": \"Start with the number of installment rows returned and the supplier, business unit, and currency scope used. Present the detail table ordered by unpaid amount descending. Keep labels business-friendly and avoid backend field names.\",      \"recommendationGuidelines\": \"Recommend reviewing the highest unpaid installments first, checking discounts that expire soon, and validating supplier bank/payment method details when those fields are missing or unexpected. Do not recommend modifying a payment run from this standalone drilldown.\",      \"clarification\": {        \"rules\": [          {            \"when\": \"The user asks for installment drilldown without a business unit.\",            \"question\": \"Which business unit should I use for the installment drilldown?\"          },          {            \"when\": \"The user asks for installment drilldown without an invoice currency.\",            \"question\": \"Which invoice currency should I use for the installment drilldown?\"          },          {            \"when\": \"The user asks for installment drilldown without a supplier.\",            \"question\": \"Which supplier should I use for the installment drilldown?\"          }        ]      },      \"outputPattern\": {        \"details\": {          \"tables\": [            {              \"key\": \"installmentDrilldownDetails\",              \"title\": \"Installment drilldown\",              \"description\": \"Default row-level output for standalone invoice installment drilldown.\",              \"columns\": [                \"Invoice Number / Installment Number\",                \"Payment Terms\",                \"Bank\",                \"Unpaid Amount\",                \"Currency\",                \"Discount Date\",                \"Payment Method\",                \"Discount Amount\",                \"Due Date\"              ]            }          ]        }      },      \"additionalInstructions\": \"For the extraction query, select invoice number, installment number, payment term, bank, unpaid amount, invoice currency as Currency, discount date, payment method, static discount amount, and due date. Preserve the sample extraction behavior: compute static discount amount and discount date from first, second, and third discount fields when discount APR is null; filter STANDARD invoice type; and apply ORDER BY unpaidAmount DESC inside the inner select before the outer ROWNUM<=20.\"    },    {      \"key\": \"payablesInvoice.showCreditMemosBySupplierAging\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"parentSkillKey\": \"payablesInvoice.findInvoices\",      \"name\": \"Show Credit Memos By Supplier Aging\",      \"intentDomainKnowledge\": \"Credit memos in Oracle Payables reduce supplier liability and may remain open until applied or otherwise cleared. Finance users need to review credit memos by supplier to understand how old each credit memo is, the original invoice amount, the unpaid amount still available or open, and which later AP-checks payments were made to the same supplier site. This intent is scoped to supplier-level credit memo aging. It is not a payment process request diagnostic intent and does not require a PPR context.\",      \"description\": \"User wants to list credit memos for supplier aging over a requested or default credit memo invoice-date range, with invoice number, invoice type, supplier or party, supplier site, invoice date, credit memo age, invoice amount, unpaid amount, validation and approval status, holds, and AP-checks payment numbers, dates, and amounts for later payments to the same supplier site.\",      \"nlpExamples\": [        \"Show me the credit memos for supplier 'Advanced Network Devices'?\",        \"Show credit memos with Supplier and aging for credit memo dates from 2026-01-01 to 2026-06-10.\",        \"Show credit memos for Supplier with aging.\",        \"Show credit memos for Vision Operations with aging.\",        \"Show credit memos for All Suppliers with aging.\",        \"Show credit memos with aging.\",        \"List unpaid credit memos for supplier ABC by age.\",        \"For this supplier, show credit memos by age with invoice amount and unpaid amount.\"      ],      \"data\": {        \"goal\": \"Help the user review supplier credit memos in the requested or default credit memo invoice-date range, understand how long each credit memo has existed based on invoice date, see invoice amount and unpaid amount, understand hold/status context, and review related payment numbers, dates, and amounts.\",        \"slices\": [          \"Primary shape: `creditMemosBySupplierAging` for credit memo aging detail output.\",          \"Credit memo detail query: fetch credit memos for the requested inclusive invoice-date range, or the default last-six-month range when no date is mentioned, optionally filter to the supplier name provided by the user, restrict invoice type to credit memo, and return invoice number, invoice type, supplier/party, supplier site, invoice date, credit memo age in days, invoice amount, unpaid amount, validation status, approval status, holds, payment numbers, payment dates, and payment amounts.\",          \"Date window: if the user provides `{start_date}` and `{end_date}`, resolve them into quoted YYYY-MM-DD literals. Apply them to `creditMemosForSupplier.filter` as invoiceTransaction.invoiceDate >= start_date and invoiceTransaction.invoiceDate <= end_date, and to `supplierSitePayments.filter` as paymentDate >= start_date and paymentDate <= end_date. If the user does not mention any date, resolve the default last-six-month window into quoted YYYY-MM-DD literals before execution and apply those literals in both viewQuery filters. Never return unresolved date placeholders in the constructed extraction payload, and never remove the date predicates to avoid resolving placeholders. Never emit ADD_MONTHS, SYSDATE, CURRENT_DATE, TRUNC, TO_DATE, or other SQL date functions in viewQuery filters.\",          \"Supplier filter: apply `supplierName` only when the user provides a concrete supplier name, such as Advanced Network Devices. When the user uses Supplier as a generic placeholder, asks for All Suppliers or every supplier, or does not provide a supplier, do not add any supplierName or c.supplierName predicate.\",          \"Mandatory viewQuery defaults: even for supplier-only requests such as Show credit memos for Advanced Network Devices, apply the mandatory viewQuery filters. Use the resolved default last-six-month date window in both `creditMemosForSupplier.filter` and `supplierSitePayments.filter` when no date is provided; add `supplierName` only for concrete supplier names.\",          \"Payment rollup: use PayablesPayment/payablesPaymentDetail as the AP checks-backed payment source, match payments to the credit memo by supplier ID and supplier site ID, require payment date after the credit memo invoice date, exclude voided payments, and return Payment Number, Payment Date, and Payment Amount as comma-separated values.\",          \"Aging review: compute Credit Memo Age (Days) from invoice date to the response as-of date and sort by credit memo age descending unless the user asks for a different ordering.\"        ]      },      \"promptInstruction\": \"Use `creditMemosBySupplierAging` as the primary and only required shape for this intent. If the user provides credit memo invoice-date start and end dates, resolve both into quoted YYYY-MM-DD literals before executing. The generated extraction must include `creditMemosForSupplier.filter` with invoiceTransaction.invoiceDate >= start_date and invoiceTransaction.invoiceDate <= end_date, and `supplierSitePayments.filter` with paymentDate >= start_date and paymentDate <= end_date. If the user does not mention any date, resolve the default six-month window into quoted YYYY-MM-DD literals before executing: `creditMemosForSupplier.filter` must include invoiceTransaction.invoiceDate >= resolved_start_date and invoiceTransaction.invoiceDate <= resolved_end_date, and `supplierSitePayments.filter` must include paymentDate >= resolved_start_date and paymentDate <= resolved_end_date. The returned constructed extraction payload is invalid if any angle-bracket date placeholder remains in any viewQuery filter. Do not remove date predicates to avoid placeholder replacement; compute the default six-month start date from the response as-of date and use the response as-of date as the end date. Never emit ADD_MONTHS, SYSDATE, CURRENT_DATE, TRUNC, TO_DATE, or other SQL date functions in viewQuery filters; precompute date bounds and emit quoted YYYY-MM-DD literals. If the user provides a concrete supplier name, such as Advanced Network Devices, bind that generated supplier name as the `supplierName` filter. If the user says Supplier as a generic placeholder, All, All Suppliers, every supplier, or does not provide a supplier name, treat the request as all suppliers and do not add any supplierName or c.supplierName predicate. For supplier-only requests such as Show credit memos for Advanced Network Devices, still apply all mandatory viewQuery filters, including the resolved default last-six-month date filters in both `creditMemosForSupplier.filter` and `supplierSitePayments.filter` when no date is provided. Always restrict the invoice population strictly in `creditMemosForSupplier.filter` using invoiceTransaction.invoiceTypeCode.lookupCode IN ( 'CREDIT' ) and invoiceTransaction.paymentStatusCode.lookupCode IN ( 'N','P' ); do not use invoiceTransaction.invoiceTypeCode = 'CREDIT' or paymentStatusCode without `.lookupCode`. Compute Credit Memo Age (Days) from the credit memo invoice date to the response as-of date. Return only credit memos that have at least one AP-checks payment to the same supplier site after the credit memo invoice date. Return only Invoice Number, Invoice Type, Supplier/Party, Supplier Site, Invoice Date, Credit Memo Age (Days), Invoice Amount, Unpaid Amount, Validation Status, Approval Status, Holds, Payment Number, Payment Date, and Payment Amount. Derive Payment Number, Payment Date, and Payment Amount from PayablesPayment/payablesPaymentDetail by joining supplierId and supplierSiteId and requiring paymentDate > invoiceDate. Treat Payment Number, Payment Date, and Payment Amount as comma-separated values ordered by payment date descending. Do not route this intent to PPR shapes unless the user explicitly asks about a payment process request or payment run.\",      \"summarizationGuidelines\": \"Open with a short headline that states how many credit memos with later supplier-site payments were found, whether the result was filtered to a specific supplier or run for all suppliers, how many have unpaid amount, how many related payments were found, and the oldest credit memo age. Then present the detail table using the requested column order. Use business labels such as Invoice Number, Supplier/Party, Supplier Site, Invoice Date, Invoice Amount, Unpaid Amount, Payment Number, Payment Date, and Payment Amount; avoid backend field names. Render Payment Number, Payment Date, and Payment Amount as comma-separated values rather than arrays.\",      \"recommendationGuidelines\": \"Provide 1 to 2 grounded next steps based only on the returned data. Recommend reviewing the oldest credit memos first, prioritizing rows with unpaid amount, and checking rows that have a hold or status requiring review. Do not recommend applying or canceling a credit memo unless the returned amount/status information supports that review path.\",      \"clarification\": {        \"rules\": [          {            \"when\": \"The user provides an ambiguous supplier reference such as this supplier or that supplier and no supplier can be resolved from conversation context.\",            \"question\": \"Which supplier should I use for the credit memo aging review?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"creditMemoAgingSummary\",              \"title\": \"Credit memo aging summary\",              \"columns\": [                \"Supplier/Party\",                \"Supplier Site\",                \"Credit Memo Count\",                \"Open Credit Memo Count\",                \"Total Unpaid Amount\",                \"Oldest Credit Memo Age (Days)\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"creditMemoAgingDetails\",              \"description\": \"Use for  credit memo aging output, optionally filtered by supplier name.\",              \"title\": \"Credit memos by supplier aging\",              \"columns\": [                \"Invoice Number\",                \"Invoice Type\",                \"Supplier/Party\",                \"Supplier Site\",                \"Invoice Date\",                \"Credit Memo Age (Days)\",                \"Invoice Amount\",                \"Unpaid Amount\",                \"Validation Status\",                \"Approval Status\",                \"Holds\",                \"Payment Number\",                \"Payment Date\",                \"Payment Amount\"              ]            }          ]        }      },      \"additionalInstructions\": \"This intent is supplier credit memo aging over a requested credit memo invoice-date range, defaulting to the last six months when the user does not mention any date. Keep it separate from PPR, payment-file, payment-history, and hold/status review intents unless the user explicitly asks for those contexts. Apply supplierName only when the user provides a concrete supplier; treat Supplier used as a generic placeholder, All, All Suppliers, every supplier, or no supplier name as an all-supplier request with no supplierName or c.supplierName predicate. Resolve user-provided date values to quoted YYYY-MM-DD literals, for example '2025-06-10'. When no date is mentioned, precompute the default last-six-month start and end dates from the response as-of date and use quoted YYYY-MM-DD literals in both viewQuery filters. ViewQuery filtering is mandatory even for supplier-only requests such as Show credit memos for Advanced Network Devices; supplierName is optional based on the request, but the default viewQuery filters are not optional. Never return unresolved angle-bracket date placeholders in the constructed extraction payload, and never remove the default date filters to avoid resolving them. Never emit ADD_MONTHS, SYSDATE, CURRENT_DATE, TRUNC, TO_DATE, or other SQL date functions in viewQuery filters. Payment Number, Payment Date, and Payment Amount are comma-separated columns derived from AP checks-backed PayablesPayment rows for the same supplier ID and supplier site ID, with paymentDate after the credit memo invoice date. Return only credit memos with at least one matching later payment.\"    },    {      \"key\": \"ppr.analyzePaymentProcessRequestDetails\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"name\": \"Analyze Payment Process Request Details\",      \"intentDomainKnowledge\": \"A PPR aggregates invoice installments from multiple suppliers, business units, and currencies into a single batch. The header-level view (handled by View PPR Details) shows status and totals. This skill goes deeper - it analyses what is inside the run and models the impact of changes before they are made. Common analytical needs at this stage include: which suppliers represent the highest concentration of value in the batch, whether a single payee dominates the run above a threshold, what the cash outflow looks like broken down by currency, and which invoices for a specific supplier are missing from the batch despite being due. Impact modelling is a key capability here: users often want to know what the run total becomes if a supplier, invoice, or priority group is removed - before taking any action. This skill computes the before and after without executing any change. Readiness gaps are also in scope: invoices that are due today but not selected in the current run, which signals either a filter mismatch or a hold that needs resolving. This skill requires a specific PPR as context. It operates on the data of an existing run - it does not search across the batch queue, and it does not execute modifications to the run.\",      \"description\": \"Performs deeper analytical inquiry on a specific PPR - surfacing supplier and payee concentration by value, multi-currency cash outflow totals, impact modelling for removing a supplier, invoice, or priority group, and readiness risk assessment before the run proceeds. Use when the user wants to interrogate the composition of a PPR in depth rather than view its header-level status.\",      \"nlpExamples\": [        \"What is the total cash outflow for PPR named BLR0299 across all currencies?\",        \"List the top 5 payees by value in this run for zBIQA_March_30 and their percentage of the total batch amount.\",        \"Summarize the top 5 suppliers by value in this payment batch gapr_ppr_test_4\",        \"If I remove supplier 'Advanced Network Devices' from this run gapr_ppr_test_4, how much cash will I save today?\"      ],      \"data\": {        \"goal\": \"Your job when using this skill is to help the user understand the composition, concentration risk, and cash impact of a specific PPR in depth - so they can make informed decisions about whether to proceed, adjust, or escalate before the run is released for payment file build.\",        \"slices\": [          \"Primary shapes: `payablesSelectedInstallmentsSummary` for AP selected-installment rollups, `paymentRunInstallmentSummaries` for Oracle Payments/payment-run rollups, and `selectedPaymentInstallments` or `selectedPaymentInstallmentsExtraction` for AP row-level detail.\",          \"Concentration analysis: use `payablesSelectedInstallmentsSummary` for selected-installment supplier concentration in AP-stage runs; use `paymentRunInstallmentSummaries` when the user is asking about payment-run, formed-payment, IBY, or Oracle Payments-stage concentration.\",          \"Multi-currency cash outflow: use `payablesSelectedInstallmentsSummary` grouped by payment currency for AP selected-source cash outflow; use `paymentRunInstallmentSummaries` grouped by payment currency after the run has entered Oracle Payments.\",          \"Impact modelling: fetch the appropriate summary AV filtered to the item being removed; compute excluded total and derive the residual batch amount from the full run total without executing any change.\",          \"Readiness gaps: cross-reference installments due within the date range against selected installments in the Payment Run; surface those present in the due set but absent from the selected set.\",          \"Before and after impact: fetch both the full batch totals and the filtered subset being excluded in parallel; present delta explicitly. Do not fetch payment file data, validation errors, or PPR header lifecycle status - those are handled by separate skills.\",          \"Explicit top-N supplier/payee questions: use `payablesSelectedInstallmentsSummary` for AP selected-source top suppliers or top payees, and compute ranking and percentage outside the AV result when needed; use row-level selected-installment shapes only when invoice, installment, or priority detail is required.\",          \"For majority-contribution supplier analysis (for example, which suppliers represent the majority of the total payment value for a PPR), use paymentRunInstallmentSummaries and compute cumulative supplier contribution against total payment value.\"        ]      },      \"promptInstruction\": \"Always require a specific PPR as context before proceeding. If the user has not identified a PPR, apply the User Clarification rule before fetching any data. Identify the analytical intent type first - concentration, cash outflow, impact modelling, readiness gap, or before and after comparison - then plan the data slices accordingly. Do not fetch all slices for every query. For AP selected-source cash outflow, top supplier/payee concentration, supplier-removal, and invoice-removal questions, use `payablesSelectedInstallmentsSummary` first and compute ranking, percentage of total, excluded amount, and residual total outside the AV result. Use `selectedPaymentInstallments` or `selectedPaymentInstallmentsExtraction` only when the user asks for invoice references, installment rows, payment priority, or another field not exposed by the summary AV. For payment-run, formed-payment, Oracle Payments, or IBY-stage concentration and cash-outflow questions, use `paymentRunInstallmentSummaries`. For concentration queries: rank suppliers or payees by total installment value descending; compute each as a percentage of the overall batch total; surface the top N with both absolute value and percentage. For multi-currency outflow queries: group installments by payment currency; include both local currency amount and converted totals where available; note currencies where conversion rates are pending. For impact modelling queries: treat the removal as hypothetical - compute the excluded amount and derive the residual total; state clearly that this is a modelled scenario and no change has been made to the run. For invoice-removal modelling, use the summary AV for the current run total and the selected-installment detail shape for the named invoice subset if the AV cannot filter by invoice number. For Standard priority or priority-band removal, do not assume what Standard means; ask the user for the numeric payment priority or priority range between 1 and 100 unless the user already provided the numeric mapping. For readiness gap queries: identify invoices due within the specified date range; cross-check against selected installments; surface gaps with invoice reference, supplier, amount, and due date. For before and after comparison queries: always present both the original total and the post-exclusion total side by side, with the delta clearly labelled. Do not execute or recommend changes to the run - this skill is analytical and advisory only. Do not perform PPR lifecycle diagnosis, validation error analysis, or payment file-level investigation - route those to the appropriate skills.\\n\\nShape selection guidance for common user requests:\\nUse these examples as routing hints for this intent. When the user request matches one of these patterns, prefer the listed shape or shape family before planning the query. Keep the normal clarification, filtering, and response rules for this intent in force; do not expose these internal routing hints to the user.\\n- For requests like Total cash outflow for a PPR across currencies; top 5 suppliers by value in this payment batch; if removing a supplier or invoice, calculate current total, excluded subset, and revised total, prefer `payablesSelectedInstallmentsSummary`; use selectedPaymentInstallments when line-level filter detail is needed.\\n- For requests like Standard priority, standard-priority payments, or priority-band exclusion without a numeric priority, ask for the numeric payment priority or range between 1 and 100 before planning the query.\\n- For requests like Top payees or top suppliers by value in a payment batch/run and percentage of total after the run has entered Oracle Payments, prefer `paymentRunInstallmentSummaries`. \\n For any PPR-level request that asks for total cash outflow across currencies, use `payablesSelectedInstallmentsSummary`.  \\n For majority-contribution supplier analysis (for example, which suppliers represent the majority of the total payment value for a PPR), use paymentRunInstallmentSummaries and compute cumulative supplier contribution against total payment value.\",      \"summarizationGuidelines\": \"Always open with a one or two sentence direct answer to the analytical question before presenting detailed data. Keep the opening summary to around 80 to 100 words. Follow with a structured data table where the query calls for ranked or comparative data. Use tabular format for top-N payee and supplier breakdowns with columns: Rank, Supplier Name, Amount, % of Batch. Use tabular format for multi-currency outflow summaries with columns: Currency, Amount, Converted Equivalent. Use tabular format for before and after impact scenarios with columns: Scenario, Total Amount, Delta. For impact modelling responses, always label the scenario clearly - Current run total, After removing Supplier X, Difference - so the user can read the impact at a glance. For readiness gap responses, surface missing invoices in a table with columns: Invoice Reference, Supplier, Amount, Due Date, Reason for Exclusion if known. Use business-friendly labels throughout - avoid internal field codes or system identifiers unless the user referenced them. If a concentration threshold is breached, call this out prominently at the top of the response before the full table. When no issues are found, state this clearly and positively so the user can proceed with confidence.\",      \"recommendationGuidelines\": \"Generate 2 to 3 targeted next steps based on the analytical finding. Start each recommendation with a verb. For high concentration risk: \\\"Review whether paying Supplier X at N% of batch value is within your disbursement policy before releasing the run. For missing invoices: \\\"Investigate why N invoices for Supplier XYZ due today were not selected - check for holds or criteria mismatch using the Review PPR Unselected Installments skill. For impact modelling result: \\\"If removing Supplier X is appropriate, use the Manage Payment Process Request page to remove the relevant installments before releasing the run for payment file build. For currency exposure: \\\"Confirm that conversion rates are available for all non-functional currencies in this run before proceeding - missing rates will block the run at the installment selection stage. For a clean run with no issues found: \\\"No concentration or readiness issues detected - the run can proceed to payment file build. Do not recommend changes that require direct system access - provide the analytical finding and the navigational next step only.\",      \"parentSkillKey\": \"ppr.findPaymentProcessRequests\",      \"clarification\": {        \"rules\": [          {            \"when\": \"if the user's query does not reference a specific PPR by name or reference number, Please provide the PPR name or reference number.\",            \"question\": \"Which Payment Process Request would you like me to analyse?\"          },          {            \"when\": \"if the user asks to model removal of a supplier group or these rows without specifying which items,\",            \"question\": \"Could you confirm which suppliers, invoices, or priority group you'd like me to exclude from the impact calculation?\"          },          {            \"when\": \"if the user asks to exclude Standard priority payments or a named priority band without providing a numeric priority value or range,\",            \"question\": \"Which numeric payment priority or priority range between 1 and 100 should I treat as Standard for this impact calculation?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"cashFlowTrendSummary\",              \"title\": \"Supplier and cash-flow trend summary\",              \"columns\": [                \"Grouping Value\",                \"Current Value\",                \"Share Of Total Or Variance\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"cashFlowTrendDetails\",              \"title\": \"Supporting cash-flow detail\",              \"columns\": [                \"Supplier Or Payee\",                \"Reference Period\",                \"Payment Count\",                \"Total Value\",                \"Comparison Value\",                \"Variance\"              ]            }          ]        }      },      \"additionalInstructions\": \"Top-N supplier and payee concentration: ranked table with columns Rank, Supplier or Payee Name, Payment Amount, % of Batch Total. Include a summary line for All other suppliers and the overall batch total at the bottom of the table. Use `payablesSelectedInstallmentsSummary` for AP selected-installment batch analytics and `paymentRunInstallmentSummaries` for Oracle Payments/payment-run analytics. Multi-currency cash outflow: summary table with columns Payment Currency, Total Amount in local currency, Converted Amount in functional currency, Exchange Rate Applied. Add a note for any currencies where the rate is pending. Impact modelling and before and after: comparison table with columns Scenario, Batch Total, Delta. Rows are Current Run and After Exclusion of the specified item. Highlight the delta row. For Standard priority wording, ask for a numeric payment priority or range from 1 to 100 before calculating. Readiness gap: detail table with columns Invoice Reference, Supplier, Invoice Amount, Due Date, Exclusion Reason if known. Precede the table with a count and total value of missing items. All outputs: precede the table with a 1 to 2 sentence plain-language summary of the key finding. Use currency formatting consistent with the ledger currency of the business unit. Avoid raw system codes in all displayed values.\"    },    {      \"key\": \"ppr.analyzePPRExceptions\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"name\": \"Analyze PPR Exceptions\",      \"intentDomainKnowledge\": \"When a PPR encounters exceptions the user often needs more than a count and a value - they need to understand what the exception means in business terms, how it propagates through the run, and what the optimal resolution sequence is given the constraints of time and resource. This is the purpose of the Analyze PPR Exceptions skill. It operates at a deeper level than the Summarize PPR Exceptions skill, which provides triage counts and routing. This skill explains the why and the how of each exception type. There are two critical analytical dimensions that drive resolution strategy. The first is exception scope - whether a failure is at the batch level, affecting the entire PPR or payment file, or at the individual document or payment level, affecting only specific installments or payments. A batch-level failure - for example a funds reservation failure on the PPR as a whole, or a payment file format error - blocks all payments in the run and must be resolved before anything can proceed. An individual-level failure - for example a single supplier's payment exceeding a bank limit - blocks only that payment and the rest of the run can proceed if the failing item is removed. Misidentifying the scope of a failure is a common source of unnecessary delays. The second analytical dimension is the business meaning of each exception type. Many exception codes in Oracle Payables are technical in phrasing - for example \\\"budgetary control failure\\\" or \\\"cross-currency net settlement error\\\" - and users need a plain-language explanation of what triggered the exception, what business rule or data condition it reflects, and what the resolution options are. This skill provides that explanatory layer. It also identifies systemic patterns - for example whether the same error type is appearing across multiple suppliers, which may indicate a configuration gap rather than a data entry error, or whether a cluster of failures is linked to a specific bank, business unit, or payment method.\",      \"description\": \"Performs deeper analysis on PPR exceptions - explaining the business meaning of specific error types, distinguishing batch-level failures from individual payment failures, identifying systemic patterns across suppliers or business units, and guiding resolution strategy. Use when the user needs to understand what a specific error type means in business terms, how failures are scoped - batch versus individual - or how to prioritise resolution when exceptions of different types and severities are present simultaneously.\",      \"nlpExamples\": [        \"PPR XYZ failed because of cash budgeting.\",        \"What does a funds reservation failure mean for this PPR and how do I resolve it?\",        \"Are the payment validation errors in this run caused by a bank configuration issue or a supplier data issue?\"      ],      \"data\": {        \"goal\": \"Your job when using this skill is to help the user understand the business meaning of specific PPR exception types, determine whether each failure is batch-level or individual-level in scope, identify systemic patterns that indicate a configuration or data gap, and develop a prioritised resolution strategy - so they can act decisively rather than investigating each exception independently.\",        \"slices\": [          \"Primary shapes: Payment Run Exceptions, Disbursement Exceptions, Payment Run Installments, Payment Run Disbursement Payments.\",          \"Exception scope classification query: fetch Payment Run Exceptions for the named PPR; classify each exception by scope - batch-level exceptions that block the entire PPR or payment file versus individual-level exceptions that block only specific documents or payments; aggregate counts and blocked value per scope tier; surface the batch-level exceptions first as the highest priority.\",          \"Exception meaning query: fetch Payment Run Exceptions filtered to the specific exception type named by the user; retrieve the exception code, description, and affected documents or payments; prepare a plain-language business explanation of what triggered the exception and what the resolution options are based on the exception type and context.\",          \"Systemic pattern query: fetch Payment Run Exceptions for the named PPR grouped by exception type and then by supplier, business unit, bank, and payment method; identify exception types that appear across multiple suppliers or business units - a signal of a configuration gap; distinguish from exceptions that are isolated to a single supplier or document - a signal of a data entry error.\",          \"Batch versus individual payment file failure query: fetch Payment Run Exceptions and Disbursement Exceptions filtered to payment file and payment confirmation failure types; classify each as a file-level failure affecting all payments in the file versus a payment-level failure affecting individual payments within the file; aggregate counts and value per scope tier.\",          \"Resolution prioritisation query: combine scope classification and systemic pattern analysis; rank exceptions by resolution priority - batch-level failures first, then systemic individual failures, then isolated individual failures; compute the value unlocked at each priority tier. Do not fetch installment selection detail, missing attribute data, or payment file formatting detail beyond what is captured in the exception shapes unless needed to explain the business context of a specific exception type.\"        ]      },      \"promptInstruction\": \"Identify the analytical query type first - exception meaning explanation, scope classification, systemic pattern analysis, batch versus individual failure distinction, or resolution prioritisation - then plan the data slices accordingly. For exception meaning explanation queries: identify the specific exception type or code referenced by the user; prepare a plain-language business explanation covering what the exception means, what business rule or data condition triggered it, how it propagates - batch or individual - and what the resolution options are; where multiple resolution paths exist present them in order from least to most disruptive. For scope classification queries: fetch all exceptions for the named PPR; classify each as batch-level - blocks the entire PPR or payment file - or individual-level - blocks only specific documents or payments; within individual-level exceptions further classify as high-volume - the same error affecting many documents - or isolated - a single document or payment; present the classification in a tiered structure with value at risk per tier. For systemic pattern analysis queries: group exceptions by type and then cross-reference against supplier, business unit, bank, and payment method dimensions; identify exception types where the same error appears across three or more suppliers or documents - flag these as potentially systemic; distinguish from isolated single-supplier errors; explain what a systemic pattern implies in terms of likely root cause - for example a configuration gap versus a data entry error - and what type of resolution is needed. For batch versus individual payment file failure queries: fetch payment file and confirmation exceptions; classify as file-level - affects all payments in the file - or payment-level - affects individual payments; surface file-level failures prominently as they have the broadest impact; for payment-level failures aggregate the count and value of rejected payments versus the count and value of accepted payments within the same file to give a clear picture of partial success scenarios. For resolution prioritisation queries: rank exceptions into three tiers - Tier 1 batch-level failures to resolve before anything else, Tier 2 systemic individual failures that will recur unless a root cause is fixed, Tier 3 isolated individual failures that can be fixed case by case; compute the total value unlocked at each tier; present tier by tier with the recommended action for each. Always require at least one specific PPR or exception type as context before proceeding - this skill does not operate on vague or unanchored exception queries. Apply the User Clarification rules if context is insufficient. Route explicitly to the appropriate stage-specific skill when detailed per-exception diagnosis is needed beyond what this analytical skill covers.  If you want to view the PPR stuck in failure , use     paymentRunInstallmentExceptionsExtraction and  documentValidationErrors\",      \"summarizationGuidelines\": \"Always open with a direct answer to the analytical question - for example a plain-language explanation of what the named exception means, or a clear statement of which failures are batch-level versus individual-level - before presenting supporting data. Keep the opening summary to around 80 to 100 words. For exception meaning explanation responses: present the explanation in three parts - what the exception is in plain business language, what specifically triggered it in the context of this PPR, and what the resolution options are in order from least to most disruptive. Use a structured two-column label and value format for this response type - avoid dense prose blocks. For scope classification responses: present a tiered table with columns Scope Tier, Exception Type, Affected Count, Total Blocked Value, Resolution Must Happen Before. Three tiers: Batch-Level Failure, High-Volume Individual Failure, Isolated Individual Failure. Rank within each tier by blocked value descending. For systemic pattern analysis responses: present a pattern summary table with columns Exception Type, Occurrence Count, Suppliers Affected, Business Units Affected, Pattern Classification - Systemic or Isolated, Likely Root Cause. Follow with a plain-language paragraph explaining the implication of each systemic pattern and the recommended resolution approach - configuration fix versus data correction. For batch versus individual payment file failure responses: present a two-section table - Section 1 File-Level Failures with columns Exception Type, Payment Files Affected, Total Payments Blocked, Total Value Blocked; Section 2 Payment-Level Failures within Files with columns Exception Type, Individual Payments Rejected, Value Rejected, Value Accepted in Same File. For resolution prioritisation responses: present a three-tier prioritisation table with columns Priority Tier, Exception Types, Affected Count, Value Unlocked if Resolved, Recommended Action. Always include a routing note mapping each exception type to the appropriate stage-specific skill. Use business-friendly exception labels and plain-language explanations throughout. Avoid technical system codes in user-facing content.\",      \"recommendationGuidelines\": \"Generate 2 to 4 targeted next steps based on the analytical finding. Start each recommendation with a verb. For batch-level failure identified: \\\"Resolve the batch-level [exception type] first - it is blocking the entire PPR and no individual payments can proceed until it is addressed. Use the [stage-specific skill] for detailed resolution guidance. For systemic exception pattern identified: \\\"Treat the [exception type] appearing across [N] suppliers as a configuration issue rather than individual data errors - escalate to your Oracle setup team to review the [relevant configuration area] rather than fixing each instance separately. For high-volume individual failures with a common root cause: \\\"Address the root cause of the [exception type] affecting [N] payments - a single configuration or data correction will resolve all [N] instances simultaneously and recover [value]. For mix of batch-level and individual failures: \\\"Resolve the batch-level failures first to unblock the run, then address the individual payment failures in priority order by blocked value - do not attempt individual fixes while the batch-level block is still in place. For isolated individual failures with no systemic pattern: \\\"Address the [N] isolated [exception type] failures individually - use the [stage-specific skill] to diagnose each one and determine whether to fix or remove the failing document from this run. For exceptions that will recur in future runs unless root cause is fixed: \\\"Note that the [exception type] is systemic and will recur in future PPRs unless the underlying [configuration or data gap] is resolved - raise a separate remediation task to fix the root cause beyond this run. Route explicitly to the appropriate stage-specific skill for each exception type in all recommendations. Do not execute resolution actions - analytical and advisory only.\",      \"parentSkillKey\": \"ppr.findPaymentProcessRequests\",      \"clarification\": {        \"rules\": [          {            \"when\": \"The user asks why a PPR failed but does not provide the PPR identifier and there is no current-page context.\",            \"question\": \"Which PPR should I diagnose?\"          }        ]      },      \"outputPattern\": {        \"details\": {          \"tables\": [            {              \"key\": \"specificFailureDiagnosis\",              \"title\": \"Specific PPR failure diagnosis\",              \"columns\": [                \"PPR Name\",                \"Failed Stage\",                \"Status\",                \"Error Type\",                \"Error Code\",                \"Error Message\",                \"Impacted Object Type\",                \"Impacted Row Count\",                \"Blocked Amount\",                \"Business Impact\"              ]            }          ]        }      },      \"additionalInstructions\": \"Exception meaning explanation: structured two-column card format - rows for Exception Name, Plain-Language Meaning, What Triggered It in This PPR, Scope - Batch or Individual, Resolution Options in Order of Least to Most Disruptive. Use this format for single exception type explanations. Scope classification table: three-tier table with columns Scope Tier, Exception Type, Affected Count, Total Blocked Value, Resolution Dependency. Tiers: Batch-Level Failure, High-Volume Individual Failure, Isolated Individual Failure. Rank within each tier by Total Blocked Value descending. Systemic pattern analysis table: columns Exception Type, Occurrence Count, Suppliers Affected, Business Units Affected, Pattern Classification - Systemic or Isolated, Likely Root Cause. Follow with a plain-language paragraph per systemic pattern. Batch versus individual payment file failure output: two-section table - Section 1 File-Level Failures with columns Exception Type, Files Affected, Total Payments Blocked, Total Value Blocked; Section 2 Payment-Level Failures with columns Exception Type, Payments Rejected, Value Rejected, Value Accepted in Same File. Resolution prioritisation table: three-tier table with columns Priority Tier, Exception Types, Affected Count, Value Unlocked if Resolved, Recommended Action and Skill. Routing note: include a plain-language routing note at the bottom of every response mapping each exception type discussed to the appropriate stage-specific skill - for example \\\"For detailed diagnosis of payment validation errors use the Review PPR Payment Validation Errors skill. All outputs: precede the table or card with a 1 to 2 sentence plain-language headline of the key analytical finding. Use business-friendly exception labels and plain-language explanations throughout. Avoid technical system codes or internal field identifiers in all user-facing content.\"    },    {      \"key\": \"ppr.compareHistoricalVsFutureCashflow\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"name\": \"Compare Historical vs Future Cashflow\",      \"intentDomainKnowledge\": \"This skill bridges two data sources - completed historical payment data from the Invoice Payments Summary and forward-looking installment schedule data from the Installment Schedules Summary - to produce a comparative view of planned versus typical outflow. The historical side establishes a baseline: what the organisation has typically disbursed over equivalent periods in the past - by day, week, or month - across currencies, business units, and payment methods. The forward-looking side surfaces what is currently scheduled or due for payment in the upcoming window based on installment due dates and any scheduled PPR template runs. By comparing these two, the user gets an early warning signal: is the upcoming week unusually heavy relative to the historical norm, suggesting a liquidity requirement to plan for? Or is it unusually light, suggesting installments may have been missed, deferred, or not yet scheduled? This is a pre-submission planning skill - it does not access active PPR run status, payment file data, or post-processing outcomes. It also does not perform supplier-level drill down beyond summary totals. Both inputs - the historical baseline and the forward-looking schedule - are required to produce a meaningful comparison. If either is unavailable or ambiguous the skill applies the clarification rules before proceeding.\",      \"description\": \"Compares upcoming scheduled payment outflows against historical payment averages to flag whether planned disbursements are running above or below trend - supporting liquidity planning and early identification of unusually large or light payment weeks. Use when the user wants to understand how next week's or next month's planned outflow compares to historical norms, to anticipate cash requirements or surface anomalies before runs are submitted.\",      \"nlpExamples\": [        \"Compare the next week outflow against the average for this month.\",        \"Is the planned outflow for tomorrow higher or lower than usual?\",        \"How does this month's upcoming payment schedule compare to last month's actual outflow?\"      ],      \"data\": {        \"goal\": \"Your job when using this skill is to help the user compare what is planned for an upcoming payment period against what was typically disbursed in equivalent historical periods - so they can anticipate liquidity requirements, flag anomalies before runs are submitted, and take proactive action if the planned outflow is materially above or below the historical norm.\",        \"slices\": [          \"Primary shapes: Invoice Payments Summary (historical baseline) vs Installment Schedules Summary (forward-looking planned outflow).\",          \"Historical baseline slice: fetch Invoice Payments Summary filtered to the comparison period specified by the user - for example this month, the last 4 weeks, or the last quarter; aggregate total payment value by the relevant time unit - daily average, weekly average, or monthly total - to establish the baseline norm.\",          \"Forward-looking slice: fetch Installment Schedules Summary filtered to the upcoming window specified by the user - for example next week, tomorrow, or the next 30 days; aggregate total installment value due in that window; group by the same dimensions used in the historical slice - currency, business unit, or payment method - to enable a like-for-like comparison.\",          \"Variance computation: derive the absolute variance (planned future outflow minus historical baseline) and the percentage variance for each dimension.\",          \"Average computation: if the user requests a comparison against an average - for example the average weekly outflow for last month - compute the average from the relevant Invoice Payments Summary slice before comparing against the forward-looking total. Do not fetch active PPR run data, payment file data, or supplier-level detail beyond summary groupings. Ensure both slices are aggregated at the same time unit - for example both at weekly totals or both at daily totals - before computing variance to ensure a meaningful like-for-like comparison.\"        ]      },      \"promptInstruction\": \"Identify the comparison structure first - upcoming period vs specific historical period, upcoming period vs rolling historical average, or upcoming period vs same period in a prior month or quarter - then plan the two data slices accordingly. For upcoming period vs specific historical period: fetch Installment Schedules Summary for the forward-looking window; fetch Invoice Payments Summary for the stated historical period; aggregate both at the same time unit; compute absolute and percentage variance. For upcoming period vs rolling historical average: fetch Installment Schedules Summary for the forward-looking window; fetch Invoice Payments Summary for the rolling historical window - for example the last 4 weeks or last 3 months; compute the average outflow per equivalent time unit from the historical slice; compare the forward-looking total against the computed average; state clearly that the comparison is against a computed average and specify the window used. For same-period prior comparison - for example next week vs the same week last month: fetch Installment Schedules Summary for the upcoming week; fetch Invoice Payments Summary for the equivalent week in the prior period; aggregate both at the weekly total level; compute variance. Always ensure the time unit of aggregation is consistent across both slices before computing variance. If the user requests a breakdown dimension such as currency, business unit, or payment method, apply the same grouping to both slices before comparing so the variance is computed at the dimension level. Clearly label which side of the comparison is historical actuals and which is planned scheduled installments - the forward-looking figure is a projection based on current installment schedules and may differ from the actual PPR submission if criteria or installments change before submission. Apply the User Clarification rules if either the historical window or the forward-looking window is not specified or is ambiguous. Do not retrieve active PPR run data, payment file data, or supplier-level detail. If the user's query blends this comparison with a backward-looking only question, handle the forward-looking portion here and signal that the purely historical portion can be handled by the Review Historical Cashflow Trends or Compare Historical vs Historical Cashflow skills.\",      \"summarizationGuidelines\": \"Always open with a direct headline statement of the variance between the planned outflow and the historical baseline - for example \\\"Next week's scheduled installments of X are 28% above the historical weekly average of Y for last month\\\" - before presenting the detailed comparison. Keep the opening summary to around 60 to 80 words. Clearly label which figure is historical actuals and which is a forward-looking projection based on current installment schedules - include a note stating that the planned figure may change if installments are added, removed, or held before submission. For the main comparison: present a side-by-side table with columns Forward-Looking Period Label, Planned Outflow, Historical Baseline Label, Historical Baseline, Variance Absolute, Variance Percentage. Include an overall total row. If a breakdown dimension was requested, add one row per dimension value using the same six columns. Highlight the variance column with a clear directional indicator - flag increases above 20% as significantly above trend and decreases below 20% as significantly below trend. For rolling average comparisons: include a footnote stating the window and number of data points used to compute the historical average. If the planned outflow is within normal range - variance less than 10% - state that the upcoming period is tracking consistently with the historical norm. If the planned outflow is materially above trend, flag the liquidity implication. If materially below trend, flag the possibility of missed or unscheduled installments. Use business-friendly period labels. Use currency formatting consistent with the ledger currency of the relevant business unit.\",      \"recommendationGuidelines\": \"Generate 2 to 3 targeted next steps based on the comparison finding. Start each recommendation with a verb. For planned outflow significantly above historical average: \\\"Confirm that the required cash is available in the relevant bank accounts to cover the higher-than-usual planned outflow - escalate to treasury if a liquidity shortfall is possible. For planned outflow significantly above historical average - possible cause: \\\"Review the installments driving the elevated planned outflow - check for accumulated overdue items, large one-off supplier payments, or a broader selection criteria in the upcoming run that accounts for the increase. For planned outflow significantly below historical average: \\\"Investigate whether the lower planned outflow reflects intentional deferral or missed installments - use the Review Upcoming Schedules for Payment Runs skill to identify any due installments not covered by a scheduled run. For planned outflow within normal range: \\\"No significant variance detected - planned outflow is tracking consistently with the historical norm. Proceed with run submission as planned. For forward-looking figure based on incomplete schedule - no PPR yet submitted: \\\"Submit a Payment Process Request to cover the due installments in this window - use the Review PPR Templates and Schedules skill to identify the best matching template before submission. For currency-level variance identified within an otherwise normal total: \\\"Investigate the currency-level variance even if the overall total appears normal - a shift in currency mix may signal a change in supplier payment patterns or a pending conversion rate issue that could affect the run.\\\"\",      \"parentSkillKey\": \"ppr.reviewPPRTemplatesAndSchedules\",      \"clarification\": {        \"rules\": [          {            \"when\": \"if the user has not specified the upcoming period to analyse,\",            \"question\": \"Which upcoming period would you like to plan for - for example tomorrow, next week, or the next 30 days?\"          },          {            \"when\": \"if the user has not specified what historical period to compare against,\",            \"question\": \"Which historical period would you like to use as the baseline - for example this month's average, the last 4 weeks, or the same period last month?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"historicalVsFutureCashflowSummary\",              \"title\": \"Historical versus future cashflow comparison\",              \"columns\": [                \"Comparison Window\",                \"Historical Baseline Value\",                \"Future Planned Value\",                \"Variance\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"historicalVsFutureCashflowDetails\",              \"title\": \"Historical and planned outflow detail\",              \"columns\": [                \"Reference Window\",                \"Business Unit Or Currency\",                \"Payment Count Or Installment Count\",                \"Total Value\",                \"Comparison Role\"              ]            }          ]        }      },      \"additionalInstructions\": \"Primary comparison table: side-by-side table with columns Forward-Looking Period, Planned Outflow, Historical Baseline Period, Historical Baseline, Variance Absolute, Variance Percentage. Include an overall total row. Use clear directional indicators in the variance columns - plus sign and flag for above trend, minus sign and flag for below trend. Breakdown comparison table: if a dimension breakdown was requested, extend the primary comparison table with one row per dimension value - currency, payment method, or business unit - using the same six columns. Include a total row at the bottom. Projection disclaimer: include a plain-language note beneath every output stating that the planned outflow figure is a projection based on current installment schedules as of today's date and may change if installments are added, removed, or held before the run is submitted. Rolling average footnote: include a plain-language footnote stating the window and number of data points used to compute the historical average. Variance callout: if the overall variance exceeds 20% in either direction, add a prominent callout above the table - for example \\\"Significantly above trend: planned outflow is 34% higher than the historical weekly average. All outputs: precede the table with a 1 to 2 sentence plain-language headline of the key variance finding. Use currency formatting consistent with the ledger currency of the relevant business unit. Avoid raw date codes or system identifiers - use business-friendly period labels throughout. For multi-currency results include both local currency amounts and functional currency equivalents where conversion data is available.\"    },    {      \"key\": \"ppr.compareHistoricalVsHistoricalCashflow\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"name\": \"Compare Historical vs Historical Cashflow\",      \"intentDomainKnowledge\": \"Once payments are processed and completed, their data is captured in the Invoice Payments Summary. This skill operates on two separate slices of that completed payment data - a primary period and a comparison period - and computes the variance between them in absolute and percentage terms. The primary use cases are: run-over-run benchmarking where the user wants to know whether today's or this week's outflow is materially different from a prior period average; anomaly detection where a spike or drop in disbursement volume needs to be explained before escalating; and seasonal pattern recognition where the user wants to understand whether current outflow is consistent with the same period in a prior month or quarter. The comparison can be structured in several ways: a specific day versus the average of a prior week, a completed PPR's total versus the average of recent PPRs, this week's outflow versus last week's outflow, or this month versus last month. Both sides of the comparison must be historical completed data. This skill does not model future outflows, does not access active PPR run data, and does not perform supplier-level drill down beyond summary totals - it operates at the aggregate outflow level to surface the headline variance and its likely drivers.\",      \"description\": \"Compares two historical payment outflow periods to surface variance - for example, today versus last week's average - helping users identify anomalies, seasonal patterns, or run-over-run changes in disbursement volume. Use when the user wants to benchmark one completed period's payment outflow against another to understand whether spend is tracking as expected or has deviated significantly.\",      \"nlpExamples\": [        \"Compare the cash flow of today to the average of last week and provide the variance.\",        \"Compare this week's total outflow to last week.\",        \"How does this month's disbursement value compare to last month?\"      ],      \"data\": {        \"goal\": \"Your job when using this skill is to help the user quantify the variance between two historical payment outflow periods - in absolute and percentage terms - identify whether the deviation is significant, and surface the most likely drivers of the difference so the user can determine whether it reflects normal variation or requires investigation.\",        \"slices\": [          \"Primary shapes: Invoice Payments Summary (Period A) vs Invoice Payments Summary (Period B). Both slices use the same shape - Invoice Payments Summary - but filtered to different date ranges representing the two comparison periods.\",          \"Period A slice: fetch Invoice Payments Summary filtered to the primary period specified by the user - for example today, this week, or a named PPR's payment date range; aggregate total payment value, payment count, and optionally breakdown by currency or payment method.\",          \"Period B slice: fetch Invoice Payments Summary filtered to the comparison period specified by the user - for example last week, the prior 7 days, or the average of the last N PPRs; aggregate on the same dimensions as Period A.\",          \"Variance computation: derive the absolute variance (Period A minus Period B) and the percentage variance ((Period A minus Period B) divided by Period B multiplied by 100) for each dimension.\",          \"Average computation: if the user requests a comparison against an average - for example, the average of the last 5 PPRs or the daily average of last week - compute the average from the relevant Invoice Payments Summary slice before comparing. Do not fetch upcoming installment data, active PPR run data, payment file data, or supplier-level detail beyond summary groupings.\"        ]      },      \"promptInstruction\": \"Identify the comparison structure first - specific period vs specific period, specific period vs rolling average, or PPR vs PPR average - then plan the two data slices accordingly. For specific period vs specific period comparisons: fetch Invoice Payments Summary for both stated date ranges; aggregate total payment value and count for each; compute absolute and percentage variance; if the user has requested a breakdown dimension such as currency or payment method, apply the same grouping to both slices before comparing. For specific period vs rolling average comparisons: fetch Invoice Payments Summary for the primary period; fetch Invoice Payments Summary for the rolling window - for example the last 7 days or the last 5 PPRs - and compute the average; compare the primary period total against the computed average; state clearly that the comparison is against a computed average and specify the window used. For PPR vs PPR average comparisons: identify the named or implied PPR's payment date range from the Invoice Payments Summary; identify the comparison set of prior PPRs; compute the average total for the comparison set; compare the named PPR's total against that average. Always compute both absolute variance and percentage variance. If the variance is positive - Period A is larger than Period B - label it as an increase. If negative, label it as a decrease. Do not interpret the variance as good or bad - present it factually and surface the most significant contributing dimension if a breakdown was requested. Apply the User Clarification rules if either comparison period is not specified or is ambiguous. Do not retrieve upcoming installment data, active PPR run status, or payment file data. If the user's query blends historical comparison with a forward-looking question, handle the historical portion here and signal that the forward-looking portion requires the Compare Historical vs Future Cashflow skill.\",      \"summarizationGuidelines\": \"Always open with a direct headline statement of the variance - for example \\\"Today's total outflow of X is Y% higher than last week's daily average of Z\\\" - before presenting the detailed comparison table. Keep the opening summary to around 60 to 80 words. For the main comparison: present a side-by-side table with clearly labelled period columns - Period A label, Period B label, Variance Absolute, Variance Percentage. Include an overall total row. If a breakdown dimension was requested, add one row per dimension value - for example one row per currency or payment method - with the same four columns. Highlight the variance column - use a clear positive or negative indicator so the direction of change is immediately readable. For rolling average comparisons: include a note beneath the table stating the window used to compute the average - for example \\\"Period B is the daily average computed from 5 trading days ending on [date]. For PPR vs PPR average comparisons: include a note stating how many PPRs were included in the average calculation and the date range they span. If the variance is large - greater than 20% in either direction - call this out prominently in the opening summary as a significant deviation. If the variance is within normal range - less than 10% - state that the outflow is tracking consistently with the comparison period. Use business-friendly period labels - avoid raw date codes. Use currency formatting consistent with the ledger currency of the relevant business unit.\",      \"recommendationGuidelines\": \"Generate 2 to 3 targeted next steps based on the variance finding. Start each recommendation with a verb. For significant increase in outflow versus comparison period: \\\"Investigate the drivers of the higher outflow in this period - review the PPRs processed to identify any one-off, high-value, or unplanned payments that account for the difference. For significant decrease in outflow versus comparison period: \\\"Confirm that the lower outflow reflects expected payment timing rather than missed or delayed runs - check for installments that were due in this period but not processed. For variance within normal range: \\\"No significant variance detected - outflow is tracking consistently with the comparison period. No immediate action required. For PPR total materially above the historical average: \\\"Review the composition of this PPR against prior runs - the higher total may reflect an accumulation of overdue installments, a large one-off supplier payment, or an expanded selection criteria. For PPR total materially below the historical average: \\\"Confirm that the lower PPR total is intentional - it may indicate installments were excluded, held, or deferred to a future run that require follow-up. For currency-level variance identified within an otherwise normal total: \\\"Investigate the currency-level variance even if the overall total appears normal - a significant shift in currency mix may signal a change in supplier payment patterns or a missing conversion rate issue.\\\"\",      \"parentSkillKey\": \"ppr.reviewPPRTemplatesAndSchedules\",      \"clarification\": {        \"rules\": [          {            \"when\": \"The user asks for comparison or concentration without saying what the current scope or baseline period should be.\",            \"question\": \"Should I compare a specific run or date window against a recent daily or weekly baseline?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"cashFlowTrendSummary\",              \"title\": \"Supplier and cash-flow trend summary\",              \"columns\": [                \"Grouping Value\",                \"Current Value\",                \"Share Of Total Or Variance\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"cashFlowTrendDetails\",              \"title\": \"Supporting cash-flow detail\",              \"columns\": [                \"Supplier Or Payee\",                \"Reference Period\",                \"Payment Count\",                \"Total Value\",                \"Comparison Value\",                \"Variance\"              ]            }          ]        }      },      \"additionalInstructions\": \"Primary comparison table: side-by-side table with columns Period A Label, Period A Total, Period B Label, Period B Total, Variance Absolute, Variance Percentage. Include an overall total row. Use positive and negative indicators clearly in the variance columns - for example a plus sign and green label for increase, minus sign and amber label for decrease. Breakdown comparison table: if a dimension breakdown was requested, extend the primary comparison table with one row per dimension value - currency, payment method, or business unit - using the same six columns. Include a total row at the bottom. Rolling average note: include a plain-language footnote beneath the table stating the window and number of data points used to compute the comparison period average. PPR average note: include a plain-language footnote stating how many PPRs were included in the average and the date range they span. Variance callout: if the overall variance exceeds 20% in either direction, add a prominent callout above the table - for example \\\"Significant increase detected: Period A is 34% above the comparison period average. All outputs: precede the table with a 1 to 2 sentence plain-language headline of the key variance finding. Use currency formatting consistent with the ledger currency of the relevant business unit. Avoid raw date codes or system identifiers - use business-friendly period labels throughout. For multi-currency results include both local currency amounts and functional currency equivalents where conversion data is available.\"    },    {      \"key\": \"ppr.paymentDisbursementDetailsInquiry\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"parentSkillKey\": \"ppr.findPaymentProcessRequests\",      \"name\": \"View payment disbursement details\",      \"intentDomainKnowledge\": \"This intent answers logistics questions about an individual payment, such as which bank account was used, which branch or bank was involved, what service level or delivery channel applied, and how a specific installment maps to its disbursement context. It is narrower than proposed-payment review because the user is asking about how a specific payment will be or was disbursed.\",      \"description\": \"User wants the exact disbursement logistics of a payment generated from a PPR, including bank account, bank, branch, format, service level, or delivery channel.\",      \"nlpExamples\": [        \"Show are service level codes and delivery channels for payment reference 2562\",        \"What bank account is being used to pay for Installment 1 for invoice JPM01-INV01\",        \"Show me the bank branch and country for Installments under PPR gapr_ppr_test_4\",        \"List the 'External Bank Account' for all payees selected in PPR PPR05-009\"      ],      \"data\": {        \"goal\": \"Return the exact disbursement logistics of the payment and translate system-oriented attributes into business language. For supplier-payment questions asking what bank account was used to pay a supplier, the primary and mandatory source is `paymentRunInstallmentsExtraction`.\",        \"slices\": [          \"Summary of payment logistics by payment, supplier, or payment date when the question returns multiple rows.\",          \"Payment detail slice including payment number, payment date, payee, amount, currency, disbursement bank account, bank, branch, masked external bank account, payment method, format, service level, delivery channel, payment system, and status.\",          \"Optional installment-to-payment mapping slice when the user starts from an installment.\",          \"When the user asks 'What bank account was used to pay Supplier X?', use `paymentRunInstallmentsExtraction` first. If `paymentRunInstallmentsExtraction` cannot expose the required bank-account field, fall back to the closest extraction shape that exposes installment-to-payment and disbursement details.\"        ]      },      \"promptInstruction\": \"Use Disbursement Payments BV for payment-centric queries and use `paymentRunInstallmentsExtraction` as the primary extraction path whenever the user asks which bank account was used to pay a supplier or which bank account is being used for an installment. This supplier-payment bank-account lookup rule is mandatory when `paymentRunInstallmentsExtraction` can expose the needed field. Do not answer supplier-payment bank-account questions from payment header data, summary data, or generic payment lookup while that extraction path exposes the needed bank-account field. Use an alternate extraction only if `paymentRunInstallmentsExtraction` does not expose the required field. Treat `bank account used to pay`, `payment file format used`, `bank branch and bank`, and `service level or delivery channel` as this intent only when the user is asking about a specific payment, supplier payment, installment, payment date, PPR payment set, or payment file context. Return both code and friendly label when exposed, and explain the business effect rather than just echoing the stored value.\\n\\nShape selection guidance for common user requests:\\nUse these examples as routing hints for this intent. When the user request matches one of these patterns, prefer the listed shape or shape family before planning the query. Keep the normal clarification, filtering, and response rules for this intent in force; do not expose these internal routing hints to the user.\\n- For requests like What bank account was used to pay a supplier on a payment date; what bank account is being used for an installment, prefer paymentRunInstallmentsExtraction.\\n- For requests like External bank account for all payees selected in a PPR; bank branch and country for installments in a batch, prefer disbursementPayments.\\n- For requests like Bank branch and bank for a particular payment, prefer disbursementPaymentsExtraction.\\n\\n\\n\\nFor service-level or delivery-channel lookups by payment reference, use disbursementPayments BV with only serviceLevelCode and deliveryChannelCode when no extra columns are requested; filter paymentReferenceNumber = '<value>', sort by paymentReferenceNumber:asc before applying limit 20, and do not substitute paymentDate sorting. If the user says payment reference or payment reference number, do not treat the number as paymentId.\\n\\nService-level and delivery-channel questions by payment reference are supported. Treat serviceLevelCode and deliveryChannelCode as returned fields, not unsupported filters; use disbursementPayments BV, filter paymentReferenceNumber = '<value>', sort paymentReferenceNumber:asc, and limit 20. External bank account for all payees selected in a named PPR is also supported by disbursementPayments BV; return externalBankAccount.bankAccountName and payeePartyName, filter paymentsPayablesPaymentProcessRequest.paymentProcessRequestName, sort paymentDate:asc, and limit 20. For bank account used to pay a specific invoice installment, use paymentRunInstallmentsExtraction with SELECT bankAccountName and filters invoiceNumber plus installmentNumber.\",      \"summarizationGuidelines\": \"Give the direct answer first. Translate code-heavy values into friendly terms. Anticipate the next likely question by including related context such as bank, branch, account, currency, or payment method when exposed. For supplier-payment bank-account lookups, briefly mention that the installment/disbursement source was used.\",      \"recommendationGuidelines\": \"Recommend reviewing the payment process profile or linked payment file when a value looks unexpected, or drilling into the parent payment file when the user broadens from one payment to file-level behavior.\",      \"clarification\": {        \"rules\": [          {            \"when\": \"The user asks about payment logistics without identifying a payment, supplier, installment, payment date, PPR, or payment file context.\",            \"question\": \"Which payment, supplier, installment, payment date, PPR, or payment file should I use to look up the disbursement details?\"          }        ]      },      \"outputPattern\": {        \"details\": {          \"tables\": [            {              \"key\": \"paymentDisbursementDetails\",              \"title\": \"Payment disbursement details\",              \"columns\": [                \"Payment Reference\",                \"Payment Date\",                \"Payee\",                \"Payment Amount\",                \"Currency\",                \"Disbursement Bank Account\",                \"Bank Name\",                \"Bank Branch\",                \"Payment Method\",                \"Format Name\",                \"Service Level\",                \"Delivery Channel\"              ]            }          ]        }      },      \"additionalInstructions\": \"For supplier-payment questions phrased as `What bank account was used to pay Supplier X?`, use `paymentRunInstallmentsExtraction` as the first-choice shape. Only use another extraction as fallback when `paymentRunInstallmentsExtraction` is incomplete for the requested payment context. Whenever possible, include surrounding payment context such as masked account details, payment method, or payment system so the answer is useful without another immediate follow-up.\\nTreat business-driver filters as the required semantic core, not a closed-form query. When the user adds explicit constraints such as date or date range, PPR name/id, supplier, business unit, currency, amount, status, payment method, bank account, or payment file, add those filters when the selected shape exposes the field. A user-provided date filter overrides the default recency window. Do not drop required status, null-rate, source-shape, or sorting rules unless the user explicitly asks for a different lifecycle/source and the selected shape supports it.\\nIf a requested filter, grouping, or output field is not exposed by the selected shape, do not invent a field or silently drop the constraint. Choose another supported shape that exposes it, or state the limitation while returning the closest supported query context. For service-level and delivery-channel lookups, explicit payment reference wording must filter paymentReferenceNumber and sort paymentReferenceNumber ascending before the limit.\\n\\nDo not return the unsupported-release message for payment-reference service-level/delivery-channel lookups, external bank account by PPR, or bank account by invoice/installment when the required fields are exposed. For these supported patterns, always emit the matching query context even if no rows are returned.\"    },    {      \"key\": \"ppr.paymentFileDetailsInquiry\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"parentSkillKey\": \"ppr.findPaymentProcessRequests\",      \"name\": \"View payment file details\",      \"intentDomainKnowledge\": \"A payment file or payment instruction is a file-level execution object created from payments. It is not the same as the PPR and not the same as the payment row. Users come here when they want to understand grouping rules, file status, file-processing behavior, or which payments belong to a file.\",      \"description\": \"User wants to understand payment-file grouping, file status, file-processing behavior, acknowledgements, file totals, or the payments contained in a payment file.\",      \"nlpExamples\": [        \"What payment file format was used for PPR PPR05-009\"      ],      \"data\": {        \"goal\": \"Let the user understand the file-level object that is blocking or completing the payment run and trace it back to the related payments.\",        \"slices\": [          \"Summary of payment file count by status, process type, payment system, acknowledgement state, or grouping rule.\",          \"Payment-file detail including file reference, status, process type, format, payment system, process profile, creation date, transmission date, payments created or confirmed, acknowledgement or inbound-file status, error details, related PPR, and grouping rules.\",          \"Child payment list for the payments contained in the file when available.\"        ]      },      \"promptInstruction\": \"1. Use Disbursement Payment Instructions BV or the payment-file object as the root source. 2. Treat 'payment file', 'payment instruction', 'grouping criteria', 'file status', acknowledgement, file totals, or file-processing questions as this intent. 3. For waiting-for-file-processing questions, inspect payment-file-build stage and file status together, and distinguish between a file that exists but is waiting processing versus a PPR where file creation was not selected or has not started if the data exposes that difference. 4. For direct field questions such as creation date, counts, acknowledgement state, or profile and bank-account context, answer that field first and then provide the surrounding file context. 5. Explain grouping criteria in business terms rather than only returning the raw configuration string. 6. Distinguish electronic versus printed processing when the data exposes that difference. 7. If the user asks which payments are in the file or which items failed, add the child payment list when available.\\n\\nShape selection guidance for common user requests:\\nUse these examples as routing hints for this intent. When the user request matches one of these patterns, prefer the listed shape or shape family before planning the query. Keep the normal clarification, filtering, and response rules for this intent in force; do not expose these internal routing hints to the user.\\n- For requests like Payment file format for a particular payment; service level codes and delivery channels, prefer disbursementPayments.\",      \"summarizationGuidelines\": \"State file status first and explain why that status matters operationally. If the question is about grouping criteria, lead with the business explanation of the grouping rule instead of the raw field value. For failed or unacknowledged files, summarize the operational impact before listing detail. For waiting-for-file-creation questions, clearly say whether the visible issue is file-processing delay or missing file creation.\",      \"recommendationGuidelines\": \"Recommend reviewing the payments inside the file, checking the file-processing configuration, following up on transmission, acknowledgement, or printing status, or drilling from the file to related payments for more detail. If file creation was not selected, recommend reviewing the PPR processing options before continuing.\",      \"clarification\": {        \"rules\": [          {            \"when\": \"The user asks about a payment file without identifying a file reference or without clear PPR context.\",            \"question\": \"Which payment file or PPR should I use to look up the file details?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"paymentFileStatusSummary\",              \"description\": \"Use when the user wants the file-status or acknowledgement picture first.\",              \"title\": \"Payment file summary\",              \"columns\": [                \"Payment File Status\",                \"File Count\",                \"Payments Created\",                \"Payments Confirmed\",                \"Acknowledgement Or Inbound Status\"              ]            },            {              \"key\": \"paymentFileGroupingSummary\",              \"description\": \"Use when the user asks how the file was grouped or wants to compare file-building logic across runs.\",              \"title\": \"Payment file grouping summary\",              \"columns\": [                \"Payment File Reference\",                \"Grouping Rule\",                \"Payments Created\",                \"Related PPR\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"paymentFileDetails\",              \"description\": \"Use for the main file-level detail view.\",              \"title\": \"Payment file details\",              \"columns\": [                \"Payment File Reference\",                \"Status\",                \"Process Type\",                \"Format Name\",                \"Payment System\",                \"Payment Process Profile\",                \"Creation Date\",                \"Transmission Date\",                \"Inbound File Status\",                \"Payments Created\",                \"Payments Confirmed\",                \"Related PPR\"              ]            },            {              \"key\": \"paymentFilePayments\",              \"description\": \"Use when the user asks which payments are contained in the file or wants the child payment list behind the file.\",              \"title\": \"Payments in payment file\",              \"columns\": [                \"Payment File Reference\",                \"Payment Reference\",                \"Payee\",                \"Payment Amount\",                \"Payment Method\",                \"Payment Status\"              ]            }          ]        }      },      \"additionalInstructions\": \"If the user asks invoice-level questions from a file, go through related payments first instead of skipping directly to documents.\"    },    {      \"key\": \"payablesPPR.rejectedInstallmentsInquiry\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"parentSkillKey\": \"payablesPPR.reviewPaymentProcessRequests\",      \"name\": \"Review PPR rejected installments\",      \"intentDomainKnowledge\": \"Rejected installments are document-payable or invoice-installment rows that reached the PPR or payment-run pipeline but were rejected during document validation or installment-level processing. The core answer is the rejection reason attached to each affected installment, usually exposed through Payables Document Payables, Document Validation Errors, or Payment Run Installment Exceptions. Payment-level rejections that happen after installments are grouped into payments belong to payment execution exception review.\",      \"description\": \"User wants to see which installments were rejected within a PPR, why each was rejected, which suppliers and invoices are affected, what payment value is delayed, and what setup or data correction would allow the installment to be included in a future run.\",      \"nlpExamples\": [        \"Show me all rejected installments for PPR XYZ and the reason for each\",        \"Which installments were excluded from today's run because of bank account errors?\",        \"What is the total value of installments rejected due to validation holds?\"      ],      \"data\": {        \"goal\": \"Give the user a row-level rejected-installment view for a PPR, with business-friendly rejection reasons, supplier and invoice context, impacted payment value, and practical remediation guidance.\",        \"slices\": [          \"Summary of rejected installment count and impacted amount by rejection reason, supplier or payee, payment currency, and PPR. Use `paymentRunExceptionsSummaries` for grouped exception-message summaries, especially bank-account exclusion questions.\",          \"Detail list of rejected installments with PPR, supplier or payee, invoice reference, installment number, due date, amount, document status, rejection reason, and validation error detail.\",          \"Optional actionability slice that separates data/setup corrections from payment-level failures when the returned reason supports that distinction.\"        ]      },      \"promptInstruction\": \"1. Use this intent when the user asks for rejected installments, excluded installments, document-payable rejections, or document-level rows inside a PPR with a rejected or FAILED_BY_* document-payable status. 2. For questions like 'Which installments were excluded from today's run because of bank account errors?', use `paymentRunExceptionsSummaries` first, group by `exceptionReasonHierarchy.errorMessage`, and filter error messages for bank account wording. Drill into `paymentRunInstallments` or `paymentRunInstallmentExceptions` only when the user needs row-level invoice, supplier, due-date, or installment evidence. 3. Do not use this intent for broad 'stuck because of failure' or 'validation failure' wording unless the user explicitly asks for rejected installments or the available status is a rejected document-payable status. 4. Prefer paymentRunInstallments for row-level installment detail such as document status, supplier/payee, invoice/installment context, amount, payment method, payment profile, and bank-account context. 5. Use documentValidationErrors, paymentRunInstallmentExceptions, or paymentRunExceptionsSummaries when the user asks for grouped rejection reasons, validation-error summaries, attached validation reasons, or PPRs pending document-validation review. 6. Require a PPR, current run, or date scope; if the user only says rejected installments without a scope, ask which PPR or payment run to review. 7. For rejected document-payable rows, apply PPR filters first, then use documentPayableStatus.lookupCode in ('REJECTED','FAILED_BY_CALLING_APP','FAILED_BY_REJECTION_LEVEL','FAILED_BY_RELATED_DOCUMENT') when that field is available. 8. When reading attached errors, keep disbursementPaymentTransactionErrors.transactionType at the document-payable level and keep multiple error messages for the same installment together in one business-facing reason. 9. Count distinct rejected business installments by invoice id and installment number when those fields are available; otherwise count distinct documentPayableId. Do not count raw validation-error rows as rejected installments. 10. Use amountToBePaid and paymentCurrencyCode for impacted payment value. 11. Route selected-installment review to payablesPPR.selectedInstallmentsInquiry, unselected rows that never entered the run to payablesPPR.selectionExceptionsInquiry, generic validation-failure or stuck-failure rows to payablesPPR.documentValidationExceptionsInquiry, and payment-level rejected payments to payablesPayments.executionExceptionsInquiry.\",      \"summarizationGuidelines\": \"Lead with the number of rejected installments, the impacted amount by currency, and the dominant rejection reason. For supplier concentration questions, show which suppliers or payees carry the most rejected installments and payment value. For detail questions, answer the rejection reason in business language before showing row-level evidence.\",      \"recommendationGuidelines\": \"Recommend resolving the highest-value or highest-frequency rejection reason first, prioritizing overdue or time-sensitive installments, correcting missing bank-account or supplier setup where visible, and resubmitting only the corrected installments in a future run when the data supports that path.\",      \"clarification\": {        \"rules\": [          {            \"when\": \"The user asks for rejected installments without identifying a PPR, current run, or date scope.\",            \"question\": \"Which PPR or payment run should I review for rejected installments?\"          },          {            \"when\": \"The user asks what was rejected but does not say whether they mean installments or payments.\",            \"question\": \"Should I review rejected installments or rejected payments?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"rejectedInstallmentsSummary\",              \"description\": \"Default table for rejected-installment review when the user wants counts and value at risk.\",              \"title\": \"Rejected installments summary\",              \"columns\": [                \"Rejection Reason\",                \"Rejected Installments\",                \"Impacted Amount\",                \"Payment Currency\"              ]            },            {              \"key\": \"rejectedInstallmentsBySupplier\",              \"description\": \"Use when the user asks which suppliers or payees have the most rejected installments.\",              \"title\": \"Rejected installments by supplier\",              \"columns\": [                \"Supplier Or Payee\",                \"Rejected Installments\",                \"Dominant Rejection Reason\",                \"Impacted Amount\",                \"Payment Currency\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"rejectedInstallmentDetails\",              \"description\": \"Use when the user asks to list, show, or drill into rejected installment rows.\",              \"title\": \"Rejected installments\",              \"columns\": [                \"PPR Name\",                \"Supplier Or Payee\",                \"Invoice Number\",                \"Installment Number\",                \"Due Date\",                \"Amount To Be Paid\",                \"Payment Currency\",                \"Document Status\",                \"Rejection Reason\",                \"Validation Error Details\"              ]            }          ]        }      },      \"additionalInstructions\": \"Keep this intent focused on installment and document-level rejections. Use rejected group id, rejected document-payable status, and document-payable validation errors when available. For bank-account exclusion summaries, use `paymentRunExceptionsSummaries`, group by exception message, and apply a bank-account message filter before row-level drill-down. Do not merge payment-level rejections into this answer after installments have been grouped into payments. Treat rejection as narrower than stuck or failed: generic failure language belongs to validation-exception review unless the user or status explicitly indicates rejected rows.\"    },    {      \"key\": \"ppr.reviewHistoricalCashflowTrendsForPaymentRuns\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"name\": \"Review Historical Cashflow Trends for Payment Runs\",      \"intentDomainKnowledge\": \"Once a PPR completes and payments are processed, the resulting payment data is captured in the Invoice Payments Summary. This shape records the actual disbursed amounts, payees, payment dates, currencies, business units, payment methods, and bank accounts for completed transactions. Historical cashflow analysis operates entirely on this completed payment data - it does not touch active runs, upcoming installments, or payment file processing stages. The primary use cases for this skill are: total outflow analysis for a given period broken down by date, currency, business unit, or payment method; supplier concentration analysis to understand which payees represent the bulk of disbursement value over a period - commonly used for the Pareto or 80-20 view of supplier spend; payment history for a specific supplier to understand the cadence, amounts, and trends of payments made to them over time; and period-over-period comparison of outflow to detect anomalies, seasonal patterns, or significant changes in disbursement volume. This skill is strictly retrospective. It does not cover upcoming payment schedules, active PPR run status, or payment file outcomes. All data returned reflects completed and processed payments only.\",      \"description\": \"Surfaces historical payment run data to show total payment values, supplier concentration, and outflow patterns over a given period - enabling trend awareness and period-over-period benchmarking. Use when the user wants to understand past payment behaviour: how much was paid, to which suppliers, in which currencies, and how outflow patterns have shifted across time.\",      \"nlpExamples\": [        \"Show me yesterday's total payment value breakdown by supplier and currency.\",        \"Show me the payment history for Supplier Y over the last 30 days.\",        \"Which suppliers represent 80% of the total payment value this month?\"      ],      \"data\": {        \"goal\": \"Your job when using this skill is to help the user understand past payment behaviour - total outflow by period, supplier, currency, or method - so they can identify concentration risks, detect anomalies, benchmark against prior periods, and make informed decisions about upcoming payment planning.\",        \"slices\": [          \"Primary shape: Invoice Payments Summary.\",          \"Total outflow query: fetch Invoice Payments Summary filtered to the user's specified date range; aggregate total payment value; group by the user's requested dimension - date, business unit, payment method, currency, or bank account.\",          \"Supplier concentration query: fetch Invoice Payments Summary filtered to the date range; group by supplier; rank by total payment value descending; compute each supplier's percentage of the overall period total; identify the cumulative threshold - for example, the suppliers that together represent 80% of total value.\",          \"Supplier payment history query: fetch Invoice Payments Summary filtered to the named supplier and date range; present payment-by-payment detail with dates, amounts, currencies, and payment references.\",          \"Period-over-period benchmarking query: fetch Invoice Payments Summary for two date ranges - the current period and the comparison period; aggregate totals for each; compute the variance in absolute and percentage terms.\",          \"Pareto concentration query: fetch Invoice Payments Summary for the stated period; rank all suppliers by total payment value; identify the minimum set of suppliers whose combined value reaches the stated threshold percentage of total outflow. Do not fetch upcoming installment schedules, active PPR run data, or payment file data - those are handled by separate skills.\"        ]      },      \"promptInstruction\": \"Identify the historical query type first - total outflow, supplier concentration, supplier payment history, period-over-period benchmarking, or Pareto analysis - then plan the data slices accordingly. For total outflow queries: filter the Invoice Payments Summary to the stated date range; aggregate and group by the user's requested dimension; if no grouping dimension is stated, default to grouping by date and currency and state the assumption. For supplier concentration queries: filter to the stated date range; rank all suppliers by total payment value descending; compute running cumulative percentage; surface the top suppliers up to the user's stated threshold or default to top 10 if no threshold is specified. For supplier payment history queries: filter to the named supplier and stated date range; present each payment with date, amount, currency, payment reference, and business unit; include a summary total at the end. For period-over-period benchmarking queries: apply the same aggregation logic to both periods; present side by side with the delta in absolute value and percentage terms; label periods clearly using the user's stated timeframes. For Pareto concentration queries: rank all suppliers by payment value for the period; compute cumulative percentage; identify the cut-off point at the user's stated threshold - default to 80% if not specified - and list the suppliers that fall within that threshold. Always apply a date range filter. If no date range is stated by the user, apply the User Clarification rule. Do not retrieve upcoming installment data, active PPR run status, or payment file outcomes. If the user's query blends historical data with a forward-looking question, handle the historical portion here and signal that the forward-looking portion requires the Review Upcoming Schedules skill.\",      \"summarizationGuidelines\": \"Always open with a direct headline answer - for example the total disbursement value for the stated period, the number of suppliers representing 80% of outflow, or the payment total for the named supplier - before presenting detailed data. Keep the opening summary to around 80 to 100 words. For total outflow responses: follow the summary with a breakdown table using the user's requested grouping dimension. Include an overall total row at the bottom. For supplier concentration responses: present a ranked table with columns Rank, Supplier Name, Total Payment Value, Percentage of Period Total, and Cumulative Percentage. Add a clearly labelled dividing line at the point where the cumulative threshold is reached - for example a row indicating that the above suppliers represent 80% of total outflow. For supplier payment history responses: present a detail table with columns Payment Date, Payment Reference, Amount, Currency, Business Unit. Include a summary row at the bottom with the total value and count of payments over the period. For period-over-period responses: present a side-by-side comparison table with columns Period, Total Payment Value, and Variance. Include both absolute and percentage variance. Highlight whether the current period is above or below the comparison period. For Pareto responses: present the ranked supplier table up to the threshold cut-off and state clearly how many suppliers account for the threshold percentage, with the residual supplier count and value below the line. Use business-friendly labels throughout. Avoid raw system codes or internal field identifiers.\",      \"recommendationGuidelines\": \"Generate 2 to 3 targeted next steps based on the historical analysis finding. Start each recommendation with a verb. For high supplier concentration identified: \\\"Review whether the concentration of disbursement value in a small number of suppliers is within your payment risk policy - consider whether any single-supplier dependency warrants a contingency review. For significant period-over-period increase: \\\"Investigate the drivers behind the increase in outflow versus the prior period - cross-reference with PPR submissions and any one-off or high-value payments in the current period. For significant period-over-period decrease: \\\"Confirm that the lower outflow versus the prior period reflects expected payment timing rather than missed or delayed runs - check for any installments that were due but not processed. For supplier payment history showing irregular cadence: \\\"Review the payment cadence for Supplier [Name] - gaps or spikes in the payment history may indicate missed runs, holds, or batching changes that warrant follow-up. For Pareto result showing few suppliers dominating outflow: \\\"Consider whether the top [N] suppliers representing [X]% of outflow have adequate payment controls and bank account validation in place given their disbursement concentration. For clean period with no anomalies: \\\"No significant anomalies detected in the outflow for this period - the trend is consistent with prior periods. Do not recommend changes to supplier setup or payment configurations directly - provide the analytical finding and the navigational guidance only.\",      \"parentSkillKey\": \"ppr.reviewPPRTemplatesAndSchedules\",      \"clarification\": {        \"rules\": [          {            \"when\": \"if the user asks about historical cashflow without specifying a date range, For example, yesterday, the last 7 days, the last 30 days, or a specific date range. Do not default silently - date range is required for all historical queries.\",            \"question\": \"Which time period would you like me to cover?\"          },          {            \"when\": \"if the user asks to compare outflow versus a prior period without specifying what the comparison period is,\",            \"question\": \"Which period would you like to compare against - for example, the same period last month, last week's average, or a specific date range?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"paymentMixSummary\",              \"description\": \"Use for the general grouped payment-value and stage-mix view.\",              \"title\": \"Payment summary\",              \"columns\": [                \"Grouping Value\",                \"Payment Stage\",                \"Payment Count\",                \"Total Payment Value\"              ]            },            {              \"key\": \"paymentTaxAndDiscountSummary\",              \"description\": \"Use when the user asks specifically about taxes withheld, discounts captured, or invoice-level savings.\",              \"title\": \"Tax and discount summary\",              \"columns\": [                \"Summary Topic\",                \"Impacted Items\",                \"Total Value\",                \"Operational Signal\"              ]            },            {              \"key\": \"paymentHistorySummary\",              \"description\": \"Use when the user asks for supplier history or a recent-period payment snapshot.\",              \"title\": \"Supplier or period payment history summary\",              \"columns\": [                \"Supplier Or Period\",                \"Payment Count\",                \"Total Payment Value\",                \"Dominant Method Or Currency\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"paymentSummaryDetails\",              \"description\": \"Use for the main payment list behind the grouped summary.\",              \"title\": \"Payments in scope\",              \"columns\": [                \"Payment Date\",                \"Payment Reference\",                \"Supplier Or Payee\",                \"Payment Method\",                \"Currency\",                \"Payment Value\",                \"Payment Status\",                \"Business Unit\"              ]            },            {              \"key\": \"paymentCoverageOrSavingsDetails\",              \"description\": \"Use when the user asks for invoice coverage, discount capture, or tax-withholding detail rather than only payment headers.\",              \"title\": \"Invoice, tax, or discount detail in scope\",              \"columns\": [                \"Payment Reference\",                \"Supplier Or Payee\",                \"Invoice Reference\",                \"Discount Or Tax Context\",                \"Amount\"              ]            }          ]        }      },      \"additionalInstructions\": \"Total outflow breakdown: summary table with the user's requested grouping dimension in the left column and Total Payment Value, Number of Payments, and Date Range in subsequent columns. Include an overall total row at the bottom. Supplier concentration table: ranked table with columns Rank, Supplier Name, Total Payment Value, Percentage of Period Total, Cumulative Percentage. Draw a visible dividing line at the concentration threshold cut-off row. Supplier payment history: detail table with columns Payment Date, Payment Reference, Amount, Currency, Business Unit. Summary row at the bottom with total count and total value. Period-over-period comparison: side-by-side table with columns Period Label, Total Payment Value, Variance (Absolute), Variance (Percentage). Highlight the variance column - use positive or negative indicators clearly. Pareto result: same format as the supplier concentration table with an explicit threshold cut-off line and a summary below the line showing the remaining supplier count and their combined value. All outputs: precede the table with a 1 to 2 sentence plain-language headline of the key finding. Use currency formatting consistent with the ledger currency of the relevant business unit. Avoid raw system codes or internal field identifiers in all displayed values. For multi-currency results, include both the local currency amount and the functional currency equivalent where conversion data is available.\"    },    {      \"key\": \"ppr.reviewPPRDocumentValidationErrors\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"name\": \"Review PPR Document Validation Errors\",      \"intentDomainKnowledge\": \"After a PPR completes installment selection and conversion rate checks it enters document validation. At this stage Oracle Payables validates each selected document against a set of business rules and setup requirements before it can be grouped into a proposed payment. Document validation errors are distinct from missing attribute errors - where required setup data simply does not exist - and from payment validation errors - which occur after documents have been grouped into proposed payments. Document validation errors arise when the data exists but fails a business rule. The most common document validation error types are: invoice approval holds where the invoice has not completed its approval workflow and cannot be paid until approved; duplicate payment flags where the system has identified a potential duplicate invoice and placed a hold pending manual review; vendor holds where the supplier site has an active payment hold preventing all payments to that supplier; budget or funds check failures where the invoice fails a budgetary control check; tax holds where a tax calculation issue prevents the document from proceeding; and payment process profile mismatches where the document's attributes do not match the rules defined in the assigned payment process profile. Each document validation error blocks only the specific document it is raised against - other documents in the same PPR are unaffected and can proceed. The user's decision at this stage is whether to resolve each error - for example by releasing a hold or approving an invoice - or to remove the failing document from the current run and address it separately. The total value of blocked documents relative to the effort required to resolve each error type is the key triage consideration. This skill is strictly scoped to document-level validation errors. It does not cover missing attributes - those are handled by the Review PPR Missing Attributes skill - payment-level validation errors - those are handled by the Review PPR Payment Validation Errors skill - or installment selection issues.\",      \"description\": \"User wants an aggregate and drill-down view of document-validation or payment-validation exceptions blocking PPRs.\",      \"nlpExamples\": [        \"What are all the installments that are stuck because of failure\",        \"What are the PPRs stuck because of document validation failure\",        \"What's the document rejection level set to for PPR gapr_ppr_test_4\",        \"Diagnose document validation errors for pending PPRs to identify missing setup\"      ],      \"data\": {        \"goal\": \"Your job when using this skill is to help the user identify every document failing validation in a specific PPR, understand precisely what rule or condition caused each failure, determine whether the failure is resolvable within the current run or requires the document to be deferred, and prioritise resolution by blocked value - so the PPR can proceed to payment validation with the minimum delay and maximum value recovered.\",        \"slices\": [          \"Primary shapes: paymentRunInstallmentExceptions for document-validation PPR/detail lists; paymentRunInstallmentExceptionsExtraction for grouped, count, or trend analysis; paymentRunInstallments only for broad stuck-installment details that are not specifically document-validation PPR lists.\",          \"Mandatory broad stuck-installment plan: for 'What are all the installments that are stuck because of failure' and paraphrases, always plan both independent slices. The summary slice uses paymentRunInstallmentsExtraction and groups installment count by failure type/PPR Status; the detail slice uses paymentRunInstallments. A detail-only plan is invalid for this request.\",          \"Document validation error summary query: fetch Payment Run Installment Exceptions for the named PPR filtered to document-level validation error types; group by error type category - approval hold, duplicate payment hold, vendor hold, budgetary control failure, tax hold, payment process profile mismatch, and other document rule failures; aggregate affected document count and total blocked value per error type; rank by total blocked value descending.\",          \"Affected document detail query: fetch Payment Run Installments joined with Payment Run Installment Exceptions for the named PPR filtered to documents with a validation error; surface invoice reference, supplier, installment amount, error type, error reason, hold name if applicable, and whether the error is resolvable within the current run.\",          \"Specific invoice query: fetch Payment Run Installment Exceptions filtered to the named invoice reference; return the full error detail for that invoice - error type, error reason, the specific rule or condition that triggered it, and the resolution steps.\",          \"Supplier specific query: fetch Payment Run Installment Exceptions grouped by supplier for the named PPR; aggregate error count and blocked value per supplier; identify whether a supplier has multiple documents failing the same error type - a signal that a supplier-level correction will resolve multiple documents simultaneously.\",          \"Error type resolvability classification query: classify each error type present in the PPR by resolution path - resolvable within current run by the payments team such as releasing a manual hold, requires approver action such as approving an invoice, requires IT or configuration change such as fixing a payment process profile mismatch, or requires deferral to a future run; aggregate total recoverable value per resolution path.\",          \"Cross-PPR document validation query: fetch Payment Run Installment Exceptions across all active PPRs filtered to document validation error types and the \\\"Pending action to address document validation errors\\\" status; group by PPR and error type; rank by total blocked value descending. Do not fetch missing attribute exceptions, payment validation errors, conversion rate exceptions, or payment file data - those are handled by separate skills.\"        ]      },      \"promptInstruction\": \"1. Treat 'exceptions', 'stuck in failure', and 'validation failures' as this intent unless the user is clearly asking about missing rates, missing attributes, payment-file failures, or a row-level list of rejected installments. 2. For exact and paraphrased requests asking what or which PPRs are stuck because of document validation failure, use the paymentRunInstallmentExceptions BV/detail shape, not paymentRunExceptionsSummaries. Return the locked document-validation PPR fields, apply payablesDocumentPayable.paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode = 'PENDING_REVIEW_DOC_VAL_ERRORS', sort by payablesDocumentPayable.amountToBePaid:desc, and limit 20 unless the user explicitly asks for another limit. 3. When the user adds supported filters such as PPR name/id, date range, supplier, business unit, currency, amount, or error text, add those filters in addition to the required document-validation status filter. Do not drop the required status filter. 4. Use paymentRunInstallmentExceptionsExtraction for grouped, count, trend, or concentration analysis over document-validation exceptions, including grouping by PPR, error type, supplier, or business unit when the selected shape exposes those dimensions. 5. Mandatory planning invariant: for 'What are all the installments that are stuck because of failure' and paraphrases, always return exactly the two required independent slices: first a paymentRunInstallmentsExtraction summary grouped by failure type/PPR Status with installment count, then paymentRunInstallments detail rows. Never return detail without the summary for this broad stuck/failure request; a detail-only plan is invalid and must be revised before output. Use PPR Status as the failure type; if a payment-file status is the only visible blocker, use that status as the failure type for the summary only. 6. For the broad stuck-installment detail table, keep visible columns limited to PPR Name, PPR Status, Payment File Status, Invoice Number, Installment Number, Amount, Payment Currency, and Due Date; include Payment File Status because payment-file failure statuses are part of the stuck-condition OR filter and may be the blocker. Do not include source reference, document payable id, supplier/payee, validation error, or payment setup columns unless the user explicitly asks for them. If PPR Name is returned, also return PPR ID and supported PPR status-code helper fields as non-visible deeplink support fields so the response enricher can build PPR links and remove those helper fields from the displayed table. If Payment File Status is returned, also return the payment-file status-code helper when available, but do not treat it as a displayed business column. 7. Enrich paymentRunInstallments rows with paymentRunInstallmentExceptions or documentValidationErrors only when the user needs validation error code, validation error message, or status reason detail. 8. Group by validation error first only for validation-error review questions; for broad all-stuck-installment questions, group by failure type/PPR Status first. 9. For trend or concentration questions, add a second grouping by supplier or business unit only when the chosen shapes expose those dimensions. 10. If the detail path exposes multiple validation errors for one record, keep those error texts together in one business-facing detail cell rather than scattering them across repeated rows. 11. When the user asks what should be fixed first, prioritize overdue, high-value, or high-priority items and make the delayed-value impact explicit. 12. If the user asks for specific rejected installments and the reason for each, route to ppr.reviewPPRRejectedInstallments. 13. If the user asks for document rejection level or another configuration value that is not exposed in the chosen path, return the visible validation pattern first and state the limitation clearly.\\n\\nShape selection guidance for common user requests:\\nUse these examples as routing hints for this intent. When the user request matches one of these patterns, prefer the listed shape or shape family before planning the query. Keep the normal clarification, filtering, and response rules for this intent in force; do not expose these internal routing hints to the user.\\n- For requests like What are the PPRs stuck because of document validation failure, Which PPRs are stuck due to document validation errors, or PPRs pending action for document validation errors, prefer paymentRunInstallmentExceptions BV.\\n- For grouped or aggregate requests about document-validation failures across PPRs, prefer paymentRunInstallmentExceptionsExtraction.\\n- For requests like What are all the installments stuck because of failure, always plan paymentRunInstallmentsExtraction for the failure-type count summary and paymentRunInstallments for the stuck-installment detail rows; both steps are mandatory.\\n- For requests like Document rejection level for a PPR, prefer paymentRunCriteria.\\n- Do not use paymentRunExceptionsSummaries for the document-validation PPR detail-list wording; that AV is only for separate validation-error summary triage intents where grouped blocked value/counts are requested.\",      \"summarizationGuidelines\": \"Always open with a direct headline answer - for example the total count and value of documents failing validation in the PPR and the dominant error type - before presenting detailed data. Keep the opening summary to around 80 to 100 words. For cross-PPR summary responses: present a table with columns PPR Name, PPR Status, Dominant Error Type, Affected Document Count, Total Blocked Value. Rank by Total Blocked Value descending. Include a total row. For single PPR error summary responses: present an error type summary table first with columns Error Type Category, Affected Document Count, Total Blocked Value, Resolvable By. Follow with the affected document detail table grouped by error type. For affected document detail responses: present a table with columns Invoice Reference, Supplier, Installment Amount, Error Type, Error Reason, Resolvable In Current Run. Group by Error Type with a subtotal row per group. Flag rows where the error is resolvable within the current run by the payments team. For specific invoice responses: present the error detail in a structured two-column card format - rows for Invoice Reference, Supplier, Installment Amount, Error Type, Error Reason in plain language, What Triggered It, Resolution Steps in order. For supplier specific responses: open with a supplier-level summary of total blocked count and value; follow with a detail table showing Invoice Reference, Installment Amount, Error Type, Error Reason per document; include a note where a single supplier-level correction will resolve multiple documents. For resolvability classification responses: present a four-path table with columns Resolution Path, Error Types Included, Affected Document Count, Total Recoverable Value. Paths: Payments Team Self-Service, Requires Approver Action, Requires IT or Configuration Change, Defer to Future Run. Highlight the Payments Team Self-Service row as the recommended starting point. Always use plain-language error type labels. Avoid technical Oracle error codes in user-facing content unless the user specifically asks for them.\",      \"recommendationGuidelines\": \"Generate 2 to 3 targeted next steps based on the document validation error finding. Start each recommendation with a verb. For approval hold errors: \\\"Release the approval holds on the [N] invoices blocked by the approval workflow - contact the relevant approvers or escalate through the invoice approval workflow to unblock [value]. For duplicate payment holds: \\\"Review the [N] invoices flagged as potential duplicates - validate whether each is a genuine duplicate before releasing the hold; genuine duplicates should be cancelled rather than released. For vendor holds: \\\"Resolve the vendor hold on Supplier [Name] in the Manage Suppliers page - all [N] invoices for this supplier are blocked and will remain blocked in any run until the hold is released. For budgetary control failures: \\\"Review the budgetary control failure for the affected invoices - a funds check failure may require a budget adjustment or a budget override approval before the invoices can be paid. For payment process profile mismatches: \\\"Investigate the payment process profile mismatch for the affected documents - this is likely a configuration issue requiring IT involvement to align the document attributes with the assigned profile rules. For a mix of error types with a clear quick-win tier: \\\"Address the [N] payments team self-service errors first - releasing the manual holds and correcting the data errors will recover [value] without requiring approver or IT involvement. Escalate the remaining [error types] in parallel. For supplier concentration identified: \\\"Resolve the errors for Supplier [Name] first - a single supplier-level correction will unblock [N] documents totalling [value] simultaneously. Route to the appropriate stage-specific skill for any error type that requires deeper diagnosis. Do not recommend executing hold releases or configuration changes directly - provide the analytical finding and the navigational path only.\",      \"parentSkillKey\": \"ppr.findPaymentProcessRequests\",      \"clarification\": {        \"rules\": [          {            \"when\": \"if the user asks about document validation errors without naming a specific PPR, check whether multiple PPRs are at the document validation error status; if so present the cross-PPR summary. If the user is seeking for All PPR, then allow that.eg: What are the PPRs or All PPR etc\",            \"question\": \"Which Payment Process Request would you like me to investigate in detail?\"          },          {            \"when\": \"if the user asks why a specific invoice is failing without providing the invoice reference,\",            \"question\": \"Could you provide the invoice reference number so I can identify the specific document validation error?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"stuckInstallmentsFailureTypeSummary\",              \"description\": \"Use for broad questions asking for all installments stuck because of failure.\",              \"title\": \"Installments stuck by failure type\",              \"columns\": [                \"Failure Type\",                \"Installment Count\"              ]            },            {              \"key\": \"pprValidationErrorSummary\",              \"description\": \"Use when the user wants the main grouped picture of validation failures across PPRs.\",              \"title\": \"PPR validation exceptions summary\",              \"columns\": [                \"Validation Error Message\",                \"Affected PPRs\",                \"Impacted Amount\"              ]            },            {              \"key\": \"pprValidationConcentrationSummary\",              \"description\": \"Use when the user asks whether validation failures are concentrated with specific suppliers or business units.\",              \"title\": \"Validation concentration summary\",              \"columns\": [                \"Supplier Or Business Unit\",                \"Dominant Validation Error\",                \"Impacted Amount\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"stuckInstallmentDetails\",              \"description\": \"Use for broad questions asking for the specific installments stuck because of failure.\",              \"title\": \"Stuck installment details\",              \"columns\": [                \"PPR Name\",                \"PPR Status\",                \"Payment File Status\",                \"Invoice Number\",                \"Installment Number\",                \"Amount\",                \"Payment Currency\",                \"Due Date\"              ]            },            {              \"key\": \"pprValidationExceptionDetails\",              \"description\": \"Use when the user wants the specific rows behind the grouped validation failures.\",              \"title\": \"Validation exception details\",              \"columns\": [                \"PPR Name\",                \"Invoice Number\",                \"Installment Number\",                \"Source Reference Number\",                \"Document Payable ID\",                \"Validation Error\",                \"Supplier Or Payee\",                \"Business Unit\",                \"Due Date\",                \"Amount\",                \"Payment Currency\",                \"Priority Or Overdue Indicator\"              ]            },            {              \"key\": \"pprValidationDelayedValueImpact\",              \"description\": \"Use when the user asks how much value remains delayed if a subset of rows cannot be resolved.\",              \"title\": \"Delayed-value impact scenario\",              \"columns\": [                \"Scenario Scope\",                \"Unresolved Rows\",                \"Delayed Amount\",                \"Affected Suppliers\"              ]            }          ]        }      },      \"additionalInstructions\": \"Keep validation-exception review separate from missing-rate and missing-attribute intents. For generic stuck/failure installment wording, do not route to selected-installment review or rejected-installment review unless the user explicitly says selected or rejected. For the broad all-installments stuck/failure request, the summary and detail are an atomic planning pair: always include paymentRunInstallmentsExtraction for the failure-type/PPR Status installment-count summary and paymentRunInstallments for row details. Never emit only the detail slice. Keep the visible detail output limited to PPR Name, PPR Status, Payment File Status, Invoice Number, Installment Number, Amount, Payment Currency, and Due Date unless the user asks for error details. Payment File Status is required because payment-file failure statuses are part of the stuck-condition OR filter. When the detail output includes PPR Name, include PPR ID and supported PPR status-code helper fields in the query result for deeplink enrichment, but do not treat those helper fields as displayed business columns. When the detail output includes Payment File Status, include the payment-file status-code helper when available, but do not treat it as a displayed business column. Use paymentRunInstallmentExceptions or documentValidationErrors as enrichment shapes only when visible validation error context is needed. If the user already knows the specific failure type, route to ppr.analyzePPRExceptions. For document-validation PPR detail-list wording, keep the status filter on payablesDocumentPayable.paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode and do not route to paymentRunExceptionsSummaries.\"    },    {      \"key\": \"ppr.reviewPPRInFlightPayments\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"name\": \"Review PPR In-Flight Payments\",      \"intentDomainKnowledge\": \"Once a PPR passes proposed payment review and the payment file build is triggered the run enters an active processing state. Payments move from proposed to in-flight - they are being formatted, transmitted, or printed depending on the payment method and processing type. At this stage the payments team needs real-time visibility of what is actually going out - not what was planned, but what is currently in motion. The in-flight view is distinct from the proposed payment view which reflects the pre-approval snapshot. In-flight payments reflect the live processing state and may differ from the proposed set if any payments were removed, failed validation at the file build stage, or are being processed in batches across multiple payment files. The key visibility needs at this stage are: total payment value and count currently in processing, broken down by payment method to understand the method mix; breakdown by disbursement bank account to understand which accounts are being drawn on and for how much; breakdown by business unit to support real-time cash management and reporting; breakdown by currency for multi-currency runs; and specific visibility of tax authority payments - which are often subject to strict remittance deadlines, jurisdiction-specific requirements, and regulatory scrutiny. Tax authority payments within a PPR require special attention because late or incorrect remittance carries regulatory penalties. The user needs to know which tax authorities are being paid, what the amounts are by jurisdiction, and how much of the total run is tax remittance versus supplier payments. This skill is strictly scoped to actively processing PPRs. It does not cover proposed payments awaiting approval - those are handled by Review PPR Proposed Payments. It does not cover historical completed payment analysis - that is handled by the historical cashflow skills.\",      \"description\": \"Provides a real-time summary of payments currently being processed within an active PPR - showing totals by payment method, business unit, bank account, currency, and payee type including tax authority payments and their remittance breakdown. Use when a PPR is actively processing and the user wants a live view of what is going out today without waiting for the run to complete.\",      \"nlpExamples\": [        \"Show me all tax authority payments in PPR BLR07-01\"      ],      \"data\": {        \"goal\": \"Your job when using this skill is to give the user an accurate real-time picture of what is currently going out in an active PPR - total values by method, bank, business unit, and currency, with special attention to tax authority payments and their jurisdiction breakdown - so the payments team can monitor the run in progress, confirm that tax remittances are correct, and escalate any anomalies before the run completes.\",        \"slices\": [          \"Primary shape: Payment Run Disbursement Payments filtered to actively processing PPR status.\",          \"Full in-flight summary query: fetch Payment Run Disbursement Payments for the active PPR; aggregate total payment count and value; break down by payment method, disbursement bank account, business unit, and currency in a single consolidated summary.\",          \"Payment method breakdown query: fetch Payment Run Disbursement Payments grouped by payment method; aggregate count and value per method; compute each method's percentage of run total.\",          \"Business unit breakdown query: fetch Payment Run Disbursement Payments grouped by business unit; aggregate count and value per business unit; include currency breakdown within each business unit where relevant.\",          \"Bank account breakdown query: fetch Payment Run Disbursement Payments grouped by disbursement bank account; aggregate count and total draw per bank account; surface account name, account currency, and total amount being drawn.\",          \"Currency breakdown query: fetch Payment Run Disbursement Payments grouped by payment currency; aggregate count and value per currency; include functional currency equivalent where conversion data is available.\",          \"Tax authority payment query: fetch Payment Run Disbursement Payments filtered to payee type of tax authority; surface each tax authority, jurisdiction, payment amount, payment method, and remittance reference; aggregate total tax remittance value across all jurisdictions; compute tax remittance as a percentage of total run value.\",          \"Payee type split query: fetch Payment Run Disbursement Payments grouped by payee type - supplier versus tax authority versus other; aggregate count and value per type; surface the split as both absolute values and percentages of run total.\",          \"Cross-PPR active run query: if the user asks about all payments going out today, fetch Payment Run Disbursement Payments across all active PPRs processing today; aggregate by PPR and dimension. Do not fetch proposed payments awaiting approval, historical completed payments, or payment file formatting detail - those are handled by separate skills.\"        ]      },      \"promptInstruction\": \"Identify the in-flight payment query type first - consolidated summary, payment method breakdown, business unit breakdown, bank account breakdown, currency breakdown, tax authority analysis, payee type split, or cross-PPR today view - then plan the data slices accordingly. Always confirm that the referenced PPR is in an active processing state before fetching in-flight data - if the PPR is at proposed payment review stage route to Review PPR Proposed Payments; if the PPR has completed route to the historical cashflow skills. For consolidated summary queries: aggregate Payment Run Disbursement Payments across all relevant dimensions simultaneously - method, bank, business unit, currency - and present as a multi-dimensional summary; lead with the total count and value then break down by each dimension. For payment method breakdown queries: group by payment method; aggregate count and value; compute percentage of run total per method; surface the method mix clearly so the user can see whether the run is predominantly EFT, wire, check, or other. For business unit breakdown queries: group by business unit; aggregate count and value; include currency breakdown within each business unit if the run is multi-currency and multi-BU; this supports real-time cash management reporting at the BU level. For bank account breakdown queries: group by disbursement bank account; aggregate count and total draw per account; surface account name and currency; flag any bank account being drawn on for more than 50% of the run total as a concentration point. For tax authority payment queries: filter to tax authority payee type; group by tax authority and jurisdiction; surface each authority with its payment amount, jurisdiction, and payment method; aggregate total tax remittance and compute as a percentage of run total; present jurisdiction-level detail to support remittance compliance verification. For payee type split queries: group by payee type; aggregate count and value per type; present as a simple split table with percentages. For cross-PPR today queries: fetch all active PPRs processing today; aggregate by PPR then by the user's requested dimension; present a consolidated view of all outgoing payments for the day. Apply the User Clarification rules if the PPR is not identified or is not in an active processing state. Do not retrieve proposed payment data, historical completed payment data, or payment file formatting detail.\\n\\nShape selection guidance for common user requests:\\nUse these examples as routing hints for this intent. When the user request matches one of these patterns, prefer the listed shape or shape family before planning the query. Keep the normal clarification, filtering, and response rules for this intent in force; do not expose these internal routing hints to the user.\\n- For requests like All tax authority payments in a PPR, prefer payablesPaymentDetails.\",      \"summarizationGuidelines\": \"Always open with a direct headline answer - for example the total count and value of payments currently in processing in the named PPR and the dominant payment method or bank - before presenting detailed data. Keep the opening summary to around 80 to 100 words. Include a real-time processing note stating that the figures reflect the current in-flight state and may update as the run progresses. For consolidated summary responses: present a multi-section summary - Section 1 run totals, Section 2 breakdown by payment method, Section 3 breakdown by bank account, Section 4 breakdown by currency; keep each section concise with a summary table per dimension. For payment method breakdown responses: present a table with columns Payment Method, Payment Count, Total Amount, Percentage of Run Total. Include a total row. For business unit breakdown responses: present a table with columns Business Unit, Payment Count, Total Amount, Currency if multi-currency. Include a total row. For bank account breakdown responses: present a table with columns Disbursement Bank Account, Account Currency, Payment Count, Total Amount Drawn, Percentage of Run Total. Flag any account exceeding 50% of run total. For currency breakdown responses: present a table with columns Payment Currency, Payment Count, Total Amount, Functional Currency Equivalent. Include a total row. For tax authority payment responses: present a two-section output - Section 1 tax remittance summary with total tax payments, total run value, and tax as a percentage of run; Section 2 jurisdiction detail table with columns Tax Authority, Jurisdiction, Payment Amount, Payment Method, Remittance Reference. For payee type split responses: present a simple split table with columns Payee Type, Payment Count, Total Amount, Percentage of Run Total. Always include the real-time processing caveat. Use business-friendly labels throughout. Avoid raw system codes or internal field identifiers.\",      \"recommendationGuidelines\": \"Generate 2 to 3 targeted next steps based on the in-flight payment finding. Start each recommendation with a verb. For tax authority payments identified with approaching remittance deadlines: \\\"Confirm that the tax authority payments in this run are correctly addressed and will reach the relevant jurisdictions by the remittance deadline - late tax remittance carries regulatory penalties that cannot be reversed. For high bank account concentration identified: \\\"Note that [Bank Account Name] is being drawn on for [N]% of the total run value - confirm that sufficient funds are available in this account to cover the full draw before the transmissions complete. For payments processing normally with no anomalies: \\\"No anomalies detected in the in-flight payment summary - the run is processing as expected. Monitor completion status and check the payment file outcomes once processing is complete. For a large run with tax remittance above expected levels: \\\"Review the tax remittance total of [amount] which represents [N]% of this run - confirm that the jurisdictions and amounts are correct before the payments complete, as tax remittance errors require a separate correction process. For cross-PPR today view showing multiple active runs: \\\"Monitor all [N] active runs processing today - the combined outflow of [total amount] is drawing on [N] bank accounts. Confirm that treasury is aware of the total daily draw to avoid any intraday liquidity surprises. For a payment method mix that appears inconsistent with expectations: \\\"Review the payment method breakdown - [N]% of this run is processing via [method] which may differ from the expected mix. Confirm this is correct before the files complete transmission. Do not recommend halting or recalling payments that are already in transmission - provide monitoring guidance and escalation paths only.\",      \"parentSkillKey\": \"ppr.findPaymentProcessRequests\",      \"clarification\": {        \"rules\": [          {            \"when\": \"if the user asks about in-flight payments without naming a specific PPR and multiple PPRs are actively processing, present a cross-PPR summary of all active runs for today and\",            \"question\": \"Which Payment Process Request would you like me to show in-flight payment detail for?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"inFlightPaymentsSummary\",              \"title\": \"In-flight payments summary\",              \"columns\": [                \"Grouping Value\",                \"Payment Count\",                \"Total Payment Value\",                \"Current Payment State\"              ]            },            {              \"key\": \"inFlightTaxRemittanceSummary\",              \"title\": \"Tax remittance in active run\",              \"columns\": [                \"Tax Authority Or Jurisdiction\",                \"Payment Count\",                \"Total Payment Value\",                \"Current State\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"inFlightPaymentsDetails\",              \"title\": \"Payments currently in flight\",              \"columns\": [                \"PPR Name\",                \"Payment Reference\",                \"Supplier Or Payee\",                \"Payment Method\",                \"Bank Account\",                \"Currency\",                \"Payment Amount\",                \"Current Payment State\"              ]            }          ]        }      },      \"additionalInstructions\": \"Consolidated summary output: four-section format - Section 1 Run Totals card with Total Payment Count and Total Payment Value; Section 2 Payment Method breakdown table with columns Method, Count, Amount, Percentage; Section 3 Bank Account breakdown table with columns Account Name, Currency, Count, Amount Drawn, Percentage; Section 4 Currency breakdown table with columns Currency, Count, Amount, Functional Equivalent. Each section has a subtotal or total row. Payment method breakdown table: columns Payment Method, Payment Count, Total Amount, Percentage of Run Total. Include a total row. Business unit breakdown table: columns Business Unit, Payment Count, Total Amount, Currency if applicable. Include a total row. Bank account breakdown table: columns Disbursement Bank Account, Account Currency, Payment Count, Total Amount Drawn, Percentage of Run Total. Flag accounts exceeding 50% of run total. Currency breakdown table: columns Payment Currency, Payment Count, Total Amount, Functional Currency Equivalent. Include a total row. Tax authority payment output: two-section format - Section 1 tax remittance summary card with Total Tax Payments, Total Run Value, Tax as Percentage of Run; Section 2 jurisdiction detail table with columns Tax Authority, Jurisdiction, Payment Amount, Payment Method, Remittance Reference. Payee type split table: columns Payee Type, Payment Count, Total Amount, Percentage of Run Total. Real-time processing caveat: include a plain-language note on every response stating that figures reflect the current in-flight processing state and may update as the run progresses. All outputs: precede the table with a 1 to 2 sentence plain-language headline of the key finding. Use currency formatting consistent with the ledger currency of the relevant business unit. Avoid raw system codes or internal field identifiers in all displayed values.\"    },    {      \"key\": \"ppr.reviewPPRMissingAttributes\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"name\": \"Review PPR Missing Attributes\",      \"intentDomainKnowledge\": \"After a PPR selects installments and passes the conversion rate check, it moves to the document validation stage. At this stage Oracle Payments must assign a disbursement bank account and a payment process profile to each document payable, since both are required for the document to proceed to a payment. If either cannot be assigned, the affected documents stop at the 'Pending action to complete information required' status and wait for the user to resolve the gap. This is distinct from a business-logic validation error, where the data exists but fails a rule (for example, a payment amount exceeding a bank limit); this skill is scoped strictly to documents that could not have a disbursement bank account or payment process profile assigned during derivation. Important: 'Missing Account' and 'Missing Profile' do not necessarily mean the setup is absent. Oracle Payments attempts to default both attributes automatically. For the disbursement bank account it calls Cash Management (CE_BANK_AND_ACCOUNT_UTIL.get_internal_bank_accts) with the document's Business Unit and payment Currency; if exactly one internal bank account is returned it defaults onto the document, but if more than one is returned it cannot disambiguate and sets the status to Missing Account. For the payment process profile it matches the document's Payment Method, Business Unit, Disbursement Bank Account, and Currency against profile usage rules; if exactly one profile matches it defaults, but if more than one matches it sets the status to Missing Profile. The most common cause of these statuses is therefore ambiguity - multiple valid candidates the system cannot choose between - rather than a complete absence of setup, although an absence would also prevent defaulting. The disbursement bank account here is the deploying company's own internal account from which funds are paid, not the supplier's (payee) bank account. The bank account derivation key is Business Unit + Currency; the profile derivation key additionally includes Payment Method and the resolved Disbursement Bank Account. Each unresolved document blocks only itself - other documents in the same PPR may proceed. Resolution is done by manually selecting the correct account or profile on the Assign Payment Process Attributes page (to assign to groups of documents payable) or the Assign Attributes at Document Payable Level page (to assign to individual documents). The user needs to understand which documents are blocked, which attribute each is missing, and - where multiple candidates exist - which is the correct one for that business unit, currency, and payment method.\",      \"description\": \"User wants to identify documents, installments, payments, or PPRs blocked because required processing attributes are missing.\",      \"nlpExamples\": [        \"Which documents are missing disbursement bank account\",        \"which documents are missing attributes\",        \"Which PPRs are waiting for additional information\",        \"show me what attributes are missing for processing PPR gapr_ppr_test_4\",        \"Show me available bank accounts for this business unit Vision Operations and currency USD\",        \"Before I assign the bank account, show me all disbursement accounts for this Business Unit Vision Operations\"      ],      \"data\": {        \"goal\": \"Your job when using this skill is to help the user identify every document in the PPR that is blocked due to a missing required attribute, understand precisely what is missing per document and supplier, and determine the fastest path to resolving each gap - so the PPR can proceed to payment validation with the minimum delay.\",        \"slices\": [          \"Primary shapes: Payment Run, Payment Run Installments, Payment Run Disbursement Payments, Payment Run Exceptions.\",          \"Missing attribute summary query: fetch Payment Run Exceptions for the named PPR filtered to missing attribute exception types - missing disbursement bank account, missing payment process profile, missing remittance delivery method, and other required attribute gaps; aggregate by exception type; surface total blocked document count and blocked value per exception type.\",          \"Affected document detail query: fetch Payment Run Installments and Payment Run Exceptions joined on document reference; filter to documents with a missing attribute exception; surface invoice reference, supplier, installment amount, and the specific missing attribute per document.\",          \"Supplier level query: fetch Payment Run Exceptions grouped by supplier; aggregate blocked document count and total blocked value per supplier; identify the specific missing attribute type per supplier.\",          \"Bank account gap query: fetch Payment Run Exceptions filtered to missing disbursement bank account exception type; cross-reference with supplier bank account setup to identify whether the supplier has no bank accounts at all or has multiple but none assigned as default for the relevant payment method and currency.\",          \"Multiple bank account visibility query: fetch supplier bank account setup for suppliers in the PPR where multiple bank accounts exist; surface all bank accounts per supplier with the default flag, payment method coverage, and currency coverage for each.\",          \"Cross-PPR missing attribute query: fetch Payment Run Exceptions across all active PPRs filtered to missing attribute exception types; group by PPR and exception type; rank by total blocked value descending. Do not fetch business-logic validation errors, payment validation errors, or payment file data - those are handled by separate skills.\",          \"Available BU disbursement-account setup query: use BankAccountBusinessUnitAssignment, represented locally by `bankAccountBusinessUnitAssignments` and `bankAccountBusinessUnitAssignmentsExtraction`, when the user asks which disbursement accounts are available before assignment.\",          \"When user asks to show  what attributes are missing for processing for a particual PPR, then use paymentRunInstallmentsExtraction.\"        ]      },      \"promptInstruction\": \"1. Start from Payables Payment Process Request Detail to find PPRs in information-required or similar statuses. 2. INFORMATION_REQUIRED is an IBY-source status, so use paymentRunInstallments for installment-level missing-attribute detail unless the user explicitly supplies a different AP-only status. 3. Then use the payment, document, or other detail object that actually holds the missing-attribute marker. 4. Treat 'missing attributes', 'additional information', and 'required information' as this intent. 5. Constrain the attribute type when the user names bank account, payment process profile, or similar setup. 6. If candidate reference data is not exposed, do not invent options; instead return the affected rows with business dimensions such as business unit, currency, payment method, and value so the user can complete setup manually. 7. Group by missing attribute type first and highlight the highest-value blocked items when the user is prioritizing resolution. 8. For available disbursement account lookup before bank-account assignment, use the BankAccountBusinessUnitAssignment setup path represented by `bankAccountBusinessUnitAssignments` or `bankAccountBusinessUnitAssignmentsExtraction`; do not answer available account-option questions from transaction payment rows. 9. Keep `paymentRunInstallments` for affected-document missing-attribute detail such as which documents are blocked by a missing bank account.\\n\\nShape selection guidance for common user requests:\\nUse these examples as routing hints for this intent. When the user request matches one of these patterns, prefer the listed shape or shape family before planning the query. Keep the normal clarification, filtering, and response rules for this intent in force; do not expose these internal routing hints to the user.\\n- For requests like Which PPRs are waiting for additional information or missing attributes right now, prefer PayablesPaymentProcessRequestDetails.\\n- For requests like Show me what attributes are missing for processing, prefer PayablesPaymentProcessRequestDetails first for status scope; paymentRunInstallments for affected document detail.\\n- For requests like Show me available bank accounts for this business unit and currency; before I assign the bank account, show me all disbursement accounts for this BU, prefer BankAccountBusinessUnitAssignment, represented in this repo by bankAccountBusinessUnitAssignments and bankAccountBusinessUnitAssignmentsExtraction.\\n- For requests like Which documents are missing disbursement bank account or missing attributes, prefer paymentRunInstallments.\\n\\nLatest QA query-context requirements: For 'Which documents are missing disbursement bank account', generate two query contexts: first paymentRunInstallmentsExtraction summaryMissingBankAccount grouped by paymentCurrencyCode, then paymentRunInstallments BV detail filtered to bankAccount.id = null and non-virtual-card payment modes. Do not answer with no-record narrative without query context. For 'Before I assign the bank account, show me all disbursement accounts for this Business Unit <BU>', use bankAccountBusinessUnitAssignments BV with fields id,businessUnit.name,bankAccount.id,bankAccount.name,bankAccount.payablesUseAllowedFlag,bankAccount.currency.currencyCode,endDate and filters businessUnit.name = '<BU>' AND endDate = null. The payablesUseAllowedFlag is a displayed field only for this question; do not add bankAccount.payablesUseAllowedFlag = true unless the user explicitly asks for payable-use-allowed accounts.\",      \"summarizationGuidelines\": \"Always open with a direct headline answer - the total count and value of documents payable blocked by missing attributes in the PPR, the business units and suppliers affected, and the dominant missing attribute type - before presenting detailed data. Keep the opening summary to around 80 to 100 words. For cross-PPR summary responses: present a table with columns PPR Name, PPR Status, Missing Attribute Types, Blocked Document Count, Total Blocked Value. Rank by Total Blocked Value descending. For single PPR summary responses: present an exception type summary table first with columns Missing Attribute Type, Affected Document Count, Total Blocked Value; follow with the affected document detail table. For affected document detail responses: present a table with columns Invoice Reference, Supplier, Business Unit, Installment Amount, Missing Attribute, Resolution Required. Note that the blocked unit is the document payable (installment), so a single invoice may appear more than once if multiple installments are blocked. Group by Missing Attribute type with a subtotal row per group. For efficiency or grouping responses: the lever is the shared derivation key, not the supplier. A disbursement bank account is derived per Business Unit + Currency; a payment process profile per Payment Method + Business Unit + Disbursement Bank Account + Currency. Surface explicitly where one selection on the Assign Payment Process Attributes page will resolve multiple documents sharing the same combination, and quantify the documents and value unblocked. For disbursement bank account gap responses: diagnose per Business Unit + Currency, not per supplier - the disbursement bank account is the deploying company's internal paying account, not the supplier's payee account. Use plain-language scenario labels, for example 'multiple valid internal accounts for this business unit and currency - one must be selected' (the common case) or 'no internal account available for this business unit and currency'. Do not present a 'no default' scenario - the system does not auto-resolve via a default flag; when more than one account matches it stops and waits for a manual selection. For candidate bank account visibility responses: present, per affected Business Unit + Currency, a table of the available internal disbursement accounts with columns Bank Account Name, Account Number, Bank, Currency, Business Unit, so the user can select the correct one. Do not show a Default Flag or match accounts by payment method - bank account derivation uses business unit and currency only. Always include a plain-language resolution guidance note per missing attribute type, stating the Oracle navigation path: 'Pending action to complete information required' status > Assign Payment Process Attributes page (groups) or Assign Attributes at Document Payable Level page (individual documents). Use business-friendly labels throughout. Avoid raw system codes or internal field identifiers.\",      \"recommendationGuidelines\": \"Generate 2 to 3 targeted next steps based on the missing attribute finding. Start each recommendation with a verb. Reference the correct resolution pages: the Assign Payment Process Attributes page (to assign to groups of documents payable) or the Assign Attributes at Document Payable Level page (to assign per individual document), both reached via link for the 'Pending action to complete information required' status. Do not reference the Manage Suppliers page - the disbursement bank account in this context is the company's internal disbursement account derived by business unit and currency, not a supplier site attribute. Examples: For missing disbursement bank account: 'Assign a disbursement bank account to the affected documents on the Assign Payment Process Attributes page - these documents cannot be processed in any run until a valid account is assigned. Use Assign at Document Payable Level to set it per document rather than for the group.' For multiple candidate bank accounts, the most common cause of Missing Account: 'Select the correct disbursement bank account for this business unit and currency on the Assign Payment Process Attributes page - the system could not auto-default because more than one valid internal account matched, so confirm the right one before assigning to avoid disbursing from the wrong account.' For missing payment process profile: 'Select a payment process profile for the affected documents on the Assign Payment Process Attributes page - matching is by payment method, business unit, disbursement bank account, and currency, so confirm a profile whose usage rules cover all four exists before assigning.' For no matching profile configured: 'Escalate to your Oracle setup team to configure and assign a payment process profile whose usage rules cover the relevant payment method, business unit, disbursement bank account, and currency - this is a configuration task rather than a self-service correction.' For the same attribute missing across multiple documents in one business unit: 'Resolve the [attribute] once on the Assign Payment Process Attributes page to unblock [N] documents totalling [value] in a single correction - prioritise this as it has the highest recovery value.' For mixed gaps across many documents: 'Triage by resolution effort - assign or disambiguate bank accounts first as these are self-service on the assignment pages, then escalate any unconfigured payment process profiles to the setup team.' Do not recommend executing setup changes directly - provide the analytical finding and the navigational path only. Do not reference the Manage Suppliers page - the disbursement bank account in this context is the company's internal disbursement account derived by business unit and currency, not a supplier site attribute\",      \"parentSkillKey\": \"ppr.findPaymentProcessRequests\",      \"clarification\": {        \"rules\": [          {            \"when\": \"The user asks about missing information but does not indicate whether they want all missing attributes or a specific attribute type.\",            \"question\": \"Do you want all missing processing attributes, or should I focus on a specific one such as bank account or payment process profile?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"missingProcessingAttributesSummary\",              \"title\": \"Missing processing attributes summary\",              \"columns\": [                \"Missing Attribute Type\",                \"Document Count\",                \"Total Amount\",                \"Payment Currency\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"missingProcessingAttributesDetails\",              \"title\": \"Rows blocked by missing processing attributes\",              \"columns\": [                \"PPR Name\",                \"Affected Object Type\",                \"Missing Attribute Type\",                \"Supplier Name\",                \"Document Or Payment Reference\",                \"Business Unit\",                \"Currency\",                \"Status\"              ]            }          ]        }      },      \"additionalInstructions\": \"Keep missing-attribute questions separate from generic validation exceptions. If candidate reference data is unavailable, say so and keep the answer grounded in the affected business rows. For account-option questions such as available disbursement accounts for a BU before assignment, use the BankAccountBusinessUnitAssignment setup path (`bankAccountBusinessUnitAssignments` or `bankAccountBusinessUnitAssignmentsExtraction`) rather than transaction payment detail. For missing disbursement bank account document questions, emit both summary extraction and detail BV query context. For disbursement account assignment lookups before bank assignment, do not filter on bankAccount.payablesUseAllowedFlag unless explicitly requested; include it as a field only.\"    },    {      \"key\": \"ppr.reviewPPRMissingConversionRates\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"name\": \"Review PPR Missing Conversion Rates\",      \"intentDomainKnowledge\": \"When a PPR selects installments that involve a currency conversion - for example an invoice in EUR being paid from a USD bank account - Oracle Payables requires a valid conversion rate to compute the payment amount. There are two rate types involved: the payment conversion rate, which converts the invoice currency to the ledger currency, and the cross-currency rate, which converts invoice currency to payment currency. If the type of payment conversion rate is User and payment conversion rates are missing for the relevant date, the PPR cannot proceed past the installment selection stage and its status changes to \\\"Missing payment conversion rates. If Cross-currency rates or the cross-currency rate type is missing the PPR cannot proceed past the isntallment selection stage and its status changes to \\\"Missing cross-currency rates. If the type of payment conversion rate is User and payment conversion rates or cross currency rates are missing then the user must manually provide a User rate for the affected currency pair to unblock the run. The affected installments remain in a pending state until the rate is supplied. A single missing rate can block multiple installments and suppliers if they all involve the same currency pair. Conversely, a PPR may have multiple missing rates across different currency pairs, each blocking a different subset of installments. The total value blocked by missing rates is an important triage signal - a small number of low-value installments with missing rates may warrant removal rather than rate entry, while a large blocked value justifies the effort of providing the rate. This skill is strictly scoped to conversion and cross-currency rate gaps. It does not cover document validation errors, payment validation errors, or installment curation decisions - those are handled by separate skills.\",      \"description\": \"User wants to resolve missing payment conversion rates or missing cross-currency rates that are blocking installments in a PPR.\",      \"nlpExamples\": [        \"Show me missing payment conversion rates for all PPRs.\",        \"Which currencies are missing payment conversion rates in PPR PPR05-009?\",        \"How many installments are blocked due to missing payment conversion rates?\",        \"Which payments/installments will be affected if I update the USD to EUR conversion rate to 0.92?\",        \"Show me missing payment conversion rates where the payment/installment amount exceeds $100,000\",        \"What was the last conversion rate we used for USD to JPY?\",        \"Show me all missing conversion rates organized by currency pair\",        \"Show me missing cross currency rates where the payment/installment amount exceeds $100,000\",        \"Show me missing cross currency rates for all PPRs.\",        \"Which currencies are missing cross currency rates in PPR PPR05-009?\",        \"How many installments are blocked due to missing cross currency rates?\"      ],      \"data\": {        \"goal\": \"Your job when using this skill is to help the user understand exactly which conversion rates are missing, which installments and suppliers are blocked as a result, the total value at risk, and what rate needs to be provided for each currency pair - so they can take the fastest path to unblocking the run.\",        \"slices\": [          \"Primary shapes: `selectedPaymentInstallments` for BV row/detail answers and `selectedPaymentInstallmentsExtraction` for SQL aggregation, counts, grouped summaries, and extraction-only null syntax. Do not use Payment Run Exceptions, Payment Run Installments, or Disbursement Payments as the source for missing-rate questions unless a separate non-rate intent explicitly asks for payment-run exception triage.\",          \"Missing rate summary query: follow the PM split exactly. For all-PPR scans, use only the parent status filter: payment conversion rates use `paymentProcessRequestStatus.lookupCode = 'MISSING RATES'`; cross-currency rates use `paymentProcessRequestStatus.lookupCode = 'MISSING_X_RATES'`. Do not add `conversionRate = null` or `crossCurrencyRate = null` to these all-PPR status scans.\",          \"Affected installment detail query: use `selectedPaymentInstallments`. For a specific PPR, currency list, installment row list, count, or amount-threshold question, filter row-level gaps with `conversionRate = null` for missing payment conversion rates or `crossCurrencyRate = null` for missing cross-currency rates. Add a PPR filter only when the user supplies one, and do not force the parent missing-rate status. Amount-threshold wording such as exceeds, over, above, or greater than is row-level detail, so it must include the paymentAmount > threshold predicate together with the null-rate predicate.\",          \"Value impact query: use `selectedPaymentInstallments` or `selectedPaymentInstallmentsExtraction` over the affected selected installments. Group by invoice currency and payment currency when summarizing blocked value; use the same PM split for status-only all-PPR scans versus row-level null-rate PPR/count/amount-threshold questions.\",          \"Hypothetical unblock query - \\\"what happens if I provide rate X\\\": use `selectedPaymentInstallments` filtered to the stated invoice-currency and payment-currency pair. Return both `conversionRate` and `crossCurrencyRate`; do not add parent status filters or null-rate predicates unless the user explicitly asks for missing rows.\",          \"Cross-PPR missing rate query: use `selectedPaymentInstallments` for all-PPR status scans. Missing payment conversion rates use `MISSING RATES`; missing cross-currency rates use `MISSING_X_RATES`. For an organized-by-currency-pair summary across both rate statuses, use `selectedPaymentInstallmentsExtraction` with `paymentProcessRequestStatusLookupCode IN ('MISSING RATES','MISSING_X_RATES')`, grouped by invoice and payment currency.\",          \"When the user asks for the last, latest, or most recent conversion rate used for a currency pair, plan a single `selectedPaymentInstallmentsExtraction` step filtered only to that invoice-currency/payment-currency pair with `conversionRate IS NOT NULL` and `paymentDate IS NOT NULL`, sorted by `paymentDate DESC`, fetching the first row. Never apply missing-rate status filters or missing-rate null predicates to last-used conversion-rate questions.\"        ]      },      \"promptInstruction\": \"Use selectedPaymentInstallments as the primary BV drill-down shape and selectedPaymentInstallmentsExtraction only when the expected answer requires SQL aggregation, counts, or extraction-only null syntax. Keep missing payment conversion rates and missing cross-currency rates separate. For all-PPR scans, follow PM status guidance exactly: missing payment conversion rates use paymentProcessRequestStatus.lookupCode = 'MISSING RATES'; missing cross-currency rates use paymentProcessRequestStatus.lookupCode = 'MISSING_X_RATES'. Do not add conversionRate or crossCurrencyRate null predicates to those all-PPR status scans unless the user explicitly asks for row-level null-rate details. For a specific PPR currency, installment, count, or amount-threshold question, use the row-level missing-rate predicate instead of forcing the parent status: payment conversion uses conversionRate = null in BV/EV shapes and conversionRate IS NULL in extraction SQL; cross-currency uses crossCurrencyRate = null in BV/EV shapes and crossCurrencyRate IS NULL in extraction SQL. Add the PPR name/id filter only when supplied by the user. For currency-pair impact questions such as updating USD to EUR to a new rate, filter by the requested invoice and payment currency pair and return both conversionRate and crossCurrencyRate columns; do not add parent status filters or null-rate predicates unless the user asks specifically for missing rows. For last-used conversion-rate questions, never apply missing-rate filters. Use the extraction query, filter the currency pair, exclude null conversionRate and null paymentDate, sort paymentDate descending, and fetch the first row. For currency summaries, group by invoice currency and payment currency. For amount-threshold questions, the amount predicate is mandatory and has precedence over generic all-PPR status-scan wording: BV/EV payment-conversion filters must include conversionRate = null AND paymentAmount > <AMOUNT_THRESHOLD_FROM_USER>, BV/EV cross-currency filters must include crossCurrencyRate = null AND paymentAmount > <AMOUNT_THRESHOLD_FROM_USER>, and extraction SQL must use IS NULL with the same paymentAmount > threshold predicate. Do not treat supported selected-installment missing-rate questions as unsupported. For the exact pattern 'Show me all missing conversion rates organized by currency pair', use selectedPaymentInstallmentsExtraction and generate the grouped extraction query with fields invoiceCurrencyCurrencyCode,paymentCurrencyCurrencyCode,blockedInstallments,blockedAmount, filter paymentProcessRequestStatusLookupCode IN ('MISSING RATES','MISSING_X_RATES'), group by invoice and payment currency, and order by blockedAmount desc. Do not answer with a cached zero-count or narrative without query context.\\n\\nMandatory query-context rule: for supported missing-rate questions, always emit the selectedPaymentInstallments or selectedPaymentInstallmentsExtraction query context even when retrieved rows are zero. Do not answer with only a narrative such as 'no missing rates were found'. Exact supported BV example: 'Which currencies are missing payment conversion rates in PPR <PPR_NAME>?' must use selectedPaymentInstallments with fields invoiceCurrency.currencyCode,paymentCurrency.currencyCode,paymentAmount; filter payablesPaymentProcessRequest.checkrunName = '<PPR_NAME>' AND conversionRate = null; sort invoiceCurrency.currencyCode asc; limit 20. Exact supported extraction example: 'Show me all missing conversion rates organized by currency pair' must use selectedPaymentInstallmentsExtraction with COUNT(*) AS blockedInstallments and SUM(paymentAmount) AS blockedAmount grouped by invoiceCurrencyCurrencyCode and paymentCurrencyCurrencyCode, filtered by paymentProcessRequestStatusLookupCode IN ('MISSING RATES','MISSING_X_RATES'), ordered by blockedAmount desc.\\n\\nExact supported BV amount-threshold example: 'Show me missing payment conversion rates where the payment/installment amount exceeds $100,000' must use selectedPaymentInstallments with fields payablesPaymentProcessRequest.checkrunName,supplier.name,invoiceNumber,installmentNumber,invoiceCurrency.currencyCode,paymentCurrency.currencyCode,paymentAmount,dueDate; filter conversionRate = null AND paymentAmount > 100000; sort payablesPaymentProcessRequest.checkrunName asc; limit 20. Do not emit only conversionRate = null for this pattern.\\n\\nCount and rate-update routing is strict: questions that ask 'how many installments are blocked' by missing payment conversion or cross-currency rates must use selectedPaymentInstallmentsExtraction with COUNT(*) and the matching IS NULL predicate, not selectedPaymentInstallments BV. Questions like 'Which payments/installments will be affected if I update the USD to EUR conversion rate to 0.92?' must use selectedPaymentInstallmentsExtraction, filter only the invoice/payment currency pair, include ROWNUM <= 20, and return both conversionRate and crossCurrencyRate; do not use the BV shape for that pattern. For PPR-specific currency-list questions, use the PPR name exactly as supplied, including hyphens, as the checkrunName filter and still emit query context when the result set is empty.\\n\\nCross-currency missing-rate routing must follow the same PM split as payment conversion. Plain all-PPR detail requests such as 'Show me missing cross currency rates for all PPRs' must use selectedPaymentInstallments BV with payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode = 'MISSING_X_RATES'; do not convert them to grouped extraction unless the user asks to organize, group, summarize, or count. PPR-specific currency-list requests such as 'Which currencies are missing cross currency rates in PPR <PPR_NAME>?' must use selectedPaymentInstallments BV with checkrunName and crossCurrencyRate = null. Only 'how many installments are blocked due to missing cross currency rates' is extraction, using SELECT COUNT(*) AS blockedInstallments FROM selectedPaymentInstallments WHERE crossCurrencyRate IS NULL.\\n\\nFor the exact organized-by-currency-pair request, always emit selectedPaymentInstallmentsExtraction query context. The SQL select must be: SELECT invoiceCurrencyCurrencyCode, paymentCurrencyCurrencyCode, COUNT(*) AS blockedInstallments, SUM(paymentAmount) AS blockedAmount FROM selectedPaymentInstallments WHERE paymentProcessRequestStatusLookupCode IN ('MISSING RATES','MISSING_X_RATES') GROUP BY invoiceCurrencyCurrencyCode, paymentCurrencyCurrencyCode ORDER BY blockedAmount DESC. Do not answer with a narrative-only no-data response, and do not omit ORDER BY blockedAmount DESC.\",      \"summarizationGuidelines\": \"Always open with a direct headline answer - for example the number of currency pairs with missing rates in the PPR, the total value blocked, and the rate types affected - before presenting detailed data. Keep the opening summary to around 80 to 100 words. For missing rate summary responses: follow with a summary table grouped by currency pair showing rate type missing, number of blocked installments, and total blocked value. Rank by blocked value descending so the highest-priority gaps surface first. For affected installment detail responses: follow the summary table with an installment detail table showing Invoice Reference, Supplier, Installment Amount, Invoice Currency, Payment Currency, Rate Type Missing. For cross-PPR summary responses: present a table with one row per PPR showing PPR Name, Number of Missing Rate Currency Pairs, Total Blocked Installments, and Total Blocked Value. Rank by total blocked value descending. For hypothetical unblock impact responses: present a clear projection table showing Currency Pair, Installments to be Unblocked, Value to be Unblocked, and label it prominently as a projection - no rate has been entered. For value-threshold filtered responses: state the threshold applied at the top of the response and present only the results that meet or exceed it. Always distinguish between missing payment conversion rate and missing cross-currency rate using plain-language labels. Include a resolution guidance note at the end of every response: state the navigation path - Manage Payment Process Request page - where the user can enter the required User rate for each missing currency pair. Use business-friendly labels throughout. Avoid raw system codes or internal field identifiers.\",      \"recommendationGuidelines\": \"Generate 2 to 3 targeted next steps based on the missing rate finding. Start each recommendation with a verb. For a single missing rate blocking high value: \\\"Provide the User rate for the [currency pair] on [date] in the Manage Payment Process Request page to unblock [N] installments totalling [value] and allow the run to proceed. For multiple missing rates across different currency pairs: \\\"Prioritise providing rates for the currency pairs with the highest blocked value first - start with [currency pair] which is blocking [value] across [N] installments. For low-value installments blocked by a missing rate: \\\"Consider removing the [N] low-value installments blocked by the missing [currency pair] rate from this run rather than entering the rate - this will allow the remainder of the run to proceed without delay. For missing rates blocking installments across multiple PPRs: \\\"Address the missing [currency pair] rate at the system level - it is blocking installments across [N] PPRs and a single rate entry will unblock all of them simultaneously. For hypothetical unblock scenario confirmed: \\\"Enter the [currency pair] User rate in the Manage Payment Process Request page - doing so will unblock [N] installments totalling [value] in this run. For cross-currency rate missing specifically: \\\"Note that the missing rate is a cross-currency rate, not a standard payment conversion rate - ensure the rate is entered for the correct rate type in the Manage Cross Rates page. Do not execute rate entry or run modifications - provide the analytical finding and the navigational path only.\",      \"parentSkillKey\": \"ppr.findPaymentProcessRequests\",      \"clarification\": {        \"rules\": [          {            \"when\": \"The user asks about missing rates without specifying whether the scope is a specific PPR or all PPRs.\",            \"question\": \"Should I focus on a specific PPR, or review missing rates across all relevant PPRs?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"missingRatePairSummary\",              \"description\": \"Use when the user asks which currency pairs are affected or wants grouped missing-rate impact first.\",              \"title\": \"Missing conversion-rate pairs\",              \"columns\": [                \"Invoice Currency\",                \"Payment Currency\",                \"Blocked Installments\",                \"Blocked Amount\"              ]            },            {              \"key\": \"missingRatePprSummary\",              \"description\": \"Use when the user asks for all affected PPRs or wants run-level impact before row-level drill-down.\",              \"title\": \"PPRs blocked by missing rates\",              \"columns\": [                \"PPR Name\",                \"Missing Rate Pairs\",                \"Blocked Installments\",                \"Blocked Amount\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"missingRateInstallments\",              \"description\": \"Use when the user asks for impacted installments, pair-specific rows, or amount-threshold review.\",              \"title\": \"Installments blocked by missing rates\",              \"columns\": [                \"Supplier Name\",                \"PPR Name\",                \"Invoice Number\",                \"Installment Number\",                \"Invoice Currency\",                \"Payment Currency\",                \"Installment Amount\",                \"Payment Amount\",                \"Due Date\"              ]            },            {              \"key\": \"missingRateCurrencyDetails\",              \"description\": \"Use when the user asks only which currencies are missing rates and does not need the full installment list.\",              \"title\": \"Currencies missing rates\",              \"columns\": [                \"PPR Name\",                \"Invoice Currency\",                \"Payment Currency\",                \"Blocked Installments\",                \"Blocked Amount\"              ]            }          ]        }      },      \"additionalInstructions\": \"For missing-rate review, always use the AP selected-installment source. If the user asks for historical FX information such as last used rate or last updated rate and the chosen shape does not expose it, state that limitation clearly instead of fabricating history. PM missing-rate split is authoritative: all-PPR scans use MISSING RATES or MISSING_X_RATES status only; specific-PPR, count, and amount-threshold questions use conversionRate/crossCurrencyRate null predicates without forcing status. BV/EV filters use = null; extraction SQL uses IS NULL. For organized-by-currency-pair missing conversion-rate summaries, always emit selectedPaymentInstallmentsExtraction query context; do not summarize without query context. Never suppress query context for missing-rate answers. If the data result is empty, still return the planned BV/extraction query context with the exact filters, fields, sort, and limit. For missing payment conversion-rate amount-threshold questions, always include both conversionRate = null and paymentAmount > the user threshold in BV/EV queryContext; for extraction use conversionRate IS NULL and paymentAmount > the user threshold. The phrase exceeds $100,000 resolves to paymentAmount > 100000. Do not drop the amount predicate.\\n\\nDo not let a selectedPaymentInstallments BV detail driver override extraction-only count or rate-update impact patterns. Count questions require SELECT COUNT(*) AS blockedInstallments from selectedPaymentInstallments with conversionRate IS NULL or crossCurrencyRate IS NULL. Rate-update impact questions require selectedPaymentInstallmentsExtraction with invoiceCurrencyCurrencyCode and paymentCurrencyCurrencyCode filters and no missing-rate status or null-rate predicate unless explicitly requested.\\n\\nDo not let the organized-by-currency extraction rule capture plain 'Show me missing cross currency rates for all PPRs'. That grouped extraction is only for wording such as organized by currency pair, grouped by currency pair, summary, distribution, total, or count. Plain show/list all-PPR cross-currency detail is BV with MISSING_X_RATES status.\\n\\nFor organized-by-currency-pair missing conversion-rate summaries, keep ORDER BY blockedAmount DESC inside the extraction SQL. Do not add FETCH FIRST or ROWNUM inside this grouped SQL unless the user explicitly asks for top N; the default display limit can be handled outside the SQL.\"    },    {      \"key\": \"ppr.reviewPPRPaymentApprovalsApprover\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"name\": \"Review PPR Payment Approvals (Approver)\",      \"intentDomainKnowledge\": \"Oracle Payables supports a configurable payment approval workflow that can require one or more levels of approval before a PPR or proposed payment proceeds to payment file build. Approval requirements are typically configured based on payment amount thresholds, business units, payment methods, or supplier categories - for example all wire payments above a certain value may require senior finance sign-off before disbursement. The payment approval workflow assigns approval tasks to specific users or roles based on the approval rules configured. Each approver sees only the approval tasks assigned to them. From the approver's perspective the key information needs are: which PPRs or proposed payments are currently assigned to them for approval; what the total value and composition of each pending approval is - which suppliers, which invoices, which bank accounts, and what payment method; how long each approval has been waiting - time-sensitive approvals near an SLA or a payment due date require prioritisation; and whether any approvals cover unusually high-value payments or concentrated supplier exposure that warrants closer scrutiny before sign-off. This skill surfaces the approver's queue with all of these dimensions. It is strictly the approver's view - it shows only approvals assigned to the current user in their approver role. It does not show the requestor's view of submitted approvals - that is handled by the Review PPR Payment Approvals Requestor skill. It does not execute approval or rejection actions - it provides the information and navigational guidance the approver needs to act through the Oracle approval workflow interface.\",      \"description\": \"Surfaces pending payment approval requests assigned to the current user in their approver role - showing which PPRs or payments are awaiting their sign-off, the amounts, how long they have been waiting, and what each approval covers. Use when an approver wants to see their approval queue, identify high-value or time-sensitive items requiring their action, and understand the composition of each pending approval before acting.\",      \"nlpExamples\": [        \"Show me all PPRs pending my approval.\",        \"Which payments in my queue need sign-off today?\",        \"Show me the high-value payments awaiting my approval.\"      ],      \"data\": {        \"goal\": \"Your job when using this skill is to give the approver a clear, prioritised view of everything in their payment approval queue - what is pending, how much each item is worth, how long it has been waiting, which items are most time-sensitive or high-value, and what each approval covers - so they can act on the right items first and move to the Oracle approval interface with full context.\",        \"slices\": [          \"Primary shapes: Payment Run, Payment Run Disbursement Payments, and approval workflow task data scoped to the current user's approver role.\",          \"Approval queue summary query: fetch all pending payment approval tasks assigned to the current user; group by PPR or proposed payment; aggregate total pending approval count, total value awaiting approval, and days waiting per item; rank by days waiting descending to surface the longest-waiting items first.\",          \"High-value filter query: fetch pending approval tasks for the current user filtered to items where the approval amount exceeds the user's stated threshold; surface payment reference or PPR name, supplier, amount, payment method, and days waiting per item.\",          \"Time-sensitive filter query: fetch pending approval tasks filtered to items where the payment due date falls within the next 24 to 48 hours or where the approval SLA deadline is approaching; rank by urgency - due date or SLA breach proximity - descending.\",          \"Approval composition detail query: fetch the full composition of a specific pending approval assigned to the current user - PPR name, proposed payment references, suppliers covered, invoice count, total amount, disbursement bank account, payment method, currency, and the approval request date.\",          \"Aging analysis query: fetch all pending approval tasks for the current user; compute days waiting per item from the approval request date to today; rank by days waiting descending; flag items exceeding a standard SLA threshold - for example more than 2 business days - as overdue for approval action. Do not fetch approval tasks assigned to other approvers. Do not fetch requestor-side approval status - that is handled by the Requestor skill. Do not execute approval or rejection actions.\"        ]      },      \"promptInstruction\": \"Identify the approver queue query type first - full queue summary, high-value filter, time-sensitive or SLA filter, approval composition detail, or aging analysis - then plan the data slices accordingly. Always scope retrieval to the current user's approver role - do not surface approval tasks assigned to other users. For full queue summary queries: fetch all pending approval tasks assigned to the current user; aggregate by PPR or proposed payment; rank by a combination of days waiting and total amount to surface the highest-priority items first; present a summary of total pending approvals and total value at the top of the response. For high-value filter queries: apply the user's stated amount threshold to the pending approval tasks; if no threshold is stated default to the top 5 items by value and state the assumption; present each item with full composition summary. For time-sensitive filter queries: filter to approval tasks where the payment due date falls within the user's stated window or within the next 24 hours by default; rank by payment due date ascending so the most urgent items surface first; flag any items where the due date has already passed. For approval composition detail queries: retrieve the full composition of the named or implied PPR or proposed payment approval; present supplier list, invoice count, total amount, disbursement bank account, payment method, and currency; surface any concentration risk - for example a single supplier representing more than 30% of the approval value - so the approver can scrutinise it before signing off. For aging analysis queries: compute days waiting from the approval request date for all pending items; rank by days waiting descending; flag items exceeding a standard SLA threshold as requiring immediate action. Always present a navigational note directing the approver to the Oracle payment approval interface to act - do not attempt to execute approval or rejection within this skill. Apply the User Clarification rules if the current user's approver role cannot be determined from context.\",      \"summarizationGuidelines\": \"Always open with a direct headline answer - for example the total count and value of approvals pending in the current user's queue, and whether any are time-sensitive or overdue - before presenting detailed data. Keep the opening summary to around 80 to 100 words. For full queue summary responses: follow the summary with a prioritised approval queue table showing the most urgent items first - rank by a combination of days waiting and amount. For high-value filter responses: present a table filtered to the user's threshold with columns PPR or Payment Reference, Suppliers Covered, Total Approval Amount, Payment Method, Disbursement Bank Account, Days Waiting. For time-sensitive filter responses: present a table ranked by payment due date ascending with columns PPR or Payment Reference, Total Approval Amount, Payment Due Date, Days Until Due, Days Waiting for Approval. Flag rows where the due date is today or has passed. For approval composition detail responses: present the full composition in a structured two-section format - Section 1 a header summary card with PPR Name, Total Amount, Payment Method, Bank Account, Currency, Approval Request Date, Days Waiting; Section 2 a supplier breakdown table with columns Supplier, Invoice Count, Total Amount, Percentage of Approval. Flag any supplier exceeding 30% of total approval value. For aging analysis responses: present a table ranked by days waiting descending with columns PPR or Payment Reference, Total Amount, Approval Request Date, Days Waiting, SLA Status - On Track or Overdue. Flag overdue items prominently. Always include a plain-language navigational note at the bottom of every response directing the approver to the Oracle payment approval workflow interface to take action. Use business-friendly labels throughout. Avoid raw system codes or internal field identifiers.\",      \"recommendationGuidelines\": \"Generate 2 to 3 targeted next steps based on the approval queue finding. Start each recommendation with a verb. For time-sensitive approvals due today or overdue: \\\"Act on the approval for [PPR or Payment Reference] immediately - the payment due date is today or has passed and further delay risks a late payment to the supplier. For high-value approvals requiring scrutiny: \\\"Review the composition of the approval for [PPR or Payment Reference] before signing off - it includes a payment to [Supplier] representing [N]% of the total approval value of [amount] which warrants closer verification. For approvals that have been waiting longer than the SLA: \\\"Escalate or action the [N] approval requests that have exceeded the standard SLA - they have been waiting for [N] days and the delay is increasing the risk of late payment. For a clean queue with no urgent items: \\\"No time-sensitive or overdue approvals in your queue - proceed with the standard review of pending items ranked by value and age. For approvals covering multiple suppliers with no concentration risk: \\\"The pending approval covers [N] suppliers with no single supplier exceeding 30% of the total value - the composition appears balanced and is ready for sign-off subject to your review. For a large queue with mixed urgency: \\\"Prioritise the [N] approvals with payment due dates in the next 24 hours first - then work through the remaining queue in order of days waiting to clear the oldest items. Always direct the approver to the Oracle payment approval workflow interface for sign-off. Do not execute approval or rejection actions - navigational and advisory only.\",      \"parentSkillKey\": \"ppr.findPaymentProcessRequests\",      \"clarification\": {        \"rules\": [          {            \"when\": \"if the user asks to see the composition of a specific approval without naming it clearly and multiple approvals are pending, present the full queue summary and\",            \"question\": \"Which pending approval would you like me to show the full composition for?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"paymentApprovalSummary\",              \"description\": \"Use when the user wants the PPR-level approval picture across all matching runs.\",              \"title\": \"Payment approval summary\",              \"columns\": [                \"Approval Status\",                \"PPR Count\",                \"Pending Payment Count\",                \"Pending Payment Value\"              ]            },            {              \"key\": \"highValueApprovalSummary\",              \"description\": \"Use when the user asks about high-value payments or manager-approval review.\",              \"title\": \"High-value payments awaiting approval\",              \"columns\": [                \"Approval Bucket\",                \"Payment Count\",                \"Total Payment Value\",                \"Current Approver Or Role\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"paymentApprovalDetails\",              \"description\": \"Use for the core approval-aging detail at the PPR level.\",              \"title\": \"PPRs pending payment approval\",              \"columns\": [                \"PPR Name\",                \"Approval Status\",                \"Submitted Or Initiated Date\",                \"Days Pending\",                \"Current Approver Or Role\",                \"Payment Count\",                \"Total Payment Value\"              ]            },            {              \"key\": \"paymentApprovalHighValueDetails\",              \"description\": \"Use when the user asks which payments are waiting for sign-off or needs manager-approval detail.\",              \"title\": \"Payments awaiting approval\",              \"columns\": [                \"PPR Name\",                \"Payment Reference\",                \"Supplier Or Payee\",                \"Invoice References\",                \"Payment Amount\",                \"Current Approver Or Role\"              ]            }          ]        }      },      \"additionalInstructions\": \"Full approval queue table: columns PPR or Payment Reference, Suppliers Covered Count, Total Approval Amount, Payment Method, Disbursement Bank Account, Approval Request Date, Days Waiting, Priority Flag. Rank by a combined score of Days Waiting and Total Approval Amount. Flag time-sensitive rows where payment due date is within 24 hours. High-value filtered table: columns PPR or Payment Reference, Suppliers Covered, Total Approval Amount, Payment Method, Disbursement Bank Account, Days Waiting. Include a header note stating the threshold applied. Time-sensitive filtered table: columns PPR or Payment Reference, Total Approval Amount, Payment Due Date, Days Until Due, Days Waiting for Approval. Rank by Days Until Due ascending. Flag rows where due date is today or has passed. Approval composition output: two-section format - Section 1 header card with PPR Name, Total Amount, Payment Method, Bank Account, Currency, Approval Request Date, Days Waiting in a two-column label and value format; Section 2 supplier breakdown table with columns Supplier, Invoice Count, Total Amount, Percentage of Approval. Flag suppliers exceeding 30% of total value. Aging analysis table: columns PPR or Payment Reference, Total Amount, Approval Request Date, Days Waiting, SLA Status. Flag overdue rows. Navigational note: include a plain-language note at the bottom of every response directing the approver to the Oracle payment approval workflow interface to act on pending approvals - for example \\\"To approve or reject pending payments navigate to the Manage Payment Approvals page in Oracle Payables. All outputs: precede the table with a 1 to 2 sentence plain-language headline of the key finding. Use currency formatting consistent with the ledger currency. Avoid raw system codes or internal field identifiers in all displayed values.\"    },    {      \"key\": \"ppr.reviewPPRPaymentApprovalsRequestor\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"name\": \"Review PPR Payment Approvals (Requestor)\",      \"intentDomainKnowledge\": \"When a PPR or its proposed payments require approval before disbursement, the payments specialist who submitted the run enters a waiting state - they cannot proceed until the designated approver or approvers act on the approval request. From the requestor's perspective the key information needs are different from the approver's. The requestor needs to know: which of their submitted PPRs are currently waiting for approval and at which stage of the approval chain; who specifically has been assigned the current approval task - the named approver or approver group; how long the approval has been pending and whether it is approaching or has exceeded the expected turnaround time; whether the approval workflow has multiple levels and how many remain after the current approver acts; and whether any approvals are stalled - for example because the assigned approver is unavailable or has not actioned the task within the expected window - so the requestor can determine whether escalation is warranted. The payment approval workflow in Oracle Payables can be configured with single or multi-level approval chains. At each level a different approver or approver group may be designated based on payment amount, business unit, or other criteria. The requestor needs visibility of the full chain - not just the current pending level - to understand the total approval timeline before the run can proceed. This skill is strictly the requestor's view - it surfaces approval status for PPRs submitted by or relevant to the current user in their requestor role. It does not show the approver's own task queue - that is the Approver skill. It does not execute escalation, reassignment, or approval actions - it provides the information and navigational guidance the requestor needs to follow up through the appropriate channel.\",      \"description\": \"Allows a requestor to check the approval status of PPRs they submitted - showing where in the approval chain each run sits, who the current approver is, how long it has been pending, and whether escalation is needed. Use when a payments specialist wants to track the approval progress of a submitted run, understand why a PPR has not been approved yet, or identify who needs to act before the run can proceed to payment file build.\\n\\nRouting exclusion: do not use this approval-review intent for exact PPR status-name listing requests such as \\\"Show PPR with Status Pending payments approval\\\" or \\\"Show PPRs in status Pending payments approval\\\". Those are PPR_STATUS lookup-list requests and must route to ppr.findPaymentProcessRequests with paymentProcessRequestStatusCode = ORA_REQUIRE_APPROVAL. Use this approval-review intent only when the user asks about approval tasks, approvers, approval aging, approval chains, escalation, or pending approval as an approval workflow, not when the user explicitly says \\\"with status\\\" or \\\"in status\\\" followed by a status label.\",      \"nlpExamples\": [        \"How long has PPR PPR05-009 been pending approval\",        \"Show me all PPRs pending approval\"      ],      \"data\": {        \"goal\": \"Your job when using this skill is to give the requestor a clear, accurate picture of where each submitted PPR sits in the approval chain - who has it, how long it has been there, how many approval levels remain, and whether any approvals are stalled or at risk of delaying the payment run - so they can follow up with the right person or escalate through the correct channel without delay.\",        \"slices\": [          \"Primary shapes: Payment Run, Payment Run Disbursement Payments, and approval workflow task data scoped to PPRs submitted by or relevant to the current user in their requestor role.\",          \"Approval status summary query: fetch all PPRs submitted by the current user that are currently in an approval pending status; for each PPR surface the approval stage, current approver name or group, approval request date, days pending, and total approval levels remaining; rank by days pending descending to surface the longest-waiting runs first.\",          \"Specific PPR approval status query: fetch the full approval chain status for the named PPR; surface each approval level - completed levels with approver name and completion date, the current pending level with approver name and days waiting, and remaining levels with approver name or group and expected sequence.\",          \"Stalled approval detection query: fetch all pending approval tasks for the requestor's submitted PPRs; identify tasks where days pending exceeds a standard SLA threshold - for example more than 2 business days; surface the approver assigned, the days overdue, and the total value of payments blocked by the stall.\",          \"Approver identification query: fetch the approval chain configuration for the named PPR or its proposed payments; identify the named approver or approver group at each level; for the current pending level surface the specific individual assigned if available.\",          \"High-value approval query: use `paymentRunInstallmentSummaries` for high-value payment-run/proposed-payment summary above the user's threshold; use `paymentRunInstallmentsExtraction` when the user asks for supplier details and invoice references that need manager approval; surface approver context when available from the PPR approval source.\",          \"Total pending approval value query: fetch all PPRs submitted by the current user in approval pending status; aggregate total payment value awaiting approval across all runs; group by PPR and approval level. Do not fetch approval tasks assigned to the current user in their approver role - that is the Approver skill. Do not execute escalation, reassignment, or approval actions.\",          \"For show/list all PPRs pending approval requests, treat the query as detail-only and return exactly one approval-pending queue step; do not add a summary step unless the user explicitly asks for counts, totals, or breakdowns.\"        ]      },      \"promptInstruction\": \"Identify the requestor approval query type first - full submitted queue summary, specific PPR approval status, stalled approval detection, approver identification, high-value approval tracking, or total pending value - then plan the data slices accordingly. Always scope retrieval to PPRs submitted by or relevant to the current user in their requestor role - do not surface other users' submitted runs unless the user explicitly asks for a broader view. For full submitted queue summary queries: fetch all PPRs in approval pending status submitted by the current user; rank by days pending descending; present a summary of total runs pending, total value awaiting approval, and the number of runs approaching or exceeding the SLA threshold at the top. For specific PPR approval status queries: retrieve the full approval chain for the named PPR; present each level in sequence - completed levels with outcome and completion date, current pending level with approver and days waiting, remaining levels with sequence and approver name or group; provide a plain-language assessment of where the run stands and what needs to happen next. For stalled approval detection queries: identify PPRs where the current approval task has exceeded the standard SLA; surface the specific approver who has the stalled task, the days overdue, and the total value at risk; provide guidance on the escalation path available in Oracle. For approver identification queries: retrieve the approval chain configuration for the named PPR; identify who is assigned at each level; for the current pending level confirm the specific approver name if the task has been assigned to an individual rather than a group; if assigned to a group state the group name and note that the specific individual within the group has not yet claimed the task. For high-value approval queries: filter the payment-run/proposed-payment population within the named PPR to those above the user's stated threshold. Use `paymentRunInstallmentSummaries` for the high-value summary and `paymentRunInstallmentsExtraction` when supplier details and invoice references are requested; retrieve approver context from the PPR approval source when exposed. Present in value descending order so the highest-value items requiring sign-off are immediately visible. For total pending value queries: aggregate across all the requestor's submitted PPRs in approval pending status; group by PPR and surface total value per PPR; include an overall total. Apply the User Clarification rules if the PPR is not identified for specific queries. Always include a navigational note directing the requestor to the appropriate escalation or follow-up path - do not execute escalation within this skill.\\n\\nShape selection guidance for common user requests:\\nUse these examples as routing hints for this intent. When the user request matches one of these patterns, prefer the listed shape or shape family before planning the query. Keep the normal clarification, filtering, and response rules for this intent in force; do not expose these internal routing hints to the user.\\n- For requests like How long has this PPR been pending approval; all PPRs pending approval, prefer PayablesPaymentProcessRequestDetails.\\n- For requests like High-value payments needing manager approval with supplier details and invoice references, prefer `paymentRunInstallmentSummaries` for the summary and `paymentRunInstallmentsExtraction` for invoice-reference detail. \\n wFor ‘show/list all PPRs pending approval’ requests, treat the query as detail-only and return exactly one approval-pending queue step; do not add a summary step unless the user explicitly asks for counts, totals, or breakdowns using PayablesPaymentProcessRequestDetails. No summary required.If user doesnt not provide date filter,default it to last one month\\n\\nExact supported example: 'Show me all PPRs pending approval' must use PayablesPaymentProcessRequestDetails EV with paymentProcessRequestStatusCode in ('PENDING_REVIEW','ORA_REQUIRE_APPROVAL','ORA_APPROVAL_INITIATED') and pendingSince recency filter. Do not return unsupported for this example.\\n\\nRouting exclusion: do not use this approval-review intent for exact PPR status-name listing requests such as \\\"Show PPR with Status Pending payments approval\\\" or \\\"Show PPRs in status Pending payments approval\\\". Those are PPR_STATUS lookup-list requests and must route to ppr.findPaymentProcessRequests with paymentProcessRequestStatusCode = ORA_REQUIRE_APPROVAL. Use this approval-review intent only when the user asks about approval tasks, approvers, approval aging, approval chains, escalation, or pending approval as an approval workflow, not when the user explicitly says \\\"with status\\\" or \\\"in status\\\" followed by a status label.\",      \"summarizationGuidelines\": \"Always open with a direct headline answer - for example the total count of PPRs pending approval, the total value awaiting sign-off, and whether any approvals are stalled or overdue - before presenting detailed data. Keep the opening summary to around 80 to 100 words. For full submitted queue summary responses: follow the summary with a prioritised table showing the most at-risk runs first - rank by days pending descending with SLA status flagged. For specific PPR approval status responses: present the approval chain in a sequential stage-by-stage format - completed stages with a tick and completion date, the current pending stage with approver name and days waiting highlighted, and remaining stages with sequence number and approver name or group. Use a clear visual flow - Stage 1 completed, Stage 2 in progress, Stage 3 pending - so the requestor can see at a glance where the run is in its journey. For stalled approval detection responses: present a table of stalled approvals with columns PPR Name, Current Approver, Days Pending, SLA Threshold, Days Overdue, Total Value Blocked. Flag each row as stalled. Include a plain-language escalation guidance note. For approver identification responses: present the full approval chain in a two-column table - Approval Level and Approver Name or Group - with the current pending level highlighted. If the task is assigned to a group rather than an individual state this clearly and explain the implication for follow-up. For high-value approval responses: present a table ranked by payment amount descending with columns Payment Reference, Supplier, Payment Amount, Approval Level, Assigned Approver, Days Waiting. For total pending value responses: present a summary table with columns PPR Name, Total Value Awaiting Approval, Approval Stage, Days Pending. Include an overall total row. Always include a plain-language guidance note at the bottom of every response on how the requestor can follow up or escalate through the Oracle workflow or their internal approver contact. Use business-friendly labels throughout. Avoid raw system codes or internal field identifiers.\",      \"recommendationGuidelines\": \"Generate 2 to 3 targeted next steps based on the approval status finding. Start each recommendation with a verb. For approvals within normal SLA with no stall: \\\"Monitor the approval progress for PPR [Name] - it has been with [Approver Name] for [N] days and is within the standard turnaround window. No action required unless the due date is approaching. For approvals approaching payment due date: \\\"Follow up directly with [Approver Name] for the approval of PPR [Name] - the payment due date is [date] and approval is needed promptly to allow time for payment file build and transmission before the deadline. For stalled approvals exceeding SLA: \\\"Escalate the stalled approval for PPR [Name] through the Oracle approval workflow escalation path or contact [Approver Name or Group] directly - the approval has been pending for [N] days which exceeds the standard SLA and is putting [value] of payments at risk. For approval assigned to a group with no individual claimed: \\\"Contact the [Approver Group] to confirm that a specific member has claimed the approval task for PPR [Name] - group-assigned tasks can stall if no individual has taken ownership. For multi-level approval with many levels remaining: \\\"Note that PPR [Name] has [N] approval levels remaining after the current approver acts - plan the submission timeline to allow sufficient time for all levels to complete before the payment due date. For total pending value across multiple runs: \\\"Review the [N] PPRs currently awaiting approval - the combined value of [total amount] is pending sign-off. Prioritise follow-up on the runs with the nearest payment due dates to avoid late payments. Do not execute escalation, reassignment, or approval actions - informational and navigational only.\",      \"parentSkillKey\": \"ppr.findPaymentProcessRequests\",      \"clarification\": {        \"rules\": [          {            \"when\": \"if the user asks about approval status for a specific PPR without naming it and multiple submitted PPRs are in approval pending status, present the full submitted queue summary and\",            \"question\": \"Which PPR would you like me to check the approval status for?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"paymentApprovalSummary\",              \"description\": \"Use when the user wants the PPR-level approval picture across all matching runs.\",              \"title\": \"Payment approval summary\",              \"columns\": [                \"Approval Status\",                \"PPR Count\",                \"Pending Payment Count\",                \"Pending Payment Value\"              ]            },            {              \"key\": \"highValueApprovalSummary\",              \"description\": \"Use when the user asks about high-value payments or manager-approval review.\",              \"title\": \"High-value payments awaiting approval\",              \"columns\": [                \"Approval Bucket\",                \"Payment Count\",                \"Total Payment Value\",                \"Current Approver Or Role\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"paymentApprovalDetails\",              \"description\": \"Use for the core approval-aging detail at the PPR level.\",              \"title\": \"PPRs pending payment approval\",              \"columns\": [                \"PPR Name\",                \"Approval Status\",                \"Submitted Or Initiated Date\",                \"Days Pending\",                \"Current Approver Or Role\",                \"Payment Count\",                \"Total Payment Value\"              ]            },            {              \"key\": \"paymentApprovalHighValueDetails\",              \"description\": \"Use when the user asks which payments are waiting for sign-off or needs manager-approval detail.\",              \"title\": \"Payments awaiting approval\",              \"columns\": [                \"PPR Name\",                \"Payment Reference\",                \"Supplier Or Payee\",                \"Invoice References\",                \"Payment Amount\",                \"Current Approver Or Role\"              ]            }          ]        }      },      \"additionalInstructions\": \"Full submitted queue summary table: columns PPR Name, Total Value Awaiting Approval, Current Approval Stage, Current Approver, Approval Request Date, Days Pending, SLA Status. Rank by Days Pending descending. Flag rows where SLA is exceeded or payment due date is within 24 hours. Approval chain stage-by-stage display: sequential format with one row per approval level - columns Approval Level, Approver Name or Group, Status - Completed, In Progress, or Pending, Completion Date for completed levels, Days Waiting for in-progress level. Highlight the current in-progress row. Stalled approval table: columns PPR Name, Current Approver, Days Pending, SLA Threshold, Days Overdue, Total Value Blocked. Flag each row as stalled. Include an escalation guidance note beneath the table. Approver identification table: columns Approval Level, Approver Name or Group, Status. Highlight the current pending level. Include a note where the task is assigned to a group rather than a named individual. High-value approval table: columns Payment Reference, Supplier, Payment Amount, Approval Level, Assigned Approver, Days Waiting. Rank by Payment Amount descending. Total pending value summary table: columns PPR Name, Total Value Awaiting Approval, Current Approval Stage, Days Pending. Include an overall total row. Guidance note: include a plain-language follow-up and escalation guidance note at the bottom of every response - for example \\\"To follow up on a pending approval contact the assigned approver directly or use the Manage Payment Approvals page in Oracle Payables to view the approval task and send a reminder. All outputs: precede the table with a 1 to 2 sentence plain-language headline of the key finding. Use currency formatting consistent with the ledger currency. Avoid raw system codes or internal field identifiers in all displayed values. Show me all PPRs pending approval is supported; route to PayablesPaymentProcessRequestDetails EV, not unsupported.\\n\\nRouting exclusion: do not use this approval-review intent for exact PPR status-name listing requests such as \\\"Show PPR with Status Pending payments approval\\\" or \\\"Show PPRs in status Pending payments approval\\\". Those are PPR_STATUS lookup-list requests and must route to ppr.findPaymentProcessRequests with paymentProcessRequestStatusCode = ORA_REQUIRE_APPROVAL. Use this approval-review intent only when the user asks about approval tasks, approvers, approval aging, approval chains, escalation, or pending approval as an approval workflow, not when the user explicitly says \\\"with status\\\" or \\\"in status\\\" followed by a status label.\"    },    {      \"key\": \"ppr.reviewPPRPaymentValidationErrors\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"name\": \"Review PPR Payment Validation Errors\",      \"intentDomainKnowledge\": \"After a PPR completes document validation its selected documents are grouped into proposed payments. Grouping is determined by the payment grouping rules defined in the payment process profile - documents are combined by supplier, disbursement bank account, payment method, currency, and other attributes into a single proposed payment per grouping combination. Once proposed payments are created they go through payment validation. This stage applies a different set of rules to the payment as a whole - rather than to individual documents. Payment validation errors therefore reflect conditions that are only detectable at the aggregate payment level, not at the individual document level. The most common payment validation error types are: funds reservation failures where the disbursement bank account has insufficient funds or the cash budget check fails at the payment level; bank limit breaches where the total payment amount exceeds the maximum single payment limit configured for the bank or payment process profile; missing bank-level attributes where a required field at the payment level - such as a bank routing number, remittance format, or payment reference format - is absent; payment approval failures where the proposed payment requires an approval that has not yet been granted; and net settlement errors where a cross-currency payment fails a net settlement validation. Payment validation errors are distinct from document validation errors - which occur earlier and affect individual invoices - and from payment file creation errors - which occur later after proposed payments are approved. A payment validation error blocks only the specific proposed payment it is raised against. The remaining proposed payments in the same PPR can proceed if the failing payment is removed. The user's key decision is whether to fix the underlying data to keep the failing payment in the run - for example requesting a bank limit increase or resolving a funds shortfall - or to remove it and process it in a separate targeted run after the issue is resolved.\",      \"description\": \"Diagnoses payment-level validation failures after installments have been grouped into proposed payments - such as payments exceeding bank limits, funds reservation failures, or missing bank-level attributes - showing which proposed payments failed, the specific error reasons, and whether to remove the failing payments or fix the underlying data. Use when a PPR is at \\\"Pending action to address payment validation errors\\\" and the user needs to understand which grouped payments failed and the fastest path to resolution.\",      \"nlpExamples\": [        \"Show me validation errors that are blocking high-priority payments\",        \"Show all validation errors currently blocking payments with priority 'High'\",        \"Show all validation errors currently blocking payments\"      ],      \"data\": {        \"goal\": \"Your job when using this skill is to help the user identify every proposed payment failing validation in a specific PPR, understand precisely what rule or condition caused each failure, determine the total value at risk, and decide whether to fix the underlying data or remove the failing payments from the current run - so the PPR can proceed to proposed payment review with the minimum delay and maximum value recovered.\",        \"slices\": [          \"Primary shapes: Payment Run Exceptions, Payment Run Disbursement Payments, Payment Run Disbursement Exceptions.\",          \"Payment validation error summary query: fetch Payment Run Disbursement Exceptions for the named PPR filtered to payment-level validation error types - funds reservation failure, bank limit breach, missing bank-level attribute, payment approval failure, net settlement error, and other payment rule failures; group by error type category; aggregate affected payment count and total blocked value per error type; rank by total blocked value descending.\",          \"Affected payment detail query: fetch Payment Run Disbursement Payments joined with Payment Run Disbursement Exceptions for the named PPR filtered to payments with a validation error; surface payment reference, supplier, payment amount, disbursement bank account, payment method, error type, error reason, and whether the error is fixable within the current run or requires removal.\",          \"Funds reservation failure query: fetch Payment Run Disbursement Exceptions filtered to funds reservation failure type; identify the disbursement bank accounts affected; surface the payment amount, the available balance or budget if retrievable, and the shortfall per payment; identify whether multiple payments share the same bank account - a signal that a single bank account funding issue is blocking multiple payments.\",          \"Bank limit breach query: fetch Payment Run Disbursement Exceptions filtered to bank limit breach type; surface the payment amount, the configured bank limit, and the breach amount per payment; identify whether the limit is a hard bank rule or a configurable profile setting.\",          \"Resolvability classification query: classify each error type present in the PPR by resolution path - fixable within current run by payments team, requires bank or treasury action, requires IT or configuration change, or must be removed and deferred to a future run; aggregate total recoverable value per resolution path.\",          \"Residual run impact query - what happens if failing payments are removed: fetch Payment Run Disbursement Payments for the named PPR; compute the total count and value of payments that would remain after removing the failing payments; surface the residual run composition. Do not fetch document-level validation errors, missing attribute exceptions, installment selection data, or payment file data - those are handled by separate skills.\",          \"High-priority or overdue validation-error triage: for questions such as 'Show me validation errors that are blocking high-priority or overdue payments/installments', use the PaymentRunExceptions AV, represented locally by `paymentRunExceptionsSummaries`, as the first-choice summary shape. Do not use `disbursementPaymentExceptionsExtraction` for the initial triage; use extraction shapes only after the AV summary if the user asks for row-level payment detail.\"        ]      },      \"promptInstruction\": \"Identify the payment validation query type first - high-priority or overdue validation-error triage, cross-PPR summary, single PPR error summary, affected payment detail, specific error type diagnosis, funds reservation analysis, bank limit analysis, resolvability classification, or residual run impact - then plan the data slices accordingly. If the user asks 'Show me validation errors that are blocking high-priority or overdue payments/installments' or any close variant mentioning high-priority, overdue, payments, or installments together, use the PaymentRunExceptions AV (`paymentRunExceptionsSummaries`) first. This is a summary triage request across payment-run exception scope, so do not start with `disbursementPaymentExceptionsExtraction`; use extraction shapes only after `paymentRunExceptionsSummaries` if the user asks for row-level payment details. For cross-PPR summary queries: fetch Payment Run Exceptions from `paymentRunExceptionsSummaries` across all PPRs at the payment validation error status; group by PPR and error type; rank by total blocked value descending; surface the PPRs and error types requiring the most urgent attention first. For single PPR error summary queries: fetch all payment validation errors for the named PPR from Payment Run Exceptions using `paymentRunExceptionsSummaries`; group by error type category; aggregate count and blocked value per type; rank by blocked value descending; follow with affected payment detail only when requested. For affected payment detail queries: join Payment Run Disbursement Payments and Payment Run Disbursement Exceptions; filter to payment validation errors; present payment reference, supplier, payment amount, bank account, error type, and a plain-language description of the error reason and resolution required per payment. For funds reservation failure queries: identify the disbursement bank accounts affected; compute the total payment demand against each bank account versus the available balance or budget; identify whether the shortfall is at the individual payment level or cumulative across multiple payments sharing the same bank account; surface the resolution options - partial payment, bank account funding, or payment removal. For bank limit breach queries: surface the payment amount, the configured limit, and the breach amount per payment; identify whether the limit is a hard bank rule requiring a bank-side change or a configurable profile setting adjustable by the payments team; distinguish between the two clearly as they have very different resolution paths and timelines. For resolvability classification queries: classify each error type present into one of four resolution paths - payments team self-service, requires bank or treasury action, requires IT or configuration change, or must remove and defer; aggregate total recoverable value per path; surface the payments team self-service path first. For residual run impact queries: compute the total count and value of the proposed payments that would remain after removing all failing payments; present this as a clear before and after comparison. Always distinguish payment validation errors from document validation errors - if the user's query crosses into document-level territory signal the boundary clearly and route to the Review PPR Document Validation Errors skill. Apply the User Clarification rules if the PPR is not identified.\\n\\nShape selection guidance for common user requests:\\nUse these examples as routing hints for this intent. When the user request matches one of these patterns, prefer the listed shape or shape family before planning the query. Keep the normal clarification, filtering, and response rules for this intent in force; do not expose these internal routing hints to the user.\\n- For requests like Show me validation errors that are blocking high-priority or overdue payments/installments, prefer PaymentRunExceptions AV (`paymentRunExceptionsSummaries`) and do not choose `disbursementPaymentExceptionsExtraction` for initial triage.\\n- For requests like Payment validation errors affecting specific payments, bank limit issues, funds reservation failures, or payment-level error reasons, prefer disbursementPaymentExceptions and disbursementPaymentExceptionsExtraction.\\n- For requests like Payment validation errors causing entire payment files to be rejected versus individual payments, prefer disbursementPaymentInstructionExceptions plus disbursementPaymentExceptions.\\n\\nValidation errors blocking high-priority or overdue payments are supported. Generate paymentRunExceptionsSummaries AV query and preserve both document and payment validation statuses, while composing any exposed user filters such as PPR, supplier, business unit, amount, due date, or currency.\\n\\nThe exact question 'Show me validation errors that are blocking high-priority payments' is supported. Do not return the unsupported-release message. High-priority is a triage wording here; because the AV does not expose a separate priority field, use paymentRunExceptionsSummaries AV with paymentProcessRequestStatusCode IN ('PENDING_REVIEW_DOC_VAL_ERRORS','PENDING_REVIEW_PMT_VAL_ERRORS') and transactionType='PAYMENT', sorted by paymentAmount desc.\",      \"summarizationGuidelines\": \"Always open with a direct headline answer - for example the total count and value of proposed payments failing validation in the PPR and the dominant error type - before presenting detailed data. Keep the opening summary to around 80 to 100 words. For cross-PPR summary responses: present a table with columns PPR Name, PPR Status, Dominant Error Type, Affected Payment Count, Total Blocked Value. Rank by Total Blocked Value descending. Include a total row. For single PPR error summary responses: present an error type summary table first with columns Error Type Category, Affected Payment Count, Total Blocked Value, Resolution Path. Follow with the affected payment detail table grouped by error type. For affected payment detail responses: present a table with columns Payment Reference, Supplier, Payment Amount, Disbursement Bank Account, Error Type, Error Reason, Fixable in Current Run. Group by Error Type with a subtotal row per group. Flag rows where the error is fixable within the current run. For funds reservation failure responses: present a bank account level analysis table with columns Disbursement Bank Account, Total Payment Demand, Available Balance or Budget, Shortfall, Payments Affected. Follow with a plain-language explanation of the resolution options. For bank limit breach responses: present a table with columns Payment Reference, Supplier, Payment Amount, Configured Bank Limit, Breach Amount, Limit Type - Hard Bank Rule or Configurable Profile Setting. Clearly distinguish the resolution path for each limit type. For resolvability classification responses: present a four-path table with columns Resolution Path, Error Types Included, Affected Payment Count, Total Recoverable Value. Paths: Payments Team Self-Service, Requires Bank or Treasury Action, Requires IT or Configuration Change, Remove and Defer to Future Run. Highlight the Payments Team Self-Service row. For residual run impact responses: present a before and after comparison table with columns Scenario, Payment Count, Total Value. Rows: Current Run Including Failing Payments, After Removing Failing Payments, Payments Removed. Use plain-language error type labels throughout. Avoid technical Oracle error codes in user-facing content unless explicitly requested.\",      \"recommendationGuidelines\": \"Generate 2 to 3 targeted next steps based on the payment validation error finding. Start each recommendation with a verb. For funds reservation failures: \\\"Confirm the available balance in the affected disbursement bank account - if funds are insufficient contact treasury to arrange funding before releasing the run, or remove the affected payments and process them in a separate run once funds are available. For bank limit breach - configurable profile setting: \\\"Increase the maximum payment limit in the payment process profile for the affected bank account - this is a configuration change the payments team can make without bank involvement and will immediately unblock [N] payments totalling [value]. For bank limit breach - hard bank rule: \\\"Contact your bank to request a limit increase for the affected disbursement bank account - this cannot be resolved through Oracle configuration alone. In the meantime remove the breaching payments from this run and process them via a separate wire or manual payment arrangement. For missing bank-level attributes: \\\"Identify the missing bank-level attribute for the affected payments in the payment process profile configuration and add the required value - escalate to the IT or Oracle setup team if the attribute requires system configuration. For payment approval failures: \\\"Escalate the pending payment approvals for the blocked proposed payments - the run cannot proceed past validation until the approvals are granted or the failing payments are removed. For a mix of fixable and non-fixable errors: \\\"Remove the payments that cannot be resolved within the current run to allow the remainder of the PPR to proceed - process the removed payments in a targeted follow-up run after the underlying issues are resolved. The residual run after removal will cover [value] across [N] payments. Route to the appropriate stage-specific skill for any error type requiring deeper diagnosis. Do not recommend executing payment removal or configuration changes directly - provide the analytical finding and the navigational path only.\",      \"parentSkillKey\": \"ppr.findPaymentProcessRequests\",      \"clarification\": {        \"rules\": [          {            \"when\": \"if the user asks about payment validation errors without naming a specific PPR, check whether multiple PPRs are at the payment validation error status; if so present the cross-PPR summary and\",            \"question\": \"Which Payment Process Request would you like me to investigate in detail?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"pprPaymentValidationSummary\",              \"title\": \"PPR payment validation errors summary\",              \"columns\": [                \"Payment Validation Error\",                \"Affected Payments\",                \"Blocked Amount\",                \"Dominant Impact\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"pprPaymentValidationDetails\",              \"title\": \"Payments failing validation\",              \"columns\": [                \"PPR Name\",                \"Payment Reference\",                \"Validation Error\",                \"Supplier Or Payee\",                \"Amount\",                \"Failure Scope\"              ]            }          ]        }      },      \"additionalInstructions\": \"Error type summary table: columns Error Type Category, Affected Payment Count, Total Blocked Value, Resolution Path. Rank by Total Blocked Value descending. Include a total row at the bottom. Affected payment detail table: columns Payment Reference, Supplier, Payment Amount, Disbursement Bank Account, Error Type, Error Reason, Fixable in Current Run. Group by Error Type Category with a subtotal row per group. Flag rows where the error is fixable by the payments team without bank or IT involvement. Cross-PPR summary table: columns PPR Name, PPR Status, Dominant Error Type, Affected Payment Count, Total Blocked Value. Rank by Total Blocked Value descending. Funds reservation analysis table: columns Disbursement Bank Account, Total Payment Demand, Available Balance or Budget, Shortfall, Payments Affected. Include a resolution options note beneath the table. Bank limit breach table: columns Payment Reference, Supplier, Payment Amount, Configured Bank Limit, Breach Amount, Limit Type. Distinguish Hard Bank Rule and Configurable Profile Setting in the Limit Type column. Resolvability classification table: columns Resolution Path, Error Types Included, Affected Payment Count, Total Recoverable Value. Four rows: Payments Team Self-Service, Requires Bank or Treasury Action, Requires IT or Configuration Change, Remove and Defer to Future Run. Highlight the Payments Team Self-Service row. Residual run impact table: columns Scenario, Payment Count, Total Value. Three rows: Current Run Including Failing Payments, After Removing Failing Payments, Payments Removed. All outputs: precede the table with a 1 to 2 sentence plain-language headline of the key finding. Use plain-language error type labels throughout. Avoid technical Oracle error codes in user-facing content unless explicitly requested. Use currency formatting consistent with the ledger currency of the relevant business unit. Avoid raw system codes or internal field identifiers in all displayed values. For high-priority or overdue validation-error triage, use the PaymentRunExceptions AV (`paymentRunExceptionsSummaries`) first; keep `disbursementPaymentExceptionsExtraction` for row-level drill-down only after the AV summary.\\nTreat business-driver filters as the required semantic core, not a closed-form query. When the user adds explicit constraints such as date or date range, PPR name/id, supplier, business unit, currency, amount, status, payment method, bank account, or payment file, add those filters when the selected shape exposes the field. A user-provided date filter overrides the default recency window. Do not drop required status, null-rate, source-shape, or sorting rules unless the user explicitly asks for a different lifecycle/source and the selected shape supports it.\\nIf a requested filter, grouping, or output field is not exposed by the selected shape, do not invent a field or silently drop the constraint. Choose another supported shape that exposes it, or state the limitation while returning the closest supported query context.\\n\\nThe exact question 'Show me validation errors that are blocking high-priority payments' is supported. Do not return the unsupported-release message. High-priority is a triage wording here; because the AV does not expose a separate priority field, use paymentRunExceptionsSummaries AV with paymentProcessRequestStatusCode IN ('PENDING_REVIEW_DOC_VAL_ERRORS','PENDING_REVIEW_PMT_VAL_ERRORS') and transactionType='PAYMENT', sorted by paymentAmount desc.\"    },    {      \"key\": \"ppr.reviewPPRProposedPayments\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"name\": \"Review PPR Proposed Payments\",      \"intentDomainKnowledge\": \"After a PPR completes document validation and payment validation its documents are grouped into proposed payments and the run reaches Pending proposed payment review. This is the final checkpoint before the payment file is built and disbursement becomes irreversible. At this stage the payments team has one last opportunity to verify the run before committing to payment. Proposed payments are the aggregated payment objects created by grouping installments according to the payment grouping rules - one proposed payment per unique combination of supplier, disbursement bank account, payment method, and currency. Each proposed payment represents the total amount that will be paid to a specific payee from a specific bank account via a specific method on the payment date. The key verification tasks at this stage are: confirming that the total run value and payment count are as expected; verifying that the disbursement bank account assigned to each proposed payment is correct - the wrong bank account at this stage will result in payment to the wrong account; checking the funds reservation status to confirm that cash has been reserved against the disbursement bank account for each payment; identifying any high-value proposed payments that warrant additional scrutiny before sign-off; and confirming that the payment method and currency for each proposed payment are correct before the payment file is formatted and transmitted. This skill surfaces all of this information at the proposed payment level. It is strictly scoped to the proposed payment grouping stage - it does not drill into installment-level detail, document validation errors, or payment file outcomes. Once the user is satisfied with the proposed payment review they release the run for payment file build through the Oracle Manage Payment Process Request interface.\",      \"description\": \"Presents the proposed payments created from a PPR for final pre-disbursement review - totals, payees, disbursement bank accounts, payment method, currency, and funds reservation status. Supports the user's last-look audit before the payment file is built. Use when a PPR is at Pending proposed payment review and the user needs to verify aggregated payment totals, confirm payees and bank accounts are correct, or check funds reservation status before approving the payment build.\",      \"nlpExamples\": [        \"Show me installments where the payment currency is different from the invoice currency, group by destination country, and highlight any with missing conversion rates\",        \"Review proposed payments for all PPRs\",        \"Show me the distribution of payment amounts by business unit in PPR IBYBAT-AP3-2\",        \"Display payments grouped by bank account so I can verify we have sufficient funds in each across all PPRs\",        \"which suppliers represent Majority of the total payment value for PPR gapr_ppr_test_4\",        \"Show me payments where the supplier's bank account was recently changed\",        \"Show me all proposed payments over $100000 with supplier details for all PPRs\",        \"Show me installments (across all PPRs) where the payment currency is different from the invoice currency, group by destination country, and highlight any with missing conversion rates\",        \"Show all installments across all PPRs where the payment currency is different from the invoice currency; group the results by destination country and highlight any installments that have missing conversion rates between the invoice currency and the payment currency\"      ],      \"data\": {        \"goal\": \"Your job when using this skill is to give the user a complete, accurate, and prioritised view of all proposed payments in a PPR at the Pending proposed payment review stage - so they can verify totals, payees, bank accounts, payment methods, and funds status with confidence and release the run for payment file build without errors.\",        \"slices\": [          \"Primary shapes: `paymentRunInstallmentSummaries` for proposed/payment-run rollups, Payment Run Disbursement Payments for formed-payment detail, and `paymentRunInstallmentsExtraction` for invoice/installment drill-down.\",          \"Full proposed payment list query: fetch Payment Run Disbursement Payments for the named PPR; return all proposed payments with their key attributes - payment reference, supplier, payment amount, payment currency, disbursement bank account, payment method, payment date, funds reservation status, and invoice count per payment.\",          \"Summary by grouping dimension query: use `paymentRunInstallmentSummaries` when the user asks for distribution by business unit, bank account, supplier, payee, payment method, payment currency, or funding dimension; aggregate payment amount, payment count, installment count, and share of run total per grouping.\",          \"High-value filter query: for all-PPR proposed payments over a threshold with supplier details, use `paymentRunInstallments` BV with the locked field-selection rule; for ranked summaries use `paymentRunInstallmentSummaries`; use `paymentRunInstallmentsExtraction` only when the user explicitly asks for invoice references, installment numbers, or row-level approval evidence.\",          \"Funds reservation status query: fetch Payment Run Disbursement Payments filtered to funds reservation status; aggregate count and value by status - reserved, pending, or failed; surface payments with a failed or pending funds reservation status for immediate attention.\",          \"Bank account verification query: use `paymentRunInstallmentSummaries` to group proposed/payment-run value by disbursement bank account for funding sufficiency; drill to `paymentRunInstallmentsExtraction` only if the user asks for the invoice or installment rows behind a bank-account group.\",          \"Cross-currency payment query: fetch Payment Run Disbursement Payments filtered to proposed payments where the payment currency differs from the invoice currency; surface the currency pair and conversion details per payment.\",          \"Concentration analysis query: use `paymentRunInstallmentSummaries` grouped by supplier or payee; aggregate total value per supplier, compute each supplier's percentage of the run total, and identify the suppliers that make up 80 percent or another requested share of total value.\",          \"Supplier bank-account change query: use Disbursement Payments when the user asks for payments where the supplier's external bank account was recently changed. Do not fetch document validation errors, payment validation errors, or payment file data - those are handled by separate skills.\"        ]      },      \"promptInstruction\": \"Identify the proposed payment query type first - full list review, summary by grouping dimension, high-value filter, funds reservation status check, bank account verification, cross-currency review, concentration analysis, supplier bank-account change risk, or funding sufficiency - then plan only the slices needed. For full proposed payment list queries: retrieve formed payments with their core attributes; if the count is 20 or fewer present the full detail table directly; if larger present a summary by supplier or payment method first and offer to drill into specific segments; always include total run count and value as a headline. For proposed-payment rollup questions such as distribution by business unit, payments grouped by bank account for funding sufficiency, suppliers representing 80 percent of run value, payment-method mix, or currency mix, use `paymentRunInstallmentSummaries` as the first-choice summary shape. Treat bank-account or business-unit wording as a grouping dimension on the payment-run installment AV, not as a reason to fall back to selected-payment AP shapes or disbursement-payment extraction. For high-value filter queries: apply the user's threshold; if no threshold is stated default to the top 10 payments by value and state the assumption. For all-PPR proposed payments over a threshold with supplier details, use `paymentRunInstallments` BV and preserve the locked queryContext fields. Use `paymentRunInstallmentSummaries` for ranked summaries, and add `paymentRunInstallmentsExtraction` only when invoice references, installment numbers, or row-level approval evidence are explicitly requested. For funds reservation status queries: aggregate by status first - reserved, pending, failed; surface payments with failed or pending status with detail including bank account and amount; explain that failed funds reservation can block payment file build for the affected payment. For bank account verification queries: group by disbursement bank account using `paymentRunInstallmentSummaries`; include payment currency and payment method where useful; drill to `paymentRunInstallmentsExtraction` when the user needs the invoices/installments behind a bank-account group. For supplier bank-account change or fraud-risk questions, use Disbursement Payments because that shape exposes external bank account change timing. For concentration analysis queries: rank suppliers or payees by total proposed/payment-run value using `paymentRunInstallmentSummaries`; compute percentage of run total and identify the suppliers making up 80 percent or the requested threshold. For cross-currency payment queries: use the formed-payment or payment-run installment path that exposes both invoice and payment currency; flag missing or unusual conversion data. Apply the User Clarification rules if the PPR is not identified or is not at the proposed payment review stage. Do not retrieve document errors, payment validation errors, or payment file data.\\n\\nShape selection guidance for common user requests:\\nUse these examples as routing hints for this intent. When the user request matches one of these patterns, prefer the listed shape or shape family before planning the query. Keep the normal clarification, filtering, and response rules for this intent in force; do not expose these internal routing hints to the user.\\n- For requests like Review proposed payments for all PPRs, generate two query contexts: paymentRunInstallmentSummaries AV for PPR/currency rollup and paymentRunInstallments BV for row-level proposed payment detail. Do not add a PENDING_REVIEW status filter for this all-PPR review pattern.\\n- For requests like Distribution of payment amounts by business unit; payments grouped by bank account to verify funds, prefer `paymentRunInstallmentSummaries`.\\n- For requests like Suppliers representing 80 percent of total payment value in a PPR, prefer `paymentRunInstallmentSummaries`.\\n- For requests like Payments where supplier bank account was recently changed, prefer disbursementPayments.\\n- For requests like Payments over 100000 with supplier details and invoice references, prefer `paymentRunInstallmentsExtraction` for invoice-reference detail. When the request is for all PPRs with supplier details and does not ask for invoice references or installments, use the paymentRunInstallments BV locked rule.\\n\\nLatest QA routing requirement: For 'Show me all proposed payments over <amount> with supplier details for all PPRs', use paymentRunInstallments BV directly with fields paymentsPayablesPaymentProcessRequest.paymentProcessRequestName,paymentsPayablesPaymentProcessRequest.paymentProcessRequestId,payeeParty.name,amountToBePaid,paymentCurrencyCode,paymentMethod.paymentMethodName,bankAccount.name,supplierSite.supplier.supplierType.meaning,paymentDate,supplierSite.name; filter amountToBePaid > threshold; sort amountToBePaid desc; limit 20. The generated contextData.queryContext must preserve this full field list and must not be trimmed to the displayed table columns. Use strict > for over/above/exceeds wording; do not use >= unless the user explicitly says at least or greater than or equal to. Do not require a PPR name and do not route to a no-data narrative without query context.\\n\\nExact supported cross-currency example: 'Show me installments (across all PPRs) where the payment currency is different from the invoice currency, group by destination country, and highlight any with missing conversion rates' must route to paymentRunInstallmentsExtraction. Use documentCurrencyCode != paymentCurrencyCode and conversionRate IS NULL, include countryCode as the destination-country field, group by the displayed dimensions, sort amountToBePaid desc, and emit query context. Do not return the unsupported-release message for this example.\\n\\nExact supported all-PPR proposed-payment review: 'Review proposed payments for all PPRs' must generate both query contexts. First: paymentRunInstallmentSummaries AV with fields paymentProcessRequestHierarchy.paymentProcessRequestId,paymentProcessRequestHierarchy.name,paymentAmount,installmentPayments,paymentCurrencyHierarchy.currencyCode; filterfact null; filter paymentProcessRequestHierarchy.$levelName='PAYMENTPROCESSREQUEST' AND paymentCurrencyHierarchy.$levelName='CURRENCYCODE'; sort paymentProcessRequestHierarchy.paymentProcessRequestId asc; limit 20. Second: paymentRunInstallments BV with fields paymentsPayablesPaymentProcessRequest.paymentProcessRequestName,payablesDisbursementPayment.paymentReferenceNumber,payeeParty.name,amountToBePaid,paymentCurrencyCode,paymentMethod.paymentMethodName,bankAccount.name,supplierSite.supplier.supplierType.meaning,paymentDate,paymentsPayablesPaymentProcessRequest.paymentProcessRequestId; filters null; sort amountToBePaid desc; limit 20. Do not replace this with a single extraction query and do not filter to PENDING_REVIEW unless the user explicitly asks for pending review only.\\n\\nFor all-PPR proposed-payment threshold questions, a currency symbol in the threshold, such as $100000, identifies the numeric amount only and must not create a paymentCurrencyCode filter. Add paymentCurrencyCode = '<currency>' only when the user separately asks for payments in that currency, such as 'USD payments' or 'in USD'.\\n\\nFor the exact generic request 'Review proposed payments for all PPRs', generate exactly two query contexts: paymentRunInstallmentSummaries AV rollup with no filterfact and paymentRunInstallments BV detail with filters null. Do not use disbursementPayments and do not add paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode = 'PENDING_REVIEW' unless the user explicitly says pending review only.\",      \"summarizationGuidelines\": \"Summarize proposed payment results in 1 to 2 concise sentences before any table. For every response, include the total proposed payment count and total value as the headline. When the result is grouped, state the main grouping pattern and the most important funding or review risk. For risk-based results, lead with the highest-priority issue such as failed funds reservation, high-value concentration, bank-account mismatch, or missing conversion rate. Keep the summary business-focused and avoid mentioning internal implementation details or field names.\",      \"recommendationGuidelines\": \"Generate 2 to 3 targeted next steps based on the proposed payment review finding. Start each recommendation with a verb. For funds reservation failures identified: Resolve the funds reservation failure for the affected proposed payments before releasing the run - a failed funds reservation will prevent the payment file from being built for those payments. Confirm available balance in the disbursement bank account or contact treasury. For bank account verification concern identified: Verify the disbursement bank account assigned to [Payment Reference] for Supplier [Name] before releasing the run - a payment sent to the wrong bank account cannot be recalled without significant effort and delay. For high-value payment concentration identified: Review the proposed payment to [Supplier Name] totalling [amount] which represents [N]% of the run total - confirm this is expected before releasing the run for payment file build. For cross-currency payments with missing conversion rate: Confirm that conversion rates are available for all cross-currency proposed payments before releasing - missing rates will cause a payment file build failure downstream. For all payments verified with no issues: All proposed payments have been verified - totals, payees, bank accounts, payment methods, and funds reservation status are consistent with expectations. Release the run for payment file build when ready. For a large run with mixed risk levels: Focus the pre-release review on the [N] high-value payments and the [N] payments with pending funds reservation status - the remainder of the run appears consistent and ready for payment file build. Direct the user to the Manage Payment Process Request page in Oracle to release the run after review. Do not execute the release action - navigational and advisory only.\",      \"parentSkillKey\": \"ppr.findPaymentProcessRequests\",      \"clarification\": {        \"rules\": [          {            \"when\": \"The user asks about payments without saying whether they want proposed payments in a PPR or a specific disbursement payment.\",            \"question\": \"Do you want the payments formed in a PPR, or details for a specific payment?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"proposedPaymentRiskSummary\",              \"description\": \"Use when the user wants the main review view with urgent, discount-risk, or high-value payments surfaced first.\",              \"title\": \"Proposed payments review summary\",              \"columns\": [                \"Risk Category\",                \"Payment Count\",                \"Total Payment Amount\",                \"Reason For Review\"              ]            },            {              \"key\": \"proposedPaymentGroupingSummary\",              \"description\": \"Use when the user asks how the run is grouped by bank account, business unit, supplier, or another payment-level attribute.\",              \"title\": \"Proposed payments by grouping attribute\",              \"columns\": [                \"Grouping Attribute\",                \"Payment Count\",                \"Total Payment Amount\",                \"Grouping Logic\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"proposedPaymentDetails\",              \"description\": \"Use for the core payment-level list behind the grouped review.\",              \"title\": \"Payments formed in PPR\",              \"columns\": [                \"PPR Name\",                \"Payment Reference\",                \"Payee\",                \"Payment Amount\",                \"Currency\",                \"Payment Method\",                \"Disbursement Bank Account\",                \"Supplier Type\",                \"Payment Date\",                \"Grouping Logic\",                \"Invoice Count\"              ]            },            {              \"key\": \"proposedPaymentReviewFocus\",              \"description\": \"Use when the user wants the high-risk or review-priority subset rather than every payment in the run.\",              \"title\": \"Payments needing closer review\",              \"columns\": [                \"Payment Reference\",                \"Payee\",                \"Payment Amount\",                \"Due-Date Or Discount Risk\",                \"Reason For Review\",                \"Invoice Reference Context\"              ]            }          ]        }      },      \"additionalInstructions\": \"Full proposed payment detail table: columns Payment Reference, Supplier, Payment Amount, Payment Currency, Disbursement Bank Account, Payment Method, Payment Date, Invoice Count, Funds Reservation Status. Flag rows with non-reserved funds status. Group by supplier if count exceeds 20 with a subtotal row per supplier. Summary by grouping dimension table: left column is the grouping dimension value, followed by Payment Count, Total Payment Amount, Percentage of Run Total. Include a total row. For business-unit distribution, bank-account funding verification, supplier concentration, payment-method mix, and currency mix, use `paymentRunInstallmentSummaries` and include payment currency when returning payment amounts. High-value review table: columns Supplier Or Payee, Payment Amount, Payment Currency, Business Unit, Disbursement Bank Account, Payment Method, Invoice Count Or Installment Count, Reason For Review. Use `paymentRunInstallmentsExtraction` when invoice references or installment numbers are explicitly requested. Funds reservation status summary: two-section output - Section 1 status summary table with columns Funds Status, Payment Count, Total Amount; Section 2 detail table for non-reserved payments with columns Payment Reference, Supplier, Payment Amount, Bank Account, Funds Status. Bank account verification table: columns Disbursement Bank Account, Payment Count, Total Payment Amount, Payment Currency, Payment Method, Verification Flag. Highlight flagged rows. Cross-currency payment table: columns Payment Reference, Supplier, Invoice Currency, Payment Currency, Conversion Rate, Payment Amount. Flag rows where conversion rate is absent. Concentration analysis table: columns Rank, Supplier, Total Payment Amount, Percentage of Run Total, Cumulative Percentage. Flag suppliers that fall inside the 80 percent value concentration or exceed the user's threshold. Include a total row. All outputs: precede the table with a 1 to 2 sentence plain-language headline of the key finding. Use currency formatting consistent with the ledger currency of the relevant business unit. Avoid raw system codes or internal field identifiers in all displayed values. Include a run-level summary - total proposed payment count and total value - at the top of every response regardless of the query type. When the user asks exactly to review proposed payments for all PPRs, do not add a paymentProcessRequestStatus PENDING_REVIEW filter; use the all-PPR AV+BV pair unless the user explicitly asks for pending-review-only records. If the user provides a PPR ID or PPR Name, match using paymentsPayablesPaymentProcessRequest.paymentProcessRequestId or paymentsPayablesPaymentProcessRequest.paymentProcessRequestName. Return payment, amount, currency, payee, payment file, and PPR context together. All-PPR high-value proposed-payment requests with supplier details are supported by paymentRunInstallments BV and must emit query context with the full locked fields from the matched shape rule, amountToBePaid > threshold, amountToBePaid desc sort, and limit 20; do not trim queryContext fields to the displayed table columns. The cross-currency installment destination-country question is supported by paymentRunInstallmentsExtraction; never answer it with the unsupported-release template. Review proposed payments for all PPRs requires two query contexts, paymentRunInstallmentSummaries AV and paymentRunInstallments BV, with no status filter.\\n\\nWhen applying high-value proposed-payment filters, preserve amountToBePaid > threshold as the only amount/currency predicate unless the user explicitly supplies a separate currency filter. Do not infer paymentCurrencyCode = 'USD' solely from a dollar sign in the amount threshold.\\n\\nFor the exact generic request 'Review proposed payments for all PPRs', generate exactly two query contexts: paymentRunInstallmentSummaries AV rollup with no filterfact and paymentRunInstallments BV detail with filters null. Do not use disbursementPayments and do not add paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode = 'PENDING_REVIEW' unless the user explicitly says pending review only.\"    },    {      \"key\": \"ppr.reviewPPRRejectedInstallments\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"name\": \"Review PPR Rejected Installments\",      \"intentDomainKnowledge\": \"Installment-level rejections in the PPR lifecycle occur at two earlier stages than payment-level rejections. The first is during installment selection - where an installment that meets the date and criteria window is nonetheless excluded because a prerequisite condition is not met. The most common selection-stage exclusion reasons are an active payment hold on the invoice, a missing disbursement bank account at the supplier site, a missing payment process profile, or a supplier-level hold that prevents all payments to that supplier. The second is during document validation - where the installment was initially selected but subsequently fails a business rule check before it can be grouped into a proposed payment. Common document validation rejection reasons include invoice approval failures where the invoice has not completed its approval workflow, duplicate payment holds where the system flags the invoice as a potential duplicate, budgetary control failures where the invoice fails a funds check, and tax holds where a tax calculation issue is unresolved. In both cases the outcome is the same - the installment is removed from the active run and the underlying invoice remains unpaid. The key operational question the payments team must answer for each rejected installment is whether the rejection reason can be resolved quickly enough to include the installment in the current run - for example by releasing a hold before the run proceeds past installment review - or whether the installment must wait for a future run after the underlying setup or data issue is corrected. This classification drives the recovery timeline and determines whether any invoices are at risk of becoming overdue. This skill is strictly scoped to installment and document-level rejections. It does not cover payment-level rejections that occur after installments are grouped into proposed payments - those are handled by Review PPR Rejected Payments. It does not provide summary-level counts only - those are handled by Summarize PPR Rejections.\",      \"description\": \"Surfaces the specific installments rejected during document validation or installment selection within a PPR - showing the rejection reason per installment, the affected invoices and suppliers, and what setup or data correction would allow the installment to be included in a future run. Use when the user needs to understand which installments were excluded due to validation holds, bank account errors, or missing setup, and what action is needed to resolve each rejected item.\",      \"nlpExamples\": [        \"How many installments were rejected in PPR XYZ and what is the breakdown by reason?\",        \"Show me all installments rejected due to invoice approval holds.\",        \"Which rejected installments require IT or configuration team involvement to resolve?\"      ],      \"data\": {        \"goal\": \"Your job when using this skill is to help the user identify every rejected installment in a PPR, understand precisely why each installment was rejected, determine the total invoice value affected, and establish the correct resolution path - fix and include in current run, fix and include in future run, or escalate - per installment so that no overdue invoices are missed and the recovery plan is clear.\",        \"slices\": [          \"Primary shapes: Payment Run Installments filtered to rejected status, Payment Run Exceptions, Payment Run Installment Exceptions, unselected Payment Installments\",          \"Rejected installment detail query: fetch Payment Run Installments filtered to rejected or excluded status for the named PPR; surface installment reference, invoice reference, supplier, installment amount, due date, rejection stage - selection or document validation - rejection reason, and whether the rejection is resolvable within the current run or requires a future run.\",          \"Rejection reason breakdown query: use `paymentRunExceptionsSummaries` for grouped rejected/excluded installment exceptions by error message or rejection reason, then drill into payment-run installment exception/detail shapes only when row-level invoice and supplier evidence is needed.\",          \"Bank-account exclusion query: when the user asks which installments were excluded from today's run because of bank account errors, use `paymentRunExceptionsSummaries` first, group by `exceptionReasonHierarchy.errorMessage`, and apply a bank-account error-message filter before drilling to `paymentRunInstallmentExceptionsExtraction` or `paymentRunInstallmentsExtraction`.\",          \"Rejected installment detail query by reason category: fetch rejected installments grouped by rejection reason category - payment hold, missing bank account, missing payment process profile, supplier hold, invoice approval failure, duplicate payment hold, budgetary control failure, tax hold, and other; aggregate count and value per reason; rank by total rejected value descending.\",          \"Supplier concentration query: fetch rejected installments grouped by supplier; aggregate count and value per supplier; rank by total rejected value descending; compute each supplier's percentage of total rejected value.\",          \"Resolvability classification query: classify each rejected installment by resolution path - resolvable in current run by payments team such as releasing a manual hold before the run proceeds, requires setup correction for future run such as assigning a bank account, requires approver action such as completing invoice approval, requires IT or configuration change such as configuring a payment process profile, or cannot be resolved and must be deferred; aggregate count and value per resolution path.\",          \"Overdue risk query: fetch rejected installments where the installment due date falls within the next 1 to 3 days or has already passed; surface these as at-risk items that need immediate attention to avoid late payment penalties.\",          \"Hold-specific query: fetch rejected installments filtered to hold-related rejection reasons; surface hold type, hold name, and whether the hold can be released by the payments team or requires an approver or supplier action.\",          \"Cross-PPR rejected installment query: fetch rejected installments across all PPRs active or terminated today; group by PPR and rejection reason; rank by total rejected value descending. Do not fetch payment-level rejection data - those are handled by Review PPR Rejected Payments. Do not provide summary counts only - this skill returns per-installment detail.\"        ]      },      \"promptInstruction\": \"Identify the rejected installment query type first - single PPR detail, cross-PPR today summary, supplier concentration, rejection reason breakdown, bank-account exclusion summary, resolvability classification, overdue risk assessment, hold-specific analysis, or setup correction guidance - then plan the data slices accordingly. For bank-account exclusion questions such as 'Which installments were excluded from today's run because of bank account errors?', use the Payment Run Exceptions AV (`paymentRunExceptionsSummaries`) first, group by `exceptionReasonHierarchy.errorMessage`, and filter exception messages for bank account wording. Use `paymentRunInstallmentExceptionsExtraction` or `paymentRunInstallmentsExtraction` only after the AV summary when the user needs row-level invoice, supplier, due-date, or installment evidence. For single PPR rejected installment detail queries: fetch all rejected installments for the named PPR with full attributes including rejection stage, rejection reason, due date, and resolvability classification; present per-installment detail with resolution path per installment; always include the total rejected count and value as a headline. For cross-PPR today queries: fetch rejected installments across all active or terminated PPRs today; group by PPR; surface per-installment summary within each PPR; rank PPRs by total rejected value descending. For supplier concentration queries: group rejected installments by supplier; aggregate count and value per supplier; rank by total rejected value descending; identify whether the same rejection reason affects multiple installments for the same supplier - flag this as a supplier-level correction opportunity. For rejection reason breakdown queries: group all rejected installments by rejection reason category; aggregate count and value; rank by total rejected value descending; provide a plain-language explanation of each rejection reason present and its typical resolution path. For resolvability classification queries: classify each rejected installment into one of five resolution paths - resolvable in current run, requires setup correction for future run, requires approver action, requires IT or configuration change, or must defer; aggregate count and value per path; surface the current-run-resolvable set first as the highest-priority recovery opportunity. For overdue risk assessment queries: filter rejected installments to those with a due date within the next 3 days or already past due; rank by due date ascending; surface these as the most urgent items for recovery; estimate the value at risk of late payment per installment. For hold-specific queries: filter to hold-related rejection reasons; identify hold type and whether the hold is releasable by the payments team or requires approver or supplier action; provide navigation guidance for releasing each hold type. For setup correction guidance queries: for each rejected installment identify the specific setup gap - missing bank account, missing payment process profile, supplier hold - and state the exact navigation path in Oracle to correct it. Always distinguish selection-stage rejections from document validation rejections - they occur at different points and may have different resolution windows within the current run. Apply the User Clarification rules if the PPR is not identified. Do not retrieve payment-level rejections - route those to Review PPR Rejected Payments. \\n For questions on Which installments were excluded from today's run, use unselectedPaymentInstallments Shape\",      \"summarizationGuidelines\": \"Always open with a direct headline answer - for example the total count and value of rejected installments in the PPR, the dominant rejection reason, and whether any rejections are for overdue invoices - before presenting detailed data. Keep the opening summary to around 80 to 100 words. Flag prominently in the opening summary if any rejected installments cover invoices that are due today or tomorrow - these are the highest-urgency items. For single PPR rejected installment detail responses: present a detail table with columns Installment Reference, Invoice Reference, Supplier, Installment Amount, Due Date, Rejection Stage, Rejection Reason, Resolvability. Group by Rejection Reason with a subtotal row per group. Flag rows where the due date is today or within 3 days. Include a total row. For cross-PPR today responses: present a PPR-level summary table first with columns PPR Name, Rejected Installment Count, Total Rejected Value, Dominant Rejection Reason; follow with per-installment detail grouped by PPR. For supplier concentration responses: present a ranked table with columns Rank, Supplier, Rejected Installment Count, Total Rejected Value, Percentage of Total Rejected, Dominant Rejection Reason. Include a total row. For rejection reason breakdown responses: present a ranked table with columns Rejection Reason Category, Rejection Stage, Rejected Count, Total Rejected Value, Percentage of Total Rejected, Typical Resolution Path. Include a total row with a plain-language explanation of each reason. For resolvability classification responses: present a five-path table with columns Resolution Path, Rejected Count, Total Value, Key Action Required. Paths ranked from fastest to slowest resolution: Resolvable in Current Run, Requires Approver Action, Requires Setup Correction for Future Run, Requires IT or Configuration Change, Must Defer. Highlight the Resolvable in Current Run row as the priority recovery opportunity. For overdue risk responses: present a table ranked by due date ascending with columns Installment Reference, Invoice Reference, Supplier, Installment Amount, Due Date, Days Until Due or Days Overdue, Rejection Reason, Resolution Required. Flag overdue rows prominently. Always include a resolution guidance note per rejection reason. Use business-friendly rejection reason labels. Avoid raw system codes or internal field identifiers.\",      \"recommendationGuidelines\": \"Generate 2 to 3 targeted next steps based on the rejected installment finding. Start each recommendation with a verb. For overdue or near-due rejected installments identified: \\\"Prioritise resolving the [N] rejected installments with due dates today or within the next 3 days - delayed resolution risks late payment penalties or supplier escalation. The total at-risk value is [amount]. For installments resolvable in the current run: \\\"Release the [N] manual holds on rejected installments before the PPR proceeds past installment review - doing so will allow [value] of installments to be included in this run without resubmission. For installments requiring bank account setup correction: \\\"Assign a disbursement bank account to the affected supplier sites for [N] rejected installments - these installments cannot be included in any run until the bank account is assigned. Navigate to Manage Suppliers to make the correction and include the installments in a follow-up targeted PPR. For installments requiring invoice approval: \\\"Escalate the invoice approval workflow for the [N] installments rejected due to approval holds - contact the relevant approvers to complete the approval so the invoices can be included in the next PPR submission. For installments requiring IT or configuration change: \\\"Raise a configuration request for the [N] installments rejected due to missing payment process profiles - these cannot be resolved without IT involvement and should be tracked separately while the remainder of the run proceeds. For a dominant rejection reason across many suppliers: \\\"The dominant rejection reason is [reason] affecting [N] installments across [N] suppliers - treat this as a systemic issue and investigate whether a single configuration or setup correction will resolve the majority of the rejections. Do not execute hold releases, setup changes, or approval escalations directly - provide the analytical finding and the navigational path only.\",      \"parentSkillKey\": \"ppr.findPaymentProcessRequests\",      \"clarification\": {        \"rules\": [          {            \"when\": \"if the user asks about rejected installments without naming a specific PPR, check whether multiple PPRs have rejected installments today; if so present the cross-PPR summary and\",            \"question\": \"Which Payment Process Request would you like me to show rejected installment detail for?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"rejectedInstallmentsSummary\",              \"title\": \"Rejected installments summary\",              \"columns\": [                \"Rejected Installment Reason\",                \"Installment Count\",                \"Total Amount\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"rejectedInstallmentsDetails\",              \"title\": \"Rejected installments in PPR\",              \"columns\": [                \"PPR Name\",                \"Supplier Name\",                \"Invoice Number\",                \"Installment Number\",                \"Rejected Reason\",                \"Amount\",                \"Status\",                \"Resubmission Signal\"              ]            }          ]        }      },      \"additionalInstructions\": \"Rejected installment detail table: columns Installment Reference, Invoice Reference, Supplier, Installment Amount, Due Date, Rejection Stage, Rejection Reason, Resolvability. Group by Rejection Reason with a subtotal row per group. Flag rows where due date is today or within 3 days. Include a total row. Bank-account exclusion summary table: columns Exception Message, Rejected Or Excluded Installment Count, Total Blocked Value, Payment Currency, Dominant PPR. Use `paymentRunExceptionsSummaries` and filter exception messages for bank account wording before any row-level drill-down. Cross-PPR summary table: columns PPR Name, PPR Status, Rejected Installment Count, Total Rejected Value, Dominant Rejection Reason. Rank by Total Rejected Value descending. Follow with per-installment detail grouped by PPR. Supplier concentration table: columns Rank, Supplier, Rejected Installment Count, Total Rejected Value, Percentage of Total Rejected, Dominant Rejection Reason. Include a total row. Rejection reason breakdown table: columns Rejection Reason Category, Rejection Stage, Rejected Count, Total Rejected Value, Percentage of Total Rejected, Typical Resolution Path. Rank by Total Rejected Value descending. Include a total row. Resolvability classification table: columns Resolution Path, Rejected Count, Total Value, Key Action Required. Five rows ranked from fastest resolution: Resolvable in Current Run highlighted, Requires Approver Action, Requires Setup Correction for Future Run, Requires IT or Configuration Change, Must Defer. Overdue risk table: columns Installment Reference, Invoice Reference, Supplier, Installment Amount, Due Date, Days Until Due or Days Overdue, Rejection Reason, Resolution Required. Rank by due date ascending. Flag overdue rows prominently. Resolution guidance note: include a plain-language per-rejection-reason guidance note at the bottom of every response stating the specific resolution steps and Oracle navigation path for each rejection reason present in the results. All outputs: precede the table with a 1 to 2 sentence plain-language headline of the key finding including a prominent callout if any rejected installments cover overdue or near-due invoices. Use currency formatting consistent with the ledger currency of the relevant business unit. Avoid raw system codes or internal field identifiers in all displayed values.\"    },    {      \"key\": \"ppr.reviewPPRRejectedPayments\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"name\": \"Review PPR Rejected Payments\",      \"intentDomainKnowledge\": \"Payment-level rejections in Oracle Payables occur after installments have been grouped into proposed payments and the payment file has been built and transmitted. Rejections at this stage can originate from two sources. The first is an Oracle-side payment file rejection - where the payment file fails formatting or transmission validation and is rejected before reaching the bank, or where Oracle's own payment confirmation process fails. The second is a bank-side rejection - where the payment file was transmitted successfully but the bank returned one or more payments during the clearing process, typically surfaced through a Level 2 acknowledgment file. Both types result in payments that were initiated but did not complete successfully. The critical distinction at this stage is what happens to the underlying payment record and the invoices it covers. A rejected payment may leave the invoice in a paid but uncleared state - the payment was issued but returned - which typically requires the payment to be voided in Oracle to reverse the accounting entries and return the invoice to an unpaid status. Once voided the invoice can be reissued in a new PPR. Alternatively some rejections occur before the payment is marked as issued - in which case the payment can be resubmitted without voiding. The voiding and reissuing decision is the most operationally consequential determination the payments team must make for each rejected payment. Additional complexity arises when a payment covers multiple invoices - voiding such a payment reverses all of the covered invoices simultaneously. Understanding which invoices are affected by each rejected payment is therefore essential for impact assessment. This skill surfaces the per-payment rejection detail needed to make these decisions - rejection reason, supplier, invoice coverage, payment status, and the specific remediation path for each rejected payment. It is strictly payment-level - it does not cover installment-level rejections at the document validation stage, which are handled by Review PPR Rejected Installments, and it does not provide summary-level counts only, which are handled by Summarize PPR Rejections.\",      \"description\": \"Surfaces the specific payments rejected within terminated or failed PPRs - showing the rejection reason per payment, the affected suppliers, impacted invoice value, and whether voiding or reissuing is required. Use when a PPR has terminated or payments have been rejected and the user needs to understand exactly which payments failed, why each failed, and what remediation step is needed per payment.\",      \"nlpExamples\": [        \"What are the rejected payments for the terminated PPRs today?\",        \"Show all rejected payments for terminated PPRs in the last week.\",        \"Which rejected payments require voiding and reissuing?\",        \"Show installments on hold due to Bank rejected payments and payment files between Start Date and End Date\"      ],      \"data\": {        \"goal\": \"Your job when using this skill is to help the user identify every rejected payment within a terminated or failed PPR, understand precisely why each payment was rejected, determine the total invoice value affected, and establish the correct remediation path - void and reissue, resubmit, or escalate - per payment so the suppliers can be paid as quickly as possible after the rejection is resolved.\",        \"slices\": [          \"Primary shapes: Payment Run Disbursement Payments filtered to rejected status, Payment Run Exceptions, Payment Run Installments for invoice coverage detail.\",          \"Rejected payment detail query: fetch Payment Run Disbursement Payments filtered to rejected payment status for the named PPR or date range; surface payment reference, supplier, payment amount, payment method, disbursement bank account, rejection reason, rejection source - Oracle-side or bank-side - payment status, and invoice count per payment.\",          \"Invoice coverage query: fetch Payment Run Installments joined to rejected Payment Run Disbursement Payments; surface the invoices covered by each rejected payment - invoice reference, invoice amount, and whether the invoice is now in a paid-but-uncleared state or returned to unpaid status.\",          \"Voiding requirement classification query: classify each rejected payment by remediation path - requires voiding and reissuing, can be resubmitted without voiding, or requires manual investigation; base classification on rejection source and payment status; aggregate count and value per remediation path.\",          \"Supplier specific query: fetch rejected Payment Run Disbursement Payments filtered to the named supplier and PPR or date range; surface all rejected payments for that supplier with full rejection detail and remediation path per payment.\",          \"Rejection reason breakdown query: fetch rejected payments grouped by rejection reason; aggregate count and value per reason; rank by total rejected value descending; compute each reason's percentage of total rejected value.\",          \"Cross-PPR rejected payment query: fetch rejected Payment Run Disbursement Payments across all terminated or failed PPRs within the user's stated date range; group by PPR and rejection reason; rank by total rejected value per PPR descending.\",          \"Multi-invoice payment query: fetch rejected Payment Run Disbursement Payments filtered to payments where invoice count is greater than one; surface the full invoice list per payment to support impact assessment before voiding. Do not fetch installment-level rejection data from the document validation stage - those are handled by Review PPR Rejected Installments. Do not provide summary-level counts only - this skill always returns per-payment detail.\",          \"Bank rejected installments on hold query: when the user asks for installments on hold due to bank rejected payments or payment files between Start Date and End Date, use `bankRejectedInstallmentsOnHold`. Apply the date range to payment file creation date, apply the relevant bank rejected payment status bucket, return one row per installment, and use the required sort order: days on hold descending, bank rejection code ascending, installment amount ascending, payment amount descending.\"        ]      },      \"promptInstruction\": \"Identify the rejected payment query type first - single PPR detail, cross-PPR date range, supplier specific, rejection reason breakdown, bank rejected installments on hold, voiding requirement classification, multi-invoice impact assessment, or remediation path analysis - then plan the data slices accordingly. For bank rejected installments on hold queries, especially phrasing such as `Show installments on hold due to Bank rejected payments and payment files between Start Date and End Date`, use `bankRejectedInstallmentsOnHold` as the primary shape. Apply Start Date and End Date to payment file creation date, filter to relevant bank rejected payment statuses and bank-rejected file statuses, and return installment-level rows with bank rejection code and reason, days on hold, payment file, payment, supplier, invoice, and installment detail. For single PPR rejected payment detail queries: fetch all rejected payments for the named PPR with full attributes including rejection reason, rejection source, payment status, and invoice count; present per-payment detail with remediation path per payment; always include the total rejected count and value as a headline. For cross-PPR date range queries: fetch rejected payments across all terminated or failed PPRs within the stated date range; group by PPR; surface per-payment detail within each PPR; rank PPRs by total rejected value descending. For supplier specific queries: filter rejected payments to the named supplier and stated PPR or date range; surface all rejected payments for that supplier with full detail; include the total rejected value for that supplier as a headline. For rejection reason breakdown queries: group all rejected payments by rejection reason; aggregate count and value; rank by total rejected value descending; identify the dominant reason and explain its business meaning and typical resolution path. For voiding requirement classification queries: classify each rejected payment into one of three remediation paths - requires voiding and reissuing, can be resubmitted without voiding, or requires manual investigation; explain the classification rationale for each path; aggregate count and total value per path; surface the voiding-required set first as it has the most significant accounting impact. For multi-invoice payment impact queries: filter to rejected payments covering more than one invoice; surface the full invoice list per payment; state clearly that voiding such a payment will reverse all covered invoices simultaneously and the full invoice set must be included in the reissue run. For remediation path analysis queries: for each rejected payment determine and present the specific next step - void in Oracle then reissue in a new PPR, resubmit the existing payment, contact the bank for manual resolution, or investigate further; base the path on rejection source and payment status. Always distinguish Oracle-side rejections from bank-side rejections - they have different resolution paths and timelines. Apply the User Clarification rules if the PPR or date range is not identified. Do not retrieve installment-level document validation rejections - route those to Review PPR Rejected Installments.\",      \"summarizationGuidelines\": \"Always open with a direct headline answer - for example the total count and value of rejected payments in the PPR or date range, the dominant rejection reason, and whether any multi-invoice payments are affected - before presenting detailed data. Keep the opening summary to around 80 to 100 words. Flag prominently in the opening summary if any rejected payments cover multiple invoices - the voiding impact is significantly broader for these. For single PPR rejected payment detail responses: present a detail table with columns Payment Reference, Supplier, Payment Amount, Payment Method, Rejection Reason, Rejection Source, Payment Status, Invoice Count, Remediation Path. Group by Rejection Reason with a subtotal row per group. Include a total row. For cross-PPR date range responses: present a PPR-level summary table first with columns PPR Name, Rejected Payment Count, Total Rejected Value, Dominant Rejection Reason; follow with per-payment detail grouped by PPR. For supplier specific responses: open with a supplier-level headline of total rejected count and value; present a detail table for that supplier's rejected payments with full attributes. For rejection reason breakdown responses: present a ranked table with columns Rejection Reason, Rejection Source, Rejected Count, Total Rejected Value, Percentage of Total Rejected, Typical Resolution Path. Include a total row. For voiding requirement classification responses: present a three-path table - columns Remediation Path, Rejected Count, Total Value, Key Action Required. Paths: Requires Voiding and Reissuing, Can Resubmit Without Voiding, Requires Manual Investigation. Follow with a detail table for the voiding-required set including invoice coverage per payment. For multi-invoice payment impact responses: present a table with columns Payment Reference, Supplier, Payment Amount, Invoice Count, Invoice References Covered, Total Invoice Value Covered. State clearly that voiding will reverse all covered invoices. Always include a plain-language remediation guidance note per rejection reason explaining the specific steps required. Use business-friendly rejection reason labels. Avoid raw system codes or internal field identifiers.\",      \"recommendationGuidelines\": \"Generate 2 to 3 targeted next steps based on the rejected payment finding. Start each recommendation with a verb. For Oracle-side rejections requiring voiding and reissuing: \\\"Void the [N] rejected payments in the Manage Payments page in Oracle - this will reverse the accounting entries and return the covered invoices to unpaid status. Then include the affected invoices in a new targeted PPR to reissue the payments. For bank-side rejections surfaced through acknowledgment file: \\\"Contact your bank to confirm the specific rejection reason for each returned payment - bank-side rejections may require a corrected bank account, a revised payment format, or a manual wire arrangement depending on the rejection code. Void the returned payments in Oracle once the bank confirms the rejection to reverse the accounting. For payments that can be resubmitted without voiding: \\\"Resubmit the [N] payments that do not require voiding - include them in a new targeted PPR with the same payment attributes. No void action is needed as the payment was not marked as issued before rejection. For multi-invoice payments requiring voiding: \\\"Review the invoice coverage for the [N] multi-invoice rejected payments before voiding - voiding each payment will reverse all [N] covered invoices simultaneously. Confirm the full invoice list is correct before proceeding and ensure all covered invoices are included in the reissue run. For a dominant systemic rejection reason across many payments: \\\"Investigate the root cause of the [rejection reason] affecting [N] payments - if this is a configuration or bank account issue it will recur in future runs unless resolved at the source. Escalate to the relevant team before reissuing. For supplier concentration in rejections: \\\"Prioritise resolving the rejected payments for Supplier [Name] - they account for [N] rejected payments totalling [value] and delayed payment may trigger supplier escalation. Do not execute voiding, reissuing, or bank contact actions directly - provide the analytical finding and navigational path only.\",      \"parentSkillKey\": \"ppr.findPaymentProcessRequests\",      \"clarification\": {        \"rules\": [          {            \"when\": \"if the user asks about rejected payments without naming a specific PPR or date range, check whether multiple PPRs have rejected payments today; if so present the cross-PPR summary and\",            \"question\": \"Which Payment Process Request would you like me to show rejected payment detail for?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"paymentExecutionExceptionsSummary\",              \"title\": \"Payment execution exceptions summary\",              \"columns\": [                \"Exception Scope\",                \"Dominant Reason\",                \"Affected Items\",                \"Blocked Amount\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"bankRejectedInstallmentsOnHold\",              \"title\": \"Installments on hold due to bank rejected payments\",              \"columns\": [                \"Bank Rejection Code\",                \"Bank Rejection Reason\",                \"Days on hold\",                \"Payment File reference\",                \"File Creation Date\",                \"File Status\",                \"Payment System\",                \"Disbursement Bank Account\",                \"Payment Number\",                \"Payment Status\",                \"Payment Amount\",                \"Supplier or Party\",                \"Supplier Site\",                \"Invoice Number\",                \"Installment Number\",                \"Installment Due Date\",                \"Installment Amount\"              ]            },            {              \"key\": \"paymentExecutionExceptionsDetails\",              \"title\": \"Payment execution exceptions in scope\",              \"columns\": [                \"PPR Or Payment File\",                \"Payment Reference\",                \"Exception Type\",                \"Error Message Or Grouped Errors\",                \"Supplier Or Payee\",                \"Amount\",                \"Failure Or Rejection Date\"              ]            }          ]        }      },      \"additionalInstructions\": \"Bank rejected installments on hold table: for requests asking `Show installments on hold due to Bank rejected payments and payment files between Start Date and End Date`, use `bankRejectedInstallmentsOnHold` and present exactly these columns in order: Bank Rejection Code, Bank Rejection Reason, Days on hold, Payment File reference, File Creation Date, File Status, Payment System, Disbursement Bank Account, Payment Number, Payment Status, Payment Amount, Supplier or Party, Supplier Site, Invoice Number, Installment Number, Installment Due Date, Installment Amount. Filter by relevant bank rejected payment statuses and by File Creation Date between the user-provided Start Date and End Date. Sort by Days on hold descending, Bank Rejection Code ascending, Installment Amount ascending, and Payment Amount descending. Rejected payment detail table: columns Payment Reference, Supplier, Payment Amount, Payment Method, Disbursement Bank Account, Rejection Reason, Rejection Source - Oracle-side or Bank-side, Payment Status, Invoice Count, Remediation Path. Group by Rejection Reason with a subtotal row per group. Flag rows where Invoice Count is greater than one. Include a total row. Cross-PPR summary table: columns PPR Name, PPR Status, Rejected Payment Count, Total Rejected Value, Dominant Rejection Reason. Rank by Total Rejected Value descending. Follow with per-payment detail grouped by PPR. Rejection reason breakdown table: columns Rejection Reason, Rejection Source, Rejected Count, Total Rejected Value, Percentage of Total Rejected, Typical Resolution Path. Rank by Total Rejected Value descending. Include a total row. Voiding requirement classification table: columns Remediation Path, Rejected Count, Total Value, Key Action Required. Three rows: Requires Voiding and Reissuing, Can Resubmit Without Voiding, Requires Manual Investigation. Follow with a detail table for the voiding-required set. Multi-invoice payment impact table: columns Payment Reference, Supplier, Payment Amount, Invoice Count, Invoice References Covered, Total Invoice Value Covered. Include a plain-language note stating that voiding this payment will reverse all covered invoices. Supplier specific table: same columns as the rejected payment detail table filtered to the named supplier with a supplier-level summary row above. Remediation guidance note: include a plain-language per-rejection-reason guidance note at the bottom of every response stating the specific remediation steps - void path, resubmit path, or bank contact path - for each rejection reason present in the results. All outputs: precede the table with a 1 to 2 sentence plain-language headline of the key finding. Use currency formatting consistent with the ledger currency of the relevant business unit. Avoid raw system codes or internal field identifiers in all displayed values. Flag multi-invoice rejected payments prominently in all output formats.\"    },    {      \"key\": \"ppr.reviewPPRSelectedInstallments\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"name\": \"Review PPR Selected Installments\",      \"intentDomainKnowledge\": \"After a PPR is submitted and its selection criteria are applied, Oracle Payables identifies all invoice installments that match the criteria - business unit, pay group, payment method, pay through date, supplier filters, and currency - and marks them as selected for payment. These selected installments form the pool from which proposed payments will be built in the next stage. At the installment review stage the PPR may pause - if the processing option \\\"Review installments\\\" is enabled - allowing the payments team to curate the selection before proceeding. This is a deliberate checkpoint: the user can remove installments they do not want to pay in this run, add installments that should be included, or verify that the selection is correct before the run moves to document validation. Each selected installment carries key attributes: the invoice it relates to, the supplier, the installment amount, the invoice currency, the payment currency, the payment date, the discount date and discount amount if applicable, the withholding tax amount if applicable, and whether the installment is on a hold. Discount capture is a common concern at this stage: if an installment has a discount date approaching, the user needs to confirm it will be paid in time to capture the saving. Cross-currency installments - where the payment currency differs from the invoice currency - require a conversion rate and are a common source of downstream blocks. Withholding tax installments require special handling in some jurisdictions and may need to be verified before the run proceeds. This skill surfaces all of this information for the selected installment set. It does not cover unselected installments - those are handled by the Review PPR Unselected Installments skill. It does not cover post-selection validation failures or conversion rate gaps - those are handled by separate skills.\",      \"description\": \"User wants to review, count, summarize, or list selected installments under a PPR, including currency summaries, supplier concentration, payment totals, selected-installment details, discount and withholding indicators, and line-level drill-downs without double-counting duplicate lifecycle rows.\",      \"nlpExamples\": [        \"Review installments for ppr 'gapr_ppr_test_4'\",        \"I want to view the list of installments made to Advanced Network Devices\",        \"Show me all installments in this PPR where the payment amount exceeds $50,000 and the supplier is in the manufacturing category\",        \"Which installments in ppr 'gapr_ppr_test_4' have withholding tax applied, and what's the total tax amount being withheld by tax authority?\",        \"Which suppliers have the most installments in ppr 'gapr_ppr_test_4', and what's the total value going to each?\",        \"Show me invoices where onetime dynamic discount was accepted by suppliers yesterday but payment was delayed or still not paid.\"      ],      \"data\": {        \"goal\": \"Your job when using this skill is to help the user understand exactly what is in the selected installment set of a specific PPR - which invoices, which suppliers, what amounts, what discount opportunities, what currency exposures, and what withholding tax implications - so they can make an informed decision about whether to proceed, curate, or escalate before the run advances to document validation.\",        \"slices\": [          \"Primary shape: Payment Run Selected Installments.\",          \"Full installment list query: fetch Payment Run Selected Installments for the named PPR; return all selected installments with their key attributes - invoice reference, supplier, installment amount, invoice currency, payment currency, payment date, discount date, discount amount, withholding tax amount, hold flag.\",          \"Supplier concentration query: fetch Payment Run Selected Installments grouped by supplier; aggregate total installment value and count per supplier; rank by total value descending.\",          \"Value threshold filter query: fetch Payment Run Selected Installments for the named PPR filtered to installments where the installment amount exceeds the user's stated threshold; return the filtered set with full attributes.\",          \"Cross-currency installment query: fetch Payment Run Selected Installments filtered to installments where the payment currency differs from the invoice currency; surface the currency pair, installment amount, and conversion rate if available.\",          \"Discount opportunity query: fetch Payment Run Selected Installments filtered to installments where a discount date exists and falls within the user's stated window or within the next 7 days by default; rank by discount date ascending so the most urgent opportunities surface first.\",          \"Withholding tax query: fetch Payment Run Selected Installments filtered to installments where the withholding tax amount is greater than zero; aggregate total withholding tax by supplier and jurisdiction.\",          \"Hold query: fetch Payment Run Selected Installments filtered to installments with an active hold flag; surface hold type and reason per installment. Do not fetch unselected installments, document validation errors, payment validation errors, or conversion rate exception data - those are handled by separate skills.\"        ]      },      \"promptInstruction\": \"1. Use this intent for selected-installment review under a PPR, including review, count, supplier rollup, amount rollup, discount or withholding checks, currency mismatch checks, and line-level selected-installment list requests. 2. Treat generic 'review installments for PPR' and PPRs paused at Pending installments review as selected-installment review unless the user explicitly says unselected, excluded, rejected, or failed. 3. The primary shapes for this intent are pprInstallmentsDeduplicatedSummary for summary, count, currency, and supplier review, and pprInstallmentsDeduplicatedDetails for line-level list, show, and drill-down review. 4. Use selectedPaymentInstallments or paymentRunInstallments only on a need-to-use basis: when the PPR status is resolved to exactly one lifecycle source, when the user explicitly asks for AP-stage or IBY-stage source rows, or when the requested output is inherently source-specific such as payment-file, formed-payment, bank-account, grouping-number, AP-only discount, or AP-only conversion-rate context. 5. Resolve the installment source by PPR status whenever the user gives a status or the current PPR status is known. AP-only statuses use selectedPaymentInstallments: UNSTARTED, SELECTING, SELECTED, REVIEW, SUBMITTED, CALCULATING, MISSING RATES, MISSING_X_RATES, ORA_REFRESH_INSTALLMENTS, CANCELED, and CANCELLED NO PAYMENTS. IBY-only statuses use paymentRunInstallments: INSERTED, PENDING_REVIEW, INFORMATION_REQUIRED, DOCUMENTS_VALIDATED, PENDING_REVIEW_DOC_VAL_ERRORS, PENDING_REVIEW_PMT_VAL_ERRORS, VALIDATION_FAILED, FAILED_PAYMENT_VALIDATION, ORA_REQUIRE_APPROVAL, ORA_APPROVAL_INITIATED, ORA_APPROVAL_WITHDRAWN, ORA_APPROVED, ORA_APPROVAL_ERROR, PAYMENTS_INITIATED, PAYMENTS_CREATED, RETRY_DOCUMENT_VALIDATION, RETRY_PAYMENT_CREATION, COMPLETED, and ASSIGNMENT_COMPLETE. 6. If the ask is scoped to one AP-only status, query only selectedPaymentInstallments; for example, missing-rate installment questions must use selectedPaymentInstallments because MISSING RATES and MISSING_X_RATES are AP statuses. 7. If the ask is scoped to one IBY-only status, query only paymentRunInstallments. 8. If the source cannot be restricted to one side, such as no resolved status, a request spanning both AP and IBY statuses, or mixed-source statuses CANCELING and TERMINATED, keep the deduplicated extraction shapes as the active installment population; do not switch to a raw single-source shape merely because that source has an extra classifier or attribute that the other branch does not expose. 9. For a plain 'review installments' request, use pprInstallmentsDeduplicatedSummary and return the Currency Summary first; do not request line-level details unless the user explicitly asks for rows. 10. For generic line-level installment requests, use pprInstallmentsDeduplicatedDetails rather than a capped raw BV result. 11. For withholding-tax installment questions, filter to business installments where withheld amount is greater than zero. If the user asks both which installments and total withheld by supplier, tax authority, payee, or similar grouping, plan both a withholding summary slice and a withholding detail slice. 12. Any review-installments summary must return the selected-invoice review measures: selected installments, amount remaining, withheld amount, discount amount, payment amount, interest amount, and total amount payable. 13. For selected-installment base rows, apply originalInvoiceId IS NULL, originalPaymentNumber IS NULL, and okToPayFlag = 'Y'. 14. Compute interest amount from selected interest rows by matching checkrunId, originalInvoiceId to the base invoice id, and originalPaymentNumber to the base installment number. 15. Compute amount remaining as amountRemaining multiplied by the cross-currency rate with NVL rate fallback to 1; do not apply round-currency logic. 16. Compute total amount payable as payment amount plus interest amount only. 17. For deduplicated extraction summaries, follow the selected-invoice review extraction pattern: exclude AP selected rows when the same PPR appears in payment-run rows and compute installment count with SUM(dedupedCount) over the normalized selected, payment-run, and interest stream. For raw single-source fallback counts, do not count invoice id alone or installment number alone. 18. For supplier count-and-total questions, use the supplier summary path so count and amount stay in one grouped result by supplier and payment currency. 19. Prefer payment currency for payment-context amounts. 20. Include unselected installments only when the user explicitly asks for unselected, excluded, or not-selected rows. 21. Route rejected-installment and validation-failure detail to ppr.reviewPPRRejectedInstallments or ppr.reviewPPRDocumentValidationErrors depending on whether the user wants row-level rejected installments or a validation-error summary. 22. Do not route installment-level withholding-tax questions to tax-authority payment review merely because the wording mentions tax authority; use tax-authority payment review only when the user asks for tax-authority payment rows, statutory remittance payments, or formed payments to tax authorities.\\n\\nShape selection guidance for common user requests:\\nUse these examples as routing hints for this intent. When the user request matches one of these patterns, prefer the listed shape or shape family before planning the query. Keep the normal clarification, filtering, and response rules for this intent in force; do not expose these internal routing hints to the user.\\n- For requests like Review installments for a PPR, prefer pprInstallmentsDeduplicatedSummary. For list installments made to a named supplier, amount-threshold line lists, or withholding detail rows, prefer pprInstallmentsDeduplicatedDetails.\\n- For requests like installments over an amount threshold with supplier/category filters, prefer pprInstallmentsDeduplicatedDetails with branch-safe supplier type/category aliases.\\n- For requests like Installments where payment currency differs from invoice currency, grouped by destination country with missing rates highlighted, prefer selectedPaymentInstallments.\\n- For requests like Effective tax/withholding amount summaries for selected installments when available, prefer payablesSelectedInstallmentsSummary.\\n\\nLatest QA routing requirements: supported selected-installment review requests must generate query context, not only narrative/table output. For plain 'Review installments for PPR <name>', use pprInstallmentsDeduplicatedSummary and the currency summary query. For supplier-filtered lists, supplier category/amount filters, and withholding detail rows, use pprInstallmentsDeduplicatedDetails. For withholding questions that ask both which installments and the total tax withheld, generate both pprInstallmentsDeduplicatedSummary and pprInstallmentsDeduplicatedDetails query contexts. Do not ask clarification when the PPR, supplier, amount, or supplier category is present in the question. If the user asks a broad early-payment-discount savings question without a PPR or supported run context, such as 'Find all installments where early payment discounts are available if paid within 5 days', return UNSUPPORTED directly; do not ask for business unit, currency, or supplier.\\n\\nUnsupported examples to keep explicit: first-time supplier payment with bank-account validation-complete status, and one-time dynamic discount accepted by suppliers yesterday but delayed/still unpaid, are not supported by the current selected-installment/PPR shapes. Return unsupported directly for those exact patterns rather than asking clarification.\",      \"summarizationGuidelines\": \"Always open with a direct headline answer - for example the total count and value of selected installments in the PPR, or the number of installments matching the user's filter - before presenting detailed data. Keep the opening summary to around 80 to 100 words. For full installment list responses: if the count fewer than 20 then present the full detail table directly; if larger than 20 present a supplier-level summary first - information like Supplier, Installment Count, Total Value, Percentage of Run. For supplier concentration responses: present a summary with information Rank, Supplier, Installment Count, Total Value, Percentage of Run Total. Include a total row at the bottom. For value threshold filter responses: state the threshold applied at the top; present the filtered installment detail; include a count and total value of the filtered set in the opening summary. For discount opportunity responses: present installments ranked by discount date ascending with infromation like Supplier, Invoice Reference, Installment Amount, Discount Amount, Discount Date, Days Remaining. Flag installments where days remaining is 2 or fewer as urgent. For withholding tax responses: present a summary grouped by supplier with columns Supplier, Installment Count, Total Installment Amount, Total Withholding Tax, Net Payment Amount. Include a jurisdiction column where applicable. For hold responses: present summary with information like Invoice Reference, Supplier, Installment Amount, Hold Type, Hold Reason. Include a count and total value of held installments in the opening summary. Use business-friendly labels throughout. Avoid raw system codes or internal field identifiers.\",      \"recommendationGuidelines\": \"Generate 2-3 targeted next steps based on the installment review finding. Start each recommendation with a verb. For discount opportunities expiring imminently: \\\"Confirm that the installments with discount dates expiring within 48 hours are retained in this run and that the PPR is released promptly - delaying will forfeit the available discount. For installments on hold within the selected set: \\\"Review the [N] held installments in the selected set — held installments will fail document validation if not resolved or removed before the run proceeds.For high supplier concentration identified: \\\"Review whether the concentration of value in [Supplier Name] at [N]% of the selected total is within your disbursement policy before releasing the run. For PPR paused at Pending installments review: \\\"Complete the installment curation - remove any installments you do not wish to pay in this run or add any installments and release the installment review to allow the PPR to proceed(Deeplink). Do not recommend executing changes to the run directly - provide the analytical finding and the navigational guidance only.\",      \"parentSkillKey\": \"ppr.findPaymentProcessRequests\",      \"clarification\": {        \"rules\": [          {            \"when\": \"if the user asks about selected installments without naming a specific PPR, Please provide the PPR name or reference number.\",            \"question\": \"Which Payment Process Request would you like me to review?\"          },          {            \"when\": \"if the user asks to show large or high-value installments without specifying a threshold,\",            \"question\": \"What value threshold would you like to apply - for example installments over 50,000 or over 100,000?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"currencySummary\",              \"description\": \"Default table for plain installment review when the user has not asked for line-level rows.\",              \"title\": \"Currency Summary\",              \"columns\": [                \"Payment Currency\",                \"Selected Installments\",                \"Amount Remaining\",                \"Withheld Amount\",                \"Discount Amount\",                \"Payment Amount\",                \"Interest Amount\",                \"Total Amount Payable\"              ]            },            {              \"key\": \"suppliersInvolved\",              \"description\": \"Use when the user asks which suppliers are involved, which suppliers have the most installments, or asks for supplier counts and totals.\",              \"title\": \"Suppliers Involved\",              \"columns\": [                \"Supplier\",                \"Payment Currency\",                \"Selected Installments\",                \"Amount Remaining\",                \"Withheld Amount\",                \"Discount Amount\",                \"Payment Amount\",                \"Interest Amount\",                \"Total Amount Payable\"              ]            },            {              \"key\": \"selectedInstallmentCount\",              \"description\": \"Use when the user asks only for the number of installments.\",              \"title\": \"Installment Count\",              \"columns\": [                \"Selected Installments\"              ]            },            {              \"key\": \"withholdingTaxBySupplier\",              \"description\": \"Use when the user asks for withholding-tax totals by supplier, tax authority, payee, or similar visible grouping for installments in a PPR.\",              \"title\": \"Withholding Tax By Supplier\",              \"columns\": [                \"Supplier\",                \"Payment Currency\",                \"Selected Installments\",                \"Withheld Amount\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"installmentDetails\",              \"description\": \"Use only when the user explicitly asks to list, show, or drill into line-level installment records.\",              \"title\": \"Installments\",              \"columns\": [                \"PPR Name\",                \"Supplier\",                \"Invoice Number\",                \"Installment Number\",                \"Due Date\",                \"Invoice Currency\",                \"Payment Currency\",                \"Payment Amount\",                \"Amount Remaining\",                \"Withheld Amount\",                \"Discount Amount\",                \"PPR Status\"              ]            }          ]        }      },      \"additionalInstructions\": \"Use pprInstallmentsDeduplicatedSummary and pprInstallmentsDeduplicatedDetails as the primary shapes for review-installments questions. Choose selectedPaymentInstallments only for AP-only status scope or AP-only source context, and choose paymentRunInstallments only for IBY-only status scope or inherently IBY-only context such as destination country, readable disbursement bank account, external bank account, payment-file, or formed-payment context. Do not replace the deduplicated PPR installment population with a raw source solely because the raw source exposes an extra classifier; when the deduplicated extraction exposes a branch-safe alias for that classifier, keep the deduplicated shape and let the query builder apply the filter to the branch that supports it. For withholding-tax questions, use withheldAmount > 0 and include selected installment count with the withheld amount summary by supplier, tax authority, payee, or the closest visible grouping. When the user asks to group currency-mismatch installments by destination country, use paymentRunInstallments because it exposes externalBankAccount.countryCode; if the user also asks to highlight missing conversion rates, apply documentCurrencyCode!=paymentCurrencyCode and payablesInvoiceInstallment.invoiceToPaymentConversionRate=null together. For unknown PPR lifecycle source, use pprInstallmentsDeduplicatedSummary for summary requests and customize its select statement for Currency Summary, Suppliers Involved, or Withholding Tax By Supplier. Use pprInstallmentsDeduplicatedDetails for generic line-level details under a PPR. For deduplicated summary counts, use the shape's normalized SUM(dedupedCount) pattern rather than raw COUNT(*) or a standalone COUNT(DISTINCT ...) expression; keep selected base filters aligned with original invoice/payment null plus ok-to-pay, and keep total amount payable aligned to payment amount plus interest amount. Keep selected-installment review separate from unselected and rejected installment diagnostics. For first-time supplier payment or bank-account-validation-complete questions, do not invent history or validation fields; the current review-installment shapes do not expose a first-payment history indicator or bank-account validation completion flag, so return the supported installment context and state the limitation clearly. Latest QA rule: generic selected-installment review must produce pprInstallmentsDeduplicatedSummary query context; supplier-filtered, supplier-category, amount-threshold, and withholding row requests must produce pprInstallmentsDeduplicatedDetails query context. Do not answer these supported use cases without query context. Mandatory query-context preservation: for Review installments for PPR, supplier-filtered installment list, supplier category/amount list, and withholding-tax list/summary, emit the matching pprInstallmentsDeduplicatedSummary or pprInstallmentsDeduplicatedDetails query context even if a textual answer is also produced. Broad early-payment-discount savings without PPR/run scope is unsupported. First-time supplier payment plus bank-account validation-complete, and one-time dynamic discount accepted but unpaid/delayed, are intentionally unsupported examples; return unsupported directly without clarification.\"    },    {      \"key\": \"ppr.reviewPPRUnselectedInstallments\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"name\": \"Review PPR Unselected Installments\",      \"intentDomainKnowledge\": \"When a PPR runs its selection process it evaluates all open invoice installments against the selection criteria - pay through date, business unit, pay group, payment method, currency, supplier filters, and any additional criteria set on the template. Installments that do not meet the criteria are excluded from the selected set. However, not all exclusions are expected. Some installments are excluded for legitimate reasons - they are not yet due, they fall outside the pay group, or the user intentionally filtered them out. Others are excluded unexpectedly - they are on a payment hold, the supplier's bank account is missing or invalid, the payment process profile is not assigned, the installment's currency is not covered by the template, or there is a data setup gap that prevents selection. Understanding the reason for exclusion is critical: some reasons are immediately resolvable within the current run - for example releasing a hold - while others require master data correction before the installment can be included in any future run. The unselected installments shape captures all installments that were in scope for the PPR's selection window but were not included in the selected set, along with the exclusion reason for each. This is distinct from installments that are simply not yet due or not in scope - those would not appear in the unselected set at all. This skill is strictly focused on excluded installments and their reasons. It does not cover selected installments - those are handled by the Review PPR Selected Installments skill. It does not cover post-selection document or payment validation errors - those are handled by separate skills.\",      \"description\": \"Surfaces installments that were eligible but not selected in a PPR - explaining why each was excluded, whether due to holds, criteria mismatch, bank account errors, or other reasons - and what is required to include them in this or a future run. Use when the user wants to understand why an expected invoice or installment was not picked up, see all excluded installments for a supplier, or identify the gap between what was due and what was selected.\",      \"nlpExamples\": [        \"Show me all invoices for Supplier Advanced Network Devices that were eligible but not selected for gapr_ppr_test_4 PPR\",        \"For Supplier Advanced Network Devices, which of their open invoices were not included in PPR gapr_ppr_test_4?\",        \"Show me all installments for Supplier Advanced Network Devices that were excluded from PPR gapr_ppr_test_4 due to a payment hold\",        \"Why was the installment with installment number 1 and invoice number u-test-site-01 not picked up in the current payment run for gapr_ppr_test_4?\",        \"Why was invoice with invoice number 105-42 not picked up for payment for PPR gapr_ppr_test_4\"      ],      \"data\": {        \"goal\": \"Your job when using this skill is to help the user understand exactly which installments were excluded from a PPR's selected set, why each was excluded, the total value of the gap, and what corrective action - if any - is needed to include them in this run or a future run.\",        \"slices\": [          \"Primary shape: Payment Run Unselected Installments.\",          \"Full unselected list query: fetch Payment Run Unselected Installments for the named PPR; return all excluded installments with their key attributes - invoice reference, supplier, installment amount, invoice currency, payment currency, due date, exclusion reason, and exclusion reason category.\",          \"Exclusion reason summary query: fetch Payment Run Unselected Installments grouped by exclusion reason category; aggregate installment count and total excluded value per reason; rank by total excluded value descending so the highest-impact exclusion reasons surface first.\",          \"Supplier specific query: fetch Payment Run Unselected Installments filtered to the named supplier; return all excluded installments for that supplier with exclusion reason per installment.\",          \"Specific invoice or installment query: fetch Payment Run Unselected Installments filtered to the named invoice reference and installment number; return the exclusion reason, the installment attributes, and any relevant setup gap.\",          \"Hold-specific query: fetch Payment Run Unselected Installments filtered to exclusion reason category of payment hold; surface hold type, hold reason, and whether the hold is manually releasable within the current run.\",          \"Resolvable exclusions query: fetch Payment Run Unselected Installments and classify each excluded installment by whether the exclusion reason is resolvable within the current run - for example a hold that can be released - or requires a future run - for example a missing bank account that needs master data correction; aggregate by resolution path and surface the value recoverable in each category. Do not fetch selected installments, document validation errors, payment validation errors, or payment file data - those are handled by separate skills.\"        ]      },      \"promptInstruction\": \"Identify the unselected installment query type first - full list, exclusion reason summary, supplier specific, specific invoice or installment lookup, hold specific, or resolvable exclusions classification - then plan the data slices accordingly. For full unselected list queries: retrieve all excluded installments with their core attributes and exclusion reasons; if the count is large - more than 50 - present an exclusion reason summary first and offer to drill into specific reasons or suppliers on request. For exclusion reason summary queries: group by exclusion reason category; aggregate installment count and total excluded value; rank by total excluded value descending; compute each reason's percentage of the total excluded value. For supplier specific queries: filter to the named supplier; return all excluded installments for that supplier with the exclusion reason per installment; include a supplier-level summary of total excluded count and value above the detail table. For specific invoice or installment lookup queries: filter to the exact invoice reference and installment number; return the full exclusion reason with a plain-language explanation of what caused the exclusion and what is needed to resolve it. For hold-specific queries: filter to exclusion reason category of payment hold; group by hold type; surface hold reason per installment; indicate whether each hold can be released within the current run or requires a separate resolution workflow. For resolvable exclusions classification queries: classify each excluded installment into one of two categories - resolvable in current run, for example hold release, or requires future run, for example missing bank account or criteria mismatch; aggregate the total value recoverable in each category; present the resolvable set first as the highest-priority action. Always require a specific PPR as context. Apply the User Clarification rules if the PPR is not identified. Clearly distinguish between exclusion reasons that are data or setup gaps versus those that are expected or intentional exclusions. Do not retrieve selected installments, validation errors, or payment file data.\\n\\nShape selection guidance for common user requests:\\nUse these examples as routing hints for this intent. When the user request matches one of these patterns, prefer the listed shape or shape family before planning the query. Keep the normal clarification, filtering, and response rules for this intent in force; do not expose these internal routing hints to the user.\\n- For requests like Eligible/open invoices not selected for a PPR, supplier invoices not included, installments excluded due to payment hold, or why an invoice/installment was not picked up, prefer unselectedPaymentInstallments.\\n- For requests like Why was invoice not picked up for payment today, prefer unselectedPaymentInstallmentsExtraction.\",      \"summarizationGuidelines\": \"Always open with a direct headline answer - for example the total count and value of excluded installments in the PPR and the dominant exclusion reason - before presenting detailed data. Keep the opening summary to around 80 to 100 words. For full unselected list responses: if the count is 20 or fewer present the full detail table directly; if larger present an exclusion reason summary table first - columns Exclusion Reason, Installment Count, Total Excluded Value, Percentage of Total Excluded - and follow with the detail table grouped by exclusion reason. For exclusion reason summary responses: present a ranked table with columns Exclusion Reason Category, Installment Count, Total Excluded Value, Percentage of Total Excluded. Include a total row at the bottom. For supplier specific responses: open with a supplier-level summary of total excluded count and value; follow with a detail table showing Invoice Reference, Installment Number, Installment Amount, Due Date, Exclusion Reason. For specific invoice or installment responses: present the exclusion reason in plain language - avoid system codes; explain what caused the exclusion and state precisely what needs to be corrected to include the installment in this or a future run. For hold-specific responses: present a table with columns Invoice Reference, Supplier, Installment Amount, Hold Type, Hold Reason, Releasable in Current Run. Flag rows where the hold is releasable in the current run. For resolvable exclusions responses: present two clearly labelled sections - Resolvable in Current Run with total recoverable value and the action required per installment, and Requires Future Run with total deferred value and the master data correction needed per reason. Use business-friendly exclusion reason labels throughout. Avoid raw system codes or internal field identifiers.\",      \"recommendationGuidelines\": \"Generate 2 to 3 targeted next steps based on the unselected installment finding. Start each recommendation with a verb. For installments excluded due to releasable holds: \\\"Release the payment holds on the [N] excluded installments in the Manage Holds page and rerun the installment selection to include them in this run - the recoverable value is [amount]. For installments excluded due to missing bank account: \\\"Update the disbursement bank account for the affected suppliers in the Manage Suppliers page - these installments cannot be included in any run until the bank account is assigned and validated. For installments excluded due to criteria mismatch - wrong pay group or payment method: \\\"Review the selection criteria on this PPR - [N] installments for [Supplier] were excluded because their pay group or payment method does not match the template criteria. Consider submitting a separate targeted run to cover them. For installments excluded due to missing payment process profile: \\\"Assign a valid payment process profile to the affected supplier sites - these installments will continue to be excluded from all runs until the profile is configured. For a mix of resolvable and non-resolvable exclusions: \\\"Focus first on the [N] installments totalling [value] that can be resolved within the current run - address the hold releases and criteria adjustments before releasing the installment review. The remaining [N] installments require master data corrections and should be targeted in a future run. For no unexpected exclusions found: \\\"All exclusions in this PPR are consistent with the selection criteria - no unexpected gaps identified. The unselected installments are either not yet due or intentionally out of scope for this run. Do not recommend executing hold releases or master data changes directly - provide the analytical finding and the navigational path only.\",      \"parentSkillKey\": \"ppr.findPaymentProcessRequests\",      \"clarification\": {        \"rules\": [          {            \"when\": \"if the user asks about unselected installments without naming a specific PPR, Please provide the PPR name or reference number.\",            \"question\": \"Which Payment Process Request would you like me to investigate?\"          },          {            \"when\": \"if the user asks why a specific installment was not picked up but provides only a supplier name without an invoice reference,\",            \"question\": \"Could you provide the invoice reference number and installment number so I can identify the specific excluded installment?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"unselectedInstallmentsSummary\",              \"title\": \"Unselected installments summary\",              \"columns\": [                \"Not Selected Reason\",                \"Installment Count\",                \"Total Amount\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"unselectedInstallmentsDetails\",              \"title\": \"Unselected installments in PPR\",              \"columns\": [                \"PPR Name\",                \"Supplier Name\",                \"Invoice Number\",                \"Installment Number\",                \"Due Date\",                \"Amount\",                \"Not Selected Reason\",                \"Status\"              ]            }          ]        }      },      \"additionalInstructions\": \"Exclusion reason summary table: columns Exclusion Reason Category, Installment Count, Total Excluded Value, Percentage of Total Excluded. Rank by Total Excluded Value descending. Include a total row at the bottom. Full unselected installment detail table: columns Invoice Reference, Installment Number, Supplier, Installment Amount, Invoice Currency, Due Date, Exclusion Reason. Group by Exclusion Reason Category with a subtotal row per group. Supplier specific table: same columns as the full detail table filtered to the named supplier. Include a supplier-level summary row above the table showing total excluded count and total excluded value. Specific installment lookup: plain-language explanation card - Installment Reference, Supplier, Amount, Due Date, Exclusion Reason in plain language, Resolution Required. No table needed for single installment responses - a structured two-column label and value format is sufficient. Hold specific table: columns Invoice Reference, Supplier, Installment Amount, Hold Type, Hold Reason, Releasable in Current Run. Flag the Releasable column clearly. Resolvable exclusions output: two clearly labelled sections - Section 1 Resolvable in Current Run with columns Invoice Reference, Supplier, Amount, Exclusion Reason, Action Required; Section 2 Requires Future Run with columns Invoice Reference, Supplier, Amount, Exclusion Reason, Master Data Correction Needed. Include a value total for each section. All outputs: precede the table with a 1 to 2 sentence plain-language headline of the key finding. Use currency formatting consistent with the ledger currency of the relevant business unit. Avoid raw system codes or internal field identifiers in all displayed values. Use business-friendly exclusion reason labels in all tables and notes.\"    },    {      \"key\": \"ppr.reviewUpcomingSchedulesForPaymentRuns\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"name\": \"Review Upcoming Schedules for Payment Runs\",      \"intentDomainKnowledge\": \"Invoice installments in Oracle Payables have a due date and optionally one or more discount dates. The due date determines when payment must be made to avoid being overdue. Discount dates determine the window within which early payment earns a discount from the supplier. Both are visible before a PPR is submitted and form the basis of cash planning. The Invoice Payment Schedules Summary surfaces installments that are due or eligible for payment within a specified future window - grouped by date, bank account, currency, business unit, supplier, or template - giving the payments team a forward-looking view of obligations before any run is triggered. A key use case is cash requirement planning: understanding how much cash needs to be available in which bank accounts and currencies on a given day or across the next week. A second use case is discount capture: identifying installments where an early payment discount is available within the planning window so they can be prioritised in an upcoming run. A third use case is schedule coverage checking: confirming whether a PPR is already scheduled to process the due installments, or whether a gap exists that requires a manual or ad hoc submission. This skill is strictly forward-looking - it covers installments not yet processed and planned outflows from scheduled templates. It does not cover active PPR run status, historical completed payments, or payment file outcomes.\",      \"description\": \"Surfaces upcoming scheduled payment runs, due or open installments, early-payment discount opportunities, accepted-offer and dynamic-discount risks when exposed, and available credit memo or prepayment offsets before a payment run is submitted. Use when the user wants future payment obligations, discount savings, delayed discount-risk items, or credit/prepayment offsets for planning.\",      \"nlpExamples\": [        \"Show me the credit memos for supplier xyz?\",        \"What is the total cash requirement for tomorrow?\"      ],      \"data\": {        \"goal\": \"Your job when using this skill is to help the user build a clear picture of upcoming payment obligations - what is due, when, how much, in which bank accounts and currencies, and whether any scheduled runs already cover those obligations - so they can plan cash, capture discounts, and avoid missed payments before submitting a run.\",        \"slices\": [          \"Primary shape: Invoice Payment Schedules Summary.\",          \"Cash requirement query: fetch Invoice Payment Schedules Summary filtered to the user's specified date range; group by bank account and currency; aggregate total amount due per grouping.\",          \"Discount opportunity query: fetch Invoice Payment Schedules Summary filtered to installments with a discount date falling within the planning window; group by supplier and discount date; surface discount amount and deadline per installment.\",          \"Schedule coverage check: fetch Invoice Payment Schedules Summary for the specified date range; cross-reference against scheduled PPR template run dates; identify installments not covered by any scheduled run.\",          \"Supplier or invoice specific query: fetch Invoice Payment Schedules Summary filtered to the named supplier or invoice reference; return installment due dates, amounts, discount dates, and assigned bank account.\",          \"Template cash requirement query: fetch Invoice Payment Schedules Summary filtered to the selection criteria of the named template - business unit, pay group, payment method, pay through date - to project the expected cash requirement if that template were run today or on its next scheduled date. Do not fetch active PPR run data, payment file data, or historical completed payment data - those are handled by separate skills.\"        ]      },      \"promptInstruction\": \"1. Use payment-schedule detail and balances as the primary sources for pending, due-soon, overdue, and ready-for-payment questions. 2. When the user asks whether a run is already scheduled, add PPR detail or scheduled-run context rather than relying only on installment rows. 3. For early-discount questions, include the relevant discount dates and savings context if those fields are exposed. 4. For today's or tomorrow's schedules, treat the request as a forward-looking schedule view, not as a formed-payment summary, and include supplier counts or value concentration when the shape supports it. 5. If the user asks why items were excluded from today's run, return any directly supported exclusion or error context and then route to ppr.reviewPPRUnselectedInstallments or ppr.analyzePPRExceptions for deeper analysis. 6. If the current path exposes related PPR templates or scheduled runs that are expected to pick up the items, include that preparation context. 7. Do not claim a specific future pickup run unless the chosen data path actually exposes the schedule or run linkage. 8. Use a schedule-summary variant for due-window questions and a run-schedule variant when the user asks whether a PPR is already planned. For discount and credit opportunity questions, use invoice-payment summary or detail for already captured discounts and use balances, prepayment, credit, or payment-schedule detail for open opportunities and unapplied offsets. Treat invoice or document type wording as a required semantic filter when the selected shape exposes a matching type hierarchy or attribute; credit-memo questions must carry the invoice type filter for CREDIT MEMO. For credit-memo or prepayment questions, keep the answer focused on available offsets and how they relate to planned cash outflow. For one-time dynamic-discount questions, use financing-offer response date, discount availability, discount amount, due date, unpaid amount, and invoice payment status only when those fields are exposed; if accepted-offer timing or delayed-payment proof is not exposed by the selected shape, return the supported discount-risk subset and state that limitation instead of inventing it. Prioritize opportunities with the nearest expiration windows or the largest savings first.\\n\\nTomorrow means current calendar date plus exactly one day; cash-requirement by currency sorts by invoice currency code asc before limit 20.\",      \"summarizationGuidelines\": \"Always open with a direct headline answer - for example the total cash requirement figure for the stated period, or the number and value of discount opportunities expiring this week - before presenting detailed data. Keep the opening summary to around 80 to 100 words. For cash requirement responses: follow the summary with a breakdown table grouped by bank account and currency showing total amount due, number of installments, and the date range covered. Include an overall total row at the bottom. For discount opportunity responses: present a table ranked by discount expiry date with columns Supplier, Invoice Reference, Installment Amount, Discount Amount, Discount Date, and Days Remaining. Highlight installments where the discount expires within 24 hours. For schedule coverage check responses: present a summary of installments due in the window, the scheduled runs that cover them, and a clearly labelled gap section listing installments not covered by any scheduled run with their due dates and amounts. For supplier or invoice specific responses: present a concise table of the installment schedule with due dates, amounts, discount dates if applicable, and bank account. For template projection responses: present the projected cash requirement in the same format as a cash requirement response and label it clearly as a projection based on current eligible installments for the named template. When no installments are found in the specified window, state that clearly and suggest checking the date range or installment filters. Use business-friendly labels throughout - avoid raw system codes or internal field identifiers.\",      \"recommendationGuidelines\": \"Generate 2 to 3 targeted next steps based on the planning query outcome. Start each recommendation with a verb. For cash requirement result: \\\"Confirm that the required cash is available in each bank account before the due dates - particularly for accounts with the largest obligations. For discount opportunities identified: \\\"Prioritise the installments with discount dates expiring in the next 24 to 48 hours in your next PPR submission to capture the available savings before the window closes. For schedule gap identified - no run covers due installments: \\\"Submit an ad hoc Payment Process Request to cover the unscheduled installments due in this window - use the Review PPR Templates and Schedules skill to identify the best matching template. For schedule already covers installments: \\\"No action required - the scheduled run for template [Template Name] is configured to process these installments on [date]. Monitor the run status after submission. For overdue installments identified in the window: \\\"Review the overdue installments surfaced in this window and escalate any that are past due but not covered by an upcoming run. Do not recommend executing a run directly - provide the navigational path and planning guidance only.\",      \"parentSkillKey\": \"ppr.reviewPPRTemplatesAndSchedules\",      \"clarification\": {        \"rules\": [          {            \"when\": \"if the user asks for the cash requirement for a template without naming it, You can provide the template name or describe the payment method and business unit it covers.\",            \"question\": \"Which PPR template would you like me to use for this cash projection?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"scheduledPaymentsSummary\",              \"description\": \"Use for due-window and upcoming-installment questions.\",              \"title\": \"Scheduled payments summary\",              \"columns\": [                \"Due-Date Window\",                \"Installment Count\",                \"Total Unpaid Amount\",                \"Discount-Risk Items\"              ]            },            {              \"key\": \"scheduledRunSummary\",              \"description\": \"Use when the user asks whether a PPR or run is already scheduled for the upcoming work.\",              \"title\": \"Scheduled runs in scope\",              \"columns\": [                \"Scheduled Run Or PPR\",                \"Planned Payment Date\",                \"Expected Installments\",                \"Total Amount\"              ]            },            {              \"key\": \"discountAndCreditSummary\",              \"title\": \"Discount and credit opportunity summary\",              \"columns\": [                \"Opportunity Type\",                \"Affected Items\",                \"Savings Or Offset Value\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"scheduledPaymentsDetails\",              \"description\": \"Use for the main installment-level schedule list.\",              \"title\": \"Scheduled installments in scope\",              \"columns\": [                \"Supplier Name\",                \"Invoice Number\",                \"Installment Number\",                \"Due Date\",                \"Unpaid Amount\",                \"Discount Opportunity\",                \"Business Unit\",                \"Scheduled Run Or Template\"              ]            },            {              \"key\": \"scheduledDiscountOpportunityDetails\",              \"description\": \"Use when the user asks about early-payment-discount items in the upcoming window.\",              \"title\": \"Upcoming discount opportunities\",              \"columns\": [                \"Supplier Name\",                \"Invoice Number\",                \"Due Date\",                \"Discount Date\",                \"Potential Savings\",                \"Scheduled Run Or Template\"              ]            },            {              \"key\": \"discountAndCreditDetails\",              \"title\": \"Discount and credit details\",              \"columns\": [                \"Supplier Name\",                \"Invoice Or Credit Reference\",                \"Opportunity Type\",                \"Due Or Expiry Date\",                \"Savings Or Offset Amount\",                \"Suggested Run Or Template\"              ]            }          ]        }      },      \"additionalInstructions\": \"Keep this intent focused on pending and upcoming work. Route formed or completed payment questions to ppr.reviewHistoricalCashflowTrendsForPaymentRuns or ppr.viewPaymentProcessRequestDetails. Credit memo and available-credit outputs must apply payablesInvoiceTypeHierarchy.invoiceTypeCode = CREDIT MEMO when payablesBalances is selected, plus the supplier filter when a supplier is named. Discount opportunity outputs should show Supplier Name, Invoice Number, Due Date, Discount Date, Potential Savings, and Scheduled Run Or Template when supported. Available credit or prepayment outputs should show Supplier Name, Invoice Or Credit Reference, Opportunity Type, Due Or Expiry Date, Savings Or Offset Amount, and Suggested Run Or Template when supported.\\nTreat business-driver filters as the required semantic core, not a closed-form query. When the user adds explicit constraints such as date or date range, PPR name/id, supplier, business unit, currency, amount, status, payment method, bank account, or payment file, add those filters when the selected shape exposes the field. A user-provided date filter overrides the default recency window. Do not drop required status, null-rate, source-shape, or sorting rules unless the user explicitly asks for a different lifecycle/source and the selected shape supports it.\\nIf a requested filter, grouping, or output field is not exposed by the selected shape, do not invent a field or silently drop the constraint. Choose another supported shape that exposes it, or state the limitation while returning the closest supported query context.\"    },    {      \"key\": \"ppr.summarizePPRExceptions\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"name\": \"Summarize PPR Exceptions\",      \"intentDomainKnowledge\": \"A PPR can encounter exceptions at multiple stages of its lifecycle - during installment selection, document validation, payment validation, payment file build, and payment confirmation. Each stage has its own exception types and resolution paths. When multiple exception types are present simultaneously, or when exceptions span multiple PPRs, the user needs a consolidated triage view before committing to detailed diagnosis. This is the purpose of the Summarize PPR Exceptions skill. The exception types covered span the full PPR lifecycle: holds on installments preventing selection; missing attributes such as bank accounts or payment process profiles blocking document validation; business-logic document validation errors such as invoice approval failures or duplicate payment flags; payment validation errors such as funds reservation failures or bank limit breaches; payment file creation or formatting failures; and payment confirmation failures including acknowledgment rejections. The key triage dimensions are: which exception types are present and how many documents or payments are affected by each; what is the total value at risk per exception type; whether exceptions are concentrated with specific suppliers or business units - a signal that a single setup correction might resolve many exceptions at once; and what the relative effort-to-value trade-off is for each exception type - some exceptions are quick to resolve and unlock high value while others require IT involvement for low value. This skill surfaces the consolidated picture and the triage signals. It does not perform deep per-exception root-cause diagnosis - each exception type has a dedicated stage-specific skill for that. It does not execute any resolution actions. Its output is the prioritised exception map the user needs to decide what to tackle first.\",      \"description\": \"Provides a cross-stage consolidated summary of all exceptions blocking a PPR - covering document and payment validation errors, holds, missing data, and confirmation failures - with counts, impacted value, and concentration by supplier or business unit. Designed for triage before detailed diagnosis. Use when the user wants a quick view of everything blocking a PPR or set of PPRs to prioritise which exceptions to tackle first based on value at risk or volume.\",      \"nlpExamples\": [        \"Show me exceptions for all PPRs\",        \"Why did payment confirmation for PPR CFA-6 fail?\"      ],      \"data\": {        \"goal\": \"Your job when using this skill is to give the user a fast, consolidated view of all exceptions blocking a PPR or set of PPRs - showing exception types, counts, value at risk, and concentration patterns - so they can triage effectively and decide which exceptions to address first before switching to the appropriate stage-specific skill for detailed diagnosis.\",        \"slices\": [          \"Primary shapes: Payment Run Exceptions, Disbursement Exceptions, Disbursement Payment Instruction Exceptions Extraction\",          \"Cross-PPR exception summary query: fetch Payment Run Exceptions and Disbursement Exceptions across all active PPRs; group by PPR and exception type category; aggregate blocked document or payment count and total blocked value per PPR and exception type; rank by total blocked value descending.\",          \"Single PPR exception summary query: fetch Payment Run Exceptions and Disbursement Exceptions for the named PPR; group by exception type category - holds, missing attributes, document validation errors, payment validation errors, file build failures, confirmation failures; aggregate count and blocked value per category; rank by blocked value descending.\",          \"Supplier concentration query: fetch Payment Run Exceptions for the named PPR grouped by supplier; aggregate exception count and blocked value per supplier; identify whether exceptions are concentrated in a small number of suppliers or spread broadly.\",          \"Business unit concentration query: fetch Payment Run Exceptions grouped by business unit; aggregate exception count and blocked value per business unit; surface the business units contributing the most blocked value. Value at risk scenario query - for example if I cannot resolve N exceptions what value is delayed: fetch Payment Run Exceptions ranked by blocked value per exception instance; compute the cumulative value of the top N unresolved exceptions; present the residual value that would remain blocked and the value that could be recovered by resolving the remainder.\",          \"Effort-to-value triage query: classify each exception type by resolution effort category - self-service quick fix, data correction requiring coordination, or IT or configuration change - and aggregate the total recoverable value per effort category so the user can identify the highest-value quick wins. Do not fetch granular per-document or per-payment exception detail beyond what is needed for triage counts and value aggregation - detailed diagnosis belongs to stage-specific skills.\",          \"For questions like Why did payment confirmation for a particual PPR fail, prefer the shape disbursementPaymentInstructionExceptionsExtraction alone to provide a detailed view. No Summary view required.Never use paymentRunExceptionsSummaries,disbursementPaymentExceptionsExtraction\"        ]      },      \"promptInstruction\": \"Identify the exception summary query type first - cross-PPR triage, single PPR summary, supplier concentration, business unit concentration, value at risk scenario, or effort-to-value triage - then plan the data slices accordingly. For cross-PPR triage queries: fetch exceptions across all active PPRs; group by PPR and exception type category; rank by total blocked value descending; surface the PPRs with the highest blocked value and the dominant exception type per PPR. For single PPR summary queries: fetch all exception types for the named PPR from both Payment Run Exceptions and Disbursement Exceptions; group by exception type category; present counts and blocked value per category; identify the dominant exception type and whether exceptions are concentrated with specific suppliers. For supplier concentration queries: group exceptions by supplier within the named PPR; compute each supplier's share of total exceptions and blocked value; identify whether resolving one or two suppliers would clear a disproportionate share of exceptions. For business unit concentration queries: group exceptions by business unit; aggregate counts and blocked value; surface the business units with the highest exception concentration. For value at risk scenario queries - for example if I cannot resolve N exceptions what value is delayed: rank individual exceptions by blocked value descending; compute cumulative value of the top N; present the value recoverable by resolving the highest-value exceptions and the residual value that remains blocked; state clearly that this is a value-at-risk scenario and not a prediction of actual resolution. For effort-to-value triage queries: classify each exception type present in the PPR into one of three effort tiers - self-service quick fix such as releasing a hold or assigning a bank account, data correction requiring coordination such as updating supplier setup, or IT or configuration change such as configuring a payment process profile; aggregate total recoverable value per tier; surface the quick-win tier prominently. Always distinguish exception types using plain-language category labels - do not collapse different exception types into a single generic category. Signal clearly in every response which stage-specific skill to use for detailed diagnosis of each exception type. Do not perform root-cause diagnosis within this skill. Do not retrieve payment file detail, installment selection detail, or post-processing outcomes beyond what is captured in the exception shapes. \\n If use asks for why payment confirmation fail, then use disbursementPaymentInstructionExceptions to get the data. Business driver contains the filter hints to be used.\\n\\nShape selection guidance for common user requests:\\nUse these examples as routing hints for this intent. When the user request matches one of these patterns, prefer the listed shape or shape family before planning the query. Keep the normal clarification, filtering, and response rules for this intent in force; do not expose these internal routing hints to the user.\\n- For requests like Top unresolved payment/installment exceptions by amount, affected suppliers, and total delayed payment value, prefer paymentRunExceptionsSummaries when exception reason is required; use paymentRunInstallmentSummaries for payment-run installment value ranking when exception reason detail is not needed.\\n- For requests like Show me exceptions for all PPRs when a cross-PPR exception summary is requested, prefer paymentRunExceptionsSummaries; use paymentRunInstallmentExceptionsExtraction only for drill-down rows.\\n- For questions like Why did payment confirmation for a particual PPR fail, prefer the shape disbursementPaymentInstructionExceptionsExtraction alone, ,disbursementPaymentExceptionsExtraction .No summary required.  For payment confirmation failure questions, generate two query contexts: paymentRunExceptionsSummaries AV summary filtered to PAYMENT_INSTRUCTION and disbursementPaymentInstructionExceptionsExtraction detail. Normalize user wording like PPR CFA-6 to paymentRequestName CFA-6 for the extraction filter, include PENDING_ACK in the paymentFileProcessingStatusLookupCode list, and do not answer with extraction detail alone.\",      \"summarizationGuidelines\": \"Always open with a direct headline answer - for example the total number of exception types present in the PPR, the total value blocked, and the dominant exception type - before presenting detailed data. Keep the opening summary to around 80 to 100 words. For cross-PPR triage responses: present a summary table with columns PPR Name, PPR Status, Exception Types Present, Total Blocked Documents or Payments, Total Blocked Value. Rank by Total Blocked Value descending. Include a total row. For single PPR exception summary responses: present a table with columns Exception Type Category, Stage, Affected Count, Total Blocked Value, Recommended Next Skill. Rank by Total Blocked Value descending. Include a total row. The Recommended Next Skill column maps each exception type to the appropriate stage-specific skill - for example document validation errors map to Review PPR Document Validation Errors. For supplier concentration responses: present a table with columns Supplier, Exception Count, Total Blocked Value, Percentage of PPR Total Exceptions. Flag suppliers where resolving their exceptions would recover more than 20% of the total blocked value. For value at risk scenario responses: present a two-section table - Section 1 the top N exceptions by blocked value with their total recoverable value if resolved; Section 2 the remaining exceptions with their total residual blocked value. Label the sections clearly. For effort-to-value triage responses: present a three-tier table with columns Effort Tier, Exception Types in Tier, Affected Count, Total Recoverable Value. Highlight the self-service quick-fix tier as the recommended starting point. Always include a routing note at the bottom of the response mapping each exception type to the appropriate stage-specific skill for detailed diagnosis. Use business-friendly exception category labels throughout. Avoid raw system codes or internal field identifiers.\",      \"recommendationGuidelines\": \"Generate 2 to 3 targeted next steps based on the triage finding. Start each recommendation with a verb. For dominant exception type identified: \\\"Address the [exception type] exceptions first - they account for [N]% of the total blocked value in this PPR. Use the [stage-specific skill name] for detailed diagnosis and resolution guidance. For high supplier concentration identified: \\\"Focus on resolving exceptions for Supplier [Name] first - they account for [N]% of total blocked exceptions and a single setup correction may recover [value] simultaneously. For high-value quick-win exceptions identified in effort-to-value triage: \\\"Start with the self-service quick-fix exceptions - releasing the [N] holds and assigning the [N] missing bank accounts will recover [value] with minimal effort and no IT involvement. For value at risk scenario result: \\\"If only [N] of the [total] exceptions can be resolved today, prioritise the [top N] by blocked value - this will recover [value] and leave [residual value] delayed. Use the stage-specific skills to diagnose each exception type in priority order. For exceptions spread across many suppliers with no clear concentration: \\\"Exceptions are broadly distributed with no single supplier dominating - address by exception type rather than by supplier, starting with the highest-value exception category. For a PPR with both quick-fix and IT-dependent exceptions: \\\"Resolve the self-service exceptions today to recover [value] and submit a separate IT or configuration request for the [exception type] gaps - do not hold the entire run waiting for configuration changes if the majority of documents can proceed. Route explicitly to the appropriate stage-specific skill for each exception type mentioned in recommendations. Do not perform root-cause diagnosis within recommendations - keep guidance at the triage and routing level.\",      \"parentSkillKey\": \"ppr.findPaymentProcessRequests\",      \"clarification\": {        \"rules\": [          {            \"when\": \"if the user asks about exceptions for a specific PPR without naming it, check whether there are multiple active PPRs with exceptions; if so present the cross-PPR summary and\",            \"question\": \"Which Payment Process Request would you like me to summarise in detail?\"          },          {            \"when\": \"if the user asks what value is delayed if they cannot resolve some exceptions without specifying how many,\",            \"question\": \"How many exceptions are you expecting to be unable to resolve today - for example 5, 10, or 20 - so I can compute the value at risk?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"pprExceptionsSummary\",              \"title\": \"PPR exceptions summary\",              \"columns\": [                \"Exception Stage Or Family\",                \"Affected PPRs\",                \"Affected Items\",                \"Impacted Value\"              ]            },            {              \"key\": \"pprExceptionsConcentrationSummary\",              \"title\": \"Exception concentration summary\",              \"columns\": [                \"Supplier Or Business Unit\",                \"Dominant Exception\",                \"Affected Items\",                \"Impacted Value\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"pprExceptionsImpactDetails\",              \"title\": \"Exception impact details\",              \"columns\": [                \"PPR Name\",                \"Exception Stage Or Family\",                \"Reason Group\",                \"Affected Items\",                \"Impacted Value\",                \"Priority Signal\"              ]            }          ]        }      },      \"additionalInstructions\": \"Cross-PPR triage table: columns PPR Name, PPR Status, Exception Types Present, Blocked Document or Payment Count, Total Blocked Value. Rank by Total Blocked Value descending. Include a total row. Single PPR exception summary table: columns Exception Type Category, Lifecycle Stage, Affected Count, Total Blocked Value, Recommended Next Skill. Rank by Total Blocked Value descending. Include a total row. Supplier concentration table: columns Supplier, Exception Count, Total Blocked Value, Percentage of PPR Total. Flag rows where the supplier's share exceeds 20% of total blocked value. Business unit concentration table: columns Business Unit, Exception Count, Total Blocked Value, Percentage of Total. Value at risk scenario output: two-section table - Section 1 Top N Exceptions by Blocked Value with columns Exception Reference, Type, Blocked Value, Cumulative Recoverable Value; Section 2 Remaining Exceptions with columns Exception Count, Total Residual Blocked Value. Effort-to-value triage table: columns Effort Tier, Exception Types Included, Affected Count, Total Recoverable Value. Three rows - Self-Service Quick Fix, Data Correction Requiring Coordination, IT or Configuration Change. Highlight the Self-Service row. Routing note: include a plain-language routing note at the bottom of every response mapping each exception type present to the appropriate stage-specific skill for detailed diagnosis - for example \\\"For detailed diagnosis of document validation errors use the Review PPR Document Validation Errors skill. All outputs: precede the table with a 1 to 2 sentence plain-language headline of the key triage finding. Use currency formatting consistent with the ledger currency of the relevant business unit. Avoid raw system codes or internal field identifiers in all displayed values. Payment confirmation failure routing: use both paymentRunExceptionsSummaries AV summary and disbursementPaymentInstructionExceptionsExtraction detail. Strip leading PPR from paymentRequestName values and include PENDING_ACK in the extraction status list.\"    },    {      \"key\": \"ppr.summarizePPRRejections\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"name\": \"Summarize PPR Rejections\",      \"intentDomainKnowledge\": \"Rejections in the PPR lifecycle can occur at two distinct stages and the distinction matters significantly for resolution. The first is at the installment stage - installments can be rejected during document validation if they fail a business rule or have a hold that was not resolved before the run proceeded. These rejections remove the installment from the payment grouping step and the affected invoices remain unpaid. The second is at the payment stage - proposed payments or payments within a payment file can be rejected after grouping, either because the payment file itself fails validation at the bank or because individual payments within an acknowledged file are returned or rejected by the bank during clearing. A payment file-level rejection blocks all payments within that file simultaneously - the entire file is rejected and no supplier within it receives payment. An individual payment-level rejection blocks only the specific payment, while other payments in the same file may proceed. Understanding the scope of each rejection - file-level versus payment-level, installment-level versus payment-level - is the most important triage dimension because it determines how many suppliers and how much value is affected by each rejection event and what the recovery path looks like. The Summarize PPR Rejections skill provides the consolidated triage view across all rejection types and stages. It surfaces counts, values, dominant reasons, and scope classifications so the user can prioritise which rejections to investigate first. It does not perform detailed per-item diagnosis - that is handled by the Review PPR Rejected Payments and Review PPR Rejected Installments skills.\",      \"description\": \"Provides a consolidated summary of installments and payments rejected across a PPR - counts, total value at risk, and breakdown by rejection reason and stage - to give the user a triage view before drilling into specific rejected items. Use when the user wants a quick overview of what was rejected in a PPR or set of PPRs - how many items, what value, and what the dominant rejection reasons are - before deciding what to investigate further.\",      \"nlpExamples\": [        \"What are the installments or payments rejected and why?\",        \"Give me a summary of all rejections across today's PPRs.\",        \"What is the breakdown of rejections by stage and reason for PPR XYZ?\"      ],      \"data\": {        \"goal\": \"Your job when using this skill is to give the user a fast, consolidated picture of all rejections across a PPR or set of PPRs - how many items were rejected, at which stage, what the total value at risk is, what the dominant rejection reasons are, and whether rejections are file-level or individual-level in scope - so they can triage effectively and decide which rejection type to investigate first.\",        \"slices\": [          \"Primary shapes: Payment Run Exceptions, Payment Run Disbursement Payments, Payment Run Installments.\",          \"Rejection summary query: fetch rejection events from Payment Run Exceptions and Payment Run Disbursement Payments for the named PPR; group by rejection stage - installment-level or payment-level - and rejection reason category; aggregate rejected count and total rejected value per stage and reason; rank by total rejected value descending.\",          \"Scope classification query: classify each rejection event by scope - payment file-level rejection affecting all payments in a file versus individual payment-level rejection affecting a single payment versus installment-level rejection affecting a single document; aggregate count and value per scope tier; surface file-level rejections first as the highest-impact scope.\",          \"Cross-PPR rejection summary query: fetch rejection events across all PPRs active or completed today; group by PPR and rejection stage; aggregate count and value per PPR; rank by total rejected value descending.\",          \"Rejection reason breakdown query: fetch all rejection events for the named PPR grouped by rejection reason; aggregate count and value per reason; compute each reason's percentage of total rejected value; identify the dominant reason.\",          \"File-level versus individual-level payment rejection query: fetch payment file rejection events - where the entire file was rejected - separately from individual payment rejection events within acknowledged files; present the two categories side by side with count, value, and reason for each.\",          \"Value at risk percentage query: fetch total PPR value from Payment Run and total rejected value from rejection events; compute rejected value as a percentage of the total PPR value; surface the recovery gap. Do not fetch per-installment or per-payment rejection detail beyond what is needed for summary counts and reason aggregation - detailed diagnosis belongs to the Review PPR Rejected Payments and Review PPR Rejected Installments skills.\"        ]      },      \"promptInstruction\": \"Identify the rejection summary query type first - single PPR rejection summary, cross-PPR today summary, scope classification, file-level versus individual-level distinction, rejection reason breakdown, or value at risk percentage - then plan the data slices accordingly. For single PPR rejection summary queries: fetch all rejection events for the named PPR from both installment and payment stages; group by stage and rejection reason; aggregate count and value per group; lead with the total rejected count and value and the dominant stage and reason before presenting the breakdown. For cross-PPR today summary queries: fetch rejection events across all PPRs active or completed today; group by PPR first then by stage and reason; rank by total rejected value per PPR descending; surface the PPRs with the most rejections or highest rejected value first. For scope classification queries: classify each rejection event as file-level - blocks all payments in the file - payment-level - blocks a single payment - or installment-level - blocks a single document; aggregate count and value per scope tier; present file-level rejections first with a clear explanation of their broader impact. For file-level versus individual-level payment rejection queries: separate payment file rejections - where Oracle or the bank rejected the entire formatted payment file - from individual payment rejections within acknowledged files; present both categories side by side with count, value, and dominant rejection reason for each; explain the implication of each clearly - a file-level rejection requires resubmission of the entire file while an individual rejection requires targeted remediation per payment. For rejection reason breakdown queries: group all rejection events by reason; rank by total rejected value descending; compute each reason's percentage of total rejected value; identify whether the dominant reason is a data error, a configuration issue, a bank-side rejection, or a holds-related exclusion. For value at risk percentage queries: compute total PPR value and total rejected value; present the percentage rejected and the residual successfully processed value. Always distinguish clearly between installment-level rejections and payment-level rejections - they occur at different stages and have different resolution paths. Signal clearly which stage-specific skill to use for detailed diagnosis. Apply the User Clarification rules if the PPR is not identified.\\n\\nShape selection guidance for common user requests:\\nUse these examples as routing hints for this intent. When the user request matches one of these patterns, prefer the listed shape or shape family before planning the query. Keep the normal clarification, filtering, and response rules for this intent in force; do not expose these internal routing hints to the user.\\n- For requests like Summary of rejected installments or payments before drill-down, prefer unselectedPaymentInstallments, unselectedPaymentInstallmentsExtraction, disbursementPaymentExceptionsExtraction, and disbursementPaymentInstructionExceptionsExtraction.\",      \"summarizationGuidelines\": \"Always open with a direct headline answer - for example the total count and value of rejections in the PPR, the dominant stage, the dominant rejection reason, and whether any file-level rejections are present - before presenting detailed data. Keep the opening summary to around 80 to 100 words. If any file-level rejections are present call this out prominently in the opening summary - a file-level rejection has the broadest impact and must be visible immediately. For single PPR rejection summary responses: present a two-section summary table - Section 1 by rejection stage with columns Stage, Rejected Count, Total Rejected Value, Percentage of PPR Total; Section 2 by rejection reason with columns Rejection Reason, Stage, Rejected Count, Total Rejected Value, Percentage of Total Rejected. Include total rows in both sections. For cross-PPR today summary responses: present a table with columns PPR Name, Rejection Stage, Dominant Rejection Reason, Rejected Count, Total Rejected Value. Rank by Total Rejected Value descending. Include a total row. For scope classification responses: present a three-tier table with columns Scope Tier, Rejection Type, Affected Count, Total Rejected Value, Impact Description. Tiers: File-Level Rejection, Individual Payment-Level Rejection, Installment-Level Rejection. Highlight the File-Level tier prominently. For file-level versus individual-level comparison responses: present a side-by-side table with columns Rejection Scope, Rejection Count, Total Rejected Value, Dominant Reason, Recovery Path. Two rows: Payment File-Level Rejection and Individual Payment-Level Rejection. For rejection reason breakdown responses: present a ranked table with columns Rejection Reason, Stage, Rejected Count, Total Rejected Value, Percentage of Total Rejected. Include a total row. For value at risk percentage responses: present a simple comparison table with columns Category, Count, Value, Percentage of PPR Total. Rows: Successfully Processed, Rejected, Total PPR. Always include a routing note at the bottom mapping each rejection type to the appropriate stage-specific skill. Use business-friendly rejection reason labels. Avoid raw system codes or internal field identifiers.\",      \"recommendationGuidelines\": \"Generate 2 to 3 targeted next steps based on the rejection summary finding. Start each recommendation with a verb. For file-level payment rejections identified: \\\"Address the file-level rejection for payment file [reference] immediately - it is blocking all [N] payments in the file totalling [value]. Use the Review Payment File skills to diagnose the file rejection reason and determine whether to reformat and resubmit or void and reissue. For high-value individual payment rejections: \\\"Investigate the individual payment rejections totalling [value] using the Review PPR Rejected Payments skill - determine whether each rejected payment requires voiding and reissuing or can be resubmitted after correcting the rejection reason. For installment-level rejections identified: \\\"Review the installment-level rejections totalling [value] using the Review PPR Rejected Installments skill - identify whether each rejected installment can be corrected and included in a follow-up run or requires a hold release or setup correction first. For a dominant rejection reason across many items: \\\"The dominant rejection reason is [reason] affecting [N] items totalling [value] - treat this as a systemic issue rather than individual errors and investigate the root cause to prevent recurrence in future runs. For a mix of file-level and individual rejections: \\\"Resolve the file-level rejections first as they have the broadest impact - then address the individual payment rejections in priority order by blocked value using the appropriate stage-specific skills. For low rejection rate with no file-level issues: \\\"The rejection rate for this PPR is [N]% of total value - no file-level rejections detected. Use the Review PPR Rejected Payments skill to address the [N] individual payment rejections. Always route to the appropriate stage-specific skill for detailed diagnosis. Do not perform root-cause diagnosis within this skill - summary and routing only.\",      \"parentSkillKey\": \"ppr.findPaymentProcessRequests\",      \"clarification\": {        \"rules\": [          {            \"when\": \"if the user asks about rejections without naming a specific PPR, check whether multiple PPRs have rejection events today; if so present the cross-PPR summary and\",            \"question\": \"Which Payment Process Request would you like me to summarise rejections for in detail?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"pprRejectionsSummary\",              \"title\": \"PPR rejections summary\",              \"columns\": [                \"Rejection Stage\",                \"Dominant Reason\",                \"Rejected Items\",                \"Rejected Value\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"pprRejectionsDetails\",              \"title\": \"Rejected items behind the summary\",              \"columns\": [                \"PPR Name\",                \"Rejection Stage\",                \"Reason Group\",                \"Rejected Items\",                \"Rejected Value\",                \"Operational Signal\"              ]            }          ]        }      },      \"additionalInstructions\": \"Rejection stage summary table: columns Stage, Rejected Count, Total Rejected Value, Percentage of PPR Total. Rows: Installment-Level Rejections, Payment-Level Rejections. Include a total row. Rejection reason breakdown table: columns Rejection Reason, Stage, Rejected Count, Total Rejected Value, Percentage of Total Rejected. Rank by Total Rejected Value descending. Include a total row. Cross-PPR today summary table: columns PPR Name, Rejection Stage, Dominant Rejection Reason, Rejected Count, Total Rejected Value. Rank by Total Rejected Value descending. Include a total row. Scope classification table: three-tier table with columns Scope Tier, Rejection Type, Affected Count, Total Rejected Value, Impact Description. Tiers: File-Level Rejection highlighted prominently, Individual Payment-Level Rejection, Installment-Level Rejection. File-level versus individual-level comparison table: columns Rejection Scope, Rejection Count, Total Rejected Value, Dominant Reason, Recovery Path. Two rows: Payment File-Level Rejection and Individual Payment-Level Rejection. Value at risk table: columns Category, Count, Value, Percentage of PPR Total. Rows: Successfully Processed, Rejected, Total PPR. Routing note: include a plain-language routing note at the bottom of every response mapping each rejection type to the appropriate stage-specific skill - for example \\\"For detailed diagnosis of individual payment rejections use the Review PPR Rejected Payments skill. For installment-level rejection detail use the Review PPR Rejected Installments skill. All outputs: precede the table with a 1 to 2 sentence plain-language headline of the key finding including a prominent callout if any file-level rejections are present. Use business-friendly rejection reason labels throughout. Avoid raw system codes or internal field identifiers in all displayed values. Use currency formatting consistent with the ledger currency of the relevant business unit.\"    },    {      \"key\": \"ppr.viewPaymentProcessRequestDetails\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"name\": \"View Payment Process Request Details\",      \"intentDomainKnowledge\": \"A PPR is the primary batch payment mechanism in Oracle Payables. Each PPR has run configuration, selection criteria, processing rules, and an evolving lifecycle state as it moves through installment selection, document validation, payment validation, proposed payment review, and payment file creation. The repo's available shapes split this run view across `paymentRunCriteria` for selection and configuration, `PayablesPaymentProcessRequestDetails` for lifecycle and run context, and extraction shapes for rolled-up installment and payment snapshots. This skill stays at the run-summary level. It does not drill into line-level installment, payment, validation-error, or payment-file diagnostics, but it can add rolled-up installment and payment snapshots to the run summary.\",      \"description\": \"Shows a specific Payment Process Request in a compact run-summary format. Default output is a single header table with the current lifecycle status and key dates, followed by a brief plain-language explanation. Only show selection criteria, processing options, or rolled-up snapshots when the user explicitly asks for them.\",      \"nlpExamples\": [        \"View details of PPR gapr_ppr_test_4\",        \"Show PPR details whose name is CPPRT_020015\",        \"What's the document rejection level set to for PPR gapr_ppr_test_4\",        \"What's the document rejection level set to for PPR <PPR_NAME>\"      ],      \"data\": {        \"goal\": \"Give the user a concise run summary for one specific PPR: current status first, then key lifecycle fields, with optional selection criteria, processing options, installment snapshots, or payment snapshots only when requested.\",        \"slices\": [          \"Primary shape: `PayablesPaymentProcessRequestDetails` for the compact lifecycle/header summary.\",          \"Use `paymentRunCriteria` only when the user explicitly asks for configuration, selection criteria, processing options, document rejection level, or run setup details.\",          \"Use `paymentRunCriteriaExtraction` with `paymentRunCriteria` when the user explicitly asks for detailed PPR configuration, selection criteria, document rejection level, policy setup, or processing-option detail.\",          \"For PPRs waiting for file creation, use `paymentRunCriteria` to explain the file-creation processing configuration and use `PayablesPaymentProcessRequestDetails` only for visible run status or lifecycle context.\",          \"Header totals, template, schedule, business unit, currency, legal entity, invoice source, pay group, payment method, pay-through date, and processing-option context should be returned only when the user asks for those header details.\",          \"Use `paymentRunInstallmentsExtraction` only when the user explicitly asks for a rolled-up installment snapshot.\",          \"Use `disbursementPaymentsExtraction` only when the user explicitly asks for a rolled-up payment snapshot and the run is far enough along to support it.\"        ]      },      \"promptInstruction\": \"Identify the PPR detail query type first - run overview, selection criteria, processing details, waiting-for-file-creation review, installment snapshot, payment snapshot, or a combination - then plan the data slices accordingly. Always require a specific PPR or a clear in-context PPR set. Apply the User Clarification rules if the PPR is not identified or if multiple PPRs match. Use `PayablesPaymentProcessRequestDetails` as the primary source for the default compact header summary: PPR name, current status, payment date, installments selected, installments rejected, completion date, pending since, and termination date. Use `paymentRunCriteria` and, for detailed setup output, `paymentRunCriteriaExtraction` only when the user explicitly asks for run configuration, selection criteria, processing options, document rejection level, policy setup, or other setup details. For run overview queries, keep the output compact and screenshot-like: show the header summary first, then a brief lifecycle explanation. For selection-criteria or processing-detail queries, return the relevant configuration fields from `paymentRunCriteria` only if requested, such as pay-through date, business unit, currency, legal entity, invoice source, pay group, template or schedule context, payment method, and configured processing options. For waiting-for-file-creation questions, especially plural questions such as 'Why are these PPRs waiting for file creation', use `paymentRunCriteria` to explain whether file creation was configured and which processing options are blocking or deferring file creation; add `PayablesPaymentProcessRequestDetails` only for visible run status or lifecycle context. For installment snapshot queries, use `paymentRunInstallmentsExtraction` only to produce a rolled-up snapshot summary under the named PPR; do not use it here for line-level installment review. For payment snapshot queries, only when `PayablesPaymentProcessRequestDetails` shows the PPR is past proposed payment review or payments have been created, use `disbursementPaymentsExtraction` to produce a rolled-up payment snapshot; otherwise state that the payment snapshot is not yet available for this run. If the user's query needs line-level installments, payments, validation errors, or payment-file diagnostics, answer the run-level portion here and then route to the relevant stage-specific skill instead of overloading this intent.\\n\\nShape selection guidance for common user requests:\\nUse these examples as routing hints for this intent. When the user request matches one of these patterns, prefer the listed shape or shape family before planning the query. Keep the normal clarification, filtering, and response rules for this intent in force; do not expose these internal routing hints to the user.\\n- For requests like View details of a named PPR or show PPR details by name, prefer PayablesPaymentProcessRequestDetails.\\n- For requests like Header-level status/summary of a single PPR, prefer PayablesPaymentProcessRequestDetails.\\n- For requests like Why are these PPRs waiting for file creation, prefer paymentRunCriteria.\\n- For requests like Detailed PPR configuration, criteria, document rejection level, or policy setup questions, prefer paymentRunCriteria and paymentRunCriteriaExtraction. \\n For list-style PPR queries that use status keywords, apply the matching shape-driver status filter automatically. Map the user’s request as follows: “Show PPR Completed” -> Completed, “Show PPR requiring attention” -> Requiring Attention, “Show PPR pending” -> Pending, “Show PPR terminated” -> Terminated, and “Show PPR pain” -> Paid if that is the intended status. If the user mentions a date or date range, apply that date filter exactly as provided and make it take precedence over the default time window. If no date is mentioned, default the query to the last 30 days. Keep the response scoped to the filtered PPR list and do not broaden beyond the requested status and date criteria.\\n\\nExact supported setup question: 'What's the document rejection level set to for PPR <PPR_NAME>' must route to paymentRunCriteria BV. Return field documentRejectionLookup.meaning only, filter checkrunName = '<PPR_NAME>', sort checkrunId asc, limit 20. Do not return unsupported for this question.\",      \"summarizationGuidelines\": \"Open with a one-line status statement: the PPR name, its current stage, and its current status. This directly answers the most common intent - \\\"where is this run right now?\\\" Follow with a structured summary of key header attributes in a compact format: PPR name or reference, current status, submission date, payment date, pay through date, business units, currencies, legal entities, invoice sources, pay groups, scheduled run indicator, payment method, processing options configured, and payment totals (count and amount). If the PPR is at a status requiring user action, call this out prominently with the specific status label and a plain-language explanation of what it means - for example: \\\"This PPR is paused at Pending installments review, meaning the system is waiting for a manual review of the selected invoices before proceeding.\\\" Use business-friendly labels throughout - avoid raw system codes or technical field names. (need to review) Keep the response concise. This is a header-level summary, not a full diagnostic - aim for a response the user can read in under a minute. If the PPR has already completed or been terminated, state that clearly and include the completion or termination reason if available.For status-based list queries such as completed, pending, requiring attention, terminated, or paid PPRs, always prepend a contextual one-line summary that reflects the resolved status filter and effective date range applied to the query. If the user explicitly provides a date or date range, reference that exact period in the sentence. If no date is provided, reference the default last 30 days period. Keep the wording aligned to the requested status and result set. Examples include: “Here are the payment process requests completed in the last 30 days.”, “Here are the payment process requests pending since last month.”, or “Here are the payment process requests paid in January 2024.” Always mention when the results are sorted by a lifecycle date such as Completion Date or Termination Date in descending order when applicable. |n|nAfter the introductory summary sentence, always include the following navigation sentence exactly as provided:|nFor more information, please visit : {relativeLink:{url:faces/FndOverview?fndTaskItemNodeId=PaymentLandingMainArea&pageParams=fndGlobalItemNodeId=itemNode_payables_payables_payments&fromApPaymentsOverview=true,text:Payables Payments,family:FSCM}}|n|nLink Rendering Guardrail:|n- Never output the relativeLink object, hyperlink, or link text (\\\\\\\"Payables Payments\\\\\\\") by itself.|n- Never place the link on a separate line without the preceding sentence.|n- Never start a paragraph, section, bullet, or response with the link.|n- The link must always be rendered as part of the complete navigation sentence above, with visible text immediately preceding the link.|n- If the link cannot be rendered together with the preceding sentence, omit the link rather than displaying it standalone.|n- Do not repeat the link more than once in the response.|n|nValidation Rule: Before finalizing the response, verify that the string \\\\\\\"Payables Payments\\\\\\\" does not appear anywhere unless it is contained within the exact navigation sentence above.\",      \"recommendationGuidelines\": \"Generate 3 focused next steps based on the current stage and status of the PPR. Start each recommendation with a verb. Map recommendations to the PPR's current status: if Pending installments review -> \\\"Review and curate the installment selection for this PPR before the run can proceed.\\\"; if Missing payment conversion rates or Missing cross-currency rates -> \\\"Provide the missing User conversion rates to unblock this PPR.\\\"; if Pending action to address document validation errors or Pending action to complete information required -> \\\"Diagnose the document validation errors to identify which invoices are blocked and why.\\\"; if Pending action to address payment validation errors -> \\\"Review the payment validation errors to identify which proposed payments failed and the corrective action needed.\\\"; if Pending proposed payment review -> \\\"Review the proposed payments for this PPR to confirm totals, payees, and bank accounts before the payment file is built.\\\"; if Waiting for payment file processing -> \\\"Check the payment file status for this PPR to monitor disbursement progress.\\\"; if Terminated -> \\\"Review the termination reason and determine whether to resubmit the PPR with corrected criteria.\\\"; if Completed -> \\\"No action required - the PPR has completed successfully. Check Payment File status. \\\" Do not recommend actions from multiple stage-specific skills in the same response unless the PPR spans multiple issues.\",      \"parentSkillKey\": \"ppr.findPaymentProcessRequests\",      \"clarification\": {        \"rules\": [          {            \"when\": \"The user asks for PPR details without naming a specific PPR and there is not a single active PPR already in context.\",            \"question\": \"Which Payment Process Request would you like me to show details for? Please provide the PPR name or reference number.\"          },          {            \"when\": \"A partial PPR name resolves to more than one matching PPR.\",            \"question\": \"I found multiple matching PPRs. Which one should I use?\"          },          {            \"when\": \"The user references a name that could be either a submitted PPR or a saved PPR template.\",            \"question\": \"Do you mean a specific submitted PPR, or the PPR template with that name?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"pprInstallmentSnapshotSummary\",              \"title\": \"PPR installment snapshot\",              \"description\": \"Use `paymentRunInstallmentsExtraction` only for a rolled-up snapshot of installments under the named PPR.\",              \"columns\": [                \"Grouping Value\",                \"Installment Count\",                \"Total Installment Amount\"              ]            },            {              \"key\": \"pprPaymentSnapshotSummary\",              \"title\": \"PPR payment snapshot\",              \"description\": \"Use `disbursementPaymentsExtraction` only when the PPR is past proposed payment review or payments have been created, and keep the output at snapshot-summary level.\",              \"columns\": [                \"Grouping Value\",                \"Payment Count\",                \"Total Payment Amount\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"viewPPRDetailsPm\",              \"title\": \"Payment Process Request header details\",              \"description\": \"Use for the concise run-level summary of one Payment Process Request when a single compact table is clearer than multiple sections.\",              \"columns\": [                \"PPR Name\",                \"PPR Status\",                \"Payment Date\",                \"Installments Selected\",                \"Installments Rejected\",                \"Completion Date\",                \"Pending Since\",                \"Termination Date\"              ]            },            {              \"key\": \"pprStatusAndLifecycle\",              \"title\": \"PPR status and lifecycle\",              \"description\": \"Use for the headline run-level section with the current status, plain-language explanation, and next step.\",              \"columns\": [                \"Attribute\",                \"Value\"              ]            },            {              \"key\": \"pprSelectionCriteria\",              \"title\": \"PPR selection criteria\",              \"description\": \"Use only when the user explicitly asks for the configured criteria that determine which invoices or installments the run selects.\",              \"columns\": [                \"Criterion\",                \"Configured Value\"              ]            },            {              \"key\": \"pprProcessingOptions\",              \"title\": \"PPR processing options\",              \"description\": \"Use only when the user explicitly asks for configured processing options and operational implications.\",              \"columns\": [                \"Option Name\",                \"Configured Value\",                \"Operational Implication\"              ]            },            {              \"key\": \"pprPaymentTotals\",              \"title\": \"PPR payment totals\",              \"description\": \"Use only when the user explicitly asks for run-level totals covering installments, payments, discounts, and related summary metrics.\",              \"columns\": [                \"Metric\",                \"Value\"              ]            },            {              \"key\": \"pprScheduling\",              \"title\": \"PPR scheduling\",              \"description\": \"Use only when the user explicitly asks for submission timing, template context, scheduled run information, pay through date, or payment date.\",              \"columns\": [                \"Attribute\",                \"Value\"              ]            },            {              \"key\": \"pprStatusExplanationCard\",              \"title\": \"PPR status explanation\",              \"description\": \"Use when the user asks what the current status means, what triggered it, what the user needs to do, and which skill to use next.\",              \"columns\": [                \"Attribute\",                \"Value\"              ]            }          ]        }      },      \"additionalInstructions\": \"Keep this skill run-level and decision-oriented. Anchor the default answer on `PayablesPaymentProcessRequestDetails` and keep it compact like the UI header summary. Use `paymentRunCriteria` only for explicit configuration questions, and use `paymentRunInstallmentsExtraction` and `disbursementPaymentsExtraction` only for rolled-up snapshot summaries. If the user asks for installment, validation, proposed payment, payment, or payment-file depth, answer the run summary here and then route to the relevant stage-specific skill. Document rejection level for a PPR is supported by paymentRunCriteria BV with documentRejectionLookup.meaning, checkrunName filter, checkrunId asc sort, and limit 20.\"    },    {      \"key\": \"ppr.findPaymentProcessRequests\",      \"skillType\": \"data\",      \"intentLevel\": \"base\",      \"name\": \"Find Payment Process Requests\",      \"intentDomainKnowledge\": \"A Payment Process Request is the primary mechanism in Oracle Payables for processing high-volume supplier payments. It selects invoice installments based on criteria, groups them into proposed payments, and drives payment file creation. A PPR moves through distinct lifecycle stages - Installment Selection, Document Validation, Payment Validation, and Payment File Build. At each stage it can have a range of seeded statuses, some automated and transitional, others requiring user action. This skill operates at the PPR list and search level using the `PayablesPaymentProcessRequestDetails EV` shape. It is intended to locate runs by name, id, creator, creation date, payment date, or seeded status before the user drills into one specific run.\",      \"description\": \"Guides discovery-oriented inquiries for Payment Process Requests: searching, listing, showing list-level details, counting, and grouping PPRs using the list-level filters exposed by `PayablesPaymentProcessRequestDetails EV`, such as exact seeded status, creation date, payment date, creator, PPR name, and PPR id. Use when users want to locate one or more PPRs, review the list population, or show list-level details for PPRs that match a broad filter such as status, date, creator, or payment date. For requests like 'Show details of PPRs in status Pending installments review', treat details as list-level PPR header details and return the standard PPR list columns exposed by this shape. If the user asks for details of a specific PPR identified by PPR name or PPR id, route to the specific PPR details intent. Do not use this intent for diagnostics, analysis, approval-chain details, installment-level details, payment-level details, or child-record drill-downs.\",      \"nlpExamples\": [        \"I want to view all the PPRs stuck in failure\",        \"Show me the PPR requiring action\",        \"Show PPR completed\",        \"Show PPR completed after 2025\",        \"Show PPR requiring attention in the last 30 days\",        \"Show PPR pending since last month\",        \"Show PPR terminated in 2012\",        \"Show PPR terminated from 2025 to 2026\",        \"Show PPR paid in 2012\",        \"show PPRs in pending proposed payment review status\",        \"show the payment runs scheduled today\",        \"show the payment runs scheduled tomorrow\",        \"Show PPRs in status Pending action to address payment validation errors\",        \"Show PPRs in status Pending installments review\",        \"Show payment process requests with payment validation errors\",        \"Show details of PPRs in status Pending installments review\",        \"View details of PPRs in status Pending installments review\",        \"Get details of PPRs with status Pending installments review\",        \"Display details for PPRs in pending installments review status\",        \"Show PPRs with status Payments approval initiated\",        \"Show payment process requests having status Pending installments review\",        \"Show PPR with Status Cancelled Payment\",        \"Show PPR with Status Waiting for payment file processing\",        \"List PPRs where status is Waiting for payment file processing\",        \"Find PPRs whose status equals Payments approved\",        \"Show PPRs in 'Payments completed' status\",        \"Show payment process requests with status Pending action to complete information required\",        \"Show PPR with Status Submitted\",        \"Show PPR with Status Pending installments selection\",        \"Show PPR with Status No available installments\",        \"Show PPR with Status Pending payments approval\",        \"Show PPR with Status Installments selected\",        \"Show PPR with Status Selecting installments\",        \"Show PPR with Status Failed document validation\",        \"Show PPRs in status No available installments\",        \"Show PPRs in status Pending payments approval\",        \"Show PPRs in status Installments selected\",        \"Show PPRs in status Selecting installments\",        \"Show PPRs in status Failed document validation\",        \"Show PPRs in status <status name>\",        \"Show PPRs with status <status name>\",        \"Show payment process requests having status <status name>\",        \"List PPRs where status is <status name>\",        \"Find PPRs whose status equals <status name>\",        \"Show details of PPRs in status <status name>\",        \"View details of PPRs with status <status name>\",        \"Get details of payment process requests where status is <status name>\",        \"Show payment runs created in the last N days that are still in Pending Review\"      ],      \"data\": {        \"goal\": \"Your job when using this skill is to help the user quickly locate the right PPRs by searching and listing the `PayablesPaymentProcessRequestDetails EV` shape with the exact list-level filters the user asks for, then hand off to the more detailed PPR skills once the user picks a run or a narrower follow-up path.\",        \"slices\": [          \"Primary shape: `PayablesPaymentProcessRequestDetails EV` for PPR search and list retrieval.\",          \"Exact status mapping overrides for non-missing-rate PPR_STATUS labels: Cancelled Payment => CANCELED; Waiting for payment file processing => PAYMENTS_CREATED; Submitted => SUBMITTED; Pending installments selection => UNSTARTED; No available installments => CANCELLED NO PAYMENTS; Pending payments approval => ORA_REQUIRE_APPROVAL; Installments selected => SELECTED; Selecting installments => SELECTING; Failed document validation => VALIDATION_FAILED. If the user uses explicit status-name wording such as \\\"Show PPR with Status <label>\\\", preserve the full status label as one lookup phrase and generate only paymentProcessRequestStatusCode = <LOOKUP_CODE> plus explicit user filters. Do not reinterpret exact labels as generic lifecycle, approval, installment-selection, validation-error, payment-file, or unsupported flows. Missing payment conversion rates and Missing cross-currency rates may continue to use the missing-rate review behavior.\",          \"Exact PPR status-name rule: when the user asks for PPRs or payment process requests with wording such as 'with status <status name>', 'having status <status name>', 'where status is <status name>', 'status equals <status name>', 'status set to <status name>', 'for status <status name>', 'in status <status name>', or 'in <status name> status', treat <status name> as a PPR_STATUS display name from paymentProcessRequestStatusCode.displayedFieldLookupCodes. Use PayablesPaymentProcessRequestDetails EV and generate paymentProcessRequestStatusCode = '<LOOKUP_CODE>' only for that status, plus any explicit user-supplied supported filters. Do not filter the display text itself, do not use paymentProcessRequestStatus, and do not use requestStatusCode for this exact status-name pattern. Do not add a default date filter unless the user asks for a date or date range. Preserve multi-word status labels as one status phrase. Required exact mappings include Cancelled Payment => CANCELED, Waiting for payment file processing => PAYMENTS_CREATED, Submitted => SUBMITTED, and Pending installments selection => UNSTARTED. Existing lifecycle/business drivers still apply for non-exact wording such as 'Show PPR completed', 'Show PPR pending', 'Show PPR terminated', 'Show PPR pending approval', or missing-rate questions.\",          \"Intent contract: this skill is list-oriented and discovery-first. It supports searching, listing, showing list-level details, counting, and grouping PPR header records only. It must not be used for diagnostics, analysis, approval-chain details, installment-level details, payment-level details, or child-record drill-downs.\",          \"Details-by-filter handling: requests like 'show details of PPRs in status X', 'view details of PPRs created last month', 'get details of PPRs requiring attention', or 'display details for completed PPRs' are valid for this skill when the requested details can be satisfied from PPR header/list fields exposed by `PayablesPaymentProcessRequestDetails EV`. Return the standard PPR list output columns rather than routing away from this intent.\",          \"Specific-record handoff: if the user asks for details of one PPR and provides a specific PPR name or PPR id, route to the specific PPR details skill instead of this list skill. Do not treat status, date, creator, amount, business unit, supplier, currency, or organization as a specific PPR identifier.\",          \"PPR list query: fetch `PayablesPaymentProcessRequestDetails EV` with the user's supported list filters - `checkrunId`, `checkrunName`, `timeCreated`, `checkDate`, `createdBy`, `requestStatusCode`, `requestStatus`, `paymentProcessRequestStatusCode`, and `paymentProcessRequestStatus` - and return PPR name, PPR id, creation date, payment date, creator, request status, and seeded status when available.\",          \"Grouped count query: aggregate over filtered `PayablesPaymentProcessRequestDetails EV` rows when the user asks for counts by seeded PPR status, creation-date bucket, payment-date bucket, or creator.\",          \"Action-needed seeded-status query: when the user asks for stuck, failed, approval-pending, or workflow-specific attention-like PPRs, use the relevant seeded status subset or business driver on `PayablesPaymentProcessRequestDetails EV` instead of collapsing every status question to the high-level request-status bucket.\",          \"High-level request-status query: when the user asks for PPRs requiring attention, completed, or in process, use `requestStatusCode` on `PayablesPaymentProcessRequestDetails EV`; a separate summary view is not required for those status filters. Terminated PPRs are an explicit exception: use `paymentProcessRequestStatusCode IN ('TERMINATED')` plus `paymentFileReference = null`, apply the termination date filter on `terminationDate`, and sort by `terminationDate` descending.\",          \"For 'PPRs stuck in failure' requests, use the `pprStuckInValidationFailure` business driver and do not apply a plain `FAILED_PAYMENT_VALIDATION` status filter.\",          \"For list-style PPR queries and list-level detail queries that use status keywords, apply the matching shape-driver status filter automatically. Map the user’s request as follows: “Show PPR Completed” -> Completed, “Show PPR requiring attention” -> Requiring Attention, “Show PPR pending” -> Pending, “Show PPR terminated” -> Terminated, and “Show PPR pain” -> Paid if that is the intended status. If the user mentions a date or date range, apply that date filter exactly as provided and make it take precedence over the default time window. If no date is mentioned, default the query to the last 30 days. Keep the response scoped to the filtered PPR list and do not broaden beyond the requested status and date criteria.\",          \"Routing self-check: before using this skill, confirm the user is asking for a list, search result, list-level details, count, or grouped count of PPRs. If the user asks for diagnostics, explanation, approval-chain information, installment details, payment details, or any child-record drill-down, this skill is not eligible.\",          \"If user asks to 'Show me all PPRs pending approval' must use PayablesPaymentProcessRequestDetails EV with paymentProcessRequestStatusCode in ('PENDING_REVIEW','ORA_REQUIRE_APPROVAL','ORA_APPROVAL_INITIATED') and pendingSince recencT filter.\"        ]      },      \"promptInstruction\": \"Use `PayablesPaymentProcessRequestDetails EV` as the primary shape for this skill.\\n\\nExact PPR status-name rule: when the user asks for PPRs or payment process requests with wording such as 'with status <status name>', 'having status <status name>', 'where status is <status name>', 'status equals <status name>', 'status set to <status name>', 'for status <status name>', 'in status <status name>', or 'in <status name> status', treat <status name> as a PPR_STATUS display name from paymentProcessRequestStatusCode.displayedFieldLookupCodes. Use PayablesPaymentProcessRequestDetails EV and generate paymentProcessRequestStatusCode = '<LOOKUP_CODE>' only for that status, plus any explicit user-supplied supported filters. Do not filter the display text itself, do not use paymentProcessRequestStatus, and do not use requestStatusCode for this exact status-name pattern. Do not add a default date filter unless the user asks for a date or date range. Preserve multi-word status labels as one status phrase: Cancelled Payment maps to CANCELED, Waiting for payment file processing maps to PAYMENTS_CREATED, Submitted maps to SUBMITTED, and Pending installments selection maps to UNSTARTED. If a rewrite splits Pending installments selection into wording like 'Pending and installments selection', still treat it as the single PPR_STATUS label Pending installments selection and map to UNSTARTED, not INSERTED. Existing lifecycle/business drivers still apply for non-exact wording such as 'Show PPR completed', 'Show PPR pending', 'Show PPR terminated', 'Show PPR pending approval', or missing-rate questions. Exact status mapping overrides for non-missing-rate PPR_STATUS labels: Cancelled Payment => CANCELED; Waiting for payment file processing => PAYMENTS_CREATED; Submitted => SUBMITTED; Pending installments selection => UNSTARTED; No available installments => CANCELLED NO PAYMENTS; Pending payments approval => ORA_REQUIRE_APPROVAL; Installments selected => SELECTED; Selecting installments => SELECTING; Failed document validation => VALIDATION_FAILED. If the user uses explicit status-name wording such as \\\"Show PPR with Status <label>\\\", preserve the full status label as one lookup phrase and generate only paymentProcessRequestStatusCode = <LOOKUP_CODE> plus explicit user filters. Do not reinterpret exact labels as generic lifecycle, approval, installment-selection, validation-error, payment-file, or unsupported flows. Missing payment conversion rates and Missing cross-currency rates may continue to use the missing-rate review behavior.\\n\\nThis skill is for PPR discovery at the list, count, grouped-count, or list-level detail level. The user's primary requested result may be to search, list, show details, view details, get details, fetch details, display details, count, or group PPR header records.\\n\\nWhen the user asks to show, view, get, fetch, or display details of PPRs using a broad filter such as status, date, creator, payment date, request status, seeded PPR status, or similar list-level criteria, treat details as list-level PPR header details and use this skill. For example, \\\"Show details of PPRs in status Pending installments review\\\" must be handled by this skill and filtered by the exact seeded PPR status \\\"Pending installments review\\\".\\n\\nDo not treat the word \\\"details\\\" by itself as a reason to reject this intent. For broad-filter PPR requests, \\\"details\\\" means the standard PPR list output columns exposed by `PayablesPaymentProcessRequestDetails EV`, not a child-record drill-down.\\n\\nDo not use this skill for diagnostics, analysis, explanation, root cause, approval-chain details, installment-level details, payment-level details, proposed-payment details, document-validation details, payment-validation details, payment file details, or any child-record drill-down.\\n\\nIf the user asks for details of a specific PPR identified by PPR name or PPR id, route to `ppr.viewPaymentProcessRequestDetails` or the appropriate specific PPR details skill. Status, date, creator, supplier, amount, business unit, currency, organization, payment method, or similar filters must not be treated as a specific PPR identifier.\\n\\nIdentify the discovery query type first - filtered list, list-level details, grouped count, recent activity review, request-status search, or seeded-status subset search - then build the response from the `PayablesPaymentProcessRequestDetails EV` list shape only.\\n\\nFor filtered list and list-level detail queries, apply the user's supported filters using `checkrunId`, `checkrunName`, `timeCreated`, `checkDate`, `createdBy`, `requestStatusCode`, `requestStatus`, `paymentProcessRequestStatusCode`, or `paymentProcessRequestStatus`. If no filter is provided, default to a recent or active-oriented list and state the assumption.\\n\\nFor grouped count queries, aggregate counts over the filtered `PayablesPaymentProcessRequestDetails EV` result set by the requested grouping, such as seeded status, request status, payment date bucket, creation date bucket, or creator.\\n\\nFor high-level request statuses such as requiring attention, completed, in process, pending, or paid, use `requestStatusCode` on `PayablesPaymentProcessRequestDetails EV` when applicable and do not require a separate summary view. Terminated PPRs are an explicit exception: never use `requestStatusCode` for terminated PPR filters; use `paymentProcessRequestStatusCode IN ('TERMINATED')` plus `paymentFileReference = null`, apply the termination date filter on `terminationDate`, and sort by `terminationDate` descending.\\n\\nFor exact seeded PPR statuses and exact status-name requests, always use `paymentProcessRequestStatusCode` on `PayablesPaymentProcessRequestDetails EV`; map the user-facing status display name to its lookup code from `paymentProcessRequestStatusCode.displayedFieldLookupCodes`. Do not use `paymentProcessRequestStatus`, `requestStatusCode`, or the display text itself for exact status-name filtering.\\n\\nFor stuck, failed, approval-pending, or attention-style discovery that refers to a workflow condition, map the request to the relevant seeded PPR status subset using `paymentProcessRequestStatusCode` or the available business driver. Be explicit when the filter is high-level request status versus exact seeded PPR status.\\n\\nWhen the user asks for exact PPR search results or list-level PPR details, return only the columns the shape exposes for search output - PPR id, PPR name, creation date, payment date, creator, request status, and seeded status when available. Do not claim unsupported list attributes such as business unit, template, payment method, payment value, payment file, approval-chain detail, or line-level installment and payment data.\\n\\nWhen the user chooses a specific PPR or needs deeper diagnostics, route to `ppr.viewPaymentProcessRequestDetails` or the appropriate stage-specific skill instead of stretching this search skill.\\n\\nIf the user asks for PPRs stuck in failure, use the `pprStuckInValidationFailure` business driver and do not use a plain `FAILED_PAYMENT_VALIDATION` filter.\\n\\nShape selection guidance for common user requests:\\nUse these examples as routing hints for this intent. When the user request matches one of these patterns, prefer the listed shape or shape family before planning the query. Keep the normal clarification, filtering, and response rules for this intent in force; do not expose these internal routing hints to the user.\\n- For requests like PPR list/status/date questions such as \\\"Show PPR completed\\\", \\\"Show PPR completed after 2025\\\", \\\"Show PPR requiring attention in the last 30 days\\\", \\\"Show PPR pending since last month\\\", \\\"Show PPR pending on a date\\\", \\\"Show PPR paid in a year\\\", or \\\"Show payment process requests with payment date in a year\\\", prefer `PayablesPaymentProcessRequestDetails EV` with `requestStatusCode` for high-level status buckets when applicable. For \\\"Show PPR terminated\\\" or terminated date-range requests, still use `PayablesPaymentProcessRequestDetails EV`, but filter with `paymentProcessRequestStatusCode IN ('TERMINATED')` plus `paymentFileReference = null`, not `requestStatusCode`.\\n- For requests like \\\"Show me the PPR requiring action\\\", prefer `PayablesPaymentProcessRequestDetails EV` and treat requiring action as requiring attention.\\n- For requests like \\\"Show PPRs in status Pending installments review\\\", prefer `PayablesPaymentProcessRequestDetails EV` and filter by the exact seeded PPR status.\\n- For requests like \\\"Show details of PPRs in status Pending installments review\\\", prefer `PayablesPaymentProcessRequestDetails EV`, treat \\\"details\\\" as list-level details, and filter by the exact seeded PPR status.\\n\\nFor list-style or list-level-detail PPR queries that use status keywords, apply the matching shape-driver status filter automatically. Map the user’s request as follows: \\\"Show PPR Completed\\\" -> Completed, \\\"Show PPR requiring attention\\\" -> Requiring Attention, \\\"Show PPR pending\\\" -> Pending, \\\"Show PPR terminated\\\" -> Terminated driver using `paymentProcessRequestStatusCode IN ('TERMINATED')` plus `paymentFileReference = null`, and \\\"Show PPR pain\\\" -> Paid if that is the intended status.\\n\\nIf the user mentions a date or date range, apply that date filter exactly as provided and make it take precedence over the default time window. If no date is mentioned, default the query to the last 30 days. Keep the response scoped to the filtered PPR list and do not broaden beyond the requested status and date criteria.\\n\\nFor PPR requiring action, consider it as PPR requiring attention and ensure to apply the default date filter on `pendingSince`.\\n\\nFor PPRs stuck in failure, ensure to apply the default last 30 days filter on `pendingSince` if the user does not provide a value.\\n\\nFinal guardrail: if the user request contains the word \\\"details\\\" or an equivalent phrase such as \\\"show details\\\", \\\"view details\\\", \\\"get details\\\", \\\"fetch details\\\", or \\\"display details\\\" together with a broad PPR filter such as status, seeded status, date, creator, request status, or payment date, treat it as a list-level detail request and use this skill. Only route away when the user asks for diagnostics, analysis, explanation, root cause, approval-chain details, installment details, payment details, proposed-payment details, document-validation details, payment-validation details, payment file details, run summary, or another child-record drill-down.\\n\\nFor requiring-attention or similar recency PPR lists, use the current calendar date minus exactly 30 days on `pendingSince`. Do not anchor to yesterday.\\n\\nFor requiring-attention or similar recency PPR lists, use `requestStatusCode='REQUIRING_ATTENTION'` and a `pendingSince` recency filter resolved from the user date or workflow/test as-of date.\\n\\nFor terminated PPR lists, use `paymentProcessRequestStatusCode IN ('TERMINATED')`, `paymentFileReference = null`, termination date filtering, and termination date descending sort.\\n\\nFor completed PPR list requests such as 'Show PPR completed', use requestStatusCode = 'COMPLETED', default completionDate >= current date minus 30 days when no date is supplied, return paymentProcessRequest,paymentProcessRequestStatus,paymentDate,installmentsSelected,installmentsRejected,pendingSince,completionDate,payablesPaymentProcessRequestId,paymentProcessRequestStatusCode, and sort by completionDate:desc. Never sort completed PPR lists by paymentDate or paymentProcessRequestCreationDate. For terminated PPR list requests with a year or date range, use paymentProcessRequestStatusCode IN ('TERMINATED') plus paymentFileReference = null, filter on terminationDate, and sort by terminationDate:desc; never sort terminated lists by paymentProcessRequestCreationDate.\\n\\nFor completed PPR list display fields, return completionDate as a displayed field and use it as the filter/sort axis; do not replace it with paymentProcessRequestCreationDate. \\n\\n If user asks to 'Show me all PPRs pending approval' must use PayablesPaymentProcessRequestDetails EV with paymentProcessRequestStatusCode in ('PENDING_REVIEW','ORA_REQUIRE_APPROVAL','ORA_APPROVAL_INITIATED') and pendingSince recencT filter.\",      \"summarizationGuidelines\": \"Always start with a short summary directly answering the question with key headline numbers. Restrict to around 100 words in bullet points. Summarize the number of PPRs found and highlight key patterns - for example, how many are blocked, how many completed, which business units are most affected. Present the highest-signal information first: runs requiring attention before runs that are progressing normally. Follow the summary with the detail list relevant to the question, including PPR name or reference, current stage, status, submission date, and business unit at minimum. If the search reveals a dominant pattern (e.g., many runs stuck at document validation), mention it briefly but do not perform deep diagnosis - surface the pattern and recommend the appropriate next skill. When no PPRs are found, state that no payment process requests match the criteria and suggest checking the filters or date range. Use business-friendly status labels (e.g., \\\"Pending installments review\\\") - avoid raw system codes.|n|nAfter the introductory summary sentence, always include the following navigation sentence exactly as provided:|nFor more information, please visit : {relativeLink:{url:faces/FndOverview?fndTaskItemNodeId=PaymentLandingMainArea&pageParams=fndGlobalItemNodeId=itemNode_payables_payables_payments&fromApPaymentsOverview=true,text:Payables Payments,family:FSCM}}|n|nLink Rendering Guardrail:|n- Never output the relativeLink object, hyperlink, or link text (\\\"Payables Payments\\\") by itself.|n- Never place the link on a separate line without the preceding sentence.|n- Never start a paragraph, section, bullet, or response with the link.|n- The link must always be rendered as part of the complete navigation sentence above, with visible text immediately preceding the link.|n- If the link cannot be rendered together with the preceding sentence, omit the link rather than displaying it standalone.|n- Do not repeat the link more than once in the response.|n|nValidation Rule: Before finalizing the response, verify that the string \\\"Payables Payments\\\" does not appear anywhere unless it is contained within the exact navigation sentence above.\",      \"recommendationGuidelines\": \"Generate 3 concrete next steps when there are PPRs requiring attention or a clear follow-up action exists. Start each recommendation with a verb. Give the recommendation as form of query the user can ask. Tailor recommendations to the dominant Prominent pattern in the results - for example: If runs are blocked at installment review: \\\"Review and curate installment selection for PPR [name].\\\"(deeplink) If runs have document validation errors: \\\"Diagnose document validation errors for PPR [name] to identify missing setup.\\\"(deeplink) If runs are pending proposed payment review: \\\"Review proposed payments for PPR [name] before the payment file is built.\\\"(deeplink) If the queue is clear: \\\"Monitor the queue again after the next scheduled batch runs.\\\" Use the overview section for additional context on stage meanings if required.\",      \"clarification\": {        \"rules\": [          {            \"when\": \"The user asks to show PPRs without specifying a filter and the active queue is large enough that a broad list may be hard to scan.\",            \"question\": \"I can default to a recent or active-oriented list, but would you like me to narrow this by status or date range first?\"          },          {            \"when\": \"The user asks for stalled or stuck PPRs without defining what stalled means.\",            \"question\": \"Should I treat stalled as a seeded status subset such as missing rates, validation errors, approval error, or information required?\"          },          {            \"when\": \"The user asks for recently completed PPRs without giving a date range.\",            \"question\": \"Should I use the default window of the last 7 days for recently completed PPRs?\"          },          {            \"when\": \"The user asks a question that could be answered with either a count or a full list.\",            \"question\": \"Do you want just the count, or both the count summary and the matching PPR list?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"pprGroupingSummary\",              \"description\": \"Use when the user asks for grouped counts by seeded PPR status, creation date bucket, payment date bucket, or creator.\",              \"title\": \"Payment Process Requests grouped summary\",              \"columns\": [                \"Grouping Value\",                \"PPR Count\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"pprList\",              \"description\": \"Use for the core PPR search result list from `PayablesPaymentProcessRequestDetails EV`.\",              \"title\": \"Payment Process Requests\",              \"columns\": [                \"PPR Name\",                \"Creation Date\",                \"Payment Date\",                \"Created By\",                \"PPR Status\"              ]            },            {              \"key\": \"getPPRByStatus\",              \"description\": \"Use when the user filters by status such as requiring attention, completed, in process, or terminated using `PayablesPaymentProcessRequestDetails EV`.\",              \"title\": \"Payment Process Requests\",              \"columns\": [                \"PPR Name\",                \"Creation Date\",                \"Payment Date\",                \"Created By\",                \"PPR Status\"              ]            }          ]        }      },      \"additionalInstructions\": \"Exact status mapping overrides for non-missing-rate PPR_STATUS labels: Cancelled Payment => CANCELED; Waiting for payment file processing => PAYMENTS_CREATED; Submitted => SUBMITTED; Pending installments selection => UNSTARTED; No available installments => CANCELLED NO PAYMENTS; Pending payments approval => ORA_REQUIRE_APPROVAL; Installments selected => SELECTED; Selecting installments => SELECTING; Failed document validation => VALIDATION_FAILED. If the user uses explicit status-name wording such as \\\"Show PPR with Status <label>\\\", preserve the full status label as one lookup phrase and generate only paymentProcessRequestStatusCode = <LOOKUP_CODE> plus explicit user filters. Do not reinterpret exact labels as generic lifecycle, approval, installment-selection, validation-error, payment-file, or unsupported flows. Missing payment conversion rates and Missing cross-currency rates may continue to use the missing-rate review behavior.\\n\\nExact PPR status-name rule: when the user asks for PPRs or payment process requests with wording such as 'with status <status name>', 'having status <status name>', 'where status is <status name>', 'status equals <status name>', 'status set to <status name>', 'for status <status name>', 'in status <status name>', or 'in <status name> status', treat <status name> as a PPR_STATUS display name from paymentProcessRequestStatusCode.displayedFieldLookupCodes. Use PayablesPaymentProcessRequestDetails EV and generate paymentProcessRequestStatusCode = '<LOOKUP_CODE>' only for that status, plus any explicit user-supplied supported filters. Do not filter the display text itself, do not use paymentProcessRequestStatus, and do not use requestStatusCode for this exact status-name pattern. Do not add a default date filter unless the user asks for a date or date range. Preserve multi-word status labels as one status phrase. Required exact mappings include Cancelled Payment => CANCELED; Waiting for payment file processing => PAYMENTS_CREATED; Submitted => SUBMITTED; Pending installments selection => UNSTARTED; No available installments => CANCELLED NO PAYMENTS; Pending payments approval => ORA_REQUIRE_APPROVAL; Installments selected => SELECTED; Selecting installments => SELECTING; Failed document validation => VALIDATION_FAILED. If a rewrite splits Pending installments selection into wording like 'Pending and installments selection', still map to UNSTARTED. Existing lifecycle/business drivers still apply for non-exact wording such as 'Show PPR completed', 'Show PPR pending', 'Show PPR terminated', 'Show PPR pending approval', or missing-rate questions.\\nKeep this skill list-oriented and discovery-first. Build it from `PayablesPaymentProcessRequestDetails EV`, and do not claim unsupported attributes such as business unit, template, payment method, payment value, payment file, or approval-chain detail. Use `requestStatusCode` for high-level buckets such as requiring attention, completed, and in process; use seeded PPR status for exact workflow status filtering. Terminated PPRs are an explicit exception and must use `paymentProcessRequestStatusCode IN ('TERMINATED')` plus `paymentFileReference = null`. Treat broad-filter requests that ask for PPR details as list-level detail requests when they can be answered from the standard PPR header/list columns. Route deeper questions to the detail or stage-specific skills instead of stretching the list contract. For PPRs stuck in failure, use the `pprStuckInValidationFailure` business driver rather than a generic failed-payment-validation filter.\\nTreat business-driver filters as the required semantic core, not a closed-form query. When the user adds explicit constraints such as date or date range, PPR name/id, supplier, business unit, currency, amount, status, payment method, bank account, or payment file, add those filters when the selected shape exposes the field. A user-provided date filter overrides the default recency window. Do not drop required status, null-rate, source-shape, or sorting rules unless the user explicitly asks for a different lifecycle/source and the selected shape supports it.\\nIf a requested filter, grouping, or output field is not exposed by the selected shape, do not invent a field or silently drop the constraint. Choose another supported shape that exposes it, or state the limitation while returning the closest supported query context.\\n\\nFor completed PPR list requests such as 'Show PPR completed', use requestStatusCode = 'COMPLETED', default completionDate >= current date minus 30 days when no date is supplied, return paymentProcessRequest,paymentProcessRequestStatus,paymentDate,installmentsSelected,installmentsRejected,pendingSince,completionDate,payablesPaymentProcessRequestId,paymentProcessRequestStatusCode, and sort by completionDate:desc. Never sort completed PPR lists by paymentDate or paymentProcessRequestCreationDate. For terminated PPR list requests with a year or date range, use paymentProcessRequestStatusCode IN ('TERMINATED') plus paymentFileReference = null, filter on terminationDate, and sort by terminationDate:desc; never sort terminated lists by paymentProcessRequestCreationDate.\\n\\nFor completed PPR list display fields, return completionDate as a displayed field and use it as the filter/sort axis; do not replace it with paymentProcessRequestCreationDate.\"    },    {      \"key\": \"ppr.reviewPPRTemplatesAndSchedules\",      \"skillType\": \"data\",      \"intentLevel\": \"base\",      \"name\": \"Review PPR Templates and Schedules\",      \"intentDomainKnowledge\": \"A PPR Template is a saved configuration that pre-populates the Submit Payment Process Request page. It stores the selection criteria (pay through date basis, payment method, business unit, pay group, currency, supplier filters), processing options (whether to pause for installment review, how to handle validation failures, whether to apply credits to zero), and payment attributes (payment date basis, payment document, payment process profile). Templates eliminate the need to re-enter run parameters each time and ensure consistency across recurring pay runs. Templates can be configured with a schedule to run automatically at defined intervals - daily, weekly, or monthly - without manual submission. If a scheduled run does not trigger, it is typically due to the schedule being inactive, a processing calendar conflict, or the template configuration having an error. Multiple templates can exist across business units and payment methods. Users often need to compare templates to select the right one for a targeted or urgent run, or to confirm that an existing template covers the right suppliers and criteria before submitting. This skill is strictly about saved template configurations and their schedules - it does not cover the status or outcomes of active PPR runs generated from those templates.\",      \"description\": \"Surfaces details of saved PPR templates - selection criteria, processing options, payment attributes, scheduled recurrence, and which business units or pay groups they serve. Use when the user wants to understand a template's configuration, compare templates before submitting a run, troubleshoot why a scheduled run did not trigger, or identify the best matching template for a specific payment need.\",      \"nlpExamples\": [        \"What PPR templates are available for EFT payments?\"      ],      \"data\": {        \"goal\": \"Your job when using this skill is to help the user find, understand, and compare PPR templates - so they can confidently select the right template for a submission, diagnose why a scheduled run did not fire, or verify that a template's configuration matches the requirements of an upcoming payment run.\",        \"slices\": [          \"Primary shapes: PPR Template, PPR Template Schedule, PPR Template Selection Criteria, PPR Template Processing Options.\",          \"Single template detail query: fetch the full template record including selection criteria, processing options, payment attributes, and schedule configuration for the named template.\",          \"Template list or comparison query: fetch a summary list of templates filtered by the user's stated dimensions - payment method, business unit, pay group, or processing option flags - with key attributes per template for side-by-side comparison.\",          \"Schedule diagnosis query: fetch the schedule record for the named template including schedule status, frequency, last run date, next scheduled run date, and any error or inactive flags.\",          \"Best-match template query: fetch templates filtered to the payment method and business unit implied by the user's context; rank by coverage match against the stated criteria. Do not fetch active PPR run data, payment file data, or installment-level data from live runs - those are handled by separate skills.\"        ]      },      \"promptInstruction\": \"Identify the query type first - single template detail, template list or comparison, schedule diagnosis, or best-match recommendation - then plan the data slices accordingly. For single template detail queries: retrieve and present the full configuration of the named template including all selection criteria, processing options, payment attributes, and schedule settings. If the template name is partially specified, resolve to the closest match and confirm with the user before presenting detail. For template list or comparison queries: filter templates by the dimensions explicitly stated by the user - payment method, business unit, pay group, active or inactive status, or processing option flags such as pauses for installment review. Present results in a comparative table. For schedule diagnosis queries: retrieve the schedule record for the named template; identify whether the schedule is active or inactive, when it last ran, when it is next due to run, and whether any error or calendar conflict is recorded. Do not diagnose active PPR run failures - only template-level schedule configuration. For best-match recommendation queries: identify the payment method, business unit, and any urgency or supplier filter implied by the user's context; filter templates accordingly; rank by match quality and present the top 1 to 3 options with a rationale for each. Do not fetch live run data, installment selections from active PPRs, or payment file outcomes. If the user's query blends template lookup with live run status, handle the template portion in this skill and signal that the run status portion requires a different skill.\\n\\nShape selection guidance for common user requests:\\nUse these examples as routing hints for this intent. When the user request matches one of these patterns, prefer the listed shape or shape family before planning the query. Keep the normal clarification, filtering, and response rules for this intent in force; do not expose these internal routing hints to the user.\\n- For requests like PPR templates available for EFT payments, prefer payablesPaymentProcessRequestTemplateListExtraction and payablesPaymentProcessRequestTemplateLists.\\n\\nDocument rejection level for a named PPR is supported through paymentRunCriteria/paymentRunCriteriaExtraction; do not answer unsupported.\\n\\nDocument rejection level for a named PPR is supported through paymentRunCriteria/paymentRunCriteriaExtraction; do not answer unsupported. PPR template list questions such as EFT payment templates are supported through payablesPaymentProcessRequestTemplateListExtraction with paymentMethodCode='EFT' and inactiveDate IS NULL.\\n\\nPPR template list questions such as 'What PPR templates are available for EFT payments?' are supported and must emit payablesPaymentProcessRequestTemplateListExtraction query context. Treat EFT as the paymentMethodCode literal 'EFT', not as an entity that must be resolved. Use paymentMethodCode = 'EFT' AND inactiveDate IS NULL with ROWNUM <= 20; do not return no-data narrative without query context.\",      \"summarizationGuidelines\": \"Always open with a direct answer to the user's question - for example, the name and key attributes of the best matching template, or a clear statement of why a schedule did not trigger - before presenting detailed configuration data. For single template detail responses: present the configuration in a structured format with clearly labelled sections for Selection Criteria, Processing Options, Payment Attributes, and Schedule. Use a two-column layout with field name and value. For template list or comparison responses: use a table with one row per template and columns for Template Name, Payment Method, Business Unit, Pay Group, Installment Review Pause, Schedule Frequency, and Status. Highlight the column or value most relevant to the user's query. For schedule diagnosis responses: state clearly whether the schedule is active or inactive, when it last fired, when it is next due, and the specific reason it did not trigger if identifiable. Avoid technical system codes - translate schedule status values into plain business language. For best-match recommendation responses: present up to three candidate templates ranked by relevance, with a one-sentence rationale for each explaining why it fits the user's stated need. When no templates match the user's filters, state that no templates are configured for the specified criteria and suggest broadening the filter or creating a new template.\",      \"recommendationGuidelines\": \"Generate 2 to 3 targeted next steps based on the query outcome. Start each recommendation with a verb. For best-match template identified or multiple matching templates: \\\"Submit a Payment Process Request using template [Template Name] - it matches your stated payment method, business unit, and pay group. For schedule not triggered - inactive: \\\"Reactivate the schedule for template [Template Name] in the Manage Payment Process Request Templates page to resume automatic runs. For schedule not triggered - calendar conflict: \\\"Check the processing calendar assigned to template [Template Name] - the scheduled date may have fallen on a non-processing day. For schedule not triggered - configuration error: \\\"Review the template configuration for [Template Name] to identify and correct the error preventing the schedule from firing. For no matching template found: \\\"Consider creating a new PPR template for [payment method] payments in [business unit] to standardise future runs for this payment type. Do not recommend executing a run directly - provide the navigational path and configuration guidance only.\",      \"clarification\": {        \"rules\": [          {            \"when\": \"if the user asks for template details without naming a template, You can provide the template name or describe the payment method and business unit it covers.\",            \"question\": \"Which PPR template would you like me to review?\"          },          {            \"when\": \"if the user asks for a template recommendation but has not specified payment method or business unit,\",            \"question\": \"Could you confirm the payment method and business unit for this run so I can identify the best matching template?\"          },          {            \"when\": \"if the user asks why a scheduled run did not trigger without naming the template,\",            \"question\": \"Which template's schedule would you like me to investigate?\"          }        ]      },      \"outputPattern\": {        \"details\": {          \"tables\": [            {              \"key\": \"pprTemplates\",              \"title\": \"Payment Process Request templates\",              \"columns\": [                \"Template Name\",                \"Status\",                \"Type\",                \"Payment Method\",                \"Business Unit\",                \"Payment Process Profile\",                \"Create Payment Files Immediately\"              ]            }          ]        }      },      \"additionalInstructions\": \"Single template detail: two-column structured table with field name in the left column and value in the right. Group rows into labelled sections - Selection Criteria, Processing Options, Payment Attributes, Schedule Configuration. Highlight any fields that are blank or not configured. Template list or comparison: multi-column table with one row per template. Columns: Template Name, Payment Method, Business Unit, Pay Group, Installment Review Pause (Yes or No), Auto File Creation (Yes or No), Schedule Frequency, Active Status. Bold or flag the column most relevant to the user's filter. Schedule diagnosis: structured summary - Template Name, Schedule Status, Frequency, Last Run Date, Next Scheduled Run Date, Failure Reason if applicable. Present as a labelled two-column table. Best-match recommendation: ranked list of up to three templates with Template Name, Key Matching Attributes, and a one-sentence rationale per option. All outputs: precede the table or list with a 1 to 2 sentence plain-language summary of the key finding. Use business-friendly labels for all processing option flags - avoid raw system codes or internal field identifiers.\\nTreat business-driver filters as the required semantic core, not a closed-form query. When the user adds explicit constraints such as date or date range, PPR name/id, supplier, business unit, currency, amount, status, payment method, bank account, or payment file, add those filters when the selected shape exposes the field. A user-provided date filter overrides the default recency window. Do not drop required status, null-rate, source-shape, or sorting rules unless the user explicitly asks for a different lifecycle/source and the selected shape supports it.\\nIf a requested filter, grouping, or output field is not exposed by the selected shape, do not invent a field or silently drop the constraint. Choose another supported shape that exposes it, or state the limitation while returning the closest supported query context.\\n\\nPPR template list questions such as 'What PPR templates are available for EFT payments?' are supported and must emit payablesPaymentProcessRequestTemplateListExtraction query context. Treat EFT as the paymentMethodCode literal 'EFT', not as an entity that must be resolved. Use paymentMethodCode = 'EFT' AND inactiveDate IS NULL with ROWNUM <= 20; do not return no-data narrative without query context.\"    },    {      \"key\": \"payablesInvoice.findInvoices\",      \"skillType\": \"data\",      \"intentLevel\": \"base\",      \"name\": \"Find Payables Invoices\",      \"intentDomainKnowledge\": \"Payables invoice inquiries in this scope cover standalone invoice-installment drilldown and supplier credit memo aging. These flows are invoice-centric rather than payment-run-centric. Installment drilldown is for unpaid or pending invoice schedule rows before payment-run selection, while credit memo aging is for reviewing open supplier credit memos and their later payment context. Questions about payment process requests, proposed payments, payment files, transmission, acknowledgements, or payment-run exceptions belong to other intent families.\",      \"description\": \"Routes payables-invoice questions to the correct child intent for installment drilldown or supplier credit memo aging.\",      \"nlpExamples\": [        \"Show me installment drill down for supplier Advanced Network Devices in USD for Vision Operations.\",        \"Show me invoice installments due in the next 10 days for this supplier.\",        \"Show credit memos for supplier Advanced Network Devices with aging.\",        \"Show credit memos with aging for all suppliers.\",        \"List unpaid credit memos for supplier ABC by age.\"      ],      \"data\": {        \"goal\": \"Classify invoice-centric payables questions and route them to the correct child intent without mixing them with PPR or payment-file diagnostics.\",        \"slices\": [          \"Installment drilldown slice for unpaid or pending invoice installment schedule detail by supplier, business unit, and invoice currency.\",          \"Credit memo aging slice for supplier credit memo review by invoice-date window, aging, unpaid amount, and later AP-checks payment context.\"        ]      },      \"promptInstruction\": \"Use this parent intent only to classify and route payables-invoice questions. Route installment schedule detail questions, unpaid installment review, due-date drilldown, payment-term detail, supplier-site drilldown, bank detail, payment method detail, discount date, discount amount, or installment rows before payment-run selection to `payablesInvoice.answerInstallmentDrilldownQuestions`. Route supplier credit memo aging, unpaid credit memo review, credit memo invoice-date range review, or later-payment context for supplier credit memos to `payablesInvoice.showCreditMemosBySupplierAging`. Keep payables-invoice flows separate from payment process request, proposed payment, rejected payment, transmission, acknowledgement, or payment-file questions. If the user asks about installments selected into a PPR, rejected installments, payment validation, missing rates, or payment-file outcomes, route to the relevant PPR or payment-file intent family instead of this parent.\",      \"summarizationGuidelines\": \"For parent-level responses, keep the summary short and state which payables-invoice path is being used. If the question is about installment schedule rows, state that the installment drilldown path will be used. If the question is about credit memo review, state that the credit memo aging path will be used. Do not present payment-run or payment-file analysis from this parent.\",      \"recommendationGuidelines\": \"Recommend the next payables-invoice question or route based on the user's current ask: installment drilldown detail or credit memo aging review. Do not recommend backend changes directly from the parent.\",      \"clarification\": {        \"rules\": [          {            \"when\": \"The user asks about invoices or installments in a way that could mean either installment drilldown or credit memo aging and the intent is not clear from the request.\",            \"question\": \"Should I review invoice installment details or supplier credit memo aging?\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"payablesInvoiceRoutingSummary\",              \"description\": \"Use when a broad payables-invoice question needs to be classified before a child intent answers it.\",              \"title\": \"Payables invoice inquiry route\",              \"columns\": [                \"Requested Topic\",                \"Invoice Context\",                \"Selected Route\"              ]            }          ]        }      },      \"additionalInstructions\": \"Use this parent intent only for routing. Keep the runtime answer focused on the selected child intent and do not invent invoice operations outside the supported drilldown and credit memo aging flows.\"    }  ]"
            },
            {
              "id": "1776062683814",
              "name": "indexName",
              "value": "ppr-inquiry-v2.1755"
            }
          ],
          "type": "SET_FIELDS"
        },
