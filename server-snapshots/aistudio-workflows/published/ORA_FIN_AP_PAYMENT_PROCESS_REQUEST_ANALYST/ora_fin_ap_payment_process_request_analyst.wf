    \"errorType.meaning\",          \"errorStatus.meaning\",          \"statusReasonCode\",          \"statusReasonMessage\",          \"payablesPaymentFile.bankStatusCode\",          \"payablesPaymentFile.accountPaymentProfile.paymentProfileName\",          \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\",          \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmissionProtocolName\",          \"payablesPaymentFile.accountPaymentProfile.systemPaymentProfile.processingType.meaning\"        ]      },      \"sortableAttributes\": [        \"id\",        \"errorCode\",        \"errorDate\",        \"errorMessage\",        \"transactionType\",        \"statusReasonCode\",        \"statusReasonMessage\",        \"errorType.lookupCode\",        \"errorType.meaning\",        \"errorStatus.lookupCode\",        \"errorStatus.meaning\",        \"payablesPaymentFile.paymentInstructionId\",        \"payablesPaymentFile.bankStatusCode\",        \"payablesPaymentFile.errorCode\",        \"payablesPaymentFile.errorMessage\",        \"payablesPaymentFile.timeCreated\",        \"payablesPaymentFile.paymentRequestName\",        \"payablesPaymentFile.paymentFileProcessingStatus.lookupCode\",        \"payablesPaymentFile.paymentFileProcessingStatus.meaning\",        \"payablesPaymentFile.accountPaymentProfile.paymentProfileId\",        \"payablesPaymentFile.accountPaymentProfile.paymentProfileName\",        \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\",        \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmitProtocolCode\",        \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmissionProtocolName\",        \"payablesPaymentFile.accountPaymentProfile.systemPaymentProfile.systemProfileCode\",        \"payablesPaymentFile.accountPaymentProfile.systemPaymentProfile.processingType.lookupCode\",        \"payablesPaymentFile.accountPaymentProfile.systemPaymentProfile.processingType.meaning\"      ],      \"filterConditions\": [        {          \"name\": \"errorDate\",          \"attribute\": \"errorDate\",          \"type\": \"datetime\",          \"possibleValues\": [],          \"usage\": \"Use as the default date filter for recent payment-file exception queries. Because this is a datetime field in a BV filter, emit full ISO datetime literals such as `errorDate >= '2026-05-18T00:00:00Z'`; do not emit date-only literals such as `errorDate >= '2026-05-18'`.\"        },        {          \"name\": \"payablesPaymentFile.timeCreated\",          \"attribute\": \"payablesPaymentFile.timeCreated\",          \"type\": \"datetime\",          \"possibleValues\": [],          \"usage\": \"Use only when the user explicitly asks about payment file creation timing. Because this is a datetime field in a BV filter, emit full ISO datetime literals.\"        },        {          \"name\": \"transactionType\",          \"attribute\": \"transactionType\",          \"type\": \"enum\",          \"possibleValues\": [            \"PAYMENT_INSTRUCTION\"          ],          \"usage\": \"This resource is fixed to payment-instruction or payment-file-level errors.\"        },        {          \"name\": \"payablesPaymentFile.paymentRequestName\",          \"attribute\": \"payablesPaymentFile.paymentRequestName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes file-level failures to one payment process request.\"        },        {          \"name\": \"statusReasonCode\",          \"attribute\": \"statusReasonCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the seeded payment-instruction exception includes a status-reason code for the failure.\"        },        {          \"name\": \"payablesPaymentFile.paymentFileProcessingStatus.lookupCode\",          \"attribute\": \"payablesPaymentFile.paymentFileProcessingStatus.lookupCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"REJECTED\",            \"TRANSMISSION_FAILED\",            \"PENDING_ACK\",            \"PENDING_ACTION_ACK_FAILURE\",            \"TRANSMITTED_PENDING_ACK\",            \"FORMATTING_FAILED\",            \"CREATION_ERROR\",            \"RETRY_CREATION\",            \"TERMINATED\"          ],          \"usage\": \"Use when the user asks for rejected, transmission-failed, or pending-acknowledgement files.\"        },        {          \"name\": \"errorCode\",          \"attribute\": \"errorCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for one file-level error code or wants to group whole-batch failures by root cause.\"        },        {          \"name\": \"errorType.lookupCode\",          \"attribute\": \"errorType.lookupCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"VALIDATION\",            \"BANK\"          ],          \"usage\": \"Use when the user distinguishes file-generation validation issues from bank-return failures.\"        },        {          \"name\": \"payablesPaymentFile.accountPaymentProfile.systemPaymentProfile.processingType.lookupCode\",          \"attribute\": \"payablesPaymentFile.accountPaymentProfile.systemPaymentProfile.processingType.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user narrows to electronic versus printed processing flows or other system processing types.\"        }      ],      \"dateFilterGuidance\": {        \"description\": \"Use `errorDate` for recent file-level exceptions and `payablesPaymentFile.timeCreated` when the user explicitly asks about file creation timing. These are datetime fields, so BV filters must use full ISO datetime literals rather than date-only literals.\",        \"patterns\": [          {            \"userRequest\": \"recent payment file failures\",            \"clause\": \"errorDate>='<TODAY_MINUS_30_DAYS>T00:00:00Z' unless the user supplies a different date range\"          }        ]      },      \"extractionQuery\": null,      \"businessDrivers\": [        {          \"name\": \"fileLevelFailures\",          \"description\": \"Find failures affecting payment files rather than individual payments.\",          \"when\": \"User asks which payment files were rejected, failed transmission, or await acknowledgement.\",          \"fieldsToReturn\": [            \"errorCode\",            \"errorMessage\",            \"payablesPaymentFile.paymentInstructionId\",            \"payablesPaymentFile.paymentRequestName\",            \"payablesPaymentFile.paymentFileProcessingStatus.meaning\",            \"payablesPaymentFile.bankStatusCode\",            \"payablesPaymentFile.accountPaymentProfile.paymentProfileName\"          ],          \"extraFilterExpressions\": [            \"transactionType='PAYMENT_INSTRUCTION'\"          ],          \"notes\": \"\"        },        {          \"name\": \"wholeBatchRejectionComparison\",          \"description\": \"Find whole-file failures that should be contrasted with individual payment errors for the same PPR or date range.\",          \"when\": \"User asks which validation errors rejected entire payment files versus only individual payments.\",          \"fieldsToReturn\": [            \"errorCode\",            \"errorMessage\",            \"payablesPaymentFile.paymentInstructionId\",            \"payablesPaymentFile.paymentRequestName\",            \"payablesPaymentFile.paymentFileProcessingStatus.meaning\",            \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\",            \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmissionProtocolName\"          ],          \"extraFilterExpressions\": [            \"transactionType='PAYMENT_INSTRUCTION'\"          ],          \"notes\": \"Use this as the whole-file side of the comparison and pair it with disbursementPaymentExceptions to derive grouped counts.\"        },        {          \"name\": \"paymentConfirmationFailureRootCause\",          \"description\": \"Retrieve file-level exception details for a PPR whose payment confirmation did not complete.\",          \"when\": \"User asks why payment confirmation failed for a PPR or batch.\",          \"fieldsToReturn\": [            \"errorCode\",            \"errorMessage\",            \"payablesPaymentFile.paymentInstructionId\",            \"payablesPaymentFile.paymentRequestName\",            \"payablesPaymentFile.paymentFileProcessingStatus.meaning\",            \"payablesPaymentFile.bankStatusCode\",            \"payablesPaymentFile.accountPaymentProfile.paymentProfileName\",            \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\",            \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmissionProtocolName\"          ],          \"extraFilterExpressions\": [            \"paymentRequestName='<PPR_NAME_FROM_USER_WITH_LEADING_PPR_PREFIX_REMOVED>'\",            \"transactionType='PAYMENT_INSTRUCTION'\",            \"paymentFileProcessingStatusLookupCode in ('FORMATTED_ELECTRONIC','TRANSMITTED','PRINTED','TRANSMISSION_FAILED','PENDING_ACTION_ACK_FAILURE','PENDING_ACK')\"          ],          \"notes\": \"Use PayablesPaymentProcessRequestDetails first when the user needs the run-level paymentsConfirmed value. Keep row limiting outside filter predicates; use the supported FETCH row-limit form only in generated SQL.\"        }      ],      \"additionalInstructions\": [        \"Use this shape for file-level failures. For individual payment failures, switch to disbursementPaymentExceptions.\",        \"When the user asks for file-level versus payment-level comparison, filter this shape and disbursementPaymentExceptions to the same PPR scope, status, or date range, then compare grouped counts outside the base fetch.\",        \"For payment-confirmation failure diagnosis, use the PPR name to fetch the instruction exception, then explain how the file status, bank status, error code, transmission configuration, and protocol relate to the run-level confirmation state.\"      ]    },    \"unselectedPaymentInstallments\": {      \"key\": \"unselectedPaymentInstallments\",      \"name\": \"unselectedPaymentInstallments\",      \"type\": \"BV\",      \"shapeRole\": \"detail\",      \"module\": \"oraErpCorePayablesPayments\",      \"businessObject\": \"PayablesPaymentProcessRequestUnselectedInvoiceInstallment\",      \"api\": \"objects/ora/erpCore/payablesPayments/v1/unselectedPaymentInstallments\",      \"description\": \"Business view for line-level installments that met selection criteria but were excluded from a payment process request, including the exclusion reason, invoice and installment context, supplier, currency, and business unit.\",      \"exampleQuestions\": [        \"For Supplier X, which open invoices were not included in this PPR?\",        \"Show me all installments for Supplier ABC that were excluded from this PPR due to a payment hold.\",        \"Why was installment 1 of Invoice ABC not picked up in the current payment run?\",        \"Show unselected installments for this PPR grouped by exclusion reason.\",        \"What are the installments not selected for processing in PPR xyz?\",        \"Which installments due today for Supplier ABC were not selected in this run?\"      ],      \"fields\": {        \"fields\": [          \"checkrunId\",          \"invoiceId\",          \"installmentNumber\",          \"reason\"        ],        \"accessors\": {          \"originalInvoiceTransaction\": {            \"shape\": \"PayablesInvoiceTransaction\",            \"fields\": [              \"invoiceId\",              \"invoiceNumber\",              \"description\",              \"createdBy\",              \"invoiceAmount\",              \"invoiceTypeDiscriminator\"            ],            \"accessors\": {              \"supplier\": {                \"shape\": \"Supplier\",                \"fields\": [                  \"supplierId\",                  \"name\"                ]              },              \"invoiceCurrency\": {                \"shape\": \"Currency\",                \"fields\": [                  \"currencyCode\"                ]              },              \"businessUnit\": {                \"shape\": \"BusinessUnit\",                \"fields\": [                  \"id\",                  \"name\",                  \"effectiveStartDate\",                  \"effectiveEndDate\"                ]              }            }          },          \"invoiceInstallment\": {            \"shape\": \"PayablesInvoiceInstallment\",            \"fields\": [              \"invoiceId\",              \"installmentNumber\",              \"remitToSupplierName\",              \"dueDate\",              \"unpaidAmount\",              \"installmentAmount\"            ]          },          \"payablesPaymentProcessRequest\": {            \"shape\": \"PayablesPaymentProcessRequest\",            \"fields\": [              \"checkrunId\",              \"checkrunName\"            ]          }        },        \"fieldAlias\": {          \"PPR Id\": \"checkrunId\",          \"Invoice Id\": \"invoiceId\",          \"Installment Number\": \"installmentNumber\",          \"Reason\": \"reason\"        }      },      \"fieldSelection\": {        \"base\": [          \"checkrunId\",          \"invoiceId\",          \"installmentNumber\",          \"reason\"        ],        \"optional\": []      },      \"sortableAttributes\": [        \"checkrunId\",        \"invoiceId\",        \"installmentNumber\",        \"reason\"      ],      \"filterConditions\": [        {          \"name\": \"payablesPaymentProcessRequest.checkrunId\",          \"attribute\": \"payablesPaymentProcessRequest.checkrunId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user identifies the payment process request by id.\"        },        {          \"name\": \"payablesPaymentProcessRequest.checkrunName\",          \"attribute\": \"payablesPaymentProcessRequest.checkrunName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user identifies the payment process request by name.\"        },        {          \"name\": \"originalInvoiceTransaction.supplier.supplierId\",          \"attribute\": \"originalInvoiceTransaction.supplier.supplierId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters excluded installments to one supplier id.\"        },        {          \"name\": \"originalInvoiceTransaction.supplier.name\",          \"attribute\": \"originalInvoiceTransaction.supplier.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters excluded installments to one supplier name.\"        },        {          \"name\": \"reason\",          \"attribute\": \"reason\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for a specific exclusion reason such as a payment hold or missing setup. Do not use filters like 'payment hold' or %HOLD%\"        },        {          \"name\": \"originalInvoiceTransaction.businessUnit.name\",          \"attribute\": \"originalInvoiceTransaction.businessUnit.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters excluded installments to one business unit.\"        },        {          \"name\": \"originalInvoiceTransaction.invoiceNumber\",          \"attribute\": \"originalInvoiceTransaction.invoiceNumber\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user identifies the excluded installment by invoice number.\"        },        {          \"name\": \"invoiceInstallment.dueDate\",          \"attribute\": \"invoiceInstallment.dueDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for excluded installments due today or due within a date window.\"        },        {          \"name\": \"invoiceInstallment.unpaidAmount\",          \"attribute\": \"invoiceInstallment.unpaidAmount\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for excluded installments above an unpaid-amount threshold.\"        }      ],      \"dateFilterGuidance\": null,      \"extractionQuery\": null,      \"businessDrivers\": [        {          \"name\": \"unselectedByPpr\",          \"description\": \"Unselected installments for a specific PPR/checkrun.\",          \"when\": \"User asks to show unselected installments for a given PPR or checkrun.\",          \"fieldsToReturn\": [],          \"extraFilterExpressions\": [            \"checkrunId=<PPR_ID_FROM_USER> or checkrunName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"\"        },        {          \"name\": \"unselectedByPprAndSupplier\",          \"description\": \"Unselected installments for a specific supplier under a PPR.\",          \"when\": \"User asks to show unselected installments for supplier X under PPR Y.\",          \"fieldsToReturn\": [],          \"extraFilterExpressions\": [            \"(checkrunId=<PPR_ID_FROM_USER> or checkrunName='<PPR_NAME_FROM_USER>')\",            \"(originalInvoiceTransaction.supplier.supplierId=<SUPPLIER_ID_FROM_USER> or originalInvoiceTransaction.supplier.name='<SUPPLIER_NAME_FROM_USER>')\"          ],          \"notes\": \"\"        },        {          \"name\": \"unselectedByReason\",          \"description\": \"Unselected installments filtered by a particular reason or error code.\",          \"when\": \"User asks for unselected installments due to a specific reason such as a payment hold or validation issue.\",          \"fieldsToReturn\": [],          \"extraFilterExpressions\": [            \"reason='<REASON_FROM_USER>'\"          ],          \"notes\": \"\"        },        {          \"name\": \"unselectedDueNow\",          \"description\": \"Unselected installments that are due immediately or within a short date window.\",          \"when\": \"User asks which due-today or due-soon installments were not picked up in a run.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"originalInvoiceTransaction.invoiceNumber\",            \"invoiceInstallment.installmentNumber\",            \"invoiceInstallment.dueDate\",            \"invoiceInstallment.unpaidAmount\",            \"reason\"          ],          \"extraFilterExpressions\": [            \"invoiceInstallment.dueDate=<REQUESTED_DATE_OR_WINDOW>\"          ],          \"notes\": \"Combine with the PPR predicate when the user asks about a specific run.\"        },        {          \"name\": \"paymentOnHold\",          \"description\": \"Unselected installments that are due immediately or within a short date window.\",          \"when\": \"User asks installments in PPR that are in hold payment hold\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"originalInvoiceTransaction.invoiceNumber\",            \"invoiceInstallment.installmentNumber\",            \"invoiceInstallment.dueDate\",            \"invoiceInstallment.unpaidAmount\",            \"reason\"          ],          \"extraFilterExpressions\": [            \"(reason ='SCHEDULED_PAYMENT_HOLD' or reason = 'SUPPLIER_SITE_HOLD') \"          ],          \"notes\": \"Combine with the other filters if required. Do not use filters like 'payment hold' or %HOLD%.  Do not use AND operator\"        }      ],      \"additionalInstructions\": [        \"Use this shape when the user asks why an invoice or installment was not picked in the current run.\",        \"When the user asks for upcoming or alternative scheduling, combine this with payment-run criteria or schedule-oriented shapes instead of inventing schedule fields here.\",        \"This shape does not expose discount-expiration or discount-amount-remaining fields. For discount-eligibility analysis, pair it with invoiceInstallmentDetails.\",        \"If user mentioned Payment hold in their query, ensure the paymentOnHold driver filters are applied eg: Show me all installments for Supplier <Supplier name> that were excluded from PPR <PPR Name> due to a payment hold\"      ],      \"fieldSelectionRuleUsage\": {        \"match\": \"Choose the closest questionExamples entry for the user request.\",        \"fields\": \"Use the matching fields value exactly and preserve order.\",        \"paraphrases\": \"Use the same fields for paraphrased or equivalent requests.\",        \"addFieldsOnlyWhen\": \"The user explicitly asks for more displayed columns, or the field is required for filter, sort, group, key, or deeplink handling.\"      },      \"fieldSelectionRules\": [        {          \"questionExamples\": [            \"For Supplier Advanced Network Devices, which of their open invoices were not included in PPR gapr_ppr_test_4?\"          ],          \"queryType\": \"BV\",          \"fields\": \"payablesPaymentProcessRequest.checkrunName,originalInvoiceTransaction.supplier.name,originalInvoiceTransaction.invoiceNumber,invoiceInstallment.installmentNumber,invoiceInstallment.dueDate,invoiceInstallment.unpaidAmount,originalInvoiceTransaction.invoiceCurrency.currencyCode,reason,checkrunId\",          \"fieldOrderLocked\": true        },        {        