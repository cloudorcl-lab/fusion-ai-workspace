\n    var paymentProcessType = getFirstValue(\n      rawRow,\n      outRow,\n      paymentProcessTypeCandidates\n    );\n    var shouldUsePprDeeplink = !codesEqual(paymentProcessType, \"IMMEDIATE\");\n\n    for (var pc = 0; pc < pprNameColumns.length; pc++) {\n      var pprColumn = findActualKey(outRow, pprNameColumns[pc]);\n      if (pprColumn === null) continue;\n\n      if (shouldUsePprDeeplink) {\n        outRow[pprColumn] = buildPprViewDeeplink(rawRow, outRow, outRow[pprColumn]);\n      }\n    }\n\n    var rowRequestStatusCode = getFirstValue(\n      rawRow,\n      outRow,\n      requestStatusCodeCandidates\n    );\n    var paymentFileReference = getFirstValue(\n      rawRow,\n      outRow,\n      paymentFileReferenceCandidates\n    );\n    var pprStatusCode = getFirstValue(rawRow, outRow, pprStatusCodeCandidates);\n    var shouldUseActionDeeplink =\n      codesEqual(rowRequestStatusCode, \"REQUIRING_ATTENTION\") &&\n      !hasValue(paymentFileReference) &&\n      !isPaymentsCreatedStatus(pprStatusCode);\n\n    var actionStatusColumn = findStatusColumn(outRow);\n    if (shouldUseActionDeeplink && actionStatusColumn !== null) {\n      outRow[actionStatusColumn] = buildPprActionDeeplink(\n        rawRow,\n        outRow,\n        outRow[actionStatusColumn]\n      );\n    }\n\n    if (shouldShowFileRequiringAttentionColumn) {\n      var paymentFileDeeplink = buildPaymentFileDeeplink(rawRow, outRow);\n\n      if (hasValue(paymentFileDeeplink)) {\n        outRow[fileRequiringAttentionColumn] = paymentFileDeeplink;\n        didBuildPaymentFileDeeplink = true;\n      } else {\n        outRow[fileRequiringAttentionColumn] = \"\";\n      }\n    }\n  }\n\n  if (shouldShowFileRequiringAttentionColumn) {\n    var paymentFileAnchor = findAnchorPaymentFileStatusColumn(columnOrder);\n    addColumnAfter(\n      columnOrder,\n      paymentFileAnchor || \"Payment File Status\",\n      fileRequiringAttentionColumn\n    );\n  }\n\n  if (didBuildPaymentFileDeeplink) {\n    removeCo