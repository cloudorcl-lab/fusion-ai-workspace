\": \"invoiceBatch.batchName\",          \"attribute\": \"invoiceBatch.batchName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by invoice batch name.\"        },        {          \"name\": \"documentRejectionLookup.lookupCode\",          \"attribute\": \"documentRejectionLookup.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [            \"DOCUMENT\",            \"NONE\",            \"PAYEE\",            \"REQUEST\"          ],          \"usage\": \"Use when the user asks about document-rejection criteria configured on the run. These values come from the source-controlled IBY_DOCUMENT_REJECTION_LEVELS lookup snapshot.\"        }      ],      \"dateFilterGuidance\": null,      \"extractionQuery\": null,      \"businessDrivers\": [        {          \"name\": \"criteriaByPpr\",          \"description\": \"Detailed payment run criteria for a specific payment process request.\",          \"when\": \"User asks for the configuration or policy details of one named or identified payment process request.\",          \"fieldsToReturn\": [            \"checkrunId\",            \"checkrunName\",            \"payFromDate\",            \"payThroughDate\",            \"hiPaymentPriority\",            \"lowPaymentPriority\",            \"payOnlyWhenDueFlag\",            \"paymentMethod.paymentMethodName\",            \"paymentProcessRequestStatus.meaning\"          ],          \"extraFilterExpressions\": [            \"checkrunId=<PPR_ID_FROM_USER> or checkrunName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"\"        },        {          \"name\": \"priorityAndDuePolicyAudit\",          \"description\": \"Audit the payment date window and priority policy used by a payment run.\",          \"when\": \"User asks about payment date, pay-from or pay-through windows, or priority thresholds for a run.\",          \"fieldsToReturn\": [            \"checkrunName\",            \"payFromDate\",            \"payThroughDate\",            \"hiPaymentPriority\",            \"lowPaymentPriority\",            \"payOnlyWhenDueFlag\",            \"zeroAmountInvoicesAllowed\"          ],          \"extraFilterExpressions\": [            \"checkrunId=<PPR_ID_FROM_USER> or checkrunName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"\"        },        {          \"name\": \"groupingAndSourceCriteriaAudit\",          \"description\": \"Review how a payment run groups or restricts invoices by pay group, currency, legal entity, business unit, and source.\",          \"when\": \"User asks how a payment run was configured to group or select invoices.\",          \"fieldsToReturn\": [            \"checkrunName\",            \"payGroupOption\",            \"currencyGroupOption\",            \"legalEntityGroupOptions\",            \"businessUnitGroupOption\",            \"invoiceSourceGroupOption\",            \"vendorTypeLookupCode\",            \"party.name\",            \"invoiceBatch.batchName\"          ],          \"extraFilterExpressions\": [            \"checkrunId=<PPR_ID_FROM_USER> or checkrunName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Use party and invoice batch only when the user asks for payee or invoice-batch context.\"        },        {          \"name\": \"discountAndConversionPolicyAudit\",          \"description\": \"Inspect dynamic discount, document rejection, and invoice conversion-rate criteria for a payment run.\",          \"when\": \"User asks about accelerated invoices, invoice conversion rates, or document rejection behavior. Includes document rejection level questions for a named PPR. Includes document rejection level questions for a named PPR.\",          \"fieldsToReturn\": [            \"checkrunName\",            \"acceleratedInvoicesLookup.lookupCode\",            \"acceleratedInvoicesLookup.meaning\",            \"invoiceConversionRateTypeLookup.lookupCode\",            \"invoiceConversionRateTypeLookup.meaning\",            \"documentRejectionLookup.lookupCode\",            \"documentRejectionLookup.meaning\",            \"paymentMethod.paymentMethodName\"          ],          \"extraFilterExpressions\": [            \"checkrunId=<PPR_ID_FROM_USER> or checkrunName='<PPR_NAME_FROM_USER>'\",            \"sortBy: checkrunId:asc\",            \"limit: 20\"          ],          \"notes\": \"For document rejection level, return documentRejectionLookup.meaning filtered by checkrunName/checkrunId, sorted by checkrunId asc with limit 20.\"        },        {          \"name\": \"fileCreationWaitAnalysis\",          \"description\": \"Identify why payment process requests are still waiting for payment file creation, especially when the run is approved or already in payments-created status but file creation has not been triggered.\",          \"when\": \"User asks why one or more payment process requests are waiting for file creation, or why approved PPRs have not moved into file generation.\",          \"fieldsToReturn\": [            \"checkrunId\",            \"checkrunName\",            \"paymentProcessRequestStatus.lookupCode\",            \"paymentProcessRequestStatus.meaning\",            \"createPaymentInstructionFlag\",            \"paymentMethod.paymentMethodName\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestStatus.lookupCode in ('ORA_APPROVED','PAYMENTS_CREATED')\",            \"createPaymentInstructionFlag = false\"          ],          \"notes\": \"Use this driver when the user is investigating a file-creation hold condition on payment process requests.\"        }      ],      \"additionalInstructions\": [        \"Use checkrunId or checkrunName to identify a specific payment process request; these are the primary identifiers exposed by this BV resource.\",        \"Use nested accessor paths such as paymentProcessRequestStatus.lookupCode, paymentMethod.paymentMethodName, party.name, and invoiceBatch.batchName when the user asks for readable status, method, payee, or batch context.\",        \"Treat payGroupOption, currencyGroupOption, legalEntityGroupOptions, businessUnitGroupOption, and invoiceSourceGroupOption as configuration criteria for the run, not as transactional invoice attributes.\",        \"When the user asks whether dynamic discount or accelerated invoices are enabled, use acceleratedInvoicesLookup.lookupCode or acceleratedInvoicesLookup.meaning rather than inferring from unrelated installment shapes.\",        \"When the user asks about validation or rejection policy for document payables in the run, use documentRejectionLookup.lookupCode or documentRejectionLookup.meaning. The available configured values are DOCUMENT, NONE, PAYEE, and REQUEST from IBY_DOCUMENT_REJECTION_LEVELS.\",        \"The live OpenAPI description mentions broader payment setup context, but retrieval for this shape must stay within the top-level fields and accessor paths explicitly exposed here.\",        \"When constructing the filter for checking null cases use =null. or != null . Do not use IS NOT NULL \",        \"Treat business-driver filters as the required semantic core, not a closed-form query. When the user adds explicit constraints such as date or date range, PPR name/id, supplier, business unit, currency, amount, status, payment method, bank account, or payment file, add those filters when the selected shape exposes the field. A user-provided date filter overrides the default recency window. Do not drop required status, null-rate, source-shape, or sorting rules unless the user explicitly asks for a different lifecycle/source and the selected shape supports it.\",        \"Document rejection level questions are supported by paymentRunCriteria/paymentRunCriteriaExtraction. Do not return unsupported when the user asks what document rejection level is set for a named PPR.\",        \"If a requested filter, grouping, or output field is not exposed by the selected shape, do not invent a field or silently drop the constraint. Choose another supported shape that exposes it, or state the limitation while returning the closest supported query context.\"      ],      \"fieldSelectionRuleUsage\": {        \"match\": \"Choose the closest questionExamples entry for the user request.\",        \"fields\": \"Use the matching fields value exactly and preserve order.\",        \"paraphrases\": \"Use the same fields for paraphrased or equivalent requests.\",        \"addFieldsOnlyWhen\": \"The user explicitly asks for more displayed columns, or the field is required for filter, sort, group, key, or deeplink handling.\"      },      \"fieldSelectionRules\": [        {          \"questionExamples\": [            \"What's the document rejection level set to for PPR gapr_ppr_test_4\"          ],          \"queryType\": \"BV\",          \"fields\": \"documentRejectionLookup.meaning\",          \"fieldOrderLocked\": true,          \"shape\": \"paymentRunCriteria\",          \"filters\": \"checkrunName = '<PPR_NAME_FROM_USER>'\",          \"sortBy\": \"checkrunId:asc\",          \"limit\": 20,          \"notes\": \"Exact document rejection level query. Return only documentRejectionLookup.meaning unless the user asks for the code; filter by checkrunName, sort checkrunId asc, limit 20. This is supported.\"        }      ]    },    \"paymentRunCriteriaExtraction\": {      \"key\": \"paymentRunCriteriaExtraction\",      \"name\": \"paymentRunCriteriaExtraction\",      \"type\": \"EXTRACTION\",      \"module\": \"oraErpCorePayablesPayments\",      \"businessObject\": \"PayablesPaymentProcessRequest\",      \"description\": \"Runtime extraction wrapper for the paymentRunCriteria BV. Use this BV shape primarily for summary queries about how payment runs are configured, such as grouped counts by payment method, due-date window, priority range, pay-only-when-due policy, payment-file creation controls, dynamic-discount policy, invoice conversion-rate policy, or document-rejection rule. Use it to compare configuration patterns across PPRs before inspecting one run in detail.\",      \"exampleQuestions\": [        \"Show payment run criteria for payment process request zBIA_Payment\",        \"What pay-from date, pay-through date, and priority range are configured for PPR zBIA_Payment\",        \"Which payment process requests are configured to pay only when due\",        \"List payment runs using payment method EFT with dynamic discount invoices enabled\",        \"Show payment run criteria for payee Vision Operations and invoice batch APR_2026_01\",        \"Show document rejection rule and invoice conversion rate type for PPR zBIA_Payment\",        \"Why are these PPRs waiting for file creation\"      ],      \"fields\": {        \"fields\": [          \"checkrunId\",          \"checkrunName\",          \"payThroughDate\",          \"payFromDate\",          \"hiPaymentPriority\",          \"lowPaymentPriority\",          \"payOnlyWhenDueFlag\",          \"createPaymentInstructionFlag\",          \"vendorTypeLookupCode\",          \"zeroAmountInvoicesAllowed\",          \"payGroupOption\",          \"currencyGroupOption\",          \"legalEntityGroupOptions\",          \"businessUnitGroupOption\",          \"invoiceSourceGroupOption\",          \"paymentProcessRequestStatusLookupCode\",          \"paymentProcessRequestStatusMeaning\",          \"paymentMethodName\",          \"paymentMethodCode\",          \"acceleratedInvoicesLookupMeaning\",          \"acceleratedInvoicesLookupLookupCode\",          \"invoiceConversionRateTypeLookupMeaning\",          \"invoiceConversionRateTypeLookupLookupCode\",          \"partyName\",          \"batchName\",          \"documentRejectionLookupMeaning\",          \"documentRejectionLookupLookupCode\",          \"partyId\",          \"batchId\"        ],        \"fieldAlias\": {          \"PPR Id\": \"checkrunId\",          \"PPR Name\": \"checkrunName\",          \"Pay From Date\": \"payFromDate\", 