erarchy.supplierName\",          \"attribute\": \"supplierHierarchy.supplierName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for supplier-level totals or discount analysis.\"        },        {          \"name\": \"paymentCurrencyHierarchy.currencyCode\",          \"attribute\": \"paymentCurrencyHierarchy.currencyCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user wants the invoice-payment breakdown by currency.\"        },        {          \"name\": \"businessUnitHierarchy.businessUnitName\",          \"attribute\": \"businessUnitHierarchy.businessUnitName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes invoice-payment totals to a business unit.\"        },        {          \"name\": \"paymentMethodHierarchy.paymentMethodCode\",          \"attribute\": \"paymentMethodHierarchy.paymentMethodCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user groups or filters invoice-payment activity by payment method.\"        },        {          \"name\": \"payablesPaymentStatusHierarchy.payablesPaymentStatusCode\",          \"attribute\": \"payablesPaymentStatusHierarchy.payablesPaymentStatusCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for invoice-payment totals split by payment stage or payment status.\"        },        {          \"name\": \"dynamicDiscountingEnrolledHierarchy.yesNoIndicatorCode\",          \"attribute\": \"dynamicDiscountingEnrolledHierarchy.yesNoIndicatorCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"Y\",            \"N\"          ],          \"usage\": \"Use when the user asks specifically about dynamic-discounting-enrolled invoice-payment activity.\"        }      ],      \"dateFilterGuidance\": {        \"description\": \"Use `paymentDateHierarchy.calendarDate` for actual payment timing and `dueDateHierarchy.calendarDate` for scheduled-payment or urgency analysis.\",        \"patterns\": [          {            \"userRequest\": \"paid today, yesterday, or during a range\",            \"clause\": \"apply the date window to paymentDateHierarchy.calendarDate\"          },          {            \"userRequest\": \"due this week, due in 48 hours, or overdue\",            \"clause\": \"apply the date window to dueDateHierarchy.calendarDate\"          }        ]      },      \"extractionQuery\": null,      \"businessDrivers\": [        {          \"name\": \"discountAndTaxRollup\",          \"description\": \"Summarize payment, discount, and installment counts across invoice-payment activity.\",          \"when\": \"User asks for batch-level invoice-payment summaries, especially around discounts and timing.\",          \"fieldsToReturn\": [            \"paidAmount\",            \"discountTakenAmount\",            \"discountLostAmount\",            \"invoiceCount\",            \"installmentCount\"          ],          \"extraFilterExpressions\": [],          \"notes\": \"\"        },        {          \"name\": \"earlyDiscountCaptureAnalysis\",          \"description\": \"Summarize captured and lost discounts across invoice-payment activity.\",          \"when\": \"User asks how much early payment discount was captured, lost, or available in a payment run or recent time window.\",          \"fieldsToReturn\": [            \"discountTakenAmount\",            \"discountLostAmount\",            \"invoiceCount\",            \"installmentCount\",            \"paymentDateHierarchy\",            \"supplierHierarchy\"          ],          \"extraFilterExpressions\": [],          \"notes\": \"When the user names a specific PPR or payment number, identify the matching row slice with payablesInvoicePaymentDetails first and then summarize externally.\"        },        {          \"name\": \"invoiceSettlementBreakdown\",          \"description\": \"Summarize settled invoice activity by supplier, currency, payment method, or due-date urgency.\",          \"when\": \"User asks which invoices were settled, or wants invoice-payment totals by supplier, currency, payment method, or due date.\",          \"fieldsToReturn\": [            \"paidAmount\",            \"invoiceCount\",            \"installmentCount\",            \"supplierHierarchy\",            \"paymentCurrencyHierarchy\",            \"paymentMethodHierarchy\",            \"dueDateHierarchy\"          ],          \"extraFilterExpressions\": [],          \"notes\": \"\"        },        {          \"name\": \"supplierShareInFilteredSlice\",          \"description\": \"Summarize the supplier concentration of a filtered invoice-payment slice such as a resolved batch or recent run.\",          \"when\": \"User asks for the top suppliers by paid value in a batch or wants to understand supplier concentration in a payment slice.\",          \"fieldsToReturn\": [            \"paidAmount\",            \"invoiceCount\",            \"installmentCount\",            \"supplierHierarchy\",            \"paymentCurrencyHierarchy\",            \"paymentDateHierarchy\"          ],          \"extraFilterExpressions\": [],          \"notes\": \"Resolve the batch or PPR slice with selectedPaymentInstallments, paymentRunInstallments, or payablesPaymentDetails first, then aggregate the filtered set externally and compute percentages.\"        }      ],      \"additionalInstructions\": [        \"Use this summary shape for grouped invoice-payment analytics. The OpenAPI contract exposes hierarchy objects, so group and filter using hierarchy attributes such as `supplierHierarchy.supplierName`, `paymentCurrencyHierarchy.currencyCode`, `paymentDateHierarchy.calendarDate`, and `dueDateHierarchy.calendarDate`.\",        \"This AV does not expose direct payment-number or PPR-name attributes. When the user gives a payment number or payment process request, resolve the matching invoice-payment rows with payablesInvoicePaymentDetails first, then aggregate the filtered set.\",        \"For top-supplier or concentration questions in a named batch, resolve the batch slice first with selectedPaymentInstallments or paymentRunInstallments; this AV is the grouped-summary layer, not the batch-identification layer.\",        \"Drill into payablesInvoicePaymentDetails when the user asks which invoices or installments were settled by a specific payment.\"      ]    },    \"payablesInvoicePaymentDetails\": {      \"key\": \"payablesInvoicePaymentDetails\",      \"name\": \"payablesInvoicePaymentDetails\",      \"type\": \"BV\",      \"shapeRole\": \"detail\",      \"module\": \"oraErpCorePayablesPayments\",      \"businessObject\": \"PayablesInvoicePayment\",      \"api\": \"objects/ora/erpCore/payablesPayments/v1/payablesInvoicePaymentDetails\",      \"description\": \"Business view for invoice-payment detail rows that connect a payment to the invoices and installments it settled, including paid amount, discounts, reversal state, currencies, exchange rates, payment number, payment date, supplier, PPR, and invoice context.\",      \"exampleQuestions\": [        \"Which specific invoices were settled by Payment 12345?\",        \"Show all invoices that were paid by Payment 789.\",        \"Give me a summary of all invoices covered by Payment 12345 for the supplier AR team.\",        \"What was the discount amount taken on the payment for Invoice INV-1001?\",        \"What is the payment date for installment 2 of Invoice INV-1001?\",        \"What exchange rate was used for the USD payment of this EUR invoice installment?\",        \"How many installments of Invoice INV-1001 have already been paid?\",        \"Show the breakdown of taxes and discounts for invoices in PPR PPR_123.\"      ],      \"fields\": {        \"fields\": [          \"invoicePaymentId\",          \"amount\",          \"amountPaidInInvoiceCurrency\",          \"discountLost\",          \"discountLostInvoiceCurrency\",          \"discountTaken\",          \"discountTakenInvoiceCurrency\",          \"paidAmountInvoiceExchangeRate\",          \"paidAmountPaymentExchangeRate\",          \"accountingDate\",          \"annualPercentageRate\",          \"daysAccelerated\",          \"conversionDate\",          \"conversionRate\",          \"reversalFlag\",          \"crossCurrencyConversionRate\"        ],        \"accessors\": {          \"invoiceCurrency\": {            \"shape\": \"Currency\",            \"fields\": [              \"currencyCode\",              \"name\"            ]          },          \"paymentCurrency\": {            \"shape\": \"Currency\",            \"fields\": [              \"currencyCode\",              \"name\"            ]          },          \"paymentType\": {            \"shape\": \"Lookup\",            \"fields\": [              \"lookupCode\",              \"lookupType\",              \"meaning\"            ]          },          \"payment\": {            \"shape\": \"PayablesPayment\",            \"fields\": [              \"paymentId\",              \"paymentAmount\",              \"paymentBaseAmount\",              \"paymentNumber\",              \"paymentDate\",              \"futurePayDueDate\",              \"clearingDate\",              \"bankAccountName\",              \"bankAccountNumber\",              \"remitToAddressName\"            ],            \"accessors\": {              \"paymentMethod\": {                \"shape\": \"PaymentMethod\",                \"fields\": [                  \"code\",                  \"paymentMethodName\"                ]              },              \"paymentStatus\": {                \"shape\": \"Lookup\",                \"fields\": [                  \"lookupType\",                  \"lookupCode\",                  \"meaning\"                ]              },              \"paymentProcessRequest\": {                \"shape\": \"PayablesPaymentProcessRequest\",                \"fields\": [                  \"checkrunId\",                  \"checkrunName\"                ],                \"accessors\": {                  \"businessUnit\": {                    \"shape\": \"BusinessUnit\",                    \"fields\": [                      \"id\"                    ]                  }                }              },              \"supplier\": {                \"shape\": \"Supplier\",                \"fields\": [                  \"supplierId\",                  \"supplierNumber\",                  \"name\",                  \"supplierStatus\"                ],                \"accessors\": {                  \"supplierType\": {                    \"shape\": \"Lookup\",                    \"fields\": [                      \"lookupCode\",                      \"lookupType\"                    ]                  }                }              },              \"supplierSite\": {                \"shape\": \"SupplierSite\",                \"fields\": [                  \"id\",                  \"name\"                ]              }            }          },          \"invoiceInstallment\": {            \"shape\": \"PayablesInvoiceInstallment\",            \"fields\": [              \"invoiceId\",              \"installmentNumber\",              \"dueDate\"            ],            \"accessors\": {              \"invoiceTransaction\": {                \"shape\": \"PayablesInvoiceTransaction\",                \"fields\": [                  \"invoiceId\",                  \"invoiceNumber\",                  \"description\",                  \"invoiceAmount\",                  \"invoiceDate\",                  \"amountPaid\",                  \"baseAmount\",                  \"cancelledDate\"                ],                \"accessors\": {                  \"paymentTerm\": {                    \"shape\": \"PaymentTerm\",                    \"fields\": [                      \"termId\",                      \"paymentTerm\"                    ]                  },                  \"validationStatus\": {                    \"shape\": \"Lookup\",                    \"fields\": [                      \"lookupCode\",                      \"meaning\",                      \"lookupType\"                    ]                  },                  \"paymentStatusCode\": {                    \"shape\": \"Lookup\",                    \"fields\": [                      \"lookupCode\",                      \"meaning\",                      \"lookupType\"                    ]                  },                  \"paymentCurrency\": {                    \"shape\": \"Currency\",                    \"fields\": [                      \"currencyCode\"                    ]                  }                }              }            }          },          \"businessUnit\": {            \"shape\": \"BusinessUnit\",            \"fields\": [              \"id\",              \"effectiveStartDate\",              \"effectiveEndDate\",              \"name\"            ]          },          \"ledger\": {            \"shape\": \"Ledger\",            \"fields\": [              \"ledgerId\",              \"name\"            ],            \"accessors\": {              \"currency\": {                \"shape\": \"Currency\",                \"fields\": [                  \"currencyCode\"                ]              }            }          },          \"remitToSupplier\": {            \"shape\": \"Supplier\",            \"fields\": [              \"supplierId\",              \"supplierNumber\",              \"name\",              \"taxOrganizationType\",              \"supplierStatus\"            ],            \"accessors\": {              \"supplierType\": {                \"shape\": \"Lookup\",                \"fields\": [                  \"lookupCode\",                  \"lookupType\"                ]              }            }          },          \"externalBankAccount\": {            \"shape\": \"ExternalBankAccount\",            \"fields\": [              \"id\",              \"maskedAccountNumber\"            ]          },          \"conversionRateType\": {            \"shape\": \"ConversionRateType\",            \"fields\": [              \"conversionRateType\",              \"conversionRateTypeName\"            ]          }        },        \"fieldAlias\": {          \"Invoice Payment ID\": \"invoicePaymentId\",          \"Paid Amount\": \"amount\",          \"Amount Paid In Invoice Currency\": \"amountPaidInInvoiceCurrency\",          \"Discount Lost\": \"discountLost\",          \"Discount Lost In Invoice Currency\": \"discountLostInvoiceCurrency\",          \"Discount Taken\": \"discountTaken\",          \"Discount Taken In Invoice Currency\": \"discountTakenInvoiceCurrency\",          \"Paid Amount Invoice Exchange Rate\": \"paidAmountInvoiceExchangeRate\",          \"Paid Amount Payment Exchange Rate\": \"paidAmountPaymentExchangeRate\",          \"Accounting Date\": \"accountingDate\",          \"Annual Percentage Rate\": \"annualPercentageRate\",          \"Days Accelerated\": \"daysAccelerated\",          \"Conversion Date\": \"conversionDate\",          \"Conversion Rate\": \"conversionRate\",          \"Reversal Flag\": \"reversalFlag\",          \"Cross Currency Conversion Rate\": \"crossCurrencyConversionRate\",          \"Payment ID\": \"payment.paymentId\",          \"Payment Number\": \"payment.paymentNumber\",          \"Payment Date\": \"payment.paymentDate\",          \"Payment Amount\": \"payment.paymentAmount\",          \"Payment Status\": \"payment.paymentStatus.meaning\",          \"Payment Status Code\": \"payment.paymentStatus.lookupCode\",          \"Payment Method\": \"payment.paymentMethod.paymentMethodName\",          \"Payment Method Code\": \"payment.paymentMethod.code\",          \"PPR ID\": \"payment.paymentProcessRequest.checkrunId\",          \"PPR Name\": \"payment.paymentProcessRequest.checkrunName\",          \"Supplier\": \"payment.supplier.name\",          \"Supplier Number\": \"payment.supplier.supplierNumber\",          \"Supplier Site\": \"payment.supplierSite.name\",          \"Invoice ID\": \"invoiceInstallment.invoiceId\",          \"Invoice Number\": \"invoiceInstallment.invoiceTransaction.invoiceNumber\",          \"Installment Number\": \"invoiceInstallment.installmentNumber\",          \"Installment Due Date\": \"invoiceInstallment.dueDate\",          \"Invoice Amount\": \"invoiceInstallment.invoiceTransaction.invoiceAmount\",          \"Invoice Date\": \"invoiceInstallment.invoiceTransaction.invoiceDate\",          \"Invoice Description\": \"invoiceInstallment.invoiceTransaction.description\",          \"Invoice Currency\": \"invoiceCurrency.currencyCode\",          \"Payment Currency\": \"paymentCurrency.currencyCode\",          \"Business Unit\": \"businessUnit.name\",          \"Ledger\": \"ledger.name\",          \"Ledger Currency\": \"ledger.currency.currencyCode\",          \"Remit-to Supplier\": \"remitToSupplier.name\"        }      },      \"fieldSelection\": {        \"base\": [          \"invoicePaymentId\",          \"amount\",          \"amountPaidInInvoiceCurrency\",          \"discountTaken\",          \"reversalFlag\"        ],        \"optional\": [          \"discountLost\",          \"discountLostInvoiceCurrency\",          \"discountTakenInvoiceCurrency\",          \"paidAmountInvoiceExchangeRate\",          \"paidAmountPaymentExchangeRate\",          \"accountingDate\",          \"annualPercentageRate\",          \"daysAccelerated\",          \"conversionDate\",          \"conversionRate\",          \"crossCurrencyConversionRate\"        ]      },      \"sortableAttributes\": [        \"invoicePaymentId\",        \"amount\",        \"amountPaidInInvoiceCurrency\",        \"discountTaken\",        \"discountLost\",        \"accountingDate\",        \"conversionDate\",        \"conversionRate\",        \"reversalFlag\"      ],      \"filterConditions\": [        {          \"name\": \"invoicePaymentId\",          \"attribute\": \"invoicePaymentId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the invoice-payment detail row id is known.\"        },        {          \"name\": \"payment.paymentId\",          \"attribute\": \"payment.paymentId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user identifies the payment by internal payment id.\"        },        {          \"name\": \"payment.paymentNumber\",          \"attribute\": \"payment.paymentNumber\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks which invoices were settled by a payment/check number.\"        },        {          \"name\": \"payment.paymentProcessRequest.checkrunName\",          \"attribute\": \"payment.paymentProcessRequest.checkrunName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes invoice-payment details to a PPR or payment batch name.\"        },        {          \"name\": \"invoiceInstallment.invoiceTransaction.invoiceNumber\",          \"attribute\": \"invoiceInstallment.invoiceTransaction.invoiceNumber\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for the payment that settled an invoice.\"        },        {          \"name\": \"invoiceInstallment.installmentNumber\",          \"attribute\": \"invoiceInstallment.installmentNumber\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use with invoice number when the user identifies a specific invoice installment.\"        },        {          \"name\": \"reversalFlag\",          \"attribute\": \"reversalFlag\",          \"type\": \"string\",          \"possibleValues\": [            \"Y\",            \"N\"          ],          \"usage\": \"Use reversalFlag!='Y' or reversalFlag=null to exclude reversed invoice-payment rows.\"        },        {          \"name\": \"invoiceCurrency.currencyCode\",          \"attribute\": \"invoiceCurrency.currencyCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user specifies the invoice currency.\"        },        {          \"name\": \"paymentCurrency.currencyCode\",          \"attribute\": \"paymentCurrency.currencyCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user specifies the payment currency or asks for cross-currency settlement.\"        },        {          \"name\": \"payment.paymentDate\",          \"attribute\": \"payment.paymentDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use for actual payment date filters.\"        },        {          \"name\": \"payment.supplier.name\",          \"attribute\": \"payment.supplier.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters settled invoice-payment rows by supplier.\"        }      ],      \"dateFilterGuidance\": {        \"description\": \"Use `payment.paymentDate` for actual payment timing and `invoiceInstallment.dueDate` when the user asks about due-date context for the settled installment.\",        \"patterns\": [          {            \"userRequest\": \"paid today, yesterday, or during a range\",            \"clause\": \"apply the date window to payment.paymentDate\"          }        ]      },      \"extractionQuery\": null,      \"businessDrivers\": [        {          \"name\": \"invoicesSettledByPayment\",          \"description\": \"List the invoice and installment rows settled by a specific payment.\",          \"when\": \"User asks which invoices were settled, covered, or paid by a payment number or payment id.\",          \"fieldsToReturn\": [            \"payment.paymentNumber\",            \"payment.paymentId\",            \"payment.paymentDate\",            \"invoiceInstallment.invoiceTransaction.invoiceNumber\",            \"invoiceInstallment.installmentNumber\",            \"amount\",            \"amountPaidInInvoiceCurrency\",            \"discountTaken\",            \"invoiceCurrency.currencyCode\",            \"paymentCurrency.currencyCode\"          ],          \"extraFilterExpressions\": [            \"payment.paymentNumber='<PAYMENT_NUMBER_FROM_USER>' or payment.paymentId=<PAYMENT_ID_FROM_USER>\",            \"reversalFlag!='Y' or reversalFlag=null\"          ],          \"notes\": \"Use this driver for row-level invoice lists. Use payablesInvoicePaymentSummaries only when the user wants grouped totals.\"        },        {          \"name\": \"paymentForInvoiceInstallment\",          \"description\": \"Find the payment date, payment number, and paid amounts for a specific invoice or installment.\",          \"when\": \"User starts from an invoice number or installment and asks what payment covered it.\",          \"fieldsToReturn\": [            \"invoiceInstallment.invoiceTransaction.invoiceNumber\",            \"invoiceInstallment.installmentNumber\",            \"payment.paymentNumber\",            \"payment.paymentId\",            \"payment.paymentDate\",            \"amount\",            \"discountTaken\",            \"reversalFlag\"          ],          \"extraFilterExpressions\": [            \"invoiceInstallment.invoiceTransaction.invoiceNumber='<INVOICE_NUMBER_FROM_USER>'\",            \"invoiceInstallment.installmentNumber=<INSTALLMENT_NUMBER_FROM_USER> when the user gives an installment\",            \"reversalFlag!='Y' or reversalFlag=null\"          ],          \"notes\": \"\"        },        {          \"name\": \"invoicePaymentDiscountBreakdown\",          \"description\": \"Explain discounts taken or lost for invoice-payment rows within a payment, PPR, invoice, or supplier slice.\",          \"when\": \"User asks for discount amount taken on a payment for an invoice or for discount/tax style breakdowns of invoice-payment activity.\",          \"fieldsToReturn\": [            \"payment.paymentNumber\",            \"invoiceInstallment.invoiceTransaction.invoiceNumber\",            \"invoiceInstallment.installmentNumber\",            \"amount\",            \"discountTaken\",            \"discountTakenInvoiceCurrency\",            \"discountLost\",            \"discountLostInvoiceCurrency\",            \"annualPercentageRate\",            \"daysAccelerated\"          ],          \"extraFilterExpressions\": [            \"payment.paymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>' when the user gives a PPR\",            \"invoiceInstallment.invoiceTransaction.invoiceNumber='<INVOICE_NUMBER_FROM_USER>' when the user gives an invoice\",            \"reversalFlag!='Y' or reversalFlag=null\"          ],          \"notes\": \"This shape does not expose tax detail; use it for payment and discount breakdowns and pair with tax-specific shapes if available.\"        },        {          \"name\": \"crossCurrencyInvoicePayment\",          \"description\": \"Review exchange rates for invoice-payment rows where invoice and payment currencies differ.\",          \"when\": \"User asks what exchange rate was used for a payment of an invoice installment.\",          \"fieldsToReturn\": [            \"invoiceInstallment.invoiceTransaction.invoiceNumber\",            \"invoiceInstallment.installmentNumber\",            \"invoiceCurrency.currencyCode\",            \"paymentCurrency.currencyCode\",            \"paidAmountInvoiceExchangeRate\",            \"paidAmountPaymentExchangeRate\",            \"conversionRate\",            \"crossCurrencyConversionRate\",            \"conversionDate\"          ],          \"extraFilterExpressions\": [            \"invoiceInstallment.invoiceTransaction.invoiceNumber='<INVOICE_NUMBER_FROM_USER>'\",            \"invoiceCurrency.currencyCode='<INVOICE_CURRENCY_FROM_USER>'\",            \"paymentCurrency.currencyCode='<PAYMENT_CURRENCY_FROM_USER>'\"          ],          \"notes\": \"\"        }      ],      \"additionalInstructions\": [        \"Use this detail shape when the user gives a payment number or payment id and asks for the specific invoices or installments covered by that payment.\",        \"For settled-invoice queries, exclude reversed rows with `reversalFlag!='Y' or reversalFlag=null` unless the user explicitly asks to include reversals.\",        \"Use payablesInvoicePaymentSummaries for grouped invoice-payment rollups after the detail slice has been resolved.\",        \"Do not use this shape as a tax-line detail source; it exposes payment and discount amounts, not tax distribution lines.\"      ]    },    \"paymentRunCriteria\": {      \"key\": \"paymentRunCriteria\",      \"name\": \"paymentRunCriteria\",      \"type\": \"BV\",      \"shapeRole\": \"detail\",      \"module\": \"oraErpCorePayablesPayments\",      \"businessObject\": \"PayablesPaymentProcessRequest\",      \"api\": \"objects/ora/erpCore/payablesPayments/v1/paymentRunCriteria\",      \"description\": \"Use this BV shape to retrieve payment run criteria for a Payables Payment Process Request, including selection and grouping criteria, the invoice due-date window, payment priority range, pay-only-when-due policy, payment-file creation controls, payee and invoice-batch context, payment method, status, dynamic-discount policy, invoice conversion-rate policy, and document-rejection rules.\",      \"exampleQuestions\": [        \"Show payment run criteria for payment process request zBIA_Payment\",        \"What pay-from date, pay-through date, and priority range are configured for PPR zBIA_Payment\",        \"Which payment process requests are configured to pay only when due\",        \"List payment runs using payment method EFT with dynamic discount invoices enabled\",        \"Show payment run criteria for payee Vision Operations and invoice batch APR_2026_01\",        \"Show document rejection rule and invoice conversion rate type for PPR zBIA_Payment\",        \"What's the document rejection level set to for this PPR\",        \"Why are these PPRs waiting for file creation\",        \"What's the document rejection level set to for PPR <PPR_NAME>\"      ],      \"fields\": {        \"fields\": [          \"checkrunId\",          \"checkrunName\",          \"payThroughDate\",          \"payFromDate\",          \"hiPaymentPriority\",          \"lowPaymentPriority\",          \"payOnlyWhenDueFlag\",          \"createPaymentInstructionFlag\",          \"vendorTypeLookupCode\",          \"zeroAmountInvoicesAllowed\",          \"payGroupOption\",          \"currencyGroupOption\",          \"legalEntityGroupOptions\",          \"businessUnitGroupOption\",          \"invoiceSourceGroupOption\"        ],        \"accessors\": {          \"acceleratedInvoicesLookup\": {            \"shape\": \"Lookup\",            \"fields\": [              \"lookupCode\",              \"lookupType\",              \"meaning\"            ]          },          \"paymentMethod\": {            \"shape\": \"PaymentMethod\",            \"fields\": [              \"code\",              \"paymentMethodName\"            ]          },          \"invoiceConversionRateTypeLookup\": {            \"shape\": \"Lookup\",            \"fields\": [              \"lookupCode\",              \"lookupType\",              \"meaning\"            ]          },          \"party\": {            \"shape\": \"Party\",            \"fields\": [              \"id\",              \"name\"            ]          },          \"invoiceBatch\": {            \"shape\": \"PayablesInvoiceBatch\",            \"fields\": [              \"batchId\",              \"batchName\"            ]          },          \"paymentProcessRequestStatus\": {            \"shape\": \"Lookup\",            \"fields\": [              \"lookupCode\",              \"lookupType\",              \"meaning\"            ]          },          \"documentRejectionLookup\": {            \"shape\": \"Lookup\",            \"fields\": [              \"lookupCode\",              \"lookupType\",              \"meaning\"            ]          }        },        \"fieldAlias\": {          \"PPR Id\": \"checkrunId\",          \"PPR Name\": \"checkrunName\",          \"Pay From Date\": \"payFromDate\",          \"Pay Through Date\": \"payThroughDate\",          \"High Payment Priority\": \"hiPaymentPriority\",          \"Low Payment Priority\": \"lowPaymentPriority\",          \"Pay Only When Due\": \"payOnlyWhenDueFlag\",          \"Create Payment Instructions\": \"createPaymentInstructionFlag\",          \"Create Payment Files Immediately\": \"createPaymentInstructionFlag\",          \"Payee Type\": \"vendorTypeLookupCode\",          \"Include Zero Amount Invoices\": \"zeroAmountInvoicesAllowed\",          \"Pay Group Option\": \"payGroupOption\",          \"Currency Group Option\": \"currencyGroupOption\",          \"Legal Entity Group Option\": \"legalEntityGroupOptions\",          \"Business Unit Group Option\": \"businessUnitGroupOption\",          \"Invoice Source Group Option\": \"invoiceSourceGroupOption\",          \"PPR Status Code\": \"paymentProcessRequestStatus.lookupCode\",          \"PPR Status\": \"paymentProcessRequestStatus.meaning\",          \"Payment Method\": \"paymentMethod.paymentMethodName\",          \"Payment Method Code\": \"paymentMethod.code\",          \"Dynamic Discount Policy\": \"acceleratedInvoicesLookup.meaning\",          \"Dynamic Discount Code\": \"acceleratedInvoicesLookup.lookupCode\",          \"Invoice Conversion Rate Type\": \"invoiceConversionRateTypeLookup.meaning\",          \"Invoice Conversion Rate Code\": \"invoiceConversionRateTypeLookup.lookupCode\",          \"Payee\": \"party.name\",          \"Invoice Batch\": \"invoiceBatch.batchName\",          \"Document Rejection Level\": \"documentRejectionLookup.meaning\",          \"Document Rejection Code\": \"documentRejectionLookup.lookupCode\"        }      },      \"fieldSelection\": {        \"base\": [          \"checkrunId\",          \"checkrunName\",          \"payThroughDate\",          \"payFromDate\",          \"hiPaymentPriority\",          \"lowPaymentPriority\",          \"payOnlyWhenDueFlag\",          \"createPaymentInstructionFlag\",          \"vendorTypeLookupCode\",          \"zeroAmountInvoicesAllowed\",          \"payGroupOption\",          \"currencyGroupOption\",          \"legalEntityGroupOptions\",          \"businessUnitGroupOption\",          \"invoiceSourceGroupOption\"        ],        \"optional\": [          \"paymentProcessRequestStatus.lookupCode\",          \"paymentProcessRequestStatus.meaning\",          \"paymentMethod.code\",          \"paymentMethod.paymentMethodName\",          \"acceleratedInvoicesLookup.lookupCode\",          \"acceleratedInvoicesLookup.meaning\",          \"invoiceConversionRateTypeLookup.lookupCode\",          \"invoiceConversionRateTypeLookup.meaning\",          \"party.id\",          \"party.name\",          \"invoiceBatch.batchId\",          \"invoiceBatch.batchName\",          \"documentRejectionLookup.lookupCode\",          \"documentRejectionLookup.meaning\"        ]      },      \"sortableAttributes\": [        \"checkrunId\",        \"checkrunName\"      ],      \"filterConditions\": [        {          \"name\": \"checkrunId\",          \"attribute\": \"checkrunId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides the payment process request identifier.\"        },        {          \"name\": \"checkrunName\",          \"attribute\": \"checkrunName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user identifies the payment process request by name.\"        },        {          \"name\": \"payFromDate\",          \"attribute\": \"payFromDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about the lower bound of the invoice due-date window.\"        },        {          \"name\": \"payThroughDate\",          \"attribute\": \"payThroughDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about the upper bound of the invoice due-date window.\"        },        {          \"name\": \"hiPaymentPriority\",          \"attribute\": \"hiPaymentPriority\",          \"type\": \"int32\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for the highest payment priority included in the run.\"        },        {          \"name\": \"lowPaymentPriority\",          \"attribute\": \"lowPaymentPriority\",          \"type\": \"int32\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for the lowest payment priority included in the run.\"        },        {          \"name\": \"payOnlyWhenDueFlag\",          \"attribute\": \"payOnlyWhenDueFlag\",          \"type\": \"boolean\",          \"possibleValues\": [            \"true\",            \"false\"          ],          \"usage\": \"Use when the user asks whether the payment run pays invoices only when due.\"        },        {          \"name\": \"createPaymentInstructionFlag\",          \"attribute\": \"createPaymentInstructionFlag\",          \"type\": \"boolean\",          \"possibleValues\": [            \"true\",            \"false\"          ],          \"usage\": \"Use when the user asks for PPR waiting file creation.\"        },        {          \"name\": \"vendorTypeLookupCode\",          \"attribute\": \"vendorTypeLookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payee or supplier type.\"        },        {          \"name\": \"zeroAmountInvoicesAllowed\",          \"attribute\": \"zeroAmountInvoicesAllowed\",          \"type\": \"string\",          \"possibleValues\": [            \"Y\",            \"N\"          ],          \"usage\": \"Use when the user asks whether zero-amount invoices are allowed in the run.\"        },        {          \"name\": \"payGroupOption\",          \"attribute\": \"payGroupOption\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use for pay-group selection criteria questions.\"        },        {          \"name\": \"currencyGroupOption\",          \"attribute\": \"currencyGroupOption\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use for currency selection or grouping criteria questions.\"        },        {          \"name\": \"legalEntityGroupOptions\",          \"attribute\": \"legalEntityGroupOptions\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks how legal entities are grouped or filtered in the run.\"        },        {          \"name\": \"businessUnitGroupOption\",          \"attribute\": \"businessUnitGroupOption\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks how business units are grouped or filtered in the run.\"        },        {          \"name\": \"invoiceSourceGroupOption\",          \"attribute\": \"invoiceSourceGroupOption\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about invoice source selection criteria.\"        },        {          \"name\": \"paymentProcessRequestStatus.lookupCode\",          \"attribute\": \"paymentProcessRequestStatus.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [            \"MISSING_X_RATES\",            \"MISSING RATES\",            \"REQUIRING_ATTENTION\",            \"IN_PROCESS\",            \"ORA_REQUIRE_APPROVAL\",            \"ORA_APPROVAL_ERROR\"  