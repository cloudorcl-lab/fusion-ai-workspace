                {
                  "metadata": {
                    "name": "Parse AV Query Result",
                    "returnType": "array",
                    "sourceCode": "var heading = $context.$nodes.FIN_AP_LOOP_EXECUTOR.$currentItem.plan.header;\n\nconst formatHint = \"\";\n\nvar apiUrl = $context.$nodes.FIN_AP_LOOP_EXECUTOR.$currentItem.api;\n\n// Query context\nvar queryContext = $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_AV_QUERY_BUILDER\n  ? $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_AV_QUERY_BUILDER.$output || {}\n  : {};\n\n// 1) Raw rows from execution node\nvar rows = [];\nif (\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_BO_GET_AV_DATA.$output &&\n  Array.isArray($context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_BO_GET_AV_DATA.$output.items)\n) {\n  rows = $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_BO_GET_AV_DATA.$output.items;\n}\n\n// 2) Technical fields + fieldAlias (DISPLAY -> TECHNICAL) from AVQUERY\nvar technicalFields = [];\nvar fieldAlias = {};\n\nif (\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR &&\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_AV_QUERY_BUILDER &&\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_AV_QUERY_BUILDER.$output &&\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_AV_QUERY_BUILDER.$output.avQuery\n) {\n  var avOut = $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_AV_QUERY_BUILDER.$output;\n\n  if (typeof avOut.avQuery.fields === \"string\" && avOut.avQuery.fields.trim().length > 0) {\n    technicalFields = avOut.avQuery.fields\n      .split(\",\")\n      .map(function (f) { return f.trim(); });\n  }\n\n  if (avOut.fieldAlias && typeof avOut.fieldAlias === \"object\") {\n    fieldAlias = avOut.fieldAlias;\n  }\n}\n\nif (technicalFields.length === 0 && rows.length > 0) {\n  technicalFields = Object.keys(rows[0]);\n}\n\nfunction getValueByPath(obj, path) {\n  var parts = path.split(\".\");\n  var value = obj;\n\n  for (var i = 0; i < parts.length; i++) {\n    if (value && Object.prototype.hasOwnProperty.call(value, parts[i])) {\n      value = value[parts[i]];\n    } else {\n      value = \"\";\n      break;\n    }\n  }\n\n  return value === null || value === undefined ? \"\" : value;\n}\n\nfunction getDisplayName(technical) {\n  for (var display in fieldAlias) {\n    if (!fieldAlias.hasOwnProperty(display)) continue;\n    if (fieldAlias[display] === technical) {\n      return display;\n    }\n  }\n\n  return technical;\n}\n\nvar processedRows = [];\n\nfor (var r = 0; r < rows.length; r++) {\n  var src = rows[r];\n  var dst = {};\n\n  for (var t = 0; t < technicalFields.length; t++) {\n    var technicalName = technicalFields[t];\n    var displayName = getDisplayName(technicalName);\n\n    var value;\n    if (technicalName.indexOf(\".\") !== -1) {\n      value = getValueByPath(src, technicalName);\n    } else {\n      value = src.hasOwnProperty(technicalName) ? src[technicalName] : \"\";\n      if (value === null || value === undefined) {\n        value = \"\";\n      }\n    }\n\n    dst[displayName] = value;\n  }\n\n  processedRows.push(dst);\n}\n\nvar columnOrder = technicalFields.map(function (technicalName) {\n  return getDisplayName(technicalName);\n});\n\nconst tableBlock = {\n  type: \"table\",\n  heading: heading,\n  content: processedRows,\n  formatHint: formatHint,\n  columnOrder: columnOrder,\n  purpose: $context.$nodes.FIN_AP_LOOP_EXECUTOR.$currentItem.purpose || \"\",\n  contextData: {\n    apiUrl: apiUrl,\n    queryContext: queryContext\n  }\n};\n\nreturn tableBlock;"
                  },
                  "outcomes": {
                    "success": "end_1776673096935"
                  },
                  "diagram": {
                    "x": 5020,
                    "y": 11788
                  },
                  "code": "PARSE_AV_QUERY_RESULT",
                  "id": "1776674886447",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE",
                  "convergenceTargetId": "1778494579479"
                },
                {
                  "metadata": {
                    "name": "Parse BV Data",
                    "returnType": "object",
                    "sourceCode": "var heading = $context.$nodes.FIN_AP_LOOP_EXECUTOR.$currentItem.plan.header ;\nvar sequence = 3;                                    // from layout plan\nvar formatHint = \"\";                                // or e.g. \"installmentDetails\"\n\n\nvar apiUrl = $context.$nodes.FIN_AP_LOOP_EXECUTOR.$currentItem.api;\n\n// Query context\nvar queryContext = $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_BV_QUERY_BUILDER\n  ? $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_BV_QUERY_BUILDER.$output || {}\n  : {};\n\n\n// 1. Extract rows from BV output\nvar rows = [];\nif (\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_BO_GET_BV_DATA.$output &&\n  Array.isArray($context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_BO_GET_BV_DATA.$output.items)\n) {\n  rows = $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_BO_GET_BV_DATA.$output.items;\n}\n\n// 2. Technical fields + fieldAlias (DISPLAY -> TECHNICAL) from BV query node for unselected installments\nvar technicalFields = [];\nvar fieldAlias = {};\n\nif (\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR &&\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_BV_QUERY_BUILDER &&\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_BV_QUERY_BUILDER.$output &&\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_BV_QUERY_BUILDER.$output.bvQuery\n) {\n  var bvOut = $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_BV_QUERY_BUILDER.$output;\n\n  if (typeof bvOut.bvQuery.fields === \"string\" && bvOut.bvQuery.fields.trim().length > 0) {\n    technicalFields = bvOut.bvQuery.fields\n      .split(\",\")\n      .map(function (f) { return f.trim(); });\n  }\n\n  if (bvOut.fieldAlias && typeof bvOut.fieldAlias === \"object\") {\n    // Expecting: { DisplayLabel: \"technical.path\" }\n    fieldAlias = bvOut.fieldAlias;\n  }\n}\n\n// If BVQUERY_UNSELECTED didn’t give fields, derive from first row\nif (technicalFields.length === 0 && rows.length > 0) {\n  technicalFields = Object.keys(rows[0]);\n}\n\n\nfunction normaliseFieldPath(path) {\n  return String(path || \"\")\n    .trim()\n    .toLowerCase();\n}\n\n// Build a reverse alias lookup: normalised technical -> display label\nvar reverseAlias = {};\nfor (var displayLabel in fieldAlias) {\n  if (!Object.prototype.hasOwnProperty.call(fieldAlias, displayLabel)) continue;\n  var tech = fieldAlias[displayLabel];\n  var key = normaliseFieldPath(tech);\n  if (!reverseAlias[key]) {\n    reverseAlias[key] = displayLabel;\n  }\n}\n\n// Helper: resolve dotted path like \"supplier.name\"\nfunction getValueByPath(obj, path) {\n  var parts = path.split(\".\");\n  var value = obj;\n  for (var i = 0; i < parts.length; i++) {\n    if (value && Object.prototype.hasOwnProperty.call(value, parts[i])) {\n      value = value[parts[i]];\n    } else {\n      value = \"\";\n      break;\n    }\n  }\n  if (value === null || value === undefined) {\n    return \"\";\n  }\n  return value;\n}\n\n// Helper: given a technical field, find its display name if we have it (case-insensitive), else use technical\nfunction getDisplayName(technical) {\n  var key = normaliseFieldPath(technical);\n  var display = reverseAlias[key];\n  return display || technical;\n}\n\n// NEW: find actual key in a row object case-insensitively\nfunction findActualKey(obj, requestedKey) {\n  if (!obj || typeof obj !== \"object\") return null;\n\n  // Fast path: exact match\n  if (Object.prototype.hasOwnProperty.call(obj, requestedKey)) {\n    return requestedKey;\n  }\n\n  var target = normaliseFieldPath(requestedKey);\n  for (var k in obj) {\n    if (!Object.prototype.hasOwnProperty.call(obj, k)) continue;\n    if (normaliseFieldPath(k) === target) {\n      return k; // return the real key from the object\n    }\n  }\n  return null;\n}\n\n// 3. Build processed rows: keys = display names (or technical), strip $id and $context\nvar processedRows = [];\nfor (var r = 0; r < rows.length; r++) {\n  var src = rows[r];\n  var dst = {};\n\n  for (var t = 0; t < technicalFields.length; t++) {\n    var technicalName = technicalFields[t];\n\n    // skip internal/meta fields if they appear in fields list\n    if (technicalName === \"$id\" || technicalName === \"$context\") {\n      continue;\n    }\n\n    var displayName = getDisplayName(technicalName);\n    var value;\n\n    if (technicalName.indexOf(\".\") !== -1) {\n      // dotted path: use path helper directly (paths should already be canonical)\n      value = getValueByPath(src, technicalName);\n    } else {\n      // non-dotted: find actual key in row case-insensitively\n      var actualKey = findActualKey(src, technicalName);\n      if (actualKey !== null) {\n        value = src[actualKey];\n      } else {\n        value = \"\";\n      }\n      if (value === null || value === undefined) {\n        value = \"\";\n      }\n    }\n\n    dst[displayName] = value;\n  }\n\n  processedRows.push(dst);\n}\n\n// 4. Column order = display names (or technical) in same order, dropping $id/$context\nvar columnOrder = [];\nfor (var t2 = 0; t2 < technicalFields.length; t2++) {\n  var tech = technicalFields[t2];\n  if (tech === \"$id\" || tech === \"$context\") {\n    continue;\n  }\n  columnOrder.push(getDisplayName(tech));\n}\n\n// 5. Assemble the final table block\nvar tableBlock = {\n  type: \"table\",\n  heading: heading,\n  content: processedRows,\n  sequence: sequence,\n  formatHint: formatHint,\n  columnOrder: columnOrder,\n   purpose: $context.$nodes.FIN_AP_LOOP_EXECUTOR.$currentItem.purpose ,\n  contextData: {\n    apiUrl: apiUrl,\n    queryContext: queryContext\n  }\n};\n\n\nreturn tableBlock;"
                  },
                  "outcomes": {
                    "success": "end_1776673096935"
                  },
                  "diagram": {
                    "x": 5920,
                    "y": 11788
                  },
                  "code": "FIN_AP_PARSE_BV_DATA",
                  "id": "1776754566361",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "Parse Extract Query",
                    "returnType": "object",
                    "sourceCode": "var heading = $context.$nodes.FIN_AP_LOOP_EXECUTOR.$currentItem.plan.header;\nvar sequence = 1; // from layout plan\nvar formatHint = \"\"; // or e.g. \"statusCounts\"\n\n// API URL\nvar apiUrl = \"/api/boss/extraction/extract\";\n\n// Query context from EXTRACTIONQUERY\nvar queryContext =\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_EXTRACTION_QUERY_BUILDER &&\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_EXTRACTION_QUERY_BUILDER.$output\n    ? $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_EXTRACTION_QUERY_BUILDER.$output\n    : {};\n\n// 1) Extract rows from EV output\nvar rows = Array.isArray($context.$nodes.FIN_AP_LOOP_EXECUTOR.GET_EXTRACT_DATA.$output)\n  ? $context.$nodes.FIN_AP_LOOP_EXECUTOR.GET_EXTRACT_DATA.$output\n  : [];\n\n// 2) fields + fieldAlias (DISPLAY -> TECHNICAL) from extraction query node (optional)\nvar fields = \"\";\nvar fieldAlias = {};\n\nif (\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR &&\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_EXTRACTION_QUERY_BUILDER &&\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_EXTRACTION_QUERY_BUILDER.$output\n) {\n  var exOut = $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_EXTRACTION_QUERY_BUILDER.$output;\n\n  if (typeof exOut.fields === \"string\") {\n    fields = exOut.fields;    // may be empty; handled below\n  }\n\n  if (exOut.fieldAlias && typeof exOut.fieldAlias === \"object\") {\n    // Expected shape: { DisplayLabel: \"TECHNICAL_FIELD\" }\n    fieldAlias = exOut.fieldAlias;\n  }\n}\n\n// 3) Build technicalFields from fields string or from row keys if fields is empty\nvar technicalFields = [];\nif (typeof fields === \"string\" && fields.trim().length > 0) {\n  technicalFields = fields.split(\",\").map(function (f) { return f.trim(); });\n} else if (rows.length > 0) {\n  // No fields provided: show all columns present in the data\n  technicalFields = Object.keys(rows[0]);\n}\n\n// Helper: camelCase a TECHNICAL field name for default display when no alias exists\nfunction toCamelCase(name) {\n  return String(name)\n    .toLowerCase()\n    .replace(/[_\\s]+([a-z0-9])/g, function (_, g1) { return g1.toUpperCase(); });\n}\n\n// Helper: resolve a field name on a row in a **case-insensitive** way\nfunction getValueCaseInsensitive(obj, technical) {\n  var techLower = String(technical).toLowerCase();\n\n  for (var key in obj) {\n    if (!Object.prototype.hasOwnProperty.call(obj, key)) continue;\n    if (String(key).toLowerCase() === techLower) {\n      var v = obj[key];\n      return v === null || v === undefined ? \"\" : v;\n    }\n  }\n\n  return \"\";\n}\n\n// Helper: given a technical column, find its display name (case-insensitive) if alias exists, else camelCase(technical)\nfunction getDisplayName(technical) {\n  var techLower = String(technical).toLowerCase();\n\n  for (var display in fieldAlias) {\n    if (!fieldAlias.hasOwnProperty(display)) continue;\n    var mapped = fieldAlias[display];\n    if (mapped != null && String(mapped).toLowerCase() === techLower) {\n      return display;\n    }\n  }\n\n  // No explicit alias match: generate a camelCase label\n  return toCamelCase(technical);\n}\n\n// 4) Build processed rows: keys = display names (or camelCase technical)\nvar processedRows = [];\nfor (var r = 0; r < rows.length; r++) {\n  var src = rows[r];\n  var dst = {};\n\n  for (var t = 0; t < technicalFields.length; t++) {\n    var technicalName = technicalFields[t];       // e.g. \"currency\" vs \"CURRENCY\"\n    var displayName = getDisplayName(technicalName);\n\n    var value = getValueCaseInsensitive(src, technicalName);\n    dst[displayName] = value;\n  }\n\n  processedRows.push(dst);\n}\n\n// 5) Column order = display names in same order as technicalFields\nvar columnOrder = technicalFields.map(function (technicalName) {\n  return getDisplayName(technicalName);\n});\n\n\n\n// 6) Assemble the final table block\nvar tableBlock = {\n  type: \"table\",\n  heading: heading,\n  content: processedRows,\n  sequence: sequence,\n  formatHint: formatHint,\n  columnOrder: columnOrder,\n  purpose: exOut.notes,\n  contextData: {\n    apiUrl: apiUrl,\n    queryContext: queryContext\n  }\n};\n\nreturn tableBlock;"
                  },
                  "outcomes": {
                    "success": "end_1776673096935"
                  },
