         }            }          },          \"disbursementInboundFile\": {            \"fields\": [              \"id\",              \"fileName\",              \"timeCreated\",              \"errorMessage\"            ],            \"accessors\": {              \"paymentSystem\": {                \"fields\": [                  \"id\",                  \"paymentSystemName\"                ]              },              \"inboundFileProcessingStatus\": {                \"fields\": [                  \"lookupType\",                  \"meaning\",                  \"lookupCode\"                ]              }            }          },          \"supplierSite\": {            \"fields\": [              \"id\",              \"name\"            ],            \"accessors\": {              \"supplier\": {                \"fields\": [                  \"supplierId\",                  \"name\"                ],                \"accessors\": {                  \"supplierType\": {                    \"fields\": [                      \"lookupType\",                      \"meaning\",                      \"lookupCode\"                    ]                  }                }              }            }          },          \"payablesPayment\": {            \"fields\": [              \"paymentId\",              \"paymentDate\",              \"paymentCurrencyCode\",              \"supplierName\",              \"paymentAmount\",              \"remitToSupplierName\",              \"remitToAddressName\",              \"futurePayDueDate\",              \"conversionRate\",              \"conversionDate\",              \"paymentBaseAmount\",              \"positivePayStatusCode\",              \"paymentNumber\",              \"clearingAmount\",              \"clearingDate\",              \"clearingBaseAmount\",              \"clearingConversionRate\",              \"clearingConversionDate\",              \"clearingConversionRateType\",              \"reconciledFlag\",              \"matu