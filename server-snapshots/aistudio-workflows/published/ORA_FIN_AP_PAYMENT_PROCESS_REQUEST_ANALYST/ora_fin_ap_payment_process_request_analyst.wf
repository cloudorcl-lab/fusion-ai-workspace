\"              }            ],            \"hierarchies\": [              {                \"name\": \"errorDateToYearHierarchy\",                \"levels\": [                  \"DAY\",                  \"MONTH\",                  \"QUARTER\",                  \"YEAR\"                ]              },              {                \"name\": \"errorDateWeekToYearHierarchy\",                \"levels\": [                  \"DAY\",                  \"WEEK\",                  \"YEAR\"                ]              }            ]          },          {            \"name\": \"paymentDate\",            \"attributes\": [              {                \"name\": \"calendarDate\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"calendarYear\"              },              {                \"name\": \"calendarQuarter\"              },              {                \"name\": \"calendarMonth\"              },              {                \"name\": \"calendarWeek\"              },              {                \"name\": \"dayOfMonth\"              }            ],            \"hierarchies\": [              {                \"name\": \"paymentDateToYearHierarchy\",                \"levels\": [                  \"DAY\",                  \"MONTH\",                  \"QUARTER\",                  \"YEAR\"                ]              },              {                \"name\": \"paymentDateWeekToYearHierarchy\",                \"levels\": [                  \"DAY\",                  \"WEEK\",                  \"YEAR\"                ]              }            ]          },          {            \"name\": \"errorDateDaysAgo\",            \"attributes\": [              {                \"name\": \"noOfDays\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"sevenDayBucket\",                \"sortable\": true,                \"searchable\": true              }            ],            \"hierarchies\": [              {                \"name\": \"errorDateDaysAgoSevenDayBucketHierarchy\",                \"levels\": [                  \"SEVENDAYBUCKET\"                ]              }            ]          }        ],        \"fieldAlias\": {          \"Blocked Payment Amount\": \"paymentAmount\",          \"Payment Run Count\": \"paymentRuns\",          \"Payment Count\": \"payments\",          \"Installment Payment Count\": \"installmentPayments\",          \"Payment Instruction Count\": \"paymentInstructions\",          \"Payment Process Request\": \"paymentProcessRequestHierarchy\",          \"PPR Id\": \"paymentProcessRequestHierarchy.paymentProcessRequestId\",          \"PPR Name\": \"paymentProcessRequestHierarchy.name\",          \"PPR Status\": \"paymentProcessRequestStatusHierarchy.paymentProcessRequestStatus\",          \"PPR Status Code\": \"paymentProcessRequestStatusHierarchy.paymentProcessRequestStatusCode\",          \"Transaction Type\": \"transactionTypeHierarchy.transactionType\",          \"Exception Reason\": \"exceptionReasonHierarchy\",          \"Exception Code\": \"exceptionReasonHierarchy.errorCode\",          \"Exception Message\": \"exceptionReasonHierarchy.errorMessage\",          \"Exception Status\": \"exceptionStatusHierarchy.errorStatus\",          \"Exception Status Code\": \"exceptionStatusHierarchy.errorStatusCode\",          \"Document Status\": \"paymentRunInstallmentStatusHierarchy.documentStatus\",          \"Document Status Code\": \"paymentRunInstallmentStatusHierarchy.documentStatusCode\",          \"Payment Status\": \"disbursementPaymentStatusHierarchy.paymentStatus\",          \"Payment Status Code\": \"disbursementPaymentStatusHierarchy.paymentStatusCode\",          \"Payment Instruction Status\": \"paymentInstructionStatusHierarchy.paymentInstructionStatus\",          \"Payment Instruction Status Code\": \"paymentInstructionStatusHierarchy.paymentInstructionStatusCode\",          \"Supplier\": \"supplierHierarchy\",          \"Supplier Name\": \"supplierHierarchy.supplierName\",          \"Supplier Number\": \"supplierHierarchy.supplierNumber\",          \"Supplier Site\": \"supplierHierarchy.supplierSiteName\",          \"Supplier Country\": \"supplierHierarchy.country\",          \"Supplier Type\": \"supplierHierarchy.supplierTypeMeaning\",          \"Business Unit\": \"businessUnitHierarchy\",          \"Business Unit Name\": \"businessUnitHierarchy.businessUnitName\",          \"Legal Entity\": \"legalEntityHierarchy\",          \"Legal Entity Name\": \"legalEntityHierarchy.legalEntityName\",          \"Payment Currency\": \"paymentCurrencyHierarchy\",          \"Currency Code\": \"paymentCurrencyHierarchy.currencyCode\",          \"Payment Method\": \"paymentMethodHierarchy\",          \"Payment Method Name\": \"paymentMethodHierarchy.paymentMethodName\",          \"Payment Format\": \"paymentFormatHierarchy\",          \"Payment Format Name\": \"paymentFormatHierarchy.paymentFormatName\",          \"Payment Function\": \"paymentFunctionHierarchy\",          \"Payment Function Code\": \"paymentFunctionHierarchy.paymentFunctionCode\",          \"Payment Function Name\": \"paymentFunctionHierarchy.paymentFunction\",          \"Error Date\": \"errorDateToYearHierarchy.calendarDate\",          \"Error Date Bucket\": \"errorDateDaysAgoSevenDayBucketHierarchy.sevenDayBucket\",          \"Payment Date\": \"paymentDateToYearHierarchy.calendarDate\"        }      },      \"fieldSelection\": {        \"base\": [          \"paymentAmount\",          \"paymentRuns\",          \"payments\",          \"installmentPayments\",          \"paymentInstructions\",          \"paymentProcessRequestHierarchy\",          \"exceptionReasonHierarchy\",          \"transactionTypeHierarchy\",          \"paymentCurrencyHierarchy\"        ],        \"optional\": [          \"paymentProcessRequestStatusHierarchy\",          \"payment