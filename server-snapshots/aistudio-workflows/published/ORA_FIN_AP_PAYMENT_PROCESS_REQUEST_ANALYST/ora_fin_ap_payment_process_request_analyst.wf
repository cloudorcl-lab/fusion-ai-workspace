        {
          "metadata": {
            "name": "Enrich Shape Definitions in Plan",
            "returnType": "array",
            "sourceCode": "function parseMaybeJson(value) {\n  if (value == null) return null;\n  if (typeof value === \"object\") return value;\n  if (typeof value === \"string\") {\n    var text = value.trim();\n    if (!text) return null;\n\n    try {\n      return JSON.parse(text);\n    } catch (e) {\n      var fenced = text.match(/^```(?:json)?\\s*([\\s\\S]*?)\\s*```$/i);\n      if (fenced && fenced[1]) {\n        try {\n          return JSON.parse(fenced[1].trim());\n        } catch (ignored) {\n          return value;\n        }\n      }\n      return value;\n    }\n  }\n  return value;\n}\n\nfunction asObject(value) {\n  value = parseMaybeJson(value);\n  return value && typeof value === \"object\" && !Array.isArray(value) ? value : {};\n}\n\nfunction asArray(value) {\n  value = parseMaybeJson(value);\n  if (value == null) return [];\n  return Array.isArray(value) ? value : [value];\n}\n\nfunction cloneValue(value) {\n  value = parseMaybeJson(value);\n  if (value == null) return value;\n  return JSON.parse(JSON.stringify(value));\n}\n\nfunction getNodeResult(nodeCode) {\n  var nodes = ($context && $context.$nodes) || {};\n  var node = nodes[nodeCode] || {};\n  var output = node.$output || node.output || {};\n  if (output && output.result !== undefined) return parseMaybeJson(output.result);\n  return parseMaybeJson(output);\n}\n\nfunction getPlannerOutput() {\n  var output = getNodeResult(\"BUILD_DATA_PLAN\");\n  if (Array.isArray(output) && output.length === 1) {\n    output = parseMaybeJson(output[0]);\n  }\n  output = parseMaybeJson(output);\n  return asObject(output);\n}\n\nfunction getPlanItems(plannerOutput) {\n  if (Array.isArray(plannerOutput.plan)) return plannerOutput.plan;\n  if (Array.isArray(plannerOutput)) return plannerOutput;\n  return [];\n}\n\nfunction resolveShapeDefinition(shapeKey, shapeDefs) {\n  if (!shapeKey) return null;\n  if (shapeDefs[shapeKey]) return shapeDefs[shapeKey];\n\n  var keys = Object.keys(shapeDefs);\n  for (var i = 0; i < keys.length; i++) {\n    var shape = asObject(shapeDefs[keys[i]]);\n    if (shape.key === shapeKey || shape.name === shapeKey) {\n      return shape;\n    }\n  }\n\n  return null;\n}\n\nfunction keySet(values) {\n  var out = {};\n  asArray(values).forEach(function (value) {\n    value = value == null ? \"\" : String(value).trim();\n    if (value) out[value] = true;\n  });\n  return out;\n}\n\nfunction getSelectedDriverKeysForPlan(plan, shapeKey) {\n  var explicit = asArray(plan.relevantBusinessDriverKeys || plan.businessDriverKeys || plan.selectedBusinessDriverKeys);\n  if (explicit.length) return explicit;\n\n  var prunedInput = asObject(getNodeResult(\"PRUNE_COMPACT_DATA_PLANNER_INPUT\"));\n  var selectedByShape = asObject(prunedInput.relevantBusinessDriverKeysByShape);\n  return asArray(selectedByShape[shapeKey]);\n}\n\nfunction pruneShapeBusinessDrivers(shapeDef, selectedKeys) {\n  if (!shapeDef) return shapeDef;\n  var cloned = cloneValue(shapeDef);\n  var selected = keySet(selectedKeys);\n  var selectedCount = Object.keys(selected).length;\n  if (!selectedCount || !Array.isArray(cloned.businessDrivers)) return cloned;\n\n  cloned.businessDrivers = cloned.businessDrivers.filter(function (driver) {\n    driver = asObject(driver);\n    return !!selected[driver.key || driver.name];\n  });\n  cloned.businessDriverSelection = {\n    selectedKeys: Object.keys(selected),\n    keptCount: cloned.businessDrivers.length\n  };\n  return cloned;\n}\n\nfunction getIntentContext() {\n  var compactPlannerInput = asObject(getNodeResult(\"PRUNE_COMPACT_DATA_PLANNER_INPUT\"));\n\n  return asObject(compactPlannerInput.intent);\n}\n\nvar plannerOutput = getPlannerOutput();\nvar shapeDefs = asObject($context && $context.$variables && $context.$variables.shapeDefinition);\nvar planItems = getPlanItems(plannerOutput);\nvar intentContext = getIntentContext();\n\nvar loopItems = planItems.map(function (rawItem) {\n  var plan = cloneValue(rawItem) || {};\n  var shapeKey = plan.shapeKey || plan.key || null;\n  var shapeDef = resolveShapeDefinition(shapeKey, shapeDefs);\n  var selectedDriverKeys = getSelectedDriverKeysForPlan(plan, shapeKey);\n  if (!Array.isArray(plan.relevantBusinessDriverKeys) || plan.relevantBusinessDriverKeys.length === 0) {\n    plan.relevantBusinessDriverKeys = selectedDriverKeys;\n  }\n\n  return {\n    intentContext: cloneValue(intentContext),\n    plan: plan,\n    shape: shapeDef ? pruneShapeBusinessDrivers(shapeDef, selectedDriverKeys) : null\n  };\n});\n\nreturn loopItems;"
          },
