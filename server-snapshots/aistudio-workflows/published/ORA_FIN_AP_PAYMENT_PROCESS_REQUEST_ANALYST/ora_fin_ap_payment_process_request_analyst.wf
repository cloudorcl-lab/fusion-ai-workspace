      }            ],            \"hierarchies\": [              {                \"name\": \"documentStatusHierarchy\",                \"levels\": [                  \"DOCUMENTSTATUS\"                ]              }            ]          },          {            \"name\": \"paymentFileStatus\",            \"attributes\": [              {                \"name\": \"paymentInstructionStatusCode\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"paymentInstructionStatus\"              }            ],            \"hierarchies\": [              {                \"name\": \"paymentFileStatusHierarchy\",                \"levels\": [                  \"PAYMENTFILESTATUS\"                ]              }            ]          },          {            \"name\": \"paymentStatus\",            \"attributes\": [              {                \"name\": \"paymentStatusCode\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"paymentStatus\"              }            ],            \"hierarchies\": [              {                \"name\": \"paymentStatusHierarchy\",                \"levels\": [                  \"PAYMENTSTATUS\"                ]              }            ]          }        ],        \"fieldAlias\": {          \"Payment Amount\": \"paymentAmount\",          \"Unpaid Amount\": \"unpaidAmount\",          \"Withheld Amount\": \"withheldAmount\",          \"Discount Amount\": \"discountAmount\",          \"Interest Amount\": \"interestAmount\",          \"Payment Process Request\": \"paymentProcessRequestHierarchy\",          \"PPR Id\": \"paymentProcessRequestHierarchy.checkrunId\",          \"PPR Name\": \"paymentProcessRequestHierarchy.checkrunName\",          \"PPR Status\": \"paymentProcessRequestStatusHierarchy.paymentProcessRequestStatus\",          \"PPR Status Code\": \"paymentProcessRequestStatusHierarchy.paymentProcessRequestStatusCode\",          \"Supplier\": \"supplierHierarchy\",          \"Supplier Name\": \"supplierHierarchy.supplierName\",          \"Supplier Number\": \"supplierHierarchy.supplierNumber\",          \"Supplier Type\": \"supplierHierarchy.supplierTypeMeaning\",          \"Supplier Site\": \"supplierHierarchy.supplierSiteName\",          \"Supplier Country\": \"supplierHierarchy.country\",          \"Payment Currency\": \"paymentCurrencyHierarchy\",          \"Currency Code\": \"paymentCurrencyHierarchy.currencyCode\",          \"Currency Name\": \"paymentCurrencyHierarchy.currencyName\",          \"Business Unit\": \"businessUnitHierarchy\",          \"Business Unit Name\": \"businessUnitHierarchy.businessUnitName\",          \"Legal Entity\": \"legalEntityHierarchy\",          \"Legal Entity Name\": \"legalEntityHierarchy.legalEntityName\",          \"Due Date\": \"dueDateToYearHierarchy\",          \"Due Calendar Date\": \"dueDateToYearHierarchy.calendarDate\",          \"Payment Date\": \"paymentDateToYearHierarchy\",          \"Payment Calendar Date\": \"paymentDateToYearHierarchy.calendarDate\",          \"Payment Method\": \"paymentMethodHierarchy\",          \"Payment Method Name\": \"paymentMethodHierarchy.paymentMethodName\",          \"Payment Process Profile\": \"paymentProcessProfileHierarchy\",          \"Payment Process Profile Name\": \"paymentProcessProfileHierarchy.paymentProfileName\",          \"Payment Function\": \"paymentFunctionHierarchy\",          \"Payment Function Name\": \"paymentFunctionHierarchy.paymentFunction\",          \"Days Remaining\": \"dueDateDaysRemainingSevenDayBucketHierarchy.noOfDays\",          \"Days Remaining Bucket\": \"dueDateDaysRemainingSevenDayBucketHierarchy.sevenDayBucket\",          \"Payment Days Ago\": \"paymentDateDaysAgoSevenDayBucketHierarchy.noOfDays\",          \"Payment Days Ago Bucket\": \"paymentDateDaysAgoSevenDayBucketHierarchy.sevenDayBucket\",          \"Bank Account\": \"bankAccountHierarchy\",          \"Bank Account Name\": \"bankAccountHierarchy.bankAccountName\",          \"Document Status\": \"documentStatusHierarchy.documentStatus\",          \"Document Status Code\": \"documentStatusHierarchy.documentStatusCode\",          \"Payment File Status\": \"paymentFileStatusHierarchy.paymentInstructionStatus\",          \"Payment File Status Code\": \"paymentFileStatusHierarchy.paymentInstructionStatusCode\",          \"Payment Status\": \"paymentStatusHierarchy.paymentStatus\",          \"Payment Status Code\": \"paymentStatusHierarchy.paymentStatusCode\"        }      },      \"fieldSelection\": {        \"base\": [          \"paymentAmount\",          \"paymentCurrencyHierarchy\",          \"paymentProcessRequestHierarchy\",          \"supplierHierarchy\"        ],        \"optional\": [          \"unpaidAmount\",          \"withheldAmount\",          \"discountAmount\",          \"interestAmount\",          \"businessUnitHierarchy\",          \"legalEntityHierarchy\",          \"paymentProcessRequestStatusHierarchy\",          \"dueDateToYearHierarchy\",          \"paymentDateToYearHierarchy\",          \"paymentMethodHierarchy\",          \"paymentProcessProfileHierarchy\",          \"paymentFunctionHierarchy\",          \"dueDateDaysRemainingSevenDayBucketHierarchy\",          \"paymentDateDaysAgoSevenDayBucketHierarchy\",          \"bankAccountHierarchy\",          \"documentStatusHierarchy\",          \"paymentFileStatusHierarchy\",          \"paymentStatusHierarchy\"        ]      },      \"sortableAttributes\": [        \"paymentAmount\",        \"bankAccountHierarchy.bankAccountName\",        \"businessUnitHierarchy.businessUnitId\",        \"businessUnitHierarchy.businessUnitName\",        \"documentStatusHierarchy.documentStatusCode\",        \"dueDateDaysRemainingSevenDayBucketHierarchy.noOfDays\",        \"dueDateDaysRemainingSevenDayBucketHierarchy.sevenDayBucket\",        \"dueDateToYearHierarchy.calendarDate\",        \"dueDateWeekToYearHierarchy.calendarDate\",        \"legalEntityHierarchy.legalEntityId\",        \"legalEntityHierarchy.legalEntityName\",        \"paymentCurrencyHierarchy.currencyCode\",        \"paymentCurrencyHierarchy.currencyName\",        \"paymentDateDaysAgoSevenDayBucketHierarchy.noOfDays\",        \"paymentDateDaysAgoSevenDayBucketHierarchy.sevenDayBucket\",        \"paymentDateToYearHierarchy.calendarDate\",        \"paymentDateWeekToYearHierarchy.calendarDate\",        \"paymentFileStatusHierarchy.paymentInstructionStatusCode\",        \"paymentFunctionHierarchy.paymentFunctionCode\",        \"paymentMethodHierarchy.paymentMethodCode\",        \"paymentMethodHierarchy.paymentMethodName\",        \"paymentProcessRequestHierarchy.checkrunId\",        \"paymentProcessRequestStatusHierarchy.paymentProcessRequestStatusCode\",        \"paymentStatusHierarchy.paymentStatusCode\",        \"supplierHierarchy.paymentTermId\",        \"supplierHierarchy.supplierId\",        \"supplierHierarchy.supplierName\",        \"supplierHierarchy.supplierNumber\",        \"supplierHierarchy.supplierSiteId\",        \"supplierHierarchy.supplierSiteName\",        \"supplierHierarchy.supplierType\",        \"supplierHierarchy.supplierTypeMeaning\"      ],      \"filterConditions\": [        {          \"name\": \"paymentProcessRequestHierarchy.checkrunName\",          \"attribute\": \"paymentProcessRequestHierarchy.checkrunName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user names a payment process request or asks for selected-installment summary for this run or batch.checkrunName is not sortable.\"        },        {          \"name\": \"paymentProcessRequestHierarchy.checkrunId\",          \"attribute\": \"paymentProcessRequestHierarchy.checkrunId\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a PPR/checkrun id.\"        },        {          \"name\": \"paymentCurrencyHierarchy.currencyCode\",          \"attribute\": \"paymentCurrencyHierarchy.currencyCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes or groups selected-installment value by payment currency.\"        },        {          \"name\": \"supplierHierarchy.supplierName\",          \"attribute\": \"supplierHierarchy.supplierName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for supplier concentration, top suppliers, or a supplier-specific selected-installment summary.\"        },        {          \"name\": \"supplierHierarchy.supplierSiteName\",          \"attribute\": \"supplierHierarchy.supplierSiteName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters or groups by supplier site.\"        },        {          \"name\": \"supplierHierarchy.supplierTypeMeaning\",          \"attribute\": \"supplierHierarchy.supplierTypeMeaning\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for supplier-type concentration in selected installments.\"        },        {          \"name\": \"businessUnitHierarchy.businessUnitName\",          \"attribute\": \"businessUnitHierarchy.businessUnitName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user wants selected-installment totals by business unit.\"        },        {          \"name\": \"legalEntityHierarchy.legalEntityName\",          \"attribute\": \"legalEntityHierarchy.legalEntityName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes selected-installment summaries to a legal entity.\"        },        {          \"name\": \"paymentMethodHierarchy.paymentMethodCode\",          \"attribute\": \"paymentMethodHierarchy.paymentMethodCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for selected-installment totals by payment method.\"        },        {          \"name\": \"bankAccountHierarchy.bankAccountName\",          \"attribute\": \"bankAccountHierarchy.bankAccountName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for selected-installment totals grouped or filtered by disbursement bank account.\"        },        {          \"name\": \"dueDateToYearHierarchy.calendarDate\",          \"attribute\": \"dueDateToYearHierarchy.calendarDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for selected installments due on a date or in a due-date range.\"        },        {          \"name\": \"paymentDateToYearHierarchy.calendarDate\",          \"attribute\": \"paymentDateToYearHierarchy.calendarDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for selected-installment payment timing or payment-date trend within a PPR.\"        },        {          \"name\": \"dueDateDaysRemainingSevenDayBucketHierarchy.sevenDayBucket\",          \"attribute\": \"dueDateDaysRemainingSevenDayBucketHierarchy.sevenDayBucket\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user wants due-soon selected installments bucketed by days remaining.\"        },        {          \"name\": \"paymentProcessRequestStatusHierarchy.paymentProcessRequestStatusCode\",          \"attribute\": \"paymentProcessRequestStatusHierarchy.paymentProcessRequestStatusCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for selected-installment totals by PPR processing status.\"        },        {          \"name\": \"documentStatusHierarchy.documentStatusCode\",          \"attribute\": \"documentStatusHierarchy.documentStatusCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for selected-installment totals by document status.\"        },        {          \"name\": \"paymentFileStatusHierarchy.paymentInstructionStatusCode\",          \"attribute\": \"paymentFileStatusHierarchy.paymentInstructionStatusCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for selected-installment totals by payment-file status.\"        },        {          \"name\": \"paymentStatusHierarchy.paymentStatusCode\",          \"attribute\": \"paymentStatusHierarchy.paymentStatusCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for selected-installment totals by payment status.\"        }      ],      \"dateFilterGuidance\": {        \"description\": \"Use `dueDateToYearHierarchy.calendarDate` for due-date urgency and `paymentDateToYearHierarchy.calendarDate` for planned or actual selected-payment timing.\",        \"patterns\": [          {            \"userRequest\": \"due today, due this week, due in seven days, or overdue\",            \"clause\": \"apply the date window to dueDateToYearHierarchy.calendarDate\"          },          {            \"userRequest\": \"payment date, paid today, paying tomorrow, or payment timing in the PPR\",            \"clause\": \"apply the date window to paymentDateToYearHierarchy.calendarDate\"          }        ]      },      \"extractionQuery\": null,      \"businessDrivers\": [        {          \"name\": \"pprSelectedInstallmentOutflow\",          \"description\": \"Summarize selected-installment payment value for a PPR by currency.\",          \"when\": \"User asks for total cash outflow, payment value, or cash requirement for a named PPR or batch.\",          \"fieldsToReturn\": [            \"paymentAmount\",            \"unpaidAmount\",            \"withheldAmount\",            \"discountAmount\",            \"interestAmount\",            \"paymentCurrencyHierarchy\",            \"paymentProcessRequestHierarchy\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestHierarchy.checkrunName='<PPR_NAME_FROM_USER>' or paymentProcessRequestHierarchy.checkrunId=<PPR_ID_FROM_USER>\"          ],          \"notes\": \"Use this AV directly for supported measures; it already returns deduplicated summary data.\"        },        {          \"name\": \"supplierConcentrationInPpr\",          \"description\": \"Summarize selected-installment payment value by supplier or supplier site within a PPR.\",          \"when\": \"User asks for top suppliers, supplier concentration, or suppliers representing most of the selected payment value.\",          \"fieldsToReturn\": [            \"paymentAmount\",            \"supplierHierarchy\",            \"paymentCurrencyHierarchy\",            \"paymentProcessRequestHierarchy\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestHierarchy.checkrunName='<PPR_NAME_FROM_USER>' or paymentProcessRequestHierarchy.checkrunId=<PPR_ID_FROM_USER>\"          ],          \"notes\": \"Compute share-of-total and ranking outside the AV result when the user asks for top-N or 80-percent concentration analysis. For 'suppliers with most installments', group by supplier, include installment count and amount, and sort by installment count desc before limit. For 'suppliers with most installments', group by supplier, include installment count and amount, and sort by installment count desc before limit.\"        },        {          \"name\": \"businessUnitAndLegalEntityDistribution\",          \"description\": \"Summarize selected-installment payment value by business unit or legal entity.\",          \"when\": \"User asks for distribution of payment amounts by business unit or legal entity in a PPR.\",          \"fieldsToReturn\": [            \"paymentAmount\",            \"businessUnitHierarchy\",            \"legalEntityHierarchy\",            \"paymentCurrencyHierarchy\",            \"paymentProcessRequestHierarchy\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestHierarchy.checkrunName='<PPR_NAME_FROM_USER>' or paymentProcessRequestHierarchy.checkrunId=<PPR_ID_FROM_USER>\"          ],          \"notes\": \"\"        },        {          \"name\": \"fundingAndMethodBreakdown\",          \"description\": \"Summarize selected-installment value by bank account, payment method, payment process profile, or payment function.\",          \"when\": \"User asks how the selected payments are funded or wants to verify payment methods, profiles, or functions.\",          \"fieldsToReturn\": [            \"paymentAmount\",            \"bankAccountHierarchy\",            \"paymentMethodHierarchy\",            \"paymentProcessProfileHierarchy\",            \"paymentFunctionHierarchy\",            \"paymentCurrencyHierarchy\",            \"paymentProcessRequestHierarchy\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestHierarchy.checkrunName='<PPR_NAME_FROM_USER>' or paymentProcessRequestHierarchy.checkrunId=<PPR_ID_FROM_USER>\"          ],          \"notes\": \"\"        },        {          \"name\": \"dueDateAndPaymentTimingSummary\",          \"description\": \"Summarize selected-installment value by due date, payment date, or day-bucket dimensions.\",          \"when\": \"User asks whether selected installments are due soon, paid early, or concentrated in a due-date or payment-date bucket.\",          \"fieldsToReturn\": [            \"paymentAmount\",            \"dueDateToYearHierarchy\",            \"paymentDateToYearHierarchy\",            \"dueDateDaysRemainingSevenDayBucketHierarchy\",            \"paymentDateDaysAgoSevenDayBucketHierarchy\",            \"paymentCurrencyHierarchy\",            \"paymentProcessRequestHierarchy\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestHierarchy.checkrunName='<PPR_NAME_FROM_USER>' or paymentProcessRequestHierarchy.checkrunId=<PPR_ID_FROM_USER>\"          ],          \"notes\": \"Use the bucket hierarchies for grouped urgency. Use detail shapes when the user needs invoice or installment-level timing rows.\"        },        {          \"name\": \"statusBreakdownForSelectedInstallments\",          \"description\": \"Summarize selected-installment value by PPR, document, payment-file, or payment status.\",          \"when\": \"User asks how selected-installment value is distributed by processing status.\",          \"fieldsToReturn\": [            \"paymentAmount\",            \"paymentProcessRequestStatusHierarchy\",            \"documentStatusHierarchy\",            \"paymentFileStatusHierarchy\",            \"paymentStatusHierarchy\",            \"paymentProcessRequestHierarchy\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestHierarchy.checkrunName='<PPR_NAME_FROM_USER>' or paymentProcessRequestHierarchy.checkrunId=<PPR_ID_FROM_USER>\"          ],          \"notes\": \"\"        },        {          \"name\": \"supplierExclusionCashImpactInPpr\",          \"description\": \"Estimate cash savings by excluding one supplier from a named payment process request.\",          \"when\": \"User asks what cash will be saved, reduced, avoided, or removed if a specific supplier is excluded from a named PPR or batch, including phrasing like 'If I remove supplier X from this run, how much cash will I save today?'\",          \"fieldsToReturn\": [            \"paymentAmount\",            \"paymentCurrencyHierarchy.currencyCode\",            \"supplierHierarchy.supplierName\",            \"paymentProcessRequestHierarchy\"          ],          \"extraFilterExpressions\": [            \"filterfact: paymentProcessRequestHierarchy[checkrunName='<PPR_NAME_FROM_USER>'] AND supplierHierarchy[supplierName='<SUPPLIER_NAME_FROM_USER>']\",            \"filter: paymentProcessRequestHierarchy.$levelName='PAYMENTPROCESSREQUEST' AND supplierHierarchy.$levelName='SUPPLIER' AND paymentCurrencyHierarchy.$levelName='CURRENCYCODE'\",            \"sortBy: paymentCurrencyHierarchy.currencyCode:asc\",            \"limit: 20\"          ],          \"notes\": \"For 'if I remove supplier X from this run, how much cash will I save', filter to include supplier X, not exclude it. The returned paymentAmount for supplier X is the cash saved/removed from the run.\"        },        {          \"name\": \"topSuppliersByValueInPpr\",          \"description\": \"Summarize the top suppliers by selected payment value within a named payment batch or PPR.\",          \"when\": \"User asks for the top 5 suppliers by value, highest-value suppliers, or supplier ranking within a named payment batch or PPR.\",          \"fieldsToReturn\": [            \"paymentAmount\",            \"supplierHierarchy.supplierName\",            \"paymentCurrencyHierarchy.currencyCode\"          ],          \"extraFilterExpressions\": [            \"filterfact: paymentProcessRequestHierarchy[checkrunName='<PPR_NAME_FROM_USER>']\",            \"filter: paymentProcessRequestHierarchy.$levelName='PAYMENTPROCESSREQUEST' AND supplierHierarchy.$levelName='SUPPLIER' AND paymentCurrencyHierarchy.$levelName='CURRENCYCODE'\",            \"sortBy: paymentAmount:desc\",            \"limit: 5\"          ],          \"notes\": \"Use this when the user wants the highest-value suppliers in a batch. Keep the currency code filter whenever currencyCode is included in fields. Do not sort by supplier name\"        }      ],      \"additionalInstructions\": [        \"Use this AV for grouped selected-installment summaries within a payment process request. It is already deduplicated for its supported reporting scope; do not add union or deduplication logic before querying it.\",        \"Use hierarchy names and hierarchy attributes exactly as declared in `fields.dimensions`, such as `paymentProcessRequestHierarchy.checkrunName`, `paymentCurrencyHierarchy.currencyCode`, and `supplierHierarchy.supplierName`.\",        \"When a named PPR is provided, filter with `paymentProcessRequestHierarchy.checkrunName` or `paymentProcessRequestHierarchy.checkrunId` and keep the payment process request hierarchy at `PAYMENTPROCESSREQUEST` level.\",        \"Use `paymentCurrencyHierarchy.currencyCode` for currency grouping; the declared payment-currency hierarchy level is `CURRENCYCODE`.\",        \"The source metadata exposes amount measures only. Do not fabricate a selected-installment count measure; use selectedPaymentInstallments, selectedPaymentInstallmentsExtraction, or paymentRunInstallments when the user requires counts or row-level invoice/installment records.\",        \"This AV does not expose payment priority. For Standard priority or priority-band what-if questions, ask for a numeric priority or range between 1 and 100, then use selectedPaymentInstallments or selectedPaymentInstallmentsExtraction for the priority-filtered subset.\",        \"Drill into selectedPaymentInstallments for selected invoice-installment rows and paymentRunInstallments for formed-payment or disbursement context that is not exposed by this summary AV.\",        \"When user asks for top N supplier by value, always apply sort on paymentAmount:desc \",        \"Treat business-driver filters as the required semantic core, not a closed-form query. When the user adds explicit constraints such as date or date range, PPR name/id, supplier, business unit, currency, amount, status, payment method, bank account, or payment file, add those filters when the selected shape exposes the field. A user-provided date filter overrides the default recency window. Do not drop required status, null-rate, source-shape, or sorting rules unless the user explicitly asks for a different lifecycle/source and the selected shape supports it.\",        \"For business-unit distribution, include businessUnitHierarchy.$levelName='BUSINESSUNIT' and paymentCurrencyHierarchy.$levelName='CURRENCYCODE', sort by businessUnitHierarchy.businessUnitName asc before limit 20 unless the user explicitly asks for top values.\"      ],      \"fieldSelectionRuleUsage\": {        \"match\": \"Choose the closest questionExamples entry for the user request.\",        \"fields\": \"Use the matching fields value exactly and preserve order.\",        \"paraphrases\": \"Use the same fields for paraphrased or equivalent requests.\",        \"addFieldsOnlyWhen\": \"The user explicitly asks for more displayed columns, or the field is required for filter, sort, group, key, or deeplink handling.\"      },      \"fieldSelectionRules\": [        {          \"questionExamples\": [            \"If I remove supplier 'Advanced Network Devices' from this run gapr_ppr_test_4, how much cash will I save today?\"          ],          \"queryType\": \"AV\",          \"fields\": \"paymentAmount,paymentCurrencyHierarchy.currencyCode,supplierHierarchy.supplierName\",          \"fieldOrderLocked\": true        },        {          \"questionExamples\": [            \"Summarize the top 5 suppliers by value in this payment batch PPR_DD_Test3\"          ],          \"queryType\": \"AV\",          \"fields\": \"supplierHierarchy.supplierName,paymentAmount,paymentCurrencyHierarchy.currencyCode\",          \"fieldOrderLocked\": true        },        {          \"questionExamples\": [            \"What is the total cash outflow for PPR named BLR0299 across all currencies?\"          ],          \"queryType\": \"AV\",          \"fields\": \"paymentAmount,paymentCurrencyHierarchy.currencyCode\",          \"fieldOrderLocked\": true        }      ]    },    \"pprInstallmentsDeduplicatedSummary\": {      \"key\": \"pprInstallmentsDeduplicatedSummary\",      \"name\": \"pprInstallmentsDeduplicatedSummary\",      \"type\": \"EXTRACTION\",      \"shapeRole\": \"summary\",      \"module\": null,      \"businessObject\": null,      \"description\": \"Primary runtime extraction for summary-style PPR installment review. Use this shape by default for plain 'review installments for PPR', count, currency summary, supplier summary, and other summary questions unless the PPR status is already resolved to a single AP or IBY source and a source-specific field is required. It provides one shared normalization contract across AP selected-installment rows and Oracle Payments payment-run rows and lets the generated select statement choose the requested grouping, such as Currency Summary or Suppliers Involved. Summary measures must mirror the selected-invoice review SQL: selected installment count, converted amount remaining, withheld amount, discount amount, payment amount, interest amount, and total amount payable.\",      \"exampleQuestions\": [        \"Review installments for PPR zBIA_Payment\",        \"Give me the currency summary for installments under PPR gapr_ppr_test_4\",        \"Which suppliers have the most installments in this payment run, and what's the total value going to each?\",        \"Show selected-installment counts and payment totals by supplier for PPR zBIA_Payment\"      ],      \"fields\": {        \"fields\": [          \"supplierName\",          \"supplierTypeLookupCode\",          \"supplierTypeMeaning\",          \"paymentCurrencyCode\",          \"selectedInstallments\",          \"amountRemaining\",          \"withheldAmount\",          \"discountAmount\",          \"paymentAmount\",          \"interestAmount\",          \"totalAmount\"        ],        \"fieldAlias\": {          \"Supplier\": \"supplierName\",          \"Supplier Type Code\": \"supplierTypeLookupCode\",          \"Supplier Type\": \"supplierTypeMeaning\",          \"Payment Currency\": \"paymentCurrencyCode\",          \"Selected Installments\": \"selectedInstallments\",          \"Amount Remaining\": \"amountRemaining\",          \"Withheld Amount\": \"withheldAmount\",          \"Discount Amount\": \"discountAmount\",          \"Payment Amount\": \"paymentAmount\",          \"Interest Amount\": \"interestAmount\",          \"Total Amount Payable\": \"totalAmount\"        }      },      \"supportedFilters\": [        {          \"name\": \"pprName\",          \"attribute\": \"pprName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Fallback PPR filter when no payment process request/checkrun identifier is available. Prefer checkrunId/PPR ID whenever entity resolution supplies it.\",          \"valueFromUser\": \"PPR Name\"        },        {          \"name\": \"checkrunId\",          \"attribute\": \"checkrunId\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Preferred PPR filter when the user or entity resolution supplies a payment process request/checkrun identifier. Normalize branch values with TO_CHAR before comparing because AP checkrunId and Payments sourceProductFirstUniqueIdentifier can have different physical datatypes.\",          \"valueFromUser\": \"PPR ID\"        },        {          \"name\": \"supplierName\",          \"attribute\": \"supplierName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user narrows a supplier summary to one supplier or a set of suppliers.\",          \"valueFromUser\": \"Supplier\"        },        {          \"name\": \"supplierTypeLookupCode\",          \"attribute\": \"supplierSite.supplier.supplierType.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters or groups PPR installment summary by supplier type, category, class, or a similar supplier classifier. This classifier is available from the payment-run branch; in the deduplicated extraction, project supplier type as null in branches that do not expose it and apply mandatory predicates after normalization so rows without a known matching supplier type are excluded.\",          \"valueFromUser\": \"Supplier Type Code\"        },        {          \"name\": \"supplierTypeMeaning\",          \"attribute\": \"supplierSite.supplier.supplierType.meaning\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters or groups PPR installment summary by the display meaning of a supplier type, category, class, or similar supplier classifier. Prefer the lookup-code filter when the code can be resolved.\",          \"valueFromUser\": \"Supplier Type\"        },        {          \"name\": \"paymentCurrencyCode\",          \"attribute\": \"paymentCurrencyCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user narrows a summary to one payment currency or a set of currencies.\",          \"valueFromUser\": \"Payment Currency\"        },        {          \"name\": \"withheldAmount\",          \"attribute\": \"withheldAmount\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for installments with withholding tax applied or for withheld-tax totals. For withholding-applied questions, apply withheldAmount > 0 after source normalization and before the final grouping.\",          \"valueFromUser\": \"Withheld Amount\"        },        {          \"name\": \"pprStatusCode\",          \"attribute\": \"pprStatusCode\",          \"type\": \"string\",          \"possibleValues\": [            \"CANCELING\",            \"TERMINATED\"          ],          \"usage\": \"Use only for mixed-source status-scoped summaries where the status can exist in both AP and IBY. For AP-only or IBY-only statuses, use the individual source shape instead of this deduplicated extraction.\",          \"valueFromUser\": \"PPR Status\"        }      ],      \"dateFilterGuidance\": null,      \"extractionQuery\": {        \"viewQueries\": {          \"sel\": {            \"module\": \"oraErpCorePayablesPayments\",            \"view\": \"selectedPaymentInstallments\",            \"businessObject\": \"PayablesPaymentProcessRequestSelectedInvoiceInstallment\",            \"fieldAliases\": {              \"payablesPaymentProcessRequest.checkrunName\": \"pprName\",              \"payablesPaymentProcessRequest.checkrunId\": \"checkrunId\",              \"invoiceId\": \"invoiceId\",              \"installmentNumber\": \"installmentNumber\",              \"originalInvoiceTransaction.invoiceId\": \"originalInvoiceId\",              \"originalPaymentNumber\": \"originalPaymentNumber\",              \"okToPayFlag\": \"okToPayFlag\",              \"payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\": \"pprStatusCode\",              \"supplier.name\": \"supplierName\",              \"paymentCurrency.currencyCode\": \"paymentCurrencyCode\",              \"paymentAmount\": \"paymentAmount\",              \"amountRemaining\": \"amountRemaining\",              \"crossCurrencyRate\": \"xCurrRate\",              \"withheldTax\": \"withheldAmount\",              \"discount\": \"discountAmount\"            }          },          \"selInterest\": {            \"module\": \"oraErpCorePayablesPayments\",            \"view\": \"selectedPaymentInstallments\",            \"businessObject\": \"PayablesPaymentProcessRequestSelectedInvoiceInstallment\",            \"fieldAliases\": {              \"payablesPaymentProcessRequest.checkrunId\": \"checkrunId\",              \"originalInvoiceTransaction.invoiceId\": \"originalInvoiceId\",              \"originalPaymentNumber\": \"originalPaymentNumber\",              \"paymentAmount\": \"interestPaymentAmount\"            }          },          \"run\": {            \"module\": \"oraErpCorePaymentsFundsDisbursement\",            \"view\": \"paymentRunInstallments\",            \"businessObject\": \"PayablesDocumentPayable\",            \"fieldAliases\": {              \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\": \"pprName\",              \"sourceProductFirstUniqueIdentifier\": \"checkrunId\",              \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\": \"pprStatusCode\",              \"payablesInvoiceInstallment.invoiceId\": \"invoiceId\",              \"payablesInvoiceInstallment.installmentNumber\": \"installmentNumber\",              \"payeeParty.name\": \"supplierName\",              \"supplierSite.supplier.supplierType.lookupCode\": \"supplierTypeLookupCode\",              \"supplierSite.supplier.supplierType.meaning\": \"supplierTypeMeaning\",              \"paymentCurrencyCode\": \"paymentCurrencyCode\",              \"amountToBePaid\": \"paymentAmount\",              \"payablesInvoiceInstallment.unpaidAmount\": \"amountRemaining\",              \"withheldAmount\": \"withheldAmount\",              \"discount\": \"discountAmount\"            }          }        },        \"namedSelects\": [          {            \"name\": \"filteredSelectedInvoiceInstallments\",            \"select\": \"SELECT sel.pprName AS pprName,TO_CHAR(sel.checkrunId) AS checkrunId,TO_CHAR(sel.invoiceId) AS invoiceId,TO_CHAR(sel.installmentNumber) AS installmentNumber,sel.supplierName AS supplierName,sel.paymentCurrencyCode AS paymentCurrencyCode,sel.amountRemaining AS amountRemaining,sel.xCurrRate AS xCurrRate,sel.withheldAmount AS withheldAmount,sel.discountAmount AS discountAmount,sel.paymentAmount AS paymentAmount,sel.pprStatusCode AS pprStatusCode FROM sel WHERE sel.okToPayFlag = 'Y' AND sel.originalInvoiceId IS NULL AND sel.originalPaymentNumber IS NULL AND sel.pprName NOT IN (SELECT run.pprName FROM run)\"          }        ],        \"select\": \"{select_statement}\",        \"return\": [          {            \"name\": \"paymentCurrencyCode\",            \"type\": \"string\"          },          {            \"name\": \"selectedInstallments\",            \"type\": \"int64\"          },          {            \"name\": \"amountRemaining\",            \"type\": \"string\"          },          {            \"name\": \"withheldAmount\",            \"type\": \"string\"          },          {            \"name\": \"discountAmount\",            \"type\": \"string\"          },          {            \"name\": \"paymentAmount\",            \"type\": \"string\"          },          {            \"name\": \"interestAmount\",            \"type\": \"string\"          },          {            \"name\": \"totalAmount\",            \"type\": \"string\"          }        ]      },      \"selectExamples\": [        {          \"name\": \"currencySummaryByPprOracleSafe\",          \"description\": \"Currency-level deduplicated PPR installment summary with Oracle-safe UNION datatypes and pre-aggregated interest.\",          \"outputFields\": [            \"paymentCurrencyCode\",            \"selectedInstallments\",            \"amountRemaining\",            \"withheldAmount\",            \"discountAmount\",            \"paymentAmount\",            \"interestAmount\",            \"totalAmount\"          ],          \"select\": \"SELECT paymentCurrencyCode,selectedInstallments,amountRemaining,withheldAmount,discountAmount,paymentAmount,interestAmount,totalAmount FROM ( SELECT paymentCurrencyCode,SUM(dedupedCount) AS selectedInstallments,SUM(NVL(amountRemaining,0)) AS amountRemaining,SUM(NVL(withheldAmount,0)) AS withheldAmount,SUM(NVL(discountAmount,0)) AS discountAmount,SUM(NVL(paymentAmount,0)) AS paymentAmount,SUM(NVL(interestAmount,0)) AS interestAmount,SUM(NVL(paymentAmount,0)) + SUM(NVL(interestAmount,0)) AS totalAmount FROM ( SELECT TO_CHAR(filteredSelectedInvoiceInstallments.invoiceId) AS invoiceId,TO_CHAR(filteredSelectedInvoiceInstallments.installmentNumber) AS installmentNumber,filteredSelectedInvoiceInstallments.supplierName AS supplierName,filteredSelectedInvoiceInstallments.paymentCurrencyCode AS paymentCurrencyCode,NVL(filteredSelectedInvoiceInstallments.amountRemaining,0) * NVL(filteredSelectedInvoiceInstallments.xCurrRate,1) AS amountRemaining,NVL(filteredSelectedInvoiceInstallments.withheldAmount,0) AS withheldAmount,NVL(filteredSelectedInvoiceInstallments.discountAmount,0) AS discountAmount,NVL(filteredSelectedInvoiceInstallments.paymentAmount,0) AS paymentAmount,0 AS interestAmount,1 AS dedupedCount FROM filteredSelectedInvoiceInstallments WHERE filteredSelectedInvoiceInstallments.pprName IN (<PPR_NAME_FROM_USER>) UNION ALL SELECT TO_CHAR(run.invoiceId) AS invoiceId,TO_CHAR(run.installmentNumber) AS installmentNumber,run.supplierName AS supplierName,run.paymentCurrencyCode AS paymentCurrencyCode,NVL(run.amountRemaining,0) AS amountRemaining,NVL(run.withheldAmount,0) AS withheldAmount,NVL(run.discountAmount,0) AS discountAmount,NVL(run.paymentAmount,0) AS paymentAmount,0 AS interestAmount,1 AS dedupedCount FROM run WHERE run.pprName IN (<PPR_NAME_FROM_USER>) UNION ALL SELECT TO_CHAR(filteredSelectedInvoiceInstallments.invoiceId) AS invoiceId,TO_CHAR(filteredSelectedInvoiceInstallments.installmentNumber) AS installmentNumber,filteredSelectedInvoiceInstallments.supplierName AS supplierName,filteredSelectedInvoiceInstallments.paymentCurrencyCode AS paymentCurrencyCode,0 AS amountRemaining,0 AS withheldAmount,0 AS discountAmount,0 AS paymentAmount,NVL(selInterest.interestPaymentAmount,0) AS interestAmount,1 AS dedupedCount FROM filteredSelectedInvoiceInstallments,selInterest WHERE TO_CHAR(selInterest.checkrunId) = TO_CHAR(filteredSelectedInvoiceInstallments.checkrunId) AND TO_CHAR(selInterest.originalInvoiceId) = TO_CHAR(filteredSelectedInvoiceInstallments.invoiceId) AND TO_CHAR(selInterest.originalPaymentNumber) = TO_CHAR(filteredSelectedInvoiceInstallments.installmentNumber) AND filteredSelectedInvoiceInstallments.pprName IN (<PPR_NAME_FROM_USER>) ) GROUP BY paymentCurrencyCode ORDER BY totalAmount DESC ) WHERE ROWNUM<=20\",          \"return\": [            {              \"name\": \"paymentCurrencyCode\",              \"type\": \"string\"            },            {              \"name\": \"selectedInstallments\",              \"type\": \"int64\"            },            {              \"name\": \"amountRemaining\",              \"type\": \"string\"            },            {              \"name\": \"withheldAmount\",              \"type\": \"string\"            },            {              \"name\": \"discountAmount\",              \"type\": \"string\"            },            {              \"name\": \"paymentAmount\",              \"type\": \"string\"            },            {              \"name\": \"interestAmount\",              \"type\": \"string\"            },            {              \"name\": \"totalAmount\",              \"type\": \"string\"            }          ],          \"notes\": \"Use this example as the binding pattern for currencySummaryByPpr. It mirrors the selected-invoice review extraction: the AP selected branch is filtered to okToPayFlag = 'Y', originalInvoiceId IS NULL, originalPaymentNumber IS NULL, and is excluded when the same PPR already appears in the payment-run branch; payment-run rows are then unioned with a separate selected-interest branch. Keep TO_CHAR on invoiceId and installmentNumber across branches, use SUM(dedupedCount) for selectedInstallments, and prefer adapting the PPR-name predicates to TO_CHAR(checkrunId) only when a reliable PPR ID/checkrunId is available.\"        }      ],      \"businessDrivers\": [        {          \"name\": \"currencySummaryByPpr\",          \"description\": \"Primary default currency-summary package for PPR installment review.\",          \"when\": \"User asks to review installments for a PPR without explicitly requesting line-level details. Use this by default for generic review, unresolved lifecycle stage, mixed-source status CANCELING or TERMINATED, or any request that could span AP and IBY rows.\",          \"fieldsToReturn\": [            \"paymentCurrencyCode\",            \"selectedInstallments\",            \"amountRemaining\",            \"withheldAmount\",            \"discountAmount\",            \"paymentAmount\",            \"interestAmount\",            \"totalAmount\"          ],          \"extraFilterExpressions\": [            \"TO_CHAR(sel.checkrunId) IN (<PPR_ID_FROM_USER>) when PPR ID is available; otherwise sel.pprName IN (<PPR_NAME_FROM_USER>)\",            \"TO_CHAR(run.checkrunId) IN (<PPR_ID_FROM_USER>) when PPR ID is available; otherwise run.pprName IN (<PPR_NAME_FROM_USER>)\"          ],          \"notes\": \"Generate a select that mirrors the selected-invoice review extraction: first use the AP selected rows with okToPayFlag = 'Y', originalInvoiceId IS NULL, originalPaymentNumber IS NULL, and a branch gate that excludes those AP rows when the same PPR already appears in the payment-run branch; then UNION ALL the payment-run rows and a selected-interest branch matched by checkrunId, invoiceId, and installmentNumber. Group by paymentCurrencyCode. Map X_CURR_RATE to crossCurrencyRate/xCurrRate and compute amountRemaining as SUM(NVL(amountRemaining,0)*NVL(xCurrRate,1)); skip ap_round_currency. If the user filters by a mixed-source status, apply pprStatusCode in ('CANCELING','TERMINATED') inside applicable source branches before the UNION ALL. Final output columns should be paymentCurrencyCode,selectedInstallments,amountRemaining,withheldAmount,discountAmount,paymentAmount,interestAmount,totalAmount, where selectedInstallments = SUM(dedupedCount) and totalAmount = paymentAmount + interestAmount. Sort grouped summaries by projected aggregate aliases such as totalAmount, not by repeating SUM(...) expressions in ORDER BY. The query must end with where ROWNUM<=20.\"        },        {          \"name\": \"supplierSummaryByPpr\",          \"description\": \"Primary supplier summary with selected installment count and selected-invoice review amounts for a PPR.\",          \"when\": \"User asks which suppliers have the most installments, which suppliers are involved, or requests supplier counts with total value for a PPR without explicitly requiring an AP-only or IBY-only source.\",          \"fieldsToReturn\": [            \"supplierName\",            \"paymentCurrencyCode\",            \"selectedInstallments\",            \"amountRemaining\",            \"withheldAmount\",            \"discountAmount\",            \"paymentAmount\",            \"interestAmount\",            \"totalAmount\"          ],          \"extraFilterExpressions\": [            \"TO_CHAR(sel.checkrunId) IN (<PPR_ID_FROM_USER>) when PPR ID is available; otherwise sel.pprName IN (<PPR_NAME_FROM_USER>)\",            \"TO_CHAR(run.checkrunId) IN (<PPR_ID_FROM_USER>) when PPR ID is available; otherwise run.pprName IN (<PPR_NAME_FROM_USER>)\"          ],          \"notes\": \"Generate a select that normalizes both sources with the same selected-branch gate and interest branch as currencySummaryByPpr, then groups by supplierName and paymentCurrencyCode. Reuse the same measure calculations as currencySummaryByPpr: selectedInstallments = SUM(dedupedCount), amountRemaining = SUM(NVL(amountRemaining,0)*NVL(xCurrRate,1)) for selected rows and SUM(NVL(amountRemaining,0)) for payment-run rows, withheldAmount = SUM(NVL(withheldAmount,0)), discountAmount = SUM(NVL(discountAmount,0)), paymentAmount = SUM(NVL(paymentAmount,0)), interestAmount = SUM(NVL(interestAmount,0)), and totalAmount = paymentAmount + interestAmount. Final output columns should include the grouping columns followed by those measures, and the query must end with where ROWNUM<=20.\"        },        {          \"name\": \"withholdingTaxSummaryByPprAndSupplier\",          \"description\": \"Summary of selected installments under one PPR where withholding tax is applied, grouped by supplier or the closest visible tax-authority/payee value.\",          \"when\": \"User asks for withholding-tax totals, total tax amount withheld, or tax withheld by supplier, tax authority, payee, or similar visible grouping for installments in a PPR.\",          \"fieldsToReturn\": [            \"supplierName\",            \"paymentCurrencyCode\",            \"selectedInstallments\",            \"withheldAmount\"          ],          \"extraFilterExpressions\": [            \"TO_CHAR(sel.checkrunId) IN (<PPR_ID_FROM_USER>) when PPR ID is available; otherwise sel.pprName IN (<PPR_NAME_FROM_USER>)\",            \"TO_CHAR(run.checkrunId) IN (<PPR_ID_FROM_USER>) when PPR ID is available; otherwise run.pprName IN (<PPR_NAME_FROM_USER>)\",            \"withheldAmount>0 after deduplication\"          ],          \"notes\": \"Generate a select that normalizes selected rows and payment-run rows, applies selected-branch base filters and the same selected-branch payment-run gate as currencySummaryByPpr, filters the normalized set to NVL(withheldAmount,0) > 0, then groups by supplierName and paymentCurrencyCode. Final output must include supplierName, paymentCurrencyCode, selectedInstallments, and withheldAmount. Compute selectedInstallments = SUM(dedupedCount) after withholding filtering and withheldAmount = SUM(NVL(withheldAmount,0)). Do not omit selectedInstallments from withholding-tax summaries. If a separate tax-authority field is not exposed, use supplierName as the visible supplier/payee grouping.\"        },        {          \"name\": \"supplierTypeSummaryByPpr\",          \"description\": \"Summary of selected installments under one PPR filtered or grouped by supplier type, category, class, or similar supplier classifier.\",          \"when\": \"User asks for counts or totals for installments under a PPR by supplier type, supplier category, supplier class, or a similar supplier classifier while the lifecycle source is unresolved or mixed-source.\",          \"fieldsToReturn\": [            \"supplierTypeMeaning\",            \"paymentCurrencyCode\",            \"selectedInstallments\",            \"paymentAmount\",            \"interestAmount\",            \"totalAmount\"          ],          \"extraFilterExpressions\": [            \"TO_CHAR(sel.checkrunId) IN (<PPR_ID_FROM_USER>) when PPR ID is available, otherwise sel.pprName IN (<PPR_NAME_FROM_USER>); project NULL AS supplierTypeLookupCode and NULL AS supplierTypeMeaning\",            \"TO_CHAR(run.checkrunId) IN (<PPR_ID_FROM_USER>) when PPR ID is available, otherwise run.pprName IN (<PPR_NAME_FROM_USER>); add run.supplierTypeLookupCode='<SUPPLIER_TYPE_CODE_FROM_USER>' when a supplier type code filter is requested\",            \"TO_CHAR(run.checkrunId) IN (<PPR_ID_FROM_USER>) when PPR ID is available, otherwise run.pprName IN (<PPR_NAME_FROM_USER>); add run.supplierTypeMeaning='<SUPPLIER_TYPE_MEANING_FROM_USER>' when only the supplier type meaning is available\"          ],          \"notes\": \"Supplier type is branch-scoped in this extraction because the AP selected-installment branch does not expose the classifier. Keep the deduplicated PPR installment summary shape as the population owner, project NULL supplier type aliases in branches that do not expose them, apply mandatory supplier-type predicates where the alias is populated, deduplicate by invoiceId and installmentNumber, and then group by the requested supplier-type and currency dimensions.\"        }      ],      \"additionalInstructions\": [        \"Use this extraction as the primary summary source for selected-installment review under a PPR.\",        \"For a plain 'review installments for PPR' request, choose this shape before selectedPaymentInstallments, paymentRunInstallments, payablesSelectedInstallmentsSummary, or raw detail BVs.\",        \"Do not use this deduplicated summary when the PPR status maps to a single source. AP-only statuses must use selectedPaymentInstallments, and IBY-only statuses must use paymentRunInstallments.\",        \"Use this deduplicated summary when the status is unknown, the request spans AP and IBY statuses, or the requested status is mixed-source such as CANCELING or TERMINATED.\",        \"Do not replace this deduplicated population with selectedPaymentInstallments, paymentRunInstallments, or raw detail BVs solely because one source exposes an extra classifier. Use a source-specific shape only when the user explicitly asks for that source, when the PPR status resolves to one lifecycle source, or when the requested output is inherently source-specific.\",        \"For branch-scoped filters such as supplier type or supplier category, project NULL aliases in branches that do not expose the classifier, project the real aliases in branches that do, and apply the mandatory predicate without inventing fields for unsupported branches.\",        \"Any review-installments summary select generated from this shape must return the selected-invoice review measures: selectedInstallments, amountRemaining, withheldAmount, discountAmount, paymentAmount, interestAmount, and totalAmount.\",        \"Use totalAmount as paymentAmount plus interestAmount only; do not include amountRemaining, withheldAmount, or discountAmount in totalAmount.\",        \"Compute amountRemaining as amountRemaining multiplied by crossCurrencyRate/xCurrRate with NVL(...,1), and do not use ap_round_currency.\",        \"For AP selected rows, map originalInvoiceTransaction.invoiceId to the SQL alias originalInvoiceId, originalPaymentNumber to originalPaymentNumber, and payment_num/installmentNumber to installmentNumber.\",        \"For unresolved-source review, apply the tested selected-branch gate: include AP selected rows only when the same PPR is not already present in the payment-run branch, then UNION ALL the payment-run rows and selected-interest rows.\",        \"For payment-run rows, map sourceProductFirstUniqueIdentifier to checkrunId so payment-run data groups with the AP selected-invoice CHECKRUN_ID.\",        \"For interest, match selected interest rows back to the base row with checkrunId, invoiceId, and installmentNumber, then use the interest row paymentAmount.\",        \"Customize the extraction select and return schema for the requested summary driver; do not create separate shape definitions for each summary grouping.\",        \"Do not replace the deduplication stage with raw COUNT(*), COUNT(DISTINCT invoiceId), or COUNT(DISTINCT installmentNumber); use SUM(dedupedCount) over the normalized selected/payment-run/interest stream.\",        \"For withholding-tax summaries, filter the deduplicated business-installment set to withheldAmount > 0, group by supplierName and paymentCurrencyCode unless the user asks for a different supported grouping, and always include selectedInstallments with withheldAmount.\",        \"Keep payment amounts numeric in SQL and return currency as its own column.\",        \"Use payeeParty.name as the payment-run supplier value because it is the shortest declared supplier-facing path on paymentRunInstallments.\",        \"When both PPR name and PPR ID/checkrunId are available, filter by TO_CHAR(checkrunId) in every branch instead of filtering by pprName. Use pprName only when the ID is unavailable.\",        \"For currencySummaryByPpr, prefer selectExamples.currencySummaryByPprOracleSafe as the binding SQL pattern. Keep branch datatypes stable with TO_CHAR on invoiceId and installmentNumber, and keep the selected-branch payment-run exclusion predicate aligned to the PPR filter.\"      ]    },    \"paymentRunInstallmentSummaries\": {      \"key\": \"paymentRunInstallmentSummaries\",      \"name\": \"paymentRunInstallmentSummaries\",      \"type\": \"AV\",      \"shapeRole\": \"summary\",      \"module\": \"oraErpCorePaymentsFundsDisbursement\",      \"businessObject\": null,      \"api\": \"analyticviews/ora/erpCore/paymentsFundsDisbursement/v1/paymentRunInstallmentSummaries\",      \"description\": \"Use this AV shape to summarize payment-run installment amounts, counts, and lifecycle status by PPR, supplier, payee, currency, business unit, legal entity, due date, payment date, payment method, payment format, payment process profile, bank account, document status, payment status, and payment-instruction status. It is the right shape for grouped payment-run installment analytics after installments have entered Oracle Payments, before drilling into row-level paymentRunInstallments details.\",      \"exampleQuestions\": [        \"Summarize the top suppliers by value in this payment run.\",        \"What is the total cash outflow for this PPR across all payment currencies?\",        \"List the top 5 payees by value in this run and their percentage of the total batch amount.\",        \"Show payment-run installment totals by bank account and payment currency.\",        \"Show me the distribution of payment amounts by business unit in this PPR.\",        \"Display payments grouped by bank account so I can verify we have sufficient funds in each.\",        \"Which suppliers represent 80% of the total payment value in this PPR?\",        \"Show me all payments over 100000 with supplier details and invoice references.\",        \"How many invoices, payments, and payment instructions were generated for this PPR?\",        \"Show the payment-run installment value by document status and payment status.\",        \"If I remove Supplier X from this run, how much payment value would be excluded?\",        \"Which payment formats or payment methods account for this run's installment value?\"      ],      \"fields\": {        \"measures\": [          \"paymentAmount\",          \"withheldAmount\",          \"discount\",          \"invoices\",          \"paymentRuns\",          \"payments\",          \"paymentInstructions\",          \"installmentPayments\",          \"installmentPaymentAmount\"        ],        \"dimensions\": [          {            \"name\": \"paymentProcessRequest\",            \"attributes\": [              {                \"name\": \"paymentProcessRequestId\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"name\",                \"searchable\": true              }            ],            \"hierarchies\": [              {                \"name\": \"paymentProcessRequestHierarchy\",                \"levels\": [                  \"PAYMENTPROCESSREQUEST\"                ]              }            ]          },          {            \"name\": \"paymentProcessRequestStatus\",            \"attributes\": [              {                \"name\": \"paymentProcessRequestStatusCode\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"paymentProcessRequestStatus\"              }            ],            \"hierarchies\": [              {                \"name\": \"paymentProcessRequestStatusHierarchy\",                \"levels\": [                  \"PAYMENTPROCESSREQUESTSTATUS\"                ]              }            ]          },          {            \"name\": \"paymentFormat\",            \"attributes\": [              {                \"name\": \"paymentFormatCode\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"paymentFormatName\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"templateCode\",                \"sortable\": true              }            ],            \"hierarchies\": [              {                \"name\": \"paymentFormatHierarchy\",                \"levels\": [                  \"PAYMENTFORMAT\"                ]              }            ]          },          {            \"name\": \"paymentDate\",            \"attributes\": [              {                \"name\": \"dayOfWeek\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"dayName\",                \"sortable\": true,                \"searchab