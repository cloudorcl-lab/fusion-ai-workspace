ntProfile.paymentLogicalGroupingRule.groupBySettlemntPriorityFlag\",          \"accountPaymentProfile.systemPaymentProfile.paymentLogicalGroupingRule.groupByServiceLevelFlag\",          \"accountPaymentProfile.systemPaymentProfile.paymentLogicalGroupingRule.groupByBankChargeBearerFlag\",          \"accountPaymentProfile.systemPaymentProfile.paymentLogicalGroupingRule.groupByUltimateDebtorFlag\",          \"accountPaymentProfile.systemPaymentProfile.paymentLogicalGroupingRule.groupByCategoryPurposeFlag\",          \"disbursementInboundFile.fileName\",          \"disbursementInboundFile.timeCreated\",          \"disbursementInboundFile.errorMessage\",          \"disbursementInboundFile.paymentSystem.paymentSystemName\",          \"disbursementInboundFile.inboundFileProcessingStatus.lookupCode\",          \"disbursementInboundFile.inboundFileProcessingStatus.meaning\",          \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",          \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",          \"paymentProcessOrganizations.objectId\",          \"paymentProcessOrganizations.objectType\",          \"paymentProcessOrganizations.organizationType\",          \"paymentProcessOrganizations.businessUnitId\",          \"paymentInstrument.paymentInstrumentAlias\",          \"paymentInstrument.bank.name\",          \"bankAccount.id\",          \"bankAccount.name\"        ],        \"accessors\": {          \"paymentFileProcessingStatus\": {            \"shape\": \"Lookup\",            \"fields\": [              \"lookupType\",              \"meaning\",              \"lookupCode\"            ]          },          \"paymentFileConfirmationStatus\": {            \"shape\": \"Lookup\",            \"fields\": [              \"lookupType\",              \"meaning\",              \"lookupCode\"            ]          },          \"organizationType\": {            \"shape\": \"Lookup\",            \"fields\": [              \"lookupType\",             