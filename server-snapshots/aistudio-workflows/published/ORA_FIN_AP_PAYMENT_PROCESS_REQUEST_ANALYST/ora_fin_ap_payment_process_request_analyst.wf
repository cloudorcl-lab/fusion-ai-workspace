"businessUnitHierarchy.ledgerName\",        \"businessUnitHierarchy.profitCenterFlag\",        \"legalEntityHierarchy.ledgerCurrCode\",        \"legalEntityHierarchy.legalEntityCountryCode\",        \"legalEntityHierarchy.legalEntityId\",        \"legalEntityHierarchy.legalEntityIdentifier\",        \"legalEntityHierarchy.legalEntityName\",        \"payablesPaymentStatusHierarchy.payablesPaymentStatusCode\",        \"paymentCurrencyHierarchy.currencyCode\",        \"paymentCurrencyHierarchy.currencyName\",        \"paymentCurrencyHierarchy.enabledFlag\",        \"paymentDateHierarchy.calendarDate\",        \"paymentDateHierarchy.calendarMonthId\",        \"paymentDateHierarchy.calendarWeekId\",        \"paymentDateHierarchy.dayName\",        \"paymentDateHierarchy.dayOfWeek\",        \"paymentSystemStatusHierarchy.paymentSystemStatusCode\",        \"paymentTypeHierarchy.paymentTypeCode\",        \"supplierHierarchy.paymentTermId\",        \"supplierHierarchy.supplierId\",        \"supplierHierarchy.supplierName\",        \"supplierHierarchy.supplierNumber\",        \"supplierHierarchy.supplierSiteId\",        \"supplierHierarchy.supplierSiteName\",        \"supplierHierarchy.supplierType\",        \"supplierHierarchy.supplierTypeMeaning\",        \"supplierTypeHierarchy.paymentTermId\",        \"supplierTypeHierarchy.supplierId\",        \"supplierTypeHierarchy.supplierName\",        \"supplierTypeHierarchy.supplierNumber\",        \"supplierTypeHierarchy.supplierSiteId\",        \"supplierTypeHierarchy.supplierSiteName\",        \"supplierTypeHierarchy.supplierType\",        \"supplierTypeHierarchy.supplierTypeMeaning\"      ],      \"filterConditions\": [        {          \"name\": \"paymentDateHierarchy.calendarDate\",          \"attribute\": \"paymentDateHierarchy.calendarDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for payment summaries for today, yesterday, tomorrow, or a date range.\"        },        {          \"name\": \"businessUnitHierarchy.businessUnitName\",          \"attribute\": \"businessUnitHierarchy.businessUnitName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user groups or filters payment totals by business unit.\"        },        {          \"name\": \"paymentCurrencyHierarchy.currencyCode\",          \"attribute\": \"paymentCurrencyHierarchy.currencyCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for currency-based payment totals.\"        },        {          \"name\": \"supplierHierarchy.supplierName\",          \"attribute\": \"supplierHierarchy.supplierName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user wants payment concentration or supplier-based totals.\"        },        {          \"name\": \"paymentTypeHierarchy.paymentTypeCode\",          \"attribute\": \"paymentTypeHierarchy.paymentTypeCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for totals grouped or filtered by payment type.\"        },        {          \"name\": \"payablesPaymentStatusHierarchy.payablesPaymentStatusCode\",          \"attribute\": \"payablesPaymentStatusHierarchy.payablesPaymentStatusCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for payment-stage or status breakdowns.\"        }      ],      \"dateFilterGuidance\": {        \"description\": \"Use `paymentDateHierarchy.calendarDate` as the default date dimension for payment summary questions.\",        \"patterns\": [          {            \"userRequest\": \"today, yesterday, tomorrow, last week, this month\",            \"clause\": \"apply the date window to paymentDateHierarchy.calendarDate\"          }        ]      },      \"extractionQuery\": null,      \"businessDrivers\": [        {          \"name\": \"paymentValueByBusinessUnit\",          \"description\": \"Summarize payment value by business unit.\",          \"when\": \"User asks for payment totals grouped by business unit.\",          \"fieldsToReturn\": [            \"paidAmount\",            \"numberOfPayments\",            \"businessUnitHierarchy\"          ],          \"extraFilterExpressions\": [],          \"notes\": \"\"        },        {          \"name\": \"paymentConcentrationBySupplier\",          \"description\": \"Show payment concentration by supplier or supplier site.\",          \"when\": \"User asks which suppliers represent a large share of a batch or day.\",          \"fieldsToReturn\": [            \"paidAmount\",            \"numberOfPayments\",            \"supplierHierarchy\"          ],          \"extraFilterExpressions\": [],          \"notes\": \"\"        },        {          \"name\": \"paymentValueByTypeAndStatus\",          \"description\": \"Summarize payment value by payment type, optionally split by payment stage.\",          \"when\": \"User asks for total payment value grouped by payment type or for a payment-stage breakdown for today, yesterday, or a filtered slice.\",          \"fieldsToReturn\": [            \"paidAmount\",            \"numberOfPayments\",            \"paymentTypeHierarchy\",            \"payablesPaymentStatusHierarchy\"          ],          \"extraFilterExpressions\": [],          \"notes\": \"When the user also names a PPR, identify the payment ids or row slice with payablesPaymentDetails first, then aggregate externally.\"        },        {          \"name\": \"supplierPaymentHistory\",          \"description\": \"Summarize a supplier's payment history over a recent date range.\",          \"when\": \"User asks for payment history or payment totals for one supplier over the last N days, weeks, or months.\",          \"fieldsToReturn\": [            \"paidAmount\",            \"numberOfPayments\",            \"supplierHierarchy\",            \"paymentDateHierarchy\",            \"paymentCurrencyHierarchy\"          ],          \"extraFilterExpressions\": [],          \"notes\": \"Use paymentDateHierarchy.calendarDate for the rolling date window.\"        },        {          \"name\": \"cashFlowVarianceVsLastWeek\",          \"description\": \"Compare today's payment cash flow with the average daily outflow from the previous week.\",          \"when\": \"User asks for today's cash flow versus the average of last week or requests a variance against a recent baseline.\",          \"fieldsToReturn\": [            \"paidAmount\",            \"numberOfPayments\",            \"paymentDateHierarchy\",            \"paymentCurrencyHierarchy\",            \"businessUnitHierarchy\"          ],          \"extraFilterExpressions\": [],          \"notes\": \"Fetch one slice for today and one slice for the prior-week window, then compute the average and variance outside the base AV fetch.\"        }      ],      \"additionalInstructions\": [        \"Use this summary shape for grouped totals and trends. The OpenAPI contract exposes hierarchy objects, so group and filter using hierarchy attributes such as `businessUnitHierarchy.businessUnitName`, `supplierHierarchy.supplierName`, and `paymentDateHierarchy.calendarDate`.\",        \"When the user gives a payment process request name or asks for a named batch summary, use payablesPaymentDetails or PayablesPaymentProcessRequestDetails to identify the relevant slice first; this AV does not expose a direct PPR dimension.\",        \"Use `paymentTypeHierarchy.paymentTypeCode` for payment-type analysis; the published AV does not expose a `paymentMethodHierarchy` dimension.\",        \"Drill into payablesPaymentDetails when the user needs row-level payment detail.\"      ]    },    \"payablesBalances\": {      \"key\": \"payablesBalances\",      \"name\": \"payablesBalances\",      \"type\": \"AV\",      \"shapeRole\": \"summary\",      \"module\": \"oraErpCorePayablesInvoices\",      \"businessObject\": null,      \"api\": \"analyticviews/ora/erpCore/payablesInvoices/v1/payablesBalances\",      \"description\": \"Use this AV shape to summarize open payables installment balances and near-term cash requirements by due date, business unit, supplier, currency, aging, invoice type, discount availability, and payment readiness. It is the right shape for upcoming-payment exposure, unpaid-balance rollups, aging analysis, credit-memo availability, and discount-opportunity summaries before a payment run is built.\",      \"exampleQuestions\": [        \"What is the total cash requirement for tomorrow?\",        \"What are the installments scheduled in the next week by business unit?\",        \"What is the total value of installments due in the next 48 hours across all business units?\",        \"Show me tomorrow's scheduled payments and the summary.\",        \"Show me all installments for Supplier ABC that are eligible for an early payment discount this week.\",        \"How many overdue installments do we have by aging bucket and supplier type?\",        \"I need to submit a payment run for all overdue invoices for <Supplier> in <Business Unit> using EFT. Before that, check if there are unapplied prepayments or credit memos available for <Supplier>\"      ],      \"fields\": {        \"measures\": [          \"invoiceRemainingAmount\",          \"amountRemaining\",          \"paymentTermDiscountAmount\",          \"dynamicDiscountAmount\",          \"countInstallments\"        ],        \"dimensions\": [          {            \"name\": \"legalEntity\",            \"attributes\": [              {                \"name\": \"legalEntityName\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"legalEntityCountryCode\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"legalEntityIdentifier\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"legalEntityId\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"ledgerCurrCode\",                \"sortable\": true,                \"searchable\": true              }            ],            \"hierarchies\": [              {                \"name\": \"legalEntityHierarchy\",                \"levels\": [                  \"LEGALENTITY\"                ]              }            ]          },          {            \"name\": \"businessUnit\",            \"attributes\": [              {                \"name\": \"profitCenterFlag\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"ledgerName\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"businessUnitId\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"businessUnitName\",                \"sortable\": true,                \"searchable\": true              }            ],            \"hierarchies\": [              {                \"name\": \"businessUnitHierarchy\",                \"levels\": [                  \"BUSINESSUNIT\"                ]              }            ]          },          {            \"name\": \"overdueIndicator\",            \"attributes\": [              {                \"name\": \"overdueCode\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"overdue\",                \"sortable\": true,                \"searchable\": true              }            ],            \"hierarchies\": [              {                \"name\": \"overdueIndicatorHierarchy\",                \"levels\": [                  \"OVERDUE\"                ]              }            ]          },          {            \"name\": \"invoiceCurrency\",            \"attributes\": [              {                \"name\": \"currencyCode\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"enabledFlag\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"currencyName\",                \"sortable\": true,                \"searchable\": true              }            ],            \"hierarchies\": [              {                \"name\": \"invoiceCurrencyHierarchy\",                \"levels\": [                  \"CURRENCYCODE\"                ]              }            ]          },          {            \"name\": \"supplierSite\",            \"attributes\": [              {                \"name\": \"country\"              },              {                \"name\": \"supplierType\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"paymentTerm\"              },              {                \"name\": \"partyId\"              },              {                \"name\": \"supplierNumber\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"oneTimeFlag\"              },              {                \"name\": \"supplierSiteId\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"supplierTypeMeaning\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"partyNumber\"              },              {                \"name\": \"supplierName\",                \"sortable\": true,            