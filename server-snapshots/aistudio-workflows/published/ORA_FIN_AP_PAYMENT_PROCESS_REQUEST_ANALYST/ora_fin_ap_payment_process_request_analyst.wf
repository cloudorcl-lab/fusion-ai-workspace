ke Discount\": \"invoiceTransaction<Invoice>.supplierSite.alwaysTakeDiscount\",          \"Pay Date Basis Code\": \"invoiceTransaction<Invoice>.supplierSite.payDateBasisCode\",          \"Invoice Payment Status Code\": \"invoiceTransaction.paymentStatusCode.lookupCode\",          \"Invoice Payment Status\": \"invoiceTransaction.paymentStatusCode.meaning\",          \"Validation Status Code\": \"invoiceTransaction.validationStatus.lookupCode\",          \"Validation Status\": \"invoiceTransaction.validationStatus.meaning\",          \"Approval Status Code\": \"invoiceTransaction.approvalStatus.lookupCode\",          \"Approval Status\": \"invoiceTransaction.approvalStatus.meaning\",          \"Funds Status Code\": \"invoiceTransaction.fundsStatus.lookupCode\",          \"Funds Status\": \"invoiceTransaction.fundsStatus.meaning\",          \"PPR Id\": \"paymentProcessRequest.checkrunId\",          \"PPR Name\": \"paymentProcessRequest.checkrunName\",          \"Payment Method Code\": \"paymentMethod.code\",          \"Payment Method\": \"paymentMethod.paymentMethodName\",          \"Payment Mode Code\": \"paymentMethod.paymentMode.lookupCode\",          \"Payment Mode\": \"paymentMethod.paymentMode.meaning\",          \"Bank\": \"externalBankAccount.maskedAccountNumber\",          \"Financing Option Type\": \"financeProgram.financingOptionTypeCode\",          \"Financing Offer Response Date\": \"financeProgramOffer.responseDate\"        }      },      \"fieldSelection\": {        \"base\": [          \"invoiceTransaction.invoiceNumber\",          \"installmentNumber\",          \"dueDate\",          \"unpaidAmount\",          \"installmentAmount\",          \"invoiceTransaction.invoiceCurrency.currencyCode\",          \"remitToSupplierName\",          \"onHoldFlag\"        ],        \"optional\": [          \"invoiceId\",          \"firstDiscountDate\",          \"firstDiscountAmount\",          \"secondDiscountDate\",          \"secondDiscountAmount\",          \"thi