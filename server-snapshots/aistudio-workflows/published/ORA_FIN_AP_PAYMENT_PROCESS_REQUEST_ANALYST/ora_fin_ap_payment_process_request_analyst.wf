     \"paymentRunInstallments\",      \"paymentRunInstallmentsExtraction\",      \"disbursementPayments\",      \"disbursementPaymentsExtraction\",      \"paymentRunCriteria\",      \"paymentRunCriteriaExtraction\"    ],    \"ppr.reviewPPRRejectedInstallments\": [      \"PayablesPaymentProcessRequestDetails\",      \"paymentRunExceptionsSummaries\",      \"paymentRunInstallments\",      \"paymentRunInstallmentsExtraction\",      \"paymentRunInstallmentExceptions\",      \"paymentRunInstallmentExceptionsExtraction\",      \"unselectedPaymentInstallments\",      \"unselectedPaymentInstallmentsExtraction\",      \"documentValidationErrors\",      \"documentValidationErrorsExtraction\",      \"invoiceInstallmentDetails\"    ],    \"ppr.reviewPPRRejectedPayments\": [      \"PayablesPaymentProcessRequestDetails\",      \"disbursementPaymentExceptions\",      \"disbursementPaymentExceptionsExtraction\",      \"disbursementPaymentInstructionExceptions\",      \"disbursementPaymentInstructionExceptionsExtraction\",      \"bankRejectedInstallmentsOnHold\"    ],    \"ppr.reviewPPRSelectedInstallments\": [      \"payablesSelectedInstallmentsSummary\",      \"pprInstallmentsDeduplicatedSummary\",      \"pprInstallmentsDeduplicatedDetails\",      \"selectedPaymentInstallments\",      \"selectedPaymentInstallmentsExtraction\",      \"payablesInvoicePaymentDetails\",      \"payablesInvoicePaymentSummaries\",      \"invoiceInstallmentDetails\"    ],    \"ppr.reviewPPRTemplatesAndSchedules\": [      \"payablesPaymentProcessRequestTemplateLists\",      \"payablesPaymentProcessRequestTemplateListExtraction\",      \"payablesPaymentScheduleDetailExtraction\",      \"payablesBalances\"    ],    \"ppr.reviewPPRUnselectedInstallments\": [      \"unselectedPaymentInstallments\",      \"unselectedPaymentInstallmentsExtraction\",      \"invoiceInstallmentDetails\"    ],    \"ppr.reviewUpcomingSchedulesForPaymentRuns\": [      \"payablesBalances\",      \"invoiceInstallmentDetails\",      \"payablesPaymentScheduleDetailExtraction\",      \"payablesPaymentProcessRequestTemplateLists\"    ],    \"ppr.summarizePPRExceptions\": [      \"PayablesPaymentProcessRequestDetails\",      \"paymentRunExceptionsSummaries\",      \"paymentRunInstallmentSummaries\",      \"paymentRunInstallmentExceptionsExtraction\",      \"documentValidationErrorsExtraction\",      \"disbursementPaymentExceptionsExtraction\",      \"disbursementPaymentInstructionExceptionsExtraction\",      \"paymentRunCriteria\"    ],    \"ppr.summarizePPRRejections\": [      \"PayablesPaymentProcessRequestDetails\",      \"unselectedPaymentInstallments\",      \"unselectedPaymentInstallmentsExtraction\",      \"disbursementPaymentExceptionsExtraction\",      \"disbursementPaymentInstructionExceptionsExtraction\"    ],    \"ppr.viewPaymentProcessRequestDetails\": [      \"PayablesPaymentProcessRequestDetails\",      \"paymentRunCriteria\",      \"paymentRunCriteriaExtraction\",      \"paymentRunInstallmentsExtraction\",      \"disbursementPaymentsExtraction\"    ],    \"payablesInvoice.answerInstallmentDrilldownQuestions\": [      \"payablesPaymentScheduleDetailExtraction\",      \"invoiceInstallmentDetails\"    ],    \"payablesInvoice.showCreditMemosBySupplierAging\": [      \"creditMemosBySupplierAging\"    ]  }"
