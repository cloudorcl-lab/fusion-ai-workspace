    ]              }            ]          },          {            \"name\": \"dueDate\",            \"attributes\": [              {                \"name\": \"calendarDate\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"calendarYear\"              },              {                \"name\": \"calendarQuarter\"              },              {                \"name\": \"calendarMonth\"              },              {                \"name\": \"calendarWeek\"              },              {                \"name\": \"dayOfMonth\"              }            ],            \"hierarchies\": [              {                \"name\": \"dueDateToYearHierarchy\",                \"levels\": [                  \"DAY\",                  \"MONTH\",                  \"QUARTER\",                  \"YEAR\"                ]              },              {                \"name\": \"dueDateWeekToYearHierarchy\",                \"levels\": [                  \"DAY\",                  \"WEEK\",                  \"YEAR\"                ]              }            ]          },          {            \"name\": \"paymentDate\",            \"attributes\": [              {                \"name\": \"calendarDate\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"calendarYear\"              },              {                \"name\": \"calendarQuarter\"              },              {                \"name\": \"calendarMonth\"              },              {                \"name\": \"calendarWeek\"              },              {                \"name\": \"dayOfMonth\"              }            ],            \"hierarchies\": [              {                \"name\": \"paymentDateToYearHierarchy\",                \"levels\": [                  \"DAY\",                  \"MONTH\",                  \"QUARTER\",                  \"YEAR\"     