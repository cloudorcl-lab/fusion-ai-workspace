        {
          "metadata": {
            "name": "Construct output for Plan mode",
            "returnType": "array",
            "sourceCode": "let rawOutput = $context?.$nodes?.FIN_AP_LOOP_EXECUTOR?.$output;\n\nlet output = rawOutput?.results || rawOutput?.result || rawOutput || [];\n\nif (!Array.isArray(output)) {\n  output = [output];\n}\n\noutput = output.map(e => {\n  return {\n    type: \"table\",\n    heading: \"Selected Installments Summary\",\n    content: [\n      {\n        testColumn: \"test\"\n      }\n    ],\n    contextData: (e?.result?.result?? e?.result) || e,\n    fields: [\"test\"],\n    fieldAlias: {\n      test: \"test\"\n    }\n  };\n});\n\nreturn output;"
          },
