e\",                \"fields\": [                  \"systemProfileCode\"                ],                \"accessors\": {                  \"paymentFileCreationRule\": {                    \"shape\": \"PaymentFileCreationRule\",                    \"fields\": [                      \"systemProfileCode\",                      \"currencyCode\",                      \"paymentFileMaximumAmount\",                      \"numberOfPayments\",                      \"groupByPaymentDateFlag\",                      \"groupByPaymentCurrencyFlag\",                      \"groupByDisbursementBankAccountFlag\",                      \"groupByTotalPaymentsFlag\",                      \"groupByPaymentProcessRequestFlag\",                      \"groupByFirstPartyLegalEntityFlag\",                      \"groupByBillsPayableFlag\",                      \"groupByBusinessUnitFlag\",                      \"groupByPaymentFileMaximumAmountFlag\",                      \"groupByPaymentFunctionFlag\",                      \"groupByPaymentReasonFlag\",                      \"groupByRegionalFinancialCenterFlag\",                      \"groupByPaymentMethod\"                    ]                  },                  \"paymentSystem\": {                    \"shape\": \"PaymentSystem\",                    \"fields\": [                      \"id\",                      \"paymentSystemName\"                    ]                  },                  \"paymentFormat\": {                    \"shape\": \"PaymentFormat\",                    \"fields\": [                      \"paymentFormatCode\",                      \"formatTemplateCode\",                      \"formatName\"                    ],                    \"accessors\": {                      \"formatType\": {                        \"shape\": \"PaymentFormatType\",                        \"fields\": [                          \"code\",                          \"reportPath\",                          \"formatTypeName\",                          \"description\"                        ]                      }                    }                  },                  \"processingType\": {                    \"shape\": \"Lookup\",                    \"fields\": [                      \"lookupType\",                      \"meaning\",                      \"lookupCode\"                    ]                  },                  \"paymentRemitAdviceSetup\": {                    \"shape\": \"PaymentRemitAdviceSetup\",                    \"fields\": [                      \"systemProfileCode\",                      \"documentCountLimit\",                      \"allowMultipleCopyFlag\",                      \"sraOverridePayeeFlag\",                      \"automaticSraSubmitFlag\"                    ]                  },                  \"paymentLogicalGroupingRule\": {                    \"shape\": \"PaymentLogicalGroupingRule\",                    \"fields\": [                      \"systemProfileCode\",                      \"groupByPaymentDateFlag\",                      \"groupByInternalBankAccountFlag\",                      \"groupBySettlemntPriorityFlag\",                      \"groupByServiceLevelFlag\",                      \"groupByBankChargeBearerFlag\",                      \"groupByUltimateDebtorFlag\",                      \"groupByCategoryPurposeFlag\"                    ]                  }                }              }            }          },          \"disbursementInboundFile\": {            \"shape\": \"DisbursementInboundFile\",            \"fields\": [              \"id\",              \"fileName\",              \"timeCreated\",              \"errorMessage\"            ],            \"accessors\": {              \"paymentSystem\": {                \"shape\": \"PaymentSystem\",                \"fields\": [                  \"id\",                  \"paymentSystemName\"                ]              },              \"inboundFileProcessingStatus\": {                \"shape\": \"Lookup\",                \"fields\": [                  \"lookupType\",                  \"meaning\",                  \"lookupCode\"                ]              }            }          },          \"paymentsPayablesPaymentProcessRequest\": {            \"shape\": \"PayablesPaymentProcessRequest\",            \"fields\": [              \"paymentProcessRequestId\",              \"paymentProcessRequestName\"            ]          },          \"paymentProcessOrganizations\": {            \"shape\": \"PaymentProcessOrganization\",            \"fields\": [              \"objectId\",              \"objectType\",              \"organizationType\",              \"businessUnitId\"            ]          },          \"paymentInstrument\": {            \"shape\": \"PaymentInstrument\",            \"fields\": [              \"id\",              \"paymentInstrumentAlias\"            ],            \"accessors\": {              \"bank\": {                \"shape\": \"Bank\",                \"fields\": [                  \"id\",                  \"name\"                ]              }            }          },          \"bankAccount\": {            \"shape\": \"BankAccount\",            \"fields\": [              \"id\",              \"name\"            ]          }        },        \"fieldAlias\": {          \"Payment File Id\": \"paymentInstructionId\",          \"Payment File Reference\": \"paymentInstructionId\",          \"Payment Count\": \"paymentCount\",          \"PPR Name\": \"paymentRequestName\",          \"PPR ID\": \"paymentProcessRequestId\",          \"Created By\": \"createdBy\",          \"Created On\": \"timeCreated\",          \"Updated By\": \"updatedBy\",          \"Last Updated On\": \"timeUpdated\",          \"Transmission Date\": \"transmissionDate\",          \"Processing Date\": \"processingDate\",          \"Comments\": \"comments\",          \"Payment Date\": \"paymentDate\",          \"Payment Currency\": \"paymentCurrency\",          \"Bank Status Code\": \"bankStatusCode\",          \"Error Code\": \"errorCode\",          \"Error Message\": \"errorMessage\",          \"Payment Mode Code\": \"paymentModeCode\",          \"Payment File Processing Status Code\": \"paymentFileProcessingStatus.lookupCode\",          \"Payment File Processing Status\": \"paymentFileProcessingStatus.meaning\",          \"Payment File Confirmation Status Code\": \"paymentFileConfirmationStatus.lookupCode\",          \"Payment File Confirmation Status\": \"paymentFileConfirmationStatus.meaning\",          \"Organization Type Code\": \"organizationType.lookupCode\",          \"Organization Type\": \"organizationType.meaning\",          \"Payment Document ID\": \"paymentDocument.id\",          \"Payment Document\": \"paymentDocument.paymentDocument\",          \"First Available Document Number\": \"paymentDocument.firstAvailableDocumentNumber\",          \"Last Available Document Number\": \"paymentDocument.lastAvailableDocumentNumber\",          \"Last Issued Document Number\": \"paymentDocument.lastIssuedDocumentNumber\",          \"Payment Document Category Code\": \"paymentDocument.paymentDocumentCategory.code\",          \"Payment Document Category\": \"paymentDocument.paymentDocumentCategory.name\",          \"Payment Process Profile Id\": \"accountPaymentProfile.paymentProfileId\",          \"Payment Process Profile\": \"accountPaymentProfile.paymentProfileName\",          \"Payment System Account\": \"accountPaymentProfile.paymentSystemAccount.paymentSystemAccountName\",          \"Transmission Configuration Name\": \"accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\",          \"Transmission ID\": \"accountPaymentProfile.paymentTransmissionConfiguration.transmitConfigurationId\",          \"Start Date\": \"accountPaymentProfile.paymentTransmissionConfiguration.startDate\",          \"End Date\": \"accountPaymentProfile.paymentTransmissionConfiguration.endDate\",          \"Transmission Protocol Code\": \"accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmitProtocolCode\",          \"Transmission Protocol Name\": \"accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmissionProtocolName\",          \"System Payment Profile Code\": \"accountPaymentProfile.systemPaymentProfile.systemProfileCode\",          \"Payment File Creation Rule Currency\": \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.currencyCode\",          \"Payment File Maximum Amount\": \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.paymentFileMaximumAmount\",          \"Payment File Rule Payment Count\": \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.numberOfPayments\",          \"Group By Payment Date\": \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByPaymentDateFlag\",          \"Group By Payment Currency\": \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByPaymentCurrencyFlag\",          \"Group By Disbursement Bank Account\": \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByDisbursementBankAccountFlag\",          \"Group By Total Payments\": \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByTotalPaymentsFlag\",          \"Group By Payment Process Request\": \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByPaymentProcessRequestFlag\",          \"Group By First Party Legal Entity\": \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByFirstPartyLegalEntityFlag\",          \"Group By Bills Payable\": \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByBillsPayableFlag\",          \"Group By Business Unit\": \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByBusinessUnitFlag\",          \"Group By Payment File Maximum Amount\": \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByPaymentFileMaximumAmountFlag\",          \"Group By Payment Function\": \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByPaymentFunctionFlag\",          \"Group By Payment Reason\": \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByPaymentReasonFlag\",          \"Group By Regional Financial Center\": \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByRegionalFinancialCenterFlag\",          \"Group By Payment Method\": \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByPaymentMethod\",          \"Payment System\": \"accountPaymentProfile.systemPaymentProfile.paymentSystem.paymentSystemName\",          \"Payment Format Code\": \"accountPaymentProfile.systemPaymentProfile.paymentFormat.paymentFormatCode\",          \"Payment Format\": \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatName\",          \"Format Type\": \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatType.formatTypeName\",          \"Processing Type Code\": \"accountPaymentProfile.systemPaymentProfile.processingType.lookupCode\",          \"Processing Type\": \"accountPaymentProfile.systemPaymentProfile.processingType.meaning\",          \"SRA Document Count Limit\": \"accountPaymentProfile.systemPaymentProfile.paymentRemitAdviceSetup.documentCountLimit\",          \"SRA Multiple Copies Allowed\": \"accountPaymentProfile.systemPaymentProfile.paymentRemitAdviceSetup.allowMultipleCopyFlag\",          \"SRA Override Payee\": \"accountPaymentProfile.systemPaymentProfile.paymentRemitAdviceSetup.sraOverridePayeeFlag\",          \"Automatic SRA Submit\": \"accountPaymentProfile.systemPaymentProfile.paymentRemitAdviceSetup.automaticSraSubmitFlag\",          \"Logical Group By Payment Date\": \"accountPaymentProfile.systemPaymentProfile.paymentLogicalGroupingRule.groupByPaymentDateFlag\",          \"Logical Group By Internal Bank Account\": \"accountPaymentProfile.systemPaymentProfile.paymentLogicalGroupingRule.groupByInternalBankAccountFlag\",          \"Logical Group By Settlement Priority\": \"accountPaymentProfile.systemPaymentProfile.paymentLogicalGroupingRule.groupBySettlemntPriorityFlag\",          \"Logical Group By Service Level\": \"accountPaymentProfile.systemPaymentProfile.paymentLogicalGroupingRule.groupByServiceLevelFlag\",          \"Logical Group By Bank Charge Bearer\": \"accountPaymentProfile.systemPaymentProfile.paymentLogicalGroupingRule.groupByBankChargeBearerFlag\",          \"Logical Group By Ultimate Debtor\": \"accountPaymentProfile.systemPaymentProfile.paymentLogicalGroupingRule.groupByUltimateDebtorFlag\",          \"Logical Group By Category Purpose\": \"accountPaymentProfile.systemPaymentProfile.paymentLogicalGroupingRule.groupByCategoryPurposeFlag\",          \"Acknowledgment File Name\": \"disbursementInboundFile.fileName\",          \"Received Date\": \"disbursementInboundFile.timeCreated\",          \"Acknowledgment Error Message\": \"disbursementInboundFile.errorMessage\",          \"Acknowledgment Payment System\": \"disbursementInboundFile.paymentSystem.paymentSystemName\",          \"Acknowledgment Status Code\": \"disbursementInboundFile.inboundFileProcessingStatus.lookupCode\",          \"Acknowledgment Status\": \"disbursementInboundFile.inboundFileProcessingStatus.meaning\",          \"Linked PPR ID\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",          \"Linked PPR Name\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",          \"Payment Process Organization Object ID\": \"paymentProcessOrganizations.objectId\",          \"Payment Process Organization Object Type\": \"paymentProcessOrganizations.objectType\",          \"Payment Process Organization Type\": \"paymentProcessOrganizations.organizationType\",          \"Payment Process Business Unit ID\": \"paymentProcessOrganizations.businessUnitId\",          \"Payment Instrument Alias\": \"paymentInstrument.paymentInstrumentAlias\",          \"Payment Instrument Bank\": \"paymentInstrument.bank.name\",          \"Bank Account ID\": \"bankAccount.id\",          \"Bank\": \"bankAccount.name\"        }      },      \"fieldSelection\": {        \"base\": [          \"paymentInstructionId\",          \"paymentRequestName\",          \"paymentFileProcessingStatus.meaning\",          \"paymentCount\",          \"paymentDate\",          \"timeCreated\"        ],        \"optional\": [          \"paymentProcessRequestId\",          \"timeUpdated\",          \"transmissionDate\",          \"processingDate\",          \"paymentCurrency\",          \"bankStatusCode\",          \"errorCode\",          \"errorMessage\",          \"paymentFileConfirmationStatus.meaning\",          \"accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\",          \"accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmissionProtocolName\",          \"accountPaymentProfile.systemPaymentProfile.paymentSystem.paymentSystemName\",          \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatName\",          \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByPaymentProcessRequestFlag\",          \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByBusinessUnitFlag\",          \"accountPaymentProfile.systemPaymentProfile.paymentLogicalGroupingRule.groupByServiceLevelFlag\",          \"paymentDocument.paymentDocument\",          \"disbursementInboundFile.fileName\",          \"disbursementInboundFile.inboundFileProcessingStatus.meaning\",          \"bankAccount.name\"        ]      },      \"sortableAttributes\": [        \"paymentInstructionId\",        \"paymentCount\",        \"paymentRequestName\",        \"paymentProcessRequestId\",        \"timeCreated\",        \"timeUpdated\",        \"transmissionDate\",        \"processingDate\",        \"paymentDate\",        \"paymentCurrency\",        \"bankStatusCode\",        \"errorCode\",        \"paymentFileProcessingStatus.lookupCode\",        \"paymentFileProcessingStatus.meaning\",        \"paymentFileConfirmationStatus.lookupCode\",        \"paymentFileConfirmationStatus.meaning\",        \"accountPaymentProfile.paymentTransmissionConfiguration.transmitConfigurationId\",        \"accountPaymentProfile.paymentTransmissionConfiguration.startDate\",        \"accountPaymentProfile.paymentTransmissionConfiguration.endDate\",        \"paymentDocument.paymentDocument\",        \"bankAccount.id\",        \"bankAccount.name\"      ],      \"filterConditions\": [        {          \"name\": \"paymentInstructionId\",          \"attribute\": \"paymentInstructionId\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Filter by payment file id provided by the user input, if present. Use for exact payment-file detail, status, transmission setup, when the user says fetch, show, look up, or details for a specific payment file.\"        },        {          \"name\": \"paymentRequestName\",          \"attribute\": \"paymentRequestName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Filter by PPR name or payment request name when the user provides it.\"        },        {          \"name\": \"paymentProcessRequestId\",          \"attribute\": \"paymentProcessRequestId\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Filter by payment process request id when supplied.\"        },        {          \"name\": \"paymentFileProcessingStatus.lookupCode\",          \"attribute\": \"paymentFileProcessingStatus.lookupCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"ACKNOWLEDGED\",            \"CANCELING\",            \"CREATED\",            \"CREATED_READY_FOR_FORMATTING\",            \"CREATED_READY_FOR_PRINTING\",            \"CREATION_ERROR\",            \"FORMATTED\",            \"FORMATTED_ELECTRONIC\",            \"FORMATTED_READY_FOR_PRINTING\",            \"FORMATTED_READY_TO_TRANSMIT\",            \"FORMATTING_FAILED\",            \"PARTIALLY_ACKNOWLEDGED\",            \"PENDING_ACK\",            \"PENDING_ACTION_ACK_FAILURE\",            \"PRINTED\",            \"PROCESSING_ACK\",            \"REJECTED\",            \"RETRY_CREATION\",            \"SUBMITTED_FOR_PRINTING\",            \"TERMINATED\",            \"TRANSMISSION_FAILED\",            \"TRANSMITTED\",            \"TRANSMITTED_PENDING_ACK\"          ],          \"usage\": \"Use when the user asks for payment files in a processing state such as creation failed, ready to transmit, transmitted, pending acknowledgement, or transmission failed.\"        },        {          \"name\": \"paymentFileConfirmationStatus.lookupCode\",          \"attribute\": \"paymentFileConfirmationStatus.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use only when the user asks about payment-file confirmation status rather than processing status.\"        },        {          \"name\": \"timeCreated\",          \"attribute\": \"timeCreated\",          \"type\": \"datetime\",          \"possibleValues\": [],          \"usage\": \"Use as the default date filter for recent payment-file lists, including failed creation and failed transmission. Also use when the user explicitly asks for payment files by creation date or created after/before/on a date. Default to the last 30 days when the user does not provide a date range. Because this is a datetime field, emit full ISO datetime literals such as `timeCreated >= '2026-05-18T00:00:00Z'`; do not emit a date-only literal such as `timeCreated >= '2026-05-18'`.\"        },        {          \"name\": \"paymentDate\",          \"attribute\": \"paymentDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user explicitly asks by payment date, paid date, paid on, paid after, paid before, paid in a month, or paid in a year. Do not add completed-status filters unless the user explicitly asks for completed payment files.\"        },        {          \"name\": \"accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\",          \"attribute\": \"accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by transmission configuration.\"        },        {          \"name\": \"accountPaymentProfile.systemPaymentProfile.paymentSystem.paymentSystemName\",          \"attribute\": \"accountPaymentProfile.systemPaymentProfile.paymentSystem.paymentSystemName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment system at the payment-file setup level.\"        },        {          \"name\": \"bankAccount.name\",          \"attribute\": \"bankAccount.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use for bank-column and bank-filter questions about payment files, including pending acknowledgements by bank.\"        },        {          \"name\": \"paymentDocument.paymentDocument\",          \"attribute\": \"paymentDocument.paymentDocument\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about printed payment-file document/check stock context exposed on the payment file.\"        }      ],      \"dateFilterGuidance\": {        \"description\": \"Use `timeCreated` as the default date attribute for broad recent Payment File inquiry lists, creation failures, failed transmission lists, and explicit payment-file creation-date questions. Do not treat `timeCreated` as the default date axis for `PENDING_ACK` acknowledgement-status questions unless the user explicitly asks for payment-file creation date. `timeCreated` is a datetime field, so generated BV filters must use full ISO datetime literals, not date-only literals. Use `paymentDate` only when the user explicitly asks by payment date.\",        \"patterns\": [          {            \"userRequest\": \"recent payment files, failed payment files, creation failures, transmission failures\",            \"clause\": \"timeCreated>='<TODAY_MINUS_30_DAYS>T00:00:00Z' unless the user supplies a different date range\"          },          {            \"userRequest\": \"payment files for a payment date\",            \"clause\": \"paymentDate=<PAYMENT_DATE_FROM_USER>\"          }        ]      },      \"extractionQuery\": null,      \"businessDrivers\": [        {          \"name\": \"paymentFileDetailsByReference\",          \"description\": \"Retrieve direct payment-file details for a specific payment file reference.\",          \"when\": \"User asks to fetch, show, look up, view details, or check status for a specific numeric payment file reference and is not asking to perform an action.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentRequestName\",            \"paymentFileProcessingStatus.meaning\",            \"paymentCount\",            \"paymentDate\",            \"timeCreated\",            \"paymentCurrency\",            \"bankStatusCode\",            \"errorCode\",            \"errorMessage\"          ],          \"extraFilterExpressions\": [            \"paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\"          ],          \"notes\": \"This is a data-inquiry path. Do not route to the payment-file navigation intent for fetch/show/look up/details wording unless the user explicitly asks to download, process, retry, print, send, or perform another action.\"        },        {          \"name\": \"paymentFilesByPaymentDate\",          \"description\": \"List payment files by payment date or paid-date period.\",          \"when\": \"User asks for payment files by payment date, paid in a month/year, paid on a date, or payment date after/before a date.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentRequestName\",            \"paymentFileProcessingStatus.meaning\",            \"paymentCount\",            \"paymentDate\",            \"timeCreated\"          ],          \"extraFilterExpressions\": [            \"paymentDate=<PAYMENT_DATE_FILTER_FROM_USER>\"          ],          \"notes\": \"Use paymentDate as the date axis. For month or year requests, build a closed date range over paymentDate. Do not add lifecycle status filters unless explicitly requested.\"        },        {          \"name\": \"paymentFilesByCreationDate\",          \"description\": \"List payment files by payment-file creation date.\",          \"when\": \"User asks for payment files created on, before, after, or during a date range.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentRequestName\",            \"paymentFileProcessingStatus.meaning\",            \"paymentCount\",            \"paymentDate\",            \"timeCreated\"          ],          \"extraFilterExpressions\": [            \"timeCreated=<PAYMENT_FILE_CREATION_DATE_FILTER_FROM_USER>\"          ],          \"notes\": \"Use full ISO datetime literals for timeCreated. For a single day, use whole-day bounds.\"        },        {          \"name\": \"transmissionSetupByPaymentFile\",          \"description\": \"Retrieve the business-facing transmission configuration, effective dates, and protocol for a specific payment file.\",          \"when\": \"User asks what transmission setup, configuration, or protocol is used for a payment file.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentFileProcessingStatus.meaning\",            \"accountPaymentProfile.systemPaymentProfile.processingType.meaning\",            \"accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\",            \"accountPaymentProfile.paymentTransmissionConfiguration.startDate\",            \"accountPaymentProfile.paymentTransmissionConfiguration.endDate\",            \"accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmissionProtocolName\"          ],          \"extraFilterExpressions\": [            \"paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\"          ],          \"notes\": \"Return effective setup fields plus payment-file status and processing type for configuration questions. Visible output must match the Transmission Configuration Details table: Payment File Reference, Payment File Status, Payment File Processing Type, Transmission Configuration Name, Start Date, End Date, and Transmission Protocol Name. If processing type is Printed, state that transmission is not applicable for that file. Do not include errorMessage, payment system, transmitConfigurationId, or Transmission ID unless the original user request explicitly asks for those fields.\"        },        {          \"name\": \"paymentFilesReadyToTransmit\",          \"description\": \"Find payment files that are ready for transmission and return the same visible setup columns as the ready-to-transmit details output.\",          \"when\": \"User asks which files are ready to transmit or what transmission configuration will be used next.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"accountPaymentProfile.systemPaymentProfile.processingType.meaning\",            \"accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\",            \"accountPaymentProfile.paymentTransmissionConfiguration.startDate\",            \"accountPaymentProfile.paymentTransmissionConfiguration.endDate\",            \"accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmissionProtocolName\"          ],          \"extraFilterExpressions\": [            \"paymentFileProcessingStatus.lookupCode='FORMATTED_READY_TO_TRANSMIT'\"          ],          \"notes\": \"Visible output must omit transmitConfigurationId/Transmission ID and should not include paymentRequestName, payment system, or error message unless the original user request explicitly asks for those fields. Prefer the readyToTransmitPaymentFiles driver when both drivers match.\"        },        {          \"name\": \"activeTransmissionConfigurationWindow\",          \"description\": \"Find transmission configurations effective for a requested date.\",          \"when\": \"User asks which transmission configurations are active today or active for a payment-file date.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\",            \"accountPaymentProfile.paymentTransmissionConfiguration.startDate\",            \"accountPaymentProfile.paymentTransmissionConfiguration.endDate\",            \"accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmissionProtocolName\"          ],          \"extraFilterExpressions\": [            \"accountPaymentProfile.paymentTransmissionConfiguration.startDate<=<REFERENCE_DATE>\",            \"accountPaymentProfile.paymentTransmissionConfiguration.endDate=null or accountPaymentProfile.paymentTransmissionConfiguration.endDate>=<REFERENCE_DATE>\"          ],          \"notes\": \"\"        },        {          \"name\": \"failedTransmissionPaymentFiles\",          \"description\": \"List payment files whose transmission failed, including transmission setup and failure context.\",          \"when\": \"User asks for failed transmission payment files, payment files with transmission failed status, transmission issues, files that could not be sent to the bank, or date-range prompts such as payment files with transmission failed status between a start date and today.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentRequestName\",            \"paymentFileProcessingStatus.meaning\",            \"accountPaymentProfile.systemPaymentProfile.processingType.meaning\",            \"paymentDate\",            \"transmissionDate\",            \"accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\",            \"accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmissionProtocolName\",            \"errorMessage\"          ],          \"extraFilterExpressions\": [            \"paymentFileProcessingStatus.lookupCode='TRANSMISSION_FAILED'\",            \"timeCreated>='<TODAY_MINUS_30_DAYS>T00:00:00Z' when no date range is supplied\",            \"timeCreated>=<START_DATETIME_FROM_USER> when a start date is supplied\",            \"timeCreated<=<END_DATETIME_FROM_USER> when an end date or today is supplied\"          ],          \"notes\": \"This is the canonical list driver for failed-transmission payment-file status searches, including explicit date ranges such as `between July 1st 2026 and today`. Resolve `today` to the current date and apply the window to `timeCreated` using full ISO datetime literals. Do not require a paymentInstructionId for broad failed-transmission list prompts. Visible output should include Payment File Reference, Payment File Status, Payment File Processing Type, Payment Process Request Name, Payment Date, Transmission Date when available, Transmission Configuration Name, Transmission Protocol Name, and Error Message. Do not expose transmitConfigurationId or Transmission ID.\"        },        {          \"name\": \"creationFailurePaymentFiles\",          \"description\": \"List payment files in creation-failure states until file-level validation errors are available.\",          \"when\": \"User asks for payment files that failed creation or need creation-failure follow-up.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentCount\",            \"paymentRequestName\",            \"paymentFileProcessingStatus.meaning\",            \"paymentDate\",            \"timeCreated\",            \"errorCode\",            \"errorMessage\"          ],          \"extraFilterExpressions\": [            \"paymentFileProcessingStatus.lookupCode in ('CREATION_ERROR','RETRY_CREATION','TERMINATED')\",            \"timeCreated>='<TODAY_MINUS_30_DAYS>T00:00:00Z' when no date range is supplied\"          ],          \"notes\": \"These statuses are the supported creation-failure proxy until explicit file-level validation errors are available.\"        },        {          \"name\": \"paymentValidationErrorPaymentFiles\",          \"description\": \"List payment files with file-level validation-stage errors.\",          \"when\": \"User asks for payment files with payment validation errors, validation errors in the last N days, failed validation payment files, or retry payment file validation status. This is file-level validation-stage review only, not installment-level validation drilldown.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentFileProcessingStatus.meaning\",            \"paymentCount\",            \"paymentRequestName\",            \"accountPaymentProfile.systemPaymentProfile.processingType.meaning\",            \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatName\",            \"timeCreated\",            \"errorCode\",            \"errorMessage\"          ],          \"extraFilterExpressions\": [            \"paymentFileProcessingStatus.lookupCode in ('CREATION_ERROR','RETRY_CREATION')\",            \"timeCreated>='<TODAY_MINUS_N_DAYS>T00:00:00Z' when a rolling day window is supplied\",            \"timeCreated>='<TODAY_MINUS_30_DAYS>T00:00:00Z' when no date range is supplied\",            \"timeCreated>=<START_DATETIME_FROM_USER> when a start date is supplied\",            \"timeCreated<=<END_DATETIME_FROM_USER> when an end date or today is supplied\"          ],          \"notes\": \"This is the canonical file-level validation-stage driver for prompts such as `show payment files with payment validation errors in the last 10 days`. Keep the result at payment-file level and do not mark this wording unsupported. Do not use transmission setup fields such as transmission configuration or transmission protocol. Do not attempt to return installment-level validation failures from this driver; if the user asks for installment-level validation detail, the response layer must state that the installment-level validation-failure detail is outside the current supported payment-file validation response. Visible output should use Payment Files with Validation Errors and include Payment File Reference, Payment File Status, Payment Count, Payment Process Request Name, Processing Type, Payment Format, Created On, Error Code, and Error Message when those fields are returned.\"        },        {          \"name\": \"creationFailureSetupFallbackByPpr\",          \"description\": \"Exact-PPR setup-backed creation-failure fallback when primary creation-failure states have no rows.\",          \"when\": \"User asks why payment file creation failed for a specific PPR and exception detail or primary creation states do not return rows.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentRequestName\",            \"paymentFileProcessingStatus.meaning\",            \"paymentDate\",            \"timeCreated\",            \"errorCode\",            \"errorMessage\",            \"accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\",            \"accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmissionProtocolName\"          ],          \"extraFilterExpressions\": [            \"paymentRequestName='<PPR_NAME_FROM_USER>'\",            \"paymentFileProcessingStatus.lookupCode='PENDING_ACTION_ACK_FAILURE'\"          ],          \"notes\": \"Use only as an exact-PPR fallback for creation-failure diagnosis. Do not use this status as the broad creation-failure proxy.\"        },        {          \"name\": \"pendingAcknowledgementByBank\",          \"description\": \"List payment files in pending acknowledgement status, including bank, payment process profile, and any linked inbound acknowledgement context.\",          \"when\": \"User asks how long acknowledgements are pending for payment files, for which banks, whether payment files are still awaiting acknowledgement, asks for payment files completed and pending acknowledgment, or asks for payment files in completed and pending acknowledgment status. Do not use for unprocessed acknowledgment-file list prompts.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentRequestName\",            \"paymentFileProcessingStatus.meaning\",            \"timeUpdated\",            \"paymentDate\",            \"bankAccount.name\",            \"accountPaymentProfile.paymentProfileName\",            \"disbursementInboundFile.fileName\",            \"disbursementInboundFile.inboundFileProcessingStatus.meaning\",            \"disbursementInboundFile.timeCreated\",            \"disbursementInboundFile.errorMessage\"          ],          \"extraFilterExpressions\": [            \"paymentFileProcessingStatus.lookupCode='PENDING_ACK'\"          ],          \"notes\": \"Use `bankAccount.name` as the visible Bank column and `accountPaymentProfile.paymentProfileName` as Payment Process Profile. This is the canonical driver for `completed and pending acknowledgment` and other PENDING_ACK-only acknowledgement-status list questions. Do not mark this wording unsupported because it mentions completed and pending; the full phrase resolves to the single PENDING_ACK status and does not require an additional completed or acknowledged slice. Do not use this driver for prompts such as `show unprocessed acknowledgment files in the last 9 days` or `list unprocessed acknowledgement files`; those ask for inbound acknowledgement files and must use `paymentAcknowledgements` with inbound file processing statuses FETCHED, IMPORT_WARNING, IMPORT_ERROR, and TRANSFORM_ERROR. Do not widen this driver to ACKNOWLEDGED or other statuses unless the user explicitly asks for those additional statuses. Do not add a default `timeCreated` recency filter for this driver unless the user explicitly asks by payment-file creation date; use `timeUpdated` only as the visible pending-since basis.\"        },        {          \"name\": \"paymentFilesWithAcknowledgementFailure\",          \"description\": \"List payment files whose payment-file status is pending action to address acknowledgement failure.\",          \"when\": \"User asks for payment files with acknowledgment failure, payment files with acknowledgement failure, or payment files in pending action to address acknowledgment failure status.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentRequestName\",            \"paymentFileProcessingStatus.meaning\",            \"timeUpdated\",            \"paymentDate\",            \"bankAccount.name\",            \"accountPaymentProfile.paymentProfileName\",            \"disbursementInboundFile.fileName\",            \"disbursementInboundFile.inboundFileProcessingStatus.meaning\",            \"disbursementInboundFile.timeCreated\",            \"disbursementInboundFile.errorMessage\"          ],          \"extraFilterExpressions\": [            \"paymentFileProcessingStatus.lookupCode='PENDING_ACTION_ACK_FAILURE'\"          ],          \"notes\": \"This is the canonical payment-file-level driver for `payment files with acknowledgment failure` and `payment files with acknowledgement failure`. Keep the primary object as payment files, not acknowledgement files. Do not replace this with `paymentAcknowledgements` import-error or transform-error filters. Do not add deeplink recommendations or a `Results shown for ...` recap unless the user explicitly asks for an action, review, or download.\"        },        {          \"name\": \"rejectedPaymentFiles\",          \"description\": \"List payment files whose payment-file status is rejected.\",          \"when\": \"User asks for rejected payment files, payment files in rejected status, or file-level rejected payment-file status. Do not use for rejected payments, rejected installments, voided payments, or invoice-level rejection detail inside a payment file.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentRequestName\",            \"paymentFileProcessingStatus.meaning\",            \"bankAccount.name\",            \"accountPaymentProfile.paymentProfileName\"          ],          \"extraFilterExpressions\": [            \"paymentFileProcessingStatus.lookupCode='REJECTED'\"          ],          \"notes\": \"This is the canonical payment-file-level driver for `show rejected payment files` and `show payment files in rejected status`. Keep the primary object as payment files and keep the filter strictly on payment-file status `REJECTED`. Visible output should include only stable payment-file columns: Payment File Reference, Payment File Status, Payment Process Request Name, Bank, and Payment Process Profile. Do not add payment date, inbound file name, inbound file status, received date, or error message for this broad rejected-file list unless the user explicitly asks for acknowledgement-file detail. Do not route this file-level status question to payment-level rejected installments or acknowledgement-rejected payment drill-down. Do not add deeplink recommendations or a `Results shown for ...` recap unless the user explicitly asks for an action, review, or download.\"        },        {          \"name\": \"paymentFileStatusWithAcknowledgementContext\",          \"description\": \"Retrieve payment file status together with any linked acknowledgement file context available from the payment file expanded view.\",          \"when\": \"User asks for payment file status, acknowledgement status, or whether an acknowledgement exists for a specific file.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentRequestName\",            \"paymentFileProcessingStatus.meaning\",            \"disbursementInboundFile.fileName\",            \"disbursementInboundFile.inboundFileProcessingStatus.meaning\",            \"disbursementInboundFile.paymentSystem.paymentSystemName\",            \"disbursementInboundFile.timeCreated\",            \"disbursementInboundFile.errorMessage\"          ],          \"extraFilterExpressions\": [            \"paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\"          ],          \"notes\": \"The expanded payment-file view exposes file name, status, payment system, and timestamp, but no explicit L0/L1/L2, response, or reconciliation file classifier. Do not claim file-level classification unless it is explicitly available from a future source.\"        },        {          \"name\": \"paymentFileGroupingAndDocumentContext\",          \"description\": \"Return payment-file grouping, document, SRA, and logical grouping context exposed by the refreshed payment-file app package.\",          \"when\": \"User asks how a payment file was grouped, which document/check stock applies, or which SRA/logical grouping setup is visible on the payment file.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentRequestName\",            \"paymentDocument.paymentDocument\",            \"paymentDocument.paymentDocumentCategory.name\",            \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByPaymentDateFlag\",            \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByPaymentCurrencyFlag\",            \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByPaymentProcessRequestFlag\",            \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByBusinessUnitFlag\",            \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByPaymentMethod\",            \"accountPaymentProfile.systemPaymentProfile.paymentRemitAdviceSetup.documentCountLimit\",            \"accountPaymentProfile.systemPaymentProfile.paymentLogicalGroupingRule.groupByServiceLevelFlag\"          ],          \"extraFilterExpressions\": [            \"paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\"          ],          \"notes\": \"Explain grouping flags in business language and do not expose inactive flags unless the user asks for full setup detail.\"        },        {          \"name\": \"readyToTransmitPaymentFiles\",          \"description\": \"List payment files ready to transmit with only visible transmission setup columns.\",          \"when\": \"User asks which payment files are ready to transmit or asks for transmission details for all ready-to-transmit files.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"accountPaymentProfile.systemPaymentProfile.processingType.meaning\",            \"accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\",            \"accountPaymentProfile.paymentTransmissionConfiguration.startDate\",            \"accountPaymentProfile.paymentTransmissionConfiguration.endDate\",            \"accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmissionProtocolName\"          ],          \"extraFilterExpressions\": [            \"paymentFileProcessingStatus.lookupCode='FORMATTED_READY_TO_TRANSMIT'\"          ],          \"notes\": \"Visible output must omit transmitConfigurationId/Transmission ID and should not include paymentRequestName, payment system, or error message unless the original user request explicitly asks for those fields. Amplified or rewritten field lists must not widen this driver beyond the visible transmission setup columns.\"        }      ],      \"additionalInstructions\": [        \"Only use fields mentioned in the fields section. Do not include fields from other shapes.\",        \"Use this shape as the primary Payment File inquiry BV for file status, direct payment-file reference details, date, bank, PPR, transmission setup, and pending acknowledgement questions.\",        \"Use `timeCreated` and a last-30-days default for broad recent Payment File inquiry questions when the user does not provide a date range. Use `timeCreated` for explicit payment-file creation-date requests and `paymentDate` for explicit paid/payment-date requests. Do not apply that broad recent-file `timeCreated` default to `PENDING_ACK` acknowledgement-status list questions such as `completed and pending acknowledgment` unless the user explicitly asks for a creation-date window.\",        \"Use `bankAccount.name` as the Bank column for pending acknowledgement questions; this was confirmed from the agent JSON driver for the pending acknowledgement by bank query.\",        \"Do not use this payment-file BV for broad unprocessed acknowledgment-file list prompts such as `show unprocessed acknowledgment files in the last 9 days`; use `paymentAcknowledgements` with inbound file processing statuses FETCHED, IMPORT_WARNING, IMPORT_ERROR, and TRANSFORM_ERROR instead.\",        \"For acknowledgement-status list questions that mean `PENDING_ACK`, including exact wording such as `show payment files completed and pending acknowledgment` or `completed and pending acknowledgment`, use the `pendingAcknowledgementByBank` driver and keep the filter strictly `paymentFileProcessingStatus.lookupCode='PENDING_ACK'`. Do not plan a combined completed-plus-pending population, do not mark the request unsupported, and do not widen the status set to include ACKNOWLEDGED.\",        \"For acknowledgement-status list questions that mean `PENDING_ACTION_ACK_FAILURE`, including `payment files with acknowledgment failure`, use the `paymentFilesWithAcknowledgementFailure` driver and keep the filter strictly `paymentFileProcessingStatus.lookupCode='PENDING_ACTION_ACK_FAILURE'`. Do not use inbound acknowledgement-file import or transform error statuses as the primary filter for this payment-file question.\",        \"For acknowledgement-status list questions that mean file-level `REJECTED`, including `show rejected payment files` and `show payment files in rejected status`, use the `rejectedPaymentFiles` driver and keep the filter strictly `paymentFileProcessingStatus.lookupCode='REJECTED'`. Do not route this file-level status question to rejected payment, invoice, installment, or voided-payment drill-down.\",        \"Do not expose `accountPaymentProfile.paymentTransmissionConfiguration.transmitConfigurationId` as a visible Transmission ID column unless the user explicitly asks for technical transmission identifiers. It may still be returned internally for routing or troubleshooting.\",        \"Do not attempt L0/L1/L2, response-file, or reconciliation-file detection from this shape. The backend currently exposes file name, status, system, and related acknowledgement context but no explicit file-level classification.\",        \"Do not use the nested `payablesDisbursementPayments` accessor from this payment-file BV. For child payment rows contained in a payment file, switch to `disbursementPayments` or `disbursementPaymentsExtraction`, filtered by `payablesPaymentFile.paymentInstructionId` / `paymentInstructionId`.\",        \"Use paymentDocument, paymentFileCreationRule, paymentRemitAdviceSetup, and paymentLogicalGroupingRule only for payment-file setup/grouping/document questions; summarize boolean grouping flags in business language.\",        \"For payment-level logistics, service-level, delivery-channel, legal-entity, or payment amount questions, switch to disbursementPayments or paymentRunInstallments instead of overloading this BV.\"      ]    },    \"disbursementPaymentInstructionsExtraction\": {      \"key\": \"disbursementPaymentInstructionsExtraction\",      \"name\": \"disbursementPaymentInstructionsExtraction\",      \"type\": \"EXTRACTION\",      \"module\": \"oraErpCorePaymentsFundsDisbursement\",      \"businessObject\": \"PayablesPaymentFile\",      \"description\": \"Runtime extraction wrapper for the disbursementPaymentInstructions BV. Use this shape for summary or grouped Payment File inquiry across file status, transmission setup, pending acknowledgement, creation failures, failed transmission, PPR, payment system, or bank.\",      \"exampleQuestions\": [        \"Show the transmission configuration and protocol for payment file 12345.\",        \"Which payment files are ready to transmit and what transmission setup will they use?\",        \"Which payment-file transmission configurations are active today?\",        \"How many payment files have transmission failed by bank?\",        \"Show payment files pending acknowledgement by bank.\",        \"Count creation-failure payment files by PPR.\"      ],      \"fields\": {        \"fields\": [          \"paymentInstructionId\",          \"paymentCount\",          \"paymentRequestName\",          \"timeCreated\",          \"timeUpdated\",          \"transmissionDate\",          \"processingDate\",          \"paymentDate\",          \"paymentCurrency\",          \"bankStatusCode\",          \"errorCode\",          \"errorMessage\",          \"paymentModeCode\",          \"paymentFileProcessingStatusLookupCode\",          \"paymentFileProcessingStatusMeaning\",          \"paymentFileConfirmationStatusLookupCode\",          \"paymentFileConfirmationStatusMeaning\",          \"paymentProfileId\",          \"paymentProfileName\",          \"paymentSystemAccountName\",          \"transmissionConfigurationName\",          \"transmitConfigurationId\",          \"startDate\",          \"endDate\",          \"transmitProtocolCode\",          \"transmissionProtocolName\",          \"systemProfileCode\",          \"paymentSystemName\",          \"paymentFormatCode\",          \"formatName\",          \"formatTypeName\",          \"processingTypeLookupCode\",          \"processingTypeMeaning\",          \"paymentDocument\",          \"paymentDocumentCategoryName\",          \"groupByPaymentDateFlag\",          \"groupByPaymentCurrencyFlag\",          \"groupByDisbursementBankAccountFlag\",          \"groupByPaymentProcessRequestFlag\",          \"groupByBusinessUnitFlag\",          \"groupByPaymentMethod\",          \"sraDocumentCountLimit\",          \"automaticSraSubmitFlag\",          \"logicalGroupByServiceLevelFlag\",          \"acknowledgementFileName\",          \"acknowledgementFileCreatedOn\",          \"acknowledgementErrorMessage\",          \"acknowledgementPaymentSystemName\",          \"acknowledgementStatusLookupCode\",          \"acknowledgementStatusMeaning\",          \"linkedPaymentProcessRequestId\",          \"linkedPaymentProcessRequestName\",          \"paymentInstrumentAlias\",          \"paymentInstrumentBankName\",          \"bankAccountId\",          \"bankName\"        ],        \"fieldAlias\": {          \"Payment File Id\": \"paymentInstructionId\",          \"Payment File Reference\": \"paymentInstructionId\",          \"Payment Count\": \"paymentCount\",          \"PPR Name\": \"paymentRequestName\",          \"PPR ID\": \"linkedPaymentProcessRequestId\",          \"Created On\": \"timeCreated\",          \"Last Updated On\": \"timeUpdated\",          \"Transmission Date\": \"transmissionDate\",          \"Processing Date\": \"processingDate\",          \"Payment Date\": \"paymentDate\",          \"Payment Currency\": \"paymentCurrency\",          \"Bank Status Code\": \"bankStatusCode\",          \"Error Code\": \"errorCode\",          \"Error Message\": \"errorMessage\",          \"Payment Mode Code\": \"paymentModeCode\",          \"Payment File Processing Status Code\": \"paymentFileProcessingStatusLookupCode\",          \"Payment File Processing Status\": \"paymentFileProcessingStatusMeaning\",          \"Payment File Confirmation Status Code\": \"paymentFileConfirmationStatusLookupCode\",          \"Payment File Confirmation Status\": \"paymentFileConfirmationStatusMeaning\",          \"Payment Process Profile Id\": \"paymentProfileId\",          \"Payment Process Profile\": \"paymentProfileName\",          \"Payment System Account\": \"paymentSystemAccountName\",          \"Transmission Configuration Name\": \"transmissionConfigurationName\",          \"Transmission ID\": \"transmitConfigurationId\",          \"Start Date\": \"startDate\",          \"End Date\": \"endDate\",          \"Transmission Protocol Code\": \"transmitProtocolCode\",          \"Transmission Protocol Name\": \"transmissionProtocolName\",          \"System Payment Profile Code\": \"systemProfileCode\",          \"Payment System\": \"paymentSystemName\",          \"Payment Format Code\": \"paymentFormatCode\",          \"Payment Format\": \"formatName\",          \"Format Type\": \"formatTypeName\",          \"Processing Type Code\": \"processingTypeLookupCode\",          \"Processing Type\": \"processingTypeMeaning\",          \"Payment Document\": \"paymentDocument\",          \"Payment Document Category\": \"paymentDocumentCategoryName\",          \"Group By Payment Date\": \"groupByPaymentDateFlag\",          \"Group By Payment Currency\": \"groupByPaymentCurrencyFlag\",          \"Group By Disbursement Bank Account\": \"groupByDisbursementBankAccountFlag\",          \"Group By Payment Process Request\": \"groupByPaymentProcessRequestFlag\",          \"Group By Business Unit\": \"groupByBusinessUnitFlag\",          \"Group By Payment Method\": \"groupByPaymentMethod\",          \"SRA Document Count Limit\": \"sraDocumentCountLimit\",          \"Automatic SRA Submit\": \"automaticSraSubmitFlag\",          \"Logical Group By Service Level\": \"logicalGroupByServiceLevelFlag\",          \"Acknowledgment File Name\": \"acknowledgementFileName\",          \"Received Date\": \"acknowledgementFileCreatedOn\",          \"Acknowledgment Error Message\": \"acknowledgementErrorMessage\",          \"Acknowledgment Payment System\": \"acknowledgementPaymentSystemName\",          \"Acknowledgment Status Code\": \"acknowledgementStatusLookupCode\",          \"Acknowledgment Status\": \"acknowledgementStatusMeaning\",          \"Linked PPR ID\": \"linkedPaymentProcessRequestId\",          \"Linked PPR Name\": \"linkedPaymentProcessRequestName\",          \"Payment Instrument Alias\": \"paymentInstrumentAlias\",          \"Payment Instrument Bank\": \"paymentInstrumentBankName\",          \"Bank Account ID\": \"bankAccountId\",          \"Bank\": \"bankName\"        }      },      \"supportedFilters\": [        {          \"name\": \"paymentInstructionId\",          \"attribute\": \"paymentInstructionId\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Filter by payment file id provided by the user input, if present. Use for exact payment-file detail, status, transmission setup, and child-payment context when the user says fetch, show, look up, or details for a specific payment file.\",          \"valueFromUser\": \"Payment File Id\"        },        {          \"name\": \"paymentRequestName\",          \"attribute\": \"paymentRequestName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Filter by PPR name or payment request name when the user provides it.\",          \"valueFromUser\": \"PPR Name\"        },        {          \"name\": \"linkedPaymentProcessRequestId\",          \"attribute\": \"linkedPaymentProcessRequestId\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Filter by linked payment process request id when supplied.\",          \"valueFromUser\": \"PPR ID\"        },        {          \"name\": \"paymentFileProcessingStatus.lookupCode\",          \"attribute\": \"paymentFileProcessingStatus.lookupCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"ACKNOWLEDGED\",            \"CANCELING\",            \"CREATED\",            \"CREATED_READY_FOR_FORMATTING\",            \"CREATED_READY_FOR_PRINTING\",            \"CREATION_ERROR\",            \"FORMATTED\",            \"FORMATTED_ELECTRONIC\",            \"FORMATTED_READY_FOR_PRINTING\",            \"FORMATTED_READY_TO_TRANSMIT\",            \"FORMATTING_FAILED\",            \"PARTIALLY_ACKNOWLEDGED\",            \"PENDING_ACK\",            \"PENDING_ACTION_ACK_FAILURE\",            \"PRINTED\",            \"PROCESSING_ACK\",            \"REJECTED\",            \"RETRY_CREATION\",            \"SUBMITTED_FOR_PRINTING\",            \"TERMINATED\",            \"TRANSMISSION_FAILED\",            \"TRANSMITTED\",            \"TRANSMITTED_PENDING_ACK\"          ],          \"usage\": \"Use when the user asks for payment files in a processing state such as creation failed, ready to transmit, transmitted, pending acknowledgement, or transmission failed.\",          \"valueFromUser\": \"Payment File Processing Status Code\"        },        {          \"name\": \"timeCreated\",          \"attribute\": \"timeCreated\",          \"type\": \"datetime\",          \"possibleValues\": [],          \"usage\": \"Use as the default date filter for recent payment-file lists and when the user explicitly asks for payment files by creation date or created after/before/on a date. Default to the last 30 days when the user does not provide a date range. Because this extraction generates Oracle SQL against a datetime field, emit ANSI TIMESTAMP literals such as `timeCreated >= TIMESTAMP '2026-05-18 00:00:00'`; do not emit plain quoted date strings such as `timeCreated >= '2026-05-18'`.\",          \"valueFromUser\": \"Date range\"        },        {          \"name\": \"paymentDate\",          \"attribute\": \"paymentDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user explicitly asks by payment date, paid date, paid on, paid after, paid before, paid in a month, or paid in a year. Use DATE literals and do not add completed-status filters unless explicitly requested.\",          \"valueFromUser\": \"Payment Date\"        },        {          \"name\": \"bankAccount.name\",          \"attribute\": \"bankAccount.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use for bank-column and bank-filter questions about payment files.\",          \"valueFromUser\": \"Bank\"        },        {          \"name\": \"accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\",          \"attribute\": \"accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters or groups by transmission configuration.\",          \"valueFromUser\": \"Transmission Configuration Name\"        }      ],      \"dateFilterGuidance\": {        \"description\": \"Use `timeCreated` as the default date attribute for Payment File inquiry lists. If the user asks for recent payment files and does not supply a window, use the last 30 days. Extraction SQL must use Oracle ANSI TIMESTAMP literals for `timeCreated` comparisons.\",        \"patterns\": [          {            \"userRequest\": \"recent payment files, failed payment files, creation failures, transmission failures, pending acknowledgements\",            \"clause\": \"timeCreated>=TIMESTAMP '<TODAY_MINUS_30_DAYS> 00:00:00' unless the user supplies a different date range\"          },          {            \"userRequest\": \"payment files for a payment date\",            \"clause\": \"paymentDate=DATE '<PAYMENT_DATE_FROM_USER_YYYY-MM-DD>'\"          }        ]      },      \"extractionQuery\": {        \"viewQueries\": {          \"disbursementPaymentInstructions\": {            \"module\": \"oraErpCorePaymentsFundsDisbursement\",            \"businessObject\": \"PayablesPaymentFile\",            \"view\": \"disbursementPaymentInstructions\",            \"fieldAliases\": {              \"paymentInstructionId\": \"paymentInstructionId\",              \"paymentCount\": \"paymentCount\",              \"paymentRequestName\": \"paymentRequestName\",              \"timeCreated\": \"timeCreated\",              \"timeUpdated\": \"timeUpdated\",              \"transmissionDate\": \"transmissionDate\",              \"processingDate\": \"processingDate\",              \"paymentDate\": \"paymentDate\",              \"paymentCurrency\": \"paymentCurrency\",              \"bankStatusCode\": \"bankStatusCode\",              \"errorCode\": \"errorCode\",              \"errorMessage\": \"errorMessage\",              \"paymentModeCode\": \"paymentModeCode\",              \"paymentFileProcessingStatus.lookupCode\": \"paymentFileProcessingStatusLookupCode\",              \"paymentFileProcessingStatus.meaning\": \"paymentFileProcessingStatusMeaning\",              \"paymentFileConfirmationStatus.lookupCode\": \"paymentFileConfirmationStatusLookupCode\",              \"paymentFileConfirmationStatus.meaning\": \"paymentFileConfirmationStatusMeaning\",              \"accountPaymentProfile.paymentProfileId\": \"paymentProfileId\",              \"accountPaymentProfile.paymentProfileName\": \"paymentProfileName\",              \"accountPaymentProfile.paymentSystemAccount.paymentSystemAccountName\": \"paymentSystemAccountName\",              \"accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\": \"transmissionConfigurationName\",              \"accountPaymentProfile.paymentTransmissionConfiguration.transmitConfigurationId\": \"transmitConfigurationId\",              \"accountPaymentProfile.paymentTransmissionConfiguration.startDate\": \"startDate\",              \"accountPaymentProfile.paymentTransmissionConfiguration.endDate\": \"endDate\",              \"accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmitProtocolCode\": \"transmitProtocolCode\",              \"accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmissionProtocolName\": \"transmissionProtocolName\",              \"accountPaymentProfile.systemPaymentProfile.systemProfileCode\": \"systemProfileCode\",              \"accountPaymentProfile.systemPaymentProfile.paymentSystem.paymentSystemName\": \"paymentSystemName\",              \"accountPaymentProfile.systemPaymentProfile.paymentFormat.paymentFormatCode\": \"paymentFormatCode\",              \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatName\": \"formatName\",              \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatType.formatTypeName\": \"formatTypeName\",              \"accountPaymentProfile.systemPaymentProfile.processingType.lookupCode\": \"processingTypeLookupCode\",              \"accountPaymentProfile.systemPaymentProfile.processingType.meaning\": \"processingTypeMeaning\",              \"paymentDocument.paymentDocument\": \"paymentDocument\",              \"paymentDocument.paymentDocumentCategory.name\": \"paymentDocumentCategoryName\",              \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByPaymentDateFlag\": \"groupByPaymentDateFlag\",              \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByPaymentCurrencyFlag\": \"groupByPaymentCurrencyFlag\",              \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByDisbursementBankAccountFlag\": \"groupByDisbursementBankAccountFlag\",              \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByPaymentProcessRequestFlag\": \"groupByPaymentProcessRequestFlag\",              \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByBusinessUnitFlag\": \"groupByBusinessUnitFlag\",              \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByPaymentMethod\": \"groupByPaymentMethod\",              \"accountPaymentProfile.systemPaymentProfile.paymentRemitAdviceSetup.documentCountLimit\": \"sraDocumentCountLimit\",              \"accountPaymentProfile.systemPaymentProfile.paymentRemitAdviceSetup.automaticSraSubmitFlag\": \"automaticSraSubmitFlag\",              \"accountPaymentProfile.systemPaymentProfile.paymentLogicalGroupingRule.groupByServiceLevelFlag\": \"logicalGroupByServiceLevelFlag\",              \"disbursementInboundFile.fileName\": \"acknowledgementFileName\",              \"disbursementInboundFile.timeCreated\": \"acknowledgementFileCreatedOn\",              \"disbursementInboundFile.errorMessage\": \"acknowledgementErrorMessage\",              \"disbursementInboundFile.paymentSystem.paymentSystemName\": \"acknowledgementPaymentSystemName\",              \"disbursementInboundFile.inboundFileProcessingStatus.lookupCode\": \"acknowledgementStatusLookupCode\",              \"disbursementInboundFile.inboundFileProcessingStatus.meaning\": \"acknowledgementStatusMeaning\",              \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\": \"linkedPaymentProcessRequestId\",              \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\": \"linkedPaymentProcessRequestName\",              \"paymentInstrument.paymentInstrumentAlias\": \"paymentInstrumentAlias\",              \"paymentInstrument.bank.name\": \"paymentInstrumentBankName\",              \"bankAccount.id\": \"bankAccountId\",              \"bankAccount.name\": \"bankName\"            }          }        },        \"select\": \"{select_statement}\"      },      \"businessDrivers\": [        {          \"name\": \"paymentFileDetailsByReference\",          \"description\": \"Retrieve direct payment-file details for a specific payment file reference.\",          \"when\": \"User asks to fetch, show, look up, view details, or check status for a specific numeric payment file reference and is not asking to perform an action.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentRequestName\",            \"paymentFileProcessingStatusMeaning\",            \"paymentCount\",            \"paymentDate\",            \"timeCreated\",            \"paymentCurrency\",            \"bankStatusCode\",            \"errorCode\",            \"errorMessage\"          ],          \"extraFilterExpressions\": [            \"paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\"          ],          \"notes\": \"This is a data-inquiry path. Do not route to the payment-file navigation intent for fetch/show/look up/details wording unless the user explicitly asks to download, process, retry, print, send, or perform another action.\"        },        {          \"name\": \"paymentFilesByPaymentDate\",          \"description\": \"List payment files by payment date or paid-date period.\",          \"when\": \"User asks for payment files by payment date, paid in a month/year, paid on a date, or payment date after/before a date.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentRequestName\",            \"paymentFileProcessingStatusMeaning\",            \"paymentCount\",            \"paymentDate\",            \"timeCreated\"          ],          \"extraFilterExpressions\": [            \"paymentDate=<PAYMENT_DATE_FILTER_FROM_USER>\"          ],          \"notes\": \"Use paymentDate as the date axis. For month or year requests, build a closed date range over paymentDate using DATE literals. Do not add lifecycle status filters unless explicitly requested.\"        },        {          \"name\": \"paymentFilesByCreationDate\",          \"description\": \"List payment files by payment-file creation date.\",          \"when\": \"User asks for payment files created on, before, after, or during a date range.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentRequestName\",            \"paymentFileProcessingStatusMeaning\",            \"paymentCount\",            \"paymentDate\",            \"timeCreated\"          ],          \"extraFilterExpressions\": [            \"timeCreated=<PAYMENT_FILE_CREATION_DATE_FILTER_FROM_USER>\"          ],          \"notes\": \"Use Oracle ANSI TIMESTAMP literals for timeCreated. For a single day, use whole-day bounds.\"        },        {          \"name\": \"transmissionSetupByPaymentFile\",          \"description\": \"Retrieve the transmission configuration, effective dates, and protocol for a specific payment file.\",          \"when\": \"User asks what transmission setup, configuration, or protocol is used for a payment file.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentFileProcessingStatusMeaning\",            \"processingTypeMeaning\",            \"transmissionConfigurationName\",            \"startDate\",            \"endDate\",            \"transmissionProtocolName\"          ],          \"extraFilterExpressions\": [            \"paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\"          ],          \"notes\": \"Visible output must match the Transmission Configuration Details table: Payment File Reference, Payment File Status, Payment File Processing Type, Transmission Configuration Name, Start Date, End Date, and Transmission Protocol Name. If processing type is Printed, state that transmission is not applicable for that file. Do not include paymentRequestName, paymentSystemName, errorMessage, transmitConfigurationId, or Transmission ID unless the original user request explicitly asks for those fields.\"        },        {          \"name\": \"failedTransmissionPaymentFiles\",          \"description\": \"List or summarize payment files whose transmission failed.\",          \"when\": \"User asks for failed transmission payment files, transmission issues, or files that could not be sent to the bank.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentCount\",            \"paymentRequestName\",            \"paymentFileProcessingStatusMeaning\",            \"processingTypeMeaning\",            \"paymentDate\",            \"timeCreated\",            \"bankStatusCode\",            \"errorCode\",            \"errorMessage\"          ],          \"extraFilterExpressions\": [            \"paymentFileProcessingStatusLookupCode='TRANSMISSION_FAILED'\",            \"timeCreated>=TIMESTAMP '<TODAY_MINUS_30_DAYS> 00:00:00' when no date range is supplied\"          ],          \"notes\": \"Use the last 30 days by default. Group externally or generate an aggregate SELECT when the user asks for counts by bank, PPR, or transmission setup.\"        },        {          \"name\": \"creationFailurePaymentFiles\",          \"description\": \"List or summarize payment files in creation-failure states.\",          \"when\": \"User asks for payment files that failed creation or need creation-failure follow-up.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentCount\",            \"paymentRequestName\",            \"paymentFileProcessingStatusMeaning\",            \"paymentDate\",            \"timeCreated\",            \"errorCode\",            \"errorMessage\"          ],          \"extraFilterExpressions\": [            \"paymentFileProcessingStatusLookupCode in ('CREATION_ERROR','RETRY_CREATION','TERMINATED')\",            \"timeCreated>=TIMESTAMP '<TODAY_MINUS_30_DAYS> 00:00:00' when no date range is supplied\"          ],          \"notes\": \"These statuses are the supported creation-failure proxy until explicit file-level validation errors are available.\"        },        {          \"name\": \"creationFailureSetupFallbackByPpr\",          \"description\": \"Exact-PPR setup-backed creation-failure fallback when primary creation-failure states have no rows.\",          \"when\": \"User asks why payment file creation failed for a specific PPR and exception detail or primary creation states do not return rows.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentRequestName\",            \"paymentFileProcessingStatusMeaning\",            \"paymentDate\",            \"timeCreated\",            \"errorCode\",            \"errorMessage\",            \"transmissionConfigurationName\",            \"transmissionProtocolName\"          ],          \"extraFilterExpressions\": [            \"paymentRequestName='<PPR_NAME_FROM_USER>'\",            \"paymentFileProcessingStatusLookupCode='PENDING_ACTION_ACK_FAILURE'\"          ],          \"notes\": \"Use only as an exact-PPR fallback for creation-failure diagnosis. Do not use this status as the broad creation-failure proxy.\"        },        {          \"name\": \"pendingAcknowledgementByBank\",          \"description\": \"List or summarize payment files pending acknowledgement by bank.\",          \"when\": \"User asks how long acknowledgements are pending for payment files or for which banks.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"timeUpdated\",            \"paymentDate\",            \"bankName\",            \"paymentFileProcessingStatusMeaning\"          ],          \"extraFilterExpressions\": [            \"paymentFileProcessingStatusLookupCode='PENDING_ACK'\"          ],          \"notes\": \"Use `bankName`, sourced from `bankAccount.name`, as the Bank column. Do not join to payablesDisbursementPayments from this extraction wrapper; use disbursementPayments or disbursementPaymentsExtraction for child payment rows.\"        },        {          \"name\": \"paymentFileGroupingAndDocumentContext\",          \"description\": \"Return grouping, payment document, SRA, and logical grouping fields exposed by the latest payment-file view.\",          \"when\": \"User asks how a payment file was grouped, which payment document/check stock applies, or what visible SRA/logical grouping setup exists.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentRequestName\",            \"paymentDocument\",            \"paymentDocumentCategoryName\",            \"groupByPaymentDateFlag\",            \"groupByPaymentCurrencyFlag\",            \"groupByPaymentProcessRequestFlag\",            \"groupByBusinessUnitFlag\",            \"groupByPaymentMethod\",            \"sraDocumentCountLimit\",            \"automaticSraSubmitFlag\",            \"logicalGroupByServiceLevelFlag\"          ],          \"extraFilterExpressions\": [            \"paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\"          ],          \"notes\": \"Explain grouping flags in business language and return only the fields needed for the user's question.\"        },        {          \"name\": \"readyToTransmitPaymentFiles\",          \"description\": \"List payment files ready to transmit with only visible transmission setup columns.\",          \"when\": \"User asks which payment files are ready to transmit or asks for transmission details for all ready-to-transmit files.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"processingTypeMeaning\",            \"transmissionConfigurationName\",            \"startDate\",            \"endDate\",            \"transmissionProtocolName\"          ],          \"extraFilterExpressions\": [            \"paymentFileProcessingStatusLookupCode='FORMATTED_READY_TO_TRANSMIT'\"          ],          \"notes\": \"Visible output must match the Transmission Configuration Details table: Payment File Reference, Payment File Processing Type, Transmission Configuration Name, Start Date, End Date, and Transmission Protocol Name. Do not include transmitConfigurationId, paymentRequestName, paymentFileProcessingStatusMeaning, paymentSystemName, or errorMessage unless the original user request explicitly asks for those fields. Amplified or rewritten field lists must not widen this driver beyond the visible transmission setup columns.\"        }      ],      \"selectExamples\": [        {          \"key\": \"paymentFileDetailsByReference\",          \"name\": \"paymentFileDetailsByReference\",          \"intentSliceKey\": \"paymentFileDetailsByReference\",          \"description\": \"Fetch details for an exact payment file reference.\",          \"outputFields\": [            \"paymentInstructionId\",            \"paymentRequestName\",            \"paymentFileProcessingStatusMeaning\",            \"paymentCount\",            \"paymentDate\",            \"timeCreated\",            \"paymentCurrency\",            \"bankStatusCode\",            \"errorCode\",            \"errorMessage\"          ],          \"select\": \"SELECT paymentInstructionId AS paymentInstructionId, paymentRequestName AS paymentRequestName, paymentFileProcessingStatusMeaning AS paymentFileProcessingStatusMeaning, paymentCount AS paymentCount, paymentDate AS paymentDate, timeCreated AS timeCreated, paymentCurrency AS paymentCurrency, bankStatusCode AS bankStatusCode, errorCode AS errorCode, errorMessage AS errorMessage FROM disbursementPaymentInstructions WHERE paymentInstructionId = <PAYMENT_FILE_ID_FROM_USER>\"        },        {          \"key\": \"readyToTransmitPaymentFiles\",          \"name\": \"readyToTransmitPaymentFiles\",          \"intentSliceKey\": \"readyToTransmitPaymentFiles\",          \"description\": \"List payment files ready to transmit with only the visible transmission setup columns expected by the intent output table.\",          \"outputFields\": [            \"paymentInstructionId\",            \"transmissionConfigurationName\",            \"startDate\",            \"endDate\",            \"transmissionProtocolName\"          ],          \"select\": \"SELECT paymentInstructionId AS paymentInstructionId, transmissionConfigurationName AS transmissionConfigurationName, startDate AS startDate, endDate AS endDate, transmissionProtocolName AS transmissionProtocolName FROM disbursementPaymentInstructions WHERE paymentFileProcessingStatusLookupCode = 'FORMATTED_READY_TO_TRANSMIT'\"        }      ],      \"additionalInstructions\": [        \"Generate the full SELECT statement and place it into {select_statement} before execution.\",        \"Use viewQueries.disbursementPaymentInstructions as the FROM source with alias consistent in the SQL (for example disbursementPaymentInstructions).\",        \"Build the extraction SQL in a single query block where possible. Do not use an outer inline-view wrapper only to apply row limits or filter projected aliases.\",        \"Apply supported filters and date filters as needed, using supportedFilters and entity resolution. For datetime filters such as `timeCreated`, use Oracle ANSI TIMESTAMP literals and never plain quoted date strings. For a single-day user request on a datetime field, use whole-day bounds such as `timeCreated >= TIMESTAMP '2026-06-01 00:00:00' and timeCreated < TIMESTAMP '2026-06-02 00:00:00'`.\",        \"For detail row-list queries, append FETCH FIRST 20 ROWS ONLY in the same query block after ORDER BY when present. Do not use legacy row-number predicates. Do not apply the detail row limit to grouped summaries unless the user explicitly asks for top N groups.\",        \"Do not reference SELECT aliases in WHERE, HAVING, ORDER BY, GROUP BY, or outer query filters. If a calculated expression must be filtered, ordered, or grouped, repeat the full expression in that clause. Output aliases are allowed only as returned column names.\",        \"Only use fields mentioned in the fields section. Do not include fields from other shapes.\",        \"Use this extraction wrapper for grouped Payment File inquiry over status, direct payment-file reference details, PPR, bank, transmission setup, or date window. For ready-to-transmit details, use the readyToTransmitPaymentFiles business driver and omit internal transmission identifiers.\",        \"Use `paymentDate` for explicit payment-date or paid-date requests, including paid in a month/year. Use `timeCreated` for explicit payment-file creation-date requests.\",        \"The latest app-pkg payment-file view exposes payment document, grouping, SRA, logical grouping, and child payment context. Use those aliases for payment-file setup or child-payment summaries only.\",        \"Do not attempt L0/L1/L2, response-file, or reconciliation-file detection. The source does not expose explicit file-level classification.\"      ]    },    \"payablesInvoicePaymentSummaries\": {      \"key\": \"payablesInvoicePaymentSummaries\",      \"name\": \"payablesInvoicePaymentSummaries\",      \"type\": \"AV\",      \"shapeRole\": \"summary\",      \"module\": \"oraErpCorePayablesPayments\",      \"businessObject\": null,      \"api\": \"analyticviews/ora/erpCore/payablesPayments/v1/payablesInvoicePaymentSummaries\",      \"description\": \"Use this AV shape to summarize invoice-payment outcomes across invoice, installment, payment, discount, currency, supplier, legal-entity, and due-date dimensions. It is the right shape for tax and discount rollups, invoice-level payment breakdowns, and early-payment analysis.\",      \"exampleQuestions\": [        \"Show me the breakdown of taxes and discounts for the invoices in this batch.\",        \"What is the total value of installments scheduled for payment in the next 48 hours across all business units?\",        \"Summarize payment amounts, discount taken, and invoice counts by supplier and currency.\",        \"What is the total amount of early payment discounts captured in this run?\",        \"Summarize the top 5 suppliers by value in this payment batch.\",        \"Which specific invoices were settled by Payment 12345?\"      ],      \"fields\": {        \"measures\": [          \"paidAmount\",          \"discountLostAmount\",          \"discountTakenAmount\",          \"invoiceAmountLedgerCurrency\",          \"paymentAmountLedgerCurrency\",          \"invoiceCount\",          \"installmentCount\",          \"averageDaysPaidEarly\",          \"paymentCount\"        ],        \"dimensions\": [          {            \"name\": \"businessUnit\",            \"attributes\": [              {                \"name\": \"profitCenterFlag\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"ledgerName\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"businessUnitId\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"businessUnitName\",                \"sortable\": true,                \"searchable\": true              }            ],            \"hierarchies\": [              {                \"name\": \"businessUnitHierarchy\",                \"levels\": [                  \"BUSINESSUNIT\"                ]              }            ]          },          {            \"name\": \"legalEntity\",            \"attributes\": [              {                \"name\": \"legalEntityName\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"legalEntityCountryCode\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"legalEntityIdentifier\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"legalEntityId\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"ledgerCurrCode\",                \"sortable\": true,                \"s