ent-run installment totals by payment format.\"        },        {          \"name\": \"paymentFunctionHierarchy.paymentFunctionCode\",          \"attribute\": \"paymentFunctionHierarchy.paymentFunctionCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for payment-run installment totals by payment function.\"        },        {          \"name\": \"payablesInvoiceTypeHierarchy.invoiceTypeCode\",          \"attribute\": \"payablesInvoiceTypeHierarchy.invoiceTypeCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for payment-run installment totals by invoice or document type.\"        }      ],      \"dateFilterGuidance\": {        \"description\": \"Use `paymentDateHierarchy.calendarDate` for payment timing, `dueDateHierarchy.calendarDate` for installment due-date urgency, and `paymentProcessRequestDateHierarchy.calendarDate` for payment-run creation timing.\",        \"patterns\": [          {            \"userRequest\": \"paid today, paying tomorrow, payment date, or payment timing in the run\",            \"clause\": \"apply the date window to paymentDateHierarchy.calendarDate\"          },          {            \"userRequest\": \"due today, due this week, overdue, or due in a date range\",            \"clause\": \"apply the date window to dueDateHierarchy.calendarDate\"          },          {            \"userRequest\": \"payment runs created today, submitted yesterday, or created in a date range\",            \"clause\": \"apply the date window to paymentProcessRequestDateHierarchy.calendarDate\"          }        ]      },      \"extractionQuery\": null,      \"businessDrivers\": [        {          \"name\": \"pprPaymentRunInstallmentOutflow\",          \"description\": \"Summarize payment-run installment value and counts for a PPR by currency.\",          \"when\": \"User asks for total cash outflow, payment value, installment count, invoice count, payment count, or payment instruction count for a named PPR after it has entered Oracle Payments.\",          \"fieldsToReturn\": [            \"paymentAmount\",            \"installmentPayments\",            \"invoices\",            \"payments\",            \"paymentInstructions\",            \"paymentCurrencyHierarchy\",            \"paymentProcessRequestHierarchy\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestHierarchy.name='<PPR_NAME_FROM_USER>' or paymentProcessRequestHierarchy.paymentProcessRequestId=<PPR_ID_FROM_USER>\"          ],          \"notes\": \"Use this AV directly for grouped payment-run installment summaries. Always include paymentCurrencyHierarchy.currencyCode when returning amount measures.\"        },        {          \"name\": \"supplierOrPayeeConcentrationInPaymentRun\",          \"description\": \"Summarize payment-run installment value by supplier or payee within a PPR.\",          \"when\": \"User asks for top suppliers, top payees, concentration, dominant payee, or whether one supplier or payee exceeds a threshold in the payment run.\",          \"fieldsToReturn\": [            \"paymentAmount\",            \"installmentPayments\",            \"supplierHierarchy\",            \"payeePartyHierarchy\",            \"paymentCurrencyHierarchy\",            \"paymentProcessRequestHierarchy\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestHierarchy.name='<PPR_NAME_FROM_USER>' or paymentProcessRequestHierarchy.paymentProcessRequestId=<PPR_ID_FROM_USER>\"          ],          \"notes\": \"Rank and compute percentage of total outside the AV result. Use supplierHierarchy for supplier concentration and payeePartyHierarchy for payee concentration.\"        },        {          \"name\": \"proposedPaymentReviewRollups\",          \"description\": \"Support proposed-payment review rollups across all payment process requests when the user wants to inspect batch totals, installment counts, and currency splits before approval.\",          \"when\": \"User asks to review proposed payments for all PPRs, list proposed payment rollups across batches, or compare batch-level payment amounts and installment counts without restricting to a single PPR.\",          \"fieldsToReturn\": [            \"paymentProcessRequestHierarchy.paymentProcessRequestId\",            \"paymentProcessRequestHierarchy.name\",            \"paymentAmount\",            \"installmentPayments\",            \"paymentCurrencyHierarchy.currencyCode\"          ],          \"extraFilterExpressions\": [            \"filterfact: null\",            \"filter: paymentProcessRequestHierarchy.$levelName='PAYMENTPROCESSREQUEST' AND paymentCurrencyHierarchy.$levelName='CURRENCYCODE'\",            \"sortBy: paymentProcessRequestHierarchy.paymentProcessRequestId:asc\",            \"limit: 20\"          ],          \"notes\": \"Use this exact pattern for all-PPR proposed-payment review. Do not add a PPR-specific filterfact. Keep paymentCurrencyHierarchy.$levelName='CURRENCYCODE' whenever paymentCurrencyHierarchy.currencyCode is selected. This driver is summary-only; use paymentRunInstallments when the user needs row-level payment reference, payee, bank account, payment method, supplier type, or payment date detail.\"        },        {          \"name\": \"hypotheticalExclusionImpact\",          \"description\": \"Compute payment-run value that would be excluded by supplier, payee, payment method, payment format, payment priority proxy, or other supported grouping.\",          \"when\": \"User asks what the run total becomes if a supplier, payee, method, format, or supported group is removed.\",          \"fieldsToReturn\": [            \"paymentAmount\",            \"installmentPayments\",            \"paymentCurrencyHierarchy\",            \"paymentProcessRequestHierarchy\",            \"supplierHierarchy\",            \"payeePartyHierarchy\",            \"paymentMethodHierarchy\",            \"paymentFormatHierarchy\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestHierarchy.name='<PPR_NAME_FROM_USER>' or paymentProcessRequestHierarchy.paymentProcessRequestId=<PPR_ID_FROM_USER>\"          ],          \"notes\": \"Treat the removal as hypothetical. Fetch the full batch total and the excluded subset, then compute the residual total outside the AV query.\"        },        {          \"name\": \"fundingAndPaymentMethodBreakdown\",          \"description\": \"Summarize payment-run installment value by bank account, payment method, payment mode, payment format, payment process profile, or payment function.\",          \"when\": \"User asks how payment-run installments are funded or wants to verify bank accounts, payment methods, formats, profiles, modes, or functions.\",          \"fieldsToReturn\": [            \"paymentAmount\",            \"installmentPayments\",            \"bankAccountHierarchy\",            \"paymentMethodHierarchy\",            \"paymentFormatHierarchy\",            \"paymentProcessProfileHierarchy\",            \"paymentFunctionHierarchy\",            \"paymentCurrencyHierarchy\",            \"paymentProcessRequestHierarchy\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestHierarchy.name='<PPR_NAME_FROM_USER>' or paymentProcessRequestHierarchy.paymentProcessRequestId=<PPR_ID_FROM_USER>\"          ],          \"notes\": \"Use this driver for funding and disbursement setup rollups. Drill into paymentRunInstallments when the user needs row-level bank account or external bank account detail.\"        },        {          \"name\": \"statusAndLifecycleBreakdown\",          \"description\": \"Summarize payment-run installment value and counts by PPR status, document status, resulting payment status, and payment-instruction status.\",          \"when\": \"User asks how payment-run installment value is distributed across statuses or wants a lifecycle/status snapshot for a PPR.\",          \"fieldsToReturn\": [            \"paymentAmount\",            \"installmentPayments\",            \"paymentProcessRequestStatusHierarchy\",            \"paymentRunInstallmentStatusHierarchy\",            \"disbursementPaymentStatusHierarchy\",            \"paymentInstructionStatusHierarchy\",            \"paymentCurrencyHierarchy\",            \"paymentProcessRequestHierarchy\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestHierarchy.name='<PPR_NAME_FROM_USER>' or paymentProcessRequestHierarchy.paymentProcessRequestId=<PPR_ID_FROM_USER>\"          ],          \"notes\": \"Use this for grouped status rollups. Use paymentRunInstallments or exception shapes for row-level reasons, error messages, and corrective action.\"        },        {          \"name\": \"pprSelectedInstallmentOutflow\",          \"description\": \"Summarize total cash outflow for a named payment process request across all currencies.\",          \"when\": \"User asks for total cash outflow, payment value, or cash requirement for a named PPR or batch.\",          \"fieldsToReturn\": [            \"paymentAmount\",            \"paymentCurrencyHierarchy.currencyCode\",            \"paymentProcessRequestHierarchy.checkrunName\"          ],          \"extraFilterExpressions\": [            \"filterfact: paymentProcessRequestHierarchy[checkrunName='<PPR_NAME_FROM_USER>']\",            \"filter: paymentProcessRequestHierarchy.$levelName='PAYMENTPROCESSREQUEST' AND paymentCurrencyHierarchy.$levelName='CURRENCYCODE'\",            \"sortBy: paymentCurrencyHierarchy.currencyCode:asc\",            \"limit: 20\"          ],          \"notes\": \"Use this AV directly for the all-currency summary. Do not include checkrunId when the user provides only the PPR name.\"        },        {          \"name\": \"dueDateAndPaymentTimingSummary\",          \"description\": \"Summarize payment-run installment value by due date, payment date, or payment-run creation date.\",          \"when\": \"User asks whether payment-run installments are due soon, overdue, scheduled for a payment date, or concentrated in a payment-date window.\",          \"fieldsToReturn\": [            \"paymentAmount\",            \"installmentPayments\",            \"dueDateHierarchy\",            \"paymentDateHierarchy\",            \"paymentProcessRequestDateHierarchy\",            \"paymentCurrencyHierarchy\",            \"paymentProcessRequestHierarchy\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestHierarchy.name='<PPR_NAME_FROM_USER>' or paymentProcessRequestHierarchy.paymentProcessRequestId=<PPR_ID_FROM_USER>\"          ],          \"notes\": \"Use dueDateHierarchy for installment urgency and paymentDateHierarchy for payment timing. Use detail shapes when the user needs invoice or installment rows.\"        },        {          \"name\": \"bankAccountFundingCheckAcrossAllPprs\",          \"description\": \"Summarize payment-run installment value by disbursement bank account across all PPRs so funding sufficiency can be checked.\",          \"when\": \"User asks to display payments grouped by bank account, verify funding sufficiency in each account, or review bank-account-level payment exposure across all PPRs.\",          \"fieldsToReturn\": [            \"bankAccountHierarchy.bankAccountName\",            \"paymentCurrencyHierarchy.currencyCode\",            \"paymentAmount\",            \"payments\"          ],          \"extraFilterExpressions\": [            \"filterfact: null\",            \"filter: bankAccountHierarchy.$levelName='BANKACCOUNT' AND paymentCurrencyHierarchy.$levelName='CURRENCYCODE'\",            \"sortBy: bankAccountHierarchy.bankAccountName:asc\",            \"limit: 20\"          ],          \"notes\": \"Use this for an all-PPR bank-account funding view. Keep paymentCurrencyHierarchy.$levelName='CURRENCYCODE' whenever currencyCode is included in fieldsToReturn. Do not add a PPR filterfact because the user asked for all PPRs. This is a grouped summary; compute funding sufficiency outside the AV if the user wants account balance comparisons.\"        },        {          \"name\": \"bankAccountErrorImpactInPaymentRunSummary\",          \"description\": \"Summarize payment-run installment value impacted by bank-account-related issues for a run, using generated datetime bounds instead of SYSDATE.\",          \"when\": \"User asks for a payment-run summary of installments excluded or impacted by bank account errors, but the request must be answered from the AV summary layer rather than row-level exception data.\",          \"fieldsToReturn\": [            \"paymentAmount\",            \"installmentPayments\",            \"paymentCurrencyHierarchy\",            \"paymentProcessRequestHierarchy\",            \"bankAccountHierarchy\",            \"paymentMethodHierarchy\",            \"paymentRunInstallmentStatusHierarchy\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestHierarchy.name='<PPR_NAME_FROM_USER>' or paymentProcessRequestHierarchy.paymentProcessRequestId=<PPR_ID_FROM_USER>\",            \"paymentProcessRequestDateHierarchy.calendarDate >= <GENERATED_START_DATETIME>\",            \"paymentProcessRequestDateHierarchy.calendarDate < <GENERATED_END_DATETIME>\"          ],          \"notes\": \"This AV does not expose exception text, rejected group id, or transactionType, so it cannot filter directly on bank-account error messages. Use it only for summary rollups when the business view has already identified the impacted population and provided generated datetime bounds.\"        },        {          \"name\": \"topPayeesByValueInPprWithShareOfBatch\",          \"description\": \"Summarize the top payees by payment amount within a named payment run and compute their share of the total batch amount.\",          \"when\": \"User asks for the top payees by value in a payment run, especially when they also want each payee's percentage of the total batch amount. eg: List the top 5 payees by value \",          \"fieldsToReturn\": [            \"payeePartyHierarchy.payeePartyName\",            \"paymentAmount\",            \"paymentCurrencyHierarchy.currencyCode\"          ],          \"extraFilterExpressions\": [            \"filterfact: paymentProcessRequestHierarchy[name='<PPR_NAME_FROM_USER>']\",            \"filter: paymentProcessRequestHierarchy.$levelName='PAYMENTPROCESSREQUEST' AND payeePartyHierarchy.$levelName='PAYEEPARTY' AND paymentCurrencyHierarchy.$levelName='CURRENCYCODE'\",            \"sortBy: paymentAmount:desc\",            \"limit: <user provided limit value>\"          ],          \"notes\": \"Use this for ranked payee concentration within a single run. Always keep paymentCurrencyHierarchy.$levelName='CURRENCYCODE' whenever paymentCurrencyHierarchy.currencyCode is included in fieldsToReturn or referenced in the query. Compute each payee's percentage of the total batch amount outside the AV by dividing the payee's paymentAmount by the full batch paymentAmount for the same PPR. Do not add extra deduplication logic; this AV already returns grouped payment-run installment summaries.Sort only using paymentAmount:desc\"        },        {          \"name\": \"supplierMajorityShareInPpr\",          \"description\": \"Identify the suppliers that collectively account for the majority of total payment value in a named payment run.\",          \"when\": \"User asks which suppliers represent the majority of the total payment value in a PPR, or asks for the top suppliers that together exceed 50% of the batch amount.\",          \"fieldsToReturn\": [            \"supplierHierarchy.supplierName\",            \"paymentAmount\",            \"paymentCurrencyHierarchy.currencyCode\"          ],          \"extraFilterExpressions\": [            \"filterfact: paymentProcessRequestHierarchy[name='<PPR_NAME_FROM_USER>']\",            \"filter: paymentProcessRequestHierarchy.$levelName='PAYMENTPROCESSREQUEST' AND paymentCurrencyHierarchy.$levelName='CURRENCYCODE' AND supplierHierarchy.$levelName='SUPPLIER'\",            \"sortBy: paymentAmount:desc\",            \"limit: 20\"          ],          \"notes\": \"Use this for majority-share or concentration analysis by supplier within a single PPR. Always keep paymentCurrencyHierarchy.$levelName='CURRENCYCODE' whenever paymentCurrencyHierarchy.currencyCode is included in fieldsToReturn. Sort by paymentAmount descending, then compute each supplier's share of the batch total and the running cumulative share outside the AV. Include suppliers until the cumulative share exceeds 50%. Do not add extra deduplication logic; this AV already returns grouped payment-run installment summaries.\"        },        {          \"name\": \"businessUnitPaymentDistributionByPpr\",          \"description\": \"Summarize payment amount distribution by business unit for a named PPR.\",          \"when\": \"User asks for distribution of payment amounts by business unit in a PPR.\",          \"fieldsToReturn\": [            \"businessUnitHierarchy.businessUnitName\",            \"paymentAmount\",            \"paymentCurrencyHierarchy.currencyCode\"          ],          \"extraFilterExpressions\": [            \"filterfact: paymentProcessRequestHierarchy[name='<PPR_NAME_FROM_USER>']\",            \"filter: paymentProcessRequestHierarchy.$levelName='PAYMENTPROCESSREQUEST' AND businessUnitHierarchy.$levelName='BUSINESSUNIT' AND paymentCurrencyHierarchy.$levelName='CURRENCYCODE'\",            \"sortBy: businessUnitHierarchy.businessUnitName:asc\",            \"limit: 20\"          ],          \"notes\": \"Do not sort by paymentAmount desc for plain distribution requests; use business unit name asc for deterministic distribution output.\"        }      ],      \"additionalInstructions\": [        \"Use this AV for grouped payment-run installment summaries after installments have entered Oracle Payments. It is the summary counterpart to `paymentRunInstallments`; use the BV or extraction wrapper when the user asks for row-level invoice, installment, bank-account, payment, or payment-file detail.\",        \"Use hierarchy names and hierarchy attributes exactly as declared in `fields.dimensions`, such as `paymentProcessRequestHierarchy.name`, `paymentCurrencyHierarchy.currencyCode`, `supplierHierarchy.supplierName`, and `payeePartyHierarchy.payeePartyName`.\",        \"When a named PPR is provided, filter with `paymentProcessRequestHierarchy.name` or `paymentProcessRequestHierarchy.paymentProcessRequestId` and keep the payment process request hierarchy at `PAYMENTPROCESSREQUEST` level.\",        \"Payment and installment amount measures are sums. Always include `paymentCurrencyHierarchy.currencyCode` when returning `paymentAmount`, `installmentPaymentAmount`, `withheldAmount`, or `discount` so values are not mixed across currencies.\",        \"Use `installmentPayments` as the installment/document-payable count measure. Use `invoices`, `payments`, and `paymentInstructions` only when the user needs distinct invoice, payment, or payment-file counts.\",        \"For proposed-payment review rollups from SME guidance, use this AV for business-unit distribution, bank-account funding verification, supplier/payee concentration, and high-value payment summaries. Use `paymentRunInstallmentsExtraction` only for invoice-reference or installment-level drill-down.\",        \"For generic line-level installment review, use `pprInstallmentsDeduplicatedDetails` or the relevant detail shape. For AP-stage selected-installment rollups, prefer `payablesSelectedInstallmentsSummary`; use this AV when the request is explicitly IBY-source, Oracle Payments-stage, payment-run, payment-file, or formed-payment oriented.\",        \"Ensure sorting fields are selected based on the user input context.eg : If user asks to get top values by value/distribution of payment then sort by paymentAmount:desc\",        \"Treat business-driver filters as the required semantic core, not a closed-form query. When the user adds explicit constraints such as date or date range, PPR name/id, supplier, business unit, currency, amount, status, payment method, bank account, or payment file, add those filters when the selected shape exposes the field. A user-provided date filter overrides the default recency window. Do not drop required status, null-rate, source-shape, or sorting rules unless the user explicitly asks for a different lifecycle/source and the selected shape supports it.\",        \"For business-unit distribution, include businessUnitHierarchy.$levelName='BUSINESSUNIT' and paymentCurrencyHierarchy.$levelName='CURRENCYCODE', sort by businessUnitHierarchy.businessUnitName asc before limit 20 unless the user explicitly asks for top values.\",        \"For 'Review proposed payments for all PPRs', this AV is the first required query context with filterfact null, paymentProcessRequestHierarchy/paymentCurrencyHierarchy level filters, sort by paymentProcessRequestHierarchy.paymentProcessRequestId asc, limit 20.\"      ],      \"fieldSelectionRuleUsage\": {        \"match\": \"Choose the closest questionExamples entry for the user request.\",        \"fields\": \"Use the matching fields value exactly and preserve order.\",        \"paraphrases\": \"Use the same fields for paraphrased or equivalent requests.\",        \"addFieldsOnlyWhen\": \"The user explicitly asks for more displayed columns, or the field is required for filter, sort, group, key, or deeplink handling.\"      },      \"fieldSelectionRules\": [        {          \"questionExamples\": [            \"Display payments grouped by bank account so I can verify we have sufficient funds in each for all PPR\"          ],          \"queryType\": \"AV\",          \"fields\": \"bankAccountHierarchy.bankAccountName,paymentCurrencyHierarchy.currencyCode,paymentAmount,payments\",          \"fieldOrderLocked\": true        },        {          \"questionExamples\": [            \"List the top 5 payees by value in this run for zBIQA_March_30 and their percentage of the total batch amount.\"          ],          \"queryType\": \"AV\",          \"fields\": \"payeePartyHierarchy.payeePartyName,paymentAmount,paymentCurrencyHierarchy.currencyCode\",          \"fieldOrderLocked\": true        },        {          \"questionExamples\": [            \"Review proposed payments for all PPRs\"          ],          \"queryType\": \"AV\",          \"fields\": \"paymentProcessRequestHierarchy.paymentProcessRequestId,paymentProcessRequestHierarchy.name,paymentAmount,installmentPayments,paymentCurrencyHierarchy.currencyCode\",          \"fieldOrderLocked\": true,          \"shape\": \"paymentRunInstallmentSummaries\",          \"filterfact\": null,          \"filter\": \"paymentProcessRequestHierarchy.$levelName='PAYMENTPROCESSREQUEST' AND paymentCurrencyHierarchy.$levelName='CURRENCYCODE'\",          \"sortBy\": \"paymentProcessRequestHierarchy.paymentProcessRequestId:asc\",          \"limit\": 20,          \"notes\": \"First required query context for Review proposed payments for all PPRs. Do not add PENDING_REVIEW filterfact; do not replace with disbursementPayments.\"        },        {          \"questionExamples\": [            \"Show me all PPRs pending approval\"          ],          \"queryType\": \"AV\",          \"fields\": \"paymentProcessRequestHierarchy.name,paymentAmount,installmentPayments,paymentCurrencyHierarchy.currencyCode,paymentProcessRequestStatusHierarchy.paymentProcessRequestStatus,paymentProcessRequestStatusHierarchy.paymentProcessRequestStatusCode,paymentProcessRequestDateHierarchy.calendarDate\",          \"fieldOrderLocked\": true        },        {          \"questionExamples\": [            \"Show me the distribution of payment amounts by business unit in PPR IBYBAT-AP3-2\"          ],          \"queryType\": \"AV\",          \"fields\": \"businessUnitHierarchy.businessUnitName,paymentAmount,paymentCurrencyHierarchy.currencyCode\",          \"fieldOrderLocked\": true        },        {          \"questionExamples\": [            \"which suppliers represent Majority of the total payment value for PPR <PPR Name>\"          ],          \"queryType\": \"AV\",          \"shape\": \"paymentRunInstallmentSummaries\",          \"fields\": \"supplierHierarchy.supplierName,paymentAmount,paymentCurrencyHierarchy.currencyCode\",          \"fieldOrderLocked\": true        }      ]    },    \"pprInstallmentsDeduplicatedDetails\": {      \"key\": \"pprInstallmentsDeduplicatedDetails\",      \"name\": \"pprInstallmentsDeduplicatedDetails\",      \"type\": \"EXTRACTION\",      \"shapeRole\": \"detail\",      \"module\": null,      \"businessObject\": null,      \"description\": \"Primary runtime extraction for line-level PPR installment detail. Use this shape by default when the user asks to list, show, or drill into installments under a PPR unless the PPR status is already resolved to a single AP or IBY source and a source-specific field is required. It returns concise business-facing installment rows after combining AP selected-installment rows and Oracle Payments payment-run rows and deduplicating by invoice id and installment number.\",      \"exampleQuestions\": [        \"List the installments for PPR zBIA_Payment\",        \"Show line-level installment details under this payment process request\",        \"List installments for supplier Advanced Network Devices in PPR gapr_ppr_test_4\",        \"Show selected installments plus payment run installments for this PPR without duplicate invoice installments\"      ],      \"fields\": {        \"fields\": [          \"pprName\",          \"checkrunId\",          \"supplierName\",          \"supplierTypeLookupCode\",          \"supplierTypeMeaning\",          \"invoiceNumber\",          \"invoiceId\",          \"installmentNumber\",          \"dueDate\",          \"invoiceCurrencyCode\",          \"paymentCurrencyCode\",          \"paymentAmount\",          \"unpaidAmount\",          \"withheldAmount\",          \"discountAmount\",          \"pprStatusCode\",          \"pprStatus\",          \"sourceStage\"        ],        \"fieldAlias\": {          \"PPR Name\": \"pprName\",          \"PPR ID\": \"checkrunId\",          \"Supplier\": \"supplierName\",          \"Supplier Type Code\": \"supplierTypeLookupCode\",          \"Supplier Type\": \"supplierTypeMeaning\",          \"Invoice Number\": \"invoiceNumber\",          \"Invoice ID\": \"invoiceId\",          \"Installment Number\": \"installmentNumber\",          \"Due Date\": \"dueDate\",          \"Invoice Currency\": \"invoiceCurrencyCode\",          \"Payment Currency\": \"paymentCurrencyCode\",          \"Payment Amount\": \"paymentAmount\",          \"Unpaid Amount\": \"unpaidAmount\",          \"Withheld Amount\": \"withheldAmount\",          \"Discount Amount\": \"discountAmount\",          \"PPR Status\": \"pprStatus\",          \"PPR Status Code\": \"pprStatusCode\",          \"Lifecycle Source\": \"sourceStage\"        }      },      \"supportedFilters\": [        {          \"name\": \"pprName\",          \"attribute\": \"pprName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Fallback PPR filter when no payment process request/checkrun identifier is available. Prefer checkrunId/PPR ID whenever entity resolution supplies it.\",          \"valueFromUser\": \"PPR Name\"        },        {          \"name\": \"checkrunId\",          \"attribute\": \"checkrunId\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Preferred PPR filter when the user or entity resolution supplies a payment process request/checkrun identifier. Normalize branch values with TO_CHAR before comparing because AP checkrunId and Payments sourceProductFirstUniqueIdentifier can have different physical datatypes.\",          \"valueFromUser\": \"PPR ID\"        },        {          \"name\": \"supplierName\",          \"attribute\": \"supplierName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters installment details by supplier or payee name.\",          \"valueFromUser\": \"Supplier\"        },        {          \"name\": \"supplierTypeLookupCode\",          \"attribute\": \"supplierSite.supplier.supplierType.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters PPR installment details by supplier type, category, class, or similar supplier classifier. This classifier is available from the payment-run branch; in the deduplicated extraction, project supplier type as null in branches that do not expose it and apply the mandatory predicate after normalization so rows without a known matching supplier type are excluded.\",          \"valueFromUser\": \"Supplier Type Code\"        },        {          \"name\": \"supplierTypeMeaning\",          \"attribute\": \"supplierSite.supplier.supplierType.meaning\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters PPR installment details by the display meaning of a supplier type, category, class, or similar supplier classifier. Prefer the lookup-code filter when the code can be resolved.\",          \"valueFromUser\": \"Supplier Type\"        },        {          \"name\": \"invoiceNumber\",          \"attribute\": \"invoiceNumber\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters installment details by invoice number.\",          \"valueFromUser\": \"Invoice Number\"        },        {          \"name\": \"installmentNumber\",          \"attribute\": \"installmentNumber\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters to a specific installment number, preferably together with invoice or PPR context.\",          \"valueFromUser\": \"Installment Number\"        },        {          \"name\": \"paymentCurrencyCode\",          \"attribute\": \"paymentCurrencyCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters installment details by payment currency.\",          \"valueFromUser\": \"Payment Currency\"        },        {          \"name\": \"paymentAmount\",          \"attribute\": \"paymentAmount\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use for amount-threshold detail questions such as installments over 50000.\",          \"valueFromUser\": \"Payment Amount\"        },        {          \"name\": \"withheldAmount\",          \"attribute\": \"withheldAmount\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks which installments have withholding tax applied. For withholding-applied detail, filter the normalized or deduplicated installment rows to withheldAmount > 0.\",          \"valueFromUser\": \"Withheld Amount\"        },        {          \"name\": \"dueDate\",          \"attribute\": \"dueDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for installments due on or within a date range.\",          \"valueFromUser\": \"Due Date or date range\"        },        {          \"name\": \"pprStatusCode\",          \"attribute\": \"pprStatusCode\",          \"type\": \"string\",          \"possibleValues\": [            \"CANCELING\",            \"TERMINATED\"          ],          \"usage\": \"Use only for mixed-source status-scoped detail where the status can exist in both AP and IBY. For AP-only or IBY-only statuses, use the individual source shape instead of this deduplicated extraction.\",          \"valueFromUser\": \"PPR Status Code\"        }      ],      \"dateFilterGuidance\": {        \"description\": \"Use dueDate only when the user explicitly asks for installment due-date filtering or sorting.\",        \"patterns\": [          {            \"userRequest\": \"installments due today, due this week, overdue, or due in a range\",            \"clause\": \"apply the resolved date window to dueDate in both selected and payment-run branches before deduplication\"          }        ]      },      \"extractionQuery\": {        \"viewQueries\": {          \"sel\": {            \"module\": \"oraErpCorePayablesPayments\",            \"view\": \"selectedPaymentInstallments\",            \"businessObject\": \"PayablesPaymentProcessRequestSelectedInvoiceInstallment\",            \"fieldAliases\": {              \"payablesPaymentProcessRequest.checkrunName\": \"pprName\",              \"payablesPaymentProcessRequest.checkrunId\": \"checkrunId\",              \"invoiceId\": \"invoiceId\",              \"installmentNumber\": \"installmentNumber\",              \"installmentRank\": \"installmentRank\",              \"originalInvoiceTransaction.invoiceId\": \"originalInvoiceId\",              \"originalPaymentNumber\": \"originalPaymentNumber\",              \"okToPayFlag\": \"okToPayFlag\",              \"payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\": \"pprStatusCode\",              \"invoiceNumber\": \"invoiceNumber\",              \"dueDate\": \"dueDate\",              \"supplier.name\": \"supplierName\",              \"invoiceCurrency.currencyCode\": \"invoiceCurrencyCode\",              \"paymentCurrency.currencyCode\": \"paymentCurrencyCode\",              \"paymentAmount\": \"paymentAmount\",              \"amountRemaining\": \"unpaidAmount\",              \"withheldTax\": \"withheldAmount\",              \"discount\": \"discountAmount\",              \"payablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\": \"pprStatus\"            }          },          \"run\": {            \"module\": \"oraErpCorePaymentsFundsDisbursement\",            \"view\": \"paymentRunInstallments\",            \"businessObject\": \"PayablesDocumentPayable\",            \"fieldAliases\": {              \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\": \"pprName\",              \"sourceProductFirstUniqueIdentifier\": \"checkrunId\",              \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\": \"pprStatusCode\",              \"payablesInvoiceInstallment.invoiceId\": \"invoiceId\",              \"payablesInvoiceInstallment.installmentNumber\": \"installmentNumber\",              \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\": \"invoiceNumber\",              \"payablesInvoiceInstallment.dueDate\": \"dueDate\",              \"payeeParty.name\": \"supplierName\",              \"supplierSite.supplier.supplierType.lookupCode\": \"supplierTypeLookupCode\",              \"supplierSite.supplier.supplierType.meaning\": \"supplierTypeMeaning\",              \"documentCurrencyCode\": \"invoiceCurrencyCode\",              \"paymentCurrencyCode\": \"paymentCurrencyCode\",              \"amountToBePaid\": \"paymentAmount\",              \"payablesInvoiceInstallment.unpaidAmount\": \"unpaidAmount\",              \"withheldAmount\": \"withheldAmount\",              \"discount\": \"discountAmount\",              \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\": \"pprStatus\"            }          }        },        \"namedSelects\": [          {            \"name\": \"filteredSelectedInvoiceInstallments\",            \"select\": \"SELECT sel.pprName AS pprName,TO_CHAR(sel.checkrunId) AS checkrunId,sel.supplierName AS supplierName,CAST(NULL AS VARCHAR2(4000)) AS supplierTypeLookupCode,CAST(NULL AS VARCHAR2(4000)) AS supplierTypeMeaning,sel.invoiceNumber AS invoiceNumber,sel.invoiceId AS invoiceId,sel.installmentNumber AS installmentNumber,sel.dueDate AS dueDate,sel.invoiceCurrencyCode AS invoiceCurrencyCode,sel.paymentCurrencyCode AS paymentCurrencyCode,sel.paymentAmount AS paymentAmount,sel.unpaidAmount AS unpaidAmount,sel.withheldAmount AS withheldAmount,sel.discountAmount AS discountAmount,sel.pprStatusCode AS pprStatusCode,sel.pprStatus AS pprStatus FROM sel WHERE sel.originalInvoiceId IS NULL AND sel.originalPaymentNumber IS NULL AND sel.okToPayFlag = 'Y' AND sel.pprName NOT IN (SELECT run.pprName FROM run)\"          }        ],        \"select\": \"SELECT pprName,checkrunId,supplierName,invoiceNumber,invoiceId,installmentNumber,dueDate,invoiceCurrencyCode,paymentCurrencyCode,paymentAmount,unpaidAmount,withheldAmount,discountAmount,pprStatusCode,pprStatus,sourceStage FROM ( SELECT MAX(pprName) AS pprName,MAX(checkrunId) AS checkrunId,MAX(supplierName) AS supplierName,MAX(invoiceNumber) AS invoiceNumber,invoiceId,installmentNumber,MAX(dueDate) AS dueDate,MAX(invoiceCurrencyCode) AS invoiceCurrencyCode,MAX(paymentCurrencyCode) AS paymentCurrencyCode,MAX(paymentAmount) AS paymentAmount,MAX(unpaidAmount) AS unpaidAmount,MAX(withheldAmount) AS withheldAmount,MAX(discountAmount) AS discountAmount,MAX(pprStatusCode) AS pprStatusCode,MAX(pprStatus) AS pprStatus,MAX(sourceStage) AS sourceStage FROM ( SELECT filteredSelectedInvoiceInstallments.pprName AS pprName,filteredSelectedInvoiceInstallments.checkrunId AS checkrunId,filteredSelectedInvoiceInstallments.supplierName AS supplierName,filteredSelectedInvoiceInstallments.invoiceNumber AS invoiceNumber,filteredSelectedInvoiceInstallments.invoiceId AS invoiceId,filteredSelectedInvoiceInstallments.installmentNumber AS installmentNumber,filteredSelectedInvoiceInstallments.dueDate AS dueDate,filteredSelectedInvoiceInstallments.invoiceCurrencyCode AS invoiceCurrencyCode,filteredSelectedInvoiceInstallments.paymentCurrencyCode AS paymentCurrencyCode,filteredSelectedInvoiceInstallments.paymentAmount AS paymentAmount,filteredSelectedInvoiceInstallments.unpaidAmount AS unpaidAmount,filteredSelectedInvoiceInstallments.withheldAmount AS withheldAmount,filteredSelectedInvoiceInstallments.discountAmount AS discountAmount,filteredSelectedInvoiceInstallments.pprStatusCode AS pprStatusCode,filteredSelectedInvoiceInstallments.pprStatus AS pprStatus,'AP selection' AS sourceStage FROM filteredSelectedInvoiceInstallments WHERE filteredSelectedInvoiceInstallments.pprName IN (<PPR_NAME_FROM_USER>) UNION ALL SELECT run.pprName AS pprName,TO_CHAR(run.checkrunId) AS checkrunId,run.supplierName AS supplierName,run.invoiceNumber AS invoiceNumber,run.invoiceId AS invoiceId,run.installmentNumber AS installmentNumber,run.dueDate AS dueDate,run.invoiceCurrencyCode AS invoiceCurrencyCode,run.paymentCurrencyCode AS paymentCurrencyCode,run.paymentAmount AS paymentAmount,run.unpaidAmount AS unpaidAmount,run.withheldAmount AS withheldAmount,run.discountAmount AS discountAmount,run.pprStatusCode AS pprStatusCode,run.pprStatus AS pprStatus,'Payment execution' AS sourceStage FROM run WHERE run.pprName IN (<PPR_NAME_FROM_USER>) ) GROUP BY invoiceId,installmentNumber ) where ROWNUM<=20\",        \"return\": [          {            \"name\": \"pprName\",            \"type\": \"string\"          },          {            \"name\": \"checkrunId\",            \"type\": \"string\"          },          {            \"name\": \"supplierName\",            \"type\": \"string\"          },          {            \"name\": \"invoiceNumber\",            \"type\": \"string\"          },          {            \"name\": \"invoiceId\",            \"type\": \"int64\"          },          {            \"name\": \"installmentNumber\",            \"type\": \"int64\"          },          {            \"name\": \"dueDate\",            \"type\": \"date\"          },          {            \"name\": \"invoiceCurrencyCode\",            \"type\": \"string\"          },          {            \"name\": \"paymentCurrencyCode\",            \"type\": \"string\"          },          {            \"name\": \"paymentAmount\",            \"type\": \"string\"          },          {            \"name\": \"unpaidAmount\",            \"type\": \"string\"          },          {            \"name\": \"withheldAmount\",            \"type\": \"string\"          },          {            \"name\": \"discountAmount\",            \"type\": \"string\"          },          {            \"name\": \"pprStatusCode\",            \"type\": \"string\"          },          {            \"name\": \"pprStatus\",            \"type\": \"string\"          },          {            \"name\": \"sourceStage\",            \"type\": \"string\"          }        ]      },      \"businessDrivers\": [        {          \"name\": \"deduplicatedDetailsByPpr\",          \"description\": \"Concise line-level installment details under one PPR after combining AP selected-installment rows and payment-run rows.\",          \"when\": \"User explicitly asks to list, show, or return line-level installments under a PPR and the source is selected installments plus payment run installments with deduplication because status is unknown, mixed-source, or spans AP and IBY.\",          \"fieldsToReturn\": [            \"pprName\",            \"checkrunId\",            \"supplierName\",            \"invoiceNumber\",            \"installmentNumber\",            \"dueDate\",            \"paymentCurrencyCode\",            \"paymentAmount\",            \"pprStatusCode\",            \"pprStatus\"          ],          \"extraFilterExpressions\": [            \"TO_CHAR(sel.checkrunId) IN (<PPR_ID_FROM_USER>) when PPR ID is available; otherwise sel.pprName IN (<PPR_NAME_FROM_USER>); plus sel.originalInvoiceId IS NULL and sel.originalPaymentNumber IS NULL and sel.okToPayFlag = 'Y' and the selected-branch payment-run exclusion predicate\",            \"TO_CHAR(run.checkrunId) IN (<PPR_ID_FROM_USER>) when PPR ID is available; otherwise run.pprName IN (<PPR_NAME_FROM_USER>)\"          ],          \"notes\": \"Use originalInvoiceId, originalPaymentNumber, and okToPayFlag as selected-branch control aliases for filtering only; originalInvoiceId must be sourced from originalInvoiceTransaction.invoiceId. Mirror the selected-invoice review extraction by excluding AP selected rows when the same PPR already appears in the payment-run branch, then UNION ALL payment-run rows and deduplicate the final detail population by invoiceId and installmentNumber. Do not return control aliases in the final detail table unless the user asks for diagnostic/source fields. If the user filters by a mixed-source status, apply pprStatusCode in ('CANCELING','TERMINATED') inside both source branches before the UNION ALL.\"        },        {          \"name\": \"deduplicatedDetailsByPprAndSupplier\",          \"description\": \"Concise line-level installment details under one PPR for a requested supplier.\",          \"when\": \"User asks to list installments for a supplier or payee in a PPR and the lifecycle source is unresolved or mixed-source.\",          \"fieldsToReturn\": [            \"pprName\",            \"checkrunId\",            \"supplierName\",            \"invoiceNumber\",            \"installmentNumber\",            \"dueDate\",            \"paymentCurrencyCode\",            \"paymentAmount\",            \"pprStatusCode\",            \"pprStatus\"          ],          \"extraFilterExpressions\": [            \"TO_CHAR(sel.checkrunId) IN (<PPR_ID_FROM_USER>) when PPR ID is available; otherwise sel.pprName IN (<PPR_NAME_FROM_USER>); plus sel.supplierName IN (<SUPPLIER_NAME_FROM_USER>), sel.originalInvoiceId IS NULL, sel.originalPaymentNumber IS NULL, sel.okToPayFlag = 'Y', and the selected-branch payment-run exclusion predicate\",            \"TO_CHAR(run.checkrunId) IN (<PPR_ID_FROM_USER>) when PPR ID is available; otherwise run.pprName IN (<PPR_NAME_FROM_USER>); plus run.supplierName IN (<SUPPLIER_NAME_FROM_USER>)\"          ],          \"notes\": \"Apply the supplier predicate inside each source branch, keep the selected-branch payment-run exclusion predicate, then deduplicate by invoiceId and installmentNumber.\"        },        {          \"name\": \"deduplicatedDetailsByPprAndWithholdingTax\",          \"description\": \"Line-level installment details under one PPR where withholding tax is applied.\",          \"when\": \"User asks which installments in a PPR have withholding tax applied, tax withheld, or nonzero withheld amount.\",          \"fieldsToReturn\": [            \"pprName\",            \"checkrunId\",            \"supplierName\",            \"invoiceNumber\",            \"installmentNumber\",            \"dueDate\",            \"paymentCurrencyCode\",            \"paymentAmount\",            \"withheldAmount\",            \"pprStatusCode\",            \"pprStatus\"          ],          \"extraFilterExpressions\": [            \"TO_CHAR(sel.checkrunId) IN (<PPR_ID_FROM_USER>) when PPR ID is available; otherwise sel.pprName IN (<PPR_NAME_FROM_USER>); plus sel.originalInvoiceId IS NULL, sel.originalPaymentNumber IS NULL, sel.okToPayFlag = 'Y', and the selected-branch payment-run exclusion predicate\",            \"TO_CHAR(run.checkrunId) IN (<PPR_ID_FROM_USER>) when PPR ID is available; otherwise run.pprName IN (<PPR_NAME_FROM_USER>)\",            \"withheldAmount>0 after source normalization and deduplication\"          ],          \"notes\": \"Normalize both AP selected and payment-run rows with withheldAmount, keep the selected-branch payment-run exclusion predicate, deduplicate by invoiceId and installmentNumber, then return only rows where NVL(withheldAmount,0) > 0. If the user also asks for total withheld amount by supplier, tax authority, or payee, use a separate pprInstallmentsDeduplicatedSummary step for the grouped count and total; do not infer counts from this capped detail list.\"        },        {          \"name\": \"deduplicatedDetailsByPprAndSupplierType\",          \"description\": \"Concise line-level installment details under one PPR for a requested supplier type, category, class, or similar supplier classifier.\",          \"when\": \"User asks to list or show installments under a PPR and filters by supplier type, supplier category, supplier class, or a similar supplier classifier while the lifecycle source is unresolved or mixed-source.\",          \"fieldsToReturn\": [            \"pprName\",            \"checkrunId\",            \"supplierName\",            \"supplierTypeMeaning\",            \"invoiceNumber\",            \"installmentNumber\",            \"dueDate\",            \"paymentCurrencyCode\",            \"paymentAmount\",            \"pprStatusCode\",            \"pprStatus\"          ],          \"extraFilterExpressions\": [            \"TO_CHAR(sel.checkrunId) IN (<PPR_ID_FROM_USER>) when PPR ID is available; otherwise sel.pprName IN (<PPR_NAME_FROM_USER>); plus sel.originalInvoiceId IS NULL, sel.originalPaymentNumber IS NULL, sel.okToPayFlag = 'Y', the selected-branch payment-run exclusion predicate, and project NULL AS supplierTypeLookupCode and NULL AS supplierTypeMeaning\",            \"TO_CHAR(run.checkrunId) IN (<PPR_ID_FROM_USER>) when PPR ID is available; otherwise run.pprName IN (<PPR_NAME_FROM_USER>); add run.supplierTypeLookupCode='<SUPPLIER_TYPE_CODE_FROM_USER>' when a supplier type code can be resolved\",            \"TO_CHAR(run.checkrunId) IN (<PPR_ID_FROM_USER>) when PPR ID is available; otherwise run.pprName IN (<PPR_NAME_FROM_USER>); add run.supplierTypeMeaning='<SUPPLIER_TYPE_MEANING_FROM_USER>' when only the supplier type meaning is available\"          ],          \"notes\": \"Supplier type is branch-scoped in this extraction because the AP selected-installment branch does not expose the classifier. Keep the deduplicated PPR installment shape as the population owner, project NULL supplier type aliases in branches that do not expose them, apply the mandatory supplier-type predicate where the alias is populated, keep the selected-branch payment-run exclusion predicate, and deduplicate by invoiceId and installmentNumber. If the user also provides an amount threshold, apply paymentAmount in both branches before deduplication.\"        }      ],      \"additionalInstructions\": [        \"Use this extraction as the primary detail source for selected-installment list, show, and drill-down requests under a PPR.\",        \"Keep this extraction as the primary line-level population for 'installments under/in/for a PPR' when the lifecycle source is unknown, mixed, or could span AP and IBY rows.\",        \"Do not replace this deduplicated population with selectedPaymentInstallments, paymentRunInstallments, or raw detail BVs solely because one source exposes an extra classifier. Use a source-specific shape only when the user explicitly asks for that source, when the PPR status resolves to one lifecycle source, or when the requested output is inherently source-specific.\",        \"For branch-scoped filters such as supplier type or supplier category, project NULL aliases in branches that do not expose the classifier, project the real aliases in branches that do, and apply the mandatory predicate without inventing fields for unsupported branches.\",        \"For generic line-level installment review, choose this shape before selectedPaymentInstallments, paymentRunInstallments, or other raw detail BVs.\",        \"Do not use this deduplicated detail extraction when the PPR status maps to a single source. AP-only statuses must use selectedPaymentInstallments, and IBY-only statuses must use paymentRunInstallments.\",        \"Use this deduplicated detail extraction when the status is unknown, the request spans AP and IBY statuses, or the requested status is mixed-source such as CANCELING or TERMINATED.\",        \"For the AP selected branch, project originalInvoiceTransaction.invoiceId as the SQL alias originalInvoiceId, include originalPaymentNumber and okToPayFlag in the branch select when needed for filtering, and apply originalInvoiceId IS NULL, originalPaymentNumber IS NULL, okToPayFlag = 'Y', and the selected-branch payment-run exclusion predicate before the UNION ALL.\",        \"For unresolved-source detail review, use the tested selected-branch gate: include AP selected rows only when the same PPR is not already present in the payment-run branch, then UNION ALL payment-run rows and deduplicate by invoiceId and installmentNumber.\",        \"For payment-run rows, map sourceProductFirstUniqueIdentifier to checkrunId so payment-run data groups with the AP selected-invoice CHECKRUN_ID.\",        \"When both PPR name and PPR ID/checkrunId are available, filter by TO_CHAR(checkrunId) in every branch instead of filtering by pprName. Use pprName only when the ID is unavailable.\",        \"For withholding-tax detail, filter the deduplicated business-installment set to withheldAmount > 0 and include withheldAmount in the output.\",        \"For summary-only review, prefer pprInstallmentsDeduplicatedSummary instead of deriving full-set facts from this capped detail list.\",        \"Keep the final detail result capped at 20 rows and do not infer total installment counts from the returned detail rows.\"      ]    },    \"selectedPaymentInstallments\": {      \"key\": \"selectedPaymentInstallments\",      \"name\": \"selectedPaymentInstallments\",      \"type\": \"BV\",      \"shapeRole\": \"detail\",      \"module\": \"oraErpCorePayablesPayments\",      \"businessObject\": \"PayablesPaymentProcessRequestSelectedInvoiceInstallment\",      \"api\": \"objects/ora/erpCore/payablesPayments/v1/selectedPaymentInstallments\",      \"description\": \"Use this AP-source BV only when the PPR status is resolved to an AP-stage status or when the user asks for AP-only selected-installment attributes such as missing payment conversion rates, missing cross-currency rates, dynamic discount attributes, selected grouping number, or what-if exclusion inputs. Do not use it as the primary shape for generic PPR installment review; use the deduplicated PPR installment extraction shapes first. For missing-rate questions, keep payment conversion-rate gaps separate from cross-currency-rate gaps.\",      \"exampleQuestions\": [        \"Show AP-stage selected installments for payment process request kp6aug2503 in REVIEW status\",        \"Show AP selected installment rows for payment process request zBIA_Payment before payment creation\",        \"List AP selected installments for supplier Vision Operations under PPR zBIA_Payment\",        \"Show invoice, due date, payment amount, and grouping number for AP selected installments in PPR zBIA_Payment\",        \"Show me the AP selected payment distribution by business unit in this PPR\",        \"Which suppliers represent 80% of the AP selected payment value in this PPR?\",        \"Show me all AP selected installments over 100000 with supplier details and invoice references in this PPR\",        \"Which selected installments in PPR zBIA_Payment have dynamic discount details like campaign, APR, and days accelerated?\",        \"Which selected installments in this PPR are missing payment conversion rates?\",        \"Which selected installments in this PPR are missing cross currency rates?\",        \"How are these selected installments grouped into proposed payments before approval?\",        \"If I remove Supplier_X from this run, how much cash will I save today?\",        \"If I remove Invoice XYZ from this run, what will be the total amount paid today?\",        \"If I exclude all standard-priority installments from this run, how much cash will we retain for the week?\",        \"Show me missing payment conversion rates for all PPRs\",        \"Show me missing cross currency rates for all PPRs\",        \"Which currencies are missing payment conversion rates in PPR <PPR_NAME>\",        \"How many installments are blocked due to missing payment conversion rates for <PPR_NAME>?\",        \"Show me missing payment conversion rates where the payment amount exceeds 100 for <PPR_NAME>\",        \"Show me all missing payment conversion rates organized by currency pair for <PPR_NAME>\"      ],      \"fields\": {        \"fields\": [          \"payablesPaymentProcessRequest.checkrunName\",          \"invoiceId\",          \"installmentNumber\",          \"originalInvoiceTransaction.invoiceId\",          \"invoiceNumber\",          \"invoiceDate\",          \"invoiceAmount\",          \"dueDate\",          \"amountRemaining\",          \"paymentAmount\",          \"discount\",          \"okToPayFlag\",          \"paymentPriority\",          \"discountTakenInInvoiceCurrency\",          \"paymentAmountInInvoiceCurrency\",          \"crossCurrencyRate\",          \"withheldTax\",          \"campaignName\",          \"discountAPR\",          \"daysAccelerated\",          \"conversionRateType\",          \"conversionRate\",          \"paymentGroupingNumber\",          \"originalPaymentNumber\",          \"interestAnnualPercent\",          \"installmentRank\",          \"supplier.supplierId\",          \"supplier.name\",          \"businessUnit.id\",          \"businessUnit.name\",          \"legalEntity.legalEntityId\",          \"legalEntity.name\",          \"invoiceCurrency.currencyCode\",          \"paymentCurrency.currencyCode\",          \"payablesPaymentProcessRequest.checkrunId\",          \"payablesPaymentProcessRequest.checkDate\",          \"payablesPaymentProcessRequest.internalBankAccount.id\",          \"payablesPaymentProcessRequest.paymentProcessProfile.paymentProfileId\",          \"payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",          \"payablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\",          \"payablesPaymentProcessRequest.acceleratedInvoicesLookup.lookupCode\",          \"payablesPaymentProcessRequest.acceleratedInvoicesLookup.meaning\",          \"payablesPaymentProcessRequest.paymentMethod.code\",          \"payablesPaymentProcessRequest.paymentProcessRequestTemplate.templateName\",          \"originalInvoiceTransaction.description\",          \"invoicePayment.payment.paymentDate\",          \"remitToSupplier.name\",          \"externalBankAccount.id\",          \"externalBankAccount.bankAccountShortName\",          \"externalBankAccount.branch.name\",          \"externalBankAccount.branch.country.territoryShortName\"        ],        \"accessors\": {          \"invoiceInstallment\": {            \"shape\": \"PayablesInvoiceInstallment\",            \"fields\": [              \"invoiceId\",              \"installmentNumber\",              \"installmentAmount\"            ],            \"accessors\": {              \"financeProgram\": {                \"shape\": \"FinancingProgram\",                \"fields\": [                  \"financingProgramId\",                  \"financingOptionTypeCode\"                ]              }            }          },          \"businessUnit\": {            \"shape\": \"BusinessUnit\",            \"fields\": [              \"id\",              \"name\",              \"effectiveStartDate\",              \"effectiveEndDate\"            ]          },          \"originalInvoiceTransaction\": {            \"shape\": \"PayablesInvoiceTransaction\",            \"fields\": [              \"invoiceId\",              \"description\",              \"invoiceTypeDiscriminator\",              \"invoiceNumber\"            ],            \"accessors\": {              \"paymentFunctionLookup\": {                \"shape\": \"Lookup\",                \"fields\": [                  \"lookupCode\",                  \"lookupType\",                  \"meaning\"                ]              },              \"invoiceSource\": {                \"shape\": \"Lookup\",                \"fields\": [                  \"lookupCode\",                  \"lookupType\",                  \"meaning\"                ]              },              \"invoiceTypeCode\": {                \"shape\": \"Lookup\",                \"fields\": [                  \"lookupCode\",                  \"lookupType\",                  \"meaning\"                ]              },              \"systemOption\": {                \"shape\": \"SystemOption\",                \"fields\": [                  \"businessUnitId\"                ]              },              \"paymentMethod\": {                \"shape\": \"PaymentMethod\",                \"fields\": [                  \"code\"                ]              }            }          },          \"legalEntity\": {            \"shape\": \"LegalEntity\",            \"fields\": [              \"legalEntityId\",              \"name\"            ]          },          \"paymentCurrency\": {            \"shape\": \"Currency\",            \"fields\": [              \"currencyCode\"            ]          },          \"invoiceCurrency\": {            \"shape\": \"Currency\",            \"fields\": [              \"currencyCode\"            ]          },          \"payablesPaymentProcessRequest\": {            \"shape\": \"PayablesPaymentProcessRequest\",            \"fields\": [              \"checkrunId\",              \"checkrunName\",              \"crossCurrencyConversionRateType\",              \"checkDate\"            ],            \"accessors\": {              \"internalBankAccount\": {                \"shape\": \"InternalBankAccount\",                \"fields\": [                  \"id\"                ]              },              \"paymentProcessProfile\": {                \"shape\": \"PaymentProcessProfile\",                \"fields\": [                  \"paymentProfileId\"                ]              },              \"paymentProcessRequestStatus\": {                \"shape\": \"Lookup\",                \"fields\": [                  \"lookupCode\",                  \"lookupType\",                  \"meaning\"                ]              },              \"acceleratedInvoicesLookup\": {                \"shape\": \"Lookup\",                \"fields\": [                  \"lookupCode\",                  \"lookupType\",                  \"meaning\"                ]              },              \"paymentProcessRequestTemplate\": {                \"shape\": \"PaymentProcessRequestTemplate\",                \"fields\": [                  \"templateId\",                  \"templateName\"                ]              },              \"paymentMethod\": {                \"shape\": \"PaymentMethod\",                \"fields\": [                  \"code\"                ]              }            }          },          \"supplierSite\": {            \"shape\": \"SupplierSite\",            \"fields\": [              \"id\"            ]          },          \"supplier\": {            \"shape\": \"Supplier\",            \"fields\": [              \"supplierId\",              \"name\"            ]          },          \"remitToSupplier\": {            \"shape\": \"Supplier\",            \"fields\": [              \"supplierId\",              \"name\"            ]          },          \"invoicePayment\": {            \"shape\": \"PayablesInvoicePayment\",            \"fields\": [              \"invoicePaymentId\"            ],            \"accessors\": {              \"payment\": {                \"shape\": \"Payment\",                \"fields\": [                  \"paymentId\",                  \"paymentDate\"                ]              }            }          },          \"externalBankAccount\": {            \"shape\": \"ExternalBankAccount\",            \"fields\": [              \"id\",              \"bankAccountShortName\"            ],            \"accessors\": {              \"branch\": {                \"shape\": \"BankBranch\",                \"fields\": [                  \"id\",                  \"name\"                ],                \"accessors\": {                  \"country\": {                    \"shape\": \"Country\",                    \"fields\": [                      \"territoryCode\",                      \"territoryShortName\"                    ]                  }                }              }            }          }        },        \"fieldAlias\": {          \"PPR Name\": \"payablesPaymentProcessRequest.checkrunName\",          \"Invoice ID\": \"invoiceId\",          \"Installment Number\": \"installmentNumber\",          \"Original Invoice ID\": \"originalInvoiceTransaction.invoiceId\",          \"Invoice Number\": \"invoiceNumber\",          \"Invoice Date\": \"invoiceDate\",          \"Invoice Amount\": \"invoiceAmount\",          \"Due Date\": \"dueDate\",          \"Amount Remaining\": \"amountRemaining\",          \"Payment Amount\": \"paymentAmount\",          \"Discount\": \"discount\",          \"OK to Pay\": \"okToPayFlag\",          \"Payment Priority\": \"paymentPriority\",          \"Discount Taken (Invoice Currency)\": \"discountTakenInInvoiceCurrency\",          \"Payment Amount (Invoice Currency)\": \"paymentAmountInInvoiceCurrency\",          \"Cross Currency Rate\": \"crossCurrencyRate\",          \"Withheld Tax\": \"withheldTax\",          \"Campaign Name\": \"campaignName\",          \"Discount APR\": \"discountAPR\",          \"Days Accelerated\": \"daysAccelerated\",          \"Conversion Rate Type\": \"conversionRateType\",          \"Conversion Rate\": \"conversionRate\",          \"Payment Grouping Number\": \"paymentGroupingNumber\",          \"Payment Number\": \"paymentNumber\",          \"Original Payment Number\": \"originalPaymentNumber\",          \"Interest Annual Percent\": \"interestAnnualPercent\",          \"Installment Rank\": \"installmentRank\",          \"Supplier ID\": \"supplier.supplierId\",          \"Supplier\": \"supplier.name\",          \"Business Unit ID\": \"businessUnit.id\",          \"Business Unit\": \"businessUnit.name\",          \"Legal Entity ID\": \"legalEntity.legalEntityId\",          \"Legal Entity\": \"legalEntity.name\",          \"Invoice Currency\": \"invoiceCurrency.currencyCode\",          \"Payment Currency\": \"paymentCurrency.currencyCode\",          \"PPR ID\": \"payablesPaymentProcessRequest.checkrunId\",          \"Check Date\": \"payablesPaymentProcessRequest.checkDate\",          \"Disbursement Bank Account ID\": \"payablesPaymentProcessRequest.internalBankAccount.id\",          \"Payment Profile ID\": \"payablesPaymentProcessRequest.paymentProcessProfile.paymentProfileId\",          \"PPR Status Code\": \"payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",          \"PPR Status\": \"payablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\",          \"Accelerated Invoices Code\": \"payablesPaymentProcessRequest.acceleratedInvoicesLookup.lookupCode\",          \"Accelerated Invoices Policy\": \"payablesPaymentProcessRequest.acceleratedInvoicesLookup.meaning\",          \"Payment Method Code\": \"payablesPaymentProcessRequest.paymentMethod.code\",          \"PPR Template\": \"payablesPaymentProcessRequest.paymentProcessRequestTemplate.templateName\",          \"Invoice Description\": \"originalInvoiceTransaction.description\",          \"Payment Date\": \"invoicePayment.payment.paymentDate\",          \"Remit-to Supplier\": \"remitToSupplier.name\",          \"External Bank Account ID\": \"externalBankAccount.id\",          \"External Bank Account\": \"externalBankAccount.bankAccountShortName\",          \"External Bank Branch\": \"externalBankAccount.branch.name\",          \"External Bank Country\": \"externalBankAccount.branch.country.territoryShortName\"        }      },      \"fieldSelection\": {        \"base\": [          \"payablesPaymentProcessRequest.checkrunName\",          \"supplier.name\",          \"invoiceNumber\",          \"installmentNumber\",          \"invoiceDate\",          \"dueDate\",          \"amountRemaining\",          \"paymentAmount\",          \"paymentCurrency.currencyCode\",          \"payablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\"        ],        \"optional\": [          \"invoiceId\",          \"originalInvoiceTransaction.invoiceId\",          \"invoiceAmount\",          \"discount\",          \"okToPayFlag\",          \"paymentPriority\",          \"discountTakenInInvoiceCurrency\",          \"paymentAmountInInvoiceCurrency\",          \"crossCurrencyRate\",          \"withheldTax\",          \"campaignName\",          \"discountAPR\",          \"daysAccelerated\",          \"conversionRateType\",          \"conversionRate\",          \"paymentGroupingNumber\",          \"originalPaymentNumber\",          \"interestAnnualPercent\",          \"installmentRank\",          \"supplier.supplierId\",          \"businessUnit.id\",          \"businessUnit.name\",          \"legalEntity.legalEntityId\",          \"legalEntity.name\",          \"invoiceCurrency.currencyCode\",          \"payablesPaymentProcessRequest.checkrunId\",          \"payablesPaymentProcessRequest.checkDate\",          \"payablesPaymentProcessRequest.internalBankAccount.id\",          \"payablesPaymentProcessRequest.paymentProcessProfile.paymentProfileId\",          \"payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",          \"payablesPaymentProcessRequest.acceleratedInvoicesLookup.lookupCode\",          \"payablesPaymentProcessRequest.acceleratedInvoicesLookup.meaning\",          \"payablesPaymentProcessRequest.paymentMethod.code\",          \"payablesPaymentProcessRequest.paymentProcessRequestTemplate.templateName\",          \"originalInvoiceTransaction.description\",          \"invoicePayment.payment.paymentDate\",          \"remitToSupplier.name\",          \"externalBankAccount.id\",          \"externalBankAccount.bankAccountShortName\",          \"externalBankAccount.branch.name\",          \"externalBankAccount.branch.country.territoryShortName\"        ]      },      \"sortableAttributes\": [        \"payablesPaymentProcessRequest.checkrunName\",        \"invoiceId\",        \"installmentNumber\",        \"supplier.supplierId\",        \"supplier.name\",        \"businessUnit.id\",        \"businessUnit.name\",        \"legalEntity.legalEntityId\",        \"legalEntity.name\",        \"invoiceCurrency.currencyCode\",        \"paymentCurrency.currencyCode\",        \"payablesPaymentProcessRequest.checkrunId\",        \"payablesPaymentProcessRequest.internalBankAccount.id\",        \"payablesPaymentProcessRequest.paymentProcessProfile.paymentProfileId\",        \"payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",        \"payablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\",        \"payablesPaymentProcessRequest.acceleratedInvoicesLookup.lookupCode\",        \"payablesPaymentProcessRequest.acceleratedInvoicesLookup.meaning\",        \"payablesPaymentProcessRequest.paymentMethod.code\",        \"invoicePayment.payment.paymentDate\",        \"remitToSupplier.name\",        \"externalBankAccount.id\",        \"externalBankAccount.bankAccountShortName\",        \"externalBankAccount.branch.name\",        \"externalBankAccount.branch.country.territoryShortName\"      ],      \"filterConditions\": [        {          \"name\": \"payablesPaymentProcessRequest.checkrunId\",          \"attribute\": \"payablesPaymentProcessRequest.checkrunId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides the payment process request identifier.\"        },        {          \"name\": \"payablesPaymentProcessRequest.checkrunName\",          \"attribute\": \"payablesPaymentProcessRequest.checkrunName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user identifies the payment process request by name.\"        },        {          \"name\": \"supplier.supplierId\",          \"attribute\": \"supplier.supplierId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the supplier is resolved to an internal supplier identifier.\"        },        {          \"name\": \"supplier.name\",          \"attribute\": \"supplier.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by supplier name.\"        },        {          \"name\": \"invoiceId\",          \"attribute\": \"invoiceId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the invoice identifier is available.\"        },        {          \"name\": \"originalInvoiceTransaction.invoiceId\",          \"attribute\": \"originalInvoiceTransaction.invoiceId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use =null with originalPaymentNumber=null to exclude interest rows from base selected-invoice review calculations, or match this to invoiceId when locating interest rows.\"        },        {          \"name\": \"originalPaymentNumber\",          \"attribute\": \"originalPaymentNumber\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use =null with originalInvoiceTransaction.invoiceId=null to exclude linked interest rows, or match this to installmentNumber when locating interest rows.\"        },        {          \"name\": \"okToPayFlag\",          \"attribute\": \"okToPayFlag\",          \"type\": \"boolean\",          \"possibleValues\": [            \"Y\",            \"N\"          ],          \"usage\": \"Use okToPayFlag='Y' for selected-installment review totals.\"        },        {          \"name\": \"invoiceNumber\",          \"attribute\": \"invoiceNumber\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by supplier invoice number. This field is not sortable\"        },        {          \"name\": \"installmentNumber\",          \"attribute\": \"installmentNumber\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user requests a specific installment on the invoice. Sort by invoiceNumber is not supported\"        },        {          \"name\": \"dueDate\",          \"attribute\": \"dueDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for installments due on a specific date.\"        },        {          \"name\": \"paymentPriority\",          \"attribute\": \"paymentPriority\",          \"type\": \"int32\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for high or specific payment priority installments.\"        },        {          \"name\": \"paymentAmount\",          \"attribute\": \"paymentAmount\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use for amount-threshold questions such as installments over 50000 or 100000.\"        },        {          \"name\": \"amountRemaining\",          \"attribute\": \"amountRemaining\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for installments with high unpaid amount.\"        },        {          \"name\": \"invoiceCurrency.currencyCode\",          \"attribute\": \"invoiceCurrency.currencyCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for a specific invoice currency or a currency pair.\"        },        {          \"name\": \"paymentCurrency.currencyCode\",          \"attribute\": \"paymentCurrency.currencyCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for a specific payment currency or a currency pair.\"        },        {          \"name\": \"conversionRate\",          \"attribute\": \"conversionRate\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use =null to find selected installments missing a payment conversion rate.\"        },        {          \"name\": \"crossCurrencyRate\",          \"attribute\": \"crossCurrencyRate\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use =null to find selected installments missing a cross-currency rate.\"        },        {          \"name\": \"withheldTax\",          \"attribute\": \"withheldTax\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use for withholding-tax review questions.\"        },        {          \"name\": \"payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",          \"attribute\": \"payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [            \"UNSTARTED\",            \"SELECTING\",            \"SELECTED\",            \"REVIEW\",            \"SUBMITTED\",            \"CALCULATING\",            \"MISSING_X_RATES\",            \"MISSING RATES\",            \"ORA_REFRESH_INSTALLMENTS\",            \"CANCELED\",            \"CANCELLED NO PAYMENTS\"          ],          \"usage\": \"Use this AP-source status filter for all-PPR missing-rate scans only: MISSING RATES for all-PPR missing payment conversion rates and MISSING_X_RATES for all-PPR missing cross-currency rates. For specific-PPR currency questions, counts, and amount-threshold questions, use conversionRate=null or crossCurrencyRate=null without forcing a status filter.\"        },        {          \"name\": \"payablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\",          \"attribute\": \"payablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\",          \"type\": \"string\",          \"possibleValues\": [            \"MISSING RATES\"          ],          \"usage\": \"Use meaning='MISSING RATES' only when the business status meaning is explicitly requested or available for payment conversion-rate review.\"        },        {          \"name\": \"payablesPaymentProcessRequest.acceleratedInvoicesLookup.lookupCode\",          \"attribute\": \"payablesPaymentProcessRequest.acceleratedInvoicesLookup.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about the accelerated-invoice or dynamic-discount policy on the payment process request.\"        },        {          \"name\": \"payablesPaymentProcessRequest.checkDate\",          \"attribute\": \"payablesPaymentProcessRequest.checkDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user compares the scheduled payment date of the run with installment due dates.\"        },        {          \"name\": \"payablesPaymentProcessRequest.paymentMethod.code\",          \"attribute\": \"payablesPaymentProcessRequest.paymentMethod.code\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes selected installments to a payment method on the run.\"        },        {          \"name\": \"remitToSupplier.name\",          \"attribute\": \"remitToSupplier.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for remit-to supplier details for selected installments.\"        },        {          \"name\": \"externalBankAccount.bankAccountShortName\",          \"attribute\": \"externalBankAccount.bankAccountShortName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters selected installments by external bank account.\"        },        {          \"name\": \"businessUnit.id\",          \"attribute\": \"businessUnit.id\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes selected installments to a business unit.\"        },        {          \"name\": \"businessUnit.name\",          \"attribute\": \"businessUnit.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user wants proposed payments grouped or filtered by business unit name.\"        },        {          \"name\": \"paymentGroupingNumber\",          \"attribute\": \"paymentGroupingNumber\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user wants to inspect how installments were grouped into proposed payments before approval.\"        },        {          \"name\": \"payablesPaymentProcessRequest.internalBankAccount.id\",          \"attribute\": \"payablesPaymentProcessRequest.internalBankAccount.id\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user groups proposed payments by the paying internal bank account id.\"        },        {          \"name\": \"payablesPaymentProcessRequest.paymentProcessProfile.paymentProfileId\",          \"attribute\": \"payablesPaymentProcessRequest.paymentProcessProfile.paymentProfileId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes proposed payment review to a payment process profile.\"        },        {          \"name\": \"legalEntity.legalEntityId\",          \"attribute\": \"legalEntity.legalEntityId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes selected installments to a legal entity.\"        },        {          \"name\": \"paymentProcessRequestName\",          \"attribute\": \"paymentProcessRequestName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user identifies the payment process request by name. Default sorting condition.\"        },        {          \"name\": \"originalInvoiceId\",          \"attribute\": \"originalInvoiceId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use =null with originalPaymentNumber=null to exclude interest rows from base selected-invoice review calculations, or match this to invoiceId when locating interest rows.\"        }      ],      \"dateFilterGuidance\": null,      \"extractionQuery\": null,      \"businessDrivers\": [        {          \"name\": \"detailByPpr\",          \"description\": \"AP-stage selected installment rows for a specific payment process request.\",          \"when\": \"User asks to list selected installments in a given PPR and the PPR status is resolved to an AP-only status, or the user explicitly asks for AP selected-source rows.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"dueDate\",            \"amountRemaining\",            \"paymentAmount\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>'\",            \"payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode in ('UNSTARTED','SELECTING','SELECTED','REVIEW','SUBMITTED','CALCULATING','MISSING RATES','MISSING_X_RATES','ORA_REFRESH_INSTALLMENTS','CANCELED','CANCELLED NO PAYMENTS')\",            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"For generic review or unresolved PPR status, use pprInstallmentsDeduplicatedDetails instead.\"        },        {          \"name\": \"detailByPprAndSupplier\",          \"description\": \"AP-stage selected installments for a specific supplier under a payment process request.\",          \"when\": \"User asks to show selected installments for supplier X under PPR Y and the PPR status is resolved to an AP-only status, or the user explicitly asks for AP selected-source rows.\",          \"fieldsToReturn\": [            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"dueDate\",            \"amountRemaining\",            \"paymentAmount\",            \"discount\"          ],          \"extraFilterExpressions\": [            \"(payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>')\",            \"(supplier.supplierId=<SUPPLIER_ID_FROM_USER> or supplier.name='<SUPPLIER_NAME_FROM_USER>')\",            \"payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode in ('UNSTARTED','SELECTING','SELECTED','REVIEW','SUBMITTED','CALCULATING','MISSING RATES','MISSING_X_RATES','ORA_REFRESH_INSTALLMENTS','CANCELED','CANCELLED NO PAYMENTS')\",            \"(payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequestName='<PPR_NAME_FROM_USER>')\"          ],          \"notes\": \"For generic supplier drill-down or unresolved PPR status, use pprInstallmentsDeduplicatedDetails instead.\"        },        {          \"name\": \"discountFocusedByPpr\",          \"description\": \"AP-stage selected installments in a payment process request with dynamic-discount details.\",          \"when\": \"User asks about AP-only discount fields such as campaigns, APR, days accelerated, or selected-source discounted payment behavior for installments selected in a PPR.\",          \"fieldsToReturn\": [            \"invoiceNumber\",            \"installmentNumber\",            \"discount\",            \"discountTakenInInvoiceCurrency\",            \"campaignName\",            \"discountAPR\",            \"daysAccelerated\",            \"interestAnnualPercent\",            \"payablesPaymentProcessRequest.acceleratedInvoicesLookup.meaning\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>'\",            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"\"        },        {          \"name\": \"missingPaymentConversionRatesAllPprs\",          \"description\": \"Selected installments across all PPRs that are missing payment conversion rates.\",          \"when\": \"User asks to show or list missing payment conversion rates across all PPRs as detail rows, and the question is not a count/how-many/grouped/organized summary.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"invoiceCurrency.currencyCode\",            \"paymentCurrency.currencyCode\",            \"invoiceAmount\",            \"paymentAmount\",            \"dueDate\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode = 'MISSING RATES'\"          ],          \"notes\": \"PM guidance: for all-PPR missing payment conversion-rate scans, filter by PPR status only. Do not add conversionRate=null unless the user asks for a specific PPR, currencies, counts, or amount-threshold rows.\"        },        {          \"name\": \"missingCrossCurrencyRatesAllPprs\",          \"description\": \"Selected installments across all PPRs that are missing cross-currency rates.\",          \"when\": \"User asks to show or list missing cross currency rates across all PPRs as detail rows, and the question is not a count/how-many/grouped/organized summary.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"invoiceCurrency.currencyCode\",            \"paymentCurrency.currencyCode\",            \"invoiceAmount\",            \"paymentAmount\",            \"dueDate\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode = 'MISSING_X_RATES'\"          ],          \"notes\": \"PM guidance: plain all-PPR missing cross-currency detail uses PPR status MISSING_X_RATES in selectedPaymentInstallments BV. Do not use extraction for plain show/list detail; use extraction only for count/how-many or grouped/organized summaries.\"        },        {          \"name\": \"missingPaymentConversionRatesByPpr\",          \"description\": \"Selected installments in a specific PPR that are missing payment conversion rates.\",          \"when\": \"User asks which currencies, payments, or installments are missing payment conversion rates in a specific PPR.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"invoiceCurrency.currencyCode\",            \"paymentCurrency.currencyCode\",            \"invoiceAmount\",            \"paymentAmount\",            \"dueDate\"          ],          \"extraFilterExpressions\": [            \"(payablesPaymentProcessRequest.checkrunId = <PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName = '<PPR_NAME_FROM_USER>')\",            \"conversionRate = null\",            \"sortBy: invoiceCurrency.currencyCode:asc\",            \"limit: 20\"          ],          \"notes\": \"PM guidance: for a specific PPR, find missing payment conversion rates with conversionRate=null. Do not force the MISSING RATES status filter.\"        },        {          \"name\": \"missingCrossCurrencyRatesByPpr\",          \"description\": \"Selected installments in a specific PPR that are missing cross-currency rates.\",          \"when\": \"User asks which currencies, payments, or installments are missing cross currency rates in a specific PPR.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"invoiceCurrency.currencyCode\",            \"paymentCurrency.currencyCode\",            \"invoiceAmount\",            \"paymentAmount\",            \"dueDate\"          ],          \"extraFilterExpressions\": [            \"(payablesPaymentProcessRequest.checkrunId = <PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName = '<PPR_NAME_FROM_USER>')\",            \"crossCurrencyRate = null\",            \"sortBy: invoiceCurrency.currencyCode:asc\",            \"limit: 20\"          ],          \"notes\": \"PM guidance: for a specific PPR, find missing cross-currency rates with crossCurrencyRate=null. Do not force the MISSING_X_RATES status filter.\"        },        {          \"name\": \"highValueMissingPaymentConversionRatesAllPprs\",          \"description\": \"Selected installments across all PPRs that are missing payment conversion rates and exceed an amount threshold.\",          \"when\": \"User asks for missing payment conversion rates where the payment or installment amount exceeds a threshold, without specifying a PPR.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"invoiceCurrency.currencyCode\",            \"paymentCurrency.currencyCode\",            \"invoiceAmount\",            \"paymentAmount\",            \"dueDate\"          ],          \"extraFilterExpressions\": [            \"conversionRate = null\",            \"paymentAmount > <AMOUNT_THRESHOLD_FROM_USER_OR_DEFAULT_100000>\"          ],          \"notes\": \"PM guidance: for payment/installment amount threshold questions about missing payment conversion rates, use conversionRate=null plus the amount predicate. Do not force a status filter.\"        },        {          \"name\": \"highValueMissingCrossCurrencyRatesAllPprs\",          \"description\": \"Selected installments across all PPRs that are missing cross-currency rates and exceed an amount threshold.\",          \"when\": \"User asks for missing cross currency rates where the payment or installment amount exceeds a threshold, without specifying a PPR.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"invoiceCurrency.currencyCode\",            \"paymentCurrency.currencyCode\",            \"invoiceAmount\",            \"paymentAmount\",            \"dueDate\"          ],          \"extraFilterExpressions\": [            \"crossCurrencyRate = null\",            \"paymentAmount > <AMOUNT_THRESHOLD_FROM_USER_OR_DEFAULT_100000>\"          ],          \"notes\": \"PM guidance: for payment/installment amount threshold questions about missing cross-currency rates, use crossCurrencyRate=null plus the amount predicate. Do not force a status filter.\"        },        {          \"name\": \"highValueMissingPaymentConversionRatesByPpr\",          \"description\": \"Selected installments in a specific PPR that are missing payment conversion rates and exceed an amount threshold.\",          \"when\": \"User asks for missing payment conversion rates in a specific PPR where the payment or installment amount exceeds a threshold.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"invoiceCurrency.currencyCode\",            \"paymentCurrency.currencyCode\",            \"invoiceAmount\",            \"paymentAmount\",            \"dueDate\"          ],          \"extraFilterExpressions\": [            \"(payablesPaymentProcessRequest.checkrunId = <PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName = '<PPR_NAME_FROM_USER>')\",            \"conversionRate = null\",            \"paymentAmount > <AMOUNT_THRESHOLD_FROM_USER_OR_DEFAULT_100000>\"          ],          \"notes\": \"PM guidance: for PPR-specific amount-threshold questions about missing payment conversion rates, use the PPR filter, conversionRate=null, and amount predicate. Do not force a status filter.\"        },        {          \"name\": \"highValueMissingCrossCurrencyRatesByPpr\",          \"description\": \"Selected installments in a specific PPR that are missing cross-currency rates and exceed an amount threshold.\",          \"when\": \"User asks for missing cross currency rates in a specific PPR where the payment or installment amount exceeds a threshold.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"invoiceCurrency.currencyCode\",            \"paymentCurrency.currencyCode\",            \"invoiceAmount\",            \"paymentAmount\",            \"dueDate\"          ],          \"extraFilterExpressions\": [            \"(payablesPaymentProcessRequest.checkrunId = <PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName = '<PPR_NAME_FROM_USER>')\",            \"crossCurrencyRate = null\",            \"paymentAmount > <AMOUNT_THRESHOLD_FROM_USER_OR_DEFAULT_100000>\"          ],          \"notes\": \"PM guidance: for PPR-specific amount-threshold questions about missing cross-currency rates, use the PPR filter, crossCurrencyRate=null, and amount predicate. Do not force a status filter.\"        },        {          \"name\": \"withholdingTaxByPpr\",          \"description\": \"AP-stage selected installments in a payment process request with withholding tax amounts.\",          \"when\": \"User asks which AP selected-source installments have withholding tax, or the PPR status is resolved to an AP-only status and the user asks for withholding detail.\",          \"fieldsToReturn\": [            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"paymentAmount\",            \"withheldTax\"          ],          \"extraFilterExpressions\": [            \"(payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>')\",            \"withheldTax>0\",            \"payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode in ('UNSTARTED','SELECTING','SELECTED','REVIEW','SUBMITTED','CALCULATING','MISSING RATES','MISSING_X_RATES','ORA_REFRESH_INSTALLMENTS','CANCELED','CANCELLED NO PAYMENTS')\",            \"(payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequestName='<PPR_NAME_FROM_USER>')\"          ],          \"notes\": \"For unresolved source or generic selected-installment review, use the deduplicated extraction shapes first.\"        },        {          \"name\": \"locatePprByInvoice\",          \"description\": \"Locate the payment process request currently carrying a given invoice installment.\",          \"when\": \"User asks which PPR contains or is processing a specific invoice.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"payablesPaymentProcessRequest.checkrunId\",            \"payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",            \"invoiceNumber\",            \"installmentNumber\",            \"supplier.name\"          ],          \"extraFilterExpressions\": [            \"invoiceNumber='<INVOICE_NUMBER_FROM_USER>'\"          ],          \"notes\": \"Add installmentNumber when the user identifies a specific installment.\"        },        {          \"name\": \"installmentsPaidEarlyVsDueDate\",          \"description\": \"Find selected installments whose payment run date is materially earlier than the installment due date.\",          \"when\": \"User asks for installments in a run that are being paid more than a threshold number of days before due date.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"invoiceNumber\",            \"installmentNumber\",            \"dueDate\",            \"payablesPaymentProcessRequest.checkDate\",            \"paymentAmount\",            \"supplier.name\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>'\",            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Compute the day difference between dueDate and payablesPaymentProcessRequest.checkDate outside the base fetch.\"        },        {          \"name\": \"apStageSelectedInstallmentReviewByPpr\",          \"description\": \"Review selected installments while the PPR is still in an AP-source status.\",          \"when\": \"User asks for selected installments and the PPR status is an AP-only status such as selected, review, submitted, calculating, missing rates, refresh installments, canceled, or cancelled no payments.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"paymentGroupingNumber\",            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"dueDate\",            \"paymentAmount\",            \"payablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>'\",            \"payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode in ('UNSTARTED','SELECTING','SELECTED','REVIEW','SUBMITTED','CALCULATING','MISSING RATES','MISSING_X_RATES','ORA_REFRESH_INSTALLMENTS','CANCELED','CANCELLED NO PAYMENTS')\",            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Use payablesSelectedInstallmentsSummary for supported grouped rollups. Aggregate externally over selectedPaymentInstallments only when the requested count, field, or AP-stage detail is not exposed by the summary AV. Do not use this shape for IBY-only statuses.\"        },        {          \"name\": \"distributionByBusinessUnit\",          \"description\": \"Review AP-stage selected payment value by business unit within a PPR.\",          \"when\": \"User asks for payment amounts grouped by business unit in a PPR and the PPR is resolved to an AP-only status, or the user explicitly needs the AP selected-source business unit dimension.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"businessUnit.name\",            \"paymentAmount\",            \"paymentGroupingNumber\",            \"supplier.name\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>'\",            \"payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode in ('UNSTARTED','SELECTING','SELECTED','REVIEW','SUBMITTED','CALCULATING','MISSING RATES','MISSING_X_RATES','ORA_REFRESH_INSTALLMENTS','CANCELED','CANCELLED NO PAYMENTS')\",            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Group externally by businessUnit.name and sum paymentAmount. For generic review without an AP-only status, use the deduplicated summary first.\"        },        {          \"name\": \"supplierValueConcentration\",          \"description\": \"Identify the suppliers that account for most of the AP-stage selected payment value in a PPR.\",          \"when\": \"User asks which suppliers represent 80 percent of the payment value and the PPR is resolved to an AP-only status or explicitly scoped to AP selected-source rows.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"supplier.name\",            \"paymentAmount\",            \"invoiceNumber\",            \"installmentNumber\",            \"paymentGroupingNumber\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>'\",            \"payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode in ('UNSTARTED','SELECTING','SELECTED','REVIEW','SUBMITTED','CALCULATING','MISSING RATES','MISSING_X_RATES','ORA_REFRESH_INSTALLMENTS','CANCELED','CANCELLED NO PAYMENTS')\",            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Sort aggregated supplier totals descending and compute the running cumulative percentage outside the base fetch. For unresolved PPR source, prefer pprInstallmentsDeduplicatedSummary.\"        },        {          \"name\": \"highValueApprovalCandidates\",          \"description\": \"Surface high-value AP-stage selected installments that may need manager review before payment approval.\",          \"when\": \"User asks for payments over a threshold with supplier and invoice references and the PPR is resolved to an AP-only status or explicitly scoped to AP selected-source rows.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"paymentAmount\",            \"dueDate\",            \"payablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\"          ],          \"extraFilterExpressions\": [            \"(payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>')\",            \"paymentAmount>=<AMOUNT_THRESHOLD_FROM_USER_OR_DEFAULT_100000>\",            \"payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode in ('UNSTARTED','SELECTING','SELECTED','REVIEW','SUBMITTED','CALCULATING','MISSING RATES','MISSING_X_RATES','ORA_REFRESH_INSTALLMENTS','CANCELED','CANCELLED NO PAYMENTS')\",            \"(payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequestName='<PPR_NAME_FROM_USER>')\"          ],          \"notes\": \"Use the companion EV PayablesPaymentProcessRequestDetails to retrieve the run-level approver and pending-since aging.\"        },        {          \"name\": \"installmentAmountVarianceReview\",          \"description\": \"Explain why the AP selected payment amount differs from the invoice amount for installments already included in the run.\",          \"when\": \"User asks why the payment amount for a supplier or invoice differs from the invoice amount and needs AP selected-source fields such as discount, withheld tax, amount remaining, or invoice amount.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"invoiceAmount\",            \"amountRemaining\",            \"paymentAmount\",            \"discount\",            \"withheldTax\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>'\",            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Use the deltas between invoiceAmount, amountRemaining, paymentAmount, discount, and withheldTax to explain the variance.\"        },        {          \"name\": \"whatIfExclusionImpact\",          \"description\": \"Estimate the AP selected-source cash impact of excluding a supplier, invoice, priority band, or date slice from the selected installments in a PPR.\",          \"when\": \"User asks what would happen if they remove a supplier, invoice, or priority group from an AP-stage run before approval.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"paymentPriority\",            \"paymentAmount\",            \"paymentCurrency.currencyCode\",            \"payablesPaymentProcessRequest.checkDate\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>'\",            \"apply the exclusion predicate supplied by the user: supplier.name='<SUPPLIER_NAME_FROM_USER>', invoiceNumber='<INVOICE_NUMBER_FROM_USER>', or paymentPriority=<PAYMENT_PRIORITY_FROM_USER>\",            \"payablesPaymentProcessRequest.checkDate >= <START_DATE> and ayablesPaymentProcessRequest.checkDate <= <END_DATE> when the user gives a date window\",            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequestName='<PPR_NAME_FROM_USER>'\",            \"payablesPaymentProcessRequest.checkDate between <START_DATE> and <END_DATE> when the user gives a date window\"          ],          \"notes\": \"Aggregate the current selected rows externally, subtract the excluded slice, and present before-versus-after totals without implying that the PPR was changed.\"        },        {          \"name\": \"whatIfExcludeStandardPriorityForWeek\",          \"description\": \"Estimate the cash retained for the week by excluding Standard-priority AP selected installments from a PPR.\",          \"when\": \"User asks how much cash will be retained for the week if all Standard-priority payments are excluded from this run.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"paymentPriority\",            \"paymentAmount\",            \"paymentCurrency.currencyCode\",            \"payablesPaymentProcessRequest.checkDate\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>'\",            \"payablesPaymentProcessRequest.checkDate >= <START_OF_WEEK_DATE> and payablesPaymentProcessRequest.checkDate <= <END_OF_WEEK_DATE>\",            \"paymentPriority >= 1 and paymentPriority <= 10\"          ],          \"notes\": \"Treat Standard priority as paymentPriority 1 through 10. Aggregate paymentAmount externally to calculate retained cash for the week. Do not use between; express the date window with >= and <= comparisons. For date filters, do not use natural-language keywords like today or tomorrow. Resolve relative terms such as today, tomorrow, this week, and end of week into explicit ISO dates before building the filter. SQL functions such as SYSDATE, CURRENT_DATE, TRUNC, or similar are not supported and must not be emitted.\"        },        {          \"name\": \"MissingAttributes\",          \"description\": \"Find non-virtual-card document payables missing required payment setup such as disbursement bank account or payment profile.\",          \"when\": \"User asks which documents are missing attributes before the payment run can continue.\",          \"fieldsToReturn\": [            \"paymentProcessRequestName\",            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"paymentPriority\",            \"paymentAmount\",            \"paymentCurrency.currencyCode\",            \"payablesPaymentProcessRequest.checkDate\",            \"accountPaymentProfile.paymentProfileId\",            \"bankAccount.id\"          ],          \"extraFilterExpressions\": [            \"(bankAccount.id=null or accountPaymentProfile.paymentProfileId=null)\"          ],          \"notes\": \"This driver is intended for action-oriented drill-down after a summary of missing attributes.\"        },        {          \"name\": \"whatIfExclusionImpactByPriorityAndWeek\",          \"description\": \"Estimate the cash impact of excluding a payment priority band from the selected installments in a PPR for the current week.\",          \"when\": \"User asks how much cash would be retained if all Standard-priority payments are excluded from this run for the week.\",          \"fieldsToReturn\": [            \"paymentProcessRequestName\",            \"supplierName\",            \"invoiceNumber\",            \"installmentNumber\",            \"paymentPriority\",            \"paymentAmount\",            \"paymentCurrencyCurrencyCode\",            \"paymentDate\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequestName='<PPR_NAME_FROM_USER>'\",            \"paymentPriority=<NUMERIC_PRIORITY_VALUE>\",            \"paymentDate between <TODAY> and <WEEK_END>\",            \"paymentPriority between <LOW_PRIORITY_VALUE> and <HIGH_PRIORITY_VALUE>\"          ],          \"notes\": \"Aggregate the filtered paymentAmount externally to return the cash retained for the week. Do not modify the PPR; this is a what-if analysis only. If the user only says Standard priority and does not provide the numeric priority or range, ask which payment priority value from 1 to 100 should be treated as Standard before querying.\"        }      ],      \"additionalInstructions\": [        \"Do not use selectedPaymentInstallments as the primary source for plain 'review installments for PPR' requests. Use pprInstallmentsDeduplicatedSummary for summary review and pprInstallmentsDeduplicatedDetails for line-level review unless the PPR status or requested fields require this AP-source shape.\",        \"Only use top-level fields and dotted accessor paths that this BV explicitly exposes. Do not invent supplier number, supplier site, remit-to address, external bank account, or other BO-only fields.\",        \"Use originalInvoiceTransaction.description when the user asks for invoice description; do not add a flat invoiceDescription field.\",        \"Use remitToSupplier.name when the user asks for remit-to supplier details.\",        \"Use selectedPaymentInstallments only for AP-source PPR statuses: UNSTARTED, SELECTING, SELECTED, REVIEW, SUBMITTED, CALCULATING, MISSING RATES, MISSING_X_RATES, ORA_REFRESH_INSTALLMENTS, CANCELED, and CANCELLED NO PAYMENTS.\",        \"Do not use selectedPaymentInstallments for IBY-only statuses such as PENDING_REVIEW, INFORMATION_REQUIRED, validation-failure, approval, payment-created, completed, or assignment-complete statuses; use paymentRunInstallments for those statuses.\",        \"For mixed-source statuses CANCELING and TERMINATED, or when the PPR status is unknown, use the deduplicated installment extraction shapes instead of this AP-only shape.\",        \"Use invoiceCurrency.currencyCode and paymentCurrency.currencyCode together when comparing currency pairs or looking for missing rates.\",        \"For timing comparisons, combine dueDate from this shape with payablesPaymentProcessRequest.checkDate from this same shape.\",        \"Use payablesSelectedInstallmentsSummary for supported selected-installment payment-value rollups. Use selectedPaymentInstallments for AP-stage detail rows, counts, or fields not exposed by the summary AV.\",        \"Use paymentGroupingNumber to explain how installments were bundled into proposed payments before approval.\",        \"Use payablesPaymentProcessRequest.internalBankAccount.id when the user wants the paying bank dimension by id. If the user needs the readable disbursement bank account name or external bank account details, switch to paymentRunInstallments.\",        \"Use invoiceInstallmentDetails when the user is asking about installment schedule detail before selection, discount windows such as within the next 5 days, or hold-related invoice-installment attributes rather than about installments already selected into a PPR.\",        \"Use PayablesPaymentProcessRequestDetails when the question is really about approver, approval aging, or all PPRs pending approval rather than about the underlying installment rows.\",        \"For what-if exclusion questions, fetch the matching selected installments and compute before-versus-after payment totals outside the base fetch. Do not imply that the payment process request was modified.\",        \"For Standard priority or named priority-band what-if questions, do not assume a default numeric range. Ask for the payment priority value or range between 1 and 100 unless the user provides it.\",        \"When constructing filters for null checks, use =null or != null. Do not use IS NOT NULL.\",        \"PM missing-rate split: all-PPR missing payment conversion rates use only payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode = 'MISSING RATES'; all-PPR missing cross-currency rates use only payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode = 'MISSING_X_RATES'. Do not add conversionRate or crossCurrencyRate null predicates to these all-PPR status scans.\",        \"For PPR-specific missing-rate review, use conversionRate=null for missing payment conversion rates and crossCurrencyRate=null for missing cross-currency rates.\",        \"Do not treat missing-rate questions as unsupported when the requested PPR is in an AP-source missing-rate status; use selectedPaymentInstallments.\",        \"PM missing-rate split: for specific-PPR currency questions, blocked-installment counts, and payment/installment amount-threshold questions, use conversionRate=null for missing payment conversion rates or crossCurrencyRate=null for missing cross-currency rates. Add the exact PPR filter only when the user supplies a PPR. Do not force MISSING RATES or MISSING_X_RATES status filters for these null-rate patterns.\",        \"For rate-update impact questions, filter only by the requested currency pair and return both conversionRate and crossCurrencyRate. Do not add status filters or null-rate predicates unless the user explicitly asks for missing rows.\",        \"For PPR-specific missing payment conversion currency questions, always emit selectedPaymentInstallments BV query context with conversionRate = null, invoice/payment currency fields, paymentAmount, invoiceCurrency sort asc, and limit 20.\",        \"Do not use selectedPaymentInstallments BV for 'how many installments are blocked' count questions or for currency-rate update impact questions such as updating USD to EUR. Those patterns are extraction-only and must route to selectedPaymentInstallmentsExtraction. Keep this BV for row-detail, PPR-specific currency-list, all-PPR status scans, and amount-threshold detail questions.\",        \"For PPR-specific missing-rate currency-list questions, use the literal PPR name supplied by the user, including hyphens, as payablesPaymentProcessRequest.checkrunName and emit query context even when no rows are returned.\",        \"Plain 'Show me missing cross currency rates for all PPRs' is a BV detail query using payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode = 'MISSING_X_RATES'. Do not route it to selectedPaymentInstallmentsExtraction unless the user asks to count, group, summarize, or organize by currency pair.\",        \"Plain 'Which currencies are missing cross currency rates in PPR <PPR_NAME>' is a BV currency-list query using payablesPaymentProcessRequest.checkrunName and crossCurrencyRate = null. Emit query context even if no rows are found.\"      ],      \"fieldSelectionRuleUsage\": {        \"match\": \"Choose the closest questionExamples entry for the user request.\",        \"fields\": \"Use the matching fields value exactly and preserve order.\",        \"paraphrases\": \"Use the same fields for paraphrased or equivalent requests.\",        \"addFieldsOnlyWhen\": \"The user explicitly asks for more displayed columns, or the field is required for filter, sort, group, key, or deeplink handling.\"      },      \"fieldSelectionRules\": [        {          \"questionExamples\": [            \"Show me missing payment conversion rates for all PPRs\"          ],          \"queryType\": \"BV\",          \"shape\": \"selectedPaymentInstallments\",          \"fields\": \"supplier.name,payablesPaymentProcessRequest.checkrunName,invoiceNumber,installmentNumber,invoiceCurrency.currencyCode,invoiceAmount,paymentCurrency.currencyCode,paymentAmount,dueDate,payablesPaymentProcessRequest.checkrunId\",          \"filters\": \"payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode = 'MISSING RATES'\",          \"sortBy\": \"payablesPaymentProcessRequest.checkrunName:asc\",          \"limit\": 20,          \"fieldOrderLocked\": true,          \"notes\": \"Plain all-PPR missing payment conversion-rate detail uses this BV status scan only. Do not use extraction unless the user asks to count, group, summarize, or organize by currency pair. Include checkrunId as PPR ID support field.\"        },        {          \"questionExamples\": [            \"Show me missing cross currency rates for all PPRs\"          ],          \"queryType\": \"BV\",          \"shape\": \"selectedPaymentInstallments\",          \"fields\": \"supplier.name,payablesPaymentProcessRequest.checkrunName,payablesPaymentProcessRequest.checkrunId,invoiceNumber,installmentNumber,invoiceCurrency.currencyCode,paymentCurrency.currencyCode,invoiceAmount,paymentAmount,dueDate\",          \"filters\": \"payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode = 'MISSING_X_RATES'\",          \"sortBy\": \"payablesPaymentProcessRequest.checkrunName:asc\",          \"limit\": 20,          \"fieldOrderLocked\": true,          \"notes\": \"Plain all-PPR missing cross-currency rate detail must use this BV status scan. Do not use selectedPaymentInstallmentsExtraction or grouped currency-pair aggregation unless the user asks to count, group, summarize, or organize by currency pair. This rule does not apply to how-many/count questions.\"        },        {          \"questionExamples\": [            \"Which currencies are missing payment conversion rates in PPR PPR05-009?\",            \"Which currencies are missing payment conversion rates in PPR <PPR_NAME>\",            \"Which currencies are missing payment conversion rates in this PPR?\"          ],          \"queryType\": \"BV\",          \"shape\": \"selectedPaymentInstallments\",          \"fields\": \"invoiceCurrency.currencyCode,paymentCurrency.currencyCode,paymentAmount\",          \"filters\": \"payablesPaymentProcessRequest.checkrunName = '<PPR_NAME_FROM_USER>' AND conversionRate = null\",          \"sortBy\": \"invoiceCurrency.currencyCode:asc\",          \"limit\": 20,          \"fieldOrderLocked\": true,          \"notes\": \"Mandatory query context. For PPR-specific missing payment conversion currency questions, use conversionRate = null with the PPR checkrunName filter; do not return narrative only even when no rows are found. Use the literal PPR name supplied by the user, including hyphens, as checkrunName; do not require entity resolution before emitting query context.\"        },        {          \"questionExamples\": [            \"Which currencies are missing cross currency rates in PPR <PPR_NAME>\",            \"Which currencies are missing cross currency rates in this PPR?\"          ],          \"queryType\": \"BV\",          \"shape\": \"selectedPaymentInstallments\",          \"fields\": \"invoiceCurrency.currencyCode,paymentCurrency.currencyCode,paymentAmount\",          \"filters\": \"payablesPaymentProcessRequest.checkrunName = '<PPR_NAME_FROM_USER>' AND crossCurrencyRate = null\",          \"sortBy\": \"invoiceCurrency.currencyCode:asc\",          \"limit\": 20,          \"fieldOrderLocked\": true,          \"notes\": \"PPR-specific missing cross-currency currency-list questions are supported by this BV rule. Use the literal PPR name, including hyphens, as checkrunName; use crossCurrencyRate = null; emit query context even if no rows are returned. Do not use extraction for this pattern.\"        },        {          \"questionExamples\": [            \"Show me missing payment conversion rates where the payment/installment amount exceeds $100,000\"          ],          \"queryType\": \"BV\",          \"shape\": \"selectedPaymentInstallments\",          \"fields\": \"payablesPaymentProcessRequest.checkrunName,supplier.name,invoiceNumber,installmentNumber,invoiceCurrency.currencyCode,paymentCurrency.currencyCode,paymentAmount,dueDate\",          \"filters\": \"conversionRate = null AND paymentAmount > <AMOUNT_THRESHOLD_FROM_USER_OR_DEFAULT_100000>\",          \"sortBy\": \"payablesPaymentProcessRequest.checkrunName:asc\",          \"limit\": 20,          \"fieldOrderLocked\": true,          \"notes\": \"High-value missing payment conversion-rate questions use conversionRate = null plus the amount predicate; do not add parent status unless the user explicitly asks for all-PPR status scan.\"        },        {          \"questionExamples\": [            \"Show me missing cross currency rates where the payment/installment amount exceeds $100,000\"          ],          \"queryType\": \"BV\",          \"shape\": \"selectedPaymentInstallments\",          \"fields\": \"payablesPaymentProcessRequest.checkrunName,supplier.name,invoiceNumber,installmentNumber,invoiceCurrency.currencyCode,paymentCurrency.currencyCode,paymentAmount,dueDate\",          \"filters\": \"crossCurrencyRate = null AND paymentAmount > <AMOUNT_THRESHOLD_FROM_USER_OR_DEFAULT_100000>\",          \"sortBy\": \"payablesPaymentProcessRequest.checkrunName:asc\",          \"limit\": 20,          \"fieldOrderLocked\": true,          \"notes\": \"High-value missing cross-currency questions use crossCurrencyRate = null plus the amount predicate; do not add parent status unless the user explicitly asks for all-PPR status scan.\"        }      ]    },    \"selectedPaymentInstallmentsExtraction\": {      \"key\": \"selectedPaymentInstallmentsExtraction\",      \"name\": \"selectedPaymentInstallmentsExtraction\",      \"type\": \"EXTRACTION\",      \"module\": \"oraErpCorePayablesPayments\",      \"businessObject\": \"PayablesPaymentProcessRequestSelectedInvoiceInstallment\",      \"description\": \"Use this AP-source BV only when the PPR status is resolved to an AP-stage status or when the user asks for AP-only selected-installment attributes such as missing conversion rates, missing cross-currency rates, dynamic discount attributes, selected grouping number, or what-if exclusion inputs. Do not use it as the primary shape for generic PPR installment review; use the deduplicated PPR installment extraction shapes first.\",      \"exampleQuestions\": [        \"Show AP-stage selected installments for payment process request kp6aug2503 in REVIEW status\",        \"Show AP selected installment rows for payment process request zBIA_Payment before payment creation\",        \"List AP selected installments for supplier Vision Operations under PPR zBIA_Payment\",        \"Show invoice, due date, payment amount, and grouping number for AP selected installments in PPR zBIA_Payment\",        \"Show me the AP selected payment distribution by business unit in this PPR\",        \"Which suppliers represent 80% of the AP selected payment value in this PPR?\",        \"Show me all AP selected installments over 100000 with supplier details and invoice references in this PPR\",        \"Which selected installments in PPR zBIA_Payment have dynamic discount details like campaign, APR, and days accelerated?\",        \"Which selected installments in this PPR are missing conversion rates?\",        \"How many proposed payments are these selected installments grouped into before approval?\",        \"If I remove Supplier_X from this run, how much cash will I save today?\",        \"If I remove Invoice XYZ from this run, what will be the total amount paid today?\",        \"If I exclude all standard-priority installments from this run, how much cash will we retain for the week?\",        \"Show me missing payment conversion rates for all PPRs\",        \"Show me missing cross currency rates for all PPRs\",        \"Which currencies are missing payment conversion rates in this PPR?\",        \"Which currencies are missing cross currency rates in this PPR?\",        \"How many installments are blocked due to missing payment conversion rates?\",        \"How many installments are blocked due to missing cross currency rates?\",        \"Which payments/installments will be affected if I update the USD to EUR conversion rate to 0.92?\",        \"Show me missing payment conversion rates where the payment/installment amount exceeds $100,000\",        \"Show me missing cross currency rates where the payment/installment amount exceeds $100,000\",        \"Which currencies are missing payment conversion rates in PPR <PPR_NAME>?\",        \"How many installments are blocked due to missing payment conversion rates for <PPR_NAME>?\",        \"Show me missing payment conversion rates where the payment/installment amount exceeds 100 for <PPR_NAME>\",        \"Show me all missing payment conversion rates organized by currency pair for <PPR_NAME>\"      ],      \"fields\": {        \"fields\": [          \"checkrunName\",          \"invoiceId\",          \"installmentNumber\",          \"originalInvoiceId\",          \"invoiceNumber\",          \"invoiceDate\",          \"invoiceAmount\",          \"dueDate\",          \"amountRemaining\",          \"paymentAmount\",          \"discount\",          \"okToPayFlag\",          \"paymentPriority\",          \"discountTakenInInvoiceCurrency\",          \"paymentAmountInInvoiceCurrency\",          \"crossCurrencyRate\",          \"withheldTax\",          \"campaignName\",          \"discountAPR\",          \"daysAccelerated\",          \"conversionRateType\",          \"conversionRate\",          \"paymentGroupingNumber\",          \"originalPaymentNumber\",          \"interestAnnualPercent\",          \"installmentRank\",          \"supplierId\",          \"supplierName\",          \"businessUnitId\",          \"businessUnitName\",          \"legalEntityId\",          \"legalEntityName\",          \"invoiceCurrencyCurrencyCode\",          \"paymentCurrencyCurrencyCode\",          \"checkrunId\",          \"checkDate\",          \"internalBankAccountId\",          \"paymentProfileId\",          \"paymentProcessRequestStatusLookupCode\",          \"paymentProcessRequestStatusMeaning\",          \"acceleratedInvoicesLookupLookupCode\",          \"acceleratedInvoicesLookupMeaning\",          \"paymentMethodCode\",          \"templateName\",          \"originalInvoiceTransactionDescription\",          \"paymentDate\",          \"remitToSupplierName\",          \"externalBankAccountId\",          \"externalBankAccountShortName\",          \"externalBankBranchName\",          \"externalBankCountry\"        ],        \"fieldAlias\": {          \"PPR Name\": \"checkrunName\",          \"Invoice ID\": \"invoiceId\",          \"Installment Number\": \"installmentNumber\",          \"Original Invoice ID\": \"originalInvoiceId\",          \"Invoice Number\": \"invoiceNumber\",          \"Invoice Date\": \"invoiceDate\",          \"Invoice Amount\": \"invoiceAmount\",          \"Due Date\": \"dueDate\",          \"Amount Remaining\": \"amountRemaining\",          \"Payment Amount\": \"paymentAmount\",          \"Discount\": \"discount\",          \"OK to Pay\": \"okToPayFlag\",          \"Payment Priority\": \"paymentPriority\",          \"Discount Taken (Invoice Currency)\": \"discountTakenInInvoiceCurrency\",          \"Payment Amount (Invoice Currency)\": \"paymentAmountInInvoiceCurrency\",          \"Cross Currency Rate\": \"crossCurrencyRate\",          \"Withheld Tax\": \"withheldTax\",          \"Campaign Name\": \"campaignName\",          \"Discount APR\": \"discountAPR\",          \"Days Accelerated\": \"daysAccelerated\",          \"Conversion Rate Type\": \"conversionRateType\",          \"Conversion Rate\": \"conversionRate\",          \"Payment Grouping Number\": \"paymentGroupingNumber\",          \"Original Payment Number\": \"originalPaymentNumber\",          \"Interest Annual Percent\": \"interestAnnualPercent\",          \"Installment Rank\": \"installmentRank\",          \"Supplier ID\": \"supplierId\",          \"Supplier\": \"supplierName\",          \"Business Unit ID\": \"businessUnitId\",          \"Business Unit\": \"businessUnitName\",          \"Legal Entity ID\": \"legalEntityId\",          \"Legal Entity\": \"legalEntityName\",          \"Invoice Currency\": \"invoiceCurrencyCurrencyCode\",          \"Payment Currency\": \"paymentCurrencyCurrencyCode\",          \"PPR ID\": \"checkrunId\",          \"Check Date\": \"checkDate\",          \"Disbursement Bank Account ID\": \"internalBankAccountId\",          \"Payment Profile ID\": \"paymentProfileId\",          \"PPR Status Code\": \"paymentProcessRequestStatusLookupCode\",          \"PPR Status\": \"paymentProcessRequestStatusMeaning\",          \"Accelerated Invoices Code\": \"acceleratedInvoicesLookupLookupCode\",          \"Accelerated Invoices Policy\": \"acceleratedInvoicesLookupMeaning\",          \"Payment Method Code\": \"paymentMethodCode\",          \"PPR Template\": \"templateName\",          \"Invoice Description\": \"originalInvoiceTransactionDescription\",          \"Payment Date\": \"paymentDate\",          \"Remit-to Supplier\": \"remitToSupplierName\",          \"External Bank Account ID\": \"externalBankAccountId\",          \"External Bank Account\": \"externalBankAccountShortName\",          \"External Bank Branch\": \"externalBankBranchName\",          \"External Bank Country\": \"externalBankCountry\"        }      },      \"supportedFilters\": [        {          \"name\": \"payablesPaymentProcessRequest.checkrunId\",          \"attribute\": \"payablesPaymentProcessRequest.checkrunId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides the payment process request identifier.\",          \"valueFromUser\": \"PPR ID\"        },        {          \"name\": \"payablesPaymentProcessRequest.checkrunName\",          \"attribute\": \"payablesPaymentProcessRequest.checkrunName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user identifies the payment process request by name.\",          \"valueFromUser\": \"PPR Name\"        },        {          \"name\": \"supplier.supplierId\",          \"attribute\": \"supplier.supplierId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the supplier is resolved to an internal supplier identifier.\",          \"valueFromUser\": \"Supplier ID\"        },        {          \"name\": \"supplier.name\",          \"attribute\": \"supplier.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by supplier name.\",          \"valueFromUser\": \"Supplier\"        },        {          \"name\": \"invoiceId\",          \"attribute\": \"invoiceId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the invoice identifier is available.\",          \"valueFromUser\": \"Invoice ID\"        },        {          \"name\": \"originalInvoiceTransaction.invoiceId\",          \"attribute\": \"originalInvoiceTransaction.invoiceId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use originalInvoiceTransaction.invoiceId is null with originalPaymentNumber is null to exclude interest rows from base selected-invoice review calculations, or match this to invoiceId when locating interest rows.\",          \"valueFromUser\": \"Original Invoice ID\"        },        {          \"name\": \"originalPaymentNumber\",          \"attribute\": \"originalPaymentNumber\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use originalPaymentNumber is null with originalInvoiceTransaction.invoiceId is null to exclude linked interest rows, or match this to installmentNumber when locating interest rows.\",          \"valueFromUser\": \"Original Payment Number\"        },        {          \"name\": \"okToPayFlag\",          \"attribute\": \"okToPayFlag\",          \"type\": \"boolean\",          \"possibleValues\": [            \"Y\",            \"N\"          ],          \"usage\": \"Use okToPayFlag='Y' for selected-installment review totals.\",          \"valueFromUser\": \"OK to Pay\"        },        {          \"name\": \"invoiceNumber\",          \"attribute\": \"invoiceNumber\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by supplier invoice number.\",          \"valueFromUser\": \"Invoice Number\"        },        {          \"name\": \"installmentNumber\",          \"attribute\": \"installmentNumber\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user requests a specific installment on the invoice.\",          \"valueFromUser\": \"Installment Number\"        },        {          \"name\": \"dueDate\",          \"attribute\": \"dueDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for installments due on a specific date.\",          \"valueFromUser\": \"Due Date or date range\"        },        {          \"name\": \"paymentPriority\",          \"attribute\": \"paymentPriority\",          \"type\": \"int32\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for high or specific payment priority installments.\",          \"valueFromUser\": \"Payment Priority\"        },        {          \"name\": \"paymentAmount\",          \"attribute\": \"paymentAmount\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use for amount-threshold questions such as installments over 50000 or 100000.\",          \"valueFromUser\": \"Payment Amount\"        },        {          \"name\": \"amountRemaining\",          \"attribute\": \"amountRemaining\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for installments with high unpaid amount.\",          \"valueFromUser\": \"Amount Remaining\"        },        {          \"name\": \"invoiceCurrency.currencyCode\",          \"attribute\": \"invoiceCurrency.currencyCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for a specific invoice currency or a currency pair.\",          \"valueFromUser\": \"Invoice Currency\"        },        {          \"name\": \"paymentCurrency.currencyCode\",          \"attribute\": \"paymentCurrency.currencyCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for a specific payment currency or a currency pair.\",          \"valueFromUser\": \"Payment Currency\"        },        {          \"name\": \"conversionRate\",          \"attribute\": \"conversionRate\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use conversionRate is null to find selected installments missing a payment conversion rate.\",          \"valueFromUser\": \"Conversion Rate\"        },        {          \"name\": \"crossCurrencyRate\",          \"attribute\": \"crossCurrencyRate\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use crossCurrencyRate is null to find selected installments missing a cross-currency rate.\",          \"valueFromUser\": \"Cross Currency Rate\"        },        {          \"name\": \"withheldTax\",          \"attribute\": \"withheldTax\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use for withholding-tax review questions.\",          \"valueFromUser\": \"Withheld Tax\"        },        {          \"name\": \"payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",          \"attribute\": \"payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [            \"PENDING_REVIEW\",            \"ORA_REQUIRE_APPROVAL\",            \"ORA_APPROVAL_INITIATED\",            \"ORA_APPROVED\",            \"ORA_APPROVAL_WITHDRAWN\",            \"PAYMENTS_CREATED\",            \"MISSING RATES\",            \"MISSING_X_RATES\"          ],          \"usage\": \"Use when the user asks for installments under proposed-payment review or approval statuses, or for all-PPR missing-rate scans. Use MISSING RATES for missing payment conversion rate scans and MISSING_X_RATES for missing cross-currency rate scans; for specific PPR drill-down, use conversionRate is null or crossCurrencyRate is null.\",          \"valueFromUser\": \"PPR Status Code\"        },        {          \"name\": \"payablesPaymentProcessRequest.acceleratedInvoicesLookup.lookupCode\",          \"attribute\": \"payablesPaymentProcessRequest.acceleratedInvoicesLookup.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about the accelerated-invoice or dynamic-discount policy on the payment process request.\",          \"valueFromUser\": \"Accelerated Invoices Code\"        },        {          \"name\": \"payablesPaymentProcessRequest.checkDate\",          \"attribute\": \"payablesPaymentProcessRequest.checkDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user compares the scheduled payment date of the run with installment due dates.\",          \"valueFromUser\": \"Check Date or date range\"        },        {          \"name\": \"payablesPaymentProcessRequest.paymentMethod.code\",          \"attribute\": \"payablesPaymentProcessRequest.paymentMethod.code\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes selected installments to a payment method on the run.\",          \"valueFromUser\": \"Payment Method Code\"        },        {          \"name\": \"remitToSupplier.name\",          \"attribute\": \"remitToSupplier.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for remit-to supplier details for selected installments.\",          \"valueFromUser\": \"Remit-to Supplier\"        },        {          \"name\": \"externalBankAccount.bankAccountShortName\",          \"attribute\": \"externalBankAccount.bankAccountShortName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters selected installments by external bank account.\",          \"valueFromUser\": \"External Bank Account\"        },        {          \"name\": \"businessUnit.id\",          \"attribute\": \"businessUnit.id\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes selected installments to a business unit.\",          \"valueFromUser\": \"Business Unit ID\"        },        {          \"name\": \"businessUnit.name\",          \"attribute\": \"businessUnit.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user wants proposed payments grouped or filtered by business unit name.\",          \"valueFromUser\": \"Business Unit\"        },        {          \"name\": \"paymentGroupingNumber\",          \"attribute\": \"paymentGroupingNumber\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user wants to inspect how installments were grouped into proposed payments before approval.\",          \"valueFromUser\": \"Payment Grouping Number\"        },        {          \"name\": \"payablesPaymentProcessRequest.internalBankAccount.id\",          \"attribute\": \"payablesPaymentProcessRequest.internalBankAccount.id\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user groups proposed payments by the paying internal bank account id.\",          \"valueFromUser\": \"Disbursement Bank Account ID\"        },        {          \"name\": \"payablesPaymentProcessRequest.paymentProcessProfile.paymentProfileId\",          \"attribute\": \"payablesPaymentProcessRequest.paymentProcessProfile.paymentProfileId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes proposed payment review to a payment process profile.\",          \"valueFromUser\": \"Payment Profile ID\"        },        {          \"name\": \"legalEntity.legalEntityId\",          \"attribute\": \"legalEntity.legalEntityId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes selected installments to a legal entity.\",          \"valueFromUser\": \"Legal Entity ID\"        },        {          \"name\": \"paymentProcessRequestName\",          \"attribute\": \"paymentProcessRequestName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user identifies the payment process request by name.\",          \"valueFromUser\": \"PPR Name\"        },        {          \"name\": \"originalInvoiceId\",          \"attribute\": \"originalInvoiceId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use is null with originalPaymentNumber is null to exclude interest rows from base selected-invoice review calculations, or match this to invoiceId when locating interest rows.\",          \"valueFromUser\": \"Original Invoice ID\"        }      ],      \"dateFilterGuidance\": null,      \"extractionQuery\": {        \"viewQueries\": {          \"selectedPaymentInstallments\": {            \"module\": \"oraErpCorePayablesPayments\",            \"businessObject\": \"PayablesPaymentProcessRequestSelectedInvoiceInstallment\",            \"view\": \"selectedPaymentInstallments\",            \"fieldAliases\": {              \"payablesPaymentProcessRequest.checkrunName\": \"checkrunName\",              \"invoiceId\": \"invoiceId\",              \"installmentNumber\": \"installmentNumber\",              \"originalInvoiceTransaction.invoiceId\": \"originalInvoiceId\",              \"invoiceNumber\": \"invoiceNumber\",              \"invoiceDate\": \"invoiceDate\",              \"invoiceAmount\": \"invoiceAmount\",              \"dueDate\": \"dueDate\",              \"amountRemaining\": \"amountRemaining\",              \"paymentAmount\": \"paymentAmount\",              \"discount\": \"discount\",              \"okToPayFlag\": \"okToPayFlag\",              \"paymentPriority\": \"paymentPriority\",              \"discountTakenInInvoiceCurrency\": \"discountTakenInInvoiceCurrency\",              \"paymentAmountInInvoiceCurrency\": \"paymentAmountInInvoiceCurrency\",              \"crossCurrencyRate\": \"crossCurrencyRate\",              \"withheldTax\": \"withheldTax\",              \"campaignName\": \"campaignName\",              \"discountAPR\": \"discountAPR\",              \"daysAccelerated\": \"daysAccelerated\",              \"conversionRateType\": \"conversionRateType\",       