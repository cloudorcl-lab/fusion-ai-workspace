            {
              "id": "1777456020782_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.GET_INTENT_AND_SHAPES.$output.result.intent.skillType == \"data\"}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Build LLM response"
