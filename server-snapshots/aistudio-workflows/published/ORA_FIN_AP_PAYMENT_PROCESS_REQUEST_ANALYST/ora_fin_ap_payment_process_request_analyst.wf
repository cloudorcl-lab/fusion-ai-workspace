                    "x": 6820,
                    "y": 11788
                  },
                  "code": "PARSE_EXTRACT_QUERY",
                  "id": "1776679562914",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE",
                  "convergenceTargetId": "1778494456344"
                },
                {
                  "metadata": {
                    "name": "Parse EV Query",
                    "returnType": "object",
                    "sourceCode": "var heading = $context.$nodes.FIN_AP_LOOP_EXECUTOR.$currentItem.plan.header ;\nvar sequence = 3;                                    // from layout plan\nvar formatHint = \"\";                                // or e.g. \"installmentDetails\"\n\n\nvar apiUrl = $context.$nodes.FIN_AP_LOOP_EXECUTOR.$currentItem.api;\n\n\n// Query context\nvar queryContext = $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_EV_QUERY_BUILDER\n  ? $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_EV_QUERY_BUILDER.$output || {}\n  : {};\n\n\n// 1. Extract rows from BV output\nvar rows = [];\nif (\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.GET_EV_DATA.$output &&\n  Array.isArray($context.$nodes.FIN_AP_LOOP_EXECUTOR.GET_EV_DATA.$output.items)\n) {\n  rows = $context.$nodes.FIN_AP_LOOP_EXECUTOR.GET_EV_DATA.$output.items;\n}\n\n// 2. Technical fields + fieldAlias (DISPLAY -> TECHNICAL) from BV query node for unselected installments\nvar technicalFields = [];\nvar fieldAlias = {};\n\n// Helper aliases for hidden values used to decide or build deeplinks.\nvar deeplinkHelperFieldAlias = {\n  \"Payables PPR Id\": \"payablesPaymentProcessRequestId\",\n  \"Payment File Reference\": \"paymentFileReference\",\n  \"Payment File Status\": \"paymentFileStatus\",\n  \"Payment Process Type\": \"paymentProcessType\",\n  \"Request Status Code\": \"requestStatusCode\",\n  \"PPR Status Code\": \"paymentProcessRequestStatusCode\",\n  \"Payment File Status Code\": \"paymentFileStatusCode\",\n  \"Payments PPR Id\": \"paymentProcessRequestId\"\n};\n\nvar requiredAttributesForConstructingDeeplink = [\n  {\n    replaceableAttributes: [\n      \"PPR Name\",\n      \"paymentProcessRequest\",\n      \"paymentProcessRequestName\",\n      \"checkrunName\"\n    ],\n    requiredAttributes: [\n      \"Payables PPR Id\",\n      \"Payments PPR Id\",\n      \"Payment Process Type\"\n    ]\n  },\n  {\n    replaceableAttributes: [\n      \"paymentProcessRequestStatus\",\n      \"paymentProcessRequestStatusMeaning\",\n      \"PPR Status\",\n      \"Linked PPR Status\",\n      \"Request Status\"\n    ],\n    requiredAttributes: [\n      \"Payables PPR Id\",\n      \"Payments PPR Id\",\n      \"Request Status Code\",\n      \"PPR Status Code\",\n      \"Payment File Reference\"\n    ]\n  },\n  {\n    replaceableAttributes: [\n      \"paymentFileReference\",\n      \"File Requiring Attention\",\n      \"Payment File Reference\"\n    ],\n    requiredAttributes: [\n      \"Request Status Code\",\n      \"Payment File Status Code\",\n      \"Payment File Status\"\n    ]\n  }\n];\n\nif (\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR &&\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_EV_QUERY_BUILDER &&\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_EV_QUERY_BUILDER.$output &&\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_EV_QUERY_BUILDER.$output.evQuery\n) {\n  var bvOut = $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_EV_QUERY_BUILDER.$output;\n\n  if (typeof bvOut.evQuery.fields === \"string\" && bvOut.evQuery.fields.trim().length > 0) {\n    technicalFields = bvOut.evQuery.fields\n      .split(\",\")\n      .map(function (f) { return f.trim(); });\n  }\n\n  if (bvOut.fieldAlias && typeof bvOut.fieldAlias === \"object\") {\n    // Expecting: { DisplayLabel: \"technical.path\" }\n    fieldAlias = bvOut.fieldAlias;\n  }\n}\n\n// If BVQUERY_UNSELECTED didn’t give fields, derive from first row\nif (technicalFields.length === 0 && rows.length > 0) {\n  technicalFields = Object.keys(rows[0]);\n}\n\n\nfunction normaliseFieldPath(path) {\n  return String(path || \"\")\n    .trim()\n    .toLowerCase();\n}\n\nfunction normaliseAttributeName(name) {\n  return String(name || \"\")\n    .trim()\n    .toLowerCase()\n    .replace(/[^a-z0-9]+/g, \"\");\n}\n\nfunction hasSelectedTechnicalField(fieldName, selectedFields) {\n  var normalisedFieldName = normaliseFieldPath(fieldName);\n  if (!normalisedFieldName) return false;\n\n  for (var i = 0; i < selectedFields.length; i++) {\n    if (normaliseFieldPath(selectedFields[i]) === normalisedFieldName) {\n      return true;\n    }\n  }\n\n  return false;\n}\n\nfunction hasSelectedAttributeName(attributeName, selectedFields) {\n  var normalisedAttributeName = normaliseAttributeName(attributeName);\n  if (!normalisedAttributeName) return false;\n\n  for (var i = 0; i < selectedFields.length; i++) {\n    if (normaliseAttributeName(selectedFields[i]) === normalisedAttributeName) {\n      return true;\n    }\n  }\n\n  return false;\n}\n\nfunction isSelectedOutputAttribute(attributeName, selectedFields) {\n  if (hasSelectedAttributeName(attributeName, selectedFields)) {\n    return true;\n  }\n\n  var normalisedAttributeName = normaliseAttributeName(attributeName);\n  for (var displayLabel in fieldAlias) {\n    if (!Object.prototype.hasOwnProperty.call(fieldAlias, displayLabel)) continue;\n\n    if (\n      normaliseAttributeName(displayLabel) === normalisedAttributeName &&\n      hasSelectedTechnicalField(fieldAlias[displayLabel], selectedFields)\n    ) {\n      return true;\n    }\n  }\n\n  return false;\n}\n\nfunction addTechnicalFieldIfMissing(fieldName) {\n  var normalisedFieldName = normaliseFieldPath(fieldName);\n  if (!normalisedFieldName) return;\n\n  for (var i = 0; i < technicalFields.length; i++) {\n    if (normaliseFieldPath(technicalFields[i]) === normalisedFieldName) {\n      return;\n    }\n  }\n\n  technicalFields.push(fieldName);\n}\n\nfunction getRequiredTechnicalField(displayLabel) {\n  if (Object.prototype.hasOwnProperty.call(fieldAlias, displayLabel)) {\n    return fieldAlias[displayLabel];\n  }\n\n  return deeplinkHelperFieldAlias[displayLabel];\n}\n\n// Merge only deeplink helper aliases required by selected replaceable fields.\n// Keep a snapshot so helper fields added here do not trigger other helper sets.\nvar selectedTechnicalFields = technicalFields.slice();\nfor (var ruleIndex = 0; ruleIndex < requiredAttributesForConstructingDeeplink.length; ruleIndex++) {\n  var deeplinkRule = requiredAttributesForConstructingDeeplink[ruleIndex];\n  var replaceableAttributes = deeplinkRule.replaceableAttributes || [];\n  var shouldAddRequiredAttributes = false;\n\n  for (\n    var replaceableIndex = 0;\n    replaceableIndex < replaceableAttributes.length;\n    replaceableIndex++\n  ) {\n    if (isSelectedOutputAttribute(replaceableAttributes[replaceableIndex], selectedTechnicalFields)) {\n      shouldAddRequiredAttributes = true;\n      break;\n    }\n  }\n\n  if (!shouldAddRequiredAttributes) {\n    continue;\n  }\n\n  var requiredAttributes = deeplinkRule.requiredAttributes || [];\n  for (var requiredIndex = 0; requiredIndex < requiredAttributes.length; requiredIndex++) {\n    var requiredDisplayLabel = requiredAttributes[requiredIndex];\n    var staticTechnicalField = getRequiredTechnicalField(requiredDisplayLabel);\n\n    if (!staticTechnicalField) continue;\n\n    if (!Object.prototype.hasOwnProperty.call(fieldAlias, requiredDisplayLabel)) {\n      fieldAlias[requiredDisplayLabel] = staticTechnicalField;\n    }\n    addTechnicalFieldIfMissing(staticTechnicalField);\n  }\n}\n\n// Build a reverse alias lookup: normalised technical -> display label\nvar reverseAlias = {};\nfor (var displayLabel in fieldAlias) {\n  if (!Object.prototype.hasOwnProperty.call(fieldAlias, displayLabel)) continue;\n  var tech = fieldAlias[displayLabel];\n  var key = normaliseFieldPath(tech);\n  if (!reverseAlias[key]) {\n    reverseAlias[key] = displayLabel;\n  }\n}\n\n// Helper: resolve dotted path like \"supplier.name\"\nfunction getValueByPath(obj, path) {\n  var parts = path.split(\".\");\n  var value = obj;\n  for (var i = 0; i < parts.length; i++) {\n    if (value && Object.prototype.hasOwnProperty.call(value, parts[i])) {\n      value = value[parts[i]];\n    } else {\n      value = \"\";\n      break;\n    }\n  }\n  if (value === null || value === undefined) {\n    return \"\";\n  }\n  return value;\n}\n\n// Helper: given a technical field, find its display name if we have it (case-insensitive), else use technical\nfunction getDisplayName(technical) {\n  var key = normaliseFieldPath(technical);\n  var display = reverseAlias[key];\n  return display || technical;\n}\n\n// NEW: find actual key in a row object case-insensitively\nfunction findActualKey(obj, requestedKey) {\n  if (!obj || typeof obj !== \"object\") return null;\n\n  // Fast path: exact match\n  if (Object.prototype.hasOwnProperty.call(obj, requestedKey)) {\n    return requestedKey;\n  }\n\n  var target = normaliseFieldPath(requestedKey);\n  for (var k in obj) {\n    if (!Object.prototype.hasOwnProperty.call(obj, k)) continue;\n    if (normaliseFieldPath(k) === target) {\n      return k; // return the real key from the object\n    }\n  }\n  return null;\n}\n\n// 3. Build processed rows: keys = display names (or technical), strip $id and $context\nvar processedRows = [];\nfor (var r = 0; r < rows.length; r++) {\n  var src = rows[r];\n  var dst = {};\n\n  for (var t = 0; t < technicalFields.length; t++) {\n    var technicalName = technicalFields[t];\n\n    // skip internal/meta fields if they appear in fields list\n    if (technicalName === \"$id\" || technicalName === \"$context\") {\n      continue;\n    }\n\n    var displayName = getDisplayName(technicalName);\n    var value;\n\n    if (technicalName.indexOf(\".\") !== -1) {\n      // dotted path: use path helper directly (paths should already be canonical)\n      value = getValueByPath(src, technicalName);\n    } else {\n      // non-dotted: find actual key in row case-insensitively\n      var actualKey = findActualKey(src, technicalName);\n      if (actualKey !== null) {\n        value = src[actualKey];\n      } else {\n        value = \"\";\n      }\n      if (value === null || value === undefined) {\n        value = \"\";\n      }\n    }\n\n    dst[displayName] = value;\n  }\n\n  processedRows.push(dst);\n}\n\n// 4. Column order = display names (or technical) in same order, dropping $id/$context\nvar columnOrder = [];\nfor (var t2 = 0; t2 < technicalFields.length; t2++) {\n  var tech = technicalFields[t2];\n  if (tech === \"$id\" || tech === \"$context\") {\n    continue;\n  }\n  columnOrder.push(getDisplayName(tech));\n}\n\n// 5. Assemble the final table block\nvar tableBlock = {\n  type: \"table\",\n  heading: heading,\n  content: processedRows,\n  sequence: sequence,\n  formatHint: formatHint,\n  columnOrder: columnOrder,\n   purpose: $context.$nodes.FIN_AP_LOOP_EXECUTOR.$currentItem.purpose ,\n  contextData: {\n    apiUrl: apiUrl,\n    queryContext: queryContext\n  }\n};\n\n\nreturn tableBlock;"
                  },
                  "outcomes": {
                    "success": "end_1776673096935"
                  },
