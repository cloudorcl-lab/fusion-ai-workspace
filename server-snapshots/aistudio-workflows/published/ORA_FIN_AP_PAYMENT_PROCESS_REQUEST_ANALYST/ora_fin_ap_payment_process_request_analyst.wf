        {
          "metadata": {
            "name": "PPR Deeplink Enricher",
            "returnType": "object",
            "sourceCode": "/*\n * Standalone PPR and payment-file deeplink enrichment code node.\n *\n * Primary input:\n * - FIN_AP_COMBINE_RESULT.$output.result\n *\n * FIN_AP_COMBINE_RESULT normally returns the final response block array. This node\n * preserves that array shape, enriches only table blocks, and returns the full\n * enriched block array.\n *\n * Compatibility fallback:\n * - If the input is still a raw BO payload shaped like { items: [...] }, this\n *   mirrors the original formatter and returns the formatted row array.\n */\n\nvar rootNodes = $context && $context.$nodes ? $context.$nodes : {};\n\nfunction hasValue(value) {\n  return value !== null && value !== undefined && String(value).trim() !== \"\";\n}\n\nfunction normalize(value) {\n  return String(value || \"\")\n    .trim()\n    .toLowerCase()\n    .replace(/[^a-z0-9]+/g, \"\");\n}\n\nfunction normalizeCode(value) {\n  return String(value || \"\")\n    .trim()\n    .toUpperCase()\n    .replace(/\\s+/g, \"_\");\n}\n\nfunction codesEqual(value, expected) {\n  return normalizeCode(value) === normalizeCode(expected);\n}\n\nfunction isPaymentsCreatedStatus(value) {\n  return (\n    codesEqual(value, \"PAYMENTS_CREATED\") ||\n    normalize(value) === \"waitingforpaymentfileprocessing\"\n  );\n}\n\nfunction parseMaybeJson(value) {\n  if (value === null || value === undefined) return null;\n  if (typeof value === \"object\") return value;\n\n  if (typeof value === \"string\") {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return null;\n    }\n  }\n\n  return null;\n}\n\nfunction getNodeOutput(nodeName) {\n  var node = rootNodes[nodeName];\n  if (!node || !node.$output) return null;\n  return node.$output;\n}\n\nfunction getOutputPayload(output) {\n  if (!output) return null;\n  if (output.result !== null && output.result !== undefined) return output.result;\n  if (output.output !== null && output.output !== undefined) return output.output;\n  return output;\n}\n\nfunction getCombinedResultPayload() {\n  return getOutputPayload(getNodeOutput(\"FIN_AP_COMBINE_RESULT\"));\n}\n\nfunction getValueByPath(obj, path) {\n  if (!obj || !path) return \"\";\n\n  var parts = String(path).split(\".\");\n  var value = obj;\n\n  for (var i = 0; i < parts.length; i++) {\n    if (\n      value &&\n      typeof value === \"object\" &&\n      Object.prototype.hasOwnProperty.call(value, parts[i])\n    ) {\n      value = value[parts[i]];\n    } else {\n      return \"\";\n    }\n  }\n\n  return value === null || value === undefined ? \"\" : value;\n}\n\nfunction getValueInfoByPath(obj, path) {\n  if (!obj || !path) return { found: false, value: undefined };\n\n  var parts = String(path).split(\".\");\n  var value = obj;\n\n  for (var i = 0; i < parts.length; i++) {\n    if (\n      value &&\n      typeof value === \"object\" &&\n      Object.prototype.hasOwnProperty.call(value, parts[i])\n    ) {\n      value = value[parts[i]];\n    } else {\n      return { found: false, value: undefined };\n    }\n  }\n\n  return { found: true, value: value };\n}\n\nfunction getFirstObject(values) {\n  for (var i = 0; i < values.length; i++) {\n    var value = parseMaybeJson(values[i]);\n    if (value && typeof value === \"object\" && !Array.isArray(value)) {\n      return value;\n    }\n  }\n\n  return {};\n}\n\nfunction isTableBlock(value) {\n  return (\n    value &&\n    typeof value === \"object\" &&\n    value.type === \"table\" &&\n    Array.isArray(value.content)\n  );\n}\n\nfunction cloneRow(row) {\n  var clone = {};\n\n  if (!row || typeof row !== \"object\") return clone;\n\n  for (var key in row) {\n    if (Object.prototype.hasOwnProperty.call(row, key)) {\n      clone[key] = row[key];\n    }\n  }\n\n  return clone;\n}\n\nfunction cloneBlock(block) {\n  var clone = {};\n\n  if (!block || typeof block !== \"object\") return block;\n\n  for (var key in block) {\n    if (!Object.prototype.hasOwnProperty.call(block, key)) continue;\n    clone[key] = block[key];\n  }\n\n  if (Array.isArray(block.content)) {\n    clone.content = isTableBlock(block)\n      ? block.content.map(cloneRow)\n      : block.content.slice();\n  }\n\n  if (Array.isArray(block.columnOrder)) {\n    clone.columnOrder = block.columnOrder.slice();\n  }\n\n  return clone;\n}\n\nfunction inferColumnOrder(rows) {\n  var order = [];\n  var seen = {};\n\n  for (var r = 0; r < rows.length; r++) {\n    var row = rows[r];\n    if (!row || typeof row !== \"object\") continue;\n\n    for (var key in row) {\n      if (!Object.prototype.hasOwnProperty.call(row, key)) continue;\n\n      var normalized = normalize(key);\n      if (seen[normalized]) continue;\n\n      seen[normalized] = true;\n      order.push(key);\n    }\n  }\n\n  return order;\n}\n\nfunction getRowKeyMap(obj) {\n  if (!obj || typeof obj !== \"object\") return {};\n\n  var cachedMap = obj.__pprDeeplinkKeyMap;\n  if (cachedMap && typeof cachedMap === \"object\") return cachedMap;\n\n  var keyMap = {};\n  for (var key in obj) {\n    if (!Object.prototype.hasOwnProperty.call(obj, key)) continue;\n    keyMap[normalize(key)] = key;\n  }\n\n  try {\n    Object.defineProperty(obj, \"__pprDeeplinkKeyMap\", {\n      value: keyMap,\n      enumerable: false,\n      configurable: true\n    });\n  } catch (e) {\n    // If the row is not extensible, use the local map for this lookup only.\n  }\n\n  return keyMap;\n}\n\nfunction findActualKey(obj, requestedKey) {\n  if (!obj || typeof obj !== \"object\") return null;\n\n  if (Object.prototype.hasOwnProperty.call(obj, requestedKey)) {\n    return requestedKey;\n  }\n\n  var keyMap = getRowKeyMap(obj);\n  var target = normalize(requestedKey);\n  if (Object.prototype.hasOwnProperty.call(keyMap, target)) {\n    return keyMap[target];\n  }\n\n  return null;\n}\n\nfunction getRawValue(row, field) {\n  if (!row || typeof row !== \"object\") return \"\";\n  if (String(field).indexOf(\".\") !== -1) {\n    return getValueByPath(row, field);\n  }\n\n  var actualKey = findActualKey(row, field);\n  if (actualKey === null) return \"\";\n\n  var value = row[actualKey];\n  return value === null || value === undefined ? \"\" : value;\n}\n\nfunction getDisplayValue(row, field) {\n  if (!row || typeof row !== \"object\") return \"\";\n\n  var actualKey = findActualKey(row, field);\n  if (actualKey === null) return \"\";\n\n  var value = row[actualKey];\n  return value === null || value === undefined ? \"\" : value;\n}\n\nfunction getFieldInfo(row, field) {\n  if (!row || typeof row !== \"object\") {\n    return { found: false, value: undefined, key: null };\n  }\n\n  if (String(field).indexOf(\".\") !== -1) {\n    var pathInfo = getValueInfoByPath(row, field);\n    return {\n      found: pathInfo.found,\n      value: pathInfo.value,\n      key: pathInfo.found ? field : null\n    };\n  }\n\n  var actualKey = findActualKey(row, field);\n  if (actualKey === null) {\n    return { found: false, value: undefined, key: null };\n  }\n\n  return {\n    found: true,\n    value: row[actualKey],\n    key: actualKey\n  };\n}\n\nfunction getFirstValue(rawRow, displayRow, candidates) {\n  for (var i = 0; i < candidates.length; i++) {\n    var candidate = candidates[i];\n\n    var rawValue = getRawValue(rawRow, candidate);\n    if (hasValue(rawValue)) return rawValue;\n\n    var displayValue = getDisplayValue(displayRow, candidate);\n    if (hasValue(displayValue)) return displayValue;\n  }\n\n  return \"\";\n}\n\nfunction getFirstPresentFieldInfo(rawRow, displayRow, candidates) {\n  for (var i = 0; i < candidates.length; i++) {\n    var candidate = candidates[i];\n\n    var rawInfo = getFieldInfo(rawRow, candidate);\n    if (rawInfo.found) return rawInfo;\n\n    var displayInfo = getFieldInfo(displayRow, candidate);\n    if (displayInfo.found) return displayInfo;\n  }\n\n  return { found: false, value: undefined, key: null };\n}\n\nfunction stringifyObjKeyValue(value) {\n  if (value === null) return \"null\";\n  if (value === undefined) return \"undefined\";\n  return String(value);\n}\n\nfunction getFieldAliasFromTable(tableBlock) {\n  var contextData = tableBlock && tableBlock.contextData ? tableBlock.contextData : {};\n  var queryContext = contextData && contextData.queryContext ? contextData.queryContext : {};\n\n  return getFirstObject([\n    tableBlock.fieldAlias,\n    tableBlock.fieldAliases,\n    contextData.fieldAlias,\n    contextData.fieldAliases,\n    queryContext.fieldAlias,\n    queryContext.fieldAliases,\n    getValueByPath(queryContext, \"avQuery.fieldAlias\"),\n    getValueByPath(queryContext, \"avQuery.fieldAliases\"),\n    getValueByPath(queryContext, \"bvQuery.fieldAlias\"),\n    getValueByPath(queryContext, \"bvQuery.fieldAliases\"),\n    getValueByPath(queryContext, \"evQuery.fieldAlias\"),\n    getValueByPath(queryContext, \"evQuery.fieldAliases\")\n  ]);\n}\n\nfunction getRawRowsFromTable(tableBlock, processedRows) {\n  var contextData = tableBlock && tableBlock.contextData ? tableBlock.contextData : {};\n  var candidates = [\n    tableBlock.rawRows,\n    tableBlock.rows,\n    contextData.rawRows,\n    contextData.rows,\n    getValueByPath(contextData, \"queryResult.items\"),\n    getValueByPath(contextData, \"queryResult.result.items\")\n  ];\n\n  for (var i = 0; i < candidates.length; i++) {\n    var candidate = parseMaybeJson(candidates[i]);\n    if (Array.isArray(candidate)) return candidate;\n    if (candidate && Array.isArray(candidate.items)) return candidate.items;\n  }\n\n  return processedRows;\n}\n\nfunction removeColumns(columnOrder, processedRows, columnNames) {\n  var removalMap = {};\n  var hasRemovals = false;\n\n  for (var c = 0; c < columnNames.length; c++) {\n    if (!hasValue(columnNames[c])) continue;\n\n    removalMap[normalize(columnNames[c])] = true;\n    hasRemovals = true;\n  }\n\n  if (!hasRemovals) return;\n\n  for (var i = columnOrder.length - 1; i >= 0; i--) {\n    if (removalMap[normalize(columnOrder[i])]) {\n      columnOrder.splice(i, 1);\n    }\n  }\n\n  for (var r = 0; r < processedRows.length; r++) {\n    var row = processedRows[r];\n    if (!row || typeof row !== \"object\") continue;\n\n    for (var key in row) {\n      if (!Object.prototype.hasOwnProperty.call(row, key)) continue;\n      if (removalMap[normalize(key)]) {\n        delete row[key];\n      }\n    }\n  }\n}\n\nfunction getTechnicalFieldRemovalNames(fieldAlias, technicalFields) {\n  var removalNames = technicalFields.slice();\n  var technicalFieldMap = {};\n\n  for (var t = 0; t < technicalFields.length; t++) {\n    technicalFieldMap[normalize(technicalFields[t])] = true;\n  }\n\n  for (var aliasKey in fieldAlias) {\n    if (!Object.prototype.hasOwnProperty.call(fieldAlias, aliasKey)) continue;\n\n    var aliasValue = fieldAlias[aliasKey];\n    if (\n      technicalFieldMap[normalize(aliasValue)] ||\n      technicalFieldMap[normalize(aliasKey)]\n    ) {\n      removalNames.push(aliasKey);\n      removalNames.push(aliasValue);\n    }\n  }\n\n  return removalNames;\n}\n\nfunction addColumnAfter(columnOrder, anchorColumn, newColumn) {\n  for (var i = 0; i < columnOrder.length; i++) {\n    if (normalize(columnOrder[i]) === normalize(newColumn)) return;\n  }\n\n  var anchorIndex = -1;\n  for (var j = 0; j < columnOrder.length; j++) {\n    if (normalize(columnOrder[j]) === normalize(anchorColumn)) {\n      anchorIndex = j;\n      break;\n    }\n  }\n\n  if (anchorIndex === -1) {\n    columnOrder.push(newColumn);\n  } else {\n    columnOrder.splice(anchorIndex + 1, 0, newColumn);\n  }\n}\n\nfunction tableHasColumn(columnOrder, processedRows, candidates) {\n  for (var i = 0; i < candidates.length; i++) {\n    var candidate = candidates[i];\n\n    for (var c = 0; c < columnOrder.length; c++) {\n      if (normalize(columnOrder[c]) === normalize(candidate)) {\n        return true;\n      }\n    }\n\n    var rowsToInspect = processedRows.length < 5 ? processedRows.length : 5;\n    for (var r = 0; r < rowsToInspect; r++) {\n      if (findActualKey(processedRows[r], candidate) !== null) {\n        return true;\n      }\n    }\n  }\n\n  return false;\n}\n\nfunction tableHasExactColumnOrKey(columnOrder, processedRows, exactName) {\n  for (var c = 0; c < columnOrder.length; c++) {\n    if (columnOrder[c] === exactName) return true;\n  }\n\n  var rowsToInspect = processedRows.length < 5 ? processedRows.length : 5;\n  for (var r = 0; r < rowsToInspect; r++) {\n    var row = processedRows[r];\n    if (row && typeof row === \"object\" && Object.prototype.hasOwnProperty.call(row, exactName)) {\n      return true;\n    }\n  }\n\n  return false;\n}\n\nfunction anyItemHasValue(items, fieldName) {\n  for (var i = 0; i < items.length; i++) {\n    var item = items[i];\n    if (!item || typeof item !== \"object\") continue;\n    if (hasValue(item[fieldName])) return true;\n  }\n\n  return false;\n}\n\nfunction getContextFlowFromAny(value) {\n  var source = parseMaybeJson(value) || value;\n  if (!source || typeof source !== \"object\") return \"\";\n\n  return (\n    getValueByPath(source, \"contextFlow\") ||\n    getValueByPath(source, \"result.contextFlow\") ||\n    getValueByPath(source, \"output.contextFlow\") ||\n    getValueByPath(source, \"context.contextFlow\") ||\n    getValueByPath(source, \"queryContext.contextFlow\") ||\n    getValueByPath(source, \"queryContext.intent\") ||\n    \"\"\n  );\n}\n\nfunction getGlobalContextFlow() {\n  var classifierOutput = getNodeOutput(\"FIN_AP_LLM_INTENT_CLASSIFIER\");\n  var classifierPayload = getOutputPayload(classifierOutput);\n\n  return (\n    getContextFlowFromAny(classifierPayload) ||\n    getContextFlowFromAny(classifierOutput) ||\n    \"\"\n  );\n}\n\nfunction getContextFlowFromTable(tableBlock) {\n  var contextData = tableBlock && tableBlock.contextData ? tableBlock.contextData : {};\n  var queryContext = contextData && contextData.queryContext ? contextData.queryContext : {};\n\n  return (\n    getContextFlowFromAny(tableBlock) ||\n    getContextFlowFromAny(contextData) ||\n    getContextFlowFromAny(queryContext) ||\n    getGlobalContextFlow()\n  );\n}\n\nfunction getOriginalRenderFlagsFromContextFlow(contextFlow) {\n  if (!hasValue(contextFlow)) {\n    return {\n      known: false,\n      shouldRenderCompletionDate: false,\n      shouldRenderPendingSince: false,\n      shouldRenderTerminationDate: false\n    };\n  }\n\n  var flow = normalize(contextFlow);\n\n  return {\n    known: true,\n    shouldRenderCompletionDate:\n      flow === normalize(\"getPprByName\") ||\n      flow === normalize(\"getPprByPaymentDate\") ||\n      flow === normalize(\"getPprCompletedWithDateRange\"),\n    shouldRenderPendingSince:\n      flow === normalize(\"getPprByName\") ||\n      flow === normalize(\"getPprByPaymentDate\") ||\n      flow === normalize(\"getPprRequiringAttentionWithDateRange\"),\n    shouldRenderTerminationDate:\n      flow === normalize(\"getPprByName\") ||\n      flow === normalize(\"getPprByPaymentDate\") ||\n      flow === normalize(\"getPprTerminatedWithDateRange\")\n  };\n}\n\nfunction getOriginalRenderFlagsForItems(items, contextFlowOverride) {\n  var flags = getOriginalRenderFlagsFromContextFlow(\n    hasValue(contextFlowOverride) ? contextFlowOverride : getGlobalContextFlow()\n  );\n\n  if (flags.known) return flags;\n\n  return {\n    known: false,\n    shouldRenderCompletionDate: anyItemHasValue(items, \"completionDate\"),\n    shouldRenderPendingSince: anyItemHasValue(items, \"pendingSince\"),\n    shouldRenderTerminationDate: anyItemHasValue(items, \"terminationDate\")\n  };\n}\n\nfunction getOriginalRenderFlagsForTable(tableBlock, columnOrder, processedRows) {\n  var flags = getOriginalRenderFlagsFromContextFlow(getContextFlowFromTable(tableBlock));\n\n  if (flags.known) return flags;\n\n  return {\n    known: false,\n    shouldRenderCompletionDate: tableHasColumn(columnOrder, processedRows, [\n      \"completionDate\",\n      \"Completion Date\"\n    ]),\n    shouldRenderPendingSince: tableHasColumn(columnOrder, processedRows, [\n      \"pendingSince\",\n      \"Pending Since\"\n    ]),\n    shouldRenderTerminationDate: tableHasColumn(columnOrder, processedRows, [\n      \"terminationDate\",\n      \"Termination Date\"\n    ])\n  };\n}\n\nfunction removeSuppressedOriginalDateColumns(tableBlock, columnOrder, processedRows) {\n  var flags = getOriginalRenderFlagsForTable(tableBlock, columnOrder, processedRows);\n  if (!flags.known) return;\n\n  var removals = [];\n\n  if (!flags.shouldRenderCompletionDate) {\n    removals.push(\"completionDate\");\n    removals.push(\"Completion Date\");\n  }\n\n  if (!flags.shouldRenderPendingSince) {\n    removals.push(\"pendingSince\");\n    removals.push(\"Pending Since\");\n  }\n\n  if (!flags.shouldRenderTerminationDate) {\n    removals.push(\"terminationDate\");\n    removals.push(\"Termination Date\");\n  }\n\n  removeColumns(columnOrder, processedRows, removals);\n}\n\nfunction isPprNameTechnicalField(fieldName) {\n  var compact = normalize(fieldName);\n\n  return (\n    compact === \"pprname\" ||\n    compact === \"checkrunname\" ||\n    compact === \"paymentprocessrequest\" ||\n    compact.indexOf(\"paymentprocessrequestname\") !== -1 ||\n    compact.indexOf(\"paymentprocessrequestcheckrunname\") !== -1 ||\n    compact.indexOf(\"paymentrequestname\") !== -1\n  );\n}\n\nfunction isPprNameColumn(columnName) {\n  var label = String(columnName || \"\").trim().toLowerCase();\n  var compact = normalize(columnName);\n\n  if (!label) return false;\n  if (compact.indexOf(\"status\") !== -1) return false;\n  if (compact.indexOf(\"code\") !== -1) return false;\n  if (compact.indexOf(\"date\") !== -1) return false;\n  if (compact.indexOf(\"id\") !== -1 && compact.indexOf(\"name\") === -1) return false;\n\n  return (\n    (compact.indexOf(\"ppr\") !== -1 && compact.indexOf(\"name\") !== -1) ||\n    compact === \"paymentprocessrequest\" ||\n    compact.indexOf(\"paymentprocessrequestname\") !== -1\n  );\n}\n\nfunction addPprColumn(columns, seen, columnName) {\n  if (!hasValue(columnName)) return;\n\n  var key = normalize(columnName);\n  if (seen[key]) return;\n\n  columns.push(columnName);\n  seen[key] = true;\n}\n\nfunction findPprNameColumns(fieldAlias, columnOrder, processedRows) {\n  var columns = [];\n  var seen = {};\n\n  for (var aliasLabel in fieldAlias) {\n    if (!Object.prototype.hasOwnProperty.call(fieldAlias, aliasLabel)) continue;\n\n    var mappedField = fieldAlias[aliasLabel];\n    if (isPprNameTechnicalField(mappedField)) {\n      addPprColumn(columns, seen, aliasLabel);\n    }\n    if (isPprNameTechnicalField(aliasLabel)) {\n      addPprColumn(columns, seen, mappedField);\n    }\n  }\n\n  for (var i = 0; i < columnOrder.length; i++) {\n    var column = columnOrder[i];\n    if (isPprNameColumn(column)) {\n      addPprColumn(columns, seen, column);\n    }\n  }\n\n  var rowsToInspect = processedRows.length < 5 ? processedRows.length : 5;\n  for (var r = 0; r < rowsToInspect; r++) {\n    var row = processedRows[r];\n    if (!row || typeof row !== \"object\") continue;\n\n    for (var name in row) {\n      if (!Object.prototype.hasOwnProperty.call(row, name)) continue;\n      if (isPprNameColumn(name)) {\n        addPprColumn(columns, seen, name);\n      }\n    }\n  }\n\n  return columns;\n}\n\nfunction findStatusColumn(displayRow) {\n  var preferred = [\n    \"paymentProcessRequestStatus\",\n    \"Payment Process Request Status\",\n    \"PPR Status\",\n    \"Linked PPR Status\",\n    \"Request Status\"\n  ];\n\n  for (var i = 0; i < preferred.length; i++) {\n    var preferredKey = findActualKey(displayRow, preferred[i]);\n    if (preferredKey !== null) return preferredKey;\n  }\n\n  for (var key in displayRow) {\n    if (!Object.prototype.hasOwnProperty.call(displayRow, key)) continue;\n\n    var compact = normalize(key);\n    if (\n      compact.indexOf(\"status\") !== -1 &&\n      compact.indexOf(\"code\") === -1 &&\n      compact.indexOf(\"paymentprocessrequest\") !== -1\n    ) {\n      return key;\n    }\n  }\n\n  fo