ymentId\",          \"Bank Assigned Reference\": \"bankAssignedReferenceCode\",          \"Unique Remittance Identifier\": \"uniqueRemittanceIdentifier\",          \"Payment Reason Comments\": \"paymentReasonComments\",          \"Created On\": \"timeCreated\",          \"Created By\": \"createdBy\",          \"Last Updated On\": \"timeUpdated\",          \"Last Updated By\": \"updatedBy\",          \"Payment Reference Number\": \"paymentReferenceNumber\",          \"Payment Date\": \"paymentDate\",          \"Payment Amount\": \"paymentAmount\",          \"Payment Currency\": \"paymentCurrencyCode\",          \"Payee\": \"payeeName\",          \"Payee Party Name\": \"payeePartyName\",          \"Invoice Payee Party Name\": \"invoicePayeePartyName\",          \"Payment Business Unit\": \"paymentBusinessUnit\",          \"Payment Process Request\": \"paymentProcessRequestName\",          \"Invoice Due Date\": \"invoiceDueDate\",          \"Maturity Date\": \"maturityDate\",          \"Anticipated Value Date\": \"anticipatedValueDate\",          \"Payment Complete\": \"paymentCompleteFlag\",          \"Service Level Code\": \"serviceLevelCode\",          \"Delivery Channel Code\": \"deliveryChannelCode\",          \"Bank Status Code\": \"bankStatusCode\",          \"Payment System Response Identifier\": \"paymentSystemResponseIdentifier\",          \"Issuer Authorization Reference\": \"issuerAuthorizationReference\",          \"Acquirer Transaction Reference\": \"acquirerTransactionReference\",          \"Issuer Processing Timestamp\": \"issuerProcessingTimestamp\",          \"Void Date\": \"voidDate\",          \"Void Reason\": \"voidReason\",          \"Stop Date\": \"stopDate\",          \"Stop Request Reason\": \"stopRequestReason\",          \"Payment Declaration Amount\": \"paymentDeclarationAmount\",          \"Bank Charge Amount\": \"bankChargeAmount\",          \"URI Check Digit\": \"uriCheckDigit\",          \"Remittance Message 1\": \"remittanceMessageOne\",          \"Remittance Message 2\": \"remittanceMessageTwo\",          \"Remittance Message 3\": \"remittanceMessageThree\",          \"Payment Text Message 1\": \"paymentTextMessageOne\",          \"Payment Text Message 2\": \"paymentTextMessageTwo\",          \"Payment Text Message 3\": \"paymentTextMessageThree\",          \"Stop Request Placed\": \"stopRequestPlacedFlag\",          \"Declaration Currency\": \"declarationCurrencyCode\",          \"Paper Document Number\": \"paperDocumentNumber\",          \"Stop Request Placed By\": \"stopRequestPlacedBy\",          \"Payment Status Lookup Code\": \"paymentStatusLookupCode\",          \"Payment Function Lookup Code\": \"paymentFunctionLookupCode\",          \"Payment Status Code\": \"paymentStatus.lookupCode\",          \"Payment Status\": \"paymentStatus.meaning\",          \"Funds Status Code\": \"fundsStatus.lookupCode\",          \"Funds Status\": \"fundsStatus.meaning\",          \"Payment Function Code\": \"paymentFunction.lookupCode\",          \"Payment Function\": \"paymentFunction.meaning\",          \"Payment Mode Code\": \"paymentMode.lookupCode\",          \"Payment Mode\": \"paymentMode.meaning\",          \"Payment Method Code\": \"paymentMethod.code\",          \"Payment Method\": \"paymentMethod.paymentMethodName\",          \"Payment Instrument Alias\": \"paymentInstrument.paymentInstrumentAlias\",          \"Payment Instrument Type\": \"paymentInstrument.instrumentType\",          \"Disbursement Bank Account\": \"disbursementBankAccount.name\",          \"Disbursement Bank\": \"disbursementBankAccount.bank.name\",          \"Disbursement Bank Country\": \"disbursementBankAccount.bank.countryCode\",          \"Disbursement Bank Branch\": \"disbursementBankAccount.bankBranch.name\",          \"Disbursement Bank Branch Number\": \"disbursementBankAccount.bankBranch.branchNumber\",          \"External Bank Account\": \"externalBankAccount.bankAccountName\",          \"External Bank Account Number\": \"externalBankAccount.maskedAccountNumber\",          \"External IBAN\": \"externalBankAccount.maskedIban\",          \"External Bank Country\": \"externalBankAccount.countryCode\",          \"Virtual Card Program\": \"digitalPaymentAccount.virtualCardProgram.vcardProgramName\",          \"Payment Profile ID\": \"accountPaymentProfile.paymentProfileId\",          \"Payment Profile Name\": \"accountPaymentProfile.paymentProfileName\",          \"Processing Type\": \"accountPaymentProfile.systemPaymentProfile.processingType.meaning\",          \"Processing Type Code\": \"accountPaymentProfile.systemPaymentProfile.processingType.lookupCode\",          \"Payment Format Code\": \"accountPaymentProfile.systemPaymentProfile.paymentFormat.paymentFormatCode\",          \"Payment Format Name\": \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatName\",          \"Payment Format Template\": \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatTemplateCode\",          \"Format Type\": \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatType.formatTypeName\",          \"Payment File ID\": \"payablesPaymentFile.paymentInstructionId\",          \"Payment File Reference\": \"payablesPaymentFile.paymentInstructionId\",          \"Payment File Request Name\": \"payablesPaymentFile.paymentRequestName\",          \"Payment File Processing Status Lookup Code\": \"payablesPaymentFile.paymentFileProcessingStatusLookupCode\",          \"Payment File Status Code\": \"payablesPaymentFile.paymentFileProcessingStatus.lookupCode\",          \"Payment File Status\": \"payablesPaymentFile.paymentFileProcessingStatus.meaning\",          \"Acknowledgement File Name\": \"disbursementInboundFile.fileName\",          \"Acknowledgement File Created On\": \"disbursementInboundFile.timeCreated\",          \"Acknowledgement Error Message\": \"disbursementInboundFile.errorMessage\",          \"Acknowledgement Payment System\": \"disbursementInboundFile.paymentSystem.paymentSystemName\",          \"Acknowledgement Status Code\": \"disbursementInboundFile.inboundFileProcessingStatus.lookupCode\",          \"Acknowledgement Status\": \"disbursementInboundFile.inboundFileProcessingStatus.meaning\",          \"PPR ID\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",          \"PPR Name\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",          \"PPR Status Lookup Code\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatusLookupCode\",          \"PPR Status Code\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",          \"PPR Status\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\",          \"PPR Initiation\": \"paymentsPayablesPaymentProcessRequest.paymentInitiation.meaning\",          \"Legal Entity ID\": \"legalEntity.legalEntityId\",          \"Legal Entity\": \"legalEntity.name\",          \"Supplier Site\": \"supplierSite.name\",          \"Supplier ID\": \"supplierSite.supplier.supplierId\",          \"Supplier Name\": \"supplierSite.supplier.name\",          \"Supplier Type Code\": \"supplierSite.supplier.supplierType.lookupCode\",          \"Supplier Type\": \"supplierSite.supplier.supplierType.meaning\",          \"AP Payment ID\": \"payablesPayment.paymentId\",          \"AP Payment Number\": \"payablesPayment.paymentNumber\",          \"AP Supplier Name\": \"payablesPayment.supplierName\",          \"Remit-To Supplier\": \"payablesPayment.remitToSupplierName\",          \"Remit-To Address\": \"payablesPayment.remitToAddressName\",          \"AP Payment Date\": \"payablesPayment.paymentDate\",          \"AP Payment Amount\": \"payablesPayment.paymentAmount\",          \"AP Payment Currency\": \"payablesPayment.paymentCurrency.currencyCode\",          \"AP Payment Status Code\": \"payablesPayment.paymentStatus.lookupCode\",          \"AP Payment Status\": \"payablesPayment.paymentStatus.meaning\",          \"Reconciled\": \"payablesPayment.reconciledFlag\",          \"Clearing Date\": \"payablesPayment.clearingDate\"        }      },      \"fieldSelection\": {        \"base\": [          \"paymentId\",          \"paymentReferenceNumber\",          \"paymentDate\",          \"paymentAmount\",          \"paymentCurrencyCode\",          \"payeePartyName\",          \"paymentProcessRequestName\",          \"paymentBusinessUnit\",          \"paymentCompleteFlag\",          \"bankStatusCode\",          \"invoiceDueDate\"        ],        \"optional\": [          \"bepErrorCode\",          \"bepErrorMessageText\",          \"paymentProfileSystemName\",          \"paymentProfileAccountName\",          \"bankAssignedReferenceCode\",          \"uniqueRemittanceIdentifier\",          \"paymentReasonComments\",          \"timeCreated\",          \"updatedBy\",          \"timeUpdated\",          \"createdBy\",          \"payeeName\",          \"paymentSystemResponseIdentifier\",          \"issuerAuthorizationReference\",          \"acquirerTransactionReference\",          \"issuerProcessingTimestamp\",          \"voidDate\",          \"voidReason\",          \"stopDate\",          \"stopRequestReason\",          \"paymentDeclarationAmount\",          \"bankChargeAmount\",          \"uriCheckDigit\",          \"maturityDate\",          \"remittanceMessageOne\",          \"remittanceMessageTwo\",          \"remittanceMessageThree\",          \"paymentTextMessageOne\",          \"paymentTextMessageTwo\",          \"paymentTextMessageThree\",          \"stopRequestPlacedFlag\",          \"anticipatedValueDate\",          \"declarationCurrencyCode\",          \"invoicePayeePartyName\",          \"paperDocumentNumber\",          \"serviceLevelCode\",          \"deliveryChannelCode\",          \"stopRequestPlacedBy\"        ]      },      \"sortableAttributes\": [        \"paymentDate\",        \"paymentReferenceNumber\",        \"bankAssignedReferenceCode\",        \"uniqueRemittanceIdentifier\",        \"timeCreated\",        \"timeUpdated\",        \"paymentId\",        \"paymentAmount\",        \"paymentCurrencyCode\",        \"paymentDate\",        \"payeeName\",        \"payeePartyName\",        \"paymentProcessRequestName\",        \"paymentCompleteFlag\",        \"bankStatusCode\",        \"paymentSystemResponseIdentifier\",        \"issuerAuthorizationReference\",        \"acquirerTransactionReference\",        \"voidDate\",        \"voidReason\",        \"stopDate\",        \"stopRequestReason\",        \"maturityDate\",        \"invoicePayeePartyName\",        \"invoiceDueDate\",        \"paperDocumentNumber\",        \"serviceLevelCode\",        \"deliveryChannelCode\"      ],      \"filterConditions\": [        {          \"name\": \"paymentId\",          \"attribute\": \"paymentId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides an internal disbursement payment identifier.\"        },        {          \"name\": \"paymentReferenceNumber\",          \"attribute\": \"paymentReferenceNumber\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides the payment reference number rather than the internal payment id.\"        },        {          \"name\": \"paymentDate\",          \"attribute\": \"paymentDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use for payment-date filters and date windows.\"        },        {          \"name\": \"paymentAmount\",          \"attribute\": \"paymentAmount\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user gives a payment amount threshold or asks for high-value payments.\"        },        {          \"name\": \"paymentCurrencyCode\",          \"attribute\": \"paymentCurrencyCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment currency.\"        },        {          \"name\": \"payeePartyName\",          \"attribute\": \"payeePartyName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user names the payee or supplier in payment logistics questions.\"        },        {          \"name\": \"payablesPayment.supplierName\",          \"attribute\": \"payablesPayment.supplierName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the supplier name is available through the AP payment accessor.\"        },        {          \"name\": \"paymentBusinessUnit\",          \"attribute\": \"paymentBusinessUnit\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes payments by business unit.\"        },        {          \"name\": \"payablesPaymentFile.paymentInstructionId\",          \"attribute\": \"payablesPaymentFile.paymentInstructionId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a payment file identifier.\"        },        {          \"name\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",          \"attribute\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a payment process request id.\"        },        {          \"name\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",          \"attribute\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a payment process request name.\"        },        {          \"name\": \"paymentStatus.lookupCode\",          \"attribute\": \"paymentStatus.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides or requests a specific payment status code.\"        },        {          \"name\": \"paymentStatus.meaning\",          \"attribute\": \"paymentStatus.meaning\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user gives the display meaning of the payment status.\"        },        {          \"name\": \"bankStatusCode\",          \"attribute\": \"bankStatusCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for payment-system or transmission-side acceptance or rejection status.\"        },        {          \"name\": \"paymentMethod.code\",          \"attribute\": \"paymentMethod.code\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment method code.\"        },        {          \"name\": \"paymentMethod.paymentMethodName\",          \"attribute\": \"paymentMethod.paymentMethodName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment method name.\"        },        {          \"name\": \"paymentMode.lookupCode\",          \"attribute\": \"paymentMode.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [            \"VIRTUAL_CARD\"          ],          \"usage\": \"Use when the user asks about virtual card payments or other specific payment modes.\"        },        {          \"name\": \"paymentInstrument.paymentInstrumentAlias\",          \"attribute\": \"paymentInstrument.paymentInstrumentAlias\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides an RCN or payment instrument alias.\"        },        {          \"name\": \"digitalPaymentAccount.virtualCardProgram.vcardProgramName\",          \"attribute\": \"digitalPaymentAccount.virtualCardProgram.vcardProgramName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by virtual card program name.\"        },        {          \"name\": \"serviceLevelCode\",          \"attribute\": \"serviceLevelCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about payment service levels.\"        },        {          \"name\": \"deliveryChannelCode\",          \"attribute\": \"deliveryChannelCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about payment delivery channels.\"        },        {          \"name\": \"disbursementBankAccount.name\",          \"attribute\": \"disbursementBankAccount.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks which disbursement bank account was used.\"        },        {          \"name\": \"disbursementBankAccount.bank.name\",          \"attribute\": \"disbursementBankAccount.bank.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by disbursement bank name.\"        },        {          \"name\": \"disbursementBankAccount.bankBranch.name\",          \"attribute\": \"disbursementBankAccount.bankBranch.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by disbursement bank branch name.\"        },        {          \"name\": \"externalBankAccount.countryCode\",          \"attribute\": \"externalBankAccount.countryCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for payee bank-country context.\"        },        {          \"name\": \"invoiceDueDate\",          \"attribute\": \"invoiceDueDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about invoice due dates tied to the payment.\"        },        {          \"name\": \"legalEntity.legalEntityId\",          \"attribute\": \"legalEntity.legalEntityId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use legalEntity.legalEntityId=null when the user asks for payments in a payment file where legal entity is missing.\"        },        {          \"name\": \"disbursementInboundFile.id\",          \"attribute\": \"disbursementInboundFile.id\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use is not null when the user asks for payments linked to an inbound acknowledgement file.\"        },        {          \"name\": \"disbursementInboundFile.paymentSystem.paymentSystemName\",          \"attribute\": \"disbursementInboundFile.paymentSystem.paymentSystemName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for acknowledgement-linked payments by payment system or bank such as JPM.\"        },        {          \"name\": \"voidDate\",          \"attribute\": \"voidDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about void timing or voided-payment aging.\"        },        {          \"name\": \"stopDate\",          \"attribute\": \"stopDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks how long a payment has remained stopped or stop initiated.\"        },        {          \"name\": \"payablesPayment.paymentNumber\",          \"attribute\": \"payablesPayment.paymentNumber\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user gives the AP payment number for follow-up actions such as void, reissue, remittance, or status lookup.\"        },        {          \"name\": \"payablesPayment.paymentStatus.lookupCode\",          \"attribute\": \"payablesPayment.paymentStatus.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user is asking for AP payment status rather than only the disbursement-side status. Use `VOIDED` for voided-payment inquiries, including JPM acknowledgement-linked voided payments.\"        },        {          \"name\": \"externalBankAccount.timeUpdated\",          \"attribute\": \"externalBankAccount.timeUpdated\",          \"type\": \"datetime\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks when the supplier external bank account was modified; for example externalBankAccount.timeUpdated>=2007-01-03T23:02:42Z.\"        },        {          \"name\": \"payablesPayment.reconciledFlag\",          \"attribute\": \"payablesPayment.reconciledFlag\",          \"type\": \"boolean\",          \"possibleValues\": [            true,            false          ],          \"usage\": \"Use when the user asks whether matched payments are cleared or reconciled.\"        }      ],      \"dateFilterGuidance\": null,      \"extractionQuery\": null,      \"businessDrivers\": [        {          \"name\": \"paymentByIdOrReference\",          \"description\": \"Retrieve a specific disbursement payment by internal payment id or payment reference number.\",          \"when\": \"User asks for one payment, one payment reference, or one payment's processing details.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"paymentStatus.meaning\",            \"paymentMethod.paymentMethodName\",            \"payablesPaymentFile.paymentInstructionId\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"paymentId=<PAYMENT_ID_FROM_USER> or paymentReferenceNumber='<PAYMENT_REFERENCE_NUMBER_FROM_USER>'\"          ],          \"notes\": \"Prefer `paymentId` when the user clearly gives the internal payment id.\"        },        {          \"name\": \"supplierPaymentLogisticsByDate\",          \"description\": \"Retrieve bank-account and payment-logistics details for a supplier or payee on a payment date.\",          \"when\": \"User asks which bank account was used to pay a supplier on a given payment date or asks for surrounding logistics.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"payeePartyName\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"disbursementBankAccount.name\",            \"disbursementBankAccount.bank.name\",            \"disbursementBankAccount.bank.countryCode\",            \"disbursementBankAccount.bankBranch.name\",            \"disbursementBankAccount.bankBranch.branchNumber\"          ],          \"extraFilterExpressions\": [            \"(payeePartyName='<SUPPLIER_NAME_FROM_USER>' or payablesPayment.supplierName='<SUPPLIER_NAME_FROM_USER>')\",            \"paymentDate=<PAYMENT_DATE_FROM_USER>\"          ],          \"notes\": \"Return bank account, bank, branch, and currency together so the answer includes the full logistics context.\"        },        {          \"name\": \"paymentFormatByPayment\",          \"description\": \"Retrieve the payment file format and related processing metadata for a specific payment.\",          \"when\": \"User asks what payment file format was used for a payment or asks for processing-option metadata.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"accountPaymentProfile.paymentProfileName\",            \"accountPaymentProfile.systemPaymentProfile.systemProfileCode\",            \"accountPaymentProfile.systemPaymentProfile.processingType.meaning\",            \"accountPaymentProfile.systemPaymentProfile.paymentFormat.paymentFormatCode\",            \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatName\",            \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatTemplateCode\",            \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatType.formatTypeName\"          ],          \"extraFilterExpressions\": [            \"paymentId=<PAYMENT_ID_FROM_USER>\"          ],          \"notes\": \"Use the payment-format accessor chain instead of trying to infer the format from payment method alone.\"        },        {          \"name\": \"bankRoutingByPayment\",          \"description\": \"Retrieve disbursement bank routing details for a specific payment.\",          \"when\": \"User asks for the bank, bank branch, or bank-country details for a payment.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"disbursementBankAccount.name\",            \"disbursementBankAccount.bank.name\",            \"disbursementBankAccount.bank.countryCode\",            \"disbursementBankAccount.bankBranch.name\",            \"disbursementBankAccount.bankBranch.branchNumber\",            \"paymentCurrencyCode\"          ],          \"extraFilterExpressions\": [            \"paymentId=<PAYMENT_ID_FROM_USER>\"          ],          \"notes\": \"sort by paymentDate:asc\"        },        {          \"name\": \"bankBranchAndCountryByPprInstallments\",          \"description\": \"Retrieve disbursement bank branch, bank, and country details for payments/installments under a named PPR.\",          \"when\": \"User asks for the bank branch, bank, or country for installments or payments under a PPR.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"payeePartyName\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"disbursementBankAccount.name\",            \"disbursementBankAccount.bank.name\",            \"disbursementBankAccount.bank.countryCode\",            \"disbursementBankAccount.bankBranch.name\",            \"disbursementBankAccount.bankBranch.branchNumber\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>'\",            \"sortBy: paymentDate:desc\",            \"limit: 20\"          ],          \"notes\": \"Use this for PPR-scoped bank branch/country questions. Sort by paymentDate desc and limit 20. Do not use paymentDate asc for this latest-results lookup.\"        },        {          \"name\": \"serviceLevelAndDeliveryChannelByPayment\",          \"description\": \"Retrieve service-level and delivery-channel attributes for a payment reference or payment id, with related payment-format context when requested.\",          \"when\": \"User asks for service level codes, delivery channels, or how a payment was configured for delivery.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"serviceLevelCode\",            \"deliveryChannelCode\",            \"paymentMethod.paymentMethodName\",            \"paymentMode.meaning\",            \"accountPaymentProfile.systemPaymentProfile.paymentFormat.paymentFormatCode\",            \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatName\"          ],          \"extraFilterExpressions\": [            \"If the user says payment reference or payment reference number, use paymentReferenceNumber = '<PAYMENT_REFERENCE_NUMBER_FROM_USER>'\",            \"If the user says payment id or plain payment <number> without reference wording, use paymentId = <PAYMENT_ID_FROM_USER>\",            \"sortBy=paymentReferenceNumber:asc\",            \"limit=20\"          ],          \"notes\": \"Supported lookup. serviceLevelCode and deliveryChannelCode are returned fields, not filters. Explicit payment reference wording must use paymentReferenceNumber, not paymentId. Sort by paymentReferenceNumber:asc before limit 20; do not use paymentDate sorting or unsupported-response fallback.\"        },        {          \"name\": \"paymentsByPprOrFile\",          \"description\": \"Retrieve disbursement payments for a payment file or PPR, including file and PPR status details.\",          \"when\": \"User asks for payments within a payment file or payment process request and wants payment-processing context.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"payeePartyName\",            \"paymentAmount\",            \"paymentStatus.meaning\",            \"payablesPaymentFile.paymentInstructionId\",            \"payablesPaymentFile.paymentFileProcessingStatus.meaning\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentFile.paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId=<PPR_ID_FROM_USER> or paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Use the filter expression that matches the identifier the user actually provides. For external bank account for all payees selected in a PPR, use the locked field rule with externalBankAccount.bankAccountName,payeePartyName and paymentDate:asc.\"        },        {          \"name\": \"virtualCardPaymentsByAliasAndDate\",          \"description\": \"Retrieve virtual card payments by RCN alias in a date window.\",          \"when\": \"User asks how many payments were paid or are in process using a specific virtual card alias or RCN.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentStatus.meaning\",            \"payablesPayment.reconciledFlag\",            \"paymentMode.lookupCode\",            \"paymentInstrument.paymentInstrumentAlias\",            \"payablesPaymentFile.paymentInstructionId\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\"          ],          \"extraFilterExpressions\": [            \"paymentMode.lookupCode='VIRTUAL_CARD'\",            \"paymentInstrument.paymentInstrumentAlias='<RCN_ALIAS_FROM_USER>'\",            \"paymentDate>=<START_DATE>\",            \"paymentDate<=<END_DATE>\"          ],          \"notes\": \"Use this payment slice together with document-level shapes when the user also wants invoice or installment detail.\"        },        {          \"name\": \"virtualCardProgramReconciliation\",          \"description\": \"Retrieve virtual card payments where the virtual card program and payment instrument alias indicate a program mismatch or cross-program usage check.\",          \"when\": \"User asks for virtual card payments where the program name and instrument alias indicate a cross-program or mismatch scenario.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentStatus.meaning\",            \"digitalPaymentAccount.virtualCardProgram.vcardProgramName\",            \"paymentInstrument.paymentInstrumentAlias\",            \"payablesPaymentFile.paymentInstructionId\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"paymentMode.lookupCode='VIRTUAL_CARD'\",            \"digitalPaymentAccount.virtualCardProgram.vcardProgramName='<VCARD_PROGRAM_NAME_FROM_USER>'\",            \"paymentInstrument.paymentInstrumentAlias like '%<RCN_ALIAS_FRAGMENT_FROM_USER>%'\"          ],          \"notes\": \"Use a contains-style filter on the payment instrument alias when the user gives a program fragment rather than the full alias.\"        },        {          \"name\": \"manualHighValuePaymentReview\",          \"description\": \"Retrieve manual or operational-risk payments with business-unit, status, bank-account, and reconciliation context.\",          \"when\": \"User asks for manual electronic payments, user-selected payments, or high-value payment review scoped by business unit, supplier, date range, amount threshold, or reconciliation state.\",          \"fieldsToReturn\": [            \"payablesPayment.paymentNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"paymentBusinessUnit\",            \"paymentMethod.paymentMethodName\",            \"paymentMode.lookupCode\",            \"disbursementBankAccount.name\",            \"paymentStatus.lookupCode\",            \"paymentStatus.meaning\",            \"payablesPayment.reconciledFlag\"          ],          \"extraFilterExpressions\": [            \"paymentBusinessUnit='<BUSINESS_UNIT_NAME_FROM_USER>'\",            \"payeePartyName='<SUPPLIER_NAME_FROM_USER>' or payablesPayment.supplierName='<SUPPLIER_NAME_FROM_USER>'\",            \"paymentAmount>=<AMOUNT_THRESHOLD_FROM_USER>\",            \"paymentDate>=<START_DATE_FROM_USER>\",            \"paymentDate<=<END_DATE_FROM_USER>\",            \"payablesPayment.reconciledFlag=false\",            \"paymentMethod.paymentMethodName='<PAYMENT_METHOD_NAME_FROM_USER>' or paymentMode.lookupCode='<PAYMENT_MODE_CODE_FROM_USER>'\"          ],          \"notes\": \"Use this disbursement BV for Payments-flow operational review because it preserves bank account, payment file, PPR, and AP payment context in one fetch.\"        },        {          \"name\": \"highValuePaymentsWithSupplierDetails\",          \"description\": \"Retrieve payments above a requested amount threshold with supplier/payee and payment logistics details.\",          \"when\": \"User asks for all payments over a threshold with supplier details.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"payeePartyName\",            \"payablesPayment.supplierName\",            \"supplierSite.supplier.supplierType.meaning\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"paymentBusinessUnit\",            \"paymentStatus.meaning\",            \"disbursementBankAccount.name\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"paymentAmount > <AMOUNT_THRESHOLD_FROM_USER>\"          ],          \"notes\": \"Use this disbursement payment shape for generic high-value payment lists with supplier details. Do not mark the request unsupported; default to limit 20 and sort by paymentAmount desc when supported.\"        },        {          \"name\": \"paymentAgingAndFollowUp\",          \"description\": \"Retrieve aged unreconciled, stopped, voided, or action-targeted payments for follow-up.\",          \"when\": \"User asks for unreconciled payments older than a threshold, stop-initiated payments older than a threshold, or identifies a payment number for void, reissue, or remittance follow-up.\",          \"fieldsToReturn\": [            \"payablesPayment.paymentNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"paymentStatus.lookupCode\",            \"paymentStatus.meaning\",            \"payablesPayment.paymentStatus.lookupCode\",            \"payablesPayment.paymentStatus.meaning\",            \"payablesPayment.reconciledFlag\",            \"stopDate\",            \"voidDate\",            \"payablesPaymentFile.paymentInstructionId\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"payablesPayment.paymentNumber=<PAYMENT_NUMBER_FROM_USER>\",            \"payablesPayment.reconciledFlag=false\",            \"paymentDate<=<END_DATE_FROM_USER>\",            \"paymentStatus.lookupCode='<PAYMENT_STATUS_CODE_FROM_USER>' or paymentStatus.meaning='<PAYMENT_STATUS_MEANING_FROM_USER>'\",            \"payablesPayment.paymentStatus.lookupCode='<AP_PAYMENT_STATUS_CODE_FROM_USER>'\",            \"stopDate<=<END_DATE_FROM_USER>\",            \"voidDate<=<END_DATE_FROM_USER>\"          ],          \"notes\": \"For action-oriented requests, use the AP payment number as the keyed lookup and return enough payment, file, and PPR context for the next routing step.\"        },        {          \"name\": \"crossShapePaymentStatusFollowUp\",          \"description\": \"Retrieve detailed payment status, payment-file, and PPR context once a payment id has been identified from another shape.\",          \"when\": \"User starts from an expense report, refund reference, invoice, or document and then wants the payment status and payment logistics for the matched payment.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentStatus.meaning\",            \"paymentMethod.paymentMethodName\",            \"payablesPayment.reconciledFlag\",            \"payablesPaymentFile.paymentInstructionId\",            \"payablesPaymentFile.paymentFileProcessingStatus.meaning\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\"          ],          \"extraFilterExpressions\": [            \"paymentId=<PAYMENT_ID_FROM_UPSTREAM_SHAPE>\"          ],          \"notes\": \"Use paymentRunInstallments first when the user identifies the payment through an expense report number, refund reference, or invoice reference instead of a payment identifier.\"        },        {          \"name\": \"pprOrDisbursementExceptionReview\",          \"description\": \"Retrieve disbursement-side payments for exception review when the user asks for transmission failures, payment-file scoped issues, or bank-account scoped payment monitoring.\",          \"when\": \"User asks for payment execution exceptions, payment-file monitoring, disbursement bank account monitoring, or payment slices tied to PPR/process status.\",          \"fieldsToReturn\": [            \"payablesPayment.paymentNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"supplier.name\",            \"disbursementBankAccount.name\",            \"paymentMethod.paymentMethodName\",            \"payablesPayment.paymentStatus.lookupCode\",            \"payablesPayment.paymentStatus.meaning\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",            \"payablesPaymentFile.paymentInstructionId\",            \"payablesPayment.reconciledFlag\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode in ('PENDING_REVIEW_DOC_VAL_ERRORS','PENDING_REVIEW_PMT_VAL_ERRORS','VALIDATION_FAILED','FAILED_PAYMENT_VALIDATION','MISSING RATES','MISSING_X_RATES','ORA_APPROVAL_ERROR','TERMINATED')\",            \"disbursementBankAccount.name='<BANK_ACCOUNT_NAME_FROM_USER>'\",            \"paymentDate>=<START_DATE_FROM_USER>\",            \"paymentDate<=<END_DATE_FROM_USER>\",            \"paymentAmount>=<AMOUNT_THRESHOLD_FROM_USER>\",            \"payablesPaymentFile.paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\"          ],          \"notes\": \"Use this BV for disbursement-oriented monitoring and exception screening. If the request needs comparison with another shape, instruction metadata, or exception detail enrichment, route to an extraction shape.\"        },        {          \"name\": \"pprPendingReviewPaymentReview\",          \"description\": \"Retrieve proposed disbursement payments for PPRs that are in pending review status, with optional filtering by PPR ID or PPR Name.\",          \"when\": \"User explicitly asks for proposed disbursement payments in PPRs that are pending review, pending proposed payment review, or awaiting review. Do not use for the generic request Review proposed payments for all PPRs.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"paymentStatus.meaning\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\",            \"payablesPaymentFile.paymentInstructionId\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode='PENDING_REVIEW'\",            \"(paymentsPayablesPaymentProcessRequest.paymentProcessRequestId=<PPR_ID_FROM_USER> or paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>')\"          ],          \"notes\": \"Use only when pending-review wording is explicit. For generic Review proposed payments for all PPRs, do not use disbursementPayments; use paymentRunInstallmentSummaries AV plus paymentRunInstallments BV with no PENDING_REVIEW filter.\"        },        {          \"name\": \"recentExternalBankAccountChangeRiskReview\",          \"description\": \"Retrieve payments whose supplier external bank account was recently updated, sorted by most recently updated first, for fraud-risk review.\",          \"when\": \"User asks for payments where the supplier's bank account was recently changed, with no supplier filter, and wants the most recently updated records first.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"payeePartyName\",            \"payablesPayment.supplierName\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"paymentBusinessUnit\",            \"externalBankAccount.bankAccountName\",            \"externalBankAccount.maskedIban\",            \"externalBankAccount.maskedAccountNumber\",            \"externalBankAccount.eftSwiftCode\",            \"externalBankAccount.countryCode\",            \"externalBankAccount.timeCreated\",            \"externalBankAccount.timeUpdated\",            \"paymentStatus.meaning\",            \"payablesPaymentFile.paymentInstructionId\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"externalBankAccount.timeUpdated>=<TODAY_MINUS_30_DAYS>\",            \"externalBankAccount.timeUpdated >= '<CURRENT_DATE_MINUS_30_DAYS_T00:00:00Z>'\",            \"sortBy: paymentDate:desc\",            \"limit: 20\"          ],          \"notes\": \"Do not require a supplier filter. Do not Sort by externalBankAccount.timeUpdated as sorting is not supported on this field.Sort by paymentDate:desc Use this as a fraud-risk review slice for recent external bank account changes.\"        },        {          \"name\": \"pprPendingReviewPaymentReviewAll\",          \"description\": \"Retrieve proposed disbursement payments for all PPRs that are in pending review status.\",          \"when\": \"User explicitly asks for proposed disbursement payments in PPRs that are pending review, pending proposed payment review, or awaiting review. Do not use for the generic request Review proposed payments for all PPRs.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"paymentStatus.meaning\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\",            \"payablesPaymentFile.paymentInstructionId\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode='PENDING_REVIEW'\"          ],          \"notes\": \"Use only when pending-review wording is explicit. For generic Review proposed payments for all PPRs, do not use disbursementPayments; use paymentRunInstallmentSummaries AV plus paymentRunInstallments BV with no PENDING_REVIEW filter.\"        },        {          \"name\": \"paymentsInPaymentFileMissingLegalEntity\",          \"description\": \"Retrieve payments in a payment file where legal entity is missing.\",          \"when\": \"User asks for payment-file payments with missing legal entity or asks why payments in a file are missing legal entity details.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"legalEntity.legalEntityId\",            \"legalEntity.name\",            \"payablesPaymentFile.paymentInstructionId\",            \"payablesPaymentFile.paymentFileProcessingStatus.meaning\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentFile.paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\",            \"legalEntity.legalEntityId=null\"          ],          \"notes\": \"Taxpayer ID is not currently in scope for this inquiry.\"        },        {          \"name\": \"voidedJpmAcknowledgementLinkedPayments\",          \"description\": \"Retrieve voided payments linked to JPM acknowledgement files.\",          \"when\": \"User asks for voided JPM acknowledgement-linked payments or payments rejected through JPM acknowledgement context.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentMethod.paymentMethodName\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"disbursementBankAccount.bank.name\",            \"voidDate\",            \"voidReason\",            \"payablesPayment.paymentStatus.lookupCode\",            \"payablesPayment.paymentStatus.meaning\",            \"payablesPaymentFile.paymentInstructionId\",            \"disbursementInboundFile.fileName\",            \"disbursementInboundFile.paymentSystem.paymentSystemName\",            \"disbursementInboundFile.inboundFileProcessingStatus.meaning\"          ],          \"extraFilterExpressions\": [            \"disbursementInboundFile.id is not null\",            \"payablesPayment.paymentStatus.lookupCode='VOIDED'\",            \"voidDate is not null\",            \"disbursementInboundFile.paymentSystem.paymentSystemName like '%JPM%'\"          ],          \"notes\": \"Use explicit inbound-file linkage and payment system name. For voided-payment status, use the AP checks-backed `payablesPayment.paymentStatus.lookupCode='VOIDED'`; do not use disbursement-side `paymentStatus.lookupCode='VOID'` for this use case. Apply user-provided date windows to `voidDate`. Do not infer L1/L2/L3 file classification from file names.\"        },        {          \"name\": \"paymentFileBankAcknowledgementError\",          \"description\": \"Retrieve backend-safe bank-provided BEP error code and message for payments in a specific payment file.\",          \"when\": \"User asks for the bank-provided acknowledgement error, error code, or error message for a payment file and does not require invoice/installment columns.\",          \"fieldsToReturn\": [            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"paymentStatus.meaning\",            \"bepErrorCode\",            \"bepErrorMessageText\",            \"payablesPaymentFile.paymentInstructionId\",            \"disbursementInboundFile.fileName\",            \"disbursementInboundFile.inboundFileProcessingStatus.meaning\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentFile.paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\",            \"bepErrorCode!=null or bepErrorMessageText!=null\"          ],          \"notes\": \"Use this driver before paymentRunInstallments BV for payment-file bank-error questions because BEP fields are top-level on disbursementPayments. If the user asks for invoice or installment columns, use paymentRunInstallmentsExtraction instead.\"        },        {          \"name\": \"paymentFileContainedPayments\",          \"description\": \"List payment rows contained in a specific payment file using the payment-level disbursement view.\",          \"when\": \"User asks which payments are in a payment file or wants payment reference, payee, amount, method, status, and disbursement bank account for payments under one file.\",          \"fieldsToReturn\": [            \"payablesPaymentFile.paymentInstructionId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"payeeName\",            \"payeePartyName\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"paymentStatus.meaning\",            \"paymentMethod.paymentMethodName\",            \"disbursementBankAccount.name\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentFile.paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\"          ],          \"notes\": \"Use this driver instead of the `payablesDisbursementPayments` child accessor on disbursementPaymentInstructions. If invoice-level detail is requested, use paymentRunInstallmentsExtraction.\"        }      ],      \"additionalInstructions\": [        \"Use the canonical resource `payablesDisbursementPayments`, but request the richer `disbursementPayments` named view when the question needs service-level, delivery-channel, bank-branch, payment-format, virtual-card, payment-file, AP-payment, or PPR accessor details.\",        \"Use nested accessor paths exactly as defined in `fields.accessors`; do not invent flattened aliases such as `ApChecksAll` or unsupported shortcut fields.\",        \"For supplier-focused bank-account questions, filter with `payeePartyName` or `payablesPayment.supplierName` plus `paymentDate`, and return the surrounding logistics context from `disbursementBankAccount`, `disbursementBankAccount.bank`, and `disbursementBankAccount.bankBranch`.\",        \"For payment file format questions, read from `accountPaymentProfile.systemPaymentProfile.paymentFormat` and related processing/profile accessors rather than inferring from payment method alone.\",        \"For service-level and delivery-channel questions, return `serviceLevelCode` and `deliveryChannelCode` together with related payment-format or processing metadata when available; do not invent banking-standard descriptions not returned by the API.\",        \"For virtual card questions, combine `paymentMode.lookupCode='VIRTUAL_CARD'` with `paymentInstrument.paymentInstrumentAlias` and, when relevant, `digitalPaymentAccount.virtualCardProgram.vcardProgramName`.\",        \"For expense-report or refund-status questions, locate the payment id through paymentRunInstallments first, then use this shape to return payment status, payment file, reconciliation, and PPR context.\",        \"When the user also needs invoice or installment detail, use this shape to identify matching payment ids and then hand off to the corresponding document-level shape instead of overloading this BV with unsupported document attributes.\",        \"For payment-monitoring requests, return payment, supplier, disbursement bank account, payment method, and process status fields together so downstream exception handling or bank follow-up can be done without another fetch.\",        \"For Payments-flow operational review and payment-number follow-up, prefer this BV over `payablesPaymentDetails` because it preserves disbursement bank account, payment file, PPR, and AP payment context together.\",        \"For stop-initiated, failed, or rejected-payment review, surface both payment-level status and PPR/process status when available so the user can distinguish payment state from process state.\",        \"For missing legal entity in a payment file, filter `payablesPaymentFile.paymentInstructionId=<PAYMENT_FILE_ID>` and `legalEntity.legalEntityId=null`; Taxpayer ID is not in current scope.\",        \"For JPM acknowledgement-linked voided payments, require `disbursementInboundFile.id is not null`, AP checks-backed `payablesPayment.paymentStatus.lookupCode='VOIDED'`, `voidDate is not null`, and `disbursementInboundFile.paymentSystem.paymentSystemName like '%JPM%'`; apply requested date windows to `voidDate` and do not infer unsupported L-level acknowledgement classifications.\",        \"If the request requires combining disbursement payments with supplier defaults, instruction metadata, or separate exception/error sources, do not force a single-BV answer; use an extraction shape instead.\",        \"When user asks for Bank acount/Bank branch/Country details sort by paymentDate:desc. Do not use bepErrorCode to sort in all cases\",        \"Bank branch/country questions for a specific payment id or for installments under a PPR are supported by disbursementPayments; do not classify them as unsupported.\",        \"For numeric phrasing like 'payment 2575', treat the number as paymentId unless the user explicitly says payment reference number.\",        \"For service-level and delivery-channel questions by payment reference, filter with paymentReferenceNumber = '<value>', sort by paymentReferenceNumber:asc before limit 20, and do not use paymentDate sorting. Explicit payment reference wording takes precedence over the generic numeric-payment rule.\",        \"Service-level and delivery-channel by payment reference is supported by this BV. Return serviceLevelCode and deliveryChannelCode, filter paymentReferenceNumber, sort paymentReferenceNumber ascending, and do not answer with an unsupported template.\",        \"For external bank account for all payees selected in a PPR, use fields externalBankAccount.bankAccountName,payeePartyName, filter paymentsPayablesPaymentProcessRequest.paymentProcessRequestName, sort paymentDate:asc, and limit 20. Do not add paymentProcessRequestId or use paymentDate:desc unless explicitly requested.\",        \"Do not use disbursementPayments for the generic request 'Review proposed payments for all PPRs'. That request requires paymentRunInstallmentSummaries AV plus paymentRunInstallments BV with no PENDING_REVIEW filter. Use disbursementPayments only when the user explicitly asks for disbursement-payment logistics or pending-review-only payments.\"      ],      \"fieldSelectionRuleUsage\": {        \"match\": \"Choose the closest questionExamples entry for the user request.\",        \"fields\": \"Use the matching fields value exactly and preserve order.\",        \"paraphrases\": \"Use the same fields for paraphrased or equivalent requests.\",        \"addFieldsOnlyWhen\": \"The user explicitly asks for more displayed columns, or the field is required for filter, sort, group, key, or deeplink handling.\",        \"filters\": \"If the matching rule provides filters, apply them and replace placeholders with user-provided values.\",        \"sortAndLimit\": \"If the matching rule provides sortBy or limit, apply them unless the user explicitly asks for a different sort or limit.\"      },      \"fieldSelectionRules\": [        {          \"questionExamples\": [            \"List the 'External Bank Account' for all payees selected in PPR PPR05\"          ],          \"queryType\": \"BV\",          \"fields\": \"externalBankAccount.bankAccountName,payeePartyName\",          \"fieldOrderLocked\": true,          \"shape\": \"disbursementPayments\",          \"filters\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName = '<PPR_NAME_FROM_USER>'\",          \"sortBy\": \"paymentDate:asc\",          \"limit\": 20,          \"notes\": \"For external bank account for all payees selected in a PPR, return only externalBankAccount.bankAccountName and payeePartyName unless the user asks for more fields. Sort paymentDate ascending and do not switch to paymentDate descending unless the user asks for latest/recent payments.\"        },        {          \"questionExamples\": [            \"Show are service level codes and delivery channels for payment reference 2562\",            \"Show service level codes and delivery channels for payment reference <PAYMENT_REFERENCE_NUMBER>\"          ],          \"queryType\": \"BV\",          \"fields\": \"serviceLevelCode,deliveryChannelCode\",          \"fieldOrderLocked\": true,          \"shape\": \"disbursementPayments\",          \"filters\": \"paymentReferenceNumber = '<PAYMENT_REFERENCE_NUMBER_FROM_USER>'\",          \"sortBy\": \"paymentReferenceNumber:asc\",          \"limit\": 20,          \"notes\": \"This lookup is supported. serviceLevelCode and deliveryChannelCode are output fields, not filters. If the user says payment reference or payment reference number, filter by paymentReferenceNumber, not paymentId. Sort by paymentReferenceNumber:asc before limit 20 and do not use paymentDate sorting.\"        },        {          \"questionExamples\": [            \"Show me payments where the supplier's bank account was recently changed\"          ],          \"queryType\": \"BV\",          \"fields\": \"paymentId,paymentReferenceNumber,paymentDate,payeePartyName,payablesPayment.supplierName,paymentAmount,paymentCurrencyCode,paymentBusinessUnit,externalBankAccount.bankAccountName,externalBankAccount.maskedIban,externalBankAccount.maskedAccountNumber,externalBankAccount.eftSwiftCode,externalBankAccount.countryCode,externalBankAccount.timeCreated,externalBankAccount.timeUpdated,paymentStatus.meaning,payablesPaymentFile.paymentInstructionId,paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",          \"fieldOrderLocked\": true,          \"shape\": \"disbursementPayments\",          \"filters\": \"externalBankAccount.timeUpdated >= '<CURRENT_DATE_MINUS_30_DAYS_T00:00:00Z>'\",          \"sortBy\": \"paymentDate:desc\",          \"limit\": 20,          \"notes\": \"Recently changed supplier bank account means externalBankAccount.timeUpdated in the last 30 days, formatted as UTC midnight, sorted by paymentDate desc.\"        },        {          \"questionExamples\": [            \"Show me the bank branch and country for Installments under PPR gapr_ppr_test_4\"          ],          \"queryType\": \"BV\",          \"fields\": \"disbursementBankAccount.bankBranch.name,disbursementBankAccount.bank.countryCode\",          \"fieldOrderLocked\": true,          \"shape\": \"disbursementPayments\",          \"filters\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName = '<PPR_NAME_FROM_USER>'\",          \"sortBy\": \"paymentDate:desc\",          \"limit\": 20,          \"notes\": \"For bank branch and country for installments under a PPR, sort paymentDate desc before applying limit 20 so latest payments are returned.\"        },        {          \"questionExamples\": [            \"What was the bank branch and bank for the payment with paymentNumber 2345\"          ],          \"queryType\": \"BV\",          \"fields\": \"disbursementBankAccount.bank.name,disbursementBankAccount.bankBranch.name\",          \"fieldOrderLocked\": true        }      ]    },    \"disbursementPaymentsExtraction\": {      \"key\": \"disbursementPaymentsExtraction\",      \"name\": \"disbursementPaymentsExtraction\",      \"type\": \"EXTRACTION\",      \"module\": \"oraErpCorePaymentsFundsDisbursement\",      \"businessObject\": \"PayablesDisbursementPayment\",      \"description\": \"Runtime extraction wrapper for the disbursementPayments BV. Business view for disbursement payment retrieval in Funds Disbursement. Use this shape primarily for summary queries about payment activity, such as counts and amounts by payment status, payment file, PPR, payment mode, bank account, service level, or virtual-card program, before drilling into individual payments.\",      \"exampleQuestions\": [        \"What bank account was used to pay Supplier X on 2026-01-15?\",        \"What payment file format was used for payment 14876?\",        \"What was the bank branch and bank for payment 14876?\",        \"What service level and delivery channel were used for payment 14876?\",        \"How many virtual card payments using alias RCN-7781 were there within the last two days by payment status?\",        \"How many virtual card payments were there for program MC HSBC using aliases that contain MC Citibank by payment status?\",        \"What is the total payment amount in payment file 12345 by payment status, with PPR details?\",        \"What is the payment status for expense report EXP-2025-001234 submitted by John Smith?\",        \"What is the status of the refund payment for credit memo CM-2025-001?\"      ],      \"fields\": {        \"fields\": [          \"bepErrorCode\",          \"bepErrorMessageText\",          \"paymentProfileSystemName\",          \"paymentProfileAccountName\",          \"paymentReferenceNumber\",          \"bankAssignedReferenceCode\",          \"uniqueRemittanceIdentifier\",          \"paymentReasonComments\",          \"timeCreated\",          \"updatedBy\",          \"timeUpdated\",          \"createdBy\",          \"paymentId\",          \"paymentAmount\",          \"paymentCurrencyCode\",          \"paymentDate\",          \"payeeName\",          \"payeePartyName\",          \"paymentBusinessUnit\",          \"paymentProcessRequestName\",          \"paymentCompleteFlag\",          \"bankStatusCode\",          \"paymentSystemResponseIdentifier\",          \"issuerAuthorizationReference\",          \"acquirerTransactionReference\",          \"issuerProcessingTimestamp\",          \"voidDate\",          \"voidReason\",          \"stopDate\",          \"stopRequestReason\",          \"paymentDeclarationAmount\",          \"bankChargeAmount\",          \"uriCheckDigit\",          \"maturityDate\",          \"remittanceMessageOne\",          \"remittanceMessageTwo\",          \"remittanceMessageThree\",          \"paymentTextMessageOne\",          \"paymentTextMessageTwo\",          \"paymentTextMessageThree\",          \"stopRequestPlacedFlag\",          \"anticipatedValueDate\",          \"declarationCurrencyCode\",          \"invoicePayeePartyName\",          \"invoiceDueDate\",          \"paperDocumentNumber\",          \"serviceLevelCode\",          \"deliveryChannelCode\",          \"stopRequestPlacedBy\",          \"paymentStatusLookupCode\",          \"paymentStatusMeaning\",          \"fundsStatusLookupCode\",          \"fundsStatusMeaning\",          \"paymentFunctionLookupCode\",          \"paymentFunctionMeaning\",          \"paymentModeLookupCode\",          \"paymentModeMeaning\",          \"paymentMethodCode\",          \"paymentMethodName\",          \"paymentInstrumentAlias\",          \"disbursementBankAccountName\",          \"bankName\",          \"countryCode\",          \"bankBranchName\",          \"branchNumber\",          \"bankAccountName\",          \"maskedAccountNumber\",          \"maskedIban\",          \"externalBankAccountCountryCode\",          \"vcardProgramName\",          \"paymentProfileId\",          \"paymentProfileName\",          \"processingTypeMeaning\",          \"processingTypeLookupCode\",          \"paymentFormatCode\",          \"formatName\",          \"formatTemplateCode\",          \"formatTypeName\",          \"paymentInstructionId\",          \"paymentRequestName\",          \"paymentFileProcessingStatusLookupCode\",          \"paymentFileProcessingStatusMeaning\",          \"acknowledgementFileName\",          \"acknowledgementFileCreatedOn\",          \"acknowledgementErrorMessage\",          \"acknowledgementPaymentSystemName\",          \"acknowledgementStatusLookupCode\",          \"acknowledgementStatusMeaning\",          \"paymentProcessRequestId\",          \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\",          \"paymentProcessRequestStatusLookupCode\",          \"paymentProcessRequestStatusMeaning\",          \"paymentInitiationMeaning\",          \"legalEntityId\",          \"legalEntityName\",          \"supplierSiteName\",          \"supplierId\",          \"supplierTypeLookupCode\",          \"supplierTypeMeaning\",          \"payablesPaymentPaymentId\",          \"paymentNumber\",          \"supplierName\",          \"remitToSupplierName\",          \"remitToAddressName\",          \"payablesPaymentPaymentDate\",          \"payablesPaymentPaymentAmount\",          \"paymentCurrencyCurrencyCode\",          \"payablesPaymentPaymentStatusLookupCode\",          \"payablesPaymentPaymentStatusMeaning\",          \"reconciledFlag\",          \"clearingDate\",          \"systemProfileCode\"        ],        \"fieldAlias\": {          \"BEP Error Code\": \"bepErrorCode\",          \"BEP Error Message\": \"bepErrorMessageText\",          \"Payment Profile System\": \"paymentProfileSystemName\",          \"Payment Profile Account\": \"paymentProfileAccountName\",          \"Payment ID\": \"paymentId\",          \"Bank Assigned Reference\": \"bankAssignedReferenceCode\",          \"Unique Remittance Identifier\": \"uniqueRemittanceIdentifier\",          \"Payment Reason Comments\": \"paymentReasonComments\",          \"Created On\": \"timeCreated\",          \"Created By\": \"createdBy\",          \"Last Updated On\": \"timeUpdated\",          \"Last Updated By\": \"updatedBy\",          \"Payment Reference Number\": \"paymentReferenceNumber\",          \"Payment Date\": \"paymentDate\",          \"Payment Amount\": \"paymentAmount\",          \"Payment Currency\": \"paymentCurrencyCode\",          \"Payee\": \"payeeName\",          \"Payee Party Name\": \"payeePartyName\",          \"Invoice Payee Party Name\": \"invoicePayeePartyName\",          \"Payment Business Unit\": \"paymentBusinessUnit\",          \"Payment Process Request\": \"paymentProcessRequestName\",          \"Invoice Due Date\": \"invoiceDueDate\",          \"Maturity Date\": \"maturityDate\",          \"Anticipated Value Date\": \"anticipatedValueDate\",          \"Payment Complete\": \"paymentCompleteFlag\",          \"Service Level Code\": \"serviceLevelCode\",          \"Delivery Channel Code\": \"deliveryChannelCode\",          \"Bank Status Code\": \"bankStatusCode\",          \"Payment System Response Identifier\": \"paymentSystemResponseIdentifier\",          \"Issuer Authorization Reference\": \"issuerAuthorizationReference\",          \"Acquirer Transaction Reference\": \"acquirerTransactionReference\",          \"Issuer Processing Timestamp\": \"issuerProcessingTimestamp\",          \"Void Date\": \"voidDate\",          \"Void Reason\": \"voidReason\",          \"Stop Date\": \"stopDate\",          \"Stop Request Reason\": \"stopRequestReason\",          \"Payment Declaration Amount\": \"paymentDeclarationAmount\",          \"Bank Charge Amount\": \"bankChargeAmount\",          \"URI Check Digit\": \"uriCheckDigit\",          \"Remittance Message 1\": \"remittanceMessageOne\",          \"Remittance Message 2\": \"remittanceMessageTwo\",          \"Remittance Message 3\": \"remittanceMessageThree\",          \"Payment Text Message 1\": \"paymentTextMessageOne\",          \"Payment Text Message 2\": \"paymentTextMessageTwo\",          \"Payment Text Message 3\": \"paymentTextMessageThree\",          \"Stop Request Placed\": \"stopRequestPlacedFlag\",          \"Declaration Currency\": \"declarationCurrencyCode\",          \"Paper Document Number\": \"paperDocumentNumber\",          \"Stop Request Placed By\": \"stopRequestPlacedBy\",          \"Payment Status Code\": \"paymentStatusLookupCode\",          \"Payment Status\": \"paymentStatusMeaning\",          \"Funds Status Code\": \"fundsStatusLookupCode\",          \"Funds Status\": \"fundsStatusMeaning\",          \"Payment Function Code\": \"paymentFunctionLookupCode\",          \"Payment Function\": \"paymentFunctionMeaning\",          \"Payment Mode Code\": \"paymentModeLookupCode\",          \"Payment Mode\": \"paymentModeMeaning\",          \"Payment Method Code\": \"paymentMethodCode\",          \"Payment Method\": \"paymentMethodName\",          \"Payment Instrument Alias\": \"paymentInstrumentAlias\",          \"Disbursement Bank Account\": \"disbursementBankAccountName\",          \"Disbursement Bank\": \"bankName\",          \"Disbursement Bank Country\": \"countryCode\",          \"Disbursement Bank Branch\": \"bankBranchName\",          \"Disbursement Bank Branch Number\": \"branchNumber\",          \"External Bank Account\": \"bankAccountName\",          \"External Bank Account Number\": \"maskedAccountNumber\",          \"External IBAN\": \"maskedIban\",          \"External Bank Country\": \"externalBankAccountCountryCode\",          \"Virtual Card Program\": \"vcardProgramName\",          \"Payment Profile ID\": \"paymentProfileId\",          \"Payment Profile Name\": \"paymentProfileName\",          \"Processing Type\": \"processingTypeMeaning\",          \"Processing Type Code\": \"processingTypeLookupCode\",          \"Payment Format Code\": \"paymentFormatCode\",          \"Payment Format Name\": \"formatName\",          \"Payment Format Template\": \"formatTemplateCode\",          \"Format Type\": \"formatTypeName\",          \"Payment File ID\": \"paymentInstructionId\",          \"Payment File Reference\": \"paymentInstructionId\",          \"Payment File Request Name\": \"paymentRequestName\",          \"Payment File Status Code\": \"paymentFileProcessingStatusLookupCode\",          \"Payment File Status\": \"paymentFileProcessingStatusMeaning\",          \"Acknowledgement File Name\": \"acknowledgementFileName\",          \"Acknowledgement File Created On\": \"acknowledgementFileCreatedOn\",          \"Acknowledgement Error Message\": \"acknowledgementErrorMessage\",          \"Acknowledgement Payment System\": \"acknowledgementPaymentSystemName\",          \"Acknowledgement Status Code\": \"acknowledgementStatusLookupCode\",          \"Acknowledgement Status\": \"acknowledgementStatusMeaning\",          \"PPR ID\": \"paymentProcessRequestId\",          \"PPR Name\": \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\",          \"PPR Status Code\": \"paymentProcessRequestStatusLookupCode\",          \"PPR Status\": \"paymentProcessRequestStatusMeaning\",          \"PPR Initiation\": \"paymentInitiationMeaning\",          \"Legal Entity ID\": \"legalEntityId\",          \"Legal Entity\": \"legalEntityName\",          \"Supplier Site\": \"supplierSiteName\",          \"Supplier ID\": \"supplierId\",          \"Supplier Type Code\": \"supplierTypeLookupCode\",          \"Supplier Type\": \"supplierTypeMeaning\",          \"AP Payment ID\": \"payablesPaymentPaymentId\",          \"AP Payment Number\": \"paymentNumber\",          \"AP Supplier Name\": \"supplierName\",          \"Remit-To Supplier\": \"remitToSupplierName\",          \"Remit-To Address\": \"remitToAddressName\",          \"AP Payment Date\": \"payablesPaymentPaymentDate\",          \"AP Payment Amount\": \"payablesPaymentPaymentAmount\",          \"AP Payment Currency\": \"paymentCurrencyCurrencyCode\",          \"AP Payment Status Code\": \"payablesPaymentPaymentStatusLookupCode\",          \"AP Payment Status\": \"payablesPaymentPaymentStatusMeaning\",          \"Reconciled\": \"reconciledFlag\",          \"Clearing Date\": \"clearingDate\"        }      },      \"supportedFilters\": [        {          \"name\": \"paymentId\",          \"attribute\": \"paymentId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides an internal disbursement payment identifier.\",          \"valueFromUser\": \"Payment ID\"        },        {          \"name\": \"paymentReferenceNumber\",          \"attribute\": \"paymentReferenceNumber\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides the payment reference number rather than the internal payment id.\",          \"valueFromUser\": \"Payment Reference Number\"        },        {          \"name\": \"paymentDate\",          \"attribute\": \"paymentDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use for payment-date filters and date windows.\",          \"valueFromUser\": \"Payment Date or date range\"        },        {          \"name\": \"payeePartyName\",          \"attribute\": \"payeePartyName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user names the payee or supplier in payment logistics questions.\",          \"valueFromUser\": \"Payee Party Name\"        },        {          \"name\": \"payablesPayment.supplierName\",          \"attribute\": \"payablesPayment.supplierName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the supplier name is available through the AP payment accessor.\",          \"valueFromUser\": \"AP Supplier Name\"        },        {          \"name\": \"paymentBusinessUnit\",          \"attribute\": \"paymentBusinessUnit\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes payments by business unit.\",          \"valueFromUser\": \"Payment Business Unit\"        },        {          \"name\": \"payablesPaymentFile.paymentInstructionId\",          \"attribute\": \"payablesPaymentFile.paymentInstructionId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a payment file identifier.\",          \"valueFromUser\": \"Payment File ID\"        },        {          \"name\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",          \"attribute\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a payment process request id.\",          \"valueFromUser\": \"PPR ID\"        },        {          \"name\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",          \"attribute\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a payment process request name.\",          \"valueFromUser\": \"PPR Name\"        },        {          \"name\": \"paymentStatus.lookupCode\",          \"attribute\": \"paymentStatus.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides or requests a specific payment status code.\",          \"valueFromUser\": \"Payment Status Code\"        },        {          \"name\": \"paymentStatus.meaning\",          \"attribute\": \"paymentStatus.meaning\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user gives the display meaning of the payment status.\",          \"valueFromUser\": \"Payment Status\"        },        {          \"name\": \"payablesPayment.paymentStatus.lookupCode\",          \"attribute\": \"payablesPayment.paymentStatus.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use AP checks-backed status `VOIDED` when the user asks for voided payments, including JPM acknowledgement-linked voided-payment inquiries. Do not use disbursement-side paymentStatus.lookupCode='VOID' for voided-payment status.\",          \"valueFromUser\": \"AP Payment Status Code\"        },        {          \"name\": \"paymentMethod.code\",          \"attribute\": \"paymentMethod.code\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment method code.\",          \"valueFromUser\": \"Payment Method Code\"        },        {          \"name\": \"paymentMethod.paymentMethodName\",          \"attribute\": \"paymentMethod.paymentMethodName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment method name.\",          \"valueFromUser\": \"Payment Method\"        },        {          \"name\": \"paymentMode.lookupCode\",          \"attribute\": \"paymentMode.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [            \"VIRTUAL_CARD\"          ],          \"usage\": \"Use when the user asks about virtual card payments or other specific payment modes.\",          \"valueFromUser\": \"Payment Mode Code\"        },        {          \"name\": \"paymentInstrument.paymentInstrumentAlias\",          \"attribute\": \"paymentInstrument.paymentInstrumentAlias\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides an RCN or payment instrument alias.\",          \"valueFromUser\": \"Payment Instrument Alias\"        },        {          \"name\": \"digitalPaymentAccount.virtualCardProgram.vcardProgramName\",          \"attribute\": \"digitalPaymentAccount.virtualCardProgram.vcardProgramName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by virtual card program name.\",          \"valueFromUser\": \"Virtual Card Program\"        },        {          \"name\": \"serviceLevelCode\",          \"attribute\": \"serviceLevelCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about payment service levels.\",          \"valueFromUser\": \"Service Level Code\"        },        {          \"name\": \"deliveryChannelCode\",          \"attribute\": \"deliveryChannelCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about payment delivery channels.\",          \"valueFromUser\": \"Delivery Channel Code\"        },        {          \"name\": \"disbursementBankAccount.name\",          \"attribute\": \"disbursementBankAccount.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks which disbursement bank account was used.\",          \"valueFromUser\": \"Disbursement Bank Account\"        },        {          \"name\": \"disbursementBankAccount.bank.name\",          \"attribute\": \"disbursementBankAccount.bank.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by disbursement bank name.\",          \"valueFromUser\": \"Disbursement Bank\"        },        {          \"name\": \"disbursementBankAccount.bankBranch.name\",          \"attribute\": \"disbursementBankAccount.bankBranch.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by disbursement bank branch name.\",          \"valueFromUser\": \"Disbursement Bank Branch\"        },        {          \"name\": \"externalBankAccount.countryCode\",          \"attribute\": \"externalBankAccount.countryCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for payee bank-country context.\",          \"valueFromUser\": \"External Bank Country\"        },        {          \"name\": \"invoiceDueDate\",          \"attribute\": \"invoiceDueDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about invoice due dates tied to the payment.\",          \"valueFromUser\": \"Invoice Due Date or date range\"        },        {          \"name\": \"legalEntity.legalEntityId\",          \"attribute\": \"legalEntity.legalEntityId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use legalEntity.legalEntityId is null when the user asks for payments in a payment file where legal entity is missing.\",          \"valueFromUser\": \"Legal Entity ID\"        },        {          \"name\": \"disbursementInboundFile.id\",          \"attribute\": \"disbursementInboundFile.id\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use is not null when the user asks for payments linked to an inbound acknowledgement file.\",          \"valueFromUser\": \"Acknowledgement File Id\"        },        {          \"name\": \"disbursementInboundFile.paymentSystem.paymentSystemName\",          \"attribute\": \"disbursementInboundFile.paymentSystem.paymentSystemName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for acknowledgement-linked payments by payment system or bank such as JPM.\",          \"valueFromUser\": \"Acknowledgement Payment System\"        },        {          \"name\": \"payablesPayment.reconciledFlag\",          \"attribute\": \"payablesPayment.reconciledFlag\",          \"type\": \"boolean\",          \"possibleValues\": [            true,            false          ],          \"usage\": \"Use when the user asks whether matched payments are cleared or reconciled.\",          \"valueFromUser\": \"Reconciled\"        }      ],      \"dateFilterGuidance\": null,      \"extractionQuery\": {        \"viewQueries\": {          \"disbursementPayments\": {            \"module\": \"oraErpCorePaymentsFundsDisbursement\",            \"businessObject\": \"PayablesDisbursementPayment\",            \"view\": \"disbursementPayments\",            \"fieldAliases\": {              \"bepErrorCode\": \"bepErrorCode\",              \"bepErrorMessageText\": \"bepErrorMessageText\",              \"paymentProfileSystemName\": \"paymentProfileSystemName\",              \"paymentProfileAccountName\": \"paymentProfileAccountName\",              \"paymentReferenceNumber\": \"paymentReferenceNumber\",              \"bankAssignedReferenceCode\": \"bankAssignedReferenceCode\",              \"uniqueRemittanceIdentifier\": \"uniqueRemittanceIdentifier\",              \"paymentReasonComments\": \"paymentReasonComments\",              \"timeCreated\": \"timeCreated\",              \"updatedBy\": \"updatedBy\",              \"timeUpdated\": \"timeUpdated\",              \"createdBy\": \"createdBy\",              \"paymentId\": \"paymentId\",              \"paymentAmount\": \"paymentAmount\",              \"paymentCurrencyCode\": \"paymentCurrencyCode\",              \"paymentDate\": \"paymentDate\",              \"payeeName\": \"payeeName\",              \"payeePartyName\": \"payeePartyName\",              \"paymentBusinessUnit\": \"paymentBusinessUnit\",              \"paymentProcessRequestName\": \"paymentProcessRequestName\",              \"paymentCompleteFlag\": \"paymentCompleteFlag\",              \"bankStatusCode\": \"bankStatusCode\",              \"paymentSystemResponseIdentifier\": \"paymentSystemResponseIdentifier\",              \"issuerAuthorizationReference\": \"issuerAuthorizationReference\",              \"acquirerTransactionReference\": \"acquirerTransactionReference\",              \"issuerProcessingTimestamp\": \"issuerProcessingTimestamp\",              \"voidDate\": \"voidDate\",              \"voidReason\": \"voidReason\",              \"stopDate\": \"stopDate\",              \"stopRequestReason\": \"stopRequestReason\",              \"paymentDeclarationAmount\": \"paymentDeclarationAmount\",              \"bankChargeAmount\": \"bankChargeAmount\",              \"uriCheckDigit\": \"uriCheckDigit\",              \"maturityDate\": \"maturityDate\",              \"remittanceMessageOne\": \"remittanceMessageOne\",              \"remittanceMessageTwo\": \"remittanceMessageTwo\",              \"remittanceMessageThree\": \"remittanceMessageThree\",              \"paymentTextMessageOne\": \"paymentTextMessageOne\",              \"paymentTextMessageTwo\": \"paymentTextMessageTwo\",              \"paymentTextMessageThree\": \"paymentTextMessageThree\",              \"stopRequestPlacedFlag\": \"stopRequestPlacedFlag\",              \"anticipatedValueDate\": \"anticipatedValueDate\",              \"declarationCurrencyCode\": \"declarationCurrencyCode\",              \"invoicePayeePartyName\": \"invoicePayeePartyName\",              \"invoiceDueDate\": \"invoiceDueDate\",              \"paperDocumentNumber\": \"paperDocumentNumber\",              \"serviceLevelCode\": \"serviceLevelCode\",              \"deliveryChannelCode\": \"deliveryChannelCode\",              \"stopRequestPlacedBy\": \"stopRequestPlacedBy\",              \"paymentStatus.lookupCode\": \"paymentStatusLookupCode\",              \"paymentStatus.meaning\": \"paymentStatusMeaning\",              \"fundsStatus.lookupCode\": \"fundsStatusLookupCode\",              \"fundsStatus.meaning\": \"fundsStatusMeaning\",              \"paymentFunction.lookupCode\": \"paymentFunctionLookupCode\",              \"paymentFunction.meaning\": \"paymentFunctionMeaning\",              \"paymentMode.lookupCode\": \"paymentModeLookupCode\",              \"paymentMode.meaning\": \"paymentModeMeaning\",              \"paymentMethod.code\": \"paymentMethodCode\",              \"paymentMethod.paymentMethodName\": \"paymentMethodName\",              \"paymentInstrument.paymentInstrumentAlias\": \"paymentInstrumentAlias\",              \"disbursementBankAccount.name\": \"disbursementBankAccountName\",              \"disbursementBankAccount.bank.name\": \"bankName\",              \"disbursementBankAccount.bank.countryCode\": \"countryCode\",              \"disbursementBankAccount.bankBranch.name\": \"bankBranchName\",              \"disbursementBankAccount.bankBranch.branchNumber\": \"branchNumber\",              \"externalBankAccount.bankAccountName\": \"bankAccountName\",              \"externalBankAccount.maskedAccountNumber\": \"maskedAccountNumber\",              \"externalBankAccount.maskedIban\": \"maskedIban\",              \"externalBankAccount.countryCode\": \"externalBankAccountCountryCode\",              \"digitalPaymentAccount.virtualCardProgram.vcardProgramName\": \"vcardProgramName\",              \"accountPaymentProfile.paymentProfileId\": \"paymentProfileId\",              \"accountPaymentProfile.paymentProfileName\": \"paymentProfileName\",              \"accountPaymentProfile.systemPaymentProfile.processingType.meaning\": \"processingTypeMeaning\",              \"accountPaymentProfile.systemPaymentProfile.processingType.lookupCode\": \"processingTypeLookupCode\",              \"accountPaymentProfile.systemPaymentProfile.paymentFormat.paymentFormatCode\": \"paymentFormatCode\",              \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatName\": \"formatName\",              \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatTemplateCode\": \"formatTemplateCode\",              \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatType.formatTypeName\": \"formatTypeName\",              \"payablesPaymentFile.paymentInstructionId\": \"paymentInstructionId\",              \"payablesPaymentFile.paymentRequestName\": \"paymentRequestName\",              \"payablesPaymentFile.paymentFileProcessingStatus.lookupCode\": \"paymentFileProcessingStatusLookupCode\",              \"payablesPaymentFile.paymentFileProcessingStatus.meaning\": \"paymentFileProcessingStatusMeaning\",              \"disbursementInboundFile.fileName\": \"acknowledgementFileName\",              \"disbursementInboundFile.timeCreated\": \"acknowledgementFileCreatedOn\",              \"disbursementInboundFile.errorMessage\": \"acknowledgementErrorMessage\",              \"disbursementInboundFile.paymentSystem.paymentSystemName\": \"acknowledgementPaymentSystemName\",              \"disbursementInboundFile.inboundFileProcessingStatus.lookupCode\": \"acknowledgementStatusLookupCode\",              \"disbursementInboundFile.inboundFileProcessingStatus.meaning\": \"acknowledgementStatusMeaning\",              \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\": \"paymentProcessRequestId\",              \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\": \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\",              \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\": \"paymentProcessRequestStatusLookupCode\",              \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\": \"paymentProcessRequestStatusMeaning\",              \"paymentsPayablesPaymentProcessRequest.paymentInitiation.meaning\": \"paymentInitiationMeaning\",              \"legalEntity.legalEntityId\": \"legalEntityId\",              \"legalEntity.name\": \"legalEntityName\",              \"supplierSite.name\": \"supplierSiteName\",              \"supplierSite.supplier.supplierId\": \"supplierId\",              \"supplierSite.supplier.supplierType.lookupCode\": \"supplierTypeLookupCode\",              \"supplierSite.supplier.supplierType.meaning\": \"supplierTypeMeaning\",              \"payablesPayment.paymentId\": \"payablesPaymentPaymentId\",              \"payablesPayment.paymentNumber\": \"paymentNumber\",              \"payablesPayment.supplierName\": \"supplierName\",              \"payablesPayment.remitToSupplierName\": \"remitToSupplierName\",              \"payablesPayment.remitToAddressName\": \"remitToAddressName\",              \"payablesPayment.paymentDate\": \"payablesPaymentPaymentDate\",              \"payablesPayment.paymentAmount\": \"payablesPaymentPaymentAmount\",              \"payablesPayment.paymentCurrency.currencyCode\": \"paymentCurrencyCurrencyCode\",              \"payablesPayment.paymentStatus.lookupCode\": \"payablesPaymentPaymentStatusLookupCode\",              \"payablesPayment.paymentStatus.meaning\": \"payablesPaymentPaymentStatusMeaning\",              \"payablesPayment.reconciledFlag\": \"reconciledFlag\",              \"payablesPayment.clearingDate\": \"clearingDate\",              \"accountPaymentProfile.systemPaymentProfile.systemProfileCode\": \"systemProfileCode\"            }          }        },        \"select\": \"{select_statement}\"      },      \"businessDrivers\": [        {          \"name\": \"paymentByIdOrReference\",          \"description\": \"Retrieve a specific disbursement payment by internal payment id or payment reference number.\",          \"when\": \"User asks for one payment, one payment reference, or one payment's processing details.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"paymentStatusMeaning\",            \"paymentMethodName\",            \"paymentInstructionId\",            \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"paymentId=<PAYMENT_ID_FROM_USER> or paymentReferenceNumber='<PAYMENT_REFERENCE_NUMBER_FROM_USER>'\"          ],          \"notes\": \"Prefer `paymentId` when the user clearly gives the internal payment id.\"        },        {          \"name\": \"supplierPaymentLogisticsByDate\",          \"description\": \"Retrieve bank-account and payment-logistics details for a supplier or payee on a payment date.\",          \"when\": \"User asks which bank account was used to pay a supplier on a given payment date or asks for surrounding logistics.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"payeePartyName\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"disbursementBankAccountName\",            \"bankName\",            \"countryCode\",            \"bankBranchName\",            \"branchNumber\"          ],          \"extraFilterExpressions\": [            \"(payeePartyName='<SUPPLIER_NAME_FROM_USER>' or payablesPayment.supplierName='<SUPPLIER_NAME_FROM_USER>')\",            \"paymentDate=<PAYMENT_DATE_FROM_USER>\"          ],          \"notes\": \"Return bank account, bank, branch, and currency together so the answer includes the full logistics context.\"        },        {          \"name\": \"paymentFormatByPayment\",          \"description\": \"Retrieve the payment file format and related processing metadata for a specific payment.\",          \"when\": \"User asks what payment file format was used for a payment or asks for processing-option metadata.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentProfileName\",            \"systemProfileCode\",            \"processingTypeMeaning\",            \"paymentFormatCode\",            \"formatName\",            \"formatTemplateCode\",            \"formatTypeName\"          ],          \"extraFilterExpressions\": [            \"paymentId=<PAYMENT_ID_FROM_USER>\"          ],          \"notes\": \"Use the payment-format accessor chain instead of trying to infer the format from payment method alone.\"        },        {          \"name\": \"bankRoutingByPayment\",          \"description\": \"Retrieve disbursement bank routing details for a specific payment.\",          \"when\": \"User asks for the bank, bank branch, or bank-country details for a payment.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"disbursementBankAccountName\",            \"bankName\",            \"countryCode\",            \"bankBranchName\",            \"branchNumber\",            \"paymentCurrencyCode\"          ],          \"extraFilterExpressions\": [            \"paymentId=<PAYMENT_ID_FROM_USER>\"          ],          \"notes\": \"\"        },        {          \"name\": \"serviceLevelAndDeliveryChannelByPayment\",          \"description\": \"Retrieve service-level and delivery-channel attributes for a payment reference or payment id, with related payment-format context when requested.\",          \"when\": \"User asks for service level codes, delivery channels, or how a payment was configured for delivery.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"serviceLevelCode\",            \"deliveryChannelCode\",            \"paymentMethodName\",            \"paymentModeMeaning\",            \"paymentFormatCode\",            \"formatName\"          ],          \"extraFilterExpressions\": [            \"If the user says payment reference or payment reference number, use paymentReferenceNumber='<PAYMENT_REFERENCE_NUMBER_FROM_USER>'\",            \"If the user says payment id or plain payment <number> without reference wording, use paymentId=<PAYMENT_ID_FROM_USER>\",            \"sortBy=paymentReferenceNumber:asc\",            \"limit=20\"          ],          \"notes\": \"The source exposes system codes directly; pair them with related format metadata only when requested. Explicit payment reference wording must use paymentReferenceNumber, not paymentId. Sort by paymentReferenceNumber:asc before limit 20; do not use paymentDate sorting for this lookup.\"        },        {          \"name\": \"paymentsByPprOrFile\",          \"description\": \"Retrieve disbursement payments for a payment file or PPR, including file and PPR status details.\",          \"when\": \"User asks for payments within a payment file or payment process request and wants payment-processing context.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"payeePartyName\",            \"paymentAmount\",            \"paymentStatusMeaning\",            \"paymentInstructionId\",            \"paymentFileProcessingStatusMeaning\",            \"paymentProcessRequestId\",            \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\",            \"paymentProcessRequestStatusMeaning\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentFile.paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId=<PPR_ID_FROM_USER> or paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Use the filter expression that matches the identifier the user actually provides.\"        },        {          \"name\": \"virtualCardPaymentsByAliasAndDate\",          \"description\": \"Retrieve virtual card payments by RCN alias in a date window.\",          \"when\": \"User asks how many payments were paid or are in process using a specific virtual card alias or RCN.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentStatusMeaning\",            \"reconciledFlag\",            \"paymentModeLookupCode\",            \"paymentInstrumentAlias\",            \"paymentInstructionId\",            \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\",            \"paymentProcessRequestStatusMeaning\"          ],          \"extraFilterExpressions\": [            \"paymentMode.lookupCode='VIRTUAL_CARD'\",            \"paymentInstrument.paymentInstrumentAlias='<RCN_ALIAS_FROM_USER>'\",            \"paymentDate>=<START_DATE>\",            \"paymentDate<=<END_DATE>\"          ],          \"notes\": \"Use this payment slice together with document-level shapes when the user also wants invoice or installment detail.\"        },        {          \"name\": \"virtualCardProgramReconciliation\",          \"description\": \"Retrieve virtual card payments where the virtual card program and payment instrument alias indicate a program mismatch or cross-program usage check.\",          \"when\": \"User asks for virtual card payments where the program name and instrument alias indicate a cross-program or mismatch scenario.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentStatusMeaning\",            \"vcardProgramName\",            \"paymentInstrumentAlias\",            \"paymentInstructionId\",            \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"paymentMode.lookupCode='VIRTUAL_CARD'\",            \"digitalPaymentAccount.virtualCardProgram.vcardProgramName='<VCARD_PROGRAM_NAME_FROM_USER>'\",            \"paymentInstrument.paymentInstrumentAlias like '%<RCN_ALIAS_FRAGMENT_FROM_USER>%'\"          ],          \"notes\": \"Use a contains-style filter on the payment instrument alias when the user gives a program fragment rather than the full alias.\"        },        {          \"name\": \"crossShapePaymentStatusFollowUp\",          \"description\": \"Retrieve detailed payment status, payment-file, and PPR context once a payment id has been identified from another shape.\",          \"when\": \"User starts from an expense report, refund reference, invoice, or document and then wants the payment status and payment logistics for the matched payment.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentStatusMeaning\",            \"paymentMethodName\",            \"reconciledFlag\",            \"paymentInstructionId\",            \"paymentFileProcessingStatusMeaning\",            \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\",            \"paymentProcessRequestStatusMeaning\"          ],          \"extraFilterExpressions\": [            \"paymentId=<PAYMENT_ID_FROM_UPSTREAM_SHAPE>\"          ],          \"notes\": \"Use paymentRunInstallments first when the user identifies the payment through an expense report number, refund reference, or invoice reference instead of a payment identifier.\"        },        {          \"name\": \"pprPendingReviewPaymentReview\",          \"description\": \"Retrieve proposed disbursement payments for PPRs that are in pending review status, with optional filtering by PPR ID or PPR Name.\",          \"when\": \"User asks to review proposed payments for PPRs, pending review PPRs, or wants payment details tied to a PPR awaiting review.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"paymentStatus.meaning\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\",            \"payablesPaymentFile.paymentInstructionId\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode='PENDING_REVIEW'\",            \"(paymentsPayablesPaymentProcessRequest.paymentProcessRequestId=<PPR_ID_FROM_USER> or paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>')\"          ],          \"notes\": \"Use this driver when the user wants proposed payments under PPR review. Apply the PENDING_REVIEW condition first, then narrow by PPR ID or PPR Name only when provided. If they want it for all PPR, then remove the PPR specific filter.\"        },        {          \"name\": \"recentExternalBankAccountChangeRiskReview\",          \"description\": \"Retrieve payments whose supplier external bank account was recently updated, sorted by most recently updated first, for fraud-risk review.\",          \"when\": \"User asks for payments where the supplier's bank account was recently changed, with no supplier filter, and wants the most recently updated records first.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"payeePartyName\",            \"payablesPayment.supplierName\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"paymentBusinessUnit\",            \"externalBankAccount.bankAccountName\",            \"externalBankAccount.maskedIban\",            \"externalBankAccount.maskedAccountNumber\",            \"externalBankAccount.eftSwiftCode\",            \"externalBankAccount.countryCode\",            \"externalBankAccount.timeCreated\",            \"externalBankAccount.timeUpdated\",            \"paymentStatus.meaning\",            \"payablesPaymentFile.paymentInstructionId\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"externalBankAccount.timeUpdated>=<TODAY_MINUS_30_DAYS>\"          ],          \"notes\": \"Do not require a supplier filter. Sort by externalBankAccount.timeUpdated descending so the most recently changed bank accounts appear first. Use this as a fraud-risk review slice for recent external bank account changes. Mandatory filter - externalBankAccount.timeUpdate\"        },        {          \"name\": \"pprPendingReviewPaymentReviewAll\",          \"description\": \"Retrieve proposed disbursement payments for all PPRs that are in pending review status.\",          \"when\": \"User asks to review proposed payments for all PPRs, pending review PPRs, or wants payment details tied to PPRs awaiting review without naming a specific PPR.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"paymentStatus.meaning\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\",            \"payablesPaymentFile.paymentInstructionId\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode='PENDING_REVIEW'\"          ],          \"notes\": \"Use this driver when the user wants proposed payments across all PPRs. Do not add a PPR ID or PPR Name filter unless the user explicitly supplies one.\"        },        {          \"name\": \"paymentsInPaymentFileMissingLegalEntity\",          \"description\": \"Retrieve payments in a payment file where legal entity is missing.\",          \"when\": \"User asks for payment-file payments with missing legal entity or asks why payments in a file are missing legal entity details.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"legalEntityId\",            \"legalEntityName\",            \"paymentInstructionId\",            \"paymentFileProcessingStatusMeaning\",            \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentFile.paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\",            \"legalEntity.legalEntityId is null\"          ],          \"notes\": \"Taxpayer ID is not currently in scope for this inquiry.\"        },        {          \"name\": \"voidedJpmAcknowledgementLinkedPayments\",          \"description\": \"Retrieve voided payments linked to JPM acknowledgement files.\",          \"when\": \"User asks for voided JPM acknowledgement-linked payments or payments rejected through JPM acknowledgement context.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentMethodName\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"bankName\",            \"voidDate\",            \"voidReason\",            \"payablesPaymentPaymentStatusLookupCode\",            \"payablesPaymentPaymentStatusMeaning\",            \"paymentInstructionId\",            \"acknowledgementFileName\",            \"acknowledgementPaymentSystemName\",            \"acknowledgementStatusMeaning\"          ],          \"extraFilterExpressions\": [            \"disbursementInboundFile.id is not null\",            \"payablesPayment.paymentStatus.lookupCode='VOIDED'\",            \"voidDate is not null\",            \"disbursementInboundFile.paymentSystem.paymentSystemName like '%JPM%'\"          ],          \"notes\": \"Use explicit inbound-file linkage and payment system name. For voided-payment status, use the AP checks-backed `payablesPayment.paymentStatus.lookupCode='VOIDED'`; do not use disbursement-side `paymentStatus.lookupCode='VOID'` for this use case. Apply user-provided date windows to `voidDate`. Do not infer L1/L2/L3 file classification from file names.\"        },        {          \"name\": \"paymentFileBankAcknowledgementError\",          \"description\": \"Retrieve backend-safe bank-provided BEP error code and message for payments in a specific payment file.\",          \"when\": \"User asks for the bank-provided acknowledgement error, error code, or error message for a payment file and does not require invoice/installment columns.\",          \"fieldsToReturn\": [            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"paymentStatusMeaning\",            \"bepErrorCode\",            \"bepErrorMessageText\",            \"paymentInstructionId\",            \"acknowledgementFileName\",            \"acknowledgementStatusMeaning\"          ],          \"extraFilterExpressions\": [            \"paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\",            \"bepErrorCode is not null or bepErrorMessageText is not null\"          ],          \"notes\": \"Use this extraction driver before paymentRunInstallments BV for payment-file bank-error questions because BEP aliases are top-level in this extraction shape. If the user asks for invoice or installment columns, use paymentRunInstallmentsExtraction instead.\"        },        {          \"name\": \"paymentFileContainedPayments\",          \"description\": \"List payment rows contained in a specific payment file using the payment-level disbursement extraction view.\",          \"when\": \"User asks which payments are in a payment file or wants payment reference, payee, amount, method, status, and disbursement bank account for payments under one file.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"payeeName\",            \"payeePartyName\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"paymentStatusMeaning\",            \"paymentMethodName\",            \"disbursementBankAccountName\"          ],          \"extraFilterExpressions\": [            \"paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\"          ],          \"notes\": \"Use this extraction driver instead of the 1-to-many `payablesDisbursementPayments` child accessor on disbursementPaymentInstructions. If invoice-level detail is requested, use paymentRunInstallmentsExtraction.\"        }      ],      \"additionalInstructions\": [        \"Generate the full SELECT statement and place it into {select_statement} before execution.\",        \"Use viewQueries.disbursementPayments as the FROM source with alias consistent in the SQL (for example disbursementPayments).\",        \"Build the extraction SQL in a single query block where possible. Do not use an outer inline-view wrapper only to apply row limits or filter projected aliases.\",        \"Apply supported filters and date filters as needed, using supportedFilters and entity resolution.\",        \"For detail row-list queries, append FETCH FIRST 20 ROWS ONLY in the same query block after ORDER BY when present. Do not use legacy row-number predicates.\",        \"Do not reference SELECT aliases in WHERE, HAVING, ORDER BY, GROUP BY, or outer query filters. If a calculated expression must be filtered, ordered, or grouped, repeat the full expression in that clause. Output aliases are allowed only as returned column names.\",        \"Use the canonical resource `payablesDisbursementPayments`, but request the richer `disbursementPayments` named view when the question needs service-level, delivery-channel, bank-branch, payment-format, virtual-card, payment-file, AP-payment, or PPR accessor details.\",        \"Use nested accessor paths exactly as defined in `fields.accessors`; do not invent flattened aliases such as `ApChecksAll` or unsupported shortcut fields.\",        \"For supplier-focused bank-account questions, filter with `payeePartyName` or `payablesPayment.supplierName` plus `paymentDate`, and return the surrounding logistics context from `disbursementBankAccount`, `disbursementBankAccount.bank`, and `disbursementBankAccount.bankBranch`.\",        \"For payment file format questions, read from `accountPaymentProfile.systemPaymentProfile.paymentFormat` and related processing/profile accessors rather than inferring from payment method alone.\",        \"For service-level and delivery-channel questions, return `serviceLevelCode` and `deliveryChannelCode` together with related payment-format or processing metadata when available; do not invent banking-standard descriptions not returned by the API.\",        \"For virtual card questions, combine `paymentMode.lookupCode='VIRTUAL_CARD'` with `paymentInstrument.paymentInstrumentAlias` and, when relevant, `digitalPaymentAccount.virtualCardProgram.vcardProgramName`.\",        \"For expense-report or refund-status questions, locate the payment id through paymentRunInstallments first, then use this shape to return payment status, payment file, reconciliation, and PPR context.\",        \"When the user also needs invoice or installment detail, use this shape to identify matching payment ids and then hand off to the corresponding document-level shape instead of overloading this BV with unsupported document attributes.\",        \"For missing legal entity in a payment file, filter `payablesPaymentFile.paymentInstructionId=<PAYMENT_FILE_ID>` and `legalEntity.legalEntityId is null`; Taxpayer ID is not in current scope.\",        \"For JPM acknowledgement-linked voided payments, require `disbursementInboundFile.id is not null`, AP checks-backed `payablesPayment.paymentStatus.lookupCode='VOIDED'`, `voidDate is not null`, and `disbursementInboundFile.paymentSystem.paymentSystemName like '%JPM%'`; apply requested date windows to `voidDate` and do not infer unsupported L-level acknowledgement classifications.\",        \"When user asks for Bank acount details sort by paymentDate:desc. Do not use bepErrorCode\",        \"Do not ignore the extraFilterExpressions condition.\",        \"Treat business-driver filters as the required semantic core, not a closed-form query. When the user adds explicit constraints such as date or date range, PPR name/id, supplier, business unit, currency, amount, status, payment method, bank account, or payment file, add those filters when the selected shape exposes the field. A user-provided date filter overrides the default recency window. Do not drop required status, null-rate, source-shape, or sorting rules unless the user explicitly asks for a different lifecycle/source and the selected shape supports it.\",        \"If a requested filter, grouping, or output field is not exposed by the selected shape, do not invent a field or silently drop the constraint. Choose another supported shape that exposes it, or state the limitation while returning the closest supported query context.\",        \"For service-level and delivery-channel extraction questions by payment reference, filter with paymentReferenceNumber = '<value>', order by paymentReferenceNumber asc, append FETCH FIRST 20 ROWS ONLY in the same query block, and do not use paymentDate sorting.\"      ]    },    \"disbursementPaymentInstructions\": {      \"key\": \"disbursementPaymentInstructions\",      \"name\": \"disbursementPaymentInstructions\",      \"type\": \"BV\",      \"shapeRole\": \"detail\",      \"module\": \"oraErpCorePaymentsFundsDisbursement\",      \"businessObject\": \"PayablesPaymentFile\",      \"api\": \"objects/ora/erpCore/paymentsFundsDisbursement/v1/disbursementPaymentInstructions\",      \"description\": \"Business view for payment-file inquiry in Funds Disbursement. Use this shape for file status, creation or transmission failures, pending acknowledgements, payment-file bank context, transmission setup, and payment-file-to-PPR context.\",      \"exampleQuestions\": [        \"Show the transmission configuration and protocol for payment file 12345.\",        \"Which payment files are ready to transmit and what transmission setup will they use?\",        \"Which payment-file transmission configurations are active today?\",        \"Show payment files with transmission failed in the last 30 days.\",        \"Which payment files are pending acknowledgement and for which banks?\",        \"Show payment files that failed creation for PPR AP Payment Process 1001.\"      ],      \"fields\": {        \"fields\": [          \"paymentInstructionId\",          \"paymentCount\",          \"paymentRequestName\",          \"paymentProcessRequestId\",          \"createdBy\",          \"timeCreated\",          \"updatedBy\",          \"timeUpdated\",          \"transmissionDate\",          \"processingDate\",          \"comments\",          \"paymentDate\",          \"paymentCurrency\",          \"bankStatusCode\",          \"errorCode\",          \"errorMessage\",          \"paymentModeCode\",          \"organizationType.lookupCode\",          \"organizationType.meaning\",          \"paymentFileProcessingStatus.lookupCode\",          \"paymentFileProcessingStatus.meaning\",          \"paymentFileConfirmationStatus.lookupCode\",          \"paymentFileConfirmationStatus.meaning\",          \"paymentDocument.id\",          \"paymentDocument.paymentDocument\",          \"paymentDocument.firstAvailableDocumentNumber\",          \"paymentDocument.lastAvailableDocumentNumber\",          \"paymentDocument.lastIssuedDocumentNumber\",          \"paymentDocument.paymentDocumentCategory.code\",          \"paymentDocument.paymentDocumentCategory.name\",          \"accountPaymentProfile.paymentProfileId\",          \"accountPaymentProfile.paymentProfileName\",          \"accountPaymentProfile.paymentSystemAccount.paymentSystemAccountName\",          \"accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\",          \"accountPaymentProfile.paymentTransmissionConfiguration.transmitConfigurationId\",          \"accountPaymentProfile.paymentTransmissionConfiguration.startDate\",          \"accountPaymentProfile.paymentTransmissionConfiguration.endDate\",          \"accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmitProtocolCode\",          \"accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmissionProtocolName\",          \"accountPaymentProfile.systemPaymentProfile.systemProfileCode\",          \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.currencyCode\",          \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.paymentFileMaximumAmount\",          \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.numberOfPayments\",          \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByPaymentDateFlag\",          \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByPaymentCurrencyFlag\",          \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByDisbursementBankAccountFlag\",          \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByTotalPaymentsFlag\",          \"accountPaymentProfile.systemPaymentProfile.paymentFileCreationRule.groupByPaymentProcessRequestFlag\",          \"accountPaymentProfile.systemPaymentProfile.paymentFileCre