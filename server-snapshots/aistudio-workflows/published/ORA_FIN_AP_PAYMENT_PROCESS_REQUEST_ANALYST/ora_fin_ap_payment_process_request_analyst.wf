                {
                  "metadata": {
                    "name": "Choose shape type for execution",
                    "sourceCode": "let errorNode = $context.$nodes.FIN_AP_LOOP_EXECUTOR.ERROR_HANDLER.$output?.result?.errorNode;\nlet shapeToNodeMappings = {\n  \"FIN_AP_BO_GET_AV_DATA\": \"AV\",\n  \"FIN_AP_BO_GET_BV_DATA\": \"BV\",\n  \"GET_EXTRACT_DATA\": \"Extraction\",\n  \"GET_EV_DATA\": \"EV\",\n};\nreturn {\n  queryType: ( shapeToNodeMappings[errorNode] || $context.$nodes.FIN_AP_LOOP_EXECUTOR.$currentItem.shape.type),\n  error: $context.$nodes.FIN_AP_LOOP_EXECUTOR.ERROR_HANDLER.$output?.result\n};",
                    "returnType": "object"
