   \"paymentCurrency.currencyCode\",            \"invoiceAmount\",            \"paymentAmount\",            \"dueDate\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestStatusLookupCode = 'MISSING RATES'\"          ],          \"notes\": \"PM guidance: for all-PPR missing payment conversion-rate scans, filter by paymentProcessRequestStatusLookupCode only. Do not add conversionRate IS NULL unless the user asks for a specific PPR, currencies, counts, or amount-threshold rows.\"        },        {          \"name\": \"missingPaymentConversionRatesByPpr\",          \"description\": \"Selected installments in a specific PPR that are missing payment conversion rates.\",          \"when\": \"User asks which currencies, payments, or installments are missing payment conversion rates in a specific PPR.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"invoiceCurrency.currencyCode\",            \"paymentCurrency.currencyCode\",            \"invoiceAmount\",            \"paymentAmount\",            \"dueDate\"          ],          \"extraFilterExpressions\": [            \"checkrunName = '<PPR_NAME_FROM_USER>'\",            \"conversionRate IS NULL\"          ],          \"notes\": \"PM guidance: for a specific PPR, find missing payment conversion rates with conversionRate IS NULL. Do not force the MISSING RATES status filter.\"        },        {          \"name\": \"countInstallmentsBlockedByMissingPaymentConversionRates\",          \"description\": \"Count installments blocked due to missing payment conversion rates.\",          \"when\": \"User asks how many installments are blocked due to missing payment conversion rates.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"invoiceNumber\",            \"installmentNumber\",            \"invoiceCurrency.currencyCode\",            \"paymentCurrency.currencyCode\",            \"paymentAmount\"          ],          \"extraFilterExpressions\": [            \"conversionRate IS NULL\"          ],          \"notes\": \"PM guidance: count installments blocked due to missing payment conversion rates using conversionRate IS NULL. Add checkrunName only when the user supplies a PPR; do not force a status filter.\"        },        {          \"name\": \"countInstallmentsBlockedByMissingCrossCurrencyRates\",          \"description\": \"Count installments blocked due to missing cross-currency rates.\",          \"when\": \"User asks how many installments are blocked due to missing cross currency rates.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"invoiceNumber\",            \"installmentNumber\",            \"invoiceCurrency.currencyCode\",            \"paymentCurrency.currencyCode\",            \"paymentAmount\"          ],          \"extraFilterExpressions\": [            \"crossCurrencyRate IS NULL\"          ],          \"notes\": \"PM guidance: count installments blocked due to missing cross-currency rates using crossCurrencyRate IS NULL. Add checkrunName only when the user supplies a PPR; do not force a status filter.\"        },        {          \"name\": \"highValueMissingPaymentConversionRatesAllPprs\",          \"description\": \"Selected installments across all PPRs that are missing payment conversion rates and exceed an amount threshold.\",          \"when\": \"User asks for missing payment conversion rates where the payment or installment amount exceeds a threshold, without specifying a PPR.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"invoiceCurrency.currencyCode\",            \"paymentCurrency.currencyCode\",            \"invoiceAmount\",            \"paymentAmount\",            \"dueDate\"          ],          \"extraFilterExpressions\": [            \"conversionRate IS NULL\",            \"paymentAmount > <AMOUNT_THRESHOLD_FROM_USER_OR_DEFAULT_100000>\"          ],          \"notes\": \"PM guidance: for payment/installment amount threshold questions about missing payment conversion rates, use conversionRate IS NULL plus the amount predicate. Do not force a status filter.\"        },        {          \"name\": \"highValueMissingCrossCurrencyRatesAllPprs\",          \"description\": \"Selected installments across all PPRs that are missing cross-currency rates and exceed an amount threshold.\",          \"when\": \"User asks for missing cross currency rates where the payment or installment amount exceeds a threshold, without specifying a PPR.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"invoiceCurrency.currencyCode\",            \"paymentCurrency.currencyCode\",            \"invoiceAmount\",            \"paymentAmount\",            \"dueDate\"          ],          \"extraFilterExpressions\": [            \"crossCurrencyRate IS NULL\",            \"paymentAmount > <AMOUNT_THRESHOLD_FROM_USER_OR_DEFAULT_100000>\"          ],          \"notes\": \"PM guidance: for payment/installment amount threshold questions about missing cross-currency rates, use crossCurrencyRate IS NULL plus the amount predicate. Do not force a status filter.\"        },        {          \"name\": \"highValueMissingPaymentConversionRatesByPpr\",          \"description\": \"Selected installments in a specific PPR that are missing payment conversion rates and exceed an amount threshold.\",          \"when\": \"User asks for missing payment conversion rates in a specific PPR where the payment or installment amount exceeds a threshold.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"invoiceCurrency.currencyCode\",            \"paymentCurrency.currencyCode\",            \"invoiceAmount\",            \"paymentAmount\",            \"dueDate\"          ],          \"extraFilterExpressions\": [            \"checkrunName = '<PPR_NAME_FROM_USER>'\",            \"conversionRate IS NULL\",            \"paymentAmount > <AMOUNT_THRESHOLD_FROM_USER_OR_DEFAULT_100000>\"          ],          \"notes\": \"PM guidance: for PPR-specific amount-threshold questions about missing payment conversion rates, use checkrunName, conversionRate IS NULL, and amount predicate. Do not force a status filter.\"        },        {          \"name\": \"highValueMissingCrossCurrencyRatesByPpr\",          \"description\": \"Selected installments in a specific PPR that are missing cross-currency rates and exceed an amount threshold.\",          \"when\": \"User asks for missing cross currency rates in a specific PPR where the payment or installment amount exceeds a threshold.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"invoiceCurrency.currencyCode\",            \"paymentCurrency.currencyCode\",            \"invoiceAmount\",            \"paymentAmount\",            \"dueDate\"          ],          \"extraFilterExpressions\": [            \"checkrunName = '<PPR_NAME_FROM_USER>'\",            \"crossCurrencyRate IS NULL\",            \"paymentAmount > <AMOUNT_THRESHOLD_FROM_USER_OR_DEFAULT_100000>\"          ],          \"notes\": \"PM guidance: for PPR-specific amount-threshold questions about missing cross-currency rates, use checkrunName, crossCurrencyRate IS NULL, and amount predicate. Do not force a status filter.\"        },        {          \"name\": \"affectedInstallmentsForRateUpdate\",          \"description\": \"Payments or installments affected if a user updates a currency conversion rate.\",          \"when\": \"User asks which payments or installments will be affected if they update a specific currency conversion rate, such as USD to EUR conversion rate to 0.92.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"invoiceCurrency.currencyCode\",            \"paymentCurrency.currencyCode\",            \"invoiceAmount\",            \"paymentAmount\",            \"dueDate\",            \"conversionRate\",            \"crossCurrencyRate\"          ],          \"extraFilterExpressions\": [            \"invoiceCurrencyCurrencyCode='<FROM_CURRENCY_FROM_USER>'\",            \"paymentCurrencyCurrencyCode='<TO_CURRENCY_FROM_USER>'\",            \"ROWNUM <= 20\"          ],          \"notes\": \"Use this for currency-pair impact analysis. Return both conversionRate and crossCurrencyRate, but do not add missing-rate status or IS NULL predicates unless the user explicitly asks for missing rows.\"        },        {          \"name\": \"affectedInstallmentsForRateUpdateByPpr\",          \"description\": \"Payments or installments in a specific PPR affected if a user updates a currency conversion rate.\",          \"when\": \"User asks which payments or installments in a specific PPR will be affected if they update a specific currency conversion rate.\",          \"fieldsToReturn\": [            \"payablesPaymentProcessRequest.checkrunName\",            \"supplier.name\",            \"invoiceNumber\",            \"installmentNumber\",            \"invoiceCurrency.currencyCode\",            \"paymentCurrency.currencyCode\",            \"invoiceAmount\",            \"paymentAmount\",            \"dueDate\",            \"conversionRate\",            \"crossCurrencyRate\"          ],          \"extraFilterExpressions\": [            \"(payablesPaymentProcessRequest.checkrunId = <PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName = '<PPR_NAME_FROM_USER>')\",            \"invoiceCurrency.currencyCode = '<FROM_CURRENCY_FROM_USER>'\",            \"paymentCurrency.currencyCode = '<TO_CURRENCY_FROM_USER>'\",            \"(conversionRate IS NULL or crossCurrencyRate IS NULL)\"          ],          \"notes\": \"Use this when the user asks for affected payments or installments for a currency-rate update within one specific PPR.\"        },        {          \"name\": \"withholdingTaxByPpr\",          \"description\": \"Selected installments in a payment process request with withholding tax amounts.\",          \"when\": \"User asks which installments have withholding tax or asks for total withheld tax in a PPR.\",          \"fieldsToReturn\": [            \"supplierName\",            \"invoiceNumber\",            \"installmentNumber\",            \"paymentAmount\",            \"withheldTax\"          ],          \"extraFilterExpressions\": [            \"(payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>')\",            \"withheldTax>0\",            \"(payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequestName='<PPR_NAME_FROM_USER>')\"          ],          \"notes\": \"\"        },        {          \"name\": \"locatePprByInvoice\",          \"description\": \"Locate the payment process request currently carrying a given invoice installment.\",          \"when\": \"User asks which PPR contains or is processing a specific invoice.\",          \"fieldsToReturn\": [            \"checkrunName\",            \"checkrunId\",            \"paymentProcessRequestStatusLookupCode\",            \"invoiceNumber\",            \"installmentNumber\",            \"supplierName\"          ],          \"extraFilterExpressions\": [            \"invoiceNumber='<INVOICE_NUMBER_FROM_USER>'\"          ],          \"notes\": \"Add installmentNumber when the user identifies a specific installment.\"        },        {          \"name\": \"installmentsPaidEarlyVsDueDate\",          \"description\": \"Find selected installments whose payment run date is materially earlier than the installment due date.\",          \"when\": \"User asks for installments in a run that are being paid more than a threshold number of days before due date.\",          \"fieldsToReturn\": [            \"checkrunName\",            \"invoiceNumber\",            \"installmentNumber\",            \"dueDate\",            \"checkDate\",            \"paymentAmount\",            \"supplierName\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>'\",            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Compute the day difference between dueDate and payablesPaymentProcessRequest.checkDate outside the base fetch.\"        },        {          \"name\": \"proposedPaymentReviewByPpr\",          \"description\": \"Review the proposed installments in a PPR before payment approval or payment-file generation.\",          \"when\": \"User asks for a last-minute review of the proposed payments in a run.\",          \"fieldsToReturn\": [            \"checkrunName\",            \"paymentGroupingNumber\",            \"supplierName\",            \"invoiceNumber\",            \"installmentNumber\",            \"dueDate\",            \"paymentAmount\",            \"paymentProcessRequestStatusMeaning\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>'\",            \"payablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode in ('PENDING_REVIEW','ORA_REQUIRE_APPROVAL','ORA_APPROVAL_INITIATED','ORA_APPROVED','ORA_APPROVAL_WITHDRAWN','PAYMENTS_CREATED')\",            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Use payablesSelectedInstallmentsSummary for supported grouped rollups. Aggregate over filtered selectedPaymentInstallments rows only when the requested count, field, or AP-stage detail is not exposed by the summary AV.\"        },        {          \"name\": \"distributionByBusinessUnit\",          \"description\": \"Review the distribution of proposed payment value by business unit within a PPR.\",          \"when\": \"User asks for payment amounts grouped by business unit in a proposed-payment review.\",          \"fieldsToReturn\": [            \"checkrunName\",            \"businessUnitName\",            \"paymentAmount\",            \"paymentGroupingNumber\",            \"supplierName\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>'\",            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Group externally by businessUnit.name and sum paymentAmount.\"        },        {          \"name\": \"supplierValueConcentration\",          \"description\": \"Identify the suppliers that account for most of the proposed payment value in a PPR.\",          \"when\": \"User asks which suppliers represent 80 percent of the payment value or wants concentration analysis before approval.\",          \"fieldsToReturn\": [            \"checkrunName\",            \"supplierName\",            \"paymentAmount\",            \"invoiceNumber\",            \"installmentNumber\",            \"paymentGroupingNumber\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>'\",            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Sort aggregated supplier totals descending and compute the running cumulative percentage outside the base fetch.\"        },        {          \"name\": \"highValueApprovalCandidates\",          \"description\": \"Surface high-value selected installments that may need manager review before payment approval.\",          \"when\": \"User asks for payments over a threshold with supplier and invoice references.\",          \"fieldsToReturn\": [            \"checkrunName\",            \"supplierName\",            \"invoiceNumber\",            \"installmentNumber\",            \"paymentAmount\",            \"dueDate\",            \"paymentProcessRequestStatusMeaning\"          ],          \"extraFilterExpressions\": [            \"(payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>')\",            \"paymentAmount>=<AMOUNT_THRESHOLD_FROM_USER_OR_DEFAULT_100000>\",            \"(payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequestName='<PPR_NAME_FROM_USER>')\"          ],          \"notes\": \"Use the companion EV PayablesPaymentProcessRequestDetails to retrieve the run-level approver and pending-since aging.\"        },        {          \"name\": \"installmentAmountVarianceReview\",          \"description\": \"Explain why the selected payment amount differs from the invoice amount for installments already included in the run.\",          \"when\": \"User asks why the payment amount for a supplier or invoice differs from the invoice amount during installment review.\",          \"fieldsToReturn\": [            \"checkrunName\",            \"supplierName\",            \"invoiceNumber\",            \"installmentNumber\",            \"invoiceAmount\",            \"amountRemaining\",            \"paymentAmount\",            \"discount\",            \"withheldTax\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>'\",            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Use the deltas between invoiceAmount, amountRemaining, paymentAmount, discount, and withheldTax to explain the variance.\"        },        {          \"name\": \"whatIfExclusionImpact\",          \"description\": \"Estimate the cash impact of excluding a supplier, invoice, priority band, or date slice from the selected installments in a PPR.\",          \"when\": \"User asks what would happen if they remove a supplier, invoice, or priority group from the run before approval.\",          \"fieldsToReturn\": [            \"checkrunName\",            \"supplierName\",            \"invoiceNumber\",            \"installmentNumber\",            \"paymentPriority\",            \"paymentAmount\",            \"paymentCurrencyCurrencyCode\",            \"checkDate\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or payablesPaymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>'\",            \"apply the exclusion predicate supplied by the user: supplier.name='<SUPPLIER_NAME_FROM_USER>', invoiceNumber='<INVOICE_NUMBER_FROM_USER>', or paymentPriority=<PAYMENT_PRIORITY_FROM_USER>\",            \"payablesPaymentProcessRequest.checkDate between <START_DATE> and <END_DATE> when the user gives a date window\",            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Aggregate the current selected rows externally, subtract the excluded slice, and present before-versus-after totals without implying that the PPR was changed.\"        },        {          \"name\": \"whatIfExclusionImpactByPriorityAndWeek\",          \"description\": \"Estimate the cash impact of excluding a payment priority band from the selected installments in a PPR for the current week.\",          \"when\": \"User asks how much cash would be retained if all Standard-priority payments are excluded from this run for the week.\",          \"fieldsToReturn\": [            \"paymentProcessRequestName\",            \"supplierName\",            \"invoiceNumber\",            \"installmentNumber\",            \"paymentPriority\",            \"paymentAmount\",            \"paymentCurrencyCurrencyCode\",            \"paymentDate\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequestName='<PPR_NAME_FROM_USER>'\",            \"paymentPriority=<NUMERIC_PRIORITY_VALUE>\",            \"paymentDate between <TODAY> and <WEEK_END>\",            \"paymentPriority between <LOW_PRIORITY_VALUE> and <HIGH_PRIORITY_VALUE>\"          ],          \"notes\": \"Aggregate the filtered paymentAmount externally to return the cash retained for the week. Do not modify the PPR; this is a what-if analysis only. If the user only says Standard priority and does not provide the numeric priority or range, ask which payment priority value from 1 to 100 should be treated as Standard before querying.\"        },        {          \"name\": \"lastUsedConversionRateByCurrencyPair\",          \"description\": \"Find the most recently used conversion rate for a specific invoice-currency to payment-currency pair in selected installments.\",          \"when\": \"User asks for the last conversion rate used between two currencies, such as USD to JPY, or asks what rate was most recently applied for a currency pair. .Mandatory : In this case do not apply missing rate filter\",          \"fieldsToReturn\": [            \"conversionRate\",            \"paymentDate\",            \"invoiceCurrencyCurrencyCode\",            \"paymentCurrencyCurrencyCode\"          ],          \"extraFilterExpressions\": [            \"invoiceCurrencyCurrencyCode='<FROM_CURRENCY_FROM_USER>'\",            \"paymentCurrencyCurrencyCode='<TO_CURRENCY_FROM_USER>'\",            \"conversionRate IS NOT NULL\",            \"paymentDate IS NOT NULL\",            \"sortBy: paymentDate:desc\",            \"limit: 1\"          ],          \"notes\": \"Do not add missing-rate filters for this question. Exclude rows where conversionRate is null or paymentDate is null before sorting, then order by paymentDate DESC and return the first row.\"        }      ],      \"additionalInstructions\": [        \"Generate the full SELECT statement and place it into {select_statement} before execution.\",        \"Use viewQueries.selectedPaymentInstallments as the FROM source with alias consistent in the SQL (for example selectedPaymentInstallments).\",        \"Do not use selectedPaymentInstallmentsExtraction as the primary source for plain 'review installments for PPR' requests. Use pprInstallmentsDeduplicatedSummary for summary review and pprInstallmentsDeduplicatedDetails for line-level review unless the PPR status or requested fields require this AP-source wrapper.\",        \"The inner subselect should project all aliases used by the outer SELECT and WHERE.\",        \"Apply supported filters and date filters as needed, using supportedFilters and entity resolution.\",        \"Always limit the outer query to 20 rows using where ROWNUM<=20.\",        \"Only use top-level fields and dotted accessor paths that this BV explicitly exposes. Do not invent supplier number, supplier site, remit-to address, external bank account, or other BO-only fields.\",        \"Use originalInvoiceTransaction.description when the user asks for invoice description; do not add a flat invoiceDescription field.\",        \"Use remitToSupplier.name when the user asks for remit-to supplier details.\",        \"Use invoiceCurrency.currencyCode and paymentCurrency.currencyCode together when comparing currency pairs or looking for missing rates.\",        \"PM missing-rate split: all-PPR missing payment conversion rates use only paymentProcessRequestStatusLookupCode = 'MISSING RATES'; all-PPR missing cross-currency rates use only paymentProcessRequestStatusLookupCode = 'MISSING_X_RATES'. Specific-PPR currency questions, blocked-installment counts, and amount-threshold questions use conversionRate IS NULL for missing payment conversion rates or crossCurrencyRate IS NULL for missing cross-currency rates, with checkrunName added only when the user supplies a PPR. Do not force status filters for these null-rate patterns.\",        \"For timing comparisons, combine dueDate from this shape with payablesPaymentProcessRequest.checkDate from this same shape.\",        \"Use payablesSelectedInstallmentsSummary for supported selected-installment payment-value rollups. Use this extraction wrapper for AP-stage detail rows, counts, or fields not exposed by the summary AV.\",        \"Use paymentGroupingNumber to explain how installments were bundled into proposed payments before approval.\",        \"Use payablesPaymentProcessRequest.internalBankAccount.id when the user wants the paying bank dimension by id. If the user needs the readable disbursement bank account name or external bank account details, switch to paymentRunInstallments.\",        \"Use invoiceInstallmentDetails when the user is asking about installment schedule detail before selection, discount windows such as within the next 5 days, or hold-related invoice-installment attributes rather than about installments already selected into a PPR.\",        \"Use PayablesPaymentProcessRequestDetails when the question is really about approver, approval aging, or all PPRs pending approval rather than about the underlying installment rows.\",        \"For what-if exclusion questions, fetch the matching selected installments and compute before-versus-after payment totals outside the base fetch. Do not imply that the payment process request was modified.\",        \"For Standard priority or named priority-band what-if questions, do not assume a default numeric range. Ask for the payment priority value or range between 1 and 100 unless the user provides it.\",        \"When constructing filters for null checks, use is null or is not null. Do not use = null or != null.\",        \"For selectedPaymentInstallmentsExtraction, filter by the PPR name using the checkrunName alias. Do not invent paymentProcessRequestName for this extraction source.\",        \"For last-used conversion-rate questions, exclude null paymentDate values and null conversionRate values before ORDER BY paymentDate DESC; otherwise null-dated rows can be returned as the latest rate.\",        \"Do not treat selected-installment missing-rate questions as unsupported when the requested PPR is in MISSING RATES or MISSING_X_RATES status.\",        \"Extraction missing-rate syntax uses IS NULL. For rate-update impact questions, do not add IS NULL or status filters; filter by the requested currency pair and include both conversionRate and crossCurrencyRate.\",        \"Do not answer organized-by-currency-pair missing conversion-rate questions from cached/narrative facts; emit selectedPaymentInstallmentsExtraction query context with grouped blockedInstallments and blockedAmount.\",        \"Use selectedPaymentInstallmentsExtraction, not selectedPaymentInstallments BV, for blocked-installment counts and currency-rate update impact questions. Always emit the extraction query context for these supported patterns even when no rows are returned.\",        \"Do not use selectedPaymentInstallmentsExtraction for plain all-PPR or PPR-specific cross-currency detail questions. Use extraction for cross-currency only when the user asks for counts/how many, grouped/organized summaries, high-value extraction, or rate-update impact.\",        \"For organized-by-currency-pair missing conversion-rate summaries, the grouped extraction SQL must end with ORDER BY blockedAmount DESC and must not be replaced by a no-data narrative. Do not add FETCH FIRST or ROWNUM inside the SQL unless the user explicitly asks for top N.\"      ],      \"fieldSelectionRuleUsage\": {        \"match\": \"Choose the closest questionExamples entry for the user request.\",        \"fields\": \"Use the matching fields value exactly and preserve order.\",        \"paraphrases\": \"Use the same fields for paraphrased or equivalent requests.\",        \"addFieldsOnlyWhen\": \"The user explicitly asks for more displayed columns, or the field is required for filter, sort, group, key, or deeplink handling.\"      },      \"fieldSelectionRules\": [        {          \"questionExamples\": [            \"Show me all missing conversion rates organized by currency pair\",            \"Show me all missing payment conversion rates organized by currency pair for <PPR_NAME>\"          ],          \"queryType\": \"extraction\",          \"shape\": \"selectedPaymentInstallmentsExtraction\",          \"fields\": \"invoiceCurrencyCurrencyCode,paymentCurrencyCurrencyCode,blockedInstallments,blockedAmount\",          \"filters\": \"paymentProcessRequestStatusLookupCode IN ('MISSING RATES','MISSING_X_RATES')\",          \"groupBy\": \"invoiceCurrencyCurrencyCode,paymentCurrencyCurrencyCode\",          \"sortBy\": \"blockedAmount:desc\",          \"fieldOrderLocked\": true,          \"notes\": \"Mandatory grouped-summary pattern only. Generate SELECT invoiceCurrencyCurrencyCode, paymentCurrencyCurrencyCode, COUNT(*) AS blockedInstallments, SUM(paymentAmount) AS blockedAmount FROM selectedPaymentInstallments WHERE paymentProcessRequestStatusLookupCode IN ('MISSING RATES','MISSING_X_RATES') GROUP BY invoiceCurrencyCurrencyCode, paymentCurrencyCurrencyCode ORDER BY blockedAmount DESC. Do not return narrative only. Do not omit ORDER BY blockedAmount DESC. Do not add FETCH FIRST or ROWNUM inside this grouped SQL unless the user explicitly asks for top N; display limit can be external. Do not use this for plain all-PPR detail requests like Show me missing cross currency rates for all PPRs.\"        },        {          \"questionExamples\": [            \"How many installments are blocked due to missing payment conversion rates?\",            \"How many installments are blocked due to missing payment conversion rates for <PPR_NAME>?\"          ],          \"queryType\": \"extraction\",          \"shape\": \"selectedPaymentInstallmentsExtraction\",          \"fields\": \"COUNT(*) AS blockedInstallments\",          \"filters\": \"conversionRate IS NULL\",          \"fieldOrderLocked\": true,          \"notes\": \"Counts for missing payment conversion rates are extraction-only: SELECT COUNT(*) AS blockedInstallments FROM selectedPaymentInstallments WHERE conversionRate IS NULL. Add checkrunName only when the user supplies a PPR; do not force a status filter and do not use selectedPaymentInstallments BV.\"        },        {          \"questionExamples\": [            \"How many installments are blocked due to missing cross currency rates?\",            \"How many installments are blocked due to missing cross currency rates in PPR <PPR_NAME>\"          ],          \"queryType\": \"extraction\",          \"shape\": \"selectedPaymentInstallmentsExtraction\",          \"fields\": \"COUNT(*) AS blockedInstallments\",          \"filters\": \"crossCurrencyRate IS NULL\",          \"fieldOrderLocked\": true,          \"notes\": \"Counts for missing cross-currency rates are extraction-only: SELECT COUNT(*) AS blockedInstallments FROM selectedPaymentInstallments WHERE crossCurrencyRate IS NULL. This count rule has precedence over the all-PPR MISSING_X_RATES BV detail rule when the question says how many or count.\"        },        {          \"questionExamples\": [            \"Show me missing payment conversion rates where the payment/installment amount exceeds $100,000\"          ],          \"queryType\": \"extraction\",          \"shape\": \"selectedPaymentInstallmentsExtraction\",          \"fields\": \"checkrunName,supplierName,invoiceNumber,installmentNumber,invoiceCurrencyCurrencyCode,paymentCurrencyCurrencyCode,invoiceAmount,paymentAmount,dueDate,conversionRate,crossCurrencyRate\",          \"filters\": \"conversionRate IS NULL AND paymentAmount > <AMOUNT_THRESHOLD_FROM_USER_OR_DEFAULT_100000> AND ROWNUM <= 20\",          \"sortBy\": \"checkrunName:asc\",          \"fieldOrderLocked\": true,          \"notes\": \"High-value missing payment conversion-rate extraction uses conversionRate IS NULL plus amount; no status filter.\"        },        {          \"questionExamples\": [            \"Show me missing cross currency rates where the payment/installment amount exceeds $100,000\"          ],          \"queryType\": \"extraction\",          \"shape\": \"selectedPaymentInstallmentsExtraction\",          \"fields\": \"checkrunName,supplierName,invoiceNumber,installmentNumber,invoiceCurrencyCurrencyCode,paymentCurrencyCurrencyCode,invoiceAmount,paymentAmount,dueDate,conversionRate,crossCurrencyRate\",          \"filters\": \"crossCurrencyRate IS NULL AND paymentAmount > <AMOUNT_THRESHOLD_FROM_USER_OR_DEFAULT_100000> AND ROWNUM <= 20\",          \"sortBy\": \"checkrunName:asc\",          \"fieldOrderLocked\": true,          \"notes\": \"High-value missing cross-currency extraction uses crossCurrencyRate IS NULL plus amount; no status filter.\"        },        {          \"questionExamples\": [            \"Which payments/installments will be affected if I update the USD to EUR conversion rate to 0.92?\"          ],          \"queryType\": \"extraction\",          \"shape\": \"selectedPaymentInstallmentsExtraction\",          \"fields\": \"checkrunName,supplierName,invoiceNumber,installmentNumber,invoiceCurrencyCurrencyCode,paymentCurrencyCurrencyCode,invoiceAmount,paymentAmount,dueDate,conversionRate,crossCurrencyRate\",          \"filters\": \"invoiceCurrencyCurrencyCode = '<FROM_CURRENCY_FROM_USER>' AND paymentCurrencyCurrencyCode = '<TO_CURRENCY_FROM_USER>' AND ROWNUM <= 20\",          \"fieldOrderLocked\": true,          \"notes\": \"Rate-update impact is extraction-only: SELECT checkrunName, supplierName, invoiceNumber, installmentNumber, invoiceCurrencyCurrencyCode, paymentCurrencyCurrencyCode, invoiceAmount, paymentAmount, dueDate, conversionRate, crossCurrencyRate FROM selectedPaymentInstallments WHERE invoiceCurrencyCurrencyCode = '<FROM_CURRENCY_FROM_USER>' AND paymentCurrencyCurrencyCode = '<TO_CURRENCY_FROM_USER>' AND ROWNUM <= 20. Do not use selectedPaymentInstallments BV and do not add status or IS NULL predicates unless explicitly requested.\"        },        {          \"questionExamples\": [            \"What was the last conversion rate we used for USD to JPY?\"          ],          \"queryType\": \"extraction\",          \"shape\": \"selectedPaymentInstallmentsExtraction\",          \"fields\": \"conversionRate,paymentDate\",          \"filters\": \"invoiceCurrencyCurrencyCode = '<FROM_CURRENCY_FROM_USER>' AND paymentCurrencyCurrencyCode = '<TO_CURRENCY_FROM_USER>' AND conversionRate IS NOT NULL AND paymentDate IS NOT NULL\",          \"sortBy\": \"paymentDate:desc\",          \"limit\": 1,          \"fieldOrderLocked\": true,          \"notes\": \"Last-used rate queries are not missing-rate queries. Exclude null paymentDate before sorting descending so a null date is never returned as latest.\"        }      ]    },    \"payablesPaymentSummaries\": {      \"key\": \"payablesPaymentSummaries\",      \"name\": \"payablesPaymentSummaries\",      \"type\": \"AV\",      \"shapeRole\": \"summary\",      \"module\": \"oraErpCorePayablesPayments\",      \"businessObject\": null,      \"api\": \"analyticviews/ora/erpCore/payablesPayments/v1/payablesPaymentSummaries\",      \"description\": \"Use this AV shape to summarize payables payments by date, business unit, supplier, currency, bank account, payment type, and payment status. It is the right shape for payment-value rollups, stage breakdowns, and payment trends over time.\",      \"exampleQuestions\": [        \"Show me the total payment value grouped by payment type.\",        \"Show yesterday's total payment value breakdown by supplier and currency.\",        \"Give me a summary of payments in this batch by business unit.\",        \"View summary of all payments being made today.\",        \"Compare the cash flow of today to the average of last week and provide the variance.\",        \"Show me the payment history for Supplier Y over the last 30 days.\"      ],      \"fields\": {        \"measures\": [          \"paidAmount\",          \"discountTaken\",          \"discountLost\",          \"numberOfPayments\"        ],        \"dimensions\": [          {            \"name\": \"legalEntity\",            \"attributes\": [              {                \"name\": \"legalEntityCountryCode\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"legalEntityName\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"ledgerCurrCode\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"legalEntityId\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"legalEntityIdentifier\",                \"sortable\": true,                \"searchable\": true              }            ],            \"hierarchies\": [              {                \"name\": \"legalEntityHierarchy\",                \"levels\": [                  \"LEGALENTITY\"                ]              }            ]          },          {            \"name\": \"businessUnit\",            \"attributes\": [              {                \"name\": \"ledgerName\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"profitCenterFlag\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"businessUnitName\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"businessUnitId\",                \"sortable\": true,                \"searchable\": true              }            ],            \"hierarchies\": [              {                \"name\": \"businessUnitHierarchy\",                \"levels\": [                  \"BUSINESSUNIT\"                ]              }            ]          },          {            \"name\": \"bankAccount\",            \"attributes\": [              {                \"name\": \"cashPoolType\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"currencyCode\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"bankAccountName\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"bankBranchId\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"bankBranchName\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"targetBalance\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"bankAccountType\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"bankName\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"bankAccountId\"              },              {                \"name\": \"cashPoolName\",                \"sortable\": true,                \"searchable\": true              }            ],            \"hierarchies\": [              {                \"name\": \"bankAccountHierarchy\",                \"levels\": [                  \"BANKACCOUNT\"                ]              }            ]          },          {            \"name\": \"paymentCurrency\",            \"attributes\": [              {                \"name\": \"enabledFlag\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"currencyCode\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"currencyName\",                \"sortable\": true,                \"searchable\": true              }            ],            \"hierarchies\": [              {                \"name\": \"paymentCurrencyHierarchy\",                \"levels\": [                  \"CURRENCYCODE\"                ]              }            ]          },          {            \"name\": \"supplierSite\",            \"attributes\": [              {                \"name\": \"partySiteId\"              },              {                \"name\": \"supplierName\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"partyNumber\"              },              {                \"name\": \"supplierTypeMeaning\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"supplierSiteId\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"oneTimeFlag\"              },              {                \"name\": \"supplierNumber\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"partyId\"              },              {                \"name\": \"paymentTerm\"              },              {                \"name\": \"supplierType\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"country\"              },              {                \"name\": \"supplierId\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"supplierSiteName\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"taxOrganizationType\"              },              {                \"name\": \"dunsNumber\"              },              {                \"name\": \"standardIndustryClassification\"              },              {                \"name\": \"paymentTermId\",                \"sortable\": true,                \"searchable\": true              }            ],            \"hierarchies\": [              {                \"name\": \"supplierHierarchy\",                \"levels\": [                  \"SUPPLIERSITE\",                  \"SUPPLIER\"                ]              },              {                \"name\": \"supplierTypeHierarchy\",                \"levels\": [                  \"SUPPLIERSITE\",                  \"SUPPLIER\",                  \"SUPPLIERTYPE\"                ]              }            ]          },          {            \"name\": \"paymentDate\",            \"attributes\": [              {                \"name\": \"dayOfWeek\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"dayName\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"calendarDate\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"calendarWeekId\",                \"sortable\": true,                \"searchable\": true              },              {                \"name\": \"calendarMonthId\",                \"sortable\": true,                \"searchable\": true              }            ],            \"hierarchies\": [              {                \"name\": \"paymentDateHierarchy\",                \"levels\": [                  \"DAY\",                  \"WEEK\",                  \"MONTH\",                  \"QUARTER\",                  \"YEAR\"                ]              }            ]          },          {            \"name\": \"paymentType\",            \"attributes\": [              {                \"name\": \"paymentType\"              },              {                \"name\": \"paymentTypeCode\",                \"sortable\": true,                \"searchable\": true              }            ],            \"hierarchies\": [              {                \"name\": \"paymentTypeHierarchy\",                \"levels\": [                  \"PAYMENTTYPE\"                ]              }            ]          },          {            \"name\": \"payablesPaymentStatus\",            \"attributes\": [              {                \"name\": \"payablesPaymentStatus\"              },              {                \"name\": \"payablesPaymentStatusCode\",                \"sortable\": true,                \"searchable\": true              }            ],            \"hierarchies\": [              {                \"name\": \"payablesPaymentStatusHierarchy\",             