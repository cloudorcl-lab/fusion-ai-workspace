                    "sourceCode": "let variables = $context.$variables;\n\nlet errors = variables.dataFetchErrors || [];\n\nlet node = $context.$nodes.FIN_AP_LOOP_EXECUTOR.ERROR_HANDLER.$output.result;\n\nerrors.push(node);\n\nreturn errors;",
