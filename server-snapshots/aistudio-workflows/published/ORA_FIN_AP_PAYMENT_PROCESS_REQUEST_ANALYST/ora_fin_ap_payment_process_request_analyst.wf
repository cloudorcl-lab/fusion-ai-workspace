Payment Yes No Indicator Code\": \"selectedForPaymentHierarchy.yesNoIndicatorCode\",          \"Selected For Payment Yes No Indicator\": \"selectedForPaymentHierarchy.yesNoIndicator\"        }      },      \"fieldSelection\": {        \"base\": [          \"invoiceRemainingAmount\",          \"amountRemaining\",          \"countInstallments\",          \"dueDateHierarchy\",          \"businessUnitHierarchy\",          \"supplierHierarchy\",          \"invoiceCurrencyHierarchy\"        ],        \"optional\": [          \"paymentTermDiscountAmount\",          \"dynamicDiscountAmount\",          \"legalEntityHierarchy\",          \"supplierTypeHierarchy\",          \"agingBucketHierarchy\",          \"overdueIndicatorHierarchy\",          \"paymentDiscountAvailableHierarchy\",          \"dynamicDiscountAvailableHierarchy\",          \"financingProgramAssignedHierarchy\",          \"invoicePaymentStatusHierarchy\",          \"invoiceValidationStatusHierarchy\",          \"invoiceInstallmentOnHoldHierarchy\",          \"daysRemainingThirtyDayBucketHierarchy\",          \"daysLateThirtyDayBucketHierarchy\",          \"payablesPaymentTermHierarchy\",          \"paymentMethodHierarchy\",          \"selectedForPaymentHierarchy\",          \"payablesInvoiceTypeHierarchy\",          \"payablesInvoiceSourceHierarchy\",          \"invoiceApprovalStatusHierarchy\",          \"daysLateSevenDayBucketHierarchy\",          \"daysRemainingSevenDayBucketHierarchy\",          \"invoiceOverallPaymentStatusHierarchy\"        ]      },      \"sortableAttributes\": [        \"agingBucketHierarchy.daysLate\",        \"agingBucketHierarchy.daysLateCode\",        \"businessUnitHierarchy.businessUnitId\",        \"businessUnitHierarchy.businessUnitName\",        \"businessUnitHierarchy.ledgerName\",        \"businessUnitHierarchy.profitCenterFlag\",        \"daysLateSevenDayBucketHierarchy.noOfDays\",        \"daysLateSevenDayBucketHierarchy.sevenDayBucket\",        \"daysLateSevenDayBucketHierarchy.thirtyDayBucket\",        \"daysLateThirtyDayBucketHierarchy.noOfDays\",        \"daysLateThirtyDayBucketHierarchy.sevenDayBucket\",        \"daysLateThirtyDayBucketHierarchy.thirtyDayBucket\",        \"daysRemainingSevenDayBucketHierarchy.noOfDays\",        \"daysRemainingSevenDayBucketHierarchy.sevenDayBucket\",        \"daysRemainingSevenDayBucketHierarchy.thirtyDayBucket\",        \"daysRemainingThirtyDayBucketHierarchy.noOfDays\",        \"daysRemainingThirtyDayBucketHierarchy.sevenDayBucket\",        \"daysRemainingThirtyDayBucketHierarchy.thirtyDayBucket\",        \"dueDateHierarchy.calendarDate\",        \"dueDateHierarchy.calendarMonthId\",        \"dueDateHierarchy.calendarWeekId\",        \"dueDateHierarchy.dayName\",        \"dueDateHierarchy.dayOfWeek\",        \"dynamicDiscountAvailableHierarchy.discountAvailability\",        \"dynamicDiscountAvailableHierarchy.discountAvailabilityCode\",        \"financingProgramAssignedHierarchy.yesNoIndicator\",        \"financingProgramAssignedHierarchy.yesNoIndicatorCode\",        \"invoiceApprovalStatusHierarchy.invoiceApprovalStatus\",        \"invoiceApprovalStatusHierarchy.invoiceApprovalStatusCode\",        \"invoiceCurrencyHierarchy.currencyCode\",        \"invoiceCurrencyHierarchy.currencyName\",        \"invoiceCurrencyHierarchy.enabledFlag\",        \"invoiceInstallmentOnHoldHierarchy.installmentOnHold\",        \"invoiceInstallmentOnHoldHierarchy.installmentOnHoldCode\",        \"invoiceValidationStatusHierarchy.invoiceValidationStatus\",        \"invoiceValidationStatusHierarchy.invoiceValidationStatusCode\",        \"invoiceValidationStatusHierarchy.invoiceValidationStatusType\",        \"legalEntityHierarchy.ledgerCurrCode\",        \"legalEntityHierarchy.legalEntityCountryCode\",        \"legalEntityHierarchy.legalEntityId\",        \"legalEntityHierarchy.legalEntityIdentifier\",        \"legalEntityHierarchy.legalEntityName\",        \"overdueIndicatorHierarchy.overdue\",        \"overdueIndicatorHierarchy.overdueCode\",        \"payablesInvoiceSourceHierarchy.invoiceSource\",        \"payablesInvoiceSourceHierarchy.invoiceSourceCode\",        \"payablesInvoiceTypeHierarchy.invoiceType\",        \"payablesInvoiceTypeHierarchy.invoiceTypeCode\",        \"payablesPaymentTermHierarchy.estimatedPaymentDueDays\",        \"payablesPaymentTermHierarchy.paymentTerm\",        \"paymentDiscountAvailableHierarchy.discountAvailability\",        \"paymentDiscountAvailableHierarchy.discountAvailabilityCode\",        \"paymentMethodHierarchy.paymentMethodCode\",        \"paymentMethodHierarchy.paymentMethodName\",        \"selectedForPaymentHierarchy.yesNoIndicator\",        \"selectedForPaymentHierarchy.yesNoIndicatorCode\",        \"supplierHierarchy.paymentTermId\",        \"supplierHierarchy.supplierId\",        \"supplierHierarchy.supplierName\",        \"supplierHierarchy.supplierNumber\",        \"supplierHierarchy.supplierSiteId\",        \"supplierHierarchy.supplierSiteName\",        \"supplierHierarchy.supplierType\",        \"supplierHierarchy.supplierTypeMeaning\",        \"supplierTypeHierarchy.paymentTermId\",        \"supplierTypeHierarchy.supplierId\",        \"supplierTypeHierarchy.supplierName\",        \"supplierTypeHierarchy.supplierNumber\",        \"supplierTypeHierarchy.supplierSiteId\",        \"supplierTypeHierarchy.supplierSiteName\",        \"supplierTypeHierarchy.supplierType\",        \"supplierTypeHierarchy.supplierTypeMeaning\"      ],      \"filterConditions\": [        {          \"name\": \"dueDateHierarchy.calendarDate\",          \"attribute\": \"dueDateHierarchy.calendarDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for tomorrow, next week, the next 48 hours, overdue, or another due-date window.\"        },        {          \"name\": \"businessUnitHierarchy.businessUnitName\",          \"attribute\": \"businessUnitHierarchy.businessUnitName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user wants the cash requirement or outstanding balance grouped or filtered by business unit.\"        },        {          \"name\": \"supplierHierarchy.supplierName\",          \"attribute\": \"supplierHierarchy.supplierName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes upcoming balances or discount opportunities to a supplier.\"        },        {          \"name\": \"payablesInvoiceTypeHierarchy.invoiceTypeCode\",          \"attribute\": \"payablesInvoiceTypeHierarchy.invoiceTypeCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"STANDARD\",            \"PREPAYMENT\",            \"CREDIT MEMO\",            \"DEBIT MEMO\"          ],          \"usage\": \"Use when the user asks for a specific invoice or document type, including credit memos, prepayments, debit memos, or standard invoices. Credit-memo availability must filter this attribute to CREDIT MEMO.\"        },        {          \"name\": \"supplierTypeHierarchy.supplierTypeMeaning\",          \"attribute\": \"supplierTypeHierarchy.supplierTypeMeaning\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for supplier-type rollups of open balances or overdue exposure.\"        },        {          \"name\": \"invoiceCurrencyHierarchy.currencyCode\",          \"attribute\": \"invoiceCurrencyHierarchy.currencyCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user wants the liability or discount exposure in a specific invoice currency.\"        },        {          \"name\": \"overdueIndicatorHierarchy.overdueCode\",          \"attribute\": \"overdueIndicatorHierarchy.overdueCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks to separate overdue installments from not-yet-due exposure.\"        },        {          \"name\": \"agingBucketHierarchy.daysLateCode\",          \"attribute\": \"agingBucketHierarchy.daysLateCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user wants aging-bucket breakdowns for overdue balances.\"        },        {          \"name\": \"paymentDiscountAvailableHierarchy.discountAvailabilityCode\",          \"attribute\": \"paymentDiscountAvailableHierarchy.discountAvailabilityCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for installments where payment-term discounts are available.\"        },        {          \"name\": \"dynamicDiscountAvailableHierarchy.discountAvailabilityCode\",          \"attribute\": \"dynamicDiscountAvailableHierarchy.discountAvailabilityCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for installments with dynamic-discount opportunities.\"        },        {          \"name\": \"financingProgramAssignedHierarchy.yesNoIndicatorCode\",          \"attribute\": \"financingProgramAssignedHierarchy.yesNoIndicatorCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"Y\",            \"N\"          ],          \"usage\": \"Use when the user asks to isolate balances that are or are not associated with a financing program.\"        },        {          \"name\": \"selectedForPaymentHierarchy.yesNoIndicatorCode\",          \"attribute\": \"selectedForPaymentHierarchy.yesNoIndicatorCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"Y\",            \"N\"          ],          \"usage\": \"Use when the user wants to understand whether balances are already marked for payment.\"        },        {          \"name\": \"invoicePaymentStatusHierarchy.invoicePaymentStatusCode\",          \"attribute\": \"invoicePaymentStatusHierarchy.invoicePaymentStatusCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for unpaid, partially paid, or otherwise payment-status-specific balances.\"        },        {          \"name\": \"paymentMethodHierarchy.paymentMethodCode\",          \"attribute\": \"paymentMethodHierarchy.paymentMethodCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for upcoming balances or discount exposure by payment method.\"        },        {          \"name\": \"daysRemainingThirtyDayBucketHierarchy.thirtyDayBucket\",          \"attribute\": \"daysRemainingThirtyDayBucketHierarchy.thirtyDayBucket\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user wants due-soon balances bucketed into coarse time windows.\"        },        {          \"name\": \"amountRemaining\",          \"attribute\": \"amountRemaining\",          \"type\": \"number\",          \"possibleValues\": [],          \"isAVMeasure\": true,          \"usage\": \"Use when the user asks for balances above an amount threshold before discounts.\"        },        {          \"name\": \"invoiceRemainingAmount\",          \"attribute\": \"invoiceRemainingAmount\",          \"type\": \"number\",          \"possibleValues\": [],          \"isAVMeasure\": true,          \"usage\": \"Use when the user asks for cash requirement after payment-term discounts or wants material balances only.\"        }      ],      \"dateFilterGuidance\": {        \"description\": \"Use `dueDateHierarchy.calendarDate` as the default time axis for upcoming-payment, due-soon, and overdue exposure analysis. Example: dueDateHierarchy[calendarDate='2026-05-22']\",        \"patterns\": [          {            \"userRequest\": \"tomorrow, next week, next 48 hours, overdue\",            \"clause\": \"apply the date window to dueDateHierarchy.calendarDate\"          }        ]      },      \"extractionQuery\": null,      \"businessDrivers\": [        {          \"name\": \"upcomingInstallmentsByDateWindow\",          \"description\": \"Summarize upcoming open installments and balances for a due-date window.\",          \"when\": \"User asks what is due tomorrow, next week, or in the next N hours or days.\",          \"fieldsToReturn\": [            \"invoiceRemainingAmount\",            \"amountRemaining\",            \"countInstallments\",            \"dueDateHierarchy\",            \"businessUnitHierarchy\",            \"supplierHierarchy\",            \"invoiceCurrencyHierarchy\"          ],          \"extraFilterExpressions\": [            \"invoiceRemainingAmount>0\"          ],          \"notes\": \"Use dueDateHierarchy.calendarDate for the requested window and group externally as needed. Example: dueDateHierarchy[calendarDate='2026-05-22']\"        },        {          \"name\": \"cashRequirementByBusinessUnit\",          \"description\": \"Summarize near-term cash requirement across business units.\",          \"when\": \"User asks for the total value of installments due in the next 48 hours or another near-term window across business units.\",          \"fieldsToReturn\": [            \"invoiceRemainingAmount\",            \"countInstallments\",            \"businessUnitHierarchy\",            \"dueDateHierarchy\",            \"invoiceCurrencyHierarchy\"          ],          \"extraFilterExpressions\": [            \"invoiceRemainingAmount>0\"          ],          \"notes\": \"Prefer invoiceRemainingAmount when the user wants the net cash requirement after payment-term discounts.\"        },        {          \"name\": \"discountOpportunityBySupplier\",          \"description\": \"Summarize open discount opportunities by supplier and due date.\",          \"when\": \"User asks for installments eligible for early-payment or dynamic-discount savings this week or in another short window.\",          \"fieldsToReturn\": [            \"paymentTermDiscountAmount\",            \"dynamicDiscountAmount\",            \"countInstallments\",            \"supplierHierarchy\",            \"dueDateHierarchy\",            \"paymentDiscountAvailableHierarchy\",            \"dynamicDiscountAvailableHierarchy\"          ],          \"extraFilterExpressions\": [            \"invoiceRemainingAmount>0\"          ],          \"notes\": \"Use invoiceInstallmentDetails for row-level installments, accepted-offer timestamps, or exact discount-date windows.\"        },        {          \"name\": \"creditMemoAvailabilityBySupplier\",          \"description\": \"Summarize available credit-memo balances by supplier, currency, and aging.\",          \"when\": \"User asks for credit memos, available credits, unapplied credits, or credit-memo offsets for a supplier or planning scope.\",          \"fieldsToReturn\": [            \"invoiceRemainingAmount\",            \"amountRemaining\",            \"countInstallments\",            \"supplierHierarchy\",            \"payablesInvoiceTypeHierarchy\",            \"agingBucketHierarchy\",            \"dueDateHierarchy\",            \"invoiceCurrencyHierarchy\"          ],          \"filters\": [            {              \"attribute\": \"payablesInvoiceTypeHierarchy.invoiceTypeCode\",              \"operator\": \"=\",              \"valueFromUser\": \"CREDIT MEMO\",              \"notes\": \"Required semantic filter for credit-memo availability.\"            }          ],          \"extraFilterExpressions\": [            \"payablesInvoiceTypeHierarchy.invoiceTypeCode='CREDIT MEMO'\",            \"invoiceRemainingAmount!=0\"          ],          \"notes\": \"Credit memo wording is an invoice-type constraint, not just a display preference. Apply the supplier filter when a supplier is named, and keep invoice currency in the returned fields when amount measures are selected.\"        },        {          \"name\": \"exactTotalCashRequirementForTomorrowByCurrency\",          \"description\": \"Return the total net cash requirement for payables installments due tomorrow, grouped by invoice currency.\",          \"when\": \"User asks: What is the total cash requirement for tomorrow?\",          \"fieldsToReturn\": [            \"invoiceRemainingAmount\",            \"invoiceCurrencyHierarchy.currencyCode\"          ],          \"extraFilterExpressions\": [            \"$filterfact=dueDateHierarchy[calendarDate='<current calendar date plus exactly one day>']\",            \"$filter=dueDateHierarchy.$levelName='CALENDARDATE' AND invoiceCurrencyHierarchy.$levelName='CURRENCYCODE'\",            \"sortBy: invoiceCurrencyHierarchy.currencyCode:asc\",            \"limit: 20\"          ],          \"notes\": \"For 'tomorrow', resolve current calendar date + exactly one calendar day. Sort by invoiceCurrencyHierarchy.currencyCode asc before applying limit 20. Preserve fields invoiceRemainingAmount and invoiceCurrencyHierarchy.currencyCode.\"        },        {          \"name\": \"overdueAgingExposure\",          \"description\": \"Summarize overdue balances by aging bucket, supplier, or supplier type.\",          \"when\": \"User asks how many installments are overdue, which buckets carry the most exposure, or which supplier types are most impacted.\",          \"fieldsToReturn\": [            \"invoiceRemainingAmount\",            \"amountRemaining\",            \"countInstallments\",            \"agingBucketHierarchy\",            \"overdueIndicatorHierarchy\",            \"supplierHierarchy\",            \"supplierTypeHierarchy\"          ],          \"extraFilterExpressions\": [            \"invoiceRemainingAmount>0\"          ],          \"notes\": \"Prefer agingBucketHierarchy and overdueIndicatorHierarchy together for overdue analysis.\"        },        {          \"name\": \"creditMemo\",          \"description\": \"Get the total credit memos for Supplier \",          \"when\": \"User can ask for the total credit memos for Supplier <supplier value> \",          \"fieldsToReturn\": [            \"invoiceRemainingAmount\",            \"amountRemaining\",            \"countInstallments\",            \"supplierHierarchy\"          ],          \"extraFilterExpressions\": [            \"supplierHierarchy.supplierName=<supplier value>\",            \"payablesInvoiceTypeHierarchy.invoiceTypeCode='CREDIT MEMO'\"          ],          \"notes\": \"Prefer agingBucketHierarchy and overdueIndicatorHierarchy together for overdue analysis.\"        },        {          \"name\": \"installmentsOverDue\",          \"description\": \"Get the installments overdue\",          \"when\": \"User can ask for  installments  overdue by more than 30 days \",          \"fieldsToReturn\": [            \"invoiceRemainingAmount\",            \"amountRemaining\",            \"countInstallments\",            \"supplierHierarchy\"          ],          \"extraFilterExpressions\": [            \"agingBucketHierarchy.daysLateCode IN ('DAYS_LATE_31-60','DAYS_LATE_61-90','DAYS_LATE_90+')\"          ],          \"notes\": \"Uses the Days Late aging bucket to retrieve the installments late more than 30 days.\"        }      ],      \"additionalInstructions\": [        \"Use this AV for grouped open-balance and cash-requirement analysis. It does not expose invoice number, installment number, financing-offer response date, or direct payment process request context.\",        \"For credit-memo, available-credit, or unapplied-credit questions, apply payablesInvoiceTypeHierarchy.invoiceTypeCode = 'CREDIT MEMO' whenever this shape is selected.\",        \"Use invoiceInstallmentDetails when the user needs row-level pending installments, exact discount dates, hold reasons, or supplier-offer acceptance timing.\",        \"Use selectedPaymentInstallments or paymentRunInstallments when the user asks about a specific PPR or wants the currently selected or funded slice rather than the general open-balance population.\",        \"`invoiceRemainingAmount` is the net outstanding amount after payment-term discount; `amountRemaining` is the unpaid amount before that adjustment.\",        \"For date filters, use the relevant date hierarchy and the date context from the user's request.\",        \"Treat business-driver filters as the required semantic core, not a closed-form query. When the user adds explicit constraints such as date or date range, PPR name/id, supplier, business unit, currency, amount, status, payment method, bank account, or payment file, add those filters when the selected shape exposes the field. A user-provided date filter overrides the default recency window. Do not drop required status, null-rate, source-shape, or sorting rules unless the user explicitly asks for a different lifecycle/source and the selected shape supports it.\",        \"Cash requirement by currency must sort by invoiceCurrencyHierarchy.currencyCode asc before limit 20 unless the user requests top amounts.\"      ],      \"fieldSelectionRuleUsage\": {        \"match\": \"Choose the closest questionExamples entry for the user request.\",        \"fields\": \"Use the matching fields value exactly and preserve order.\",        \"paraphrases\": \"Use the same fields for paraphrased or equivalent requests.\",        \"addFieldsOnlyWhen\": \"The user explicitly asks for more displayed columns, or the field is required for filter, sort, group, key, or deeplink handling.\"      },      \"fieldSelectionRules\": [        {          \"questionExamples\": [            \"What is the total cash requirement for tomorrow?\"          ],          \"queryType\": \"AV\",          \"fields\": \"invoiceRemainingAmount,invoiceCurrencyHierarchy.currencyCode\",          \"fieldOrderLocked\": true        },        {          \"questionExamples\": [            \"Show me the credit memos for supplier 'Advanced Network Devices'?\",            \"Show me the credit memos for supplier <SUPPLIER_NAME>\"          ],          \"queryType\": \"AV\",          \"shape\": \"payablesBalances\",          \"fields\": \"invoiceRemainingAmount,amountRemaining,countInstallments,supplierHierarchy.supplierName,payablesInvoiceTypeHierarchy.invoiceTypeCode,agingBucketHierarchy.daysLateCode,dueDateHierarchy.calendarDate,invoiceCurrencyHierarchy.currencyCode\",          \"filterfact\": \"supplierHierarchy[supplierName='<SUPPLIER_NAME_FROM_USER>'] AND payablesInvoiceTypeHierarchy[invoiceTypeCode='CREDIT MEMO']\",          \"filter\": \"supplierHierarchy.$levelName='SUPPLIERSITE' AND payablesInvoiceTypeHierarchy.$levelName='INVOICETYPECODE' AND agingBucketHierarchy.$levelName='DAYSLATECODE' AND dueDateHierarchy.$levelName='DAY' AND invoiceCurrencyHierarchy.$levelName='CURRENCYCODE'\",          \"sortBy\": \"amountRemaining:desc\",          \"fieldOrderLocked\": true,          \"notes\": \"Simple supplier credit memo lookup is supported. Use payablesBalances AV and do not return unsupported for this question.\"        }      ]    },    \"payablesPaymentScheduleDetailExtraction\": {      \"key\": \"payablesPaymentScheduleDetailExtraction\",      \"name\": \"payablesPaymentScheduleDetailExtraction\",      \"type\": \"EXTRACTION\",      \"module\": \"oraErpCorePayablesInvoices\",      \"businessObject\": \"PayablesInvoiceInstallment\",      \"description\": \"Runtime extraction wrapper for the invoiceInstallmentDetails BV. Use this BV shape primarily for summary queries about invoice installment schedules before or outside a payment run, such as due-date exposure, unpaid amount rollups, hold concentration, discount-window opportunity, currency mismatch, or payment-method mix before drilling into individual installments.\",      \"exampleQuestions\": [        \"What are the pending installments for Invoice 123 and when are they due?\",        \"Find all installments where early payment discounts are available if paid within 5 days, and calculate the total discount amount I'd save\",        \"How many installments are on hold for this supplier by hold reason?\",        \"Show me installments by payment method and payment mode for this invoice\",        \"Which installments are tied to payment process request kp6aug2503?\",        \"Show me installments where the payment currency differs from the invoice currency before selection\"      ],      \"fields\": {        \"fields\": [          \"invoiceId\",          \"installmentNumber\",          \"onHoldFlag\",          \"dueDate\",          \"unpaidAmount\",          \"firstDiscountDate\",          \"firstDiscountAmount\",          \"secondDiscountDate\",          \"secondDiscountAmount\",          \"thirdDiscountDate\",          \"thirdDiscountAmount\",          \"installmentAmount\",          \"invoiceCurrencyGrossAmount\",          \"invoiceToPaymentConversionRate\",          \"paymentPriority\",          \"remitToAddressName\",          \"remitToSupplierName\",          \"holdDate\",          \"holdReason\",          \"discountAPR\",          \"discountAmountRemaining\",          \"invoiceNumber\",          \"invoiceDate\",          \"invoiceCurrencyCurrencyCode\",          \"paymentCurrencyCurrencyCode\",          \"supplierSiteName\",          \"paymentTerm\",          \"termId\",          \"businessUnitName\",          \"businessUnitId\",          \"paymentStatusCodeLookupCode\",          \"paymentStatusCodeMeaning\",          \"validationStatusLookupCode\",          \"validationStatusMeaning\",          \"approvalStatusLookupCode\",          \"approvalStatusMeaning\",          \"fundsStatusLookupCode\",          \"fundsStatusMeaning\",          \"checkrunId\",          \"checkrunName\",          \"paymentMethodCode\",          \"paymentMethodName\",          \"bank\",          \"alwaysTakeDiscountFlag\",          \"supplierName\",          \"supplierId\",          \"legalEntityName\",          \"legalEntityId\",          \"payDateBasisLookupCode\",          \"payablesInvoiceType\",          \"paymentModeLookupCode\",          \"paymentModeMeaning\",          \"financingOptionTypeCode\",          \"responseDate\"        ],        \"fieldAlias\": {          \"Invoice Id\": \"invoiceId\",          \"Installment Number\": \"installmentNumber\",          \"On Hold\": \"onHoldFlag\",          \"Due Date\": \"dueDate\",          \"Unpaid Amount\": \"unpaidAmount\",          \"First Discount Date\": \"firstDiscountDate\",          \"First Discount Amount\": \"firstDiscountAmount\",          \"Second Discount Date\": \"secondDiscountDate\",          \"Second Discount Amount\": \"secondDiscountAmount\",          \"Third Discount Date\": \"thirdDiscountDate\",          \"Third Discount Amount\": \"thirdDiscountAmount\",          \"Installment Amount\": \"installmentAmount\",          \"Invoice Currency Gross Amount\": \"invoiceCurrencyGrossAmount\",          \"Gross Amount\": \"grossAmount\",          \"Invoice To Payment Conversion Rate\": \"invoiceToPaymentConversionRate\",          \"Payment Priority\": \"paymentPriority\",          \"Remit-To Address\": \"remitToAddressName\",          \"Remit-To Supplier\": \"remitToSupplierName\",          \"Hold Date\": \"holdDate\",          \"Hold Reason\": \"holdReason\",          \"Discount APR\": \"discountAPR\",          \"Discount Amount Remaining\": \"discountAmountRemaining\",          \"Invoice Number\": \"invoiceNumber\",          \"Invoice Date\": \"invoiceDate\",          \"Invoice Currency\": \"invoiceCurrencyCurrencyCode\",          \"Currency\": \"invoiceCurrencyCurrencyCode\",          \"Payment Currency\": \"paymentCurrencyCurrencyCode\",          \"Supplier Site\": \"supplierSiteName\",          \"Payment Terms\": \"paymentTerm\",          \"Term Id\": \"termId\",          \"Business Unit\": \"businessUnitName\",          \"Business Unit Id\": \"businessUnitId\",          \"Invoice Payment Status Code\": \"paymentStatusCodeLookupCode\",          \"Invoice Payment Status\": \"paymentStatusCodeMeaning\",          \"Validation Status Code\": \"validationStatusLookupCode\",          \"Validation Status\": \"validationStatusMeaning\",          \"Approval Status Code\": \"approvalStatusLookupCode\",          \"Approval Status\": \"approvalStatusMeaning\",          \"Funds Status Code\": \"fundsStatusLookupCode\",          \"Funds Status\": \"fundsStatusMeaning\",          \"PPR Id\": \"checkrunId\",          \"PPR Name\": \"checkrunName\",          \"Payment Method Code\": \"paymentMethodCode\",          \"Payment Method\": \"paymentMethodName\",          \"Bank\": \"bank\",          \"Supplier\": \"supplierName\",          \"Supplier Id\": \"supplierId\",          \"Legal Entity\": \"legalEntityName\",          \"Legal Entity Id\": \"legalEntityId\",          \"Discount Date\": \"discountDate\",          \"Discount Amount\": \"staticDiscountAmount\",          \"Payables Invoice Type\": \"payablesInvoiceType\",          \"Payment Mode Code\": \"paymentModeLookupCode\",          \"Payment Mode\": \"paymentModeMeaning\",          \"Financing Option Type\": \"financingOptionTypeCode\",          \"Financing Offer Response Date\": \"responseDate\"        }      },      \"supportedFilters\": [        {          \"name\": \"invoiceId\",          \"attribute\": \"invoiceId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user identifies the invoice by internal invoice id.\",          \"valueFromUser\": \"Invoice Id\"        },        {          \"name\": \"invoiceTransaction.invoiceNumber\",          \"attribute\": \"invoiceTransaction.invoiceNumber\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about the pending installments for a specific invoice number.\",          \"valueFromUser\": \"Invoice Number\"        },        {          \"name\": \"installmentNumber\",          \"attribute\": \"installmentNumber\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user drills into a specific installment on an invoice.\",          \"valueFromUser\": \"Installment Number\"        },        {          \"name\": \"dueDate\",          \"attribute\": \"dueDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use for pending, overdue, due-soon, or next-week installment schedule questions.\",          \"valueFromUser\": \"Due Date or date range\"        },        {          \"name\": \"onHoldFlag\",          \"attribute\": \"onHoldFlag\",          \"type\": \"boolean\",          \"possibleValues\": [],          \"usage\": \"Use when the user wants installments on hold or wants hold-related drill-down.\",          \"valueFromUser\": \"On Hold\"        },        {          \"name\": \"holdReason\",          \"attribute\": \"holdReason\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for installments blocked by a specific hold reason.\",          \"valueFromUser\": \"Hold Reason\"        },        {          \"name\": \"remitToSupplierName\",          \"attribute\": \"remitToSupplierName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters installment schedules by supplier or remit-to supplier name.\",          \"valueFromUser\": \"Remit-To Supplier\"        },        {          \"name\": \"firstDiscountDate\",          \"attribute\": \"firstDiscountDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for installments eligible for first discount within a date window.\",          \"valueFromUser\": \"First Discount Date or date range\"        },        {          \"name\": \"discountAmountRemaining\",          \"attribute\": \"discountAmountRemaining\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user wants installments with remaining discount value.\",          \"valueFromUser\": \"Discount Amount Remaining\"        },        {          \"name\": \"paymentPriority\",          \"attribute\": \"paymentPriority\",          \"type\": \"int32\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for high-priority installments.\",          \"valueFromUser\": \"Payment Priority\"        },        {          \"name\": \"invoiceTransaction.invoiceCurrency.currencyCode\",          \"attribute\": \"invoiceTransaction.invoiceCurrency.currencyCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by invoice currency or compares invoice currency to payment currency.\",          \"valueFromUser\": \"Invoice Currency\"        },        {          \"name\": \"invoiceTransaction.invoiceTypeCode.lookupCode\",          \"attribute\": \"invoiceTransaction.invoiceTypeCode.lookupCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"STANDARD\"          ],          \"usage\": \"Use STANDARD for the default standalone installment drilldown so credit memos and other non-standard invoice types are excluded.\",          \"valueFromUser\": \"Payables Invoice Type\"        },        {          \"name\": \"invoiceTransaction.paymentCurrency.currencyCode\",          \"attribute\": \"invoiceTransaction.paymentCurrency.currencyCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment currency or looks for currency mismatches before selection.\",          \"valueFromUser\": \"Payment Currency\"        },        {          \"name\": \"invoiceToPaymentConversionRate\",          \"attribute\": \"invoiceToPaymentConversionRate\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user wants the invoice-to-payment conversion context for an installment.\",          \"valueFromUser\": \"Invoice To Payment Conversion Rate\"        },        {          \"name\": \"invoiceTransaction.businessUnit.name\",          \"attribute\": \"invoiceTransaction.businessUnit.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes installment schedules to one business unit.\",          \"valueFromUser\": \"Business Unit\"        },        {          \"name\": \"invoiceTransaction.businessUnit.id\",          \"attribute\": \"invoiceTransaction.businessUnit.id\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the business unit is resolved to an internal id.\",          \"valueFromUser\": \"Business Unit Id\"        },        {          \"name\": \"invoiceTransaction.legalEntity.legalEntityId\",          \"attribute\": \"invoiceTransaction.legalEntity.legalEntityId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes installment schedules to one legal entity.\",          \"valueFromUser\": \"Legal Entity Id\"        },        {          \"name\": \"paymentProcessRequest.checkrunId\",          \"attribute\": \"paymentProcessRequest.checkrunId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks which installment schedules are already tied to a specific payment process request id.\",          \"valueFromUser\": \"PPR Id\"        },        {          \"name\": \"paymentProcessRequest.checkrunName\",          \"attribute\": \"paymentProcessRequest.checkrunName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks which installment schedules are already tied to a specific payment process request name.\",          \"valueFromUser\": \"PPR Name\"        },        {          \"name\": \"paymentMethod.code\",          \"attribute\": \"paymentMethod.code\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about installment schedules for a payment method.\",          \"valueFromUser\": \"Payment Method Code\"        },        {          \"name\": \"paymentMethod.paymentMethodName\",          \"attribute\": \"paymentMethod.paymentMethodName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about installment schedules by the readable payment method name.\",          \"valueFromUser\": \"Payment Method\"        },        {          \"name\": \"paymentMethod.paymentMode.lookupCode\",          \"attribute\": \"paymentMethod.paymentMode.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user distinguishes installment schedules by payment mode.\",          \"valueFromUser\": \"Payment Mode Code\"        },        {          \"name\": \"invoiceTransaction.paymentTerm.termId\",          \"attribute\": \"invoiceTransaction.paymentTerm.termId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters installment schedules by payment term.\",          \"valueFromUser\": \"Payment Term Id\"        },        {          \"name\": \"invoiceTransaction<Invoice>.supplier.supplierId\",          \"attribute\": \"invoiceTransaction<Invoice>.supplier.supplierId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the supplier is resolved to an internal supplier id.\",          \"valueFromUser\": \"Supplier Id\"        },        {          \"name\": \"invoiceTransaction<Invoice>.supplier.name\",          \"attribute\": \"invoiceTransaction<Invoice>.supplier.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for installment schedules for one supplier.\",          \"valueFromUser\": \"Supplier\"        },        {          \"name\": \"invoiceTransaction<Invoice>.supplierSite.name\",          \"attribute\": \"invoiceTransaction<Invoice>.supplierSite.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes the schedule to a specific supplier site.\",          \"valueFromUser\": \"Supplier Site\"        },        {          \"name\": \"unpaidAmount\",          \"attribute\": \"unpaidAmount\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for installment schedules above an unpaid-amount threshold.\",          \"valueFromUser\": \"Unpaid Amount\"        },        {          \"name\": \"invoiceTransaction<Invoice>.supplier.supplierType.lookupCode\",          \"attribute\": \"invoiceTransaction<Invoice>.supplier.supplierType.lookupCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"ATTORNEY\",            \"CONTRACTOR\",            \"FEDERAL\",            \"GOVERNMENT\",            \"INSURANCE\",            \"Internal\",            \"MANUFACTURING\",            \"PCF_Supplier_Type1\",            \"PCF_Supplier_Type2\",            \"PCF_Supplier_Type3\",            \"PCF_Supplier_Type4\",            \"PCF_Supplier_Type5\",            \"POZ TEST SUPPLIER TYPE\",            \"PUBLIC SECTOR COMPANIES\",            \"SERVICES\",            \"SUB-CONTRACTOR\",            \"SUPPLIER\",            \"TAX AUTHORITY\",            \"TRANSPORTADOR\",            \"TRUST\",            \"UTILITY\"          ],          \"usage\": \"Use when the user asks for installment schedules scoped to a seeded supplier type.\",          \"valueFromUser\": \"Supplier Type Code\"        },        {          \"name\": \"invoiceTransaction.validationStatus.lookupCode\",          \"attribute\": \"invoiceTransaction.validationStatus.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters installment schedules by invoice validation status.\",          \"valueFromUser\": \"Validation Status Code\"        },        {          \"name\": \"invoiceTransaction.approvalStatus.lookupCode\",          \"attribute\": \"invoiceTransaction.approvalStatus.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters installment schedules by invoice approval status.\",          \"valueFromUser\": \"Approval Status Code\"        }      ],      \"dateFilterGuidance\": {        \"description\": \"Use dueDate for pending or upcoming installment schedule questions. If you reference dueDate, convert it to a date string with TO_CHAR(dueDate, 'YYYY-MM-DD') because dueDate is a DATE/TIMESTAMP value. \\n For discount-window questions, compare the requested horizon against firstDiscountDate, secondDiscountDate, and thirdDiscountDate in the outer query.\",        \"patterns\": [          {            \"userRequest\": \"no date or time range specified for a discovery request\",            \"clause\": \"<date_column> >= TRUNC(SYSDATE) - 30\"          },          {            \"userRequest\": \"last <N> days\",            \"example\": \"last 7 days\",            \"clause\": \"<date_column> >= TRUNC(SYSDATE) - <N>\"          },          {            \"userRequest\": \"last <N> months\",            \"example\": \"last 2 months\",            \"clause\": \"<date_column> >= ADD_MONTHS(TRUNC(SYSDATE), -<N>)\"          },          {            \"userRequest\": \"between <start> and <end>\",            \"example\": \"between 2026-03-01 and 2026-03-31\",            \"clause\": \"<date_column> >= TO_DATE('<start_date>','YYYY-MM-DD') and <date_column> <= TO_DATE('<end_date>','YYYY-MM-DD')\"          }        ]      },      \"extractionQuery\": {        \"viewQueries\": {          \"payablesPaymentScheduleDetail\": {            \"module\": \"oraErpCorePayablesInvoices\",            \"businessObject\": \"PayablesInvoiceInstallment\",            \"view\": \"payablesPaymentScheduleDetail\",            \"fieldAliases\": {              \"invoiceId\": \"invoiceId\",              \"installmentNumber\": \"installmentNumber\",              \"onHoldFlag\": \"onHoldFlag\",              \"dueDate\": \"dueDate\",              \"unpaidAmount\": \"unpaidAmount\",              \"firstDiscountDate\": \"firstDiscountDate\",              \"firstDiscountAmount\": \"firstDiscountAmount\",              \"secondDiscountDate\": \"secondDiscountDate\",              \"secondDiscountAmount\": \"secondDiscountAmount\",              \"thirdDiscountDate\": \"thirdDiscountDate\",              \"thirdDiscountAmount\": \"thirdDiscountAmount\",              \"installmentAmount\": \"installmentAmount\",              \"invoiceCurrencyGrossAmount\": \"invoiceCurrencyGrossAmount\",              \"invoiceToPaymentConversionRate\": \"invoiceToPaymentConversionRate\",              \"paymentPriority\": \"paymentPriority\",              \"remitToAddressName\": \"remitToAddressName\",              \"remitToSupplierName\": \"remitToSupplierName\",              \"holdDate\": \"holdDate\",              \"holdReason\": \"holdReason\",              \"discountAPR\": \"discountAPR\",              \"discountAmountRemaining\": \"discountAmountRemaining\",              \"invoiceTransaction.invoiceNumber\": \"invoiceNumber\",              \"invoiceTransaction.invoiceDate\": \"invoiceDate\",              \"invoiceTransaction.invoiceCurrency.currencyCode\": \"invoiceCurrencyCurrencyCode\",              \"invoiceTransaction.paymentCurrency.currencyCode\": \"paymentCurrencyCurrencyCode\",              \"invoiceTransaction<Invoice>.supplierSite.name\": \"supplierSiteName\",              \"invoiceTransaction.paymentTerm.paymentTerm\": \"paymentTerm\",              \"invoiceTransaction.paymentTerm.termId\": \"termId\",              \"invoiceTransaction.businessUnit.name\": \"businessUnitName\",              \"invoiceTransaction.businessUnit.id\": \"businessUnitId\",              \"invoiceTransaction.paymentStatusCode.lookupCode\": \"paymentStatusCodeLookupCode\",              \"invoiceTransaction.paymentStatusCode.meaning\": \"paymentStatusCodeMeaning\",              \"invoiceTransaction.validationStatus.lookupCode\": \"validationStatusLookupCode\",              \"invoiceTransaction.validationStatus.meaning\": \"validationStatusMeaning\",              \"invoiceTransaction.approvalStatus.lookupCode\": \"approvalStatusLookupCode\",              \"invoiceTransaction.approvalStatus.meaning\": \"approvalStatusMeaning\",              \"invoiceTransaction.fundsStatus.lookupCode\": \"fundsStatusLookupCode\",              \"invoiceTransaction.fundsStatus.meaning\": \"fundsStatusMeaning\",              \"paymentProcessRequest.checkrunId\": \"checkrunId\",              \"paymentProcessRequest.checkrunName\": \"checkrunName\",              \"paymentMethod.code\": \"paymentMethodCode\",              \"paymentMethod.paymentMethodName\": \"paymentMethodName\",              \"externalBankAccount.maskedAccountNumber\": \"bank\",              \"invoiceTransaction<Invoice>.supplierSite.alwaysTakeDiscount\": \"alwaysTakeDiscountFlag\",              \"invoiceTransaction<Invoice>.supplier.name\": \"supplierName\",              \"invoiceTransaction<Invoice>.supplier.supplierId\": \"supplierId\",              \"invoiceTransaction.legalEntity.legalEntityName\": \"legalEntityName\",              \"invoiceTransaction.legalEntity.legalEntityId\": \"legalEntityId\",              \"invoiceTransaction<Invoice>.supplierSite.payDateBasisCode\": \"payDateBasisLookupCode\",              \"invoiceTransaction.invoiceTypeCode.lookupCode\": \"payablesInvoiceType\",              \"paymentMethod.paymentMode.lookupCode\": \"paymentModeLookupCode\",              \"paymentMethod.paymentMode.meaning\": \"paymentModeMeaning\",              \"financeProgram.financingOptionTypeCode\": \"financingOptionTypeCode\",              \"financeProgramOffer.responseDate\": \"responseDate\"            }          }        },        \"select\": \"{select_statement}\"      },      \"businessDrivers\": [        {          \"name\": \"installmentDrilldownDefault\",          \"description\": \"Retrieve standalone invoice installment drilldown rows for a supplier, business unit, and invoice currency.\",          \"when\": \"User asks for installment drilldown or installment details outside a specific PPR/payment-run selected, rejected, or failed context.\",          \"fieldsToReturn\": [            \"invoiceNumber\",            \"installmentNumber\",            \"paymentTerm\",            \"bank\",            \"unpaidAmount\",            \"invoiceCurrencyCurrencyCode\",            \"discountDate\",            \"paymentMethodName\",            \"staticDiscountAmount\",            \"dueDate\"          ],          \"extraFilterExpressions\": [            \"businessUnitId=<BUSINESS_UNIT_ID> or businessUnitName='<BUSINESS_UNIT_NAME>'\",            \"invoiceCurrencyCurrencyCode='<INVOICE_CURRENCY_CODE>'\",            \"supplierId=<SUPPLIER_ID> or supplierName='<SUPPLIER_NAME>'\",            \"legalEntityId=<LEGAL_ENTITY_ID> when legal entity is provided\",            \"termId=<PAYMENT_TERM_ID> when payment terms are provided\",            \"payablesInvoiceType='STANDARD'\"          ],          \"sortBy\": [            {              \"attribute\": \"unpaidAmount\",              \"direction\": \"desc\"            }          ],          \"notes\": \"Display Currency from invoiceCurrencyCurrencyCode, aliased as currency in the final SELECT when needed. Compute staticDiscountAmount and discountDate from first, second, and third discount date/amount aliases when discountAPR is null. Apply ORDER BY unpaidAmount DESC in the inner SELECT before the outer ROWNUM<=20 cap.\"        },        {          \"name\": \"pendingInstallmentsByInvoice\",          \"description\": \"Retrieve the pending or upcoming installment schedule for one invoice.\",          \"when\": \"User asks what installments remain for an invoice and when they are due.\",          \"fieldsToReturn\": [            \"invoiceNumber\",            \"installmentNumber\",            \"dueDate\",            \"unpaidAmount\",            \"installmentAmount\",            \"onHoldFlag\",            \"holdReason\"          ],          \"extraFilterExpressions\": [            \"invoiceTransaction.invoiceNumber='<INVOICE_NUMBER_FROM_USER>'\"          ],          \"notes\": \"Add invoiceId when the user provides the internal invoice identifier instead of the invoice number.\"        },        {          \"name\": \"discountEligibleSoon\",          \"description\": \"Find installment schedules with available early-payment discounts inside a requested horizon.\",          \"when\": \"User asks for installments with discounts available within the next few days and wants the savings amount.\",          \"fieldsToReturn\": [            \"invoiceNumber\",            \"installmentNumber\",            \"dueDate\",            \"firstDiscountDate\",            \"firstDiscountAmount\",            \"secondDiscountDate\",            \"secondDiscountAmount\",            \"thirdDiscountDate\",            \"thirdDiscountAmount\",            \"discountAmountRemaining\",            \"remitToSupplierName\"          ],          \"extraFilterExpressions\": [            \"one of firstDiscountDate, secondDiscountDate, or thirdDiscountDate falls within the requested date window\",            \"discountAmountRemaining>0\"          ],          \"notes\": \"Calculate the total savings by summing the discount amount associated with the discount date that matches the requested window. When `discountAPR` is null, apply the seeded static-discount logic driven by `invoiceTransaction<Invoice>.supplierSite.alwaysTakeDiscount` and `invoiceTransaction<Invoice>.supplierSite.payDateBasisCode`.\"        },        {          \"name\": \"installmentsOnHoldOrBlocked\",          \"description\": \"Review installment schedules blocked by holds or invoice status conditions.\",          \"when\": \"User asks which installments are on hold, blocked, or otherwise not ready for payment scheduling.\",          \"fieldsToReturn\": [            \"invoiceNumber\",            \"installmentNumber\",            \"dueDate\",            \"onHoldFlag\",            \"holdDate\",            \"holdReason\",            \"validationStatusMeaning\",            \"approvalStatusMeaning\",            \"fundsStatusMeaning\"          ],          \"extraFilterExpressions\": [            \"onHoldFlag = 'Y' or holdReason is not null\"          ],          \"notes\": \"Use the status lookups to explain whether the block is a hold, validation condition, approval state, or funds state.\"        },        {          \"name\": \"installmentScheduleBySupplier\",          \"description\": \"Retrieve the installment schedule for a supplier or remit-to supplier before payment-run selection.\",          \"when\": \"User asks for the pending installments for one supplier and their due dates.\",          \"fieldsToReturn\": [            \"remitToSupplierName\",            \"invoiceNumber\",            \"installmentNumber\",            \"dueDate\",            \"unpaidAmount\",            \"paymentMethodName\",            \"paymentModeMeaning\"          ],          \"extraFilterExpressions\": [            \"remitToSupplierName='<SUPPLIER_NAME_FROM_USER>'\"          ],          \"notes\": \"This is the pre-selection or schedule-detail view. Switch to selectedPaymentInstallments or paymentRunInstallments once the question is about a specific PPR.\"        },        {          \"name\": \"invoicesReadyForPayment\",          \"description\": \"Retrieve the invoices reay for payment.\",          \"when\": \"User asks to Show me all invoices ready for payment\",          \"fieldsToReturn\": [            \"remitToSupplierName\",            \"invoiceTransaction.invoiceNumber\",            \"installmentNumber\",            \"dueDate\",            \"unpaidAmount\",            \"paymentMethod.paymentMethodName\",            \"paymentMethod.paymentMode.meaning\"          ],          \"extraFilterExpressions\": [            \"invoiceTransaction.paymentStatusCode.lookupCode in ('N', 'P') and  onHoldFlag = false\"          ],          \"notes\": \" 'N' denotes Not paid & 'P' denotes Partially paid \"        }      ],      \"additionalInstructions\": [        \"Generate the full SELECT statement and place it into {select_statement} before execution.\",        \"Use viewQueries.payablesPaymentScheduleDetail as the FROM source with alias consistent in the SQL (for example payablesPaymentScheduleDetail).\",        \"The inner subselect should project all aliases used by the outer SELECT and WHERE.\",        \"Apply supported filters and date filters as needed, using supportedFilters and entity resolution.\",        \"Always limit the outer query to 20 rows using where ROWNUM<=20.\",        \"For installmentDrilldownDefault, select invoiceNumber, installmentNumber, paymentTerm, bank, unpaidAmount, invoiceCurrencyCurrencyCode, discountDate, paymentMethodName, staticDiscountAmount, and dueDate; alias invoiceCurrencyCurrencyCode as currency in the final SELECT when matching the DTC sample output.\",        \"For installmentDrilldownDefault, include payablesInvoiceType='STANDARD' in the inner WHERE clause.\",        \"For installmentDrilldownDefault, include ORDER BY unpaidAmount DESC in the inner SELECT before applying the outer where ROWNUM<=20.\",        \"For installmentDrilldownDefault, compute staticDiscountAmount and discountDate using the first, second, and third discount dates and amounts when discountAPR is null, following the seeded static-discount logic.\",        \"Use this shape for invoice-installment schedule detail before selection or when the question is independent of a specific payment run.\",        \"Use selectedPaymentInstallments or paymentRunInstallments when the user asks for the actual payment amount in a PPR, the formed payment, or the resulting payment file.\",        \"For discount-window questions, evaluate firstDiscountDate, secondDiscountDate, and thirdDiscountDate against the requested horizon and use the matching discount amount column for the savings calculation.\",        \"discountAmountRemaining is the best native indicator of discount value still available on the installment.\",        \"remitToSupplierName is the best user-facing supplier label exposed directly by this view.\",        \"When the source shape requires supplier, supplier-site, or remit-to detail under `invoiceTransaction`, use subtype-expanded paths with the discriminator marker `<Invoice>` such as `invoiceTransaction<Invoice>.supplier.name` instead of `<PayablesInvoice>`.\",        \"For static-discount reasoning when `discountAPR` is null, use `invoiceTransaction<Invoice>.supplierSite.alwaysTakeDiscount`, `invoiceTransaction<Invoice>.supplierSite.payDateBasisCode`, and the matching first, second, or third discount date and amount from the seeded source definition.\",        \"This shape does not expose first-time-supplier indicators or bank-account-validation-complete flags. Those scenarios need additional supplier or payment-instrument sources.\"      ]    },    \"payablesPaymentDetails\": {      \"key\": \"payablesPaymentDetails\",      \"name\": \"payablesPaymentDetails\",      \"type\": \"BV\",      \"shapeRole\": \"detail\",      \"module\": \"oraErpCorePayablesPayments\",      \"businessObject\": \"PayablesPayment\",      \"api\": \"objects/ora/erpCore/payablesPayments/v1/payablesPaymentDetails\",      \"description\": \"Business view for detailed payables payment retrieval, including payment identifiers, amounts, dates, remit-to attributes, supplier and legal entity context, payment process request details, settlement attributes, bank account information, and payment status lookups.\",      \"exampleQuestions\": [        \"Show payment details for payment number 181683\",        \"Find payments for supplier Vision Operations and include payment status, amount, and payment date\",        \"Show payables payments for payment process request PPR_123\",        \"Show tax authority payments in payment process request PPR_123\",        \"List future-dated payments maturing this week\",        \"Which payments are unreconciled, stopped, or voided?\",        \"Show the payment method, payment instrument alias, remit-to supplier, and bank account details for payment 181683\",        \"Show me the payments in this batch and break them down by payment status.\",        \"Show me the payment history for Supplier Y over the last 30 days.\"      ],      \"fields\": {        \"fields\": [          \"paymentId\",          \"futurePayDueDate\",          \"paymentDate\",          \"bankNumber\",          \"internationBankAccountNumber\",          \"paymentAmount\",          \"paymentBaseAmount\",          \"paymentNumber\",          \"actualValueDate\",          \"anticipatedValueDate\",          \"updatedBy\",          \"timeUpdated\",          \"createdBy\",          \"timeCreated\",          \"addressLine1\",          \"addressLine2\",          \"addressLine3\",          \"addressLine4\",          \"addressStyle\",          \"bankChargeBearer\",          \"checkVoucherNumber\",          \"city\",          \"clearingAmount\",          \"clearingBaseAmount\",          \"clearingChargesAmount\",          \"clearingChargesBaseAmount\",          \"clearingDate\",          \"clearingErrorAmount\",          \"clearingErrorBaseAmount\",          \"clearingConversionDate\",          \"clearingConversionRate\",          \"country\",          \"county\",          \"description\",          \"documentCategoryCode\",          \"documentSequenceValue\",          \"employeeAddressCode\",          \"conversionDate\",          \"conversionRate\",          \"logicalGroupReference\",          \"maturityConversionDate\",          \"maturityConversionRate\",          \"positivePayStatusCode\",          \"province\",          \"reconciledFlag\",          \"releasedBy\",          \"releasedDate\",          \"remitToAddressName\",          \"remitToSupplierName\",          \"state\",          \"stoppedBy\",          \"stopDate\",          \"transferPriority\",          \"treasuryPayDate\",          \"treasuryPayNumber\",          \"voidDate\",          \"crossCurrencyRateType\",          \"zip\",          \"bankAccountName\",          \"bankAccountType\"        ],        \"accessors\": {          \"paymentCurrency\": {            \"fields\": [              \"currencyCode\",              \"name\"            ]          },          \"paymentProcessRequest\": {            \"fields\": [              \"checkrunId\",              \"checkrunName\"            ],            \"accessors\": {              \"businessUnit\": {                \"fields\": [                  \"id\"                ]              }            }          },          \"paymentInstrument\": {            \"fields\": [              \"id\",              \"paymentInstrumentAlias\"            ]          },          \"bankAccountBusinessUnitAssignment\": {            \"fields\": [              \"id\"            ],            \"accessors\": {              \"bankAccount\": {                \"fields\": [                  \"id\",                  \"name\",                  \"endDate\",                  \"targetBalance\",                  \"bankExchangeRateType\",                  \"payablesUseAllowedFlag\",                  \"alternateAccountName\",                  \"description\",                  \"bankAccountType\",                  \"maskedBankAccountNumber\",                  \"payrollUseAllowedFlag\"                ],                \"accessors\": {                  \"currency\": {                    \"fields\": [                      \"currencyCode\"                    ]                  },                  \"bank\": {                    \"fields\": [                      \"id\",                      \"name\"                    ]                  },                  \"bankBranch\": {                    \"fields\": [                      \"id\",                      \"name\"                    ]                  }                }              }            }          },          \"supplier\": {            \"fields\": [              \"supplierId\",              \"taxOrganizationType\",              \"businessRelationshipCode\",              \"supplierNumber\",              \"name\",              \"registryId\",              \"id\"            ],            \"accessors\": {              \"alias\": {                \"fields\": [                  \"id\",                  \"name\"                ]              },              \"supplierType\": {                \"fields\": [                  \"lookupCode\",                  \"lookupType\"                ]              }            }          },          \"supplierSite\": {            \"fields\": [              \"id\",              \"name\"            ],            \"accessors\": {              \"address\": {                \"fields\": [                  \"name\",                  \"id\"                ]              }            }          },          \"systemOption\": {            \"fields\": [              \"businessUnitId\"            ],            \"accessors\": {              \"ledger\": {                \"fields\": [                  \"ledgerId\",                  \"name\"                ],                \"accessors\": {                  \"currency\": {                    \"fields\": [                      \"currencyCode\",                      \"precision\"                    ]                  }                }              }            }          },          \"legalEntity\": {            \"fields\": [              \"legalEntityId\",              \"legalEntityName\",              \"legalEntityIdentifier\"            ],            \"accessors\": {              \"geography\": {                \"fields\": [                  \"id\"                ]              }            }          },          \"businessUnit\": {            \"fields\": [              \"id\",              \"effectiveStartDate\",              \"effectiveEndDate\",              \"name\"            ]          },          \"externalBankAccount\": {            \"fields\": [              \"maskedAccountNumber\",              \"maskedIban\",              \"id\"            ]          },          \"paymentSettlementPriority\": {            \"fields\": [              \"lookupType\",              \"meaning\",              \"lookupCode\"            ]          },          \"paymentMethod\": {            \"fields\": [              \"code\",              \"paymentMethodName\"            ]          },          \"paymentMaturityConversionRateType\": {            \"fields\": [              \"conversionRateType\"            ]          },          \"paymentClearingConversionRateType\": {            \"fields\": [              \"conversionRateType\"            ]          },          \"paymentType\": {            \"fields\": [              \"lookupType\",              \"meaning\",              \"lookupCode\"            ]          },          \"paymentRequestor\": {            \"fields\": [              \"name\",              \"registryId\",              \"id\"            ]          },          \"paymentStatus\": {            \"fields\": [              \"lookupCode\",              \"lookupType\",              \"meaning\"            ]          },          \"paymentSystemStatus\": {            \"fields\": [              \"lookupCode\",              \"lookupType\",              \"meaning\"            ]          },          \"accountPaymentProfile\": {            \"fields\": [              \"paymentProfileId\",              \"paymentProfileName\"            ],            \"accessors\": {              \"paymentSystemAccount\": {                \"fields\": [                  \"paymentSystemAccountId\",                  \"paymentSystemAccountName\"                ],                \"accessors\": {                  \"paymentSystem\": {                    \"fields\": [                      \"id\",                      \"paymentSystemName\",                      \"activeStatus\"                    ]                  }                }              },              \"systemPaymentProfile\": {                \"fields\": [                  \"systemProfileCode\"                ],                \"accessors\": {                  \"processingType\": {                    \"fields\": [                      \"lookupType\",                      \"meaning\",                      \"lookupCode\"                    ]                  }                }              }            }          },          \"paymentMode\": {            \"fields\": [              \"lookupCode\",              \"lookupType\",              \"meaning\"            ]          },          \"paymentResponse\": {            \"fields\": [              \"lookupCode\",              \"lookupType\",              \"meaning\"            ]          },          \"paymentsPayment\": {            \"fields\": [              \"paymentId\",              \"stopDate\"            ]          }        },        \"fieldAlias\": {          \"Payment ID\": \"paymentId\",          \"Bank Number\": \"bankNumber\",          \"International Bank Account Number\": \"internationBankAccountNumber\",          \"Payment Number\": \"paymentNumber\",          \"Payment Amount\": \"paymentAmount\",          \"Payment Base Amount\": \"paymentBaseAmount\",          \"Actual Value Date\": \"actualValueDate\",          \"Anticipated Value Date\": \"anticipatedValueDate\",          \"Payment Date\": \"paymentDate\",          \"Created By\": \"createdBy\",          \"Created On\": \"timeCreated\",          \"Last Updated By\": \"updatedBy\",          \"Last Updated On\": \"timeUpdated\",          \"Address Line 1\": \"addressLine1\",          \"Address Line 2\": \"addressLine2\",          \"Address Line 3\": \"addressLine3\",          \"Address Line 4\": \"addressLine4\",          \"Address Style\": \"addressStyle\",          \"Bank Charge Bearer\": \"bankChargeBearer\",          \"Check Voucher Number\": \"checkVoucherNumber\",          \"City\": \"city\",          \"Cleared Date\": \"clearingDate\",          \"Clearing Amount\": \"clearingAmount\",          \"Clearing Base Amount\": \"clearingBaseAmount\",          \"Clearing Charges Amount\": \"clearingChargesAmount\",          \"Clearing Charges Base Amount\": \"clearingChargesBaseAmount\",          \"Clearing Error Amount\": \"clearingErrorAmount\",          \"Clearing Error Base Amount\": \"clearingErrorBaseAmount\",          \"Clearing Conversion Date\": \"clearingConversionDate\",          \"Clearing Conversion Rate\": \"clearingConversionRate\",          \"Country\": \"country\",          \"County\": \"county\",          \"Document Category Code\": \"documentCategoryCode\",          \"Document Sequence Value\": \"documentSequenceValue\",          \"Employee Address Code\": \"employeeAddressCode\",          \"Conversion Date\": \"conversionDate\",          \"Conversion Rate\": \"conversionRate\",          \"Logical Group Reference\": \"logicalGroupReference\",          \"Maturity Date\": \"futurePayDueDate\",          \"Maturity Conversion Date\": \"maturityConversionDate\",          \"Maturity Conversion Rate\": \"maturityConversionRate\",          \"Positive Pay Status Code\": \"positivePayStatusCode\",          \"Province\": \"province\",          \"Released By\": \"releasedBy\",          \"Released Date\": \"releasedDate\",          \"State\": \"state\",          \"Stopped By\": \"stoppedBy\",          \"Void Date\": \"voidDate\",          \"Stop Date\": \"stopDate\",          \"Transfer Priority\": \"transferPriority\",          \"Treasury Pay Date\": \"treasuryPayDate\",          \"Treasury Pay Number\": \"treasuryPayNumber\",          \"Cross Currency Rate Type\": \"crossCurrencyRateType\",          \"ZIP\": \"zip\",          \"Payment Description\": \"description\",          \"Reconciled\": \"reconciledFlag\",          \"Remit-To Address\": \"remitToAddressName\",          \"Remit-To Supplier\": \"remitToSupplierName\",          \"Payment Currency\": \"paymentCurrency.currencyCode\",          \"Payables PPR Id\": \"paymentProcessRequest.checkrunId\",          \"PPR Name\": \"paymentProcessRequest.checkrunName\",          \"Supplier ID\": \"supplier.supplierId\",          \"Supplier Number\": \"supplier.supplierNumber\",          \"Supplier Name\": \"supplier.name\",          \"Supplier Type Code\": \"supplier.supplierType.lookupCode\",          \"Supplier Site\": \"supplierSite.name\",          \"Payment Business Unit ID\": \"businessUnit.id\",          \"Payment Business Unit\": \"businessUnit.name\",          \"Legal Entity ID\": \"legalEntity.legalEntityId\",          \"Legal Entity\": \"legalEntity.legalEntityName\",          \"Legal Entity Identifier\": \"legalEntity.legalEntityIdentifier\",          \"Payment Method Code\": \"paymentMethod.code\",          \"Payment Method\": \"paymentMethod.paymentMethodName\",          \"Payment Status Code\": \"paymentStatus.lookupCode\",          \"Payment Status\": \"paymentStatus.meaning\",          \"Payment System Status Code\": \"paymentSystemStatus.lookupCode\",          \"Payment System Status\": \"paymentSystemStatus.meaning\",          \"Payment Type Code\": \"paymentType.lookupCode\",          \"Payment Type\": \"paymentType.meaning\",          \"Payment Mode Code\": \"paymentMode.lookupCode\",          \"Payment Mode\": \"paymentMode.meaning\",          \"Payment Response Code\": \"paymentResponse.lookupCode\",          \"Payment Response\": \"paymentResponse.meaning\",          \"Payment Instrument Alias\": \"paymentInstrument.paymentInstrumentAlias\",          \"Payment Profile ID\": \"accountPaymentProfile.paymentProfileId\",          \"Payment Profile Name\": \"accountPaymentProfile.paymentProfileName\",          \"Payment System Account\": \"accountPaymentProfile.paymentSystemAccount.paymentSystemAccountName\",          \"Processing Type\": \"accountPaymentProfile.systemPaymentProfile.processingType.meaning\",          \"Payee Bank Account Name\": \"bankAccountName\",          \"Payee Bank Account Type\": \"bankAccountType\",          \"Disbursement Bank Account\": \"bankAccountBusinessUnitAssignment.bankAccount.name\",          \"Disbursement Bank Account Number\": \"bankAccountBusinessUnitAssignment.bankAccount.maskedBankAccountNumber\",          \"External Bank Account\": \"externalBankAccount.maskedAccountNumber\",          \"External IBAN\": \"externalBankAccount.maskedIban\"        }      },      \"fieldSelection\": {        \"base\": [          \"paymentId\",          \"paymentNumber\",          \"paymentAmount\",          \"paymentDate\",          \"clearingDate\",          \"futurePayDueDate\",          \"voidDate\",          \"stopDate\",          \"description\",          \"timeCreated\",          \"remitToAddressName\",          \"reconciledFlag\"        ],        \"optional\": [          \"bankNumber\",          \"internationBankAccountNumber\",          \"paymentBaseAmount\",          \"actualValueDate\",          \"anticipatedValueDate\",          \"updatedBy\",          \"timeUpdated\",          \"createdBy\",          \"addressLine1\",          \"addressLine2\",          \"addressLine3\",          \"addressLine4\",          \"addressStyle\",          \"bankChargeBearer\",          \"checkVoucherNumber\",          \"city\",          \"clearingAmount\",          \"clearingBaseAmount\",          \"clearingChargesAmount\",          \"clearingChargesBaseAmount\",          \"clearingErrorAmount\",          \"clearingErrorBaseAmount\",          \"clearingConversionDate\",          \"clearingConversionRate\",          \"country\",          \"county\",          \"documentCategoryCode\",          \"documentSequenceValue\",          \"employeeAddressCode\",          \"conversionDate\",          \"conversionRate\",          \"logicalGroupReference\",          \"maturityConversionDate\",          \"maturityConversionRate\",          \"positivePayStatusCode\",          \"province\",          \"releasedBy\",          \"releasedDate\",          \"remitToSupplierName\",          \"state\",          \"stoppedBy\",          \"transferPriority\",          \"treasuryPayDate\",          \"treasuryPayNumber\",          \"crossCurrencyRateType\",          \"zip\",          \"bankAccountName\",          \"bankAccountType\"        ]      },      \"sortableAttributes\": [        \"paymentId\",        \"futurePayDueDate\",        \"paymentDate\",        \"paymentAmount\",        \"paymentNumber\",        \"timeCreated\",        \"stopDate\"      ],      \"filterConditions\": [        {          \"name\": \"paymentId\",          \"attribute\": \"paymentId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user gives a payables payment identifier.\"        },        {          \"name\": \"paymentNumber\",          \"attribute\": \"paymentNumber\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user gives a payment or check number.\"        },        {          \"name\": \"paymentDate\",          \"attribute\": \"paymentDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use for payment-date range filters.\"        },        {          \"name\": \"futurePayDueDate\",          \"attribute\": \"futurePayDueDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use for future-dated payment maturity windows.\"        },        {          \"name\": \"clearingDate\",          \"attribute\": \"clearingDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use for cleared payment date filters.\"        },        {          \"name\": \"voidDate\",          \"attribute\": \"voidDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for voided payments.\"        },        {          \"name\": \"stopDate\",          \"attribute\": \"stopDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for stopped payments.\"        },        {          \"name\": \"reconciledFlag\",          \"attribute\": \"reconciledFlag\",          \"type\": \"boolean\",          \"possibleValues\": [            true,            false          ],          \"usage\": \"Use to distinguish reconciled versus unreconciled payments.\"        },        {          \"name\": \"paymentProcessRequest.checkrunId\",          \"attribute\": \"paymentProcessRequest.checkrunId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a payment process request identifier.\"        },        {          \"name\": \"paymentProcessRequest.checkrunName\",          \"attribute\": \"paymentProcessRequest.checkrunName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a payment process request name.\"        },        {          \"name\": \"supplier.supplierId\",          \"attribute\": \"supplier.supplierId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a supplier identifier.\"        },        {          \"name\": \"supplier.supplierNumber\",          \"attribute\": \"supplier.supplierNumber\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a supplier number.\"        },        {          \"name\": \"supplier.name\",          \"attribute\": \"supplier.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by supplier name.\"        },        {          \"name\": \"supplier.supplierType.lookupCode\",          \"attribute\": \"supplier.supplierType.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [            \"TAX AUTHORITY\"          ],          \"usage\": \"Use when the user asks for tax authority payments or otherwise scopes payments by supplier type.\"        },        {          \"name\": \"businessUnit.id\",          \"attribute\": \"businessUnit.id\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a business unit identifier.\"        },        {          \"name\": \"businessUnit.name\",          \"attribute\": \"businessUnit.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by business unit.\"        },        {          \"name\": \"legalEntity.legalEntityId\",          \"attribute\": \"legalEntity.legalEntityId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a legal entity identifier.\"        },        {          \"name\": \"legalEntity.legalEntityName\",          \"attribute\": \"legalEntity.legalEntityName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by legal entity name.\"        },        {          \"name\": \"paymentCurrency.currencyCode\",          \"attribute\": \"paymentCurrency.currencyCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment currency.\"        },        {          \"name\": \"paymentMethod.code\",          \"attribute\": \"paymentMethod.code\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a payment method code.\"        },        {          \"name\": \"paymentMethod.paymentMethodName\",          \"attribute\": \"paymentMethod.paymentMethodName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment method name.\"        },        {          \"name\": \"paymentStatus.lookupCode\",          \"attribute\": \"paymentStatus.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a payment status code.\"        },        {          \"name\": \"paymentStatus.meaning\",          \"attribute\": \"paymentStatus.meaning\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides the display meaning of the payment status.\"        },        {          \"name\": \"paymentSystemStatus.lookupCode\",          \"attribute\": \"paymentSystemStatus.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a payment system status code.\"        },        {          \"name\": \"paymentType.lookupCode\",          \"attribute\": \"paymentType.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment type.\"        },        {          \"name\": \"paymentMode.lookupCode\",          \"attribute\": \"paymentMode.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment mode.\"        },        {          \"name\": \"paymentResponse.lookupCode\",          \"attribute\": \"paymentResponse.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment response code.\"        },        {          \"name\": \"paymentInstrument.paymentInstrumentAlias\",          \"attribute\": \"paymentInstrument.paymentInstrumentAlias\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment instrument alias.\"        },        {          \"name\": \"remitToSupplierName\",          \"attribute\": \"remitToSupplierName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for payment details by remit-to supplier rather than supplier master name.\"        },        {          \"name\": \"bankAccountBusinessUnitAssignment.bankAccount.name\",          \"attribute\": \"bankAccountBusinessUnitAssignment.bankAccount.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks which internal bank account was used for payments.\"        }      ],      \"dateFilterGuidance\": null,      \"extractionQuery\": null,      \"businessDrivers\": [        {          \"name\": \"paymentLookupByIdOrNumber\",          \"description\": \"Retrieve one or more payments when the user provides a payment identifier or payment number.\",          \"when\": \"User asks for a specific payment, check, or payment number.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentNumber\",            \"paymentAmount\",            \"paymentDate\",            \"paymentStatus.meaning\",            \"paymentMethod.paymentMethodName\"          ],          \"extraFilterExpressions\": [            \"paymentId=<PAYMENT_ID_FROM_USER> or paymentNumber=<PAYMENT_NUMBER_FROM_USER>\"          ],          \"notes\": \"\"        },        {          \"name\": \"paymentsBySupplier\",          \"description\": \"Retrieve payments for a supplier using supplier id, supplier number, or supplier name.\",          \"when\": \"User asks for payment details for a supplier or remit-to supplier.\",          \"fieldsToReturn\": [            \"supplier.name\",            \"paymentNumber\",            \"paymentAmount\",            \"paymentDate\",            \"paymentStatus.meaning\",            \"paymentProcessRequest.checkrunName\"          ],          \"extraFilterExpressions\": [            \"supplier.supplierId=<SUPPLIER_ID_FROM_USER> or supplier.supplierNumber='<SUPPLIER_NUMBER_FROM_USER>' or supplier.name='<SUPPLIER_NAME_FROM_USER>'\"          ],          \"notes\": \"\"        },        {          \"name\": \"paymentsByPpr\",          \"description\": \"Retrieve payments generated through a payment process request.\",          \"when\": \"User asks for payments under a named or identified payment process request.\",          \"fieldsToReturn\": [            \"paymentProcessRequest.checkrunName\",            \"paymentNumber\",            \"paymentAmount\",            \"paymentDate\",            \"paymentStatus.meaning\",            \"remitToSupplierName\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"\"        },        {          \"name\": \"taxAuthorityPaymentsByPpr\",          \"description\": \"Retrieve tax authority payments generated through a specific payment process request.\",          \"when\": \"User asks for tax authority, withholding remittance, or statutory payments in a named or identified PPR.\",          \"fieldsToReturn\": [            \"paymentProcessRequest.checkrunName\",            \"paymentNumber\",            \"supplier.name\",            \"paymentMethod.paymentMethodName\",            \"bankAccountBusinessUnitAssignment.bankAccount.name\",            \"paymentCurrency.currencyCode\",            \"paymentAmount\",            \"paymentStatus.meaning\",            \"paymentProcessRequest.checkrunId\"          ],          \"extraFilterExpressions\": [            \"(paymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>')\",            \"supplier.supplierType.lookupCode='TAX AUTHORITY'\",            \"sortBy: paymentDate:asc\",            \"limit: 20\"          ],          \"notes\": \"Use this for tax authority, withholding remittance, or statutory payments in a named PPR. Sort by paymentDate asc and limit to 20.\"        },        {          \"name\": \"futureDatedPayments\",          \"description\": \"Retrieve future-dated payments by maturity window.\",          \"when\": \"User asks for future payments, maturity schedules, or payments due in a future date range.\",          \"fieldsToReturn\": [],          \"extraFilterExpressions\": [            \"futurePayDueDate>=<START_DATE>\",            \"futurePayDueDate<=<END_DATE>\"          ],          \"notes\": \"\"        },        {          \"name\": \"paymentStatusReview\",          \"description\": \"Retrieve payments by payment status, payment system status, mode, or response.\",          \"when\": \"User asks for payments in a specific status or processing state.\",          \"fieldsToReturn\": [],          \"extraFilterExpressions\": [            \"paymentStatus.lookupCode='<PAYMENT_STATUS_CODE_FROM_USER>'\",            \"paymentSystemStatus.lookupCode='<PAYMENT_SYSTEM_STATUS_CODE_FROM_USER>'\"          ],          \"notes\": \"Use the relevant status expression based on what the user actually provides.\"        },        {          \"name\": \"batchPaymentBreakdown\",          \"description\": \"Retrieve the payment rows for a payment process request so totals, distinct suppliers, and payment-stage breakdowns can be computed.\",          \"when\": \"User asks for a payment summary or payment listing for a named batch or payment process request.\",          \"fieldsToReturn\": [            \"paymentProcessRequest.checkrunName\",            \"paymentNumber\",            \"paymentAmount\",            \"paymentDate\",            \"paymentStatus.lookupCode\",            \"paymentStatus.meaning\",            \"supplier.name\",            \"remitToSupplierName\",            \"paymentCurrency.currencyCode\",            \"paymentMethod.paymentMethodName\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequest.checkrunId=<PPR_ID_FROM_USER> or paymentProcessRequest.checkrunName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Aggregate paymentAmount, distinct supplier names, and paymentStatus.lookupCode outside the base fetch when the user asks for totals or status buckets.\"        },        {          \"name\": \"supplierPaymentHistory\",          \"description\": \"Retrieve a supplier's payment history over a recent date range.\",          \"when\": \"User asks for payment history, recent payments, or payment trends for a supplier.\",          \"fieldsToReturn\": [            \"supplier.name\",            \"paymentNumber\",            \"paymentAmount\",            \"paymentDate\",            \"paymentStatus.meaning\",            \"paymentMethod.paymentMethodName\",            \"paymentCurrency.currencyCode\"          ],          \"extraFilterExpressions\": [            \"supplier.name='<SUPPLIER_NAME_FROM_USER>'\"          ],          \"notes\": \"Apply the requested date window on paymentDate.\"        },        {          \"name\": \"unreconciledStoppedOrVoidedPayments\",          \"description\": \"Retrieve exception-oriented payments that are unreconciled, stopped, or voided.\",          \"when\": \"User asks for payments requiring follow-up or exception review.\",          \"fieldsToReturn\": [],          \"extraFilterExpressions\": [            \"reconciledFlag=false\",            \"stopDate!=null\",            \"voidDate!=null\"          ],          \"notes\": \"Use one or more of these expressions depending on whether the user asks for unreconciled, stopped, voided, or combined exception cases.\"        }      ],      \"additionalInstructions\": [        \"Use nested accessor paths exactly as defined in `fields.accessors` when constructing field selections and filters.\",        \"For payment process request questions, filter on `paymentProcessRequest.checkrunId` or `paymentProcessRequest.checkrunName` instead of inventing flattened batch attributes.\",        \"When the user asks for totals or a payment-stage breakdown for a batch, use this BV to fetch the row set and then aggregate `paymentAmount`, distinct `supplier.name` or `remitToSupplierName`, and `paymentStatus.lookupCode` externally.\",        \"For tax authority payment queries within a PPR, combine the PPR predicate with `supplier.supplierType.lookupCode='TAX AUTHORITY'` and return supplier, payment amount, due date, and status details.\",        \"For status-oriented requests, prefer lookup codes in `paymentStatus.lookupCode`, `paymentSystemStatus.lookupCode`, `paymentMode.lookupCode`, `paymentType.lookupCode`, `paymentResponse.lookupCode`, and `paymentSettlementPriority.lookupCode`; use `meaning` only when the user clearly gives display text.\",        \"For future-dated payments use `futurePayDueDate`; for cleared or reconciled payments use `clearingDate` and `reconciledFlag`; for stopped or voided payments use `stopDate` and `voidDate`.\",        \"Access bank and payment profile details through `bankAccountBusinessUnitAssignment.bankAccount`, `externalBankAccount`, and `accountPaymentProfile` instead of inventing unsupported flattened aliases.\",        \"For status-oriented comparison requests, return both `paymentStatus.lookupCode` and `paymentSystemStatus.lookupCode` when the user distinguishes process acceptance from payment clearing or settlement.\",        \"For operational-risk or payment-execution review where bank account, payment file, or PPR context matters, prefer `disbursementPayments` over this BV.\",        \"For grouped count-and-total summary requests such as voided payments by business unit, use an extraction-backed summary shape instead of summarizing a capped BV fetch.\"      ],      \"fieldSelectionRuleUsage\": {        \"match\": \"Choose the closest questionExamples entry for the user request.\",        \"fields\": \"Use the matching fields value exactly and preserve order.\",        \"paraphrases\": \"Use the same fields for paraphrased or equivalent requests.\",        \"addFieldsOnlyWhen\": \"The user explicitly asks for more displayed columns, or the field is required for filter, sort, group, key, or deeplink handling.\"      },      \"fieldSelectionRules\": [        {          \"questionExamples\": [            \"Show me all tax authority payments in PPR BLR07-01\"          ],          \"queryType\": \"BV\",          \"fields\": \"paymentProcessRequest.checkrunName,paymentNumber,supplier.name,paymentMethod.paymentMethodName,bankAccountBusinessUnitAssignment.bankAccount.name,paymentCurrency.currencyCode,paymentAmount,paymentStatus.meaning,paymentProcessRequest.checkrunId\",          \"fieldOrderLocked\": true,          \"shape\": \"payablesPaymentDetails\",          \"filters\": \"paymentProcessRequest.checkrunName = '<PPR_NAME_FROM_USER>' AND supplier.supplierType.lookupCode = 'TAX AUTHORITY'\",          \"sortBy\": \"paymentDate:asc\",          \"limit\": 20,          \"notes\": \"Tax authority payment rows under a PPR must sort by paymentDate asc before applying limit 20.\"        }      ]    },    \"disbursementPayments\": {      \"key\": \"disbursementPayments\",      \"name\": \"disbursementPayments\",      \"type\": \"BV\",      \"shapeRole\": \"detail\",      \"module\": \"oraErpCorePaymentsFundsDisbursement\",      \"businessObject\": \"PayablesDisbursementPayment\",      \"api\": \"objects/ora/erpCore/paymentsFundsDisbursement/v1/disbursementPayments\",      \"description\": \"Business view for disbursement payment retrieval in Funds Disbursement. Use this shape for payment logistics, payment processing options, payment file and PPR context, virtual card payment identification, bank routing details, grouping-rule analysis, and payment status review.\",      \"exampleQuestions\": [        \"What bank account was used to pay Supplier X on 2026-01-15?\",        \"List payments for supplier Vision Operations with payment currency USD and amount exceeding 5000.\",        \"What payment file format was used for payment 14876?\",        \"What was the bank branch and bank for payment 14876?\",        \"What service level and delivery channel were used for payment 14876?\",        \"Show payments with maturity date falling in the next 10 days.\",        \"Show virtual card payments using alias RCN-7781 within the last two days\",        \"Show payments made to supplier Vision Operations using a virtual card.\",        \"Show virtual card payments for supplier Vision Operations in the last 30 days where the payment system status is Accepted but the payment status is not Cleared.\",        \"Show virtual card payments for program MC HSBC using aliases that contain MC Citibank\",        \"Show me the payments made using funding card account RCN-7781 from 2026-01-15 to today.\",        \"Show manual Electronic payments for Vision Operations last week over 10000 that are not reconciled.\",        \"Show me unreconciled payments older than 30 days from payment date.\",        \"Show payments in payment file 12345 with payment status and PPR details\",        \"Void payment 147884.\",        \"Re-issue payment 147884.\",        \"Print remittance for payment 147884.\",        \"Show me payments in Stop Initiated status for more than 7 days.\",        \"What is the payment status for expense report EXP-2025-001234 submitted by John Smith?\",        \"What is the status of the refund payment for credit memo CM-2025-001?\",        \"Show me the bank branch and country for all installments in this batch\",        \"What was the bank branch and bank for payment 2575\",        \"Show me the bank branch and country for Installments under PPR <PPR_NAME>\",        \"Show me all payments over 5000000 with supplier details\"      ],      \"fields\": {        \"fields\": [          \"bepErrorCode\",          \"bepErrorMessageText\",          \"paymentProfileSystemName\",          \"paymentProfileAccountName\",          \"paymentReferenceNumber\",          \"bankAssignedReferenceCode\",          \"uniqueRemittanceIdentifier\",          \"paymentReasonComments\",          \"timeCreated\",          \"updatedBy\",          \"timeUpdated\",          \"createdBy\",          \"paymentId\",          \"paymentAmount\",          \"paymentCurrencyCode\",          \"paymentDate\",          \"payeeName\",          \"payeePartyName\",          \"paymentBusinessUnit\",          \"paymentProcessRequestName\",          \"paymentCompleteFlag\",          \"bankStatusCode\",          \"paymentSystemResponseIdentifier\",          \"issuerAuthorizationReference\",          \"acquirerTransactionReference\",          \"issuerProcessingTimestamp\",          \"voidDate\",          \"voidReason\",          \"stopDate\",          \"stopRequestReason\",          \"paymentDeclarationAmount\",          \"bankChargeAmount\",          \"uriCheckDigit\",          \"maturityDate\",          \"remittanceMessageOne\",          \"remittanceMessageTwo\",          \"remittanceMessageThree\",          \"paymentTextMessageOne\",          \"paymentTextMessageTwo\",          \"paymentTextMessageThree\",          \"stopRequestPlacedFlag\",          \"anticipatedValueDate\",          \"declarationCurrencyCode\",          \"invoicePayeePartyName\",          \"invoiceDueDate\",          \"paperDocumentNumber\",          \"serviceLevelCode\",          \"deliveryChannelCode\",          \"stopRequestPlacedBy\",          \"paymentStatusLookupCode\",          \"paymentFunctionLookupCode\"        ],        \"accessors\": {          \"paymentStatus\": {            \"fields\": [              \"lookupType\",              \"meaning\",              \"lookupCode\"            ]          },          \"paymentFunction\": {            \"fields\": [              \"lookupType\",              \"meaning\",              \"lookupCode\"            ]          },          \"fundsStatus\": {            \"fields\": [              \"lookupType\",              \"meanin