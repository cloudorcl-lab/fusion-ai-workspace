                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "createEachIterSets",
                    "returnType": "array",
                    "sourceCode": "let data = $context.$nodes.CALLSDELASTICBATCHES.SD_DATA_AGENT_BATCHES.$output.items;\nlet batchSize = $context.$variables.workflowBatchProcessSize;\n// Group data by SourceTablePrimary\n    const groupedData = data.reduce((acc, current) => {\n        if (!acc[current.SourceTablePrimary]) {\n            acc[current.SourceTablePrimary] = [];\n        }\n        acc[current.SourceTablePrimary].push(current);\n        return acc;\n    }, {});\n\n    // Process grouped data\n    const result = Object.keys(groupedData).map((tableName) => {\n        const orderNumbers = groupedData[tableName].map((item) => item.OrderNumber);\n        const transactionIds = groupedData[tableName].map((item) => item.TransactionId);\n\n        // Split order numbers and transaction ids into chunks of 25\n        const orderNumberChunks = [];\n        const transactionIdChunks = [];\n        for (let i = 0; i < orderNumbers.length; i += batchSize) {\n            orderNumberChunks.push(orderNumbers.slice(i, i + batchSize));\n            transactionIdChunks.push(transactionIds.slice(i, i + batchSize));\n        }\n\n        // Create output objects for each chunk\n        const outputObjects = orderNumberChunks.map((chunk, index) => {\n            const orderNumberList = \"'\" + chunk.join(\"','\") + \"'\";\n            const transactionIdList = transactionIdChunks[index].join(\",\");\n            return {\n                TableName: tableName,\n                OrderNumberList: orderNumberList,\n                TransactionIdList: transactionIdList,\n            };\n        });\n\n        return outputObjects;\n    }).flat();\n\n    return result;"
                  },
                  "outcomes": {
                    "success": "end_1765774406903"
                  },
                  "code": "CREATEEACHITERSETS",
                  "id": "1766570615579",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                }
              ],
