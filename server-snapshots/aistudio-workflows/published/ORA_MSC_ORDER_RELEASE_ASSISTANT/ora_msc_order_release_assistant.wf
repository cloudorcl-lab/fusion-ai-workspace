        {
          "metadata": {
            "errorNodeId": "1765909843541",
            "name": "setSingleRecordInput",
            "returnType": "array",
            "sourceCode": "let inputJsonObject = $context.$variables.SelectedJsonArray;\nlet maxBatchSize = $context.$variables.workflowBatchProcessSize ;  // Set max batch size\nlet workflowIterationArray = [];\n\n// Extract the list of order numbers and transaction IDs\nlet orderNumbers = inputJsonObject.rows[0].OrderNumberList.split(',');\nlet transactionIds = inputJsonObject.rows[0].TransactionIdList\n    .split(',')\n    .map(function(id) {\n        return id.replace(/'/g, '').trim();\n    });\n\n// Get the total number of order numbers (should match total transaction IDs)\nlet totalOrders = orderNumbers.length;\n\n// Loop through the order numbers and split them into batches\nfor (let i = 0; i < totalOrders; i += maxBatchSize) {\n    // Create a new batch object for each chunk\n    let batch = {\n        \"headers\": inputJsonObject.headers,\n        \"rows\": [{\n            \"TableName\": inputJsonObject.rows[0].TableName,\n            \"OrderNumberList\": orderNumbers.slice(i, i + maxBatchSize).join(','),\n            \"TransactionIdList\": transactionIds.slice(i, i + maxBatchSize).join(',')\n        }]\n    };\n    workflowIterationArray.push(batch);\n}\n\n// below code will apply only when user selected a mix of MSC_SUPPLIES and MSC_DEMANDS.\n// Extract the list of order numbers and transaction IDs\nlet orderNumbers_2 = [];\nlet transactionIds_2 = [];\nlet totalOrders_2 = 0;\nif(inputJsonObject.rows.length > 1) {\n    // Extract the list of order numbers and transaction IDs\n    orderNumbers_2 = inputJsonObject.rows[1].OrderNumberList.split(',');\n    transactionIds_2 = inputJsonObject.rows[1].TransactionIdList\n    .split(',')\n    .map(function(id) {\n        return id.replace(/'/g, '').trim();\n    });\n\n    // Get the total number of order numbers (should match total transaction IDs)\n    totalOrders_2 = orderNumbers_2.length;\n\n    // Loop through the order numbers and split them into batches\n    for (let i = 0; i < totalOrders_2; i += maxBatchSize) {\n        // Create a new batch object for each chunk\n        let batch = {\n            \"headers\": inputJsonObject.headers,\n            \"rows\": [{\n                \"TableName\": inputJsonObject.rows[1].TableName,\n                \"OrderNumberList\": orderNumbers_2.slice(i, i + maxBatchSize).join(','),\n                \"TransactionIdList\": transactionIds_2.slice(i, i + maxBatchSize).join(',')\n            }]\n        };\n        workflowIterationArray.push(batch);\n    }\n}\n\nreturn workflowIterationArray;"
          },
          "outcomes": {
            "success": "1766744383119"
          },
