          "metadata": {
            "name": "ifPass",
            "returnType": "array",
            "sourceCode": "const result = [];\n    let offset = 0;\n    let limit = $context.$variables.elasticLoopSize;\n\n    while (offset < $context.$variables.totalResults) {\n        result.push({ offset, limit });\n        offset += limit;\n        limit = $context.$variables.elasticLoopSize;\n    }\n\n    if (offset < $context.$variables.totalResults) {\n        result.push({ offset, limit: $context.$variables.totalResults });\n    }\nreturn result;"
          },
          "outcomes": {
            "success": "1765774406903"
          },
