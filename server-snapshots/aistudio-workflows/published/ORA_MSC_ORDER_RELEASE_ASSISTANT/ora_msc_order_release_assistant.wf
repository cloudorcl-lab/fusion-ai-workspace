          "metadata": {
            "name": "createPayloadSet",
            "returnType": "array",
            "sourceCode": "let array = [];\nlet orderArrayData = $context.$variables.finalDataArray;\nlet mode = $context.$variables.Mode;\n\n\nfor(let item of orderArrayData){\nlet obj = {};\nif(mode === \"SELECTED\"){\nobj.headers = item.headers;\nobj.rows = item.rows;\n}\nelse{\nobj.headers = [\"TableName\", \"OrderNumberList\", \"TransactionIdList\"];\nobj.rows = [];\nobj.rows.push(item);\n}\nobj.isNothingToRelease = false;\nobj.isWorkflowError = false;\nobj.singleOrderRelease = \"\";\nobj.responseJson = {};\narray.push(obj);\n}\n\nreturn array;"
          },
          "outcomes": {
            "success": "1765917106070"
          },
          "code": "CREATEPAYLOADSET",
