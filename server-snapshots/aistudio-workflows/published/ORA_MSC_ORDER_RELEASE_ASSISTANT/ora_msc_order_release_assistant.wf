                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"OrderTransactionSet\",\n  \"type\": \"object\",\n  \"required\": [\"ByOrderNumber\", \"ByTransactionId\", \"Count\"],\n  \"properties\": {\n    \"ByOrderNumber\": {\n      \"type\": \"object\",\n      \"required\": [\"DemandOrder\", \"SupplyOrder\"],\n      \"properties\": {\n        \"DemandOrder\": {\n          \"type\": \"object\",\n          \"required\": [\"Review\", \"Release\"],\n          \"properties\": {\n            \"Review\": {\n              \"type\": \"array\",\n              \"items\": { \"type\": \"string\" }\n            },\n            \"Release\": {\n              \"type\": \"array\",\n              \"items\": { \"type\": \"string\" }\n            }\n          }\n        },\n        \"SupplyOrder\": {\n          \"type\": \"object\",\n          \"required\": [\"Review\", \"Release\"],\n          \"properties\": {\n            \"Review\": {\n              \"type\": \"array\",\n              \"items\": { \"type\": \"string\" }\n            },\n            \"Release\": {\n              \"type\": \"array\",\n              \"items\": { \"type\": \"string\" }\n            }\n          }\n        }\n      }\n    },\n    \"ByTransactionId\": {\n      \"type\": \"object\",\n      \"required\": [\"DemandOrder\", \"SupplyOrder\"],\n      \"properties\": {\n        \"DemandOrder\": {\n          \"type\": \"object\",\n          \"required\": [\"Review\", \"Release\", \"ReviewException\"],\n          \"properties\": {\n            \"Review\": {\n              \"type\": \"array\",\n              \"items\": { \"type\": \"string\" }\n            },\n            \"Release\": {\n              \"type\": \"array\",\n              \"items\": { \"type\": \"string\" }\n            },\n            \"ReviewException\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"object\",\n                \"required\": [\"transactionId\", \"exceptionId\"],\n                \"properties\": {\n                  \"transactionId\": { \"type\": \"string\" },\n                  \"exceptionId\": { \"type\": \"string\" }\n                }\n              }\n            }\n          }\n        },\n        \"SupplyOrder\": {\n          \"type\": \"object\",\n          \"required\": [\"Review\", \"Release\", \"ReviewException\"],\n          \"properties\": {\n            \"Review\": {\n              \"type\": \"array\",\n              \"items\": { \"type\": \"string\" }\n            },\n            \"Release\": {\n              \"type\": \"array\",\n              \"items\": { \"type\": \"string\" }\n            },\n            \"ReviewException\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"object\",\n                \"required\": [\"transactionId\", \"exceptionId\"],\n                \"properties\": {\n                  \"transactionId\": { \"type\": \"string\" },\n                  \"exceptionId\": { \"type\": \"string\" }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"Count\": {\n      \"type\": \"integer\",\n      \"minimum\": 0\n    }\n  }\n}",
