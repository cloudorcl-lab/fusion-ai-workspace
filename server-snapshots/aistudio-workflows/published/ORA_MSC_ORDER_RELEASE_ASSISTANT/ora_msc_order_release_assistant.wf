                  "code": "SD_DATA_AGENT_BATCHES",
                  "id": "1765774489959",
                  "inputs": [
                    {
                      "id": "1767321835309_1",
                      "name": "limit",
                      "type": "string",
                      "value": "{{$context.$nodes.CALLSDELASTICBATCHES.$currentItem.limit}}"
