{
  "workflowId": "100002355227070",
  "workflowCode": "ORA_SELF_SERVICE_WORKFLOW",
  "name": "Self Service Transaction Assistant",
  "description": "A user‑friendly extension of the Transaction Console Assistant that helps managers and employees track and manage transactions.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1764067378998"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "description": "End of data pipeline",
            "name": "End"
          },
          "outcomes": {},
          "code": "END",
          "id": "end",
          "inputs": [],
          "type": "END"
        },
        {
          "metadata": {
            "name": "Categorize User Input"
          },
          "outcomes": {
            "success": "1764080109470"
          },
          "code": "CATEGORIZE_USER_INPUT",
          "id": "1764067378998",
          "inputs": [
            {
              "id": "1764067378999_1",
              "name": "prompt",
              "type": "string",
              "value": "Read the input ```{{$context.$system.$inputMessage}}``` provided and categorize it into one of the following category\n\nFIND_TRANSACTION_BASED_ON_FILTERS\nSHOW_APPROVER_INFORMATION_FOR_TRANSACTION\nPERFORM_ACTION_ON_TRANSACTION\nAPPROVAL_DELEGATION_RELATED_QUERY\nUNCATEGORIZED\n\n*Important*\n\nDo not provide any reason or justification of the category.\nYour response should only be one of the category that is mentioned above.\nDo not append any extra space."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Route User Input"
          },
          "outcomes": {
            "PERFORM_ACTION_ON_TRANSACTION": "1764083671315",
            "FIND_TRANSACTION_BASED_ON_FILTERS": "1764080525463",
            "UNCATEGORIZED": "1764083859819",
            "SHOW_APPROVER_INFORMATION_FOR_TRANSACTION": "1764083745205"
          },
          "code": "ROUTE_USER_INPUT",
          "convergenceTargetId": "end",
          "id": "1764067548889",
          "inputs": [
            {
              "id": "1764067548890_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$variables.QueryCategory}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
            "agentCode": "ORA_TRANSACTIONS_FINDER",
            "name": "Find Transaction"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "FIND_TRANSACTION",
          "id": "1764080525463",
          "inputs": [
            {
              "id": "1764080542257_1",
              "name": "message",
              "type": "string",
              "value": "{{$context.$system.$inputMessage}}"
            }
          ],
          "outputSpecification": " ",
          "type": "AGENT"
        },
        {
          "metadata": {
            "name": "Perform Action",
            "workflowCode": "ORA_SELF_SERVICE_ACTION_WORKFLOW"
          },
          "outcomes": {
            "success": "1764577260424"
          },
          "code": "PERFORM_ACTION",
          "id": "1764083671315",
          "inputs": [
            {
              "id": "1766380684490_1",
              "name": "message",
              "type": "string",
              "value": "{{$context.$system.$inputMessage}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
        },
        {
          "metadata": {
            "name": "set query category var"
          },
          "outcomes": {
            "success": "1764067548889"
          },
          "code": "SET_QUERY_CATEGORY_VAR",
          "convergenceTargetId": "1764067548889",
          "id": "1764080109470",
          "inputs": [
            {
              "id": "1764080125276",
              "name": "QueryCategory",
              "type": "string",
              "value": "{{$context.$nodes.CATEGORIZE_USER_INPUT.$output}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "perform approver history related query",
            "workflowCode": "ORA_SELF_SERVICE_APPROVAL_HISTORY"
          },
          "outcomes": {
            "success": "1764139929339"
          },
          "code": "PERFORM_APPROVER_HISTORY_RELATED_QUERY",
          "id": "1764083745205",
          "inputs": [
            {
              "id": "1766383715160_1",
              "name": "message",
              "type": "string",
              "value": "{{$context.$system.$inputMessage}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
        },
        {
          "metadata": {
            "name": "Invalid input handing"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "INVALID_INPUT_HANDING",
          "id": "1764083859819",
          "inputs": [
            {
              "id": "1764083859819_1",
              "name": "prompt",
              "type": "string",
              "value": "Print the following: \"You have asked for a query which is not supported by the agent, kindly rephrase.\""
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "print approval history response",
            "returnType": "string",
            "sourceCode": "return $context.$nodes.PERFORM_APPROVER_HISTORY_RELATED_QUERY.$output.output;"
          },
          "outcomes": {
            "success": "1764572149203"
          },
          "code": "PRINT_APPROVAL_HISTORY_RESPONSE",
          "id": "1764139929339",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "print approval history outcome"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "PRINT_APPROVAL_HISTORY_OUTCOME",
          "id": "1764572149203",
          "inputs": [
            {
              "id": "1764572149204_1",
              "name": "prompt",
              "type": "string",
              "value": "Read the response ```{{$context.$nodes.PRINT_APPROVAL_HISTORY_RESPONSE.$output.result}}``` and answer with respect to the query asked by the user ( {{$context.$system.$inputMessage}} )\nIf the output contain assignment to multiple users or roles, then mention all of them.\nPlease do not add any additional details.\nDo not provide any recommendations."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "fetch action response",
            "returnType": "object",
            "sourceCode": "var resp  = $context.$nodes.PERFORM_ACTION.$output.output;\nif(resp.actionOutput && resp.actionOutput.result && resp.actionOutput.result.result){\n         return resp.actionOutput.result;\n}\nreturn resp;"
          },
          "outcomes": {
            "success": "1764622054471"
          },
          "code": "FETCH_ACTION_RESPONSE",
          "id": "1764577260424",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "set action response"
          },
          "outcomes": {
            "success": "1764622104608"
          },
          "code": "SET_ACTION_RESPONSE",
          "id": "1764622054471",
          "inputs": [
            {
              "id": "1764622064429",
              "name": "actionOutput",
              "type": "object",
              "value": "{{$context.$nodes.FETCH_ACTION_RESPONSE.$output.result}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "parse action variable",
            "returnType": "string",
            "sourceCode": "var resp  = $context.$variables.actionOutput ;\nif(resp.result != null && resp.result.result != null )\n    return resp.result.result;\nreturn resp;"
          },
          "outcomes": {
            "success": "1764622894264"
          },
          "code": "PARSE_ACTION_VARIABLE",
          "id": "1764622104608",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "print action output"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "PRINT_ACTION_OUTPUT",
          "id": "1764622894264",
          "inputs": [
            {
              "id": "1764622894264_1",
              "name": "prompt",
              "type": "string",
              "value": "read the response {{$context.$nodes.PARSE_ACTION_VARIABLE.$output.result}} and print whether the action that was intended to perform in the user query ( {{$context.$system.$inputMessage}} ) on the transaction was successful or not.\nDo not provide trace id or job id in the response.\nDo not provide any additional recommendations in the response.\nIf the user asked for providing the applicable actions on a given transaction, then only list the actions that are enabled.\n\n\n"
            }
          ],
          "type": "LLM"
        }
      ],
