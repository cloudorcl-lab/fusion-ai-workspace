        {
          "metadata": {
            "name": "OTBI Extracting Prompts",
            "returnType": "object",
            "sourceCode": "var soap = String( $context.$nodes.OTBI_READ_OBJECTS.$output );\n\nvar decoded = soap\n  .replace(/&lt;/g, \"<\")\n  .replace(/&gt;/g, \">\")\n  .replace(/&quot;/g, '\"')\n  .replace(/&apos;/g, \"'\")\n  .replace(/&amp;/g, \"&\");\n\nvar promptBlocks = decoded.match(/<saw:prompt\\b[\\s\\S]*?<\\/saw:prompt>/g) || [];\n\nvar prompts = [];\nvar i;\n\nfor (i = 0; i < promptBlocks.length; i++) {\n  var block = promptBlocks[i];\n\n  var labelMatch = block.match(\n    /<saw:label>[\\s\\S]*?<saw:text>(.*?)<\\/saw:text>[\\s\\S]*?<\\/saw:label>/\n  );\n  var label = labelMatch ? labelMatch[1].trim() : null;\n\n  var values = [];\n  var regex = /<saw:promptDefaultValue>(.*?)<\\/saw:promptDefaultValue>/g;\n  var match;\n\n  while ((match = regex.exec(block)) !== null) {\n    values.push(match[1].trim());\n  }\n\n  prompts.push({\n    index: i + 1,\n    label: label,\n    values: values.length ? values : null\n  });\n}\n\nvar result = {\n  prompts: prompts\n};\n\nresult;"
          },
          "outcomes": {
            "success": "1775914145065"
          },
          "code": "OTBI_EXTRACTING_PROMPTS",
          "convergenceTargetId": "1772788355321",
          "id": "1775837266283",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
