        {
          "metadata": {
            "name": "OTBI Extracting Signature",
            "returnType": "object",
            "sourceCode": "var soap = String($context.$nodes.OTBI_READ_OBJECTS_REPORT_COPIED.$output);\nlet result;\n\nvar re = /<sawsoap:signature\\b[^>]*>([\\s\\S]*?)<\\/sawsoap:signature>/i;\nvar m = soap.match(re);\nvar signature = m ? m[1] : null;\n\nresult = { \n  found: m ? true : false,\n  signature: signature,\n  error: m ? null : \"No <sawsoap:signature> tag found\"\n  };\n\nreturn result;"
          },
          "outcomes": {
            "success": "1773059481163"
          },
          "code": "OTBI_EXTRACTING_SIGNATURE",
          "convergenceTargetId": "1773059481163",
          "id": "1773063331107",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Extract Source Report Path From Input",
            "returnType": "object",
            "sourceCode": "var input = $context.$system.$inputMessage;\n\nvar match = input.match(/\"([^\"]*\\/[^\"]*)\"|(\\/\\S.*?)(?=\\s*$)/);\nvar sourceReportPath = match?.[1] ?? match?.[2] ?? null;\n\nvar newNameForBackup = sourceReportPath .split('/').pop() + \"_\" + $context.$system.$currentDateTime;\nnewNameForBackup  = newNameForBackup .split('.')[0] + \"_BKP\" ;\n\nvar result = {\n   \"sourceReportPath\": sourceReportPath,\n   \"newNameForBackup\": newNameForBackup\n}\nresult;"
          },
          "outcomes": {
            "success": "1775831187905"
          },
          "code": "EXTRACT_SOURCE_REPORT_PATH_FROM_INPUT",
          "id": "1776157165631",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
