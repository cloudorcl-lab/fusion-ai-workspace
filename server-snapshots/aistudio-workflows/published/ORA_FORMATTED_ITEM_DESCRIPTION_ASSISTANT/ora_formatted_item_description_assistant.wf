{
  "workflowId": "300000331529047",
  "workflowCode": "ORA_FORMATTED_ITEM_DESCRIPTION_ASSISTANT",
  "name": "Formatted Item Description Assistant",
  "description": "The Formatted Item Description Generator turns a short product description into polished, structured content. It creates a persuasive product description, a features list, and a benefits list, all while preserving the original item description as provided. The agent is designed to produce clean, valid HTML with consistent formatting and SEO-friendly emphasis. Its output is ideal for product pages, catalog entries, and e-commerce content workflows.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
