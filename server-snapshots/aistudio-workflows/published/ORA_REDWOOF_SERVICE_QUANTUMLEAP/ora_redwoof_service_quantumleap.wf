        },
        {
          "metadata": {
            "dataPipeline": {
              "pipelineNodes": [
                {
                  "metadata": {
                    "name": "Start",
                    "description": "Start of data pipeline"
                  },
                  "outcomes": {
                    "success": "1762530491568"
                  },
                  "id": "start_1762530426581",
                  "code": "START_1762530426581",
