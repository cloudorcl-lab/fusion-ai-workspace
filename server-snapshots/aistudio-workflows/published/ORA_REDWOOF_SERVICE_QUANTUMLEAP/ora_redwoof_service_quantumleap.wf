                {
                  "metadata": {
                    "name": "processFileContent",
                    "returnType": "object",
                    "sourceCode": "const fileContent = $context.$nodes.GET_SR_ATTACHMENT_CONTENT.$output;\nconst currentItem = $context.$nodes.LOOP_SR_ATTACHMENT_INFO.$currentItem;\nconst result = {\n    fileContent: fileContent,\n    AttachedDocumentId: currentItem.AttachedDocumentId,\n    UploadedFileContentType: currentItem.UploadedFileContentType,\n    FileName: currentItem.FileName\n};\n\nreturn result;"
