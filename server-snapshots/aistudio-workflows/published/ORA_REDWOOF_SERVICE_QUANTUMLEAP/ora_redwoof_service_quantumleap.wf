                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"type\": {\n      \"type\": \"string\"\n    },\n    \"layoutDetails\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"fields\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"type\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              },\n              \"FieldId\": {\n                \"type\": \"string\"\n              },\n              \"LabelText\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              },\n              \"Id\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              },\n              \"RequiredOption\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              },\n              \"ReadOnlyOption\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              },\n              \"HiddenOption\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              },\n              \"label\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              },\n              \"items\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              },\n              \"ImageId\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              },\n              \"tabName\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              },\n              \"tabId\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              }\n            },\n            \"required\": [\n              \"FieldId\",\n              \"type\",\n              \"LabelText\",\n              \"Id\",\n              \"tabName\",\n              \"tabId\"\n            ]\n          }\n        },\n        \"reports\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"AcId\": {\n                \"type\": \"string\"\n              },\n              \"Id\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              },\n              \"tabName\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              },\n              \"tabId\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              },\n              \"FilterMappings\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              }\n            },\n            \"required\": [\n              \"AcId\",\n              \"Id\",\n              \"tabName\",\n              \"tabId\"\n            ]\n          }\n        },\n        \"workspaceReports\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"objectName\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              },\n              \"FKField\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              },\n              \"AcId\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              },\n              \"tabName\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              },\n              \"tabId\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              }\n            },\n            \"required\": [\n              \"ItemType\",\n              \"FKField\",\n              \"AcId\",\n              \"tabName\",\n              \"tabId\"\n            ]\n          }\n        },\n        \"browsers\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"Url\": {\n                \"type\": \"string\"\n              },\n              \"Id\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              },\n              \"SendUrlAsPostData\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              },\n              \"tabName\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              },\n              \"tabId\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              }\n            },\n            \"required\": [\n              \"AcId\",\n              \"Id\",\n              \"tabName\",\n              \"tabId\"\n            ]\n          }\n        },\n        \"tabs\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"tabId\": {\n                \"type\": \"string\"\n              },\n              \"tabName\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              }\n            },\n            \"required\": [\n              \"tabId\",\n              \"tabName\"\n            ]\n          }\n        },\n        \"name\": {\n          \"type\": \"string\"\n        },\n        \"id\": {\n          \"type\": \"string\"\n        },\n        \"dependencies\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"id\": {\n                \"type\": \"string\"\n              },\n              \"type\": {\n                \"type\": \"string\",\n                \"enum\": [\n                  \"Report\"\n                ]\n              },\n              \"name\": {\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"id\",\n              \"type\",\n              \"name\"\n            ]\n          }\n        }\n      }\n    }\n  }\n}"
