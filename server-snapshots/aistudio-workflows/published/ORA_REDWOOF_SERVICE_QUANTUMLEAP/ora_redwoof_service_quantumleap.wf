        {
          "metadata": {
            "name": "Process Documents Metadata",
            "returnType": "array",
            "sourceCode": "const output = $context.$nodes.GET_ALL_SR_ATTACHMENTS.$output;\n\nconst items = output.items;\n\nconst result = items.map(item => {\n return {\n    AttachedDocumentId: item.AttachedDocumentId,\n    FileName: item.FileName,\n    UploadedFileContentType: item.UploadedFileContentType,\n    DocumentId: item['@context']?.key\n}});\n\nreturn result;"
          },
          "outcomes": {
            "success": "1762340109079"
          },
          "code": "PROCESS_SR_ATTACHMENTINFO",
          "id": "1762344852487",
          "inputs": [],
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get Manifest File",
            "returnType": "string",
            "sourceCode": "const fileMetadataList =  $context.$nodes.LOOP_SR_ATTACHMENT_INFO.$output;\n\nlet manifestFileContent = \"\";\nfor (const item of fileMetadataList) {\nlet metaData = JSON.parse(item).result\n    if (metaData?.FileName === \"EEMManifest.xml\") {\n        manifestFileContent = metaData?.fileContent;\n        break;\n    }\n}\n\nreturn manifestFileContent;"
          },
          "outcomes": {
            "success": "1762422436850"
          },
          "code": "GET_MANIFEST_FILE",
