                  "metadata": {
                    "name": "Generate Event Data Files",
                    "returnType": "array",
                    "sourceCode": "const input = $context.$nodes.EVENT_METADATA_LOOP.$currentItem;\nconst namedTriggerActions = [];\n\ninput.forEach((rule) => {\n  const { triggers, ruleName, id } = rule;\n\n\n  triggers.forEach((trigger) => {\n    const entry = { ruleName, trigger, id };\n\n    switch (trigger.type) {\n      case \"Named\":\n        namedTriggerActions.push(entry);\n        break;\n      default:\n        break;\n    }\n  });\n});\n\n\nconst eventsData = {};\nconst eventListenersData = {};\nconst actionChainNames = [];\n\nnamedTriggerActions.forEach((triggerData) => {\n  const eventName = triggerData.trigger.name;\n  eventsData[eventName] = {\n    mode: \"triggerable\",\n  };\n  eventListenersData[eventName] = {\n    chains: [\n      {\n        parameters: {\n            \"methods\": \"{{ $event.methods }}\",\n            \"uefContext\": \"{{ $event.uefContext }}\"\n        },\n        chain: `${triggerData.id}Listener`,\n      },\n    ],\n  };\n});\nconst srFlowJson = {\n  description: \"sr flow extension\",\n  eventListeners: eventListenersData,\n  events: {},\n  services: {},\n  \"types\": {\n    \"FFExecutor\": {\n      \"actionChainName\": \"string\",\n      \"dependentField\": \"string\",\n      \"execute\": \"any\",\n      \"fieldName\": \"string\",\n      \"getMessage\": \"any\"\n    },\n    \"FieldExecutor\": {\n      \"fieldName\": \"string\",\n      \"execute\": \"any\",\n      \"getMessage\": \"any\",\n      \"actionChainName\": \"any\"\n    },\n    \"ObjectExecutor\": {\n      \"execute\": \"any\",\n      \"getMessage\": \"any\",\n      \"actionChainName\": \"any\"\n    },\n    \"FieldToActionChainMap\": {\n      \"fieldName\": \"string\",\n      \"actionChains\": \"string[]\"\n    }\n  },\n  \"variables\": {\n    \"eventManagerMetaData\": {\n      \"type\": {\n        \"formulaFieldChains\": \"FFExecutor[]\",\n        \"triggers\": {\n          \"fieldTriggers\": \"FieldExecutor[]\",\n          \"objectTriggers\": {\n            \"afterCreate\": \"ObjectExecutor[]\",\n            \"beforeInsert\": \"ObjectExecutor[]\"\n          }\n        },\n        \"validations\": {\n          \"fieldValidations\": \"FieldExecutor[]\",\n          \"objectValidations\": \"ObjectExecutor[]\"\n        }\n      }\n    }\n  },\n  interface: {\n    events: eventsData,\n  },\n  \"imports\": {\n    \"modules\": {\n      \"uiEventsFramework\": {\n        \"path\": \"oracle_cx_serviceUI:$functions/uiEventsFramework\"\n      },\n      \"expressionUtils\": {\n        \"path\": \"self:$functions/expressionUtils\"\n      }\n    }\n  }\n};\nconst uploadFileList = [];\nuploadFileList.push({\n  fileName: \"sr-flow-x.json\",\n  fileContent: srFlowJson,\n  description:\n    \"extension1/sources/ui/oracle_cx_serviceUI/applications/service/flows/ec/flows/sr/sr-flow-x.json\",\n});\n\nreturn uploadFileList;"
