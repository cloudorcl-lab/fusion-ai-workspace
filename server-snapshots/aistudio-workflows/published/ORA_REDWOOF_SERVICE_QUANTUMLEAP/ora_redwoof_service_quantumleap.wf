        {
          "metadata": {
            "name": "Get Upload File Details",
            "returnType": "array",
            "sourceCode": "const layoutFiles = $context.$nodes.GENERATE_LAYOUT_LOOP.$output;\nconst rulesFiles = $context.$nodes.LOOP_OVER_ALL_WORKSPACES.$output;\nconst uiControls = $context.$nodes.EVENT_METADATA_LOOP.$output\n\nconst result = [];\nlet srFlow;\n\nrulesFiles.forEach((e) => {\n    const files = typeof e === 'string' ? JSON.parse(e).result : e.result;\n    result.push(...files);\n});\n\nlayoutFiles.forEach(item => {\n    const layoutFileList = typeof item === 'string' ? JSON.parse(item)?.result : item.result;\n    layoutFileList.forEach((file) => {\n        if (file.fileName === 'sr-flow-x.json') {\n            srFlow = file;\n        } else {\n            result.push(file);\n        }\n    });\n});\nuiControls.forEach(item => {\n    const uicFileList = typeof item === 'string' ? JSON.parse(item)?.result:  item.result;\n    uicFileList.forEach((file) => {\n        if (file.fileName === 'sr-flow-x.json') {\n            file.fileContent = { ...file.fileContent, ...srFlow.fileContent }\n            result.push(file)\n        } else {\n            result.push(file);\n        }\n    });\n});\n\nreturn result;"
          },
