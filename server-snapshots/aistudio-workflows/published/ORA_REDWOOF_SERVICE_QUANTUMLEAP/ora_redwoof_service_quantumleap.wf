                {
                  "metadata": {
                    "name": "Contact Layout Generator",
                    "sourceCode": "const definitions = $context.$nodes.GENERATE_LAYOUT_LOOP.$currentItem;\nconst fieldMapping = $context.$variables.fieldMapping;\n\nconst uploadFileList = [];\nconst layoutJson = {\n    \"chainRules\": {},\n    \"addLayouts\": {},\n    \"addSubLayouts\": {},\n    \"addTemplates\": {\n        \"actionTemplate\": {\n            \"title\": \"actionTemplate\",\n            \"description\": \"Action Template\",\n            \"extensible\": \"byReference\",\n            \"@dt\": {\n                \"type\": \"field\"\n            },\n            \"dependencies\": [\n                \"ojs/ojbutton\",\n                \"ojs/ojinputtext\",\n                \"ojs/ojmenu\",\n                \"ojs/ojoption\"\n            ]\n        },\n        \"recordDrillDownLinkTemplate\": {\n            \"title\": \"recordDrillDownLinkTemplate\",\n            \"description\": \"Record Drill Down Link\",\n            \"extensible\": \"byReference\",\n            \"@dt\": {\n                \"type\": \"field\"\n            },\n            \"dependencies\": [\n                \"ojs/ojinputtext\"\n            ]\n        }\n    },\n    \"eventListeners\": {\n        \"actionMenuMenuAction\": {\n            \"chains\": []\n        },\n        \"valueClick\": {\n            \"chains\": []\n        },\n        \"vbEnter\": {\n            \"chains\": [\n                {\n                    \"parameters\": {},\n                    \"chain\": \"subscribeToFieldPropChangeEventAC\"\n                }\n            ]\n        }\n    },\n    \"interface\": {\n        \"events\": {\n            \"recordEditDrilldown\": {\n                \"propagationBehavior\": \"container\",\n                \"description\": \"Emits to page\",\n                \"payloadType\": {\n                    \"recordNumber\": \"string\"\n                }\n            }\n        }\n    },\n    \"imports\": {\n        \"modules\": {\n            \"expressionUtils\": {\n                \"path\": \"self:$functions/expressionUtils\"\n            }\n        }\n    },\n    \"addLayoutOverlays\": {}\n};\n\nif (definitions.reports) {\n    definitions.reports.forEach(report => {\n        const columns = report.columns;\n        let reportColumns = [];\n\n        if (columns) {\n            reportColumns = columns.map(column => {\n                const columnVal = column.name;\n                const cols = columnVal.split(\".\");\n                const objectName = cols[0].includes(\"contact\") ? \"contact\" : cols[0];\n                const fieldName = fieldMapping[objectName][cols[1]] || cols[1];\n                return fieldName;\n            });\n        }\n\n        if (reportColumns.includes(\"PartyNumber\")) {\n            reportColumns.unshift(\"PartyNumber\");\n        }\n\n        const layoutName = report.name;\n\n        const layouts = {\n            \"default\": {\n                \"layoutType\": \"table\",\n                \"layout\": {\n                    \"displayProperties\": reportColumns,\n                    \"fieldTemplateMap\": {\n                        \"PartyNumber\": \"recordDrillDownLinkTemplate\",\n                        \"customAction1\": \"actionTemplate\"\n                    }\n                },\n                \"usedIn\": [`${layoutName}Rule`]\n            }\n        };\n\n        layoutJson.addLayouts[`${layoutName}Rule`] = {\n            \"description\": `${layoutName} Rule`,\n            \"type\": \"/contacts\",\n            \"expression\": \"default\"\n        };\n\n        layoutJson.addLayouts[layoutName] = {\n            \"type\": \"/contacts\",\n            \"layoutType\": \"table\",\n            \"label\": layoutName,\n            \"editForm\": \"VDOM\",\n            \"rules\": [`${layoutName}Rule`],\n            \"layouts\": layouts\n        }\n    });\n}\n\nuploadFileList.push({\n    fileName: \"layout-x.json\",\n    fileContent: layoutJson,\n    description: \"extension1/sources/dynamicLayouts/oracle_cx_serviceUI/contacts/layout-x.json\"\n});\n\nuploadFileList.push({\n    fileName: \"layout-x.html\",\n    fileContent: `\n    <!-- Contains Dynamic UI layout templates -->\n<template id=\"recordDrillDownLinkTemplate\">\n  <a href=\"javascript:void(0)\" :title=\"[[$value()]]\" class=\"oj-link-standalone\" :id=\"[[$value]]\"\n    :data-record-number=\"[[$value()]]\" on-click=\"[[$functions.hyperlinkClickChain]]\">\n    <oj-bind-text value=\"[[$value]]\"></oj-bind-text>\n  </a>\n</template>\n\n<template id=\"actionTemplate\">\n  <oj-menu-button :id=\"[['_actionMenuButton'+ $constants.layoutType]]\" chroming=\"borderless\" display=\"icons\">\n    <oj-bind-text value=\"[[ 'Actions' ]]\"></oj-bind-text>\n    <oj-menu :id=\"[['_actionMenu'+ $constants.layoutType]]\" slot=\"menu\" on-oj-menu-action=\"[[$functions.menuActionClickChain]]\"\n      >\n      <oj-option :id=\"[['_Remove'+ $constants.layoutType]]\" value=\"Delete\">\n        <oj-bind-text value=\"[[ 'Delete']]\"></oj-bind-text>\n      </oj-option>\n    </oj-menu>\n    <span class=\"oj-ux-ico-overflow-v\" slot=\"endIcon\"></span>\n  </oj-menu-button>\n</template>\n\n    `,\n    description: \"extension1/sources/dynamicLayouts/oracle_cx_serviceUI/contacts/layout-x.html\"\n});\n\nuploadFileList.push({\n    fileName: \"layout-x.js\",\n    fileContent: `\n    define([], () => {\n  'use strict';\n\n  class LayoutModule {\n\n    hyperlinkClickChain(event, context) {\n      const drillDownEvent = new CustomEvent('recordEditDrilldown', { detail: context.row });\n      const dynComponent = context?.componentElement.parentNode;\n      if (dynComponent) {\n        dynComponent.dispatchEvent(drillDownEvent);\n      }\n    }\n\n    menuActionClickChain(event, context) {\n      const menuActionEvent = new CustomEvent('customAction', { detail: { operation: event.detail.selectedValue } });\n      const dynComponent = context?.componentElement?.parentNode;\n      if (dynComponent) {\n        dynComponent.dispatchEvent(menuActionEvent);\n      }\n    }\n\n    isRequired(field) {\n      return true;\n    }\n\n    isReadonly(field) {\n        return true\n    }\n\n    isVisible(field) {\n      return true\n    }\n  }\n\n  return LayoutModule;\n});\n\n    `,\n    description: \"extension1/sources/dynamicLayouts/oracle_cx_serviceUI/contacts/layout-x.js\"\n});\n\nreturn JSON.stringify(uploadFileList);"
