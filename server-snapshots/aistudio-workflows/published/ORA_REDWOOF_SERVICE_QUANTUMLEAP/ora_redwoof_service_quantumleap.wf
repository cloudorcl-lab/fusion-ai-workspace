          "metadata": {
            "name": "Enrich Document Metadata",
            "returnType": "object",
            "sourceCode": "const fileMetadataList = $context.$nodes.LOOP_SR_ATTACHMENT_INFO.$output.map(item => JSON.parse(item).result);\nconst metadataList = $context.$nodes.PROCESS_MANIFEST_FILE.$output;\n\nconst reportMetadataMap = {};\n\nconst workspaceMetadataList = metadataList.map(metadata => {\n    const workspaceMetadata = fileMetadataList.filter(fieldMetadata => {\n        if (fieldMetadata.FileName == `${metadata.name} ${metadata.id}.xml`) {\n            return true;\n        }\n        return false;\n    });\n    metadata.fileDetails = workspaceMetadata[0];\n\n    let dependencies = metadata.dependencies;\n    if (dependencies) {\n        dependencies.forEach(dependency => {\n            const reportMetadata = {\n                id: dependency.id,\n                name: dependency.name,\n                type: dependency.type\n            };\n            if (!reportMetadataMap[dependency.id]) {\n                const reportMetadataList = fileMetadataList.filter(fieldMetadata => {\n                    if (fieldMetadata.FileName == `${dependency.name} ${dependency.id}.xml`) {\n                        return true;\n                    }\n                    return false;\n                });\n                reportMetadata.fileDetails = reportMetadataList[0];\n                reportMetadataMap[dependency.id] = reportMetadata;\n            }\n        });\n    }\n    return metadata;\n});\n\nconst result = {\n    workspaces: workspaceMetadataList,\n    reports: Object.values(reportMetadataMap)\n};\n\nreturn result;"
          },
