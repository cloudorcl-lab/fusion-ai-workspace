        {
          "metadata": {
            "name": "Update BOSS Extract Response Fields",
            "returnType": "array",
            "sourceCode": "const updateFieldNames = (data, mapping) => {\n  if(!data) return [];\n\n  return data.map((item) => {\n    const transformed = {};\n\n    for (const [key, value] of Object.entries(item)) {\n      const newKey = mapping[key] ?? key;\n      transformed[newKey] = value;\n    }\n\n    return transformed;\n  });\n}\n\nconst bossExtractResponse = $context.$nodes.BOSS_EXTRACT_ENDPOINT.$output;\nconst colToFieldMapping = $context.$variables.colToFieldMap;\n\nreturn updateFieldNames(bossExtractResponse, colToFieldMapping);"
          },
          "outcomes": {
            "success": "1772449667176"
          },
          "code": "UPDATE_BOSS_EXTRACT_RESPONSE_FIELDS",
          "id": "1772449433281",
          "inputs": [],
