            "name": "Normalize Boss AI Output",
            "returnType": "object",
            "sourceCode": "const cloneJson = (value) => {\n  if (value == null) return value;\n  try {\n    return JSON.parse(JSON.stringify(value));\n  } catch (e) {\n    return value;\n  }\n};\n\nconst formatCurrentDate = (value) => {\n  const text = value == null ? \"\" : String(value);\n  const isoMatch = text.match(/\\d{4}-\\d{2}-\\d{2}/);\n  if (isoMatch) return isoMatch[0];\n\n  const parsed = new Date(text);\n  if (!Number.isNaN(parsed.getTime())) {\n    return parsed.toISOString().slice(0, 10);\n  }\n\n  return new Date().toISOString().slice(0, 10);\n};\n\nconst output = cloneJson($context.$nodes.BOSS_AI.$output);\nconst firstQuery = Array.isArray(output?.queries) ? output.queries[0] : null;\nconst avUsage = firstQuery?.analyticViews?.avUsage1;\nconst filter = typeof avUsage?.filter === \"string\" ? avUsage.filter : \"\";\n\nif (filter.includes(\"accountingPeriod.$levelName = 'CALENDAR'\")) {\n  if (!avUsage.dimensions || typeof avUsage.dimensions !== \"object\") {\n    avUsage.dimensions = {};\n  }\n\n  if (!avUsage.dimensions.accountingPeriod || typeof avUsage.dimensions.accountingPeriod !== \"object\") {\n    avUsage.dimensions.accountingPeriod = {};\n  }\n\n  if (!avUsage.dimensions.accountingPeriod.accountingPeriod || typeof avUsage.dimensions.accountingPeriod.accountingPeriod !== \"object\") {\n    avUsage.dimensions.accountingPeriod.accountingPeriod = {};\n  }\n\n  avUsage.dimensions.accountingPeriod.accountingPeriod.filter = \"periodStartDate <= '\" + formatCurrentDate($context.$system.$currentDate) + \"'\";\n}\n\nreturn output;"
          },
