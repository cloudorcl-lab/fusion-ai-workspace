        {
          "metadata": {
            "name": "Create Column to Field Mapping",
            "returnType": "object",
            "sourceCode": "const mapFieldToName = (bql) => {\n  const mapping = {};\n\n  const firstQuery = Array.isArray(bql.queries) ? bql.queries[0] : null;\n  if (!firstQuery || typeof firstQuery.select !== 'string') {\n    return mapping; // No valid query/select found.\n  }\n\n  const columnSet = new Set();\n  const matches = firstQuery.select.match(/C\\d+/g);\n  if (matches) {\n    matches.forEach((m) => columnSet.add(m));\n  }\n\n  const traverse = (node, path = [], insideDimensions = false) => {\n    if (Array.isArray(node)) {\n      node.forEach((item) => traverse(item, path, insideDimensions));\n    } else if (node && typeof node === 'object') {\n      for (const [key, value] of Object.entries(node)) {\n        const nextInsideDimensions = insideDimensions || key === 'dimensions';\n        const nextPath = nextInsideDimensions && key !== 'dimensions' ? [...path, key] : path;\n\n        if (typeof value === 'string' && columnSet.has(value)) {\n          mapping[value] = nextInsideDimensions ? nextPath.join('.') : key;\n        } else {\n          traverse(value, nextPath, nextInsideDimensions);\n        }\n      }\n    }\n  };\n\n  traverse(firstQuery);\n  return mapping;\n};\n\nreturn mapFieldToName($context.$nodes.NORMALIZE_BOSS_AI_OUTPUT.$output.result);"
          },
          "outcomes": {
            "success": "1772448005525"
          },
          "code": "CREATE_COLUMN_TO_FIELD_MAPPING",
          "id": "1772447960819",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
