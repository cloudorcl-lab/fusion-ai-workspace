          "code": "PREDICT_CLASSIFICATION_CODE_FOR_M_ITEM",
          "id": "1767163591968",
          "inputs": [
            {
              "id": "1767163591970_1",
              "name": "prompt",
              "type": "string",
              "value": "- Infer Product Classification Type (like HTS US, ECCN etc) from {{$context.$nodes.APPROVE_CLASSIFICATION_DETAILS_FOR_MANUFACTURED_ITEM.$feedbackRecieved}} if present. If not, consider {{$context.$variables.prodClassType}} and set it to property prodClassType.\n\n Based on the data {{$context.$nodes.GET_MANUFACTURED_ITEM_COMPONENT_DETAILS.$output} (like classificationCode and productClassificationType, value and quantity for each component) + {{$context.$nodes.APPROVE_CLASSIFICATION_DETAILS_FOR_MANUFACTURED_ITEM.$feedbackRecieved}} , predict an HS classification code of 6 digits along with confidence of prediction for {{$context.$variables.itemGid}} and prodClassType.\n -Remove period (.) and assign the predicted HS classification code to property predictedClassificationCode as a string (in double quotes \"\").\n- Assign the confidence of prediction to property  \"confidence\".\n- Set \"canAutoSave\" as false by default. If confidence is greater than {{$context.$variables.confidenceThreshold}} , set property \"canAutoSave\" as true."
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"prodClassType\": {\n            \"type\": \"string\"\n        },\n        \"canAutoSave\": {\n            \"type\": \"boolean\"\n        },\n        \"confidence\": {\n            \"type\": \"string\"\n        },\n        \"predictedClassificationCode\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
