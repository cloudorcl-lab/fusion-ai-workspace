          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"canAutoSave\": {\n            \"type\": \"boolean\"\n        }\n    }\n}",
