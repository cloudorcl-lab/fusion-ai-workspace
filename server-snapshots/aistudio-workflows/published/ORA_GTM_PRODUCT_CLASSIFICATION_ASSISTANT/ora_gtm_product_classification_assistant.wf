        {
          "metadata": {
            "errorNodeId": "1766996534807",
            "name": "Extract attributes from remark",
            "returnType": "object",
            "sourceCode": "const remarkQualifiers = $context.$variables.remarkQualifiers;\nconst extractedRemarks = $context.$nodes.EXTRACT_REMARK_TEXT.$output.remarkDetails;\n\nconst itemAttributes = [];\n\nif (Array.isArray(remarkQualifiers) && remarkQualifiers.length > 0) {\n  const remarkDetails = Array.isArray(extractedRemarks) ? extractedRemarks : [];\n\n  for (const mapping of remarkQualifiers) {\n    if (!mapping || typeof mapping !== \"object\") {\n      continue;\n    }\n\n    for (const [attribute, expectedRemarkQualGid] of Object.entries(mapping)) {\n      const matchedRemark = remarkDetails.find(\n        (item) => item?.remarkQualGid === expectedRemarkQualGid\n      );\n\n      if (matchedRemark) {\n        itemAttributes.push({\n          attribute,\n          value: matchedRemark.remarkText ?? \"\"\n        });\n      }\n    }\n  }\n}\n\nreturn {\n  itemAttributes\n};"
          },
          "outcomes": {
            "success": "1766996534807"
          },
          "code": "EXTRACT_ATTRIBUTES_FROM_REMARK",
          "id": "1775554402288",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
