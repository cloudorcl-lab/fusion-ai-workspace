          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "name": "Has Drilldown App Context"
          },
          "outcomes": {
            "true": "1778131844356",
            "false": "1776799734286"
          },
          "code": "NEW_IF_NODE",
          "convergenceTargetId": "1775669780886",
          "id": "1778131608638",
          "inputs": [
            {
              "id": "1778131608638_condition",
              "name": "condition",
              "type": "string",
              "value": "{{((($context.$app.$OraAppContext != null && typeof $context.$app.$OraAppContext === \"object\" && $context.$app.$OraAppContext.payload != null && $context.$app.$OraAppContext.payload.riskType != null) || (typeof $context.$app.$OraAppContext === \"string\" && $context.$app.$OraAppContext.includes(\"riskType\"))) && $context.$app.$OraMessageHint !== \"InitSubtitle\" && $context.$app.$OraMessageHint !== \"Query\")}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Parse App Context Payload",
            "returnType": "object",
            "sourceCode": "const appContext = $context.$app.$OraAppContext;\n\nif (appContext && typeof appContext === 'object' && !Array.isArray(appContext)) {\n  return appContext;\n}\n\nif (typeof appContext === 'string' && appContext.trim() !== '') {\n  try {\n    const parsed = JSON.parse(appContext);\n\n    if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {\n      return parsed;\n    }\n  } catch (e) {\n    return { payload: {} };\n  }\n}\n\nreturn { payload: {} };"
          },
          "outcomes": {
            "success": "1778133959140"
          },
          "code": "NEW_CODE_NODE",
          "id": "1778131844356",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Set Drilldown Context Variables"
          },
          "outcomes": {
            "success": "1776451503417"
          },
          "code": "NEW_SET_FIELDS_NODE_1",
          "id": "1778133959140",
          "inputs": [
            {
              "id": "1778133959140_appContext",
              "name": "appContext",
              "value": "{{$context.$nodes.NEW_CODE_NODE.$output.result}}"
