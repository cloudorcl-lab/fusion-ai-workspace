{
  "workflowId": "300000331063922",
  "workflowCode": "ORA_PRC_PO_PROCUREMENT_RISKS_MONITOR",
  "name": "Procurement Risks Monitor",
  "description": "Assists procurement managers by providing a list of suspected procurement fraud cases identified within a Procurement Business Unit. This monitor integrates with both the Procurement Operations Workspace and Procurement Risk Details applications to support case analysis and monitoring.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
