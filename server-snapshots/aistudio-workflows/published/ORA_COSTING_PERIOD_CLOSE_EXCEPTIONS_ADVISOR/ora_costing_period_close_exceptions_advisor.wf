{
  "workflowId": "300000327004293",
  "workflowCode": "ORA_COSTING_PERIOD_CLOSE_EXCEPTIONS_ADVISOR",
  "name": "Costing Period Close Exceptions Advisor",
  "description": "Use this agent when the user asks about cost accounting period-end validation exceptions or related error counts. The agent retrieves information about validation exceptions that occur during the period close process in Cost Accounting and provides details such as the type of exception and the number of errors identified. And period will be ready for closure if there are no period close exceptions. This Agent is also responsible for changing context of Cost Organization, Cost Book and Period. If there are any exceptions, user cannot close the period.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
