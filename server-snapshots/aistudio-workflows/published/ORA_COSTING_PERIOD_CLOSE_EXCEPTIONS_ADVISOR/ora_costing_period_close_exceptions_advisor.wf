            "name": "Check Period Is In Week One or Not",
            "returnType": "boolean",
            "sourceCode": "const start = new Date($context.$variables.periodStartDate);\nconst current = new Date($context.$system.$currentDate);\n//const current = new Date(\"2026-05-15\");\n\nif (isNaN(start.getTime()) || isNaN(current.getTime())) {\n  return false;\n}\n\nstart.setHours(0, 0, 0, 0);\ncurrent.setHours(0, 0, 0, 0);\n\nconst daysDifference = (current.getTime() - start.getTime()) / (1000 * 60 * 60 * 24);\n\nreturn daysDifference >= 0 && daysDifference <= 6;"
          },
          "outcomes": {
            "success": "1777379651057"
          },
          "code": "CHECK_PERIOD_IS_IN_WEEK_ONE_OR_NOT",
          "id": "1777379377102",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Check If First Week"
          },
          "outcomes": {
            "true": "1777386534011",
            "false": "1777379751866"
          },
