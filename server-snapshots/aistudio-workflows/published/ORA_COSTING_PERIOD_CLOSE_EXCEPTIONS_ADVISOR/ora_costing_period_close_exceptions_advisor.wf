            "name": "Get Summary of PEV Errors",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.CSTPERIOD_CLOSE_VALIDATION_EXCEPTIONS.$output;\n\n// Map to store errorCode -> errorCount\nconst errorSummary = {};\n\nlet hasErrors = false;\n\n(data?.items || []).forEach(item => {\n  const errorCode = item.ErrorCode;\n  const count = Number(item.ErrorCount) || 0;\n\n  // Track if any error exists\n  if (count > 0) {\n    hasErrors = true;\n  }\n\n  // Aggregate counts per error code (safe even if duplicates appear)\n  if (errorCode) {\n    errorSummary[errorCode] = (errorSummary[errorCode] || 0) + count;\n  }\n});\n\nconsole.debug(hasErrors);\n\nreturn errorSummary;"
          },
          "outcomes": {
            "success": "1777827701690"
          },
          "code": "GET_SUMMARY_OF_PEV_ERRORS",
          "id": "1777893085595",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
