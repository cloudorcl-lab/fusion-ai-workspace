          },
          "code": "RETURN_ACTION_REQUIRED_RESPONSE",
          "id": "1778535518671",
          "inputs": [
            {
              "id": "1778535518672_1",
              "name": "prompt",
              "type": "string",
              "value": "Use this payload:\n{{$context.$nodes.BUILD_ACTION_REQUIRED_RESPONSE.$output.result}}\n\nReturn:\n1) the message exactly from `message`\n2) exactly one action per item in `actions`\n\nSTRICT:\n- Render actions exactly as provided with all properties unchanged.\n- Do not add/remove/rename properties.\n- Do not add commentary.\n- If actions is empty, return only the message."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Build Action Required Response",
            "returnType": "object",
            "sourceCode": "const r = $context.$nodes.EXTRACT_CONTEXT.$output.result || {};\nconst srcActions = Array.isArray(r.Actions) ? r.Actions : [];\n\nconst actions = srcActions.map((a) => {\n  if (a.code === \"SWITCH_TO_CURRENT_OPEN_PERIOD\") {\n    return {\n      title: a.label,\n      description: `Switch app context to current open period ${a.targetPeriodName}.`,\n      buttonText: \"Switch Period\",\n      command: `ora.Invoke(switchContext, ${a.targetContext})`,\n      priority: false\n    };\n  }\n\n  if (a.code === \"OPEN_NEXT_ELIGIBLE_PERIOD\") {\n    return {\n      title: a.label,\n      description: `Current requested period is never opened. Open ${a.targetPeriodName} to continue.`,\n      buttonText: \"Open Period\",\n      command: `ora.Agent(\"OPEN_NEXT_ELIGIBLE_PERIOD\", {\"costOrganizationId\":\"${a.targetCostOrganizationId}\",\"costBookId\":\"${a.targetCostBookId}\",\"periodName\":\"${a.targetPeriodName}\"})`,\n      priority: false\n    };\n  }\n\n  return null;\n}).filter(Boolean);\n\nreturn {\n  message: r.Message || \"Requested period is Never Opened.\",\n  actions\n};\n"
          },
          "outcomes": {
            "success": "1778535518671"
          },
          "code": "BUILD_ACTION_REQUIRED_RESPONSE",
          "id": "1778536793664",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
