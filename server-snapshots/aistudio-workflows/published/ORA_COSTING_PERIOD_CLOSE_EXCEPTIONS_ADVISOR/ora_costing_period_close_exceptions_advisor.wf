          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
        },
        {
          "metadata": {
            "name": "Extract Context",
            "returnType": "object",
            "sourceCode": "const rawOutput = $context?.$nodes?.ESTABLISH_CONTEXT?.$output?.output;\nlet parsed = {};\n\ntry {\n  parsed =\n    typeof rawOutput === \"string\"\n      ? JSON.parse(rawOutput)\n      : rawOutput || {};\n} catch (e) {\n  parsed = {};\n}\n\nconst result = parsed?.result || {};\nconst data = result?.data || {};\n\nreturn {\n  ok: result?.ok ?? false,\n  status: result?.status ?? null,\n  mode: result?.mode ?? null,\n\n  CostOrganizationName: data?.CostOrganizationName ?? null,\n  CostOrganizationId: data?.CostOrganizationId ?? null,\n  CostBookCode: data?.CostBookCode ?? null,\n  CostBookId: data?.CostBookId ?? null,\n  PeriodName: data?.PeriodName ?? null,\n  LedgerId: data?.LedgerId ?? null,\n  PeriodStartDate: data?.PeriodStartDate ?? null,\n  PeriodEndDate: data?.PeriodEndDate ?? null,\n  PeriodStatusCode: data?.PeriodStatusCode ?? null,\n  PeriodStatus: data?.PeriodStatus ?? null,\n  LastProcessId: data?.LastProcessId ?? null,\n  PeriodCloseDate: data?.PeriodCloseDate ?? null,\n  PeriodFinalCloseDate: data?.PeriodFinalCloseDate ?? null,\n  NoteIdentifier: data?.NoteIdentifier ?? null,\n  ValidationRunDate: data?.ValidationRunDate ?? null,\n  PriorPeriodName: data?.PriorPeriodName ?? null,\n\n  Message: data?.Message ?? null,\n  Actions: Array.isArray(data?.Actions) ? data.Actions : [],\n  RequestedPeriodName: data?.RequestedPeriodName ?? null,\n  CurrentOpenPeriodName: data?.CurrentOpenPeriodName ?? null,\n  NextEligiblePeriodName: data?.NextEligiblePeriodName ?? null,\n  CurrentOpenContext: data?.CurrentOpenContext ?? null,\n  NextEligibleContext: data?.NextEligibleContext ?? null,\n\n  errorCode: result?.errorCode ?? null,\n  errorMessage: result?.errorMessage ?? null\n};"
          },
          "outcomes": {
            "success": "1777669307249"
          },
