        {
          "metadata": {
            "name": "Extract Switch to Current Open Period Context",
            "returnType": "object",
            "sourceCode": "const oraAction = $context?.$triggers?.REST?.$input?.OraAction || \"\";\nlet targetContext = null;\n\n// Case 1: raw context string passed directly\nif (oraAction && oraAction.includes(\":\") && !oraAction.includes(\"ora.\")) {\n  targetContext = oraAction.trim();\n}\n\n// Case 2: command style\n// ora.Invoke(switchContext, 100000012270096:300100007497625:Jan-25)\nif (!targetContext) {\n  const m = oraAction.match(/ora\\.Invoke\\(switchContext,\\s*([^)]+)\\)/);\n  if (m && m[1]) {\n    targetContext = m[1].trim();\n  }\n}\n\n// Fallback from extracted context node action payload if needed\nif (!targetContext) {\n  const actions = $context?.$nodes?.EXTRACT_CONTEXT?.$output?.result?.Actions || [];\n  const a = actions.find(x => x.code === \"SWITCH_TO_CURRENT_OPEN_PERIOD\");\n  targetContext = a?.targetContext || null;\n}\n\nreturn {\n  targetContext\n};"
          },
          "outcomes": {
            "success": "1778539970043"
          },
          "code": "EXTRACT_SWITCH_TO_CURRENT_OPEN_PERIOD_CONTEXT",
