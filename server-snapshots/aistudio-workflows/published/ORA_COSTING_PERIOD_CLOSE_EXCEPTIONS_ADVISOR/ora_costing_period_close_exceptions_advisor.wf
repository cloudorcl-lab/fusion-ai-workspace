            "name": "Extract Open Next Eligible Period Payload",
            "returnType": "object",
            "sourceCode": "const oraAction = $context?.$triggers?.REST?.$input?.OraAction || \"\";\n\n// Try raw JSON first\nlet payload = null;\ntry {\n  const parsed = JSON.parse(oraAction);\n  if (parsed && parsed.costOrganizationId && parsed.costBookId && parsed.periodName) {\n    payload = parsed;\n  }\n} catch (e) {}\n\n// Fallback: extract first JSON object from action text\n// Works for both:\n// 1) ora.Agent(\"OPEN_NEXT_ELIGIBLE_PERIOD\", {...})\n// 2) OPEN_NEXT_ELIGIBLE_PERIOD\", {...}\nif (!payload) {\n  const m = oraAction.match(/\\{[\\s\\S]*\\}/);\n  if (m && m[0]) {\n    try {\n      payload = JSON.parse(m[0]);\n    } catch (e) {}\n  }\n}\n\nreturn {\n  costOrganizationId: payload?.costOrganizationId ?? null,\n  costBookId: payload?.costBookId ?? null,\n  periodName: payload?.periodName ?? null\n};\n"
          },
          "outcomes": {
            "success": "1778013455960"
          },
