        },
        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_PAYABLES_PAYABLESINTELLIGENTDOCUMENTRECOGINITIONOPTIONSEXTENSIONSBO",
            "functionName": "GetAll_IDROptionExtensions",
            "processJson": true,
            "name": "Get IDR Option Extensions for SAVE"
          },
          "outcomes": {
            "success": "1810000000400"
          },
          "code": "GET_IDR_EXTENSIONS_SAVE",
          "id": "1810000000350",
          "inputs": [],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Build PATCH inputs",
            "returnType": "object",
            "sourceCode": "const targetToBossFieldMap = {\n  \"Recognize Tax Amount\": \"recognizeTaxAmountFlag\",\n  \"Recognize Freight Amount\": \"recognizeFreightAmountFlag\",\n  \"Recognize Lines for Matched Invoices\": \"importLinesMatchedFlag\",\n  \"Recognize Lines for Unmatched Invoices\": \"importLinesUnmatchedFlag\",\n  \"Calculate Tax During Import\": \"calculateTaxDuringImportFlag\",\n  \"Always Create Invoices in Incomplete Status\": \"enforceIncompleteStatusFlag\",\n  \"Create Single Invoice line for Service Orders\": \"singleLineAmountPoFlag\",\n  \"Create Single Invoice Line for Utility Suppliers\": \"singleLineUtilityInvoiceFlag\",\n  \"Import only Paired lines for Matched Invoices\": \"importPairedLinesOnlyFlag\",\n  \"Validate Legal Entity Identified for Matched Invoices\": \"validateLegalEntityForMatchedInvoicesFlag\"\n};\n\nconst createDefaults = {\n  recognizeTaxAmountFlag: null,\n  recognizeFreightAmountFlag: true,\n  importLinesMatchedFlag: true,\n  importLinesUnmatchedFlag: true,\n  calculateTaxDuringImportFlag: true,\n  enforceIncompleteStatusFlag: null,\n  singleLineAmountPoFlag: null,\n  singleLineUtilityInvoiceFlag: null,\n  importPairedLinesOnlyFlag: true,\n  validateLegalEntityForMatchedInvoicesFlag: null\n};\n\nconst createOnlyDefaults = {\n  documentAttachmentFlag: true,\n  docxAttachmentFlag: true,\n  tiffAttachmentFlag: true,\n  pngAttachmentFlag: true,\n  jpegAttachmentFlag: true,\n  pdfAttachmentFlag: true\n};\n\nconst createProrateFreightDefault = \"Yes\";\n\nconst buModeValueToCodeMap = {\n  \"email routing attribute\": \"RA\",\n  \"recipient email\": \"RE\",\n  \"sender's email\": \"SE\",\n  \"none\": \"N\"\n};\n\nconst supportedBuModeValuesText = \"Recipient Email, Sender's Email, Email Routing Attribute, None\";\n\nfunction normalizeAttributeName(value) {\n  if (value === null || value === undefined) {\n    return \"\";\n  }\n\n  return String(value).trim().replace(/\\s+/g, \" \");\n}\n\nfunction getBossField(attributeName) {\n  return targetToBossFieldMap[normalizeAttributeName(attributeName)];\n}\n\nfunction isProrateFreightAttribute(attributeName) {\n  return normalizeAttributeName(attributeName) === \"Prorate Freight and Miscellaneous Lines\";\n}\n\nfunction isBusinessUnitDerivationAttribute(attributeName) {\n  return normalizeAttributeName(attributeName) === \"Business Unit Derivation Mode for Emails\";\n}\n\nfunction parsePayload(value) {\n  if (typeof value === \"string\") {\n    try {\n      return JSON.parse(value || \"{}\");\n    } catch (error) {\n      return { __parseError: error.message };\n    }\n  }\n  return value || {};\n}\n\nfunction unwrapInputPayload(raw) {\n  const rootPayload = parsePayload(raw);\n  return rootPayload.InputPayload || rootPayload.inputPayload || rootPayload;\n}\n\nfunction unwrapNodeOutput(raw) {\n  return raw?.output || raw?.result?.output || raw?.result || raw || {};\n}\n\nfunction getSingletonRecord(raw) {\n  const output = unwrapNodeOutput(raw);\n  const response = output.response || output;\n\n  if (Array.isArray(response.items)) {\n    return response.items[0] || null;\n  }\n\n  if (Array.isArray(output.items)) {\n    return output.items[0] || null;\n  }\n\n  return response && Object.keys(response).length ? response : null;\n}\n\nfunction getItems(raw) {\n  const output = unwrapNodeOutput(raw);\n  const response = output.response || output;\n  return response.items || output.items || [];\n}\n\nfunction safeClone(value) {\n  try {\n    return JSON.parse(JSON.stringify(value));\n  } catch (error) {\n    return value;\n  }\n}\n\nfunction normalizeDetails(detailsValue) {\n  let details = detailsValue;\n\n  if (typeof detailsValue === \"string\") {\n    try {\n      details = JSON.parse(detailsValue || \"[]\");\n    } catch (error) {\n      return [];\n    }\n  }\n\n  if (!Array.isArray(details)) {\n    return [];\n  }\n\n  return details.map(detail => {\n    const outputDetail = safeClone(detail) || {};\n\n    if (!Array.isArray(outputDetail.targets)) {\n      outputDetail.targets = [];\n    }\n\n    if (!Array.isArray(outputDetail.influences)) {\n      outputDetail.influences = [];\n    }\n\n    outputDetail.status = \"\";\n    outputDetail.errorMessage = null;\n\n    return outputDetail;\n  });\n}\n\nfunction normalizeFlagValue(value) {\n  if (value === true || value === false || value === null || value === undefined) {\n    return value;\n  }\n\n  const normalized = String(value).trim();\n\n  if (normalized === \"Yes\") {\n    return true;\n  }\n\n  if (normalized === \"No\") {\n    return false;\n  }\n\n  return value;\n}\n\nfunction toReadableFlagValue(value) {\n  const normalized = normalizeFlagValue(value);\n\n  if (normalized === true) {\n    return \"Yes\";\n  }\n\n  if (normalized === false) {\n    return \"No\";\n  }\n\n  return null;\n}\n\nfunction isYesNoInput(value) {\n  if (typeof value !== \"string\") {\n    return false;\n  }\n\n  const normalized = value.trim();\n  return normalized === \"Yes\" || normalized === \"No\";\n}\n\nfunction isBooleanLike(value) {\n  return isYesNoInput(value);\n}\n\nfunction normalizeRequestedBuModeCode(value) {\n  if (value === null || value === undefined || value === \"\") {\n    return undefined;\n  }\n  const normalized = String(value).trim().toLowerCase();\n  return buModeValueToCodeMap[normalized];\n}\n\nfunction normalizeStoredBuModeCode(value) {\n  if (value === null || value === undefined || value === \"\") {\n    return undefined;\n  }\n\n  const normalized = String(value).trim().toLowerCase();\n  const displayCode = buModeValueToCodeMap[normalized];\n  if (displayCode) {\n    return displayCode;\n  }\n\n  const code = String(value).trim().toUpperCase();\n  return [\"RA\", \"RE\", \"SE\", \"N\"].includes(code) ? code : undefined;\n}\n\nfunction markDetailPublishError(detail, message) {\n  detail.status = \"Publish_Error\";\n  detail.errorMessage = message;\n}\n\nfunction markAllDetailsPublishError(details, message) {\n  return (details || []).map(detail => {\n    const outputDetail = safeClone(detail) || {};\n    const hasSpecificError = outputDetail.status === \"Publish_Error\" && outputDetail.errorMessage;\n\n    outputDetail.status = \"Publish_Error\";\n    outputDetail.errorMessage = hasSpecificError ? outputDetail.errorMessage : null;\n\n    return outputDetail;\n  });\n}\n\nfunction findTargetValue(inputJson, attributeName) {\n  for (const detail of inputJson.details || []) {\n    if (detail.subCategory !== \"Document Processing\" || detail.status === \"Publish_Error\") {\n      continue;\n    }\n\n    for (const target of detail.targets || []) {\n      if (normalizeAttributeName(target.attribute) === normalizeAttributeName(attributeName)) {\n        return target.value;\n      }\n    }\n  }\n  return undefined;\n}\n\nfunction hasPublishableDetails(inputJson) {\n  return (inputJson.details || []).some(detail =>\n    detail.subCategory === \"Document Processing\" && detail.status !== \"Publish_Error\"\n  );\n}\n\nfunction hasUsableDocumentProcessingDetails(inputJson) {\n  return (inputJson.details || []).some(detail => {\n    if (detail.subCategory !== \"Document Processing\") {\n      return false;\n    }\n\n    const targets = Array.isArray(detail.targets) ? detail.targets : [];\n    return targets.some(target => target && normalizeAttributeName(target.attribute));\n  });\n}\n\nfunction validateDetails(inputJson) {\n  const errors = [];\n\n  if (!Array.isArray(inputJson.details) || inputJson.details.length === 0 || !hasUsableDocumentProcessingDetails(inputJson)) {\n    errors.push(\"policyDetails is empty\");\n    return errors;\n  }\n\n  for (const detail of inputJson.details || []) {\n    if (detail.subCategory !== \"Document Processing\") {\n      continue;\n    }\n\n    for (const target of detail.targets || []) {\n      if (!target || !target.attribute) {\n        markDetailPublishError(detail, \"Each target must contain an attribute.\");\n        errors.push(detail.errorMessage);\n        continue;\n      }\n\n      const attributeName = normalizeAttributeName(target.attribute);\n\n      if (getBossField(attributeName) && !isBooleanLike(target.value)) {\n        markDetailPublishError(detail, attributeName + \" must be Yes or No.\");\n        errors.push(detail.errorMessage);\n      }\n\n      if (isProrateFreightAttribute(attributeName) && !isBooleanLike(target.value)) {\n        markDetailPublishError(detail, \"Prorate Freight and Miscellaneous Lines must be Yes or No.\");\n        errors.push(detail.errorMessage);\n      }\n\n      if (isBusinessUnitDerivationAttribute(attributeName)) {\n        const code = normalizeRequestedBuModeCode(target.value);\n        if (![\"RA\", \"RE\", \"SE\", \"N\"].includes(code)) {\n          markDetailPublishError(\n            detail,\n            \"Unsupported Business Unit Derivation Mode value. Supported values: \" + supportedBuModeValuesText\n          );\n          errors.push(detail.errorMessage);\n        }\n      }\n    }\n  }\n\n  return errors;\n}\n\nfunction buildSyntheticErrorDetail(message) {\n  return [\n    {\n      subCategory: \"Document Processing\",\n      status: \"Publish_Error\",\n      errorMessage: message,\n      targets: {}\n    }\n  ];\n}\n\nfunction invalidResponse(message, details, validationErrors) {\n  const errors = validationErrors || [];\n  const outputDetails = Array.isArray(details) && details.length > 0\n    ? markAllDetailsPublishError(details, message)\n    : buildSyntheticErrorDetail(errors[0] || message);\n\n  return {\n    agentOperation: \"SAVE\",\n    operation: \"SAVE\",\n    routeDecision: \"STOP\",\n    Message: message,\n    details: outputDetails,\n    validationErrors: errors\n  };\n}\n\nfunction findExtensionRecord(extensionItems, optionCode) {\n  return extensionItems.find(item => item.optionCode === optionCode);\n}\n\nfunction extensionId(record) {\n  return record?.extensionOptionId || record?.$id || record?.id;\n}\n\nfunction extensionEtag(record) {\n  return record?.$context?.etag || record?.etag || record?.eTag || record?.ETag;\n}\n\nfunction normalizeEtag(value) {\n  if (value === undefined || value === null) {\n    return \"\";\n  }\n\n  const text = String(value).trim();\n  if (text.startsWith('\"') && text.endsWith('\"')) {\n    return text.slice(1, -1);\n  }\n\n  return text;\n}\n\nfunction quoteHeaderEtag(value) {\n  return normalizeEtag(value);\n}\n\nfunction buildPatchPayload(inputJson, getResponse, saveAction) {\n  const patchPayload = {};\n\n  for (const detail of inputJson.details || []) {\n    if (detail.subCategory !== \"Document Processing\" || detail.status === \"Publish_Error\") {\n      continue;\n    }\n\n    for (const target of detail.targets || []) {\n      const bossField = getBossField(target.attribute);\n\n      if (bossField) {\n        patchPayload[bossField] = normalizeFlagValue(target.value);\n      }\n    }\n  }\n\n  for (const bossField of Object.values(targetToBossFieldMap)) {\n    if (patchPayload[bossField] !== undefined) {\n      continue;\n    }\n\n    if (saveAction === \"UPDATE\") {\n      patchPayload[bossField] = getResponse && getResponse[bossField] !== undefined\n        ? getResponse[bossField]\n        : null;\n    } else {\n      patchPayload[bossField] = createDefaults[bossField];\n    }\n  }\n\n  if (saveAction === \"CREATE\") {\n    Object.assign(patchPayload, createOnlyDefaults);\n  }\n\n  return patchPayload;\n}\n\nconst payload = unwrapInputPayload($context.$variables.ProcessingOptionsPayload);\nconst inputJson = payload.inputJson || payload;\n\nif (inputJson.__parseError) {\n  return invalidResponse(\"Input payload is not valid JSON.\", [], [inputJson.__parseError]);\n}\n\ninputJson.details = normalizeDetails(inputJson.details);\n\nconst validationErrors = validateDetails(inputJson);\nif (validationErrors.length > 0) {\n  return invalidResponse(\"Validation failed. No BOSS write operation was called.\", inputJson.details, validationErrors);\n}\n\nconst getResponse = getSingletonRecord($context.$nodes.GET_IDR_SAVE.$output);\nconst extensionItems = getItems($context.$nodes.GET_IDR_EXTENSIONS_SAVE.$output);\nconst saveAction = getResponse ? \"UPDATE\" : \"CREATE\";\n\nconst patchPayload = buildPatchPayload(inputJson, getResponse, saveAction);\nconst etag = getResponse?.$context?.etag || getResponse?.etag || getResponse?.eTag || getResponse?.ETag;\n\nconst requestedBuValue = findTargetValue(inputJson, \"Business Unit Derivation Mode for Emails\");\nconst requestedBuCode = normalizeRequestedBuModeCode(requestedBuValue);\nconst currentBuCode = normalizeStoredBuModeCode(getResponse?.overrideDefaultBusinessUnitCode);\nconst finalBuCode = requestedBuCode !== undefined ? requestedBuCode : saveAction === \"UPDATE\" ? currentBuCode || null : null;\npatchPayload.overrideDefaultBusinessUnitCode = finalBuCode;\nconst overrideDefaultBusinessUnitCodeJson = finalBuCode === null ? \"null\" : JSON.stringify(finalBuCode);\n\nconst imageExtensionRecord = findExtensionRecord(extensionItems, \"ORA_AP_IMAGES\");\nconst imageExtensionId = extensionId(imageExtensionRecord);\nlet buExtensionAction = \"NONE\";\n\nif (saveAction === \"UPDATE\" && requestedBuCode && requestedBuCode !== currentBuCode && [\"RE\", \"SE\"].includes(currentBuCode) && imageExtensionId) {\n  buExtensionAction = \"DELETE_ONLY\";\n}\n\nconst requestedProrateValue = findTargetValue(inputJson, \"Prorate Freight and Miscellaneous Lines\");\nconst prorateExtensionRecord = findExtensionRecord(extensionItems, \"AP_PRORATE_FREIGHT_MISC\");\nconst prorateExtensionId = extensionId(prorateExtensionRecord);\nconst prorateExtensionIfMatch = extensionEtag(prorateExtensionRecord);\nconst currentProrateFlag = normalizeFlagValue(prorateExtensionRecord?.enabledFlag);\nconst effectiveProrateValue = requestedProrateValue !== undefined\n  ? requestedProrateValue\n  : saveAction === \"CREATE\"\n    ? createProrateFreightDefault\n    : toReadableFlagValue(currentProrateFlag);\nconst requestedProrateFlag = effectiveProrateValue !== undefined\n  ? normalizeFlagValue(effectiveProrateValue)\n  : undefined;\nconst isProrateChanged = requestedProrateValue !== undefined && requestedProrateFlag !== currentProrateFlag;\nconst freightExtensionAction = saveAction === \"UPDATE\" && isProrateChanged && prorateExtensionId ? \"PATCH\" : \"NONE\";\nconst createFreightExtensionAction = saveAction === \"CREATE\" && requestedProrateFlag !== undefined && !prorateExtensionId ? \"CREATE\" : \"NONE\";\n\nreturn {\n  operation: \"SAVE\",\n  saveAction,\n  routeDecision: \"CONTINUE\",\n  Message: validationErrors.length > 0\n    ? \"Validation completed with detail-level errors. Valid details are prepared for BOSS write.\"\n    : saveAction === \"CREATE\"\n      ? \"Validation successful. IDR Options record does not exist; create operation is prepared.\"\n      : \"Validation successful. IDR Options update operation is prepared.\",\n  validationErrors,\n  details: inputJson.details,\n  payablesIntelligentDocumentRecognitionOptions_id: getResponse?.$id || getResponse?.idrOptionsId || \"\",\n  ifMatch: quoteHeaderEtag(etag),\n  overrideDefaultBusinessUnitCode: finalBuCode,\n  overrideDefaultBusinessUnitCodeJson,\n  buExtensionAction,\n  buExtensionDeleteId: imageExtensionId,\n  freightExtensionAction,\n  freightExtensionId: prorateExtensionId,\n  freightExtensionIfMatch: quoteHeaderEtag(prorateExtensionIfMatch),\n  freightExtensionOptionCode: \"AP_PRORATE_FREIGHT_MISC\",\n  freightExtensionEnabledFlag: requestedProrateFlag,\n  freightExtensionOptionValue: prorateExtensionRecord?.optionValue || \"\",\n  createFreightExtensionAction,\n  createFreightExtensionOptionCode: \"AP_PRORATE_FREIGHT_MISC\",\n  createFreightExtensionEnabledFlag: requestedProrateFlag,\n  createFreightExtensionOptionValue: \"\",\n  requestedBusinessUnitDerivationMode: requestedBuValue,\n  currentBusinessUnitDerivationModeCode: currentBuCode,\n  finalBusinessUnitDerivationModeCode: finalBuCode,\n  requestedProrateFreightMiscellaneousLines: effectiveProrateValue,\n  ...patchPayload,\n  overrideDefaultBusinessUnitCode: finalBuCode,\n  overrideDefaultBusinessUnitCodeJson\n};"
