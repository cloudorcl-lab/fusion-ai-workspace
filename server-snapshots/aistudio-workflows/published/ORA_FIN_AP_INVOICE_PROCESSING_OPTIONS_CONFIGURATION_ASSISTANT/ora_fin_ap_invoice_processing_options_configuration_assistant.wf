        },
        {
          "metadata": {
            "name": "Build READ response",
            "returnType": "object",
            "sourceCode": "const bossFieldToTargetMap = {\n  \"recognizeTaxAmountFlag\": \"Recognize Tax Amount\",\n  \"recognizeFreightAmountFlag\": \"Recognize Freight Amount\",\n  \"importLinesMatchedFlag\": \"Recognize Lines for Matched Invoices\",\n  \"importLinesUnmatchedFlag\": \"Recognize Lines for Unmatched Invoices\",\n  \"calculateTaxDuringImportFlag\": \"Calculate Tax During Import\",\n  \"enforceIncompleteStatusFlag\": \"Always Create Invoices in Incomplete Status\",\n  \"singleLineAmountPoFlag\": \"Create Single Invoice line for Service Orders\",\n  \"singleLineUtilityInvoiceFlag\": \"Create Single Invoice Line for Utility Suppliers\",\n  \"importPairedLinesOnlyFlag\": \"Import only Paired lines for Matched Invoices\",\n  \"validateLegalEntityForMatchedInvoicesFlag\": \"Validate Legal Entity Identified for Matched Invoices\"\n};\n\nconst businessUnitDerivationModeMap = {\n  \"RA\": \"Email Routing Attribute\",\n  \"RE\": \"Recipient Email\",\n  \"SE\": \"Sender's Email\",\n  \"N\": \"None\"\n};\n\nfunction unwrapNodeOutput(raw) {\n  return raw?.output || raw?.result?.output || raw?.result || raw || {};\n}\n\nfunction responseStatus(output) {\n  return output?.responseStatus || output?.status || null;\n}\n\nfunction isSuccessStatus(status) {\n  if (status === null || status === undefined) {\n    return true;\n  }\n\n  const numericStatus = Number(status);\n  return numericStatus === 200 || numericStatus === 201 || numericStatus === 204;\n}\n\nfunction extractBossError(output) {\n  const response = output?.response || output?.body || output || {};\n\n  if (typeof response === \"string\") {\n    return response || \"BOSS read failed.\";\n  }\n\n  return response.message || response.detail || response.title || output.message || \"BOSS read failed.\";\n}\n\nfunction buildResponse(details) {\n  return {\n    agentOperation: \"READ\",\n    details: details || []\n  };\n}\n\nfunction errorDetail(message) {\n  return [\n    {\n      subCategory: \"Document Processing\",\n      status: \"Publish_Error\",\n      errorMessage: message,\n      targets: {}\n    }\n  ];\n}\n\nfunction getSingletonRecord(output) {\n  const response = output.response || output;\n\n  if (Array.isArray(response.items)) {\n    return response.items[0] || null;\n  }\n\n  if (Array.isArray(output.items)) {\n    return output.items[0] || null;\n  }\n\n  if (response.title || response.message || response.detail) {\n    return null;\n  }\n\n  return response && Object.keys(response).length ? response : null;\n}\n\nfunction toReadableValue(value) {\n  if (value === true) {\n    return \"Yes\";\n  }\n  if (value === false || value === null) {\n    return \"No\";\n  }\n  return value;\n}\n\nfunction buildReadDetail(targets) {\n  return [\n    {\n      subCategory: \"Document Processing\",\n      status: \"Published\",\n      errorMessage: null,\n      targets\n    }\n  ];\n}\n\nfunction buildMissingIdrOptionsDefaultTargets() {\n  return {\n    \"Recognize Tax Amount\": \"No\",\n    \"Recognize Freight Amount\": \"Yes\",\n    \"Recognize Lines for Matched Invoices\": \"Yes\",\n    \"Recognize Lines for Unmatched Invoices\": \"Yes\",\n    \"Calculate Tax During Import\": \"Yes\",\n    \"Always Create Invoices in Incomplete Status\": \"No\",\n    \"Create Single Invoice line for Service Orders\": \"No\",\n    \"Create Single Invoice Line for Utility Suppliers\": \"No\",\n    \"Import only Paired lines for Matched Invoices\": \"Yes\",\n    \"Validate Legal Entity Identified for Matched Invoices\": \"No\",\n    \"Business Unit Derivation Mode for Emails\": \"None\",\n    \"Prorate Freight and Miscellaneous Lines\": \"Yes\"\n  };\n}\n\nconst idrOutput = unwrapNodeOutput($context.$nodes.GET_IDR_READ.$output);\nconst idrStatus = responseStatus(idrOutput);\n\nif (!isSuccessStatus(idrStatus)) {\n  return buildResponse(errorDetail(\"BOSS IDR options read failed: \" + extractBossError(idrOutput)));\n}\n\nconst extensionOutput = unwrapNodeOutput($context.$nodes.GET_IDR_EXTENSION_READ.$output);\nconst extensionStatus = responseStatus(extensionOutput);\n\nif (!isSuccessStatus(extensionStatus)) {\n  return buildResponse(errorDetail(\"BOSS IDR extension read failed: \" + extractBossError(extensionOutput)));\n}\n\nconst getResponse = getSingletonRecord(idrOutput);\nconst extensionResponse = getSingletonRecord(extensionOutput);\n\nif (!getResponse) {\n  return buildResponse(buildReadDetail(buildMissingIdrOptionsDefaultTargets()));\n}\n\nconst targets = {};\n\nfor (const [bossField, targetName] of Object.entries(bossFieldToTargetMap)) {\n  targets[targetName] = toReadableValue(getResponse[bossField]);\n}\n\nconst buModeCode = getResponse.overrideDefaultBusinessUnitCode;\ntargets[\"Business Unit Derivation Mode for Emails\"] =\n  businessUnitDerivationModeMap[buModeCode] || buModeCode || \"None\";\n\nif (extensionResponse && Object.prototype.hasOwnProperty.call(extensionResponse, \"enabledFlag\")) {\n  targets[\"Prorate Freight and Miscellaneous Lines\"] = toReadableValue(extensionResponse.enabledFlag);\n} else {\n  targets[\"Prorate Freight and Miscellaneous Lines\"] = null;\n}\n\nreturn buildResponse(buildReadDetail(targets));"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "BUILD_READ_RESPONSE",
          "id": "1810000000200",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"agentOperation\": {\n          \"type\": \"string\"\n        },\n        \"details\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\"\n          }\n        }\n      },\n      \"required\": [\n        \"agentOperation\",\n        \"details\"\n      ]\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_PAYABLES_PAYABLESINTELLIGENTDOCUMENTRECOGINITIONOPTIONSBO",
            "functionName": "List_payablesIntelligentDocumentRecognitionOptions",
            "processJson": true,
            "name": "Get IDR Options for SAVE"
          },
          "outcomes": {
