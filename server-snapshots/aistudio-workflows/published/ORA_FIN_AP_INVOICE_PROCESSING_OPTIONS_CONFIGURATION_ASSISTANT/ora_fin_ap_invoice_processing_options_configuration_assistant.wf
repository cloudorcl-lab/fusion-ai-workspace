        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_PAYABLES_PAYABLESINTELLIGENTDOCUMENTRECOGINITIONOPTIONSEXTENSIONSBO",
            "functionName": "GetFreightFlag",
            "processJson": true,
            "name": "Get IDR Option Extension for READ"
          },
          "outcomes": {
            "success": "1810000000200"
