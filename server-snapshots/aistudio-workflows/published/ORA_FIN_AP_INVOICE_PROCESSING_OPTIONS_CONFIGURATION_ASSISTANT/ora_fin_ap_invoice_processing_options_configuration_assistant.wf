          "metadata": {
            "name": "Build SAVE response",
            "returnType": "object",
            "sourceCode": "function unwrapNodeOutput(raw) {\n  return raw?.output || raw?.result?.output || raw?.result || raw || {};\n}\n\nfunction safeClone(value) {\n  try {\n    return JSON.parse(JSON.stringify(value));\n  } catch (error) {\n    return value;\n  }\n}\n\nfunction responseStatus(output, fallbackStatus) {\n  return output?.responseStatus || output?.status || fallbackStatus || null;\n}\n\nfunction isSuccessStatus(status) {\n  const numericStatus = Number(status);\n  return numericStatus === 200 || numericStatus === 201 || numericStatus === 204;\n}\n\nfunction extractBossError(output) {\n  const response = output?.response || output?.body || output || {};\n\n  if (typeof response === \"string\") {\n    return {\n      title: response,\n      message: response\n    };\n  }\n\n  return {\n    title: response.title || output.title || \"BOSS operation failed.\",\n    message: response.message || response.detail || response.title || output.message || \"BOSS operation failed.\",\n    detail: response.detail || null,\n    instance: response.instance || null,\n    traceId: response.traceId || output.traceId || null,\n    errorCode: response.errorCode || response.code || null\n  };\n}\n\nfunction setPublishStatus(details, status, errorMessage) {\n  return (details || []).map(detail => {\n    const outputDetail = safeClone(detail) || {};\n\n    if (outputDetail.status === \"Publish_Error\") {\n      return outputDetail;\n    }\n\n    outputDetail.status = status;\n    outputDetail.errorMessage = errorMessage || null;\n    return outputDetail;\n  });\n}\n\nfunction setAttributeStatus(details, attributeName, status, errorMessage) {\n  for (const detail of details || []) {\n    const targets = Array.isArray(detail.targets) ? detail.targets : [];\n    const hasAttribute = targets.some(target => target?.attribute === attributeName);\n\n    if (hasAttribute && detail.status !== \"Publish_Error\") {\n      detail.status = status;\n      detail.errorMessage = errorMessage || null;\n    }\n  }\n}\n\nfunction setPreUpdateFailureStatus(details, attributeName, errorMessage) {\n  return (details || []).map(detail => {\n    const outputDetail = safeClone(detail) || {};\n    const targets = Array.isArray(outputDetail.targets) ? outputDetail.targets : [];\n    const hasAttribute = targets.some(target => target?.attribute === attributeName);\n\n    outputDetail.status = \"Publish_Error\";\n    outputDetail.errorMessage = hasAttribute ? errorMessage : null;\n\n    return outputDetail;\n  });\n}\n\n\nfunction buildResponse(details) {\n  return {\n    agentOperation: \"SAVE\",\n    details: details || []\n  };\n}\n\nfunction extensionFailureMessage(actionName, output) {\n  const bossError = extractBossError(output);\n  return actionName + \" failed: \" + bossError.message;\n}\n\nconst patchInputsOutput = $context.$nodes.BUILD_PATCH_INPUTS.$output;\nconst patchInputs = patchInputsOutput?.result || patchInputsOutput?.output || patchInputsOutput || {};\n\nif (patchInputs.routeDecision === \"STOP\") {\n  return buildResponse(patchInputs.details || []);\n}\n\n\nconst saveAction = patchInputs.saveAction || \"UPDATE\";\nconst optionsNodeOutputRaw = saveAction === \"CREATE\"\n  ? $context.$nodes.CREATE_IDR_OPTIONS?.$output\n  : $context.$nodes.UPDATE_IDR_OPTIONS?.$output;\nconst optionsOutput = unwrapNodeOutput(optionsNodeOutputRaw);\nconst optionsStatus = responseStatus(optionsOutput, saveAction === \"CREATE\" ? 201 : 204);\n\nif (!isSuccessStatus(optionsStatus)) {\n  const bossError = extractBossError(optionsOutput);\n  return buildResponse(setPublishStatus(patchInputs.details, \"Publish_Error\", bossError.message));\n}\n\nconst details = setPublishStatus(patchInputs.details, \"Published\", null);\n\nif (patchInputs.buExtensionAction === \"DELETE_ONLY\") {\n  const deleteOutput = unwrapNodeOutput($context.$nodes.DELETE_BU_EXTENSION?.$output);\n  const deleteStatus = responseStatus(deleteOutput, 204);\n\n  if (!isSuccessStatus(deleteStatus)) {\n    setAttributeStatus(\n      details,\n      \"Business Unit Derivation Mode for Emails\",\n      \"Publish_Error\",\n      extensionFailureMessage(\"Business Unit Derivation Mode extension delete\", deleteOutput)\n    );\n  }\n}\n\nif (patchInputs.freightExtensionAction === \"PATCH\") {\n  const freightOutput = unwrapNodeOutput($context.$nodes.PATCH_FREIGHT_EXTENSION?.$output);\n  const freightStatus = responseStatus(freightOutput, 204);\n\n  if (!isSuccessStatus(freightStatus)) {\n    setAttributeStatus(\n      details,\n      \"Prorate Freight and Miscellaneous Lines\",\n      \"Publish_Error\",\n      extensionFailureMessage(\"Prorate Freight and Miscellaneous Lines extension update\", freightOutput)\n    );\n  }\n}\n\nif (patchInputs.createFreightExtensionAction === \"CREATE\") {\n  const freightCreateOutput = unwrapNodeOutput($context.$nodes.CREATE_PRORATE_EXTENSION?.$output);\n  const freightCreateStatus = responseStatus(freightCreateOutput, 201);\n\n  if (!isSuccessStatus(freightCreateStatus)) {\n    setAttributeStatus(\n      details,\n      \"Prorate Freight and Miscellaneous Lines\",\n      \"Publish_Error\",\n      extensionFailureMessage(\"Prorate Freight and Miscellaneous Lines extension create\", freightCreateOutput)\n    );\n  }\n}\n\nreturn buildResponse(details);"
          },
          "outcomes": {
            "success": "end"
          },
