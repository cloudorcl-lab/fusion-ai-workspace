          "code": "FORMAT_PURCHASE_AGREEMENT_QUERY",
          "id": "1771491612107",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Filter new Items",
            "returnType": "array",
            "sourceCode": "const processItems = (items, inquiry, partners,purchaseAgreements) => {\n  const masterItem = items.find(\n    (item) => item.InventoryItemId == $context.$nodes.EXTRACT_ITEM_AND_ORG.$output.result.ItemId\n  );\n\n  const componentItems = items\n    .filter((item) => item.InventoryItemId != $context.$nodes.EXTRACT_ITEM_AND_ORG.$output.result.ItemId)\n    .map((i) => {\n        const {InventoryItemId} = i;\n        const aggs = purchaseAgreements.filter(i=>i.ItemId==InventoryItemId)\n        let cost = 0\n        aggs.map(({Price,AgreementQuantity})=>{\n//            cost+=Number(Price)*Number(AgreementQuantity);\nif(cost===0){\ncost = Number(Price)\n}\nelse if(Number(Price)<cost){\ncost=Number(Price)\n}\n        })\n        const inquiryObject = (inquiry.find(i=>InventoryItemId==i.InventoryItemId) || {});\n        const PartnerCount = (partners.filter(i=>InventoryItemId==i.InventoryItemId) || []).length;\n        const Sourcing = aggs.length===0 ? \"Draft\":aggs.length===1?\"Single\":\"Multiple\";\n        const OnHandQuantity = inquiryObject.PrimaryOnhandQuantity\n      return {\n        ...i,\n        OnHandQuantity,\n        Sourcing,\n        Cost:cost\n      };\n    });\n\n  return {\n    title: masterItem && masterItem[\"Item.ItemNumber\"],\n    description: masterItem && masterItem[\"Item.ItemNumber\"],\n    components: componentItems,\n  };\n};\nconst resul = processItems(\n  $context.$nodes.FETCHITEMS.$output.items,\n  $context.$nodes.INQUIRY.$output.items,\n  $context.$nodes.GETPARTNERS.$output.items,\n $context.$nodes.FETCHPURCHASEAGREEMENTS.$output.items\n);\nconst normalizeText = (value = \"\") =>\n  String(value)\n    .toLowerCase()\n    .normalize(\"NFKD\")\n    .replace(/[\\u0300-\\u036f]/g, \"\") // strip accents\n    .replace(/&/g, \" and \")\n    .replace(/[^a-z0-9]+/g, \" \")\n    .replace(/\\s+/g, \" \")\n    .trim();\n\nconst tokenize = (value = \"\") => new Set(normalizeText(value).split(\" \").filter(Boolean));\n\nconst jaccardSimilarity = (aTokens, bTokens) => {\n  if (!aTokens.size && !bTokens.size) return 1;\n  if (!aTokens.size || !bTokens.size) return 0;\n\n  let intersection = 0;\n  const [small, large] = aTokens.size <= bTokens.size ? [aTokens, bTokens] : [bTokens, aTokens];\n  for (const t of small) if (large.has(t)) intersection += 1;\n  const union = aTokens.size + bTokens.size - intersection;\n  return union === 0 ? 0 : intersection / union;\n};\n\nconst levenshteinDistance = (a = \"\", b = \"\") => {\n  a = normalizeText(a);\n  b = normalizeText(b);\n  if (a === b) return 0;\n  if (!a) return b.length;\n  if (!b) return a.length;\n\n  const aLen = a.length;\n  const bLen = b.length;\n\n  let prev = new Array(bLen + 1);\n  let curr = new Array(bLen + 1);\n  for (let j = 0; j <= bLen; j++) prev[j] = j;\n\n  for (let i = 1; i <= aLen; i++) {\n    curr[0] = i;\n    const aChar = a.charCodeAt(i - 1);\n    for (let j = 1; j <= bLen; j++) {\n      const cost = aChar === b.charCodeAt(j - 1) ? 0 : 1;\n      curr[j] = Math.min(prev[j] + 1, curr[j - 1] + 1, prev[j - 1] + cost);\n    }\n    [prev, curr] = [curr, prev];\n  }\n  return prev[bLen];\n};\n\nconst levenshteinRatio = (a = \"\", b = \"\") => {\n  const na = normalizeText(a);\n  const nb = normalizeText(b);\n  const maxLen = Math.max(na.length, nb.length);\n  if (maxLen === 0) return 1;\n  return 1 - levenshteinDistance(na, nb) / maxLen;\n};\n\n/**\n * Name-focused fuzzy score (0..1).\n */\nconst scoreItemNameMatch = (existingItem, scannedItem) => {\n  const existingName = existingItem?.itemName ?? \"\";\n  const scannedName = scannedItem?.itemName ?? \"\";\n\n  const nameJacc = jaccardSimilarity(tokenize(existingName), tokenize(scannedName));\n  const nameLev = levenshteinRatio(existingName, scannedName);\n\n  // For catalog names, edit-distance is often more reliable than token overlap\n  // when OCR introduces small variations (e.g., aluminium vs aluminum).\n  return 0.4 * nameJacc + 0.6 * nameLev;\n};\n\n// -----------------------------\n// Public API\n// -----------------------------\n\n/**\n * It maps scanned item names to existing item names (fuzzy match), and returns\n * the scanned items that do not match any existing item.\n *\n * @param {Array<{itemName: string, itemDescription?: string}>} existingItems\n * @param {Array<{itemName: string, itemDescription?: string}>} scannedItems\n * @param {{ threshold?: number }} [options]\n * @returns {Array<{itemName: string, itemDescription?: string}>}\n */\nconst filterScannedItemsToCreate = (existingItems = [], scannedItems = [], options = {}) => {\n  const { threshold = 0.58 } = options;\n\n  if (!Array.isArray(existingItems)) throw new TypeError(\"existingItems must be an array\");\n  if (!Array.isArray(scannedItems)) throw new TypeError(\"scannedItems must be an array\");\n\n  const existingPre = existingItems.map((it) => ({\n    item: it,\n    nameTokens: tokenize(it?.itemName ?? \"\"),\n  }));\n\n  const unmatched = [];\n\n  for (const scanned of scannedItems) {\n    const scannedNameTokens = tokenize(scanned?.itemName ?? \"\");\n\n    let bestScore = -Infinity;\n    for (const ex of existingPre) {\n      // cheap prune: if there's no token overlap at all, skip\n      // (still allows cases like \"aluminium\" vs \"aluminum\" due to other shared tokens)\n      if (jaccardSimilarity(ex.nameTokens, scannedNameTokens) < 0.05) continue;\n      const score = scoreItemNameMatch(ex.item, scanned);\n      if (score > bestScore) bestScore = score;\n    }\n\n    if (!(bestScore >= threshold)) unmatched.push(scanned);\n  }\n\n  return unmatched;\n};\n\n\nconst existingItems = resul.components;\nconst newItems = $context.$nodes.EXTRACT_OUTPUT.$output.billOfMaterials\n\nreturn filterScannedItemsToCreate(existingItems,newItems)"
          },
          "outcomes": {
            "success": "1771852565914"
          },
