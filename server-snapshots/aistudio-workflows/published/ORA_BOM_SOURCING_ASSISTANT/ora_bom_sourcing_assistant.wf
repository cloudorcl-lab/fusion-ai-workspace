          "inputs": [
            {
              "id": "1768135039520_1",
              "name": "prompt",
              "type": "string",
              "value": "Extract the item names, descriptions and the CAD description from the attachment {{$context.$app.$OraAttachments}}. Extract it from the Item table itself and ensure that you have both ItemName, itemDescription while extracting\nExtract in below format\n{\n\"title\":title string\n\"specifications\":specs string\n\"billOfMaterials\": [{itemName, description, quantity}] array of objects\n}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"specifications\": {\n            \"type\": \"string\"\n        },\n        \"billOfMaterials\": {\n            \"type\": \"array\",\n            \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n \"itemDescription\": {\n            \"type\": \"string\"\n        },\n        \"itemName\": {\n            \"type\": \"string\"\n        }\n}\n            }\n        },\n        \"title\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Answer Query"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "ANSWER_QUERY",
          "id": "1768489038451",
          "inputs": [
            {
              "id": "1768489038453_1",
              "name": "prompt",
              "type": "string",
              "value": "reply to user's query: {{$context.$triggers.REST.$input}} \n {{$context.$system.$inputMessage}}\nYou have the data here. Do not make up anything or answer outside the data given below. Always provide an answer, do not ask back questions to the user\n {{$context.$nodes.GETITEMSTRUCTURES.$output}}"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Analyze Intent",
            "returnType": "boolean",
            "sourceCode": "const containsAnyKeyword = (input, keywords)=> {\n  if (typeof input !== \"string\") return false;\n  if (!Array.isArray(keywords) || keywords.length === 0) return false;\n\n  const escaped = keywords\n    .filter((k) => typeof k === \"string\" && k.trim() !== \"\")\n    .map((k) => k.replace(/[.*+?^${}()|[]\\]/g, \"\\\\$&\"));\n\n  if (escaped.length === 0) return false;\n\n  const regex = new RegExp(escaped.join(\"|\"), \"i\");\n  return regex.test(input);\n}\nconst message = $context.$system.$inputMessage;\nconst keywords = ['parse'];\nreturn containsAnyKeyword(message,keywords);"
          },
          "outcomes": {
            "success": "1768488575207"
          },
          "code": "ANALYZE_INTENT",
          "id": "1768545060540",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
