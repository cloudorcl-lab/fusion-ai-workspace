            "sourceCode": "const processItems = (items, inquiry, partners,purchaseAgreements) => {\n  const masterItem = items.find(\n    (item) => item.InventoryItemId == $context.$nodes.EXTRACT_ITEM_AND_ORG.$output.result.ItemId\n  );\n\n  const componentItems = items\n    .filter((item) => item.InventoryItemId != $context.$nodes.EXTRACT_ITEM_AND_ORG.$output.result.ItemId)\n    .map((i) => {\n        const {InventoryItemId} = i;\n        const aggs = purchaseAgreements.filter(i=>i.ItemId==InventoryItemId)\n        let cost = 0\n        aggs.map(({Price,AgreementQuantity})=>{\n//            cost+=Number(Price)*Number(AgreementQuantity);\nif(cost===0){\ncost = Number(Price)\n}\nelse if(Number(Price)<cost){\ncost=Number(Price)\n}\n        })\n        const inquiryObject = (inquiry.find(i=>InventoryItemId==i.InventoryItemId) || {});\n        const PartnerCount = (partners.filter(i=>InventoryItemId==i.InventoryItemId) || []).length;\n        const Sourcing = aggs.length===0 ? \"Draft\":aggs.length===1?\"Single\":\"Multiple\";\n        const OnHandQuantity = inquiryObject.PrimaryOnhandQuantity\n      return {\n        ...i,\n        OnHandQuantity,\n        Sourcing,\n        Cost:cost\n      };\n    });\n\n  return {\n    title: masterItem && masterItem[\"Item.ItemNumber\"],\n    description: masterItem && masterItem[\"Item.ItemNumber\"],\n    components: componentItems,\n  };\n};\nconst resul = processItems(\n  $context.$nodes.FETCHITEMS.$output.items,\n  $context.$nodes.INQUIRY.$output.items,\n  $context.$nodes.GETPARTNERS.$output.items,\n $context.$nodes.FETCHPURCHASEAGREEMENTS.$output.items\n);\n\nreturn resul"
