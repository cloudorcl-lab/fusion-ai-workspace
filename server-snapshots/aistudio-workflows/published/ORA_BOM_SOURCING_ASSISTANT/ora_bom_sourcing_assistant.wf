        {
          "metadata": {
            "name": "Format payload for Summary",
            "returnType": "object",
            "sourceCode": "const cleanDeep = (input) => {\n  const isPlainObject = (v) =>\n    Object.prototype.toString.call(v) === \"[object Object]\";\n  const isRemovable = (v) =>\n    v == null ||\n    v === false ||\n    v === \"\" ||\n    (Array.isArray(v) && v.length === 0) ||\n    (isPlainObject(v) && Object.keys(v).length === 0);\n  const clean = (val) => {\n    if (Array.isArray(val)) {\n      const arr = val.map(clean).filter((el) => !isRemovable(el));\n      return arr;\n    }\n    if (isPlainObject(val)) {\n      const out = {};\n      for (const [k, v] of Object.entries(val)) {\n        // Remove keys named 'links' or '@context'\n        if (k === \"links\" || k === \"@context\") continue;\n        const cv = clean(v);\n        if (!isRemovable(cv)) out[k] = cv;\n      }\n      return out;\n    }\n    return val;\n  };\n  const result = clean(input);\n  return isRemovable(result) ? {} : result;\n};\n\nreturn { result1: cleanDeep($context.$nodes.CREATE_RFQ.$output), result2: cleanDeep($context.$nodes.CREATEALLITEMS.$output) };"
          },
          "outcomes": {
            "success": "1768135693083"
          },
          "code": "FORMAT_PAYLOAD_FOR_SUMMARY",
          "id": "1768568130063",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
