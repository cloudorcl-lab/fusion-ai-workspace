            "sourceCode": "const getItemQuery = (items)=>{\nvar itemNumbers = items.map(item=>item.ComponentItemId.toString());\nlet masterItemId = $context.$nodes.EXTRACT_ITEM_AND_ORG.$output.result.ItemId ;\nitemNumbers.push(masterItemId);\nreturn \"a \"+ itemNumbers.join(\" \");\n}\nconst items = $context.$nodes.GETITEMSTRUCTURES.$output.items;\nconst result = getItemQuery(items)\nreturn result"
          },
