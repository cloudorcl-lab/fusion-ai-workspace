                  "code": "GETRESULTSFOMES",
                  "id": "1765474983775",
                  "inputs": [
                    {
                      "id": "1765475027168_1",
                      "name": "payload",
                      "type": "string",
                      "value": "{{$context.$nodes.GETMATCHINGCANDSFROMESLOOP.ESPAYLOADFORMATCHING.$output.result.esQueryPayload}}"
                    }
                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "postProcessCandsFromES",
                    "returnType": "object",
                    "sourceCode": "var req = $context.$nodes.GETMATCHINGCANDSFROMESLOOP.$currentItem;\nvar rawOutput = $context.$nodes.GETMATCHINGCANDSFROMESLOOP.GETRESULTSFOMES.$output;\n\nvar esResponse = rawOutput;\nif (typeof rawOutput === 'string') {\n    esResponse = JSON.parse(rawOutput);\n} else if (rawOutput && typeof rawOutput === 'object' && rawOutput.length !== undefined && typeof rawOutput[0] === 'string') {\n    esResponse = JSON.parse(rawOutput[0]);\n}\n\nvar removeDuplicates = function(arr) {\n    var unique = [];\n    for (var i = 0; i < arr.length; i++) {\n        if (unique.indexOf(arr[i]) === -1 && arr[i]) {\n            unique.push(arr[i]);\n        }\n    }\n    return unique;\n};\n\nvar flatCandidates = [];\n\nif (esResponse && esResponse.hits && esResponse.hits.hits) {\n    var hits = esResponse.hits.hits;\n\n    for (var i = 0; i < hits.length; i++) {\n        var source = hits[i]._source;\n        var score = hits[i]._score;\n\n        var profile = {};\n        if (source.profiles && source.profiles.length > 0) {\n            profile = source.profiles[0];\n        }\n\n        var rawSkills = [];\n        if (profile.skills) {\n            for (var s = 0; s < profile.skills.length; s++) {\n                if (profile.skills[s].skillFreeText) {\n                    rawSkills.push(profile.skills[s].skillFreeText);\n                }\n            }\n        }\n\n        var rawJobs = [];\n        var rawEmployers = [];\n        if (profile.experience) {\n            for (var e = 0; e < profile.experience.length; e++) {\n                if (profile.experience[e].jobTitle) {\n                    rawJobs.push(profile.experience[e].jobTitle);\n                }\n                if (profile.experience[e].employer) {\n                    rawEmployers.push(profile.experience[e].employer);\n                }\n            }\n        }\n\n        var rawEdu = [];\n        if (profile.education) {\n            for (var d = 0; d < profile.education.length; d++) {\n                if (profile.education[d].major) {\n                    rawEdu.push(profile.education[d].major);\n                }\n                if (profile.education[d].degreeFreeText) {\n                    rawEdu.push(profile.education[d].degreeFreeText);\n                }\n            }\n        }\n\n        var candidateName = \"Unknown\";\n        if (source.names && source.names.length > 0 && source.names[0].displayName) {\n            candidateName = source.names[0].displayName;\n        }\n\n        var flatCand = {};\n        flatCand.personId = source.personId;\n        flatCand.matchScore = score;\n        flatCand.name = candidateName;\n        flatCand.skills = removeDuplicates(rawSkills).join(\", \");\n        flatCand.jobTitles = removeDuplicates(rawJobs).join(\", \");\n        flatCand.education = removeDuplicates(rawEdu).join(\", \");\n        flatCand.employers = removeDuplicates(rawEmployers).join(\", \");\n\n        flatCandidates.push(flatCand);\n    }\n}\n\nvar finalResult = {};\nfinalResult.requisitionId = req.requisitionId;\nfinalResult.reqTitle = req.ReqTitle;\nfinalResult.reqSearchCriteria = req.SearchCriteria;\nfinalResult.candidates = flatCandidates;\n\nreturn finalResult;"
                  },
