                  "code": "CALLAIASSITSERVICE",
                  "id": "1765243841655",
                  "inputs": [
                    {
                      "id": "1765243862770_1",
                      "name": "payload",
                      "type": "string",
                      "value": "{{$context.$nodes.CALLAISERVICEFORALLREQS.SETINPUTPAYLOADFORAISEARCH.$output.result}}"
                    }
                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "setInputPayloadForAISearch",
                    "returnType": "string",
                    "sourceCode": "// Get the SearchCriteria string for the current item\nlet sc = $context.$nodes.CALLAISERVICEFORALLREQS.$currentItem.SearchCriteria;\n\n// Build the payload object\nlet payloadObj = {\n  query: sc,\n  context: \"GENERAL\",\n  contextId: \"\",\n  searchMode: \"AI\",\n  createSavedSearch: false,\n  limit: 5,\n  savedSearch: {\n    name: null,\n    context: null\n  },\n  responseOptions: {\n    includeResults: true,\n    includeFilters: false\n  }\n};\n\n// Convert to a JSON string\nlet payload = JSON.stringify(payloadObj);\n\nreturn payload;"
                  },
                  "outcomes": {
                    "success": "1765243841655"
                  },
                  "code": "SETINPUTPAYLOADFORAISEARCH",
                  "id": "1765244656740",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "setMatchingCandsForEachReq",
                    "returnType": "object",
                    "sourceCode": "// ---------------------------------------------------------\n// 1. Retrieve Context Variables\n// ---------------------------------------------------------\n\n// Current requisition ID from the loop iterator\nlet reqId = $context.$nodes.CALLAISERVICEFORALLREQS.$currentItem.requisitionId;\nlet ReqTitle = $context.$nodes.CALLAISERVICEFORALLREQS.$currentItem.ReqTitle;\nlet ReqSearchCriteria = $context.$nodes.CALLAISERVICEFORALLREQS.$currentItem.SearchCriteria;\n\n// AI Service output for this specific iteration\nlet rawResponse = $context.$nodes.CALLAISERVICEFORALLREQS.CALLAIASSITSERVICE.$output;\n\n// ---------------------------------------------------------\n// 2. Process Candidates\n// ---------------------------------------------------------\n\n// Initialize an empty array for candidates\nlet candidateList = [];\n\n// Safely map results if they exist in the response\nif (rawResponse && rawResponse.results && Array.isArray(rawResponse.results)) {\n  candidateList = rawResponse.results.map(c => ({\n    PersonId: Number(c.PersonId),\n    CandidateNumber: String(c.CandidateNumber)\n  }));\n}\n\n// ---------------------------------------------------------\n// 3. Construct Final Object\n// ---------------------------------------------------------\n\nlet resultObject = {\n  \"ReqToCandidateRecommendations\": [\n    {\n      \"requisitionId\": Number(reqId),\n      \"reqTitle\": ReqTitle,\n      \"ReqSearchCriteria\": ReqSearchCriteria,\n      \"candidates\": candidateList\n    }\n  ]\n};\n\n// Return final object\nreturn resultObject;"
                  },
                  "outcomes": {
                    "success": "end_1765243744433"
                  },
                  "code": "SETMATCHINGCANDSFOREACHREQ",
                  "id": "1765309033646",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                }
              ],
              "rootNode": "start_1765243744433"
            },
            "loopType": "PARALLEL",
            "name": "callAIServiceForAllReqs"
          },
          "outcomes": {
            "success": "1765313915893"
          },
          "code": "CALLAISERVICEFORALLREQS",
          "convergenceTargetId": "1765474011964",
          "id": "1765243744433",
          "inputs": [
            {
              "id": "1765243744434_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$variables.llmReqSearchCriteria}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "setElasticSearchTermsQueryPayload",
            "returnType": "object",
            "sourceCode": "var rawLoopOutput = $context.$nodes.CALLAISERVICEFORALLREQS.$output;\nvar seenIds = {};\nvar uniqueIds = [];\n\nif (rawLoopOutput && Array.isArray(rawLoopOutput)) {\n  for (var i = 0; i < rawLoopOutput.length; i++) {\n    var item = rawLoopOutput[i];\n    var envelope = item;\n\n    if (typeof item === 'string') {\n      try {\n        envelope = JSON.parse(item);\n      } catch (e) {\n        continue;\n      }\n    }\n\n    if (envelope && envelope.result && envelope.result.ReqToCandidateRecommendations) {\n      var recs = envelope.result.ReqToCandidateRecommendations;\n      for (var j = 0; j < recs.length; j++) {\n        var req = recs[j];\n        if (req.candidates && Array.isArray(req.candidates)) {\n          for (var k = 0; k < req.candidates.length; k++) {\n            var cand = req.candidates[k];\n            var pId = cand.PersonId;\n            if (pId && !seenIds[pId]) {\n              seenIds[pId] = true;\n              uniqueIds.push(Number(pId));\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\nvar esPayload = {\n  \"_source\": [\n    \"personId\",\n    \"names.displayName\",\n    \"profiles.skills.skillFreeText\",\n    \"profiles.experience.employer\",\n    \"profiles.experience.jobTitle\",\n    \"profiles.education.school\",\n    \"profiles.education.degreeFreeText\",\n    \"profiles.education.major\",\n    \"profiles.certifications.certificationFreeText\",\n    \"profiles.languages.languageContentItem.name.US\"\n  ],\n  \"query\": {\n    \"terms\": {\n      \"personId\": uniqueIds\n    }\n  },\n  \"size\": uniqueIds.length + 50\n};\n\nvar finalResult = {\n  \"esPayload\": esPayload,\n  \"uniqueCount\": uniqueIds.length\n};\n\nreturn finalResult;"
          },
          "outcomes": {
            "success": "1765474280212"
          },
          "code": "SETELASTICSEARCHTERMSQUERYPAYLOAD",
          "convergenceTargetId": "1765474080930",
          "id": "1765313915893",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
