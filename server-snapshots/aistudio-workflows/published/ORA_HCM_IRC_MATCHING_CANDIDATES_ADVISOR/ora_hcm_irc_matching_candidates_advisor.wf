                {
                  "metadata": {
                    "name": "ESPayloadForMatching",
                    "returnType": "object",
                    "sourceCode": "var item = $context.$nodes.GETMATCHINGCANDSFROMESLOOP.$currentItem;\nvar rawCriteria = item ? item.SearchCriteria : \"\";\n\n// Extract requisitionId from the current loop item\nvar currentReqId = item ? item.requisitionId : null;\n\nvar skills = [];\nvar jobTitles = [];\nvar degrees = [];\n\n// --- 1. Parsing Logic ---\nif (rawCriteria && typeof rawCriteria === \"string\") {\n\n    var skillMatch = rawCriteria.match(/Skills\\s*:\\s*\\[(.*?)\\]/i);\n    if (skillMatch && skillMatch[1]) {\n        var parts = skillMatch[1].split(\",\");\n        for (var i = 0; i < parts.length; i++) {\n            var s = parts[i].trim().replace(/^\"(.*)\"$/, \"$1\");\n            if (s.length > 0) skills.push(s);\n        }\n    }\n\n    var jobMatch = rawCriteria.match(/JobTitle\\s*:\\s*\\[(.*?)\\]/i);\n    if (jobMatch && jobMatch[1]) {\n        var partsJ = jobMatch[1].split(\",\");\n        for (var j = 0; j < partsJ.length; j++) {\n            var t = partsJ[j].trim().replace(/^\"(.*)\"$/, \"$1\");\n            if (t.length > 0) jobTitles.push(t);\n        }\n    }\n\n    var degMatch = rawCriteria.match(/Degree\\s*:\\s*\\[(.*?)\\]/i);\n    if (degMatch && degMatch[1]) {\n        var partsD = degMatch[1].split(\",\");\n        for (var k = 0; k < partsD.length; k++) {\n            var d = partsD[k].trim().replace(/^\"(.*)\"$/, \"$1\");\n            if (d.length > 0 && d.toLowerCase().indexOf(\"years\") === -1) {\n                degrees.push(d);\n            }\n        }\n    }\n}\n\n// --- 2. Query Construction ---\nvar boolQuery = {\n    \"should\": [],\n    \"must_not\": [],\n    \"must\": []\n};\n\n// MUST: Active ORA_CANDIDATE person type\nboolQuery.must.push({\n    \"nested\": {\n        \"path\": \"personType\",\n        \"query\": {\n            \"bool\": {\n                \"filter\": [\n                    {\n                        \"term\": {\n                            \"personType.systemPersonType\": \"ORA_CANDIDATE\"\n                        }\n                    },\n                    {\n                        \"term\": {\n                            \"personType.effectiveEndDate\": \"4712-12-31T00:00:00\"\n                        }\n                    }\n                ]\n            }\n        }\n    }\n});\n\n// EXCLUDE: Existing prospects for this specific requisition\nif (currentReqId) {\n    boolQuery.must_not.push({\n        \"nested\": {\n            \"path\": \"prospects\",\n            \"query\": {\n                \"term\": {\n                    \"prospects.requisitionId\": currentReqId\n                }\n            }\n        }\n    });\n}\n\n// EXCLUDE: Already applied to THIS requisition\nif (currentReqId) {\n    boolQuery.must_not.push({\n        \"nested\": {\n            \"path\": \"submissions\",\n            \"query\": {\n                \"term\": {\n                    \"submissions.requisitionId\": currentReqId\n                }\n            }\n        }\n    });\n}\n\n// EXCLUDE: Applied to ANY requisition in last 90 days\nboolQuery.must_not.push({\n    \"nested\": {\n        \"path\": \"submissions\",\n        \"query\": {\n            \"range\": {\n                \"submissions.creationDate\": {\n                    \"gte\": \"now-30d/d\"\n                }\n            }\n        }\n    }\n});\n\n// --- SKILLS ---\nfor (var x = 0; x < skills.length; x++) {\n    boolQuery.should.push({\n        \"nested\": {\n            \"path\": \"profiles.skills\",\n            \"query\": {\n                \"match\": {\n                    \"profiles.skills.skillFreeText\": {\n                        \"query\": skills[x],\n                        \"boost\": 1.5\n                    }\n                }\n            }\n        }\n    });\n}\n\n// --- JOB TITLES ---\nfor (var y = 0; y < jobTitles.length; y++) {\n    boolQuery.should.push({\n        \"nested\": {\n            \"path\": \"profiles.experience\",\n            \"query\": {\n                \"match\": {\n                    \"profiles.experience.jobTitle\": {\n                        \"query\": jobTitles[y],\n                        \"boost\": 5.0\n                    }\n                }\n            }\n        }\n    });\n}\n\n// --- DEGREES ---\nfor (var z = 0; z < degrees.length; z++) {\n    boolQuery.should.push({\n        \"nested\": {\n            \"path\": \"profiles.education\",\n            \"query\": {\n                \"multi_match\": {\n                    \"query\": degrees[z],\n                    \"fields\": [\n                        \"profiles.education.major\",\n                        \"profiles.education.degreeFreeText\"\n                    ],\n                    \"boost\": 3.0\n                }\n            }\n        }\n    });\n}\n\n// --- 3. Final Assembly ---\nif (boolQuery.should.length > 0) {\n    boolQuery.minimum_should_match = 1;\n} else {\n    boolQuery.must.push({ \"match_all\": {} });\n}\n\nvar esPayload = {\n    \"size\": 10,\n    \"_source\": [\n        \"personId\",\n        \"names.displayName\",\n        \"personType.systemPersonType\",\n        \"personType.effectiveEndDate\",\n        \"profiles.skills.skillFreeText\",\n        \"profiles.experience.jobTitle\",\n        \"profiles.education.major\",\n        \"profiles.education.degreeFreeText\",\n        \"profiles.experience.employer\",\n        \"submissions.requisitionId\",\n        \"submissions.creationDate\"\n    ],\n    \"query\": {\n        \"bool\": boolQuery\n    }\n};\n\nreturn { \"esQueryPayload\": esPayload };"
                  },
                  "outcomes": {
                    "success": "1765474983775"
                  },
                  "code": "ESPAYLOADFORMATCHING",
                  "convergenceTargetId": "end_1765474559995",
                  "id": "1765474024218",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "businessObjectCode": "ORA_HCM_RECRUITING_STCANDIDATESEAR",
