            "sourceCode": "// Get the SearchCriteria string for the current item\nlet sc = $context.$triggers.REST.$input.query ;\n\n// Build the payload object\nlet payloadObj = {\n  query: sc,\n  context: \"GENERAL\",\n  contextId: \"\",\n  searchMode: \"AI\",\n  createSavedSearch: false,\n  limit: 5,\n  savedSearch: {\n    name: null,\n    context: null\n  },\n  responseOptions: {\n    includeResults: true,\n    includeFilters: false\n  }\n};\n\n// Convert to a JSON string\nlet payload = JSON.stringify(payloadObj);\n\nreturn payload;"
          },
          "outcomes": {
