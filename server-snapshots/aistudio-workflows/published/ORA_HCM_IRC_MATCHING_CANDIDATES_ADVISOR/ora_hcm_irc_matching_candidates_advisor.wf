          "code": "RANK_CANDIDATES",
          "convergenceTargetId": "1765486558580",
          "id": "1765421998462",
          "inputs": [
            {
              "id": "1765421998463_1",
              "name": "prompt",
              "type": "string",
              "value": "*** SYSTEM ROLE ***\nYou are an expert AI Talent Scouter. Your task is to rank candidates for job requisitions and return the results in strict JSON format. Speed and brevity are prioritized.\n\n*** INPUT DATA ***\n {{$context.$nodes.GENERATECONSOLIDATEDRESULTS.$output.result}} \n\n*** PROCESSING RULES ***\nFor EACH requisition:\n1.  **Analyze**: Compare \"reqSearchCriteria\" against candidate \"Skills\" and \"Job Titles\", Education\n2.  **Rank**: Select the top 5 candidates based on skill alignment.\n3.  **Classify Strength**: Assign \"Strong\", \"Medium\", or \"Weak\" based on skills, previous job titles and education\n4  **Summarize**: Write a brief 5-10 word justification.\n\n*** OUTPUT FORMAT (STRICT JSON) ***\nReturn ONLY a valid JSON object. Do not include markdown formatting (like ```json) or conversational text.\n\nRequired JSON Structure:\n{\n  \"RankedResults\": [\n    {\n      \"requisitionId\": \"string\",\n      \"reqTitle\": \"string\",\n      \"candidates\": [\n        {\n          \"rank\": 1, // Integer (1 to 5)\n          \"name\": \"string\",\n          \"personId\":\"string\",\n          \"recentJobTitles\": [\"string\", \"string\"], // Max 2\n          \"CandidateSkills\": [\"string\", \"string\", \"string\"], // Max 3\n          \"Education\": [\"string\"], // Max 1\n          \"Certifications\": [\"string\", \"string\"], // Max 2\n          \"matchStrength\": \"Strong\" | \"Medium\" | \"Weak\" | \"Low\",\n          \"activityStatus\": \"Highly Active\" | \"Medium Active\" | \"Less Active\",\n          \"summary\": \"Strong [Skill] background with experience as [Job], holds a [Education], certified in [Cert].\"\n        }\n        // ... up to 5 candidates\n      ]\n    }\n    // ... repeated for each requisition in consolidatedData\n  ]\n}\n\n*** BEGIN GENERATION ***"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "FormatFinalOutput",
            "returnType": "object",
            "sourceCode": "// 1. GET INPUT\nvar consolidatedData = $context.$nodes.GENERATECONSOLIDATEDRESULTS.$output.result.FinalConsolidatedResults;\n\n// 2. HELPER: Determine Match Strength\nvar getStrength = function(score) {\n    if (!score) { return \"Low\"; }\n    if (score >= 70) { return \"Strong\"; }\n    if (score >= 50) { return \"Medium\"; }\n    return \"Weak\";\n};\n\n// 3. HELPER: Generate Comprehensive Summary\nvar generateSummary = function(skillsArr, jobsArr, eduArr, certArr) {\n    var parts = [];\n\n    // Part A: Skills & Experience\n    var topSkill = (skillsArr && skillsArr.length > 0) ? skillsArr[0] : \"General\";\n    var topJob = (jobsArr && jobsArr.length > 0) ? jobsArr[0] : \"Candidate\";\n    parts.push(\"Strong \" + topSkill + \" background with experience as \" + topJob);\n\n    // Part B: Education\n    if (eduArr && eduArr.length > 0) {\n        parts.push(\"holds a \" + eduArr[0]);\n    }\n\n    // Part C: Certifications\n    if (certArr && certArr.length > 0) {\n        parts.push(\"certified in \" + certArr[0]);\n    }\n\n    // Join parts to form a sentence\n    return parts.join(\", \") + \".\";\n};\n\n// 4. HELPER: Activity Simulator\nvar getActivity = function(seed) {\n    var states = [\"Highly Active\", \"Medium Active\", \"Less Active\"];\n    var index = Math.floor(seed % 3);\n    return states[index];\n};\n\nvar rankedResults = [];\n\n// 5. MAIN LOGIC\nif (consolidatedData && Array.isArray(consolidatedData)) {\n    for (var i = 0; i < consolidatedData.length; i++) {\n        var reqItem = consolidatedData[i];\n\n        var inputCandidates = [];\n        if (reqItem.candidates) {\n            inputCandidates = reqItem.candidates;\n        }\n\n        // Sort by Score Descending\n        inputCandidates.sort(function(a, b) {\n            return b.matchScore - a.matchScore;\n        });\n\n        // Limit to Top 5\n        var top5 = inputCandidates.slice(0, 5);\n        var transformedCandidates = [];\n\n        for (var k = 0; k < top5.length; k++) {\n            var cand = top5[k];\n            var score = cand.matchScore || 0;\n\n            // Safe Split for Skills\n            var skillArray = [];\n            if (cand.skills && typeof cand.skills === 'string') {\n                skillArray = cand.skills.split(', ').slice(0, 3);\n            }\n\n            // Safe Split for Job Titles\n            var jobArray = [];\n            if (cand.jobTitles && typeof cand.jobTitles === 'string') {\n                jobArray = cand.jobTitles.split(', ').slice(0, 2);\n            }\n\n            // Safe Split for Education (New)\n            var eduArray = [];\n            if (cand.education && typeof cand.education === 'string') {\n                eduArray = cand.education.split(', ').slice(0, 1); // Get top degree\n            }\n\n            // Safe Split for Certifications (New)\n            var certArray = [];\n            if (cand.certifications && typeof cand.certifications === 'string') {\n                certArray = cand.certifications.split(', ').slice(0, 2);\n            }\n\n            // Build Object\n            var rankObj = {};\n            rankObj.rank = k + 1;\n            rankObj.name = cand.name;\n            rankObj.recentJobTitles = jobArray;\n            rankObj.CandidateSkills = skillArray;\n            rankObj.Education = eduArray;       // Added field\n            rankObj.Certifications = certArray; // Added field\n            rankObj.matchStrength = getStrength(score);\n            rankObj.activityStatus = getActivity(score);\n\n            // Generate enhanced summary passing all 4 data points\n            rankObj.summary = generateSummary(skillArray, jobArray, eduArray, certArray);\n\n            transformedCandidates.push(rankObj);\n        }\n\n        var resultObj = {};\n        resultObj.requisitionId = reqItem.requisitionId;\n        resultObj.reqTitle = reqItem.reqTitle;\n        resultObj.candidates = transformedCandidates;\n\n        rankedResults.push(resultObj);\n    }\n}\n\n// 6. RETURN\nvar output = {};\noutput.RankedResults = rankedResults;\n\nreturn output;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "FORMATFINALOUTPUT",
          "id": "1765486586084",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "dataPipeline": {
              "pipelineNodes": [
                {
