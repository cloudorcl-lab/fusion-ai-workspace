        {
          "metadata": {
            "name": "generateConsolidatedResults",
            "returnType": "object",
            "sourceCode": "/* ---------------------------------------------------------\n   STEP 3: CONSOLIDATE & LIMIT (Fixed \"result\" Wrapper)\n--------------------------------------------------------- */\n\n// 1. INPUTS\nvar useAI = $context.$variables.useAIAssit;\nvar rawLoopOutput = useAI ? $context.$nodes.CALLAISERVICEFORALLREQS.$output : $context.$nodes.GETMATCHINGCANDSFROMESLOOP.$output;\nvar esResponse = $context.$nodes.GETCANDIDATEDATAFROMELASTICSEARCH.$output;\n\nvar finalResults = [];\n\n// CONFIG: Strict Limits\nvar MAX_CANDIDATES = 10;\nvar MAX_SKILLS = 10;\nvar MAX_JOBS = 5;\n\n// HELPER: Deduplicate\nvar removeDuplicates = function(arr) {\n    var unique = [];\n    for (var i = 0; i < arr.length; i++) {\n        if (unique.indexOf(arr[i]) === -1 && arr[i]) {\n            unique.push(arr[i]);\n        }\n    }\n    return unique;\n};\n\n// HELPER: Truncate String List\nvar truncateStringList = function(str, limit) {\n    if (!str) return \"\";\n    var parts = str.split(\",\");\n    if (parts.length <= limit) return str;\n    return parts.slice(0, limit).join(\",\");\n};\n\n// =========================================================\n// PATH A: ES LOOP (Handle \"result\" Wrapper)\n// =========================================================\nif (useAI === false || useAI === \"false\") {\n\n    if (rawLoopOutput && Array.isArray(rawLoopOutput)) {\n        for (var i = 0; i < rawLoopOutput.length; i++) {\n            var item = rawLoopOutput[i];\n\n            // 1. Parse if string\n            if (typeof item === 'string') {\n                try { item = JSON.parse(item); } catch (e) { continue; }\n            }\n\n            // 2. UNWRAP: Check if data is inside \"result\"\n            var data = item;\n            if (item && item.result && !item.requisitionId) {\n                data = item.result;\n            }\n\n            // 3. Process\n            if (data && data.candidates && Array.isArray(data.candidates)) {\n\n                // Limit Candidates\n                var limitedCandidates = data.candidates.slice(0, MAX_CANDIDATES);\n\n                // Limit Fields\n                for (var c = 0; c < limitedCandidates.length; c++) {\n                    var cand = limitedCandidates[c];\n                    cand.skills = truncateStringList(cand.skills, MAX_SKILLS);\n                    cand.jobTitles = truncateStringList(cand.jobTitles, MAX_JOBS);\n                }\n\n                data.candidates = limitedCandidates;\n                finalResults.push(data);\n            }\n        }\n    }\n\n// =========================================================\n// PATH B: AI SERVICE (Lookup)\n// =========================================================\n} else {\n    // Build Map\n    var candidateMap = {};\n    if (esResponse && esResponse.hits && esResponse.hits.hits) {\n        var hits = esResponse.hits.hits;\n        for (var h = 0; h < hits.length; h++) {\n            var source = hits[h]._source;\n            if (source && source.personId) {\n                candidateMap[Number(source.personId)] = source;\n            }\n        }\n    }\n\n    // Process AI Output\n    var aiItems = Array.isArray(rawLoopOutput) ? rawLoopOutput : [rawLoopOutput];\n\n    for (var i = 0; i < aiItems.length; i++) {\n        var envelope = aiItems[i];\n        if (typeof envelope === 'string') {\n            try { envelope = JSON.parse(envelope); } catch (e) { continue; }\n        }\n\n        if (envelope && envelope.result && envelope.result.ReqToCandidateRecommendations) {\n            var recs = envelope.result.ReqToCandidateRecommendations;\n\n            for (var j = 0; j < recs.length; j++) {\n                var req = recs[j];\n                var flatCandidates = [];\n\n                if (req.candidates && Array.isArray(req.candidates)) {\n                    var limit = Math.min(req.candidates.length, MAX_CANDIDATES);\n\n                    for (var k = 0; k < limit; k++) {\n                        var simpleCand = req.candidates[k];\n                        var pId = Number(simpleCand.PersonId);\n                        var source = candidateMap[pId];\n\n                        if (source) {\n                            var rawSkills = [];\n                            var rawJobs = [];\n                            var rawEdu = [];\n                            var profile = {};\n                            if (source.profiles && source.profiles.length > 0) profile = source.profiles[0];\n\n                            if (profile.skills) {\n                                for (var s = 0; s < profile.skills.length; s++) {\n                                    if (profile.skills[s].skillFreeText) rawSkills.push(profile.skills[s].skillFreeText);\n                                }\n                            }\n                            if (profile.experience) {\n                                for (var e = 0; e < profile.experience.length; e++) {\n                                    if (profile.experience[e].jobTitle) rawJobs.push(profile.experience[e].jobTitle);\n                                }\n                            }\n                            if (profile.education) {\n                                for (var d = 0; d < profile.education.length; d++) {\n                                    var edu = profile.education[d];\n                                    var degVal = edu.degreeFreeText || edu.major || edu.degreeName;\n                                    if (degVal) rawEdu.push(degVal);\n                                }\n                            }\n\n                            flatCandidates.push({\n                                \"PersonId\": source.personId,\n                                \"names\": (source.names && source.names.length > 0) ? source.names[0].displayName : \"Unknown\",\n                                \"Skills\": removeDuplicates(rawSkills).slice(0, MAX_SKILLS).join(\", \"),\n                                \"Job Titles\": removeDuplicates(rawJobs).slice(0, MAX_JOBS).join(\", \"),\n                                \"Degree\": removeDuplicates(rawEdu).join(\", \")\n                            });\n                        }\n                    }\n                }\n\n                finalResults.push({\n                    \"requisitionId\": req.requisitionId,\n                    \"reqTitle\": req.reqTitle,\n                    \"reqSearchCriteria\": req.reqSearchCriteria || \"AI Generated\",\n                    \"candidates\": flatCandidates\n                });\n            }\n        }\n    }\n}\n\nreturn { \"FinalConsolidatedResults\": finalResults };"
          },
          "outcomes": {
            "success": "1765486536698"
          },
