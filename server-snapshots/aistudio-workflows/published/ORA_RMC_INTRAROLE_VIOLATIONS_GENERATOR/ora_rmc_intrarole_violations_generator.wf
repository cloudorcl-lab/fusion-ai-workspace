        {
          "metadata": {
            "businessObjectCode": "ORA_GRC_OTHER_GETALLACCESSCONTROLS",
            "functionName": "getall_advancedControls",
            "name": "GetActiveAccessControls"
          },
          "outcomes": {
            "success": "1765506012867"
          },
          "code": "GETACTIVEACCESSCONTROLS",
          "id": "1765506012866",
          "inputs": [],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "TransformControls",
            "returnType": "array",
            "sourceCode": "var items = $context.$nodes.GETACTIVEACCESSCONTROLS.$output.items; var result = []; for (var i = 0; i < items.length; i++) { var item = items[i]; result.push({ Id: parseInt(item.Id, 10), Name: item.Name }); } return result;"
          },
          "outcomes": {
            "success": "1765833922555"
          },
          "code": "TRANSFORM_CONTROLS",
          "id": "1765506012867",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"Id\": { \"type\": \"integer\" },\n      \"Name\": { \"type\": \"string\" }\n    }\n  }\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "ConsolidateOutput",
            "returnType": "array",
            "sourceCode": "let data = $context.$nodes.PROCESS_CONTROLS.$output; \n\nif (data.length == 0) return null;\n\nconst roleSummaryArray = data.map(item => JSON.parse(item).result);\n\nconst finalRoleSummaryMap = new Map();\n\n// Iterate through the roleSummary array\nfor (const innerArray of roleSummaryArray ) {\n\n  // Iterate through each object inside the inner array\n  if (innerArray.length > 0) {\n  for (const obj of innerArray) {\n     const key = `${obj.Role}`;\n\n    if (!finalRoleSummaryMap.has(key)) {\n            finalRoleSummaryMap.set(key, {\n                Role: obj.Role,\n                RoleCode: obj.RoleCode,\n                Controls: new Set(),                \n                NumUsers: 0,\n                NumControls: 0\n         //       Entitlements: new Set(),\n         //       NumEntitlements: 0\n            });\n          }\n       \n        const group = finalRoleSummaryMap.get(key);\n        group.Controls.add(obj.ControlName);\n        group.NumUsers += obj.NumUsers;\n        group.NumControls = group.Controls.size;\n\n        /*\n         for (const item of obj.Entitlements.split(',')) {\n             group.Entitlements.add(item);\n         } */\n\n     //   group.NumEntitlements = group.Entitlements.size;\n        \n  }\n }\n}\n\n    // Convert map to desired output array\n    const result = Array.from(finalRoleSummaryMap.values()).map(group => ({\n        Role: group.Role,\n        RoleCode: group.RoleCode,\n        Controls: Array.from(group.Controls).join(','),        \n        NumUsers: group.NumUsers,\n        NumControls: group.NumControls\n    //    Entitlements: Array.from(group.Entitlements).join(','),\n    //    NumEntitlements: group.NumEntitlements\n    }));\n\n\nreturn result;"
          },
          "outcomes": {
            "success": "1765991888105"
          },
          "code": "CONSOLIDATEOUTPUT",
          "id": "1765664308519",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "dataPipeline": {
              "pipelineNodes": [
                {
                  "metadata": {
                    "name": "Start",
                    "description": "Start of data pipeline"
                  },
