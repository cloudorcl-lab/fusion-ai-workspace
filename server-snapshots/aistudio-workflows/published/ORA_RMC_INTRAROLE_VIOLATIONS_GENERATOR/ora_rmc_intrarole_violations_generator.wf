                },
                {
                  "metadata": {
                    "businessObjectCode": "ORA_GRC_OTHER_GETINTRAROLEACCESSVIOLATIONS",
                    "functionName": "getall_advancedControls-incidents",
                    "processJson": true,
                    "name": "GetControlIncidents"
                  },
                  "outcomes": {
                    "success": "1765574407280"
                  },
                  "code": "GETCONTROLINCIDENTS",
                  "convergenceTargetId": "1765833980562",
                  "id": "1765553728935",
                  "inputs": [
                    {
                      "id": "1765553743282_1",
                      "name": "advancedControls_Id",
                      "type": "integer",
                      "value": "{{$context.$nodes.PROCESS_CONTROLS.$currentItem.Id}}"
                    }
                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "GetRoleViolationSummary",
                    "returnType": "array",
                    "sourceCode": "let data = $context.$nodes.PROCESS_CONTROLS.GETCONTROLINCIDENTS.$output.items ; \n\nvar result = [];\nif (data.length > 0) {\n\n// Map to store grouping: { \"ControlName|Role\": {ControlName, Role, users: Set} }\nconst map = new Map();\n\n    data.forEach(item => {\n        const key = `${item.ControlName}|${item.Role}`;\n        if (!map.has(key)) {\n            map.set(key, {\n                ControlName: item.ControlName,\n                Role: item.Role,\n                RoleCode: item.IncidentInformationCodes.split('>')[0].trim(),\n                users: new Set()\n            });\n        }\n        const group = map.get(key);\n        group.users.add(item.GlobalUserName);\n     //   group.entitlements.add(item.Entitlement);\n    });\n\n    // Convert map to desired output array\n    result = Array.from(map.values()).map(group => ({\n        ControlName: group.ControlName,\n        Role: group.Role,\n        RoleCode: group.RoleCode,\n        NumUsers: group.users.size\n     //   Entitlements: Array.from(group.entitlements).join(',')\n    }));\n}\n\nreturn result;"
                  },
                  "outcomes": {
                    "success": "end_1765833922555"
                  },
                  "code": "GETROLEVIOLATIONSUMMARY",
                  "convergenceTargetId": "1765833980562",
                  "id": "1765574407280",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                }
              ],
              "rootNode": "start_1765833922555"
            },
