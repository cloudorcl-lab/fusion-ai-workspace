              "value": "{{$context.$triggers.REST.$input.reqNumber}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"description\": \"\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"RequisitionId\",\n          \"RequisitionNumber\",\n          \"Title\",\n          \"RecruitingTypeCode\",\n          \"OrganizationId\",\n          \"PublishJobStartDate\",\n          \"OrganizationName\",\n          \"BookmarkFlag\",\n          \"HasAppliedFlag\",\n          \"RequisitionValidFlag\",\n          \"ProfileId\",\n          \"LegalEmployerId\",\n          \"PrimaryLocationFlatName\",\n          \"PrimaryWorkLocationName\",\n          \"TravelRequiredFlag\",\n          \"DescriptionStr\",\n          \"EmployerDescriptionStr\",\n          \"OrganizationDescriptionStr\",\n          \"InternallyPostedFlag\",\n          \"ExternallyPostedFlag\",\n          \"QualificationsStr\",\n          \"ResponsibilitiesStr\",\n          \"CandidateReapplyFlag\"\n        ],\n        \"properties\": {\n          \"RequisitionId\": {\n            \"type\": \"number\"\n          },\n          \"RequisitionNumber\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"Title\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"RecruitingTypeCode\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"OrganizationId\": {\n            \"type\": \"number\"\n          },\n          \"PublishJobStartDate\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"PublishJobEndDate\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"JobFamilyName\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"JobGradeName\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"JobShiftName\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"FullPartTimeName\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"OrganizationName\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"BookmarkFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"HasAppliedFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"RequisitionValidFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"ProfileId\": {\n            \"type\": \"number\"\n          },\n          \"SubmissionDateTime\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"LegalEmployerId\": {\n            \"type\": \"number\"\n          },\n          \"Workplace\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"JobCode\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"ManagerLevel\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"PrimaryLocationFlatName\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"PrimaryWorkLocationName\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"TravelRequiredFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"DescriptionStr\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"EmployerDescriptionStr\": {\n            \"type\": \"string\"\n          },\n          \"OrganizationDescriptionStr\": {\n            \"type\": \"string\"\n          },\n          \"JobShareId\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"JobShareURL\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"InternallyPostedFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"ExternallyPostedFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"QualificationsStr\": {\n            \"type\": \"string\"\n          },\n          \"ResponsibilitiesStr\": {\n            \"type\": \"string\"\n          },\n          \"AssessmentFlag\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"CandidateReapplyFlag\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"links\": {\n            \"type\": \"array\",\n            \"uniqueItems\": true,\n            \"minItems\": 1,\n            \"items\": {\n              \"required\": [\n                \"rel\",\n                \"href\",\n                \"name\",\n                \"kind\"\n              ],\n              \"properties\": {\n                \"rel\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"href\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"name\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"kind\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"href\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"name\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"kind\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ]\n}",
