        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_RECRUITING_GETOMJOBSKILLS",
            "errorNodeId": "1765086085439",
            "functionName": "getJobAssociatedSkills",
            "name": "GET SKILLS FOR JOB BO"
          },
          "outcomes": {
            "success": "1765086085439"
          },
          "code": "GET_SKILLS_FOR_JOB_BO",
          "id": "1765085782893",
          "inputs": [
            {
              "id": "1765085813570_1",
              "name": "requisitionNumber",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.reqNumber}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"description\": \"\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"SkillId\",\n          \"RequiredFlag\",\n          \"SectionId\",\n          \"SectionName\",\n          \"Skills\"\n        ],\n        \"properties\": {\n          \"SkillId\": {\n            \"type\": \"number\"\n          },\n          \"MinimumYearsOfExperience\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"Importance\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"RequiredFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"SectionId\": {\n            \"type\": \"number\"\n          },\n          \"SectionName\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"Skills\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"links\": {\n            \"type\": \"array\",\n            \"uniqueItems\": true,\n            \"minItems\": 1,\n            \"items\": {\n              \"required\": [\n                \"rel\",\n                \"href\",\n                \"name\",\n                \"kind\"\n              ],\n              \"properties\": {\n                \"rel\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"href\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"name\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"kind\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"href\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"name\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"kind\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ]\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "EXTRACT SKILLS CODE NODE",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.GET_SKILLS_FOR_JOB_BO.$output || [];\nconst targetRole = $context.$nodes.GET_JOB_DETAILS_BO.$output.items[0].Title ;\nconst targetRoleDesc = $context.$nodes.GET_JOB_DETAILS_BO.$output.items[0].DescriptionStr ;\nconst targetRoleId = $context.$nodes.GET_JOB_DETAILS_BO.$output.items[0].RequisitionId ;\n\nlet skillsArray = [];\n\nif (data && data.items){\n    skillsArray = data.items.map(item => item.Skills);\n}\n\n\nconst finalObj ={TargetRole: targetRole, Skills: skillsArray, Description: targetRoleDesc, OpportunityId: targetRoleId};\nreturn finalObj;"
          },
          "outcomes": {
            "success": "1765086163931"
          },
          "code": "EXTRACT_SKILLS_CODE_NODE",
          "id": "1765086085439",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "SKILLS EXIST CONDITION"
          },
          "outcomes": {
            "true": "1765884809457",
            "false": "1765004927963"
          },
          "code": "SKILLS_EXIST_CONDITION",
          "convergenceTargetId": "end",
          "id": "1765086163931",
          "inputs": [
            {
              "id": "1765086163933_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_SKILLS_CODE_NODE.$output.result.Skills && $context.$nodes.EXTRACT_SKILLS_CODE_NODE.$output.result.Skills.length > 0}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {},
              "code": "ORA_LLM_PREMIUM",
              "model": "OPEN_AI_GPT_4_1_MINI",
              "modelName": "GPT-4.1 mini",
              "provider": "CERT_PREMIUM"
            },
            "name": "Missing Skills LLM"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "MISSING_SKILLS_LLM",
          "convergenceTargetId": "1765086281451",
          "id": "1765004927963",
          "inputs": [
            {
              "id": "1765004927965_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an AI assistant that helps candidates identify specific, catalog-searchable skills required for a target job based on title and description.\n\nTarget Job Title:\n {{$context.$nodes.EXTRACT_SKILLS_CODE_NODE.$output.result.TargetRole}} \n\nTarget Job Description:\n{{$context.$nodes.GET_JOB_DETAILS_BO.$output.items[0].DescriptionStr}}\n\nInstructions:\n\nIdentify the 3 most relevant technical skills or knowledge areas needed for this job.\nOutput each skill as a concise phrase (3-5 words), specific enough for catalog searching. For example, use terms like \"Software Architecture\", \"Database Design\", or \"Application Debugging\" instead of just \"Databases\" or \"Debugging\".\nAvoid overly broad (e.g., just \"Programming\") or extremely detailed sentences.\nReturn the skills and target role name, description and OpportunityId as a JSON object"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"OpportunityId\": {\n            \"type\": \"string\"\n        },\n        \"Description\": {\n            \"type\": \"string\"\n        },\n        \"Skills\": {\n            \"type\": \"array\",\n            \"items\": {\n                \"type\": \"object\",\n                \"properties\": {}\n            }\n        },\n        \"TargetRole\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "return skills"
          },
          "outcomes": {},
          "code": "RETURN_SKILLS",
          "convergenceTargetId": "end",
