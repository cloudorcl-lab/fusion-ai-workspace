        {
          "metadata": {
            "name": "Format Transaction And Distribution Details",
            "returnType": "array",
            "sourceCode": "const input = $context.$nodes.GET_TRANSACTION_AND_DISTRIBUTION_DETAILS_IN_BATCH.$output;\n\nconst normalizeLoopItem = (item) => {\n  if (item && typeof item === 'object') {\n    return item;\n  }\n  if (typeof item === 'string') {\n    try {\n      return JSON.parse(item);\n    } catch (e) {\n      return null;\n    }\n  }\n  return null;\n};\n\nconst loopItems = Array.isArray(input) ? input : [];\nconst flatResults = [];\n\nfor (let i = 0; i < loopItems.length; i++) {\n  const normalized = normalizeLoopItem(loopItems[i]);\n  const rows = Array.isArray(normalized?.result)\n    ? normalized.result\n    : Array.isArray(normalized?.output?.result) ? normalized.output.result\n    : [];\n\n  for (let j = 0; j < rows.length; j++) {\n    flatResults.push(rows[j]);\n  }\n}\n\nreturn flatResults;"
          },
          "outcomes": {
            "success": "1771676389793"
          },
          "code": "FORMAT_TRANSACTION_AND_DISTRBUTION_DETAILS",
          "id": "1771669591272",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "dataPipeline": {
              "pipelineNodes": [
                {
                  "metadata": {
                    "name": "Start",
                    "description": "Start of data pipeline"
                  },
                  "outcomes": {
                    "success": "1771676668398"
                  },
                  "id": "start_1771676389793",
                  "code": "START_1771676389793",
                  "type": "START"
                },
                {
                  "metadata": {
                    "name": "End",
                    "description": "End of data pipeline"
                  },
                  "id": "end_1771676389793",
                  "code": "END_1771676389793",
                  "type": "END"
                },
                {
                  "metadata": {
                    "name": "Validation",
                    "returnType": "object",
                    "sourceCode": "const transactionNumber = $context.$nodes.FIRST_LEVEL_VALIDATION.$currentItem;\nconst mergedTransactionDetails = $context.$nodes.FORMAT_TRANSACTION_AND_DISTRBUTION_DETAILS.$output.result;\n\nconst tx = Array.isArray(mergedTransactionDetails)\n  ? mergedTransactionDetails.find((t) => t && Number(t.transactionNumber) === Number(transactionNumber))\n  : undefined;\n\nlet resultBucket;\n\nif (!tx) {\n  resultBucket = { \"Transaction_Doesnot_Exist\": transactionNumber };\n} else {\n  const distributions = Array.isArray(tx.distributionDetails) ? tx.distributionDetails : null;\n  const capitalizableFlag = tx.capitalizableFlag;\n  const enableCapitalizationFlag = tx.enableCapitalizationFlag;\n  const projectCostClassificationCode = tx.projectCostClassificationCode;\n  const capitalCostTypeCode = tx.capitalCostTypeCode;\n  const receiverLedger = tx.receiverLedger;\n  const buLedger = tx.buLedger;\n  const adjustmentStatus = tx.adjustmentStatus;\n  const rawCost = tx.rawCostInReceiverLedgerCurrency;\n  const burdenedCost = tx.burdenedCostInReceiverLedgerCurrency;\n  const includedInAssetLine = tx.includedInAssetLine;\n\n  let isCapitalizable = false;\n  let allDistY = false;\n\n  //if (distributions && distributions.length > 0) {\n    //const hasY = distributions.some((d) => d && d.distributionCapitalizableFlag === \"Y\");\n    //const allN = distributions.every((d) => d && d.distributionCapitalizableFlag === \"N\");\n    //isCapitalizable = hasY ? true : (allN ? false : false);\n    //allDistY = distributions.every((d) => d && d.distributionCapitalizableFlag === \"Y\");\n  //} else {\n    //if (capitalizableFlag === \"Y\") isCapitalizable = true;\n    //else if (capitalizableFlag === \"N\") isCapitalizable = false;\n    //else isCapitalizable = false;\n    //allDistY = false;\n  //}\nif (capitalizableFlag === \"Y\") {\nisCapitalizable = true;\n}\n   else if (capitalizableFlag === \"N\") {\nisCapitalizable = false;\n}\n   else {\nisCapitalizable = false;\n}\n    allDistY = false;\n\n  if (!isCapitalizable) {\n    const taskCapitalizableFlag = tx.taskCapitalizableFlag;\n    if (enableCapitalizationFlag === false) {\n      resultBucket = { \"Project_Not_Enabled_For_Capitalization\": transactionNumber };\n    } else if (taskCapitalizableFlag === \"N\") {\n      resultBucket = { \"Task_Not_Enabled_For_Capitalization\": transactionNumber };\n    } else {\n      resultBucket = { \"Project_Status_Check_Needed\": transactionNumber };\n    }\n  } else {\n    const isZeroRaw = (capitalCostTypeCode === \"R\") && (rawCost === 0);\n    const isZeroBurdened = (capitalCostTypeCode === \"B\") && (burdenedCost === 0);\n\n    if (projectCostClassificationCode === \"BTC\") {\n      if (capitalCostTypeCode === \"R\") {\n        resultBucket = { \"Raw_BTC\": transactionNumber };\n      } else if (receiverLedger !== buLedger) {\n        resultBucket = { \"CrossCharge\": transactionNumber };\n      } else if (includedInAssetLine === \"Y\") {\n        resultBucket = { \"Capitalized\": transactionNumber };\n      } else {\n        resultBucket = { \"Transactions_To_Process\": transactionNumber };\n      }\n    } else {\n      if (isZeroRaw || isZeroBurdened) {\n        resultBucket = { \"ZeroCost\": transactionNumber };\n      } else if (adjustmentStatus === \"P\" || adjustmentStatus === \"R\" || adjustmentStatus === \"PA\") {\n        resultBucket = { \"Pending_Adjustments\": transactionNumber };\n      } else if (receiverLedger !== buLedger) {\n        resultBucket = { \"CrossCharge\": transactionNumber };\n      } else {\n        resultBucket = { \"Not_Cross_Charge_NONBTC\": transactionNumber };\n      }\n    }\n  }\n}\n\nreturn resultBucket;"
                  },
                  "outcomes": {
                    "success": "end_1771676389793"
                  },
                  "code": "VALIDATION",
                  "id": "1771676668398",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                }
              ],
              "rootNode": "start_1771676389793"
            },
            "loopType": "PARALLEL",
            "name": "First Level Validation"
          },
          "outcomes": {
            "success": "1771719704744"
          },
          "code": "FIRST_LEVEL_VALIDATION",
          "id": "1771676389793",
          "inputs": [
            {
              "id": "1771676389796_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$system.$inputMessage}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "Group Transactions",
            "returnType": "object",
            "sourceCode": "// Input: array of JSON strings, each containing {\"result\": { \"<BucketName>\": <transactionNumber> }, ...}\nconst input = $context.$nodes.FIRST_LEVEL_VALIDATION.$output \n\n// Grouping object: { BucketName: [transactionNumbers...] }\nconst grouped = {};\n\n// Parse and group\nfor (let i = 0; i < input.length; i++) {\n  try {\n    const parsed = JSON.parse(input[i]);\n    if (parsed && parsed.result && typeof parsed.result === \"object\" && !Array.isArray(parsed.result)) {\n      const keys = Object.keys(parsed.result);\n      if (keys.length === 1) {\n        const bucket = keys[0];\n        const txn = parsed.result[bucket];\n        if (!grouped[bucket]) grouped[bucket] = [];\n        grouped[bucket].push(txn);\n      }\n    }\n  } catch (e) {\n    // ignore malformed JSON entries\n  }\n}\n\n// If your environment expects a final variable, expose it:\nconst result = grouped;\n\nreturn grouped;"
          },
          "outcomes": {
