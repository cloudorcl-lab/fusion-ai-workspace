        {
          "metadata": {
            "name": "Event Based Check",
            "returnType": "object",
            "sourceCode": "const grouped =\n($context && $context.$nodes && $context.$nodes.GROUP_TRANSACTIONS &&\n$context.$nodes.GROUP_TRANSACTIONS.$output &&\n$context.$nodes.GROUP_TRANSACTIONS.$output.result) || {};\n\nconst batchCheck =\n($context && $context.$nodes && $context.$nodes.CHECK_CAPITALIZED_FOR_NONBTC &&\n$context.$nodes.CHECK_CAPITALIZED_FOR_NONBTC.$output &&\n$context.$nodes.CHECK_CAPITALIZED_FOR_NONBTC.$output.result) || {};\n\nconst projectStatusCheck =\n($context && $context.$nodes && $context.$nodes.CHECK_PROJECT_STATUS_FOR_ALLOW_FLAG &&\n$context.$nodes.CHECK_PROJECT_STATUS_FOR_ALLOW_FLAG.$output &&\n$context.$nodes.CHECK_PROJECT_STATUS_FOR_ALLOW_FLAG.$output.result) || {};\n\nconst mergedTransactionDetails =\n($context && $context.$nodes && $context.$nodes.FORMAT_TRANSACTION_AND_DISTRBUTION_DETAILS &&\n$context.$nodes.FORMAT_TRANSACTION_AND_DISTRBUTION_DETAILS.$output &&\n$context.$nodes.FORMAT_TRANSACTION_AND_DISTRBUTION_DETAILS.$output.result) || [];\n\n// 1) Collect Transactions_To_Process from grouped + batchCheck + projectStatusCheck, merge & dedupe\nconst ttpGrouped = Array.isArray(grouped[\"Transactions_To_Process\"])\n    ? grouped[\"Transactions_To_Process\"]\n    : [];\n\nconst ttpBatch = (batchCheck && Array.isArray(batchCheck[\"Transactions_To_Process\"]))\n    ? batchCheck[\"Transactions_To_Process\"]\n    : [];\n\nconst ttpProjectStatus = (projectStatusCheck && Array.isArray(projectStatusCheck[\"Transactions_To_Process\"]))\n    ? projectStatusCheck[\"Transactions_To_Process\"]\n    : [];\n\nconst ttpAll = [];\nconst seenTtp = new Set();\n\nfor (let i = 0; i < ttpGrouped.length; i++) {\n    const v = ttpGrouped[i];\n    const k = String(v);\n    if (v !== null && v !== undefined && (typeof v === \"string\" || typeof v === \"number\") && !seenTtp.has(k)) {\n        seenTtp.add(k);\n        ttpAll.push(v);\n    }\n}\n\nfor (let i = 0; i < ttpBatch.length; i++) {\n    const v = ttpBatch[i];\n    const k = String(v);\n    if (v !== null && v !== undefined && (typeof v === \"string\" || typeof v === \"number\") && !seenTtp.has(k)) {\n        seenTtp.add(k);\n        ttpAll.push(v);\n    }\n}\n\nfor (let i = 0; i < ttpProjectStatus.length; i++) {\n    const v = ttpProjectStatus[i];\n    const k = String(v);\n    if (v !== null && v !== undefined && (typeof v === \"string\" || typeof v === \"number\") && !seenTtp.has(k)) {\n        seenTtp.add(k);\n        ttpAll.push(v);\n    }\n}\n\n// 2) Build lookup from mergedTransactionDetails\nconst txMap = {};\nif (Array.isArray(mergedTransactionDetails)) {\n    for (let i = 0; i < mergedTransactionDetails.length; i++) {\n        const t = mergedTransactionDetails[i];\n        if (t && t.transactionNumber != null) {\n            txMap[String(t.transactionNumber)] = {\n                capitalEventProcessing: t.capitalEventProcessing,\n                capitalEventId: t.capitalEventId\n            };\n        }\n    }\n}\n\n// 3) Classify ttpAll into Not_Event_Based, Transactions_To_Process, Event_Not_Stamped\nconst eventBasedSet = new Set([\"P\", \"M\"]);\nconst notEventBased = [];\nconst ttpUpdated = [];\nconst eventNotStamped = [];\n\nfor (let i = 0; i < ttpAll.length; i++) {\n    const txn = ttpAll[i];\n    const info = txMap[String(txn)];\n    if (!info) {\n        notEventBased.push(txn);\n        continue;\n    }\n\n    const cep = info.capitalEventProcessing;\n    const ceid = info.capitalEventId;\n\n    if (!eventBasedSet.has(cep)) {\n        notEventBased.push(txn);\n    } else {\n        if (ceid != -1 && ceid != null)  {\n            ttpUpdated.push(txn);\n        } else {\n            eventNotStamped.push(txn);\n        }\n    }\n}\n\n// 4) Merge classified buckets back into grouped (copy first)\nconst updated = {};\nif (grouped && typeof grouped === \"object\" && !Array.isArray(grouped)) {\n    const keys = Object.keys(grouped);\n    for (let i = 0; i < keys.length; i++) {\n        const k = keys[i];\n        const v = grouped[k];\n        updated[k] = Array.isArray(v) ? v.slice() : v;\n    }\n}\n\n// Prepare merges for each bucket\nconst mergeTargets = [\n    { name: \"Not_Event_Based\", values: notEventBased },\n    { name: \"Transactions_To_Process\", values: ttpUpdated },\n    { name: \"Event_Not_Stamped\", values: eventNotStamped }\n];\n\n// Include Capitalized from batchCheck\nconst capitalizedFromBatch =\n    (batchCheck && Array.isArray(batchCheck[\"Capitalized\"])) ? batchCheck[\"Capitalized\"] : [];\nmergeTargets.push({ name: \"Capitalized\", values: capitalizedFromBatch });\n\n// Include Project_Status_Not_Capitalizable from projectStatusCheck\nconst psNotCap =\n    (projectStatusCheck && Array.isArray(projectStatusCheck[\"Project_Status_Not_Capitalizable\"]))\n        ? projectStatusCheck[\"Project_Status_Not_Capitalizable\"]\n        : [];\nmergeTargets.push({ name: \"Project_Status_Not_Capitalizable\", values: psNotCap });\n\nconst txMarkedNotCap =\n    (projectStatusCheck && Array.isArray(projectStatusCheck[\"Transaction_Marked_Not_Capitalizable\"]))\n        ? projectStatusCheck[\"Transaction_Marked_Not_Capitalizable\"]\n        : [];\nmergeTargets.push({ name: \"Transaction_Marked_Not_Capitalizable\", values: txMarkedNotCap });\n\n// Perform merges with de-duplication\nfor (let m = 0; m < mergeTargets.length; m++) {\n    const bucketName = mergeTargets[m].name;\n    const values = mergeTargets[m].values;\n    if (!Array.isArray(values) || values.length === 0) continue;\n\n    const base = Array.isArray(updated[bucketName]) ? updated[bucketName].slice() : [];\n    const seen = new Set(base.map(x => String(x)));\n\n    for (let i = 0; i < values.length; i++) {\n        const v = values[i];\n        if ((typeof v === \"string\" || typeof v === \"number\") && v !== null && v !== undefined) {\n            const k = String(v);\n            if (!seen.has(k)) {\n                seen.add(k);\n                base.push(v);\n            }\n        }\n    }\n\n    updated[bucketName] = base;\n}\n\nreturn updated;"
          },
          "outcomes": {
            "success": "1771812183551"
          },
          "code": "EVENT_BASED_CHECK",
          "id": "1771754785363",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Extract Current Summary",
            "returnType": "object",
            "sourceCode": "const raw = $context.$nodes.EVENT_BASED_CHECK.$output.result ;\n// Buckets to exclude\nconst exclude = new Set([\"Not_Event_Based\", \"Event_Not_Stamped\", \"Transactions_To_Process\",\"Not_Cross_Charge_NONBTC\", \"Project_Status_Check_Needed\"]);\n// Validate input is an object map\nconst filteredBuckets = {};\nif (raw && typeof raw === \"object\" && !Array.isArray(raw)) {\nconst keys = Object.keys(raw).sort(); // stable order\nfor (let i = 0; i < keys.length; i++) {\nconst bucket = keys[i];\nif (exclude.has(bucket)) continue;\nconst val = raw[bucket];\nif (Array.isArray(val)) {\n// Keep only primitives, de-duplicate while preserving order\nconst seen = new Set();\nconst arr = [];\nfor (let j = 0; j < val.length; j++) {\nconst v = val[j];\nif ((typeof v === \"string\" || typeof v === \"number\") && v !== null && v !== undefined) {\nconst key = String(v);\nif (!seen.has(key)) {\nseen.add(key);\narr.push(v);\n}\n}\n}\nfilteredBuckets[bucket] = arr;\n} else if (val !== null && val !== undefined && (typeof val === \"string\" || typeof val === \"number\")) {\n// Coerce single primitive to array\nfilteredBuckets[bucket] = [val];\n} else {\n// Skip invalid shapes\n}\n}\n}\n// Final result\nconst result = filteredBuckets;\nreturn result;"
          },
          "outcomes": {
            "success": "1771721753043"
          },
          "code": "EXTRACT_CURRENT_SUMMARY",
          "id": "1771812183551",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Transactions For InService Assets Check",
            "returnType": "array",
            "sourceCode": "// Safely read first input\nconst raw = $context?.$nodes?.EVENT_BASED_CHECK?.$output?.result || {};\n\n// Example: second array input source\nconst additionalTransactions =$context.$variables.PrjPjcVarConvTransactionsToProcess || [];\n\n// Extract Not_Event_Based whether raw is an object or a string\nlet notEventBased = [];\n\nif (typeof raw === \"string\") {\n  try {\n    const parsed = JSON.parse(raw);\n\n    if (\n      parsed &&\n      typeof parsed === \"object\" &&\n      Array.isArray(parsed[\"Not_Event_Based\"])\n    ) {\n      notEventBased = parsed[\"Not_Event_Based\"];\n    }\n  } catch (e) {\n    notEventBased = [];\n  }\n} else if (\n  raw &&\n  typeof raw === \"object\" &&\n  Array.isArray(raw[\"Not_Event_Based\"])\n) {\n  notEventBased = raw[\"Not_Event_Based\"];\n}\n\n// Ensure additionalTransactions is always an array\nconst extraArray = Array.isArray(additionalTransactions)\n  ? additionalTransactions\n  : [];\n\n// Merge both arrays\nreturn [...notEventBased, ...extraArray];"
          },
          "outcomes": {
            "success": "1771930409023"
          },
          "code": "TRANSACTIONS_FOR_INSERVICE_ASSETS_CHECK",
