        {
          "metadata": {
            "name": "Update Transaction Summary With Reset Accounting",
            "returnType": "object",
            "sourceCode": "const nested = $context.$nodes.RESET_ACCOUNTING_CHECK.$output \nconst existingSummary = $context.$variables.PrjPjcVarConvTransactionSummary \n\n// Normalize inputs\nconst nestedArr = Array.isArray(nested) ? nested : [];\nconst summary = (existingSummary && typeof existingSummary === \"object\" && !Array.isArray(existingSummary))\n? { ...existingSummary }\n: {};\n\n// Flatten nested arrays while preserving order and de-duplicating by string form\nconst toAdd = [];\nconst seenToAdd = new Set();\nfor (let i = 0; i < nestedArr.length; i++) {\nconst sub = nestedArr[i];\nif (!Array.isArray(sub)) continue;\nfor (let j = 0; j < sub.length; j++) {\nconst v = sub[j];\nif (v === null || v === undefined) continue;\nconst s = String(v).trim();\nif (s.length === 0) continue;\nif (!seenToAdd.has(s)) {\nseenToAdd.add(s);\n// keep numeric if purely digits, else keep as string\ntoAdd.push(/^\\d+$/.test(s) ? parseInt(s, 10) : s);\n}\n}\n}\n\n// Merge into Reset_Accounting_Not_Allowed bucket\nconst bucketName = \"Reset_Accounting_Not_Allowed\";\nconst base = Array.isArray(summary[bucketName]) ? summary[bucketName].slice() : [];\nconst seenBase = new Set(base.map(x => String(x)));\n\nfor (let k = 0; k < toAdd.length; k++) {\nconst v = toAdd[k];\nconst key = String(v);\nif (!seenBase.has(key)) {\nseenBase.add(key);\nbase.push(v);\n}\n}\n\n// Only set the bucket if there's something to put (optional: always set)\nif (base.length > 0) {\nsummary[bucketName] = base;\n} else if (!summary.hasOwnProperty(bucketName)) {\n// If you prefer the bucket to exist even when empty, uncomment next line:\n// summary[bucketName] = [];\n}\n\nreturn summary;"
          },
          "outcomes": {
            "success": "1773421609454"
          },
          "code": "UPDATE_TRANSACTION_SUMMARY_WITH_RESET_ACCOUNTING_",
          "id": "1773421805996",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Add Asset Details to Transaction Details",
            "returnType": "array",
            "sourceCode": "const raw =\n($context && $context.$nodes && $context.$nodes.EVENT_BASED_CHECK &&\n$context.$nodes.EVENT_BASED_CHECK.$output &&\n$context.$nodes.EVENT_BASED_CHECK.$output.result)\n? $context.$nodes.EVENT_BASED_CHECK.$output.result\n: {};\n\nconst inserviceTransactions = $context?.$nodes?.TRANSACTIONS_FOR_INSERVICE_ASSETS_CHECK?.$output?.result || [];\nconst response = $context?.$nodes?.INSERVICE_ASSETS?.$output || [];\nconst mergedDetailsInput = $context?.$nodes?.FORMAT_TRANSACTION_AND_DISTRBUTION_DETAILS?.$output?.result || [];\n\n// 1) Shallow-clone merged details array so we don't mutate input\nconst mergedDetails = Array.isArray(mergedDetailsInput) ? mergedDetailsInput.slice() : [];\n\n// 2) Build txn -> projectId map (from mergedDetails: row.transactionNumber or row.details.transactionNumber; same for projectId)\nconst txnToProject = new Map();\nfor (let i = 0; i < mergedDetails.length; i++) {\nconst row = mergedDetails[i];\nif (!row || typeof row !== \"object\") continue;\n\nconst txnVal = row.transactionNumber != null\n? row.transactionNumber\n: (row.details && row.details.transactionNumber != null ? row.details.transactionNumber : null);\n\nconst projVal = row.projectId != null\n? row.projectId\n: (row.details && row.details.projectId != null ? row.details.projectId : null);\n\nconst tStr = txnVal == null ? \"\" : String(txnVal).trim();\nconst pStr = projVal == null ? \"\" : String(projVal).trim();\n\nif (!/^\\d+$/.test(tStr) || !pStr) continue;\n\nconst tNum = parseInt(tStr, 10);\nif (!Number.isFinite(tNum)) continue;\n\ntxnToProject.set(tNum, pStr);\n}\n\n// 3) Parse/flatten INSERVICE_ASSETS response into projectId -> [assetRows]\nconst byProject = new Map();\nfor (let i = 0; i < (Array.isArray(response) ? response.length : 0); i++) {\nlet item = response[i];\n\nif (typeof item === \"string\") {\nconst s = item.trim();\nif (!s) continue;\ntry { item = JSON.parse(s); } catch (e) { item = null; }\n}\nif (!item) continue;\n\nif (Array.isArray(item)) {\nfor (let j = 0; j < item.length; j++) {\nconst r = item[j];\nif (!r || typeof r !== \"object\") continue;\nconst p = r.projectId == null ? \"\" : String(r.projectId).trim();\nif (!p) continue;\nif (!byProject.has(p)) byProject.set(p, []);\nbyProject.get(p).push(r);\n}\n} else if (typeof item === \"object\") {\nconst p = item.projectId == null ? \"\" : String(item.projectId).trim();\nif (!p) continue;\nif (!byProject.has(p)) byProject.set(p, []);\nbyProject.get(p).push(item);\n}\n}\n\n// 4) Attach assetDetails to each merged transaction row by projectId\nconst updated = [];\nfor (let i = 0; i < mergedDetails.length; i++) {\nconst row = mergedDetails[i];\nif (!row || typeof row !== \"object\") {\nupdated.push(row);\ncontinue;\n}\n\nconst txnVal = row.transactionNumber != null\n? row.transactionNumber\n: (row.details && row.details.transactionNumber != null ? row.details.transactionNumber : null);\n\nconst projVal = row.projectId != null\n? row.projectId\n: (row.details && row.details.projectId != null ? row.details.projectId : null);\n\nconst tStr = txnVal == null ? \"\" : String(txnVal).trim();\nconst pStr = projVal == null ? \"\" : String(projVal).trim();\n\n// Default: no asset details\nlet assets = [];\n\nif (/^\\d+$/.test(tStr) && pStr) {\n// If we have a valid project, attach all asset rows for that project\nassets = byProject.has(pStr) ? byProject.get(pStr).slice() : [];\n}\n\n// Shallow-copy row and attach assetDetails\nconst copy = Array.isArray(row) ? row.slice() : { ...row };\ncopy.assetDetails = assets;\n\nupdated.push(copy);\n}\n\n// 5) Return updated merged transaction details\nreturn updated;"
          },
          "outcomes": {
            "success": "1771937823231"
          },
          "code": "ADD_ASSET_DETAILS_TO_TRANSACTION_DETAILS",
          "id": "1773489616713",
