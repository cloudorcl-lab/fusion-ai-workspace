            "name": "Extract And Batch ProjectIds For Inservice",
            "returnType": "array",
            "sourceCode": "// Inputs\nconst transactions = $context.$nodes.TRANSACTIONS_FOR_INSERVICE_ASSETS_CHECK.$output.result || []; // array of txn numbers/strings\nconst mergedDetails = ( $context.$nodes.FORMAT_TRANSACTION_AND_DISTRBUTION_DETAILS.$output.result ) || [];\n\n// 1) Build txn -> projectId lookup (support flat or nested \"details\")\nconst txnToProject = new Map();\nfor (let i = 0; i < (Array.isArray(mergedDetails) ? mergedDetails.length : 0); i++) {\nconst row = mergedDetails[i];\nif (!row) continue;\nconst txnVal = row.transactionNumber != null ? row.transactionNumber\n: (row.details && row.details.transactionNumber != null ? row.details.transactionNumber : null);\nconst projVal = row.projectId != null ? row.projectId\n: (row.details && row.details.projectId != null ? row.details.projectId : null);\nconst txnStr = txnVal == null ? \"\" : String(txnVal).trim();\nconst projStr = projVal == null ? \"\" : String(projVal).trim();\nif (/^\\d+$/.test(txnStr) && projStr) {\ntxnToProject.set(parseInt(txnStr, 10), projStr);\n}\n}\n\n// 2) Normalize input transactions and collect corresponding projectIds (dedup, preserve order)\nconst seenProj = new Set();\nconst projectIds = [];\nfor (let i = 0; i < (Array.isArray(transactions) ? transactions.length : 0); i++) {\nconst v = transactions[i];\nif (v == null) continue;\nconst s = String(v).trim();\nif (!/^\\d+$/.test(s)) continue;\nconst n = parseInt(s, 10);\nif (!Number.isFinite(n)) continue;\nconst pid = txnToProject.get(n);\nif (!pid) continue;\nif (!seenProj.has(pid)) {\nseenProj.add(pid);\nprojectIds.push(pid);\n}\n}\n\n// 3) Chunk projectIds into strings of up to 10 IDs each, formatted \"(id1,id2,...)\"\nconst result = [];\nfor (let i = 0; i < projectIds.length; i += 10) {\nconst end = Math.min(i + 10, projectIds.length);\nlet s = \"(\";\nfor (let j = i; j < end; j++) {\nif (j > i) s += \",\";\ns += projectIds[j];\n}\ns += \")\";\nresult.push(s);\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1771931021751"
          },
