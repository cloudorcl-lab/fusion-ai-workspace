                {
                  "metadata": {
                    "name": "Prepare Payload For ProjectCostAccountingDistribution",
                    "returnType": "object",
                    "sourceCode": "const transactionNumbers = $context.$nodes.PROJECTCOSTACCOUNTINGDISTRIBUTION.$currentItem ;\n\nconst payload ={\n    \"viewQueries\": {\n        \"projectCostAccountingDistribution\": {\n            \"module\": \"oraErpCoreProjectCostTransactions\",\n            \"businessObject\": \"ProjectAccountedProjectCostAccountingDistribution\",\n            \"view\": \"projectAccountedProjectCostAccountingDistributionDetails\",\n            \"fieldAliases\": {\n               \n                \"costDistribution.transactionNumber\":\"transactionNumber\",\n                \"costDistribution.lineNumber\":\"lineNumber\",\n                \"subledgerAccountingEntryLine.subledgerAccountingEntryHeader.subledgerAccountingEvent.eventStatusCode\":\"eventStatusCode\",\n                \"subledgerAccountingEntryLine.accountingClassLookup.lookupCode\":\"accountingClassCode\"\n                \n            }\n        }\n    },\n    \"select\": `SELECT transactionNumber,lineNumber,eventStatusCode,accountingClassCode from projectCostAccountingDistribution where transactionNumber IN ${transactionNumbers} `,\n    \"return\": [\n       \n        {\n            \"name\": \"transactionNumber\",\n            \"type\": \"string\"\n        },\n        {\n            \"name\":\"lineNumber\",\n            \"type\":\"string\"\n        },\n        {\n            \"name\":\"eventStatusCode\",\n            \"type\":\"string\"\n        },\n        {\n            \"name\":\"accountingClassCode\",\n            \"type\":\"string\"\n        }\n    ]\n};\n\n\nreturn payload;"
                  },
