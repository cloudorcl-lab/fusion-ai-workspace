                {
                  "metadata": {
                    "name": "Prepare Payload For Get Asset Assignments",
                    "returnType": "object",
                    "sourceCode": "const inputVals = $context.$nodes.GET_ASSET_ASSIGNMENTS.$currentItem ;\n\n\n// Normalize to strings to match your return schema (strings for IDs except id which is int64)\nconst newProjectId = inputVals.projectId == null ? \"\" : String(inputVals.projectId).trim();\nconst newTaskId = inputVals.taskId == null ? \"\" : String(inputVals.taskId).trim();\nconst newTopTaskId = inputVals. denormTopElementId == null ? \"\" : String(inputVals. denormTopElementId).trim();\n\nconst payload ={\n    \"viewQueries\": {\n        \"projectAssetAssignment\": {\n            \"module\": \"oraErpCoreProjectAsset\",\n            \"businessObject\": \"ProjectAssetAssignment\",\n            \"view\": \"projectAssetAssignmentsView\",\n            \"fieldAliases\": {\n                \"id\":\"id\",\n                \"project.id\":\"projectId\",\n                \"task.id\":\"taskId\",\n                \"projectAsset.id\":\"projectAssetId\",\n                \"task.topTask.id\":\"topTaskId\",\n               \"commonCostFlag\":\"commonCostFlag\"\n            }\n        }\n    },\n    \"select\": `SELECT id,projectId,taskId, projectAssetId,topTaskId,commonCostFlag from projectAssetAssignment where projectId=${newProjectId}  and (topTaskId=${newTopTaskId} or topTaskId is null)`,\n    \"return\": [\n        {\n            \"name\": \"id\",\n            \"type\": \"int64\"\n        },\n        {\n            \"name\":\"projectId\",\n            \"type\":\"string\"\n        },\n        {\n            \"name\":\"taskId\",\n            \"type\":\"int64\"\n        },{\n            \"name\":\"projectAssetId\",\n            \"type\":\"int64\"\n        },\n        {\n            \"name\":\"topTaskId\",\n            \"type\":\"int64\"\n        },\n         {\n            \"name\":\"commonCostFlag\",\n            \"type\":\"string\"\n        }\n    ]\n};\n\n\nreturn payload;"
                  },
