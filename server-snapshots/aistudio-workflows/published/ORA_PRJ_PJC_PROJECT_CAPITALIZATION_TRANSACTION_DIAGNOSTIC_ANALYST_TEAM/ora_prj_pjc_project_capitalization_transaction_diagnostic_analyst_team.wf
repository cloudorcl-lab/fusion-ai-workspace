            "name": "Final output",
            "returnType": "array",
            "sourceCode": "// Inputs\nconst detailsInput =\n  ( $context.$variables.prjPjcVarConvTransactionDetails === \"object\")\n    ? $context.$variables.prjPjcVarConvTransactionDetails \n    : ( $context.$variables.prjPjcVarConvTransactionDetails || {});\n\nconst summaryInput =\n  ( $context.$variables.PrjPjcVarConvTransactionSummary === \"object\")\n    ? $context.$variables.PrjPjcVarConvTransactionSummary \n    : ( $context.$variables.PrjPjcVarConvTransactionSummary || {});\n\n// Build result as an array with two objects\nconst result = [\n  { prjPjcVarConvTransactionDetails: detailsInput },\n  { prjPjcVarConvTransactionSummary: summaryInput }\n];\n\nreturn result;"
