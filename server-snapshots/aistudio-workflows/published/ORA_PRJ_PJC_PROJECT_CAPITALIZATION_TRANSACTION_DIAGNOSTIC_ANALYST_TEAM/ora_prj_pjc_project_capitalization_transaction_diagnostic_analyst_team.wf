{
  "workflowId": "300000331058412",
  "workflowCode": "ORA_PRJ_PJC_PROJECT_CAPITALIZATION_TRANSACTION_DIAGNOSTIC_ANALYST_TEAM",
  "name": "Project Capitalization Transaction Diagnostic Analyst",
  "description": "This agent helps Project Asset Accountants understand why project costs weren't capitalized in Oracle Projects. It reviews transaction attributes, capitalization setup, asset assignments, accounting readiness, and processing status; groups findings by issue; and provides recommended actions to resolve and reprocess capitalization.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
