            "success": "1779095478421"
          },
          "code": "CHECK_ASSET_EVENT_STAMP",
          "id": "1779095434237",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Update Transactions To Process",
            "returnType": "array",
            "sourceCode": "const obj =\n  ($context && $context.$nodes && $context.$nodes.CHECK_ASSET_EVENT_STAMP &&\n   $context.$nodes.CHECK_ASSET_EVENT_STAMP.$output &&\n   $context.$nodes.CHECK_ASSET_EVENT_STAMP.$output.result) || {};\n\nconst existing = $context.$variables.PrjPjcVarConvTransactionsToProcess || [];\n\n// from CHECK_ASSET_EVENT_STAMP\nconst source = Array.isArray(obj.Transactions_To_Process)\n  ? obj.Transactions_To_Process\n  : [];\n\nconst assetNotStamped = Array.isArray(obj.Asset_Not_Event_Stamped)\n  ? obj.Asset_Not_Event_Stamped\n  : [];\n\n// remove Asset_Not_Event_Stamped from existing\nconst blocked = new Set(assetNotStamped.map(v => String(v)));\nconst base = Array.isArray(existing)\n  ? existing.filter(v => !blocked.has(String(v)))\n  : [];\n\nconst resultArr = [];\nconst seen = new Set();\n\n// seed with filtered existing\nfor (let i = 0; i < base.length; i++) {\n  const v = base[i];\n  if ((typeof v === \"string\" || typeof v === \"number\") && v !== null && v !== undefined) {\n    const k = String(v);\n    if (!seen.has(k)) {\n      seen.add(k);\n      resultArr.push(v);\n    }\n  }\n}\n\n// add only new transactions from Transactions_To_Process\nfor (let i = 0; i < source.length; i++) {\n  const v = source[i];\n  if ((typeof v === \"string\" || typeof v === \"number\") && v !== null && v !== undefined) {\n    const k = String(v);\n    if (!seen.has(k)) {\n      seen.add(k);\n      resultArr.push(v);\n    }\n  }\n}\n\nreturn resultArr;"
          },
