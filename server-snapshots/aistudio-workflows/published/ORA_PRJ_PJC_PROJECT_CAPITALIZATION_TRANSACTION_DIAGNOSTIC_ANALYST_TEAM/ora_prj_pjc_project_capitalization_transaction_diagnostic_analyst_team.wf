            "name": "Extract And Batch Capital Event Id",
            "returnType": "array",
            "sourceCode": "const grouped = $context.$nodes.EXTRACT_TRANSACTIONS_TO_PROCESS.$output.result ;\nconst mergedTransactionDetails = $context.$nodes.FORMAT_TRANSACTION_AND_DISTRBUTION_DETAILS.$output.result ;\n\n\nlet stampedTxns = grouped;\n\nif (typeof stampedTxns === \"string\") {\n  try {\n    stampedTxns = JSON.parse(stampedTxns);\n  } catch (e) {\n    stampedTxns = [];\n  }\n}\n\nif (!Array.isArray(stampedTxns)) {\n  stampedTxns = [];\n}\n\n\n// 2) Build a map: transactionNumber -> capitalEventId\nconst txToCapitalEventId = {};\nif (Array.isArray(mergedTransactionDetails)) {\nfor (let i = 0; i < mergedTransactionDetails.length; i++) {\nconst t = mergedTransactionDetails[i];\nif (t && t.transactionNumber != null && t.capitalEventId != null) {\ntxToCapitalEventId[String(t.transactionNumber)] = String(t.capitalEventId);\n}\n}\n}\n\n// 3) Resolve capitalEventIds for stamped transactions, de-duplicate preserving order\nconst capitalEventIds = [];\nconst seen = new Set();\nfor (let i = 0; i < stampedTxns.length; i++) {\nconst txn = stampedTxns[i];\nconst cid = txToCapitalEventId[String(txn)];\nif (cid != null && !seen.has(cid)) {\nseen.add(cid);\ncapitalEventIds.push(cid);\n}\n}\n\nconst batches = [];\nfor (let i = 0; i < capitalEventIds.length; i += 10) {\n  const chunk = capitalEventIds.slice(i, i + 10);\n  batches.push(`(${chunk.join(\",\")})`);\n}\n\n// Final result array of strings\nconst result = batches;\nreturn result;"
          },
