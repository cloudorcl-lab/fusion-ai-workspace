        {
          "metadata": {
            "name": "Update Summary With Event Check",
            "returnType": "object",
            "sourceCode": "const existingGroups = $context.$variables.PrjPjcVarConvTransactionSummary || {};\nconst eventOutput = $context.$nodes.CHECK_EVENT_EXISTS.$output.result || {};\n\n// copy existing groups without mutating\nconst updatedBatches = {};\nif (existingGroups && typeof existingGroups === \"object\" && !Array.isArray(existingGroups)) {\n  const keys = Object.keys(existingGroups);\n  for (let i = 0; i < keys.length; i++) {\n    const k = keys[i];\n    const v = existingGroups[k];\n    updatedBatches[k] = Array.isArray(v) ? v.slice() : v;\n  }\n}\n\nconst mergeIfNotEmpty = (key, value) => {\n  if (\n    value != null &&\n    !(\n      Array.isArray(value) && value.length === 0\n    ) &&\n    !(typeof value === \"string\" && value.trim() === \"\") &&\n    !(typeof value === \"object\" && !Array.isArray(value) && Object.keys(value).length === 0)\n  ) {\n    const incoming = Array.isArray(value) ? value : [value];\n    const current = Array.isArray(updatedBatches[key]) ? updatedBatches[key] : [];\n    const merged = current.concat(incoming);\n\n    const seen = new Set();\n    const deduped = [];\n    for (let i = 0; i < merged.length; i++) {\n      const v = merged[i];\n      const keyStr = String(v);\n      if (!seen.has(keyStr)) {\n        seen.add(keyStr);\n        deduped.push(v);\n      }\n    }\n\n    updatedBatches[key] = deduped;\n  }\n};\n\nmergeIfNotEmpty(\"Event_Exists\", eventOutput.Event_Exists);\nmergeIfNotEmpty(\"Event_DoesNot_Exists\", eventOutput.Event_DoesNot_Exists);\n\nreturn updatedBatches;"
          },
