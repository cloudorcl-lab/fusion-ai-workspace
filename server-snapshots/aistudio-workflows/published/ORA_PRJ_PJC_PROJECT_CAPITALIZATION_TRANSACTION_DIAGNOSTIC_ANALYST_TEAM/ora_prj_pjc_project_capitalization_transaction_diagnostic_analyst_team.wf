                {
                  "metadata": {
                    "name": "Prepare Payload For Check Asset Lines Exists",
                    "returnType": "object",
                    "sourceCode": "const transactionNumbers = $context.$nodes.CAPITALIZED_CHECK_FOR_NON_BTC_TRANSACTIONS.$currentItem ;\n\nconst payload ={\n    \"viewQueries\": {\n        \"projectCostTransactionDistribution\": {\n            \"module\": \"oraErpCoreProjectCostTransactions\",\n            \"businessObject\": \"ProjectCostTransactionDistribution\",\n            \"view\": \"projectCostTransactionDistributionDetails\",\n            \"fieldAliases\": {\n                \"transactionNumber\": \"costTransactionNumber\",\n                \"lineNumber\": \"costLineNumber\",\n                \"capitalizable.lookupCode\": \"capitalizableFlag\"\n            }\n        },\n        \"projectAssetLineDetail\": {\n            \"module\": \"oraErpCoreProjectAsset\",\n            \"businessObject\": \"ProjectAssetLineDetail\",\n            \"view\": \"projectAssetLineDetailsView\",\n            \"fieldAliases\": {\n                \"costDistribution.transactionNumber\": \"assetTransactionNumber\",\n                \"costDistribution.lineNumber\": \"assetLineNumber\"\n            }\n        }\n    },\n    \"select\": `SELECT costTransactionNumber, costLineNumber FROM projectCostTransactionDistribution cdl WHERE costTransactionNumber in ${transactionNumbers} AND cdl.capitalizableFlag = 'Y' AND NOT EXISTS (SELECT 1 FROM projectAssetLineDetail ald WHERE ald.assetTransactionNumber = cdl.costTransactionNumber AND ald.assetLineNumber = cdl.costLineNumber) `,\n    \"return\": [\n        {\n            \"name\": \"TransactionNumber\",\n            \"type\": \"int64\"\n        },\n        {\n            \"name\": \"costLineNumber\",\n            \"type\": \"int64\"\n        }\n    ]\n};\n\nreturn payload;"
                  },
                  "outcomes": {
                    "success": "1771735615548"
                  },
