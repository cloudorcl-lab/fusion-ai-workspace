        {
          "metadata": {
            "name": "Extract AssetIds Of Specific Asset Assignments",
            "returnType": "array",
            "sourceCode": "// Input\nconst classification =\n  $context.$nodes.ASSIGNMENTCLASSIFICATION.$output.result\n    ? $context.$nodes.ASSIGNMENTCLASSIFICATION.$output.result\n    : {};\n\n// 1) Safely read maps\nconst taskSpec =\n  classification && typeof classification.TaskSpecific === \"object\"\n    ? classification.TaskSpecific\n    : {};\n\nconst topTaskSpec =\n  classification && typeof classification.TopTaskSpecific === \"object\"\n    ? classification.TopTaskSpecific\n    : {};\n\nconst projSpec =\n  classification && typeof classification.ProjectSpecific === \"object\"\n    ? classification.ProjectSpecific\n    : {};\n\n\n\n// 2) Collect assetIds (dedupe + preserve order)\nconst seen = new Set();\nconst assetIds = [];\n\n// ---- Process taskSpec ----\nvar keys = Object.keys(taskSpec);\nfor (var i = 0; i < keys.length; i++) {\n  var k = keys[i];\n  var arr = Array.isArray(taskSpec[k]) ? taskSpec[k] : [];\n\n  for (var j = 0; j < arr.length; j++) {\n    var v = arr[j];\n    if (v === null || v === undefined) continue;\n\n    var s = String(v).trim();\n    if (s.length === 0) continue;\n\n    if (!seen.has(s)) {\n      seen.add(s);\n      assetIds.push(s);\n    }\n  }\n}\n\n// ---- Process topTaskSpec ----\nkeys = Object.keys(topTaskSpec);\nfor (var i = 0; i < keys.length; i++) {\n  var k = keys[i];\n  var arr = Array.isArray(topTaskSpec[k]) ? topTaskSpec[k] : [];\n\n  for (var j = 0; j < arr.length; j++) {\n    var v = arr[j];\n    if (v === null || v === undefined) continue;\n\n    var s = String(v).trim();\n    if (s.length === 0) continue;\n\n    if (!seen.has(s)) {\n      seen.add(s);\n      assetIds.push(s);\n    }\n  }\n}\n\n// ---- Process projSpec ----\nkeys = Object.keys(projSpec);\nfor (var i = 0; i < keys.length; i++) {\n  var k = keys[i];\n  var arr = Array.isArray(projSpec[k]) ? projSpec[k] : [];\n\n  for (var j = 0; j < arr.length; j++) {\n    var v = arr[j];\n    if (v === null || v === undefined) continue;\n\n    var s = String(v).trim();\n    if (s.length === 0) continue;\n\n    if (!seen.has(s)) {\n      seen.add(s);\n      assetIds.push(s);\n    }\n  }\n}\n\n\n// 3) Chunk into batches of 10 → \"(id1,id2,...)\"\nconst batches = [];\n\nfor (var i = 0; i < assetIds.length; i += 10) {\n  var end = Math.min(i + 10, assetIds.length);\n  var str = \"(\";\n\n  for (var j = i; j < end; j++) {\n    if (j > i) str += \",\";\n    str += assetIds[j];\n  }\n\n  str += \")\";\n  batches.push(str);\n}\n\nreturn batches;"
          },
