            "sourceCode": "const input = $context.$nodes.EXTRACT_TRANSACTIONS_TO_PROCESS.$output.result ;\n\n// Normalize into an array\nlet arr = input;\n\n// If input comes as a string, try to parse it\nif (typeof arr === \"string\") {\n  try {\n    arr = JSON.parse(arr);\n  } catch (e) {\n    arr = [];\n  }\n}\n\n// Return true if it is an array and not empty, else false\nconst result = Array.isArray(arr) && arr.length > 0;\nreturn result;"
