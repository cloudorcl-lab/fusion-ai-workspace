                {
                  "metadata": {
                    "name": "Prepare Payload For Fetching Transaction Details",
                    "returnType": "object",
                    "sourceCode": "const transactionNumbers = $context.$nodes.GET_TRANSACTION_AND_DISTRIBUTION_DETAILS_IN_BATCH.$currentItem ;\n\nconst payload ={\n    \"viewQueries\": {\n        \"projectCostTransaction\": {\n            \"module\": \"oraErpCoreProjectCostTransactions\",\n            \"businessObject\": \"ProjectCostTransaction\",\n            \"view\": \"projectCostTransactionDetails\",\n            \"fieldAliases\": {\n                \"transactionNumber\": \"transactionNumber\",\n                \"transactionDate\":\"transactionDate\",\n                \"capitalizable.lookupCode\": \"capitalizableFlag\",\n                \"capitalEvent.id\": \"capitalEventId\",\n                \"projectCostClassification.code\": \"projectCostClassificationCode\",\n                \"project.projectType.enableCapitalizationFlag\": \"enableCapitalizationFlag\",\n                \"includedInAssetLine\":\"includedInAssetLine\",\n                \"adjustmentStatus.lookupCode\": \"adjustmentStatus\",\n                \"transferredFromTransactionNumber\":\"transferredFromTransactionNumber\",\n                \"adjustingTransactionNumber\":\"adjustingTransactionNumber\",\n                \"receiverLedgerCurrency.currencyCode\":\"receiverLedgerCurrencyCode\",\n                \"project.id\": \"projectId\",\n                \"project.name\":\"projectName\",\n                \"project.projectNumber\":\"projectNumber\",\n                \"project.projectType.constructionInProgressCostBasis\":\"capitalCostTypeCode\",\n                \"receiverBusinessUnit.information.primaryLedger.ledgerId\":\"receiverLedger\",\n                \"businessUnit.information.primaryLedger.ledgerId\":\"buLedger\",\n                \"burdenedCostInReceiverLedgerCurrency\":\"burdenedCostInReceiverLedgerCurrency\",\n                \"rawCostInReceiverLedgerCurrency\":\"rawCostInReceiverLedgerCurrency\",\n                \"project.capitalEventProcessingMethod\":\"capitalEventProcessing\",\n                \"task.id\":\"taskId\",\n                \"task.name\":\"taskName\",\n                \"task.taskNumber\":\"taskNumber\",\n                \"task.topTask.id\":\"denormTopElementId\",\n                \"task.capitalizableFlag\":\"taskCapitalizableFlag\",\n                \"transactionSource.name\":\"transactionSource\",\n                 \"project.status.code\": \"projectStatusCode\",\n                \"netZeroItemFlag\":\"netZeroItemFlag\",\n                \"document.createAdjustmentAccountingJournalEntriesFlag\":\"adjustmentAccountingFlag\"\n                 }\n        }\n    },\n    \"select\": `SELECT transactionNumber,transactionDate, capitalizableFlag,capitalEventId,projectCostClassificationCode, enableCapitalizationFlag, includedInAssetLine, adjustmentStatus,transferredFromTransactionNumber,adjustingTransactionNumber,projectId,projectName, projectNumber,receiverLedger,buLedger, capitalCostTypeCode,burdenedCostInReceiverLedgerCurrency ,rawCostInReceiverLedgerCurrency,capitalEventProcessing,taskId,taskName, taskNumber,denormTopElementId,taskCapitalizableFlag,transactionSource, projectStatusCode,netZeroItemFlag,receiverLedgerCurrencyCode,adjustmentAccountingFlag FROM projectCostTransaction where transactionNumber IN ${transactionNumbers} `,\n    \"return\": [\n        {\n            \"name\": \"transactionNumber\",\n            \"type\": \"int64\"\n        },\n        {\n            \"name\":\"transactionDate\",\n            \"type\":\"string\"\n        },\n        \n        {\n            \"name\": \"capitalizableFlag\",\n            \"type\": \"string\"\n        },\n        {\n            \"name\":\"capitalEventId\",\n            \"type\":\"string\"\n        },\n        {\n            \"name\": \"projectCostClassificationCode\",\n            \"type\": \"string\"\n        },\n        {\n            \"name\": \"enableCapitalizationFlag\",\n            \"type\": \"boolean\"\n        },\n        {\n            \"name\": \"includedInAssetLine\",\n            \"type\": \"string\"\n        },\n        \n        {\n            \"name\": \"adjustmentStatus\",\n            \"type\": \"string\"\n        },\n        {\n            \"name\":\"transferredFromTransactionNumber\",\n            \"type\":\"string\"\n        },\n        {\n            \"name\":\"adjustingTransactionNumber\",\n            \"type\":\"string\"\n        },\n       \n        {\n            \"name\":\"projectId\",\n            \"type\":\"string\"\n        },\n        {\n            \"name\":\"projectName\",\n            \"type\":\"string\"\n        },\n        {\n            \"name\":\"projectNumber\",\n            \"type\":\"string\"\n        },\n        {\n            \"name\":\"receiverLedger\",\n            \"type\":\"string\"\n        },\n        {\n            \"name\":\"buLedger\",\n            \"type\":\"string\"\n        },\n        {\n            \"name\":\"capitalCostTypeCode\",\n            \"type\":\"string\"\n        },\n        {\n            \"name\":\"burdenedCostInReceiverLedgerCurrency\",\n            \"type\":\"big-decimal\"\n        },\n        {\n            \"name\":\"rawCostInReceiverLedgerCurrency\",\n            \"type\":\"big-decimal\"\n        },\n{\n            \"name\":\"capitalEventProcessing\",\n            \"type\":\"string\"\n        },\n        {\n            \"name\":\"taskId\",\n            \"type\":\"int64\"\n        },\n        {\n            \"name\":\"taskName\",\n            \"type\":\"string\"\n        },\n        {\n            \"name\":\"taskNumber\",\n            \"type\":\"string\"\n        },\n        {\n            \"name\":\"denormTopElementId\",\n            \"type\":\"int64\"\n        },\n        {\n            \"name\":\"taskCapitalizableFlag\",\n            \"type\":\"string\"\n        },\n        {\n            \"name\":\"transactionSource\",\n            \"type\":\"string\"\n        },\n{\n            \"name\":\"projectStatusCode\",\n            \"type\":\"string\"\n        },\n        {\n            \"name\":\"netZeroItemFlag\",\n            \"type\":\"string\"\n        },\n        {\n            \"name\":\"receiverLedgerCurrencyCode\",\n            \"type\":\"string\"\n        },\n       {\n            \"name\":\"adjustmentAccountingFlag\",\n            \"type\":\"string\"\n        }\n    ]\n};\n\n\nreturn payload;"
                  },
