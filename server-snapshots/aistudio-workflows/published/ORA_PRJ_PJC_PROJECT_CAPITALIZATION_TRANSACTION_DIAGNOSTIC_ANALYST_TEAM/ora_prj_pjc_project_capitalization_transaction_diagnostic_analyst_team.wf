          "id": "1772173167380",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Check Capitalized For NonBTC",
            "returnType": "object",
            "sourceCode": "const txnBatches = Array.isArray( $context.$nodes.EXTRACT_AND_BATCH_TRANSACTION_NUMBERS.$output.result )\n? $context.$nodes.EXTRACT_AND_BATCH_TRANSACTION_NUMBERS.$output.result\n: ($context.$nodes.EXTRACT_AND_BATCH_TRANSACTION_NUMBERS.$output.result || []);\n\nconst responseRaw = Array.isArray( $context.$nodes.CAPITALIZED_CHECK_FOR_NON_BTC_TRANSACTIONS.$output )\n? $context.$nodes.CAPITALIZED_CHECK_FOR_NON_BTC_TRANSACTIONS.$output\n: ($context.$nodes.CAPITALIZED_CHECK_FOR_NON_BTC_TRANSACTIONS.$output || []);\n\nconst seenTxn = new Set();\nconst txns = [];\n\nfor (let i = 0; i < (Array.isArray(txnBatches) ? txnBatches.length : 0); i++) {\n  const s = txnBatches[i];\n  if (typeof s !== \"string\") continue;\n\n  const inner = s.trim().replace(/^\\(/, \"\").replace(/\\)$/, \"\");\n  if (!inner) continue;\n\n  const parts = inner.split(\",\").map(x => x.trim()).filter(x => x.length > 0);\n\n  for (let j = 0; j < parts.length; j++) {\n    const p = parts[j];\n    if (!/^\\d+$/.test(p)) continue;\n\n    const n = parseInt(p, 10);\n    if (Number.isFinite(n) && !seenTxn.has(n)) {\n      seenTxn.add(n);\n      txns.push(n);\n    }\n  }\n}\n\nconst present = new Set();\nconst stack = [...responseRaw];\n\nwhile (stack.length > 0) {\n  let item = stack.pop();\n  if (!item) continue;\n\n  if (typeof item === \"string\") {\n    try { item = JSON.parse(item); } catch { continue; }\n  }\n\n  if (Array.isArray(item)) {\n    stack.push(...item);\n    continue;\n  }\n\n  if (typeof item === \"object\") {\n    const tVal =\n      item.transactionNumber ??\n      item.TransactionNumber ??\n      item.costTransactionNumber ??\n      item.CostTransactionNumber;\n\n    if (/^\\d+$/.test(String(tVal))) {\n      present.add(parseInt(tVal, 10));\n    }\n  }\n}\n\nconst Transactions_To_Process = [];\nconst Capitalized = [];\n\nfor (const n of txns) {\n  if (present.has(n)) {\n    Transactions_To_Process.push(n);\n  } else {\n    Capitalized.push(n);\n  }\n}\n\nconst result = { Transactions_To_Process, Capitalized };\nreturn result;"
          },
