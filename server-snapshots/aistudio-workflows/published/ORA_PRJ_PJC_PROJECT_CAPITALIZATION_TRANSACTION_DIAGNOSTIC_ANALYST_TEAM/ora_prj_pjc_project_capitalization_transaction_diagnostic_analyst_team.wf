          "code": "UPDATE_STATE2",
          "id": "1772131229231",
          "inputs": [
            {
              "id": "1773681599146",
              "name": "PrjPjcVarConvTransactionsToProcess",
              "scope": "JOB",
              "type": "array",
              "value": "{{$context.$nodes.UPDATE_TRANSACTIONS_TO_PROCESS2.$output.result}}"
            },
            {
              "id": "1773490008105",
              "name": "prjPjcVarConvTransactionDetails",
              "scope": "JOB",
              "type": "object",
              "value": "{{$context.$nodes.UPDATE_TRANSACTION_DETAILS_WITH_ASSET_DETAILS.$output.result}}"
            },
            {
              "id": "1772131245218",
              "name": "PrjPjcVarConvTransactionSummary",
              "scope": "JOB",
              "type": "object",
              "value": "{{$context.$nodes.UPDATE_TRANSACTION_SUMMARY2.$output.result}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Group By Accounting Status Code",
            "returnType": "object",
            "sourceCode": "// Inputs\nlet rawTxns = $context.$variables.PrjPjcVarConvTransactionsToProcess || [];\n\nconst merged = $context.$variables.prjPjcVarConvTransactionDetails || [];\n\n// Normalize rawTxns into an array\nlet transactions;\nif (Array.isArray(rawTxns)) {\n  transactions = rawTxns;\n} else if (typeof rawTxns === \"number\") {\n  transactions = [rawTxns];\n} else if (typeof rawTxns === \"string\") {\n  const s = rawTxns.trim();\n  transactions = s.includes(\",\")\n    ? s.split(\",\").map(x => x.trim()).filter(x => x.length > 0)\n    : [s];\n} else if (rawTxns == null) {\n  transactions = [];\n} else {\n  transactions = [];\n}\n\n// 1) Normalize transactions to unique integers\nconst txnList = [];\nconst seenTxn = new Set();\n\nfor (let i = 0; i < transactions.length; i++) {\n  const v = transactions[i];\n  if (v == null) continue;\n\n  const s = String(v).trim();\n  if (!/^\\d+$/.test(s)) continue;\n\n  const n = parseInt(s, 10);\n  if (!Number.isFinite(n) || seenTxn.has(n)) continue;\n\n  seenTxn.add(n);\n  txnList.push(n);\n}\n\n// 2) Index merged by txn\nconst byTxn = new Map();\n\nfor (let i = 0; i < (Array.isArray(merged) ? merged.length : 0); i++) {\n  const row = merged[i];\n  if (!row || typeof row !== \"object\") continue;\n\n  const txnVal =\n    row.transactionNumber != null\n      ? row.transactionNumber\n      : (row.details && row.details.transactionNumber != null\n          ? row.details.transactionNumber\n          : null);\n\n  const tStr = txnVal == null ? \"\" : String(txnVal).trim();\n  if (!/^\\d+$/.test(tStr)) continue;\n\n  const tNum = parseInt(tStr, 10);\n  if (!Number.isFinite(tNum)) continue;\n\n  const typeRaw =\n    row.details && row.details.capitalCostTypeCode != null\n      ? String(row.details.capitalCostTypeCode).trim()\n      : (row.capitalCostTypeCode != null\n          ? String(row.capitalCostTypeCode).trim()\n          : \"\");\n\n  const type = typeRaw.toUpperCase();\n  const dists = Array.isArray(row.distributionDetails) ? row.distributionDetails : [];\n\n  byTxn.set(tNum, { type: type, dists: dists });\n}\n\n// 3) Buckets (transaction numbers only)\nconst buckets = {\n  Projects: new Set(),\n  NotApplicable: new Set(),\n  ExternallyAccounted: new Set(),\n  ReceiptCostPayables: new Set()\n};\n\n// 4) Classification using ONLY the highest lineNumber distribution\nfor (let i = 0; i < txnList.length; i++) {\n  const txn = txnList[i];\n  const info = byTxn.get(txn);\n  if (!info) continue;\n\n  const type = (info.type || \"\").toUpperCase();\n  const dists = Array.isArray(info.dists) ? info.dists : [];\n\n  let highestDist = null;\n  let highestLine = -1;\n\n  for (let j = 0; j < dists.length; j++) {\n    const d = dists[j];\n    if (!d || typeof d !== \"object\") continue;\n\n    const lnRaw = d.lineNumber;\n    const lnStr = lnRaw == null ? \"\" : String(lnRaw).trim();\n    if (!/^\\d+$/.test(lnStr)) continue;\n\n    const lnNum = parseInt(lnStr, 10);\n    if (!Number.isFinite(lnNum)) continue;\n\n    if (lnNum > highestLine) {\n      highestLine = lnNum;\n      highestDist = d;\n    }\n  }\n\n  if (!highestDist) continue;\n\n  const d = highestDist;\n\n  const capFlag =\n    d.distributionCapitalizableFlag == null\n      ? \"\"\n      : String(d.distributionCapitalizableFlag).trim().toUpperCase();\n\n  if (capFlag !== \"Y\") continue;\n\n  let srcVal = \"\";\n  if (type === \"R\") {\n    srcVal = d.rawCostJournalSource == null ? \"\" : String(d.rawCostJournalSource);\n  } else if (type === \"B\") {\n    srcVal = d.burdenedCostJournalSource == null ? \"\" : String(d.burdenedCostJournalSource);\n  } else {\n    continue;\n  }\n\n  const src = srcVal.trim().toUpperCase();\n\n  if (src === \"PROJECTS\" ) {\n    buckets.Projects.add(txn);\n  } else if (src === \"NOT_ENABLED\" ) {\n    buckets.NotApplicable.add(txn);\n  } else if (src === \"EXTERNALLY_ACCOUNTED\" ) {\n    buckets.ExternallyAccounted.add(txn);\n  } else if (\n    src === \"RECEIPT_ACCOUNTING\" ||\n    src === \"COST_ACCOUNTING\" ||\n    src === \"PAYABLES\" \n  ) {\n    buckets.ReceiptCostPayables.add(txn);\n  }\n}\n\n// 5) Convert Sets to arrays\nconst Projects = Array.from(buckets.Projects);\nconst NotApplicable = Array.from(buckets.NotApplicable);\nconst ExternallyAccounted = Array.from(buckets.ExternallyAccounted);\nconst ReceiptCostPayables = Array.from(buckets.ReceiptCostPayables);\n\n// 6) Return result\nreturn {\n  Projects,\n  NotApplicable,\n  ExternallyAccounted,\n  ReceiptCostPayables\n};"
          },
          "outcomes": {
            "success": "1772169276086"
          },
          "code": "GROUP_BY_ACCOUNTING_STATUS_CODE",
          "id": "1772132008006",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Extract project Accounting",
            "returnType": "array",
            "sourceCode": "let groupedResult = $context.$nodes.GROUP_BY_ACCOUNTING_STATUS_CODE?.$output?.result;\n\nif (typeof groupedResult === \"string\") {\n  try {\n    groupedResult = JSON.parse(groupedResult);\n  } catch {\n    groupedResult = {};\n  }\n}\n\nif (!groupedResult || typeof groupedResult !== \"object\") {\n  groupedResult = {};\n}\n\n// Collect unique transaction numbers from Projects\nconst txns = [];\nconst seen = new Set();\nconst projects = Array.isArray(groupedResult.Projects) ? groupedResult.Projects : [];\n\nfor (let i = 0; i < projects.length; i++) {\n  const row = projects[i];\n\n  // Support:\n  // 1) number: 8045827\n  // 2) string: \"8045827\"\n  // 3) object: { transactionNumber: 8045827 }\n  let value;\n  if (row && typeof row === \"object\") {\n    value = row.transactionNumber;\n  } else {\n    value = row;\n  }\n\n  if (value == null) continue;\n\n  const s = String(value).trim();\n  if (!/^\\d+$/.test(s)) continue;\n\n  if (!seen.has(s)) {\n    seen.add(s);\n    txns.push(s);\n  }\n}\n\n// Chunk into batches of up to 10 and format \"(id1,id2,...)\"\nconst batches = [];\nfor (let i = 0; i < txns.length; i += 10) {\n  const end = Math.min(i + 10, txns.length);\n  let s = \"(\";\n  for (let j = i; j < end; j++) {\n    if (j > i) s += \",\";\n    s += txns[j];\n  }\n  s += \")\";\n  batches.push(s);\n}\n\nreturn batches;"
          },
          "outcomes": {
            "success": "1772170884305"
          },
          "code": "EXTRACT_PROJECT_ACCOUNTING",
