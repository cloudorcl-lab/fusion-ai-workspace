                  "code": "GET_ASSETS_BY_ASSETIDS",
                  "id": "1772023775781",
                  "inputs": [
                    {
                      "id": "1772024066083_1",
                      "name": "payload",
                      "type": "string",
                      "value": "{{$context.$nodes.CHECK_INSERVICE_ASSETS.PREPARE_PAYLOAD_FOR_GET_ASSETS_BY_ASSET_ID.$output.result}}"
                    }
                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "Prepare Payload For Get Assets By Asset Id",
                    "returnType": "object",
                    "sourceCode": "const assetids= $context.$nodes.CHECK_INSERVICE_ASSETS.$currentItem ;\nconst payload =\n{\n    \"viewQueries\": {\n        \"projectAsset\": {\n            \"module\": \"oraErpCoreProjectAsset\",\n            \"businessObject\": \"ProjectAsset\",\n            \"view\": \"projectAssetsView\",\n            \"fieldAliases\": {\n                \"id\":\"id\",\n                \"capitalHoldFlag\":\"capitalHoldFlag\",\n                \"project.id\":\"projectId\",\n                \"assetType.lookupCode\":\"assetTypeCode\",\n                \"assetName\":\"assetName\",\n               \"actualInServiceOrRetirementDate\":\"actualInServiceOrRetirementDate\"\n            }\n        }\n    },\n    \"select\": `SELECT id,capitalHoldFlag,projectId,assetTypeCode,assetName, actualInServiceOrRetirementDate from projectAsset where id in ${assetids} and (assetTypeCode='RETIREMENT_ADJUSTMENT' or  assetTypeCode='AS-BUILT')`,\n    \"return\": [\n        {\n            \"name\": \"id\",\n            \"type\": \"int64\"\n        },\n        {\n            \"name\":\"capitalHoldFlag\",\n            \"type\":\"string\"\n        },\n        {\n            \"name\":\"projectId\",\n            \"type\":\"int64\"\n        },\n        {\n            \"name\":\"assetTypeCode\",\n            \"type\":\"string\"\n        },\n        {\n            \"name\":\"assetName\",\n            \"type\":\"string\"\n        },\n{\n   \"name\":\"actualInServiceOrRetirementDate\",\n   \"type\":\"date\"\n}\n\n    ]\n};\n\n\nreturn payload;"
                  },
                  "outcomes": {
                    "success": "1772023775781"
                  },
                  "code": "PREPARE_PAYLOAD_FOR_GET_ASSETS_BY_ASSET_ID",
                  "id": "1774158676838",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                }
              ],
              "rootNode": "start_1772023740595"
            },
            "loopType": "PARALLEL",
            "name": "Check Inservice Assets"
          },
          "outcomes": {
            "success": "1772025331223"
          },
          "code": "CHECK_INSERVICE_ASSETS",
          "id": "1772023740595",
          "inputs": [
            {
              "id": "1772023740598_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_ASSETIDS_OF_SPECIFIC_ASSET_ASSIGNMENTS.$output.result}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "Inservice Check For Asset Assignments",
            "returnType": "object",
            "sourceCode": "// Inputs\nconst assignment = $context.$nodes.ASSIGNMENTCLASSIFICATION.$output.result\n  ? $context.$nodes.ASSIGNMENTCLASSIFICATION.$output.result\n  : {};\n\nconst responsesRaw = $context.$nodes.CHECK_INSERVICE_ASSETS.$output || [];\n\n// 1) Normalize responses into a flat array of asset rows\nconst assets = [];\nfor (let i = 0; i < (Array.isArray(responsesRaw) ? responsesRaw.length : 0); i++) {\n  let item = responsesRaw[i];\n\n  if (typeof item === \"string\") {\n    const s = item.trim();\n    if (s) {\n      try {\n        item = JSON.parse(s);\n      } catch (e) {\n        item = null;\n      }\n    } else {\n      item = null;\n    }\n  }\n\n  if (!item) continue;\n\n  if (Array.isArray(item)) {\n    for (let j = 0; j < item.length; j++) {\n      const r = item[j];\n      if (r && typeof r === \"object\") assets.push(r);\n    }\n  } else if (typeof item === \"object\") {\n    assets.push(item);\n  }\n}\n\n// 2) Build lookup: projectAssetId -> asset rows\nconst assetsById = new Map();\nfor (let i = 0; i < assets.length; i++) {\n  const r = assets[i];\n  const idVal = r && r.id;\n  const idStr = idVal == null ? \"\" : String(idVal).trim();\n\n  if (!idStr) continue;\n\n  if (!assetsById.has(idStr)) {\n    assetsById.set(idStr, []);\n  }\n\n  assetsById.get(idStr).push(r);\n}\n\n// 3) Extract assignment maps\nconst taskSpec =\n  assignment && typeof assignment.TaskSpecific === \"object\"\n    ? assignment.TaskSpecific\n    : {};\n\nconst topTaskSpec =\n  assignment && typeof assignment.TopTaskSpecific === \"object\"\n    ? assignment.TopTaskSpecific\n    : {};\n\nconst projSpec =\n  assignment && typeof assignment.ProjectSpecific === \"object\"\n    ? assignment.ProjectSpecific\n    : {};\n\n// 4) Build txn → assetIds map\nconst txnToAssetIds = new Map();\n\nconst collectFromMap = (m) => {\n  const keys = Object.keys(m);\n\n  for (let i = 0; i < keys.length; i++) {\n    const txnKey = keys[i];\n    const arr = Array.isArray(m[txnKey]) ? m[txnKey] : [];\n    const txnStr = String(txnKey).trim();\n\n    if (!/^\\d+$/.test(txnStr)) continue;\n\n    const txn = parseInt(txnStr, 10);\n    if (!Number.isFinite(txn)) continue;\n\n    if (!txnToAssetIds.has(txn)) {\n      txnToAssetIds.set(txn, { set: new Set(), list: [] });\n    }\n\n    const bucket = txnToAssetIds.get(txn);\n\n    for (let j = 0; j < arr.length; j++) {\n      const v = arr[j];\n      if (v == null) continue;\n\n      const s = String(v).trim();\n      if (!s) continue;\n\n      if (!bucket.set.has(s)) {\n        bucket.set.add(s);\n        bucket.list.push(s);\n      }\n    }\n  }\n};\n\ncollectFromMap(taskSpec);\ncollectFromMap(topTaskSpec);\ncollectFromMap(projSpec);\n\n// 5) Classify transactions\nconst Transactions_To_Process = [];\nconst Inservice_Asset_Doesnot_Exist = [];\nconst Inservice_Asset_On_Hold = [];\n\nconst seenTTP = new Set();\nconst seenDNE = new Set();\nconst seenOnHold = new Set();\n\nconst txnList = Array.from(txnToAssetIds.keys());\n\nfor (let i = 0; i < txnList.length; i++) {\n  const txn = txnList[i];\n  const idsInfo = txnToAssetIds.get(txn);\n  const idList = idsInfo ? idsInfo.list : [];\n\n  let anyAsBuilt = false;\n  let allAsBuiltHoldY = true;\n\n  for (let j = 0; j < idList.length; j++) {\n    const id = idList[j];\n    const rows = assetsById.get(id) || [];\n\n    for (let k = 0; k < rows.length; k++) {\n      const r = rows[k];\n\n      const typeRaw =\n        r.assetTypeCode == null\n          ? \"\"\n          : String(r.assetTypeCode).trim().toUpperCase();\n\n      const holdRaw =\n        r.capitalHoldFlag == null\n          ? \"\"\n          : String(r.capitalHoldFlag).trim().toUpperCase();\n\n      if (typeRaw === \"AS-BUILT\") {\n        anyAsBuilt = true;\n\n        // If any asset is NOT Y → break \"all Y\"\n        if (holdRaw !== \"Y\") {\n          allAsBuiltHoldY = false;\n        }\n      }\n    }\n  }\n\n  // ?? ALL AS-BUILT are on hold\n  if (anyAsBuilt && allAsBuiltHoldY) {\n    if (!seenOnHold.has(txn)) {\n      seenOnHold.add(txn);\n      Inservice_Asset_On_Hold.push(txn);\n    }\n    continue;\n  }\n\n  // ?? No AS-BUILT assets\n  if (!anyAsBuilt) {\n    if (!seenDNE.has(txn)) {\n      seenDNE.add(txn);\n      Inservice_Asset_Doesnot_Exist.push(txn);\n    }\n    continue;\n  }\n\n  // ?? Everything else → Process (includes [Y, N], [N, N], etc.)\n  if (!seenTTP.has(txn)) {\n    seenTTP.add(txn);\n    Transactions_To_Process.push(txn);\n  }\n}\n\n// 6) Return result\nreturn {\n  Transactions_To_Process,\n  Inservice_Asset_Doesnot_Exist,\n  Inservice_Asset_On_Hold\n};"
          },
          "outcomes": {
            "success": "1773489955209"
          },
          "code": "INSERVICE_CHECK_FOR_ASSET_ASSIGNMENTS",
          "id": "1772025331223",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Update Transaction Summary2",
            "returnType": "object",
            "sourceCode": "// Inputs\nconst currentSummary =\n $context.$variables.PrjPjcVarConvTransactionSummary || {};\n\nconst inserviceResult =$context.$nodes.INSERVICE_CHECK_FOR_ASSET_ASSIGNMENTS.$output.result || {};\n\n// Make a shallow copy of currentSummary so we don't mutate inputs\nconst updated = {};\nconst existingKeys = Object.keys(currentSummary);\nfor (let i = 0; i < existingKeys.length; i++) {\nconst k = existingKeys[i];\nconst v = currentSummary[k];\nupdated[k] = Array.isArray(v) ? v.slice() : v;\n}\n\n// Buckets to merge (only these two)\nconst targets = [\n\"Inservice_Asset_Doesnot_Exist\",\n\"Inservice_Asset_On_Hold\"\n];\n\nfor (let t = 0; t < targets.length; t++) {\nconst bucket = targets[t];\nconst src = Array.isArray(inserviceResult[bucket]) ? inserviceResult[bucket] : [];\nif (src.length === 0) continue;\n\nconst base = Array.isArray(updated[bucket]) ? updated[bucket].slice() : [];\nconst seen = new Set(base.map(x => String(x).trim()).filter(s => s.length > 0));\n\nfor (let i = 0; i < src.length; i++) {\nconst v = src[i];\nif (v === null || v === undefined) continue;\nconst s = String(v).trim();\nif (s.length === 0) continue;\nif (!seen.has(s)) {\nseen.add(s);\n// Keep numeric if purely digits, else keep as string\nif (/^\\d+$/.test(s)) {\nconst n = parseInt(s, 10);\nbase.push(Number.isFinite(n) ? n : s);\n} else {\nbase.push(s);\n}\n}\n}\n\nupdated[bucket] = base;\n}\n\n// Return the merged summary\nreturn updated;"
          },
          "outcomes": {
            "success": "1772131139811"
          },
          "code": "UPDATE_TRANSACTION_SUMMARY2",
          "id": "1772031386877",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Extract No Assignment and Update Summary",
            "returnType": "object",
            "sourceCode": "// Inputs\nconst currentSummary =\n( $context.$variables.PrjPjcVarConvTransactionSummary )\n? $context.$variables.PrjPjcVarConvTransactionSummary\n: {};\n\nconst sourceObj =\n( $context.$nodes.ASSIGNMENTCLASSIFICATION.$output.result)\n? $context.$nodes.ASSIGNMENTCLASSIFICATION.$output.result \n: {};\n\n// Make a shallow copy so we don't mutate currentSummary\nconst updated = {};\nconst keys = Object.keys(currentSummary);\nfor (let i = 0; i < keys.length; i++) {\nconst k = keys[i];\nconst v = currentSummary[k];\nupdated[k] = Array.isArray(v) ? v.slice() : v;\n}\n\n// Extract NoProjectAssignment from source\nconst src = Array.isArray(sourceObj.NoProjectAssignment) ? sourceObj.NoProjectAssignment : [];\nif (src.length > 0) {\nconst base = Array.isArray(updated.NoProjectAssignment) ? updated.NoProjectAssignment.slice() : [];\nconst seen = new Set(base.map(x => String(x).trim()).filter(s => s.length > 0));\n\nfor (let i = 0; i < src.length; i++) {\nconst v = src[i];\nif (v === null || v === undefined) continue;\nconst s = String(v).trim();\nif (s.length === 0) continue;\nif (!seen.has(s)) {\nseen.add(s);\n// Keep numeric if all digits; otherwise keep as string\nif (/^\\d+$/.test(s)) {\nconst n = parseInt(s, 10);\nbase.push(Number.isFinite(n) ? n : s);\n} else {\nbase.push(s);\n}\n}\n}\n\nupdated.NoProjectAssignment = base; // create or update\n}\n\n// Return merged summary\nreturn updated;"
          },
          "outcomes": {
            "success": "1772033862150"
          },
          "code": "EXTRACT_NO_ASSIGNMENT_AND_UPDATE_SUMMARY",
          "id": "1772033694985",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Remove No Assignment Transactions",
            "returnType": "array",
            "sourceCode": "const txRaw = ($context && $context.$variables && Array.isArray($context.$variables.PrjPjcVarConvTransactionsToProcess))\n  ? $context.$variables.PrjPjcVarConvTransactionsToProcess\n  : [];\n\n// Normalize prjPjcVarConvTransactionSummary: could be object, array, stringified JSON, or CSV string\nlet summaryInput = ( $context.$nodes.EXTRACT_NO_ASSIGNMENT_AND_UPDATE_SUMMARY.$output.result != null)\n  ? $context.$nodes.EXTRACT_NO_ASSIGNMENT_AND_UPDATE_SUMMARY.$output.result\n  : {};\n\nlet summary;\n\n// If already an object, use it. If string, try parse JSON; if parse fails, treat as CSV for NoProjectAssignment.\nif (typeof summaryInput === 'object' && !Array.isArray(summaryInput)) {\n  summary = summaryInput;\n} else if (typeof summaryInput === 'string') {\n  let parsed = null;\n  try {\n    parsed = JSON.parse(summaryInput);\n  } catch (e) {\n    parsed = null;\n  }\n  if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {\n    summary = parsed;\n  } else {\n    // Treat string as CSV list for NoProjectAssignment\n    summary = { NoProjectAssignment: summaryInput };\n  }\n} else {\n  summary = {};\n}\n\n// Build npaRaw from summary.NoProjectAssignment supporting array/object/CSV string\nlet npaRaw;\nif (summary && Object.prototype.hasOwnProperty.call(summary, 'NoProjectAssignment')) {\n  const v = summary.NoProjectAssignment;\n  if (Array.isArray(v)) {\n    npaRaw = v;\n  } else if (v == null) {\n    npaRaw = [];\n  } else if (typeof v === 'string') {\n    // Split comma-separated string manually\n    npaRaw = [];\n    const str = v;\n    let start = 0;\n    for (let i = 0; i <= str.length; i++) {\n      if (i === str.length || str.charAt(i) === ',') {\n        let part = str.substring(start, i);\n        // trim manually\n        let l = 0;\n        while (l < part.length && (part.charAt(l) === ' ' || part.charAt(l) === '\\t' || part.charAt(l) === '\\n' || part.charAt(l) === '\\r')) l++;\n        let r = part.length - 1;\n        while (r >= l && (part.charAt(r) === ' ' || part.charAt(r) === '\\t' || part.charAt(r) === '\\n' || part.charAt(r) === '\\r')) r--;\n        if (r >= l) {\n          npaRaw[npaRaw.length] = part.substring(l, r + 1);\n        }\n        start = i + 1;\n      }\n    }\n  } else if (typeof v === 'object') {\n    // Manually collect values\n    npaRaw = [];\n    for (const k in v) {\n      if (Object.prototype.hasOwnProperty.call(v, k)) {\n        npaRaw[npaRaw.length] = v[k];\n      }\n    }\n  } else {\n    npaRaw = [v];\n  }\n} else if (typeof summary === 'string') {\n  // Should not happen because we normalized above, but keep a fallback\n  npaRaw = [summary];\n} else {\n  npaRaw = [];\n}\n\n// Build exclude keys (normalized) without using Set or helpers\nconst excludeKeys = [];\nfor (let i = 0; i < npaRaw.length; i++) {\n  const val = npaRaw[i];\n  if (val == null) continue;\n\n  // to string + trim manually\n  let s = '' + val;\n  let l = 0;\n  while (l < s.length && (s.charAt(l) === ' ' || s.charAt(l) === '\\t' || s.charAt(l) === '\\n' || s.charAt(l) === '\\r')) l++;\n  let r = s.length - 1;\n  while (r >= l && (s.charAt(r) === ' ' || s.charAt(r) === '\\t' || s.charAt(r) === '\\n' || s.charAt(r) === '\\r')) r--;\n  if (r < l) continue;\n  s = s.substring(l, r + 1);\n\n  // integer-like detection\n  let isInt = true;\n  let j = 0;\n  if (s.charAt(0) === '+' || s.charAt(0) === '-') j = 1;\n  if (j === s.length) isInt = false;\n  while (isInt && j < s.length) {\n    const c = s.charCodeAt(j);\n    if (c < 48 || c > 57) isInt = false;\n    j++;\n  }\n\n  let key;\n  if (isInt) {\n    const n = parseInt(s, 10);\n    if (Number.isFinite(n)) key = '' + n; else key = s.toLowerCase();\n  } else {\n    key = s.toLowerCase();\n  }\n\n  let exists = false;\n  for (let k = 0; k < excludeKeys.length; k++) {\n    if (excludeKeys[k] === key) { exists = true; break; }\n  }\n  if (!exists) excludeKeys[excludeKeys.length] = key;\n}\n\n// Process transactions, filter, dedupe\nconst result = [];\nconst seenKeys = [];\n\nfor (let i = 0; i < txRaw.length; i++) {\n  const v = txRaw[i];\n  if (v == null) continue;\n\n  let s = '' + v;\n  // trim manually\n  let l = 0;\n  while (l < s.length && (s.charAt(l) === ' ' || s.charAt(l) === '\\t' || s.charAt(l) === '\\n' || s.charAt(l) === '\\r')) l++;\n  let r = s.length - 1;\n  while (r >= l && (s.charAt(r) === ' ' || s.charAt(r) === '\\t' || s.charAt(r) === '\\n' || s.charAt(r) === '\\r')) r--;\n  if (r < l) continue;\n  const trimmed = s.substring(l, r + 1);\n\n  // integer-like?\n  let isInt = true;\n  let j = 0;\n  if (trimmed.charAt(0) === '+' || trimmed.charAt(0) === '-') j = 1;\n  if (j === trimmed.length) isInt = false;\n  while (isInt && j < trimmed.length) {\n    const c = trimmed.charCodeAt(j);\n    if (c < 48 || c > 57) isInt = false;\n    j++;\n  }\n\n  // normalized key\n  let key;\n  if (isInt) {\n    const n = parseInt(trimmed, 10);\n    if (Number.isFinite(n)) {\n      key = '' + n;\n    } else {\n      key = trimmed.toLowerCase();\n      isInt = false;\n    }\n  } else {\n    key = trimmed.toLowerCase();\n  }\n\n  // exclude check\n  let isExcluded = false;\n  for (let e = 0; e < excludeKeys.length; e++) {\n    if (excludeKeys[e] === key) { isExcluded = true; break; }\n  }\n  if (isExcluded) continue;\n\n  // dedupe\n  let seen = false;\n  for (let d = 0; d < seenKeys.length; d++) {\n    if (seenKeys[d] === key) { seen = true; break; }\n  }\n  if (seen) continue;\n  seenKeys[seenKeys.length] = key;\n\n  // push representation\n  if (isInt) {\n    const n = parseInt(trimmed, 10);\n    if (Number.isFinite(n)) {\n      result[result.length] = n;\n      continue;\n    }\n  }\n  if (typeof v === 'string') {\n    result[result.length] = trimmed;\n  } else {\n    result[result.length] = v;\n  }\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1772033950857"
          },
          "code": "REMOVE_NO_ASSIGNMENT_TRANSACTIONS_",
          "id": "1772033862150",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "update state"
