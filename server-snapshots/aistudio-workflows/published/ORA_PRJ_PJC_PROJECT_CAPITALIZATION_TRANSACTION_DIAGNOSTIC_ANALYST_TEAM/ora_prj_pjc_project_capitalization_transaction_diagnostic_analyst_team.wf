                    "sourceCode": "const input1 = $context.$nodes.GET_ASSET_ASSIGNMENTS.$currentItem ;\nconst input2 = $context.$nodes.GET_ASSET_ASSIGNMENTS.GET_ASSET_ASSIGNMENTS_FOR_PROJECT.$output ;\n\n// Build the result by attaching assetAssignmentsDetails from input2\nconst result = {\ntransactionNumber: input1.transactionNumber,\nassetAssignmentsDetails: input2\n};\nreturn result;"
