                {
                  "metadata": {
                    "name": "Reset Accounting Flag Validation",
                    "returnType": "array",
                    "sourceCode": "const resp1 = $context.$nodes.RESET_ACCOUNTING_CHECK.CHECK_IF_DATA_EXISTS_IN_ASSETLINE_DETAILS.$output ;\nconst resp2 = $context.$nodes.RESET_ACCOUNTING_CHECK.CHECK_IF_DATA_EXISTS_IN_BORROWEDANDLENTDISTRIBUTION.$output ;\n\n// Normalize inputs to a single list of candidate arrays\nconst inputs = [];\nif (Array.isArray(resp1)) inputs.push(resp1);\nif (Array.isArray(resp2)) inputs.push(resp2);\n\n// Helper state for output and dedupe (no functions used)\nconst out = [];\nconst seen = new Set();\n\nfor (let a = 0; a < inputs.length; a++) {\nconst top = inputs[a];\n\nfor (let i = 0; i < top.length; i++) {\nconst item = top[i];\n\n// Case 1: item is an object (potentially has transactionNumber)\nif (item && typeof item === \"object\" && !Array.isArray(item)) {\nconst v = item.transactionNumber != null ? item.transactionNumber : item.transactionId;\nif (v !== null && v !== undefined) {\nconst s = String(v).trim();\nif (s.length > 0) {\nconst k = s;\nif (!seen.has(k)) {\nseen.add(k);\nout.push(/^\\d+$/.test(s) ? parseInt(s, 10) : s);\n}\n}\n}\ncontinue;\n}\n\n// Case 2: item is an array (array of objects)\nif (Array.isArray(item)) {\nfor (let j = 0; j < item.length; j++) {\nconst obj = item[j];\nif (obj && typeof obj === \"object\" && !Array.isArray(obj)) {\nconst v = obj.transactionNumber != null ? obj.transactionNumber : obj.transactionId;\nif (v !== null && v !== undefined) {\nconst s = String(v).trim();\nif (s.length > 0) {\nconst k = s;\nif (!seen.has(k)) {\nseen.add(k);\nout.push(/^\\d+$/.test(s) ? parseInt(s, 10) : s);\n}\n}\n}\n}\n}\ncontinue;\n}\n\n// Other shapes are ignored\n}\n}\n\nreturn out;"
                  },
