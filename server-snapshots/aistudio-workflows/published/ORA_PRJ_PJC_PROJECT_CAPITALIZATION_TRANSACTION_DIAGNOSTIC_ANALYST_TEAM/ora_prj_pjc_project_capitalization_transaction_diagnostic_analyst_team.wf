          "code": "PROJECTCOSTACCOUNTINGDISTRIBUTION",
          "id": "1772170884305",
          "inputs": [
            {
              "id": "1772170884306_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_PROJECT_ACCOUNTING.$output.result}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "Accounting Check",
            "returnType": "object",
            "sourceCode": "const groupedResult = $context.$nodes.GROUP_BY_ACCOUNTING_STATUS_CODE?.$output?.result || {};\nconst respRaw = $context.$nodes.PROJECTCOSTACCOUNTINGDISTRIBUTION?.$output || [];\nconst mergedDetails = $context.$variables.prjPjcVarConvTransactionDetails || [];\n\n// -------- 1) Read Projects group safely --------\nlet projectsGroup = [];\n\nif (groupedResult && typeof groupedResult === \"object\" && Array.isArray(groupedResult.Projects)) {\n  projectsGroup = groupedResult.Projects;\n} else if (groupedResult && typeof groupedResult.Projects === \"string\") {\n  try {\n    const parsed = JSON.parse(groupedResult.Projects);\n    if (Array.isArray(parsed)) {\n      projectsGroup = parsed;\n    }\n  } catch (e) {\n    projectsGroup = [];\n  }\n}\n\n// Extract transaction numbers (supports numbers, strings, objects)\nconst txnList = [];\nconst seenTxn = new Set();\n\nfor (let i = 0; i < projectsGroup.length; i++) {\n  const entry = projectsGroup[i];\n\n  const rawValue =\n    entry && typeof entry === \"object\"\n      ? entry.transactionNumber\n      : entry;\n\n  if (rawValue == null) continue;\n\n  const s = String(rawValue).trim();\n  if (!/^\\d+$/.test(s)) continue;\n\n  const n = parseInt(s, 10);\n  if (!Number.isFinite(n) || seenTxn.has(n)) continue;\n\n  seenTxn.add(n);\n  txnList.push(n);\n}\n\n// -------- 2) Build txn -> adjustmentAccountingFlag --------\nconst adjustmentByTxn = new Map();\n\n// -------- 3) Build txn -> highest line from transaction details --------\nconst highestLineByTxn = new Map();\n\nfor (let i = 0; i < (Array.isArray(mergedDetails) ? mergedDetails.length : 0); i++) {\n  const row = mergedDetails[i];\n  if (!row || typeof row !== \"object\") continue;\n\n  const txnVal =\n    row.transactionNumber != null\n      ? row.transactionNumber\n      : (row.details && row.details.transactionNumber != null\n          ? row.details.transactionNumber\n          : null);\n\n  const tStr = txnVal == null ? \"\" : String(txnVal).trim();\n  if (!/^\\d+$/.test(tStr)) continue;\n\n  const tNum = parseInt(tStr, 10);\n  if (!Number.isFinite(tNum)) continue;\n\n  // adjustment flag\n  const adjRaw =\n    row.adjustmentAccountingFlag != null\n      ? row.adjustmentAccountingFlag\n      : (row.details && row.details.adjustmentAccountingFlag != null\n          ? row.details.adjustmentAccountingFlag\n          : null);\n\n  if (!adjustmentByTxn.has(tNum) && adjRaw != null) {\n    adjustmentByTxn.set(tNum, adjRaw);\n  }\n\n  // highest line\n  const dist = Array.isArray(row.distributionDetails) ? row.distributionDetails : [];\n\n  for (let j = 0; j < dist.length; j++) {\n    const d = dist[j];\n    if (!d || typeof d !== \"object\") continue;\n\n    const lineVal = d.lineNumber;\n    const lineStr = lineVal == null ? \"\" : String(lineVal).trim();\n    if (!/^\\d+$/.test(lineStr)) continue;\n\n    const lineNum = parseInt(lineStr, 10);\n    if (!Number.isFinite(lineNum)) continue;\n\n    const existing = highestLineByTxn.get(tNum);\n    if (existing == null || lineNum > existing) {\n      highestLineByTxn.set(tNum, lineNum);\n    }\n  }\n}\n\n// -------- 4) Flatten/normalize response --------\nconst respRows = [];\nconst stack = [];\n\nif (Array.isArray(respRaw)) {\n  for (let i = 0; i < respRaw.length; i++) stack.push(respRaw[i]);\n} else if (respRaw != null) {\n  stack.push(respRaw);\n}\n\nwhile (stack.length > 0) {\n  let item = stack.pop();\n  if (item == null) continue;\n\n  if (typeof item === \"string\") {\n    const s = item.trim();\n    if (!s) continue;\n    try {\n      item = JSON.parse(s);\n    } catch {\n      continue;\n    }\n  }\n\n  if (Array.isArray(item)) {\n    for (let i = item.length - 1; i >= 0; i--) stack.push(item[i]);\n    continue;\n  }\n\n  if (typeof item === \"object\") {\n    const tVal = item.transactionNumber != null ? item.transactionNumber : item.costTransactionNumber;\n    const lVal = item.lineNumber != null ? item.lineNumber : item.costLineNumber;\n    const st = item.eventStatusCode == null ? \"\" : String(item.eventStatusCode).trim().toUpperCase();\n\n    const tStr = tVal == null ? \"\" : String(tVal).trim();\n    if (!/^\\d+$/.test(tStr)) continue;\n\n    const tNum = parseInt(tStr, 10);\n    if (!Number.isFinite(tNum)) continue;\n\n    const lineKey = lVal == null ? \"\" : String(lVal).trim();\n    respRows.push({ txn: tNum, lineKey, status: st });\n  }\n}\n\n// -------- 5) Build txn -> line -> status --------\nconst statusByTxnLine = new Map();\n\nfor (let i = 0; i < respRows.length; i++) {\n  const { txn, lineKey, status } = respRows[i];\n  if (!statusByTxnLine.has(txn)) statusByTxnLine.set(txn, new Map());\n  statusByTxnLine.get(txn).set(lineKey, status);\n}\n\n// -------- 6) FINAL CLASSIFICATION --------\nconst Accounting_Not_Run = [];\nconst Accounting_Errors = [];\nconst Catch_All = [];\n\nfor (let i = 0; i < txnList.length; i++) {\n  const txn = txnList[i];\n  const lineStatusMap = statusByTxnLine.get(txn);\n\n  // Not present at all\n  if (!lineStatusMap || lineStatusMap.size === 0) {\n    Accounting_Not_Run.push(txn);\n    continue;\n  }\n\n  const adjRaw = adjustmentByTxn.get(txn);\n  const adj = adjRaw == null ? \"\" : String(adjRaw).trim().toLowerCase();\n  const isAdjustment = (adj === \"y\" || adj === \"true\");\n\n  if (isAdjustment) {\n    // ---- Y logic ----\n    const highestLine = highestLineByTxn.get(txn);\n\n    if (highestLine == null) {\n      Accounting_Not_Run.push(txn);\n      continue;\n    }\n\n    const selectedStatus = lineStatusMap.get(String(highestLine));\n\n    if (selectedStatus == null) {\n      Accounting_Not_Run.push(txn);\n      continue;\n    }\n\n    if (selectedStatus === \"P\") {\n      Catch_All.push(txn);\n    } else {\n      Accounting_Not_Run.push(txn);\n    }\n\n  } else {\n    // ---- N logic ----\n    const selectedStatus = lineStatusMap.get(\"1\");\n\n    if (selectedStatus == null) {\n      Accounting_Not_Run.push(txn);\n      continue;\n    }\n\n    if (selectedStatus === \"P\") {\n      Catch_All.push(txn);\n    } else {\n      Accounting_Not_Run.push(txn);\n    }\n  }\n}\n\nreturn {\n  Accounting_Not_Run,\n  Accounting_Errors,\n  Catch_All\n};"
          },
          "outcomes": {
            "success": "1773411886366"
          },
          "code": "ACCOUNTING_CHECK",
          "id": "1772171785684",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Adjustment Check",
            "returnType": "object",
            "sourceCode": "const rawUpdated = $context.$nodes.EXTRACT_TRANSACTIONS_FOR_ADJUSTMENTS_CHECK.$output.result \nconst merged = $context?.$variables?.prjPjcVarConvTransactionDetails || [];\n\n// Normalize updatedProjects to an array of numeric transaction IDs\nconst updatedProjects = [];\nfor (const e of (Array.isArray(rawUpdated) ? rawUpdated : [])) {\nif (e && typeof e === \"object\" && e.transactionNumber != null) {\nconst s = String(e.transactionNumber).trim();\nif (/^\\d+/.test(s)) updatedProjects.push(parseInt(s, 10));\n} else if (e != null) {\nconst s = String(e).trim();\nif (/^\\d+/.test(s)) updatedProjects.push(parseInt(s, 10));\n}\n}\n\n// Build a lookup: txn -> { rowLevelFlags: { transferredFromTransactionNumber, adjustingTransactionNumber }, distributions: [...] }\nconst byTxn = new Map();\nfor (const row of (Array.isArray(merged) ? merged : [])) {\nif (!row || typeof row !== \"object\") continue;\n\nconst tStr = String(row.transactionNumber ?? row.details?.transactionNumber ?? \"\").trim();\nif (!/^\\d+$/.test(tStr)) continue;\nconst txn = parseInt(tStr, 10);\n\nconst dists = Array.isArray(row.distributions)\n? row.distributions\n: (Array.isArray(row.distributionDetails) ? row.distributionDetails : []);\n\n// Transaction-level flags\nconst transferred = row.transferredFromTransactionNumber ?? row.details?.transferredFromTransactionNumber ?? null;\nconst adjusting = row.adjustingTransactionNumber ?? row.details?.adjustingTransactionNumber ?? null;\n\nbyTxn.set(txn, {\ntransferredFromTransactionNumber: transferred,\nadjustingTransactionNumber: adjusting,\ndistributions: dists.filter(d => d && typeof d === \"object\")\n});\n}\n\n// Classify according to your rules\nconst adjustmentCdl = [];\nconst newCdl = [];\nconst seenAdj = new Set();\nconst seenNew = new Set();\n\nfor (const txn of updatedProjects) {\nif (!Number.isFinite(txn)) continue;\n\nconst rec = byTxn.get(txn) || { distributions: [], transferredFromTransactionNumber: null, adjustingTransactionNumber: null };\nconst dists = rec.distributions || [];\nconst distCount = dists.length;\n\nlet isAdjustment = false;\n\nif (distCount > 1) {\n// Rule: more than one distribution record => adjustment\nisAdjustment = true;\n} else if (distCount === 1) {\nconst d = dists[0];\nconst lineIsOne = String(d.lineNumber ?? d.costLineNumber ?? \"\").trim() === \"1\";\nif (lineIsOne) {\n// Rule: one record, lineNumber=1, check transaction-level flags\nif (rec.transferredFromTransactionNumber != null || rec.adjustingTransactionNumber != null) {\nisAdjustment = true;\n} else {\nisAdjustment = false; // newCdl\n}\n} else {\n// One record but lineNumber !== 1 => newCdl\nisAdjustment = false;\n}\n} else {\n// No distributions found => newCdl (per \"Otherwise\")\nisAdjustment = false;\n}\n\nif (isAdjustment) {\n    if (!seenAdj.has(txn)) { \n      seenAdj.add(txn); \n      adjustmentCdl.push(txn); \n    }\n  } else {\n    if (!seenNew.has(txn)) { \n      seenNew.add(txn); \n      newCdl.push(txn); \n    }\n  }\n}\n\nconst result={ adjustmentCdl, newCdl };\nreturn result;"
          },
          "outcomes": {
            "success": "1772172924211"
          },
          "code": "ADJUSTMENT_CHECK",
          "id": "1772172665427",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Update Final Summary",
            "returnType": "object",
            "sourceCode": "const currentSummary = $context.$variables.PrjPjcVarConvTransactionSummary || {};\n\n// Output from previous classification\nconst newResult =\n  ( $context.$nodes.ACCOUNTING_CHECK.$output.result ) || {};\n\n// Grouped accounting status\nconst groupedResult =\n  ($context.$nodes.GROUP_BY_ACCOUNTING_STATUS_CODE?.$output?.result) || {};\n\n// Helper to merge arrays with dedupe\nconst mergeArrays = (existing, incoming) => {\n  const out = [];\n  const seen = new Set();\n\n  const add = (val) => {\n    const raw =\n      val && typeof val === \"object\"\n        ? val.transactionNumber ?? val.txnId ?? val.id\n        : val;\n\n    if (raw == null) return;\n\n    const s = String(raw).trim();\n    if (!s || seen.has(s)) return;\n\n    seen.add(s);\n\n    if (/^\\d+$/.test(s)) {\n      const n = parseInt(s, 10);\n      out.push(Number.isFinite(n) ? n : s);\n    } else {\n      out.push(s);\n    }\n  };\n\n  if (Array.isArray(existing)) {\n    for (let i = 0; i < existing.length; i++) add(existing[i]);\n  }\n\n  if (Array.isArray(incoming)) {\n    for (let i = 0; i < incoming.length; i++) add(incoming[i]);\n  }\n\n  return out;\n};\n\n// Final output\nconst updated = { ...currentSummary };\n\n// ==============================\n// 1) Merge classification output\n// ==============================\nconst groups = [\"Accounting_Not_Run\", \"Accounting_Errors\", \"Catch_All\"];\n\nfor (let i = 0; i < groups.length; i++) {\n  const key = groups[i];\n\n  const incoming = Array.isArray(newResult[key]) ? newResult[key] : [];\n\n  if (incoming.length > 0) {\n    updated[key] = mergeArrays(currentSummary[key], incoming);\n  }\n}\n\n// ==============================\n// 2) Add all NON-Projects groups → Catch_All\n// ==============================\nlet extraCatchAll = [];\n\nif (groupedResult && typeof groupedResult === \"object\") {\n  const keys = Object.keys(groupedResult);\n\n  for (let i = 0; i < keys.length; i++) {\n    const key = keys[i];\n\n    // Skip Projects group\n    if (key === \"Projects\") continue;\n\n    const arr = Array.isArray(groupedResult[key]) ? groupedResult[key] : [];\n\n    for (let j = 0; j < arr.length; j++) {\n      extraCatchAll.push(arr[j]);\n    }\n  }\n}\n\n// Merge into Catch_All if anything exists\nif (extraCatchAll.length > 0) {\n  updated[\"Catch_All\"] = mergeArrays(updated[\"Catch_All\"], extraCatchAll);\n}\n\nreturn updated;"
          },
