                {
                  "metadata": {
                    "name": "Prepare Payload For Fetching Transaction Distribution Details",
                    "returnType": "object",
                    "sourceCode": "const transactionNumbers = $context.$nodes.GET_TRANSACTION_AND_DISTRIBUTION_DETAILS_IN_BATCH.$currentItem ;\n\nconst payload ={\n    \"viewQueries\": {\n        \"projectCostTransaction\": {\n            \"module\": \"oraErpCoreProjectCostTransactions\",\n            \"businessObject\": \"ProjectCostTransactionDistribution\",\n            \"view\": \"projectCostTransactionDistributionDetails\",\n            \"fieldAliases\": {\n                \"transactionNumber\": \"transactionNumber\",\n                \"capitalizable.lookupCode\": \"distributionCapitalizableFlag\",\n                \"projectCostTransaction.capitalizable.lookupCode\": \"transactionCapitalizableFlag\",\n                \"lineNumber\" : \"lineNumber\",\n                \"rawCostInReceiverLedgerCurrency\": \"rawCostInReceiverLedgerCurrency\",\n               \"rawCostJournalSource\":\"rawCostJournalSource\",\n               \"burdenedCostJournalSource\": \"burdenedCostJournalSource\"\n            }\n        }\n    },\n    \"select\": ` SELECT transactionNumber,lineNumber, distributionCapitalizableFlag, transactionCapitalizableFlag, rawCostInReceiverLedgerCurrency,rawCostJournalSource,burdenedCostJournalSource FROM projectCostTransaction WHERE transactionNumber IN ${transactionNumbers} `,\n    \"return\": [\n        {\n            \"name\": \"transactionNumber\",\n            \"type\": \"int64\"\n        },\n        {\n            \"name\": \"lineNumber\",\n            \"type\": \"int64\"\n        },\n        {\n            \"name\": \"distributionCapitalizableFlag\",\n            \"type\": \"string\"\n        },\n        {\n            \"name\": \"transactionCapitalizableFlag\",\n            \"type\": \"string\"\n        },\n        {\n            \"name\": \"rawCostInReceiverLedgerCurrency\",\n            \"type\": \"string\"\n        },\n       {\n       \"name\":\"rawCostJournalSource\",\n      \"type\":\"string\"\n       },\n       {\n        \"name\":\"burdenedCostJournalSource\",\n         \"type\":\"string\"\n       }\n    ]\n};\n\n\nreturn payload;"
                  },
                  "outcomes": {
                    "success": "1774011152014"
                  },
                  "code": "PREPARE_PAYLOAD_FOR_FETCHING_TRANSACTION_DISTRIBUTION_DETAILS",
                  "id": "1774010042409",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
