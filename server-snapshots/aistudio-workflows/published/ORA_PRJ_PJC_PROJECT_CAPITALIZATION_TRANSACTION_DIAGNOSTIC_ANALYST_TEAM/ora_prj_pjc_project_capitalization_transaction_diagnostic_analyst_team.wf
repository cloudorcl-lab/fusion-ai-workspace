            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Update Transactions to Process2",
            "returnType": "array",
            "sourceCode": "const rawTxns = $context.$variables.PrjPjcVarConvTransactionsToProcess;\n\nlet existing;\nif (Array.isArray(rawTxns)) {\n  existing = rawTxns;\n} else if (typeof rawTxns === \"number\") {\n  existing = [rawTxns];\n} else if (typeof rawTxns === \"string\") {\n  const s = rawTxns.trim();\n  existing = s.includes(\",\")\n    ? s.split(\",\").map(x => x.trim()).filter(x => x.length > 0)\n    : s.length > 0\n    ? [s]\n    : [];\n} else if (rawTxns == null) {\n  existing = [];\n} else {\n  existing = [];\n}\n\nconst summary = $context.$nodes.INSERVICE_CHECK_FOR_ASSET_ASSIGNMENTS.$output.result || {};\n\nconst summaryTx = Array.isArray(summary.Transactions_To_Process)\n  ? summary.Transactions_To_Process\n  : [];\n\nconst doesNotExist = Array.isArray(summary.Inservice_Asset_Doesnot_Exist)\n  ? summary.Inservice_Asset_Doesnot_Exist\n  : [];\n\nconst onHold = Array.isArray(summary.Inservice_Asset_On_Hold)\n  ? summary.Inservice_Asset_On_Hold\n  : [];\n\n// Build exclusion set from summary buckets that should be removed\nconst excluded = new Set(\n  doesNotExist\n    .concat(onHold)\n    .map(x => String(x).trim())\n    .filter(s => s.length > 0)\n);\n\n// Start with existing transactions, but:\n// 1. remove excluded ones\n// 2. remove duplicates\nconst result = [];\nconst seen = new Set();\n\nfor (let i = 0; i < existing.length; i++) {\n  const v = existing[i];\n  if (v === null || v === undefined) continue;\n\n  const s = String(v).trim();\n  if (s.length === 0) continue;\n  if (excluded.has(s)) continue;\n  if (seen.has(s)) continue;\n\n  seen.add(s);\n\n  if (/^\\d+$/.test(s)) {\n    const n = parseInt(s, 10);\n    result.push(Number.isFinite(n) ? n : v);\n  } else {\n    result.push(v);\n  }\n}\n\n// Add summary.Transactions_To_Process, skipping:\n// 1. excluded ones\n// 2. duplicates already in result\nfor (let i = 0; i < summaryTx.length; i++) {\n  const v = summaryTx[i];\n  if (v === null || v === undefined) continue;\n\n  const s = String(v).trim();\n  if (s.length === 0) continue;\n  if (excluded.has(s)) continue;\n  if (seen.has(s)) continue;\n\n  seen.add(s);\n\n  if (/^\\d+$/.test(s)) {\n    const n = parseInt(s, 10);\n    result.push(Number.isFinite(n) ? n : v);\n  } else {\n    result.push(v);\n  }\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1772131229231"
          },
          "code": "UPDATE_TRANSACTIONS_TO_PROCESS2",
          "id": "1772131139811",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "update state2"
