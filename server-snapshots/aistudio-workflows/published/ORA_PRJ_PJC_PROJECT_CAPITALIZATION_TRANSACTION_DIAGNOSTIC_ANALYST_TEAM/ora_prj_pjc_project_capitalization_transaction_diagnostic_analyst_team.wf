        },
        {
          "metadata": {
            "name": "Inservice Assets Check",
            "returnType": "object",
            "sourceCode": "// Direct input array of transaction numbers\nconst inserviceTransactions = $context.$nodes.TRANSACTIONS_FOR_INSERVICE_ASSETS_CHECK.$output.result || [] ; // replace with your array input\n\n// Inputs\nconst response = $context?.$nodes?.INSERVICE_ASSETS?.$output || [];\nconst mergedDetails = $context?.$nodes?.FORMAT_TRANSACTION_AND_DISTRBUTION_DETAILS?.$output?.result || [];\n\n// Normalize a list of transaction ids (strings/numbers) to unique integers, preserve order\nconst normalizeTxnList = (arr) => {\n  const out = [];\n  const seen = new Set();\n  const src = Array.isArray(arr) ? arr : [arr];\n\n  for (let i = 0; i < src.length; i++) {\n    const v = src[i];\n    if (v == null) continue;\n    const s = String(v).trim();\n    if (!/^\\d+$/.test(s)) continue;\n    const n = parseInt(s, 10);\n    if (Number.isFinite(n) && !seen.has(n)) {\n      seen.add(n);\n      out.push(n);\n    }\n  }\n\n  return out;\n};\n\nconst insTxns = normalizeTxnList(inserviceTransactions);\n\n// 1) Build txn -> projectId map from mergedDetails (support flat or nested)\nconst txnToProject = new Map();\nfor (let i = 0; i < (Array.isArray(mergedDetails) ? mergedDetails.length : 0); i++) {\n  const row = mergedDetails[i];\n  if (!row) continue;\n\n  const txnVal = row.transactionNumber != null\n    ? row.transactionNumber\n    : (row.details && row.details.transactionNumber != null ? row.details.transactionNumber : null);\n\n  const projVal = row.projectId != null\n    ? row.projectId\n    : (row.details && row.details.projectId != null ? row.details.projectId : null);\n\n  const tStr = txnVal == null ? \"\" : String(txnVal).trim();\n  const pStr = projVal == null ? \"\" : String(projVal).trim();\n  if (!/^\\d+$/.test(tStr) || !pStr) continue;\n\n  const tNum = parseInt(tStr, 10);\n  if (!Number.isFinite(tNum)) continue;\n\n  txnToProject.set(tNum, pStr);\n}\n\n// 2) Parse/flatten response into projectId -> [assetRows]\nconst byProject = new Map();\nfor (let i = 0; i < (Array.isArray(response) ? response.length : 0); i++) {\n  let item = response[i];\n\n  if (typeof item === \"string\") {\n    const s = item.trim();\n    if (!s) continue;\n    try {\n      item = JSON.parse(s);\n    } catch (e) {\n      item = null;\n    }\n  }\n\n  if (!item) continue;\n\n  if (Array.isArray(item)) {\n    for (let j = 0; j < item.length; j++) {\n      const r = item[j];\n      if (!r || typeof r !== \"object\") continue;\n      const p = r.projectId == null ? \"\" : String(r.projectId).trim();\n      if (!p) continue;\n      if (!byProject.has(p)) byProject.set(p, []);\n      byProject.get(p).push(r);\n    }\n  } else if (typeof item === \"object\") {\n    const p = item.projectId == null ? \"\" : String(item.projectId).trim();\n    if (!p) continue;\n    if (!byProject.has(p)) byProject.set(p, []);\n    byProject.get(p).push(item);\n  }\n}\n\n// 3) Classify per transaction (project-scoped evaluation)\nconst Inservice_Asset_Doesnot_Exist = [];\nconst Inservice_Asset_On_Hold = [];\nconst Transactions_To_Process = [];\n\nconst seenAdds = {\n  Inservice_Asset_Doesnot_Exist: new Set(),\n  Inservice_Asset_On_Hold: new Set(),\n  Transactions_To_Process: new Set()\n};\n\nfor (let i = 0; i < insTxns.length; i++) {\n  const txn = insTxns[i];\n  const projId = txnToProject.get(txn) || \"\";\n  const rows = projId ? (byProject.get(projId) || []) : [];\n\n  let asBuiltCount = 0;\n  let allAsBuiltHoldY = true;\n\n  for (let j = 0; j < rows.length; j++) {\n    const r = rows[j];\n    const typeRaw = r.assetTypeCode == null ? \"\" : String(r.assetTypeCode).trim();\n    const typeUp = typeRaw.toUpperCase();\n\n    if (typeUp === \"AS-BUILT\") {\n      asBuiltCount++;\n      const holdRaw = (r.capitalHoldFlag == null ? \"\" : String(r.capitalHoldFlag)).trim().toUpperCase();\n      if (holdRaw !== \"Y\") {\n        allAsBuiltHoldY = false;\n      }\n    }\n  }\n\n  if (asBuiltCount === 0) {\n    if (!seenAdds.Inservice_Asset_Doesnot_Exist.has(txn)) {\n      seenAdds.Inservice_Asset_Doesnot_Exist.add(txn);\n      Inservice_Asset_Doesnot_Exist.push(txn);\n    }\n    continue;\n  }\n\n  if (allAsBuiltHoldY) {\n    if (!seenAdds.Inservice_Asset_On_Hold.has(txn)) {\n      seenAdds.Inservice_Asset_On_Hold.add(txn);\n      Inservice_Asset_On_Hold.push(txn);\n    }\n  } else {\n    if (!seenAdds.Transactions_To_Process.has(txn)) {\n      seenAdds.Transactions_To_Process.add(txn);\n      Transactions_To_Process.push(txn);\n    }\n  }\n}\n\nreturn {\n  Inservice_Asset_Doesnot_Exist,\n  Inservice_Asset_On_Hold,\n  Transactions_To_Process\n};"
          },
          "outcomes": {
            "success": "1773489616713"
          },
          "code": "INSERVICE_ASSETS_CHECK",
          "id": "1771937693941",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Update Transaction Summary With Inservice Check",
            "returnType": "object",
            "sourceCode": "// Inputs\nconst existingSummary =( $context.$variables.PrjPjcVarConvTransactionSummary )? $context.$variables.PrjPjcVarConvTransactionSummary : {};\n\nconst newBuckets =( $context.$nodes.INSERVICE_ASSETS_CHECK.$output.result )? $context.$nodes.INSERVICE_ASSETS_CHECK.$output.result  : {};\n\n// Make a shallow copy of existingSummary so we don't mutate inputs\nconst updated = {};\nconst existingKeys = Object.keys(existingSummary);\nfor (let i = 0; i < existingKeys.length; i++) {\nconst k = existingKeys[i];\nconst v = existingSummary[k];\nupdated[k] = Array.isArray(v) ? v.slice() : v;\n}\n\n// Buckets to merge (Transactions_To_Process is intentionally excluded)\nconst targetBucketNames = [\n\"Inservice_Asset_Doesnot_Exist\",\n\"Inservice_Asset_On_Hold\",\n\"Inservice_Asset_Not_On_Hold\"\n];\n\nfor (let b = 0; b < targetBucketNames.length; b++) {\nconst name = targetBucketNames[b];\nconst src = Array.isArray(newBuckets[name]) ? newBuckets[name] : [];\nif (src.length === 0) continue;\n\n// Start from existing bucket contents (if any), then dedupe while adding new ones\nconst base = Array.isArray(updated[name]) ? updated[name].slice() : [];\nconst seen = new Set(base.map(x => String(x)));\n\nfor (let i = 0; i < src.length; i++) {\nconst v = src[i];\nif (v === null || v === undefined) continue;\nconst s = String(v).trim();\nif (s.length === 0) continue;\nif (!seen.has(s)) {\nseen.add(s);\n// Maintain original type (number if numeric, else string)\nif (/^\\d+$/.test(s)) {\nconst n = parseInt(s, 10);\nupdated[name] = updated[name] || base;\nbase.push(Number.isFinite(n) ? n : s);\n} else {\nupdated[name] = updated[name] || base;\nbase.push(s);\n}\n}\n}\n\nupdated[name] = base;\n}\n\n// Return the merged summary\nreturn updated;"
          },
          "outcomes": {
            "success": "1771937902352"
          },
          "code": "UPDATE_TRANSACTION_SUMMARY_WITH_INSERVICE_CHECK",
          "id": "1771937823231",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Update Transactions To Process From Inservice",
            "returnType": "array",
            "sourceCode": "// Inputs\nconst existingTransactionsRaw =\n  $context.$variables.PrjPjcVarConvTransactionsToProcess;\n\nconst newObjRaw =\n  $context.$nodes.INSERVICE_ASSETS_CHECK?.$output?.result || {};\n\nconst parseMaybeJson = (value) => {\n  if (typeof value === \"string\") {\n    const s = value.trim();\n    if (!s) return null;\n    try {\n      return JSON.parse(s);\n    } catch (e) {\n      return value;\n    }\n  }\n  return value;\n};\n\nconst toArray = (value) => {\n  const parsed = parseMaybeJson(value);\n  if (Array.isArray(parsed)) return parsed;\n  return [];\n};\n\nconst toObject = (value) => {\n  const parsed = parseMaybeJson(value);\n  if (parsed && typeof parsed === \"object\" && !Array.isArray(parsed)) return parsed;\n  return {};\n};\n\nconst existingTransactions = toArray(existingTransactionsRaw);\nconst newObj = toObject(newObjRaw);\n\nconst ttp = toArray(newObj.Transactions_To_Process);\nconst doesNotExist = toArray(newObj.Inservice_Asset_Doesnot_Exist);\nconst onHold = toArray(newObj.Inservice_Asset_On_Hold);\n\n// Normalize values to strings for comparison\nconst removeSet = new Set(\n  [...doesNotExist, ...onHold]\n    .filter(v => v !== null && v !== undefined)\n    .map(v => String(v).trim())\n);\n\n// Normalize to strings to dedupe, but keep numeric where possible\nconst out = [];\nconst seen = new Set();\n\n// 1) Seed with existingTransactions, excluding removed ones\nfor (let i = 0; i < existingTransactions.length; i++) {\n  const v = existingTransactions[i];\n  if (v === null || v === undefined) continue;\n\n  const s = String(v).trim();\n  if (s.length === 0) continue;\n\n  if (removeSet.has(s)) continue;\n\n  if (!seen.has(s)) {\n    seen.add(s);\n    out.push(/^\\d+$/.test(s) ? parseInt(s, 10) : v);\n  }\n}\n\n// 2) Append Transactions_To_Process from newObj\nfor (let i = 0; i < ttp.length; i++) {\n  const v = ttp[i];\n  if (v === null || v === undefined) continue;\n\n  const s = String(v).trim();\n  if (s.length === 0) continue;\n\n  if (!seen.has(s)) {\n    seen.add(s);\n    out.push(/^\\d+$/.test(s) ? parseInt(s, 10) : v);\n  }\n}\n\nreturn out;"
          },
          "outcomes": {
            "success": "1771938055009"
          },
