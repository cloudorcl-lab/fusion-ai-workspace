        {
          "metadata": {
            "name": "Update Transaction Details with Asset Details",
            "returnType": "array",
            "sourceCode": "const assignment = ($context?.$nodes?.ASSIGNMENTCLASSIFICATION?.$output?.result)\n? ($context?.$nodes?.ASSIGNMENTCLASSIFICATION?.$output?.result)\n: {};\n\nconst responsesRaw = $context?.$nodes?.CHECK_INSERVICE_ASSETS?.$output || [];\n\nconst mergedDetailsInput = $context?.$nodes?.FORMAT_TRANSACTION_AND_DISTRBUTION_DETAILS?.$output?.result || [];\n\n// 1) Normalize responses into a flat array of asset rows\nconst assets = [];\nfor (let i = 0; i < (Array.isArray(responsesRaw) ? responsesRaw.length : 0); i++) {\nlet item = responsesRaw[i];\nif (typeof item === \"string\") {\nconst s = item.trim();\nif (s) {\ntry { item = JSON.parse(s); } catch (e) { item = null; }\n} else {\nitem = null;\n}\n}\nif (!item) continue;\n\nif (Array.isArray(item)) {\nfor (let j = 0; j < item.length; j++) {\nconst r = item[j];\nif (r && typeof r === \"object\") assets.push(r);\n}\n} else if (typeof item === \"object\") {\nassets.push(item);\n}\n}\n\n// 2) Build lookup: projectAssetId (string) -> array of asset rows (use r.id)\nconst assetsById = new Map();\nfor (let i = 0; i < assets.length; i++) {\nconst r = assets[i];\nconst idVal = r && r.id;\nconst idStr = idVal == null ? \"\" : String(idVal).trim();\nif (!idStr) continue;\nif (!assetsById.has(idStr)) assetsById.set(idStr, []);\nassetsById.get(idStr).push(r);\n}\n\n// 3) Gather the three “Specific” maps (may be missing)\nconst taskSpec = (assignment && typeof assignment.TaskSpecific === \"object\") ? assignment.TaskSpecific : {};\nconst topTaskSpec = (assignment && typeof assignment.TopTaskSpecific === \"object\") ? assignment.TopTaskSpecific : {};\nconst projSpec = (assignment && typeof assignment.ProjectSpecific === \"object\") ? assignment.ProjectSpecific : {};\n\n// 4) For each txn across all three maps, collect unique assetIds (strings)\nconst txnToAssetIds = new Map();\n\nfunction collectFromMapInline(m) {\nconst keys = Object.keys(m || {});\nfor (let i = 0; i < keys.length; i++) {\nconst txnKey = keys[i];\nconst arr = Array.isArray(m[txnKey]) ? m[txnKey] : [];\nconst txnStr = String(txnKey).trim();\nif (!/^\\d+$/.test(txnStr)) continue;\nconst txn = parseInt(txnStr, 10);\nif (!Number.isFinite(txn)) continue;\n\nif (!txnToAssetIds.has(txn)) txnToAssetIds.set(txn, { set: new Set(), list: [] });\nconst bucket = txnToAssetIds.get(txn);\n\nfor (let j = 0; j < arr.length; j++) {\nconst v = arr[j];\nif (v == null) continue;\nconst s = String(v).trim();\nif (!s) continue;\nif (!bucket.set.has(s)) {\nbucket.set.add(s);\nbucket.list.push(s);\n}\n}\n}\n}\ncollectFromMapInline(taskSpec);\ncollectFromMapInline(topTaskSpec);\ncollectFromMapInline(projSpec);\n\n// 5) Attach assetDetails to each merged transaction row by txn -> assetIds -> assetsById\nconst mergedDetails = Array.isArray(mergedDetailsInput) ? mergedDetailsInput : [];\nconst updated = [];\n\nfor (let i = 0; i < mergedDetails.length; i++) {\nconst row = mergedDetails[i];\nif (!row || typeof row !== \"object\") {\nupdated.push(row);\ncontinue;\n}\n\n// Get transaction number from top-level or details\nconst txnVal = row.transactionNumber != null\n? row.transactionNumber\n: (row.details && row.details.transactionNumber != null ? row.details.transactionNumber : null);\n\nconst txnStr = txnVal == null ? \"\" : String(txnVal).trim();\nconst hasNum = /^\\d+$/.test(txnStr);\nconst txn = hasNum ? parseInt(txnStr, 10) : null;\n\nlet assetDetails = [];\n\nif (txn !== null && Number.isFinite(txn) && txnToAssetIds.has(txn)) {\nconst idList = (txnToAssetIds.get(txn) || {}).list || [];\n// Gather assets for all ids (preserve order, dedupe by object identity or serialized key)\nconst seen = new Set();\nconst out = [];\n\nfor (let j = 0; j < idList.length; j++) {\nconst id = idList[j];\nconst rows = assetsById.get(id) || [];\nfor (let k = 0; k < rows.length; k++) {\nconst a = rows[k];\n// Build a dedupe key; prefer asset row's id + maybe a distinguishing field\nconst key = (a && a.id != null) ? \"id:\" + String(a.id) : JSON.stringify(a || {});\nif (!seen.has(key)) {\nseen.add(key);\nout.push(a);\n}\n}\n}\nassetDetails = out;\n}\n\n// Shallow-copy row and attach assetDetails\nconst copy = Array.isArray(row) ? row.slice() : { ...row };\ncopy.assetDetails = assetDetails;\nupdated.push(copy);\n}\n\n// 6) Return updated merged transaction details\nreturn updated;"
          },
          "outcomes": {
            "success": "1772031386877"
          },
