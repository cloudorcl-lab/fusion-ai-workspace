          "metadata": {
            "name": "Extract And Batch Transaction Numbers",
            "returnType": "array",
            "sourceCode": "const grouped= $context.$nodes.GROUP_TRANSACTIONS.$output.result \nconst source = (grouped && Array.isArray(grouped[\"Not_Cross_Charge_NONBTC\"]))\n  ? grouped[\"Not_Cross_Charge_NONBTC\"]\n  : [];\n\n// Normalize to strings (optional) and filter out null/undefined\nconst txns = [];\nfor (let i = 0; i < source.length; i++) {\n  const v = source[i];\n  if (v !== null && v !== undefined) txns.push(String(v));\n}\n\n// Batch into chunks of 10 and format \"(n1,n2,...)\"\nconst batches = [];\nfor (let i = 0; i < txns.length; i += 10) {\n  const chunk = txns.slice(i, i + 10);\n  batches.push(`(${chunk.join(\",\")})`);\n}\n\n// Final result\nconst result = batches;\nreturn result;"
          },
          "outcomes": {
            "success": "1771735574091"
          },
