        {
          "metadata": {
            "name": "Check Project Status for Allow Flag",
            "returnType": "object",
            "sourceCode": "// INPUT A: list of (transactionNumber, projectStatusCode) pairs you looped over\nconst pairs = $context.$nodes.EXTRACT_AND_BATCH_FOR_PROJECT_STATUS.$output.result || [];\n\n// INPUT B: For-Loop node outputs (one entry per iteration). Often JSON strings.\nconst loopOut = $context.$nodes.PROJECT_STATUS_CHECK.$output || [];\n\n// Output buckets\nconst Project_Status_Not_Capitalizable = [];\nconst Transaction_Marked_Not_Capitalizable = [];\n\n// pairs[i] corresponds to loopOut[i]\nconst count = Math.min(pairs.length, loopOut.length);\n\nfor (let i = 0; i < count; i++) {\n  const pair = pairs[i];\n  const txn = (pair && pair.transactionNumber != null) ? pair.transactionNumber : null;\n  if (txn == null) continue;\n\n  // --- Inline safe parse of loop output entry ---\n  let outObj = loopOut[i];\n  if (outObj == null) continue;\n\n  if (typeof outObj === \"string\") {\n    const s = outObj.trim();\n    if (!s) continue;\n    try {\n      outObj = JSON.parse(s);\n    } catch (e) {\n      // If it isn't valid JSON, skip this iteration\n      continue;\n    }\n  }\n\n  // Some nodes wrap payload in { result: ... }\n  const resp = (outObj && outObj.result) ? outObj.result : outObj;\n\n  // Response shape:\n  // { items: [ { code, statusActionControls: { items: [...] } } ], hasMore: false }\n  const firstItem =\n    (resp && Array.isArray(resp.items) && resp.items.length > 0) ? resp.items[0] : null;\n\n  const controlsItems =\n    (firstItem &&\n      firstItem.statusActionControls &&\n      Array.isArray(firstItem.statusActionControls.items))\n      ? firstItem.statusActionControls.items\n      : [];\n\n  // IMPORTANT:\n  // Your accessor filter is: actionCode='CAPITALIZE' AND allowFlag=false\n  // If controlsItems has ANY rows => CAPITALIZE is NOT allowed => NOT capitalizable\n  const notCapitalizable = controlsItems.length > 0;\n\n  if (notCapitalizable) {\n    Project_Status_Not_Capitalizable.push(txn);\n  } else {\n    Transaction_Marked_Not_Capitalizable.push(txn);\n  }\n}\n\nreturn { Project_Status_Not_Capitalizable, Transaction_Marked_Not_Capitalizable };"
          },
