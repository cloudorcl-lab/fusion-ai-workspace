                  "code": "GET_TRANSACTION_DISTRIBUTION_DETAILS",
                  "id": "1774011152014",
                  "inputs": [
                    {
                      "id": "1774165803859_1",
                      "name": "payload",
                      "type": "string",
                      "value": "{{$context.$nodes.GET_TRANSACTION_AND_DISTRIBUTION_DETAILS_IN_BATCH.PREPARE_PAYLOAD_FOR_FETCHING_TRANSACTION_DISTRIBUTION_DETAILS.$output.result}}"
                    }
                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "Merge Transaction And Distribution Details",
                    "returnType": "array",
                    "sourceCode": "const prjPjcVarConvTransactionDetails = $context.$nodes.GET_TRANSACTION_AND_DISTRIBUTION_DETAILS_IN_BATCH.GET_TRANSACTION_DETAILS.$output ?? [];\nconst transactionDistributionDetails = $context.$nodes.GET_TRANSACTION_AND_DISTRIBUTION_DETAILS_IN_BATCH.GET_TRANSACTION_DISTRIBUTION_DETAILS.$output  ?? [];\nconst transactionNumbersStr = $context.$nodes.GET_TRANSACTION_AND_DISTRIBUTION_DETAILS_IN_BATCH.$currentItem ;\n// Parse the transaction numbers string to a Set of numbers\nconst txNums = new Set(\n  transactionNumbersStr\n    .replace(/[()]/g, '')\n    .split(',')\n    .map(s => s.trim())\n    .filter(s => s.length > 0)\n    .map(Number)\n    .filter(n => !Number.isNaN(n))\n);\n// Build a map of transactionNumber -> array of distribution details\nconst distMap = {};\nfor (let i = 0; i < transactionDistributionDetails.length; i++) {\n  const d = transactionDistributionDetails[i];\n  if (!distMap[d.transactionNumber]) distMap[d.transactionNumber] = [];\n  distMap[d.transactionNumber].push(d);\n}\n// Filter details by the given transaction numbers and attach distributions\nconst result = [];\nfor (let i = 0; i < prjPjcVarConvTransactionDetails.length; i++) {\n  const t = prjPjcVarConvTransactionDetails[i];\n  if (txNums.has(Number(t.transactionNumber))) {\n    // Shallow copy to avoid mutating source\n    const merged = Object.assign({}, t);\n    merged.distributionDetails = distMap[t.transactionNumber] ? distMap[t.transactionNumber].slice() : [];\n    result.push(merged);\n  }\n}\nreturn result;"
                  },
                  "outcomes": {
                    "success": "end_1771665653291"
                  },
                  "code": "MERGE_TRANSACTION_AND_DISTRIBUTION_DETAILS",
                  "id": "1774497337858",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                }
              ],
