          "metadata": {
            "name": "Extract Net Zero Validation Transactions",
            "returnType": "array",
            "sourceCode": "const groupedResult = ($context?.$nodes?.GROUP_BY_ACCOUNTING_STATUS_CODE?.$output?.result) || {};\nconst updatedProjects = ($context?.$nodes?.ACCOUNTING_CHECK?.$output?.result) || [];\nconst merged = $context?.$variables?.prjPjcVarConvTransactionDetails || [];\n\n// 1) Build txn -> line -> distribution lookup\nconst distByTxnLine = new Map();\n\nfor (let i = 0; i < (Array.isArray(merged) ? merged.length : 0); i++) {\n  const row = merged[i];\n  if (!row || typeof row !== \"object\") continue;\n\n  const txnVal = row.transactionNumber != null\n    ? row.transactionNumber\n    : (row.details && row.details.transactionNumber != null\n        ? row.details.transactionNumber\n        : null);\n\n  const tStr = txnVal == null ? \"\" : String(txnVal).trim();\n  if (!/^\\d+$/.test(tStr)) continue;\n\n  const txn = parseInt(tStr, 10);\n  if (!Number.isFinite(txn)) continue;\n\n  const dists = Array.isArray(row.distributions)\n    ? row.distributions\n    : (Array.isArray(row.distributionDetails) ? row.distributionDetails : []);\n\n  if (!distByTxnLine.has(txn)) distByTxnLine.set(txn, new Map());\n  const lineMap = distByTxnLine.get(txn);\n\n  for (let j = 0; j < dists.length; j++) {\n    const d = dists[j];\n    if (!d || typeof d !== \"object\") continue;\n\n    const ln = d.lineNumber != null ? d.lineNumber : d.costLineNumber;\n    const key = ln == null ? \"null\" : String(ln);\n\n    lineMap.set(key, d);\n  }\n}\n\n// 2) Combine all groups\nconst allGroups = [];\nconst groups1 = Array.isArray(updatedProjects?.Projects) ? updatedProjects.Projects : [];\nconst groups2 = Array.isArray(groupedResult.NotApplicable) ? groupedResult.NotApplicable : [];\nconst groups3 = Array.isArray(groupedResult.ExternallyAccounted) ? groupedResult.ExternallyAccounted : [];\nconst groups4 = Array.isArray(groupedResult.ReceiptCostPayables) ? groupedResult.ReceiptCostPayables : [];\n\n[groups1, groups2, groups3, groups4].forEach(g => {\n  for (let i = 0; i < g.length; i++) allGroups.push(g[i]);\n});\n\n// 3) Classify\nconst netZeroSet = new Set();\nconst nonNetZeroSet = new Set();\n\nfor (let i = 0; i < allGroups.length; i++) {\n  const entry = allGroups[i];\n\n  // inline extractTxn\n  let txn = null;\n  if (entry != null) {\n    const raw = (typeof entry === \"object\") ? entry.transactionNumber : entry;\n    const s = String(raw).trim();\n    if (/^\\d+$/.test(s)) {\n      const n = parseInt(s, 10);\n      if (Number.isFinite(n)) txn = n;\n    }\n  }\n  if (txn == null) continue;\n\n  // inline extractLineNumbers\n  let lineNumbers = [];\n  if (entry && typeof entry === \"object\" && Array.isArray(entry.lineNumbers)) {\n    lineNumbers = entry.lineNumbers;\n  }\n\n  const lineMap = distByTxnLine.get(txn);\n  let isNetZero = false;\n\n  if (lineMap) {\n    if (lineNumbers.length > 0) {\n      for (let j = 0; j < lineNumbers.length; j++) {\n        const key = lineNumbers[j] == null ? \"null\" : String(lineNumbers[j]);\n        const dist = lineMap.get(key);\n        if (dist && dist.netZeroItemFlag === \"Y\") {\n          isNetZero = true;\n          break;\n        }\n      }\n    } else {\n      for (const d of lineMap.values()) {\n        if (d && d.netZeroItemFlag === \"Y\") {\n          isNetZero = true;\n          break;\n        }\n      }\n    }\n  }\n\n  if (isNetZero) {\n    netZeroSet.add(txn);\n  } else {\n    nonNetZeroSet.add(txn);\n  }\n}\n\n// 4) Return final format\nreturn {\n  Net_Zero_Validation: Array.from(netZeroSet),\n  Non_Net_Zero_Validation: Array.from(nonNetZeroSet)\n};"
          },
          "outcomes": {
            "success": "1773418034120"
          },
          "code": "EXTRACT_NET_ZERO_VALIDATION_TRANSACTIONS",
          "id": "1773411886366",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Extract and Batch Transaction Numbers 3",
            "returnType": "array",
            "sourceCode": "const src =\n  ($context?.$nodes?.EXTRACT_NET_ZERO_VALIDATION_TRANSACTIONS?.$output?.result) || {};\n\nconst nz = Array.isArray(src.Net_Zero_Validation) ? src.Net_Zero_Validation : [];\nconst nnz = Array.isArray(src.Non_Net_Zero_Validation) ? src.Non_Net_Zero_Validation : [];\n\n// Gather all transaction numbers directly\nconst input = [];\n\nfor (let i = 0; i < nz.length; i++) {\n  const tn = nz[i];\n  if (tn !== null && tn !== undefined) input.push(tn);\n}\n\nfor (let i = 0; i < nnz.length; i++) {\n  const tn = nnz[i];\n  if (tn !== null && tn !== undefined) input.push(tn);\n}\n\n// Clean and dedupe\nconst cleaned = [];\nconst seen = new Set();\n\nfor (let i = 0; i < input.length; i++) {\n  const s = String(input[i]).trim();\n  if (!s) continue;\n  if (seen.has(s)) continue;\n\n  seen.add(s);\n  cleaned.push(/^\\d+$/.test(s) ? parseInt(s, 10) : s);\n}\n\n// Chunk into groups of 10 and format \"(...,...)\"\nconst out = [];\nlet chunk = [];\n\nfor (let i = 0; i < cleaned.length; i++) {\n  chunk.push(cleaned[i]);\n\n  if (chunk.length === 10) {\n    out.push(\"(\" + chunk.join(\",\") + \")\");\n    chunk = [];\n  }\n}\n\nif (chunk.length > 0) {\n  out.push(\"(\" + chunk.join(\",\") + \")\");\n}\n\nreturn out;"
          },
