        {
          "metadata": {
            "name": "Check If Atleast One Asset Exists For Inservice Check",
            "returnType": "boolean",
            "sourceCode": "const batches = $context.$nodes.EXTRACT_ASSETIDS_OF_SPECIFIC_ASSET_ASSIGNMENTS.$output.result || [];\n\n// Normalize to array\nconst arr = Array.isArray(batches) ? batches : [batches];\n\n// Scan for at least one assetId\nfor (let i = 0; i < arr.length; i++) {\nconst v = arr[i];\nif (typeof v !== \"string\") continue;\nconst inner = v.trim().replace(/^/,\"\").replace(/$/, \"\");\nif (!inner) continue;\n\n// Split by comma and check for any non-empty token\nconst parts = inner.split(\",\"); // do not trim all at once to be efficient\nfor (let j = 0; j < parts.length; j++) {\nconst token = parts[j] != null ? String(parts[j]).trim() : \"\";\nif (token.length > 0) {\nreturn true; // found at least one assetId\n}\n}\n}\n\nreturn false;"
          },
          "outcomes": {
