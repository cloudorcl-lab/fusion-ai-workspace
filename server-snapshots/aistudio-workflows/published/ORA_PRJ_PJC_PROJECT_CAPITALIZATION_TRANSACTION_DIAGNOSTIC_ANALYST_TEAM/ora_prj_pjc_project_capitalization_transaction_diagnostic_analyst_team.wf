                      "value": "{{$context.$nodes.GET_TRANSACTION_AND_DISTRIBUTION_DETAILS_IN_BATCH.PREPARE_PAYLOAD_FOR_FETCHING_TRANSACTION_DETAILS.$output.result}}"
