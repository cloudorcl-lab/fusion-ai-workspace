                    "sourceCode": "const capitalEventIds = $context.$nodes.CHECK_IF_ASSET_HAS_EVENT_STAMPED.$currentItem ;\n\nconst payload ={\n    \"viewQueries\": {\n        \"projectAsset\": {\n            \"module\": \"oraErpCoreProjectAsset\",\n            \"businessObject\": \"ProjectAsset\",\n            \"view\": \"projectAssetsView\",\n            \"fieldAliases\": {\n                \"id\":\"id\",\n                \"capitalEvent.id\":\"capitalEventId\"\n            }\n        }\n    },\n    \"select\": `SELECT id,capitalEventId from projectAsset where capitalEventId IN ${capitalEventIds} `,\n    \"return\": [\n        {\n            \"name\": \"id\",\n            \"type\": \"int64\"\n        },\n        {\n            \"name\":\"capitalEventId\",\n            \"type\":\"string\"\n        }\n    ]\n}\n;\n\n\nreturn payload;"
