          "metadata": {
            "name": "Extract And Batch ProjectIds1",
            "returnType": "array",
            "sourceCode": "const grouped = $context.$nodes.EVENT_BASED_CHECK.$output.result \nconst mergedTransactionDetails = $context.$nodes.FORMAT_TRANSACTION_AND_DISTRBUTION_DETAILS.$output.result \n\n// 1) Get transaction numbers from Event_Not_Stamped\nconst eventNotStampedTxns = Array.isArray(grouped[\"Event_Not_Stamped\"]) ? grouped[\"Event_Not_Stamped\"] : [];\n\n// 2) Build a map from transactionNumber -> projectId for quick lookup\nconst txToProjectId = {};\nfor (let i = 0; i < mergedTransactionDetails.length; i++) {\n  const t = mergedTransactionDetails[i];\n  if (t && t.transactionNumber != null && t.projectId != null) {\n    txToProjectId[String(t.transactionNumber)] = String(t.projectId);\n  }\n}\n\n// 3) Resolve projectIds for Event_Not_Stamped transactions, de-duplicate while preserving order\nconst projectIds = [];\nconst seen = new Set();\nfor (let i = 0; i < eventNotStampedTxns.length; i++) {\n  const txn = eventNotStampedTxns[i];\n  const pid = txToProjectId[String(txn)];\n  if (pid != null && !seen.has(pid)) {\n    seen.add(pid);\n    projectIds.push(pid);\n  }\n}\n\n// 4) Batch projectIds into chunks of 10 and format as \"(id1,id2,...)\"\nconst batches = [];\nfor (let i = 0; i < projectIds.length; i += 10) {\n  const chunk = projectIds.slice(i, i + 10);\n  batches.push(`(${chunk.join(\",\")})`);\n}\n\n// Final result array of strings\nconst result = batches;\nreturn result;"
          },
