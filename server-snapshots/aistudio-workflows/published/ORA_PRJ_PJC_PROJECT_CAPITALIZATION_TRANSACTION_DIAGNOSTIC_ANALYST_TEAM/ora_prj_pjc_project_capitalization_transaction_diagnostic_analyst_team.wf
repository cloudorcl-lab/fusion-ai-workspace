        {
          "metadata": {
            "name": "Check Asset Event Stamp",
            "returnType": "object",
            "sourceCode": "const capitalEventIdBatches = $context.$nodes.EXTRACT_AND_BATCH_CAPITAL_EVENT_ID.$output.result || [];\nconst response = $context.$nodes.CHECK_IF_ASSET_HAS_EVENT_STAMPED.$output || [];\nconst mergedTransactionDetails = $context.$nodes.FORMAT_TRANSACTION_AND_DISTRBUTION_DETAILS.$output.result || [];\nconst grouped = $context.$nodes.EXTRACT_TRANSACTIONS_TO_PROCESS.$output.result || [];\nconst allowedTxns = new Set(\n  (Array.isArray(grouped) ? grouped : []).map(v => String(v))\n);\n\nconst capitalEventIdBatchesInput = Array.isArray(capitalEventIdBatches) ? capitalEventIdBatches : [];\n\n// 1) Normalize response into a Set of existing capitalEventIds (as strings)\nconst existingEventIds = new Set();\nif (Array.isArray(response)) {\n  for (let i = 0; i < response.length; i++) {\n    const item = response[i];\n    if (typeof item === \"string\") {\n      try {\n        const parsed = JSON.parse(item);\n        if (Array.isArray(parsed)) {\n          for (let j = 0; j < parsed.length; j++) {\n            const rec = parsed[j];\n            if (rec && rec.capitalEventId != null) existingEventIds.add(String(rec.capitalEventId));\n          }\n        } else if (parsed && parsed.capitalEventId != null) {\n          existingEventIds.add(String(parsed.capitalEventId));\n        }\n      } catch (e) {\n        // ignore malformed JSON strings\n      }\n    } else if (item && typeof item === \"object\" && item.capitalEventId != null) {\n      existingEventIds.add(String(item.capitalEventId));\n    }\n  }\n}\n\n// 2) Build a lookup from capitalEventId -> array of transactionNumbers using mergedTransactionDetails\nconst ceidToTxns = {};\nif (Array.isArray(mergedTransactionDetails)) {\n  for (let i = 0; i < mergedTransactionDetails.length; i++) {\n    const t = mergedTransactionDetails[i];\n    if (t && t.capitalEventId != null && t.transactionNumber != null) {\n  const txn = String(t.transactionNumber);\n  if (!allowedTxns.has(txn)) continue;\n\n  const key = String(t.capitalEventId);\n  if (!ceidToTxns[key]) ceidToTxns[key] = [];\n  ceidToTxns[key].push(t.transactionNumber);\n}\n  }\n}\n\n// 3) Parse batches -> flat list of unique capitalEventIds\nconst requestedCeids = [];\nconst seenReq = new Set();\n\nfor (let i = 0; i < capitalEventIdBatchesInput.length; i++) {\n  const s = capitalEventIdBatchesInput[i];\n  if (typeof s === \"string\") {\n    const inner = s.replace(/[()]/g, \"\").trim();\n    if (inner.length > 0) {\n      const parts = inner.split(\",\").map(x => x.trim()).filter(x => x.length > 0);\n      for (let j = 0; j < parts.length; j++) {\n        const idStr = String(parts[j]);\n        if (!seenReq.has(idStr)) {\n          seenReq.add(idStr);\n          requestedCeids.push(idStr);\n        }\n      }\n    }\n  }\n}\n\n// 4) Classify\nconst Transactions_To_Process = [];\nconst Asset_Not_Event_Stamped = [];\n\nfor (let i = 0; i < requestedCeids.length; i++) {\n  const ceid = requestedCeids[i];\n  const txns = ceidToTxns[ceid];\n  if (!Array.isArray(txns) || txns.length === 0) continue;\n\n  if (existingEventIds.has(ceid)) {\n    for (let k = 0; k < txns.length; k++) {\n      const v = txns[k];\n      if (v !== null && v !== undefined) Transactions_To_Process.push(v);\n    }\n  } else {\n    for (let k = 0; k < txns.length; k++) {\n      const v = txns[k];\n      if (v !== null && v !== undefined) Asset_Not_Event_Stamped.push(v);\n    }\n  }\n}\n\n// 5) De-duplicate while preserving order\nconst dedupSeenTTP = new Set();\nconst dedupTTP = [];\nfor (let i = 0; i < Transactions_To_Process.length; i++) {\n  const v = Transactions_To_Process[i];\n  const key = String(v);\n  if (!dedupSeenTTP.has(key)) {\n    dedupSeenTTP.add(key);\n    dedupTTP.push(v);\n  }\n}\n\nconst dedupSeenAsset = new Set();\nconst dedupAsset = [];\nfor (let i = 0; i < Asset_Not_Event_Stamped.length; i++) {\n  const v = Asset_Not_Event_Stamped[i];\n  const key = String(v);\n  if (!dedupSeenAsset.has(key)) {\n    dedupSeenAsset.add(key);\n    dedupAsset.push(v);\n  }\n}\n\nreturn {\n  Transactions_To_Process: dedupTTP,\n  Asset_Not_Event_Stamped: dedupAsset\n};"
          },
