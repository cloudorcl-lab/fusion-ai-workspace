        {
          "metadata": {
            "name": "Batching",
            "returnType": "array",
            "sourceCode": "// Input: array of transaction numbers (integers)\nlet txns = $context.$variables.PrjPjcVarConvTransactionsToProcess ;\n\n\n\n// Normalize to array\nif (Array.isArray(txns)) {\n// ok\n} else if (typeof txns === \"number\") {\ntxns = [txns];\n} else if (typeof txns === \"string\") {\n// If the platform sometimes sends a single transaction as a string,\n// treat it as one-element array. If it sends a comma-separated list,\n// split and trim.\nif (txns.includes(\",\")) {\ntxns = txns.split(\",\").map(s => s.trim()).filter(s => s.length > 0);\n} else {\ntxns = [txns.trim()];\n}\n} else {\nthrow new Error(\"Unsupported txns type\");\n}\n\nconst result = [];\nconst batchSize = 10;\n\nfor (let i = 0; i < txns.length; i += batchSize) {\nconst end = Math.min(i + batchSize, txns.length);\nlet s = \"(\";\nfor (let j = i; j < end; j++) {\nif (j > i) s += \",\";\ns += String(txns[j]);\n}\ns += \")\";\nresult.push(s);\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1771665653291"
          },
          "code": "BATCHING",
          "id": "1771665493276",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
