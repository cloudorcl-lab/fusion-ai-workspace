                    "returnType": "object",
                    "sourceCode": "const transactionNumbers = $context.$nodes.RESET_ACCOUNTING_CHECK.$currentItem ;\n\nconst payload =\n{\n  \"viewQueries\": {\n    \"ProjectAssetLineDetail\": {\n      \"module\": \"oraErpCoreProjectAsset\",\n      \"businessObject\": \"ProjectAssetLineDetail\",\n      \"view\": \"projectAssetLineDetailsView\",\n      \"fieldAliases\": {\n        \"costDistribution.lineNumber\": \"lineNumber\",\n        \"costDistribution.transactionNumber\": \"transactionNumber\"\n      }\n    }\n  },\n  \"select\":` SELECT  lineNumber,transactionNumber FROM ProjectAssetLineDetail where transactionNumber IN ${transactionNumbers} `\n\n  \n};\n\n\nreturn payload;"
