          "metadata": {
            "name": "Extract And Batch for Project Status",
            "returnType": "array",
            "sourceCode": "const grouped = $context.$nodes.GROUP_TRANSACTIONS.$output.result || {};\n\n// Txns needing project status check\nconst source = Array.isArray(grouped[\"Project_Status_Check_Needed\"])\n  ? grouped[\"Project_Status_Check_Needed\"]\n  : [];\n\n// Full transaction details for lookup\nconst all = $context.$nodes.FORMAT_TRANSACTION_AND_DISTRBUTION_DETAILS.$output.result || [];\n\n// Build lookup: txn -> projectStatusCode\nconst txnToStatus = new Map();\nfor (const t of all) {\n  if (t?.transactionNumber != null) {\n    txnToStatus.set(t.transactionNumber, t.projectStatusCode ?? null);\n  }\n}\n\n// Build flat list of valid pairs\nconst pairs = [];\nfor (const v of source) {\n  if (v === null || v === undefined) continue;\n\n  const txn = Number(v);\n  if (!Number.isFinite(txn)) continue;\n\n  const code = txnToStatus.get(txn);\n\n  // Choose one behavior:\n  // (A) Skip if missing code:\n  if (!code) continue;\n\n  // (B) Or keep it (uncomment instead of skipping):\n  // pairs.push({ transactionNumber: txn, projectStatusCode: code ? String(code) : null });\n  // continue;\n\n  pairs.push({ transactionNumber: txn, projectStatusCode: String(code) });\n}\n\nreturn pairs;"
          },
