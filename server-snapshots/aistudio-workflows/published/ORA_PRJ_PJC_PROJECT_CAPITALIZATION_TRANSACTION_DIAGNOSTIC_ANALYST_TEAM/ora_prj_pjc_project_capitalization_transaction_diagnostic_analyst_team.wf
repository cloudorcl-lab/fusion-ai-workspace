        {
          "metadata": {
            "name": "Update Transaction Summary With Catch All",
            "returnType": "object",
            "sourceCode": "const Transactions_To_Process= $context.$variables.PrjPjcVarConvTransactionsToProcess \nconst prjPjcVarConvTransactionSummary= $context.$variables.PrjPjcVarConvTransactionSummary \n\n\nconst ttp = Array.isArray(Transactions_To_Process) ? Transactions_To_Process : [];\nconst summary =\n  (prjPjcVarConvTransactionSummary && typeof prjPjcVarConvTransactionSummary === \"object\" && !Array.isArray(prjPjcVarConvTransactionSummary))\n    ? { ...prjPjcVarConvTransactionSummary }\n    : {};\n\n// Build a set of all values already present in any bucket\nconst existingSet = new Set();\nconst keys = Object.keys(summary);\nfor (let i = 0; i < keys.length; i++) {\n  const k = keys[i];\n  const bucket = summary[k];\n  if (Array.isArray(bucket)) {\n    for (let j = 0; j < bucket.length; j++) {\n      const v = bucket[j];\n      if ((typeof v === \"string\" || typeof v === \"number\") && v !== null && v !== undefined) {\n        existingSet.add(String(v));\n      }\n    }\n  }\n}\n\n// Build Catch_All candidates (do not create the bucket yet)\nconst catchAllCandidates = [];\nconst seenCandidates = new Set();\n\nfor (let i = 0; i < ttp.length; i++) {\n  const v = ttp[i];\n  if ((typeof v === \"string\" || typeof v === \"number\") && v !== null && v !== undefined) {\n    const k = String(v);\n    if (!existingSet.has(k) && !seenCandidates.has(k)) {\n      seenCandidates.add(k);\n      catchAllCandidates.push(v);\n    }\n  }\n}\n\n// Add Catch_All only if there are transactions to add\nif (catchAllCandidates.length > 0) {\n  const existing = Array.isArray(summary.Catch_All) ? summary.Catch_All.slice() : [];\n  const existingSeen = new Set(existing.map(x => String(x)));\n  for (let i = 0; i < catchAllCandidates.length; i++) {\n    const v = catchAllCandidates[i];\n    const k = String(v);\n    if (!existingSeen.has(k)) {\n      existingSeen.add(k);\n      existing.push(v);\n    }\n  }\n  if (existing.length > 0) {\n    summary.Catch_All = existing;\n  }\n}\n\nreturn summary;"
          },
