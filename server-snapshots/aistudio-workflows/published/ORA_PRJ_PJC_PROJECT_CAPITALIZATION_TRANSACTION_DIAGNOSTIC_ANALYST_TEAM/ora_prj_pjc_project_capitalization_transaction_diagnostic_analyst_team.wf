        {
          "metadata": {
            "name": "AssignmentClassification",
            "returnType": "object",
            "sourceCode": "const assetAssignmentsRaw = $context.$nodes.GET_ASSET_ASSIGNMENTS.$output;\nconst mergedInput = $context.$nodes.EXTRACT_AND_BATCH_PROJECTIDS2.$output.result;\n\nconst result = {\n  ProjectCommon: [],\n  TaskCommon: [],\n  TopTaskCommon: [],\n  ProjectSpecific: {},\n  TaskSpecific: {},\n  TopTaskSpecific: {},\n  NoProjectAssignment: []\n};\n\n// 1) Normalize assetAssignmentsRaw -> Map(txn -> { transactionNumber, assetAssignmentsDetails })\nconst txnToAssignment = new Map();\nif (Array.isArray(assetAssignmentsRaw)) {\n  for (let i = 0; i < assetAssignmentsRaw.length; i++) {\n    const el = assetAssignmentsRaw[i];\n    if (typeof el !== \"string\") continue;\n    const s = el.trim();\n    if (!s) continue;\n    try {\n      const parsed = JSON.parse(s);\n      const res = parsed && parsed.result ? parsed.result : null;\n      if (!res || typeof res !== \"object\") continue;\n\n      const txn = res.transactionNumber;\n      if (txn == null) continue;\n\n      const details = Array.isArray(res.assetAssignmentsDetails)\n        ? res.assetAssignmentsDetails\n        : [];\n\n      txnToAssignment.set(Number(txn), {\n        transactionNumber: Number(txn),\n        assetAssignmentsDetails: details\n      });\n    } catch (e) {\n      // ignore parse errors\n    }\n  }\n}\n\n// helpers\nconst addUniqueTo = (arr, v) => {\n  const key = typeof v === \"number\" ? \"n:\" + v : \"s:\" + String(v);\n  if (!arr._seen) arr._seen = new Set();\n  if (!arr._seen.has(key)) {\n    arr._seen.add(key);\n    arr.push(v);\n  }\n};\n\nconst toStr = (v) => (v == null ? \"\" : String(v).trim());\n\nconst isTruthyCommon = (v) => {\n  if (v === true || v === 1) return true;\n  if (typeof v === \"string\") {\n    const t = v.trim().toLowerCase();\n    return t === \"true\" || t === \"y\" || t === \"yes\" || t === \"1\";\n  }\n  return false;\n};\n\n// 2) Per-transaction classification\nfor (let i = 0; i < (Array.isArray(mergedInput) ? mergedInput.length : 0); i++) {\n  const tx = mergedInput[i];\n  if (!tx || typeof tx !== \"object\") continue;\n\n  const txnStr = toStr(tx.transactionNumber);\n  if (!/^\\d+/.test(txnStr)) continue;\n  const txn = parseInt(txnStr, 10);\n\n  const taskId = toStr(tx.taskId);\n  const topTaskId = toStr(tx.denormTopElementId);\n\n  const resp = txnToAssignment.get(txn);\n  const rows = resp && Array.isArray(resp.assetAssignmentsDetails)\n    ? resp.assetAssignmentsDetails\n    : [];\n\n  // ?? No assignment data\n  if (!rows || rows.length === 0) {\n    addUniqueTo(result.NoProjectAssignment, txn);\n    continue;\n  }\n\n  // =========================\n  // ?? 2a) Common assignments\n  // =========================\n  const commonRows = [];\n  for (let j = 0; j < rows.length; j++) {\n    const r = rows[j];\n    if (!r || typeof r !== \"object\") continue;\n\n    const v = r.commonCostFlag;\n    const isY = typeof v === \"string\" && v.trim().toUpperCase() === \"Y\";\n\n    if (isY || isTruthyCommon(v)) {\n      commonRows.push(r);\n    }\n  }\n\n  if (commonRows.length > 0) {\n    let hasTaskCommon = false;\n    let hasTopTaskCommon = false;\n    let hasProjectCommon = false;\n\n    for (let j = 0; j < commonRows.length; j++) {\n  const r = commonRows[j];\n\n  // assignment taskId field\n  const assignmentTaskId = toStr(r.taskId);\n\n  // transaction fields\n  const txnTaskId = toStr(taskId);\n  const txnTopTaskId = toStr(topTaskId);\n\n  // Project common\n  if (!assignmentTaskId) {\n    hasProjectCommon = true;\n  }\n\n  // Task common\n  else if (\n    txnTaskId &&\n    assignmentTaskId === txnTaskId\n  ) {\n    hasTaskCommon = true;\n  }\n\n  // Top task common\n  else if (\n    txnTopTaskId &&\n    assignmentTaskId === txnTopTaskId\n  ) {\n    hasTopTaskCommon = true;\n  }\n}\n\n    if (hasTaskCommon) {\n    addUniqueTo(result.TaskCommon, txn);\n  continue;\n} else if (hasTopTaskCommon) {\n      addUniqueTo(result.TopTaskCommon, txn);\n      continue;\n    } else if (hasProjectCommon) {\n      addUniqueTo(result.ProjectCommon, txn);\n      continue;\n    }\n  }\n\n  // =========================\n  // ?? 2b) ProjectSpecific\n  // =========================\n  const projectMatches = [];\n  for (let j = 0; j < rows.length; j++) {\n    const r = rows[j];\n    if (!r || typeof r !== \"object\") continue;\n\n    const rTaskId = toStr(r.taskId);\n    const rTopTaskId = toStr(r.topTaskId);\n\n    // project-level (no task, no topTask)\n    if (!rTaskId && !rTopTaskId) {\n      const pidStr = toStr(r.projectAssetId);\n      if (pidStr) {\n        const pid = /^\\d+$/.test(pidStr) ? parseInt(pidStr, 10) : pidStr;\n        projectMatches.push(pid);\n      }\n    }\n  }\n\n  if (projectMatches.length > 0) {\n    const seen = new Set();\n    const uniq = [];\n\n    for (let k = 0; k < projectMatches.length; k++) {\n      const v = projectMatches[k];\n      const key = typeof v === \"number\" ? \"n:\" + v : \"s:\" + String(v);\n      if (!seen.has(key)) {\n        seen.add(key);\n        uniq.push(v);\n      }\n    }\n\n    result.ProjectSpecific[txn] = uniq;\n    continue;\n  }\n\n  // =========================\n  //  2c) TaskSpecific\n  // =========================\n  const taskMatches = [];\n  if (taskId) {\n    for (let j = 0; j < rows.length; j++) {\n      const r = rows[j];\n      if (!r || typeof r !== \"object\") continue;\n\n      const rTaskId = toStr(r.taskId);\n      if (rTaskId && rTaskId === taskId) {\n        const pidStr = toStr(r.projectAssetId);\n        if (pidStr) {\n          const pid = /^\\d+$/.test(pidStr) ? parseInt(pidStr, 10) : pidStr;\n          taskMatches.push(pid);\n        }\n      }\n    }\n  }\n\n  if (taskMatches.length > 0) {\n    const seen = new Set();\n    const uniq = [];\n\n    for (let k = 0; k < taskMatches.length; k++) {\n      const v = taskMatches[k];\n      const key = typeof v === \"number\" ? \"n:\" + v : \"s:\" + String(v);\n      if (!seen.has(key)) {\n        seen.add(key);\n        uniq.push(v);\n      }\n    }\n\n    result.TaskSpecific[txn] = uniq;\n    continue;\n  }\n\n  // =========================\n  // 2d) TopTaskSpecific\n  // =========================\n  const topTaskMatches = [];\nif (topTaskId) {\n  for (let j = 0; j < rows.length; j++) {\n    const r = rows[j];\n    if (!r || typeof r !== \"object\") continue;\n\n    const rTaskId = toStr(r.taskId);\n    if (rTaskId && rTaskId === topTaskId) {\n      const pidStr = toStr(r.projectAssetId);\n      if (pidStr) {\n        const pid = /^\\d+$/.test(pidStr) ? parseInt(pidStr, 10) : pidStr;\n        topTaskMatches.push(pid);\n      }\n    }\n  }\n}\n\n  if (topTaskMatches.length > 0) {\n    const seen = new Set();\n    const uniq = [];\n\n    for (let k = 0; k < topTaskMatches.length; k++) {\n      const v = topTaskMatches[k];\n      const key = typeof v === \"number\" ? \"n:\" + v : \"s:\" + String(v);\n      if (!seen.has(key)) {\n        seen.add(key);\n        uniq.push(v);\n      }\n    }\n\n    result.TopTaskSpecific[txn] = uniq;\n    continue;\n  }\n\n  //  fallback\n  addUniqueTo(result.NoProjectAssignment, txn);\n}\n\n// 3) Cleanup empty buckets\nif (result.ProjectCommon.length === 0) delete result.ProjectCommon;\nif (result.TaskCommon.length === 0) delete result.TaskCommon;\nif (result.TopTaskCommon.length === 0) delete result.TopTaskCommon;\nif (Object.keys(result.ProjectSpecific).length === 0) delete result.ProjectSpecific;\nif (Object.keys(result.TaskSpecific).length === 0) delete result.TaskSpecific;\nif (Object.keys(result.TopTaskSpecific).length === 0) delete result.TopTaskSpecific;\nif (result.NoProjectAssignment.length === 0) delete result.NoProjectAssignment;\n\nreturn result;"
          },
          "outcomes": {
            "success": "1772033694985"
          },
          "code": "ASSIGNMENTCLASSIFICATION",
          "id": "1771938302512",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Extract And Batch ProjectIds2",
            "returnType": "array",
            "sourceCode": "const rawTransactions = $context.$variables.PrjPjcVarConvTransactionsToProcess;\nconst mergedDetails =\n$context.$nodes.FORMAT_TRANSACTION_AND_DISTRBUTION_DETAILS.$output.result || [];\n\n// Normalize rawTransactions into an array (no functions)\nlet transactionsInput = [];\nif (rawTransactions != null) {\nif (Array.isArray(rawTransactions)) {\ntransactionsInput = rawTransactions;\n} else {\nconst s0 = String(rawTransactions).trim();\nif (s0) {\nlet parsed = null;\nlet parsedOk = false;\ntry {\nparsed = JSON.parse(s0);\nparsedOk = true;\n} catch (e) {\nparsedOk = false;\n}\nif (parsedOk) {\nif (Array.isArray(parsed)) {\ntransactionsInput = parsed;\n} else {\ntransactionsInput = [parsed];\n}\n} else {\nif (s0.includes(\",\")) {\nconst parts = s0.split(\",\");\nconst arr = [];\nfor (let i = 0; i < parts.length; i++) {\nconst p = parts[i].trim();\nif (p) arr.push(p);\n}\ntransactionsInput = arr;\n} else {\ntransactionsInput = [s0];\n}\n}\n}\n}\n}\n\n// Build lookup: txnNumber -> { projectId, taskId, denormTopElementId }\nconst txnToDetails = new Map();\nfor (let i = 0; i < (Array.isArray(mergedDetails) ? mergedDetails.length : 0); i++) {\nconst row = mergedDetails[i];\nif (!row || typeof row !== \"object\") continue;\n\nconst txnVal =\nrow.transactionNumber != null\n? row.transactionNumber\n: (row.details && row.details.transactionNumber != null\n? row.details.transactionNumber\n: null);\n\nconst projectId =\nrow.projectId != null\n? row.projectId\n: (row.details && row.details.projectId != null\n? row.details.projectId\n: null);\n\nconst taskId =\nrow.taskId != null\n? row.taskId\n: (row.details && row.details.taskId != null\n? row.details.taskId\n: null);\n\nconst denormTopElementId =\nrow.denormTopElementId != null\n? row.denormTopElementId\n: (row.details && row.details.denormTopElementId != null\n? row.details.denormTopElementId\n: null);\n\nconst txnStr = txnVal == null ? \"\" : String(txnVal).trim();\nif (!/^\\d+$/.test(txnStr)) continue;\n\nconst txnNum = parseInt(txnStr, 10);\ntxnToDetails.set(txnNum, {\nprojectId: projectId == null ? \"\" : String(projectId).trim(),\ntaskId: taskId == null ? \"\" : String(taskId).trim(),\ndenormTopElementId: denormTopElementId == null ? \"\" : String(denormTopElementId).trim()\n});\n}\n\n// Build output preserving input order; accept only numeric txns\nconst output = [];\nfor (let i = 0; i < transactionsInput.length; i++) {\nconst v = transactionsInput[i];\nif (v == null) continue;\nconst s = String(v).trim();\nif (!/^\\d+$/.test(s)) continue;\n\nconst txnNum = parseInt(s, 10);\nconst det = txnToDetails.get(txnNum);\nif (!det) continue;\n\noutput.push({\ntransactionNumber: txnNum,\nprojectId: det.projectId || \"\",\ntaskId: det.taskId || \"\",\ndenormTopElementId: det.denormTopElementId || \"\"\n});\n}\n\nreturn output;"
          },
