            "sourceCode": "const input = $context.$variables.PrjPjcVarConvTransactionsToProcess;\n\nconst arr = [].concat(input || []);\n\nfor (let i = 0; i < arr.length; i++) {\n  const v = arr[i];\n  if (v != null && !(typeof v === \"string\" && v.trim() === \"\")) {\n    return true;\n  }\n}\n\nreturn false;"
