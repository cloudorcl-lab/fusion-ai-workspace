        {
          "metadata": {
            "name": "Check Event Exists",
            "returnType": "object",
            "sourceCode": "const projectIdBatches = $context.$nodes.EXTRACT_AND_BATCH_PROJECTIDS1.$output.result || [];\nconst rawResponse = $context.$nodes.GET_CAPITAL_EVENTS_FOR_PROJECTS.$output || [];\nconst mergedTransactionDetails = $context.$nodes.FORMAT_TRANSACTION_AND_DISTRBUTION_DETAILS.$output.result || [];\n\n// -------------------------------------------------------------------\n// 1) Normalize response into an array of objects\n//    Handles:\n//    - [{ projectId: \"123\" }]\n//    - ['[{\"projectId\":\"123\"}]']\n//    - mixed arrays containing strings and objects\n// -------------------------------------------------------------------\nconst responseItems = [];\n\nif (Array.isArray(rawResponse)) {\n  for (let i = 0; i < rawResponse.length; i++) {\n    const item = rawResponse[i];\n\n    if (typeof item === \"string\") {\n      try {\n        const parsed = JSON.parse(item);\n        if (Array.isArray(parsed)) {\n          for (let j = 0; j < parsed.length; j++) {\n            const rec = parsed[j];\n            if (rec && typeof rec === \"object\") responseItems.push(rec);\n          }\n        } else if (parsed && typeof parsed === \"object\") {\n          responseItems.push(parsed);\n        }\n      } catch (e) {\n        // ignore malformed JSON strings\n      }\n    } else if (item && typeof item === \"object\") {\n      responseItems.push(item);\n    }\n  }\n} else if (rawResponse && typeof rawResponse === \"object\") {\n  responseItems.push(rawResponse);\n}\n\n// -------------------------------------------------------------------\n// 2) Build set of projectIds that already have capital events\n// -------------------------------------------------------------------\nconst eventProjectIds = new Set();\nfor (let i = 0; i < responseItems.length; i++) {\n  const r = responseItems[i];\n  if (r && r.projectId != null) {\n    eventProjectIds.add(String(r.projectId));\n  }\n}\n\n// -------------------------------------------------------------------\n// 3) Build lookup: projectId -> [transactionNumbers]\n// -------------------------------------------------------------------\nconst grouped = $context.$nodes.EVENT_BASED_CHECK.$output.result || {};\nconst eventNotStampedTxns = Array.isArray(grouped.Event_Not_Stamped)\n  ? grouped.Event_Not_Stamped\n  : [];\nconst allowedTxns = new Set(eventNotStampedTxns.map(v => String(v)));\n\nconst projectIdToTxns = {};\nif (Array.isArray(mergedTransactionDetails)) {\n  for (let i = 0; i < mergedTransactionDetails.length; i++) {\n    const t = mergedTransactionDetails[i];\n    if (!t || t.projectId == null || t.transactionNumber == null) continue;\n\n    const pid = String(t.projectId);\n    const txn = String(t.transactionNumber);\n\n    if (!allowedTxns.has(txn)) continue;\n\n    if (!projectIdToTxns[pid]) projectIdToTxns[pid] = [];\n    projectIdToTxns[pid].push(txn);\n  }\n}\n\n// -------------------------------------------------------------------\n// 4) Parse projectId batches like \"(id1,id2,...)\" into a flat list\n// -------------------------------------------------------------------\nconst inputProjectIds = [];\nfor (let i = 0; i < projectIdBatches.length; i++) {\n  const s = projectIdBatches[i];\n  if (typeof s !== \"string\") continue;\n\n  const inner = s.replace(/[()]/g, \"\").trim();\n  if (inner.length === 0) continue;\n\n  const ids = inner.split(\",\").map(x => x.trim()).filter(x => x.length > 0);\n  for (let j = 0; j < ids.length; j++) {\n    inputProjectIds.push(ids[j]);\n  }\n}\n\n// -------------------------------------------------------------------\n// 5) Bucket transactions based on whether the project has an event\n// -------------------------------------------------------------------\nconst txEventExists = [];\nconst txEventDoesNotExist = [];\nconst seenExists = new Set();\nconst seenDoesNot = new Set();\n\nfor (let i = 0; i < inputProjectIds.length; i++) {\n  const pid = String(inputProjectIds[i]);\n  const txs = projectIdToTxns[pid] || [];\n\n  if (eventProjectIds.has(pid)) {\n    for (let j = 0; j < txs.length; j++) {\n      const txn = txs[j];\n      if (!seenExists.has(txn)) {\n        seenExists.add(txn);\n        txEventExists.push(txn);\n      }\n    }\n  } else {\n    for (let j = 0; j < txs.length; j++) {\n      const txn = txs[j];\n      if (!seenDoesNot.has(txn)) {\n        seenDoesNot.add(txn);\n        txEventDoesNotExist.push(txn);\n      }\n    }\n  }\n}\n\n// -------------------------------------------------------------------\n// 6) Return result\n// -------------------------------------------------------------------\nlet result= {\n  Event_Exists: txEventExists,\n  Event_DoesNot_Exists: txEventDoesNotExist\n};\n\nreturn result;"
          },
