                {
                  "metadata": {
                    "name": "Prepare Payload For Fetching Inservice Assets",
                    "returnType": "object",
                    "sourceCode": "const projectIds = $context.$nodes.INSERVICE_ASSETS.$currentItem ;\n\nconst payload ={\n    \"viewQueries\": {\n        \"projectAsset\": {\n            \"module\": \"oraErpCoreProjectAsset\",\n            \"businessObject\": \"ProjectAsset\",\n            \"view\": \"projectAssetsView\",\n            \"fieldAliases\": {\n                \"id\":\"id\",\n                \"capitalEvent.id\":\"capitalEventId\",\n                \"capitalHoldFlag\":\"capitalHoldFlag\",\n                \"project.id\":\"projectId\",\n                \"assetType.lookupCode\":\"assetTypeCode\",\n               \"actualInServiceOrRetirementDate\":\"actualInServiceOrRetirementDate\",\n               \"assetName\":\"assetName\"\n            }\n        }\n    },\n    \"select\": `SELECT id,capitalEventId,capitalHoldFlag,projectId,assetTypeCode,actualInServiceOrRetirementDate,assetName from projectAsset where projectId IN ${projectIds} and (assetTypeCode='RETIREMENT_ADJUSTMENT' or  assetTypeCode='AS-BUILT')`,\n    \"return\": [\n        {\n            \"name\": \"id\",\n            \"type\": \"int64\"\n        },\n        {\n            \"name\":\"capitalEventId\",\n            \"type\":\"string\"\n        },\n        {\n            \"name\":\"capitalHoldFlag\",\n            \"type\":\"string\"\n        },\n        {\n            \"name\":\"projectId\",\n            \"type\":\"int64\"\n        },\n        {\n            \"name\":\"assetTypeCode\",\n            \"type\":\"string\"\n        },\n         {\n            \"name\":\"actualInServiceOrRetirementDate\",\n            \"type\":\"string\"\n        },\n       {\n            \"name\":\"assetName\",\n            \"type\":\"string\"\n        }\n    ]\n};\n\n\nreturn payload;"
                  },
