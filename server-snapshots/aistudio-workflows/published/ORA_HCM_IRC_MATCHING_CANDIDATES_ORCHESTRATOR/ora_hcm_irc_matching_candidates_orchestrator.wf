            "returnType": "array",
            "sourceCode": "var inputString = $context.$triggers.REST.$input.OraAppContext;\nvar parsedData = JSON.parse(inputString);\nvar result = [];\n\n// Check if the key exists and add it to the array\nif (parsedData && parsedData.requisitionId) {\n    result.push(parsedData.requisitionId);\n}\n\nreturn result;"
          },
