          "code": "GENERATE_RESPONSE",
          "id": "1770841658102",
          "inputs": [
            {
              "id": "1770841658104_1",
              "name": "prompt",
              "type": "string",
              "value": "{{$context.$nodes.SELECT_RESPONSE_PROMPT.$output.result}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"string\"\n}",
          "type": "LLM",
          "diagram": {
            "x": 5470,
            "y": 10952
          }
        },
        {
          "metadata": {
            "name": "Normalize Response",
            "language": "JAVASCRIPT",
            "returnType": "object",
            "sourceCode": "var raw = $context.$nodes.GENERATE_RESPONSE.$output;\nvar prepared = $context.$nodes.PREPARE_RESPONSE_CONTEXT.$output.result || {};\nvar preparedContent = String(prepared.content || '').trim();\nvar noDataMessage = 'No Service Requests or interactions were found in the last 90 days';\nvar isValidationMessage = preparedContent.indexOf('Invalid stripeCd:') === 0;\nvar parsedObject = null;\nvar result = '';\nvar normalized = null;\nfunction normalizePair(summaryValue, explanationValue) {\n  return {\n    summary: summaryValue === undefined ? null : summaryValue,\n    explanation: explanationValue === undefined ? null : explanationValue\n  };\n}\nif (preparedContent === noDataMessage || isValidationMessage) {\n  normalized = normalizePair(preparedContent, null);\n} else {\n  if (raw && typeof raw === 'object' && !Array.isArray(raw)) {\n    if (Object.prototype.hasOwnProperty.call(raw, 'summary') || Object.prototype.hasOwnProperty.call(raw, 'explanation')) {\n      parsedObject = raw;\n    } else if (raw.result && typeof raw.result === 'object' && (Object.prototype.hasOwnProperty.call(raw.result, 'summary') || Object.prototype.hasOwnProperty.call(raw.result, 'explanation'))) {\n      parsedObject = raw.result;\n    }\n  }\n  if (!parsedObject) {\n    if (typeof raw === 'string') { result = raw; }\n    else if (raw && typeof raw.result === 'string') { result = raw.result; }\n    else if (raw && typeof raw.content === 'string') { result = raw.content; }\n    else if (raw && typeof raw.value === 'string') { result = raw.value; }\n    else if (raw && raw.result && typeof raw.result.content === 'string') { result = raw.result.content; }\n    else if (raw && raw.result && typeof raw.result.answer === 'string') { result = raw.result.answer; }\n    else if (raw && raw.result && typeof raw.result.value === 'string') { result = raw.result.value; }\n    else { result = JSON.stringify(raw || ''); }\n    result = String(result || '').trim();\n    if (result.indexOf('```') === 0) {\n      result = result.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, '').trim();\n    }\n    if (result.length >= 2 && result.charAt(0) === '\"' && result.charAt(result.length - 1) === '\"') {\n      try {\n        var parsedString = JSON.parse(result);\n        if (typeof parsedString === 'string') {\n          result = parsedString.trim();\n        }\n      } catch (error) {\n      }\n    }\n    if (result && result.charAt(0) === '{' && result.charAt(result.length - 1) === '}') {\n      try {\n        var parsedJson = JSON.parse(result);\n        if (parsedJson && typeof parsedJson === 'object' && (Object.prototype.hasOwnProperty.call(parsedJson, 'summary') || Object.prototype.hasOwnProperty.call(parsedJson, 'explanation'))) {\n          parsedObject = parsedJson;\n        }\n      } catch (error) {\n      }\n    }\n  }\n  if (parsedObject) {\n    var summaryValue = parsedObject.summary;\n    var explanationValue = parsedObject.explanation;\n    if (summaryValue !== null && summaryValue !== undefined) {\n      summaryValue = String(summaryValue).trim();\n      if (summaryValue === '') { summaryValue = null; }\n    } else {\n      summaryValue = null;\n    }\n    if (explanationValue !== null && explanationValue !== undefined) {\n      explanationValue = String(explanationValue).trim();\n      if (explanationValue === '') { explanationValue = null; }\n    } else {\n      explanationValue = null;\n    }\n    normalized = normalizePair(summaryValue, explanationValue);\n  } else {\n    result = String(result || '').trim();\n    normalized = normalizePair(result, null);\n  }\n}\nreturn normalized;"
          },
          "outcomes": {
            "success": "1776002325308"
          },
