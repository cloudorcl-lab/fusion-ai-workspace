        {
          "metadata": {
            "name": "Select Top Items",
            "language": "JAVASCRIPT",
            "returnType": "array",
            "sourceCode": "var interactionOutput = (($context.$nodes.GET_INTERACTION_CANDIDATES || {}).$output || {});\nvar srOutput = (($context.$nodes.GET_SR_CANDIDATES || {}).$output || {});\nvar interactions = interactionOutput.result || [];\nvar srs = srOutput.result || [];\nvar result = [];\nvar selected = [];\nvar i = 0;\nvar j = 0;\nfor (i = 0; i < interactions.length; i++) { result.push(interactions[i]); }\nfor (i = 0; i < srs.length; i++) { result.push(srs[i]); }\nfor (i = 0; i < result.length; i++) {\n  for (j = i + 1; j < result.length; j++) {\n    if (new Date(result[j].date).getTime() > new Date(result[i].date).getTime()) {\n      var temp = result[i];\n      result[i] = result[j];\n      result[j] = temp;\n    }\n  }\n}\nselected = result;\nif (selected.length > 5) {\n  selected = selected.slice(0, 5);\n}\nreturn selected;"
          },
