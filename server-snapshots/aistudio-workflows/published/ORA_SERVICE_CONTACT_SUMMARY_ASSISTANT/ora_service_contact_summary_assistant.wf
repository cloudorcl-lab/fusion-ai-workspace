            "sourceCode": "var response = $context.$nodes.NORMALIZE_RESPONSE.$output.result || {};\nvar prepared = $context.$nodes.PREPARE_RESPONSE_CONTEXT.$output.result || {};\nvar currentSummary = response.summary;\nvar hasNewSummary = currentSummary !== undefined && currentSummary !== null && String(currentSummary).trim() !== '';\nvar contextUpdate = {\n  lastSummaryResponse: hasNewSummary ? String(currentSummary).trim() : String($context.$variables.lastSummaryResponse || ''),\n  lastSummaryContext: hasNewSummary ? String($context.$nodes.CREATE_CONTEXT_PROMPT_REFERENCES.$output.result || '') : String($context.$variables.lastSummaryContext || ''),\n  lastContactPartyId: hasNewSummary ? String(prepared.contactPartyId || '') : String($context.$variables.lastContactPartyId || '')\n};\nreturn contextUpdate;"
