        {
          "metadata": {
            "name": "Create Interactions Prompt References",
            "language": "JAVASCRIPT",
            "returnType": "string",
            "sourceCode": "var inputObj = $context.$input || {};\nvar restInput = (($context.$triggers || {}).REST || {}).$input || {};\nvar requestedStripe = String(inputObj.stripeCd || restInput.stripeCd || '').trim().toUpperCase();\nvar invalidStripeCd = '';\nif (requestedStripe && requestedStripe !== 'ORA_SVC_CRM' && requestedStripe !== 'ORA_SVC_HCM' && requestedStripe !== 'ORA_SVC_HRHD') {\n  invalidStripeCd = requestedStripe;\n}\nvar selectedItems = (($context.$nodes.SELECT_TOP_ITEMS || {}).$output || {}).result || [];\nvar emails = (($context.$nodes.BUILD_SELECTED_EMAIL_REFERENCES || {}).$output || {}).result || [];\nvar chats = (($context.$nodes.GET_SELECTED_CHAT_REFERENCES || {}).$output || {}).result || [];\nvar srs = (($context.$nodes.GET_ENRICHED_SELECTED_SR_REFERENCES || {}).$output || {}).result || [];\nvar referencesByKey = {};\nvar limited = [];\nvar i = 0;\nvar result = '';\nif (invalidStripeCd) {\n  result = 'Invalid stripeCd: ' + invalidStripeCd + '. Supported values are ORA_SVC_CRM and ORA_SVC_HCM.';\n} else {\n  for (i = 0; i < emails.length; i++) {\n    if (emails[i] && emails[i].itemKey && emails[i].text) {\n      referencesByKey[emails[i].itemKey] = emails[i].text;\n    }\n  }\n  for (i = 0; i < chats.length; i++) {\n    if (chats[i] && chats[i].itemKey && chats[i].text) {\n      referencesByKey[chats[i].itemKey] = chats[i].text;\n    }\n  }\n  for (i = 0; i < srs.length; i++) {\n    if (srs[i] && srs[i].itemKey && srs[i].text) {\n      referencesByKey[srs[i].itemKey] = srs[i].text;\n    }\n  }\n  for (i = 0; i < selectedItems.length; i++) {\n    if (selectedItems[i] && referencesByKey[selectedItems[i].itemKey]) {\n      limited.push(referencesByKey[selectedItems[i].itemKey]);\n    }\n  }\n  if (limited.length === 0) {\n    result = 'No Service Requests or interactions were found in the last 90 days';\n  } else {\n    result = limited.join('\\n---\\n');\n  }\n}\nreturn result;"
          },
