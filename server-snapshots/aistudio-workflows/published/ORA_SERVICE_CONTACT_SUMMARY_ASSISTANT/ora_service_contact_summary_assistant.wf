                    "sourceCode": "var messages = $context.$nodes.GET_CHAT_TRANSCRIPT.$output.items || [];\nvar parts = [];\nvar i = 0;\nfor (i = messages.length - 1; i >= 0; i--) {\n  if (messages[i].MessageContent) {\n    parts.push(\"[\" + messages[i].MessageDate + \"] \" + messages[i].PartyName + \" - \" + messages[i].SenderType + \" - \" + messages[i].MessageTypeCd + \"\\n\" + messages[i].MessageContent + \"\\n\");\n  }\n}\nreturn parts.join(\"\\n\");"
