            "name": "Build Transcript Summary Map",
            "language": "JAVASCRIPT",
            "returnType": "object",
            "sourceCode": "var pendingChats = $context.$nodes.NON_SUMMARIZED_SELECTED_CHATS.$output.result || [];\nvar loopOutput = $context.$nodes.FOR_EACH_SUMMARIZE_CHAT.$output || [];\nvar result = {};\nvar i = 0;\nfor (i = 0; i < pendingChats.length && i < loopOutput.length; i++) {\n  var summaryValue = loopOutput[i];\n  try {\n    summaryValue = JSON.parse(summaryValue);\n    if (summaryValue && summaryValue.output !== undefined) { summaryValue = summaryValue.output; }\n    else if (summaryValue && summaryValue.result !== undefined) { summaryValue = summaryValue.result; }\n  } catch (error) {\n  }\n  if (summaryValue !== undefined && summaryValue !== null) {\n    result[pendingChats[i].interactionId] = String(summaryValue).replace(/\\s+/g, ' ').trim();\n  }\n}\nreturn result;"
          },
          "outcomes": {
            "success": "1776002325225"
          },
          "code": "BUILD_TRANSCRIPT_SUMMARY_MAP",
          "id": "1773254819617",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
