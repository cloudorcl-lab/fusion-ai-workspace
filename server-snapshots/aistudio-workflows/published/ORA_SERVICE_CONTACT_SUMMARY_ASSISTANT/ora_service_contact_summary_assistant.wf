        {
          "metadata": {
            "name": "Get Selected Chat And Call Ids",
            "language": "JAVASCRIPT",
            "returnType": "string",
            "sourceCode": "var selectedItems = $context.$nodes.SELECT_TOP_ITEMS.$output.result || [];\nvar values = [];\nvar selectedIds = \"'NO_SELECTED_INTERACTION'\";\nvar i = 0;\nfor (i = 0; i < selectedItems.length; i++) {\n  if ((selectedItems[i].itemType === 'chat' || selectedItems[i].itemType === 'call') && selectedItems[i].interactionId) {\n    values.push(\"'\" + selectedItems[i].interactionId + \"'\");\n  }\n}\nif (values.length > 0) {\n  selectedIds = values.join(',');\n}\nreturn selectedIds;"
          },
