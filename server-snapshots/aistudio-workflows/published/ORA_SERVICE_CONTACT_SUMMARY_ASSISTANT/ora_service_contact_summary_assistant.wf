            "language": "JAVASCRIPT",
            "returnType": "array",
            "sourceCode": "var items = $context.$nodes.GET_SELECTED_SRS.$output.result || [];\nvar loopOutput = $context.$nodes.FOR_EACH_SELECTED_SR_CONTEXT.$output || [];\nvar enrichedBySrNumber = {};\nvar result = [];\nvar i = 0;\nfor (i = 0; i < loopOutput.length; i++) {\n  try {\n    var parsed = JSON.parse(loopOutput[i]);\n    var value = parsed && parsed.result ? parsed.result : parsed;\n    if (value && value.srNumber) {\n      enrichedBySrNumber[value.srNumber] = value;\n    }\n  } catch (error) {\n  }\n}\nfor (i = 0; i < items.length; i++) {\n  if (items[i] && items[i].SrNumber && enrichedBySrNumber[items[i].SrNumber]) {\n    result.push(enrichedBySrNumber[items[i].SrNumber]);\n  } else {\n    var fallbackProblem = String(items[i].ProblemDescription || '-').replace(/\\s+/g, ' ').trim();\n    var fallbackResolution = String(items[i].ResolveDescription || '-').replace(/\\s+/g, ' ').trim();\n    if (fallbackProblem.length > 400) {\n      fallbackProblem = fallbackProblem.substring(0, 397) + '...';\n    }\n    if (fallbackResolution.length > 400) {\n      fallbackResolution = fallbackResolution.substring(0, 397) + '...';\n    }\n    result.push({\n      itemKey: items[i].itemKey || ('sr:' + (items[i].SrNumber || '')),\n      srNumber: items[i].SrNumber,\n      date: items[i].LastUpdateDate,\n      text: 'Service Request: ' + items[i].SrNumber + '\\nTitle: ' + (items[i].Title || '-') + '\\nProblem Description: ' + fallbackProblem + '\\nStatus: ' + (items[i].StatusCdMeaning || '-') + '\\nSeverity: ' + (items[i].SeverityCdMeaning || '-') + '\\nResolution: ' + fallbackResolution\n    });\n  }\n}\nreturn result;"
          },
          "outcomes": {
            "success": "1775090101001"
          },
