            "sourceCode": "var inputObj = $context.$input || {};\nvar restInput = (($context.$triggers || {}).REST || {}).$input || {};\nvar restInstructions = inputObj.instructions || restInput.instructions || '';\nvar userMessage = $context.$system.$inputMessage || '';\nvar raw = String(restInstructions || userMessage || '').replace(/\\s+/g, ' ').trim();\nif (raw.length > 500) { raw = raw.substring(0, 500); }\nreturn raw;"
          },
          "outcomes": {
