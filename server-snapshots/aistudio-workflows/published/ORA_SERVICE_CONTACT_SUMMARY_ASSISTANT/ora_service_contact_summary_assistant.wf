        {
          "metadata": {
            "name": "Get SR Candidates",
            "language": "JAVASCRIPT",
            "returnType": "array",
            "sourceCode": "var items = (($context.$nodes.GET_SRS.$output || {}).items) || [];\nvar requestContext = $context.$nodes.GET_DATE_FILTER.$output.result || {};\nvar cutoff = new Date(requestContext.lastUpdateDate || '').getTime();\nvar effectiveStripeCd = String(requestContext.effectiveStripeCd || 'ORA_SVC_CRM');\nvar result = [];\nvar i = 0;\nfor (i = 0; i < items.length; i++) {\n  var item = items[i] || {};\n  var date = item.LastUpdateDate || item.CreationDate || item.OpenDate || item.ClosedDate || '';\n  if (date && cutoff && !isNaN(cutoff) && new Date(date).getTime() < cutoff) {\n    continue;\n  }\n  item.itemKey = 'sr:' + (item.SrNumber || '');\n  item.itemType = 'sr';\n  item.srNumber = item.SrNumber || '';\n  item.stripeCd = item.StripeCd || effectiveStripeCd;\n  item.sourceEntity = 'serviceRequests';\n  item.date = date;\n  result.push(item);\n}\nreturn result;"
          },
          "outcomes": {
            "success": "1776002325222"
          },
          "code": "GET_SR_CANDIDATES",
          "id": "1776002325223",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
