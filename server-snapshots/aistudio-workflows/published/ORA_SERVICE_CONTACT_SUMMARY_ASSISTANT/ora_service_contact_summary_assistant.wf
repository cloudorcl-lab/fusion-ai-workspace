        {
          "metadata": {
            "name": "Get Selected Chat References",
            "language": "JAVASCRIPT",
            "returnType": "array",
            "sourceCode": "var selectedItems = $context.$nodes.SELECT_TOP_ITEMS.$output.result || [];\nvar wrapUps = (($context.$nodes.FETCH_WRAPUPS.$output || {}).items) || [];\nvar summaries = $context.$nodes.BUILD_TRANSCRIPT_SUMMARY_MAP.$output.result || {};\nvar result = [];\nvar i = 0;\nvar j = 0;\nfor (i = 0; i < selectedItems.length; i++) {\n  if (selectedItems[i].itemType !== 'chat' && selectedItems[i].itemType !== 'call') { continue; }\n  var wrapUp = null;\n  var notes = '-';\n  for (j = 0; j < wrapUps.length; j++) {\n    if (wrapUps[j].InteractionId === selectedItems[i].interactionId) { wrapUp = wrapUps[j]; break; }\n  }\n  if (wrapUp && (wrapUp.InteractionNotes || wrapUp.CallNotes || wrapUp.Problem || wrapUp.Solution)) {\n    var noteParts = [];\n    if (wrapUp.InteractionNotes) { noteParts.push('Interaction Notes: ' + String(wrapUp.InteractionNotes).replace(/\\s+/g, ' ').trim()); }\n    if (wrapUp.CallNotes) { noteParts.push('Call Notes: ' + String(wrapUp.CallNotes).replace(/\\s+/g, ' ').trim()); }\n    if (wrapUp.Problem) { noteParts.push('Problem: ' + String(wrapUp.Problem).replace(/\\s+/g, ' ').trim()); }\n    if (wrapUp.Solution) { noteParts.push('Solution: ' + String(wrapUp.Solution).replace(/\\s+/g, ' ').trim()); }\n    notes = noteParts.join(' | ');\n  } else if (summaries[selectedItems[i].interactionId]) {\n    notes = 'Transcript Summary: ' + summaries[selectedItems[i].interactionId];\n  }\n  result.push({ itemKey: selectedItems[i].itemKey, date: selectedItems[i].date, text: 'Channel: ' + (selectedItems[i].itemType === 'chat' ? 'Chat' : 'Phone') + '\\nStart: ' + (selectedItems[i].startTime || '-') + '\\nEnd: ' + (selectedItems[i].endTime || '-') + '\\nNotes: ' + notes + '\\nSR: ' + (selectedItems[i].srNumber || '-') });\n}\nreturn result;"
          },
