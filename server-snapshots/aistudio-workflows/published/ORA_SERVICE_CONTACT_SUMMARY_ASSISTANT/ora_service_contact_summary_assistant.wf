        {
          "metadata": {
            "name": "Get Request Context",
            "language": "JAVASCRIPT",
            "returnType": "object",
            "sourceCode": "var currentDate = $context.$system.$currentDate;\nvar dateObject = new Date(currentDate);\nvar inputObj = $context.$input || {};\nvar restInput = (($context.$triggers || {}).REST || {}).$input || {};\nvar requestedStripe = String(inputObj.stripeCd || restInput.stripeCd || '').trim().toUpperCase();\nvar effectiveStripeCd = 'ORA_SVC_CRM';\nvar invalidStripeCd = '';\nif (!requestedStripe) {\n  effectiveStripeCd = 'ORA_SVC_CRM';\n} else if (requestedStripe === 'ORA_SVC_CRM') {\n  effectiveStripeCd = 'ORA_SVC_CRM';\n} else if (requestedStripe === 'ORA_SVC_HCM' || requestedStripe === 'ORA_SVC_HRHD') {\n  effectiveStripeCd = 'ORA_SVC_HRHD';\n} else {\n  invalidStripeCd = requestedStripe;\n  effectiveStripeCd = '';\n}\nvar result = {\n  lastUpdateDate: dateObject.toISOString(),\n  effectiveStripeCd: effectiveStripeCd,\n  invalidStripeCd: invalidStripeCd,\n  additionalQ: invalidStripeCd ? \" and 1 = 0\" : (\" and StripeCd = '\" + effectiveStripeCd.replace(/'/g, \"''\") + \"'\")\n};\ndateObject.setDate(dateObject.getDate() - 90);\nresult.lastUpdateDate = dateObject.toISOString();\nreturn result;"
          },
