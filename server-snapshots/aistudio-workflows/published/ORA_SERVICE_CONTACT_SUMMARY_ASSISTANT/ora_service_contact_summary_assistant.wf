                {
                  "metadata": {
                    "name": "Build SR Reference",
                    "language": "JAVASCRIPT",
                    "returnType": "object",
                    "sourceCode": "var sr = $context.$nodes.FOR_EACH_SELECTED_SR_CONTEXT.$currentItem || {};\nvar messageOutput = $context.$nodes.FOR_EACH_SELECTED_SR_CONTEXT.GET_SR_MESSAGES.$output || {};\nvar messages = messageOutput.items || [];\nvar normalizedMessages = [];\nvar reference = null;\nvar i = 0;\nvar j = 0;\nfor (i = 0; i < messages.length; i++) {\n  if (messages[i] && messages[i].MessageContent) {\n    var role = 'Message';\n    var content = String(messages[i].MessageContent || '').replace(/\\s+/g, ' ').trim();\n    if (content.length > 280) {\n      content = content.substring(0, 277) + '...';\n    }\n    if (messages[i].MessageTypeCd === 'ORA_SVC_CUSTOMER_ENTRY') {\n      role = 'Customer';\n    } else if (messages[i].MessageTypeCd === 'ORA_SVC_RESPONSE') {\n      role = 'Support Engineer';\n    } else if (messages[i].MessageTypeCd === 'ORA_SVC_INTERNAL_NOTE') {\n      role = 'Internal Note';\n    } else if (messages[i].MessageTypeCd === 'ORA_SVC_NOTE') {\n      role = 'Note';\n    }\n    normalizedMessages.push({\n      date: messages[i].CreationDate || '',\n      role: role,\n      content: content\n    });\n  }\n}\nfor (i = 0; i < normalizedMessages.length; i++) {\n  for (j = i + 1; j < normalizedMessages.length; j++) {\n    if (new Date(normalizedMessages[j].date).getTime() < new Date(normalizedMessages[i].date).getTime()) {\n      var temp = normalizedMessages[i];\n      normalizedMessages[i] = normalizedMessages[j];\n      normalizedMessages[j] = temp;\n    }\n  }\n}\nif (normalizedMessages.length > 4) {\n  normalizedMessages = normalizedMessages.slice(normalizedMessages.length - 4);\n}\nvar problemDescription = String(sr.ProblemDescription || '-').replace(/\\s+/g, ' ').trim();\nvar resolution = String(sr.ResolveDescription || '').replace(/\\s+/g, ' ').trim();\nif (problemDescription.length > 400) {\n  problemDescription = problemDescription.substring(0, 397) + '...';\n}\nif (resolution.length > 400) {\n  resolution = resolution.substring(0, 397) + '...';\n}\nvar lines = [];\nlines.push('Service Request: ' + (sr.SrNumber || '-'));\nlines.push('Title: ' + (sr.Title || '-'));\nlines.push('Problem Description: ' + problemDescription);\nlines.push('Status: ' + (sr.StatusCdMeaning || '-'));\nlines.push('Severity: ' + (sr.SeverityCdMeaning || '-'));\nlines.push('Created: ' + (sr.CreationDate || '-'));\nlines.push('Last Updated: ' + (sr.LastUpdateDate || '-'));\nif (sr.OpenDate) {\n  lines.push('Opened: ' + sr.OpenDate);\n}\nif (sr.ClosedDate) {\n  lines.push('Closed: ' + sr.ClosedDate);\n}\nif (sr.AssigneePersonName) {\n  lines.push('Assignee: ' + sr.AssigneePersonName);\n}\nif (sr.QueueName) {\n  lines.push('Queue: ' + sr.QueueName);\n}\nif (sr.CriticalFlag) {\n  lines.push('Critical: ' + sr.CriticalFlag);\n}\nif (resolution) {\n  lines.push('Resolution: ' + resolution);\n}\nif (normalizedMessages.length > 0) {\n  lines.push('Recent Messages:');\n  for (i = 0; i < normalizedMessages.length; i++) {\n    lines.push('[' + normalizedMessages[i].date + '] ' + normalizedMessages[i].role + ': ' + normalizedMessages[i].content);\n  }\n} else {\n  lines.push('Recent Messages: None found');\n}\nreference = {\n  itemKey: sr.itemKey || ('sr:' + (sr.SrNumber || '')),\n  srNumber: sr.SrNumber || '',\n  date: sr.LastUpdateDate || sr.CreationDate || '',\n  text: lines.join('\\n')\n};\nreturn reference;"
                  },
                  "outcomes": {
                    "success": "end_1775083114201"
                  },
                  "code": "BUILD_SR_REFERENCE",
