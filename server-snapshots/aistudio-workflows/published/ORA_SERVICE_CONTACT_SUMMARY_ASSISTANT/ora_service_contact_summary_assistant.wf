            "returnType": "array",
            "sourceCode": "var selectedItems = $context.$nodes.SELECT_TOP_ITEMS.$output.result || [];\nvar wrapups = $context.$nodes.FETCH_WRAPUPS.$output || {};\nvar wrapupItems = wrapups.items || [];\nvar result = [];\nvar i = 0;\nvar j = 0;\nfor (i = 0; i < selectedItems.length; i++) {\n  if (selectedItems[i].itemType !== 'chat' || !selectedItems[i].chatId) {\n    continue;\n  }\n  var hasSummary = false;\n  for (j = 0; j < wrapupItems.length; j++) {\n    if (wrapupItems[j].InteractionId === selectedItems[i].interactionId && (wrapupItems[j].CallNotes || wrapupItems[j].InteractionNotes || wrapupItems[j].Problem || wrapupItems[j].Solution)) {\n      hasSummary = true;\n      break;\n    }\n  }\n  if (!hasSummary) {\n    result.push(selectedItems[i]);\n  }\n}\nreturn result;"
          },
