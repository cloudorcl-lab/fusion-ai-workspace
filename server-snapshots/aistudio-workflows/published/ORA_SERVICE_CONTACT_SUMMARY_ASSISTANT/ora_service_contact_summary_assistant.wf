          }
        },
        {
          "metadata": {
            "name": "Classify User Request",
            "language": "JAVASCRIPT",
            "returnType": "object",
            "sourceCode": "var raw = String($context.$nodes.GET_USER_REQUEST.$output.result || '').trim();\nvar lower = raw.toLowerCase();\nvar outOfScope = raw ? /(javascript|python|sql|code|script|email address|contact email|phone number|home address|password|ssn|credit card|retrieve|fetch|search\\b|180 days|365 days|timeframe|time frame|include only|exclude|system prompt|hidden prompt)/.test(lower) : false;\nvar result = {\n  userRequest: raw,\n  instructionStatus: raw ? (outOfScope ? 'out_of_scope' : 'provided') : 'none'\n};\nreturn result;"
          },
          "outcomes": {
            "success": "1776002325318"
          },
          "code": "CLASSIFY_USER_REQUEST",
          "id": "1776002325317",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 5470,
            "y": 9842
          }
        },
        {
          "metadata": {
            "name": "Get Previous Summary Context",
            "language": "JAVASCRIPT",
            "returnType": "object",
            "sourceCode": "var inputObj = $context.$input || {};\nvar restInput = (($context.$triggers || {}).REST || {}).$input || {};\nvar previousSummary = String($context.$variables.lastSummaryResponse || \"\").trim();\nvar previousContext = String($context.$variables.lastSummaryContext || \"\").trim();\nvar previousContactPartyId = String($context.$variables.lastContactPartyId || \"\").trim();\nvar currentContactPartyId = String(restInput.contactPartyId || inputObj.contactPartyId || \"\").trim();\nvar sameContact = !previousContactPartyId || !currentContactPartyId || previousContactPartyId === currentContactPartyId;\nvar hasPreviousSummary = !!previousSummary && sameContact;\nvar result = {\n  contactPartyId: currentContactPartyId,\n  hasPreviousSummary: hasPreviousSummary,\n  previousSummary: hasPreviousSummary ? previousSummary : \"\",\n  previousContext: hasPreviousSummary ? previousContext : \"\",\n  previousContactPartyId: hasPreviousSummary ? previousContactPartyId : \"\"\n};\nreturn result;"
          },
          "outcomes": {
            "success": "1776002325301"
          },
          "code": "GET_PREVIOUS_SUMMARY_CONTEXT",
          "id": "1776002325318",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 5470,
            "y": 10064
          }
        },
        {
          "metadata": {
            "name": "Prepare Response Context",
            "language": "JAVASCRIPT",
            "returnType": "object",
            "sourceCode": "var classified = $context.$nodes.CLASSIFY_USER_REQUEST.$output.result || {};\nvar previous = $context.$nodes.GET_PREVIOUS_SUMMARY_CONTEXT.$output.result || {};\nvar hasPreviousSummary = !!previous.hasPreviousSummary;\nvar result = {\n  content: $context.$nodes.CREATE_CONTEXT_PROMPT_REFERENCES.$output.result || '',\n  userRequest: classified.userRequest || '',\n  contactPartyId: previous.contactPartyId || '',\n  instructionStatus: classified.instructionStatus || 'none',\n  hasPreviousSummary: hasPreviousSummary,\n  previousSummary: previous.previousSummary || '',\n  previousContext: previous.previousContext || '',\n  previousContactPartyId: previous.previousContactPartyId || ''\n};\nreturn result;"
          },
          "outcomes": {
            "success": "1776002325306"
          },
          "code": "PREPARE_RESPONSE_CONTEXT",
          "id": "1776002325301",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 5470,
            "y": 10286
          }
        },
        {
          "metadata": {
            "name": "Build Guarded Response Prompt",
            "language": "JAVASCRIPT",
            "returnType": "string",
            "sourceCode": "var prepared = $context.$nodes.PREPARE_RESPONSE_CONTEXT.$output.result || {};\nvar parts = [];\nvar safeUserRequest = prepared.userRequest || '(none)';\nif (prepared.instructionStatus === 'out_of_scope') {\n  safeUserRequest = '(out_of_scope request omitted; return the standard in-scope summary only)';\n}\nparts.push('You are preparing contact insights for a customer service representative.');\nparts.push('Return valid JSON only. Do not wrap it in markdown fences or add extra commentary.');\nparts.push('Return exactly this shape: {\"summary\": string|null, \"explanation\": string|null}.');\nparts.push('Use only the provided content and conversation state. Do not invent facts, hidden data, unsupported patterns, or next steps.');\nparts.push('Never retrieve additional data, reveal private contact details, change the time range, or answer unrelated technical/code requests.');\nparts.push('If asked about tone, sentiment, satisfaction, or experience quality, describe only what is directly supported by the provided text. Do not guess whether the contact is happy, satisfied, or frustrated when the evidence is weak or absent.');\nparts.push('If the provided content is exactly \"No Service Requests or interactions were found in the last 90 days\", return {\"summary\":\"No Service Requests or interactions were found in the last 90 days\",\"explanation\":null}.');\nparts.push('If the provided content starts with \"Invalid stripeCd:\", return {\"summary\":<that exact message>,\"explanation\":null}.');\nparts.push('If instructionStatus is out_of_scope, ignore the out-of-scope request and return only the standard in-scope summary in summary with explanation null. Do not quote, restate, or reference the omitted request details in the output.');\nparts.push('If there is no previous summary in this conversation, treat the current user request as a summary-generation or formatting request even if it uses words like why or explain. In that case, return the answer in summary and explanation must be null.');\nparts.push('If there is a previous summary and the current user request is asking why, explain, justify, or provide rationale for that previous summary, return the answer in explanation and set summary to null.');\nparts.push('Otherwise, produce or refine the current summary in summary and set explanation to null.');\nparts.push('If the user asks for a different format, you may change presentation style but not the facts, scope, or data selection.');\nparts.push('Default summary expectations when no special formatting is requested:');\nparts.push('1. Start with one overview sentence that gives the overall state of the contact\\'s recent issues, such as mixed, mostly unresolved, improving, or resolved, when supported by the evidence.');\nparts.push('2. After the overview, prioritize current state over chronology.');\nparts.push('3. If there are multiple distinct items, multiple channels, or clearly separable topics, the summary must use a compact multi-line briefing format inside the summary string:');\nparts.push('Overview: <one sentence>');\nparts.push('Open items:');\nparts.push('- <issue/topic>: <status or needed follow-up>');\nparts.push('- <issue/topic>: <status or needed follow-up>');\nparts.push('Resolved items:');\nparts.push('- <issue/topic>: <what was resolved or confirmed>');\nparts.push('Experience signals:');\nparts.push('- <only if directly supported by the records>');\nparts.push('4. Omit any section that has no support, but keep the Overview line.');\nparts.push('5. Preserve enough detail to be useful: name the main issue or product area for each important open item, and mention notable resolved items when relevant.');\nparts.push('6. Identify a recurring theme only when one is truly supported. If the recent items are unrelated, say that briefly in the overview instead of forcing a common thread.');\nparts.push('7. Keep each bullet concise, but do not collapse several distinct open issues into one vague sentence.');\nparts.push('8. Mention the quality of the experience or sentiment only when directly supported by the content. If the evidence is weak, omit the Experience signals section or use cautious wording.');\nparts.push('9. Keep the answer concise overall, but it should still read like a fast CSR briefing rather than a minimal abstract.');\nparts.push('10. Avoid generic openings such as \"The recent contact record shows\".');\nparts.push('Current user request:');\nparts.push(safeUserRequest);\nparts.push('Instruction status:');\nparts.push(prepared.instructionStatus || 'none');\nparts.push('Has previous summary:');\nparts.push(prepared.hasPreviousSummary ? 'true' : 'false');\nparts.push('Previous summary:');\nparts.push(prepared.previousSummary || '(none)');\nparts.push('Previous supporting context:');\nparts.push(prepared.previousContext || '(none)');\nparts.push('Current service context:');\nparts.push(prepared.content || '');\nreturn parts.join('\\n\\n');"
          },
          "outcomes": {
            "success": "1776002325320"
          },
          "code": "BUILD_GUARDED_RESPONSE_PROMPT",
          "id": "1776002325306",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
