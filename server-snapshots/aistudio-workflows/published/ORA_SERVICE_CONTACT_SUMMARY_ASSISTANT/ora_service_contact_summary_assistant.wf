        {
          "metadata": {
            "name": "Get Interaction Candidates",
            "language": "JAVASCRIPT",
            "returnType": "array",
            "sourceCode": "var t = (($context.$nodes.GET_INTERACTIONS.$output || {}).items) || [];\nvar requestContext = $context.$nodes.GET_DATE_FILTER.$output.result || {};\nvar c = new Date(requestContext.lastUpdateDate || '').getTime();\nvar effectiveStripeCd = String(requestContext.effectiveStripeCd || 'ORA_SVC_CRM');\nvar r = [];\nvar v = {};\nvar i = 0;\nvar j = 0;\nfor (i = 0; i < t.length; i++) {\n  var a = t[i] || {};\n  var f = ((a.interactionReferences || {}).items) || [];\n  var n = '';\n  var h = '';\n  var y = '';\n  var d = a.LastUpdateDate || a.EndTime || a.StartTime || '';\n  if (d && c && !isNaN(c) && new Date(d).getTime() < c) {\n    continue;\n  }\n  for (j = 0; j < f.length; j++) {\n    var x = f[j] || {};\n    if (!n && x.ObjectTypeCd === 'SVC_SERVICE_REQUESTS') {\n      n = x.ObjectNumber || '';\n    }\n    if (!h && x.ObjectTypeCd === 'SVC_CHATS') {\n      h = x.ObjectId || '';\n    }\n  }\n  if (a.ChannelTypeCd === 'ORA_SVC_EMAIL') {\n    y = 'email';\n  } else if (a.ChannelTypeCd === 'ORA_SVC_CHAT') {\n    y = 'chat';\n  } else if (a.ChannelTypeCd === 'ORA_SVC_PHONE') {\n    y = 'call';\n  }\n  if (y && a.InteractionId && !v[a.InteractionId]) {\n    v[a.InteractionId] = 1;\n    r.push({\n      itemKey: 'interaction:' + (a.InteractionId || ''),\n      itemType: y,\n      interactionId: a.InteractionId || '',\n      date: d,\n      startTime: a.StartTime || '',\n      endTime: a.EndTime || '',\n      directionCd: a.DirectionCd || '',\n      srNumber: n,\n      chatId: h,\n      stripeCd: effectiveStripeCd\n    });\n  }\n}\nfor (i = 0; i < r.length; i++) {\n  for (j = i + 1; j < r.length; j++) {\n    if (new Date(r[j].date).getTime() > new Date(r[i].date).getTime()) {\n      a = r[i];\n      r[i] = r[j];\n      r[j] = a;\n    }\n  }\n}\nreturn r;"
          },
          "outcomes": {
            "success": "1776002325222"
          },
          "code": "GET_INTERACTION_CANDIDATES",
          "id": "1770841459622",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 5245,
            "y": 6143
          }
