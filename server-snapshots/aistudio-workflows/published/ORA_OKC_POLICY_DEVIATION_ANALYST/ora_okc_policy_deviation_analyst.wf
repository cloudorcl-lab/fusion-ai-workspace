            }
          ]
        },
        {
          "id": "1775819705349",
          "code": "GET_DEVIATION_POLICY_RULES",
          "type": "CODE",
          "metadata": {
            "name": "Get Deviation Policy Rules",
            "sourceCode": "const startedAt = Date.now();\nconst contractId = $context.$variables.contractId || null;\nlet result;\nlet status = 'ok';\nlet errorMessage = null;\n\ntry {\n  const isProcurement = $context.$nodes?.IS_PROCUREMENT_CONTRACT?.$output === true;\n  result = isProcurement\n    ? $context.$nodes?.PROCUREMENT_CONTRACT_DEVIATION_POLICY?.$output || []\n    : $context.$nodes?.SALES_CONTRACT_DEVIATION_POLICY?.$output || [];\n\n  const ruleCount = Array.isArray(result) ? result.length : 0;\n  console.log(JSON.stringify({\n    node: 'GET_DEVIATION_POLICY_RULES',\n    event: 'policy_rules_selected',\n    contractId,\n    counts: { ruleCount },\n    durationMs: Date.now() - startedAt,\n    status: 'ok',\n    error: null\n  }));\n} catch (error) {\n  status = 'error';\n  errorMessage = String(error?.message || error);\n  result = [];\n  console.log(JSON.stringify({\n    node: 'GET_DEVIATION_POLICY_RULES',\n    event: 'policy_rules_selected',\n    contractId,\n    counts: { ruleCount: 0 },\n    durationMs: Date.now() - startedAt,\n    status,\n    error: errorMessage\n  }));\n}\n\nreturn result;",
            "returnType": "object"
          },
          "diagram": {
            "x": 5295.5,
            "y": 6538
          },
          "outcomes": {
            "success": "1777003000104"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1777003000104",
          "code": "VALIDATE_DEVIATION_POLICY_RULES",
          "type": "CODE",
          "metadata": {
            "name": "Validate Deviation Policy Rules",
            "returnType": "object",
            "sourceCode": "const rules = $context.$nodes.GET_DEVIATION_POLICY_RULES.$output?.result;\n\nconst REQUIRED_HEADERS = [\n  'clause_title',\n  'rule_code',\n  'rule_description',\n  'standard_position',\n  'contract_type'\n];\n\nconst OPTIONAL_HEADERS = [\n  'standard_clause_number'\n];\n\nconst ALLOWED_RISKS = ['no risk', 'low risk', 'medium risk', 'high risk', 'critical'];\nconst ALLOWED_APPROVALS = ['yes', 'no'];\n\nconst normalize = (value) => String(value ?? '').trim();\nconst isBlank = (value) => normalize(value) === '';\nconst dedupe = (items) => Array.from(new Set(items.filter(Boolean)));\n\nconst isAllowedHeader = (header) => {\n  if (REQUIRED_HEADERS.includes(header) || OPTIONAL_HEADERS.includes(header)) return true;\n  return /^fallback_(\\d+)_(position|clause_number|risk|approval|approval_authority)$/.test(header);\n};\n\n// No validation required when policy output is empty.\nif (!Array.isArray(rules) || rules.length === 0) {\n  return rules || [];\n}\n\nconst ruleObjects = rules.filter((item) => item && typeof item === 'object' && !Array.isArray(item));\nif (ruleObjects.length === 0) {\n  return [];\n}\n\nconst errors = [];\nconst groupedByContractType = new Map();\n\nfor (const row of ruleObjects) {\n  const contractType = normalize(row.contract_type) || 'Unknown';\n  if (!groupedByContractType.has(contractType)) {\n    groupedByContractType.set(contractType, []);\n  }\n  groupedByContractType.get(contractType).push(row);\n}\n\nfor (const [contractType, rows] of groupedByContractType.entries()) {\n  const missingRequiredHeaders = new Set();\n  const invalidHeaders = new Set();\n  const invalidMandatoryFields = new Set();\n\n  let hasFallbackPositionRiskPair = false;\n  let missingRiskForProvidedPosition = false;\n  let hasInvalidRiskValue = false;\n  let hasInvalidApprovalValue = false;\n\n  for (const row of rows) {\n    const rowHeaders = Object.keys(row);\n\n    // Required headers presence check per row.\n    for (const header of REQUIRED_HEADERS) {\n      if (!Object.prototype.hasOwnProperty.call(row, header)) {\n        missingRequiredHeaders.add(header);\n      }\n    }\n\n    // Allowed headers check per row.\n    for (const header of rowHeaders) {\n      if (!isAllowedHeader(header)) {\n        invalidHeaders.add(header);\n      }\n    }\n\n    // Mandatory fields value check per row.\n    for (const field of REQUIRED_HEADERS) {\n      if (isBlank(row[field])) {\n        invalidMandatoryFields.add(field);\n      }\n    }\n\n    // Evaluate fallback_* fields present in this row.\n    const fallbackIndexes = new Set();\n    for (const header of rowHeaders) {\n      const match = /^fallback_(\\d+)_/.exec(header);\n      if (match) fallbackIndexes.add(match[1]);\n    }\n\n    for (const index of fallbackIndexes) {\n      const positionValue = normalize(row[`fallback_${index}_position`]);\n      const riskValue = normalize(row[`fallback_${index}_risk`]);\n      const approvalValue = normalize(row[`fallback_${index}_approval`]);\n\n      // Risk dependency and validity are checked once in a single branch.\n      if (!isBlank(positionValue)) {\n        if (isBlank(riskValue)) {\n          missingRiskForProvidedPosition = true;\n        } else if (!ALLOWED_RISKS.includes(riskValue.toLowerCase())) {\n          hasInvalidRiskValue = true;\n        } else {\n          hasFallbackPositionRiskPair = true;\n        }\n      }\n\n      if (!isBlank(approvalValue) && !ALLOWED_APPROVALS.includes(approvalValue.toLowerCase())) {\n        hasInvalidApprovalValue = true;\n      }\n    }\n  }\n\n  if (missingRequiredHeaders.size > 0 || invalidHeaders.size > 0) {\n    const issueColumns = [...missingRequiredHeaders, ...invalidHeaders];\n    errors.push(\n      `Some required columns ${issueColumns.join(', ')} are missing or incorrectly named. Ensure headers exactly match the template for the contract type \"${contractType}\".`\n    );\n  }\n\n  if (invalidMandatoryFields.size > 0) {\n    errors.push(\n      `Mandatory fields ${Array.from(invalidMandatoryFields).join(', ')} are empty or invalid for the contract type \"${contractType}\". All mandatory fields must be completed for every row.`\n    );\n  }\n\n  if (missingRiskForProvidedPosition) {\n    errors.push(\n      `fallback_x_risk cannot be empty or null when the corresponding fallback_x_position is provided for the contract type \"${contractType}\".`\n    );\n  }\n\n  if (hasInvalidRiskValue) {\n    errors.push(\n      `Value for fallback_x_risk must be one of [No Risk, Low Risk, Medium Risk, High Risk, Critical] (case-insensitive) for the contract type \"${contractType}\".`\n    );\n  }\n\n  if (hasInvalidApprovalValue) {\n    errors.push(\n      `Value for fallback_x_approval must be Yes, No, or blank (case-insensitive) for the contract type \"${contractType}\".`\n    );\n  }\n\n  if (!hasFallbackPositionRiskPair) {\n    errors.push(\n      `At least one fallback position and risk pair is required for the contract type \"${contractType}\": fallback_1_position + fallback_1_risk (or equivalent).`\n    );\n  }\n}\n\nconst uniqueErrors = dedupe(errors);\nif (uniqueErrors.length > 0) {\n  throw new Error(`Playbook rules validation failed with the following errors:\\n- ${uniqueErrors.join('\\n- ')}`);\n}\n\nreturn rules;\n"
          },
          "outcomes": {
            "success": "1775190333182"
          },
          "inputs": [],
          "diagram": {
            "x": 5276,
            "y": 6760
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1775190333182",
          "code": "EXTRACT_UNIQUE_CLAUSE_NUMBERS",
          "type": "CODE",
          "metadata": {
            "name": "Extract Unique Clause Numbers",
            "sourceCode": "const startedAt = Date.now();\nconst contractId = $context.$variables.contractId || null;\nconst inputCollection = $context.$nodes.GET_DEVIATION_POLICY_RULES.$output.result;\n\nconst clauseNumbersSet = new Set();\nfor (const rule of inputCollection || []) {\n  if (rule.standard_clause_number && rule.standard_clause_number.trim() !== '') {\n    clauseNumbersSet.add(rule.standard_clause_number);\n  }\n  for (let i = 1; i <= 10; i++) {\n    const fallbackKey = `fallback_${i}_clause_number`;\n    if (rule[fallbackKey] && rule[fallbackKey].trim() !== '') {\n      clauseNumbersSet.add(rule[fallbackKey].trim());\n    }\n  }\n}\n\nconst uniqueClauseNumbers = Array.from(clauseNumbersSet);\nconsole.log(JSON.stringify({\n  node: 'EXTRACT_UNIQUE_CLAUSE_NUMBERS',\n  event: 'unique_clause_numbers_extracted',\n  contractId,\n  counts: {\n    ruleCount: Array.isArray(inputCollection) ? inputCollection.length : 0,\n    uniqueClauseNumberCount: uniqueClauseNumbers.length\n  },\n  durationMs: Date.now() - startedAt,\n  status: 'ok',\n  error: null\n}));\n\nconst result = { uniqueClauseNumbers };\nreturn result;",
            "returnType": "object"
          },
          "diagram": {
            "x": 5285,
            "y": 6982
          },
          "outcomes": {
            "success": "1775192967067"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
