                  "outputSpecification": "{\n  \"type\": \"object\",\n  \"required\": [\"clause_found\"],\n  \"properties\": {\n    \"clause_found\": {\n      \"type\": \"boolean\"\n    },\n    \"clause_title\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"allOf\": [\n    {\n      \"if\": {\n        \"properties\": {\n          \"clause_found\": { \"const\": true }\n        }\n      },\n      \"then\": {\n        \"required\": [\"clause_title\"]\n      }\n    }\n  ]\n}\n"
                },
                {
                  "id": "1777001000204",
                  "code": "MERGE_CLAUSE_RESOLUTION",
                  "type": "CODE",
                  "metadata": {
                    "name": "Merge Clause Resolution",
                    "sourceCode": "const startedAt = Date.now();\nconst contractId = $context.$variables.contractId || null;\nconst currentItem = $context.$nodes.LOOP_RESOLVE_RULE_CLAUSE_TITLES.$currentItem || {};\nconst ruleCode = (currentItem.rule_code || '').trim();\nconst ruleClauseTitle = (currentItem.rule_clause_title || '').trim();\nconst deterministic = $context.$nodes.MATCH_CLAUSE_TITLE_DETERMINISTIC.$output?.result || {};\nconst fallback = $context.$nodes.EXTRACT_CLAUSE_FALLBACK_LLM?.$output || {};\nconst clauseMap = $context.$nodes.SAFE_PARSE_TITTLE_TEXT_MAP.$output?.result || {};\n\nlet result = {\n  rule_code: ruleCode,\n  rule_clause_title: ruleClauseTitle,\n  clause_found: false,\n  clause_title: null,\n  clause_text: null,\n  match_type: 'none'\n};\n\nlet fallbackKeyExistsInMap = false;\n\n// Prefer deterministic match; use LLM fallback only on deterministic miss.\nif (deterministic?.clause_found === true) {\n  result = {\n    rule_code: ruleCode,\n    rule_clause_title: ruleClauseTitle,\n    clause_found: true,\n    clause_title: deterministic.clause_title,\n    clause_text: deterministic.clause_text,\n    match_type: deterministic.match_type || 'exact'\n  };\n} else if (fallback?.clause_found === true) {\n  const fallbackClauseTitle = (fallback?.clause_title || '').trim();\n  fallbackKeyExistsInMap =\n    Boolean(fallbackClauseTitle) &&\n    clauseMap &&\n    typeof clauseMap === 'object' &&\n    !Array.isArray(clauseMap) &&\n    Object.prototype.hasOwnProperty.call(clauseMap, fallbackClauseTitle);\n\n  if (fallbackKeyExistsInMap) {\n    result = {\n      rule_code: ruleCode,\n      rule_clause_title: ruleClauseTitle,\n      clause_found: true,\n      clause_title: fallbackClauseTitle,\n      clause_text: clauseMap[fallbackClauseTitle],\n      match_type: 'llm_fallback'\n    };\n  }\n}\n\nconsole.log(JSON.stringify({\n  node: 'MERGE_CLAUSE_RESOLUTION',\n  event: 'clause_resolution_merged',\n  contractId,\n  rule_code: ruleCode,\n  clause_title: ruleClauseTitle,\n  match_type: result.match_type,\n  fallback_key_exists_in_map: fallbackKeyExistsInMap,\n  durationMs: Date.now() - startedAt,\n  status: result.clause_found ? 'resolved' : 'not_found',\n  error: null\n}));\n\nreturn result;\n",
                    "returnType": "object"
                  },
