        {
          "id": "1775191387792",
          "code": "AGGREGATE_FETCHED_ARTICLETEXTS",
          "type": "CODE",
          "metadata": {
            "name": "Aggregate Fetched ArticleTexts",
            "sourceCode": "const startedAt = Date.now();\nconst contractId = $context.$variables.contractId || null;\nconst fetchedItems = $context.$nodes.LOOP_OVER_UNIQUE_CLAUSE_NUMBERS.$output;\nconst expectedClauseNumbersRaw = $context.$nodes.EXTRACT_UNIQUE_CLAUSE_NUMBERS.$output?.result?.uniqueClauseNumbers || [];\n\nconst expectedClauseNumbers = Array.isArray(expectedClauseNumbersRaw)\n  ? expectedClauseNumbersRaw.map((v) => String(v || '').trim()).filter((v) => v !== '')\n  : [];\n\nconst clauseTextMap = {};\nlet parsedCount = 0;\n\nfor (const itemAny of fetchedItems || []) {\n  if (!itemAny) continue;\n\n  let item = itemAny;\n  if (typeof itemAny === 'string') {\n    try {\n      item = JSON.parse(itemAny);\n    } catch (e) {\n      continue;\n    }\n  }\n\n  if (item && item.result && typeof item.result === 'object' && !Array.isArray(item.result)) {\n    const entries = Object.entries(item.result);\n    if (entries.length === 1) {\n      const [clauseNumber, articleText] = entries[0];\n      clauseTextMap[clauseNumber] = articleText;\n      parsedCount += 1;\n    }\n  }\n}\n\nconst foundClauseNumbers = new Set(Object.keys(clauseTextMap));\nconst missingClauseNumbers = expectedClauseNumbers.filter((num) => !foundClauseNumbers.has(num));\n\nif (missingClauseNumbers.length > 0) {\n  throw new Error(`Library clause not found for clause numbers ${missingClauseNumbers.join(', ')}.`);\n}\n\nconsole.log(JSON.stringify({\n  node: 'AGGREGATE_FETCHED_ARTICLETEXTS',\n  event: 'article_texts_aggregated',\n  contractId,\n  counts: {\n    fetchedItemsCount: Array.isArray(fetchedItems) ? fetchedItems.length : 0,\n    expectedClauseNumberCount: expectedClauseNumbers.length,\n    mappedClauseTextCount: Object.keys(clauseTextMap).length,\n    parsedCount\n  },\n  durationMs: Date.now() - startedAt,\n  status: 'ok',\n  error: null\n}));\n\nreturn clauseTextMap;\n",
            "returnType": "object"
          },
          "diagram": {
            "x": 5280.5,
            "y": 7924
          },
          "outcomes": {
            "success": "1777001000101"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1777001000101",
          "code": "BUILD_UNIQUE_RULE_CLAUSE_TITLES",
          "type": "CODE",
          "metadata": {
            "name": "Build Unique Rule Clause Titles",
            "sourceCode": "const startedAt = Date.now();\nconst contractId = $context.$variables.contractId || null;\nconst rules = $context.$nodes.GET_DEVIATION_POLICY_RULES.$output?.result || [];\nconst clauseTextMap = $context.$nodes.AGGREGATE_FETCHED_ARTICLETEXTS.$output?.result || {};\n\nconst inputRules = Array.isArray(rules) ? rules : [];\nconst inputs = [];\nlet missingStandardTextCount = 0;\n\n// Build one resolution work item per rule_code so matching stays rule-specific.\nfor (const rule of inputRules) {\n  const ruleCode = (rule?.rule_code || '').trim();\n  const ruleClauseTitle = (rule?.clause_title || '').trim();\n  const standardClauseNumber = (rule?.standard_clause_number || '').trim();\n  const standardClauseText = clauseTextMap[standardClauseNumber] || null;\n\n  if (!standardClauseText) {\n    missingStandardTextCount += 1;\n  }\n\n  inputs.push({\n    rule_code: ruleCode,\n    rule_clause_title: ruleClauseTitle,\n    standard_clause_number: standardClauseNumber,\n    standard_clause_text: standardClauseText\n  });\n}\n\nconsole.log(JSON.stringify({\n  node: 'BUILD_UNIQUE_RULE_CLAUSE_TITLES',\n  event: 'built_rule_resolution_inputs',\n  contractId,\n  counts: {\n    rulesCount: inputRules.length,\n    ruleResolutionInputCount: inputs.length,\n    missingStandardTextCount\n  },\n  durationMs: Date.now() - startedAt,\n  status: 'ok',\n  error: null\n}));\n\nconst result = { ruleResolutionInputs: inputs };\nreturn result;\n",
            "returnType": "object"
          },
          "diagram": {
            "x": 5276,
