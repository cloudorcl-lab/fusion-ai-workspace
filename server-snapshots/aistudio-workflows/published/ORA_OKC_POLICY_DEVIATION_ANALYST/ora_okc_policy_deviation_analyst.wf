        {
          "id": "1774866388116",
          "code": "EXTRACT_CONTRACT_METADATA_ATTRIBUTES_VALUES",
          "type": "CODE",
          "metadata": {
            "description": "Return the contract metadata attributes such as ContractNumber, ContractTypeName.",
            "name": "Extract Contract Metadata Attributes Values",
            "sourceCode": "let result = {\n  ContractNumber: \"\",\n  ContractTypeName: \"\"\n};\ntry {\n  const contractDetails = $context.$nodes?.GET_CONTRACT_DETAILS?.$output || {};\n  const contractNumber = contractDetails.ContractNumber;\n  const contractTypeName = contractDetails.ContractTypeName;\n  const documentType = contractDetails.DocumentType;\n  const buyOrSell = contractDetails.BuyOrSell;\n  const perspective = buyOrSell == \"B\" ? \"BUYER\" : \"SUPPLIER\";\n  const orgId = Number(contractDetails.OrgId);\n  result = {\n    ContractNumber: contractNumber,\n    ContractTypeName: contractTypeName,\n    Perspective: perspective,\n    DocumentType: documentType,\n    BuyOrSell: buyOrSell,\n    OrgId: orgId\n  };\n}\ncatch( error) {\n  result = {\n    ContractNumber: \"\",\n    ContractTypeName: \"\",\n    Perspective: \"\",\n    DocumentType: \"\",\n    BuyOrSell: \"\",\n    OrgId: \"\"\n  };\n}\nreturn result;",
            "returnType": "object"
          },
          "diagram": {
            "x": 5222,
            "y": 5872
          },
          "outcomes": {
            "success": "1775819558442"
          },
