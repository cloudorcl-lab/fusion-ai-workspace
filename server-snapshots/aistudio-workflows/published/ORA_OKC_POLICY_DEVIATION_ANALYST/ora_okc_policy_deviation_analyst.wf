                      "value": "Rule Clause Title:\n{{$context.$nodes.LOOP_RESOLVE_RULE_CLAUSE_TITLES.$currentItem.rule_clause_title}}\n\nStandard Clause Text (semantic anchor):\n{{$context.$nodes.LOOP_RESOLVE_RULE_CLAUSE_TITLES.$currentItem.standard_clause_text}}\n\nContract Clause Map JSON:\n{{$context.$nodes.SAFE_PARSE_TITTLE_TEXT_MAP.$output.result}}\n\nOutput JSON:\n{\n  \"clause_found\": true|false,\n  \"clause_title\": \"<exact key from map when found>\"\n}"
