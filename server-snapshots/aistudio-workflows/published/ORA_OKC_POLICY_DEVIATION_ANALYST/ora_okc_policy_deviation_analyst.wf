            "loopType": "PARALLEL"
          },
          "diagram": {
            "x": 5023.297074901863,
            "y": 9552.572211567705,
            "width": 802,
            "height": 2124
          },
          "outcomes": {
            "success": "1775062818118"
          },
          "inputs": [
            {
              "id": "1774596404743_collection",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.GET_DEVIATION_POLICY_RULES.$output.result}}"
            }
          ]
        },
        {
          "id": "1775062818118",
          "code": "GROUP_BY_DOC_CLAUSE_TITLE",
          "type": "CODE",
          "metadata": {
            "name": "Group By Doc Clause Title",
            "sourceCode": "let result = [];\nlet errorMessage = null;\ntry {\n  const severityRank = {\n    \"4_CRITICAL\": 4,\n    \"3_HIGH_RISK\": 3,\n    \"2_MEDIUM_RISK\": 2,\n    \"1_LOW_RISK\": 1,\n    \"0_NO_RISK\": 0\n  };\n\n  // Parse loop outputs and keep only successfully parsed items.\n  const rawStrings = $context.$nodes?.FOR_EVERY_RULES?.$output || [];\n  const parsedItems = rawStrings\n    .map((str) => {\n      try {\n        return JSON.parse(str).result;\n      } catch (e) {\n        return null;\n      }\n    })\n    .filter((item) => item !== null);\n\n  // Keep only items that produce a policy deviation; NOT_APPLICABLE items are excluded.\n  const validItems = parsedItems.filter((item) => {\n    if (!item || !item.policy_deviation) return false;\n    return item.policy_deviation.matched_position_code !== 'NOT_APPLICABLE';\n  });\n\n  // Count rules explicitly marked as NOT_APPLICABLE by upstream logic.\n  const notApplicableCount = parsedItems.filter((item) => item?.reason === 'NOT_APPLICABLE').length;\n\n  let clauseTitleTextMap = $context.$nodes.SAFE_PARSE_TITTLE_TEXT_MAP.$output.result ?? {};\n  const grouped = {};\n\n  // Group policy deviations by clause title.\n  for (const item of validItems) {\n    const clauseTitle = item.policy_deviation?.doc_clause_title || 'Unknown';\n    if (!grouped[clauseTitle]) {\n      grouped[clauseTitle] = [];\n    }\n\n    const polDev = { ...item.policy_deviation };\n    delete polDev.doc_clause_title;\n    polDev.policy_recommendations = item.policy_recommendations || [];\n    grouped[clauseTitle].push(polDev);\n  }\n\n  // Build final grouped payload and compute top severity per clause group.\n  result = Object.entries(grouped).map(([doc_clause_title, deviations]) => {\n    let highestSeverity = null;\n    let highestRank = 0;\n    for (const pd of deviations) {\n      const rank = severityRank[pd.severity_code] || 0;\n      if (rank > highestRank) {\n        highestRank = rank;\n        highestSeverity = pd.severity_code;\n      }\n    }\n\n    const doc_clause_text = clauseTitleTextMap[doc_clause_title] || '';\n    return {\n      doc_clause_title,\n      doc_clause_text,\n      severity_code: highestSeverity || '0_NO_RISK',\n      policy_deviations: deviations\n    };\n  });\n} catch (error) {\n  errorMessage = String(error?.message || error);\n  result = [];\n}\nreturn result;\n",
            "returnType": "array"
          },
          "diagram": {
            "x": 5295.5,
            "y": 12028
          },
          "outcomes": {
            "success": "1777003000102"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1777003000102",
          "code": "UPSERT_DEVIATING_CLAUSES_TO_DB",
          "type": "BO_FUNCTION",
