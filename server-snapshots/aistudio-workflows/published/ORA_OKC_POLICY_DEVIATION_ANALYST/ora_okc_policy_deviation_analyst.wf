        {
          "id": "1777001000103",
          "code": "AGGREGATE_RESOLVED_CLAUSE_LOOKUP",
          "type": "CODE",
          "metadata": {
            "name": "Aggregate Resolved Clause Lookup",
            "sourceCode": "const startedAt = Date.now();\nconst contractId = $context.$variables.contractId || null;\nconst rawItems = $context.$nodes.LOOP_RESOLVE_RULE_CLAUSE_TITLES.$output || [];\n\nconst lookup = {};\nconst counts = {\n  total: 0,\n  resolved: 0,\n  deterministicExact: 0,\n  deterministicCaseInsensitiveTrim: 0,\n  llmFallback: 0,\n  notFound: 0\n};\n\nfor (const rawItem of rawItems) {\n  let parsed = rawItem;\n  if (typeof rawItem === 'string') {\n    try {\n      parsed = JSON.parse(rawItem);\n    } catch (e) {\n      continue;\n    }\n  }\n\n  const item = parsed?.result || parsed || {};\n  const ruleCode = (item.rule_code || '').trim();\n  if (!ruleCode) {\n    continue;\n  }\n\n  counts.total += 1;\n  const clauseFound = item.clause_found === true;\n  const matchType = item.match_type || 'none';\n\n  // rule_code is the canonical lookup key consumed in FOR_EVERY_RULES.\n  lookup[ruleCode] = {\n    rule_code: ruleCode,\n    rule_clause_title: item.rule_clause_title || null,\n    clause_found: clauseFound,\n    clause_title: clauseFound ? (item.clause_title || item.rule_clause_title || null) : null,\n    clause_text: clauseFound ? (item.clause_text || null) : null,\n    match_type: matchType\n  };\n\n  if (clauseFound) {\n    counts.resolved += 1;\n  } else {\n    counts.notFound += 1;\n  }\n\n  if (matchType === 'exact') counts.deterministicExact += 1;\n  if (matchType === 'case_insensitive_trim') counts.deterministicCaseInsensitiveTrim += 1;\n  if (matchType === 'llm_fallback') counts.llmFallback += 1;\n}\n\nconsole.log(JSON.stringify({\n  node: 'AGGREGATE_RESOLVED_CLAUSE_LOOKUP',\n  event: 'resolved_clause_lookup_built',\n  contractId,\n  counts,\n  durationMs: Date.now() - startedAt,\n  status: 'ok',\n  error: null\n}));\n\nconst result = { lookup, counts };\nreturn result;\n",
            "returnType": "object"
          },
