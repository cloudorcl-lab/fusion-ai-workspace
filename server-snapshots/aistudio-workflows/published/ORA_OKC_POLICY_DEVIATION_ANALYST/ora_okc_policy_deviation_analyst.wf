                    {
                      "id": "1777003000101_prompt",
                      "name": "prompt",
                      "type": "string",
                      "value": "You are a legal applicability classifier.\n\nDecide whether the clause text materially addresses the legal topic/aspect represented by the policy rule positions.\n\nIMPORTANT:\n- Decide from clause text semantics, not clause title similarity.\n- The aspect may appear anywhere in clause text.\n- A rule is APPLICABLE if clause text includes substantive legal content on the same topic.\n- NOT APPLICABLE only if that topic is materially absent from clause text.\n\nINPUT CLAUSE TEXT:\n{{$context.$nodes.FOR_EVERY_RULES.EXTRACT_CLAUSE_FOR_CURRENT_RULE.$output.result.clause_text}}\n\nINPUT POLICY RULE JSON:\n{{$context.$nodes.FOR_EVERY_RULES.$currentItem}}\n\nReturn valid JSON only:\n{\n  \"is_applicable\": true|false,\n  \"reason\": \"<short reason>\"\n}"
                    }
                  ],
                  "outputSpecification": "{\n  \"type\": \"object\",\n  \"required\": [\"is_applicable\", \"reason\"],\n  \"properties\": {\n    \"is_applicable\": { \"type\": \"boolean\" },\n    \"reason\": { \"type\": \"string\" }\n  },\n  \"additionalProperties\": false\n}"
                },
