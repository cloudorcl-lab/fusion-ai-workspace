        {
          "id": "1775701164077",
          "code": "SAFE_PARSE_TITTLE_TEXT_MAP",
          "type": "CODE",
          "metadata": {
            "name": "Safe Parse Tittle Text Map",
            "sourceCode": "const startedAt = Date.now();\nconst contractId = $context.$variables.contractId || null;\nlet result = $context.$variables.clauseTitleTextMap;\nlet parseAttempts = 0;\nlet status = 'ok';\nlet errorMessage = null;\n\nwhile (typeof result === 'string') {\n  parseAttempts += 1;\n  try {\n    result = JSON.parse(result);\n  } catch (e) {\n    status = 'parse_error';\n    errorMessage = String(e?.message || e);\n    break;\n  }\n}\n\nconst keyCount = result && typeof result === 'object' && !Array.isArray(result)\n  ? Object.keys(result).length\n  : 0;\n\nconsole.log(JSON.stringify({\n  node: 'SAFE_PARSE_TITTLE_TEXT_MAP',\n  event: 'parse_complete',\n  contractId,\n  counts: { parseAttempts, keyCount },\n  durationMs: Date.now() - startedAt,\n  status,\n  error: errorMessage\n}));\n\nreturn result;",
            "returnType": "object"
          },
          "diagram": {
            "x": 5295.5,
            "y": 5428
          },
          "outcomes": {
            "success": "1774866179006"
          },
