                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "id": "1774596803231",
                  "code": "ADD_RECOM_TO_DEVIATION",
                  "type": "CODE",
                  "metadata": {
                    "name": "Add Recom To Deviation",
                    "sourceCode": "const startedAt = Date.now();\nconst contractId = $context.$variables.contractId || null;\nconst currentRule = $context.$nodes.FOR_EVERY_RULES.$currentItem || {};\nlet poldev = $context.$nodes.FOR_EVERY_RULES.DETERMINE_POLICY_POSITION.$output;\nconst recommendations = $context.$nodes.FOR_EVERY_RULES.NORMALIZE_RECOMMENDATIONS.$output.result;\npoldev.policy_recommendations = recommendations;\n\nconsole.log(JSON.stringify({\n  node: 'ADD_RECOM_TO_DEVIATION',\n  event: 'recommendations_attached',\n  contractId,\n  rule_code: currentRule.rule_code || null,\n  clause_title: currentRule.clause_title || null,\n  counts: {\n    recommendationCount: Array.isArray(recommendations) ? recommendations.length : 0\n  },\n  durationMs: Date.now() - startedAt,\n  status: 'ok',\n  error: null\n}));\n\nreturn poldev;",
                    "returnType": "object"
                  },
                  "diagram": {
                    "x": 5049.297074901863,
                    "y": 11569.572211567705
                  },
                  "outcomes": {
                    "success": "end_1774596404743"
                  },
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
