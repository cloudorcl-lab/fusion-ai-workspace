                {
                  "id": "1775208120104",
                  "code": "MAP_CLAUSE_NUMBER_TO_ARTICLE_TEXT",
                  "type": "CODE",
                  "metadata": {
                    "name": "Map Clause Number To Article Text",
                    "sourceCode": "let result = {};\n\n// Safely access the output of FETCH_CLAUSE_TEXT from LOOP_OVER_UNIQUE_CLAUSE_NUMBERS node\nconst fetchClauseTextOut = $context.$nodes?.FETCH_CLAUSE_TEXT?.$output;\nconst currentItem = $context.$nodes?.LOOP_OVER_UNIQUE_CLAUSE_NUMBERS?.$currentItem;\n\n// Keep existing positive behavior: use first returned item text when present.\nif (Array.isArray(fetchClauseTextOut?.items) && fetchClauseTextOut.items.length > 0 && currentItem !== undefined) {\n  result = { [currentItem]: fetchClauseTextOut.items[0].ArticleText };\n}\n\n// For unexpected/missing shapes, keep existing fallback behavior.\nreturn result;\n",
                    "returnType": "object"
                  },
