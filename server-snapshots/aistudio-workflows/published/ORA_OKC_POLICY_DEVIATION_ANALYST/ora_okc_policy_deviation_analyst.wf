                  "type": "CODE",
                  "metadata": {
                    "name": "Extract Clause For Current Rule",
                    "sourceCode": "const startedAt = Date.now();\nconst contractId = $context.$variables.contractId || null;\nconst currentRule = $context.$nodes.FOR_EVERY_RULES.$currentItem || {};\nconst ruleClauseTitle = (currentRule.clause_title || '').trim();\nconst ruleCode = (currentRule.rule_code || '').trim();\n\nconst lookup = $context.$nodes.AGGREGATE_RESOLVED_CLAUSE_LOOKUP.$output?.result?.lookup || {};\nconst resolved = lookup[ruleCode] || {\n  clause_found: false,\n  clause_title: null,\n  clause_text: null,\n  match_type: 'none'\n};\n\n// Keep return shape stable for downstream applicability/position/recommendation nodes.\nconst result = {\n  clause_found: resolved.clause_found === true,\n  clause_title: resolved.clause_title,\n  clause_text: resolved.clause_text\n};\n\nconsole.log(JSON.stringify({\n  node: 'EXTRACT_CLAUSE_FOR_CURRENT_RULE',\n  event: 'rule_clause_resolved',\n  contractId,\n  rule_code: ruleCode || null,\n  clause_title: ruleClauseTitle,\n  match_type: resolved.match_type || 'none',\n  durationMs: Date.now() - startedAt,\n  status: result.clause_found ? 'resolved' : 'not_found',\n  error: null\n}));\n\nreturn result;\n",
