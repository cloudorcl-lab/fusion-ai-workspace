              "value": "CONTRACT",
              "required": false,
              "type": "string"
            }
          ],
          "diagram": {
            "x": 5295.5,
            "y": 12250
          },
          "outputSpecification": ""
        },
        {
          "id": "1777003000103",
          "code": "RETURN_GROUPED_OUTPUT",
          "type": "CODE",
          "metadata": {
            "name": "Return Grouped Output",
            "returnType": "object",
            "sourceCode": "const startedAt = Date.now();\nconst contractId = $context.$variables.contractId || null;\nconst groupedResult = $context.$nodes.GROUP_BY_DOC_CLAUSE_TITLE.$output.result || [];\nconst upsertStatus = $context.$nodes.UPSERT_DEVIATING_CLAUSES_TO_DB.$output?.result || 'unknown';\n\n// Recompute summary in final node so it appears in final console output.\nconst rawStrings = $context.$nodes?.FOR_EVERY_RULES?.$output || [];\nconst parsedItems = rawStrings\n  .map((str) => {\n    try {\n      return JSON.parse(str).result;\n    } catch (e) {\n      return null;\n    }\n  })\n  .filter((item) => item !== null);\n\nconst validItems = parsedItems.filter((item) => {\n  if (!item || !item.policy_deviation) return false;\n  return item.policy_deviation.matched_position_code !== 'NOT_APPLICABLE';\n});\n\nconst notApplicableCount = parsedItems.filter((item) => item?.reason === 'NOT_APPLICABLE').length;\nconst outOfPolicyCount = validItems.filter((item) => item?.policy_deviation?.matched_position_code === 'OUT_OF_POLICY').length;\n\nconsole.log(JSON.stringify({\n  node: 'RETURN_GROUPED_OUTPUT',\n  event: 'final_output_ready',\n  contractId,\n  upsertStatus,\n  counts: {\n    perRuleEvaluations: parsedItems.length,\n    includedPolicyDeviationCount: validItems.length,\n    notApplicableCount,\n    outOfPolicyCount,\n    groupedClauseCount: Array.isArray(groupedResult) ? groupedResult.length : 0\n  },\n  durationMs: Date.now() - startedAt,\n  status: 'ok',\n  error: null\n}));\n\nconst result = {\n  upsert_status: upsertStatus,\n  result: groupedResult\n};\nreturn result;\n"
          },
          "outcomes": {
            "success": "end"
          },
          "inputs": [],
