                {
                  "id": "1777001000201",
                  "code": "MATCH_CLAUSE_TITLE_DETERMINISTIC",
                  "type": "CODE",
                  "metadata": {
                    "name": "Match Clause Title Deterministic",
                    "sourceCode": "const startedAt = Date.now();\nconst contractId = $context.$variables.contractId || null;\nconst currentItem = $context.$nodes.LOOP_RESOLVE_RULE_CLAUSE_TITLES.$currentItem || {};\nconst ruleCode = (currentItem.rule_code || '').trim();\nconst ruleClauseTitle = (currentItem.rule_clause_title || '').trim();\nconst clauseMap = $context.$nodes.SAFE_PARSE_TITTLE_TEXT_MAP.$output?.result || {};\n\nconst normalize = (value) => String(value || '').trim().toLowerCase();\n\nlet matchedTitle = null;\nlet matchType = 'none';\n\n// Deterministic pass: exact key first, then case-insensitive-trim key match.\nif (ruleClauseTitle && clauseMap && typeof clauseMap === 'object' && !Array.isArray(clauseMap)) {\n  if (Object.prototype.hasOwnProperty.call(clauseMap, ruleClauseTitle)) {\n    matchedTitle = ruleClauseTitle;\n    matchType = 'exact';\n  } else {\n    const normalizedRuleTitle = normalize(ruleClauseTitle);\n    for (const key of Object.keys(clauseMap)) {\n      if (normalize(key) === normalizedRuleTitle) {\n        matchedTitle = key;\n        matchType = 'case_insensitive_trim';\n        break;\n      }\n    }\n  }\n}\n\nconst clause_found = Boolean(matchedTitle);\nconst result = {\n  rule_code: ruleCode,\n  rule_clause_title: ruleClauseTitle,\n  clause_found,\n  clause_title: matchedTitle,\n  clause_text: matchedTitle ? clauseMap[matchedTitle] : null,\n  match_type: matchType\n};\n\nconsole.log(JSON.stringify({\n  node: 'MATCH_CLAUSE_TITLE_DETERMINISTIC',\n  event: 'deterministic_match',\n  contractId,\n  rule_code: ruleCode,\n  clause_title: ruleClauseTitle,\n  match_type: matchType,\n  durationMs: Date.now() - startedAt,\n  status: clause_found ? 'resolved' : 'miss',\n  error: null\n}));\n\nreturn result;\n",
                    "returnType": "object"
                  },
