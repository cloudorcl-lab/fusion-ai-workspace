          },
          "code": "INITIAL_PERMIT_HANDOFF",
          "convergenceTargetId": "end",
          "id": "1765431886577",
          "inputs": [
            {
              "id": "1765431886578_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.FIND_INITIAL_PERMIT_TYPE.$output.handoff_ready}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Collect Missing info"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "COLLECT_MISSING_INFO",
          "id": "1765432056037",
          "inputs": [
            {
              "id": "1765432056038_1",
              "name": "prompt",
              "type": "string",
              "value": "You are formatting responses for an end user applying for city permits.\n\nTake the following message generated by the Permit Advisor system and present it in a clear, friendly, and easy-to-read format.\n\nFormatting rules:\n- If the response contains multiple questions, present them as bullet points.\n- Each question should be on its own line.\n- Maintain the exact meaning of the original text.\n- Do not add new questions or modify the intent.\n- Use simple formatting for readability.\n- If there is only one question, present it as a single line without bullets.\n- Please show the title of the response as \"Permit Questions\"\n\nMessage to format:\n{{$context.$nodes.FIND_INITIAL_PERMIT_TYPE.$output.response_to_user}}"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Collect Information"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "COLLECT_INFORMATION",
          "id": "1765246662295",
          "inputs": [
            {
              "id": "1765246662296_1",
              "name": "prompt",
              "type": "string",
              "value": "You are formatting responses for an end user applying for city permits.\n\nTake the following message generated by the Permit Advisor system and present it in a clear, friendly, and easy-to-read format.\n\nFormatting rules:\n- If the response contains multiple questions, present them as bullet points.\n- Each question should be on its own line.\n- Maintain the exact meaning of the original text.\n- Do not add new questions or modify the intent.\n- Use simple formatting for readability.\n- If there is only one question, present it as a single line without bullets.\n- Please show the Title of the response as \"Property Information\"\n\nMessage to format:\n{{$context.$nodes.CONVERSATION_ORCHESTRATOR.$output.response_to_user}}"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Related Batch Gate Check"
          },
          "outcomes": {
            "true": "1775877908572",
            "false": "1766392412900"
          },
          "code": "RELATED_BATCH_GATE_CHECK",
          "convergenceTargetId": "end",
          "id": "1766391997193",
          "inputs": [
            {
              "id": "1766391997195_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.RELATED_GATE_QUESTIONS.$output.results.some(q => q.triggered == \"true\") || $context.$nodes.RELATED_GATE_QUESTIONS.$output.unknown_questions == ''}} "
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Process first loop",
            "returnType": "object",
            "sourceCode": "//let raw = $context.$variables.relatedPermitDetails || {};\nlet raw = $context.$nodes.RELATED_DETAILS_COLLECTOR.$output.relatedPermitDetails || {};\n\n// --------------------------------------\n// PARSE + UNWRAP\n// --------------------------------------\nif (typeof raw === \"string\") {\n  try {\n    raw = JSON.parse(raw);\n  } catch (e) {\n    raw = {};\n  }\n}\n\nlet relatedPermitDetails = raw;\nwhile (relatedPermitDetails && relatedPermitDetails.result) {\n  relatedPermitDetails = relatedPermitDetails.result;\n}\n\nif (!relatedPermitDetails || typeof relatedPermitDetails !== \"object\") {\n  relatedPermitDetails = {};\n}\n\n// --------------------------------------\nlet nextPermit = null;\nlet missingQuestions = [];\nlet triggerredElements = [];\n\nlet permits = Object.keys(relatedPermitDetails);\n\n// --------------------------------------\n// FIND NEXT INCOMPLETE PERMIT\n// --------------------------------------\nfor (let permit of permits) {\n\n  let state = relatedPermitDetails[permit];\n  if (!state) continue;\n\n  // ✅ Normalize triggered\n  let triggered =\n    state.triggered === true || state.triggered === \"true\";\n\n  if (!triggered) continue;\n\n  let questions = Array.isArray(state.questions) ? state.questions : [];\n\n  let answers = Array.isArray(state.answers)\n    ? state.answers\n    : new Array(questions.length).fill(null);\n\n  let missing = [];\n\n  for (let i = 0; i < questions.length; i++) {\n    if (answers[i] == null) {\n      missing.push(questions[i]);\n    }\n  }\n\n  if (missing.length > 0) {\n    nextPermit = permit;\n    missingQuestions = missing;\n    break;\n  }\n}\n\n// --------------------------------------\n// RESPONSE\n// --------------------------------------\nlet response_to_user = \"\";\n\nif (nextPermit) {\n  response_to_user =\n    \"Please answer for \" + nextPermit.toUpperCase() + \":\\n\" +\n    missingQuestions.map(q => \"- \" + q).join(\"\\n\");\n\n  triggerredElements = [nextPermit];\n} else {\n  response_to_user = \"\";\n}\n\n// --------------------------------------\nreturn {\n  relatedPermitDetails,\n  triggerredElements,\n  response_to_user,\n  nextPermit,\n  isFirstAsk: false\n};"
          },
          "outcomes": {
            "success": "1775835347798"
          },
          "code": "PROCESS_FIRST_LOOP",
          "id": "1766650152754",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Check Related Processed"
          },
          "outcomes": {
            "true": "1766614006181",
            "false": "1767903292926"
          },
          "code": "CHECK_RELATED_PROCESSED",
          "convergenceTargetId": "end",
          "id": "1766605761183",
          "inputs": [
            {
              "id": "1766605761184_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.PROCESS_FIRST_LOOP.$output.result.response_to_user === \"\"}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Set Permit Code",
            "returnType": "array",
            "sourceCode": "const allPermits = new Set();\n\n// Safely add primary permit\nconst primaryCode = $context?.$variables?.primaryPermit?.code;\nif (primaryCode) {\n  allPermits.add(primaryCode);\n}\n\n// Normalize inputs\nconst relatedPermits = Array.isArray($context?.$variables?.relatedPermitDetails)\n  ? $context.$variables.relatedPermitDetails\n  : [];\n\nconst relatedNames = Array.isArray($context?.$variables?.relatedNames)\n  ? new Set($context.$variables.relatedNames)\n  : new Set();\n\n// Match and add related permits\nfor (const permit of relatedPermits) {\n  if (permit?.name && permit?.code && relatedNames.has(permit.name)) {\n    allPermits.add(permit.code);\n  }\n}\n\n// Convert back to array if needed\nconst result = Array.from(allPermits);\nreturn result;"
          },
          "outcomes": {
            "success": "1772069830353"
          },
          "code": "SET_PERMIT_CODE",
          "id": "1766614006181",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Collect Related Gate Check"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "COLLECT_RELATED_GATE_CHECK",
          "id": "1766392412900",
          "inputs": [
            {
              "id": "1766392412901_1",
              "name": "prompt",
              "type": "string",
              "value": "You are formatting questions for a permit application assistant.\n\nINPUT:\n{{$context.$nodes.RELATED_GATE_QUESTIONS.$output.unknown_questions}}\n\nTASK:\nDisplay the questions clearly for the user.\n\nFormatting rules:\n- Preserve the exact wording of each question.\n- Please show the Title of the response as \"Related Application Questions\".\n- Do NOT modify, summarize, or rephrase the questions.\n- If there are multiple questions, display them as bullet points.\n- Each question should appear on its own line.\n- Do not add numbering.\n- Do not add Yes/No options.\n- Do not add explanations or extra text.\n- Do not introduce the questions with a sentence.\n- Do not add closing text.\n\nOnly format the questions for readability."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Related Gate Questions"
          },
          "outcomes": {
            "success": "1766391997193"
          },
          "code": "RELATED_GATE_QUESTIONS",
          "convergenceTargetId": "1766391997193",
          "id": "1766391969883",
          "inputs": [
            {
              "id": "1766391969884_1",
              "name": "prompt",
              "type": "string",
              "value": "You are the Related Permit Batch Gate Evaluation Agent.\n\nYour task is to evaluate MULTIPLE related permits and determine whether each applies.\n\nFor each related permit, assign strictly:\n- true → explicit YES in the latest user message (only if current value is unknown)\n- false → explicit NO in the latest user message (only if current value is unknown)\n- unknown → not answered yet\n\n❗ Once a permit’s triggered is set to true or false, it must NEVER be changed in future interactions.  \n❗ The PRIMARY permit is FINAL and MUST NOT be modified.\n\n--------------------------------------------------\nINPUTS (READ ONLY)\n--------------------------------------------------\n- Latest user message:\n  {{$context.$system.$inputMessage}}\n\n- inputProcessed flag:\n {{$context.$system.inputProcessed}}\n\n- Related permits list (ORDER IS CRITICAL):\n  {{$context.$variables.relatedPermits}}\n\n- Persisted permit state (SOURCE OF TRUTH):\n  {{$context.$variables.relatedPermitDetails}}\n\n  # Expected structure:\n  # {\n  #   \"<permit_name>\": {\n  #       \"triggered\": true | false | \"unknown\"\n  #   }\n  # }\n\n--------------------------------------------------\nGLOBAL HARD RULES\n--------------------------------------------------\n❗ Evaluate ONLY relatedPermits in given order  \n❗ Do NOT infer across unrelated turns  \n❗ Do NOT reuse answers from previous unrelated questions  \n❗ Do NOT guess or assume intent  \n❗ Do NOT reorder permits  \n❗ Each permit MUST be evaluated independently  \n❗ Always preserve original order  \n❗ NEVER overwrite triggered values that are already true or false  \n❗ JSON ONLY, no markdown, no explanations  \n\n--------------------------------------------------\nINPUT CONSUMPTION RULE (CRITICAL)\n--------------------------------------------------\n\n\n❗ If inputProcessed == true:\n    → You MUST NOT use or interpret the latest user message\n    → You MUST skip STEP 2 and STEP 3 entirely\n    → You MUST return existing triggered values unchanged\n\n❗ Only process inputMessage if inputProcessed == false\n\n--------------------------------------------------\nSOURCE OF TRUTH (CRITICAL)\n--------------------------------------------------\n❗ relatedPermitDetails is the SINGLE SOURCE OF TRUTH\n\nFor each permit:\n- If relatedPermitDetails[permit.name].triggered is true or false:\n    → MUST use that value\n    → MUST NOT change it\n    → MUST NOT re-evaluate using inputMessage\n\n- Only if:\n    - permit not present in relatedPermitDetails\n    OR\n    - triggered == \"unknown\"\n\n    → You MAY evaluate using inputMessage\n\n❗ inputMessage is ONLY for filling missing values  \n❗ inputMessage MUST NEVER override existing true/false values  \n\n--------------------------------------------------\nSTEP 1: INITIALIZE FROM STATE (HIGHEST PRIORITY)\n--------------------------------------------------\nFor each permit:\n\n1. If relatedPermitDetails contains permit.name:\n    - triggered = relatedPermitDetails[permit.name].triggered\n\n2. Else if permit.triggered exists:\n    - triggered = permit.triggered\n\n3. Else:\n    - triggered = \"unknown\"\n\n❗ This establishes BASELINE STATE  \n❗ Values set to true/false here are FINAL  \n\n--------------------------------------------------\nSTEP 2: POSITIONAL MAPPING (ONLY IF inputProcessed == false)\n--------------------------------------------------\nCheck ONLY the latest user message for a sequence of short answers:\nExamples:\n- \"yes, no, no\"\n- \"y n n\"\n- \"yes no no\"\n- \"1 yes 2 no 3 yes\"\n\nIf detected:\n\n1. Normalize:\n   - lowercase\n   - remove punctuation and numbering\n   - map y → yes, n → no\n\n2. Extract ordered tokens:\n   Example → [\"yes\", \"no\", \"no\"]\n\n3. For i in range(number of permits):\n\n   - If triggered == \"unknown\":\n        - \"yes\" → triggered = true\n        - \"no\" → triggered = false\n\n   - If triggered already true/false:\n        → DO NOT CHANGE\n\n4. If fewer tokens than permits:\n   → remaining permits keep current value\n\n5. Ignore extra tokens beyond permit count\n\n❗ DO NOT use chatHistory  \n❗ DO NOT shift indexes  \n❗ DO NOT reinterpret tokens  \n❗ NEVER overwrite existing true/false values  \n\n--------------------------------------------------\nSTEP 3: SEMANTIC FALLBACK (ONLY IF inputProcessed == false)\n--------------------------------------------------\nFor each permit where triggered == \"unknown\":\n\n- Check latest user message for explicit yes/no answer\n  to that permit’s EXACT question\n\n- Apply:\n    yes → true  \n    no → false  \n    anything else → unknown  \n\n❗ Only evaluate unknown permits  \n❗ NEVER overwrite true/false values  \n❗ DO NOT infer across questions  \n\n--------------------------------------------------\nSTATE MERGE LOGIC\n--------------------------------------------------\nFinal triggered value per permit:\n\n1. relatedPermitDetails (true/false) → FINAL  \n2. Else positional mapping result  \n3. Else semantic fallback result  \n4. Else → \"unknown\"  \n\n--------------------------------------------------\nSTEP 4: BUILD OUTPUT\n--------------------------------------------------\nresults = []\n\nFor each permit in original order:\n{\n  \"name\": permit.name || permit.RecordType,\n  \"triggered\": triggered,\n  \"question\": permit.question\n}\n\nunknown_questions = join all permit.question where triggered == \"unknown\"\n\n--------------------------------------------------\nINPUT PROCESSED DECISION RULE (MANDATORY)\n--------------------------------------------------\nYou MUST determine inputProcessed as follows:\n\n- If STEP 2 (positional mapping) updated ANY permit:\n    → inputProcessed = true\n\n- Else if STEP 3 (semantic fallback) updated ANY permit:\n    → inputProcessed = true\n\n- Else:\n    → inputProcessed = false\n\n❗ If ANY triggered value changed from \"unknown\" to true/false:\n    → inputProcessed MUST be true\n\n❗ DO NOT default to false if updates occurred\n❗ This rule OVERRIDES any ambiguity\n\n--------------------------------------------------\nOUTPUT FORMAT (STRICT JSON ONLY)\n--------------------------------------------------\n{\n  \"results\": [ ...results in original order... ],\n  \"unknown_questions\": \"<combined questions or empty>\",\n  \"inputProcessed\": true|false\n}\n\n--------------------------------------------------\nFINAL HARD CHECK\n--------------------------------------------------\n❗ All permits must be included  \n❗ Preserve exact order  \n❗ Do not skip any permit  \n❗ Do not mix answers between permits  \n❗ NEVER overwrite true/false values  \n❗ JSON only"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"name\": {\n      \"type\": \"string\",\n      \"description\": \"Related Permit Type\"\n    },\n    \"triggered\": {\n      \"type\": \"string\",\n      \"description\": \"questions triggered\"\n    },\n    \"question\": {\n      \"type\": \"string\",\n      \"description\": \"questions details\"\n    },\n    \"unknown_questions\": {\n      \"type\": \"string\",\n      \"description\": \"questions details not answered\"\n    },\n    \"inputProcessed\": {\n      \"type\": \"boolean\",\n      \"description\": \"if input was processed with input\"\n    },\n    \"results\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": { \"type\": \"string\" },\n          \"triggered\": { \"type\": \"string\" },\n          \"question\": { \"type\": \"string\" }\n        }\n      }\n    }\n  }\n}",
          "type": "LLM"
        },
