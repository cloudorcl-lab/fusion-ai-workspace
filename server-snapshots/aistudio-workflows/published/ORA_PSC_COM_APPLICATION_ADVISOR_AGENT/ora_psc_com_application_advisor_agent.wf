            "sourceCode": "// Iterate over each related permit\nlet relPermits = $context.$nodes.FIND_INITIAL_PERMIT_TYPE.$output.primaryPermitData.relatedTypes;\nfor (let permit of relPermits) {\n    // Only initialize if triggered is not yet set\n    if (permit.triggered === undefined || permit.triggered === null) {\n        permit.triggered = \"unknown\";\n    }\n}\nreturn relPermits;"
          },
