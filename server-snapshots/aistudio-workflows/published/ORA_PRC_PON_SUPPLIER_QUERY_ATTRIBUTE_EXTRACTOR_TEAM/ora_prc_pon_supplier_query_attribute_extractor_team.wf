        {
          "metadata": {
            "name": "Calculate Final Output",
            "returnType": "object",
            "sourceCode": "const baseOutput = $context.$nodes.SUPPLIER_QUERY_ATTRIBUTE_EXTRACTOR.$output;\n\nconst includedSupplierId = $context.$nodes.FETCH_INCLUDE_SUPPLIER_IDS.$output|| {\"items\":[]};\nconst includedBusinessClassificationId = $context.$nodes.INCLUDED_BUSINESS_CLASSIFICATION_EXTRACTION.$output || {\"items\":[]};\n\nconst excludedSupplierId = $context.$nodes.FETCH_EXCLUDE_SUPPLIER_IDS.$output|| {\"items\":[]};\nconst excludedBusinessClassificationId = $context.$nodes.EXCLUDED_BUSINESS_CLASSIFICATION_EXTRACTION.$output || {\"items\":[]};\n\nlet includedCategoryId;\nif ($context.$nodes.EVALUATE_CATEGORY_VECTOR_AVAILABILITY.$output.result) {\n    const includedCategoryIdVector = $context.$nodes.READ_INCLUDED_CATEGORY_DATA_VECTOR.$output || []; \n    includedCategoryId = includedCategoryIdVector.filter(e => e.vectorSearchScore > 0.7).map(e => e.CategoryId);\n} else {\n    const includedCategoryIdRest = $context.$nodes.READ_INCLUDED_CATEGORY_DATA_REST.$output || {\"items\":[]};\n    includedCategoryId = includedCategoryIdRest.items.map(e => e.CategoryId);\n}\n\nlet excludedCategoryId;\nif ($context.$nodes.EVALUATE_CATEGORY_VECTOR_AVAILABILITY.$output.result) {\n    const excludedCategoryIdVector = $context.$nodes.READ_EXCLUDED_CATEGORY_DATA_VECTOR.$output || []; \n    excludedCategoryId = excludedCategoryIdVector.filter(e => e.vectorSearchScore > 0.7).map(e => e.CategoryId);\n} else {\n    const excludedCategoryIdRest = $context.$nodes.READ_EXCLUDED_CATEGORY_DATA_REST.$output || {\"items\":[]};\n    excludedCategoryId = excludedCategoryIdRest.items.map(e => e.CategoryId);\n}\n\n\nconst ret = baseOutput;\n\nret.Inclusion.CategoryId = includedCategoryId;\nret.Inclusion.SupplierId = includedSupplierId.items.slice(0, 5).map(e => e.SupplierDetails.SupplierPartyId);\nret.Inclusion.BusinessClassification = includedBusinessClassificationId.items.slice(0, 5).map(e => e.LookupCode);\nret.Exclusion.CategoryId = excludedCategoryId;\nret.Exclusion.SupplierId = excludedSupplierId.items.slice(0, 5).map(e => e.SupplierDetails.SupplierPartyId);\nret.Exclusion.BusinessClassification = excludedBusinessClassificationId.items.slice(0, 5).map(e => e.LookupCode);\n\nreturn ret;"
          },
          "outcomes": {
            "success": "end"
          },
