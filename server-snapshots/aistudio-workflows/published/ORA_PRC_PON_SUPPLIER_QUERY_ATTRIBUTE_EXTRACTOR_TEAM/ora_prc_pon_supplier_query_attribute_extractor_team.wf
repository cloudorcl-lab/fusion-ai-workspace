        {
          "metadata": {
            "name": "Compute Bool Query for Including Suppliers",
            "returnType": "object",
            "sourceCode": "let supplierKeywords = $context.$nodes.SUPPLIER_QUERY_ATTRIBUTE_EXTRACTOR.$output.Inclusion.SupplierKeywords.join(' ');\nlet businessRelationship = '';\nlet excludedSupplierKeywords = $context.$nodes.SUPPLIER_QUERY_ATTRIBUTE_EXTRACTOR.$output.Exclusion.SupplierKeywords.join(' ');\nlet excludedBusinessRelationship = '';\n\nconst businessRelationshipQuery = {\n    \"match\": {\n        \"BusinessRelationshipDetails.Meaning\": {\n            \"query\": businessRelationship,\n            \"operator\": \"OR\"\n        }\n    }\n};\n\nconst supplierKeywordsQuery = {\n    \"bool\": {\n        \"should\": [\n            {\n                \"multi_match\": {\n                    \"query\": supplierKeywords,\n                    \"fields\": [\n                        \"SupplierDetails.SupplierName^3\",\n                        \"supplierNumber^5\",\n                        \"SupplierDetails.dunsNumberC^5\",\n                        \"ParentPartyDetails.parentSupplierName\"\n                    ],\n                    \"operator\": \"OR\"\n                }\n            },\n            {\n                \"nested\": {\n                    \"path\": \"AdditionalPartyDetails\",\n                    \"query\": {\n                        \"match\": {\n                            \"AdditionalPartyDetails.PartyName\": {\n                                \"query\": supplierKeywords,\n                                \"operator\": \"OR\"\n                            }\n                        }\n                    },\n                    \"score_mode\": \"max\",\n                    \"boost\": 3\n                }\n            }\n        ],\n        \"minimum_should_match\": 1\n    }\n};\n\nconst boolQuery = {\n    \"_source\": [\n        \"SupplierDetails.SupplierPartyId\",\n        \"SupplierDetails.SupplierName\",\n        \"supplierNumber\",\n        \"SupplierDetails.dunsNumberC\",\n        \"ParentPartyDetails.parentSupplierName\",\n        \"AdditionalPartyDetails.PartyName\",\n        \"BusinessRelationshipDetails.Meaning\"\n    ],\n    \"query\": {\n        \"bool\": {\n            \"must\": [],\n            \"must_not\": []\n        }\n    }\n};\n\nif (supplierKeywords && supplierKeywords.trim().length > 0) {\n    boolQuery.query.bool.must.push(supplierKeywordsQuery);\n}\n\nif (businessRelationship && businessRelationship.trim().length > 0) {\n    boolQuery.query.bool.must.push(businessRelationshipQuery);\n}\n\nif (excludedSupplierKeywords && excludedSupplierKeywords.trim().length > 0) {\n    boolQuery.query.bool.must_not.push({\n        \"bool\": {\n            \"should\": [\n                {\n                    \"multi_match\": {\n                        \"query\": excludedSupplierKeywords,\n                        \"fields\": [\n                            \"SupplierDetails.SupplierName^3\",\n                            \"supplierNumber^5\",\n                            \"SupplierDetails.dunsNumberC^5\",\n                            \"ParentPartyDetails.parentSupplierName\"\n                        ],\n                        \"operator\": \"OR\"\n                    }\n                },\n                {\n                    \"nested\": {\n                        \"path\": \"AdditionalPartyDetails\",\n                        \"query\": {\n                            \"match\": {\n                                \"AdditionalPartyDetails.PartyName\": {\n                                    \"query\": excludedSupplierKeywords,\n                                    \"operator\": \"OR\"\n                                }\n                            }\n                        },\n                        \"score_mode\": \"max\",\n                        \"boost\": 3\n                    }\n                }\n            ],\n            \"minimum_should_match\": 1\n        }\n    });\n}\n\nif (excludedBusinessRelationship && excludedBusinessRelationship.trim().length > 0) {\n    boolQuery.query.bool.must_not.push({\n        \"match\": {\n            \"BusinessRelationshipDetails.Meaning\": {\n                \"query\": excludedBusinessRelationship,\n                \"operator\": \"OR\"\n            }\n        }\n    });\n}\n\nreturn boolQuery;"
          },
          "outcomes": {
            "success": "1768381559254"
          },
          "code": "COMPUTE_BOOL_QUERY_FOR_INCLUDING_SUPPLIERS",
          "id": "1768381617667",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Compute Bool Query for Excluding Suppliers",
            "returnType": "object",
            "sourceCode": "let supplierKeywords = $context.$nodes.SUPPLIER_QUERY_ATTRIBUTE_EXTRACTOR.$output.Exclusion.SupplierKeywords.join(' ');\nlet businessRelationship = '';\n\nconst businessRelationshipQuery = {\n    \"match\": {\n        \"BusinessRelationshipDetails.Meaning\": {\n            \"query\": businessRelationship,\n            \"operator\": \"OR\"\n        }\n    }\n};\n\nconst supplierKeywordsQuery = {\n    \"bool\": {\n        \"should\": [\n            {\n                \"multi_match\": {\n                    \"query\": supplierKeywords,\n                    \"fields\": [\n                        \"SupplierDetails.SupplierName^3\",\n                        \"supplierNumber^5\",\n                        \"SupplierDetails.dunsNumberC^5\",\n                        \"ParentPartyDetails.parentSupplierName\"\n                    ],\n                    \"operator\": \"OR\"\n                }\n            },\n            {\n                \"nested\": {\n                    \"path\": \"AdditionalPartyDetails\",\n                    \"query\": {\n                        \"match\": {\n                            \"AdditionalPartyDetails.PartyName\": {\n                                \"query\": supplierKeywords,\n                                \"operator\": \"OR\"\n                            }\n                        }\n                    },\n                    \"score_mode\": \"max\",\n                    \"boost\": 3\n                }\n            }\n        ],\n        \"minimum_should_match\": 1\n    }\n};\n\nconst boolQuery = {\n    \"_source\": [\n        \"SupplierDetails.SupplierPartyId\",\n        \"SupplierDetails.SupplierName\",\n        \"supplierNumber\",\n        \"SupplierDetails.dunsNumberC\",\n        \"ParentPartyDetails.parentSupplierName\",\n        \"AdditionalPartyDetails.PartyName\",\n        \"BusinessRelationshipDetails.Meaning\"\n    ],\n    \"query\": {\n        \"bool\": {\n            \"must\": []\n        }\n    }\n};\n\nif (supplierKeywords && supplierKeywords.trim().length > 0) {\n    boolQuery.query.bool.must.push(supplierKeywordsQuery);\n}\n\nif (businessRelationship && businessRelationship.trim().length > 0) {\n    boolQuery.query.bool.must.push(businessRelationshipQuery);\n}\n\nreturn boolQuery;"
          },
          "outcomes": {
            "success": "1768382371670"
          },
          "code": "COMPUTE_BOOL_QUERY_FOR_EXCLUDING_SUPPLIERS",
          "id": "1768382253603",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Calculate Included Business Classification Query",
            "returnType": "string",
            "sourceCode": "const includedBusinessClassification = $context.$nodes.SUPPLIER_QUERY_ATTRIBUTE_EXTRACTOR.$output.Inclusion.BusinessClassification;\nlet baseQueryParam = 'LookupType=\\'POZ_BUSINESS_CLASSIFICATIONS\\' AND (';\nlet isFirst = true;\nincludedBusinessClassification.forEach(classification => {\n    if (!isFirst) {\n        baseQueryParam += ' OR ';\n    }\n    baseQueryParam += `(${classification.split(/\\s+/).map(term => `UPPER(Meaning) LIKE '%${term.toUpperCase()}%'`).join(' AND ')})`;\n    isFirst = false;\n});\nreturn baseQueryParam + ')';"
          },
          "outcomes": {
            "success": "1770795282485"
          },
          "code": "CALCULATE_INCLUDED_BUSINESS_CLASSIFICATION_QUERY",
          "id": "1770716268210",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Calculate Excluded Business Classification Query",
            "returnType": "string",
            "sourceCode": "const excludedBusinessClassification = $context.$nodes.SUPPLIER_QUERY_ATTRIBUTE_EXTRACTOR.$output.Exclusion.BusinessClassification;\nlet baseQueryParam = 'LookupType=\\'POZ_BUSINESS_CLASSIFICATIONS\\' AND (';\nlet isFirst = true;\nexcludedBusinessClassification.forEach(classification => {\n    if (!isFirst) {\n        baseQueryParam += ' OR ';\n    }\n    baseQueryParam += `(${classification.split(/\\s+/).map(term => `UPPER(Meaning) LIKE '%${term.toUpperCase()}%'`).join(' AND ')})`;\n    isFirst = false;\n});\nreturn baseQueryParam + ')';"
          },
          "outcomes": {
            "success": "1770717711515"
          },
          "code": "CALCULATE_EXCLUDED_BUSINESS_CLASSIFICATION_QUERY",
          "id": "1770716330395",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Calculate Included Category Vector Query",
            "returnType": "string",
            "sourceCode": "return [ ...$context.$nodes.SUPPLIER_QUERY_ATTRIBUTE_EXTRACTOR.$output.Inclusion.Category, ...$context.$nodes.SUPPLIER_QUERY_ATTRIBUTE_EXTRACTOR.$output.Inclusion.ItemName ].join(' or ');"
          },
          "outcomes": {
            "success": "1771569345263"
          },
          "code": "CALCULATE_INCLUDED_CATEGORY_VECTOR_QUERY",
          "id": "1771569143959",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Calculate Included Category Rest Query",
            "returnType": "string",
            "sourceCode": "const categorySearchTerms = [ \n    ...$context.$nodes.SUPPLIER_QUERY_ATTRIBUTE_EXTRACTOR.$output.Inclusion.Category, \n    ...$context.$nodes.SUPPLIER_QUERY_ATTRIBUTE_EXTRACTOR.$output.Inclusion.ItemName \n];\nconst date = $context.$system.$currentDate;\n\nconst dateConditions = `(StartDate is null or StartDate <= '${date}') and (EndDate is null or EndDate >= '${date}')`;\n\nconst termGroups = categorySearchTerms.map(searchTerm => {\n    const wordQueries = searchTerm.split(/\\s+/).map(word => {\n        const term = word.toUpperCase();\n        return `(UPPER(CategoryName) LIKE '%${term}%' OR UPPER(Description) LIKE '%${term}%')`;\n    });\n\n    return `(${wordQueries.join(' AND ')})`;\n});\n\nreturn `${dateConditions} AND (${termGroups.join(' OR ')})`;"
          },
          "outcomes": {
            "success": "1771571130456"
          },
