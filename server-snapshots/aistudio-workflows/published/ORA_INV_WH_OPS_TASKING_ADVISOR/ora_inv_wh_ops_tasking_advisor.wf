        {
          "metadata": {
            "name": "Consolidate Response",
            "returnType": "object",
            "sourceCode": "// AIHint : Refer to same folder for sample json\nlet allCountsData = $context.$nodes.INIT_DISPLAY_MAKE_BATCH_CALL_FOR_COUNTS.$output;\n\n\nlet consoldiatedDataByActivity = {};\n\nconst openTasksPart = allCountsData.parts?.find((part) => part.id === \"OPEN_TASKS_COUNT\");\nconst unassignedPart = allCountsData.parts?.find(\n  (part) => part.id === \"OPEN_TASKS_UNASSIGNED_COUNT\"\n);\n\nconst openTasksItems = openTasksPart?.payload?.items ?? [];\nconst unassignedItems = unassignedPart?.payload?.items ?? [];\n\nopenTasksItems.forEach((item) => {\n  const activityCode = item.ActivityTypeCode ?? \"UNKNOWN\";\n  const openCount = Number(item.OpenTasksCount ?? 0);\n\n  if (!consoldiatedDataByActivity[activityCode]) {\n    consoldiatedDataByActivity[activityCode] = {\n      activityCode,\n      totalOpenTasks: 0,\n      unassignedOpenTasks: 0,\n      assignedOpenTasks: 0,\n    };\n  }\n\n  consoldiatedDataByActivity[activityCode].totalOpenTasks += openCount;\n});\n\nunassignedItems.forEach((item) => {\n  const activityCode = item.ActivityTypeCode ?? \"UNKNOWN\";\n  const unassignedCount = Number(item.OpenTasksCount ?? 0);\n\n  if (!consoldiatedDataByActivity[activityCode]) {\n    consoldiatedDataByActivity[activityCode] = {\n      activityCode,\n      totalOpenTasks: 0,\n      unassignedOpenTasks: 0,\n      assignedOpenTasks: 0,\n    };\n  }\n\n  consoldiatedDataByActivity[activityCode].unassignedOpenTasks += unassignedCount;\n});\n\nObject.values(consoldiatedDataByActivity).forEach((activitySummary) => {\n  activitySummary.assignedOpenTasks = Math.max(\n    activitySummary.totalOpenTasks - activitySummary.unassignedOpenTasks,\n    0\n  );\n});\n\nreturn consoldiatedDataByActivity;"
          },
          "outcomes": {
            "success": "1766121314453"
          },
          "code": "CONSOLIDATE_RESPONSE",
          "id": "1771747089921",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
