          "metadata": {
            "name": "AutoAssign PrepareRequests",
            "returnType": "object",
            "sourceCode": "let organizationId = $context.$variables.OrganizationId ;\n\n\nlet requestPayload = {\n  \"parts\": [\n    {\n      \"id\": \"UnassignedTasks\",\n      \"path\": `/inventoryZoneTasks?expand=all&orderBy=PriorityCode:desc&limit=1000&offset=0&onlyData=true&q=OrganizationId=${organizationId} and (EnableWorkforceScheduling is null or EnableWorkforceScheduling='N') and RecurringTask='N' and TaskStatusCode='N'and AssignmentStatusCode='U'`,\n      \"operation\": \"get\"\n    },\n    {\n      \"id\": \"AssignedTasks\",\n      \"path\": `/inventoryZoneTasks?expand=all&orderBy=PriorityCode:desc&limit=1000&offset=0&onlyData=true&q=OrganizationId=${organizationId} and (EnableWorkforceScheduling is null or EnableWorkforceScheduling='N') and RecurringTask='N' and TaskStatusCode='N'and AssignmentStatusCode='U'`,\n      \"operation\": \"get\"\n    },\n    {\n      \"id\": \"WorkerAssignments\",\n      \"path\": `/inventoryZoneWorkerAssignments?onlyData=true&limit=1000&offset=0&expand=all&q=OrganizationId=${organizationId}`,\n      \"operation\": \"get\"\n    }\n  ]\n};\n\nreturn requestPayload;"
          },
          "outcomes": {
            "success": "1771764720639"
          },
