        {
          "metadata": {
            "name": "parse action",
            "returnType": "string",
            "sourceCode": "let input = $context.$app.$OraAction;\n\n// Parse the input only if it's a string (assumed to be JSON text)\nif (typeof input === \"string\") {\n  input = JSON.parse(input);\n}\nif (input.actionType ==\"fetchImpactedWorkDefinitions\" || input.actionType==\"applyEcoChanges\" || input.actionType==\"syncWorkOrder\")  {\nreturn \"ORA_WIS_PRODUCTION_READINESS_WORKSPACE_PRODUCT_UPDATES_ADVISOR\";\n}\nif (input.actionType == \"AddMaterial\" || input.actionType == \"AddResource\" || input.actionType == \"SyncWorkOrders\" || input.actionType == \"UpdateMaterial\" || input.actionType == \"FixAllErrors\"){\nreturn \"ORA_WIS_PRODUCTION_READINESS_WORKSPACE_WORK_DEFINITIONS_ERROR_ADVISOR\";\n}\n\nreturn input;"
          },
          "outcomes": {
            "success": "1776714167415"
          },
