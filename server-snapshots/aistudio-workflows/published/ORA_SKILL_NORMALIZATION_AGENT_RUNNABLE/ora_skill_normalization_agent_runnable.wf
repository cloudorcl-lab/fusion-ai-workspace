                    "sourceCode": "// Read input from workflow variable into a CODE local variable called skillsArray\nlet skillsArray = $context.$variables.SkillsInput.skillsToProcess\n\n// add disposition \nskillsArray[$context.$nodes.FOR_EACH_SKILL.$currentItemIndex].dispositionMethod = \"ORA_HRT_NEW_SKILL\" ;\n\nreturn skillsArray[$context.$nodes.FOR_EACH_SKILL.$currentItemIndex];"
                  },
                  "outcomes": {
                    "success": "end_1761761461577"
                  },
                  "code": "SET_RESULT_AS_NEW_SKILL",
                  "id": "1761852789350",
