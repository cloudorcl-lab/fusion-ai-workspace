                },
                {
                  "metadata": {
                    "modelConfiguration": {
                      "code": "ORA_MODEL_CONFIG_PREMIUM_OPEN_AI_GPT_4_1_MINI",
                      "model": "OCI_GPT_5_MINI",
                      "provider": "CERT_PREMIUM"
                    },
                    "name": "LLM Review - Synonym vs New Skill"
                  },
                  "outcomes": {
                    "success": "1761860526737"
                  },
                  "code": "LLM_REVIEW_SYNONYM_VS_NEW_SKILL",
                  "id": "1761851710552",
                  "inputs": [
                    {
                      "id": "1761851710554_1",
                      "name": "prompt",
                      "type": "string",
                      "value": "You are a Senior Skill Ontologist. Input = a JSON:\n{\"input_skill\":\"{{$context.$nodes.FOR_EACH_SKILL.PREPARE_EXACT_MATCH_PAYLOAD.$output.result}}\",\n \"context\":\" {{$context.$nodes.FOR_EACH_SKILL.EXTRACT_CONTEXT.$output.result}} \",\n \"matching_skills\":{{$context.$nodes.FOR_EACH_SKILL.SEARCH_FOR_SEMANTIC_MATCH.$output.results}} \n}\n \n\nTask: Decide if input_skill is semantically identical to any matching_skills (ORA_HRT_SYNONYM) or a new distinct skill (ORA_HRT_NEW_SKILL). Do NOT invent matches or IDs.\n\nRULES (follow exactly)\n1. Identify the input_skill’s core capability, granularity (broad/mid/tool), and qualifiers.\n2. ORA_HRT_SYNONYM only if semantic meaning and outcome are identical.\n - Merge allowed: abbreviations, rewording, or redundant qualifiers (basics, intro, overview, for professionals) that add no new meaning.\n3. ORA_HRT_NEW_SKILL otherwise. Do NOT merge if:\n - Domain, tool, or vendor qualifiers materially change knowledge, outcome, data, stakeholders, regulation, or workflows.\n - Parent/child mismatch (e.g., general vs specific skill).\n4. Qualifiers rule (genericized):\n Treat prefixes, suffixes, or phrases as DISTINCT only if they change capability, required knowledge, or outcome. \n Examples of meaningful change: domain-specific context, regulation, specialized data/tools, stakeholder focus, or unique deliverables.\n Treat generic or stylistic modifiers (e.g., for business, advanced, enterprise, fundamentals, introduction) as MOOT if they do not change these. \n Always note in \"reason\" whether the qualifier was meaningful or moot.\n5. Ambiguity: if no perfect match or multiple close ones exist, choose ORA_HRT_NEW_SKILL and set match fields to null.\n6. Risk control: if merging may lose downstream signal (role mapping, compliance, training), do NOT merge.\n7. Copy matching_skill_id verbatim from input when selecting a match.\n8. Provide integer confidence 0–100. If confidence <70 include MANUAL_REVIEW in reason.\n\n=== OUTPUT (MANDATORY) ===\nReturn only one valid JSON object. No prose, markdown, or extra text.\nJSON must be parsable by json.loads.\nUse double quotes for all strings. Never use single quotes or unescaped quotes inside strings.\nIf citing a skill name in \"reason\", write it without quotes.\n\n{\n \"skill\": \"<input_skill>\",\n \"matching_skill\": \"<best matching skill_name or null>\",\n \"matching_skill_id\": \"<skill_id or null>\",\n \"outcome\": \"ORA_HRT_SYNONYM\" | \"ORA_HRT_NEW_SKILL\",\n \"confidence\": <0-100>,\n \"reason\": \"<1–3 concise sentences; note if any qualifier was treated as moot or meaningful; if confidence <70 include MANUAL_REVIEW.>\"\n}"
                    }
                  ],
                  "outputSpecification": "{\n \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n \"type\": \"object\",\n \"properties\": {\n \"skill\": {\n \"type\": \"string\",\n \"description\": \"The input skill being processed\"\n },\n \"matching_skill\": {\n \"type\": [\"string\", \"null\"],\n \"description\": \"The best matching skill name, or null if no match found\"\n },\n \"matching_skill_id\": {\n \"type\": [\"string\", \"null\"],\n \"description\": \"The skill ID of the matching skill, or null if no match found\"\n },\n \"outcome\": {\n \"type\": \"string\",\n \"enum\": [\"ORA_HRT_SYNONYM\", \"ORA_HRT_NEW_SKILL\"],\n \"description\": \"The outcome type - synonym match or new skill\"\n },\n \"confidence\": {\n \"type\": \"number\",\n \"minimum\": 0,\n \"maximum\": 100,\n \"description\": \"Confidence score from 0 to 100\"\n },\n \"reason\": {\n \"type\": \"string\",\n \"description\": \"1-3 concise sentences explaining the decision; note if qualifiers were treated as moot or meaningful; include MANUAL_REVIEW if confidence < 70\"\n }\n },\n \"required\": [\"skill\", \"matching_skill\", \"matching_skill_id\", \"outcome\", \"confidence\", \"reason\"],\n \"additionalProperties\": false\n}",
                  "type": "LLM"
                },
