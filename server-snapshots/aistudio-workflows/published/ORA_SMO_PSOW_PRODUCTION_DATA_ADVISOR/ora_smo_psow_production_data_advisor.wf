          "name": "PRODUCTION_HEALTH_METRIC_ANALYSIS",
          "type": "rest",
          "agenticAppMode": "query",
          "inputMessage": "",
          "restConfigJson": "{\n    \"OraAppContext\": \"{\\\"organizationCode\\\":\\\"M1\\\",\\\"workCenterCode\\\":\\\"Assembly_Packaging_WC\\\",\\\"organizationId\\\":\\\"207\\\"}\",\n    \"OraMessageHint\": \"AdditionalContent\",\n    \"OraUserContext\": \"{\\\"userId\\\":\\\"300100036658848\\\",\\\"guId\\\":\\\"32CFDDB6A7411161666B59622B674673\\\",\\\"fullName\\\":\\\"Patric\\\",\\\"userName\\\":\\\"SCMOPERATIONS\\\",\\\"isAuthenticated\\\":true,\\\"loginUrl\\\":\\\"https://cptcilbqy.fusionapps.ocs.oc-test.com:443/fscmUI/faces/FuseWelcome\\\",\\\"isAdmin\\\":true,\\\"idcsTimeOut\\\":30,\\\"locale\\\":\\\"en\\\"}\",\n    \"triggerType\": \"REST\",\n    \"OraPanelName\": \"PRODUCTION_HEALTH_METRIC_ANALYSIS\",\n    \"aiAppOutputSpecification\": \"[\\\"infoDisplay\\\",\\\"actions\\\",\\\"enableCommunications\\\"]\"\n}"
