          "inputs": [
            {
              "id": "1768407568318_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_ACTION_PARAMS.$output.result.action}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
            "name": "Extract Failure Predictons",
            "returnType": "object",
            "sourceCode": "var data = $context?.$nodes?.GET_FAILURE_PREDICTIONS?.$output;\n\nvar groups = {};\n\nfor (var i = 0; i < (data?.items?.length || 0); i++) {\n  var item = data.items[i];\n\n  var key = item?.equipmentInstance?.name + '_' + item?.eventTime;\n\n  // Skip invalid records\n  if (!item?.equipmentInstance?.name || !item?.eventTime) {\n    continue;\n  }\n\n  if (!groups[key]) {\n    groups[key] = [];\n  }\n\n  groups[key].push(item);\n}\n\nvar result = [];\n\nfor (var key in groups) {\n  var group = groups[key];\n\n  if (!group?.length) {\n    continue;\n  }\n\n  var obj = {};\n  var first = group[0];\n\n  obj[\"Asset Number\"] = first?.asset?.assetNumber || null;\n  obj[\"Equipment Instance\"] = first?.equipmentInstance?.name || null;\n  obj[\"Event Time\"] = first?.eventTime || null;\n\n  for (var j = 0; j < group.length; j++) {\n    var it = group[j];\n    var attributeCode = it?.eventTypeAttribute?.attributeCode;\n\n    if (attributeCode === \"NAME\") {\n      obj[\"name\"] = it?.stringValue || null;\n\n    } else if (attributeCode === \"DESCRIPTION\") {\n      obj[\"description\"] = it?.stringValue || null;\n\n    } else if (attributeCode === \"PREDICTION_WINDOW_IN_HOURS\") {\n      obj[\"predictionWindow\"] = it?.numericValue || null;\n\n    } else if (attributeCode === \"PROBABILITY\") {\n      obj[\"probability\"] =\n        it?.numericValue != null\n          ? it.numericValue * 100\n          : null;\n    }\n  }\n\n  result.push(obj);\n}\n\nreturn result?.[0] || null;"
          },
          "outcomes": {
            "success": "1768368042113"
          },
