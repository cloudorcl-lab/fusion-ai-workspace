          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"OrganizationId\": { \"type\": \"integer\" },\n          \"OrganizationCode\": { \"type\": \"string\" },\n          \"OrganizationName\": { \"type\": \"string\" },\n          \"ManagementBusinessUnitId\": { \"type\": \"integer\" },\n          \"ManagementBusinessUnitName\": { \"type\": \"string\" },\n          \"LegalEntityId\": { \"type\": \"integer\" },\n          \"LegalEntityName\": { \"type\": \"string\" },\n          \"ProfitCenterBusinessUnitId\": { \"type\": \"integer\" },\n          \"ProfitCenterBusinessUnitName\": { \"type\": \"string\" },\n          \"Status\": { \"type\": \"string\" },\n          \"LocationId\": { \"type\": \"integer\" },\n          \"LocationCode\": { \"type\": \"string\" },\n          \"InventoryFlag\": { \"type\": \"boolean\" },\n          \"ManufacturingPlantFlag\": { \"type\": \"boolean\" },\n          \"ContractManufacturingFlag\": { \"type\": \"boolean\" },\n          \"MaintenanceEnabledFlag\": { \"type\": \"boolean\" },\n          \"MasterOrganizationId\": { \"type\": \"integer\" },\n          \"MasterOrganizationCode\": { \"type\": \"string\" },\n          \"MasterOrganizationName\": { \"type\": \"string\" },\n          \"IntegratedSystemType\": { \"type\": \"string\" },\n          \"ItemGroupingCode\": { \"type\": \"string\" },\n          \"ItemDefinitionOrganizationId\": { \"type\": \"integer\" },\n          \"ItemDefinitionOrganizationCode\": { \"type\": \"string\" },\n          \"ItemDefinitionOrganizationName\": { \"type\": \"string\" },\n          \"ManufacturingParametersExistFlag\": { \n            \"oneOf\": [\n              { \"type\": \"boolean\" },\n              { \"type\": \"string\", \"enum\": [\"true\", \"false\"] }\n            ]\n          },\n          \"CreatedBy\": { \"type\": \"string\" },\n          \"CreationDate\": { \"type\": \"string\", \"format\": \"date-time\" },\n          \"LastUpdatedBy\": { \"type\": \"string\" },\n          \"LastUpdateDate\": { \"type\": \"string\", \"format\": \"date-time\" },\n          \"FixedAssetCorporateBookTypeCode\": { \"type\": [\"string\", \"null\"] },\n          \"MaintenanceTechnicianWorkbenchEnabledFlag\": { \"type\": \"boolean\" },\n          \"LotConversionEnabledFlag\": { \"type\": \"boolean\" }\n        }\n      }\n    },\n    \"count\": { \"type\": \"integer\" },\n    \"hasMore\": { \"type\": \"boolean\" },\n    \"limit\": { \"type\": \"integer\" },\n    \"offset\": { \"type\": \"integer\" },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": { \"type\": \"string\" },\n          \"href\": { \"type\": \"string\", \"format\": \"uri\" },\n          \"name\": { \"type\": \"string\" },\n          \"kind\": { \"type\": \"string\" }\n        }\n      }\n    }\n  }\n}",
