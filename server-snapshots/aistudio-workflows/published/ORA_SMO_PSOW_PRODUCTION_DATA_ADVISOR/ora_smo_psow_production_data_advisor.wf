        {
          "metadata": {
            "name": "Extract shift details from past n days",
            "returnType": "string",
            "sourceCode": "const CONSTANTS = {\n  PATH: \"/shiftProductionMetrics/action/calculateMetric\",\n  OPERATION: \"invoke\",\n};\n\nconst METRIC_CONFIG = [\n  { metricType: \"PLAN_ADHERENCE\", includeTimeRange: true },\n  { metricType: \"OEE\", includeTimeRange: true },\n  { metricType: \"DOWNTIME\", includeTimeRange: true },\n  { metricType: \"WORK_ORDER_QUANTITY\", includeTimeRange: true },\n];\n\nconst SHIFT_TYPE_SUFFIX = {\n  CURRENT_SHIFT: \"CURRENT\",\n  PREVIOUS_SHIFT: \"PREVIOUS\",\n  NEXT_SHIFT: \"NEXT\",\n};\n\nfunction getShiftSuffix(shift, shiftIndex) {\n  return SHIFT_TYPE_SUFFIX[shift?.ShiftType] || `SHIFT_${shiftIndex + 1}`;\n}\n\n\nfunction buildShiftMetricParts(\n  inputJson,\n  organizationId,\n  workCenterId\n) {\n  const shiftList = Array.isArray(inputJson) ? inputJson : [];\n\n  return shiftList.flatMap((shift, shiftIndex) => {\n    const startTime = shift.StartDateTimeUTC || shift.StartDateTime;\n    const endTime = shift.EndDateTimeUTC || shift.EndDateTime;\n    const shiftSuffix = getShiftSuffix(shift, shiftIndex);\n\n    return METRIC_CONFIG.map((metric) => {\n      const payload = {\n        organizationId,\n        workCenterId,\n        metricType: metric.metricType,\n      };\n\n      if (metric.includeTimeRange) {\n        payload.startTime = startTime;\n        payload.completionTime = endTime;\n      }\n\n      return {\n        id: `${metric.metricType}_${shiftSuffix}`,\n        path: CONSTANTS.PATH,\n        operation: CONSTANTS.OPERATION,\n        payload,\n      };\n    });\n  });\n}\n\nconst organizationId =\n  $context.$nodes.GET_ORG_DETAILS.$output.items[0].OrganizationId;\nconst workCenterId =\n  $context.$nodes.GET_WORK_CENTER_DETAILS.$output.items[0].WorkCenterId;\nconst shifts = $context.$nodes.PARSE_PREVIOUS_N_SHIFTS_RESPONSE.$output.result;\nreturn JSON.stringify(\n  buildShiftMetricParts(shifts, organizationId, workCenterId),\n);"
          },
          "diagram": {
            "x": 6005.349253133704,
            "y": 9102.307307835346
          },
