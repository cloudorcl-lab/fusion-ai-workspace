          "metadata": {
            "name": "Build Object For Fill Params",
            "returnType": "object",
            "sourceCode": "const shiftMetrics = $context.$nodes.GET_SHIFT_METRICS.$output;\n\nconst result = {};\nshiftMetrics.parts.forEach((part) => {\n  switch (part.id) {\n    case \"PLAN_ADHERENCE_CURRENT\":\n      result.PlanAdherenceValue =\n        part.payload.result[0].PlanAdherenceValue !== null\n          ? Number.parseFloat(part.payload.result[0].PlanAdherenceValue)\n          : part.payload.result[0].PlanAdherenceValue;\n      break;\n    case \"OEE_CURRENT\":\n      result.OEEValue =\n        part.payload.result[0].OEEValue !== null\n          ? Number.parseFloat(part.payload.result[0].OEEValue)\n          : part.payload.result[0].OEEValue;\n      result.Availability =\n        part.payload.result[0].AvailabilityValue !== null\n          ? Number.parseFloat(part.payload.result[0].AvailabilityValue)\n          : part.payload.result[0].AvailabilityValue;\n      result.Performance =\n        part.payload.result[0].PerformanceValue != null\n          ? Number.parseFloat(part.payload.result[0].PerformanceValue)\n          : part.payload.result[0].PerformanceValue;\n      result.Quality =\n        part.payload.result[0].QualityValue !== null\n          ? Number.parseFloat(part.payload.result[0].QualityValue)\n          : part.payload.result[0].QualityValue;\n      break;\n    case \"WORK_ORDER_QUANTITY_CURRENT\":\n      result.CompletedQuantity =\n        part.payload.result[0].TotalCompletedQuantity !== null\n          ? Number.parseFloat(part.payload.result[0].TotalCompletedQuantity)\n          : part.payload.result[0].TotalCompletedQuantity;\n      result.PlannedQuantity =\n        part.payload.result[0].TotalPlannedQuantity != null\n          ? Number.parseFloat(part.payload.result[0].TotalPlannedQuantity)\n          : part.payload.result[0].TotalPlannedQuantity;\n      break;\n    case \"WORKSTATION_EXCEPTION_CURRENT\":\n      result.ExceptionCount =\n        part.payload.result[0].TotalCnt != null\n          ? Number.parseInt(part.payload.result[0].TotalCnt)\n          : part.payload.result[0].TotalCnt;\n      break;\n    default:\n      break;\n  }\n});\n\nreturn result;"
          },
          "outcomes": {
            "success": "1768442225969"
          },
