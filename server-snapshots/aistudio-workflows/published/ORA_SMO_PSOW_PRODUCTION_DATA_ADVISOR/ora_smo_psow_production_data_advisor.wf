        {
          "metadata": {
            "name": "Extract Current Shift Operational Parameters Data",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.GET_CURRENT_SHIFT_OP_PARAMS_DATA.$output \n\nconst filteredItems = [];\nfor (let i = 0; i < data.items.length; i++) {\n  const item = data.items[i];\n  filteredItems.push({\n    equipmentInstanceName: item.equipmentInstance.name || null,\n    eventTypeName: item.eventType.eventTypeName || null,\n    attributeName: item.eventTypeAttribute.attributeName || null,\n    numericValue: item.numericValue || null,\n    stringValue: item.stringValue || null,\n    jsonValue: item.jsonValue || null,\n    inRangeFlag: item.inRangeFlag || null,\n    executionIdentifier: item.executionIdentifier || null\n  });\n}\n\nconst output = {\n  items: filteredItems\n};\n\nreturn output"
          },
          "outcomes": {
            "success": "1766872908779"
          },
          "diagram": {
            "x": 5555.5,
            "y": 7707
          },
          "code": "EXTRACT_CURRENT_SHIFT_OP_PARAMS_DATA",
