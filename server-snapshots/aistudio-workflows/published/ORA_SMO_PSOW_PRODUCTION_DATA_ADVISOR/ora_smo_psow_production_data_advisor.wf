          },
          "diagram": {
            "x": 7390,
            "y": 5000
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "name": "Init Constants",
            "returnType": "object",
            "sourceCode": "let appContext = $context.$app.$OraAppContext;\ntry {\n  if (typeof $context.$app.$OraAppContext === \"string\") {\n    appContext = JSON.parse($context.$app.$OraAppContext);\n  }\n} catch (e) {\n  throw new Error(\"Failed to parse appContext\");\n}\nconst constantValues = {\n    workCenterCode: appContext?.workCenterCode,\n    organizationCode: appContext?.organizationCode,\n    orgSearchParams: `OrganizationCode='${appContext?.organizationCode}'`,\n};\nreturn constantValues;"
          },
          "outcomes": {
            "success": "1770947958456"
          },
          "diagram": {
            "x": 7288,
            "y": 5246
          },
          "code": "INIT_CONSTANTS",
          "id": "1766443286908",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
