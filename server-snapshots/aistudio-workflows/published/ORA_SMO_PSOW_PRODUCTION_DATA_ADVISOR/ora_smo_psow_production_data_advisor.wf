        },
        {
          "metadata": {
            "name": "Extract Current Shift Anomalies",
            "returnType": "object",
            "sourceCode": "var data = $context.$nodes.GET_CURRENT_SHIFT_ANOMALY_EVENTS_DATA.$output \n \nvar groups = {};\n\nfor (var i = 0; i < data.items.length; i++) {\n  var item = data.items[i];\n  var key = item.equipmentInstance.name + '_' + item.eventTime;\n  if (!groups[key]) {\n    groups[key] = [];\n  }\n  groups[key].push(item);\n}\n\nvar result = [];\nfor (var key in groups) {\n  var group = groups[key];\n  var obj = {};\n  var first = group[0];\n  obj[\"Asset Number\"] = first.asset.assetNumber;\n  obj[\"Equipment Instance\"] = first.equipmentInstance.name;\n  obj[\"Event Time\"] = first.eventTime;\n\n  for (var j = 0; j < group.length; j++) {\n    var it = group[j];\n    if (it.eventTypeAttribute.attributeCode === \"ANOMALY_NAME\") {\n      obj[\"name\"] = it.stringValue;\n    } else if (it.eventTypeAttribute.attributeCode === \"ANOMALY_CONTEXT\") {\n      obj[\"description\"] = it.stringValue;\n    } else if (it.eventTypeAttribute.attributeCode === \"DURATION\") {\n      obj[\"predictionWindow\"] = it.numericValue;\n    } else if (it.eventTypeAttribute.attributeCode === \"SEVERITY\") {\n      obj[\"probability\"] = it.stringValue;\n    }\n  }\n  result.push(obj);\n}\n\nreturn result[0];"
          },
          "outcomes": {
            "success": "1766872908779"
          },
          "diagram": {
            "x": 6866.5,
            "y": 7707
          },
          "code": "EXTRACT_CURRENT_SHIFT_ANOMALIES",
          "id": "1770083043190",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
