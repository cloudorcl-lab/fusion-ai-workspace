        {
          "metadata": {
            "name": "WS Reason code analysis flow"
          },
          "outcomes": {
            "0": "1776144949367",
            "1": "1776144970443"
          },
          "diagram": {
            "x": 6490.5,
            "y": 8649,
            "width": 856,
            "height": 792
          },
          "code": "WS_REASON_CODE_ANALYSIS_FLOW",
          "convergenceTargetId": "1776160359434",
          "id": "1776144926266",
          "inputs": [],
          "type": "PARALLEL"
        },
        {
          "metadata": {
            "name": "OP reason code analysis flow"
          },
          "outcomes": {
            "0": "1776405461830",
            "1": "1776405545700"
          },
          "diagram": {
            "x": 7496.5,
            "y": 8649,
            "width": 1228,
            "height": 1068
          },
          "code": "OP_REASON_CODE_ANALYSIS_FLOW",
          "convergenceTargetId": "1776428497867",
          "id": "1776405398609",
          "inputs": [],
          "type": "PARALLEL"
        },
        {
          "metadata": {
            "name": "Compute top n WS reason codes",
            "returnType": "object",
            "sourceCode": "const reasonCodeMapping = $context.$nodes.MAP_REASON_CODES_TO_LOSS_FUNCTIONS.$output;\nconst workstationStatuses = $context.$nodes.GET_WORKSTATION_STATUSES.$output;\nconst reasonCodes = $context.$nodes.GET_ALL_WS_REASON_CODES.$output;\nconst requestedTopN = 3;\n\nconst pickText = (...values) =>\n  String(\n    values.find((value) => value !== null && value !== undefined && String(value).trim() !== \"\") ??\n      \"\"\n  ).trim();\nconst toRows = (payload) =>\n  Array.isArray(payload) ? payload : Array.isArray(payload?.items) ? payload.items : [];\nconst toMinutes = (millis) => Number((millis / 60000).toFixed(2));\nconst ensureBucket = (map, key, seed) =>\n  map.get(key) ||\n  (map.set(key, { ...seed, TotalDurationMillis: 0 }), map.get(key));\n\nconst topN =\n  Number.isInteger(Number(requestedTopN)) && Number(requestedTopN) > 0\n    ? Number(requestedTopN)\n    : 3;\nconst statusRows = toRows(workstationStatuses);\nconst catalogRows = toRows(reasonCodes);\nconst lossFunctions = [\n  { source: \"OEEE\", target: \"oeee\" },\n  { source: \"Availability\", target: \"availability\" },\n  { source: \"Performance\", target: \"performance\" },\n];\n\nlet mappingRows = [];\nconst mappingCandidates = [\n  reasonCodeMapping,\n  reasonCodeMapping?.result,\n  reasonCodeMapping?.text,\n  reasonCodeMapping?.response,\n  reasonCodeMapping?.message,\n  reasonCodeMapping?.answer,\n  reasonCodeMapping?.output,\n  reasonCodeMapping?.data,\n];\n\nfor (const candidate of mappingCandidates) {\n  if (!mappingRows.length && candidate && typeof candidate === \"object\") {\n    if (Array.isArray(candidate.ReasonCodeMappings)) {\n      mappingRows = candidate.ReasonCodeMappings;\n      break;\n    }\n  }\n\n  if (!mappingRows.length && typeof candidate === \"string\") {\n    let jsonText = candidate.trim();\n    const firstBrace = jsonText.indexOf(\"{\");\n    const lastBrace = jsonText.lastIndexOf(\"}\");\n\n    if (firstBrace !== -1 && lastBrace > firstBrace) {\n      jsonText = jsonText.slice(firstBrace, lastBrace + 1).trim();\n    }\n\n    try {\n      const parsed = JSON.parse(jsonText);\n      if (Array.isArray(parsed?.ReasonCodeMappings)) {\n        mappingRows = parsed.ReasonCodeMappings;\n        break;\n      }\n    } catch {}\n  }\n}\n\nconst mappingIndexes = {\n  reasonStatus: new Map(),\n  reasonOnly: new Map(),\n  nameStatus: new Map(),\n  nameOnly: new Map(),\n};\nconst catalogIndexes = {\n  reasonStatus: new Map(),\n  reasonOnly: new Map(),\n  nameStatus: new Map(),\n  nameOnly: new Map(),\n};\n\nfor (const sourceRows of [\n  { rows: mappingRows, indexes: mappingIndexes },\n  { rows: catalogRows, indexes: catalogIndexes },\n]) {\n  for (const row of sourceRows.rows) {\n    const reasonCode = pickText(\n      row?.ReasonCode,\n      row?.WsReasonCodeId,\n      row?.WorkstationReasonCode,\n      row?.WorkstationReasonCodeId,\n      row?.WorkstationReasonCodeCode,\n      row?.reasonCode\n    );\n    const reasonCodeName = pickText(\n      row?.ReasonCodeName,\n      row?.WorkstationReasonCodeName,\n      row?.reasonCodeName\n    );\n    const workstationStatusCode = pickText(\n      row?.WorkstationStatusCode,\n      row?.workstationStatusCode\n    );\n    const workstationStatusName = pickText(\n      row?.WorkstationStatusName,\n      row?.WorkstationStatus,\n      row?.workstationStatusName,\n      row?.workstationStatus\n    );\n\n    const lossCategoryCode = pickText(row?.LossCategoryCode);\n    const mappedLossFunctions = row?.LossFunctions && typeof row.LossFunctions === \"object\"\n      ? row.LossFunctions\n      : {};\n\n    const normalizedRow = {\n      ReasonCode: reasonCode || null,\n      ReasonCodeName: reasonCodeName || null,\n      WorkstationStatusCode: workstationStatusCode || null,\n      WorkstationStatusName: workstationStatusName || null,\n      LossFunctions: {\n        OEEE: {\n          Contributes:\n            mappedLossFunctions?.OEEE?.Contributes === true ||\n            lossCategoryCode === \"AVAILABILITY_LOSS\" ||\n            lossCategoryCode === \"PERFORMANCE_LOSS\",\n        },\n        Availability: {\n          Contributes:\n            mappedLossFunctions?.Availability?.Contributes === true ||\n            lossCategoryCode === \"AVAILABILITY_LOSS\",\n        },\n        Performance: {\n          Contributes:\n            mappedLossFunctions?.Performance?.Contributes === true ||\n            lossCategoryCode === \"PERFORMANCE_LOSS\",\n        },\n      },\n    };\n\n    if (reasonCode) {\n      if (workstationStatusCode) {\n        sourceRows.indexes.reasonStatus.set(\n          reasonCode + \"||\" + workstationStatusCode,\n          normalizedRow\n        );\n      }\n      if (!sourceRows.indexes.reasonOnly.has(reasonCode)) {\n        sourceRows.indexes.reasonOnly.set(reasonCode, normalizedRow);\n      }\n    }\n\n    if (reasonCodeName) {\n      if (workstationStatusCode) {\n        sourceRows.indexes.nameStatus.set(\n          reasonCodeName + \"||\" + workstationStatusCode,\n          normalizedRow\n        );\n      }\n      if (!sourceRows.indexes.nameOnly.has(reasonCodeName)) {\n        sourceRows.indexes.nameOnly.set(reasonCodeName, normalizedRow);\n      }\n    }\n  }\n}\n\nconst aggregateByLoss = {\n  OEEE: { totalDurationMillis: 0, buckets: new Map() },\n  Availability: { totalDurationMillis: 0, buckets: new Map() },\n  Performance: { totalDurationMillis: 0, buckets: new Map() },\n};\nconst uncategorized = {\n  totalDurationMillis: 0,\n  buckets: new Map(),\n};\n\nlet totalTrackedDurationMillis = 0;\n\nfor (const statusRow of statusRows) {\n  const startMillis = new Date(statusRow?.StartTime ?? statusRow?.startTime ?? \"\").getTime();\n  const endMillis = new Date(statusRow?.EndTime ?? statusRow?.endTime ?? \"\").getTime();\n  const durationMillis =\n    Number.isFinite(startMillis) && Number.isFinite(endMillis) && endMillis > startMillis\n      ? endMillis - startMillis\n      : 0;\n\n  if (durationMillis <= 0) {\n    continue;\n  }\n\n  totalTrackedDurationMillis += durationMillis;\n\n  const reasonCode = pickText(\n    statusRow?.ReasonCode,\n    statusRow?.WsReasonCodeId,\n    statusRow?.WorkstationReasonCode,\n    statusRow?.WorkstationReasonCodeId,\n    statusRow?.WorkstationReasonCodeCode,\n    statusRow?.reasonCode\n  );\n  const reasonCodeName = pickText(\n    statusRow?.ReasonCodeName,\n    statusRow?.WorkstationReasonCodeName,\n    statusRow?.reasonCodeName\n  );\n  const workstationStatusCode = pickText(\n    statusRow?.WorkstationStatusCode,\n    statusRow?.workstationStatusCode\n  );\n  const workstationStatusName = pickText(\n    statusRow?.WorkstationStatusName,\n    statusRow?.WorkstationStatus,\n    statusRow?.workstationStatusName,\n    statusRow?.workstationStatus\n  );\n\n  if (!reasonCode && !reasonCodeName) {\n    const bucketKey =\n      \"STATUS_WITHOUT_REASON_CODE||\" +\n      (workstationStatusCode || workstationStatusName || \"UNKNOWN_STATUS\");\n    const bucket = ensureBucket(uncategorized.buckets, bucketKey, {\n      ReasonCode: null,\n      ReasonCodeName: null,\n      BucketType: \"STATUS_WITHOUT_REASON_CODE\",\n    });\n\n    bucket.TotalDurationMillis += durationMillis;\n    uncategorized.totalDurationMillis += durationMillis;\n    continue;\n  }\n\n  let mappedRow =\n    mappingIndexes.reasonStatus.get(reasonCode + \"||\" + workstationStatusCode) ||\n    mappingIndexes.reasonOnly.get(reasonCode) ||\n    mappingIndexes.nameStatus.get(reasonCodeName + \"||\" + workstationStatusCode) ||\n    mappingIndexes.nameOnly.get(reasonCodeName) ||\n    null;\n\n  if (!mappedRow) {\n    mappedRow =\n      catalogIndexes.reasonStatus.get(reasonCode + \"||\" + workstationStatusCode) ||\n      catalogIndexes.reasonOnly.get(reasonCode) ||\n      catalogIndexes.nameStatus.get(reasonCodeName + \"||\" + workstationStatusCode) ||\n      catalogIndexes.nameOnly.get(reasonCodeName) ||\n      null;\n  }\n\n  if (!mappedRow) {\n    const bucketKey =\n      \"UNMAPPED_REASON_CODE||\" + (reasonCode || reasonCodeName || workstationStatusCode);\n    const bucket = ensureBucket(uncategorized.buckets, bucketKey, {\n      ReasonCode: reasonCode || null,\n      ReasonCodeName: reasonCodeName || null,\n      BucketType: \"UNMAPPED_REASON_CODE\",\n    });\n\n    bucket.TotalDurationMillis += durationMillis;\n    uncategorized.totalDurationMillis += durationMillis;\n    continue;\n  }\n\n  for (const lossFunction of lossFunctions) {\n    if (!mappedRow.LossFunctions?.[lossFunction.source]?.Contributes) {\n      continue;\n    }\n\n    const bucketKey = reasonCode || reasonCodeName;\n    const bucket = ensureBucket(aggregateByLoss[lossFunction.source].buckets, bucketKey, {\n      ReasonCode: reasonCode || null,\n      ReasonCodeName: reasonCodeName || null,\n    });\n\n    bucket.TotalDurationMillis += durationMillis;\n    aggregateByLoss[lossFunction.source].totalDurationMillis += durationMillis;\n  }\n}\n\nconst lossFunctionOutput = {};\n\nfor (const lossFunction of lossFunctions) {\n  const rows = [...aggregateByLoss[lossFunction.source].buckets.values()]\n    .map((bucket) => ({\n      ReasonCode: bucket.ReasonCode,\n      ReasonCodeName: bucket.ReasonCodeName,\n      TotalDurationMillis: bucket.TotalDurationMillis,\n      TotalDurationMinutes: toMinutes(bucket.TotalDurationMillis),\n    }))\n    .sort(\n      (a, b) =>\n        b.TotalDurationMillis - a.TotalDurationMillis ||\n        String(a.ReasonCode ?? a.ReasonCodeName ?? \"\").localeCompare(\n          String(b.ReasonCode ?? b.ReasonCodeName ?? \"\")\n        )\n    );\n\n  lossFunctionOutput[lossFunction.target] = {\n    totalContributingDurationMillis: aggregateByLoss[lossFunction.source].totalDurationMillis,\n    totalContributingDurationMinutes: toMinutes(\n      aggregateByLoss[lossFunction.source].totalDurationMillis\n    ),\n    topReasonCodes: rows.slice(0, topN),\n  };\n}\n\nconst uncategorizedRows = [...uncategorized.buckets.values()]\n  .map((bucket) => ({\n    ReasonCode: bucket.ReasonCode,\n    ReasonCodeName: bucket.ReasonCodeName,\n    BucketType: bucket.BucketType,\n    TotalDurationMillis: bucket.TotalDurationMillis,\n    TotalDurationMinutes: toMinutes(bucket.TotalDurationMillis),\n  }))\n  .sort(\n    (a, b) =>\n      b.TotalDurationMillis - a.TotalDurationMillis ||\n      String(a.ReasonCode ?? a.ReasonCodeName ?? a.BucketType ?? \"\").localeCompare(\n        String(b.ReasonCode ?? b.ReasonCodeName ?? b.BucketType ?? \"\")\n      )\n  );\n\nlossFunctionOutput.uncategorized = {\n  totalDurationMillis: uncategorized.totalDurationMillis,\n  totalDurationMinutes: toMinutes(uncategorized.totalDurationMillis),\n  topEntries: uncategorizedRows.slice(0, topN),\n};\n\nconst result = {\n  topN,\n  totalTrackedDurationMillis,\n  totalTrackedDurationMinutes: toMinutes(totalTrackedDurationMillis),\n  lossFunction: lossFunctionOutput,\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776162783545"
          },
          "diagram": {
            "x": 7133.579250264349,
            "y": 9789.079250264349
          },
          "code": "COMPUTE_TOP_N_WS_REASON_CODES",
          "id": "1776160359434",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Compute top n OP reason codes",
            "returnType": "object",
            "sourceCode": "const reasonCodeMapping = $context.$nodes.MAP_REASON_CODES_TO_OPERATION_TRANSACTIONS.$output ?? {};\n\nconst productionTransactions = $context.$nodes.COLLECT_OPERATION_TRANSACTIONS_FROM_ALL_WORK_ORDERS.$output ?? {};\n\nconst requestedTopN = 3;\n\nconst pickText = (...values) =>\n  String(\n    values.find((value) => value !== null && value !== undefined && String(value).trim() !== \"\") ??\n      \"\"\n  ).trim();\nconst toRows = (payload) =>\n  Array.isArray(payload)\n    ? payload.flatMap((row) =>\n        Array.isArray(row?.items)\n          ? row.items\n          : Array.isArray(row?.result)\n            ? row.result\n            : row\n      )\n    : Array.isArray(payload?.result)\n      ? payload.result\n      : Array.isArray(payload?.items)\n        ? payload.items\n        : [];\nconst toFixedNumber = (value, digits = 2) => Number(Number(value || 0).toFixed(digits));\nconst ensureBucket = (map, key, seed) => map.get(key) || (map.set(key, { ...seed }), map.get(key));\n\nconst topN =\n  Number.isInteger(Number(requestedTopN)) && Number(requestedTopN) > 0\n    ? Number(requestedTopN)\n    : 3;\n\nlet mapping = {\n  TransactionTypeMappings: [],\n  ReasonCodeCatalog: [],\n  AcceptedCategoryTypes: [\"WO_OP_TXN\"],\n  Fallbacks: {\n    UncategorizedReasonCode: \"UNCATEGORIZED\",\n    UncategorizedReasonCodeName: \"Uncategorized\",\n  },\n  LossFunctionSettings: {\n    Quality: {\n      QuantityFieldCandidates: [\"PrimaryQuantity\", \"Quantity\", \"PrimaryOutput\"],\n      ReferenceFieldCandidates: [\n        \"Parenttransactionreference\",\n        \"Operationtransactionreference\",\n        \"ParentTransactionReference\",\n        \"OperationTransactionReference\",\n      ],\n    },\n  },\n};\n\nfor (const candidate of [\n  reasonCodeMapping,\n  reasonCodeMapping?.result,\n  reasonCodeMapping?.text,\n  reasonCodeMapping?.response,\n  reasonCodeMapping?.message,\n  reasonCodeMapping?.answer,\n  reasonCodeMapping?.output,\n  reasonCodeMapping?.data,\n]) {\n  if (Array.isArray(candidate?.TransactionTypeMappings)) {\n    mapping = {\n      ...mapping,\n      ...candidate,\n    };\n    break;\n  }\n\n  if (typeof candidate === \"string\") {\n    let jsonText = candidate.trim();\n    const firstBrace = jsonText.indexOf(\"{\");\n    const lastBrace = jsonText.lastIndexOf(\"}\");\n\n    if (firstBrace !== -1 && lastBrace > firstBrace) {\n      jsonText = jsonText.slice(firstBrace, lastBrace + 1).trim();\n    }\n\n    try {\n      const parsed = JSON.parse(jsonText);\n      if (Array.isArray(parsed?.TransactionTypeMappings)) {\n        mapping = {\n          ...mapping,\n          ...parsed,\n        };\n        break;\n      }\n    } catch {}\n  }\n}\n\nconst txTypeIndex = new Map();\nconst reasonCodeIndex = new Map();\n\nfor (const row of Array.isArray(mapping.TransactionTypeMappings) ? mapping.TransactionTypeMappings : []) {\n  const transactionType = pickText(row?.TransactionType, row?.LookupCode);\n  if (transactionType) {\n    txTypeIndex.set(transactionType, row);\n  }\n}\n\nfor (const row of Array.isArray(mapping.ReasonCodeCatalog) ? mapping.ReasonCodeCatalog : []) {\n  const reasonCode = pickText(row?.ReasonCode, row?.LookupCode);\n  if (reasonCode) {\n    reasonCodeIndex.set(reasonCode, row);\n  }\n}\n\nconst acceptedCategoryTypes = new Set(\n  Array.isArray(mapping.AcceptedCategoryTypes) && mapping.AcceptedCategoryTypes.length\n    ? mapping.AcceptedCategoryTypes\n    : [\"WO_OP_TXN\"]\n);\nconst quantityFieldCandidates =\n  Array.isArray(mapping?.LossFunctionSettings?.Quality?.QuantityFieldCandidates) &&\n  mapping.LossFunctionSettings.Quality.QuantityFieldCandidates.length\n    ? mapping.LossFunctionSettings.Quality.QuantityFieldCandidates\n    : [\"PrimaryQuantity\", \"Quantity\", \"PrimaryOutput\"];\nconst referenceFieldCandidates =\n  Array.isArray(mapping?.LossFunctionSettings?.Quality?.ReferenceFieldCandidates) &&\n  mapping.LossFunctionSettings.Quality.ReferenceFieldCandidates.length\n    ? mapping.LossFunctionSettings.Quality.ReferenceFieldCandidates\n    : [\n        \"Parenttransactionreference\",\n        \"Operationtransactionreference\",\n        \"ParentTransactionReference\",\n        \"OperationTransactionReference\",\n      ];\n\nconst transactions = toRows(productionTransactions)\n  .slice()\n  .sort(\n    (a, b) =>\n      (new Date(pickText(a?.Transactiondate, a?.TransactionDate)).getTime() || 0) -\n      (new Date(pickText(b?.Transactiondate, b?.TransactionDate)).getTime() || 0)\n  );\n\nconst qualityTotals = {\n  DenominatorQuantity: 0,\n  GoodQuantity: 0,\n  BadQuantity: 0,\n};\nconst reasonBuckets = new Map();\nconst badQuantityLedger = new Map();\n\nfor (const row of transactions) {\n  const categoryType = pickText(row?.Categorytype, row?.CategoryType);\n  if (acceptedCategoryTypes.size && !acceptedCategoryTypes.has(categoryType)) {\n    continue;\n  }\n\n  const transactionType = pickText(row?.Transactiontype, row?.TransactionType);\n  const mappingRow = txTypeIndex.get(transactionType);\n  const qualityRule = mappingRow?.LossFunctions?.Quality;\n\n  if (!mappingRow || qualityRule?.Contributes !== true) {\n    continue;\n  }\n\n  let quantity = 0;\n  for (const fieldName of quantityFieldCandidates) {\n    const numericValue = Number(row?.[fieldName]);\n    if (pickText(row?.[fieldName]) && Number.isFinite(numericValue)) {\n      quantity = numericValue;\n      break;\n    }\n  }\n\n  if (quantity <= 0) {\n    continue;\n  }\n\n  const denominatorDelta = Number(qualityRule?.DenominatorDelta);\n  const goodDelta = Number(qualityRule?.GoodQuantityDelta);\n  const badDelta = Number(qualityRule?.BadQuantityDelta);\n  const reasonAttributionMode = pickText(qualityRule?.ReasonAttributionMode).toUpperCase();\n\n  qualityTotals.DenominatorQuantity += (Number.isFinite(denominatorDelta) ? denominatorDelta : 0) * quantity;\n  qualityTotals.GoodQuantity += (Number.isFinite(goodDelta) ? goodDelta : 0) * quantity;\n  qualityTotals.BadQuantity += (Number.isFinite(badDelta) ? badDelta : 0) * quantity;\n\n  if ((Number.isFinite(badDelta) ? badDelta : 0) > 0) {\n    const uncategorizedCode =\n      pickText(mapping?.Fallbacks?.UncategorizedReasonCode) || \"UNCATEGORIZED\";\n    const uncategorizedName =\n      pickText(mapping?.Fallbacks?.UncategorizedReasonCodeName) || \"Uncategorized\";\n    const rawReasonCode = pickText(row?.Reasoncode, row?.ReasonCode);\n    const catalogRow = reasonCodeIndex.get(rawReasonCode);\n    const reasonCode = rawReasonCode || uncategorizedCode;\n    const reasonCodeName =\n      pickText(\n        catalogRow?.ReasonCodeName,\n        catalogRow?.Meaning,\n        catalogRow?.Description,\n        row?.ReasonCodeName,\n        reasonCode === uncategorizedCode ? uncategorizedName : reasonCode\n      ) || uncategorizedName;\n\n    const bucket = ensureBucket(reasonBuckets, reasonCode, {\n      ReasonCode: reasonCode,\n      ReasonCodeName: reasonCodeName,\n      NetBadQuantity: 0,\n    });\n\n    bucket.NetBadQuantity += badDelta * quantity;\n\n    const ledgerEntry = {\n      ReasonCode: reasonCode,\n      ReasonCodeName: reasonCodeName,\n      RemainingBadQuantity: badDelta * quantity,\n    };\n    const referenceKeys = [];\n\n    for (const fieldName of referenceFieldCandidates) {\n      const referenceValue = pickText(row?.[fieldName]);\n      if (referenceValue && !referenceKeys.includes(referenceValue)) {\n        referenceKeys.push(referenceValue);\n      }\n    }\n\n    const transactionId = pickText(row?.Transactionid, row?.TransactionId);\n    if (transactionId && !referenceKeys.includes(transactionId)) {\n      referenceKeys.push(transactionId);\n    }\n\n    for (const referenceKey of referenceKeys) {\n      if (!badQuantityLedger.has(referenceKey)) {\n        badQuantityLedger.set(referenceKey, ledgerEntry);\n      }\n    }\n\n    continue;\n  }\n\n  if ((Number.isFinite(badDelta) ? badDelta : 0) < 0 && reasonAttributionMode === \"ORIGINATING_BAD_REASON\") {\n    let quantityToReverse = Math.abs(badDelta * quantity);\n    const referenceKeys = [];\n\n    for (const fieldName of referenceFieldCandidates) {\n      const referenceValue = pickText(row?.[fieldName]);\n      if (referenceValue && !referenceKeys.includes(referenceValue)) {\n        referenceKeys.push(referenceValue);\n      }\n    }\n\n    const transactionId = pickText(row?.Transactionid, row?.TransactionId);\n    if (transactionId && !referenceKeys.includes(transactionId)) {\n      referenceKeys.push(transactionId);\n    }\n\n    for (const referenceKey of referenceKeys) {\n      if (quantityToReverse > 0) {\n        const ledgerEntry = badQuantityLedger.get(referenceKey);\n\n        if (ledgerEntry?.RemainingBadQuantity > 0) {\n          const appliedQuantity = Math.min(quantityToReverse, ledgerEntry.RemainingBadQuantity);\n          const bucket = ensureBucket(reasonBuckets, ledgerEntry.ReasonCode, {\n            ReasonCode: ledgerEntry.ReasonCode,\n            ReasonCodeName: ledgerEntry.ReasonCodeName,\n            NetBadQuantity: 0,\n          });\n\n          bucket.NetBadQuantity -= appliedQuantity;\n          ledgerEntry.RemainingBadQuantity -= appliedQuantity;\n          quantityToReverse -= appliedQuantity;\n        }\n      }\n    }\n  }\n}\n\nconst firstTransactionQuantityUOM =\n    pickText(\n      transactions.find((row) => {\n        const categoryType = pickText(row?.Categorytype, row?.CategoryType);\n        if (acceptedCategoryTypes.size && !acceptedCategoryTypes.has(categoryType)) {\n          return false;\n        }\n\n        return quantityFieldCandidates.some((fieldName) => {\n          const numericValue = Number(row?.[fieldName]);\n          return pickText(row?.[fieldName]) && Number.isFinite(numericValue) && numericValue > 0;\n        });\n      })?.UOM\n    ) || null;\n\nconst denominator = qualityTotals.DenominatorQuantity > 0 ? qualityTotals.DenominatorQuantity : 0;\nconst topReasonCodes = [...reasonBuckets.values()]\n  .map((bucket) => ({\n    ReasonCode: bucket.ReasonCode,\n    ReasonCodeName: bucket.ReasonCodeName,\n    NetBadQuantity: toFixedNumber(bucket.NetBadQuantity),\n    QualityLossPctPoints:\n      denominator > 0 ? toFixedNumber((bucket.NetBadQuantity / denominator) * 100) : 0,\n  }))\n  .filter((row) => row.NetBadQuantity > 0)\n  .sort(\n    (a, b) =>\n      b.QualityLossPctPoints - a.QualityLossPctPoints ||\n      b.NetBadQuantity - a.NetBadQuantity ||\n      String(a.ReasonCode || \"\").localeCompare(String(b.ReasonCode || \"\"))\n  )\n  .slice(0, topN);\n\nlet result = {\n  topN,\n  quality: {\n    UOM: firstTransactionQuantityUOM,\n    DenominatorQuantity: toFixedNumber(qualityTotals.DenominatorQuantity),\n    GoodQuantity: toFixedNumber(qualityTotals.GoodQuantity),\n    BadQuantity: toFixedNumber(qualityTotals.BadQuantity),\n    EstimatedQualityPercent:\n      denominator > 0 ? toFixedNumber((qualityTotals.GoodQuantity / denominator) * 100) : null,\n    EstimatedQualityLossPercent:\n      denominator > 0 ? toFixedNumber((qualityTotals.BadQuantity / denominator) * 100) : null,\n    topReasonCodes,\n  },\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776162783545"
          },
