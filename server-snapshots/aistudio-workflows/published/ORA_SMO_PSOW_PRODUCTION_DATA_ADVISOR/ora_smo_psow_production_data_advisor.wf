          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Parse previous n shifts response",
            "returnType": "object",
            "sourceCode": "const shiftsInput = $context.$nodes.GET_PREVIOUS_N_SHIFTS.$output;\nconst numberOfShifts = 25;\n\nfunction getShiftStartTime(shift) {\n  return Date.parse(shift?.StartDateTime || shift?.StartDateTimeUTC || \"\");\n}\n\nconst shifts = Array.isArray(shiftsInput.result)\n  ? shiftsInput.result\n      .slice()\n      .sort((a, b) => getShiftStartTime(b) - getShiftStartTime(a))\n      .slice(0, numberOfShifts)\n      .reverse()\n  : [];\n\n  return shifts;"
          },
