n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"rel\": {\n                  \"type\": \"string\"\n                },\n                \"href\": {\n                  \"type\": \"string\"\n                },\n                \"name\": {\n                  \"type\": \"string\"\n                },\n                \"kind\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"required\": [\n                \"rel\",\n                \"href\",\n                \"name\",\n                \"kind\"\n              ],\n              \"additionalProperties\": false\n            }\n          }\n        },\n        \"required\": [\n          \"Workorderid\",\n          \"Transactionid\",\n          \"Organizationid\",\n          \"Workordernumber\",\n          \"Workordertype\",\n          \"Workordertypedescription\",\n          \"ExecutionRunNumber\",\n          \"Operationsequence\",\n          \"Operationname\",\n          \"Operationtype\",\n          \"Transactiondate\",\n          \"Transactiontype\",\n          \"Transactiontypemeaning\",\n          \"Productitemnumber\",\n          \"Inventoryitemid\",\n          \"Componentnumber\",\n          \"Componentitemid\",\n          \"Resourcename\",\n          \"Resourceinstance\",\n          \"Quantity\",\n          \"UOM\",\n          \"Secondarytransactionquantity\",\n          \"SecondaryUOM\",\n          \"Subinventory\",\n          \"Locatorcode\",\n          \"Licenseplatenumber\",\n          \"Externalsystempackingunit\",\n          \"Revision\",\n          \"Lotnumber\",\n          \"GradeCode\",\n          \"Parentlotnumber\",\n          \"Itemserialnumber\",\n          \"Itemuniquedeviceidentifier\",\n          \"Componentserialnumber\",\n          \"Ismultiplelot\",\n          \"Ismultipleitemserial\",\n          \"Ismultiplecomponentserial\",\n          \"Ismultipleparentlot\",\n          \"Activitytype\",