        {
          "metadata": {
            "name": "Extract Current Shift Failure Predictions",
            "returnType": "object",
            "sourceCode": "var data =   $context.$nodes.GET_CURRENT_SHIFT_FAILURE_PREDICTION_EVENTS_DATA.$output \n\nvar groups = {};\n\nfor (var i = 0; i < data.items.length; i++) {\n  var item = data.items[i];\n  var key = item.equipmentInstance.name + '_' + item.eventTime;\n  if (!groups[key]) {\n    groups[key] = [];\n  }\n  groups[key].push(item);\n}\n\nvar result = [];\nfor (var key in groups) {\n  var group = groups[key];\n  var obj = {};\n  var first = group[0];\n  obj[\"Asset Number\"] = first.asset.assetNumber;\n  obj[\"Equipment Instance\"] = first.equipmentInstance.name;\n  obj[\"Event Time\"] = first.eventTime;\n\n  for (var j = 0; j < group.length; j++) {\n    var it = group[j];\n    if (it.eventTypeAttribute.attributeCode === \"NAME\") {\n      obj[\"name\"] = it.stringValue;\n    } else if (it.eventTypeAttribute.attributeCode === \"DESCRIPTION\") {\n      obj[\"description\"] = it.stringValue;\n    } else if (it.eventTypeAttribute.attributeCode === \"PREDICTION_WINDOW_IN_HOURS\") {\n      obj[\"predictionWindow\"] = it.numericValue;\n    } else if (it.eventTypeAttribute.attributeCode === \"PROBABILITY\") {\n      obj[\"probability\"] = it.numericValue * 100;\n    }\n  }\n  result.push(obj);\n}\n\nreturn result[0];"
          },
          "outcomes": {
            "success": "1766872908779"
          },
          "diagram": {
            "x": 7853.5,
            "y": 7707
