        {
          "metadata": {
            "name": "Check If Action is legitimate",
            "returnType": "object",
            "sourceCode": "let debuggingState = {};\nlet a = false;\n\nlet invoiceRecord =\n  $context.$nodes.PRJ_PJB_BUSINESS_OBJ_FUN_GET_INVOICES.$output.items?.[0];\n\nlet invoiceStatus = invoiceRecord?.InvoiceStatusCode;   // e.g. \"DRAFT\"\nlet invoiceType = invoiceRecord?.InvoiceTypeCode;\ndebuggingState.invoiceType = invoiceType;\ndebuggingState.invoiceStatus=invoiceStatus;\n\nlet userIntent =\n  $context.$nodes.PRJ_PJB_LLM_EXTRACT_OBJECT_AND_INTENT.$output.Intent;\n\nlet invoiceConstants =\n  $context.$nodes.PRJ_PJB_CODE_INVOICE_STATUS_CONSTANTS.$output.result;\n\nlet meta = invoiceConstants.meta;\n\nlet toState='NONE';\n\nconst ACTIONS = meta.actions;\nconst STATUS = meta.status;\n\nconst intentStr = String(userIntent ?? \"\").trim().toUpperCase();\n\ndebuggingState.intent = userIntent;\n\n// --- intent -> action ---\nlet action = -1;\nswitch (intentStr) {\n  case \"SUBMIT\":\n    action = ACTIONS.INVOICE_ACTION_SUBMIT;\n    toState = STATUS.INVOICE_SUBMITTED_STATUS;\n    break;\n  case \"APPROVE\":\n    action = ACTIONS.INVOICE_ACTION_APPROVE;\n     toState = STATUS.INVOICE_APPROVED_STATUS;\n    break;\n  case \"REJECT\":\n    action = ACTIONS.INVOICE_ACTION_APPROVAL_REJECT;\n     toState = STATUS.INVOICE_APPROVAL_REJECTED_STATUS;\n    break;\n  case \"REVERT\":\n    action = ACTIONS.INVOICE_ACTION_REVERT_TO_DRAFT;\n    toState = STATUS.INVOICE_DRAFT_STATUS;\n    break;\n  case \"RELEASE\":\n    action = ACTIONS.INVOICE_ACTION_RELEASE;\n     toState = STATUS.INVOICE_RELEASED_STATUS;\n    break;\n  case \"TRANSFER\":\n    action = ACTIONS.INVOICE_ACTION_TRANSFER;\n    toState = STATUS.INVOICE_TRANSFERRED_STATUS;\n    break;\n  case  \"CANCEL\":\n    action = ACTIONS.INVOICE_ACTION_CANCEL;\n     toState = -1; //Does not matter .adding just for consistency sake. \n    break;\n  default:\n    action = -1;\n   toState = 'NONE';\n}\ndebuggingState.action = action;\ndebuggingState.toState=toState;\n\n\n// --- invoiceStatus string -> status code ---\nconst state = String(invoiceStatus ?? \"\").trim().toUpperCase();\n\n\nlet status = -1;\nswitch (state) {\n  case \"DRAFT\":\n    status = STATUS.INVOICE_DRAFT_STATUS;\n    break;\n  case \"SUBMITTED\":\n    status = STATUS.INVOICE_SUBMITTED_STATUS;\n    break;\n  case \"APPROVED\":\n    status = STATUS.INVOICE_APPROVED_STATUS;\n    break;\n  case \"APPROVAL_REJECTED\":\n    status = STATUS.INVOICE_APPROVAL_REJECTED_STATUS;\n    break;\n  case \"RELEASED\":\n  case \"REJECTED\":\n    status = STATUS.INVOICE_RELEASED_STATUS;\n    break;\n  case \"TRANSFERRED\":\n    status = STATUS.INVOICE_TRANSFERRED_STATUS;\n    break;\n case \"ACCEPTED\":\n    status = STATUS.INVOICE_ACCEPTED_STATUS;\n    break;\n  default:\n    status = -1;\n}\ndebuggingState.status = status;\n\nlet ALLOWED_ACTIONS_BY_STATUS = invoiceConstants.ALLOWED_ACTIONS_BY_STATUS;\n// --- allowed actions lookup (ALLOWED_ACTIONS_BY_STATUS keyed by status code) ---\nconst allowed = ALLOWED_ACTIONS_BY_STATUS?.[String(status)];\nconst actionAllowedOnStatus =  allowed.includes(action);\n\ndebuggingState.allowed = allowed;\n//debuggingState.actionAllowedOnStatus1 =allowed instanceof Set ;\ndebuggingState.ALLOWED_ACTIONS_BY_STATUS= ALLOWED_ACTIONS_BY_STATUS;\n//debuggingState.actionAllowedOnStatus1 = allowed.has(action);\ndebuggingState.actionAllowedOnStatus = actionAllowedOnStatus;\n\nlet SubmitStatus=$context.$nodes.PRJ_PJB_CODE_INVOICE_STATUS_CONSTANTS.$output.result.meta.status.INVOICE_SUBMITTED_STATUS\ndebuggingState.SubmitStatus=SubmitStatus;\n\nreturn debuggingState;"
          },
          "outcomes": {
            "success": "1772563628274"
          },
          "code": "PRJ_PJB_CODE_CHECK_IF_ACTION_IS_LEGITIMATE",
