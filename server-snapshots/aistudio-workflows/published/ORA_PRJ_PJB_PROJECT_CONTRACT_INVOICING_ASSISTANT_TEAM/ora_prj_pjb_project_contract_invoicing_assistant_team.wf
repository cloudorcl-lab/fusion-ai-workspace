        {
          "metadata": {
            "name": "Invoice Status Constants",
            "returnType": "object",
            "sourceCode": "const meta = Object.freeze({\n  status: Object.freeze({\n    INVOICE_DRAFT_STATUS: 0,\n    INVOICE_SUBMITTED_STATUS: 1,\n    INVOICE_APPROVED_STATUS: 2,\n    INVOICE_APPROVAL_REJECTED_STATUS: 3,\n    INVOICE_RELEASED_STATUS: 4,\n    INVOICE_TRANSFERRED_STATUS: 5,\n    INVOICE_ACCEPTED_STATUS: 6\n  }),\n  actions: Object.freeze({\n    INVOICE_ACTION_DRAFT: 0,\n    INVOICE_ACTION_SUBMIT: 1,\n    INVOICE_ACTION_APPROVE: 2,\n    INVOICE_ACTION_APPROVAL_REJECT: 3,\n    INVOICE_ACTION_REVERT_TO_DRAFT: 4,\n    INVOICE_ACTION_RELEASE: 5,\n    INVOICE_ACTION_TRANSFER: 6,\n    INVOICE_ACTION_CANCEL: 7\n  })\n});\n\n\nconst ALLOWED_ACTIONS_BY_STATUS = {\n  [meta.status.INVOICE_DRAFT_STATUS]:  [\n    meta.actions.INVOICE_ACTION_SUBMIT,\n    meta.actions.INVOICE_ACTION_APPROVE,\n    meta.actions.INVOICE_ACTION_APPROVAL_REJECT,\n    meta.actions.INVOICE_ACTION_RELEASE,\n    meta.actions.INVOICE_ACTION_TRANSFER\n  ],\n  [meta.status.INVOICE_SUBMITTED_STATUS]: [\n    meta.actions.INVOICE_ACTION_APPROVE,\n    meta.actions.INVOICE_ACTION_APPROVAL_REJECT,\n    meta.actions.INVOICE_ACTION_RELEASE,\n    meta.actions.INVOICE_ACTION_TRANSFER,\n    meta.actions.INVOICE_ACTION_REVERT_TO_DRAFT\n  ],\n  [meta.status.INVOICE_APPROVED_STATUS]: [\n    meta.actions.INVOICE_ACTION_RELEASE,\n    meta.actions.INVOICE_ACTION_TRANSFER\n  ],\n  [meta.status.INVOICE_APPROVAL_REJECTED_STATUS]: [\n    meta.actions.INVOICE_ACTION_REVERT_TO_DRAFT\n  ],\n  [meta.status.INVOICE_RELEASED_STATUS]: [\n      meta.actions.INVOICE_ACTION_TRANSFER \n  ],\n  //    meta.actions.INVOICE_ACTION_CANCEL  --bug 330000\n\n  // Define explicitly so lookups don't return undefined\n  [meta.status.INVOICE_TRANSFERRED_STATUS]: [\n //    meta.actions.INVOICE_ACTION_CANCEL   --bug 330000\n  ],\n  [meta.status.INVOICE_ACCEPTED_STATUS]: [\n     meta.actions.INVOICE_ACTION_CANCEL\n  ]\n};\n\n\n\n\nconst invoiceConstants = Object.freeze({\n  meta,\n  ALLOWED_ACTIONS_BY_STATUS\n});\n\nreturn invoiceConstants;"
          },
          "outcomes": {
            "success": "1774383197259"
          },
          "code": "PRJ_PJB_CODE_INVOICE_STATUS_CONSTANTS",
