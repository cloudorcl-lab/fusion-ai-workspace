              },
              "code": "ORA_LLM_MODEL_PROVIDER_CERT_BASIC_LLAMA_3_3_70B",
              "model": "ORA_LLM_MODEL_GPT_OSS_120B",
              "modelName": "Gpt Oss",
              "provider": "CERT_BASIC"
            },
            "name": "Extract Object and Intent"
          },
          "outcomes": {
            "success": "1772511292626"
          },
          "code": "PRJ_PJB_LLM_EXTRACT_OBJECT_AND_INTENT",
          "id": "1772425007889",
          "inputs": [
            {
              "id": "1772425007891_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an information extraction engine for project contract invoices. Use CURRENT INPUT first. Use CHAT HISTORY only for direct continuation turns. Do not invent facts.\n\nIF {{$context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.Relevant == 'Yes'}} AND {{$context.$nodes.PRJ_PJB_CODE_CHECK_SOURCE.$output.result == 'RedwoodUI'}} THEN\n\nReturn ONLY valid JSON (no extra text) with exactly these keys and casing:\n{\n  \"billing_period\": {\n    \"start_date\": null,\n    \"end_date\": null,\n    \"raw_text\": null\n  },\n  \"business_unit\": null,\n  \"customer\": null,\n  \"project\": null,\n  \"ContractNumber\": null,\n  \"Intent\": null,\n  \"action\": null,\n  \"message\": null,\n  \"invoiceStatus\": null,\n  \"invoiceDate\": null,\n  \"receivablesInvoiceNumber\": null,\n  \"invoiceNumber\": null,\n  \"ambiguities\": [],\n  \"clarifying_questions\": [],\n  \"missingInformation\": null,\n  \"ChatHistory\": \"\",\n  \"language\": \"\"\n}\n\nExtraction rules for RedwoodUI relevant path:\n\n1. billing_period.start_date\n{{$context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.billing_period.start_date == null ? $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.OldBillingPeriodStartDate : $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.billing_period.start_date}}\n\n2. billing_period.end_date\n{{$context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.billing_period.end_date == null ? $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.OldBillingPeriodEndDate : $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.billing_period.end_date}}\n\n3. billing_period.raw_text\n{{$context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.billing_period.raw_text == null ? $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.OldBillingPeriodRawText : $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.billing_period.raw_text}}\n\n4. business_unit\n{{$context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.business_unit == null ? $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.OldBusinessUnit : $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.business_unit}}\n\n5. customer\n{{$context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.customer == null ? $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.OldCustomer : $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.customer}}\n\n6. project\n{{$context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.project == null ? $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.OldProject : $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.project}}\n\n7. ContractNumber\n{{$context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.ContractNumber == null ? $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.OldContractNumber : $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.ContractNumber}}\n\n8. Intent\n{{$context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.Intent == null ? $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.OldIntent : $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.Intent}}\n\n9. action\n{{$context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.action == null ? $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.OldAction : $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.action}}\n\n10. message\n{{$context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.AmbiguityReasonCode}}\n\n11. invoiceStatus\n{{$context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.invoiceStatus == null ? $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.OldInvoiceStatus : $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.invoiceStatus}}\n\n12. invoiceDate\n{{$context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.invoiceDate == null ? $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.OldInvoiceDate : $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.invoiceDate}}\n\n13. receivablesInvoiceNumber\n{{$context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.receivablesInvoiceNumber == null ? $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.OldReceivablesInvoiceNumber : $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.receivablesInvoiceNumber}}\n\n14. invoiceNumber\n{{$context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.invoiceNumber == null ? $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.OldInvoiceNumber : $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.invoiceNumber}}\n\n15. ambiguities\nIf {{$context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.AmbiguityReasonCode}} is null then return []. Otherwise return [{\"reasonCode\": {{$context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.AmbiguityReasonCode}} }].\n\n16. clarifying_questions\nIf {{$context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.AmbiguityReasonCode}} is null then return []. Otherwise return [{{$context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.AmbiguityReasonCode}}].\n\n17. missingInformation\nIf {{$context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.action}} == 'Act' and {{$context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.ContractNumber == null ? $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.OldContractNumber : $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.ContractNumber}} == null and {{$context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.invoiceNumber == null ? $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.OldInvoiceNumber : $context.$nodes.PRJ_PJB_LLM_RELEVANCY_CHECKER.$output.invoiceNumber}} == null then set to \"BothMissing\".\nIf only ContractNumber is null then set to \"MissingContract\".\nIf only invoiceNumber is null then set to \"MissingInvoiceNumber\".\nOtherwise set to null.\n\n18. ChatHistory\n{{$context.$system.$chatHistory}}\n\n19. language\nReturn the language of the user's CURRENT INPUT.\n\nEND IF.\n\nIf any attribute remains null after the RedwoodUI relevant-path derivation above, use the existing extraction logic below only to derive the remaining null attributes. Do not overwrite attributes already derived from the RedwoodUI path.\n\nA direct continuation turn is a reply to the immediately preceding assistant question, for example:\n- yes / no / do it / continue / approve it / release it\n- only a contract number\n- only an invoice number\n- only a receivables number\n- only an invoice date\nContinuation rules:\n- If the current input clearly provides intent, contract number, and invoice number, ignore history and use only the current input.\n- If the current input is a direct continuation turn for an Act flow, you may inherit Intent, ContractNumber, and invoiceNumber from the most recent relevant chat history when they are omitted in the current input.\n- Special case: if the immediately preceding assistant message asks for a receivables number in order to release an approved invoice, and the user now provides only the receivables number, then set Intent=\"Release\", action=\"Act\", receivablesInvoiceNumber from CURRENT INPUT, and inherit ContractNumber and invoiceNumber from the most recent relevant release context in CHAT HISTORY.\n- Never inherit business_unit, customer, project, invoiceStatus, invoiceDate, or receivablesInvoiceNumber from history.\n- For Get/List intents, never infer invoiceNumber or other filters from history unless they are explicitly present in the current input.\n- If history contains multiple possible contract/invoice candidates, use the most recent one only when the immediately preceding assistant message clearly refers to the same invoice task; otherwise leave ambiguous fields null and add a clarifying question.\nCHAT HISTORY:\n {{$context.$system.$chatHistory}}\nINPUT:\n {{$context.$variables.prjPjbVarUqWorkflowInput}}\nReturn ONLY valid JSON (no extra text) with exactly these keys and casing:\n{\n  \"billing_period\": {\n    \"start_date\": null,\n    \"end_date\": null,\n    \"raw_text\": null\n  },\n  \"business_unit\": null,\n  \"customer\": null,\n  \"project\": null,\n  \"ContractNumber\": null,\n  \"Intent\": null,\n  \"action\": null,\n  \"message\": null,\n  \"invoiceStatus\": null,\n  \"invoiceDate\": null,\n  \"receivablesInvoiceNumber\": null,\n  \"invoiceNumber\": null,\n  \"ambiguities\": [],\n  \"clarifying_questions\": [],\n  \"missingInformation\": null,\n  \"ChatHistory\": \"\",\n  \"language\": \"\"\n}\nExtraction rules\n- Assume the user wants draft standard invoices unless they explicitly ask for something else. If they mention credit memo, prepayment, or intercompany, capture that in ambiguities.\n- Billing period: \\\n-For relative ranges like \"last N months/weeks/quarters\":\n    - Default to the last N complete calendar periods immediately preceding the current period (exclude the current partial period).\n  Example: \"last 2 months\" = the two full months before the current month.\n    - Derive start_date as the first day of the oldest included period and end_date as the last day of the most recent included period.\n-Use {{$context.$system.$currentDate}} as the current date when interpreting relative dates and calculating start_date and end_date. If relative dates are used, calculate the range relative to {{$context.$system.$currentDate}}. If only a single date is provided, use it for both start_date and end_date. Only if no date can be resolved even after using {{$context.$system.$currentDate}}, set both to null.\nif only a single date is provided , set start_date and end_date to same date in YYYY-MM-DD\nif dates could not be derived assign null to start_date and end_date\n- Capture business_unit, customer, project, and ContractNumber exactly as written. Preserve punctuation and special characters.\n- If both project and contract are provided, capture both.\n- If the user provides multiple values for the same field, store the most specific one and add the rest to ambiguities with clarifying_questions.\n- If the user provides a bare value without identifying whether it is business unit, customer, project, or period, do not guess. Add an ambiguity and a clarifying question.\n- Invoice status normalization: draft, in draft, unsubmitted, not submitted, work in progress, wip, preliminary, saved -> DRAFT; approval rejected, rejected in approval, rejected by approver, approver rejected, rejected during approval, failed approval, approval failure, returned rejected -> APPROVAL_REJECTED; approved, approval complete, fully approved, approved by approver, approved in workflow, passed approval -> APPROVED; submitted, submit, submitted for approval, pending approval, awaiting approval, in approval, under approval review -> SUBMITTED; finalize, confirm, close invoice, complete invoice, sign off invoice, publish invoice -> RELEASED; transfer invoice to AR, transfer invoice to receivables, pass invoice to billing, dispatch invoice to customer, issue invoice to customer -> TRANSFERRED; accepted, tie back, confirmed invoice acceptance -> ACCEPTED.\n- Intent detection: get, show, list, display, fetch, retrieve, view, review, lookup, look up, pull up, find, search, query, what are the invoices, which invoices -> Get. approve, approval, mark as approved, set status to approved, complete approval -> Approve. submit, submit for approval, send for approval, route for approval, move to submitted, set status to submitted, initiate approval -> Submit. finalize, confirm, close invoice, complete invoice, sign off invoice, publish invoice -> Release. return to draft, move to draft, revert, move to edit mode, prepare for corrections, withdraw invoice, stop invoice, recall invoice -> Revert. not approve, reject approval, reject invoice, mark as reject, set status as reject -> Reject. void invoice, cancel invoice, invalidate invoice, nullify invoice, issue a credit memo -> Cancel. send to AR, transfer to AR, interface to AR, push to AR, send to receivables, transfer to receivables, interface to receivables, generate AR transaction, create AR invoice -> Transfer. get invoice lines, display invoice lines, get invoice distributions, get detailed invoice -> Details.\n- Guardrails for intent: \"approved invoices\", \"submitted invoices\", and \"transferred invoices\" used as filters are Get, not actions.\n- If no clear action verb exists in the current input, but the turn is a direct continuation of the immediately preceding assistant question, inherit Intent from the active task in history. Otherwise set Intent to null.\n- If multiple action intents are present, set Intent to null and add an ambiguity.\n- Set action to List when Intent is Get or Details. Set action to Act when Intent is Approve, Submit, Reject, Revert, Release, Transfer, or Cancel. Otherwise set action to null.\n- invoiceNumber rules: if invoiceNumber is explicitly provided, capture it. invoiceNumber can never be 0. Examples: \"4th invoice on contract ABC\" -> ContractNumber=ABC and invoiceNumber=4; \"invoice 1 on contract DFG\" -> ContractNumber=DFG and invoiceNumber=1; \"Contract QWE invoice 5\" -> ContractNumber=QWE and invoiceNumber=5. For List/Get intents, do not inherit invoiceNumber from history. For Act continuations, you may inherit invoiceNumber from the most recent relevant history when the current input omits it.\n- missingInformation rules: if action is Act and both ContractNumber and invoiceNumber are null, set missingInformation to BothMissing. If only ContractNumber is null, set MissingContract. If only invoiceNumber is null, set MissingInvoiceNumber. Otherwise set missingInformation to null.\n- invoiceStatus must not be inherited from history for Act intents. If the user asks for invoices in all statuses, set invoiceStatus to null.\n- invoiceDate must come only from CURRENT INPUT. Do not inherit invoiceDate from history.\n- receivablesInvoiceNumber must come only from CURRENT INPUT. Do not inherit receivablesInvoiceNumber from history.\n- ChatHistory should be a concise 2-line summary.\n- language should capture the language of the user's CURRENT INPUT.\n- Project extraction:\n  - If text contains the keyword \"project\" followed by a value, extract that value into project.\n  - Supported patterns include:\n    - project XYZ\n    - Project XYZ\n    - project 'XYZ'\n    - project \"XYZ\"\n    - project: XYZ\n    - for project XYZ\n    - invoices for project XYZ\n    - draft invoices for project XYZ\n  - If the project value is enclosed in single or double quotes, preserve the exact text inside the quotes.\n  - Project names may contain spaces, numbers, punctuation, hyphens, underscores, slashes, and special characters.\n  - Stop project extraction at common separators such as:\n    - and\n    - with\n    - contract\n    - customer\n    - business unit\n    - invoice\n    - status\n    - billing period\n    unless the value is enclosed in quotes.\n  - When both customer and project are present, map values using the nearest preceding keyword.\n    Example:\n      get invoices for customer ABD and project 'XYZ'\n      -> customer = \"ABD\"\n      -> project = \"XYZ\"\n  - If multiple project values are provided, store the most specific project in project and add the remaining values to ambiguities with a clarifying question.\n  - Never infer a project from an unqualified value. A value must be explicitly associated with the keyword \"project\" to populate the project field.\n  Examples:\n    get invoices for project 'EWS PUC1 Project B'\n      -> project = \"EWS PUC1 Project B\"\n\n    get invoices for Project ABC-123\n      -> project = \"ABC-123\"\n\n    get draft invoices for project \"XYS\"\n      -> project = \"XYS\"\n\n    get invoices for customer ABD and project XYZ\n      -> customer = \"ABD\"\n      -> project = \"XYZ\""
            }
          ],
          "outputSpecification": "{\n    \"billing_period\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"start_date\": { \"type\": \"string\", \"format\": \"date\" },\n        \"end_date\": { \"type\": \"string\", \"format\": \"date\" },\n        \"raw_text\": { \"type\": \"string\" }\n      },\n      \"required\": []\n    },\n    \"business_unit\": { \"type\": \"string\" },\n    \"customer\": { \"type\": \"string\" },\n    \"project\": { \"type\": \"string\" },\n    \"ContractNumber\": { \"type\": \"string\" },\n    \"Intent\": { \"type\": \"string\" },\n    \"action\": { \"type\": \"string\" },\n    \"message\": { \"type\": \"string\" },\n    \"invoiceStatus\": { \"type\": \"string\" },\n     \"invoiceDate\": { \"type\": \"string\", \"format\": \"date\" },\n    \"invoiceNumber\": { \"type\": \"string\"},\n    \"receivablesInvoiceNumber\": { \"type\": \"string\" },\n    \"ambiguities\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"object\" },\n      \"default\": []\n    },\n    \"clarifying_questions\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" },\n      \"default\": []\n    },\n    \"missingInformation\": { \"type\": \"string\" },\n   \"ChatHistory\":{ \"type\": \"string\" },\n   \"language\": { \"type\": \"string\"},\n  }",
          "type": "LLM"
        },
