{
  "workflowId": "300000331058761",
  "workflowCode": "ORA_PRJ_PJB_PROJECT_CONTRACT_INVOICING_ASSISTANT_TEAM",
  "name": "Project Contract Invoicing Assistant",
  "description": "The Project Contract Invoicing Assistant helps streamline the lifecycle of project contract invoices, from initial drafts to approved invoices sent to clients. It continuously detects and surfaces invoicing exceptions, provides targeted insights for rapid resolution, and enables policy-based invoice approvals. By increasing end-to-end automation, the assistant significantly reduces processing time and the need for manual intervention.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
