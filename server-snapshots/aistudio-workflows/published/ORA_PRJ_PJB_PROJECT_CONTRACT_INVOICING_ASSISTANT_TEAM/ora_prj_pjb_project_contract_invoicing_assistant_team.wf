        {
          "metadata": {
            "name": "List Invoices",
            "returnType": "object",
            "sourceCode": "// 1) Source data (invoices)\nlet nodeOut = $context.$nodes.PRJ_PJB_BUSINESS_OBJ_FUN_GET_INVOICES.$output;\nconst removedColumns =\n  $context.$nodes.PRJ_PJB_CODE_PREPARE_INVOICE_QUERY?.$output?.result?.filterArr ?? [];\n\nlet invoiceItems = nodeOut.items ?? [];\nlet totalResults = nodeOut.totalResults ?? invoiceItems.length;\n\n// 2) Table configuration\n//Business Unit, Contract Number, Customer, Invoice Number, Type, Status, Date, Receivables Number, and Invoice Amount in Invoice Currency.\n\nconst tableConfig = {\n  tableName: \"Please refer to the details below.\",\n  columnName: [\n    \"Business Unit\",\n    \"Contract Number\",\n    \"Customer\",\n    \"Invoice Number\",\n     \"Type\",\n    \"Status\",\n    \"Date\",\n    \"Receivables Number\",\n    \"Invoice Amount in Invoice Currency\",\n  ],\n  columns: [\n    \"OrganizationName\",\n    \"ContractNumber\",\n    \"BillToCustomerName\",\n    \"InvoiceNumber\",\n   \"InvoiceTypeMeaning\",\n    \"InvoiceStatusMeaning\",\n    \"InvoiceDate\",\n    \"ReceivablesNumber\",\n    \"InvoiceAmount\",\n  ],\n  removedColumns,\n  maxRows: 10,\n};\n\nconst escapeHtml = (v) =>\n  String(v ?? \"-\")\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n\nconst formatInvoiceAmountWithCurrency = (row) => {\n  const amount =\n    row?.InvoiceAmountInInvoiceCurrency ??\n    row?.InvoiceAmount ??\n    row?.Amount ??\n    null;\n\n  const currencyCode = row?.InvoiceCurrencyCode ?? \"\";\n\n  if (amount === null || amount === undefined || amount === \"\") {\n    return currencyCode || \"-\";\n  }\n\n  return currencyCode ? `${amount} ${currencyCode}` : String(amount);\n};\n\nconst getDisplayColumns = (columnName, columns, removedColumns) => {\n  const removed = new Set((removedColumns ?? []).map(String));\n\n  return (columns ?? [])\n    .map((column, index) => ({\n      column,\n      header: columnName?.[index] ?? column,\n    }))\n    .filter(({ column }) => !removed.has(column));\n};\n\nconst renderTable = (items, displayColumns, maxRows) => {\n  const headHtml =\n    \"<thead><tr>\" +\n    displayColumns\n      .map(\n        ({ header }) =>\n          `<th style=\"padding:6px; text-align:center; white-space:normal; border:1px solid #E4E1DD;\">${escapeHtml(header)}</th>`\n      )\n      .join(\"\") +\n    \"</tr></thead>\";\n\n  const bodyRows = (items ?? [])\n    .slice(0, maxRows)\n    .map(\n      (it) =>\n        \"<tr>\" +\n        displayColumns\n          .map(({ column }) => {\n            const value =\n              column === \"InvoiceAmount\"\n                ? formatInvoiceAmountWithCurrency(it)\n                : it?.[column];\n\n            return `<td style=\"padding:6px; text-align:center; white-space:normal; overflow-wrap:anywhere; border:1px solid #E4E1DD;\" >${escapeHtml(value)}</td>`;\n          })\n          .join(\"\") +\n        \"</tr>\"\n    )\n    .join(\"\");\n\n  const bodyHtml = \"<tbody>\" + bodyRows + \"</tbody>\";\n\n  const more =\n    (items ?? []).length > maxRows\n      ? `<div>Showing ${maxRows} of ${totalResults} rows.</div>`\n      : \"\";\n\n  return `<div style=\"display:block; max-width:100%; max-height:320px; overflow:auto; box-sizing:border-box; font-size:12px\"><div>${escapeHtml(\n    tableConfig.tableName\n  )}</div>\n</br>\n<table cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%; border-collapse:collapse; font-family:'Oracle Sans', Arial, sans-serif; table-layout:fixed; border:1px solid #E4E1DD;\">${headHtml}${bodyHtml}</table>${more}</div>`;\n};\n\nconst displayColumns = getDisplayColumns(\n  tableConfig.columnName,\n  tableConfig.columns,\n  tableConfig.removedColumns\n);\n\n// 3) Output (do not add more elements)\nreturn {\n  totalResults: totalResults,\n  TableName: tableConfig.tableName,\n  TableHTML: renderTable(\n    invoiceItems,\n    displayColumns,\n    tableConfig.maxRows\n  ),\n  maxRows: tableConfig.maxRows,\n  invoiceItems:invoiceItems\n};"
          },
          "outcomes": {
            "success": "2901800000007"
          },
          "code": "PRJ_PJB_CODE_LIST_INVOICES",
          "convergenceTargetId": "1775996581629",
          "id": "1774412523422",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
