            "name": "Process Extract",
            "returnType": "object",
            "sourceCode": "let extractObj={};\n\n/*\nextractObj.ambiguities = $context.$nodes.PRJ_PJB_LLM_EXTRACT_OBJECT_AND_INTENT.$output.ambiguities;\nextractObj.clarifying_questions=$context.$nodes.PRJ_PJB_LLM_EXTRACT_OBJECT_AND_INTENT.$output.clarifying_questions;\nextractObj.ambiguities_len=$context.$nodes.PRJ_PJB_LLM_EXTRACT_OBJECT_AND_INTENT.$output.ambiguities.length;\nextractObj.clarifying_questions_len=$context.$nodes.PRJ_PJB_LLM_EXTRACT_OBJECT_AND_INTENT.$output.clarifying_questions.length;\nextractObj.clarificationQ_html ='';\n\nif(extractObj.clarifying_questions_len > 0 ) {\n     const clarifyingQuestions =\n        $context.$nodes.PRJ_PJB_LLM_EXTRACT_OBJECT_AND_INTENT.$output.clarifying_questions;;\n\n     const htmlString = `\n      <div>There are some clarifications needed </div>\n      <div style=\"height:8px;\"></div>\n      <ul>\n      ${clarifyingQuestions\n          .filter(q => typeof q === \"string\" && q.trim().length > 0)\n          .map(q => `<li><b>${q}</b></li>`)\n          .join(\"\")}\n    </ul>\n   <div style=\"height:8px;\"></div>\n   <div>Which one should I start with?</div>\n`;\nextractObj.clarificationQ_html = htmlString;\n}\n\n*/\n\nreturn extractObj;"
          },
