            "returnType": "string",
            "sourceCode": "return JSON.stringify((() => {\n  function decodeHtmlEntities(str) {\n    return String(str)\n      .replace(/&nbsp;/g, ' ')\n      .replace(/&amp;/g, '&')\n      .replace(/&lt;/g, '<')\n      .replace(/&gt;/g, '>')\n      .replace(/&quot;/g, '\"')\n      .replace(/&#39;/g, \"'\");\n  }\n\n  function stripTags(str) {\n    return decodeHtmlEntities(\n      String(str == null ? '' : str)\n        .replace(/<br\\s*\\/?>/gi, '\\n')\n        .replace(/<\\/div>\\s*<div[^>]*>/gi, '\\n')\n        .replace(/<\\/p>\\s*<p[^>]*>/gi, '\\n')\n        .replace(/<li[^>]*>/gi, '- ')\n        .replace(/<\\/li>/gi, '\\n')\n        .replace(/<[^>]+>/g, '')\n    )\n      .replace(/\\n{3,}/g, '\\n\\n')\n      .trim();\n  }\n\n  function isBlank(value) {\n    return value == null || String(value).trim() === '';\n  }\n\n  function normalizeChatHistoryText(value) {\n    return String(value == null ? '' : value)\n      .replace(/\"/g, \"'\")\n      .trim();\n  }\n\n  function formatTimestamp(value) {\n    const date = value ? new Date(value) : new Date();\n    if (Number.isNaN(date.getTime())) {\n      return '';\n    }\n    const pad = (num) => String(num).padStart(2, '0');\n    return pad(date.getUTCDate()) + '-' + pad(date.getUTCMonth() + 1) + '-' + date.getUTCFullYear() + ' ' + pad(date.getUTCHours()) + ':' + pad(date.getUTCMinutes());\n  }\n\n  const rawMessage = $context.$nodes.PRJ_PJB_LLM_MISSING_INFO_MESSAGE.$output;\n  const text = stripTags(rawMessage);\n  const historyText = normalizeChatHistoryText(text);\n  const extractOutput = $context.$nodes.PRJ_PJB_LLM_EXTRACT_OBJECT_AND_INTENT.$output || {};\n  const contextDetails = {};\n  Object.keys(extractOutput).forEach((key) => {\n    const value = extractOutput[key];\n    if (!isBlank(value)) {\n      contextDetails[key] = key === 'ChatHistory' ? normalizeChatHistoryText(value) : value;\n    }\n  });\n\n  if (isBlank(contextDetails.ChatHistory) && !isBlank(historyText)) {\n    contextDetails.ChatHistory = historyText;\n  }\n  const atomicAgentContext = !isBlank(extractOutput.Intent) ? String(extractOutput.Intent) : (!isBlank(extractOutput.action) ? String(extractOutput.action) : 'None');\n  return {\n    agent: 'ORA_PRJ_PJB_PROJECT_CONTRACT_INVOICING_ASSISTANT_TEAM',\n    intent: atomicAgentContext,\n    schema_version: '1',\n    title: 'Project Contract Invoicing Assistant Response',\n    description: text,\n    timestamp: formatTimestamp($context.$system.$currentDate),\n    agent_response: [{\n      display_type: 'text',\n      display_sequence: 1,\n      text\n    }],\n    atomicAgentDetails: {\n      atomicAgentName: 'ORA_PRJ_PJB_PROJECT_CONTRACT_INVOICING_ASSISTANT_TEAM',\n      atomicAgentContext,\n      contextDetails,\n      filters: Object.assign({}, contextDetails)\n    }\n  };\n})());"
