        {
          "metadata": {
            "name": "Invoice Details Missing Information Processing",
            "returnType": "object",
            "sourceCode": "let missingInfoDetails = {};\n\n\nconst intent =\n  $context?.$nodes?.PRJ_PJB_LLM_EXTRACT_OBJECT_AND_INTENT?.$output?.Intent ?? null;\n\nconst missingInformation =\n  $context?.$nodes?.PRJ_PJB_LLM_EXTRACT_OBJECT_AND_INTENT?.$output?.missingInformation ?? null;\n\n\nconst verbByIntent = {\n  Approve: \"approved\",\n  Submit: \"submit for approval\",\n  Reject: \"rejected\",\n  Revert: \"return to draft\",\n  Release: \"released\",\n Cancel: \"cancelled\"\n};\n\nconst verb = verbByIntent[intent] || \"\"; // fallback jus in case..do not delete this line.\n\nlet message = null;\n\nif (missingInformation === \"BothMissing\") {\n  message =\n    `Please provide the contract name or number and the invoice number ` +\n    `so that I can identify which invoice to be ${verb}`;\n} else if (missingInformation === \"MissingInvoiceNumber\") {\n  message =\n    `Please provide the invoice number ` +\n    `so that I can identify which invoice to be ${verb}`;\n} else if (missingInformation === \"MissingContract\") {\n  message =\n    `Please provide the contract name or number ` +\n    `so that I can identify which invoice to be ${verb}`;\n}\nreturn { \"intent\" : intent, \n\"missingInformation\" : missingInformation, \n\"verb\" : verb, \n\"message\" :  message};"
          },
          "outcomes": {
            "success": "1775997066730"
          },
          "code": "INVOICE_DETAILS_MISSING_INFORMATION_PROCESSING",
          "convergenceTargetId": "1774333398826",
          "id": "1774329045313",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Prepare message Action Not Allowed",
            "returnType": "string",
            "sourceCode": "let debug ={};\n// Build the \"not allowed\" message (use JS string / template literal)\nconst contractNumber =\n  $context.$nodes.PRJ_PJB_LLM_EXTRACT_OBJECT_AND_INTENT.$output?.ContractNumber ?? \"\";\nconst invoiceNumber =\n  $context.$nodes.PRJ_PJB_LLM_EXTRACT_OBJECT_AND_INTENT.$output?.invoiceNumber ?? \"\";\nconst statusMeaning =\n  $context.$nodes.PRJ_PJB_CODE_EXTRACT_INVOICE_DETAILS.$output?.result?.statusMeaning ?? \"\";\nconst intent =\n  $context.$nodes.PRJ_PJB_CODE_CHECK_IF_ACTION_IS_LEGITIMATE.$output?.result?.intent ?? \"\";\n\nconst message =\n  `I have identified the contract ${contractNumber} and invoice ${invoiceNumber}. ` +\n  `However, the invoice is currently in the ${statusMeaning} status and action ${intent} is not allowed.`;\n\nconst invoiceState =\n  $context.$nodes.PRJ_PJB_CODE_CHECK_IF_ACTION_IS_LEGITIMATE.$output?.result?.status;\nconst invoiceDestinationState =\n  $context.$nodes.PRJ_PJB_CODE_CHECK_IF_ACTION_IS_LEGITIMATE.$output?.result?.toState;\n\ndebug.invoiceState=invoiceState;\ndebug.invoiceDestinationState=invoiceDestinationState;\ndebug.message=message;\n// If different states, return \"not allowed\" message\nif (invoiceState !== invoiceDestinationState) {\n  return message;\n}\n\n// Same state -> Prepare message\nconst invoiceConstants =\n  $context.$nodes.PRJ_PJB_CODE_INVOICE_STATUS_CONSTANTS.$output?.result;\nconst meta = invoiceConstants?.meta ?? {};\nconst ACTIONS = meta.actions; // kept in case you use later\nconst STATUS = meta.status;   // kept in case you use later\n\nconst invoiceRecord =\n  $context.$nodes.PRJ_PJB_BUSINESS_OBJ_FUN_GET_INVOICES.$output?.items?.[0] ?? {};\n\nconst invoiceStatus = invoiceRecord.InvoiceStatusCode;        // e.g. \"DRAFT\"\nconst invoiceStatusMeaning = invoiceRecord.InvoiceStatusMeaning; // e.g. \"Draft\"\n\nlet nextStatus = \"\";\nlet currStatus = invoiceStatusMeaning ?? \"\"; // default to meaning if available\n\nswitch (invoiceStatus) {\n  case \"SUBMITTED\":\n    nextStatus = \"approve\";\n    currStatus = \"Submitted\";\n    break;\n  case \"APPROVED\":\n    nextStatus = \"release\";\n    currStatus = \"Approved\";\n    break;\n  case \"APPROVAL_REJECTED\":\n    currStatus = \"Rejected\";\n    break;\n  case \"RELEASED\":\n    currStatus = \"Released\";\n    break;\n  case \"DRAFT\":\n    currStatus = \"Draft\";\n    break;\n  // Other statuses: keep currStatus as meaning (or blank) and no nextStatus\n  default:\n    break;\n}\n\nlet invoiceStatusMsg = `I see that the invoice is already ${currStatus || invoiceStatusMeaning || \"in the current status\"}.`;\nif (nextStatus) {\n  invoiceStatusMsg += ` Would you like to ${nextStatus} it?`;\n}\ndebug.message=invoiceStatusMsg;\nreturn invoiceStatusMsg;"
          },
          "outcomes": {
            "success": "1775995023171"
          },
          "code": "PRJ_PJB_CODE_PREPARE_MESSAGE_ACTION_NOT_ALLOWED",
          "id": "1774377673748",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Prepare invoice Query",
            "returnType": "object",
            "sourceCode": "function isPresent(v) {\n  return v !== null && v !== undefined && String(v).trim() !== \"\";\n}\n\nfunction escapeQuotes(str) {\n  // Minimal escaping for single quotes in literals\n  return encodeURIComponent(String(str).normalize(\"NFC\"));\n}\n\nfunction addEqString(clauses, field, value) {\n  if (!isPresent(value)) return;\n\n  const escapedValue = escapeQuotes(value);\n\n  if (field === \"ProjectNumber\") {\n    clauses.push(\n        `(InvoiceLines.InvoiceLineDistributions.TransactionProjectName ='${escapedValue}' OR InvoiceLines.InvoiceLineDistributions.TransactionProjectNumber ='${escapedValue}')`\n    );\n  } else {\n    clauses.push(`${field}='${escapedValue}'`);\n  }\n}\n\nfunction addEqNumber(clauses, field, value) {\n  if (value === null || value === undefined || value === \"\") return;\n  const n = Number(value);\n  if (!Number.isFinite(n)) return;\n  clauses.push(`${field}=${n}`);\n}\n\nfunction addDateRange(clauses, field, startDate, endDate) {\n  // If your backend expects a different date literal syntax, adjust here.\n  if (isPresent(startDate)) clauses.push(`${field}>='${escapeQuotes(startDate)}'`);\n  if (isPresent(endDate)) clauses.push(`${field}<='${escapeQuotes(endDate)}'`);\n}\n\nfunction buildInvoiceWhereClause(output) {\n  const clauses = [];\n  let action= $context.$nodes.PRJ_PJB_LLM_EXTRACT_OBJECT_AND_INTENT.$output.action;\n \n  addEqString(clauses, \"ContractNumber\", output?.ContractNumber);\n  addEqNumber(clauses, \"InvoiceNumber\", output?.invoiceNumber);\nif(action == 'List'){\n  addEqString(clauses, \"InvoiceStatusCode\", output?.invoiceStatus);\n  addEqString(clauses, \"OrganizationName\", output?.business_unit);\n  addEqString(clauses, \"BillToCustomerName\", output?.customer);\n  addEqString(clauses, \"ProjectNumber\", output?.project);  //Project is scoped out for 26C bug#39171116\n\n  const startDate = output?.billing_period?.start_date;\n  const endDate = output?.billing_period?.end_date;\n  addDateRange(clauses, \"InvoiceDate\", startDate, endDate);\n}\n  // If nothing provided, return empty string (or \"1=1\" if your system requires)\n  return clauses.length ? clauses.join(\" AND \") : \"\";\n}\n\nfunction buildFilterList(output){\nconst filterArr=[];\n    if (isPresent(output?.ContractNumber)) filterArr.push('ContractNumber');\n    if (isPresent(output?.invoiceNumber)) filterArr.push('InvoiceNumber');\n    if (isPresent(output?.invoiceStatus)) filterArr.push('InvoiceStatusMeaning'); //table displays meaning .\n    if (isPresent(output?.business_unit)) filterArr.push('OrganizationName');\n    if (isPresent(output?.customer)) filterArr.push('BillToCustomerName');\n    if (isPresent(output?.project)) filterArr.push('ProjectName');\n\n return filterArr;\n}\n\n// ---- Usage in your node/script context ----\nconst output = $context.$nodes.PRJ_PJB_LLM_EXTRACT_OBJECT_AND_INTENT.$output;\n\n// If you need full query string:\nconst whereClause = buildInvoiceWhereClause(output);\nconst query = whereClause ? `${whereClause}` : \"\";\n\n// Return or assign as needed\n//return query;\n\n//Return object with query and filter Columns\nconst filterArr = buildFilterList(output);\n\n let filterObject= {};\nfilterObject.query = query;\nfilterObject.filterArr = filterArr;\n\nreturn filterObject;"
          },
          "outcomes": {
            "success": "1772522888084"
          },
