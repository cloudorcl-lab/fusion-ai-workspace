        {
          "metadata": {
            "name": "Render Invoices Redwood",
            "returnType": "string",
            "sourceCode": "const result = $context.$nodes.PRJ_PJB_CODE_LIST_INVOICES.$output.result || {};\nconst extractOutput = $context.$nodes.PRJ_PJB_LLM_EXTRACT_OBJECT_AND_INTENT.$output || {};\nconst invoiceItems = Array.isArray(result.invoiceItems) ? result.invoiceItems : [];\nconst totalResults = Number(result.totalResults || invoiceItems.length || 0);\n\nfunction isBlank(value) {\n  return value === null || value === undefined || String(value).trim() === '';\n}\n\nfunction formatTimestamp(value) {\n  const date = value ? new Date(value) : new Date();\n  if (Number.isNaN(date.getTime())) {\n    return '';\n  }\n  const pad = (num) => String(num).padStart(2, '0');\n  return pad(date.getUTCDate()) + '-' + pad(date.getUTCMonth() + 1) + '-' + date.getUTCFullYear() + ' ' + pad(date.getUTCHours()) + ':' + pad(date.getUTCMinutes());\n}\n\nfunction formatAmount(row) {\n  const amount = row?.InvoiceAmountInInvoiceCurrency ?? row?.InvoiceAmount ?? row?.Amount ?? '';\n  const currency = row?.InvoiceCurrencyCode ?? '';\n  if (isBlank(amount)) {\n    return '';\n  }\n  return isBlank(currency) ? String(amount) : String(amount) + ' ' + String(currency);\n}\n\nconst rows = invoiceItems.slice(0, 10).map((row, index) => ({\n  sequenceId: index + 1,\n  businessUnit: isBlank(row?.OrganizationName) ? '' : String(row.OrganizationName),\n  contractNumber: isBlank(row?.ContractNumber) ? '' : String(row.ContractNumber),\n  customer: isBlank(row?.BillToCustomerName) ? '' : String(row.BillToCustomerName),\n  invoiceNumber: isBlank(row?.InvoiceNumber) ? '' : String(row.InvoiceNumber),\n  type: isBlank(row?.InvoiceTypeMeaning) ? '' : String(row.InvoiceTypeMeaning),\n  status: isBlank(row?.InvoiceStatusMeaning) ? '' : String(row.InvoiceStatusMeaning),\n  invoiceDate: isBlank(row?.InvoiceDate) ? '' : String(row.InvoiceDate),\n  receivablesNumber: isBlank(row?.ReceivablesNumber) ? '' : String(row.ReceivablesNumber),\n  invoiceAmount: formatAmount(row)\n}));\n\nconst intro = totalResults > rows.length\n  ? 'I found ' + totalResults + ' invoices. Here are the first ' + rows.length + '.'\n  : 'I found ' + totalResults + ' invoices matching your criteria.';\n\nconst contextDetails = {};\nObject.keys(extractOutput).forEach((key) => {\n  const value = extractOutput[key];\n  if (!isBlank(value)) {\n    contextDetails[key] = value;\n  }\n});\n\nconst atomicAgentContext = !isBlank(extractOutput.Intent) ? String(extractOutput.Intent) : (!isBlank(extractOutput.action) ? String(extractOutput.action) : 'None');\n\nreturn JSON.stringify({\n  agent: 'ORA_PRJ_PJB_PROJECT_CONTRACT_INVOICING_ASSISTANT_TEAM',\n  intent: atomicAgentContext,\n  schema_version: '1',\n  title: 'Project Contract Invoicing Assistant Response',\n  description: intro,\n  timestamp: formatTimestamp($context.$system.$currentDate),\n  agent_response: [\n    {\n      display_type: 'text',\n      display_sequence: 1,\n      text: intro\n    },\n    {\n      display_type: 'table',\n      display_sequence: 2,\n      rows: {\n        items: rows\n      },\n      columns: {\n        items: [\n          { headerText: 'Business Unit', field: 'businessUnit', id: 'businessUnit', resizable: 'enabled', template: '' },\n          { headerText: 'Contract Number', field: 'contractNumber', id: 'contractNumber', resizable: 'enabled', template: '' },\n          { headerText: 'Customer', field: 'customer', id: 'customer', resizable: 'enabled', template: '' },\n          { headerText: 'Invoice Number', field: 'invoiceNumber', id: 'invoiceNumber', resizable: 'enabled', template: '' },\n          { headerText: 'Type', field: 'type', id: 'type', resizable: 'enabled', template: '' },\n          { headerText: 'Status', field: 'status', id: 'status', resizable: 'enabled', template: '' },\n          { headerText: 'Date', field: 'invoiceDate', id: 'invoiceDate', resizable: 'enabled', template: 'dateTemplate' },\n          { headerText: 'Receivables Number', field: 'receivablesNumber', id: 'receivablesNumber', resizable: 'enabled', template: '' },\n          { headerText: 'Invoice Amount', field: 'invoiceAmount', id: 'invoiceAmount', resizable: 'enabled', template: 'cellTemplate' }\n        ]\n      },\n      keyAttributes: {\n        items: ['sequenceId']\n      },\n      accessibility: {\n        'aria-label': 'Project contract invoices list',\n        'row.accessible-row-header': 'invoiceNumber'\n      }\n    }\n  ],\n  atomicAgentDetails: {\n    atomicAgentName: 'ORA_PRJ_PJB_PROJECT_CONTRACT_INVOICING_ASSISTANT_TEAM',\n    atomicAgentContext,\n    contextDetails,\n    filters: Object.assign({}, contextDetails)\n  }\n});"
          },
          "outcomes": {
            "success": "2901800000009"
          },
          "code": "PRJ_PJB_CODE_RENDER_INVOICES_REDWOOD",
