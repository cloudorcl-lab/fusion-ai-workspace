          "inputs": [
            {
              "id": "1772563628277_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.PRJ_PJB_CODE_CHECK_IF_ACTION_IS_LEGITIMATE.$output.result.actionAllowedOnStatus}}"
