        {
          "metadata": {
            "name": "State Transition",
            "returnType": "array",
            "sourceCode": "//make change to get this from invoice constants\nconst meta = {\n  status: {\n    INVOICE_DRAFT_STATUS: 0,\n    INVOICE_SUBMITTED_STATUS: 1,\n    INVOICE_APPROVED_STATUS: 2,\n    INVOICE_APPROVAL_REJECTED_STATUS: 3,\n    INVOICE_RELEASED_STATUS: 4,\n    INVOICE_TRANSFERRED_STATUS: 5\n  },\n  actions: {\n    INVOICE_ACTION_DRAFT: 0,\n    INVOICE_ACTION_SUBMIT: 1,\n    INVOICE_ACTION_APPROVE: 2,\n    INVOICE_ACTION_APPROVAL_REJECT: 3,\n    INVOICE_ACTION_REVERT_TO_DRAFT: 4,\n    INVOICE_ACTION_RELEASE: 5,\n    INVOICE_ACTION_TRANSFER: 6,\n    INVOICE_ACTION_CANCEL: 7\n  }\n};\n\n// Build the state transition graph: fromStatus -> [{ to, action }, ...]  //mredrowt : todo review again\nconst transitions = new Map([\n  [meta.status.INVOICE_DRAFT_STATUS, [\n    { to: meta.status.INVOICE_SUBMITTED_STATUS, action: meta.actions.INVOICE_ACTION_SUBMIT }\n  ]],\n  [meta.status.INVOICE_SUBMITTED_STATUS, [\n    { to: meta.status.INVOICE_APPROVED_STATUS, action: meta.actions.INVOICE_ACTION_APPROVE },\n    { to: meta.status.INVOICE_APPROVAL_REJECTED_STATUS, action: meta.actions.INVOICE_ACTION_APPROVAL_REJECT }\n \n  ]],\n  [meta.status.INVOICE_APPROVAL_REJECTED_STATUS, [\n    { to: meta.status.INVOICE_DRAFT_STATUS, action: meta.actions.INVOICE_ACTION_REVERT_TO_DRAFT }\n  ]],\n  [meta.status.INVOICE_APPROVED_STATUS, [\n    { to: meta.status.INVOICE_RELEASED_STATUS, action: meta.actions.INVOICE_ACTION_RELEASE },\n     { to: meta.status.INVOICE_DRAFT_STATUS, action: meta.actions.INVOICE_ACTION_REVERT_TO_DRAFT }\n  ]],\n  [meta.status.INVOICE_RELEASED_STATUS, [\n    { to: meta.status.INVOICE_TRANSFERRED_STATUS, action: meta.actions.INVOICE_ACTION_TRANSFER }\n  ]]\n]);\n\n/**\n * mred : Using BFS ; mred review logic with peers \n */\n//for testing purpose\nconst startStatus =  $context.$nodes.PRJ_PJB_CODE_CHECK_IF_ACTION_IS_LEGITIMATE.$output.result.status;// meta.status.INVOICE_DRAFT_STATUS; \nconst endStatus   =  $context.$nodes.PRJ_PJB_CODE_CHECK_IF_ACTION_IS_LEGITIMATE.$output.result.toState;\n\n\n//  if (startStatus === endStatus) return [];\n\n\n   if($context.$nodes.PRJ_PJB_CODE_CHECK_IF_ACTION_IS_LEGITIMATE.$output.result.action === meta.actions.INVOICE_ACTION_CANCEL)\n       return [\"Cancel\"];\n\n  const visited = new Set([startStatus]);\n  const queue = [{ status: startStatus, actions: [] }];\nlet result = null;\n\nouter: while (queue.length) {\n  const { status, actions } = queue.shift();\n  const edges = transitions.get(status) || [];\n\n  for (const { to, action } of edges) {\n    if (visited.has(to)) continue;\n\n    const nextActions = actions.concat(action);\n    if (to === endStatus) {\n      result = nextActions;\n      break outer; // breaks the while-loop too --mred to review\n    }\n\n    visited.add(to);\n    queue.push({ status: to, actions: nextActions });\n  }\n}\n\n//return result;\n\nconst actionLabelByCode = {\n  [meta.actions.INVOICE_ACTION_DRAFT]: \"Draft\",\n  [meta.actions.INVOICE_ACTION_SUBMIT]: \"Submit\",\n  [meta.actions.INVOICE_ACTION_APPROVE]: \"Approve\",\n  [meta.actions.INVOICE_ACTION_APPROVAL_REJECT]: \"Reject\",\n  [meta.actions.INVOICE_ACTION_REVERT_TO_DRAFT]: \"RevertToDraft\",\n  [meta.actions.INVOICE_ACTION_RELEASE]: \"Release\",\n  [meta.actions.INVOICE_ACTION_TRANSFER]: \"Transfer\",\n};\n\nconst decoded = (result || []).map(code => actionLabelByCode[code] ?? `Unknown(${code})`);\n\nreturn decoded;"
          },
          "outcomes": {
            "success": "1775634366539"
          },
          "code": "PRJ_PJB_CODE_STATE_TRANSITION",
          "id": "1772565108143",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
