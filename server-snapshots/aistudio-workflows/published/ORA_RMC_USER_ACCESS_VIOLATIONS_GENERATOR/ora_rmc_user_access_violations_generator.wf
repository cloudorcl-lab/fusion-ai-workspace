                {
                  "metadata": {
                    "businessObjectCode": "ORA_GRC_OTHER_GETINTERROLEACCESSINCIDENTS",
                    "functionName": "getall_advancedControls-incidents",
                    "processJson": true,
                    "name": "GetInterRoleControlIncidents"
                  },
                  "outcomes": {
                    "success": "1765574407280"
                  },
                  "code": "GETCONTROLINCIDENTS",
                  "convergenceTargetId": "1765833980562",
                  "id": "1765553728935",
                  "inputs": [
                    {
                      "id": "1766022419841_1",
                      "name": "advancedControls_Id",
                      "type": "integer",
                      "value": "{{$context.$nodes.PROCESS_CONTROLS.$currentItem.Id}}"
                    }
                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "GetUserViolationSummary",
                    "returnType": "array",
                    "sourceCode": "let data = $context.$nodes.PROCESS_CONTROLS.GETCONTROLINCIDENTS.$output.items ; \n\nvar result = [];\nif (data.length > 0) {\n\nconst map = new Map();\n\n    data.forEach(item => {\n        const key = `${item.GlobalUserName}| ${item.Role} | ${item.Entitlement}`;\n        if (!map.has(key)) {\n            var roleCode = '';\n            if (item.IncidentInformationCodes) {\n              var parts = item.IncidentInformationCodes.split('>');\n              if (parts && parts.length > 0) {\n                roleCode = parts[0].trim();\n              }\n            }\n            map.set(key, {\n                UserName: item.GlobalUserName,\n                ControlName: item.ControlName,\n                Role: item.Role,\n                RoleCode: roleCode,\n                Entitlement: item.Entitlement,\n                ConflictingRoles: item.ConflictingRoles.slice(2, -2),\n                ResultIds: new Set(),\n                IsIntraRoleViol: item.IsIntraRoleViol,\n                NumIncidents: 0\n            });\n        }\n        const group = map.get(key);\n        group.NumIncidents++;\n        group.ResultIds.add(item.Id);\n    });\n\n    // Convert map to desired output array\n    result = Array.from(map.values()).map(group => ({\n        UserName: group.UserName,\n        ControlName: group.ControlName,\n        Role: group.Role,\n        RoleCode: group.RoleCode,\n        Entitlement: group.Entitlement,\n        ConflictingRoles: group.ConflictingRoles,  \n        ResultIds : Array.from(group.ResultIds).join(','),   \n        IsIntraRoleViol: group.IsIntraRoleViol,\n        NumIncidents: group.NumIncidents\n    }));\n}\n\nreturn result;"
                  },
                  "outcomes": {
                    "success": "end_1765833922555"
                  },
                  "code": "GETROLEVIOLATIONSUMMARY",
                  "convergenceTargetId": "1765833980562",
                  "id": "1765574407280",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                }
              ],
