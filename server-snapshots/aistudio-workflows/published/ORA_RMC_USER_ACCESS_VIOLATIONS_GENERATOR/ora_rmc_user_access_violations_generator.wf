            "name": "TransformControls",
            "returnType": "array",
            "sourceCode": "var items = $context.$nodes.GETACTIVEACCESSCONTROLS.$output.items; var result = []; for (var i = 0; i < items.length; i++) { var item = items[i]; result.push({ Id: parseInt(item.Id, 10), Name: item.Name }); } return result;"
          },
          "outcomes": {
            "success": "1765833922555"
          },
          "code": "TRANSFORM_CONTROLS",
          "id": "1765506012867",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"Id\": { \"type\": \"integer\" },\n      \"Name\": { \"type\": \"string\" }\n    }\n  }\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "dataPipeline": {
              "pipelineNodes": [
