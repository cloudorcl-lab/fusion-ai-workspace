          "code": "SETUSERVIOLATIONSUMMARY",
          "id": "1766271952388",
          "inputs": [
            {
              "id": "1766271964103",
              "name": "pUserViolationSummary",
              "scope": "JOB",
              "type": "string",
              "value": "{{$context.$nodes.GET_TOP_5_USER_SUMMARY.$output.result}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Get Top 5 User Summary",
            "returnType": "array",
            "sourceCode": "let data = $context.$nodes.PROCESS_CONTROLS.$output ; \n\nif (data.length == 0) return null;\n\nconst userSummaryArray = data.map(item => JSON.parse(item).result);\n\nconst finalUserSummaryMap = new Map();\n\n// Iterate through the userSummary array and get a summary of User Name and Number of Incidents\nfor (const innerArray of userSummaryArray) {\n\n  // Iterate through each object inside the inner array\n  if (innerArray.length > 0) {\n  for (const obj of innerArray) {\n     const key = `${obj.UserName}`;\n\n    if (!finalUserSummaryMap.has(key)) {\n            finalUserSummaryMap.set(key, {\n                UserName: obj.UserName,\n           //     Controls: new Set(),                \n                NumIncidents: 0\n          //      NumControls: 0\n            });\n          }\n       \n        const group = finalUserSummaryMap.get(key);\n     //   group.Controls.add(obj.ControlName);\n        group.NumIncidents += obj.NumIncidents;\n   //     group.NumControls = group.Controls.size;\n        \n  }\n }\n}\n\n    // Convert map to desired output array\n    const result = Array.from(finalUserSummaryMap.values()).map(group => ({\n        UserName: group.UserName,\n    //    Controls: Array.from(group.Controls).join(','),        \n   //     NumControls: group.NumControls,\n        NumIncidents: group.NumIncidents\n    }));\n\nconst top5 = result.sort((a, b) => b.NumIncidents - a.NumIncidents)  // sort descending by NumIncidents\n  .slice(0, 5); // get top 5\n\nconst userNames = top5.map(item => item.UserName); // Get top 5 users\n\n// filter the main user summary array by the top 5 users\n// const filteredUserSummary = userSummaryArray.filter(item => userNames.includes(item.UserName));\n\n// Trying another way to filter original array by Top 5 user names\n\nconst top5usermap = new Map();\n\n// Iterate through the userSummary array\nfor (const innerArray of userSummaryArray) {\n\n  // Iterate through each object inside the inner array\n  if (innerArray.length > 0) {\n  for (const obj of innerArray) {\n     const key = `${obj.UserName}| ${obj.Role} | ${obj.Entitlement}`;\n\n    if (!top5usermap.has(key) && userNames.includes(obj.UserName)) {\n            top5usermap.set(key, {\n                UserName: obj.UserName,\n                ControlName: obj.ControlName,\n                Role: obj.Role,\n                RoleCode: obj.RoleCode || '',\n                Entitlement: obj.Entitlement,\n                ConflictingRoles: obj.ConflictingRoles,\n                ResultIds: obj.ResultIds,\n                IsIntraRoleViol: obj.IsIntraRoleViol,\n                NumIncidents: obj.NumIncidents\n            });\n          }\n        \n     }\n }\n}\n\n   // Convert map to desired output array\n    \n    const finalresult = Array.from(top5usermap.values()).map(group => ({\n        UserName: group.UserName,\n        ControlName: group.ControlName,\n        Role: group.Role,\n        RoleCode: group.RoleCode || '',\n        Entitlement: group.Entitlement,\n        ConflictingRoles: group.ConflictingRoles,  \n        ResultIds : group.ResultIds,    \n        IsIntraRoleViol: group.IsIntraRoleViol,\n        NumIncidents: group.NumIncidents\n    }));\n\n\n return finalresult;"
          },
          "outcomes": {
            "success": "1766271952388"
          },
          "code": "GET_TOP_5_USER_SUMMARY",
          "id": "1766276525819",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
