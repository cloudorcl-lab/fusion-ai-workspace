          "code": "JA_NEXT_PHASE",
          "id": "1765965767527",
          "inputs": [
            {
              "id": "1765965835513_1",
              "name": "submissionId",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_ACTION_DETAILS.$output.result.payload.submissionId}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "errorNodeId": "1769715641096",
            "name": "fetch Next PhaseId",
            "returnType": "object",
            "sourceCode": "var phasesData = $context.$nodes.JA_NEXT_PHASE.$output;\n\nfunction asArray(value) {\n  if (Array.isArray(value)) {\n    return value;\n  }\n  if (value && Array.isArray(value.items)) {\n    return value.items;\n  }\n  if (value && value.result) {\n    return asArray(value.result);\n  }\n  return [];\n}\n\nvar phases = asArray(phasesData);\nvar phaseId = null;\nvar stateId = null;\nfor (var i = 0; i < phases.length && !stateId; i += 1) {\n  var phase = phases[i] || {};\n  var states = asArray(phase.States || phase.states);\n  for (var j = 0; j < states.length; j += 1) {\n    var state = states[j] || {};\n    var code = String(state.StateCode || state.stateCode || state.Code || state.code || '').toUpperCase();\n    var name = String(state.StateName || state.stateName || state.Name || state.name || '').toUpperCase();\n    if (code.indexOf('REJECT') >= 0 || name.indexOf('REJECT') >= 0) {\n      phaseId = phase.PhaseId || phase.phaseId || phase.Id || phase.id || null;\n      stateId = state.StateId || state.stateId || state.Id || state.id || null;\n      break;\n    }\n  }\n}\n\nreturn {\n  phaseId: phaseId,\n  stateId: stateId\n};"
          },
          "outcomes": {
            "success": "1765266463594"
          },
          "code": "FETCH_NEXT_PHASEID",
          "id": "1765965895205",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
