        {
          "metadata": {
            "errorNodeId": "1769715641096",
            "name": "Fetch Next PhaseId and State Id",
            "returnType": "object",
            "sourceCode": "var phaseOutput = $context.$nodes.JOB_APPLICATION_PHASE_AND_STATE.$output;\nvar phases = [];\nif (phaseOutput && phaseOutput.result && phaseOutput.result.items && Array.isArray(phaseOutput.result.items)) {\n  phases = phaseOutput.result.items;\n} else if (phaseOutput && phaseOutput.items && Array.isArray(phaseOutput.items)) {\n  phases = phaseOutput.items;\n} else if (Array.isArray(phaseOutput)) {\n  phases = phaseOutput;\n}\n\nvar applicationOutput = $context.$nodes.FETCH_JOB_APPLICATION_DETAILS.$output;\nvar application = {};\nif (applicationOutput && applicationOutput.result && applicationOutput.result.items && applicationOutput.result.items.length > 0) {\n  application = applicationOutput.result.items[0];\n} else if (applicationOutput && applicationOutput.items && applicationOutput.items.length > 0) {\n  application = applicationOutput.items[0];\n}\n\nvar currentPhaseId = String(application.currentPhaseId || application.CurrentPhaseId || \"\");\nvar currentStateId = String(application.currentStateId || application.CurrentStateId || \"\");\nvar requisitionId = application.requisitionId || application.RequisitionId || null;\n\nvar currentPhaseIdx = -1;\nfor (var i = 0; i < phases.length; i += 1) {\n  if (String(phases[i].PhaseId || phases[i].phaseId || \"\") === currentPhaseId) {\n    currentPhaseIdx = i;\n    break;\n  }\n}\n\nvar nextPhaseId = null;\nvar nextStateId = null;\nif (currentPhaseIdx !== -1 && currentPhaseIdx < phases.length - 1) {\n  var nextPhase = phases[currentPhaseIdx + 1];\n  nextPhaseId = nextPhase.PhaseId || nextPhase.phaseId || null;\n  var nextPhaseStates = [];\n  if (nextPhase.States && nextPhase.States.items && Array.isArray(nextPhase.States.items)) {\n    nextPhaseStates = nextPhase.States.items;\n  } else if (nextPhase.states && nextPhase.states.items && Array.isArray(nextPhase.states.items)) {\n    nextPhaseStates = nextPhase.states.items;\n  }\n  if (nextPhaseStates.length > 0) {\n    nextStateId = nextPhaseStates[0].StateId || nextPhaseStates[0].stateId || null;\n  }\n}\n\nreturn {\n  nextPhaseId: nextPhaseId,\n  nextStateId: nextStateId,\n  requisitionId: requisitionId,\n  currentPhaseId: currentPhaseId,\n  currentStateId: currentStateId\n};"
          },
          "outcomes": {
            "success": "1765186086835"
          },
          "code": "FETCH_NEXT_PHASEID_AND_STATE_ID",
          "id": "1765213074903",
          "inputs": [],
