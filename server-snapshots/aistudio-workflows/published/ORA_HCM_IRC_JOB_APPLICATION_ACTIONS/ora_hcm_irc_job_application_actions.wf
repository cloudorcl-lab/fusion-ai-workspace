          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\",\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\"\n  ]\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "errorNodeId": "1769715641096",
            "name": "Extract Action Details",
            "returnType": "array",
            "sourceCode": "// 1. Get the Raw Input (Handle casing differences)\nvar inputObj = $context.$triggers.REST.$input;\nvar rawInput = inputObj.OraAction || inputObj.oraAction;\n\n// Initialize variables\nvar payloadData = {};\nvar detectedAction = \"\";\n\n// 2. PARSE THE STRING\nif (typeof rawInput === 'string') {\n    var cleanInput = rawInput.trim();\n    if (cleanInput.indexOf(\"{\") === 0) {\n        // Attempt to fix pseudo-JSON: add quotes to property names (simple, non-nested)\n        var fixedInput = cleanInput\n            .replace(/([{,]\\s*)([a-zA-Z0-9_]+)\\s*:/g, '$1\"$2\":')\n            .replace(/:\\s*'([^']*)'/g, ': \"$1\"')\n            .replace(/:\\s*([a-zA-Z_][a-zA-Z0-9_]*)/g, ': \"$1\"');\n        try {\n            payloadData = JSON.parse(fixedInput);\n            if (payloadData.action) {\n                detectedAction = payloadData.action;\n            }\n        } catch (e) {\n            // parsing failed, treat as plain string\n            detectedAction = cleanInput;\n        }\n    } else {\n        // Plain string (e.g. \"Fill\") -> Use directly\n        detectedAction = cleanInput;\n    }\n}\n// Handle case where already an Object (rare but possible)\nelse if (rawInput && typeof rawInput === 'object') {\n    if (rawInput.action) {\n        detectedAction = rawInput.action;\n        payloadData = rawInput;\n    } else if (rawInput.followUpCommand) {\n        // Legacy support\n        detectedAction = rawInput.followUpCommand;\n    }\n}\n\n// 3. CLEAN & NORMALIZE ACTION CODE\nvar cleanAction = \"\";\nif (detectedAction) {\n    cleanAction = detectedAction.toUpperCase().replace(/_/g, \"\").replace(/\\s/g, \"\");\n}\n\nconst result = {\n    action: detectedAction,\n    payload: payloadData\n};\nreturn result;"
          },
          "outcomes": {
            "success": "1765185848898"
          },
          "code": "EXTRACT_ACTION_DETAILS",
          "id": "1765958259898",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
