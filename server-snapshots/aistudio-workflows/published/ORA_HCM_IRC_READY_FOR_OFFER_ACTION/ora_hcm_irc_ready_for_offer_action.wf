        {
          "id": "1773000000207",
          "code": "CONFIRM_ALREADY_SELECTED_FOR_OFFER",
          "type": "CODE",
          "metadata": {
            "name": "Confirm Already Selected For Offer",
            "sourceCode": "var actionInput = $context.$triggers.REST.$input.OraAction || {};\nvar computed = $context.$nodes.COMPUTE_OFFER_TARGET.$output.result || {};\nvar result = {\n  status: \"SUCCESS\",\n  message: \"Candidate is already selected for offer.\",\n  submissionId: actionInput.submissionId || \"\",\n  targetPhaseName: computed.targetPhaseName || \"Offer\",\n  targetStateName: computed.targetStateName || \"To be Created\",\n  alreadySelectedForOffer: true\n};\nreturn result;",
            "returnType": "object"
          },
          "outcomes": {
            "success": "end"
          },
          "inputs": [],
          "diagram": {
            "x": 5000,
            "y": 5440
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
