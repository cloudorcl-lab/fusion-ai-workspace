        {
          "metadata": {
            "errorNodeId": "1769724769523",
            "name": "Compute Offer Target",
            "returnType": "object",
            "sourceCode": "function asText(value) {\n  return value === undefined || value === null ? '' : String(value).trim();\n}\nfunction normalize(value) {\n  return asText(value).toLowerCase().replace(/[^a-z0-9]+/g, '');\n}\nfunction parseValue(value) {\n  if (typeof value === 'string') {\n    try {\n      return JSON.parse(value);\n    } catch (error) {\n      return value;\n    }\n  }\n  return value;\n}\nfunction phasesArray(value) {\n  var parsed = parseValue(value);\n  if (parsed && Array.isArray(parsed.items)) {\n    return parsed.items;\n  }\n  if (parsed && parsed.result && Array.isArray(parsed.result.items)) {\n    return parsed.result.items;\n  }\n  return Array.isArray(parsed) ? parsed : [];\n}\nfunction stateItems(phase) {\n  if (phase && phase.States && Array.isArray(phase.States.items)) {\n    return phase.States.items;\n  }\n  return phase && Array.isArray(phase.States) ? phase.States : [];\n}\n\nvar phases = phasesArray($context.$nodes.JOB_APPLICATION_PHASE_AND_STATE.$output);\nvar applicationResponse = parseValue($context.$nodes.FETCH_JOB_APPLICATION_DETAILS.$output) || {};\nvar application = Array.isArray(applicationResponse.items) && applicationResponse.items.length > 0 ? applicationResponse.items[0] : applicationResponse;\nvar requisitionId = application.requisitionId || application.RequisitionId || '';\nvar currentPhaseId = asText(application.currentPhaseId || application.CurrentPhaseId || '');\nvar currentStateId = asText(application.currentStateId || application.CurrentStateId || '');\nvar currentPhaseName = asText(application.currentPhaseName || application.CurrentPhaseName || '');\nvar currentStateName = asText(application.currentStateName || application.CurrentStateName || '');\nvar currentStateKey = normalize(currentStateName);\nvar currentPhaseKey = normalize(currentPhaseName);\nvar alreadySelectedForOffer = currentStateKey.indexOf('selectedforoffer') >= 0;\nvar alreadyInOffer = currentPhaseKey === 'offer' || currentPhaseKey.indexOf('offer') === 0;\n\nvar offerPhase = null;\nfor (var phaseIndex = 0; phaseIndex < phases.length; phaseIndex += 1) {\n  var phaseCandidate = phases[phaseIndex] || {};\n  var phaseCode = normalize(phaseCandidate.PhaseCode || phaseCandidate.phaseCode);\n  var phaseName = normalize(phaseCandidate.PhaseName || phaseCandidate.phaseName);\n  if (phaseCode === 'offer' || phaseName === 'offer' || phaseCode.indexOf('offer') === 0 || phaseName.indexOf('offer') === 0) {\n    offerPhase = phaseCandidate;\n    break;\n  }\n}\n\nvar targetState = null;\nvar states = stateItems(offerPhase);\nfor (var stateIndex = 0; stateIndex < states.length; stateIndex += 1) {\n  var stateCandidate = states[stateIndex] || {};\n  var stateCode = normalize(stateCandidate.StateCode || stateCandidate.stateCode);\n  var stateName = normalize(stateCandidate.StateName || stateCandidate.stateName);\n  if (stateCode === 'tobecreated' || stateName === 'tobecreated' || stateCode.indexOf('tobecreated') >= 0 || stateName.indexOf('tobecreated') >= 0) {\n    targetState = stateCandidate;\n    break;\n  }\n}\nif (!targetState && states.length > 0) {\n  targetState = states[0];\n}\n\nvar result = {\n  nextPhaseId: offerPhase ? offerPhase.PhaseId || offerPhase.phaseId : null,\n  nextStateId: targetState ? targetState.StateId || targetState.stateId : null,\n  requisitionId: requisitionId,\n  currentPhaseId: currentPhaseId,\n  currentStateId: currentStateId,\n  currentPhaseName: currentPhaseName,\n  currentStateName: currentStateName,\n  targetPhaseName: offerPhase ? offerPhase.PhaseName || offerPhase.phaseName : '',\n  targetStateName: targetState ? targetState.StateName || targetState.stateName : '',\n  alreadySelectedForOffer: alreadySelectedForOffer || alreadyInOffer\n};\nreturn result;\n"
          },
          "outcomes": {
            "success": "1773000000206"
          },
