          "id": "1769640579494",
          "inputs": [
            {
              "id": "1769640579496_1",
              "name": "prompt",
              "type": "string",
              "value": "Summarize the ##MEETING_TRANSCRIPT## concisely, ensuring no repetition across sections and dont hallucinate. Organize the summary with the following structure: <br> Sentiment: (Provide only a single word or short phrase indicating the meeting’s tone — e.g., Positive, Neutral, or Negative. If unclear, write: No specified sentiment) <br> Key Discussion Points: (Summarize the main topics covered, avoiding mentions of decisions or follow-ups)) <br> Decisions Made: (Only include confirmed agreements or commitments, ''No specified decisions'' if none) <br> Action Items: (Include both specific tasks assigned and pending follow-ups or next steps that require further action. Avoid re-stating decisions. Write ''No specified actions'' if none) <br> Ensure that each section contains unique information without repeating content from other sections. Do not reduce the content drastically but try to identify discussion items and show them as sub paragraphs.\n\n##MEETING_TRANSCRIPT##\n{{$context.$nodes.GET_TRANSCRIPT_ATTACHMENT_CONTENT.$output}}"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_CX_SALESFORCE_CALLNOTES",
            "functionName": "update_wrapUp",
            "processJson": true,
            "name": "Write to WrapUp"
          },
          "outcomes": {
