        {
          "metadata": {
            "name": "Derive Attachment Key",
            "returnType": "string",
            "sourceCode": "return ($context.$triggers.REST.$input.AttachmentKey ? $context.$triggers.REST.$input.AttachmentKey : $context.$nodes.FIND_TRANSCRIPT_FILE.$output.result);"
          },
          "outcomes": {
            "success": "1769643846102"
          },
          "code": "DERIVE_ATTACHMENT_KEY",
          "id": "1769645415680",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Add Summary to CallNotes",
            "returnType": "string",
            "sourceCode": "let callNotes = $context.$nodes.GET_WRAPUP?.$output.CallNotes || \"\";\n\nlet title = $context.$nodes.GET_WRAPUP?.$output.InteractionDescription || \"\";\n\nlet summary = $context.$nodes.SUMMARIZE_TRANSCRIPT?.$output || \"\";\n\n// Convert any literal \"\\n\" (and \"\\r\\n\") sequences into HTML <br>\n// 1) If summary contains backslash characters (e.g., \"\\\\n\"), convert those first\nsummary = summary\n  ?.replace(/\\\\r\\\\n/g, \"\\n\")\n  ?.replace(/\\\\n/g, \"\\n\")\n  ?.replace(/\\\\r/g, \"\\n\");\n\n// 2) Convert real newlines to <br> (covers \\n and \\r\\n cases)\nsummary = summary?.replace(/\\r?\\n/g, \"<br>\");\n\n// Use explicit markers so we only replace this meeting's section and keep others intact\nlet startMarker = \"--- <strong>START Summary of meeting:</strong> \" + title + \" ---\";\nlet endMarker   = \"--- <strong>END Summary of meeting:</strong> \" + title + \" ---\";\n\n// Escape markers for RegExp (no function)\nlet escStart = startMarker?.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\nlet escEnd   = endMarker?.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n\n// Match the section for this title only (including any chars), non-greedy\nlet sectionRegex = new RegExp(escStart + \"[\\\\s\\\\S]*?\" + escEnd, \"g\");\n\nlet newSection = startMarker + \"<br><br>\" + summary + \"<br><br>\" + endMarker;\n\nif (sectionRegex.test(callNotes)) {\n  // Overwrite existing summary section for this title only\n  callNotes = callNotes?.replace(sectionRegex, newSection);\n} else {\n  // Append new section\n  callNotes = callNotes\n    ? callNotes?.replace(/\\s*$/, \"\") + \"<br><br>\" + newSection\n    : newSection;\n}\n\nreturn callNotes;"
          },
          "outcomes": {
            "success": "1769640643911"
          },
          "code": "ADD_SUMMARY_TO_CALLNOTES",
          "id": "1769666049550",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
