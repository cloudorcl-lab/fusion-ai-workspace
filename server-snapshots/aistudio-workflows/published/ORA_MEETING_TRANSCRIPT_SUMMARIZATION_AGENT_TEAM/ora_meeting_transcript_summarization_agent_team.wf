        },
        {
          "metadata": {
            "name": "Find Transcript File",
            "returnType": "string",
            "sourceCode": "let data = $context.$nodes.GET_WRAPUP.$output;\nconst attachments = data.Attachments.items || [];\nconst transcript = attachments.find(item => item.CategoryName === 'TRANSCRIPT');\nconst key = transcript ? transcript['AttachedDocumentId'] : undefined;\nreturn key;"
          },
          "outcomes": {
            "success": "1769645415680"
          },
          "code": "FIND_TRANSCRIPT_FILE",
          "id": "1769641874034",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Validate Attachment Key",
            "returnType": "boolean",
            "sourceCode": "const attachmentKey = $context.$triggers.REST.$input.AttachmentKey ;\n\nif(attachmentKey == null) return false;\n\nlet data = $context.$nodes.GET_WRAPUP.$output; \nconst attachments = data.Attachments.items || [];\nreturn attachments.some(item => item['AttachedDocumentId'] === attachmentKey);"
          },
          "outcomes": {
            "success": "1769643389572"
          },
          "code": "VALIDATE_ATTACHMENT_KEY",
          "id": "1769643298735",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
