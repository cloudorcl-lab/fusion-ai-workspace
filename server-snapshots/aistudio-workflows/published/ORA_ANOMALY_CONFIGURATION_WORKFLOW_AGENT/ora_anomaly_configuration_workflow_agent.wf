        \"type\": \"object\",\n                              \"properties\": {\n                                \"href\": { \"type\": \"string\" }\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              },\n              \"hasMore\": { \"type\": \"boolean\" }\n            }\n          }\n        }\n      }\n    },\n    \"hasMore\": { \"type\": \"boolean\" }\n  }\n}",
