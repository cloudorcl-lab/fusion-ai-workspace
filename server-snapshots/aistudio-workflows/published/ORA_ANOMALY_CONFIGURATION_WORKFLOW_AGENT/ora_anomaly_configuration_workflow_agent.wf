          "inputs": [
            {
              "id": "1779398570877_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an anomaly configuration rules assistant for invoice controls. Only answer questions that are directly related to invoice anomaly rules updates.\nIf the user asks about unrelated topics, politely decline and briefly explain that the request is outside your supported domain. Do not answer the unrelated question.\nWhen helpful, redirect the user to topics you can assist with, such as configuring invoice anomaly rules, updating rule parameters, enabling or disabling rules, or troubleshooting anomaly policy save errors."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_FINANCIALC_ANOMALYSENSORPOLICIES",
            "functionName": "GetAnomalySensorPolicies",
            "name": "getAnomalySensorPoliciesEtag"
          },
          "outcomes": {
            "success": "1783025955661"
          },
          "code": "GET_ANOMALY_SENSOR_POLICIES_ETAG",
          "id": "1782944915443",
          "inputs": [],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "convertAnomaliesLogical",
            "returnType": "array",
            "sourceCode": "const raw = $context.$nodes.GETANOMALYSENSORPOLICIES.$output;\n\n// Helper: safely normalize the GET response shape\nfunction normalizeInput(apiResponse) {\n  if (!apiResponse || typeof apiResponse !== \"object\") return { items: [] };\n\n  if (Array.isArray(apiResponse.result)) {\n    return apiResponse.result[0]?.json || apiResponse.result[0] || { items: [] };\n  }\n\n  if (apiResponse.json && apiResponse.json.items) return apiResponse.json;\n  if (apiResponse.items) return apiResponse;\n\n  return { items: [] };\n}\n\nconst input = normalizeInput(raw);\n\n// Map anomaly code -> detailId/policyId used by calling API\nconst POLICY_INFO_BY_ANOMALY = {\n  ORA_AP_INV_CURRENCY_ANOMALY: {\n    ruleName: \"Invoice Currency Anomaly\",\n    detailId: \"det-invoice-currency\",\n    policyId: \"pol-invoice-currency\",\n  },\n  ORA_AP_INV_REMIT_BANK_ANOMALY: {\n    ruleName: \"Remittance Bank Account Anomaly\",\n    detailId: \"det-remittance-bank-account\",\n    policyId: \"pol-remittance-bank-account\",\n  },\n  ORA_AP_INV_HIGH_AMT_ANOMALY: {\n    ruleName: \"High Invoice Amount Anomaly\",\n    detailId: \"det-high-invoice-amount\",\n    policyId: \"pol-high-invoice-amount\",\n  },\n  ORA_AP_INV_FRAUD_ANOMALY: {\n    ruleName: \"Fraudulent Invoice Anomaly\",\n    detailId: \"det-fraudulent-invoice\",\n    policyId: \"pol-fraudulent-invoice\",\n  },\n  ORA_AP_INV_DUPLICATE_ANOMALY: {\n    ruleName: \"Duplicate Invoice Anomaly\",\n    detailId: \"det-duplicate-invoice\",\n    policyId: \"pol-duplicate-invoice\",\n  },\n};\n\nfunction getInfoByAnomaly(anomaly) {\n  return POLICY_INFO_BY_ANOMALY[anomaly];\n}\n\n// Canonical order of definition attributes\nconst CANONICAL_ATTRS = [\n  \"Supplier\",\n  \"Amount\",\n  \"Currency\",\n  \"Invoice Date\",\n  \"Supplier Site\",\n  \"PO\",\n  \"Invoice Description\",\n];\n\n// Order to show in fraud influences\nconst FRAUD_INFLUENCE_ORDER = [\n  \"Supplier Site\",\n  \"Amount\",\n  \"Currency\",\n  \"Invoice Date\",\n  \"PO\",\n  \"Invoice Description\",\n];\n\n// Helper: decode base64 JSON coming from GET\nfunction decodeBase64Json(value) {\n  if (value == null) return null;\n  if (typeof value === \"object\") return value;\n  if (typeof value !== \"string\") return null;\n\n  try {\n    const decoded = atob(value.trim());\n    return JSON.parse(decoded);\n  } catch {\n    return null;\n  }\n}\n\n// Helper: convert days to month representation\nfunction daysToMonthsText(days) {\n  const n = Number(days);\n  if (!Number.isFinite(n)) return \"\";\n\n  const months = n / 30;\n  const display = Number.isInteger(months)\n    ? months.toString()\n    : months.toFixed(1).replace(/\\.0$/, \"\");\n\n  return `${display} month${months === 1 ? \"\" : \"s\"}`;\n}\n\n// Helper: parse Definition Attributes string\n// Returns a set of enabled attributes\n// Supplier is always treated as enabled\nfunction parseEnabledDefinitionAttributes(definitionAttributes) {\n  const enabled = new Set();\n\n  if (typeof definitionAttributes !== \"string\") return enabled;\n\n  for (const part of definitionAttributes.split(\",\")) {\n    const [nameRaw, valueRaw] = part.split(\"=\");\n    if (!nameRaw || !valueRaw) continue;\n\n    const name = nameRaw.trim();\n    const value = valueRaw.trim().toLowerCase();\n\n    if (value === \"yes\") {\n      enabled.add(name);\n    }\n  }\n\n  return enabled;\n}\n\n// Helper: build the fraud influences as separate rows\nfunction buildFraudInfluences(outcome) {\n  const influences = [];\n\n  if (outcome.HistoricalTimePeriod != null) {\n    influences.push({\n      attribute: \"Historical Time Period\",\n      value: String(outcome.HistoricalTimePeriod),\n    });\n  }\n\n  // Expand enabled attributes into separate influence rows\n  const enabledAttrs = parseEnabledDefinitionAttributes(outcome.DefinitionAttributes);\n\n  // Supplier is shown in the statement, but not as a separate influence row\n  for (const attr of FRAUD_INFLUENCE_ORDER) {\n    if (enabledAttrs.has(attr)) {\n      influences.push({\n        attribute: attr,\n        value: \"Yes\",\n      });\n    }\n  }\n\n  return influences;\n}\n\n// Helper: build the statement text for each anomaly\nfunction buildStatement(anomaly, outcome) {\n  const monthsText = daysToMonthsText(outcome.HistoricalTimePeriod);\n\n  switch (anomaly) {\n    case \"ORA_AP_INV_FRAUD_ANOMALY\": {\n      const enabledAttrs = parseEnabledDefinitionAttributes(outcome.DefinitionAttributes);\n      const statementAttrs = CANONICAL_ATTRS.filter((attr) => enabledAttrs.has(attr));\n\n      return `Invoices with the same combination of ${statementAttrs.join(\", \")} within the past ${monthsText}.`;\n    }\n\n    case \"ORA_AP_INV_HIGH_AMT_ANOMALY\":\n      return `Invoices exceeding the maximum historical amount for a supplier by more than ${outcome.Variation}% within the past ${monthsText}.`;\n\n    case \"ORA_AP_INV_CURRENCY_ANOMALY\":\n      return `Invoices with a currency not previously submitted by the supplier within the past ${monthsText}.`;\n\n    case \"ORA_AP_INV_DUPLICATE_ANOMALY\":\n      return `Invoices with the same invoice number within the past ${monthsText}.`;\n\n    case \"ORA_AP_INV_REMIT_BANK_ANOMALY\":\n      return \"The remittance bank country does not match the supplier site's country.\";\n\n    default:\n      return \"\";\n  }\n}\n\nconst TARGET_ATTRIBUTE_BY_ANOMALY = {\n  ORA_AP_INV_CURRENCY_ANOMALY: \"Invoice Currency\",\n  ORA_AP_INV_REMIT_BANK_ANOMALY: \"Remittance Bank Account\",\n  ORA_AP_INV_HIGH_AMT_ANOMALY: \"High Invoice Amount\",\n  ORA_AP_INV_FRAUD_ANOMALY: \"Fraudulent Invoice\",\n  ORA_AP_INV_DUPLICATE_ANOMALY: \"Duplicate Invoice\",\n};\n\n// Helper: build targets\nfunction buildTargets(actionObj, anomaly) {\n  return [\n    {\n      attribute: TARGET_ATTRIBUTE_BY_ANOMALY[anomaly],\n      value: actionObj?.Enable === \"Yes\" ? \"Yes\" : \"No\",\n    },\n  ];\n}\n\n// Main logic\nconst details = [];\n\nfor (const policy of input.items || []) {\n  const action = policy.actions?.items?.[0];\n\n  if (!action) {\n    throw new Error(`Missing action for rule: ${policy.ruleName || \"unknown\"}`);\n  }\n\n  const decoded = decodeBase64Json(action.actionParameters);\n\n  const outcome = decoded.Outcome?.[0];\n  const actionObj = decoded.Action?.[0];\n  const anomaly = outcome?.Anomaly;\n\n  const ids = getInfoByAnomaly(anomaly);\n  if (!ids) {\n    throw new Error(`Unable to map anomaly to policy info: ${anomaly || \"missing\"}`);\n  }\n\n  const statement = buildStatement(anomaly, outcome);\n\n  let influences = [];\n\n  // Fraud has a different influence format\n  if (anomaly === \"ORA_AP_INV_FRAUD_ANOMALY\") {\n    influences = buildFraudInfluences(outcome);\n  } else {\n    if (outcome.HistoricalTimePeriod != null) {\n      influences.push({\n        attribute: \"Historical Time Period\",\n        value: String(outcome.HistoricalTimePeriod),\n      });\n    }\n\n   if (outcome.Variation != null) {\n    influences.push({\n      attribute: \"Variation\",\n      value: String(outcome.Variation),\n    });\n   }\n  }\n\n  details.push({\n    detailId: ids.detailId,\n    policyId: ids.policyId,\n    status: \"Valid\",\n    category: \"Invoice Controls\",\n    subCategory: \"Anomaly Verification\",\n    priority: 1,\n    errorMessage: null,\n    policyDetailStatement: statement,\n    influences: influences,\n    targets: buildTargets(actionObj, anomaly),\n  });\n}\n\nreturn [\n  {\n    details,\n  },\n];\n"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "CONVERTANOMALIESLOGICAL",
          "id": "1783023462844",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "saveLogicalJSONToSensorAnomaly",
            "returnType": "object",
            "sourceCode": "// Input from the calling API flow\nconst details = Array.isArray($context.$triggers.REST.$input.details)\n  ? $context.$triggers.REST.$input.details\n  : [];\n\n// GET output gives us ruleId, ruleEtag, actionId, actionEtag, and fallback values\nconst rawGetOutput = $context.$nodes.GET_ANOMALY_SENSOR_POLICIES_ETAG.$output;\n\n// Safely unwrap different possible GET response shapes\nfunction unwrapGetPayload(raw) {\n  if (!raw || typeof raw !== \"object\") {\n    return { items: [] };\n  }\n\n  if (Array.isArray(raw.result)) {\n    const first = raw.result[0];\n    if (first?.json?.items) return first.json;\n    if (first?.items) return first;\n  }\n\n  if (raw.json?.items) return raw.json;\n  if (raw.items) return raw;\n\n  return { items: [] };\n}\n\n// Helper: decode base64 JSON coming from GET\nfunction decodeBase64Json(value) {\n  if (value == null) return null;\n  if (typeof value === \"object\") return value;\n  if (typeof value !== \"string\") return null;\n\n  try {\n    const decoded = atob(value.trim());\n    return JSON.parse(decoded);\n  } catch {\n    return null;\n  }\n}\n\n// Find an item by attribute name\nfunction findByAttribute(items, attributeName) {\n  const target = String(attributeName).trim().toLowerCase();\n  return (Array.isArray(items) ? items : []).find((item) => {\n    return String(item?.attribute ?? \"\").trim().toLowerCase() === target;\n  });\n}\n\n// Only y / yes (any case) means Yes.\n// Everything else means No.\nfunction normalizeYesNo(value) {\n  if (typeof value !== \"string\") {\n    return \"No\";\n  }\n\n  const v = value.trim().toLowerCase();\n  if (v === \"y\" || v === \"yes\") {\n    return \"Yes\";\n  }\n\n  return \"No\";\n}\n\n// Normalize Definition Attribute names\nfunction normalizeAttributeName(name) {\n  const n = String(name).trim().toLowerCase();\n\n  if (n === \"supplier site\") return \"Supplier Site\";\n  if (n === \"invoice date\") return \"Invoice Date\";\n  if (n === \"invoice description\") return \"Invoice Description\";\n  if (n === \"supplier\") return \"Supplier\";\n  if (n === \"amount\") return \"Amount\";\n  if (n === \"currency\") return \"Currency\";\n  if (n === \"po\") return \"PO\";\n\n  return null;\n}\n\n// Parse fraud attributes from input or from GET fallback.\n// count selected attributes for fraud validation\n// This helper is used for building the final DefinitionAttributes string.\nfunction parseFraudAttributeSelection(source) {\n  const selected = new Set();\n\n  // Supplier is always selected\n  selected.add(\"Supplier\");\n\n  function addAttr(attrName, attrValue) {\n    const canonical = normalizeAttributeName(attrName);\n    if (!canonical) return;\n\n    if (normalizeYesNo(attrValue) === \"Yes\") {\n      selected.add(canonical);\n    }\n  }\n\n  // Input can be:\n  // 1) an array of influence objects - calling API format\n  // 2) a comma-separated string GET DefinitionAttributes format\n  if (Array.isArray(source)) {\n    for (const item of source) {\n      addAttr(item?.attribute, item?.value);\n    }\n  } else if (typeof source === \"string\") {\n    for (const token of source.split(\",\")) {\n      const part = token.trim();\n      if (!part) continue;\n\n      const match = part.match(/^([^:=]+?)(?:\\s*[:=]\\s*(.*))?$/);\n      const attrName = match?.[1]?.trim();\n      const attrValue = match?.[2];\n\n      if (!attrName) continue;\n\n      // If value is missing, treat it as Yes\n      addAttr(attrName, attrValue ?? \"Y\");\n    }\n  }\n\n  // Pair rule for save payload:\n  // If Amount is Yes, Currency is also Yes\n  // If Currency is Yes, Amount is also Yes\n  if (selected.has(\"Amount\")) {\n    selected.add(\"Currency\");\n  }\n  if (selected.has(\"Currency\")) {\n    selected.add(\"Amount\");\n  }\n\n  return selected;\n}\n\n// Count the non-supplier attributes selected after merging user input with GET fallback.\n// This keeps validation aligned with the final save payload behavior.\nfunction getMergedFraudSelectedCount(detail, decodedDefaults) {\n  const fraudAttrs = [\n    \"Supplier Site\",\n    \"Amount\",\n    \"Currency\",\n    \"Invoice Date\",\n    \"PO\",\n    \"Invoice Description\",\n  ];\n\n  const finalDefinitionAttributes = buildDefinitionAttributesForSave(detail, decodedDefaults);\n  const selected = parseFraudAttributeSelection(finalDefinitionAttributes);\n\n  let count = 0;\n  for (const attr of fraudAttrs) {\n    if (selected.has(attr)) {\n      count++;\n    }\n  }\n\n  return count;\n}\n\n// Build the final DefinitionAttributes string for the save API.\n// Input wins. Missing/null/empty values fall back to GET.\n// Any other value than y/yes is treated as No.\nfunction buildDefinitionAttributesForSave(detail, decodedDefaults) {\n  const fallbackValue =\n    decodedDefaults?.Outcome?.[0]?.DefinitionAttributes ?? \"\";\n\n  const fallbackSelection = parseFraudAttributeSelection(fallbackValue);\n\n  const selected = new Set();\n  // Supplier is always Yes\n  selected.add(\"Supplier\");\n  const fraudAttrs = [\n    \"Amount\",\n    \"Currency\",\n    \"Invoice Date\",\n    \"Supplier Site\",\n    \"PO\",\n    \"Invoice Description\",\n  ];\n\n  for (const attr of fraudAttrs) {\n    const inputInfluence = findByAttribute(detail.influences, attr);\n\n    let attrValue;\n\n    if (inputInfluence?.value != null && inputInfluence.value !== \"\") {\n      // If input has the field, use input value only\n      attrValue = inputInfluence.value;\n    } else {\n      // If input is missing, null, or empty, use GET fallback\n      if (fallbackSelection.has(attr)) {\n        attrValue = \"Yes\";\n      } else {\n        attrValue = \"No\";\n      }\n    }\n\n    if (normalizeYesNo(attrValue) === \"Yes\") {\n      selected.add(attr);\n    }\n  }\n\n  // Pair rule again before output\n  if (selected.has(\"Amount\")) {\n    selected.add(\"Currency\");\n  }\n  if (selected.has(\"Currency\")) {\n    selected.add(\"Amount\");\n  }\n\n  const canonicalDefinitionAttributes = [\n    \"Supplier\",\n    \"Amount\",\n    \"Currency\",\n    \"Invoice Date\",\n    \"Supplier Site\",\n    \"PO\",\n    \"Invoice Description\",\n  ];\n\n  const parts = [];\n  for (const attr of canonicalDefinitionAttributes) {\n    parts.push(`${attr}=${selected.has(attr) ? \"Yes\" : \"No\"}`);\n  }\n\n  return parts.join(\",\");\n}\n\n// Read influence values from input first, then fall back to GET defaults\nfunction getResolvedInfluenceValue(detail, decodedDefaults, attributeName) {\n  const inputInf = findByAttribute(detail.influences, attributeName);\n  if (inputInf?.value != null && inputInf.value !== \"\") {\n    return inputInf.value;\n  }\n\n  if (attributeName === \"Historical Time Period\") {\n    return decodedDefaults?.Outcome?.[0]?.HistoricalTimePeriod;\n  }\n\n  if (attributeName === \"Variation\") {\n    return decodedDefaults?.Outcome?.[0]?.Variation;\n  }\n\n  return undefined;\n}\n\nfunction getDefaultOutcome(decodedDefaults) {\n  return decodedDefaults?.Outcome?.[0] ?? {};\n}\n\nfunction getDefaultAction(decodedDefaults) {\n  return decodedDefaults?.Action?.[0] ?? {};\n}\n\nconst targetAttributeByAnomaly = {\n  ORA_AP_INV_CURRENCY_ANOMALY: \"Invoice Currency\",\n  ORA_AP_INV_REMIT_BANK_ANOMALY: \"Remittance Bank Account\",\n  ORA_AP_INV_HIGH_AMT_ANOMALY: \"High Invoice Amount\",\n  ORA_AP_INV_FRAUD_ANOMALY: \"Fraudulent Invoice\",\n  ORA_AP_INV_DUPLICATE_ANOMALY: \"Duplicate Invoice\",\n};\n\n// Read target values from input first.\n// If the user did not provide the target, use the existing value from GET.\nfunction getResolvedTargetValue(detail, decodedDefaults, anomalyCode) {\n  const defaultAction = getDefaultAction(decodedDefaults);\n  const attributeName = targetAttributeByAnomaly[anomalyCode] || \"Enable\";\n  const inputTarget = findByAttribute(detail.targets, attributeName);\n\n  // User has provided the anomaly-specific target name.\n  if (inputTarget?.value != null && inputTarget.value !== \"\") {\n    // Any value other than Y/Yes is treated as No.\n    return normalizeYesNo(inputTarget.value);\n  }\n\n  // User did not provide the target.\n  // Keep the existing value already present in the system.\n  return normalizeYesNo(defaultAction.Enable);\n}\n\n// Target attribute -> rule and anomaly metadata.\n// detailId is caller-generated and is used only for response correlation.\nconst anomalyByTargetAttribute = {\n  \"invoice currency\": {\n    ruleName: \"Invoice Currency Anomaly\",\n    anomalyCode: \"ORA_AP_INV_CURRENCY_ANOMALY\",\n  },\n  \"remittance bank account\": {\n    ruleName: \"Remittance Bank Account Anomaly\",\n    anomalyCode: \"ORA_AP_INV_REMIT_BANK_ANOMALY\",\n  },\n  \"high invoice amount\": {\n    ruleName: \"High Invoice Amount Anomaly\",\n    anomalyCode: \"ORA_AP_INV_HIGH_AMT_ANOMALY\",\n  },\n  \"fraudulent invoice\": {\n    ruleName: \"Fraudulent Invoice Anomaly\",\n    anomalyCode: \"ORA_AP_INV_FRAUD_ANOMALY\",\n  },\n  \"duplicate invoice\": {\n    ruleName: \"Duplicate Invoice Anomaly\",\n    anomalyCode: \"ORA_AP_INV_DUPLICATE_ANOMALY\",\n  },\n};\n\nfunction getAnomalyConfigFromTargets(detail) {\n  const targets = Array.isArray(detail?.targets) ? detail.targets : [];\n\n  for (const target of targets) {\n    const attribute = String(target?.attribute ?? \"\").trim().toLowerCase();\n    const anomalyConfig = anomalyByTargetAttribute[attribute];\n    if (anomalyConfig) {\n      return anomalyConfig;\n    }\n  }\n\n  return null;\n}\n\nconst anomaliesUsingHistoricalTimePeriod = new Set([\n  \"ORA_AP_INV_CURRENCY_ANOMALY\",\n  \"ORA_AP_INV_DUPLICATE_ANOMALY\",\n  \"ORA_AP_INV_HIGH_AMT_ANOMALY\",\n  \"ORA_AP_INV_FRAUD_ANOMALY\",\n]);\n\nconst anomaliesUsingVariation = new Set([\n  \"ORA_AP_INV_HIGH_AMT_ANOMALY\",\n]);\n\nconst anomaliesUsingDefinitionAttributes = new Set([\n  \"ORA_AP_INV_FRAUD_ANOMALY\",\n]);\n\n\n// Main logic\n\n\nconst getPayload = unwrapGetPayload(rawGetOutput);\nconst sourceItems = Array.isArray(getPayload.items) ? getPayload.items : [];\n\nconst ruleMap = Object.fromEntries(\n  sourceItems.map((item) => [item.ruleName, item])\n);\n\n\nconst saveItems = [];\nconst requestMap = [];\nconst validationErrorRecords = [];\n\nfor (const detail of details) {\n  const anomalyConfig = getAnomalyConfigFromTargets(detail);\n  const sourceRule = anomalyConfig ? ruleMap[anomalyConfig.ruleName] : undefined;\n  const sourceAction = sourceRule?.actions?.items?.[0];\n  \n  // If the rule does not exist in GET, mark it as a publish error\n  if (!sourceRule) {\n    validationErrorRecords.push({\n      detailId: detail.detailId,\n      policyId: detail.policyId,\n      status: \"Publish_Error\",\n        errorMessage: \"This anomaly target is not supported by the system.\",\n    });\n  \n    continue;\n  }\n  // Decode GET actionParameters so we can use them as fallback defaults\n  const decodedDefaults = decodeBase64Json(sourceAction.actionParameters) || {};\n\n  \n  // Fraud validation\n  \n  if (anomalyConfig.anomalyCode === \"ORA_AP_INV_FRAUD_ANOMALY\") {\n    const selectedCount = getMergedFraudSelectedCount(detail, decodedDefaults);\n\n    // If fewer than 3 are selected after merging input with GET fallback, do not send this record to save API\n    if (selectedCount < 3) {\n      validationErrorRecords.push({\n        detailId: detail.detailId,\n        policyId: detail.policyId,\n        status: \"Publish_Error\",\n        errorMessage:\n          \"Fraudulent Invoice requires at least 3 of these attributes to be set to Yes after combining user input with existing policy values: Amount, Currency, Invoice Date, Supplier Site, PO, Invoice Description.\",\n      });\n\n      continue;\n    }\n  }\n\n  // Validate numeric influence values\n  let hasValidationError = false;\n  const numericAttributes = [\n    \"Historical Time Period\",\n    \"Variation\",\n  ];\n\n  for (const attributeName of numericAttributes) {\n    const influence = findByAttribute(detail.influences, attributeName);\n    // If user did not pass it, GET fallback will be used.\n    if (!influence || influence.value == null || influence.value === \"\") {\n     continue;\n    }\n    \n    const errorMessage = attributeName === \"Historical Time Period\"\n    ? \"Historical Time Period must be a numeric value in days.\"\n    : `${attributeName} must be a numeric value.`;\n\n    const num = Number(influence.value);\n    // User passed a value and it must be positive numeric\n    if (Number.isNaN(num) || !Number.isInteger(num) || num < 0 ) {\n      validationErrorRecords.push({\n        detailId: detail.detailId,\n        policyId: detail.policyId,\n        status: \"Publish_Error\",\n        errorMessage,\n      });\n      hasValidationError = true;\n    }\n  }\n  // If any numeric validation failed, do not build save payload for this record\n  if (hasValidationError) {\n    continue;\n  }\n  \n  // Build the save API actionParameters\n  \n  const anomalyCode = anomalyConfig.anomalyCode;\n  const defaultOutcome = getDefaultOutcome(decodedDefaults);\n  const actionParameters = {\n    Outcome: [\n      {\n        Anomaly: anomalyCode,\n      },\n    ],\n    Action: [\n      {\n        Enable: getResolvedTargetValue(detail, decodedDefaults, anomalyCode),\n      },\n    ],\n  };\n\n  // Historical Time Period is used by several anomaly types\n  const historicalTimePeriod = getResolvedInfluenceValue(\n    detail,\n    decodedDefaults,\n    \"Historical Time Period\"\n  );\n\n  if (anomaliesUsingHistoricalTimePeriod.has(anomalyCode)) {\n    if (historicalTimePeriod != null && historicalTimePeriod !== \"\") {\n      actionParameters.Outcome[0].HistoricalTimePeriod = String(historicalTimePeriod);\n    } else if (\n      defaultOutcome.HistoricalTimePeriod != null &&\n      defaultOutcome.HistoricalTimePeriod !== \"\"\n    ) {\n      actionParameters.Outcome[0].HistoricalTimePeriod = String(defaultOutcome.HistoricalTimePeriod);\n    }\n  }\n\n  // Variation is only used by High Invoice Amount\n  if (anomaliesUsingVariation.has(anomalyCode)) {\n    const variation = getResolvedInfluenceValue(detail, decodedDefaults, \"Variation\");\n    if (variation != null && variation !== \"\") {\n      actionParameters.Outcome[0].Variation = String(variation);\n    } else if (defaultOutcome.Variation != null && defaultOutcome.Variation !== \"\") {\n      actionParameters.Outcome[0].Variation = String(defaultOutcome.Variation);\n    }\n  }\n\n  // Fraud attributes come from input as separate influence entries,\n  // but the save API expects them packed into one DefinitionAttributes string.\n  if (anomaliesUsingDefinitionAttributes.has(anomalyCode)) {\n    actionParameters.Outcome[0].DefinitionAttributes = buildDefinitionAttributesForSave(detail, decodedDefaults);\n  }\n\n  // Save API needs the ids and etags from GET\n  saveItems.push({\n    ruleId: sourceRule.ruleId,\n    $context: {\n      etag: sourceRule.$context?.etag ?? null,\n    },\n    actions: [\n      {\n        actionId: sourceAction.actionId,\n        $context: {\n          etag: sourceAction.$context?.etag ?? null,\n        },\n        actionParameters,\n      },\n    ],\n  });\n\n  // Keep a small trace record so the merge node can line things up later\n  requestMap.push({\n    detailId: detail.detailId,\n    ruleId: sourceRule.ruleId,\n    actionId: sourceAction.actionId,\n  });\n}\n\n// Payload for the save API\nconst saveApiPayload = {\n  policies: {\n    items: saveItems,\n  },\n};\n\n// Return:\n// 1) payload for save API\n// 2) mapping so merge node can connect save response back to original details\n// 3) validation errors that must be returned later\nreturn {\n  saveApiPayload,\n  requestMap,\n  validationErrorRecords,\n};\n"
          },
