        {
          "metadata": {
            "name": "MergeSaveApiOutputWithInput",
            "returnType": "object",
            "sourceCode": "// Original input from the calling API flow\nconst inputDetails = Array.isArray($context.$triggers.REST.$input.details)\n  ? $context.$triggers.REST.$input.details\n  : [];\n  \n// Output from saveLogicalJSONToSensorAnomaly\nconst saveLogicalNodeOutput = $context.$nodes.SAVELOGICALJSONTOSENSORANOMALY.$output;\nconst saveLogicalResult = saveLogicalNodeOutput?.result ?? {};\nconst validationErrorRecords = Array.isArray(saveLogicalResult.validationErrorRecords)\n  ? saveLogicalResult.validationErrorRecords\n  : [];\n// Records that were sent to the save API\nconst requestMap = Array.isArray(saveLogicalResult.requestMap)\n  ? saveLogicalResult.requestMap\n  : [];\n    \n// Save API response\nconst saveApiResponse = $context.$nodes.SAVE_AP_ANOMALY_POLICIES.$output;\nconst saveApiResult = saveApiResponse?.result ?? {};\nconst saveItems = Array.isArray(saveApiResult.items) ? saveApiResult.items : [];\n\n// Build quick lookup maps\nconst validationErrorByDetailId = new Map();\nfor (const record of validationErrorRecords) {\n  validationErrorByDetailId.set(record.detailId, record);\n}\n\nconst requestByDetailId = new Map();\nfor (const record of requestMap) {\n  requestByDetailId.set(record.detailId, record);\n}\n\nconst errorByRuleId = new Map();\nconst errorByActionId = new Map();\n\nfor (const item of saveItems) {\n  // only items with $statusCode >= 400 are treated as save errors\n  if (item?.$statusCode >= 400 && Array.isArray(item.details)) {\n    for (const detail of item.details) {\n      const msg = detail?.title || item?.title || \"Unknown error\";\n\n      const ruleMatch = msg.match(/ruleId=(\\d+)/);\n      const actionMatch = msg.match(/actionId=(\\d+)/);\n\n      if (ruleMatch) {\n        errorByRuleId.set(Number(ruleMatch[1]), msg);\n      }\n\n      if (actionMatch) {\n        errorByActionId.set(Number(actionMatch[1]), msg);\n      }\n    }\n  }\n}\n\n// Merge everything back into the original input\nconst updatedDetails = [];\n\nfor (const detail of inputDetails) {\n  const updated = Object.assign({}, detail);\n\n  // 1) Validation error from saveLogicalJSONToSensorAnomaly\n  const validationError = validationErrorByDetailId.get(detail.detailId);\n  if (validationError) {\n    updated.status = validationError.status || \"Publish_Error\";\n    updated.errorMessage = validationError.errorMessage || \"Validation error\";\n    updatedDetails.push(updated);\n    continue;\n  }\n\n  // 2) If this detail was not sent to Save AP, \n  // do not force it to Published, keep it as-is\n  const req = requestByDetailId.get(detail.detailId);\n  if (!req) {\n    updatedDetails.push(updated);\n    continue;\n  }\n\n  // 3) Save API error for sent records\n  const ruleId = Number(req.ruleId);\n  const actionId = Number(req.actionId);\n\n  const saveErrMsg =\n    (Number.isFinite(ruleId) && errorByRuleId.get(ruleId)) ||\n    (Number.isFinite(actionId) && errorByActionId.get(actionId)) ||\n    \"\";\n\n  if (saveErrMsg) {\n    updated.status = \"Publish_Error\";\n    updated.errorMessage = saveErrMsg;\n    updatedDetails.push(updated);\n    continue;\n  }\n\n  // 4) Success\n  // This detail was sent to Save AP and did not fail.\n  updated.status = \"Published\";\n  updated.errorMessage = null;\n  updatedDetails.push(updated);\n}\n\n// Return in the same format the calling API expects\nreturn {\n  agentOperation: $context.$triggers.REST.$input.agentOperation  || \"SAVE\",\n  details: updatedDetails,\n};"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "MERGESAVEAPIOUTPUTWITHINPUT",
