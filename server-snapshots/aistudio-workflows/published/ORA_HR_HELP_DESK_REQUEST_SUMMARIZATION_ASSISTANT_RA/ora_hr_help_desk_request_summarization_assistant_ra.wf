            "returnType": "string",
            "sourceCode": "const summary =\n  $context.$nodes.HRHDREQUESTSUMMARIZATION_MODEL ?.$output ??\n  $context.$nodes.HRHDREQUESTSOLUTIONSUMMARIZATION_MODEL ?.$output ??\n  $context.$nodes.SUMMARISE_CONTENT_ONLY ?.$output ??\n  \"Not enough relevant conversational data available to generate a meaningful summary.\";\n\nconst maxLen = Number($context.$triggers.REST?.$input?.summaryLength) || 1000;\n\nreturn String(summary).slice(0, maxLen-1);"
          },
          "outcomes": {
            "success": "1772712517527"
          },
