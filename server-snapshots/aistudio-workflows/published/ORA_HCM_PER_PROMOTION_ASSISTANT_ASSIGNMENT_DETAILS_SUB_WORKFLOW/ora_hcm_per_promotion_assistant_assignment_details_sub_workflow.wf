            "name": "generateInputForManagerNotes",
            "returnType": "object",
            "sourceCode": "let returnObj = {\n  'DisplayName': $context.$variables.message.DisplayName,\n  'PersonId': $context.$variables.message.PersonId,\n  'JobName': $context.$nodes.COLLECTOUTPUTS.$output.JobName,\n  'JobSeniority': $context.$nodes.COLLECTOUTPUTS.$output.JobSeniority,\n  'TotalSeniority': $context.$nodes.COLLECTOUTPUTS.$output.EnterpriseSeniority,\n  'ActionName': $context.$nodes.COLLECTOUTPUTS.$output.ActionName,\n  'ActionReasonName': $context.$nodes.COLLECTOUTPUTS.$output.ActionReasonName,\n  'DepartmentName': $context.$nodes.COLLECTOUTPUTS.$output.EmploymentConfigurationsObject.AssignmentMap.DepartmentName,\n  'LocationName': $context.$nodes.COLLECTOUTPUTS.$output.EmploymentConfigurationsObject.AssignmentMap.LocationName,\n  'CurrentJobName': $context.$nodes.COLLECTOUTPUTS.$output.EmploymentConfigurationsObject.AssignmentMap.JobName\n};\n\nreturn returnObj;"
          },
          "outcomes": {
            "success": "1767302316416"
          },
          "code": "GENERATEINPUTFORMANAGERNOTES",
          "id": "1773060974845",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "InvalidAttributesObject",
            "returnType": "object",
            "sourceCode": "let invalidAttributesObject = {\"isInvalidAttributesPresent\" : false}\n\n//job check\nlet jobData = $context.$nodes.JOBSEARCHBO.$output\nlet isJobPresent= $context.$variables.message.isProposedJobPresent\nif(isJobPresent && !(jobData && jobData.items && jobData.items.length > 0))\n{ \n    invalidAttributesObject.isInvalidAttributesPresent = true\n    //invalidAttributesObject.isJobInvalid = true\n    invalidAttributesObject.InvalidJobName = $context.$variables.message.proposedJobName\n}\n\n//grade check\nlet gradeData = $context.$nodes.GRADESEARCHBO.$output \nlet isGradePresent= $context.$variables.message.isProposedGradePresent\nif(isGradePresent && !(gradeData && gradeData.items && gradeData.items.length > 0))\n{ \n    invalidAttributesObject.isInvalidAttributesPresent = true\n    //invalidAttributesObject.isGradeInvalid = true\n    invalidAttributesObject.InvalidGradeName = $context.$variables.message.proposedGradeName\n}\n\n//action check\nlet actionData = $context.$nodes.FETCH_ACTIONS_BO.$output \nlet isactionPresent= $context.$variables.message.isProposedActionPresent\nif(isactionPresent && !(actionData && actionData.items && actionData.items.length > 0))\n{ \n    invalidAttributesObject.isInvalidAttributesPresent = true\n    //invalidAttributesObject.isActionInvalid = true\n    invalidAttributesObject.InvalidActionName = $context.$variables.message.proposedActionName\n}\n\n//reason check\nlet reasonData = $context.$nodes.FETCH_ACTION_REASON_BO.$output \nlet isReasonPresent= $context.$variables.message.isProposedActionReasonPresent\nif(isReasonPresent && !(reasonData && reasonData.items && reasonData.items.length > 0))\n{ \n    invalidAttributesObject.isInvalidAttributesPresent = true\n    //invalidAttributesObject.isReasonInvalid = true\n    invalidAttributesObject.InvalidReasonName = $context.$variables.message.proposedActionReasonName\n}\n\n\n\nreturn invalidAttributesObject"
          },
          "outcomes": {
            "success": "1773060974845"
          },
          "code": "INVALIDATTRIBUTESOBJECT",
          "id": "1775044334356",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
