{
  "workflowId": "300000331058161",
  "workflowCode": "ORA_HCM_PER_PROMOTION_ASSISTANT_ASSIGNMENT_DETAILS_SUB_WORKFLOW",
  "name": "Promotion Assistant Assignment Details Subworkflow",
  "description": "This workflow fetches all the assignment details and also generates the manager notes of a worker assignment.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
