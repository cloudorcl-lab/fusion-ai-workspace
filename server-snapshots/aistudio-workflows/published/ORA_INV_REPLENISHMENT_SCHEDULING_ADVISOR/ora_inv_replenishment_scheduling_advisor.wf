                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"description\": \"\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"OrganizationId\",\n          \"InventoryItemId\",\n          \"ItemNumber\",\n          \"Subinventory\",\n          \"SubinventoryName\",\n          \"SubinventoryId\",\n          \"PrimaryUnitOfMeasureCode\",\n          \"PrimaryUnitOfMeasure\",\n          \"AvailableToTransactQuantity\",\n          \"SuggestedQuantityForReplenishment\",\n          \"AvailableQuantityInRequestedUOM\"\n        ],\n        \"properties\": {\n          \"OrganizationId\": {\n            \"type\": \"number\"\n          },\n          \"InventoryItemId\": {\n            \"type\": \"number\"\n          },\n          \"ItemNumber\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"Subinventory\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"SubinventoryName\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"SubinventoryId\": {\n            \"type\": \"number\"\n          },\n          \"LocatorId\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"Locator\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"PrimaryUnitOfMeasureCode\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"Revision\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"RevisionQuantityControlFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"SecondaryUnitOfMeasureCode\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"PrimaryUnitOfMeasure\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"SecondaryUnitOfMeasure\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"AvailableToTransactQuantity\": {\n            \"type\": \"number\"\n          },\n          \"SecondaryAvailableToTransactQuantity\": {\n            \"type\": \"number\"\n          },\n          \"ItemMinimumQuantity\": {\n            \"type\": \"number\"\n          },\n          \"SuggestedQuantityForReplenishment\": {\n            \"type\": \"number\"\n          },\n          \"InterSubinventoryParametersFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"AvailableQuantityInRequestedUOM\": {\n            \"type\": \"number\"\n          }\n        }\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"href\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"name\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"kind\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\"