                {
                  "metadata": {
                    "name": "GetReplenishmentOptions",
                    "returnType": "array",
                    "sourceCode": "// Extract input nodes from context safely\nvar minValue = Number($context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.ItemMinimumValue ?? 0);\nvar availableQty = Number($context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.AvailableToTransactQuantity ?? 0);\nvar required_quantity = minValue - availableQty;\nvar l_index = 0;\nvar output = [];\n\n// 1. Inbound Supply\nvar inboundSupply = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.INBOUNDSUPPLY.$output?.items ?? [];\nfor (var i = 0; i < inboundSupply.length; i++) {\n    var item = inboundSupply[i];\n    if (!item) continue;\n    if (required_quantity <= 0) break;\n    var available_qty = item.PrimaryQuantity;\n    output[l_index] = {};\n    output[l_index].ReplenishmentType = 'NO_ORDER';\n    output[l_index].DestinationOrganizationId = item.OrganizationId;\n    output[l_index].SourceOrganizationCode = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.ITEMTOPROCESS.$output.result.OrganizationCode;\n    output[l_index].ItemNumber = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.ItemNumber;\n    output[l_index].DestinationSubinventoryCode = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.Subinventory;\n    output[l_index].DestinationLocatorId = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.LocatorId;\n    output[l_index].SourceOrganizationId = item.OrganizationId;\n    output[l_index].SourceSubinventory = item.Subinventory;\n    output[l_index].SourceLocatorId = null;\n    output[l_index].InventoryItemId = item.InventoryItemId;\n    output[l_index].ItemNumber = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.ItemNumber;\n    output[l_index].UOMCode = item.PrimaryUnitOfMeasureCode;\n    output[l_index].UOMName = item.PrimaryUnitOfMeasure;\n    output[l_index].BuyerEmailAddress = null;\n    if (available_qty >= required_quantity) {\n        output[l_index].OrderQuantity = required_quantity;\n        output[l_index].Suggestions =\n            item.DocumentType + ' ' + item.DocumentNumber +\n            ' for item ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.ItemNumber +\n            ', with a quantity of ' + item.PrimaryQuantity + ' ' + item.PrimaryUnitOfMeasure +\n            ', is expected to be received on ' + item.DueDate +\n            '. Consider expediting this order to resolve the shortage.';\n        required_quantity = 0;\n        l_index++;\n        break;\n    } else {\n        output[l_index].OrderQuantity = available_qty;\n        if (!item.InventoryItemId){\n            continue;\n        }\n        output[l_index].Suggestions =\n            item.DocumentType + ' ' + item.DocumentNumber +\n            ' for item ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.ItemNumber +\n            ', with a quantity of ' + item.PrimaryQuantity + ' ' + item.PrimaryUnitOfMeasure +\n            ', is expected to be received on ' + item.DueDate +\n            '. Consider expediting this order to resolve the shortage.';\n        required_quantity -= available_qty;\n        l_index++;\n    }\n}\n\n// 2. Substitute Items Availability Within Organization\nvar substituteAvailability = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.SUBSTITUTEITEMSAVAILABILITY.$output?.items ?? [];\nfor (var i = 0; i < substituteAvailability.length; i++) {\n    var item = substituteAvailability[i];\n    if (!item) continue;\n    if (!item.ItemNumber) continue;\n    if (required_quantity <= 0) break;\n    var available_qty = item.AvailableQuantityInRequestedUOM;\n    output[l_index] = {};\n    output[l_index].ReplenishmentType = 'NO_ORDER';\n    output[l_index].DestinationOrganizationId = item.OrganizationId;\n    output[l_index].SourceOrganizationCode = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.ITEMTOPROCESS.$output.result.OrganizationCode;\n    output[l_index].DestinationSubinventoryCode = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.Subinventory;\n    output[l_index].DestinationLocatorId = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.LocatorId;\n    output[l_index].SourceOrganizationId = item.OrganizationId;\n    output[l_index].SourceSubinventory = item.Subinventory;\n    output[l_index].SourceLocatorId = null;\n    output[l_index].InventoryItemId = item.InventoryItemId;\n    output[l_index].ItemNumber = item.ItemNumber;\n    output[l_index].UOMCode = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.PrimaryUnitOfMeasureCode;\n    output[l_index].UOMName = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.PrimaryUnitOfMeasure;\n    output[l_index].BuyerEmailAddress = null;\n    if (available_qty >= required_quantity) {\n        output[l_index].OrderQuantity = required_quantity;\n        var suggestion =\n            'A substitute item ' + item.ItemNumber +\n            ', with ' + item.AvailableQuantityInRequestedUOM + ' ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.PrimaryUnitOfMeasure +\n            ', is available in subinventory ' + item.Subinventory;\n        if (item.Locator) {\n            suggestion += ', locator ' + item.Locator;\n        }\n        suggestion += ', within the same organization. Consider using this item until the shortage for ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.ItemNumber + ' is resolved.';\n        output[l_index].Suggestions = suggestion;\n        required_quantity = 0;\n        l_index++;\n        break;\n    } else {\n        output[l_index].OrderQuantity = available_qty;\n        var suggestion =\n            'A substitute item ' + item.ItemNumber +\n            ', with ' + item.AvailableQuantityInRequestedUOM + ' ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem.PrimaryUnitOfMeasure +\n            ', is available in subinventory ' + item.Subinventory;\n        if (item.Locator) {\n            suggestion += ', locator ' + item.Locator;\n        }\n        suggestion += ', within the same organization. Consider using this item until the shortage for ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.ItemNumber + ' is resolved.';\n        output[l_index].Suggestions = suggestion;\n        required_quantity -= available_qty;\n        l_index++;\n    }\n}\n\n// 3. Item Availability Within Organization (other subinventories)\nvar availabilityWithinOrg = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.ITEM_AVAILABILITY_WITH_IN_ORGANIZATION.$output?.items ?? [];\nfor (var i = 0; i < availabilityWithinOrg.length; i++) {\n    var item = availabilityWithinOrg[i];\n    if (item.SuggestedQuantityForReplenishment <= 0) { continue; }\n    if (required_quantity <= 0) { break; }\n    if (\n        $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.Subinventory === item.Subinventory &&\n        (!$context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.LocatorId || $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.LocatorId == item.LocatorId)\n    ) {\n        continue;\n    }\n    var available_qty = item.SuggestedQuantityForReplenishment;\n    var replenish_type = item.InterSubinventoryParametersFlag === true ? 'TO' : 'MO';\n    output[l_index] = {};\n    output[l_index].ReplenishmentType = replenish_type;\n    output[l_index].DestinationOrganizationId = item.OrganizationId;\n    output[l_index].SourceOrganizationCode = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.ITEMTOPROCESS.$output.result.OrganizationCode;\n    output[l_index].DestinationSubinventoryCode = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.Subinventory;\n    output[l_index].DestinationLocatorId = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.LocatorId;\n    output[l_index].SourceOrganizationId = item.OrganizationId;\n    output[l_index].SourceSubinventory = item.Subinventory;\n    output[l_index].SourceLocatorId = item.LocatorId;\n    output[l_index].InventoryItemId = item.InventoryItemId;\n    output[l_index].ItemNumber = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.ItemNumber;\n    output[l_index].UOMCode = item.PrimaryUnitOfMeasureCode;\n    output[l_index].UOMName = item.PrimaryUnitOfMeasure;\n    output[l_index].BuyerEmailAddress = null;\n    if (available_qty >= required_quantity) {\n        output[l_index].OrderQuantity = required_quantity;\n        var suggestion =\n            (replenish_type === 'TO' ? 'Create a transfer order' : 'Create a movement request') +\n            ' to transfer ' + required_quantity + ' ' + item.PrimaryUnitOfMeasure +\n            ' of the item ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.ItemNumber +\n            ' from subinventory ' + item.Subinventory;\n        if (item.Locator) {\n            suggestion += ' and locator ' + item.Locator;\n        }\n        suggestion += ' to subinventory ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.Subinventory;\n        if ($context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.LocatorName) {\n            suggestion += ' and locator ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.LocatorName;\n        }\n        suggestion += '.';\n        output[l_index].Suggestions = suggestion;\n        required_quantity = 0;\n        l_index++;\n        break;\n    } else {\n        output[l_index].OrderQuantity = available_qty;\n        var suggestion =\n            (replenish_type === 'TO' ? 'Create a transfer order' : 'Create a movement request') +\n            ' to transfer ' + available_qty + ' ' + item.PrimaryUnitOfMeasure +\n            ' of the item ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.ItemNumber +\n            ' from subinventory ' + item.Subinventory;\n        if (item.Locator) {\n            suggestion += ' and locator ' + item.Locator;\n        }\n        suggestion += ' to subinventory ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.Subinventory;\n        if ($context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.LocatorName) {\n            suggestion += ' and locator ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.LocatorName;\n        }\n        suggestion += '.';\n        output[l_index].Suggestions = suggestion;\n        required_quantity -= available_qty;\n        l_index++;\n    }\n}\n\n// 4. Substitute Availability In Other Subinventory\nvar substituteOtherSubinv = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.SUBSTITUEAVAIABILITYINOTHERSUBINVENTORY.$output?.items ?? [];\nfor (var i = 0; i < substituteOtherSubinv.length; i++) {\n    var item = substituteOtherSubinv[i];\n    if (required_quantity <= 0) { break; }\n    var available_qty = item.AvailableQuantityInRequestedUOM;\n    if (available_qty <= 0) { continue; }\n    var replenish_type = item.InterSubinventoryParametersFlag === true ? 'TO' : 'MO';\n    output[l_index] = {};\n    output[l_index].ReplenishmentType = replenish_type;\n    output[l_index].DestinationOrganizationId = item.OrganizationId;\n    output[l_index].SourceOrganizationCode = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.ITEMTOPROCESS.$output.result.OrganizationCode;\n    output[l_index].DestinationSubinventoryCode = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.Subinventory;\n    output[l_index].DestinationLocatorId = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.LocatorId;\n    output[l_index].SourceOrganizationId = item.OrganizationId;\n    output[l_index].SourceSubinventory = item.Subinventory;\n    output[l_index].SourceLocatorId = item.LocatorId;\n    output[l_index].InventoryItemId = item.InventoryItemId;\n    output[l_index].ItemNumber = item.ItemNumber;\n    output[l_index].UOMCode = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.PrimaryUnitOfMeasureCode;\n    output[l_index].UOMName = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.PrimaryUnitOfMeasure;\n    output[l_index].BuyerEmailAddress = null;\n    if (available_qty >= required_quantity) {\n        output[l_index].OrderQuantity = required_quantity;\n        var suggestion =\n            (replenish_type === 'TO' ? 'Create a transfer order' : 'Create a movement request') +\n            ' to transfer ' + required_quantity + ' ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.PrimaryUnitOfMeasure +\n            ' of substitute item ' + item.ItemNumber +\n            ' from subinventory ' + item.Subinventory;\n        if (item.Locator) {\n            suggestion += ' and locator ' + item.Locator;\n        }\n        suggestion += ' to subinventory ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.Subinventory;\n        if ($context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.LocatorName) {\n            suggestion += ' and locator ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.LocatorName;\n        }\n        suggestion += '.';\n        output[l_index].Suggestions = suggestion;\n        required_quantity = 0;\n        l_index++;\n        break;\n    } else {\n        output[l_index].OrderQuantity = available_qty;\n        var suggestion =\n            (replenish_type === 'TO' ? 'Create a transfer order' : 'Create a movement request') +\n            ' to transfer ' + available_qty + ' ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.PrimaryUnitOfMeasure +\n            ' of substitute item ' + item.ItemNumber +\n            ' from subinventory ' + item.Subinventory;\n        if (item.Locator) {\n            suggestion += ' and locator ' + item.Locator;\n        }\n        suggestion += ' to subinventory ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.Subinventory;\n        if ($context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.LocatorName) {\n            suggestion += ' and locator ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.LocatorName;\n        }\n        suggestion += '.';\n        output[l_index].Suggestions = suggestion;\n        required_quantity -= available_qty;\n        l_index++;\n    }\n}\n\n// 5. Item Availability In Other Organization\nvar availabilityInOtherOrg = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.ITEM_AVAILABILITY_IN_OTHER_ORGANIZATION.$output?.items ?? [];\nfor (var i = 0; i < availabilityInOtherOrg.length; i++) {\n    var item = availabilityInOtherOrg[i];\n    if (required_quantity <= 0) { break; }\n    var available_qty = item.AvailableQuantityInRequestedUOM;\n    output[l_index] = {};\n    output[l_index].ReplenishmentType = 'TO';\n    output[l_index].DestinationOrganizationId = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.OrganizationId;\n    output[l_index].SourceOrganizationCode = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.ITEMTOPROCESS.$output.result.OrganizationCode;\n    output[l_index].DestinationSubinventoryCode = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.Subinventory;\n    output[l_index].DestinationLocatorId = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.LocatorId;\n    output[l_index].SourceOrganizationId = item.OrganizationId;\n    output[l_index].SourceSubinventory = item.Subinventory;\n    output[l_index].SourceLocatorId = item.LocatorId;\n    output[l_index].InventoryItemId = item.InventoryItemId;\n    output[l_index].ItemNumber = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.ItemNumber;\n    output[l_index].UOMCode = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.PrimaryUnitOfMeasureCode;\n    output[l_index].UOMName = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.PrimaryUnitOfMeasure;\n    output[l_index].BuyerEmailAddress = null;\n    if (available_qty >= required_quantity) {\n        output[l_index].OrderQuantity = required_quantity;\n        output[l_index].Suggestions =\n            'Create a transfer order to transfer ' + required_quantity + ' ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.PrimaryUnitOfMeasure +\n            ' of item ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.ItemNumber +\n            ' from organization ' + item.OrganizationCode +\n            ' to organization ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.OrganizationCode +\n            ' and subinventory ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.Subinventory + '.';\n        required_quantity = 0;\n        l_index++;\n        break;\n    } else {\n        output[l_index].OrderQuantity = available_qty;\n        output[l_index].Suggestions =\n            'Create a transfer order to transfer ' + available_qty + ' ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.PrimaryUnitOfMeasure +\n            ' of item ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.ItemNumber +\n            ' from organization ' + item.OrganizationCode +\n            ' to organization ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.OrganizationCode +\n            ' and subinventory ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.Subinventory + '.';\n        required_quantity -= available_qty;\n        l_index++;\n    }\n}\n\n// 6. Create Purchase Order if still short\nif (required_quantity > 0) {\n    output[l_index] = {};\n    output[l_index].Suggestions =\n        'Create a purchase requisition for ' + required_quantity + ' ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.PrimaryUnitOfMeasure +\n        ' of item ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.ItemNumber +\n        ' for organization ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.OrganizationCode +\n        ', to be received into subinventory ' + $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.Subinventory + '.';\n    output[l_index].ReplenishmentType = 'PO';\n    output[l_index].DestinationOrganizationId = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.OrganizationId;\n    output[l_index].SourceOrganizationCode = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.ITEMTOPROCESS.$output.result.OrganizationCode;\n    output[l_index].DestinationSubinventoryCode = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.Subinventory;\n    output[l_index].DestinationLocatorId = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.LocatorId;\n    output[l_index].ItemNumber = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.ItemNumber;\n    output[l_index].SourceOrganizationId = null;\n    output[l_index].SourceSubinventory = null;\n    output[l_index].SourceLocatorId = null;\n    output[l_index].InventoryItemId = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem.InventoryItemId;\n    output[l_index].OrderQuantity = required_quantity;\n    output[l_index].UOMCode = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.PrimaryUnitOfMeasureCode;\n    output[l_index].UOMName = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$currentItem?.PrimaryUnitOfMeasure;\n    output[l_index].BuyerEmailAddress = null;\n}\n\nreturn output;"
