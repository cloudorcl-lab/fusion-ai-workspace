        {
          "metadata": {
            "name": "PrepareOrdersList",
            "returnType": "array",
            "sourceCode": "let OrdersFromLoop = $context.$nodes.LOOPTHROUGHITEMSTOREPLENISH.$output;\nvar finalArray = [];\n\nif (Array.isArray(OrdersFromLoop) && OrdersFromLoop.length > 0) {\n\n  for (var i = 0; i < OrdersFromLoop.length; i++) {\n    try {\n      var parsed = JSON.parse(OrdersFromLoop[i]);\n\n      if (parsed && parsed.result && Array.isArray(parsed.result.items)) {\n        for (var j = 0; j < parsed.result.items.length; j++) {\n          var item = parsed.result.items[j];\n\n          if (item.ReplenishmentType === \"NO_ORDER\") {\n            continue;\n          }\n\n          finalArray.push(item);\n        }\n      }\n    } catch (e) {\n      // skip invalid entries\n    }\n  }\n}\n\nreturn finalArray;"
          },
          "outcomes": {
            "success": "1763634777722"
          },
