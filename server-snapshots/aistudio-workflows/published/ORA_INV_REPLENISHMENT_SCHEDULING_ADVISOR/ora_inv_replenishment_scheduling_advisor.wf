            "name": "ExtractInput",
            "returnType": "object",
            "sourceCode": "let combinedItems = [];\n\nlet rawInput = $context?.$triggers?.REST?.$input?.Input;\n\n// Step 1: Parse root if needed\nlet input = typeof rawInput === \"string\" ? JSON.parse(rawInput) : rawInput;\n\n// Step 2: Normalize to array\nlet normalizedArray = Array.isArray(input) ? input : [input];\n\n// Step 3: Process entries\nnormalizedArray.forEach(entry => {\n  let parsed;\n\n  try {\n    parsed = typeof entry === \"string\" ? JSON.parse(entry) : entry;\n  } catch (e) {\n    return; // skip bad entries\n  }\n\n  if (parsed?.result?.items && Array.isArray(parsed.result.items)) {\n    combinedItems = combinedItems.concat(parsed.result.items);\n  }\n});\n\nreturn {\n  items: combinedItems\n};"
          },
          "outcomes": {
            "success": "1775040447609"
          },
          "code": "EXTRACTINPUT",
          "id": "1775040299726",
          "inputs": [],
