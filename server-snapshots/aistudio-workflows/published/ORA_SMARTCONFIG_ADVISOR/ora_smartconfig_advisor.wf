{
  "workflowId": "100002355226935",
  "workflowCode": "ORA_SMARTCONFIG_ADVISOR",
  "name": "SmartConfig Advisor",
  "description": "You are a Config Advisor Agent responsible for displaying the top 3 config recommendations/Top N options.Your job is to fetch the  top 3 config recommendations/Top N options based on user input.storing all data in `{chatHistory}` without hallucination.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1766988868683"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "description": "End of data pipeline",
            "name": "End"
          },
          "outcomes": {},
          "code": "END",
          "id": "end",
          "inputs": [],
          "type": "END"
        },
        {
          "metadata": {
            "name": "Extract Input data"
          },
          "outcomes": {
            "success": "1766989058125"
          },
          "code": "EXTRACT_INPUT_DATA",
          "id": "1766988868683",
          "inputs": [
            {
              "id": "1766988868685_1",
              "name": "prompt",
              "type": "string",
              "value": "Extract the user input from the following: {{$context.$system.$inputMessage}}\nif Context related data is present then extract it into 'Context' output otherwise set 'Context' to null. ('Context'  should be String)\nif ModelItems related data is present then extract it into 'ModelItems' output otherwise set 'ModelItems' to null. ('ModelItems'  should be JSON String Array)\nif ComponentItems related data is present then extract it into 'ComponentItems' output otherwise set 'ComponentItems' to null. ('ComponentItems'  should be JSON String Array)\nif OrganizationId related data is present then extract it into 'OrganizationId' output otherwise set 'OrganizationId' to null. \nif CustomerId related data is present then extract it into 'CustomerId' output otherwise set 'CustomerId' to null. \nif Model related data is present then extract it into 'Model' output otherwise set 'Model' to null. ('Model'  should be String)\nif OptionalClassItems related data is present then extract it into 'OptionalClassItems' output otherwise set 'OptionalClassItems' to null. ('OptionalClassItems'  should be JSON String Array)\n\n\nUse natural language processing to identify the values for the each attribute of the following list:\n\nContext\nComponentItems\nModelItems\nOrganizationId\nCustomerId\nModel\nOptionalClassItems"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"CustomerId\": {\n            \"type\": \"number\"\n        },\n        \"Context\": {\n            \"type\": \"string\"\n        },\n\"ModelItems\": {\n            \"type\": \"string\"\n        },\n        \"OrganizationId\": {\n            \"type\": \"number\"\n        },\n        \"ComponentItems\": {\n            \"type\": \"string\"\n        },\n\"OptionalClassItems\": {\n            \"type\": \"string\"\n        },\n        \"Model\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Set Context",
            "returnType": "boolean",
            "sourceCode": "if($context.$nodes.EXTRACT_INPUT_DATA.$output.Context  === \"ConfigRecommendations\"){\n return true;\n}else \nreturn false;"
          },
          "outcomes": {
            "success": "1766989379643"
          },
          "code": "SET_CONTEXT",
          "id": "1766989058125",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Determine Recommendation Flow"
          },
          "outcomes": {
            "true": "1766990662559",
            "false": "1766989453404"
          },
          "code": "DETERMINE_RECOMMENDATION_FLOW",
          "convergenceTargetId": "end",
          "id": "1766989379643",
          "inputs": [
            {
              "id": "1766989379645_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.SET_CONTEXT.$output.result}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_SCM_SUPPLYCHAI_CONFIGOPTIONRECOMMENDATIONS",
            "functionName": "getConfigOptionRecommendations",
            "name": "Retrieve Config Option Recommendations"
          },
          "outcomes": {
            "success": "1766989905678"
          },
          "code": "RETRIEVE_CONFIG_OPTION_RECOMMENDATIONS",
          "id": "1766989453404",
          "inputs": [
            {
              "id": "1766989749692_1",
              "name": "pModelItem",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_INPUT_DATA.$output.Model}}"
            },
            {
              "id": "1766989749693_2",
              "name": "pOptionalClassItems",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_INPUT_DATA.$output.OptionalClassItems}}"
            },
            {
              "id": "1766989749694_3",
              "name": "pOrganizationId",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_INPUT_DATA.$output.OrganizationId}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"ModelItemId\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"OptionClasses\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"OptionClassItemId\": {\n            \"type\": \"number\"\n          },\n          \"OptionClassItemNumber\": {\n            \"type\": \"string\"\n          },\n          \"OptionClassItemDescription\": {\n            \"type\": \"string\"\n          },\n          \"SalesOrderCount\": {\n            \"type\": \"integer\"\n          },\n          \"OptionalItems\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"OptionItemId\": {\n                  \"type\": \"number\"\n                },\n                \"Rank\": {\n                  \"type\": \"integer\"\n                },\n                \"SalesOrderCount\": {\n                  \"type\": \"integer\"\n                },\n                \"OptionItemNumber\": {\n                  \"type\": \"string\"\n                },\n                \"OptionItemDescription\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"required\": [\n                \"OptionItemId\",\n                \"Rank\",\n                \"SalesOrderCount\",\n                \"OptionItemNumber\",\n                \"OptionItemDescription\"\n              ]\n            }\n          }\n        },\n        \"required\": [\n          \"OptionClassItemId\",\n          \"OptionClassItemNumber\",\n          \"OptionClassItemDescription\",\n          \"SalesOrderCount\",\n          \"OptionalItems\"\n        ]\n      }\n    },\n    \"ModelItemNumber\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"ModelItemId\",\n    \"OptionClasses\",\n    \"ModelItemNumber\"\n  ]\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Display Recommended Config Options"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "DISPLAY_RECOMMENDED_CONFIG_OPTIONS",
          "id": "1766989905678",
          "inputs": [
            {
              "id": "1766989905682_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an HTML table generator. Your task is to generate and output ONLY the complete HTML code for the table below, with no additional text, explanations, or markdown.\n\nUse the following JSON data to populate the table:\n{{$context.$nodes.RETRIEVE_CONFIG_OPTION_RECOMMENDATIONS.$output}} \n\nFor each item in the OptionClasses array:\n- Sort {{$context.$nodes.RETRIEVE_CONFIG_OPTION_RECOMMENDATIONS.$output}}  by `Rank` Ascending.\n- Use OptionClassItemDescription as the PARENT_NAME (bold, left-padded cell)\n- For each object in its OptionalItems array, create one row using:\n  - Column 1 (OptionClass ItemNumber Description): OptionClassItemDescription\n  - Column 2 (ItemNumber): OptionItemNumber\n  - Column 3 (ItemNumber Description): OptionItemDescription\n  - Column 4 (Rank): Rank \n\nIf there are no OptionClasses or no OptionalItems, output an empty table body.\n\nOutput exactly this HTML structure:\n\n<br>\n<p><strong>Recommended Configuration Options:</strong></p><br>\n<br>\n<table class=\"config-comparison\" style=\"width:100%; border-collapse:collapse; font-family:Arial,sans-serif; font-size:14px; border: 1px solid #ccc;\">\n  <thead>\n    <tr style=\"background:#f0f0f0;\">\n      <th style=\"padding:8px; text-align:center; border: 1px solid #ccc;\">Option Class</th>\n      <th style=\"padding:8px; text-align:center; border: 1px solid #ccc;\">Item Number</th>\n      <th style=\"padding:8px; text-align:center; border: 1px solid #ccc;\">Description</th>\n      <th style=\"padding:8px; text-align:center; border: 1px solid #ccc;\">Popularity</th>\n    </tr>\n  </thead>\n  <tbody>\n    <!-- Insert one <tr> for each OptionalItem -->\n    <!-- Example row: -->\n    <!-- <tr>\n      <td style=\"padding:6px; padding-left:20px; font-weight:bold; border: 1px solid #ccc;\">PARENT_NAME</td>\n      <td style=\"padding:6px; text-align:center; border: 1px solid #ccc;\">CHILD_ITEM_NUMBER</td>\n      <td style=\"padding:6px; text-align:center; border: 1px solid #ccc;\">CHILD_ITEM_NUMBER_DESCRIPTION</td>\n      <td style=\"padding:6px; text-align:center; border: 1px solid #ccc;\">RANK</td>\n    </tr> -->\n  </tbody>\n</table>\n<br><br>\n\nDo not add any text before, after, or around this HTML. Output only the final rendered HTML."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "agentCode": "ORA_CONFIG_RECOMMENDATION_ADVISOR",
            "name": "TopConfig Advisor"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "TOPCONFIG_ADVISOR",
          "id": "1766990662559",
          "inputs": [
            {
              "id": "1767703958171_1",
              "name": "message",
              "type": "string",
              "value": "{{\"ModelItems=\" + $context.$nodes.EXTRACT_INPUT_DATA.$output.ModelItems + \"; ComponentItems=\" + $context.$nodes.EXTRACT_INPUT_DATA.$output.ComponentItems + \"; OrganizationId=\" + $context.$nodes.EXTRACT_INPUT_DATA.$output.OrganizationId + \"; CustomerId =\" + $context.$nodes.EXTRACT_INPUT_DATA.$output.CustomerId}}"
            }
          ],
          "outputSpecification": " ",
          "type": "AGENT"
        }
      ],
      "rootNode": "start",
