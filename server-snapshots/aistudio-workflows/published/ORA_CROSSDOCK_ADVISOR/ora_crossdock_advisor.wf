                        {
                          "metadata": {
                            "name": "Initialize Org Params",
                            "returnType": "object",
                            "sourceCode": "const startDate = $context.$variables.vStartDate;\nconst orgParams = $context.$nodes.FOR_EACH_ELIGIBLE_ORGANIZATION.$currentItem;\nconst advParams = orgParams.advancedInvParams.items[0];\n\nlet demandOrderBy;\nlet returnObj = {};\n\n// Calculate expected supply end date\nreturnObj.expectedSupplyEndDate = new Date(startDate);\nif ( advParams.CrossDockExpectedSupplyDays != null ) {\n  returnObj.expectedSupplyEndDate.setDate(returnObj.expectedSupplyEndDate.getDate() + Number(advParams.CrossDockExpectedSupplyDays));\n}\nreturnObj.expectedSupplyEndDate = returnObj.expectedSupplyEndDate?.toISOString().split('T')[0];\n\n// Calculate demand end date\nreturnObj.demandEndDate = new Date(startDate);\nif ( advParams.CrossDockDemandDueDays != null ) {\n  returnObj.demandEndDate.setDate(returnObj.demandEndDate.getDate() + Number(advParams.CrossDockDemandDueDays));\n}\nreturnObj.demandEndDate = returnObj.demandEndDate?.toISOString().split('T')[0];\n\n// Create sub query for supply\nconst itemList = $context.$nodes.FORMAT_VARIABLES.$output.result.ItemList;\nconst receiptList = $context.$nodes.FORMAT_VARIABLES.$output.result.ReceiptList;\n\nif ( itemList || receiptList ) {\n  const queryItem = itemList ? `ItemNumber IN (${itemList})` : '';\n  const queryReceipt = receiptList ? `ReceiptNumber IN (${receiptList})` : '';\n  const whereClause = [queryItem, queryReceipt].filter(Boolean).join(' AND ');\n  \n  returnObj.supplySubQuery =  '&orderBy=ItemId' + whereClause ? `&q=${whereClause}` : '';  \n}\n\n// Create demand sort order rule\nif ( advParams.CrossDockDueDateSort == 'A' ) {\n  demandOrderBy = 'InventoryItemId,ScheduledShipDate:asc';\n}\nelse if ( advParams.CrossDockDueDateSort == 'D' ) {\n  demandOrderBy = 'InventoryItemId,ScheduledShipDate:desc';\n}\n\n// Create sub query for demand\nif ( advParams.CrossDockIncludeBackordersFlag )\n  returnObj.demandSubQuery = `&orderBy=${demandOrderBy}&q=OrganizationId=${orgParams.OrganizationId} and OrderTypeCode in ('TRANSFER_ORDER','SALES_ORDER') AND ((LineStatusCode ='R' AND ScheduledShipDate BETWEEN '${startDate}' AND '${returnObj.demandEndDate}') OR LineStatusCode='B')`;\nelse\n  returnObj.demandSubQuery = `&orderBy=${demandOrderBy}&q=OrganizationId=${orgParams.OrganizationId} and OrderTypeCode in ('TRANSFER_ORDER','SALES_ORDER') AND (LineStatusCode ='R' AND ScheduledShipDate BETWEEN '${startDate}' AND '${returnObj.demandEndDate}')`;\n\nreturn returnObj;"
                          },
                          "outcomes": {
                            "success": "1773689455890"
                          },
                          "code": "INITIALIZE_ORG_PARAMS",
                          "id": "1773696590048",
                          "inputs": [],
                          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                          "type": "CODE"
