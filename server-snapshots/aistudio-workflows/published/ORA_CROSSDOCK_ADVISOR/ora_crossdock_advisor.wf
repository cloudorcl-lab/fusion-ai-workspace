          "metadata": {
            "name": "Format Variables",
            "returnType": "object",
            "sourceCode": "function formatValue(value) {\n  let formattedValue;\n  \n  if ( value ) {\n    formattedValue = String(value);\n    formattedValue = formattedValue.replace(/[\\[\\]{} '\"\"]/g, \"\");\n    formattedValue = formattedValue.split(\",\").map(v => `'${v.trim()}'`).join(\",\"); \n  }\n  return formattedValue;\n}\n\nlet returnObj = {};\nreturnObj.OrgList = formatValue($context.$variables.vOrgList);\nreturnObj.ItemList = formatValue($context.$variables.vItemList);\nreturnObj.ReceiptList = formatValue($context.$variables.vReceiptList);\n\n//deletePutAwaySuggestions only support single item and receipt.\nreturnObj.ItemNumber = !returnObj.ItemList?.includes(\",\") ? returnObj.ItemList?.replace(/[']/g, \"\") : \"\";\nreturnObj.ReceiptNumber = !returnObj.ReceiptList?.includes(\",\") ? returnObj.ReceiptList?.replace(/[']/g, \"\") : \"\";\n\nreturn returnObj;"
          },
          "outcomes": {
            "success": "1775860827410"
          },
          "code": "FORMAT_VARIABLES",
          "id": "1775060870058",
          "inputs": [],
