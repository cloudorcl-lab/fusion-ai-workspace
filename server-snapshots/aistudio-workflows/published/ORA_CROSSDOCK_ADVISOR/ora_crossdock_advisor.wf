                              "value": "{{$context.$nodes.FOR_EACH_ELIGIBLE_ORGANIZATION.INITIALIZE_ORG_PARAMS.$output.result.demandSubQuery + ' AND InventoryItemId in (' + $context.$nodes.ELIGIBLE_ORG_BATCHES.FOR_EACH_ELIGIBLE_ORGANIZATION.CREATE_RECEIVED_SUPPLY_ITEM_IDS.$output.result+ ')'}}"
                            }
