                        {
                          "metadata": {
                            "errorNodeId": "1773960580882",
                            "name": "Consolidate Expected Demand",
                            "returnType": "object",
                            "sourceCode": "function consolidateDemand( demand ) {\n  const map = new Map();\n\n  for ( const line of demand ) {\n    const id = line.SourceOrderLineId;\n\n    if ( !map.has(id) ) \n      map.set(id, line);\n    else\n      map.get(id).RequestedQuantity = Number(map.get(id).RequestedQuantity) + Number(line.RequestedQuantity);\n  }\n  return Array.from(map.values());\n}\n\nfunction JSONToMap( json, keyList ) {\n  const returnMap = new Map();\n\n  for (const obj of json) {\n    const keyParts = keyList.map(attribueName => { return obj[attribueName] });\n    const key = keyParts.join('|');\n\n    if (!returnMap.has(key)) {\n      returnMap.set(key, []);\n    }\n    returnMap.get(key).push(obj);\n  }\n  \n  return returnMap;\n}\n\nconst supplies = $context.$nodes.FOR_EACH_ELIGIBLE_ORGANIZATION.GET_EXPECTED_SUPPLY.$output.items;\nconst demands = $context.$nodes.FOR_EACH_ELIGIBLE_ORGANIZATION.GET_EXPECTED_DEMAND.$output.items;\nconst isProjectEnabled = $context.$nodes.FOR_EACH_ELIGIBLE_ORGANIZATION.$currentItem.ProjectReferenceEnabled == 1;\n\nif ( !demands || demands.length === 0 ) {\n  throw 'No eligible demand for expected supply found.';  \n}\n\nconst consolidatedDemand = consolidateDemand(demands);\nconst supplyMap = JSONToMap(supplies, isProjectEnabled ? ['ItemId', 'ProjectId', 'TaskId'] : ['ItemId']);\nconst demandMap = JSONToMap(consolidatedDemand, isProjectEnabled ? ['InventoryItemId', 'ProjectCostingProjectId', 'ProjectCostingTaskId'] : ['InventoryItemId']);\n\nlet groupedData = [];\n\nfor (const key of supplyMap.keys() ) {\n  if ( demandMap.has(key) ) {\n    groupedData .push({ Supply : supplyMap.get(key), Demand : demandMap.get(key) });\n  }\n}\n\nreturn { consolidatedDemand  : consolidatedDemand, groupedData : groupedData };"
                          },
                          "outcomes": {
                            "success": "1776723604745"
                          },
                          "code": "CONSOLIDATE_EXPECTED_DEMAND",
                          "id": "1773861402854",
                          "inputs": [],
                          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                          "type": "CODE"
                        },
                        {
                          "metadata": {
                            "errorNodeId": "1773960580882",
                            "name": "Create Expected Suggestion Batch",
                            "returnType": "object",
                            "sourceCode": "function JSONToMap( json, keyList ) {\n  const returnMap = new Map();\n  let key;\n\n  for (const obj of json) {\n    const keyParts = keyList.map(attribueName => { return obj[attribueName] });\n\n    key = keyParts.join('');\n    returnMap.set(key, obj);\n  }\n\n  return returnMap;\n}\n\nfunction csvToJSON ( csv ) {\n  console.log(\"csv=\"+csv)\n  if ( !csv )\n    return null;\n\n  const rows = csv.trim().split('\\n');\n  const headers = rows.shift().split(',');\n\n  var json = rows.map((row) => {\n    const values = row.split(',');\n\n    return headers.reduce((obj, header, index) => {\n        obj[header.trim()] = values[index].trim();\n        return obj;\n    }, {});\n  });\n\n  return json;\n}\n\nfunction csvArrayToJSON ( csvArray ) {  \n  let returnJSON = [];\n   \n  csvArray.forEach(row => {\n    const suggstionsJSON = csvToJSON(row);\n\n    if ( suggstionsJSON )\n      returnJSON = returnJSON.concat(suggstionsJSON);\n  });\n\n  return returnJSON;\n}\n\nconst suggestions = csvArrayToJSON($context.$nodes.ELIGIBLE_ORG_BATCHES.FOR_EACH_ELIGIBLE_ORGANIZATION.EXPECTED_SUPPLY_GROUPING_LOOP.$output);\n\nif ( !suggestions || suggestions.length === 0 ) {\n  throw 'No suggestions made for expected supply.';  \n}\n\nconst org = $context.$nodes.FOR_EACH_ELIGIBLE_ORGANIZATION.$currentItem;\nconst supplyMap = JSONToMap($context.$nodes.FOR_EACH_ELIGIBLE_ORGANIZATION.GET_EXPECTED_SUPPLY.$output.items, ['SourceDocumentCode', 'DocumentLineId']);\nconst demandMap = JSONToMap($context.$nodes.FOR_EACH_ELIGIBLE_ORGANIZATION.CONSOLIDATE_EXPECTED_DEMAND.$output.result.consolidatedDemand, ['SourceOrderLineId']);\n\nlet suggestionOutput = \"Item,Quantity,UOM,SupplyType,SupplyOrder,SupplyLine,DemandType,DemandOrder,DemandLine\";\nlet parts = [];\n\nsuggestions.forEach((row, index) => {\n  const supplyRow = supplyMap.get(row.SourceDocumentCode + row.DocumentLineId);\n  const demandRow = demandMap.get(row.SourceOrderLineId);\n\n  if ( supplyRow && demandRow && \n    Number(supplyRow.PrimaryQuantityAvailable) >= Number(demandRow.RequestedQuantity) && supplyRow.ItemId == demandRow.InventoryItemId &&\n    new Date(supplyRow.DueDate) <= new Date(demandRow.ScheduledShipDate) &&\n    ( !org.ProjectReferenceEnabled == 1 || (supplyRow.ProjectId == demandRow.ProjectCostingProjectId && supplyRow.TaskId == demandRow.ProjectCostingTaskId))    \n  ) {\n    const payload = {};\n\n    payload.SuggestionCode = 'AI_AGENT_INBOUND_ADVISOR';\n    payload.SuggestionTypeCode = 'CROSSDOCK';\n    payload.ParentTransactionId = supplyRow.ParentTransactionId ? supplyRow.ParentTransactionId : null;\n    payload.OrganizationId = org.OrganizationId;\n    payload.ItemId = supplyRow.ItemId;\n    payload.POHeaderId = supplyRow.POHeaderId ? supplyRow.POHeaderId: null;\n    payload.POLineId = supplyRow.POLineId ? supplyRow.POLineId : null;\n    payload.ShipmentHeaderId = supplyRow.ShipmentHeaderId ? supplyRow.ShipmentHeaderId : null;\n    payload.ShipmentLineId = supplyRow.ShipmentLineId ? supplyRow.ShipmentLineId : null;\n    payload.POLineLocationId = supplyRow.POLineLocationId ? supplyRow.POLineLocationId : null;\n    payload.TransferOrderHeaderId = supplyRow.TransferOrderHeaderId ? supplyRow.TransferOrderHeaderId : null;\n    payload.TransferOrderLineId = supplyRow.TransferOrderLineId ? supplyRow.TransferOrderLineId : null;\n    payload.CrossDockOrderTypeCode = demandRow.OrderTypeCode;\n    payload.CrossDockOrderNumber = demandRow.Order;\n    payload.CrossDockOrderLineNumber = demandRow.OrderLine;\n    payload.CrossDockQuantity = demandRow.RequestedQuantity;\n    payload.CrossDockUOMCode = supplyRow.PrimaryUOMCode;\n    payload.CrossDockSourceLineId = demandRow.SourceOrderLineId;\n\n    parts.push({\n      id: index + 1,\n      path: '/receivingPutAwaySuggestions',\n      operation: 'create',\n      payload,\n    });\n\n    supplyRow.PrimaryQuantityAvailable = Number(supplyRow.PrimaryQuantityAvailable) - Number(demandRow.RequestedQuantity);\n    demandMap.delete(demandRow.SourceOrderLineId);\n    suggestionOutput += `\\n${supplyRow.ItemNumber},${demandRow.RequestedQuantity},${supplyRow.DocumentType},${supplyRow.DocumentNumber},${supplyRow.DocumentLineNumber},${demandRow.OrderType},${demandRow.Order},${demandRow.OrderLine}`;\n  }\n});\n\nif ( !parts || parts.length === 0 ) {\n  throw 'No valid suggestions made for expected supply.';  \n}\n\nreturn { payload : { parts : parts }, suggestionOutput : suggestionOutput };"
                          },
                          "outcomes": {
                            "success": "1773257995025"
                          },
