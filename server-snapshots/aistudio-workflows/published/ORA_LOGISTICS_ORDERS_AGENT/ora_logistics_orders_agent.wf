          "code": "GENERATE_SUMMARY",
          "id": "1768149154459",
          "inputs": [
            {
              "id": "1768149154460_1",
              "name": "prompt",
              "type": "string",
              "value": "Generate a summary for the order data with the following conditions:\n\nTitle\n- Orders At Risk\n- Use h3 tag\n\nScope\nProvide a 3–5 line summary of orders due to ship today that are at risk, counting only distinct order numbers.\n\nRisk Criteria\nIdentify risk when the WMS Order Status is Created, Allocated, or Partly Allocated; or when the OTM Status contains PLANNING_NEW or PLANNING - FAILED.\n\nContext to Reference\nUse both WMS Order Status and OTM Status to describe the current stage and risk.\n\nFormatting\nAlways use bullet points. Avoid using emphasis tags. For statuses, use Plain English instead of exact values.\n\nInput Data\n{{$context.$nodes.REDUCE_OTM_DATA_FOR_SUMMARY.$output.result}}"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Get Minified Order Release Data",
            "returnType": "array",
            "sourceCode": "const data = $context.$nodes.CONSOLIDATE_OTM_DATA.$output.result || [];\nconst reducedData = [];\n\nconst options = {\nyear: 'numeric',\nmonth: 'long',\nday: 'numeric',\nhour: '2-digit',\nminute: '2-digit',\nsecond: '2-digit'\n};\n\nfor (let i = 0; i < data.length; i++) {\nconst item = data[i];\nconst r = {};\n\nr.orderReleaseGid = (item && (item.orderReleaseGid || item.orderReleaseXid)) || null;\n\nlet planningStatus = null;\nif (item && Array.isArray(item.statuses)) {\nfor (let j = 0; j < item.statuses.length; j++) {\nconst s = item.statuses[j];\nif (\ns &&\ntypeof s.statusValueGid === \"string\" &&\ns.statusValueGid.includes(\"PLANNING\") &&\n!s.statusValueGid.includes(\"PLANNING_SELL\")\n) {\nplanningStatus = s;\nbreak;\n}\n}\n}\n\nif (planningStatus && typeof planningStatus.statusValueGid === \"string\") {\nconst val = planningStatus.statusValueGid;\nr.statuses = val.indexOf(\".\") >= 0 ? val.split(\".\").pop() : val;\n} else {\nr.statuses = null;\n}\n\nlet earlyHuman = null;\nif (item && item.earlyPickupDate) {\nconst d = new Date(item.earlyPickupDate);\nif (!isNaN(d.getTime())) {\nearlyHuman = d.toLocaleString('en-US', options);\n}\n}\nr.earlyPickupDate = earlyHuman;\n\nlet lateHuman = null;\nif (item && item.latePickupDate) {\nconst d2 = new Date(item.latePickupDate);\nif (!isNaN(d2.getTime())) {\nlateHuman = d2.toLocaleString('en-US', options);\n}\n}\nr.latePickupDate = lateHuman;\n\nr.FAOrderNbr = (item && item.FAOrderNbr) || null;\n\nreducedData.push(r);\n}\n\nreturn reducedData;"
          },
          "outcomes": {
            "success": "1768200073078"
          },
          "code": "GET_MINIFIED_ORDER_RELEASE_DATA",
          "id": "1768200035535",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
