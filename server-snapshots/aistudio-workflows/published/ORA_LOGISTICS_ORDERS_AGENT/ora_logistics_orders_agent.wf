          "metadata": {
            "name": "Get SysDate",
            "returnType": "array",
            "sourceCode": "const now = new Date($context.$system.$currentDateTime);\nconst threeDaysMs = 7 * 24 * 60 * 60 * 1000;\n\nconst start = new Date(now.getTime() - threeDaysMs); // 3 days before\nconst end = new Date(now.getTime() + threeDaysMs); // 3 days after\n\nconst dateWindow = [start.toISOString(), end.toISOString()];\nreturn dateWindow;"
          },
          "outcomes": {
            "success": "1767880210456"
          },
          "code": "GET_SYSDATE",
          "id": "1771777979146",
          "inputs": [],
