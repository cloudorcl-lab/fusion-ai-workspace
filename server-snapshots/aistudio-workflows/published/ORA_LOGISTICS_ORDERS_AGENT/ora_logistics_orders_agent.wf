        },
        {
          "metadata": {
            "name": "extractWMSOrdersFromSalesOrders",
            "returnType": "string",
            "sourceCode": "const orderIdArray=[...new Set( $context.$nodes.GET_WMS_ORDER_INFO.$output.results.map(item => item[\"Order Nbr\"]))];\nconst csv = orderIdArray.join(',');\nreturn csv;"
          },
          "outcomes": {
