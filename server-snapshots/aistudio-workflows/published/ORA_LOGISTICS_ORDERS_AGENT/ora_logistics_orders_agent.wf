          },
          "code": "EXTRACTWMSORDERSFROMSALESORDERS",
          "id": "1768254613231",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Consolidate OTM WMS Data",
            "returnType": "array",
            "sourceCode": "const otmData = $context.$nodes.CONSOLIDATE_OTM_DATA.$output.result || [];\nconst wmsOrderData = $context.$nodes.GET_WMS_ORDER_INFO.$output.results || [];\nconst wmsAllocData = $context.$nodes.GETALLOCATIONSBYORDERS.$output.results || [];\n// Index WMS orders by erp_source_hdr_ref (string, trimmed)\nconst wmsByErpRef = new Map();\n(wmsOrderData || []).forEach(o => {\n  const key = String(o[\"erp_source_hdr_ref\"] ?? \"\").trim();\n  if (key) {\n    const arr = wmsByErpRef.get(key) || [];\n    arr.push(o);\n    wmsByErpRef.set(key, arr);\n  }\n});\nconst uiData = [];\n(otmData || []).forEach(item => {\n  const d = {};\n  d.otmOrderReleaseGid = item.orderReleaseGid || \"\";\n  d.otmOrderReleaseXid = item.orderReleaseXid || \"\";\n  d.sourceLocation = item.sourceLocation || {};\n  d.destLocation = item.destinationLocation || {};\n  d.earlyPickupDate = item.earlyPickupDate || \"\";\n  d.latePickupDate = item.latePickupDate || \"\";\n  d.FAOrderNbr = item.FAOrderNbr || \"\";\n  // Use FAOrderNbr as the OTM order number reference for WMS lookup\n  const otmOrderNumber = String(d.FAOrderNbr || \"\").trim() || null;\n  // Find WMS orders by erp_source_hdr_ref\n  const wmsCandidates = otmOrderNumber ? (wmsByErpRef.get(otmOrderNumber) || []) : [];\n  const wmsOrder = wmsCandidates.find(c => c[\"Order Nbr\"]) || wmsCandidates[0] || null;\n  d.wmsOrderNbr = wmsOrder ? (wmsOrder[\"Order Nbr\"] || \"\") : \"\";\n  // Build concise OTM status string\n  const statuses = Array.isArray(item.statuses) ? item.statuses : [];\n  const parts = [];\n  const seen = new Set();\n  for (let i = 0; i < statuses.length; i++) {\n    const val = String(statuses[i].statusValueGid || \"\");\n    const lastDot = val.lastIndexOf(\".\");\n    let shortVal = lastDot >= 0 ? val.substring(lastDot + 1) : val;\n\n    // Normalize specific OTM statuses\n    if (shortVal === \"PLANNED - FINAL\") shortVal = \"Planned - Final\";\n    else if (shortVal === \"PLANNING - NEW\") shortVal = \"Planned - New\";\n    else if (shortVal === \"PLANNED - FAILED\") shortVal = \"Planned - Failed\";\n\n    if (shortVal && !seen.has(shortVal)) {\n      seen.add(shortVal);\n      parts.push(shortVal);\n    }\n  }\n  const otmStatusStr = parts.join(\", \");\n  const wmsStatusStr = wmsOrder ? String(wmsOrder[\"WMS Order Status\"] || \"\").trim() : \"\";\n  d.Status = \"OTM: \" + (otmStatusStr || \"UNKNOWN\") + \"; WMS: \" + (wmsStatusStr || \"UNKNOWN\");\n  // Allocation/packing percentage\n  const allocData = (wmsOrder && wmsOrder[\"Order Nbr\"])\n    ? wmsAllocData.filter(a => a[\"order_dtl_id__order_id__order_nbr\"] === wmsOrder[\"Order Nbr\"])\n    : [];\n  let sumPacked = 0;\n  let sumAlloc = 0;\n  allocData.forEach(alloc => {\n    sumPacked += Number(alloc[\"packed_qty\"]) || 0;\n    sumAlloc += Number(alloc[\"alloc_qty\"]) || 0;\n  });\n  const packingPerc = sumAlloc > 0 ? (sumPacked / sumAlloc) * 100 : 0.0;\n  d.packingPerc = Number.isFinite(packingPerc) ? packingPerc : 0.0;\n  // Risk based on WMS status\n  if (wmsStatusStr === \"Created\" ) {\n    d.risk = \"High\";\n  } else if (\n    wmsStatusStr === \"Partly Allocated\" ||\n    wmsStatusStr === \"Allocated\" ||\n    wmsStatusStr === \"In Packing\" ||\n    wmsStatusStr === \"Packed\"\n  ) {\n    d.risk = \"Medium\";\n  } else if (wmsStatusStr === \"Loaded\" || wmsStatusStr === \"Shipped\") {\n    d.risk = \"Low\";\n  } else {\n    d.risk = \"unknown\";\n  }\n  d.WMSLoad = wmsOrder ? (wmsOrder[\"Externally Planned Load Nbr\"] || \"\") : \"\";\n  uiData.push(d);\n});\nreturn uiData;"
          },
          "outcomes": {
            "success": "1767880420851"
          },
          "code": "CONSOLIDATE_OTM_WMS_DATA",
          "id": "1768293453046",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Reduce OTM Data for Summary",
            "returnType": "array",
            "sourceCode": "const otmData = $context.$nodes.CONSOLIDATE_OTM_DATA.$output.result;\nconst wmsData = $context.$nodes.GET_WMS_ORDER_INFO.$output;\n\nconst wmsByErpRef = new Map();\nif (wmsData && Array.isArray(wmsData.results)) {\n  wmsData.results.forEach(w => {\n    const key = String(w[\"erp_source_hdr_ref\"] || \"\").trim();\n    if (!key) return;\n    if (!wmsByErpRef.has(key)) wmsByErpRef.set(key, []);\n    wmsByErpRef.get(key).push(w);\n  });\n}\n\nconst atRisk = [];\n\nif (otmData && Array.isArray(otmData)) {\n  otmData.forEach(item => {\n    const faOrderNbr = String(item[\"FAOrderNbr\"] || \"\").trim();\n    const orderReleaseXid = item[\"orderReleaseXid\"];\n    const statuses = Array.isArray(item[\"statuses\"]) ? item[\"statuses\"] : [];\n\n    // Collect OTM planning statuses\n    const otmPlanningStatuses = [];\n    statuses.forEach(st => {\n      const type = String(st.statusTypeGid || \"\").toLowerCase();\n      if (type.includes(\"planning\")) {\n        otmPlanningStatuses.push(st.statusValueGid);\n      }\n    });\n\n    // Determine OTM risk (contains PLANNING - NEW or PLANNING - FAILED)\n    let otmRisk = false;\n    for (let i = 0; i < otmPlanningStatuses.length; i++) {\n      const s = String(otmPlanningStatuses[i] || \"\").replace(/\\s+/g, \" \").toLowerCase();\n      if (s.includes(\"planning - new\") || s.includes(\"planning - failed\")) {\n        otmRisk = true;\n        break;\n      }\n    }\n\n    // Find matching WMS and determine WMS risk\n    const matchedWms = wmsByErpRef.get(faOrderNbr) || [];\n    let wmsRisk = false;\n    for (let i = 0; i < matchedWms.length; i++) {\n      const ws = String(matchedWms[i][\"WMS Order Status\"] || \"\").toLowerCase();\n      if (ws === \"created\" || ws === \"allocated\" || ws === \"partly allocated\") {\n        wmsRisk = true;\n        break;\n      }\n    }\n\n    if (otmRisk || wmsRisk) {\n      const reasons = [];\n      if (otmRisk) reasons.push(\"OTM status indicates PLANNING - NEW or PLANNING - FAILED\");\n      if (wmsRisk) reasons.push(\"WMS status is Created/Allocated/Partly Allocated\");\n\n      atRisk.push({\n        FAOrderNbr: faOrderNbr,\n        orderReleaseXid,\n        otmPlanningStatuses: otmPlanningStatuses.filter(Boolean),\n        wmsMatches: matchedWms.map(w => ({\n          orderId: w[\"Order ID\"],\n          orderNbr: w[\"Order Nbr\"],\n          salesOrderNbr: w[\"Sales Order Nbr\"],\n          wmsOrderStatus: w[\"WMS Order Status\"],\n          externallyPlannedLoadNbr: w[\"Externally Planned Load Nbr\"],\n          shipDate: w[\"Ship Date\"]\n        })),\n        atRiskReasons: reasons\n      });\n    }\n  });\n}\n\nreturn atRisk;"
          },
          "outcomes": {
            "success": "1768149154459"
          },
          "code": "REDUCE_OTM_DATA_FOR_SUMMARY",
          "id": "1768393540048",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
