        {
          "metadata": {
            "name": "Change Order Pickup Window",
            "returnType": "object",
            "sourceCode": "var payload = $context.$nodes.GET_ACTION_CONTEXT.$output.result;\n\nconst earlyPickupDate = payload.earlyPickupDate;\nconst latePickupDate = payload.latePickupDate;\nconst dEPD = new Date(new Date(earlyPickupDate).getTime() + 864e5);\nconst dLPD = new Date(new Date(latePickupDate).getTime() + 864e5);\n\nconst resEPD = dEPD.toISOString().split('T')[0] + earlyPickupDate.slice(10);\nconst resLPD = dLPD.toISOString().split('T')[0] + latePickupDate.slice(10);\n\nvar res = {};\nres.earlyPickupDate = resEPD;\nres.latePickupDate = resLPD;\n\nreturn res;"
          },
          "outcomes": {
            "success": "1768042846208"
          },
          "code": "CHANGE_ORDER_PICKUP_WINDOW",
          "id": "1768042699124",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
