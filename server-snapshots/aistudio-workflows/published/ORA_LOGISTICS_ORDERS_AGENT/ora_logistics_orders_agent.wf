        {
          "metadata": {
            "name": "Order For Wave",
            "returnType": "string",
            "sourceCode": "// Get data safely\nconst wmsData = $context?.$nodes?.GET_WMS_ORDER_INFO?.$output?.results;\nif (!Array.isArray(wmsData) || wmsData.length === 0) {\nreturn \"\";\n}\n\n// Define allowed statuses once\nconst allowedStatuses = new Set([\"Created\", \"Partly Allocated\"]);\n\nconst orderNbrSet = new Set();\n\nfor (const item of wmsData) {\nif (!item || typeof item !== \"object\") continue;\n\nconst status = item[\"WMS Order Status\"];\nif (!allowedStatuses.has(status)) continue;\n\nconst rawNbr = item[\"Order Nbr\"];\nconst nbr = typeof rawNbr === \"string\" ? rawNbr.trim() : rawNbr;\n\nif (nbr) orderNbrSet.add(nbr);\n}\n\nreturn Array.from(orderNbrSet).join(\",\");"
          },
          "outcomes": {
            "success": "1771572161933"
          },
          "code": "ORDER_FOR_WAVE",
          "id": "1771571749695",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Extract Wave Template Name",
            "returnType": "string",
            "sourceCode": "const rawInput = $context.$app.$OraAction;\nconst match = rawInput.match(/<oraFormSubmit\\s+id=[\"'][^\"']*[\"'][^>]*>(.*?)<\\/oraFormSubmit>/s);\nlet value = undefined;\nif (match) {\n  try {\n    const arr = JSON.parse(match[1]);\n    const item = Array.isArray(arr) ? arr.find(x => x && x.id === \"wave_template\") : undefined;\n    value = item ? item.value : undefined;\n  } catch (e) {\n    // Handle JSON parse errors or log if needed\n  }\n}\n\nreturn value;"
          },
          "outcomes": {
            "success": "1771572206014"
          },
