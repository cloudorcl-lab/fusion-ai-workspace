        {
          "metadata": {
            "name": "Consolidate Otm Data",
            "returnType": "array",
            "sourceCode": "const data = $context.$nodes.GET_OTM_ORDER_RELEASES.$output;\n\nconst resultArray = (data?.items ?? []).map((it) => {\n  // Line-level refnums (flatten across all lines under it.lines.items)\n  const lineRefnums =\n    (it?.lines?.items ?? [])\n      .flatMap((ln) => ln?.refnums?.items ?? [])\n      .filter(Boolean);\n\n  // Header-level refnums (fallback)\n  const headerRefnums = it?.refnums?.items ?? [];\n\n  // Prefer line-level refnums\n  const refnumsItems = (lineRefnums && lineRefnums.length > 0) ? lineRefnums : headerRefnums;\n\n  // FAOrderNbr from line-level ORDER NUMBER using orlRefnumValue\n  const faOrderNbrFromLines =\n    lineRefnums\n      ?.find((r) => (r?.orderReleaseRefnumQualGid ?? \"\").endsWith(\".ORDER NUMBER\"))\n      ?.orlRefnumValue ?? null;\n\n  return {\n    sourceLocation: {\n      locationName: it?.sourceLocation?.locationName ?? null,\n      city: it?.sourceLocation?.city ?? null,\n      countryCode3Gid: it?.sourceLocation?.countryCode3Gid ?? null,\n      timeZoneGid: it?.sourceLocation?.timeZoneGid ?? null,\n    },\n    destinationLocation: {\n      locationName: it?.destinationLocation?.locationName ?? null,\n      city: it?.destinationLocation?.city ?? null,\n      countryCode3Gid: it?.destinationLocation?.countryCode3Gid ?? null,\n      timeZoneGid: it?.destinationLocation?.timeZoneGid ?? null,\n    },\n    earlyPickupDate: it?.earlyPickupDate?.value ?? it?.earlyPickupDate ?? null,\n    latePickupDate: it?.latePickupDate?.value ?? it?.latePickupDate ?? null,\n\n    // Use orlRefnumValue from line-level ORDER NUMBER\n    FAOrderNbr: faOrderNbrFromLines,\n\n    // Expose refnums used (line-level preferred, otherwise header)\n    refnums: refnumsItems.map((r) => ({\n      orderReleaseRefnumQualGid: r?.orderReleaseRefnumQualGid ?? null,\n      // For line-level entries, value is orlRefnumValue; for header, it's orderReleaseRefnumValue\n      value: (r?.orlRefnumValue ?? r?.orderReleaseRefnumValue ?? null),\n      level: r?.orlRefnumValue != null ? \"LINE\" : \"HEADER\",\n    })),\n\n    totalWeight: {\n      unit: it?.totalWeight?.unit ?? null,\n      value: it?.totalWeight?.value ?? null,\n    },\n    totalVolume: {\n      unit: it?.totalVolume?.unit ?? null,\n      value: it?.totalVolume?.value ?? null,\n    },\n    statuses: (it?.statuses?.items ?? [])\n      .filter((s) => {\n        const t = s?.statusTypeGid ?? \"\";\n        return t.endsWith(\".PLANNING\") || t.endsWith(\".READY_TO_SHIP\");\n      })\n      .map((s) => ({\n        statusTypeGid: s?.statusTypeGid ?? null,\n        statusValueGid: s?.statusValueGid ?? null,\n      })),\n    orderReleaseXid: it?.orderReleaseXid ?? null,\n  };\n});\n\nreturn resultArray;"
          },
          "outcomes": {
            "success": "1767880269810"
          },
          "code": "CONSOLIDATE_OTM_DATA",
