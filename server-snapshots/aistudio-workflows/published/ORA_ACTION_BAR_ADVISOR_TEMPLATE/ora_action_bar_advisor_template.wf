{
  "workflowId": "100002355227013",
  "workflowCode": "ORA_ACTION_BAR_ADVISOR_TEMPLATE",
  "name": "Action Bar Advisor Template",
  "description": "This team of agents (ver.4.1.3) help users pick the best actions from Service Center Action Bar and offers in-app guidelines related to the user question.\nThe process includes extracting intent and key entities from user utterances, selecting the most relevant actions and  retrieving relevant document snippets from KM articles and Internal RAG documents (if any).",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"selectedActions\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"DisplayLabel\": {\"type\": \"string\"},\n          \"UserActionName\": {\"type\": \"string\"},\n          \"genericFieldUpdate\": {\"type\": \"boolean\"}\n        },\n        \"required\": [\n          \"DisplayLabel\",\n          \"UserActionName\"\n        ]\n      }\n    },\n    \"helpDocuments\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"title\": {\"type\": \"string\"},\n          \"url\": {\"type\": \"string\"},\n          \"snippet\": {\"type\": \"string\"}\n        },\n        \"required\": [\n          \"title\",\n          \"url\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"selectedActions\",\n    \"helpDocuments\"\n  ]\n}",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1761744388723"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "description": "End of data pipeline",
