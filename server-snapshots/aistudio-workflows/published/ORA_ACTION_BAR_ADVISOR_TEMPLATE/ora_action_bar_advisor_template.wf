            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Create Empty Answer",
            "returnType": "object",
            "sourceCode": "const answerJson = { \n\"selectedActions\": [\n ],  \n\"helpDocuments\":  [\n ]\n};\nreturn answerJson;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "CREATE_EMPTY_ANSWER",
          "id": "1768479065806",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Create Final Answer",
            "returnType": "object",
            "sourceCode": "const selectedActions = $context?.$nodes?.SMART_ACTION_SELECTION?.$output?.selectedActions || [];\nconst articleList = $context?.$nodes?.KM_SEARCH_RESP_PROCESSING?.$output?.result || [];\nconst helpDocuments = articleList.map(item => ({\n  title: item.title,\n  snippet: item.excerpt,\n  url: `fscmUI/redwood/service/ec/container/sr/view-article?answerId=${item.answerId}`,\n  source: \"KM\"\n}));\n\nconst ragResult = $context?.$nodes?.RAG_OUTPUT_PROCESSING?.$output?.result;\nif (ragResult) {\n  helpDocuments.push(ragResult);\n}\n\nconst answerJson = {\n  selectedActions,\n  helpDocuments\n};\n\nreturn answerJson;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "CREATE_FINAL_ANSWER",
          "id": "1768910024521",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Run in Parallel"
          },
          "outcomes": {
