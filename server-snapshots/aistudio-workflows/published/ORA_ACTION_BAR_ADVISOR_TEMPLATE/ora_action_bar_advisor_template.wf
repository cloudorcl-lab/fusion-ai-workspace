        {
          "metadata": {
            "name": "RAG output processing",
            "returnType": "object",
            "sourceCode": "const citations = $context.$nodes.SEARCH_INTERNAL_DOCUMENTS.$output?.citations || [];\nlet citationTitle = \"Public Service Center Documents\";\nif (citations[0]?.documentIdentificationCriteria?.documentTitle) {\n  citationTitle = citations[0].documentIdentificationCriteria.documentTitle;\n}\nconst snippetValue = $context.$nodes.SEARCH_INTERNAL_DOCUMENTS.$output?.value?.replace(/\"/g, \"'\").replace(/\\n/g, \" \") || \"\";\n\nconst answerJson = {\n  // Uncomment and adjust as needed:\n  // \"value\": $context.$nodes.SEARCH_INTERNAL_DOCUMENTS.$output.value.replace(/\"/g, \"'\"),\n  // \"citations\": citations.map(citation => ({\n  //   \"text\": citation.citedText.replace(/\"/g, \"'\"),\n  //   \"title\": citation.documentIdentificationCriteria.documentTitle\n  // })),\n  \"title\": citationTitle,\n  \"snippet\": snippetValue,\n  \"url\": \"\",\n  \"source\": \"RAG\"\n};\nreturn answerJson.snippet ? answerJson : null;"
          },
          "outcomes": {
            "success": "1768910024521"
          },
          "code": "RAG_OUTPUT_PROCESSING",
          "id": "1768910646815",
          "inputs": [],
