          ],
          "outputSpecification": "{\n    \"type\": \"object\",\n    \"properties\": {\n        \"items\": {\n            \"type\": \"array\",\n            \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n                    \"recordId\": {\n                        \"type\": \"string\"\n                    },\n                    \"versionId\": {\n                        \"type\": \"string\"\n                    },\n                    \"documentId\": {\n                        \"type\": \"string\"\n                    },\n                    \"title\": {\n                        \"type\": \"string\"\n                    },\n                    \"answerId\": {\n                        \"type\": \"integer\"\n                    },\n                    \"locale\": {\n                        \"type\": \"object\",\n                        \"properties\": {\n                            \"recordId\": {\n                                \"type\": \"string\"\n                            }\n                        }\n                    },\n                    \"excerpt\": {\n                        \"type\": \"string\"\n                    },\n                    \"score\": {\n                        \"type\": \"number\"\n                    },\n                    \"sourceType\": {\n                        \"type\": \"string\"\n                    },\n                    \"rank\": {\n                        \"type\": \"integer\"\n                    }\n                }\n            }\n        },\n        \"hasMore\": {\n            \"type\": \"boolean\"\n        },\n        \"limit\": {\n            \"type\": \"integer\"\n        },\n        \"offset\": {\n            \"type\": \"integer\"\n        },\n        \"searchTransactionId\": {\n            \"type\": \"string\"\n        },\n        \"count\": {\n            \"type\": \"integer\"\n        }\n    },\n    \"required\": [\n        \"items\",\n        \"hasMore\",\n        \"count\"\n    ]\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "KM Search response processing",
            "returnType": "array",
            "sourceCode": "let articleList = []\n\nif ((!$context.$nodes.KM_ARTICLE_SEARCH.$status || !$context.$nodes.KM_ARTICLE_SEARCH.$status.toLowerCase() == 'failure') && $context.$nodes.KM_ARTICLE_SEARCH.$output && $context.$nodes.KM_ARTICLE_SEARCH.$output.items) {\n   articleList = $context.$nodes.KM_ARTICLE_SEARCH.$output.items;\n   // removing the title from excerpt (this comes from KM search)\n   for (const article of articleList) {\n     if (article && article.title && article.excerpt) {\n       const idx = article.excerpt.indexOf(article.title);\n       if (idx >= 0) {\n         article.excerpt = article.excerpt.substring(idx + article.title.length).trim();\n       }\n       article.excerpt  = article.excerpt.replace(/<[^>]*>/g, '');\n     }\n  }\n}\n\nreturn articleList;"
          },
          "outcomes": {
            "success": "1768910024521"
          },
          "code": "KM_SEARCH_RESP_PROCESSING",
          "id": "1768910495964",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
