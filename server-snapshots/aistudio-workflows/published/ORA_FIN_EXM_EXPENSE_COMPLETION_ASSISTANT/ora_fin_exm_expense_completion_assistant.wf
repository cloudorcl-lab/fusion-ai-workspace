            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
        },
        {
          "metadata": {
            "errorNodeId": "1775149970860",
            "name": "createValueResolverPayload",
            "returnType": "object",
            "sourceCode": "const safeJsonParse = (raw, fallback) => {\n    try {\n        return typeof raw === \"string\" ? JSON.parse(raw) : raw;\n    } catch (err) {\n        return fallback;\n    }\n};\n\nconst isSimplifiedExpense =\n    String($context.$triggers?.REST?.$input?.isSimplifiedExpense ?? \"\")\n        .trim()\n        .toLowerCase() === \"true\";\n\n// ✅ FIX: handle both string and object safely\nconst decompositionNodeOutput = $context.$nodes?.EXPENSE_MESSAGE_DECOMPOSITION_AGENT?.$output?.output;\n\nlet parsedDecompositionRoot = {};\ntry {\n    parsedDecompositionRoot = JSON.parse(decompositionNodeOutput);\n} catch (e) {\n    parsedDecompositionRoot = {};\n}\n\n// ✅ FIX: result may already be object → don’t parse again blindly\nconst rawDecomposition = parsedDecompositionRoot?.result;\nconst decompositionParsed = safeJsonParse(rawDecomposition, {});\n\n// ✅ This will now work correctly\nconst DecomposedInstructionsArray = Array.isArray(decompositionParsed?.DecomposedInstructions)\n    ? decompositionParsed.DecomposedInstructions\n    : [];\n\nconst expenseDetails = $context.$nodes?.FETCHEXPENSEDETAILS?.$output ?? {};\nconst assignmentDetails = $context.$nodes?.GET_ASSIGNMENT_DETAILS?.$output ?? {};\nconst expenseError = $context.$nodes?.FETCH_EXPENSE_ERRORS?.$output ?? {};\n\nconst safeExpenseField = (fn, fallback = \"\") => {\n    try {\n        const value = fn();\n        return value === undefined || value === null ? fallback : value;\n    } catch (err) {\n        return fallback;\n    }\n};\n\nlet payload = {\n    userInput: $context.$triggers?.REST?.$input?.userMessage ?? \"\",\n    entities: [\n        { name: \"Projects\", possibleValues: [] },\n        { name: \"Accounts\", possibleValues: [] },\n        { name: \"Attendees\", possibleValues: [] },\n        { name: \"NonEmployeeAttendees\", possibleValues: [] },\n        { name: \"Customer\", possibleValues: [] }\n    ],\n    expenses: {\n        expenseId: $context.$triggers?.REST?.$input?.expenseId ?? \"\",\n        personId: safeExpenseField(() => expenseDetails.person.id),\n        expenseType: safeExpenseField(() => expenseDetails.expenseType.id),\n        receiptCurrencyCode: safeExpenseField(() => expenseDetails.receiptCurrency.currencyCode),\n        reimbursementCurrencyCode: safeExpenseField(() => expenseDetails.reimbursementCurrency.currencyCode),\n        expenseLocation: safeExpenseField(() => expenseDetails.expenseLocation.$id),\n        businessUnitId: safeExpenseField(() => expenseDetails.businessUnit.id),\n\n        // ✅ FIX: correct field\n        assignmentId: safeExpenseField(() => assignmentDetails?.result?.assignmentId),\n\n        expenseDate: safeExpenseField(() => expenseDetails.expenseDate),\n        partnerExpenseId: $context.$triggers.REST.$input.partnerExpenseId \n    }\n};\n\nconst normalizeToArray = (value) => {\n    if (Array.isArray(value)) return value;\n\n    if (typeof value === \"string\") {\n        return value\n            .replace(/^\\[|\\]$/g, \"\")\n            .split(\",\")\n            .map((v) => v.trim())\n            .filter(Boolean);\n    }\n\n    return [];\n};\n\nDecomposedInstructionsArray.forEach((inst) => {\n    if (inst?.type === \"needsResolution\" && inst?.value) {\n        const fields = normalizeToArray(inst.field);\n        const values = normalizeToArray(inst.value);\n\n        // Project + Task pairing\n        if (\n            fields.length === 2 &&\n            (\n                (fields[0] === \"Project\" && fields[1] === \"Task\") ||\n                (fields[0] === \"Task\" && fields[1] === \"Project\")\n            ) &&\n            values.length === 2\n        ) {\n            fields.forEach((field, idx) => {\n                if (field === \"Project\") {\n                    payload.entities[0].possibleValues.push({\n                        value: values[idx],\n                        entity: \"Project\"\n                    });\n                } else if (field === \"Task\") {\n                    payload.entities[0].possibleValues.push({\n                        value: values[idx],\n                        entity: \"Task\"\n                    });\n                }\n            });\n\n            return;\n        }\n\n        fields.forEach((field) => {\n            if (field === \"Project\" || field === \"Task\") {\n                const entityKey = field === \"Project\" ? \"Project\" : \"Task\";\n\n                values.forEach((value) => {\n                    payload.entities[0].possibleValues.push({\n                        value,\n                        entity: entityKey\n                    });\n                });\n            }\n\n            if (field === \"Company\" || field === \"Cost Center\") {\n                const entityKey = field === \"Company\" ? \"company\" : \"costCenter\";\n\n                values.forEach((value) => {\n                    payload.entities[1].possibleValues.push({\n                        value,\n                        entity: entityKey\n                    });\n                });\n            }\n\n            if (field === \"Attendees\") {\n                values.forEach((value) => {\n                    payload.entities[2].possibleValues.push({\n                        value,\n                        entity: \"\"\n                    });\n                });\n            }\n\n            if (field === \"NonEmployeeAttendees\") {\n                values.forEach((value) => {\n                    payload.entities[3].possibleValues.push({\n                        value,\n                        entity: \"\"\n                    });\n                });\n            }\n\n            if (field === \"AmbiguousAttendees\") {\n                values.forEach((value) => {\n                    payload.entities[2].possibleValues.push({\n                        value,\n                        entity: \"ambiguous\"\n                    });\n                });\n            }\n\n            // Customer is added for resolution only when simplified expense is true.\n            if (isSimplifiedExpense && (field === \"Customer\" || field === \"customer\")) {\n                values.forEach((value) => {\n                    if (String(value || \"\").trim().toLowerCase() !== \"none\") {\n                        payload.entities[4].possibleValues.push({\n                            entity: \"Customer\",\n                            value\n                        });\n                    }\n                });\n            }\n        });\n    }\n});\n\nif (\n    Array.isArray(payload.entities[0].possibleValues) &&\n    payload.entities[0].possibleValues.length === 0 &&\n    Array.isArray(expenseError?.items) &&\n    expenseError.items.some((item) => item?.errorStringCode === \"EXM_PROJECT_DETAILS_REQUIRED\") &&\n    !$context.$triggers?.REST?.$input?.isReplyFlow\n) {\n    payload.entities[0].possibleValues.push({\n        value: \"\",\n        entity: \"PROJECT_RECOMMENDATIONS_REQUIRED\"\n    });\n}\n\nconst targetEntityNames = [\"Projects\", \"Accounts\", \"Attendees\", \"NonEmployeeAttendees\", \"Customer\"];\n\nconst valueResolverRequired = payload.entities.some(\n    (entity) =>\n        targetEntityNames.includes(entity.name) &&\n        Array.isArray(entity.possibleValues) &&\n        entity.possibleValues.length > 0\n)\n    ? \"true\"\n    : \"false\";\n\nreturn { payload, valueResolverRequired };"
          },
          "outcomes": {
            "success": "1772877640760"
          },
          "code": "CREATEVALUERESOLVERPAYLOAD",
