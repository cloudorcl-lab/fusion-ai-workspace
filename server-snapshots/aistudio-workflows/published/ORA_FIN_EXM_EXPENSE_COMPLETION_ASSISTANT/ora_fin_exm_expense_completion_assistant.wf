        {
          "metadata": {
            "errorNodeId": "1775149970860",
            "name": "createPredictionsPayload",
            "returnType": "object",
            "sourceCode": "let RecommendationAgentOutput =\n  JSON.parse($context.$nodes.EXPENSE_RECOMMENDATION_ASSISTANT.$output.output)\n    .result.resolvedEntities || [];\n\nconst valueResolverOutput =\n  JSON.parse($context.$nodes.EXPENSE_VALUE_RESOLVER_ASSISTANT.$output.output || \"{}\");\n\nlet ResolvedInstructionsArray =\n  valueResolverOutput?.result?.ResolvedInstructions ||\n  valueResolverOutput?.ResolvedInstructions ||\n  [];\n\nlet raw = $context.$nodes.EXPENSE_MESSAGE_DECOMPOSITION_AGENT.$output;\nlet isSimplified = $context.$triggers.REST.$input.isSimplifiedExpense;\n\nif (typeof raw === \"string\") {\n  try {\n    raw = JSON.parse(raw);\n  } catch (e) {\n    raw = {};\n  }\n}\n\nlet output = raw.output;\n\nif (typeof output === \"string\") {\n  try {\n    output = JSON.parse(output);\n  } catch (e) {\n    output = {};\n  }\n}\n\nconst DecomposedInstructionsArray =\n  output?.result?.DecomposedInstructions || [];\n\nlet partnerExpensexpenseId = $context.$triggers.REST.$input.partnerExpenseId;\n\nlet predictionsPayload = {};\nlet itemsArray = [];\n\nlet personId = $context.$nodes.FETCHEXPENSEDETAILS.$output.person.id;\n\nlet partnerExpenseObject = {\n  id: partnerExpensexpenseId\n};\n\nconst isSimplifiedExpense =\n  String(isSimplified).trim().toLowerCase() === \"true\";\n\nconst isSupportedPredictionValue = value => {\n  return (\n    typeof value === \"string\" ||\n    typeof value === \"number\" ||\n    typeof value === \"boolean\" ||\n    (value && typeof value === \"object\" && !Array.isArray(value))\n  );\n};\n\nconst serializePredictionFieldValue = value => {\n  if (value && typeof value === \"object\") {\n    try {\n      return JSON.stringify(value);\n    } catch (e) {\n      return \"\";\n    }\n  }\n\n  return String(value);\n};\n\nconst normalizePredictionFieldName = field => {\n  let normalizedField = String(field || \"\").trim();\n\n  const FIELD_NORMALIZATION_MAP = {\n    project: \"Project\",\n    projects: \"Project\",\n    account: \"Account\",\n    accounts: \"Account\",\n    numberofattendees: \"numberOfAttendees\",\n    \"number of attendees\": \"numberOfAttendees\"\n  };\n\n  return FIELD_NORMALIZATION_MAP[normalizedField.toLowerCase()] || normalizedField;\n};\n\nconst isField = (field, expectedField) => {\n  return (\n    normalizePredictionFieldName(field).trim().toLowerCase() ===\n    normalizePredictionFieldName(expectedField).trim().toLowerCase()\n  );\n};\n\nconst MAX_DRIVER_VALUE_LENGTH = 1900;\nconst TRUNCATION_SUFFIX = \"... [truncated]\";\n\nconst truncateDriverValue = value => {\n  if (value === null || value === undefined) return \"\";\n\n  const text = typeof value === \"string\" ? value : String(value);\n\n  if (text.length <= MAX_DRIVER_VALUE_LENGTH) {\n    return text;\n  }\n\n  return (\n    text.substring(0, MAX_DRIVER_VALUE_LENGTH - TRUNCATION_SUFFIX.length) +\n    TRUNCATION_SUFFIX\n  );\n};\n\nconst normalizeDriverValues = item => {\n  [\n    \"driverValue1\",\n    \"driverValue2\",\n    \"driverValue3\",\n    \"driverValue4\",\n    \"driverValue5\"\n  ].forEach(field => {\n    item[field] = truncateDriverValue(item[field]);\n  });\n\n  return item;\n};\n\nconst pushPredictionItem = item => {\n  item.fieldValue = truncateDriverValue(\n    serializePredictionFieldValue(item.fieldValue)\n  );\n  itemsArray.push(normalizeDriverValues(item));\n};\n\nconst hasResolvedPredictionForField = fieldName => {\n  const RESOLVED_TYPE_CODES = [\n    \"ORA_EXACT_MATCH\",\n    \"ORA_RESOLVED_SUCCESSFULLY\",\n    \"ORA_RECOMMENDATION_RESOLVED\"\n  ];\n\n  return itemsArray.some(item => {\n    let itemFieldName = item?.fieldName;\n    let predictionTypeCode = String(item?.predictionTypeCode || \"\")\n      .trim()\n      .toUpperCase();\n\n    return (\n      isField(itemFieldName, fieldName) &&\n      RESOLVED_TYPE_CODES.includes(predictionTypeCode)\n    );\n  });\n};\n\nconst pushInstructionPrediction = instruction => {\n  if (!instruction || typeof instruction !== \"object\") return;\n\n  const { type, field, value, message, reasoning } = instruction;\n\n  if (typeof field !== \"string\" || !isSupportedPredictionValue(value)) return;\n  if (type === \"needsResolution\" || type === \"delegation\") return;\n\n  let itemPayload = {};\n\n  itemPayload[\"$operation\"] = \"CREATE\";\n  itemPayload[\"partnerExpense\"] = partnerExpenseObject;\n  itemPayload[\"sourceObjectCode\"] = \"ORA_PARTNER_EXPENSE\";\n  itemPayload[\"fieldName\"] = normalizePredictionFieldName(field);\n  itemPayload[\"fieldValue\"] = value;\n  itemPayload[\"predictionRank\"] = \"\";\n  itemPayload[\"driverName1\"] = \"ORA_INSTRUCTION\";\n  itemPayload[\"driverValue1\"] = message;\n  itemPayload[\"driverName2\"] = \"ORA_ENTITY_VALUE\";\n  itemPayload[\"driverValue2\"] = \"\";\n  itemPayload[\"driverName3\"] = \"ORA_AGENT_REASONING\";\n  itemPayload[\"driverValue3\"] = reasoning;\n  itemPayload[\"driverName4\"] = \"\";\n  itemPayload[\"driverValue4\"] = \"\";\n  itemPayload[\"driverName5\"] = \"\";\n  itemPayload[\"driverValue5\"] = \"\";\n  itemPayload[\"predictionSource\"] = \"ORA_COMPLETION_ASSISTANT\";\n  itemPayload[\"ruleCode\"] = \"ORA_LLM_EXTRACTED\";\n  itemPayload[\"person\"] = { id: personId };\n\n  if (type === \"resolved\") {\n    itemPayload[\"predictionTypeCode\"] = \"ORA_RESOLVED_SUCCESSFULLY\";\n    itemPayload[\"predictionDisplayRule\"] = \"ORA_NOTIFY_USER\";\n    pushPredictionItem(itemPayload);\n  }\n\n  if (type === \"rec_resolved\") {\n    itemPayload[\"predictionTypeCode\"] = \"ORA_RECOMMENDATION_RESOLVED\";\n    itemPayload[\"predictionDisplayRule\"] = \"ORA_NOTIFY_USER\";\n    pushPredictionItem(itemPayload);\n  }\n\n  if (type === \"notResolved\") {\n    itemPayload[\"predictionTypeCode\"] = \"ORA_NOT_RESOLVED\";\n    itemPayload[\"predictionDisplayRule\"] = \"ORA_NOTIFY_USER\";\n    pushPredictionItem(itemPayload);\n  }\n\n  if (type === \"irrelevant\") {\n    itemPayload[\"predictionTypeCode\"] = \"ORA_IRRELEVANT\";\n    itemPayload[\"predictionDisplayRule\"] = \"ORA_NOTIFY_USER\";\n    pushPredictionItem(itemPayload);\n  }\n\n  if (type === \"unsupported\") {\n    itemPayload[\"predictionTypeCode\"] = \"ORA_UNSUPPORTED\";\n    itemPayload[\"predictionDisplayRule\"] = \"ORA_NOTIFY_USER\";\n    pushPredictionItem(itemPayload);\n  }\n};\n\nRecommendationAgentOutput.forEach(resolvedEntity => {\n  let fieldName = resolvedEntity[\"name\"];\n\n  if (\n    Array.isArray(resolvedEntity.resolvedValues) &&\n    resolvedEntity.resolvedValues.length > 0\n  ) {\n    resolvedEntity.resolvedValues.forEach(resolvedValue => {\n      if (\n        resolvedValue &&\n        Array.isArray(resolvedValue.matches) &&\n        resolvedValue.matches.length > 0\n      ) {\n        resolvedValue.matches.forEach(match => {\n          if (match) {\n            let itemPayload = {};\n            let fieldValueString = match.fieldValue;\n\n            itemPayload[\"$operation\"] = \"CREATE\";\n            itemPayload[\"partnerExpense\"] = partnerExpenseObject;\n            itemPayload[\"fieldName\"] = normalizePredictionFieldName(fieldName);\n            itemPayload[\"sourceObjectCode\"] = \"ORA_PARTNER_EXPENSE\";\n            itemPayload[\"fieldValue\"] = fieldValueString;\n            itemPayload[\"predictionTypeCode\"] = match.predictionTypeCode;\n            itemPayload[\"predictionDisplayRule\"] = match.predictionDisplayRule;\n            itemPayload[\"predictionRank\"] = match.predictionRank;\n            itemPayload[\"predictionSource\"] = match.predictionSource;\n            itemPayload[\"ruleCode\"] = match.ruleCode;\n            itemPayload[\"driverName1\"] = match.driverName1;\n            itemPayload[\"driverValue1\"] = match.driverValue1;\n            itemPayload[\"driverName2\"] = match.driverName2;\n            itemPayload[\"driverValue2\"] = match.driverValue2;\n            itemPayload[\"driverName3\"] = match.driverName3;\n            itemPayload[\"driverValue3\"] = match.driverValue3;\n            itemPayload[\"driverName4\"] = match.driverName4;\n            itemPayload[\"driverValue4\"] = match.driverValue4;\n            itemPayload[\"driverName5\"] = match.driverName5;\n            itemPayload[\"driverValue5\"] = match.driverValue5;\n            itemPayload[\"person\"] = { id: personId };\n\n            pushPredictionItem(itemPayload);\n          }\n        });\n      }\n    });\n  }\n});\n\nDecomposedInstructionsArray.forEach(pushInstructionPrediction);\nResolvedInstructionsArray.forEach(pushInstructionPrediction);\n\nif (isSimplifiedExpense && !hasResolvedPredictionForField(\"numberOfAttendees\")) {\n  const RESOLVED_CUSTOMER_PREDICTION_TYPE_CODES = [\n    \"ORA_EXACT_MATCH\",\n    \"ORA_RESOLVED_SUCCESSFULLY\",\n    \"ORA_RECOMMENDATION_RESOLVED\"\n  ];\n\n  let customerPredictionItems = itemsArray.filter(item => {\n    let predictionTypeCode = String(item?.predictionTypeCode || \"\")\n      .trim()\n      .toUpperCase();\n\n    return (\n      (isField(item?.fieldName, \"Customer\") || isField(item?.fieldName, \"Customers\")) &&\n      RESOLVED_CUSTOMER_PREDICTION_TYPE_CODES.includes(predictionTypeCode)\n    );\n  });\n\n  let uniqueCustomerKeys = new Set();\n\n  customerPredictionItems.forEach(item => {\n    let fieldValue = item?.fieldValue || \"\";\n    let customerKey = \"\";\n\n    try {\n      let parsedFieldValue = JSON.parse(fieldValue);\n\n      customerKey = String(\n        parsedFieldValue?.id ||\n          parsedFieldValue?.name ||\n          parsedFieldValue?.PartyId ||\n          parsedFieldValue?.PartyName ||\n          fieldValue\n      ).trim();\n    } catch (e) {\n      customerKey = String(fieldValue).trim();\n    }\n\n    if (customerKey) {\n      uniqueCustomerKeys.add(customerKey);\n    }\n  });\n\n  let numberOfCustomers = uniqueCustomerKeys.size;\n\n  if (numberOfCustomers > 0) {\n    pushPredictionItem({\n      \"$operation\": \"CREATE\",\n      \"partnerExpense\": partnerExpenseObject,\n      \"sourceObjectCode\": \"ORA_PARTNER_EXPENSE\",\n      \"fieldName\": \"numberOfAttendees\",\n      \"fieldValue\": String(numberOfCustomers + 1),\n      \"predictionTypeCode\": \"ORA_RESOLVED_SUCCESSFULLY\",\n      \"predictionDisplayRule\": \"ORA_NOTIFY_USER\",\n      \"predictionRank\": \"\",\n      \"driverName1\": \"ORA_TRIGGER_INPUT\",\n      \"driverValue1\": \"isSimplifiedExpense\",\n      \"driverName2\": \"ORA_ENTITY_VALUE\",\n      \"driverValue2\": \"customer\",\n      \"driverName3\": \"ORA_AGENT_REASONING\",\n      \"driverValue3\": \"Derived number of attendees from unique resolved customer predictions for simplified expense\",\n      \"driverName4\": \"\",\n      \"driverValue4\": \"\",\n      \"driverName5\": \"\",\n      \"driverValue5\": \"\",\n      \"predictionSource\": \"ORA_COMPLETION_AGENT\",\n      \"ruleCode\": \"ORA_DERIVED_FROM_CUSTOMERS\",\n      \"person\": { id: personId }\n    });\n  }\n}\n\nif (isSimplifiedExpense) {\n  pushPredictionItem({\n    \"$operation\": \"CREATE\",\n    \"partnerExpense\": partnerExpenseObject,\n    \"sourceObjectCode\": \"ORA_PARTNER_EXPENSE\",\n    \"fieldName\": \"issimplifiedexpensetype\",\n    \"fieldValue\": \"true\",\n    \"predictionTypeCode\": \"ORA_EXACT_MATCH\",\n    \"predictionDisplayRule\": \"ORA_NOTIFY_USER\",\n    \"predictionRank\": \"\",\n    \"driverName1\": \"ORA_TRIGGER_INPUT\",\n    \"driverValue1\": \"isSimplifiedExpenseType\",\n    \"driverName2\": \"\",\n    \"driverValue2\": \"\",\n    \"driverName3\": \"\",\n    \"driverValue3\": \"\",\n    \"driverName4\": \"\",\n    \"driverValue4\": \"\",\n    \"driverName5\": \"\",\n    \"driverValue5\": \"\",\n    \"predictionSource\": \"ORA_COMPLETION_AGENT\",\n    \"ruleCode\": \"ORA_EXACT_MATCH\",\n    \"person\": { id: personId }\n  });\n}\n\nitemsArray = itemsArray.map(normalizeDriverValues);\n\npredictionsPayload[\"items\"] = itemsArray;\n\nreturn predictionsPayload;"
          },
          "outcomes": {
            "success": "1769153287319"
          },
          "code": "CREATEPREDICTIONSPAYLOAD",
          "id": "1766565407586",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_EXPENSES_SAVEEXPENSE",
            "errorNodeId": "1775149970860",
            "functionName": "facade",
            "name": "saveExpense"
          },
          "outcomes": {
            "success": "1776329856558"
          },
          "code": "SAVE_EXPENSE",
          "convergenceTargetId": "1765396371530",
          "id": "1765477320985",
          "inputs": [
            {
              "id": "1768302997506_1",
              "name": "expenseData",
              "type": "string"
            },
            {
              "id": "1768302997507_2",
              "name": "payload",
              "type": "string",
              "value": "{{$context.$nodes.ADD_SIMPLIFIED_BULK_PATCH_TO_FACADE_PAYLOAD.$output.result}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "errorNodeId": "1775149970860",
            "name": "createFacadePayload",
            "returnType": "object",
            "sourceCode": "let expenseData = {\n    id: $context.$triggers.REST.$input.expenseId.toString()\n};\nconst expenseTypeId = $context.$nodes.FETCHEXPENSEDETAILS && $context.$nodes.FETCHEXPENSEDETAILS.$output && $context.$nodes.FETCHEXPENSEDETAILS.$output.expenseType ? $context.$nodes.FETCHEXPENSEDETAILS.$output.expenseType.id : null;\n\nif (expenseTypeId !== null && expenseTypeId !== undefined && expenseTypeId !== \"\") {\n  expenseData.expenseType = expenseTypeId;\n}\nlet expenseAttendees = [];\nconst expenseDistributionsItems =\n    $context.$nodes.FETCHEXPENSEDETAILS.$output.expenseDistributions?.items || [];\n\n// This ensures there's always one object in expenseDistributions\nlet expenseDistributionId = expenseDistributionsItems[0]?.id;\nlet expenseDistribution = {\n  xContextSegmentFk: \"EXM_Expense_Report_Line\"\n};\n\nif (expenseDistributionId) {\n  expenseDistribution.id = expenseDistributionId;\n}\n\nlet payload = {\n  personId: $context.$nodes.FETCHEXPENSEDETAILS.$output.person.id,\n  expense: expenseData,\n  expenseDistributions: [expenseDistribution]\n};\n\nlet raw = $context.$nodes.EXPENSE_MESSAGE_DECOMPOSITION_AGENT.$output;\n\n// Step 0: ensure raw is object\nif (typeof raw === \"string\") {\n  try {\n    raw = JSON.parse(raw);\n  } catch (e) {\n    raw = {};\n  }\n}\n\n// Step 1: parse output\nlet output = raw.output;\n\nif (typeof output === \"string\") {\n  try {\n    output = JSON.parse(output);\n  } catch (e) {\n    output = {};\n  }\n}\n\n// Step 2: final extraction\nconst DecomposedInstructionsArray =\n  output?.result?.DecomposedInstructions || [];\nconst valueResolverOutput =\n  JSON.parse($context.$nodes.EXPENSE_VALUE_RESOLVER_ASSISTANT.$output.output || \"{}\");\n\nlet ResolvedInstructionsArray =\n  valueResolverOutput?.result?.ResolvedInstructions ||\n  valueResolverOutput?.ResolvedInstructions ||\n  [];\nDecomposedInstructionsArray.forEach((instruction) => {\n    const { type, field, value } = instruction;\n    if (type === \"resolved\" || type===\"rec_resolved\") {\n        if (field === \"Project\" || field === \"Task\") {\n            let projectObj;\n            if (typeof value === \"string\") {\n                projectObj = JSON.parse(value);\n            } else {\n                projectObj = value;\n            }\n            //payload.expenseDistributions[0][\"xProjectUId\"] = projectObj?.projectId;\n            //payload.expenseDistributions[0][\"xTaskUId\"] = projectObj?.taskId;\n            payload.expenseDistributions[0][\"xProjectUId\"] = projectObj?.projectId;\n            payload.expenseDistributions[0][\"xTaskUId\"] = projectObj?.taskId;\n            expenseData[field] = projectObj;\n        }\n        if (field === \"Company\" || field === \"Cost Center\" || field === \"Accounts\") {\n            const accountObj = typeof value === \"string\" ? JSON.parse(value) : value;\n            if (accountObj) {\n                if (accountObj?.companySegmentDisabled === true) {\n                    expenseData[\"costCenter\"] = accountObj?.costCenterId;\n                } else {\n                    if (accountObj?.companyId) expenseData[\"company\"] = accountObj.companyId;\n                    expenseData[\"costCenter\"] = accountObj?.costCenterId;\n                }\n            }\n        }\n        if (field === \"spendAuthorizationLine\") {\n            const spendAuthObj = typeof value === \"string\" ? JSON.parse(value) : value;\n            expenseData[\"spendAuthorizationLine\"] = spendAuthObj?.id;\n        }\n        if (typeof field === \"string\") {\n            if (field === \"expenseType\" && value && typeof value === \"object\") {\n                if (value.id !== undefined && value.id !== null && value.id !== \"\") {\n                    expenseData[field] = String(value.id);\n                }\n            } else if (typeof value === \"string\") {\n                expenseData[field] = value;\n            }\n        }\n    }\n});\n\nResolvedInstructionsArray.forEach((instruction) => {\n    const { type, field, value } = instruction;\n    if (type === \"resolved\") {\n        if (typeof field === \"string\") {\n            if (field === \"expenseType\" && value && typeof value === \"object\") {\n                if (value.id !== undefined && value.id !== null && value.id !== \"\") {\n                    expenseData[field] = String(value.id);\n                }\n            } else if (typeof value === \"string\") {\n                expenseData[field] = value;\n            }\n        }\n    }\n});\n\nconst rawOutput = $context?.$nodes?.EXPENSE_POLICY_ENFORCEMENT_ASSISTANT?.$output?.output;\nif (typeof rawOutput === \"string\" && rawOutput.trim() !== \"\") {\n    const parsed = JSON.parse(rawOutput);\n    expenseAttendees = parsed?.result?.expenseAttendees ?? [];\n}\n\n// Add attendees only if present\nif (Array.isArray(expenseAttendees) && expenseAttendees.length > 0) {\n    payload.expenseAttendees = expenseAttendees;\n}\n\nlet setByPath = (root, path, value) => {\n  if (!path || value === undefined || value === null) return;\n\n  const parts = path\n    .replace(/^\\$\\./, \"\")\n    .replace(/\\[(\\d+)\\]/g, \".$1\")\n    .split(\".\");\n\n  let obj = root;\n\n  while (parts.length > 1) {\n    let key = parts.shift();\n\n    // Detect array index\n    if (!isNaN(key)) {\n      key = Number(key);\n\n      if (!Array.isArray(obj)) obj = [];\n\n      if (!obj[key]) obj[key] = {};\n\n      obj = obj[key];\n    } else {\n      if (!obj[key]) {\n        // If next key is a number, create array\n        obj[key] = !isNaN(parts[0]) ? [] : {};\n      }\n\n      obj = obj[key];\n    }\n  }\n\n  const lastKey = parts[0];\n  obj[lastKey] = value;\n};\n\n\nconst schemaMap = {\n    company: \"$.expense.company\",\n    costCenter: \"$.expense.costCenter\",\n    projectId: \"$.expenseDistributions[0].xProjectUId\",\n    taskId: \"$.expenseDistributions[0].xTaskUId\"\n};\n\nconst entityHandlers = {\n    Projects(match, payload) {\n        const { projectId, taskId } = match?.fieldValue || {};\n        setByPath(payload, schemaMap.projectId, projectId);\n        setByPath(payload, schemaMap.taskId, taskId);\n    },\n    Accounts(match, payload) {\n        const { companyId, costCenterId, companySegmentDisabled } = match?.fieldValue || {};\n        if (companySegmentDisabled === true) {\n            setByPath(payload, schemaMap.costCenter, costCenterId);\n        } else {\n            if (companyId) setByPath(payload, schemaMap.company, companyId);\n            setByPath(payload, schemaMap.costCenter, costCenterId);\n        }\n    }\n};\n\nconst resolvedOutput = JSON.parse($context.$nodes.EXPENSE_RECOMMENDATION_ASSISTANT.$output.output).result;\n(resolvedOutput?.resolvedEntities || []).forEach(entity => {\n    const handler = entityHandlers[entity.name];\n    if (entity?.name === \"Spend Authorization Line\") {\n        (entity.resolvedValues || []).forEach(rv => {\n            if (rv.status === \"ORA_DEFAULT\") {\n                const topMatch = (rv.matches || []).find(m => m.predictionRank === \"1\");\n                expenseData[\"spendAuthorizationLine\"] = topMatch?.fieldValue?.id;\n            }\n        });\n    }\n    if (!handler) return;\n    (entity.resolvedValues || []).forEach(rv => {\n        if (rv.status !== \"ORA_EXACT_MATCH\") return;\n        const topMatch = (rv.matches || []).find(m => m.predictionRank === \"1\");\n        if (topMatch) handler(topMatch, payload);\n    });\n});\n\nreturn payload;"
          },
          "outcomes": {
