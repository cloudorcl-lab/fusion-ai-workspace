        {
          "metadata": {
            "name": "Add Simplified Bulk Patch to Facade Payload",
            "returnType": "object",
            "sourceCode": "let inputPayload = $context.$nodes.CREATEFACADEPAYLOAD?.$output?.result || {};\nlet allExpenseErrors = $context.$nodes.FETCH_EXPENSE_ERRORS?.$output?.items || [];\n\nlet getAllPredictionsOutput = $context.$nodes.GET_ALL_PREDICTIONS?.$output || {};\nlet predictionItems =\n  getAllPredictionsOutput?.response?.items ||\n  getAllPredictionsOutput?.items ||\n  [];\n\nif (typeof getAllPredictionsOutput?.response === \"string\") {\n  try {\n    predictionItems = JSON.parse(getAllPredictionsOutput.response)?.items || [];\n  } catch (e) {\n    predictionItems = [];\n  }\n}\n\nlet raw = $context.$nodes.EXPENSE_MESSAGE_DECOMPOSITION_AGENT.$output;\n\nif (typeof raw === \"string\") {\n  try {\n    raw = JSON.parse(raw);\n  } catch (e) {\n    raw = {};\n  }\n}\n\nlet output = raw.output;\n\nif (typeof output === \"string\") {\n  try {\n    output = JSON.parse(output);\n  } catch (e) {\n    output = {};\n  }\n}\n\nconst DecomposedInstructionsArray =\n  output?.result?.DecomposedInstructions || [];\n\nlet isSimplifiedExpense =\n  String($context.$triggers.REST?.$input?.isSimplifiedExpense || \"\")\n    .trim()\n    .toLowerCase() === \"true\";\n\nif (!isSimplifiedExpense) {\n  return inputPayload;\n}\n\nlet xContextSegmentFkValue =\n  $context.$nodes.FETCHEXPENSEDETAILS?.$output?.expenseType?.name || \"\";\n\nlet recommendationsAgentOutput = {};\n\ntry {\n  recommendationsAgentOutput = JSON.parse(\n    $context.$nodes.EXPENSE_RECOMMENDATION_ASSISTANT?.$output?.output || \"{}\"\n  ).result || {};\n} catch (e) {\n  recommendationsAgentOutput = {};\n}\n\nlet finalPayload = {\n  ...inputPayload,\n  isSimplified: true,\n  expense: {\n    ...(inputPayload?.expense || {})\n  }\n};\n\nconst RESOLVED_PREDICTION_TYPE_CODES = [\n  \"ORA_EXACT_MATCH\",\n  \"ORA_RESOLVED_SUCCESSFULLY\",\n  \"ORA_RECOMMENDATION_RESOLVED\"\n];\n\nconst normalizePredictionFieldName = value =>\n  String(value || \"\")\n    .trim()\n    .toLowerCase()\n    .replace(/[\\s_-]+/g, \"\");\n\nconst isResolvedPrediction = prediction => {\n  let predictionTypeCode = String(prediction?.predictionTypeCode || \"\")\n    .trim()\n    .toUpperCase();\n\n  return RESOLVED_PREDICTION_TYPE_CODES.includes(predictionTypeCode);\n};\n\nconst parsePredictionFieldValue = value => {\n  if (typeof value !== \"string\") return value;\n\n  try {\n    return JSON.parse(value);\n  } catch (e) {\n    return value;\n  }\n};\n\nconst hasMissingNumberOfAttendeesError = expenseErrors =>\n  (Array.isArray(expenseErrors) ? expenseErrors : []).some(error => {\n    if (\n      error?.userActionRequiredFlag !== true ||\n      error?.warningFlag === true ||\n      error?.objectName === \"NA\" ||\n      String(error?.errorStringCode || \"\").trim() !== \"EXM_REST_REQ_MISSING\"\n    ) {\n      return false;\n    }\n\n    const errorFieldName = error?.attributeName ?? error?.stringToken1Value;\n    return normalizePredictionFieldName(errorFieldName) === \"numberofattendees\";\n  });\n\nlet numberOfAttendeesPrediction = predictionItems.find(\n  prediction =>\n    normalizePredictionFieldName(prediction?.fieldName) === \"numberofattendees\" &&\n    isResolvedPrediction(prediction) &&\n    String(prediction?.fieldValue ?? \"\").trim() !== \"\"\n);\n\nlet customerPredictions = predictionItems.filter(prediction => {\n  let fieldName = normalizePredictionFieldName(prediction?.fieldName);\n\n  return (\n    [\"customer\", \"customers\"].includes(fieldName) &&\n    isResolvedPrediction(prediction)\n  );\n});\n\nconst canUpdateNumberOfAttendees =\n  Boolean(numberOfAttendeesPrediction) &&\n  (customerPredictions.length > 0 ||\n    !hasMissingNumberOfAttendeesError(allExpenseErrors));\n\nif (canUpdateNumberOfAttendees) {\n  finalPayload.expense.numberOfAttendees = String(\n    numberOfAttendeesPrediction.fieldValue\n  ).trim();\n} else {\n  delete finalPayload.expense.numberOfAttendees;\n}\n\nlet expenseAttendees = [];\nlet firstMatchedAttendeeType = \"\";\nlet seenCustomerKeys = new Set();\n\nconst normalizeToArray = value => {\n  if (!value) return [];\n  return Array.isArray(value) ? value : [value];\n};\n\nconst parseCustomerValue = value => {\n  let parsedValue = parsePredictionFieldValue(value);\n\n  if (typeof parsedValue === \"string\") {\n    try {\n      parsedValue = JSON.parse(parsedValue);\n    } catch (e) {\n      return null;\n    }\n  }\n\n  return parsedValue && typeof parsedValue === \"object\" ? parsedValue : null;\n};\n\nconst addCustomerAttendee = (value, fallbackLookupCode) => {\n  let customerValue = parseCustomerValue(value);\n  if (!customerValue) return;\n\n  let lookupCode =\n    customerValue?.attendeeTypeInformation?.lookupCode ||\n    fallbackLookupCode ||\n    \"\";\n\n  let employerName = customerValue?.name || \"\";\n  let nonEmployeeAttendeeId = customerValue?.id || \"\";\n\n  if (!employerName && !nonEmployeeAttendeeId) return;\n\n  let customerKey = nonEmployeeAttendeeId || employerName;\n  if (seenCustomerKeys.has(customerKey)) return;\n  seenCustomerKeys.add(customerKey);\n\n  if (!firstMatchedAttendeeType) {\n    firstMatchedAttendeeType = lookupCode;\n  }\n\n  expenseAttendees.push({\n    $operation: \"CREATE\",\n    attendeeTypeInformation: {\n      lookupType: \"EXM_ATTENDEE_TYPES\",\n      lookupCode: lookupCode\n    },\n    employerName: employerName,\n    nonEmployeeAttendeeInformation: {\n      $id: nonEmployeeAttendeeId\n    }\n  });\n};\n\nlet recResolvedCustomerInstructions = DecomposedInstructionsArray.filter(\n  instruction => {\n    let type = String(instruction?.type || \"\")\n      .trim()\n      .toLowerCase();\n\n    let field = String(instruction?.field || \"\")\n      .trim()\n      .toLowerCase();\n\n    return (\n      type === \"rec_resolved\" &&\n      [\"customer\", \"customers\"].includes(field)\n    );\n  }\n);\n\nfor (let instruction of recResolvedCustomerInstructions) {\n  for (let value of normalizeToArray(instruction?.value)) {\n    addCustomerAttendee(value);\n  }\n}\n\nif (expenseAttendees.length === 0) {\n  for (let prediction of customerPredictions) {\n    addCustomerAttendee(\n      prediction?.fieldValue,\n      prediction?.driverValue3\n    );\n  }\n}\n\nif (expenseAttendees.length === 0) {\n  let resolvedEntities = recommendationsAgentOutput?.resolvedEntities || [];\n\n  let customerEntity = resolvedEntities.find(\n    entity =>\n      [\"customer\", \"customers\"].includes(\n        String(entity?.name || \"\").trim().toLowerCase()\n      )\n  );\n\n  for (let resolvedValue of customerEntity?.resolvedValues || []) {\n    let exactOrResolvedMatches = (resolvedValue?.matches || []).filter(\n      match => {\n        let predictionTypeCode = String(match?.predictionTypeCode || \"\")\n          .trim()\n          .toUpperCase();\n\n        return RESOLVED_PREDICTION_TYPE_CODES.includes(predictionTypeCode);\n      }\n    );\n\n    for (let match of exactOrResolvedMatches) {\n      addCustomerAttendee(\n        match?.fieldValue || {},\n        match?.driverValue3\n      );\n    }\n  }\n}\n\nif (expenseAttendees.length > 0) {\n  finalPayload.expense.ora_flex_expense__info = {\n    xContextSegmentFk: xContextSegmentFkValue,\n    attendeeType: firstMatchedAttendeeType\n  };\n\n  finalPayload.expenseAttendees = expenseAttendees;\n}\n\nreturn finalPayload;\n"
          },
