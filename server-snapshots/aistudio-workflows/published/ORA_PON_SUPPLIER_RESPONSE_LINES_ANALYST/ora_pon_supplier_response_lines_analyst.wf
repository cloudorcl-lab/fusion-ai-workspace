                 \"LineAmount\",\n                    \"ActiveResponses\"\n                  ]\n                }\n              }\n            },\n            \"required\": [\n              \"items\"\n            ]\n          }\n        },\n        \"required\": [\n          \"ResponseNumber\",\n          \"AuctionHeaderId\",\n          \"NegotiationTitle\",\n          \"Negotiation\",\n          \"CloseDate\",\n          \"ResponseStatus\",\n          \"OverallRank\",\n          \"ResponseAmount\",\n          \"SavingsInAmount\",\n          \"SavingsInPercent\",\n          \"AwardStatus\",\n          \"Buyer\",\n          \"ResponseValidUntilDate\",\n          \"Supplier\",\n          \"SupplierId\",\n          \"SupplierContact\",\n          \"SupplierContactDisplayName\",\n          \"SupplierContactId\",\n          \"SupplierSite\",\n          \"SupplierSiteId\",\n          \"CreationDate\",\n          \"ResponseStatusCode\",\n          \"LinesWinning\",\n          \"LinesTrailing\",\n          \"ResponseDate\",\n          \"lines\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"items\"\n  ]\n}",
