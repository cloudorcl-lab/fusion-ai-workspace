          "code": "GENERATE_AWARD_PAYLOAD",
          "id": "1767818679184",
          "inputs": [
            {
              "id": "1767818679185_1",
              "name": "prompt",
              "type": "string",
              "value": "Your are an expert advisor and analizer that will determine the best award strategy per lines.\n\nThe negotiation information with lines details is available here: {{$context.$nodes.NEGOTIATION_DETAILS_FOR_AWARD.$output}}\nThe information about the negotiation responses submitted by supplier including lines details is available here: {{$context.$nodes.NEGOTIATION_RESPONSES_FOR_AWARD.$output}} \n\nUsing the previous information, analize it and determine the best award strategy per line. Don't provide any output about this.\n\nYour output must follow this JSON object and you need to add one item in \"awardSupplierResponseLines\" for each line:\n\n{\n  \"awardSupplierResponseLines\": [\n    {\n      \"LineId\": <LineId>,\n      \"NoteToAcceptedSuppliers\": null,\n      \"NoteToRejectedSuppliers\": null,\n      \"supplierResponseLines\": [\n        {\n          \"ResponseNumber\":<ResponseNumber of the response with the best line>,\n          \"ResponseLine\": <ResponseLine>,\n          \"AwardDecisionFlag\": true,\n          \"AwardInternalNote\": null,\n          \"AwardNoteToSupplier\": null,\n          \"AgreementQuantity\": null\n        }\n      ]\n    }\n  ]\n}"
            }
          ],
          "type": "LLM"
        },
