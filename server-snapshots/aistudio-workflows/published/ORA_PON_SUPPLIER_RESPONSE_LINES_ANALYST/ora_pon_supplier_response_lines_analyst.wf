          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"Generated schema for Root\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"AuctionHeaderId\": {\n      \"type\": \"number\"\n    },\n    \"NegotiationTitle\": {\n      \"type\": \"string\"\n    },\n    \"NegotiationType\": {\n      \"type\": \"string\"\n    },\n    \"Negotiation\": {\n      \"type\": \"string\"\n    },\n    \"NegotiationStatusCode\": {\n      \"type\": \"string\"\n    },\n    \"OpenDate\": {\n      \"type\": \"string\"\n    },\n    \"CloseDate\": {\n      \"type\": \"string\"\n    },\n    \"SuppliersCount\": {\n      \"type\": \"number\"\n    },\n    \"SupplierResponses\": {\n      \"type\": \"number\"\n    },\n    \"AwardStatus\": {\n      \"type\": \"string\"\n    },\n    \"NumberOfLines\": {\n      \"type\": \"number\"\n    },\n    \"lines\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n         \"AuctionHeaderId\": {\n\t\t\t\t\t\t\"type\": \"number\"\n\t\t\t\t\t  },\n\t\t\t\t\t  \"LineId\": {\n\t\t\t\t\t\t\"type\": \"number\"\n\t\t\t\t\t  },\n\t\t\t\t\t  \"Line\": {\n\t\t\t\t\t\t\"type\": \"string\"\n\t\t\t\t\t  },\n\t\t\t\t\t  \"LineDescription\": {\n\t\t\t\t\t\t\"type\": \"string\"\n\t\t\t\t\t  },\n\t\t\t\t\t  \"Quantity\": {\n\t\t\t\t\t\t\"type\": \"number\"\n\t\t\t\t\t  },\n\t\t\t\t\t  \"EstimatedQuantity\": {\n\t\t\t\t\t\t\"type\": \"number\"\n\t\t\t\t\t  },\n\t\t\t\t\t  \"CurrentPrice\": {\n\t\t\t\t\t\t\"type\": \"number\"\n\t\t\t\t\t  },\n\t\t\t\t\t  \"StartPrice\": {\n\t\t\t\t\t\t\"type\": \"number\"\n\t\t\t\t\t  },\n\t\t\t\t\t  \"TargetPrice\": {\n\t\t\t\t\t\t\"type\": \"number\"\n\t\t\t\t\t  }\n        },\n        \"required\": [\n          \"AuctionHeaderId\",\n                    \"LineId\",\n                    \"Line\",\n                    \"LineDescription\",\n                    \"Quantity\",\n                    \"EstimatedQuantity\",\n                    \"CurrentPrice\",\n                    \"StartPrice\",\n                    \"TargetPrice\"\n\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"AuctionHeaderId\",\n    \"NegotiationTitle\",\n    \"NegotiationType\",\n    \"Negotiation\",\n    \"NegotiationStatusCode\",\n    \"OpenDate\",\n    \"CloseDate\",\n    \"SuppliersCount\",\n    \"SupplierResponses\",\n    \"AwardStatus\",\n    \"NumberOfLines\",\n    \"lines\"\n  ]\n}",
          "type": "BO_FUNCTION"
        },
