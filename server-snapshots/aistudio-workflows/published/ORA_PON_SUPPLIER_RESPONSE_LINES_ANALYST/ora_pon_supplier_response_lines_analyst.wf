              "value": "{{$context.$variables.AuctionHeaderId}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n      \"AuctionHeaderId\": { \"type\": \"number\" },\n      \"Negotiation\":     { \"type\": \"number\" },\n      \"NegotiationTitle\": { \"type\": \"string\" },\n      \"NegotiationType\": { \"type\": \"string\" },\n      \"OpenDate\": { \"type\": \"string\" },\n      \"CloseDate\": { \"type\": \"string\" }\n  },\n  \"required\": [\n      \"AuctionHeaderId\",\n      \"Negotiation\",\n      \"NegotiationTitle\",\n      \"NegotiationType\",\n      \"OpenDate\",\n      \"CloseDate\"\n  ]\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Format Negotiation Subtitle",
            "returnType": "string",
            "sourceCode": "const subtitle= $context.$nodes.GET_SUPPLIER_NEGOTIATION_FOR_SUBTITLE.$output.NegotiationType+\" \"+ $context.$nodes.GET_SUPPLIER_NEGOTIATION_FOR_SUBTITLE.$output.Negotiation+\" - \"+$context.$nodes.GET_SUPPLIER_NEGOTIATION_FOR_SUBTITLE.$output.NegotiationTitle;\n\nreturn subtitle;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "FORMAT_NEGOTIATION_SUBTITLE",
          "id": "1764696505470",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_MULTIRECORD"
              ],
              "enableActions": true,
              "enableCommunications": false
            }
          },
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.75
              },
              "code": "ORA_MODEL_CONFIG_PREMIUM_OPEN_AI_GPT_4_1_MINI",
              "model": "OCI_GPT_5_MINI",
              "modelName": "GPT-5 mini",
              "provider": "CERT_PREMIUM"
            },
            "name": "Summarize Negotiation Responses"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "SUMMARIZE_NEGOTIATION_RESPONSES",
          "id": "1764699718620",
          "inputs": [
            {
              "id": "1764699718622_1",
              "name": "prompt",
              "type": "string",
              "value": "Your are an expert advisor and analizer that will determine the best award strategy per lines.\n\nThe negotiation information with lines details is available here:  {{$context.$nodes.GET_NEGOTIATION_LINES_DETAILS.$output}}\nThe information about the negotiation response submitted by supplier s (supplier bids)  including lines details is available here: {{$context.$nodes.GET_NEGOTIATION_RESPONSES.$output.items}}\n\n If there is no data available coming in the negotiations and responses, don't generate any widget and skip all the following logic and just provide as a widget title \"There are no submitted responses\", translate it using the language in {{$context.$variables.Language}}.\n\nUsing the previous information, analize it and provide the best award strategy per line based on the ResponsePrice. \nThe Widget Title must be \"Maximum Savings Award Recommendation\", translate it using the language in formating rules. Don't display widget description.\n\nDisplay a multiRecordWidget with the following columns (translate those using the language in formating rules):\n\n1) \"Line\"\n\n2) \"Line Description\"\n\n3) \"Response Price ({{$context.$variables.Currency}})\"\n\n4) \"Savings\"\n Logic to calculate Savings:\n -For each negotiation line you need to calculate the line amount, use Quantity attribute, if it is not available use EstimatedQuantity, if both are not available Quantity will be 1.\n -Then you need to use CurrentPrice, if it is not available the savings will be 0.\n -If CurrentPrice is available you need to multiply it by the Quantity and that will be your line amount. \n -Compare your previous calculated line amount with the response price in each line. Calculate the projected savings as a percentage.\n\n5) \"Recommended Supplier\"\n-You must use the attribute \"Supplier\" which is the supplier who submitted the response.\n\n\n#Formatting rules\n-For \"Savings\", use a badge, green badge for positive percentages and red badge if the percentage is negative. \n-You need to create a record for each line. \n-Must Generate the content in {{$context.$variables.Language}} language.\n -Show all monetary amounts in {{$context.$variables.Currency}} currency and format the currency using {{$context.$variables.NumberFormat}} formatting style (for example, symbol placement, decimal separators, etc.).\n -Format all dates using {{$context.$variables.DateFormat}} date format and if there is time you can use this {{$context.$variables.TimeFormat}} time format."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Run in Parallel"
          },
          "outcomes": {
            "0": "1764704078023",
