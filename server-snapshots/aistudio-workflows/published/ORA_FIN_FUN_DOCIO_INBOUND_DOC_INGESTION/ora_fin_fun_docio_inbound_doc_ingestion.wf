        {
          "metadata": {
            "name": "Prepare Processing Payload",
            "returnType": "object",
            "sourceCode": "// INPUT PAYLOAD VALIDATOR & PAYLOAD CREATOR\nconst raw = $context.$system.$inputMessage;\nlet input = null;\nlet result = null;\nlet parseError = false;\n// Parse input\ntry {\n  input = typeof raw === \"string\" ? JSON.parse(raw) : raw;\n} catch (e) {\n  parseError = true;\n  result = {\n    status: \"ERROR\",\n    error: {\n      stage: \"Input Validation\",\n      code: \"MALFORMED_INPUT\",\n      message: \"Input is not valid JSON.\"\n    }\n  };\n}\n// Validate input object\nif (!parseError) {\n  if (!input || typeof input !== \"object\") {\n    result = {\n      status: \"ERROR\",\n      error: {\n        stage: \"Input Validation\",\n        code: \"MISSING_REQUIRED_FIELDS\",\n        message: \"Input payload is missing or invalid.\"\n      }\n    };\n    parseError = true;\n  }\n}\n// Validate required fields\nif (!parseError) {\n  const hasBO =\n    input.businessObject !== undefined &&\n    String(input.businessObject).trim() !== \"\";\n  const hasProduct =\n    input.product !== undefined &&\n    String(input.product).trim() !== \"\";\n  const hasDocFileName =\n    input.documentFileName !== undefined &&\n    String(input.documentFileName).trim() !== \"\";\n  const hasBase64 =\n    input.documentInBase64 !== undefined &&\n    String(input.documentInBase64).trim() !== \"\";\n  const hasLink =\n    input.documentLink !== undefined &&\n    String(input.documentLink).trim() !== \"\";\n  const hasId =\n    input.documentId !== undefined &&\n    String(input.documentId).trim() !== \"\";\n  const hasDocSource = hasBase64 || hasLink || hasId;\n  if (!hasDocFileName || !hasDocSource) {\n    result = {\n      status: \"ERROR\",\n      error: {\n        stage: \"Input Validation\",\n        code: \"MISSING_REQUIRED_FIELDS\",\n        message:\n          \"Missing required fields: businessObject, product, documentFileName, and at least one of documentInBase64 or documentLink or documentId.\"\n      }\n    };\n  } else {\n    // Build payload conditionally\n    const payload = {\n      documentFileName: input.documentFileName,\n      documentInBase64: input.documentInBase64 || \"\",\n      direction: input.direction || \"ORA_INBOUND\",\n      // Set isIngestionRequired to value from input or default to true\n      ingestionRequired: input.hasOwnProperty(\"ingestionRequired\") ? input.ingestionRequired : true\n    };\n    if (hasBO) {\n      payload.businessObject = input.businessObject;\n    }\n    if (hasProduct) {\n      payload.product = input.product;\n    }\n    result = { payload };\n  }\n}\nresult;"
          },
          "outcomes": {
            "success": "1768289008617"
          },
