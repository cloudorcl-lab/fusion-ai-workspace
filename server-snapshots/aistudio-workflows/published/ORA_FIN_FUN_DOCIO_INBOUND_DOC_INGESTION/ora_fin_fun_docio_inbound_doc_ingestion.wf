          "metadata": {
            "name": "Validate Input Payload",
            "returnType": "object",
            "sourceCode": "const raw = $context.$system.$inputMessage;\nlet input = null;\nlet result = null;\nlet parseError = false;\n\n// Parse input\ntry {\n  input = typeof raw === \"string\" ? JSON.parse(raw) : raw;\n} catch (e) {\n  parseError = true;\n  result = {\n    status: \"ERROR\",\n    error: {\n      stage: \"Input Validation\",\n      code: \"MALFORMED_INPUT\",\n      message: \"Input is not valid JSON.\"\n    }\n  };\n}\n\n// Validate input is an object\nif (!parseError) {\n  if (!input || typeof input !== \"object\") {\n    parseError = true;\n    result = {\n      status: \"ERROR\",\n      error: {\n        stage: \"Input Validation\",\n        code: \"MISSING_REQUIRED_FIELDS\",\n        message: \"Input payload is missing or invalid.\"\n      }\n    };\n  }\n}\n\n// Validate required fields\nif (!parseError) {\n  const hasDocFileName = !!(input.documentFileName && String(input.documentFileName).trim());\n  const hasBase64 = !!(input.documentInBase64 && String(input.documentInBase64).trim());\n  const hasLink = !!(input.documentLink && String(input.documentLink).trim());\n  const hasId = !!(input.documentId && String(input.documentId).trim());\n  const hasDocSource = hasBase64 || hasLink || hasId;\n\n  if (!hasDocFileName || !hasDocSource) {\n    result = {\n      status: \"ERROR\",\n      error: {\n        stage: \"Input Validation\",\n        code: \"MISSING_REQUIRED_FIELDS\",\n        message:\n          \"Missing required fields: documentFileName and at least one of documentInBase64, documentLink, or documentId.\"\n      }\n    };\n  } else {\n    result = { status: \"SUCCESS\" };\n  }\n}\n\nresult;"
          },
          "outcomes": {
            "success": "1768379380786"
          },
          "code": "FIN_FUN_CODE_VALIDATE_INPUT_PAYLOAD",
          "id": "1768288873586",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
