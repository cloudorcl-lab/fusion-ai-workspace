        {
          "metadata": {
            "name": "Extract Unstructured Data",
            "returnType": "object",
            "sourceCode": "// Input variables from your context\nconst input = $context.$variables.unstructuredwfresponse;\nconst inputMessageRaw = $context.$variables.wfinput;\n\n// Parse wfinput, handling double-stringified scenarios\nlet inputMessage;\nif (typeof inputMessageRaw === \"string\") {\n  try {\n    const parsed = JSON.parse(inputMessageRaw);\n    inputMessage = (typeof parsed === \"string\") ? JSON.parse(parsed) : parsed;\n  } catch (e) {\n    inputMessage = null;\n  }\n} else {\n  inputMessage = inputMessageRaw;\n}\n\nlet noderesult;\nif (!input || !input.result) {\n  noderesult = {\n    status: \"ERROR\",\n    error: {\n      stage: \"Parse Result\",\n      code: \"INPUT_NOT_FOUND\",\n      message: \"unstructuredwfresponse or result is missing or invalid\"\n    }\n  };\n}\n// If result has error, return ONLY the error structure\nelse if (input.result.error) {\n  noderesult = {\n    status: \"ERROR\",\n    error: {\n      stage: input.result.error.stage || \"Unstructured Document Recognition\",\n      code: input.result.error.code || \"UNKNOWN_ERROR\",\n      message: input.result.error.message || \"Unknown error in unstructured document flow\"\n    }\n  };\n} else {\n  noderesult = {};\n  if (inputMessage && typeof inputMessage === \"object\") {\n    Object.keys(inputMessage).forEach(key => {\n      if (key !== \"content\" && key !== \"documentInBase64\") {\n        noderesult[key] = inputMessage[key];\n      }\n    });\n  }\n  noderesult.mappingId = input.result.mappingId || null;\n  noderesult.logicalDocumentId = input.result.logicalDocumentId || null;\n  noderesult.documentType = input.result.documentType || null;\n  noderesult.content = input.result.content || null;\n  noderesult.status = input.result.status || null;\n}\n\n// Return the clean result object or only the error if error is found\nreturn noderesult;"
          },
          "outcomes": {
            "success": "1768539643657"
          },
