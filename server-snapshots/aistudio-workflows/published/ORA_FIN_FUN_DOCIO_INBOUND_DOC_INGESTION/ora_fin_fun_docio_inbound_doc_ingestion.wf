          "inputs": [
            {
              "id": "1768475838046",
              "name": "ingestionborequest",
              "type": "object",
              "value": "{{$context.$nodes.FIN_FUN_CODE_EXTRACT_UNSTRUCTURED_DATA.$output.result}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Prepare Ingestion Payload Unstructured",
            "returnType": "object",
            "sourceCode": "// ===============================\n// MERGE inputMessage WITH ingestionborequest\n// ===============================\nvar input = $context.$variables.ingestionborequest;\nvar inputMessage = $context.$variables.wfinput;\nvar noderesult;\n\nif (!input) {\n  noderesult = {\n    status: \"ERROR\",\n    error: {\n      stage: \"Merge Result\",\n      code: \"INPUT_NOT_FOUND\",\n      message: \"transformationwfrequest is missing or invalid\"\n    }\n  };\n} else if (typeof input !== \"object\") {\n  noderesult = {\n    status: \"ERROR\",\n    error: {\n      stage: \"Merge Result\",\n      code: \"INVALID_INPUT\",\n      message: \"transformationwfrequest is not an object\"\n    }\n  };\n} else {\n  var payload = {};\n  \n  // Copy inputMessage fields EXCEPT content & documentInBase64\n  if (inputMessage && typeof inputMessage === \"object\") {\n    for (var key in inputMessage) {\n      if (\n        inputMessage.hasOwnProperty(key) &&\n        key !== \"content\" &&\n        key !== \"documentInBase64\"\n      ) {\n        payload[key] = inputMessage[key];\n      }\n    }\n  }\n  \n  // Copy ALL fields from input (transformationwfrequest) - overwrites duplicates\n  for (var resultKey in input) {\n    if (input.hasOwnProperty(resultKey)) {\n      payload[resultKey] = input[resultKey];\n    }\n  }\n  // Stringify content if it's an array or object (for downstream compatibility)\nif (\n  payload.content &&\n  (Array.isArray(payload.content) || typeof payload.content === \"object\")\n) {\n  payload.content = JSON.stringify(payload.content);\n}\n\n  noderesult = {\n    payload: payload\n  };\n}\n\n//noderesult;\n\nconst resultString = JSON.stringify(noderesult);\n// Then return the string\nresultString;"
          },
          "outcomes": {
            "success": "1768478427716"
          },
