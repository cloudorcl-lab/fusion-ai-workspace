        {
          "metadata": {
            "name": "Extract Ingestion Response Structured",
            "returnType": "object",
            "sourceCode": "// INGESTION RESULT EXTRACTOR WITH NODE FAILURE HANDLING\nconst node = $context.$nodes.FIN_FUN_BOF_INGEST_STRUCTURED_DOCUMENT;\nconst nodeStatus = node && typeof node.$status === \"string\" ? node.$status.trim().toUpperCase() : null;\nconst nodeOutput = node ? node.$output : null;\nlet result = null;\n\n// 1. NODE EXECUTION FAILURE\nif (nodeStatus === \"FAILURE\") {\n    const errorInfo = node.$error;\n    let errorMessage = \"Ingest Structured Document execution failed.\";\n    let errorCode = \"EXECUTION_ERROR\";\n    if (errorInfo && typeof errorInfo === \"object\") {\n        if (typeof errorInfo.$info === \"string\" && errorInfo.$info.trim()) {\n            errorMessage = errorInfo.$info;\n        } else if (typeof errorInfo.message === \"string\" && errorInfo.message.trim()) {\n            errorMessage = errorInfo.message;\n        } else if (typeof errorInfo.error === \"string\" && errorInfo.error.trim()) {\n            errorMessage = errorInfo.error;\n        }\n        if (errorInfo.code) {\n            errorCode = errorInfo.code;\n        }\n    }\n    result = {\n        status: \"ERROR\",\n        error: {\n            stage: \"Ingest Structured Document\",\n            code: errorCode,\n            message: errorMessage\n        }\n    };\n} \n// 2. CHECK INGESTION RESULT FOR SUCCESS\nelse if (nodeOutput && nodeOutput.status === \"SUCCESS\" && nodeOutput.content) {\n    result = nodeOutput;\n}\n// 3. CONTENT IS MISSING OR STATUS IS NOT SUCCESS\nelse {\n    result = {\n        status: \"ERROR\",\n        error: {\n            stage: \"Ingest Structured Document\",\n            code: \"INGESTION_FAILED\",\n            message: \"Ingestion failed or content is missing.\"\n        }\n    };\n}\n\nreturn result;"
          },
