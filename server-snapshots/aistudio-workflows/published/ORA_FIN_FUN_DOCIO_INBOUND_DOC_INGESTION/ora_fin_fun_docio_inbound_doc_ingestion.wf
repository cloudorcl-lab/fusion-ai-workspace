          "outcomes": {
            "success": "add_false_1768297195261"
          },
          "code": "FIN_FUN_CODE_VALIDATION_ERROR",
          "convergenceTargetId": "1768298010872",
          "id": "1768289032892",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Extract Structured Data",
            "returnType": "object",
            "sourceCode": "// ===============================\n// Parse and merge structuredwfresponse with wfinput\n// RETURN error object if error, otherwise stringified happy-path result\n// ===============================\n\nvar jsonString = $context.$variables.structuredwfresponse;\nvar inputMessageRaw = $context.$variables.wfinput;\nvar noderesult;\nvar isError = false; // Track error paths\n\n// Parse inputMessage if it's a string (might be double-stringified)\nvar inputMessage;\nif (typeof inputMessageRaw === \"string\") {\n    try {\n        var parsedMsg = JSON.parse(inputMessageRaw);\n        inputMessage = (typeof parsedMsg === \"string\") ? JSON.parse(parsedMsg) : parsedMsg;\n    } catch (e) {\n        inputMessage = null;\n    }\n} else {\n    inputMessage = inputMessageRaw;\n}\n\n// Main processing\nif (!jsonString) {\n    noderesult = {\n        status: \"ERROR\",\n        error: {\n            stage: \"Parse Result\",\n            code: \"INPUT_NOT_FOUND\",\n            message: \"structuredwfresponse is missing or invalid\"\n        }\n    };\n    isError = true;\n}\n\n// PRE-CLEAN the JSON string before parsing to remove HTML anchor tags\nvar cleanedJsonString = jsonString;\nif (!isError && typeof jsonString === \"string\") {\n    // Remove HTML anchor tags - handle both escaped and unescaped versions\n    // Use new RegExp() to avoid escaping issues\n    \n    // Pattern 1: <a href=\"...\" target=\"_blank\">text</a> (unescaped)\n    cleanedJsonString = cleanedJsonString.replace(/<a\\s+href=\"([^\"]+)\"[^>]*>[^<]*<\\/a>/g, '$1');\n    \n    // Pattern 2-4: Handle various escape levels iteratively\n    for (var preCleanIter = 0; preCleanIter < 10; preCleanIter++) {\n        var beforePreClean = cleanedJsonString;\n        \n        // Single backslash escape: <a href=\\\"...\\\" ...>text</a>\n        cleanedJsonString = cleanedJsonString.replace(new RegExp('<a\\\\s+[^>]*href=\\\\\\\\\"([^\\\\\\\\\"]+)\\\\\\\\\"[^>]*>([^<]*)</a>', 'g'), '$1');\n        \n        // Double backslash escape: <a href=\\\\\\\"...\\\\\\\" ...>text<\\/a>\n        cleanedJsonString = cleanedJsonString.replace(new RegExp('<a\\\\s+[^>]*href=\\\\\\\\\\\\\\\\\"([^\\\\\\\\\\\\\\\\\"]+)\\\\\\\\\\\\\\\\\"[^>]*>([^<]*)<\\\\\\\\/a>', 'g'), '$1');\n        \n        // Triple backslash escape\n        cleanedJsonString = cleanedJsonString.replace(new RegExp('<a\\\\s+[^>]*href=\\\\\\\\\\\\\\\\\\\\\\\\\"([^\\\\\\\\\\\\\\\\\\\\\\\\\"]+)\\\\\\\\\\\\\\\\\\\\\\\\\"[^>]*>([^<]*)<\\\\\\\\\\\\\\\\/a>', 'g'), '$1');\n        \n        if (beforePreClean === cleanedJsonString) {\n            break;\n        }\n    }\n}\n\n// Try to parse as proper JSON\nvar parsedJson = null;\nif (!isError) {\n    if (typeof cleanedJsonString === \"string\") {\n        try {\n            parsedJson = JSON.parse(cleanedJsonString);\n        } catch (e) {\n            noderesult = {\n                status: \"ERROR\",\n                error: {\n                    stage: \"Parse Result\",\n                    code: \"INVALID_JSON\",\n                    message: \"Failed to parse structuredwfresponse as JSON: \" + e.message\n                }\n            };\n            isError = true;\n        }\n    } else {\n        parsedJson = cleanedJsonString;\n    }\n}\n\n// Early error detection\nif (!isError && parsedJson && parsedJson.result && parsedJson.result.error) {\n    noderesult = {\n        status: \"ERROR\",\n        error: {\n            stage: parsedJson.result.error.stage || \"Structured Document Transformation\",\n            code: parsedJson.result.error.code || \"UNKNOWN_ERROR\",\n            message: parsedJson.result.error.message || \"Unknown error in structured document flow\"\n        }\n    };\n    isError = true;\n}\n\nif (!isError && parsedJson && parsedJson.error) {\n    noderesult = {\n        status: \"ERROR\",\n        error: {\n            stage: parsedJson.error.stage || \"Structured Document Transformation\",\n            code: parsedJson.error.code || \"UNKNOWN_ERROR\",\n            message: parsedJson.error.message || \"Unknown error in structured document flow\"\n        }\n    };\n    isError = true;\n}\n\n// ====================\n// HAPPY PATH: merge & clean as usual\n// ====================\nif (!isError) {\n    noderesult = {};\n\n    // Copy inputMessage fields EXCEPT content\n    if (inputMessage && typeof inputMessage === \"object\") {\n        for (var key in inputMessage) {\n            if (inputMessage.hasOwnProperty(key) && key !== \"content\") {\n                noderesult[key] = inputMessage[key];\n            }\n        }\n    }\n\n    // Parsed JSON path\n    if (parsedJson && parsedJson.result && typeof parsedJson.result === \"object\") {\n        noderesult.mappingId = parsedJson.result.mappingId || null;\n        noderesult.logicalDocumentId = parsedJson.result.logicalDocumentId || null;\n        noderesult.documentType = parsedJson.result.documentType || null;\n        noderesult.status = parsedJson.result.status || null;\n\n        // Get content and determine if it's JSON or XML\n        var contentValue = parsedJson.result.content || null;\n        \n        if (contentValue && typeof contentValue === \"string\") {\n            // Try to detect if content is a JSON string or XML string\n            var trimmedContent = contentValue.trim();\n            var isJsonContent = false;\n            \n            // Check if it looks like JSON (starts with { or [)\n            if (trimmedContent.startsWith('{') || trimmedContent.startsWith('[')) {\n                try {\n                    JSON.parse(contentValue);\n                    isJsonContent = true;\n                } catch (e) {\n                    isJsonContent = false;\n                }\n            }\n            \n            if (isJsonContent) {\n                // Content is JSON - keep it as-is (already cleaned in pre-clean phase)\n                noderesult.content = contentValue;\n            } else {\n                // Content is XML - apply XML-specific cleaning\n                var contentXml = contentValue;\n                \n                // Remove any remaining HTML anchor tags in xmlns attributes\n                contentXml = contentXml.replace(/(xmlns(?::[a-zA-Z0-9]+)?=\")[^\"]*<a[^>]*href=\"([^\"]+)\"[^>]*>[^<]*<\\/a>\"/g, '$1$2\"');\n                contentXml = contentXml.replace(new RegExp('(xmlns(?::[a-zA-Z0-9]+)?=\\\\\\\\\")<a[^>]*href=\\\\\\\\\"([^\\\\\\\\\"]+)\\\\\\\\\"[^>]*>[^<]*</a>\\\\\\\\\"', 'g'), '$1$2\"');\n\n                // Generic cleanup: remove ALL HTML tags from xmlns attribute values\n                for (var iter = 0; iter < 5; iter++) {\n                    var before = contentXml;\n                    contentXml = contentXml.replace(/(xmlns(?::[a-zA-Z0-9]+)?=\"[^\"]*)<[^>]+>([^\"]*\")/g, '$1$2');\n                    if (before === contentXml) {\n                        break;\n                    }\n                }\n\n                contentXml = contentXml.replace(/(xmlns(?::[a-zA-Z0-9]+)?=\")([^\"]*)[<>]+([^\"]*\")/g, '$1$2$3');\n                contentXml = contentXml.replace(/^\\uFEFF/, '').trim();\n\n                // Only trim leading non-XML content if it's actually XML\n                if (!contentXml.startsWith('<?xml') && !contentXml.startsWith('<')) {\n                    var xmlMatch = contentXml.match(/(<\\?xml[^>]*>)/);\n                    if (xmlMatch) {\n                        contentXml = contentXml.substring(contentXml.indexOf(xmlMatch[0]));\n                    } else {\n                        var tagMatch = contentXml.match(/(<[a-zA-Z][^>]*>)/);\n                        if (tagMatch) {\n                            contentXml = contentXml.substring(contentXml.indexOf(tagMatch[0]));\n                        }\n                    }\n                }\n\n                contentXml = contentXml.replace(/\\\\t/g, '\\t').replace(/\\\\n/g, '\\n').replace(/\\\\r/g, '\\r');\n                noderesult.content = contentXml;\n            }\n        } else {\n            noderesult.content = contentValue;\n        }\n\n    } else {\n        // Fallback: copy all fields directly\n        for (var jkey in parsedJson) {\n            if (parsedJson.hasOwnProperty(jkey)) {\n                noderesult[jkey] = parsedJson[jkey];\n            }\n        }\n    }\n}\n\n// ====================\n// FINAL RETURN\n// ====================\nreturn isError ? noderesult : JSON.stringify(noderesult);"
          },
          "outcomes": {
            "success": "1768539022160"
          },
          "code": "FIN_FUN_CODE_EXTRACT_STRUCTURED_DATA",
          "id": "1768310465277",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
