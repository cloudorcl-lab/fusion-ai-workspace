        {
          "metadata": {
            "errorNodeId": "1768297712880",
            "name": "Extract Document Type",
            "returnType": "object",
            "sourceCode": "const node = $context.$nodes.FIN_FUN_BOF_IDENTIFY_DOCUMENT_TYPE;\nconst nodeStatus = node && typeof node.$status === \"string\" ? node.$status.trim().toUpperCase() : null;\nconst nodeOutput = node ? node.$output : null;\nlet result = null;\n\n// 1. NODE EXECUTION FAILURE\nif (nodeStatus === \"FAILURE\") {\n    const errorInfo = node.$error;\n    let errorMessage = \"Document Type Identification execution failed.\";\n    let errorCode = \"EXECUTION_ERROR\";\n    if (errorInfo && typeof errorInfo === \"object\") {\n        if (typeof errorInfo.$info === \"string\" && errorInfo.$info.trim()) {\n            errorMessage = errorInfo.$info;\n        } else if (typeof errorInfo.message === \"string\" && errorInfo.message.trim()) {\n            errorMessage = errorInfo.message;\n        } else if (typeof errorInfo.error === \"string\" && errorInfo.error.trim()) {\n            errorMessage = errorInfo.error;\n        }\n        if (errorInfo.code) {\n            errorCode = errorInfo.code;\n        }\n    }\n    result = {\n        status: \"ERROR\",\n        error: {\n            stage: \"Extract Document Type\",\n            code: errorCode,\n            message: errorMessage\n        }\n    };\n}\n// 2. MALFORMED OR MISSING RESPONSE\nelse if (!nodeOutput || (typeof nodeOutput !== \"object\" && typeof nodeOutput !== \"string\")) {\n    result = {\n        status: \"ERROR\",\n        error: {\n            stage: \"Extract Document Type\",\n            code: \"EMPTY_RESPONSE\",\n            message: \"No response received from previous node.\"\n        }\n    };\n}\n// 3. SUCCESS: PROCESS OUTPUT\nelse {\n    let obj = null;\n    const rawData = nodeOutput;\n    if (typeof rawData === \"string\") {\n        try {\n            obj = JSON.parse(rawData);\n        } catch (e) {\n            obj = {}; // fail gracefully\n        }\n    } else {\n        obj = rawData;\n    }\n    if (obj && obj.documentType) {\n        result = { documentType: obj.documentType };\n    } else {\n        result = {\n            status: \"ERROR\",\n            error: {\n                stage: \"Extract Document Type\",\n                code: \"MISSING_DOCUMENT_TYPE\",\n                message: \"documentType not found in response.\"\n            }\n        };\n    }\n}\n\nreturn result;"
          },
