            "sourceCode": "var errorResult = $context.$nodes.FIN_FUN_CODE_EXTRACT_TRANSFORM_RESPONSE_STRUCTURED.$output.result;\n\nvar businessObject = $context.$variables.businessObject;\nvar product = $context.$variables.product;\n\nif (\n  !businessObject || typeof businessObject !== \"string\" || businessObject.trim() === \"\" ||\n  !product || typeof product !== \"string\" || product.trim() === \"\"\n) {\n  errorResult = {\n    status: \"ERROR\",\n    error: {\n      stage: \"Ingestion\",\n      code: \"MISSING_REQUIRED_FIELDS\",\n      message: \"Ingestion is not allowed: businessObject and product are required.\"\n    }\n  };\n}\n\nreturn errorResult;"
