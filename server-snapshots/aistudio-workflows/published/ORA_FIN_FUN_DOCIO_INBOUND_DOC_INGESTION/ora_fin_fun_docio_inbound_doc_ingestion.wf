            "name": "Prepare Ingestion Payload Structured",
            "returnType": "object",
            "sourceCode": "// Merge as specified and wrap in 'payload'\nvar wfinput = $context.$variables.wfinput;\nvar ingestborequest = $context.$variables.ingestionborequest;\nvar transformationwfrequest = $context.$variables.transformationwfrequest;\n\nvar payload = {};\n\n// 1. Copy wfinput fields, exclude \"content\" and \"documentInBase64\"\nif (wfinput && typeof wfinput === \"object\") {\n  for (var key in wfinput) {\n    if (\n      Object.prototype.hasOwnProperty.call(wfinput, key) &&\n      key !== \"content\" &&\n      key !== \"documentInBase64\"\n    ) {\n      payload[key] = wfinput[key];\n    }\n  }\n}\n\n// 2. Copy ingestborequest fields, exclude \"documentInBase64\"\nif (ingestborequest && typeof ingestborequest === \"object\") {\n  for (var key in ingestborequest) {\n    if (\n      Object.prototype.hasOwnProperty.call(ingestborequest, key) &&\n      key !== \"documentInBase64\"\n    ) {\n      payload[key] = ingestborequest[key];\n    }\n  }\n}\n\n// 3. Copy transformationwfrequest fields, exclude \"content\" and \"documentInBase64\"\nif (transformationwfrequest && typeof transformationwfrequest === \"object\") {\n  for (var key in transformationwfrequest) {\n    if (\n      Object.prototype.hasOwnProperty.call(transformationwfrequest, key) &&\n      key !== \"content\" &&\n      key !== \"documentInBase64\"\n    ) {\n      payload[key] = transformationwfrequest[key];\n    }\n  }\n}\n\n// Stringify content if it's an array or object (for downstream compatibility)\nif (\n  payload.content &&\n  (Array.isArray(payload.content) || typeof payload.content === \"object\")\n) {\n  payload.content = JSON.stringify(payload.content);\n}\n\nreturn { payload: payload };"
          },
          "outcomes": {
            "success": "1768830262253"
          },
          "code": "FIN_FUN_CODE_PREPARE_INGESTION_PAYLOAD_STRUCTURED",
          "convergenceTargetId": "1770363420088",
          "id": "1768830201008",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
