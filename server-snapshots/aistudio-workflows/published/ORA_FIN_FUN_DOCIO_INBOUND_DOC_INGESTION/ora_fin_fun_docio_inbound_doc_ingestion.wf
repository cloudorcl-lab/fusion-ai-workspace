        {
          "metadata": {
            "errorNodeId": "1768830344714",
            "name": "Extract Transformed Response Structured",
            "returnType": "object",
            "sourceCode": "// ===============================\n// MERGE inputMessage (excluding some fields) WITH ALL input.result fields\n// ===============================\nconst input = $context.$variables.transformationwfresponse;\nconst inputMessageRaw = $context.$variables.wfinput;\nlet inputMessage;\n\n// Handle possible stringified wfinput with nested JSON\nif (typeof inputMessageRaw === \"string\") {\n  try {\n    const parsed = JSON.parse(inputMessageRaw);\n    inputMessage = (typeof parsed === \"string\") ? JSON.parse(parsed) : parsed;\n  } catch (e) {\n    inputMessage = null;\n  }\n} else {\n  inputMessage = inputMessageRaw;\n}\n\nlet noderesult;\n\nif (!input || !input.result) {\n  noderesult = {\n    status: \"ERROR\",\n    error: {\n      stage: \"Parse Result\",\n      code: \"INPUT_NOT_FOUND\",\n      message: \"Result is missing or invalid\"\n    }\n  };\n} else {\n  // Parse input.result if it's a string\n  let resultData = input.result;\n  if (typeof resultData === \"string\") {\n    try {\n      resultData = JSON.parse(resultData);\n    } catch (e) {\n      // If parsing fails, treat as error\n      noderesult = {\n        status: \"ERROR\",\n        error: {\n          stage: \"Parse Result\",\n          code: \"INVALID_RESULT_FORMAT\",\n          message: \"Failed to parse result data\"\n        }\n      };\n      return noderesult;\n    }\n  }\n\n  // Check if the result contains an error status (convert to uppercase for comparison)\n  if (resultData.status && resultData.status.toUpperCase() === \"ERROR\") {\n    // Return the error as-is\n    noderesult = resultData;\n    return noderesult;\n  }\n\n  // Normal processing if no error\n  noderesult = {};\n  \n  if (inputMessage && typeof inputMessage === \"object\") {\n    Object.keys(inputMessage).forEach(key => {\n      if (key !== \"content\" && key !== \"documentInBase64\") {\n        noderesult[key] = inputMessage[key];\n      }\n    });\n  }\n  \n  // Merge fields from resultData\n  Object.keys(resultData).forEach(key => {\n    noderesult[key] = resultData[key];\n  });\n  \n  // Optionally, parse content if it's a JSON string\n  if (noderesult.content && typeof noderesult.content === \"string\") {\n    try {\n      noderesult.content = JSON.parse(noderesult.content);\n    } catch(e) {\n      // leave as string if parse fails\n    }\n  }\n}\n\n// Return the merged result object\nreturn noderesult;"
          },
          "outcomes": {
            "success": "1768829031927"
          },
          "code": "FIN_FUN_CODE_EXTRACT_TRANSFORM_RESPONSE_STRUCTURED",
