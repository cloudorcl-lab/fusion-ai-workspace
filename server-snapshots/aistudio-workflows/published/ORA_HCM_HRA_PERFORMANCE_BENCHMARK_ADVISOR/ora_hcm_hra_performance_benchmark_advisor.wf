        {
          "metadata": {
            "name": "Build Graph Data",
            "returnType": "object",
            "sourceCode": "var inputData = $context && $context.$nodes && $context.$nodes.TEAM_RATINGS\n  ? $context.$nodes.TEAM_RATINGS.$output\n  : null;\n\nvar result = { ManagerName: null, RatingSeries: [] };\n\nvar data = null;\nif (inputData && inputData.items && inputData.items.length > 0) {\n  data = inputData.items[0];\n}\n\nvar orgTargets = [];\nvar teamRatings = [];\n\nif (data && data.organizationTargets && data.organizationTargets.items) {\n  orgTargets = data.organizationTargets.items;\n}\nif (data && data.teamRatings && data.teamRatings.items) {\n  teamRatings = data.teamRatings.items;\n}\n\nvar totalDirects = teamRatings.length;\n\n// Count by NumericRating\nvar ratingCounts = {};\nvar i = 0;\nfor (i = 0; i < teamRatings.length; i++) {\n  var emp = teamRatings[i];\n  var r = emp ? Number(emp.NumericRating) : NaN;\n  if (!Number.isNaN(r)) {\n    ratingCounts[r] = (ratingCounts[r] || 0) + 1;\n  }\n}\n\n// Build RatingSeries (no map/forEach callbacks)\nvar seriesData = [];\nfor (i = 0; i < orgTargets.length; i++) {\n  var target = orgTargets[i];\n\n  var numericRating = target ? Number(target.NumericRating) : NaN;\n  var ratingKeyValid = !Number.isNaN(numericRating);\n\n  var count = 0;\n  if (ratingKeyValid && ratingCounts[numericRating]) {\n    count = ratingCounts[numericRating];\n  }\n\n  var managerDistribution = 0;\n  if (totalDirects > 0) {\n    managerDistribution = (count / totalDirects) * 100;\n  }\n\n  var min = target ? Number(target.MinimumRatingDistribution) : 0;\n  var max = target ? Number(target.MaximumRatingDistribution) : 0;\n  if (Number.isNaN(min)) min = 0;\n  if (Number.isNaN(max)) max = 0;\n\n  var orgTargetVal = 0;\n  if (min > 0 && max > 0) {\n    orgTargetVal = (min + max) / 2;\n  } else if (min > 0 || max > 0) {\n    orgTargetVal = min > 0 ? min : max;\n  }\n\n  seriesData.push({\n    RatingDescription: target && target.RatingDescription != null ? target.RatingDescription : null,\n    NumericRating: ratingKeyValid ? numericRating : null,\n    OrganizationTarget: orgTargetVal,\n    ManagerRating: Number(managerDistribution.toFixed(2))\n  });\n}\n\n// Sort (no comparator function)\nfor (var a = 0; a < seriesData.length - 1; a++) {\n  for (var b = 0; b < seriesData.length - 1 - a; b++) {\n    var x = seriesData[b].NumericRating;\n    var y = seriesData[b + 1].NumericRating;\n\n    var vx = (x == null ? 9999 : x);\n    var vy = (y == null ? 9999 : y);\n\n    if (vx > vy) {\n      var tmp = seriesData[b];\n      seriesData[b] = seriesData[b + 1];\n      seriesData[b + 1] = tmp;\n    }\n  }\n}\n\nif (data && data.ManagerDisplayName != null) {\n  result.ManagerName = data.ManagerDisplayName;\n}\nresult.RatingSeries = seriesData;\n\nreturn result;"
          },
          "outcomes": {
            "success": "1766262095698"
          },
