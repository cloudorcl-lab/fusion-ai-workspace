            "sourceCode": "var data = $context.$nodes.EXECUTEQUERY.$output;\nvar deepLinkString = \"\"\nif ( $context.$nodes.FILTER_GENERATOR.$output.remitFlag == \"yes\" )\n{\ndeepLinkString = \"<a href=\\\"https://cptcokuqy.fusionapps.ocs.oc-test.com/fscmUI/faces/oracle/apps/financials/receivables/receipts/desktopLockboxes/di/excel/ManageLockboxErrors.xlsx\\\">Resolve Lockbox Exceptions</a><br><a href=\\\"https://cptcokuqy.fusionapps.ocs.oc-test.com/fscmUI/faces/oracle/apps/financials/receivables/receipts/desktopReceiptRemittance/di/excel/ViewandEditReceiptCreationErrors.xlsx?batchId=123&podName=cptcokuqy\\\">Resolve Bank Statement Exceptions</a><br><a href=\\\"https://cptcokuqy.fusionapps.ocs.oc-test.com/fscmUI/faces/oracle/apps/financials/receivables/receipts/desktopReceiptRemittance/di/excel/ViewandEditRemittanceAdviceCreationErrors.xlsx?podName=cptcokuqy\\\">Resolve Remittance Advice Exceptions</a>\"\n}\nelse\n{\ndeepLinkString = \"<a href=\\\"https://cptcokuqy.fusionapps.ocs.oc-test.com/fscmUI/faces/oracle/apps/financials/receivables/receipts/desktopLockboxes/di/excel/ManageLockboxErrors.xlsx\\\">Resolve Lockbox Exceptions</a><br><a href=\\\"https://cptcokuqy.fusionapps.ocs.oc-test.com/fscmUI/faces/oracle/apps/financials/receivables/receipts/desktopReceiptRemittance/di/excel/ViewandEditReceiptCreationErrors.xlsx?batchId=123&podName=cptcokuqy\\\">Resolve Bank Statement Exceptions</a>\"\n}\n\nif (data == null) {\n  return {\n    messages: [\n      {\n        id: \"no_data_summary\",\n        type: \"text\",\n        contentPolicy: \"author\",\n        authoringHints: \" return no exception found\",\n        data: \"No receipt exceptions found.\"\n      }\n    ]\n  };\n}\n\n/*if (data.length <= 5) {\n  return {\n    messages: [\n      {\n        id: \"summary\",\n        type: \"text\",\n        contentPolicy: \"author\",\n        authoringHints: \"Return a short summary on total exceptions found and the total amount for those exceptions. Do not include a title.\",\n        data: $context.$nodes.EXECUTESCOREBOARDQUERY.$output\n      },\n      {\n        id: \"details_table\",\n        type: \"table\",\n        title: \"Receipt Exceptions\",\n        authoringHints: \"Hide the currency column.\",\n        data: $context.$nodes.EXECUTEQUERY.$output\n      },\n     {\n      id: \"deeplinks\",\n      type: \"text\",\n      contentPolicy: \"author\",\n      authoringHints: \"Return the given html data as it is.\",\n      data: deepLinkString\n    }\n    ]\n  };\n}*/\n\nreturn {\n  messages: [\n    {\n      id: \"summary\",\n      type: \"text\",\n      authoringHints: \"Return a short summary on total exceptions found and the total amount (in compact notation/scientific shorthand like 324K, 23M etc.) for those exceptions. Also mention in what order they are shown (refer the order by clause from \" + $context.$nodes.FILTER_GENERATOR.$output.filterClause + \"). Do not include a title. Also add this in last always : 'Table shows 10 rows, expand to see more'. Example: 'A total of 119 exceptions were identified, amounting to USD 109M sorted in order of amount descending. Table shows 10 rows, expand to see more.'\",\n      data: $context.$nodes.EXECUTESCOREBOARDQUERY.$output\n    },\n    {\n      id: \"details_table\",\n      type: \"table\",\n      title: \"Receipt Exceptions\",\n      groupId: \"details_group\",\n      groupTitle: \"Receipt Exceptions\",\n      authoringHints: \"Hide the currency column\",\n      data: $context.$nodes.EXECUTEQUERY.$output,\n      chatDisplayConfig: {\n        limitRowsInChat: true,\n        rowLimit: 10\n      }\n    },\n    {\n      id: \"details_scoreboard\",\n      type: \"scoreboard\",\n      groupId: \"details_group\",\n      groupTitle: \"Receipt Exceptions\",\n      authoringHints: \"have  these KPI cards -Total Count, Total Amount, Lockbox Count, Lockbox Amount, Bank Statement Count, Bank Statement Amount, Remittance Advice Count, Remittance Advice Amount.  Don't include a KPI card if it's value is 0\",\n      data: $context.$nodes.EXECUTESCOREBOARDQUERY.$output\n    },\n   {\n      id: \"deeplinks\",\n      type: \"text\",\n      contentPolicy: \"author\",\n      authoringHints: \"Return the given html data as it is.\",\n      data: deepLinkString\n\n    }\n  ]\n};"
