          "code": "BUILDREMITTANCEQUERY",
          "id": "1777050334096",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "BuildQuery",
            "returnType": "object",
            "sourceCode": "var filterClause = $context.$nodes.FILTER_GENERATOR.$output.filterClause || \"\";\nvar includeRemittance = $context.$nodes.FILTER_GENERATOR.$output.remitFlag === \"yes\";\n\nvar result = {\n  \"viewQueries\": {\n    \"lockboxExceptions\": {\n      \"module\": \"oraErpCoreReceivablesPayments\",\n      \"businessObject\": \"ReceivablesCashProcessingException\",\n      \"view\": \"receivablesLockboxProcessingExceptionDetail\",\n      \"fieldAliases\": {\n        \"customerAccount.customer.name\": \"customerName\",\n        \"lockboxTransmission.transmissionName\": \"fileName\",\n        \"sourceDocumentDate\": \"receiptDate\",\n        \"sourceDocumentNumber\": \"receiptNumber\",\n        \"sourceDocumentAmount\": \"amount\",\n        \"currency.currencyCode\": \"currencyCode\",\n        \"createdBy\": \"createdBy\",\n        \"timeCreated\": \"timeCreated\",\n        \"updatedBy\": \"updatedBy\",\n        \"timeUpdated\": \"timeUpdated\",\n        \"businessUnit.name\": \"businessUnitName\",\n        \"exceptionMessage.messageText\": \"messageText\"\n      }\n    },\n    \"bankStatementExceptions\": {\n      \"module\": \"oraErpCoreReceivablesPayments\",\n      \"businessObject\": \"ReceivablesCashProcessingException\",\n      \"view\": \"receivablesBankStatementProcessingExceptionDetail\",\n      \"fieldAliases\": {\n        \"customerAccount.customer.name\": \"customerName\",\n        \"sourceDocumentDate\": \"receiptDate\",\n        \"sourceDocumentNumber\": \"receiptNumber\",\n        \"sourceDocumentAmount\": \"amount\",\n        \"currency.currencyCode\": \"currencyCode\",\n        \"createdBy\": \"fileName\",\n        \"timeCreated\": \"timeCreated\",\n        \"updatedBy\": \"updatedBy\",\n        \"timeUpdated\": \"timeUpdated\",\n        \"businessUnit.name\": \"businessUnitName\",\n        \"exceptionMessage.messageText\": \"messageText\"\n        //\"bankStatementLine.bankAccountStatement.inboundFile.fileName\": \"fileName\"\n      }\n    }\n  },\n  \"namedSelects\": [\n    {\n      \"name\": \"bankStatementSelect\",\n      \"select\": \"Select timeCreated, businessUnitName, customerName, receiptDate, receiptNumber, currencyCode, amount, fileName, fileName as transmissionName, 'Bank Statement' as Source, messageText from bankStatementExceptions where 1=1\"\n    },\n    {\n      \"name\": \"lockboxSelect\",\n      \"select\": \"Select timeCreated, businessUnitName, customerName, receiptDate, receiptNumber, currencyCode, amount, fileName, fileName as transmissionName, 'Lockbox' as Source, messageText from lockboxExceptions where 1=1\"\n    }\n  ],\n  \"select\": \"\"\n};\n\nif (includeRemittance) {\n  result.viewQueries.remittanceExceptions = {\n    \"module\": \"oraErpCoreReceivablesPayments\",\n    \"businessObject\": \"ReceivablesCashProcessingException\",\n    \"view\": \"receivablesRemittanceAdviceProcessingExceptionDetail\",\n    \"fieldAliases\": {\n      \"customerAccount.customer.name\": \"customerName\",\n\"remitAdvice.customerName\": \"customerNameAlias\",\n      \"sourceDocumentDate\": \"receiptDate\",\n      \"sourceDocumentNumber\": \"receiptNumber\",\n      \"sourceDocumentAmount\": \"amount\",\n      \"currency.currencyCode\": \"currencyCode\",\n      \"remitAdvice.documentName\" : \"fileName\",\n      \"createdBy\": \"createdBy\",\n      \"timeCreated\": \"timeCreated\",\n      \"updatedBy\": \"updatedBy\",\n      \"timeUpdated\": \"timeUpdated\",\n      \"businessUnit.name\": \"businessUnitName\",\n      \"exceptionMessage.messageText\": \"messageText\",\n       \"remitAdvice.documentName\": \"fileName\"\n    }\n  };\n\n  result.namedSelects.push({\n    \"name\": \"remittanceSelect\",\n    \"select\": \"Select timeCreated, businessUnitName, NVL(customerName,customerNameAlias) as customerName, receiptDate, receiptNumber, currencyCode, amount,  fileName, fileName as transmissionName, 'Remittance Advice' as Source, messageText from remittanceExceptions where 1=1\"\n  });\n\n  result.namedSelects.push({\n    \"name\": \"combinedSelect\",\n    \"select\": \"select timeCreated, businessUnitName, customerName, receiptNumber, receiptDate, amount, currencyCode, fileName, transmissionName, Source, messageText from bankStatementSelect UNION ALL select timeCreated, businessUnitName, customerName, receiptNumber, receiptDate, amount, currencyCode, fileName, transmissionName, Source, messageText from lockboxSelect UNION ALL select timeCreated, businessUnitName, customerName, receiptNumber, receiptDate, amount, currencyCode, fileName, transmissionName, Source, messageText from remittanceSelect\"\n  });\n} else {\n  result.namedSelects.push({\n    \"name\": \"combinedSelect\",\n    \"select\": \"select timeCreated, businessUnitName, customerName, receiptNumber, receiptDate, amount, currencyCode, fileName, transmissionName, Source, messageText from bankStatementSelect UNION ALL select timeCreated, businessUnitName, customerName, receiptNumber, receiptDate, amount, currencyCode, fileName, transmissionName, Source, messageText from lockboxSelect\"\n  });\n}\n\nresult.select =\n  \"select customerName, receiptNumber, receiptDate, amount, currencyCode, fileName, Source, messageText as Exception from combinedSelect where 1=1\" +\n  filterClause;\n\nreturn result;"
          },
          "outcomes": {
            "success": "1777053699206"
          },
          "code": "BUILDQUERY",
          "id": "1777053654542",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
