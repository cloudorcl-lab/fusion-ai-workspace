        {
          "metadata": {
            "name": "BuildLockboxScoreboardQuery",
            "returnType": "object",
            "sourceCode": "var filterClause = $context.$nodes.FILTER_GENERATOR.$output.filterClause || \"\";\n\nvar result = {\n  \"viewQueries\": {\n    \"lockboxExceptions\": {\n      \"module\": \"oraErpCoreReceivablesPayments\",\n      \"businessObject\": \"ReceivablesCashProcessingException\",\n      \"view\": \"receivablesLockboxProcessingExceptionDetail\",\n      \"fieldAliases\": {\n        \"customerAccount.customer.name\": \"customerName\",\n        \"lockboxTransmission.transmissionName\": \"fileName\",\n        \"sourceDocumentDate\": \"receiptDate\",\n        \"sourceDocumentNumber\": \"receiptNumber\",\n        \"sourceDocumentAmount\": \"amount\",\n        \"currency.currencyCode\": \"currencyCode\",\n        \"createdBy\": \"createdBy\",\n        \"timeCreated\": \"timeCreated\",\n        \"updatedBy\": \"updatedBy\",\n        \"timeUpdated\": \"timeUpdated\",\n        \"businessUnit.name\": \"businessUnitName\",\n        \"exceptionMessage.messageText\": \"messageText\"\n      }\n    }\n  },\n  \"namedSelects\": [\n    {\n      \"name\": \"lockboxSelect\",\n      \"select\": \"Select timeCreated, businessUnitName, customerName, receiptDate, receiptNumber, currencyCode, amount, fileName, fileName as transmissionName, messageText from lockboxExceptions where 1=1\"\n    },\n    {\n      \"name\": \"finalSelect\",\n      \"select\": \"Select timeCreated, businessUnitName, customerName, receiptDate, receiptNumber, currencyCode, amount, fileName, transmissionName, messageText from lockboxSelect where 1=1\" + filterClause\n    }\n  ],\n  \"select\": \"Select COUNT(1) AS TotalCount, SUM(amount) AS TotalAmount from finalSelect\",\n  \"return\": [\n    { \"name\": \"TotalCount\" },\n    { \"name\": \"TotalAmount\" }\n  ]\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1777044299763"
          },
          "code": "BUILDLOCKBOXSCOREBOARDQUERY",
          "id": "1777043711011",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "BuildBankStatementScoreboardQuery",
            "returnType": "object",
            "sourceCode": "var filterClause = $context.$nodes.FILTER_GENERATOR.$output.filterClause ;\n\nvar result = {\n  \"viewQueries\": {\n    \"bankStatementExceptions\": {\n      \"module\": \"oraErpCoreReceivablesPayments\",\n      \"businessObject\": \"ReceivablesCashProcessingException\",\n      \"view\": \"receivablesBankStatementProcessingExceptionDetail\",\n      \"fieldAliases\": {\n              \"customerAccount.customer.name\": \"customerName\",\n              \"sourceDocumentDate\": \"receiptDate\",\n              \"sourceDocumentNumber\": \"receiptNumber\",\n              \"sourceDocumentAmount\": \"amount\",\n              \"currency.currencyCode\": \"currencyCode\",\n              \"createdBy\": \"fileName\",\n              \"timeCreated\": \"timeCreated\",\n              \"updatedBy\": \"updatedBy\",\n              \"timeUpdated\": \"timeUpdated\",\n              \"businessUnit.name\": \"businessUnitName\",\n             \"exceptionMessage.messageText\": \"messageText\"\n             //\"bankStatementLine.bankAccountStatement.inboundFile.fileName\": \"fileName\"\n            }\n    }\n  },\n\"select\": \"Select COUNT(1) AS TotalCount, SUM(amount) AS TotalAmount FROM (Select customerName, receiptDate, receiptNumber, currencyCode, amount, messageText as Exception from bankStatementExceptions where 1=1\" + filterClause + \")\"\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1777049306392"
          },
          "code": "BUILDBANKSTATEMENTSCOREBOARDQUERY",
          "id": "1777049091075",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "BuildRemittanceScoreboardQuery",
            "returnType": "object",
            "sourceCode": "var filterClause = $context.$nodes.FILTER_GENERATOR.$output.filterClause ;\n\nvar result = {\n  \"viewQueries\": {\n    \"remittanceExceptions\": {\n      \"module\": \"oraErpCoreReceivablesPayments\",\n      \"businessObject\": \"ReceivablesCashProcessingException\",\n      \"view\": \"receivablesRemittanceAdviceProcessingExceptionDetail\",\n      \"fieldAliases\": {\n              \"customerAccount.customer.name\": \"customerName\",\n              \"remitAdvice.customerName\": \"customerNameAlias\",\n              \"sourceDocumentDate\": \"receiptDate\",\n              \"sourceDocumentNumber\": \"receiptNumber\",\n              \"sourceDocumentAmount\": \"amount\",\n              \"currency.currencyCode\": \"currencyCode\",\n              \"createdBy\": \"createdBy\",\n              \"timeCreated\": \"timeCreated\",\n              \"updatedBy\": \"updatedBy\",\n              \"timeUpdated\": \"timeUpdated\",\n              \"businessUnit.name\": \"businessUnitName\",\n             \"exceptionMessage.messageText\": \"messageText\",\n              \"remitAdvice.documentName\": \"fileName\"\n            }\n    }\n  },\n\"select\": \"Select COUNT(1) AS TotalCount, SUM(amount) AS TotalAmount FROM (Select NVL(customerName,customerNameAlias), receiptDate, receiptNumber, currencyCode, amount, messageText as Exception from remittanceExceptions where 1=1\" + filterClause + \")\"\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1777050444961"
          },
          "code": "BUILDREMITTANCESCOREBOARDQUERY",
          "id": "1777049180892",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "BuildScoreBoardQuery",
            "returnType": "object",
            "sourceCode": "var filterClause = $context.$nodes.FILTER_GENERATOR.$output.filterClause || \"\";\nvar includeRemittance = $context.$nodes.FILTER_GENERATOR.$output.remitFlag === \"yes\";\n\nvar result = {\n  \"viewQueries\": {\n    \"lockboxExceptions\": {\n      \"module\": \"oraErpCoreReceivablesPayments\",\n      \"businessObject\": \"ReceivablesCashProcessingException\",\n      \"view\": \"receivablesLockboxProcessingExceptionDetail\",\n      \"fieldAliases\": {\n        \"customerAccount.customer.name\": \"customerName\",\n        \"lockboxTransmission.transmissionName\": \"fileName\",\n        \"sourceDocumentDate\": \"receiptDate\",\n        \"sourceDocumentNumber\": \"receiptNumber\",\n        \"sourceDocumentAmount\": \"amount\",\n        \"currency.currencyCode\": \"currencyCode\",\n        \"createdBy\": \"createdBy\",\n        \"timeCreated\": \"timeCreated\",\n        \"updatedBy\": \"updatedBy\",\n        \"timeUpdated\": \"timeUpdated\",\n        \"businessUnit.name\": \"businessUnitName\",\n        \"exceptionMessage.messageText\": \"messageText\"\n      }\n    },\n    \"bankStatementExceptions\": {\n      \"module\": \"oraErpCoreReceivablesPayments\",\n      \"businessObject\": \"ReceivablesCashProcessingException\",\n      \"view\": \"receivablesBankStatementProcessingExceptionDetail\",\n      \"fieldAliases\": {\n        \"customerAccount.customer.name\": \"customerName\",\n        \"sourceDocumentDate\": \"receiptDate\",\n        \"sourceDocumentNumber\": \"receiptNumber\",\n        \"sourceDocumentAmount\": \"amount\",\n        \"currency.currencyCode\": \"currencyCode\",\n        \"createdBy\": \"fileName\",\n        \"timeCreated\": \"timeCreated\",\n        \"updatedBy\": \"updatedBy\",\n        \"timeUpdated\": \"timeUpdated\",\n        \"businessUnit.name\": \"businessUnitName\",\n        \"exceptionMessage.messageText\": \"messageText\"\n        //\"bankStatementLine.bankAccountStatement.inboundFile.fileName\": \"fileName\"\n      }\n    }\n  },\n  \"namedSelects\": [\n    {\n      \"name\": \"bankStatementSelect\",\n      \"select\": \"Select timeCreated, businessUnitName, customerName, receiptDate, receiptNumber, currencyCode, amount, fileName, fileName as transmissionName, 'BANK' as Source, messageText from bankStatementExceptions where 1=1\"\n    },\n    {\n      \"name\": \"lockboxSelect\",\n      \"select\": \"Select timeCreated, businessUnitName, customerName, receiptDate, receiptNumber, currencyCode, amount, fileName, fileName as transmissionName, 'LOCKBOX' as Source, messageText from lockboxExceptions where 1=1\"\n    }\n  ],\n  \"select\": \"\",\n  \"return\": []\n};\n\nif (includeRemittance) {\n  result.viewQueries.remittanceExceptions = {\n    \"module\": \"oraErpCoreReceivablesPayments\",\n    \"businessObject\": \"ReceivablesCashProcessingException\",\n    \"view\": \"receivablesRemittanceAdviceProcessingExceptionDetail\",\n    \"fieldAliases\": {\n      \"customerAccount.customer.name\": \"customerName\",\n      \"sourceDocumentDate\": \"receiptDate\",\n      \"sourceDocumentNumber\": \"receiptNumber\",\n      \"sourceDocumentAmount\": \"amount\",\n      \"currency.currencyCode\": \"currencyCode\",\n      \"createdBy\": \"createdBy\",\n      \"timeCreated\": \"timeCreated\",\n      \"updatedBy\": \"updatedBy\",\n      \"timeUpdated\": \"timeUpdated\",\n      \"businessUnit.name\": \"businessUnitName\",\n      \"exceptionMessage.messageText\": \"messageText\",\n      \"remitAdvice.documentName\": \"fileName\"\n    }\n  };\n\n  result.namedSelects.push({\n    \"name\": \"remittanceSelect\",\n    \"select\": \"Select timeCreated, businessUnitName, customerName, receiptDate, receiptNumber, currencyCode, amount, CAST(NULL AS VARCHAR2(240)) as fileName, CAST(NULL AS VARCHAR2(240)) as transmissionName, 'REMITTANCE' as Source, messageText from remittanceExceptions where 1=1\"\n  });\n\n  result.namedSelects.push({\n    \"name\": \"combinedSelect\",\n    \"select\": \"select timeCreated, businessUnitName, customerName, receiptDate, receiptNumber, currencyCode, amount, fileName, transmissionName, Source, messageText from bankStatementSelect UNION ALL select timeCreated, businessUnitName, customerName, receiptDate, receiptNumber, currencyCode, amount, fileName, transmissionName, Source, messageText from lockboxSelect UNION ALL select timeCreated, businessUnitName, customerName, receiptDate, receiptNumber, currencyCode, amount, fileName, transmissionName, Source, messageText from remittanceSelect\"\n  });\n\n  result.namedSelects.push({\n    \"name\": \"finalSelect\",\n    \"select\": \"Select timeCreated, businessUnitName, customerName, receiptDate, receiptNumber, currencyCode, amount, fileName, transmissionName, Source, messageText from combinedSelect where 1=1\" + filterClause\n  });\n\n  result.select =\n    \"select SUM(CASE WHEN Source = 'LOCKBOX' THEN amount END) as lockboxAmount, \" +\n    \"COUNT(CASE WHEN Source = 'LOCKBOX' THEN 1 END) as lockboxCount, \" +\n    \"SUM(CASE WHEN Source = 'BANK' THEN amount END) as bankStatementAmount, \" +\n    \"COUNT(CASE WHEN Source = 'BANK' THEN 1 END) as bankStatementCount, \" +\n    \"SUM(CASE WHEN Source = 'REMITTANCE' THEN amount END) as remittanceAdviceAmount, \" +\n    \"COUNT(CASE WHEN Source = 'REMITTANCE' THEN 1 END) as remittanceAdviceCount, \" +\n    \"SUM(amount) as TotalAmount, COUNT(1) as TotalCount from finalSelect\";\n\n  result.return = [\n    { \"name\": \"lockboxAmount\" },\n    { \"name\": \"lockboxCount\" },\n    { \"name\": \"bankStatementAmount\" },\n    { \"name\": \"bankStatementCount\" },\n    { \"name\": \"remittanceAdviceAmount\" },\n    { \"name\": \"remittanceAdviceCount\" },\n    { \"name\": \"TotalAmount\" },\n    { \"name\": \"TotalCount\" }\n  ];\n} else {\n  result.namedSelects.push({\n    \"name\": \"combinedSelect\",\n    \"select\": \"select timeCreated, businessUnitName, customerName, receiptDate, receiptNumber, currencyCode, amount, fileName, transmissionName, Source, messageText from bankStatementSelect UNION ALL select timeCreated, businessUnitName, customerName, receiptDate, receiptNumber, currencyCode, amount, fileName, transmissionName, Source, messageText from lockboxSelect\"\n  });\n\n  result.namedSelects.push({\n    \"name\": \"finalSelect\",\n    \"select\": \"Select timeCreated, businessUnitName, customerName, receiptDate, receiptNumber, currencyCode, amount, fileName, transmissionName, Source, messageText from combinedSelect where 1=1\" + filterClause\n  });\n\n  result.select =\n    \"select SUM(CASE WHEN Source = 'LOCKBOX' THEN amount END) as lockboxAmount, \" +\n    \"COUNT(CASE WHEN Source = 'LOCKBOX' THEN 1 END) as lockboxCount, \" +\n    \"SUM(CASE WHEN Source = 'BANK' THEN amount END) as bankStatementAmount, \" +\n    \"COUNT(CASE WHEN Source = 'BANK' THEN 1 END) as bankStatementCount, \" +\n    \"SUM(amount) as TotalAmount, COUNT(1) as TotalCount from finalSelect\";\n\n  result.return = [\n    { \"name\": \"lockboxAmount\" },\n    { \"name\": \"lockboxCount\" },\n    { \"name\": \"bankStatementAmount\" },\n    { \"name\": \"bankStatementCount\" },\n    { \"name\": \"TotalAmount\" },\n    { \"name\": \"TotalCount\" }\n  ];\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1777053603165"
          },
          "code": "BUILDSCOREBOARDQUERY",
          "id": "1777053566740",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "receiptsummaryOutput",
            "returnType": "object",
            "sourceCode": "// ---Inputs---\nconst result = $context.$nodes.DATAROLLUP.$output.result || {};\n\n//const summary =\nconst summary = $context.$nodes.SUMMARIZERECEIPT.$output.summary;\nconst data = $context.$nodes.DATAROLLUP.$output;\nconst filterText = $context.$nodes.SUMMARIZERECEIPT.$output.filterText;\n// result.filterText || $context.$variables.chatcontext.semantic_rewrite;\nconst suggestions = $context.$nodes.SUMMARIZERECEIPT.$output.suggestions;\n\n// ---Resolve data rows---\nconst dataItems = Array.isArray(result.data)\n  ? result.data\n  : [];\n\nconst isEmpty = dataItems.length === 0;\n\n// ---Resolve application rows---\nconst applicationItems = Array.isArray(result.application)\n  ? result.application\n  : [];\n\nconst hasApplication = applicationItems.length > 0;\n\n// ---Resolve remittance/reference rows---\nconst remitRefItems = Array.isArray(result.remitref)\n  ? result.remitref\n  : [];\n\nconst hasRemitRef = remitRefItems.length > 0;\n\n// ---Resolve summary text---\nconst summaryText = (\n  typeof summary === \"string\"\n    ? summary\n    : summary?.text || summary?.result || summary?.message || \"\"\n) || \"\";\n\n// ---Resolve filters text---\nconst filtersText = (\n  typeof filterText === \"string\"\n    ? filterText\n    : filterText?.text || filterText?.result || filterText?.message || \"\"\n) || \"\";\n\n// ---Escape HTML for safe suggestions rendering---\nfunction escapeHtml(value) {\n  return String(value)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n}\n\n// ---Resolve suggestions HTML---\n// Always normalize suggestions into <ul><li>...</li></ul>\nlet suggestionsHtml = \"\";\n\nif (Array.isArray(suggestions) && suggestions.length > 0) {\n  const items = suggestions\n    .filter(Boolean)\n    .map(s => String(s).replace(/^[-•]\\s*/, \"\").trim())\n    .filter(Boolean);\n\n  if (items.length > 0) {\n    suggestionsHtml =\n      \"<ul>\" +\n      items.map(s => \"<li>\" + escapeHtml(s) + \"</li>\").join(\"\") +\n      \"</ul>\";\n  }\n} else if (typeof suggestions === \"string\" && suggestions.trim()) {\n  const rawSuggestions = suggestions.trim();\n\n  if (/^\\s*<ul[\\s>]/i.test(rawSuggestions)) {\n    suggestionsHtml = rawSuggestions;\n  } else if (/^\\s*<li[\\s>]/i.test(rawSuggestions)) {\n    suggestionsHtml = \"<ul>\" + rawSuggestions + \"</ul>\";\n  } else {\n    const items = rawSuggestions\n      .split(/\\n+/)\n      .map(s => s.replace(/^[-•]\\s*/, \"\").trim())\n      .filter(Boolean);\n\n    if (items.length > 0) {\n      suggestionsHtml =\n        \"<ul>\" +\n        items.map(s => \"<li>\" + escapeHtml(s) + \"</li>\").join(\"\") +\n        \"</ul>\";\n    }\n  }\n} else if (suggestions?.text || suggestions?.result || suggestions?.message) {\n  const rawSuggestions = String(\n    suggestions.text || suggestions.result || suggestions.message || \"\"\n  ).trim();\n\n  const items = rawSuggestions\n    .split(/\\n+/)\n    .map(s => s.replace(/^[-•]\\s*/, \"\").trim())\n    .filter(Boolean);\n\n  if (items.length > 0) {\n    suggestionsHtml =\n      \"<ul>\" +\n      items.map(s => \"<li>\" + escapeHtml(s) + \"</li>\").join(\"\") +\n      \"</ul>\";\n  }\n}\n\n// ---GUARD: No data, no summary, no filter, no suggestions---\nif (!summaryText && !filtersText && isEmpty && !hasApplication && !hasRemitRef && !suggestionsHtml) {\n  return {\n    messages: [\n      {\n        id: \"no_data\",\n        type: \"text\",\n        contentPolicy: \"author\",\n        authoringHints: \"Return a short standalone message. Do not include a title.\",\n        data: \"No data found.\"\n      }\n    ]\n  };\n}\n\n// ---Build messages array---\n// Order:\n// 1. Summary - text\n// 2. Filter - text\n// 3. Data - table\n// 4. Suggestion - text\n\nconst messages = [];\n\n// 1. Summary text\nif (summaryText) {\n  messages.push({\n    id: \"summary\",\n    type: \"text\",\n    contentPolicy: \"normalizeOnly\",\n    authoringHints: \"Do not summarize, display as is.\",\n    data: summaryText\n  });\n}\n\n// 2. Filter text\nif (filtersText) {\n  messages.push({\n    id: \"filters\",\n    type: \"text\",\n    contentPolicy: \"normalizeOnly\",\n    authoringHints: \"Do not summarize, display as is.\",\n    data: filtersText\n  });\n}\n\n// 3. Data table\nif (!isEmpty) {\n  messages.push({\n    id: \"details_table\",\n    type: \"table\",\n    authoringHints: \"List of records. Exclude the currency column from the output.\",\n    data: dataItems\n  });\n}\n\nif (hasApplication) {\n  messages.push({\n    id: \"application_table\",\n    type: \"table\",\n    title: \"Receipt Application\",\n    authoringHints: \"List of receipt applications for the receipt.\",\n    data: applicationItems\n  });\n}\n\nif (hasRemitRef) {\n  messages.push({\n    id: \"remittance_reference_table\",\n    type: \"table\",\n    title: \"Remittance Advice / Reference\",\n    authoringHints: \"List of remittance advice or reference details associated with the receipt.\",\n    data: remitRefItems\n  });\n}\n\n// 4. Suggestions text\nif (suggestionsHtml) {\n  messages.push({\n    id: \"suggestions\",\n    type: \"text\",\n    title: \"Suggestions\",\n    contentPolicy: \"normalizeOnly\",\n    authoringHints: \"Display as HTML bulleted list. Do not summarize or rewrite.\",\n    data: suggestionsHtml\n  });\n}\n\nreturn {\n  messages\n};"
          },
          "outcomes": {
            "success": "1779088365496"
          },
          "code": "RECEIPTSUMMARYOUTPUT",
          "id": "1779088310603",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
