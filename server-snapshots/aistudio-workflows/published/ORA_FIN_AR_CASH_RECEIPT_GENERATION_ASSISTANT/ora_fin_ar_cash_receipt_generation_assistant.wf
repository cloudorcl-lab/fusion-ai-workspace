          "metadata": {
            "name": "Return Display Result",
            "returnType": "object",
            "sourceCode": "try {\n  let value = $context.$nodes.DISPLAY_FORMATTER.$output.output;\n\n  while (typeof value === \"string\") {\n    value = JSON.parse(value);\n  }\n\n  return value && typeof value === \"object\" && value.result ? value.result : value;\n} catch (error) {\n  return {\n    status: \"error\",\n    message: error && error.message ? error.message : \"Unable to parse formatter output\"\n  };\n}"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "RETURN_DISPLAY_RESULT",
