            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
        },
        {
          "metadata": {
            "name": "Build Clarification Display Template",
            "returnType": "object",
            "sourceCode": "const ctx = $context.$variables.chatcontent || {};\nconst text = ctx.semanticRewrite || \"\";\n\nfunction buildAmbiguousScopeQuestion(ctx) {\n  const pending = String($context.$variables.pendingSemanticRewrite || \"\").toLowerCase();\n\n  if (pending.includes(\"lockbox\") || text.toLowerCase().includes(\"lockbox\")) {\n    return \"Do you want to see lockbox file ingestion exceptions or lockbox receipt creation exceptions?\";\n  }\n\n  if (\n    pending.includes(\"bank statement\") ||\n    pending.includes(\"statement\") ||\n    text.toLowerCase().includes(\"bank statement\")\n  ) {\n    return \"Do you want to see bank statement file ingestion exceptions or bank statement receipt creation exceptions?\";\n  }\n\n  if (pending.includes(\"remittance\") || text.toLowerCase().includes(\"remittance\")) {\n    return \"Do you want to see remittance advice file exceptions or remittance advice exceptions?\";\n  }\n\n  return \"What would you like to review: receipt exploration, file ingestion exceptions, receipt creation exceptions, or remittance advice exceptions?\";\n}\n\nconst clarificationText =\n  ctx.clarificationReason === \"ambiguous_scope\"\n    ? buildAmbiguousScopeQuestion(ctx)\n    : text || \"What would you like to review: receipt exploration, file ingestion exceptions, receipt creation exceptions, or remittance advice exceptions?\";\n\nreturn {\n  messages: [\n    {\n      id: \"clarification\",\n      type: \"text\",\n      contentPolicy: \"preserve\",\n      data: clarificationText\n    }\n  ]\n};"
          },
          "outcomes": {
            "success": "1778765954918"
          },
          "code": "BUILD_CLARIFICATION_DISPLAY_TEMPLATE",
          "id": "1778765889852",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "DocumentExceptionInquiry",
