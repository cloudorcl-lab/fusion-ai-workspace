                    "returnType": "string",
                    "sourceCode": "const output = $context.$nodes.LOOP_SPECIFIC_RECORDS.PROCESS_LAYOUT.$output;\n//try {\n    // Step 1: Parse the outer shell\n    //const firstPass = JSON.parse(output);\n\n    // Step 2: Extract the inner string (LayoutMetadata)\n    let metadataString = output.items[0].LayoutMetadata;\n\n    // Step 4: Parse the actual metadata\n    const finalData = JSON.parse(metadataString);\n\n    return JSON.stringify(finalData.fields); \n\n//} catch (e) {\n\n//}\nreturn output;"
                  },
