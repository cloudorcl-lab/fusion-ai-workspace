          "inputs": [
            {
              "id": "1764968134142_1",
              "name": "prompt",
              "type": "string",
              "value": "Analyze the input JSON {{$context.$nodes.FILTERREGISTEREDCODE.$output.result}} .\nStartDate and EndDate are in UTC time zone.\nConvert StartDate and EndDate  to {{$context.$nodes.GET_SELF_DETAILS.$output.items[0].TimeZone}} , applying daylight savings if applicable.\nFormat both dates using the user’s date and time format ({{$context.$nodes.GET_SELF_DETAILS.$output.items[0].DateFormat}} <space> {{$context.$nodes.GET_SELF_DETAILS.$output.items[0].TimeFormat}}  <space> {{$context.$nodes.GET_SELF_DETAILS.$output.items[0].TimeZone}}).\n\nfind top 5 matching events for skills {{$context.$variables.SEARCHFLD1}} \nDo not include events with RespondentStatusCode as  ORA_REGISTERED\nreturn as json list including all fields."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"Status\": {\n            \"type\": \"string\"\n          },\n          \"EventNumber\": {\n            \"type\": \"string\"\n          },\n          \"Name\": {\n            \"type\": \"string\"\n          },\n          \"RespondentStatusDescription\": {\n            \"type\": \"string\"\n          },\n          \"StartDate\": {\n            \"type\": \"date\"\n          },\n          \"EndDate\": {\n            \"type\": \"date\"\n          },\n          \"MaximumCapacity\": {\n            \"type\": \"number\"\n          },\n          \"RegisteredCount\": {\n            \"type\": \"number\"\n          },\n          \"Format\": {\n            \"type\": \"string\"\n          },\n          \"CategoryNames\": {\n            \"type\": \"string\"\n          },\n          \"CreationDate\": {\n            \"type\": \"date\"\n          },\n          \"Country\": {\n            \"type\": \"string\"\n          },\n          \"RespondentStatusCode\": {\n            \"type\": \"string\"\n          },\n          \"BannerImageURL\": {\n            \"type\": \"string\"\n          },\n          \"VisibilityCode\": {\n            \"type\": \"string\"\n          },\n          \"Description\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}",
