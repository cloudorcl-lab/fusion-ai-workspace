        {
          "metadata": {
            "errorNodeId": "1770958324449",
            "name": "FILTER_REGISTERED_CODE",
            "returnType": "object",
            "sourceCode": "// Since we are running multiple BO calls for keywords in the loop.. the items are return array in different nodes.. merge them first\nconst eventsArray = $context.$nodes.KEYWORDSEARCHLOOP.$output;\nlet mergedArray = [];\nlet eventsIDArray=[];\nfor (const result of eventsArray) {\n        //filter out events that are full\n        const resultObj = JSON.parse(result).result.items;\n         for (const item of resultObj) {\n              if (!eventsIDArray.includes(item.EventNumber) && (item.MaximumCapacity === null || parseInt(item.MaximumCapacity, 10) > parseInt(item.RegisteredCount, 10))) {\n                          mergedArray.push(item);\n                          eventsIDArray.push(item.EventNumber);\n              }\n        }\n}\nconst json = {items: mergedArray};\nreturn json;"
          },
          "outcomes": {
            "success": "1765314107241"
          },
          "code": "FILTERREGISTEREDCODE",
          "id": "1764875570057",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
