        {
          "metadata": {
            "name": "SEARCH_KEYWORDS",
            "returnType": "array",
            "sourceCode": "const searchString = $context.$variables.SEARCHFLD1 ;\nconst keywords= searchString.split(',').map(element => element.trim());;\nconst keywordArray = keywords.filter((keyword) => keyword.length > 1);\nreturn keywordArray;"
          },
          "outcomes": {
            "success": "1764611016086"
          },
          "code": "SEARCHKEYWORDS",
          "id": "1764870185725",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
