          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"OpportunityId\": { \"type\": \"integer\" },\n          \"OpportunityType\": { \"type\": \"string\" },\n          \"OpportunityNumber\": { \"type\": \"string\" },\n          \"Title\": { \"type\": \"string\" },\n          \"Location\": { \"type\": \"string\" },\n          \"PostedDate\": { \"type\": \"string\", \"format\": \"date-time\" },\n          \"RemoteOpportunityFlag\": { \"type\": \"boolean\" },\n          \"Organization\": { \"type\": \"string\" },\n          \"JobFunction\": { \"type\": \"string\" },\n          \"JobFamily\": { \"type\": \"string\" },\n          \"PrimaryWorkLocation\": { \"type\": \"string\" },\n          \"Recruiter\": { \"type\": \"string\" },\n          \"HiringManager\": { \"type\": \"string\" },\n          \"JobGrade\": { \"type\": \"string\" },\n          \"InternalJob\": { \"type\": \"string\" },\n          \"Description\": { \"type\": \"string\" },\n          \"JobCode\": { \"type\": \"string\" },\n          \"ManagerLevel\": { \"type\": \"string\" },\n          \"PostingVisibility\": { \"type\": \"string\" },\n          \"JobShift\": { \"type\": \"string\" },\n          \"FullTimePartTime\": { \"type\": \"string\" }\n        },\n        \"required\": [\n          \"OpportunityId\",\n          \"OpportunityType\",\n          \"OpportunityNumber\",\n          \"Title\",\n          \"Location\",\n          \"PostedDate\",\n          \"RemoteOpportunityFlag\",\n          \"Organization\",\n          \"JobFunction\",\n          \"JobFamily\",\n          \"PrimaryWorkLocation\",\n          \"Recruiter\",\n          \"HiringManager\",\n          \"JobGrade\",\n          \"InternalJob\",\n          \"Description\",\n          \"JobCode\",\n          \"ManagerLevel\",\n          \"PostingVisibility\",\n          \"JobShift\",\n          \"FullTimePartTime\"\n        ]\n      }\n    },\n    \"count\": { \"type\": \"integer\" },\n    \"hasMore\": { \"type\": \"boolean\" },\n    \"limit\": { \"type\": \"integer\" },\n    \"offset\": { \"type\": \"integer\" },\n    \"totalResults\": { \"type\": \"integer\" }\n  },\n  \"required\": [\"items\", \"count\", \"hasMore\", \"limit\", \"offset\", \"totalResults\"]\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Collate Opportunities",
            "returnType": "array",
            "sourceCode": "const jobArr = $context.$nodes.COLLATEJOBS.$output || []; \nconst gigArr = $context.$nodes.COLLATEGIGS.$output || []; \n\nconst gigs = gigArr.map(gig => JSON.parse(gig).result );\n\nconst jobs = jobArr.map(job => JSON.parse(job).result);\n\nvar oppArr = [...gigs,...jobs];\n \nreturn oppArr ;"
          },
          "outcomes": {
            "success": "1764859176042"
          },
          "code": "COLLATE_OPPORTUNITIES",
          "convergenceTargetId": "end",
          "id": "1764859516775",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
