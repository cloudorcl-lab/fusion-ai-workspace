                    "name": "Extract Gig Details",
                    "returnType": "object",
                    "sourceCode": "const gigItems = $context.$nodes.COLLATEGIGS.GET_OM_GIG_DETAILS.$output || {};\n\n\nlet gig= {\n    GigId: gigItems.GigId,\n    GigNumber: gigItems.GigNumber,\n    Location: gigItems.Location,\n    DescriptionStr: gigItems.DescriptionStr,\n    Title: gigItems.Title,\n    PublishDate: gigItems.PublishDate,\n    BookmarkFlag: gigItems.BookmarkFlag,\n    HasAppliedFlag: gigItems.HasAppliedFlag,\n    GigValidFlag : gigItems.GigValidFlag,\n    Type: \"Gig\"\n};\n\nif (gig.HasAppliedFlag || gig.ValidFlag || gigItems.CreatorPersonId == $context.$variables.PersonId ){\n    gig = {};\n}\n\nreturn gig;"
                  },
