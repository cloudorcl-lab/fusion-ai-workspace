        {
          "metadata": {
            "name": "Parse & Prepare CI Payload (1B)",
            "returnType": "string",
            "sourceCode": "// Parse the input message\nconst inputMessage = JSON.parse($context.$system.$inputMessage);\n\n// Get the attribute values\nconst extractedBusinessUnitId = inputMessage.BusinessUnitId;\nconst extractedIntentCode = inputMessage.IntentCode;\nconst extractedContractTypeId = inputMessage.ContractTypeId;\nconst extractedPartyId = inputMessage.PartyId;\nconst extractedThirdPartyClause = inputMessage.ThirdPartyClause;\n\n// Create the inner payload as a JS object\n\nconst payload = {\n  additionalFilters: [\n    {\n      fieldName: \"contentTypeAttributes.ORA_CX_SALES_CONTRACT.BUSINESS_UNIT_ID\",\n      value: extractedBusinessUnitId,\n      operator: \"eq\"\n    },\n    {\n      fieldName: \"contentTypeAttributes.ORA_CX_SALES_CONTRACT.INTENT_CODE\",\n      value: extractedIntentCode,\n      operator: \"eq\"\n    },\n    {\n      fieldName: \"contentTypeAttributes.ORA_CX_SALES_CONTRACT.CONTRACT_TYPE_ID\",\n      value: extractedContractTypeId,\n      operator: \"eq\"\n    },\n    {\n      fieldName: \"contentTypeAttributes.ORA_CX_SALES_CONTRACT.STATUS_CODE\",\n      value: \"ACTIVE\",\n      operator: \"eq\"\n    },\n    {\n      fieldName: \"contentTypeAttributes.ORA_CX_SALES_CONTRACT.PRIMARY_PARTY_ID\",\n      value: extractedPartyId,\n      operator: \"eq\"\n    }\n  ],\n  question: extractedThirdPartyClause,\n  extractFiltersFromQuestion: false\n};\n\nconst output = JSON.stringify(payload);\n\nreturn output;"
          },
          "outcomes": {
            "success": "1771571529816"
          },
          "code": "PARSE_PREPARE_CI_PAYLOAD_1B",
          "id": "1771571383422",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
