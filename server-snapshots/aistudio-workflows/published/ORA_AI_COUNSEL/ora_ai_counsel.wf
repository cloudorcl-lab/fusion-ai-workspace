          "metadata": {
            "name": "Parse & Prepare CI Payload (1A)",
            "returnType": "string",
            "sourceCode": "// Parse the input message\nconst inputMessage = JSON.parse($context.$system.$inputMessage);\n\n// Get the attribute values\nconst extractedClauseVersionId = inputMessage.ClauseVersionId;\nconst extractedThirdPartyClause = inputMessage.ThirdPartyClause;\n\n// Create the inner payload as a JS object\n\nconst payload = {\n  additionalFilters: [\n    {\n      fieldName: \"contentTypeAttributes.ORA_CX_SALES_CLAUSE.CLAUSE_VERSION_ID\",\n      value: extractedClauseVersionId,\n      operator: \"eq\"\n    }\n  ],\n  question: extractedThirdPartyClause,\n  extractFiltersFromQuestion: false\n};\n\nconst output = JSON.stringify(payload);\n\nreturn output;"
          },
          "outcomes": {
            "success": "1771572790350"
          },
          "code": "PARSE_PREPARE_CI_PAYLOAD_1A",
          "id": "1771572746361",
          "inputs": [],
