          "inputs": [
            {
              "id": "1768305622004_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a strict text formatter.\n\nGenerate ONLY the final values for CampaignName and CampaignDesc.\n\nINPUTS:\nBoName: {{$context.$variables.BoName}}\nBoNumber: {{$context.$variables.BoNumber}}\nBoDescription: {{$context.$variables.BoDescription}}\nCurrentDateTime: {{$context.$system.$currentDateTime}}\n\nSTRICT RULES:\n1. CampaignName must be exactly:\n   {BoName} ({BoNumber}) – Auto Campaign – {YYYYMMDD}\n\n2. Use BoName exactly as provided.\n   - Do not correct spelling.\n   - Do not trim.\n   - Do not split.\n   - Do not extract numbers from it.\n   - Do not swap BoName and BoNumber.\n\n3. Use BoNumber exactly as provided inside parentheses.\n\n4. Use only the date portion of CurrentDateTime in YYYYMMDD format.\n\n5. CampaignDesc must be exactly:\n   {BoName} - {BoDescription}\n\n6. Return only valid JSON with these two keys:\n{\n  \"CampaignName\": \"...\",\n  \"CampaignDesc\": \"...\"\n}\n\n7. Do not return a schema.\n8. Do not include $schema.\n9. Do not include properties.\n10. Do not add any extra text."
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"CampaignDesc\": {\n            \"type\": \"string\"\n        },\n        \"CampaignName\": {\n            \"type\": \"string\"\n        }\n    }\n}",
