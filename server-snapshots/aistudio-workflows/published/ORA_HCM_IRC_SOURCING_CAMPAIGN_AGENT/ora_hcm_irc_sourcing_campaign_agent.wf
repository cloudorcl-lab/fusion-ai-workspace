": \"string\"\n        },\n        \"BoDescription\": {\n          \"type\": \"string\"\n        },\n        \"BoContext\": {\n          \"type\": \"string\"\n        }\n      },\n      \"additionalProperties\": false\n    },\n    \"messageContent\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"isSourcerNotification\": {\n          \"type\": \"boolean\"\n        },\n        \"subject\": {\n          \"type\": \"string\"\n        },\n        \"body\": {\n          \"type\": \"string\"\n        },\n        \"mode\": {\n          \"type\": \"string\",\n          \"enum\": [\"EMAIL\"]\n        }\n      },\n      \"additionalProperties\": false\n    }\n  },\n  \"additionalProperties\": false\n}"
