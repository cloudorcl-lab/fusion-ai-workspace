            "name": "CREATE CAMPAIGN NAME",
            "returnType": "string",
            "sourceCode": "var campaignName = $context.$variables.CampaignName;\nvar boNumber = $context.$variables.BoNumber;\nvar dateTime = $context.$system.$currentDateTime;\n\n/* Remove fractional seconds */\ndateTime = dateTime.split(\".\")[0];\n\n/* Take only date part */\nvar datePart = dateTime.split(\"T\")[0];\n\n/* Remove hyphens */\ndatePart = datePart.replace(/-/g, \"\");\n\n/* Build final string */\nvar result = campaignName + \"  (\" + boNumber + \" )  – Auto Campaign – \" + datePart;\n\nreturn result;"
          },
          "outcomes": {
            "success": "1768307203541"
          },
          "code": "CREATE_CAMPAIGN_NAME",
          "id": "1768307166975",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "SET CAMPAIGN NAME"
          },
          "outcomes": {
            "success": "1772101242300"
          },
          "code": "SET_CAMPAIGN_NAME",
          "id": "1768307203541",
          "inputs": [
            {
              "id": "1768307212183",
              "name": "CampaignName",
              "type": "string",
              "value": "{{$context.$nodes.CREATE_CAMPAIGN_NAME.$output.result}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "CREATE CAMPAIGN BASIC INFO",
            "returnType": "object",
            "sourceCode": "var campaignDescription = $context.$variables.CampaignDescription;\nvar campaignName = $context.$variables.CampaignName;\nvar boNumber = $context.$variables.BoNumber;\nvar dateTime = $context.$system.$currentDateTime;\n\n/* Remove fractional seconds */\ndateTime = dateTime.split(\".\")[0];\n\n/* Take only date part */\nvar datePart = dateTime.split(\"T\")[0];\n\n/* Remove hyphens */\ndatePart = datePart.replace(/-/g, \"\");\n\nvar genCampaignName = campaignName + \"  (\" + boNumber + \" )  – Auto Campaign – \" + datePart; \n\nvar result = {\n  CampaignDescription: campaignDescription == null ? $context.$nodes.GENERATE_CAMPAIGN_BASIC_INFO.$output.CampaignDesc : campaignDescription,\n  CampaignName: campaignName == null ? $context.$nodes.GENERATE_CAMPAIGN_BASIC_INFO.$output.CampaignName : genCampaignName \n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1768306103824"
          },
          "code": "CREATE_CAMPAIGN_BASIC_INFO",
          "id": "1768309055867",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Work Result",
            "returnType": "object",
            "sourceCode": "const result =  {\n  \"result\": {\n    status: \"SUCCESS\",\n    statusCode: \"CAMPAIGN_CREATION_SUCCESSFUL\",\n    statusMessage: \"Campaign created successfully\"\n  },\n  \"output\": {\n    CampaignId: $context.$variables.CampaignId,\n    CampaignName: $context.$variables.CampaignName,\n    CampaignCode: $context.$variables.CampaignCode,\n    CampaignLink: \"https://cptbzrsqy.fusionapps.ocs.oc-test.com/fscmUI/redwood/recruiting-sourcing/?selectedTab=campaigns\",\n    candidateCount: $context.$variables.CandidateCount,\n    notificationSent: $context.$variables.IsSourcerNotification\n  },\n  \"executionDetails\": {\n    agentName: $context.$workflow.$name,\n    flowInstanceId: $context.$workflow.$traceId,\n    completionTimestamp: $context.$system.$currentDateTime\n  }\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "WORK_RESULT",
          "id": "1769047505378",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
