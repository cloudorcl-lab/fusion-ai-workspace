              "type": "string",
              "value": "You are an email agent and need to create subject for marketing an job requisition. \n\nJob Requisition Title: {{$context.$variables.BoName}}\nJob Requisition Description: {{$context.$variables.BoDescription}}\n\n\nInstructions: \n1) Use Requisition Details to come up with a email subject and return. \n2) Subject Should not exceed 80 chars"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"emailSubject\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
