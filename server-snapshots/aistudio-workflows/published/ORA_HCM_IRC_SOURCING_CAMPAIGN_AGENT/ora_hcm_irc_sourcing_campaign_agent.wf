        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_RECRUITING_SARECRUITINGMESSAGEDESIGNS",
            "functionName": "Fetch_List_of_Templates",
            "name": "Fetch All Template Details"
          },
          "outcomes": {
            "success": "1767870949137"
          },
          "code": "FETCH_ALL_TEMPLATE_DETAILS",
          "convergenceTargetId": "1767855953542",
          "id": "1767870828491",
          "inputs": [],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"items\": {\n            \"type\": \"object\",\n            \"properties\": {}\n        },\n        \"MessageDesignId\": {\n            \"type\": \"number\"\n        },\n        \"DesignTypeCode\": {\n            \"type\": \"string\"\n        },\n        \"DesignName\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Fetch Template Message DesignId",
            "returnType": "number",
            "sourceCode": "const templateData = $context.$nodes.FETCH_ALL_TEMPLATE_DETAILS.$output.items ;\nconst refinedTemplateData = templateData.map(item => ({\n      DesignName: item.DesignName,\n      MessageDesignId: item.MessageDesignId\n    }));\n\n// fetching Input\nconst templateDesignName = $context.$variables.EmailDesignTemplateName;\n\nlet selectedMessageDesignId = null;\n\n//  Try to match input DesignName (only if input is provided)\nif (templateDesignName) {\n  const matchedTemplate = refinedTemplateData.find(\n    item => item.DesignName === templateDesignName\n  );\n  if (matchedTemplate) {\n    selectedMessageDesignId = matchedTemplate.MessageDesignId;\n  }\n}\n\n//  Fallback to BASIC if input is null OR no match found\nif (!selectedMessageDesignId) {\n  const basicTemplate = refinedTemplateData.find(\n    item => item.DesignName === 'Basic'\n  );\n  if (basicTemplate) {\n    selectedMessageDesignId = basicTemplate.MessageDesignId;\n  }\n}\n\nreturn selectedMessageDesignId;"
          },
          "outcomes": {
            "success": "1767855953542"
          },
          "code": "FETCH_TEMPLATE_MESSAGE_DESIGNID",
          "convergenceTargetId": "1767855953542",
          "id": "1767870949137",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_RECRUITING_SARECRUITINGMESSAGEDESIGNS",
            "functionName": "getMessageMetaDataUsingMessageId",
            "name": "Get Message Meta From Template"
          },
          "outcomes": {
            "success": "1768275859912"
          },
          "code": "GET_MESSAGE_META_FROM_TEMPLATE",
          "id": "1767855953542",
          "inputs": [
            {
              "id": "1767997851537_1",
              "name": "recruitingMessageDesigns_id",
              "type": "string",
              "value": "{{$context.$nodes.FETCH_TEMPLATE_MESSAGE_DESIGNID.$output.result}}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"DesignMetaDataString\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Fetch Instruction Token",
            "returnType": "object",
            "sourceCode": "var templateMetaData =\n  $context.$nodes.GET_MESSAGE_META_FROM_TEMPLATE.$output.DesignMetaDataString;\n\n/* Ensure JSON object */\nif (typeof templateMetaData === \"string\") {\n  templateMetaData = JSON.parse(templateMetaData);\n}\n\nvar tokenRegex = /\\[\\[(.*?)\\]\\]/g;\n\n/* Array-based instruction map */\nvar instructionMap = { tokens: [] };\n\n/* Helper index map to avoid duplicates */\nvar tokenIndex = {};\n\n/* Manual stack for traversal */\nvar stack = [{ node: templateMetaData, path: \"\" }];\n\nwhile (stack.length > 0) {\n  var current = stack.pop();\n  var node = current.node;\n  var path = current.path;\n\n  if (Array.isArray(node)) {\n    for (var i = 0; i < node.length; i++) {\n      stack.push({\n        node: node[i],\n        path: path + \"[\" + i + \"]\"\n      });\n    }\n    continue;\n  }\n\n  if (node && typeof node === \"object\") {\n    for (var key in node) {\n      var value = node[key];\n      var currentPath = path ? path + \".\" + key : key;\n\n      if (typeof value === \"string\") {\n        tokenRegex.lastIndex = 0;\n        var match;\n\n        while ((match = tokenRegex.exec(value)) !== null) {\n          var tokenName = match[1].trim();\n\n          /* Create token entry once */\n          if (tokenIndex[tokenName] === undefined) {\n            tokenIndex[tokenName] = instructionMap.tokens.length;\n            instructionMap.tokens.push({\n              token: tokenName,\n              value: \"\",\n              occurrences: []\n            });\n          }\n\n          instructionMap.tokens[tokenIndex[tokenName]].occurrences.push({\n            path: currentPath,\n            originalText: value\n          });\n        }\n      } else {\n        stack.push({\n          node: value,\n          path: currentPath\n        });\n      }\n    }\n  }\n}\n\ninstructionMap;"
          },
          "outcomes": {
            "success": "1768275920091"
          },
          "code": "FETCH_INSTRUCTION_TOKEN",
          "id": "1768275859912",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Generate Token Data Map"
          },
          "outcomes": {
            "success": "1768276101315"
          },
          "code": "GENERATE_TOKEN_DATA_MAP",
          "id": "1768275920091",
          "inputs": [
            {
              "id": "1768275920093_1",
              "name": "prompt",
              "type": "string",
              "value": "{{$context.$nodes.FETCH_INSTRUCTION_TOKEN.$output.result}} \nAbove is a instruction list : result.tokens.token\n\nInput Data:\nJob Title: {{$context.$variables.BoName}}\nJob Description: {{$context.$variables.BoDescription}} \nJob Location: {{$context.$variables.BoLocation}}\nJob Requisition Number: {{$context.$variables.BoNumber}}\n\n\n\nRules:\n- Generate content independently for each instruction token.\n- Use Job Data ONLY if the instruction logically requires job information.\n- Do NOT invent salary, compensation, benefits, or company policies unless explicitly asked.\n- If an instruction is irrelevant to a job requisition, generate meaningful, professional, or role-aligned information instead of stating Not applicable.\n- Avoid duplication of information across tokens unless explicitly required by the instruction.\n- Maintain consistency across all generated values.\n- Max 1000 characters total across all generated token values, unless a specific instruction demands a different limit.\n- No line breaks.\n- No quotes, brackets, HTML, emojis, or special characters.\n- Use professional, concise language suitable for recruitment communication.\n- If token Name has PREFIX -\"TOKEN\" do not generate value for it , use the input to replace the value . ex : [[Requisition_Number_TOKEN]] needs to be replace by {{$context.$variables.BoNumber}}.\n\nOutput Format (STRICT):\n- Return the {{$context.$nodes.FETCH_INSTRUCTION_TOKEN.$output.result}} result.tokens.value for the respected result.tokens.token with updated value so that all values remain in sync no duplicate information provided unless explicitly demanded in instruction.\nFor each token:\n- Keep token and occurrences values unchanged  and always keep it in final result.\n- Populate only the value field with generated text.\n- Do not add, remove, or reorder tokens."
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"TokenMap\": {\n            \"type\": \"object\",\n            \"properties\": {}\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Replacing The Token Map",
            "returnType": "object",
            "sourceCode": "var templateMetaData = JSON.parse(\n  $context.$nodes.GET_MESSAGE_META_FROM_TEMPLATE.$output.DesignMetaDataString\n);\n\n/* Safely resolve generatedTokens */\nvar generatedTokens =\n  $context.$nodes?.GENERATE_TOKEN_DATA_MAP?.$output?.TokenMap?.tokens;\n \nif (!Array.isArray(generatedTokens) || generatedTokens.length === 0) {\n  return templateMetaData;\n}\n\nvar pathRegex = /([^\\.\\[\\]]+)|\\[(\\d+)\\]/g;\n\n/* Iterate over generated tokens */\nfor (var t = 0; t < generatedTokens.length; t++) {\n  var tokenObj = generatedTokens[t];\n  var tokenName = tokenObj.token;\n  var tokenValue = tokenObj.value || \"\";\n\n  for (var o = 0; o < tokenObj.occurrences.length; o++) {\n    var path = tokenObj.occurrences[o].path;\n\n    var current = templateMetaData;\n    var match;\n    pathRegex.lastIndex = 0;\n\n    var pathParts = [];\n    while ((match = pathRegex.exec(path)) !== null) {\n      pathParts.push(\n        match[1] !== undefined ? match[1] : Number(match[2])\n      );\n    }\n\n    /* Traverse to parent */\n    for (var i = 0; i < pathParts.length - 1; i++) {\n      if (current[pathParts[i]] === undefined) {\n        current = null;\n        break;\n      }\n      current = current[pathParts[i]];\n    }\n\n    if (!current) continue;\n\n    var lastKey = pathParts[pathParts.length - 1];\n    var textValue = current[lastKey];\n\n    if (typeof textValue !== \"string\") continue;\n\n    /* Safe token replacement */\n    var safeToken = tokenName.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n    var tokenPattern = new RegExp(\"\\\\[\\\\[\" + safeToken + \"\\\\]\\\\]\", \"g\");\n\n    current[lastKey] = textValue.replace(tokenPattern, tokenValue);\n  }\n}\n\nreturn templateMetaData;"
          },
          "outcomes": {
            "success": "1767695970185"
          },
          "code": "REPLACING_THE_TOKEN_MAP",
          "id": "1768276101315",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
