            "sourceCode": "// Input array\nconst input = $context.$nodes.GETCAMPAIGNTEAMWORKEREMAILSLOOP.$output \n\n\n// Extract unique emails\nconst uniqueEmails = [\n  ...new Set(\n    input.map(str => JSON.parse(str).result).filter(email => !!email)\n  )\n];\n\n// Convert to comma-separated string\nconst emailList = uniqueEmails.join(\",\");\n\nreturn emailList;"
