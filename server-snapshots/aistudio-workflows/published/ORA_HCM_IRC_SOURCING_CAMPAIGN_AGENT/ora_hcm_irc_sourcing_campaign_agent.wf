            "returnType": "string",
            "sourceCode": "const data =\n  $context.$nodes.CREATE_CAMPAIGN_WITH_BASIC_INFO?.$output?.assetDetails?.links?.[0]?.href\n  ??\n  $context.$nodes.CREATE_CAMPAIGN_WITH_BASIC_INFO_AND_CAMPAIGN_CODE?.$output?.assetDetails?.links?.[0]?.href;\nconst matches = data.match(/^(https?:\\/\\/[^\\/:]+(?:\\.[^\\/:]+)*)(?::\\d+)?/);\nconst hostName = matches ? matches[1] : null;\nreturn hostName;"
          },
