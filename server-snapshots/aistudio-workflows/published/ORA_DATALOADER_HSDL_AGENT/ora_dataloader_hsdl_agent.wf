            "sourceCode": "let doc = $context.$variables.documentationAgentOutput;\n\nlet fileContentsInvalid =\n  doc == null ||\n  doc.fileContents == null ||\n( ( doc.fileContents== null || doc.fileContents.length == 0) && (doc.fileContents.records == null ||\n  doc.fileContents.records.length == 0 )  && (doc.fileContents.jobs== null ||\n  doc.fileContents.jobs.length == 0))\n  ;\n\nreturn fileContentsInvalid;"
          },
