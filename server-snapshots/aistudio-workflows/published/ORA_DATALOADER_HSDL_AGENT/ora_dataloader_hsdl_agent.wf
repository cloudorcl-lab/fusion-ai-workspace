        {
          "metadata": {
            "name": "Get the decoded spreadsheet template CSV",
            "returnType": "object",
            "sourceCode": "// Decode Base64 (example)\nlet base64Text = String( $context.$variables.base64CSVData.result || \"\");\n\n// Remove surrounding quotes\nif ((base64Text.startsWith('\"') && base64Text.endsWith('\"')) ||\n    (base64Text.startsWith(\"'\") && base64Text.endsWith(\"'\"))) {\n  base64Text = base64Text.slice(1, -1);\n}\n\n// Strip all whitespace\nbase64Text = base64Text.replace(/[\\s\\r\\n\\t]+/g, \"\");\n\n// Normalize padding\nconst mod = base64Text.length % 4;\nif (mod !== 0) {\n  base64Text += \"=\".repeat(4 - mod);\n}\n\n// Decode Base64\nlet decodedCSV = atob(base64Text);\n\n// Return as a single object property\nreturn { result: decodedCSV };"
          },
          "outcomes": {
            "success": "1771302661747"
          },
          "diagram": {
            "x": 5678,
            "y": 12088
          },
          "code": "GET_THE_DECODED_SPREADSHEET_TEMPLATE_CSV",
          "id": "1771302548388",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
