        {
          "metadata": {
            "name": "Extract FSCM URL",
            "description": "Extract and normalize the FSCM base URL from configuration parameters.",
            "sourceCode": "function stringifyValue(value) {\n  if (value == null) {\n    return '';\n  }\n\n  if (typeof value === 'string') {\n    return value;\n  }\n\n  if (typeof value === 'number' || typeof value === 'boolean') {\n    return String(value);\n  }\n\n  try {\n    return JSON.stringify(value);\n  } catch (e) {\n    return String(value);\n  }\n}\n\nfunction firstValue(source, keys) {\n  if (source == null || typeof source !== 'object') {\n    return '';\n  }\n\n  for (var i = 0; i < keys.length; i++) {\n    var key = keys[i];\n\n    if (source[key] != null && source[key] !== '') {\n      return stringifyValue(source[key]);\n    }\n  }\n\n  return '';\n}\n\nfunction normalizeBaseUrl(url) {\n  var normalized = stringifyValue(url).trim();\n\n  if (!normalized) {\n    return '';\n  }\n\n  normalized = normalized.replace(/\\/+$/g, '');\n  normalized = normalized.replace(/\\/fscmui$/i, '');\n\n  return normalized;\n}\n\nvar fscmOutput = $context.$nodes.GET_THE_FSCM_URL\n  ? $context.$nodes.GET_THE_FSCM_URL.$output\n  : {};\nvar config = fscmOutput && fscmOutput.result != null ? fscmOutput.result : fscmOutput;\nvar rawFscmUrl = firstValue(config, ['FscmURL', 'FscmUrl', 'fscmURL', 'fscmUrl']);\nvar hcmUrl = firstValue(config, ['HcmURL', 'HcmUrl', 'hcmURL', 'hcmUrl']);\n\nvar result = {\n  FscmUrl: normalizeBaseUrl(rawFscmUrl),\n  rawFscmUrl: rawFscmUrl,\n  HcmUrl: hcmUrl\n};\n\nreturn result;",
            "returnType": "object"
          },
          "outcomes": {
            "success": "1771304723678"
          },
          "diagram": {
            "x": 5288,
            "y": 15196
          },
