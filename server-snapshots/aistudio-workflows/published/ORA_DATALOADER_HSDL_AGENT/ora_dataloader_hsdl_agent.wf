          "code": "BUSINESS_OBJECT_IDENTIFICATION",
          "id": "1773910334363",
          "inputs": [
            {
              "id": "1773910334366_1",
              "name": "prompt",
              "type": "string",
              "value": "From the RAG tool output below, extract the Business Object name exactly as written.\n\nRAG Output:\n{{$context.$nodes.BUSINESS_OBJECT_ATTRIBUTES_RAG.$output.value}}\n\nTranslation Flag:\n{{$context.$nodes.IDENTIFY_IF_TRANSLATION_OBJECTS.$output.result}}\n\nRules:\n- Return the Business Object name exactly as it appears in the output.\n- Do NOT modify, shorten, normalize, or infer the name.\n- Do NOT extract partial words.\n- Trim leading and trailing spaces.\n- Remove any trailing punctuation characters such as ., ,, ;, or :.\n- Do NOT include any extra spaces or special characters.\n- If the value is \"DepartmentTreeVersion\", return exactly \"DepartmentTreeVersion\".\n- If {{$context.$nodes.IDENTIFY_IF_TRANSLATION_OBJECTS.$output.result}} is true, append \"Translation\" to the extracted Business Object name.\n\nExamples:\n- RAG Output: Department, {{$context.$nodes.IDENTIFY_IF_TRANSLATION_OBJECTS.$output.result}}=false → Department\n- RAG Output: Department, {{$context.$nodes.IDENTIFY_IF_TRANSLATION_OBJECTS.$output.result}}=true → DepartmentTranslation\n- RAG Output: Job, {{$context.$nodes.IDENTIFY_IF_TRANSLATION_OBJECTS.$output.result}}=true → JobTranslation\n\nOutput format:\nReturn only the Business Object name.\nNo extra words.\nNo explanation."
            }
          ],
          "type": "LLM"
        },
