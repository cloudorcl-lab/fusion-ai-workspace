          "metadata": {
            "name": "Normalize File Contents",
            "sourceCode": "function isPlainObject(value) {\n  return value != null && typeof value === 'object' && !Array.isArray(value);\n}\n\nfunction isDateHeader(header) {\n  var normalized = String(header || '').replace(/[^A-Za-z0-9]+/g, '').toLowerCase();\n  return normalized === 'dob' || normalized === 'dt' || normalized.indexOf('date') !== -1;\n}\n\nfunction escapeRegex(value) {\n  return String(value).replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n}\n\nfunction escapeJsonString(value) {\n  return String(value == null ? '' : value)\n    .replace(/\\\\/g, '\\\\\\\\')\n    .replace(/\"/g, '\\\\\"')\n    .replace(/\\t/g, '\\\\t')\n    .replace(/[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]/g, function(ch) {\n      return '\\\\u' + ('000' + ch.charCodeAt(0).toString(16)).slice(-4);\n    });\n}\n\nfunction normalizeJsonDateField(jsonText, header) {\n  var fieldPattern = escapeRegex('\"' + escapeJsonString(header) + '\":\"');\n  var months = [\n    ['jan(?:uary)?', '01'],\n    ['feb(?:ruary)?', '02'],\n    ['mar(?:ch)?', '03'],\n    ['apr(?:il)?', '04'],\n    ['may', '05'],\n    ['jun(?:e)?', '06'],\n    ['jul(?:y)?', '07'],\n    ['aug(?:ust)?', '08'],\n    ['sep(?:t(?:ember)?|tember)?', '09'],\n    ['oct(?:ober)?', '10'],\n    ['nov(?:ember)?', '11'],\n    ['dec(?:ember)?', '12']\n  ];\n\n  jsonText = jsonText.replace(new RegExp('(' + fieldPattern + ')(\\\\d{4})[-/](\\\\d{2})[-/](\\\\d{2})(\")', 'g'), '$1$2/$3/$4$5');\n  jsonText = jsonText.replace(new RegExp('(' + fieldPattern + ')(\\\\d{4})[-/](\\\\d{1})[-/](\\\\d{2})(\")', 'g'), '$1$2/0$3/$4$5');\n  jsonText = jsonText.replace(new RegExp('(' + fieldPattern + ')(\\\\d{4})[-/](\\\\d{2})[-/](\\\\d{1})(\")', 'g'), '$1$2/$3/0$4$5');\n  jsonText = jsonText.replace(new RegExp('(' + fieldPattern + ')(\\\\d{4})[-/](\\\\d{1})[-/](\\\\d{1})(\")', 'g'), '$1$2/0$3/0$4$5');\n\n  jsonText = jsonText.replace(new RegExp('(' + fieldPattern + ')(\\\\d{2})[-/](\\\\d{2})[-/](\\\\d{4})(\")', 'g'), '$1$4/$3/$2$5');\n  jsonText = jsonText.replace(new RegExp('(' + fieldPattern + ')(\\\\d{1})[-/](\\\\d{2})[-/](\\\\d{4})(\")', 'g'), '$1$4/$3/0$2$5');\n  jsonText = jsonText.replace(new RegExp('(' + fieldPattern + ')(\\\\d{2})[-/](\\\\d{1})[-/](\\\\d{4})(\")', 'g'), '$1$4/0$3/$2$5');\n  jsonText = jsonText.replace(new RegExp('(' + fieldPattern + ')(\\\\d{1})[-/](\\\\d{1})[-/](\\\\d{4})(\")', 'g'), '$1$4/0$3/0$2$5');\n\n  jsonText = jsonText.replace(new RegExp('(?<p>' + fieldPattern + ')(?<d>\\\\d{2})[-/](?<m>\\\\d{2})[-/](?<y>[5-9]\\\\d)(?<q>\")', 'g'), '$<p>19$<y>/$<m>/$<d>$<q>');\n  jsonText = jsonText.replace(new RegExp('(?<p>' + fieldPattern + ')(?<d>\\\\d{1})[-/](?<m>\\\\d{2})[-/](?<y>[5-9]\\\\d)(?<q>\")', 'g'), '$<p>19$<y>/$<m>/0$<d>$<q>');\n  jsonText = jsonText.replace(new RegExp('(?<p>' + fieldPattern + ')(?<d>\\\\d{2})[-/](?<m>\\\\d{1})[-/](?<y>[5-9]\\\\d)(?<q>\")', 'g'), '$<p>19$<y>/0$<m>/$<d>$<q>');\n  jsonText = jsonText.replace(new RegExp('(?<p>' + fieldPattern + ')(?<d>\\\\d{1})[-/](?<m>\\\\d{1})[-/](?<y>[5-9]\\\\d)(?<q>\")', 'g'), '$<p>19$<y>/0$<m>/0$<d>$<q>');\n\n  jsonText = jsonText.replace(new RegExp('(?<p>' + fieldPattern + ')(?<d>\\\\d{2})[-/](?<m>\\\\d{2})[-/](?<y>[0-4]\\\\d)(?<q>\")', 'g'), '$<p>20$<y>/$<m>/$<d>$<q>');\n  jsonText = jsonText.replace(new RegExp('(?<p>' + fieldPattern + ')(?<d>\\\\d{1})[-/](?<m>\\\\d{2})[-/](?<y>[0-4]\\\\d)(?<q>\")', 'g'), '$<p>20$<y>/$<m>/0$<d>$<q>');\n  jsonText = jsonText.replace(new RegExp('(?<p>' + fieldPattern + ')(?<d>\\\\d{2})[-/](?<m>\\\\d{1})[-/](?<y>[0-4]\\\\d)(?<q>\")', 'g'), '$<p>20$<y>/0$<m>/$<d>$<q>');\n  jsonText = jsonText.replace(new RegExp('(?<p>' + fieldPattern + ')(?<d>\\\\d{1})[-/](?<m>\\\\d{1})[-/](?<y>[0-4]\\\\d)(?<q>\")', 'g'), '$<p>20$<y>/0$<m>/0$<d>$<q>');\n\n  for (var i = 0; i < months.length; i++) {\n    var monthPattern = months[i][0];\n    var monthNumber = months[i][1];\n\n    jsonText = jsonText.replace(\n      new RegExp('(' + fieldPattern + ')(\\\\d{2})[-/ ]' + monthPattern + '[-/ ](\\\\d{4})(\")', 'gi'),\n      '$1$3/' + monthNumber + '/$2$4'\n    );\n    jsonText = jsonText.replace(\n      new RegExp('(' + fieldPattern + ')(\\\\d{1})[-/ ]' + monthPattern + '[-/ ](\\\\d{4})(\")', 'gi'),\n      '$1$3/' + monthNumber + '/0$2$4'\n    );\n    jsonText = jsonText.replace(\n      new RegExp('(?<p>' + fieldPattern + ')(?<d>\\\\d{2})[-/ ]' + monthPattern + '[-/ ](?<y>[5-9]\\\\d)(?<q>\")', 'gi'),\n      '$<p>19$<y>/' + monthNumber + '/$<d>$<q>'\n    );\n    jsonText = jsonText.replace(\n      new RegExp('(?<p>' + fieldPattern + ')(?<d>\\\\d{1})[-/ ]' + monthPattern + '[-/ ](?<y>[5-9]\\\\d)(?<q>\")', 'gi'),\n      '$<p>19$<y>/' + monthNumber + '/0$<d>$<q>'\n    );\n    jsonText = jsonText.replace(\n      new RegExp('(?<p>' + fieldPattern + ')(?<d>\\\\d{2})[-/ ]' + monthPattern + '[-/ ](?<y>[0-4]\\\\d)(?<q>\")', 'gi'),\n      '$<p>20$<y>/' + monthNumber + '/$<d>$<q>'\n    );\n    jsonText = jsonText.replace(\n      new RegExp('(?<p>' + fieldPattern + ')(?<d>\\\\d{1})[-/ ]' + monthPattern + '[-/ ](?<y>[0-4]\\\\d)(?<q>\")', 'gi'),\n      '$<p>20$<y>/' + monthNumber + '/0$<d>$<q>'\n    );\n  }\n\n  return jsonText;\n}\n\nvar parsed = $context.$nodes.FILE_CONTENT_PARSER.$output.result || {};\nvar rows = Array.isArray(parsed.fileContents) ? parsed.fileContents : [];\n\nvar result = {\n  templateCode: parsed.templateCode == null ? '' : String(parsed.templateCode),\n  businessObject: parsed.businessObject == null ? '' : String(parsed.businessObject),\n  fileContents: rows\n};\n\nvar output = result;\n\nif (rows.length > 0 && isPlainObject(rows[0])) {\n  var keys = Object.keys(rows[0]);\n  var dateHeaders = [];\n\n  for (var k = 0; k < keys.length; k++) {\n    if (isDateHeader(keys[k])) {\n      dateHeaders.push(keys[k]);\n    }\n  }\n\n  if (dateHeaders.length > 0) {\n    var jsonText = JSON.stringify(result);\n\n    for (var d = 0; d < dateHeaders.length; d++) {\n      jsonText = normalizeJsonDateField(jsonText, dateHeaders[d]);\n    }\n\n    try {\n      output = JSON.parse(jsonText);\n    } catch (e) {\n      output = result;\n    }\n  }\n}\n\nreturn output;",
