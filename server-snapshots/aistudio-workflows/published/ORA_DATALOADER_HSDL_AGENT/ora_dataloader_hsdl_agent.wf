        {
          "metadata": {
            "name": "Extract UCM Content ID",
            "description": "Extract UCM upload status, content id, and error message.",
            "sourceCode": "function stringifyValue(value) {\n  if (value == null) {\n    return '';\n  }\n\n  if (typeof value === 'string') {\n    return value;\n  }\n\n  if (typeof value === 'number' || typeof value === 'boolean') {\n    return String(value);\n  }\n\n  try {\n    return JSON.stringify(value);\n  } catch (e) {\n    return String(value);\n  }\n}\n\nfunction firstValue(source, keys) {\n  if (source == null || typeof source !== 'object') {\n    return '';\n  }\n\n  for (var i = 0; i < keys.length; i++) {\n    var key = keys[i];\n\n    if (source[key] != null && source[key] !== '') {\n      return stringifyValue(source[key]);\n    }\n  }\n\n  return '';\n}\n\nvar uploadOutput = $context.$nodes.UPLOAD_CSV_DATA_TO_UCM\n  ? $context.$nodes.UPLOAD_CSV_DATA_TO_UCM.$output\n  : {};\nvar uploadResult =\n  uploadOutput && uploadOutput.result != null ? uploadOutput.result : uploadOutput;\nvar rawUploadResult = uploadResult == null ? {} : uploadResult;\n\nvar status = firstValue(rawUploadResult, ['Status', 'status']);\nvar contentId = firstValue(rawUploadResult, [\n  'ContentId',\n  'contentId',\n  'contentID',\n  'content_id',\n  'InputFileContentId',\n  'DocumentId',\n  'documentId'\n]);\nvar errorMessage = firstValue(rawUploadResult, [\n  'UserInfo',\n  'Message',\n  'ErrorMessage',\n  'errorMessage',\n  'Error',\n  'error',\n  'Detail',\n  'details',\n  'StatusMessage',\n  'statusMessage'\n]);\n\nif (!errorMessage && status && status !== 'SUCCESS') {\n  errorMessage = 'Upload status: ' + status;\n}\n\nif (!errorMessage && status !== 'SUCCESS') {\n  errorMessage = stringifyValue(rawUploadResult);\n}\n\nvar result = {\n  Status: status,\n  ContentId: contentId,\n  errorMessage: errorMessage,\n  rawUploadResult: rawUploadResult\n};\n\nreturn result;",
