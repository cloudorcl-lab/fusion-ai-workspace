          "id": "1775462473339",
          "inputs": [
            {
              "id": "1775462473342_1",
              "name": "question",
              "type": "string",
              "value": "{{ \"Get the most suitable answers as bullet points for the user question \"  + $context.$system.$inputMessage }}"
