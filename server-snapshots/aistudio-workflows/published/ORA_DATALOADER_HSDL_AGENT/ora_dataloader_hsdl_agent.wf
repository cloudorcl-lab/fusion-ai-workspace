          "metadata": {
            "name": "Prepare Fuzzy Match Inputs",
            "returnType": "object",
            "sourceCode": "function parseMaybeJson(value) {\n  if (typeof value !== 'string') {\n    return value;\n  }\n  const trimmed = value.trim();\n  if (!trimmed) {\n    return value;\n  }\n  try {\n    return JSON.parse(trimmed);\n  } catch (e) {\n    return value;\n  }\n}\n\nfunction unwrapRows(value) {\n  const parsed = parseMaybeJson(value);\n  if (Array.isArray(parsed)) {\n    return parsed;\n  }\n  if (parsed && typeof parsed === 'object') {\n    const keys = ['data', 'records', 'jobs', 'rows', 'items', 'result', 'value'];\n    for (let i = 0; i < keys.length; i++) {\n      const key = keys[i];\n      if (parsed[key] != null) {\n        const rows = unwrapRows(parsed[key]);\n        if (Array.isArray(rows)) {\n          return rows;\n        }\n      }\n    }\n    return [parsed];\n  }\n  return [];\n}\n\nfunction firstCsvRecord(csvText) {\n  const csv = String(csvText || '');\n  const fields = [];\n  let field = '';\n  let inQuotes = false;\n\n  for (let i = 0; i < csv.length; i++) {\n    const ch = csv.charAt(i);\n    if (ch === '\"') {\n      if (inQuotes && csv.charAt(i + 1) === '\"') {\n        field += '\"';\n        i++;\n      } else {\n        inQuotes = !inQuotes;\n      }\n    } else if (ch === ',' && !inQuotes) {\n      fields.push(field);\n      field = '';\n    } else if ((ch === '\\n' || ch === '\\r') && !inQuotes) {\n      fields.push(field);\n      return fields;\n    } else {\n      field += ch;\n    }\n  }\n\n  fields.push(field);\n  return fields;\n}\n\nfunction extractString(value) {\n  const parsed = parseMaybeJson(value);\n  if (typeof parsed === 'string') {\n    return parsed;\n  }\n  if (parsed && typeof parsed === 'object') {\n    const keys = ['result', 'value', 'csv', 'data', 'content'];\n    for (let i = 0; i < keys.length; i++) {\n      const key = keys[i];\n      if (parsed[key] != null) {\n        const nested = extractString(parsed[key]);\n        if (typeof nested === 'string') {\n          return nested;\n        }\n      }\n    }\n  }\n  return String(value || '');\n}\n\nconst doc = $context.$variables.documentationAgentOutput || {};\nconst rows = unwrapRows(doc.fileContents).filter(function(row) {\n  return row && typeof row === 'object' && !Array.isArray(row);\n});\n\nconst sourceHeaders = rows.length > 0 ? Object.keys(rows[0]) : [];\n\nconst decodedTemplateOutput = $context.$nodes.GET_THE_DECODED_SPREADSHEET_TEMPLATE_CSV.$output.result;\nconst targetCSV = extractString(decodedTemplateOutput);\nconst targetHeaders = firstCsvRecord(targetCSV);\n\nreturn {\n  rows: rows,\n  sourceHeaders: sourceHeaders,\n  targetHeaders: targetHeaders\n};"
          },
          "outcomes": {
            "success": "1771302701325"
          },
          "diagram": {
            "x": 5738,
            "y": 12532
          },
          "code": "PREPARE_FUZZY_MATCH_INPUTS",
          "id": "1779446654711",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Generate Matched CSV Data",
            "returnType": "string",
            "sourceCode": "function parseMaybeJson(value) {\n  if (typeof value !== 'string') {\n    return value;\n  }\n\n  var trimmed = value.trim();\n  if (trimmed.indexOf('```') === 0) {\n    trimmed = trimmed.replace(/^```[a-zA-Z]*\\s*/, '').replace(/```$/, '').trim();\n  }\n\n  if (!trimmed) {\n    return value;\n  }\n\n  try {\n    return JSON.parse(trimmed);\n  } catch (e) {\n    return value;\n  }\n}\n\nfunction escapeRegex(value) {\n  return String(value).replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n}\n\nfunction resolveSourceHeader(value, exactSource, lowerSource) {\n  if (value == null || value === '') {\n    return null;\n  }\n\n  var candidate = String(value);\n  if (exactSource[candidate] != null) {\n    return exactSource[candidate];\n  }\n\n  return lowerSource[candidate.toLowerCase()] || null;\n}\n\nvar prepared = $context.$nodes.PREPARE_FUZZY_MATCH_INPUTS.$output.result || {};\nvar rows = Array.isArray(prepared.rows) ? prepared.rows : [];\nvar targetHeaders = Array.isArray(prepared.targetHeaders) ? prepared.targetHeaders : [];\nvar sourceHeaders =\n  Array.isArray(prepared.sourceHeaders) && prepared.sourceHeaders.length > 0\n    ? prepared.sourceHeaders\n    : rows.length > 0 && rows[0] && typeof rows[0] === 'object' && !Array.isArray(rows[0])\n      ? Object.keys(rows[0])\n      : [];\n\nvar headerLine = targetHeaders.join(',');\nif (rows.length === 0) {\n  return headerLine;\n}\n\nif (sourceHeaders.length === 0) {\n  throw new Error('Cannot generate matched CSV because source headers are empty.');\n}\n\nvar exactSource = {};\nvar lowerSource = {};\nvar sourceGroupByHeader = {};\nvar rowFieldPatterns = [];\n\nfor (var i = 0; i < sourceHeaders.length; i++) {\n  var sourceHeader = String(sourceHeaders[i]);\n  var groupName = 'c' + i;\n\n  exactSource[sourceHeader] = sourceHeader;\n  if (lowerSource[sourceHeader.toLowerCase()] == null) {\n    lowerSource[sourceHeader.toLowerCase()] = sourceHeader;\n  }\n\n  sourceGroupByHeader[sourceHeader] = groupName;\n  rowFieldPatterns.push(\n    escapeRegex(JSON.stringify(sourceHeader)) +\n      ':\"(?<' +\n      groupName +\n      '>(?:[^\"\\\\\\\\]|\\\\\\\\.)*)\"'\n  );\n}\n\nvar targetIndexByHeader = {};\nfor (var t = 0; t < targetHeaders.length; t++) {\n  if (targetIndexByHeader[targetHeaders[t]] == null) {\n    targetIndexByHeader[targetHeaders[t]] = t;\n  }\n}\n\nvar llmOutput = parseMaybeJson($context.$nodes.FUZZY_MATCH_CSV_DATA.$output);\nif (llmOutput && typeof llmOutput === 'object' && llmOutput.result != null) {\n  llmOutput = parseMaybeJson(llmOutput.result);\n}\n\nvar mappings = llmOutput && Array.isArray(llmOutput.mappings) ? llmOutput.mappings : [];\nvar rowCells = new Array(targetHeaders.length);\nfor (var b = 0; b < rowCells.length; b++) {\n  rowCells[b] = '';\n}\n\nfor (var m = 0; m < mappings.length; m++) {\n  var mapping = mappings[m] || {};\n  var targetIndex = targetIndexByHeader[mapping.targetHeader];\n\n  if (targetIndex == null || rowCells[targetIndex] !== '') {\n    continue;\n  }\n\n  var mappedSourceHeader = resolveSourceHeader(mapping.sourceHeader, exactSource, lowerSource);\n  if (mappedSourceHeader != null && sourceGroupByHeader[mappedSourceHeader] != null) {\n    rowCells[targetIndex] = '$<' + sourceGroupByHeader[mappedSourceHeader] + '>';\n  }\n}\n\nvar rowReplacement = rowCells.join(',');\nvar bodyJson = JSON.stringify(rows).slice(1, -1);\nif (!bodyJson) {\n  return headerLine;\n}\n\nvar rowRegex = new RegExp('\\\\{' + rowFieldPatterns.join(',') + '\\\\},?', 'g');\nvar csvBody = bodyJson.replace(rowRegex, rowReplacement + '\\n');\n\nif (csvBody === bodyJson || csvBody.indexOf('{') !== -1 || csvBody.indexOf('}') !== -1) {\n  throw new Error(\n    'Cannot bulk-generate matched CSV because parsed row objects do not match the expected simple uniform string-row shape.'\n  );\n}\n\ncsvBody = csvBody.replace(/\\n$/g, '');\n\nreturn headerLine + (csvBody ? '\\n' + csvBody : '');"
          },
          "outcomes": {
            "success": "1771303629549"
          },
          "diagram": {
            "x": 5738,
            "y": 12976
          },
          "code": "GENERATE_MATCHED_CSV_DATA",
          "id": "1779446976559",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "File Content Parser",
            "description": "Parse data-loader input into templateCode, businessObject, and fileContents.",
            "returnType": "object",
            "sourceCode": "var MAX_COLS = 250;\nvar MAX_MESSAGE_CHARS = 5000;\nvar MAX_JSON_PARSE_CHARS = 50000000;\n\nfunction isPlainObject(value) {\n  return value != null && typeof value === 'object' && !Array.isArray(value);\n}\n\nfunction parseMaybeJson(value) {\n  if (typeof value !== 'string') {\n    return value;\n  }\n\n  var trimmed = value.trim();\n\n  if (!trimmed || trimmed.length > MAX_JSON_PARSE_CHARS) {\n    return value;\n  }\n\n  var firstChar = trimmed.charAt(0);\n\n  if (firstChar !== '{' && firstChar !== '[') {\n    return value;\n  }\n\n  try {\n    return JSON.parse(trimmed);\n  } catch (e) {\n    return value;\n  }\n}\n\nfunction stringifyValue(value) {\n  if (value == null) {\n    return '';\n  }\n\n  if (typeof value === 'string') {\n    return value;\n  }\n\n  if (typeof value === 'number') {\n    return Number.isFinite(value) ? String(value) : '';\n  }\n\n  if (typeof value === 'boolean') {\n    return value ? 'true' : 'false';\n  }\n\n  try {\n    return JSON.stringify(value);\n  } catch (e) {\n    return String(value);\n  }\n}\n\nfunction cleanBusinessObject(value) {\n  return stringifyValue(value).replace(/\\s+/g, '');\n}\n\nfunction looksLikeCsvText(value) {\n  if (typeof value !== 'string') {\n    return false;\n  }\n\n  var sample = value.slice(0, 2000).replace(/^\\uFEFF/, '');\n  var trimmed = sample.trim();\n\n  if (!trimmed) {\n    return false;\n  }\n\n  var firstChar = trimmed.charAt(0);\n\n  if (firstChar === '{' || firstChar === '[') {\n    return false;\n  }\n\n  var firstLineEnd = sample.search(/\\r\\n|\\n|\\r/);\n  var firstLine = firstLineEnd === -1 ? sample : sample.slice(0, firstLineEnd);\n\n  return firstLine.indexOf(',') !== -1;\n}\n\nfunction findCsvInOneObject(value) {\n  if (typeof value === 'string') {\n    return looksLikeCsvText(value) ? value : '';\n  }\n\n  if (!isPlainObject(value)) {\n    return '';\n  }\n\n  var keys = Object.keys(value);\n\n  for (var i = 0; i < keys.length; i++) {\n    var key = keys[i];\n\n    if (/\\.csv$/i.test(key) && typeof value[key] === 'string' && looksLikeCsvText(value[key])) {\n      return value[key];\n    }\n  }\n\n  var preferredKeys = [\n    'csv',\n    'content',\n    'fileContent',\n    'fileContents',\n    'text',\n    'plainText',\n    'extractedText',\n    'data',\n    'result',\n    'value',\n    'body'\n  ];\n\n  for (var p = 0; p < preferredKeys.length; p++) {\n    var preferredValue = value[preferredKeys[p]];\n\n    if (typeof preferredValue === 'string' && looksLikeCsvText(preferredValue)) {\n      return preferredValue;\n    }\n  }\n\n  return '';\n}\n\nfunction findCsvDirect(value) {\n  var parsed = parseMaybeJson(value);\n  var direct = findCsvInOneObject(parsed);\n\n  if (direct) {\n    return direct;\n  }\n\n  if (!isPlainObject(parsed)) {\n    return '';\n  }\n\n  var keys = Object.keys(parsed);\n  var keyCount = Math.min(keys.length, 30);\n\n  for (var i = 0; i < keyCount; i++) {\n    var nested = parseMaybeJson(parsed[keys[i]]);\n    var found = findCsvInOneObject(nested);\n\n    if (found) {\n      return found;\n    }\n  }\n\n  return '';\n}\n\nfunction buildJsonFallback(parsedMessage) {\n  if (!isPlainObject(parsedMessage) || !Array.isArray(parsedMessage.fileContents)) {\n    return null;\n  }\n\n  return {\n    templateCode: parsedMessage.templateCode == null ? '' : stringifyValue(parsedMessage.templateCode),\n    businessObject: parsedMessage.businessObject == null ? '' : stringifyValue(parsedMessage.businessObject),\n    fileContents: parsedMessage.fileContents\n  };\n}\n\nfunction escapeJsonString(value) {\n  return String(value == null ? '' : value)\n    .replace(/\\\\/g, '\\\\\\\\')\n    .replace(/\"/g, '\\\\\"')\n    .replace(/\\t/g, '\\\\t')\n    .replace(/[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]/g, function(ch) {\n      return '\\\\u' + ('000' + ch.charCodeAt(0).toString(16)).slice(-4);\n    });\n}\n\nfunction escapeReplacementLiteral(value) {\n  return String(value).replace(/\\$/g, '$$$$');\n}\n\nfunction parseCsvToObjectsFast(csvText) {\n  var text = String(csvText || '')\n    .replace(/^\\uFEFF/, '')\n    .replace(/\\r\\n/g, '\\n')\n    .replace(/\\r/g, '\\n')\n    .replace(/\\n+$/g, '');\n\n  var firstNewline = text.indexOf('\\n');\n\n  if (firstNewline === -1) {\n    return [];\n  }\n\n  var headerLine = text.slice(0, firstNewline);\n  var body = text.slice(firstNewline + 1);\n\n  if (!body) {\n    return [];\n  }\n\n  var rawHeaders = headerLine.split(',');\n  var columnCount = rawHeaders.length;\n\n  if (columnCount < 1 || columnCount > MAX_COLS) {\n    return [];\n  }\n\n  var regexParts = [];\n  var objectParts = [];\n\n  for (var i = 0; i < columnCount; i++) {\n    var header = rawHeaders[i] == null ? '' : String(rawHeaders[i]).trim();\n\n    if (!header) {\n      return [];\n    }\n\n    var groupName = 'c' + i;\n    regexParts.push('(?<' + groupName + '>[^,\\\\n]*)');\n    objectParts.push(\n      escapeReplacementLiteral('\"' + escapeJsonString(header) + '\"') +\n        ':\"$<' +\n        groupName +\n        '>\"'\n    );\n  }\n\n  var rowRegex = new RegExp('^' + regexParts.join(',') + '$', 'gm');\n  var rowReplacement = '{' + objectParts.join(',') + '}';\n  var escapedBody = escapeJsonString(body);\n  var objectsText = escapedBody.replace(rowRegex, rowReplacement);\n\n  if (objectsText === escapedBody) {\n    return [];\n  }\n\n  var jsonText = '[' + objectsText.replace(/\\n/g, ',') + ']';\n\n  try {\n    return JSON.parse(jsonText);\n  } catch (e) {\n    return [];\n  }\n}\n\nfunction getFieldLabelPattern() {\n  return /(?:^|[\\s,;])((?:templateCode|template\\s+code|template|businessObject|business\\s+object|object))\\s*[:=]\\s*/gi;\n}\n\nfunction normalizeFieldLabel(label) {\n  var normalized = String(label || '').toLowerCase().replace(/\\s+/g, '');\n\n  if (normalized === 'templatecode' || normalized === 'template') {\n    return 'templateCode';\n  }\n\n  if (normalized === 'businessobject' || normalized === 'object') {\n    return 'businessObject';\n  }\n\n  return '';\n}\n\nfunction findNextFieldLabelIndex(text, startIndex) {\n  var pattern = getFieldLabelPattern();\n  pattern.lastIndex = startIndex;\n\n  var match = pattern.exec(text);\n  return match ? match.index : -1;\n}\n\nfunction startsWithExplicitFieldLabel(text, startIndex) {\n  return /^(?:templateCode|template\\s+code|template|businessObject|business\\s+object|object)\\s*[:=]/i.test(\n    text.slice(startIndex)\n  );\n}\n\nfunction getWhitespaceFieldPattern() {\n  return /(?:^|[\\s,;])((?:templateCode|template\\s+code|template|businessObject|business\\s+object|object))\\s+[^\\s,;\\n\\r]+/gi;\n}\n\nfunction startsWithWhitespaceFieldLabel(text, startIndex) {\n  return /^(?:templateCode|template\\s+code|template|businessObject|business\\s+object|object)\\s+[^\\s,;\\n\\r]+/i.test(\n    text.slice(startIndex)\n  );\n}\n\nfunction findNextWhitespaceFieldIndex(text, startIndex) {\n  var pattern = getWhitespaceFieldPattern();\n  pattern.lastIndex = startIndex;\n\n  var match = pattern.exec(text);\n  return match ? match.index : -1;\n}\n\nfunction findNextFieldBoundaryIndex(text, startIndex) {\n  var explicitLabelIndex = findNextFieldLabelIndex(text, startIndex);\n  var whitespaceLabelIndex = findNextWhitespaceFieldIndex(text, startIndex);\n\n  if (explicitLabelIndex === -1) {\n    return whitespaceLabelIndex;\n  }\n\n  if (whitespaceLabelIndex === -1) {\n    return explicitLabelIndex;\n  }\n\n  return Math.min(explicitLabelIndex, whitespaceLabelIndex);\n}\n\nfunction findUnquotedValueEnd(text, startIndex) {\n  var endIndex = text.length;\n  var delimiterMatch = text.slice(startIndex).search(/[,;\\n\\r]/);\n\n  if (delimiterMatch !== -1) {\n    endIndex = Math.min(endIndex, startIndex + delimiterMatch);\n  }\n\n  var nextLabelIndex = findNextFieldBoundaryIndex(text, startIndex);\n\n  if (nextLabelIndex !== -1) {\n    endIndex = Math.min(endIndex, nextLabelIndex);\n  }\n\n  return endIndex;\n}\n\nfunction readExplicitFieldValue(text, startIndex) {\n  var valueStart = startIndex;\n\n  while (valueStart < text.length && /[ \\t]/.test(text.charAt(valueStart))) {\n    valueStart++;\n  }\n\n  var quote = text.charAt(valueStart);\n\n  if (quote === '\"' || quote === \"'\") {\n    var valueEnd = valueStart + 1;\n\n    while (valueEnd < text.length) {\n      if (text.charAt(valueEnd) === quote) {\n        return text.slice(valueStart + 1, valueEnd).trim();\n      }\n      valueEnd++;\n    }\n\n    return text.slice(valueStart + 1).trim();\n  }\n\n  return text.slice(valueStart, findUnquotedValueEnd(text, valueStart)).trim();\n}\n\nfunction findWhitespaceValueEnd(text, startIndex) {\n  var endIndex = text.length;\n  var delimiterMatch = text.slice(startIndex).search(/[\\s,;\\n\\r]/);\n\n  if (delimiterMatch !== -1) {\n    endIndex = Math.min(endIndex, startIndex + delimiterMatch);\n  }\n\n  var nextLabelIndex = findNextFieldBoundaryIndex(text, startIndex);\n\n  if (nextLabelIndex !== -1) {\n    endIndex = Math.min(endIndex, nextLabelIndex);\n  }\n\n  return endIndex;\n}\n\nfunction extractWhitespaceField(text, fieldName) {\n  var pattern = getWhitespaceFieldPattern();\n  var match;\n  var wantedField = fieldName === 'businessObject' ? 'businessObject' : 'templateCode';\n\n  while ((match = pattern.exec(text)) != null) {\n    if (normalizeFieldLabel(match[1]) !== wantedField) {\n      continue;\n    }\n\n    var valueStart = match.index + match[0].lastIndexOf(match[0].trim().split(/\\s+/).pop());\n\n    if (text.charAt(valueStart) === ':' || text.charAt(valueStart) === '=') {\n      continue;\n    }\n\n    if (startsWithExplicitFieldLabel(text, valueStart) || startsWithWhitespaceFieldLabel(text, valueStart)) {\n      continue;\n    }\n\n    var value = text.slice(valueStart, findWhitespaceValueEnd(text, valueStart)).trim();\n\n    if (value) {\n      return value;\n    }\n\n    if (pattern.lastIndex <= match.index) {\n      pattern.lastIndex = match.index + 1;\n    }\n  }\n\n  return '';\n}\n\nfunction extractExplicitField(message, fieldName, parsedMessage) {\n  if (isPlainObject(parsedMessage) && Object.prototype.hasOwnProperty.call(parsedMessage, fieldName)) {\n    return stringifyValue(parsedMessage[fieldName]);\n  }\n\n  var text = stringifyValue(message).slice(0, MAX_MESSAGE_CHARS);\n  var wantedField = fieldName === 'businessObject' ? 'businessObject' : 'templateCode';\n  var pattern = getFieldLabelPattern();\n  var match;\n\n  while ((match = pattern.exec(text)) != null) {\n    if (normalizeFieldLabel(match[1]) === wantedField) {\n      return readExplicitFieldValue(text, pattern.lastIndex);\n    }\n\n    if (pattern.lastIndex <= match.index) {\n      pattern.lastIndex = match.index + 1;\n    }\n  }\n\n  return extractWhitespaceField(text, wantedField);\n}\n\nvar userMessage = $context.$system.$inputMessage;\nvar parsedUserMessage = parseMaybeJson(userMessage);\nvar userCsvText = findCsvDirect(parsedUserMessage);\nvar attachmentOutput = $context.$nodes.ATTACHMENT_READER_TOOL\n  ? $context.$nodes.ATTACHMENT_READER_TOOL.$output\n  : null;\nvar attachmentCsvText = findCsvDirect(attachmentOutput);\nvar csvText = userCsvText || attachmentCsvText;\nvar jsonFallback = csvText ? null : buildJsonFallback(parsedUserMessage);\n\nif (jsonFallback) {\n  return jsonFallback;\n}\n\nvar result = {\n  templateCode: extractExplicitField(userMessage, 'templateCode', parsedUserMessage),\n  businessObject: cleanBusinessObject(extractExplicitField(userMessage, 'businessObject', parsedUserMessage)),\n  fileContents: csvText ? parseCsvToObjectsFast(csvText) : []\n};\n\nreturn result;"
