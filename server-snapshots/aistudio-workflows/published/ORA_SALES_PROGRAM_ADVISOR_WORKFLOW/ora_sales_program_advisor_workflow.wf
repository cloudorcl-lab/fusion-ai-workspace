          }
        },
        {
          "id": "1776328487388",
          "code": "EXTRACT_PROGRAMID",
          "type": "CODE",
          "metadata": {
            "name": "Extract ProgramId",
            "sourceCode": "let result = \"\";\ntry {\n  const appContext = $context.$app?.$OraAppContext || \"\";\n  if (!appContext) {\n    result = \"\";\n  } else {\n    const pairs = appContext.split('&');\n    const obj = {};\n    pairs.forEach(pair => {\n      const [key, value] = pair.split('=');\n      if (key && value !== undefined) {\n        obj[key] = value;\n      }\n    });\n    // Extract programId from parsed object\n    // TODO: Inferred 'programId' from user text 'programId'\n    const programId = obj.programId || \"\";\n    result = programId;\n  }\n} catch (error) {\n  result = \"\";\n}\n\nreturn result;",
            "returnType": "string"
          },
          "diagram": {
            "x": 5675,
            "y": 5246
          },
          "outcomes": {
            "success": "1776328861599"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1776328861599",
          "code": "GET_PROGRAM_DATA",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Get Program Data",
            "businessObjectCode": "ORA_CX_MARKETING_DATAOBJECTS",
            "functionName": "getProgramById"
          },
          "diagram": {
            "x": 5675,
            "y": 5468
          },
          "outcomes": {
            "success": "1776328933694"
          },
          "inputs": [
            {
              "id": "1776328861599_id",
              "name": "id",
              "value": "{{$context.$nodes.EXTRACT_PROGRAMID.$output.result}}",
              "required": false,
              "type": "string"
            }
          ]
        },
        {
          "id": "1776328933694",
          "code": "PREPARE_PROGRAM_DATA",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Program Data",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  // Safely access the single program item from upstream node output\n  const program = $context.$nodes.GET_PROGRAM_DATA?.$output?.items?.[0] || null;\n\n  if (program) {\n    // Find attribute with key 'product'\n    const targetProductAttr = program.programAttributes?.items?.find(attr => attr.key === \"product\");\n    // Find attribute with key 'ownedproduct'\n    const ownedProductAttr = program.programAttributes?.items?.find(attr => attr.key === \"ownedproduct\");\n    // Find attribute with key 'regions'\n    const regionsAttr = program.programAttributes?.items?.find(attr => attr.key === \"regions\");\n\n    const industriesAttr = program.programAttributes?.items?.find(attr => attr.key === \"industries\");\n\n    // Extract first 3 industries if available and separated by comma\n    let industriesShort = null;\n    if (industriesAttr?.displayValue) {\n      const industriesArray = industriesAttr.displayValue.split(\",\").map(s => s.trim()).filter(s => s.length > 0);\n      industriesShort = industriesArray.slice(0, 3).join(\", \");\n    }\n\n    result = {\n      ProgramId: program.id || null,\n      ProgramName: program.name || null,\n      Objective: program.objective || null,\n      TargetProductId: targetProductAttr ? targetProductAttr.value : null,\n      TargetProductName: targetProductAttr ? targetProductAttr.displayValue : null,\n      OwnedProductId: ownedProductAttr ? ownedProductAttr.value : null,\n      OwnedProductName: ownedProductAttr ? ownedProductAttr.displayValue : null,\n      Region: regionsAttr ? regionsAttr.displayValue : null,\n      Industries: industriesShort\n    };\n  } else {\n    // No program data found, return empty object\n    result = {};\n  }\n} catch (error) {\n  // In case of error, return empty object\n  result = {};\n}\n\nreturn result;"
          },
          "diagram": {
            "x": 5675,
            "y": 5690
          },
          "outcomes": {
            "success": "1776359415460"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1776359415460",
          "code": "GET_SALES_INTERSECTION_ACCOUNTS",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Get Sales Intersection Accounts",
            "businessObjectCode": "ORA_CX_SALESFORCE_ACCOUNTS",
            "functionName": "getFavoriteAccounts"
          },
          "diagram": {
