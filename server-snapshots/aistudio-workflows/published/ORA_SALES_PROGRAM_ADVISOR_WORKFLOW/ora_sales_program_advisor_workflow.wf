        },
        {
          "id": "1776329480383",
          "code": "GET_ALL_ACCOUNTS",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Get All Accounts",
            "businessObjectCode": "ORA_CX_SALESFORCE_SALESMARKETINGACCOUNTS",
            "functionName": "getAllAccounts"
          },
          "diagram": {
            "x": 5675,
            "y": 6134
          },
          "outcomes": {
            "success": "1776329532177"
          },
          "inputs": [
            {
              "id": "1776329480383_targetProductId",
              "name": "targetProductId",
              "value": "{{$context.$nodes.PREPARE_PROGRAM_DATA.$output.result.TargetProductId}}",
              "required": false,
              "type": "string"
            },
            {
              "id": "1776329480383_ownedProductId",
              "name": "ownedProductId",
              "value": "{{$context.$nodes.PREPARE_PROGRAM_DATA.$output.result.OwnedProductId}}",
              "required": false,
              "type": "string"
            }
          ]
        },
        {
          "id": "1776329532177",
          "code": "GROUP_THE_ACCOUNTS",
          "type": "CODE",
          "metadata": {
            "name": "Group the Accounts",
            "sourceCode": "let result = { SalesReady: [], Awareness: [], Consideration: [] };\ntry {\n  const allAccounts = $context.$nodes?.GET_ALL_ACCOUNTS?.$output?.items || [];\n  const salesIntersectionAccounts = $context.$nodes?.GET_SALES_INTERSECTION_ACCOUNTS?.$output?.items || [];\n\n  // Create a Set of OrganizationName from sales intersection accounts for quick lookup\n  const salesOrgNamesSet = new Set(salesIntersectionAccounts.map(acc => acc.OrganizationName));\n\n  // Iterate over each account from all accounts and bucket into stages only if present in sales intersection\n  allAccounts.forEach(account => {\n    // TODO: Inferred 'OrganizationName' from user text 'accountName'\n    const accountName = account.OrganizationName || account.accountName; // fallback if OrganizationName missing\n    if (!accountName || !salesOrgNamesSet.has(accountName)) {\n      // Skip accounts not in sales intersection\n      return;\n    }\n\n    let stage = \"Consideration\";\n    const coverage = account.buyingGroupCoverage;\n    const engagement = account.buyingGroupEngagement;\n\n    if (coverage > 60 || engagement > 60) {\n      stage = \"SalesReady\"; // Note: property name in result object is SalesReady\n    } else if (coverage < 20 || engagement < 20) {\n      stage = \"Awareness\";\n    }\n\n    // Push account to appropriate stage array\n    if (stage === \"SalesReady\") {\n      result.SalesReady.push(account);\n    } else if (stage === \"Awareness\") {\n      result.Awareness.push(account);\n    } else {\n      result.Consideration.push(account);\n    }\n  });\n} catch (error) {\n  // On error, return empty arrays\n  result = { SalesReady: [], Awareness: [], Consideration: [] };\n}\n\nreturn result;\n",
            "returnType": "object"
          },
          "diagram": {
            "x": 5675,
            "y": 6356
          },
          "outcomes": {
            "success": "1776330043136"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
