{
  "workflowId": "300000331068550",
  "workflowCode": "ORA_SALES_PROGRAM_ADVISOR_WORKFLOW",
  "name": "Sales Program Advisor Workflow",
  "description": "This workflow supports the Sales Program Advisor application by retrieving and organizing data related to sales programs, including program details, associated accounts, eligibility criteria, and related activities. It processes and presents this information in a structured format for use within the application.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
