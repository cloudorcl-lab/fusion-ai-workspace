        {
          "metadata": {
            "name": "parse json input",
            "returnType": "object",
            "sourceCode": "let inputMessage = $context.$system.$inputMessage;\nlet output;\n\ntry {\n  const parsedObject = JSON.parse(inputMessage);\n\n  // Check if parsed value is a valid JSON object (and not null / array / primitive)\n  if (parsedObject && typeof parsedObject === \"object\" && !Array.isArray(parsedObject)) {\n    output = parsedObject;\n  } else {\n    output = {\n      isIMTEnabled: false,\n      userInputMessage: inputMessage\n    };\n  }\n\n} catch (e) {\n  // If parsing fails, return default structure\n  output = {\n    isIMTEnabled: false,\n    userInputMessage: inputMessage\n  };\n}\n\nreturn output;"
          },
          "outcomes": {
            "success": "1774953237546"
          },
          "diagram": {
            "x": 5471.5,
            "y": 5246
          },
          "code": "PARSE_JSON_INPUT",
          "id": "1774953167964",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
