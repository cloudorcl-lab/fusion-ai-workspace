        {
          "metadata": {
            "name": "prepare response",
            "returnType": "object",
            "sourceCode": "let activePreferences = $context.$nodes.FETCH_ACTIVE_PREFERENCE.$output.items;\nlet derivedSearchResults = null;\nlet isfullMatchFlag = false;\n\nif($context.$nodes.SHOPPING_CATALOG_AND_SEARCH.$output?.items?.length > 0){\n   derivedSearchResults = $context.$nodes.SHOPPING_CATALOG_AND_SEARCH.$output;\n    isfullMatchFlag = true;\n}else{\n   derivedSearchResults =  $context.$nodes.SHOPPING_CATALOG_SEARCH.$output;\n}\n\nlet items= derivedSearchResults.items;\nlet {...rest} = derivedSearchResults;\n\n//allow only the master item and blanket type documents\nconst allowedDocTypes = [\"BLANKET\", \"MASTER_ITEM\",\"SMART_FORM\"];\nlet searchedItems = [];\n\nfor (let i = 0; i < items.length; i++) {\n    let item = items[i];\n    if (allowedDocTypes.includes(item['document_type'])) {\n        if (item['document_type'] === 'BLANKET') {\n            let lineTypeCode = 'Goods';\n            if (item.item_id === -2 && item.agreement_line != null) {\n                const {uom_code,price} = item.agreement_line;\n                if (uom_code == null && price == null) {\n                    lineTypeCode = 'Services';\n                }\n            }\n            searchedItems.push(item);\n        } else {\n            searchedItems.push(item);\n        }\n    }\n}\n\nitems = searchedItems;\n\n//remove https: from thumbail image field if exists.\nfor(let i=0 ; i<items.length ; i++){\n    let searchitem = items[i];\n    if(searchitem?.agreement_line?.thumbnail_image){\n       let originalString = searchitem['agreement_line']['thumbnail_image'];\n      // let substringToRemove = \"https://\";\n       let newString = originalString.replace(/https:\\/\\//g, \"HTPPS\").replace(/http:\\/\\//g, \"HTTP\");\n       searchitem['agreement_line']['thumbnail_image'] = newString;\n       items[i] = searchitem;\n    }\n}\n\nconst searchResults = {items};\n\n//remove urls from preferences\nfor(let i=0 ; i<activePreferences.length ; i++){\n    let activePreference = activePreferences[i];\n    let reqOptions = activePreference['requisitioningOptions'];\n    let {items,...rest} = reqOptions;\n    activePreference['requisitioningOptions'] = items;\n    delete activePreference['@context'];\n    activePreferences[i] = activePreference;\n}\n\nlet resultMap = {};\nresultMap['searchResults'] = searchResults;\nresultMap['activePreferences'] = {\"items\":activePreferences};\nresultMap['suggestedCategory'] = $context.$nodes.PROCESS_SUGGESTED_CATEGORY_RESPONSE.$output?.result != null ? $context.$nodes.PROCESS_CATEGORY_NAME_RESPONSE.$output?.result : null;\nresultMap['isfullMatchFlag'] = isfullMatchFlag;\n\nreturn resultMap;"
          },
          "outcomes": {
            "success": "end"
          },
