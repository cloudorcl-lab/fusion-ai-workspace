              "scope": "JOB",
              "type": "string",
              "value": "{{$context.$nodes.DERIVE_SMARTSEARCHNAME_AND_ENFORCEEXACTMATCH.$output.result.smartSearchName}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "prepare Search payload",
            "returnType": "object",
            "sourceCode": "let data = $context.$nodes.KEYWORD_ANALYZER_AND_PAYLOAD_PREPARER.$output.filters;\n\nlet otherFilters = $context.$nodes.PARSE_JSON_INPUT.$output.result;\n\nconst result = data != null ? data.map(item => item.value).join(\" \") : \"\";\n\nlet conjuctionAndFilters = [{\"filter\":\"keyword\",\"value\":result}];\n\nlet orKeywordAccumulator = result ? [result] : [];\n\nif (otherFilters?.Categories?.length > 0) {\n  conjuctionAndFilters.push({\n    filter: \"keyword\",\n    value: otherFilters.Categories.join(\" \")\n  });\n\n  orKeywordAccumulator.push(otherFilters.Categories.join(\" \"));\n}\n\nif (otherFilters?.Suppliers?.length > 0) {\n  conjuctionAndFilters.push({\n    filter: \"keyword\",\n    value: otherFilters.Suppliers.join(\" \")\n  });\n\n  orKeywordAccumulator.push(otherFilters.Suppliers.join(\" \"));\n}\n\nif (otherFilters?.Manufacturers?.length > 0) {\n  conjuctionAndFilters.push({\n    filter: \"keyword\",\n    value: otherFilters.Manufacturers.join(\" \")\n  });\n\n  orKeywordAccumulator.push(otherFilters.Manufacturers.join(\" \"));\n}\n\nif (otherFilters?.OtherFilters?.length > 0) {\n  otherFilters.OtherFilters.forEach(item => {\n    conjuctionAndFilters.push({\n      filter: \"keyword\",\n      value: item\n    });\n\n    orKeywordAccumulator.push(item);\n  });\n}\n\nlet conjuctionOrFilters = [{\n  \"filter\": \"keyword\",\n  \"value\": orKeywordAccumulator.join(\" \").trim()\n}];\n\nlet finalResult = {\n  \"AndFilters\": {\"filters\" : conjuctionAndFilters},\n  \"OrFilters\": {\"filters\" : conjuctionOrFilters}\n};\n\nreturn finalResult;"
          },
          "outcomes": {
            "success": "1765626545731"
          },
          "diagram": {
