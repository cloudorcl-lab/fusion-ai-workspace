                {
                  "metadata": {
                    "name": "Combine Lot Item and Org Demands",
                    "returnType": "object",
                    "sourceCode": "const out = $context.$nodes.ITEM_ORG_MAPPING.ORG_ITERATOR.$output ?? [];\nconst itemId = $context.$nodes.ITEM_ORG_MAPPING.$currentItem.InventoryItemId;\nconst lotItemMap = $context.$variables.LotItemMap;\nconst lotOrgsMap = $context.$variables.LotOrgMap ?? {};\nconst itemOrgsToQty = (Array.isArray(out) ? out : [])\n  .map(s => (typeof s === \"string\" ? JSON.parse(s) : s))\n  .map(o => o?.result ?? {}) \n  .reduce((acc, obj) => {\n    for (const [org, qty] of Object.entries(obj)) {\n      if (qty !== 0) acc[org] = qty;     \n    }\n    return acc;\n  }, {}); \n\nlotOrgsMap[itemId] = itemOrgsToQty;\nconst itemEntry = lotItemMap[itemId];\nif (itemEntry && typeof itemEntry === \"object\") {\n  itemEntry.item = $context.$nodes.ITEM_ORG_MAPPING.$currentItem.ItemNumber;\n}\n\nconst output = {\n lotItemMap: lotItemMap,\n lotOrgsMap: lotOrgsMap\n}\nreturn output;"
                  },
                  "outcomes": {
                    "success": "1772139014123"
                  },
                  "code": "COMBINE_LOT_ITEM_AND_ORG_DEMANDS",
                  "id": "1772139040884",
