            "name": "Expired Lots Params Builder",
            "returnType": "object",
            "sourceCode": "let queryParts = [];\n\nconst org  = $context.$variables.OrganizationId;\nconst item = $context.$variables.ItemNumber;\nconst startDate = $context.$nodes.CALCULATE_EXPIRATION_RANGE.$output.ExpirationStartDate;\nconst endDate = $context.$nodes.CALCULATE_EXPIRATION_RANGE.$output.ExpirationEndDate;\nconst lot = $context.$nodes.CALCULATE_EXPIRATION_RANGE.$output.LotNumber;\n\n\nif (org != \"\" && org != null) {\n  queryParts.push(`OrganizationId=${org}`);\n}\n\nif (item != \"\" && item != null) {\n  queryParts.push(`ItemNumber='${item}'`);\n}\n\nif (startDate != \"\" && startDate != null) {\n  queryParts.push(`ExpirationDate>'${startDate}'`);\n}\n\nif (endDate != \"\" && endDate != null) {\n  queryParts.push(`ExpirationDate<='${endDate}'`);\n}\n\nif (lot != \"\" && lot != null) {\n  queryParts.push(`LotNumber=${lot}'`);\n}\n\nconst query = queryParts.join(\" AND \");\n\nlet finder = \"&finder=filterByOnhand\";\n\nconst output = { query };\nif (finder !== \"\") {\n  output.finder = finder;\n}\n\nreturn output;"
          },
          "outcomes": {
            "success": "1769467838355"
          },
