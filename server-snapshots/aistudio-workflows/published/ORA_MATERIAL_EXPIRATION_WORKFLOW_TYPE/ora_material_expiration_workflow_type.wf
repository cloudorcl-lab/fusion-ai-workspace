        {
          "metadata": {
            "name": "Validate Moment Request Params"
          },
          "outcomes": {
            "success": "1769551627192"
          },
          "code": "MEEXTRACTMOVEMENTPARAMS",
          "id": "1769207461008",
          "inputs": [
            {
              "id": "1769207461010_1",
              "name": "prompt",
              "type": "string",
              "value": "Verify if qty is provided then assign the value to the variable `Quantity`, otherwise assign ''.\nVerify if UOM is provided(Eg: Each/Eaches)  then assign the value to the variable `UOM`, otherwise assign ''.\nVerify if source sub-inventory is mentioned and assign the value to variable `SrcSub`, otherwise assign ''.\nVerify if destination sub-inventory is mentioned and assign the value to variable `DestSub`, otherwise assign ''.\nVerify if required date is mentioned and assign the value in 'YYYY-MM-DD' format to variable `ReqDate`, otherwise assign {{$context.$system.$currentDate}} .\nIf any of the above variables are empty then set the variable`Error` to a request for the user to provide the missing details, otherwise assign ''.\nIf Lot details are provided assign it to the variable `Lot`, otherwise assign '' (Lot details are optional, do not generate an error if it's not present).\nUser prompt: {{$context.$variables.UserQuery}}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"UOM\": {\n            \"type\": \"string\"\n        },\n        \"Lot\": {\n            \"type\": \"string\"\n        },\n        \"ReqDate\": {\n            \"type\": \"string\"\n        },\n        \"Error\": {\n            \"type\": \"string\"\n        },\n        \"DestSub\": {\n            \"type\": \"string\"\n        },\n        \"SrcSub\": {\n            \"type\": \"string\"\n        },\n        \"Quantity\": {\n            \"type\": \"number\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Disposal Policy",
            "toolCode": "ORA_MATERIAL_DISPOSAL_POLICY"
          },
          "outcomes": {
            "success": "1769557232278"
          },
          "code": "MEDISPOSALPOLICY",
          "id": "1769208109709",
          "inputs": [
            {
              "id": "1769208109710_1",
              "name": "question",
              "type": "string",
              "value": "Answer the following user query: {{$context.$variables.UserQuery}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"AnswerWithCitations\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"value\": {\n      \"type\": \"string\",\n      \"description\": \"The answer text.\"\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"description\": \"List of citations relevant to the answer.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"citedText\": {\n            \"type\": \"string\",\n            \"description\": \"The cited text.\"\n          }\n        },\n        \"required\": [\n          \"citedText\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"value\",\n    \"citations\"\n  ],\n  \"additionalProperties\": false\n}",
          "type": "RAG_DOCUMENT_TOOL"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_SCM_INVENTORYM_ITEMSUPPLIESAND",
            "functionName": "get_itemSuppliesAndDemandsByOrgItem",
            "name": "Supply and Demand Details for Single Org"
          },
          "outcomes": {
            "success": "1769208358855"
          },
          "code": "MESINGLESUPPLYDEMAND",
          "id": "1769208283655",
          "inputs": [
            {
              "id": "1769208345322_1",
              "name": "pItemId",
              "type": "string",
              "value": "{{$context.$variables.ItemId}}"
            },
            {
              "id": "1769208345323_2",
              "name": "pOrgId",
              "type": "string",
              "value": "{{$context.$variables.OrganizationId}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://example.com/schemas/itemSuppliesAndDemands.schema.json\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"response\": {\n      \"type\": [\"object\", \"null\"],\n      \"properties\": {\n        \"items\": {\n          \"type\": [\"array\", \"null\"],\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"SeqId\": { \"type\": [\"integer\", \"number\", \"string\", \"null\"] },\n              \"InventoryItemId\": { \"type\": [\"integer\", \"number\", \"string\", \"null\"] },\n              \"OrganizationId\": { \"type\": [\"integer\", \"number\", \"string\", \"null\"] },\n              \"OrganizationCode\": { \"type\": [\"string\", \"null\"] },\n              \"SupplyDemandDate\": { \"type\": [\"string\", \"null\"], \"format\": \"date\" },\n              \"SupplyDemandTypeM\": { \"type\": [\"string\", \"null\"] },\n              \"OrderIdentifier\": { \"type\": [\"string\", \"null\"] },\n              \"SecOrderIdentifier\": { \"type\": [\"string\", \"null\"] },\n              \"Quantity\": { \"type\": [\"integer\", \"number\", \"string\", \"null\"] },\n              \"ProjectedQuantity\": { \"type\": [\"integer\", \"number\", \"string\", \"null\"] },\n              \"ItemPrimaryUom\": { \"type\": [\"string\", \"null\"] },\n              \"SupplyDemandSourceTypeId\": { \"type\": [\"string\", \"null\"] },\n              \"ItemNumber\": { \"type\": [\"string\", \"null\"] },\n              \"ItemDescription\": { \"type\": [\"string\", \"null\"] },\n              \"ShippingPriority\": { \"type\": [\"integer\", \"number\", \"string\", \"null\"] },\n              \"WorkOrderDescription\": { \"type\": [\"string\", \"null\"] },\n              \"PartyName\": { \"type\": [\"string\", \"null\"] },\n              \"CreatedBy\": { \"type\": [\"string\", \"integer\", \"number\", \"null\"] },\n              \"SupplyQuantity\": { \"type\": [\"integer\", \"number\", \"string\", \"null\"] },\n              \"DemandQuantity\": { \"type\": [\"integer\", \"number\", \"string\", \"null\"] },\n              \"@context\": {\n                \"type\": [\"object\", \"null\"],\n                \"properties\": {\n                  \"key\": { \"type\": [\"string\", \"null\"] },\n                  \"links\": {\n                    \"type\": [\"array\", \"null\"],\n                    \"items\": {\n                      \"type\": \"object\",\n                      \"properties\": {\n                        \"rel\": { \"type\": [\"string\", \"null\"] },\n                        \"href\": { \"type\": [\"string\", \"null\"], \"format\": \"uri\" },\n                        \"name\": { \"type\": [\"string\", \"null\"] },\n                        \"kind\": { \"type\": [\"string\", \"null\"] }\n                      },\n                      \"additionalProperties\": true\n                    }\n                  }\n                },\n                \"additionalProperties\": true\n              }\n            },\n            \"additionalProperties\": true\n          }\n        }\n      },\n      \"additionalProperties\": true\n    }\n  },\n  \"additionalProperties\": true\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Format Supply and Demand Output Single Org"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "MESINGLEFORMAT",
          "id": "1769208358855",
          "inputs": [
            {
              "id": "1769208358856_1",
              "name": "prompt",
              "type": "string",
              "value": "Format demand/supply details in HTML table. Include only the following columns: OrganizationCode, ItemNumber, SupplyDemandDate, SupplyDemandTypeM, Quantity, and ProjectedQuantity.\n{{$context.$nodes.MESINGLESUPPLYDEMAND.$output}}"
            }
          ],
