          "metadata": {
            "name": "Inventory Item Lots Params Builder",
            "returnType": "object",
            "sourceCode": "let queryParts = [];\n\nconst org  = $context.$variables.OrganizationId;\nconst item = $context.$variables.ItemNumber;\nconst startDate = $context.$nodes.EXTRACT_PARAMS_FOR_LOT_EXPIRY_RECOMMENDATION.$output.ExpirationStartDate;\nconst endDate = $context.$nodes.EXTRACT_PARAMS_FOR_LOT_EXPIRY_RECOMMENDATION.$output.ExpirationEndDate;\nconst lot = $context.$nodes.EXTRACT_PARAMS_FOR_LOT_EXPIRY_RECOMMENDATION.$output.LotNumber;\n\nif (org != \"\" && org != null) {\n  queryParts.push(`OrganizationId=${org}`);\n}\n\nif (item != \"\" && item != null) {\n  queryParts.push(`ItemNumber='${item}'`);\n}\n\nif (startDate != \"\" && startDate != null) {\n  queryParts.push(`ExpirationDate>'${startDate}'`);\n}\n\nif (endDate != \"\" && endDate != null) {\n  queryParts.push(`ExpirationDate<='${endDate}'`);\n}\n\nif (lot != \"\" && lot != null) {\n  queryParts.push(`LotNumber=${lot}'`);\n}\n\nconst query = queryParts.join(\" AND \");\n\nlet finder = \"&finder=filterByOnhand\";\n\nconst output = { query };\nif (finder !== \"\") {\n  output.finder = finder;\n}\n\nreturn output;"
          },
          "outcomes": {
            "success": "1769712580892"
          },
          "code": "INVENTORY_ITEM_LOTS_PARAMS_BUILDER",
          "id": "1772174453885",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
