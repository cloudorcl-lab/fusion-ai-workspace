                {
                  "metadata": {
                    "name": "Same Org Demand Filter",
                    "returnType": "object",
                    "sourceCode": "const response = $context.$nodes.ITEM_ITERATOR.SAME_ORG_DEMANDS_FETCH.$output.items ?? [];\nconst validIds = [\"TO SHIP LINE\", \"SO\"];\n\nconst processed = response\n  .filter(d => validIds.includes(d?.SupplyDemandSourceTypeId))\n  .map(demand => ({\n    Quantity: demand.Quantity * -1,\n    DemandType: demand.SupplyDemandTypeM,\n    OrderIdentifier: demand.OrderIdentifier\n  }));\n\nreturn processed;"
                  },
                  "outcomes": {
                    "success": "1772152750457"
                  },
                  "code": "SAME_ORG_DEMAND_FILTER",
                  "id": "1772151208994",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
