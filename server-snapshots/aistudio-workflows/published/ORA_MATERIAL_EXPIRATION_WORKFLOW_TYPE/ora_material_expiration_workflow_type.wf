                            "name": "Add Lots to Items",
                            "returnType": "object",
                            "sourceCode": "const lotNumber = $context.$nodes.LOOP_THROUGH_ITEM_LOTS.$currentItem.LotNumber;\nconst qty = $context.$nodes.LOOP_THROUGH_ITEM_LOTS.$currentItem.OnhandQuantity;\nconst sub = $context.$nodes.LOOP_THROUGH_ITEM_LOTS.$currentItem.SubinventoryCode;\nconst org = $context.$nodes.LOOP_THROUGH_ITEM_LOTS.$currentItem.OrganizationCode;\nconst itemId = $context.$nodes.LOOP_THROUGH_ITEM_LOTS.$currentItem.InventoryItemId;\nconst locator = $context.$nodes.LOOP_THROUGH_ITEM_LOTS.$currentItem.LocatorName;\n\nlet lotItemMap = $context.$variables.LotItemMap ?? {};\nlotItemMap[itemId] = lotItemMap[itemId] ?? {};\nlotItemMap[itemId].lot = lotItemMap[itemId].lot ?? {};\nlotItemMap[itemId].lot[lotNumber] = {\n  Quantity: qty,\n  Subinventory: sub,\n  Organization: org,\n  Locator: locator\n};\n\nreturn lotItemMap;"
                          },
                          "outcomes": {
