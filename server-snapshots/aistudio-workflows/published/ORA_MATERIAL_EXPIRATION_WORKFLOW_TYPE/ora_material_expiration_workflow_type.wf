                          "type": "BO_FUNCTION"
                        },
                        {
                          "metadata": {
                            "name": "Process and Filter Org Demands",
                            "returnType": "object",
                            "sourceCode": "const response = $context.$nodes.ITEM_ORG_MAPPING.ORG_ITERATOR.GET_ITEM_SUPPLIES_AND_DEMANDS_.$output?.items ?? [];\nconst orgCode = $context.$nodes.ITEM_ORG_MAPPING.ORG_ITERATOR.$currentItem.OrganizationCode;\nconst validIds = [\"TO SHIP LINE\", \"SO\", \"WO COMP\"];\nconst filteredDemands = response.filter(d =>\n  validIds.includes(d?.SupplyDemandSourceTypeId)\n);\n\n// If Quantities are coming as strings; coerce to number\nconst totalDemand = filteredDemands.reduce((sum, d) => {\n  const q = Number(d?.Quantity ?? 0);\n  return sum + (Number.isFinite(q) ? q : 0);\n}, 0);\nconst qty = {};\nqty[orgCode] = totalDemand * -1;\n\nreturn qty;"
                          },
                          "outcomes": {
                            "success": "end_1772131815915"
                          },
                          "code": "PROCESS_AND_FILTER_ORG_DEMANDS",
                          "id": "1772136407935",
                          "inputs": [],
                          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                          "type": "CODE"
                        }
