                    "name": "Consolidate Lot Exp",
                    "returnType": "object",
                    "sourceCode": "const expAction =\n  $context.$nodes.GET_EXPIRATION_ACTION?.GET_EXPIRATION_ACTIONS?.$output?.items?.[0] ??\n  $context.$nodes.GET_EXPIRATION_ACTION?.GET_EXPIRATION_ACTIONS?.$output ??\n  null;\n\nconst itemQty =\n  $context.$nodes.GET_EXPIRATION_ACTION?.GET_LOT_ITEM_QUANTITY?.$output?.items?.[0] ?? null;\n\nlet output = {\n  itemNumber: $context.$nodes.GET_EXPIRATION_ACTION?.$currentItem?.ItemNumber ?? '',\n  expirationDate: $context.$nodes.GET_EXPIRATION_ACTION?.$currentItem?.ExpirationDate ?? '',\n  lotNumber: $context.$nodes.GET_EXPIRATION_ACTION?.$currentItem?.LotNumber ?? ''\n};\n\nif (itemQty) {\n  output = {\n    ...output,\n    itemNumber: itemQty.ItemNumber ?? output.itemNumber ?? '',\n    subinventory: itemQty.SubinventoryCode ?? '',\n    onhandQuantity: itemQty.OnhandQuantity ?? '',\n    expirationDate: itemQty.LotExpirationDate ?? output.expirationDate ?? '',\n    organizationCode: itemQty.OrganizationCode ?? '',\n    lotNumber: itemQty.LotNumber ?? '',\n    uom: itemQty.PrimaryUnitOfMeasure ?? '',\n    locator: itemQty.LocatorName ?? '',\n    lpn: itemQty.LPNId ?? ''\n  };\n}\n\nif (expAction) {\n  output = {\n    ...output,\n    expirationAction: expAction.AutomatedActionName ?? '',\n    description: expAction.Description ?? '',\n    organizationName: expAction.OrganizationName ?? ''\n  };\n}\n\nreturn output;"
                  },
