          "code": "SET_EMPTY_SEMANTIC_SECTIONS_MESSAGE",
          "id": "1770676694607",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Check if Raw Sections Exist",
            "returnType": "boolean",
            "sourceCode": "var rawSections = $context.$variables.rawSections;\n\nif (rawSections == null) {\n  return false;\n}\n\nif (typeof rawSections === \"string\") {\n  try {\n    rawSections = JSON.parse(rawSections);\n  } catch (e) {\n    return false;\n  }\n}\n\nif (Array.isArray(rawSections)) {\n  return rawSections.length > 0;\n}\n\n// Support common wrappers only; avoid treating arbitrary objects as valid sections.\nif (rawSections && typeof rawSections === \"object\") {\n  if (Array.isArray(rawSections.semanticSections)) {\n    return rawSections.semanticSections.length > 0;\n  }\n  if (rawSections.result && Array.isArray(rawSections.result.semanticSections)) {\n    return rawSections.result.semanticSections.length > 0;\n  }\n}\n\nreturn false;"
          },
          "outcomes": {
            "success": "1770676524270"
          },
          "code": "CHECK_IF_RAW_SECTIONS_EXIST",
          "convergenceTargetId": "1770676524270",
          "id": "1770677515934",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
