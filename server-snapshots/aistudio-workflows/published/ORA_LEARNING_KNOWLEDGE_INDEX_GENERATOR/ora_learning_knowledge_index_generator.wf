          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Build Final Outline",
            "returnType": "object",
            "sourceCode": "/**\n * BuildFinalOutline (patched)\n * - Numeric-safe offsets\n * - O(n log n) sort\n */\n\nvar inputSections = $context.$variables.normalizedSections;\nvar working = [];\nvar finalOutline = [];\n\nif (Array.isArray(inputSections)) {\n  for (var i = 0; i < inputSections.length; i++) {\n    var sec = inputSections[i];\n    if (sec && typeof sec === \"object\") {\n      working.push(sec);\n    }\n  }\n}\n\nworking.sort(function (left, right) {\n  var ls = (left && left.startOffset != null) ? Number(left.startOffset) : 9007199254740991;\n  var rs = (right && right.startOffset != null) ? Number(right.startOffset) : 9007199254740991;\n\n  if (isNaN(ls)) ls = 9007199254740991;\n  if (isNaN(rs)) rs = 9007199254740991;\n\n  if (ls < rs) return -1;\n  if (ls > rs) return 1;\n  return 0;\n});\n\nvar newIndex = 1;\nvar i2 = 0;\n\nwhile (i2 < working.length) {\n  var src = working[i2];\n\n  var text = src.text ? String(src.text).trim() : \"\";\n  if (text.length === 0) {\n    i2 = i2 + 1;\n    continue;\n  }\n\n  var start = (src.startOffset != null) ? Number(src.startOffset) : 0;\n  if (isNaN(start) || start < 0) start = 0;\n\n  var end;\n  if (src.endOffset != null) {\n    end = Number(src.endOffset);\n    if (isNaN(end)) end = start + text.length;\n  } else {\n    end = start + text.length;\n  }\n\n  if (end < start) {\n    end = start + text.length;\n  }\n\n  var st = (src.startTimestamp != null ? String(src.startTimestamp).trim() : \"\");\n  var et = (src.endTimestamp != null ? String(src.endTimestamp).trim() : \"\");\n\n  var fs = {\n    sectionIndex: newIndex,\n    type: src.type || \"NORMAL\",\n    heading: src.heading || null,\n    text: text,\n    startOffset: start,\n    endOffset: end,\n    pageRange: Array.isArray(src.pageRange) ? src.pageRange : [],\n    topic: src.topic || null,\n    entities: Array.isArray(src.entities) ? src.entities : []\n  };\n\n  if (st.length > 0) fs.startTimestamp = st;\n  if (et.length > 0) fs.endTimestamp = et;\n\n  finalOutline.push(fs);\n  newIndex = newIndex + 1;\n  i2 = i2 + 1;\n}\n\nconsole.info(\"BuildFinalOutline: Final sections = \" + finalOutline.length);\nreturn { finalOutline: finalOutline };"
          },
          "outcomes": {
            "success": "1762991238770"
          },
          "code": "BUILD_FINAL_OUTLINE",
          "convergenceTargetId": "1770677020843",
          "id": "1762991207552",
