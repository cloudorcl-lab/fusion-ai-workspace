        {
          "metadata": {
            "name": "Build Vector Sections with Metadata",
            "returnType": "object",
            "sourceCode": "/**\n * ============================================================================\n * Node: JavaScript  BuildVectorSectionsWithMetadata\n * Purpose:\n *   Produce vector-ready text and metadata for each validated section.\n *\n * Input:\n *   $context.$variables.validatedOutline\n *\n * Output:\n *   vectorizationInput\n * ============================================================================\n */\n\nvar outline = $context.$variables.validatedOutline;\nvar vectorizationInput = [];\nvar fileId = $context.$triggers.REST.$input.fileId;\nvar fileIndex = $context.$triggers.REST.$input.fileIndex;\nvar fileName = $context.$variables.fileName;\nvar contentFormat = $context.$variables.contentFormat;\nvar learningItemId = $context.$variables.learningItemId;\nvar learningItemNumber = $context.$variables.learningItemNumber;\nvar learningItemTitle = $context.$variables.learningItemTitle;\nvar contentId = $context.$triggers.REST.$input.contentId;\n\nif (Array.isArray(outline)) {\n  for (var i = 0; i < outline.length; i++) {\n    var sec = outline[i];\n    if (!sec || !sec.text || !String(sec.text).trim()) {\n      continue;\n    }\n\n    var idx = sec.sectionIndex || (i + 1);\n    var heading = sec.heading ? String(sec.heading).trim() : \"\";\n    var topic = sec.topic ? String(sec.topic).trim() : \"\";\n    var type = sec.type ? String(sec.type).trim() : \"\";\n    var text = String(sec.text).trim();\n    var entities = Array.isArray(sec.entities) ? sec.entities.join(\", \") : \"\";\n    var pageRange = Array.isArray(sec.pageRange) ? sec.pageRange.join(\",\") : \"\";\n\n    // Optional timestamps (may not exist for all content types)\n    var startTs = sec.startTimestamp != null ? String(sec.startTimestamp).trim() : \"\";\n    var endTs = sec.endTimestamp != null ? String(sec.endTimestamp).trim() : \"\";\n\n    // --------------------------------------------------------------\n    // Build normalized text for vectorization\n    // --------------------------------------------------------------\n    var raw =\n      (heading ? \"HEADING: \" + heading + \"\\n\" : \"\") +\n      (topic ? \"TOPIC: \" + topic + \"\\n\" : \"\") +\n      (entities ? \"ENTITIES: \" + entities + \"\\n\" : \"\") +\n      \"TEXT: \" + text;\n\n    // Normalize whitespace while preserving structure\n    var cleaned = raw\n      .replace(/[ \\t]+/g, \" \")\n      .replace(/\\n{2,}/g, \"\\n\")\n      .trim();\n\n    // --------------------------------------------------------------\n    // Metadata object for Vector DB\n    // --------------------------------------------------------------\n    var metadata = {\n      sectionIndex: idx,\n      type: type,\n      heading: heading,\n      topic: topic,\n      pageRange: pageRange,\n      startOffset: typeof sec.startOffset === \"number\" ? sec.startOffset : null,\n      endOffset: typeof sec.endOffset === \"number\" ? sec.endOffset : null,\n      startTimestamp: startTs.length > 0 ? startTs : null,\n      endTimestamp: endTs.length > 0 ? endTs : null,\n      entities: entities,\n      charLength: cleaned.length,\n      fileId: fileId,\n      fileIndex: fileIndex,\n      fileName: fileName,\n      contentId: contentId,\n      contentFormat: contentFormat,\n      learningItemId: learningItemId,\n      learningItemNumber: learningItemNumber,\n      learningItemTitle: learningItemTitle\n    };\n\n    vectorizationInput.push({\n      sectionContent: cleaned,\n      metadata: metadata\n    });\n  }\n} else {\n  console.warn(\"BuildVectorizationInput: validatedOutline missing or not an array\");\n}\n\nreturn vectorizationInput;"
          },
