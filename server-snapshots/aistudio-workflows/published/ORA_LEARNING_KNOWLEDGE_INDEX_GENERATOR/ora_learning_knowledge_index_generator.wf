        {
          "metadata": {
            "name": "Convert Loop Output to Valid Json",
            "returnType": "object",
            "sourceCode": "// Convert Loop Output to Valid Json (optimized)\nvar rawInput = $context.$variables.loopOutput;\n\nif (typeof rawInput === \"string\") {\n  try { rawInput = JSON.parse(rawInput); } catch (e0) { rawInput = null; }\n}\n\nif (rawInput && rawInput.loopOutput != null) {\n  rawInput = rawInput.loopOutput;\n}\n\nif (!rawInput) {\n  return [];\n}\nif (!Array.isArray(rawInput)) {\n  rawInput = [rawInput];\n}\n\nvar cleaned = [];\nvar i = 0;\n\nwhile (i < rawInput.length) {\n  var item = rawInput[i];\n\n  if (typeof item === \"string\") {\n    try { item = JSON.parse(item); } catch (e1) { item = null; }\n  }\n\n  if (item && item.loopOutput != null) {\n    item = item.loopOutput;\n  }\n\n  var sections = null;\n\n  if (item && item.result && Array.isArray(item.result.refinedSections)) {\n    sections = item.result.refinedSections;\n  } else if (item && item.output && item.output.result && Array.isArray(item.output.result.refinedSections)) {\n    sections = item.output.result.refinedSections;\n  }\n\n  if (sections) {\n    var j = 0;\n    while (j < sections.length) {\n      cleaned.push(sections[j]);\n      j = j + 1;\n    }\n  }\n\n  i = i + 1;\n}\n\ncleaned.sort(function (left, right) {\n  var lo = (left && left.startOffset != null) ? Number(left.startOffset) : 9007199254740991;\n  var ro = (right && right.startOffset != null) ? Number(right.startOffset) : 9007199254740991;\n\n  if (isNaN(lo)) lo = 9007199254740991;\n  if (isNaN(ro)) ro = 9007199254740991;\n\n  if (lo < ro) return -1;\n  if (lo > ro) return 1;\n  return 0;\n});\n\nreturn cleaned;"
          },
          "outcomes": {
            "success": "1762983496824"
          },
          "code": "CONVERT_LOOP_OUTPUT_TO_VALID_JSON",
