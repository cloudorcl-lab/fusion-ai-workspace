        {
          "metadata": {
            "name": "Validate Final Outline",
            "returnType": "object",
            "sourceCode": "/**\n * ValidateFinalOutline (patched)\n * - Numeric-safe offset handling\n * - O(n log n) sort\n */\n\nvar outline = $context.$variables.finalOutline;\nvar validated = [];\nvar report = [];\n\nif (!Array.isArray(outline)) {\n  return {\n    validatedOutline: [],\n    validationReport: [\"ERROR: finalOutline is not an array\"]\n  };\n}\n\noutline.sort(function (left, right) {\n  var ls = (left && left.startOffset != null) ? Number(left.startOffset) : 9007199254740991;\n  var rs = (right && right.startOffset != null) ? Number(right.startOffset) : 9007199254740991;\n\n  if (isNaN(ls)) ls = 9007199254740991;\n  if (isNaN(rs)) rs = 9007199254740991;\n\n  if (ls < rs) return -1;\n  if (ls > rs) return 1;\n  return 0;\n});\n\nvar lastEnd = -1;\nvar newIndex = 1;\n\nfor (var x = 0; x < outline.length; x++) {\n  var sec = outline[x] || {};\n\n  if (sec.sectionIndex !== newIndex) {\n    report.push(\"Fixed sectionIndex \" + sec.sectionIndex + \" -> \" + newIndex);\n    sec.sectionIndex = newIndex;\n  }\n\n  var text = sec.text ? String(sec.text) : \"\";\n  var textLen = text.length;\n\n  var start = (sec.startOffset != null) ? Number(sec.startOffset) : NaN;\n  var end = (sec.endOffset != null) ? Number(sec.endOffset) : NaN;\n\n  if (isNaN(start) || start < 0) {\n    report.push(\"Missing/invalid startOffset fixed for section \" + newIndex);\n    start = lastEnd + 1;\n  }\n\n  if (isNaN(end)) {\n    report.push(\"Missing/invalid endOffset fixed for section \" + newIndex);\n    end = start + textLen;\n  }\n\n  if (end < start) {\n    report.push(\"Reversed offsets fixed for section \" + newIndex);\n    end = start + textLen;\n  }\n\n  if (start < lastEnd) {\n    report.push(\"Overlap fixed for section \" + newIndex);\n    start = lastEnd + 1;\n    end = start + textLen;\n  }\n\n  sec.startOffset = start;\n  sec.endOffset = end;\n\n  validated.push(sec);\n  lastEnd = end;\n  newIndex = newIndex + 1;\n}\n\nreturn {\n  validatedOutline: validated,\n  validationReport: report\n};"
          },
