        {
          "metadata": {
            "name": "Build Workflow Complete Audit Payload",
            "returnType": "object",
            "sourceCode": "// =====================================================================\n// JavaScript: Build Workflow Audit Save Payload (COMPLETED)\n// Output: WorkflowAgentAuditSaveRequest JSON object\n// =====================================================================\n\nvar payload = {};\n\n// ---------------------------------------------------------------------\n// Required inputs from trigger/system\n// ---------------------------------------------------------------------\nvar contentId = $context.$triggers.REST.$input.contentId;\nvar operation = $context.$triggers.REST.$input.operation;\nvar contentFormat = $context.$triggers.REST.$input.contentFormat;\n\nvar currentTime = Date.now();\nvar nowIso = new Date(Number(currentTime)).toISOString();\nvar conversationId = $context.$workflow.$conversationId;\nvar latestProcessingStatus = \"WORKFLOW_COMPLETED\";\n\n// ---------------------------------------------------------------------\n// Runtime fields (best-effort)\n// ---------------------------------------------------------------------\nvar workflowCode = null;\nvar workflowId = null;\nvar jobId = null;\nvar traceId = null;\n\nvar fileId = null;\nvar fileIndex = null;\n\ntry {\n  if ($context.$workflow) {\n    if ($context.$workflow.$name != null) {\n      workflowCode = $context.$workflow.$name;\n    }\n    if ($context.$workflow.$workflowId != null) {\n      workflowId = $context.$workflow.$workflowId;\n    }\n    if ($context.$workflow.$jobId != null) {\n      jobId = $context.$workflow.$jobId;\n    }\n    if ($context.$workflow.$traceId != null) {\n      traceId = $context.$workflow.$traceId;\n    }\n  }\n\n  if (jobId == null && $context.$job && $context.$job.$id != null) {\n    jobId = $context.$job.$id;\n  }\n  if (jobId == null && $context.$system && $context.$system.$jobId != null) {\n    jobId = $context.$system.$jobId;\n  }\n\n  if ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input) {\n    if ($context.$triggers.REST.$input.fileId != null) {\n      fileId = $context.$triggers.REST.$input.fileId;\n    }\n    if ($context.$triggers.REST.$input.fileIndex != null) {\n      fileIndex = $context.$triggers.REST.$input.fileIndex;\n    }\n  }\n} catch (e) {\n  // ignore - best-effort\n}\n\n// ---------------------------------------------------------------------\n// Normalize strings (trim + null for blank)\n// ---------------------------------------------------------------------\nif (workflowCode != null) { workflowCode = String(workflowCode).trim(); if (workflowCode.length === 0) workflowCode = null; }\nif (workflowId != null) { workflowId = String(workflowId).trim(); if (workflowId.length === 0) workflowId = null; }\nif (jobId != null) { jobId = String(jobId).trim(); if (jobId.length === 0) jobId = null; }\nif (traceId != null) { traceId = String(traceId).trim(); if (traceId.length === 0) traceId = null; }\nif (conversationId != null) { conversationId = String(conversationId).trim(); if (conversationId.length === 0) conversationId = null; }\nif (operation != null) { operation = String(operation).trim(); if (operation.length === 0) operation = null; }\nif (contentFormat != null) { contentFormat = String(contentFormat).trim(); if (contentFormat.length === 0) contentFormat = null; }\nif (fileId != null) { fileId = String(fileId).trim(); if (fileId.length === 0) fileId = null; }\n\n// ---------------------------------------------------------------------\n// Build payload per WorkflowAgentAuditSaveRequest\n// ---------------------------------------------------------------------\nif (workflowCode != null) {\n  payload.workflowCode = workflowCode;\n}\nif (workflowId != null) {\n  payload.workflowId = workflowId;\n}\n\nif (jobId != null) {\n  payload.jobId = jobId;\n}\nif (conversationId != null) {\n  payload.conversationId = conversationId;\n}\nif (traceId != null) {\n  payload.traceId = traceId;\n}\n\nif (operation != null) {\n  payload.operation = operation;\n}\nif (contentFormat != null) {\n  payload.contentFormat = contentFormat;\n}\n\nif (nowIso != null) {\n  payload.processingEnd = nowIso;\n  payload.latestProcessedDate = nowIso;\n}\n\npayload.latestProcessingStatus = latestProcessingStatus;\n\nif (fileId != null) {\n  payload.fileId = fileId;\n}\n\nif (fileIndex != null && String(fileIndex).trim().length > 0) {\n  var idxNum = Number(fileIndex);\n  if (!isNaN(idxNum)) {\n    payload.fileIndex = idxNum;\n  }\n}\n\n// Human-readable completion message\npayload.message =\n  \"[\" + nowIso + \"] \" +\n  latestProcessingStatus +\n  \" - \" +\n  ($context.$nodes.CHECK_IF_RAW_SECTIONS_EXIST.$output.result\n    ? \"Workflow completed successfully.\"\n    : \"No content to process.\");\n\n// ---------------------------------------------------------------------\n// Return payload\n// ---------------------------------------------------------------------\nreturn payload;"
          },
