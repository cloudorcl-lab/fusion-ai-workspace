          "typeSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"NormalizedRefinedSections\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"refinedSections\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"sectionIndex\": {\n                \"type\": \"integer\",\n                \"description\": \"Sequential index of the extracted section\"\n              },\n              \"pageRange\": {\n                \"type\": \"array\",\n                \"items\": { \"type\": \"integer\" },\n                \"description\": \"One or more pages where this section appears\"\n              },\n              \"startOffset\": {\n                \"type\": \"integer\",\n                \"description\": \"Starting character index within the canonical text\"\n              },\n              \"endOffset\": {\n                \"type\": \"integer\",\n                \"description\": \"Ending character index within the canonical text\"\n              },\n              \"heading\": {\n                \"type\": \"string\",\n                \"description\": \"Heading text identified for the section\",\n                \"nullable\": true\n              },\n              \"text\": {\n                \"type\": \"string\",\n                \"description\": \"Raw text content of the section\"\n              },\n              \"type\": {\n                \"type\": \"string\",\n                \"enum\": [\"HEADING\", \"NORMAL\", \"LIST\"],\n                \"description\": \"Detected type of section (heading/body/list)\"\n              },\n              \"topic\": {\n                \"type\": \"string\",\n                \"description\": \"Semantic topic tag assigned by refinement\",\n                \"nullable\": true\n              },\n              \"entities\": {\n                \"type\": \"array\",\n                \"items\": { \"type\": \"string\" },\n                \"description\": \"Detected entities associated with the section\"\n              }\n            },\n            \"required\": [\n              \"sectionIndex\",\n              \"pageRange\",\n              \"startOffset\",\n              \"endOffset\",\n              \"text\",\n              \"type\"\n            ]\n          }\n        }\n      },\n      \"required\": [\"refinedSections\"]\n    }\n  },\n  \"required\": [\"result\"]\n}"
        }
