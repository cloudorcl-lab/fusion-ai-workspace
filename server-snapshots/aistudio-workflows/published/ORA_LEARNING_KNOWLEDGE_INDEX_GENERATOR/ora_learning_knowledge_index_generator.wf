        {
          "metadata": {
            "name": "Build Workflow SCORM File Delete Complete Payload",
            "returnType": "object",
            "sourceCode": "// Build Workflow SCORM File Delete Complete Payload (patched message)\nvar payload = {};\n\nvar operation = $context.$triggers.REST.$input.operation;\nvar contentFormat = $context.$triggers.REST.$input.contentFormat;\n\nvar nowIso = new Date(Number(Date.now())).toISOString();\nvar conversationId = $context.$workflow.$conversationId;\nvar latestProcessingStatus = \"WORKFLOW_COMPLETED\";\n\nvar workflowCode = null;\nvar workflowId = null;\nvar jobId = null;\nvar traceId = null;\n\nvar fileId = null;\nvar fileIndex = null;\n\ntry {\n  if ($context.$workflow) {\n    if ($context.$workflow.$name != null) workflowCode = $context.$workflow.$name;\n    if ($context.$workflow.$workflowId != null) workflowId = $context.$workflow.$workflowId;\n    if ($context.$workflow.$jobId != null) jobId = $context.$workflow.$jobId;\n    if ($context.$workflow.$traceId != null) traceId = $context.$workflow.$traceId;\n  }\n\n  if (jobId == null && $context.$job && $context.$job.$id != null) jobId = $context.$job.$id;\n  if (jobId == null && $context.$system && $context.$system.$jobId != null) jobId = $context.$system.$jobId;\n\n  if ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input) {\n    if ($context.$triggers.REST.$input.fileId != null) fileId = $context.$triggers.REST.$input.fileId;\n    if ($context.$triggers.REST.$input.fileIndex != null) fileIndex = $context.$triggers.REST.$input.fileIndex;\n  }\n} catch (e) {}\n\nif (workflowCode != null) { workflowCode = String(workflowCode).trim(); if (workflowCode.length === 0) workflowCode = null; }\nif (workflowId != null) { workflowId = String(workflowId).trim(); if (workflowId.length === 0) workflowId = null; }\nif (jobId != null) { jobId = String(jobId).trim(); if (jobId.length === 0) jobId = null; }\nif (traceId != null) { traceId = String(traceId).trim(); if (traceId.length === 0) traceId = null; }\nif (conversationId != null) { conversationId = String(conversationId).trim(); if (conversationId.length === 0) conversationId = null; }\nif (operation != null) { operation = String(operation).trim(); if (operation.length === 0) operation = null; }\nif (contentFormat != null) { contentFormat = String(contentFormat).trim(); if (contentFormat.length === 0) contentFormat = null; }\nif (fileId != null) { fileId = String(fileId).trim(); if (fileId.length === 0) fileId = null; }\n\nif (workflowCode != null) payload.workflowCode = workflowCode;\nif (workflowId != null) payload.workflowId = workflowId;\nif (jobId != null) payload.jobId = jobId;\nif (conversationId != null) payload.conversationId = conversationId;\nif (traceId != null) payload.traceId = traceId;\nif (operation != null) payload.operation = operation;\nif (contentFormat != null) payload.contentFormat = contentFormat;\n\nif (nowIso != null) {\n  payload.processingEnd = nowIso;\n  payload.latestProcessedDate = nowIso;\n}\n\npayload.latestProcessingStatus = latestProcessingStatus;\n\nif (fileId != null) payload.fileId = fileId;\nif (fileIndex != null && String(fileIndex).trim().length > 0) {\n  var idxNum = Number(fileIndex);\n  if (!isNaN(idxNum)) payload.fileIndex = idxNum;\n}\n\npayload.message = \"[\" + nowIso + \"] \" + latestProcessingStatus + \" - Workflow completed successfully.\";\nreturn payload;"
          },
          "outcomes": {
            "success": "1771007757100"
          },
          "code": "BUILD_WORKFLOW_SCORM_FILE_DELETE_COMPLETE_PAYLOAD",
