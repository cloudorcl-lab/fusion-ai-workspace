        {
          "metadata": {
            "name": "Build Workflow Start Audit Payload",
            "returnType": "object",
            "sourceCode": "// =====================================================================\n// JavaScript: Build Workflow Audit Save Payload (START)\n// Output: WorkflowAgentAuditSaveRequest JSON object\n// =====================================================================\n\nvar payload = {};\n\n// ---------------------------------------------------------------------\n// Required inputs from trigger/system\n// ---------------------------------------------------------------------\nvar contentId = $context.$triggers.REST.$input.contentId;\nvar operation = $context.$triggers.REST.$input.operation;\nvar contentFormat = $context.$triggers.REST.$input.contentFormat;\n\nvar currentTime = Date.now();\nvar nowIso = new Date(Number(currentTime)).toISOString();\n\nvar conversationId = $context.$workflow.$conversationId;\nvar latestProcessingStatus = \"WORKFLOW_RUNNING\";\n\n// ---------------------------------------------------------------------\n// Best-effort runtime fields (may vary by runtime)\n// ---------------------------------------------------------------------\nvar workflowCode = null;\nvar workflowId = null;\nvar jobId = null;\nvar traceId = null;\n\nvar fileId = null;\nvar fileIndex = null;\n\ntry {\n  if ($context.$workflow) {\n    if ($context.$workflow.$name != null) {\n      workflowCode = $context.$workflow.$name;\n    }\n    if ($context.$workflow.$jobId != null) {\n      jobId = $context.$workflow.$jobId;\n    }\n    if ($context.$workflow.$traceId != null) {\n      traceId = $context.$workflow.$traceId; \n    }\n  }\n\n  if (jobId == null && $context.$job && $context.$job.$id != null) {\n    jobId = $context.$job.$id;\n  }\n  if (jobId == null && $context.$system && $context.$system.$jobId != null) {\n    jobId = $context.$system.$jobId;\n  }\n\n  if ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input) {\n    if ($context.$triggers.REST.$input.fileId != null) {\n      fileId = $context.$triggers.REST.$input.fileId;\n    }\n    if ($context.$triggers.REST.$input.fileIndex != null) {\n      fileIndex = $context.$triggers.REST.$input.fileIndex;\n    }\n  }\n} catch (e) {\n  // ignore - best-effort\n}\n\n// ---------------------------------------------------------------------\n// Normalize strings (no functions): trim + null for blank\n// ---------------------------------------------------------------------\nif (workflowCode != null) {\n  workflowCode = String(workflowCode).trim();\n  if (workflowCode.length === 0) {\n    workflowCode = null;\n  }\n}\nif (workflowId != null) {\n  workflowId = String(workflowId).trim();\n  if (workflowId.length === 0) {\n    workflowId = null;\n  }\n}\nif (jobId != null) {\n  jobId = String(jobId).trim();\n  if (jobId.length === 0) {\n    jobId = null;\n  }\n}\nif (traceId != null) {\n  traceId = String(traceId).trim();\n  if (traceId.length === 0) {\n    traceId = null;\n  }\n}\nif (conversationId != null) {\n  conversationId = String(conversationId).trim();\n  if (conversationId.length === 0) {\n    conversationId = null;\n  }\n}\nif (operation != null) {\n  operation = String(operation).trim();\n  if (operation.length === 0) {\n    operation = null;\n  }\n}\nif (contentFormat != null) {\n  contentFormat = String(contentFormat).trim();\n  if (contentFormat.length === 0) {\n    contentFormat = null;\n  }\n}\nif (nowIso != null) {\n  nowIso = String(nowIso).trim();\n  if (nowIso.length === 0) {\n    nowIso = null;\n  }\n}\nif (fileId != null) {\n  fileId = String(fileId).trim();\n  if (fileId.length === 0) {\n    fileId = null;\n  }\n}\n\n// ---------------------------------------------------------------------\n// Build payload per WorkflowAgentAuditSaveRequest\n// ---------------------------------------------------------------------\nif (workflowCode != null) {\n  payload.workflowCode = workflowCode;\n}\nif (workflowId != null) {\n  payload.workflowId = workflowId;\n}\n\nif (jobId != null) {\n  payload.jobId = jobId;\n}\nif (conversationId != null) {\n  payload.conversationId = conversationId;\n}\nif (traceId != null) {\n  payload.traceId = traceId;\n}\n\nif (operation != null) {\n  payload.operation = operation;\n}\nif (contentFormat != null) {\n  payload.contentFormat = contentFormat;\n}\n\nif (nowIso != null) {\n  payload.processingStart = nowIso;\n}\n\npayload.latestProcessingStatus = latestProcessingStatus;\n\nif (fileId != null) {\n  payload.fileId = fileId;\n}\n\n// fileIndex: set only if numeric\nif (fileIndex != null && String(fileIndex).trim().length > 0) {\n  var idxNum = Number(fileIndex);\n  if (!isNaN(idxNum)) {\n    payload.fileIndex = idxNum;\n  }\n}\n\n// message stored in OBJECT_DETAILS\npayload.message = \"[\" + nowIso + \"] \" + latestProcessingStatus + \" - Workflow running.\";\n\n// ---------------------------------------------------------------------\n// Return payload (caller uses contentId in REST URL)\n// ---------------------------------------------------------------------\nreturn payload;"
          },
          "outcomes": {
            "success": "1770419086462"
          },
          "code": "BUILD_WORKFLOW_START_AUDIT_PAYLOAD",
          "id": "1770423458624",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
