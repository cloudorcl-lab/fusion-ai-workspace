        {
          "metadata": {
            "name": "Normalize Refined Sections",
            "returnType": "object",
            "sourceCode": "/**\n * NormalizeRefinedSections (patched)\n * - Keeps valid non-empty sections\n * - Uses O(n log n) sort by numeric startOffset\n */\n\nvar loopOutput = $context.$variables.refinedSectionsCombined;\nvar cleaned = [];\n\nif (Array.isArray(loopOutput)) {\n  var i = 0;\n  while (i < loopOutput.length) {\n    var sec = loopOutput[i];\n    if (sec && typeof sec.text === \"string\" && sec.text.trim().length > 0) {\n      cleaned.push(sec);\n    }\n    i = i + 1;\n  }\n}\n\ncleaned.sort(function (left, right) {\n  var lx = (left && left.startOffset != null) ? Number(left.startOffset) : 9007199254740991;\n  var rx = (right && right.startOffset != null) ? Number(right.startOffset) : 9007199254740991;\n\n  if (isNaN(lx)) lx = 9007199254740991;\n  if (isNaN(rx)) rx = 9007199254740991;\n\n  if (lx < rx) return -1;\n  if (lx > rx) return 1;\n  return 0;\n});\n\nvar result = { refinedSections: cleaned };\nreturn result;"
          },
          "outcomes": {
            "success": "1762991111511"
          },
          "code": "NORMALIZE_REFINED_SECTIONS",
