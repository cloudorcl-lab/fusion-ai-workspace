        {
          "metadata": {
            "name": "Build Windows",
            "returnType": "object",
            "sourceCode": "/**\n * BuildWindows (patched)\n * Fixes page-span logic when page number is 0.\n */\n\nconst rawSections = $context.$variables.rawSections || [];\nif (!Array.isArray(rawSections) || rawSections.length === 0) {\n  console.warn(\"BuildWindows: No rawSections found. Returning empty array.\");\n  return { windows: [] };\n}\n\nconst MAX_CHARS_PER_WINDOW = 4000;\nconst MAX_PAGES_PER_WINDOW = 2;\n\nconst windows = [];\nlet windowCounter = 1;\n\nlet currentWindow = {\n  windowId: windowCounter,\n  sections: [],\n  pageRange: [],\n  totalChars: 0\n};\n\nfor (let i = 0; i < rawSections.length; i++) {\n  const section = rawSections[i];\n  const textLength = (section.text || \"\").length;\n\n  const wouldExceedChars = currentWindow.totalChars + textLength > MAX_CHARS_PER_WINDOW;\n\n  const combinedPages = [...currentWindow.pageRange];\n  if (Array.isArray(section.pageRange)) {\n    for (let p = 0; p < section.pageRange.length; p++) {\n      const pg = section.pageRange[p];\n      if (!combinedPages.includes(pg)) {\n        combinedPages.push(pg);\n      }\n    }\n  }\n\n  let pageSpan = 0;\n  if (combinedPages.length > 0) {\n    const minPage = Math.min.apply(null, combinedPages);\n    const maxPage = Math.max.apply(null, combinedPages);\n    pageSpan = maxPage - minPage + 1;\n  }\n  const wouldExceedPages = pageSpan > MAX_PAGES_PER_WINDOW;\n\n  if (currentWindow.sections.length > 0 && (wouldExceedChars || wouldExceedPages)) {\n    windows.push(currentWindow);\n    windowCounter++;\n\n    currentWindow = {\n      windowId: windowCounter,\n      sections: [],\n      pageRange: [],\n      totalChars: 0\n    };\n  }\n\n  currentWindow.sections.push(section);\n  currentWindow.totalChars += textLength;\n\n  if (Array.isArray(section.pageRange)) {\n    for (let p = 0; p < section.pageRange.length; p++) {\n      const pg = section.pageRange[p];\n      if (!currentWindow.pageRange.includes(pg)) {\n        currentWindow.pageRange.push(pg);\n      }\n    }\n  }\n}\n\nif (currentWindow.sections.length > 0) {\n  windows.push(currentWindow);\n}\n\nconsole.info(`BuildWindows: Created ${windows.length} windows from ${rawSections.length} sections.`);\nfor (let i = 0; i < windows.length; i++) {\n  const w = windows[i];\n  console.info(`  Window ${w.windowId}: sections=${w.sections.length}, pages=${w.pageRange.join(\",\")}, chars=${w.totalChars}`);\n}\n\nreturn { windows };"
          },
          "outcomes": {
            "success": "1762919248644"
          },
