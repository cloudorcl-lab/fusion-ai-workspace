                {
                  "metadata": {
                    "name": "Prepare Window For LLM",
                    "returnType": "object",
                    "sourceCode": "/**\n * ============================================================================\n * Node: JavaScript  PrepareWindowForLLM\n * Purpose:\n *   Convert each section inside currentWindow into a simplified\n *   payload for LLM refinement.\n *   This script is workflow-agent safe  no functions or returns inside functions.\n *\n * Input :\n *   $context.$nodes.LOOP_OVER_WINDOWS.$currentItem   current window object\n * Output:\n *   return { windowPayload }                         array of simplified section payloads\n * ============================================================================\n */\n\n// --------------------------------------------------------------------------\n// 1 Retrieve current window\n// --------------------------------------------------------------------------\nconst currentWindow = $context.$nodes.LOOP_OVER_WINDOWS.$currentItem;\n\n// Validate input\nif (!currentWindow || !Array.isArray(currentWindow.sections)) {\n  console.warn(\"PrepareWindowForLLM: No valid sections found in current window.\");\n  return { windowPayload: [] };\n}\n\n// --------------------------------------------------------------------------\n// 2 Initialize working variables\n// --------------------------------------------------------------------------\nconst payload = [];\nconst sections = currentWindow.sections;\n\n// --------------------------------------------------------------------------\n// 3 Iterate through each section and build LLM-ready payload\n// --------------------------------------------------------------------------\nfor (let i = 0; i < sections.length; i++) {\n  const s = sections[i];\n\n  const localIndex = i;\n  const globalSectionIndex = s.sectionIndex != null ? s.sectionIndex : i;\n  const type = s.type || \"UNKNOWN\";\n  const heading = s.heading || null;\n  const text = s.text || \"\";\n  const pageRange = Array.isArray(s.pageRange) ? s.pageRange : [];\n  const startOffset = s.startOffset != null ? s.startOffset : 0;\n  const endOffset = s.endOffset != null ? s.endOffset : 0;\n\n  // Construct payload object\n  const item = {\n    localIndex: localIndex,\n    globalSectionIndex: globalSectionIndex,\n    type: type,\n    heading: heading,\n    text: text,\n    pageRange: pageRange,\n    startOffset: startOffset,\n    endOffset: endOffset\n  };\n\n  payload.push(item);\n}\n\n// --------------------------------------------------------------------------\n// 4 Log summary for traceability\n// --------------------------------------------------------------------------\nconsole.info(\n  `PrepareWindowForLLM: Prepared ${payload.length} sections for window ${currentWindow.windowId}.`\n);\n\n// --------------------------------------------------------------------------\n// 5 Return the simplified payload\n// --------------------------------------------------------------------------\nreturn {windowPayload: payload} ;"
                  },
                  "outcomes": {
                    "success": "1762919458300"
                  },
                  "code": "PREPARE_WINDOW_FOR_LLM",
                  "id": "1762919037729",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "modelConfiguration": {
                      "modelProperties": {},
                      "code": "ORA_MODEL_CONFIG_PREMIUM_OPEN_AI_GPT_4_1_MINI",
                      "model": "OCI_GPT_5_MINI",
                      "provider": "CERT_PREMIUM"
                    },
                    "name": "Refine Window Boundaries"
                  },
                  "outcomes": {
                    "success": "1762919885301"
                  },
                  "code": "REFINE_WINDOW_BOUNDARIES",
                  "id": "1762919458300",
                  "inputs": [
                    {
                      "id": "1762919458301_1",
                      "name": "prompt",
                      "type": "string",
                      "value": "You are given a list of RAW semantic sections extracted from learning content.\nThe content may come from:\n- PDF / PPT / DOC-like documents (pageRange + char offsets),\n- Video subtitles / transcripts (startTimestamp/endTimestamp),\n- SCORM packages (HTML/text/PDF/PPT within a ZIP).\n\nCONTENT FORMAT:\n{{$context.$variables.contentFormat}}\n\nThe contentFormat determines how aggressively to merge/split:\n- ORA_VIDEO (video subtitles/transcript): MERGE aggressively to form paragraph-sized chunks.\n- ORA_PDF (PDF): MERGE conservatively; keep paragraphs intact; only merge obvious continuations.\n- ORA_PPT / ORA_PPTX (slides): group by slide and slide headings; merge bullet items into a coherent slide chunk.\n- ORA_ONLINE_COURSE (SCORM content) / ORA_HTML: group by headings/DOM sections; merge short fragments under the same heading.\n- ORA_TEXT: merge into paragraph-sized chunks based on punctuation and topic continuity.\n\n\nEach section has metadata. Some fields may be missing depending on content type.\nPossible fields include:\nlocalIndex, globalSectionIndex, type, heading, text,\npageRange, startOffset, endOffset,\nstartTimestamp, endTimestamp,\nand other optional tags.\n\nYour goal is to produce PARAGRAPH-SIZED, semantically coherent sections (not sentence-sized).\nPrefer grouping adjacent fragments into a single paragraph when they are part of the same idea.\n\nFor each section, decide one action:\n- KEEP: keep as-is (only when it is already a good paragraph/semantic unit OR is a clear boundary)\n- MERGE_WITH_NEXT: merge this section with the next (use for short fragments, continuations, lists that belong together, subtitle fragments)\n- SPLIT: split within this section’s text; provide splitPositions (character offsets within THIS section’s text)\n\nGuidelines to avoid sentence-level splitting:\n- If a section is short (e.g., < 120 characters) and it reads like a clause, phrase, or continuation, choose MERGE_WITH_NEXT.\n- Build merged paragraphs up to a reasonable size (e.g., 400–1200 characters) before using KEEP.\n- For subtitle/timestamp sources: if adjacent sections are within the same thought and their timestamps are close, MERGE_WITH_NEXT aggressively.\n- Start a new paragraph (use KEEP on the prior) when:\n  - a new topic begins,\n  - a heading/module boundary occurs,\n  - a quiz/question/options block begins or ends,\n  - or the merged paragraph would become too long.\n\nCorrect the section type when needed:\nHEADING | NORMAL | LIST | OTHER\n\nExtract:\n- topic: short label for the merged semantic unit\n- entities: key named entities (people, organizations, places, products)\n\nReturn strict JSON matching this schema:\n{\n  \"decisions\": [\n    {\n      \"localIndex\": 0,\n      \"action\": \"KEEP\" | \"MERGE_WITH_NEXT\" | \"SPLIT\",\n      \"splitPositions\": [],\n      \"correctedType\": \"HEADING\" | \"NORMAL\" | \"LIST\" | \"OTHER\",\n      \"topic\": \"short topic label\",\n      \"entities\": [\"Entity1\", \"Entity2\"]\n    }\n  ]\n}\n\nInput chunks:\n{{$context.$nodes.LOOP_OVER_WINDOWS.PREPARE_WINDOW_FOR_LLM.$output.result}}"
                    }
                  ],
                  "type": "LLM"
                },
                {
                  "metadata": {
                    "name": "Apply Window Decisions",
                    "returnType": "object",
                    "sourceCode": "/**\n * Optimized Apply Window Decisions\n * - Builds decision index map once\n * - Supports merge chains\n * - Keeps precedence: LIST > HEADING > NORMAL > UNKNOWN\n * - Preserves offsets, pageRange, timestamps\n */\n\nvar currentWindow = $context.$nodes.LOOP_OVER_WINDOWS.$currentItem;\nvar decisionsObj = $context.$variables.windowDecisions;\n\nvar sections = currentWindow && Array.isArray(currentWindow.sections) ? currentWindow.sections : [];\nvar decisions = decisionsObj && Array.isArray(decisionsObj.decisions) ? decisionsObj.decisions : [];\n\nvar refined = [];\n\nvar typeRank = {\n  \"LIST\": 3,\n  \"HEADING\": 2,\n  \"NORMAL\": 1,\n  \"UNKNOWN\": 0\n};\n\nvar decisionByIndex = {};\nvar dm = 0;\nwhile (dm < decisions.length) {\n  var dec = decisions[dm];\n  if (dec && dec.localIndex != null) {\n    decisionByIndex[String(dec.localIndex)] = dec;\n  }\n  dm = dm + 1;\n}\n\nvar i = 0;\nwhile (i < sections.length) {\n  var startSec = sections[i];\n  var startDec = decisionByIndex[String(i)] || null;\n  var action = startDec && startDec.action ? startDec.action : \"KEEP\";\n\n  if (action !== \"MERGE_WITH_NEXT\") {\n    var newSec = {};\n    for (var k1 in startSec) {\n      if (Object.prototype.hasOwnProperty.call(startSec, k1)) newSec[k1] = startSec[k1];\n    }\n\n    if (startDec && startDec.correctedType) newSec.type = startDec.correctedType;\n    if (startDec && startDec.topic) newSec.topic = startDec.topic;\n    if (startDec && startDec.entities) newSec.entities = startDec.entities;\n\n    refined.push(newSec);\n    i = i + 1;\n    continue;\n  }\n\n  var mergedText = startSec.text || \"\";\n  var mergedStart = (startSec.startOffset != null) ? Number(startSec.startOffset) : null;\n  var mergedEnd = (startSec.endOffset != null) ? Number(startSec.endOffset) : null;\n\n  if (mergedStart != null && isNaN(mergedStart)) mergedStart = null;\n  if (mergedEnd != null && isNaN(mergedEnd)) mergedEnd = null;\n\n  var mergedPages = [];\n  var pageSeen = {};\n  var sp = Array.isArray(startSec.pageRange) ? startSec.pageRange : [];\n  var p0 = 0;\n  while (p0 < sp.length) {\n    var pg0 = sp[p0];\n    var key0 = String(pg0);\n    if (!pageSeen[key0]) {\n      pageSeen[key0] = true;\n      mergedPages.push(pg0);\n    }\n    p0 = p0 + 1;\n  }\n\n  var mergedStartTs = (startSec.startTimestamp != null) ? String(startSec.startTimestamp).trim() : \"\";\n  var mergedEndTs = (startSec.endTimestamp != null) ? String(startSec.endTimestamp).trim() : \"\";\n\n  var bestType = startDec && startDec.correctedType ? startDec.correctedType : (startSec.type || \"UNKNOWN\");\n  var bestTopic = startDec ? startDec.topic : null;\n  var bestEntities = startDec ? startDec.entities : null;\n  var bestRank = typeRank[bestType] || 0;\n\n  var j = i + 1;\n  while (j < sections.length) {\n    var nextSec = sections[j];\n    var nextDec = decisionByIndex[String(j)] || null;\n    var nextAction = nextDec && nextDec.action ? nextDec.action : \"KEEP\";\n\n    mergedText = (mergedText + \" \" + (nextSec.text || \"\")).trim();\n\n    var nsStart = (nextSec.startOffset != null) ? Number(nextSec.startOffset) : null;\n    var nsEnd = (nextSec.endOffset != null) ? Number(nextSec.endOffset) : null;\n\n    if (nsStart != null && isNaN(nsStart)) nsStart = null;\n    if (nsEnd != null && isNaN(nsEnd)) nsEnd = null;\n\n    if (nsStart != null) {\n      if (mergedStart == null || nsStart < mergedStart) mergedStart = nsStart;\n    }\n    if (nsEnd != null) {\n      if (mergedEnd == null || nsEnd > mergedEnd) mergedEnd = nsEnd;\n    }\n\n    var nsStartTs = (nextSec.startTimestamp != null) ? String(nextSec.startTimestamp).trim() : \"\";\n    var nsEndTs = (nextSec.endTimestamp != null) ? String(nextSec.endTimestamp).trim() : \"\";\n\n    if (mergedStartTs.length === 0 && nsStartTs.length > 0) mergedStartTs = nsStartTs;\n    if (nsEndTs.length > 0) mergedEndTs = nsEndTs;\n\n    var np = Array.isArray(nextSec.pageRange) ? nextSec.pageRange : [];\n    var p = 0;\n    while (p < np.length) {\n      var pg = np[p];\n      var key = String(pg);\n      if (!pageSeen[key]) {\n        pageSeen[key] = true;\n        mergedPages.push(pg);\n      }\n      p = p + 1;\n    }\n\n    var nextType = (nextDec && nextDec.correctedType) ? nextDec.correctedType : (nextSec.type || \"UNKNOWN\");\n    var nextRank = typeRank[nextType] || 0;\n    if (nextRank > bestRank) {\n      bestType = nextType;\n      bestTopic = nextDec ? nextDec.topic : null;\n      bestEntities = nextDec ? nextDec.entities : null;\n      bestRank = nextRank;\n    }\n\n    if (nextAction !== \"MERGE_WITH_NEXT\") {\n      j = j + 1;\n      break;\n    }\n\n    j = j + 1;\n  }\n\n  var merged = {};\n  for (var k2 in startSec) {\n    if (Object.prototype.hasOwnProperty.call(startSec, k2)) merged[k2] = startSec[k2];\n  }\n\n  merged.text = mergedText;\n  merged.startOffset = mergedStart;\n  merged.endOffset = mergedEnd;\n  merged.pageRange = mergedPages;\n  merged.type = bestType;\n\n  if (bestTopic) merged.topic = bestTopic;\n  if (bestEntities) merged.entities = bestEntities;\n  if (mergedStartTs.length > 0) merged.startTimestamp = mergedStartTs;\n  if (mergedEndTs.length > 0) merged.endTimestamp = mergedEndTs;\n\n  refined.push(merged);\n  i = j;\n}\n\nvar winId = currentWindow && currentWindow.windowId ? currentWindow.windowId : \"UNKNOWN\";\nconsole.info(\"ApplyWindowDecisions: Window \" + winId + \" refined sections=\" + refined.length);\n\nvar result = { refinedSections: refined };\nresult;"
                  },
                  "outcomes": {
                    "success": "end_1762918642644"
                  },
                  "code": "APPLY_WINDOW_DECISIONS",
                  "id": "1762919628293",
