          },
          "code": "GET_GIG_DETAILS",
          "id": "1768051740602",
          "inputs": [
            {
              "id": "1768051761149_1",
              "name": "recruitingOppMktGigDetails_Id",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.OpportunityId}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"GigId\": {\"type\": \"string\"},\n          \"GigNumber\": {\"type\": \"string\"},\n          \"CreatorPersonId\": {\"type\": \"string\"},\n          \"GeographyNodeId\": {\"type\": \"string\"},\n          \"StartDate\": {\"type\": \"string\", \"format\": \"date-time\"},\n          \"EndDate\": {\"type\": \"string\", \"format\": \"date-time\"},\n          \"PublishDate\": {\"type\": \"string\", \"format\": \"date-time\"},\n          \"TimeCommitment\": {\"type\": \"integer\"},\n          \"RemoteOpportunityFlag\": {\"type\": \"boolean\"},\n          \"StatusCode\": {\"type\": \"string\"},\n          \"OrganizationId\": {\"type\": \"string\"},\n          \"Title\": {\"type\": \"string\"},\n          \"DescriptionStr\": {\"type\": \"string\"},\n          \"Location\": {\"type\": \"string\"},\n          \"CreatorName\": {\"type\": \"string\"},\n          \"CreatorEmail\": {\"type\": \"string\"},\n          \"CreatorPhoneNumber\": {\"type\": \"string\"},\n          \"CreatorPosition\": {\"type\": \"string\"},\n          \"BookmarkFlag\": {\"type\": \"boolean\"},\n          \"HasAppliedFlag\": {\"type\": \"boolean\"},\n          \"GigValidFlag\": {\"type\": \"boolean\"},\n          \"ProfileId\": {\"type\": [\"string\", \"null\"]},\n          \"FilledCount\": {\"type\": \"integer\"},\n          \"OpeningsCount\": {\"type\": \"integer\"},\n          \"PendingApprovalAppsCount\": {\"type\": \"integer\"},\n          \"NewApplicationsCount\": {\"type\": \"integer\"},\n          \"NotSelectedApplicationsCount\": {\"type\": \"integer\"},\n          \"CanceledApplicationsCount\": {\"type\": \"integer\"},\n          \"CompletedApplicationsCount\": {\"type\": \"integer\"},\n          \"TotalApplicationsCount\": {\"type\": \"integer\"},\n          \"ClassifyBUId\": {\"type\": [\"string\", \"null\"]},\n          \"ClassifyJobFamilyId\": {\"type\": [\"string\", \"null\"]},\n          \"ClassifyJobFuncCode\": {\"type\": [\"string\", \"null\"]},\n          \"ClassifyOrgId\": {\"type\": [\"string\", \"null\"]},\n          \"GigManagerPersonId\": {\"type\": \"string\"},\n          \"ClassifyBUName\": {\"type\": [\"string\", \"null\"]},\n          \"ClassifyOrgName\": {\"type\": [\"string\", \"null\"]},\n          \"ClassifyJobFamilyName\": {\"type\": [\"string\", \"null\"]},\n          \"ClassifyJobFuncName\": {\"type\": [\"string\", \"null\"]},\n          \"GigManagerName\": {\"type\": \"string\"},\n          \"GigManagerEmail\": {\"type\": \"string\"},\n          \"GigManagerPhoneNumber\": {\"type\": \"string\"},\n          \"GigManagerPosition\": {\"type\": \"string\"},\n          \"benefits\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"items\": {\"type\": \"array\", \"items\": {}},\n              \"count\": {\"type\": \"integer\"},\n              \"hasMore\": {\"type\": \"boolean\"},\n              \"limit\": {\"type\": \"integer\"},\n              \"offset\": {\"type\": \"integer\"}\n            },\n            \"required\": [\"items\", \"count\", \"hasMore\", \"limit\", \"offset\"]\n          },\n          \"teamMembers\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"items\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"TeamMemberId\": {\"type\": \"string\"},\n                    \"TeamMemberPersonId\": {\"type\": \"string\"},\n                    \"OpportunityType\": {\"type\": \"string\"},\n                    \"TeamMemberRole\": {\"type\": \"string\"},\n                    \"TeamMemberName\": {\"type\": \"string\"},\n                    \"TeamMemberPhoneNumber\": {\"type\": \"string\"},\n                    \"TeamMemberEmailAddress\": {\"type\": \"string\"}\n                  },\n                  \"required\": [\n                    \"TeamMemberId\",\n                    \"TeamMemberPersonId\",\n                    \"OpportunityType\",\n                    \"TeamMemberRole\",\n                    \"TeamMemberName\",\n                    \"TeamMemberPhoneNumber\",\n                    \"TeamMemberEmailAddress\"\n                  ]\n                }\n              },\n              \"count\": {\"type\": \"integer\"},\n              \"hasMore\": {\"type\": \"boolean\"},\n              \"limit\": {\"type\": \"integer\"},\n              \"offset\": {\"type\": \"integer\"}\n            },\n            \"required\": [\"items\", \"count\", \"hasMore\", \"limit\", \"offset\"]\n          },\n          \"gigSkills\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"items\": {\"type\": \"array\", \"items\": {}},\n              \"count\": {\"type\": \"integer\"},\n              \"hasMore\": {\"type\": \"boolean\"},\n              \"limit\": {\"type\": \"integer\"},\n              \"offset\": {\"type\": \"integer\"}\n            },\n            \"required\": [\"items\", \"count\", \"hasMore\", \"limit\", \"offset\"]\n          }\n        },\n        \"required\": [\n          \"GigId\", \"GigNumber\", \"CreatorPersonId\", \"GeographyNodeId\", \"StartDate\", \"EndDate\", \"PublishDate\", \"TimeCommitment\",\n          \"RemoteOpportunityFlag\", \"StatusCode\", \"OrganizationId\", \"Title\", \"DescriptionStr\", \"Location\",  \"CreatorName\", \"CreatorEmail\", \"CreatorPhoneNumber\", \"CreatorPosition\",\n          \"BookmarkFlag\", \"HasAppliedFlag\", \"GigValidFlag\", \"ProfileId\",\n          \"FilledCount\", \"OpeningsCount\", \"PendingApprovalAppsCount\", \"NewApplicationsCount\",\n          \"NotSelectedApplicationsCount\", \"CanceledApplicationsCount\", \"CompletedApplicationsCount\", \"TotalApplicationsCount\",\n          \"ClassifyBUId\", \"ClassifyJobFamilyId\", \"ClassifyJobFuncCode\", \"ClassifyOrgId\",\n          \"GigManagerPersonId\", \"ClassifyBUName\", \"ClassifyOrgName\", \"ClassifyJobFamilyName\", \"ClassifyJobFuncName\",\n          \"GigManagerName\", \"GigManagerEmail\", \"GigManagerPhoneNumber\", \"GigManagerPosition\",\n          \"benefits\", \"teamMembers\", \"gigSkills\"\n        ]\n      }\n    }\n  },\n  \"required\": [\"items\"]\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Return Gig Details",
            "returnType": "object",
            "sourceCode": "const gig = $context.$nodes.GET_GIG_DETAILS.$output || {};\n\nconst result = JSON.parse(\n  JSON.stringify(gig, (key, value) => {\n    const exclusions = ['links', '@context', 'count', 'hasMore', 'limit', 'offset', 'CreatorPersonId', 'GeographyNodeId', \n                     'OrganizationId', 'ProfileId', 'ClassifyBUId', 'ClassifyJobFamilyId', 'ClassifyOrgId', 'GigManagerPersonId',\n                     'BenefitId', 'TeamMemberId', 'TeamMemberPersonId', 'OpportunityType', 'SkillId', 'SectionId', 'ContentItemId'];\n    \n    if (exclusions.includes(key)) {\n      return undefined;\n    }\n    return value;\n  })\n);\n\nreturn result;"
          },
          "outcomes": {
            "success": "1768221880658"
          },
          "code": "RETURN_GIG_DETAILS",
          "id": "1768052716440",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get Employee Profile",
            "workflowCode": "ORA_HCM_IRC_CANDIDATE_PROFILE_SUMMARY_GENERATOR"
          },
          "outcomes": {
            "success": "1767951625730"
          },
          "code": "GET_EMPLOYEE_PROFILE",
          "id": "1768055063626",
          "inputs": [
            {
              "id": "1768055114016_1",
              "name": "message",
              "type": "string",
              "value": "Retrieve the employee profile using the requested ProfileType."
            },
            {
              "id": "1768055114017_2",
              "name": "ProfileType",
              "type": "string",
              "value": "FULL"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
        },
        {
          "metadata": {
            "name": "Summarize Match with Profile"
          },
          "outcomes": {
            "success": "1768236647843"
          },
          "code": "SUMMARIZE_MATCH_WITH_PROFILE",
          "convergenceTargetId": "end",
          "id": "1768055821800",
          "inputs": [
            {
              "id": "1768055821805_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an AI assistant helping an employee evaluate how well their skills match a suggested opportunity. Your goal is to neatly display the alignment between the employee’s profile and the requirements or benefits of the opportunity.  \n\nFormat the output for clarity, and make sure to suggest action items if the match is strong.\n\n**Inputs:**  \nEmployeeSkills:\n{{$context.$nodes.GET_EMPLOYEE_SKILLS.$output.result}} \nOpportunity (Gig or Job):  \n{{$context.$nodes.OPPORTUNITY_DETAILS_FOR_COMPARISON.$output.result}} \nThe opportunity (Gig or Job) contains fields such as:\nTitle\nDescription\nEmployerDescriptionStr, \nDescriptionStr, etc.\n\n##WHAT THE AGENT MUST DO\n1. Extract Skills From the Opportunity\nFrom the Title, Description, and other text fields:\n- Identify technology skills\n- Domain skills\n- Tools\n- Certifications\n- Industry-specific keywords\n- Action skills (e.g., “project management”, “customer handling”)\n- Normalize terms (e.g., “JS” → “JavaScript”)\n\n2. Compare With EmployeeSkills\nFor the opportunity:\n- MatchedSkills → which employee skills appear in the opportunity\n- PartialMatches → close semantic matches\n   (e.g., “databases” ~ “MySQL”, “cloud” ~ “AWS”)\n- RelevanceScore (0–100)\n   Formula should consider:\n   - matched skills\n   - weight partial matches lower\n   - keyword importance in Title or Description\n\n\n**Your formatted output should look like this:**  \n---\n**Opportunity Match Summary**  \n- Overall compatibility: [Excellent/Very Good/Good/Moderate] use the RelevanceScore for this purpose.\n- Key alignment areas: [List major matching points in a brief sentence]  \n- Relevance score\n\n**Match Summary**  \nExplain relevance using the match score, skill alignment, experience fit, and career growth. When mentioning skills, always format them in title case with each word capitalized (e.g., “System Design”, “Spring Boot”, “Java”), and do not use lowercase skill names. Use only 3 to 4 sentences in second person reference and use a positive but realistic tone to bridge any gaps.\n\n**Actionable Next Steps**  \n- [If an excellent or very good match, advise to consider applying and highlight the strongest factors]  \n- [If moderate, suggest to look at skill gaps.]\n\nGiven the provided employee profile and opportunity JSON, generate a comparative analysis summary. Keep the language concise and actionable and return the result as JSON. Return only the JSON content, no code blocks or extra text around the JSON object."
            }
          ],
          "outputSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"OpportunityMatchSummary\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"OverallCompatibility\": { \"type\": \"string\" },\n        \"KeyAlignmentAreas\": { \"type\": \"string\" },\n        \"RelevanceScore\": { \"type\": \"string\" }\n      },\n      \"required\": [\n        \"OverallCompatibility\",\n        \"KeyAlignmentAreas\",\n        \"RelevanceScore\"\n      ]\n    },\n    \"DetailedAnalysis\": { \"type\": \"string\" },\n    \"ActionableNextSteps\": { \"type\": \"string\" }\n  },\n  \"required\": [\n    \"OpportunityMatchSummary\",\n    \"DetailedAnalysis\",\n    \"ActionableNextSteps\"\n  ]\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Get Opportunity Object",
            "returnType": "object",
            "sourceCode": "return $context.$triggers.REST.$input.OpportunityType == 'Job' ? $context.$nodes.RETURN_JOB_DETAILS.$output.result : $context.$nodes.RETURN_GIG_DETAILS.$output.result;"
          },
          "outcomes": {
            "success": "1768303742691"
          },
          "code": "GET_OPPORTUNITY_OBJECT",
          "id": "1768221880658",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Combine Opportunity and Match Details",
            "returnType": "object",
            "sourceCode": "const matchDetails = $context.$nodes.SUMMARIZE_MATCH_WITH_PROFILE.$output;\nconst opportunity = $context.$nodes.GET_OPPORTUNITY_OBJECT.$output.result;\nconst profile = $context.$nodes.GET_EMPLOYEE_PROFILE.$output.output;\nopportunity.OpportunityMatchDetails = matchDetails;\nopportunity.OpportunityType = $context.$triggers.REST.$input.OpportunityType;\nopportunity.EmployeeProfile = JSON.parse(profile).result;\nreturn opportunity;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "COMBINE_OPPORTUNITY_AND_MATCH_DETAILS",
          "id": "1768236647843",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Opportunity Details for Comparison",
            "returnType": "object",
            "sourceCode": "const opportunity = $context.$nodes.GET_OPPORTUNITY_OBJECT.$output.result;\nconst details = {\n    Title: opportunity.Title,\n    DescriptionStr: opportunity.DescriptionStr,\n    EmployerDescriptionStr: opportunity.EmployerDescriptionStr\n};\n\nreturn details;"
          },
          "outcomes": {
            "success": "1768305245579"
          },
          "code": "OPPORTUNITY_DETAILS_FOR_COMPARISON",
          "id": "1768303742691",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get Employee Skills",
            "returnType": "object",
            "sourceCode": "const profile = $context.$nodes.GET_EMPLOYEE_PROFILE.$output.output;\nreturn JSON.parse(profile).result.Skills;"
          },
          "outcomes": {
            "success": "1768055821800"
          },
          "code": "GET_EMPLOYEE_SKILLS",
          "id": "1768305245579",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
