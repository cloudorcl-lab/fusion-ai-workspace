            "returnType": "object",
            "sourceCode": "const result = JSON.parse(\n  JSON.stringify($context.$nodes.GET_JOB_DETAILS.$output.items[0], (key, value) => {\n    // List of metadata keys to remove\n    const exclude = ['links', '@context', 'count', 'hasMore', 'limit', 'offset'];\n    \n    if (exclude.includes(key)) {\n      return undefined;\n    }\n    return value;\n  })\n);\n\nreturn result;"
