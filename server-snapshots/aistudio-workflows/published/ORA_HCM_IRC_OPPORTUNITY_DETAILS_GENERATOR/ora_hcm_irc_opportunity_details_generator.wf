        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_RECRUITING_ICCGETGIGDETAILS",
            "functionName": "get_recruitingOppMktGigDetails",
            "name": "Get Gig Details"
          },
          "outcomes": {
