        {
          "metadata": {
            "name": "SetKnowledgeOutput",
            "returnType": "object",
            "sourceCode": "const knowledgeOutput = $context.$nodes.GETKNOWLEDGEARTICLE.$output?.items?.[0];\nlet knowledgeTriage = {};\nif (knowledgeOutput) {\n  let excerpt = String(knowledgeOutput.excerpt || \"\");\n  excerpt = excerpt.replace(/<[^>]*>/g, \"\");\n  excerpt = excerpt.replace(/\\\\n|\\r\\n|\\n|\\r/g, \" \");\n  excerpt = excerpt.replace(/\\s+/g, \" \").trim();\n  knowledgeTriage = {\n    'documentId': knowledgeOutput.documentId,\n    'excerpt': excerpt\n  }\n}\nreturn knowledgeTriage;"
          },
          "outcomes": {
            "success": "1765530730758"
          },
          "code": "SETKNOWLEDGEOUTPUT",
          "id": "1765530640650",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
