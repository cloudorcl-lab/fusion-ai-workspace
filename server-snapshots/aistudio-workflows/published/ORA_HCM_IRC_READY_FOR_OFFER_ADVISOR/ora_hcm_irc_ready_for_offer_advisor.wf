            "sourceCode": "const allFeedbacks = $context.$nodes.PROCESS_FEEDBACKS.$output.result;\n\nconst readyFeedbacks = $context.$nodes.FEEDBACK_QUESTIONAIRE_LOOP.$output.map(str2 => {\n    try {\n      return JSON.parse(str2).result;\n    } catch (e) {\n      return undefined;\n    }\n  }).filter(result => result !== undefined);\n\nconst result = {allFeedbacks, readyFeedbacks}\n\nreturn result;"
