        {
          "metadata": {
            "name": "PROCESS_DATA",
            "returnType": "array",
            "sourceCode": "const completedFeedbacks =  $context.$nodes.PROCESS_FEEDBACKS.$output.result.completed;\n\nconst nextActions = $context.$nodes.NEXT_BEST_ACTION_LOOP.$output.map(str2 => {\n    try {\n        return JSON.parse(str2).result;\n    } catch (err) {\n        return null;\n    }\n}).filter(action => action !== null)\n\ncompletedFeedbacks.forEach(completedFeedback => {\n  const nextAction = nextActions.find(obj => String(obj.SubmissionId) === String(completedFeedback.SubmissionId));\n  if (nextAction) {\n     completedFeedback.AllowedToMoveForward = nextAction.showMoveForward;\n     completedFeedback.NextPhase = nextAction.nextPhaseName;\n     completedFeedback.NextState = nextAction.nextStateName;\n  }\n})\n\nconst result = completedFeedbacks.filter(action => action.AllowedToMoveForward === 'Y')\n\nreturn result"
          },
          "outcomes": {
            "success": "1768582155907"
          },
          "code": "PROCESS_DATA",
          "id": "1768581931523",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
