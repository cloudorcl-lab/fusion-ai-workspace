        {
          "metadata": {
            "name": "PROCESS_FEEDBACKS",
            "returnType": "object",
            "sourceCode": "var requisitionsFeedbacks = $context.$nodes.REQUISITIONS_FEEDBACKS_LOOP.$output;\n\n// 1. Initialize grouping containers\nvar groups = {\n    \"ORA_COMPLETED\": {},\n    \"ORA_REQUESTED\": {},\n    \"ORA_SAVED\": {}\n};\n\n// 2. Parse and Group Data\n// We use standard for loops to avoid .forEach callbacks which require 'function'\nfor (var i = 0; i < requisitionsFeedbacks.length; i++) {\n    var requisitionFeedbacksResStr = requisitionsFeedbacks[i];\n    var requisitionFeedbacksRes = {};\n    \n    try {\n        requisitionFeedbacksRes = JSON.parse(requisitionFeedbacksResStr);\n    } catch (e) {\n        continue;\n    }\n\n    var items = requisitionFeedbacksRes.items || [];\n    if (items.length === 0) continue;\n\n    for (var j = 0; j < items.length; j++) {\n        var feedback = items[j];\n\n        // Mapped Item\n        var mappedItem = {\n            RequisitionTitle: feedback.RequisitionTitle,\n            RequisitionNumber: feedback.RequisitionNumber,\n            RequisitionId: feedback.RequisitionId || '',\n            CandidateName: feedback.CandidateName,\n            SubmissionId: feedback.SubmissionId,\n            StatusTypeCodeName: feedback.StatusTypeCodeName,\n            FeedbackRequestId: feedback.FeedbackRequestId,\n            QuestionnaireId: feedback.QuestionnaireId,\n            QuestionnaireResponseId: (feedback.questionnaireResponses && feedback.questionnaireResponses.items && feedback.questionnaireResponses.items.length > 0) ? feedback.questionnaireResponses.items[0].QuestionnaireResponseId : null,\n            AverageRating: feedback.AverageFeedbackRating || '',\n            TotalScore: feedback.TotalScore || '',\n            MaximumPossibleScore: feedback.MaximumPossibleScore || '',\n            ParticipantName: feedback.ParticipantName,\n            ParticipantPersonId: feedback.ParticipantId\n        };\n\n        // Group by Status and Requisition Number\n        var status = feedback.StatusTypeCode;\n        var reqKey = feedback.RequisitionNumber || \"Unknown\";\n\n        if (groups[status]) {\n            if (!groups[status][reqKey]) {\n                groups[status][reqKey] = [];\n            }\n            groups[status][reqKey].push(mappedItem);\n        }\n    }\n}\n\n// 3. Round-Robin Selection (Inlined Logic)\n// We iterate over the 3 categories manually to avoid functions\nvar categories = [\"ORA_COMPLETED\", \"ORA_REQUESTED\", \"ORA_SAVED\"];\nvar finalOutput = {\n    completed: [],\n    requested: [],\n    saved: []\n};\nvar mapStatusToKey = {\n    \"ORA_COMPLETED\": \"completed\",\n    \"ORA_REQUESTED\": \"requested\",\n    \"ORA_SAVED\": \"saved\"\n};\n\nfor (var k = 0; k < categories.length; k++) {\n    var catStatus = categories[k];\n    var outputKey = mapStatusToKey[catStatus];\n    var catGroups = groups[catStatus];\n    var reqKeys = Object.keys(catGroups);\n    var hasMore = true;\n\n    // Keep cycling until we hit 30 or run out of items\n    while (finalOutput[outputKey].length < 30 && hasMore) {\n        hasMore = false;\n        \n        for (var m = 0; m < reqKeys.length; m++) {\n            var rKey = reqKeys[m];\n            if (catGroups[rKey].length > 0) {\n                // Take the first item from this requisition's list\n                var itemToMove = catGroups[rKey].shift();\n                finalOutput[outputKey].push(itemToMove);\n                hasMore = true;\n\n                if (finalOutput[outputKey].length === 30) break;\n            }\n        }\n    }\n}\n\nreturn finalOutput;"
          },
          "outcomes": {
            "success": "1768581650148"
          },
          "code": "PROCESS_FEEDBACKS",
          "id": "1768581498716",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
