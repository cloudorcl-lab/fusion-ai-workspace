                {
                  "metadata": {
                    "businessObjectCode": "ORA_HCM_RECRUITING_HTFEEDBACKQUEST",
                    "functionName": "Ge_Interview_Questionnaire_Response",
                    "processJson": true,
                    "name": "FEEDBACK_QUESTIONAIRE"
                  },
                  "outcomes": {
                    "success": "1768582324056"
                  },
                  "code": "FEEDBACK_QUESTIONAIRE",
                  "id": "1768582223321",
                  "inputs": [
                    {
                      "id": "1768582249138_1",
                      "name": "questionnaireId",
                      "type": "string",
                      "value": "{{$context.$nodes.FEEDBACK_QUESTIONAIRE_LOOP.$currentItem.QuestionnaireId}}"
                    },
                    {
                      "id": "1768582249139_2",
                      "name": "contextId",
                      "type": "string",
                      "value": "{{$context.$nodes.FEEDBACK_QUESTIONAIRE_LOOP.$currentItem.FeedbackRequestId}}"
                    }
                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "PROCESS_FEEDBACK_QUESTIONAIRE",
                    "returnType": "array",
                    "sourceCode": "const currentItem = $context.$nodes.FEEDBACK_QUESTIONAIRE_LOOP.$currentItem;\nconst response = $context.$nodes.FEEDBACK_QUESTIONAIRE_LOOP.FEEDBACK_QUESTIONAIRE.$output;\n\nconst questionnaireResponseId =\n  response?.components?.schemas?.Questionnaire?.[\"x-hints\"]?.questionnaireResponseId;\n\nconst questions =\n  response?.components?.schemas?.Questionnaire?.[\"x-hints\"]?.sections?.[0]?.questions ?? [];\n\nconst questionAnswer = [];\n\n// Loop through each question\nfor (const question of questions) {\n  let answer = \"\";\n\n  if (question.renderType === \"PLAIN_TEXT\") {\n    // For plain text, get textAnswer\n    answer = question.textAnswer ?? \"\";\n  } else if (question.renderType === \"SINGLE_CHOICE_LIST\") {\n    // Single choice: some payloads use questionAnswerCode (single), some use questionAnswerCodes (array)\n    const chosenCode =\n      question.questionAnswerCode ??\n      (Array.isArray(question.questionAnswerCodes) && question.questionAnswerCodes.length > 0\n        ? question.questionAnswerCodes[0]\n        : null);\n\n    if (chosenCode) {\n      const matchedAnswer = (question.availableAnswers ?? []).find(a => a.answerCode === chosenCode);\n      answer = matchedAnswer ? matchedAnswer.answerLabel : \"\";\n    }\n  } else if (question.renderType === \"MULTIPLE_CHOICE_CHECK\") {\n    // Multi choice: questionAnswerCodes (array)\n    const codes = Array.isArray(question.questionAnswerCodes) ? question.questionAnswerCodes : [];\n    const labels = [];\n\n    for (const code of codes) {\n      const matchedAnswer = (question.availableAnswers ?? []).find(a => a.answerCode === code);\n      labels.push(matchedAnswer ? matchedAnswer.answerLabel : \"\");\n    }\n\n    answer = labels.filter(Boolean).join(\", \");\n  }\n\n  questionAnswer.push({\n    question: question.title,\n    answer: answer\n  });\n}\n\nconst processedResponse = {\n  ...currentItem,\n  QuestionnaireResponseId: questionnaireResponseId,\n  Responses: questionAnswer\n};\n\nreturn processedResponse;"
                  },
                  "outcomes": {
                    "success": "end_1768582155907"
                  },
