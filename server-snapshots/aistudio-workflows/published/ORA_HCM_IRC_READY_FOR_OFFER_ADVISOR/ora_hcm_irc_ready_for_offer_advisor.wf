        {
          "metadata": {
            "name": "parseReqArray",
            "returnType": "array",
            "sourceCode": "var inputPayload = $context.$nodes.TOP6REQS.$output;\nvar data = (typeof inputPayload === 'string') ? JSON.parse(inputPayload) : inputPayload;\nvar requisitionIds = [];\n\nif (data && data.result && Array.isArray(data.result.items)) {\n    // Iterate through items and map them to their RequisitionId\n    requisitionIds = data.result.items.map(function(item) {\n        return item.RequisitionId;\n    });\n}\n\nreturn requisitionIds;"
