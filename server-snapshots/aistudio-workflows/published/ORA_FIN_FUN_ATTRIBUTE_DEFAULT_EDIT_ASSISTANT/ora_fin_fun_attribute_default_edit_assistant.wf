                            "sourceCode": "// Get the current item from the loop\nvar currentItem = $context.$nodes.LOOP_REST_CALLS.$currentItem ;\n\n// Get the API response\nconst apiResponse = $context.$nodes.LOOP_REST_CALLS.GETBUDETAILS.$output;\n\n// Extract the bid from the API response\nlet valueKey = null;\n\nif (apiResponse && apiResponse.items && apiResponse.items.length > 0) {\n  valueKey = apiResponse.items[0].BusinessUnitId;\n}\ncurrentItem.resolvedValueKey=valueKey ;\n\n\n\nconst attrLookupKey= currentItem.attributeKey; \nconst attrLookupValue= currentItem.attributeValue;\n\n\n$context.$variables.pAttributeValueLookup ||= {};\n\n$context.$variables.pAttributeValueLookup[attrLookupKey] = {\n  [attrLookupValue]: valueKey\n};\n\ncurrentItem.depResolvedValueKey = $context.$variables.pAttributeValueLookup?.[attrLookupKey]?.[attrLookupValue];\n\n\nreturn currentItem ;"
                          },
