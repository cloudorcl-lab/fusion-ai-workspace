          "outcomes": {
            "success": "1774424538892"
          },
          "code": "ATTRIBUTE_BUILD_LOOP",
          "id": "1774421387394",
          "inputs": [
            {
              "id": "1774421387399_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.PREPROCESS_FOR_ATTRIBUTE_VALUES.$output.result[0].json.waves}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "Get Attribute Values",
            "returnType": "object",
            "sourceCode": "const transformed = [];\n\ntry {\n  const raw = $context.$nodes.ATTRIBUTE_BUILD_LOOP.$output;\n\n  if (!raw) {\n    return [{ json: { result: transformed } }];\n  }\n\n  // raw is array of strings — each string is a stringified array\n  // loop over ALL raw items and collect into one flat level2\n  const level2 = [];\n\n  const rawArray = Array.isArray(raw) ? raw : [raw];\n\n  for (let r = 0; r < rawArray.length; r++) {\n    try {\n      let item = rawArray[r];\n\n      // Each item is a stringified array — parse it\n      if (typeof item === \"string\") {\n        item = JSON.parse(item);\n      }\n\n      // item is now an array — parse each element and add to level2\n      if (Array.isArray(item)) {\n        for (let s = 0; s < item.length; s++) {\n          try {\n            let inner = item[s];\n            if (typeof inner === \"string\") {\n              inner = JSON.parse(inner);\n            }\n            if (inner) level2.push(inner);\n          } catch(e) {\n            continue;\n          }\n        }\n      } else if (item) {\n        level2.push(item);\n      }\n    } catch(e) {\n      continue;\n    }\n  }\n\n  // iterate and parse each item\n  for (let i = 0; i < level2.length; i++) {\n    let parsed = null;\n\n    try {\n      if (typeof level2[i] === \"string\") {\n        parsed = JSON.parse(level2[i]);\n      } else if (typeof level2[i] === \"object\" && level2[i] !== null) {\n        parsed = level2[i];\n      }\n    } catch (e) {\n      continue;\n    }\n\n    if (!parsed) continue;\n    if (!parsed.result) continue;\n\n    let original = null;\n    try {\n      original = parsed.result;\n    } catch (e) {\n      continue;\n    }\n\n    if (!original) continue;\n\n    const jsonObj = {};\n\n    try { if (original.apiName             !== undefined) jsonObj.apiName             = original.apiName;             } catch(e) {}\n    try { if (original.ruleIndex           !== undefined) jsonObj.ruleIndex           = original.ruleIndex;           } catch(e) {}\n    try { if (original.attributeValue      !== undefined) jsonObj.attributeValue      = original.attributeValue;      } catch(e) {}\n    try { if (original.conditionIndex      !== undefined) jsonObj.conditionIndex      = original.conditionIndex;      } catch(e) {}\n    try { if (original.outcomeIndex        !== undefined) jsonObj.outcomeIndex        = original.outcomeIndex;        } catch(e) {}\n    try { if (original.attribute           !== undefined) jsonObj.attribute           = original.attribute;           } catch(e) {}\n    try { if (original.attributeKey        !== undefined) jsonObj.attributeKey        = original.attributeKey;        } catch(e) {}\n    try { if (original.source              !== undefined) jsonObj.source              = original.source;              } catch(e) {}\n    try { if (original.callType            !== undefined) jsonObj.callType            = original.callType;            } catch(e) {}\n    try { if (original.apiParam            !== undefined) jsonObj.apiParam            = original.apiParam;            } catch(e) {}\n    try { if (original.rulesetIndex        !== undefined) jsonObj.rulesetIndex        = original.rulesetIndex;        } catch(e) {}\n    try { if (original.wave                !== undefined) jsonObj.wave                = original.wave;                } catch(e) {}\n    try { if (original.depKey              !== undefined) jsonObj.depKey              = original.depKey;              } catch(e) {}\n    try { if (original.depValue            !== undefined) jsonObj.depValue            = original.depValue;            } catch(e) {}\n    try { if (original.depResolvedValueKey !== undefined) jsonObj.depResolvedValueKey = original.depResolvedValueKey; } catch(e) {}\n\n    // resolvedValueKey → attributeValueKey\n    try { if (original.resolvedValueKey !== undefined) jsonObj.attributeValueKey = original.resolvedValueKey; } catch(e) {}\n\n    let outputObj = null;\n    try {\n      outputObj = {\n        result:   { json: jsonObj },\n        console:  parsed.console  || \"\",\n        timedOut: parsed.timedOut || false\n      };\n    } catch(e) {\n      continue;\n    }\n\n    try {\n      transformed.push(JSON.stringify(outputObj));\n    } catch(e) {\n      continue;\n    }\n  }\n\n} catch (e) {\n  return [{ json: { result: transformed } }];\n}\n\nreturn [{ json: { result: transformed } }];"
          },
          "outcomes": {
            "success": "1767938634849"
          },
          "code": "GET_ATTRIBUTE_VALUES",
          "id": "1774424538892",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
