                            "name": "get dep BU Id",
                            "returnType": "string",
                            "sourceCode": "// Get the current item from the loop\nvar currentItem = $context.$nodes.LOOP_REST_CALLS.$currentItem ;\n\n// Get the API response\nconst apiResponse = $context.$nodes.LOOP_REST_CALLS.GET_DEP_BU_DETAILS.$output;\n\n// Extract the bid from the API response\nlet valueKey = null;\n\nif (apiResponse && apiResponse.items && apiResponse.items.length > 0) {\n  valueKey = apiResponse.items[0].BusinessUnitId;\n}\ncurrentItem.depResolvedValueKey=valueKey ;\n\n\nreturn valueKey ;"
                          },
                          "outcomes": {
