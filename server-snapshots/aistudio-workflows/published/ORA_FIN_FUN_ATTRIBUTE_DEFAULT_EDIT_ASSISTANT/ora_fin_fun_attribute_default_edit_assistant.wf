        {
          "metadata": {
            "name": "Preprocess For Attribute Values",
            "returnType": "object",
            "sourceCode": "const attributeMapping = $context.$variables.pAttributeMapping;\nconst payload = $context.$nodes.VALIDATE_ATTRIBUTES.$output.result;\n\nconst allApiCalls = [];\nconst processedKeys = {};\n\nif (payload && payload.Ruleset) {\n  const rulesets = payload.Ruleset;\n\n  for (let i = 0; i < rulesets.length; i++) {\n    const ruleset = rulesets[i];\n    if (!ruleset || !ruleset.rules) continue;\n\n    const rules = ruleset.rules;\n    for (let j = 0; j < rules.length; j++) {\n      const rule = rules[j];\n      if (!rule || rule.agentRuleProcessStatus !== \"Success\") continue;\n\n      const condValueByAttrKey = {};\n      if (Array.isArray(rule.ruleConditions)) {\n        for (let cv = 0; cv < rule.ruleConditions.length; cv++) {\n          const cvCond = rule.ruleConditions[cv];\n          if (cvCond && cvCond.attributeKey && cvCond.attributeKey.trim() !== \"\") {\n            condValueByAttrKey[cvCond.attributeKey] = cvCond.attributeValue || \"\";\n          }\n        }\n      }\n\n      if (Array.isArray(rule.ruleConditions)) {\n        for (let k = 0; k < rule.ruleConditions.length; k++) {\n          const condition      = rule.ruleConditions[k];\n          if (!condition) continue;\n          const attribute      = condition.attribute      || \"\";\n          const attributeKey   = condition.attributeKey   || \"\";\n          const attributeValue = condition.attributeValue || \"\";\n          const valueKey       = condition.valueKey       || \"\";\n\n          if (valueKey && valueKey.trim() !== \"\") continue;\n          if (!attributeValue || attributeValue.trim() === \"\") continue;\n          if (!attributeKey   || attributeKey.trim()   === \"\") continue;\n\n          const uniqueKey = attributeKey + \"|||\" + attributeValue;\n          if (processedKeys[uniqueKey]) continue;\n          processedKeys[uniqueKey] = true;\n\n          const mapping  = attributeMapping[attributeKey] || { callType: \"constantValue\", apiName: null, apiParam: null, depValue: null };\n          if (mapping.callType === \"constantValue\") continue;\n\n          const depKey   = (mapping.depValue && mapping.depValue.trim() !== \"\") ? mapping.depValue : null;\n          const depValue = depKey ? (condValueByAttrKey[depKey] || \"\") : \"\";\n\n          allApiCalls.push({\n            attribute: attribute, attributeKey: attributeKey,\n            attributeValue: attributeValue, attributeValueKey: \"\",\n            resolvedValueKey: \"\", source: \"ruleCondition\", conditionIndex: k,\n            callType: mapping.callType, apiName: mapping.apiName || null,\n            apiParam: mapping.apiParam || null, depKey: depKey,\n            depValue: depValue, depResolvedValueKey: \"\",\n            rulesetIndex: i, ruleIndex: j, wave: -1\n          });\n        }\n      }\n\n      if (Array.isArray(rule.ruleOutcomes)) {\n        let targetAttributeOutcome = null;\n        let valueOutcome           = null;\n        for (let m = 0; m < rule.ruleOutcomes.length; m++) {\n          const outcome = rule.ruleOutcomes[m];\n          if (!outcome) continue;\n          if (outcome.value1 !== undefined && outcome.value1Key !== undefined) targetAttributeOutcome = outcome;\n          if (outcome.value2 !== undefined) valueOutcome = outcome;\n        }\n\n        if (targetAttributeOutcome && valueOutcome) {\n          const attributeValue = valueOutcome.value2            || \"\";\n          const valueKey       = valueOutcome.value2Key         || \"\";\n          const attributeKey   = targetAttributeOutcome.value1Key || \"\";\n          const attribute      = targetAttributeOutcome.value1    || \"\";\n\n          if (valueKey && valueKey.trim() !== \"\") continue;\n          if (!attributeValue || attributeValue.trim() === \"\") continue;\n          if (!attributeKey   || attributeKey.trim()   === \"\") continue;\n\n          const uniqueKey = attributeKey + \"|||\" + attributeValue;\n          if (processedKeys[uniqueKey]) continue;\n          processedKeys[uniqueKey] = true;\n\n          const mapping  = attributeMapping[attributeKey] || { callType: \"constantValue\", apiName: null, apiParam: null, depValue: null };\n          if (mapping.callType === \"constantValue\") continue;\n\n          const depKey   = (mapping.depValue && mapping.depValue.trim() !== \"\") ? mapping.depValue : null;\n          const depValue = depKey ? (condValueByAttrKey[depKey] || \"\") : \"\";\n\n          allApiCalls.push({\n            attribute: attribute, attributeKey: attributeKey,\n            attributeValue: attributeValue, attributeValueKey: \"\",\n            resolvedValueKey: \"\", source: \"ruleOutcome\", outcomeIndex: 0,\n            callType: mapping.callType, apiName: mapping.apiName || null,\n            apiParam: mapping.apiParam || null, depKey: depKey,\n            depValue: depValue, depResolvedValueKey: \"\",\n            rulesetIndex: i, ruleIndex: j, wave: -1\n          });\n        }\n      }\n    }\n  }\n}\n\n// Assign wave numbers\nconst callIndexByAttrKey = {};\nfor (let ci = 0; ci < allApiCalls.length; ci++) {\n  callIndexByAttrKey[allApiCalls[ci].attributeKey] = ci;\n}\nfor (let pass = 0; pass < allApiCalls.length; pass++) {\n  for (let wi = 0; wi < allApiCalls.length; wi++) {\n    if (allApiCalls[wi].wave !== -1) continue;\n    const item = allApiCalls[wi];\n    if (!item.depKey || callIndexByAttrKey[item.depKey] === undefined) {\n      allApiCalls[wi].wave = 0;\n    } else {\n      const parentWave = allApiCalls[callIndexByAttrKey[item.depKey]].wave;\n      if (parentWave !== -1) allApiCalls[wi].wave = parentWave + 1;\n    }\n  }\n}\nfor (let wi = 0; wi < allApiCalls.length; wi++) {\n  if (allApiCalls[wi].wave === -1) allApiCalls[wi].wave = 0;\n}\n\nlet maxWave = 0;\nfor (let wi = 0; wi < allApiCalls.length; wi++) {\n  if (allApiCalls[wi].wave > maxWave) maxWave = allApiCalls[wi].wave;\n}\nconst totalWaves = maxWave + 1;\n\n// Build waves grouped array\nconst waves = [];\nfor (let wn = 0; wn <= maxWave; wn++) {\n  const waveItems = [];\n  for (let wi = 0; wi < allApiCalls.length; wi++) {\n    if (allApiCalls[wi].wave === wn) waveItems.push(allApiCalls[wi]);\n  }\n  waves.push(waveItems);\n}\n\n\n $context.$variables.pAttributeValueLookup = {};\n\nconst result = {\n  allApiCalls: allApiCalls,\n  waves: waves,\n  currentWave: 0,\n  totalWaves: totalWaves,\n  currentWaveItems: waves[0],\n  hasMoreWaves: totalWaves > 1\n};\n\nreturn [{ json: result }];"
          },
          "outcomes": {
            "success": "1774421387394"
          },
          "code": "PREPROCESS_FOR_ATTRIBUTE_VALUES",
          "id": "1767891998895",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Values Payload",
            "returnType": "object",
            "sourceCode": "// Get all the results from the loop\n//const loopResults = $context.$nodes.LOOP_REST_CALLS.$output || [];\nconst loopResults = $context.$nodes.GET_ATTRIBUTE_VALUES.$output.result[0].json.result || [];\n// Get the original payload\nconst payload = $context.$nodes.VALIDATE_ATTRIBUTES.$output.result || [];\n\n// Create a lookup map for faster updates\nconst valueKeyMap = {};\nconst apiSourceMap = {};\nconst queriedKeysMap = {};\n\n// Build the lookup map from loop results\nif (loopResults && loopResults.length > 0) {\n  for (let i = 0; i < loopResults.length; i++) {\n    const resultItem = loopResults[i];\n    \n    // Skip if resultItem is null, undefined, or empty\n    if (!resultItem) {\n      continue;\n    }\n    \n    // Handle if result is a string that needs parsing\n    let item;\n    if (typeof resultItem === 'string') {\n      try {\n        const parsed = JSON.parse(resultItem);\n        item = parsed.result ? parsed.result.json : parsed.json;\n      } catch (e) {\n        // Skip this item if JSON parsing fails\n        continue;\n      }\n    } else if (resultItem.result && resultItem.result.json) {\n      item = resultItem.result.json;\n    } else if (resultItem.json) {\n      item = resultItem.json;\n    } else {\n      continue;\n    }\n    \n    // Mark that this key was queried\n    if (item && item.attributeKey && item.attributeValue && item.source) {\n      const key = item.attributeKey + \"|||\" + item.attributeValue + \"|||\" + item.source;\n      queriedKeysMap[key] = true;\n      \n      // Store API source information for error messages\n      const apiInfo = {\n        callType: item.callType || \"\",\n        apiName: item.apiName || \"\",\n        apiParam: item.apiParam || \"\"\n      };\n      apiSourceMap[key] = apiInfo;\n      \n      // Only add to valueKeyMap if attributeValueKey exists (row found with valid value)\n      if (item.attributeValueKey) {\n        valueKeyMap[key] = item.attributeValueKey.toString();\n      }\n    }\n  }\n}\n\n// Update the payload\nif (payload.Ruleset) {\n  const rulesets = payload.Ruleset;\n  for (let i = 0; i < rulesets.length; i++) {\n    const ruleset = rulesets[i];\n    if (ruleset.rules) {\n      const rules = ruleset.rules;\n      for (let j = 0; j < rules.length; j++) {\n        const rule = rules[j];\n        \n        // Update ruleConditions\n        if (rule.ruleConditions) {\n          const conditions = rule.ruleConditions;\n          for (let k = 0; k < conditions.length; k++) {\n            const condition = conditions[k];\n            const lookupKey = condition.attributeKey + \"|||\" + condition.attributeValue + \"|||ruleCondition\";\n            \n            if (valueKeyMap[lookupKey]) {\n              // Found in loop results with valid value - use the API response value\n              condition.valueKey = valueKeyMap[lookupKey];\n            } else if (queriedKeysMap[lookupKey]) {\n              // Row exists but value is null/invalid - set error\n              rule.agentRuleProcessStatus = \"Error\";\n              const apiInfo = apiSourceMap[lookupKey];\n              const apiSource = apiInfo.callType === \"tvvs\" ? \"TVVS: \" + apiInfo.apiParam : \"REST: \" + apiInfo.apiName;\n              rule.errorInfo = \"Invalid value '\" + condition.attributeValue + \"' for attribute '\" + condition.attribute + \"'. Please refer to \" + apiSource + \" for valid values.\";\n              condition.valueKey = condition.attributeValue;\n            } else {\n              // Row doesn't exist - set valueKey to attributeValue\n              condition.valueKey = condition.attributeValue;\n            }\n          }\n        }\n        \n        // Update ruleOutcomes\n        if (rule.ruleOutcomes) {\n          const outcomes = rule.ruleOutcomes;\n          // Find the target attribute key (value1Key)\n          let targetAttributeKey = null;\n          let targetAttributeName = null;\n          \n          for (let m = 0; m < outcomes.length; m++) {\n            if (outcomes[m].value1Key !== undefined) {\n              targetAttributeKey = outcomes[m].value1Key;\n              targetAttributeName = outcomes[m].value1;\n              break;\n            }\n          }\n          \n          // Update value2Key in the appropriate outcome\n          if (targetAttributeKey) {\n            for (let m = 0; m < outcomes.length; m++) {\n              const outcome = outcomes[m];\n              const lookupKey = targetAttributeKey + \"|||\" + outcome.value2 + \"|||ruleOutcome\";\n              \n              if (valueKeyMap[lookupKey]) {\n                // Found in loop results with valid value - use the API response value\n                outcome.value2Key = valueKeyMap[lookupKey];\n              } else if (queriedKeysMap[lookupKey]) {\n                // Row exists but value is null/invalid - set error\n                rule.agentRuleProcessStatus = \"Error\";\n                const apiInfo = apiSourceMap[lookupKey];\n                const apiSource = apiInfo.callType === \"tvvs\" ? \"TVVS: \" + apiInfo.apiParam : \"REST: \" + apiInfo.apiName;\n                rule.errorInfo = \"Invalid value '\" + outcome.value2 + \"' for attribute '\" + targetAttributeName + \"'. Please refer to \" + apiSource + \" for valid values.\";\n                outcome.value2Key = outcome.value2;\n              } else {\n                // Row doesn't exist - set value2Key to value2\n                outcome.value2Key = outcome.value2;\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\nvar output = JSON.stringify(payload);\nreturn output;"
          },
          "outcomes": {
            "success": "1771424201755"
          },
          "code": "VALUES_PAYLOAD",
