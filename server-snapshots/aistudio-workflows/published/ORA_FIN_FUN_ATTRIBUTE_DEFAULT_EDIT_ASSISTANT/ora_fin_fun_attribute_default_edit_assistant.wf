        {
          "metadata": {
            "name": "Build MapingValue Object",
            "returnType": "object",
            "sourceCode": "var result = [];\n\nvar data = $context.$nodes.VALUES_PAYLOAD.$output;\nvar parsedData = JSON.parse(data.result);\nvar ruleset = parsedData.Ruleset;\nvar output1 = $context.$nodes.GET_MAPPING_SET.$output;\n\nfor (var c = 0; c < ruleset.length; c++) {\n    var category = ruleset[c];\n    var rules = category.rules;\n\n    for (var r = 0; r < rules.length; r++) {\n        var rule = rules[r];\n        var ruleConditions = rule.ruleConditions;\n\n        // Find matching mapping set by MappingSetCode\n        var matchingItem = null;\n        for (var i = 0; i < output1.items.length; i++) {\n            if (output1.items[i].MappingSetCode) {\n                matchingItem = output1.items[i];\n                break;\n            }\n        }\n\n        if (!matchingItem) continue;\n\n        // Count non-null sources\n        var noOfInputs = 0;\n        for (var sc = 1; sc <= 10; sc++) {\n            if (matchingItem[\"Source\" + sc] !== null && matchingItem[\"Source\" + sc] !== undefined) {\n                noOfInputs++;\n            }\n        }\n\n        // Build one object per rule\n        var arrayObject = {\n            mappingSetCode: matchingItem.MappingSetCode,\n            mappingSetId: matchingItem.MappingSetId,\n            noOfInputs: noOfInputs,\n            mappingSetFlavorId: null,\n            mappingSetValueId: null\n        };\n\n        // Init all keys as null\n        for (var sn = 1; sn <= 10; sn++) {\n            arrayObject[\"attributeKey\" + sn] = null;\n            arrayObject[\"valueKey\" + sn] = null;\n        }\n\n        // Fill attribute/value slots from rule conditions\n        for (var rc = 0; rc < ruleConditions.length; rc++) {\n            var condition = ruleConditions[rc];\n\n            if (condition.conditionType !== \"mappingset\") continue;\n\n            var attributeKey = condition.attributeKey;\n\n            for (var s = 1; s <= 10; s++) {\n                if (matchingItem[\"Source\" + s] === attributeKey) {\n                    arrayObject[\"attributeKey\" + s] = attributeKey;\n                    arrayObject[\"valueKey\" + s] = condition.valueKey;\n                    break;\n                }\n            }\n        }\n\n        // Get outputValue from ruleOutcomes\n        var ruleOutcomes = rule.ruleOutcomes;\n        for (var ro = 0; ro < ruleOutcomes.length; ro++) {\n            if (ruleOutcomes[ro].outcome2 === \"Value\") {\n                arrayObject.outputValue = ruleOutcomes[ro].value2Key;\n                break;\n            }\n        }\n\n        result.push(arrayObject);\n    }\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1771424535665"
          },
