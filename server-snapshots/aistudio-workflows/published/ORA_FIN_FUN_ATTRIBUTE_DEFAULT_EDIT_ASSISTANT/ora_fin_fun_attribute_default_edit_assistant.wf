                        {
                          "metadata": {
                            "name": "Get Dep Resolved Key",
                            "returnType": "string",
                            "sourceCode": "let value = \"\";\n\nconst depKey =  $context.$nodes.LOOP_REST_CALLS.$currentItem.depKey;\n\nif (depKey === \"ORA_BU_ID\") {\n  value = $context.$nodes.ATTRIBUTE_BUILD_LOOP.LOOP_REST_CALLS.GET_DEP_BU_ID.$output.result ?? \"\";\n} else if (depKey === \"ORA_PRIMARY_LEDGER_ID\") {\n  value = $context.$nodes.ATTRIBUTE_BUILD_LOOP.LOOP_REST_CALLS.GET_DEP_LEDGER_ID.$output.result ?? \"\";\n}  else if (depKey === \"ORA_LEGAL_ENTITY_ID\") {\n  value = $context.$nodes.ATTRIBUTE_BUILD_LOOP.LOOP_REST_CALLS.GET_DEP_LEGAL_ENTITY_ID.$output.result ?? \"\";\n}else {\n  value = \"\";\n};\n\n\nreturn value;"
                          },
