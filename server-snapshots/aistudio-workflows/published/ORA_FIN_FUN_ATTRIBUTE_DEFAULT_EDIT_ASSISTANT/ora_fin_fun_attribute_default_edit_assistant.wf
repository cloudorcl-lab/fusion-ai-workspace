        },
        {
          "metadata": {
            "name": "updatePayload",
            "returnType": "object",
            "sourceCode": "var itemsOutput = $context.$nodes.GETMAPPINGSBYVALUES.$output;\nvar inputData = $context.$nodes.BUILD_MAPINGVALUE_OBJECT.$output.result[0];\nvar payloadRaw = $context.$nodes.VALUES_PAYLOAD.$output;\n\nvar payload = JSON.parse(payloadRaw.result);\n//var payload = JSON.parse( $context.$nodes.PROCESSRULESFORDUPLICATES.$currentItem );\n\n\nvar items = itemsOutput.items || [];\nvar debug = [];\nvar outputValue = inputData.outputValue;\nvar mappingSetId = inputData.mappingSetId;\nvar mappingSetFlavorId = $context.$nodes.GETMAPPINGSETFLAVOR.$output.items[0].MappingSetFlavorId;\nvar mappingSetCode = $context.$nodes.GETMAPPINGSETFLAVOR.$output.items[0].MappingSetCode;\nvar attributeRuleId = $context.$nodes.GETATTRIBUTERULE.$output.result[0].AttributeRuleId;\nvar mappingSetValueId = inputData.mappingSetId;\nvar rule = payload.Ruleset[0].rules[0];\n\n// Extract mappingSetValueId from rulePK (4th segment) if it's an update scenario\nvar existingRulePK = rule.rulePK;\nvar currentMappingSetValueId = null;\n\nif (existingRulePK && existingRulePK.trim() !== \"\") {\n  var pkParts = existingRulePK.split(\",\");\n  if (pkParts.length >= 4) {\n    currentMappingSetValueId = pkParts[3].trim();\n  }\n} \n\nif (items.length === 0) {\n  // Only set rulePK if it's empty (create case)\n  if (!existingRulePK || existingRulePK.trim() === \"\") {\n    rule.rulePK = attributeRuleId + \",\" + mappingSetId + \",\" + mappingSetFlavorId;\n  }\n} else {\n  var matchedRow = null;\n\n  for (var i = 0; i < items.length; i++) {\n    var item = items[i];\n\n    // Skip self — compare using rulePK 4th segment for update, fallback to mappingSetValueId for create\n    var selfId = currentMappingSetValueId !== null ? currentMappingSetValueId : String(mappingSetValueId);\n\n    if (item.MappingSetValueId !== null && item.MappingSetValueId !== undefined &&\n        String(item.MappingSetValueId) === selfId) {\n      continue;\n    }\n\n    var isMatch = true;\n\n    for (var j = 1; j <= 10; j++) {\n      var itemVal = (item[\"InputValueConstant\" + j] !== null && item[\"InputValueConstant\" + j] !== undefined) ? String(item[\"InputValueConstant\" + j]) : null;\n      var inputVal = (inputData[\"valueKey\" + j] !== null && inputData[\"valueKey\" + j] !== undefined) ? String(inputData[\"valueKey\" + j]) : null;\n\n      debug.push({\n        field: j,\n        itemVal: itemVal,\n        inputVal: inputVal,\n        match: itemVal === inputVal\n      });\n\n      if (itemVal !== inputVal) {\n        isMatch = false;\n        break;\n      }\n    }\n\n    if (isMatch) {\n      matchedRow = item;\n      break;\n    }\n  }\n\n  if (matchedRow) {\n    var itemValueConstant = (matchedRow.ValueConstant !== null && matchedRow.ValueConstant !== undefined) ? String(matchedRow.ValueConstant) : null;\n    var compareOutputValue = (outputValue !== null && outputValue !== undefined) ? String(outputValue) : null;\n\n    if (itemValueConstant === compareOutputValue) {\n      rule.agentRuleProcessStatus = \"ERROR\";\n      rule.errorInfo = \"Rule for this applicability already exists for same target value\";\n    } else {\n      rule.agentRuleProcessStatus = \"ERROR\";\n      rule.errorInfo = \"Rule exists for same applicability with different target value\";\n    }\n  } else {\n    // Only set rulePK if it's empty (create case)\n    if (!existingRulePK || existingRulePK.trim() === \"\") {\n      rule.rulePK = attributeRuleId + \",\" + mappingSetId + \",\" + mappingSetFlavorId + \",\" + mappingSetValueId + \",\" + mappingSetCode;\n    }\n  }\n}\n\nvar output = JSON.stringify(payload);\nreturn output;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "UPDATEPAYLOAD",
          "id": "1771424658336",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
