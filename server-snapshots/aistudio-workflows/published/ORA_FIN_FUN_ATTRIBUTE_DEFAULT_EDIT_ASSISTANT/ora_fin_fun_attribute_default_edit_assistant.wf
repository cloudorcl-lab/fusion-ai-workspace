          "code": "UPSERTPAYLOAD",
          "id": "1771424719699",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Mapset Data",
            "returnType": "object",
            "sourceCode": "var data = $context.$nodes.VALUES_PAYLOAD.$output;\nvar parsedData = JSON.parse(data.result);\n//var parsedData = JSON.parse($context.$nodes.PROCESSRULESFORDUPLICATES.$currentItem); \nvar restApiInputs = null;\n\nif (parsedData.Ruleset && parsedData.Ruleset.length > 0) {\n    for (var c = 0; c < parsedData.Ruleset.length; c++) {\n        var ruleset = parsedData.Ruleset[c];\n\n        if (ruleset.rules && ruleset.rules.length > 0) {\n            for (var r = 0; r < ruleset.rules.length; r++) {\n                var rule = ruleset.rules[r];\n\n                if (rule.agentRuleProcessStatus === \"Success\") {\n\n                    var attributeKeyStr = \"\";\n                    var sourcePairs = [];\n                    var outputValue = \"\";\n                    var outputKey = \"\";\n                    var attributeKeys = [];\n\n                    if (rule.ruleConditions && rule.ruleConditions.length > 0) {\n                        for (var rc = 0; rc < rule.ruleConditions.length; rc++) {\n                            var condition = rule.ruleConditions[rc];\n                            if (condition.conditionType === \"mappingset\" && condition.attributeKey) {\n                                attributeKeys.push(condition.attributeKey);\n                                sourcePairs.push({\n                                    source: condition.attributeKey,\n                                    value: condition.valueKey || \"\"\n                                });\n                            }\n                        }\n                        attributeKeyStr = attributeKeys.join(\",\");\n                    }\n\n                    if (rule.ruleOutcomes && rule.ruleOutcomes.length > 0) {\n                        for (var ro = 0; ro < rule.ruleOutcomes.length; ro++) {\n                            var outcome = rule.ruleOutcomes[ro];\n                            if (outcome.value1Key !== undefined && outcome.value1Key !== null) {\n                                outputKey = outcome.value1Key;\n                            }\n                            if (outcome.value2Key !== undefined && outcome.value2Key !== null) {\n                                outputValue = outcome.value2Key;\n                            }\n                        }\n                    }\n\n                    restApiInputs = {\n                        attributeKeyStr: attributeKeyStr,\n                        sourcePairs: sourcePairs,\n                        outputValueSet: null,\n                        outputKey: outputKey,\n                        outputValue: outputValue\n                    };\n                }\n            }\n        }\n    }\n}\n\nreturn restApiInputs;"
          },
          "outcomes": {
            "success": "1771424267696"
          },
          "code": "MAPSET_DATA",
          "convergenceTargetId": "1771424267696",
          "id": "1771424201755",
