          "metadata": {
            "name": "GetAttributeRule",
            "returnType": "object",
            "sourceCode": "var mappingSetCodes = [];\nvar mappingSetMap = {}; \n\nvar input1 = $context.$nodes.GET_RULES_BY_TARGET.$output;\nvar input2 = $context.$nodes.GETMAPPINGSETBYSOURCE.$output;\n\n// Build mappingSetCodes array and map\nfor (var i = 0; i < input2.items.length; i++) {\n  var code = input2.items[i].MappingSetCode;\n  var id = input2.items[i].MappingSetId;\n  mappingSetCodes.push(code);\n  mappingSetMap[code] = id;\n}\n\nvar result = [];\n\nfor (var j = 0; j < input1.items.length; j++) {\n  var itemCode = input1.items[j].MappingSetCode;\n  \n  if (mappingSetCodes.indexOf(itemCode) !== -1) {\n    result.push({\n      AttributeRuleId: input1.items[j].AttributeRuleId,\n      MappingSetCode: itemCode,\n      MappingSetId: mappingSetMap[itemCode] \n    });\n  }\n}\n\nreturn result;"
          },
