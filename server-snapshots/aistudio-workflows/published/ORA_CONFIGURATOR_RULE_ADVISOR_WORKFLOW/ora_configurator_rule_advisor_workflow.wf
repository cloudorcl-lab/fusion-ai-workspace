{
  "workflowId": "300000327004788",
  "workflowCode": "ORA_CONFIGURATOR_RULE_ADVISOR_WORKFLOW",
  "name": "Configurator Rule Advisor Workflow",
  "description": "Use this AI agent workflow to automate how you diagnose and troubleshoot your configurator rules. The workflow agent  systematically tests every rule in your model, identifies rules and scenarios that might cause contradictory or conflicting behavior, then lets you know which ones need your attention. Use it to help make sure your configurations are accurate and consistent.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
