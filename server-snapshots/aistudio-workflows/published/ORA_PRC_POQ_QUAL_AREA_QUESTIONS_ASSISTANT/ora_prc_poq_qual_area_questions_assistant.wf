  "name": "Supplier Qualification Area Questions Assistant",
  "description": "Assists qualification managers in creating clear, relevant questions tailored to specific qualification areas.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
