            "sourceCode": "// Extract input nodes from context safely\nvar minValue = $context.$variables.pMinValue;\nvar stockoutItems = $context.$nodes.STOCKOUTORSHORTAGEITEMRECORD.$output?.items ?? [];\nvar availableQty = stockoutItems[0]?.AvailableToTransactQuantity ?? 0;\nvar required_quantity = minValue - availableQty;\nvar l_index = 0;\nvar output = [];\n\n// 1. Inbound Supply\nvar inboundSupply = $context.$nodes.INBOUNDSUPPLY.$output?.items ?? [];\nfor (var i = 0; i < inboundSupply.length; i++) {\n    var item = inboundSupply[i];\n    if (!item) continue;\n    if (required_quantity <= 0) break;\n    var available_qty = item.PrimaryQuantity;\n    output[l_index] = {};\n    output[l_index].ReplenishmentType = 'INBOUND';\n    output[l_index].ReplenishmentTypeName = 'No Order Needed';\n    output[l_index].DestinationOrganizationId = item.OrganizationId;\n    output[l_index].DestinationOrganizationCode = $context.$variables.pOrganizationCode;\n    output[l_index].ItemNumber = $context.$variables.pItemNumber;\n    output[l_index].DestinationSubinventoryCode = $context.$variables.pSubinventoryCode;\n    output[l_index].DestinationLocatorId = $context.$variables.pLocatorId;\n    output[l_index].SourceOrganizationId = item.OrganizationId;\n    output[l_index].SourceOrganizationCode = $context.$variables.pOrganizationCode;\n    output[l_index].SourceSubinventory = item.Subinventory;\n    output[l_index].SourceLocatorId = null;\n    output[l_index].InventoryItemId = item.InventoryItemId;\n    output[l_index].UOMCode = item.PrimaryUnitOfMeasureCode;\n    output[l_index].UOMName = item.PrimaryUnitOfMeasure;\n    output[l_index].DocumentType = item.DocumentType;\n    output[l_index].DocumentNumber = item.DocumentNumber;\n    output[l_index].InboundQuantity = item.PrimaryQuantity;\n    output[l_index].DueDate = item.DueDate;\n    output[l_index].BuyerEmailAddress = null;\n    if (available_qty >= required_quantity) {\n        output[l_index].OrderQuantity = required_quantity;\n        output[l_index].Suggestions = 'Consider expediting this order to resolve the shortage.';\n        required_quantity = 0;\n        l_index++;\n        break;\n    } else {\n        output[l_index].OrderQuantity = available_qty;\n        output[l_index].Suggestions = 'Consider expediting this order to resolve the shortage.';\n        required_quantity -= available_qty;\n        l_index++;\n    }\n}\n\n// 2. Substitute Items Availability Within Organization\nvar substituteAvailability = $context.$nodes.SUBSTITUTEITEMSAVAILABILITY.$output?.items ?? [];\nfor (var i = 0; i < substituteAvailability.length; i++) {\n    var item = substituteAvailability[i];\n    if (!item) continue;\n    if (!item.ItemNumber) continue;\n    if (required_quantity <= 0) break;\n    var available_qty = item.AvailableQuantityInRequestedUOM;\n    output[l_index] = {};\n    output[l_index].ReplenishmentType = 'SUBSTITUTE';\n    output[l_index].ReplenishmentTypeName = 'No Order Needed';\n    output[l_index].DestinationOrganizationId = item.OrganizationId;\n    output[l_index].DestinationOrganizationCode = $context.$variables.pOrganizationCode;\n    output[l_index].DestinationSubinventoryCode = $context.$variables.pSubinventoryCode;\n    output[l_index].DestinationLocatorId = $context.$variables.pLocatorId;\n    output[l_index].SourceOrganizationId = item.OrganizationId;\n    output[l_index].SourceOrganizationCode = $context.$variables.pOrganizationCode;\n    output[l_index].SourceSubinventory = item.Subinventory;\n    output[l_index].SourceLocatorId = null;\n    output[l_index].InventoryItemId = item.InventoryItemId;\n    output[l_index].UOMCode = $context.$variables.pUOMCode;\n    output[l_index].UOMName = $context.$variables.pUOMName;\n    output[l_index].SubItemNumber = item.ItemNumber;\n    output[l_index].SubQuantity = item.AvailableQuantityInRequestedUOM;\n    output[l_index].BuyerEmailAddress = null;\n    if (available_qty >= required_quantity) {\n        output[l_index].OrderQuantity = required_quantity;\n        output[l_index].Suggestions = 'Consider using this item until the shortage for ' + $context.$variables.pItemNumber + ' is resolved.';\n        required_quantity = 0;\n        l_index++;\n        break;\n    } else {\n        output[l_index].OrderQuantity = available_qty;\n        output[l_index].Suggestions = 'Consider using this item until the shortage for ' + $context.$variables.pItemNumber + ' is resolved.';\n        required_quantity -= available_qty;\n        l_index++;\n    }\n}\n\n// 3. Item Availability Within Organization (other subinventories)\nvar availabilityWithinOrg = $context.$nodes.ITEM_AVAILABILITY_WITH_IN_ORGANIZATION.$output?.items ?? [];\nfor (var i = 0; i < availabilityWithinOrg.length; i++) {\n    var item = availabilityWithinOrg[i];\n    if (item.SuggestedQuantityForReplenishment <= 0) { continue; }\n    if (required_quantity <= 0) { break; }\n    if (\n        $context.$variables.pSubinventoryCode === item.Subinventory &&\n        (!$context.$variables.pLocatorId || $context.$variables.pLocatorId == item.LocatorId)\n    ) {\n        continue;\n    }\n    var available_qty = item.SuggestedQuantityForReplenishment;\n    var replenish_type = item.InterSubinventoryParametersFlag === true ? 'TO' : 'MO';\n    var replenish_type_name = item.InterSubinventoryParametersFlag === true ? 'Transfer Order' : 'Movement Request';\n    output[l_index] = {};\n    output[l_index].ReplenishmentType = replenish_type;\n    output[l_index].ReplenishmentTypeName = replenish_type_name;\n    output[l_index].DestinationOrganizationId = item.OrganizationId;\n    output[l_index].DestinationOrganizationCode = $context.$variables.pOrganizationCode;\n    output[l_index].DestinationSubinventoryCode = $context.$variables.pSubinventoryCode;\n    output[l_index].DestinationLocatorId = $context.$variables.pLocatorId;\n    output[l_index].SourceOrganizationId = item.OrganizationId;\n    output[l_index].SourceOrganizationCode = $context.$variables.pOrganizationCode;\n    output[l_index].SourceSubinventory = item.Subinventory;\n    output[l_index].SourceLocatorId = item.LocatorId;\n    output[l_index].InventoryItemId = item.InventoryItemId;\n    output[l_index].UOMCode = item.PrimaryUnitOfMeasureCode;\n    output[l_index].UOMName = item.PrimaryUnitOfMeasure;\n    output[l_index].BuyerEmailAddress = null;\n    if (available_qty >= required_quantity) {\n        output[l_index].OrderQuantity = required_quantity;\n        var suggestion =\n            (replenish_type === 'TO' ? 'Create a transfer order' : 'Create a movement request') +\n            ' to transfer ' + required_quantity + ' ' + item.PrimaryUnitOfMeasure +\n            ' of the item ' + $context.$variables.pItemNumber +\n            ' from subinventory ' + item.Subinventory;\n        if (item.Locator) {\n            suggestion += ' and locator ' + item.Locator;\n        }\n        suggestion += ' to subinventory ' + $context.$variables.pSubinventoryCode;\n        if ($context.$variables.pLocatorName) {\n            suggestion += ' and locator ' + $context.$variables.pLocatorName;\n        }\n        suggestion += '.';\n        output[l_index].Suggestions = suggestion;\n        required_quantity = 0;\n        l_index++;\n        break;\n    } else {\n        output[l_index].OrderQuantity = available_qty;\n        var suggestion =\n            (replenish_type === 'TO' ? 'Create a transfer order' : 'Create a movement request') +\n            ' to transfer ' + available_qty + ' ' + item.PrimaryUnitOfMeasure +\n            ' of the item ' + $context.$variables.pItemNumber +\n            ' from subinventory ' + item.Subinventory;\n        if (item.Locator) {\n            suggestion += ' and locator ' + item.Locator;\n        }\n        suggestion += ' to subinventory ' + $context.$variables.pSubinventoryCode;\n        if ($context.$variables.pLocatorName) {\n            suggestion += ' and locator ' + $context.$variables.pLocatorName;\n        }\n        suggestion += '.';\n        output[l_index].Suggestions = suggestion;\n        required_quantity -= available_qty;\n        l_index++;\n    }\n}\n\n// 4. Substitute Availability In Other Subinventory\nvar substituteOtherSubinv = $context.$nodes.SUBSTITUEAVAIABILITYINOTHERSUBINVENTORY.$output?.items ?? [];\nfor (var i = 0; i < substituteOtherSubinv.length; i++) {\n    var item = substituteOtherSubinv[i];\n    if (required_quantity <= 0) { break; }\n    var available_qty = item.AvailableQuantityInRequestedUOM;\n    if (available_qty <= 0) { continue; }\n    var replenish_type = item.InterSubinventoryParametersFlag === true ? 'TO' : 'MO';\n    var replenish_type_name = item.InterSubinventoryParametersFlag === true ? 'Transfer Order' : 'Movement Request';\n    output[l_index] = {};\n    output[l_index].ReplenishmentType = replenish_type;\n    output[l_index].ReplenishmentTypeName = replenish_type_name;\n    output[l_index].DestinationOrganizationId = item.OrganizationId;\n    output[l_index].DestinationOrganizationCode = $context.$variables.pOrganizationCode;\n    output[l_index].DestinationSubinventoryCode = $context.$variables.pSubinventoryCode;\n    output[l_index].DestinationLocatorId = $context.$variables.pLocatorId;\n    output[l_index].SourceOrganizationId = item.OrganizationId;\n    output[l_index].SourceOrganizationCode = $context.$variables.pOrganizationCode;\n    output[l_index].SourceSubinventory = item.Subinventory;\n    output[l_index].SourceLocatorId = item.LocatorId;\n    output[l_index].InventoryItemId = item.InventoryItemId;\n    output[l_index].UOMCode = $context.$variables.pUOMCode;\n    output[l_index].UOMName = $context.$variables.pUOMName;\n    output[l_index].SubItemNumber = item.ItemNumber;\n    output[l_index].BuyerEmailAddress = null;\n    if (available_qty >= required_quantity) {\n        output[l_index].OrderQuantity = required_quantity;\n        var suggestion =\n            (replenish_type === 'TO' ? 'Create a transfer order' : 'Create a movement request') +\n            ' to transfer ' + required_quantity + ' ' + $context.$variables.pUOMName +\n            ' of substitute item ' + item.ItemNumber +\n            ' from subinventory ' + item.Subinventory;\n        if (item.Locator) {\n            suggestion += ' and locator ' + item.Locator;\n        }\n        suggestion += ' to subinventory ' + $context.$variables.pSubinventoryCode;\n        if ($context.$variables.pLocatorName) {\n            suggestion += ' and locator ' + $context.$variables.pLocatorName;\n        }\n        suggestion += '.';\n        output[l_index].Suggestions = suggestion;\n        required_quantity = 0;\n        l_index++;\n        break;\n    } else {\n        output[l_index].OrderQuantity = available_qty;\n        var suggestion =\n            (replenish_type === 'TO' ? 'Create a transfer order' : 'Create a movement request') +\n            ' to transfer ' + available_qty + ' ' + $context.$variables.pUOMName +\n            ' of substitute item ' + item.ItemNumber +\n            ' from subinventory ' + item.Subinventory;\n        if (item.Locator) {\n            suggestion += ' and locator ' + item.Locator;\n        }\n        suggestion += ' to subinventory ' + $context.$variables.pSubinventoryCode;\n        if ($context.$variables.pLocatorName) {\n            suggestion += ' and locator ' + $context.$variables.pLocatorName;\n        }\n        suggestion += '.';\n        output[l_index].Suggestions = suggestion;\n        required_quantity -= available_qty;\n        l_index++;\n    }\n}\n\n// 5. Item Availability In Other Organization\nvar availabilityInOtherOrg = $context.$nodes.ITEM_AVAILABILITY_IN_OTHER_ORGANIZATION.$output?.items ?? [];\nfor (var i = 0; i < availabilityInOtherOrg.length; i++) {\n    var item = availabilityInOtherOrg[i];\n    if (required_quantity <= 0) { break; }\n    var available_qty = item.AvailableQuantityInRequestedUOM;\n    output[l_index] = {};\n    output[l_index].ReplenishmentType = 'TO';\n    output[l_index].ReplenishmentTypeName = 'Transfer Order'\n    output[l_index].DestinationOrganizationId = $context.$variables.pOrganizationId;\n    output[l_index].DestinationOrganizationCode = $context.$variables.pOrganizationCode;\n    output[l_index].DestinationSubinventoryCode = $context.$variables.pSubinventoryCode;\n    output[l_index].DestinationLocatorId = $context.$variables.pLocatorId;\n    output[l_index].SourceOrganizationId = item.OrganizationId;\n    output[l_index].SourceOrganizationCode = item.OrganizationCode;\n    output[l_index].SourceSubinventory = item.Subinventory;\n    output[l_index].SourceLocatorId = item.LocatorId;\n    output[l_index].InventoryItemId = item.InventoryItemId;\n    output[l_index].UOMCode = $context.$variables.pUOMCode;\n    output[l_index].UOMName = $context.$variables.pUOMName;\n    output[l_index].BuyerEmailAddress = null;\n    if (available_qty >= required_quantity) {\n        output[l_index].OrderQuantity = required_quantity;\n        output[l_index].Suggestions =\n            'Create a transfer order to transfer ' + required_quantity + ' ' + $context.$variables.pUOMName +\n            ' of item ' + $context.$variables.pItemNumber +\n            ' from organization ' + item.OrganizationCode +\n            ' to organization ' + $context.$variables.pOrganizationCode +\n            ' and subinventory ' + $context.$variables.pSubinventoryCode + '.';\n        required_quantity = 0;\n        l_index++;\n        break;\n    } else {\n        output[l_index].OrderQuantity = available_qty;\n        output[l_index].Suggestions =\n            'Create a transfer order to transfer ' + available_qty + ' ' + $context.$variables.pUOMName +\n            ' of item ' + $context.$variables.pItemNumber +\n            ' from organization ' + item.OrganizationCode +\n            ' to organization ' + $context.$variables.pOrganizationCode +\n            ' and subinventory ' + $context.$variables.pSubinventoryCode + '.';\n        required_quantity -= available_qty;\n        l_index++;\n    }\n}\n\n// 6. Create Purchase Requisition if still short\nif (required_quantity > 0) {\n    output[l_index] = {};\n    output[l_index].Suggestions =\n        'Create a purchase requisition for ' + required_quantity + ' ' + $context.$variables.pUOMName +\n        ' of item ' + $context.$variables.pItemNumber +\n        ' for organization ' + $context.$variables.pOrganizationCode +\n        ', to be received into subinventory ' + $context.$variables.pSubinventoryCode + '.';\n    output[l_index].ReplenishmentType = 'PO';\n    output[l_index].ReplenishmentTypeName = 'Purchase Requisition';\n    output[l_index].DestinationOrganizationId = $context.$variables.pOrganizationId;\n    output[l_index].DestinationOrganizationCode = $context.$variables.pOrganizationCode;\n    output[l_index].DestinationSubinventoryCode = $context.$variables.pSubinventoryCode;\n    output[l_index].DestinationLocatorId = $context.$variables.pLocatorId;\n    output[l_index].ItemNumber = $context.$variables.pItemNumber;\n    output[l_index].SourceOrganizationId = null;\n    output[l_index].SourceOrganizationCode = null;\n    output[l_index].SourceSubinventory = null;\n    output[l_index].SourceLocatorId = null;\n    output[l_index].InventoryItemId = $context.$variables.pItemNumber;\n    output[l_index].OrderQuantity = required_quantity;\n    output[l_index].UOMCode = $context.$variables.pUOMCode;\n    output[l_index].UOMName = $context.$variables.pUOMName;\n    output[l_index].BuyerEmailAddress = null;\n}\n\nreturn output;"
          },
