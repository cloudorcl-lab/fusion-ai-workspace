        {
          "metadata": {
            "name": "ExtractOraAppContext",
            "returnType": "object",
            "sourceCode": "let obj;\nlet action;\n\nlet inputStr = $context.$triggers.REST.$input?.Dummy;\nlet appContextStr = $context.$app.$OraAppContext;\nlet oraActionStr = $context.$app.$OraAction;\n\nlet dummy = null;\n\n// treat empty strings as null to avoid JSON.parse(\"\") errors\nif (inputStr !== undefined && inputStr !== null && inputStr.trim() === \"\") inputStr = null;\nif (appContextStr !== undefined && appContextStr !== null && appContextStr.trim() === \"\") appContextStr = null;\nif (oraActionStr !== undefined && oraActionStr !== null && oraActionStr.trim() === \"\") oraActionStr = null;\n\n// parse Dummy once (if provided)\nif (inputStr) {\n  dummy = JSON.parse(inputStr);\n}\n\n// Resolve OraAppContext\nif (appContextStr) {\n  obj = JSON.parse(appContextStr);               // app provides stringified JSON\n} else if (dummy && dummy.OraAppContext !== undefined && dummy.OraAppContext !== null) {\n  obj = dummy.OraAppContext;                     // already an object in Dummy\n} else {\n  obj = {};\n}\n\n// Resolve OraAction\nif (oraActionStr) {\n  action = JSON.parse(oraActionStr);             // app provides stringified JSON\n} else if (dummy && dummy.OraAction !== undefined && dummy.OraAction !== null) {\n  action = dummy.OraAction;                      // already an object in Dummy\n} else {\n  action = null;\n}\n\n// If obj is empty and action is not, and action.command is \"ReplenishmentOptions\", assign obj = action\nif (\n  Object.keys(obj).length === 0 &&\n  action &&\n  Object.keys(action).length > 0 &&\n  action.command === \"ReplenishmentOptions\"\n) {\n  obj = action;\n}\n\n// Update command (only if action has it)\nif (action && action.command !== undefined && action.command !== null && obj.command !== action.command) {\n  obj.command = action.command;\n}\n\n// Context normalization\nif (obj && obj.Context) {\n    if (obj.Context === 'Shortage') {\n        obj.Context = 'SHORTAGE';\n    } else {\n        obj.Context = 'STOCKOUT';\n    }\n}\n\nreturn obj;"
          },
          "outcomes": {
            "success": "1770978619355"
          },
          "code": "EXTRACTORAAPPCONTEXT",
