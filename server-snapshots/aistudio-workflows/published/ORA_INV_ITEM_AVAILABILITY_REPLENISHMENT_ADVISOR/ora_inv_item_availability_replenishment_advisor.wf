        {
          "metadata": {
            "name": "PrepareMessageHint",
            "returnType": "string",
            "sourceCode": "let hint = $context.$app.$OraMessageHint;\n\n// Check for undefined or null\nif (typeof hint === 'undefined' || hint === null) {\n    let Dummy = JSON.parse($context.$triggers.REST.$input.Dummy);\n    hint = Dummy.OraMessageHint;\n}\n\nif (hint === null || hint === \"InitDisplay\" || hint === \"Summary\")\n  hint = \"Init\";\nreturn hint;"
          },
