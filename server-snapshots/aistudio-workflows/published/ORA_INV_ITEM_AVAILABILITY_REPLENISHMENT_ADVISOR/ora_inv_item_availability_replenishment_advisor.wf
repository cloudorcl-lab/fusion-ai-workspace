},\n              \"TransferPriceCurrencyCode\": {\n                \"type\": \"object\",\n                \"properties\": {},\n                \"required\": []\n              },\n              \"ItemNumber\": {\n                \"type\": \"string\",\n                \"minLength\": 1\n              },\n              \"TransferOrderHeaderNumber\": {\n                \"type\": \"object\",\n                \"properties\": {},\n                \"required\": []\n              },\n              \"TransferOrderLineNumber\": {\n                \"type\": \"object\",\n                \"properties\": {},\n                \"required\": []\n              },\n              \"NoteToReceiver\": {\n                \"type\": \"object\",\n                \"properties\": {},\n                \"required\": []\n              },\n              \"NoteToSupplier\": {\n                \"type\": \"object\",\n                \"properties\": {},\n                \"required\": []\n              },\n              \"Comments\": {\n                \"type\": \"object\",\n                \"properties\": {},\n                \"required\": []\n              },\n              \"ItemRevision\": {\n                \"type\": \"object\",\n                \"properties\": {},\n                \"required\": []\n              },\n              \"SupplySplitsAllowedFlag\": {\n                \"type\": \"object\",\n                \"properties\": {},\n                \"required\": []\n              },\n              \"PurchaseOrderScheduleNumber\": {\n                \"type\": \"object\",\n                \"properties\": {},\n                \"required\": []\n              },\n              \"PurchaseOrderNumber\": {\n                \"type\": \"object\",\n                \"properties\": {},\n                \"required\": []\n              },\n              \"PurchaseOrderLineNumber\": {\n                \"type\": \"object\",\n                \"properties\": {},\n                \"required\": []\n              },