            "sourceCode": "const SuggestionList = $context.$variables.suggestionsList ?? [];\nconst highPriorityActions = [];\n\n// Only proceed if SuggestionList is not empty\nif (SuggestionList.length > 0) {\n  for (let i = 0; i < SuggestionList.length; i++) {\n    const suggestion = SuggestionList[i];\n    // If ReplenishmentType is neither \"INBOUND\" nor \"SUBSTITUTE\"\n    if (suggestion.ReplenishmentType !== \"INBOUND\" && suggestion.ReplenishmentType !== \"SUBSTITUTE\") {\n      highPriorityActions.push({\n        title: `Create ${suggestion.ReplenishmentTypeName}`,\n        shortDescription: suggestion.Suggestions !== undefined ? suggestion.Suggestions : null,\n        actionText: `Create ${suggestion.ReplenishmentTypeName}`,\n        followUpCommand: `ora.Agent({\"command\": \"OrderCreation\", \"suggestion\": ${JSON.stringify(suggestion)}})`,\n        priority: true,\n      });\n    }\n  }\n}\nreturn highPriorityActions;"
          },
