        {
          "metadata": {
            "name": "Prepare Widgets",
            "returnType": "object",
            "sourceCode": "const ItemMinimumQuantity = $context.$variables.pMinValue !== null && $context.$variables.pMinValue !== undefined ? $context.$variables.pMinValue : 0;\nconst InboundSupplyForToday = $context.$nodes.SUMOFINBOUNDSUPPLY.$output?.InboundSupplyQuantity !== null && $context.$nodes.SUMOFINBOUNDSUPPLY.$output?.InboundSupplyQuantity !== undefined ? $context.$nodes.SUMOFINBOUNDSUPPLY.$output?.InboundSupplyQuantity : 0;\nconst ItemNumber = $context.$variables.pItemNumber;\nconst SuggestionList = $context.$variables.suggestionsList;\nconst deficit = ItemMinimumQuantity - InboundSupplyForToday;\nconst summary = `Minimum Quantity needed is ${ItemMinimumQuantity} and Inbound Quantity expected till today is ${InboundSupplyForToday}. Deficit is ${deficit}. Based on this, recommending the following options`;\n\n// --- Build main actionable suggestions ---\nconst multiRecordWidgetRows = [];\nconst InboundMultiRecordWidgetRows = [];\nconst substituteMultiRecordWidgetRows = [];\n\nfor (let i = 0; i < SuggestionList.length; i++) {\n  const s = SuggestionList[i];\n  // Main actionable suggestions\n  if ( s.ReplenishmentType !== \"INBOUND\" && s.ReplenishmentType !== \"SUBSTITUTE\"  ) {\n    let suggest = \"Create \" + s.ReplenishmentTypeName;\n    if ( typeof s.Suggestions === \"string\" && s.Suggestions.toLowerCase().includes(\"substitute\") ) {\n        if (s.SubItemNumber) {\n            suggest += \" for substitute item \" + s.SubItemNumber;\n        }\n        if (s.SourceSubinventory) {\n            suggest += \" from Subinventory \" + s.SourceSubinventory;\n        }\n    } else if ( typeof s.Suggestions === \"string\" && s.Suggestions.toLowerCase().includes(\"movement\") && s.SourceSubinventory ) {\n        suggest += \" from Subinventory \" + s.SourceSubinventory;\n    }\n    multiRecordWidgetRows.push({\n      cells: [\n        s.SourceOrganizationCode !== undefined\n          ? s.SourceOrganizationCode\n          : null,\n        s.OrderQuantity !== undefined &&\n        s.UOMName !== undefined &&\n        s.OrderQuantity !== null &&\n        s.UOMName !== null\n          ? s.OrderQuantity + \" \" + s.UOMName\n          : null,\n        s.ReplenishmentTypeName !== undefined\n          ? suggest\n          : null,\n      ],\n      action: {\n        text: \"Execute\",\n        command: `ora.Agent({\"command\": \"OrderCreation\", \"suggestion\": ${JSON.stringify( s )}})`,\n      },\n    });\n  }\n  // INBOUND\n  else if (s.ReplenishmentType === \"INBOUND\") {\n    InboundMultiRecordWidgetRows.push({\n      cells: [\n        s.DocumentType !== undefined\n          ? s.DocumentType\n          : null,\n        s.DocumentNumber !== undefined\n          ? s.DocumentNumber\n          : null,\n        s.InboundQuantity !== undefined &&\n        s.UOMName !== undefined &&\n        s.InboundQuantity !== null &&\n        s.UOMName !== null\n          ? s.InboundQuantity + \" \" + s.UOMName\n          : null,\n        s.DueDate !== undefined ? s.DueDate : null,\n        s.Suggestions !== undefined ? s.Suggestions : null,\n      ],\n    });\n  }\n  // SUBSTITUTE\n  else if (s.ReplenishmentType === \"SUBSTITUTE\") {\n    substituteMultiRecordWidgetRows.push({\n      cells: [\n        s.SourceSubinventory !== undefined\n          ? s.SourceOrganizationCode\n          : null,\n        s.SubItemNumber !== undefined\n          ? s.SubItemNumber\n          : null,\n        s.SubQuantity !== undefined &&\n        s.UOMName !== undefined &&\n        s.SubQuantity !== null &&\n        s.UOMName !== null\n          ? s.SubQuantity + \" \" + s.UOMName\n          : null,\n        s.Suggestions !== undefined ? s.Suggestions : null,\n      ],\n    });\n  }\n}\n\n// --- Build widgets as needed ---\nlet multiRecordWidget = null;\nif (multiRecordWidgetRows.length > 0) {\n  multiRecordWidget = {\n    title: \" Actionable Replenishment Suggestions\",\n    patternId: \"multiRecordWidget\",\n    description: \"Suggestions where an order or transfer is recommended\",\n    properties: {\n      subtitle:\n        \"Options to resolve shortages or stockouts with new orders or transfers\",\n      cols: [\n        \"Source Organization\",\n        \"Quantity\",\n        \"Suggestion\",\n      ],\n      rows: multiRecordWidgetRows,\n    },\n  };\n}\n\nlet inboundMultiRecordWidget = null;\nif (InboundMultiRecordWidgetRows.length > 0) {\n  inboundMultiRecordWidget = {\n    title: \"Replenishment Suggestions\",\n    patternId: \"multiRecordWidget\",\n    description: \"Inbound supply that could address the shortage\",\n    properties: {\n      subtitle: \"Inbound orders in transit\",\n      cols: [\n        \"Document Type\",\n        \"Document Number\",\n        \"Quantity\",\n        \"Due Date\",\n        \"Suggestion\",\n      ],\n      rows: InboundMultiRecordWidgetRows,\n    },\n  };\n}\n\nlet substituteMultiRecordWidget = null;\nif (substituteMultiRecordWidgetRows.length > 0) {\n  substituteMultiRecordWidget = {\n    title: \"Replenishment Suggestions\",\n    patternId: \"multiRecordWidget\",\n    description: \"Substitute items available to resolve shortage\",\n    properties: {\n      subtitle: \"Possible substitutes for current item\",\n      cols: [\n        \"Source Subinventory\",\n        \"Substitute Item\",\n        \"Quantity\",\n        \"Suggestion\",\n      ],\n      rows: substituteMultiRecordWidgetRows,\n    },\n  };\n}\n\nconst preparedWidgets = {\n  summary: summary,\n  multiRecordWidget: multiRecordWidget,\n  inboundMultiRecordWidget: inboundMultiRecordWidget,\n  substituteMultiRecordWidget: substituteMultiRecordWidget,\n};\nreturn preparedWidgets;"
          },
          "outcomes": {
            "success": "1772099055696"
          },
