          "typeSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"DestinationOrganizationId\": {\n        \"type\": \"integer\",\n        \"description\": \"The ID of the destination organization\"\n      },\n      \"DestinationOrganizationCode\": {\n        \"type\": \"integer\",\n        \"description\": \"Code of the destination organization\"\n      },\n      \"InventoryItemId\": {\n        \"type\": \"integer\",\n        \"description\": \"The ID of the item\"\n      },\n      \"DestinationSubinventoryCode\": {\n        \"type\": \"string\",\n        \"description\": \"Code of the destination subinventory\"\n      },\n      \"DestinationLocatorId\": {\n        \"type\": \"integer\",\n        \"description\": \"ID of the destination locator\"\n      },\n      \"SourceOrganizationId\": {\n        \"type\": \"integer\",\n        \"description\": \"The ID of the source organization\"\n      },\n      \"SourceOrganizationCode\": {\n        \"type\": \"integer\",\n        \"description\": \"Code of the source organization\"\n      },\n      \"SourceSubinventory\": {\n        \"type\": \"string\",\n        \"description\": \"ID or code of the source subinventory\"\n      },\n      \"SourceLocatorId\": {\n        \"type\": \"integer\",\n        \"description\": \"ID of the source locator\"\n      },\n      \"OrderQuantity\": {\n        \"type\": \"number\",\n        \"description\": \"Order quantity\"\n      },\n      \"UOMCode\": {\n        \"type\": \"string\",\n        \"description\": \"Unit of measure code\"\n      },\n      \"UOMName\": {\n        \"type\": \"string\",\n        \"description\": \"Unit of measure name\"\n      },\n      \"ReplenishmentType\": {\n        \"type\": \"string\",\n        \"description\": \"Type of replenishment\"\n      },\n      \"ReplenishmentTypeName\": {\n        \"type\": \"string\",\n        \"description\": \"Name of replenishment type\"\n      },\n      \"BuyerEmailAddress\": {\n        \"type\": \"string\",\n        \"format\": \"email\",\n        \"description\": \"Buyer's email address\"\n      },\n      \"Suggestions\": {\n        \"type\": \"string\",\n        \"description\": \"Replenishment suggestions or notes\"\n      }, \n      \"Output\": {\n        \"type\": \"string\",\n        \"description\": \"Reference number of the order \"\n      },\n      \"DocumentType\": {\n        \"type\": \"string\",\n        \"description\": \"Inbound Document Type \"\n      }, \n      \"DocumentNumber\": {\n        \"type\": \"string\",\n        \"description\": \"Inbound Document Number \"\n      },  \n      \"InboundQuantity\": {\n        \"type\": \"string\",\n        \"description\": \"Inbound Quantity\"\n      },\n      \"InboundUOMName\": {\n        \"type\": \"string\",\n        \"description\": \"Inbound Quantity UOM \"\n      }, \n      \"DueDate\": {\n        \"type\": \"string\",\n        \"description\": \"Due date of the order \"\n      },  \n      \"SubItemNumber\": {\n        \"type\": \"string\",\n        \"description\": \"Substitute item number \"\n      },  \n      \"SubQuantity\": {\n        \"type\": \"string\",\n        \"description\": \"Substitute Quantity available \"\n      },\n    },\n    \"required\": [\n      \"DestinationOrganizationId\",\n      \"DestinationSubinventoryCode\",\n      \"SourceOrganizationId\",\n      \"OrderQuantity\",\n      \"UOMCode\",\n      \"UOMName\",\n      \"ReplenishipmentType\",\n      \"Suggestions\"\n    ],\n    \"additionalProperties\": false\n  }\n}"
