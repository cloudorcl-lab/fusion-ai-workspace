              "value": "{{$context.$nodes.CREATE_LOT_SIMULATION_DATA_OBJECT.$output.result.LotsToSubstitute}}"
            },
            {
              "id": "1775690570593_4",
              "name": "LotsSubstitutes",
              "type": "string",
              "value": "{{$context.$nodes.CREATE_LOT_SIMULATION_DATA_OBJECT.$output.result.LotsSubstitutes}}"
