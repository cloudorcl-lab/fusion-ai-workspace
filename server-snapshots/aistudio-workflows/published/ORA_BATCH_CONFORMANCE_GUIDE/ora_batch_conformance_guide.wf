        {
          "metadata": {
            "name": "Create incomplete results records",
            "returnType": "array",
            "sourceCode": "let items = $context.$nodes.GET_INCOMPLETE_CONFORMANCE_RESULTS.$output.items;\n\nlet incompleteResults = [];\n\nitems.forEach(currentRecord => {\n\n       let errorMsg =\"\";\n       let errors = currentRecord.ConformanceCheckResultErrors.items;\n       if(errors.length > 0){\n               let errorCode =currentRecord.ConformanceCheckResultErrors.items[0].ErrorCode;\n       let errorCount =Number(currentRecord.ConformanceCheckResultErrors.items[0].ErrorCount);\n\n      if(errorCount>1){\n           errorMsg = \"Multiple Issues\";\n      }else if(errorCount===1){\n               if(errorCode === \"WIE_INGRDNT_QTY_NOT_RESERVED\"){\n            errorMsg = \"Ingredients have not been reserved\";\n             }else if(errorCode===\"WIE_ASSIGNMENT_NOT_FOUND\"){\n              errorMsg = \"Parameter assignment not defined\";\n                }else if(errorCode===\"WIE_TARGET_VALUE_MISSING\"){\n                     errorMsg = \"Target values not defined for primary product\";\n                }else if(errorCode===\"WIE_UOM_CONVERSION_MISSING\"){\n                    errorMsg = \"Uom conversion not completed\";\n                }\n       }\n       }\n       \n\n       incompleteResults.push(\n                 {\n                         \"Batch\": currentRecord.WorkOrderNumber,\n                         \"WorkOrderId\":currentRecord.WorkOrderId,\n                        \"PrimaryProduct\": currentRecord.ItemNumber,\n                       \"StartDate\": currentRecord.PlannedStartDate.split(\"T\")[0],\n                       \"BatchQuantity\":currentRecord.BatchQuantity,\n                       \"BatchUomCode\":currentRecord.PrimaryProductUOM,\n                       \"ConformanceResult\": currentRecord.ConformanceCheckResult,\n                       \"ConformanceCheckResultDate\":currentRecord.ConformanceCheckResultDate,\n                       \"Reason\":errorMsg\n                  });\n});\n\n\n\nreturn incompleteResults ;"
          },
          "outcomes": {
            "success": "1774380204632"
          },
          "code": "CREATE_INCOMPLETE_RESULTS_RECORDS",
          "id": "1775841188586",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
