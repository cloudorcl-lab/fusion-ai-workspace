          "inputs": [
            {
              "id": "1775690570590_1",
              "name": "WorkOrderId",
              "type": "number",
              "value": "{{$context.$nodes.EXTRACT_LOT_SIMULATION_PAYLOAD.$output.result.WorkOrderId}}"
            },
            {
              "id": "1775690570591_2",
