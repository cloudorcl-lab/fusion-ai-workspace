        },
        {
          "metadata": {
            "name": "Create view errors data",
            "returnType": "object",
            "sourceCode": "let data = $context.$nodes.GET_ERRORS_BY_WORK_ORDER_ID.$output.items;\n\nlet assignmentMissingArr = [];\nlet targetValuesMissingArr = [];\nlet uomConversionMissingArr = [];\nlet qtyNotReservedArr = [];\n\n\ndata.forEach(item =>{\n         let errors = item.ConformanceCheckResultErrors.items; //Array of errors\n         \n         errors.forEach(error =>{\n              let errorCode = error.ErrorCode;\n              if(errorCode === \"WIE_INGRDNT_QTY_NOT_RESERVED\"){\n                    let message = error.MessageText.replace(`{${error.ErrorTokenNames}}`,error.ErrorTokenValues);\n                   qtyNotReservedArr.push({\n                           \"ErrorMessage\": message\n                    });\n              }else if(errorCode===\"WIE_ASSIGNMENT_NOT_FOUND\"){\n                    let message = error.MessageText.replace(`{${error.ErrorTokenNames}}`,error.ErrorTokenValues);\n                   assignmentMissingArr.push({\n                           \"ErrorMessage\": message\n                    });\n              }else if(errorCode===\"WIE_TARGET_VALUE_MISSING\"){\n                   let names = error.ErrorTokenNames.split(\",\");\n                   let values = error.ErrorTokenValues.split(\",\");\n\n                   let map = {};\n                   names.forEach((name, i) => {\n                        map[name.trim()] = values[i]?.trim();\n                   });\n\n                   let message = error.MessageText.replace(/\\{(.*?)\\}/g, (_, token) => {\n                       return map[token] || `{${token}}`;\n                     });\n\n                 \n                   targetValuesMissingArr.push({\n                           \"ErrorMessage\": message\n                    });\n              }else if(errorCode===\"WIE_UOM_CONVERSION_MISSING\"){\n                  let names = error.ErrorTokenNames.split(\",\");\n                   let values = error.ErrorTokenValues.split(\",\");\n\n                   let map = {};\n                   names.forEach((name, i) => {\n                        map[name.trim()] = values[i]?.trim();\n                   });\n\n                   let message = error.MessageText.replace(/\\{(.*?)\\}/g, (_, token) => {\n                       return map[token] || `{${token}}`;\n                     });\n\n                 \n                   uomConversionMissingArr.push({\n                           \"ErrorMessage\": message\n                    });\n              }\n         });\n});\n\n\n\nlet dataObj = {\n      \"WorkOrderId\": $context.$nodes.EXTRACT_VIEW_ERRORS_PAYLOAD.$output.result.WorkOrderId,\n     \"Batch\": data[0].WorkOrderNumber,\n     \"AssignmentErrors\":assignmentMissingArr,\n     \"TargetValuesErrors\":targetValuesMissingArr ,\n     \"UomConversionErrors\":uomConversionMissingArr,\n     \"QtyNotReservedErrors\":qtyNotReservedArr\n};\n\n\nreturn dataObj;"
          },
          "outcomes": {
            "success": "1775846337514"
          },
          "code": "CREATE_VIEW_ERRORS_DATA",
          "id": "1775844391314",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
