        {
          "metadata": {
            "name": "Create lot simulation data object",
            "returnType": "object",
            "sourceCode": "let parametersString = $context.$nodes.EXTRACT_LOT_SIMULATION_PAYLOAD.$output.result.SimulationParameters;\n\n\n\nlet dataObj= {\n            \"ItemsWithLots\": \"\",\n            \"LotsToSubstitute\": \"\",\n            \"LotsSubstitutes\": \"\"\n };\n\nlet parametersArr = parametersString ? parametersString.split(\"<LOT_SIMULATION>\") : [];\n\nparametersArr.forEach((parameter, index)=> {\n        let parameterString = parameter.split(\"||\");\n        let itemNumber = parameterString[0];\n        let originalLot = parameterString[1];\n        let replacementLot = parameterString[2];\n\n        if(index===0){\n            if(replacementLot){\n               if(replacementLot!==null){\n                  if(replacementLot!=='undefined'){\n                    dataObj.ItemsWithLots = itemNumber;\n                    dataObj.LotsToSubstitute = originalLot;\n                    dataObj.LotsSubstitutes = replacementLot;\n                  }\n               }\n            }\n               \n        }else{\n            if(replacementLot){\n                if(replacementLot!==null)\n                {\n                    if(replacementLot!=='undefined'){\n                        dataObj.ItemsWithLots = dataObj.ItemsWithLots+\"<CONFRM_CHECK>\"+ itemNumber;\n                        dataObj.LotsToSubstitute =dataObj.LotsToSubstitute +\"<CONFRM_CHECK>\"+ originalLot;\n                        dataObj.LotsSubstitutes = dataObj.LotsSubstitutes +\"<CONFRM_CHECK>\"+replacementLot;\n                    }\n\n                }\n            }\n             \n        }\n        \n});\n\nreturn dataObj;"
          },
          "outcomes": {
            "success": "1775690546097"
          },
          "code": "CREATE_LOT_SIMULATION_DATA_OBJECT",
          "id": "1775689741419",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
