        {
          "metadata": {
            "name": "Determine if is ora form submission",
            "returnType": "object",
            "sourceCode": "const oraAction = $context.$triggers.REST.$input.OraAction;\n\nconst match = oraAction.match(/<oraFormSubmit\\s+id=[\"']([^\"']*)[\"'][^>]*>(.*?)<\\/oraFormSubmit>/s);\n let id = null;\nlet json = null;\nlet formId=null;\nlet workOrderId= null;\n\nif (match) {\n  id = match[1];      // The ID value\n  json = match[2];    // The JSON content\n\n formId=id.split(\"-\");\nworkOrderId = formId[1];\nid = formId[0];\n\n}\n\n\nconst jsonObj = {\n   \"FormId\":id,\n   \"Json\":json,\n   \"WorkOrderId\":workOrderId\n};\n\nreturn jsonObj;"
          },
          "outcomes": {
            "success": "1775071761331"
          },
          "code": "DETERMINE_IF_IS_ORA_FORM_SUBMISSION",
          "id": "1775071454230",
