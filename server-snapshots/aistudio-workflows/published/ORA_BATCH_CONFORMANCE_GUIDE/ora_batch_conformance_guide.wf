              "value": "{{$context.$app.$OraMessageHint}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
        },
        {
          "metadata": {
            "name": "Extract Context",
            "returnType": "object",
            "sourceCode": "const rawOutput = $context?.$nodes?.ESTABLISH_CONTEXT?.$output?.output;\nlet parsed = {};\n\ntry {\n  parsed =\n    typeof rawOutput === \"string\"\n      ? JSON.parse(rawOutput)\n      : rawOutput || {};\n} catch (e) {\n  parsed = {};\n}\n\nconst result = parsed?.result || {};\nconst data = result?.data || {};\nconst age = Number(data?.Age);\n\n// dateForData = today - age days (YYYY-MM-DD)\nlet dateForData = null;\nif (Number.isFinite(age)) {\n  const today = new Date();\n  const pastDate = new Date(today);\n  pastDate.setDate(today.getDate() - age);\n  dateForData = pastDate.toISOString().split(\"T\")[0];\n}\n\nreturn {\n  ok: result?.ok ?? false,\n  status: result?.status ?? null,\n  mode: result?.mode ?? null,\n\n  OrganizationId: data?.OrganizationId ?? null,\n  OrganizationCode: data?.OrganizationCode ?? null,\n  OrganizationName: data?.OrganizationName ?? null,\n  Age: data?.Age ?? null,\n  Context: data?.Context ?? null,\n  dateForData,\n\n  errorCode: result?.errorCode ?? null,\n  errorMessage: result?.errorMessage ?? null\n};"
          },
          "outcomes": {
            "success": "1774889016213"
          },
          "code": "EXTRACT_CONTEXT",
          "id": "1778854820260",
          "inputs": [],
