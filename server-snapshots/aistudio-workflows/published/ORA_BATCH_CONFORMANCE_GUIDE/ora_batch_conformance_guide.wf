              "id": "1780346713998_WorkOrderId",
              "name": "WorkOrderId",
              "type": "number",
              "value": "{{$context.$nodes.EXTRACT_APPLY_RECOMMENDATION_PAYLOAD.$output.result.WorkOrderId}}"
