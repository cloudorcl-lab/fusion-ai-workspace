            "name": "Extract simulate lots payload",
            "returnType": "object",
            "sourceCode": "const payload = $context.$nodes.CREATE_ACTION_OBJECT.$output.result;\n\nlet itemId = null;\nif(payload.ItemId != null){\n     if( payload.ItemId.toString().trim() !== \"\"){\n            itemId = payload.ItemId;\n     }\n}\n\nlet selectedLot = null;\nif(payload.SelectedLot != null){\n     if( payload.SelectedLot.toString().trim() !== \"\"){\n            selectedLot = payload.SelectedLot;\n     }\n}\n\nlet allLots = \"[EMPTY]\";\nif(payload.AllLots != null){\n     if(payload.AllLots.toString().trim() !== \"\"){\n            allLots = payload.AllLots;\n     }\n}\n\nconst obj = {\n     \"WorkOrderId\":payload.WorkOrderId,\n     \"Batch\":payload.Batch,\n     \"ItemId\":itemId,\n     \"SelectedLot\":selectedLot,\n     \"AllLots\": allLots\n};\n\nreturn obj;"
          },
