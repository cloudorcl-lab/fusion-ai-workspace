        {
          "metadata": {
            "name": "Create view details object array",
            "returnType": "object",
            "sourceCode": "let parent = $context.$nodes.VIEW_CONFORMANCE_CHECK_DETAILS_.$output.items;\n\nlet checkDetails = $context.$nodes.VIEW_CONFORMANCE_CHECK_DETAILS_.$output.items[0].ConformanceCheckDetails.items;\n\nlet parentHashRaw = parent[0][\"@context\"].links[0].href.split(\"/\");\n\nlet parentHash = parentHashRaw[parentHashRaw.length-1];\n\n\nlet conformanceCheckViewDetails= checkDetails.map(item => ({\n  \"WorkOrderId\":item.WorkOrderId,\n  \"PrimaryProduct\":item.ItemNumber,\n  \"Batch\":item.WorkOrderNumber,\n  \"BatchQuantity\":item.Quantity,\n  \"UOMCode\":item.UOMCode,\n  \"ConformanceParameterQuantity\":item.QuantityConformanceParameter,\n  \"UOMCodeConformanceParameter\":item.UOMConformanceParameter,\n  \"ParameterCode\": item.ParameterCode,\n  \"MinimumTargetValue\": item.MinimumTargetValue,\n  \"MaximumTargetValue\": item.MaximumTargetValue,\n  \"TargetValue\":item.TargetValue,\n  \"CalculatedValue\":item.CalculatedValue,\n  \"ConformanceCheckResultStatus\":item.ConformanceCheckResultStatus.replaceAll(\"_\", \" \"),\n  \"ConformanceCheckDate\":item.ConformanceCheckResultDate,\n  \"OverallStatus\":parent[0].ConformanceCheckResultStatus,\n  \"ParentHash\":parentHash,\n  \"DetailId\":item.ConformanceCheckDetailId\n}));\n\nreturn conformanceCheckViewDetails;"
          },
          "outcomes": {
            "success": "1774644272648"
          },
          "code": "CREATE_VIEW_DETAILS_OBJECT_ARRAY",
          "id": "1774900068070",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Create view ingr details array",
            "returnType": "array",
            "sourceCode": "let input = $context.$nodes.VIEW_CONFORMANCE_CHECK_INGREDIENTS.$output.items[ 0].ConformanceCheckIngredientDetails.items;\nlet parameterCode = $context.$nodes.EXTRACT_VIEW_INGREDIENTS_PAYLOAD.$output.result.ParameterCode;\nlet conformanceCheckIngrDetails = [];\n\ninput.forEach( item => {\n  \n  let decimals = 0;\n  const text = item.ActualValue.toString();\n\n  if (!text.includes(\".\")) {\n    decimals=1;\n  }else{\n    decimals = text.split(\".\")[1].length;\n  }\n  \n  conformanceCheckIngrDetails.push( {\n    \"ItemNumber\": item.ItemNumber,\n    \"LotNumber\": item.LotNumber,\n    \"Quantity\": item.QuantityConformanceParameter,\n    \"ActualValue\": item.ActualValue,\n    \"Contribution\":(item.QuantityConformanceParameter * item.ActualValue).toFixed(decimals),\n    \"UOMCode\": item.UOMCodeConformanceParameterMeaning,\n    \"ParameterCode\": parameterCode\n  });\n});\n\nlet sortedArray = conformanceCheckIngrDetails.sort((a, b) => b.Contribution- a.Contribution);\n\nreturn sortedArray;"
          },
          "outcomes": {
            "success": "1774910021899"
          },
          "code": "CREATE_VIEW_INGR_DETAILS_ARRAY",
          "id": "1774912712695",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Display Batch on Hold"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "DISPLAY_BATCH_ON_HOLD",
          "id": "1774997605817",
          "inputs": [
            {
              "id": "1774997605819_1",
              "name": "prompt",
              "type": "string",
              "value": "With the following JSON data: {{$context.$nodes.UPDATE_BATCH_TO_ON_HOLD.$output}}\n\n1.Extract 'WorkOrderNumber','ItemNumber','PlannedStartDate','WoStatusName'\n\nGive a brief message with the following format:\n\nBatch [WorkOrderNumber] – [ItemNumber] placed on hold.\n\nBatch [WorkOrderNumber] with planned start date [PlannedStartDate (MM/DD/YYYY)] has been placed [WoStatusName] and will no longer appear in the out-of-conformance results batch list.\n\nOnce the conformance issues are resolved, you can change the batch status in Supply Chain Management by going to Batches.\n\n\nWhere [WorkOrderNumber]  [ItemNumber]  [PlannedStartDate] and  [WoStatusName]  are the values you extracted from the JSON."
            }
          ],
          "type": "LLM"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_RECORD"
              ],
              "enableActions": false,
              "enableCommunications": false
            }
          },
          "metadata": {
            "name": "Create form"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "CREATE_FORM",
          "id": "1775069797257",
          "inputs": [
            {
              "id": "1775069797259_1",
              "name": "prompt",
              "type": "string",
              "value": "With the following JSON object: {{$context.$nodes.GET_WORK_ORDER_MATERIALS.$output.items}} \n\nExtract 'ItemNumber' and 'Quantity' from the json to populate the fields mentioned below (for each item)\n\nGenerate a recordWidget with id: submitBasicSimulation-<WorkOrderId>   and fields (these fields must be per record):\n(<WorkOrderId> is: {{$context.$nodes.EXTRACT_SUBSTITUTE_INGREDIENTS_PAYLOAD.$output.result.WorkOrderId}} )\n\nDisplay a header with the title \"Conformance Check Ingredient substitution\"\nAlso display a brief summary where you explain that this is a conformance check simulation, where no actual changes will be made to the batch and just serves as experimenting with different quantities to review how it affects the conformance results.\n\nFor each ItemNumber in the JSON , generate the following fields inside the widget:\nfields: [\n        { id: \"substituteItem\", label: \"Substitute for Ingredient <ItemNumber>\", type: \"text\"},\n        { id: \"substituteQty\", label: \"Substitute for Quantity <Quantity>\",type: \"number\" ,value:<Quantity>}\n]\n\n**Important\nFor each field Id, append a number and increase it for each item, for example\n\nid:\"substituteItem1\"\nid:\"substituteItem2\" \n\nid: \"substituteQty1\"\nid: \"substituteQty2\"\n\nAnd so on."
            }
          ],
          "type": "LLM"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_RECORD"
              ],
              "enableActions": false,
              "enableCommunications": false,
              "customNotes": "Display 3 fields per row in the recordWidget"
            }
          },
          "metadata": {
            "name": "Create quantity simulation"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "CREATE_QUANTITY_SIMULATION",
          "id": "1775607210326",
          "inputs": [
            {
              "id": "1775607210327_1",
              "name": "prompt",
              "type": "string",
              "value": "With the following JSON object: {{$context.$nodes.GET_MATERIALS_FOR_QUANTITY_SIMULATION.$output.items}}\n\nExtract 'ItemNumber' , 'Quantity' and 'UOMCode' from the json to populate the fields mentioned below (for each item)\n\nGenerate a recordWidget with id: submitQuantitySimulation-<WorkOrderId>   and fields (these fields must be per record):\n(<WorkOrderId> is: {{$context.$nodes.EXTRACT_SIMULATE_QUANTITIES_PAYLOAD.$output.result.WorkOrderId}} )\n\nDisplay a header with the title \"Conformance Check Quantity substitution\"\nAlso display a brief summary where you explain that this is a conformance check simulation, where no actual changes will be made to the batch and just serves as experimenting with different quantities to review how it affects the conformance results.\n\nFor each ItemNumber in the JSON , generate the following fields inside the widget:\nfields: [\n        { id: \"substituteQty\", label: \"Substitute for Quantity <Quantity> - <ItemNumber> \",type: \"number\" ,value:<Quantity>}\n]\n\n**Important\nFor each field Id, append a number and increase it for each item, for example\n\nid:\"substituteQty1\"\nid:\"substituteQty2\" \n\nAnd so on."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Populate lot enabled items array",
            "returnType": "array",
            "sourceCode": "let existingItems = $context.$variables.LotItems || [];\n\nlet items = [...existingItems];\n\nlet ingredientsArr = $context.$nodes.GET_CONFORMANCE_LOT_ITEMS.$output.items[0].ConformanceCheckIngredientDetails.items;\n\nconst seen = new Set();\n\ningredientsArr.forEach(ingredient => {\n    if (ingredient.LotNumber) {\n        if (ingredient.LotNumber !== null) {\n\n            if (ingredient.LotNumber !== '') {\n                const key = `${ingredient.ItemNumber}`;\n\n                if (!seen.has(key)) {\n                    seen.add(key);\n                    items.push({\n                        \"ItemNumber\": ingredient.ItemNumber,\n                        \"InventoryItemId\": ingredient.InventoryItemId,\n                        \"OriginalLot\": ingredient.LotNumber\n                    });\n                }\n            }\n\n\n        }\n    }\n\n});\n\nreturn items;"
          },
          "outcomes": {
            "success": "1778792054444"
          },
          "code": "POPULATE_LOT_ENABLED_ITEMS_ARRAY",
          "id": "1778790401015",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Construct view lots data",
            "returnType": "object",
            "sourceCode": "let actualValues = $context.$nodes.GET_ACTUAL_VALUES_FOR_LOT_ITEM.$output.items;\nlet allLots = $context.$nodes.EXTRACT_VIEW_LOTS_PAYLOAD.$output.result.AllLots;\n\nlet result = actualValues\n  .filter(item => item.LotNumber !== null)\n  .map(item => ({\n    \"WorkOrderId\": $context.$nodes.EXTRACT_VIEW_LOTS_PAYLOAD.$output.result.WorkOrderId,\n    \"Batch\": $context.$nodes.EXTRACT_VIEW_LOTS_PAYLOAD.$output.result.Batch,\n    \"LotNumber\": item.LotNumber,\n    \"ParameterCode\": item.ParameterCode,\n    \"ActualValue\": item.ActualValue,\n    \"ItemNumber\": item.ItemNumber,\n    \"InventoryItemId\": item.InventoryItemId,\n    \"AllLots\": allLots || \"[EMPTY]\"\n  }));\n\nreturn result;"
          },
          "outcomes": {
            "success": "1775667535233"
          },
          "code": "CONSTRUCT_VIEW_LOTS_DATA",
          "id": "1775665461533",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
