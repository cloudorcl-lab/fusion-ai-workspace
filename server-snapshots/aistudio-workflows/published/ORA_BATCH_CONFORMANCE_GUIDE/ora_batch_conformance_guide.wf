            "returnType": "array",
            "sourceCode": "let ingredients = $context.$nodes.GET_INGREDIENTS_AFTER_RECOMMENDATION.$output.items[0].ConformanceCheckIngredientDetails.items;\n\nlet ingrArr = [];\n\ningredients.forEach(ingredient =>{\n     ingrArr.push({\n        \"Ingredient\":ingredient.ItemNumber,\n        \"Lot\":ingredient.LotNumber,\n        \"ReservedQuantity\":ingredient.Quantity\n     });\n});\n\nreturn ingrArr;"
