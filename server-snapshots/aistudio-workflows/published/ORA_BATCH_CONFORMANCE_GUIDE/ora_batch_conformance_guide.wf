        {
          "metadata": {
            "name": "Construct post recommendation data",
            "returnType": "array",
            "sourceCode": "let details = $context.$nodes.GET_POST_RECOMMENDATION_CONFORMANCE_RESULTS.$output.items[0].ConformanceCheckDetails.items;\n\nlet conformanceResults = [];\n\ndetails.forEach(parameter =>{\n   conformanceResults.push({\n       \"ConformanceParameter\":parameter.ParameterCode,\n       \"MinimumValue\":parameter.MinimumTargetValue,\n       \"MaximumValue\":parameter.MaximumTargetValue,\n       \"TargetValue\":parameter.TargetValue,\n       \"CalculatedValue\":parameter.CalculatedValue,\n       \"ConformanceCheckStatus\":parameter.ConformanceCheckResultStatusMeaning\n   });\n\n});\n\nreturn conformanceResults;"
          },
          "outcomes": {
            "success": "1780420168159"
          },
          "code": "CONSTRUCT_POST_RECOMMENDATION_DATA",
          "id": "1780346803095",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
