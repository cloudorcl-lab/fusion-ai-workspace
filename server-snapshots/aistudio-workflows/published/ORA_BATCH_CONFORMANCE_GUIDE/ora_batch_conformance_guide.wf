{
  "workflowId": "300000331068573",
  "workflowCode": "ORA_BATCH_CONFORMANCE_GUIDE",
  "name": "Batch Conformance Guide",
  "description": "This agent helps users calculate, review, and understand conformance check results for unreleased batches, including the impact of what-if scenarios before release. Conformance check evaluates whether a batch is expected to meet defined parameter targets and acceptable ranges by analyzing ingredient actual values, ingredient quantities, batch quantity, and unit-of-measure conversions. With this agent, users can review current conformance results, identify parameters that are in range, out of range, or incomplete, and simulate changes such as ingredient substitutions, lot substitutions, or quantity adjustments to understand their impact on the final batch outcome. Based on these insights, users can make informed changes to the batch before it is released.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
