            "sourceCode": "const items =$context.$nodes.GET_OUT_OF_RANGE_RESULTS.$output.items;\n\nconst conformanceCheckResults= items.map(item => ({\n  \"WorkOrderId\":item.WorkOrderId,\n  \"Batch\": item.WorkOrderNumber,\n  \"PrimaryProduct\": item.ItemNumber,\n  \"StartDate\": item.PlannedStartDate.split(\"T\")[0],\n  \"BatchQuantity\":item.BatchQuantity,\n  \"BatchUomCode\":item.PrimaryProductUOM,\n  \"ConformanceResult\":item.ConformanceCheckResult,\n  \"ConformanceCheckResultDate\":item.ConformanceCheckResultDate,\n  \n}));\n\nreturn conformanceCheckResults;"
