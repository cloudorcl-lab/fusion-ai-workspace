          "code": "FIN_AP_CONVERT_OFFER_PREVIEW_RESPONSE",
          "id": "1770659257190",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Construct History response",
            "returnType": "object",
            "sourceCode": "const rawOutput =\n  $context?.$nodes?.FIN_AP_WORKFLOW_OFFER_CONFIRMATION_PREVIEW_HISTORY?.$output?.output;\n\nconst confirmationPreviewOutput =\n  typeof rawOutput === \"string\" ? JSON.parse(rawOutput) : rawOutput;\n\nconst vars = $context?.$variables?.variables ?? $context?.$variables ?? {};\n\nconst resultJson = {\n  confirmationResponse: confirmationPreviewOutput?.previewFlowResponse,\n  variables: {\n    isOfferPreviewed: confirmationPreviewOutput?.variable?.offerPreview,\n    offerDetails: vars?.offerDetails,\n    previewData: vars?.previewedOffers\n  }\n};\n\nreturn resultJson;"
          },
          "outcomes": {
            "success": "1767957764408"
          },
          "diagram": {
            "x": 6331.25,
            "y": 6982
          },
          "code": "FIN_AP_CONSTRUCT_HISTORY_RESPONSE",
          "id": "1770729294818",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Clarification Response",
            "returnType": "object",
            "sourceCode": "const rawOutput =\n  $context.$nodes.FIN_AP_LLM_OFFER_PAYLOAD_CONSTRUCTOR.$output.invokeRetrieverMessage;\n\n\nconst confirmationPreviewOutput =\n  typeof rawOutput === \"string\"\n    ? [\n        {\n          type: \"text\",\n          content: [rawOutput], \n          sequence: 1\n        }\n      ]\n    : rawOutput; // if it's already structured, leave as-is\n\nconst vars = $context?.$variables?.variables ?? $context?.$variables ?? {};\n\nconst resultJson = {\n  confirmationResponse: confirmationPreviewOutput,\n  variables: {\n    isOfferPreviewed: \"No\",\n    offerDetails: null,\n    previewData: null\n  }\n};\n\nreturn resultJson;"
          },
