          "code": "FIN_AP_CONVERT_RESPONSE",
          "id": "1770658903206",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Convert Offer Preview Response",
            "returnType": "object",
            "sourceCode": "const responseString = $context.$nodes.FIN_AP_WORKFLOW_OFFER_CONFIRMATION_PREVIEW_HISTORY.$output.output ;\n\nconst jsonObject = JSON.parse(responseString);\n\n// updated name from child flow\nconst previewFlowResponse = jsonObject.previewFlowResponse;\nconst offerPreview = jsonObject.variable?.offerPreview;\n\nif (offerPreview === \"Yes\") {\n  jsonObject.previewData = previewFlowResponse;\n} else {\n  jsonObject.previewData = \"test\";\n}\n\nreturn jsonObject;"
          },
          "outcomes": {
            "success": "1770639135767"
