        {
          "metadata": {
            "name": "Add Amount To Confirm Offers",
            "returnType": "object",
            "sourceCode": "const offerProcessingResponse = $context.$nodes.FIN_AP_BO_CONFIRM_OFFER.$output\nconst offerDetails = $context.$triggers.REST.$input.offerDetails \n\nconst enrichWithOfferAmount = (offerProcessingResponse, offerDetails) => {\n  const items = offerDetails?.items ?? [];\n\n  // Build lookup map\n  const amountBySupplierCurrency = items.reduce((acc, item) => {\n    const key = `${item.supplierId}|${item.currencyCode}`;\n    const amount = Number(item.totalUnpaidAmount || 0);\n\n    acc[key] = (acc[key] || 0) + amount;\n    return acc;\n  }, {});\n\n  // Enrich response\n  return {\n    ...offerProcessingResponse,\n    offerProcessingResultsPerSupplier: (offerProcessingResponse?.offerProcessingResultsPerSupplier ?? []).map(result => {\n      const key = `${result.supplierId}|${result.currencyCode}`;\n      const totalUnpaidAmount = amountBySupplierCurrency[key] || 0;\n\n      return {\n        ...result,\n        totalUnpaidAmount\n      };\n    })\n  };\n};\n\nreturn enrichWithOfferAmount(offerProcessingResponse, offerDetails);"
          },
          "outcomes": {
            "success": "1770614549556"
          },
          "diagram": {
