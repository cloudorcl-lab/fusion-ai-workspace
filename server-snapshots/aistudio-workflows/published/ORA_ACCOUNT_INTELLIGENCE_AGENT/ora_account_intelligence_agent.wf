        {
          "id": "1778550436401",
          "code": "PREPARE_ACCOUNT_PRODUCT_INSIGHTS_PARAMETERS",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Account Product Insights Parameters",
            "returnType": "object",
            "sourceCode": "let result = {};\n\nconst accountId = $context.$variables?.accountId || null;\n\nresult = {\n  message: $context.$system?.$inputMessage || \"\",\n  action: {\n    name: \"GET_OWNED_PRODUCTS_BY_PRODUCT_HIERARCHY\",\n    config: {\n      accountIds: String(accountId)\n    }\n  },\n  commonConfiguration: $context.$triggers.REST.$input.commonConfiguration || {},\n  filterConfiguration: {\n    filterProductByTerritory: false\n  }\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1778550436400"
          },
          "inputs": [],
          "diagram": {
            "x": 6820,
            "y": 6335
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
