                      "type": "string",
                      "value": "{{$context.$nodes.BUILD_INSIGHT_OUTCOMES.$output.result}}"
                    }
                  ]
                },
                {
                  "id": "1775409576175",
                  "code": "BUILD_INSIGHTS_REFERENCE_BLOCK_OUTPUT",
                  "type": "CODE",
                  "metadata": {
                    "name": "Build Insights Reference Block Output",
                    "sourceCode": "let result = {};\ntry {\n  // Safely access inputs and outputs from upstream nodes\n  const outcomesPayload = $context.$nodes?.PERSIST_INSIGHTS?.$input?.outcomes_payload || {};\n  const persistOutput = $context.$nodes?.PERSIST_INSIGHTS?.$output || {};\n\n  // Merge the two objects, later properties overwrite earlier ones if keys overlap\n  result = { ...outcomesPayload, ...persistOutput };\n} catch (error) {\n  // On error, return empty object to satisfy return type\n  result = {};\n}\n\nreturn result;",
                    "returnType": "object"
                  },
                  "diagram": {
