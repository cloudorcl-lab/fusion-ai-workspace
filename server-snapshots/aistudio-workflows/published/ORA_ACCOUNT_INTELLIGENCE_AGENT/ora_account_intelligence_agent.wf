                  },
                  "inputs": []
                },
                {
                  "id": "1778120450138",
                  "code": "BUILD_INACTIVATE_PAYLOAD",
                  "type": "CODE",
                  "metadata": {
                    "name": "Build Inactivate Payload",
                    "returnType": "array",
                    "sourceCode": "const items = [];\nconst outcomeType = 'INSIGHT';\nconst category = $context.$input.Category;\nconst primaryObjectType = 'ACCOUNT';\nconst primaryObjectAltKey = $context.$triggers.REST.$input.action.config.accountNumber;\nconst status = 'EXPIRED';\nconst expiryTime = new Date().toISOString();\n\n[ 'HEALTH_ASSESSMENT', 'RISK_ASSESSMENT', 'GROWTH_ASSESSMENT'].forEach( outcomeSubtype => {\n  items.push( {\n    '$operation': 'MERGE',\n    '$lookupBy': {\n      outcomeType,\n      outcomeSubtype,\n      category,\n      primaryObjectType,\n      primaryObjectAltKey\n    },\n    status,\n    expiryTime\n  });\n});\n\nreturn items;"
                  },
                  "diagram": {
                    "x": 10036,
                    "y": 5241
                  },
                  "outcomes": {
                    "success": "1778120956016"
                  },
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "id": "1778120956016",
                  "code": "INACTIVATE_EXISTING_INSIGHTS",
                  "type": "BO_FUNCTION",
                  "metadata": {
                    "name": "Inactivate Existing Insights",
                    "businessObjectCode": "ORA_CX_SALESFORCE_AIOUTCOMESTORE",
                    "functionName": "createOutcome"
                  },
                  "diagram": {
                    "x": 10030,
                    "y": 5463
                  },
                  "outcomes": {
                    "success": "1775405860106"
                  },
                  "inputs": [
                    {
                      "id": "1778120956016_outcomes_payload",
                      "name": "outcomes_payload",
                      "value": "{{$context.$nodes.BUILD_INACTIVATE_PAYLOAD.$output.result}}",
                      "required": false,
                      "type": "string"
                    }
                  ],
                  "outputSpecification": ""
                },
                {
                  "id": "1775405860106",
                  "code": "BUILD_INSIGHT_OUTCOMES",
                  "type": "CODE",
                  "metadata": {
                    "name": "Build Insight Outcomes",
                    "sourceCode": "let result = [];\ntry {\n  const rawOutcomes = $context.$input?.InsightOutcomeFromLLM;\n  const llmOutcomes = Array.isArray(rawOutcomes)\n    ? rawOutcomes\n    : rawOutcomes && typeof rawOutcomes === \"object\" && Array.isArray(rawOutcomes.items)\n      ? rawOutcomes.items\n      : [];\n  const accountId = $context.$variables?.accountId;\n  const accountNumber = $context.$triggers?.REST?.$input?.action?.config?.accountNumber;\n  const agentJobKey = $context.$workflow?.$conversationId || null;\n  const expiryTime = new Date(Date.now() + 2592000000).toISOString();\n\n  result = llmOutcomes\n    .filter((outcome) => outcome && outcome.what && outcome.what.facts && outcome.what.facts.actionableSignal)\n    .map((outcome) => {\n      const actionableSignal = outcome.what.facts.actionableSignal;\n      const outcomeSubtype = actionableSignal === \"RISK\"\n        ? \"RISK_ASSESSMENT\"\n        : actionableSignal === \"HEALTH\"\n          ? \"HEALTH_ASSESSMENT\"\n          : actionableSignal === \"EXPANSION\"\n            ? \"GROWTH_ASSESSMENT\"\n            : null;\n\n      if (!outcomeSubtype || !accountId || !accountNumber) {\n        return null;\n      }\n\n      return {\n        \"$operation\": \"MERGE\",\n        \"$lookupBy\": {\n          outcomeType: \"INSIGHT\",\n          outcomeSubtype,\n          category: $context.$input?.Category,\n          primaryObjectType: \"ACCOUNT\",\n          primaryObjectAltKey: accountNumber\n        },\n        outcomeType: \"INSIGHT\",\n        outcomeSubtype,\n        category: $context.$input?.Category,\n        primaryObjectType: \"ACCOUNT\",\n        primaryObjectKey: accountId,\n        primaryObjectAltKey: accountNumber,\n        status: \"ACTIVE\",\n        urgency: outcomeSubtype === \"RISK_ASSESSMENT\" ? \"HIGH\" : outcomeSubtype === \"HEALTH_ASSESSMENT\" ? \"MEDIUM\" : \"LOW\",\n        generatedBy: \"agent:AccountIntelligenceAgent/v1\",\n        agentJobKey,\n        effectiveDate: new Date().toISOString(),\n        expiryTime,\n        payload: JSON.stringify(outcome)\n      };\n    })\n    .filter(Boolean);\n} catch (error) {\n  result = [];\n}\n\nreturn result;",
                    "returnType": "array"
                  },
                  "diagram": {
                    "x": 10036,
                    "y": 5685
                  },
                  "outcomes": {
                    "success": "1775406055452"
                  },
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "id": "1775406055452",
