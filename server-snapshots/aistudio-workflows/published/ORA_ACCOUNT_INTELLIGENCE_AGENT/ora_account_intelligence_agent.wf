        {
          "id": "1775406398900",
          "code": "PERSIST_COMMERCIAL_INSIGHT_OUTCOMES",
          "type": "REFERENCE",
          "metadata": {
            "name": "Persist Commercial Insight Outcomes",
            "referenceableBlockId": "PERSIST_INSIGHTS_REFERENCE_BLOCK"
          },
          "diagram": {
            "x": 7468,
            "y": 9161
          },
          "outcomes": {
            "success": "1775165248912"
          },
