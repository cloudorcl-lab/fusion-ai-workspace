        {
          "id": "1778120956018",
          "code": "PREPARE_OPPORTUNITY_SUMMARY_PARAMETERS",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Opportunity Summary Parameters",
            "sourceCode": "const records = $context.$nodes.LOAD_OPEN_OPPORTUNITIES?.$output || [];\n\nconst objectAltKeys = records\n  .map((record) => record?.OptyNumber)\n  .filter((value) => value !== null && value !== undefined)\n  .map((value) => String(value).trim())\n  .filter((value) => value.length > 0);\n\nreturn {\n  objectType: \"OPPORTUNITY\",\n  objectAltKeys\n};",
            "returnType": "object"
          },
          "outcomes": {
            "success": "1778120956019"
          },
          "inputs": [],
          "diagram": {
            "x": 5507.5,
            "y": 6798
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1778120956020",
          "code": "PREPARE_OPPORTUNITY_INSIGHTS_PAYLOAD",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Opportunity Insights Payload",
            "sourceCode": "const records = $context.$nodes.LOAD_OPEN_OPPORTUNITIES?.$output || [];\n\nconst opportunityIds = records\n  .map((record) => record?.OptyId)\n  .filter((value) => value !== null && value !== undefined)\n  .map((value) => String(value).trim())\n  .filter((value) => value.length > 0);\n\nconst filterValues = opportunityIds.length > 0 ? opportunityIds.join(\", \") : \"-1\";\n\nconst result = {\n  collection: {\n    filter: \"opportunity.id in (\" + filterValues + \")\"\n  },\n  fields: [\n    \"id\",\n    \"engagementInsightNumber\",\n    \"additionalInsightData\"\n  ],\n  accessors: {\n    objectives: {\n      collection: {\n        sortBy: [\n          { \"objectiveDesignTime.displaySequence\": \"asc\" }\n        ]\n      },\n      accessors: {\n        highValueActivities: {\n          collection: {\n            sortBy: [\n              { \"highValueActivityDesignTime.displaySequence\": \"asc\" }\n            ]\n          },\n          fields: [\n            \"highValueActivityNumber\",\n            \"highValueActivityStatus\",\n            \"justification\"\n          ],\n          accessors: {\n            highValueActivityDesignTime: {\n              fields: [\"name\"]\n            }\n          }\n        },\n        objectiveDesignTime: {\n          fields: [\"name\", \"description\"]\n        }\n      },\n      fields: [\"objectiveNumber\", \"objectiveStatus\", \"timeUpdated\"]\n    },\n    salesMotion: {\n      fields: [\"name\"]\n    },\n    opportunity: {}\n  }\n};\n\nreturn result;",
            "returnType": "object"
          },
          "outcomes": {
            "success": "1778120956022"
          },
          "inputs": [],
          "diagram": {
            "x": 6059.5,
            "y": 6798
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
