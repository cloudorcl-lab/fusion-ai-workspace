        {
          "id": "1775405855091",
          "code": "PERSIST_INSIGHTS_REFERENCE_BLOCK",
          "type": "REFERENCEABLEBLOCK",
          "metadata": {
            "name": "Persist Insights Reference Block",
            "dataPipeline": {
              "rootNode": "start_1775405855091",
              "pipelineNodes": [
                {
                  "id": "start_1775405855091",
                  "code": "START",
                  "type": "START",
                  "metadata": {
