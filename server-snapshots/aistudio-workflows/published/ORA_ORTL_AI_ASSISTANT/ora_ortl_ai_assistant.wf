        {
          "metadata": {
            "name": "input parser",
            "returnType": "object",
            "sourceCode": "const inputData = $context.$system.$inputMessage ;\nconst inputJSON = JSON.parse(inputData);\nconst groupLabel = inputJSON.group?? \"AI Assistant\";\nconst promptText = inputJSON.prompt?? \"Summarize this content into one paragraph of text\";\nconst htmlContentText = inputJSON.htmlContent?? \"\";\n\nconst result = {\n    groupLabel : inputJSON.group,\n    promptText : inputJSON.prompt,\n    htmlContentText : inputJSON.htmlContent  \n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1766157919254"
          },
          "code": "INPUT_PARSER",
          "id": "1766157881170",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "set var"
          },
          "outcomes": {
            "success": "1766157994640"
          },
          "code": "SET_VAR",
          "id": "1766157919254",
          "inputs": [
            {
              "id": "1766157969331",
              "name": "htmlContentText",
              "type": "string",
              "value": "{{$context.$nodes.INPUT_PARSER.$output.result.htmlContentText}}"
            },
            {
              "id": "1766157949654",
              "name": "promptText",
              "type": "string",
              "value": "{{$context.$nodes.INPUT_PARSER.$output.result.promptText}}"
            },
            {
              "id": "1766157921613",
              "name": "groupLabel",
              "type": "string",
              "value": "{{$context.$nodes.INPUT_PARSER.$output.result.groupLabel}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "ai node"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "AI_NODE",
          "id": "1766157994640",
          "inputs": [
            {
              "id": "1766157994642_1",
              "name": "prompt",
              "type": "string",
              "value": "**Agent Instructions**\nYou are smart AI agent that converts the input HTML according to the rules\n\n## IMPORTANT RULES TO FOLLOW\n- Keep the HTML tags in the result as well\n- DO NOT remove the HTML tags\n- If there are any HTML tags in between the text, make sure the converted text should contain those HTML tags as-is\n\n## STEPS TO FOLLOW\n- Set the Agent context as ** {{$context.$variables.groupLabel}} ** for the input text\n- If **{{$context.$variables.htmlContentText}}** is empty then generate the content as defined in the **{{$context.$variables.promptText}}** and store it in **`content`** field\n- Else convert the HTML text **{{$context.$variables.htmlContentText}}** AS-IS using **{{$context.$variables.promptText}}** as important instruction and store it in **`content`** field\n\n**Important**\n- Do **NOT** add json schema related in the response"
            }
          ],
          "outputSpecification": "{\n    \"type\": \"object\",\n    \"properties\": {\n        \"content\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        }
      ],
