              "value": "{{$context.$nodes.EVALUATE_QUERY.$output.result.q}}"
            },
            {
              "id": "1770380720348_3",
              "name": "sort",
              "type": "string",
              "value": "{{$context.$nodes.EVALUATE_QUERY.$output.result.sort}}"
            },
            {
              "id": "1770380720350_4",
              "name": "limit",
              "type": "integer",
              "value": "50"
            },
            {
              "id": "1770380720351_5",
              "name": "fields",
              "type": "string",
              "value": "{{$context.$nodes.EVALUATE_QUERY.$output.result.fields}}"
            }
          ],
          "outputSpecification": "{}",
