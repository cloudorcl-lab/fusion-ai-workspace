        {
          "metadata": {
            "name": "Determine Entity",
            "returnType": "object",
            "sourceCode": "let result = { AgentCode: \"\", Message: \"\" };\n\ntry {\n  let oraActionStr = $context.$app?.$OraAction || \"\";\n  let storedAgentCode = ($context?.$nodes?.GETIDENTIFIER?.$output?.[0]?.text || \"\").trim();\n\n  let AgentCode = storedAgentCode;\n  let Message = oraActionStr;\n\n  try {\n    let parsed = JSON.parse(oraActionStr);\n    AgentCode = (parsed.AgentCode || storedAgentCode).trim();\n    Message = (parsed.message || oraActionStr).trim();\n  } catch (e) {\n    // If parsing fails, keep original values\n  }\n\n  result = { AgentCode, Message };\n} catch (error) {\n  result = { AgentCode: \"\", Message: \"\" };\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776187775170"
          },
          "code": "DETERMINE_ENTITY",
          "id": "1773164131276",
          "inputs": [],
