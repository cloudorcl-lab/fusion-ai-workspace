{
  "workflowId": "100002355227126",
  "workflowCode": "ORA_DATA_CAPTURE_CREATION_AGENT_TEAM",
  "name": "Data Capture Creation Agent Team",
  "description": "A tool-driven agent that creates data capture rules from user requests by validating attributes against system metadata. It confirms existence, IDs, object codes, and updatability, asks concise clarifying questions when anything is missing or ambiguous, and never fabricates details. When all checks pass, it returns a single, clean JSON payload with the rule name, description, objectCode, and validated attributes including brief evaluation notes.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1768213621366"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "description": "End of data pipeline",
            "name": "End"
