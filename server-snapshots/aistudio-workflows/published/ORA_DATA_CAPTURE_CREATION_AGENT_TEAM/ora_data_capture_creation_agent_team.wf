            "toolCode": "ORA_MULTI_FILE_PROCESSOR_TOOL",
            "parseFiles": true
          },
          "outcomes": {
            "success": "1768213643461"
          },
          "code": "DOCUMENT_TOOL",
          "id": "1768213621366",
          "inputs": [
            {
              "id": "1768213626506",
