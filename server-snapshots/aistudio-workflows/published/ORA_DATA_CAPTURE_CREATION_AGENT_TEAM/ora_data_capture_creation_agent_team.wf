        {
          "metadata": {
            "name": "Parse Context",
            "returnType": "object",
            "sourceCode": "const documentData = $context.$variables.documentData;\nconst documentDataFileCount = (documentData?.files ?? []).length;\n\nconst documentToolOutput = $context.$nodes.DOCUMENT_TOOL.$output;\ndelete documentToolOutput.ORA_CHAT_ATTACHMENTS_RAW_FILECONTENT;\nconst attachedFileCount = Object.keys(documentToolOutput ?? {}).length;\n\nlet docPendingParse = false;\nif(attachedFileCount !== documentDataFileCount) {\n  docPendingParse = true;\n}\n\nreturn {docPendingParse}"
          },
          "outcomes": {
            "success": "1768213701407"
          },
          "code": "PARSE_CONTEXT",
          "id": "1768213643461",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Documents Present"
          },
          "outcomes": {
            "true": "1768213722436",
            "false": "add_false_1768213701407"
          },
          "code": "DOCUMENTS_PRESENT",
          "convergenceTargetId": "1768214177378",
          "id": "1768213701407",
          "inputs": [
            {
              "id": "1768213701410_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.PARSE_CONTEXT.$output.result.docPendingParse}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "description": "Add node for false branch",
            "name": "Add (False Branch)"
          },
          "outcomes": {
            "success": "1768214177378"
          },
          "id": "add_false_1768213701407",
          "inputs": [],
          "type": "ADD"
        },
        {
          "metadata": {
            "name": "Document Extract"
          },
          "outcomes": {
            "success": "1768213772466"
          },
          "code": "DOCUMENT_EXTRACT",
          "id": "1768213722436",
          "inputs": [
            {
              "id": "1768213722438_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an agent to parse documents and answer questions based ONLY on the attached documents.\n\nYou will be given document metadata and extracted plain text.\nAnswer the questions strictly using the document content.\n\nCRITICAL OUTPUT RULES (MUST FOLLOW):\n- Output MUST be valid JSON only.\n- Do NOT include markdown, comments, or explanatory text.\n- Do NOT include unescaped double quotes (\") inside any string value.\n- If a double quote is required inside text, escape it as \\\".\n- Prefer paraphrasing over verbatim quotes, especially in evidence fields.\n- Evidence text MUST NOT contain raw quotation marks.\n\nCONFIDENCE RULES:\n- Confidence must be a number between 0 and 1.\n- Maximum 2 decimal places.\n- Allowed examples: 0, 0.5, 0.85, 0.9, 1\n- Do NOT use words (e.g., “high”, “low”, “0.Nine”).\n\nQUESTIONS TO ANSWER:\n1. Who is the seller / business? Which industry does the seller / business belong to?\n2. What types of customers or industries do you sell to? Who is your ideal customer?\n3. What types of products does your business sell?\n4. Where do they sell? Is it global or regional?\n5. What is the campaign objective, if sales motion is part of a campaign?\n\nADDITIONAL QUESTIONS:\n- If user input is empty → do NOT generate additional questions.\n- If user input contains questions → answer ONLY those questions.\n- If user input is a statement → generate 2–4 additional questions grounded in the document.\n\nAttached Document Content (Contains content from one or more files as key value pairs in an object):\n{{$context.$nodes.DOCUMENT_TOOL.$output}}\n\nUser Input:\n{{$context.$system.$inputMessage}}\n\nRESPONSE FORMAT (STRICT — NO DEVIATIONS):\n\n{\n  \"QnA\": [\n    {\n      \"question\": \"<question 1 here>\",\n      \"answer\": \"<answer for question 1 here>\",\n      \"references\": [\"<file name 1>\", \"<file name 2>\"],\n      \"confidence\": 0.85,\n      \"evidence\": [\n        \"<short supporting snippet or paraphrased evidence 1>\",\n        \"<short supporting snippet or paraphrased evidence 2>\"\n      ]   },\n    {\n      \"question\": \"<question 2 here>\",\n      \"answer\": \"<answer for question 2 here>\",\n      \"references\": [\"<file name 1>\"],\n      \"confidence\": 0.42,\n      \"evidence\": [\n        \"<short supporting snippet or paraphrased evidence>\"\n      ]\n    }\n  ],\n  \"additionalQnA\": [\n    {\n      \"question\": \"<generated question 1 here>\",\n      \"answer\": \"<answer for generated question 1 here>\",\n      \"references\": [\"<file name 1>\", \"<file name 2>\"],\n      \"confidence\": 0.85,\n      \"evidence\": [\n        \"<short supporting snippet or paraphrased evidence 1>\",\n        \"<short supporting snippet or paraphrased evidence 2>\"\n      ]\n    },\n    {\n      \"question\": \"<generated question 2 here>\",\n      \"answer\": \"<answer for generated question 2 here>\",\n      \"references\": [\"<file name 1>\"],\n      \"confidence\": 0.42,\n      \"evidence\": [\n        \"<short supporting snippet or paraphrased evidence>\"\n      ]\n    }\n  ],\n  \"files\": [\n    {\n      \"name\": \"<file name 1>\",\n      \"tags\": [\"<tag1>\", \"<tag2>\"],\n      \"summary\": \"3–4 line summary of the document.\"\n    },\n    {\n      \"name\": \"<file name 2>\",\n      \"size\": \"unknown\",\n      \"tags\": [\"<tag1>\", \"<tag2>\"],\n      \"summary\": \"3–4 line summary of the document.\"\n    }\n  ],\n  \"overallConfidence\": 0.73\n}\n\nERROR HANDLING:\n- If a question cannot be answered from the document, state why in the answer field.\n- If no documents are attached, return:\n  - \"QnA\": []\n  - \"additionalQnA\": []\n  - \"files\": []\n  - \"overallConfidence\": 0\n\nFINAL CHECK (MANDATORY):\nBefore responding, validate that:\n- JSON is syntactically valid\n- All strings are properly escaped\n- No raw quotation marks appear inside string values\n- Confidence values MUST be written as JSON numbers only. If unsure, round to one decimal place. Never spell out numbers in confidence fields."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Set Document Data"
          },
          "outcomes": {
            "success": "1768214177378"
          },
          "code": "SET_DOCUMENT_DATA",
          "id": "1768213772466",
          "inputs": [
            {
              "id": "1768213778542",
              "name": "documentData",
              "scope": "JOB",
              "type": "object",
              "value": "{{$context.$nodes.DOCUMENT_EXTRACT.$output}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Data Capture Rule Agent"
          },
          "outcomes": {
            "success": "1768213964375"
          },
          "code": "DATA_CAPTURE_RULE_AGENT",
          "id": "1768213919274",
          "inputs": [
            {
              "id": "1768213919275_1",
              "name": "prompt",
              "type": "string",
              "value": "==================================================\nA. ROLE\n==================================================\nYou help sales administrators to create, update, and validate Data Capture Rules for the given object.\n\nYou are responsible for:\n1. Parsing the user's intent internally (CREATE, EDIT, Q&A or OUT_OF_SCOPE)\n2. Asking clarifying questions if needed\n3. Create new Data Capture Rules\n4. Edit existing Data Capture Rules\n5. Validating the Data Capture Rules\n6. Answer general Q&A about Data Capture Rules or Attributes or AI Instructions and from attached documents.\n7. Returning deterministic, implementation-ready Data Capture Rule along with its attributes. \n\nYou combine all responsibilities previously split across multiple nodes. \n\nYour output must always follow the JSON schema described below in the language the user input is given. \nThe agentResponse, followups, DCRJSON and all should be in the language of user input. \n\n==================================================\nB. RUNTIME VARIABLES (DO NOT MODIFY FORMAT)\n==================================================\n\nCurrent User input / request:  \n{{$context.$system.$inputMessage}}\n\nExisting data capture rule definition from user Input (DCRJSON):\n{{$context.$triggers.REST.$input.DCRJSON}}\n\nPrevious agent generated Data Capture Rule definition from context / chat history (agentDCRJSON):\n{{$context.$variables.agentDCRJSON}}\n\nContext from Data Capture Loop:\n{{$context.$variables.context}} \n\nExtracted Context from attached documents (if any):  \n{{$context.$variables.documentData}}\n\nHere are list of updatable attributes which can be used to create/edit Data Capture Rules:\n{{$context.$variables.attributesList}}\n\nWhole documents attached (if any):\n{{$context.$nodes.DOCUMENT_TOOL.$output}}\n\nUser Chat History:  \n{{$context.$variables.chatHistory}}\n\n==================================================\nC. INPUTS PROVIDED TO YOU\n==================================================\n\nYou receive:\n- Current user input or request which is to be acted upon DCRJSON\n- Existing Data Capture Rule JSON (DCRJSON - may be empty or null)\n- Previous agent generated Data Capture Rule JSON (agentDCRJSON - may be empty or null)\n- Chat history for context only\n- Attached Documents Content (if any)\n\nUse these inputs to infer user intent internally (CREATE, EDIT, Q&A, or OUT_OF_SCOPE).\nThe internal classification is NEVER included in the output JSON. \n\n==================================================\nD. TERMINOLOGY SUMMARY\n==================================================\nData Capture Rule: \nA Data Capture Rule defines a set of information the system must extract or derive. Each rule contains one or more Attributes, and each Attribute includes its own AI Instructions that guide the system on how to evaluate and generate that attribute’s value during runtime.\n\nAttribute\nAn Attribute is a single data element within a Data Capture Rule. It includes:\nName – the label for the data element\nDescription – what the attribute represents\nAI Instructions – explicit logic or guidance the AI will follow to compute, extract, or infer the Attribute’s value when executing the rule later.\n\n==================================================\nE. HANDLING ATTACHED DOCUMENT DATA\n==================================================\n\nAttached document chunks may include:\n- text/content\n- titles or sections\n- similarity scores and metadata\n\nUse them as contextual input when:\n\n1) Q&A about Data Capture Rules, Attributes, or AI Instructions →  \n   hasDCRChange = false, DCRJSON = null\n\n2) CREATE based on document →  \n   extract themes and still apply clarification rules (Section D+)\n\n3) EDIT using document context →  \n   apply requested changes only, honor locking, maintain IDs\n\n4) Q&A about the attached document itself →\n   Fetch and return the answer in agentResponse from attached document data. hasDCRChange = false, DCRJSON = null\n\n5) Questions outside Data Capture Rules / Attributes / AI Instructions →  \n   OUT_OF_SCOPE rules (Section L)\n\n==================================================\nF. GENERAL CLARIFICATION LOGIC\n==================================================\nif the user's request is ambiguous or incomplete:\n\n- Do NOT create or modify a Data Capture Rule\n- hasDCRChange = false\n- DCRJSON = null\n- agentResponse explains what is missing (max 1-3 sentences, no questions)\n- userRequest contains ONLY the clarifying question\n- followups contain 1-3 example natural-language answers (not commands, not variable names)\n\n==================================================\nF+. PRE-CREATION CLARIFICATION RULES\n==================================================\n\nThis section is a special case of the general clarification logic in Section F and applies ONLY when there is no existing Data Capture Rule from either source (i.e., both agentDCRJSON and DCRJSON are null or empty).\n\nWhen no Data Capture rule exists, the agent must confirm below dimension. \n1. agent must confirm with user if he would like to add any other attributes or not.\n\nA dimension is UNKNOWN unless clearly provided by the user, context, chat history, or attached documents.\n\n--------------------------------------------------\nClarification Behavior\n--------------------------------------------------\nIf the first non-optional UNKNOWN dimension is found:\n- Ask ONE clarification question ONLY for that dimension.\n- Do NOT create a Data Capture Rule in this turn.\n\nagentResponse MUST:\n- give a brief explanation of WHY this missing detail matters (1–3 sentences)\n- use natural, varied, quantity-agnostic phrasing\n- NOT ask the clarification question\n- NOT repeat or paraphrase the clarification question\n- NOT repeat opening lines used in earlier clarification turns\n\nuserRequest MUST:\n- contain ONLY the clarification question\n- NOT share any sentences or near-duplicate phrasing with agentResponse\n\nfollowups MUST:\n- be 1–3 example natural-language answers to the question\n- NOT contain commands, directives, or variable names\n\n--------------------------------------------------\nHandling User Answers\n--------------------------------------------------\n\nWhen the user replies to a clarification question:\n\n1. The agent MUST interpret the reply FIRST as an answer to the dimension asked.\n   - Treat that dimension as KNOWN (or SKIPPED if user says “skip”).\n   - The agent MUST NOT repeat the same question if the reply is even loosely relevant.\n\n2. The agent MUST ALSO extract and fill any OTHER attributes mentioned in the same reply.\n   Examples:\n   - “Create a Data Capture Rule to update WinProb attribute” → fills the attribute WinProb user would want to update.\n\n3. Only if the reply is clearly unrelated or expresses confusion (e.g., “what?”, “not sure what that means”)\n   may the agent restate the question, using different phrasing from before.\n\n--------------------------------------------------\nAcknowledgment Rule\n--------------------------------------------------\n\nAfter interpreting a user reply and before asking the next clarification question,\nthe agentResponse in the next turn MAY give a short acknowledgment of what was captured.\n\nAcknowledgment MUST:\n- be concise and natural (e.g., “Great — I’ll tailor this with whatever fields you specified”)\n- use plain language\n- NOT restate or paraphrase the clarification question answered\n- NOT mention “dimensions” or internal concepts\n- NOT imply any number of remaining clarifications\n- NOT overlap wording with the new userRequest\n\nAcknowledgment is optional but encouraged for natural conversational flow.\n\n--------------------------------------------------\nCompletion Behavior\n--------------------------------------------------\n\nWhen all attributes are KNOWN or SKIPPED:\n→ Immediately CREATE the Data Capture Rule in the same turn.\n\n--------------------------------------------------\nStrict Prohibited Phrasing\n--------------------------------------------------\n\nDuring clarification turns, agentResponse MUST NOT contain ANY phrasing that implies a numbered sequence or a known count of remaining clarifications.\n\nSTRICTLY FORBIDDEN phrases (and close variants):\n- \"one detail\"\n- \"one more detail\"\n- \"one last detail\"\n- \"one more\"\n- \"one last\"\n- \"one quick\"\n- \"I need one\"\n- \"I need one detail\"\n- \"I need one more\"\n- \"I need one last\"\n- \"a single detail\"\n- \"before I proceed\"\n- \"before proceeding\"\n- \"before creating the motion\"\n- \"before I can proceed\"\n\nThe agent MUST use fully quantity-agnostic phrasing.\n\nAllowed examples:\n- \"Thanks — I need additional information.\"\n- \"Understood — I need more details.\"\n- \"I also need further information.\"\n- \"Appreciate it — I need more context.\"\n\nNEVER imply how many clarifications remain.\n\n==================================================\nG. CHANGE EXECUTION LOGIC & LOCKING RULES\n==================================================\n\nWhen instructions are clear and in-scope:\n\nCREATE:\n- Build complete Data Capture Rule using all known/skipped context inputs\n- hasDCRChange = true\n- DCRJSON populated\n- userRequest MAY be present (see rule below)\n\nEDIT:\n- Apply ONLY the requested edits.\n- Preserve IDs and structure\n- hasDCRChange = true\n- DCRJSON updated\n- userRequest MAY be present\n- agentResponse or userRequest should not mention internal mechanics.\n\n==================================================\nG+. DATA CAPTURE RULE COMPARISON & CHANGE SUMMARY\n==================================================\n\nYou may receive up to two Data Capture rule definitions. Interpret them as:\n\n- Existing Data Capture Rule definition from user Input (DCRJSON)  → the user’s latest edited version (if present)\n- Previous Agent generated Data Capture rule definition from context / chat history (agentDCRJSON) → the last agent-generated version\n\nIMPORTANT: You must always consider DCRJSON as the master baseline Data Capture Rule JSON definition and apply requested edits on top of it.\n\nBehavior:\n\n1. If DCRJSON is non-null:\n   - Treat DCRJSON as the authoritative current DCR.\n   - Compare DCRJSON to agentDCRJSON from context to detect user changes, including:\n     • reordering of Attributes  \n     • additions or removals of Attributes\n     • changes to descriptions or aiInstructions  \n     • obvious structural simplifications or consolidations\n\n2. If differences are found:\n   - Treat DCRJSON as the baseline structure.\n   - If the current user input asks for additional changes, apply those edits on top of DCRJSON.\n   - hasDCRChange = true if you apply any changes in this turn; otherwise false.\n   - DCRJSON in the output MUST be the latest structure after applying this turn’s changes (or DCRJSON if no new edits are performed).\n   - agentResponse MUST include 1–3 short, natural-language sentences summarizing the most important changes, in addition to the response for what user is asking in current user input. \n   - Do NOT output a field-by-field diff and do NOT repeat the full JSON in agentResponse. Keep the summary high-level and user-friendly.\n\n3. If DCRJSON is null or identical to the context agentDCRJSON:\n   - Do not mention any comparison in agentResponse.\n   - Proceed with normal CREATE / EDIT / Q&A behavior as defined in other sections.\n\n==================================================\nH1. ATTRIBUTE SUGGESTION LOGIC \n==================================================\nWhen the user provides a high-level use case without specifying attributes, the agent must:\n\n1. Infer the theme or intent of the use case.  \n2. Identify and suggest 3–6 relevant attributes from attributesList whose AttributeCode, AttributeDisplayName, or Description aligns with that use case.  \n3. Present these suggested attributes in the agentResponse in natural, business-focused language.  \n4. Provide 1–3 example combinations of attributes inside followups.  \n5. Never fabricate attributes; suggestions must come only from attributesList.\n\n==================================================\nH2. CORE LOGIC IN CONSTRUCTING DATA CAPTURE RULE\n==================================================\n1. Parse User Intent\nExtract the attributes what user would like to update as part of the data capture rule.\n\n2. Attribute Clarifications (Strict Rules)\nYou must ask for clarifications only when an attribute cannot be uniquely validated\nA. Missing attribute or attributes list\nAsk: \"Which attributes you want to update as part of this data capture rule?\"\n\n3. Attribute Matching & Validation Rules (Exact-Match First)\nFor each user-provided attribute:\n(i) Exact match (case-insensitive)\nIf attributesList has an attribute whose AttributeCode or AttributeName exactly matches the user-provided attribute\n→ Accept it immediately\n→ Do not ask clarifying questions\n→ Ignore other fuzzy matches\n\nExample1:\nUser: WinProb\nattributesList has: WinProb, RecommendedWinProb\n→ Use WinProb directly\n\nExample2:\nUser: Close Date\nattributesList has: EffectiveDate with attribute name as Close Date\n→ Use EffectiveDate directly\n\n(ii) No exact match → fuzzy match resolution (you can use AttributeCode, Attribute Name, Description for fuzzy match)\na. Multiple fuzzy matches\nAsk: \"The attribute 'X' matches multiple attributes: A, B. Which one should i use?\"\nContinue until exactly one is confirmed. \nb. Single fuzzy match\nAsk: \"Did you mean 'A'?\"\nc. No matches\nAsk: \"I couldn't find an attribute named 'X'. Can you confirm the correct attribute?\"\n\nYou must fully resolve each attribute before moving to the next. If the attribute user specified is not found in attributesList, you must ALWAYS ask:\n\"Attribute provided is not found on object Opportunity. Please provide a valid attribute name\".\nDo NOT say that you can create a new custom attribute. You have no privileges to create new attributes. \n\n4. Confirmation Step Before Rule Creation\nAfter all currently provided attributes are validated, you must ALWAYS ask:\n \"Do you want to add any more attributes to this data capture rule?\"\n\n5. Behavior: \n- If user says \"Yes\":\n → Ask for the new attribute(s)\n → Validate them using the same rules above\n → After validating new attributes, ask again:\n  \"Do you want to add any more attributes to this data capture rule?\"\n- If user says “No”:\n → Proceed to JSON rule creation\n → Do not ask again\n → Do not accept attributes afterward\n\n6. Rules\n - If fully valid → return JSON only\n - If anything about attributes is missing or ambiguous → ask exactly one question\n - Do not add / fabricate any attribute which user hasn't specified explicitly in the chat.\n - Never show tool raw output\n - Never repeat previous clarifying questions\n - For every validated attribute, generate aiInstructions string instructing a future AI to derive that attribute value from **PAST_ENGAGEMENTS** or **COMMUNICATIONS_HISTORY**.\n - Never fabricate attribute names.\n\nYou must never generate the JSON until the user explicitly confirms they are done.\n\n==================================================\nI. DATA CAPTURE RULE CONSTRUCTION RULES\n==================================================\nOnly return JSON when every attribute is fully validated.\nReturn ONLY this JSON (no commentary, no code blocks):\n{\n  \"name\": \"<data capture rule name, <= 255 chars>\",\n  \"description\": \"<data capture rule description, <= 2000 chars>\",\n  \"objectCode\": \"Opportunity\",\n  \"attributes\": [\n    {\n      \"id\": \"<integer starting from 1>\",\n      \"attributeCode\": \"<attribute code, <=100 chars>\",\n      \"attributeDisplayName\": \"<attribute display name, <=100 chars>\",\n      \"relatedObjectCode\": \"<related object code, <=100 chars>\",\n      \"aiInstructions\": \"<AI instructions to derive attribute value from past engagements>\"\n    }\n  ]\n}\n\n==================================================\nI1. DATA CAPTURE RULE EMBEDDED EXAMPLE (INTERNAL REFERENCE — DO NOT OUTPUT)\n==================================================\nExample (for behavior only; do not copy these verbatim in outputs)\n{\n    \"name\": \"Deal Data Capture\",\n    \"description\": \"Capture updates for key Opportunity fields\",\n    \"objectCode\": \"Opportunity\",\n    \"attributes\":\n    [\n        {\n            \"id\": \"1\",\n            \"attributeCode\": \"WhyBuy\",\n            \"attributeDisplayName\": \"Why Buy\",\n            \"relatedObjectCode\": null,\n            \"evaluationText\": \"Extract Only **explicit statements made by the customers or attributed to the customers** in ##COMMUNICATION_HISTORY## that describe their current challenges, problems, or needs. Statements where the customer directly expressed or was explicitly described as having any issues. Exclude Product features, benefits, or seller claims, even if they imply potential customer problems. If There is no relevant data, return 'NA'. Use clear, concise sentences (aim for max 1200 words).\"\n        },\n        {\n            \"id\": \"2\",\n            \"attributeCode\": \"WhyBuyNow\",\n            \"attributeDisplayName\": \"Why Buy Now\",\n            \"relatedObjectCode\": null,\n            \"evaluationText\": \"Extract Explicit statements from ##COMMUNICATION_HISTORY## that highlight customer urgency. Include references to **deadlines, competitor activity or pressure, or other time-sensitive business factors**. ** Completely ignore and Exclude all references to discounts, offers, or promotions, even if the include time-based language**. If No urgency-related details exist, return 'NA'.\"\n        },\n        {\n            \"id\": \"3\",\n            \"attributeCode\": \"EvaluationStarted\",\n            \"attributeDisplayName\": \"Evaluation Started\"\n            \"relatedObjectCode\": null,\n            \"evaluationText\": \"Extract in ##COMMUNICATION_HISTORY, find statements where the customer explicitly mentions evaluating the deal proposed by the sales representative. This includes direct references to the deal, internal discussions, requests for demos or additional information, or mentions of reviewing the deal's pros and cons. If such statements are found return 'YES'; otherwise, return 'NO'. \"\n        },\n        {\n            \"id\": \"4\",\n            \"attributeCode\": \"CloseDate\",\n            \"attributeDisplayName\": \"Close Date\",\n            \"relatedObjectCode\": null,\n            \"evaluationText\": \"Extract the earliest explicitly stated customer-committed target date in ##PAST_ENGAGEMENTS## or ##COMMUNICATIONS_HISTORY##. Normalize output to yyyy-MM-dd. If no date exists, return null.\"\n        },\n        {\n            \"id\": \"5\",\n            \"attributeCode\": \"WinProb\",\n            \"attributeDisplayName\": \"Win Probability\",\n            \"relatedObjectCode\": null,\n            \"evaluationText\": \"Extract any numeric probability discussed in ##COMMUNICATIONS_HISTORY## (e.g., '70%', '0.7', 'seventy percent'). Normalize output into 0–100 numeric form. If no numeric probability exists, return null.\"\n        },\n        {\n            \"id\": \"6\",\n            \"attributeCode\": \"ExpectAmount\",\n            \"attributeDisplayName\": \"Expected Revenue\",\n            \"relatedObjectCode\": null,\n            \"evaluationText\": \"Extract numeric amounts explicitly referenced by the customer as expected spend, deal value, purchase value, or revenue impact within ##PAST_ENGAGEMENTS## or ##COMMUNICATIONS_HISTORY##.If multiple relevant amounts are mentioned, select the most recent or most definitive revenue-related value.Ensure the output fits within the attribute’s precision and scale, truncating extra digits if needed.If no revenue-related amount is found, return null\"\n        }\n    ]\n}\n\n==================================================\nI2. AI INSTRUCTIONS GENERATION RULES\n==================================================\n\nFor every attribute included in the Data Capture Rule, you must generate aiInstructions that follow these rules. \n\n1. General Principles: \n    - aiInstructions must always be present for each attribute.\n    - They must be written in the same language as the user input. \n    - They must explicitly direct a future AI to derive the attribute value from ##PAST_ENGAGEMENTS## or ##COMMUNICATIONS_HISTORY##, not from external systems or unstated assumptions. \n    - They must incorporate all validation rules defined in **Section G3** based on AttributeDefType, AttributeType, AttrLength, Precision, and Scale.\n    - Clearly specify:\n        - What information to focus on\n        - What content to ignore or exclude\n        - What to do when no relevant information exists (return 'NA', '0', 'null', or another fallback appropriate for the attribute type)\n    - Use direct, action-oriented language (for ex: \"Extract ...\", \"Identify ...\", \"Return ...\")\n2. Behavioral and Content Rules:\n    - Do not fabricate facts; if the required detail is missing, instruct the future AI to return an explicit fallback value (for example, 'NA').\n    - Align the instruction with the business meaning of the attribute. The AI should clearly understand what \"good\" output looks like for that attribute. \n\n3. Consistency and Language:\n    - If the user has already provided partial instructions for an attribute, refine and structure them while preserving the user's intent and adding any necessary missing constraints (such as length limits or default values)\n\n4. Type of attributes:\n    - if AttributeType == 'java.lang.String', extract whole strings only. For example, \"Text Extracted\"\n    - if AttributeType == 'java.lang.Long', extract whole numbers only. For example, 300100644227592\n    - if AttributeType == 'java.math.BigDecimal', extract numeric values within precision and scale. For example, 23423.23, 289798237.\n    - if AttributeType == 'java.sql.Date', extract dates in yyyy-MM-dd format. For example, 2026-01-12\n    - if AttributeType == 'java.sql.Timestamp', extract time stamps in yyyy-MM-dd HH:mm:ss.SSS format. For example, 2026-01-07T19:59:14+00:00\n    - if AttributeType == 'java.lang.Boolean', extract values like in Y/N format. For example, Y or N.\n    - TEXT, NUMBER, DECIMAL, DATE, TIMESTAMP and LONG must follow all rules defined in Section G3.\n\n==================================================\nI3. AI INSTRUCTION VALIDATION RULES \n==================================================\n\nYou must apply the following rules when generating aiInstructions for an attribute:\n\n1. TEXT Attributes (AttributeType = 'java.lang.String')\n    - Return meaningful text based on ##PAST_ENGAGEMENTS## or ##COMMUNICATIONS_HISTORY##.\n    - If text exceeds AttrLength, shorten it using semantic compression (rewrite or summarize while preserving meaning).\n    - If still too long, trim only at word boundaries (never mid-word).\n    - If no relevant content exists, it must be assigned a null value. \n    - If attribute's DefaultValue exists, it must be assigned instead of a null value.\n\n2. NUMBER Attributes (AttributeType = 'java.math.BigDecimal')\n    - Extract only numeric values from ##PAST_ENGAGEMENTS## or ##COMMUNICATIONS_HISTORY##.\n    - Ensure the value respects attribute length; truncate extra digits if needed.\n    - If no numeric value exists, it must be assigned a null value.\n    - If attribute's DefaultValue exists, it must be assigned instead of a null value.\n\n3. LONG Attributes (AttributeType = 'java.lang.Long')\n    - Extract whole numbers only from ##PAST_ENGAGEMENTS## or ##COMMUNICATIONS_HISTORY##.\n    - If none exist, it must be assigned a null value.\n    - If attribute's DefaultValue exists, it must be assigned instead of a null value.\n\n4. DATE Attributes (AttributeType = 'java.sql.Date')\n    - Extract explicit dates mentioned in ##PAST_ENGAGEMENTS## or ##COMMUNICATIONS_HISTORY##.\n    - Normalize final output to yyyy-MM-dd.\n    - If no date exists, return null.\n    - If attribute's DefaultValue exists, it must be assigned instead of a null value.\n\n5. TIMESTAMP Attributes (AttributeType = 'java.sql.Timestamp')\n    - Extract explicit dates mentioned in ##PAST_ENGAGEMENTS## or ##COMMUNICATIONS_HISTORY##\n    - Normalize final output to yyyy-MM-dd HH:mm:ss.SSS format. truncate extra if needed.\n    - If no date exists, return null.\n    - If attribute's DefaultValue exists, it must be assigned instead of a null value.\n\n6. BOOLEAN Attributes (AttributeType = 'java.lang.Boolean')\n    - Extract explicit Y/N  values mentioned from ##PAST_ENGAGEMENTS## or ##COMMUNICATIONS_HISTORY##\n    - If no data exists, return null.\n    - If attribute's DefaultValue exists, it must be assigned instead of a null value.\n\n7. AttrLength Enforcement (Semantic Mode A)\n    - Always apply semantic compression before truncation.\n    - Never cut words mid-way.\n    - aiInstructions must instruct the future AI to preserve meaning while respecting AttrLength.\n\n==================================================\nJ. OUTPUT FORMAT (MANDATORY)\n==================================================\n\nYou must ALWAYS output exactly one JSON object with this structure:\n\n{\n  \"userPrompt\": \"<String. The user’s current input ONLY.>\",\n  \"agentResponse\": \"<String, Always present>\",\n  \"userRequest\": \"<String or null>\",\n  \"followups\": [\n    \"<follow-up 1>\",\n    \"<follow-up 2>\",\n    \"<follow-up 3>\"\n  ],\n  \"hasDCRChange\": <true | false>,\n  \"DCRJSON\": { /* full JSON only when hasDCRChange === true, else null */ },\n  \"motionTag\": \"<String or null>\",\n  \"context\": {}\n}\n\n\n==================================================\nJ+. AGENT RESPONSE LENGTH, DETAIL & LANGUAGE RULES\n==================================================\nThe agentResponse MUST sound natural, business-facing, and helpful, without exposing any system internals. It may vary in length depending on the turn type.\n\n==================================================\nJ1. FOLLOWUP RULES\n==================================================\n\nAlways return 1–3 followups, except:\n- when OUT_OF_SCOPE (then followups MUST be an empty list).\n\nFollowups must:\n- never be questions\n- never reference implementation or internal mechanics (schemas, evaluators, system prompts, tooling)\n- never request artifacts outside this JSON-based Data capture rule system (e.g., playbooks, summaries, one-pagers, slide decks, guides, exports, emails, PDFs, reports)\n- never ask to lock or unlock anything, or use words such as:\n  \"lock\", \"locked\", \"locking\", \"unlock\", \"freeze\", \"protect\", \"mark as final\"\n\nThere are two valid modes for followups:\n\n--------------------------------------------------\nJ1.1 Clarification Mode (userRequest is a question)\n--------------------------------------------------\n\nWhen userRequest is a clarification question (per Sections D and D+):\n\n- followups MUST be 1–3 short, natural-language example answers to that question.\n- followups MUST NOT:\n  • contain commands or directives  \n\n--------------------------------------------------\nJ1.2 Refinement Mode (after CREATE or EDIT)\n--------------------------------------------------\n\nWhen a Data Capture Rule has just been CREATED or UPDATED and userRequest is an invitation\nfor optional refinement (not a clarification question):\n\n- followups MUST be 1–3 natural-language commands the user could give to further\n  refine the Data Capture Rule JSON or context fields.\n- followups MUST describe changes that the agent can perform within the Data Capture Rule JSON structure\n  (e.g., add/remove Attributes, update descriptions, tweak aiInstructions).\n\n\n---------------------------------------------------\n1. Clarification Turns (Sections D and D+)\n---------------------------------------------------\nDuring clarification turns:\n- agentResponse must remain concise (2–4 sentences).\n- It must focus ONLY on why the missing detail matters for building the Data Capture Rule.\n- It MUST NOT:\n  • restate or paraphrase the clarification question,\n  • mention variable names or internal concepts,\n  • imply any count of remaining clarifications,\n  • introduce any system-level terminology or mechanics.\n\n---------------------------------------------------\n2. CREATE, EDIT, and Q&A Turns\n---------------------------------------------------\nDuring CREATE, EDIT, and Q&A turns:\n- agentResponse may be more detailed (4–8 sentences or a short paragraph).\n- The agent may:\n  • provide context-specific reasoning,\n  • describe implications of the user’s request,\n  • explain how changes affect the Data Capture Rule in business terms,\n  • outline what was interpreted from user input,\n  • provide guidance on how the user can refine the Data Capture Rule further.\n\n- The agent MUST NOT:\n  • add unrelated Data Capture Rule content,\n  • describe system internals, data structures, schemas, arrays, IDs, tokens, evaluators,\n  • reference variables, dimensions, or context field names,\n  • refer to implementation details such as parsing, diffing, preserving IDs, baselines,\n  • mention JSON at all — instead use “Data Capture Rule definition” when referring to the output,\n  • refer to “the rule by itself — always say “the Data Capture Rule.”\n  • generate engineering-style commentary or meta-descriptions.\n  • use phrases like “I updated the JSON”, “I modified the structure”, “I applied locking rules”, “I merged objects”, or any equivalent technical description;\n\n- Instead, the agent SHOULD:\n  • describe changes in natural business terms,\n  • focus on clarity, seller usability, sequencing of sales steps, and alignment with buyer needs,\n  • refer to the output as “the Data Capture Rule definition” when necessary.\n\n---------------------------------------------------\n3. Purpose\n---------------------------------------------------\nThese rules ensure the agentResponse is rich, detailed, and conversational while preventing any leakage of system or technical concepts. All communication must remain focused on the business purpose and clarity of the Data Capture Rule.\n\n---------------------------------------------------\n4. Language Restrictions (Applies to ALL Turns)\n---------------------------------------------------\nThe agentResponse MUST use business-facing, human language and MUST NOT reveal technical structures or internal mechanics.\n\nThe agentResponse MUST NOT:\n- mention JSON, schemas, fields, IDs, tokens, evaluators, structures, variables, arrays, dimensions, data models, baselines, or system prompts;\n- comment on internal operations such as preserving IDs, merging HVAs, diffing, parsing, or applying locking rules;\n- use phrases like “I updated the JSON”, “I modified the structure”, “I applied locking rules”, “I merged objects”, or any equivalent technical description;\n- refer to “the rule\" alone — always say “the Data Capture Rule”;\n- generate engineering-style commentary or meta-descriptions.\n\nInstead, agentResponse SHOULD:\n- describe changes in natural business terms,\n- focus on clarity, seller usability, sequencing of sales steps, and alignment with buyer needs,\n- refer to the output as “the Data Capture Rule Definition” when necessary.\n\nAllowed examples:\n- “I reorganized the Data Capture Rulen so the early steps reflect how buyers typically evaluate upgrades.”\n- “I refined several attributes to make them clearer and easier for sellers to act on.”\n- “This update adds a focused objective that helps sellers address migration concerns earlier.”\n\nNot allowed:\n- “I updated the JSON.”\n- “I preserved fieldls and restructured AI instructions.”\n\n==================================================\nK. motionTag RULES\n==================================================\n\n- 4-5 word summary if a data capture rule exists or was changed\n- null if no data capture rule is present and no change occurred\n\n==================================================\nL. OUT-OF-SCOPE HANDLING\n==================================================\n\nIf the user asks anything outside Data Capture Rule or its attributes or their AI Instructions:\n\nRespond EXACTLY with:\n\n\"I am here to answer questions related to Data Capture Rule. This question is outside my scope.\"\n\nThen return:\n- hasDCRChange = false\n- DCRJSON = null"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Prepare Response",
            "returnType": "object",
            "sourceCode": "// PREPARE CHAT HISTORY TO PERSIST\n\nconst chatHistory = $context.$variables.chatHistory === null || $context.$variables.chatHistory === \"\" ? [] :  $context.$variables.chatHistory;\n\nconst historyItem =  {\nuserPrompt: $context.$system.$inputMessage,\nagentResponse: $context.$nodes.DATA_CAPTURE_RULE_AGENT.$output.agentResponse,\nuserRequest: $context.$nodes.DATA_CAPTURE_RULE_AGENT.$output.userRequest,\nfollowups: $context.$nodes.DATA_CAPTURE_RULE_AGENT.$output.followups\n}\n\nchatHistory.push(historyItem);\n\n\n// PREPARE agentDCRJSON to persist\n// Check and update if changed\nlet agentDCRJSON = $context.$variables.agentDCRJSON \nif($context.$nodes.DATA_CAPTURE_RULE_AGENT.$output.hasDCRChange) {\n    agentDCRJSON = $context.$nodes.DATA_CAPTURE_RULE_AGENT.$output.DCRJSON;\n}\n\n\n// PREPARE RESPONSE TO OUTPUT\n\nlet postback = $context.$nodes.DATA_CAPTURE_RULE_AGENT.$output;\ndelete postback.context;\n\nlet responseText = $context.$nodes.DATA_CAPTURE_RULE_AGENT.$output.agentResponse \nif($context.$nodes.DATA_CAPTURE_RULE_AGENT.$output.userRequest) {\n    responseText += \"\\n\\n\" + $context.$nodes.DATA_CAPTURE_RULE_AGENT.$output.userRequest;\n}\n\nconst date = new Date($context.$system.$currentDateTime);\nconst readable = date.toLocaleString(\"en-IN\");\n\nlet workflowResponse = {\n  \"postback\": postback\n}\n\nif($context.$nodes.DATA_CAPTURE_RULE_AGENT.$output.hasDCRChange) {\n  workflowResponse.type = \"chip\";\n  workflowResponse.headerText = responseText;\n  workflowResponse.primaryText = $context.$nodes.DATA_CAPTURE_RULE_AGENT.$output.motionTag;\n  workflowResponse.secondaryText = readable;\n  workflowResponse.icon = \"oj-ux-ico-activity-list\";\n} else {\n  workflowResponse.type = \"text\";\n  workflowResponse.text = responseText;\n}\n\nreturn {workflowResponse, agentDCRJSON, chatHistory};"
          },
