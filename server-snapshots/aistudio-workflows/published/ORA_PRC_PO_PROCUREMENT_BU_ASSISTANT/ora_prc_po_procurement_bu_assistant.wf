              "name": "pBusinessUnitId",
              "type": "string",
              "value": "{{$context.$nodes.GET_DEFAULT_BU_ID.$output.items[0].ProfileOptionValue}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"ProcurementBU\": {\n            \"type\": \"string\"\n          },\n          \"ProcurementBUId\": {\n            \"type\": \"number\"\n          },\n          \"AgentAction\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"ProcurementBU\",\n          \"ProcurementBUId\",\n          \"AgentAction\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "description": "",
            "name": "BU Clarification Message"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "BU_CLARIFICATION_MESSAGE",
          "id": "1776968004252",
          "inputs": [
            {
              "id": "1776968004252_prompt",
              "name": "prompt",
              "type": "string",
              "value": "You are a helpful assistant.\n\nThe user sent the following message:\n{{$context.$system.$inputMessage}}\n\nExtracted Procurement Business Unit:\n{{$context.$nodes.BU_NAME_EXTRACTOR.$output.ProcurementBUName}}\n\nYour task:\n- Generate a short, polite, and user-friendly response.\n- If Extracted Procurement Business Unit is null or blank, ask the user to specify the Procurement Business Unit they want to switch to. Do not provide example business unit names.\n- If Extracted Procurement Business Unit has a value, do not ask the user to specify it again. Instead, say that the Procurement Business Unit \"<value>\" could not be found or is not available to them, and ask them to check the name or their access.\n- Do not say the Procurement Business Unit was missing when a value was extracted.\n- Keep the tone natural and concise.\n- Do not mention internal systems, extraction logic, APIs, lookup failures, or errors.\n\nOutput:\nReturn only the message text. Do not use JSON. Do not add explanations."
            }
          ],
          "type": "LLM"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [],
              "enableActions": true,
              "enableCommunications": false
            }
          },
          "metadata": {
            "name": "Perform Context Switch"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "PERFORM_CONTEXT_SWITCH",
          "id": "1776437243973",
          "inputs": [
            {
              "id": "1776437243981_1",
              "name": "prompt",
              "type": "string",
              "value": "Selected Procurement BU:\n{{$context.$nodes.GET_BU_INFO.$output.items[0]}}\n\nCurrent app context:\n{{$context.$triggers.REST.$input.OraAppContext}}\n\nProduce one immediate actionable insight with a followUpCommand that calls SWITCHCONTEXT using a JSON object app context.\n\nThe followUpCommand must use this command shape:\nora.Invoke(\"SWITCHCONTEXT\", { \"payload\": <merged payload JSON object> })\n\nBuild <merged payload JSON object> by reading the payload from Current app context, preserving any existing payload keys such as riskType, and replacing or adding:\n- prcBUId: ProcurementBUId from the selected Procurement BU\n- prcBUName: ProcurementBU from the selected Procurement BU\n\nIf Current app context is empty or has no payload, use a payload containing only prcBUId and prcBUName.\nDo not output the placeholder text."
            },
            {
              "id": "1776437243973_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": ""
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Extract BU Info",
            "returnType": "object",
            "sourceCode": "let output = $context.$nodes.GET_DEFAULT_BU_NAME.$output.items[0];\nlet buInfo = {\n  prcBUId: output.ProcurementBUId,\n  prcBUName: output.ProcurementBU\n};\nreturn buInfo;"
          },
          "outcomes": {
            "success": "1776594572002"
          },
