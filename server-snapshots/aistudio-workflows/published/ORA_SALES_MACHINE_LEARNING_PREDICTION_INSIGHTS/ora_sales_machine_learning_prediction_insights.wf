{
  "workflowId": "300000331056527",
  "workflowCode": "ORA_SALES_MACHINE_LEARNING_PREDICTION_INSIGHTS",
  "name": "Sales Machine Learning Prediction Insights Agent",
  "description": "Workflow agent that provides explanations for the recommendations and predictions generated by our machine learning models which are trained on sales objects.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
