            "sourceCode": "let raw =\n  $context.$nodes.GET_CODE_INFO?.$output?.result?.code_info ??\n  $context.$nodes.GET_CODE_INFO?.$output?.code_info ??\n  $context.$nodes.GET_CODE_INFO?.$output?.result ??\n  \"\"; \n\nif (typeof raw === \"object\") {\n  raw = JSON.stringify(raw);\n} \n\nlet info = \"\";\ntry {\n  const parsed = JSON.parse(raw);\n  info = parsed?.code_info ?? raw;\n} catch (_) {\n  info = raw;\n} \n\nArray.from(String(info)).length"
