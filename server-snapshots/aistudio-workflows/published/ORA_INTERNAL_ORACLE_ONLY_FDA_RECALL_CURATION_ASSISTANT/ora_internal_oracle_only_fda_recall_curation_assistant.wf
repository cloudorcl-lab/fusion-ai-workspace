            "success": "1772427725387"
          },
          "code": "CREATE_FINAL_HEADER_JSON",
          "id": "1772427703604",
          "inputs": [
            {
              "id": "1772427703605_1",
              "name": "prompt",
              "type": "string",
              "value": "Merge the JSON obtained from {{$context.$nodes.PARSE_EXACT_HEADER_ATTRIBUTES.$output.result}} (JSON_A)\nwith the JSON obtained from {{$context.$nodes.PARSE_CONTACTS_AND_REPLACEMENT_TYPE_CODE.$output}} (JSON_B)\nand with the JSON obtained from {{$context.$nodes.PARSE_DATES_JSON.$output.result}} \n\nThis includes:\n- \\n\n- \"\n- \\\"\n- \\\\\n- tabs\n- spaces\n- ALL escape characters\n- ALL backslashes\n- ALL internal quotes inside strings\n\nYou MUST NOT:\n- Modify, trim, clean, escape, unescape, normalize, or alter ANY part of ANY string.\n- Convert \\\" into \" or remove backslashes.\n- Re-interpret or repair escaped quotes.\n- Change newline structure.\n- Add or remove characters inside long text fields.\n\nMERGE RULES:\n----------------------------------------------------------\n- Start with JSON_A.\n- Override keys with matching keys from JSON_B.\n- Override keys with matching keys from JSON_C.\n- All values must remain EXACTLY as provided in their source JSONs.\n\nOUTPUT REQUIREMENTS:\n----------------------------------------------------------\n- Output MUST be valid JSON.\n- Every key MUST be in double quotes.\n- Every string MUST be in double quotes.\n- Telephone numbers MUST be strings.\n- DO NOT add explanations, comments, or formatting.\n- Return ONLY the final merged JSON.\n\nSTRICT VALIDITY CLAUSE:\n----------------------------------------------------------\nIf preserving the exact characters results in JSON escaping that looks unusual,\nyou MUST NOT fix it.\nYou MUST preserve the original escape sequences exactly as they appeared.\n\nReturn ONLY the merged JSON. Nothing else.\n"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Validate Header Payload",
            "returnType": "object",
            "sourceCode": "var inputJson = $context.$nodes.CREATE_FINAL_HEADER_JSON.$output; \n\nvar requiredFields = [\n  \"RecallReceivedFrom\",\n  \"StatusCode\",\n  \"RecallReportDate\",\n  \"RecallInitiationDate\"\n];\n\nvar missing = [];\n\nfor (var i = 0; i < requiredFields.length; i++) {\n  var field = requiredFields[i];\n\n  if (!(field in inputJson) || inputJson[field] === null || inputJson[field] === \"\") {\n    missing.push(field);\n  }\n}\n\nvar finalResponse = {};\n\nif (missing.length === 0) {\n  finalResponse = {\n    \"Response\": true\n  };\n} else {\n  finalResponse = {\n    \"Response\": false,\n    \"Reason\": \"Missing or null fields: \" + missing.join(\", \")\n  };\n}\n\nreturn finalResponse;\n"
          },
          "outcomes": {
            "success": "1772427780126"
          },
          "code": "VALIDATE_HEADER_PAYLOAD",
