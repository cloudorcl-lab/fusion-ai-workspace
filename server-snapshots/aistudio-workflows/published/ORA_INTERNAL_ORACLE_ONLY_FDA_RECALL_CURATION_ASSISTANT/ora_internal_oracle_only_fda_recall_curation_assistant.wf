        {
          "metadata": {
            "name": "Get Code Info",
            "returnType": "object",
            "sourceCode": "// Extract values\nconst recall = $context.$variables.fdaRecallEndpointJSON ;\nconst enforce = $context.$variables.fdaEnforcementJSON;\n\nconst response = recall?.results?.[0] || {};\nconst enforcement = enforce?.results?.[0] || {};\n\n// Helper: pick from recall first, else enforcement\nconst pick = (key) => response[key] || enforcement[key];\n\n// Build CodeInfo object\nconst CodeInfo = {};\n\n// Direct assign — raw value, no cleaning\nconst codeInfoValue = pick(\"code_info\") || pick(\"more_code_info\");\n\nif (codeInfoValue) {\n  CodeInfo[\"code_info\"] = codeInfoValue;  // raw value\n}\n\n// Return the object\nreturn CodeInfo;\n"
          },
          "outcomes": {
            "success": "1772427324577"
          },
          "code": "GET_CODE_INFO",
          "id": "1772427292532",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get Product Description",
            "returnType": "object",
            "sourceCode": "// Extract values from recall and enforcement\nconst recall = $context.$variables.fdaRecallEndpointJSON ;\nconst enforce = $context.$variables.fdaEnforcementJSON;\n\nconst response = recall?.results?.[0] || {};\nconst enforcement = enforce?.results?.[0] || {};\n\n// Helper: first use recall, then fallback to enforcement\nconst pick = (key) => {\n  if (response[key] !== undefined && response[key] !== null && response[key] !== \"\") {\n    return response[key];\n  }\n  if (enforcement[key] !== undefined && enforcement[key] !== null && enforcement[key] !== \"\") {\n    return enforcement[key];\n  }\n  return null;\n};\n\n// Build product description object\nconst ProductDescription = {};\n\n// ✅ NO CLEANING — raw text exactly as received\nconst prodDescValue = pick(\"product_description\");\n\nif (prodDescValue) {\n  ProductDescription[\"product_description\"] = prodDescValue;\n}\n\n// Return final object\nreturn ProductDescription;\n"
          },
          "outcomes": {
            "success": "1772427422736"
          },
          "code": "GET_PRODUCT_DESCRIPTION",
          "id": "1772427324577",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
