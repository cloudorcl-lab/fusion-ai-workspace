        },
        {
          "metadata": {
            "name": "Trim Input JSON"
          },
          "outcomes": {
            "success": "1772427511025"
          },
          "code": "TRIM_INPUT_JSON",
          "id": "1772427480027",
          "inputs": [
            {
              "id": "1772427480029_1",
              "name": "prompt",
              "type": "string",
              "value": "You will receive two JSON objects:\n1. The recall JSON from the Recall Endpoint (primary source) - {{$context.$variables.fdaRecallEndpointJSON}} \n2. The enforcement JSON (secondary fallback) - {{$context.$variables.fdaEnforcementJSON}} \n\nYour task is to construct a final JSON using these rules:\n\n---\n\n### ✅ GENERAL RULES\n- Never remove or modify newline characters (`\\n`) in any field.\n- Never escape characters like quotes (`\"`). Keep text EXACTLY as present in the source.\n- Never shorten or truncate long text fields.\n- All keys in the final JSON MUST be inside quotes.\n- Always produce a valid JSON object.\n\n---\n\n### ✅ FIELD SELECTION LOGIC\nFor every field, follow the same rule:\n\n**Take the value from the Recall JSON first.  \nIf missing, null, empty, then take from Enforcement JSON.**\n\n---\n\n### ✅ TOP-LEVEL FIELDS TO INCLUDE\nCopy the following fields into the final JSON using the selection rule above:\n\n- cfres_id  \n- product_res_number  \n- event_date_initiated  \n- event_date_posted  \n- recall_status  \n- res_event_number  \n- product_code  \n- k_numbers  \n- recalling_firm  \n- address_1  \n- city  \n- state  \n- postal_code  \n- additional_info_contact  \n- reason_for_recall  \n- root_cause_description  \n- action  \n- product_quantity  \n- distribution_pattern  \n\n---\n\n### ✅ CLASSIFICATION FIELDS\nAdd these only if present (same recall-first rule):\n\n- classification  \n- voluntary_mandated  \n\n---\n\n### ✅ OPEN FDA SECTION\nCreate an \"openfda\" object containing **ONLY THESE 4 FIELDS**:\n\n- device_name  \n- medical_specialty_description  \n- regulation_number  \n- device_class  \n\nDo NOT include:\n- k_number array\n- registration_number\n- fei_number\n- any other openfda subfields\n\nUse recall-first fallback logic.\n\n---\n\n### ✅ IMPORTANT RULE: PRESERVE RAW TEXT\n- Do NOT modify spacing.\n- Do NOT modify `\\n`.\n- Do NOT modify escaped characters.\n- Do NOT insert or remove slashes.\n- Use text exactly as provided.\n\n---\n\n### ✅ FINAL OUTPUT FORMAT\nReturn ONLY the final JSON object:\n\n"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Parse Exact Header Attributes",
            "returnType": "object",
            "sourceCode": "//  Extract inputs from the Code Node\n//const fdaJson = $context.$triggers.REST.$input.fdaRecallJSON;\nconst fdaJson = $context.$nodes.TRIM_INPUT_JSON.$output ;\n\n//const fdaJson = $context.$nodes.LLM_PREP_INP.$output.result;\n// Object to collect header payload\nconst headerPayload = {};\n\n// Utility: add field only if value exists\nconst addIfValid = (key, value) => {\n  if (value !== undefined && value !== null && value !== \"\") {\n    headerPayload[key] = value;\n  }\n};\n\n// 1. Basic Identifiers\naddIfValid(\"RecallReferenceNumber\", fdaJson.product_res_number);\naddIfValid(\"RecallSourceReferenceId\", fdaJson.cfres_id);\naddIfValid(\"RecallReportDate\", fdaJson.event_date_posted);\naddIfValid(\"RecallInitiationDate\", fdaJson.event_date_initiated);\n\n// 2. Recalling Firm\nif (fdaJson.recalling_firm) {\n  [\"RecallingFirmProp\", \"RecallingFirm\", \"RecallingFirmSugg\"].forEach(k =>\n    addIfValid(k, fdaJson.recalling_firm)\n  );\n}\n\n// 3. Recall Instruction — RAW, NO CLEANING\nif (fdaJson.action) {\n  [\"RecallInstruction\", \"RecallInstructionProp\"].forEach(k =>\n    addIfValid(k, fdaJson.action)\n  );\n}\n\n// 4. Recall Reason & Risk — RAW\nif (fdaJson.reason_for_recall) {\n  [\n    \"RecallReason\",\n    \"RecallReasonProp\",\n    \"PotentialRisk\",\n    \"PotentialRiskProp\"\n  ].forEach(k => addIfValid(k, fdaJson.reason_for_recall));\n}\n\n// 5. Device Class Mapping\nif (fdaJson.openfda && fdaJson.openfda.device_class) {\n  const map = {\n    \"1\": \"ORA_SCH_PRM_LOW\",\n    \"2\": \"ORA_SCH_PRM_MODERATE\",\n    \"3\": \"ORA_SCH_PRM_HIGH\",\n    \"U\": \"ORA_SCH_PRM_UNCLASSIFIED\",\n    \"N\": \"ORA_SCH_PRM_NOTCLASSIFIED\",\n    \"F\": \"ORA_SCH_PRM_HDE\"\n  };\n  const mapped = map[fdaJson.openfda.device_class];\n  if (mapped) addIfValid(\"RecallDeviceClassCode\", mapped);\n}\n\n// 6. Classification Mapping\nif (fdaJson.classification) {\n  const clsMap = {\n    \"Class I\": \"ORA_SCH_PRM_CLASS1\",\n    \"Class II\": \"ORA_SCH_PRM_CLASS2\",\n    \"Class III\": \"ORA_SCH_PRM_CLASS3\"\n  };\n  const mapped = clsMap[fdaJson.classification];\n  if (mapped) {\n    addIfValid(\"RecallClsfTypeCode\", mapped);\n    addIfValid(\"RecallClsfTypePropCode\", mapped);\n  }\n}\n\n// 7. Contact Details — RAW, NO CLEANING\nif (fdaJson.additional_info_contact) {\n  addIfValid(\"ContactDetails\", fdaJson.additional_info_contact);\n}\n\n// 8. Voluntary/Mandated Mapping\nif (fdaJson.voluntary_mandated) {\n  const vmMap = {\n    \"Voluntary\": \"ORA_SCH_PRM_FDA_VOLUNTARY\",\n    \"FDA\": \"ORA_SCH_PRM_FDA_MANDATORY\"\n  };\n  const mapped = vmMap[fdaJson.voluntary_mandated];\n  if (mapped) {\n    addIfValid(\"RecallNoticeTypeCode\", mapped);\n    addIfValid(\"RecallNoticeTypePropCode\", mapped);\n  }\n}\n\n// Static values\nheaderPayload[\"RecallReceivedFrom\"] = \"U.S. FOOD & DRUG ADMINISTRATION\";\nheaderPayload[\"StatusCode\"] = \"ORA_SCH_PRM_PENDING_ACC\";\nheaderPayload[\"ModeOfCaptureCode\"] = \"ORA_SCH_PRM_MODE_REG_AUTHORITY\";\n\n// ✅ Return FULL RAW JSON (correct display)\nreturn JSON.parse(JSON.stringify(headerPayload));\n"
          },
          "outcomes": {
            "success": "1772427629450"
          },
          "code": "PARSE_EXACT_HEADER_ATTRIBUTES",
          "id": "1772427511025",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Parse Dates JSON",
            "returnType": "object",
            "sourceCode": "const json1 = $context.$nodes.PARSE_DATES_FROM_CODE_INFO.$output;\n\nconst json2 = $context.$nodes.PARSE_DATES_FROM_PRODUCT_DESC.$output ;\n\n// Helper to convert string → Date safely\nconst toDate = (d) => new Date(d);\n\n// Collect all start and end dates\nconst startDates = [\n  json1.TrackStartDate,\n  json1.TrackStartDateProp,\n  json1.TrackStartDateSugg,\n  json2.TrackStartDate,\n  json2.TrackStartDateProp,\n  json2.TrackStartDateSugg\n].filter(Boolean);\n\nconst endDates = [\n  json1.TrackEndDate,\n  json1.TrackEndDateProp,\n  json1.TrackEndDateSugg,\n  json2.TrackEndDate,\n  json2.TrackEndDateProp,\n  json2.TrackEndDateSugg\n].filter(Boolean);\n\n// Calculate minimum start and maximum end\nconst minStartDate = startDates.sort((a, b) => toDate(a) - toDate(b))[0];\nconst maxEndDate = endDates.sort((a, b) => toDate(b) - toDate(a))[0];\n\n// Build final output JSON\nconst result = {\n  TrackStartDate: minStartDate,\n  TrackStartDateProp: minStartDate,\n  TrackStartDateSugg: minStartDate,\n  TrackEndDate: maxEndDate,\n  TrackEndDateProp: maxEndDate,\n  TrackEndDateSugg: maxEndDate\n};\n\nreturn result;\n"
          },
          "outcomes": {
            "success": "1772427703604"
          },
          "code": "PARSE_DATES_JSON",
          "id": "1772427605556",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Run in Parallel"
          },
          "outcomes": {
            "0": "1772427639761",
            "1": "1772427656911",
            "2": "1772427674661",
            "3": "add_1772427629450_3"
          },
          "code": "PARALLEL_1772427629451",
          "convergenceTargetId": "1772427605556",
          "id": "1772427629450",
