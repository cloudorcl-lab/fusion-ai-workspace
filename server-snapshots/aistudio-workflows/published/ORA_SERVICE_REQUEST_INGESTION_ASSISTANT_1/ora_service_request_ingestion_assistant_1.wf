          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"ResolveDescription\": {\n            \"type\": \"string\"\n          },\n          \"ProblemDescription\": {\n            \"type\": \"string\"\n          },\n          \"Title\": {\n            \"type\": \"string\"\n          },\n          \"SrNumber\": {\n            \"type\": \"string\"\n          },\n          \"BUOrgId\": {\n            \"type\": \"string\"\n          },\n          \"QueueNumber\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}",
          "type": "BO_FUNCTION"
        },
