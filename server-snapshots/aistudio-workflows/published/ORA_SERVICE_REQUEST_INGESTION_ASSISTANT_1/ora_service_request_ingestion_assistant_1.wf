          "metadata": {
            "description": "Returns the error message produced by the Error Handler node.",
            "name": "Return Invalid Query Response"
          },
          "outcomes": {},
          "code": "RETURN_INVALID_QUERY_RESPONSE",
          "convergenceTargetId": "end",
          "id": "1775110562713",
          "inputs": [
            {
              "id": "1775110562714_1",
              "name": "returnValue",
              "type": "string",
              "value": "{{$context.$nodes.FORMAT_ERROR_MESSAGE.$output.result}}"
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "description": "Branches the flow based on the LLM validation result (valid true/false).",
            "name": "check SR Valid"
          },
          "outcomes": {
            "true": "1775501780903",
            "false": "1775804058600"
          },
          "code": "CHECK_SR_VALID",
          "convergenceTargetId": "end",
          "id": "1775501376833",
          "inputs": [
            {
              "id": "1775501376833_condition",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.CHECK_SR_VALIDATION.$output.valid}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "description": "Normalizes retrieved SR items into an array of {SrNumber, value} strings for the ingestion loop.",
            "name": "Clean And Validate SR Data",
            "returnType": "array",
            "sourceCode": "let srData = $context.$nodes.FETCH_RETRIEVE_RESOLVED_SRS.$output.items;\n\nlet outputArray = Array.isArray(srData)\n    ? srData.map(item => {\n        let title = item.Title || \"\";\n        let problem = item.ProblemDescription || \"\";\n        let resolve = item.ResolveDescription || \"\";\n        let srNumber = item.SrNumber || \"\";\n\n        let finalOutput = \"SrNumber : \" + srNumber +\n            \" ||| Title: \" + title +\n            \" ||| ProblemDescription: \" + problem +\n            \" ||| ResolveDescription: \" + resolve;\n\n        return {\n            SrNumber: srNumber,\n            value: finalOutput\n        };\n    })\n    : [];\n\nreturn outputArray;"
          },
          "outcomes": {
            "success": "1775110879328"
          },
          "code": "CLEAN_AND_VALIDATE_SR_DATA",
          "id": "1775110824602",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "description": "Builds a single SR document string from retrieved fields to send to the ingestion service.",
            "name": "setDocument",
            "returnType": "string",
            "sourceCode": "return `SrNumber : ${$context.$triggers.REST.$input.srNumber} ||| Title: ${$context.$nodes.RETRIEVE_RESOLVED_SR.$output.items[0].Title} ||| ProblemDescription: ${$context.$nodes.RETRIEVE_RESOLVED_SR.$output.items[0].ProblemDescription} ||| ResolveDescription: ${$context.$nodes.RETRIEVE_RESOLVED_SR.$output.items[0].ResolveDescription}`;"
          },
          "outcomes": {
            "success": "1775502032482"
          },
          "code": "SETDOCUMENT",
          "id": "1775501780903",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "description": "Returns a response when the SR does not meet the validation criteria for ingestion.",
            "name": "SR Not Valid"
          },
          "outcomes": {},
          "code": "SR_NOT_VALID",
          "id": "1775804058600",
          "inputs": [
