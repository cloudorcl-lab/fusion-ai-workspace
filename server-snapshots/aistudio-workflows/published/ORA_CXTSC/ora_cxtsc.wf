{
  "workflowId": "100002355226929",
  "workflowCode": "ORA_CXTSC",
  "name": "CX-TSC",
  "description": "Generate concise, meaningful Titles and Summaries for top-selling CPQ configurations identified by clustering, given a model name/description and input JSON of cluster centroids or representative configurations.\n- Analyze the provided JSON of clustered configurations. For each cluster, infer the configuration’s purpose from its key attributes (e.g., product family, capacity, performance tier, options, service levels).\n- Create a short, market-facing Title that captures the intent of the configuration (avoid internal jargon, include main differentiators).\n- Create a concise Summary explaining how the Title reflects the attributes and why the configuration is a “favorite/hot-selling” (e.g., value, common option bundles, balance of price/performance).\n- Output must be a single RFC8259-compliant JSON object exactly matching the specified schema, with no extra commentary.\n- Keep Titles under ~10 words and Summaries under ~40 words.\n- If attributes are missing or ambiguous, make conservative, non-speculative statements. \n- Language: English. Tone: clear and professional.\n- Validate output JSON keys exactly as: ModelName, ModelDescription, TopConfigurations, Title, Summary.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1763860283103"
          },
          "code": "START",
