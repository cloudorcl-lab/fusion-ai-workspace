          "code": "TSC",
          "id": "1763860283103",
          "inputs": [
            {
              "id": "1763860283104_1",
              "name": "prompt",
              "type": "string",
              "value": "Generate concise, meaningful Titles and Summaries for top-selling CPQ configurations from a given inputJson in {{$context.$system.$inputMessage}}\n\n\nSample Input \n\n{\n\"Model Name\": \"<string>\",\n\"Top Configurations\": {\n\"cluster<n>\": {\n\"configuration attributes\": { ... arbitrary key/value pairs ... }\n}\n}\n}\n\n\nCreate:\nTitle: ≤ 10 words, clear, market-facing, no trailing punctuation.\nSummary: ≤ 40 words; explain how the Title reflects the attributes and why it’s a likely top-seller (e.g., value, popular bundle, balance of performance/features). Be conservative; do not fabricate facts\n Generate the translations for both these items in the following ISO-639 language codes in {{$context.$variables.langCode}} .\n\n\nOutput\n\nReturn a single RFC8259-compliant JSON object with this exact shape and keys:\n{\n\"ModelName\": \"<copy inputJson['Model Name'] as-is>\",\n\"TopConfigurations\": {\n\"<cluster key from input>\": {\n\"Title\":  [{\"languageCode\": <language code>, \"value\": <translated title value>}], \"Summary\": [{\"languageCode\": <language code>, \"value\": <translated summary value>}]\n}\n}\n}\nPreserve each cluster key name exactly as found in input (e.g., \"cluster5\").\n\n"
            }
          ],
          "type": "LLM"
        }
      ],
      "rootNode": "start",
      "variables": [
        {
          "id": "1763860266084",
          "name": "inputJson",
          "type": "string"
        },
        {
