  "workflowId": "300000331062512",
  "workflowCode": "ORA_PERSON_TALENT_PROFILE_MARKDOWN_SYNTHESIZER",
  "name": "Person Talent Profile Markdown Synthesizer",
  "description": "Generates a clean, structured Markdown representation of a person’s talent profile from structured profile data. It transforms the profile into a deterministic, human-readable format optimized for semantic search, embeddings, and downstream AI processing, ensuring consistency and suitability for vectorization and retrieval use cases.",
