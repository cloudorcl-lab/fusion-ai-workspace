            "name": "PrepareData",
            "returnType": "string",
            "sourceCode": "const data = `You have the following knowledge you can use to answer questions\n\n<advisor id=\"BETA_PROJECTS_ADVISOR\">\n\n    <description>\n        Tracks the status, progress, and health of key company projects and strategic initiatives. It provides details on timelines, blockers, recent status changes, and the reasons for any delays, citing sources like JIRA, related bugs, and stakeholder communications.\n    </description>\n\n    <knowledge>\n\n        <project_portfolio last_updated=\"2025-09-12T17:00:00Z\">\n\n            <project id=\"PROJ-004\" name=\"Supply Chain Digitization\">\n                <type>Strategic Initiative</type>\n                <goal>Reduce supply chain OpEx by 15% in FY2026 through full digitization of vendor management and logistics.</goal>\n                <status>Off Track</status>\n                <owner>Jane Doe</owner>\n                <timeline>\n                    <start_date>2025-04-01</start_date>\n                    <original_end_date>2025-12-15</original_end_date>\n                    <projected_end_date>2025-12-29</projected_end_date>\n                </timeline>\n                <slippage_weeks>2</slippage_weeks>\n                <status_history>\n                    <entry date=\"2025-09-12\" status=\"Off Track\" />\n                    <entry date=\"2025-09-05\" status=\"At Risk\" />\n                    <entry date=\"2025-08-29\" status=\"On Track\" />\n                    <entry date=\"2025-08-15\" status=\"On Track\" />\n                    <entry date=\"2025-08-01\" status=\"Blocked\" />\n                    <entry date=\"2025-07-25\" status=\"On Track\" />\n                    <entry date=\"2025-07-11\" status=\"On Track\" />\n                </status_history>\n                <recent_updates>\n                    <update date=\"2025-09-12\">\n                        <author>Jane Doe</author>\n                        <text>Status moved to 'Off Track'. The integration module with our new logistics partner (FleetLink) is delayed. Their sandbox environment is unstable, blocking our development. This has a cascading impact on the UAT phase. Projected slip of 2 weeks.</text>\n                        <source>Weekly Project Sync Email</source>\n                    </update>\n                    <update date=\"2025-09-05\">\n                         <author>John Smith</author>\n                         <text>Status moved to 'At Risk'. Vendor API documentation is incomplete, and we've discovered authentication requirements that were not previously scoped. Raised JIRA-22451 to track investigation.</text>\n                         <source>JIRA-22451</source>\n                    </update>\n                    <update date=\"2025-08-04\">\n                        <author>Jane Doe</author>\n                        <text>Blocker resolved. Legal has approved the revised data sharing agreement with FleetLink. Development can now resume on the integration module.</text>\n                        <source>Legal Department Email</source>\n                    </update>\n                </recent_updates>\n                <related_bugs>\n                    <bug id=\"JIRA-22451\" status=\"Open\" priority=\"P2 - High\">Investigate new authentication requirements for FleetLink API</bug>\n                </related_bugs>\n            </project>\n\n            <project id=\"PROJ-002\" name=\"Project Atlas: AI Analytics Engine v3\">\n                 <type>Platform Enhancement</type>\n                 <goal>Release the next generation AI analytics engine to support new product features for Q1 2026 launch.</goal>\n                 <status>At Risk</status>\n                 <owner>Peter Jones</owner>\n                 <timeline>\n                    <start_date>2025-07-15</start_date>\n                    <original_end_date>2025-11-20</original_end_date>\n                    <projected_end_date>2025-11-27</projected_end_date>\n                 </timeline>\n                 <slippage_weeks>1</slippage_weeks>\n                 <status_history>\n                    <entry date=\"2025-09-10\" status=\"At Risk\" />\n                    <entry date=\"2025-09-03\" status=\"On Track\" />\n                    <entry date=\"2025-08-27\" status=\"On Track\" />\n                    <entry date=\"2025-08-20\" status=\"On Track\" />\n                    <entry date=\"2025-08-13\" status=\"At Risk\" />\n                    <entry date=\"2025-08-06\" status=\"On Track\" />\n                    <entry date=\"2025-07-30\" status=\"On Track\" />\n                 </status_history>\n                 <recent_updates>\n                    <update date=\"2025-09-10\">\n                        <author>Peter Jones</author>\n                        <text>Project has slipped by 1 week. Unexpected complexity in migrating the data model for multi-tenancy support (JIRA-22415). The engineering lead for that component was also on unplanned leave for 3 days. We believe we can absorb this delay without impacting the final Q1 product launch if no further issues arise.</text>\n                        <source>Email from Peter Jones to Stakeholders; JIRA-22415</source>\n                    </update>\n                 </recent_updates>\n                 <related_bugs>\n                    <bug id=\"JIRA-22415\" status=\"In Progress\" priority=\"P1 - Critical\">Performance degradation when migrating multi-tenant data models</bug>\n                    <bug id=\"JIRA-23011\" status=\"Open\" priority=\"P2 - High\">Query results are inconsistent when using new caching layer</bug>\n                    <bug id=\"JIRA-23015\" status=\"Backlog\" priority=\"P3 - Medium\">UI rendering issue on the model training dashboard in Safari</bug>\n                    <bug id=\"JIRA-22899\" status=\"Closed\" priority=\"P2 - High\">API endpoint for model versioning returns 500 error under heavy load</bug>\n                 </related_bugs>\n            </project>\n\n            <project id=\"PROJ-001\" name=\"European Market Expansion (Phase 1)\">\n                <type>Strategic Initiative</type>\n                <goal>Establish legal entity and launch localized marketing site for Germany and France to capture 5% of TAM within 18 months.</goal>\n                <status>On Track</status>\n                <owner>Anika Sharma</owner>\n                <timeline>\n                    <start_date>2025-06-01</start_date>\n                    <original_end_date>2025-11-01</original_end_date>\n                    <projected_end_date>2025-11-01</projected_end_date>\n                </timeline>\n                <slippage_weeks>0</slippage_weeks>\n                <status_history>\n                    <entry date=\"2025-09-08\" status=\"On Track\" />\n                    <entry date=\"2025-08-25\" status=\"On Track\" />\n                    <entry date=\"2025-08-11\" status=\"On Track\" />\n                    <entry date=\"2025-07-28\" status=\"On Track\" />\n                    <entry date=\"2025-07-14\" status=\"On Track\" />\n                    <entry date=\"2025-06-30\" status=\"On Track\" />\n                    <entry date=\"2025-06-16\" status=\"On Track\" />\n                    <entry date=\"2025-06-02\" status=\"On Track\" />\n                </status_history>\n                <recent_updates>\n                    <update date=\"2025-09-08\">\n                        <author>Anika Sharma</author>\n                        <text>German legal entity paperwork has been filed and is awaiting government approval. French translation for the marketing site is complete and under review by regional stakeholders. We are slightly ahead of schedule on the legal workstream.</text>\n                        <source>Bi-weekly Steering Committee Meeting Minutes</source>\n                    </update>\n                </recent_updates>\n                <related_bugs />\n            </project>\n\n            <project id=\"PROJ-003\" name=\"Customer Portal SSO Integration\">\n                <type>Customer Commitment</type>\n                <goal>Deliver single sign-on (SSO) capability for Zenith Enterprises' customer portal as per Q3 contract agreement.</goal>\n                <status>On Track</status>\n                <owner>Susan Chen</owner>\n                <timeline>\n                    <start_date>2025-08-01</start_date>\n                    <original_end_date>2025-10-15</original_end_date>\n                    <projected_end_date>2025-10-15</projected_end_date>\n                </timeline>\n                <slippage_weeks>0</slippage_weeks>\n                <status_history>\n                     <entry date=\"2025-09-11\" status=\"On Track\" />\n                     <entry date=\"2025-09-04\" status=\"On Track\" />\n                     <entry date=\"2025-08-28\" status=\"On Track\" />\n                     <entry date=\"2025-08-21\" status=\"On Track\" />\n                     <entry date=\"2025-08-14\" status=\"On Track\" />\n                     <entry date=\"2025-08-07\" status=\"On Track\" />\n                </status_history>\n                <recent_updates>\n                    <update date=\"2025-09-11\">\n                        <author>Susan Chen</author>\n                        <text>Development complete and deployed to staging environment. Handed off to Zenith's IT team for User Acceptance Testing (UAT). All milestones are currently green.</text>\n                        <source>Project Standup Notes</source>\n                    </update>\n                </recent_updates>\n                <related_bugs />\n            </project>\n\n        </project_portfolio>\n\n    </knowledge>\n\n    # Must follow instructions when replying\n\n    ** IMPORTANT ** You must use the following guidelines when constructing any reply:\n\n    \n    3. When answering questions that are not specific, assume they are asking about projects shown either in chat history or in an informationDisplay\n    \n    6. You do not support followUpActions and should never return any\n    7. Do not offer follow up questions, you must answer questions as brief as possible\n\n</advisor>`;\n\nreturn data;"
          },
          "outcomes": {
            "success": "1763414858609"
          },
          "code": "PREPAREDATA",
