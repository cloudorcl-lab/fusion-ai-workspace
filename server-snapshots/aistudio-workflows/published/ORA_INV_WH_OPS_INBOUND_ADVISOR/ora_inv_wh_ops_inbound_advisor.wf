            "name": "Organization Chooser Output Parser",
            "returnType": "object",
            "sourceCode": "let payload = $context.$nodes.INVOKE_ORGANIZATION_CHOOSER_WORKFLOW.$output.output;\n\n\n\nif (typeof payload === \"string\") {\n  payload = JSON.parse(payload );\n}\n\npayload.organizationId= payload.OrganizationId;\npayload.organizationCode= payload.OrganizationCode;\npayload.organizationName= payload.OrganizationName;\n\nreturn payload;"
