            "sourceCode": "let organizationId = Number(\n  $context.$nodes.ORGANIZATION_CHOOSER_OUTPUT_PARSER.$output.result.OrganizationId\n);\n\nlet payload = {\n  \"size\": 0,\n  \"query\": {\n    \"bool\": {\n      \"filter\": [\n        {\n          \"term\": {\n            \"ToOrganizationId\": organizationId\n          }\n        }\n      ]\n    }\n  },\n  \"aggs\": {\n    \"total_records\": {\n      \"value_count\": {\n        \"field\": \"_id\"\n      }\n    }\n  }\n};\n\nlet retPayload = {};\n\nretPayload.searchAggregationsPayload = payload;\n\nreturn retPayload;"
          },
