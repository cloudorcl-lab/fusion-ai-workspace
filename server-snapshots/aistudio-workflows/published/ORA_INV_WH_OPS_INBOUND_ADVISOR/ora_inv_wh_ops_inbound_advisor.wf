            "returnType": "object",
            "sourceCode": "let input = $context.$app.$OraAction;\n\nif(!input){\n    input = $context.$triggers.REST.$input.OraAction; \n}\n\n// Parse the input only if it's a string (assumed to be JSON text)\nif (typeof input === \"string\") {\n  input = JSON.parse(input);\n}\n\nreturn input;"
