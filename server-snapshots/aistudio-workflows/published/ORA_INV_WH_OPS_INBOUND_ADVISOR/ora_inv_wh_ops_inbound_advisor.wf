        {
          "metadata": {
            "name": "Resolve App Context",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  let resolvedApp = undefined; \n\n  if ($context.$app?.$OraMessageHint) {\n    resolvedApp = $context.$app;\n  } else {\n    resolvedApp = $context.$triggers?.REST?.$input?.app;\n  }\n\n  if (resolvedApp && typeof resolvedApp === 'object') {\n    // Create a new object to hold duplicated attributes with string values or original objects\n    const duplicatedAttributes = {};\n    for (const key of Object.keys(resolvedApp)) {\n      let value = resolvedApp[key];\n\n      // If value is null or undefined, default to empty string\n      if (value === null || value === undefined) {\n        value = \"\";\n      } else if (typeof value !== 'string') {\n        try {\n          // Try to stringify JSON objects or other types\n          value = JSON.stringify(value);\n        } catch (e) {\n          // If stringify fails, fallback to empty string\n          value = \"\";\n        }\n      }\n\n      duplicatedAttributes[key] = value;\n\n      // Check if the attribute name starts with '$'\n      if (key.startsWith('$')) {\n        // If attribute without '$' does not exist, duplicate\n        const plainKey = key.substring(1);\n        if (!(plainKey in resolvedApp)) {\n          duplicatedAttributes[plainKey] = value;\n        }\n      } else {\n        // If attribute with '$' prefix does not exist, duplicate\n        const dollarKey = '$' + key;\n        if (!(dollarKey in resolvedApp)) {\n          duplicatedAttributes[dollarKey] = value;\n        }\n      }\n    }\n    result = duplicatedAttributes;\n  } else {\n    // If resolvedApp is null or not an object, return empty object\n    result = {};\n  }\n} catch (error) {\n  result = {};\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1770960448515"
          },
          "code": "RESOLVE_APP_CONTEXT",
          "id": "1777356683798",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
