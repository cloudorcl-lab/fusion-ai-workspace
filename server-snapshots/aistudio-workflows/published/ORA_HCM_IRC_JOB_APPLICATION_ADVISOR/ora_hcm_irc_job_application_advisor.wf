                {
                  "metadata": {
                    "name": "ProgessHistory With SubmissionId",
                    "returnType": "object",
                    "sourceCode": "const stalledJobApplications = $context.$variables.StalledJobApplications;\nconst submissionId = $context.$nodes.FETCH_STALLED_DATA_FOR_TOP_JOB_APPLICATIONS.$currentItem.submissionId;\nconst progressHistory = $context.$nodes.FETCH_PROGRESS_HISTORY_FOR_THE_JOB_APPLICATION.$output;\n\nlet submissionObjIndex = stalledJobApplications.findIndex(sub => sub.submissionId == submissionId);\nif (submissionObjIndex === -1) {\n    throw new Error('Submission not found');\n}\n\nlet submissionObj = stalledJobApplications[submissionObjIndex];\nconst currentPhaseEventName = submissionObj.phaseName;\n\n// Calculate total phase count (default to 0 if not present)\nconst phasesCount =\n    progressHistory &&\n    Array.isArray(progressHistory.items)\n        ? progressHistory.items.filter(\n              phase => phase.stateEvents && Array.isArray(phase.stateEvents.items) && phase.stateEvents.items.length > 0\n          ).length\n        : 0;\n\n\nlet stalledInfo = {\n    currentPhaseName: null,\n    phaseDuration: null,\n    currentState: null,\n    lastUpdatedBy: null,\n    lastEventDate: null,\n    isStalled: false,\n    submissionId:submissionId,\n    phasesCount: phasesCount\n};\n// Find the current phase in history using PhaseEventName\nlet matchingPhase = progressHistory.items.find(phase => phase.PhaseEventName === currentPhaseEventName);\n\nif (matchingPhase && matchingPhase.PhaseDurationForDisplay !== null) {\n    stalledInfo.currentPhaseName = matchingPhase.PhaseEventName;\n    stalledInfo.phaseDuration = matchingPhase.PhaseDurationForDisplay;\n    if (matchingPhase.stateEvents.items.length > 0) {\n        let state = matchingPhase.stateEvents.items[0];\n        stalledInfo.currentState = state.StateEventName;\n        stalledInfo.lastUpdatedBy = state.UpdatedBy;\n        stalledInfo.lastEventDate = state.EventDate;\n    }\n    if (stalledInfo.phaseDuration.includes(\"day\") || stalledInfo.phaseDuration.includes(\"month\")) {\n        stalledInfo.isStalled = true;\n    }\n}\n\nreturn stalledInfo;"
                  },
                  "outcomes": {
                    "success": "end_1769079451319"
                  },
                  "code": "PROGESSHISTORY_WITH_SUBMISSIONID",
