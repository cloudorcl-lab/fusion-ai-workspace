        {
          "metadata": {
            "name": "Update Top variables"
          },
          "outcomes": {
            "success": "1769425968863"
          },
          "code": "UPDATE_TOP_VARIABLES",
          "id": "1769507159104",
          "inputs": [
            {
              "id": "1769507177933",
              "name": "TopJobApplications",
              "scope": "JOB",
              "type": "array",
              "value": "{{$context.$nodes.REMOVE_TOP_JOB_APPLICATIONS_UPDATED_IN_1_DAY.$output.result}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Remove Top Job Applications Updated in 1 Day",
            "returnType": "array",
            "sourceCode": "const stalledJobApplications =  $context.$variables.StalledJobApplications;\n\nconst now = new Date();\nconst msIn24Hours = 24 * 60 * 60 * 1000;\n\nconst filtered = stalledJobApplications.filter(function(item) {\n    if (!item.stalledInfo) return false;\n\n   if (item.stalledInfo.phasesCount === 1) {\n      return true;\n   }\n\n    // PHASE DURATION FILTER\n    var pd = item.stalledInfo.phaseDuration;\n    if (typeof pd === \"string\") {\n        var normPd = pd.trim().toLowerCase();\n        // Exclude \"a day\", \"1 day\", \"0 days\"\n        if (normPd.startsWith('a day') || normPd.startsWith('1 day') || normPd.startsWith('0 day')) {\n            return false;\n        }\n        // Exclude if duration mentions 'hour'\n        if (normPd.indexOf('hour') >= 0) {\n            return false;\n        }\n    }\n\n    // LAST EVENT DATE FILTER\n    var led = item.stalledInfo.lastEventDate;\n    if (typeof led === \"string\" && led.length > 0) {\n        // Remove timezone for universal parsing\n        var cleanLed = led.replace(/( PST| EST| CST| MST| UTC| GMT| [A-Z]{1,4})$/i, \"\");\n        // Ensure valid parsing, add GMT if needed\n        if (cleanLed.match(/^\\d{1,2}\\/\\d{1,2}\\/\\d{2,4} \\d{1,2}:\\d{2} (AM|PM)$/i)) {\n            cleanLed += \" GMT-0000\";\n        }\n        var ledDate = Date.parse(cleanLed);\n        if (!isNaN(ledDate)) {\n            if (now.getTime() - ledDate <= msIn24Hours) {\n                return false;\n            }\n        }\n    }\n\n    return true;\n});\n\nreturn filtered.slice(0.10);"
          },
          "outcomes": {
            "success": "1769507159104"
          },
          "code": "REMOVE_TOP_JOB_APPLICATIONS_UPDATED_IN_1_DAY",
          "id": "1769507301434",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Top JA Minified",
            "returnType": "array",
            "sourceCode": "var response = $context.$nodes.REQUISITION_LOOP.$output;\nvar requisitionOutput = $context.$nodes.REQUISITION_DETAILS && $context.$nodes.REQUISITION_DETAILS.$output ? $context.$nodes.REQUISITION_DETAILS.$output : {};\nvar requisitionData = Array.isArray(requisitionOutput.items) ? requisitionOutput.items : [];\nvar parsedArray = typeof response === \"string\" ? JSON.parse(response) : response;\nvar jobApplications = [];\n\nif (!Array.isArray(parsedArray)) {\n    parsedArray = [];\n}\n\nfor (var i = 0; i < parsedArray.length; i++) {\n    var payloadStr = parsedArray[i];\n    var payload;\n    try {\n        payload = typeof payloadStr === \"string\" ? JSON.parse(payloadStr) : payloadStr;\n    } catch (e) {\n        continue;\n    }\n\n    if (payload && Array.isArray(payload.items)) {\n        for (var j = 0; j < payload.items.length; j++) {\n            var item = payload.items[j] || {};\n            var phaseName = item.currentPhase && item.currentPhase.phaseName ? String(item.currentPhase.phaseName).toLowerCase() : \"\";\n\n            if (phaseName === \"offer\") {\n                continue;\n            }\n\n            var requisition = {};\n            for (var r = 0; r < requisitionData.length; r++) {\n                if (String(requisitionData[r].requisitionId) === String(item.requisitionId)) {\n                    requisition = requisitionData[r];\n                    break;\n                }\n            }\n\n            var education = Array.isArray(item.jobApplicationEducation) && item.jobApplicationEducation.length > 0 ? item.jobApplicationEducation[0] : {};\n            var experience = Array.isArray(item.jobApplicationExperience) && item.jobApplicationExperience.length > 0 ? item.jobApplicationExperience[0] : {};\n            var language = null;\n            if (Array.isArray(item.jobApplicationLanguage) && item.jobApplicationLanguage.length > 0 && item.jobApplicationLanguage[0].languageContentItems) {\n                language = item.jobApplicationLanguage[0].languageContentItems.languageName || null;\n            }\n            var certification = null;\n            if (Array.isArray(item.jobApplicationCertification) && item.jobApplicationCertification.length > 0 && item.jobApplicationCertification[0].certificationContentItems) {\n                certification = item.jobApplicationCertification[0].certificationContentItems.certificationName || null;\n            }\n\n            var skills = [];\n            if (Array.isArray(item.jobApplicationSkills)) {\n                for (var s = 0; s < item.jobApplicationSkills.length; s++) {\n                    if (item.jobApplicationSkills[s] && item.jobApplicationSkills[s].skillFreeText) {\n                        skills.push(item.jobApplicationSkills[s].skillFreeText);\n                    }\n                }\n            }\n\n            var fndAttachments = Array.isArray(item._fndAttachments) ? item._fndAttachments : [];\n            var resumeAttachmentId = null;\n            var resumeDatatype = null;\n            var resumeFileName = null;\n            var fallbackAttachmentId = null;\n            var fallbackDatatype = null;\n            var fallbackFileName = null;\n\n            for (var a = 0; a < fndAttachments.length; a++) {\n                var attachment = fndAttachments[a] || {};\n                var datatype = attachment.DatatypeCode || attachment.datatypeCode || \"\";\n                datatype = String(datatype).toUpperCase();\n                var attachedDocumentId = attachment.AttachedDocumentId || attachment.attachedDocumentId || attachment.AttachmentDocumentId || attachment.attachmentDocumentId || \"\";\n                var candidateAttachmentId = attachedDocumentId;\n                var fileName = attachment.FileName || attachment.UploadedFileName || attachment.Title || attachment.title || \"\";\n                var fileNameLower = String(fileName).toLowerCase();\n                var categoryName = attachment.CategoryName || attachment.CategoryDisplayName || attachment.categoryName || attachment.categoryDisplayName || \"\";\n                var categoryLower = String(categoryName).toLowerCase();\n                var titleLower = String(attachment.Title || attachment.title || \"\").toLowerCase();\n                var fileSizeRaw = attachment.FileSize || attachment.UploadedFileLength || attachment.FileLength || \"0\";\n                var fileSize = parseInt(fileSizeRaw, 10);\n                if (isNaN(fileSize)) {\n                    fileSize = 0;\n                }\n\n                var isWebAttachment = datatype === \"WEB_PAGE\" || datatype === \"URL\" || fileNameLower.indexOf(\"http://\") === 0 || fileNameLower.indexOf(\"https://\") === 0;\n                var isProcessableFile = candidateAttachmentId !== \"\" && !isWebAttachment && (datatype === \"FILE\" || datatype === \"DOCUMENT\");\n                var looksLikeResume = categoryLower.indexOf(\"resume\") !== -1 || fileNameLower.indexOf(\"resume\") !== -1 || titleLower.indexOf(\"resume\") !== -1;\n\n                if (isProcessableFile && looksLikeResume) {\n                    resumeAttachmentId = candidateAttachmentId;\n                    resumeDatatype = datatype;\n                    resumeFileName = fileName;\n                    break;\n                }\n\n                if (isProcessableFile && fallbackAttachmentId === null) {\n                    fallbackAttachmentId = candidateAttachmentId;\n                    fallbackDatatype = datatype;\n                    fallbackFileName = fileName;\n                }\n            }\n\n            if (resumeAttachmentId === null && fallbackAttachmentId !== null) {\n                resumeAttachmentId = fallbackAttachmentId;\n                resumeDatatype = fallbackDatatype;\n                resumeFileName = fallbackFileName;\n            }\n\n            var candidateNumber = null;\n            if (Array.isArray(item.candidates) && item.candidates.length > 0) {\n                candidateNumber = item.candidates[0].candidateNumber || null;\n            }\n\n            var degree = null;\n            if (education.degreeContentItems) {\n                degree = education.degreeContentItems.degreeName || null;\n            }\n            var school = null;\n            if (education.schoolContentItems) {\n                school = education.schoolContentItems.schoolName || null;\n            }\n\n            var aiProfileScore = null;\n            var aiExperienceScore = null;\n            var aiEducationScore = null;\n            if (item.applicantScore) {\n                aiProfileScore = item.applicantScore.profileAiScore !== null && item.applicantScore.profileAiScore !== undefined ? item.applicantScore.profileAiScore : null;\n                aiExperienceScore = item.applicantScore.experienceAiScore !== null && item.applicantScore.experienceAiScore !== undefined ? item.applicantScore.experienceAiScore : null;\n                aiEducationScore = item.applicantScore.educationAiScore !== null && item.applicantScore.educationAiScore !== undefined ? item.applicantScore.educationAiScore : null;\n            }\n\n            var displayName = item.names && item.names.displayName ? item.names.displayName : null;\n            var lastName = item.names && item.names.lastName ? item.names.lastName : null;\n            var currentPhaseName = item.currentPhase && item.currentPhase.phaseName ? item.currentPhase.phaseName : null;\n            var currentStateName = item.currentState && item.currentState.stateName ? item.currentState.stateName : null;\n\n            jobApplications.push({\n                submissionId: item.submissionId,\n                requisitionId: item.requisitionId,\n                requisitionNumber: requisition.requisitionNumber || null,\n                requisitionTitle: requisition.title || null,\n                requisitionExternalPostingStartDate: requisition.externalPostingStartDate || null,\n                requisitionInternalPostingStartDate: requisition.internalPostingStartDate || null,\n                candidateNumber: candidateNumber,\n                displayName: displayName,\n                lastName: lastName,\n                jobTitle: experience.jobTitle || null,\n                employer: experience.employerName || null,\n                degree: degree,\n                school: school,\n                major: education.major || null,\n                certification: certification,\n                language: language,\n                skills: skills,\n                attachmentDocumentId: resumeAttachmentId,\n                attachmentDatatypeCode: resumeDatatype,\n                attachmentFileName: resumeFileName,\n                hasResumeAttachment: resumeAttachmentId !== null,\n                aiProfileScore: aiProfileScore,\n                aiExperienceScore: aiExperienceScore,\n                aiEducationScore: aiEducationScore,\n                submissionDate: item.submissionDate,\n                phaseName: currentPhaseName,\n                stateName: currentStateName\n            });\n        }\n    }\n}\n\nfor (var outer = 0; outer < jobApplications.length - 1; outer++) {\n    var maxIndex = outer;\n    for (var inner = outer + 1; inner < jobApplications.length; inner++) {\n        var currentScore = jobApplications[inner].aiProfileScore === null || jobApplications[inner].aiProfileScore === undefined ? -1 : Number(jobApplications[inner].aiProfileScore);\n        var maxScore = jobApplications[maxIndex].aiProfileScore === null || jobApplications[maxIndex].aiProfileScore === undefined ? -1 : Number(jobApplications[maxIndex].aiProfileScore);\n        if (currentScore > maxScore) {\n            maxIndex = inner;\n        }\n    }\n    if (maxIndex !== outer) {\n        var temp = jobApplications[outer];\n        jobApplications[outer] = jobApplications[maxIndex];\n        jobApplications[maxIndex] = temp;\n    }\n}\n\nreturn jobApplications.slice(0, 25);"
