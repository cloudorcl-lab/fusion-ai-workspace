            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Sort By Phase Duration",
            "returnType": "array",
            "sourceCode": "const input = $context.$variables.StalledJobApplications ;\n\nconst sorted = input.slice().sort((a, b) => {\n  // Inline logic to parse phaseDuration to total days\n  let aDuration = 0;\n  let bDuration = 0;\n\n  if (a.stalledInfo && typeof a.stalledInfo.phaseDuration === \"string\") {\n    var m = a.stalledInfo.phaseDuration.match(/(\\d+)\\s*month/);\n    if (m) aDuration += parseInt(m[1], 10) * 30;\n    var d = a.stalledInfo.phaseDuration.match(/(\\d+)\\s*day/);\n    if (d) aDuration += parseInt(d[1], 10);\n  }\n  if (b.stalledInfo && typeof b.stalledInfo.phaseDuration === \"string\") {\n    var m = b.stalledInfo.phaseDuration.match(/(\\d+)\\s*month/);\n    if (m) bDuration += parseInt(m[1], 10) * 30;\n    var d = b.stalledInfo.phaseDuration.match(/(\\d+)\\s*day/);\n    if (d) bDuration += parseInt(d[1], 10);\n  }\n\n  // First by phaseDuration\n  if (bDuration !== aDuration) return bDuration - aDuration;\n  // Then by submissionId desc (as a number)\n  return parseInt(b.submissionId, 10) - parseInt(a.submissionId, 10);\n});\n\n$context.$variables.StalledJobApplications = sorted;\n\n\nreturn sorted.slice(0, 2);"
          },
          "outcomes": {
            "success": "1769426081650"
          },
          "code": "SORT_BY_PHASE_DURATION",
          "id": "1769425968863",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
