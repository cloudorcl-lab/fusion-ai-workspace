            "name": "Top And Stalled Applications",
            "returnType": "object",
            "sourceCode": "var candidatesResponse = $context.$nodes.UPDATE_CANDIDATE_EMAIL.$output;\nvar topJobApplications = Array.isArray($context.$variables.TopJobApplications)\n    ? $context.$variables.TopJobApplications\n    : [];\nvar stalledJobApplications = Array.isArray($context.$variables.StalledJobApplications)\n    ? $context.$variables.StalledJobApplications\n    : [];\n\nvar result = {\n    topJobApplications: [],\n    stalledJobApplications: []\n};\n\nif (topJobApplications.length !== 0 || stalledJobApplications.length !== 0) {\n    var candidateArray = typeof candidatesResponse === \"string\" ? JSON.parse(candidatesResponse) : candidatesResponse;\n    var candidateInfoMap = {};\n\n    // Build a lookup map by CandidateNumber for fast matching.\n    for (var i = 0; i < candidateArray.length; i++) {\n        var candidateObj;\n        try {\n            candidateObj = JSON.parse(candidateArray[i]);\n        } catch (e) {\n            continue;\n        }\n        if (candidateObj.CandidateNumber) {\n            candidateInfoMap[candidateObj.CandidateNumber] = candidateObj;\n        }\n    }\n\n    for (var j = 0; j < stalledJobApplications.length; j++) {\n        var jobApp = stalledJobApplications[j];\n        var candidateNumber = jobApp.candidateNumber || jobApp.CandidateNumber;\n        if (candidateNumber && candidateInfoMap[candidateNumber]) {\n            jobApp.Email = candidateInfoMap[candidateNumber].Email;\n        }\n    }\n\n    var stalledIds = [];\n    for (var k = 0; k < stalledJobApplications.length; k++) {\n        stalledIds.push(stalledJobApplications[k].submissionId);\n    }\n\n    var filteredTopJobs = [];\n    for (var m = 0; m < topJobApplications.length; m++) {\n        if (stalledIds.indexOf(topJobApplications[m].submissionId) === -1) {\n            filteredTopJobs.push(topJobApplications[m]);\n        }\n    }\n\n    result.topJobApplications = filteredTopJobs.slice(0, 3);\n    result.stalledJobApplications = stalledJobApplications;\n}\n\nreturn result;"
