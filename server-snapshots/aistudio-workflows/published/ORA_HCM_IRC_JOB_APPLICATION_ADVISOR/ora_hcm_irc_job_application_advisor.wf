            "sourceCode": "const response = $context.$nodes.REQUISITION_DETAILS.$output;\n const isEnabled=$context.$triggers.REST.$input.isEnabled ;\n\n// Filter items to only those with allowed requisitionIds and build result array\nlet results = (response.items || [])\n  .map(item => ({ requisitionId: String(item.requisitionId) }));\n\nreturn results.slice(0, 6);"
