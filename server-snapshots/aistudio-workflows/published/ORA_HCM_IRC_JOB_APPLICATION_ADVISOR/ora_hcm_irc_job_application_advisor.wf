          "code": "UPDATE_TOP_JOBAPPLICATIONS",
          "id": "1769079994739",
          "inputs": [
            {
              "id": "1769087004992",
              "name": "StalledJobApplications",
              "scope": "JOB",
              "type": "array",
              "value": "{{$context.$nodes.TOP_JA_MINIFIED.$output.result}}"
            },
            {
              "id": "1769080025569",
              "name": "TopJobApplications",
              "scope": "JOB",
