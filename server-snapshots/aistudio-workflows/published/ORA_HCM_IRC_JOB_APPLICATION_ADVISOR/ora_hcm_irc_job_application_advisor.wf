            "returnType": "array",
            "sourceCode": "const progressArray= $context.$nodes.FETCH_STALLED_DATA_FOR_TOP_JOB_APPLICATIONS.$output ;\nconst jobApplications= $context.$variables.StalledJobApplications\n\n// Step 1: Parse all the progress entries and build a lookup by submissionId\nvar progressLookup = {};\nfor (var i = 0; i < progressArray.length; i++) {\n    var rec;\n    try {\n        rec = JSON.parse(progressArray[i]);\n    } catch (e) {\n        continue;\n    }\n    // Defensive: some records may not have result\n    if (rec && rec.result && rec.result.submissionId) {\n        progressLookup[rec.result.submissionId] = rec.result;\n    }\n}\n\n// Step 2: Add progress to each job application using submissionId\nfor (var j = 0; j < jobApplications.length; j++) {\n    var jobApp = jobApplications[j];\n    var sid = jobApp.submissionId;\n    if (sid && progressLookup[sid]) {\n        jobApp.stalledInfo= progressLookup[sid];\n    }\n}\n\n// Output the enriched jobApplications array\njobApplications;"
