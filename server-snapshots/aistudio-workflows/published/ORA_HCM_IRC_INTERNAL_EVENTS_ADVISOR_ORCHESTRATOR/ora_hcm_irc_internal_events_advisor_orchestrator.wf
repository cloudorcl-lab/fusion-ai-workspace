        {
          "metadata": {
            "name": "GetActionDetails",
            "returnType": "array",
            "sourceCode": "var raw = $context.$triggers.REST.$input.OraAction;\nvar payload = {};\nif (raw && typeof raw === \"string\") {\n  try { payload = JSON.parse(raw); } catch (e) { payload = {}; }\n} else if (raw && typeof raw === \"object\") {\n  payload = raw;\n}\nif (payload && payload.payload && typeof payload.payload === \"object\") {\n  var nested = payload.payload;\n  for (var key in nested) {\n    if (nested.hasOwnProperty(key) && payload[key] == null) {\n      payload[key] = nested[key];\n    }\n  }\n}\nvar action = \"\";\nif (payload && payload.actionCode != null) { action = String(payload.actionCode); }\nelse if (payload && payload.ActionCode != null) { action = String(payload.ActionCode); }\nelse if (payload && payload.code != null) { action = String(payload.code); }\nvar upper = action.toUpperCase();\nif (upper === \"REGISTER\" || upper === \"REGISTERFOREVENT\") { action = \"REGISTERFOREVENT\"; }\nelse if (upper === \"VIEWEVENTDETAILS\" || upper === \"VIEWDETAILS\") { action = \"viewEventDetails\"; }\nelse if (upper === \"MARKFAV\" || upper === \"MARKFAVORITE\" || upper === \"MARKFAVOURITE\") { action = \"MARKFAV\"; }\nelse if (upper === \"APPLY\") { action = \"APPLY\"; }\nelse if (action) { action = upper; }\nreturn [action, payload];"
          },
          "outcomes": {
            "success": "1767769692026"
          },
          "code": "GETACTIONDETAILS",
          "id": "1767769610546",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
