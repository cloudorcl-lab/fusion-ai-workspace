            {
              "id": "1765225186557_1",
              "name": "prompt",
              "type": "string",
              "value": "Following output contains list of events that have been suggested based on the employee profile and skill gaps that may be of interest/useful to the employee. Generate a brief summary explaining about why events were suggested and how they could be useful to the employee based on their skill profile and skill gaps\n\nDo not show any additional thinking/explanation. Only display a summary of max two to three sentences.\n\n {{$context.$nodes.FINDMATCHINGEVENTS.$output.output}}"
            }
