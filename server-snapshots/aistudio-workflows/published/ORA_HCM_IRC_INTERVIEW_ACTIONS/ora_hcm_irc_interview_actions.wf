          "id": "1765824653166",
          "inputs": [
            {
              "id": "1765824707367_1",
              "name": "schedule_Id",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.oraAction.scheduleId}}"
            },
            {
              "id": "1765824707368_2",
              "name": "InterviewSchedule_Id",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.oraAction.scheduleInterviewId}}"
            }
          ],
          "outputSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"ScheduleInterviewId\": {\n      \"type\": \"string\",\n      \"description\": \"ID of the interview schedule\"\n    },\n    \"ScheduleId\": {\n      \"type\": \"string\",\n      \"description\": \"ID of the schedule\"\n    },\n    \"ScheduleLocationId\": {\n      \"type\": \"string\",\n      \"description\": \"ID of the schedule location\"\n    },\n    \"StartDate\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"Start date and time of the interview\"\n    },\n    \"EndDate\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"End date and time of the interview\"\n    },\n    \"InterviewMeetingProvider\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Provider for the interview meeting (null if not specified)\"\n    },\n    \"IsCompleted\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Interview completion status (null if not specified)\"\n    },\n    \"IsScheduled\": {\n      \"type\": \"string\",\n      \"description\": \"Indicates whether the interview is scheduled\"\n    },\n    \"LastReminderDate\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Date of the last reminder (null if not available)\"\n    },\n    \"MeetingHostType\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Type of meeting host (null if not available)\"\n    },\n    \"MeetingHostTypeName\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Name of the meeting host type (null if not available)\"\n    },\n    \"MeetingLinkURL\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Link to the meeting (null if not available)\"\n    },\n    \"TotalSeatsCount\": {\n      \"type\": \"integer\",\n      \"description\": \"Total number of seats for the interview\"\n    },\n    \"ZoomMeetingId\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Zoom meeting ID (null if not available)\"\n    },\n    \"InterviewResponseStatus\": {\n      \"type\": \"string\",\n      \"description\": \"Response status for the interview\"\n    },\n    \"InterviewResponseStatusName\": {\n      \"type\": \"string\",\n      \"description\": \"Name of the interview response status\"\n    },\n    \"MeetingHostDisplayName\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Display name of the meeting host (null if not available)\"\n    },\n    \"HasUnaccessibleCandidateFlag\": {\n      \"type\": \"boolean\",\n      \"description\": \"Flag indicating if the candidate is not accessible\"\n    },\n    \"InterviewTitle\": {\n      \"type\": \"string\",\n      \"description\": \"Title of the interview\"\n    },\n    \"interviewCandidates\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"items\": {\n          \"type\": \"array\",\n          \"description\": \"List of candidates for the interview\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"ScheduleInterviewId\": {\n                \"type\": \"string\",\n                \"description\": \"ID of the interview schedule for the candidate\"\n              },\n              \"ParticipantId\": {\n                \"type\": \"string\",\n                \"description\": \"ID of the candidate participant\"\n              },\n              \"PersonId\": {\n                \"type\": \"string\",\n                \"description\": \"ID of the candidate person\"\n              },\n              \"SubmissionId\": {\n                \"type\": \"string\",\n                \"description\": \"Submission ID of the candidate\"\n              },\n              \"RequisitionTitle\": {\n                \"type\": \"string\",\n                \"description\": \"Title of the requisition\"\n              },\n              \"RequisitionId\": {\n                \"type\": \"string\",\n                \"description\": \"Requisition ID\"\n              },\n              \"CandidateNumber\": {\n                \"type\": \"string\",\n                \"description\": \"Candidate number\"\n              },\n              \"RequisitionNumber\": {\n                \"type\": \"string\",\n                \"description\": \"Requisition number\"\n              },\n              \"DisplayName\": {\n                \"type\": \"string\",\n                \"description\": \"Display name of the candidate\"\n              },\n              \"FullName\": {\n                \"type\": \"string\",\n                \"description\": \"Full name of the candidate\"\n              },\n              \"IntrvwRequestsId\": {\n                \"type\": \"string\",\n                \"description\": \"Interview request ID\"\n              },\n              \"@context\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"key\": {\n                    \"type\": \"string\",\n                    \"description\": \"Context key\"\n                  }\n                }\n              }\n            },\n            \"required\": [\"ScheduleInterviewId\", \"ParticipantId\", \"PersonId\", \"SubmissionId\"]\n          }\n        }\n      }\n    },\n    \"interviewInterviewers\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"items\": {\n          \"type\": \"array\",\n          \"description\": \"List of interviewers for the interview\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"ParticipantId\": {\n                \"type\": \"string\",\n                \"description\": \"ID of the interviewer participant\"\n              },\n              \"ScheduleInterviewId\": {\n                \"type\": \"string\",\n                \"description\": \"ID of the interview schedule for the interviewer\"\n              },\n              \"PersonId\": {\n                \"type\": \"string\",\n                \"description\": \"ID of the interviewer person\"\n              },\n              \"InterviewerDisplayName\": {\n                \"type\": \"string\",\n                \"description\": \"Display name of the interviewer\"\n              },\n              \"InterviewerResponseStatus\": {\n                \"type\": \"string\",\n                \"description\": \"Response status for the interviewer\"\n              },\n              \"InterviewerResponseStatusName\": {\n                \"type\": \"string\",\n                \"description\": \"Name of the interviewer's response status\"\n              },\n              \"InterviewerResponseProposedStartDate\": {\n                \"type\": [\"string\", \"null\"],\n                \"description\": \"Proposed start date for the interviewer (null if not available)\"\n              },\n              \"InterviewerResponseProposedEndDate\": {\n                \"type\": [\"string\", \"null\"],\n                \"description\": \"Proposed end date for the interviewer (null if not available)\"\n              },\n              \"InterviewerAssignmentId\": {\n                \"type\": \"string\",\n                \"description\": \"ID of the interviewer's assignment\"\n              },\n              \"InterviewerAssignmentName\": {\n                \"type\": \"string\",\n                \"description\": \"Name of the interviewer's assignment\"\n              },\n              \"@context\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"key\": {\n                    \"type\": \"string\",\n                    \"description\": \"Context key\"\n                  }\n                }\n              }\n            },\n            \"required\": [\"ParticipantId\", \"ScheduleInterviewId\", \"PersonId\"]\n          }\n        }\n      }\n    },\n    \"interviewLocation\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"items\": {\n          \"type\": \"array\",\n          \"description\": \"List of locations for the interview\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"ScheduleLocationId\": {\n                \"type\": \"string\",\n                \"description\": \"ID of the schedule location\"\n              },\n              \"LocationType\": {\n                \"type\": \"string\",\n                \"description\": \"Type of location (e.g., Web Conference)\"\n              },\n              \"LocationTypeName\": {\n                \"type\": \"string\",\n                \"description\": \"Name of the location type\"\n              },\n              \"LocationId\": {\n                \"type\": [\"string\", \"null\"],\n                \"description\": \"ID of the location (null if not specified)\"\n              },\n              \"FormattedSingleLineAddress\": {\n                \"type\": [\"string\", \"null\"],\n                \"description\": \"Formatted address (if available)\"\n              },\n              \"FormattedMultiLineAddress\": {\n                \"type\": [\"string\", \"null\"],\n                \"description\": \"Formatted multi-line address (if available)\"\n              },\n              \"PhoneAreaCode\": {\n                \"type\": \"string\",\n                \"description\": \"Phone area code for the interview location\"\n              },\n              \"PhoneCountryCodeId\": {\n                \"type\": \"string\",\n                \"description\": \"Country code for the interview location\"\n              },\n              \"PhoneCountryCodeNumber\": {\n                \"type\": \"string\",\n                \"description\": \"Phone country code number for the interview location\"\n              },\n              \"PhoneNumber\": {\n                \"type\": \"string\",\n                \"description\": \"Phone number for the interview location\"\n              },\n              \"PhoneNumberExtension\": {\n                \"type\": [\"string\", \"null\"],\n                \"description\": \"Phone number extension (if available)\"\n              },\n              \"PhoneNumberPasscode\": {\n                \"type\": [\"string\", \"null\"],\n                \"description\": \"Passcode for phone access (if available)\"\n              },\n              \"FormattedPhoneNumber\": {\n                \"type\": \"string\",\n                \"description\": \"Formatted phone number\"\n              },\n              \"WebConferenceLink\": {\n                \"type\": [\"string\", \"null\"],\n                \"description\": \"Web conference link (if available)\"\n              },\n              \"TerritoryCode\": {\n                \"type\": \"string\",\n                \"description\": \"Territory code for the location\"\n              },\n              \"@context\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"key\": {\n                    \"type\": \"string\",\n                    \"description\": \"Context key\"\n                  }\n                }\n              }\n            },\n            \"required\": [\"ScheduleLocationId\", \"LocationType\", \"LocationTypeName\"]\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\"ScheduleInterviewId\", \"ScheduleId\", \"InterviewTitle\", \"interviewCandidates\", \"interviewInterviewers\", \"interviewLocation\"]\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Get Check Date",
            "returnType": "object",
            "sourceCode": "const now = new Date($context.$system.$currentDate);\n\nconst out = {\n    startDateTime: \"\",\n    endDateTime: \"\"\n};\n\n\n// Parse as Date\nconst startDate = new Date(now);\nconst endDate = new Date(now);\n\n// Add 2 days\nstartDate.setDate(startDate.getDate() + 2);\nendDate.setDate(endDate.getDate() + 16);\n\n// Return as ISO UTC strings (safe for BO input)\nout.startDateTime = startDate.toISOString();\nout.endDateTime = endDate.toISOString();\n\nreturn out;"
          },
          "outcomes": {
            "success": "1765824931224"
          },
          "code": "GET_CHECK_DATE",
          "convergenceTargetId": "1765481383079",
          "id": "1765824871215",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
