        {
          "metadata": {
            "name": "Get Current Time Sets in UTC",
            "returnType": "array",
            "sourceCode": "const interviewData = $context.$triggers.REST.$input.InterviewData.result;\n\n// Create a Set to store unique UTC start times as strings\nconst utcStartTimeSet = new Set();\n\n// Iterate through the interview data and add the utcStartTime to the Set as a string\ninterviewData.forEach(item => {\n  if (item.utcStartTime) {\n    const utcStartTimeString = String(item.utcStartTime);  // Explicitly convert to string\n    utcStartTimeSet.add(utcStartTimeString);  // Add the UTC start time as a string to the set\n  }\n});\n\n// Return the Set as an array and convert it to JSON\nreturn Array.from(utcStartTimeSet);"
          },
          "outcomes": {
            "success": "1765824653166"
          },
          "code": "GET_CURRENT_TIME_SETS_IN_UTC",
          "id": "1766517941969",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "get format new data",
            "returnType": "object",
            "sourceCode": "var hasAvailableSlotsOutput = $context.$nodes.GET_NUMBER_OF_AVAILABLE_SLOTS.$output;\nvar hasAvailableSlots = false;\nif (hasAvailableSlotsOutput === true || hasAvailableSlotsOutput === \"true\" || hasAvailableSlotsOutput === \"TRUE\") {\n  hasAvailableSlots = true;\n} else if (hasAvailableSlotsOutput && typeof hasAvailableSlotsOutput === \"object\") {\n  if (hasAvailableSlotsOutput.result === true || hasAvailableSlotsOutput.result === \"true\" || hasAvailableSlotsOutput.result === \"TRUE\") {\n    hasAvailableSlots = true;\n  }\n}\n\nvar saveOutput = null;\nvar timeOutput = null;\nif (hasAvailableSlots) {\n  saveOutput = $context.$nodes.SAVE_THE_INTERVIEW_WITH_FIRST_AVAILABLE_TIME.$output;\n  timeOutput = $context.$nodes.FIND_FIRST_SLOTS.$output;\n} else {\n  saveOutput = $context.$nodes.SAVE_THE_EDIT_INTERVIEW.$output;\n  timeOutput = $context.$nodes.GET_NEW_TIME.$output;\n}\n\nvar overallStatus = \"\";\nvar saveResult = saveOutput && saveOutput.result;\nif (saveResult && typeof saveResult === \"object\") {\n  overallStatus = saveResult.OverallStatus || saveResult.overallStatus || \"\";\n} else if (typeof saveResult === \"string\") {\n  try {\n    var parsedSaveResult = JSON.parse(saveResult);\n    overallStatus = parsedSaveResult.OverallStatus || parsedSaveResult.overallStatus || \"\";\n  } catch (e) {\n    overallStatus = \"\";\n  }\n}\n\nif (overallStatus !== \"SUCCESS\") {\n  return {\n    action: \"interview_reschedule_failed\",\n    status: \"failed\",\n    message: \"Cannot reschedule the interview.\",\n    overallStatus: overallStatus || \"\"\n  };\n}\n\nvar timeResult = {};\ntry {\n  if (timeOutput && typeof timeOutput === \"object\" && timeOutput.result != null) {\n    if (typeof timeOutput.result === \"string\") {\n      timeResult = JSON.parse(timeOutput.result);\n    } else {\n      timeResult = timeOutput.result;\n    }\n  } else if (timeOutput) {\n    timeResult = timeOutput;\n  }\n} catch (e2) {\n  timeResult = {};\n}\n\nvar updatedStart = timeResult.startDateTime || timeResult.StartDateTime || \"\";\nvar updatedEnd = timeResult.endDateTime || timeResult.EndDateTime || \"\";\nvar interviewDetailsOutput = $context.$nodes.GET_CURRENT_INTERVIEW_DETAILS.$output;\nvar interviewDetails = interviewDetailsOutput && interviewDetailsOutput.result ? interviewDetailsOutput.result : interviewDetailsOutput;\nif (!interviewDetails || typeof interviewDetails !== \"object\") {\n  interviewDetails = {};\n}\n\nvar candidateName = \"\";\nif (interviewDetails.interviewCandidates && interviewDetails.interviewCandidates.items && interviewDetails.interviewCandidates.items[0]) {\n  candidateName = interviewDetails.interviewCandidates.items[0].FullName || \"\";\n}\n\nvar interviewerName = \"\";\nif (interviewDetails.interviewInterviewers && interviewDetails.interviewInterviewers.items && interviewDetails.interviewInterviewers.items[0]) {\n  interviewerName = interviewDetails.interviewInterviewers.items[0].InterviewerDisplayName || \"\";\n}\n\nvar locationType = \"\";\nvar locationDetails = null;\nif (interviewDetails.interviewLocation && interviewDetails.interviewLocation.items && interviewDetails.interviewLocation.items[0]) {\n  locationType = interviewDetails.interviewLocation.items[0].LocationType || \"\";\n  locationDetails =\n  interviewDetails.interviewLocation.items[0].WebConferenceLink ||\n  interviewDetails.interviewLocation.items[0].FormattedSingleLineAddress ||\n  null;\n}\n\nreturn {\n  action: \"interview_rescheduled\",\n  status: \"success\",\n  interviewTitle: interviewDetails.InterviewTitle || \"\",\n  candidateName: candidateName,\n  interviewerName: interviewerName,\n  updatedStartTimeUtc: updatedStart,\n  updatedEndTimeUtc: updatedEnd,\n  locationType: locationType,\n  locationDetails: locationDetails,\n  sourceTimezone: \"UTC\"\n};"
          },
          "outcomes": {
            "success": "end"
          },
