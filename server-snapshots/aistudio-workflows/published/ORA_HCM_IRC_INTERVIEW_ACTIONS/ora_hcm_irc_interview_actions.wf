          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"string\",\n      \"description\": \"A JSON string containing availability details such as availableFreeSlotsCount, nonCalendarUsersCount, and slotwiseAvailability.\"\n    }\n  },\n  \"required\": [\"result\"],\n  \"additionalProperties\": false\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "get number of  available slots",
            "returnType": "boolean",
            "sourceCode": "const raw = $context.$nodes.FETCH_AVAILABILITY.$output.result;\nconst data = JSON.parse(raw);\nreturn  data.availableFreeSlotsCount > 0;"
          },
          "outcomes": {
            "success": "1765830080209"
          },
          "code": "GET_NUMBER_OF_AVAILABLE_SLOTS",
          "convergenceTargetId": "1765481383079",
          "id": "1765836414716",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Check available slots"
          },
          "outcomes": {
            "true": "1765838696093",
            "false": "1765830485327"
          },
          "code": "CHECK_AVAILABLE_SLOTS",
          "convergenceTargetId": "end",
          "id": "1765830080209",
          "inputs": [
            {
              "id": "1765830080210_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.GET_NUMBER_OF_AVAILABLE_SLOTS.$output.result}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Find First Slots",
            "returnType": "array",
            "sourceCode": "const raw = $context.$nodes.FETCH_AVAILABILITY.$output.result;\nconst startTimesUTC = $context.$nodes.GET_CURRENT_TIME_SETS_IN_UTC.$output.result || [];\n\nconst startTimesUTCSet = new Set(startTimesUTC);\n\n// Always return an object with these fields\nconst out = {\n    startDateTime: \"\",\n    endDateTime: \"\"\n};\n\nif (!raw) return out;\n\nlet data;\ntry {\n    data = JSON.parse(raw);\n} catch (e) {\n    return out;\n}\n\nconst slots = data.slotwiseAvailability || [];\n\nfor (const slot of slots) {\n    const isFree = slot.interviewerStatuses?.some(\n        s => s.availabilityStatus === \"free\"\n    );\n    if (!isFree) continue;\n\n    const startDateTime = slot.startDateTime;\n    const endDateTime = slot.endDateTime;\n\n    // Must have both times\n    if (!startDateTime || !endDateTime) continue;\n\n    // Exclude overlapping by start time (your current rule)\n    if (startTimesUTCSet.has(startDateTime)) continue;\n\n    // Found first usable slot\n    out.startDateTime = startDateTime;\n    out.endDateTime = endDateTime;\n    return out;\n}\n\n// none found\nreturn out;"
          },
          "outcomes": {
            "success": "1765903712316"
          },
          "code": "FIND_FIRST_SLOTS",
          "id": "1765838696093",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
