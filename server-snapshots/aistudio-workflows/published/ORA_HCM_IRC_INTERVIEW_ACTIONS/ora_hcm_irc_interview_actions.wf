          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"OverallMessage\": {\n          \"type\": \"string\"\n        },\n        \"OverallStatus\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"OverallMessage\",\n        \"OverallStatus\"\n      ]\n    }\n  },\n  \"required\": [\"result\"]\n}",
          "type": "BO_FUNCTION"
