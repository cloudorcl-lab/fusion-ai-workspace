        {
          "metadata": {
            "name": "get new time",
            "returnType": "object",
            "sourceCode": "const start = $context.$nodes.GET_CURRENT_INTERVIEW_DETAILS.$output.StartDate;\nconst end = $context.$nodes.GET_CURRENT_INTERVIEW_DETAILS.$output.EndDate;\n\n// Always return a stable object\nconst out = {\n    startDateTime: \"\",\n    endDateTime: \"\"\n};\n\nif (!start || !end) return out;\n\n// Parse as Date\nconst startDate = new Date(start);\nconst endDate = new Date(end);\n\n// Add 2 days\nstartDate.setDate(startDate.getDate() + 2);\nendDate.setDate(endDate.getDate() + 2);\n\n// Return as ISO UTC strings (safe for BO input)\nout.startDateTime = startDate.toISOString();\nout.endDateTime = endDate.toISOString();\n\nreturn out;"
          },
          "outcomes": {
            "success": "1765830726767"
          },
          "code": "GET_NEW_TIME",
