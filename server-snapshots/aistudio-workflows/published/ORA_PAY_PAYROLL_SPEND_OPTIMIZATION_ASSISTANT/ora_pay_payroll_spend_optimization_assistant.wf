{
  "workflowId": "300000331058806",
  "workflowCode": "ORA_PAY_PAYROLL_SPEND_OPTIMIZATION_ASSISTANT",
  "name": "Payroll Spend Optimization Assistant",
  "description": "The Payroll Spend Optimization Assistant delivers a unified, guided experience that helps People Leaders, HRBPs, Finance users, and HR Analytics teams monitor, diagnose, forecast, and optimize payroll spend. It explains what is changing and why, projects future payroll exposure, recommends corrective actions, and enables controlled execution through Fusion deep links, while enforcing persona-based security and ensuring KPI integrity.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
