          "metadata": {
            "errorNodeId": "1774750918705",
            "name": "extractAvailableRatePlans",
            "returnType": "array",
            "sourceCode": "const calculatePriceResponse = $context.$nodes.FETCHAVAILABLERATEPLANS.$output || {};\nconst lineDetails = calculatePriceResponse?.lines && calculatePriceResponse?.lines[0];\n\nconst partNumber = $context?.$variables?.SubscriptionProduct?.ProductName || \"\";\n\nconst availableRatePlans = Array.isArray(lineDetails.availableRatePlans)\n    ? lineDetails.availableRatePlans\n    : [];\n\nconst lines = availableRatePlans.map((rp, idx) => ({\n      _partNumber: partNumber,\n      _requestedRatePlanNumber: rp.number,\n      _itemIdentifier: String(idx),\n      _quantity: $context?.$variables?.SubscriptionProduct?.Quantity\n}));\n\nconst result = {};\nresult.lines = lines;\n\nreturn result;"
          },
          "outcomes": {
            "success": "1774751118790"
          },
          "code": "EXTRACTAVAILABLERATEPLANS",
          "id": "1774750747396",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_RECORD"
              ],
              "enableActions": false,
              "enableCommunications": false
            }
