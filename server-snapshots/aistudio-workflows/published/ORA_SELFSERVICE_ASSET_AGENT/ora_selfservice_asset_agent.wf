        {
          "metadata": {
            "errorNodeId": "1774750918705",
            "name": "setUpdateTransactionLinePayload",
            "returnType": "object",
            "sourceCode": "const transactionLineToUpdate = {\n  \"transactionLine\": {\n    \"items\": [\n      {\n        \"_document_number\": $context.$nodes.INITIATEABOMODIFYACTION.$output.processedList[0].lineId,\n        \"_price_quantity\": $context.$triggers.REST.$input.actionPayload.quantity,\n       \"_requestedRatePlan\": $context.$nodes.EXTRACTPARAMETERSFROMFORMID.$output.result.ratePlanNumber,\n        \"contractStartDate_l\": $context.$triggers.REST.$input.actionPayload.effectiveDate,  \n        \"changeReason_l\": $context.$triggers.REST.$input.actionPayload.changeReason,\n        \"_s_lineActionComment_l\": $context.$triggers.REST.$input.actionPayload.comment\n      }\n    ]\n  }\n};\n\nconst criteria = {\n  \"fields\": [\"bs_id\", \"transactionID_t\"]\n};\n\nconst returnObject = {};\nreturnObject.transactionLineToUpdate = transactionLineToUpdate;\nreturnObject.criteria = criteria;\n\nreturn returnObject;"
          },
