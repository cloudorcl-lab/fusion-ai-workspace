            "sourceCode": "const criteria = {\n  state: true,\n  childDefs: [\n    {\n      name: \"transactionLine\",\n      queryDef: {\n        state: true,\n        expandedDomains: [\"_requestedRatePlan\"]\n      }\n    }\n  ]\n};\n\nreturn criteria;"
