          "code": "SUBSCRIPTIONPRODUCTNOTCORRECTSTATEFORMODIFICATION",
          "convergenceTargetId": "1774750445922",
          "id": "1774974369471",
          "inputs": [
            {
              "id": "1774974369473_1",
              "name": "returnValue",
              "type": "string",
              "value": "The subscription product cannot be modified at the moment. Please refresh and try again, or contact customer support."
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "errorNodeId": "1774750918705",
            "name": "extractChangeReasons",
            "returnType": "array",
            "sourceCode": "const changeReasons = $context.$nodes.GETCHANGEREASONS.$output.items;\nconst changeReasonItems = [];\nfor (let i=0; i<changeReasons.length; i++) {\n    const reasonValue = changeReasons[i]?.value;\n    // skip unwanted reasons\n     if (reasonValue === \"ORA_BREACH\" || reasonValue === \"ORA_NON_COMPLIANCE\")  {\n      continue;\n    }\n    changeReasonItems .push({\n           \"label\": changeReasons[i].displayValue,\n           \"value\": reasonValue\n     });\n}\n\nreturn changeReasonItems;"
          },
          "outcomes": {
            "success": "1774954063146"
          },
          "code": "EXTRACTCHANGEREASONS",
          "id": "1774751551635",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1774750918705",
            "name": "validateAssetModificationInputFields",
            "returnType": "object",
            "sourceCode": "let validationOutput = {};\n\n// Inputs (adjust paths as needed)\nconst endDateStr   = $context?.$nodes?.EXTRACTSUBSCRIPTIONPRODUCTATTRIBUTES?.$output?.result?.endDate;\nconst effectiveDateStr = $context?.$triggers?.REST?.$input?.actionPayload?.effectiveDate; \nconst quantityRaw = $context?.$triggers?.REST?.$input?.actionPayload?.quantity;\nconst changeReason = $context?.$triggers?.REST?.$input?.actionPayload?.changeReason;\n\n// Normalize timezone if it ends with +HHMM/-HHMM (e.g. +0000 -> +00:00). If already +HH:MM or ends with Z, it stays unchanged.\nconst endNorm = (typeof endDateStr === \"string\")\n  ? (/[+-]\\d{2}:\\d{2}$/.test(endDateStr) || /Z$/.test(endDateStr)\n      ? endDateStr\n      : endDateStr.replace(/([+-]\\d{2})(\\d{2})$/, \"$1:$2\"))\n  : null;\n\n// Parse dates\nconst endDate = endNorm ? new Date(endNorm) : null;\n\nconst today = new Date();\ntoday.setUTCHours(0, 0, 0, 0);\n\nconst tomorrow = new Date(today);\ntomorrow.setUTCDate(today.getUTCDate() + 1);\n\n\n// Treat effective date as UTC midnight to avoid locale ambiguity\nconst effDate = (typeof effectiveDateStr === \"string\" && effectiveDateStr)\n  ? new Date(`${effectiveDateStr}T00:00:00.000Z`)\n  : null;\n\nconst effOk = effDate instanceof Date && !Number.isNaN(effDate.getTime());\n\n\n// Inclusive range check: start <= effective <= end\nconst effectiveDateWithinRange =\n  effOk &&\n  effDate.getTime() >= tomorrow.getTime() &&\n  effDate.getTime() <= endDate.getTime();\n\n// Quantity validation\nconst qty = Number(quantityRaw);\nconst quantityIsNumber = Number.isFinite(qty);\nconst quantityValid = quantityIsNumber && qty > 0;\n\nconst changeReasonPresent = changeReason!== undefined && changeReason !== null && changeReason !== \"\";\n\n// Output\nvalidationOutput.effectiveDateWithinRange = effectiveDateWithinRange;\nvalidationOutput.quantityValid = quantityValid;\nvalidationOutput.changeReasonValid = changeReasonPresent;\nvalidationOutput.isValid = effectiveDateWithinRange && quantityValid && changeReasonPresent;\n\nreturn validationOutput;"
          },
          "outcomes": {
            "success": "1774795078056"
          },
          "code": "VALIDATEASSETMODIFICATIONINPUTFIELDS",
          "id": "1774794806256",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
