          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1774750918705",
            "name": "extractRatePlansData",
            "returnType": "object",
            "sourceCode": "let currentPlan;\nconst availableRatePlans =\n  $context?.$nodes?.CALCULATEPRICEFORAVAILABLEPLANS?.$output?.lines ?? [];\nconst currentRatePlanIntegrationId =\n  $context?.$variables?.SubscriptionProduct?.RequestedRatePlanId;\n\nif (!Array.isArray(availableRatePlans) || availableRatePlans.length === 0) {\n  currentPlan = null;\n} else if (\n  currentRatePlanIntegrationId === null ||\n  currentRatePlanIntegrationId === undefined ||\n  currentRatePlanIntegrationId === \"\"\n) {\n  currentPlan = availableRatePlans[0];\n} else {\n  const req = String(currentRatePlanIntegrationId);\n\n  // Find match; if not found, default to first line\n  currentPlan =\n    availableRatePlans.find(\n      (line) => String(line?.appliedRatePlanIntegrationId) === req\n    ) || availableRatePlans[0];\n}\n\nlet returnObject = {};\nreturnObject.availableRatePlans = availableRatePlans;\nreturnObject.currentPlan = currentPlan;\n\nreturn returnObject;"
          },
          "outcomes": {
            "success": "1774953809276"
          },
          "code": "EXTRACTRATEPLANSDATA",
          "id": "1774751257340",
          "inputs": [],
