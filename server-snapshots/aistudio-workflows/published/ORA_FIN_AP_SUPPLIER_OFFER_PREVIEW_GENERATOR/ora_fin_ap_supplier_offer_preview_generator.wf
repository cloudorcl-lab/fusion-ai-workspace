{
  "workflowId": "100002355226965",
  "workflowCode": "ORA_FIN_AP_SUPPLIER_OFFER_PREVIEW_GENERATOR",
  "name": "Supplier Offer Preview Generator",
  "description": "Supports end-user review of offers before confirmation is finalized.",
  "specification": {
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1767081549030"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "description": "End of data pipeline",
            "name": "End"
          },
          "outcomes": {},
          "code": "END",
          "id": "end",
          "inputs": [],
          "type": "END"
        },
        {
          "metadata": {
            "name": "Parse the Offers",
            "returnType": "object",
            "sourceCode": "// 1. Extract offers\nconst offers = $context.$triggers.REST.$input.offerResult.items \n\n// 2. Build currency list\nconst currencySet = new Set();\nfor (let i = 0; i < offers.length; i++) {\n    if (offers[i].currencyCode) {\n        currencySet.add(offers[i].currencyCode.toUpperCase());\n    }\n}\n\nconst currencyList = Array.from(currencySet).sort();\nconst isMultiCurrency = currencyList.length > 1 ? \"Yes\" : \"No\";\n\n// 3. Normalize user currency\nconst userCurrency = ( $context.$triggers.REST.$input.userProvidedCurrency) ? $context.$triggers.REST.$input.userProvidedCurrency.toUpperCase() : null;\n\n// 4. Logic variables\nlet selectedCurrency = null;\nlet requiresCurrencyDisambiguation = \"No\";\nlet finalOffers = offers;\n\n// 5. Multi-currency resolution\nif (isMultiCurrency === \"Yes\") {\n    if (userCurrency && currencyList.indexOf(userCurrency) !== -1) {\n        selectedCurrency = userCurrency;\n        const filtered = [];\n        for (let j = 0; j < offers.length; j++) {\n            if (offers[j].currencyCode && offers[j].currencyCode.toUpperCase() === userCurrency) {\n                filtered.push(offers[j]);\n            }\n        }\n        finalOffers = filtered;\n    } else {\n        requiresCurrencyDisambiguation = \"Yes\";\n    }\n} else if (currencyList.length === 1) {\n    selectedCurrency = currencyList[0];\n}\n\n// 6. Create the result object\nconst result = {\n    finalOffers: finalOffers,\n    currencyList: currencyList,\n    isMultiCurrency: isMultiCurrency,\n    selectedCurrency: selectedCurrency,\n    requiresCurrencyDisambiguation: requiresCurrencyDisambiguation\n};\n\n// 7. Return as a JSON String\nreturn result;"
          },
          "outcomes": {
            "success": "1767081755988"
          },
          "code": "FIN_AP_CODE_PARSE_OFFERS",
          "id": "1767081549030",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Check Multi Currency"
          },
          "outcomes": {
            "Yes": "1770657978184",
            "No": "1767081860443"
          },
          "code": "FIN_AP_SWITCH_CHECK_MULTI_CURRENCY",
          "convergenceTargetId": "end",
          "id": "1767081755988",
          "inputs": [
            {
              "id": "1767081755990_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$nodes.FIN_AP_CODE_PARSE_OFFERS.$output.result.requiresCurrencyDisambiguation}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
            "name": "Multi Currency Message"
          },
          "outcomes": {},
          "code": "FIN_AP_RETURN_MULTI_CURRENCY_MESSAGE",
          "convergenceTargetId": "end",
          "id": "1767081833856",
          "inputs": [
            {
              "id": "1767081833858_1",
              "name": "returnValue",
              "type": "string",
              "value": "{{$context.$nodes.FIN_AP_CODE_MULTI_CURRENCY_RESPONSE.$output.result}}"
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "name": "Check Offers Present"
          },
          "outcomes": {
            "True": "1767081941207",
            "False": "1770657999370"
          },
          "code": "FIN_AP_SWITCH_CHECK_OFFERS",
          "convergenceTargetId": "end",
          "id": "1767081860443",
          "inputs": [
            {
              "id": "1767081860444_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$nodes.FIN_AP_CODE_PARSE_OFFERS.$output.result.finalOffers.length >0}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.25
              },
              "code": "ORA_LLM_MODEL_PROVIDER_CERT_BASIC_LLAMA_3_3_70B",
              "model": "ORA_LLM_MODEL_GPT_OSS_120B",
              "modelName": "GPT OSS 120B (Basic)",
              "provider": "CERT_BASIC"
            },
            "name": "Generate Offer Preview"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "FIN_AP_LLM_GENERATE_OFFER_PREVIEW",
          "id": "1767081941207",
          "inputs": [
            {
              "id": "1767081941209_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a response formatter.\n\nUsing ONLY the offer data provided, generate a preview response in the exact JSON OBJECT format described below.\n\nData to be formatted:\n\n{{$context.$nodes.FIN_AP_CODE_PARSE_OFFERS.$output.result.finalOffers}}\n\nRules:\n- Do NOT modify or filter the offer data\n- Do NOT add explanations or commentary\n- Do NOT add or remove sections\n- Render a maximum of 10 offers\n- Use currency exactly as provided in the offer data\n- Do NOT include any text outside the JSON object\n- Populate the table content array using the provided offer data\n\nThe output MUST be a JSON object with the following structure:\n\n{\n  \"previewFlowResponse\": [\n    {\n      \"type\": \"text\",\n      \"content\": [\n        \"Here are the shortlisted offers. Please review the offer and choose how you would like to proceed.\"\n      ],\n      \"sequence\": 1,\n      \"formatHint\": \"Make Amount field BOLD\"\n    },\n    {\n      \"type\": \"table\",\n      \"heading\": \"Preview of Offers Matching Your Request\",\n      \"content\": [],\n      \"sequence\": 2,\n      \"formatHint\": \"\"\n    },\n    {\n      \"type\": \"actions\",\n      \"content\": [\n        \"Send selected offers\",\n        \"Discard selected offers\"\n      ],\n      \"sequence\": 3\n    }\n  ],\n  \"variable\": {\n    \"offerPreview\": \"Yes\" or \"No\"\n  }\n}\n\nPopulate the table content array using the provided offer data.\nEach table row must contain:\n- Supplier Name\n- Program Type\n- Currency\n- Offer Amount\n- Status\n\nDo NOT change action labels.\n\nofferPreview can have values \"Yes\", \"No\" based on data is present\n\nTable Content Mapping (Important):\n\nEach object inside table.content must follow this shape:\n\n{\n  \"Supplier Name\": \"<supplierName>\",\n  \"Program Type\": \"<financingOptionType>\",\n  \"Currency\": \"<currencyCode>\",\n  \"Outstanding Amount\": \"<totalUnpaidAmount>\",\n  \"Discount Rate\": \"<minDiscountRate>%\",\n  \"Discount Amount\": \"<totalDiscountAmount>\",\n  \"Offer Amount\": \"<totalNetPaymentAmount>\",\n  \"Status\": \"<offerStatus>\"\n}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://example.com/schemas/offer-preview-flow.schema.json\",\n  \"title\": \"Offer Preview Flow Specification\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"previewFlowResponse\", \"variable\"],\n  \"properties\": {\n    \"previewFlowResponse\": {\n      \"type\": \"array\",\n      \"description\": \"Array of UI response blocks (text/table/actions). Structure is not strictly validated here.\"\n    },\n    \"variable\": {\n      \"type\": \"object\",\n      \"additionalProperties\": true,\n      \"required\": [\"offerPreview\"],\n      \"properties\": {\n        \"offerPreview\": {\n          \"type\": \"string\",\n          \"enum\": [\"Yes\", \"No\"],\n          \"description\": \"Yes when shortlisted offer data is present; otherwise No.\"\n        }\n      }\n    }\n  }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "No Offers Present"
          },
          "outcomes": {},
          "code": "FIN_AP_RETURN_NO_MATCHING_OFFER_MESSAGE",
          "convergenceTargetId": "end",
          "id": "1767081968426",
          "inputs": [
            {
              "id": "1767081968427_1",
              "name": "returnValue",
              "type": "string",
              "value": "{\n  previewFlowResponse: [\n    {\n      type: \"text\",\n      content: [\n        \"No matching offers were found for the provided currency.\"\n      ],\n      sequence: 1\n    }\n  ],\n  variable: {{$context.$variables.offerPreview}} \n}"
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "name": "Set Offer Preview Status"
