              "value": "No"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Reset Offer Preview Variable"
          },
          "outcomes": {
            "success": "1767081968426"
          },
          "code": "FIN_AP_VARIABLE_RESET_OFFER_PREVIEW",
          "id": "1770657999370",
          "inputs": [
            {
              "id": "1770658016444",
              "name": "offerPreview",
              "scope": "JOB",
              "type": "string",
              "value": "No"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Generate Multi Currency Response",
            "returnType": "object",
            "sourceCode": "const jsonObject = {\n  previewFlowResponse: [\n    {\n      type: \"text\",\n      content: [\n        \"Multiple currencies were found in the shortlisted offers. Please specify the currency you’d like to proceed with.\"\n      ],\n      sequence: 1\n    }\n  ],\n  variable: {\n    offerPreview: 'No'\n  }\n};\n\nreturn jsonObject;"
          },
          "outcomes": {
            "success": "1767081833856"
          },
          "code": "FIN_AP_CODE_MULTI_CURRENCY_RESPONSE",
