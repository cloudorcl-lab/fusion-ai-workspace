        {
          "metadata": {
            "name": "setifValidReply",
            "returnType": "object",
            "sourceCode": "let checkReply =\n    $context.$nodes.CHECK_DATA_AND_ISREPLY &&\n    $context.$nodes.CHECK_DATA_AND_ISREPLY.$output\n        ? $context.$nodes.CHECK_DATA_AND_ISREPLY.$output.result\n        : false;\n\nlet isReplyFlow = false;\nlet isIntentFound = true;\nlet expenseId = null;\nlet partnerExpenseReferenceId = null;\n\nlet vendorLength = 0;\nlet detailReply = false;\nlet detailItemsLength = 0;\nlet expenseItemsLength = 0;\nlet branch = \"\";\n\nif (checkReply) {\n\n    let vendorResult =\n        ($context.$nodes.GETVENDORREFERENCEID &&\n            $context.$nodes.GETVENDORREFERENCEID.$output &&\n            $context.$nodes.GETVENDORREFERENCEID.$output.result) || [];\n\n    let expenseOutput =\n        ($context.$nodes.GET_EXPENSE_DETAILS &&\n            $context.$nodes.GET_EXPENSE_DETAILS.$output) || {};\n\n    vendorLength = vendorResult.length || 0;\n\n    if (vendorLength === 0) {\n\n        branch = \"VendorLength=0\";\n\n        detailReply =\n            $context.$nodes.CHECKEXPENSEDETAILS &&\n            $context.$nodes.CHECKEXPENSEDETAILS.$output\n                ? $context.$nodes.CHECKEXPENSEDETAILS.$output.result\n                : false;\n\n        if (detailReply) {\n\n            let detailOutput =\n                ($context.$nodes.GETEXPENSEFROMDETAILS &&\n                    $context.$nodes.GETEXPENSEFROMDETAILS.$output) || {};\n\n            let detailItems =\n                detailOutput.items || [];\n\n            detailItemsLength = detailItems.length;\n\n            if (\n                detailItems.length === 1 &&\n                detailItems[0] &&\n                detailItems[0].id\n            ) {\n\n                branch = \"VendorLength=0 -> DetailReply=true -> OneExpense\";\n\n                isReplyFlow = true;\n                isIntentFound = true;\n                expenseId = detailItems[0].id;\n                partnerExpenseReferenceId = detailItems[0].partnerExpenseReferenceId;\n\n            } else if (detailItems.length === 0) {\n\n                branch = \"VendorLength=0 -> DetailReply=true -> ZeroExpense\";\n\n                isReplyFlow = false;\n                isIntentFound = true;\n\n            } else {\n\n                branch = \"VendorLength=0 -> DetailReply=true -> MultipleExpenses\";\n\n                isReplyFlow = false;\n                isIntentFound = false;\n\n            }\n\n        } else {\n\n            branch = \"VendorLength=0 -> DetailReply=false\";\n\n            isReplyFlow = false;\n            isIntentFound = true;\n\n        }\n\n    } else if (vendorLength > 1) {\n\n        branch = \"VendorLength>1\";\n\n        isReplyFlow = true;\n        isIntentFound = false;\n\n    } else {\n\n        branch = \"VendorLength=1\";\n\n        let expenseItems =\n            expenseOutput.items || [];\n\n        expenseItemsLength = expenseItems.length;\n\n        if (\n            expenseItems.length === 1 &&\n            expenseItems[0] &&\n            expenseItems[0].id\n        ) {\n\n            branch = \"VendorLength=1 -> OneExpense\";\n\n            isReplyFlow = true;\n            isIntentFound = true;\n            expenseId = expenseItems[0].id;\n            partnerExpenseReferenceId = expenseItems[0].partnerExpenseReferenceId;\n\n        } else {\n\n            branch = \"VendorLength=1 -> InvalidExpenseMatch\";\n\n            isReplyFlow = true;\n            isIntentFound = false;\n\n        }\n    }\n\n} else {\n\n    branch = \"NotReply\";\n\n}\n\nlet finalOutput = new Object();\n\nfinalOutput.isReplyFlow = isReplyFlow;\nfinalOutput.isIntentFound = isIntentFound;\nfinalOutput.expenseId = expenseId;\nfinalOutput.partnerExpenseReferenceId = partnerExpenseReferenceId;\n\nfinalOutput.debug = new Object();\nfinalOutput.debug.checkReply = checkReply;\nfinalOutput.debug.vendorLength = vendorLength;\nfinalOutput.debug.detailReply = detailReply;\nfinalOutput.debug.detailItemsLength = detailItemsLength;\nfinalOutput.debug.expenseItemsLength = expenseItemsLength;\nfinalOutput.debug.branch = branch;\n\nreturn finalOutput;"
          },
          "outcomes": {
            "success": "1767351802123"
          },
          "code": "SETIFVALIDREPLY",
