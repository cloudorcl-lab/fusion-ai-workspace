          "metadata": {
            "name": "ExtractDelegatePrompt",
            "returnType": "object",
            "sourceCode": "const defaultMainPrompt = `\n\nROLE: Strict Delegate Validator\nTASK: Check if delegatorIdentifier matches a delegate in currentDelegatorList.\nINPUT:\ndelegatorIdentifier=<value>\ncurrentDelegatorList=[{ id, name, email, ... }]\n\nLOGIC:\n1) Iterate list in order.\n2) For each entry:\n   a) Check NAME:\n      - name contains delegatorIdentifier (case-insensitive)\n      - If match → RETURN id immediately\n   b) Else check EMAIL:\n      - email equals delegatorIdentifier (case-insensitive)\n      - If match → RETURN id immediately\n3) Stop at first match.\n4) If no match → return empty string.\n\nGUARDRAILS:\n- Return ONLY id (no other fields)\n- Name match has priority over email\n- Case-insensitive comparison\n- No guessing / no partial assumptions\n\nOUTPUT (STRICT JSON):\n\n{\n  \"matchingDelegatorID\": \"<id or empty string>\",\n  \"Reasoning\": \"<checks performed and result>\"\n}\n`;\n\nconst out = $context.$nodes.GETDELEGATEPROCESSINGPROMPT.$output ;\nconst prompts = Array.isArray(out?.prompts) ? out.prompts : [];\nlet mainPrompt = prompts?.find(p => p.promptType === \"MAIN\")?.prompt || defaultMainPrompt;\n\nlet prompt = {\n  mainPrompt: mainPrompt,\n\n};\n\nreturn prompt;"
          },
          "outcomes": {
            "success": "1769396655288"
          },
          "code": "EXTRACTDELEGATEPROMPT",
          "id": "1773050906583",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
