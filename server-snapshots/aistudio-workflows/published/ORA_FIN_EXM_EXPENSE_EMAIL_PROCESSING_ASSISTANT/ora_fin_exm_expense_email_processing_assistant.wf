            "sourceCode": "const expenseDetails = $context.$nodes.EXTRACTEXPENSEDETAILS.$output.expenseDetails;\n\nconst merchant = expenseDetails.merchant;\nconst amount = expenseDetails.amount;\nconst date = expenseDetails.date;\n\nconst isReplyFlow = typeof amount === \"string\" &&\n  amount.trim() !== \"\" &&\n  typeof date === \"string\" &&\n  date.trim() !== \"\";\n\nreturn isReplyFlow;"
