{
  "workflowId": "100002355227086",
  "workflowCode": "ORA_FIN_EXM_EXPENSE_EMAIL_PROCESSING_ASSISTANT",
  "name": "Expense Email Processing Assistant",
  "description": "This workflow agent analyzes incoming emails to determine their intent. If delegate flow is detected, it identifies the delegator’s details and initiates creation or updating of the expense on behalf of the delegator. Otherwise, it creates or updates the expense for the requester",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
