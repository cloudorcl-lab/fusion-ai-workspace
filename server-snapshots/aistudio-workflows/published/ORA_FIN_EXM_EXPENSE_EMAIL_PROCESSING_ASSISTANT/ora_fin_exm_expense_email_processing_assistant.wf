        {
          "metadata": {
            "name": "createPartnerExpenseQuery",
            "returnType": "object",
            "sourceCode": "let subject = $context.$nodes.PARSEEMAIL.$output.result.subject;\nlet personID = $context.$variables.personId;\n\nif (!subject) {\n    subject = \"\";\n}\n\nsubject = subject.trim();\n\nif (subject.indexOf(\"Re:\") === 0 || subject.indexOf(\"RE:\") === 0 || subject.indexOf(\"re:\") === 0) {\n    subject = subject.substring(subject.indexOf(\":\") + 1).trim();\n}\n\nlet escapedSubject = subject.replace(/'/g, \"''\");\n\nlet result = {};\n\nresult.subject = subject;\n\nif (subject.length > 0) {\n    result.expenseQuery = {};\n    result.expenseQuery.fields = [\n        \"partnerExpenseReferenceId\"\n    ];\n\n    result.expenseQuery.collection = {};\n    result.expenseQuery.collection.filter =\n        \"person.id=\" + personID + \" and sourceTypeCode='MESSAGE'\";\n\n    result.expenseQuery.subTypes = {};\n    result.expenseQuery.subTypes.MESSAGE = {};\n    result.expenseQuery.subTypes.MESSAGE.fields = [\n        \"messageIdentifier\"\n    ];\n\n    result.expenseQuery.subTypes.MESSAGE.collection = {};\n    result.expenseQuery.subTypes.MESSAGE.collection.filter =\n        \"messageIdentifier='\" + escapedSubject + \"'\";\n}\nreturn result;"
          },
          "outcomes": {
            "success": "1784473990091"
          },
          "code": "CREATEPARTNEREXPENSEQUERY",
