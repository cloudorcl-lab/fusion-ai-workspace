        {
          "metadata": {
            "name": "Check Data and IsReply",
            "returnType": "boolean",
            "sourceCode": "const subject = ($context.$nodes.PARSEEMAIL.$output.result.subject || \"\").trim();\nconst personId = $context.$variables.personId;\n\nconst isReplySubject =\n  personId != null &&\n  String(personId).trim() !== \"\" &&\n  /^re\\s*:/i.test(subject) &&\n  subject.replace(/^re\\s*:\\s*/i, \"\").trim().length > 0;\n\nreturn isReplySubject;"
          },
