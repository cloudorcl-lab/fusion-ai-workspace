            "sourceCode": "let output = $context.$nodes.GETPARTNEREXPENSE.$output;\n\nlet items = output.items || [];\nlet ids = [];\nlet uniqueIds = new Object();\n\nfor (let i = 0; i < items.length; i++) {\n\n    let id = items[i].partnerExpenseReferenceId;\n\n    if (id && !uniqueIds[id]) {\n        uniqueIds[id] = true;\n        ids.push(id);\n    }\n}\n\nlet isReplyFlow = false;\n\nif (ids.length == 1) {\n    isReplyFlow = true;\n}\n\nlet result = new Object();\n\nresult.partnerExpenseReferenceIds = ids;\nresult.length = ids.length;\nresult.isReplyFlow = isReplyFlow;\n\nreturn result;"
          },
