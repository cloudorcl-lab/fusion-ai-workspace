        },
        {
          "metadata": {
            "name": "createDelegateFinderAgentPayload",
            "returnType": "string",
            "sourceCode": "var raw = ($context && $context.$nodes && $context.$nodes.GET_DELEGATE_LIST)\n  ? $context.$nodes.GET_DELEGATE_LIST.$output\n  : null;\n\nvar input = raw;\nif (typeof raw === \"string\") {\n  try {\n    input = JSON.parse(raw);\n  } catch (e) {\n    input = {};\n  }\n}\nif (!input) {\n  input = {};\n}\n\nvar items = Array.isArray(input.items) ? input.items : [];\nvar simplified = [];\n\nfor (var i = 0; i < items.length; i++) {\n  var item = items[i] || {};\n  var delegator = item.delegator || {};\n\n  var names = delegator.names && Array.isArray(delegator.names.items) ? delegator.names.items : [];\n  var emails = delegator.emails && Array.isArray(delegator.emails.items) ? delegator.emails.items : [];\n\n  var firstName = names.length > 0 ? names[0] : {};\n  var firstEmail = emails.length > 0 ? emails[0] : {};\n\n  simplified.push({\n    id: delegator.id != null ? String(delegator.id) : \"\",\n    name: firstName.displayName != null ? String(firstName.displayName) : \"\",\n    email: firstEmail.emailAddress != null ? String(firstEmail.emailAddress) : \"\"\n  });\n}\n\nvar output = {\n  items: simplified,\n  count: simplified.length\n};\n\n$context.$output = output;\nreturn output;"
          },
          "outcomes": {
            "success": "1773050748701"
          },
          "code": "CREATEDELEGATEAGENTPAYLOAD",
          "id": "1766399664420",
          "inputs": [],
