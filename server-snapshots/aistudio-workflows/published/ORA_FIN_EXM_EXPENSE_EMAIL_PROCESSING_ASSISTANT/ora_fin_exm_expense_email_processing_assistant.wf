        {
          "metadata": {
            "name": "EmailPurposeOutput",
            "returnType": "object",
            "sourceCode": "let raw = $context.$nodes.EMAIL_PURPOSE.$output;\n\nif (typeof raw === \"string\") {\n  raw = raw\n    .replace(/^```json\\\\s*/i, \"\")\n    .replace(/^```\\\\s*/i, \"\")\n    .replace(/\\\\s*```$/i, \"\")\n    .trim();\n  try {\n    raw = JSON.parse(raw);\n  } catch (e) {\n    raw = {};   // fallback object\n  }\n}\n\nreturn raw;"
          },
          "outcomes": {
            "success": "1784466063330"
          },
          "code": "EMAILPURPOSEOUTPUT",
          "id": "1778062775728",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "parseEmail",
            "returnType": "object",
            "sourceCode": "let email = JSON.parse($context.$triggers.REST.$input.emailJson);\n\nlet subject = email.subject || \"\";\nlet bodyPlain = email.body_plain || \"\";\nlet bodyHtml = email.body_html || \"\";\n\nlet hasAttachments = email.attachments && email.attachments.length > 0;\n\nlet bodyNormalized = bodyPlain;\n\nif (!bodyNormalized && bodyHtml) {\n    bodyNormalized = bodyHtml\n        .replace(/<style[\\s\\S]*?<\\/style>/gi, \"\")\n        .replace(/<script[\\s\\S]*?<\\/script>/gi, \"\")\n        .replace(/<br\\s*\\/?>/gi, \"\\n\")\n        .replace(/<\\/div>|<\\/p>/gi, \"\\n\")\n        .replace(/<[^>]+>/g, \"\");\n}\n\nbodyNormalized = bodyNormalized\n    .replace(/\\r\\n/g, \"\\n\")\n    .replace(/\\r/g, \"\\n\")\n    .trim();\n\nlet result = {\n    subject: subject,\n    bodyPlain: bodyPlain,\n    bodyHtml: bodyHtml,\n    bodyNormalized: bodyNormalized,\n    hasAttachments: hasAttachments\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1773050477144"
          },
          "code": "PARSEEMAIL",
          "id": "1784465881264",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
