          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"isDelegateFlow\": {\n      \"type\": \"boolean\"\n    },\n    \"delegatorIdentifier\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"Reasoning\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"isDelegateFlow\",\n    \"delegatorIdentifier\",\n    \"Reasoning\"\n  ]\n}",
