        {
          "metadata": {
            "name": "getExpenseDetailsQuery",
            "returnType": "object",
            "sourceCode": "let personId = $context.$variables.personId;\n\n// keep template as a string\nlet expenseQuery =\n  \"$filter=(person[id={personId}] AND expenseDate='{date}' AND merchantName='{merchant}' AND expenseType[name='{expenseType}'] AND receiptAmount={amount})&$fields=id,partnerExpenseReferenceId\";\n\nlet expenseDetails = $context.$nodes.EXTRACTEXPENSEDETAILS.$output.expenseDetails;\n\nlet merchant = expenseDetails.merchant;\nlet expenseType = expenseDetails.expenseType;\nlet date = expenseDetails.date;\nlet amount = expenseDetails.amount;\n\nlet q = expenseQuery.replace(/\\{personId\\}/g, personId);\n\nif (merchant !== undefined && merchant !== null && String(merchant).trim() !== \"\") {\n  let m = String(merchant).trim().replace(/'/g, \"''\");\n  if (/[^A-Za-z0-9 _.-]/.test(m)) m = encodeURIComponent(m);\n  q = q.replace(/\\{merchant\\}/g, m);\n} else {\n  q = q.replace(/ AND merchantName='\\{merchant\\}'/g, \"\");\n}\n\nlet expenseTypeText =\n  expenseType !== undefined && expenseType !== null\n    ? String(expenseType).trim()\n    : \"\";\n\nif (\n  expenseTypeText !== \"\" &&\n  !expenseTypeText.toLowerCase().includes(\"unknown\")\n) {\n  let et = expenseTypeText.replace(/'/g, \"''\");\n  if (/[^A-Za-z0-9 _.-]/.test(et)) et = encodeURIComponent(et);\n  q = q.replace(/\\{expenseType\\}/g, et);\n} else {\n  q = q.replace(/ AND expenseType\\[name='\\{expenseType\\}'\\]/g, \"\");\n}\n\nif (date !== undefined && date !== null && String(date).trim() !== \"\") {\n  q = q.replace(/\\{date\\}/g, String(date).trim());\n} else {\n  q = q.replace(/ AND expenseDate='\\{date\\}'/g, \"\");\n}\n\nif (amount !== undefined && amount !== null && String(amount).trim() !== \"\") {\n  let cleanAmount = String(amount).trim().replace(/,/g, \"\");\n  q = q.replace(/\\{amount\\}/g, cleanAmount);\n} else {\n  q = q.replace(/ AND receiptAmount=\\{amount\\}/g, \"\");\n}\n\nreturn q;"
          },
          "outcomes": {
            "success": "1784474697988"
          },
          "code": "GETEXPENSEDETAILSQUERY",
          "id": "1784474635559",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
