              "value": " let email =  {{$context.$nodes.PARSEEMAIL.$output.result}}  \n {{$context.$nodes.EXTRACTEXPENSEDETAILSPROMPT.$output.result.mainPrompt}} "
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"expenseDetails\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"location\": {\n          \"type\": \"string\"\n        },\n        \"merchant\": {\n          \"type\": \"string\"\n        },\n        \"expenseType\": {\n          \"type\": \"string\"\n        },\n        \"date\": {\n          \"type\": \"string\"\n        },\n        \"amount\": {\n          \"type\": \"string\"\n        },\n        \"currency\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"location\",\n        \"merchant\",\n        \"expenseType\",\n        \"date\",\n        \"amount\",\n        \"currency\"\n      ]\n    }\n  },\n  \"required\": [\n    \"expenseDetails\"\n  ]\n}",
