          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result_count\": {\n      \"type\": \"integer\"\n    },\n    \"page_count\": {\n      \"type\": \"integer\"\n    },\n    \"page_nbr\": {\n      \"type\": \"integer\"\n    },\n    \"next_page\": {\n      \"type\": \"null\"\n    },\n    \"previous_page\": {\n      \"type\": \"null\"\n    },\n    \"results\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"title\": \"Wave Object\",\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"integer\",\n            \"description\": \"Internal Wave ID identifier.\"\n          },\n          \"run_nbr\": {\n            \"type\": \"string\",\n            \"description\": \"Wave Number\"\n          },\n          \"status_id\": {\n            \"type\": \"integer\",\n            \"description\": \"0:Not ready, 10:Created, 20:Processing Started, 80:Failed, 83:Completed Nothing Allocated, 85:Completed Not Fully Allocated, 90:Completed.\"\n          },\n          \"alloc_mode_description\": {\n            \"type\": \"string\",\n            \"description\": \"Identifies the template that defines the rules and methods for allocating inventory during the wave process.\"\n          },\n           \"task_creation_id\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"id\": {\n                \"type\": \"integer\"\n              },\n              \"key\": {\n                \"type\": \"string\",\n                \"description\": \"Task creation is the process of generating specific work assignments or instructions based on wave processing, enabling warehouse personnel to execute and complete operational activities.\"\n              },\n              \"url\": {\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"id\",\n              \"key\",\n              \"url\"\n            ]\n          },\n            \"wave_type_id\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"id\": {\n                  \"type\": \"integer\"\n                },\n                \"key\": {\n                  \"type\": \"string\",\n                  \"description\": \"identifies what type of wave was run. From picking wave, replenishment wave, or work order wave.\"\n                },\n                \"url\": {\n                  \"type\": \"string\",\n                  \"format\": \"url\"\n                }\n              },\n              \"required\": [\n                \"id\",\n                \"key\",\n                \"url\"\n              ]\n            }\n          }\n        }\n      }\n    },\n    \"required\": [\n      \"result_count\",\n      \"page_count\",\n      \"page_nbr\",\n      \"next_page\",\n      \"previous_page\",\n      \"results\"\n    ]\n  }",
          "type": "BO_FUNCTION"
        },
