cription\": \"User assigned to task\"\n          }\n        },\n        \"required\": [\n          \"task_nbr\",\n          \"task_type_id\",\n          \"priority\",\n          \"status_id\",\n          \"wave_id\",\n          \"assigned_user\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"result_count\",\n    \"page_count\",\n    \"page_nbr\",\n    \"next_page\",\n    \"previous_page\",\n    \"results\"\n  ]\n}",
