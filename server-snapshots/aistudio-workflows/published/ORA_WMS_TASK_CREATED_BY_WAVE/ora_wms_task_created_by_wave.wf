          "code": "SUMMARY_OF_TASK",
          "id": "1764192899571",
          "inputs": [
            {
              "id": "1764192899572_1",
              "name": "prompt",
              "type": "string",
              "value": "**Roles:\n-extract data from Get allocations by wave\n {{$context.$nodes.ALLOCATIONS_CREATED.$output}}\n--fact to check: did all the allocations created have a task number?\n--are there allocations with status_id=99. This means the allocation are cancelled. \n\n-Extract  data from Get Task Created By Wave\n {{$context.$nodes.GETTASKCREATEDBYWAVE.$output}}\nThis output includes all the task that were created by wave\n\nInterpretation of task status\n\nstatus_id - Description\n0-Created\n5-Held\n10-Ready\n15-In Drop/Between Zones\n30-Processing started\n90-Completed\n\n\ninterpretation of Wave Status {{$context.$nodes.TASK_TEMPLATE.$output.results[0].status_id}}\nstatus_id - Description\n0-Not ready\n10-Created\n20-Processing started\n80-Failed\n83-Completed Nothing Allocated\n85-Completed Not Fully Allocated\n90-Completed\n95-Cancel in progress\n99-Cancelled\n\n\n\n**extra info\nDo not add reference about status_id on the output\n\nOutput:\nWave : {{$context.$nodes.SET_VARIABLES.$input.WaveNumber}} \nWave Status : {{$context.$nodes.TASK_TEMPLATE.$output.results[0].status_id}}  use description\nTotal Task Created:  Count of all the task created by wave\nTask Type : Provide a breakdown by  task type  and its count"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"Wave \": { \"type\": \"string\" },\n \"Total Task Created\": { \"type\": \"integer\" },    \n\"Task Type\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" }\n    }\n  },\n  \"required\": [\n    \"Wave\",\n    \"Total Task Created\",\n    \"Task Type\"\n  ]\n}",
          "type": "LLM"
        },
