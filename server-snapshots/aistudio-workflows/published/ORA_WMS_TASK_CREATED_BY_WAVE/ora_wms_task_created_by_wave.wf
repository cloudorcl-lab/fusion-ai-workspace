          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result_count\": {\n      \"type\": \"integer\"\n    },\n    \"page_count\": {\n      \"type\": \"integer\"\n    },\n    \"page_nbr\": {\n      \"type\": \"integer\"\n    },\n    \"next_page\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"previous_page\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"results\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"integer\",\n            \"description\": \"allocation ID.\"\n          },\n          \"order_dtl_id\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"id\": {\n                \"type\": \"integer\",\n                \"description\": \"Order detail ID.\"\n              },\n              \"key\": {\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"id\",\n              \"key\"\n            ]\n          },\n          \"from_inventory_id\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"id\": {\n                \"type\": \"integer\",\n                \"description\": \"Inventory ID where it is coming from\"\n              },\n              \"key\": {\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"id\",\n              \"key\"\n            ]\n          },\n          \"to_inventory_id\": {\n            \"anyOf\": [\n              {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"id\": {\n                    \"type\": \"integer\"\n                  },\n                  \"key\": {\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"id\",\n                  \"key\"\n                ]\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"status_id\": {\n            \"type\": \"integer\",\n            \"description\": \"Status of the allocation.\"\n          },\n          \"alloc_qty\": {\n            \"type\": \"string\",\n            \"description\": \"Allocated quantity.\"\n          },\n          \"packed_qty\": {\n            \"type\": \"string\",\n            \"description\": \"Packed quantity.\"\n          },\n          \"type_id\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"id\": {\n                \"type\": \"integer\"\n              },\n              \"key\": {\n                \"type\": \"string\",\n                \"description\": \"Allocation type.\"\n              }\n            },\n            \"required\": [\n              \"id\",\n              \"key\"\n            ]\n          },\n          \"wave_id\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"id\": {\n                \"type\": \"integer\"\n              },\n              \"key\": {\n                \"type\": \"string\",\n                \"description\": \"Wave Number.\"\n              }\n            },\n            \"required\": [\n              \"id\",\n              \"key\"\n            ]\n          },\n          \"task_id\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"id\": {\n                \"type\": \"integer\"\n              },\n              \"key\": {\n                \"type\": \"string\",\n                \"description\": \"Task Number.\"\n              }\n            },\n            \"required\": [\n              \"id\",\n              \"key\"\n            ]\n          },\n          \"alloc_uom_id\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"id\": {\n                \"type\": \"integer\"\n              },\n              \"key\": {\n                \"type\": \"string\",\n                \"description\": \"Allocation UOM.\"\n              }\n            },\n            \"required\": [\n              \"id\",\n              \"key\"\n            ]\n          },\n          \"task_seq_nbr\": {\n            \"type\": \"integer\",\n            \"description\": \"Task Sequence number.\"\n          },\n          \"pick_user\": {\n            \"type\": \"string\",\n            \"description\": \"User that picked the allocation.\"\n          },\n          \"picked_ts\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ],\n            \"format\": \"date-time\"\n          },\n          \"pick_locn_str\": {\n            \"type\": \"string\"\n          },\n          \"final_oblpn_nbr\": {\n            \"type\": \"string\"\n          },\n          \"is_picking_flg\": {\n            \"type\": \"boolean\"\n          }\n        },\n        \"required\": [\n          \"id\",\n          \"url\",\n          \"create_user\",\n          \"create_ts\",\n          \"mod_user\",\n          \"mod_ts\",\n          \"order_dtl_id\",\n          \"from_inventory_id\",\n          \"to_inventory_id\",\n          \"status_id\",\n          \"alloc_qty\",\n          \"packed_qty\",\n          \"type_id\",\n          \"wave_id\",\n          \"task_id\",\n          \"alloc_uom_id\",\n          \"cartonize_uom_id\",\n          \"task_seq_nbr\",\n          \"ob_lpn_type_id\",\n          \"mhe_system_id\",\n          \"pick_user\",\n          \"picked_ts\",\n          \"pick_locn_str\",\n          \"final_oblpn_nbr\",\n          \"is_picking_flg\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"result_count\",\n    \"page_count\",\n    \"page_nbr\",\n    \"next_page\",\n    \"previous_page\",\n    \"results\"\n  ]\n}",
