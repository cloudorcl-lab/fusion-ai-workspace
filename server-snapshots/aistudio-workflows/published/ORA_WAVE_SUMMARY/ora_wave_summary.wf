        {
          "metadata": {
            "businessObjectCode": "ORA_SCM_OTHER_WMS26ABO",
            "errorNodeId": "1765315238088",
            "functionName": "getWave",
            "name": "GetWave"
          },
          "outcomes": {
            "success": "1765315206193"
          },
          "code": "GETWAVE",
          "id": "1765315141747",
          "inputs": [
            {
              "id": "1765315166240_1",
              "name": "pWaveNumber",
              "type": "string",
              "value": "{{$context.$variables.WaveNumber}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result_count\": {\n      \"type\": \"integer\"\n    },\n    \"page_count\": {\n      \"type\": \"integer\"\n    },\n    \"page_nbr\": {\n      \"type\": \"integer\"\n    },\n    \"next_page\": {\n      \"type\": \"null\"\n    },\n    \"previous_page\": {\n      \"type\": \"null\"\n    },\n    \"results\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"title\": \"Wave Object\",\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"integer\",\n            \"description\": \"Internal Wave ID identifier.\"\n          },\n          \"create_user\": {\n            \"type\": \"string\",\n            \"description\": \"Username of the user who initiated the wave process.\"\n          },\n          \"create_ts\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\",\n            \"description\": \"Timestamp indicating when the wave process started.\"\n          },\n          \"mod_user\": {\n            \"type\": \"string\",\n            \"description\": \"Last username to modified the wave.\"\n          },\n          \"mod_ts\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\",\n            \"description\": \"Timestamp indicating when the mod_user modified the wave (usually if the wave is in cancel status, the last mod_user is the user that started the undo process).\"\n          },\n          \"facility_id\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"id\": {\n                \"type\": \"integer\"\n              },\n              \"key\": {\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"id\",\n              \"key\"\n            ]\n          },\n          \"run_nbr\": {\n            \"type\": \"string\",\n            \"description\": \"Wave Number\"\n          },\n          \"alloc_method\": {\n            \"type\": \"string\",\n            \"description\": \"Specifies the inventory allocation method, such as FIFO (First-In, First-Out) or LIFO (Last-In, First-Out), used during the wave process.\"\n          },\n          \"status_id\": {\n            \"type\": \"integer\",\n            \"description\": \"Wave status\"\n          },\n          \"alloc_mode_description\": {\n            \"type\": \"string\",\n            \"description\": \"Identifies the template that defines the rules and methods for allocating inventory during the wave process.\"\n          },\n          \"locn_size_type_id\": {\n            \"anyOf\": [\n              {\n                \"type\": \"integer\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ],\n            \"description\": \"If the location size type is configured, the system will restrict its search to only those locations matching the specified size type.\"\n          },\n          \"wave_template_name\": {\n            \"type\": \"string\",\n            \"description\": \"The wave template name used.\"\n          },\n          \"task_creation_id\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"id\": {\n                \"type\": \"integer\"\n              },\n              \"key\": {\n                \"type\": \"string\",\n                \"description\": \"Task creation is the process of generating specific work assignments or instructions based on wave processing, enabling warehouse personnel to execute and complete operational activities.\"\n              }\n            },\n            \"required\": [\n              \"id\",\n              \"key\"\n            ]\n          },\n          \"replen_active_flg\": {\n            \"type\": \"boolean\",\n            \"description\": \"if enabled it means wave will do replenishment as well.\"\n          },\n          \"replen_case_pick_flg\": {\n            \"type\": \"boolean\"\n          },\n          \"routing_mode_id\": {\n            \"anyOf\": [\n              {\n                \"type\": \"integer\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ],\n            \"description\": \"If routing mode is not null, it indicates that either route mode 1 or route mode 2 has been selected for the process.\"\n          },\n          \"ob_lpn_type_id\": {\n            \"anyOf\": [\n              {\n                \"type\": \"integer\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ],\n            \"description\": \"if oblpn type is not null, it indicates an specific lpn type id selected for the process.\"\n          },\n          \"cubing_rule_id\": {\n            \"anyOf\": [\n              {\n                \"type\": \"integer\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ],\n            \"description\": \"if cubing rule is not null, it indicates which cubed ruled will be selected.\"\n          },\n          \"cubing_mode_id\": {\n            \"anyOf\": [\n              {\n                \"type\": \"integer\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ],\n            \"description\": \"if cubing rule is not null, it indicates which cubing mode will be selected.\"\n          },\n          \"wave_type_id\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"id\": {\n                \"type\": \"integer\"\n              },\n              \"key\": {\n                \"type\": \"string\",\n                \"description\": \"identifies what type of wave was run. From picking wave, replenishment wave, or work order wave.\"\n              }\n            },\n            \"required\": [\n              \"id\",\n              \"key\"\n            ]\n          },\n          \"replenishment_rule_name\": {\n            \"type\": \"string\",\n            \"description\": \"Replenishment rule named used in the wave.\"\n          },\n          \"wave_search_name\": {\n            \"type\": \"string\",\n            \"description\": \"The wave search name refers to the template used to select the orders that will be picked up and processed by the wave.\"\n          },\n          \"alloc_item_expiry_range_name\": {\n            \"type\": \"string\",\n            \"description\": \"Expiration range allowed during the allocation process.\"\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"result_count\",\n    \"page_count\",\n    \"page_nbr\",\n    \"next_page\",\n    \"previous_page\",\n    \"results\"\n  ]\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "IsWaveNumberValid"
          },
          "outcomes": {
