          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_SCM_OTHER_WMS26ABO",
            "functionName": "getWaveStats",
            "name": "GetWaveStats"
          },
          "outcomes": {
            "success": "1765315433346"
          },
          "code": "GETWAVESTATS",
          "id": "1765315275206",
          "inputs": [
            {
              "id": "1765315304858_1",
              "name": "pWaveNumber",
              "type": "string",
              "value": "{{$context.$variables.WaveNumber}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/GetWaveStats/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result_count\": {\n      \"type\": \"integer\"\n    },\n    \"page_count\": {\n      \"type\": \"integer\"\n    },\n    \"page_nbr\": {\n      \"type\": \"integer\"\n    },\n    \"next_page\": {\n      \"type\": [\n        \"null\",\n        \"string\"\n      ]\n    },\n    \"previous_page\": {\n      \"type\": [\n        \"null\",\n        \"string\"\n      ]\n    },\n    \"results\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"integer\"\n          },\n          \"url\": {\n            \"type\": \"string\",\n            \"format\": \"uri\"\n          },\n          \"create_user\": {\n            \"type\": \"string\",\n            \"description\": \"Username of the user who initiated the wave process.\"\n          },\n          \"create_ts\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\",\n            \"description\": \"Timestamp indicating when the wave process started.\"\n          },\n          \"mod_user\": {\n            \"type\": \"string\",\n            \"description\": \"Last username to modified the wave.\"\n          },\n          \"mod_ts\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\",\n            \"description\": \"Timestamp indicating when the mod_user modified the wave (usually if the wave is in cancel status, the last mod_user is the user that started the undo process).\"\n          },\n          \"wave_id\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"id\": {\n                \"type\": \"integer\",\n                \"description\": \"Internal Wave ID identifier.\"\n              },\n              \"key\": {\n                \"type\": \"string\",\n                \"description\": \"Wave Number\"\n              },\n              \"url\": {\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"id\",\n              \"key\",\n              \"url\"\n            ]\n          },\n          \"nbr_order_hdrs_selected\": {\n            \"type\": \"integer\",\n            \"description\": \"Number of order headers selected.\"\n          },\n          \"nbr_order_dtls_selected\": {\n            \"type\": \"integer\",\n            \"description\": \"Number of order details selected.\"\n          },\n          \"nbr_order_hdrs_allocated\": {\n            \"type\": \"integer\",\n            \"description\": \"Number of order headers allocated.\"\n          },\n          \"nbr_order_dtls_allocated\": {\n            \"type\": \"integer\",\n            \"description\": \"Number of order details allocated.\"\n          },\n          \"nbr_full_lpns_allocated\": {\n            \"type\": \"integer\",\n            \"description\": \"Number of full LPNs allocated.\"\n          },\n          \"total_lpns_allocated\": {\n            \"type\": \"integer\",\n            \"description\": \"Total LPNs Allocated.\"\n          },\n          \"nbr_skus_selected\": {\n            \"type\": \"integer\",\n            \"description\": \"Number of SKUs selected.\"\n          },\n          \"nbr_skus_allocated\": {\n            \"type\": \"integer\",\n            \"description\": \"Number of SKUs allocated.\"\n          },\n          \"nbr_alloc_mode_seq_executed\": {\n            \"type\": \"integer\",\n            \"description\": \"Number of allocation mode sequence exectuted.\"\n          },\n          \"nbr_oblpns_created\": {\n            \"type\": \"integer\",\n            \"description\": \"Number of OBLPNs created.\"\n          },\n          \"nbr_tasks_created\": {\n            \"type\": \"integer\",\n            \"description\": \"Number of tasks created.\"\n          },\n          \"nbr_lpns_rejected\": {\n            \"type\": [\n              \"integer\",\n              \"null\"\n            ],\n            \"description\": \"Number of LPNs that were rejected and not considered by the wave.\"\n          },\n          \"nbr_lpns_deallocated\": {\n            \"type\": [\n              \"integer\",\n              \"null\"\n            ],\n            \"description\": \"Number of LPNs that were deallocated by the wave.\"\n          },\n          \"nbr_orders_deallocated_cancelled\": {\n            \"type\": [\n              \"integer\",\n              \"null\"\n            ],\n            \"description\": \"Number of orders that were deallocated and then cancelled by the wave.\"\n          },\n          \"total_quantity_allocated\": {\n            \"type\": \"string\",\n            \"description\": \"Total quantity allocated.\"\n          },\n          \"order_selection_time\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ],\n            \"description\": \"timestamp indicating time it took to select orders by the wave.\"\n          },\n          \"allocation_time\": {\n            \"type\": \"string\",\n            \"description\": \"timestamp indicating time it took to allocated orders by the wave.\"\n          },\n          \"load_creation_time\": {\n            \"type\": \"string\",\n            \"description\": \"timestamp indicating time it took the wave to create loads.\"\n          },\n          \"cubing_time\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ],\n            \"description\": \"timestamp indicating time it took during the cubing process.\"\n          },\n          \"task_creation_time\": {\n            \"type\": \"string\",\n            \"description\": \"timestamp indicating time it took during the task creation process.\"\n          },\n          \"total_wave_time\": {\n            \"type\": \"string\",\n            \"description\": \"timestamp indicating total time it took to complete the total wave process.\"\n          },\n          \"wave_resume_attempted_count\": {\n            \"type\": \"integer\",\n            \"description\": \"wave resume attempted count\"\n          },\n          \"wave_internal_retry_count\": {\n            \"type\": \"integer\",\n            \"description\": \"wave internal retry count.\"\n          }\n        },\n        \"required\": [\n          \"id\",\n          \"url\",\n          \"create_user\",\n          \"create_ts\",\n          \"mod_user\",\n          \"mod_ts\",\n          \"wave_id\",\n          \"nbr_order_hdrs_selected\",\n          \"nbr_order_dtls_selected\",\n          \"nbr_order_hdrs_allocated\",\n          \"nbr_order_dtls_allocated\",\n          \"nbr_full_lpns_allocated\",\n          \"total_lpns_allocated\",\n          \"nbr_skus_selected\",\n          \"nbr_skus_allocated\",\n          \"nbr_alloc_mode_seq_executed\",\n          \"nbr_oblpns_created\",\n          \"nbr_tasks_created\",\n          \"nbr_lpns_rejected\",\n          \"nbr_lpns_deallocated\",\n          \"nbr_orders_deallocated_cancelled\",\n          \"total_quantity_allocated\",\n          \"order_selection_time\",\n          \"allocation_time\",\n          \"load_creation_time\",\n          \"cubing_time\",\n          \"task_creation_time\",\n          \"total_wave_time\",\n          \"wave_resume_attempted_count\",\n          \"wave_internal_retry_count\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"result_count\",\n    \"page_count\",\n    \"page_nbr\",\n    \"next_page\",\n    \"previous_page\",\n    \"results\"\n  ]\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_SCM_OTHER_WMS26ABO",
            "functionName": "getWaveLogs",
            "name": "GetWaveLogs"
          },
          "outcomes": {
            "success": "1765315615063"
          },
          "code": "GETWAVELOGS",
          "id": "1765315433346",
          "inputs": [
            {
              "id": "1765315584222_1",
              "name": "pWaveNumber",
              "type": "string",
              "value": "{{$context.$variables.WaveNumber}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/waveLogs/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result_count\": {\n      \"type\": \"integer\"\n    },\n    \"page_count\": {\n      \"type\": \"integer\"\n    },\n    \"page_nbr\": {\n      \"type\": \"integer\"\n    },\n    \"next_page\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"previous_page\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"results\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"integer\"\n          },\n          \"create_user\": {\n            \"type\": \"string\",\n            \"description\": \"Username of the user who initiated the wave process.\"\n          },\n          \"create_ts\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\",\n            \"description\": \"Timestamp indicating when the wave process started.\"\n          },\n          \"mod_user\": {\n            \"type\": \"string\",\n            \"description\": \"Last username to modified the wave.\"\n          },\n          \"mod_ts\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\",\n            \"description\": \"Timestamp indicating when the mod_user modified the wave (usually if the wave is in cancel status, the last mod_user is the user that started the undo process).\"\n          },\n          \"facility_id\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"id\": {\n                \"type\": \"integer\"\n              },\n              \"key\": {\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"id\",\n              \"key\"\n            ]\n          },\n          \"company_id\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"id\": {\n                \"type\": \"integer\"\n              },\n              \"key\": {\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"id\",\n              \"key\",\n              \"url\"\n            ]\n          },\n          \"seq_nbr\": {\n            \"type\": \"integer\",\n            \"description\": \"Sequence Number.\"\n          },\n          \"description\": {\n            \"type\": \"string\",\n            \"description\": \"Key events that happened during the waving process.\"\n          }\n        },\n        \"required\": [\n          \"id\",\n          \"create_user\",\n          \"create_ts\",\n          \"mod_user\",\n          \"mod_ts\",\n          \"facility_id\",\n          \"company_id\",\n          \"module\",\n          \"key\",\n          \"seq_nbr\",\n          \"message_code_id\",\n          \"description\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"result_count\",\n    \"page_count\",\n    \"page_nbr\",\n    \"next_page\",\n    \"previous_page\",\n    \"results\"\n  ]\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Extract Wave Info"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "EXTRACT_WAVE_INFO",
          "id": "1765315615063",
          "inputs": [
            {
              "id": "1765315615064_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an expert WMS support analyst highly skilled at interpreting the wave process.\n\nUse only these terminology replacements:\n\n“number” instead of “nbr”\n“headers” instead of “hdrs”\n“details” instead of “dtls”\nWave Status values:\n0: Not ready\n10: Created\n20: Processing started\n80: Failed\n83: Completed Nothing Allocated\n85: Completed Not Fully Allocated\n90: Completed\n95: Cancel in progress\n99: Cancelled\n\nAnalyze and summarize using only these data sources:\n\nWave Configuration: {{$context.$nodes.GETWAVE.$output}}\nWave Logs: {{$context.$nodes.GETWAVELOGS.$output}}\nWave Statistics: {{$context.$nodes.GETWAVESTATS.$output}}\nInstructions:\n\nTreat any empty or null configuration field (e.g., task_creation_id) as \"not configured.\"\nMessage text may reference allocated quantity and created LPNs.\nThe description field in logs is critical—analyze it for key events or exceptions.\nIgnore the printing process unless explicitly mentioned in logs.\nConvert ISO 8601 timestamps (e.g., 2025-12-08T19:14:28+05:30) to standard readable date/time.\nSummarize achievements using these metrics:\nTotal Wave Time\nLongest Process Time (mention process)\nOrder headers/details selected vs allocated\nOBLPNs created\nTotal quantity allocated (append uom)\nLPNs deallocated (report only if > 0)\nTasks created ({{$context.$nodes.GETWAVESTATS.$output.results[0].nbr_tasks_created}})\nIf a wave is “Cancelled,” note the last modification timestamp and user responsible.\nOutput organization:\n\nWave Execution Summary:\nInclude (each on a new line): Run Number, Wave Type, Wave Template, Task Creation Template, Create Timestamp, Status, Replenishment Rule.\nKey Events:\nList significant notable outcomes or exceptions, new line per event.\nProvide a brief, executive-level narrative (2-3 sentences) of milestones or exceptions—no numeric results (reserve for Metrics).\nKey Metrics:\nPresent the metrics above, detailed as appropriate for wave type.\nFor “Replenishment Wave” types: omit any order-related metrics; show only relevant replenishment metrics.\nFor other types (like Picking Wave): show full order and allocation data.\nConclusion:\nConcise high-level summary; do not repeat metric values or process steps.\nGeneral rules:\n\nUse only provided configuration and logs—do not invent or infer data.\nOmit recommendations, instructions, and meta-comments in your output.\nWrite plain English paragraphs with true line breaks (not JSON/escaped).\nWhen referring to fields in output, do not use raw field or technical names—write for comprehension."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"Executive Summary\": { \"type\": \"string\" },\n    \"Key Events\": { \"type\": \"string\" },\n    \"Key Metrics\": { \"type\": \"string\" },\n    \"Conclusion\": { \"type\": \"string\" }\n  },\n  \"required\": [\n    \"Executive Summary\",\n    \"Key Events\",\n    \"Key Metrics\",\n    \"Conclusion\"\n  ],\n  \"additionalProperties\": false\n}",
          "type": "LLM"
        }
      ],
