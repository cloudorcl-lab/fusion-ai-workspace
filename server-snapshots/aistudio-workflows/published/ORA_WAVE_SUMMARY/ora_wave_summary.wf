              "name": "prompt",
              "type": "string",
              "value": "Extract the user input from the following: {{$context.$system.$inputMessage}}\nIf Wave Number data is present the extract it in 'WaveNumber\". If user just passed a value assume this is the WaveNumber"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"WaveNumber\": {\n            \"type\": \"string\"\n        }\n    }\n}",
