              },
              "code": "ORA_LLM_MODEL_PROVIDER_CERT_BASIC_LLAMA_3_3_70B",
              "model": "ORA_LLM_MODEL_GPT_OSS_120B",
              "modelName": "GPT OSS 120B (Basic)",
              "provider": "CERT_BASIC"
            },
            "name": "Generate Offer Rejection Payload"
          },
          "outcomes": {
            "success": "1769545189420"
          },
          "code": "FIN_AP_LLM_REJECTION_PAYLOAD",
          "convergenceTargetId": "1771626617962",
          "id": "1766749070601",
          "inputs": [
            {
              "id": "1766749070602_1",
              "name": "prompt",
              "type": "string",
              "value": "You are the Offer Rejection Payload Builder.\n\nYour task is to construct the Offer Rejection Payload using ONLY the offer data that is to be deleted\n\nOffers to be deleted: {{$context.$variables.offerDetails}} \n\nDo NOT:\n- Select new offers\n- Infer data from chat history\n- Change currency\n- Generate messages or errors\n\nYou must return ONLY a JSON object in the exact format below.\n\nOutput format:\n\n{\n  \"financingOptionTypeCode\": \"<financingOptionTypeCode>\",\n  \"financingProgramId\": <financingProgramId>,\n  \"offerRequestParameters\": [\n    {\n      \"supplierId\": <NUMBER>,\n     \"currencyCode\": <Supplier currency code>\n    }\n  ]\n}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"financingOptionTypeCode\": {\n            \"type\": \"string\"\n        },\n        \"financingProgramId\": {\n            \"type\": \"string\"\n        },\n\"offerRequestParameters\": {\n            \"type\": \"object\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_PAYABLES_CONFIRMSUPPLIEROFFERS",
