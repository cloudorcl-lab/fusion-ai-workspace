        {
          "metadata": {
            "name": "Preview Generation Construct",
            "returnType": "object",
            "sourceCode": "const rawOutput = $context.$nodes.FIN_AP_LLM_GENERATE_OFFER_PREVIEW.$output;\n\nconst confirmationPreviewOutput =\n  typeof rawOutput === \"string\" ? JSON.parse(rawOutput) : rawOutput;\n\nconst vars = $context?.$variables?.variables ?? $context?.$variables ?? {};\n\nconst resultJson = {\n  confirmationResponse: confirmationPreviewOutput,\n  variables: {\n    offerDetails: vars?.offerDetails,\n  }\n};\n\nreturn resultJson;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "FIN_AP_CODE_PREVIEW_GENERATION_CONSTRUCT",
          "id": "1771366459024",
          "inputs": [],
