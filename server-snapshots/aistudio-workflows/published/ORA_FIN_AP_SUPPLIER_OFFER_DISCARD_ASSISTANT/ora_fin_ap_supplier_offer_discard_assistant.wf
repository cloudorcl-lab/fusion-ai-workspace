{
  "workflowId": "300000327004568",
  "workflowCode": "ORA_FIN_AP_SUPPLIER_OFFER_DISCARD_ASSISTANT",
  "name": "Supplier Offer Discard Assistant",
  "description": "Supports payment specialists to discard offers which are created erroneously.",
  "specification": {
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
