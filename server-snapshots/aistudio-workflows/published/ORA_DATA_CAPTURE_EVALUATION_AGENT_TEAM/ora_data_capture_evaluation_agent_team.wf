                  },
                  "id": "1778135371894",
                  "code": "ATTRIBUTE_TYPE_SWITCH",
                  "type": "SWITCH",
                  "convergenceTargetId": "end",
                  "inputs": [
                    {
                      "id": "1778135371894_caseExpression",
                      "name": "caseExpression",
                      "type": "string",
                      "value": "{{$context.$nodes.PROCESS_OBJECT_METADATA.DETERMINE_TYPE.$output.result}}"
                    }
                  ]
                },
                {
                  "metadata": {
                    "description": "Resolves LOV endpoint, finder, fields, and dependencies for FCL attributes.",
                    "name": "Derive LOV  Url",
                    "sourceCode": "const openApi = $context.$nodes.GET_OPEN_API_DESCRIBE.$output;\nconst optyResp = $context.$nodes.DEPENDENT_ARRAY?.$output.result;\n\nconst attributeCode = $context.$nodes.PROCESS_OBJECT_METADATA.$currentItem.AttributeCode;\n\nconst preparedRaw = $context.$nodes.PREPARE_ATTRIBUTE_NAME_LIST?.$output;\nconst preparedString = (preparedRaw?.result ?? \"\").toString();\n\nconst preparedAttributeCodes = preparedString\n  .replace(/^\\(\\s*|\\s*\\)$/g, \"\")\n  .split(\",\")\n  .map((s) => s.trim().replace(/^'|'$/g, \"\"))\n  .filter(Boolean);\n\nif (!preparedAttributeCodes.includes(attributeCode)) {\n  return;\n}\n\nconst baseUrl = openApi?.servers?.[0]?.url;\nif (!baseUrl) throw new Error(\"Invalid OpenAPI: missing servers[0].url\");\n\n// 1) Find LOV node for attributeCode\nconst lovNodes = [];\nconst walk = (node) => {\n  if (!node || typeof node !== \"object\") return;\n  if (node[\"x-lov\"]?.definedOn && node.operationRef) {\n    lovNodes.push(node);\n  }\n  Object.values(node).forEach(walk);\n};\nwalk(openApi);\n\nconst lov = lovNodes.find((n) => {\n  const d = n[\"x-lov\"]?.definedOn || \"\";\n  return d === `$this#/${attributeCode}` || d === `$request.body#/${attributeCode}`;\n});\nif (!lov) {\n  throw new Error(`No LOV mapping found for attributeCode: ${attributeCode}`);\n}\n\n\n// NEW: derive definedBaseUrl from operationRef\nconst operationRef = lov.operationRef || \"\";\nconst definedBaseUrl = operationRef.includes(\"fscmRestApi\")\n  ? \"fscmRestApi\"\n  : operationRef.includes(\"crmRestApi\")\n  ? \"crmRestApi\"\n  : \"\";\n\n// 2) lovResource\nconst opMatch = lov.operationRef.match(/#\\/paths\\/~1([^/]+)\\/get$/);\nif (!opMatch) throw new Error(`Invalid operationRef for ${attributeCode}: ${lov.operationRef}`);\nconst lovResource = opMatch[1];\n\n// 3) Build finder + detect dependent placeholders needed for THIS attribute\nconst finderTemplate = lov?.parameters?.finder || lov?.[\"x-lov\"]?.finder || \"\";\nconst optyRow = optyResp?.items?.[0] || {};\n\n// placeholders in finder\nconst finderPlaceholders = [...finderTemplate.matchAll(/\\{([^}]+)\\}/g)].map((m) => m[1]);\n\n// dependent placeholders = all placeholders except self\nconst dependentFields = finderPlaceholders.filter((p) => p !== attributeCode);\n\n// values used from GET_OBJECT for this attribute\nconst dependentFieldValues = {};\ndependentFields.forEach((field) => {\n  if (Object.prototype.hasOwnProperty.call(optyRow, field)) {\n    dependentFieldValues[field] = optyRow[field];\n  }\n});\n\n// if any dependent field required but missing in opty response, surface clearly\nconst missingDependentFields = dependentFields.filter(\n  (field) =>\n    !Object.prototype.hasOwnProperty.call(dependentFieldValues, field) ||\n    dependentFieldValues[field] === null ||\n    dependentFieldValues[field] === undefined\n);\n\n// resolve finder\nconst finderResolved = finderTemplate.replace(/\\{([^}]+)\\}/g, (_, key) => {\n  if (key === attributeCode) return \"\"; // self placeholder -> empty for full LOV list\n  if (Object.prototype.hasOwnProperty.call(dependentFieldValues, key) && dependentFieldValues[key] != null) {\n    return encodeURIComponent(String(dependentFieldValues[key]));\n  }\n  return \"\"; // unresolved dependent value -> empty\n});\n\n// 4) Build fields from x-lov: valueField + displayFields\nconst valueField = lov?.[\"x-lov\"]?.valueField || \"\";\nconst displayFields = Array.isArray(lov?.[\"x-lov\"]?.displayFields) ? lov[\"x-lov\"].displayFields : [];\n\nconst fieldsList = [valueField, ...displayFields].filter(Boolean);\n\nif (attributeCode === \"CurrencyCode\" && !fieldsList.includes(\"Name\")) {\n  fieldsList.push(\"Name\");\n}\n\n// de-duplicate preserving order\nconst seen = new Set();\nconst fieldsResolved = fieldsList.filter((f) => {\n  if (seen.has(f)) return false;\n  seen.add(f);\n  return true;\n}).join(\",\");\n\nreturn {\n  attributeCode,\n  lovResource,\n  finderResolved,\n  fieldsResolved,\n  dependentFields,\n  dependentFieldValues,\n  missingDependentFields,\n  definedBaseUrl\n};",
                    "returnType": "object"
                  },
                  "diagram": {
                    "x": 3639.141935216476,
                    "y": 8219.056274695897
                  },
                  "outcomes": {
                    "success": "1778135941181"
                  },
                  "id": "1778135463110",
                  "code": "DERIVE_LOV_URL",
                  "type": "CODE",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "metadata": {
                    "modelConfiguration": {
                      "modelProperties": {
                        "k": 0,
                        "max_tokens": 32000,
                        "p": 0.75
                      },
                      "code": "ORA_LLM_PREMIUM",
                      "modelName": "GPT-4.1 Mini",
                      "provider": "CERT_PREMIUM",
                      "model": "OPEN_AI_GPT_4_1_MINI"
                    },
                    "description": "Extracts a candidate DCL value from context for current attribute.",
                    "name": "Derive dcl value"
                  },
                  "diagram": {
                    "x": 4454.060529671151,
                    "y": 8217.125187420577
                  },
                  "outcomes": {
                    "success": "1778135658059"
                  },
                  "id": "1778135544508",
                  "code": "DERIVE_DCL_VALUE",
                  "type": "LLM",
                  "inputs": [
                    {
                      "id": "1778135544508_prompt",
                      "name": "prompt",
                      "type": "string",
                      "value": "---------------> Input <---------------\nATTRIBUTE_CODE:\n{{$context.$nodes.PROCESS_OBJECT_METADATA.$currentItem.AttributeCode}}\n\nDISPLAY_NAME:\n{{$context.$nodes.PROCESS_OBJECT_METADATA.$currentItem.DisplayName}}\n\nCONTEXT:\n{{$context.$nodes.REQUIRED_CONTEXT.$output.result}}\n\n---------------> Objective <---------------\nExtract one candidate value for ATTRIBUTE_CODE from CONTEXT using explicit evidence only.\n\n---------------> Logic <---------------\n1. Target intent is DISPLAY_NAME or semantically similar wording.\n2. Search priority:\n   a) First search CONTEXT.engagements[*] (subject + engagementRawText + participants).\n   b) If not found in engagements, search the rest of CONTEXT.\n3. Retrieve only the Value part after DISPLAY_NAME\n3. Use explicit mentions only (no inference).\n4. If multiple explicit matches in engagements, choose the most recent by:\n   a) engagementTime (latest),\n   b) if tie, later occurrence in text.\n5. If found only outside engagements, choose the most recent using available timestamps; else later occurrence.\n6. Preserve source value exactly, except:\n   - trim leading/trailing spaces\n   - remove trailing punctuation only: . , ; :\n7. If no explicit value is found in both engagements and the rest of CONTEXT, return \"NA\".\n8. Do not infer, guess, normalize, paraphrase, or explain.\n9. Output valid JSON object only.\n\n-------------------> Output Format (strict JSON only) <--------------------\n{\n  \"attributeCode\": \"<ATTRIBUTE_CODE>\",\n  \"candidateValue\": \"<TEXT_OR_NA>\"\n}\n---------------> Example (only for reference) <-----------------\n{\n  \"attributeCode\": \"PrimaryPartnerId\",\n  \"candidateValue\": \"Data Services\"\n}"
                    }
                  ]
                },
                {
                  "metadata": {
                    "description": "Builds DCL lookup query params, custom via OpenAPI or OOTB via mapped resources.",
                    "name": "DERIVE DCL URL",
                    "returnType": "object",
                    "sourceCode": "const customDcl = $context.$nodes.PROCESS_OBJECT_METADATA.$currentItem.AttributeCode.endsWith(\"_c\");\nif (customDcl) {\n    let openApiResponse = $context.$nodes.GET_OPEN_API_DESCRIBE.$output\n\n    const dclValue = $context.$nodes.PROCESS_OBJECT_METADATA.DERIVE_DCL_VALUE.$output.candidateValue;\n\n    const attributeCode = $context.$nodes.PROCESS_OBJECT_METADATA.DERIVE_DCL_VALUE.$output.attributeCode;\n\n    const dclAttributeCode = /_Id_c$/.test(attributeCode)\n        ? attributeCode.replace(/_Id_c$/, \"_c\")\n        : attributeCode;\n\n\n\n\n    if (typeof openApiResponse === \"string\") {\n        try {\n            openApiResponse = JSON.parse(openApiResponse);\n        } catch (e) {\n            return { error: \"OPENAPI output is not valid JSON string\", detail: String(e) };\n        }\n    }\n\n\n    if (!openApiResponse || !dclAttributeCode) {\n        return {\n            error: \"Missing openApiResponse or dclAttributeCode\",\n            openApiExists: !!$context?.$nodes?.GET_OPEN_API_DESCRIBE?.$output,\n            restInput: $context?.$triggers?.REST?.$input || null\n        };\n    }\n\n\n    const clean = (v) => String(v == null ? \"\" : v).replace(/[\\r\\n\\t]+/g, \"\").trim();\n    const safeDecode = (v) => {\n        try { return decodeURIComponent(v); } catch (e) { return v; }\n    };\n\n\n    const matches = [];\n    (function walk(node) {\n        if (!node || typeof node !== \"object\") return;\n\n        if (\n            node[\"x-lov\"] &&\n            node[\"x-lov\"].definedOn &&\n            node[\"x-lov\"].definedOn.endsWith(\"#/\" + dclAttributeCode)\n        ) {\n            matches.push({ lovNode: node, xLov: node[\"x-lov\"] });\n        }\n\n        Object.keys(node).forEach((k) => walk(node[k]));\n    })(openApiResponse);\n\n    if (!matches.length) {\n        return { error: \"No x-lov match found for attribute\", attribute: dclAttributeCode };\n    }\n\n    // Prefer $this#/...\n    matches.sort((a, b) => {\n        const aThis = (a.xLov.definedOn || \"\").startsWith(\"$this#\") ? 0 : 1;\n        const bThis = (b.xLov.definedOn || \"\").startsWith(\"$this#\") ? 0 : 1;\n        return aThis - bThis;\n    });\n\n    const hit = matches[0];\n    const lovNode = hit.lovNode;\n    const xLov = hit.xLov;\n\n    if (!lovNode?.operationRef || !xLov?.valueField) {\n        return { error: \"Missing operationRef or valueField in x-lov metadata\" };\n    }\n\n    // 2) Parse resource path from operationRef hash\n    const operationRef = lovNode.operationRef;\n    const hash = operationRef.split(\"#\")[1] || \"\";\n\n    const pathMatch = hash.match(/^\\/paths\\/(.+)\\/(get|post|patch|delete)$/);\n    if (!pathMatch) {\n        return { error: \"Cannot parse resource path from operationRef\", operationRef };\n    }\n\n    const resourcePath = clean(\n        pathMatch[1]\n            .replace(/~1/g, \"/\")\n            .replace(/~0/g, \"~\")\n            .replace(/^\\/+/, \"\") // no leading slash\n    );\n\n    // 3) Build placeholders\n    const valueField = clean(xLov.valueField);\n\n    const finderRaw = lovNode?.parameters?.finder ? safeDecode(lovNode.parameters.finder) : \"\";\n    const finder = clean(finderRaw);\n    const finderPart = finder ? `finder=${finder}&` : \"\";\n\n    const derivedFields = Object.keys(xLov.derivedFieldsMapping || {}).map((k) => {\n        const arr = k.split(\".\");\n        return clean(arr[arr.length - 1]);\n    });\n\n    const fields = Array.from(new Set([valueField].concat(derivedFields)))\n        .filter(Boolean)\n        .join(\",\");\n\n    const searchValue = clean(dclValue).replace(/\\s+/g, '%');\n    const rawQ = `${valueField} like '%${searchValue}%'`;\n    const encodedQ = encodeURIComponent(rawQ);\n\n\n    return {\n        RESOURCE_PATH: resourcePath,\n        FINDER_PART: finderPart,\n        VALUE_FIELD: valueField,\n        Q: encodedQ,\n        FIELDS: fields,\n        ATTRIBUTE_CODE: dclAttributeCode\n    };\n\n} else {\n\n    const dclAttributeCode = $context.$nodes.PROCESS_OBJECT_METADATA.DERIVE_DCL_VALUE.$output.attributeCode;\n    const dclValue = $context.$nodes.PROCESS_OBJECT_METADATA.DERIVE_DCL_VALUE.$output.candidateValue;\n    const clean = (v) => String(v == null ? \"\" : v).replace(/[\\r\\n\\t]+/g, \"\").trim();\n\n    const searchValue = clean(dclValue).replace(/\\s+/g, \"%\");\n\n    // PrimaryCampaignId\n    if (dclAttributeCode === \"PrimaryCampaignId\") {\n        const RESOURCE_PATH = \"campaigns\";\n        const FINDER_PART = \"\";\n        const VALUE_FIELD = \"CampaignName\";\n        const FIELDS = \"CampaignName,CampaignId\";\n\n        const rawQ = `${VALUE_FIELD} like '%${searchValue}%'`;\n        const Q = encodeURIComponent(rawQ);\n\n        return { RESOURCE_PATH, FINDER_PART, VALUE_FIELD, FIELDS, Q, ATTRIBUTE_CODE: dclAttributeCode };\n    }\n\n    // PrimaryPartnerId\n    if (dclAttributeCode === \"PrimaryPartnerId\") {\n        const RESOURCE_PATH = \"partners\";\n        const FINDER_PART = \"\";\n        const VALUE_FIELD = \"OrganizationName\";\n        const FIELDS = \"OrganizationName,PartyId\";\n\n        const rawQ = `${VALUE_FIELD} like '%${searchValue}%'`;\n        const Q = encodeURIComponent(rawQ);\n\n        return { RESOURCE_PATH, FINDER_PART, VALUE_FIELD, FIELDS, Q, ATTRIBUTE_CODE: dclAttributeCode };\n    }\n\n    // KeyContactId\n    if (dclAttributeCode === \"KeyContactId\") {\n        const RESOURCE_PATH = \"contacts\";\n        const FINDER_PART = \"\";\n        const VALUE_FIELD = \"ContactName\";\n        const FIELDS = \"ContactName,PartyId\";\n\n        const rawQ = `${VALUE_FIELD} like '%${searchValue}%'`;\n        const Q = encodeURIComponent(rawQ);\n\n        return { RESOURCE_PATH, FINDER_PART, VALUE_FIELD, FIELDS, Q, ATTRIBUTE_CODE: dclAttributeCode };\n    }\n\n    // TargetPartyId\n    if (dclAttributeCode === \"TargetPartyId\") {\n        const RESOURCE_PATH = \"accounts\";\n        const FINDER_PART = \"\";\n        const VALUE_FIELD = \"PartyUniqueName\";\n        const FIELDS = \"PartyUniqueName,PartyId\";\n\n        const rawQ = `${VALUE_FIELD} like '%${searchValue}%'`;\n        const Q = encodeURIComponent(rawQ);\n\n        return { RESOURCE_PATH, FINDER_PART, VALUE_FIELD, FIELDS, Q, ATTRIBUTE_CODE: dclAttributeCode };\n    }\n\n    // PrimaryCompetitorId\n    if (dclAttributeCode === \"PrimaryCompetitorId\") {\n        const RESOURCE_PATH = \"competitors\";\n        const FINDER_PART = \"\";\n        const VALUE_FIELD = \"PartyUniqueName\";\n        const FIELDS = \"PartyUniqueName,PartyId\";\n\n        const rawQ = `${VALUE_FIELD} like '%${searchValue}%'`;\n        const Q = encodeURIComponent(rawQ);\n\n        return { RESOURCE_PATH, FINDER_PART, VALUE_FIELD, FIELDS, Q, ATTRIBUTE_CODE: dclAttributeCode };\n    }\n\n    // AssetId\n    if (dclAttributeCode === \"AssetId\") {\n        const RESOURCE_PATH = \"assets\";\n        const FINDER_PART = \"\";\n        const VALUE_FIELD = \"Product\";\n        const FIELDS = \"Product,AssetId\";\n\n        const rawQ = `${VALUE_FIELD} like '%${searchValue}%'`;\n        const Q = encodeURIComponent(rawQ);\n\n        return { RESOURCE_PATH, FINDER_PART, VALUE_FIELD, FIELDS, Q, ATTRIBUTE_CODE: dclAttributeCode };\n    }\n\n    return {\n        error: \"Unsupported AttributeCode\",\n        AttributeCode: dclAttributeCode,\n        ATTRIBUTE_CODE: dclAttributeCode\n    };\n\n\n}"
                  },
                  "diagram": {
                    "x": 4454.06052967115,
                    "y": 8344.576947591397
                  },
                  "outcomes": {
