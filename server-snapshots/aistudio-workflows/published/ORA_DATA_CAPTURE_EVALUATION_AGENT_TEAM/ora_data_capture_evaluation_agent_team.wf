            "description": "The get opportunity or accounts fields list",
            "name": "Get object fields list",
            "sourceCode": "const attrs1 = $context.$nodes.PREPARE_ATTRIBUTE_NAME_LIST?.$output?.result || [];\nconst attrs2 = $context.$nodes.DEPENDENT_ATTRIBUTES?.$output?.result || [];\n\nconst combined = [...new Set([...(attrs1 || []), ...(attrs2 || [])].filter(Boolean))];\n\nreturn combined.join(\",\");",
