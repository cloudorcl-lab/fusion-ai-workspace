            "description": "Current data capture attribute values",
            "name": "Current data capture  attribute values",
            "sourceCode": "const attrs = $context.$nodes.PREPARE_ATTRIBUTE_NAME_LIST?.$output?.result || [];\nconst record = $context.$nodes.GET_OBJECT?.$output || {};\n\nconst currentAttributesSet = new Set((attrs || []).filter(Boolean));\n\nconst currentAttributes = Object.fromEntries(\n  Object.entries(record).filter(([k]) => currentAttributesSet.has(k))\n);\n\nreturn currentAttributes;",
