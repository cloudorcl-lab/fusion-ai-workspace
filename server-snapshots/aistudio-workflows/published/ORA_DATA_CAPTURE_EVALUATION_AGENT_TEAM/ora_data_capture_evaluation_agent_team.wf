                {
                  "metadata": {
                    "description": "Converts DCL lookup response into final attribute key/value payload for merge.",
                    "name": "Process dcl attributes",
                    "returnType": "object",
                    "sourceCode": "const customDcl = $context.$nodes.PROCESS_OBJECT_METADATA.$currentItem.AttributeCode.endsWith(\"_c\");\n\nif (customDcl) {\n\n    const attributeCode = $context.$nodes.PROCESS_OBJECT_METADATA.DERIVE_DCL_URL.$output.result.ATTRIBUTE_CODE; // always ends with _c\n    const lovResponse = $context.$nodes.PROCESS_OBJECT_METADATA.GET_DCL_ID.$output\n\n    // take first item\n    const first = lovResponse?.items?.[0];\n    if (!first) return { error: `No value found for DCL attribute ${attributeCode}` };\n\n    // detect fields by value type\n    const keys = Object.keys(first);\n\n    // text field => string value\n    const textField = keys.find((k) => typeof first[k] === \"string\");\n\n    // id field => first non-string value\n    const idField = keys.find((k) => k !== textField && typeof first[k] !== \"string\");\n\n    if (!textField || !idField) {\n        return {\n            error: \"Could not identify text/id fields by type\",\n            keys,\n            first\n        };\n    }\n\n    // build output keys\n    const textKey = attributeCode;\n    const idKey = attributeCode.replace(/_c$/, \"_Id_c\");\n\n    // return mapped object\n    return {\n        [idKey]: first[idField],\n        [textKey]: first[textField],\n        attributeType: \"DCL\"\n    };\n\n\n\n} else {\n\n    const attributeCode = $context.$nodes.PROCESS_OBJECT_METADATA.DERIVE_DCL_URL.$output.result.ATTRIBUTE_CODE;\n    const lovResponse = $context.$nodes.PROCESS_OBJECT_METADATA.GET_DCL_ID.$output;\n\n    // first item\n    const first = lovResponse?.items?.[0];\n    if (!first) return { error: `No value found for DCL attribute ${attributeCode}` };\n\n\n    const idKey = Object.keys(first).find((k) => /id/i.test(k));\n    if (!idKey) return { error: \"No ID field found in first item\", first };\n\n\n    const nameKey = Object.keys(first).find((k) => k !== idKey);\n\n    // return both: name as-is, id renamed to attributeCode\n    return {\n\n        [attributeCode]: first[idKey],\n        attributeType: \"DCL\"\n    };\n}"
                  },
                  "diagram": {
                    "x": 4454.06052967115,
                    "y": 8614.929166135553
                  },
