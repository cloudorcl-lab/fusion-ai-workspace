            "returnType": "object",
            "sourceCode": "const input = $context.$triggers.REST.$input.context;\nconst out = JSON.parse(JSON.stringify(input)); \n\nconst resultObj = out?.result;\nif (resultObj && typeof resultObj === \"object\") {\n  delete resultObj.OPPORTUNITY;\n  delete resultObj.ACTIVITY;\n  delete resultObj.ACCOUNT;\n  delete resultObj.EMAIL;\n}\n\nreturn out;\n"
