        {
          "metadata": {
            "description": "Passes through current dependent attribute values.",
            "name": "Get Current Dependent Attribute Values",
            "returnType": "object",
            "sourceCode": "const depAttrs = $context.$nodes.DEPENDENT_ATTRIBUTES?.$output?.result || [];\nconst record = $context.$nodes.GET_OBJECT?.$output || {};\n\nconst depSet = new Set((depAttrs || []).filter(Boolean));\n\nconst onlyDependent = Object.fromEntries(\n  Object.entries(record).filter(([k]) => depSet.has(k))\n);\n\nreturn onlyDependent;"
          },
