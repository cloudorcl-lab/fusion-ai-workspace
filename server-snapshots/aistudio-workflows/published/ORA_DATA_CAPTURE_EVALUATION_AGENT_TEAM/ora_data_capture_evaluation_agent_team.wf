        {
          "metadata": {
            "description": "Extracts data-capture attribute names from rules.",
            "name": "Prepare Data Capture AttributeName list",
            "returnType": "array",
            "sourceCode": "const out = $context.$nodes.FETCH_DATA_CAPTURE_RULE.$output || {};\nconst rules = out.items || out.response?.items || [];\n\nconst names = rules.flatMap(rule =>\n    (rule.dataCaptureRuleAttributes?.items || [])\n        .map(a => a.attributeName)\n        .filter(Boolean)\n);\n\nreturn names.map(n => String(n));"
          },
          "diagram": {
            "x": 4606,
            "y": 6057
          },
          "outcomes": {
            "success": "1778131165431"
          },
          "id": "1778131084478",
          "code": "PREPARE_ATTRIBUTE_NAME_LIST",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "description": "",
            "name": "Get Data Capture Attributes MetaData",
            "returnType": "object",
            "sourceCode": "const objectMetadata = $context.$nodes.OBJECT_METADATA.$output;\nconst specifiedAttributeCodes = $context.$nodes.PREPARE_ATTRIBUTE_NAME_LIST.$output.result;\nreturn objectMetadata.items.filter( item => specifiedAttributeCodes.includes( item.AttributeCode));"
          },
          "diagram": {
            "x": 4620,
            "y": 6154
          },
          "outcomes": {
            "success": "1779093166109"
          },
          "id": "1778131165431",
          "code": "GET_DC_ATTRIBUTES_METADATA",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "description": "Detects whether selected attributes include any FCL or DCL types.",
            "name": "Determine if any fcl or dcl  present in data capture rule",
            "sourceCode": "const selectedItems = $context.$nodes.GET_DC_ATTRIBUTES_METADATA.$output?.result || [];\nconst allItems = $context.$nodes.OBJECT_METADATA.$output?.items || [];\n\nconst explicitFclCodes = new Set([\n  \"CurrencyCode\",\n  \"ChampionFlag\",\n  \"ForecastCategory\"\n]);\n\nconst explicitDclCodes = new Set([\n  \"PrimaryCompetitorId\",\n  \"PrimaryCampaignId\",\n  \"KeyContactId\",\n  \"AssetId\",\n  \"IBAssetId\",\n  \"TargetPartyId\",\n  \"PrimaryPartnerId\"\n]);\n\n// START OF METHOD: getType\n\nfunction getType(item) {\n  const attributeCode = item?.AttributeCode || \"\";\n  const attributeDefType = (item?.AttributeDefType || \"\").toUpperCase();\n\n \n  if (attributeDefType === \"FCL\" || explicitFclCodes.has(attributeCode)) {\n    return \"FCL\";\n  }\n\n  \n  if (explicitDclCodes.has(attributeCode)) {\n    return \"DCL\";\n  }\n\n  \n  if (attributeCode.endsWith(\"_Id_c\") && attributeDefType === \"DCL\") {\n    return \"DCL\";\n  }\n\n \n  if (attributeCode.endsWith(\"_c\")) {\n    const idCode = `${attributeCode.slice(0, -2)}_Id_c`;\n    const hasDclId = allItems.some(\n      (it) =>\n        it?.AttributeCode === idCode &&\n        (it?.AttributeDefType || \"\").toUpperCase() === \"DCL\"\n    );\n\n    if (hasDclId) return \"DCL\";\n  }\n\n  return \"Other\";\n}\n\n// END OF METHOD: getType\n\nconst hasFclOrDcl = selectedItems.some((item) => {\n  const type = getType(item);\n  return type === \"FCL\" || type === \"DCL\";\n});\n\nreturn hasFclOrDcl;",
            "returnType": "boolean"
          },
          "diagram": {
            "x": 4534,
            "y": 6355
          },
          "outcomes": {
            "success": "1778131442980"
          },
          "id": "1778131327967",
          "code": "DETERMINE_FCL_OR_DCL_PRESENT",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
