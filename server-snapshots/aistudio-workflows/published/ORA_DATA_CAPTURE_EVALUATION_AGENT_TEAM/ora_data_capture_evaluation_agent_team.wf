                {
                  "metadata": {
                    "description": "Formats LOV entries into LookupCode/Meaning text for prompt enrichment.",
                    "name": "List of lookup codes",
                    "sourceCode": "const lovResp = $context.$nodes.PROCESS_OBJECT_METADATA.DETERMINE_BASE_URL.$output.result\n  ? $context.$nodes.PROCESS_OBJECT_METADATA.LOV.$output\n  : $context.$nodes.PROCESS_OBJECT_METADATA.GET_FSCMRESTAPI_LOV_URL.$output;\n\nconst derive = $context.$nodes.PROCESS_OBJECT_METADATA.DERIVE_LOV_URL.$output.result || {};\nconst attributeCode = derive.attributeCode;\nif (!lovResp?.items || lovResp.items.length === 0) {\n  return { attributecode: attributeCode, lov: [] };\n}\n\nconst firstItem = lovResp.items[0];  \nconst keys = Object.keys(firstItem);\n\n\nlet codeKey, meaningKey;\n\n\nkeys.forEach(key => {\nif (key.endsWith(\"Id\") || key === \"LookupCode\" || key === \"CurrencyCode\" || key === \"ClassCode\" || key === \"TerritoryCode\" ||\n    key === \"PhoneCountryCode\") {\n    codeKey = key;  // this key will represent the \"code\"\n  } else if (key === \"Name\" || key === \"Meaning\" ||  key === \"ClassCodeMeaning\" ||  key === \"TerritoryShortName\") {\n    meaningKey = key;  // this key will represent the \"meaning\"\n  }\n});\n\n\n// Fallbacks for unexpected payload shapes\nif (!codeKey) {\n  codeKey =\n    keys.find((k) => k.endsWith(\"Id\")) ||\n    keys.find((k) => /Code$/i.test(k)) ||\n    keys[0];\n}\nif (!meaningKey) {\n  meaningKey =\n    keys.find((k) => /Meaning$/i.test(k)) ||\n    keys.find((k) => /Name$/i.test(k)) ||\n    keys.find((k) => /ShortName$/i.test(k)) ||\n    \"\";\n}\n\n\nconst formattedItems = lovResp.items.map(item => {\n  return `(LookupCode: ${item[codeKey]} / Meaning: ${item[meaningKey] || ''})`;\n});\n\nreturn {\n  attributecode: attributeCode,\n  lov: formattedItems,\n  attributeType: \"FCL\"  \n};",
                    "returnType": "object"
                  },
                  "diagram": {
                    "x": 3643.0038740386804,
                    "y": 8943.213531482315
                  },
                  "outcomes": {
                    "success": "end_1778132235048"
                  },
