                {
                  "metadata": {
                    "description": "Classifies current attribute as FCL or  DCL",
                    "name": "Determine  Attribute Type",
                    "returnType": "string",
                    "sourceCode": "const currentItem = $context.$nodes.PROCESS_OBJECT_METADATA.$currentItem || {};\n\nconst attributeDefType = currentItem.AttributeDefType || \"\";\nconst attributeCode = currentItem.AttributeCode || \"\";\n\nconst explicitDclCodes = new Set([\n  \"PrimaryCompetitorId\",\n  \"PrimaryCampaignId\",\n  \"KeyContactId\",\n  \"AssetId\",\n  \"IBAssetId\",\n  \"TargetPartyId\",\n  \"PrimaryPartnerId\"\n]);\n\nconst explicitFclCodes = new Set([\n  \"CurrencyCode\",\n  \"ChampionFlag\",\n  \"ForecastCategory\"\n]);\n\nconst allItems = $context.$nodes.OBJECT_METADATA.$output.items || [];\nlet type = \"OTHERS\";\n\n// 1) FCL => FCL\nif (attributeDefType.toUpperCase() === \"FCL\" || explicitFclCodes.has(attributeCode)) {\n  type = \"FCL\";\n}\n// 2) Explicit list => DCL\nelse if (explicitDclCodes.has(attributeCode)) {\n  type = \"DCL\";\n}\n// 3) Ends with _Id_c and current defType is DCL => DCL\nelse if (attributeCode.endsWith(\"_Id_c\")) {\n  if (attributeDefType.toUpperCase() === \"DCL\") {\n    type = \"DCL\";\n  }\n}\n// 4) Ends with _c => check sibling _Id_c has DCL\nelse if (attributeCode.endsWith(\"_c\")) {\n  const idCode = `${attributeCode.slice(0, -2)}_Id_c`;\n\n  const hasDclId = allItems.some(\n    (it) =>\n      it?.AttributeCode === idCode &&\n      (it?.AttributeDefType || \"\").toUpperCase() === \"DCL\"\n  );\n\n  type = hasDclId ? \"DCL\" : \"Other\";\n}\n// 5) everything else => Other\nelse {\n  type = \"OTHERS\";\n}\n\nreturn type;"
                  },
                  "diagram": {
                    "x": 3979.0132956719876,
                    "y": 7931.2516159946945
                  },
                  "outcomes": {
                    "success": "1778135371894"
                  },
                  "id": "1778135262902",
                  "code": "DETERMINE_TYPE",
                  "type": "CODE",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "metadata": {
                    "description": "Routes each attribute to FCL path, DCL path, or skip path.",
                    "name": "Attribute Type Switch"
                  },
                  "diagram": {
                    "x": 3979.0132956719876,
                    "y": 8081.9490781485
                  },
                  "outcomes": {
                    "FCL": "1778135463110",
