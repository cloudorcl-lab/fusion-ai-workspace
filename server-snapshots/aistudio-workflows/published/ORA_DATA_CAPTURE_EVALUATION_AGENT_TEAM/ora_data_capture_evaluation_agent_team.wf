        {
          "metadata": {
            "description": "Maps object code to object API name, updatable entities, and carries puid.",
            "name": "Get Object Attributes",
            "returnType": "object",
            "sourceCode": "let updatableEntities = \"\";\nlet object = \"\";\nconst objectCode =  $context.$nodes.DEFAULT_OBJECT_CODE.$output.result.objectCode;\nconst puid = $context.$triggers.REST.$input.objectPuid ;\n\nif (objectCode === \"Opportunity\") {\n  object = \"opportunities\";\n  updatableEntities = \"('OpportunityEO','RevenueEO')\";\n} else if (objectCode === \"Account\") {\n  object = \"accounts\";\n  updatableEntities = \"('OrganizationDEO','PartyEO','SalesAccountEO')\";\n}\n\nreturn {\n  object,\n  puid,\n  updatableEntities\n};"
          },
