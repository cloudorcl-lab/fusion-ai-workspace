          },
          "outcomes": {
            "true": "1778131534722",
            "false": "1778132756018"
          },
          "id": "1778131442980",
          "code": "IF_FCL_OR_DCL_PRESENT_IN_DATA_CAPTURE",
          "type": "CONDITION",
          "convergenceTargetId": "1778132756018",
          "inputs": [
            {
              "id": "1778131442980_condition",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.DETERMINE_FCL_OR_DCL_PRESENT.$output.result}}"
            }
          ]
        },
        {
          "metadata": {
            "description": "Builds DependsOn attribute list for FCL attributes.",
            "name": "Get DependsOn Attribute list",
            "returnType": "string",
            "sourceCode": "const  data = $context.$nodes.OBJECT_METADATA.$output;\n\nconst  inputAttributeCodes= $context.$nodes.PREPARE_ATTRIBUTE_NAME_LIST.$output.result ;\n\n\n  const dependsOnList = [];\nif (!data?.items || !Array.isArray(data.items) || data.items.length === 0) {\n  return \"\";\n}\n\nconst validAttributeCodes = new Set(data.items.map(item => item.AttributeCode)); \n\n\n  function processAttribute(attributeCode) {\n    const attribute = data.items.find((item) => item.AttributeCode === attributeCode);\n\n   if (!attribute || (attribute.AttributeDefType || \"\").toUpperCase() !== \"FCL\" || !attribute.DependsOn) {\n    return;\n  }\n\n    const dependsOnValues = attribute.DependsOn\n      .split(\",\")\n      .map((x) => x.trim())\n      .filter(Boolean);\n\n    dependsOnValues.forEach((dep) => {\n      if (!dependsOnList.includes(dep)) {\n        dependsOnList.push(dep);\n\n        // if dep itself is an AttributeCode in output, recurse\n        const depItem = data.items.find((item) => item.AttributeCode === dep);\n        if (depItem && depItem.DependsOn) {\n          processAttribute(dep);\n        }\n      }\n    });\n  }\n\n  inputAttributeCodes.forEach((code) => processAttribute(code));\n\nconst validDependsOnList = dependsOnList.filter(dep => validAttributeCodes.has(dep));\n\n\nreturn validDependsOnList.join(\",\");"
          },
          "diagram": {
            "x": 4084.054108016605,
            "y": 6578.239628851439
          },
          "outcomes": {
            "success": "1778131618661"
          },
          "id": "1778131534722",
          "code": "GET_DEPENDS_ON",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "description": "Converts depends-on CSV into an array.",
            "name": "Dependent Attributes array",
            "returnType": "array",
            "sourceCode": "const input = $context.$nodes.GET_DEPENDS_ON.$output.result;\n\n\nconst raw = typeof input === \"string\" ? input : (input?.result || \"\");\n\nconst arr = raw\n  .toString()\n  .split(\",\")\n  .map((s) => s.trim())\n  .filter(Boolean);\n\nreturn arr;"
          },
