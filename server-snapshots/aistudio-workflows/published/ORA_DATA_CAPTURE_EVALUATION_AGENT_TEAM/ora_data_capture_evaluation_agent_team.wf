        {
          "metadata": {
            "description": "Merges loop-derived DCL values including nulls for unresolved DCLs into one object.",
            "name": "Derived dcl attributes",
            "sourceCode": "const arr = Array.isArray($context.$variables.loopOutput)\n  ? $context.$variables.loopOutput\n  : [$context.$variables.loopOutput || []];\n\nconst parsed = arr\n  .map((item) => {\n    try {\n      return typeof item === \"string\" ? JSON.parse(item) : item;\n    } catch {\n      return null;\n    }\n  })\n  .filter((item) => item && item.result);\n\n// Normal DCL results\nconst dclItems = parsed.filter((item) => item.result.attributeType === \"DCL\");\n\n// Error results: \"No value found for DCL attribute <AttributeCode>\"\nconst dclErrorItems = parsed\n  .map((item) => item.result?.error)\n  .filter((err) => typeof err === \"string\")\n  .map((err) => {\n    const m = err.match(/^No value found for DCL attribute\\s+(.+)$/);\n    return m ? { result: { [m[1].trim()]: null } } : null;\n  })\n  .filter(Boolean);\n\nconst merged = [...dclItems, ...dclErrorItems]\n  .filter(\n    (item, index, self) =>\n      index ===\n      self.findIndex(\n        (x) => JSON.stringify(x.result) === JSON.stringify(item.result)\n      )\n  )\n  .reduce((acc, item) => ({ ...acc, ...item.result }), {});\n\ndelete merged.attributeType;\n\nreturn merged;",
            "returnType": "object"
          },
          "diagram": {
            "x": 4096.15411814891,
            "y": 9168.786521066779
          },
          "outcomes": {
            "success": "1778132628383"
          },
          "id": "1778132436459",
          "code": "DERIVED_DCL",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "description": "Collects FCL LOV value lists from loop results.",
            "name": "Collect fcl value list",
            "returnType": "object",
            "sourceCode": "const loopOutput = $context.$nodes.PROCESS_OBJECT_METADATA.$output || [];\n\nconst items = loopOutput\n  .map(s => {\n    try {\n      return typeof s === \"string\" ? JSON.parse(s) : s;\n    } catch {\n      return null;\n    }\n  })\n  .filter(item => item?.result?.attributecode && Array.isArray(item?.result?.lov))\n  .map(item => ({\n    attributeCode: item.result.attributecode,\n    lov: item.result.lov\n  }));\n\nreturn { items };"
          },
          "diagram": {
            "x": 4095.829693144545,
            "y": 9312.883129928874
          },
          "outcomes": {
            "success": "1778132756018"
          },
          "id": "1778132628383",
          "code": "GET_FCL_LOOKUPVALUES",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "description": "Removes already-derived DCL attributes from rules and appends LOV guidance text.",
            "name": "Update Data Capture Rule",
            "returnType": "object",
            "sourceCode": "const dataCaptureResp = $context.$nodes.FETCH_DATA_CAPTURE_RULE.$output;\nconst fclLovList = $context.$nodes.GET_FCL_LOOKUPVALUES?.$output?.result || {};\nconst derivedDcl = $context.$nodes.DERIVED_DCL?.$output?.result || {};\n\n// Get rule items\nconst ruleItems =\n  dataCaptureResp?.items?.[0]?.dataCaptureRuleAttributes?.items || [];\n\n// Get only attribute names from Derived DCL\nconst derivedAttrSet = new Set(\n  Object.keys(derivedDcl).filter(Boolean)\n);\n\n// 1) Remove rules whose attributeName is present in Derived DCL\nconst filteredRuleItems = ruleItems.filter(\n  (rule) => !derivedAttrSet.has(rule?.attributeName)\n);\n\n\nif (dataCaptureResp?.items?.[0]?.dataCaptureRuleAttributes) {\n  dataCaptureResp.items[0].dataCaptureRuleAttributes.items = filteredRuleItems;\n}\n\nconst lovItems = fclLovList?.items || [];\n\n// If lovItems is empty, return filtered rules unchanged\nif (!Array.isArray(lovItems) || lovItems.length === 0) {\n  return dataCaptureResp;\n}\n\n// Build lookup: attributeCode -> lov[]\nconst lovMap = new Map(\n  lovItems\n    .filter((x) => x?.attributeCode && Array.isArray(x?.lov) && x.lov.length > 0)\n    .map((x) => [x.attributeCode, x.lov])\n);\n\n// 2) Append LOV text only for remaining attributes\nfilteredRuleItems.forEach((rule) => {\n  const attr = rule?.attributeName;\n  if (!attr) return;\n\n  const lov = lovMap.get(attr);\n  if (!lov || lov.length === 0) return;\n\n  const lovText = `{${lov.join(\", \")}}`;\n  const appendText = ` The possible values are ${lovText}.`;\n\n  if (!rule.evaluationText?.includes(\"The possible values are\")) {\n    rule.evaluationText = (rule.evaluationText || \"\") + appendText;\n  }\n});\n\nreturn dataCaptureResp;"
          },
          "diagram": {
            "x": 5296.367756548004,
            "y": 9339.634962801838
          },
          "outcomes": {
            "success": "1778133282770"
          },
          "id": "1778132756018",
          "code": "UPDATE_DATA_CAPTURE_RULE",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "description": "Derives final data-capture values from communication context using strict prompt rules.",
            "name": "Runtime datacapture LLM"
          },
          "diagram": {
            "x": 5295.161593062915,
            "y": 9465.369728741447
          },
          "outcomes": {
            "success": "1778133383786"
          },
          "id": "1778133282770",
          "code": "RUNTIMEDATACAPTURELOGIC",
          "type": "LLM",
          "inputs": [
            {
              "id": "1778133282770_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": ""
            },
            {
              "id": "1778133282770_prompt",
              "name": "prompt",
              "type": "string",
              "value": "---------------> Input <---------------\nObject Data, Meeting Notes, General Notes, Emails, Marketing and Sales Activities can be found in:\n{{$context.$nodes.REQUIRED_CONTEXT.$output.result}}\n\nPreviously derived attributes and their values can be found in:\n{{$context.$nodes.FETCH_ENGAGEMENT_INSIGHT_ROW.$output.additionalInsightData}}\n\nData Capture Attributes and their aiInstructions / evaluationText (including any possible value lists) can be found in:\n{{$context.$nodes.UPDATE_DATA_CAPTURE_RULE.$output.result}}\n\n\n\n--------------> COMMUNICATION_HISTORY (Definition) <-------------------\n 1. Combine all content from Object Data, Meeting Notes, General Notes, Emails, Marketing and Sales Activities into a single dataset called COMMUNICATION_HISTORY.\n2. Remove non-semantic elements such as:\n\t- Email signatures\n\t- Disclaimers\n\t- Forwarded/quoted reply blocks\n\t- Greetings, closings, and boilerplate text\n3. Deduplicate identical or near-identical lines.\n4. COMMUNICATION_HISTORY is the only source allowed for deriving attribute values.\n5. If COMMUNICATION_HISTORY has no explicit information for an attribute → return null\n\n-------------> Recency Rules <------------------\n1. Explicit timestamps or dates inside the text\n2. Document-level timestamps (e.g., email date > meeting notes > general notes)\n3. If timestamps are unavailable, later appearance in COMMUNICATION_HISTORY is more recent\n4. If recency cannot be determined when statements conflict → return null\n\n-------------> Explicitness Rules <------------------\nA statement is considered explicit only if:\n\t- It directly states the value or\n\t- It clearly matches synonyms, cues, or patterns listed in the attribute’s aiInstructions / evaluationText.\nIf any interpretation, assumption, or guess would be required → treat as not explicit → return null\n\n\n\n-------------> Your Task <------------------\nFor each data capture attribute:\n1. Strictly analyze COMMUNICATION_HISTORY using the attribute’s aiInstructions / evaluationText.\n2. Follow only explicit statements; do NOT infer, interpret, or guess anything.\n3. Evaluate each attribute independently of all others.\n4. If multiple explicit statements match → choose the most recent using the Recency Rules.\n5. If conflicting statements exist with no determinable recency → return null\n\n\n\n\n---------> Attribute Output Rules <------------\n\nEach attribute's aiInstructions / evaluationText may contain either:\n(A) Defined possible values embedded in the text\n(e.g., “The possible values are {(LookupCode: WON / Meaning: Won), (LookupCode: LOST / Meaning: Lost)}”)\n\nIf so:\n1. Parse all allowed pairs from evaluationText:\n   - code token = LookupCode \n   - display token = Meaning \n2. Match user evidence against display text first (Meaning), and also allow direct LookupCode match\n3. Output ONLY the LookupCode (never the display text) when a match is found.\n4. Return exactly one value.\n5. If no explicit match exists, return null.\n6. Never invent values and never output anything outside the parsed allowed set.\n7. If multiple matches exist, pick the most recent explicit one.\n8. Do NOT output any value not listed in the possible values set of aiInstructions or evaluationText\n\n(B) No possible values included in aiInstructions or evaluationText\n(meaning: no defined value list exists)\nIn that case:\n\t- Treat the attribute as free-form\n\t- Output a reasoning summary (≤100 characters) based strictly on explicit statements\n\t- If no explicit evidence exists → return null\n\n\n-------------------> Output Format (strict JSON only) <--------------------\nOutput only this JSON and nothing else (no commentary before or after).\nInclude only the fields listed in Data Capture Attributes. Do not add any extra attributes.\n\n{\n  \"dataCapture\": {\n    \"opportunities\": {\n      \"<fieldName1>\": \"<fieldValue1>\",\n      \"<fieldName2>\": \"<fieldValue2>\"\n    }\n  }\n}\n\n\n\n---------------> Example (only for reference) <-----------------\n{\n  \"dataCapture\": {\n    \"opportunities\": {\n      \"BudgetStatus_c\": \"Y\",\n      \"CustomerCommit_c\": \"IN_QUARTER\",\n      \"WhyBuyNow_c\": null,\n      \"WhyBuyAnything_c\": \"Their ERP is failing and causing delays\"\n    }\n  }\n}"
            }
          ]
        },
        {
          "metadata": {
            "description": "Merges LLM output with derived DCL and dependent attribute values into final dataCapture.",
            "name": "All derived attributes",
            "returnType": "object",
            "sourceCode": "const llmOutputRaw = $context.$nodes.RUNTIMEDATACAPTURELOGIC?.$output;\nconst derivedDcl = $context.$nodes.DERIVED_DCL?.$output?.result || {};\nconst dependentAttrs = $context.$nodes.GET_CURRENT_DEPENDENT_ATTRIBUTE_VALUES?.$output?.result || {};\nconst currentDataCaptureValues = $context.$nodes.CURRENT_DATA_CAPTURE_ATTRIBUTE_VALUES?.$output?.result || {};\n\n\nconst requiredObject = String(\n  $context.$nodes.OBJECT_ATTRIBUTES?.$output?.result?.object ?? \"\"\n).trim(); // \"opportunities\" / \"accounts\"\n\nconst llmOutput =\n  llmOutputRaw && typeof llmOutputRaw === \"object\" && !Array.isArray(llmOutputRaw)\n    ? llmOutputRaw\n    : {};\n\nconst finalOutput = JSON.parse(JSON.stringify(llmOutput));\n\n\nif (\n  !finalOutput.dataCapture ||\n  typeof finalOutput.dataCapture !== \"object\" ||\n  Array.isArray(finalOutput.dataCapture)\n) {\n  finalOutput.dataCapture = {};\n}\n\n// Find existing object key in LLM output\nconst existingKeys = Object.keys(finalOutput.dataCapture);\nconst existingObjectKey = existingKeys[0];\n\n\nconst objectKey = requiredObject || existingObjectKey || \"opportunities\";\n\n\nif (\n  !finalOutput.dataCapture[objectKey] ||\n  typeof finalOutput.dataCapture[objectKey] !== \"object\" ||\n  Array.isArray(finalOutput.dataCapture[objectKey])\n) {\n  finalOutput.dataCapture[objectKey] = {};\n}\n\n\nif (\n  existingObjectKey &&\n  existingObjectKey !== objectKey &&\n  finalOutput.dataCapture[existingObjectKey] &&\n  typeof finalOutput.dataCapture[existingObjectKey] === \"object\" &&\n  !Array.isArray(finalOutput.dataCapture[existingObjectKey])\n) {\n  Object.assign(\n    finalOutput.dataCapture[objectKey],\n    finalOutput.dataCapture[existingObjectKey]\n  );\n  delete finalOutput.dataCapture[existingObjectKey];\n}\n\nconst target = finalOutput.dataCapture[objectKey];\n\n// Merge all Derived DCL values \nif (\n  derivedDcl &&\n  typeof derivedDcl === \"object\" &&\n  !Array.isArray(derivedDcl) &&\n  Object.keys(derivedDcl).length > 0\n) {\n  Object.assign(target, derivedDcl);\n}\n\n// Merge all dependent attributes \nif (\n  dependentAttrs &&\n  typeof dependentAttrs === \"object\" &&\n  !Array.isArray(dependentAttrs) &&\n  Object.keys(dependentAttrs).length > 0\n) {\n  Object.assign(target, dependentAttrs);\n}\n\nif (\n  currentDataCaptureValues &&\n  typeof currentDataCaptureValues === \"object\" &&\n  !Array.isArray(currentDataCaptureValues)\n) {\n  Object.keys(currentDataCaptureValues).forEach((field) => {\n    const currentVal = currentDataCaptureValues[field];\n    if (field in target && target[field] === null && currentVal !== null && currentVal !== undefined) {\n      delete target[field];\n    }\n  });\n}\n\nfinalOutput.dataCapture[objectKey] = target;\nreturn finalOutput;"
          },
          "diagram": {
            "x": 5295.161593062917,
            "y": 9632.58200278165
          },
          "outcomes": {
            "success": "1778133466153"
          },
          "id": "1778133383786",
          "code": "ALL_DERIVED_ATTRIBUTES",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "description": "Filters final derived attributes to only auto-updatable, non-null fields present in rules.",
            "name": "Get autoUpdatable and not null attributes",
            "returnType": "object",
            "sourceCode": "const dataCapture =\n  $context.$nodes.ALL_DERIVED_ATTRIBUTES?.$output?.result?.dataCapture || {};\n\n\nconst input1 =\n  (dataCapture.opportunities &&\n    Object.keys(dataCapture.opportunities).length > 0\n    ? dataCapture.opportunities\n    : dataCapture.account &&\n      Object.keys(dataCapture.account).length > 0\n    ? dataCapture.account\n    : {});\n\n\nconst out = $context.$nodes.FETCH_DATA_CAPTURE_RULE?.$output || {};\nconst parsed = typeof out === \"string\" ? JSON.parse(out) : out;\n\n\nconst rulesWrapper = parsed.items || [];\n\n\nconst ruleMap = Object.fromEntries(\n  rulesWrapper\n    .flatMap(rule => rule.dataCaptureRuleAttributes?.items || [])\n    .filter(r => r?.attributeName)\n    .map(r => [r.attributeName, r])\n);\n\n\nconst result = Object.fromEntries(\n  Object.entries(input1).filter(([attr, value]) =>\n    ruleMap[attr] &&                        \n    ruleMap[attr]?.autoUpdatableFlag ===true && \n    value !== null &&\n    value !== undefined\n  )\n);\n\nreturn result;",
            "errorNodeId": "1778133638433"
          },
