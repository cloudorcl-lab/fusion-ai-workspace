          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"count\": {\n            \"type\": \"number\"\n        },\n        \"items\": {\n            \"type\": \"array\",\n            \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n                     \"recordId\": {\n                           \"type\": \"string\"\n                      },\n                     \"documentId\": {\n                           \"type\": \"string\"\n                    },\n                  \"title\": {\n                       \"type\": \"string\"\n                   }\n                }\n            }\n        }\n    }\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Need Fetch Article"
          },
          "outcomes": {
