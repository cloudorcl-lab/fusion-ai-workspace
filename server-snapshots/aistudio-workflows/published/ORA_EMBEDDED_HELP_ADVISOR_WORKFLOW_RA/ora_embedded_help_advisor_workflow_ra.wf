          "code": "GET_BEST_MATCHING_ARTICLE",
          "id": "1763166786931",
          "inputs": [
            {
              "id": "1763166812332_1",
              "name": "stripeCd",
              "type": "string",
              "value": "ORA_SVC_CRM"
            },
            {
              "id": "1763166812333_2",
