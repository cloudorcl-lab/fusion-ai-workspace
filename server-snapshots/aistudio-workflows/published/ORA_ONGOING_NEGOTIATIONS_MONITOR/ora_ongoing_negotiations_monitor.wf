        {
          "metadata": {
            "name": "FormatOutputData",
            "returnType": "object",
            "sourceCode": "const stripSupplierNegotiation = (input) => {\n  const STRIP_KEYS = new Set([\"@context\", \"links\"]);\n\n  const clean = (value) => {\n    if (value === null || value === false) return undefined;\n\n    if (Array.isArray(value)) {\n      // keep empty arrays if they existed; just remove elements that became undefined\n      return value.map(clean).filter((v) => v !== undefined);\n    }\n\n    if (value && typeof value === \"object\") {\n      const out = {};\n      for (const [k, v] of Object.entries(value)) {\n        if (STRIP_KEYS.has(k)) continue;\n        const cleaned = clean(v);\n        if (cleaned !== undefined) out[k] = cleaned;\n      }\n      return out;\n    }\n\n    return value;\n  };\n\n  const result = clean(input);\n  return result === undefined ? (Array.isArray(input) ? [] : {}) : result;\n};\n\n/**\n * Return threads that contain at least one unread message.\n *\n * Assumption for this payload:\n * - a message has recipients.items[] with MessageStatusCode\n * - treat anything other than \"MSG_READ\" as unread\n */\nconst extractCommunicationsToReply = (strippedBody) => {\n  const items = Array.isArray(strippedBody?.items) ? strippedBody.items : [];\n\n  const threadsToReply = [];\n\n  for (const negotiation of items) {\n    const threadItems = negotiation?.threads?.items;\n    if (!Array.isArray(threadItems) || threadItems.length === 0) continue;\n\n    const matchingThreads = threadItems.filter((thread) => {\n      const messages = thread?.messages?.items;\n      if (!Array.isArray(messages) || messages.length === 0) return false;\n\n      return messages.some((msg) => {\n        const recipients = msg?.recipients?.items;\n        if (!Array.isArray(recipients) || recipients.length === 0) return false;\n        return recipients.some((r) => r?.MessageStatusCode && r.MessageStatusCode !== \"MSG_READ\");\n      });\n    });\n\n    if (matchingThreads.length > 0) {\n      threadsToReply.push({\n        AuctionHeaderId: negotiation?.AuctionHeaderId,\n        EmailAddress: negotiation?.EmailAddress,\n        Negotiation: negotiation?.Negotiation,\n        NegotiationTitle: negotiation?.NegotiationTitle,\n        threads: {\n          items: matchingThreads,\n          count: matchingThreads.length,\n        },\n      });\n    }\n  }\n\n  return {\n    items: threadsToReply,\n    count: threadsToReply.length,\n  };\n};\n\n\nreturn ({negotiationData: stripSupplierNegotiation( $context.$nodes.GETPROGRESSNEGOTIATIONS.$output.items), communications: extractCommunicationsToReply($context.$nodes.GETPROGRESSNEGOTIATIONS.$output.items)})"
          },
          "outcomes": {
            "success": "1768151871767"
          },
          "code": "FORMATOUTPUTDATA",
          "id": "1769750752969",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
