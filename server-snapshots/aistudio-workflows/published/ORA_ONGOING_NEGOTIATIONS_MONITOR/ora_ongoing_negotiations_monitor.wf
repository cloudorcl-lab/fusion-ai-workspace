        {
          "metadata": {
            "name": "formatItemsQuery",
            "returnType": "string",
            "sourceCode": "const getItemQuery = (items)=>{\nvar itemNumbers = items.map(item=>item.ComponentItemNumber.toString());\nreturn \"('\"+itemNumbers.join(\"' , '\")+\"')\";\n}\nconst items = $context.$nodes.GET_ITEMSTRUCTURES.$output.items;\nconst result = getItemQuery(items)\nreturn result"
          },
          "outcomes": {
            "success": "1768151916377"
          },
          "code": "FORMATITEMSQUERY",
          "convergenceTargetId": "1768151871767",
          "id": "1768310519849",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
