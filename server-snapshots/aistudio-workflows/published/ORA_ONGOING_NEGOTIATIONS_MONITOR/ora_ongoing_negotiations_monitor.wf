          "code": "GETPROGRESSNEGOTIATIONS",
          "convergenceTargetId": "1768151871767",
          "id": "1768151916377",
          "inputs": [
            {
              "id": "1771497282054_1",
              "name": "itemIds",
              "type": "string",
              "value": "{{$context.$nodes.FORMATITEMSQUERY.$output.result}}"
            },
            {
              "id": "1771497282055_2",
              "name": "status",
