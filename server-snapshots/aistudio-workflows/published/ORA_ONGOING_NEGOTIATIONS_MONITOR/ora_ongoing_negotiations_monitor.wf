            "name": "Extract Item and Org",
            "returnType": "object",
            "sourceCode": "const appContext=$context.$triggers.REST.$input.OraAppContext;\nconst values = appContext.split(':');\nlet [itemId,billSequenceId, orgCode,eff] = values;\nif(!itemId && !orgCode){\nthrow new Error(\"Item or Org not found in context\");\n}\nconst filterValues = {\nItemId:`${itemId}`,\nBillSequenceId: `${billSequenceId}`,\nOrganizationCode: `${orgCode}`,\n};\nreturn filterValues ;"
