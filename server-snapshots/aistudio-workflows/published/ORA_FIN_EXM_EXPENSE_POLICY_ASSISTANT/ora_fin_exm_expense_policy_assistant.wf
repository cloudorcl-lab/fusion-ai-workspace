{
  "workflowId": "100002355227094",
  "workflowCode": "ORA_FIN_EXM_EXPENSE_POLICY_ASSISTANT",
  "name": "Expenses Policy Inquiry Assistant",
  "description": "This agent answers employee questions on expense policies, providing clear guidance on eligibility, limits, exceptions, and compliance requirements to help users make policy-compliant expense decisions quickly.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
