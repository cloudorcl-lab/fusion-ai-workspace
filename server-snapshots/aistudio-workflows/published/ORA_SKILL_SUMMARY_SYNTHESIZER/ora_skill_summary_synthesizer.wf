{
  "workflowId": "300000331062513",
  "workflowCode": "ORA_SKILL_SUMMARY_SYNTHESIZER",
  "name": "Skill Summary Synthesizer",
  "description": "Enriches skill data with LLM-generated descriptions and synonyms, producing schema-compliant skill summaries for search and matching use cases.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
