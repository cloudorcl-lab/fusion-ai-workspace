        {
          "metadata": {
            "name": "Clean Up SR Data",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.GET_ESCALATED_SR_DETAILS.$output;\n\nif (data == null) {\n  return [];\n}\n\nconst escalationMap = $context.$nodes.EXTRACT_SR_NUMBERS.$output.result.srMap\nconst resourceData = $context.$nodes.GET_RESOURCE_PARTY_NUMBER.$output \n\nconst myPartyNumber = resourceData?.items?.length > 0 \n  ? resourceData.items[0].PartyNumber \n  : null;\n\n\nconst cleanedData = data.items.map(item => {\n  // Remove @context and @links from top-level attributes\n  delete item[\"@context\"];\n  delete item[\"@links\"];\n\n  const assignToMe = myPartyNumber && item.AssigneeResourceNumber === myPartyNumber;\n  \n  const filteredMessages = item.messages.items\n    .filter(msg => {\n      if (msg.MessageTypeCd === \"ORA_SVC_AI_SYSTEM_NOTE\") {\n        return msg.MessageContent && msg.MessageContent.includes(\"ORA_SERVICE_OPERATIONS_WORKSPACE\");\n\n      } else {\n        return msg.MessageTypeCd === \"ORA_SVC_CUSTOMER_ENTRY\" || \n               msg.MessageTypeCd === \"ORA_SVC_RESPONSE\" || \n               msg.MessageTypeCd === \"ORA_SVC_INTERNAL_NOTE\";\n      }\n    })\n    .map(msg => {\n      // Remove @context and @links from each message\n      delete msg[\"@context\"];\n      delete msg[\"@links\"];\n      return msg;\n    });\n\n \nconst now = Date.now();\nconst srCreation = new Date(item.CreationDate).getTime();\n\nconst srOlderThan24h = now - srCreation > 24 * 60 * 60 * 1000;\n\nconst hasRecentActivity = filteredMessages.some(msg => {\n    const msgTime = new Date(msg.CreationDate).getTime();\n    if (msg.MessageTypeCd === \"ORA_SVC_INTERNAL_NOTE\") {\n      return msgTime >= now - 24 * 60 * 60 * 1000;\n    }\n    if (msg.MessageTypeCd === \"ORA_SVC_RESPONSE\") {\n      if (!assignToMe && msg.CreatedBy === $context.$user.$name) {\n        return false; // ignore my own response if not assigned\n      }\n      return msgTime >= now - 24 * 60 * 60 * 1000;\n    }\n    return false;\n  });\n\n const hasRecentManagerAction = filteredMessages.some(msg =>\n    msg.MessageTypeCd === \"ORA_SVC_AI_SYSTEM_NOTE\" &&\n    msg.MessageContent &&\n    msg.MessageContent.includes(\"ORA_SERVICE_OPERATIONS_WORKSPACE\") &&\n    (msg.MessageContent.includes(\"Reassign\") || msg.MessageContent.includes(\"AddTeamMember\")) &&\n    new Date(msg.CreationDate).getTime() >= now - 24 * 60 * 60 * 1000\n  );\n\n  // Determine lackOfProgress\n  const lackOfProgress = srOlderThan24h && !hasRecentActivity && !hasRecentManagerAction;\n\n\nconst escalationDate = escalationMap[item.SrNumber] || null;\n\nlet escalationElapsed = null;\n\n  if (escalationDate) {\n    const escTime = new Date(escalationDate).getTime();\n    const diffMs = now - escTime;\n\n    const minutes = Math.floor(diffMs / (60 * 1000));\n    const hours = Math.floor(diffMs / (60 * 60 * 1000));\n    const days = Math.floor(diffMs / (24 * 60 * 60 * 1000));\n\n    if (minutes < 60) {\n      escalationElapsed = `${minutes} minute${minutes !== 1 ? 's' : ''} ago`;\n    } else if (hours < 24) {\n      escalationElapsed = `${hours} hour${hours !== 1 ? 's' : ''} ago`;\n    } else {\n      escalationElapsed = `${days} day${days !== 1 ? 's' : ''} ago`;\n    }\n  }\n\n\n\n\n  return {\n    ...item,\n   lackOfProgress,\n   assignToMe,\n   escalationElapsed,\n    messages: {\n      ...item.messages,\n      items: filteredMessages.length > 0 ? filteredMessages : []\n    }\n  };\n});\n\nreturn cleanedData;"
          },
          "outcomes": {
            "success": "1773334308515"
          },
          "code": "CLEAN_UP_SR_DATA",
          "convergenceTargetId": "1773334308515",
          "id": "1773095982841",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Extract New SR Messages",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.CLEAN_UP_SR_DATA.$output.result;\n\nconst cleanedData = data.map(item => {\n  const messages = item.messages?.items || [];\n\n  // Find manager notes\n  const managerNotes = messages.filter(msg =>\n    msg.MessageTypeCd === \"ORA_SVC_AI_SYSTEM_NOTE\" &&\n    msg.MessageContent &&\n    msg.MessageContent.includes(\"ORA_SERVICE_OPERATIONS_WORKSPACE\") &&\n    msg.MessageContent.includes(\"A communication message was sent within the Agentic App by\")\n  );\n\n  // Latest manager note, if any\n  const latestManagerNote = managerNotes.reduce((latest, current) => {\n    if (!latest) return current;\n    return new Date(current.CreationDate) > new Date(latest.CreationDate)\n      ? current\n      : latest;\n  }, null);\n\n  const allowedTypes = [\n    \"ORA_SVC_RESPONSE\",\n    \"ORA_SVC_INTERNAL_NOTE\",\n    \"ORA_SVC_CUSTOMER_ENTRY\"\n  ];\n\n  let filteredMessages = [];\n\n  if (latestManagerNote) {\n    const managerTime = new Date(latestManagerNote.CreationDate).getTime();\n\n    // Pass only new messages after the latest manager note\n    filteredMessages = messages.filter(msg => {\n      const msgTime = new Date(msg.CreationDate).getTime();\n      const type = msg.MessageTypeCd?.trim();\n\n      return msgTime > managerTime && allowedTypes.includes(type);\n    }).map(({ \"@context\": _, \"@links\": __, ...rest }) => rest);\n\n    return {\n      SrNumber: item.SrNumber,\n      messages: {\n        ...item.messages,\n        items: filteredMessages\n      }\n    };\n  }\n\n  // No manager note exists: keep Title, ProblemDescription, and all 3 message types\n  filteredMessages = messages\n    .filter(msg => allowedTypes.includes(msg.MessageTypeCd?.trim()))\n    .map(({ \"@context\": _, \"@links\": __, ...rest }) => rest);\n\n  return {\n    SrNumber: item.SrNumber,\n    Title: item.Title,\n    ProblemDescription: item.ProblemDescription,\n    messages: {\n      ...item.messages,\n      items: filteredMessages\n    }\n  };\n});\n\nreturn cleanedData;"
          },
          "outcomes": {
            "success": "1772758097454"
          },
          "code": "EXTRACT_NEW_SR_MESSAGES",
          "convergenceTargetId": "1773257376134",
          "id": "1773334308515",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Filter SR Requiring Attention"
          },
          "outcomes": {
            "success": "1772764967256"
          },
          "code": "FILTER_SR_REQUIRING_ATTENTION",
          "id": "1772758097454",
          "inputs": [
            {
              "id": "1772758097455_1",
              "name": "prompt",
              "type": "string",
              "value": "Task:\nReview each SR(SrNumber) in the escalated SR details {{$context.$nodes.EXTRACT_NEW_SR_MESSAGES.$output.result}} to determine whether it requires manager attention. If the escalated SR details are empty, return an empty JSON array\n\nAn SR requires manager attention if any of the following conditions are met. Evaluate all conditions sequentially and do not infer anything beyond what is explicitly stated by the customer. For each SR, be sure to explicitly check whether the customer explicitly expresses doubt about the agent. \n\n1: Customer Doubts the Agent: The customer has **explicitly** expressed doubt that the representative/agent understands the issue or can make satisfactory progress.\n2. Customer Questions Urgency Handling: The customer has **explicitly** expressed doubt that the issue is not being handled with the appropriate level of urgency.\n3. Customer Requested Management Response but None Provided: The customer has requested a response from a manager, supervisor, or executive, and no such response has been provided.\n\nImportant Constraints:\n- Verify that all analysis is based only on the details of the specified SrNumber. Do not reference or use information from any other SR.\n- Only consider the three criteria listed above.\n- Do not use any additional assumptions, external context, or inferred conditions.\n- Base the decision strictly on explicit evidence.\n- Do not overanalyze beyond the provided information.\n\nOutput Format:\nReturn all SRs from the input in the following JSON format:\n[\n  {\n    \"SrNumber\": \"<SR1>\",\n    \"Reason\": \"<Concise, natural-language explanation of why this SR requires manager attention, based only on the defined conditions. Include **all** relevant conditions. Do not reference internal attribute names. If the SR does not require manager attention, return an empty string. Explicitly mention if customer explicitly doubts the agent.>\",\n    \"PriorityActionNeeded\": \"<Return true if the customer doubts the agent or questions the urgency handling; otherwise, return false>\",\n     \"ActionCount\": \"<Number of total conditions that currently require attention, based only on the defined conditions above>\"\n  },\n  {\n    \"SrNumber\": \"<SR2>\",\n    \"Reason\": \"<Concise explanation as above>\",\n    \"PriorityActionNeeded\": \"<true or false as above>\",\n    \"ActionCount\": \"<Number of conditions requiring attention>\"\n\n  }\n  // ...additional SRs as applicable\n]"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "SR Requiring Attention",
            "returnType": "object",
            "sourceCode": "const attentionSRs = $context.$nodes.FILTER_SR_REQUIRING_ATTENTION.$output;\nconst compareSRs = $context.$nodes.CLEAN_UP_SR_DATA.$output.result;\n\nconst filteredSRs = compareSRs\n  .map(compareSR => {\n\n     //Remove unwanted system notes\n   const cleanedMessages = (compareSR.messages?.items || []).filter(msg => \n        msg.MessageTypeCd !== \"ORA_SVC_AI_SYSTEM_NOTE\"\n   );\n\n    // Replace messages with cleaned version\n    compareSR = {\n      ...compareSR,\n      messages: {\n        ...compareSR.messages,\n        items: cleanedMessages\n      }\n    };\n\n    // Find existing attention info\n    const attentionSR = attentionSRs.find(attentionSR => attentionSR.SrNumber === compareSR.SrNumber);\n\n    // Start with existing values or defaults\n    let reason = attentionSR?.Reason || \"\";\n    let actionCount = attentionSR?.ActionCount || 0;\n    let priority = attentionSR?.PriorityActionNeeded === true || attentionSR?.PriorityActionNeeded === \"true\";\n\n \n    // Append reason messages if flags are true\n    if (compareSR.lackOfProgress) {\n      reason = reason ? reason + \"; No progress on SR\" : \"No progress on SR\";\n    }\n\n    if (compareSR.assignToMe) {\n      reason = reason ? reason + \"; SR is assigned to you\" : \"SR is assigned to you\";\n    }\n\n   // Only update ActionCount and Priority if PriorityActionNeeded was false\n  if (!priority) {\n    if (compareSR.lackOfProgress || compareSR.assignToMe) {\n      actionCount += 1;\n      priority = true;\n    }\n  }\n\n    return {\n      ...compareSR,\n      Reason: reason,\n      ActionCount: actionCount,\n      PriorityActionNeeded: priority\n    };\n  })\n  // Only keep SRs that currently require attention\n  .filter(sr => sr.ActionCount > 0);\n\n\nconst uniqueAccounts = [\n  ...new Map(\n    filteredSRs\n.filter(sr => sr.AccountPartyUniqueName != null) \n.map(sr => [\n      sr.AccountPartyUniqueName,\n      {\n        AccountPartyUniqueName: sr.AccountPartyUniqueName,\n        AccountPartyNumber: sr.AccountPartyNumber\n      }\n    ])\n  ).values()\n];\n\nconst accountNamesSingle = uniqueAccounts\n  .map(a => `'${a.AccountPartyUniqueName}'`)\n  .join(',');\n\n\nconst accountNamesString = uniqueAccounts\n  .map(a => `\"${a.AccountPartyUniqueName}\"`)\n  .join(',');\n\n\nconst accountNamesPartyNums= uniqueAccounts\n  .map(a => `'${a.AccountPartyNumber}'`)\n  .join(',');\n\n\nconst output = {\n SRDetails: filteredSRs,\n  AccounNames: accountNamesString,\n  AccountNamesSingle: accountNamesSingle,\n  AccountPatryNums: accountNamesPartyNums\n};\n\nreturn output"
          },
          "outcomes": {
            "success": "1773085212092"
          },
          "code": "SR_REQUIRING_ATTENTION",
          "id": "1772764967256",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
