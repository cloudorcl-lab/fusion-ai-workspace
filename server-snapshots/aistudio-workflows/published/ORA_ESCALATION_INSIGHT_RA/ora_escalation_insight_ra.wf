                    "name": "Set Default Email Channel",
                    "returnType": "object",
                    "sourceCode": "const data = $context.$nodes.GET_EMAIL_SUPPORT_CHANNELS.$output.items;\n\n// Find the first where BUOrgId is NOT null\nlet item = data.find(row => row.BUOrgId !== null);\n\nif (!item) {\n    // Fallback: find first where BUOrgId is null\n    item = data.find(row => row.BUOrgId === null);\n}\n\nconst displayName = item ? item.DisplayName : null;\n\nconst srNumber = $context.$nodes.GET_DEFAULT_EMAIL_CHANNEL.$currentItem;\n\nconst data2 = {\n  SRNumber: srNumber,\n  ChannelDisplayName: displayName\n}\n\nreturn data2;"
                  },
