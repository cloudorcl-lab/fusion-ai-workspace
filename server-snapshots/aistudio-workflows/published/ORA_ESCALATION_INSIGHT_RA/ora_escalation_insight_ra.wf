        {
          "metadata": {
            "name": "Escalation Summary"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "ESCALATION_SUMMARY",
          "convergenceTargetId": "1777047221988",
          "id": "1773762516514",
          "inputs": [
            {
              "id": "1773762516515_1",
              "name": "prompt",
              "type": "string",
              "value": "Based on the Service Request (SR) details:\n{{$context.$nodes.PRIORITIZED_SR_REQUIRING_ATTENTION.$output.result.SRDetails[0]}}\n\nWrite a concise internal summary for a Service Manager.\n\nThe summary must follow this format:\n\"The most urgent escalation requiring your attention is <SR number>: [SR summary + reason].\"\n\nRequirements:\n\n- Include a brief description of the escalation\n\n- Clearly state why it is critical (e.g., customer impact, severity, risk, or explicit escalation request)\n\n- Use only the provided SR details (do not make up information)\n\n- Limit to no more than 50 words\n\n- Include the following sentence at the end:\n\"Always summarize escalations first, followed by stalled SRs, in a single paragraph or section. For escalation summaries, start with 'The most urgent escalation requiring your attention is <SR number> [SR summary + reason]'.\""
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "No Escalations Requiring Attention"
          },
          "outcomes": {},
          "code": "NO_ESCALATIONS_REQUIRING_ATTENTION",
          "convergenceTargetId": "end",
          "id": "1777047315636",
          "inputs": [
            {
              "id": "1777047315637_1",
              "name": "returnValue",
              "type": "string",
              "value": "There’s no escalation requiring your attention right now."
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "name": "Form Communication Payload",
            "returnType": "object",
            "sourceCode": "const toEmails = ($context.$nodes.GET_PARAMETERS.$output.result.email || \"\")\n  .split(\",\")\n  .map(email => email.trim())\n  .filter(email => email);\n\nconst ccEmails = ($context.$nodes.GET_PARAMETERS.$output.result.cc || \"\")\n  .split(\",\")\n  .map(email => email.trim())\n  .filter(email => email);\n\nconst channelId = $context.$nodes.GET_EMAIL_CHANNEL_ID.$output.items[0].ChannelId;\n\nconst channelCommunication = [\n  ...toEmails.map(email => ({\n    ChannelId: channelId,\n    RoutingCd: \"ORA_SVC_TO\",\n    PartyViaEndPoint: email\n  })),\n  ...ccEmails.map(email => ({\n    ChannelId: channelId,\n    RoutingCd: \"ORA_SVC_CC\",\n    PartyViaEndPoint: email\n  }))\n];\n\nconst preparedAttachments = $context.$nodes.PREPARE_ATTACHMENT_DATA.$output.result || [];\n\nconst Attachment = preparedAttachments\n  .filter(file => file && file.fileName && file.base64Content)\n  .map(file => ({\n    FileName: file.fileName,\n    FileContents: file.base64Content\n  }));\n\nreturn {\n  MessageTypeCd: \"ORA_SVC_RESPONSE\",\n  StatusCd: \"ORA_SVC_COMMITTED\",\n  Subject: $context.$nodes.GET_PARAMETERS.$output.result.subject,\n  MessageContent: $context.$system.$inputMessage,\n  ChannelTypeCd: \"ORA_SVC_EMAIL\",\n  channelCommunication,\n  Attachment\n};"
          },
          "outcomes": {
            "success": "1769561880459"
          },
          "code": "FORM_COMMUNICATION_PAYLOAD",
          "id": "1777075652102",
          "inputs": [],
