        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_MESSAGES_LIST"
              ],
              "enableActions": false,
              "enableCommunications": false,
              "customNotes": "Set the title of messageListWidget based on the value of \n{{$context.$nodes.PRIORITIZED_SR_REQUIRING_ATTENTION.$output.result.remainingSRCount}} (refer to it as <count>).\n\nRules:\n- If <count> = 0, set the title to:\n  \"No more escalations\".\n- If <count> > 0, Do not populate title, leave it empty. \n\n\nDo not populate the description or subtitle fields; leave them empty."
            }
          },
          "metadata": {
            "name": "Additional SR Requiring Attention"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "ADDITIONAL_SR_REQUIRING_ATTENTION",
          "id": "1773966303362",
          "inputs": [
            {
              "id": "1773966303364_1",
              "name": "prompt",
              "type": "string",
              "value": "Generate a messageListWidget for all the SRs from the following input {{$context.$nodes.PRIORITIZED_SR_REQUIRING_ATTENTION.$output.result.RemainingSRDetails}}.  Ensure the original input order is preserved in the output list.\n\nFor each item in the input, set the following attributes, making sure to include all attributes mentioned below. Do not set status attribute. \n{\n  \"title\": \"<Generate the SR title in this format: <SR Title> (<SRNumber>). For example, if the SR title is 'Solar Inverter Not Exporting Power' and the SR number is 12345, the output should be 'Solar Inverter Not Exporting Power (12345)'.>\",\n   \"subtitle\": \"<AccountPartyUniqueName - 'Tier X' if AccountTier exists; otherwise only show AccountPartyUniqueName. Format AccountTier as 'Tier 1', 'Tier 2', etc. If AccountPartyUniqueName is null, leave subtitle empty.>\"\n   \"summary\": \"<Do not include SR number. In 1–3 concise sentences (maximum 50 words), summarize the issue, focusing on critical or high-impact symptoms and operational risk. Seamlessly incorporate the attention and prioritization reasons from the SR Reason attribute within the sentences so they flow naturally with the issue. Use professional, CSM-facing language. Do not invent new information or include technical details.>\",\n  \"badgeText\": \"<SeverityCdMeaning>\",\n  \"timestamp\": \"<escalationElapsed>\",\n  \"priority\": \"<Set based on SeverityCd Sev1 → alert, Sev2 → warning>\"\n}\n\nReturn only messageListWidget, no extra text."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "SR Requires Resource",
            "returnType": "object",
            "sourceCode": "const prioritizedSRs = ($context.$nodes.PRIORITIZED_SR_REQUIRING_ATTENTION.$output.result.SRDetails || [])\n  .filter(item => item.PriorityActionNeeded === true);\n\nconst escalatedSRData = $context.$nodes.CLEAN_UP_SR_DATA.$output.result || []\nconst now = new Date();\n\n// Build lookup map from SR number → SR data\nconst escalatedMap = new Map(\n  escalatedSRData.map(item => [item.SrNumber, item])\n);\n\nconst srData = {};\n\nprioritizedSRs.forEach(prioritized => {\n  const srNumber = prioritized.SrNumber;\n  const item = escalatedMap.get(srNumber);\n  if (!item) return; // safety check\n\n const actionHistory = (item.messages?.items || [])\n    .filter(msg =>\n      msg.MessageTypeCd === \"ORA_SVC_AI_SYSTEM_NOTE\" &&\n      msg.MessageContent &&\n      msg.MessageContent.includes(\"ORA_SERVICE_OPERATIONS_WORKSPACE\") &&\n      (msg.MessageContent.includes(\"Reassign\") || msg.MessageContent.includes(\"AddTeamMember\"))\n    )\n    .map(msg => {\n      let summary = \"\";\n      let actionTaken = \"\";\n      try {\n        const parsed = JSON.parse(msg.MessageContent);\n        if (parsed.output?.Summary) summary = parsed.output.Summary;\n        if (parsed.ActionTaken) actionTaken = parsed.ActionTaken;\n      } catch (e) {\n        // ignore parsing errors, leave summary/actionTaken empty\n      }\n      return {\n        Summary: summary,\n        ActionTaken: actionTaken,\n        CreationDate: msg.CreationDate\n      };\n    });\n\n  if (actionHistory.length > 0) {\n    const latestMsgDate = actionHistory\n      .map(msg => new Date(msg.CreationDate))\n      .reduce((a, b) => (a > b ? a : b)); \n\n    // Only include SR if latest message > 24h\n    const isOlderThan24h = (now - latestMsgDate) / (1000 * 60 * 60) > 24;\n    if (!isOlderThan24h) return;\n\n    srData[srNumber] = {\n      ActionHistory: actionHistory,\n      LatestMessageTimestamp: latestMsgDate.toISOString()\n    };\n  } else {\n    srData[srNumber] = {\n      ActionHistory: [],\n      LatestMessageTimestamp: \"\"\n    };\n  }\n});\n\n// Check if any SR requires attention\nconst requireResource = Object.keys(srData).length > 0;\n\n\nconst output =  {\n  srData,\n  requireResource\n};\n\n\nreturn output;"
          },
          "outcomes": {
            "success": "1773169479308"
          },
          "code": "SR_REQUIRES_RESOURCE",
          "convergenceTargetId": "1769540034859",
          "id": "1773168464319",
