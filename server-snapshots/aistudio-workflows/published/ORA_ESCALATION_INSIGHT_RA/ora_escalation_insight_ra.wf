          "metadata": {
            "name": "Prepare Attachment Data",
            "returnType": "array",
            "sourceCode": "let result = [];\nconst filesObject = $context.$nodes.READ_ATTACHMENTS.$output?.ORA_CHAT_ATTACHMENTS_RAW_FILECONTENT || {};\n// Initialize an array to hold file info objects\nconst filesArray = [];\n// Iterate over each key in the filesObject\nfor( const fileName in filesObject) {\n  if( filesObject.hasOwnProperty( fileName)) {\n    const fileData = filesObject[ fileName];\n    if( fileData && typeof fileData === \"object\") {\n      // Extract contentType and base64 content\n      \n      const mimeType = fileData.contentType || \"\";\n      const base64Content = fileData.bas64EncodedFileContent || \"\";\n      // Construct the file info object\n      filesArray.push( {\n        type: \"base64\",\n        fileName: fileName,\n        mimeType: mimeType,\n        base64Content: base64Content\n      });\n    }\n  }\n} \nresult = filesArray;\nreturn result;"
          },
