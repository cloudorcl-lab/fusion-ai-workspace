          "metadata": {
            "name": "Check Assignee In Reportees",
            "returnType": "boolean",
            "sourceCode": "const srData = $context.$nodes.GET_SR_INFO.$output;\nconst reportees = $context.$nodes.GET_MY_REPORTEES.$output;\nconst assigneePartyId = srData.items[0]?.AssigneePartyId;\n\nconst isInReportees = reportees.items.some(\n  item => String(item.PartyId) === String(assigneePartyId)\n);\n\nreturn isInReportees;"
          },
          "outcomes": {
            "success": "1776239769820"
          },
          "code": "CHECK_ASSIGNEE_IN_REPORTEES",
          "id": "1776239725445",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
