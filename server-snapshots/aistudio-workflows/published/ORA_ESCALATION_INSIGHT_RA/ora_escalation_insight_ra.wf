        {
          "metadata": {
            "name": "Extract SR Numbers",
            "returnType": "object",
            "sourceCode": "const items = $context.$nodes.GET_ESCALATED_SRS.$output.items;\n\nconst filteredItems = items.filter(item => item.serviceRequest && item.serviceRequest.number);\n\nconst srNumbers = filteredItems.map(item => item.serviceRequest.number);\nconst singleQuoted = srNumbers.map(n => `'${n}'`).join(',');\n\nconst query = `SrNumber IN (${singleQuoted}) and RecordSet = 'ORA_SVC_MY_SUBORD_SRS' and StatusCd not in ('ORA_SVC_RESOLVED','ORA_SVC_CLOSED','ORA_SVC_WAITING')`;\n\nconst srEscalationMap = {};\nfilteredItems.forEach(item => {\n  srEscalationMap[item.serviceRequest.number] = item.escalationDate; \n});\n\nconst output =  {\n  query: query,\n  srMap: srEscalationMap\n};\n\nreturn output;"
          },
          "outcomes": {
            "success": "1769467157038"
          },
          "code": "EXTRACT_SR_NUMBERS",
          "convergenceTargetId": "1769467157038",
          "id": "1769466959828",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
