            "name": "Get New SR Messages",
            "returnType": "object",
            "sourceCode": "const top3SRs = $context.$nodes.PRIORITIZED_SR_REQUIRING_ATTENTION.$output.result.SRDetails;\nconst top3SRNumbers = new Set(top3SRs.map(sr => sr.SrNumber));\n\nconst data = $context.$nodes.EXTRACT_NEW_SR_MESSAGES.$output.result;\nconst simplifiedData = data.map(({ SrNumber, messages }) => ({\n  SrNumber,\n  messages: {\n    items: messages.items\n  }\n}));\n\nreturn simplifiedData.filter(sr => top3SRNumbers.has(sr.SrNumber));"
          },
          "outcomes": {
            "success": "1772753094740"
          },
