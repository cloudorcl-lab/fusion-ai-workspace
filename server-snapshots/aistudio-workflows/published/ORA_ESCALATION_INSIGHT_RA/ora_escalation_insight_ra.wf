                    "sourceCode": "const srNumber = $context.$nodes.GET_DEFAULT_EMAIL_CHANNEL.$currentItem;\nconst channelDisplayName = $context.$nodes.GET_DEFAULT_EMAIL_CHANNEL.GET_LAST_USED_CHANNEL_DISPLAY_NAME.$output.DisplayName;\nconst data = {\n  SRNumber: srNumber,\n  ChannelDisplayName: channelDisplayName\n}\n\nreturn data;"
