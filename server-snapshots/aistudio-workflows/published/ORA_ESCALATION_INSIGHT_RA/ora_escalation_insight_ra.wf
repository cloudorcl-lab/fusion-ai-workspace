        {
          "metadata": {
            "name": "Form Message",
            "returnType": "array",
            "sourceCode": "let reason = JSON.parse($context.$triggers.REST.$input.OraAction).reason\nlet action = JSON.parse($context.$triggers.REST.$input.OraAction).action\nlet recommendedAgent = JSON.parse($context.$triggers.REST.$input.OraAction).assigneeName\nlet current =  JSON.parse($context.$triggers.REST.$input.OraAction).currentAssigneeName\nlet sr = JSON.parse($context.$triggers.REST.$input.OraAction).srNumber\nvar summary;\nvar returnMsg;\nif (action === 'Reassign') {\n   summary = \"Assigned to \" + recommendedAgent + \"\\n\";\n   returnMsg = sr + \" was successfully assigned to \" + recommendedAgent;\n} else {\n   summary = \"Added \" + recommendedAgent + \" to SR team.\\n\";\n   returnMsg = recommendedAgent + \" has been successfully added to the \" + sr + \" team.\";\n}\n\nconst obj = {\n  output: {\n    Summary: summary + \" \" + reason\n  },\n  workflowCode: \"ORA_SERVICE_OPERATIONS_WORKSPACE\",\n  ActionTaken: action\n};\n\n\nconst jsonString = JSON.stringify(obj);\n\nreturn [jsonString, returnMsg];"
          },
          "outcomes": {
            "success": "1775808288342"
          },
          "code": "FORM_MESSAGE",
          "id": "1775808243680",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
