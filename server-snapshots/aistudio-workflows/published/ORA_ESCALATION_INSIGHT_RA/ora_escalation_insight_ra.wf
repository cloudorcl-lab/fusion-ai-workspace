          "inputs": [
            {
              "id": "1772753094742_1",
              "name": "prompt",
              "type": "string",
              "value": "You are given a list of Service Requests (SRs) with their details in {{$context.$nodes.GET_NEW_SR_MESSAGES.$output.result}}.\n\nTask: Identify SRs where ANY of the following conditions are explicitly met:\n\n1. The customer has requested to \"speak to a supervisor\" or similar request for the involvement of management or confirming that management has visibility to the issue.\n2. The customer has expressed doubt that the issue is being treated with the correct urgency.\n3. The customer has expressed doubt that the representative understands the issue or can make satisfactory progress.\n\nBase your decision strictly and only on the content of the SR message.\n\nIf one or more of these requirements are met, output the SR numbers in order of importance (highest priority or urgency first). \n\nOutput format:\n[\n  {\n    \"SRNumber\": \"<SR_Number1>\",\n    \"Reason\": \"<Brief explanation for why this SR needs manager communication>\"\n  },\n  {\n    \"SRNumber\": \"<SR_Number2>\",\n    \"Reason\": \"<Brief explanation for why this SR needs manager communication>\"\n  },\n  // ...add more as appropriate\n]\n\nOutput only this list and nothing else."
            }
          ],
          "type": "LLM"
        },
