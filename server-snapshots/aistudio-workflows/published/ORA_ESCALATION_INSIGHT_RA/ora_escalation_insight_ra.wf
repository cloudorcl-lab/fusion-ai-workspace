            "sourceCode": "let inputData = JSON.parse($context.$nodes.ALLOCATE_RESOURCE.$output.output).result; \n\nconst outputData = inputData.filter(\n    (item) =>\n      Array.isArray(item.RecommendedAgents) && item.RecommendedAgents.length > 0\n  ).map((item) => {\n    const firstAgent = item.RecommendedAgents[0];\n    return {\n      SrNumber: item.ObjectNumber,\n      CurrentAssigneeName: item.CurrentAssigneeName,\n      Reason: item.Reason,\n      Action: item.Action.replace(/\\s+/g, \"\"), // \"Add Team Member\" -> \"AddTeamMember\",\n      RecommendedAgents: item.RecommendedAgents,\n      AgentName: firstAgent.AgentName,\n      AgentPartyId: firstAgent.AgentPartyId,\n    };\n  });\n\n\nreturn outputData;"
          },
