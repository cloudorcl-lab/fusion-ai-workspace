          "metadata": {
            "name": "Get Parameters",
            "returnType": "object",
            "sourceCode": "const input = $context.$triggers.REST.$input.OraCommNonTemplateParamList;\nconst result = {};\n\nif (input && Array.isArray(input)) {\n  for (const item of input) {\n    if (typeof item === 'object' && item !== null && item.id) {\n      switch (item.id) {\n        case 'email':\n          result[\"email\"] = item.value;\n          break;\n        case 'subject':\n          result[\"subject\"] = item.value;\n          break;\n        case 'srNumber':\n          result[\"srNumber\"] = item.value;\n          break;\n        case 'cc':\n          result[\"cc\"] = item.value;\n          break;\n        case 'channelDisplayName':\n          result[\"channelDisplayName\"] = item.value;\n          break;\n      }\n    }\n  }\n}\n\nreturn result;"
          },
