        {
          "metadata": {
            "name": "Show Only SRs With Default Channels",
            "returnType": "object",
            "sourceCode": "const data1 = $context.$nodes.ESCALATION_COMMUNICATION_FILTER.$output;\nconst data2 = $context.$nodes.GET_DEFAULT_EMAIL_CHANNEL.$output;\n\n// Safely parse and normalize data2\nconst parsedData2 = data2\n  .map(item => {\n    try {\n      const parsed = typeof item === 'string' ? JSON.parse(item) : item;\n\n      // Normalize structure (handle wrapped \"result\")\n      const record = parsed.result ? parsed.result : parsed;\n\n      return {\n        SRNumber: record.SRNumber,\n        ChannelDisplayName: record.ChannelDisplayName\n      };\n    } catch (e) {\n      return null;\n    }\n  })\n  .filter(d => d && d.SRNumber && d.ChannelDisplayName);\n\n// Create lookup\nconst channelLookup = Object.fromEntries(\n  parsedData2.map(d => [d.SRNumber, d.ChannelDisplayName])\n);\n\n// Merge only when ChannelDisplayName exists\nconst result = data1\n  .filter(item => channelLookup[item.SRNumber])\n  .map(item => ({\n    ...item,\n    ChannelDisplayName: channelLookup[item.SRNumber]\n  }));\n\nreturn result;"
          },
          "outcomes": {
            "success": "1777017324886"
          },
          "code": "SHOW_ONLY_SRS_WITH_DEFAULT_CHANNELS",
          "convergenceTargetId": "1777316220188",
          "id": "1774293301347",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
