                  "code": "PRJ_PJE_CODE_STRATEGIC_CAPTURE_CHANGE_REQUEST_FAILURE_ITEM",
                  "id": "strategic_capture_failure_item",
                  "inputs": [],
                  "type": "CODE",
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "convergenceTargetId": "strategic_store_failure_items"
                },
                {
                  "metadata": {
                    "name": "Strategic Capture Change Request Response Item",
                    "returnType": "array",
                    "sourceCode": "function parseJsonSafe(value, fallback) {\n  if (typeof value === 'string') {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return fallback;\n    }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\n\nfunction asObject(value) {\n  var parsed = parseJsonSafe(value, null);\n  return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};\n}\n\nfunction firstPresent(values) {\n  for (var i = 0; i < values.length; i++) {\n    if (values[i] !== null && values[i] !== undefined && values[i] !== '') {\n      return values[i];\n    }\n  }\n  return null;\n}\n\nfunction linkFromOutput(data) {\n  data = asObject(data);\n  var projectId = data.ProjectId;\n  var crId = data.ChangeRequestId;\n  if (!projectId || !crId) {\n    return '';\n  }\n  var links = data['@context'] && data['@context'].links;\n  var href = '';\n  if (Array.isArray(links)) {\n    for (var i = 0; i < links.length; i++) {\n      if (links[i] && links[i].rel === 'self') {\n        href = links[i].href || '';\n        break;\n      }\n    }\n  }\n  var host = '';\n  var schemeIdx = href.indexOf('://');\n  if (schemeIdx > 0) {\n    var rest = href.slice(schemeIdx + 3);\n    host = rest.split('/')[0].split(':')[0];\n  }\n  if (!host) {\n    return '';\n  }\n  return 'https://' + host + '/fscmUI/redwood/project-change-management/change-request/edit?project_id=' + projectId + '&crId=' + crId;\n}\n\nvar created = asObject($context.$nodes.PRJ_PJE_LOOP_STRATEGIC_EACH_FILE.PRJ_PJE_BO_FUNCTION_STRATEGIC_POST_CHANGE_REQUEST.$output);\nvar normalized = asObject($context.$nodes.PRJ_PJE_LOOP_STRATEGIC_EACH_FILE.PRJ_PJE_CODE_STRATEGIC_NORMALIZE_CHANGE_REQUEST_PAYLOAD.$output.result);\nvar currentItem = asObject($context.$nodes.PRJ_PJE_LOOP_STRATEGIC_EACH_FILE.$currentItem);\nvar existing = parseJsonSafe($context.$variables.prjPjeVarConvCrDetailsList, []);\nif (!Array.isArray(existing)) {\n  existing = [];\n}\nexisting.push({\n  fileName: currentItem.name || '',\n  status: 'CREATED',\n  ProjectName: firstPresent([created.ProjectName, created.ProjectName_Display, created.Project, normalized.ProjectName, currentItem.ProjectName]),\n  Number: firstPresent([created.Number, created.ChangeRequestNumber, normalized.Number, currentItem.Number]),\n  Name: firstPresent([created.Name, created.ChangeRequestName, normalized.Name, currentItem.Name]),\n  Priority: firstPresent([created.Priority, normalized.Priority, currentItem.Priority]),\n  Reason: firstPresent([created.Reason, created.ChangeReason, created.ChangeReason_Display, created.ChangeReasonCode_Display, normalized.ReasonDisplay, normalized.ChangeReason, normalized.Reason, normalized.ReasonCode, created.ReasonCode, created.ChangeReasonCode, currentItem.Reason]),\n  Description: firstPresent([created.Description, normalized.Description, currentItem.Description]),\n  Justification: firstPresent([created.Justification, normalized.Justification, currentItem.Justification]),\n  ChangeRequestId: created.ChangeRequestId || null,\n  ProjectId: created.ProjectId || null,\n  ChangeRequestLink: linkFromOutput(created),\n  FailureDetail: ''\n});\nreturn existing;"
