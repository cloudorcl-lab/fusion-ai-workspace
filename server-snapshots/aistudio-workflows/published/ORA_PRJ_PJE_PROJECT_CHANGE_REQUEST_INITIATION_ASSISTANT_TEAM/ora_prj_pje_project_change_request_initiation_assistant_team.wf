                {
                  "metadata": {
                    "name": "Strategic Normalize Change Request Payload",
                    "returnType": "object",
                    "sourceCode": "function parseJsonSafe(value, fallback) {\n  if (typeof value === 'string') {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return fallback;\n    }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\n\nfunction asObject(value) {\n  var parsed = parseJsonSafe(value, null);\n  return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};\n}\n\nfunction cleanText(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  var text = String(value).replace(/\\s+/g, ' ').trim();\n  text = text.replace(/^[\\\"'`]+|[\\\"'`]+$/g, '').trim();\n  text = text.replace(/^[\\[\\(]+|[\\]\\)]+$/g, '').trim();\n  text = text.replace(/[.;,]+$/g, '').trim();\n  return text;\n}\n\nfunction latestUserMessage() {\n  try {\n    if ($context.$system && $context.$system.$inputMessage) {\n      return String($context.$system.$inputMessage);\n    }\n  } catch (e) {}\n  try {\n    if ($context.$variables && $context.$variables.prjPjeVarConvLatestUserMessage) {\n      return String($context.$variables.prjPjeVarConvLatestUserMessage);\n    }\n  } catch (ignore) {}\n  return '';\n}\n\nfunction extractExplicitProjectName(message) {\n  var text = String(message || '');\n  var match = text.match(/(?:^|[\\n\\r;])\\s*(?:Project\\s*Name|ProjectName|Project)\\s*:\\s*([^\\n\\r;]+)/i);\n  if (!match || !match[1]) {\n    return '';\n  }\n  return cleanText(match[1]);\n}\n\nvar payload = asObject($context.$nodes.PRJ_PJE_LOOP_STRATEGIC_EACH_FILE.PRJ_PJE_LLM_STRATEGIC_GENERATE_PAYLOAD.$output);\nvar result = {};\nvar fields = ['Description', 'Name', 'Number', 'Reason', 'ProjectName', 'Priority', 'Justification', 'Comments', 'ImpactIfNotImpl'];\nfor (var i = 0; i < fields.length; i++) {\n  var field = fields[i];\n  result[field] = cleanText(payload[field]);\n}\n\nvar explicitProjectName = extractExplicitProjectName(latestUserMessage());\nif (explicitProjectName) {\n  result.ProjectName = explicitProjectName;\n}\n\nresult.Priority = result.Priority ? result.Priority.toUpperCase() : 'MEDIUM';\nif (['HIGH', 'MEDIUM', 'LOW'].indexOf(result.Priority) === -1) {\n  result.Priority = 'MEDIUM';\n}\n\nvar normalizedPayload = result;\nreturn normalizedPayload;"
                  },
