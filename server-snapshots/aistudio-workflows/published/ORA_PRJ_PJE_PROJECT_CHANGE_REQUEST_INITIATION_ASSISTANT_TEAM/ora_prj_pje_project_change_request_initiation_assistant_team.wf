                },
                {
                  "metadata": {
                    "name": "Create Self Reference Link",
                    "returnType": "string",
                    "sourceCode": "var data = $context.$nodes.PRJ_PJE_LOOP_EACH_FILE.PRJ_PJE_BO_FUNCTION_POST_CHANGE_REQUEST.$output ;\n\n  if (!data) return null; \n  const links = data['@context']?.links;\n  const selfHref = Array.isArray(links) ? (links.find(l => l.rel === 'self')?.href) : null;\n  if (!selfHref) return null; \n\n   // Parse protocol and host without regex or URL()\n  const schemeSep = '://';\n  const schemeIdx = selfHref.indexOf(schemeSep);\n  if (schemeIdx <= 0) return null; \n\n  const protocol = selfHref.slice(0, schemeIdx);\n  let rest = selfHref.slice(schemeIdx + schemeSep.length); \n\n  // host[:port] is up to next '/'\n  const slashIdx = rest.indexOf('/');\n  const hostPort = slashIdx >= 0 ? rest.slice(0, slashIdx) : rest;\n  const hostname = hostPort.split(':')[0];\n  const origin = protocol + '//' + hostname; \n\nconst projectId = data.ProjectId ;\nconst crId = data.ChangeRequestId ;\n\nif (!projectId  || !crId) return null;\n\nreturn `${hostname}/fscmUI/redwood/project-change-management/change-request/edit?project_id=${projectId}&crId=${crId}`;"
                  },
                  "outcomes": {
                    "success": "1774003946394"
                  },
                  "code": "PRJ_PJE_CODE_CREATE_SELF_REFERENCE_LINK",
                  "id": "1774003617950",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "Get CR Created",
                    "returnType": "boolean",
                    "sourceCode": "var crId =  $context.$nodes.PRJ_PJE_LOOP_EACH_FILE.PRJ_PJE_BO_FUNCTION_POST_CHANGE_REQUEST.$output.ChangeRequestId;\nif (  crId  !== null && crId !== \"\")\n  return true;\nreturn false;"
                  },
                  "outcomes": {
                    "success": "1774082627713"
                  },
                  "code": "PRJ_PJE_CODE_GET_CR_CREATED",
