          "metadata": {
            "name": "Resolve Strategic Context Details",
            "returnType": "object",
            "sourceCode": "function parseJsonSafe(value, fallback) {\n  if (typeof value === 'string') {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return fallback;\n    }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\n\nfunction asObject(value) {\n  var parsed = parseJsonSafe(value, null);\n  return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};\n}\n\nfunction hasOwn(objectValue, fieldName) {\n  return objectValue && typeof objectValue === 'object' && Object.prototype.hasOwnProperty.call(objectValue, fieldName);\n}\n\nfunction workflowVar(fieldName) {\n  try {\n    if ($context.$variables && hasOwn($context.$variables, fieldName)) {\n      var value = $context.$variables[fieldName];\n      return value === undefined ? null : value;\n    }\n  } catch (e) {}\n  return null;\n}\n\nfunction restInput() {\n  try {\n    if ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input && typeof $context.$triggers.REST.$input === 'object') {\n      return $context.$triggers.REST.$input;\n    }\n  } catch (e) {}\n  return {};\n}\n\nfunction workflowParam(fieldName) {\n  var value = workflowVar(fieldName);\n  if (value !== null && value !== undefined && value !== '') {\n    return value;\n  }\n  try {\n    if ($context.$workflow && hasOwn($context.$workflow, fieldName)) {\n      value = $context.$workflow[fieldName];\n      return value === undefined ? null : value;\n    }\n  } catch (e) {}\n  return null;\n}\n\nfunction firstPresent(values) {\n  for (var i = 0; i < values.length; i++) {\n    if (values[i] !== null && values[i] !== undefined && values[i] !== '') {\n      return values[i];\n    }\n  }\n  return null;\n}\n\nfunction hasAttachmentContent(value) {\n  var objectValue = asObject(value);\n  for (var key in objectValue) {\n    if (!hasOwn(objectValue, key)) {\n      continue;\n    }\n    if (key === 'ORA_CHAT_ATTACHMENTS_RAW_FILECONTENT' || key.indexOf('_contentType') > -1) {\n      continue;\n    }\n    if (objectValue[key] !== null && objectValue[key] !== undefined && String(objectValue[key]).trim() !== '') {\n      return true;\n    }\n  }\n  return false;\n}\n\nfunction firstAttachmentContent(values) {\n  for (var i = 0; i < values.length; i++) {\n    if (hasAttachmentContent(values[i])) {\n      return values[i];\n    }\n  }\n  return null;\n}\n\nfunction currentInputMessage() {\n  try {\n    return $context.$system.$inputMessage || '';\n  } catch (e) {\n    return '';\n  }\n}\n\nvar input = restInput();\nvar activeDetails = asObject(firstPresent([\n  hasOwn(input, 'prjPjeActiveAtomicAgentDetails') ? input.prjPjeActiveAtomicAgentDetails : null,\n  hasOwn(input, 'prjPjfActiveAtomicAgentDetails') ? input.prjPjfActiveAtomicAgentDetails : null,\n  workflowParam('prjPjeActiveAtomicAgentDetails'),\n  workflowParam('prjPjfActiveAtomicAgentDetails'),\n  workflowVar('prjPjeVarConvActiveAtomicAgentDetails'),\n  workflowVar('prjPjfActiveAtomicAgentDetails')\n]));\nvar contextDetails = asObject(activeDetails.contextDetails);\nvar stateDetails = asObject(contextDetails.stateJson);\nfor (var stateKey in stateDetails) {\n  if (hasOwn(stateDetails, stateKey) && !hasOwn(contextDetails, stateKey)) {\n    contextDetails[stateKey] = stateDetails[stateKey];\n  }\n}\n\nvar routingContext = firstPresent([\n  contextDetails.prjPjeVarConvRoutingContext,\n  contextDetails.prjPjeRoutingContext,\n  contextDetails.prjPjfRoutingContext,\n  input.prjPjeRoutingContext,\n  input.prjPjfRoutingContext,\n  input.source,\n  workflowParam('prjPjeRoutingContext'),\n  workflowParam('prjPjfRoutingContext'),\n  workflowParam('source'),\n  workflowVar('prjPjeVarConvRoutingContext'),\n  workflowVar('prjPjfRoutingContext'),\n  workflowVar('source')\n]);\nvar strategicHistory = firstPresent([\n  contextDetails.prjPjeVarConvStrategicAgentChatHistory,\n  contextDetails.prjPjfStrategicAgentChatHistory,\n  input.prjPjeStrategicAgentChatHistory,\n  input.prjPjfStrategicAgentChatHistory,\n  workflowParam('prjPjeStrategicAgentChatHistory'),\n  workflowParam('prjPjfStrategicAgentChatHistory'),\n  workflowVar('prjPjeVarConvStrategicAgentChatHistory')\n]);\nvar attachContent = firstAttachmentContent([\n  input.prjPjeStrategicAttachContent,\n  input.prjPjfStrategicAttachContent,\n  workflowParam('prjPjeStrategicAttachContent'),\n  workflowParam('prjPjfStrategicAttachContent'),\n  contextDetails.prjPjeVarConvStrategicAttachContent,\n  contextDetails.prjPjfStrategicAttachContent,\n  workflowVar('prjPjeVarConvStrategicAttachContent'),\n  workflowVar('prjPjfStrategicAttachContent')\n]);\nfunction isRedwoodRoutingContext(value) {\n  return String(value || '').trim().toLowerCase() === 'redwoodui';\n}\n\nreturn {\n  isRedwoodUI: isRedwoodRoutingContext(routingContext),\n  prjPjeVarConvRoutingContext: routingContext,\n  prjPjeVarConvStrategicAgentChatHistory: strategicHistory,\n  prjPjeVarConvActiveAtomicAgentDetails: activeDetails,\n  prjPjeVarConvStrategicAttachContent: attachContent,\n  prjPjeVarConvLatestUserMessage: firstPresent([contextDetails.prjPjeVarConvLatestUserMessage, contextDetails.EffectiveInputMessage, currentInputMessage()]) || '',\n  prjPjeVarConvWorkflowStage: firstPresent([contextDetails.prjPjeVarConvWorkflowStage, workflowVar('prjPjeVarConvWorkflowStage'), 'NEW_REQUEST']),\n  prjPjeVarConvLatestUserIntent: firstPresent([contextDetails.prjPjeVarConvLatestUserIntent, workflowVar('prjPjeVarConvLatestUserIntent')])\n};"
          },
