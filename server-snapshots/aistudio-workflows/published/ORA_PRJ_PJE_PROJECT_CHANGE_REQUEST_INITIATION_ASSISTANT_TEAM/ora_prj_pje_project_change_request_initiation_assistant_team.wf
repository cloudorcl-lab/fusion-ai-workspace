                    "sourceCode": "var result = {};\nresult[\"documentFileName\"] = $context.$nodes.PRJ_PJE_LOOP_EACH_FILE.$currentItem.name; \nresult[\"documentInBase64\"] = $context.$nodes.PRJ_PJE_LOOP_EACH_FILE.$currentItem.base64; \n\nreturn result;"
