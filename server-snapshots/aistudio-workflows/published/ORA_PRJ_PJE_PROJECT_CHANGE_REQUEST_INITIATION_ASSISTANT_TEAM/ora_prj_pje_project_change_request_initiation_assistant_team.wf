                {
                  "metadata": {
                    "name": "Strategic Capture Change Request Failure Item",
                    "returnType": "array",
                    "sourceCode": "function parseJsonSafe(value, fallback) {\n  if (typeof value === 'string') {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return fallback;\n    }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\n\nfunction asObject(value) {\n  var parsed = parseJsonSafe(value, null);\n  return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};\n}\n\nfunction firstPresent(values) {\n  for (var i = 0; i < values.length; i++) {\n    if (values[i] !== null && values[i] !== undefined && values[i] !== '') {\n      return values[i];\n    }\n  }\n  return null;\n}\n\nfunction normalizeText(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  if (typeof value !== 'string') {\n    try {\n      value = JSON.stringify(value);\n    } catch (e) {\n      value = String(value);\n    }\n  }\n  return value.replace(/<br\\s*\\/?\\s*>/gi, '\\\\n').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\n}\n\nfunction nodeError(code) {\n  try {\n    return $context.$nodes.PRJ_PJE_LOOP_STRATEGIC_EACH_FILE[code].$error;\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction extractErrorDetail(errorValue) {\n  var errorObject = asObject(errorValue);\n  var rawInfo = firstPresent([\n    errorObject.$info,\n    errorObject.info,\n    errorObject.message,\n    errorObject.error,\n    errorObject.detail,\n    errorValue\n  ]);\n  var parsedInfo = parseJsonSafe(rawInfo, null);\n  if (parsedInfo && typeof parsedInfo === 'object') {\n    var details = parsedInfo['o:errorDetails'];\n    if (Array.isArray(details) && details.length) {\n      for (var i = 0; i < details.length; i++) {\n        var detailText = firstPresent([details[i] && details[i].detail, details[i] && details[i].message, details[i] && details[i].title]);\n        if (detailText) {\n          return normalizeText(detailText);\n        }\n      }\n    }\n    var objectDetail = firstPresent([parsedInfo.detail, parsedInfo.message, parsedInfo.title, parsedInfo.error, parsedInfo.cause]);\n    if (objectDetail) {\n      return normalizeText(objectDetail);\n    }\n    return normalizeText(parsedInfo);\n  }\n  return normalizeText(rawInfo);\n}\n\nvar currentItem = asObject($context.$nodes.PRJ_PJE_LOOP_STRATEGIC_EACH_FILE.$currentItem);\nvar normalized = {};\nvar existing = parseJsonSafe($context.$variables.prjPjeVarConvCrDetailsList, []);\nif (!Array.isArray(existing)) {\n  existing = [];\n}\nvar failureDetail = firstPresent([\n  extractErrorDetail(nodeError('PRJ_PJE_BO_FUNCTION_STRATEGIC_POST_CHANGE_REQUEST')),\n  extractErrorDetail(nodeError('PRJ_PJE_BO_FUNCTION_STRATEGIC_CREATE_CR_ATTACHMENT')),\n  'Unable to create the change request for this attachment.'\n]);\nexisting.push({\n  fileName: currentItem.name || '',\n  status: 'FAILED',\n  ProjectName: firstPresent([normalized.ProjectName, currentItem.ProjectName]),\n  Number: firstPresent([normalized.Number, currentItem.Number]),\n  Name: firstPresent([normalized.Name, currentItem.Name]),\n  Priority: firstPresent([normalized.Priority, currentItem.Priority]),\n  Reason: firstPresent([normalized.ReasonDisplay, normalized.ChangeReason, normalized.Reason, currentItem.Reason]),\n  Description: firstPresent([normalized.Description, currentItem.Description]),\n  Justification: firstPresent([normalized.Justification, currentItem.Justification]),\n  ChangeRequestId: null,\n  ProjectId: null,\n  ChangeRequestLink: '',\n  FailureDetail: failureDetail\n});\nreturn existing;"
                  },
