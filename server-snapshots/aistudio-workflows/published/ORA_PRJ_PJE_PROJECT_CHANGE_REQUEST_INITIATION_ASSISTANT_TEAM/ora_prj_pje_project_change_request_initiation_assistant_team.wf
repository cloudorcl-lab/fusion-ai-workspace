          "code": "PRJ_PJE_RETURN_STRATEGIC_PARENT_RESPONSE_ENVELOPE",
          "id": "strategic_1783100000304",
          "inputs": [
            {
              "id": "strategic_1783100000304_1",
              "name": "returnValue",
              "type": "string",
              "value": "{{$context.$nodes.PRJ_PJE_CODE_STRATEGIC_BUILD_PARENT_RESPONSE_ENVELOPE.$output.result.returnValue}}"
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "name": "Strategic Build Parent Response Envelope",
            "returnType": "object",
            "sourceCode": "function stringify(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  if (typeof value === 'string') {\n    return value;\n  }\n  try {\n    return JSON.stringify(value);\n  } catch (e) {\n    return String(value);\n  }\n}\n\nfunction parseJsonSafe(value, fallback) {\n  if (typeof value === 'string') {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return fallback;\n    }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\n\nfunction variable(name) {\n  try {\n    if ($context.$variables && Object.prototype.hasOwnProperty.call($context.$variables, name)) {\n      return $context.$variables[name];\n    }\n  } catch (e) {}\n  return null;\n}\n\nfunction normalizeText(value) {\n  return stringify(value).replace(/<br\\s*\\/?\\s*>/gi, '\\n').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\n}\n\nfunction asArray(value) {\n  var parsed = parseJsonSafe(value, []);\n  return Array.isArray(parsed) ? parsed : [];\n}\n\nfunction asObject(value) {\n  var parsed = parseJsonSafe(value, null);\n  return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};\n}\n\nfunction firstPresent(values) {\n  for (var i = 0; i < values.length; i++) {\n    if (values[i] !== null && values[i] !== undefined && values[i] !== '') {\n      return values[i];\n    }\n  }\n  return null;\n}\n\nfunction textBlock(text, sequence, heading) {\n  var block = {\n    display_type: 'text',\n    display_sequence: sequence,\n    text: text || ''\n  };\n  if (heading) {\n    block.heading = heading;\n  }\n  block.expand = { display: 'true', headerText: heading || 'Summary' };\n  return block;\n}\n\nfunction column(field, headerText, template) {\n  var result = {\n    headerText: headerText,\n    field: field,\n    id: field,\n    resizable: 'enabled'\n  };\n  if (template) {\n    result.template = template;\n  }\n  return result;\n}\n\nfunction relativeLinkValue(text, link) {\n  var label = normalizeText(text);\n  var target = normalizeText(link);\n  if (!label || !target) {\n    return label;\n  }\n  var marker = '/fscmUI/';\n  var markerIndex = target.indexOf(marker);\n  if (markerIndex >= 0) {\n    target = 'fscmUI/' + target.substring(markerIndex + marker.length);\n  } else {\n    target = target.replace(/^https?:\\/\\/[^/]+\\/?/i, '');\n  }\n  target = target.replace(/^\\/+/, '');\n  return '{relativeLink:{url:' + target + ',text:' + label + '}}';\n}\n\nfunction detailValue(item, names) {\n  item = asObject(item);\n  for (var i = 0; i < names.length; i++) {\n    if (item[names[i]] !== null && item[names[i]] !== undefined && String(item[names[i]]).trim() !== '') {\n      return normalizeText(item[names[i]]);\n    }\n  }\n  return '';\n}\n\nfunction addDetailRow(rows, attribute, details) {\n  details = normalizeText(details);\n  if (!details) {\n    return;\n  }\n  rows.push({\n    rowKey: String(rows.length + 1),\n    attribute: attribute,\n    details: details\n  });\n}\n\nfunction itemStatus(item) {\n  item = asObject(item);\n  return normalizeText(item.status) || (item.ChangeRequestId ? 'CREATED' : 'FAILED');\n}\n\nfunction detailsFormBlock(item, sequence, itemIndex, itemCount) {\n  item = asObject(item);\n  var status = itemStatus(item);\n  var rows = [];\n  var fileName = detailValue(item, ['fileName']);\n  if (itemCount > 1 || status !== 'CREATED') {\n    addDetailRow(rows, 'File', fileName || ('Attachment ' + String(itemIndex)));\n    addDetailRow(rows, 'Status', status);\n  }\n  if (status === 'CREATED') {\n    var number = detailValue(item, ['Number', 'ChangeRequestNumber']);\n    var link = detailValue(item, ['ChangeRequestLink']);\n    addDetailRow(rows, 'Project Name', detailValue(item, ['ProjectName', 'ProjectName_Display', 'Project']));\n    addDetailRow(rows, 'Number', relativeLinkValue(firstPresent([number, detailValue(item, ['Name', 'ChangeRequestName']), detailValue(item, ['ChangeRequestId'])]), link));\n    addDetailRow(rows, 'Name', detailValue(item, ['Name', 'ChangeRequestName']));\n    addDetailRow(rows, 'Priority', detailValue(item, ['Priority']));\n    addDetailRow(rows, 'Reason', detailValue(item, ['Reason', 'ChangeReason', 'ChangeReasonCode', 'ReasonCode']));\n    addDetailRow(rows, 'Description', detailValue(item, ['Description']));\n    addDetailRow(rows, 'Justification', detailValue(item, ['Justification']));\n  } else {\n    addDetailRow(rows, 'Details', detailValue(item, ['FailureDetail']) || 'Unable to create the change request for this attachment.');\n  }\n  if (!rows.length) {\n    return null;\n  }\n  return {\n    display_type: 'table',\n    display_sequence: sequence,\n    heading: fileName ? ('Project Change Request details for ' + fileName) : 'Project Change Request details',\n    columns: {\n      items: [\n        column('attribute', 'Fields'),\n        column('details', 'Value', 'deepLinkTemplate')\n      ]\n    },\n    rows: { items: rows },\n    keyAttributes: { items: ['rowKey'] },\n    accessibility: {\n      'aria-label': 'This table lists Project Change Request details as fields and values',\n      'row.accessible-row-header': 'attribute'\n    }\n  };\n}\n\nvar attachmentItems = asArray($context.$nodes.PRJ_PJE_CODE_STRATEGIC_CREATE_FILE_OBJECT.$output.result);\nvar capturedItems = asArray(variable('prjPjeVarConvCrDetailsList'));\nvar missingAttachment = attachmentItems.length === 0;\nvar missingChangeRequestResults = !missingAttachment && capturedItems.length === 0;\nif (missingChangeRequestResults) {\n  for (var attachmentIndex = 0; attachmentIndex < attachmentItems.length; attachmentIndex++) {\n    var attachment = attachmentItems[attachmentIndex] || {};\n    capturedItems.push({\n      fileName: normalizeText(attachment.name || ('Attachment ' + String(attachmentIndex + 1))),\n      status: 'FAILED',\n      ProjectName: '',\n      Number: '',\n      Name: '',\n      Priority: '',\n      Reason: '',\n      Description: '',\n      Justification: '',\n      ChangeRequestId: null,\n      ProjectId: null,\n      ChangeRequestLink: '',\n      FailureDetail: 'Attachment was received, but no change request result was captured for this file.'\n    });\n  }\n}\nvar createdCount = 0;\nvar failedCount = 0;\nfor (var i = 0; i < capturedItems.length; i++) {\n  var status = normalizeText(capturedItems[i] && capturedItems[i].status) || (capturedItems[i] && capturedItems[i].ChangeRequestId ? 'CREATED' : 'FAILED');\n  if (status === 'CREATED') {\n    createdCount++;\n  } else {\n    failedCount++;\n  }\n}\n\nfunction countWord(count) {\n  var words = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];\n  return count >= 0 && count < words.length ? words[count] : String(count);\n}\n\nfunction projectChangeRequestLabel(count) {\n  return countWord(count) + ' Project Change Request' + (count === 1 ? '' : 's');\n}\n\nfunction friendlyAttributeName(attributeName) {\n  var text = normalizeText(attributeName);\n  var labels = {\n    ProjectName: 'project name',\n    ChangeRequestName: 'change request name',\n    ChangeRequestNumber: 'change request number',\n    Priority: 'priority',\n    Description: 'description',\n    Justification: 'justification'\n  };\n  if (labels[text]) {\n    return labels[text];\n  }\n  text = text.replace(/([a-z0-9])([A-Z])/g, '$1 $2').replace(/[_-]+/g, ' ').toLowerCase();\n  return text || 'one of the provided values';\n}\n\nfunction friendlyFailureReason(reason) {\n  var text = normalizeText(reason) || 'the request could not be processed';\n  text = text.replace(/[.]+$/, '');\n  var invalidAttribute = text.match(/value of the attribute\\s+([A-Za-z0-9_ -]+)\\s+isn['’]?t valid/i);\n  if (invalidAttribute && invalidAttribute[1]) {\n    return 'the value of ' + friendlyAttributeName(invalidAttribute[1]) + ' is not valid';\n  }\n  text = text.replace(/\\bisn['’]?t\\b/gi, 'is not');\n  return text.charAt(0).toLowerCase() + text.slice(1);\n}\n\nfunction failureSentence(item, index) {\n  item = asObject(item);\n  var fileName = detailValue(item, ['fileName']) || ('Attachment ' + String(index));\n  return 'Project Change Request creation failed for ' + fileName + ' because ' + friendlyFailureReason(detailValue(item, ['FailureDetail'])) + '.';\n}\n\nfunction failureSummaryText(items) {\n  var failedItems = [];\n  for (var i = 0; i < items.length; i++) {\n    if (itemStatus(items[i]) !== 'CREATED') {\n      failedItems.push(failureSentence(items[i], i + 1));\n    }\n  }\n  return failedItems.join(' ');\n}\n\n\nvar responseText = missingAttachment\n  ? 'Please upload at least one attachment so I can create the Project Change Request.'\n  : (createdCount && failedCount\n    ? (projectChangeRequestLabel(createdCount) + ' created. ' + failureSummaryText(capturedItems))\n    : (createdCount\n      ? (createdCount === 1\n        ? 'Your Project Change Request has been created. Review the details below for the Project Change Request number, project, priority, and link.'\n        : 'Your ' + projectChangeRequestLabel(createdCount) + ' have been created. Review the details below for each Project Change Request number, project, priority, and link.')\n      : failureSummaryText(capturedItems)));\nvar title = missingAttachment ? 'Attachment needed' : (failedCount ? (createdCount ? 'Project Change Request creation results' : 'Project Change Request creation failed') : (createdCount > 1 ? 'Project Change Requests created' : 'Project Change Request created'));\nvar blocks = [textBlock(responseText, 1, missingAttachment ? 'Attachment missing' : 'Summary')];\nif (capturedItems.length && createdCount) {\n  for (var blockIndex = 0; blockIndex < capturedItems.length; blockIndex++) {\n    if (itemStatus(capturedItems[blockIndex]) !== 'CREATED') {\n      continue;\n    }\n    var detailBlock = detailsFormBlock(capturedItems[blockIndex], blocks.length + 1, blockIndex + 1, capturedItems.length);\n    if (detailBlock) {\n      blocks.push(detailBlock);\n    }\n  }\n}\n\nvar content = {\n  agent: 'project_planning_agent',\n  intent: 'change_initiation',\n  schema_version: '1',\n  title: title,\n  description: responseText,\n  topicName: title,\n  agent_response: blocks\n};\nvar stateSnapshot = {\n  prjPjeVarConvRoutingContext: variable('prjPjeVarConvRoutingContext'),\n  prjPjeVarConvStrategicAgentChatHistory: variable('prjPjeVarConvStrategicAgentChatHistory'),\n  prjPjeVarConvStrategicAttachContent: variable('prjPjeVarConvStrategicAttachContent'),\n  prjPjeVarConvLatestUserMessage: variable('prjPjeVarConvLatestUserMessage'),\n  prjPjeVarConvWorkflowStage: missingAttachment ? 'MISSING_ATTACHMENT' : (failedCount ? 'PARTIAL_OR_FAILED' : 'COMPLETED'),\n  prjPjeVarConvLatestUserIntent: missingAttachment ? 'ATTACHMENT_REQUIRED' : 'CREATE_CHANGE_REQUEST',\n  ChangeRequests: capturedItems,\n  ChangeRequestId: capturedItems.length === 1 ? capturedItems[0].ChangeRequestId || null : null,\n  ChangeRequestNumber: capturedItems.length === 1 ? capturedItems[0].Number || null : null,\n  ChangeRequestName: capturedItems.length === 1 ? capturedItems[0].Name || null : null,\n  ProjectName: capturedItems.length === 1 ? capturedItems[0].ProjectName || null : null,\n  AttachmentRequired: missingAttachment,\n  CreatedCount: createdCount,\n  FailedCount: failedCount\n};\nvar contextDetails = {};\nfor (var key in stateSnapshot) {\n  if (Object.prototype.hasOwnProperty.call(stateSnapshot, key) && stateSnapshot[key] !== undefined) {\n    contextDetails[key] = stateSnapshot[key];\n  }\n}\ncontextDetails.stateJson = JSON.stringify(stateSnapshot);\nvar envelope = {\n  redwoodResponse: {\n    type: 'redwood',\n    content: content\n  },\n  atomicAgentDetails: {\n    atomicAgentCode: 'PRJ_PJE_PROJECT_CHANGE_REQUEST_INITIATION_ASSISTANT_STRATEGIC_TEAM_V2_V2',\n    atomicAgentContext: 'Project Change Request Initiation Assistant',\n    contextDetails: contextDetails,\n    filters: null,\n    atomicAgentResponse: content\n  }\n};\nvar returnValue = JSON.stringify(envelope);\nreturn {\n  response: responseText,\n  redwoodResponse: envelope.redwoodResponse,\n  atomicAgentDetails: envelope.atomicAgentDetails,\n  returnValue: returnValue\n};"
          },
          "outcomes": {
            "success": "strategic_1783100000304"
