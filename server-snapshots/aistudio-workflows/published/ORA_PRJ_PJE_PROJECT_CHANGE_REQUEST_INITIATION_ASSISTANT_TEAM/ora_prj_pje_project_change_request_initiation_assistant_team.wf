          "metadata": {
            "name": "Create File Object",
            "returnType": "array",
            "sourceCode": "var input = $context.$nodes.PRJ_PJE_TOOL_INPUT_FILE_PROCESSOR.$output ;\nconst attachments = input.ORA_CHAT_ATTACHMENTS_RAW_FILECONTENT || {};\nconst result = [];\n\nfor (const name of Object.keys(attachments)) {\n// Use only keys that also exist at the top level as plain content\n  if (Object.prototype.hasOwnProperty.call(input, name)) {\n    const content = input[name];\n    const base64 = attachments[name]?.bas64EncodedFileContent || \"\";\n     result.push({\n         name: name,\n        content: content,\n        base64: base64\n     });\n   }\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1775726370696"
          },
          "code": "PRJ_PJE_CODE_CREATE_FILE_OBJECT",
          "id": "1774002805426",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Strategic Create File Object",
            "returnType": "array",
            "sourceCode": "function parseJsonSafe(value, fallback) {\n  if (typeof value === 'string') {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return fallback;\n    }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\n\nfunction asObject(value) {\n  var parsed = parseJsonSafe(value, null);\n  return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};\n}\n\nfunction hasOwn(objectValue, fieldName) {\n  return objectValue && typeof objectValue === 'object' && Object.prototype.hasOwnProperty.call(objectValue, fieldName);\n}\n\nfunction hasText(value) {\n  return value !== null && value !== undefined && String(value).trim() !== '';\n}\n\nfunction toText(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  if (typeof value === 'string') {\n    return value;\n  }\n  try {\n    return JSON.stringify(value);\n  } catch (e) {\n    return String(value);\n  }\n}\n\nfunction utf8ToBase64(value) {\n  var str = toText(value);\n  var bytes = [];\n  for (var i = 0; i < str.length; i++) {\n    var code = str.charCodeAt(i);\n    if (code >= 0xD800 && code <= 0xDBFF && i + 1 < str.length) {\n      var next = str.charCodeAt(i + 1);\n      if (next >= 0xDC00 && next <= 0xDFFF) {\n        code = 0x10000 + ((code - 0xD800) << 10) + (next - 0xDC00);\n        i++;\n      }\n    }\n    if (code < 0x80) {\n      bytes.push(code);\n    } else if (code < 0x800) {\n      bytes.push(0xC0 | (code >> 6));\n      bytes.push(0x80 | (code & 0x3F));\n    } else if (code < 0x10000) {\n      bytes.push(0xE0 | (code >> 12));\n      bytes.push(0x80 | ((code >> 6) & 0x3F));\n      bytes.push(0x80 | (code & 0x3F));\n    } else {\n      bytes.push(0xF0 | (code >> 18));\n      bytes.push(0x80 | ((code >> 12) & 0x3F));\n      bytes.push(0x80 | ((code >> 6) & 0x3F));\n      bytes.push(0x80 | (code & 0x3F));\n    }\n  }\n  var chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';\n  var out = '';\n  for (var j = 0; j < bytes.length; j += 3) {\n    var b1 = bytes[j];\n    var b2 = j + 1 < bytes.length ? bytes[j + 1] : NaN;\n    var b3 = j + 2 < bytes.length ? bytes[j + 2] : NaN;\n    out += chars.charAt(b1 >> 2);\n    out += chars.charAt(((b1 & 3) << 4) | (isNaN(b2) ? 0 : (b2 >> 4)));\n    out += isNaN(b2) ? '=' : chars.charAt(((b2 & 15) << 2) | (isNaN(b3) ? 0 : (b3 >> 6)));\n    out += isNaN(b3) ? '=' : chars.charAt(b3 & 63);\n  }\n  return out;\n}\n\nfunction rawFileBase64(rawFiles, name) {\n  var raw = asObject(rawFiles)[name];\n  raw = asObject(raw);\n  return raw.bas64EncodedFileContent || raw.base64EncodedFileContent || '';\n}\n\nfunction workflowVar(fieldName) {\n  try {\n    if ($context.$variables && hasOwn($context.$variables, fieldName)) {\n      var value = $context.$variables[fieldName];\n      return value === undefined ? null : value;\n    }\n  } catch (e) {}\n  return null;\n}\n\nfunction workflowParam(fieldName) {\n  var value = workflowVar(fieldName);\n  if (value !== null && value !== undefined && value !== '') {\n    return value;\n  }\n  try {\n    if ($context.$workflow && hasOwn($context.$workflow, fieldName)) {\n      value = $context.$workflow[fieldName];\n      return value === undefined ? null : value;\n    }\n  } catch (e) {}\n  return null;\n}\n\nfunction restInput() {\n  try {\n    if ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input && typeof $context.$triggers.REST.$input === 'object') {\n      return $context.$triggers.REST.$input;\n    }\n  } catch (e) {}\n  return {};\n}\n\nfunction addStrategicAttachments(result, added, strategic) {\n  strategic = asObject(strategic);\n  if (hasOwn(strategic, 'prjPjeStrategicAttachContent') || hasOwn(strategic, 'prjPjfStrategicAttachContent') || hasOwn(strategic, 'prjPjeVarConvStrategicAttachContent') || hasOwn(strategic, 'prjPjfStrategicAttachContent')) {\n    addStrategicAttachments(result, added, strategic.prjPjeStrategicAttachContent);\n    addStrategicAttachments(result, added, strategic.prjPjfStrategicAttachContent);\n    addStrategicAttachments(result, added, strategic.prjPjeVarConvStrategicAttachContent);\n    addStrategicAttachments(result, added, strategic.prjPjfStrategicAttachContent);\n    return;\n  }\n  var strategicRawFiles = asObject(strategic.ORA_CHAT_ATTACHMENTS_RAW_FILECONTENT);\n  for (var strategicName in strategic) {\n    if (!hasOwn(strategic, strategicName)) {\n      continue;\n    }\n    if (strategicName === 'ORA_CHAT_ATTACHMENTS_RAW_FILECONTENT' || strategicName.indexOf('_contentType') > -1 || added[strategicName]) {\n      continue;\n    }\n    var strategicContent = toText(strategic[strategicName]);\n    if (!hasText(strategicContent)) {\n      continue;\n    }\n    var strategicBase64 = rawFileBase64(strategicRawFiles, strategicName) || utf8ToBase64(strategicContent);\n    result.push({\n      name: strategicName,\n      content: strategicContent,\n      base64: strategicBase64,\n      contentType: strategic[strategicName + '_contentType'] || 'text/plain',\n      preExtracted: true,\n      source: 'strategic'\n    });\n    added[strategicName] = true;\n  }\n}\n\nvar result = [];\nvar added = {};\nvar runtimeInput = restInput();\nvar strategicCandidates = [\n  $context.$variables.prjPjeVarConvStrategicAttachContent,\n  runtimeInput.prjPjeStrategicAttachContent,\n  runtimeInput.prjPjfStrategicAttachContent,\n  workflowParam('prjPjeStrategicAttachContent'),\n  workflowParam('prjPjfStrategicAttachContent'),\n  workflowParam('prjPjeVarConvStrategicAttachContent'),\n  workflowParam('prjPjfStrategicAttachContent')\n];\nfor (var i = 0; i < strategicCandidates.length; i++) {\n  addStrategicAttachments(result, added, strategicCandidates[i]);\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "strategic_1775726370696"
          },
