            "name": "Resolve Route",
            "returnType": "object",
            "sourceCode": "function objectOrEmpty(value) {\n  return value && typeof value === 'object' ? value : {};\n}\n\nfunction isSingleProjectReplacement(messageText) {\n  var message = String(messageText || '').trim();\n  var lower = message.toLowerCase();\n\n  if (!/\\breplace\\b/.test(lower) || !/\\bwith\\b/.test(lower)) {\n    return false;\n  }\n  if (/\\bacross\\s+(?:all\\s+)?(?:my\\s+)?projects\\b|\\ball\\s+my\\s+projects\\b|\\ball\\s+projects\\b/.test(lower)) {\n    return false;\n  }\n\n  return /^(?:in|for)\\s+.+?\\s+replace\\s+(?:the\\s+)?(?:planning\\s+)?(?:resource|employee|person)?\\s*.+?\\s+with\\s+.+?(?=\\s+(?:for\\s+all\\s+(?:impacted\\s+)?(?:assignments|tasks)|all\\s+(?:impacted\\s+)?(?:assignments|tasks)|from|effective|starting|as\\s+of)\\b|$)/i.test(message)\n    || /^replace\\s+(?:the\\s+)?(?:planning\\s+)?(?:resource|employee|person)?\\s*.+?\\s+with\\s+.+?\\s+(?:in|on)\\s+.+?(?=\\s+(?:for\\s+all\\s+(?:impacted\\s+)?(?:assignments|tasks)|all\\s+(?:impacted\\s+)?(?:assignments|tasks)|from|effective|starting|as\\s+of|across)\\b|$)/i.test(message);\n}\n\nvar resolvedNode = objectOrEmpty(objectOrEmpty($context.$nodes).PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_RESOLVE_FORWARDED_INPUT);\nvar resolvedOutput = objectOrEmpty(resolvedNode.$output);\nvar resolved = objectOrEmpty(resolvedOutput.result);\nvar message = String(resolved.message || '').trim();\nvar lower = message.toLowerCase();\nvar outerState = resolved.outerState && typeof resolved.outerState === 'object' ? resolved.outerState : {};\nvar previousChildState = {};\nvar priorIntent = '';\nvar priorStart = '';\nvar priorEnd = '';\nvar activePrior = false;\nvar freshIntent = false;\nvar routeKey = 'OUT_OF_SCOPE';\nvar isAcrossProjects = false;\nvar isReplacement = false;\nvar hasReplaceWith = false;\nvar singleProjectReplacement = isSingleProjectReplacement(message);\n\nif (typeof resolved.childStateJson === 'string' && String(resolved.childStateJson || '').trim() !== '') {\n  try {\n    previousChildState = JSON.parse(resolved.childStateJson) || {};\n  } catch (ignore1) {\n    previousChildState = {};\n  }\n}\n\npriorIntent = String(previousChildState.Intent || outerState.Intent || '').trim();\npriorStart = String(previousChildState.INTENT_START || outerState.INTENT_START || '').trim();\npriorEnd = String(previousChildState.INTENT_END || outerState.INTENT_END || '').trim();\nactivePrior = priorStart === 'Y' && priorEnd !== 'Y' && priorIntent !== '';\nfreshIntent = /^(replace\\b|(?:in|for)\\s+.+?\\s+replace\\b|i\\s+want\\s+to\\s+replace\\b|please\\s+replace\\b|need\\s+to\\s+replace\\b|i\\s+want\\s+to\\s+do\\s+detail\\s+planning\\b)/i.test(message);\nisAcrossProjects = /\\bacross\\s+(?:all\\s+)?(?:my\\s+)?projects\\b|\\ball\\s+my\\s+projects\\b|\\ball\\s+projects\\b/.test(lower);\nisReplacement = /\\breplace\\b/.test(lower) || /\\bi\\s+want\\s+to\\s+do\\s+detail\\s+planning\\b/.test(lower);\nhasReplaceWith = /\\breplace\\b/.test(lower) && /\\bwith\\b/.test(lower);\n\nif (activePrior && !freshIntent) {\n  if (priorIntent === 'REPLACE_RESOURCE_ACROSS_ALL_PROJECTS') {\n    routeKey = 'USECASE2';\n  } else if (priorIntent === 'REPLACE_UNAVAILABLE_RESOURCE' || priorIntent === 'REPLACE_ROLE_WITH_NAMED_PERSON' || priorIntent === 'REPLACE_ALL_ROLES_WITH_NAMED_PERSONS') {\n    routeKey = 'USECASE1';\n  }\n} else if (isReplacement && isAcrossProjects) {\n  routeKey = 'USECASE2';\n} else if (singleProjectReplacement || hasReplaceWith || /\\breplace\\s+all\\s+roles\\b/.test(lower) || /\\breplace\\s+(?:a|the)?\\s*role\\b/.test(lower) || /\\bi\\s+want\\s+to\\s+do\\s+detail\\s+planning\\b/.test(lower)) {\n  routeKey = 'USECASE1';\n}\n\nvar result = {\n  routeKey: routeKey\n};\n\nreturn result;\n"
