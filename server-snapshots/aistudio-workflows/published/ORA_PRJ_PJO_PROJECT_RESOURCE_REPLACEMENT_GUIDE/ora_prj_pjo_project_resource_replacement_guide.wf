            "name": "Resolve Forwarded Input",
            "returnType": "object",
            "sourceCode": "function text(value) {\n  return String(value == null ? '' : value);\n}\n\nfunction present(value) {\n  return value !== undefined && value !== null && text(value).trim() !== '';\n}\n\nfunction objectOrEmpty(value) {\n  return value && typeof value === 'object' ? value : {};\n}\n\nfunction getMessageCandidate() {\n  var workflowInput = objectOrEmpty($context.$input);\n  var triggerInput = objectOrEmpty(objectOrEmpty(objectOrEmpty($context.$triggers).REST).$input);\n  var contextParameters = objectOrEmpty($context.$parameters);\n  var plainParameters = objectOrEmpty($context.parameters);\n  var workflowContext = objectOrEmpty($context.$workflow);\n  var workflowParameters = objectOrEmpty(workflowContext.parameters);\n  var workflowDollarParameters = objectOrEmpty(workflowContext.$parameters);\n  var systemContext = objectOrEmpty($context.$system);\n  var systemParameters = objectOrEmpty(systemContext.$parameters);\n  var systemPlainParameters = objectOrEmpty(systemContext.parameters);\n  var systemInput = objectOrEmpty(systemContext.$input);\n  var systemInputParameters = objectOrEmpty(systemContext.$inputParameters);\n  var requestParameters = objectOrEmpty(objectOrEmpty($context.$request).parameters);\n  var candidates = [\n    workflowInput.message,\n    workflowInput.Message,\n    contextParameters.message,\n    contextParameters.Message,\n    plainParameters.message,\n    plainParameters.Message,\n    workflowParameters.message,\n    workflowParameters.Message,\n    workflowDollarParameters.message,\n    workflowDollarParameters.Message,\n    systemParameters.message,\n    systemParameters.Message,\n    systemPlainParameters.message,\n    systemPlainParameters.Message,\n    systemInput.message,\n    systemInput.Message,\n    systemInputParameters.message,\n    systemInputParameters.Message,\n    requestParameters.message,\n    requestParameters.Message,\n    triggerInput.message,\n    triggerInput.Message,\n    systemContext.$inputMessage\n  ];\n\n  for (var i = 0; i < candidates.length; i++) {\n    if (present(candidates[i])) {\n      return candidates[i];\n    }\n  }\n\n  return '';\n}\n\nvar rawInput = getMessageCandidate();\nvar raw = typeof rawInput === 'string' ? rawInput : ((rawInput && typeof rawInput === 'object') ? JSON.stringify(rawInput) : text(rawInput));\nvar candidate = text(raw).trim();\nvar msg = raw;\nvar env = (rawInput && typeof rawInput === 'object' && !Array.isArray(rawInput)) ? rawInput : null;\nvar parsed = null;\nvar outerState = {};\nvar hasState = false;\nvar childStateJson = '';\n\nif (!env && candidate !== '') {\n  try {\n    parsed = JSON.parse(candidate);\n    if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {\n      env = parsed;\n    } else if (typeof parsed === 'string') {\n      msg = parsed;\n      parsed = text(parsed).trim();\n      if (parsed && parsed.charAt(0) === '{') {\n        try {\n          env = JSON.parse(parsed);\n        } catch (ignore1) {}\n      }\n    }\n  } catch (ignore0) {}\n}\n\nif (env && env.__codexStateEnvelope === true && present(env.message)) {\n  msg = text(env.message);\n  if (env.stateJson && typeof env.stateJson === 'object') {\n    outerState = env.stateJson;\n    hasState = true;\n  } else if (typeof env.stateJson === 'string' && present(env.stateJson)) {\n    try {\n      outerState = JSON.parse(env.stateJson) || {};\n      hasState = !!outerState && typeof outerState === 'object';\n    } catch (ignore2) {\n      outerState = {};\n      hasState = false;\n    }\n  }\n} else if (env && present(env.message)) {\n  msg = text(env.message);\n}\n\nchildStateJson = outerState.ReplacementAssistantStateJson && typeof outerState.ReplacementAssistantStateJson === 'object'\n  ? JSON.stringify(outerState.ReplacementAssistantStateJson)\n  : text(outerState.ReplacementAssistantStateJson || '');\n\nif (!childStateJson && outerState && typeof outerState === 'object' && (present(outerState.Intent) || present(outerState.ReplacementStage) || present(outerState.TaskOptionsJson))) {\n  childStateJson = JSON.stringify(outerState);\n}\n\nvar result = {\n  message: text(msg).trim(),\n  hasState: hasState,\n  outerState: outerState,\n  childStateJson: childStateJson\n};\n\nreturn result;"
