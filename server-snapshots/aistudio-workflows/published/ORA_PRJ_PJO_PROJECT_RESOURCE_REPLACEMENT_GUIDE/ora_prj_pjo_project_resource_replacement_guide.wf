            "errorNodeId": "1769000000008",
            "name": "Build Child Request V3",
            "returnType": "object",
            "sourceCode": "var nodes = $context.$nodes || {};\nvar resolvedNode = nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_RESOLVE_FORWARDED_INPUT || {};\nvar resolvedOutput = resolvedNode.$output || {};\nvar resolved = resolvedOutput.result || {};\nvar existingStateText = typeof resolved.childStateJson === 'string' ? String(resolved.childStateJson || '').trim() : '';\nvar result = {\n  childMessage: String(resolved.message || '').trim()\n};\n\nif (existingStateText) {\n  var outerState = resolved.outerState && typeof resolved.outerState === 'object' ? resolved.outerState : {};\n  var routeNode = nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_RESOLVE_ROUTE || {};\n  var routeOutput = routeNode.$output || {};\n  var routeResult = routeOutput.result || {};\n  var route = String(routeResult.routeKey || 'OUT_OF_SCOPE');\n  var defaultIntent = route === 'USECASE2' ? 'REPLACE_RESOURCE_ACROSS_ALL_PROJECTS' : 'REPLACE_UNAVAILABLE_RESOURCE';\n  var state = {};\n\n  try {\n    state = JSON.parse(existingStateText) || {};\n  } catch (ignore1) {\n    state = {};\n  }\n\n  if (route === 'USECASE2') {\n    state.Intent = 'REPLACE_RESOURCE_ACROSS_ALL_PROJECTS';\n  } else {\n    state.Intent = String(state.Intent || defaultIntent);\n  }\n\n  state.IntentReason = String(state.IntentReason || 'FORWARDED_BY_PROJECT_RESOURCE_REPLACEMENT_ASSISTANT');\n  state.ProjectName = String(state.ProjectName || outerState.ProjectName || '');\n  state.ResourceName = String(state.ResourceName || outerState.ResourceName || '');\n  state.ReplacementResourceName = String(state.ReplacementResourceName || outerState.ReplacementResourceName || '');\n  state.RoleName = String(state.RoleName || outerState.RoleName || '');\n  state.UnavailabilityDate = String(state.UnavailabilityDate || outerState.UnavailabilityDate || '');\n  state.INTENT_START = String(state.INTENT_START || 'Y');\n  state.INTENT_END = String(state.INTENT_END || 'N');\n\n  if (state.PendingAction === undefined) {\n    state.PendingAction = String(outerState.PendingAction || '');\n  }\n  if (state.PendingReplacementItemsJson === undefined) {\n    state.PendingReplacementItemsJson = String(outerState.PendingReplacementItemsJson || '[]');\n  }\n  if (state.PendingProjectName === undefined) {\n    state.PendingProjectName = String(outerState.PendingProjectName || '');\n  }\n  if (state.PendingOldResourceName === undefined) {\n    state.PendingOldResourceName = String(outerState.PendingOldResourceName || '');\n  }\n  if (state.PendingNewResourceName === undefined) {\n    state.PendingNewResourceName = String(outerState.PendingNewResourceName || '');\n  }\n  if (state.PendingUnavailabilityDate === undefined) {\n    state.PendingUnavailabilityDate = String(outerState.PendingUnavailabilityDate || '');\n  }\n\n  result = {\n    childMessage: JSON.stringify({\n      __codexStateEnvelope: true,\n      message: String(resolved.message || '').trim(),\n      stateJson: JSON.stringify(state)\n    })\n  };\n}\n\nreturn result;"
