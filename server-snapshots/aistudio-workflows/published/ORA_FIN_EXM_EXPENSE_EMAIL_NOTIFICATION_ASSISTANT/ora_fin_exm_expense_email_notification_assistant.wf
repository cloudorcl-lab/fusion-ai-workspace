        {
          "metadata": {
            "name": "generatePayloadGetMessages",
            "returnType": "object",
            "sourceCode": "let channel = $context.$triggers.REST.$input.channel;\n\nlet filter;\nlet subTypes;\n\nif (channel === \"B2B_CC\") {\n    filter = `(sourceTypeCode='MESSAGE' and id='${$context.$triggers.REST.$input.partnerExpenseId}') or (sourceTypeCode='B2B_CC' and id='${$context.$triggers.REST.$input.partnerExpenseId}')`;\n\n    subTypes = {\n        \"MESSAGE\": {\n            \"fields\": [\n                \"systemInformation\",\n                \"partnerExpenseOutcome\",\n                \"outcomeSubReason\",\n                \"statusCode\",\n                \"stageStatus\"\n            ]\n        },\n        \"B2B_CC\": {\n            \"fields\": [\n                \"creditCardTransactionIdentifier\",\n                \"creditCardNetworkReferenceNumber\",\n                \"cardIdentifier\",\n                \"companyIdentifier\",\n                \"requestIdentifier\",\n                \"systemInformation\"\n            ]\n        }\n    };\n} else {\n    filter = `(sourceTypeCode='MESSAGE' and id='${$context.$triggers.REST.$input.partnerExpenseId}') or (sourceTypeCode='RECEIPT' and partnerExpenseReferenceId='${$context.$triggers.REST.$input.partnerExpenseId}')`;\n\n    subTypes = {\n        \"MESSAGE\": {\n            \"fields\": [\n                \"systemInformation\",\n                \"partnerExpenseOutcome\",\n                \"outcomeSubReason\",\n                \"statusCode\",\n                \"stageStatus\"\n            ]\n        },\n        \"RECEIPT\": {\n            \"fields\": [\n                \"receiptAmount\"\n            ],\n            \"accessors\": {\n                \"receiptCurrency\": {\n                    \"fields\": [\"currencyCode\"]\n                },\n                \"expenseType\": {\n                    \"fields\": [\n                        \"name\"\n                    ]\n                },\n                \"businessUnit\": {\n                    \"fields\": [\n                        \"id\"\n                    ]\n                }\n            }\n        }\n    };\n}\n\nlet payload = {\n    \"fields\": [\n        \"id\",\n        \"partnerExpenseReferenceId\"\n    ],\n    \"accessors\": {\n        \"person\": {\n            \"accessors\": {\n                \"emails\": {\n                    \"fields\": [\n                        \"emailAddress\",\n                        \"primaryFlag\"\n                    ]\n                },\n                \"names\": {\n                    \"fields\": [\n                        \"displayName\"\n                    ]\n                }\n            }\n        },\n        \"preparer\": {\n            \"accessors\": {\n                \"emails\": {\n                    \"fields\": [\n                        \"emailAddress\",\n                        \"primaryFlag\"\n                    ]\n                },\n                \"names\": {\n                    \"fields\": [\n                        \"displayName\"\n                    ]\n                }\n            }\n        }\n    },\n    \"collection\": {\n        \"filter\": filter,\n        \"sortBy\": [\n            {\n                \"id\": \"desc\"\n            }\n        ]\n    },\n    \"subTypes\": subTypes\n};\n\nreturn payload;"
          },
          "outcomes": {
            "success": "1769476851279"
          },
          "code": "GENERATEPAYLOADGETMESSAGES",
