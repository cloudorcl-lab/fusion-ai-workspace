        {
          "metadata": {
            "name": "Generate Email Content Prompt Input",
            "returnType": "object",
            "sourceCode": "const summarizedData = $context?.$triggers?.REST?.$input?.summarizedData || {};\n\nconst isStr = (value) => typeof value === \"string\" && value.trim() !== \"\";\n\nconst norm = (value) => (isStr(value) ? value.trim() : \"\");\n\nconst joinNonEmpty = (values) => values.filter(isStr).join(\"\\n\");\nconst splitNonEmptyLines = (value) => String(value || \"\").split(\"\\n\").map((line) => line.trim()).filter(Boolean);\n\nconst isStandaloneAppGuidance = (line) => {\n  const normalized = norm(line);\n  if (!normalized) return false;\n  if (/^reply with\\b/i.test(normalized)) return false;\n  if (/^\\d+\\.\\s/.test(normalized)) return false;\n\n  return /^(go to (oracle expenses|the expenses application)\\b)/i.test(normalized);\n};\n\nconst sectionSummaries = {\n  acknowledgements: norm(summarizedData?.acknowledgements?.summary),\n  defaults: norm(summarizedData?.defaults?.summary),\n  failures: norm(summarizedData?.failures?.summary),\n  openIssues: norm(summarizedData?.openIssues?.summary),\n  recommendations: norm(summarizedData?.recommendations?.summary)\n};\n\nconst failureLines = splitNonEmptyLines(sectionSummaries.failures);\nconst openIssueLines = splitNonEmptyLines(sectionSummaries.openIssues);\n\nconst middleFailureLines = failureLines.filter((line) => !isStandaloneAppGuidance(line));\nconst remainingOpenIssueLines = openIssueLines.filter((line) => !isStandaloneAppGuidance(line));\nconst trailingGuidanceLines = [...failureLines, ...openIssueLines].filter(isStandaloneAppGuidance);\n\nconst preparedCallToAction = {\n  acknowledgements: sectionSummaries.acknowledgements,\n  defaults: sectionSummaries.defaults,\n  failures: joinNonEmpty(middleFailureLines),\n  openIssues: joinNonEmpty(remainingOpenIssueLines),\n  recommendations: sectionSummaries.recommendations,\n  trailingGuidance: joinNonEmpty(trailingGuidanceLines)\n};\n\nreturn { preparedCallToAction };"
          },
