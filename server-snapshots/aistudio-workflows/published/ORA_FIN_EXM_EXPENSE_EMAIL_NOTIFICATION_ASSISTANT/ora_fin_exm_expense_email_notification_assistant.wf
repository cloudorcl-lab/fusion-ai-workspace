          "code": "RECORD_EMAIL_SUMMARY",
          "convergenceTargetId": "end",
          "id": "1769470857297",
          "inputs": [
            {
              "id": "1784478655263_1",
              "name": "partnerExpenseId",
              "type": "string",
              "value": "{{$context.$nodes.PREPARE_RECORD_PAYLOAD.$output.result.partnerExpenseId}}"
            },
            {
              "id": "1784478655263_2",
              "name": "etag",
              "type": "string",
              "value": "{{$context.$nodes.PREPARE_RECORD_PAYLOAD.$output.result.etag}}"
            },
            {
              "id": "1784478655264_3",
              "name": "sourceTypeCode",
              "type": "string",
              "value": "{{$context.$nodes.SETSOURCETYPECODE.$output.result}}"
            },
            {
              "id": "1784478655264_4",
              "name": "updatedSummary",
              "type": "string",
              "value": "{{$context.$nodes.PREPARE_RECORD_PAYLOAD.$output.result.updatedSummary}}"
            },
            {
              "id": "1784478655265_5",
              "name": "outcomeStatus",
              "type": "string",
              "value": "{{$context.$nodes.PREPARE_RECORD_PAYLOAD.$output.result.outcomeStatus}}"
            },
            {
              "id": "1784478655266_6",
              "name": "messageIdentifier",
              "type": "string",
              "value": "{{$context.$nodes.PREPAREEMAILPAYLOAD.$output?.result?.params?.emailSubject?.message}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Prepare Record payload",
            "returnType": "object",
            "sourceCode": "const partnerExpenseItems = $context.$nodes.GET_PREVIOUS_SUMMARIES.$output?.items || [];\n\nconst partnerExpenseSummary = partnerExpenseItems.reduce((summary, item) => {\n  if (item?.sourceTypeCode === \"RECEIPT\") {\n    summary.receipt = item;\n  }\n\n  if (item?.sourceTypeCode === \"MESSAGE\") {\n    summary.message = item;\n  }\n\n  return summary;\n}, {\n  receipt: null,\n  message: null\n});\n\nconst replaceDashPlaceholders = (value) => {\n  if (value === \"-\") {\n    return \"\";\n  }\n\n  if (Array.isArray(value)) {\n    return value.map(replaceDashPlaceholders);\n  }\n\n  if (value && typeof value === \"object\") {\n    return Object.fromEntries(\n      Object.entries(value).map(([key, nestedValue]) => [\n        key,\n        replaceDashPlaceholders(nestedValue)\n      ])\n    );\n  }\n\n  return value;\n};\nconst partnerExpenseMessage =\n  partnerExpenseSummary.message || partnerExpenseItems[0] || {};\n\nconst etag = partnerExpenseMessage?.$context?.etag || \"1\";\n\nconst rawSystemInformation = partnerExpenseMessage?.systemInformation;\n\nlet summary = rawSystemInformation\n  ? JSON.parse(atob(rawSystemInformation))\n  : {};\n\nsummary.emailSummary = replaceDashPlaceholders(\n  $context.$nodes.PREPAREEMAILPAYLOAD.$output?.result?.params || {}\n);\n\nsummary = btoa(JSON.stringify(summary));\n\nconst updatedSummary = summary;\n\nconst outcomeStatus =\n  $context.$nodes.PREPAREEMAILPAYLOAD.$output?.result?.params?.messageOutcomeStatus;\n\nconst messageIdentifier =\n  $context.$nodes.PREPAREEMAILPAYLOAD.$output?.result?.params?.emailSubject?.message || \"\";\n\nconst partnerExpenseId =\n  $context.$triggers.REST.$input.partnerExpenseId;\n\nconst response = {\n  updatedSummary: updatedSummary,\n  etag: etag,\n  partnerExpenseId: partnerExpenseId,\n  outcomeStatus: outcomeStatus,\n  messageIdentifier: messageIdentifier\n};\n\nreturn response;"
          },
          "outcomes": {
            "success": "1780489723938"
          },
          "code": "PREPARE_RECORD_PAYLOAD",
          "convergenceTargetId": "1768451595894",
          "id": "1769471061867",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "prepareEmailPayload",
            "returnType": "object",
            "sourceCode": "const summarizedData = $context.$triggers.REST.$input.summarizedData || {};\nconst expenseData = summarizedData?.openIssues?.data || {};\nconst itemizedExpenseItems =\n  expenseData?.itemizedExpenseItems ||\n  expenseData?.itemizedExpenses?.items ||\n  expenseData?.itemizedExpenses ||\n  [];\nconst predictionItems = $context.$nodes.GET_EXPENSE_PREDICTIONS?.$output?.items || [];\nconst partnerExpenseItems = $context?.$nodes?.GET_PREVIOUS_SUMMARIES?.$output?.items || [];\nconst delegates = $context.$nodes.GET_DELEGATES.$output?.items || [];\nconst systemGeneratedTemplate = $context.$nodes.GENERATE_CALL_TO_ACTION.$output?.responseTemplate || \"\";\nconst callToAction = $context.$nodes.GENERATE_CALL_TO_ACTION.$output?.callToAction || \"-\";\nconst mainPrompt = $context.$nodes.EXTRACT_GENERATE_EMAIL_CONTENT_PROMPT.$output?.result?.mainPrompt || \"\";\nconst autoSubmissionEnabledFlag =\n  $context.$nodes.GET_AUTO_SUBMISSION_FLAG.$output?.result?.autoSubmissionEnabledFlag || \"\";\nconst isSimplifiedExpense =\n  [\n    $context.$triggers.REST?.$input?.isSimplifiedExpense,\n    summarizedData?.isSimplifiedExpense\n  ].some(\n    (value) =>\n      String(value ?? \"\")\n        .trim()\n        .toLowerCase() === \"true\"\n  );\n\nconst EXPENSE_ERROR_STRING_CODES = {\n  INSTANCE_JUSTIFICATION: \"EXM_SQ_V_RL_INST_JSTF\",\n  INSTANCE_PERSONAL_AMOUNT: \"EXM_SQ_V_RL_INST_E\",\n  DAILY_JUSTIFICATION: \"EXM_SQ_V_RL_DAILY_JSTF\",\n  DAILY_PERSONAL_AMOUNT: \"EXM_SQ_V_RL_DAILY_E\",\n  CORP_CARD_JUSTIFICATION: \"EXM_SQ_V_CCV_JSTF\",\n  CORP_CARD_PERSONAL_AMOUNT: \"EXM_SQ_V_CCV_E\",\n  FLIGHT_CLASS_JUSTIFICATION: \"EXM_SQ_V_FLT_CLASS_JSTF\",\n  RECEIPT_REQUIRED: \"EXM_SQ_RCPT_REQ\"\n};\n\nconst PARTNER_OUTCOMES = {\n  EXPENSE_CREATED: \"ORA_EXPENSE_CREATED\",\n  EXPENSE_UPDATED: \"ORA_EXPENSE_UPDATED\",\n  EXPENSE_MATCHED: \"ORA_EXPENSE_MATCHED\",\n  EMAIL_NOT_PROCESSED: \"ORA_EMAIL_NOT_PROCESSED\"\n};\n\nconst PARTNER_STATUS = { ERROR: \"ERROR\" };\n\nconst PARTNER_STAGE_STATUS = {\n  TECHNICAL_ERROR: \"ORA_TECHNICAL_ERROR\",\n  FACADE_FAILURE: \"ORA_FACADE_FAILURE\"\n};\n\nconst EMAIL_EXPENSE_OUTCOME_CODES = new Set([\n  PARTNER_OUTCOMES.EXPENSE_CREATED,\n  PARTNER_OUTCOMES.EXPENSE_UPDATED,\n  PARTNER_OUTCOMES.EXPENSE_MATCHED\n]);\n\nconst PREDICTION_TYPES = {\n  OPERATION_NOT_SUPPORTED: \"ORA_OPERATION_NOT_SUPPORTED\",\n  EXPENSE_SUBMITTED: \"ORA_EXPENSE_SUBMITTED\",\n  ATTRIBUTE_NOT_SUPPORTED: \"ORA_ATTRIBUTE_NOT_SUPPORTED\",\n  INVALID_REPLY: \"ORA_INVALID_REPLY\"\n};\n\nconst OUTCOME_SUBREASONS = {\n  FIRST_RECEIPT_WITH_TIP_AMT: \"FIRST_RECEIPT_WITH_TIP_AMT\",\n  FIRST_RECEIPT_WITH_ADDT_AMT: \"FIRST_RECEIPT_WITH_ADDT_AMT\",\n  FIRST_RECEIPT_WITHOUT_ADDT_AMT: \"FIRST_RECEIPT_WITHOUT_ADDT_AMT\",\n  MAX_LIMIT_EXCEEDED: \"MAX_LIMIT_EXCEEDED\",\n  RECEIPT_ALREADY_PROCESSED: \"RECEIPT_ALREADY_PROCESSED\",\n  RECEIPT_IGNORED: \"RECEIPT_IGNORED\",\n  RECEIPT_INVALID: \"RECEIPT_INVALID\",\n  INVALID_ERECEIPT_EMAIL: \"INVALID_ERECEIPT_EMAIL\",\n  BU_NOT_ENABLED: \"BU_NOT_ENABLED\",\n  DO_NOT_PROCESS: \"DO_NOT_PROCESS\",\n  IDR_AMOUNT_ZERO: \"IDR_AMOUNT_ZERO\",\n  INVALID_EXPENSECATEGORY: \"INVALID_EXPENSECATEGORY\",\n  INVALID_DELEGATE: \"INVALID_DELEGATE\"\n};\n\nconst PREDICTION_NEEDS_ATTENTION_TYPES = new Set([\n  PREDICTION_TYPES.OPERATION_NOT_SUPPORTED,\n  PREDICTION_TYPES.EXPENSE_SUBMITTED,\n  PREDICTION_TYPES.ATTRIBUTE_NOT_SUPPORTED,\n  PREDICTION_TYPES.INVALID_REPLY\n]);\n\nconst PARTNER_NEEDS_ATTENTION_SUBREASONS = new Set([OUTCOME_SUBREASONS.MAX_LIMIT_EXCEEDED]);\n\nconst SUBJECT_MESSAGES = {\n  review: { messageStringId: \"1313258\", message: \"Review in Oracle Expenses: {ITEM1} on {ITEM2}\" },\n  reviewPlain: { messageStringId: \"0\", message: \"Review in Oracle Expenses\" },\n  preApprovalForm: { messageStringId: \"0\", message: \"Pre Approval form required: {ITEM1} on {ITEM2}\" },\n  customerInfo: { messageStringId: \"0\", message: \"Customer info needed: {ITEM1} on {ITEM2}\" },\n  projectInfo: { messageStringId: \"0\", message: \"Project & Task Needed: {ITEM1} on {ITEM2}\" },\n  justification: { messageStringId: \"1313242\", message: \"Justification Needed: {ITEM1} on {ITEM2}\" },\n  attendees: { messageStringId: \"1313242\", message: \"Attendees Needed: {ITEM1} on {ITEM2}\" },\n  additionalInfo: { messageStringId: \"1313243\", message: \"Additional Information Needed: {ITEM1} on {ITEM2}\" },\n  expenseAutoSubmitted: { messageStringId: \"0\", message: \"{ITEM1} on {ITEM2} will be auto-submitted\" },\n  expenseReadyToSubmit: { messageStringId: \"0\", message: \"{ITEM1} on {ITEM2} is ready to submit\" },\n  pendingFinalCharge: { messageStringId: \"0\", message: \"Pending final charge: {ITEM1} on {ITEM2}\" },\n  receiptAdditionalCharge: {\n    messageStringId: \"0\",\n    message: \"Receipt Attached With Additional Charge Identified: {ITEM1} on {ITEM2}\"\n  },\n  receiptAttached: { messageStringId: \"0\", message: \"Receipt Attached: {ITEM1} on {ITEM2}\" },\n  creationFailed: { messageStringId: \"0\", message: \"Unable to Create Expense\" },\n  duplicateReceipt: { messageStringId: \"0\", message: \"Duplicate Receipt: {ITEM1} on {ITEM2}\" },\n  receiptExists: { messageStringId: \"0\", message: \"Receipt Exists: {ITEM1} on {ITEM2}\" }\n};\n\nconst RECOMMENDATION_SUMMARY_BY_TYPE = {\n  project: \"Below are the recommended projects and tasks\",\n  projects: \"Below are the recommended projects and tasks\",\n  account: \"Below are the recommended company and cost centers\",\n  accounts: \"Below are the recommended company and cost centers\"\n};\n\nconst SUPPORTED_EXPENSE_ERRORS_BY_ATTRIBUTE = {\n  description: true,\n  justification: true,\n  startdate: true,\n  enddate: true,\n  merchantname: true,\n  exchangerate: true,\n  location: true,\n  receiptamount: new Set([\n    EXPENSE_ERROR_STRING_CODES.INSTANCE_PERSONAL_AMOUNT,\n    EXPENSE_ERROR_STRING_CODES.DAILY_JUSTIFICATION,\n    EXPENSE_ERROR_STRING_CODES.DAILY_PERSONAL_AMOUNT,\n    EXPENSE_ERROR_STRING_CODES.INSTANCE_JUSTIFICATION,\n    EXPENSE_ERROR_STRING_CODES.CORP_CARD_JUSTIFICATION,\n    EXPENSE_ERROR_STRING_CODES.CORP_CARD_PERSONAL_AMOUNT\n  ]),\n  expensetype: true,\n  expensetypeid: true,\n  currencycode: true,\n  receiptcurrencycode: true,\n  expensesource: true,\n  locationid: true,\n  numberofattendees: true,\n  destinationfrom: true,\n  destinationto: true,\n  agencyname: true,\n  passengername: true,\n  ticketclasscode: true,\n  flightduration: true,\n  traveltype: true,\n  personalreceiptamount: true,\n  flightclassjustification: true,\n  ora_flex_projectscostcollection__info: true\n};\n\nconst CLASSIC_EXPENSE_ERRORS = {\n  \"EXM:::EXM_ATTENDEE_AMT_VALIDATN\": { needsAttention: true },\n  \"EXM:::EXM_ATTENDEE_EMPLOYEE_REQ\": { attribute: \"attendees\" },\n  \"EXM:::EXM_CMN_PERSONAL_AMOUNT\": { needsAttention: true },\n  \"EXM:::EXM_COMMUTE_DISTANCE_REQD\": { needsAttention: true },\n  \"EXM:::EXM_DUPLICATE_ERROR_REPORT\": { needsAttention: true },\n  \"EXM:::EXM_EREC_FUTURE_DATE_ERROR\": { needsAttention: true },\n  \"EXM:::EXM_ERECP_ADD_DISPUTED_TXN_ERR\": { needsAttention: true },\n  \"EXM:::EXM_ERECP_ATTENDEE_REQ\": { attribute: \"attendees\" },\n  \"EXM:::EXM_ERECP_CC_ALLOWANCE\": { limitType: \"allowance\", needsAttention: true },\n  \"EXM:::EXM_REQ_NONEMPLOYEE\": { attribute: \"attendees\" },\n  \"FND:::FND_CMN_CMPLT_FLDS\": { useAttributeName: true },\n  \"EXM:::EXM_ERECP_CC_JUSTIFY\": { limitType: \"corporateCardJustification\" },\n  \"EXM:::EXM_ERECP_CC_TOLERANCE\": { needsAttention: true },\n  \"EXM:::EXM_ERECP_CON_RATE_ERR\": { needsAttention: true },\n  \"EXM:::EXM_ERECP_CON_RATE_WARN\": { needsAttention: true },\n  \"EXM:::EXM_ERECP_RECEIPT_JUSTIFY\": { limitType: \"missingReceiptJustification\" },\n  \"EXM:::EXM_ERECP_CON_RATE_JUSTIFY\": { limitType: \"conversionRateJustification\" },\n  \"EXM:::EXM_ERECP_CHANGE_TEMPLATE\": { needsAttention: true },\n  \"EXM:::EXM_ERECP_INVALID_ITEM_TOTAL\": { needsAttention: true },\n  \"EXM:::EXM_ERECP_INVALID_LOCATION\": { attribute: \"location\" },\n  \"EXM:::EXM_ERECP_INVALID_TAX_CODE\": { needsAttention: true },\n  \"EXM:::EXM_ERECP_ITEMIZATION_REQD\": { needsAttention: true },\n  \"EXM:::EXM_ERECP_MISSING_RECEIPT\": { needsAttention: true },\n  \"EXM:::EXM_ERECP_NULL_EXPENSE_TYPE\": { needsAttention: true },\n  \"EXM:::EXM_ERECP_POL_VIOLATE\": { needsAttention: true },\n  \"EXM:::EXM_ERECP_PROJ_TASK_REQD\": { attribute: \"project & task\" },\n  \"EXM:::EXM_ERECP_UPDT_PARENT_NO_ITEM\": { needsAttention: true },\n  \"EXM:::EXM_ERECP_WRN_CON_RATE_ONE\": { needsAttention: true },\n  \"EXM:::EXM_ITEMIZATION_INCOMPLETE\": { needsAttention: true },\n  \"EXM:::EXM_ITEMIZED_ATTENDEE_AMT_VALI\": { needsAttention: true },\n  \"EXM:::EXM_JUST_REQ_CHILD_VIOLATN\": { needsAttention: true },\n  \"EXM:::EXM_LOCATION_INVALID\": { attribute: \"location\" },\n  \"EXM:::EXM_MISC_POL_MIN_NO_DAYS\": { needsAttention: true },\n  \"EXM:::EXM_POLICY_DAILY_LIM\": { limitType: \"daily\" },\n  \"EXM:::EXM_POLICY_DAILY_LIM_E\": { needsAttention: true },\n  \"EXM:::EXM_POLICY_LT_LIM\": { limitType: \"lifetime\" },\n  \"EXM:::EXM_POLICY_LT_LIM_E\": { needsAttention: true },\n  \"EXM:::EXM_POLICY_MONTHLY_LIM\": { limitType: \"monthly\" },\n  \"EXM:::EXM_POLICY_MONTHLY_LIM_E\": { needsAttention: true },\n  \"EXM:::EXM_POLICY_SINGLE_INST_LIM\": { limitType: \"single\" },\n  \"EXM:::EXM_POLICY_SINGLE_LIM_E\": { needsAttention: true },\n  \"EXM:::EXM_POLICY_YEARLY_LIM\": { limitType: \"yearly\" },\n  \"EXM:::EXM_POLICY_YEARLY_LIM_E\": { needsAttention: true },\n  \"EXM:::EXM_POL_ENT_ATTENDEE_REQ\": { needsAttention: true },\n  \"EXM:::EXM_POL_PREFERRED_AGENCY\": { needsAttention: true },\n  \"EXM:::EXM_POL_PREFERRED_AGENCY_E\": { needsAttention: true },\n  \"EXM:::EXM_POL_PREFERRED_MERCHANT\": { needsAttention: true },\n  \"EXM:::EXM_POL_PREFERRED_MERCHANT_E\": { needsAttention: true },\n  \"EXM:::EXM_PRIOR_EMPL_DATE\": { needsAttention: true },\n  \"EXM:::EXM_RCPT_VIOLATION_INVALID\": { needsAttention: true },\n  \"EXM_NONEMP_PREAPPROVAL\": { attribute: \"pre approval form\", alwaysUseAttribute: true }\n};\n\nconst JUSTIFICATION_LIMIT_TYPES = new Set([\n  \"daily\",\n  \"lifetime\",\n  \"monthly\",\n  \"single\",\n  \"yearly\",\n  \"corporateCardJustification\",\n  \"missingReceiptJustification\",\n  \"conversionRateJustification\"\n]);\n\nconst SPECIFIC_JUSTIFICATION_ERROR_STRING_CODES = new Set([\n  EXPENSE_ERROR_STRING_CODES.DAILY_JUSTIFICATION,\n  EXPENSE_ERROR_STRING_CODES.INSTANCE_JUSTIFICATION,\n  EXPENSE_ERROR_STRING_CODES.FLIGHT_CLASS_JUSTIFICATION\n]);\n\nconst SUBMITTABLE_VALIDATION_STATUS_CODES = new Set([\"C\", \"CLEAN\", \"W\", \"WARNING\"]);\nconst ERROR_VALIDATION_STATUS_CODES = new Set([\"E\", \"ERROR\"]);\nconst PENDING_CORPORATE_CARD_SOURCES = new Set([\"CARD_AUTH\", \"ORA_UBER\", \"CORP_CARD\"]);\n\nconst LIMIT_ERROR_CODES = new Set([\n  \"EXM_SQ_V_RL_INST_E\",\n  \"EXM_SQ_V_RL_DAILY_E\",\n  \"EXM:::EXM_POLICY_DAILY_LIM\",\n  \"EXM:::EXM_POLICY_LT_LIM\",\n  \"EXM:::EXM_POLICY_MONTHLY_LIM\",\n  \"EXM:::EXM_POLICY_SINGLE_INST_LIM\",\n  \"EXM:::EXM_POLICY_YEARLY_LIM\"\n]);\n\nconst CORP_CARD_ERROR_CODES = new Set([\n  EXPENSE_ERROR_STRING_CODES.CORP_CARD_JUSTIFICATION,\n  EXPENSE_ERROR_STRING_CODES.CORP_CARD_PERSONAL_AMOUNT\n]);\n\nconst EXPENSE_ERROR_BADGES_BY_CODE = {\n  EXM_PROJECT_DETAILS_REQUIRED: { type: \"WARNING\", text: \"Project details needed\" },\n  EXM_REST_REQ_INVALID: { type: \"WARNING\", text: \"More info needed\" },\n  EXM_SQ_RCPT_UPLOAD: { type: \"WARNING\", text: \"Receipt needed\" },\n  EXM_SQ_RCPT_REQ: { type: \"WARNING\", text: \"Receipt needed\" },\n  EXM_ORG_ENTRY_MISSING_ERR: { type: \"WARNING\", text: \"Attendee info needed\" },\n  EXM_NONEMP_PREAPPROVAL: { type: \"WARNING\", text: \"Pre Approval form needed\" },\n  EXM_NONEMP_ATTENDEE_PRIVATE: { type: \"WARNING\", text: \"Recipient info needed\" },\n  EXM_AUTH_ACCT_SEG_DIFF: { type: \"WARNING\", text: \"Justification needed\" },\n  EXM_POL_FLIGHT_CLASS_E: { type: \"WARNING\", text: \"Justification needed\" },\n  \"EXM:::EXM_ATTENDEE_EMPLOYEE_REQ\": { type: \"WARNING\", text: \"Attendees needed\" },\n  \"EXM:::EXM_REQ_NONEMPLOYEE\": { type: \"WARNING\", text: \"Attendees needed\" },\n  \"EXM:::EXM_ERECP_INVALID_LOCATION\": { type: \"WARNING\", text: \"Location needed\" },\n  \"EXM:::EXM_ERECP_PROJ_TASK_REQD\": { type: \"WARNING\", text: \"Project info required\" },\n  \"EXM:::EXM_ERECP_RECEIPT_JUSTIFY\": { type: \"WARNING\", text: \"Justification needed\" },\n  \"EXM:::EXM_ERECP_CON_RATE_JUSTIFY\": { type: \"WARNING\", text: \"Justification needed\" }\n};\n\nconst isStr = (value) => typeof value === \"string\" && value.trim() !== \"\";\n\nconst firstNonNull = (...values) =>\n  values.find((value) => value !== null && value !== undefined) ?? null;\n\nconst norm = (value) => (isStr(value) ? value.trim() : \"\");\n\nconst getWorkerEmail = (worker) => {\n  const emailItems = worker?.emails?.items;\n  if (!Array.isArray(emailItems) || emailItems.length === 0) {\n    return \"\";\n  }\n\n  const primaryEmail = emailItems.find((email) => {\n    const flag = email?.primaryFlag;\n    if (flag === true) return true;\n    if (typeof flag === \"string\") {\n      const normalized = flag.trim().toUpperCase();\n      return normalized === \"Y\" || normalized === \"TRUE\";\n    }\n    return false;\n  });\n\n  if (isStr(primaryEmail?.emailAddress)) {\n    return primaryEmail.emailAddress;\n  }\n\n  const fallbackEmail = emailItems.find((email) => isStr(email?.emailAddress));\n  return fallbackEmail?.emailAddress || \"\";\n};\n\nconst getWorkerDisplayName = (worker) => {\n  const displayName = worker?.names?.items?.[0]?.displayName;\n  if (isStr(displayName)) return displayName;\n\n  const firstName = worker?.names?.items?.[0]?.firstName || \"\";\n  const lastName = worker?.names?.items?.[0]?.lastName || \"\";\n  return `${firstName} ${lastName}`.trim();\n};\n\nconst formatDelegatorPrefix = (displayName) => {\n  if (!isStr(displayName)) return \"\";\n  const parts = displayName.trim().split(/\\s+/);\n  const first = parts[0] || \"\";\n  const last = parts[parts.length - 1] || \"\";\n  if (!first) return \"\";\n  return `[${first.slice(0, 3)} ${last ? `${last.slice(0, 1)}.` : \"\"}]`;\n};\n\nconst formatDateToMMDDYY = (isoDate) => {\n  if (!isStr(isoDate)) return \"\";\n  const [year, month, day] = isoDate.split(\"-\");\n  if (!year || !month || !day) return \"\";\n  return `${Number(month)}/${Number(day)}/${year.slice(-2)}`;\n};\n\nconst formatSubjectAmount = (expense, receipt) => {\n  const amount = firstNonNull(\n    expense?.receiptAmount,\n    expense?.personalReceiptAmount,\n    receipt?.receiptAmount,\n    receipt?.personalReceiptAmount,\n    expense?.amount,\n    \"\"\n  );\n\n  const currencyCode = firstNonNull(\n    expense?.receiptCurrency?.currencyCode,\n    receipt?.receiptCurrency?.currencyCode,\n    expense?.currencyCode,\n    receipt?.currencyCode,\n    \"\"\n  );\n\n  const normalizedAmount = String(amount ?? \"\").trim();\n  const normalizedCurrency = String(currencyCode ?? \"\").trim();\n\n  if (normalizedAmount && normalizedCurrency) {\n    return `${normalizedAmount} ${normalizedCurrency}`;\n  }\n\n  return normalizedAmount || normalizedCurrency || \"\";\n};\n\nconst humanizeExpenseErrorLabel = (value) => {\n  if (!isStr(value)) return \"\";\n\n  const rawValue = String(value).trim();\n  if (rawValue === \"ora_flex_projectsCostCollection__info\") {\n    return \"project & task\";\n  }\n\n  return rawValue\n    .replace(/([a-z])([A-Z])/g, \"$1 $2\")\n    .replace(/\\bID\\b|\\bid\\b/gi, \"\")\n    .replace(/\\s+/g, \" \")\n    .replace(/\\bline\\b/gi, \"\")\n    .toLowerCase()\n    .trim();\n};\n\nconst toNeededSubject = (label) => {\n  const normalizedLabel = humanizeExpenseErrorLabel(label);\n  if (!isStr(normalizedLabel)) {\n    return SUBJECT_MESSAGES.review;\n  }\n\n  const titleCaseLabel = normalizedLabel\n    .split(/\\s+/)\n    .map((part) => (part ? part.charAt(0).toUpperCase() + part.slice(1) : \"\"))\n    .join(\" \");\n\n  return {\n    messageStringId: \"0\",\n    message: titleCaseLabel + \" Needed: {ITEM1} on {ITEM2}\"\n  };\n};\n\nconst buildLimitSubject = (expenseError) => {\n  switch (norm(expenseError?.errorStringCode)) {\n    case EXPENSE_ERROR_STRING_CODES.CORP_CARD_JUSTIFICATION:\n      return { messageStringId: \"0\", message: \"Justification Needed: {ITEM1} on {ITEM2}\" };\n    case EXPENSE_ERROR_STRING_CODES.CORP_CARD_PERSONAL_AMOUNT:\n      return { messageStringId: \"0\", message: \"Action Required: Over Spending Limit\" };\n    default:\n      break;\n  }\n\n  switch (CLASSIC_EXPENSE_ERRORS[norm(expenseError?.errorCode)]?.limitType) {\n    case \"daily\":\n      return { messageStringId: \"0\", message: \"Justification Needed: Over Daily Spending Limit\" };\n    case \"lifetime\":\n      return { messageStringId: \"0\", message: \"Justification Needed: Over Lifetime Spending Limit\" };\n    case \"monthly\":\n      return { messageStringId: \"0\", message: \"Justification Needed: Over Monthly Spending Limit\" };\n    case \"single\":\n      return { messageStringId: \"0\", message: \"Justification Needed: Over Spending Limit\" };\n    case \"yearly\":\n      return { messageStringId: \"0\", message: \"Justification Needed: Over Annual Spending Limit\" };\n    case \"corporateCardJustification\":\n      return { messageStringId: \"0\", message: \"Justification Needed: Corporate Card Not Used\" };\n    case \"missingReceiptJustification\":\n      return { messageStringId: \"0\", message: \"Justification Needed: Missing Receipt\" };\n    case \"conversionRateJustification\":\n      return { messageStringId: \"0\", message: \"Justification Needed: Conversion Rate\" };\n    case \"allowance\":\n      return { messageStringId: \"0\", message: \"Justification Needed: Over Corporate Card Uses Limit\" };\n    default:\n      break;\n  }\n\n  switch (norm(expenseError?.errorStringCode)) {\n    case EXPENSE_ERROR_STRING_CODES.DAILY_JUSTIFICATION:\n      return { messageStringId: \"0\", message: \"Justification Needed: Over Daily Spending Limit\" };\n    case EXPENSE_ERROR_STRING_CODES.INSTANCE_JUSTIFICATION:\n      return { messageStringId: \"0\", message: \"Justification Needed: Over Spending Limit\" };\n    case EXPENSE_ERROR_STRING_CODES.FLIGHT_CLASS_JUSTIFICATION:\n      return { messageStringId: \"0\", message: \"Justification Needed: Flight Class\" };\n    case EXPENSE_ERROR_STRING_CODES.DAILY_PERSONAL_AMOUNT:\n      return { messageStringId: \"0\", message: \"Action Required: Over Daily Spending Limit\" };\n    case EXPENSE_ERROR_STRING_CODES.INSTANCE_PERSONAL_AMOUNT:\n      return { messageStringId: \"0\", message: \"Action Required: Over Spending Limit\" };\n    default:\n      return null;\n  }\n};\n\nconst getExpenseErrorCode = (expenseError) =>\n  norm(expenseError?.errorStringCode) || norm(expenseError?.errorCode);\n\nconst formatPersonalAmount = (expense) => {\n  const amount = expense?.personalReceiptAmount;\n  const currencyCode = expense?.receiptCurrency?.currencyCode;\n  return `${amount}${currencyCode ? ` ${currencyCode}` : \"\"}`.trim();\n};\n\nconst getActionableExpenseErrors = (expense) => {\n  const rawExpenseErrors = expense?.expenseErrors?.items || [];\n  if (!Array.isArray(rawExpenseErrors)) return [];\n\n  return rawExpenseErrors.filter((error) =>\n    error?.userActionRequiredFlag === true &&\n    error?.warningFlag !== true &&\n    norm(error?.objectName) !== \"NA\"\n  );\n};\n\nconst hasExpenseValidationIssue = (expense) => {\n  const validationStatus = norm(expense?.validationStatusCode).toUpperCase();\n  return validationStatus.includes(\"E\") || validationStatus.includes(\"W\");\n};\n\nconst hasItemizedExpenseValidationIssues = (items) => {\n  const normalizedItems = Array.isArray(items) ? items : items?.items;\n  if (!Array.isArray(normalizedItems)) return false;\n  return normalizedItems.some((item) => hasExpenseValidationIssue(item));\n};\n\nconst buildSingleErrorBadge = (expenseError) => {\n  const errorStringCode = norm(expenseError?.errorStringCode);\n  const errorCode = norm(expenseError?.errorCode);\n  const code = errorStringCode || errorCode;\n  const attributeName = expenseError?.stringToken1Value || expenseError?.attributeName || CLASSIC_EXPENSE_ERRORS[errorCode]?.attribute || \"\";\n\n  if (CORP_CARD_ERROR_CODES.has(code)) {\n    return code.endsWith(\"JSTF\")\n      ? { type: \"WARNING\", text: \"Corporate card justification needed\" }\n      : { type: \"ERROR\", text: \"Over spending limit\" };\n  }\n\n  if (LIMIT_ERROR_CODES.has(code)) {\n    return { type: \"ERROR\", text: \"Over spending limit\" };\n  }\n\n  if (code.endsWith(\"JSTF\")) {\n    return { type: \"WARNING\", text: \"Justification needed\" };\n  }\n\n  if (EXPENSE_ERROR_BADGES_BY_CODE[code]) {\n    return EXPENSE_ERROR_BADGES_BY_CODE[code];\n  }\n\n  if (code === \"EXM_REST_REQ_MISSING\" || code === \"EXM_REST_DFF_REQ_MISSING\" || errorCode === \"FND:::FND_CMN_CMPLT_FLDS\") {\n    const label = humanizeExpenseErrorLabel(attributeName);\n    const badgeLabel = label ? label.charAt(0).toUpperCase() + label.slice(1) : \"\";\n    return { type: \"WARNING\", text: badgeLabel ? `${badgeLabel} needed` : \"More info needed\" };\n  }\n\n  return { type: \"WARNING\", text: \"More info needed\" };\n};\n\nconst buildMultipleErrorBadge = (expenseErrors) => {\n  const codes = expenseErrors.map(getExpenseErrorCode);\n  const allLimitErrors = codes.every((code) => LIMIT_ERROR_CODES.has(code));\n  const allJustificationErrors = codes.every((code) => code.endsWith(\"JSTF\"));\n\n  if (allLimitErrors) {\n    return { type: \"ERROR\", text: \"Over spending limit\" };\n  }\n\n  if (allJustificationErrors) {\n    return { type: \"WARNING\", text: \"Justification needed\" };\n  }\n\n  return { type: \"WARNING\", text: \"More info needed\" };\n};\n\nconst isPendingFinalChargeExpense = (expense) => {\n  if (!expense || Object.keys(expense).length === 0) return false;\n  return (\n    ERROR_VALIDATION_STATUS_CODES.has(norm(expense?.validationStatusCode)) &&\n    getActionableExpenseErrors(expense).length === 0 &&\n    PENDING_CORPORATE_CARD_SOURCES.has(norm(expense?.expenseSource))\n  );\n};\n\nconst buildExpensePrimaryBadge = (expense) => {\n  if (!expense || Object.keys(expense).length === 0) return null;\n\n  const validationStatusCode = norm(expense?.validationStatusCode);\n  const actionableErrors = getActionableExpenseErrors(expense);\n  const isPersonalExpense = norm(expense?.expenseCategoryCode) === \"PERSONAL\";\n  const personalAmount = Number(expense?.personalReceiptAmount) || 0;\n  const receiptAmount = Number(expense?.receiptAmount) || 0;\n\n  if (isPersonalExpense || (receiptAmount > 0 && personalAmount >= receiptAmount)) {\n    return { type: \"INFO\", text: \"Personal Expense\" };\n  }\n\n  if (ERROR_VALIDATION_STATUS_CODES.has(validationStatusCode)) {\n    if (actionableErrors.length === 1) {\n      return buildSingleErrorBadge(actionableErrors[0]);\n    }\n\n    if (actionableErrors.length > 1) {\n      return buildMultipleErrorBadge(actionableErrors);\n    }\n\n    if (isPendingFinalChargeExpense(expense)) {\n      return { type: \"NEUTRAL\", text: \"Pending final charge\" };\n    }\n\n    return { type: \"WARNING\", text: \"More info needed\" };\n  }\n\n  if (!SUBMITTABLE_VALIDATION_STATUS_CODES.has(validationStatusCode)) {\n    return null;\n  }\n\n  if (personalAmount > 0) {\n    return { type: \"INFO\", text: `Personal ${formatPersonalAmount(expense)}`.trim() };\n  }\n\n  return { type: \"SUCCESS\", text: \"Ready to submit\" };\n};\n\nconst esc = (value) => encodeURIComponent(String(value ?? \"\"));\n\nconst formatOptionNumbers = (count) => {\n  const values = Array.from({ length: count }, (_, index) => String(index + 1));\n  if (values.length === 0) return \"\";\n  if (values.length === 1) return values[0];\n  if (values.length === 2) return `${values[0]} or ${values[1]}`;\n  return `${values.slice(0, -1).join(\", \")}, or ${values[values.length - 1]}`;\n};\n\nconst normalizeOptionNumbers = (value) => {\n  const numbers = String(value || \"\").match(/\\d+/g) || [];\n  return numbers.length > 0 ? formatOptionNumbers(numbers.length) : String(value || \"\").trim();\n};\n\nconst capitalizeFirst = (value) => {\n  const normalized = String(value || \"\").trim();\n  return normalized ? normalized.charAt(0).toUpperCase() + normalized.slice(1) : \"\";\n};\n\nconst stripTemplatePunctuation = (value) =>\n  String(value || \"\")\n    .trim()\n    .replace(/\\s*[:.]+\\s*$/g, \"\")\n    .trim();\n\nconst normalizeMissingItemLabel = (value) => {\n  const normalized = stripTemplatePunctuation(value)\n    .replace(/^the\\s+/i, \"\")\n    .trim();\n  return normalized.toLowerCase() === \"accounts\" ? \"company and cost center\" : normalized;\n};\n\nconst normalizeTemplateLine = (line) => {\n  let text = String(line || \"\").trim();\n  if (!text) return \"\";\n\n  text = text.replace(/^\\d+\\.\\s*/, \"\").trim();\n  if (/^reply with the following for the below expense:?$/i.test(text)) return \"\";\n\n  const optionMatch = text.match(\n    /^(?:reply with\\s+)?option\\s+(.+?)\\s+from the below recommendations(?:\\s+or\\s+enter\\s+(?:a|an|the)?\\s*(?:new\\s+)?(.+?))?\\.?:?$/i\n  );\n  if (optionMatch) {\n    const missingItem = normalizeMissingItemLabel(optionMatch[2] || \"\");\n    const optionNumbers = normalizeOptionNumbers(optionMatch[1]);\n    return missingItem\n      ? `Enter option ${optionNumbers}, or enter ${missingItem}`\n      : `Enter option ${optionNumbers}`;\n  }\n\n  text = text\n    .replace(/^reply with the following for the below expense:?\\s*/i, \"\")\n    .replace(/^reply with\\s+/i, \"\")\n    .replace(/\\s+for the below expense\\.?:?$/i, \"\")\n    .replace(/^the\\s+/i, \"\")\n    .trim();\n\n  text = stripTemplatePunctuation(text);\n  if (!text) return \"\";\n\n  if (/attendee/i.test(text) && /(name|email)/i.test(text)) {\n    return \"First Name Last Name, Email\";\n  }\n\n  if (/corporate card/i.test(text)) {\n    return \"Corporate card justification in 240 characters or less\";\n  }\n\n  if (/daily spending limit/i.test(text)) {\n    return \"Daily spending limit justification in 240 characters or less\";\n  }\n\n  if (/(^|\\b)spending limit(\\b|$)|why you went over|went over .*limit/i.test(text)) {\n    return \"Spending limit justification in 240 characters or less\";\n  }\n\n  if (/personal .*amount/i.test(text)) {\n    return \"Personal Receipt Amount\";\n  }\n\n  if (/^(attached )?receipt$/i.test(text)) {\n    return \"Attach a receipt\";\n  }\n\n  return capitalizeFirst(text);\n};\n\nconst buildGroupedAttendeeOptionTemplate = (template) => {\n  const normalized = String(template || \"\")\n    .replace(/\\r\\n|\\r|\\n/g, \"%0A\")\n    .trim();\n  const blockPattern = /reply with which\\s+(.+?)\\s+attended:\\s*((?:%0A\\s*\\d+\\.\\s*(?:(?!%0A\\s*reply with which).)+)+)/gi;\n  const lines = [];\n  let match;\n\n  while ((match = blockPattern.exec(normalized)) !== null) {\n    const optionCount = (match[2].match(/%0A\\s*\\d+\\.\\s*/gi) || []).length;\n    const groupName = stripTemplatePunctuation(match[1]);\n    const groupSuffix = /^(attendee|attendees)$/i.test(groupName) ? \"\" : ` for ${groupName}`;\n    if (optionCount > 0) {\n      lines.push(`Enter option ${formatOptionNumbers(optionCount)}${groupSuffix}`);\n    }\n  }\n\n  return lines.length ? lines.map((line) => `${line}:%0A`).join(\"\") : \"\";\n};\n\nconst sanitizeSystemGeneratedTemplate = (template) => {\n  const groupedAttendeeTemplate = buildGroupedAttendeeOptionTemplate(template);\n  if (groupedAttendeeTemplate) return groupedAttendeeTemplate;\n\n  const normalized = String(template || \"\")\n    .replace(/\\r\\n|\\r|\\n/g, \"%0A\")\n    .replace(/\\s+(\\d+\\.\\s+)/g, \"%0A$1\")\n    .trim();\n\n  const lines = normalized\n    .split(/%0A/gi)\n    .map(normalizeTemplateLine)\n    .filter(isStr)\n    .filter((line, index, all) => all.findIndex((candidate) => candidate.toLowerCase() === line.toLowerCase()) === index);\n\n  return lines.map((line) => line === \"Attach a receipt\" ? `${line}%0A` : `${line}:%0A`).join(\"\");\n};\n\nconst isPromptLeak = () => {\n  const normalizedCallToAction = String(callToAction || \"\").trim();\n  const normalizedMainPrompt = String(mainPrompt || \"\").trim();\n  if (!normalizedCallToAction || !normalizedMainPrompt) return false;\n  return normalizedCallToAction === normalizedMainPrompt;\n};\n\nconst getUnexpectedIssueCallToAction = () =>\n  \"We ran into an unexpected issue while processing this expense. Go to Oracle Expenses to provide the required information.\";\n\nconst buildSpecialResponseTemplateLine = (expense) => {\n  const expenseErrors = getActionableExpenseErrors(expense);\n  if (expenseErrors.length !== 1) return \"\";\n\n  switch (norm(expenseErrors[0]?.errorStringCode)) {\n    case EXPENSE_ERROR_STRING_CODES.INSTANCE_JUSTIFICATION:\n      return \"Spending limit justification in 240 characters or less:%0A\";\n    case EXPENSE_ERROR_STRING_CODES.DAILY_JUSTIFICATION:\n      return \"Daily spending limit justification in 240 characters or less:%0A\";\n    case EXPENSE_ERROR_STRING_CODES.INSTANCE_PERSONAL_AMOUNT:\n      return \"Personal Receipt Amount:%0A\";\n    case EXPENSE_ERROR_STRING_CODES.DAILY_PERSONAL_AMOUNT:\n      return \"Personal Receipt Amount:%0A\";\n    case EXPENSE_ERROR_STRING_CODES.CORP_CARD_JUSTIFICATION:\n      return \"Corporate card justification in 240 characters or less:%0A\";\n    case EXPENSE_ERROR_STRING_CODES.CORP_CARD_PERSONAL_AMOUNT:\n      return \"Personal Receipt Amount:%0A\";\n    default:\n      return \"\";\n  }\n};\n\nconst buildReceiptRequiredResponseTemplateLine = (expense) =>\n  getActionableExpenseErrors(expense).some(\n    (expenseError) =>\n      norm(expenseError?.errorStringCode) ===\n      EXPENSE_ERROR_STRING_CODES.RECEIPT_REQUIRED\n  )\n    ? \"Attach a receipt%0A\"\n    : \"\";\n\nconst getSimplifiedAttendeeAcknowledgementTemplate = () => {\n  const acknowledgementSummary = summarizedData?.acknowledgements?.summary || \"\";\n  const acknowledgementLines = String(acknowledgementSummary || \"\")\n    .split(/\\r\\n|\\r|\\n/)\n    .map((line) => line.trim())\n    .filter((line) => /^number of (attendees|recipients)(?:\\s*\\(|:)/i.test(line));\n\n  const extractedAttendeeLines = acknowledgementLines\n    .filter((line) =>\n      /^number of attendees\\s*\\(as extracted from (mail|receipt)\\)\\s*:\\s*.+/i.test(line)\n    );\n\n  const lines = acknowledgementLines.filter(\n    (line, index, all) =>\n      all.findIndex((candidate) => candidate.toLowerCase() === line.toLowerCase()) === index\n  );\n\n  return {\n    template: lines.length ? `${lines.join(\"%0A\")}%0A` : \"\",\n    hasExtractedAttendeePrefill: extractedAttendeeLines.length > 0\n  };\n};\n\nconst removePrefilledExtractedAttendeePrompt = (template) =>\n  String(template || \"\")\n    .split(/%0A/gi)\n    .filter(isStr)\n    .filter(\n      (line) =>\n        !/^number of attendees\\s*\\(as extracted from (mail|receipt)\\)\\s*:\\s*$/i.test(\n          line.trim()\n        )\n    )\n    .map((line) => `${line}%0A`)\n    .join(\"\");\n\nconst getSimplifiedExtractedAttendeeAcknowledgement = () => {\n  const acknowledgementSummary = summarizedData?.acknowledgements?.summary || \"\";\n\n  return (\n    String(acknowledgementSummary || \"\")\n      .split(/\\r\\n|\\r|\\n/)\n      .map((line) => line.trim())\n      .find((line) =>\n        /^number of attendees\\s*\\(as extracted from (mail|receipt)\\)\\s*:\\s*\\d+\\s*\\.?$/i.test(\n          line\n        )\n      ) || \"\"\n  );\n};\n\nconst getSimplifiedCustomerOpenIssue = () => {\n  const openIssuesSummary = summarizedData?.openIssues?.summary || \"\";\n  const openIssueLines = String(openIssuesSummary || \"\")\n    .split(/\\r\\n|\\r|\\n/)\n    .map((line) => line.trim().replace(/^\\d+\\.\\s*/, \"\"))\n    .filter(isStr)\n    .filter((line) => !/^reply with the following for the below expense:?$/i.test(line))\n    .map((line) => line.replace(/^reply with\\s+/i, \"\").trim())\n    .filter(isStr);\n\n  if (openIssueLines.length !== 1) return \"\";\n\n  const customerOpenIssue = openIssueLines[0];\n  return /^customer or partner organization\\s*\\(type none if not applicable\\)\\s*:\\s*$/i.test(\n    customerOpenIssue\n  )\n    ? customerOpenIssue\n    : \"\";\n};\n\nconst buildSimplifiedAttendeeCustomerCallToAction = (baseCallToAction) => {\n  if (!isSimplifiedExpense) return baseCallToAction;\n\n  const attendeeAcknowledgement = getSimplifiedExtractedAttendeeAcknowledgement();\n  const customerOpenIssue = getSimplifiedCustomerOpenIssue();\n\n  if (!attendeeAcknowledgement || !customerOpenIssue) {\n    return baseCallToAction;\n  }\n\n  return `Reply with the following for the below expense:\\n1. ${attendeeAcknowledgement}\\n2. ${customerOpenIssue}`;\n};\n\nconst buildResponseTemplate = (expense, receipt, effectiveCallToAction) => {\n  const spacing = \"%0A%0A%0A%0A%0A\";\n  if (isPromptLeak()) {\n    return \"\";\n  }\n\n  const { template: attendeeAcknowledgementTemplate, hasExtractedAttendeePrefill } =\n    getSimplifiedAttendeeAcknowledgementTemplate();\n  const specialTemplateLine = buildSpecialResponseTemplateLine(expense);\n  const receiptRequiredTemplateLine = buildReceiptRequiredResponseTemplateLine(expense);\n  const generatedTemplate = sanitizeSystemGeneratedTemplate(systemGeneratedTemplate);\n  const baseEditableTemplate =\n    attendeeAcknowledgementTemplate +\n    (specialTemplateLine ||\n      (hasExtractedAttendeePrefill\n        ? removePrefilledExtractedAttendeePrompt(generatedTemplate)\n        : generatedTemplate));\n  const editableTemplate =\n    baseEditableTemplate +\n    (receiptRequiredTemplateLine && !baseEditableTemplate.includes(receiptRequiredTemplateLine)\n      ? receiptRequiredTemplateLine\n      : \"\");\n  const amount = firstNonNull(expense?.receiptAmount, receipt?.receiptAmount, \"\");\n  const currencyCode = firstNonNull(\n    expense?.receiptCurrency?.currencyCode,\n    receipt?.receiptCurrency?.currencyCode,\n    \"\"\n  );\n  const location = firstNonNull(\n    expense?.expenseLocation?.location,\n    receipt?.expenseLocation?.location,\n    \"\"\n  );\n\n  let responseTemplate =\n    editableTemplate +\n    spacing +\n    \"-----Please type your comments above this line-----\" +\n    spacing +\n    effectiveCallToAction +\n    spacing;\n\n  responseTemplate =\n    responseTemplate +\n    \"Expense Details\" +\n    \"%0A\" +\n    \"Type: \" +\n    esc(expense?.expenseType?.name) +\n    \"%0A\" +\n    \"Merchant: \" +\n    esc(expense?.merchantName) +\n    \"%0A\" +\n    \"Location: \" +\n    esc(location) +\n    \"%0A\" +\n    \"Date: \" +\n    esc(expense?.expenseDate) +\n    \"%0A\" +\n    \"Amount: \" +\n    esc(`${amount} ${currencyCode}`.trim()) +\n    \"%0A\" +\n    \"Status: Needs Review\";\n\n  return responseTemplate;\n};\n\nconst getActiveDelegates = (delegateItems) => {\n  const todayDate = new Date();\n  const activeDelegates = [];\n\n  for (const delegate of delegateItems) {\n    const startDate = new Date(delegate?.startDate);\n    let endDate = delegate?.endDate;\n\n    if (endDate === null) {\n      activeDelegates.push(delegate);\n      continue;\n    }\n\n    endDate = new Date(endDate);\n    if (todayDate < endDate && todayDate > startDate) {\n      activeDelegates.push(delegate);\n    }\n  }\n\n  return activeDelegates;\n};\n\nconst interpolateSubject = (subject, expense, receipt) => {\n  if (!isStr(subject?.message)) {\n    return subject;\n  }\n\n  const merchantName = firstNonNull(\n    expense?.merchantName,\n    receipt?.merchantName,\n    \"\"\n  );\n\n  const expenseType = firstNonNull(\n    expense?.expenseType?.name,\n    receipt?.expenseType?.name,\n    \"\"\n  );\n\n  const expenseDate = firstNonNull(\n    expense?.expenseDate,\n    receipt?.expenseDate,\n    \"\"\n  );\n\n  const amountText = formatSubjectAmount(expense, receipt);\n\n  const item1 = merchantName || expenseType || \"Expense\";\n  const item2 = expenseDate ? formatDateToMMDDYY(expenseDate) : \"\";\n\n  let message = subject.message\n    .split(\"{ITEM1}\")\n    .join(item1)\n    .split(\"{ITEM2}\")\n    .join(item2);\n\n  if (amountText) {\n    if (item1 && item2) {\n      const withDate = `${item1} on ${item2}`;\n      const withAmountAndDate = `${item1} - ${amountText} on ${item2}`;\n\n      if (message.includes(withDate)) {\n        message = message.split(withDate).join(withAmountAndDate);\n      } else if (message.includes(item1)) {\n        message = message.split(item1).join(`${item1} - ${amountText}`);\n      } else {\n        message = `${message} - ${amountText}`;\n      }\n    } else if (item1) {\n      if (message.includes(item1)) {\n        message = message.split(item1).join(`${item1} - ${amountText}`);\n      } else {\n        message = `${message} - ${amountText}`;\n      }\n    } else {\n      message = `${message} - ${amountText}`;\n    }\n  }\n\n  message = message\n    .replace(/\\s+on\\s*$/i, \"\")\n    .replace(/\\s*:\\s*$/i, \"\")\n    .replace(/\\s{2,}/g, \" \")\n    .trim();\n\n  return {\n    ...subject,\n    message\n  };\n};\n\nconst buildPartnerExpenseSummary = (items) => {\n  return items.reduce(\n    (summary, item) => {\n      if (item?.sourceTypeCode === \"MESSAGE\") summary.message = item;\n      if (item?.sourceTypeCode === \"RECEIPT\") summary.receipt = item;\n      return summary;\n    },\n    { message: null, receipt: null }\n  );\n};\n\nconst resolveWorkers = (expense, partnerMessage, partnerReceipt) => {\n  return {\n    owner: firstNonNull(partnerMessage?.person, partnerReceipt?.person, expense?.person, null),\n    preparer: firstNonNull(partnerMessage?.preparer, partnerReceipt?.preparer, expense?.preparerName, null)\n  };\n};\n\nconst hasPartnerTechnicalIssue = (partnerRecord) => {\n  if (!partnerRecord) return false;\n\n  const stageStatus = norm(partnerRecord?.stageStatus);\n\n  return (\n    norm(partnerRecord?.statusCode) === PARTNER_STATUS.ERROR &&\n    (stageStatus === PARTNER_STAGE_STATUS.TECHNICAL_ERROR ||\n      stageStatus === PARTNER_STAGE_STATUS.FACADE_FAILURE)\n  );\n};\n\nconst resolveDelegateScenario = (ownerWorker, preparerWorker, delegateItems) => {\n  const ownerId = ownerWorker?.id || ownerWorker?.$id || \"\";\n  const preparerId = preparerWorker?.id || preparerWorker?.$id || \"\";\n  const activeDelegates = getActiveDelegates(delegateItems);\n\n  const delegateMatch = activeDelegates.find((delegate) => {\n    const delegatorId = delegate?.delegator?.id || delegate?.delegator?.$id;\n    const delegatedId = delegate?.delegated?.id || delegate?.delegated?.$id;\n    return (\n      ownerId &&\n      preparerId &&\n      ownerId !== preparerId &&\n      delegatorId === ownerId &&\n      delegatedId === preparerId\n    );\n  });\n\n  return {\n    activeDelegates,\n    delegateMatch,\n    isDelegateScenario: Boolean(delegateMatch)\n  };\n};\n\nconst buildEmailAddresses = (ownerEmail, preparerEmail, activeDelegates, isDelegateScenario) => {\n  const effectiveDelegateEmails = activeDelegates\n    .map((delegate) => getWorkerEmail(delegate?.delegated))\n    .filter(isStr)\n    .filter((email, index, all) => all.indexOf(email) === index);\n\n  const toEmailAddress = isDelegateScenario\n    ? [preparerEmail].filter(isStr)\n    : [ownerEmail].filter(isStr);\n\n  const ccEmailAddress = isDelegateScenario\n    ? [ownerEmail].filter(isStr)\n    : effectiveDelegateEmails.filter((email) => email !== ownerEmail);\n\n  return { toEmailAddress, ccEmailAddress };\n};\n\nconst hasPredictionNeedsAttentionType = (items) => {\n  return items.some((item) => PREDICTION_NEEDS_ATTENTION_TYPES.has(norm(item?.predictionTypeCode)));\n};\n\nconst pickPartnerSubject = (outcome, sub, hasPredictionNeedsAttention) => {\n  if (hasPredictionNeedsAttention) {\n    return SUBJECT_MESSAGES.review;\n  }\n\n  if (outcome === PARTNER_OUTCOMES.EXPENSE_MATCHED) {\n    if (\n      sub === OUTCOME_SUBREASONS.FIRST_RECEIPT_WITH_TIP_AMT ||\n      sub === OUTCOME_SUBREASONS.FIRST_RECEIPT_WITH_ADDT_AMT\n    ) {\n      return SUBJECT_MESSAGES.receiptAdditionalCharge;\n    }\n\n    if (sub === OUTCOME_SUBREASONS.FIRST_RECEIPT_WITHOUT_ADDT_AMT) {\n      return SUBJECT_MESSAGES.receiptAttached;\n    }\n  }\n\n  if (outcome === PARTNER_OUTCOMES.EMAIL_NOT_PROCESSED) {\n    if (PARTNER_NEEDS_ATTENTION_SUBREASONS.has(sub)) {\n      return SUBJECT_MESSAGES.review;\n    }\n\n    switch (sub) {\n      case OUTCOME_SUBREASONS.INVALID_DELEGATE:\n        return SUBJECT_MESSAGES.review;\n      case OUTCOME_SUBREASONS.RECEIPT_INVALID:\n      case OUTCOME_SUBREASONS.BU_NOT_ENABLED:\n      case OUTCOME_SUBREASONS.INVALID_ERECEIPT_EMAIL:\n      case OUTCOME_SUBREASONS.IDR_AMOUNT_ZERO:\n        return SUBJECT_MESSAGES.creationFailed;\n      case OUTCOME_SUBREASONS.RECEIPT_ALREADY_PROCESSED:\n        return SUBJECT_MESSAGES.duplicateReceipt;\n      case OUTCOME_SUBREASONS.RECEIPT_IGNORED:\n        return SUBJECT_MESSAGES.receiptExists;\n      default:\n        return SUBJECT_MESSAGES.reviewPlain;\n    }\n  }\n\n  return null;\n};\n\nconst hasSupportedExpenseErrorStringCode = (attributeName, errorStringCode) => {\n  const supportedError = SUPPORTED_EXPENSE_ERRORS_BY_ATTRIBUTE[String(attributeName || \"\").toLowerCase()];\n  if (!supportedError) return false;\n  if (supportedError === true) return true;\n  return supportedError.has(norm(errorStringCode));\n};\n\nconst isGenericJustificationRequiredExpenseError = (expenseError) => {\n  if (norm(expenseError?.errorCode) !== \"FND:::FND_CMN_CMPLT_FLDS\") return false;\n\n  const rawAttribute = isStr(expenseError?.stringToken1Value)\n    ? expenseError.stringToken1Value\n    : expenseError?.attributeName;\n\n  return humanizeExpenseErrorLabel(rawAttribute) === \"justification\";\n};\n\nconst isSpecificJustificationExpenseError = (expenseError) => {\n  const errorCode = norm(expenseError?.errorCode);\n  const classicError = CLASSIC_EXPENSE_ERRORS[errorCode];\n  const errorStringCode = norm(expenseError?.errorStringCode);\n\n  return (\n    JUSTIFICATION_LIMIT_TYPES.has(classicError?.limitType) ||\n    SPECIFIC_JUSTIFICATION_ERROR_STRING_CODES.has(errorStringCode)\n  );\n};\n\nconst suppressDuplicateGenericJustificationErrors = (expenseErrors) => {\n  if (!Array.isArray(expenseErrors) || !expenseErrors.some(isSpecificJustificationExpenseError)) {\n    return expenseErrors;\n  }\n\n  return expenseErrors.filter((expenseError) => !isGenericJustificationRequiredExpenseError(expenseError));\n};\n\nconst isNeedsAttentionExpenseError = (expenseError) =>\n  CLASSIC_EXPENSE_ERRORS[norm(expenseError?.errorCode)]?.needsAttention === true;\n\nconst isSummarizableExpenseError = (expenseError) => {\n  if (!expenseError) return false;\n  if (norm(expenseError?.errorStringCode) === EXPENSE_ERROR_STRING_CODES.RECEIPT_REQUIRED) return true;\n  if (CLASSIC_EXPENSE_ERRORS[norm(expenseError?.errorCode)]) return true;\n\n  return hasSupportedExpenseErrorStringCode(expenseError?.attributeName, expenseError?.errorStringCode);\n};\n\nconst isUserActionSummarizableExpenseError = (expenseError) =>\n  expenseError?.userActionRequiredFlag === true &&\n  norm(expenseError?.objectName) !== \"NA\" &&\n  isSummarizableExpenseError(expenseError);\n\nconst isActionableUserActionExpenseError = (expenseError) =>\n  expenseError?.userActionRequiredFlag === true &&\n  norm(expenseError?.objectName) !== \"NA\" &&\n  (expenseError?.warningFlag !== true || isSpecificJustificationExpenseError(expenseError));\n\nconst isActionableSummarizableExpenseError = (expenseError) =>\n  isActionableUserActionExpenseError(expenseError) &&\n  isSummarizableExpenseError(expenseError);\n\nconst isSupportedExpenseError = (expenseError) => {\n  if (!expenseError) return false;\n  if (norm(expenseError?.errorStringCode) === EXPENSE_ERROR_STRING_CODES.RECEIPT_REQUIRED) return true;\n  const errorCode = norm(expenseError?.errorCode);\n  const classicError = CLASSIC_EXPENSE_ERRORS[errorCode];\n  if (classicError?.useAttributeName) {\n    return Boolean(SUPPORTED_EXPENSE_ERRORS_BY_ATTRIBUTE[String(expenseError?.attributeName || \"\").toLowerCase()]);\n  }\n  if (classicError) return true;\n\n  return hasSupportedExpenseErrorStringCode(expenseError?.attributeName, expenseError?.errorStringCode);\n};\n\nconst hasCustomerOrganizationOpenIssue = (attributes) => {\n  if (!Array.isArray(attributes)) return false;\n\n  return attributes.some((attribute) => {\n    const normalized = String(attribute || \"\").toLowerCase();\n    return (\n      normalized.includes(\"customer or partner organization\") ||\n      normalized.includes(\"customer or partner org\") ||\n      normalized.includes(\"customer organization\") ||\n      normalized.includes(\"partner organization\")\n    );\n  });\n};\n\nconst buildExpenseSubject = (expense) => {\n  if (isPendingFinalChargeExpense(expense)) {\n    return SUBJECT_MESSAGES.pendingFinalCharge;\n  }\n\n  if (\n    hasItemizedExpenseValidationIssues(itemizedExpenseItems)\n  ) {\n    return SUBJECT_MESSAGES.review;\n  }\n\n  const rawExpenseErrors = expense?.expenseErrors?.items || [];\n  const expenseErrors = Array.isArray(rawExpenseErrors)\n    ? suppressDuplicateGenericJustificationErrors(\n        rawExpenseErrors.filter((error) => isActionableSummarizableExpenseError(error))\n      )\n    : [];\n  const syntheticOpenIssueAttributes = expense?.syntheticOpenIssueAttributes || [];\n  const errorCount = expenseErrors.length;\n\n  if (errorCount === 0) {\n    if (hasCustomerOrganizationOpenIssue(syntheticOpenIssueAttributes)) {\n      return SUBJECT_MESSAGES.customerInfo;\n    }\n\n    if (syntheticOpenIssueAttributes.includes(\"names and emails of the attendees\")) {\n      return SUBJECT_MESSAGES.attendees;\n    }\n\n    return autoSubmissionEnabledFlag === \"Y\"\n      ? SUBJECT_MESSAGES.expenseAutoSubmitted\n      : SUBJECT_MESSAGES.expenseReadyToSubmit;\n  }\n\n  if (expenseErrors.some((expenseError) => !isSupportedExpenseError(expenseError))) {\n    return SUBJECT_MESSAGES.review;\n  }\n\n  if (expenseErrors.some(isNeedsAttentionExpenseError)) {\n    return SUBJECT_MESSAGES.review;\n  }\n\n  if (expenseErrors.some((expenseError) => norm(expenseError?.errorCode) === \"EXM_NONEMP_PREAPPROVAL\")) {\n    return SUBJECT_MESSAGES.preApprovalForm;\n  }\n\n  if (errorCount === 1) {\n    const expenseError = expenseErrors[0];\n    const errorCode = norm(expenseError?.errorCode);\n    const classicError = CLASSIC_EXPENSE_ERRORS[errorCode];\n    const attributeName = String(expenseError?.attributeName || classicError?.attribute || \"\").trim();\n    const limitSubject = buildLimitSubject(expenseError);\n\n    if (limitSubject) {\n      return limitSubject;\n    }\n\n    if (expenseError?.errorStringCode?.endsWith(\"JSTF\")) {\n      return SUBJECT_MESSAGES.justification;\n    }\n\n    if (\n      errorCode === \"EXM:::EXM_ATTENDEE_EMPLOYEE_REQ\" ||\n      errorCode === \"EXM:::EXM_REQ_NONEMPLOYEE\"\n    ) {\n      return SUBJECT_MESSAGES.attendees;\n    }\n\n    if (\n      errorCode === \"EXM:::EXM_ERECP_PROJ_TASK_REQD\" ||\n      attributeName === \"ora_flex_projectsCostCollection__info\"\n    ) {\n      return SUBJECT_MESSAGES.projectInfo;\n    }\n\n    return toNeededSubject(expenseError?.stringToken1Value || attributeName);\n  }\n\n  if (errorCount < 3) {\n    return SUBJECT_MESSAGES.additionalInfo;\n  }\n\n  return SUBJECT_MESSAGES.review;\n};\n\nconst displayString = (value) =>\n  value === null || value === undefined ? \"\" : String(value);\n\nconst normalizeRecommendationOption = (option) => ({\n  ...option,\n  fieldName1: displayString(option?.fieldName1),\n  fieldName2: displayString(option?.fieldName2),\n  fieldNumber1: displayString(option?.fieldNumber1),\n  fieldNumber2: displayString(option?.fieldNumber2),\n  rank: displayString(option?.rank)\n});\n\nconst buildRecommendations = (recommendationItems) => {\n  const groupedRecommendations = Object.values(\n    recommendationItems.reduce((accumulator, recommendation) => {\n      const type = recommendation?.type;\n      const normalizedType = String(type || \"\").toLowerCase();\n      if (!isStr(type) || normalizedType === \"attendees\") {\n        return accumulator;\n      }\n\n      const groupType = [\"account\", \"accounts\"].includes(normalizedType) ? \"company\" : type;\n\n      if (!accumulator[groupType]) {\n        accumulator[groupType] = {\n          type: groupType,\n          keys: recommendation?.keys ?? { partnerExpenseId: \"-\" },\n          options: []\n        };\n      }\n\n      accumulator[groupType].options.push(\n        normalizeRecommendationOption(recommendation?.fieldValue || {})\n      );\n      return accumulator;\n    }, {})\n  );\n\n  const includeRecs = groupedRecommendations.length > 0;\n  let recommendationSummary = \"\";\n  if (groupedRecommendations.length === 1) {\n    const groupedRecommendation = groupedRecommendations[0] || {};\n    const recommendationType = String(groupedRecommendation?.type || \"\").toLowerCase();\n    if (recommendationType === \"company\") {\n      const hasCompanyAndCostCenterOptions = (groupedRecommendation.options || []).some(\n        (option) => isStr(option?.fieldName2) && isStr(option?.fieldNumber2)\n      );\n      recommendationSummary = hasCompanyAndCostCenterOptions\n        ? RECOMMENDATION_SUMMARY_BY_TYPE.accounts\n        : \"Below are the recommended cost centers\";\n    } else {\n      recommendationSummary = RECOMMENDATION_SUMMARY_BY_TYPE[recommendationType] || \"\";\n    }\n  }\n\n  return {\n    includeRecs,\n    recommendations: includeRecs\n      ? {\n          recommendationSummary,\n          recommendationList: groupedRecommendations\n        }\n      : undefined\n  };\n};\n\nconst deriveMessageOutcomeStatus = (\n  summarizedDataInput,\n  partnerOutcome,\n  partnerSubReason,\n  hasExpenseData,\n  hasTechnicalIssue\n) => {\n  const recommendations = summarizedDataInput?.recommendations?.data || [];\n  const userActionErrors =\n    summarizedDataInput?.openIssues?.data?.expenseErrors?.items?.filter(isActionableUserActionExpenseError) ||\n    [];\n  const syntheticOpenIssueAttributes =\n    summarizedDataInput?.openIssues?.data?.syntheticOpenIssueAttributes || [];\n  const summaryExpenseData = summarizedDataInput?.openIssues?.data || {};\n  const summaryItemizedExpenseItems =\n    summaryExpenseData?.itemizedExpenseItems ||\n    summaryExpenseData?.itemizedExpenses?.items ||\n    summaryExpenseData?.itemizedExpenses ||\n    [];\n  const hasItemizedExpenseIssues =\n    hasItemizedExpenseValidationIssues(summaryItemizedExpenseItems);\n  const hasUnsupportedExpenseError = userActionErrors.some((item) => !isSupportedExpenseError(item));\n  const hasNeedsAttentionExpenseError = userActionErrors.some(isNeedsAttentionExpenseError);\n\n  if (hasTechnicalIssue) {\n    return \"ORA_EXPENSE_UPDATE_TECHNICAL_FAILURE\";\n  }\n\n  if (PARTNER_NEEDS_ATTENTION_SUBREASONS.has(partnerSubReason)) {\n    return \"ORA_EXPENSE_SUBREASON_FAILURE\";\n  }\n\n  if (partnerOutcome === PARTNER_OUTCOMES.EMAIL_NOT_PROCESSED) {\n    return \"ORA_EXPENSE_CREATION_FAILED\";\n  }\n\n  if (hasUnsupportedExpenseError || hasNeedsAttentionExpenseError || hasItemizedExpenseIssues) {\n    return \"ORA_EXPENSE_REQUIRED_USER_INPUT_UNSUPPORTED_ERROR\";\n  }\n\n  if (\n    userActionErrors.length > 0 ||\n    recommendations.length > 0 ||\n    syntheticOpenIssueAttributes.length > 0\n  ) {\n    return \"ORA_EXPENSE_REQUIRED_USER_INPUT\";\n  }\n\n  if (hasExpenseData && EMAIL_EXPENSE_OUTCOME_CODES.has(partnerOutcome)) {\n    return \"ORA_EXPENSE_CLEAN\";\n  }\n\n  return \"ORA_EXPENSE_MESSAGE_OUTCOME_NOT_FOUND\";\n};\n\nconst buildPayload = () => {\n  const partnerExpenseSummary = buildPartnerExpenseSummary(partnerExpenseItems);\n  const partnerExpenseMessage = partnerExpenseSummary.message;\n  const partnerExpenseReceipt = partnerExpenseSummary.receipt;\n  const expenseId = $context.$triggers.REST.$input.expenseId || \"\";\n  const hasExpenseData = Object.keys(expenseData || {}).length > 0;\n  const partnerOutcome = partnerExpenseMessage?.partnerExpenseOutcome;\n  const expenseOutcomeCode = EMAIL_EXPENSE_OUTCOME_CODES.has(partnerOutcome) ? partnerOutcome : undefined;\n  const partnerSub = partnerExpenseMessage?.outcomeSubReason;\n  const hasPredictionNeedsAttention = hasPredictionNeedsAttentionType(predictionItems);\n  const hasTechnicalIssue = hasPartnerTechnicalIssue(partnerExpenseMessage);\n  const hasItemizedExpenseIssues =\n    hasItemizedExpenseValidationIssues(itemizedExpenseItems);\n  const hasNeedsAttentionExpenseError = (expenseData?.expenseErrors?.items || []).some(\n    (error) =>\n      isActionableSummarizableExpenseError(error) &&\n      isNeedsAttentionExpenseError(error)\n  );\n  const isFailure =\n    hasTechnicalIssue ||\n    !hasExpenseData ||\n    (partnerOutcome === PARTNER_OUTCOMES.EMAIL_NOT_PROCESSED &&\n      !hasPredictionNeedsAttention &&\n      !PARTNER_NEEDS_ATTENTION_SUBREASONS.has(partnerSub));\n\n  const workers = resolveWorkers(expenseData, partnerExpenseMessage, partnerExpenseReceipt);\n  const ownerEmail = getWorkerEmail(workers.owner);\n  const preparerEmail = getWorkerEmail(workers.preparer);\n  const ownerDisplayName = getWorkerDisplayName(workers.owner);\n\n  const delegateResolution = resolveDelegateScenario(workers.owner, workers.preparer, delegates);\n  const emailAddresses = buildEmailAddresses(\n    ownerEmail,\n    preparerEmail,\n    delegateResolution.activeDelegates,\n    delegateResolution.isDelegateScenario\n  );\n\n  let messageObject = pickPartnerSubject(partnerOutcome, partnerSub, hasPredictionNeedsAttention);\n  if (hasTechnicalIssue) {\n    messageObject = hasExpenseData ? SUBJECT_MESSAGES.review : SUBJECT_MESSAGES.reviewPlain;\n  }\n  if (!messageObject) {\n    messageObject = hasExpenseData ? buildExpenseSubject(expenseData) : SUBJECT_MESSAGES.reviewPlain;\n  }\n  if (isPromptLeak()) {\n    messageObject = hasExpenseData ? SUBJECT_MESSAGES.review : SUBJECT_MESSAGES.reviewPlain;\n  }\n\n  const isExpenseCreatedScenario = hasExpenseData && !isFailure;\n\n  if (hasExpenseData) {\n    messageObject = interpolateSubject(\n      messageObject,\n      expenseData,\n      partnerExpenseReceipt\n    );\n  }\n\n  const delegatorPrefix = delegateResolution.isDelegateScenario ? formatDelegatorPrefix(ownerDisplayName) : \"\";\n  const amount = firstNonNull(\n    expenseData?.receiptAmount,\n    partnerExpenseReceipt?.receiptAmount,\n    expenseData?.personalReceiptAmount,\n    partnerExpenseReceipt?.personalReceiptAmount,\n    \"-\"\n  );\n\n  const currencyCode = firstNonNull(\n    expenseData?.receiptCurrency?.currencyCode,\n    partnerExpenseReceipt?.receiptCurrency?.currencyCode,\n    expenseData?.currencyCode,\n    partnerExpenseReceipt?.currencyCode,\n    \"-\"\n  );\n  const title = {\n    messageStringId: messageObject?.messageStringId || \"0\",\n    message: delegatorPrefix ? `${delegatorPrefix} ${messageObject?.message || \"\"}` : messageObject?.message || \"\",\n    tokens: {\n      amount,\n      currencyCode,\n      formattedAmount:\n        amount !== \"-\" && currencyCode !== \"-\"\n          ? `${amount} ${currencyCode}`\n          : amount,\n      merchantName: firstNonNull(\n        expenseData?.merchantName,\n        partnerExpenseReceipt?.merchantName,\n        \"-\"\n      ),\n      expenseType: firstNonNull(\n        expenseData?.expenseType?.name,\n        partnerExpenseReceipt?.expenseType?.name,\n        \"-\"\n      )\n    }\n  };\n\n  const recommendationResult = buildRecommendations(summarizedData?.recommendations?.data || []);\n  const messageOutcomeStatus = deriveMessageOutcomeStatus(\n    summarizedData,\n    partnerOutcome,\n    partnerSub,\n    hasExpenseData,\n    hasTechnicalIssue\n  );\n  const promptLeak = isPromptLeak();\n  const specialResponseTemplateLine = buildSpecialResponseTemplateLine(expenseData);\n  const fallbackMessageObject = SUBJECT_MESSAGES.reviewPlain;\n  const includeHeading = delegateResolution.isDelegateScenario && isExpenseCreatedScenario;\n  const messageType = isFailure && !expenseOutcomeCode ? \"ERROR\" : \"CLEAN\";\n  const isCleanExpenseMissingId = messageType === \"CLEAN\" && !String(expenseId).trim();\n  const effectiveMessageObject = isCleanExpenseMissingId ? fallbackMessageObject : messageObject;\n  const effectiveCallToAction = isCleanExpenseMissingId\n    ? getUnexpectedIssueCallToAction()\n    : promptLeak\n      ? getUnexpectedIssueCallToAction()\n      : callToAction;\n  const hasInlineTemplate =\n    !promptLeak &&\n    !isCleanExpenseMissingId &&\n    !specialResponseTemplateLine &&\n    Boolean(systemGeneratedTemplate && String(systemGeneratedTemplate).trim());\n  const actionType = hasNeedsAttentionExpenseError || hasItemizedExpenseIssues ? \"APP\" : hasInlineTemplate ? \"INLINE_TEMPLATE\" : \"APP\";\n  const responseTemplate = buildResponseTemplate(expenseData, partnerExpenseReceipt, effectiveCallToAction);\n  const displayCallToAction =\n    !promptLeak && !isCleanExpenseMissingId && !isFailure\n      ? buildSimplifiedAttendeeCustomerCallToAction(effectiveCallToAction)\n      : effectiveCallToAction;\n  const effectiveMessageType = isCleanExpenseMissingId ? \"ERROR\" : messageType;\n  const effectiveTitle = {\n    ...title,\n    messageStringId: effectiveMessageObject?.messageStringId || \"0\",\n    message: delegatorPrefix ? `${delegatorPrefix} ${effectiveMessageObject?.message || \"\"}` : effectiveMessageObject?.message || \"\"\n  };\n  const badge = buildExpensePrimaryBadge(expenseData);\n\n  return {\n    expenseData,\n    params: {\n      messageType: effectiveMessageType,\n      ...(!isCleanExpenseMissingId && expenseOutcomeCode ? { expenseOutcomeCode } : {}),\n      toEmailAddress: emailAddresses.toEmailAddress,\n      ccEmailAddress: emailAddresses.ccEmailAddress,\n      keys: {\n        expenseId,\n        partnerExpenseId: $context.$triggers.REST.$input.partnerExpenseId || \"\",\n        matchedExpenseId: \"-\"\n      },\n      displayRules: {\n        recommendations: recommendationResult.includeRecs,\n        actions: true,\n        heading: includeHeading,\n        badge: Boolean(badge)\n      },\n      emailSubject: effectiveTitle,\n      isReplyFlow: $context.$triggers.REST.$input.replyFlow,\n      expenseTypeCategoryCode: expenseData?.expenseTypeCategory?.lookupCode || \"-\",\n      messageOutcomeStatus,\n      emailBody: {\n        callToAction: displayCallToAction,\n        ...(badge ? { badge } : {}),\n        ...(recommendationResult.includeRecs ? { recommendations: recommendationResult.recommendations } : {}),\n        ...(includeHeading ? { heading: { text: `On Behalf Of ${ownerDisplayName}` } } : {})\n      },\n      actions: {\n        actionName: \"Reply\",\n        displayName: \"Reply\",\n        responseTemplate,\n        actionType\n      }\n    }\n  };\n};\n\nreturn buildPayload();\n"
