        {
          "metadata": {
            "description": "Builds outcome-store payload for brief summary persistence.",
            "errorNodeId": "1776853309343",
            "name": "Brief Summary Persistance Payload",
            "returnType": "array",
            "sourceCode": "const optyData = $context.$variables.optyDetails;\n\nif (!optyData) {\n  return null;\n}\n\nconst optyDetails = {\n  optyId: optyData[0]?.OptyId,\n  optyNumber: optyData[0]?.OptyNumber,\n  optyName: optyData[0]?.Name\n};\n\nconst topSummary =\n  $context.$nodes.GENERATE_OPPORTUNITY_RESPONSE.$output;\n\nconst payload = {\n  schemaVersion: \"1.0\",\n  what: {\n    title: `${optyDetails.optyName} ��������� Opportunity Brief Summary`,\n    summary: topSummary\n  }\n};\n\nreturn [\n  {\n    '$operation': \"MERGE\",\n    '$lookupBy': {\n      outcomeType: \"SUMMARY\",\n      outcomeSubtype: \"STATE_SUMMARY\",\n      category: \"USAGE\",\n      primaryObjectType: \"OPPORTUNITY\",\n      primaryObjectAltKey: optyDetails.optyNumber\n    },\n    outcomeType: \"SUMMARY\",\n    outcomeSubtype: \"STATE_SUMMARY\",\n    category: \"USAGE\",\n    primaryObjectType: \"OPPORTUNITY\",\n    primaryObjectKey: optyDetails.optyId,\n    primaryObjectAltKey: optyDetails.optyNumber,\n    status: \"ACTIVE\",\n    urgency: \"MEDIUM\",\n    generatedBy: \"agent:DealAdvisorWorkflow/v1\",\n    agentJobKey: $context.$workflow.$traceId,\n    effectiveDate: `${$context.$system.$currentDateTime}Z`,\n    payload: JSON.stringify(payload)\n  }\n];"
          },
          "outcomes": {
            "success": "1776852744863"
          },
          "diagram": {
            "x": 7092,
            "y": 10100
          },
          "code": "BRIEF_SUMMARY_PERSISTANCE_PAYLOAD",
          "id": "1777451452502",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "description": "Builds opportunity and activity query expressions from the input opportunity number.",
            "errorNodeId": null,
            "name": "Prepare Query Param",
            "returnType": "object",
            "sourceCode": "const output = {};\nconst optyNumber = $context.$triggers.REST.$input.OptyNumber;\n// Activity\noutput.QExpressionActivity = {\n  op: '$and',\n  criteria: [{\n    op: '$eq',\n    attribute: 'OpportunityId.OptyNumber',\n    value: optyNumber \n  }]\n};\n// Opportunity\noutput.QExpressionOpty = {\n   op: '$and',\n  criteria: [{\n    op: '$eq',\n    attribute: 'OptyNumber',\n    value: optyNumber \n  }]\n};\n\nreturn output;"
          },
          "outcomes": {
            "success": "1771925744415"
          },
          "diagram": {
            "x": 5492,
            "y": 6350
          },
          "code": "PREPARE_QUERY_PARAM",
          "id": "1771925857230",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "description": "Builds outcome-store payload for full summary persistence.",
            "errorNodeId": "1776853309343",
            "name": "Summary Persistance Payload",
            "returnType": "array",
            "sourceCode": "const optyData = $context.$variables.optyDetails;\n\nif (!optyData) {\n  return null;\n}\n\nconst optyDetails = {\n  optyId: optyData[0]?.OptyId,\n  optyNumber: optyData[0]?.OptyNumber,\n  optyName: optyData[0]?.Name\n};\n\nconst topSummary =\n  $context.$nodes.GENERATE_OPPORTUNITY_RESPONSE.$output;\n\nconst payload = {\n  schemaVersion: \"1.0\",\n  what: {\n    title: `${optyDetails.optyName} ��������� Opportunity Summary`,\n    summary: topSummary\n  }\n};\n\nreturn [\n  {\n    '$operation': \"MERGE\",\n    '$lookupBy': {\n      outcomeType: \"SUMMARY\",\n      outcomeSubtype: \"STATE_SUMMARY\",\n      category: \"ENGAGEMENT\",\n      primaryObjectType: \"OPPORTUNITY\",\n      primaryObjectAltKey: optyDetails.optyNumber\n    },\n    outcomeType: \"SUMMARY\",\n    outcomeSubtype: \"STATE_SUMMARY\",\n    category: \"ENGAGEMENT\",\n    primaryObjectType: \"OPPORTUNITY\",\n    primaryObjectKey: optyDetails.optyId,\n    primaryObjectAltKey: optyDetails.optyNumber,\n    status: \"ACTIVE\",\n    urgency: \"MEDIUM\",\n    generatedBy: \"agent:DealAdvisorWorkflow/v1\",\n    agentJobKey: $context.$workflow.$traceId,\n    effectiveDate: `${$context.$system.$currentDateTime}Z`,\n    payload: JSON.stringify(payload)\n  }\n];"
          },
          "outcomes": {
            "success": "1776853145981"
          },
          "diagram": {
            "x": 5292,
            "y": 10400
          },
          "code": "SUMMARY_PERSISTANCE_PAYLOAD",
          "id": "1777451618335",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
