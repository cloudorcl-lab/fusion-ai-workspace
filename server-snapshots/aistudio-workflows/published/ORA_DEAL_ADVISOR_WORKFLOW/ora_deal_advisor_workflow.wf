            "returnType": "boolean",
            "sourceCode": "const intentArray = $context.$variables.intentArray;\nconst outputs = $context.$variables.context;\n\nif (!outputs || Object.keys(outputs).length === 0) {\n    return false;\n}\n\nreturn intentArray.every(intent => \n    intent !== \"CHATATTATCHMENT\" && intent in outputs\n);"
