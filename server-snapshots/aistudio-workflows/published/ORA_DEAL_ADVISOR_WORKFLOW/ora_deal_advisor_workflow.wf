        {
          "metadata": {
            "description": "Process the context passed from the Context Builder Agent.",
            "name": "Retrieve the Context",
            "returnType": "object",
            "sourceCode": "// outer is the whole response you pasted\nconst output = {};\n\nconst intentArray = $context.$variables.intentArray || [];\nconst raw = $context.$nodes.GET_INTENT_CONTEXT.$output;\n\n// Parse outer only if needed\nconst outer = typeof raw === \"string\" ? JSON.parse(raw) : raw;\n\nlet sourceOutput = outer?.output|| {};\nsourceOutput = typeof sourceOutput === \"string\" ? JSON.parse(sourceOutput) : sourceOutput;\n\nlet sourceOutputResult = sourceOutput?.result || {};\nsourceOutputResult = typeof sourceOutputResult === \"string\" ? JSON.parse(sourceOutputResult) : sourceOutputResult;\n\n// Retrieve all the intent\nfor (let i = 0; i < intentArray.length; i++) {\n  const intent = intentArray[i];\n  if (intent === 'OPPORTUNITY') {\n      continue;\n  }\n  let resp = sourceOutputResult?.[intent];\n\n  // optional: if resp is a JSON string, parse it ACTIVITY: EMAIL: \n  if (typeof resp === \"string\") {\n    try { resp = JSON.parse(resp); } catch (e) {}\n  }\n\n  output[intent] = resp;   // store the whole response for that intent\n}\nreturn output;"
          },
          "outcomes": {
            "success": "1775000000002"
          },
          "diagram": {
            "x": 6092,
            "y": 8750
          },
          "code": "RETRIEVE_THE_CONTEXT",
          "convergenceTargetId": "1775467807441",
          "id": "1774434160451",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
