          "code": "GET_LEARNING_ITEMS_AT_RISK_FOR_REPORT",
          "id": "1774100000000",
          "inputs": [
            {
              "id": "1774100000000_payload",
              "name": "payload",
              "type": "string",
              "value": "{\"offset\":0,\"securityFilters\":{\"type\":\"MANAGER\"},\"limit\":100,\"filters\":[{\"name\":\"reports\",\"value\":\"DIRECT_REPORTS\"},{\"name\":\"enrollments\",\"value\":\"CURRENT\"},{\"terms\":[\"ORA_ASSN_REC_NOTSTARTED\",\"ORA_ASSN_REC_NO_OFFR\",\"ORA_ASSN_REC_INPROGRESS\"],\"name\":\"assignmentSubStatus\"}],\"sort\":[{\"name\":\"overdueLearning\",\"direction\":\"desc\"}]}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Prepare Team Report Params",
            "returnType": "string",
            "sourceCode": "const parseMaybe = (value) => {\n  if (typeof value !== 'string') return value;\n  const trimmed = value.trim();\n  if (!trimmed) return value;\n  try {\n    return JSON.parse(trimmed);\n  } catch (e) {\n    return value;\n  }\n};\n\nconst clean = (value) => {\n  if (value == null) return '';\n  return String(value).trim();\n};\n\nconst toInt = (value) => {\n  if (typeof value === 'number' && Number.isFinite(value)) {\n    return Math.max(0, Math.floor(value));\n  }\n\n  const text = clean(value);\n  if (!text) return 0;\n\n  const parsed = Number(text);\n  return Number.isFinite(parsed) ? Math.max(0, Math.floor(parsed)) : 0;\n};\n\nconst escapeXml = (value) => clean(value)\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .replace(/\"/g, '&quot;')\n  .replace(/'/g, '&apos;');\n\nconst readCommParams = (value) => {\n  const parsed = parseMaybe(value);\n  return Array.isArray(parsed) ? parsed : [];\n};\n\nconst commParams = readCommParams($context.$app.$OraCommParamsToFill);\n\nconst learnerDisplay =\n  $context.$nodes.PREPARE_LEARNERS_AT_RISK_DISPLAY.$output.result || {};\n\nconst learningRaw =\n  $context.$nodes.GET_LEARNING_ITEMS_AT_RISK_FOR_REPORT.$output || {};\n\nconst learningItems = Array.isArray(learningRaw.items)\n  ? learningRaw.items\n  : [];\n\nconst riskParam = commParams.find(\n  (param) => clean(param.title) === 'Risk Summary and Details'\n) || {\n  id: '6067c3f0-e56b-4827-b743-c9f85828d1be',\n  title: 'Risk Summary and Details'\n};\n\nconst overdueParam = commParams.find(\n  (param) => clean(param.title) === 'Overdue Summary'\n) || {\n  id: '369c32f1-897c-4939-b24f-beac6e10ebce',\n  title: 'Overdue Summary'\n};\n\nconst normalizedLearning = learningItems\n  .map((record) => ({\n    learningItemTitle: clean(record.learningItemTitle),\n    overdueLearningCount: toInt(record.overdueLearningCount),\n    dueNextMonthLearningCount: toInt(record.dueNextMonthLearningCount)\n  }))\n  .filter((item) => item.learningItemTitle);\n\nconst totalOverdue = normalizedLearning.reduce(\n  (sum, item) => sum + item.overdueLearningCount,\n  0\n);\n\nconst totalDueNextMonth = normalizedLearning.reduce(\n  (sum, item) => sum + item.dueNextMonthLearningCount,\n  0\n);\n\nconst topLearning = normalizedLearning\n  .filter((item) => item.overdueLearningCount > 0)\n  .sort((left, right) => {\n    if (left.overdueLearningCount !== right.overdueLearningCount) {\n      return right.overdueLearningCount - left.overdueLearningCount;\n    }\n\n    return left.learningItemTitle.localeCompare(right.learningItemTitle);\n  })\n  .slice(0, 2);\n\nconst topLearningText = topLearning.length\n  ? topLearning\n      .map(\n        (item) =>\n          `${item.learningItemTitle} (${item.overdueLearningCount} overdue)`\n      )\n      .join(', ')\n  : 'None';\n\nconst topLearners = Array.isArray(learnerDisplay.topImpacted)\n  ? learnerDisplay.topImpacted\n  : [];\n\nconst topLearnerText = topLearners.length\n  ? topLearners\n      .map(\n        (item) =>\n          `${clean(item.learnerName)} (${toInt(item.overdueCount)} overdue)`\n      )\n      .join(', ')\n  : 'None';\n\nconst riskLines = [\n  `Total Learners: ${toInt(learnerDisplay.teamSize)}`,\n  `Overdue count: ${totalOverdue}`,\n  `Due within 30 days: ${totalDueNextMonth}`,\n  `Highest-Risk Learning: ${topLearningText}`,\n  `Highest-Risk Learners: ${topLearnerText}`\n];\n\nconst overdueItems = Array.isArray(learnerDisplay.items)\n  ? learnerDisplay.items\n  : [];\n\nconst overdueLines = overdueItems.length\n  ? overdueItems.map(\n      (item) =>\n        `${clean(item.learnerName)}: ${toInt(item.overdueCount)} overdue`\n    )\n  : ['No overdue learners'];\n\nconst buildParam = (param, text) =>\n  `<parameter id=\"${escapeXml(param.id)}\" title=\"${escapeXml(param.title)}\">${escapeXml(text)}</parameter>`;\n\nconst result = [\n  buildParam(riskParam, riskLines.join('\\n')),\n  buildParam(overdueParam, overdueLines.join('\\n'))\n].join('');\n\nreturn result;"
          },
          "outcomes": {
            "success": "1767986550822"
          },
          "code": "PREPARE_TEAM_REPORT_PARAMS",
          "id": "1774100000001",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
