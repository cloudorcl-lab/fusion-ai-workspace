        {
          "metadata": {
            "name": "Add Data To History",
            "returnType": "object",
            "sourceCode": "const maxSize = 3;  // adjust as needed\n\nconst rawPastData = $context.$variables.dataHistory;\nconst runData = ($context.$nodes.GET_DATA_TO_ANSWER_QUERY.$output ?? null); \n\n// Normalize existing past data to { runCount, records[] } \nconst pastData = (rawPastData && typeof rawPastData === \"object\" && Array.isArray(rawPastData.records))\n  ? { runCount: Number(rawPastData.runCount) || rawPastData.records.length, records: rawPastData.records.slice() }\n  : (Array.isArray(rawPastData)\n      ? { runCount: rawPastData.length, records: rawPastData.slice() }\n      : { runCount: 0, records: [] });\n\n// Build new record\nconst record = {\n  timestamp: new Date().toISOString(),\n  runData\n};\n\n// Append and cap size by dropping oldest\npastData.records.push(record);\nwhile (pastData.records.length > maxSize) pastData.records.shift();\n\n// Increment total run counter (ever), independent of cap\npastData.runCount = (Number(pastData.runCount) || 0) + 1;\n\n// Return updated past data object\nreturn pastData;"
          },
          "outcomes": {
            "success": "1767824156869"
          },
