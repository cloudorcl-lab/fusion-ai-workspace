          "code": "GET_LEARNERS_AT_RISK",
          "convergenceTargetId": "1766441665548",
          "id": "1767748269777",
          "inputs": [
            {
              "id": "1772071000000_1",
              "name": "payload",
              "type": "string",
              "value": "{\"securityFilters\":{\"type\":\"MANAGER\"},\"filters\":[{\"name\":\"reports\",\"value\":\"DIRECT_REPORTS\"},{\"name\":\"enrollments\",\"value\":\"CURRENT\"}],\"sort\":[{\"name\":\"overdueLearning\",\"direction\":\"desc\"}],\"offset\":0,\"limit\":50}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Prepare Learners At Risk Display",
            "returnType": "object",
            "sourceCode": "const raw = $context.$nodes.GET_LEARNERS_AT_RISK.$output;\nconst nowIso = $context.$system.$currentDateTime || new Date().toISOString();\nconst asOfDate = new Date(nowIso).toISOString().slice(0, 10);\n\nconst parseMaybe = (value) => {\n  if (typeof value !== 'string') return value;\n  const trimmed = value.trim();\n  if (!trimmed) return value;\n  try {\n    return JSON.parse(trimmed);\n  } catch {\n    return value;\n  }\n};\n\nconst unwrapArray = (value) => {\n  let current = parseMaybe(value);\n  for (let i = 0; i < 6; i += 1) {\n    if (Array.isArray(current)) return current;\n    if (!current || typeof current !== 'object') return [];\n    const next = [current.items, current.records, current.data, current.result, current.output]\n      .map(parseMaybe)\n      .find((candidate) => candidate != null);\n    if (next == null || next === current) return [];\n    current = next;\n  }\n  return Array.isArray(current) ? current : [];\n};\n\nconst clean = (value) => {\n  if (value == null) return '';\n  return String(value).trim();\n};\n\nconst toInt = (value) => {\n  if (typeof value === 'number' && Number.isFinite(value)) return Math.max(0, Math.floor(value));\n  const text = clean(value);\n  if (!text) return 0;\n  const parsed = Number(text);\n  return Number.isFinite(parsed) ? Math.max(0, Math.floor(parsed)) : 0;\n};\n\nconst pluralize = (count, singular, plural) => `${count} ${count === 1 ? singular : plural}`;\n\nconst records = unwrapArray(raw);\nconst normalized = records.map((record) => {\n  const learnerId = clean(record.assignedToId);\n  const learnerName = clean(record.assignedToDisplayName);\n  const requiredCount = toInt(record.requiredLearningCount);\n  const voluntaryCount = toInt(record.voluntaryLearningCount);\n  const overdueCount = toInt(record.overdueLearningCount);\n  const totalAssigned = requiredCount + voluntaryCount;\n\n  return {\n    learnerId,\n    learnerName,\n    requiredCount,\n    voluntaryCount,\n    overdueCount,\n    totalAssigned,\n    actionQuery: `learnerId=${encodeURIComponent(learnerId)}&learnerName=${encodeURIComponent(learnerName)}`\n  };\n});\n\nconst items = normalized\n  .filter((item) => item.overdueCount > 0)\n  .sort((left, right) => {\n    if (left.overdueCount !== right.overdueCount) return right.overdueCount - left.overdueCount;\n    if (left.totalAssigned !== right.totalAssigned) return right.totalAssigned - left.totalAssigned;\n    return left.learnerName.localeCompare(right.learnerName);\n  })\n  .map((item) => ({\n    learnerName: item.learnerName,\n    overdueCount: item.overdueCount,\n    requiredCount: item.requiredCount,\n    voluntaryCount: item.voluntaryCount,\n    badgeText: 'Overdue',\n    priority: 'alert',\n    subtitleText: `Overdue: ${pluralize(item.overdueCount, 'item', 'items')}`,\n    summaryText: `Required: ${item.requiredCount}, Voluntary: ${item.voluntaryCount}`,\n    actionQuery: item.actionQuery\n  }));\n\nconst visibleLearnerCount = items.length;\nconst visibleOverdueTotal = items.reduce((sum, item) => sum + item.overdueCount, 0);\nconst pctAffected = Math.round((visibleLearnerCount / Math.max(normalized.length, 1)) * 100);\nconst topImpacted = items.slice(0, 2).map((item) => ({\n  learnerName: item.learnerName,\n  overdueCount: item.overdueCount\n}));\nconst displayTitle = visibleLearnerCount > 0\n  ? `${visibleLearnerCount} learners with overdue assignments (${visibleOverdueTotal} overdue total)`\n  : 'No learners are overdue';\nconst displaySubtitle = visibleLearnerCount > 0\n  ? `Prioritized by most overdue • Updated ${asOfDate}`\n  : `All clear at this time • Updated ${asOfDate}`;\nconst widgetItems = items.map((item) => ({\n  title: item.learnerName,\n  subtitle: item.subtitleText,\n  summary: item.summaryText,\n  badgeText: item.badgeText,\n  priority: item.priority,\n  action: `ora.Invoke(openLearnerWorkspace, \\\"${item.actionQuery}\\\")`\n}));\nconst displayPayload = {\n  title: displayTitle,\n  patternId: 'messageListWidget',\n  description: 'Learners with overdue assignments',\n  properties: {\n    subtitle: displaySubtitle,\n    items: widgetItems\n  }\n};\nconst finalDisplayBlock = `<oraInfoDisplay key=\"list\">\\n${JSON.stringify(displayPayload, null, 2)}\\n</oraInfoDisplay>`;\n\nconst result = {\n  asOfDate,\n  teamSize: normalized.length,\n  overdueLearners: visibleLearnerCount,\n  totalOverdue: visibleOverdueTotal,\n  pctAffected,\n  topImpacted,\n  displayTitle,\n  displaySubtitle,\n  items,\n  finalDisplayBlock\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1766441452432"
          },
          "code": "PREPARE_LEARNERS_AT_RISK_DISPLAY",
          "id": "1772070000000",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_LEARNING_LEARNERAGGREGATES",
            "functionName": "learningRecordSearches",
            "name": "Get Records Due Next Month"
          },
          "outcomes": {
            "success": "1772070000001"
          },
          "code": "GET_RECORDS_DUE_NEXT_MONTH",
          "id": "1767748939450",
          "inputs": [
            {
              "id": "1772070000004_payload",
              "name": "payload",
              "type": "string",
              "value": "{{$context.$nodes.BUILD_RECORDS_DUE_NEXT_MONTH_PAYLOAD.$output.result}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Prepare Records Due Next Month Display",
            "returnType": "object",
            "sourceCode": "const raw = $context.$nodes.GET_RECORDS_DUE_NEXT_MONTH.$output;\nconst nowIso = $context.$system.$currentDateTime || new Date().toISOString();\nconst now = new Date(nowIso);\nconst DAY_MS = 24 * 60 * 60 * 1000;\n\nconst parseMaybe = (value) => {\n  if (typeof value !== 'string') return value;\n  const trimmed = value.trim();\n  if (!trimmed) return value;\n  try {\n    return JSON.parse(trimmed);\n  } catch {\n    return value;\n  }\n};\n\nconst unwrapArray = (value) => {\n  let current = parseMaybe(value);\n  for (let i = 0; i < 6; i += 1) {\n    if (Array.isArray(current)) return current;\n    if (!current || typeof current !== 'object') return [];\n    const next = [current.items, current.records, current.data, current.result, current.output]\n      .map(parseMaybe)\n      .find((candidate) => candidate != null);\n    if (next == null || next === current) return [];\n    current = next;\n  }\n  return Array.isArray(current) ? current : [];\n};\n\nconst clean = (value) => {\n  if (value == null) return '';\n  return String(value).trim();\n};\n\nconst parseDate = (value) => {\n  const text = clean(value);\n  if (!text) return null;\n  const date = new Date(text);\n  return Number.isNaN(date.getTime()) ? null : date;\n};\n\nconst startOfDay = (date) => new Date(date.getFullYear(), date.getMonth(), date.getDate());\nconst formatDate = (value) => {\n  const date = parseDate(value);\n  return date ? date.toISOString().slice(0, 10) : '—';\n};\nconst pluralize = (count, singular, plural) => `${count} ${count === 1 ? singular : plural}`;\n\nconst today = startOfDay(now);\nconst windowEnd = new Date(today.getTime() + (30 * DAY_MS));\nconst asOfDate = today.toISOString().slice(0, 10);\nconst records = unwrapArray(raw);\n\nconst eligible = [];\nfor (const record of records) {\n  const rawStatusText = clean(record.assignmentSubStatusMeaning || record.assignmentStatusMeaning || record.assignmentSubStatus || record.assignmentStatus || record.badgeText);\n  const completedDate = parseDate(record.completedDate);\n  const completed = Boolean(completedDate) || /\\bcomplete pending approval\\b|\\bcompleted\\b|\\bcomplete\\b/i.test(rawStatusText);\n  if (completed) continue;\n\n  const dueSource = record.assignmentDueDate || record.offeringEventStartDate;\n  const dueDate = parseDate(dueSource);\n  if (!dueDate) continue;\n\n  const dueDay = startOfDay(dueDate);\n  if (dueDay < today || dueDay > windowEnd) continue;\n\n  const diffDays = Math.round((dueDay.getTime() - today.getTime()) / DAY_MS);\n  eligible.push({\n    learnerName: clean(record.assignedToDisplayName),\n    learningTitle: clean(record.learningItemTitle),\n    dueDate: formatDate(dueSource),\n    assignerName: clean(record.assignerDisplayName) || '—',\n    dueDayMs: dueDay.getTime(),\n    diffDays\n  });\n}\n\nconst learnerCounts = eligible.reduce((acc, row) => {\n  acc[row.learnerName] = (acc[row.learnerName] || 0) + 1;\n  return acc;\n}, {});\n\neligible.sort((left, right) => {\n  const leftCount = learnerCounts[left.learnerName] || 0;\n  const rightCount = learnerCounts[right.learnerName] || 0;\n  if (leftCount !== rightCount) return rightCount - leftCount;\n  if (left.dueDayMs !== right.dueDayMs) return left.dueDayMs - right.dueDayMs;\n  return left.learningTitle.localeCompare(right.learningTitle);\n});\n\nconst rows = eligible.map((row) => {\n  const statusText = `Due in ${pluralize(row.diffDays, 'day', 'days')}`;\n  return {\n    learnerName: row.learnerName,\n    learningTitle: row.learningTitle,\n    dueDate: row.dueDate,\n    assignerName: row.assignerName,\n    statusText,\n    statusBadgeText: statusText,\n    statusBadgePriority: 'warning'\n  };\n});\n\nconst result = {\n  asOfDate,\n  totalRows: rows.length,\n  uniqueLearners: new Set(rows.map((row) => row.learnerName)).size,\n  rows\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1766689119567"
          },
