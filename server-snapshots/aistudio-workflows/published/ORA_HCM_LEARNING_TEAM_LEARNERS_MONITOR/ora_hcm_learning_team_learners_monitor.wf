            "returnType": "string",
            "sourceCode": "const managerId = String($context.$variables.managerId || '').trim();\n\nreturn JSON.stringify({\n  securityFilters: {\n    type: 'MANAGER'\n  },\n  filters: [\n    {\n      name: 'enrollments',\n      value: 'CURRENT'\n    },\n    {\n      name: 'assignmentDueDate',\n      value: 'NEXT_30_DAYS'\n    },\n    {\n      name: 'managerId',\n      value: managerId\n    }\n  ],\n  facets: ['ManagerType']\n});"
          },
          "outcomes": {
