          "code": "DISCOVER_SUPPLIERS",
          "id": "1773693496699",
          "inputs": [
            {
              "id": "1773693496703_1",
              "name": "prompt",
              "type": "string",
              "value": "## Task & Context\nUse real world suppliers and companies when answering the questions. Do not use any fake or generic company names.\n\n## Instruction\nSuggest {{$context.$triggers.REST.$input.suggestionCount}} actual real world suppliers, and not generic suppliers, for the following item, its category and item description.\n\n## Item Details\nitem: {{$context.$triggers.REST.$input.item}} \ncategory: {{$context.$triggers.REST.$input.category}} \nInclude all the regions where the supplier sells goods and services, website url, and a short 50 word company abstract for each supplier.\nYour entire response/output is going to consist of a single JSON object {}, and do NOT wrap it within JSON md markers.\nFormat the response as an RFC8259-compliant JSON object in the following format:\n{\n    \"results\": [\n        {\n            \"item\": \"<the item>\",\n            \"category\": \"<the category>\",\n            \"suppliers\": [\n                {\n                    \"supplier name\": \"<the supplier name>\",\n                    \"website url\": \"<the website URL>\",\n                    \"region\": \"<all the regions where the supplier sells good and services>\",\n                    \"company abstract\": \"<the company abstract>\"\n                },\n               ...\n            ]\n        }\n    ]\n}\n\n### Formatting Criteria\nMust translate ONLY the values for \"region\" and \"company abstract\"  to ({{$context.$nodes.GET_USER_SESSION.$output.items[0].Language}}) language."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Get User Session",
            "toolCode": "ORA_USER_SESSION_TOOL"
          },
          "outcomes": {
            "success": "1773693496699"
          },
