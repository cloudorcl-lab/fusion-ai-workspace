          "code": "GET_OPPORTUNITY_FIELDS",
          "convergenceTargetId": "1772037598825",
          "id": "1771311395351",
          "inputs": [
            {
              "id": "1771311423147_1",
              "name": "object",
              "type": "string",
              "value": "Opportunity"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_CX_SALESFORCE_SMARTSUGGESTION",
            "errorNodeId": "1772038507293",
            "functionName": "SmartSuggestion",
            "processJson": true,
            "name": "suggestions"
          },
          "outcomes": {
            "success": "1774458899561"
          },
          "code": "SUGGESTIONS",
          "id": "1774456879355",
          "inputs": [
            {
              "id": "1774456899002_1",
