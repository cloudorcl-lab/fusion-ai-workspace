{
  "workflowId": "100002355227159",
  "workflowCode": "ORA_BENEFITS_CERTIFICATION_WORKFLOW_AGENT",
  "name": "Benefits Certification Agent",
  "description": "The Benefits Certification Workflow Agent is designed to automatically evaluate employee submitted certification documents using predefined weighted criteria. It extracts relevant information, validates it against enrollment records and employee data, computes a confidence-based match score, and autonomously approves or rejects the certification. The agent applies consistent evaluation logic, maintains a complete audit trail, and significantly reduces manual review load while improving accuracy and turnaround time.",
