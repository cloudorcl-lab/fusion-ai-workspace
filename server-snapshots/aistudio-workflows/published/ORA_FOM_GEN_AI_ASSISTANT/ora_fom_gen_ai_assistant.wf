            "scm.fom.generate_sales_order_change_comments": "1773151473628",
            "scm.fom.generate_sales_order_return_comments": "1773151489928",
            "scm.fom.generate_change_order_confirmation_email_notification": "1773151502488"
          },
          "code": "USECASE_SWITCHER",
          "convergenceTargetId": "end",
          "id": "1773151321355",
          "inputs": [
            {
              "id": "1773151321357_1",
