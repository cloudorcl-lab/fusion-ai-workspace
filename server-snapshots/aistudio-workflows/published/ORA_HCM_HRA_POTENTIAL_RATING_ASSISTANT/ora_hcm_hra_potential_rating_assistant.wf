{
  "workflowId": "300000326919137",
  "workflowCode": "ORA_HCM_HRA_POTENTIAL_RATING_ASSISTANT",
  "name": "Potential Rating Assistant",
  "description": "An agent that synthesizes signals across organizational targets, employee goals, performance documents, feedback, check-ins, career potential indicators, and retention risk data to identify talent trends and recommend refinements to potential ratings and future-readiness assessments.",
  "specification": {
    "dataPipeline": {
      "pipelineNodes": [
