          "id": "1773627619117",
          "inputs": [
            {
              "id": "1773627619118_1",
              "name": "prompt",
              "type": "string",
              "value": "For each employee in the provided data context, generate a parameter object mapping template placeholders to actual values:\n  - EmployeeName: DisplayName\n  - PerformanceRating: performanceDocuments Overall Summary Section's Manager Ratings\n  - RiskOfLoss: riskOfLosses RiskLossRatingDescription\n  Output a list of parameter objects, one per employee, suitable for filling the PPT template slides.\n\nInput: \n{{$context.$nodes.TEAM_RATINGS.$output}}\n\nFill the parameters in {{$context.$app.$OraCommParamsToFill}}"
            }
          ],
