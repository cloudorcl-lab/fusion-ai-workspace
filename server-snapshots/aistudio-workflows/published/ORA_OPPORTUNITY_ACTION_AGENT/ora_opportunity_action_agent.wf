        {
          "metadata": {
            "name": "create Appointment Payload",
            "returnType": "object",
            "sourceCode": "// Safely extract inputs\nconst context = $context?.$triggers?.REST?.$input?.Context ?? {};\nconst values = $context?.$triggers?.REST?.$input?.formValues ?? {};\nconst jsonValues = Array.isArray(values?.json) ? values.json : [];\n\n// Helpers\nconst getVal = (id, def = \"\") =>\n  (jsonValues.find(v => v?.id === id)?.value ?? def);\n\n// Subject\nconst subject = getVal(\"subject\", \"\");\n\n// Start date/time\nconst timeStr = getVal(\"startTime\", \"12:00:00 AM\");\nconst dateStr = getVal(\"startDate\", $context?.$system?.$currentDate);\n\n// Parse time\nlet [timePart = \"12:00:00\", meridiem = \"AM\"] = String(timeStr).trim().split(/\\s+/);\nlet [hh = 12, mm = 0, ss = 0] = timePart.split(\":\").map(n => Number(n) || 0);\n\nif (meridiem?.toUpperCase() === \"PM\" && hh !== 12) hh += 12;\nif (meridiem?.toUpperCase() === \"AM\" && hh === 12) hh = 0;\n\n// Parse date (expects YYYY-MM-DD)\nlet [y, m, d] = String(dateStr).split(\"-\").map(n => Number(n) || 0);\n\n// Build UTC timestamp (number)\nconst ts = Date.UTC(y, (m || 1) - 1, d || 1, hh, mm, ss, 0);\n\n// ISO start\nconst startDateTime = new Date(ts).toISOString();\n\n// Duration and end time\nconst durationMinutesRaw = getVal(\"duration\", \"30\");\nconst durationMinutes = Number(durationMinutesRaw);\nconst safeDurationMs = Number.isFinite(durationMinutes) ? durationMinutes * 60_000 : 30 * 60_000;\n\nconst endTs = ts + safeDurationMs;\nconst endDateTime = new Date(endTs).toISOString();\n\n// Description\nconst description = getVal(\"description\", \"\");\n\n// Assignees\nconst resources = context?.opportunity?.ListOfResourcesForTheTeam?? [];\nconst assigneeObject = Array.isArray(resources)\n  ? resources.map(id => ({\n      AssigneeId: id?.ResourceId?.PartyId ?? \"\",\n      PrimaryAssigneeFlag: \"Y\",\n      ResponseCode: \"NOT_RESPONDED\",\n      ConflictId: \"0\",\n      AttendeeFlag: true,\n      ReminderPeriod: \"15\"\n    }))\n  : [];\n\n// contacts\nconst contacts = context?.opportunity?.ListOfContacts ?? [];\nconst contactObject = Array.isArray(contacts)\n  ? contacts.map((id) => ({\n      ContactId: id?.PerPartyId?.PartyId ?? \"\",\n      ConflictId: \"0\",\n      AttendeeFlag: true,\n      PrimaryContactFlag: false,\n    }))\n  : [];\n\n// Payload\nconst payload = {\n  AccountId: context?.opportunity?.CustomerAccount?.PartyId ?? \"\",\n  OpportunityId: context?.opportunity?.OptyId ?? \"\",\n  Subject: subject,\n  ActivityStartDate: startDateTime,\n  ActivityEndDate: endDateTime,\n  AllDayFlag: false,\n  ActivityTypeCode: \"CALL\",\n  ReminderPeriod: \"15\",\n  ActivityDescription: description,\n  ActivityFunctionCode: \"APPOINTMENT\",\n  OwnerId: context?.opportunity?.Owner?.PartyId ?? \"\",\n  ActivityAssignee: assigneeObject,\n  ActivityContact: contactObject,\n  Note: []\n};\n\nreturn payload;"
          },
          "outcomes": {
            "success": "1772081003962"
          },
          "code": "CREATE_APPOINTMENT_PAYLOAD",
          "id": "1771869245128",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "create payload for Note",
            "returnType": "object",
            "sourceCode": "// extract inputs\nconst context = $context?.$triggers?.REST?.$input?.Context ?? {};\nconst values = $context?.$triggers?.REST?.$input?.formValues ?? {};\nconst jsonValues = Array.isArray(values?.json) ? values.json : [];\n\n\n// Helpers\nconst getVal = (id, def = \"\") =>\n  (jsonValues.find(v => v?.id === id)?.value ?? def);\n\n// Set parameters\nconst title = getVal(\"title\", \"\");\nconst note = getVal(\"note\", \"\");\n\n\nlet payload = {\n  \"NoteTitle\": title,\n  \"NoteTxt\": note,\n\"OpportunityNumber\": context?.opportunity?.OptyNumber,\n  \"VisibilityCode\": \"PRIVATE\",\n  \"NoteTypeCode\": \"GENERAL\"\n}\n\nreturn payload;"
          },
          "outcomes": {
            "success": "1772081202916"
          },
          "code": "CREATE_PAYLOAD_FOR_NOTE",
          "id": "1771906462857",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "create payload for task",
            "returnType": "object",
            "sourceCode": "// Safely extract inputs\nconst context = $context?.$triggers?.REST?.$input?.Context ?? {};\nconst values = $context?.$triggers?.REST?.$input?.formValues ?? {};\nconst jsonValues = Array.isArray(values?.json) ? values.json : [];\n\n// Helpers\nconst getVal = (id, def = \"\") =>\n  jsonValues.find((v) => v?.id === id)?.value ?? def;\n\n// Subject\nconst subject = getVal(\"subject\", \"\");\n\n// Start date\nconst dateStr = getVal(\"startDate\", $context?.$system?.$currentDate);\n\n// Type Code\n\nconst typeCode = getVal(\"type\", \"\");\n\n// Description\nconst description = getVal(\"description\", \"\");\n\n// Assignees\nconst resources = context?.opportunity?.ListOfResourcesForTheTeam ?? [];\nconst assigneeObject = Array.isArray(resources)\n  ? resources.map((id) => ({\n      AssigneeId: id?.ResourceId?.PartyId ?? \"\",\n      PrimaryAssigneeFlag: \"Y\",\n      ResponseCode: \"NOT_RESPONDED\",\n      ConflictId: \"0\",\n      AttendeeFlag: true,\n      ReminderPeriod: \"15\",\n    }))\n  : [];\n\n// contacts\nconst contacts = context?.opportunity?.ListOfContacts ?? [];\nconst contactObject = Array.isArray(contacts)\n  ? contacts.map((id) => ({\n      ContactId: id?.PerPartyId?.PartyId ?? \"\",\n      ConflictId: \"0\",\n      AttendeeFlag: true,\n      PrimaryContactFlag: false,\n    }))\n  : [];\n\n// Payload\nconst payload = {\n  AccountId: context?.opportunity?.CustomerAccount?.PartyId ?? \"\",\n  OpportunityId: context?.opportunity?.OptyId ?? \"\",\n  Subject: subject,\n  DueDate: dateStr,\n  ActivityTypeCode: typeCode,\n  TaskReminderPeriod: \"-1\",\n  ActivityDescription: description,\n  StatusCode: \"NOT_STARTED\",\n  ActivityFunctionCode: \"TASK\",\n  OwnerId: context?.opportunity?.Owner?.PartyId ?? \"\",\n  ActivityAssignee: assigneeObject,\n  ActivityContact: contactObject,\n  Note: [],\n};\n\nreturn payload;"
          },
          "outcomes": {
            "success": "1772081041080"
          },
          "code": "CREATE_PAYLOAD_FOR_TASK",
          "id": "1771919923197",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
