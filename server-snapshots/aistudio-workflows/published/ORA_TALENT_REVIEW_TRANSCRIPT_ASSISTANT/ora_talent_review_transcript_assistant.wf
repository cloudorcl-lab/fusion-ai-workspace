  "workflowCode": "ORA_TALENT_REVIEW_TRANSCRIPT_ASSISTANT",
  "name": "Talent Review Transcript Summary Generator",
  "description": "Generates the summary of the uploaded transcript of a Talent Review meeting.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
