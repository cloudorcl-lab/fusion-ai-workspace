  "name": "ORA FIN GL LEDGER AGENT REPHRASE GUIDE",
  "description": "Guides users to rephrase unclear Ledger Agent requests into focused GL questions.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
