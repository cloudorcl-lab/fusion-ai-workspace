          "code": "GENERATE_DELIVERY_DATE",
          "id": "1770543762168",
          "inputs": [
            {
              "id": "1770543762170_1",
              "name": "prompt",
              "type": "string",
              "value": "Using today’s date as the reference {{$context.$system.$currentDate}} calculate the date exactly one calendar month from today. Return it in YYYY-MM-DD format."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"ResultDate\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"result_date\": {\n      \"type\": \"string\",\n      \"description\": \"One calendar month from 2026-02-16 (2026-03-16), in ISO 8601 format (YYYY-MM-DD).\",\n      \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\",\n      \"examples\": [\"2026-03-16\"]\n    }\n  },\n  \"required\": [\"result_date\"]\n}",
