          },
          "code": "WAS_A_LAPTOP_IMAGE_UPLOADED",
          "id": "1775513874633",
          "inputs": [
            {
              "id": "1775513874636_1",
              "name": "prompt",
              "type": "string",
              "value": "You are given a JSON object.\n\nThe first value of the first key in the JSON is the file description. Use that description to determine whether the uploaded file is a valid image of a laptop.\n\nRules:\n- Set isFileLaptop to \"Y\" only if:\n  1. The JSON contains a valid uploaded image file, AND\n  2. The first value of the first key (the description of the image) clearly indicates the image contains a laptop\n- Return \"N\" in all other cases:\n  - no image\n  - invalid or missing image content\n  - non-image file\n  - image does not contain a laptop\n  - description is unclear or missing\n\nFor a valid image file:\n- The JSON must contain \"ORA_CHAT_ATTACHMENTS_RAW_FILECONTENT\"\n- It must include at least one attachment\n- The attachment must have contentType starting with \"image/\"\n- The base64 content must be present and not a placeholder such as \"<Base64 content>\"\n\nUse only the JSON below:\n\n {{$context.$nodes.READ_UPLOADED_IMAGE.$output}} \n\nOutput only a single character: Y or N into isFileLaptop."
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"isFileLaptop\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Get Uploaded File Name",
            "returnType": "object",
            "sourceCode": "const obj = $context.$nodes.READ_UPLOADED_IMAGE.$output ;\nconst filename = Object.keys(obj)[0];\nreturn filename;"
          },
          "outcomes": {
            "success": "1775514012894"
          },
          "code": "GET_UPLOADED_FILE_NAME",
          "id": "1775513970262",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get File Description",
            "returnType": "object",
            "sourceCode": "const obj =  $context.$nodes.READ_UPLOADED_IMAGE.$output;\nconst file_text = obj[ $context.$nodes.GET_UPLOADED_FILE_NAME.$output.result];\nreturn file_text;"
          },
          "outcomes": {
            "success": "1775514072679"
          },
          "code": "GET_FILE_DESCRIPTION",
          "id": "1775514012894",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get Base 64 Data",
            "returnType": "object",
            "sourceCode": "const obj = $context.$nodes.READ_UPLOADED_IMAGE.$output;\n\nconst firstAttachment = Object.values(obj.ORA_CHAT_ATTACHMENTS_RAW_FILECONTENT)[0];\nconst base64content = firstAttachment?.bas64EncodedFileContent;\nreturn base64content;"
          },
          "outcomes": {
            "success": "1775514102007"
          },
          "code": "GET_BASE_64_DATA",
          "id": "1775514072679",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get file length in bytes",
            "returnType": "number",
            "sourceCode": "const base64 = $context.$nodes.GET_BASE_64_DATA.$output.result;\n\n// Remove data URL prefix if present\nconst cleaned = base64.split(',').pop().trim();\n\n// Length of Base64 string\nconst length = cleaned.length;\n\n// Determine padding\nlet padding = 0;\nif (cleaned.endsWith('==')) {\n  padding = 2;\n} else if (cleaned.endsWith('=')) {\n  padding = 1;\n}\n\n// Original file size in bytes\nconst fileSizeBytes = (length * 3) / 4 - padding;\n\nreturn fileSizeBytes;"
          },
          "outcomes": {
            "success": "1770622771865"
          },
          "code": "GET_FILE_LENGTH_IN_BYTES",
          "id": "1775514102007",
          "inputs": [],
