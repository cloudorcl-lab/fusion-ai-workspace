          "inputs": [
            {
              "value": {
                "messageTemplate": {
                  "message": "{{$context.$nodes.LAPTOP_IMAGE_UPLOADED.$output}}\n\n<br><br>Based on our records, your laptop is currently **out of warranty**. And as per company policy, you will need to send it back to us so we can **retire it**. I will provide you with a shipping label once we are through the next steps. <br><br>Now, I can help you choose a new laptop! <br>I can show you a set of options tailored to your role, including models commonly chosen by others in similar roles. <br><br>When you’re ready, click **Approve** to get started."
                }
              },
              "name": "chatChannelInput",
              "type": "object"
            }
          ],
          "type": "HUMAN"
        },
        {
