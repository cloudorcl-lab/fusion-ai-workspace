            "sourceCode": "var result=\"\";\nif   ( !$context.$nodes.SELECTION_LAPTOP.$feedbackRecieved )\n{\n  result = \" I recommend the first of the following three options based on your role of \" + $context.$nodes.PERSON_ADDRESS_AND_WORK_LOCATION.$output.items[0].assignments.items[0].AssignmentName + \" and top choices made by your peers. **Please click Approve to go with my recommendation or click Request Changes to select another laptop**<br><br>\" + $context.$nodes.DISPLAY_AVAILABLE_LAPTOPS.$output\n}\nreturn result;"
          },
