          "type": "object",
          "typeSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://example.com/schemas/locations-response.json\",\n  \"title\": \"LocationsResponse\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"items\", \"count\", \"hasMore\", \"limit\", \"offset\", \"links\"],\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": { \"$ref\": \"#/$defs/LocationItem\" }\n    },\n    \"count\": { \"type\": \"integer\", \"minimum\": 0 },\n    \"hasMore\": { \"type\": \"boolean\" },\n    \"limit\": { \"type\": \"integer\", \"minimum\": 0 },\n    \"offset\": { \"type\": \"integer\", \"minimum\": 0 },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": { \"$ref\": \"#/$defs/Link\" }\n    }\n  },\n  \"$defs\": {\n    \"LocationItem\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\n        \"LocationId\",\n        \"SetId\",\n        \"ActiveStatus\",\n        \"EmployeeLocationFlag\",\n        \"ShipToSiteFlag\",\n        \"ReceivingSiteFlag\",\n        \"BillToSiteFlag\",\n        \"OfficeSiteFlag\",\n        \"LocationCode\",\n        \"LocationName\",\n        \"MainAddressId\",\n        \"AddressLine1\",\n        \"Country\",\n        \"PostalCode\",\n        \"Region1\",\n        \"Region2\",\n        \"TownOrCity\",\n        \"EffectiveStartDate\",\n        \"EffectiveEndDate\",\n        \"CreationDate\",\n        \"LastUpdateDate\",\n        \"Longitude\",\n        \"Latitude\",\n        \"ValidationStatusCode\",\n        \"Provider\",\n        \"links\"\n      ],\n      \"properties\": {\n        \"LocationId\": { \"type\": \"integer\" },\n        \"SetId\": { \"type\": \"integer\" },\n        \"ActiveStatus\": {\n          \"type\": \"string\",\n          \"description\": \"Status code (example: A)\"\n        },\n        \"EmployeeLocationFlag\": { \"type\": \"boolean\" },\n        \"TelephoneNumber1\": { \"type\": [\"string\", \"null\"] },\n        \"TelephoneNumber2\": { \"type\": [\"string\", \"null\"] },\n        \"TelephoneNumber3\": { \"type\": [\"string\", \"null\"] },\n        \"EmailAddress\": { \"type\": [\"string\", \"null\"], \"format\": \"email\" },\n        \"ShipToSiteFlag\": { \"type\": \"boolean\" },\n        \"ReceivingSiteFlag\": { \"type\": \"boolean\" },\n        \"BillToSiteFlag\": { \"type\": \"boolean\" },\n        \"OfficeSiteFlag\": { \"type\": \"boolean\" },\n        \"StandardWorkingHours\": { \"type\": [\"number\", \"null\"] },\n        \"StandardWorkingFrequency\": { \"type\": [\"string\", \"null\"] },\n        \"StandardAnnualWorkingDuration\": { \"type\": [\"number\", \"null\"] },\n        \"AnnualWorkingDurationUnits\": { \"type\": [\"string\", \"null\"] },\n        \"LocationCode\": { \"type\": \"string\" },\n        \"LocationName\": { \"type\": \"string\" },\n        \"Description\": { \"type\": [\"string\", \"null\"] },\n        \"MainAddressId\": { \"type\": \"integer\" },\n        \"AddressLine1\": {"
        },
