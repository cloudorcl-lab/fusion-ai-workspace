        {
          "metadata": {
            "name": "Check If Laptop Image uploaded"
          },
          "outcomes": {
            "true": "1775513970262",
            "false": "1770622536813"
          },
          "code": "CHECK_IF_LAPTOP_IMAGE_UPLOADED",
          "convergenceTargetId": "1770221580524",
          "id": "1770622469956",
          "inputs": [
            {
              "id": "1770622469957_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.WAS_A_LAPTOP_IMAGE_UPLOADED.$output.isFileLaptop == 'Y'}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Request laptop image for verification"
          },
          "outcomes": {
            "success": "1770912900794"
          },
          "code": "REQUEST_LAPTOP_IMAGE_FOR_VERIFICATION",
          "id": "1770622536813",
          "inputs": [
            {
              "id": "1770622536813_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a customer-facing support agent. Write a concise, friendly response.\n\nInclude:\n1) A warm greeting addressed to the customer using their name from this exactly: {{$context.$nodes.GET_USER_SESSION.$output.items[0].DisplayName}}.\n2) A polite note that you don’t see an image attached with their message - you require one to be able to help.\n3) A clear request for the customer to check the upload and re-send the image, and to restate their question with the image.\n\nKeep it to 2–3 sentences. Tone: helpful, non-blaming, professional. Avoid mentioning internal systems or variables beyond inserting the name. Avoid promises. Do not recommend any other actions."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Laptop Image Uploaded"
          },
          "outcomes": {
            "success": "1770221580524"
          },
          "code": "LAPTOP_IMAGE_UPLOADED",
          "id": "1770622771865",
          "inputs": [
            {
              "id": "1770622771866_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a customer-facing support agent. Write a short, warm greeting addressed to the customer using their name from this exactly: {{$context.$nodes.GET_USER_SESSION.$output.items[0].FirstName}}.\n\nThen:\n1) Confirm you received the uploaded image.\n2) Briefly and tactfully comment on the laptop’s condition using this description exactly as the source of truth: \" {{$context.$nodes.GET_FILE_DESCRIPTION.$output.result}} \" (focus solely on the laptop itself and nothing else in the image. Paraphrase your comment in a customer-friendly way; do not speculate beyond what’s described; do not assign blame).\n\nKeep it to 2 sentences total. Tone: empathetic, professional, concise. Avoid jargon, avoid promises, avoid mentioning internal systems or warranty information or variables beyond inserting the name and using the description content."
            }
          ],
          "type": "LLM"
        },
