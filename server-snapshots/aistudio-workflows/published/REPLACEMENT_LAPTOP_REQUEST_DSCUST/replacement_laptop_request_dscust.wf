        {
          "metadata": {
            "name": "Merge Windows And Mac New Assign Laptops",
            "returnType": "object",
            "sourceCode": "const CDN_BASE_URL =\n  $context?.$variables?.CDN_BASE_URL ??\n  \"https://static-stage.oracle.com/cdn/ds/hrz/26bd01/images/\";\n\nconst cdnImages = {\n  \"Dell 5440 - 16GB RAM / 512GB SSD\": \"dell_16.jpg\",\n  \"Dell 7440 - 32GB RAM / 1T SSD\": \"dell_32.jpg\",\n  \"MacBook Pro - 16GB RAM / 512GB SSD\": \"macbook_pro.jpg\",\n};\n\nconst normalizeKey = (value) =>\n  value ? value.replace(/\\s+/g, \" \").trim() : null;\n\nconst imageLookup = Object.fromEntries(\n  Object.entries(cdnImages).map(([key, value]) => [normalizeKey(key), value]),\n);\n\nconst toCdnUrl = (path) => {\n  if (!path) return null;\n  return /^https?:\\/\\//i.test(path) ? path : `${CDN_BASE_URL}${path}`;\n};\n\nconst annotateWithImage = (items) =>\n  (items ?? []).map((item) => {\n    const candidates = [\n      item.ItemDescription,\n      item.Description,\n      item.ItemNumber,\n    ]\n      .map(normalizeKey)\n      .filter(Boolean);\n\n    let thumbnailImage = item.thumbnailImage || null;\n    for (const candidate of candidates) {\n      if (imageLookup[candidate]) {\n        thumbnailImage = toCdnUrl(imageLookup[candidate]);\n        break;\n      }\n    }\n\n    return { ...item, thumbnailImage };\n  });\n\nconst array1 = annotateWithImage(\n  $context.$nodes.GET_LIST_OF_AVAILABLE_LAPTOPS?.$output?.items,\n);\nconst array2 = annotateWithImage(\n  $context.$nodes.GET_LIST_OF_AVAILABLE_WINDOWS_32GB_LAPTOPS?.$output?.items,\n);\nconst array3 = annotateWithImage(\n  $context.$nodes.GET_LIST_OF_AVAILABLE_MAC_16GB_LAPTOPS?.$output?.items,\n);\n\nreturn { items: array1.concat(array2, array3) };"
          },
          "outcomes": {
            "success": "1771505040410"
          },
          "code": "MERGE_WINDOWS_AND_MAC_NEW_ASSIGN_LAPTOPS",
          "id": "1771504811771",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Set Available New Assign Laptops"
