          "type": "object",
          "typeSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"InstalledBaseAssetsResponse\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"items\", \"count\", \"hasMore\", \"limit\", \"offset\", \"links\"],\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": { \"$ref\": \"#/$defs/Asset\" }\n    },\n    \"count\": { \"type\": \"integer\", \"minimum\": 0 },\n    \"hasMore\": { \"type\": \"boolean\" },\n    \"limit\": { \"type\": \"integer\", \"minimum\": 0 },\n    \"offset\": { \"type\": \"integer\", \"minimum\": 0 },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": { \"$ref\": \"#/$defs/Link\" }\n    }\n  },\n  \"$defs\": {\n    \"Asset\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\n        \"AssetId\",\n        \"AssetNumber\",\n        \"SerialNumber\",\n        \"Description\",\n        \"ItemId\",\n        \"ItemNumber\",\n        \"ItemDescription\",\n        \"ItemLongDescription\",\n        \"OperatingOrganizationCode\",\n        \"OperatingOrganizationId\",\n        \"OperatingOrganizationName\",\n        \"LocationOrganizationId\",\n        \"SubinventoryCode\",\n        \"SubinventoryName\",\n        \"CurrentLocationContext\",\n        \"CurrentLocationName\",\n        \"ContactId\",\n        \"ContactName\",\n        \"ContactNumber\",\n        \"LocationOrganizationCode\"\n      ],\n      \"properties\": {\n        \"AssetId\": { \"type\": \"integer\" },\n        \"AssetNumber\": { \"type\": \"string\" },\n        \"SerialNumber\": { \"type\": \"string\" },\n        \"Description\": { \"type\": \"string\" },\n\n        \"ItemId\": { \"type\": \"integer\" },\n        \"ItemNumber\": { \"type\": \"string\" },\n        \"ItemDescription\": { \"type\": \"string\" },\n        \"ItemLongDescription\": { \"type\": [\"string\", \"null\"] },\n\n        \"OperatingOrganizationCode\": { \"type\": \"string\" },\n        \"OperatingOrganizationId\": { \"type\": \"integer\" },\n        \"OperatingOrganizationName\": { \"type\": \"string\" },\n\n        \"LocationOrganizationId\": { \"type\": \"integer\" },\n        \"LocationOrganizationCode\": { \"type\": \"string\" },\n\n        \"SubinventoryCode\": { \"type\": \"string\" },\n        \"SubinventoryName\": { \"type\": \"string\" },\n\n        \"CurrentLocationContext\": { \"type\": \"string\" },\n        \"CurrentLocationName\": { \"type\": \"string\" },\n\n        \"ContactId\": { \"type\": [\"integer\", \"null\"] },\n        \"ContactName\": { \"type\": [\"string\", \"null\"] },\n        \"ContactNumber\": { \"type\": [\"string\", \"null\"] }\n      }\n    },\n    \"Link\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"rel\", \"href\", \"name\", \"kind\"],\n      \"properties\": {\n        \"rel\": { \"type\": \"string\" },\n        \"href\": { \"type\": \"string\", \"format\": \"uri\" },\n        \"name\": { \"type\": \"string\" },\n        \"kind\": { \"type\": \"string\" }\n      }\n    }\n  }\n}"
