          "id": "1770219519229",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"$id\": \"https://example.com/person-context-response.schema.json\",\n  \"title\": \"PersonContextResponse\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"minItems\": 0,\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"properties\": {\n          \"PersonNumber\": { \"type\": \"string\" },\n          \"UserDistinguishedName\": { \"type\": \"string\" },\n          \"Username\": { \"type\": \"string\" },\n          \"DisplayName\": { \"type\": \"string\" },\n          \"FirstName\": { \"type\": \"string\" },\n          \"LastName\": { \"type\": \"string\" },\n          \"MiddleNames\": { \"type\": [\"string\", \"null\"] },\n          \"KnownAs\": { \"type\": [\"string\", \"null\"] },\n          \"NameType\": { \"type\": \"string\", \"enum\": [\"GLOBAL\"] },\n          \"Suffix\": { \"type\": [\"string\", \"null\"] },\n          \"Title\": { \"type\": [\"string\", \"null\"] },\n          \"EmailAddress\": { \"type\": \"string\", \"format\": \"email\" },\n          \"Honors\": { \"type\": [\"string\", \"null\"] },\n          \"PreNameAdjunct\": { \"type\": [\"string\", \"null\"] },\n          \"AccessibilityMode\": { \"type\": \"string\" },\n          \"ClientEncoding\": { \"type\": \"string\" },\n          \"ColorContrast\": { \"type\": \"string\" },\n          \"Currency\": { \"type\": \"string\", \"pattern\": \"^[A-Z]{3}$\" },\n          \"DateFormat\": { \"type\": \"string\" },\n          \"DecimalSeparator\": { \"type\": \"string\", \"maxLength\": 1 },\n          \"FontSize\": { \"type\": \"string\" },\n          \"GroupingSeparator\": { \"type\": \"string\", \"maxLength\": 1 },\n          \"Language\": { \"type\": \"string\", \"maxLength\": 5 },\n          \"NumberFormat\": { \"type\": \"string\" },\n          \"ServerTime\": { \"type\": \"string\", \"format\": \"date-time\" },\n          \"Territory\": { \"type\": \"string\" },\n          \"TimeFormat\": { \"type\": \"string\" },\n          \"TimeZone\": { \"type\": \"string\" },\n          \"DefaultLanguage\": { \"type\": \"string\", \"maxLength\": 5 },\n          \"DisplayNameLanguage\": { \"type\": \"string\", \"maxLength\": 5 },\n          \"Initials\": { \"type\": \"string\" },\n          \"AccountType\": { \"type\": \"string\", \"enum\": [\"Person\"] },\n          \"@context\": {\n            \"type\": \"object\",\n            \"additionalProperties\": false,\n            \"properties\": {\n              \"key\": { \"type\": \"string\" },\n              \"headers\": {\n                \"type\": \"object\",\n                \"additionalProperties\": false,\n                \"properties\": {\n                  \"ETag\": { \"type\": \"string\" }\n                },\n                \"required\": [\"ETag\"]\n              },\n              \"links\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"additionalProperties\": false,\n                  \"properties\": {\n                    \"rel\": { \"type\": \"string\" },\n                    \"href\": { \"type\": \"string\", \"format\": \"uri\" },\n                    \"name\": { \"type\": \"string\" },\n                    \"kind\": { \"type\": \"string\" }\n                  },\n                  \"required\": [\"rel\", \"href\", \"kind\"]\n                }\n              }\n            },\n            \"required\": [\"key\", \"headers\", \"links\"]\n          }\n        },\n        \"required\": [\n          \"PersonNumber\",\n          \"UserDistinguishedName\",\n          \"Username\",\n          \"DisplayName\",\n          \"FirstName\",\n          \"LastName\",\n          \"NameType\",\n          \"Title\",\n          \"EmailAddress\",\n          \"AccessibilityMode\",\n          \"ClientEncoding\",\n          \"ColorContrast\",\n          \"Currency\",\n          \"DateFormat\",\n          \"DecimalSeparator\",\n          \"FontSize\",\n          \"GroupingSeparator\",\n          \"Language\",\n          \"NumberFormat\",\n          \"ServerTime\",\n          \"Territory\",\n          \"TimeFormat\",\n          \"TimeZone\",\n          \"DefaultLanguage\",\n          \"DisplayNameLanguage\",\n          \"Initials\",\n          \"AccountType\",\n          \"@context\"\n        ]\n      }\n    },\n    \"count\": { \"type\": \"integer\", \"minimum\": 0 },\n    \"hasMore\": { \"type\": \"boolean\" },\n    \"limit\": { \"type\": \"integer\", \"minimum\": 0 },\n    \"offset\": { \"type\": \"integer\", \"minimum\": 0 },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"properties\": {\n          \"rel\": { \"type\": \"string\" },\n          \"href\": { \"type\": \"string\", \"format\": \"uri\" },\n          \"name\": { \"type\": \"string\" },\n          \"kind\": { \"type\": \"string\", \"enum\": [\"collection\", \"item\", \"other\"] }\n        },\n        \"required\": [\"rel\", \"href\", \"kind\"]\n      }\n    }\n  },\n  \"required\": [\"items\", \"count\", \"hasMore\", \"limit\", \"offset\", \"links\"]\n}",
          "type": "BO_FUNCTION"
        },
