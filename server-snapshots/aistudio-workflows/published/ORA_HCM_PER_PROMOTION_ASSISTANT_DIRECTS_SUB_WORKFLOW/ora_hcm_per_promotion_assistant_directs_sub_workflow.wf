            "sourceCode": "var jobProgressionArray = $context.$variables.message \n\nconst currentJobSet = new Set(\n  jobProgressionArray?.DirectReportsDocument\n    ?.map(r => r.currentJob)\n    .filter(v => v != null)\n);\n\nvar employees = $context.$nodes.FETCH_DIRECT_REPORTS.$output.items;\nconst filteredEmployees = employees.filter(\n  e => e.JobName != null && currentJobSet.has(e.JobName)\n);\n\n\nreturn filteredEmployees;"
          },
