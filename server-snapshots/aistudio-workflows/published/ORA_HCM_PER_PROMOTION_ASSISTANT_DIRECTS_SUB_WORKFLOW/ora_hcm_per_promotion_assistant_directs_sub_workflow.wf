                  },
                  "outcomes": {
                    "success": "1771924309088"
                  },
                  "code": "GETCONNECTIONSFEEDBACK",
                  "id": "1771924269771",
                  "inputs": [
                    {
                      "id": "1773325203766_1",
                      "name": "personId",
                      "type": "string",
                      "value": "{{$context.$nodes.LOOPWORKERS.$currentItem.PersonId}}"
                    },
                    {
                      "id": "1773325203767_2",
                      "name": "startDate",
                      "type": "date",
