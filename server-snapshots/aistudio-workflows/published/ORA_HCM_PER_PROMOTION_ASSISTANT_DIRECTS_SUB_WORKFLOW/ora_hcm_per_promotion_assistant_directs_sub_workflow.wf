                {
                  "metadata": {
                    "name": "Prepare required Values for Fetching Notes and Feedback",
                    "returnType": "object",
                    "sourceCode": "let requiredInputs = {} ; \n\nlet currentItem = $context.$nodes.LOOPWORKERS.$currentItem;\n\nlet tokenForEnterpriseSeniority = $context.$nodes.LOOPWORKERS.FETCH_ENTERPRISE_SENIORITY_BUSINESS_OBJECT.$output.response ? $context.$nodes.LOOPWORKERS.FETCH_ENTERPRISE_SENIORITY_BUSINESS_OBJECT.$output.response.items[0] : null\nlet tokenForJobSeniority =$context.$nodes.LOOPWORKERS.FETCH_JOB_SENIORITY_BUSINESS_OBJECT.$output.response ?  $context.$nodes.LOOPWORKERS.FETCH_JOB_SENIORITY_BUSINESS_OBJECT.$output.response.items[0] : null\n\nrequiredInputs.display_name = currentItem.DisplayName;\nrequiredInputs.action = $context.$nodes.LOOPWORKERS.CALLINITIALIZEAGENTSREST.$output.result.ActionOccurrenceMap.ActionName\nrequiredInputs.action_reason  = \"NA\"\nrequiredInputs.current_Department = currentItem.DepartmentName || \"NA\"\nrequiredInputs.current_Location = currentItem.LocationName || \"NA\"\nrequiredInputs.Input_text = \"NA\"\nrequiredInputs.current_job = currentItem.JobName || \"NA\"\nrequiredInputs.proposed_job = $context.$nodes.LOOPWORKERS.EXTRACTREQUIREDDATAFROMRAG.$output.ProposedJobName || \"NA\"\nrequiredInputs.total_seniority =  tokenForEnterpriseSeniority && tokenForEnterpriseSeniority.SeniorityLengthOfServiceYears ? tokenForEnterpriseSeniority.SeniorityLengthOfServiceYears + \"years\"+ tokenForEnterpriseSeniority.SeniorityLengthOfServiceMonths +\"months\"+tokenForEnterpriseSeniority.SeniorityLengthOfServiceDays +\"days\" : \"NA\"\nrequiredInputs.Job_seniority =   tokenForJobSeniority && tokenForJobSeniority.SeniorityLengthOfServiceYears ? tokenForJobSeniority.SeniorityLengthOfServiceYears + \"years\"+ tokenForJobSeniority.SeniorityLengthOfServiceMonths +\"months\"+tokenForJobSeniority.SeniorityLengthOfServiceDays +\"days\" : \"NA\"\n\nreturn requiredInputs"
                  },
                  "outcomes": {
                    "success": "1771924208720"
                  },
                  "code": "PREPARE_REQUIRED_VALUES_FOR_FETCHING_NOTES_AND_FEEDBACK",
