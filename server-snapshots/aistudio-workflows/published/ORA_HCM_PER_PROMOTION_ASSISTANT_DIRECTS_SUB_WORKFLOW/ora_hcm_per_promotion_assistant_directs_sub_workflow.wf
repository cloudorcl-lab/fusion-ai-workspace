                    }
                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "modelConfiguration": {
                      "modelProperties": {
                        "k": 0,
                        "max_completion_tokens": 32000,
                        "reasoning_effort": "low"
                      },
                      "code": "ORA_MODEL_CONFIG_PREMIUM_OPEN_AI_GPT_4_1_MINI",
                      "provider": "CERT_PREMIUM",
                      "model": "OCI_GPT_5_MINI",
                      "modelName": "Gpt-5 Mini"
                    },
                    "name": "consolidateFeedbackResponses"
                  },
                  "outcomes": {
                    "success": "1771924361554"
                  },
                  "code": "CONSOLIDATEFEEDBACKRESPONSES",
                  "id": "1771924309088",
                  "inputs": [
                    {
                      "id": "1771924309089_1",
                      "name": "prompt",
                      "type": "string",
                      "value": "From the response - {{$context.$nodes.LOOPWORKERS.GETCONNECTIONSFEEDBACK.$output}},\n\n**IF response is empty/null/undefined OR no NoteText found:**\nReturn: \"\"\n\n**ELSE PROCEED WITH SENTIMENT ANALYSIS:**\n\n=================================================================\nSTEP 1: EXTRACT ALL INDIVIDUAL COMMENTS\n=================================================================\nParse the JSON response and collect ALL \"NoteText\" values from peer/connection feedback comments. Filter out empty or very short comments (<10 characters).\n\n=================================================================\nSTEP 2: SENTIMENT ANALYSIS (Internal Processing - Do NOT Output)\n=================================================================\nFor EACH comment, analyze using these criteria:\n\n**POSITIVE INDICATORS** (+1.0):\n- Praise words: excellent, outstanding, exceptional, great, fantastic, amazing, strong, stellar\n- Reliability: reliable, dependable, trustworthy, consistent, solid\n- Collaboration: collaborative, supportive, helpful, responsive, proactive, team player\n- Technical: expert, knowledgeable, skilled, capable, competent\n- Leadership: leader, mentor, guide, influence, inspire\n- Work quality: high-quality, thorough, detailed, meticulous, professional\n\n**NEUTRAL INDICATORS** (0.5):\n- Factual descriptions without strong emotion\n- Balanced observations with no clear positive/negative lean\n- General statements about tasks/responsibilities\n\n**NEGATIVE INDICATORS** (-1.0):\n- Improvement needed, needs attention, area for growth, challenge\n- Delays, missed deadlines, procrastination, late, tardy\n- Communication gaps, miscommunication, unclear, vague\n- Consistency issues, inconsistent, unreliable, unresponsive\n- Conflict, difficult, challenging personalities\n- Poor, weak, lacking, insufficient, inadequate\n\n**SENTIMENT SCORE FORMULA:**\nScore = (Count of Positive Indicators × 1.0 + Count of Neutral Indicators × 0.5 + Count of Negative Indicators × -1.0) / Total Indicators\nFinal Score Range: -1.0 to 1.0 → Normalize to 0-100 scale: (Score + 1.0) / 2.0 × 100\n\n=================================================================\nSTEP 3: GENERATE CONSOLIDATED SUMMARY (Per Comment Group)\n=================================================================\nGroup comments by sentiment theme (collaboration, technical skills, leadership, communication, execution, etc.)\nCreate brief thematic summary for each group highlighting:\n- Specific strengths mentioned\n- Specific improvement areas mentioned\n- Supporting evidence/quotes from comments\n\nDo NOT output individual comment scores - only thematic summaries.\n\n=================================================================\nSTEP 4: CREATE FINAL CONSOLIDATED SUMMARY\n=================================================================\nSynthesize all thematic summaries into ONE comprehensive paragraph:\n- Lead with strongest themes first\n- Include specific skills/strengths mentioned by multiple reviewers\n- Address improvement areas constructively\n- Maintain professional tone\n\nFormat:\n**Final Consolidated Summary:**\n[Single comprehensive paragraph with all themes]\n\nCalculate OVERALL SENTIMENT SCORE:\nAverage of all individual comment scores: (Sum of All Comment Scores) / (Total Comments)\nResult range: 0-100\n\nDetermine OVERALL SENTIMENT LABEL:\n- 80-100: Positive / Excellent\n- 60-79: Positive / Good\n- 40-59: Neutral / Fair\n- 20-39: Negative / Needs Improvement\n- 0-19: Negative / Critical\n\nAdd final line:\n**Overall Sentiment Score:** [0-100]\n**Overall Sentiment Label:** [Positive/Neutral/Negative]\n\n=================================================================\nOUTPUT FORMAT\n=================================================================\n**Final Consolidated Summary:**\n[Your synthesized summary paragraph here]\n\n**Overall Sentiment Score:** [0-100]\n**Overall Sentiment Label:** [Label based on score range]\n\n=================================================================\nCRITICAL NOTES\n=================================================================\n- Do NOT return individual comment sentiment scores\n- Do NOT return individual comment consolidated summaries\n- Only return the FINAL consolidated summary and overall metrics\n- Ensure sentiment analysis is data-driven based on indicator counts\n- Use professional language appropriate for HR/promotion context"
                    }
                  ],
                  "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"OverallSentimentLabel\": {\n            \"type\": \"string\"\n        },\n        \"OverallSentimentScore\": {\n            \"type\": \"number\"\n        },\n        \"FinalConsolidatedSummary\": {\n            \"type\": \"string\"\n        }\n    }\n}",
                  "type": "LLM"
                },
                {
                  "metadata": {
                    "name": "processManagerNotes",
                    "returnType": "object",
                    "sourceCode": "let notesOutput = $context.$nodes.LOOPWORKERS.FETCH_ASSIGNMENT_NOTES.$output;\nlet anytimeFeedback = $context.$nodes.LOOPWORKERS.CONSOLIDATEFEEDBACKRESPONSES.$output;\n\nif(notesOutput && notesOutput.choices && notesOutput.choices.length > 0 &&  notesOutput.choices[0] && notesOutput.choices[0].text){\nlet parsedText = JSON.parse(notesOutput.choices[0].text)\nconst paragraphs = [\n    parsedText.text_for_Paragraph_1,\n     parsedText.text_for_Paragraph_2,\n     parsedText.text_for_Paragraph_3,\n     parsedText.text_for_Conclusion\n  ];\n  // Remove \"NA\", empty, null, or undefined values\n  const finalParagraphs = paragraphs.filter(\n    text => typeof text === \"string\" && text.trim() !== \"\" && text !== \"NA\"\n  );\n\nlet ret = finalParagraphs.join(\"<br>\");\n\nlet NotesObj ={}\n\nNotesObj.text_for_Paragraph_1 = parsedText.text_for_Paragraph_1;\nNotesObj.text_for_Paragraph_2 = parsedText.text_for_Paragraph_2;\nNotesObj.text_for_Paragraph_3 = parsedText.text_for_Paragraph_3;\nNotesObj.text_for_Conclusion = parsedText.text_for_Conclusion;\n\n\nNotesObj.ManagerNotes = ret\n\nif(anytimeFeedback != null && anytimeFeedback.FinalConsolidatedSummary != null && anytimeFeedback.OverallSentimentScore != null)\n{\n   NotesObj.ConnectionFeedback = anytimeFeedback\n}\nelse\n{\n     NotesObj.ConnectionFeedback = {} \n}\n\nreturn NotesObj\n\n}\nelse\nreturn \"Not Available\""
                  },
                  "outcomes": {
                    "success": "1762422721164"
                  },
                  "code": "PROCESSMANAGERNOTES",
                  "id": "1771924361554",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
