        {
          "metadata": {
            "name": "Extract Ids",
            "returnType": "string",
            "sourceCode": "let ids = \"\";\nlet identifierKey = \"WorkflowId\";\nlet data = $context.$nodes.SEMANTIC_SEARCH.$output;\n\nif (data) {\n  // Loop through the input data and process each item\n  for (let i = 0; i < data.length && i < 100 ; i++) {\n    const item = data[i];\n    const parsedText = JSON.parse(item.text);\n    const key = Object.keys(parsedText)[0]; // Get the first key of the object, like \"90\", \"22\", etc.\n    const entity = parsedText[key];\n    if (entity[identifierKey] !== undefined) {\n      ids = ids+', '+entity[identifierKey];\n    }\n  }\nids = ids.substring(2);\n}\n\nreturn ids;"
          },
          "outcomes": {
            "success": "1766083530610"
          },
          "code": "EXTRACT_IDS",
