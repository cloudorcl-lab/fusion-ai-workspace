          },
          "code": "SUMMARIZE_SUMMARIES",
          "id": "1764564230880",
          "inputs": [
            {
              "id": "1764564230880_1",
              "name": "prompt",
              "type": "string",
              "value": "Summarize this content:\n{{$context.$system.$inputMessage}}\n\nInstructions:\n- Focus ONLY on the actual content/message, not technical details about delivery or system status\n- If the content is already brief and clear (under 2 sentences), you may use it as-is or condense it slightly\n- For longer content, provide a concise summary\n- Avoid meta-commentary like \"the system returned\" or \"delivered successfully\"\n- Use natural, direct language\n\nFormat:\n<h3>A short headline</h3>\n1-4 sentences summarizing the key points (use fewer sentences for simpler content)\n\n {{$context.$triggers.REST.$input.TRANSLATIONPROMPT}}"
            }
          ],
          "type": "LLM",
          "diagram": {
            "x": 9548,
            "y": 6094
          }
        },
        {
          "metadata": {
            "name": "Extract",
            "returnType": "string",
            "sourceCode": "const resultsArray = $context.$triggers.REST.$input.QUERYRESULTS ;\n\n let finalOutput = '<AGENT_OUPUTS>';\nconst PARAMETER_REGEX = /<parameter\\s+id=\"[^\"]*\"(?:\\s+[^>]+)?>[^<]*<\\/parameter>/g;\n\nresultsArray.forEach(item => {\n        finalOutput += '<AGENT_OUPUT>';\n        const output = item;\n        let match;\n        // The exec() method must be called repeatedly until it returns null to find all matches.\n        while ((match = PARAMETER_REGEX.exec(output)) !== null) {\n            const param = match[0];\n            finalOutput += param;\n        }\n        // Reset lastIndex for the next string iteration\n        PARAMETER_REGEX.lastIndex = 0; \n        finalOutput += '</AGENT_OUPUT>';\n});\nfinalOutput += '</AGENT_OUPUTS>';\nreturn finalOutput;"
          },
          "outcomes": {
            "success": "1764968282335"
          },
          "code": "EXTRACT",
          "id": "1764966841427",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
