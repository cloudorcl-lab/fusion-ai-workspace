        {
          "metadata": {
            "name": "Extract Available Agents",
            "returnType": "array",
            "sourceCode": "const input = $context.$triggers.REST.$input.AGENTS\n\nconst agents = Object.keys(input).map(key => {\n        // Get the agent details object for the current key\n        const agentDetails = input[key];\n\n        // De-structure the properties we want to keep/rename\n        const {\n            name,\n            description,\n            agent,\n            displayPrompt,\n            summaryPrompt,\n            actionsPrompt\n        } = agentDetails;\n\n        // Return the new, transformed object\n        return {\n            id: key,\n            name,\n            description,\n            agentCode: agent,\n            displayPrompt,\n            summaryPrompt,\n            actionsPrompt\n        };\n    });\n\nreturn agents;"
          },
          "outcomes": {
            "success": "1759286860078"
          },
          "code": "EXTRACT_AVAILABLE_AGENTS",
          "id": "1758818072091",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 7724,
            "y": 5206
