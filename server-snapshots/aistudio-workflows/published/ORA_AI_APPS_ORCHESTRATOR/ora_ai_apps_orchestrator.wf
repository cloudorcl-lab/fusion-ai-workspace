        {
          "metadata": {
            "name": "extract email details",
            "returnType": "object",
            "sourceCode": "const input = $context.$triggers.REST.$input.OraCommNonTemplateParamList;\nconst result = {};\n\nif (input && Array.isArray(input)) {\n  for (const item of input) {\n    if (typeof item === 'object' && item !== null && item.id) {\n      switch (item.id) {\n        case 'email':\n          result[\"email\"] = item.value;\n          break;\n        case 'subject':\n          result[\"subject\"] = item.value;\n          break;\n        case 'cc':\n          result[\"cc\"] = item.value;\n          break;\n      }\n    }\n  }\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1778862657982"
          },
          "code": "EXTRACT_EMAIL_DETAILS",
          "id": "1765141454931",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
