          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Prepare Account ES Payload",
            "returnType": "string",
            "sourceCode": "let partyNumber = $context.$variables.accountNumber;\nlet partyNumberValue = partyNumber == null ? \"\" : String(partyNumber);\n\nlet q = {\n  op: '$eq',\n  attribute: 'PartyNumber',\n  value: partyNumberValue\n};\n\nlet qStr = JSON.stringify(q);\nreturn qStr;"
          },
          "outcomes": {
            "success": "6"
          },
          "diagram": {
            "x": 6145,
            "y": 5912
          },
          "code": "PREPARE_ACCOUNT_ES_PAYLOAD",
          "id": "19",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
