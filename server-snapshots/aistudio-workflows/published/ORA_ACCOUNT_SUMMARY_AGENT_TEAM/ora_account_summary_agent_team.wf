          "code": "EXTRACT_INPUT_VARIABLES",
          "type": "LLM",
          "inputs": [
            {
              "id": "1776481781486_prompt",
              "name": "prompt",
              "type": "string",
              "value": "ROLE:\nClassify the user request for routing and extract the account PartyNumber.\n\nUSER MESSAGE:\n{{$context.$system.$inputMessage}}\n\nRUNTIME CONTEXT:\n{{$context.$system.$inputContext}}\n\nTASK:\nReturn valid JSON only with exactly these keys:\n- accountNumber\n- actionName\n\nACTION VALUES:\nUse exactly one of these actionName values:\n- BRIEF\n- COMPREHENSIVE\n- ENGAGEMENT\n- OUT_OF_SCOPE\n\nCLASSIFICATION LOGIC:\n1. ENGAGEMENT:\nUse when the user asks for account engagement, account engagement summary, engagement signals, engagement trends, communication activity, touchpoints, interaction history, emails, calls, notes, activities, or account-level engagement details.\n\n2. BRIEF:\nUse when the user asks for a short, brief, quick, or concise account summary. Includes phrases like brief summary, short summary, quick summary, or summary in brief.\n\n3. COMPREHENSIVE:\nUse when the user asks for a detailed, full, or comprehensive account summary. Also use COMPREHENSIVE as the default when the user asks for an account summary without specifying brief and does not match ACCOUNT_ENGAGEMENT.\n\n4. OUT_OF_SCOPE:\nUse only when the request is not related to generating an account summary or account engagement summary. This includes general knowledge, politics, celebrities, entertainment, sports, coding/technical issues, personal advice, or casual conversation.\n\nACCOUNT NUMBER EXTRACTION:\nExtract the PartyNumber/account number from {{$context.$system.$inputContext}} or {{$context.$system.$inputMessage}}. Return only the account number value in accountNumber. If not found, return an empty string.\n\nOUTPUT JSON EXAMPLE:\n{\n  \"accountNumber\": \"123456\",\n  \"actionName\": \"ENGAGEMENT\"\n}"
            },
            {
              "id": "1776481781486_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": ""
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"accountNumber\": {\n      \"type\": \"string\"\n    },\n    \"actionName\": {\n      \"type\": \"string\"\n    }\n  }\n}"
        },
