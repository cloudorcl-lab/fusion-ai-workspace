          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"description\": \"\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"organizationId\": {\n      \"type\": \"number\"\n    },\n    \"dataAvailableFromDate\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"dataAvailableToDate\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"rankings\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"startMonthDiffFromCurrent\",\n          \"endMonthDiffFromCurrent\",\n          \"orderType\",\n          \"numberOfItems\"\n        ],\n        \"properties\": {\n          \"startMonthDiffFromCurrent\": {\n            \"type\": \"number\"\n          },\n          \"endMonthDiffFromCurrent\": {\n            \"type\": \"number\"\n          },\n          \"orderType\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"numberOfItems\": {\n            \"type\": \"number\"\n          },\n          \"items\": {\n            \"type\": \"array\",\n            \"uniqueItems\": true,\n            \"minItems\": 1,\n            \"items\": {\n              \"required\": [\n                \"inventoryItemId\",\n                \"itemNumber\",\n                \"itemDescription\",\n                \"itemRank\",\n                \"clusterId\",\n                \"clusterRank\",\n                \"itemScore\",\n                \"turnoverRatio\",\n                \"salesPercentage\",\n                \"weightedAge\"\n              ],\n              \"properties\": {\n                \"inventoryItemId\": {\n                  \"type\": \"number\"\n                },\n                \"itemNumber\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"itemDescription\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"itemRank\": {\n                  \"type\": \"number\"\n                },\n                \"clusterId\": {\n                  \"type\": \"number\"\n                },\n                \"clusterRank\": {\n                  \"type\": \"number\"\n                },\n                \"itemScore\": {\n                  \"type\": \"number\"\n                },\n                \"turnoverRatio\": {\n                  \"type\": \"number\"\n                },\n                \"salesPercentage\": {\n                  \"type\": \"number\"\n                },\n                \"weightedAge\": {\n                  \"type\": \"number\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"organizationId\",\n    \"dataAvailableFromDate\",\n    \"dataAvailableToDate\",\n    \"rankings\"\n  ]\n}",
