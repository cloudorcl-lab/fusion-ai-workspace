        {
          "metadata": {
            "name": "TransformShortageAndStockoutData",
            "returnType": "array",
            "sourceCode": "let orgCode = $context.$variables.OrganizationCode;\n\nconst shortageItems = (\n  $context &&\n  $context.$nodes &&\n  $context.$nodes.GETLOCATIONSHORTAGE &&\n  $context.$nodes.GETLOCATIONSHORTAGE.$output &&\n  Array.isArray($context.$nodes.GETLOCATIONSHORTAGE.$output.items)\n) ? $context.$nodes.GETLOCATIONSHORTAGE.$output.items : [];\n\nconst shortageArray = (shortageItems.length > 0)\n  ? shortageItems.map(item => ({\n      OrganizationId: item.OrganizationId,\n      OrganizationCode: orgCode,\n      InventoryItemId: item.InventoryItemId,\n      ItemNumber: item.ItemNumber,\n      Subinventory: item.Subinventory,\n      InboundSupplyAvailableFlag: item.InboundSupplyAvailableFlag,\n      AvailableElsewhereFlag: item.AvailableElsewhereFlag,\n      SubstituteItemAvailableFlag: item.SubstituteItemAvailableFlag,\n      ItemMinimumValue:item.ItemMinimumValue,\n      ItemMaximumValue:item.ItemMaximumValue,\n      PrimaryUnitOfMeasure:item.PrimaryUnitOfMeasure,\n      LocatorName:null,\n      Context: \"Shortage\"\n    }))\n  : [];\n\nconst stockoutItems = (\n  $context &&\n  $context.$nodes &&\n  $context.$nodes.GETLOCATIONSTOCKOUT &&\n  $context.$nodes.GETLOCATIONSTOCKOUT.$output &&\n  Array.isArray($context.$nodes.GETLOCATIONSTOCKOUT.$output.items)\n) ? $context.$nodes.GETLOCATIONSTOCKOUT.$output.items : [];\n\nconst stockoutArray = (stockoutItems.length > 0)\n  ? stockoutItems.map(item => ({\n      OrganizationId: item.OrganizationId,\n      OrganizationCode: orgCode,\n      InventoryItemId: item.InventoryItemId,\n      ItemNumber: item.ItemNumber,\n      Subinventory: item.Subinventory,\n      InboundSupplyAvailableFlag: item.InboundSupplyAvailableFlag,\n      AvailableElsewhereFlag: item.AvailableElsewhereFlag,\n      SubstituteItemAvailableFlag: item.SubstituteItemAvailableFlag,\n      ItemMinimumValue:item.ItemMinimumValue,\n      ItemMaximumValue:item.ItemMaximumValue,\n      PrimaryUnitOfMeasure:item.PrimaryUnitOfMeasure,\n      LocatorName:null,\n      Context: \"Stockout\"\n    }))\n  : [];\n\nconst PARLocationStockoutItems = (\n  $context &&\n  $context.$nodes &&\n  $context.$nodes.GETPARLOCATIONSTOCKOUT &&\n  $context.$nodes.GETPARLOCATIONSTOCKOUT.$output &&\n  Array.isArray($context.$nodes.GETPARLOCATIONSTOCKOUT.$output.items)\n) ? $context.$nodes.GETPARLOCATIONSTOCKOUT.$output.items : [];\n\nconst PARLocationStockoutArray = (PARLocationStockoutItems.length > 0)\n  ? PARLocationStockoutItems.map(item => ({\n      OrganizationId: item.OrganizationId,\n      OrganizationCode: orgCode,\n      InventoryItemId: item.InventoryItemId,\n      ItemNumber: item.ItemNumber,\n      Subinventory: item.Subinventory,\n      InboundSupplyAvailableFlag: item.InboundSupplyAvailableFlag,\n      AvailableElsewhereFlag: item.AvailableElsewhereFlag,\n      SubstituteItemAvailableFlag: item.SubstituteItemAvailableFlag,\n      ItemMinimumValue:item.PARLevel,\n      ItemMaximumValue:item.PARMaximumQuantity,\n      PrimaryUnitOfMeasure:item.PrimaryUnitOfMeasure,\n      LocatorName:item.Locator,\n      Context: \"Stockout\"\n    }))\n  : [];\n\nconst PARLocationShortageItems = (\n  $context &&\n  $context.$nodes &&\n  $context.$nodes.GETPARLOCATIONSHORTAGE &&\n  $context.$nodes.GETPARLOCATIONSHORTAGE.$output &&\n  Array.isArray($context.$nodes.GETPARLOCATIONSHORTAGE.$output.items)\n) ? $context.$nodes.GETPARLOCATIONSHORTAGE.$output.items : [];\n\nconst PARLocationShortageArray = (PARLocationShortageItems.length > 0)\n  ? PARLocationShortageItems.map(item => ({\n      OrganizationId: item.OrganizationId,\n      OrganizationCode: orgCode,\n      InventoryItemId: item.InventoryItemId,\n      ItemNumber: item.ItemNumber,\n      Subinventory: item.Subinventory,\n      InboundSupplyAvailableFlag: item.InboundSupplyAvailableFlag,\n      AvailableElsewhereFlag: item.AvailableElsewhereFlag,\n      SubstituteItemAvailableFlag: item.SubstituteItemAvailableFlag,\n      ItemMinimumValue:item.PARLevel,\n      ItemMaximumValue:item.PARMaximumQuantity,\n      PrimaryUnitOfMeasure:item.PrimaryUnitOfMeasure,\n      LocatorName:item.Locator,\n      Context: \"Shortage\"\n    }))\n  : [];\n\nconst KanbanLocationShortageItems = (\n  $context &&\n  $context.$nodes &&\n  $context.$nodes.GETKANBANLOCATIONSHORTAGE &&\n  $context.$nodes.GETKANBANLOCATIONSHORTAGE.$output &&\n  Array.isArray($context.$nodes.GETKANBANLOCATIONSHORTAGE.$output.items)\n) ? $context.$nodes.GETKANBANLOCATIONSHORTAGE.$output.items : [];\n\nconst KanbanLocationShortageArray = (KanbanLocationShortageItems.length > 0)\n  ? KanbanLocationShortageItems.map(item => ({\n      OrganizationId: item.OrganizationId,\n      OrganizationCode: orgCode,\n      InventoryItemId: item.InventoryItemId,\n      ItemNumber: item.ItemNumber,\n      Subinventory: item.Subinventory,\n      InboundSupplyAvailableFlag: item.InboundSupplyAvailableFlag,\n      AvailableElsewhereFlag: item.AvailableElsewhereFlag,\n      SubstituteItemAvailableFlag: item.SubstituteItemAvailableFlag,\n      ItemMinimumValue:item.ItemMinimumValue,\n      ItemMaximumValue:item.ItemMaximumValue,\n      PrimaryUnitOfMeasure:item.PrimaryUnitOfMeasure,\n      LocatorName:item.Locator,\n      Context: \"Shortage\"\n    }))\n  : [];\n\nconst KanbanLocationStockoutItems = (\n  $context &&\n  $context.$nodes &&\n  $context.$nodes.GETKANBANLOCATIONSTOCKOUT &&\n  $context.$nodes.GETKANBANLOCATIONSTOCKOUT.$output &&\n  Array.isArray($context.$nodes.GETKANBANLOCATIONSTOCKOUT.$output.items)\n) ? $context.$nodes.GETKANBANLOCATIONSTOCKOUT.$output.items : [];\n\nconst KanbanLocationStockoutArray = (KanbanLocationStockoutItems.length > 0)\n  ? KanbanLocationStockoutItems.map(item => ({\n      OrganizationId: item.OrganizationId,\n      OrganizationCode: orgCode,\n      InventoryItemId: item.InventoryItemId,\n      ItemNumber: item.ItemNumber,\n      Subinventory: item.Subinventory,\n      InboundSupplyAvailableFlag: item.InboundSupplyAvailableFlag,\n      AvailableElsewhereFlag: item.AvailableElsewhereFlag,\n      SubstituteItemAvailableFlag: item.SubstituteItemAvailableFlag,\n      ItemMinimumValue:item.ItemMinimumValue,\n      ItemMaximumValue:item.ItemMaximumValue,\n      PrimaryUnitOfMeasure:item.PrimaryUnitOfMeasure,\n      LocatorName:item.Locator,\n      Context: \"Stockout\"\n    }))\n  : [];\n\nlet combinedArray = [];\ncombinedArray = stockoutArray.concat(PARLocationStockoutArray);\ncombinedArray = combinedArray.concat(shortageArray);\ncombinedArray = combinedArray.concat(PARLocationShortageArray);\ncombinedArray = combinedArray.concat(KanbanLocationShortageArray);\ncombinedArray = combinedArray.concat(KanbanLocationStockoutArray);\nreturn combinedArray;"
          },
