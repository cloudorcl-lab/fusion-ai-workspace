                    "sourceCode": "// Step 1: Get the array of items from REST call\nlet inputItems = $context.$nodes.GETSHORTAGEITEMSFORORGS.TRANSFORMSHORTAGEANDSTOCKOUTDATASCHEDULER.$output.result?? [];\n\n// Step 2: Loop through each item and add to LoopOutput\nfor (let i = 0; i < inputItems.length; i++) {\n  const currentItem = inputItems[i];\n\n  if (!currentItem) continue; // Skip null/undefined\n\n  // Add current item with OrganizationCode\n  $context.$nodes.INITIALIZELOOPOUTPUT.$output.result.items.push({\n    ...currentItem,    // Keep all existing fields\n  });\n}\n\n// Step 3: Return updated LoopOutput\nreturn $context.$nodes.INITIALIZELOOPOUTPUT.$output.result;"
