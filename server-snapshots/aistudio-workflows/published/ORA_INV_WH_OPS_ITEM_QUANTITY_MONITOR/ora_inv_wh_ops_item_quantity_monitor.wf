                    "sourceCode": "let orgCode =\n  $context?.$nodes?.GETSHORTAGEORGANIZATIONS?.$output?.items?.[\n    $context?.$nodes?.GETSHORTAGEITEMSFORORGS?.$currentItemIndex\n  ]?.OrganizationCode;\n\nconst shortageItems = ( \n  $context &&\n  $context.$nodes &&\n  $context.$nodes.GETSHORTAGEITEMSFORORGS &&\n  $context.$nodes.GETSHORTAGEITEMSFORORGS.GETLOCATIONSHORTAGESCHEDULER &&\n  $context.$nodes.GETSHORTAGEITEMSFORORGS.GETLOCATIONSHORTAGESCHEDULER.$output &&\n  Array.isArray($context.$nodes.GETSHORTAGEITEMSFORORGS.GETLOCATIONSHORTAGESCHEDULER.$output.items)\n) ? $context.$nodes.GETSHORTAGEITEMSFORORGS.GETLOCATIONSHORTAGESCHEDULER.$output.items : [];\n\nconst shortageArray = (shortageItems.length > 0)\n  ? shortageItems.map(item => ({\n      OrganizationId: item.OrganizationId,\n      OrganizationCode: orgCode,\n      InventoryItemId: item.InventoryItemId,\n      ItemNumber: item.ItemNumber,\n      Subinventory: item.Subinventory,\n      InboundSupplyAvailableFlag: item.InboundSupplyAvailableFlag,\n      AvailableElsewhereFlag: item.AvailableElsewhereFlag,\n      SubstituteItemAvailableFlag: item.SubstituteItemAvailableFlag,\n      ItemMinimumValue:item.ItemMinimumValue,\n      ItemMaximumValue:item.ItemMaximumValue,\n      PrimaryUnitOfMeasure:item.PrimaryUnitOfMeasure,\n      PrimaryUnitOfMeasureCode: item.PrimaryUnitOfMeasureCode,\n      AvailableToTransactQuantity: item.AvailableToTransactQuantity,\n      LocatorName:null,\n      LocatorId: null,\n      Context: \"Shortage\"\n    }))\n  : [];\n\nconst stockoutItems = (\n  $context &&\n  $context.$nodes &&\n  $context.$nodes.GETSHORTAGEITEMSFORORGS &&\n  $context.$nodes.GETSHORTAGEITEMSFORORGS.GETLOCATIONSTOCKOUTSCHEDULER &&\n  $context.$nodes.GETSHORTAGEITEMSFORORGS.GETLOCATIONSTOCKOUTSCHEDULER.$output &&\n  Array.isArray($context.$nodes.GETSHORTAGEITEMSFORORGS.GETLOCATIONSTOCKOUTSCHEDULER.$output.items)\n) ? $context.$nodes.GETSHORTAGEITEMSFORORGS.GETLOCATIONSTOCKOUTSCHEDULER.$output.items : [];\n\nconst stockoutArray = (stockoutItems.length > 0)\n  ? stockoutItems.map(item => ({\n      OrganizationId: item.OrganizationId,\n      OrganizationCode: orgCode,\n      InventoryItemId: item.InventoryItemId,\n      ItemNumber: item.ItemNumber,\n      Subinventory: item.Subinventory,\n      InboundSupplyAvailableFlag: item.InboundSupplyAvailableFlag,\n      AvailableElsewhereFlag: item.AvailableElsewhereFlag,\n      SubstituteItemAvailableFlag: item.SubstituteItemAvailableFlag,\n      ItemMinimumValue:item.ItemMinimumValue,\n      ItemMaximumValue:item.ItemMaximumValue,\n      PrimaryUnitOfMeasure:item.PrimaryUnitOfMeasure,\n      PrimaryUnitOfMeasureCode: item.PrimaryUnitOfMeasureCode,\n      AvailableToTransactQuantity: item.AvailableToTransactQuantity,\n      LocatorName:null,\n      LocatorId: null,\n      Context: \"Stockout\"\n    }))\n  : [];\n\nconst PARLocationStockoutItems = ( \n  $context &&\n  $context.$nodes &&\n  $context.$nodes.GETSHORTAGEITEMSFORORGS &&\n  $context.$nodes.GETSHORTAGEITEMSFORORGS.GETPARLOCATIONSTOCKOUTSCHEDULER &&\n  $context.$nodes.GETSHORTAGEITEMSFORORGS.GETPARLOCATIONSTOCKOUTSCHEDULER.$output &&\n  Array.isArray($context.$nodes.GETSHORTAGEITEMSFORORGS.GETPARLOCATIONSTOCKOUTSCHEDULER.$output.items)\n) ? $context.$nodes.GETSHORTAGEITEMSFORORGS.GETPARLOCATIONSTOCKOUTSCHEDULER.$output.items : [];\n\nconst PARLocationStockoutArray = (PARLocationStockoutItems.length > 0)\n  ? PARLocationStockoutItems.map(item => ({\n      OrganizationId: item.OrganizationId,\n      OrganizationCode: orgCode,\n      InventoryItemId: item.InventoryItemId,\n      ItemNumber: item.ItemNumber,\n      Subinventory: item.Subinventory,\n      InboundSupplyAvailableFlag: item.InboundSupplyAvailableFlag,\n      AvailableElsewhereFlag: item.AvailableElsewhereFlag,\n      SubstituteItemAvailableFlag: item.SubstituteItemAvailableFlag,\n      ItemMinimumValue:item.PARLevel,\n      ItemMaximumValue:item.PARMaximumQuantity,\n      PrimaryUnitOfMeasure:item.PrimaryUnitOfMeasure,\n      PrimaryUnitOfMeasureCode: item.PrimaryUnitOfMeasureCode,\n      AvailableToTransactQuantity: item.AvailableToTransactQuantity,\n      LocatorName:item.Locator,\n      LocatorId: item.LocatorId,\n      Context: \"Stockout\"\n    }))\n  : [];\n\nconst PARLocationShortageItems = ( \n  $context &&\n  $context.$nodes &&\n  $context.$nodes.GETSHORTAGEITEMSFORORGS &&\n  $context.$nodes.GETSHORTAGEITEMSFORORGS.GETPARLOCATIONSHORTAGESCHEDULER &&\n  $context.$nodes.GETSHORTAGEITEMSFORORGS.GETPARLOCATIONSHORTAGESCHEDULER.$output &&\n  Array.isArray($context.$nodes.GETSHORTAGEITEMSFORORGS.GETPARLOCATIONSHORTAGESCHEDULER.$output.items)\n) ? $context.$nodes.GETSHORTAGEITEMSFORORGS.GETPARLOCATIONSHORTAGESCHEDULER.$output.items : [];\n\nconst PARLocationShortageArray = (PARLocationShortageItems.length > 0)\n  ? PARLocationShortageItems.map(item => ({\n      OrganizationId: item.OrganizationId,\n      OrganizationCode: orgCode,\n      InventoryItemId: item.InventoryItemId,\n      ItemNumber: item.ItemNumber,\n      Subinventory: item.Subinventory,\n      InboundSupplyAvailableFlag: item.InboundSupplyAvailableFlag,\n      AvailableElsewhereFlag: item.AvailableElsewhereFlag,\n      SubstituteItemAvailableFlag: item.SubstituteItemAvailableFlag,\n      ItemMinimumValue:item.PARLevel,\n      ItemMaximumValue:item.PARMaximumQuantity,\n      PrimaryUnitOfMeasure:item.PrimaryUnitOfMeasure,\n      PrimaryUnitOfMeasureCode: item.PrimaryUnitOfMeasureCode,\n      AvailableToTransactQuantity: item.AvailableToTransactQuantity,\n      LocatorName:item.Locator,\n      LocatorId: item.LocatorId,\n      Context: \"Shortage\"\n    }))\n  : [];\n\nconst KanbanLocationShortageItems = ( \n  $context &&\n  $context.$nodes &&\n  $context.$nodes.GETSHORTAGEITEMSFORORGS &&\n  $context.$nodes.GETSHORTAGEITEMSFORORGS.GETKANBANLOCATIONSHORTAGESCHEDULER &&\n  $context.$nodes.GETSHORTAGEITEMSFORORGS.GETKANBANLOCATIONSHORTAGESCHEDULER.$output &&\n  Array.isArray($context.$nodes.GETSHORTAGEITEMSFORORGS.G