        {
          "metadata": {
            "name": "PrepareMultiRecordWidget",
            "returnType": "object",
            "sourceCode": "const Data = $context.$nodes.GETSLOWMOVINGITEMS.$output.rankings?.[0]?.items ?? [];\n\nconst OrganizationId = $context.$variables.OrganizationId;\nconst OrganizationCode = $context.$variables.OrganizationCode ?? \"\";\n\n// Step 1: Prepare rows\nconst multiRecordWidgetRows = [];\n\nfor (let i = 0; i < Data.length; i++) {\n  const row = Data[i];\n\n  multiRecordWidgetRows.push({\n    cells: [\n      row.itemNumber ?? null,        // Item\n      row.itemDescription ?? null,   // Item Description\n      row.turnoverRatio ?? null,     // Turnover Ratio\n      row.salesPercentage ?? null,   // Sales Percentage\n      row.weightedAge ?? null        // Weighted Average (mapped from weightedAge)\n    ],\n    action: {\n      text: \"View\",\n      command: `ora.Invoke(NavigateToSlowMovingItemWorkspace,${JSON.stringify({\n        command: \"SlowMovingItems\",\n        OrganizationId: OrganizationId,\n        OrganizationCode: OrganizationCode,\n        InventoryItemId: row.inventoryItemId,\n        ItemNumber: row.itemNumber\n      })})`\n    }\n  });\n}\n\n// Step 2: Build widget\nlet multiRecordWidget = null;\n\nif (multiRecordWidgetRows.length > 0) {\n  multiRecordWidget = {\n    title: \"Slow Moving Items\",\n    patternId: \"multiRecordWidget\",\n    description: \"Items with low turnover and sales contribution\",\n    properties: {\n      subtitle: \"Top slow-moving inventory items\",\n      cols: [\n        \"Item\",\n        \"Item Description\",\n        \"Turnover Ratio\",\n        \"Sales Percentage\",\n        \"Weighted Average\"\n      ],\n      rows: multiRecordWidgetRows\n    }\n  };\n}\n\nreturn { multiRecordWidget };"
          },
          "outcomes": {
            "success": "1774000086705"
          },
          "code": "PREPAREMULTIRECORDWIDGET",
          "id": "1774455665956",
          "inputs": [],
