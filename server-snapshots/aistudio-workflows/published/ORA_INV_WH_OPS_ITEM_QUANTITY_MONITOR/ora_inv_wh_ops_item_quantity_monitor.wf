        {
          "metadata": {
            "name": "PreparePriorityActions",
            "returnType": "array",
            "sourceCode": "const resultList = $context.$nodes.TRANSFORMSHORTAGEANDSTOCKOUTDATA.$output.result ?? [];\nconst highPriorityActions = [];\n\nif (resultList.length > 0) {\n  for (let i = 0; i < resultList.length; i++) {\n    const row = resultList[i];\n    // Only create an action if Context is \"Stockout\" (skip \"Shortage\" and others)\n    if (row.Context === \"Stockout\") {\n      highPriorityActions.push({\n        title: `Stockout Detected for Item: ${row.ItemNumber}`,\n        priority: true,\n        actionText: \"View Replenishment Options\",\n        followUpCommand: `ora.Agent({'command': 'ReplenishmentOptions', 'OrganizationCode': ${JSON.stringify(row.OrganizationCode)}, 'OrganizationId': ${JSON.stringify(row.OrganizationId)}, 'InventoryItemId': ${JSON.stringify(row.InventoryItemId)}, 'ItemNumber': ${JSON.stringify(row.ItemNumber)}, 'Subinventory': ${JSON.stringify(row.Subinventory)}, 'Context': ${JSON.stringify(row.Context)}})`\n      });\n    }\n  }\n}\nreturn highPriorityActions;"
          },
          "outcomes": {
            "success": "1767596382721"
          },
          "code": "PREPAREPRIORITYACTIONS",
          "convergenceTargetId": "1767596382721",
          "id": "1772113834621",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Prepare Widgets",
            "returnType": "object",
            "sourceCode": "const SuggestionList = $context.$nodes.EXTRACTREPLENISHMENTOPTIONWFOUTPUT.$output?.result ?? [];\nconst ItemNumber = $context.$nodes.EXTRACTORAAPPCONTEXT.$output.result.ItemNumber;\n\nconst multiRecordWidgetRows = [];\nconst InboundMultiRecordWidgetRows = [];\nconst substituteMultiRecordWidgetRows = [];\nfor (let i = 0; i < SuggestionList.length; i++) {\n  const s = SuggestionList[i];\n  // Main actionable suggestions\n  if ( s.ReplenishmentType !== \"INBOUND\" && s.ReplenishmentType !== \"SUBSTITUTE\"  ) {\n    multiRecordWidgetRows.push({\n      cells: [\n        s.SourceOrganizationCode !== undefined ? s.SourceOrganizationCode : null,\n        s.DestinationSubinventoryCode !== undefined ? s.DestinationSubinventoryCode : null,\n        s.OrderQuantity !== undefined && s.UOMName !== undefined && s.OrderQuantity !== null && s.UOMName !== null\n          ? s.OrderQuantity + \" \" + s.UOMName\n          : null,\n        s.ReplenishmentTypeName !== undefined ? s.ReplenishmentTypeName : null,\n      ],\n      action: {\n        text: \"Execute\",\n        command: `ora.Agent({\"command\": \"OrderCreation\", \"suggestion\": ${JSON.stringify(s)}})`,\n      },\n    });\n  }\n  // INBOUND\n  else if (s.ReplenishmentType === \"INBOUND\") {\n    InboundMultiRecordWidgetRows.push({\n      cells: [\n        s.DocumentType !== undefined ? s.DocumentType : null,\n        s.DocumentNumber !== undefined ? s.DocumentNumber : null,\n        s.InboundQuantity !== undefined && s.UOMName !== undefined && s.InboundQuantity !== null && s.UOMName !== null\n          ? s.InboundQuantity + \" \" + s.UOMName\n          : null,\n        s.DueDate !== undefined ? s.DueDate : null,\n        s.Suggestions !== undefined ? s.Suggestions : null,\n      ],\n    });\n  }\n  // SUBSTITUTE\n  else if (s.ReplenishmentType === \"SUBSTITUTE\") {\n    substituteMultiRecordWidgetRows.push({\n      cells: [\n        s.SourceSubinventory !== undefined ? s.SourceSubinventory : null,     // Fixed!\n        s.SubItemNumber !== undefined ? s.SubItemNumber : null,\n        s.SubQuantity !== undefined && s.UOMName !== undefined && s.SubQuantity !== null && s.UOMName !== null\n          ? s.SubQuantity + \" \" + s.UOMName\n          : null,\n        s.Suggestions !== undefined ? s.Suggestions : null,\n      ],\n    });\n  }\n}\n\nlet multiRecordWidget = null;\nif (multiRecordWidgetRows.length > 0) {\n  multiRecordWidget = {\n    title: \"Actionable Replenishment Suggestions for item \" + ItemNumber,\n    patternId: \"multiRecordWidget\",\n    description: \"Suggestions where an order or transfer is recommended\",\n    properties: {\n      subtitle: \"Options to resolve shortages or stockouts with new orders or transfers\",\n      cols: [\n        \"Source Organization\",\n        \"Subinventory\",\n        \"Quantity\",\n        \"Suggestion\"\n      ],\n      rows: multiRecordWidgetRows,\n    },\n  };\n}\n\nlet inboundMultiRecordWidget = null;\nif (InboundMultiRecordWidgetRows.length > 0) {\n  inboundMultiRecordWidget = {\n    title: \"Replenishment Suggestions for item \" + ItemNumber,\n    patternId: \"multiRecordWidget\",\n    description: \"Inbound supply that could address the shortage\",\n    properties: {\n      subtitle: \"Inbound orders in transit\",\n      cols: [\n        \"Document Type\",\n        \"Document Number\",\n        \"Quantity\",\n        \"Due Date\",\n        \"Suggestion\"\n      ],\n      rows: InboundMultiRecordWidgetRows,\n    },\n  };\n}\n\nlet substituteMultiRecordWidget = null;\nif (substituteMultiRecordWidgetRows.length > 0) {\n  substituteMultiRecordWidget = {\n    title: \"Replenishment Suggestions for item \" + ItemNumber,\n    patternId: \"multiRecordWidget\",\n    description: \"Substitute items available to resolve shortage\",\n    properties: {\n      subtitle: \"Possible substitutes for current item\",\n      cols: [\n        \"Source Subinventory\",\n        \"Substitute Item\",\n        \"Quantity\",\n        \"Suggestion\"\n      ],\n      rows: substituteMultiRecordWidgetRows,\n    },\n  };\n}\nconst preparedWidgets = {\n  multiRecordWidget: multiRecordWidget,\n  inboundMultiRecordWidget: inboundMultiRecordWidget,\n  substituteMultiRecordWidget: substituteMultiRecordWidget,\n};\nreturn preparedWidgets;"
          },
          "outcomes": {
            "success": "1772115568371"
          },
          "code": "PREPARE_WIDGETS",
          "id": "1772115049283",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
