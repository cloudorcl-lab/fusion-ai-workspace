\": {\n      \"type\": \"boolean\"\n    },\n    \"AvailableElsewhereFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"SubstituteItemAvailableFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"TotalCount\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"KanbanSize\": {\n      \"type\": \"number\"\n    },\n    \"NumberOfCards\": {\n      \"type\": \"number\"\n    },\n    \"PurchasingEnabledFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"StockEnabledFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"RestrictSubinventoriesCode\": {\n      \"type\": \"number\"\n    },\n    \"TransferOrderEnabledFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"RestrictLocatorsCode\": {\n      \"type\": \"number\"\n    },\n    \"LocationControlCode\": {\n      \"type\": \"number\"\n    },\n    \"RevisionQuantityControlCode\": {\n      \"type\": \"number\"\n    },\n    \"CreationDate\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"CreatedBy\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"LastUpdateDate\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"LastUpdatedBy\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"AverageDemandPeriod\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"ShortageThreshold\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"OpenSupplyPeriod\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"OpenDemandPeriod\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"href\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"name\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"kind\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"OrganizationId\",\n    \"InventoryItemId\",\n    \"ItemNumber\",\n    \"PrimaryUnitOfMeasureCode\",\n    \"PrimaryUnitOfMeasure\",\n    \"SecondaryUnitOfMeasureCode\",\n    \"SecondaryUnitOfMeasure\",\n    \"Subinventory\",\n    \"SubinventoryName\",\n    \"LocatorId\",\n    \"Locator\",\n    \"ItemMinimumValue\",\n    \"ItemMaximumValue\",\n    \"OnhandQuantity\",\n    \"SecondaryOnhandQuantity\",\n    \"AvailableToTransactQuantity\",\n    \"SecondaryAvailableToTransactQuantity\",\n    \"ActualDemandQuantity\",\n    \"SecondaryActualDemandQuantity\",\n    \"AverageDemandQuantity\",\n    \"SecondaryAverageDemandQuantity\",\n    \"DemandTrendPercentage\",\n    \"InboundSupplyAvailableFlag\",\n    \"SupplyDelayedFlag\",\n    \"AvailableElsewhereFlag\",\n    \"SubstituteItemAvailableFlag\",\n    \"TotalCount\",\n    \"KanbanSize\",\n    \"NumberOfCards\",\n    \"PurchasingEnabledFlag\",\n    \"StockEnabledFlag\",\n    \"RestrictSubinventoriesCode\",\n    \"TransferOrderEnabledFlag\",\n    \"RestrictLocatorsCode\",\n    \"LocationControlCode\",\n    \"RevisionQuantityControlCode\",\n    \"CreationDate\",\n    \"CreatedBy\",\n    \"LastUpdateDate\",\n    \"LastUpdatedBy\",\n    \"AverageDemandPeriod\",\n    \"ShortageThreshold\",\n    \"OpenSupplyPeriod\",\n    \"OpenDemandPeriod\",\n    \"links\"\n  ]\n}",
