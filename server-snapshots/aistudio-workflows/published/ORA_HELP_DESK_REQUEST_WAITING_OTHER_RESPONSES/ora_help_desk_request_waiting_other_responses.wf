            "sourceCode": "const messageHint = $context.$triggers.REST.$input.OraMessageHint;\n\nconst map = {\n    Summary: 'Summary',\n    InitDisplay: 'InitDisplay',\n    Query: 'Query',\n    InvokeAction: 'InvokeAction',\n    InitCommunications: 'InitCommunications',\n    SendCommunication: 'SendCommunication'\n};\n\nreturn map[messageHint] || 'Default';"
