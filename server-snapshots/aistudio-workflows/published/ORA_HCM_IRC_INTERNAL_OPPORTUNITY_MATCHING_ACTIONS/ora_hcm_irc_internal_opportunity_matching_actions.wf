            "name": "Return fav gig message",
            "returnType": "object",
            "sourceCode": "var message = \"\";\nconst title = $context.$variables.opportunityTitle ;\n\nif (title){\n    message= \"The gig \" + title + \" has been added to favourites. \" ;\n}else{\n    message= \"The gig has been added to favourites. \" ;\n}\n\nreturn {\"PerformedAction\": \"FAVGIG\", \"Message\": message};"
