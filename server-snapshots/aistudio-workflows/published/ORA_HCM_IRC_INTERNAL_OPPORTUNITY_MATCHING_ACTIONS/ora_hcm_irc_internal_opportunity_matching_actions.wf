          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"description\": \"\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"ActionType\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"ContextId\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"PersonId\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"ContextType\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"@context\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"key\": {\n          \"type\": \"string\",\n          \"minLength\": 1\n        },\n        \"links\": {\n          \"type\": \"array\",\n          \"uniqueItems\": true,\n          \"minItems\": 1,\n          \"items\": {\n            \"required\": [\n              \"rel\",\n              \"href\",\n              \"name\",\n              \"kind\"\n            ],\n            \"properties\": {\n              \"rel\": {\n                \"type\": \"string\",\n                \"minLength\": 1\n              },\n              \"href\": {\n                \"type\": \"string\",\n                \"minLength\": 1\n              },\n              \"name\": {\n                \"type\": \"string\",\n                \"minLength\": 1\n              },\n              \"kind\": {\n                \"type\": \"string\",\n                \"minLength\": 1\n              }\n            }\n          }\n        }\n      },\n      \"required\": [\n        \"key\",\n        \"links\"\n      ]\n    }\n  },\n  \"required\": [\n    \"ActionType\",\n    \"ContextId\",\n    \"PersonId\",\n    \"ContextType\",\n    \"@context\"\n  ]\n}",
