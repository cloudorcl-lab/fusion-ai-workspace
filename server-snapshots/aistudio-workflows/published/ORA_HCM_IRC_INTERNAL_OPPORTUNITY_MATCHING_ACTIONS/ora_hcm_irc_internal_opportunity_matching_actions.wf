            "sourceCode": "var message = \"\";\nconst title = $context.$variables.opportunityTitle ;\n\nif (title){\n    message= \"You have successfully applied for the gig \" + title;\n}else{\n    message= \"You have successfully applied for the gig \" ;\n}\n\nreturn {\"PerformedAction\": \"APPLYGIG\", \"Message\": message};"
