            "errorNodeId": "1770067603123",
            "name": "Return Gig Details",
            "returnType": "object",
            "sourceCode": "const gigDetails= $context.$nodes.GET_GIG_DETAILS.$output;\n\nconst {GigId, GigNumber, StartDate, EndDate, PublishDate, TimeCommitment, RemoteOpportunityFlag, StatusCode, OrganizationId, Title, DescriptionStr, Location, CreatorName, CreatorEmail, CreatorPhoneNumber, CreatorPosition, BookmarkFlag, HasAppliedFlag, GigValidFlag, ProfileId, FilledCount, OpeningsCount} = gigDetails;\n\nconst newObj = {GigId, GigNumber, StartDate, EndDate, PublishDate, TimeCommitment, RemoteOpportunityFlag, StatusCode, OrganizationId, Title, DescriptionStr, Location, CreatorName, CreatorEmail, CreatorPhoneNumber, CreatorPosition, BookmarkFlag, HasAppliedFlag, GigValidFlag, ProfileId, FilledCount, OpeningsCount};\n\nconst final = {\"PerformedAction\" : \"GIGDETAILS\", \"GigDetails\": newObj};\n\nreturn final;"
          },
          "outcomes": {
            "success": "end"
          },
