          "code": "DECIPHER_INTENT_OF_USER_MESSAGE",
          "id": "1774389950132",
          "inputs": [
            {
              "id": "1774389950133_1",
              "name": "prompt",
              "type": "string",
              "value": "Input: {{$context.$system.$inputMessage}} \nAnalyze the Input and determine the intent of the message.\nIf intent is to get the status of a specific order number, return the order number. \nIf the intent is to check for the status of a recent purchase order, return \"recent\".\nOtherwise return \"other\" in intent.\nDo not provide any explanation or extra text in the response."
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"Intent\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM",
          "diagram": {
