          "type": "CODE",
          "metadata": {
            "name": "Clean Purchase Order Details",
            "returnType": "object",
            "sourceCode": "function sanitizeOrder(order) {\n  return {\n    OrderNumber: order.OrderNumber,\n    Status: order.StatusCode,\n    Lines: (order.lines?.items || []).map(line => ({\n      Description: line.Description\n    }))\n  };\n}\n\nconst rawPODetails = $context.$nodes.FETCH_PURCHASE_ORDER_DETAILS.$output;\nconst cleanPODetails = sanitizeOrder(rawPODetails);\n\nreturn cleanPODetails;"
          },
          "diagram": {
