        {
          "metadata": {
            "name": "Extract Order Status and POHeaderId",
            "returnType": "object",
            "sourceCode": "const ret = { POHeaderId: \"\", DeepLinkType: \"\" };\n\nconst orderStatusCode = $context.$variables.OrderStatusCode;\nif ([\"INCOMPLETE\", \"WITHDRAWN\", \"REJECTED\"].includes(orderStatusCode)) {\n  ret.DeepLinkType = \"edit\";\n} else {\n  ret.DeepLinkType = \"view\";\n}\n\nconst poData = $context.$nodes.DECIPHER_INTENT_OF_USER_MESSAGE.$output.Intent === \"recent\" ? $context.$nodes.FETCH_MOST_RECENT_PO_BY_BUYER_NAME.$output?.items?.[0] : $context.$nodes.FETCH_PO_BY_ORDERNUMBER.$output?.items?.[0];\nconst poHeaderId = poData?.POHeaderId;\nif (poHeaderId) {\n  ret.POHeaderId = poHeaderId;\n}\n\nreturn ret;"
          },
          "outcomes": {
            "success": "1780016020506"
          },
          "code": "EXTRACT_ORDER_STATUS_AND_POHEADERID",
          "id": "1779992469006",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
