          },
          "code": "LOOP_SUMMARY_RESULTS",
          "id": "1770674086551",
          "inputs": [
            {
              "id": "1770674086553_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_CRITICAL_BO_LLM.$output.compareSummaryItems}}"
            }
          ],
