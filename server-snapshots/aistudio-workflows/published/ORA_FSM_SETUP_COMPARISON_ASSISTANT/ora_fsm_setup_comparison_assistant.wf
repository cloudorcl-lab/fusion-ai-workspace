        },
        {
          "metadata": {
            "name": "Compared Results"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "COMPARED_RESULTS",
          "id": "1770674514397",
          "inputs": [
            {
              "id": "1770674514399_1",
              "name": "prompt",
              "type": "string",
              "value": "Retrieve data from the following sources:\n\n{{$context.$nodes.LOOP_SUMMARY_RESULTS.$output}}\n{{$context.$nodes.EXTRACT_CRITICAL_BO_LLM.$output}}\n\nUsing these inputs, construct the final output strictly according to the provided JSON schema.\n\nInstructions:\n\n1. Extract only the required fields defined in the JSON specification.\n2. Merge and map values from both inputs as needed to populate the output structure.\n3. Do not include any fields that are not defined in the JSON schema.\n4. Return only valid JSON as the final output. Do not include explanations or additional text."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"Comparison Summary Schema\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"compareSummaryItems\": {\n      \"type\": \"array\",\n      \"description\": \"Detailed comparison results per node\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"processId\": {\n            \"type\": \"string\"\n          },\n          \"NodePath\": {\n            \"type\": \"string\"\n          },\n          \"NodePathBoShortName\": {\n            \"type\": \"string\"\n          },\n          \"MismatchCount\": {\n            \"type\": \"integer\"\n          }\n        },\n        \"required\": [\n          \"processId\",\n          \"NodePath\",\n          \"NodePathBoShortName\",\n          \"MismatchCount\"\n        ]\n      }\n    },\n\n    \"criticalBusinessObjectsHeading\": {\n      \"type\": \"string\",\n      \"description\": \"Summary heading derived from total mismatch counts\"\n    },\n\n    \"compareSummary\": {\n      \"type\": \"string\",\n      \"description\": \"Overall comparison summary or explanation\"\n    },\n\n    \"boSummaryItems\": {\n      \"type\": \"array\",\n      \"description\": \"Business Object level comparison summary\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"BOValues\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"BOAttrName\": {\n                  \"type\": \"string\",\n                  \"description\": \"Business Object Attribute Name (e.g., Legal Entity)\"\n                },\n           \"processId\": {\n            \"type\": \"string\"\n          },\n          \"NodePath\": {\n            \"type\": \"string\"\n          },\n          \"NodePathBoShortName\": {\n            \"type\": \"string\"\n          },\n       \"BusinessObjectShortName\": { \n            \"type\": \"string\" \n        },\n                \"BOAttrValues\": {\n                  \"type\": \"array\",\n                  \"items\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                      \"colName\": {\n                        \"type\": \"string\",\n                        \"description\": \"Column or attribute name\"\n                      },\n                      \"summary\": {\n                        \"type\": \"string\",\n                        \"description\": \"Type of change detected\"\n                      },\n                      \"count\": {\n                        \"type\": \"integer\",\n                        \"description\": \"Number of occurrences\"\n                      }\n                    },\n                    \"required\": [\n                      \"colName\",\n                      \"summary\",\n                      \"count\"\n                    ]\n                  }\n                }\n              },\n              \"required\": [\n                \"BOAttrName\",\n                \"BOAttrValues\"\n              ]\n            }\n          }\n        },\n        \"required\": [\n          \"BOValues\"\n        ]\n      }\n    }\n  },\n\n  \"required\": [\n    \"compareSummaryItems\",\n    \"criticalBusinessObjectsHeading\",\n    \"compareSummary\",\n    \"boSummaryItems\"\n  ]\n}",
          "type": "LLM"
        }
