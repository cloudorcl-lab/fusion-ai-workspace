          "id": "1764163557690",
          "inputs": [
            {
              "id": "1764163557692_1",
              "name": "prompt",
              "type": "string",
              "value": "- Classify user input  {{$context.$system.$inputMessage}}  into one intent: summary  or orders allocated.\n - Use natural language processing to ensure precise intent classification:\n-summary: Classify the intent as following if the user's query is related to information / summary about a wave ( e.g., \"Give me summary of wave Wave123\", \"Information about wave Wave123\".\n-orders_allocated: Classify the intent as following if the user's query is related to finding if an order has been allocated by a wave\n-inventory: Classify the intent as following if the user's query is related to finding if:\n  a. an LPN was allocated by a wave\n  b. any inventory was allocated in an area by a wave\n-task: Classify the intent as following if the user's query is related to task like \"task created by wave pWaveNumber\"\n-cubing: Classify the intent as following if the user's query is related to cube / cubing or OBLPNs created\n-other: Classify the intent as following if you are unable to classify input to any of the above option"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"Intent\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
