            "sourceCode": "var allProfileItemObj = {};\nvar nodes = ($context && $context.$nodes) || {};\nvar variables = ($context && $context.$variables) || {};\n\nfunction arrayResult(nodeCode) {\n  var node = nodes[nodeCode] || {};\n  var output = node.$output || {};\n  var result = output.result;\n  if (Array.isArray(result)) {\n    return result;\n  }\n  if (result === undefined || result === null) {\n    return [];\n  }\n  return [result];\n}\n\nallProfileItemObj.Skills = arrayResult(\"EXTRACT_RELEVANT_SKILL_FIELDS\");\nallProfileItemObj.Education = arrayResult(\"EXTRACT_RELEVANT_EDUCATION_FIELDS\");\nallProfileItemObj.Certification = arrayResult(\"EXTRACT_RELEVANT_CERTIFICATION_FIELDS\");\nallProfileItemObj.Languages = arrayResult(\"EXTRACT_RELEVANT_LANGUAGE_FIELDS\");\nallProfileItemObj.WorkHistory = arrayResult(\"EXTRACT_RELEVANT_WORKHISTORY_FIELDS\");\nallProfileItemObj.PersonId = variables.PersonId || \"\";\n\nreturn allProfileItemObj;\n"
          },
          "outcomes": {
            "success": "1764914673527"
          },
