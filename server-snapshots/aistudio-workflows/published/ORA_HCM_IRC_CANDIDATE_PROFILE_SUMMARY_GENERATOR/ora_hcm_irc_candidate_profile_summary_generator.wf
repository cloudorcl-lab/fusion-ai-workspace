            "name": "Extract Relevant Skill Fields",
            "returnType": "array",
            "sourceCode": "const publicSkills = $context.$nodes.GET_PUBLIC_SKILLS.$output.items || [] ;\nconst otherSkills = $context.$nodes.GET_SKILLS.$output.items || [] ;\n\nconst allSkillsArr= [\n...otherSkills.map(item => ({\nSkillId: item.SkillId,\nSkill: item.Skill,\nYearsOfExperience: item.YearsOfExperience,\nProjectOrActivity: item.ProjectOrActivity,\nDescription: item.Description,\nType: \"skillItems\"\n})),\n...publicSkills.map(item => ({\nSkillId: item.SkillId,\nSkill: item.Skill,\nSkillName: item.SkillName,\nProficiencyLevelCode: item.ProficiencyLevelCode,\nProjectName: item.ProjectName,\nYearsOfExperience: item.YearsOfExperience,\nDescription: item.Description,\nRatingModelId: item.RatingModelId,\nType: \"publicSkill\"\n}))\n] ;\n\nreturn allSkillsArr ;"
          },
