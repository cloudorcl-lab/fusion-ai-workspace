            "name": "Extract Only Skills",
            "returnType": "array",
            "sourceCode": "const publicSkills = $context.$nodes.GET_PUBLIC_SKILLS_1.$output.items || [] ;\nconst otherSkills = $context.$nodes.GET_SKILLS_1.$output.items || [] ;\n\nconst allSkillsArr= [\n...otherSkills.map(item => ({\nSkillId: item.SkillId,\nSkill: item.Skill,\nYearsOfExperience: item.YearsOfExperience,\nProjectOrActivity: item.ProjectOrActivity,\nDescription: item.Description\n})),\n...publicSkills.map(item => ({\nSkillId: item.SkillId,\nSkill: item.Skill,\nSkillName: item.SkillName,\nProjectName: item.ProjectName,\nYearsOfExperience: item.YearsOfExperience,\nDescription: item.Description,\nProficiencyLevel: item.NumericRating,\nMaxProficiencyLevel: 5\n}))\n] ;\n\nreturn allSkillsArr ;"
          },
