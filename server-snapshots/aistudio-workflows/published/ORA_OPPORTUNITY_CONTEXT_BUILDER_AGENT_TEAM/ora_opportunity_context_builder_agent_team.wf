                  "code": "RETURN_NOTES",
                  "type": "CODE",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "metadata": {
                    "name": "Consolidate Engagement Insights",
                    "returnType": "object",
                    "sourceCode": "var output = {};\noutput.engagements= $context.$nodes.FOR_EACH_INTENT.ENGAGEMENT_NOT_PROCESSED.$output?.items;\nlet summaryAIOutcome = $context.$nodes.FOR_EACH_INTENT.CURRENT_SUMMARY_FROM_AI_OUTCOME.$output\nlet summaryInsights = $context.$nodes.FOR_EACH_INTENT.CURRENT_SUMMARY_FROM_INSIGHTS.$output ;\n    \n\nlet payload = summaryAIOutcome?.items[0]?.payload ?? {};\nlet parsedPayload;\ntry {\n  parsedPayload = JSON.parse(payload);\n} catch (e) {\n  parsedPayload = {};\n}\nlet summary = parsedPayload?.what?.summary??\"\";\nsummary = summary?summary:summaryInsights??\"\";\noutput.insight_data = summary\nreturn output;"
                  },
                  "diagram": {
                    "x": 8442.5,
                    "y": 7499
                  },
