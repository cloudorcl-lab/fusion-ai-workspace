                    "sourceCode": "let accountSummary = $context.$nodes.FOR_EACH_INTENT.GET_ACCOUNT_SUMMARY.$output;\nlet accountData=$context.$nodes.FOR_EACH_INTENT.GET_ACCOUNT_DATA.$output??{};\nlet parsedJSON;\ntry{\nparsedJSON = JSON.parse(accountSummary);\n}\ncatch(e){\nparsedJSON = accountSummary;\n}\n\nlet paylaod = parsedJSON?.items[0]?.payload ?? {}\nlet summary = paylaod?.what?.summary??\"\";\nlet returnObj = {summary:summary,data:accountData}\nreturn returnObj;",
