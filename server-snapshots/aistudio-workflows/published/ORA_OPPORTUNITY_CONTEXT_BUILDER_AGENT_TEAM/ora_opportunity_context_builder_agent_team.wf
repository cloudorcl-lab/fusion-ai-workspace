                    "name": "generate Activity Payload",
                    "returnType": "object",
                    "sourceCode": "let payload = {\n  \"limit\": 1,\n  \"offset\": 0,\n  \"sort\": [\n    {\n        \"attribute\": \"DueDate\",\n        \"direction\": \"ascending\"\n    }\n],\n  \"entity\": \"Activity\",\n  \"q\": {\n    \"op\": \"$and\",\n    \"criteria\": [\n      {\n        \"op\": \"$eq\",\n        \"attribute\": 'OpportunityId.OptyNumber',\n        \"value\": $context.$triggers.REST.$input.puid\n      }\n    ]\n  },\n  \"fields\": [\"ActivityId\",\"ActivityNumber\",\"Subject\",\"ActivityDescription\",\"ActivityTypeCode\",\"ActivityTypeCode_localizedValue\",\"ActivityFunctionCode\",\"ActivityFunctionCode_localizedValue\",\"StatusCode\",\"StatusCode_localizedValue\",\"AppointmentStatus\",\"AppointmentStatus_localizedValue\",\"ActivityStartDate\",\"ActivityEndDate\",\"PriorityCode\",\"PriorityCode_localizedValue\",\"DueDate\",\"CreationDate\",\"LastUpdateDate\",\"LastUpdatedBy\",\"CreatedBy\",\"CallReportCount\",\"RecurRecType\",\"RecurRecType_localizedValue\",\"PrivateFlag\",\"Owner.PartyId\",\"Owner.ResourceProfileId\",\"Owner.PartyName\",\"Owner.ResourceEmailAddress\",\"ListOfResourcesForTheTeam.ActivityAssigneeId\",\"ListOfResourcesForTheTeam.ResponseCode\",\"ListOfResourcesForTheTeam.ResponseCode_localizedValue\",\"ListOfResourcesForTheTeam.DismissFlag\",\"CustomerAccount.PartyId\",\"CustomerAccount.PartyName\",\"CustomerAccount.PartyNumber\",\"ListOfContacts.ActivityContactId\",\"ListOfContacts.ContactId.PartyId\",\"ListOfContacts.ContactId.PartyName\",\"ListOfContacts.ContactId.DoNotContactFlag\",\"ListOfContacts.ContactId.DoNotEmailFlag\",\"ListOfContacts.ContactId.DoNotMailFlag\",\"ListOfContacts.ContactId.DoNotCallFlag\",\"ListOfContacts.ContactId.PrimaryEmail.EmailAddress\",\"ListOfContacts.ContactId.PrimaryPhone.PhoneNumber\",\"LeadId.LeadId\",\"LeadId.Name\",\"OpportunityId.OptyId\",\"OpportunityId.Name\"]\n};\nreturn payload;"
                  },
