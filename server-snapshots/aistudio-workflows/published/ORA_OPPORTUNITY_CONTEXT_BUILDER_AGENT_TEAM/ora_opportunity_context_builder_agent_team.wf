        {
          "metadata": {
            "description": "",
            "name": "Consolidate all output",
            "returnType": "array",
            "sourceCode": "const output = {};\nconst intentArray = $context.$triggers.REST.$input.intentArray || [];\nconst iterateIntentResponse = $context.$nodes.FOR_EACH_INTENT.$output ?? [];\n\nfor (let i = 0; i < intentArray.length; i++) {\n  const intent = intentArray[i];\n  let resp = iterateIntentResponse[i];\n\n  // optional: if resp is a JSON string, parse it\n  if (typeof resp === \"string\") {\n    try {\n      resp = JSON.parse(resp);\n    } catch (e) {\nresp = {};\n    }\n  }\n\n //extract only \"result\" if present\n  if (resp && typeof resp === \"object\" && \"result\" in resp) {\n    resp = resp.result;\n  }\n\n  output.OPPORTUNITY = $context.$nodes.GET_OPPORTUNITY_DATA.$output;\n  output[intent] = resp;\n\n  // list of properties to remove\n  var propsToRemove = [\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\",\n    \"@context\",\n    \"$context\"\n  ];\n\n  // recursive cleanup\n  var stack = [output];\n  while (stack.length > 0) {\n    var current = stack.pop();\n    if (current && typeof current === \"object\") {\n      for (var key in current) {\n        if (propsToRemove.indexOf(key) !== -1) {\n          delete current[key];\n        } else if (typeof current[key] === \"object\") {\n          stack.push(current[key]);\n        }\n      }\n    }\n  }\n}\n\nreturn output;"
          },
          "outcomes": {
            "success": "end"
          },
          "diagram": {
