                {
                  "metadata": {
                    "name": "build Payload for Accounts",
                    "returnType": "object",
                    "sourceCode": "let payload = {\n    \"limit\": 1,\n    \"offset\": 0,\n    \"sort\": [],\n    \"entity\": \"Account\",\n    \"q\": {\n        \"op\": \"$and\",\n        \"criteria\": [\n            {\n                \"op\": \"$eq\",\n                \"attribute\": \"PartyNumber\",\n                \"value\": $context.$nodes.GET_OPPORTUNITY_DATA.$output[0]?.CustomerAccount?.PartyNumber\n            }\n        ]\n    },\n    \"fields\": [\"PartyId\",\"PartyNumber\",\"PartyName\",\"PartyUniqueName\",\"OrganizationName\",\"OrganizationProfileId\",\"SalesProfileType\",\"SalesProfileType_localizedValue\",\"PromotedFlag\",\"PromotedAccount\",\"CurrencyCode\",\"CurrencyCode_localizedValue\",\"CreatedBy\",\"LastUpdatedBy\",\"CreationDate\",\"LastUpdateDate\",\"LastUpdateSourceSystem\",\"ObjectVersionNumber\",\"Description\",\"Keywords\",\"AccountScore\",\"AccountScoringTier\",\"PrimaryIndustry\",\"PrimaryURL\",\"PrimaryContact\",\"PrimaryEmail\",\"PrimaryPhone\",\"PrimaryAddress.FormattedAddress\",\"PrimaryAddress.CountryCode\",\"PrimaryAddress.CountryCode_localizedValue\",\"PrimaryAddress.State\",\"PrimaryAddress.Province\",\"PrimaryAddress.City\",\"PrimaryAddress.PostalCode\",\"PrimaryAddress.PartySiteId\",\"PrimaryAddress.PartySiteNumber\",\"PrimaryAddress.OverallPrimary\",\"ListOfAddresses.FormattedAddress\",\"ListOfAddresses.CountryCode\",\"ListOfAddresses.CountryCode_localizedValue\",\"ListOfAddresses.State\",\"ListOfAddresses.Province\",\"ListOfAddresses.City\",\"ListOfAddresses.PostalCode\",\"ListOfAddresses.PartySiteId\",\"ListOfAddresses.PartySiteNumber\",\"ListOfAddresses.OverallPrimary\",\"ListOfPartyUsageAssignments.PartyUsageCode\",\"ListOfPartyUsageAssignments.PartyUsageCode_localizedValue\",\"ListOfPartyUsageAssignments.PartyUsageAssignmentId\",\"ListOfPartyUsageAssignments.PartyId\",\"ListOfPartyUsageAssignments.ObjectVersionNumber\",\"ListOfPhones.PhoneType\",\"ListOfPhones.PhoneType_localizedValue\",\"ListOfPhones.ContactPointId\",\"ListOfPhones.DoNotCall\",\"ListOfPhones.PrimaryPerPhoneType\",\"ListOfPhones.OverallPrimary\",\"ListOfOrigSystemReference.OrigSystem\",\"ListOfOrigSystemReference.OrigSystem_localizedValue\",\"ListOfOrigSystemReference.OrigSystemReference\",\"ListOfOrigSystemReference.OrigSystemRefId\",\"ListOfOrigSystemReference.OwnerTableName\",\"ListOfOrigSystemReference.OwnerTableId\",\"ListOfOrigSystemReference.CreationDate\",\"ListOfOrigSystemReference.ObjectVersionNumber\",\"ListOfContacts\",\"ListOfOrganizationTypes\",\"ListOfResourcesForTheTeam\",\"ListOfResourceIdsForTheTeam\",\"ListOfResourceIdsInTheManagementChainOfTheOwner\",\"ListOfResourceIdsInTheManagementChainOfAResourceForTheTeam\",\"ListOfTerritories\",\"ListOfTerritoryIds\",\"ListOfTerritoryIdsThatAreAncestorsOfAnAssociatedTerritory\",\"ListOfURLs\",\"ListOfEmails\",\"ListOfIMs\",\"AccountHierarchySummary\",\"DataCloudStatus\",\"HasPartnerPartyUsage\",\"PartyRecordSet\",\"PartyRecordSet_localizedValue\",\"PrimaryIM\",\"PrimaryOrganizationType\",\"PrimaryIndustry\",\"PrimaryContact\",\"PrimaryPhone\",\"PrimaryEmail\",\"Owner\",\"OwnerPartyId\",\"OrganizationDEOObjectVersionNumber\"]\n};\n\nreturn payload;"
                  },
