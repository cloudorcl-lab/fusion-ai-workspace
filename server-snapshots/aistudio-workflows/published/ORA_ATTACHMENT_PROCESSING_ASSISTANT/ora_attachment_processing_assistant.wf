          "metadata": {
            "name": "Derive Resource Object",
            "returnType": "object",
            "sourceCode": "var objectType = $context.$triggers.REST.$input.objectType;\n\nconst resourceMapping = {\n  ServiceRequest: {\n    parentResource: 'serviceRequests',\n    attachmentResource: 'Attachment'\n  },\n  HRHelpDeskRequest: {\n    parentResource: 'hrHelpDeskRequests',\n    attachmentResource: 'Attachment'\n  },\n  InternalServiceRequest: {\n    parentResource: 'internalServiceRequests',\n    attachmentResource: 'Attachment'\n  },\n  Case: {\n    parentResource: 'cases',\n    attachmentResource: 'Attachments'\n  },\n  InboundMessage: {\n    parentResource: 'inboundMessages',\n    attachmentResource: 'Attachments'\n  },\n  SvcChat: {\n    parentResource: 'svcChats',\n    attachmentResource: 'Attachment'\n  },\n  SvcConsumerChat: {\n    parentResource: 'svcConsumerChats',\n    attachmentResource: 'Attachment'\n  },\n  CustomerWorkOrder: {\n    parentResource: 'customerWorkOrders',\n    attachmentResource: 'Attachment'\n  }\n};\n\n// Return the found mapping or an empty object if not found\nconst resourceObject = resourceMapping[objectType] || {};\nreturn resourceObject;"
          },
          "outcomes": {
            "success": "1760420785053"
          },
          "code": "DERIVE_RESOURCE_OBJECT",
          "id": "1760100770278",
