        {
          "metadata": {
            "name": "Validate Object Attributes",
            "returnType": "object",
            "sourceCode": "var objectType = $context.$triggers.REST.$input.objectType;\nvar objectNumber = $context.$triggers.REST.$input.objectNumber; \nvar trackerIds = $context.$triggers.REST.$input.documentTrackerIds;\nvar contextKeys = $context.$triggers.REST.$input.attachmentContextKeys;\n\nconst validTypes = [\n  'ServiceRequest', 'HRHelpDeskRequest', 'InternalServiceRequest',\n  'Case', 'InboundMessage', 'SvcChat', 'SvcConsumerChat', 'CustomerWorkOrder'\n];\n\nconst objectAttributes = {\n  isValidObjectType: validTypes.includes(objectType),\n \n  isValidObjectNumber: (objectNumber != null && \n                                            typeof objectNumber === 'string' && \n                                            objectNumber.trim() !== '' && \n                                            objectNumber.trim().toLowerCase() !== 'null'  && \n                                            objectNumber.trim().toLowerCase() !== '<provide a value>'\n                                            ),\n\n  isValidDocumentTrackerIdsArray:  (Array.isArray(trackerIds) && \n                                                                   trackerIds.length > 0 && \n                                                                   trackerIds.every(item => typeof item === 'string')\n                                                                 ),\n\n  isValidAttachmentKeysArray:  (Array.isArray(contextKeys) && \n                                                          contextKeys.length > 0 && \n                                                          contextKeys.every(item => typeof item === 'string')\n                                                          )\n};\n\nreturn objectAttributes;"
          },
          "outcomes": {
            "success": "1759930913665"
          },
          "code": "VALIDATE_OBJECT_ATTRIBUTES",
          "convergenceTargetId": "1759930913665",
          "id": "1762952576471",
