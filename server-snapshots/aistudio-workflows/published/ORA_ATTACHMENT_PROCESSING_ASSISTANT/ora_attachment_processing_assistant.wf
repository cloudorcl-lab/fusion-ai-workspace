        {
          "metadata": {
            "name": "Get ContextKeys",
            "returnType": "array",
            "sourceCode": "const items = $context.$nodes.GET_ALL_ATTACHMENTS.$output.items || [];\nconst supportedExtensions = new Set([\n  'txt', 'log', 'out', 'pdf', 'har', 'json', 'csv', 'yaml', 'xml', 'png', 'jpg', 'jpeg', 'docx', 'doc', 'xlsx', 'xls'\n]);\nconst MAX_FILE_SIZE = BigInt(5 * 1024 * 1024); // 5MB\nconst contextKeys = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const filename = item?.FileName || '';\n\n  // Check if filename contains an extension\n  const lastDot = filename.lastIndexOf('.');\n  if (lastDot === -1) continue;\n\n  // Extract and verify file extension\n  const extension = filename.slice(lastDot + 1).toLowerCase();\n  if (!supportedExtensions.has(extension)) continue;\n\n  // Check for context key\n  const attachmentContextKey = item?.['@context']?.key;\n  if (typeof attachmentContextKey === 'undefined') continue;\n\n  // Verify file size is within limit\n  const fileSize = BigInt(item?.UploadedFileLength ?? 0);\n  if (fileSize > MAX_FILE_SIZE) continue;\n\n  // All validations passed; collect the context key\n  contextKeys.push(String(attachmentContextKey));\n}\n\nreturn contextKeys;"
          },
          "outcomes": {
            "success": "1761821506290"
          },
          "code": "GET_CONTEXTKEYS",
          "id": "1761821450275",
          "inputs": [],
          "outputSpecification": "{\n \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n \"type\": \"object\",\n \"properties\": {\n \"result\": {\n \"type\": \"object\"\n },\n \"timeout\": {\n \"type\": \"boolean\"\n },\n \"error\": {\n \"type\": \"string\"\n }\n },\n \"required\": [\n \"output\",\n \"timeout\",\n \"error\"\n ]\n}",
          "type": "CODE"
        },
