{
  "workflowId": "300000327004244",
  "workflowCode": "ORA_MAINTENANCE_RESOURCE_ASSIGNMENT_ADVISOR",
  "name": "Maintenance Resource Assignment Advisor",
  "description": "Evaluates resource assignments for maintenance work orders. Matches requirements with available resources, identifies unassigned or partially assigned requirements, and provides assignment recommendations and status details for supervisors and planners.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
