        {
          "metadata": {
            "name": "Init Action",
            "returnType": "object",
            "sourceCode": "const rawInput =\n  $context?.$app?.$OraAction ??\n  $context?.$triggers?.REST?.$input?.OraAction ??\n  null;\n\nlet ActionCode = null,\n    WorkOrderId = null,\n    WorkOperationId = null,\n    WoOperationResourceId = null,\n    OrganizationId = null,\n    ResourceId = null,\n    LaborInstanceId = null;\n\nif (rawInput != null) {\n  try {\n    const parsed =\n      typeof rawInput === 'object' ? rawInput : JSON.parse(String(rawInput));\n\n    ActionCode = parsed?.ActionCode ?? null;\n    WorkOrderId = parsed?.WorkOrderId ?? null;\n    WorkOperationId = parsed?.WorkOperationId ?? null;\n    WoOperationResourceId = parsed?.WoOperationResourceId ?? null;\n    OrganizationId = parsed?.OrganizationId ?? null;\n    ResourceId = parsed?.ResourceId ?? null;\n    LaborInstanceId = parsed?.LaborInstanceId ?? null;\n\n  } catch {\n    // Fallback: comma-separated values\n    const parts = String(rawInput).split(',').map(s => s.trim());\n    [ActionCode, WorkOrderId, WorkOperationId, WoOperationResourceId, OrganizationId, ResourceId, LaborInstanceId] =\n      [parts[0] ?? null, parts[1] ?? null, parts[2] ?? null, parts[3] ?? null, parts[4] ?? null, parts[5] ?? null, parts[6] ?? null];\n  }\n}\n\nconst retValue = {\n  ActionCode,\n  WorkOrderId,\n  WorkOperationId,\n  WoOperationResourceId,\n  OrganizationId,\n  ResourceId,\n  LaborInstanceId\n};\n\nreturn retValue;"
          },
          "outcomes": {
            "success": "1768137606384"
          },
