        {
          "metadata": {
            "name": "Initialize Work Order From Context",
            "returnType": "array",
            "sourceCode": "const appContext =\n  $context?.$app?.$OraAppContext ??\n  $context?.$triggers?.REST?.$input?.OraAppContext ??\n  null;\n\nlet OrganizationId = null;\nlet OrganizationCode = null;\nlet WorkOrderNumber = null;\nlet CsvListOfWorkOrder = null;\nlet Limit = 100;\n\n\nconst today = $context.$system.$currentDate ;\n// StartDate = today - 30 days\nconst startDateObj = new Date(today);\nstartDateObj.setDate(startDateObj.getDate() - 30);\n\n// EndDate = today + 7 days\nconst endDateObj = new Date(today);\nendDateObj.setDate(endDateObj.getDate() + 7);\n\nconst StartDate = startDateObj.toISOString().split('T')[0];\nconst EndDate = endDateObj.toISOString().split('T')[0];\n\n\nif (appContext != null) {\n  if (typeof appContext === 'object') {\n    OrganizationId = appContext?.OrganizationId ?? null;\n    OrganizationCode = appContext?.OrganizationCode ?? null;\n    WorkOrderNumber = appContext?.WorkOrderNumber ?? null;\n  } else if (typeof appContext === 'number') {\n    OrganizationId = String(appContext);\n  } else if (typeof appContext === 'string') {\n    const s = appContext.trim();\n    if (s) {\n      if (s.startsWith('{') || s.startsWith('[')) {\n        // JSON string\n        try {\n          const obj = JSON.parse(s);\n          OrganizationId = obj?.OrganizationId ?? null;\n          OrganizationCode = obj?.OrganizationCode ?? null;\n          WorkOrderNumber = obj?.WorkOrderNumber ?? null;\n        } catch {\n          // Malformed JSON -> fall through to plain handling\n          const parts = s.split(',').map(p => p.trim());\n          OrganizationId = parts[0] || s || null;\n          OrganizationCode = parts[1] || null;\n          WorkOrderNumber = parts[2] || null;\n        }\n      } else if (s.includes(',')) {\n        const parts = s.split(',').map(p => p.trim());\n        OrganizationId = parts[0] || null;\n          OrganizationCode = parts[1] || null;\n          WorkOrderNumber = parts[2] || null;\n      } else {\n        // Plain single value -> treat as OrganizationId\n        OrganizationId = s;\n      }\n    }\n  } else {\n    const s = String(appContext).trim();\n    if (s) OrganizationId = s;\n  }\n}\n\nif(WorkOrderNumber != null){\n  CsvListOfWorkOrder =`'${WorkOrderNumber}'`;\n}\n\n\nreturn { OrganizationId, OrganizationCode, WorkOrderNumber, CsvListOfWorkOrder, Limit, StartDate, EndDate };"
          },
          "outcomes": {
            "success": "1769680797723"
          },
          "code": "INITIALIZE_WORK_ORDER_FROM_CONTEXT",
          "id": "1768113375546",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
