                      "type": "string",
                      "value": "{{$context.$nodes.FOR_EACH_RESOURCE_REQUIREMENT.$currentItem.OrganizationId}}"
                    }
                  ],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"LaborInstanceCode\": { \"type\": \"string\" },\n      \"LaborInstanceId\": { \"type\": \"number\" },\n      \"LaborInstanceName\": { \"type\": \"string\" },\n      \"OrganizationId\": { \"type\": \"number\" },\n      \"PartyId\": { \"type\": \"number\" },\n      \"ResourceId\": { \"type\": \"number\" },\n      \"PersonName\": { \"type\": \"string\" },\n      \"CurrentlyAssignedFlag\": { \"type\": \"boolean\" },\n      \"AssignedToWorkOrderFlag\": { \"type\": \"boolean\" },\n      \"QualifiedFlag\": { \"type\": \"boolean\" },\n      \"AssignedStartDateTime\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n      \"AssignedEndDateTime\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n      \"NextAssignedStartDateTime\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n      \"AvailableForAssignmentFlag\": { \"type\": \"boolean\" },\n      \"PersonId\": { \"type\": \"string\" }\n    }\n  }\n}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "Return Requirement with Available Instances",
                    "returnType": "object",
                    "sourceCode": "const availableResourceInstances = $context.$nodes.FOR_EACH_RESOURCE_REQUIREMENT.GET_RESOURCE_INSTANCE_FOR_REQUIREMENT.$output?.items;\n\n const list = Array.isArray(availableResourceInstances) ? availableResourceInstances : [];\n let AssignmentStatus = 'NO_RESOURCE_INSTANCE';\n let rec = {Status: 'NO_RESOURCE_INSTANCE'};\n\nif (list.length > 0) {\n  // 1) Assigned takes priority\n  const assigned = list.find(r => r?.AssignedToWorkOrderFlag === true);\n  if (assigned) {\n    AssignmentStatus = 'ASSIGNED';\n    rec =  {\n      LaborInstanceCode: assigned.LaborInstanceCode ?? null,\n      LaborInstanceId: assigned.LaborInstanceId ?? null,\n      LaborInstanceName: assigned.LaborInstanceName ?? null,\n      PersonName: assigned.PersonName ?? null,\n      AssignedToWorkOrderFlag: assigned.AssignedToWorkOrderFlag,\n      QualifiedFlag: assigned.QualifiedFlag,\n      AvailableForAssignmentFlag: assigned.AvailableForAssignmentFlag,\n      Status: 'ASSIGNED',\n    };\n  }\n else{\n  const best = list.find(r => r?.QualifiedFlag === true && r?.AvailableForAssignmentFlag === true)\n            ?? list.find(r => r?.QualifiedFlag === true)\n            ?? list[0];\n  AssignmentStatus = 'UNASSIGNED';\n  rec =  {\n    LaborInstanceCode: best.LaborInstanceCode ?? null,\n    LaborInstanceId: best.LaborInstanceId ?? null,\n    LaborInstanceName: best.LaborInstanceName ?? null,\n    PersonName: best.PersonName ?? null,\n    AssignedToWorkOrderFlag: best.AssignedToWorkOrderFlag,\n    QualifiedFlag: best.QualifiedFlag,\n    AvailableForAssignmentFlag: best.AvailableForAssignmentFlag,\n    Status: 'UNASSIGNED',\n  };\n }\n}\n$context.$variables.WorkOrderOperResourceData[ $context.$nodes.FOR_EACH_RESOURCE_REQUIREMENT.$currentItemIndex ].AssignmentStatus = AssignmentStatus;\n$context.$variables.WorkOrderOperResourceData[ $context.$nodes.FOR_EACH_RESOURCE_REQUIREMENT.$currentItemIndex ].AvailableResourceInstances = rec;\n\nreturn $context.$variables.WorkOrderOperResourceData[ $context.$nodes.FOR_EACH_RESOURCE_REQUIREMENT.$currentItemIndex ];"
                  },
                  "outcomes": {
                    "success": "end_1768127095955"
                  },
                  "code": "RETURN_REQUIREMENT_WITH_AVAILABLE_INSTANCES",
                  "id": "1768128221041",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                }
