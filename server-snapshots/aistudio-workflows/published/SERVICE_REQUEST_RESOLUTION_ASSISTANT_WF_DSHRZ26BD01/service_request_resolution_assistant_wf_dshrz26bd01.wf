          },
          "outcomes": {
            "success": "end"
          },
          "code": "RETURNLLMRESPONSE",
          "id": "1764330099294",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "SetAgentMessageStructure",
            "returnType": "string",
            "sourceCode": "const wo = $context.$nodes.PRESENTFINALANSWERWO?.$output;\nconst ap = $context.$nodes.PRESENTFINALANSWERAP?.$output;\nconst normal = $context.$nodes.PRESENTFINALANSWER?.$output;\n\n// Pick the first non-null output\nlet output = null;\n\nif (wo != null) {\n  output = wo;\n} else if (ap != null) {\n  output = ap;\n} else if (normal != null) {\n  output = normal;\n} else {\n  output = {}; // fallback\n}\n\nlet actionNumber;\n\nif (\n  output.ObjectType === \"ActionPlanTemplate\" &&\n  output.ObjectKey != null &&\n  output.ObjectKey !== \"NA\" &&\n  output.ObjectKey !== \"\"\n) {\n  actionNumber =\n    $context.$triggers.REST.$input.objectType === \"ServiceRequest\"\n      ? \"ORA_SVC_ACT_RECOMM_101\"\n      : $context.$triggers.REST.$input.objectType === \"HRHelpDeskRequest\"\n      ? \"ORA_SVC_ACT_RECOMM_102\"\n      : $context.$triggers.REST.$input.objectType === \"InternalServiceRequest\"\n      ? \"ORA_SVC_ACT_RECOMM_103\"\n      : null;\n} else if (output.ObjectType === \"ActionPlanTemplate\") {\n  actionNumber =\n    $context.$triggers.REST.$input.objectType === \"ServiceRequest\"\n      ? \"ORA_SVC_ACT_101\"\n      : $context.$triggers.REST.$input.objectType === \"HRHelpDeskRequest\"\n      ? \"ORA_SVC_ACT_102\"\n      : $context.$triggers.REST.$input.objectType === \"InternalServiceRequest\"\n      ? \"ORA_SVC_ACT_103\"\n      : null;\n}\n\n// Final output\nconst llmOutput = {\n  output,\n  workflowCode: $context.$workflow.$name,\n  jobId: $context.$workflow.$jobId,\n  conversationId: $context.$workflow.$conversationId,\n  actionNumber\n};\n\nreturn JSON.stringify(llmOutput, null, 2);"
          },
          "outcomes": {
            "success": "1765791720422"
          },
          "code": "SETAGENTMESSAGESTRUTURE",
          "convergenceTargetId": "1764267843229",
          "id": "1763407053009",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
