        {
          "metadata": {
            "name": "srDetails",
            "returnType": "string",
            "sourceCode": "if ($context.$triggers.REST.$input.objectNumber !== null) {\n\n  const srAttributesRaw = $context.$nodes.GETSRDATA.$output;\n\n  const srAttributes = (srAttributesRaw && srAttributesRaw.content)\n    ? srAttributesRaw.content\n    : (srAttributesRaw || {});\n\n  const messagesResponse = $context.$nodes.GET_ALL_MESSAGE.$output;\n\n  const result = {};\n\n  // Copy SR attributes except @context\n  for (const key in srAttributes) {\n    if (key !== \"@context\") {\n      result[key] = srAttributes[key];\n    }\n  }\n\n  const items = messagesResponse?.items || [];\n\n  // Flatten messages\n  const flattenedMessages = items.map(m => {\n    const sender = m?.MessageTypeCd\n      ? (m.MessageTypeCd.includes(\"CUSTOMER\") ? \"Customer\" :\n         m.MessageTypeCd.includes(\"RESPONSE\") ? \"Agent\" : \"System\")\n      : \"Unknown\";\n\n    const timestamp = m?.CreationDate || \"\";\n\n    const text = m?.MessageContent\n      ? m.MessageContent.replace(/<[^>]+>/g, \"\").trim()\n      : \"\";\n\n    return `${sender}${timestamp ? \" (\" + timestamp + \")\" : \"\"}: ${text}`;\n  });\n\n  result.Messages = flattenedMessages;\n  result.MessageCount = flattenedMessages.length;\n\n  return $context.$system.$inputMessage + \" \" + JSON.stringify(result, null, 2);\n\n} \n\n  return $context.$system.$inputMessage + \" \" + $context.$triggers.REST.$input.content  ;"
          },
          "outcomes": {
            "success": "1758762681736"
          },
          "code": "SRDETAILS",
          "convergenceTargetId": "1764248257812",
          "id": "1764064527800",
          "inputs": [],
