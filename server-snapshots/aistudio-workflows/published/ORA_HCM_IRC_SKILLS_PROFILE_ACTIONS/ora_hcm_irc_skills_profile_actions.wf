{
  "workflowId": "300000326918770",
  "workflowCode": "ORA_HCM_IRC_SKILLS_PROFILE_ACTIONS",
  "name": "Skills Profile Actions",
  "description": "Performs actions related to skills profile updates using logged-in user assignment information and talent profile items.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
