        {
          "metadata": {
            "name": "Check Mode"
          },
          "outcomes": {
            "true": "1767773590347",
            "false": "1767783386729"
          },
          "code": "CHECK_MODE",
          "convergenceTargetId": "end",
          "id": "1767160830149",
          "inputs": [
            {
              "id": "1767160830151_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.OraMessageHint == 'InitActions'}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "List Actions"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "LIST_ACTIONS",
          "id": "1767773590347",
          "inputs": [
            {
              "id": "1767773590349_1",
              "name": "prompt",
              "type": "string",
              "value": "You are the InitActions action generator for the Skills Profile widget in the Career Advancement Command Center.\n\nUser skills data:\n{{$context.$triggers.REST.$input.skillsForProfile}}\n\nGoal:\nReturn a compact JSON array of action candidate objects for skills that can be added to the user's profile.\n\nImportant behavior:\n- Current skills alone must not produce an action.\n- If there are any recommended additional skills, return one Add Skills action.\n- Recommended additional skills may come from gigs, learning activities, current role, aspirational roles, or any role-based recommendation.\n- Do not suppress role-based recommendations.\n- If there are no recommended additional skills, return [].\n\nSkill extraction rules:\n- Prefer arrays named newSkillRecommendations, gigCourseSkills, roleBasedSkills, additionalSkills, skillsToAdd, recommendedSkills, or similar.\n- If an item is an object, use Skill, skill, SkillName, name, title, or label as the skill name.\n- Exclude skills that are already present in currentSkills.\n- De-duplicate skill names case-insensitively.\n- Keep at most 15 skills in the payload.\n- Preserve user-facing skill capitalization from the input when available.\n\nOutput contract:\n- Return only a JSON array.\n- Do not return markdown, prose, XML, code fences, or a wrapper object.\n- Return at most 1 action.\n\nEach action object must contain exactly:\n- title\n- shortDescription\n- actionText\n- followUpCommand\n\nAction details:\n- title: \"Add Skills to Profile\"\n- shortDescription: one concise sentence explaining that the recommended skills can be added to improve opportunity matching.\n- actionText: \"Add Skills\"\n- followUpCommand must be exactly this format, with the skills array populated from the input:\n  ora.Invoke(\"ADDSKILLS\",{\"actionCode\":\"ADDSKILLS\",\"skills\":[\"<skill1>\",\"<skill2>\"]})\n\nDo not include priority.\nDo not invent skill names."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "errorNodeId": "1770065087566",
            "name": "Parse Action",
            "returnType": "array",
            "sourceCode": "const str = $context.$triggers.REST.$input.OraAction;\nconst payload = JSON.parse(str);\nconst action = payload. actionCode;\nconst out = [];\nout.push(action);\nout.push(payload);\nreturn out;"
          },
          "outcomes": {
            "success": "1767783595829"
          },
          "code": "PARSE_ACTION",
          "id": "1767783386729",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1770065087566",
            "name": "Set Action Parameters"
          },
          "outcomes": {
            "success": "1767783684493"
          },
          "code": "SET_ACTION_PARAMETERS",
          "id": "1767783595829",
          "inputs": [
