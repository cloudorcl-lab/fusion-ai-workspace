              "id": "1767783636012",
              "name": "payload",
              "scope": "JOB",
              "type": "object",
              "value": "{{$context.$nodes.PARSE_ACTION.$output.result[1]}}"
            },
            {
              "id": "1767783613236",
              "name": "actionCode",
              "scope": "JOB",
              "type": "string",
              "value": "{{$context.$nodes.PARSE_ACTION.$output.result[0]}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Switch Actions"
          },
          "outcomes": {
