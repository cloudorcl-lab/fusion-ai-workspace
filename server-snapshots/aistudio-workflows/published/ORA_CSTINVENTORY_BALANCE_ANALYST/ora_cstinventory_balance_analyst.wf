        {
          "metadata": {
            "name": "Extract App Context",
            "returnType": "object",
            "sourceCode": "const input = $context.$triggers.REST.$input.OraAppContext;    \n\nconst match = input.split(\":\").map(s => s.trim());\nlet retValue = {};\n\nif (match) {\n    // Extract the Cost Org Name, Cost Book Name and Period name\n    const costOrgName = match[0]; \n    const costBookName = match[1]; \n    const periodName = match[2]; \n    \n    // Return the extracted values\n    retValue = { costOrgName, costBookName, periodName };\n}\n\nreturn retValue;"
          },
          "outcomes": {
            "success": "1761087214169"
          },
          "code": "EXTRACT_APP_CONTEXT",
          "convergenceTargetId": "1770997578435",
          "id": "1761087002643",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
