            "businessObjectCode": "ORA_SCM_COSTMANAGE_GETINVENTORYVALUATION",
            "functionName": "getInventoryValuationForPeriodAndCostOrg",
            "name": "Get Inventory Valuation Summary"
          },
          "outcomes": {
            "success": "1770891656472"
          },
          "code": "GET_INVENTORY_VALUATION_SUMMARY",
