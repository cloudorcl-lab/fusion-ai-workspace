                  "code": "COMPUTE_SUMMARY_LLM",
                  "id": "1772526723879",
                  "inputs": [
                    {
                      "id": "1772526723881_1",
                      "name": "prompt",
                      "type": "string",
                      "value": "PERSONA :\n\nYou are a manager reviewing responses to the question {{$context.$variables.CurrentQuestion}} in the survey responded by employees in your organization.Your job is to analyze the responses and provide a summary. \n\n\nSUMMARIZATION RULES:\n\nTreat each Response as independent of the other and assume that it is response from a human.Make sure to capture the trends in the responses and what is the general consensus, while summarizing content. The final summary should be concise\n\n\nSTEPS TO FOLLOW :\n\nFor the current item {{$context.$nodes.COMPUTE_SUMMARY_BATCHES.$currentItem}} , The value for the key \"BatchContent\" will be a list. This list will contain responses given by each individual and is treated as independent from other items in the list. Gather all the items in the list and provide a summary based on the rules provided in ```SUMMARIZATION RULES```. Store the summarized content in \"Summary\".\n\nReturn the output as JSON in the following format :\n\n````\n{\n    \"BatchId\" : <Current BatchId that is being processed>,\n    \"Summary\" : <Final Summary of the responses>\n\n}\n````"
                    }
                  ],
                  "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"Summary\": {\n            \"type\": \"string\"\n        },\n        \"BatchId\": {\n            \"type\": \"number\"\n        }\n    }\n}",
                  "type": "LLM"
                },
                {
                  "metadata": {
                    "name": "End",
                    "description": "End of data pipeline"
                  },
                  "id": "end_1772525864844",
                  "code": "END_1772525864844",
                  "type": "END"
                }
              ]
            },
            "loopType": "PARALLEL",
            "name": "ComputeSummaryForBatches"
          },
          "outcomes": {
            "success": "1772528740722"
          },
          "code": "COMPUTE_SUMMARY_BATCHES",
          "id": "1772525864844",
          "inputs": [
            {
              "id": "1772525864845_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.GET_BATCHES_SUMMARIZATION.$output.result}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "getSentimentFinalOutput",
            "returnType": "object",
            "sourceCode": "var sentiments = $context.$nodes.COMPUTE_SENTIMENT_BATCHES.$output \nvar sentimentResponses = [];\nfor(let i=0;i<sentiments.length;i++){\n   var sentObj = sentiments[i];\n   sentObj = sentObj.replaceAll(\"\\n\",\"\");\n   sentObj = JSON.parse(sentObj);\n   sentimentResponses = [...sentimentResponses,...(sentObj.ProcessedContent)];\n}\nreturn {\"Sentiments\":sentimentResponses};"
          },
          "outcomes": {
            "success": "1772703710726"
          },
          "code": "GET_SENT_FIN_OUT",
          "id": "1772441992240",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "extractComputedSummaries",
            "returnType": "object",
            "sourceCode": "var req = $context.$nodes.COMPUTE_SUMMARY_BATCHES.$output \nvar list = [];\nfor(let i=0;i<req.length;i++){\n var str = req[i];\nstr.replaceAll(\"\\n\",\"\");\nvar obj = JSON.parse(str);\nlist.push(obj.Summary);\n}\nreturn {\"Summaries\" : list,\"ConsolidationRequired\" : list.length > 1 ? true : false};"
          },
          "outcomes": {
            "success": "1772621257222"
          },
          "code": "EXTRACT_COMPUTED_SUMMARIES",
          "id": "1772528740722",
          "inputs": [],
