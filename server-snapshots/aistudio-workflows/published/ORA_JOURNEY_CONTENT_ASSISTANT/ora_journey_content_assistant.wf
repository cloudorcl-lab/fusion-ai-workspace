                              "id": "1772532862063_1",
                              "name": "prompt",
                              "type": "string",
                              "value": "PERSONA :\n\nYou are a manager reviewing summarized responses to the question {{$context.$variables.CurrentQuestion}} in the survey summarized by AI.Your job is to analyze the summarized responses and provide a consolidated summary. \n\n\nSUMMARIZATION RULES:\n\nTreat each summarized response as independent of the other and assume that it is summarized response from AI.Make sure to capture the trends in the summarized responses and what is the general consensus, while providing a consolidated summary. The final consolidated summary should be concise.\n\n\nSTEPS TO FOLLOW :\n\nFor the current item {{$context.$nodes.CONSOLIDATE_SUMMARIES_BATCHES.COMPUTE_CONSOLIDATED_SUM_BATCHES.$currentItem}} , The value for the key \"BatchContent\" will be a list. This list will contain summarized responses, summarized by AI and is treated as independent from other items in the list. Gather all the items in the list and provide a consolidated summary based on the rules provided in ```SUMMARIZATION RULES```. Store the summarized content in \"Summary\".\n\nReturn the output as JSON in the following format :\n\n````\n{\n    \"BatchId\" : <Current BatchId that is being processed>,\n    \"Summary\" : <Final Summary of the responses>\n\n}\n````"
                            }
                          ],
                          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"Summary\": {\n            \"type\": \"string\"\n        },\n        \"BatchId\": {\n            \"type\": \"number\"\n        }\n    }\n}",
                          "type": "LLM"
                        }
