                {
                  "metadata": {
                    "name": "getBatchesForConsolidation",
                    "returnType": "array",
                    "sourceCode": "var answers = $context.$variables.currentSummaries; \nvar batches = [];\nvar batch = {};\nvar id = 1;\nbatch.BatchId = id;\nbatch.BatchContent = [];\nfor(let i=0;i<answers.length;i++){\nbatch.BatchContent.push(answers[i])\nif((i+1) % 100 == 0){\n batches.push(batch);\nid++;\nbatch = {\"BatchId\" : id,\"BatchContent\" : []};\n}\n}\nif(batch.BatchContent.length != 0)\n  batches.push(batch);\nreturn batches;"
                  },
                  "outcomes": {
                    "success": "1772619739627"
                  },
                  "code": "GET_BATCHES_CONSOLIDATION",
                  "convergenceTargetId": "1772619909307",
                  "id": "1772619088902",
                  "inputs": [],
