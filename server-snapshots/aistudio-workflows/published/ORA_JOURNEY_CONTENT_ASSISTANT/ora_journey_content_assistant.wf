        {
          "metadata": {
            "name": "getBatchesForSentimentAnalysis",
            "returnType": "array",
            "sourceCode": "var input = JSON.parse( $context.$triggers.REST.$input.inputText );\nvar answers = input.Responses;\n\nvar batches = [];\nvar batch = {};\nvar id = 1;\nbatch.BatchId = id;\nbatch.BatchContent = [];\nfor(let i=0;i<answers.length;i++){\nbatch.BatchContent.push(answers[i])\nif((i+1) % 100 == 0){\n batches.push(batch);\nid++;\nbatch = {\"BatchId\" : id,\"BatchContent\" : []};\n}\n}\nif(batch.BatchContent.length != 0)\n  batches.push(batch);\nreturn batches;"
          },
          "outcomes": {
            "success": "1772438708098"
          },
          "code": "GET_BATCHES_SENT_COMP",
          "id": "1772449102041",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "GetBatchesForSummarization",
            "returnType": "array",
            "sourceCode": "var input = JSON.parse( $context.$triggers.REST.$input.inputText );\nvar answers = input.Responses;\n\nvar batches = [];\nvar batch = {};\nvar id = 1;\nbatch.BatchId = id;\nbatch.BatchContent = [];\nfor(let i=0;i<answers.length;i++){\nbatch.BatchContent.push(answers[i])\nif((i+1) % 100 == 0){\n batches.push(batch);\nid++;\nbatch = {\"BatchId\" : id,\"BatchContent\" : []};\n}\n}\nif(batch.BatchContent.length != 0)\n  batches.push(batch);\nreturn batches;"
          },
          "outcomes": {
            "success": "1772525864844"
          },
          "code": "GET_BATCHES_SUMMARIZATION",
          "id": "1772527800748",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "dataPipeline": {
              "rootNode": "start_1772438708098",
              "pipelineNodes": [
                {
                  "metadata": {
                    "name": "Start",
                    "description": "Start of data pipeline"
                  },
                  "outcomes": {
                    "success": "1772438912176"
