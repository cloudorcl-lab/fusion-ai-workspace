        {
          "metadata": {
            "name": "Generate Update Rating Payload",
            "returnType": "array",
            "sourceCode": "var oraAction = $context.$app.$OraAction;\nvar finalResult = [];\n\ntry {\n// Extract just the content between the > and < characters\nvar start = oraAction.indexOf('>') + 1;\nvar end = oraAction.lastIndexOf('</');\nvar innerContent = oraAction.substring(start, end);\n} catch (e) {\n    finalResult.push('ERROR 0000 !!');\n}\n\ntry {\n// Remove backslashes before quotes and strip any extra outer quotes\nvar cleanJson = innerContent.replace(/\\\\\"/g, '\"').replace(/^\"|\"$/g, '');\n} catch (e) {\n    finalResult.push('ERROR 1111 !!');\n}\n\ntry {\n    // Parse the cleaned string\n    var data = JSON.parse(cleanJson);\n\n    for (var i = 0; i < data.length; i++) {\n        if (data[i].id === \"newrating\") {\n            finalResult[0] = data[i].value;\n        } else if (data[i].id === \"newcomments\") {\n            finalResult[1] = data[i].value;\n        } else if (data[i].id === \"ManagerRatingId\") {\n            finalResult[2] = data[i].value;\n        } else if (data[i].id === \"SectionRatingsReadOnlyFlag\") {\n            finalResult[3] = data[i].value;\n        } else if (data[i].id === \"SectionCommentsReadOnlyFlag\") {\n            finalResult[4] = data[i].value;\n        } \n    }\n} catch (e) {\n    finalResult.push('ERROR 222 !!');\n}\n\nlet payloadContent = {};\n\nif (!finalResult[3]) {\n   payloadContent.PerformanceRatingLevelId = finalResult[0];\n}\n\nif (!finalResult[4]) {\n     payloadContent.CommentText = finalResult[1];\n}\n\nlet updateRatingsBatchPayload = [\n        {\n            \"id\": \"Update-ItemRating-0\",\n            \"path\": \"/talentPerformanceEvaluations/service/child/evaluationRatings/\"+finalResult[2],\n            \"operation\": \"update\",\n            \"payload\": payloadContent\n        }\n];\n\nreturn updateRatingsBatchPayload;"
          },
          "outcomes": {
            "success": "1774835077103"
          },
          "code": "GENERATE_UPDATE_RATING_PAYLOAD",
          "id": "1774834995694",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
