          "code": "FILL_PARAMS",
          "id": "1767590061333",
          "inputs": [
            {
              "id": "1767590061334_1",
              "name": "prompt",
              "type": "string",
              "value": "Data:\n{{$context.$nodes.TEAM_RATINGS.$output}}\n\nFill the parameters in {{$context.$app.$OraCommParamsToFill}}"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Construct Editable Fields",
            "returnType": "array",
            "sourceCode": "var oraAction = $context.$app.$OraAction || \"\";\nvar isFormSubmitAction = oraAction.indexOf(\"oraFormSubmit\") !== -1;\nvar formFields = [];\nvar options = [];\nvar selectedPersonRecord = $context.$nodes.GET_SELECTED_PERSON_RECORD.$output.result || {};\n\nfunction listItems(container) {\n  return container && container.items && container.items.length ? container.items : [];\n}\n\nfunction firstNonEmpty() {\n  for (var i = 0; i < arguments.length; i++) {\n    var value = arguments[i];\n    if (value !== null && value !== undefined && String(value) !== \"\") {\n      return value;\n    }\n  }\n  return \"\";\n}\n\nfunction findOverallSection(document) {\n  var sections = listItems(document && document.sections);\n  for (var i = 0; i < sections.length; i++) {\n    var section = sections[i];\n    if (section && (section.SectionTypeCode === \"OS\" || section.SectionTypeName === \"Overall summary\")) {\n      return section;\n    }\n  }\n  return null;\n}\n\nfunction findManagerOverallRow(section) {\n  var rows = listItems(section && section.items);\n\n  for (var i = 0; i < rows.length; i++) {\n    var row = rows[i];\n    if (row && row.ItemType === \"SECTION\" && row.ManagerRatingId) {\n      return row;\n    }\n  }\n\n  for (var j = 0; j < rows.length; j++) {\n    var sectionRow = rows[j];\n    if (sectionRow && sectionRow.ItemType === \"SECTION\") {\n      return sectionRow;\n    }\n  }\n\n  for (var k = 0; k < rows.length; k++) {\n    var ratingRow = rows[k];\n    if (\n      ratingRow &&\n      (ratingRow.ManagerRatingId ||\n        ratingRow.PerformanceRatingLevelId ||\n        ratingRow.ManagerPerformanceRatingDescription ||\n        ratingRow.PerformanceRatingMeaning)\n    ) {\n      return ratingRow;\n    }\n  }\n\n  return null;\n}\n\nfunction findSelectedDocument(personRecord, evaluationId) {\n  var docs = listItems(personRecord && personRecord.performanceDocuments);\n  for (var i = 0; i < docs.length; i++) {\n    if (docs[i] && String(docs[i].EvaluationId) === String(evaluationId)) {\n      return docs[i];\n    }\n  }\n  return docs.length ? docs[0] : null;\n}\n\nfunction ratingTargets() {\n  if (selectedPersonRecord.RatingDistribution && selectedPersonRecord.RatingDistribution.length) {\n    return selectedPersonRecord.RatingDistribution;\n  }\n  return listItems(selectedPersonRecord.organizationTargets);\n}\n\nfunction findTargetByLevelId(items, levelId) {\n  for (var i = 0; i < items.length; i++) {\n    if (items[i] && String(items[i].RatingLevelId) === String(levelId)) {\n      return items[i];\n    }\n  }\n  return null;\n}\n\nfunction findTargetByDescription(items, description) {\n  var wanted = String(description || \"\").toLowerCase();\n  if (!wanted) return null;\n  for (var i = 0; i < items.length; i++) {\n    var item = items[i];\n    if (item && String(item.RatingDescription || \"\").toLowerCase() === wanted) {\n      return item;\n    }\n  }\n  return null;\n}\n\nfunction findTargetByNumericRating(items, numericRating) {\n  if (numericRating === null || numericRating === undefined || String(numericRating) === \"\") return null;\n  for (var i = 0; i < items.length; i++) {\n    var item = items[i];\n    if (item && String(item.NumericRating) === String(numericRating)) {\n      return item;\n    }\n  }\n  return null;\n}\n\nvar items = ratingTargets();\nvar personRecord = selectedPersonRecord.PersonRecord || {};\nvar document = findSelectedDocument(personRecord, selectedPersonRecord.EvaluationId);\nvar overallSection = findOverallSection(document);\nvar managerRow = findManagerOverallRow(overallSection) || {};\n\nfor (var i = 0; i < items.length; i++) {\n  if (!items[i]) continue;\n  options.push({\n    value: String(items[i].RatingLevelId),\n    label: items[i].RatingDescription\n  });\n}\n\nvar currentTarget =\n  findTargetByLevelId(items, managerRow.PerformanceRatingLevelId) ||\n  findTargetByDescription(\n    items,\n    firstNonEmpty(managerRow.ManagerPerformanceRatingDescription, managerRow.PerformanceRatingMeaning)\n  ) ||\n  findTargetByNumericRating(items, managerRow.ManagerPerformanceNumericRating);\n\nvar currentRatingLevelId = currentTarget\n  ? currentTarget.RatingLevelId\n  : firstNonEmpty(managerRow.PerformanceRatingLevelId, \"\");\n\nvar currentComment = firstNonEmpty(managerRow.ManagerCommentText, \"\");\n\nvar ratingsField = {\n  id: \"newrating\",\n  label: \"Performance Rating\",\n  value: isFormSubmitAction ? \"\" : String(currentRatingLevelId || \"\"),\n  type: \"select\",\n  readOnly: false,\n  options: options\n};\n\nvar commentsField = {\n  id: \"newcomments\",\n  label: \"Rating Comments\",\n  value: isFormSubmitAction ? \"\" : currentComment,\n  type: \"textarea\",\n  readOnly: false\n};\n\nif (selectedPersonRecord.SectionRatingsRequiredFlag === true) {\n  ratingsField.label = \"* \" + ratingsField.label;\n}\n\nif (selectedPersonRecord.SectionCommentsRequiredFlag === true) {\n  commentsField.label = \"* \" + commentsField.label;\n}\n\nif (selectedPersonRecord.SectionRatingsDisplayFlag === true) {\n  formFields.push(ratingsField);\n}\n\nif (selectedPersonRecord.SectionCommentsDisplayFlag === true) {\n  formFields.push(commentsField);\n}\n\nreturn formFields;"
          },
          "outcomes": {
            "success": "1774590021141"
          },
          "code": "CONSTRUCT_EDITABLE_FIELDS",
          "id": "1774589968121",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
