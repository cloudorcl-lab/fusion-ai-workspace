        {
          "metadata": {
            "name": "Parse Submitted Form Data",
            "returnType": "object",
            "sourceCode": "var oraAction = $context.$app.$OraAction;\nvar selectedPersonRec = $context.$nodes.GET_SELECTED_PERSON_RECORD.$output.result;\nvar out = {};\n\ntry {\n  var gt = oraAction ? oraAction.indexOf(\">\") : -1;\n  var lt = oraAction ? oraAction.lastIndexOf(\"</\") : -1;\n\n  var payload = (gt !== -1 && lt !== -1 && lt > gt)\n    ? oraAction.substring(gt + 1, lt)\n    : oraAction;\n\n  // Keep as-is logically; just make it syntactically valid\n  var cleanJson = String(payload)\n    .replace(/\\\\\"/g, '\"')\n    .replace(/^\"|\"$/g, \"\");\n\n  var data = JSON.parse(cleanJson);\n\n  var fields =\n    (data && data.properties && data.properties.fields)\n      ? data.properties.fields\n      : [];\n\n  // Convert array [{id,value}, ...] -> object { id: value, ... }\n  var formData = {};\n  for (var i = 0; i < fields.length; i++) {\n    formData[fields[i].id] = fields[i].value;\n  }\n\n  var personId = formData.PersonId;\n  var evaluationId = formData.EvaluationId;\n  var newrating = formData.newrating;\n  var newcomments = formData.newcomments;\n\n  // Required flags (handles boolean true OR string \"true\")\n  var ratingRequired = String(selectedPersonRec && selectedPersonRec.SectionRatingsRequiredFlag) === \"true\";\n  var commentRequired = String(selectedPersonRec && selectedPersonRec.SectionCommentsRequiredFlag) === \"true\";\n\n  var hasRating = newrating !== null && newrating !== undefined && String(newrating) !== \"\";\n  var hasComment = newcomments !== null && newcomments !== undefined && String(newcomments).trim() !== \"\";\n\n  var isValid = (!ratingRequired || hasRating) && (!commentRequired || hasComment);\n\n  out = {\n    PersonId: personId,\n    EvaluationId: evaluationId,\n    newrating: newrating,\n    newcomments: newcomments,\n    isValidFormData: isValid\n  };\n} catch (e) {\n  out = { error: \"ERROR !!\", details: String(e) };\n}\n\nreturn out;"
          },
          "outcomes": {
            "success": "1774590085890"
          },
          "code": "PARSE_SUBMITTED_FORM_DATA",
          "id": "1774590048501",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "aiAppOutputSpecification": {
