        {
          "metadata": {
            "businessObjectCode": "ORA_CX_SALESFORCE_ACCOUNTS",
            "functionName": "getMultipleAccounts",
            "name": "Fetch All Account Score"
          },
          "outcomes": {
            "success": "1769380208464"
          },
          "code": "FETCH_ALL_ACCOUNT_SCORE",
          "id": "1769380161589",
          "inputs": [
            {
              "id": "1769381668313_1",
              "name": "PartyNumbers",
              "type": "string",
              "value": "{{$context.$nodes.GET_DISTINCT_ACCOUNTS.$output.result}}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"items\": {\n            \"type\": \"array\",\n            \"items\": {\n                \"type\": \"object\",\n                \"properties\": {}\n            }\n        }\n    }\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Map Account Score to SR",
            "returnType": "array",
            "sourceCode": "const accountsOutput = $context.$nodes.FETCH_ALL_ACCOUNT_SCORE.$output.items\nconst srOutput = $context.$nodes.FETCH_ALL_AGENTS_OPEN_SR.$output.items\n\nconst accountMap = {};\naccountsOutput.forEach(account => {\n  accountMap[account.PartyNumber] = {\n    AccountScore: account.AccountScore ?? null,\n    AccountScoringTier: account.AccountScoringTier ?? null\n  };\n});\n\nconst updatedSRs = srOutput.map(({ \"@context\": _, \"@links\": __, ...sr }) => ({\n  ...sr,\n  accountScore: accountMap[sr.AccountPartyNumber]?.AccountScore ?? null,\n  AccountScoringTier: accountMap[sr.AccountPartyNumber]?.AccountScoringTier ?? null\n}));\n\nreturn JSON.stringify(updatedSRs, null, 2);"
          },
          "outcomes": {
            "success": "1767989592708"
          },
          "code": "MAP_ACCOUNT_SCORE_TO_SR",
          "id": "1769380208464",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_CX_SERVICECEN_RESOURCES",
            "functionName": "getResourcesByQueryWithFields",
            "processJson": true,
            "name": "Get Subordinates"
          },
          "outcomes": {
            "success": "1769458643047"
          },
          "code": "GET_SUBORDINATES",
          "id": "1769380654654",
          "inputs": [
            {
              "id": "1776164628483_1",
              "name": "query",
              "type": "string",
              "value": "{{ \"RecordSet='ORA_MYREPORTEES' and StartDateActive<'\" + $context.$system.$currentDateTime + \"'\"}}"
            },
            {
              "id": "1776164628485_2",
              "name": "fields",
              "type": "string",
