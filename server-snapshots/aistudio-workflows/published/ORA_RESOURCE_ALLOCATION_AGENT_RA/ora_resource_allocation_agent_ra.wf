            "name": "Get all PersonId query",
            "returnType": "string",
            "sourceCode": "const data = $context.$nodes.FORMAT_SUBORDINATES.$output.result || [];\n\n// Add the extra PartyId\nconst inClause = `(${data.map(x => `'${x.PartyId}'`).join(\",\")})`;\n\n// Construct the query\nconst query = `OwnerEntityId in ${inClause} and OwnerEntityObject='HZ_PARTIES' and SourceSystem='FUSION_HCM'`;\n\nreturn query;"
          },
