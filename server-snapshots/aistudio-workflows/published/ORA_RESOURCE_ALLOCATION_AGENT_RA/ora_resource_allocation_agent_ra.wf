        },
        {
          "metadata": {
            "name": "Clean Up SR Details",
            "returnType": "object",
            "sourceCode": "const srInput = $context.$triggers.REST.$input.srData\nconst srDetailsArray = $context.$nodes.FETCHSRDETAILS.$output.items || [];\nconst allowedTypes = [\"ORA_SVC_CUSTOMER_ENTRY\", \"ORA_SVC_RESPONSE\", \"ORA_SVC_INTERNAL_NOTE\"];\n\nconst output = {};\n\nconst srDetailsMap = new Map(\n  srDetailsArray.map(item => [item.SrNumber, item])\n);\n\n// Process each SR in srInput\nObject.entries(srInput).forEach(([srNumber, srInputObj]) => {\n  const srDetail = srDetailsMap.get(srNumber) || {};\n\n  const latestTimestamp = srInputObj.LatestMessageTimestamp\n    ? new Date(srInputObj.LatestMessageTimestamp)\n    : null;\n\n  delete srDetail[\"@context\"];\n\n  if (srDetail.messages?.items) {\n    srDetail.messages = {\n      items: srDetail.messages.items\n        .map(msg => {\n          delete msg[\"@context\"];\n          delete msg[\"@links\"];\n          return msg;\n        })\n        .filter(msg => allowedTypes.includes(msg.MessageTypeCd))\n        .filter(msg => {\n          const msgDate = new Date(msg.CreationDate);\n          return !latestTimestamp || msgDate > latestTimestamp;\n        })\n    };\n  }\n\n  if (srDetail.resourceMembers?.items) {\n    srDetail.resourceMembers = {\n      items: srDetail.resourceMembers.items.map(member => {\n        delete member[\"@context\"];\n        return member;\n      })\n    };\n  }\n\n  output[srNumber] = srDetail;\n});\n\nreturn output;"
          },
          "outcomes": {
            "success": "1767988072438"
          },
          "code": "CLEAN_UP_SR_DETAILS",
          "id": "1774315948233",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
