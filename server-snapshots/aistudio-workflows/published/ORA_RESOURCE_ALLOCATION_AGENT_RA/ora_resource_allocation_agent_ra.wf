          "code": "CREATE_AI_METRICS",
          "id": "1774996949331",
          "inputs": [
            {
              "id": "1774996966504_1",
              "name": "agentTeamCode",
              "type": "string",
              "value": "{{$context.$workflow.$name}}"
            },
