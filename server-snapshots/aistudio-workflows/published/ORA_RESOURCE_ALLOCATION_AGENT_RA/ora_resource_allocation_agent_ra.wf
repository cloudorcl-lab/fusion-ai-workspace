                    "name": "Map Result to SR",
                    "returnType": "object",
                    "sourceCode": "let similarSR = $context.$nodes.FETCH_SIMILAR_SR.FETCH_RESOLVED_SIMILARSR.$output.items || [];\n\nconst filteredSimilarSR = similarSR\n.filter(item => item.$context?.search?.score > 55)\n.map(item => ({\n  number: item.number,\n  title: item.title,\n  problemDescription: item.problemDescription,\n  resolvedBy: item.resolvedBy\n}));\n\nconst result = {\n  srnumber: $context.$nodes.FETCH_SIMILAR_SR.$currentItem.SRNumber,\n  similarIssues: filteredSimilarSR\n};\n\nreturn result"
                  },
                  "outcomes": {
