        {
          "metadata": {
            "errorNodeId": "1767988354764",
            "name": "Get Leave Record Query",
            "returnType": "string",
            "sourceCode": "const responseObj = $context.$nodes.GET_ALL_PERSONID.$output\n\nconst sourceSystemValues = (responseObj.items ?? [])\n  .map(i => i?.SourceSystemReferenceValue)\n  .filter(v => v != null); // []\n\n\nconst result = {\n  parts: sourceSystemValues.map((value, index) => ({\n    id: String(index + 1),\n    path: `/absences?finder=findAbsenceUsingAllAbsParameters;personId=${value}&fields=personId,absenceType,absenceReason,startDate,startDateTime,endDate,endDateTime,absenceDispStatusMeaning&onlyData=true`,\n    operation: \"get\"\n  }))\n};\nreturn result;"
          },
          "outcomes": {
            "success": "1767988354764"
          },
          "code": "GET_LEAVE_RECORD_QUERY",
          "id": "1769380942970",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Available Agents",
            "returnType": "object",
            "sourceCode": "// Get data safely\nconst data = $context.$nodes.FORMAT_SUBORDINATES?.$output?.result ?? [];\nconst responseObj = $context.$nodes.GET_ALL_PERSONID?.$output ?? {};\nconst leaveResponse = $context.$nodes.FETCH_ALL_AGENTS_LEAVE_SCHEDULE?.$output ?? {};\n\n// Build lookup: SourceSystemReferenceValue -> OwnerEntityId (PartyId)\nconst sourceToOwnerId = {};\n(responseObj.items ?? []).forEach(i => {\n  if (i?.SourceSystemReferenceValue && i?.OwnerEntityId) {\n    sourceToOwnerId[i.SourceSystemReferenceValue] = i.OwnerEntityId;\n  }\n});\n\nconst now = Date.now();\nconst onLeavePartyIds = new Set();\n\n// Find agents who are currently on leave\n(leaveResponse.parts ?? [])\n  .filter(part => part?.payload?.items?.length > 0)\n  .forEach(part => {\n    const item = part.payload.items[0];\n\n    const personId = item?.personId || null;\n    const partyId = personId ? sourceToOwnerId[personId] : null;\n\n    const startTime = new Date(item?.startDateTime).getTime();\n    const endTime = new Date(item?.endDateTime).getTime();\n\n    const isCurrentlyOnLeave =\n      partyId &&\n      !Number.isNaN(startTime) &&\n      !Number.isNaN(endTime) &&\n      now >= startTime &&\n      now <= endTime;\n\n    if (isCurrentlyOnLeave) {\n      onLeavePartyIds.add(partyId);\n    }\n  });\n\n// Return only agents who are NOT currently on leave\nconst result = data.filter(d => !onLeavePartyIds.has(d?.PartyId));\n\nreturn result;"
          },
          "outcomes": {
            "success": "1773251770523"
          },
          "code": "AVAILABLE_AGENTS",
          "id": "1769380985484",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get Distinct Accounts",
            "returnType": "string",
            "sourceCode": "let allAccounts = $context.$nodes.FETCH_ALL_AGENTS_OPEN_SR.$output.items\nconst accounts = allAccounts\n        .map(item => item.AccountPartyNumber) \n        .filter(num => num)                   \nconst distinctAccounts = [...new Set(accounts)]; \nreturn distinctAccounts.map(num => `'${num}'`).join(\",\");"
          },
          "outcomes": {
            "success": "1769380161589"
          },
          "code": "GET_DISTINCT_ACCOUNTS",
