        {
          "metadata": {
            "name": "Filter Existing Team Members From Recommendations",
            "returnType": "object",
            "sourceCode": "const allocations = $context.$nodes.ALLOCATE_RESOURCE.$output || [];\nconst srDetails = $context.$nodes.CLEAN_UP_SR_DETAILS.$output.result || {};\n\nconst normalize = value => String(value ?? \"\").trim().toLowerCase();\n\nconst filtered = allocations.map(item => {\n  const action = normalize(item?.Action);\n\n  if (action !== \"add team member\") {\n    return item;\n  }\n\n  const srNumber = item?.ObjectNumber;\n  const memberSet = new Set(\n    ((srDetails?.[srNumber]?.resourceMembers?.items) || [])\n      .map(member => normalize(member?.PartyUniqueName))\n      .filter(Boolean)\n  );\n\n  const recommendedAgents = Array.isArray(item?.RecommendedAgents)\n    ? item.RecommendedAgents\n    : [];\n\n  const filteredAgents = recommendedAgents.filter(agent => {\n    const agentName = normalize(agent?.AgentName);\n    return !memberSet.has(agentName);\n  });\n\n  return {\n    ...item,\n    RecommendedAgents: filteredAgents\n  };\n});\n\nreturn filtered;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "FILTER_EXISTING_TEAM_MEMBERS_FROM_RECOMMENDATIONS",
          "id": "1777918230911",
          "inputs": [],
