        {
          "metadata": {
            "name": "SR With Account Score",
            "returnType": "object",
            "sourceCode": "const accountsOutput = $context.$nodes.FETCH_ALL_ACCOUNT_SCORE.$output.items\nconst srObject = $context.$nodes.CLEAN_UP_SR_DETAILS.$output.result\nconst currentUserPartyId = $context.$nodes.GET_RESOURCE_PARTY_NAME.$output.items[0].PartyId\n\nconst srOutput  = Object.values(srObject);\n\nconst accountMap = {};\naccountsOutput.forEach(account => {\n  accountMap[account.PartyNumber] = {\n    AccountScore: account.AccountScore ?? null,\n    AccountScoringTier: account.AccountScoringTier ?? null\n  };\n});\n\nconst SRDetails = [];\nconst SRResourceInfo = [];\n\nsrOutput.forEach(sr => {\n  const { AssigneePersonName, resourceMembers, SrNumber,AssigneePartyId, ...srDetailsOnly } = sr;\n\n  // SRDetails entry\n  SRDetails.push({\n    SrNumber,\n    ...srDetailsOnly,\n    accountScore: accountMap[sr.AccountPartyNumber]?.AccountScore ?? null,\n    accountScoringTier: accountMap[sr.AccountPartyNumber]?.AccountScoringTier ?? null,\n    assignToMe: String(sr.AssigneePartyId) === String(currentUserPartyId)\n  });\n\n  // SRResourceInfo\n  SRResourceInfo.push({\n    SrNumber: SrNumber, \n    assignee: AssigneePersonName ?? null,\n    teamMembers: resourceMembers?.items?.map(m => m.PartyUniqueName) ?? []\n  });\n});\n\nconst result = {\nSRDetails,\nSRResourceInfo\n}\n\nreturn result"
          },
          "outcomes": {
            "success": "1767989937368"
          },
