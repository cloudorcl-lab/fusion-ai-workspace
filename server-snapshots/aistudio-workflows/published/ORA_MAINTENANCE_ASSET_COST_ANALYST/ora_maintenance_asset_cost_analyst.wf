{
  "workflowId": "300000327004241",
  "workflowCode": "ORA_MAINTENANCE_ASSET_COST_ANALYST",
  "name": "Maintenance Asset Cost Analyst",
  "description": "Collects actual material, labor, equipment, and total maintenance costs for each asset from work order transactions by costing period. Provides summary statistics and detailed breakdowns to support informed asset management and prioritization.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
