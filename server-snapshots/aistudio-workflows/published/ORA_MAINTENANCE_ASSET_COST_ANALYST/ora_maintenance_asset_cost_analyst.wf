        {
          "metadata": {
            "name": "Get Period Ranges",
            "returnType": "object",
            "sourceCode": "const cur = $context.$system.$currentDate; // \"YYYY-MM-DD\"\nlet retValue = null;\n\ntry {\n  const d = new Date(cur + \"T00:00:00Z\");\n\n  const toYear = d.getUTCFullYear();\n  const toMonth = d.getUTCMonth() + 1; // 1–12\n\n  let fromYear = toYear;\n  let fromMonth = toMonth - 2; // last 3 months inclusive\n\n  while (fromMonth <= 0) {\n    fromMonth += 12;\n    fromYear -= 1;\n  }\n\n  const toMonth2 = toMonth < 10 ? \"0\" + toMonth : String(toMonth);\n  const fromMonth2 = fromMonth < 10 ? \"0\" + fromMonth : String(fromMonth);\n\n  retValue = {\n    PeriodYearTo: String(toYear),\n    PeriodNumberTo: String(toMonth),\n    PeriodYearFrom: String(fromYear),\n    PeriodNumberFrom: String(fromMonth),\n    ToPeriod: toYear + \"-\" + toMonth2,\n    FromPeriod: fromYear + \"-\" + fromMonth2\n  };\n} catch (error) {\n  // leave retValue as null\n}\n\nreturn retValue;"
          },
          "outcomes": {
            "success": "1770349054390"
          },
          "code": "GET_PERIOD_RANGES",
          "convergenceTargetId": "1770349688713",
          "id": "1770350356100",
