        {
          "metadata": {
            "name": "Extract Org and Asset Context",
            "returnType": "object",
            "sourceCode": "const appContext = $context.$app.$OraAppContext ?? $context.$triggers.REST.$input.OraAppContext ;\nlet OrganizationId = null;\nlet OrganizationCode = null;\nlet AssetId = null;\nlet AssetNumber = null;\nlet Summary = null;\nlet retValue = null;\n\nif (appContext != null) {\n  if (typeof appContext === 'object') {\n    OrganizationId = appContext?.OrganizationId ?? null;\n    OrganizationCode = appContext?.OrganizationCode ?? null;\n    AssetId = appContext?.AssetId ?? null;\n   AssetNumber = appContext?.AssetNumber ?? null;\n  Summary  = appContext?.Summary ?? null;\n  } else if (typeof appContext === 'string') {\n    const s = appContext.trim();\n    if (s.startsWith('{') || s.startsWith('[')) {\n      try {\n        const obj = JSON.parse(s);\n        OrganizationId = obj?.OrganizationId ?? null;\n        OrganizationCode = obj?.OrganizationCode ?? null;\n        AssetId = obj?.AssetId ?? null;\n       AssetNumber = obj?.AssetNumber ?? null;\n       Summary  = obj?.Summary ?? null;\n      } catch {\n        // Malformed JSON; fall back to treating as plain ID or first CSV part\n          const parts = s.split(',').map(p => p.trim());\n          OrganizationId = parts[0] || s || null;\n          OrganizationCode = parts[1] || null;\n          AssetId = parts[2] || null;\n          AssetNumber = parts[3] || null;\n          Summary = parts[4] || null;\n      }\n    } else {\n        const parts = s.split(',').map(p => p.trim());\n          OrganizationId = parts[0] || s || null;\n          OrganizationCode = parts[1] || null;\n          AssetId = parts[2] || null;\n          AssetNumber = parts[3] || null;\n          Summary = parts[4] || null;\n    }\n  } else {\n    OrganizationId = String(appContext).trim() || null;\n  }\n}\n\nreturn { OrganizationId,OrganizationCode,AssetId,AssetNumber,Summary};"
          },
          "outcomes": {
            "success": "1770351707987"
          },
          "code": "EXTRACT_ORG_ASSET_CONTEXT",
          "convergenceTargetId": "1770349688713",
          "id": "1770348979651",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
