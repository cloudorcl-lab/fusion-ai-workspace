          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"Structured Content Response\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"mappingId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"logicalDocumentId\": {\n      \"type\": \"string\"\n    },\n    \"documentType\": {\n      \"type\": \"string\",\n      \"description\": \"STRUCTURED or UNSTRUCTURED\"\n    },\n    \"content\": {\n      \"type\": \"string\",\n      \"description\": \"XML or textual content\"\n    }\n  }\n}",
