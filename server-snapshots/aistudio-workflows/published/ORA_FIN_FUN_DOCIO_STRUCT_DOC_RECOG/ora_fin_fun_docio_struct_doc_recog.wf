        {
          "metadata": {
            "name": "Validate Retry Recognition Response",
            "returnType": "object",
            "sourceCode": "// TRANSFORMATION SPEC EXTRACTOR\nvar node = $context.$nodes.FIN_FUN_BOF_RETRY_RECOGNIZE_DOCUMENT;\nvar nodeStatus = node && typeof node.$status === \"string\" ? node.$status.trim().toUpperCase() : null;\nvar boResponse = node ? node.$output : null;\nvar result = null;\n\n// 1. NODE EXECUTION FAILURE (CASE INSENSITIVE)\nif (nodeStatus === \"FAILURE\") {\n    var errorInfo = node.$error;\n    var errorMessage = \"Structured Document Recognition execution failed.\";\n    var errorCode = \"EXECUTION_ERROR\";\n    if (errorInfo && typeof errorInfo === \"object\") {\n        if (typeof errorInfo.$info === \"string\" && errorInfo.$info.trim()) {\n            errorMessage = errorInfo.$info;\n        } else if (typeof errorInfo.message === \"string\" && errorInfo.message.trim()) {\n            errorMessage = errorInfo.message;\n        } else if (typeof errorInfo.error === \"string\" && errorInfo.error.trim()) {\n            errorMessage = errorInfo.error;\n        }\n        if (errorInfo.code) {\n            errorCode = errorInfo.code;\n        }\n    }\n    result = {\n        status: \"ERROR\",\n        error: {\n            stage: \"Structured Document Recognition\",\n            code: errorCode,\n            message: errorMessage\n        }\n    };\n}\n// 2. MALFORMED OR MISSING RESPONSE\nelse if (!boResponse || typeof boResponse !== \"object\") {\n    result = {\n        status: \"ERROR\",\n        error: {\n            stage: \"Extract Transformation\",\n            code: \"MALFORMED_TOOL_RESPONSE\",\n            message: \"Business Object response is missing or invalid.\"\n        }\n    };\n}\n// 3. FAILURE STATUS FROM NODE OUTPUT (CASE INSENSITIVE)\nelse if (\n    boResponse.status &&\n    (typeof boResponse.status === \"string\" ? boResponse.status.trim().toUpperCase() !== \"SUCCESS\" : false)\n) {\n    result = {\n        status: \"ERROR\",\n        error: {\n            stage: \"Structured Document Recognition\",\n            code: \"EXECUTION_ERROR\",\n            message: \"Structured document recognition failed.\"\n        }\n    };\n}\n// 4. MISSING OR BLANK CONTENT\nelse if (!boResponse.content || String(boResponse.content).trim() === \"\") {\n    result = {\n        status: \"ERROR\",\n        error: {\n            stage: \"Extract Transformation\",\n            code: \"MISSING_TRANSFORMATION\",\n            message: \"No valid transformation found in response.\"\n        }\n    };\n}\n// 5. SUCCESS → PASS THROUGH AS-IS\nelse {\n    result = boResponse;\n}\nresult;"
          },
