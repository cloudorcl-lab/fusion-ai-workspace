{
  "workflowId": "300000326919170",
  "workflowCode": "ORA_FIN_FUN_DOCIO_STRUCT_DOC_RECOG",
  "name": "Doc IO Structured Document Recognition",
  "description": "Processes structured documents such as  XML, JSON, and CSV. Creates transformation artifacts like XSLT or JOLT that map and convert source data structures into Oracle application schemas, delivering standardized output for seamless ingestion by downstream processes.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
