        {
          "metadata": {
            "errorNodeId": "1766041614704",
            "name": "Wait For Retry",
            "returnType": "object",
            "sourceCode": "// Record start timestamp\nvar startTime = new Date().toISOString();\n\n// ---  second delay (blocking) ---\nvar delayMs = 20000; // 20 seconds\nvar start = new Date().getTime();\nwhile (new Date().getTime() - start < delayMs) {\n  // busy wait\n}\n\n// Record end timestamp\nvar endTime = new Date().toISOString();\n\n// Build result object\nvar result = {\n  status: \"OK\",\n  startTime: startTime,\n  endTime: endTime,\n  message: \"20 second delay completed\"\n};\n\n\nresult;"
          },
          "outcomes": {
            "success": "1766041614704"
          },
