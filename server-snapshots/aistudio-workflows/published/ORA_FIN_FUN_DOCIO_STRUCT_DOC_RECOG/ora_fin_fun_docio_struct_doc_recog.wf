        {
          "metadata": {
            "errorNodeId": "1766502914934",
            "name": "Validate Structured Payload",
            "returnType": "object",
            "sourceCode": "// INPUT PAYLOAD VALIDATOR & PAYLOAD CREATOR (FLAT INPUT ONLY)\nconst raw = $context.$system.$inputMessage;\nlet input = null;\nlet result = null;\nlet parseError = false;\n\n// Parse input\ntry {\n  input = (typeof raw === \"string\") ? JSON.parse(raw) : raw;\n} catch (e) {\n  parseError = true;\n  result = {\n    status: \"ERROR\",\n    error: {\n      stage: \"Input Validation\",\n      code: \"MALFORMED_INPUT\",\n      message: \"Input is not valid JSON.\"\n    }\n  };\n}\n\n// Validate input object\nif (!parseError) {\n  if (!input || typeof input !== \"object\") {\n    parseError = true;\n    result = {\n      status: \"ERROR\",\n      error: {\n        stage: \"Input Validation\",\n        code: \"MISSING_REQUIRED_FIELDS\",\n        message: \"Input payload is missing or invalid.\"\n      }\n    };\n  }\n}\n\n// Validate required fields\nif (!parseError) {\n  // Optional fields checks for conditional inclusion in payload\n  const hasBO = typeof input.businessObject === \"string\" && input.businessObject.trim() !== \"\";\n  const hasProduct = typeof input.product === \"string\" && input.product.trim() !== \"\";\n\n  // Required fields validation\n  const hasDocFileName = typeof input.documentFileName === \"string\" && input.documentFileName.trim() !== \"\";\n  const hasBase64 = typeof input.documentInBase64 === \"string\" && input.documentInBase64.trim() !== \"\";\n  const hasLink = typeof input.documentLink === \"string\" && input.documentLink.trim() !== \"\";\n  const hasId = typeof input.documentId === \"string\" && input.documentId.trim() !== \"\";\n  const hasDocSource = hasBase64 || hasLink || hasId;\n\n  if (!hasDocFileName || !hasDocSource) {\n    result = {\n      status: \"ERROR\",\n      error: {\n        stage: \"Input Validation\",\n        code: \"MISSING_REQUIRED_FIELDS\",\n        message: \"Missing required fields: documentFileName and at least one of documentInBase64, documentLink, or documentId.\"\n      }\n    };\n  } else {\n    const payload = {\n      documentFileName: input.documentFileName,\n      documentInBase64: input.documentInBase64 || \"\",\n      direction: input.direction || \"ORA_INBOUND\"\n    };\n    if (hasBO) {\n      payload.businessObject = input.businessObject;\n    }\n    if (hasProduct) {\n      payload.product = input.product;\n    }\n    result = { payload };\n  }\n}\n\nresult;"
          },
          "outcomes": {
            "success": "1765945935607"
          },
          "code": "FIN_FUN_CODE_VALIDATE_PAYLOAD",
          "id": "1765945911304",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
