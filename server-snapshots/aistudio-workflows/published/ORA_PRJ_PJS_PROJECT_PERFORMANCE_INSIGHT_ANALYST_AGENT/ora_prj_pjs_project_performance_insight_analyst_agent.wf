{
  "workflowId": "300000333082630",
  "workflowCode": "ORA_PRJ_PJS_PROJECT_PERFORMANCE_INSIGHT_ANALYST_AGENT",
  "name": "Project Performance Insight Analyst",
  "description": "Explains project performance insights for project stakeholders by highlighting important changes, risks, and trends across cost, budget, forecast, commitment, margin, billing, and collections. This analyst summarizes what changed, why it matters, and where attention may be needed.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_PRJ_ORAPRJCOMM_PROJECTCOMMONDATAEXTRACTION",
            "description": "Calls Project Common Data Extraction EXTRACT with the bossExtract workflow attribute for project performance insight analysis.",
            "functionName": "EXTRACT",
            "name": "Invoke BOSS Extract"
          },
          "outcomes": {
            "success": "2"
          },
          "code": "INVOKE_BOSS_EXTRACT",
          "id": "1",
          "inputs": [
            {
              "id": "1_payload",
              "name": "payload",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.bossExtract}}"
            }
          ],
          "outputSpecification": "",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "description": "Builds deterministic sanitized project rows and narrative column labels while suppressing identifier fields and deriving each monetary value currency directly from the BOSS Extract CurrencyCode field.",
            "name": "Prepare Relevant Project Data",
            "returnType": "object",
            "sourceCode": "let extractData = $context.$nodes.INVOKE_BOSS_EXTRACT.$output;\n\nif (typeof extractData === \"string\") {\n  try {\n    extractData = JSON.parse(extractData);\n  } catch (error) {\n    // Keep the original value so the no-record path remains deterministic.\n  }\n}\n\nfunction isObject(value) {\n  return !!value && typeof value === \"object\" && !Array.isArray(value);\n}\n\nfunction collectObjectArrays(value, arrays, depth) {\n  if (depth > 8 || value === undefined || value === null) return;\n  if (Array.isArray(value)) {\n    if (value.some(isObject)) arrays.push(value);\n    for (let i = 0; i < value.length; i++) {\n      collectObjectArrays(value[i], arrays, depth + 1);\n    }\n    return;\n  }\n  if (!isObject(value)) return;\n  const keys = Object.keys(value);\n  for (let i = 0; i < keys.length; i++) {\n    collectObjectArrays(value[keys[i]], arrays, depth + 1);\n  }\n}\n\nfunction chooseRows(value) {\n  if (Array.isArray(value)) return value.filter(isObject);\n  const preferredPaths = [\n    [\"items\"],\n    [\"result\", \"items\"],\n    [\"result\"],\n    [\"rows\"],\n    [\"data\"]\n  ];\n  for (let i = 0; i < preferredPaths.length; i++) {\n    let current = value;\n    for (let j = 0; j < preferredPaths[i].length; j++) {\n      current = current && current[preferredPaths[i][j]];\n    }\n    if (Array.isArray(current) && current.some(isObject)) {\n      return current.filter(isObject);\n    }\n  }\n  const arrays = [];\n  collectObjectArrays(value, arrays, 0);\n  arrays.sort(function(a, b) { return b.length - a.length; });\n  return arrays.length ? arrays[0].filter(isObject) : [];\n}\n\nfunction normalizeKey(key) {\n  return String(key || \"\").toLowerCase().replace(/[^a-z0-9]/g, \"\");\n}\n\nfunction camelKey(key) {\n  const words = String(key || \"\")\n    .replace(/([a-z0-9])([A-Z])/g, \"$1 $2\")\n    .replace(/([A-Z]+)([A-Z][a-z])/g, \"$1 $2\")\n    .replace(/[^A-Za-z0-9]+/g, \" \")\n    .trim()\n    .split(/\\s+/)\n    .filter(Boolean);\n  if (!words.length) return \"\";\n  return words.map(function(word, index) {\n    const lower = word.toLowerCase();\n    return index === 0 ? lower : lower.charAt(0).toUpperCase() + lower.slice(1);\n  }).join(\"\");\n}\n\nfunction canonicalKey(key) {\n  const normalized = normalizeKey(key);\n  const aliases = {\n    projectid: \"projectId\",\n    projectname: \"projectName\",\n    projectnumber: \"projectNumber\",\n    projectno: \"projectNumber\",\n    projectnum: \"projectNumber\",\n    actualcost: \"actualCost\",\n    actualcostinprojectcurrency: \"actualCost\",\n    currentbudgetcost: \"currentBudgetCost\",\n    currentbudgetcostinprojectcurrency: \"currentBudgetCost\",\n    budgetcost: \"budgetCost\",\n    currencycode: \"currencyCode\",\n    currencytype: \"currencyType\",\n    projectcurrencytype: \"currencyType\"\n  };\n  return aliases[normalized] || camelKey(key);\n}\n\nfunction setFlatValue(target, fieldMetadata, key, value) {\n  const canonical = canonicalKey(key);\n  if (!canonical) return;\n  const suppress = shouldSuppressColumn(key, canonical);\n  if (!fieldMetadata[canonical]) {\n    fieldMetadata[canonical] = {\n      suppress: suppress\n    };\n  } else if (suppress) {\n    fieldMetadata[canonical].suppress = true;\n  }\n  if (target[canonical] === undefined || target[canonical] === null || String(target[canonical]).trim() === \"\") {\n    target[canonical] = value;\n  }\n}\n\nfunction flattenRecord(value, target, fieldMetadata, prefix, depth) {\n  if (depth > 6 || value === undefined || value === null) return;\n  if (!isObject(value)) {\n    if (prefix) setFlatValue(target, fieldMetadata, prefix, value);\n    return;\n  }\n  const keys = Object.keys(value);\n  for (let i = 0; i < keys.length; i++) {\n    const key = keys[i];\n    const child = value[key];\n    const combinedKey = prefix ? prefix + \" \" + key : key;\n    if (isObject(child)) {\n      flattenRecord(child, target, fieldMetadata, combinedKey, depth + 1);\n    } else {\n      setFlatValue(target, fieldMetadata, combinedKey, child);\n    }\n  }\n}\n\nfunction hasMeaningfulValue(value) {\n  return value !== undefined && value !== null && String(value).trim() !== \"\";\n}\n\nconst nonIdentifierWords = {\n  paid: true,\n  unpaid: true,\n  valid: true,\n  invalid: true,\n  void: true,\n  solid: true,\n  liquid: true,\n  fluid: true,\n  hybrid: true,\n  rapid: true,\n  acid: true,\n  grid: true,\n  pyramid: true\n};\n\nconst identifierEntityStems = [\n  \"project\",\n  \"task\",\n  \"resource\",\n  \"supplier\",\n  \"contract\",\n  \"award\",\n  \"person\",\n  \"employee\",\n  \"invoice\",\n  \"transaction\",\n  \"expenditure\",\n  \"organization\",\n  \"businessunit\",\n  \"customer\",\n  \"object\",\n  \"asset\",\n  \"manager\"\n];\n\nfunction isIdentifierColumn(originalKey, canonicalKey) {\n  const raw = String(originalKey || \"\");\n  const normalized = normalizeKey(canonicalKey || originalKey);\n  const originalLeaf = raw.trim().split(/[\\s._/\\\\-]+/).filter(Boolean).pop() || raw;\n  const leafNormalized = normalizeKey(originalLeaf);\n  if (nonIdentifierWords[normalized] || nonIdentifierWords[leafNormalized]) return false;\n  const words = raw\n    .replace(/([a-z0-9])([A-Z])/g, \"$1 $2\")\n    .replace(/([A-Z]+)([A-Z][a-z])/g, \"$1 $2\")\n    .replace(/[^A-Za-z0-9]+/g, \" \")\n    .trim()\n    .toLowerCase()\n    .split(/\\s+/)\n    .filter(Boolean);\n  const last = words.length ? words[words.length - 1] : \"\";\n  if (last === \"id\" || last === \"ids\" || last === \"identifier\" || last === \"identifiers\") return true;\n  if (normalized === \"id\" || normalized === \"identifier\" || normalized === \"identifiers\") return true;\n  if (/^[A-Z0-9]+ID$/.test(originalLeaf)) return true;\n  if (!normalized.endsWith(\"id\")) return false;\n  const stem = normalized.slice(0, -2);\n  return identifierEntityStems.some(function(entity) {\n    return stem === entity || stem.endsWith(entity);\n  });\n}\n\nfunction shouldSuppressColumn(originalKey, canonicalKey) {\n  const normalized = normalizeKey(canonicalKey || originalKey);\n  return normalized === \"currencycode\" || normalized === \"currencytype\" ||\n    isIdentifierColumn(originalKey, canonicalKey);\n}\n\nfunction isMonetaryKey(key) {\n  const normalized = normalizeKey(key);\n  if (/percent|percentage|rate|quantity|qty|hours|count/.test(normalized)) return false;\n  return /amount|cost|budget|revenue|variance|spend|price|charge|burdened|forecast|commitment|margin/.test(normalized);\n}\n\nfunction isDateKey(key) {\n  const normalized = normalizeKey(key);\n  return /date$/.test(normalized) || /startdate|enddate|asofdate/.test(normalized);\n}\n\nfunction labelFromKey(key) {\n  const normalized = normalizeKey(key);\n  const known = {\n    projectname: \"Project Name\",\n    projectnumber: \"Project Number\",\n    projectstatus: \"Project Status\",\n    actualcost: \"Actual Cost\",\n    currentbudgetcost: \"Current Budget Cost\",\n    budgetcost: \"Budget Cost\",\n    budgetamount: \"Budget Amount\",\n    budgetvariance: \"Budget Variance\",\n    variance: \"Variance\",\n    variancepercent: \"Variance Percent\",\n    actualandcommittedcost: \"Actual and Committed Cost\",\n    commitmentamount: \"Commitment Amount\",\n    committedcost: \"Committed Cost\",\n    forecastamount: \"Forecast Amount\",\n    plannedamount: \"Planned Amount\",\n    revenueamount: \"Revenue Amount\",\n    burdenedcost: \"Burdened Cost\",\n    rawcost: \"Raw Cost\",\n    actualhours: \"Actual Hours\",\n    taskname: \"Task Name\",\n    tasknumber: \"Task Number\",\n    resourcename: \"Resource Name\",\n    resourcenumber: \"Resource Number\",\n    suppliername: \"Supplier Name\",\n    businessunit: \"Business Unit\",\n    expendituretype: \"Expenditure Type\",\n    expenditureorganization: \"Expenditure Organization\",\n    accountingperiod: \"Accounting Period\"\n  };\n  if (known[normalized]) return known[normalized];\n  const acronyms = { id: \"ID\", url: \"URL\", api: \"API\", kpi: \"KPI\", po: \"PO\", ap: \"AP\", ar: \"AR\", gl: \"GL\", erp: \"ERP\", wbs: \"WBS\", uom: \"UOM\" };\n  const words = String(key || \"\")\n    .replace(/([a-z0-9])([A-Z])/g, \"$1 $2\")\n    .replace(/[^A-Za-z0-9]+/g, \" \")\n    .trim()\n    .split(/\\s+/)\n    .filter(Boolean);\n  return words.map(function(word, index) {\n    const lower = word.toLowerCase();\n    if (acronyms[lower]) return acronyms[lower];\n    if (index > 0 && /^(and|or|of|in|to|for)$/.test(lower)) return lower;\n    return lower.charAt(0).toUpperCase() + lower.slice(1);\n  }).join(\" \");\n}\n\nfunction displayText(value) {\n  if (value === undefined || value === null) return \"\";\n  if (typeof value === \"object\") {\n    try {\n      return JSON.stringify(value);\n    } catch (error) {\n      return String(value);\n    }\n  }\n  return String(value).trim();\n}\n\nfunction normalizedNumber(value) {\n  const text = String(value === undefined || value === null ? \"\" : value).replace(/,/g, \"\").trim();\n  if (!/^-?\\d+(?:\\.\\d+)?$/.test(text)) return \"\";\n  const numberValue = Number(text);\n  if (!isFinite(numberValue)) return \"\";\n  return numberValue.toFixed(2).replace(/\\.00$/, \"\").replace(/(\\.\\d)0$/, \"$1\");\n}\n\nfunction monetaryValue(value, currencyCode) {\n  const text = displayText(value);\n  const currency = displayText(currencyCode);\n  const tokenMatch = text.match(/^\\{amount:\\s*(-?[\\d,]+(?:\\.\\d+)?)\\s*,\\s*currency:[^}]*\\}$/i);\n  const rawAmount = tokenMatch ? tokenMatch[1] : text;\n  const amount = normalizedNumber(rawAmount);\n  if (!amount || !currency) return text;\n  return \"{amount:\" + amount + \",currency:\" + currency + \"}\";\n}\n\nfunction dateValue(value) {\n  const text = displayText(value);\n  const tokenMatch = text.match(/^\\{date:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*\\}$/);\n  if (tokenMatch) return \"{date:\" + tokenMatch[1] + \"}\";\n  const isoMatch = text.match(/^(\\d{4}-\\d{2}-\\d{2})(?:[T\\s].*)?$/);\n  return isoMatch ? \"{date:\" + isoMatch[1] + \"}\" : text;\n}\n\nfunction cellValue(row, column) {\n  const raw = row.values[column.key];\n  if (isMonetaryKey(column.key)) return monetaryValue(raw, row.currencyCode);\n  if (isDateKey(column.key)) return dateValue(raw);\n  if (/number|code/.test(normalizeKey(column.key))) return displayText(raw);\n  const numeric = normalizedNumber(raw);\n  return numeric || displayText(raw);\n}\n\nconst sourceRows = chooseRows(extractData);\nconst columnByKey = {};\nconst columns = [];\nconst suppressedColumnKeys = {};\n\nconst preparedRows = sourceRows.map(function(sourceRow) {\n  const flattened = {};\n  const fieldMetadata = {};\n  flattenRecord(sourceRow, flattened, fieldMetadata, \"\", 0);\n  const row = {\n    values: flattened,\n    currencyCode: displayText(flattened.currencyCode)\n  };\n  const keys = Object.keys(flattened);\n  for (let i = 0; i < keys.length; i++) {\n    const key = keys[i];\n    const value = flattened[key];\n    const suppress = Boolean(fieldMetadata[key] && fieldMetadata[key].suppress);\n    if (suppress) suppressedColumnKeys[key] = true;\n    if (!suppress && hasMeaningfulValue(value) && !columnByKey[key]) {\n      const column = {\n        key: key,\n        heading: labelFromKey(key)\n      };\n      columnByKey[key] = true;\n      columns.push(column);\n    }\n  }\n  return row;\n});\n\nfor (let i = columns.length - 1; i >= 0; i--) {\n  if (suppressedColumnKeys[columns[i].key]) {\n    columns.splice(i, 1);\n  }\n}\n\nconst rows = preparedRows.map(function(row) {\n  const outputRow = {};\n  for (let i = 0; i < columns.length; i++) {\n    outputRow[columns[i].key] = cellValue(row, columns[i]);\n  }\n  return outputRow;\n});\n\nconst result = {\n  recordCount: sourceRows.length,\n  rows: rows,\n  summaryColumns: columns.map(function(column) { return column.heading; })\n};\nreturn result;\n"
          },
          "outcomes": {
            "success": "3"
          },
          "code": "PREPARE_RELEVANT_PROJECT_DATA",
          "id": "2",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.75,
                "temperature": 0.01,
                "reasoning_effort": "low"
              },
              "code": "ORA_LLM_MODEL_PROVIDER_CERT_BASIC_LLAMA_3_3_70B",
              "model": "ORA_LLM_MODEL_GPT_OSS_120B",
              "modelName": "GPT OSS 120B (Basic)",
              "provider": "CERT_BASIC"
            },
            "description": "Generates a concise plain-text project performance insight while preserving currency codes supplied in prepared monetary values.",
            "name": "Generate Correlated Summary"
          },
          "outcomes": {
            "success": "4"
          },
          "code": "GENERATE_CORRELATED_SUMMARY",
          "id": "3",
          "inputs": [
            {
              "id": "3_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "You are a concise Oracle Fusion Project Management insight analyst. Use only the provided chat input and project performance information. Explain important changes, risks, and trends across cost, budget, forecast, commitment, margin, billing, and collections when those facts are present. Do not invent facts, mention internal tool names, or include identifier fields in the narrative. Refer to projects by Project Name or Project Number. Return only plain summary text. Preserve monetary values exactly as supplied in the form {amount:<number>,currency:<currency_code>}. Each currency code comes directly from the Currency Code field supplied with its extracted record; do not alter, infer, or replace it. Use the complete number with at most two decimal places, no grouping commas, no trailing zeroes, and no K, M, B, or T abbreviations.\n"
            },
            {
              "id": "3_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Generate a concise business insight for Oracle Fusion Project Management project performance information.\n\nCHAT INPUT:\n{{$context.$system.$inputMessage}}\n\nPROJECT PERFORMANCE INFORMATION:\nRows:\n{{$context.$nodes.PREPARE_RELEVANT_PROJECT_DATA.$output.result.rows}}\n\nColumns:\n{{$context.$nodes.PREPARE_RELEVANT_PROJECT_DATA.$output.result.summaryColumns}}\n\nTASK:\n- Write 1-2 concise business insight paragraphs using Oracle Fusion Project Management terminology.\n- Explain what changed, why it matters, and where stakeholder attention may be needed.\n- Highlight risks and trends across cost, budget, forecast, commitment, margin, billing, and collections only when those fields are present.\n- Summarize all supplied records without repeating the same facts.\n- Do not display, cite, or mention identifier fields. Refer to projects by Project Name or Project Number.\n- Do not create a table; a deterministic code node creates it from the supplied records.\n- Do not mention internal implementation details or data-transfer terminology.\n- Do not begin with the word \"Summary\".\n- Preserve monetary values exactly as supplied in Rows using {amount:<number>,currency:<currency_code>}. Each currency code comes directly from the Currency Code field supplied with its extracted record; do not alter, infer, or replace it. Use the complete number with at most two decimal places, no grouping commas, no trailing zeroes, and no K, M, B, or T abbreviations.\n- When records are present, provide at least 50 words of useful explanation.\n- When Rows is empty, return exactly: This monitoring prompt is no longer applicable, as no entities currently satisfy it.\n\nOUTPUT RULES:\n- Return only plain text.\n- Do not return markup, a structured object, a heading, a list, or a table.\n"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "description": "Returns a simplified two-item array containing the generated summary and sanitized project table data.",
            "name": "Finalize Correlated Summary",
            "returnType": "array",
            "sourceCode": "const prepared = ($context.$nodes.PREPARE_RELEVANT_PROJECT_DATA.$output &&\n  $context.$nodes.PREPARE_RELEVANT_PROJECT_DATA.$output.result) || {};\nconst summaryOutput = $context.$nodes.GENERATE_CORRELATED_SUMMARY.$output;\nconst noRecordsMessage = \"This monitoring prompt is no longer applicable, as no entities currently satisfy it.\";\n\nfunction collectText(value, pieces, depth) {\n  if (depth > 8 || value === undefined || value === null) return;\n  if (typeof value === \"string\") {\n    const trimmed = value.trim();\n    if (/^[\\[{]/.test(trimmed)) {\n      try {\n        const parsed = JSON.parse(trimmed);\n        if (parsed !== value) {\n          collectText(parsed, pieces, depth + 1);\n          return;\n        }\n      } catch (error) {\n        // Treat non-JSON model output as summary text.\n      }\n    }\n    if (trimmed) pieces.push(trimmed);\n    return;\n  }\n  if (typeof value !== \"object\") return;\n  if (Array.isArray(value)) {\n    for (let i = 0; i < value.length; i++) {\n      collectText(value[i], pieces, depth + 1);\n    }\n    return;\n  }\n  const preferred = [\"text\", \"content\", \"message\", \"output\", \"result\", \"answer\", \"generatedText\", \"reply\"];\n  let foundPreferred = false;\n  for (let i = 0; i < preferred.length; i++) {\n    if (value[preferred[i]] !== undefined) {\n      foundPreferred = true;\n      collectText(value[preferred[i]], pieces, depth + 1);\n    }\n  }\n  if (foundPreferred) return;\n  const keys = Object.keys(value);\n  for (let i = 0; i < keys.length; i++) {\n    collectText(value[keys[i]], pieces, depth + 1);\n  }\n}\n\nfunction removeToolNames(value) {\n  return String(value || \"\")\n    .replace(/\\bBOSS\\s+Extract\\s+identified\\b/gi, \"The project performance information indicates\")\n    .replace(/\\bBOSS\\s+Extract\\s+shows\\b/gi, \"The project performance information shows\")\n    .replace(/\\bBOSS\\s+Extract\\b/gi, \"project performance information\")\n    .replace(/\\bBOSS\\s+extraction\\b/gi, \"project performance review\")\n    .replace(/\\bBOSS\\s+extract\\b/gi, \"project performance information\");\n}\n\nfunction applyBusinessLanguage(value) {\n  return String(value || \"\")\n    .replace(/\\bdataset\\b/gi, \"project performance information\")\n    .replace(/\\bextracted project information\\b/gi, \"project performance information\")\n    .replace(/\\bproject information result\\b/gi, \"project performance information\")\n    .replace(/\\bextract result\\b/gi, \"project information\")\n    .replace(/\\bJSON\\b/g, \"project information\")\n    .replace(/\\bbusiness input\\b/gi, \"project information\")\n    .replace(/\\bbackend\\b/gi, \"application\")\n    .replace(/\\bendpoint result\\b/gi, \"service result\");\n}\n\nfunction polishSummary(value) {\n  let text = String(value || \"\")\n    .replace(/```(?:json|text)?/gi, \" \")\n    .replace(/<[^>]*>/g, \" \")\n    .replace(/^\\s*(?:#+\\s*)?summary\\s*(?:[:.\\-]\\s*|\\s+)/i, \"\")\n    .replace(/\\s+/g, \" \")\n    .replace(/\\s+([.;,!?])/g, \"$1\")\n    .replace(/^[\\s;,.\\-]+/, \"\")\n    .trim();\n  if (!text) return \"\";\n  text = text.replace(/^([a-z])/, function(character) { return character.toUpperCase(); });\n  text = text.replace(/([.!?]\\s+)([a-z])/g, function(match, prefix, character) {\n    return prefix + character.toUpperCase();\n  });\n  if (!/[.!?]$/.test(text)) text += \".\";\n  return text;\n}\n\nconst pieces = [];\ncollectText(summaryOutput, pieces, 0);\nlet summaryText = polishSummary(applyBusinessLanguage(removeToolNames(pieces.join(\" \"))));\nif (Number(prepared.recordCount || 0) === 0) {\n  summaryText = noRecordsMessage;\n} else if (!summaryText) {\n  summaryText = \"The project performance information identifies project entries that may require stakeholder attention.\";\n}\n\nconst rows = Array.isArray(prepared.rows) ? prepared.rows : [];\nconst result = [\n  {\n    title: \"Insight Summary\",\n    type: \"text\",\n    data: summaryText\n  },\n  {\n    title: \"Relevant Information\",\n    type: \"table\",\n    data: {\n      items: rows\n    }\n  }\n];\nreturn result;\n"
          },
          "outcomes": {
            "success": "5"
          },
          "code": "FINALIZE_CORRELATED_SUMMARY",
          "id": "4",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
