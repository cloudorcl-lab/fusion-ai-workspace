        {
          "metadata": {
            "errorNodeId": "1774919332725",
            "name": "mergeReserveAllocated",
            "returnType": "array",
            "sourceCode": "const combinedSorted = []\n  .concat($context.$nodes.GETTASKFOREXPIREDRESERVECONTAINERS.$output.results|| [], $context.$nodes.GETTASKFOREXPIREDRESERVEPALLETCONTAINERS.$output.results || [])\n  .sort((a, b) => {\n    const da = a && a.Expiry ? Date.parse(a.Expiry) : Number.POSITIVE_INFINITY;\n    const db = b && b.Expiry ? Date.parse(b.Expiry) : Number.POSITIVE_INFINITY;\n    return da - db;\n  });\n\nreturn combinedSorted;"
          },
