          "id": "1774301900652",
          "inputs": [
            {
              "id": "1774301900655_1",
              "name": "prompt",
              "type": "string",
              "value": "**Instructions:{instructions}**\nDerive task_nbr from input  \"{{$context.$system.$inputMessage}}\"  message. \"Hold the task <TASK1234>\" then task_nbr = \"TASK1234\"\nStrictly display only the below output to user. Do not provide any followup questions or options and TERMINATE here.\n<strong>Task(s)</strong> {task_nbr} <strong> successfully Held."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "validateTask",
            "returnType": "array",
            "sourceCode": "//EXPIRED INVENTORY tasks only - used to check eligibility\nconst validTaskSet = new Set(\n  [\n    ...($context.$nodes.GETTASKFORALLOCATEDEXPIREDCONTAINERS?.$output?.results ?? []),\n    ...($context.$nodes.GETTASKFORALLOCATEDEXPIREDPALLETCONTAINERS?.$output?.results ?? []),\n    ...($context.$nodes.GETTASKFORALLOCATEDEXPIREDACTIVEINVENTORY?.$output?.results ?? [])\n  ]\n  .map(r => (r && r[\"Task Nbr\"] ? String(r[\"Task Nbr\"]).trim().toUpperCase() : \"\"))\n  .filter(t => t)\n);\n\nconst inputTaskResults = \n  $context.$nodes.GETINPUTTASK?.$output?.results ?? [];\n\nconst existingTaskMap = new Map(\n  inputTaskResults.map(r => [\n    String(r.task_nbr ?? \"\").trim().toUpperCase(), r\n  ])\n);\n\nconst requestedTasks = \n  $context.$nodes.DERIVETASKNBRS?.$output?.task_nbr_list ?? [];\n\nconst seen = new Set();\nconst eligible = [];\nconst noExpiredInventory = [];\nconst notFound = [];\n\nfor (var i = 0; i < requestedTasks.length; i++) {\n  var t = String(requestedTasks[i]).trim().toUpperCase();\n  if (!t || seen.has(t)) continue;\n  seen.add(t);\n\n  if (!existingTaskMap.has(t)) {\n    notFound.push(t);\n  } else if (validTaskSet.has(t)) {\n    eligible.push(t);\n  } else {\n    noExpiredInventory.push(t);\n  }\n}\n\nvar lines = [];\n\nif (eligible.length > 0) {\n  lines.push(\"The following tasks will be placed on hold: \" + eligible.join(\", \") + \".\");\n}\nif (noExpiredInventory.length > 0) {\n  lines.push(\"The following tasks exist but do not have expired inventory assigned: \" + noExpiredInventory.join(\", \") + \". No hold action will be taken for these.\");\n}\nif (notFound.length > 0) {\n  lines.push(\"The following tasks were not found in the system: \" + notFound.join(\", \") + \".\");\n}\n\nreturn {\n  eligible: eligible,\n  no_expired_inventory: noExpiredInventory,\n  not_found: notFound,\n  has_eligible: eligible.length > 0,\n  summary_message: lines.join(\" \")\n};"
          },
          "outcomes": {
            "success": "1774301287216"
          },
          "code": "VALIDATETASK",
          "id": "1774343493799",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "validateOutboundContainer",
            "returnType": "array",
            "sourceCode": "// Build a set of valid container numbers from GETOBEXPIREDINVENTORYCANCEL results (LPN field)\nconst validContainerSet = new Set(\n  (($context.$nodes.GETOBEXPIREDINVENTORYCANCEL.$output.results) || [])\n    .map(r => (r && r[\"LPN\"] ? String(r[\"LPN\"]).trim() : \"\"))\n    .filter(v => v)\n);\n\n// Get container_nbr input (can be single value or comma-separated list)\nconst requestedContainers = String($context.$nodes.DERIVEOBCONTAINER.$output.container_nbr || \"\")\n  .split(\",\")\n  .map(s => s.trim())\n  .filter(Boolean);\n\n// Keep order from input, remove duplicates, keep only containers that exist in results\nconst seen = new Set();\nconst filtered = [];\nfor (let i = 0; i < requestedContainers.length; i++) {\n  const c = requestedContainers[i];\n  if (validContainerSet.has(c) && !seen.has(c)) {\n    filtered.push(c);\n    seen.add(c);\n  }\n}\n\n// Return in the same format:  \"LPN1\",\"LPN2\"\nreturn filtered.length ? filtered.map(c => `\"${c}\"`).join(\",\") : null;"
          },
          "outcomes": {
            "success": "1773848168465"
          },
          "code": "VALIDATEOUTBOUNDCONTAINER",
          "id": "1774346988641",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "mergeReserveInventory",
            "returnType": "array",
            "sourceCode": "const rows = [\n  ...($context.$nodes.GETRESERVEEXPIREDCONTAINERS.$output.results || []),\n  ...($context.$nodes.GETRESERVEEXPIREDPALLETCONTAINERS.$output.results || [])\n];\n\n// Deduplicate by LPN so the count reflects unique LPNs\nconst seen = new Set();\nconst uniqueRows = [];\n\nfor (const row of rows) {\n  const lpn = (row?.LPN || \"\").trim();\n  if (!lpn || seen.has(lpn)) continue;\n  seen.add(lpn);\n  uniqueRows.push(row);\n}\n\nuniqueRows.sort((a, b) => {\n  const da = a?.Expiry ? Date.parse(a.Expiry) : Number.POSITIVE_INFINITY;\n  const db = b?.Expiry ? Date.parse(b.Expiry) : Number.POSITIVE_INFINITY;\n  return da - db;\n});\n\nreturn {\n  result: uniqueRows,\n  total_lpn_count: uniqueRows.length\n};"
          },
          "outcomes": {
            "success": "1765818816564"
          },
          "code": "MERGERESERVEINVENTORY",
          "id": "1774524535490",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
