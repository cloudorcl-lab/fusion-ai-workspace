        {
          "metadata": {
            "description": "Parses and normalizes the incoming user message into structured input for downstream retrieval.",
            "name": "Parse Input Message",
            "returnType": "string",
            "sourceCode": "let inputMessage = $context.$system.$inputMessage;\ntry {\n    inputMessage = inputMessage.replace(/<[^>]*>/g, \"\");\n    inputMessage = inputMessage.replace(/\\\\*\"/g, \"'\");\n    inputMessage = inputMessage.replace(\n        /(?:\\u202F|\\u00A0|\\u0000|[\\x00-\\x1F]|[“”‘’]|\\\\u[0-9A-Fa-f]{4})/g,\n        \" \"\n    );\n    return inputMessage.replace(/\\s+/g, \" \").trim();\n} catch (error) {\n    inputMessage = $context.$system.$inputMessage;\n}\n\nreturn inputMessage;"
          },
          "outcomes": {
            "success": "1777369391220"
          },
          "code": "PARSEINPUT",
          "id": "1771326758001",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 5695,
            "y": 5206
