        {
          "metadata": {
            "description": "Builds category search parameters from classification output.",
            "errorNodeId": "1771331063702",
            "name": "Generate Search Param for Category",
            "returnType": "string",
            "sourceCode": "const input = $context.$triggers.REST.$input || {};\nconst classificationOutput = $context.$nodes.CLASSIFICATION.$output || {};\n\nconst stripeCd = input['objectType'] === 'HRHelpDeskRequest' ? 'ORA_SVC_HCM' : input['objectType'] === 'InternalServiceRequest' ? 'ORA_SVC_ISR' : 'ORA_SVC_CRM';\nconst category = classificationOutput['category'] || '';\nconst buId = input['srBU'] || '';\n\nif (buId != '') {\n  return `(StripeCd = '${stripeCd}') and (CSSFlag = true) and (BUOrgId = '${buId}') and (EnabledFlag = true) and (CategoryName = '${category}' or CategoryCode = '${category}')`;\n}\n\nreturn `(StripeCd = '${stripeCd}') and (CSSFlag = true) and (EnabledFlag = true) and (CategoryName = '${category}' or CategoryCode = '${category}')`;"
          },
          "outcomes": {
            "success": "1771331063702"
          },
