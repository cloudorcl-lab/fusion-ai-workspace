        {
          "metadata": {
            "description": "Builds the final classification payload from resolved category and product data.",
            "errorNodeId": "1768909855065",
            "name": "Format Classification Output",
            "returnType": "object",
            "sourceCode": "const llmOutput = {};\nllmOutput['severity'] = $context.$nodes.CLASSIFICATION.$output.severity;\nllmOutput['sentiment'] = $context.$nodes.CLASSIFICATION.$output.sentiment;\nllmOutput['inventoryItemId'] = $context.$nodes.FETCHPRODUCTDETAILSINVENTORY.$output?.items[0] && $context.$nodes.FETCHPRODUCTDETAILSINVENTORY.$output.items[0].InventoryItemId ? $context.$nodes.FETCHPRODUCTDETAILSINVENTORY.$output.items[0].InventoryItemId : '';\nllmOutput['productGroupId'] = $context.$nodes.FETCHPRODUCTGROUPID.$output?.items[0] && $context.$nodes.FETCHPRODUCTGROUPID.$output.items[0].ProductGroupId ? $context.$nodes.FETCHPRODUCTGROUPID.$output.items[0].ProductGroupId : '';\nllmOutput['categoryCode'] = $context.$nodes.GETCATEGORYCODE.$output?.items[0] && $context.$nodes.GETCATEGORYCODE.$output.items[0].CategoryCode ? $context.$nodes.GETCATEGORYCODE.$output.items[0].CategoryCode : '';\nif( llmOutput['categoryCode'] == '') {\n  llmOutput['category'] = '';\n} else {\n  llmOutput['category'] = $context.$nodes.CLASSIFICATION.$output.category;\n}\nif( llmOutput['productGroupId'] == '' && llmOutput[ 'inventoryItemId'] == '') {\n  llmOutput['product'] = '';\n} else {\n  llmOutput['product'] = $context.$nodes.CLASSIFICATION.$output.product;\n}\nreturn llmOutput;"
          },
          "outcomes": {
            "success": "1768909855065"
          },
          "code": "FORMAT_CLASSIFICATION_OUTPUT",
          "id": "1768909598679",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
