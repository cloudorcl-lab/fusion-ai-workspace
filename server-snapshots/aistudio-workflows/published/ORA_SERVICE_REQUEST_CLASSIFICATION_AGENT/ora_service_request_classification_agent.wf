            "y": 7052.556807271535
          }
        },
        {
          "metadata": {
            "description": "Builds product group search parameters from classification output.",
            "errorNodeId": "1771329268774",
            "name": "Get Search param for Product Group",
            "returnType": "string",
            "sourceCode": "const input = $context.$triggers.REST.$input || {};\nconst classificationOutput = $context.$nodes.CLASSIFICATION.$output || {};\n\nconst product = classificationOutput['product'] || '';\nconst usageCode = input['productUsage'] && input['productUsage'] != 'null' ? input['productUsage'] : '';\n\nreturn `UsageCode='${usageCode}' and ProductGroupName = '${product}'`;"
