  "workflowCode": "ORA_SERVICE_REQUEST_CLASSIFICATION_AGENT",
  "name": "Service Request Classification Agent",
  "description": "The Service Request Classification Workflow performs classification to find the right category, product, severity and sentiment for the service request.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
