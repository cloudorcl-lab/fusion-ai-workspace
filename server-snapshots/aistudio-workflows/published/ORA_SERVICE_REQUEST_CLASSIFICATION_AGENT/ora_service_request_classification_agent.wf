        {
          "metadata": {
            "description": "Builds product item search parameters from classification output.",
            "errorNodeId": "1771328568713",
            "name": "Get Search Param for Product Item",
            "returnType": "string",
            "sourceCode": "const input = $context.$triggers.REST.$input || {};\nconst classificationOutput = $context.$nodes.CLASSIFICATION.$output || {};\n\nconst product = classificationOutput['product'] || '';\nconst usageCode = input['productUsage'] && input['productUsage'] != 'null' ? input['productUsage'] : '';\n\nreturn `UsageCode='${usageCode}' and Description = '${product}'`;"
          },
          "outcomes": {
            "success": "1771328568713"
          },
          "code": "GET_SEARCH_PARAM_FOR_PRODUCT_ITEM",
          "id": "1775552700340",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
