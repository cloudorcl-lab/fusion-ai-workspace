          "metadata": {
            "name": "Get Action Plan To Be Cancelled",
            "returnType": "string",
            "sourceCode": "const actionPlans = $context.$nodes.GET_ACTION_PLAN_BY_OBJECTD.$output \nconst items = actionPlans?.items || [];\nconst workflowCode = $context.$workflow.$name;\nconst canceledActionPlanStatusCd = \"ORA_SVC_CANCELED\";\nconst completedActionPlanStatusCd = \"ORA_SVC_COMPLETED\";\n\nconst actionPlanToBeCanceled = items\n  .filter(item =>  item.StatusCd && !item.StatusCd.includes(canceledActionPlanStatusCd) && !item.StatusCd.includes(completedActionPlanStatusCd)  && item.Message && item.Message.includes(workflowCode))\n  .sort((a, b) => new Date(b.CreationDate) - new Date(a.CreationDate))\n  .map(item => item.ActionPlanNumber)[0] || \"\";\n\nreturn actionPlanToBeCanceled;"
          },
          "outcomes": {
            "success": "1772680561257"
          },
          "code": "GET_ACTION_PLAN_TO_BE_CANCELLED",
          "convergenceTargetId": "1772680561257",
          "id": "1772681004190",
          "inputs": [],
