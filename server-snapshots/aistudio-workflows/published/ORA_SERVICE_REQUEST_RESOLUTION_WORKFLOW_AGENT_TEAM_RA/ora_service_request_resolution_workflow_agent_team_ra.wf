        {
          "metadata": {
            "name": "Set Final Resolution Code",
            "returnType": "object",
            "sourceCode": "let result;\n\nif ($context.$triggers.REST.$input.publishResolution && $context.$variables.isRerun) {\n\n return $context.$variables.lastResponse;\n}\n\nif ($context.$variables.useProductAgent) {\n  result = $context.$nodes.FORMAT_PRODUCT_AGENT_RESULT.$output;\n  if ($context.$variables.lastShortSummary != \"\" && result.Explanation != \"\") {\n      result.shortSummary = $context.$variables.lastShortSummary;\n      result.Summary = $context.$variables.lastSummary;\n      result.ObjectKey = $context.$variables.lastObjectKey;\n  }\n} else {\n  result = JSON.parse($context.$nodes.RESOLUTION_AGENT.$output.output).result;\n  if ($context.$variables.lastShortSummary != \"\" && result.Explanation != \"\") {\n      result.shortSummary = $context.$variables.lastShortSummary;\n      result.Summary = $context.$variables.lastSummary;\n      result.ObjectKey = $context.$variables.lastObjectKey;\n  }\n}\nreturn result;"
          },
          "outcomes": {
            "success": "1765343271837"
          },
          "code": "SET_FINAL_RESOLUTION_CODE",
          "id": "1770797402258",
          "inputs": [],
