          "metadata": {
            "errorNodeId": "1775785661624",
            "name": "Format SR Data",
            "returnType": "string",
            "sourceCode": "if (\n  $context.$nodes.GET_SR_DATA.$status === \"failure\" ||\n   $context.$nodes.GET_SR_MESSAGES.$status === \"failure\"\n) {\n  throw new Error(\"GET_SR_DATA OR GET_SR_MESSAGES CALL FAILED\");\n}\n\n\nconst objectContext = $context.$triggers.REST.$input.objectContext;\n\n//Inline null / empty check (Agent Studio–safe)\nif (\n  objectContext !== null &&\n  objectContext !== undefined &&\n  objectContext !== \"\"\n) {\n  return objectContext;\n}\n\n// ---------- Fallback logic ----------\nconst srAttributesRaw = $context.$nodes.GET_SR_DATA.$output;\n\nconst srAttributes =\n  srAttributesRaw && srAttributesRaw.content\n    ? srAttributesRaw.content\n    : (srAttributesRaw || {});\n\nconst messagesResponse = $context.$nodes.GET_SR_MESSAGES.$output;\n\nconst result = {};\n\n// Copy SR attributes except @context\nfor (const key in srAttributes) {\n  if (key !== \"@context\") {\n    result[key] = srAttributes[key];\n  }\n}\n\nconst items = messagesResponse?.items || [];\n\n// Flatten messages\nconst flattenedMessages = items.map(m => {\n  const sender = m?.MessageTypeCd\n    ? (m.MessageTypeCd.includes(\"CUSTOMER\") ? \"Customer\"\n      : m.MessageTypeCd.includes(\"RESPONSE\") ? \"Agent\"\n      : \"System\")\n    : \"Unknown\";\n\n  const timestamp = m?.CreationDate || \"\";\n\n  const text = m?.MessageContent\n    ? m.MessageContent.replace(/<[^>]+>/g, \"\").trim()\n    : \"\";\n\n  return `${sender}${timestamp ? \" (\" + timestamp + \")\" : \"\"}: ${text}`;\n});\n\nresult.Messages = flattenedMessages;\nresult.MessageCount = flattenedMessages.length;\n\nreturn \"\" + JSON.stringify(result, null, 2);"
          },
          "outcomes": {
            "success": "1766367932383"
          },
