            "sourceCode": "let data = $context.$nodes.GET_SR_DATA.$output\nlet fields = $context.$variables.srTemplate \n\n// If srTemplate is missing, null, or empty → no invalid fields\nif (!fields || typeof fields !== 'string' || fields.trim() === '') {\n  return []\n}\n\nlet fieldArray = fields.split(',').map(f => f.trim())\nlet invalidFields = fieldArray.filter(\n  f => data[f] == null || data[f] === \"\"\n)\n\nreturn invalidFields"
