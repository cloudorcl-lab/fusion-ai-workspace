        {
          "metadata": {
            "name": "Create HTML format messages for triage",
            "returnType": "string",
            "sourceCode": "const output = $context?.$nodes?.FORMMESSAGE?.$output?.result?.output || {};\n\n\n\nconst summary = output.Summary || \"No summary available\";\nlet referenceInfo = output.listOfArticles || \"\";\nlet similarSR = output.listOfSimilarSrs || \"\";\n\n\nlet rawSuggestions = $context?.$nodes?.CLASSIFICATION_WORKFLOW_AGENT?.$output;\n\nif (typeof rawSuggestions !== \"string\") {\n  rawSuggestions = JSON.stringify(rawSuggestions || \"\");\n}\n\nconst safeSummary = String(summary)\n  .replace(/&/g, \"&amp;\")\n  .replace(/</g, \"&lt;\")\n  .replace(/>/g, \"&gt;\");\n\n\nif (referenceInfo && similarSR) {\n  referenceInfo = referenceInfo + \",\" + similarSR;\n} else if (similarSR) {\n  referenceInfo = similarSR;\n}\n\n\nlet formattedReferences = \"\";\n\nif (referenceInfo) {\n  referenceInfo = String(referenceInfo);\n  const parts = referenceInfo.split(\",\");\n\n  let links = [];\n\n  for (let i = 0; i < parts.length; i++) {\n    const id = parts[i].trim();\n\n    if (id) {\n      const safeId = id\n        .replace(/&/g, \"&amp;\")\n        .replace(/</g, \"&lt;\")\n        .replace(/>/g, \"&gt;\");\n\n      links.push(`<span class=\"internal_dynlink\" external-doc-id=\"${safeId}\" lang=\"en\">${safeId}</span>`);\n    }\n  }\n\n  if (links.length > 0) {\n    formattedReferences = links.join(\", \");\n  }\n}\n\n\nlet suggestionsText = \"\";\n\nif (rawSuggestions) {\n  try {\n    \n    const level1 = JSON.parse(rawSuggestions);\n\n    \n    const level2 = level1.output ? JSON.parse(level1.output) : {};\n\n    let parts = [];\n\n    if (level2.severity) {\n      parts.push(\"Severity: \" + level2.severity);\n    }\n\n    if (level2.sentiment) {\n      parts.push(\"Sentiment: \" + level2.sentiment);\n    }\n\n    if (level2.category) {\n      parts.push(\"Category: \" + level2.category);\n    }\n\n    if (level2.product) {\n      parts.push(\"Product: \" + level2.product);\n    }\n\n    if (parts.length > 0) {\n      suggestionsText = parts.join(\"<br>\");\n    }\n\n  } catch (e) {\n    // silent fail\n  }\n}\n\n\nlet htmlMessage = `\n\n<b>Summary</b>\n<p>${safeSummary}</p>\n\n<b>What Actions Were Taken</b>\n<p>An action plan \"Triage plan\"  has been created for review.</p>\n`;\n\n\nif (formattedReferences) {\n  htmlMessage += `\n<b>Reference Information</b>\n<p>${formattedReferences}</p>\n`;\n}\n\n\nif (suggestionsText) {\n  htmlMessage += `\n<b>Suggestions</b>\n<p>${suggestionsText}</p>\n`;\n}\n\nreturn htmlMessage;"
          },
          "outcomes": {
            "success": "1772254448259"
          },
          "code": "CREATE_HTML_FORMAT_MESSAGES_FOR_TRIAGE",
          "id": "1775713501078",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Create HTML format messages for resolution",
            "returnType": "string",
            "sourceCode": "const output = $context?.$nodes?.FORMMESSAGE?.$output?.result?.output || {};\n\nconst summary = output.Summary || \"Summary Could not be fetched\";\nlet referenceInfo = output.listOfArticles || \"\";\nlet similarSR = output.listOfSimilarSrs || \"\"; \n\nconst safeSummary = String(summary)\n  .replace(/&/g, \"&amp;\")\n  .replace(/</g, \"&lt;\")\n  .replace(/>/g, \"&gt;\");\n\n\nif (referenceInfo && similarSR) {\n  referenceInfo = referenceInfo + \",\" + similarSR;\n} else if (similarSR) {\n  referenceInfo = similarSR;\n}\n\nlet formattedReferences = \"\";\n\nif (referenceInfo) {\n\n  referenceInfo = String(referenceInfo);\n\n  const parts = referenceInfo.split(\",\");\n\n  let links = [];\n\n  for (let i = 0; i < parts.length; i++) {\n    const id = parts[i].trim();\n\n    if (id) {\n      const safeId = id\n        .replace(/&/g, \"&amp;\")\n        .replace(/</g, \"&lt;\")\n        .replace(/>/g, \"&gt;\");\n\n      links.push(`<span class=\"internal_dynlink\" external-doc-id=\"${safeId}\" lang=\"en\">${safeId}</span>`);\n    }\n  }\n\n  if (links.length > 0) {\n    formattedReferences = links.join(\", \");\n  }\n}\n\n\nlet htmlMessage;\n\nif (output.ObjectType === \"WorkOrder\" || output.Summary === \"No relevant resolution found\" || output.Summary === \"Summary Could not be fetched\") {\n  htmlMessage = `\n<b>Summary</b>\n<p>${safeSummary}</p>\n`;\n} \nelse if (output.ObjectType=== \"ActionPlanTemplate\" &&  output.ObjectKey!= null){\n htmlMessage = `\n<b>Summary</b>\n<p>${safeSummary}</p>\n\n<b>What Actions Were Taken</b>\n<p>An action plan \"Recommended Plan\" has been created for review.</p>\n\n`;\n}\nelse {\n  htmlMessage = `\n<b>Summary</b>\n<p>${safeSummary}</p>\n\n<b>What Actions Were Taken</b>\n<p>An action plan \"Resolution Plan\" has been created for review.</p>\n`;\n}\n\nif (formattedReferences) {\n  htmlMessage += `\n<b>Reference Information</b>\n<p>${formattedReferences}</p>\n`;\n}\n\nreturn htmlMessage;"
          },
          "outcomes": {
            "success": "1765826263739"
          },
          "code": "CREATE_HTML_FORMAT_MESSAGES_FOR_RESOLUTION",
          "convergenceTargetId": "1765826263739",
          "id": "1775713639696",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
