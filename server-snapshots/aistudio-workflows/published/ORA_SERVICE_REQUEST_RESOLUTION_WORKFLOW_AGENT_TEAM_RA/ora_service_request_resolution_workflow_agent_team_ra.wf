            "name": "create html  message for error",
            "returnType": "string",
            "sourceCode": "let node;\n\nif ( $context.$nodes.GET_SR_DATA.$status === \"failure\") {\n    node = $context.$nodes.GET_SR_DATA;\n}\nelse if ( $context.$nodes.GET_SR_MESSAGES.$status === \"failure\") {\n    node = $context.$nodes.GET_SR_MESSAGES;\n}\nelse if ( $context.$nodes.CREATE_TRIAGE_PLAN.$status === \"failure\") {\n    node = $context.$nodes.CREATE_TRIAGE_PLAN;\n}\nelse if ( $context.$nodes.REQUEST_DETAILS_AP_ENGAGEMENT_METRICS.$status === \"failure\") {\n    node = $context.$nodes.REQUEST_DETAILS_AP_ENGAGEMENT_METRICS;\n}\nelse if ( $context.$nodes.REQUEST_INPUT_DETAILS.$status === \"failure\") {\n    node = $context.$nodes.REQUEST_INPUT_DETAILS;\n}\nelse if ( $context.$nodes.REOPEN_SR_NO_RESOLUTION.$status === \"failure\") {\n    node = $context.$nodes.REOPEN_SR_NO_RESOLUTION;\n}\nelse if ( $context.$nodes.CREATE_NO_RESOLUTION_MESSAGE.$status === \"failure\") {\n    node = $context.$nodes.CREATE_NO_RESOLUTION_MESSAGE;\n}\nelse if ( $context.$nodes.GET_ACTION_PLAN_BY_OBJECTD.$status === \"failure\") {\n    node = $context.$nodes.GET_ACTION_PLAN_BY_OBJECTD;\n}\nelse if ( $context.$nodes.REOPEN_SR.$status === \"failure\") {\n    node = $context.$nodes.REOPEN_SR;\n}\nelse if ( $context.$nodes.CANCEL_ACTION_PLAN.$status === \"failure\") {\n    node = $context.$nodes.CANCEL_ACTION_PLAN;\n}\nelse if ( $context.$nodes.CREATE_MESSAGE.$status === \"failure\") {\n    node = $context.$nodes.CREATE_MESSAGE;\n}\nelse if ( $context.$nodes.CREATE_ACTION_PLAN.$status === \"failure\") {\n    node = $context.$nodes.CREATE_ACTION_PLAN;\n}\nelse if ( $context.$nodes.SEND_AGENT_RESPONSE.$status === \"failure\") {\n    node = $context.$nodes.SEND_AGENT_RESPONSE;\n}\nelse if ( $context.$nodes.RESOLVE_SERVICE_REQUEST.$status === \"failure\") {\n    node = $context.$nodes.RESOLVE_SERVICE_REQUEST;\n}\n\n\nconst summary = node?.$error?.$info || \"\";\nconst status = node?.$status || \"\";\n\n\nconst summaryText = `${summary}`;\n\nlet htmlMessage = `\n<b>Summary</b>\n<p>We couldn’t complete the request because a required detail could not be retrieved. Please contact your administrator.</p>\n\n<b>Error Details: </b>\n<p>\n-info: ${summaryText}<br>\n-status: ${status}<br>\n</p>\n\n<b>What actions were taken: </b>\n<p>No action was taken.</p>\n`;\n\nreturn htmlMessage;"
          },
          "outcomes": {
            "success": "1775785686950"
          },
          "code": "CREATE_HTML_MESSAGE_FOR_ERROR",
