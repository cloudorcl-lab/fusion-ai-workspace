            "name": "returnRequestMoreInfo",
            "returnType": "object",
            "sourceCode": "if (\n  $context.$nodes.CREATE_TRIAGE_PLAN.$status === \"failure\" ||\n  $context.$nodes.REQUEST_DETAILS_AP_ENGAGEMENT_METRICS.$status === \"failure\" ||\n   $context.$nodes.REQUEST_INPUT_DETAILS.$status === \"failure\"\n) {\n  throw new Error(\"CREATE_TRIAGE_PLAN OR REQUEST_DETAILS_AP_ENGAGEMENT_METRICS OR REQUEST_INPUT_DETAILS CALL FAILED\");\n}\n\n\nvar moreInfo = $context.$nodes.FORMMESSAGE.$output.result.output;\n\nvar iteration = $context.$variables.iteration \n\nvar output = {\n  \"output\": moreInfo,\n  \"iteration\": iteration,\n  \"status\": 'ask'\n};\n\nreturn output"
          },
