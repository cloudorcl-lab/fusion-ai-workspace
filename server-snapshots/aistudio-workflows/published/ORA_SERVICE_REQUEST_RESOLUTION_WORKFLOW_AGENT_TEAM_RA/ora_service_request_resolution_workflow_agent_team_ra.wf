        {
          "metadata": {
            "name": "Create HTML format messages for no resolution",
            "returnType": "string",
            "sourceCode": "const output = $context?.$nodes?.FORMMESSAGE?.$output?.result?.output || {};\n\nconst summary = \"No relevant resolution found.\" ;\nlet referenceInfo = output.listOfArticles || \"\";\nlet similarSR = output.listOfSimilarSrs || \"\"; \n\nconst safeSummary = String(summary)\n  .replace(/&/g, \"&amp;\")\n  .replace(/</g, \"&lt;\")\n  .replace(/>/g, \"&gt;\");\n\n\nif (referenceInfo && similarSR) {\n  referenceInfo = referenceInfo + \",\" + similarSR;\n} else if (similarSR) {\n  referenceInfo = similarSR;\n}\n\nlet formattedReferences = \"\";\n\nif (referenceInfo) {\n\n  referenceInfo = String(referenceInfo);\n\n  const parts = referenceInfo.split(\",\");\n\n  let links = [];\n\n  for (let i = 0; i < parts.length; i++) {\n    const id = parts[i].trim();\n\n    if (id) {\n      const safeId = id\n        .replace(/&/g, \"&amp;\")\n        .replace(/</g, \"&lt;\")\n        .replace(/>/g, \"&gt;\");\n\n      links.push(`<span class=\"internal_dynlink\" external-doc-id=\"${safeId}\" lang=\"en\">${safeId}</span>`);\n    }\n  }\n\n  if (links.length > 0) {\n    formattedReferences = links.join(\", \");\n  }\n}\n\n\nlet htmlMessage = `\n<b>Summary</b>\n<p>${safeSummary}</p>\n`;\n\n\nif (formattedReferences) {\n  htmlMessage += `\n<b>Reference Information</b>\n<p>${formattedReferences}</p>\n`;\n}\n\nreturn htmlMessage;"
          },
          "outcomes": {
            "success": "1766110012912"
          },
          "code": "CREATE_HTML_FORMAT_MESSAGES_FOR_NO_RESOLUTION",
          "id": "1775797420021",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
