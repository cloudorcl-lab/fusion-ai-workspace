{
  "workflowId": "300000331068152",
  "workflowCode": "ORA_SERVICE_REQUEST_RESOLUTION_WORKFLOW_AGENT_TEAM_RA",
  "name": "Service Request Resolution Workflow Advisor",
  "description": "Service Request Resolution Workflow is responsible for triggering classification agent and resolution agent.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "End of data pipeline",
            "name": "End"
          },
          "outcomes": {},
          "code": "END",
          "id": "end",
          "inputs": [],
          "type": "END"
        },
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1765249736480"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "name": "Initialize Variable",
            "returnType": "object",
            "sourceCode": "let iteration = 0;\nlet lastStatus = \"\";\n\nlet text = $context.$system.$chatHistory;\nlet conversationContextStr = $context.$triggers.REST.$input.conversationContext;\n\nlet previousShortSummary = \"\";\nlet previousSummary = \"\";\nlet previousObjectKey = \"\";\nlet previousResponse = \"\";\n\nif (text) {\n\n  const iterationMatches = [...text.matchAll(/\"?iteration\"?:\\s*(\\d+)/g)];\n  const statusMatches = [...text.matchAll(/\"?status\"?:\\s*\\\\?\"([^\"\\\\]+)\\\\?\"/g)];\n\n  if (iterationMatches.length > 0) {\n    iteration = Number(iterationMatches.at(-1)[1]);\n    iteration++;\n  }\n\n  if (statusMatches.length > 0) {\n    lastStatus = statusMatches.at(-1)[1];\n  }\n  try {\n      let aiMatches = [...text.matchAll(/AI:\\s*(\\{[\\s\\S]*?\\})(?=\\s*(?:USER:|AI:|$))/g)];\n      if (aiMatches.length > 0) {\n        let lastAiJson = aiMatches[aiMatches.length - 1][1];\n        let lastAiOutput = JSON.parse(lastAiJson);\n\n        previousResponse = lastAiOutput.result?.output ?? \"\";\n        previousShortSummary = lastAiOutput?.result?.output?.shortSummary ?? \"\";\n        previousSummary = lastAiOutput?.result?.output?.Summary ?? \"\";\n        previousObjectKey = lastAiOutput?.result?.output?.ObjectKey ?? \"\";\n      }\n    } catch (e) {\n    }\n  \n}\n\ntry {\n    if (conversationContextStr!=\"\" && previousShortSummary===\"\") {\n        let conversationContext = JSON.parse(conversationContextStr);\n        previousResponse = conversationContext;\n        previousShortSummary = conversationContext?.shortSummary ?? \"\";\n        previousSummary = conversationContext?.Summary ?? \"\";\n        previousObjectKey = conversationContext?.ObjectKey ?? \"\";\n        }\n    } catch (e) {\n}\n\nvar output = {\n  iteration,\n  lastStatus,\n  previousShortSummary,\n  previousSummary,\n  previousObjectKey,\n  previousResponse\n};\n\nreturn output;"
          },
          "outcomes": {
            "success": "1765849428148"
          },
          "code": "INITIALIZE_VARIABLE",
          "convergenceTargetId": "1765238460260",
          "id": "1765249736480",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "If Need Decode Input"
          },
          "outcomes": {
            "true": "1765238460260",
            "false": "1775785625791"
          },
          "code": "IF_NEED_DECODE_INPUT",
          "convergenceTargetId": "end",
          "id": "1765749061503",
          "inputs": [
            {
              "id": "1765749061503_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$variables.lastStatus === 'resolve' && $context.$triggers.REST.$input.persona != 'CSR'}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Is Resolution Approved"
          },
          "outcomes": {
            "true": "1765315438109",
            "false": "1772678984388"
          },
          "code": "IS_RESOLUTION_APPROVED",
          "convergenceTargetId": "end",
          "id": "1765749116105",
          "inputs": [
            {
              "id": "1765749116105_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.DECIDEINTENTUSINGINPUT.$output.Intent === 'Accept'}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Return Approved Resolution"
          },
          "outcomes": {},
          "code": "RETURN_APPROVED_RESOLUTION",
          "convergenceTargetId": "end",
          "id": "1765749156755",
          "inputs": [
            {
              "id": "1765749156757_1",
              "name": "returnValue",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_APPROVED_RESOLUTION.$output.result}}"
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "name": "Decode Input Flow"
          },
          "outcomes": {
            "success": "1765749116105"
          },
          "code": "DECIDEINTENTUSINGINPUT",
          "convergenceTargetId": "1765749103456",
          "id": "1765238460260",
          "inputs": [
            {
              "id": "1765238460262_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an intent-classification agent. Your task is to analyze the user's input and classify it based on the following criteria:\n\n### Rules:\n- Return \"Accept\": The input clearly expresses acceptance, approval, agreement, confirmation, closure, or satisfaction with the solution.\n- Return \"Reject\": The input indicates rejection, dissatisfaction, failure with the solution, persistence of the issue, a request for escalation, a request to create a ticket for escalation, a request to move the issue to another team or support level, or is empty/missing.\n- Return \"Followup\": The input is asking a follow-up question or request without dissatisfaction with the solution, such as seeking further Explanation, clarification, or modification.\n\n### Additional Decision Guidance:\n- If the input asks for escalation or ticket creation for escalation, classify it as \"Reject\" even if dissatisfaction is not stated explicitly.\n- If the input contains both a follow-up request and dissatisfaction with the current solution, classify it as \"Reject\".\n- If the input is empty, null, missing, or has no meaningful content, classify it as \"Reject\".\n\n### Output\nReturn the result in the following JSON format:\n{ \"Intent\": \"<intent>\", \"Reason\": \"<reason for Intent>\" }\n\n### User Input:\n {{$context.$system.$inputMessage}}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"Reason\": {\n            \"type\": \"string\"\n        },\n        \"Intent\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Extract Approved Resolution",
            "returnType": "string",
            "sourceCode": "let chatHistory = $context.$system.$chatHistory;\nlet finalResolution = null;\n\nif (chatHistory) {\n  try {\n    const aiMatches = [...chatHistory.matchAll(/AI:\\s*(\\{.*?\\})(?=(\\nUSER:|$))/gs)];\n\n    if (aiMatches && aiMatches[aiMatches.length - 1][1]) {\n      const parsed = JSON.parse(aiMatches[aiMatches.length - 1][1]);\n\n      finalResolution =\n        parsed?.result?.output?.Summary ||\n        parsed?.result?.output?.shortSummary ||\n        null;\n    }\n  } catch (e) {\n    finalResolution = null;\n  }\n}\n\nreturn finalResolution;"
          },
          "outcomes": {
            "success": "1765749156755"
          },
          "code": "EXTRACT_APPROVED_RESOLUTION",
          "convergenceTargetId": "1765749156755",
          "id": "1765315438109",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
