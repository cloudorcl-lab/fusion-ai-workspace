          "metadata": {
            "name": "Prepare Payload",
            "returnType": "string",
            "sourceCode": "const objectType = $context.$triggers.REST.$input.objectType;\n\nlet statusCd;\n\nif (objectType === \"ServiceRequest\") {\n  statusCd = \"ORA_SVC_RESOLVED\";\n} else if (objectType === \"HRHelpDeskRequest\") {\n  statusCd = \"ORA_SVC_HRHD_RESOLVED\";\n} else if (objectType === \"InternalServiceRequest\") {\n  statusCd = \"ORA_SVC_ISR_RESOLVED\";\n} else {\n  statusCd = null;\n}\n\nconst payload = {\n  StatusCd: statusCd,\n  ResolveDescription: $context.$nodes.SET_FINAL_RESOLUTION_CODE.$output.result.Summary\n};\n\nreturn payload;"
          },
          "outcomes": {
            "success": "1765201194556"
          },
          "code": "PREPARE_PAYLOAD",
          "convergenceTargetId": "1770677369661",
          "id": "1768958525382",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
