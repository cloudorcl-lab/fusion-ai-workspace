            "sourceCode": "const result = {};\n\n\nconst productItem = $context?.$nodes?.FETCH_PRODUCT?.$output?.items?.[0];\nif (productItem?.ProductGroupId != null) {\n  result.ProdGroupId = productItem.ProductGroupId;\n}\n\nconst inventoryItemId = $context.$nodes.FETCH_INVENTORY_ITEM?.$output?.items?.[0];\nif (inventoryItemId?.InventoryItemId != null){\n    result.InventoryItemId = inventoryItemId.InventoryItemId;\n}\n\nreturn result;"
          },
