{
  "workflowId": "300000326919792",
  "workflowCode": "ORA_CHECK_PAYMENT_METHOD_CONFIGURATION",
  "name": "Check Payment Method Configuration",
  "description": "This workflow is responsible to check whether the user in question has the necessary permission and configuration to successfully create an external bank account and payment method. This needs a PersonId to start with and responds with a JSON payload.",
  "specification": {
