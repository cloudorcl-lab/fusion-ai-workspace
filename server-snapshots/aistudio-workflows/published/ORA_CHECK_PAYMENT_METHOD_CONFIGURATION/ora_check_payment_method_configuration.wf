                    "functionName": "getall_employeeOrganizationPaymentMethodsForPaymentType",
                    "processJson": true,
                    "name": "Check Org Pay Method for PR"
                  },
                  "outcomes": {
                    "success": "1771751882611"
                  },
                  "code": "CHECK_ORG_PAY_METHOD_FOR_PR",
                  "id": "1771751538058",
                  "inputs": [
                    {
                      "id": "1771751605076_1",
                      "name": "pPayrollRelationshipId",
                      "type": "string",
                      "value": "{{$context.$nodes.FOR_EACH_PAYREL_CHECK_EFT_OPM.$currentItem.PayrollRelationshipId}}"
                    },
                    {
                      "id": "1771751605077_2",
                      "name": "pPaymentType",
                      "type": "string",
                      "value": "EFT"
                    }
                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "Extract Org Pay Method Info",
                    "returnType": "array",
                    "sourceCode": "const payRelId = $context.$nodes.FOR_EACH_PAYREL_CHECK_EFT_OPM.$currentItem.PayrollRelationshipId;\nconst opmRsp = $context.$nodes.FOR_EACH_PAYREL_CHECK_EFT_OPM.CHECK_ORG_PAY_METHOD_FOR_PR.$output;\n\nlet rspObject = {};\nrspObject.PayrollRelationshipId = payRelId;\n\nlet opmArray = [];\n\nif(Array.isArray(opmRsp.items)) {\n    for(const opmRow of opmRsp.items) {\n        const opm = {};\n        opm.OrgPaymentMethodId = opmRow.OrgPaymentMethodId;\n        opm.OrgPaymentMethodName = opmRow.OrgPaymentMethodName;\n        opmArray.push(opm);\n    }\n}\nrspObject.OrgPayMethods = opmArray;\n\nreturn rspObject;"
                  },
                  "outcomes": {
                    "success": "end_1771751325325"
                  },
                  "code": "EXTRACT_ORG_PAY_METHOD_INFO",
                  "id": "1771751882611",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                }
