            "errorNodeId": "1771755299600",
            "loopType": "SEQUENTIAL",
            "name": "Check Payment Methods for Payroll Relationships"
          },
          "outcomes": {
            "success": "1771751325325"
          },
          "code": "CHECK_PAYMENT_METHODS_FOR_PAYROLL_RELATIONSHIPS",
          "id": "1770649010412",
          "inputs": [
            {
              "id": "1770649010413_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$variables.prereqCheckResponse.PayrollRelationships}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "Populate HasPaymentMethods Flag",
            "returnType": "object",
            "sourceCode": "const payRelPayMethodsCountResult = $context.$nodes.CHECK_PAYMENT_METHODS_FOR_PAYROLL_RELATIONSHIPS.$output;\nconst opmsForPayRelsResult = $context.$nodes.FOR_EACH_PAYREL_CHECK_EFT_OPM.$output;\n\nconst workflowRspPayload = $context.$variables.prereqCheckResponse;\nconst payRelArray = [];\nconst payRelPpmCountMap = new Map();\nconst payRelOpmsMap = new Map();\n\nif(payRelPayMethodsCountResult && Array.isArray(payRelPayMethodsCountResult)) {\n    payRelPayMethodsCountResult.forEach(itemStr => {\n        const item = JSON.parse(itemStr);\n        const id = item.result.PayrollRelationshipId;\n        const count = item.result.PaymentMethodCount;\n        payRelPpmCountMap.set(id, count);\n    });\n}\n\nif(opmsForPayRelsResult && Array.isArray(opmsForPayRelsResult)) {\n    opmsForPayRelsResult.forEach(itemStr => {\n        const item = JSON.parse(itemStr);\n        const id = item.result.PayrollRelationshipId;\n        const opmArray = item.result.OrgPayMethods;\n        payRelOpmsMap.set(id, opmArray);\n    });\n}\n\nif(workflowRspPayload && Array.isArray(workflowRspPayload.PayrollRelationships)) {\n    for(let payRel of workflowRspPayload.PayrollRelationships) {\n        payRel.HasPaymentMethods = payRelPpmCountMap.get(payRel.PayrollRelationshipId) > 0 ? true : false;\n        payRel.OrgPayMethods = payRelOpmsMap.get(payRel.PayrollRelationshipId);\n        payRelArray.push(payRel);\n    }\n}\n\nworkflowRspPayload.PayrollRelationships = payRelArray;\n\nreturn workflowRspPayload;"
          },
          "outcomes": {
            "success": "1771239681822"
          },
          "code": "POPULATE_HASPAYMENTMETHODS_FLAG",
          "convergenceTargetId": "1770889242840",
          "id": "1770650093491",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
