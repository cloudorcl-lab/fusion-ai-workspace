                  "code": "FETCH_ACTIVE_PAYMENT_METHODS",
                  "id": "1770649074211",
                  "inputs": [
                    {
                      "id": "1770649153158_1",
                      "name": "pPayrollRelationshipId",
                      "type": "string",
                      "value": "{{$context.$nodes.CHECK_PAYMENT_METHODS_FOR_PAYROLL_RELATIONSHIPS.$currentItem.PayrollRelationshipId}}"
                    }
                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "Get Payment Methods Count per PR",
                    "returnType": "object",
                    "sourceCode": "let rspObj = {};\nconst payRelId = $context.$nodes.CHECK_PAYMENT_METHODS_FOR_PAYROLL_RELATIONSHIPS.$currentItem.PayrollRelationshipId;\nconst activePpmRsp = $context.$nodes.CHECK_PAYMENT_METHODS_FOR_PAYROLL_RELATIONSHIPS.FETCH_ACTIVE_PAYMENT_METHODS.$output;\nconst futurePpmRsp = $context.$nodes.CHECK_PAYMENT_METHODS_FOR_PAYROLL_RELATIONSHIPS.FETCH_FUTURE_PAYMENT_METHODS.$output;\n\nrspObj.PayrollRelationshipId = payRelId;\nrspObj.PaymentMethodCount = 0;\n\nif(activePpmRsp && Array.isArray(activePpmRsp.items)) {\n    rspObj.PaymentMethodCount = activePpmRsp.items.length;\n}\n\nif(futurePpmRsp && Array.isArray(futurePpmRsp.items)) {\n    rspObj.PaymentMethodCount = rspObj.PaymentMethodCount + futurePpmRsp.items.length;\n}\n\nreturn rspObj;"
                  },
                  "outcomes": {
                    "success": "end_1770649010412"
                  },
                  "code": "GET_PAYMENT_METHOD_COUNT_PER_PR",
                  "id": "1770649462711",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "businessObjectCode": "ORA_HCM_GLOBALPAYR_GETPERSONALPAYMENTMETHODS",
                    "functionName": "getall_employeeReadOnlyPaymentMethods_future",
                    "processJson": true,
                    "name": "Fetch Future Payment Methods"
                  },
                  "outcomes": {
