            "businessObjectCode": "ORA_HCM_GLOBALPAYR_GETEMPLOYEEPAYROLLRELATIONSHIPS",
            "errorNodeId": "1771755299600",
            "functionName": "getall_paymentMethodRelationshipsLOV",
            "processJson": true,
            "name": "Retrieve Payroll Relationships for Logged In User"
          },
          "outcomes": {
            "success": "1770629239913"
          },
          "code": "RETRIEVE_PAYROLL_RELATIONSHIPS_FOR_LOGGED_IN_USER",
          "id": "1770629136687",
          "inputs": [],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Extract Payroll Relationships",
            "returnType": "object",
            "sourceCode": "let validationRsp = {};\nvalidationRsp.PartyId = null;\nvalidationRsp.HasAtLeastOneManageAccess = false;\nvalidationRsp.HasMulitplePR = false;\nvalidationRsp.PayrollRelationships = [];\n\nlet usPayRels = [];\nconst payRelOutput = $context.$nodes.RETRIEVE_PAYROLL_RELATIONSHIPS_FOR_LOGGED_IN_USER.$output;\n\nif(payRelOutput && payRelOutput.items && payRelOutput.items.length > 0) {\n    validationRsp.PartyId = payRelOutput.items[0].PartyId;\n\n    for(let item of payRelOutput.items) {\n        if(item.LegislationCode == 'US') {\n            usPayRels.push(item);\n        }\n\n        if(item.HasManageAccessFlag == \"true\") {\n            validationRsp.HasAtLeastOneManageAccess = true;\n        }\n    }\n}\n\nif(usPayRels.length > 1) {\n    validationRsp.HasMulitplePR = true;\n}\n\nvalidationRsp.PayrollRelationships = usPayRels;\n\nreturn validationRsp;"
          },
          "outcomes": {
            "success": "1770632911271"
          },
          "code": "EXTRACT_PAYROLL_RELATIONSHIPS",
          "id": "1770629239913",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
