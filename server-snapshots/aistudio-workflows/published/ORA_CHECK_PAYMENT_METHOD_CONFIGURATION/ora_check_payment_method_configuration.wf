        {
          "metadata": {
            "name": "Populate CE Profile Flag",
            "returnType": "object",
            "sourceCode": "const profileRestRsp = $context.$nodes.GET_CE_USE_EXISTING_BANK_BRANCH_PROFILE_VALUE.$output;\nlet workflowRspPayload = $context.$variables.prereqCheckResponse;\nworkflowRspPayload.UseExistingBankBranch = false;\n\nif(profileRestRsp && Array.isArray(profileRestRsp.items) && profileRestRsp.items.length > 0) {\n    workflowRspPayload.UseExistingBankBranch = profileRestRsp.items[0].ProfileOptionValue == 'Y' ? true : false;\n}\n\nreturn workflowRspPayload;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "POPULATE_CE_PROFILE_FLAG",
          "id": "1770890007242",
