              "value": "{{$context.$nodes.INITIAL_CONVERSATION.$output.requirements}}"
            },
            {
              "id": "set_intake_variables_intakeInputs",
              "name": "intakeInputs",
              "type": "string",
              "value": "{{$context.$nodes.INITIAL_CONVERSATION.$output.inputs}}"
            },
            {
              "id": "set_intake_variables_intakeOutputs",
              "name": "intakeOutputs",
              "type": "string",
              "value": "{{$context.$nodes.INITIAL_CONVERSATION.$output.outputs}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Assess Required Details",
            "returnType": "object",
            "sourceCode": "const variables = $context.$variables || {};\n\nfunction text(value) {\n  return String(value || '').trim();\n}\n\nfunction normalized(value) {\n  return text(value).toLowerCase();\n}\n\nfunction isMissing(value) {\n  const current = normalized(value);\n  return !current || current.includes('unknown') || current.includes('request_change') || current.includes('confirmed');\n}\n\nconst formulaType = text(variables.intakeFastFormulaType);\nconst requirements = text(variables.intakeRequirements);\nconst inputs = text(variables.intakeInputs);\nconst outputs = text(variables.intakeOutputs);\n\nconst allowedTypes = {\n  'time calculation rules': true,\n  'time entry rules': true,\n  'time device rules': true,\n  'time submission rules': true,\n  'time compliance rules': true,\n  'wfm time calculation rules': true,\n  'wfm time entry rules': true,\n  'wfm time device rules': true,\n  'wfm time submission rules': true,\n  'wfm time compliance rules': true\n};\n\nconst missingFields = [];\nif (!allowedTypes[normalized(formulaType)]) {\n  missingFields.push('Fast Formula Type');\n}\nif (isMissing(inputs)) {\n  missingFields.push('Inputs');\n}\nif (isMissing(outputs)) {\n  missingFields.push('Outputs');\n}\n\nconst result = {\n  isComplete: missingFields.length === 0,\n  missingFields,\n  formulaType,\n  requirements,\n  inputs,\n  outputs\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "9"
          },
          "code": "ASSESS_REQUIRED_DETAILS",
          "id": "11",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
