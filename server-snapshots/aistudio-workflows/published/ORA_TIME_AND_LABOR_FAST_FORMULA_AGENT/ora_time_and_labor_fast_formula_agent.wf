          },
          "code": "REQUEST_MISSING_DETAILS",
          "id": "10",
          "inputs": [
            {
              "value": {
                "messageTemplate": {
                  "message": "I need a few more details before I can ask for final approval.\n\nMissing details\n{{$context.$nodes.ASSESS_REQUIRED_DETAILS.$output.result.missingFields}}\n\nPlease provide the missing values using these labels:\n\nFast Formula Type - one of Time Calculation Rules, Time Entry Rules, Time Device Rules, Time Submission Rules, or Time Compliance Rules\nRequirements - the requested behavior, rule conditions, evaluation details, exceptions, or constraints\nInputs - the input values or conditions the formula should use\nOutputs - the expected result, entry, bucket, message, or returned value\n\nCurrent extracted details:\n\nFast Formula Type\n{{$context.$variables.intakeFastFormulaType}}\n\nRequirements\n{{$context.$variables.intakeRequirements}}\n\nInputs\n{{$context.$variables.intakeInputs}}\n\nOutputs\n{{$context.$variables.intakeOutputs}}"
                },
                "maxIterationsExceededTemplate": {
