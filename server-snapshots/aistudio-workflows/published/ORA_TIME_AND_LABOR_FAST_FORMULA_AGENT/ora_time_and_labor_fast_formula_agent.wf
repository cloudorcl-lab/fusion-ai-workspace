              "value": {
                "messageTemplate": {
                  "message": "Please review the extracted Time and Labor Fast Formula request details.\n\nFast Formula Type\n{{$context.$variables.intakeFastFormulaType}}\n\nRequirements\n{{$context.$variables.intakeRequirements}}\n\nInputs\n{{$context.$variables.intakeInputs}}\n\nOutputs\n{{$context.$variables.intakeOutputs}}\n\nApprove if these details are correct. Request changes if any detail should be updated."
                },
                "maxIterationsExceededTemplate": {
                  "message": "Maximum review attempts reached. Ending the workflow."
                },
                "requestChangeMessage": "Please provide corrections using labels, for example: Fast Formula Type -, Requirements -, Inputs - or Required Inputs -, Outputs - or Expected Outputs -."
              },
              "id": "2_chatChannelInput",
