                      "type": "string",
                      "value": "{{$context.$nodes.GENERATE_FAST_FORMULA.$output.jobId}}"
                    },
                    {
                      "id": "poll_job_status_loop_pWait_Seconds",
                      "name": "pWait_Seconds",
                      "type": "string",
                      "value": "30"
                    }
                  ]
                },
                {
                  "metadata": {
                    "name": "Normalize Poll Result",
                    "returnType": "object",
                    "sourceCode": "const raw = $context.$nodes.POLL_JOB_STATUS_LOOP.$output || {};\n\nfunction parseMaybeJson(value) {\n  if (typeof value !== 'string') {\n    return value;\n  }\n\n  const trimmed = value.trim();\n  if (!trimmed) {\n    return value;\n  }\n\n  try {\n    return JSON.parse(trimmed);\n  } catch (error) {\n    return value;\n  }\n}\n\nfunction getFirstString(values) {\n  for (let index = 0; index < values.length; index += 1) {\n    const value = values[index];\n    if (typeof value === 'string' && value.trim()) {\n      return value;\n    }\n  }\n  return '';\n}\n\nconst parsedRaw = parseMaybeJson(raw);\nconst base = parsedRaw && typeof parsedRaw === 'object' ? parsedRaw : {};\nconst resultPayload = parseMaybeJson(base.result);\nconst result = resultPayload && typeof resultPayload === 'object' ? resultPayload : {};\nconst pollOutputPayload = parseMaybeJson(result.pollOutput || base.pollOutput);\nconst pollOutput = pollOutputPayload && typeof pollOutputPayload === 'object' ? pollOutputPayload : {};\n\nconst rawStatus = getFirstString([\n  base.status,\n  result.status,\n  pollOutput.status\n]).toUpperCase();\n\nconst formulaText = getFirstString([\n  base.text,\n  base.formula,\n  base.formulaText,\n  base.formulaCode,\n  base.code,\n  result.text,\n  result.formula,\n  result.formulaText,\n  result.formulaCode,\n  result.code,\n  pollOutput.text,\n  pollOutput.formula,\n  pollOutput.formulaText,\n  pollOutput.formulaCode,\n  pollOutput.code\n]);\n\nconst isComplete = rawStatus === 'COMPLETE' || rawStatus === 'COMPLETED' || Boolean(formulaText);\nconst status = isComplete ? (rawStatus || 'COMPLETED') : (rawStatus || 'UNKNOWN');\n\nconst resultObject = {\n  status,\n  isComplete,\n  formulaText\n};\n\nreturn resultObject;"
                  },
                  "outcomes": {
                    "success": "set_polling_variables_loop"
                  },
                  "diagram": {
                    "x": 5225,
                    "y": 7485
