              "type": "object"
            }
          ],
          "type": "HUMAN"
        },
        {
          "metadata": {
            "name": "Map Template Code",
            "returnType": "object",
            "sourceCode": "const variables = $context.$variables || {};\n\nconst fastFormulaType = String(variables.intakeFastFormulaType || '').trim();\nconst requirements = String(variables.intakeRequirements || '').trim();\nconst inputs = String(variables.intakeInputs || '').trim();\nconst outputs = String(variables.intakeOutputs || '').trim();\n\nconst templateCodes = {\n  'Time Calculation Rules': 'ORA_HCM_FF_TIME_CALCULATION_FORMULA_56037',\n  'WFM Time Calculation Rules': 'ORA_HCM_FF_TIME_CALCULATION_FORMULA_56037',\n  'Time Entry Rules': 'ORA_HCM_FF_TIME_ENTRY_FORMULA_134140',\n  'WFM Time Entry Rules': 'ORA_HCM_FF_TIME_ENTRY_FORMULA_134140',\n  'Time Device Rules': 'ORA_HCM_FF_TIME_DEVICE_FORMULA_TEMPLATE_57649',\n  'WFM Time Device Rules': 'ORA_HCM_FF_TIME_DEVICE_FORMULA_TEMPLATE_57649',\n  'Time Submission Rules': 'ORA_HCM_FF_TIME_SUBMISSION_FORMULA_853389',\n  'WFM Time Submission Rules': 'ORA_HCM_FF_TIME_SUBMISSION_FORMULA_853389',\n  'Time Compliance Rules': 'ORA_HCM_FF_TIME_COMPLIANCE_FORMULA_333639',\n  'WFM Time Compliance Rules': 'ORA_HCM_FF_TIME_COMPLIANCE_FORMULA_333639'\n};\n\nconst templateCode = templateCodes[fastFormulaType] || '';\nconst generatorFastFormulaType = fastFormulaType.startsWith('WFM ')\n  ? fastFormulaType\n  : fastFormulaType\n    ? 'WFM ' + fastFormulaType\n    : 'WFM Time Calculation Rules';\n\nconst resolvedRequirements = requirements || 'Not specified';\nconst resolvedInputs = inputs || 'Not specified';\nconst resolvedOutputs = outputs || 'Not specified';\n\nconst pMessage = 'Generate an Oracle HCM Time and Labor Fast Formula using these resolved and approved request details.\\n\\n' +\n  'Fast Formula Type:\\n' + generatorFastFormulaType + '\\n\\n' +\n  'Requirements:\\n' + resolvedRequirements + '\\n\\n' +\n  'Required Inputs:\\n' + resolvedInputs + '\\n\\n' +\n  'Expected Outputs:\\n' + resolvedOutputs + '\\n\\n' +\n  'Do not ask for the resolved Fast Formula type, requirements, inputs, or outputs again. Use these approved details as the source of truth and generate the best valid formula.';\n\nconst result = {\n  template_code: templateCode,\n  pMessage,\n  FastFormulaType: generatorFastFormulaType,\n  requirements: resolvedRequirements,\n  inputs: resolvedInputs,\n  outputs: resolvedOutputs\n};\n\nreturn result;"
          },
