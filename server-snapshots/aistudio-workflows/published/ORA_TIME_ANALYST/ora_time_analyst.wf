        {
          "metadata": {
            "name": "Identify Agent Flow"
          },
          "outcomes": {
            "UNSUPPORTED": "1767970086730",
            "TIME_ANALYZE": "1767617745141",
            "HELP": "1781004369522"
          },
          "code": "IDENTIFY_AGENT_FLOW",
          "convergenceTargetId": "end",
          "id": "1767968902996",
          "inputs": [
            {
              "id": "1767968902998_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$variables.qAgentFlow}}"
            }
          ],
          "type": "SWITCH",
          "diagram": {
            "x": 7361,
            "y": 5650
          }
