        {
          "metadata": {
            "name": "Retrieve Input Values",
            "returnType": "object",
            "sourceCode": "let timeCardDataValidationResult = {};\n\nlet timeCardData =\n  $context.$system?.$inputContext?.TimeCardId != null\n    ? $context.$system.$inputContext\n    : $context.$triggers.REST.$input;\n\nlet isValid = true;\nlet error = null;\nlet num = null;\n\nif (!timeCardData) {\n  isValid = false;\n  error = \"Selected time card details are invalid.\";\n}\n\nif (isValid) {\n  let timeCardId = timeCardData.TimeCardId;\n  isValid = timeCardId != null && String(timeCardId).trim() !== \"\";\n\n  if (isValid) {\n    num = Number(timeCardId);\n    isValid = Number.isInteger(num) && num > 0;\n  }\n\n  if (!isValid) {\n    error = \"Time Card ID is invalid.\";\n  }\n}\n\nif (isValid) {\n  timeCardDataValidationResult.timeCardId = num;\n\n  let userContext = timeCardData.Context;\n  let userContextValid = userContext != null && userContext.trim() !== \"\";\n\n  timeCardDataValidationResult.userContext = userContextValid\n    ? userContext\n    : \"WORKER\";\n\n  timeCardDataValidationResult.isValid = true;\n} else {\n  timeCardDataValidationResult.isValid = false;\n  timeCardDataValidationResult.error = error;\n}\n\nreturn timeCardDataValidationResult;\n"
          },
          "outcomes": {
            "success": "1767878329941"
          },
          "code": "RETRIEVE_INPUT_VALUES",
          "id": "1767617745141",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
