        {
          "metadata": {
            "name": "Identify Previous Time Cards",
            "returnType": "array",
            "sourceCode": "let prevTimeCardDates = [];\nlet n = (new Date( $context.$variables.qSelectedTimeCardEndDate ) - new Date( $context.$variables.qSelectedTimeCardStartDate )) / (1000 * 60 * 60 * 24);\nfor (let i = 3; i > 0; i--) {\n  let tempDate = new Date( $context.$variables.qSelectedTimeCardStartDate );\n  tempDate.setDate(tempDate.getDate() - i*n);\n  prevTimeCardDates.push(tempDate.toISOString().split('T')[0]);\n}\n\nreturn prevTimeCardDates;"
          },
          "outcomes": {
            "success": "1767637747452"
          },
          "code": "IDENTIFY_PREVIOUS_TIME_CARDS",
          "convergenceTargetId": "1767951197184",
          "id": "1767611937542",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 6100.0625,
            "y": 8980
          }
