{
  "workflowId": "300000331057970",
  "workflowCode": "ORA_INV_SLOW_MOVING_ITEM_SEARCH_ADVISOR",
  "name": "Slow Moving Item Search Advisor",
  "description": "Assists warehouse managers in retrieving and evaluating slow-moving items across organizations. This advisor interprets user intent to identify relevant items within the slow-moving items workspace, supports organization selection when context is missing or ambiguous, and retrieves supply and demand trends for selected items. It enables users to analyze inventory aging, demand trend, and supply trend to support  decision-making. The advisor focuses on information retrieval and contextual analysis and does not execute inventory transactions or modify supply or demand data.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1772620023923"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "description": "End of data pipeline",
