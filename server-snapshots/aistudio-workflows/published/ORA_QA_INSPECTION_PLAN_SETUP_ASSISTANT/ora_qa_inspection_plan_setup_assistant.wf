{
  "workflowId": "300000331068310",
  "workflowCode": "ORA_QA_INSPECTION_PLAN_SETUP_ASSISTANT",
  "name": "Inspection Plan Setup Assistant",
  "description": "A unified agent team designed to simplify and automate inspection plan setup. This team generates inspection characteristics, concise plan descriptions, and detailed inspection instructions, ensuring complete, accurate, and compliant inspection plans for quality management.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
