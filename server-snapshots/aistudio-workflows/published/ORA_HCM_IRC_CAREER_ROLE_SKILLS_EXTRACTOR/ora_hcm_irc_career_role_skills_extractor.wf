          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Create Final Career Role Object",
            "returnType": "object",
            "sourceCode": "const loopOutput = $context.$nodes.GET_ALL_CAREER_ROLE_SKILLS_LOOP_NODE.$output || [];\nconst finalOutput = {};\nfinalOutput.SkillsExist = false;\nlet finalCareerRoles = [];\nif (Array.isArray(loopOutput)) {\n    loopOutput.forEach(output => {\n        const careerRole = JSON.parse(output).result;\n        if (!finalOutput.SkillsExist && careerRole.Skills && careerRole.Skills.length > 0) {\n            finalOutput.SkillsExist = true;\n        }\n        finalCareerRoles.push(careerRole);\n    });\n    finalOutput.CareerRoles=finalCareerRoles;\n}\nreturn finalOutput;"
          },
          "outcomes": {
            "success": "1765031015259"
          },
          "code": "CREATE_FINAL_CAREER_ROLE_OBJECT",
