       \"kind\"\n                  ],\n                  \"properties\": {\n                    \"rel\": {\n                      \"type\": \"string\",\n                      \"minLength\": 1\n                    },\n                    \"href\": {\n                      \"type\": \"string\",\n                      \"minLength\": 1\n                    },\n                    \"name\": {\n                      \"type\": \"string\",\n                      \"minLength\": 1\n                    },\n                    \"kind\": {\n                      \"type\": \"string\",\n                      \"minLength\": 1\n                    }\n                  }\n                }\n              }\n            },\n            \"required\": [\n              \"key\",\n              \"links\"\n            ]\n          }\n        }\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"href\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"name\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"kind\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ]\n}",
