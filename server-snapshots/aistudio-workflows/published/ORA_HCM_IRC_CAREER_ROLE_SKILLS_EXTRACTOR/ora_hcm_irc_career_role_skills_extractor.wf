        {
          "metadata": {
            "name": "FILTER FAV CAREER ROLES CODE NODE",
            "returnType": "array",
            "sourceCode": "const data = $context.$nodes.GET_FAVORITED_OPPORTUNITIES.$output.items;\nvar careerRoles = [];\n\n// Gather and filter CAREER_ROLE opportunities in a single pass\nif (data) {\n    data.forEach(item => {\n        if (item.opportunityList && Array.isArray(item.opportunityList.items)) {\n            item.opportunityList.items.forEach(opp => {\n                if (opp.OpportunityType === \"CAREER_ROLE\") {\n                    careerRoles.push({\n                        OpportunityId: opp.OpportunityId,\n                        Title: opp.Title || \"\",\n                        Description: opp.Description || \"\"\n                    });\n                }\n            });\n        }\n    });\n}\nreturn careerRoles;"
          },
          "outcomes": {
            "success": "1765084108094"
          },
          "code": "FILTER_FAV_CAREER_ROLES_CODE_NODE",
          "id": "1765028468676",
          "inputs": [],
