          "code": "INFER_SKILLS_FROM_CAREER_ROLE",
          "id": "1765036149788",
          "inputs": [
            {
              "id": "1765036149790_1",
              "name": "prompt",
              "type": "string",
              "value": "Given the following job opportunities (each with a title and optional description), list up to 3 key skills that would be most relevant overall. Respond with a single array of 3 concise skill phrases for each entry in the input array \nIf descriptions are missing, infer from the titles.\n\nInput:\n {{$context.$nodes.CREATE_FINAL_CAREER_ROLE_OBJECT.$output.result.CareerRoles}} \n\nRespond as JSON and use Title,Description,OpportunityId to fill corresponding properties in the response"
            }
          ],
          "outputSpecification": "{\n  \"type\": \"array\",\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"description\": \"\",\n  \"minItems\": 1,\n  \"uniqueItems\": true,\n  \"items\": {\n    \"type\": \"object\",\n    \"required\": [\n      \"Description\",\n      \"OpportunityId\",\n      \"Skills\",\n      \"Title\"\n    ],\n    \"properties\": {\n      \"Description\": {\n        \"type\": \"string\",\n        \"minLength\": 1\n      },\n      \"OpportunityId\": {\n        \"type\": \"string\",\n        \"minLength\": 1\n      },\n      \"Skills\": {\n        \"type\": \"array\",\n        \"uniqueItems\": true,\n        \"minItems\": 1,\n        \"items\": {\n          \"required\": [\n            \"Skill\"\n          ],\n          \"properties\": {\n            \"Skill\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            }\n          }\n        }\n      },\n      \"Title\": {\n        \"type\": \"string\",\n        \"minLength\": 1\n      }\n    }\n  }\n}",
          "type": "LLM"
        },
