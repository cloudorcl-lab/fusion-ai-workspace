                  ],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"description\": \"\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"SkillId\",\n          \"Skill\"\n        ],\n        \"properties\": {\n          \"SkillId\": {\n            \"type\": \"number\"\n          },\n          \"Skill\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"ContentItemId\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"SkillName\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"SyncStatus\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"links\": {\n            \"type\": \"array\",\n            \"uniqueItems\": true,\n            \"minItems\": 1,\n            \"items\": {\n              \"required\": [\n                \"rel\",\n                \"href\",\n                \"name\",\n                \"kind\"\n              ],\n              \"properties\": {\n                \"rel\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"href\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"name\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"kind\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"properties\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"changeIndicator\": {\n                      \"type\": \"string\",\n                      \"minLength\": 1\n                    }\n                  },\n                  \"required\": [\n                    \"changeIndicator\"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"href\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"name\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"kind\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ]\n}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "Add Skills To Career Role",
                    "returnType": "object",
                    "sourceCode": "const careerRole = $context.$nodes.GET_ALL_CAREER_ROLE_SKILLS_LOOP_NODE.$currentItem;\n\nconst skillsOutput = $context.$nodes.GET_ALL_CAREER_ROLE_SKILLS_LOOP_NODE.CALL_CAREER_ROLE_SKILLS.$output.items;\nlet finalSkills = [];\n\nif (Array.isArray(skillsOutput)) {\n    skillsOutput.forEach(skill => {\n        const {SkillId, Skill, SkillName, MinimumYearsExperience, Importance, Required} = skill;\n        if ( ! ( (skill.Skill == null && skill.SkillName == null) || (skill.Skill == \"\" && skill.SkillName == \"\" ) ) ){\n            finalSkills.push({SkillId, Skill, SkillName, MinimumYearsExperience, Importance, Required});\n        }\n    });\n}\n\ncareerRole.Skills = finalSkills;\nreturn careerRole;"
                  },
                  "outcomes": {
                    "success": "end_1765029485308"
                  },
                  "code": "ADD_SKILLS_TO_CAREER_ROLE",
                  "id": "1765609230021",
