{
  "workflowId": "300000331058676",
  "workflowCode": "ORA_FIN_IEX_CUSTOMER_DETAILS_ASSISTANT",
  "name": "Collections Customer Details Assistant",
  "description": "Provides a comprehensive, policy-aligned single-customer view by consolidating account, invoice, payment, and interaction data into a unified summary. Surfaces insights, risk indicators, and next-best actions derived from collections policies and business rules, along with recommended communication strategies.",
  "specification": {
