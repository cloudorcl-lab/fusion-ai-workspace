        {
          "metadata": {
            "name": "MergeAttributesIntoEmploymentSession",
            "returnType": "object",
            "sourceCode": "const employmentSession = $context.$variables.employmentSession || {};\n\nconst existingUserAttributes = employmentSession.userAttributes || [];\nconst existingListOfAttributes = employmentSession.listOfAttributes || {};\n\nlet buResult = $context.$nodes.PROCESS_BU_AND_DEPENDENT_ATTRIBUTES_BY_CODE?.$output?.result || null;\nconst buDependentResult = $context.$nodes.PROCESS_DEPENDENTS_OF_BU_WITH_SPECIFICSET?.$output?.result || null;\n\nif (buDependentResult !== null) {\n    buResult = buDependentResult;\n}\n\nconst actionResult = $context.$nodes.PROCESS_ACTION_AND_DEPENDENT_ATTRIBUTES_BY_CODE?.$output?.result || null;\nconst actionReasonResult = $context.$nodes.PROCESS_ACTION_REASON_DATA?.$output?.result || null;\n\n\nif(buResult!== null || actionResult!== null || actionReasonResult!== null){\n\n/* ===== USER ATTRIBUTES ===== */\n\nconst buUserAttributes = Array.isArray(buResult?.userAttributes) ? buResult.userAttributes : [];\nconst actionUserAttributes = Array.isArray(actionResult?.userAttributes) ? actionResult.userAttributes : [];\nconst actionReasonUserAttributes = Array.isArray(actionReasonResult?.userAttributes) ? actionReasonResult.userAttributes : [];\n\nconst buAllowed = [\"Department\", \"Location\", \"Job\", \"Position\", \"BusinessUnit\"];\nconst actionAllowed = [\"Action\", \"ActionReason\"];\n\nconst finalUserAttributes = [];\nlet i;\n\n/* Copy valid BU attributes */\n\nfor (i = 0; i < buUserAttributes.length; i++) {\n    if (\n        buAllowed.indexOf(buUserAttributes[i]) !== -1 &&\n        finalUserAttributes.indexOf(buUserAttributes[i]) === -1\n    ) {\n        finalUserAttributes.push(buUserAttributes[i]);\n    }\n}\n\n/* Copy valid Action attributes */\n\nfor (i = 0; i < actionUserAttributes.length; i++) {\n    if (\n        actionAllowed.indexOf(actionUserAttributes[i]) !== -1 &&\n        finalUserAttributes.indexOf(actionUserAttributes[i]) === -1\n    ) {\n        finalUserAttributes.push(actionUserAttributes[i]);\n    }\n}\n\nfor (i = 0; i < actionReasonUserAttributes.length; i++) {\n    if (\n        actionAllowed.indexOf(actionReasonUserAttributes[i]) !== -1 &&\n        finalUserAttributes.indexOf(actionReasonUserAttributes[i]) === -1\n    ) {\n        finalUserAttributes.push(actionReasonUserAttributes[i]);\n    }\n}\n\nif (finalUserAttributes.length > 0) {\n    employmentSession.userAttributes = finalUserAttributes;\n}\n\n/* ===== LIST OF ATTRIBUTES (OBJECT MERGE LOGIC) ===== */\n\nconst buDependentKeys = [\n    \"BusinessUnit\",\n    \"Job\",\n    \"Department\",\n    \"Location\",\n    \"BusinessTitle\",\n    \"Position\"\n];\n\nconst finalListOfAttributes = {};\n\nconst buList = buResult?.listOfAttributes || {};\nconst actionList = actionResult?.listOfAttributes || {};\nconst actionReasonList = actionReasonResult?.listOfAttributes || {};\n\nlet key;\n\nif (buResult || actionResult || actionReasonResult) {\n\n    /* BU-dependent keys strictly from BU */\n\n    for (key in buList) {\n        if (\n            buDependentKeys.indexOf(key) !== -1 &&\n            finalListOfAttributes[key] === undefined\n        ) {\n            finalListOfAttributes[key] = buList[key];\n        }\n    }\n\n    /* Action keys strictly from Action */\n\n    for (key in actionList) {\n        if (finalListOfAttributes[key] === undefined) {\n            finalListOfAttributes[key] = actionList[key];\n        }\n    }\n\n    for (key in actionReasonList) {\n        if (finalListOfAttributes[key] === undefined) {\n            finalListOfAttributes[key] = actionReasonList[key];\n        }\n    }\n\n    /* Remaining keys from existing */\n\n    for (key in existingListOfAttributes) {\n        if (\n            finalListOfAttributes[key] === undefined &&\n            buDependentKeys.indexOf(key) === -1\n        ) {\n            finalListOfAttributes[key] = existingListOfAttributes[key];\n        }\n    }\n\n    employmentSession.listOfAttributes = finalListOfAttributes;\n}\n\n/* ===== INFO NEEDED ===== */\n\nemploymentSession.infoNeeded =\n    Boolean(buResult?.infoNeeded) || Boolean(actionResult?.infoNeeded) || Boolean(actionReasonResult?.infoNeeded);\n\nconst infoNeededStrings = [];\n\nif (buResult?.infoNeededString) {\n    infoNeededStrings.push(buResult.infoNeededString);\n}\n\nif (\n    actionResult?.infoNeededString &&\n    infoNeededStrings.indexOf(actionResult.infoNeededString) === -1\n) {\n    infoNeededStrings.push(actionResult.infoNeededString);\n}\n\nif (\n    actionReasonResult?.infoNeededString &&\n    infoNeededStrings.indexOf(actionReasonResult.infoNeededString) === -1\n) {\n    infoNeededStrings.push(actionReasonResult.infoNeededString);\n}\n\nemploymentSession.infoNeededString = infoNeededStrings.join(\", \");\n\nif (buResult || actionResult || actionReasonResult) {\n    employmentSession.lovProcessed = true;\n}\n\nif (!buResult && !actionResult && !actionReasonResult && employmentSession.userAttributes.length === 0) {\n    employmentSession.infoNeeded = false;\n    employmentSession.infoNeededString = \"\";\n}\n\nemploymentSession.isSpecificSetSearchNeeded = buResult?.isSpecificSetSearchNeeded;\n}\n\n\nif( ($context.$nodes.GETPROBATIONDETAILSBYCODENODE.$output?.result?.ProbationEndDate != null ) && (employmentSession.listOfAttributes.ProbationEndDate != undefined || employmentSession.listOfAttributes.ProbationPeriod != undefined || employmentSession.listOfAttributes.ProbationPeriodUnit != undefined ))\n\n{\n      employmentSession.listOfAttributes.ProbationEndDate = $context.$nodes.GETPROBATIONDETAILSBYCODENODE.$output?.result?.ProbationEndDate;\n      employmentSession.listOfAttributes.ProbationPeriod = $context.$nodes.GETPROBATIONDETAILSBYCODENODE.$output?.result?.ProbationPeriod;\n     employmentSession.listOfAttributes.ProbationPeriodUnit = $context.$nodes.GETPROBATIONDETAILSBYCODENODE.$output?.result?.ProbationPeriodUnit;\n}\n\n\nreturn employmentSession;"
          },
          "outcomes": {
            "success": "1772105655786"
          },
          "code": "MERGE_ATTRIBUTES_INTO_EMPLOYMENT_SESSION",
          "id": "1771942344707",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
