          },
          "code": "ASSIGNMENT_CHANGE_CONFIGURATION_DOCUMENT",
          "id": "1771829243746",
          "inputs": [
            {
              "id": "1771829243747_1",
              "name": "question",
              "type": "string",
              "value": "List out the supported employment process"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"AnswerWithCitations\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"value\": {\n      \"type\": \"string\",\n      \"description\": \"The answer text.\"\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"description\": \"List of citations relevant to the answer.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"citedText\": {\n            \"type\": \"string\",\n            \"description\": \"The cited text.\"\n          }\n        },\n        \"required\": [\n          \"citedText\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"value\",\n    \"citations\"\n  ],\n  \"additionalProperties\": false\n}",
          "type": "RAG_DOCUMENT_TOOL"
        },
        {
          "metadata": {
            "name": "setInfoNeededToTrueForGettingTheNameAndDate",
            "returnType": "object",
            "sourceCode": "// 1. Initialize InfoNeededData safely\nif (!$context.$variables.InfoNeededData || typeof $context.$variables.InfoNeededData !== \"object\") {\n    $context.$variables.InfoNeededData = {};\n}\n\n// 2. Read values safely\nlet displayName = $context.$nodes?.EXTRACT_EMPLOYMENT_PROCESS_AND_DISPLAY_NAME_FROM_USER_INTENT?.$output?.DisplayName || $context.$nodes?.IDENTIFY_USER_INTENT?.$output?.DisplayName||\"\";\nlet effectiveDate = $context.$nodes?.IDENTIFY_USER_INTENT?.$output?.EffectiveDate;\nlet hasAdditionalAttr = $context.$nodes?.IDENTIFY_USER_INTENT?.$output?.hasAdditionalAttributeProvided;\nlet attributesEmpty = $context.$nodes.IDENTIFY_USER_INTENT?.$output?.attributesToModifyValueEmpty;\nlet deepLinkNeeded = $context.$nodes.IDENTIFY_USER_INTENT.$output.deepLinkNeeded;\n// 3. Track missing fields\nlet missingFields = [];\n\nif (displayName === \"\") {\n    missingFields.push(\"worker name\");\n}\n\nif (effectiveDate === \"\") {\n    missingFields.push(\"effective date\");\n}\n\nif(deepLinkNeeded == false){\nif (hasAdditionalAttr === false) {\n    missingFields.push(\" at least one assignment field\");\n}\nif(attributesEmpty === true){\n let attributesEmptyArray = $context.$nodes.IDENTIFY_USER_INTENT?.$output?.attributesToModifyValueEmptyArray;\n missingFields.push(...attributesEmptyArray);\n}\n}\n\n// 4. Construct message\nif (missingFields.length > 0) { \n$context.$variables.InfoNeededData.InfoNeeded = true;\nlet infoNeededString = \"\";\n    if (missingFields.length === 1) {\n        infoNeededString = \"Enter \"+ missingFields[0] + \" to update\";\n    } else {\n        const lastField = missingFields.pop();\n        infoNeededString = \"Enter \"+ missingFields.join(\", \") +\" and \"+ lastField + \" to update\";\n    } \n$context.$variables.InfoNeededData.InfoNeededString = `Print only this user-facing message after converting any camelCase or PascalCase field names to human-readable Title Case. Insert spaces before capital letters and capitalize the first letter of each field-name word. Do not make the starting letter lowercase. Example: ActionReasonName becomes Action Reason Name. Message: ${infoNeededString}`;\n} else {\n    $context.$variables.InfoNeededData.InfoNeeded = false;\n    $context.$variables.InfoNeededData.InfoNeededString = \"\";\n}\n\n// 5. Return result\nreturn $context.$variables.InfoNeededData;"
          },
          "outcomes": {
            "success": "1772004581037"
          },
          "code": "SET_INFO_NEEDED_TO_TRUE_FOR_GETTING_THE_NAME_AND_DATE",
          "id": "1771831449695",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "setTheEmploymentSession",
            "returnType": "object",
            "sourceCode": "// Safely initialize employmentSession\n\nlet employmentSession = $context.$variables.employmentSession;\n\nif (typeof employmentSession !== \"object\" || employmentSession === null) {\n  employmentSession = {};\n}\n\n// Initialize supportedAttribute if missing\nif (!Array.isArray(employmentSession.supportedAttribute)) {\n  employmentSession.supportedAttribute = [\n    \"BusinessUnit\",\n    \"Department\",\n    \"Job\",\n    \"Position\",\n    \"Location\",\n    \"Union\",\n    \"CollectiveAgreement\",\n    \"BargainingUnit\",\n    \"Action\"\n  ];\n}\n\nif(employmentSession.SelectedEmploymentProcess==\"ChangeAssignment\")\nemploymentSession.PrintEmploymentProcess = \"Change Assignment\";\nelse if(employmentSession.SelectedEmploymentProcess==\"Transfers\")\nemploymentSession.PrintEmploymentProcess = \"Transfer\";\nelse\nemploymentSession.PrintEmploymentProcess = employmentSession.SelectedEmploymentProcess;\n\n\n// Read source safely\nvar source = $context.$nodes?.IDENTIFY_USER_INTENT?.$output?.attributesToModifyKeyValueList || {};\nvar attrs = $context.$nodes.EXTRACT_LOV_DATA_FROM_CODE?.$output?.LovAttributesToModify || {}; \nvar userProvidedLovAttributes = source.userProvidedLovAttributes || [];\n\n// Update metadata\nemploymentSession.EffectiveDate =\n  $context.$nodes?.IDENTIFY_USER_INTENT?.$output?.EffectiveDate || null;\n\nconst employmentSessionDisplayName = $context.$variables.employmentSession?.DisplayName;\n\nconst extractDisplayName =\n  $context.$nodes.EXTRACT_EMPLOYMENT_PROCESS_AND_DISPLAY_NAME_FROM_USER_INTENT?.$output?.DisplayName;\n\nconst intentDisplayName =\n  $context.$nodes.IDENTIFY_USER_INTENT?.$output?.DisplayName;\n\nemploymentSession.DisplayName = employmentSessionDisplayName?.trim()\n  ? employmentSessionDisplayName\n  : intentDisplayName?.trim()\n  ? intentDisplayName\n  : extractDisplayName || null;\n\n\n/* ==========================listOfAttributes =================================*/\n\nif (\n  !employmentSession.listOfAttributes ||\n  Object.keys(employmentSession.listOfAttributes).length === 0\n) {\n  employmentSession.listOfAttributes = {};\n}\n\nfor (var key in attrs) {\n  if (true || !(key in employmentSession.listOfAttributes) || (key ==\"BusinessTitle\")) {\n    employmentSession.listOfAttributes[key] = attrs[key];\n    if(key == \"BusinessUnitId\"){\n      const isBuLov = (employmentSession.listOfAttributes.BusinessUnit.listOfValues != undefined);\n      let buObj = employmentSession.listOfAttributes.BusinessUnit;\n      if(isBuLov){\n        buObj = buObj.listOfValues.find(bu => bu.BusinessUnitId == attrs[key]);\n      }\n      employmentSession.listOfAttributes[\"JobSetId\"] = buObj.JobSetId;\n      employmentSession.listOfAttributes[\"LocationSetId\"] = buObj.LocationSetId;\n      employmentSession.listOfAttributes[\"DepartmentSetId\"] = buObj.DepartmentSetId;\n      employmentSession.listOfAttributes[\"GradeSetId\"] = buObj.GradeSetId;\n    }\n }\n}\n\n/* ============================userAttributes============================== */\n\nif (!Array.isArray(employmentSession.userAttributes)) {\n  employmentSession.userAttributes = [];\n}\n\n// If empty → assign directly\nif (employmentSession.userAttributes.length === 0) {\n  for (var i = 0; i < userProvidedLovAttributes.length; i++) {\n    employmentSession.userAttributes.push(userProvidedLovAttributes[i]);\n  }\n}\n\n  var attributeIdMap = {\n    \"BusinessUnit\": [\"BusinessUnitId\"],\n    \"Job\": [\"JobId\"],\n    \"Department\": [\"DepartmentId\"],\n    \"Location\": [\"LocationId\"],\n    \"Position\": [\"PositionId\"],\n    \"Union\": [\"UnionId\"],\n    \"BargainingUnit\": [\"BargainingUnitId\"],\n    \"CollectiveAgreement\": [\"CollectiveAgreementId\"],\n    \"Action\": [\"ActionId\"],\n    \"ActionReason\": [\"ActionReasonId\"]\n  };\n\n  var cleanedUserAttributes = [];\n\n  for (var i = 0; i < employmentSession.userAttributes.length; i++) {\n\n    var attributeName = employmentSession.userAttributes[i];\n    var removeElement = false;\n\n    if (attributeIdMap[attributeName]) {\n\n      var relatedIds = attributeIdMap[attributeName];\n\n      for (var j = 0; j < relatedIds.length; j++) {\n        if (attrs[relatedIds[j]] !== undefined) {\n          removeElement = true;\n          break;\n        }\n      }\n    }\n\n    if (!removeElement) {\n      cleanedUserAttributes.push(attributeName);\n    }\n  }\n\n  employmentSession.userAttributes = cleanedUserAttributes;\n\n\nvar lovToBeProcessed = [];\n\nif (Array.isArray(employmentSession.userAttributes)) {\n\n  for (var i = 0; i < employmentSession.userAttributes.length; i++) {\n\n    var attributeName = employmentSession.userAttributes[i];\n\n    if (!employmentSession.listOfAttributes || !(attributeName in employmentSession.listOfAttributes)) {\n      lovToBeProcessed.push(attributeName);\n    }\n  }\n}\n\nemploymentSession.lovToBeProcessed = lovToBeProcessed;\n\nreturn employmentSession;"
          },
          "outcomes": {
            "success": "1771917305627"
          },
          "code": "SET_THE_EMPLOYMENT_SESSION",
          "id": "1771842654387",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
