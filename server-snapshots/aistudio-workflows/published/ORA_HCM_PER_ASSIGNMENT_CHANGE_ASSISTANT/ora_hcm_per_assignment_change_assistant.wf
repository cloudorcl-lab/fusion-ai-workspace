            "sourceCode": "var userAttributes = $context.$nodes.PROCESS_BU_AND_DEPENDENT_ATTRIBUTES_BY_CODE.$output.result.userAttributes;\nvar listOfAttributes = $context.$nodes.PROCESS_BU_AND_DEPENDENT_ATTRIBUTES_BY_CODE.$output.result.listOfAttributes;\nvar isSpecificSetSearchNeeded = $context.$nodes.PROCESS_BU_AND_DEPENDENT_ATTRIBUTES_BY_CODE.$output.result.isSpecificSetSearchNeeded;\nvar result = false;\n\nif (listOfAttributes.BusinessUnit && listOfAttributes.BusinessUnit.BusinessUnitId) {\n    \n  return isSpecificSetSearchNeeded==true || userAttributes.includes(\"Position\");\n  \n}\n\n/* Return result */\nreturn result || userAttributes.includes(\"Position\");"
