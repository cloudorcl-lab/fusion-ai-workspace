            "sourceCode": "/*var empProcess={};\nif ($context.$variables.employmentSession != null)\n  employmentSession = $context.$variables.employmentSession;\nelse\n  employmentSession = {};\nemploymentSession.InitialAssignmentRecord = $context.$nodes.FETCH_ASSIGNMENT_DETAILS.$output.result;\nemploymentSession.AssignmentRecordPresent = true;\nreturn employmentSession;*/\n\n\n\n// 1. Check if it's null/undefined/non-object and initialize it globally\nif (!$context.$variables.employmentSession || typeof $context.$variables.employmentSession !== 'object') {\n    $context.$variables.employmentSession = {};\n}\n\n// 2. Now assign the property directly to the global object\n$context.$variables.employmentSession.InitialAssignmentRecord = $context.$nodes.FETCH_ASSIGNMENT_DETAILS.$output.result;\n$context.$variables.employmentSession.AssignmentRecordPresent = true;\n\n$context.$variables.employmentSession.DisplayName = $context.$variables.workerSearch.singleMatchingRecord.DisplayName;\n\n// 3. Return the updated object\nreturn $context.$variables.employmentSession;"
