            {
              "id": "1773998874498_1",
              "name": "prompt",
              "type": "string",
              "value": "User request:\n{{$context.$system.$inputMessage}}\nGiven a user request describing an employee assignment change, choose exactly one `employmentProcess`.\n\nAllowed values:\n- Change Location\n- Transfers\n- ChangeAssignment\n\nRules:\n1. Choose \"Change Location\" only when the request changes location/work location only, and nothing else.\n2. Choose \"Transfers\" when the request changes Business Unit and/or Department only, and nothing else.\n3. Choose \"ChangeAssignment\" when:\n   - none of the above rules clearly apply\n   - the request changes multiple categories together\n   - the change is for job, position, business title, probation, union membership, work-from-home, building, floor, office, or any other assignment detail\n\nIgnore effective date, action, and reason when deciding the employment process.\n\nReturn only this JSON:\n{\n  \"employmentProcess\": \"<one allowed value>\"\n}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"employmentProcess\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
