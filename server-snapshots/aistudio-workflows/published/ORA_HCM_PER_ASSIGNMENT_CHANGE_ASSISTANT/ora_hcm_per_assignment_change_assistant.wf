        {
          "metadata": {
            "name": "setEmploymentProcessFromUserIntent",
            "returnType": "object",
            "sourceCode": "// 1. Check if it's null/undefined/non-object and initialize it globally\nif (!$context.$variables.employmentSession || typeof $context.$variables.employmentSession !== 'object') {\n    $context.$variables.employmentSession = {};\n}\n\n// 2. Now assign the property directly to the global object\n$context.$variables.employmentSession.SelectedEmploymentProcess = $context.$nodes.IDENTIFY_USER_INTENT.$output.employmentProcess;\n\n\nif($context.$nodes.EXTRACT_EMPLOYMENT_PROCESS_AND_DISPLAY_NAME_FROM_USER_INTENT.$output.IsDisplayNameProvided==false)\n$context.$variables.employmentSession.DisplayName= $context.$nodes.EXTRACT_EMPLOYMENT_PROCESS_AND_DISPLAY_NAME_FROM_USER_INTENT.$output.DisplayName;\nelse\n$context.$variables.employmentSession.DisplayName=  $context.$nodes.IDENTIFY_USER_INTENT.$output.DisplayName ;\n\n$context.$variables.employmentSession.deepLinkNeeded=  $context.$nodes.IDENTIFY_USER_INTENT.$output.deepLinkNeeded;\n\n// 3. Return the updated object\nreturn $context.$variables.employmentSession;"
          },
          "outcomes": {
            "success": "1771828869563"
          },
          "code": "SET_EMPLOYMENT_PROCESS_FROM_USER_INTENT",
          "id": "1771828758103",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
