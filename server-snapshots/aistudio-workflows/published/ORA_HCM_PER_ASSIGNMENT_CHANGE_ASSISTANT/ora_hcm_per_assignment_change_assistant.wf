            "name": "GetProbationDetailsByCodeNode",
            "returnType": "object",
            "sourceCode": "let ProbationEndDate = $context.$variables.employmentSession.listOfAttributes.ProbationEndDate;\nlet ProbationPeriod = $context.$variables.employmentSession.listOfAttributes.ProbationPeriod;\nlet ProbationPeriodUnit = $context.$variables.employmentSession.listOfAttributes.ProbationPeriodUnit;\nlet ProbationStartDate = $context.$nodes.FETCH_ASSIGNMENT_DETAILS.$output.result.AssignmentMap.ProbationStartDate;\n\nif(ProbationEndDate != undefined){\n     let initialDate = new Date(ProbationStartDate);\n\n      let initialYear = initialDate.getFullYear();\n      let initialMonth = initialDate.getMonth();\n      let initialDay = initialDate.getDate();\n\n      let newprobationEndDate = new Date(ProbationEndDate);\n      newprobationEndDate.setDate(newprobationEndDate.getDate() + 1);\n\n      let newYear = newprobationEndDate.getFullYear();\n      let newMonth = newprobationEndDate.getMonth();\n      let newDay = newprobationEndDate.getDate();\n\n      let duration = null, units = null;\n\n      if (initialDay != newDay) {\n\n        let totalDays = Math.round((newprobationEndDate - initialDate) / (1000 * 60 * 60 * 24));\n\n        if (totalDays % 7 == 0) {\n          duration = totalDays / 7;\n          units = 'W';\n        }\n        else {\n          duration = totalDays;\n          units = 'D';\n        }\n\n      }\n      else if (initialMonth != newMonth) {\n        let years = newYear - initialYear;\n        let months = years * 12 + newMonth - initialMonth;\n        duration = months;\n        units = 'M';\n      }\n      else if (initialYear != newYear) {\n        let years = newYear - initialYear;\n        duration = years;\n        units = 'Y';\n      }\n      else {\n        let hours = (newprobationEndDate - initialDate) / 60 * 60 * 1000;\n        duration = hours;\n        units = 'H';\n      }\n\n    ProbationPeriod = duration;\n    ProbationPeriodUnit = units;\n\n}\n\nelse if(ProbationPeriod != undefined && ProbationPeriodUnit != undefined){\n      let date = new Date(ProbationStartDate);\n      let timezone1 = date.toString().match(/GMT([+-]\\d{4})/)[1];\n      let duration = Number(ProbationPeriod);\n      let durationUnits = ProbationPeriodUnit;\n      const oneDay = 24 * 60 * 60 * 1000;\n      let numberDuration = Math.floor(duration);\n      let remFractionDuration = duration - numberDuration;\n\n      let isFloatingDuration = !Number.isInteger(duration);\n      switch (durationUnits) {\n        case 'H':\n          date.setDate(date.getDate() + Math.round(duration / 8));\n          break;\n        case 'D':\n          date.setDate(date.getDate() + Math.round(duration));\n          break;\n        case 'W':\n          date.setDate(date.getDate() + Math.round(duration * 7));\n          break;\n        case 'M':\n          date.setMonth(date.getMonth() + numberDuration);\n          let newDate = new Date(date.getFullYear(), date.getMonth() + 1, date.getDate());\n          const daysInMonth = Math.round(Math.abs(newDate - date) / oneDay);\n          date.setDate(date.getDate() + Math.round(daysInMonth * remFractionDuration));\n          break;\n        case 'Y':\n          date.setFullYear(date.getFullYear() + numberDuration);\n          if (remFractionDuration > 0) {\n            let fractionMonth = remFractionDuration * 12;\n            let numberMonth = Math.floor(fractionMonth);\n            let remFractionMonth = fractionMonth - numberMonth;\n            date.setMonth(date.getMonth() + numberMonth);\n            if (remFractionMonth > 0) {\n              let newDate = new Date(date.getFullYear(), date.getMonth() + 1, date.getDate());\n              const daysInMonth = Math.round(Math.abs(newDate.getTime() - date.getTime()) / oneDay);\n              date.setDate(date.getDate() + Math.round(daysInMonth * remFractionMonth));\n            }\n          }\n          break;\n        default:\n      }\n\n      // if date is greater than start date we will substract -1\n      const startDate = new Date(ProbationStartDate);\n      if (date > startDate) {\n        date.setDate(date.getDate() - 1);\n      }\n\n      let timezone2 = date.toString().match(/GMT([+-]\\d{4})/)[1];\n\n      if (timezone1 && timezone2 && timezone1 !== timezone2) {\n        // Calculate the offset difference in minutes\n        const diffMinutes = (parseInt(timezone2) - parseInt(timezone1)) / 100 * 60;\n\n        // Adjust the date's UTC time by that difference\n        date.setMinutes(date.getMinutes() + diffMinutes);\n      }\n\n      ProbationEndDate = date.toISOString().slice(0, 10);\n\n}\n\nelse if(ProbationPeriod != undefined){\n    ProbationEndDate = null;\n    ProbationPeriodUnit = null;\n}\nelse {\n    ProbationEndDate = null;\n    ProbationPeriod = null;\n}\n\nlet probationAttributes = {};\nprobationAttributes.ProbationEndDate = ProbationEndDate;\nprobationAttributes.ProbationPeriod = ProbationPeriod;\nprobationAttributes.ProbationPeriodUnit = ProbationPeriodUnit;\nreturn probationAttributes;"
          },
          "outcomes": {
            "success": "1771843972601"
          },
