nt-processui/fragments/seniority_dates_fragment\" },\n    { Name: \"storeTxnData\", Sequence: 11, VBResourceName: \"/vbcs/hcm/employment-processui/fragments/storeTxnData\" }\n  ]\n};\nconst transContextPayloadSequence = flowFragments[flow] || [];\n\n\nvar hcmParams = {};\nhcmParams[\"VBCS_INITIAL_ASSIGNMENT_SPLIT\"] = [\"Boolean\", \"True\"];\nhcmParams[\"AssignmentId\"] = [\"Long\", String(asg.AssignmentId)];\nif (flow === \"CHANGEMANAGER\") {\n  submittedFrom = \"AgentChangeManager\";\n}\nif (flow === \"CHANGEASSIGNMENT\") {\n  submittedFrom = \"AgentChangeAssignment\";\n  hcmParams[\"VBCS_IS_POSITION_SYNC_NEEDED\"] = [\"Boolean\", \"True\"];\n  if (act && act.ActionOccurrenceId !== undefined)\n    hcmParams[\"ActionOccurrencesRest_ActionOccurrenceId\"] = [\"Long\", String(act.ActionOccurrenceId)];\n  hcmParams[\"isResponsiveEFFFlow\"] = [\"Boolean\", \"True\"];\n  hcmParams[\"IsConcurrentTxnEnabled\"] = [\"String\", \"Y\"];\n  hcmParams[\"rulesClassPath\"] = [\n    \"String\",\n    \"oracle.apps.hcm.common.transaction.conflict.rule.EmploymentCommonConcurrentTxnConflictRules\"\n  ];\n  if (act && act.ActionTypeCode !== undefined)\n    hcmParams[\"EMP_Groovy_ActionTypeCode\"] = [\"String\", act.ActionTypeCode];\n  if (act && act.ActionCode !== undefined)\n    hcmParams[\"EMP_Groovy_ActionCode\"] = [\"String\", act.ActionCode];\n  hcmParams[\"EMP_Groovy_ActionReasonCode\"] = [\"String\", act.ActionReasonCode];\n\n  hcmParams[\"EMP_Groovy_ACT_OCC_ASSIGNMENT_ID\"] = [\"Long\", String(asg.AssignmentId)];\n  hcmParams[\"EMP_Groovy_ACT_OCC_PERIOD_OF_SERVICE_ID\"] = [\"String\", String(asg.PeriodOfServiceId)];\n  hcmParams[\"EMP_Groovy_ACT_OCC_PERSON_ID\"] = [\"Long\", String(asg.PersonId)];\n\n  hcmParams[\"EMP_Groovy_LegalEntityId\"] = [\"Long\", String(asg.LegalEntityId)];\n  hcmParams[\"EMP_Groovy_PeriodType\"] = [\"String\", \"E\"];\n  hcmParams[\"EMP_Groovy_LegislationCode\"] = [\"String\", asg.LegislationCode];\n\n  hcmParams[\"ModuleIdentifier\"] = [\"String\", \"ChangeAssignment\"];\n  hcmParams[\"EMP_ModuleIdentifier\"] = [\"String\", \"ChangeAssignment\"];\n\n  hcmParams[\"EMP_Groovy_NewLegalEntityId\"] = [\"Long\", String(asg.LegalEntityId)];\n  hcmParams[\"EMP_Groovy_NewLegislationCode\"] = [\"String\", asg.LegislationCode];\n\n  hcmParams[\"EMP_AssignmentId\"] = [\"Long\", String(asg.AssignmentId)];\n\n  hcmParams[\"isHDLWorker\"] = [\"String\", \"N\"];\n\n  hcmParams[\"EMP_Groovy_GradeStepId\"] = [\"String\", null];\n  hcmParams[\"EMP_FteValue\"] = [\"BigDecimal\", 1];\n  hcmParams[\"EMP_Groovy_GradeStepName\"] = [\"String\", null];\n\n}\n\n\n/* =====================================================\n   CHANGE LOCATION\n   ===================================================== */\n\nelse if (flow === \"CHANGELOCATION\") {\n  submittedFrom = \"AgentChangeLocation\";\n  hcmParams[\"VBCS_IS_POSITION_SYNC_NEEDED\"] = [\"Boolean\", \"True\"];\n  if (act && act.ActionOccurrenceId !== undefined)\n    hcmParams[\"ActionOccurrencesRest_ActionOccurrenceId\"] = [\"Long\", String(act.ActionOccurrenceId)];\n  hcmParams[\"isResponsiveEFFFlow\"] = [\"Boolean\", \"True\"];\n  hcmParams[\"IsConcurrentTxnEnabled\"] = [\"String\", \"N\"];\n  hcmParams[\"rulesClassPath\"] = [\n    \"String\",\n    \"oracle.apps.hcm.common.transaction.conflict.rule.EmploymentCommonTxnConflictRules\"\n  ];\n  if (act && act.ActionTypeCode !== undefined)\n    hcmParams[\"EMP_Groovy_ActionTypeCode\"] = [\"String\", act.ActionTypeCode];\n  if (act && act.ActionCode !== undefined)\n    hcmParams[\"EMP_Groovy_ActionCode\"] = [\"String\", act.ActionCode];\n  hcmParams[\"EMP_Groovy_ActionReasonCode\"] = [\"String\", act.ActionReasonCode];\n\n  hcmParams[\"EMP_Groovy_ACT_OCC_ASSIGNMENT_ID\"] = [\"Long\", String(asg.AssignmentId)];\n  hcmParams[\"EMP_Groovy_ACT_OCC_PERIOD_OF_SERVICE_ID\"] = [\"String\", String(asg.PeriodOfServiceId)];\n  hcmParams[\"EMP_Groovy_ACT_OCC_PERSON_ID\"] = [\"Long\", String(asg.PersonId)];\n\n  hcmParams[\"EMP_Groovy_LegalEntityId\"] = [\"Long\", String(asg.LegalEntityId)];\n  hcmParams[\"EMP_Groovy_PeriodType\"] = [\"String\", \"E\"];\n  hcmParams[\"EMP_Groovy_LegislationCode\"] = [\"String\", asg.LegislationCode];\n\n  hcmParams[\"ModuleIdentifier\"] = [\"String\", \"Change Location\"];\n  hcmParams[\"EMP_ModuleIdentifier\"] = [\"String\", \"Change Location\"];\n\n  hcmParams[\"EMP_Groovy_NewLegalEntityId\"] = [\"Long\", String(asg.LegalEntityId)];\n  hcmParams[\"EMP_Groovy_NewLegislationCode\"] = [\"String\", asg.LegislationCode];\n\n  hcmParams[\"EMP_AssignmentId\"] = [\"Long\", String(asg.AssignmentId)];\n\n  hcmParams[\"isHDLWorker\"] = [\"String\", \"N\"];\n\n  hcmParams[\"EMP_Groovy_GradeStepId\"] = [\"String\", null];\n  hcmParams[\"EMP_Groovy_GradeStepName\"] = [\"String\", null];\n\n}\n\n\n/* =====================================================\n   TRANSFERS\n   ===================================================== */\n\nelse if (flow === \"TRANSFERS\") {\n  submittedFrom = \"AgentTransfer\";\n  hcmParams[\"VBCS_IS_POSITION_SYNC_NEEDED\"] = [\"Boolean\", \"True\"];\n  if (act && act.ActionOccurrenceId !== undefined)\n    hcmParams[\"ActionOccurrencesRest_ActionOccurrenceId\"] = [\"Long\", String(act.ActionOccurrenceId)];\n  hcmParams[\"isResponsiveEFFFlow\"] = [\"Boolean\", \"True\"];\n  hcmParams[\"IsConcurrentTxnEnabled\"] = [\"String\", \"N\"];\n  hcmParams[\"rulesClassPath\"] = [\n    \"String\",\n    \"oracle.apps.hcm.common.transaction.conflict.rule.EmploymentCommonTxnConflictRules\"\n  ];\n  if (act && act.ActionTypeCode !== undefined)\n    hcmParams[\"EMP_Groovy_ActionTypeCode\"] = [\"String\", act.ActionTypeCode];\n  if (act && act.ActionCode !== undefined)\n    hcmParams[\"EMP_Groovy_ActionCode\"] = [\"String\", act.ActionCode];\n  hcmParams[\"EMP_Groovy_ActionReasonCode\"] = [\"String\", act.ActionReasonCode];\n\n  hcmParams[\"EMP_Groovy_ACT_OCC_ASSIGNMENT_ID\"] = [\"Long\", String(asg.AssignmentId)];\n  hcmParams[\"EMP_Groovy_ACT_OCC_PERIOD_OF_SERVICE_ID\"] = [\"String\", String(asg.PeriodOfServiceId)];\n  hcmParams[\"EMP_Groovy_ACT_OCC_PERSON_ID\"] = [\"Long\", String(asg.PersonId)];\n\n  hcmParams[\"EMP_Groovy_LegalEntityId\"] = [\"Long\", String(asg.LegalEntityId)];\n  hcmParams[\"EMP_Groovy_PeriodType\"] = [\"String\", \"E\"];\n  hcmParams[\"EMP_Groovy_LegislationCode\"] = [\"String\", asg.LegislationCode];\n\n  hcmParams[\"ModuleIdentifier\"] = [\"String\", \"Transfers\"];\n  hcmParams[\"EMP_ModuleIdentifier\"] = [\"String\", \"Transfers\"];\n\n  hcmParams[\"EMP_Groovy_NewLegalEntityId\"] = [\"Long\", String(asg.LegalEntityId)];\n  hcmParams[\"EMP_Groovy_NewLegislationCode\"] = [\"String\", asg.LegislationCode];\n\n  hcmParams[\"EMP_AssignmentId\"] = [\"Long\", String(asg.AssignmentId)];\n\n  hcmParams[\"isHDLWorker\"] = [\"String\", \"N\"];\n\n  hcmParams[\"EMP_Groovy_GradeStepId\"] = [\"String\", null];\n  hcmParams[\"EMP_Groovy_GradeStepName\"] = [\"String\", null];\n\n}\n\n/* ================= PAYLOAD ================= */\n\nvar parts = [];\n\n/* ContextInitialization */\nparts.push({\n  id: \"approvals\",\n  operation: \"create\",\n  path: \"/businessProcessTransactionContextInformation\",\n  payload: {\n    ModuleIdentifier: flowRaw,\n    Object: \"PER_ALL_ASSIGNMENTS_M\",\n    ObjectId: asg.AssignmentId,\n    OperationType: \"ContextInitialization\",\n    ReentryDeeplinkObjType: reEntryDeepLinkObjType,\n    ReentryDeeplinkAction: \"EDIT_IN_VB\",\n    ReentryDeeplinkObjKey: `pAssignmentId=${asg.AssignmentId};pEffectiveDate=${effDate};pDisplayName=${displayName};pPersonId=${asg.PersonId};pBusinessTitle=${asg.BusinessTitle};pPersonNumber=${workerSearchRecord.PersonNumber};pAssignmentNumber=${asg.AssignmentNumber}`,\n    OperationType: \"ContextInitialization\",\n    ApplicationId: 800,\n    ModuleGroup: \"PER\",\n    Subject: \"PER_PERSONS\",\n    SubjectId: asg.PersonId,\n    TransactionContextAdditionalAttributes: [\n      {\n        \"Name\": \"sensorNameFromData\",\n        \"Value\": displayName\n      },\n      {\n        \"Name\": \"Attribute30\",\n        \"Value\": \"VbAppUi\"\n      },\n      {\n        \"Name\": \"Attribute10\",\n        \"Value\": \"Mobile\"\n      }\n    ],\n    TransactionContextPayloadSequence: transContextPayloadSequence,\n    UserInteractionInformation: [\n      {\n        Name: \"WhenAndWhy\",\n        Value: \"Y\"\n      },\n      {\n        Name: \"Assignment\",\n        Value: \"Y\"\n      },\n      {\n        Name: \"SeniorityDates\",\n        Value: \"Y\"\n      },\n      {\n        Name: \"NeedHelp\",\n        Value: \"Y\"\n      }\n    ],\n    TransactionContextPayloadAttributes: []\n  }\n});\n\n\n/* initializeHcmParams */\nparts.push({\n  id: \"hcmparams\",\n  operation: \"invoke\",\n  path: \"/employmentAssignments/action/performOperationAndValidation\",\n  payload: {\n    operation: \"initializeHcmParams\",\n    hcmParams: hcm\n  }\n});\n\n/* submit assignment */\nparts.push({\n  id: \"assignmentPart\",\n  operation: \"invoke\",\n  path: \"/employmentAssignments/action/performOperationAndValidation\",\n  effectiveOf: `RangeStartDate=${effDate}`,\n  payload: {\n    operation: \"submit\",\n    inputParameterMap: inputparams,\n    assignmentModifiedAttributes: attrs,\n    hcmParams: hcmParams,\n    actionOccurrenceMap: actionOccMap\n  }\n});\n\n\n/* manager notes*/\nvar notesHtml = \"\";\n\nif (notes !== \"\") {\n  var noteParts = String(notes).split(/\\n\\s*\\n/);\n  for (var i = 0; i < noteParts.length; i++) {\n    var para = noteParts[i].trim();\n    if (para !== \"\") {\n      notesHtml += \"<p>\" + para + \"</p>\";\n    }\n  }\n}\n\nparts.push({\n  id: \"assignmentNotes\",\n  operation: \"create\",\n  path: \"/assignmentNotes\",\n  payload: {\n    Notes: notesHtml,\n    AssignmentId: asg.AssignmentId,\n    AsgEffectiveStartDate: effDate,\n    AsgEffectiveSequence: asg.EffectiveSequence\n  }\n});\n\n\n/* store txn data */\n\nvar reloadObj = {\n  SubmittedFrom: String(submittedFrom),\n  ActionOccurrenceId: String(act.ActionOccurrenceId),\n  ActionId: String(act.ActionId),\n  ActionDate: String(actionOccMap.ActionDate),\n  ActionCode: String(act.ActionCode),\n  ActionTypeCode: String(act.ActionTypeCode),\n  BusinessUnitId: String(actionOccMap.BusinessUnitId),\n  // Always include SetIds\n  JobSetId: attrs.JobSetId != null ? String(attrs.JobSetId) : null,\n  GradeSetId: attrs.GradeSetId != null ? String(attrs.GradeSetId) : null,\n  LocationSetId: attrs.LocationSetId != null ? String(attrs.LocationSetId) : null,\n  DepartmentSetId: attrs.DepartmentSetId != null ? String(attrs.DepartmentSetId) : null\n};\n\nif (act.ActionReasonId != null) {\n  reloadObj.ActionReasonId = String(act.ActionReasonId);\n}\n\nif (act.ActionReasonCode != null) {\n  reloadObj.ReasonCode = String(act.ActionReasonCode);\n}\n\n/* Add remaining attrs WITHOUT overwriting existing keys */\nfor (var key in attrs) {\n  if (attrs.hasOwnProperty(key) && !(key in reloadObj)) {\n    reloadObj[key] = attrs[key] != null ? String(attrs[key]) : null;\n  }\n}\n\nvar reloadInputdata = JSON.stringify(reloadObj);\n\n/*var reloadInputdata = `{\"SubmittedFrom\":\"${submittedFrom}\",\"ActionOccurrenceId\":\"${act.ActionOccurrenceId}\",\"ActionId\":\"${act.ActionId}\",\"ActionDate\":\"${actionOccMap.ActionDate}\",\"ActionCode\":\"${act.ActionCode}\",\"ActionTypeCode\":\"${act.ActionTypeCode}\",\"BusinessUnitId\":\"${actionOccMap.BusinessUnitId}\",\"JobSetId\":\"${attrs.JobSetId}\",\"GradeSetId\":\"${attrs.GradeSetId}\",\"LocationSetId\":\"${attrs.LocationSetId}\",\"DepartmentSetId\":\"${attrs.DepartmentSetId}\"`;\n\n// set all the attributes in attrs map to reloadInputdata except the keys already added to reloadInputdata\nfor (var key in attrs) {\n  if (attrs.hasOwnProperty(key)&& !(key in reloadInputdata)) {\n    reloadInputdata += `,\"${key}\":\"${attrs[key]}\"`;\n  }\n}\n\nreloadInputdata += \"}\";*/\nparts.push({\n  id: \"storeTxnData\",\n  operation: \"invoke\",\n  path: \"/employmentAssignments/action/processEmploymentTransactionData\",\n  payload: {\n    operation: \"storeTransactionData\",\n    inputParameterMap: {\n      ReloadInputData: reloadInputdata,\n      EffectiveDate: effDate\n    }\n  }\n});\n\n/* SubmitForApproval */\nparts.push({\n  id: \"submit\",\n  operation: \"create\",\n  path: \"/businessProcessTransactionContextInformation\",\n  payload: {\n    OperationType: \"SubmitForApproval\"\n  }\n});\n\nreturn { parts: parts };"
          },
