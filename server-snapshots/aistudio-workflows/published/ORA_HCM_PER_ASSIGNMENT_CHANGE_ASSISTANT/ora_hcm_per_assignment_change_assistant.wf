        {
          "metadata": {
            "name": "setInfoNeededData",
            "returnType": "object",
            "sourceCode": "var infoNeededVar =\n  $context.$variables.InfoNeededData || {};\n\nvar infoNeededAttr =\n  $context.$nodes.MERGE_ATTRIBUTES_INTO_EMPLOYMENT_SESSION.$output.result || {};\n\n\n/* ===== Update only if infoNeededAttr exists ===== */\n\nif (infoNeededAttr) {\n  infoNeededVar.InfoNeeded =\n    infoNeededAttr.infoNeeded;\n\n  infoNeededVar.InfoNeededString =\n    infoNeededAttr.infoNeededString;\n}\n\n\n/* ===== Check lovProcessed ===== */\n\n//var lovProcessed = $context.$variables.employmentSession?.lovProcessed;\n\n\n//if (lovProcessed == true) {\n\n\nlet buResult = $context.$nodes.PROCESS_BU_AND_DEPENDENT_ATTRIBUTES_BY_CODE?.$output?.result || null;\nconst buDependentResult = $context.$nodes.PROCESS_DEPENDENTS_OF_BU_WITH_SPECIFICSET?.$output?.result || null;\n\nconst actionResult = $context.$nodes.PROCESS_ACTION_AND_DEPENDENT_ATTRIBUTES_BY_CODE?.$output?.result || null;\n\n\nif(buResult== null && actionResult== null){\n\n  var updatedInfoNeededString = $context.$nodes.CREATE_INFO_NEEDED_STRING.$output.result;\n    /*$context.$nodes.UPDATE_INFO_NEEDED_STRING.$output.InfoNeededString;*/\n\n \n\n  var normalizedUpdated =\n    updatedInfoNeededString\n      ? updatedInfoNeededString.trim()\n      : \"\";\n\n  if (normalizedUpdated ===\"\" && $context.$variables.employmentSession?.lovProcessed==true) {\n    infoNeededVar.InfoNeeded = false;\n    infoNeededVar.InfoNeededString = \"\";\n  }\n\nelse if($context.$variables.employmentSession?.lovProcessed == true &&normalizedUpdated!==\"\" ){\ninfoNeededVar.InfoNeeded = true;\n\nvar infoNeededTableCreation = `Generate the HTML table with ONLY the following visible columns:\n1. Code\n2. Name\n\nDo NOT create a row number column.\nDo NOT create or display any column called \"Hidden Fields\".\nDo NOT display any sensitive or internal fields in the table.\n\nIf internal fields exist (such as Id, InternalId, PersonId, AssignmentId, etc.), include them as hidden input fields inside each table row but DO NOT create a visible column for them.\n\nAlways display only the rendered HTML table and the title text.\nNo raw HTML tags should be shown to the user.\n\nTable formatting rules:\n- border: 2px solid black applied to table, th, and td\n- border-collapse: collapse\n- Header row text in bold\n\nBelow the table add this text exactly:\n\"Please choose one record by providing the  Code\"`;\ninfoNeededVar.InfoNeededString = infoNeededTableCreation+ updatedInfoNeededString;\n}\n\n}\n\nreturn infoNeededVar;"
          },
