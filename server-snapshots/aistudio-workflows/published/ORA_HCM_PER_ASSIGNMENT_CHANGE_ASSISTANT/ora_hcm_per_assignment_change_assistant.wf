        {
          "metadata": {
            "name": "prepareActionReasonPayload",
            "returnType": "object",
            "sourceCode": "/* SOURCE DATA */\nvar employmentProcess = $context.$variables.employmentSession.SelectedEmploymentProcess;\n\nvar userAttributes =\n  $context.$variables.employmentSession.userAttributes;\n\nvar attributeData = $context.$nodes.EXTRACT_LOV_DATA_FROM_CODE.$output.LovAttributesToModify;\n\nvar effectiveDate =\n  $context.$variables.employmentSession.EffectiveDate;\n\n\nvar attributeFieldMap = {\n  \"ActionReason\": [\"ActionReasonId\", \"ActionReasonCode\", \"ActionReasonName\"]\n};\n\nvar actionReasonActionId =\"ActionReasonActionId\";\n\n/* BASE PAYLOAD */\nvar inputParameterMap = {\n  \"EffectiveDate\": effectiveDate,\n  \"RowLimit\": \"10\"\n};\n\n/*  — PROCEED ONLY IF ARRAY HAS VALUES */\nif (userAttributes.length > 0) {\n\n    /*  VALUE RESOLUTION */\n    /* RULE: If Id present → skip attribute */\n    /* Else Code > Name */\n    for (var i = 0; i < userAttributes.length; i++) {\n\n        var attributeName = userAttributes[i];\n        var fields = attributeFieldMap[attributeName];\n\n        if (!fields) {\n            continue; // skip unmonitored attributes\n        }\n\n        var idField = fields[0];\n        var codeField = fields[1];\n        var nameField = fields[2];\n\n        /* Skip attribute if Id exists */\n        if (attributeData.hasOwnProperty(idField)) {\n            continue;\n        }\n\n        /* Code precedence */\n        if (attributeData.hasOwnProperty(codeField)) {\n            inputParameterMap[codeField] = attributeData[codeField];\n        } else if (attributeData.hasOwnProperty(nameField)) {\n                inputParameterMap[nameField] = attributeData[nameField];\n        }\n    }\n}\n\nif($context.$nodes.PROCESS_ACTION_AND_DEPENDENT_ATTRIBUTES_BY_CODE?.$output?.result?.listOfAttributes?.ActionId){\n inputParameterMap[actionReasonActionId] = $context.$nodes.PROCESS_ACTION_AND_DEPENDENT_ATTRIBUTES_BY_CODE.$output.result.listOfAttributes.ActionId;\n}else if($context.$nodes.PROCESS_ACTION_AND_DEPENDENT_ATTRIBUTES_BY_CODE?.$output?.result?.listOfAttributes?.Action?.ActionId){\ninputParameterMap[actionReasonActionId] = $context.$nodes.PROCESS_ACTION_AND_DEPENDENT_ATTRIBUTES_BY_CODE?.$output?.result?.listOfAttributes?.Action?.ActionId;\n}else if($context.$variables.employmentSession.InitialAssignmentRecord.ActionOccurrenceMap.ActionId){\ninputParameterMap[actionReasonActionId] = $context.$variables.employmentSession.InitialAssignmentRecord.ActionOccurrenceMap.ActionId;\n}\n\nreturn JSON.stringify(inputParameterMap);"
          },
          "outcomes": {
            "success": "1775202075520"
          },
          "code": "PREPARE_ACTION_REASON_PAYLOAD",
          "id": "1775201913738",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "PreparePayloadForBUSpecificSet",
            "returnType": "object",
            "sourceCode": "/* SOURCE DATA */\n\nvar userAttributes = $context.$nodes.PROCESS_BU_AND_DEPENDENT_ATTRIBUTES_BY_CODE.$output.result.userAttributes;\nvar listOfAttributes = $context.$nodes.PROCESS_BU_AND_DEPENDENT_ATTRIBUTES_BY_CODE.$output.result.listOfAttributes;\n\nvar attributeData = $context.$nodes.IDENTIFY_USER_INTENT.$output.attributesToModifyKeyValueList.attributes;\n\nvar effectiveDate = $context.$variables.employmentSession.EffectiveDate;\n\n\n/* ATTRIBUTE FIELD MAPPING */\n\nvar attributeFieldMap = {\n    \"Department\": [\"DepartmentId\", \"DepartmentCode\", \"DepartmentName\"],\n    \"Position\": [\"PositionId\", \"PositionCode\", \"PositionName\"],\n    \"Job\": [\"JobId\", \"JobCode\", \"JobName\"],\n    \"Location\": [\"LocationId\", \"LocationCode\", \"LocationName\"]\n};\n\n\n/* ATTRIBUTE → SetId mapping (BU driven only) */\n\nvar setIdMap = {\n    \"Location\": \"LocationSetId\",\n    \"Department\": \"DepartmentSetId\",\n    \"Job\": \"JobSetId\",\n    \"Position\": \"PositionSetId\"\n};\n\n\n/* BASE PAYLOAD */\n\nvar inputParameterMap = {\n    \"EffectiveDate\": effectiveDate,\n    \"RowLimit\": \"10\"\n};\n\n\n/* Ensure BusinessUnit exists (already resolved externally) */\n\nvar businessUnitObject = null;\n\nif (\n    listOfAttributes &&\n    listOfAttributes.BusinessUnit\n) {\n    businessUnitObject = listOfAttributes.BusinessUnit;\n}\n\n\n/* PROCEED ONLY IF ATTRIBUTES EXIST */\n\nif (userAttributes && userAttributes.length > 0 ) {\n\n    for (var i = 0; i < userAttributes.length; i++) {\n\n        var attributeName = userAttributes[i];\n\n        var fields = attributeFieldMap[attributeName];\n\n        if (!fields) {\n            continue;\n        }\n\n\n\n        var idField = fields[0];\n        var codeField = fields[1];\n        var nameField = fields[2];\n\n        /* ----------------------------- */\n        /* ID → CODE → NAME RESOLUTION   */\n        /* ----------------------------- */\n\n        if (attributeData.hasOwnProperty(idField)) {\n         continue;\n        }\n        if (attributeData.hasOwnProperty(codeField)) {\n            inputParameterMap[codeField] = attributeData[codeField];\n        }\n        else if (attributeData.hasOwnProperty(nameField)) {\n            inputParameterMap[nameField] = attributeData[nameField];\n        }\n\n        /* ----------------------------- */\n        /* SET ID FROM BUSINESS UNIT     */\n        /* ----------------------------- */\n\n        if (businessUnitObject) {\n\n            var setIdKey = setIdMap[attributeName];\n\n            if ( setIdKey &&businessUnitObject.hasOwnProperty(setIdKey) ) {\n                inputParameterMap[setIdKey] = businessUnitObject[setIdKey];\n            }\n        }\n\n        if (attributeName === \"Position\") {\n            if (businessUnitObject && businessUnitObject.BusinessUnitId) {\n                inputParameterMap[\"BusinessUnitId\"] =\n                    businessUnitObject.BusinessUnitId;\n            } else {\n                inputParameterMap[\"BusinessUnitId\"] =\n                    $context.$variables.employmentSession.InitialAssignmentRecord.AssignmentMap.BusinessUnitId;\n            }\n        }\n    }\n}\n\nreturn JSON.stringify(inputParameterMap);"
          },
          "outcomes": {
            "success": "1772791267653"
          },
          "code": "PREPARE_PAYLOAD_FOR_BU_SPECIFICSET",
          "id": "1772791227353",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
