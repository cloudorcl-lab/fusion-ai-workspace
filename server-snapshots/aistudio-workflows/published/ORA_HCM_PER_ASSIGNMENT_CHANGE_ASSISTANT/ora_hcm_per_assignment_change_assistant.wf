        {
          "metadata": {
            "name": "PreparePayloadForBUDependentAttributesFromCommonSetByCode",
            "returnType": "object",
            "sourceCode": "/***** REFERENCE IDENTIFICATION & PAYLOAD CONSTRUCTION ENGINE *****/\n\n\n/* SOURCE DATA */\nvar employmentProcess= $context.$variables.employmentSession.SelectedEmploymentProcess;\n\nvar userAttributes =\n    $context.$variables.employmentSession.userAttributes;\n\n//var attributeData =\n //   $context.$nodes.IDENTIFY_USER_INTENT.$output\n  //  .attributesToModifyKeyValueList.attributes;\n\nvar attributeData = $context.$nodes.EXTRACT_LOV_DATA_FROM_CODE.$output.LovAttributesToModify ;\n\n\nvar effectiveDate =\n    $context.$variables.employmentSession.EffectiveDate;\n\n\n/* ATTRIBUTE FIELD MAPPING */\n\nvar attributeFieldMap = {\n    \"BusinessUnit\": [\"BusinessUnitId\", \"BusinessUnitCode\", \"BusinessUnitName\"],\n    \"Department\": [\"DepartmentId\", \"DepartmentCode\", \"DepartmentName\"],\n    \"Position\": [\"PositionId\", \"PositionCode\", \"PositionName\"],\n    \"Job\": [\"JobId\", \"JobCode\", \"JobName\"],\n    \"Location\": [\"LocationId\", \"LocationCode\", \"LocationName\"]\n};\n\n\n/* DEFAULT OUTPUT */\n\n/* BASE PAYLOAD */\n\nvar inputParameterMap = {\n    \"EffectiveDate\": effectiveDate,\n    \"RowLimit\": \"10\"\n};\n\n\n\n/*  — PROCEED ONLY IF ARRAY HAS VALUES */\n\nif (userAttributes.length > 0) {\n\n\n    /*  VALUE RESOLUTION */\n    /* RULE: If Id present → skip attribute */\n    /* Else Code > Name */\n\n    for (var i = 0; i < userAttributes.length; i++) {\n\n        var attributeName = userAttributes[i];\n        var fields = attributeFieldMap[attributeName];\n\n        if (!fields) {\n            continue;\n        }\n\n        if ($context.$variables.employmentSession.listOfAttributes &&\n            $context.$variables.employmentSession.listOfAttributes[attributeName] &&\n            Array.isArray($context.$variables.employmentSession.listOfAttributes[attributeName].listOfValues) &&\n            $context.$variables.employmentSession.listOfAttributes[attributeName].listOfValues.length > 0) {\n            continue;\n        }\n\n        var idField = fields[0];\n        var codeField = fields[1];\n        var nameField = fields[2];\n\n        if (attributeData.hasOwnProperty(idField)) {\n            continue;\n        }\n\n        if (attributeData.hasOwnProperty(codeField)) {\n          \n                inputParameterMap[codeField] = attributeData[codeField];\n        } else if (attributeData.hasOwnProperty(nameField)) {\n           \n                inputParameterMap[nameField] = attributeData[nameField];\n        }\n\n\n        if ($context.$variables.employmentSession.isSpecificSetSearchNeeded === true) {\n\n            var listOfAttributes = $context.$variables.employmentSession.listOfAttributes;\n\n            if (listOfAttributes\n                && listOfAttributes.BusinessUnit\n                && listOfAttributes.BusinessUnit.length === 1) {\n\n                var businessUnitObject = listOfAttributes.BusinessUnit[0];\n\n                var setIdMap = {\n                    \"Location\": \"LocationSetId\",\n                    \"Department\": \"DepartmentSetId\",\n                    \"Job\": \"JobSetId\",\n                    \"Position\": \"PositionSetId\"\n                };\n\n                var setIdKey = setIdMap[attributeName];\n\n                if (setIdKey && businessUnitObject.hasOwnProperty(setIdKey)) {\n                    inputParameterMap[setIdKey] = businessUnitObject[setIdKey];\n                }\n            }\n        }\n    }\n}\n\nreturn JSON.stringify(inputParameterMap);"
          },
          "outcomes": {
            "success": "1771925586542"
          },
          "code": "PREPARE_PAYLOAD_FOR_BU_DEPENDENT_ATTRIBUTES_FROM_COMMON_SET_BY_CODE",
          "id": "1772111166945",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "PreparePayloadForActionAndActionReasonByCode",
            "returnType": "object",
            "sourceCode": "/* SOURCE DATA */\nvar employmentProcess = $context.$variables.employmentSession.SelectedEmploymentProcess;\n\nvar userAttributes =\n  $context.$variables.employmentSession.userAttributes;\n\nvar attributeData =\n  $context.$nodes.IDENTIFY_USER_INTENT.$output.attributesToModifyKeyValueList.attributes;\n\nvar effectiveDate =\n  $context.$variables.employmentSession.EffectiveDate;\n\n\nvar attributeFieldMap = {\n  \"Action\": [\"ActionId\", \"ActionCode\", \"ActionName\"]\n};\n\n/* ACTION TYPE → EMPLOYMENT PROCESS MAPPING */\nvar actionTypeToEmploymentProcess = {\n  EMPL_CHANGE: \"ChangeAssignment\",\n  EMPL_TRANSFER: \"Transfers\",\n  EMPL_PROMOTION: \"Promotions\",\n  EMPL_CHG_LOCATION: \"Change Location\",\n  EMPL_CHG_MANAGER: \"Change Manager\",\n  EMPL_CHG_WORK_HOURS: \"Change Work Hours\"\n};\n\n/* BASE PAYLOAD */\nvar inputParameterMap = {\n  \"EffectiveDate\": effectiveDate,\n  \"RowLimit\": \"10\"\n};\n\n/*  — PROCEED ONLY IF ARRAY HAS VALUES */\nif (userAttributes.length > 0) {\n\n    /*  VALUE RESOLUTION */\n    /* RULE: If Id present → skip attribute */\n    /* Else Code > Name */\n    for (var i = 0; i < userAttributes.length; i++) {\n\n        var attributeName = userAttributes[i];\n        var fields = attributeFieldMap[attributeName];\n\n        if (!fields) {\n            continue; // skip unmonitored attributes\n        }\n\n        var idField = fields[0];\n        var codeField = fields[1];\n        var nameField = fields[2];\n\n        /* Skip attribute if Id exists */\n        if (attributeData.hasOwnProperty(idField)) {\n            continue;\n        }\n\n        /* Code precedence */\n        if (attributeData.hasOwnProperty(codeField)) {\n            inputParameterMap[codeField] = attributeData[codeField];\n        } else if (attributeData.hasOwnProperty(nameField)) {\n                inputParameterMap[nameField] = attributeData[nameField];\n        }\n    }\n\n    /* If ActionCode OR ActionName exists → add ActionTypeCodeList */\n    if (\n        inputParameterMap.hasOwnProperty(\"ActionCode\") ||\n        inputParameterMap.hasOwnProperty(\"ActionName\")\n    ) {\n        var actionCodes = [];\n\n        for (var actionType in actionTypeToEmploymentProcess) {\n            if (actionTypeToEmploymentProcess[actionType] === employmentProcess) {\n                actionCodes.push(actionType);\n            }\n        }\n\n        /* Your requirement: EMPL_CHANGE should include EMPL_DEMOTION */\n        if (actionCodes.includes(\"EMPL_CHANGE\")) {\n            actionCodes.push(\"EMPL_DEMOTION\");\n        }\n\n        inputParameterMap[\"ActionTypeCodeList\"] = actionCodes.join(\",\");\n    }\n}\n\nreturn JSON.stringify(inputParameterMap);"
          },
          "outcomes": {
            "success": "1772425570287"
          },
          "code": "PREPARE_PAYLOAD_FOR_ACTION_AND_ACTION_REASON_BY_CODE",
          "id": "1772424676148",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
