            "sourceCode": "let args={};\n\nlet extractLovDataFromCodeResult = $context.$nodes.EXTRACT_LOV_DATA_FROM_CODE.$output\nargs.ProposedLocation = $context.$variables.employmentSession.listOfAttributes?.Location?.LocationName  || extractLovDataFromCodeResult.LovAttributesToModify?.LocationName || \"\";\nargs.ProposedJob = $context.$variables.employmentSession.listOfAttributes?.Job?.JobName || extractLovDataFromCodeResult.LovAttributesToModify?.JobName || \"\";\nargs.ProposedDepartment = $context.$variables.employmentSession.listOfAttributes?.Department?.DepartmentName || extractLovDataFromCodeResult.LovAttributesToModify?.DepartmentName || \"\";\nargs.ProposedPosition = $context.$variables.employmentSession.listOfAttributes?.Position?.PositionName || extractLovDataFromCodeResult.LovAttributesToModify?.PositionName || \"\";\nargs.ProposedAction =  extractLovDataFromCodeResult.LovAttributesToModify?.ActionName || $context.$variables.employmentSession.InitialAssignmentRecord.ActionOccurrenceMap.ActionName;\n\n\nreturn args;"
          },
