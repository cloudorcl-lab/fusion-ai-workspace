        {
          "metadata": {
            "name": "createInfoNeededString",
            "returnType": "string",
            "sourceCode": "// 1. Retrieve the required variables\nvar userAttributes = $context.$variables.employmentSession.userAttributes;\nvar infoNeededString = $context.$variables.employmentSession?.infoNeededString;\n\n// 2. Immediate exit if no attributes are requested\nif (!userAttributes || userAttributes.length === 0 || infoNeededString==null) {\n    return \"\";\n}\n\n// 3. Normalization:\nvar normalizedAttrs = [];\nfor (var i = 0; i < userAttributes.length; i++) {\n    var attr = userAttributes[i];\n    normalizedAttrs.push(attr);\n}\n\n// 4. Split the infoNeededString into individual sections\n// We use the dashed separator as the boundary\nvar allSections = infoNeededString.split(\"--------------------------------------------------\");\n\n// 5. The mandatory header that starts the final string\nvar finalOutput = \"\\nIf multiple record groups are provided below, generate a separate HTML table for EACH group exactly as instructed.\\nRender all tables sequentially.\\nDo not merge tables.\\n\\n\";\n\nvar sectionFound = false;\n\n// 6. Loop through the requested attributes in order\nfor (var j = 0; j < normalizedAttrs.length; j++) {\n    var target = normalizedAttrs[j];\n\n    // Use filter to find the section that matches the current attribute\n    var matches = allSections.filter(function(section) {\n        return section.indexOf(\"attribute: \" + target) !== -1;\n    });\n\n    // If a matching section was found in the source string, append it\n    if (matches.length > 0) {\n        finalOutput += matches[0].trim();\n        finalOutput += \"\\n\\n--------------------------------------------------\\n\\n\";\n        sectionFound = true;\n    }\n}\n\n// 7. Final validation: if no sections matched the attributes, return empty\nif (!sectionFound) {\n    return \"\";\n}\n\nreturn finalOutput;"
          },
          "outcomes": {
            "success": "1771998288720"
          },
          "code": "CREATE_INFO_NEEDED_STRING",
          "id": "1773999927092",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
