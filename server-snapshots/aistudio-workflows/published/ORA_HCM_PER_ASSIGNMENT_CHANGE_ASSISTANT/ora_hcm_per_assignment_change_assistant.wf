        {
          "metadata": {
            "name": "PrepareChangeSummaryData",
            "returnType": "object",
            "sourceCode": "var session = $context.$variables.employmentSession;\n\nvar lovMod = $context.$nodes.EXTRACT_LOV_DATA_FROM_CODE.$output.LovAttributesToModify;\nif (!lovMod) lovMod = new Object();\n\nvar listAttr = session.listOfAttributes;\nif (!listAttr) listAttr = new Object();\n\nvar currentMap = (session.InitialAssignmentRecord && session.InitialAssignmentRecord.AssignmentMap);\nif (!currentMap) currentMap = new Object();\n\n/** ATTRIBUTE MAPPING */\nvar attributeMap = new Object();\nattributeMap.Job = \"JobName\";\nattributeMap.Location = \"LocationName\";\nattributeMap.Position = \"PositionName\";\nattributeMap.BusinessUnit = \"BusinessUnitName\";\nattributeMap.Department = \"DepartmentName\";\nattributeMap.Action = \"ActionName\";\nattributeMap.ActionReason = \"ActionReasonName\";\n\n/** PROBATION PERIOD UNIT MAPPING */\nvar probationPeriodUnitMap = new Object();\nprobationPeriodUnitMap.D = \"Days\";\nprobationPeriodUnitMap.W = \"Weeks\";\nprobationPeriodUnitMap.Y = \"Years\";\nprobationPeriodUnitMap.M = \"Months\";\nprobationPeriodUnitMap.H = \"Hours\";\n\n/** STEP 1 */\nvar allKeys = Object.keys(lovMod);\n\n/**Add Probation related keys */\nif(listAttr.ProbationEndDate != undefined || listAttr.ProbationPeriod != undefined || listAttr.ProbationPeriodUnit != undefined){\n      if (!allKeys.includes(\"ProbationEndDate\")) {\n             allKeys.push(\"ProbationEndDate\");\n       }\n       if (!allKeys.includes(\"ProbationPeriod\")) {\n             allKeys.push(\"ProbationPeriod\");\n       }\n       if (!allKeys.includes(\"ProbationPeriodUnit\")) {\n             allKeys.push(\"ProbationPeriodUnit\");\n       }\n}\n\n/** STEP 2 */\nvar filteredKeysSet = new Object();\n\nallKeys.forEach(function(key) {\n    var lowerKey = key.toLowerCase();\n\n    if (lowerKey.indexOf(\"id\") === -1 && lowerKey.indexOf(\"code\") === -1) {\n        filteredKeysSet[key] = true;\n        return;\n    }\n\n    for (var baseAttr in attributeMap) {\n        if (lowerKey.indexOf(baseAttr.toLowerCase()) !== -1) {\n            var nameKey = attributeMap[baseAttr];\n            filteredKeysSet[nameKey] = true;\n            break;\n        }\n    }\n});\n\n/** Convert set to array */\nvar filteredKeys = Object.keys(filteredKeysSet);\n\n/** STEP 3 */\nvar attributes = [];\n\nfilteredKeys.forEach(function(key) {\n\n    var lookupKey = key;\n    if (lookupKey === \"ActionName\" || lookupKey === \"ActionReasonName\" || lookupKey === \"ProbationPeriodUnit\") {\n      return; // skip these\n    }\n    /** Proposed */\n    var proposedValue = \"\";\n\n    if (lookupKey === \"BusinessUnitName\") {\n        proposedValue = lovMod[\"BusinessUnitName\"];\n    }\n\n     if (lookupKey === \"ProbationPeriod\"){\n         var probationPeriodUnitValue = listAttr.ProbationPeriodUnit;\n         proposedValue = listAttr.ProbationPeriod +\" \" +probationPeriodUnitMap[probationPeriodUnitValue];\n    }\n\n     if (lookupKey === \"ProbationEndDate\"){\n         proposedValue = listAttr.ProbationEndDate;\n    }\n\n    if (proposedValue === undefined || proposedValue === null || proposedValue === \"\") {\n        proposedValue = lovMod[lookupKey];\n    }\n\n    if (proposedValue === undefined || proposedValue === null || proposedValue === \"\") {\n        var baseAttr = null;\n\n        for (var attr in attributeMap) {\n            if (attributeMap[attr] === lookupKey) {\n                baseAttr = attr;\n                break;\n            }\n        }\n\n        if (baseAttr) {\n            proposedValue =\n                (listAttr[baseAttr] && listAttr[baseAttr][lookupKey]) ||\n                listAttr[lookupKey];\n        }\n    }\n\n /** Current */\n// For ActionName and ActionReasonName, use ActionOccurrenceMap if available\nvar currentValue = \"\";\n\nif (\n    (lookupKey === \"ActionName\" || lookupKey === \"ActionReasonName\") &&\n    session.InitialAssignmentRecord &&\n    session.InitialAssignmentRecord.ActionOccurrenceMap\n) {\n    currentValue = session.InitialAssignmentRecord.ActionOccurrenceMap[lookupKey];\n} else if (currentMap) {\n    currentValue = currentMap[lookupKey];\n}\n\n     if (lookupKey === \"ProbationPeriod\"){\n         var probationPeriodUnitValue = currentMap.ProbationPeriodUnit;\n          if(probationPeriodUnitMap[probationPeriodUnitValue] != undefined){\n                currentValue = currentMap.ProbationPeriod +\" \" +probationPeriodUnitMap[probationPeriodUnitValue];\n          }\n          else {\n               currentValue = \"\";\n          }\n    }\n\nif (currentValue === undefined || currentValue === null) {\n    currentValue = \"\";\n}\n\n    /** Change detection */\n    var isChanged = (proposedValue !== currentValue);\n\n    /** Label */\n    var labelMap = new Object();\n    labelMap.JobName = \"Job\";\n    labelMap.LocationName = \"Location\";\n    labelMap.PositionName = \"Position\";\n    labelMap.BusinessUnitName = \"Business Unit\";\n    labelMap.DepartmentName = \"Department\";\n    labelMap.ActionName = \"Action\";\n    labelMap.ActionReasonName = \"Action Reason\";\n\n    var label = labelMap[lookupKey];\n\n    //  Auto-format if not in labelMap\n    if (!label) {\n        label = lookupKey\n            .replace(/Name$/, \"\")                 // remove \"Name\"\n            .replace(/([a-z])([A-Z])/g, \"$1 $2\")  // split camel case\n            .trim();\n    }\n\n    attributes.push({\n        key: lookupKey,\n        label: label,\n        current: currentValue,\n        proposed: proposedValue,\n        changed: isChanged\n    });\n});\n\n/** FINAL OUTPUT */\nvar output = new Object();\noutput.attributes = attributes;\n\nreturn output;"
          },
          "outcomes": {
            "success": "1772013087024"
          },
          "code": "PREPARE_CHANGE_SUMMARY_DATA",
          "id": "1774437854060",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
