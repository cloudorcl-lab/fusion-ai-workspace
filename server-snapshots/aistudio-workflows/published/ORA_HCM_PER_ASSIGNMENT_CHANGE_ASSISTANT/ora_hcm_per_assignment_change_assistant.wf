          "code": "PROCESS_BU_AND_DEPENDENT_ATTR_FROM_COMMON_SET",
          "id": "1771925757703",
          "inputs": [
            {
              "id": "1771925757704_1",
              "name": "prompt",
              "type": "string",
              "value": "Process {{$context.$nodes.GET_BUSINESS_UNIT_ID_AND_DEPENDENT_ATTRIBUTES_FROM_COMMON_SET.$output}} as per the following processing rules\n\n##Processing Rules\n\n**Entire Output Empty\nIf the entire output is empty or null (no sections present at all):\n\nSet the output variable INFONEEDED = false\n\nProceed without asking for any information.\n\n**Section-wise Handling\n\nSections to evaluate:\nBusinessUnit,Job, Location, Department, Position\n\nProcess each section independently.\nIf a section is not present in the output, skip it completely (do not mention it).\n\n\n**Multiple Records in a Node\n\nIf a section contains more than one record: then set the output variable, INFONEEDED to true\n\n\n**Empty Node\n\nIf a node contains no records (empty array):\n\nset the output variable, INFONEEDED to true"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"INFONEEDED\": {\n            \"type\": \"boolean\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "ProcessActionAndDependentAttributes"
          },
          "outcomes": {
            "success": "1772426879131"
          },
          "code": "PROCESS_ACTION_AND_DEPENDENT_ATTRIBUTES",
          "id": "1772425986061",
          "inputs": [
            {
              "id": "1772425986062_1",
              "name": "prompt",
              "type": "string",
              "value": "Process {{$context.$nodes.GET_ACTION_OR_DEPENDENT_ATTRIBUTE.$output}} as per the following processing rules\n\n##Processing Rules\n\n**Entire Output Empty\nIf the entire output is empty or null (no sections present at all):\n\nSet the output variable INFONEEDED = false\n\nProceed without asking for any information.\n\n**Section-wise Handling\n\nSections to evaluate:\nAction\n\nProcess each section independently.\nIf a section is not present in the output, skip it completely (do not mention it).\n\n\n**Multiple Records in a Node\n\nIf a section contains more than one record: then set the output variable, INFONEEDED to true\n\n\n**Empty Node\n\nIf a node contains no records (empty array):\n\nset the output variable, INFONEEDED to true"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"INFONEEDED\": {\n            \"type\": \"boolean\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "ProcessBUandDependentAttributesByCode",
            "returnType": "object",
            "sourceCode": "var employmentSession = $context.$variables.employmentSession;\nvar userAttributes = employmentSession.userAttributes;\nvar response = $context.$nodes.GET_BUSINESS_UNIT_ID_AND_DEPENDENT_ATTRIBUTES_FROM_COMMON_SET.$output.result;\nvar isSpecificSetSearchNeeded = false;\nvar infoNeeded = false;\nvar infoNeededString = \"\";\nvar businessUnitPresent = false;\nvar output = {};\n\n\nif (!employmentSession.listOfAttributes) {\n    employmentSession.listOfAttributes = {};\n}\n\nvar listOfAttributes = employmentSession.listOfAttributes;\n\n/* Store initial instruction separately */\nvar initialInstruction = `\nIf multiple record groups are provided below, generate a separate HTML table for EACH group exactly as instructed.\nRender all tables sequentially.\nDo not merge tables.\n`;\nif (Array.isArray(userAttributes) && userAttributes.includes('BusinessUnit')) {\n    businessUnitPresent = true;\n}\ninfoNeededString = initialInstruction;\n\nfor (var key in response) {\n\n    if (!response.hasOwnProperty(key)) {\n        continue;\n    }\n\n    var records = response[key];\n\n    // ================= NO RECORDS =================\n    if (!Array.isArray(records) || records.length === 0) {\n\n        var lovProcess = employmentSession.lovProcessed === true;\n\n        isSpecificSetSearchNeeded = employmentSession.isSpecificSetSearchNeeded === true; // Ensure flag exists\n\n        if (employmentSession.isSpecificSetSearchNeeded === undefined) {\n            isSpecificSetSearchNeeded = false;\n        }\n        var isSpecificKey = [\n            \"Department\",\n            \"Job\",\n            \"Location\",\n            \"Position\"\n        ].includes(key);\n\n\n        // FIRST TIME: \n        // lovProcess is false OR undefined AND specific set search not already triggered \n\n        if (isSpecificKey && !lovProcess && !isSpecificSetSearchNeeded && businessUnitPresent) {\n            isSpecificSetSearchNeeded = true;\n        }\n\n        // SECOND TIME OR OTHER CASES\n        else {\n            isSpecificSetSearchNeeded = false;\n            infoNeeded = true;\n            if (key == \"BusinessUnit\") {\n                infoNeededString += `No records were found for Business Unit. Please ask the user: \"No records were found for Business Unit. Can you provide the exact value to proceed with this Business Unit?\"\n\n                   -------------------------------------------------- `;\n            } else {\n                infoNeededString += `No records were found for ${key}. Please ask the user: \"No records were found for ${key}. Can you provide the exact value to proceed with this ${key}?\"\n                                                  -------------------------------------------------- `;\n            }\n        }\n        continue;\n    }\n    // ================= SINGLE RECORD =================\n    if (records.length === 1) {\n\n        listOfAttributes[key] = records[0];\n\n        var index = userAttributes.indexOf(key);\n        if (index !== -1) {\n            userAttributes.splice(index, 1);\n        }\n    }\n\n    // ================= MULTIPLE RECORDS =================\n    else {\n\n        infoNeeded = true;\n\n        listOfAttributes[key] = {\n            listOfValues: records\n        };\n\n        var isDepartment = key === \"Department\";\n\n        infoNeededString += `\nDisplay the following records for the attribute: ${key}\n\nAbove the table, display this title exactly:\n\"Selection Required for ${key}\"\n\nAdd spacing before and after each table using:\n<br><br>\n\nGenerate the HTML table with ONLY the following visible columns:\n${isDepartment ? \"1. Name\" : \"1. Code\\n2. Name\"}\n\n\nDo NOT create a row number column.\nDo NOT create or display any column called \"Hidden Fields\".\nDo NOT display any sensitive or internal fields in the table.\n\nIf internal fields exist (such as Id, InternalId, PersonId, AssignmentId, etc.), include them as hidden input fields inside each table row but DO NOT create a visible column for them.\n\nAlways display only the rendered HTML table and the title text.\nNo raw HTML tags should be shown to the user.\n\nTable formatting rules:\n- border: 2px solid black applied to table, th, and td\n- border-collapse: collapse\n- Header row text in bold\n- the th and td must be left aligned.\n\nBelow the table add this text exactly:\n\"Please choose one record by providing the ${key} ${isDepartment ? \"Name\" : \"Code\"}\"\n\nThis text must not be part of the table.\n\n${key} Records to be Displayed in HTML table:\n${JSON.stringify(records)}\n\n--------------------------------------------------\n\n<br><br>\n`;\n    }\n}\n\n/* ================= FINAL CHECK ================= */\n\n// If nothing was appended beyond the initial instruction\nif (infoNeededString.trim() === initialInstruction.trim()) {\n    infoNeeded = false;\n    infoNeededString = \"\";\n}\n\n/* ================= SAVE BACK ================= */\n\noutput[\"listOfAttributes\"] = listOfAttributes;\noutput[\"userAttributes\"] = userAttributes;\noutput[\"infoNeeded\"] = infoNeeded;\noutput[\"infoNeededString\"] = infoNeededString;\noutput[\"isSpecificSetSearchNeeded\"] = isSpecificSetSearchNeeded;\nreturn output;"
          },
          "outcomes": {
            "success": "1771930756993"
          },
          "code": "PROCESS_BU_AND_DEPENDENT_ATTRIBUTES_BY_CODE",
          "id": "1771926712112",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "ProcessActionAndDependentAttributesByCode",
            "returnType": "object",
            "sourceCode": "var employmentSession = $context.$variables.employmentSession;\nvar userAttributes = employmentSession.userAttributes;\nvar response = $context.$nodes.GET_ACTION_OR_DEPENDENT_ATTRIBUTE.$output.result;\n\nvar infoNeeded = false;\nvar infoNeededString = \"\";\nvar output = {};\n\nif (!employmentSession.listOfAttributes) {\n    employmentSession.listOfAttributes = {};\n}\n\nvar listOfAttributes = employmentSession.listOfAttributes;\n\n/* Store initial instruction separately */\nvar initialInstruction = `\nIf multiple record groups are provided below, generate a separate HTML table for EACH group exactly as instructed.\nRender all tables sequentially.\nDo not merge tables.\n`;\n\ninfoNeededString = initialInstruction;\n\nfor (var key in response) {\n\n    if (!response.hasOwnProperty(key)) {\n        continue;\n    }\n\n    var records = response[key];\n\n    // ================= NO RECORDS =================\n    if (!Array.isArray(records) || records.length === 0) {\n\n        infoNeeded = true;\n\n        infoNeededString += `\nNo records were found for ${key}.\nPlease ask the user:\n\"No records were found for ${key} Name. Can you provide the exact value to proceed with this ${key}?\"\n\n--------------------------------------------------\n`;\n        continue;\n    }\n\n    // ================= SINGLE RECORD =================\n    if (records.length === 1) {\n\n        listOfAttributes[key] = records[0];\n\n        var index = userAttributes.indexOf(key);\n        if (index !== -1) {\n            userAttributes.splice(index, 1);\n        }\n    }\n\n    // ================= MULTIPLE RECORDS =================\n    else {\n\n        infoNeeded = true;\n\n        listOfAttributes[key] = {\n            listOfValues: records\n        };\n\n        infoNeededString += `\nDisplay the following records for the attribute: ${key}\n\nAbove the table, display this title exactly:\n\"Selection Required for ${key}\"\n\nAdd spacing before and after each table using:\n<br><br>\n\nGenerate the HTML table with ONLY the following visible columns:\n1. Code\n2. Name\n\nDo NOT create a row number column.\nDo NOT create or display any column called \"Hidden Fields\".\nDo NOT display any sensitive or internal fields in the table.\n\nIf internal fields exist (such as Id, InternalId, PersonId, AssignmentId, etc.), include them as hidden input fields inside each table row but DO NOT create a visible column for them.\n\nAlways display only the rendered HTML table and the title text.\nNo raw HTML tags should be shown to the user.\n\nTable formatting rules:\n- border: 2px solid black applied to table, th, and td\n- border-collapse: collapse\n- Header row text in bold\n- the th and td must be left aligned.\n\nBelow the table add this text exactly:\n\"Please choose one record by providing the ${key} Code\"\n\nThis text must not be part of the table.\n\n${key} Records to be Displayed in HTML table:\n${JSON.stringify(records)}\n\n--------------------------------------------------\n\n<br><br>\n`;\n    }\n}\n\n/* ================= FINAL CHECK ================= */\n\n// If nothing was appended beyond the initial instruction\nif (infoNeededString.trim() === initialInstruction.trim()) {\n    infoNeeded = false;\n    infoNeededString = \"\";\n}\n\n/* ================= SAVE BACK ================= */\n\noutput[\"listOfAttributes\"] = listOfAttributes;\noutput[\"userAttributes\"] = userAttributes;\noutput[\"infoNeeded\"] = infoNeeded;\noutput[\"infoNeededString\"] = infoNeededString;\n\nreturn output;"
          },
          "outcomes": {
            "success": "1775201881254"
          },
          "code": "PROCESS_ACTION_AND_DEPENDENT_ATTRIBUTES_BY_CODE",
          "id": "1772426879131",
          "inputs": [],
