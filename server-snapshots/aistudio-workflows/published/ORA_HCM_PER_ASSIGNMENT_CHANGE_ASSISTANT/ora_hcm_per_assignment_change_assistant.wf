          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "EvaluateLovAttribute",
            "returnType": "object",
            "sourceCode": "var lovToBeprocessed = {\n    BusinessUnitRelatedAttribute: false,\n    UnionRelatedAttribute: false,\n    ActionRelatedAttribute: false,\n    ManagerName: false,\n    ActionReason:false\n};\n\nvar employmentSession = $context.$variables.employmentSession || {};\nvar userAttributes = employmentSession.userAttributes || [];\n\nvar allowedKeysForBU = [\"BusinessUnit\", \"Department\", \"Job\", \"Position\",\"Location\"];\nvar allowedKeysForAction=[\"Action\",\"ActionReason\"];\nvar allowedKeysForUnion = [\"Union\", \"BargainingUnit\", \"CollectiveAgreement\"];\n\n/* ===== Process Attributes ===== */\n\nfor (var i = 0; i < userAttributes.length; i++) {\n\n    var attr = userAttributes[i];\n\n    if (allowedKeysForBU.includes(attr)) {\n        lovToBeprocessed.BusinessUnitRelatedAttribute = true;\n    }\n    else if (allowedKeysForUnion.includes(attr)) {\n        lovToBeprocessed.UnionRelatedAttribute = true;\n    }\n    else if(allowedKeysForAction.includes(attr)) {\n       lovToBeprocessed.ActionRelatedAttribute= true;\n       if (attr === \"ActionReason\") {\n        lovToBeprocessed.ActionReason = true;\n       }\n    }\n    else if (attr === \"ManagerName\") {\n        lovToBeprocessed.ManagerName = true;\n    }\n}\n\nreturn lovToBeprocessed;"
          },
          "outcomes": {
            "success": "1771851719798"
          },
          "code": "EVALUATE_LOV_ATTRIBUTE",
          "id": "1771852724643",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
