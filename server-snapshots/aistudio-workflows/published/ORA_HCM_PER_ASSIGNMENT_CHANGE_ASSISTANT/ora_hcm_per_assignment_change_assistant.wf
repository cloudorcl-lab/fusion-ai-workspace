        {
          "metadata": {
            "name": "setInfoNeededToGetTheMatchingRecords",
            "returnType": "object",
            "sourceCode": "// 1. Check if it's null/undefined/non-object and initialize it globally\nif (!$context.$variables.InfoNeededData || typeof $context.$variables.InfoNeededData !== 'object') {\n    $context.$variables.InfoNeededData = {};\n}\n\n// 2. Now assign the property directly to the global object\n$context.$variables.InfoNeededData.InfoNeeded = true;\n\nconst workerData =  $context.$variables.workerSearch.multipleMatchingRecords || [];\n\n$context.$variables.InfoNeededData.InfoNeededString = `\nDisplay these Worker Assignment records to the user in an left aligned HTML Table.\n\nDisplay all attributes in the table, but set the HTML hidden attribute for \"AssignmentId\" and \"PersonId\" because they are sensitive fields but still required in the chat history. So, include them in the HTML table as hidden inputs.\nDo not show Assignment Id , Person Id for the user\n\nAlways display only the HTML table and no html tags must be shown to the user at any point of time.\n\nGenerate the table in HTML with:\n1. border: 2px solid black applied to table, th, and td\n2. border-collapse: collapse\n3. Header row text in bold\n4. Only the following columns needs to be visible in the table and in the following table \"Display Name, Business Title, Person Number, Assignment Number\"\n5. Always make sure that the th and td are left aligned.\n\nBelow the table add this text exactly \"Please choose one record by providing the Assignment Number\". This is not part of the table at all\n\nWorker Assignment Records to be Displayed in HTML table: ${JSON.stringify(workerData,null,2)}\n`;\n\n\n// 3. Return the updated object\nreturn $context.$variables.InfoNeededData;"
          },
          "outcomes": {
            "success": "1771915026605"
          },
          "code": "SET_INFO_NEEDED_TO_GET_THE_MATCHING_RECORDS",
          "id": "1771844420604",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
