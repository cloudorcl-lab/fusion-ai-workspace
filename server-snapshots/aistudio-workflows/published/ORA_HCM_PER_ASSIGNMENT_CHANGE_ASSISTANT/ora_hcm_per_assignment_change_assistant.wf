        {
          "metadata": {
            "name": "preparePayload",
            "returnType": "object",
            "sourceCode": "/* ================= CONTEXT ================= */\nvar employmentSession = $context.$variables.employmentSession;\nvar sourceAttrs = employmentSession &&\n                  employmentSession.listOfAttributes;\nvar asg = employmentSession &&\n          employmentSession.InitialAssignmentRecord &&\n          employmentSession.InitialAssignmentRecord.AssignmentMap;\n\nvar act = employmentSession &&\n          employmentSession.InitialAssignmentRecord &&\n          employmentSession.InitialAssignmentRecord.ActionOccurrenceMap;\n\nvar notes = $context.$variables.managerNotes || \"\";\n\t\t  \nif (act && sourceAttrs) {\n  if (sourceAttrs.ActionId !== undefined) act.ActionId = sourceAttrs.ActionId;\n  else if (sourceAttrs.Action && sourceAttrs.Action.ActionId !== undefined) act.ActionId = sourceAttrs.Action.ActionId;\n\n  if (sourceAttrs.ActionCode !== undefined)act.ActionCode = sourceAttrs.ActionCode;\n  else if (sourceAttrs.Action && sourceAttrs.Action.ActionCode !== undefined) act.ActionCode = sourceAttrs.Action.ActionCode;\n\n  if (sourceAttrs.ActionName !== undefined)act.ActionName = sourceAttrs.ActionName;\n\n  if (sourceAttrs.Action && sourceAttrs.Action.ActionTypeCode !== undefined)\n    act.ActionTypeCode = sourceAttrs.Action.ActionTypeCode;\n\n var actionReason = sourceAttrs.ActionReason || {};\n\nvar actionReasonId = sourceAttrs.ActionReasonId   || actionReason.ActionReasonId   || null;\nvar actionReasonCode = sourceAttrs.ActionReasonCode || actionReason.ActionReasonCode || null;\n\nact.ActionReasonId =  actionReasonId ? String(actionReasonId)   : null;\nact.ActionReasonCode = actionReasonCode ? String(actionReasonCode) : null;\n}\n\nvar flowRaw = employmentSession && employmentSession.SelectedEmploymentProcess;\nvar workerSearchRecord = $context.$variables.workerSearch.singleMatchingRecord;\nvar flow = (flowRaw || \"\").toUpperCase().replace(/\\s+/g, '');\nvar submittedFrom;\n\n/* ================= HCM PARAMS for initialization ================= */\n\nvar hcm = {};\n\nif (act && act.ActionTypeCode !== undefined)\n  hcm[\"EMP_Groovy_ActionTypeCode\"] = [\"String\", act.ActionTypeCode];\n\nif (act && act.ActionCode !== undefined)\n  hcm[\"EMP_Groovy_ActionCode\"] = [\"String\", act.ActionCode];\n\n/* must retain null */\nhcm[\"EMP_Groovy_ActionReasonCode\"] = [\"String\", act.ActionReasonCode];\n\nif (asg && asg.AssignmentId !== undefined)\n  hcm[\"EMP_Groovy_ACT_OCC_ASSIGNMENT_ID\"] = [\"Long\", asg.AssignmentId];\n\nif (asg && asg.PeriodOfServiceId !== undefined)\n  hcm[\"EMP_Groovy_ACT_OCC_PERIOD_OF_SERVICE_ID\"] = [\"String\", asg.PeriodOfServiceId];\n\nif (asg && asg.PersonId !== undefined)\n  hcm[\"EMP_Groovy_ACT_OCC_PERSON_ID\"] = [\"Long\", asg.PersonId];\n\nif (asg && asg.AssignmentId !== undefined)\n  hcm[\"AssignmentId\"] = [\"Long\", asg.AssignmentId];\n\nif (asg && asg.LegalEntityId !== undefined)\n  hcm[\"EMP_Groovy_LegalEntityId\"] = [\"Long\", asg.LegalEntityId];\n\nif (asg && asg.LegislationCode !== undefined)\n  hcm[\"EMP_Groovy_LegislationCode\"] = [\"String\", asg.LegislationCode];\n\nif (flowRaw !== undefined) {\n  hcm[\"ModuleIdentifier\"] = [\"String\", flowRaw];\n  hcm[\"EMP_ModuleIdentifier\"] = [\"String\", flowRaw];\n}\n\nif (asg && asg.AssignmentId !== undefined)\n  hcm[\"EMP_AssignmentId\"] = [\"Long\", asg.AssignmentId];\n\nhcm[\"isHDLWorker\"] = [\"String\", \"N\"];\nhcm[\"EMP_Groovy_GradeStepId\"] = [\"String\", null];\nhcm[\"EMP_Groovy_GradeStepName\"] = [\"String\", null];\nhcm[\"EMP_FteValue\"] = [\"BigDecimal\", 1];\n\n/* Manager */\n/*\nif(flow===\"CHANGEMANAGER\"){\n  hcm[\"EMP_Groovy_NewManagerAssignmentId\"] = [\"Long\", ...];\n}\n*/\n\n/* CHANGE LOCATION */\nif (flow === \"CHANGELOCATION\") {\n  var newLoc = employmentSession.listOfAttributes?.Location?.LocationId;\n  if (newLoc !== undefined)\n    hcm[\"EMP_Groovy_NewLocationId\"] = [\"Long\", newLoc];\n\n}\n\n/* ================= ASSIGNMENT ATTRS ================= */\n\nvar attrs = {};\n\n/* ---------------- Effective Date ---------------- */\nlet effDate;\n\nif (employmentSession && employmentSession.EffectiveDate != null) {\n  effDate = employmentSession.EffectiveDate;\n  attrs[\"EffectiveOfDate\"] = effDate;\n}\n\n\n/* ----------------  Set IDs ---------------- */\n\nif (asg) {\n\n  if (asg.JobSetId != null) attrs[\"JobSetId\"] = asg.JobSetId;\n  if (asg.GradeSetId != null) attrs[\"GradeSetId\"] = asg.GradeSetId;\n  if (asg.LocationSetId != null) attrs[\"LocationSetId\"] = asg.LocationSetId;\n  if (asg.DepartmentSetId != null) attrs[\"DepartmentSetId\"] = asg.DepartmentSetId;\n}\n\n\n/* ---------------- Direct attributes from employmentSession.listOfAttributes---------------- */\n\n\n\nif (sourceAttrs && typeof sourceAttrs === \"object\") {\n\n  const supportedFields = [\n    \"JobId\",\n    \"DepartmentId\",\n    \"LocationId\",\n    \"PositionId\",\n    \"UnionId\",\n\t\"JobSetId\",\n\t\"GradeSetId\",\n\t\"LocationSetId\",\n\t\"DepartmentSetId\",\n    \"BargainingUnitId\",\n    \"CollectiveAgreementId\",\n    \n\t\"BusinessUnitId\",\n    \"InternalBuilding\",\n    \"InternalFloor\",\n    \"InternalOfficeNumber\",\n    \"ProbationPeriod\",\n    \"ProbationPeriodUnit\",\n    \"ProbationStartDate\",\n    \"ProbationEndDate\",\n    \"UnionMemberFlag\",\n    \"ManagerFlag\",\n    \"WorkAtHomeFlag\",\n    \"BusinessTitle\",\n     \"ActionId\",\n     \"ActionReasonId\"\n  ];\n\n  supportedFields.forEach(function(field) {\n    if (sourceAttrs[field] != null) {\n\t\t\n        attrs[field] = sourceAttrs[field];\n\t\t\n    }\n  });\n\n\nif(sourceAttrs[\"JobName\"]!=null && sourceAttrs[\"BusinessTitle\"]==null){\n    attrs[\"BusinessTitle\"] = sourceAttrs[\"JobName\"];\n}\n\n/* ---------------- ID Attributes from employmentSession.listOfAttributes ---------------- */\n\n\n/* ===== Attribute → Id Mapping ===== */\n\nvar attributeIdMap = {\n    Job: \"JobId\",\n    Department: \"DepartmentId\",\n    Location: \"LocationId\",\n    Position: \"PositionId\",\n    Union: \"UnionId\",\n    BargainingUnit: \"BargainingUnitId\",\n    CollectiveAgreement: \"CollectiveAgreementId\",\n    BusinessUnit: \"BusinessUnitId\",\n    Action: \"ActionId\",\n    ActionReason: \"ActionReasonId\"\n};\n\n/* ===== Extract IDs Dynamically ===== */\n\nfor (var key in attributeIdMap) {\n\n    var idField = attributeIdMap[key];\n\n    if (\n        sourceAttrs[key] &&\n        sourceAttrs[key][idField]\n    ) {\n\t\t\n            attrs[idField] = sourceAttrs[key][idField]\n    }\n}\n\n}\n\n\nif (act && act.ActionCode !== undefined && !attrs[\"ActionCode\"]) attrs[\"ActionCode\"] = act.ActionCode;\nif (act && act.ActionOccurrenceId !== undefined) attrs[\"ActionOccurrenceId\"] = act.ActionOccurrenceId;\nif (act && act.ActionTypeCode !== undefined) attrs[\"ActionTypeCode\"] = act.ActionTypeCode;\nif (asg && asg.LegislationCode !== undefined) attrs[\"AsgInformationCategory\"] = asg.LegislationCode;\nif (act && act.ActionReasonCode !== undefined && !attrs[\"ReasonCode\"])attrs[\"ReasonCode\"] = act.ActionReasonCode;\n\n/* ================= INPUT PARAMS ================= */\nvar inputparams = {};\nvar displayName = employmentSession.DisplayName;\ninputparams[\"DisplayName\"] = displayName;\ninputparams[\"PersonId\"] = asg.PersonId;\ninputparams[\"AssignmentId\"] = asg.AssignmentId;\ninputparams[\"EffectiveDate\"] = effDate;\ninputparams[\"PersonNumber\"] = asg.PersonNumber;\ninputparams[\"ModuleIdentifier\"] = flowRaw;\ninputparams[\"EffectiveStartDate\"] = asg.EffectiveStartDate;\ninputparams[\"EffectiveEndDate\"] = asg.EffectiveEndDate;\ninputparams[\"EffectiveLatestChange\"] = asg.EffectiveLatestChange;\ninputparams[\"EffectiveSequence\"] = asg.EffectiveSequence;\n\nvar actionOccMap = {};\nactionOccMap[\"ActionOccurrenceId\"] = act.ActionOccurrenceId;\nactionOccMap[\"ActionId\"] = act.ActionId;\nactionOccMap[\"ActionDate\"] = effDate;\nactionOccMap[\"ActionReasonId\"]   = (act && act.ActionReasonId   !== undefined) ? act.ActionReasonId   : null;\nactionOccMap[\"ActionReasonCode\"] = (act && act.ActionReasonCode !== undefined) ? act.ActionReasonCode : null;\nactionOccMap[\"ProposedStartDate\"] = null;\nactionOccMap[\"BusinessUnitId\"] = (attrs[\"BusinessUnitId\"] !== undefined && attrs[\"BusinessUnitId\"] !== null) ? attrs[\"BusinessUnitId\"] : asg.BusinessUnitId;\nactionOccMap[\"PositionId\"] = asg.PositionId;\nactionOccMap[\"EntityId\"] = asg.AssignmentId;\nactionOccMap[\"EntityType\"] = \"ASSIGNMENT\";\nactionOccMap[\"ParentEntityKeyId\"] = asg.PersonId;\nactionOccMap[\"ParentEntityType\"] = \"PERSON\";\nactionOccMap[\"ParentEntityName\"] = displayName;\nactionOccMap[\"ActionTypeCode\"] = act.ActionTypeCode;\nactionOccMap[\"ActionCode\"] = act.ActionCode;\nactionOccMap[\"ActionName\"] = act.ActionName;\n\nlet reEntryDeepLinkObjType = { CHANGEASSIGNMENT: \"CHANGE_ASSIGNMENT\", CHANGELOCATION: \"CHANGE_LOCATION\", TRANSFERS: \"TRANSFER\", CHANGEMANAGER: \"CHANGE_MANAGER\" }[flow];\n;\n// TransactionCotextPayloadSequnece\nconst flowFragments = {\n  CHANGEASSIGNMENT: [\n    { Name: \"oracle_hcm_employmentprocessUI:combined_when_and_why_fragment\", Sequence: 1, VBResourceName: \"/vbcs/hcm/employment-processui/fragments/combined_when_and_why_fragment\" },\n    { Name: \"oracle_hcm_employmentprocessUI:combined_position_override_fragment\", Sequence: 2, VBResourceName: \"/vbcs/hcm/employment-processui/fragments/combined_position_override_fragment\" },\n    { Name: \"oracle_hcm_employmentprocessUI:combined_additional_assignment_info_fragment\", Sequence: 3, VBResourceName: \"/vbcs/hcm/employment-processui/fragments/combined_additional_assignment_info_fragment\" },\n    { Name: \"oracle_hcm_employmentprocessUI:combined_assignment_fragment\", Sequence: 4, VBResourceName: \"/vbcs/hcm/employment-processui/fragments/combined_assignment_fragment\" },\n    { Name: \"oracle_hcm_employmentprocessUI:combined_weeklyworkinghours_fragment\", Sequence: 5, VBResourceName: \"/vbcs/hcm/employment-processui/fragments/combined_weeklyworkinghours_fragment\" },\n    { Name: \"oracle_hcm_employmentprocessUI:combined_maintain_managers_fragment\", Sequence: 6, VBResourceName: \"/vbcs/hcm/employment-processui/fragments/combined_maintain_managers_fragment\" },\n    { Name: \"oracle_hcm_employmentprocessUI:combined_contracts_fragment\", Sequence: 7, VBResourceName: \"/vbcs/hcm/employment-processui/fragments/combined_contracts_fragment\" },\n    { Name: \"oracle_hcm_payrollrelationshipspublicUI:payrolldetails\", Sequence: 8, VBResourceName: \"/vbcs/hcm/payroll-relationships-publicui/fragments/payrolldetails\" },\n    { Name: \"oracle_hcm_compensationpublicUI:create-salary\", Sequence: 9, VBResourceName: \"/vbcs/hcm/compensation-publicui/fragments/create-salary\" },\n    { Name: \"oracle_hcm_compensationpublicUI:individual-compensation\", Sequence: 10, VBResourceName: \"/vbcs/hcm/compensation-publicui/fragments/individual-compensation-section\" },\n    { Name: \"oracle_hcm_employmentprocessUI:combined_reassign_directs_fragment\", Sequence: 11, VBResourceName: \"/vbcs/hcm/employment-processui/fragments/combined_reassign_directs_fragment\" },\n    { Name: \"oracle_hcm_employmentprocessUI:combined_add_directs_fragment\", Sequence: 12, VBResourceName: \"/vbcs/hcm/employment-processui/fragments/combined_add_directs_fragment\" },\n    { Name: \"oracle_hcm_documentrecordspublicUI:document-records\", Sequence: 13, VBResourceName: \"/vbcs/hcm/document-records-public-ui/fragments/document-records\" },\n    { Name: \"oracle_hcm_transactionpublicUI:approval-comment-attachments\", Sequence: 14, VBResourceName: \"/vbcs/hcm/transaction-publicui/fragments/approval-comment-attachments\" },\n    { Name: \"oracle_hcm_employmentpublicUI:senioritydates_fragment\", Sequence: 15, VBResourceName: \"/vbcs/hcm/employment-publicui/fragments/senioritydates_fragment\" },\n    { Name: \"oracle_hcm_employmentprocessUI:seniority_dates_fragment\", Sequence: 16, VBResourceName: \"/vbcs/hcm/employment-processui/fragments/seniority_dates_fragment\" },\n    { Name: \"storeTxnData\", Sequence: 17, VBResourceName: \"/vbcs/hcm/employment-processui/fragments/storeTxnData\" }\n  ],\n\n  TRANSFERS: [\n    { Name: \"oracle_hcm_employmentprocessUI:combined_when_and_why_fragment\", Sequence: 1, VBResourceName: \"/vbcs/hcm/employment-processui/fragments/combined_when_and_why_fragment\" },\n    { Name: \"oracle_hcm_employmentprocessUI:combined_position_override_fragment\", Sequence: 2, VBResourceName: \"/vbcs/hcm/employment-processui/fragments/combined_position_override_fragment\" },\n    { Name: \"oracle_hcm_employmentprocessUI:combined_additional_assignment_info_fragment\", Sequence: 3, VBResourceName: \"/vbcs/hcm/employment-processui/fragments/combined_additional_assignment_info_fragment\" },\n    { Name: \"oracle_hcm_employmentprocessUI:combined_assignment_fragment\", Sequence: 4, VBResourceName: \"/vbcs/hcm/employment-processui/fragments/combined_assignment_fragment\" },\n    { Name: \"oracle_hcm_employmentprocessUI:combined_weeklyworkinghours_fragment\", Sequence: 5, VBResourceName: \"/vbcs/hcm/employment-processui/fragments/combined_weeklyworkinghours_fragment\" },\n    { Name: \"oracle_hcm_employmentprocessUI:combined_maintain_managers_fragment\", Sequence: 6, VBResourceName: \"/vbcs/hcm/employment-processui/fragments/combined_maintain_managers_fragment\" },\n    { Name: \"oracle_hcm_employmentprocessUI:combined_contracts_fragment\", Sequence: 7, VBResourceName: \"/vbcs/hcm/employment-processui/fragments/combined_contracts_fragment\" },\n    { Name: \"oracle_hcm_payrollrelationshipspublicUI:payrolldetails\", Sequence: 8, VBResourceName: \"/vbcs/hcm/payroll-relationships-publicui/fragments/payrolldetails\" },\n    { Name: \"oracle_hcm_compensationpublicUI:create-salary\", Sequence: 9, VBResourceName: \"/vbcs/hcm/compensation-publicui/fragments/create-salary\" },\n    { Name: \"oracle_hcm_compensationpublicUI:individual-compensation\", Sequence: 10, VBResourceName: \"/vbcs/hcm/compensation-publicui/fragments/individual-comp