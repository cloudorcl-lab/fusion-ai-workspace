            "name": "setEmploymentSessionFromActionRestCall",
            "returnType": "object",
            "sourceCode": "// 1. Check if it's null/undefined/non-object and initialize it globally\nif (!$context.$variables.employmentSession || typeof $context.$variables.employmentSession !== 'object') {\n    $context.$variables.employmentSession = {};\n}\n\n// 2. Now assign the property directly to the global object\n$context.$variables.employmentSession.SelectedEmploymentProcess = $context.$nodes.PROCESS_THE_OUTPUT_FROM_CODE_BLOCK.$output.empProcess ;\n\n// 3. Return the updated object\nreturn $context.$variables.employmentSession;"
          },
