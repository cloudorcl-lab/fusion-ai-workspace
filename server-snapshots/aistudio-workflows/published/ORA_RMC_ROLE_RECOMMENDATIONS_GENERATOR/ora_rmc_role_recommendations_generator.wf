            "returnType": "array",
            "sourceCode": "let items = $context.$nodes.GET_CONTROLS.$output.items;\n\nlet result = items.map(item => ({\n  controlRequestName: item.Name,\n  controlRequestId: item.Id\n}));\n\nreturn result;"
