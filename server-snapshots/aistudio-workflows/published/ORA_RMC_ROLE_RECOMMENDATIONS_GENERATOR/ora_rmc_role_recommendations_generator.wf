                  "inputs": [
                    {
                      "id": "1766762793106",
                      "name": "ControlName",
                      "scope": "JOB",
                      "type": "string",
                      "value": "{{$context.$nodes.INCIDENT_LOOP.$currentItem.controlRequestName}}"
                    },
                    {
                      "id": "1766762736445",
                      "name": "ControlId",
                      "scope": "JOB",
                      "type": "string",
                      "value": "{{$context.$nodes.INCIDENT_LOOP.$currentItem.controlRequestId}}"
                    }
                  ],
                  "type": "SET_FIELDS"
                },
                {
                  "metadata": {
                    "name": "Analyze Intra-role Conflicts",
                    "returnType": "array",
                    "sourceCode": "let incidents = $context.$nodes.GET_INCIDENTS.$output.items || [];\n\nif (incidents.length === 0) {\n  return [];\n}\n\nlet results = [];\nlet suggestionSet = new Set();\n\n// Group incidents by GlobalUserName\nlet userGroups = {};\nincidents.forEach(incident => {\n  let user = incident.GlobalUserName;\n  if (!userGroups[user]) {\n    userGroups[user] = [];\n  }\n  userGroups[user].push(incident);\n});\n\n// Process each user group to find conflicts\nObject.keys(userGroups).forEach(user => {\n  let userIncidents = userGroups[user];\n  \n  // Find pairs with different entitlements but common tokens\n  for (let i = 0; i < userIncidents.length; i++) {\n    for (let j = i + 1; j < userIncidents.length; j++) {\n      let incident1 = userIncidents[i];\n      let incident2 = userIncidents[j];\n      \n      if (incident1.Entitlement !== incident2.Entitlement) {\n        // Check for common tokens in IncidentInformationCodes\n        let tokens1 = incident1.IncidentInformationCodes ? incident1.IncidentInformationCodes.split('>').map(token => token.trim()) : [];\n        let tokens2 = incident2.IncidentInformationCodes ? incident2.IncidentInformationCodes.split('>').map(token => token.trim()) : [];\n        \n        let commonTokens = tokens1.filter(token => tokens2.includes(token.trim()));\n        \n        if (commonTokens.length > 0) {\n          // Extract role from first token\n          let role = incident1.Role || tokens1[0] || '';\n          \n          // Create a unique key for this suggestion to avoid duplicates\n          let sortedEntitlements = [incident1.Entitlement, incident2.Entitlement].sort();\n          let suggestionKey = `${role}:${sortedEntitlements.join(':')}`;\n          \n          if (!suggestionSet.has(suggestionKey)) {\n            suggestionSet.add(suggestionKey);\n            \n            results.push({\n              Role: role,\n              IncidentInformation1: incident1.IncidentInformation || '',\n              Entitlement1: incident1.Entitlement || '',\n              IncidentInformation2: incident2.IncidentInformation || '',\n              Entitlement2: incident2.Entitlement || '',\n              Suggestion: `Split role \"${role}\" into separate roles: one containing \"${incident1.Entitlement}\" and another containing \"${incident2.Entitlement}\"`\n            });\n          }\n        }\n      }\n    }\n  }\n});\n\nreturn results;"
                  },
                  "outcomes": {
                    "success": "end_1766762178433"
                  },
                  "code": "INTRAROLE_ADVISOR",
                  "id": "1768335926099",
                  "inputs": [],
                  "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"Suggestion\": {\n            \"type\": \"string\"\n        },\n        \"Entitlement2\": {\n            \"type\": \"string\"\n        },\n        \"IncidentInformation2\": {\n            \"type\": \"string\"\n        },\n        \"Entitlement1\": {\n            \"type\": \"string\"\n        },\n        \"IncidentInformation1\": {\n            \"type\": \"string\"\n        },\n        \"Role\": {\n            \"type\": \"string\"\n        }\n    }\n}",
                  "type": "CODE"
                }
              ],
              "rootNode": "start_1766762178433"
            },
