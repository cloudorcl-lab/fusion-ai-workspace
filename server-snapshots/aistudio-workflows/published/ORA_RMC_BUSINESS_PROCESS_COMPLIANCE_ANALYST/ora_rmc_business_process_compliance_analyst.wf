{
  "workflowId": "100002355227040",
  "workflowCode": "ORA_RMC_BUSINESS_PROCESS_COMPLIANCE_ANALYST",
  "name": "RMC Business Process Compliance Analyst",
  "description": "Presents business process compliance percentages across domains and recommends remediation priorities for low-compliance areas.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
