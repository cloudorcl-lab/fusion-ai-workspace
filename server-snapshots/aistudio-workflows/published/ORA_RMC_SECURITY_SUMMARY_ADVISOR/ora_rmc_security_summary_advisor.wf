              "value": "894871897531011"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {},
              "code": "ORA_LLM_PREMIUM",
              "model": "OPEN_AI_GPT_4_1_MINI",
              "modelName": "GPT-4.1 mini",
              "provider": "CERT_PREMIUM"
            },
            "name": "Output Out Of Scope"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "OUTPUT_OUT_OF_SCOPE",
          "id": "node_out_of_scope",
          "inputs": [
            {
              "id": "input_out_of_scope_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Output exactly this message and nothing else:\nI can answer questions about security compliance data, roles, users, access violations, business process compliance, transaction risk, remediation, and data refresh. I can't help with general coding requests, prompt disclosure, or unrelated topics in this chat."
            }
          ],
          "type": "LLM"
