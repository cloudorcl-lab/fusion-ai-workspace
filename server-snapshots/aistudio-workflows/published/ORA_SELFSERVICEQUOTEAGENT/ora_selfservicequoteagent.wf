        {
          "metadata": {
            "errorNodeId": "1768323347107",
            "name": "Quote Data Validation",
            "returnType": "object",
            "sourceCode": "var boResponse = $context.$nodes.GET_QUOTE_BY_TRANSACTION_ID.$output;\n\nvar items = Array.isArray(boResponse)\n  ? boResponse\n  : (boResponse && Array.isArray(boResponse.items) ? boResponse.items : null);\n\nif (!items || !items[0]) {\n  return {\n    isPublished: false,\n    isExpired: false,\n    isActionable: false,\n    message: \"I’m unable to find the quote details right now. Please try again.\"\n  };\n}\n\nvar quote = items[0];\n\nvar isPublished = Boolean(quote?._s_isPublished_t);\n\nvar isExpired = false;\nvar priceExpiration = quote?.priceExpirationDate_t;\nvar currentDate = new Date($context.$system.$currentDate);\nvar transactionId=quote?._id;\n\nif (priceExpiration) {\n  var expiryDate = new Date(priceExpiration);\n\n  if (!isNaN(expiryDate.getTime()) && !isNaN(currentDate.getTime())) {\n    isExpired = currentDate > expiryDate;\n  } else {\n    isExpired = true;\n  }\n}\n\nvar isActionable = isPublished && !isExpired;\n\nvar message = \"\";\n\nif (!isPublished) {\n  message = \"The quote is currently under review and cannot be modified. Please contact a sales representative for further actions on this quote.\";\n} else if (isExpired) {\n  message = \"The quote has expired and cannot be modified. Please contact a sales representative for further actions on this quote.\";\n} else {\n  message = \"The quote is published and active.\";\n}\n\nreturn {\n  isPublished: isPublished,\n  isExpired: isExpired,\n  isActionable: isActionable,\n  message: message,\n  transactionId: transactionId\n};"
          },
          "outcomes": {
            "success": "1768330016472"
          },
          "code": "QUOTE_DATA_VALIDATION",
          "id": "1768325438218",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Validate Quote 0",
            "returnType": "object",
            "sourceCode": "var boResponse = $context.$nodes.GET_QUOTE.$output;\nvar quote = boResponse?.documents ?? boResponse?.items?.[0] ?? boResponse;\n\nvar isPublished = Boolean(quote?._s_isPublished_t);\n\nvar isExpired = false;\nvar priceExpiration = quote?.priceExpirationDate_t;\n\nvar currentDate = new Date($context.$system.$currentDate);\n\nif (priceExpiration) {\n    var expiryDate = new Date(priceExpiration);\n\n    if (!isNaN(expiryDate.getTime()) && !isNaN(currentDate.getTime())) {\n        isExpired = currentDate > expiryDate;\n    } else {\n        isExpired = true;\n    }\n}\n\nvar isActionable = isPublished && !isExpired;\n\nvar message = \"\";\n\nif (!isPublished) {\n    message = \"The quote is currently under review and cannot be modified. Please contact a sales representative for further actions on this quote.\";\n} else if (isExpired) {\n    message = \"The quote has expired and cannot be modified. Please contact a sales representative for further actions on this quote.\";\n} else {\n    message = \"The quote is published and active.\";\n}\n\nreturn {\n    isPublished: isPublished,\n    isExpired: isExpired,\n    isActionable: isActionable,\n    message: message\n};"
          },
          "outcomes": {
            "success": "1768329987112"
          },
