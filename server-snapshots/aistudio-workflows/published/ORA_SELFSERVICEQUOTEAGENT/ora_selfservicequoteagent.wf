        {
          "metadata": {
            "name": "ValidateQuoteDetails",
            "returnType": "object",
            "sourceCode": "var result = {\n  transactionInternalId: null,\n  callRejectQuoteBO: false,\n  reason: null\n};\n\nvar boResponse = $context.$nodes.GETQUOTEDETAILSBYID.$output;\n\nvar quote = boResponse?.documents;\nif (!quote) {\n  result.reason = \"Quote not found\";\n  return result;\n}\n\nvar status = quote._s_customerStatus_t?.value;\nvar assignedTo = quote._s_assignedTo_t?.value;\nvar priceExpiration = quote?.priceExpirationDate_t;\nvar transactionId = quote.bs_id;\nvar statusInternal = quote?.status_t?.value;\nvar statusInternalValue = String(statusInternal || \"\").trim().toUpperCase();\n\nif (!transactionId) {\n  result.reason =\n    \"I'm unable to proceed at the moment because the quote reference is incomplete. Once the transaction details are fully available, we can continue.\";\n  return result;\n}\n\nif (\n    statusInternalValue === \"REJECTED_BY_CUSTOMER\"\n) {\n  result.transactionInternalId = transactionId;\n  result.reason =\n    \"This quote has already been rejected and cannot be rejected again. Please reach out to your sales representative if you need any changes or further assistance\";\n  return result;\n}\n\n// --- Expiration check ---\nif (priceExpiration) {\n  var expiryDate = new Date(priceExpiration);\n  var currentDate = new Date($context.$system.$currentDate);\n\n  if (isNaN(expiryDate.getTime()) || isNaN(currentDate.getTime())) {\n    result.reason =\n      \"I'm unable to verify the quote validity period right now because the date information is unavailable. Please try again.\";\n    return result;\n  }\n\n  // Compare date-only values in UTC to avoid timezone issues\n  var expiryOnly = new Date(Date.UTC(\n    expiryDate.getUTCFullYear(),\n    expiryDate.getUTCMonth(),\n    expiryDate.getUTCDate()\n  ));\n\n  var currentOnly = new Date(Date.UTC(\n    currentDate.getUTCFullYear(),\n    currentDate.getUTCMonth(),\n    currentDate.getUTCDate()\n  ));\n\n  if (expiryOnly < currentOnly) {\n    result.transactionInternalId = transactionId;\n    result.reason =\n      \"This quote has expired and can no longer be modified. Please reach out to your sales representative for assistance.\";\n    return result;\n  }\n}\n\nif (!status || !assignedTo) {\n  result.reason =\n    \"I'm unable to proceed with rejection right now because some required quote details are not yet available. Once the quote status and assignment are confirmed, we can move forward.\";\n  return result;\n}\n\nif (status === \"acceptance\" && assignedTo === \"BUYER\") {\n  result.transactionInternalId = transactionId;\n  result.callRejectQuoteBO = true;\n  result.reason = null;\n} else {\n  result.transactionInternalId = transactionId;\n  result.reason =\n    \"The quote is currently not eligible for rejection. Please contact sales representative for further actions on this quote.\";\n}\n\nreturn result;"
          },
