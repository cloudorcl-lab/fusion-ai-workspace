              "value": "\"_part_number\",\"_line_display_name\",\"listPrice_l\",\"netPrice_l\",\"discountPercent_l\",\"discountAmount_l\",\"listAmount_l\",\"netAmount_l\",\"_price_quantity\",\"_line_bom_item_quantity\",\"_sequence_number\",\"requestDate_l\",\"contractStartDate_l\",\"contractEndDate_l\",\"requestShipDate_l\",\"createdDate_l\",\"lastUpdatedDate_l\",\"winLossStatus_l\",\"fulfillmentStatus_l\",\"transactionID_l\",\"_part_desc\",\"documentNumber_l\",\"_part_display_number\",\"_part_sales_product_type\",\"_price_applied_ratePlan\",\"_document_number\""
            },
            {
