        {
          "metadata": {
            "name": "Validate QuoteID",
            "returnType": "object",
            "sourceCode": "var result = {\n  transactionInternalId: null,\n  callGenerateProposalBO: false,\n  reason: null\n};\n\nvar boResponse = $context.$nodes.GET_QUOTE_BY_ID.$output;\n\nvar quote = boResponse?.documents;\nif (!quote) {\n  result.reason = \"Quote not found\";\n  return result;\n}\n\nvar status = quote._s_customerStatus_t?.value;\nvar assignedTo = quote._s_assignedTo_t?.value;\nvar priceExpiration = quote?.priceExpirationDate_t;\nvar transactionId = quote.bs_id;\n\nif (!transactionId) {\n  result.reason =\n    \"I'm unable to proceed at the moment because the quote reference is incomplete. Once the transaction details are fully available, we can continue.\";\n  return result;\n}\n\n// --- Expiration check ---\nif (priceExpiration) {\n  var expiryDate = new Date(priceExpiration);\n  var currentDate = new Date($context.$system.$currentDate);\n\n  if (isNaN(expiryDate.getTime()) || isNaN(currentDate.getTime())) {\n    result.reason =\n      \"I'm unable to verify the quote validity period right now because the date information is unavailable. Please try again.\";\n    return result;\n  }\n\n  // Compare date-only values in UTC to avoid timezone issues\n  var expiryOnly = new Date(Date.UTC(\n    expiryDate.getUTCFullYear(),\n    expiryDate.getUTCMonth(),\n    expiryDate.getUTCDate()\n  ));\n\n  var currentOnly = new Date(Date.UTC(\n    currentDate.getUTCFullYear(),\n    currentDate.getUTCMonth(),\n    currentDate.getUTCDate()\n  ));\n\n  if (expiryOnly < currentOnly) {\n    result.transactionInternalId = transactionId;\n    result.reason =\n      \"This quote has expired and a proposal can no longer be generated. Please reach out to your sales representative for assistance.\";\n    return result;\n  }\n}\n\nif (!status || !assignedTo) {\n  result.reason =\n    \"I'm unable to proceed with generating a proposal right now because some required quote details are not yet available. Once the quote status and assignment are confirmed, we can move forward.\";\n  return result;\n}\n\nif (status === \"acceptance\" && assignedTo === \"BUYER\") {\n  result.transactionInternalId = transactionId;\n  result.callGenerateProposalBO = true;\n  result.reason = null;\n} else {\n  result.transactionInternalId = transactionId;\n  result.reason =\n    \"The quote is currently not eligible for generating a proposal. Please contact sales representative for further actions on this quote.\";\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776100029691"
          },
          "code": "VALIDATE_QUOTEID",
          "id": "1776099822330",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
