        {
          "metadata": {
            "name": "Validate Quote",
            "returnType": "object",
            "sourceCode": "var boResponse = $context.$nodes.GET_QUOTE_DETAILS_BY_TRANSACTION.$output;\n\nvar items = Array.isArray(boResponse)  ? boResponse  : (boResponse && Array.isArray(boResponse.items) ? boResponse.items : null);\n\nif (!items || !items[0]) {\n   return {\n      quoteValid: false,\n      message: \"The requested quote could not be found. Please verify the quote reference and try again.\"\n    };\n}\n\nvar quote = items[0];\nvar isPublished = quote?._s_isPublished_t;\n\nif (!isPublished) {\n  return {\n    quoteValid: false,\n    message: \"The quote is still under review, so I’m unable to share its details at this moment.\"\n  };\n}\n\nreturn {\n  quoteValid: true,\n  message: null\n};"
          },
