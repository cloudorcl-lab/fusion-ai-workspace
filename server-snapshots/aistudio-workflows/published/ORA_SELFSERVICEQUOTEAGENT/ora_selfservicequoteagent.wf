        {
          "metadata": {
            "name": "setQuoteRequestInput",
            "returnType": "object",
            "sourceCode": "const llmOut = $context.$nodes.QUOTEREQUESTDETAILSVALIDATOR.$output;\nconst customerName= $context.$variables.organization;\nconst partyNumber= $context.$variables.organizationPartyNumber;\n\nlet output = {\n  valid: false,\n  reason: \"\",\n  finalQuery: null,\npartyNumber: null\n};\n\n\nlet productNames = llmOut.product_name_present ? llmOut.product_name : [];\nlet quantities = llmOut.product_quantity_present ? llmOut.product_quantity : [];\n\nif (!Array.isArray(productNames)) {\n  productNames = [productNames];\n}\nif (!Array.isArray(quantities)) {\n  quantities = [quantities];\n}\n\nconst documentTrackerId_present = llmOut.documentTrackerId_present === true;\nconst documentTrackerId = llmOut.documentTrackerId;\n\nif (documentTrackerId_present) {\n  output.finalQuery =\n    `Generate quote for the document tracker id ${documentTrackerId}`;\n} else {\n  if (\n    productNames.length > 1 &&\n    quantities.length === productNames.length\n  ) {\n    let query =\n      `Generate quote for customer ${customerName} ` +\n      `with party number ${partyNumber}:`;\n\n    for (let i = 0; i < productNames.length; i++) {\n      query +=\n        ` Product ${productNames[i]} with quantity ${quantities[i]};`;\n    }\n\n    output.finalQuery = query;\n  } else {\n    output.finalQuery =\n      `Generate quote for product ${productNames[0]} ` +\n      `with quantity ${quantities[0]} ` +\n      `for customer ${customerName} ` +\n      `with party number ${partyNumber}`;\n  }\n}\n\n\n\noutput.valid = true;\noutput.partyNumber=partyNumber;\nreturn output;"
          },
          "outcomes": {
            "success": "1767012409982"
          },
          "code": "SETQUOTEREQUESTINPUT",
