        {
          "metadata": {
            "name": "Clean Quote Details",
            "returnType": "object",
            "sourceCode": "let listQuotes = $context.$nodes.GET_QUOTE_DETAILS_BY_TRANSACTION.$output;\n\n// Remove links globally\nconst cleaned = JSON.parse(\n  JSON.stringify(listQuotes),\n  (key, value) => {\n    if (key === \"links\") return undefined;\n    return value;\n  }\n);\n\nconst PRICE_FIELDS = new Set([\n  \"totalContractValue_t\",\n  \"totalContractListValue_t\",\n  \"totalContractDiscount_t\",\n  \"totalAnnualValue_t\",\n  \"totalOneTimeNetAmount_t\",\n  \"transactionTotalDiscountPercent_t\",\n  \"listPrice_l\",\n  \"netPrice_l\",\n  \"nonRecurRevRollup_l\",\n  \"_extended_amount\",\n  \"listPriceRollup_l\",\n  \"contractListValueRollup_l\",\n  \"contractValueRollup_l\",\n  \"netPriceRollup_l\",\n  \"netAmount_l\",\n  \"netAmountRollup_l\",\n  \"marginAmount_l\",\n  \"marginPercent_l\",\n  \"annualListValue_l\",\n  \"annualValue_l\",\n  \"annualMargin_l\",\n  \"annualCost_l\",\n  \"contractDiscount_l\",\n  \"contractCost_l\",\n  \"contractMargin_l\",\n  \"contractListValue_l\",\n  \"contractValue_l\",\n  \"costAmount_l\",\n  \"unitCost_l\",\n  \"listAmount_l\",\n  \"unitMargin_l\",\n  \"discountAmount_l\",\n  \"discountPercent_l\",\n  \"discountPercentRollup_l\",\n  \"customDiscountAmount_l\",\n  \"customDiscountValue_l\",\n  \"_pricing_rule_price_each\",\n  \"_price_configurable_price\",\n  \"_price_unit_price_each\",\n  \"_price_item_price_each\",\n  \"_price_list_price_each\",\n  \"_part_base_price\",\n  \"_price_calculation_info\",\n  \"nonRecurRevSummable_l\"\n]);\n\n// ALWAYS remove these (irrespective of status)\nconst REMOVE_FIELDS = new Set([\n  \"_s_html_line_timeseries_l\",\n  \"_s_html_line_scatterplot_l\",\n  \"_s_lineDiscountGuidanceMeterGauge_l\"\n]);\n\nconst isPlainObject = (value) =>\n  value !== null && typeof value === \"object\" && !Array.isArray(value);\n\nconst maskPricingValue = (value) => {\n  if (isPlainObject(value)) {\n    const masked = { ...value };\n\n    if (\"value\" in masked) masked.value = \"-\";\n    if (\"currency\" in masked) masked.currency = \"-\";\n\n    return masked;\n  }\n\n  return \"-\";\n};\n\nconst scrubNode = (node, shouldMaskPricing) => {\n  if (Array.isArray(node)) {\n    return node.map((n) => scrubNode(n, shouldMaskPricing));\n  }\n\n  if (!isPlainObject(node)) {\n    return node;\n  }\n\n  const out = {};\n\n  for (const [key, value] of Object.entries(node)) {\n    // Always remove links (safety, though already handled)\n    if (key === \"links\") continue;\n\n    // ALWAYS remove these fields\n    if (REMOVE_FIELDS.has(key)) {\n      continue;\n    }\n\n    // Conditionally mask pricing\n    if (shouldMaskPricing && PRICE_FIELDS.has(key)) {\n      out[key] = maskPricingValue(value);\n      continue;\n    }\n\n    out[key] = scrubNode(value, shouldMaskPricing);\n  }\n\n  return out;\n};\n\nif (Array.isArray(cleaned?.items)) {\n  cleaned.items = cleaned.items.map((item) => {\n    const status = item?._s_customerStatus_t?.value;\n\n    const shouldMaskPricing =\n      status === \"solutionDiscovery\" || status === \"negotiation\";\n\n    return scrubNode(item, shouldMaskPricing);\n  });\n}\n\nreturn cleaned;"
          },
          "outcomes": {
            "success": "1769443687048"
          },
          "code": "CLEAN_QUOTE_DETAILS",
          "id": "1774948087537",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.75
              },
              "code": "ORA_LLM_PREMIUM",
              "model": "OPEN_AI_GPT_4_1_MINI",
              "modelName": "GPT-4.1 Mini",
              "provider": "CERT_PREMIUM"
            },
            "name": "Quote Enquiry Response Generation"
          },
          "outcomes": {
            "success": "1774961299847"
          },
          "code": "QUOTE_ENQUIRY_RESPONSE_GENERATION",
          "id": "1774959305023",
          "inputs": [
            {
              "id": "1774959305025_1",
              "name": "prompt",
              "type": "string",
              "value": "### SYSTEM INSTRUCTION\n\nGenerate a structured JSON response for B2B Self Service chat.\nOutput only the final JSON.\nDo not include prose, comments, code fences, headings, or narrative outside the JSON.\n\n---\n\n### INPUTS\n\nChatHistory: {{$context.$system.$chatHistory}}\nQuery: {{$context.$system.$inputMessage}}\nQuoteDetails: {{$context.$nodes.EXTRACTQUOTEDETAILSBYTRANSACTION.$output}}\n\n---\n\n### TASK OVERVIEW\n\n1. Generate a **B2B enterprise buyer-oriented quote summary** in **HTML** format that directly answers the query.\n   - Present the quote like a **senior enterprise sales advisor** would: clear, strategic, commercially relevant, and focused on business value.\n   - Emphasize buyer outcomes such as operational efficiency, contract certainty, commercial clarity, budgeting confidence, and service continuity when supported by the data.\n   - Do **not** include system-style status statements.\n   - Do **not** include \"Next suggested steps\" or explicit instructions.\n   - Do **not** include contact, owner, or account information anywhere in the summary.\n   - Do **not** use headings like \"Quote\", \"Summary\", or \"Value to Buyer.\"\n   - Do **not** include dates in the opening paragraph. If dates appear in highlights, format them as **dd/MMM/yyyy**.\n   - Start with a short enterprise-focused paragraph summarizing the solution and its business value.\n   - After the opening paragraph, include **key highlights as HTML bullet points**.\n   - Include only information relevant to the query and available in `QuoteDetails`.\n   - Do not highlight any monetary attribute that is zero dollar. If all monetary values are zero, summarize that fact in one concise bullet.\n   - Omit any missing fields.\n   - Tone: professional, clear, persuasive, confident, and enterprise buyer-centric.\n   - For **specific attribute questions** such as expiry, last modified date, status, product count, or line item count:\n     - return only the requested information\n     - do not include the summary paragraph\n     - do not include unrelated highlights\n\n2. Actions should strictly be part of the defined `Global Actions`.\n\n3. Return only the **top 2 most appropriate actions** based on the query, context, and response content.\n\n4. Output only the final JSON in the required format.\n\n---\n\n### RULES\n\n#### Explanation Text (HTML, Buyer-Centric)\n* Summary rules:\n  - Start with **exactly 2 short enterprise-oriented sentences**.\n  - Sentence 1 must naturally reference `transactionName` when present.\n  - Sentence 2 should naturally reflect the most relevant business context from `QuoteDetails`.\n  - Use language that sounds commercially polished and enterprise-ready.\n  - Avoid generic filler phrases such as:\n    - tailored solution\n    - specific business needs\n    - competitive pricing\n    - flexible terms\n    - ensuring efficiency and value\n    - ready for your review\n    - available for review\n  - Use only values explicitly present in `QuoteDetails`.\n  - Do not infer missing details.\n  - Do not paraphrase field values.\n  - Do not invent pricing, dates, counts, statuses, sources, or discounts.\n\n* Highlight rules:\n  - After the 2-sentence summary, include an HTML bullet list of the most relevant quote highlights.\n  - Use `<ul>` and `<li>` for highlights.\n  - Keep highlights concise, factual, and business-relevant.\n  - Select only the most relevant attributes based on the user query.\n  - Do not use a static highlight list.\n  - Do not include every available field by default.\n  - Prefer attributes directly related to the query first.\n  - If the query is broad, include only the 3 to 5 most important available attributes.\n  - If the query asks for a specific detail, include only that detail.\n  - If dates are included in bullets, format them as `dd/MMM/yyyy`.\n  - If all monetary values are zero, include a single bullet stating that all monetary values are currently zero.\n  - Do not add any commentary inside bullets beyond the factual value.\n\n* Field grounding guidance:\n  - Prefer using `transactionName` naturally in the opening summary when available.\n  - If contract dates are present and relevant, reflect the contract duration naturally in the summary or highlights.\n  - Use values from fields such as status, transaction source, customer status, and assignment when they are relevant to the query.\n  - Always use field values exactly as provided when included.\n\n* Highlight selection logic:\n  - If the query asks about status, include status-related fields first.\n  - If the query asks about dates or expiry, include date-related fields first.\n  - If the query asks about pricing or discount, include pricing-related fields first.\n  - If the query asks about participants or ownership, include assigned/customer/source fields first.\n  - If the query is general, choose the most commercially relevant attributes from the available data.\n\n\n* Date formatting:\n  - Use `dd/MMM/yyyy`\n\n* Specific attribute questions:\n  - If the query asks only for one attribute, return only that value as a direct factual response.\n  - Do not include the general summary or additional highlights.\n  - If the quote status is \"solutionDiscovery\" or \"negotiation\" and the query is pricing-related (including amounts, totals, discounts, margins, list price, net price, or any monetary values), do not return any pricing values.\n  - Instead, respond with:\n    \"Pricing details are not available at this stage and will be shared as the commercial discussion progresses.\"\n  - Do not include any monetary values in the response.\n  - This rule does not apply to non-pricing attributes such as dates (e.g., expiry date), status, or counts.\n\n* Use only values explicitly present in `QuoteDetails`.\n* Escape double quotes properly.\n\n---\n\n#### Actions (Global Actions)\n\n**Actions should be dynamically generated based on the query, context, and the response content. Return only the top 2 most appropriate actions.**\n\nAllowed actions:\n- **\"Request Changes\"**\n- **\"Inquire About Expiry\"**\n- **\"Ask for More Details\"**\n- **\"Accept Quote\"**\n\nDo not generate any other actions.\n\n---\n\n#### Action Mapping Rules\n\nEach action string must be converted to:\n\n{\n  \"type\": \"postback\",\n  \"label\": \"<Action Label>\",\n  \"value\": \"<snake_case_label>\"\n}\n\n* Preserve label text exactly.\n* Convert value to lowercase snake_case.\n* Return only the top 2 selected actions.\n* Maintain order by relevance.\n\n---\n\n#### Final Output Format (STRICT — SINGLE JSON ONLY)\n\n{\n  \"messages\": [\n    {\n      \"type\": \"text\",\n      \"text\": <generated_explanation>,\n      \"globalActions\": {\n        \"orientation\": \"column\",\n        \"items\": <mapped_actions_array>\n      }\n    }\n  ]\n}\n\n* Always return `\"orientation\": \"column\"`.\n* Do not include any other fields.\n\n---\n\n### OUTPUT REQUIREMENT\n\nOutput only the final JSON object described above.\nAny deviation from this schema is invalid."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "FinalResponseGeneration",
            "returnType": "object",
            "sourceCode": "const pageContextData= $context.$variables.pageContextResult;\nconst messageData= $context.$nodes.QUOTE_ENQUIRY_RESPONSE_GENERATION.$output;\n\nlet result = [];\nif (pageContextData && Array.isArray(pageContextData.items)) {\n  result = JSON.parse(JSON.stringify(pageContextData.items));\n\n  for (let i = 0; i < result.length; i++) {\n    const stack = [result[i]];\n\n    while (stack.length > 0) {\n      const current = stack.pop();\n\n      if (current && typeof current === \"object\") {\n        if (Array.isArray(current)) {\n          for (let j = 0; j < current.length; j++) {\n            stack.push(current[j]);\n          }\n        } else {\n          const keys = Object.keys(current);\n\n          for (let k = 0; k < keys.length; k++) {\n            const key = keys[k];\n            const value = current[key];\n\n            if (key === \"href\") {\n              current.ssLink = value;\n              delete current.href;\n            }\n\n            if (typeof current[key] === \"string\") {\n              current[key] = current[key].replace(/https:\\/\\//g, \"ssProto\");\n            } else if (current[key] && typeof current[key] === \"object\") {\n              stack.push(current[key]);\n            }\n          }\n\n          if (typeof current.ssLink === \"string\") {\n            current.ssLink = current.ssLink.replace(/https:\\/\\//g, \"ssProto\");\n          }\n        }\n      }\n    }\n  }\n}\n\nconst outputMessage =\n  messageData &&\n  Array.isArray(messageData.messages) &&\n  messageData.messages.length > 0\n    ? messageData.messages[0]\n    : {};\n\nreturn {\n  messages: [\n    {\n      type: \"text\",\n      text: outputMessage.text || \"\",\n      globalActions: {\n        orientation: \"column\",\n        items:\n          outputMessage.globalActions &&\n          Array.isArray(outputMessage.globalActions.items)\n            ? outputMessage.globalActions.items\n            : []\n      }\n    }\n  ],\n  pageContext: {\n    result: result\n  }\n};"
          },
