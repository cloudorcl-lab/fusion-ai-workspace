{
  "workflowId": "100002355226904",
  "workflowCode": "ORA_SELFSERVICEQUOTEAGENT",
  "name": "SelfServiceQuoteAgent",
  "description": "The SelfServiceQuoteAgent is an AI-driven assistant that allows buyers to manage quotes within predefined buyer constraints. Buyers can retrieve, create, and modify quotes according to their specific requirements, such as adjusting quantities, products, or pricing within set parameters. The agent provides real-time updates on quote statuses and answers inquiries regarding terms, pricing, and validity. Any actions that fall outside of these predefined constraints, or require additional approval, are routed to the sales rep for further handling, ensuring a seamless and compliant workflow.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"output\": {\n            \"type\": \"object\",\n            \"properties\": {}\n        }\n    }\n}",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
