        {
          "metadata": {
            "name": "QuoteIdEncoding",
            "returnType": "string",
            "sourceCode": "const transactionId = $context.$nodes.VALIDATE_QUOTE_ID.$output.resolvedQuoteId;\nconst customerId= $context?.$variables?.accountPartyId ?? \"\";\n\nconst payload = {\n  transactionID_t: transactionId,\n  _customer_id: customerId\n};\n\nconst jsonString = JSON.stringify(payload);\nconst encoded = encodeURIComponent(jsonString);\n\nreturn encoded;"
          },
          "outcomes": {
            "success": "1776100303803"
          },
          "code": "QUOTEIDENCODING",
          "id": "1776100128994",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_CX_CPQCOMMERC_GETQUOTEDETAILS",
            "errorNodeId": "1776230010838",
            "functionName": "getQuoteByTransactionId",
            "name": "GetQuote"
          },
          "outcomes": {
            "success": "1776100405890"
          },
          "code": "GETQUOTE",
          "id": "1776100303803",
          "inputs": [
            {
              "id": "1776100314831_1",
              "name": "mainDocVarName",
              "type": "string",
              "value": "{{$context.$variables.mainDocVarName}}"
