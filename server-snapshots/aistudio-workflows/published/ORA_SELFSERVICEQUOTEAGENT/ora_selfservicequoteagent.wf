          "inputs": [
            {
              "id": "1767012446379_1",
              "name": "returnValue",
              "type": "string",
              "value": "{\n  \"messages\": [\n    {\n      \"type\": \"text\",\n      \"text\": \" {{$context.$nodes.SETQUOTEREQUESTINPUT.$output.result.reason}} \",\n      \"globalActions\": {\n        \"orientation\": \"column\",\n        \"items\": []\n      },\n      \"pageContext\": {\n        \"result\": []\n      }\n    }\n  ]\n}"
