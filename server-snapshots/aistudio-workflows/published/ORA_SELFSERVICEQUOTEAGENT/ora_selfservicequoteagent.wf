            "sourceCode": "const BUDetails=$context.$nodes.GET_BUSINESS_UNIT_ID.$output;\nconst SelfServiceUserDetails= $context.$nodes.GET_SELFSERVICE_USER.$output?.items[0]; \n\nreturn {\n  BusinessUnitId: BUDetails?.items?.[0]?.BusinessUnitId,\n  LoginId: SelfServiceUserDetails?.LoginId,\n  EmailAddress:SelfServiceUserDetails?.EmailAddress,\n  AccountPartyNumber: SelfServiceUserDetails?.AccountPartyNumber,\n  AccountPartyId: SelfServiceUserDetails?.AccountPartyId,\n  ContactPartyId: SelfServiceUserDetails?.ContactPartyId,\n  ContactPartyNumber: SelfServiceUserDetails?.ContactPartyNumber,\n  AccountPartyName: SelfServiceUserDetails?.AccountPartyName,\n  ContactPartyName: SelfServiceUserDetails?.ContactPartyName\n};"
