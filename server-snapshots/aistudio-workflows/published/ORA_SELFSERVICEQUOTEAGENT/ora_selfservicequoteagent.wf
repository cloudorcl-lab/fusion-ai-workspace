              "name": "childExpandedDomains",
              "type": "string",
              "value": "\"pricePeriod_l\",\"customDiscountType_l\",\"status_l\",\"fulfillmentStatus_l\",\"changeCode_l\",\"changeReason_l\",\"oRCL_ABO_ActionCode_l\""
