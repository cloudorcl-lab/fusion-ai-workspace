            "sourceCode": "const apiResponse = $context.$nodes.ACCEPT_QUOTE_0.$output;\n\nconst statusValue =\n  apiResponse &&\n  apiResponse.documents &&\n  apiResponse.documents._s_assignedTo_t &&\n  apiResponse.documents._s_assignedTo_t.value\n    ? apiResponse.documents._s_assignedTo_t.value\n    : \"\";\n\nconst isPublished =\n  apiResponse &&\n  apiResponse.documents &&\n  apiResponse.documents._s_isPublished_t\n    ? apiResponse.documents._s_isPublished_t\n    : \"\";\n\n\nconst isSuccess = (statusValue === \"SELLER\") && isPublished;\n\n\nreturn {\n  messages: [\n    {\n      type: \"text\",\n      text: isSuccess\n        ? \"Thank you for accepting the quote. Your request is under review, and our sales representative will reach out to you to proceed with further actions.\"\n        : \"We were unable to confirm the quote acceptance. Please reach out to your sales representative for further assistance\",\n      globalActions: {\n        orientation: \"column\",\n        items: []\n      }\n    }\n  ],\n  pageContext: {\n    result: []\n  }\n};"
