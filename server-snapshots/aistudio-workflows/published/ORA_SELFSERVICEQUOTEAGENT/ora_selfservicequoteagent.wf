        {
          "metadata": {
            "name": "Validate Quote Data",
            "returnType": "object",
            "sourceCode": "var result = {\n  transactionInternalId: null,\n  callAcceptQuoteBO: false,\n  reason: null\n};\n\nvar boResponse = $context.$nodes.GET_QUOTE_DATA.$output;\n\n// --- Normalize to items array ---\nvar items = null;\n\nif (Array.isArray(boResponse)) {\n  items = boResponse;\n} else if (boResponse && Array.isArray(boResponse.items)) {\n  items = boResponse.items;\n}\n\n// --- Hard stop if no quote ---\nif (!Array.isArray(items) || items.length === 0 || !items[0]) {\n  result.reason = \"Quote not found\";\n  return result;\n}\n\nvar quote = items[0];\n\n// --- Safe extraction ---\nvar status = quote?._s_customerStatus_t?.value;\nvar assignedTo = quote?._s_assignedTo_t?.value;\nvar priceExpiration = quote?.priceExpirationDate_t;\n\n// --- Additional fields for accepted check ---\nvar isPublished = quote?._s_isPublished_t;\nvar statusInternal = quote?.status_t?.value;\n\n// Prefer CPQ transaction internal id (_id / _bs_id)\nvar transactionId =\n  quote?._id ??\n  quote?._bs_id ??\n  quote?.bs_id ??\n  null;\n\nif (!transactionId) {\n  result.reason =\n    \"I’m unable to proceed at the moment because the quote reference is incomplete. \" +\n    \"Once the transaction details are fully available, we can continue.\";\n  return result;\n}\n\n// --- Normalize values for accepted guard ---\nvar assignedToValue = String(assignedTo || \"\").trim().toUpperCase();\nvar statusInternalValue = String(statusInternal || \"\").trim().toUpperCase();\nvar isPublishedValue =\n  isPublished === true ||\n  String(isPublished).trim().toLowerCase() === \"true\";\n\n// --- Already accepted guard ---\nif (\n  assignedToValue === \"SELLER\" &&\n  isPublishedValue &&\n  statusInternalValue === \"QUOTED\"\n) {\n  result.transactionInternalId = transactionId;\n  result.reason =\n    \"This quote has already been accepted and cannot be accepted again. Please reach out to your sales representative if you need any changes or further assistance\";\n  return result;\n}\n\n// --- Expiration check ---\nif (priceExpiration) {\n  var expiryDate = new Date(priceExpiration);\n  var currentDate = new Date($context.$system.$currentDate);\n\n  if (isNaN(expiryDate.getTime()) || isNaN(currentDate.getTime())) {\n    result.reason =\n      \"I’m unable to verify the quote validity period right now because the date information is unavailable. Please try again.\";\n    return result;\n  }\n\n  // Compare date-only values in UTC to avoid timezone issues\n  var expiryOnly = new Date(Date.UTC(\n    expiryDate.getUTCFullYear(),\n    expiryDate.getUTCMonth(),\n    expiryDate.getUTCDate()\n  ));\n\n  var currentOnly = new Date(Date.UTC(\n    currentDate.getUTCFullYear(),\n    currentDate.getUTCMonth(),\n    currentDate.getUTCDate()\n  ));\n\n  if (expiryOnly < currentOnly) {\n    result.transactionInternalId = transactionId;\n    result.reason =\n      \"This quote has expired and can no longer be accepted. Please reach out to your sales representative for assistance.\";\n    return result;\n  }\n}\n\nif (!status || !assignedTo) {\n  result.reason =\n    \"I’m unable to proceed with acceptance right now because some required quote details \" +\n    \"are not yet available. Once the quote status and assignment are confirmed, we can move forward.\";\n  return result;\n}\n\nif (status === \"acceptance\" && assignedTo === \"BUYER\") {\n  result.transactionInternalId = transactionId;\n  result.callAcceptQuoteBO = true;\n  result.reason = null;\n} else {\n  result.transactionInternalId = transactionId;\n  result.reason =\n    \"The quote is currently not eligible for acceptance. It remains in an earlier stage of the process \" +\n    \"and will need to be updated before approval can occur. I can assist with reviewing the quote or coordinating the next steps.\";\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1768211047360"
          },
          "code": "VALIDATE_QUOTE_DATA",
          "convergenceTargetId": "1767611201408",
          "id": "1767102287859",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Validate Quote Details",
            "returnType": "object",
            "sourceCode": "var result = {\n  transactionInternalId: null,\n  callAcceptQuoteBO: false,\n  reason: null\n};\n\nvar boResponse = $context.$nodes.GET_QUOTE_DETAILS_BY_ID.$output;\n\nvar quote = boResponse?.documents;\nif (!quote) {\n  result.reason = \"Quote not found\";\n  return result;\n}\n\nvar status = quote._s_customerStatus_t?.value;\nvar assignedTo = quote._s_assignedTo_t?.value;\nvar priceExpiration = quote?.priceExpirationDate_t;\nvar transactionId = quote._id ?? quote.bs_id ?? null;\n\nvar isPublished = quote?._s_isPublished_t;\nvar statusInternal = quote?.status_t?.value;\n\nif (\n  assignedTo === \"SELLER\" &&\n  isPublished === true &&\n  statusInternal === \"QUOTED\"\n) {\n  result.transactionInternalId = transactionId;\n  result.reason =\n    \"This quote has already been accepted and cannot be accepted again. Please reach out to your sales representative if you need any changes or further assistance\";\n  return result;\n}\n\nif (!transactionId) {\n  result.reason =\n    \"I'm unable to proceed at the moment because the quote reference is incomplete. \" +\n    \"Once the transaction details are fully available, we can continue.\";\n  return result;\n}\n\n// --- Expiration check ---\nif (priceExpiration) {\n  var expiryDate = new Date(priceExpiration);\n  var currentDate = new Date($context.$system.$currentDate);\n\n  if (isNaN(expiryDate.getTime()) || isNaN(currentDate.getTime())) {\n    result.reason =\n      \"I'm unable to verify the quote validity period right now because the date information is unavailable. Please try again.\";\n    return result;\n  }\n\n  // Compare date-only values in UTC to avoid timezone issues\n  var expiryOnly = new Date(Date.UTC(\n    expiryDate.getUTCFullYear(),\n    expiryDate.getUTCMonth(),\n    expiryDate.getUTCDate()\n  ));\n\n  var currentOnly = new Date(Date.UTC(\n    currentDate.getUTCFullYear(),\n    currentDate.getUTCMonth(),\n    currentDate.getUTCDate()\n  ));\n\n  if (expiryOnly < currentOnly) {\n    result.transactionInternalId = transactionId;\n    result.reason =\n      \"This quote has expired and can no longer be accepted. Please reach out to your sales representative for assistance.\";\n    return result;\n  }\n}\n\nif (!status || !assignedTo) {\n  result.reason =\n    \"I'm unable to proceed with acceptance right now because some required quote details \" +\n    \"are not yet available. Once the quote status and assignment are confirmed, we can move forward.\";\n  return result;\n}\n\nif (status === \"acceptance\" && assignedTo === \"BUYER\") {\n  result.transactionInternalId = transactionId;\n  result.callAcceptQuoteBO = true;\n  result.reason = null;\n} else {\n  result.transactionInternalId = transactionId;\n  result.reason =\n    \"The quote is currently not eligible for acceptance. It remains in an earlier stage of the process \" +\n    \"and will need to be updated before approval can occur.\";\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1768211125093"
          },
          "code": "VALIDATE_QUOTE_DETAILS",
          "id": "1767611237610",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
