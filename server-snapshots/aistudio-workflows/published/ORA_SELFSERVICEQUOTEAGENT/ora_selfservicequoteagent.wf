              "value": "{{$context.$nodes.EXTRACTQUOTEIDFROMHISTORY.$output.quoteIdExists}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "updateQuoteId1"
          },
