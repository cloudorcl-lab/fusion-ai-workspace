          "id": "1759742890974",
          "name": "journeyResponse",
          "scope": "JOB",
          "type": "object",
          "typeSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"BuyerJourney\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"entry_id\": {\n      \"type\": \"integer\",\n      \"description\": \"Unique identifier for the buyer journey entry\"\n    },\n    \"buyer_name\": {\n      \"type\": \"string\",\n      \"description\": \"Full name of the buyer\"\n    },\n    \"email\": {\n      \"type\": \"string\",\n      \"format\": \"email\",\n      \"description\": \"Buyer email address\"\n    },\n    \"organization\": {\n      \"type\": \"string\",\n      \"description\": \"Organization associated with the buyer\"\n    },\n    \"journey\": {\n      \"type\": \"array\",\n      \"description\": \"Detailed sequence of all recorded journey stages\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"stage\": { \"type\": \"string\" },\n          \"timestamp\": { \"type\": \"string\", \"format\": \"date-time\" }\n        },\n        \"required\": [\"stage\", \"timestamp\"]\n      }\n    },\n    \"intent\": {\n      \"type\": \"object\",\n      \"description\": \"Derived intent and operational status at the end of the journey\",\n      \"properties\": {\n        \"intentIdentified\": {\n          \"type\": \"array\",\n          \"description\": \"Ordered subset of canonical flow representing buyer's goal path\",\n          \"items\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"Search Products\",\n              \"Request Quote\",\n              \"Quote Negotiation\",\n              \"Place Order\"\n            ]\n          }\n        },\n        \"status\": {\n          \"type\": \"string\",\n          \"enum\": [\"IN_PROGRESS\", \"COMPLETED\", \"PAUSED\", \"RESUMED\", \"EXITED\"],\n          \"description\": \"Operational outcome of the journey\"\n        },\n        \"lastUpdated\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\",\n          \"description\": \"Timestamp of the last recorded activity (final stage or pause/resume)\"\n        },\n        \"reason\": {\n          \"type\": \"string\",\n          \"description\": \"Explanation tying the status to the last buyer intent stage\"\n        },\n        \"summary\": {\n          \"type\": \"string\",\n          \"description\": \"High-level summary of the overall buyer journey conversation\"\n        }\n      },\n      \"required\": [\"intentIdentified\", \"status\"]\n    }\n  },\n  \"required\": [\"entry_id\", \"buyer_name\", \"email\", \"organization\", \"journey\", \"intent\"]\n}"
        },
        {
          "id": "1759742873376",
          "name": "currentBuyerJourney",
          "scope": "JOB",
          "type": "object",
          "typeSpecification": "{\n  \"title\": \"BuyerJourney\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"entry_id\": {\n      \"type\": \"integer\",\n      \"description\": \"Unique identifier for the buyer journey entry\"\n    },\n    \"buyer_name\": {\n      \"type\": \"string\",\n      \"description\": \"Full name of the buyer\"\n    },\n    \"email\": {\n      \"type\": \"string\",\n      \"format\": \"email\",\n      \"description\": \"Buyer email address\"\n    },\n    \"organization\": {\n      \"type\": \"string\",\n      \"description\": \"Organization associated with the buyer\"\n    },\n    \"journey\": {\n      \"type\": \"array\",\n      \"description\": \"Detailed sequence of all recorded journey stages\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"stage\": { \"type\": \"string\" },\n          \"timestamp\": { \"type\": \"string\", \"format\": \"date-time\" }\n        },\n        \"required\": [\"stage\", \"timestamp\"]\n      }\n    },\n    \"intent\": {\n      \"type\": \"object\",\n      \"description\": \"Derived intent and operational status at the end of the journey\",\n      \"properties\": {\n        \"intentIdentified\": {\n          \"type\": \"array\",\n          \"description\": \"Ordered subset of canonical flow representing buyer's goal path\",\n          \"items\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"Search Products\",\n              \"Request Quote\",\n              \"Quote Negotiation\",\n              \"Place Order\"\n            ]\n          }\n        },\n        \"status\": {\n          \"type\": \"string\",\n          \"enum\": [\"IN_PROGRESS\", \"COMPLETED\", \"PAUSED\", \"RESUMED\", \"EXITED\"],\n          \"description\": \"Operational outcome of the journey\"\n        },\n        \"lastUpdated\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\",\n          \"description\": \"Timestamp of the last recorded activity (final stage or pause/resume)\"\n        },\n        \"reason\": {\n          \"type\": \"string\",\n          \"description\": \"Explanation tying the status to the last buyer intent stage\"\n        },\n        \"summary\": {\n          \"type\": \"string\",\n          \"description\": \"High-level summary of the overall buyer journey conversation\"\n        }\n      },\n      \"required\": [\"intentIdentified\", \"status\"]\n    }\n  },\n  \"required\": [\"entry_id\", \"buyer_name\", \"email\", \"organization\", \"journey\", \"intent\"]\n}"
        }
