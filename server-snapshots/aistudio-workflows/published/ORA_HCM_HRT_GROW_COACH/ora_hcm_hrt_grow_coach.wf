          },
          "code": "SAVE_RECOMMENDATIONS",
          "convergenceTargetId": "1772206949736",
          "id": "1772206480805",
          "inputs": [
            {
              "id": "1772206635823",
              "name": "currentLearningItems",
              "scope": "JOB",
              "type": "object",
              "value": "{{$context.$nodes.CLEAN_UP_CURRENT_LEARNING.$output.result}}"
