        {
          "metadata": {
            "name": "Clean up Skills to Develop",
            "returnType": "object",
            "sourceCode": "let inputData = $context.$nodes.RECOMMENDED_FOR_DEVELOPING_SKILLS.$output || {};\nlet items = inputData.items || [];\n\nlet output = {\n  result: {\n    SkillsToDevelopToGrowCareer: [],\n    resourcesToAcquireSkill: []\n  }\n};\n\nfor (let i = 0; i < items.length; i++) {\n  let item = items[i];\n\n  // Skip the Additional Resources swimlane entirely\n  if (item.swimlaneItemName === \"Additional Resources\") {\n    continue;\n  }\n\n  let mappedRecs = [];\n  let recs = item.recommendations || [];\n\n  for (let j = 0; j < recs.length; j++) {\n    let rec = recs[j];\n\n    // Ignore withdrawn recommendations\n    if (rec.recommendationStatus === \"ORA_WLF_RECOM_STATUS_WITHDRAWN\") {\n      continue;\n    }\n\n    mappedRecs.push({\n      objectCategoryMeaning: rec.objectCategoryMeaning,\n      objectTypeMeaning: rec.objectTypeMeaning,\n      recommendationCategoryMeaning: rec.recommendationCategoryMeaning,\n      recommenderTypeMeaning: rec.recommenderTypeMeaning,\n      objectEnrollDeepLink: rec.objectEnrollDeepLink,\n      objectAverageRating: rec.objectAverageRating,\n      objectRatingCount: rec.objectRatingCount,\n      objectKeywords: rec.objectKeywords || null,\n      objectTitle: rec.objectTitle,\n      objectDescription: rec.objectDescription || null,\n      recommenderDisplayName: rec.recommenderDisplayName,\n      recommendationRank: rec.recommendationRank\n    });\n  }\n\n  if (!output.result.SkillsToDevelopToGrowCareer.includes(item.swimlaneItemName)) {\n    output.result.SkillsToDevelopToGrowCareer.push(item.swimlaneItemName);\n  }\n  \n  output.result.resourcesToAcquireSkill.push({\n    roleGapSkill: item.swimlaneItemName,\n    resources: mappedRecs\n  });\n}\n\nreturn output;"
          },
          "outcomes": {
            "success": "1772206480805"
          },
          "code": "CLEAN_UP_SKILLS_TO_DEVELOP",
          "id": "1772195522708",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Clean up manager recommendations",
            "returnType": "object",
            "sourceCode": "var inputData = $context.$nodes.GET_RECOMMENDATIONS_FROM_MANAGER.$output || {};\nvar items = inputData.items || [];\n\nvar output = {\n  result: {\n    SkillsToDevelopToGrowCareer: [],\n    resourcesToAcquireSkill: []\n  }\n};\n\nfor (var i = 0; i < items.length; i++) {\n  var item = items[i];\n\n  // Skip the Additional Resources swimlane entirely\n  if (item.swimlaneItemName === \"Additional Resources\") {\n    continue;\n  }\n\n  var mappedRecs = [];\n  var recs = item.recommendations || [];\n\n  for (var j = 0; j < recs.length; j++) {\n    var rec = recs[j];\n    \n    // Ignore withdrawn recommendations\n    if (rec.recommendationStatus === \"ORA_WLF_RECOM_STATUS_WITHDRAWN\") {\n      continue;\n    }\n    \n    // Explicitly construct the object to avoid parsing errors\n    var recObj = {};\n    recObj.objectCategoryMeaning = rec.objectCategoryMeaning;\n    recObj.objectTypeMeaning = rec.objectTypeMeaning;\n    recObj.recommendationCategoryMeaning = rec.recommendationCategoryMeaning;\n    recObj.recommenderTypeMeaning = rec.recommenderTypeMeaning;\n    recObj.objectEnrollDeepLink = rec.objectEnrollDeepLink;\n    recObj.objectAverageRating = rec.objectAverageRating;\n    recObj.objectRatingCount = rec.objectRatingCount;\n    recObj.objectKeywords = rec.objectKeywords || null;\n    recObj.objectTitle = rec.objectTitle;\n    recObj.objectDescription = rec.objectDescription || null;\n    recObj.recommenderDisplayName = rec.recommenderDisplayName;\n    recObj.recommendationRank = rec.recommendationRank;\n    \n    mappedRecs.push(recObj);\n  }\n\n  // Use indexOf instead of includes for ES5 compatibility\n  if (output.result.SkillsToDevelopToGrowCareer.indexOf(item.swimlaneItemName) === -1) {\n    output.result.SkillsToDevelopToGrowCareer.push(item.swimlaneItemName);\n  }\n  \n  // Explicitly construct the skill gap object\n  var skillObj = {};\n  skillObj.roleGapSkill = item.swimlaneItemName;\n  skillObj.resources = mappedRecs;\n  \n  output.result.resourcesToAcquireSkill.push(skillObj);\n}\n\nreturn output;"
          },
          "outcomes": {
            "success": "1772206480805"
          },
          "code": "CLEAN_UP_MANAGER_RECOMMENDATIONS",
          "id": "1772195248391",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Clean up role gap recommendations",
            "returnType": "object",
            "sourceCode": "let inputData = $context.$nodes.GET_CURRENT_JOB_GAP_RECOMMENDATIONS.$output || {};\nlet items = inputData.items || [];\n\nlet output = {\n  result: {\n    skillsConsideredRoleGaps: [],\n    resourcesToBridgeGap: []\n  }\n};\n\nfor (let i = 0; i < items.length; i++) {\n  let item = items[i];\n\n  // Skip the Additional Resources swimlane entirely\n  if (item.swimlaneItemName === \"Additional Resources\") {\n    continue;\n  }\n\n  let mappedRecs = [];\n  let recs = item.recommendations || [];\n\n  for (let j = 0; j < recs.length; j++) {\n    let rec = recs[j];\n\n    // Ignore withdrawn recommendations\n    if (rec.recommendationStatus === \"ORA_WLF_RECOM_STATUS_WITHDRAWN\") {\n      continue;\n    }\n\n    mappedRecs.push({\n      objectCategoryMeaning: rec.objectCategoryMeaning,\n      objectTypeMeaning: rec.objectTypeMeaning,\n      recommendationCategoryMeaning: rec.recommendationCategoryMeaning,\n      recommenderTypeMeaning: rec.recommenderTypeMeaning,\n      objectEnrollDeepLink: rec.objectEnrollDeepLink,\n      objectAverageRating: rec.objectAverageRating,\n      objectRatingCount: rec.objectRatingCount,\n      objectKeywords: rec.objectKeywords || null,\n      objectTitle: rec.objectTitle,\n      objectDescription: rec.objectDescription || null,\n      recommenderDisplayName: rec.recommenderDisplayName,\n      recommendationRank: rec.recommendationRank\n    });\n  }\n\n  if (!output.result.skillsConsideredRoleGaps.includes(item.swimlaneItemName)) {\n    output.result.skillsConsideredRoleGaps.push(item.swimlaneItemName);\n  }\n  \n  output.result.resourcesToBridgeGap.push({\n    roleGapSkill: item.swimlaneItemName,\n    resources: mappedRecs\n  });\n}\n\nreturn output;"
          },
          "outcomes": {
            "success": "1772206480805"
          },
          "code": "CLEAN_UP_ROLE_GAP_RECOMMENDATIONS",
          "id": "1772195195529",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Clean up current learning",
            "returnType": "object",
            "sourceCode": "let inputData = $context.$nodes.GET_MY_CURRENT_LEARNING.$output || {};\nlet items = inputData.items || [];\n\nlet output = {\n  requiredLearning: [],\n  voluntaryLearning: []\n};\n\n// Get current time for comparison\nconst now = new Date();\nconst oneWeekFromNow = new Date();\noneWeekFromNow.setDate(now.getDate() + 7);\n\nfor (let i = 0; i < items.length; i++) {\n  let item = items[i];\n  let li = item.learningItem || {};\n  \n  // Calculate Due Date Status\n  let dueDateStatus = null;\n  if (item.assignmentDueDate) {\n    const dueDate = new Date(item.assignmentDueDate);\n    \n    if (dueDate < now) {\n      dueDateStatus = \"OVERDUE\";\n    } else if (dueDate <= oneWeekFromNow) {\n      dueDateStatus = \"ALMOST_DUE\";\n    }\n  }\n\n  let mappedAssignment = {\n    assignmentDueDate: item.assignmentDueDate || null,\n    dueDateStatus: dueDateStatus, // New synthetic attribute\n    learningItemTitle: li.learningItemTitle || null,\n    learningItemSkillv2: li.learningItemSkillv2 || null,\n    liShortDescription: li.liShortDescription || null,\n    learningItemDescription: li.learningItemDescription || null,\n    learningItemExpectedEffortInHours: li.learningItemExpectedEffortInHours || null,\n    learningItemRatingAverage: li.learningItemRatingAverage || null,\n    learningItemRatingCount: li.learningItemRatingCount || null,\n    publicSkills: li.publicSkills || null,\n    learningOutcomes: li.learningOutcomes || null,\n    competencies: li.competencies || null,\n    swimLaneName: li.swimLaneName || null,\n    courseTitle: li.courseTitle || null,\n    aiReason: li.aiReason || null,\n    assignerDisplayName: item.assignerDisplayName || null\n  };\n\n  if (item.assignmentType === \"ORA_REQUIRE_ASSIGNMENT\") {\n    output.requiredLearning.push(mappedAssignment);\n  } else if (item.assignmentType === \"ORA_JOIN_ASSIGNMENT\") {\n    output.voluntaryLearning.push(mappedAssignment);\n  }\n}\n\nreturn output;"
          },
          "outcomes": {
            "success": "1772206480805"
          },
          "code": "CLEAN_UP_CURRENT_LEARNING",
          "id": "1772196451752",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Clean up COI Resource Recommendations",
            "returnType": "object",
            "sourceCode": "let inputData = $context.$nodes.CAREER_OF_INTEREST_RESOURCE_RECOMMENDATIONS.$output || {};\nlet items = inputData.items || [];\n\nlet output = {\n  CareerOfInterestLists: [],\n  resourceRecommendations: []\n};\n\nfor (let i = 0; i < items.length; i++) {\n  let swimlane = items[i];\n  let currentCareer = swimlane.swimlaneName;\n\n  // Track unique career names\n  if (currentCareer && !output.CareerOfInterestLists.includes(currentCareer)) {\n    output.CareerOfInterestLists.push(currentCareer);\n  }\n\n  // Create the parent career object\n  let careerObj = {\n    careerOfInterestInfo: currentCareer,\n    skillsQualificationsRequired: []\n  };\n\n  let swimlaneItems = swimlane.swimlaneItems || [];\n\n  // Iterate through the skills within that career\n  for (let j = 0; j < swimlaneItems.length; j++) {\n    let swimlaneItem = swimlaneItems[j];\n    \n    // Create the skill object\n    let skillObj = {\n      skillQualificationName: swimlaneItem.swimlaneItemName,\n      upskillingResources: []\n    };\n\n    let recs = swimlaneItem.recommendations || [];\n\n    // Map all learning resources for that specific skill\n    for (let k = 0; k < recs.length; k++) {\n      let rec = recs[k];\n\n    // Ignore withdrawn recommendations\n    if (rec.recommendationStatus === \"ORA_WLF_RECOM_STATUS_WITHDRAWN\") {\n      continue;\n    }\n\n      skillObj.upskillingResources.push({\n        objectCategoryMeaning: rec.objectCategoryMeaning,\n        objectTypeMeaning: rec.objectTypeMeaning,\n        recommendationCategoryMeaning: rec.recommendationCategoryMeaning,\n        recommenderTypeMeaning: rec.recommenderTypeMeaning,\n        objectEnrollDeepLink: rec.objectEnrollDeepLink,\n        objectAverageRating: rec.objectAverageRating,\n        objectRatingCount: rec.objectRatingCount,\n        objectKeywords: rec.objectKeywords || null,\n        objectTitle: rec.objectTitle,\n        objectDescription: rec.objectDescription || null,\n        recommenderDisplayName: rec.recommenderDisplayName,\n        recommendationRank: rec.recommendationRank\n      });\n    }\n\n    // Push the fully populated skill object into the career's skills array\n    careerObj.skillsQualificationsRequired.push(skillObj);\n  }\n\n  // Push the fully populated career object into the main recommendations array\n  output.resourceRecommendations.push(careerObj);\n}\n\nreturn output;"
          },
          "outcomes": {
            "success": "1772206480805"
          },
          "code": "CLEAN_UP_COI_RESOURCE_RECOMMENDATIONS",
