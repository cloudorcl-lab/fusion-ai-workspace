{
  "workflowId": "300000330254740",
  "workflowCode": "ORA_HCM_HRT_GROW_COACH",
  "name": "Grow Coach",
  "description": "Guides employees to accelerate career growth by analyzing Grow recommendations to create personalized, prioritized upskilling paths. It recommends high‑impact courses tailored to each employee’s skill gaps and goals, helping them resolve competing training needs and make the most of limited time.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
