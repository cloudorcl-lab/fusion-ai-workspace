        {
          "metadata": {
            "name": "Structure Output",
            "returnType": "string",
            "sourceCode": "const mergeDetailsAndSummaries = (reportees, summaries) => {\n  if (!summaries?.length) return reportees ?? [];\n\n  const reporteeMap = new Map(\n    (reportees ?? []).map(r => [r.EmployeePersonEventId, r])\n  );\n\n  return summaries.map(sum => {\n    const match = reporteeMap.get(sum.PersonEventId);\n\n    return match\n      ? {\n          ...match, \n          ...sum, \n          WorksheetStatus: match.ManagerStatusCode,\n          SubmitCode: match.SubmitCode,\n          MgrPersonEventId: match.MgrPersonEventId,\n          ManagerListName: match.ManagerListName\n        }\n      : { ...sum };\n  });\n};\n\nconst getManagerArrays = () => ({\n  details: $context.$nodes.FIND_ALL_MANAGER_DETAILS.$output?.items ?? [],\n  summaries: $context.$nodes.FIND_ALL_MANAGER_SUMMARIES.$output?.items ?? []\n});\n\nconst readableHeader = (key) =>\n  key.replace(/\\./g, \" \").replace(/([a-z])([A-Z])/g, \"$1 $2\").replace(/_/g, \" \").replace(/\\b\\w/g, c => c.toUpperCase());\n\nconst { details, summaries } = getManagerArrays();\nconst data = mergeDetailsAndSummaries(details, summaries);\n\nconst keys = Object.keys(data[0] || {});\nconst headers = keys.map(k => readableHeader(k)).join(\" | \");\nconst rows = data.map(item => keys.map(k => item[k] ?? \"\").join(\" | \"));\n\nreturn [headers, ...rows].join(\"\\n\");"
          },
          "outcomes": {
            "success": "1771738530580"
          },
          "code": "STRUCTURE_OUTPUT",
          "convergenceTargetId": "1771695877922",
          "id": "1762860504486",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
