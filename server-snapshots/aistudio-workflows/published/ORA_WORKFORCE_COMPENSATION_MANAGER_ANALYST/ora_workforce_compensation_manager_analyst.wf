          "code": "INVALID_QUERY",
          "convergenceTargetId": "1770893174452",
          "id": "1770646586399",
          "inputs": [
            {
              "id": "1770646586400_1",
              "name": "prompt",
              "type": "string",
              "value": "If {{$context.$system.$inputMessage}} is a greeting (e.g., \"hi\", \"hello\", \"hey\", \"how are you\", \"good morning\", \"good afternoon\", \"good evening\"), greet the user first with a short friendly greeting.\nInform the user of this exact message below.  \n\nFormat each question on a separate line using bullet points.\nDo not combine questions on the same line.\n\nmessage: \nI am a Workforce Compensation Manager agent, and I can get you answers about compensation planning status, budgets, and allocations for managers in your organization.\n\nI can help you with questions like:\n\n- How much bonus budget is remaining for my organization?\n\n- Which managers have not started their allocations yet?\n\n- How many employees are eligible for bonus in each manager’s team?\n\n- How much merit budget has been allocated so far?\n\n- What is the due date for managers to submit their worksheet?"
            }
          ],
          "type": "LLM"
        },
