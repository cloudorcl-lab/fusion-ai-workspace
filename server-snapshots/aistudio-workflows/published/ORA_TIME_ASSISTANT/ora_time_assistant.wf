        {
          "metadata": {
            "name": "Create Tcf Dependency Order",
            "returnType": "array",
            "sourceCode": "const input = $context.$variables.qTimeCardLayoutConfig?.timeCardFields?.items;\n\nconst depMap = Object.create(null);\nconst inDegree = Object.create(null);\nconst adjacency = Object.create(null);\n\nconst asId = (v) => (v === null || v === undefined ? null : String(v));\n\nfor (const f of input || []) {\n  const id = asId(f.TimeCardFieldId);\n  if (!id) continue;\n\n  const deps = [];\n  for (let i = 1; i <= 5; i++) {\n    let d = asId(f[`BindTcfId${i}`]);\n    if (!d && f.RestURI) {\n      const match = f.RestURI.match(new RegExp(`(?:[?,;&]|^)BindTcfId${i}=([^,;&]+)`));\n      d = asId(match?.[1]);\n    }\n    if (d && !deps.includes(d)) deps.push(d);\n  }\n  depMap[id] = deps;\n}\n\nconst nodes = Object.keys(depMap);\n\nfor (const id of nodes) {\n  inDegree[id] = 0;\n}\n\nconst missingDeps = [];\nfor (const [node, deps] of Object.entries(depMap)) {\n  for (const dep of deps) {\n    if (depMap[dep] === undefined) missingDeps.push(`${node}->${dep}`);\n  }\n}\n\nif (missingDeps.length) {\n  throw new Error(`Unresolved dependencies detected: ${missingDeps.join(\", \")}`);\n}\n\nfor (const [node, deps] of Object.entries(depMap)) {\n  inDegree[node] = deps.length;\n\n  for (const dep of deps) {\n    if (!adjacency[dep]) adjacency[dep] = [];\n    adjacency[dep].push(node);\n  }\n}\n\nconst queue = [];\nfor (const node of nodes) {\n  if (inDegree[node] === 0) queue.push(node);\n}\n\nconst order = [];\nlet head = 0;\nwhile (head < queue.length) {\n  const n = queue[head++];\n  order.push(n);\n\n  const dependents = adjacency[n] || [];\n  for (const m of dependents) {\n    inDegree[m]--;\n    if (inDegree[m] === 0) queue.push(m);\n  }\n}\n\nif (order.length !== nodes.length) {\n  const remaining = nodes.filter((k) => inDegree[k] > 0);\n  throw new Error(`Cycle detected among: ${remaining.join(\", \")}`);\n}\n\nreturn order;"
          },
          "outcomes": {
            "success": "1773385068276"
          },
          "code": "CREATE_TCF_DEPENDENCY_ORDER",
          "id": "1773385035365",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
