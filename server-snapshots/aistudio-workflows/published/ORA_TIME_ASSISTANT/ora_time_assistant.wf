                            "sourceCode": "let data = $context.$variables.qTimeEntryIdToResolvedTcfValueMapper ;\n\nif (!data) {\n  data = {};\n}\n\nlet tcfValues = data[ $context.$variables.qTimeEntry?.TimeEntryId ];\n\nif ( !tcfValues ) {\n   tcfValues = [];\n  data[ $context.$variables.qTimeEntry?.TimeEntryId] = tcfValues;\n}\n\nlet tcfValue = $context.$variables.qTcfValue ;\nif (tcfValue) {\ntcfValue.Value= $context.$variables.qCurrentTcfResolvedValue; \ntcfValues.push( tcfValue );\n}\n\n\nreturn data;"
