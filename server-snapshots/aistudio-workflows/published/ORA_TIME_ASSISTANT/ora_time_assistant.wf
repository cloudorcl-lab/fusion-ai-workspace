        {
          "metadata": {
            "name": "Validate Time Sheet Header Details",
            "returnType": "object",
            "sourceCode": "let result = {};\nresult.errors = [];\n\nconst personNumber = $context.$variables.qPersonNumber;\n\nif (personNumber == null || personNumber.toString().trim() === \"\") {\n  result.errors.push(`Person Number is invalid: ${personNumber}`);\n}\n\nconst isDateValid = (dateValue) => {\n  const date = new Date(dateValue != null ? dateValue.toString() : \"\");\n  return !isNaN(date.getTime());\n};\n\nconst timePeriodStart = $context.$variables.qTimePeriodStart;\nconst timePeriodEnd = $context.$variables.qTimePeriodEnd;\nif (!isDateValid(timePeriodStart) || !isDateValid(timePeriodEnd)) {\n  result.errors.push(\n    `Time card period is invalid: ${timePeriodStart} ${timePeriodEnd} `,\n  );\n}\n\nresult.isValid = result.errors.length === 0;\n\nreturn result;"
          },
          "outcomes": {
            "success": "1768933339989"
          },
          "code": "VALIDATE_TIME_SHEET_HEADER_DETAILS",
          "id": "1768931039872",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
