            "name": "Create Resolved Time Card Payload",
            "returnType": "object",
            "sourceCode": "let result = JSON.parse(JSON.stringify($context.$variables.qTimeCardPayload)); \n\nfor (const te of result?.timeEntries) {\n te.timeCardFieldValues = $context.$variables.qTimeEntryIdToResolvedTcfValueMapper[te?.TimeEntryId]; \n}\n\nreturn result;"
