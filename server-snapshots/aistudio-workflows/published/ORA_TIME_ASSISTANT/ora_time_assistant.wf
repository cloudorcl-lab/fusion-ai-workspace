                      "id": "1773385313529",
                      "scope": "JOB",
                      "value": "{{$context.$nodes.FOR_EACH_TIME_ENTRY.$currentItem}}",
                      "name": "qTimeEntry",
                      "type": "object"
                    }
                  ],
                  "type": "SET_FIELDS"
                },
                {
                  "metadata": {
                    "name": "Create Tcf Id to Tcf Value Mapping",
                    "returnType": "object",
                    "sourceCode": "let input = $context.$variables.qTimeEntry?.timeCardFieldValues;\n\nif (!input) {\n  input = [];\n}\n\nlet result = {};\n\nfor (const tcfValue of input) {\n  if (tcfValue?.TimeCardFieldId) {\n    result[tcfValue.TimeCardFieldId] = tcfValue;\n  }\n}\n\nconst subSet = new Set(Object.keys(result));\nconst timeEntryId = $context.$variables.qTimeEntry?.TimeEntryId;\n\nfor (const id of $context.$variables.qTcfDependencyOrder || []) {\n  if (!subSet.has(id)) {\n    let tcf = $context.$variables.qTcfIdToTcfMapper[id];\n    let tcfValue2 = {};\n    tcfValue2[\"TimeCardFieldId\"] = id;\n    tcfValue2[\"TimeEntryId\"] = timeEntryId;\n\n    if (tcf?.[\"DisplayType\"] === \"HIDDEN\") {\n      tcfValue2[\"Value\"] = tcf[\"DefaultValue\"];\n    }\n\n    result[id] = tcfValue2;\n  }\n}\n\nreturn result;"
                  },
                  "outcomes": {
                    "success": "1773385390597"
                  },
                  "diagram": {
                    "x": 5907,
                    "y": 12161
                  },
                  "code": "CREATE_TCF_ID_TO_TCF_VALUE_MAPPING",
                  "id": "1773385366097",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
