          "outcomes": {
            "true": "1764698318649",
            "false": "1764698410562"
          },
          "code": "CHECK_APPEND_TIME_CARD",
          "convergenceTargetId": "1756788609546",
          "id": "1764698097878",
          "inputs": [
            {
              "id": "1764698097880_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$variables.qAppendTimeCardFlag}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Append Time Entries",
            "returnType": "object",
            "sourceCode": "const timeEntryProps = [\n  'TimeEntryId',\n  'TimeEntryVersion',\n  'EntryDate',\n  'StartTime',\n  'StopTime',\n  'UnitOfMeasure',\n  'Measure',\n  'Comments',\n  'timeCardFieldValues'\n];\n\nconst timeCardFieldValueProps = [\n  'TimeCardFieldId',\n  'Value',\n  'TimeEntryId'\n];\n\nconst timeCardEntryDetailsData = $context.$nodes.RETRIEVE_TIME_CARD_LAYOUT_CONFIGURATION.$output?.items?.[0];\nconst timeSheetData = $context.$variables.qResolvedTimeCardPayload;\n\nlet timeSheetPayload = JSON.parse(JSON.stringify(timeSheetData));\nlet result = {};\n\nconst reduceProperties = (source, propsArray) => {\n  if (!source || typeof source !== 'object') {\n    return {};\n  }\n\n  return propsArray.reduce((acc, prop) => {\n    if (Object.prototype.hasOwnProperty.call(source, prop)) {\n      acc[prop] = source[prop];\n    }\n    return acc;\n  }, {});\n};\n\nconst fetchTcfValues = (tcfValues) => {\n  if (!Array.isArray(tcfValues)) {\n    return [];\n  }\n\n  return tcfValues.map((fieldValue) =>\n    reduceProperties(fieldValue, timeCardFieldValueProps)\n  );\n};\n\nif (\n  timeCardEntryDetailsData &&\n  typeof timeCardEntryDetailsData === 'object' &&\n  timeSheetPayload &&\n  typeof timeSheetPayload === 'object'\n) {\n  const timeCardTimeEntries =\n    timeCardEntryDetailsData?.timeCards?.items?.[0]?.timeEntries?.items;\n\n  let timeEntries = [];\n\n  if (Array.isArray(timeCardTimeEntries)) {\n    timeEntries = timeCardTimeEntries.map((timeEntry) => {\n      const entryType = timeEntry.EntryType;\n\n      return timeEntryProps.reduce((newTimeEntry, prop) => {\n        const isRangeAndMeasure = entryType === 'RANGE' && prop === 'Measure';\n        const isMeasureAndTime =\n          entryType === 'MEASURE' && (prop === 'StartTime' || prop === 'StopTime');\n        const skip = isRangeAndMeasure || isMeasureAndTime;\n\n        if (!skip && Object.prototype.hasOwnProperty.call(timeEntry, prop)) {\n          if (prop !== 'timeCardFieldValues') {\n            newTimeEntry[prop] = timeEntry[prop];\n          } else {\n            const tcfValues = timeEntry?.timeCardFieldValues?.items;\n            newTimeEntry[prop] = fetchTcfValues(tcfValues);\n          }\n        }\n\n        return newTimeEntry;\n      }, {});\n    });\n  }\n\n  if (Array.isArray(timeEntries)) {\n    if (!timeSheetPayload.timeEntries) {\n      timeSheetPayload.timeEntries = [];\n    }\n    timeSheetPayload.timeEntries.push(...timeEntries);\n  }\n\n  result = timeSheetPayload;\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1764698376290"
          },
          "code": "APPEND_TIME_ENTRIES",
