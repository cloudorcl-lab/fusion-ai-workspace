          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n    \"title\": \"Time Card Data\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"TimeCardId\": {\n            \"type\": \"string\"\n        },\n        \"TimeCardVersion\": {\n            \"type\": \"integer\"\n        },\n        \"PersonId\": {\n            \"type\": \"string\"\n        },\n        \"StartDate\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\"\n        },\n        \"StopDate\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\"\n        },\n        \"ProcessMode\": {\n            \"type\": \"string\"\n        },\n        \"UserContext\": {\n            \"type\": \"string\"\n        },\n        \"IgnoreWarningsFlag\": {\n            \"type\": \"boolean\"\n        },\n        \"timeEntries\": {\n            \"type\": \"array\",\n            \"items\": {\n                \"$ref\": \"#/definitions/TimeEntry\"\n            }\n        }\n    },\n    \"definitions\": {\n        \"TimeEntry\": {\n            \"type\": \"object\",\n            \"properties\": {\n                \"TimeEntryId\": {\n                    \"type\": \"string\"\n                },\n                \"TimeEntryVersion\": {\n                    \"type\": \"integer\"\n                },\n                \"EntryDate\": {\n                    \"type\": \"string\",\n                    \"format\": \"date-time\"\n                },\n                \"StartTime\": {\n                    \"type\": \"string\",\n                    \"format\": \"date-time\"\n                },\n                \"StopTime\": {\n                    \"type\": \"string\",\n                    \"format\": \"date-time\"\n                },\n                \"Measure\": {\n                    \"type\": \"string\",\n                    \"format\": \"string\"\n                },\n                \"UnitOfMeasure\": {\n                    \"type\": \"string\",\n                    \"enum\": [\"HR\", \"DY\"]\n                },\n                \"timeCardFieldValues\": {\n                    \"type\": \"array\",\n                    \"items\": {\n                        \"$ref\": \"#/definitions/TimeCardFieldValue\"\n                    }\n                }\n            }\n        },\n        \"TimeCardFieldValue\": {\n            \"type\": \"object\",\n            \"properties\": {\n                \"TimeCardFieldId\": {\n                    \"type\": \"string\"\n                },\n                \"Value\": {\n                    \"type\": \"string\"\n                },\n                \"TimeEntryId\": {\n                    \"type\": \"string\"\n                }\n            }\n        }\n    }\n}",
