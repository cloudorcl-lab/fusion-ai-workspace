                        {
                          "metadata": {
                            "name": "Create Tcf Binds Mapping",
                            "returnType": "object",
                            "sourceCode": "const uri = $context.$variables.qTcf?.RestURI;\nconst idToValMap = $context.$variables.qResolvedTcfIdToValueMapper; \nconst paramsString = uri.split('?')[1] ?? '';\nconst paramPairs = paramsString.split(/[;,]/);\nconst bindMap = {};\nbindMap.SearchTerm = $context.$variables.qTcfValue?.Value ;\nfor (const pair of paramPairs) {\n    const [paramKey, paramValue] = pair.split('=');\n    if (paramKey && paramKey !== 'finder' && paramValue) {\n        bindMap[paramKey] = paramValue;\n        if (/^BindTcfId[1-5]$/.test(paramKey)) {\n            const index = paramKey.match(/\\d/)[0];\n            bindMap[`BindTcf${index}Value`]= idToValMap[paramValue];        \n          }\n    }\n}\n\nreturn bindMap;"
                          },
                          "outcomes": {
                            "success": "1773386118760"
                          },
