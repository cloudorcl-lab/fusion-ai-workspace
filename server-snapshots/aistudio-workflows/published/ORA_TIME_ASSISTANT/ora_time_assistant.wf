                        {
                          "metadata": {
                            "name": "Evaluate TCF Value",
                            "returnType": "boolean",
                            "sourceCode": "const value = $context.$variables.qTcfValue?.Value;\nconst  isValueNotNull =   (value  != null) && (typeof value  === \"string\" && value?.trim() !== \"\");\n\nlet isHidden = ($context.$variables.qTcf?.DisplayType === \"HIDDEN\");\n\nconst result = (isValueNotNull && !isHidden) || (!isValueNotNull && isHidden && $context.$variables.qTcf?.FunctionBasedOnAnother != null  && typeof $context.$variables.qTcf?.FunctionBasedOnAnother === \"string\" && $context.$variables.qTcf?.FunctionBasedOnAnother?.trim() !== \"\");\n\n\nreturn result;"
                          },
