                            "returnType": "boolean",
                            "sourceCode": "const value = $context.$variables.qTcf?.DefaultValue;\nconst result = (value != null) && (typeof value !== 'string' || value.trim() !== '') && (typeof value !== 'object' || Object.keys(value).length > 0);\nreturn result;"
                          },
