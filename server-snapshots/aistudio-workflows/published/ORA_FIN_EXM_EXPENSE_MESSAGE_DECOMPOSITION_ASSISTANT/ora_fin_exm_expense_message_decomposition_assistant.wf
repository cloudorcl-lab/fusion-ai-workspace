        {
          "metadata": {
            "name": "fetchMessagePayload",
            "returnType": "object",
            "sourceCode": "let filter = `sourceTypeCode='MESSAGE' and id='${$context.$nodes.GETALLPARTNEREXPENSEIDS.$output.items[0].id}'`;\nlet payload = {\n    \"fields\": [\n        \"id\",\n        \"partnerExpenseReferenceId\"\n    ],\n    \"collection\": {\n        \"filter\": filter,\n        \"sortBy\": [\n            {\n                \"id\": \"desc\"\n            } \n        ]\n    },\n    \"subTypes\": {\n        \"MESSAGE\": {\n            \"fields\": [\n                \"systemInformation\"\n            ]\n        }\n    }\n}\n\nreturn payload;"
          },
          "outcomes": {
