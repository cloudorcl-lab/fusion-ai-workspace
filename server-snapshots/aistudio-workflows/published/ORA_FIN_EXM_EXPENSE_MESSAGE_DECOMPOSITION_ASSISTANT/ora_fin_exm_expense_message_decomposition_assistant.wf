          "metadata": {
            "businessObjectCode": "ORA_FIN_EXPENSES_GETAGENTINITPARAMS",
            "errorNodeId": "1777538160489",
            "functionName": "getAgentInitParams",
            "name": "Get Decomposition Attendee Prompt"
          },
          "outcomes": {
            "success": "1777538160489"
          },
          "code": "GET_DECOMPOSITION_ATTENDEE_PROMPT",
          "convergenceTargetId": "1777538160489",
          "id": "1775059770800",
          "inputs": [
            {
              "id": "1775059794562_1",
              "name": "agentName",
              "type": "string",
              "value": "DECOMPOSITION_ATTENDEE"
            }
          ],
          "outputSpecification": "{}",
