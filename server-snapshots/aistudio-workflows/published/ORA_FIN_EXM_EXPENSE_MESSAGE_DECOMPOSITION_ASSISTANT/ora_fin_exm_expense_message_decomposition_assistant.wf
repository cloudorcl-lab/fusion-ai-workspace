        {
          "metadata": {
            "name": "GetOldestPartnerExpenseId",
            "returnType": "string",
            "sourceCode": "const items = $context.$nodes.GETALLPARTNEREXPENSEIDS.$output.items;\n\n// Sort items by timeCreated in descending order (newest first)\nconst sorted = items.sort((a, b) => new Date(b.timeCreated) - new Date(a.timeCreated));\n\n// Get the second most recent record (newest-1th)\nconst partnerExpenseId = sorted[1] ? sorted[1].id : null;\nreturn partnerExpenseId;"
          },
          "outcomes": {
            "success": "1769239677653"
          },
          "code": "GETOLDESTPARTNEREXPENSEID",
          "id": "1770830657026",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Consolidator",
            "returnType": "object",
            "sourceCode": "const isSimplifiedExpense = $context.$triggers.REST.$input.isSimplifiedExpense;\n\nconst rawResolverOutputs = [\n  //$context.$nodes.ATTENDEES_RESOLUTION?.$output,\n $context.$nodes.ADDITIONAL_PROCESSING_ATTENDEES.$output.result,\n  //$context.$nodes.EXPENSE_FIELDS_AND_ACTIONS_RESOLUTION?.$output,\n $context.$nodes.ADDITIONAL_PROCESSING_EXPENSE_FIELDS.$output.result,\n  $context.$nodes.ALLOCATION_RESOLUTION?.$output,\n  $context.$nodes.HYDRATE_RECOMMENDATION_SELECTIONS?.$output,\n  $context.$nodes.RETURN_EMPTY_RECOMMENDATION_SELECTIONS?.$output\n];\n\n// -----------------------------------------------------------------------------\n// Field type mapping\n// -----------------------------------------------------------------------------\n\nconst plainTextFields = new Set([\n  \"description\",\n  \"expenseDate\",\n  \"exchangeRate\",\n  \"merchantName\",\n  \"numberOfAttendees\",\n  \"receiptAmount\",\n  \"receiptMissingJustification\",\n  \"exchangeRateJustification\",\n  \"corpCardJustification\",\n  \"rateLimitViolationJustification\",\n  \"flightClassJustification\",\n  \"justification\",\n  \"personalReceiptAmount\",\n  \"destinationFrom\",\n  \"destinationTo\",\n  \"passengerName\",\n  \"ticketNumber\",\n  \"flightDuration\",\n  \"agencyName\"\n]);\n\nconst unsupportedFields = new Set([\n  \"taxClassificationCode\",\n  \"expenseLocation\",\n  \"tripDistance\",\n  \"licensePlateNumber\",\n  \"startDate\",\n  \"endDate\",\n  \"vehicleCategoryCode\",\n  \"vehicleType\",\n  \"fuelType\"\n]);\n\nconst actionValues = new Set([\n  \"markAsPersonal\",\n]);\n\nconst supportedActionValues = new Set([\n  \"markAsPersonal\"\n]);\n\nconst supportedCoreFields = new Set([\n  ...plainTextFields,\n  ...unsupportedFields,\n  \"action\",\n  \"expenseSource\",\n  \"receiptCurrency\",\n  \"expenseType\",\n  \"flightClass\",\n  \"flightType\"\n]);\n\nconst alwaysArrayFields = new Set([\n  \"Attendees\",\n  \"NonEmployeeAttendees\",\n  \"AmbiguousAttendees\",\n  \"Project\",\n  \"Task\",\n  \"Company\",\n  \"Cost Center\",\n  \"customer\"\n]);\n\nconst fieldNameMap = Object.create(null);\n\nfieldNameMap.employeeAttendees = \"Attendees\";\nfieldNameMap.attendees = \"Attendees\";\nfieldNameMap.nonEmployeeAttendees = \"NonEmployeeAttendees\";\nfieldNameMap.nonEmployeeAttendee = \"NonEmployeeAttendees\";\nfieldNameMap.ambiguousAttendees = \"AmbiguousAttendees\";\nfieldNameMap.ambigousAttendees = \"AmbiguousAttendees\";\nfieldNameMap.numberOfAttendees = \"numberOfAttendees\";\nfieldNameMap.organizations = \"customer\";\nfieldNameMap.organization = \"customer\";\n\nfieldNameMap.project = \"Project\";\nfieldNameMap.task = \"Task\";\nfieldNameMap.company = \"Company\";\nfieldNameMap.costCenter = \"Cost Center\";\n\n// -----------------------------------------------------------------------------\n// Helpers\n// -----------------------------------------------------------------------------\n\nconst cleanJsonString = str => {\n  if (typeof str !== \"string\") return str;\n\n  return str\n    .trim()\n    .replace(/^```json\\s*/i, \"\")\n    .replace(/^```\\s*/i, \"\")\n    .replace(/```$/i, \"\")\n    .replace(/^json\\s*/i, \"\")\n    .trim();\n};\n\nconst safeParse = value => {\n  if (value === null || value === undefined) return null;\n  if (typeof value === \"object\") return value;\n  if (typeof value !== \"string\") return null;\n\n  try {\n    return JSON.parse(cleanJsonString(value));\n  } catch (e) {\n    return null;\n  }\n};\n\nconst parseJsonIfValid = value => {\n  if (value === null || value === undefined) return value;\n  if (typeof value === \"object\") return value;\n  if (typeof value !== \"string\") return value;\n\n  const cleaned = cleanJsonString(value);\n\n  if (!cleaned) return value;\n\n  try {\n    return JSON.parse(cleaned);\n  } catch (e) {\n    return value;\n  }\n};\n\nconst recommendationValue = value => {\n  return parseJsonIfValid(value);\n};\n\nconst unwrapOutput = value => {\n  let parsed = safeParse(value);\n\n  if (parsed === null || parsed === undefined) {\n    parsed = value;\n  }\n\n  if (parsed && typeof parsed === \"object\" && parsed.output !== undefined) {\n    const parsedOutput = safeParse(parsed.output);\n    parsed = parsedOutput === null || parsedOutput === undefined ? parsed.output : parsedOutput;\n  }\n\n  while (\n    parsed &&\n    typeof parsed === \"object\" &&\n    !Array.isArray(parsed) &&\n    parsed.result &&\n    typeof parsed.result === \"object\"\n  ) {\n    parsed = parsed.result;\n  }\n\n  return parsed;\n};\n\nconst flattenResolverOutput = output => {\n  if (!output || typeof output !== \"object\") return [];\n\n  if (Array.isArray(output)) {\n    return output.flatMap(item => flattenResolverOutput(item));\n  }\n\n  if (Array.isArray(output.DecomposedInstructions)) {\n    return output.DecomposedInstructions.flatMap(item => flattenResolverOutput(item));\n  }\n\n  return [output];\n};\n\nconst isEmptyValue = value => {\n  if (value === null || value === undefined) return true;\n  if (typeof value === \"string\" && value.trim() === \"\") return true;\n  if (Array.isArray(value) && value.length === 0) return true;\n  return false;\n};\n\nconst normalizeValue = value => {\n  if (value === null || value === undefined) return \"\";\n\n  if (Array.isArray(value)) {\n    return value.filter(v => v !== null && v !== undefined && String(v).trim() !== \"\");\n  }\n\n  return value;\n};\n\nconst dedupeArray = arr => {\n  const seen = new Set();\n  const out = [];\n\n  for (const item of arr || []) {\n    if (item === null || item === undefined || String(item).trim() === \"\") continue;\n\n    let key = \"\";\n\n    if (typeof item === \"object\") {\n      key = JSON.stringify(item);\n    } else {\n      key = String(item).trim().toLowerCase();\n    }\n\n    if (!seen.has(key)) {\n      seen.add(key);\n      out.push(item);\n    }\n  }\n\n  return out;\n};\n\nconst toCleanArray = value => {\n  const normalized = normalizeValue(value);\n\n  if (isEmptyValue(normalized)) return [];\n\n  if (Array.isArray(normalized)) {\n    return dedupeArray(normalized);\n  }\n\n  return dedupeArray([normalized]);\n};\n\nconst finalValueForField = (field, value) => {\n  const valueArray = toCleanArray(value);\n\n  if (valueArray.length === 0) return [];\n\n  if (alwaysArrayFields.has(field)) {\n    return valueArray;\n  }\n\n  if (valueArray.length === 1) {\n    return valueArray[0];\n  }\n\n  return valueArray;\n};\n\nconst canonicalFieldName = key => {\n  return fieldNameMap[key] || key;\n};\n\nconst isSingleCustomerNoneValue = (field, value) => {\n  if (field !== \"customer\") return false;\n\n  const values = Array.isArray(value) ? value : [value];\n\n  if (values.length !== 1) return false;\n\n  return String(values[0] || \"\").trim().toLowerCase() === \"none\";\n};\n\nconst deriveType = (field, value) => {\n  if (isSingleCustomerNoneValue(field, value)) return \"resolved\";\n\n  if (field === \"action\") return \"resolved\";\n\n  if (unsupportedFields.has(field)) return \"unsupported\";\n\n  if (field === \"expenseSource\") return \"resolved\";\n\n  if (Array.isArray(value)) {\n    if (value.some(v => actionValues.has(String(v)))) return \"resolved\";\n  } else if (actionValues.has(String(value))) {\n    return \"resolved\";\n  }\n\n  if (plainTextFields.has(field)) return \"resolved\";\n\n  return \"needsResolution\";\n};\n\nconst combineText = (existing, incoming) => {\n  const parts = [];\n\n  for (const item of [existing, incoming]) {\n    if (item === null || item === undefined) continue;\n\n    const text = String(item).trim();\n\n    if (!text) continue;\n    if (!parts.includes(text)) parts.push(text);\n  }\n\n  return parts.join(\" | \");\n};\n\nconst normalizeAmountString = value => {\n  if (value === null || value === undefined) return \"\";\n\n  let text = String(value).trim();\n  if (!text) return \"\";\n\n  text = text.replace(/,/g, \"\").trim();\n\n  if (!/^[+-]?(?:\\d+(?:\\.\\d+)?|\\.\\d+)$/.test(text)) {\n    return \"\";\n  }\n\n  return text;\n};\n\nconst maxNumberOfAttendees = values => {\n  let max = null;\n\n  for (const value of values) {\n    const candidates = Array.isArray(value) ? value : [value];\n\n    for (const candidate of candidates) {\n      const n = Number(String(candidate).trim());\n\n      if (!Number.isNaN(n)) {\n        max = max === null ? n : Math.max(max, n);\n      }\n    }\n  }\n\n  return max === null ? \"\" : String(max);\n};\n\nconst makeInstruction = data => {\n  const finalField = canonicalFieldName(data.field);\n  const finalValue = finalValueForField(finalField, data.value);\n\n  const item = Object.create(null);\n  item.message = data.message || \"\";\n  item.type = isSingleCustomerNoneValue(finalField, finalValue)\n    ? \"resolved\"\n    : deriveType(finalField, finalValue);\n  item.field = finalField;\n  item.value = finalValue;\n  item.reasoning = data.reasoning || \"Extracted \" + finalField;\n\n  return item;\n};\n\n// -----------------------------------------------------------------------------\n// Original message\n// -----------------------------------------------------------------------------\n\nconst originalMessage =\n  $context.$nodes.PREPARE_DECOMPOSITION_MESSAGE?.$output?.result?.decompositionUserMessage ||\n  $context.$nodes.PREPARE_DECOMPOSITION_MESSAGE?.$output?.decompositionUserMessage ||\n  $context.$triggers.REST?.$input?.result?.decompositionUserMessage ||\n  $context.$triggers.REST?.$input?.decompositionUserMessage ||\n  $context.$triggers.REST?.$input?.userMessage ||\n  $context.$triggers.REST?.$input?.inputMessage ||\n  \"\";\n\nconst originalMessageText = String(originalMessage || \"\");\nconst originalMessageLower = originalMessageText.toLowerCase();\n\nconst hasAnyCue = patterns => {\n  return patterns.some(pattern => pattern.test(originalMessageText));\n};\n\nconst isBareAttachmentInput = () => {\n  return /^\\s*\\[[^\\]]+\\.(?:png|jpe?g|gif|heic|pdf|tiff?|bmp)\\]\\s*$/i.test(originalMessageText);\n};\n\nconst hasExplicitAttendeeCountCue = () => {\n  return /\\b(?:number\\s+of\\s+attendees?|attendee\\s+count|attendees?\\s+count)\\b/i.test(originalMessageText) ||\n    /\\battendees?\\s*(?:were|was|are|is|=|:|-)\\s*(?:\\d+|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve)\\b/i.test(originalMessageText) ||\n    /\\b(?:\\d+|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve)\\s+attendees?\\b/i.test(originalMessageText);\n};\n\nconst isGenericGroupLabel = value => {\n  const key = String(value || \"\").trim().toLowerCase();\n  return /^(?:client|customer|vendor|partner|team|my team|our team|client team|customer team|guests?|people|attendees?|participants?|employees?|staff)$/.test(key);\n};\n\nconst messageForGroup = () => {\n  return originalMessage;\n};\n\n// -----------------------------------------------------------------------------\n// Parse resolver outputs\n// -----------------------------------------------------------------------------\n\nlet parsedTopLevelOutputs = rawResolverOutputs\n  .map(v => unwrapOutput(v))\n  .filter(v => v && typeof v === \"object\");\n\nif (\n  Array.isArray(parsedTopLevelOutputs) &&\n  parsedTopLevelOutputs.length > 0 &&\n  parsedTopLevelOutputs[0] &&\n  Array.isArray(parsedTopLevelOutputs[0].result)\n) {\n  parsedTopLevelOutputs = parsedTopLevelOutputs[0].result.map(v => unwrapOutput(v));\n}\n\nlet parsedOutputs = parsedTopLevelOutputs.flatMap(output => flattenResolverOutput(output));\n\n// -----------------------------------------------------------------------------\n// Recommendation option selections\n// -----------------------------------------------------------------------------\n\nlet recommendedOptionSelections = [];\n\nfor (const output of parsedTopLevelOutputs) {\n  if (output && Array.isArray(output.recommendedOptionSelections)) {\n    recommendedOptionSelections.push(...output.recommendedOptionSelections);\n  }\n}\n\nconst recommendedInstructions = recommendedOptionSelections.map(item => {\n  const canonicalField = canonicalFieldName(item.fieldType || \"\");\n  const finalValue = recommendationValue(item.fieldValue);\n\n  const instruction = Object.create(null);\n  instruction.message = item.sentence || \"\";\n  instruction.type = \"rec_resolved\";\n  instruction.field = canonicalField;\n  instruction.value = finalValue;\n  instruction.reasoning =\n    item.reasoning ||\n    \"Resolved via recommended option selection (\" + (item.predictionString || \"\") + \")\";\n\n  return instruction;\n});\n\n// -----------------------------------------------------------------------------\n// Convert resolver outputs to DecomposedInstructions\n// -----------------------------------------------------------------------------\n\nlet decomposedInstructions = [];\n\n// Attendee shape\nfor (const output of parsedOutputs) {\n  const hasAttendeeShape =\n    Object.prototype.hasOwnProperty.call(output, \"employeeAttendees\") ||\n    Object.prototype.hasOwnProperty.call(output, \"attendees\") ||\n    Object.prototype.hasOwnProperty.call(output, \"nonEmployeeAttendees\") ||\n    Object.prototype.hasOwnProperty.call(output, \"nonEmployeeAttendee\") ||\n    Object.prototype.hasOwnProperty.call(output, \"ambigousAttendees\") ||\n    Object.prototype.hasOwnProperty.call(output, \"ambiguousAttendees\") ||\n    Object.prototype.hasOwnProperty.call(output, \"organizations\") ||\n    Object.prototype.hasOwnProperty.call(output, \"organization\") ||\n    Object.prototype.hasOwnProperty.call(output, \"numberOfAttendees\") ||\n    Object.prototype.hasOwnProperty.call(output, \"delegation\");\n\n  if (!hasAttendeeShape) continue;\n\n  const message = output.message || messageForGroup(\"attendee\");\n  const reasoning = output.reasoning || \"Extracted attendee details from attendee resolver output\";\n\n  const attendeeFields = [\n    \"numberOfAttendees\",\n    \"employeeAttendees\",\n    \"attendees\",\n    \"nonEmployeeAttendees\",\n    \"nonEmployeeAttendee\",\n    \"ambigousAttendees\",\n    \"ambiguousAttendees\",\n    \"organizations\",\n    \"organization\"\n  ];\n\n  for (const key of attendeeFields) {\n    const valueArray = toCleanArray(output[key]);\n\n    if (valueArray.length === 0) continue;\n\n    const data = Object.create(null);\n    data.message = message;\n    data.field = key;\n    data.value = valueArray;\n    data.reasoning = reasoning;\n\n    decomposedInstructions.push(makeInstruction(data));\n  }\n\n  const attendeeDelegations = toCleanArray(output.delegation);\n\n  for (const delegationText of attendeeDelegations) {\n    const item = Object.create(null);\n    item.message = String(delegationText);\n    item.type = \"delegation\";\n    item.field = \"\";\n    item.value = \"\";\n    item.reasoning = \"Detected by attendee resolver\";\n    decomposedInstructions.push(item);\n  }\n}\n\n// Allocation shape\nfor (const output of parsedOutputs) {\n  const hasAllocationShape =\n    Object.prototype.hasOwnProperty.call(output, \"project\") ||\n    Object.prototype.hasOwnProperty.call(output, \"task\") ||\n    Object.prototype.hasOwnProperty.call(output, \"company\") ||\n    Object.prototype.hasOwnProperty.call(output, \"costCenter\");\n\n  if (!hasAllocationShape) continue;\n\n  const message = output.message || messageForGroup(\"allocation\");\n  const reasoning = output.reasoning || \"Extracted allocation fields from allocation resolver output\";\n\n  const allocationFields = [\"project\", \"task\", \"company\", \"costCenter\"];\n\n  for (const key of allocationFields) {\n    const valueArray = toCleanArray(output[key]);\n\n    if (valueArray.length === 0) continue;\n\n    const data = Object.create(null);\n    data.message = message;\n    data.field = key;\n    data.value = valueArray;\n    data.reasoning = reasoning;\n\n    decomposedInstructions.push(makeInstruction(data));\n  }\n}\n\n// Core shape\nconst nonCoreOutputKeys = new Set([\n  \"DecomposedInstructions\",\n  \"recommendedOptionSelections\",\n\n  \"employeeAttendees\",\n  \"attendees\",\n  \"nonEmployeeAttendees\",\n  \"nonEmployeeAttendee\",\n  \"ambigousAttendees\",\n  \"ambiguousAttendees\",\n  \"organizations\",\n  \"organization\",\n  \"numberOfAttendees\",\n  \"delegation\",\n\n  \"project\",\n  \"task\",\n  \"company\",\n  \"costCenter\",\n\n  \"message\",\n  \"reasoning\"\n]);\n\nfor (const output of parsedOutputs) {\n  if (!output || typeof output !== \"object\" || Array.isArray(output)) continue;\n\n  const isAttendee =\n    Object.prototype.hasOwnProperty.call(output, \"employeeAttendees\") ||\n    Object.prototype.hasOwnProperty.call(output, \"attendees\") ||\n    Object.prototype.hasOwnProperty.call(output, \"nonEmployeeAttendees\") ||\n    Object.prototype.hasOwnProperty.call(output, \"nonEmployeeAttendee\") ||\n    Object.prototype.hasOwnProperty.call(output, \"ambigousAttendees\") ||\n    Object.prototype.hasOwnProperty.call(output, \"ambiguousAttendees\") ||\n    Object.prototype.hasOwnProperty.call(output, \"organizations\") ||\n    Object.prototype.hasOwnProperty.call(output, \"organization\") ||\n    Object.prototype.hasOwnProperty.call(output, \"numberOfAttendees\") ||\n    Object.prototype.hasOwnProperty.call(output, \"delegation\");\n\n  const isRecommendation = Array.isArray(output.recommendedOptionSelections);\n\n  if (isAttendee || isRecommendation) continue;\n\n  const message = output.message || messageForGroup(\"core\");\n  const reasoning = output.reasoning || \"Extracted core field from core resolver output\";\n\n  for (const key of Object.keys(output)) {\n    if (nonCoreOutputKeys.has(key)) continue;\n    if (!supportedCoreFields.has(key)) continue;\n\n    const currencyBelongsToPersonalAmount =\n      key === \"receiptCurrency\" &&\n      Object.prototype.hasOwnProperty.call(output, \"personalReceiptAmount\") &&\n      !Object.prototype.hasOwnProperty.call(output, \"receiptAmount\") &&\n      !/\\b(?:currency|receipt\\s+currency)\\b/i.test(message);\n\n    if (currencyBelongsToPersonalAmount) continue;\n\n    let valueArray = toCleanArray(output[key]);\n\n    if (key === \"receiptAmount\" || key === \"personalReceiptAmount\") {\n      valueArray = valueArray\n        .map(normalizeAmountString)\n        .filter(value => value !== \"\");\n    }\n\n    if (key === \"action\") {\n      valueArray = valueArray.filter(value => supportedActionValues.has(String(value)));\n    }\n\n    if (valueArray.length === 0) continue;\n\n    const data = Object.create(null);\n    data.message = message;\n    data.field = key;\n    data.value = valueArray;\n    data.reasoning = reasoning;\n\n    decomposedInstructions.push(makeInstruction(data));\n  }\n}\n\n// Add recommendation instructions\ndecomposedInstructions.push(...recommendedInstructions);\n\n// -----------------------------------------------------------------------------\n// Add irrelevant only when every resolver produced nothing meaningful.\n// -----------------------------------------------------------------------------\n\nconst hasUsefulInstruction = decomposedInstructions.some(item => item && item.type !== \"irrelevant\");\n\nif (!hasUsefulInstruction) {\n  const irrelevantMessages = [];\n\n  if (irrelevantMessages.length === 0 && String(originalMessage).trim() !== \"\") {\n    irrelevantMessages.push(originalMessage);\n  }\n\n  const irrelevantInstructions = irrelevantMessages.map(message => {\n    const item = Object.create(null);\n    item.message = String(message);\n    item.type = \"irrelevant\";\n    item.field = \"\";\n    item.value = String(message);\n    item.reasoning = \"No resolver extracted attendee, allocation, core, recommendation, or delegation details\";\n    return item;\n  });\n\n  decomposedInstructions.push(...irrelevantInstructions);\n}\n\n// -----------------------------------------------------------------------------\n// Only merge numberOfAttendees.\n// Keep all other repeated fields as separate DecomposedInstruction items.\n// -----------------------------------------------------------------------------\n\nconst clubRepeatedFields = instructions => {\n  const output = [];\n\n  let numberOfAttendeesItem = null;\n  let numberOfAttendeesValues = [];\n  let numberOfAttendeesInsertIndex = -1;\n\n  for (const item of instructions) {\n    if (!item) continue;\n\n    const field = canonicalFieldName(item.field || \"\");\n\n    if (item.type === \"rec_resolved\") {\n      const recValue = recommendationValue(item.value);\n\n      if (isEmptyValue(recValue)) continue;\n\n      const newItem = Object.assign(Object.create(null), item);\n      newItem.field = field;\n      newItem.value = recValue;\n      newItem.type = \"rec_resolved\";\n\n      output.push(newItem);\n      continue;\n    }\n\n    const valueArray = toCleanArray(item.value);\n\n    if (field === \"numberOfAttendees\") {\n      if (valueArray.length === 0) continue;\n\n      if (!numberOfAttendeesItem) {\n        numberOfAttendeesItem = Object.assign(Object.create(null), item);\n        numberOfAttendeesItem.field = \"numberOfAttendees\";\n        numberOfAttendeesItem.type = \"resolved\";\n        numberOfAttendeesItem.message = item.message || \"\";\n        numberOfAttendeesItem.reasoning = item.reasoning || \"\";\n\n        numberOfAttendeesInsertIndex = output.length;\n      } else {\n        numberOfAttendeesItem.message = combineText(\n          numberOfAttendeesItem.message,\n          item.message\n        );\n\n        numberOfAttendeesItem.reasoning = combineText(\n          numberOfAttendeesItem.reasoning,\n          item.reasoning\n        );\n      }\n\n      numberOfAttendeesValues.push(...valueArray);\n      continue;\n    }\n\n    if (item.type === \"delegation\" || item.type === \"irrelevant\" || !field) {\n      output.push(item);\n      continue;\n    }\n\n    if (valueArray.length === 0) continue;\n\n    const finalValue = finalValueForField(field, valueArray);\n\n    if (isEmptyValue(finalValue)) continue;\n\n    const newItem = Object.assign(Object.create(null), item);\n    newItem.field = field;\n\n    if (isSingleCustomerNoneValue(field, finalValue)) {\n      newItem.value = \"None\";\n      newItem.type = \"resolved\";\n    } else {\n      newItem.value = finalValue;\n      newItem.type = item.type || deriveType(field, finalValue);\n    }\n\n    output.push(newItem);\n  }\n\n  if (numberOfAttendeesItem) {\n    const maxAttendees = maxNumberOfAttendees(numberOfAttendeesValues);\n\n    if (maxAttendees !== \"\") {\n      numberOfAttendeesItem.value = maxAttendees;\n\n      if (\n        numberOfAttendeesInsertIndex >= 0 &&\n        numberOfAttendeesInsertIndex <= output.length\n      ) {\n        output.splice(numberOfAttendeesInsertIndex, 0, numberOfAttendeesItem);\n      } else {\n        output.push(numberOfAttendeesItem);\n      }\n    }\n  }\n\n  return output;\n};\n\ndecomposedInstructions = clubRepeatedFields(decomposedInstructions);\n\n// -----------------------------------------------------------------------------\n// Context-aware suppression for common resolver overlap and example leakage.\n// -----------------------------------------------------------------------------\n\nif (isBareAttachmentInput()) {\n  const item = Object.create(null);\n  item.message = originalMessageText;\n  item.type = \"irrelevant\";\n  item.field = \"\";\n  item.value = originalMessageText;\n  item.reasoning = \"Attachment-only message has no user update instruction\";\n  decomposedInstructions = [item];\n}\n\nconst keepInstructionForContext = item => {\n  if (!item || item.type === \"irrelevant\" || item.type === \"delegation\" || item.type === \"rec_resolved\") return true;\n\n  const field = canonicalFieldName(item.field || \"\");\n  const values = Array.isArray(item.value) ? item.value : [item.value];\n\n  if (field === \"description\") {\n    if (!hasAnyCue([/\\bdescrip(?:tion|e)\\b/i, /\\bpurpose\\b/i, /\\bmemo\\b/i, /\\bnotes?\\b/i])) {\n      item.groundingReviewReason = \"description extracted without a direct description, purpose, memo, or note cue\";\n    }\n    return true;\n  }\n\n  if (field === \"expenseType\") {\n    if (!hasAnyCue([/\\bexpense\\s+type\\b/i, /\\bexpense\\s+category\\b/i, /\\bcategor(?:y|ize)\\b/i])) {\n      item.groundingReviewReason = \"expenseType extracted without a direct expense type, expense category, categorize cue\";\n    }\n    return true;\n  }\n\n  if (field === \"receiptAmount\" || field === \"receiptCurrency\") {\n    if (!hasAnyCue([/\\breceipt\\s+amount\\b/i, /\\bamount\\b/i, /\\btotal\\b/i, /\\bcurrency\\b/i, /\\breceipt\\s+currency\\b/i])) {\n      item.groundingReviewReason = field + \" extracted without a direct amount, total, currency, receipt amount, or receipt currency cue\";\n    }\n    return true;\n  }\n\n  if (field === \"customer\") {\n    if (isSingleCustomerNoneValue(field, item.value)) return true;\n    return !values.every(value => isGenericGroupLabel(value) || /^[a-z0-9.-]+\\.[a-z]{2,}$/i.test(String(value || \"\").trim()));\n  }\n\n  if (\n    field === \"Attendees\" ||\n    field === \"NonEmployeeAttendees\" ||\n    field === \"AmbiguousAttendees\"\n  ) {\n    return !values.every(value => isGenericGroupLabel(value));\n  }\n\n  if (field === \"numberOfAttendees\") {\n    return true;\n  }\n\n  return true;\n};\n\ndecomposedInstructions = decomposedInstructions.filter(keepInstructionForContext);\n\nif (decomposedInstructions.length === 0 && originalMessageText.trim() !== \"\") {\n  const item = Object.create(null);\n  item.message = originalMessageText;\n  item.type = \"irrelevant\";\n  item.field = \"\";\n  item.value = originalMessageText;\n  item.reasoning = \"No resolver output survived grounding and overlap cleanup\";\n  decomposedInstructions.push(item);\n}\n\n// -----------------------------------------------------------------------------\n// Final cleanup\n// -----------------------------------------------------------------------------\n\ndecomposedInstructions = decomposedInstructions.filter(item => {\n  if (!item) return false;\n\n  const messageIsEmpty =\n    item.message === null ||\n    item.message === undefined ||\n    String(item.message).trim() === \"\";\n\n  const valueIsEmpty = isEmptyValue(item.value);\n\n  if (item.type === \"irrelevant\") {\n    if (messageIsEmpty && valueIsEmpty) return false;\n    return true;\n  }\n\n  if (item.type === \"delegation\") return true;\n\n  if (!item.field && valueIsEmpty) return false;\n  if (valueIsEmpty) return false;\n\n  if (item.field && Array.isArray(item.value) && item.value.length === 0) {\n    return false;\n  }\n\n  return true;\n});\n\n// Remove exact duplicate instructions only.\nconst seen = new Set();\n\ndecomposedInstructions = decomposedInstructions.filter(item => {\n  const keyObj = Object.create(null);\n  keyObj.message = item.message;\n  keyObj.type = item.type;\n  keyObj.field = item.field;\n  keyObj.value = item.value;\n\n  const key = JSON.stringify(keyObj);\n\n  if (seen.has(key)) return false;\n\n  seen.add(key);\n  return true;\n});\n\n// -----------------------------------------------------------------------------\n// Build value-level candidates and detect field conflicts.\n// -----------------------------------------------------------------------------\n\nconst conflictExcludedTypes = new Set([\"delegation\", \"irrelevant\"]);\nconst conflictExcludedFields = new Set([\"\", \"numberOfAttendees\"]);\n\nconst sourceResolverFor = item => {\n  if (!item) return \"unknown\";\n  if (item.type === \"rec_resolved\") return \"recommendation\";\n  if (item.type === \"delegation\") return \"attendee\";\n  if (item.type === \"irrelevant\") return \"consolidator\";\n\n  const field = canonicalFieldName(item.field || \"\");\n\n  if (\n    field === \"Attendees\" ||\n    field === \"NonEmployeeAttendees\" ||\n    field === \"AmbiguousAttendees\" ||\n    field === \"customer\" ||\n    field === \"numberOfAttendees\"\n  ) {\n    return \"attendee\";\n  }\n\n  if (\n    field === \"Project\" ||\n    field === \"Task\" ||\n    field === \"Company\" ||\n    field === \"Cost Center\"\n  ) {\n    return \"allocation\";\n  }\n\n  return \"core\";\n};\n\nconst stableValueForKey = value => {\n  if (value === null || value === undefined) return \"\";\n\n  if (typeof value === \"object\") {\n    try {\n      return JSON.stringify(value);\n    } catch (e) {\n      return String(value);\n    }\n  }\n\n  return String(value);\n};\n\nconst normalizeConflictValue = value => {\n  const raw = stableValueForKey(value).trim().toLowerCase();\n\n  if (!raw) return \"\";\n\n  return raw\n    .replace(/[^a-z0-9]+/g, \"\")\n    .trim();\n};\n\nconst stripFieldLabelsForConflict = value => {\n  let text = stableValueForKey(value).trim().toLowerCase();\n\n  if (!text) return \"\";\n\n  text = text\n    .replace(/^(?:project|task|company|customer|client|cost\\s*center|cost\\s*centre|expense\\s*type|type|category|description)\\s*[:#-]?\\s+/i, \"\")\n    .replace(/\\s+(?:project|task|company|customer|client|cost\\s*center|cost\\s*centre|expense\\s*type|type|category)$/i, \"\")\n    .trim();\n\n  return normalizeConflictValue(text);\n};\n\nconst valueEqualsForDedupe = (a, b) => {\n  const aKey = normalizeConflictValue(a);\n  const bKey = normalizeConflictValue(b);\n\n  if (aKey || bKey) return aKey === bKey;\n\n  return stableValueForKey(a) === stableValueForKey(b);\n};\n\nconst makeCandidateAtoms = instructions => {\n  const atoms = [];\n  let counter = 1;\n\n  for (let instructionIndex = 0; instructionIndex < instructions.length; instructionIndex++) {\n    const item = instructions[instructionIndex];\n\n    if (!item) continue;\n\n    const field = canonicalFieldName(item.field || \"\");\n    const values = Array.isArray(item.value) ? item.value : [item.value];\n    const cleanValues = values.filter(value => !isEmptyValue(value));\n\n    if (cleanValues.length === 0 && item.type !== \"delegation\" && item.type !== \"irrelevant\") {\n      continue;\n    }\n\n    const atomValues = cleanValues.length > 0 ? cleanValues : [\"\"];\n\n    for (const value of atomValues) {\n      const normalizedValueKey = normalizeConflictValue(value);\n      const conflictEligible =\n        !conflictExcludedTypes.has(item.type || \"\") &&\n        !conflictExcludedFields.has(field) &&\n        normalizedValueKey !== \"\";\n\n      const atom = Object.create(null);\n      atom.candidateId = \"cand_\" + counter;\n      atom.instructionId = \"instruction_\" + (instructionIndex + 1);\n      atom.groupingKey = [\n        item.message || \"\",\n        isSingleCustomerNoneValue(field, value) ? \"resolved\" : item.type || \"\",\n        field,\n        item.reasoning || \"\"\n      ].join(\"\\u001f\");\n      atom.message = item.message || \"\";\n      atom.type = isSingleCustomerNoneValue(field, value)\n        ? \"resolved\"\n        : item.type || deriveType(field, value);\n      atom.field = field;\n      atom.value = value;\n      atom.reasoning = item.reasoning || \"\";\n      atom.sourceResolver = sourceResolverFor(item);\n      atom.groundingReviewReason = item.groundingReviewReason || \"\";\n      atom.normalizedValueKey = normalizedValueKey;\n      atom.conflictKeys = dedupeArray([\n        normalizedValueKey,\n        stripFieldLabelsForConflict(value)\n      ]).filter(Boolean);\n      atom.conflictEligible = conflictEligible;\n\n      if (atom.type === \"rec_resolved\") {\n        atom.groupingKey = atom.groupingKey + \"\\u001f\" + stableValueForKey(atom.value);\n      }\n\n      atoms.push(atom);\n      counter++;\n    }\n  }\n\n  return atoms;\n};\n\nconst dedupeSameFieldCandidates = atoms => {\n  const byKey = new Map();\n  const output = [];\n\n  for (const atom of atoms) {\n    const dedupeKey = [\n      atom.field || \"\",\n      atom.normalizedValueKey || stableValueForKey(atom.value).toLowerCase()\n    ].join(\"\\u001f\");\n\n    if (!byKey.has(dedupeKey)) {\n      byKey.set(dedupeKey, atom);\n      output.push(atom);\n      continue;\n    }\n\n    const existing = byKey.get(dedupeKey);\n    existing.message = combineText(existing.message, atom.message);\n    existing.reasoning = combineText(existing.reasoning, atom.reasoning);\n    existing.sourceResolver = combineText(existing.sourceResolver, atom.sourceResolver);\n    existing.groundingReviewReason = combineText(existing.groundingReviewReason, atom.groundingReviewReason);\n\n    if (atom.type === \"rec_resolved\" && existing.type !== \"rec_resolved\") {\n      existing.type = \"rec_resolved\";\n      existing.sourceResolver = \"recommendation\";\n    }\n\n    if (isSingleCustomerNoneValue(existing.field, existing.value)) {\n      existing.value = \"None\";\n      existing.type = \"resolved\";\n    }\n  }\n\n  return output;\n};\n\nconst conflictBucketsFor = atoms => {\n  const buckets = new Map();\n\n  for (const atom of atoms) {\n    if (!atom.conflictEligible) continue;\n\n    const keys = Array.isArray(atom.conflictKeys) && atom.conflictKeys.length > 0\n      ? atom.conflictKeys\n      : [atom.normalizedValueKey];\n\n    for (const key of keys) {\n      if (!key) continue;\n\n      if (!buckets.has(key)) {\n        buckets.set(key, []);\n      }\n\n      const bucket = buckets.get(key);\n\n      if (!bucket.some(existing => existing.candidateId === atom.candidateId)) {\n        bucket.push(atom);\n      }\n    }\n  }\n\n  return buckets;\n};\n\nlet candidateAtoms = dedupeSameFieldCandidates(makeCandidateAtoms(decomposedInstructions));\n\nconst deterministicDropCandidateIds = new Set();\n\nfor (const bucket of conflictBucketsFor(candidateAtoms).values()) {\n  const fields = new Set(bucket.map(atom => atom.field));\n\n  if (fields.size <= 1) continue;\n\n  const hasRecommendation = bucket.some(atom => atom.type === \"rec_resolved\");\n\n  if (!hasRecommendation) continue;\n\n  for (const atom of bucket) {\n    if (atom.type !== \"rec_resolved\") {\n      deterministicDropCandidateIds.add(atom.candidateId);\n    }\n  }\n}\n\ncandidateAtoms = candidateAtoms.filter(atom => !deterministicDropCandidateIds.has(atom.candidateId));\n\nconst buildConflictGroups = atoms => {\n  const groups = [];\n  let groupCounter = 1;\n  const groupedCandidateKeys = new Set();\n  const semanticConflictCandidateIds = new Set();\n\n  const candidateForConflictGroup = atom => {\n    const candidate = Object.create(null);\n    candidate.candidateId = atom.candidateId;\n    candidate.field = atom.field;\n    candidate.type = atom.type;\n    candidate.value = atom.value;\n    candidate.sourceResolver = atom.sourceResolver;\n    candidate.message = atom.message;\n    if (atom.groundingReviewReason) {\n      candidate.groundingReviewReason = atom.groundingReviewReason;\n    }\n    return candidate;\n  };\n\n  const addCoreGroundingReviewGroup = atom => {\n    if (!atom || !atom.groundingReviewReason) return;\n\n    const groupKey = \"coreGroundingReview|\" + atom.candidateId;\n    if (groupedCandidateKeys.has(groupKey)) return;\n    groupedCandidateKeys.add(groupKey);\n\n    const rejectCandidate = Object.create(null);\n    rejectCandidate.candidateId = \"reject_\" + atom.candidateId;\n    rejectCandidate.field = \"__reject__\";\n    rejectCandidate.type = \"review_reject\";\n    rejectCandidate.value = \"Reject this extraction\";\n    rejectCandidate.sourceResolver = \"consolidator\";\n    rejectCandidate.message = atom.message;\n    rejectCandidate.groundingReviewReason = atom.groundingReviewReason;\n\n    const group = Object.create(null);\n    group.groupId = \"conflict_\" + groupCounter;\n    group.normalizedValueKey = \"review:\" + atom.candidateId;\n    group.displayValue = atom.field + \" requires grounding review\";\n    group.conflictKind = \"coreGroundingReview\";\n    group.reviewReason = atom.groundingReviewReason;\n    group.candidates = [\n      candidateForConflictGroup(atom),\n      rejectCandidate\n    ];\n\n    groups.push(group);\n    groupCounter++;\n  };\n\n  for (const atom of atoms) {\n    addCoreGroundingReviewGroup(atom);\n  }\n\n  const addNumberOfAttendeesGroundingReviewGroup = atom => {\n    if (!atom || atom.field !== \"numberOfAttendees\") return;\n\n    const groupKey = \"numberOfAttendeesGroundingReview|\" + atom.candidateId;\n    if (groupedCandidateKeys.has(groupKey)) return;\n    groupedCandidateKeys.add(groupKey);\n\n    const reviewReason = \"numberOfAttendees extracted without an explicit attendee count cue and without attendee names, emails, or organizations\";\n\n    const countCandidate = candidateForConflictGroup(atom);\n    countCandidate.groundingReviewReason = reviewReason;\n\n    const rejectCandidate = Object.create(null);\n    rejectCandidate.candidateId = \"reject_\" + atom.candidateId;\n    rejectCandidate.field = \"__reject__\";\n    rejectCandidate.type = \"review_reject\";\n    rejectCandidate.value = \"Reject this extraction\";\n    rejectCandidate.sourceResolver = \"consolidator\";\n    rejectCandidate.message = atom.message;\n    rejectCandidate.groundingReviewReason = reviewReason;\n\n    const group = Object.create(null);\n    group.groupId = \"conflict_\" + groupCounter;\n    group.normalizedValueKey = \"review:numberOfAttendees:\" + atom.candidateId;\n    group.displayValue = \"numberOfAttendees requires grounding review\";\n    group.conflictKind = \"numberOfAttendeesGroundingReview\";\n    group.reviewReason = reviewReason;\n    group.candidates = [\n      countCandidate,\n      rejectCandidate\n    ];\n\n    groups.push(group);\n    groupCounter++;\n  };\n\n  const addSemanticConflictGroup = (bucket, normalizedValueKey, displayValue, conflictKind) => {\n    if (bucket.length <= 1) return;\n\n    const groupKey = bucket.map(atom => atom.candidateId).sort().join(\"|\");\n\n    if (groupedCandidateKeys.has(groupKey)) return;\n    groupedCandidateKeys.add(groupKey);\n\n    for (const atom of bucket) {\n      semanticConflictCandidateIds.add(atom.candidateId);\n    }\n\n    const group = Object.create(null);\n    group.groupId = \"conflict_\" + groupCounter;\n    group.normalizedValueKey = normalizedValueKey;\n    group.displayValue = displayValue;\n    group.conflictKind = conflictKind;\n    group.candidates = bucket.map(candidateForConflictGroup);\n\n    groups.push(group);\n    groupCounter++;\n  };\n\n  const attendeePassengerConflictFields = new Set([\n    \"Attendees\",\n    \"NonEmployeeAttendees\",\n    \"AmbiguousAttendees\",\n    \"numberOfAttendees\"\n  ]);\n  const attendeeDetailFields = new Set([\n    \"Attendees\",\n    \"NonEmployeeAttendees\",\n    \"AmbiguousAttendees\",\n    \"customer\"\n  ]);\n  const numberOfAttendeesAtoms = atoms.filter(atom => atom.field === \"numberOfAttendees\");\n  const hasAttendeeDetailsForCount = atoms.some(atom =>\n    attendeeDetailFields.has(atom.field) &&\n    !isSingleCustomerNoneValue(atom.field, atom.value)\n  );\n  const hasPassengerOrDelegationForCount = atoms.some(atom =>\n    atom.field === \"passengerName\" ||\n    atom.type === \"delegation\"\n  );\n\n  if (\n    numberOfAttendeesAtoms.length > 0 &&\n    !hasExplicitAttendeeCountCue() &&\n    !hasAttendeeDetailsForCount &&\n    !hasPassengerOrDelegationForCount\n  ) {\n    for (const atom of numberOfAttendeesAtoms) {\n      addNumberOfAttendeesGroundingReviewGroup(atom);\n    }\n  }\n\n  const passengerAtoms = atoms.filter(atom => atom.field === \"passengerName\");\n  const attendeeAtoms = atoms.filter(atom => attendeePassengerConflictFields.has(atom.field));\n\n  if (passengerAtoms.length > 0 && attendeeAtoms.length > 0) {\n    const bucket = passengerAtoms.concat(attendeeAtoms);\n    addSemanticConflictGroup(\n      bucket,\n      \"semantic:passengerNameVsAttendeeFields\",\n      \"passengerName conflicts with attendee fields\",\n      \"passengerNameVsAttendeeFields\"\n    );\n  }\n\n  const companyAtoms = atoms.filter(atom => atom.field === \"Company\");\n  const customerAtoms = atoms.filter(atom =>\n    atom.field === \"customer\" &&\n    !isSingleCustomerNoneValue(atom.field, atom.value)\n  );\n\n  if (companyAtoms.length > 0 && customerAtoms.length > 0) {\n    addSemanticConflictGroup(\n      companyAtoms.concat(customerAtoms),\n      \"semantic:companyVsCustomer\",\n      \"Company conflicts with customer\",\n      \"companyVsCustomer\"\n    );\n  }\n\n  const delegationAtoms = atoms.filter(atom => atom.type === \"delegation\");\n  const attendeeDelegationConflictFields = new Set([\n    \"Attendees\",\n    \"NonEmployeeAttendees\",\n    \"AmbiguousAttendees\",\n    \"numberOfAttendees\",\n    \"customer\",\n    \"passengerName\"\n  ]);\n  const attendeeOutputAtoms = atoms.filter(atom => attendeeDelegationConflictFields.has(atom.field));\n\n  if (delegationAtoms.length > 0 && attendeeOutputAtoms.length > 0) {\n    addSemanticConflictGroup(\n      delegationAtoms.concat(attendeeOutputAtoms),\n      \"semantic:delegationVsAttendee\",\n      \"delegation conflicts with attendee/passenger fields\",\n      \"delegationVsAttendee\"\n    );\n  }\n\n  const receiptAmountAtoms = atoms.filter(atom => atom.field === \"receiptAmount\");\n  const personalAmountAtoms = atoms.filter(atom => atom.field === \"personalReceiptAmount\");\n  const markAsPersonalAtoms = atoms.filter(atom =>\n    atom.field === \"action\" &&\n    String(atom.value || \"\").trim() === \"markAsPersonal\"\n  );\n\n  const receiptPersonalBuckets = [\n    receiptAmountAtoms,\n    personalAmountAtoms,\n    markAsPersonalAtoms\n  ].filter(bucket => bucket.length > 0);\n\n  if (receiptPersonalBuckets.length > 1) {\n    addSemanticConflictGroup(\n      receiptAmountAtoms.concat(personalAmountAtoms, markAsPersonalAtoms),\n      \"semantic:receiptAmountPersonalReceiptAmountMarkAsPersonal\",\n      \"receiptAmount, personalReceiptAmount, and markAsPersonal action conflict\",\n      \"receiptAmountPersonalReceiptAmountMarkAsPersonal\"\n    );\n  }\n\n  for (const [normalizedValueKey, bucket] of conflictBucketsFor(atoms)) {\n    if (bucket.some(atom => semanticConflictCandidateIds.has(atom.candidateId))) continue;\n\n    const fields = new Set(bucket.map(atom => atom.field));\n\n    if (fields.size <= 1) continue;\n\n    const groupKey = bucket.map(atom => atom.candidateId).sort().join(\"|\");\n\n    if (groupedCandidateKeys.has(groupKey)) continue;\n    groupedCandidateKeys.add(groupKey);\n\n    const group = Object.create(null);\n    group.groupId = \"conflict_\" + groupCounter;\n    group.normalizedValueKey = normalizedValueKey;\n    group.displayValue = stableValueForKey(bucket[0].value);\n    group.candidates = bucket.map(atom => {\n      const candidate = Object.create(null);\n      candidate.candidateId = atom.candidateId;\n      candidate.field = atom.field;\n      candidate.type = atom.type;\n      candidate.value = atom.value;\n      candidate.sourceResolver = atom.sourceResolver;\n      candidate.message = atom.message;\n      return candidate;\n    });\n\n    groups.push(group);\n    groupCounter++;\n  }\n\n  const singletonFields = new Set([\n    \"description\",\n    \"expenseDate\",\n    \"exchangeRate\",\n    \"merchantName\",\n    \"receiptAmount\",\n    \"receiptCurrency\",\n    \"expenseSource\",\n    \"expenseType\",\n    \"flightClass\",\n    \"flightType\",\n    \"personalReceiptAmount\",\n    \"destinationFrom\",\n    \"destinationTo\",\n    \"passengerName\",\n    \"ticketNumber\",\n    \"flightDuration\",\n    \"agencyName\"\n  ]);\n\n  const singletonBuckets = new Map();\n\n  for (const atom of atoms) {\n    if (!atom.conflictEligible || !singletonFields.has(atom.field)) continue;\n\n    if (!singletonBuckets.has(atom.field)) {\n      singletonBuckets.set(atom.field, []);\n    }\n\n    singletonBuckets.get(atom.field).push(atom);\n  }\n\n  for (const [field, bucket] of singletonBuckets) {\n    const valueKeys = new Set(bucket.map(atom => atom.normalizedValueKey).filter(Boolean));\n\n    if (valueKeys.size <= 1) continue;\n\n    const groupKey = bucket.map(atom => atom.candidateId).sort().join(\"|\");\n\n    if (groupedCandidateKeys.has(groupKey)) continue;\n    groupedCandidateKeys.add(groupKey);\n\n    const group = Object.create(null);\n    group.groupId = \"conflict_\" + groupCounter;\n    group.normalizedValueKey = \"singleton:\" + field;\n    group.displayValue = field + \" has multiple values\";\n    group.conflictKind = \"singleFieldMultipleValues\";\n    group.candidates = bucket.map(atom => {\n      const candidate = Object.create(null);\n      candidate.candidateId = atom.candidateId;\n      candidate.field = atom.field;\n      candidate.type = atom.type;\n      candidate.value = atom.value;\n      candidate.sourceResolver = atom.sourceResolver;\n      candidate.message = atom.message;\n      return candidate;\n    });\n\n    groups.push(group);\n    groupCounter++;\n  }\n\n  return groups;\n};\n\nconst atomsToInstructions = atoms => {\n  const grouped = [];\n  const byKey = new Map();\n\n  for (const atom of atoms) {\n    if (!byKey.has(atom.groupingKey)) {\n      const item = Object.create(null);\n      item.message = atom.message || \"\";\n      item.type = atom.type || \"\";\n      item.field = atom.field || \"\";\n      item.value = [];\n      item.reasoning = atom.reasoning || \"\";\n\n      byKey.set(atom.groupingKey, item);\n      grouped.push(item);\n    }\n\n    const item = byKey.get(atom.groupingKey);\n    const values = Array.isArray(item.value) ? item.value : [item.value];\n\n    if (!values.some(existing => valueEqualsForDedupe(existing, atom.value))) {\n      values.push(atom.value);\n    }\n\n    item.value = values;\n  }\n\n  return grouped.map(item => {\n    const values = Array.isArray(item.value)\n      ? item.value.filter(value => !isEmptyValue(value))\n      : [];\n\n    const finalItem = Object.create(null);\n    finalItem.message = item.message || \"\";\n    finalItem.field = item.field || \"\";\n    finalItem.reasoning = item.reasoning || \"\";\n\n    if (item.type === \"delegation\") {\n      finalItem.type = \"delegation\";\n      finalItem.value = \"\";\n    } else if (item.type === \"irrelevant\") {\n      finalItem.type = \"irrelevant\";\n      finalItem.value = values.length === 0 ? item.message || \"\" : values[0];\n    } else if (item.type === \"rec_resolved\") {\n      finalItem.type = \"rec_resolved\";\n      finalItem.value = values.length <= 1 ? (values.length === 0 ? \"\" : values[0]) : values;\n    } else if (alwaysArrayFields.has(item.field)) {\n      if (isSingleCustomerNoneValue(item.field, values)) {\n        finalItem.value = \"None\";\n        finalItem.type = \"resolved\";\n      } else {\n        finalItem.value = values;\n        finalItem.type = item.type || \"\";\n      }\n    } else if (values.length <= 1) {\n      finalItem.value = values.length === 0 ? \"\" : values[0];\n      finalItem.type = isSingleCustomerNoneValue(item.field, finalItem.value)\n        ? \"resolved\"\n        : item.type || \"\";\n    } else {\n      finalItem.value = values;\n      finalItem.type = isSingleCustomerNoneValue(item.field, finalItem.value)\n        ? \"resolved\"\n        : item.type || \"\";\n    }\n\n    return finalItem;\n  }).filter(item => {\n    if (item.type === \"delegation\" || item.type === \"irrelevant\") return true;\n    return !isEmptyValue(item.value);\n  });\n};\n\nconst conflictGroups = buildConflictGroups(candidateAtoms);\ndecomposedInstructions = atomsToInstructions(candidateAtoms);\n\n\nconst finalResult = Object.create(null);\nfinalResult.DecomposedInstructions = decomposedInstructions;\nfinalResult.candidateAtoms = candidateAtoms;\nfinalResult.conflictGroups = conflictGroups;\n\nreturn finalResult;"
          },
