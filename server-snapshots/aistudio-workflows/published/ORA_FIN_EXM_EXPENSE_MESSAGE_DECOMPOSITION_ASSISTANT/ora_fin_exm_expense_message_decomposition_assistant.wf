          "code": "GET_RECOMMENDATION_OPTION_SELECTOR",
          "id": "1778998251047",
          "inputs": [
            {
              "id": "1778998251048_1",
              "name": "prompt",
              "type": "string",
              "value": "let recommendationClausesVar = {{$context.$triggers.REST.$input.userMessage}}\nlet projectedOptionsVar = {{$context.$nodes.PROJECT_RECOMMENDATION_OPTIONS.$output.result.projectedOptions}}\n\n\n{{$context.$nodes.RECOMMENDATION_OPTION_SELECTOR.$output.result.expensePrompt}}"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Hydrate Recommendation Selections",
            "returnType": "object",
            "sourceCode": "var llmOutput = $context.$nodes.GET_RECOMMENDATION_OPTION_SELECTOR.$output || {};\nvar parsedOutput = llmOutput;\n\nif (parsedOutput.result) {\n  parsedOutput = parsedOutput.result;\n}\n\nif (parsedOutput.output) {\n  parsedOutput = parsedOutput.output;\n}\n\nif (typeof parsedOutput === \"string\") {\n  var cleanedOutput = parsedOutput.trim();\n  cleanedOutput = cleanedOutput.replace(/^```json\\s*/i, \"\");\n  cleanedOutput = cleanedOutput.replace(/^```\\s*/i, \"\");\n  cleanedOutput = cleanedOutput.replace(/```$/i, \"\");\n  cleanedOutput = cleanedOutput.replace(/^json\\s*/i, \"\");\n  cleanedOutput = cleanedOutput.trim();\n\n  try {\n    parsedOutput = JSON.parse(cleanedOutput);\n  } catch (e) {\n    parsedOutput = {};\n  }\n}\n\nif (parsedOutput.result) {\n  parsedOutput = parsedOutput.result;\n}\n\nvar selectedItems = [];\n\nif (parsedOutput.recommendedOptionSelections && parsedOutput.recommendedOptionSelections.length >= 0) {\n  selectedItems = parsedOutput.recommendedOptionSelections;\n}\n\nvar optionsVar = $context.$variables.options || {};\nvar optionItems = [];\n\nif (optionsVar.options && optionsVar.options.items && optionsVar.options.items.length >= 0) {\n  optionItems = optionsVar.options.items;\n} else if (optionsVar.items && optionsVar.items.length >= 0) {\n  optionItems = optionsVar.items;\n}\n\nvar hydratedSelections = [];\n\nfor (var i = 0; i < selectedItems.length; i++) {\n  var selected = selectedItems[i] || {};\n  var matchedOption = null;\n  var selectedKey = selected.selectedOptionKey || selected.optionKey || \"\";\n\n  if (selectedKey && selectedKey.indexOf(\"opt_\") === 0) {\n    var optionIndex = Number(selectedKey.substring(4));\n\n    if (optionIndex >= 0 && optionIndex < optionItems.length) {\n      matchedOption = optionItems[optionIndex];\n    }\n  }\n\n  if (!matchedOption && selected.selectedOptionIndex !== undefined && selected.selectedOptionIndex !== null && selected.selectedOptionIndex !== \"\") {\n    var selectedIndex = Number(selected.selectedOptionIndex);\n\n    if (selectedIndex >= 0 && selectedIndex < optionItems.length) {\n      matchedOption = optionItems[selectedIndex];\n    }\n  }\n\n  if (!matchedOption && selected.selectedOptionId) {\n    for (var j = 0; j < optionItems.length; j++) {\n      var candidate = optionItems[j] || {};\n\n      if (String(candidate.id || \"\") === String(selected.selectedOptionId)) {\n        matchedOption = candidate;\n        break;\n      }\n    }\n  }\n\n  var rawFieldType = \"\";\n  var rawFieldValue = \"\";\n\n  if (matchedOption) {\n    rawFieldType = matchedOption.fieldName || \"\";\n    rawFieldValue = matchedOption.fieldValue;\n  } else if (selected.fieldType || selected.fieldValue) {\n    rawFieldType = selected.fieldType || \"\";\n    rawFieldValue = selected.fieldValue;\n  }\n\n  var fieldValueIsEmpty = rawFieldValue === null || rawFieldValue === undefined || String(rawFieldValue).trim() === \"\";\n\n  if (rawFieldType && !fieldValueIsEmpty) {\n    var normalizedFieldType = rawFieldType;\n    var lowerFieldType = String(rawFieldType).toLowerCase();\n\n    if (lowerFieldType.indexOf(\"attendee\") >= 0) {\n      normalizedFieldType = \"Attendees\";\n    } else if (lowerFieldType.indexOf(\"spend\") >= 0 || lowerFieldType.indexOf(\"authorization\") >= 0 || lowerFieldType.indexOf(\"preapproval\") >= 0) {\n      normalizedFieldType = \"spendAuthorizationLine\";\n    } else if (lowerFieldType === \"accounts\" || lowerFieldType === \"account\" || lowerFieldType.indexOf(\"account\") >= 0) {\n      normalizedFieldType = \"Accounts\";\n    } else if (lowerFieldType.indexOf(\"cost\") >= 0) {\n      normalizedFieldType = \"Cost Center\";\n    } else if (lowerFieldType.indexOf(\"company\") >= 0 || lowerFieldType.indexOf(\"companies\") >= 0) {\n      normalizedFieldType = \"Company\";\n    } else if (lowerFieldType.indexOf(\"project\") >= 0 || lowerFieldType.indexOf(\"task\") >= 0) {\n      normalizedFieldType = \"Project\";\n    }\n\n    var parsedFieldValue = rawFieldValue;\n\n    if (typeof rawFieldValue === \"string\") {\n      var cleanedFieldValue = rawFieldValue.trim();\n      cleanedFieldValue = cleanedFieldValue.replace(/^```json\\s*/i, \"\");\n      cleanedFieldValue = cleanedFieldValue.replace(/^```\\s*/i, \"\");\n      cleanedFieldValue = cleanedFieldValue.replace(/```$/i, \"\");\n      cleanedFieldValue = cleanedFieldValue.replace(/^json\\s*/i, \"\");\n      cleanedFieldValue = cleanedFieldValue.trim();\n\n      try {\n        parsedFieldValue = JSON.parse(cleanedFieldValue);\n      } catch (e) {\n        parsedFieldValue = rawFieldValue;\n      }\n    }\n\n    var hydrated = {};\n    hydrated.sentence = selected.sentence || \"\";\n    hydrated.predictionString = selected.predictionString || \"\";\n    hydrated.fieldValue = parsedFieldValue;\n    hydrated.fieldType = normalizedFieldType;\n    hydrated.reasoning = selected.reasoning || \"Resolved via recommended option selection (\" + (selected.predictionString || selectedKey || \"\") + \")\";\n\n    hydratedSelections[hydratedSelections.length] = hydrated;\n  }\n}\n\nreturn { recommendedOptionSelections: hydratedSelections };"
          },
