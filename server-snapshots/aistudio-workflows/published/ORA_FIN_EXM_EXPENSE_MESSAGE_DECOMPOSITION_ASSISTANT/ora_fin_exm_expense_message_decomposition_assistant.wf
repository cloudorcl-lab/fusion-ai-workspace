          "code": "FIELD_CONFLICT_RESOLUTION",
          "id": "1778999217795",
          "inputs": [
            {
              "id": "1778999217797_1",
              "name": "prompt",
              "type": "string",
              "value": "USER_MESSAGE:\n{{$context.$triggers.REST.$input.userMessage}}\n\nCONFLICT_GROUPS_JSON:\n{{$context.$nodes.CONSOLIDATOR.$output.result.conflictGroups}}\n\n{{$context.$nodes.FIELD_CONFLICT_RESOLUTION_PROMPT.$output.result.expensePrompt}}"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Apply Field Conflict Evaluation",
            "returnType": "object",
            "sourceCode": "const cleanJsonString = value => {\n  if (typeof value !== \"string\") return value;\n\n  return value\n    .trim()\n    .replace(/^```json\\s*/i, \"\")\n    .replace(/^```\\s*/i, \"\")\n    .replace(/```$/i, \"\")\n    .replace(/^json\\s*/i, \"\")\n    .trim();\n};\n\nconst safeParse = value => {\n  if (value === null || value === undefined) return null;\n  if (typeof value === \"object\") return value;\n  if (typeof value !== \"string\") return null;\n\n  try {\n    return JSON.parse(cleanJsonString(value));\n  } catch (e) {\n    return null;\n  }\n};\n\nconst unwrapOutput = value => {\n  let parsed = safeParse(value);\n\n  if (parsed === null || parsed === undefined) {\n    parsed = value;\n  }\n\n  if (parsed && typeof parsed === \"object\" && parsed.output !== undefined) {\n    const parsedOutput = safeParse(parsed.output);\n    parsed = parsedOutput === null || parsedOutput === undefined ? parsed.output : parsedOutput;\n  }\n\n  while (\n    parsed &&\n    typeof parsed === \"object\" &&\n    !Array.isArray(parsed) &&\n    parsed.result &&\n    typeof parsed.result === \"object\"\n  ) {\n    parsed = parsed.result;\n  }\n\n  return parsed;\n};\n\nconst alwaysArrayFields = new Set([\n  \"Attendees\",\n  \"NonEmployeeAttendees\",\n  \"AmbiguousAttendees\",\n  \"Project\",\n  \"Task\",\n  \"Company\",\n  \"Cost Center\",\n  \"customer\"\n]);\n\nconst stableValueForKey = value => {\n  if (value === null || value === undefined) return \"\";\n\n  if (typeof value === \"object\") {\n    try {\n      return JSON.stringify(value);\n    } catch (e) {\n      return String(value);\n    }\n  }\n\n  return String(value);\n};\n\nconst normalizeValue = value => {\n  return stableValueForKey(value)\n    .trim()\n    .toLowerCase()\n    .replace(/[^a-z0-9]+/g, \"\")\n    .trim();\n};\n\nconst isEmptyValue = value => {\n  if (value === null || value === undefined) return true;\n  if (typeof value === \"string\" && value.trim() === \"\") return true;\n  if (Array.isArray(value) && value.length === 0) return true;\n  return false;\n};\n\nconst valueEqualsForDedupe = (a, b) => {\n  const aKey = normalizeValue(a);\n  const bKey = normalizeValue(b);\n\n  if (aKey || bKey) return aKey === bKey;\n\n  return stableValueForKey(a) === stableValueForKey(b);\n};\n\nconst atomsToInstructions = atoms => {\n  const grouped = [];\n  const byKey = new Map();\n\n  for (const atom of atoms || []) {\n    if (!atom || !atom.groupingKey) continue;\n\n    if (!byKey.has(atom.groupingKey)) {\n      const item = Object.create(null);\n      item.message = atom.message || \"\";\n      item.type = atom.type || \"\";\n      item.field = atom.field || \"\";\n      item.value = [];\n      item.reasoning = atom.reasoning || \"\";\n      byKey.set(atom.groupingKey, item);\n      grouped.push(item);\n    }\n\n    const item = byKey.get(atom.groupingKey);\n    const values = Array.isArray(item.value) ? item.value : [item.value];\n\n    if (!values.some(existing => valueEqualsForDedupe(existing, atom.value))) {\n      values.push(atom.value);\n    }\n\n    item.value = values;\n  }\n\n  return grouped.map(item => {\n    const values = Array.isArray(item.value) ? item.value.filter(value => !isEmptyValue(value)) : [];\n    const finalItem = Object.create(null);\n    finalItem.message = item.message || \"\";\n    finalItem.type = item.type || \"\";\n    finalItem.field = item.field || \"\";\n    finalItem.reasoning = item.reasoning || \"\";\n\n    if (item.type === \"delegation\") {\n      finalItem.value = \"\";\n    } else if (item.type === \"irrelevant\") {\n      finalItem.value = values.length === 0 ? item.message || \"\" : values[0];\n    } else if (item.type === \"rec_resolved\") {\n      finalItem.value = values.length <= 1 ? (values.length === 0 ? \"\" : values[0]) : values;\n    } else if (alwaysArrayFields.has(item.field)) {\n      finalItem.value = values;\n    } else if (values.length <= 1) {\n      finalItem.value = values.length === 0 ? \"\" : values[0];\n    } else {\n      finalItem.value = values;\n    }\n\n    return finalItem;\n  }).filter(item => {\n    if (item.type === \"delegation\" || item.type === \"irrelevant\") return true;\n    return !isEmptyValue(item.value);\n  });\n};\n\n\nconst isEmptyScalar = value => {\n  if (value === null || value === undefined) return true;\n  if (typeof value === \"string\" && value.trim() === \"\") return true;\n  return false;\n};\n\nconst isEmptyInstructionValue = value => {\n  if (Array.isArray(value)) {\n    return value.filter(item => !isEmptyScalar(item)).length === 0;\n  }\n\n  return isEmptyScalar(value);\n};\n\nconst cleanInstructionValue = value => {\n  if (!Array.isArray(value)) return value;\n  return value.filter(item => !isEmptyScalar(item));\n};\n\nconst hasText = value => value !== null && value !== undefined && String(value).trim() !== \"\";\n\nconst makeIrrelevantInstruction = () => {\n  const item = Object.create(null);\n  item.message = userMessageText;\n  item.type = \"irrelevant\";\n  item.field = \"\";\n  item.value = userMessageText;\n  item.reasoning = \"No valid field value was provided\";\n  return item;\n};\n\nconst cleanupDecomposedInstructions = instructions => {\n  const cleaned = [];\n\n  for (const instruction of instructions || []) {\n    if (!instruction) continue;\n\n    if (instruction.type === \"delegation\") {\n      cleaned.push(instruction);\n      continue;\n    }\n\n    if (instruction.type === \"irrelevant\") {\n      if (hasText(instruction.message) || !isEmptyInstructionValue(instruction.value)) {\n        cleaned.push(instruction);\n      }\n      continue;\n    }\n\n    if (!hasText(instruction.field)) continue;\n\n    const value = cleanInstructionValue(instruction.value);\n    if (isEmptyInstructionValue(value)) continue;\n\n    const cleanedInstruction = Object.assign(Object.create(null), instruction);\n    cleanedInstruction.value = value;\n    cleaned.push(cleanedInstruction);\n  }\n\n  if (cleaned.length === 0 && hasText(userMessageText)) {\n    cleaned.push(makeIrrelevantInstruction());\n  }\n\n  return cleaned;\n};\n\nconst userMessageText = String($context.$triggers?.REST?.$input?.userMessage || \"\");\n\nconst consolidation = unwrapOutput($context.$nodes.CONSOLIDATOR?.$output) || {};\nconst atoms = Array.isArray(consolidation.candidateAtoms) ? consolidation.candidateAtoms : [];\nconst conflictGroups = Array.isArray(consolidation.conflictGroups) ? consolidation.conflictGroups : [];\n\nif (atoms.length === 0) {\n  const fallback = Object.create(null);\n  const instructions = Array.isArray(consolidation.DecomposedInstructions)\n    ? consolidation.DecomposedInstructions\n    : [];\n  fallback.DecomposedInstructions = cleanupDecomposedInstructions(instructions);\n  return fallback;\n}\n\nconst evaluatorOutput = unwrapOutput($context.$nodes.FIELD_CONFLICT_RESOLUTION?.$output) || {};\nconst decisions = Array.isArray(evaluatorOutput.decisions) ? evaluatorOutput.decisions : [];\nconst groupsById = new Map(conflictGroups.map(group => [group.groupId, group]));\nconst validKeepIdsByGroup = new Map();\n\nfor (const decision of decisions) {\n  if (!decision || !groupsById.has(decision.groupId)) continue;\n  if (!Array.isArray(decision.keepCandidateIds) || decision.keepCandidateIds.length === 0) continue;\n\n  const group = groupsById.get(decision.groupId);\n  const validIds = new Set((group.candidates || []).map(candidate => candidate.candidateId));\n  const requestedKeepIds = decision.keepCandidateIds.map(String);\n  const allRequestedIdsAreValid = requestedKeepIds.every(id => validIds.has(id));\n\n  if (!allRequestedIdsAreValid) continue;\n\n  validKeepIdsByGroup.set(decision.groupId, new Set(requestedKeepIds));\n}\n\nconst rejectedCandidateIds = new Set();\n\nfor (const group of conflictGroups) {\n  if (!validKeepIdsByGroup.has(group.groupId)) continue;\n\n  const keepIds = validKeepIdsByGroup.get(group.groupId);\n\n  for (const candidate of group.candidates || []) {\n    if (!keepIds.has(candidate.candidateId)) {\n      rejectedCandidateIds.add(candidate.candidateId);\n    }\n  }\n}\n\nconst hasIndependentCurrencyCue = /\\b(?:currency|receipt\\s+currency)\\b/i.test(userMessageText);\nconst rejectedReceiptAmountMessages = new Set();\n\nfor (const atom of atoms) {\n  if (atom && atom.field === \"receiptAmount\" && rejectedCandidateIds.has(atom.candidateId)) {\n    rejectedReceiptAmountMessages.add(atom.message || \"\");\n  }\n}\n\nif (!hasIndependentCurrencyCue && rejectedReceiptAmountMessages.size > 0) {\n  for (const atom of atoms) {\n    if (atom && atom.field === \"receiptCurrency\" && rejectedReceiptAmountMessages.has(atom.message || \"\")) {\n      rejectedCandidateIds.add(atom.candidateId);\n    }\n  }\n}\n\nconst finalAtoms = atoms.filter(atom => !rejectedCandidateIds.has(atom.candidateId));\nconst result = Object.create(null);\nresult.DecomposedInstructions = cleanupDecomposedInstructions(atomsToInstructions(finalAtoms));\nreturn result;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "APPLY_FIELD_CONFLICT_EVALUATION",
          "id": "1778999396567",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Finalize Consolidation",
            "returnType": "object",
            "sourceCode": "const userMessageText = String($context.$triggers?.REST?.$input?.userMessage || \"\");\n\nconst isEmptyScalar = value => {\n  if (value === null || value === undefined) return true;\n  if (typeof value === \"string\" && value.trim() === \"\") return true;\n  return false;\n};\n\nconst isEmptyInstructionValue = value => {\n  if (Array.isArray(value)) {\n    return value.filter(item => !isEmptyScalar(item)).length === 0;\n  }\n\n  return isEmptyScalar(value);\n};\n\nconst cleanInstructionValue = value => {\n  if (!Array.isArray(value)) return value;\n  return value.filter(item => !isEmptyScalar(item));\n};\n\nconst hasText = value => value !== null && value !== undefined && String(value).trim() !== \"\";\n\nconst makeIrrelevantInstruction = () => {\n  const item = Object.create(null);\n  item.message = userMessageText;\n  item.type = \"irrelevant\";\n  item.field = \"\";\n  item.value = userMessageText;\n  item.reasoning = \"No valid field value was provided\";\n  return item;\n};\n\nconst cleanupDecomposedInstructions = instructions => {\n  const cleaned = [];\n\n  for (const instruction of instructions || []) {\n    if (!instruction) continue;\n\n    if (instruction.type === \"delegation\") {\n      cleaned.push(instruction);\n      continue;\n    }\n\n    if (instruction.type === \"irrelevant\") {\n      if (hasText(instruction.message) || !isEmptyInstructionValue(instruction.value)) {\n        cleaned.push(instruction);\n      }\n      continue;\n    }\n\n    if (!hasText(instruction.field)) continue;\n\n    const value = cleanInstructionValue(instruction.value);\n    if (isEmptyInstructionValue(value)) continue;\n\n    const cleanedInstruction = Object.assign(Object.create(null), instruction);\n    cleanedInstruction.value = value;\n    cleaned.push(cleanedInstruction);\n  }\n\n  if (cleaned.length === 0 && hasText(userMessageText)) {\n    cleaned.push(makeIrrelevantInstruction());\n  }\n\n  return cleaned;\n};\n\nconst raw = $context.$nodes.CONSOLIDATOR?.$output || {};\nconst source = raw.result && typeof raw.result === \"object\" ? raw.result : raw;\nconst result = Object.create(null);\nconst instructions = Array.isArray(source.DecomposedInstructions)\n  ? source.DecomposedInstructions\n  : [];\nresult.DecomposedInstructions = cleanupDecomposedInstructions(instructions);\nreturn result;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "FINALIZE_CONSOLIDATION",
          "id": "1778999469921",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
