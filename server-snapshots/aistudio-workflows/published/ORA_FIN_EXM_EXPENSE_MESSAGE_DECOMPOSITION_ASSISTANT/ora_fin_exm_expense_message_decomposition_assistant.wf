            {
              "id": "1778998040320_1",
              "name": "condition",
              "type": "string",
              "value": "{{($context.$triggers.REST.$input.isReplyFlow === true || $context.$triggers.REST.$input.isReplyFlow === \"true\") && (($context.$variables.options && $context.$variables.options.options && $context.$variables.options.options.items && $context.$variables.options.options.items.length > 0) || ($context.$variables.options && $context.$variables.options.items && $context.$variables.options.items.length > 0))}}"
            }
