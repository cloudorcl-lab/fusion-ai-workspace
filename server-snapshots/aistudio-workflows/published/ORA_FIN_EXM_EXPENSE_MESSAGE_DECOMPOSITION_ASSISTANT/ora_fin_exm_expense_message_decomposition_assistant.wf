          "code": "FETCHMESSAGEPAYLOAD",
          "id": "1769751660092",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "decodeMessage",
            "returnType": "object",
            "sourceCode": "const items = $context.$nodes.GETPREVIOUSCONVERSATIONHISTORY.$output.items;\nconst partnerExpenseMessage = Array.isArray(items) ? items[0] : null;\n\nif (!partnerExpenseMessage || !partnerExpenseMessage.systemInformation) {\n  return \"\";\n}\n\nconst summary = JSON.parse(atob(partnerExpenseMessage.systemInformation));\nconst { emailSummary, userInstruction, systemSummary } = summary;\n\nreturn { emailSummary, userInstruction, systemSummary };"
          },
          "outcomes": {
            "success": "1769239809813"
          },
