          "code": "RETURN_EMPTY_RECOMMENDATION_SELECTIONS",
          "id": "1778998560219",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Prepare Decomposition Message",
            "returnType": "object",
            "sourceCode": "const originalMessage = String($context.$triggers.REST?.$input?.userMessage || $context.$triggers.REST?.$input?.inputMessage || \"\");\n\nconst cleanJsonString = value => {\n  if (typeof value !== \"string\") return value;\n\n  return value\n    .trim()\n    .replace(/^```json\\s*/i, \"\")\n    .replace(/^```\\s*/i, \"\")\n    .replace(/```$/i, \"\")\n    .replace(/^json\\s*/i, \"\")\n    .trim();\n};\n\nconst safeParse = value => {\n  if (value === null || value === undefined) return null;\n  if (typeof value === \"object\") return value;\n  if (typeof value !== \"string\") return null;\n\n  try {\n    return JSON.parse(cleanJsonString(value));\n  } catch (e) {\n    return null;\n  }\n};\n\nconst unwrapOutput = value => {\n  let parsed = safeParse(value);\n\n  if (parsed === null || parsed === undefined) {\n    parsed = value;\n  }\n\n  if (parsed && typeof parsed === \"object\" && parsed.output !== undefined) {\n    const parsedOutput = safeParse(parsed.output);\n    parsed = parsedOutput === null || parsedOutput === undefined ? parsed.output : parsedOutput;\n  }\n\n  while (parsed && typeof parsed === \"object\" && !Array.isArray(parsed) && parsed.result && typeof parsed.result === \"object\") {\n    parsed = parsed.result;\n  }\n\n  return parsed && typeof parsed === \"object\" ? parsed : {};\n};\n\nconst selectorOutput = unwrapOutput($context.$nodes.GET_RECOMMENDATION_OPTION_SELECTOR?.$output);\nconst hydratedOutput = unwrapOutput($context.$nodes.HYDRATE_RECOMMENDATION_SELECTIONS?.$output);\nconst emptyOutput = unwrapOutput($context.$nodes.RETURN_EMPTY_RECOMMENDATION_SELECTIONS?.$output);\n\nconst hydratedSelections = Array.isArray(hydratedOutput.recommendedOptionSelections)\n  ? hydratedOutput.recommendedOptionSelections\n  : [];\nconst emptySelections = Array.isArray(emptyOutput.recommendedOptionSelections)\n  ? emptyOutput.recommendedOptionSelections\n  : [];\n\nlet decompositionUserMessage = originalMessage;\n\nif (hydratedSelections.length > 0) {\n  decompositionUserMessage = typeof selectorOutput.additionalMessage === \"string\"\n    ? selectorOutput.additionalMessage.trim()\n    : \"\";\n} else if (emptySelections.length > 0) {\n  decompositionUserMessage = originalMessage;\n}\n\nconst result = {\n  decompositionUserMessage: decompositionUserMessage,\n  recommendationSelectionsCount: hydratedSelections.length\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1777541834990"
          },
          "code": "PREPARE_DECOMPOSITION_MESSAGE",
          "id": "1779216033671",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Additional Processing Attendees",
            "returnType": "array",
            "sourceCode": "const cleanJsonString = value => {\n  if (typeof value !== \"string\") return value;\n\n  return value\n    .trim()\n    .replace(/^```json\\s*/i, \"\")\n    .replace(/^```\\s*/i, \"\")\n    .replace(/```$/i, \"\")\n    .replace(/^json\\s*/i, \"\")\n    .trim();\n};\n\nconst safeParse = value => {\n  if (value === null || value === undefined) return null;\n  if (typeof value === \"object\") return value;\n  if (typeof value !== \"string\") return null;\n\n  try {\n    return JSON.parse(cleanJsonString(value));\n  } catch (e) {\n    return null;\n  }\n};\n\nconst unwrapOutput = value => {\n  let parsed = value;\n\n  for (let i = 0; i < 10; i++) {\n    const parsedString = safeParse(parsed);\n\n    if (parsedString !== null && parsedString !== parsed) {\n      parsed = parsedString;\n      continue;\n    }\n\n    if (parsed && typeof parsed === \"object\" && !Array.isArray(parsed)) {\n      if (parsed.result !== undefined) {\n        parsed = parsed.result;\n        continue;\n      }\n\n      if (parsed.output !== undefined) {\n        parsed = parsed.output;\n        continue;\n      }\n    }\n\n    break;\n  }\n\n  return parsed;\n};\n\nlet resolvedAttendees = unwrapOutput($context.$nodes.ATTENDEES_RESOLUTION.$output);\n\nconst isSimplifiedExpense = $context.$triggers.REST.$input.isSimplifiedExpense;\nconst simplified =\n  isSimplifiedExpense === true ||\n  String(isSimplifiedExpense).toLowerCase() === \"true\";\n\nif (!resolvedAttendees || typeof resolvedAttendees !== \"object\" || Array.isArray(resolvedAttendees)) {\n  return resolvedAttendees;\n}\n\nlet output = Object.assign({}, resolvedAttendees);\n\nif (simplified) {\n  output.employeeAttendees = [];\n  output.attendees = [];\n  output.nonEmployeeAttendees = [];\n  output.nonEmployeeAttendee = [];\n  output.ambiguousAttendees = [];\n  output.ambigousAttendees = [];\n} else {\n  output.organizations = [];\n  output.organization = [];\n  output.customer = [];\n}\n\nreturn output;"
          },
          "outcomes": {
            "success": "1777539951197"
          },
          "code": "ADDITIONAL_PROCESSING_ATTENDEES",
          "id": "1780509159519",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Additional Processing Expense Fields",
            "returnType": "array",
            "sourceCode": "let expenseErrors = $context.$nodes.GET_EXPENSE_ERRORS?.$output;\nlet decomposedExpenseFields = $context.$nodes.EXPENSE_FIELDS_AND_ACTIONS_RESOLUTION?.$output;\nlet isJustificationPresent = $context.$nodes.IS_JUSTIFICATION_PRESENT?.$output;\n\nif (\n  expenseErrors === null ||\n  expenseErrors === undefined ||\n  decomposedExpenseFields === null ||\n  decomposedExpenseFields === undefined ||\n  isJustificationPresent === null ||\n  isJustificationPresent === undefined\n) {\n  return decomposedExpenseFields;\n}\n\nconst normalizeBoolean = value => {\n  if (value === true || value === false) return value;\n  if (value?.result === true || value?.result === false) return value.result;\n  if (value?.output === true || value?.output === false) return value.output;\n  return String(value || \"\").trim().toLowerCase() === \"true\";\n};\n\nif (!normalizeBoolean(isJustificationPresent)) {\n  return decomposedExpenseFields;\n}\n\nconst justificationFieldByErrorStringCode = {\n  EXM_SQ_V_RCPT_JSTF: \"receiptMissingJustification\",\n  EXM_SQ_V_CNVRSN_JSTF: \"exchangeRateJustification\",\n  EXM_SQ_V_CCV_JSTF: \"corpCardJustification\",\n  EXM_SQ_V_RL_INST_JSTF: \"rateLimitViolationJustification\",\n  EXM_SQ_V_RL_DAILY_JSTF: \"rateLimitViolationJustification\",\n  EXM_SQ_V_RL_MONTHLY_JSTF: \"rateLimitViolationJustification\",\n  EXM_SQ_V_FLT_CLASS_JSTF:\"flightClassJustification\",\n  \"FND:::FND_CMN_CMPLT_FLDS\": \"justification\",\n  \"EXM:::EXM_ERECP_CC_JUSTIFY\": \"justification\"\n};\n\nconst justificationFields = new Set([\n  \"receiptmissingjustification\",\n  \"exchangeratejustification\",\n  \"corpcardjustification\",\n  \"ratelimitviolationjustification\",\n  \"flightclassjustification\",\n  \"justification\"\n]);\n\nconst normalizeFieldName = value => String(value || \"\").trim().toLowerCase();\nconst normalizeErrorCode = value => String(value ?? \"\").trim();\n\nconst expenseErrorItems = Array.isArray(expenseErrors)\n  ? expenseErrors\n  : Array.isArray(expenseErrors?.items)\n    ? expenseErrors.items\n    : [];\n\nif (expenseErrorItems.length === 0) {\n  return decomposedExpenseFields;\n}\n\nlet requiredJustificationField = \"\";\n\nfor (const error of expenseErrorItems) {\n  if (!error || typeof error !== \"object\") continue;\n\n  const lookupErrorCode =\n    normalizeErrorCode(error.errorStringCode) ||\n    normalizeErrorCode(error.errorCode);\n\n  const mappedField = justificationFieldByErrorStringCode[lookupErrorCode];\n\n  if (mappedField) {\n    requiredJustificationField = mappedField;\n    break;\n  }\n}\n\nif (!requiredJustificationField) {\n  return decomposedExpenseFields;\n}\n\nconst remapPlainObjectJustificationKey = objectValue => {\n  if (!objectValue || typeof objectValue !== \"object\" || Array.isArray(objectValue)) {\n    return false;\n  }\n\n  for (const key of Object.keys(objectValue)) {\n    if (!justificationFields.has(normalizeFieldName(key))) continue;\n\n    if (key !== requiredJustificationField) {\n      objectValue[requiredJustificationField] = objectValue[key];\n      delete objectValue[key];\n    }\n\n    return true;\n  }\n\n  return false;\n};\n\nconst remapArrayFieldNames = fields => {\n  let remapped = false;\n\n  for (const field of fields) {\n    if (!field || typeof field !== \"object\") continue;\n\n    const currentFieldName =\n      field.fieldName ||\n      field.name ||\n      field.attributeName ||\n      field.field ||\n      \"\";\n\n    if (!justificationFields.has(normalizeFieldName(currentFieldName))) continue;\n\n    if (\"fieldName\" in field) {\n      field.fieldName = requiredJustificationField;\n    } else if (\"name\" in field) {\n      field.name = requiredJustificationField;\n    } else if (\"attributeName\" in field) {\n      field.attributeName = requiredJustificationField;\n    } else if (\"field\" in field) {\n      field.field = requiredJustificationField;\n    } else {\n      field.fieldName = requiredJustificationField;\n    }\n\n    remapped = true;\n  }\n\n  return remapped;\n};\n\nif (remapPlainObjectJustificationKey(decomposedExpenseFields)) {\n  return decomposedExpenseFields;\n}\n\nconst decomposedFields = Array.isArray(decomposedExpenseFields)\n  ? decomposedExpenseFields\n  : Array.isArray(decomposedExpenseFields?.items)\n    ? decomposedExpenseFields.items\n    : Array.isArray(decomposedExpenseFields?.DecomposedInstructions)\n      ? decomposedExpenseFields.DecomposedInstructions\n      : [];\n\nif (decomposedFields.length === 0) {\n  return decomposedExpenseFields;\n}\n\nremapArrayFieldNames(decomposedFields);\n\nreturn decomposedExpenseFields;"
          },
          "outcomes": {
            "success": "1777539951197"
          },
          "code": "ADDITIONAL_PROCESSING_EXPENSE_FIELDS",
          "id": "1780509197892",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Is Any Justification Present",
            "returnType": "boolean",
            "sourceCode": "let decomposedExpenseFields = $context.$nodes.EXPENSE_FIELDS_AND_ACTIONS_RESOLUTION.$output;\n\nconst justificationFields = new Set([\n  \"receiptmissingjustification\",\n  \"exchangeratejustification\",\n  \"corpcardjustification\",\n  \"ratelimitviolationjustification\",\n  \"flightclassjustification\"\n]);\n\nconst cleanJsonString = value =>\n  String(value || \"\")\n    .trim()\n    .replace(/^```json\\s*/i, \"\")\n    .replace(/^```\\s*/i, \"\")\n    .replace(/```$/i, \"\")\n    .replace(/^json\\s*/i, \"\")\n    .trim();\n\nconst safeParse = value => {\n  if (value === null || value === undefined) return value;\n  if (typeof value === \"object\") return value;\n  if (typeof value !== \"string\") return value;\n\n  try {\n    return JSON.parse(cleanJsonString(value));\n  } catch (e) {\n    return value;\n  }\n};\n\nlet parsed = safeParse(decomposedExpenseFields);\n\nif (parsed?.result !== undefined) {\n  parsed = safeParse(parsed.result);\n}\n\nif (parsed?.output !== undefined) {\n  parsed = safeParse(parsed.output);\n}\n\nconst hasJustificationFieldName = fieldName => {\n  const normalized = String(fieldName || \"\").trim().toLowerCase();\n  return (\n    justificationFields.has(normalized) ||\n    normalized.includes(\"justification\")\n  );\n};\n\nlet hasJustificationField = false;\n\nif (Array.isArray(parsed)) {\n  hasJustificationField = parsed.some(field =>\n    hasJustificationFieldName(\n      field?.fieldName || field?.name || field?.attributeName || field?.field\n    )\n  );\n} else if (Array.isArray(parsed?.items)) {\n  hasJustificationField = parsed.items.some(field =>\n    hasJustificationFieldName(\n      field?.fieldName || field?.name || field?.attributeName || field?.field\n    )\n  );\n} else if (Array.isArray(parsed?.DecomposedInstructions)) {\n  hasJustificationField = parsed.DecomposedInstructions.some(field =>\n    hasJustificationFieldName(\n      field?.fieldName || field?.name || field?.attributeName || field?.field\n    )\n  );\n} else if (parsed && typeof parsed === \"object\") {\n  hasJustificationField = Object.keys(parsed).some(hasJustificationFieldName);\n}\n\nreturn hasJustificationField;"
          },
