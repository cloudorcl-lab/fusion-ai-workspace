        {
          "metadata": {
            "name": "Populate PPM OPM Pref Data",
            "returnType": "object",
            "sourceCode": "const allResulsArray = $context.$nodes.CHECK_PPM_OPM_PREF_FOR_PAYROLL_RELATIONSHIPS.$output;\n\nconst workflowRspPayload = $context.$variables.PreReqWorkflowRsp;\nconst payRelArray = [];\nconst payRelObjMap = new Map();\n\nif(allResulsArray && Array.isArray(allResulsArray)) {\n    allResulsArray.forEach(itemStr => {\n        const item = JSON.parse(itemStr);\n        const id = item.result.PayrollRelationshipId;\n        payRelObjMap.set(id, item.result);\n    });\n}\n\nif(workflowRspPayload && Array.isArray(workflowRspPayload.PayrollRelationships)) {\n    for(let payRel of workflowRspPayload.PayrollRelationships) {\n        payRel.HasPaymentMethods = payRelObjMap.get(payRel.PayrollRelationshipId).PaymentMethodCount > 0 ? true : false;\n        payRel.OrgPayMethods = payRelObjMap.get(payRel.PayrollRelationshipId).OrgPayMethods;\n        payRel.OpmDisplayFlag = payRelObjMap.get(payRel.PayrollRelationshipId).OpmDisplayFlag;\n        payRelArray.push(payRel);\n    }\n}\n\nworkflowRspPayload.PayrollRelationships = payRelArray;\n\nreturn workflowRspPayload;"
          },
