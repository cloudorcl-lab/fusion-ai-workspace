          "metadata": {
            "name": "Check Preference for Selected PayRel",
            "returnType": "boolean",
            "sourceCode": "const payRelId = $context.$variables.PayrollRelationshipId;\nconst preReqRsp = $context.$variables.PreReqWorkflowRsp;\nlet opmDisplayFlag = false;\n\nif(preReqRsp && Array.isArray(preReqRsp.PayrollRelationships)) {\n    for(const payRel of preReqRsp.PayrollRelationships) {\n        if(payRel.PayrollRelationshipId == payRelId) {\n            opmDisplayFlag = payRel.OpmDisplayFlag;\n            break;\n        }\n    }\n}\n\nreturn opmDisplayFlag;"
