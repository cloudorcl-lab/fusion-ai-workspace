        {
          "metadata": {
            "name": "Check Required Info for Creating Account",
            "returnType": "boolean",
            "sourceCode": "const useExistingBankBranch = $context.$variables.PreReqWorkflowRsp.UseExistingBankBranch;\nconst bankName = $context.$variables.BankName;\nconst branchName = $context.$variables.BranchName;\nconst accountNumber = $context.$variables.AccountNumber;\nconst accountType = $context.$variables.AccountType;\nconst routingNumber = $context.$variables.RoutingNumber;\n\nlet flag = true;\n\nif(typeof accountNumber == 'undefined' || accountNumber == null || accountNumber.length == 0 || accountNumber===\"NOT_FOUND\") {\n    flag = false;\n} else if(typeof accountType == 'undefined' || accountType == null || accountType.length == 0) {\n    flag = false;\n}\n\nif(useExistingBankBranch) {\n    if(typeof bankName == 'undefined' || bankName == null || bankName.length == 0) {\n        flag = false;\n    }\n    if(typeof branchName == 'undefined' || branchName == null || branchName.length == 0) {\n        flag = false;\n    }\n} else {\n    if(typeof routingNumber == 'undefined' || routingNumber == null || routingNumber.length == 0) {\n        flag = false;\n    }\n}\n\nreturn flag;"
          },
          "outcomes": {
            "success": "1769757198721"
          },
          "code": "CHECK_REQUIRED_INFO_FOR_CREATING_ACCOUNT",
          "id": "1771424119292",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get List of OPMs",
            "returnType": "array",
            "sourceCode": "const preReqRsp = $context.$variables.PreReqWorkflowRsp;\nconst selectedPayRelId = $context.$variables.PayrollRelationshipId;\nlet opmArray = [];\n\nfor(const payRel of preReqRsp.PayrollRelationships) {\n    if(payRel.PayrollRelationshipId == selectedPayRelId && Array.isArray(payRel.OrgPayMethods)) {\n        opmArray = payRel.OrgPayMethods;\n        break;\n    }\n}\n\nreturn opmArray;"
          },
          "outcomes": {
            "success": "1771763766805"
          },
          "code": "CHECK_FOR_MULTIPLE_OPM",
          "id": "1771763676063",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
