        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_GLOBALPAYR_PERSONALPAYMENTMETHODS",
            "errorNodeId": "1775503293055",
            "functionName": "create_personalPaymentMethodsV2",
            "processJson": true,
            "name": "Create Payment Method"
          },
          "outcomes": {
            "success": "1775734125000"
          },
          "code": "CREATE_PAYMENT_METHOD",
          "id": "1770043931599",
          "inputs": [
            {
              "id": "1771579676233_1",
              "name": "Percentage",
              "type": "string",
              "value": "{{$context.$variables.Percentage}}"
            },
