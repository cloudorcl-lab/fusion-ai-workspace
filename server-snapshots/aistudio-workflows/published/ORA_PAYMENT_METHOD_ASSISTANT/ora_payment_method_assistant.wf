        {
          "metadata": {
            "name": "Check CE Profile and Bank Branch Name Values",
            "returnType": "boolean",
            "sourceCode": "const useExistingBankBranch = $context.$variables.PreReqWorkflowRsp.UseExistingBankBranch;\nconst bankName = $context.$variables.BankName;\nconst branchName = $context.$variables.BranchName;\nlet flag = false;\n\nif(useExistingBankBranch) {\n    if(typeof bankName == 'undefined' || bankName == null || bankName.length == 0 || bankName===\"NOT_FOUND\") {\n        flag = true;\n    }\n\n    if(typeof branchName == 'undefined' || branchName == null || branchName.length == 0 || branchName===\"NOT_FOUND\") {\n        flag = true;\n    }\n}\n\nreturn flag;"
          },
          "outcomes": {
            "success": "1771423193040"
          },
          "code": "CHECK_CE_PROFILE_AND_BANK_BRANCH_NAME_VALUES",
          "id": "1771419592564",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
