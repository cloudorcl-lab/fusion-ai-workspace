        {
          "metadata": {
            "name": "Extract Payroll Relationships",
            "returnType": "object",
            "sourceCode": "let validationRsp = {};\nvalidationRsp.PartyId = null;\nvalidationRsp.HasAtLeastOneManageAccess = false;\nvalidationRsp.HasMulitplePR = false;\nvalidationRsp.PayrollRelationships = [];\n\nlet payRels = [];\nconst payRelOutput = $context.$nodes.RETRIEVE_PAYROLL_RELATIONSHIPS_FOR_LOGGED_IN_USER.$output;\n\nif(payRelOutput && payRelOutput.items && payRelOutput.items.length > 0) {\n    validationRsp.PartyId = payRelOutput.items[0].PartyId;\n\n    // only add first PR (Primary Assignment)\n    payRels.push(payRelOutput.items[0]);\n\n    if(payRelOutput.items[0].HasManageAccessFlag == \"true\") {\n        validationRsp.HasAtLeastOneManageAccess = true;\n    }\n}\n\nvalidationRsp.PayrollRelationships = payRels;\n\nreturn validationRsp;"
          },
          "outcomes": {
            "success": "1773412472438"
          },
