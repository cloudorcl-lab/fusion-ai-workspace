              "value": "{{$context.$variables.OrgPaymentMethodId}}"
            },
            {
              "id": "1771579676237_6",
              "name": "PaymentAmountType",
              "type": "string",
              "value": "P"
            },
            {
              "id": "1771579676238_7",
              "name": "PayrollRelationshipId",
              "type": "string",
              "value": "{{$context.$variables.PayrollRelationshipId}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Format Final Response",
            "returnType": "string",
            "sourceCode": "const useExistingBankBranch = $context.$variables.PreReqWorkflowRsp.UseExistingBankBranch;\nconst payrollRelationship = $context.$variables.PreReqWorkflowRsp.PayrollRelationships[0].DisplayValue;\n\nconst ppmName = $context.$variables.PPMName;\nconst paymentType = \"Direct Deposit\";\nconst accNum = $context.$variables.AccountNumber;\nconst routingNumber = $context.$variables.RoutingNumber;\nconst bankName = $context.$variables.BankName;\nconst branchName = $context.$variables.BranchName;\n\nconst deepLinkOutputRaw = $context.$nodes.GENERATE_PAYMENT_METHODS_DIRECT_LINK.$output || \"\";\nconst deepLinkInline = String(deepLinkOutputRaw).replace(/^<p>/i, \"\").replace(/<\\/p>$/i, \"\").trim();\n\nconst incorrectInfoText =`If any of this information is incorrect, please visit the Payment Methods page to make the changes. ${deepLinkInline}.`;\n\nlet html;\n\nif(useExistingBankBranch) {\n    const routingNumberRow = routingNumber ^' || CHR(38)||CHR(38) || q'^ routingNumber !== 'NOT_FOUND'\n        ? `<strong>Routing Number:</strong> ${routingNumber} <br>`\n        : '';\n\n    html = `<div>\n      Your bank account has been created successfully and has been associated to a payment method. Here are the details of your payment method -\n      <br><br>\n      <strong>Payroll Relationship:</strong> ${payrollRelationship}<br>\n      <strong>Payment Method Name:</strong> ${ppmName}<br>\n      <strong>Payment Type:</strong> ${paymentType}<br>\n      <strong>Percentage:</strong> 100%<br>\n      <strong>Account Number:</strong> ${accNum} <br>\n      <strong>Bank:</strong> ${bankName} <br>\n      <strong>Branch:</strong> ${branchName} <br>\n      ${routingNumberRow} ${incorrectInfoText}\n    </div>`;\n} else {\n    html = `<div>\n      Your bank account has been created successfully and has been associated to a payment method. Here are the details of your payment method -\n      <br><br>\n      <strong>Payroll Relationship:</strong> ${payrollRelationship}<br>\n      <strong>Payment Method Name:</strong> ${ppmName}<br>\n      <strong>Payment Type:</strong> ${paymentType}<br>\n      <strong>Percentage:</strong> 100%<br>\n      <strong>Account Number:</strong> ${accNum} <br>\n      <strong>Routing Number:</strong> ${routingNumber} <br>\n      ${incorrectInfoText}\n    </div>`;\n}\n\nreturn html;"
          },
          "outcomes": {
            "success": "1770102345587"
          },
          "code": "FORMAT_FINAL_RESPONSE",
          "id": "1771854683389",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "SummarizeSuccessCreation"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "LLM",
          "id": "1770102345587",
          "inputs": [
            {
              "id": "1770102345588_1",
              "name": "prompt",
              "type": "string",
              "value": "OUTPUT:\n{{$context.$nodes.FORMAT_FINAL_RESPONSE.$output.result}}\nLooking at above OUTPUT, prompt user with exact HTML output and do NOT ask for any further information or help"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Request Missing Information"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "REQUEST_MISSING_INFORMATION",
          "id": "1775499804918",
          "inputs": [
            {
              "id": "1775499804919_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an Oracle HCM Payroll assistant. Your only job is to return ONE sentence asking for missing information.\n\nUse these current extracted values as source of truth (highest priority):\n- UseExistingBankBranch: {{$context.$variables.PreReqWorkflowRsp.UseExistingBankBranch}}\n- Account Number: {{$context.$variables.AccountNumber}}\n- Account Type: {{$context.$variables.AccountType}}\n- Routing Number: {{$context.$variables.RoutingNumber}}\n- Bank Name: {{$context.$variables.BankName}}\n- Branch Name: {{$context.$variables.BranchName}}\n- hasAttachment: {{$context.$variables.hasAttachment}}\n\nSecondary context (only for tie-breaker if a variable is truly empty):\n- User Input Message: {{$context.$system.$inputMessage}}\n- Attachment Content: {{$context.$variables.attachmentRawContent}}\n- Chat History: {{$context.$system.$chatHistory}}\n\nNormalization:\nTreat a field as MISSING if it is null, undefined, empty, whitespace-only, NOT_FOUND, N/A, NA, NULL, NONE, UNKNOWN, TBD, or delimiter-only values like \"-: :-\", \"-:    :-\", \": :\", \"--\", \"()\", \"[]\", \"{}\".\n\nRequired fields:\n1) If UseExistingBankBranch = true:\n   Required = Account Number, Account Type, and (Routing Number OR (Bank Name and Branch Name))\n2) If UseExistingBankBranch = false:\n   Required = Account Number, Account Type, Routing Number\n\nDecision order (strict):\n1) Compute all missing required fields first.\n2) High-priority routing-lookup-failure message is allowed ONLY when ALL are true:\n   - UseExistingBankBranch = true\n   - Account Number is present\n   - Account Type is present\n   - Routing Number is present\n   - Bank Name is missing OR Branch Name is missing\n   - AND there are no other missing required fields besides Bank/Branch\n   Then return exactly:\n   I'm unable to retrieve bank and branch information from the given Routing Number. Please check the routing number and try again.\n3) Otherwise, ask only for missing required fields.\n\nResponse format:\n- If missing exists and hasAttachment = true:\n  I could not extract [missing attributes] from the attachment. Please upload another attachment with these details or enter them manually.\n- If missing exists and hasAttachment = false:\n  Please provide [missing attributes].\n- If nothing is missing:\n  I'm unable to process your request at the moment. Please try after some time or contact your payroll administrator.\n\nFormatting for [missing attributes]:\n- Comma-separated.\n- Order: Account Number, Account Type, Routing Number, Bank Name, Branch Name\n- For UseExistingBankBranch=true:\n  - If both Routing Number and (Bank Name + Branch Name) are missing, use exactly:\n    Routing Number or Bank Name and Branch Name\n  - If Routing Number is present, do not ask for Bank Name/Branch Name unless decision order step 2 applies.\n- Keep output to exactly one sentence.\n- No greeting, no extra explanation."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Check PreReq for Errors",
            "returnType": "string",
            "sourceCode": "let errorCode = \"NONE\";\nlet workFlowRsp = $context.$variables.PreReqWorkflowRsp;\n\nif(!workFlowRsp.PartyId || workFlowRsp.PartyId == null) {\n    errorCode = \"NO_PARTY_ID\";\n} else if (!workFlowRsp.HasAtLeastOneManageAccess) {\n    errorCode = \"READ_ONLY_ACCESS\";\n} else if(Array.isArray(workFlowRsp.PayrollRelationships)) {\n    if(workFlowRsp.PayrollRelationships.length == 0) {\n        errorCode = \"NO_PAYROLL_RELATIONSHIPS\";\n    } else {\n        if (workFlowRsp.PayrollRelationships.length === 1 && workFlowRsp.PayrollRelationships[0] && workFlowRsp.PayrollRelationships[0].LegislationCode !== \"US\") {\n            errorCode = \"NON_US_LEGISLATION\";\n        }\n\n        if(workFlowRsp.PayrollRelationships.length == 1 && Array.isArray(workFlowRsp.PayrollRelationships[0].OrgPayMethods) && workFlowRsp.PayrollRelationships[0].OrgPayMethods.length == 0) {\n            errorCode = \"NO_EFT_OPM\";\n        } else {\n            let hasExistingPPMs = true;\n            for(const payRel of workFlowRsp.PayrollRelationships) {\n                hasExistingPPMs = hasExistingPPMs && payRel.HasPaymentMethods;\n            }\n            if(hasExistingPPMs) {\n                errorCode = \"PAYMENT_METHOD_EXISTS\";\n            }\n        }\n    }\n}\n\nreturn errorCode;"
          },
          "outcomes": {
            "success": "1770718368243"
          },
          "code": "CHECK_PREREQ_FOR_ERRORS",
          "id": "1775502547832",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get Message",
            "returnType": "string",
            "sourceCode": "const errorCode = $context.$nodes.CHECK_PREREQ_FOR_ERRORS.$output.result;\nlet errorMessage = \"\";\n\nif(errorCode === \"NO_PAYROLL_RELATIONSHIPS\") {\n    errorMessage = \"I can’t find the prerequisite Payroll Relationship setup for you in your organization. Please contact your payroll administrator.\";\n} else if(errorCode === \"NO_PARTY_ID\") {\n    errorMessage = \"I can't find your party id. Please contact your payroll administrator to generate your party id and retry.\";\n} else if(errorCode === \"PAYMENT_METHOD_EXISTS\") {\n    errorMessage = \"You already have one or more payment methods defined. I currently can't support creating additional payment methods. Please contact your payroll administrator.\";\n} else if(errorCode === \"READ_ONLY_ACCESS\") {\n    errorMessage = \"You don't seem to have the necessary privileges to manage your payment methods. Please contact your payroll administrator.\";\n} else if(errorCode === \"NO_EFT_OPM\") {\n    errorMessage = \"I can’t find the prerequisite Direct Deposit Organization Payment Method setup for your organization. Please contact your payroll administrator.\";\n} else if(errorCode === \"NON_US_LEGISLATION\") {\n    errorMessage = \"Sorry, I can not create bank account and payment method for non US users as of now. Please contact your payroll administrator.\";\n}\n\nreturn errorMessage;"
          },
          "outcomes": {
            "success": "1771854000730"
          },
          "code": "GET_MESSAGE",
          "id": "1775503018236",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Payment Method Creation Error Handler"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "PAYMENT_METHOD_CREATION_ERROR_HANDLER",
          "id": "1775503293055",
          "inputs": [
            {
              "id": "1775503293056_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a Oracle Fusion HCM Payroll Consultant. You are given a technical REST error response which is encountered while creating a Payment Method for the user. Your task is to parse the response payload and construct a meaningful functional description of the issue without exposing any Error Code or Technical details.\n\nParse the payload and present to the user in a professional and polite manner. Do not add any follow up action, just inform why the request failed. Do not guess anything. It is very important to add this in your response \"Your bank account was saved successfully. Create a payment method and link it to this bank account to receive payments. Please contact your Payroll Administrator as early as possible.\"\n\nInputs :\n{{$context.$nodes.CREATE_PAYMENT_METHOD.$error.$info}}"
            }
          ],
          "type": "LLM"
        },
