                {
                  "metadata": {
                    "name": "Get Payment Methods Count per PR",
                    "returnType": "object",
                    "sourceCode": "let rspObj = {};\nconst payRelId = $context.$nodes.CHECK_PPM_OPM_PREF_FOR_PAYROLL_RELATIONSHIPS.$currentItem.PayrollRelationshipId;\nconst activePpmRsp = $context.$nodes.CHECK_PPM_OPM_PREF_FOR_PAYROLL_RELATIONSHIPS.FETCH_ACTIVE_PAYMENT_METHODS.$output;\nconst futurePpmRsp = $context.$nodes.CHECK_PPM_OPM_PREF_FOR_PAYROLL_RELATIONSHIPS.FETCH_FUTURE_PAYMENT_METHODS.$output;\n\nrspObj.PayrollRelationshipId = payRelId;\nrspObj.PaymentMethodCount = 0;\n\nif(activePpmRsp && Array.isArray(activePpmRsp.items)) {\n    rspObj.PaymentMethodCount = activePpmRsp.items.length;\n}\n\nif(futurePpmRsp && Array.isArray(futurePpmRsp.items)) {\n    rspObj.PaymentMethodCount = rspObj.PaymentMethodCount + futurePpmRsp.items.length;\n}\n\nconst opmRsp = $context.$nodes.CHECK_PPM_OPM_PREF_FOR_PAYROLL_RELATIONSHIPS.CHECK_ORG_PAY_METHOD_FOR_PR.$output;\nlet opmArray = [];\n\nif(Array.isArray(opmRsp.items)) {\n    for(const opmRow of opmRsp.items) {\n        const opm = {};\n        opm.OrgPaymentMethodId = opmRow.OrgPaymentMethodId;\n        opm.OrgPaymentMethodName = opmRow.OrgPaymentMethodName;\n        opmArray.push(opm);\n    }\n}\n\nrspObj.OrgPayMethods = opmArray;\n\nconst prefOutput = $context.$nodes.CHECK_PPM_OPM_PREF_FOR_PAYROLL_RELATIONSHIPS.GET_PREFERENCE.$output;\n\nrspObj.OpmDisplayFlag = prefOutput.items[0].OpmDisplayFlag;\n\nreturn rspObj;"
                  },
