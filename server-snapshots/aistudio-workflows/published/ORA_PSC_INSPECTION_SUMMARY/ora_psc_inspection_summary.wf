        {
          "metadata": {
            "name": "no checklists llm"
          },
          "outcomes": {
            "success": "1765240758722"
          },
          "code": "NO_CHECKLISTS_LLM",
          "convergenceTargetId": "1765690091808",
          "id": "1767912845971",
          "inputs": [
            {
              "id": "1767912845973_1",
              "name": "prompt",
              "type": "string",
              "value": "Say 'There are no resulted checklists'"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "cleanup checklists",
            "returnType": "object",
            "sourceCode": "const checklists = $context.$nodes.CHECKLISTS.$output.items;\nconst items = $context.$nodes.CHECKLIST_ITEMS.$output.items;\n\nconst assessments = $context.$variables.Assessments;\nconst checklist = (cid) => checklists.find(cl => cl.ChecklistId === cid);\nconst assessment = (cid, clr) => assessments.find(a => a.AssessmentType === checklist(cid)?.AssessmentType && a.AssessmentCode === clr);\n\n// Map ChecklistId -> ChecklistName (fallback to id if name missing)\nconst idToName = new Map();\nfor (const c of checklists) {\n    const name = c?.ChecklistName || c?.ChecklistId || 'UNKNOWN_CHECKLIST';\n    idToName.set(c?.ChecklistId, name);\n}\n\nconst tree = Object.create(null);\n\n// Pre-create empty arrays for known checklists\nfor (const c of checklists) {\n    const name = idToName.get(c?.ChecklistId) || c?.ChecklistId || 'UNKNOWN_CHECKLIST';\n    const result = assessment(c.ChecklistId, c.ChecklistResult);\n    const clResult = result ? {\"SystemResult\": result.SystemResult, \"Result\": result.Description} : {\"Result\": \"None\"};\n    if (c.NumberMajorViolations) clResult[\"Number of major violations\"] = c.NumberMajorViolations;\n    if (!tree[name]) tree[name] = clResult;\n}\n\n// Attach items to their parent checklist by ChecklistId\nfor (const it of items) {\n    const parentName = idToName.get(it?.ChecklistId) || it?.ChecklistId || 'UNKNOWN_CHECKLIST';\n    const result = assessment(it.ChecklistId, it.ChecklistItemResult);\n    const clResult = result ? {\"SystemResult\": result.SystemResult, \"Result\": result.Description} : {\"Result\": \"None\"};\n    tree[parentName][it.ChecklistItemName] = clResult;\n}\n\nreturn tree;"
          },
          "outcomes": {
            "success": "1765690091808"
          },
          "code": "CLEANUP_CHECKLISTS",
          "convergenceTargetId": "1765690091808",
          "id": "1765690221800",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "summarize checklists code",
            "returnType": "string",
            "sourceCode": "// Lambdas only.\n// Keeps ONLY FAIL nodes and the minimal parent chain needed to reach them.\n// Renders HTML <ul>/<li>, and DOES NOT skip the top-level keys anymore.\n\nconst leaveFailNodesOnly = (node) => {\n  const isObj = node && typeof node === \"object\";\n  const isArr = Array.isArray(node);\n\n  if (isArr) {\n    const kept = node.map(leaveFailNodesOnly).filter((v) => v !== undefined);\n    return kept.length ? kept : undefined;\n  }\n\n  if (!isObj) return undefined; // drop primitives entirely\n\n  const isFail = node.SystemResult === \"FAIL\";\n\n  const out = Object.fromEntries(\n    Object.entries(node)\n      .map(([k, v]) => {\n        if (k === \"SystemResult\") return isFail ? [k, v] : null;\n        if (k === \"Result\") return isFail ? [k, v] : null;\n\n        if (v && typeof v === \"object\") {\n          const cleaned = leaveFailNodesOnly(v);\n          return cleaned === undefined ? null : [k, cleaned];\n        }\n        return null;\n      })\n      .filter(Boolean)\n  );\n\n  return isFail ? out : (Object.keys(out).length ? out : undefined);\n};\n\nconst escapeHtml = (s) =>\n  String(s)\n    .replaceAll(\"&\", \"&amp;\")\n    .replaceAll(\"<\", \"&lt;\")\n    .replaceAll(\">\", \"&gt;\")\n    .replaceAll('\"', \"&quot;\")\n    .replaceAll(\"'\", \"&#39;\");\n\nconst failJsonToHtmlList = (data) => {\n  const pruned = leaveFailNodesOnly(data) ?? {};\n  const isPlainObject = (v) => v && typeof v === \"object\" && !Array.isArray(v);\n\n  const childEntries = (obj) =>\n    Object.entries(obj).filter(\n      ([k, v]) => k !== \"SystemResult\" && k !== \"Result\" && isPlainObject(v)\n    );\n\n  const lineHtml = (name, obj) =>\n    obj && obj.SystemResult === \"FAIL\" && typeof obj.Result === \"string\" && obj.Result.length > 0\n      ? `<strong>${escapeHtml(name)}</strong> - ${escapeHtml(obj.Result)}`\n      : `<strong>${escapeHtml(name)}</strong>`;\n\n  const walk = (name, obj) => {\n    const kids = childEntries(obj);\n    return `<li>${lineHtml(name, obj)}${\n      kids.length ? `<ul>${kids.map(([cn, co]) => walk(cn, co)).join(\"\")}</ul>` : \"\"\n    }</li>`;\n  };\n\n  // Render actual top-level keys (no wrapper skipping)\n  const startNodes = Object.entries(pruned).filter(([, v]) => isPlainObject(v));\n  return `<ul>${startNodes.map(([n, o]) => walk(n, o)).join(\"\")}</ul>`;\n};\n\nconst inputJson = $context.$nodes.CLEANUP_CHECKLISTS.$output.result;\nconst html = failJsonToHtmlList(inputJson);\n\nreturn html;"
          },
          "outcomes": {
            "success": "1765240758722"
          },
          "code": "SUMMARIZE_CHECKLISTS_CODE",
          "convergenceTargetId": "1765690091808",
          "id": "1774980092520",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "summarize checklists"
          },
          "outcomes": {
            "success": "1774980092520"
          },
          "code": "SUMMARIZE_CHECKLISTS",
          "convergenceTargetId": "1774980092520",
          "id": "1765690091808",
          "inputs": [
            {
              "id": "1765690091810_1",
              "name": "prompt",
              "type": "string",
              "value": "Consider the following JSON data of Inspection Checklist results:\n```\n{{$context.$nodes.CLEANUP_CHECKLISTS.$output.result}}\n```\nProvide a very short paragraph summary of the above containing a brief high-level summary in natural language. Keep it less than 2 sentences. When the Result is \"None\" that means the checklist has not yet been Resulted by the inspector. There may be some items that have a \"Number of major violations\" attribute. When there are numerous Checklist/Checklist Items and one or more Major Violations, make sure to include the total number of violations. Also, indicate which items are flagged with Major Violation.\n\n- Do not use a list format, but be succinct.\n- Do not output the SystemResult, only output the Result.\n- Do not list out any Result that is \"None\".\n- Do not provide any advice - only summarize the data in the tree structure, do not add anything other information or advice.\n- Do not refer to 'data', 'tree', or any other technical terms in this prompt."
            }
          ],
          "type": "LLM"
        }
      ],
