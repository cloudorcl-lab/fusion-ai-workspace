        {
          "metadata": {
            "name": "final output",
            "returnType": "string",
            "sourceCode": "const checklistSummary = $context.$nodes.SUMMARIZE_CHECKLISTS?.$output ?? \"\";\nconst checklists = $context.$nodes.SUMMARIZE_CHECKLISTS_CODE?.$output?.result ?? $context.$nodes.NO_CHECKLISTS_LLM.$output;\nconst comments = $context.$nodes.SUMMARIZE_COMMENTS?.$output ?? $context.$nodes.NO_COMMENTS_LLM.$output;\n\nreturn `<p>${checklistSummary}</p>${checklists}<h6 class=\"oj-header\" id=\"psc-inspection-result-ai-summary-output-rich-text-comments\">Comments</h6>${comments}`;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "FINAL_OUTPUT",
          "id": "1765240758722",
          "inputs": [],
