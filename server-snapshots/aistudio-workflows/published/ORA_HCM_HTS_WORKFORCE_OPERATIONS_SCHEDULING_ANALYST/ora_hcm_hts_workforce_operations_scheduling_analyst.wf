                  "metadata": {
                    "name": "Extract Shift Date",
                    "returnType": "object",
                    "sourceCode": "const requestName =  $context.$nodes.FETCH_CRITICAL_REQUESTS.$currentItem.Name;\nconst processName = $context.$nodes.FETCH_CRITICAL_REQUESTS.$currentItem.ProcessName;\n\nlet shiftDate;\n\nlet todaysShiftPriorities;\n\nif(processName && processName.includes('Shift Drop')){\n      shiftDate = requestName.split('Shift Drop Request for ')[1].substring(0,8);\n}else if(processName && processName.includes('Shift Request')){\n      shiftDate = requestName.split('Shift Request for ')[1].substring(0,8);\n}\n\nconst currentDate = $context.$system.$currentDate;\n\nconst [day, month, year] = shiftDate.split(\"-\");\nconst shiftDateInYYYYMMDD = `20${year}-${month}-${day}`;\n\n//add shift date to the currentItem\n$context.$nodes.FETCH_CRITICAL_REQUESTS.$currentItem.ShiftDate = shiftDateInYYYYMMDD;\n\nreturn $context.$nodes.FETCH_CRITICAL_REQUESTS.$currentItem;"
                  },
                  "outcomes": {
                    "success": "end_1768333581616"
                  },
                  "code": "EXTRACT_SHIFT_DATE",
                  "convergenceTargetId": "end_1768333581616",
                  "id": "1768333855694",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                }
