        {
          "metadata": {
            "name": "Extract TxnId From Payload",
            "returnType": "string",
            "sourceCode": "const action = $context.$triggers.REST.$input.OraAction;\n\nconst formSubmitted = action.match(/<oraFormSubmit\\s+id=[\"']([^\"']*)[\"'][^>]*>(.*?)<\\/oraFormSubmit>/s);\n\nif (formSubmitted) {\n  const id = formSubmitted[1];      // Extracted ID value\n  const formPayload = formSubmitted[2];    // Extracted JSON content (string)\n\n  // Build object from extracted values\n  const obj = {\n    id: id,\n    json: formPayload\n  };\n\n  // 1. Extract scheduleShiftId (between \"ScheduleShiftId_\" and \"_ScheduleId\")\n  const scheduleShiftId = obj.id.split(\"ScheduleShiftId_\")[1].split(\"_ScheduleId_\")[0];\n\n  // 2. Extract the ScheduleId (between \"_ScheduleId_\" and \"_TransactionId_\")\n  const scheduleId = obj.id.split(\"_ScheduleId_\")[1].split(\"_TransactionId_\")[0];\n\n  // 3. Extract TransactionId (after \"_TransactionId_\")\n  const transactionId = obj.id.split(\"_TransactionId_\")[1];\n\n//Extract Schedule Details from the form.\n  // Parse JSON content and extract PersonId and AssignmentId\n  const personArray = JSON.parse(obj.json);\n  const reassignedPersonAndAsgId = personArray.find(x => x.id === \"ReassignTo\")?.value || null;\n\n  // 1. Extract personId (between \"PersonId_\" and \"_AssignmentId\")\n  const personId = reassignedPersonAndAsgId.split(\"PersonId_\")[1].split(\"_AssignmentId\")[0];\n\n  // 2. Extract the AssignmentId (after  \"_AssignmentId\" )\n  const assignmentId = reassignedPersonAndAsgId.split(\"_AssignmentId_\")[1];\n\n  // Build transaction payload\n  const output = {\n    \"TransactionId\": transactionId,\n    \"ScheduleShiftId\": Number(scheduleShiftId),\n    \"ScheduleId\": Number(scheduleId),    \n    \"AssignmentId\": Number(assignmentId),\n   \"PersonId\": Number(personId)\n  };\n\n  return transactionId;\n}\n\nreturn {};"
          },
          "outcomes": {
            "success": "1767681676424"
          },
          "code": "EXTRACT_TXN_ID_FROM_PAYLOAD",
          "id": "1767680049282",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Extract Schedule Id from Payload",
            "returnType": "number",
            "sourceCode": "const action = $context.$triggers.REST.$input.OraAction;\n\nconst formSubmitted = action.match(/<oraFormSubmit\\s+id=[\"']([^\"']*)[\"'][^>]*>(.*?)<\\/oraFormSubmit>/s);\n\nif (formSubmitted) {\n  const id = formSubmitted[1];      // Extracted ID value\n  const formPayload = formSubmitted[2];    // Extracted JSON content (string)\n\n  // Build object from extracted values\n  const obj = {\n    id: id,\n    json: formPayload\n  };\n\n  // 1. Extract scheduleShiftId (between \"ScheduleShiftId_\" and \"_ScheduleId\")\n  const scheduleShiftId = obj.id.split(\"ScheduleShiftId_\")[1].split(\"_ScheduleId_\")[0];\n\n  // 2. Extract the ScheduleId (between \"_ScheduleId_\" and \"_TransactionId_\")\n  const scheduleId = obj.id.split(\"_ScheduleId_\")[1].split(\"_TransactionId_\")[0];\n\n  // 3. Extract TransactionId (after \"_TransactionId_\")\n  const transactionId = obj.id.split(\"_TransactionId_\")[1];\n\n//Extract Schedule Details from the form.\n  // Parse JSON content and extract PersonId and AssignmentId\n  const personArray = JSON.parse(obj.json);\n  const reassignedPersonAndAsgId = personArray.find(x => x.id === \"ReassignTo\")?.value || null;\n\n  // 1. Extract personId (between \"PersonId_\" and \"_AssignmentId\")\n  const personId = reassignedPersonAndAsgId.split(\"PersonId_\")[1].split(\"_AssignmentId\")[0];\n\n  // 2. Extract the AssignmentId (after  \"_AssignmentId\" )\n  const assignmentId = reassignedPersonAndAsgId.split(\"_AssignmentId_\")[1];\n\n  // Build transaction payload\n  const output = {\n    \"TransactionId\": transactionId,\n    \"ScheduleShiftId\": Number(scheduleShiftId),\n    \"ScheduleId\": Number(scheduleId),    \n    \"AssignmentId\": Number(assignmentId),\n   \"PersonId\": Number(personId)\n  };\n\n  return scheduleId;\n}\n\nreturn {};"
          },
          "outcomes": {
            "success": "1767681710996"
          },
          "code": "EXTRACT_SCHEDULE_ID_FROM_PAYLOAD",
          "id": "1767681676424",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
