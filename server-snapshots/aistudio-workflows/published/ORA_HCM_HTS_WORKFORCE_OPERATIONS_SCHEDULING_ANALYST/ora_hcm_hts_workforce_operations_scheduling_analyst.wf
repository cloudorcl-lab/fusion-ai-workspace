            "name": "Retrieve Action Parameters",
            "returnType": "object",
            "sourceCode": "var payload = $context.$triggers.REST.$input.OraAction;\n\nconst jsonMatch = payload.match(/\\(\\{([\\s\\S]*)\\}\\)/);\n\nif (jsonMatch && jsonMatch.length > 1) {\n  const obj = JSON.parse(`{${jsonMatch[1]}}`);\n  return JSON.stringify(obj);\n}\n\nreturn \"\";"
