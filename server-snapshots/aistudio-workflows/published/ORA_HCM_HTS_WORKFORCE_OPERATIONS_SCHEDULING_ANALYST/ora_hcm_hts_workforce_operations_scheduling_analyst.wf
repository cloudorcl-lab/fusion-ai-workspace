        {
          "metadata": {
            "name": "Invoke Action Decoder",
            "returnType": "string",
            "sourceCode": "let action = undefined;\nif ($context.$triggers.REST.$input.OraAction.includes(\"Approve Shift Drop\"))\n  action = \"ApproveShiftDrop\";\nelse if ($context.$triggers.REST.$input.OraAction.includes(\"Approve Shift Request\"))\n  action = \"ApproveShiftRequest\";\nelse if ($context.$triggers.REST.$input.OraAction.includes(\"Reject\"))\n  action = \"Reject\";\nelse if ($context.$triggers.REST.$input.OraAction.includes(\"oraFormSubmit\"))\n  action = \"ApproveAndReassign\";\nelse if ($context.$triggers.REST.$input.OraAction.includes(\"bulkPublish\"))\n  action = \"bulkPublish\";\n\n\nreturn action;"
          },
          "outcomes": {
            "success": "1767671928502"
          },
          "code": "INVOKE_ACTION_DECODER",
          "id": "1767671792051",
          "inputs": [],
