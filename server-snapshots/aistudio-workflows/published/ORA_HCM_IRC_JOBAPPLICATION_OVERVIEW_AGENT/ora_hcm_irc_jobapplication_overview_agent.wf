                {
                  "metadata": {
                    "name": "ManageInterviewData",
                    "returnType": "object",
                    "sourceCode": "var items = $context.$nodes.INTERVIEW_FEEDBACK?.$output?.items || [];\nconst interviewFeedbackData = [];\n\nfor (let i = 0; i < items.length; i++) {\n    const item = items[i];\n\n    const questionnaireResponses = item.questionnaireResponses?.items || [];\n\n    for (let j = 0; j < questionnaireResponses.length; j++) {\n        const qr = questionnaireResponses[j];\n\n        if (qr.StatusMeaning !== \"Submitted\") {\n            continue;\n        }\n\n        const questionResponses = qr.questionResponses?.items || [];\n        const questions = [];\n\n        for (let k = 0; k < questionResponses.length; k++) {\n            const q = questionResponses[k];\n\n            let answer = null;\n\n            const shortRaw = q.AnswerShortDescriptionList;\n            const shortText = shortRaw == null ? \"\" : String(shortRaw).trim();\n\n            if (\n                shortText !== \"\" &&\n                shortText !== \"null\" &&\n                shortText !== \"null,\" &&\n                shortText !== \"null;\"\n            ) {\n                const parts = shortText.split(\",\");\n                const cleaned = [];\n\n                for (let p = 0; p < parts.length; p++) {\n                    const v = parts[p].trim().replace(/;$/, \"\");\n                    if (v !== \"\" && v !== \"null\") {\n                        cleaned.push(v);\n                    }\n                }\n\n                if (cleaned.length === 1) {\n                    answer = cleaned[0];\n                } else if (cleaned.length > 1) {\n                    answer = cleaned;\n                }\n            } else {\n                const largeRaw = q.AnswerLargeObject;\n                const largeText = largeRaw == null ? \"\" : String(largeRaw).trim();\n                if (largeText !== \"\" && largeText !== \"null\") {\n                    answer = largeText;\n                }\n            }\n\n            questions.push({\n                questionText: q.QuestionText ?? null,\n                answer: answer\n            });\n        }\n\n        interviewFeedbackData.push({\n            reviewer: item.ParticipantName ?? null,\n            questionnaireName: item.QuestionnaireName ?? null,\n            rating: (item.Rating || 0) + \" out of 5\",\n            score: (qr.TotalScore || 0) + \" out of \" + (item.QuestionnaireMaximumScore || 0),\n            questions: questions\n        });\n    }\n}\n\nreturn interviewFeedbackData;"
                  },
                  "outcomes": {
                    "success": "1771636219767"
                  },
                  "code": "MANAGEINTERVIEWDATA",
                  "id": "1771361433893",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE",
                  "diagram": {
                    "x": 6841.5,
                    "y": 9497
                  }
                },
                {
                  "metadata": {
                    "name": "ManageAssessmentresultsData",
                    "returnType": "object",
                    "sourceCode": "var items = $context.$variables.assessmentResults || [];\n\nvar validStatuses = [\n  \"ORA_COMPLETED\",\n  \"ORA_COMPLETED_PASS\",\n  \"ORA_COMPLETED_FAIL\"\n];\n\nvar assessmentResultsData = items\n  .filter(item => item?.PackageStatus && validStatuses.includes(item.PackageStatus))\n  .map(item => ({\n    PackageName: item?.PackageName ?? null,\n    Score: item?.Score ?? null,\n    Percentile: item?.AssessmentPercentile ?? null,\n    Band: item?.Band ?? null\n  }));\n\nreturn assessmentResultsData;"
                  },
                  "outcomes": {
                    "success": "1771639939509"
                  },
                  "code": "MANAGEASSESSMENTRESULTSDATA",
                  "id": "1771636219767",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE",
                  "diagram": {
                    "x": 6840,
                    "y": 9719
                  }
                },
                {
                  "metadata": {
                    "name": "ManagePreScreeningData",
                    "returnType": "object",
                    "sourceCode": "var items = $context.$nodes.SCREENING_QUESTIONNAIRES?.$output?.items || [];\nconst questionnaireData = [];\n\nfor (let i = 0; i < items.length; i++) {\n    const questionnaire = items[i];\n\n    const questionnaireResponses = questionnaire.questionnaireResponses?.items || [];\n\n    for (let j = 0; j < questionnaireResponses.length; j++) {\n        const qr = questionnaireResponses[j];\n\n        if (qr.StatusMeaning !== \"Submitted\") {\n            continue;\n        }\n\n        const questionResponses = qr.questionResponses?.items || [];\n        const questions = [];\n\n        for (let k = 0; k < questionResponses.length; k++) {\n            const q = questionResponses[k];\n\n            let answer = null;\n\n            const shortRaw = q.AnswerShortDescriptionList;\n            const shortText = shortRaw == null ? \"\" : String(shortRaw).trim();\n\n            if (\n                shortText !== \"\" &&\n                shortText !== \"null\" &&\n                shortText !== \"null,\" &&\n                shortText !== \"null;\"\n            ) {\n                const parts = shortText.split(\",\");\n                const cleaned = [];\n\n                for (let p = 0; p < parts.length; p++) {\n                    const v = parts[p].trim().replace(/;$/, \"\");\n                    if (v !== \"\" && v !== \"null\") {\n                        cleaned.push(v);\n                    }\n                }\n\n                if (cleaned.length === 1) {\n                    answer = cleaned[0];\n                } else if (cleaned.length > 1) {\n                    answer = cleaned;\n                }\n            } else {\n                const largeRaw = q.AnswerLargeObject;\n                const largeText = largeRaw == null ? \"\" : String(largeRaw).trim();\n                if (largeText !== \"\" && largeText !== \"null\") {\n                    answer = largeText;\n                }\n            }\n\n            questions.push({\n                questionText: q.QuestionText ?? null,\n                answer: answer,\n                score: q.Score ?? null\n            });\n        }\n\n        questionnaireData.push({\n            questionnaireName: questionnaire.Name ?? null,\n            questionnaireTotalScore: questionnaire.TotalScore ?? null,\n            questionnaireMaxScore: questionnaire.MaximumPossibleScore ?? null,\n            questions: questions\n        });\n    }\n}\n\nreturn questionnaireData;"
                  },
                  "outcomes": {
                    "success": "1770279214506"
                  },
