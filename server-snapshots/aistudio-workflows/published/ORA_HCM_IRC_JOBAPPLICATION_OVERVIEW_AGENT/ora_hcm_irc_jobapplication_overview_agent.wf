                {
                  "metadata": {
                    "name": "PreProcessAIScoreData",
                    "returnType": "object",
                    "sourceCode": "  const clean = value => {\n    if (\n      value === null ||\n      value === undefined ||\n      value === \"\" ||\n      value === \"N/A\"\n    ) {\n      return undefined;\n        }\n\n    if (Array.isArray(value)) {\n      const cleanedArray = value\n        .map(clean)\n        .filter(item => item !== undefined);\n\n      return cleanedArray.length ? cleanedArray : undefined;\n        }\n\n    if (typeof value === \"object\") {\n      const cleanedObject = {};\n\n      for (const key in value) {\n        const cleanedValue = clean(value[key\n                ]);\n\n        if (cleanedValue !== undefined) {\n          cleanedObject[key\n                    ] = cleanedValue;\n                }\n            }\n\n      return Object.keys(cleanedObject).length ? cleanedObject : undefined;\n        }\n\n    return value;\n    };\n\n  const candidate = $context.$variables.manageApplicationDataResult || {};\n  const job = $context.$variables.manageRequisitionDataResult || {};\n\n  return {\n    candidate:\n      clean({\n        languageCode: candidate.languageCode,\n        candidateResume: candidate.candidateResume,\n        educationList: candidate.educationList,\n        experienceList: candidate.experienceList,\n        skillsList: candidate.skillsList\n        }) || {},\n\n    job:\n      clean({\n        jobDescription: job.jobDescription,\n        qualifications: job.qualifications,\n        responsibility: job.responsibility,\n        jobRequiredSkills: job.jobRequiredSkills\n        }) || {}\n    };"
                  },
                  "outcomes": {
                    "success": "1777008859469"
                  },
