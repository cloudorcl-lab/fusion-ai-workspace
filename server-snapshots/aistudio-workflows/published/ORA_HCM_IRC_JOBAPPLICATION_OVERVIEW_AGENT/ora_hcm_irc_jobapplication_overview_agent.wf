                {
                  "metadata": {
                    "name": "ManageApplicationData",
                    "returnType": "object",
                    "sourceCode": "// Job application Data\nlet jobApplicationData = $context.$variables.jobapplicationData || {};\nlet wp = jobApplicationData?.workPreferences?.items?.[0] || null;\n\n// Extracting candidate information\nlet candidateName = jobApplicationData.CandidateName || 'N/A';\n\nlet languageCode = jobApplicationData.LanguageCode || 'US';\n// Map safely with fallback\nlanguageCode = $context.$variables.languageMap?.[languageCode.trim().toUpperCase()] || languageCode;\n\nlet internalCandidate = jobApplicationData.InternalFlag != null\n  ? (jobApplicationData.InternalFlag ? 'Yes' : 'No')\n  : 'N/A';\n\n// Extracting work preferences\nlet workPreferences = wp ? {\n    WorkFlexibleSchedule: wp.FlexibleWorkFlag != null ? (wp.FlexibleWorkFlag ? 'Yes' : 'No') : 'N/A',\n    TravelInternationally: wp.IntlTravelFlag != null ? (wp.IntlTravelFlag ? 'Yes' + (wp.IntlTravelFrequency  ? ', ' + wp.IntlTravelFrequency.replace('PCT', '%')  : '')  : 'No') : 'N/A',\n    TravelDomestically: wp.NatTravelFlag != null ? (wp.NatTravelFlag ? 'Yes' + (wp.NatTravelFrequency ? ', ' + wp.NatTravelFrequency.replace('PCT', '%') : '') : 'No') : 'N/A',    \n    WillingToRelocate: wp.RelocateFlag != null ? (wp.RelocateFlag ? 'Yes' : 'No') : 'N/A',\n    RelocationReason: wp.RelocationReason || 'N/A',\n    MinimumPay: wp.MinimumPay != null ? (wp.MinimumPay + (wp.CurrencyCode ? ' ' + wp.CurrencyCode : '')) : 'N/A' \n} : {};\n\n// Candidate Resume\nvar resume = $context.$variables.resumeText;\n\nif (resume && typeof resume === \"string\") {\n\n  // 1. Remove Emails\n  var emailRegex = /\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b/gi;\n  resume = resume.replace(emailRegex, \"\");\n\n  // 2. Remove Phone Numbers (global formats)\n  var phoneRegex = /\\b(\\+?\\d{1,3}[\\s-]?)?(\\(?\\d{3}\\)?[\\s.-]?)\\d{3}[\\s.-]?\\d{4}\\b/g;\n  resume = resume.replace(phoneRegex, \"\");\n\n  // 3. Remove URLs (LinkedIn, GitHub, Portfolio, etc.)\n  var urlRegex = /(https?:\\/\\/|www\\.)[^\\s]+/gi;\n  resume = resume.replace(urlRegex, \"\");\n\n  // 4. Remove Address-like lines (street, zip patterns)\n  var addressRegex = /\\b\\d{1,5}\\s+\\w+(\\s\\w+)*,\\s?\\w+(\\s\\w+)*,?\\s?[A-Z]{2}\\s?\\d{5}\\b/gi;\n  resume = resume.replace(addressRegex, \"\");\n\n  // 5. Remove excessive symbols and separators\n  resume = resume.replace(/[|•►▪■◆★]+/g, \" \");\n\n  // 6. Normalize whitespace (major token saver)\n  resume = resume.replace(/\\r/g, \"\\n\");         // normalize line breaks\n  resume = resume.replace(/\\n{3,}/g, \"\\n\\n\");   // remove excessive blank lines\n  resume = resume.replace(/[ \\t]{2,}/g, \" \");   // collapse spaces\n\n  // 7. Trim final text\n  resume = resume.trim();\n}\n\n// Base result object\nlet resultObject = {\n    candidateName,\n    internalCandidate,\n    languageCode,\n    candidateResume: resume || 'N/A',\n    workPreferences\n};\n\n// Summary Type Check\nlet summaryType = $context.$nodes.REQUESTLOOP.$currentItem.SummaryType;\nlet isCandidateSummary = ['ALL', 'CANDIDATE_PROFILE'].includes(summaryType);\n\n// Extract structured data if resume missing\nif (isCandidateSummary && !resume) {\n\n    let educationData = jobApplicationData?.education?.items || [];\n    let experienceData = jobApplicationData?.experience?.items || [];\n    let certificatesData = jobApplicationData?.licensesAndCertificates?.items || [];\n    let jobapplicationSkills = $context.$variables.jobapplicationSkills || [];\n\n    let educationList = educationData.map(item => ({\n        DegreeName: item.DegreeName || 'N/A',\n        Major: item.Major || 'N/A',\n        Minor: item.Minor || 'N/A',\n        Graduated: item.GraduatedFlag != null ? (item.GraduatedFlag ? 'Yes' : 'No') : 'N/A',\n        GPA: item.GPA || 'N/A',\n        YearAcquired: item.YearAcquired || 'N/A'\n    }));\n\n    let skillsList = jobapplicationSkills.map(skill => ({\n        Skill: skill.Skill || 'N/A',\n        YearsOfExperience: skill.YearsOfExperience || 'N/A'\n    }));\n\n    let experienceList = experienceData.map(exp => ({\n        JobTitle: exp.JobTitle || 'N/A',\n        EmployerName: exp.EmployerName || 'N/A',\n        StartDate: exp.StartDate || 'N/A',\n        EndDate: exp.EndDate || 'N/A',\n        CurrentJob: exp.CurrentJobFlag != null ? (exp.CurrentJobFlag ? 'Yes' : 'No') : 'N/A'\n    }));\n\n    let certificationsList = certificatesData.map(cert => ({\n        CertificationName: cert.CertificationName || 'N/A',\n        CertificationNumber: cert.CertificationNumber || 'N/A',\n        ExpirationDate: cert.ExpirationDate || 'N/A'\n    }));\n\n    resultObject = {\n        ...resultObject,\n        educationList,\n        skillsList,\n        experienceList,\n        certificationsList\n    };\n}\n\nreturn resultObject;"
                  },
                  "outcomes": {
                    "success": "1763436303085"
                  },
