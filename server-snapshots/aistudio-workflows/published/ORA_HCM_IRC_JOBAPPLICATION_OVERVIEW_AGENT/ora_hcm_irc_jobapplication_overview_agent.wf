                {
                  "metadata": {
                    "name": "ManageRequisitionData",
                    "returnType": "object",
                    "sourceCode": "let reqWorkRequirements = $context.$variables.ReqWorkRequirements || [];\nlet reqCertificationItems = $context.$variables.ReqCertificationItems || [];\nlet requisitionData = $context.$variables.requisitionData || {};\nlet jobApplicationData = $context.$variables.jobapplicationData || {};\n\nlet isInternal = jobApplicationData.InternalFlag === true;\n\nlet skillData = requisitionData.skills?.items || [];\n\n// Skills\nlet skillsList = skillData.map(skill => ({\n    Skill: skill.Skills || 'N/A',\n    MinYearsExp: skill.MinimumYearsOfExperience || 'N/A',\n    Required: skill.RequiredFlag != null \n        ? (skill.RequiredFlag ? 'Yes' : 'No') \n        : 'N/A'\n}));\n\n// Certifications\nlet certificationsList = reqCertificationItems.map(cert => ({\n    LicenseOrCertificate: cert.LicenseOrCertificate || 'N/A',\n    CertificateNumber: cert.CertificateNumber || 'N/A'\n}));\nlet workPreferenceItems =\n  reqWorkRequirements?.[0]?.workPreferenceItems?.items || [];\n// Work requirements\nlet workPreferences = workPreferenceItems.map(item => ({\n    WillingToRelocate: item.WillingToRelocate != null \n        ? (item.WillingToRelocate ? 'Yes' : 'No') \n        : 'N/A',\n    TravelInternationally: item.TravelInternationally != null \n        ? (item.TravelInternationally ? 'Yes' : 'No') \n        : 'N/A',\n    TravelDomestically: item.TravelDomestically != null \n        ? (item.TravelDomestically ? 'Yes' : 'No') \n        : 'N/A',\n    WorkFlexibleSchedule: item.WorkFlexibleSchedule != null \n        ? (item.WorkFlexibleSchedule ? 'Yes' : 'No') \n        : 'N/A'\n}));\n\n// Description selection\nlet responsibility = isInternal \n    ? requisitionData.InternalRespStr \n    : requisitionData.ExternalRespStr;\n\nlet qualifications = isInternal \n    ? requisitionData.InternalQualStr \n    : requisitionData.ExternalQualStr;\n\nlet description = isInternal \n    ? requisitionData.InternalDescription \n    : requisitionData.ExternalDescription;\n\n// Final object\nlet resultObject = {\n    responsibility: responsibility || 'N/A',\n    qualifications: qualifications || 'N/A',\n    jobDescription: description || null,\n    jobRequiredSkills: skillsList,\n    jobWorkRequirements: workPreferences,\n    jobRequiredCertifications: certificationsList\n};\n\nreturn resultObject;"
                  },
                  "outcomes": {
