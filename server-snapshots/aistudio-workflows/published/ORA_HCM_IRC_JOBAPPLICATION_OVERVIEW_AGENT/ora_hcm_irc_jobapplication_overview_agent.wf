                {
                  "metadata": {
                    "name": "FindLatestResumeId",
                    "returnType": "number",
                    "sourceCode": "const applicationData = $context.$variables.jobapplicationData;\n\nconst attachments = applicationData?.attachments?.items || [];\n\nconst RESUME_CATEGORY = \"IRC_CANDIDATE_RESUME\";\n\n// Filter only resume attachments\nconst resumeAttachments = attachments.filter(att =>\n    att.CategoryName === RESUME_CATEGORY\n);\n\n// Sort newest first\nresumeAttachments.sort((a, b) =>\n    new Date(b.LastUpdateDate || b.CreationDate) -\n    new Date(a.LastUpdateDate || a.CreationDate)\n);\n\n// Return the latest AttachedDocumentId\nconst latestResume = resumeAttachments[0] || null;\nconst latestResumeDocumentId = latestResume?.AttachedDocumentId || -1;\n\nreturn latestResumeDocumentId;"
                  },
                  "outcomes": {
                    "success": "1763418036167"
                  },
                  "code": "FINDLATESTRESUMEID",
                  "convergenceTargetId": "1763418036167",
                  "id": "1770273659860",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE",
                  "diagram": {
                    "x": 6841.5,
                    "y": 6779
                  }
