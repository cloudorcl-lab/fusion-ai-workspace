            "name": "Error if not unique",
            "returnType": "string",
            "sourceCode": "if ($context.$nodes.CHECK_IF_AGENT_CODE_EXISTS.$output && $context.$nodes.CHECK_IF_AGENT_CODE_EXISTS.$output.items && $context.$nodes.CHECK_IF_AGENT_CODE_EXISTS.$output.items.length) {\n  throw new Error(\"error code not unique.\");\n}"
          },
