          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Create Final Response Input",
            "returnType": "object",
            "sourceCode": "var answerType = $context.$nodes.INTENT_CLASSIFIER.$output.answerType;\nvar summarizationObject = $context.$nodes.CREATE_SUMMARIZATION_OBJECT.$output.result;\n\nvar answer = null;\nvar ragSeed = null;\nif (summarizationObject){\n  answer = summarizationObject.answer;\n  ragSeed = summarizationObject.ragSeed || null;\n}\n\nvar ragEnabled = summarizationObject.ragEnabled === true\nvar ragContext = null;\nvar ragCitations = [];\nif (ragEnabled === true && $context.$nodes.OTM_RAG.$output) {\n  ragContext = $context.$nodes.OTM_RAG.$output.value || null;\n  ragCitations = $context.$nodes.OTM_RAG.$output.citations || [];\n}\n\nvar debug = {\n  ragSeed: typeof ragSeed,\n  ragContextType: typeof ragContext,\n  ragCitationsType: typeof ragCitations\n};\n\nvar result = {\n  answerType: answerType,\n  answer: answer,\n  ragSeed: ragSeed,\n  ragEnabled: ragEnabled,\n  ragContext: ragContext,\n  ragCitations: ragCitations,\n  debug: debug\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1768914252719"
          },
          "code": "CREATE_FINAL_RESPONSE_INPUT",
          "convergenceTargetId": "1768914252719",
          "id": "1769241615691",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Create Summarization Object",
            "returnType": "object",
            "sourceCode": "var answerType = $context.$nodes.INTENT_CLASSIFIER.$output.answerType;\nvar qaNode = $context.$nodes.TEXT_SUMMARIZATION?.$output || null;\nvar reportNode = $context.$nodes.REPORT_SUMMARIZATION.$output || null;\nvar ragSeedNode = $context.$nodes.RAG_SEED_GENERATOR.$output || null;\nvar useRag = $context.$variables.useRag ;\n\nvar answer = null;\nvar ragSeed = null;\nvar ragEnabled = false;\nvar debug = {\n  answerType: answerType,\n  qaNodeType: typeof qaNode,\n  reportNodeType: typeof reportNode,\n  ragSeedNodeType: typeof ragSeedNode\n};\n\nif (answerType === \"QA\" && qaNode) {\n  answer = qaNode.answer || null;\n  ragSeed = qaNode.rag_seed || null;\n  ragEnabled = ragSeed !== null;\n\n  debug.qaAnswerType = typeof answer;\n  debug.qaRagSeedType = typeof ragSeed;\n}\n\nif (answerType === \"REPORT\" && reportNode) {\n  answer = reportNode || null;\n\n  if (ragSeedNode && ragSeedNode.ragSeed) {\n    ragSeed = ragSeedNode.ragSeed;\n  }\n\n  ragEnabled = ragSeed !== null;\n  debug.reportAnswerType = typeof answer;\n  debug.reportRagSeedType = typeof ragSeed;\n}\n\nvar result =  {\n  answerType: answerType,\n  answer: answer,\n  ragSeed: ragSeed,\n  ragEnabled: ragEnabled && useRag,\n  debugTypes: debug\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1768914023048"
          },
