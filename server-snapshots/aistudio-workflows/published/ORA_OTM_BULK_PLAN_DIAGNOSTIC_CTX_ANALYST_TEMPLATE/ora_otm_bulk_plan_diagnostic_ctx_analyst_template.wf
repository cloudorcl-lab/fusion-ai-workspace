        {
          "metadata": {
            "name": "Merge Data Pipeline Results",
            "returnType": "object",
            "sourceCode": "var isFollowUp = $context.$nodes.INTENT_CLASSIFIER.$output.isFollowUp === true;\nvar prevState = $context.$variables.conversationState || {};\nvar prevModel = prevState.lastModelData || {};\n\n// Start from previous semantic model if follow-up, else fresh\nvar modelData = isFollowUp ? JSON.parse(JSON.stringify(prevModel)) : {};\nvar incremental = $context.$nodes.DETERMINE_INCREMENTAL_DATA_NEEDS.$output.result.incrementalDataNeeds || {};\n\nvar resultsList = $context.$nodes.EXECUTE_DATA_PIPELINES.$output || [];\nfor (var i = 0; i < resultsList.length; i++) {\n  var envelope = resultsList[i];\n  var itemParent;\n\n  try {\n    // Handle both string and object envelopes\n    itemParent = (typeof envelope === \"string\") ? JSON.parse(envelope) : envelope;\n  } catch (err) {\n    // Skip malformed entry\n    continue;\n  }\n\n  if (!itemParent || !itemParent.result) continue;\n\n  var item = itemParent.result;\n  if (!item || !item.taskId) continue;\n\n  switch (item.taskId) {\n    case \"SUMMARY\":\n      modelData.summaryMetrics = item.summaryMetrics;\n      if (item.isRootNodeRequired === true) {\n        modelData.diagnosticRootData = item.diagnosticRootData;\n        modelData.expandedTruncatedNodes = item.expandedTruncatedNodes;\n      }\n      break;\n\n    case \"FAILURE\":\n      modelData.failureTreeData = item.failureTreeData;\n      modelData.dominantFailedPaths = item.dominantFailedPaths;\n      modelData.expandedDominantFailedNodes = item.expandedDominantFailedNodes;\n      break;\n\n    case \"MULTISTOP\":\n      modelData.multistopData = item.multistopData;\n      break;\n\n    case \"ENTITY\":\n      modelData.entityImpact = {\n        entity: item.entity,\n        failureTreeData: item.failureTreeData,\n        dominantFailedPaths: item.dominantFailedPaths,\n        expandedDominantFailedNodes: item.expandedDominantFailedNodes\n      };\n      break;\n\n    case \"PROCESS\":\n      modelData.processImpact = {\n        processType: item.processType,\n        failureTreeData: item.failureTreeData,\n        dominantFailedPaths: item.dominantFailedPaths,\n        expandedDominantFailedNodes: item.expandedDominantFailedNodes\n      };\n      break;\n\n    case \"TUNING\":\n      modelData.tuningRecommendations = item.tuningRecommendations;\n      break;\n  }\n}\n\nif (modelData.dominantFailedPaths && !modelData.failureTreeData) {\n  modelData.failureTreeData = prevModel.failureTreeData || null;\n}\n\nif (isFollowUp && !incremental.needFailureTree && !incremental.needDominantFailurePaths) {\n  modelData.failureTreeData = prevModel.failureTreeData;\n  modelData.dominantFailedPaths = prevModel.dominantFailedPaths;\n  modelData.expandedDominantFailedNodes = prevModel.expandedDominantFailedNodes;\n}\n\nvar merged = {\n  modelData: modelData,\n  diagnosticViewFlow: $context.$nodes.INTENT_CLASSIFIER.$output.diagnosticViewFlow,\n  primaryMode: $context.$nodes.INTENT_CLASSIFIER.$output.primaryMode,\n  modes: $context.$nodes.INTENT_CLASSIFIER.$output.modes,\n  focus: $context.$nodes.INTENT_CLASSIFIER.$output.focus,\n  entityQuery: $context.$nodes.INTENT_CLASSIFIER.$output.entityQuery,\n  processQuery: $context.$nodes.INTENT_CLASSIFIER.$output.processQuery,\n  incrementalDataNeeds: incremental\n};\n\nreturn merged;"
          },
