        {
          "metadata": {
            "name": "Identify Dataset Availability",
            "returnType": "object",
            "sourceCode": "var datasetPresence = {\n    hasSummaryMetrics: false,\n    hasFailureTreeData: false,\n    hasDominantFailedPaths: false,\n    hasEntityImpact: false,\n    hasProcessImpact: false,\n    hasMultistopData: false\n};\n\ntry {\n\n    var conversationState = $context.$variables.conversationState || {};\n    var lastModelData = conversationState.lastModelData || {};\n    var datasets = {\n        summaryMetrics: \"hasSummaryMetrics\",\n        failureTreeData: \"hasFailureTreeData\",\n        dominantFailedPaths: \"hasDominantFailedPaths\",\n        entityImpact: \"hasEntityImpact\",\n        processImpact: \"hasProcessImpact\",\n        multistopData: \"hasMultistopData\"\n    };\n\n    for (var key in datasets) {\n        var value = lastModelData[key];\n        var available =\n            value &&\n            !(Array.isArray(value) && value.length === 0) &&\n            !(typeof value === \"object\" && !Array.isArray(value) && Object.keys(value).length === 0);\n\n        datasetPresence[datasets[key]] = !!available;\n    }\n\n} catch (e) {\n    // keep defaults false\n}\n\nvar result = {\n    datasetPresence: datasetPresence\n};\nreturn result;"
          },
          "outcomes": {
            "success": "1773251403810"
          },
          "code": "IDENTIFY_DATASET_AVAILABILITY",
