":{\"value\":{\"type\":\"number\"},\"unit\":{\"type\":\"string\"}}},\n\"totalActualCost\":{\"type\":\"object\",\"properties\":{\"value\":{\"type\":\"number\"},\"currency\":{\"type\":\"string\"}}},\n\"numOfWaCreated\":{\"type\":\"number\"},\n\"numOrderMovementsCreated\":{\"type\":\"integer\"},\n\"processEndTime\":{\"type\":\"object\",\"properties\":{\"value\":{\"type\":\"string\",\"format\":\"date-time\"}}},\n\"plannedCo2Emission\":{\"type\":\"object\",\"properties\":{\"value\":{\"type\":\"number\"},\"unit\":{\"type\":\"string\"}}},\n\"plannedCo2eEmission\":{\"type\":\"object\",\"properties\":{\"value\":{\"type\":\"number\"},\"unit\":{\"type\":\"string\"}}},\n\"updateDate\":{\"type\":\"object\",\"properties\":{\"value\":{\"type\":\"string\",\"format\":\"date-time\"}}},\n\"insertDate\":{\"type\":\"object\",\"properties\":{\"value\":{\"type\":\"string\",\"format\":\"date-time\"}}},\n\"byModes\":{\"type\":\"object\",\"properties\":{\"links\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/definitions/link\"}}}},\n\"serviceProviders\":{\"type\":\"object\",\"properties\":{\"links\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/definitions/link\"}}}},\n\"links\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/definitions/link\"}}\n},\n\"definitions\":{\n\"link\":{\"type\":\"object\",\"properties\":{\"rel\":{\"type\":\"string\"},\"href\":{\"type\":\"string\"}}}\n}\n}"
