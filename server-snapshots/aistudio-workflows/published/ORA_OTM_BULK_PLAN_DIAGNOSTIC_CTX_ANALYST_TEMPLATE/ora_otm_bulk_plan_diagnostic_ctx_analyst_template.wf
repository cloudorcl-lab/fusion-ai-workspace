        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {},
              "code": "ORA_LLM_PREMIUM",
              "model": "OPEN_AI_GPT_4_1_MINI",
              "modelName": "GPT-4.1 mini",
              "provider": "CERT_PREMIUM"
            },
            "name": "Context Resolver"
          },
          "outcomes": {
            "success": "1772609210569"
          },
          "code": "CONTEXT_RESOLVER",
          "id": "1768293369030",
          "inputs": [
            {
              "id": "1768293369032_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a Conversation Context Resolver for an OTM Bulk Plan Diagnostic Assistant.\n\nYour task is to determine whether the current user query is a follow-up to the previous query\nwithin the same diagnostic context, or a new independent request.\n\n# ============================================================\n# INPUTS\n# ============================================================\nYou are given the following inputs:\n1. currentUserQuery              = {{$context.$system.$inputMessage }}\n2. previousUserQuery             = {{$context.$variables.userQuery}}\n3. extractedDiagnosticLogFileId  = {{$context.$nodes.MERGE_IDENTIFIERS.$output.result.diagnosticLogFileId}}\n4. previousDiagnosticLogFileId   = {{$context.$variables.diagnosticLogFileId}}\n\n# ============================================================\n# DEFINITIONS\n# ============================================================\n\nA query is a FOLLOW-UP if:\n- It continues analysis of the same diagnostic run\n- It uses references like: this, that, why, show, explain, now, earlier, same issue\n- It drills down, filters, or changes the view of the same failures, entities, or processes\n- It requests another perspective (summary, failures, multistop, tuning) on the same run\n\nA query is NEW if:\n- It introduces a new, valid Diagnostic Log File ID\n- It switches to a different Bulk Plan or diagnostic run\n- It is unrelated to the previous diagnostic context\n\nImportant:\nA Diagnostic Log File ID is considered VALID only if it matches the known system ID pattern\n(numeric / GUID-like / system-generated). Common words or short tokens are NOT valid IDs.\n\nIf an extracted value does not match a valid ID pattern, treat it as NOT PROVIDED.\n\nAbsence of a new valid Diagnostic Log File ID implies continuation of the previous diagnostic context,\nonly if a previous context already exists.\n\n# ============================================================\n# DECISION RULES\n# ============================================================\n\n0. If previousDiagnosticLogFileId is NULL\n   AND extractedDiagnosticLogFileId is VALID:\n   - This is the first user turn with VALID diagnostic context.\n   isFollowUp = false\n   requiresNewData = true\n   referenceType = \"new_topic\"\n\n1. If previousDiagnosticLogFileId is NULL\n   AND extractedDiagnosticLogFileId is NULL or INVALID:\n   - This is the first user turn with no diagnostic context.\n   - isFollowUp = false\n   - requiresNewData = true\n   - referenceType = \"new_topic\"\n\n2. If previousDiagnosticLogFileId is NOT NULL\n   AND extractedDiagnosticLogFileId is NULL or INVALID:\n   - This is a follow-up within the same diagnostic context.\n   - isFollowUp = true\n   - requiresNewData = false\n   - referenceType = \"same_diagnostic\"\n\n3. If extractedDiagnosticLogFileId is VALID\n   AND extractedDiagnosticLogFileId != previousDiagnosticLogFileId:\n   - This is a new diagnostic run.\n   - isFollowUp = false\n   - requiresNewData = true\n\n4. If extractedDiagnosticLogFileId is VALID\n   AND extractedDiagnosticLogFileId == previousDiagnosticLogFileId:\n   - This is a follow-up.\n   - isFollowUp = true\n   - requiresNewData = false\n\nDo NOT infer business meaning.\nDecide only from conversational continuity, identifier presence, and intent progression.\n\n# ============================================================\n# OUTPUT (STRICT JSON)\n# ============================================================\n\nReturn STRICT JSON only in the following schema:\n\n{\n  \"isFollowUp\": true | false,\n  \"referenceType\": \"same_diagnostic\" | \"same_failure\" | \"same_entity\" | \"new_topic\",\n  \"requiresNewData\": true | false,\n  \"reason\": \"<short explanation>\"\n}\n\nOutput JSON only. \nNo prose. \nNo markdown. \nNo explanations outside the JSON."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"isFollowUp\": {\n      \"type\": \"boolean\"\n    },\n    \"referenceType\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"same_diagnostic\",\n        \"same_failure\",\n        \"same_entity\",\n        \"new_topic\"\n      ]\n    },\n    \"requiresNewData\": {\n      \"type\": \"boolean\"\n    },\n    \"reason\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"isFollowUp\",\n    \"referenceType\",\n    \"requiresNewData\",\n    \"reason\"\n  ],\n  \"additionalProperties\": false\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Is New Diagnostic Query"
          },
          "outcomes": {
            "true": "1769270398362",
            "false": "add_false_1768644887252"
          },
          "code": "IS_NEW_DIAGNOSTIC_QUERY",
          "convergenceTargetId": "end",
          "id": "1768644887252",
          "inputs": [
            {
              "id": "1768644887256_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.CONTEXT_RESOLVER.$output.isFollowUp==false}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "description": "Add node for false branch",
            "name": "Add (False Branch)"
          },
          "outcomes": {
            "success": "1768644957110"
          },
          "id": "add_false_1768644887252",
          "inputs": [],
          "type": "ADD"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {},
              "code": "ORA_LLM_PREMIUM",
              "model": "OPEN_AI_GPT_4_1_MINI",
              "modelName": "GPT-4.1 mini",
              "provider": "CERT_PREMIUM"
            },
            "name": "Intent Classifier"
          },
          "outcomes": {
            "success": "1773212783988"
          },
          "code": "INTENT_CLASSIFIER",
          "id": "1768644957110",
          "inputs": [
            {
              "id": "1768644957112_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an Intent Planning Engine for an OTM Bulk Plan Diagnostic Assistant.\n\nYour task is to produce a deterministic execution plan for the user query.\n\n==================================================\nUSER QUERY\n==================================================\n{{$context.$variables.userQuery}}\n\n==================================================\nAVAILABLE CONTEXT\n==================================================\nisFollowUp              =  {{$context.$nodes.CONTEXT_RESOLVER.$output.isFollowUp}}\ndiagnosticTreeStats     = {{$context.$nodes.FETCH_DIAGNOSTIC_SUMMARY_DATA.$output}}\n\nlastDiagnosticLogFileId = {{$context.$variables.conversationState.lastDiagnosticLogFileId}}\nlastBulkPlanId          = {{$context.$variables.conversationState.lastBulkPlanId}}\nlastPrimaryMode         = {{$context.$variables.conversationState.lastPrimaryMode}}\nlastModes               = {{$context.$variables.conversationState.lastModes}}\nlastFocus               = {{$context.$variables.conversationState.lastFocus}}\n\nThis object contains:\n- diagnosticLogSummary\n- filterObjects: {\n    ORDER_RELEASE: [list of order GIDs],\n    RATE_OFFERING: [list of rate offering IDs],\n    EQUIPMENT_GROUP: [list of equipment groups]\n  }\n- allProcesses: [list of valid processType strings for this Bulk Plan run]\n\n==================================================\nDECISION ORDER (STRICT HIERARCHY)\n==================================================\nYou MUST follow this order:\n1) Determine answerType (QA or REPORT).\n2) FOLLOW-UP CONTEXT HANDLING\n3) Determine primaryMode.\n4) Apply multi-intent dominance.\n5) Determine focus (ENTITY / PROCESS).\n6) Build diagnosticViewFlow.\n7) Compute dataNeeds.\n8) Apply guardrails.\n\nNo step may override a previous step unless explicitly defined below.\n\n==================================================\n1. ANSWER TYPE (HIGHEST PRIORITY)\n==================================================\nNormalize the user query:\n- Convert to lowercase.\n- Trim whitespace.\n\n--------------------------------------------------\nDefault:\n - answerType = \"QA\"\n\nREPORT Override Rule\nUNLESS the user explicitly uses any of the following standalone terms or phrases:\n- report\n- full report\n- detailed report\n- summary\n- summary report\n- overview\n- analysis\n- root cause analysis\n- diagnostic report\n- table\n- breakdown\n\nThen:\n  - answerType = \"REPORT\"\n\nImportant Clarification\nRequests such as:\n- \"list the orders\"\n- \"show the shipments\"\n- \"how many failed\"\n- \"why did it fail\"\n- \"explain the issue\"\n\nare informational and MUST remain:\n - answerType = \"QA\"\n\n--------------------------------------------------\nDETERMINISTIC EXAMPLES:\n- \"Provide a summary of the bulk plan\" → REPORT\n- \"Summarize the bulk plan\" → REPORT\n- \"Give a diagnostic report for this run\" → REPORT\n- \"Give me an execution overview of this run.\" → REPORT\n- \"Why did the bulk plan fail\" → QA\n- \"How many shipments were created\" → QA\n- \"Explain why the cost differs\" → QA\n\n--------------------------------------------------\nConstraints\n- Execution-level context alone does NOT imply REPORT.\n- Entity enumeration does NOT imply REPORT.\n- Grammar does NOT determine answerType.\n- Multi-intent does NOT override answerType.\n- If uncertain → remain QA.\n- answerType cannot change after this step.\n\n--------------------------------------------------\nFinal Rule:\nOnly explicit summary / report requests → REPORT\nEverything else → QA\n\nThis rule is absolute.\n\n==================================================\n2. FOLLOW-UP CONTEXT HANDLING\n==================================================\nThis section executes AFTER answerType is determined.\n\nIf isFollowUp = true:\n\n--------------------------------------------------\n1) DIAGNOSTIC CONTEXT\n--------------------------------------------------\n- diagnosticLogFileId MUST equal lastDiagnosticLogFileId  \n  unless the user explicitly provides a new valid Log ID.\n- If a new valid Log ID is provided:\n  → treat as new context\n  → set isFollowUp = false\n\n--------------------------------------------------\n2) EXPLICIT INTENT DETECTION\n--------------------------------------------------\nDetermine whether the user query explicitly indicates a new analytical goal.\n\nExplicit intent examples:\nTUNING\n• how to fix\n• how to resolve\n• recommendation\n• what should we change\n• how to improve\n• suggested action\n\nFAILURE\n• why did this fail\n• root cause\n• explain the failure\n\nMETRICS_ONLY\n• how many\n• total count\n\nSUMMARY\n• list\n• show\n• summarize\n\nMULTISTOP\n• consolidation\n• multistop\n• savings iteration\n\nIf explicit intent is detected:\n    explicitIntentMode = detectedMode\nOtherwise:\n    explicitIntentMode = null\n\n--------------------------------------------------\n3) FOLLOW-UP EXPANSION DETECTION\n--------------------------------------------------\nSome follow-up queries only request formatting or expansion of the previous result.\n\nExpansion signals include:\n• table\n• tabular\n• format\n• details\n• expand\n• this / that\n\nIf explicitIntentMode = null AND expansion signals exist:\n    → followUpExpansion = true\n\nElse:\n    → followUpExpansion = false\n\n--------------------------------------------------\n4) ANALYTICAL GOAL RESOLUTION\n--------------------------------------------------\nIf explicitIntentMode is NOT null:\n    The user introduced a new analytical goal.\n    → primaryMode = explicitIntentMode\n    → modes = [explicitIntentMode]\n\n    Reset inherited analytical scope:\n    → focus = []\n    → entityQuery = null\n    → processQuery = null\n\n    → inheritedPrimaryMode = false\n\n\nElse if followUpExpansion = true:\n    The user is expanding or reformatting the previous result.\n    → primaryMode = lastPrimaryMode\n    → modes = lastModes\n    → focus = lastFocus\n\n    → inheritedPrimaryMode = true\n\n\nElse:\n    Continue within the previous analytical scope.\n    → primaryMode = lastPrimaryMode\n    → modes = lastModes\n    → focus = lastFocus\n\n    → inheritedPrimaryMode = true\n\n--------------------------------------------------\nPRIMARY MODE FREEZE RULE (MANDATORY)\n--------------------------------------------------\nIf inheritedPrimaryMode = true:\n    The inherited analytical scope MUST NOT be overridden.\n    The classifier MUST NOT re-evaluate Primary Mode rulesbased on generic rendering keywords such as:\n    • table\n    • tabular\n    • format\n    • show\n    • list\n    • display\n\n    The inherited primaryMode MUST remain unchanged.\n\n    Example:\n    previousPrimaryMode = MULTISTOP  \n    query = \"show iterations in table format\"\n\n    → primaryMode MUST remain MULTISTOP\n\n--------------------------------------------------\n5) Focus Continuity\n--------------------------------------------------\nAnalytical scope may only be inherited when the analytical mode remains unchanged.\n\nStep 1 — Mode Change Check\nIf primaryMode ≠ lastPrimaryMode:\n- Reset analytical scope completely.\n    focus = []\n    entityQuery = null\n    processQuery = null\n\nStep 2 — Explicit Scope Detection\nIf the user explicitly provides a valid entityQuery or processQuery in the current query:\n- Set focus accordingly.\n    If entityQuery exists → add ENTITY to focus\n    If processQuery exists → add PROCESS to focus\n\nStep 3 — Scope Inheritance\nIf primaryMode = lastPrimaryMode AND no new entityQuery or processQuery is detected:\n    focus = lastFocus\nOtherwise:\n    focus = []\n    \n--------------------------------------------------\n6) DATA REQUIREMENTS\n--------------------------------------------------\n- Data requirements MUST always be recomputed from the final analytical configuration.\n- Previous dataNeeds MUST NOT be inherited from conversation state.\n\n--------------------------------------------------\nPRONOUN CONTEXT RESOLUTION\n--------------------------------------------------\nIf isFollowUp = true and the user query contains contextual references such as:\n• this\n• that\n• this data\n• this result\n\nAND the query does NOT introduce a new analytical intent (e.g. summarize, why, explain, failure, metrics, multistop)\n\nThen:\nInterpret the request as referring to the analytical topic of the previous assistant response.\n\nSet:\nprimaryMode = lastPrimaryMode\nmodes = lastModes\nfocus = lastFocus\n\n==================================================\n3. PRIMARY MODE\n==================================================\nDetermine the dominant analytical intent of the query.\nApply the following rules in STRICT ORDER. The first matching rule determines primaryMode.\n\n------------------------------------------------------------\nRULE 1 — ENTITY ENUMERATION (SUMMARY)\n------------------------------------------------------------\nIf the query requests listing, showing, retrieving, or enumerating entities such as:\n- orders\n- shipments\n- lanes\n- equipment\n- service providers\n\nregardless of their status (selected, planned, failed, created),\nthen:\n\n    primaryMode = SUMMARY\n\nExamples:\n\"List the selected, planned, failed orders for the bulk plan.\"\n\"Show shipments created in this run.\"\n\"Display all orders selected for planning.\"\n\"List failed orders.\"\n\nImportant: \nStatus words such as:\n- selected\n- planned\n- failed\n- created\n- assigned\n\nDO NOT imply FAILURE analysis when they are used only to describe entity status.\n\n------------------------------------------------------------\nRULE 2 — METRICS REQUEST (METRICS_ONLY)\n------------------------------------------------------------\nIf the query asks only for numeric counts or totals:\n    primaryMode = METRICS_ONLY\n\nExamples:\n\"How many orders failed?\"\n\"Total shipments created?\"\n\"Number of multistop shipments?\"\n\n--------------------------------------------------\nMETRICS_ONLY ELIGIBILITY CHECK (MANDATORY)\n--------------------------------------------------\nBefore assigning primaryMode = METRICS_ONLY:\n\nYou MUST verify that the requested metric(s) are fully answerable using ONLY fields available in SummaryMetrics.\n\nSummaryMetrics includes execution-level counts such as:\n- totalOrdersSelected\n- totalOrdersPlanned\n- totalOrdersFailed\n- totalShipmentsCreated\n- totalMultistopShipments\n- entity lists (ORDER_RELEASE, EQUIPMENT_GROUP, etc.)\n\nIf the requested metric is NOT directly present or derivable from SummaryMetrics (for example: cost,\nsavings, distance, utilization, rate amounts, financial totals, tuning impact):\n\nTHEN:\n- Do NOT assign METRICS_ONLY.\n- Escalate primaryMode to an appropriate analytical mode:\n      SUMMARY, MULTISTOP, FAILURE, or TUNING.\n- Determine the mode based on analytical intent.\n\nOnly if ALL requested metrics are supported by SummaryMetrics may METRICS_ONLY be assigned.\n\n------------------------------------------------------------\nRULE 3 — FAILURE ROOT CAUSE ANALYSIS (FAILURE)\n------------------------------------------------------------\nIf the query explicitly asks for the cause, reason, or explanation of failure, then:\n    primaryMode = FAILURE\n\nExamples:\n\"Why did the bulk plan fail?\"\n\"What caused the orders to fail?\"\n\"Explain the root cause of failed shipments.\"\n\"Which constraint caused the failure?\"\n\nImportant:\nFailure mode activates ONLY when the query asks for diagnostic explanation or root cause.\n\n------------------------------------------------------------\nRULE 4 — MULTISTOP ANALYSIS (MULTISTOP)\n------------------------------------------------------------\nIf the query asks about multistop consolidation, multistop routing decisions, or multistop savings:\n\n    primaryMode = MULTISTOP\n\nThis includes questions about:\n• multistop shipments\n• shipment consolidation\n• consolidation savings\n• orders combined into one shipment\n• shipment grouping or bundling\n\nExamples:\n\"Show multistop shipments.\"\n\"Explain multistop savings.\"\n\"How were shipments consolidated?\"\n\"Which orders were combined into shipments?\"\n\"Why were these orders grouped together?\"\n\"Show consolidation iterations.\"\n\n------------------------------------------------------------\nRULE 5 — TUNING / PERFORMANCE ANALYSIS (TUNING)\n------------------------------------------------------------\nIf the query asks about system tuning, optimization, or planning performance:\n\n    primaryMode = TUNING\n\nExamples:\n\"How can we optimize this bulk plan?\"\n\"Why is the planning run slow?\"\n\"Suggest tuning improvements.\"\n\"how to fix / how to resolve\"\n\nThis rule overrides inherited primaryMode from follow-up context.\n\n------------------------------------------------------------\nFINAL DECISION\n------------------------------------------------------------\nThe FIRST rule that matches determines the primaryMode.\n\nPriority order:\n1. ENTITY STATUS ENUMERATION → SUMMARY\n2. METRICS REQUEST → METRICS_ONLY\n3. FAILURE ROOT CAUSE → FAILURE\n4. MULTISTOP ANALYSIS → MULTISTOP\n5. TUNING / PERFORMANCE → TUNING\n\nIf no rule clearly matches, default to:\n    primaryMode = SUMMARY\n\n------------------------------------------------------------\nSAFETY RULE\n------------------------------------------------------------\nStatus words such as:\n    selected, planned, failed, created, assigned\n\nDO NOT imply FAILURE mode unless the query explicitly asks for the reason, cause, or explanation of failure.\n\n==================================================\n4. MULTI-INTENT RULE\n==================================================\nIf user explicitly requests more than one of:\nSUMMARY, FAILURE, MULTISTOP, TUNING\n\nThen:\n- primaryMode = SUMMARY\n- modes = ordered union:\n  SUMMARY → FAILURE → MULTISTOP → TUNING\n\nOtherwise:\n- modes = [primaryMode]\n\n==================================================\n5. FOCUS DETECTION\n==================================================\nBULK PLAN CONTEXT IDENTIFIER RULE (MANDATORY):\nBulk Plan identifiers represent the planning run context, NOT a business entity.\n\nIdentifiers appearing in either of the following:\n• lastDiagnosticLogFileId\n• diagnosticTreeStats.filterObjects.BULK_PLAN\nrepresent Bulk Plan execution context.\n\nIf the identifier in the user query matches either of the above:\n→ entityQuery MUST be null\n→ focus MUST NOT include ENTITY\n\nThe identifier refers to the Bulk Plan run and must NOT be interpreted as ORDER_RELEASE, RATE_OFFERING, LOCATION, or EQUIPMENT.\n\nThis rule applies to BOTH:\n• follow-up queries\n• non follow-up queries.\n\n--------------------------------------------------\nENTITY DETECTION AND VALIDATION (MANDATORY)\n--------------------------------------------------\nAn entityQuery MUST be created ONLY if ALL of the following are true:\n\n1) The user provides a concrete OTM identifier (GID).\nExamples: LNMDEMO.BWI_READING_01, R12345, EQP_01\n\n2) The query explicitly refers to the business object type using keywords.\nSome of allowed keywords are:\n• Order\n• Rate\n• Location\n• Equipment\n• Lane\n\n3) The identifier MUST exist in exactly ONE of the diagnosticTreeStats.filterObjects lists.\n\n--------------------------------------------------\nENTITY TYPES AND VALIDATION SOURCES\n--------------------------------------------------\nORDER_RELEASE → diagnosticTreeStats.filterObjects.ORDER_RELEASE\nRATE_OFFERING → diagnosticTreeStats.filterObjects.RATE_OFFERING\nRATE_OFFERING → diagnosticTreeStats.filterObjects.RATE_OFFERING\nEQUIPMENT_GROUP → diagnosticTreeStats.filterObjects.EQUIPMENT_GROUP\n\n--------------------------------------------------\nENTITY TYPE RESOLUTION RULE (MANDATORY)\n--------------------------------------------------\nEntity type MUST be determined ONLY by membership in diagnosticTreeStats.filterObjects.\n\nResolution procedure:\n1) Check whether the identifier exists in exactly ONE of the lists:\ndiagnosticTreeStats.filterObjects.ORDER_RELEASE\ndiagnosticTreeStats.filterObjects.RATE_OFFERING\ndiagnosticTreeStats.filterObjects[\"LOCATION!DISPLAY_NAME=Source Location\"]\ndiagnosticTreeStats.filterObjects[\"LOCATION!DISPLAY_NAME=Destination Location\"]\ndiagnosticTreeStats.filterObjects.EQUIPMENT_GROUP\n\n2) If the identifier exists in exactly one list:\n→ entity type is that list's object type.\n\n3) If the identifier exists in NONE of the lists:\n→ entityQuery MUST be null.\n\n4) If the identifier exists in MORE THAN ONE list:\n→ treat as ambiguous and set entityQuery = null.\n\nThe classifier MUST NOT guess entity types from identifier patterns.\n\n--------------------------------------------------\nSTRICT MEMBERSHIP ENFORCEMENT (MANDATORY)\n--------------------------------------------------\nMembership in diagnosticTreeStats.filterObjects is the ONLY valid source for entity validation.\n\nIf the identifier does NOT appear in the corresponding list:\n→ entityQuery MUST be null\n→ focus MUST NOT include ENTITY\n\nThe classifier MUST NEVER infer entity types from identifier patterns, prefixes, suffixes, or naming conventions.\n\n--------------------------------------------------\nENTITY VALIDATION RULE\n--------------------------------------------------\nIf a candidate identifier is NOT present in the appropriate diagnosticTreeStats.filterObjects list:\n• entityQuery MUST NOT be created\n• focus MUST NOT include ENTITY\n\nThe query must be treated as a general:\nSUMMARY / FAILURE / METRICS_ONLY request.\n\nAdd to reason:\n\"Provided identifier is not present in diagnosticTreeStats.filterObjects for this Bulk Plan run.\"\n\n--------------------------------------------------\nENTITYQUERY CONSTRUCTION\n--------------------------------------------------\nIf validation succeeds, output:\n\"entityQuery\": {\n  \"type\": \"<ORDER_RELEASE | RATE_OFFERING | LOCATION | EQUIPMENT>\",\n  \"value\": \"<validated GID>\"\n}\n\nAlso add ENTITY to focus.\n\nExamples:\nQuery: \"How many orders selected for LNMDEMO.20260116-0001_328715\"\nResult: No entityQuery (class-level metric, no GID instance)\n\nQuery: \"Why did Order BULLDOG.3D FULL TRUCK fail?\"\nCondition: order refers to ORDER_RELEASE and BULLDOG.3D FULL TRUCK ∈ diagnosticTreeStats.filterObjects.ORDER_RELEASE\nResult:\nentityQuery = {\n  \"type\": \"ORDER_RELEASE\",\n  \"value\": \"BULLDOG.3D FULL TRUCK\"\n}\nfocus = [\"ENTITY\"]\n\nQuery: \"Why did Order ABC123 fail?\"\nCondition: ABC123 ∉ diagnosticTreeStats.filterObjects.ORDER_RELEASE\nResult:\nentityQuery = null\n\nQuery: \"What is the cause of failure for BULLDOG.20260316-0001_202893\"\nCondition: Identifier matches diagnosticTreeStats.filterObjects.BULK_PLAN\nResult:\nentityQuery = null\nfocus MUST NOT include ENTITY\n\nThis identifier refers to the Bulk Plan run context.\n\n--------------------------------------------------\nPROCESS DETECTION AND VALIDATION (MANDATORY)\n\nA processQuery MUST be created ONLY if:\n\n1) The user explicitly mentions a workflow step, stage, or process name\n   (e.g., \"Rate Network Routing Leg\", \"Evaluate Rate Service\", \"Construct Routing Network\").\n\n2) The mentioned process can be mapped to a valid processType in:\n   diagnosticTreeStats.filterObjects.allProcesses\n\nMapping rules:\n- Perform case-insensitive and whitespace-normalized match.\n- Allow partial match only if it uniquely resolves to one processType.\n- If multiple matches exist, do NOT resolve; treat as ambiguous.\n- If no match exists, processQuery MUST be null.\n\nIf validation succeeds, output:\n\"processQuery\": {\n  \"processType\": \"<validated processType from allProcesses>\"\n}\n\nIf validation fails:\n- processQuery = null\n- Do NOT add focus = PROCESS\n- Do NOT add PROCESS_IMPACT\n- Add to reason: \"Mentioned process does not match any known processType in this Bulk Plan run.\"\n\n--------------------------------------------------\nMULTISTOP PROCESS AUTO-RESOLUTION\n--------------------------------------------------\nIf primaryMode = MULTISTOP AND processQuery = null:\n\nCheck whether \"MultiStop Savings\" exists in diagnosticTreeStats.filterObjects.allProcesses.\nIf it exists:\n    processQuery = {\n        \"processType\": \"MultiStop Savings\"\n    }\n\n    Add \"PROCESS\" to focus.\n\nIf it does not exist:\n    processQuery remains null.\n\n==================================================\n6. VIEW CONSTRUCTION\n==================================================\n--------------------------------------------------\nSTEP 1 — RENDERING INTENT OVERRIDE\n--------------------------------------------------\n\nBefore assigning views from primaryMode, determine if the query requires a special rendering style.\n\n--------------------------------------------------\nENUMERATION QUERIES\n--------------------------------------------------\nIf the query requests listing or showing entities such as:\n• which orders failed\n• list failed orders\n• show shipments created\n• display planned shipments\n\nThen:\ndiagnosticViewFlow = [\"SUMMARY_METRICS\"]\n\nDo NOT include FAILURE_TREE or other diagnostic views.\n\n--------------------------------------------------\nPROCESS / WALKTHROUGH QUERIES\n--------------------------------------------------\nIf the query asks for a process explanation such as:\n• walk through the bulk plan\n• explain the planning process\n• how did the planner run\n• describe how the run executed\n\nThen:\ndiagnosticViewFlow = [\"CONCISE_NARRATIVE\"]\n\nCONCISE_NARRATIVE must be the only view.\n\n--------------------------------------------------\nFOLLOW-UP REMEDIATION QUERIES\n--------------------------------------------------\nIf the query asks how to resolve or fix an issue such as:\n• how can we fix this\n• how to resolve this\n• recommended actions\n• what should we change\n\nThen:\nprimaryMode = TUNING\ndiagnosticViewFlow = [\"TUNING_RECOMMENDATIONS\"]\n\n--------------------------------------------------\nSTEP 2 — DEFAULT VIEW ASSIGNMENT\n--------------------------------------------------\nIf no override rule above applied:\n\nBase views by primaryMode:\n\nMETRICS_ONLY\n→ [\"SUMMARY_METRICS\"]\n\nSUMMARY\n→ [\"SUMMARY_METRICS\", \"BULK_PLAN_OVERVIEW\"]\n\nFAILURE\n→ [\"FAILURE_TREE\", \"DOMINANT_FAILURE\"]\n+ CONSTRAINT_EVIDENCE only if audienceLevel = DEVELOPER\n+ ENTITY_IMPACT if entityQuery exists\n+ PROCESS_IMPACT if processQuery exists\n\nMULTISTOP\n→ [\"MULTISTOP_TABLE\", \"MULTISTOP_IMPACT\"]\n\nTUNING\n→ [\"TUNING_RECOMMENDATIONS\"]\n\n--------------------------------------------------\nSTEP 3 — QA EXPLANATORY OVERRIDE\n--------------------------------------------------\nApply this override ONLY when:\n- answerType = QA\n- primaryMode = SUMMARY\n- the query requests explanation\n- the query does NOT request:\n  • failure cause\n  • root cause\n  • why failed\n  • failed orders with reasons\n  • process-specific failure explanation\n  • constraint explanation\n  • diagnostic explanation\n\nThen:\ndiagnosticViewFlow = [\"CONCISE_NARRATIVE\"]\n\nCONCISE_NARRATIVE must be exclusive.\n\nSTRICT PROHIBITION:\nIf primaryMode = FAILURE:\n- DO NOT assign diagnosticViewFlow = [\"CONCISE_NARRATIVE\"]\n- DO NOT suppress FAILURE_TREE\n- DO NOT suppress DOMINANT_FAILURE\n\n--------------------------------------------------\nSTEP 4 — VIEW ORDER ENFORCEMENT\n--------------------------------------------------\nViews must follow global ordering rules.\n\n==================================================\n7. DATA NEEDS\n==================================================\n\nData requirements MUST be determined from analytical intent (primaryMode), NOT from diagnosticViewFlow.\nViews determine presentation only. \nDataNeeds determine what datasets must be fetched to perform analysis.\n\n--------------------------------------------------\nINITIALIZATION\n--------------------------------------------------\nInitialize all data flags to false:\n\nneedSummaryMetrics = false  \nneedFailureTree = false  \nneedDominantFailurePaths = false  \nneedEntityIndex = false  \nneedProcessImpact = false  \nneedMultistopData = false  \nneedTuningGuide = false\n\n--------------------------------------------------\nMODE REQUIREMENTS\n--------------------------------------------------\nSUMMARY or METRICS_ONLY:\n    needSummaryMetrics = true\n\nFAILURE:\n    needFailureTree = true\n    needDominantFailurePaths = true\n\nMULTISTOP:\n    needMultistopData = true\n    needProcessImpact = true\n\nTUNING:\n    needTuningGuide = true\n    needFailureTree = true\n    needDominantFailurePaths = true\n\n--------------------------------------------------\nADDITIONAL SCOPING REQUIREMENTS\n--------------------------------------------------\nIf entityQuery exists:\n    needEntityIndex = true\n\nIf processQuery exists:\n    needProcessImpact = true\n\n--------------------------------------------------\nMULTI-MODE REQUESTS\n--------------------------------------------------\nIf modes contains multiple analytical modes:\nUnion the data requirements of all modes.\n\nExample:\nmodes = [SUMMARY, FAILURE]\n\nThen:\nneedSummaryMetrics = true\nneedFailureTree = true\nneedDominantFailurePaths = true\n\n==================================================\n8. GUARDRAILS\n==================================================\n- primaryMode cannot be null.\n- diagnosticViewFlow cannot be empty.\n- CONCISE_NARRATIVE cannot coexist with other views.\n- answerType cannot change after Step 1.\n- Focus must reflect only validated entityQuery/processQuery.\n\nFAILURE MODE CONSISTENCY RULE (MANDATORY)\nIf primaryMode = FAILURE:\n- diagnosticViewFlow MUST include:\n  • FAILURE_TREE\n  • DOMINANT_FAILURE\n- diagnosticViewFlow MUST NOT be [\"CONCISE_NARRATIVE\"]\n\n==================================================\nALLOWED ENUMERATIONS (STRICT OUTPUT CONTRACT)\n==================================================\nThe planner MUST use only the allowed values below.\nNo additional values are permitted.\n\n--------------------------------------------------\nALLOWED diagnosticViewFlow VALUES\n--------------------------------------------------\ndiagnosticViewFlow may contain ONLY:\n- SUMMARY_METRICS\n- BULK_PLAN_OVERVIEW\n- FAILURE_TREE\n- DOMINANT_FAILURE\n- CONSTRAINT_EVIDENCE\n- ENTITY_IMPACT\n- PROCESS_IMPACT\n- MULTISTOP_TABLE\n- MULTISTOP_IMPACT\n- TUNING_RECOMMENDATIONS\n- CONCISE_NARRATIVE\n\nRules:\n- No other values are permitted.\n- Order must follow global view order.\n- CONCISE_NARRATIVE must be exclusive.\n- Views must align with primaryMode.\n- Views must align with focus (ENTITY / PROCESS) when present.\n\n--------------------------------------------------\nALLOWED PRIMARY MODES\n--------------------------------------------------\nprimaryMode MUST be exactly one of:\n- SUMMARY\n- METRICS_ONLY\n- FAILURE\n- MULTISTOP\n- TUNING\n\nprimaryMode cannot be null.\nprimaryMode must align with analytical goal.\n\n--------------------------------------------------\nALLOWED AUDIENCE LEVEL\n--------------------------------------------------\naudienceLevel MUST be exactly one of:\n- USER\n- PLANNER\n- DEVELOPER\n\nIf not explicitly specified:\n- Default audienceLevel = USER.\n\nDEVELOPER level may include CONSTRAINT_EVIDENCE.\nUSER level must avoid technical depth beyond summary explanation.\n\n--------------------------------------------------\nENUMERATION GUARDRAILS\n--------------------------------------------------\n- No invented primaryMode values.\n- No invented diagnosticViewFlow values.\n- No invented audienceLevel values.\n- No free-text substitutions.\n- No dynamic renaming of view blocks.\n- No additional fields.\n\nAll enumerations must strictly match the allowed lists above.\n\n==================================================\nDETERMINISTIC EXAMPLES (REFERENCE BEHAVIOR)\n==================================================\nThese examples illustrate expected planner decisions.\nThey are normative references. The planner must follow the same rule hierarchy.\n\n--------------------------------------------------\nEXAMPLE 1 — Pure Metrics\n--------------------------------------------------\nQuery:\n\"How many orders failed?\"\n\nExpected:\n- answerType = QA\n- primaryMode = METRICS_ONLY\n- diagnosticViewFlow = [\"SUMMARY_METRICS\"]\n\n--------------------------------------------------\nEXAMPLE 2 — Structured Summary Report\n--------------------------------------------------\nQuery:\n\"Provide a summary report of this bulk plan.\"\n\nExpected:\n- answerType = REPORT\n- primaryMode = SUMMARY\n- diagnosticViewFlow =\n  [\"SUMMARY_METRICS\", \"BULK_PLAN_OVERVIEW\"]\n\n--------------------------------------------------\nEXAMPLE 3 — General Run Explanation (No Artifact)\n--------------------------------------------------\nQuery:\n\"What happened in this run?\"\n\nExpected:\n- answerType = QA\n- primaryMode = SUMMARY\n- diagnosticViewFlow = [\"CONCISE_NARRATIVE\"]\n\n--------------------------------------------------\nEXAMPLE 4 — Root Cause Question\n--------------------------------------------------\nQuery:\n\"Why did the bulk plan fail?\"\n\nExpected:\n- answerType = QA\n- primaryMode = FAILURE\n- diagnosticViewFlow =\n  [\"FAILURE_TREE\", \"DOMINANT_FAILURE\"]\n\n--------------------------------------------------\nEXAMPLE 5 — Entity-Specific Failure (Valid Entity)\n--------------------------------------------------\nQuery:\n\"Why did order LNMDEMO.BWI_READING_01 fail?\"\n\nCondition:\nLNMDEMO.BWI_READING_01 exists in filterObjects.ORDER_RELEASE\n\nExpected:\n- answerType = QA\n- primaryMode = FAILURE\n- focus = [\"ENTITY\"]\n- diagnosticViewFlow =\n  [\"FAILURE_TREE\", \"DOMINANT_FAILURE\", \"ENTITY_IMPACT\"]\n\n--------------------------------------------------\nEXAMPLE 6 — Entity-Specific Failure (Invalid Entity)\n--------------------------------------------------\nQuery:\n\"Why did order ABC123 fail?\"\n\nCondition:\nABC123 does NOT exist in filterObjects.ORDER_RELEASE\n\nExpected:\n- answerType = QA\n- primaryMode = FAILURE\n- entityQuery = null\n- diagnosticViewFlow =\n  [\"FAILURE_TREE\", \"DOMINANT_FAILURE\"]\n\n--------------------------------------------------\nEXAMPLE 7 — Multi-Intent Request\n--------------------------------------------------\nQuery:\n\"Explain why it failed and show multistop savings.\"\n\nExpected:\n- answerType = QA\n- primaryMode = SUMMARY\n- modes = [SUMMARY, FAILURE, MULTISTOP]\n- diagnosticViewFlow =\n  [\n    \"SUMMARY_METRICS\",\n    \"BULK_PLAN_OVERVIEW\",\n    \"FAILURE_TREE\",\n    \"DOMINANT_FAILURE\",\n    \"MULTISTOP_TABLE\",\n    \"MULTISTOP_IMPACT\"\n  ]\n\n--------------------------------------------------\nEXAMPLE 8 — Process-Specific Analysis\n--------------------------------------------------\nQuery:\n\"Evaluate Rate Service analysis.\"\n\nCondition:\n\"Evaluate Rate Service\" uniquely matches a processType in allProcesses\n\nExpected:\n- answerType = QA\n- primaryMode = FAILURE\n- focus = [\"PROCESS\"]\n- diagnosticViewFlow =\n  [\"FAILURE_TREE\", \"DOMINANT_FAILURE\", \"PROCESS_IMPACT\"]\n\n--------------------------------------------------\nEXAMPLE 9 — Optimization Request\n--------------------------------------------------\nQuery:\n\"How can we optimize this bulk plan?\"\n\nExpected:\n- answerType = QA\n- primaryMode = TUNING\n- diagnosticViewFlow =\n  [\"TUNING_RECOMMENDATIONS\"]\n\n--------------------------------------------------\nEXAMPLE 10 — Detailed Root Cause Report\n--------------------------------------------------\nQuery:\n\"Give detailed root cause analysis for failure.\"\n\nExpected:\n- answerType = REPORT\n- primaryMode = FAILURE\n- diagnosticViewFlow =\n  [\n    \"FAILURE_TREE\",\n    \"DOMINANT_FAILURE\",\n    \"CONSTRAINT_EVIDENCE\"\n  ]\n\n--------------------------------------------------\nAll outputs must respect:\n- Allowed diagnosticViewFlow values only.\n- Global view ordering.\n- CONCISE_NARRATIVE must be exclusive.\n- answerType precedence cannot be overridden.\n- Entity and process validation must pass before focus is applied.\n\n==================================================\n10. OUTPUT FORMAT\n==================================================\nReturn STRICT JSON only:\n\n{\n  \"answerType\": \"<REPORT | QA>\",\n  \"primaryMode\": \"<SUMMARY | METRICS_ONLY | FAILURE | MULTISTOP | TUNING | null>\",\n  \"modes\": [\"<SUMMARY | METRICS_ONLY | FAILURE | MULTISTOP | TUNING>\"],\n  \"focus\": [\"<ENTITY | PROCESS>\"],\n  \"entityQuery\": {\n    \"type\": \"<ORDER_RELEASE | RATE_OFFERING | LOCATION | EQUIPMENT | LANE | null>\",\n    \"value\": \"<GID string | null>\"\n  },\n  \"processQuery\": {},\n  \"audienceLevel\": \"<USER | PLANNER | DEVELOPER>\",\n  \"diagnosticViewFlow\": [\n    \"<ordered list of view blocks>\"\n  ],\n  \"dataNeeds\": {\n    \"needSummaryMetrics\": true | false,\n    \"needFailureTree\": true | false,\n    \"needDominantFailurePaths\": true | false,\n    \"needEntityIndex\": true | false,\n    \"needProcessImpact\": true | false,\n    \"needMultistopData\": true | false,\n    \"needTuningGuide\": true | false\n  },\n  \n  \"isFollowUp\": true | false,\n  \"inheritedContext\": {\n    \"diagnosticLogFileId\": lastDiagnosticLogFileId,\n    \"bulkPlanId\": lastBulkPlanId,\n    \"previousPrimaryMode\": lastPrimaryMode,\n    \"previousFocus\": lastFocus\n  },\n  \"reason\": \"Provide a concise explanation of the planning decision.\n\n    Structure the explanation in the following order:\n    1. USER QUERY — restate the user query briefly.\n    2. ANSWER TYPE — explain why answerType was classified as QA or REPORT.\n    3. PRIMARY MODE — explain which rule determined the primaryMode.\n    4. VIEW SELECTION — explain how diagnosticViewFlow was determined.\n    5. DATA NEEDS — explain which datasets are required.\"\n}\n\nNo markdown.\nNo commentary.\nNo extra text."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"OTM Bulk Plan Diagnostic Intent Plan\",\n  \"type\": \"object\",\n  \"required\": [\n    \"answerType\",\n    \"primaryMode\",\n    \"modes\",\n    \"focus\",\n    \"audienceLevel\",\n    \"diagnosticViewFlow\",\n    \"dataNeeds\",\n    \"reason\"\n  ],\n  \"properties\": {\n    \"answerType\": {\n      \"type\": \"string\",\n      \"enum\": [\"REPORT\", \"QA\"]\n    },\n    \"primaryMode\": {\n      \"type\": [\"string\", \"null\"],\n      \"enum\": [\"SUMMARY\", \"METRICS_ONLY\", \"FAILURE\", \"MULTISTOP\", \"TUNING\", null]\n    },\n    \"modes\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\",\n        \"enum\": [\"SUMMARY\", \"METRICS_ONLY\", \"FAILURE\", \"MULTISTOP\", \"TUNING\"]\n      }\n    },\n    \"focus\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\",\n        \"enum\": [\"ENTITY\", \"PROCESS\"]\n      }\n    },\n    \"entityQuery\": {\n      \"type\": [\"object\", \"null\"],\n      \"required\": [\"type\", \"value\"],\n      \"properties\": {\n        \"type\": {\n          \"type\": [\"string\", \"null\"]\n        },\n        \"value\": {\n          \"type\": [\"string\", \"null\"]\n        }\n      }\n    },\n    \"processQuery\": {\n      \"type\": [\"object\", \"null\"],\n      \"required\": [\"processType\"],\n      \"properties\": {\n        \"processType\": {\n          \"type\": \"string\"\n        }\n      }\n    },\n    \"audienceLevel\": {\n      \"type\": \"string\",\n      \"enum\": [\"USER\", \"PLANNER\", \"DEVELOPER\"]\n    },\n    \"diagnosticViewFlow\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\",\n        \"enum\": [\n          \"SUMMARY_METRICS\",\n          \"BULK_PLAN_OVERVIEW\",\n          \"FAILURE_TREE\",\n          \"DOMINANT_FAILURE\",\n          \"CONSTRAINT_EVIDENCE\",\n          \"ENTITY_IMPACT\",\n          \"PROCESS_IMPACT\",\n          \"MULTISTOP_TABLE\",\n          \"MULTISTOP_IMPACT\",\n          \"TUNING_RECOMMENDATIONS\",\n          \"CONCISE_NARRATIVE\"\n        ]\n      }\n    },\n    \"dataNeeds\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"needSummaryMetrics\",\n        \"needFailureTree\",\n        \"needDominantFailurePaths\",\n        \"needEntityIndex\",\n        \"needProcessImpact\",\n        \"needMultistopData\",\n        \"needTuningGuide\"\n      ],\n      \"properties\": {\n        \"needSummaryMetrics\": { \"type\": \"boolean\" },\n        \"needFailureTree\": { \"type\": \"boolean\" },\n        \"needDominantFailurePaths\": { \"type\": \"boolean\" },\n        \"needEntityIndex\": { \"type\": \"boolean\" },\n        \"needProcessImpact\": { \"type\": \"boolean\" },\n        \"needMultistopData\": { \"type\": \"boolean\" },\n        \"needTuningGuide\": { \"type\": \"boolean\" }\n      },\n      \"allOf\": [\n        {\n          \"if\": {\n            \"properties\": {\n              \"needDominantFailurePaths\": { \"const\": true }\n            }\n          },\n          \"then\": {\n            \"properties\": {\n              \"needFailureTree\": { \"const\": true }\n            }\n          }\n        }\n      ]\n    },\n    \"isFollowUp\": {\n      \"type\": \"boolean\",\n      \"description\": \"True if the query is a follow up query\"\n    },\n    \"inheritedContext\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"diagnosticLogFileId\",\n        \"bulkPlanId\",\n        \"previousPrimaryMode\",\n        \"previousFocus\"\n      ],\n      \"properties\": {\n        \"diagnosticLogFileId\": {\n          \"type\": \"string\",\n          \"nullable\": true\n        },\n        \"bulkPlanId\": {\n          \"type\": \"string\",\n          \"nullable\": true\n        },\n        \"previousPrimaryMode\": {\n          \"type\": \"string\",\n          \"nullable\": true,\n          \"enum\": [\n            \"SUMMARY\",\n            \"FAILURE\",\n            \"MULTISTOP\",\n            \"TUNING\",\n            \"METRICS_ONLY\"\n          ]\n        },\n        \"previousFocus\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\",\n            \"enum\": [\"ENTITY\", \"PROCESS\"]\n          }\n        }\n      }\n    },\n    \"reason\": {\n      \"type\": \"string\"\n    }\n  }\n}",
          "type": "LLM"
        },
