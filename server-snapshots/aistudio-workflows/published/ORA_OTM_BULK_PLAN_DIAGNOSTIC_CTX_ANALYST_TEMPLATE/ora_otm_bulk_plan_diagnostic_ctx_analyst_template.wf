        {
          "metadata": {
            "name": "Determine Incremental Data Needs",
            "returnType": "object",
            "sourceCode": "var dataNeeds = $context.$nodes.INTENT_CLASSIFIER.$output.dataNeeds || {};\nvar datasetPresence = $context.$nodes.IDENTIFY_DATASET_AVAILABILITY.$output.result.datasetPresence || {};\nvar isFollowUp = $context.$nodes.INTENT_CLASSIFIER.$output.isFollowUp === true;\n\nvar incrementalDataNeeds = {\n    needSummaryMetrics: false,\n    needFailureTree: false,\n    needDominantFailurePaths: false,\n    needEntityIndex: false,\n    needProcessImpact: false,\n    needMultistopData: false,\n    needTuningGuide: false\n};\n\nif (!isFollowUp) {\n    incrementalDataNeeds = JSON.parse(JSON.stringify(dataNeeds));\n} else {\n    incrementalDataNeeds.needSummaryMetrics = dataNeeds.needSummaryMetrics && !datasetPresence.hasSummaryMetrics;\n    incrementalDataNeeds.needFailureTree = dataNeeds.needFailureTree && !datasetPresence.hasFailureTreeData;\n    incrementalDataNeeds.needDominantFailurePaths = dataNeeds.needDominantFailurePaths && !datasetPresence.hasDominantFailedPaths;\n    incrementalDataNeeds.needEntityIndex = dataNeeds.needEntityIndex && !datasetPresence.hasEntityImpact;\n    incrementalDataNeeds.needProcessImpact = dataNeeds.needProcessImpact && !datasetPresence.hasProcessImpact;\n    incrementalDataNeeds.needMultistopData = dataNeeds.needMultistopData && !datasetPresence.hasMultistopData;\n    incrementalDataNeeds.needTuningGuide = false;\n}\n\nvar result = {\n    incrementalDataNeeds: incrementalDataNeeds\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1768645492777"
          },
          "code": "DETERMINE_INCREMENTAL_DATA_NEEDS",
