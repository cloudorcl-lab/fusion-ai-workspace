        {
          "id": "1768743737211",
          "name": "conversationState",
          "scope": "CONVERSATION",
          "type": "object",
          "typeSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"ConversationState\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"lastDiagnosticLogFileId\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Last resolved Bulk Plan Diagnostic Log File ID used in the conversation.\"\n    },\n    \"lastPrimaryMode\": {\n      \"type\": [\"string\", \"null\"],\n      \"enum\": [\"SUMMARY\", \"METRICS_ONLY\", \"FAILURE\", \"MULTISTOP\", \"TUNING\", null],\n      \"description\": \"Primary analytical mode from the last turn.\"\n    },\n    \"lastModes\": {\n      \"type\": [\"array\", \"null\"],\n      \"items\": {\n        \"type\": \"string\",\n        \"enum\": [\"SUMMARY\", \"METRICS_ONLY\", \"FAILURE\", \"MULTISTOP\", \"TUNING\"]\n      },\n      \"description\": \"All analytical modes requested in the last turn.\"\n    },\n    \"lastFocus\": {\n      \"type\": [\"array\", \"null\"],\n      \"items\": {\n        \"type\": \"string\",\n        \"enum\": [\"ENTITY\", \"PROCESS\"]\n      },\n      \"description\": \"Focus dimensions from the last turn (ENTITY, PROCESS).\"\n    },\n    \"lastEntityQuery\": {\n      \"type\": [\"object\", \"null\"],\n      \"properties\": {\n        \"entityType\": {\n          \"type\": \"string\",\n          \"description\": \"Entity type such as ORDER_RELEASE, RATE_SERVICE, LOCATION, EQUIPMENT, LANE.\"\n        },\n        \"entityValue\": {\n          \"type\": \"string\",\n          \"description\": \"The specific entity GID or identifier.\"\n        }\n      },\n      \"required\": [\"entityType\", \"entityValue\"]\n    },\n    \"lastProcessQuery\": {\n      \"type\": [\"object\", \"null\"],\n      \"properties\": {\n        \"processType\": {\n          \"type\": \"string\",\n          \"description\": \"OTM processType name (e.g., Evaluate Rate Service, Route Order Releases).\"\n        }\n      },\n      \"required\": [\"processType\"]\n    },\n    \"lastModelData\": {\n      \"type\": [\"object\", \"null\"],\n      \"description\": \"Merged semantic model from previous run (summary, failure, multistop, entity, process, tuning data).\",\n      \"properties\": {\n        \"summaryMetrics\": { \"type\": [\"object\", \"null\"] },\n        \"diagnosticRootData\": { \"type\": [\"object\", \"null\"] },\n        \"expandedTruncatedNodes\": { \"type\": [\"array\", \"null\"] },\n        \"failureTreeData\": { \"type\": [\"object\", \"null\"] },\n        \"dominantFailedPaths\": { \"type\": [\"array\", \"null\"] },\n        \"expandedDominantFailedNodes\": { \"type\": [\"array\", \"null\"] },\n        \"multistopData\": { \"type\": [\"object\", \"null\"] },\n        \"tuningRecommendations\": { \"type\": [\"object\", \"null\"] },\n        \"entityImpact\": { \"type\": [\"object\", \"null\"] },\n        \"processImpact\": { \"type\": [\"object\", \"null\"] }\n      }\n    },\n    \"lastIntentClassifier\": {\n      \"type\": [\"object\", \"null\"],\n      \"description\": \"Full intent planner output from previous turn.\",\n      \"properties\": {\n        \"isOutOfScope\": { \"type\": \"boolean\" },\n        \"primaryMode\": { \"type\": \"string\" },\n        \"modes\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" }\n        },\n        \"focus\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" }\n        },\n        \"audienceLevel\": { \"type\": \"string\" },\n        \"diagnosticViewFlow\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" }\n        },\n        \"dataNeeds\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"needSummaryMetrics\": { \"type\": \"boolean\" },\n            \"needFailureTree\": { \"type\": \"boolean\" },\n            \"needDominantFailurePaths\": { \"type\": \"boolean\" },\n            \"needEntityIndex\": { \"type\": \"boolean\" },\n            \"needMultistopData\": { \"type\": \"boolean\" },\n            \"needTuningGuide\": { \"type\": \"boolean\" }\n          }\n        },\n        \"reason\": { \"type\": \"string\" }\n      }\n    }\n  },\n  \"required\": [\n    \"lastDiagnosticLogFileId\",\n    \"lastPrimaryMode\",\n    \"lastModes\",\n    \"lastFocus\",\n    \"lastEntityQuery\",\n    \"lastProcessQuery\",\n    \"lastModelData\",\n    \"lastIntentClassifier\"\n  ]\n}"
        },
        {
          "id": "1768708115551",
          "name": "intentClassifier",
          "scope": "CONVERSATION",
          "type": "object",
          "typeSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"OTM Bulk Plan Diagnostic Intent Plan\",\n  \"type\": \"object\",\n  \"required\": [\n    \"isOutOfScope\",\n    \"primaryMode\",\n    \"modes\",\n    \"focus\",\n    \"audienceLevel\",\n    \"diagnosticViewFlow\",\n    \"dataNeeds\",\n    \"reason\"\n  ],\n  \"properties\": {\n    \"isOutOfScope\": {\n      \"type\": \"boolean\",\n      \"description\": \"True if the query is not related to OTM Bulk Plan diagnostics\"\n    },\n    \"primaryMode\": {\n      \"type\": [\"string\", \"null\"],\n      \"enum\": [\"SUMMARY\", \"METRICS_ONLY\", \"FAILURE\", \"MULTISTOP\", \"TUNING\", null]\n    },\n    \"modes\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\",\n        \"enum\": [\"SUMMARY\", \"METRICS_ONLY\", \"FAILURE\", \"MULTISTOP\", \"TUNING\"]\n      }\n    },\n    \"focus\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\",\n        \"enum\": [\"ENTITY\", \"PROCESS\"]\n      }\n    },\n    \"entityQuery\": {\n      \"type\": [\"object\", \"null\"],\n      \"required\": [\"type\", \"value\"],\n      \"properties\": {\n        \"type\": {\n          \"type\": [\"string\", \"null\"]\n        },\n        \"value\": {\n          \"type\": [\"string\", \"null\"]\n        }\n      }\n    },\n    \"processQuery\": {\n      \"type\": [\"object\", \"null\"],\n      \"required\": [\"processType\"],\n      \"properties\": {\n        \"processType\": {\n          \"type\": \"string\"\n        }\n      }\n    },\n    \"audienceLevel\": {\n      \"type\": \"string\",\n      \"enum\": [\"USER\", \"PLANNER\", \"DEVELOPER\"]\n    },\n    \"diagnosticViewFlow\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\",\n        \"enum\": [\n          \"SUMMARY_METRICS\",\n          \"BULK_PLAN_OVERVIEW\",\n          \"FAILURE_TREE\",\n          \"DOMINANT_FAILURE\",\n          \"CONSTRAINT_EVIDENCE\",\n          \"ENTITY_IMPACT\",\n          \"PROCESS_IMPACT\",\n          \"MULTISTOP_TABLE\",\n          \"MULTISTOP_IMPACT\",\n          \"TUNING_RECOMMENDATIONS\"\n        ]\n      }\n    },\n    \"dataNeeds\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"needSummaryMetrics\",\n        \"needFailureTree\",\n        \"needDominantFailurePaths\",\n        \"needEntityIndex\",\n        \"needMultistopData\",\n        \"needTuningGuide\"\n      ],\n      \"properties\": {\n        \"needSummaryMetrics\": { \"type\": \"boolean\" },\n        \"needFailureTree\": { \"type\": \"boolean\" },\n        \"needDominantFailurePaths\": { \"type\": \"boolean\" },\n        \"needEntityIndex\": { \"type\": \"boolean\" },\n        \"needMultistopData\": { \"type\": \"boolean\" },\n        \"needTuningGuide\": { \"type\": \"boolean\" }\n      },\n      \"allOf\": [\n        {\n          \"if\": {\n            \"properties\": {\n              \"needDominantFailurePaths\": { \"const\": true }\n            }\n          },\n          \"then\": {\n            \"properties\": {\n              \"needFailureTree\": { \"const\": true }\n            }\n          }\n        }\n      ]\n    },\n    \"reason\": {\n      \"type\": \"string\"\n    }\n  }\n}"
        },
        {
          "id": "1768660498577",
          "name": "modelData",
          "scope": "CONVERSATION",
          "type": "object"
        },
        {
          "id": "1768293095316",
          "name": "diagnosticSummaryData",
          "scope": "CONVERSATION",
          "type": "object",
          "typeSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"DiagnosticFailureSummaryList\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"keyEntryNode\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"rootId\": {\n                \"type\": \"string\"\n              },\n              \"rootEntry\": {\n                \"$ref\": \"#/definitions/DiagnosticNodeEntry\"\n              }\n            }\n          },\n          \"entities\": {\n            \"type\": \"object\",\n            \"additionalProperties\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"string\"\n              }\n            }\n          },\n          \"processID\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"processNodeIDChain\": {\n            \"type\": \"string\"\n          },\n          \"summary\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"tips\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          }\n        }\n      }\n    },\n    \"diagnosticLogSummary\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"failedOrderPKs\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"failureSummary\": {\n          \"type\": [\n            \"string\",\n            \"null\"\n          ]\n        },\n        \"successfulOrderPKs\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"summaryMetrics\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"totalOrdersSelected\": {\n              \"type\": \"integer\"\n            },\n            \"totalOrdersPlanned\": {\n              \"type\": \"integer\"\n            },\n            \"totalOrdersFailed\": {\n              \"type\": \"integer\"\n            },\n            \"totalShipmentsBuilt\": {\n              \"type\": \"integer\"\n            },\n            \"totalMultiStopShipments\": {\n              \"type\": \"integer\"\n            }\n          },\n          \"required\": [\n            \"totalOrdersSelected\",\n            \"totalOrdersPlanned\",\n            \"totalOrdersFailed\",\n            \"totalShipmentsBuilt\",\n            \"totalMultiStopShipments\"\n          ]\n        }\n      }\n    },\n    \"filterObjects\": {\n      \"type\": \"object\",\n      \"additionalProperties\": {\n        \"type\": \"array\",\n        \"items\": {\n          \"type\": \"string\"\n        }\n      }\n    },\n    \"root\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"rootId\": {\n          \"type\": \"string\"\n        },\n        \"rootEntry\": {\n          \"$ref\": \"#/definitions/DiagnosticNodeEntry\"\n        }\n      }\n    }\n  },\n  \"definitions\": {\n    \"DiagnosticNodeEntry\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": {\n          \"type\": \"string\"\n        },\n        \"parentId\": {\n          \"type\": \"string\"\n        },\n        \"startTime\": {\n          \"type\": \"string\"\n        },\n        \"processName\": {\n          \"type\": \"string\"\n        },\n        \"processNameId\": {\n          \"type\": \"string\"\n        },\n        \"exportFileEntityMap\": {\n          \"type\": \"object\",\n          \"additionalProperties\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          }\n        },\n        \"endTime\": {\n          \"type\": \"string\"\n        },\n        \"statusList\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"remarksList\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"reasonCodeList\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"childIds\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"diagFileSize\": {\n          \"type\": \"integer\"\n        },\n        \"hasChilds\": {\n          \"type\": \"boolean\"\n        },\n        \"filterStatus\": {\n          \"type\": \"boolean\"\n        },\n        \"depth\": {\n          \"type\": \"integer\"\n        },\n        \"failureReasonList\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"children\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"$ref\": \"#/definitions/DiagnosticNodeEntry\"\n          }\n        }\n      }\n    }\n  }\n}"
        },
