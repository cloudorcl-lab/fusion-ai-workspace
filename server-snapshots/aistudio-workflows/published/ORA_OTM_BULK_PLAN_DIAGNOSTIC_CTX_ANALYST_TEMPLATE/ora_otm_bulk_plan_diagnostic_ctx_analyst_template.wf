                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "Identify Truncated Entity Nodes",
                    "returnType": "object",
                    "sourceCode": "var rawOutput = $context.$nodes.EXECUTE_DATA_PIPELINES.FETCH_ENTITY_RELATED_DATA.$output;\nvar results = [];\n\nif (typeof rawOutput === \"string\") {\n  try {\n    rawOutput = JSON.parse(rawOutput);\n  } catch (e) {\n  }\n}\n\nif (!rawOutput || !rawOutput.tree) {\n  return results;\n}\n\nvar root = rawOutput.tree;\nvar stack = [];\n\nstack.push({\n  node: root,\n  path: [{\n    id: root.id,\n    processType: root.processType,\n    status: root.status\n  }]\n});\n\nwhile (stack.length > 0) {\n  var item = stack.pop();\n  var node = item.node;\n  var path = item.path;\n\n  if (!node || typeof node !== \"object\") continue;\n\n  // If this node is truncated and a leaf in this reduced tree, capture its path\n  if (node.isTruncated === true && (!node.children || node.children.length === 0)) {\n    results.push({\n      id: node.id,\n      process: node.processType,\n      status: node.status,\n      pathToRoot: path\n    });\n  }\n\n  if (node.children && node.children.length > 0) {\n    for (var i = 0; i < node.children.length; i++) {\n      var child = node.children[i];\n      var newPath = path.slice(); // clone\n      newPath.push({\n        id: child.id,\n        processType: child.processType,\n        status: child.status\n      });\n\n      stack.push({\n        node: child,\n        path: newPath\n      });\n    }\n  }\n}\n\nreturn results;"
                  },
