          "metadata": {
            "name": "Create Filtered Model Input",
            "returnType": "object",
            "sourceCode": "var needs = $context.$nodes.INTENT_CLASSIFIER.$output.dataNeeds;\nvar full = $context.$variables.modelData;\n\nvar filtered = {\n  diagnosticRootData: null,\n  expandedTruncatedNodes: null,\n  failureTreeData: null,\n  dominantFailedPaths: null,\n  expandedDominantFailedNodes: null,\n  entityImpact: null,\n  processImpact: null,\n  multistopData: null,\n  tuningRecommendations: null\n};\n\nif (needs.needSummaryMetrics) {\n  filtered.diagnosticRootData = full.diagnosticRootData;\n  filtered.expandedTruncatedNodes = full.expandedTruncatedNodes;\n}\n\nif (needs.needFailureTree) {\n  filtered.failureTreeData = full.failureTreeData;\n}\n\nif (needs.needDominantFailurePaths) {\n  filtered.dominantFailedPaths = full.dominantFailedPaths;\n  filtered.expandedDominantFailedNodes = full.expandedDominantFailedNodes;\n}\n\nif (needs.needEntityIndex) {\n  filtered.entityImpact = full.entityImpact || {};\n\n  var entityHasDominant = filtered.entityImpact &&\n    Array.isArray(filtered.entityImpact.expandedDominantFailedNodes) && filtered.entityImpact.expandedDominantFailedNodes.length > 0;\n\n  var globalHasDominant =\n    Array.isArray(full.expandedDominantFailedNodes) && full.expandedDominantFailedNodes.length > 0;\n\n  if (!entityHasDominant && globalHasDominant) {\n    filtered.entityImpact.expandedDominantFailedNodes = full.expandedDominantFailedNodes;\n  }\n}\n\nif (needs.needProcessImpact) {\n  filtered.processImpact = full.processImpact;\n}\n\nif (needs.needMultistopData) {\n  filtered.multistopData = full.multistopData;\n}\n\nif (needs.needTuningGuide) {\n  filtered.tuningRecommendations = full.tuningRecommendations;\n}\n\nreturn filtered;"
          },
          "outcomes": {
            "success": "1768800523184"
          },
          "code": "CREATE_FILTERED_MODEL_INPUT",
