            "name": "Build Data Pipeline Tasks",
            "returnType": "object",
            "sourceCode": "const TASKS = {\n  SUMMARY: \"SUMMARY\",\n  FAILURE: \"FAILURE\",\n  MULTISTOP: \"MULTISTOP\",\n  TUNING: \"TUNING\",\n  ENTITY: \"ENTITY\",\n  PROCESS: \"PROCESS\"\n};\n\nconst tasks = [];\nconst added = {};\n\nconst dataNeeds = $context.$nodes.INTENT_CLASSIFIER.$output.dataNeeds;\nconst entityQuery = $context.$nodes.INTENT_CLASSIFIER.$output.entityQuery;\nconst processQuery = $context.$nodes.INTENT_CLASSIFIER.$output.processQuery;\nconst incremental = $context.$nodes.DETERMINE_INCREMENTAL_DATA_NEEDS.$output.result.incrementalDataNeeds;\n\nif (incremental.needSummaryMetrics && !added[TASKS.SUMMARY]) {\n  tasks.push({ id: TASKS.SUMMARY });\n  added[TASKS.SUMMARY] = true;\n}\n\nif ((incremental.needFailureTree || incremental.needDominantFailurePaths) && !added[TASKS.FAILURE]) {\n  tasks.push({ id: TASKS.FAILURE });\n  added[TASKS.FAILURE] = true;\n}\n\nif (incremental.needMultistopData && !added[TASKS.MULTISTOP]) {\n  tasks.push({ id: TASKS.MULTISTOP });\n  added[TASKS.MULTISTOP] = true;\n}\n\nif (incremental.needEntityIndex && entityQuery && entityQuery.type && !added[TASKS.ENTITY]) {\n  tasks.push({ id: TASKS.ENTITY });\n  added[TASKS.ENTITY] = true;\n}\n\nif (processQuery && processQuery.processType && !added[TASKS.PROCESS]) {\n  tasks.push({ id: TASKS.PROCESS });\n  added[TASKS.PROCESS] = true;\n}\n\nreturn tasks;"
