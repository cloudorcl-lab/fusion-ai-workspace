                {
                  "metadata": {
                    "name": "Merge Expanded Dominant Cause Nodes",
                    "returnType": "object",
                    "sourceCode": "var dominantFailuresWrapper = $context.$nodes.EXECUTE_DATA_PIPELINES.IDENTIFY_DOMINANT_ROOT_CAUSE_NODES.$output;\nvar dominantFailures = dominantFailuresWrapper.result;\nvar expandedMap = {};\n\nvar resultsList = $context.$nodes.EXECUTE_DATA_PIPELINES.EXPAND_DOMINANT_FAILED_TRUNCATED_NODES.$output;\nfor (var i = 0; i < resultsList.length; i++) {\n  var envelope = resultsList[i];\n  var itemParent = null;\n  try {\n    itemParent = JSON.parse(envelope);\n  } catch (e) {\n    // malformed JSON → skip\n    continue;\n  }\n\n  var item = itemParent.result;\n  if (!item || !item.id) continue;\n  expandedMap[item.id] = item;\n}\n\n// Traverse + merge\nfor (var d = 0; d < dominantFailures.length; d++) {\n  var dom = dominantFailures[d];\n\n  // CASE 1: dominant node itself truncated\n  if (dom.isTruncated === true && expandedMap[dom.id]) {\n    var expanded = expandedMap[dom.id];\n    dom.childrenSummary = [];\n    if (expanded.children && expanded.children.length > 0) {\n      for (var c = 0; c < expanded.children.length; c++) {\n        dom.childrenSummary.push(expanded.children[c]);\n      }\n    }\n\n    continue;\n  }\n\n  // CASE 2: traverse childrenSummary and expand truncated descendants\n  if (dom.childrenSummary && dom.childrenSummary.length > 0) {\n    var stack = [];\n    for (var s = 0; s < dom.childrenSummary.length; s++) {\n      stack.push(dom.childrenSummary[s]);\n    }\n\n    while (stack.length > 0) {\n      var current = stack.pop();\n\n      // If this node is truncated and has expansion\n      if (current.isTruncated === true && expandedMap[current.id]) {\n        var expandedNode = expandedMap[current.id];\n\n        current.children = expandedNode.children || [];\n        current.isTruncated = false;\n        continue;\n      }\n\n      // Continue traversal\n      if (current.children && current.children.length > 0) {\n        for (var c = 0; c < current.children.length; c++) {\n          stack.push(current.children[c]);\n        }\n      }\n    }\n  }\n\n}\n\nreturn dominantFailures;"
                  },
