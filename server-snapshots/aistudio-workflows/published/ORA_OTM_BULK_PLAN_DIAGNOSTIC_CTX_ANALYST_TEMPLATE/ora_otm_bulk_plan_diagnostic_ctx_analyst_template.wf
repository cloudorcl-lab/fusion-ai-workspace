                    "sourceCode": "var fetchNode = $context.$nodes.EXECUTE_DATA_PIPELINES.FETCH_ONLY_FAILED_NODES_TREE_DATA.$output;\nvar root = fetchNode && fetchNode.tree ? fetchNode.tree : null;\n\nvar dominantFailures = [];\nvar MAX_DOMINANT = 20;//TODO\nvar dominantIdMap = {};\n\nvar stack = [];\nif (root) stack.push({ node: root, path: [] });\n\n// First pass: find dominant root-cause nodes + propagation paths\nwhile (stack.length > 0 && dominantFailures.length < MAX_DOMINANT) {\n  var current = stack.pop();\n  var node = current.node;\n  var path = current.path.concat(node);\n\n  if (node.status === \"FAILURE\") {\n\n    // Check: no visible failed children\n    var hasFailedChild = false;\n    if (node.children && node.children.length > 0) {\n      for (var i = 0; i < node.children.length; i++) {\n        if (node.children[i].status === \"FAILURE\") {\n          hasFailedChild = true;\n          break;\n        }\n      }\n    }\n\n    // Check: propagates to root (all parents FAILURE)\n    var propagatesToRoot = true;\n    for (var j = 0; j < path.length; j++) {\n      if (path[j].status !== \"FAILURE\") {\n        propagatesToRoot = false;\n        break;\n      }\n    }\n\n    if (!hasFailedChild && propagatesToRoot) {\n      // Build slim dominantFailedPath\n      var slimPath = [];\n      for (var k = 0; k < path.length; k++) {\n        slimPath.push({\n          nodeId: path[k].id,\n          process: path[k].processType,\n          status: path[k].status\n        });\n      }\n\n      dominantFailures.push({\n        id: node.id,\n        process: node.processType,\n        status: node.status,\n        isTruncated: node.isTruncated === true,\n        remarks: node.remarks || [],\n        pathToRoot: slimPath,\n        childrenSummary: []   // filled in second pass\n      });\n\n      dominantIdMap[node.id] = true;\n    }\n  }\n\n  if (node.children && node.children.length > 0) {\n    for (var m = 0; m < node.children.length; m++) {\n      stack.push({\n        node: node.children[m],\n        path: path\n      });\n    }\n  }\n}\n\n// Second pass: add one-level expansion (childrenSummary)\nif (root) {\n  var stack2 = [root];\n\n  while (stack2.length > 0) {\n    var n = stack2.pop();\n\n    if (dominantIdMap[n.id]) {\n      for (var d = 0; d < dominantFailures.length; d++) {\n        if (dominantFailures[d].id === n.id) {\n          if (n.children && n.children.length > 0) {\n            for (var c = 0; c < n.children.length; c++) {\n              var child = n.children[c];\n              dominantFailures[d].childrenSummary.push(child);\n            }\n          }\n          break;\n        }\n      }\n    }\n\n    if (n.children && n.children.length > 0) {\n      for (var x = 0; x < n.children.length; x++) {\n        stack2.push(n.children[x]);\n      }\n    }\n  }\n}\n\ndominantFailures;"
                  },
                  "outcomes": {
                    "success": "1768649961197"
                  },
                  "code": "IDENTIFY_DOMINANT_ROOT_CAUSE_NODES",
                  "id": "1768836926026",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE",
                  "convergenceTargetId": "1768649687334"
                },
                {
                  "metadata": {
                    "name": "Identify Dominant Failed Truncated Nodes",
                    "returnType": "object",
                    "sourceCode": "var rawOutput = $context.$nodes.EXECUTE_DATA_PIPELINES.IDENTIFY_DOMINANT_ROOT_CAUSE_NODES.$output;\n\n// Step 1 — if whole output is string, parse it\nif (typeof rawOutput === \"string\") {\n    try {\n        rawOutput = JSON.parse(rawOutput);\n    } catch (e) {}\n}\n\n// Step 2 — extract result\nvar data = rawOutput.result || [];\n\n// Step 3 — result itself might also be string\nif (typeof data === \"string\") {\n    try {\n        data = JSON.parse(data);\n    } catch (e) {}\n}\n\nvar dominantPaths = [];\nvar MAX_DOMINANT = 5;\n\nfor (var i = 0; i < data.length; i++) {\n    var item = data[i];\n\n    if (item.isTruncated) {\n        dominantPaths.push({\n            id: item.id,\n            process: item.process,\n            status: item.status,\n            pathToRoot: item.pathToRoot\n        });\n    }\n\n    if (item.childrenSummary && item.childrenSummary.length > 0) {\n        var stack = [];\n        for (var c = 0; c < item.childrenSummary.length; c++) {\n            stack.push(item.childrenSummary[c]);\n        }\n\n        while (stack.length > 0) {\n            var node = stack.pop();\n\n            if (node.isTruncated === true) {\n                dominantPaths.push({\n                    id: node.id,\n                    process: node.processType,\n                    status: node.status\n                });\n            }\n\n            // recurse deeper if children exist\n            if (node.children && node.children.length > 0) {\n                for (var k = 0; k < node.children.length; k++) {\n                    stack.push(node.children[k]);\n                }\n            }\n        }\n    }\n}\n\nconst priority = {\n    'FAILURE': 1,\n    'SUCCESS': 2\n};\ndominantPaths.sort(function(a, b) {\n    var priorityA = priority[a.status] || 99;\n    var priorityB = priority[b.status] || 99;\n    return priorityA - priorityB;\n});\n\ndominantPaths = dominantPaths.slice(0, MAX_DOMINANT);\nreturn dominantPaths;"
                  },
                  "outcomes": {
                    "success": "1768649986928"
                  },
                  "code": "IDENTIFY_DOMINANT_FAILED_TRUNCATED_NODES",
