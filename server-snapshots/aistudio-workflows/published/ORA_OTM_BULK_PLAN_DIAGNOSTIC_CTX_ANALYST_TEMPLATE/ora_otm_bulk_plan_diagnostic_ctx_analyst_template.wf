                            "returnType": "object",
                            "sourceCode": "var fetchNode = $context.$nodes.EXECUTE_DATA_PIPELINES.EXPAND_DOMINANT_FAILED_TRUNCATED_NODES.FETCH_TRUNCATED_DOMINANT_FAILED_NODE.$output;\nvar root = fetchNode && fetchNode.tree ? fetchNode.tree : null;\n\nvar stack = root ? [root] : [];\nwhile (stack.length > 0) {\n  var node = stack.pop();\n  if (!node || typeof node !== \"object\") continue;\n\n  // Remove empty arrays / objects\n  if (node.remarks && node.remarks.length === 0) delete node.remarks;\n  if (node.reasonCodeList && node.reasonCodeList.length === 0) delete node.reasonCodeList;\n  if (node.nonDBEntities && node.nonDBEntities.length === 0) delete node.nonDBEntities;\n  if (node.exportFiles && node.exportFiles.length === 0) delete node.exportFiles;\n\n  if (node.entities && Object.keys(node.entities).length === 0) delete node.entities;\n  if (node.childIds && node.childIds.length === 0) delete node.childIds;\n\n  if (node.children && node.children.length > 0) {\n    for (var i = 0; i < node.children.length; i++) {\n      stack.push(node.children[i]);\n    }\n  }\n}\n\nroot;"
                          },
