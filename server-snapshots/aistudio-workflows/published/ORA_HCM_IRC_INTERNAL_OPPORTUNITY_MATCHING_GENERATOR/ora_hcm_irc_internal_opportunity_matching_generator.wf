            "name": "Extract Canadidate Profile",
            "returnType": "object",
            "sourceCode": "const candidateProfile = $context.$nodes.CANDIDATE_PROFILE_SUMMARIZER.$output.output || {} ;\nlet profileObj= JSON.parse(candidateProfile).result ;\n\nif (Array.isArray(profileObj.Skills) && profileObj.Skills.length === 0) {\n    const emptyMsg = \"EMPTY_PROFILE\" ;\n    profileObj = emptyMsg;\n}\n\nreturn profileObj;"
          },
