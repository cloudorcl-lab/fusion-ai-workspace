          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}"
        },
        {
          "id": "1768248960458",
          "code": "MERGE_POLICY_RESULT",
          "type": "CODE",
          "metadata": {
            "name": "Merge Policy Result",
            "sourceCode": "const startedAt = Date.now();\n\nconst pickClauseTitle = (item) => {\n  const titleWithoutNumber = item && item.title_without_number;\n  if (typeof titleWithoutNumber === 'string' && titleWithoutNumber !== '') {\n    return titleWithoutNumber;\n  }\n\n  const docTitle = item && item.doc_title;\n  if (typeof docTitle === 'string' && docTitle !== '') {\n    return docTitle;\n  }\n\n  return '';\n};\n\nconst toObject = (value) => {\n  if (value && typeof value === 'object') {\n    return value;\n  }\n  if (typeof value === 'string') {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return null;\n    }\n  }\n  return null;\n};\n\nconst parseErrorMessage = (raw) => {\n  const isEmptyString = typeof raw === 'string' && raw.trim() === '';\n  if (raw === null || raw === undefined || isEmptyString) {\n    return {\n      value: null,\n      parseAttempts: 0,\n      parseStatus: 'skipped_empty',\n      parseError: null\n    };\n  }\n\n  let result = raw;\n  let parseAttempts = 0;\n  let parseStatus = 'ok';\n  let parseError = null;\n  const maxAttempts = 5;\n\n  while (typeof result === 'string' && parseAttempts < maxAttempts) {\n    parseAttempts += 1;\n    try {\n      result = JSON.parse(result);\n    } catch (e) {\n      parseStatus = 'parse_error';\n      parseError = String(e?.message || e);\n      break;\n    }\n  }\n\n  return {\n    value: result,\n    parseAttempts,\n    parseStatus,\n    parseError\n  };\n};\n\nconst baseOutput = $context.$nodes.FIND_DEVIATIONS.$output || {};\nconst baseMatches = Array.isArray(baseOutput.template_matches) ? baseOutput.template_matches : [];\n\nconst analystOutput = $context.$nodes.CALL_POLICY_DEVIATION_ANALYST.$output || {};\nconst analystStatus = typeof analystOutput.status === 'string' ? analystOutput.status : null;\nconst analystOutputError =\n  typeof analystOutput.error === 'string' && analystOutput.error.trim() !== ''\n    ? analystOutput.error\n    : null;\n\nconst errorMessageRaw = $context.$error && Object.prototype.hasOwnProperty.call($context.$error, '$errorMessage')\n  ? $context.$error.$errorMessage\n  : null;\nconst parsedErrorMessage = parseErrorMessage(errorMessageRaw);\n\nconst errorEnvelope = parsedErrorMessage.value && typeof parsedErrorMessage.value === 'object'\n  ? parsedErrorMessage.value\n  : null;\nconst errorBody = errorEnvelope && typeof errorEnvelope.result === 'object'\n  ? errorEnvelope.result\n  : errorEnvelope;\n\nconst contextErrorStatus = errorBody && typeof errorBody.status === 'string' ? errorBody.status : null;\nconst contextErrorText = errorBody && typeof errorBody.error === 'string' && errorBody.error.trim() !== ''\n  ? errorBody.error\n  : null;\n\nlet event = 'policy_merge_skipped_due_to_unexpected_analyst_shape';\nlet nodeStatus = 'warn';\nlet nodeError = null;\nlet policyUpsertStatus = null;\nlet policyError = null;\nlet policyEntries = [];\nlet outputParseError = null;\nlet resultParseError = null;\nlet parsedOutput = null;\nlet source = '$output';\n\nconst hasAnalystFailure = contextErrorStatus === 'ERROR' || Boolean(contextErrorText);\n\nif (hasAnalystFailure) {\n  event = 'policy_merge_skipped_due_to_analyst_error';\n  nodeStatus = 'error';\n  policyError = contextErrorText || analystOutputError || 'Policy deviation analyst failed without error details.';\n  nodeError = policyError;\n  source = '$context.$error.$errorMessage';\n} else if (analystStatus === 'COMPLETE') {\n  parsedOutput = toObject(analystOutput.output);\n\n  if (!parsedOutput) {\n    outputParseError = typeof analystOutput.output === 'string'\n      ? 'Failed to parse analyst.output JSON string.'\n      : 'analyst.output missing or not an object.';\n    event = 'policy_merge_skipped_due_to_unexpected_analyst_shape';\n    nodeStatus = 'warn';\n    policyError = 'Policy deviation analyst response missing expected status/output shape.';\n    nodeError = policyError;\n  } else {\n    const policyRoot = parsedOutput && parsedOutput.result ? parsedOutput.result : {};\n    policyUpsertStatus = typeof policyRoot.upsert_status === 'string' ? policyRoot.upsert_status : null;\n\n    if (Array.isArray(policyRoot.result)) {\n      policyEntries = policyRoot.result;\n    } else if (typeof policyRoot.result === 'string') {\n      try {\n        const parsedResult = JSON.parse(policyRoot.result);\n        policyEntries = Array.isArray(parsedResult) ? parsedResult : [];\n      } catch (e) {\n        resultParseError = String(e?.message || e);\n        policyEntries = [];\n      }\n    }\n\n    event = 'policy_merge_complete';\n    nodeStatus = 'ok';\n  }\n} else {\n  event = 'policy_merge_skipped_due_to_unexpected_analyst_shape';\n  nodeStatus = 'warn';\n  policyError = 'Policy deviation analyst response missing expected status/output shape.';\n  nodeError = policyError;\n}\n\nconst severityByTitle = {};\nfor (const entry of policyEntries) {\n  const title = entry && entry.doc_clause_title;\n  const severity = entry && entry.severity_code;\n  if (typeof title === 'string' && title !== '' && typeof severity === 'string' && severity !== '') {\n    severityByTitle[title] = severity;\n  }\n}\n\nconst mergedMatches = baseMatches.map((match) => {\n  const title = pickClauseTitle(match);\n  const severity = title ? severityByTitle[title] : null;\n  const isPolicyRuleBased = Boolean(severity);\n\n  const merged = {\n    ...match,\n    IsPolicyRuleBased: isPolicyRuleBased,\n    SeverityCode: severity || null\n  };\n\n  if (isPolicyRuleBased) {\n    delete merged.document_position;\n    delete merged.standard_position;\n    delete merged.deviation_summary;\n  }\n\n  return merged;\n});\n\nconst result = {\n  ...baseOutput,\n  template_matches: mergedMatches,\n  policy_upsert_status: policyUpsertStatus\n};\n\nif (policyError) {\n  result.policy_error = policyError;\n}\n\nconst includeErrorMessageParseDiagnostics = event !== 'policy_merge_complete' && parsedErrorMessage.parseStatus !== 'skipped_empty';\n\nconsole.log(JSON.stringify({\n  node: 'MERGE_POLICY_RESULT',\n  event,\n  source,\n  analyst: {\n    status: analystStatus,\n    outputError: analystOutputError,\n    contextErrorStatus,\n    contextErrorText,\n    jobId: analystOutput.jobId || (errorBody && errorBody.jobId) || null,\n    traceId: analystOutput.traceId || (errorBody && errorBody.traceId) || null\n  },\n  observed: {\n    outputType: typeof analystOutput.output,\n    parsedOutputType: parsedOutput ? typeof parsedOutput : null,\n    outputParseError,\n    resultParseError,\n    contextErrorMessageType: typeof errorMessageRaw,\n    errorMessageParseAttempts: includeErrorMessageParseDiagnostics ? parsedErrorMessage.parseAttempts : null,\n    errorMessageParseStatus: includeErrorMessageParseDiagnostics ? parsedErrorMessage.parseStatus : null,\n    errorMessageParseError: includeErrorMessageParseDiagnostics ? parsedErrorMessage.parseError : null\n  },\n  upsertStatus: policyUpsertStatus,\n  counts: {\n    baseMatchCount: baseMatches.length,\n    policyEntryCount: policyEntries.length,\n    mergedMatchCount: mergedMatches.length,\n    policyMatchedCount: mergedMatches.filter((m) => m && m.IsPolicyRuleBased === true).length,\n    omittedFieldCount: mergedMatches.filter((m) => m && m.IsPolicyRuleBased === true && !Object.prototype.hasOwnProperty.call(m, 'document_position') && !Object.prototype.hasOwnProperty.call(m, 'standard_position') && !Object.prototype.hasOwnProperty.call(m, 'deviation_summary')).length\n  },\n  durationMs: Date.now() - startedAt,\n  status: nodeStatus,\n  error: nodeError\n}));\n\nreturn result;\n",
