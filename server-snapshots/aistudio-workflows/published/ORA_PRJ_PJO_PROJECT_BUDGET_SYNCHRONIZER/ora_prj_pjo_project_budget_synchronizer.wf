                {
                  "metadata": {
                    "name": "Call Budget Planning Option BO",
                    "returnType": "object",
                    "sourceCode": "var currentItem = $context.$nodes.CHECK_ALL_THE_VERSION_WITH_SOURCE_AS_FPP.$currentItem;\nvar fppPlanVersionId = $context.$triggers.REST.$input.FPPplanVersionId;\nvar planningOptions = [];\n\nif (currentItem && currentItem.PlanningOptions) {\n  if (currentItem.PlanningOptions.items && currentItem.PlanningOptions.items.length !== undefined) {\n    planningOptions = currentItem.PlanningOptions.items;\n  } else if (currentItem.PlanningOptions.length !== undefined) {\n    planningOptions = currentItem.PlanningOptions;\n  }\n}\n\nvar expected = fppPlanVersionId == null ? \"\" : String(fppPlanVersionId);\nvar matches = [];\nvar i;\n\nfor (i = 0; i < planningOptions.length; i++) {\n  if (planningOptions[i] && planningOptions[i].GenSrcPlanVersionId != null && String(planningOptions[i].GenSrcPlanVersionId) == expected) {\n    matches[matches.length] = planningOptions[i];\n  }\n}\n\nreturn { count: matches.length, items: matches };",
                    "language": "JAVASCRIPT"
                  },
                  "outcomes": {
                    "success": "1773728812137"
                  },
