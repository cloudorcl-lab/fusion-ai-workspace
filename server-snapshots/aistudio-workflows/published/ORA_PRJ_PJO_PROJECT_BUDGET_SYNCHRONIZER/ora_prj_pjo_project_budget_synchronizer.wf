        {
          "metadata": {
            "name": "Get All current working PlanVersion Ids for the Budget",
            "returnType": "array",
            "sourceCode": "var input = $context.$nodes.GET_ALL_PROJECT_BUDGET_VERSIONS_FOR_CURRENT_WORKING.$output.items;\n\nvar items;\nif (input && input.length !== undefined) {\n  items = input;\n} else if (input && input.items && input.items.length !== undefined) {\n  items = input.items;\n} else {\n  items = [];\n}\n\nvar result = [];\nvar i;\n\nfor (i = 0; i < items.length; i++) {\n  if (items[i] && items[i].PlanVersionStatus == \"Current Working\") {\n    result[result.length] = {\n      PlanVersionId: items[i].PlanVersionId,\n      FinancialPlanType: items[i].FinancialPlanType,\n      PlanVersionNumber: items[i].PlanVersionNumber,\n      PCBurdenedCostAmounts: items[i].PCBurdenedCostAmounts,\n      PCRevenueAmounts: items[i].PCRevenueAmounts,\n      PlanVersionName: items[i].PlanVersionName,\n      PlanningOptions: items[i].PlanningOptions\n    };\n  }\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1773728246460"
          },
          "code": "GET_ALL_CURRENT_WORKING_PLANVERSION_IDS_FOR_THE_BUDGET",
          "id": "1773728149725",
          "inputs": [],
