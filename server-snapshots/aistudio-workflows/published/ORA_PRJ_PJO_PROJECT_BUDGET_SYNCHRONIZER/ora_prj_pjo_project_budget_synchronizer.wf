            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"projectBudgets response\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"items\", \"count\", \"hasMore\", \"limit\", \"offset\", \"links\"],\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"FinancialPlanType\",\n          \"PlanningAmounts\",\n          \"PlanVersionId\",\n          \"PlanVersionNumber\",\n          \"PlanVersionName\",\n          \"PlanVersionDescription\",\n          \"PlanVersionStatus\",\n          \"ProjectId\",\n          \"ProjectNumber\",\n          \"ProjectName\",\n          \"BudgetCreationMethod\",\n          \"SourcePlanVersionId\",\n          \"BudgetGenerationSource\",\n          \"SourcePlanType\",\n          \"SourcePlanVersionStatus\",\n          \"SourcePlanVersionNumber\",\n          \"LockedFlag\",\n          \"LockedBy\",\n          \"CopyAdjustmentPercentage\",\n          \"PCRawCostAmounts\",\n          \"PCBurdenedCostAmounts\",\n          \"PCRevenueAmounts\",\n          \"PFCRawCostAmounts\",\n          \"PFCBurdenedCostAmounts\",\n          \"PFCRevenueAmounts\",\n          \"DeferFinancialPlanCreation\",\n          \"AdministrativeCode\",\n          \"PlanningOptionId\",\n          \"ProjectResourcesStatus\",\n          \"RbsVersionId\",\n          \"PlanningResourceBreakdownStructure\",\n          \"links\"\n        ],\n        \"properties\": {\n          \"FinancialPlanType\": { \"type\": \"string\" },\n          \"PlanningAmounts\": { \"type\": \"string\" },\n\n          \"PlanVersionId\": { \"type\": \"integer\" },\n          \"PlanVersionNumber\": { \"type\": \"integer\" },\n          \"PlanVersionName\": { \"type\": \"string\" },\n          \"PlanVersionDescription\": { \"type\": \"string\" },\n          \"PlanVersionStatus\": { \"type\": \"string\" },\n\n          \"ProjectId\": { \"type\": \"integer\" },\n          \"ProjectNumber\": { \"type\": \"string\" },\n          \"ProjectName\": { \"type\": \"string\" },\n\n          \"BudgetCreationMethod\": { \"type\": \"string\" },\n          \"SourcePlanVersionId\": { \"type\": \"integer\" },\n          \"BudgetGenerationSource\": { \"type\": \"string\" },\n          \"SourcePlanType\": { \"type\": \"string\" },\n          \"SourcePlanVersionStatus\": { \"type\": \"string\" },\n          \"SourcePlanVersionNumber\": { \"type\": \"integer\" },\n\n          \"LockedFlag\": { \"type\": \"string\" },\n          \"LockedBy\": { \"type\": \"string\" },\n\n          \"CopyAdjustmentPercentage\": { \"type\": \"number\" },\n\n          \"PCRawCostAmounts\": { \"type\": \"number\" },\n          \"PCBurdenedCostAmounts\": { \"type\": \"number\" },\n          \"PCRevenueAmounts\": { \"type\": \"number\" },\n\n          \"PFCRawCostAmounts\": { \"type\": \"number\" },\n          \"PFCBurdenedCostAmounts\": { \"type\": \"number\" },\n          \"PFCRevenueAmounts\": { \"type\": \"number\" },\n\n          \"DeferFinancialPlanCreation\": { \"type\": \"string\" },\n          \"AdministrativeCode\": { \"type\": \"string\" },\n\n          \"PlanningOptionId\": { \"type\": \"integer\" },\n          \"ProjectResourcesStatus\": { \"type\": \"string\" },\n          \"RbsVersionId\": { \"type\": \"integer\" },\n\n          \"PlanningResourceBreakdownStructure\": { \"type\": \"string\" },\n\n          \"links\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"additionalProperties\": false,\n              \"required\": [\"rel\", \"href\", \"name\", \"kind\"],\n              \"properties\": {\n                \"rel\": { \"type\": \"string\" },\n                \"href\": { \"type\": \"string\", \"format\": \"uri\" },\n                \"name\": { \"type\": \"string\" },\n                \"kind\": { \"type\": \"string\" },\n                \"properties\": {\n                  \"type\": \"object\",\n                  \"additionalProperties\": true,\n                  \"properties\": {\n                    \"changeIndicator\": { \"type\": \"string\" }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n\n    \"count\": { \"type\": \"integer\", \"minimum\": 0 },\n    \"hasMore\": { \"type\": \"boolean\" },\n    \"limit\": { \"type\": \"integer\", \"minimum\": 0 },\n    \"offset\": { \"type\": \"integer\", \"minimum\": 0 },\n\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"rel\", \"href\", \"name\", \"kind\"],\n        \"properties\": {\n          \"rel\": { \"type\": \"string\" },\n          \"href\": { \"type\": \"string\", \"format\": \"uri\" },\n          \"name\": { \"type\": \"string\" },\n          \"kind\": { \"type\": \"string\" }\n        }\n      }\n    }\n  }\n}",
