        {
          "metadata": {
            "name": "Create End Date",
            "returnType": "string",
            "sourceCode": "const start = new Date($context.$system.$currentDate);\n\nconst end = new Date(start);\nend.setDate(start.getDate() + 90);\n\nconst endDate =\n  end.getFullYear() + '-' +\n  String(end.getMonth() + 1).padStart(2, '0') + '-' +\n  String(end.getDate()).padStart(2, '0');\n\nreturn endDate;"
          },
          "outcomes": {
            "success": "1771008191220"
          },
          "code": "CREATE_END_DATE",
