        {
          "metadata": {
            "name": "Invoke Action Decoder",
            "returnType": "string",
            "sourceCode": "let action = undefined;\nif ($context.$triggers.REST.$input.OraAction.includes(\"viewAbsence\"))\n  action = \"viewAbsence\";\nelse if ($context.$triggers.REST.$input.OraAction.includes(\"Bulk Approve Absences\"))\n  action = \"bulkApproveAbsences\";\nelse if ($context.$triggers.REST.$input.OraAction.includes(\"Approve Absence/Reassign Shift\"))\n  action = \"approveAbsReassignShift\";\nelse if ($context.$triggers.REST.$input.OraAction.includes(\"oraFormSubmit\"))\n  action = \"ApproveAndReassign\";\nelse if ($context.$triggers.REST.$input.OraAction.includes(\"approveAbsence\"))\n  action = \"approveAbsence\";\nelse if ($context.$triggers.REST.$input.OraAction.includes(\"rejectAbsence\"))\n  action = \"rejectAbsence\";\n\nreturn action;"
          },
          "outcomes": {
            "success": "1768243338319"
          },
          "code": "INVOKE_ACTION_DECODER",
          "id": "1768243186093",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Parse Action Payload",
            "returnType": "object",
            "sourceCode": "let parsed = $context.$nodes.INVOKE_ACTION_DECODER.$output.result;\nlet obj = null;\n\nif ( parsed != \"ApproveAndReassign\") {\n    obj = JSON.parse( $context.$app.$OraAction);\n}\n\nreturn obj;"
          },
          "outcomes": {
            "success": "1768242886973"
          },
          "code": "PARSE_ACTION_PAYLOAD",
          "id": "1768243338319",
