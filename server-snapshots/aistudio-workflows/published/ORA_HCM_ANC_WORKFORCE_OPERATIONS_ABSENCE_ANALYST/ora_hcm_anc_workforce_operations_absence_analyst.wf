            "viewAbsence": "1770745937572",
            "approveAbsence": "1772051218738",
            "rejectAbsence": "1772082271142"
          },
          "code": "ACTION_SWITCH",
          "convergenceTargetId": "end",
          "id": "1768242886973",
          "inputs": [
            {
              "id": "1768242886974_1",
