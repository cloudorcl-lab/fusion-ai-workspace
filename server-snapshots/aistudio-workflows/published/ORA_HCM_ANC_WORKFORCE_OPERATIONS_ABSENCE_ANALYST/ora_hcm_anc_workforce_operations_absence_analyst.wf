        },
        {
          "metadata": {
            "name": "ExtractReassignDetails",
            "returnType": "object",
            "sourceCode": "const str = $context.$triggers.REST.$input.OraAction;\nconst extractIds = (str) => {\n  const idMatch = str.match(\n    /ScheduleShiftId_(\\d+)_ScheduleId_(\\d+)/\n  );\n\n  const valueMatch = str.match(\n    /PersonId_(\\d+)_AssignmentId_(\\d+)/\n  );\n\n  return {\n    scheduleShiftId: idMatch?.[1],\n    scheduleId: idMatch?.[2],\n    personId: valueMatch?.[1],\n    assignmentId: valueMatch?.[2],\n  };\n};\n\nconst result = extractIds(str);\nreturn result;"
          },
          "outcomes": {
            "success": "1768330340198"
          },
          "code": "EXTRACTREASSIGNDETAILS",
          "id": "1768329744259",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
