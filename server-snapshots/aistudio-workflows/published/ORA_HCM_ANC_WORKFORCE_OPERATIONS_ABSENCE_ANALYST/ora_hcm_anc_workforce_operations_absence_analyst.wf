              "name": "pDisplayfieldsArray",
              "type": "string",
              "value": "[\n        \"AbsenceRequestId\",\n        \"PersonId\",\n        \"AssignmentId\",\n        \"BidPreference\",\n        \"BidFlag\",\n        \"AbsenceDisplayStatusCode\",\n        \"AbsenceDisplayStatusMeaning\",\n        \"AbsenceStartDateTime\",\n        \"AbsenceEndDateTime\",\n        \"SeniorityDate\",\n        \"PersonName\",\n        \"AssignmentName\",\n        \"DepartmentName\",\n        \"LocationName\",\n        \"Comments\",\n        \"BidId\",\n        \"CreatedBy\",\n        \"CreationDate\",\n        \"LastUpdatedBy\",\n        \"LastUpdateDate\",\n        \"AbsenceType\",\n        \"AbsenceStartDate\",\n        \"AbsenceEndDate\",\n        \"AbsenceFormattedDuration\",\n        \"AbsenceSubmissionDate\",\n        \"AbsenceConflict\"\n    ]"
            },
            {
              "id": "1770663240458_2",
              "name": "pFiltersArray",
              "type": "string",
              "value": "{{$context.$nodes.CONSTRUCT_ABSENCES.$output.result}}"
            },
            {
              "id": "1770663240459_3",
              "name": "pSearchfieldsArray",
              "type": "string",
              "value": "[]"
            },
            {
