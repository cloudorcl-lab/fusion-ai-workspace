              "type": "string",
              "value": "0"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Find Overlaps",
            "returnType": "array",
            "sourceCode": "const shifts = $context.$variables.shiftArray || [];\nconst absences = $context.$nodes.ABSENCE_REQUEST.$output.result.items\n\nconst absencesWithConflict = absences.map(absence => {\n  const absenceStart = new Date(absence.AbsenceStartDateTime);\n  const absenceEnd = new Date(absence.AbsenceEndDateTime);\n\n  const conflictingShifts = shifts.filter(shift => {\n    if (shift.PersonId !== absence.PersonId) return false;\n\n    const shiftStart = new Date(shift.ShiftStartDateTime);\n    const shiftEnd = new Date(shift.ShiftEndDateTime);\n\n    return absenceStart < shiftEnd && absenceEnd > shiftStart;\n  });\n\n  return {\n    ...absence,\n    shiftConflict: conflictingShifts.length > 0,\n    shiftDetails: conflictingShifts\n  };\n});\n\nreturn absencesWithConflict;"
          },
          "outcomes": {
            "success": "1760571175739"
          },
          "code": "FIND_OVERLAPS",
          "id": "1770664438125",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Format Overlap Actions",
            "returnType": "object",
            "sourceCode": "const arr = $context.$nodes.FIND_OVERLAPS.$output.result;\n\nconst result = arr.reduce(\n  (acc, item) => {\n    if (item.shiftConflict === true) {\n      acc.shiftConflicts.push({\n        ...item,\n        action: \"Approve Absence/Reassign Shift\"\n      });\n    } else if (item.AbsenceDisplayStatusCode === \"AWAITING\") {\n      acc.noShiftConflicts.push({\n        ...item,\n        action: \"Bulk Approve Absences\"\n      });\n    }\n    return acc;\n  },\n  {\n    shiftConflicts: [],\n    noShiftConflicts: []\n  }\n);\n\nreturn result;"
          },
          "outcomes": {
            "success": "1767912329234"
          },
          "code": "FORMAT_OVERLAP_ACTIONS",
          "id": "1770664750758",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
