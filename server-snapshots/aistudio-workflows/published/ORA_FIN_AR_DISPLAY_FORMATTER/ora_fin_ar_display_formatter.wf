        {
          "metadata": {
            "errorNodeId": "1774612546174",
            "name": "Validate Input",
            "returnType": "boolean",
            "sourceCode": "const workflowName = $context.$triggers.REST.$input.workflowName;\nconst isDebugEnabled = $context.$triggers.REST.$input.isDebugEnabled;\nconst displayTemplate = $context.$triggers.REST.$input.displayTemplate;\n\nconst message = $context.$system.$inputMessage;\n\nfunction isPlainObject(value) {\n  return value !== null && typeof value === \"object\" && !Array.isArray(value);\n}\n\nfunction isNonEmptyString(value) {\n  return typeof value === \"string\" && value.trim().length > 0;\n}\n\nfunction throwFormatterError(code, message, details) {\n  const error = new Error(\"[\" + code + \"] \" + message);\n  error.errorType = code;\n  error.details = details || {};\n  throw error;\n}\n\nfunction normalizeYesNo(value, fieldName) {\n  if (!isNonEmptyString(value)) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      fieldName + \" is required and must be either Y or N.\"\n    );\n  }\n\n  const normalizedValue = value.trim().toUpperCase();\n\n  if (normalizedValue !== \"Y\" && normalizedValue !== \"N\") {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      fieldName + \" must be either Y or N.\"\n    );\n  }\n\n  return normalizedValue;\n}\n\nif (isNonEmptyString(message)) {\n  throwFormatterError(\n    \"UNSUPPORTED_INTERACTION\",\n    \"I am unable to answer direct user inquiries. This assistant only supports predefined workflow executions.\"\n  );\n}\n\nif (!isNonEmptyString(workflowName)) {\n  throwFormatterError(\n    \"INVALID_REQUEST\",\n    \"workflowName is required. Provide the calling workflow name as a non-empty string.\"\n  );\n}\n\nconst normalizedIsDebugEnabled = normalizeYesNo(\n  isDebugEnabled,\n  \"isDebugEnabled\"\n);\n\nif (!isPlainObject(displayTemplate)) {\n  throwFormatterError(\n    \"INVALID_REQUEST\",\n    \"displayTemplate is required and must be an object. Return one valid display template object.\"\n  );\n}\n\nif (\n  !Array.isArray(displayTemplate.messages) ||\n  displayTemplate.messages.length === 0\n) {\n  throwFormatterError(\n    \"INVALID_REQUEST\",\n    \"displayTemplate.messages is required and must be a non-empty array.\"\n  );\n}\n\nreturn true;"
          },
