                        {
                          "metadata": {
                            "name": "Build Artifact Table Rows Chunk",
                            "returnType": "object",
                            "sourceCode": "/*\n  Summary:\n  - Read one planned artifact row chunk from the table chunk loop.\n  - Read shared validated table metadata from PLAN_TABLE_RENDERING.\n  - Preserve current table cell behavior for:\n    - plain text\n    - dateTemplate\n    - monetaryTemplate\n    - deepLinkTemplate\n    - badgeTemplate\n  - Normalize source keys so lookups remain resilient to case/spacing differences.\n  - Validate templated structured fields against the current chunk sample data.\n  - Render one chunk of artifact/full-table rows only.\n  - Return chunkIndex and renderedRows for downstream merge.\n*/\n\nconst currentChunk = $context.$nodes.AUTHOR_COMPONENTS.RENDER_ARTIFACT_TABLE_CHUNKS.$currentItem \n|| {};\nconst plannedRenderingRaw =\n  $context.$nodes.AUTHOR_COMPONENTS.PLAN_TABLE_RENDERING.$output.result;\n\nconst plannedRendering =\n  typeof plannedRenderingRaw === \"string\"\n    ? JSON.parse(plannedRenderingRaw)\n    : plannedRenderingRaw || {};\n\nconst ENABLE_ARTIFACT_BADGE_TOKEN = true;\n\nconst SUPPORTED_BADGE_STATUSES = [\n  \"success\",\n  \"danger\",\n  \"info\",\n  \"warning\",\n  \"neutral\",\n  \"neutralSubtle\",\n  \"dangerSubtle\",\n  \"successSubtle\",\n  \"warningSubtle\",\n  \"infoSubtle\"\n];\n\nfunction throwFormatterError(code, message, details) {\n  const error = new Error(\"[\" + code + \"] \" + message);\n  error.errorType = code;\n  error.details = details || {};\n  throw error;\n}\n\nfunction isPlainObject(value) {\n  return value !== null && typeof value === \"object\" && !Array.isArray(value);\n}\n\nfunction isBlank(value) {\n  return value === null || value === undefined || value === \"\";\n}\n\nfunction isNonEmptyString(value) {\n  return typeof value === \"string\" && value.trim().length > 0;\n}\n\nfunction normalizeKey(value) {\n  return String(value || \"\")\n    .replace(/[^a-zA-Z0-9]/g, \"\")\n    .toUpperCase();\n}\n\nfunction toCellString(value) {\n  return isBlank(value) ? \"\" : String(value);\n}\n\nfunction sanitizeTokenValue(value) {\n  return String(value || \"\")\n    .replace(/[{}]/g, \"\")\n    .replace(/,/g, \"\")\n    .trim();\n}\n\nfunction buildTokenObject(fields) {\n  const parts = [];\n  const keys = Object.keys(fields);\n\n  for (let index = 0; index < keys.length; index += 1) {\n    const key = keys[index];\n    const value = fields[key];\n\n    if (!isBlank(value)) {\n      parts.push(key + \":\" + sanitizeTokenValue(value));\n    }\n  }\n\n  return parts.join(\",\");\n}\n\nfunction parsePlanningContext(value) {\n  if (!isPlainObject(value)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"Planned table rendering context is missing or invalid.\"\n    );\n  }\n\n  if (!isPlainObject(value.sharedTableContext)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"PLAN_TABLE_RENDERING output is missing sharedTableContext.\"\n    );\n  }\n\n  const sharedTableContext = value.sharedTableContext;\n\n  if (!isPlainObject(sharedTableContext.transformSpec)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"sharedTableContext is missing transformSpec.\"\n    );\n  }\n\n  if (!isPlainObject(sharedTableContext.columnSpecByField)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"sharedTableContext is missing columnSpecByField.\"\n    );\n  }\n\n  if (!Array.isArray(sharedTableContext.columnOrder)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"sharedTableContext is missing columnOrder.\"\n    );\n  }\n\n  return sharedTableContext;\n}\n\nfunction parseCurrentChunk(value) {\n  if (!isPlainObject(value)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"Artifact chunk loop currentItem is missing or invalid.\"\n    );\n  }\n\n  if (!Number.isInteger(value.chunkIndex) || value.chunkIndex < 0) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"Artifact chunk is missing a valid chunkIndex.\"\n    );\n  }\n\n  if (!Array.isArray(value.rows)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"Artifact chunk is missing rows.\"\n    );\n  }\n\n  return value;\n}\n\nfunction buildNormalizedRow(rawRow) {\n  const normalizedRow = {};\n  const keys = Object.keys(rawRow || {});\n\n  for (let index = 0; index < keys.length; index += 1) {\n    const key = keys[index];\n    normalizedRow[normalizeKey(key)] = rawRow[key];\n  }\n\n  return normalizedRow;\n}\n\nfunction buildNormalizedRows(sourceRows) {\n  const normalizedRows = new Array(sourceRows.length);\n\n  for (let index = 0; index < sourceRows.length; index += 1) {\n    normalizedRows[index] = buildNormalizedRow(sourceRows[index]);\n  }\n\n  return normalizedRows;\n}\n\nfunction getSourceValue(normalizedRow, columnSpec) {\n  const sourceValue = normalizedRow[columnSpec.sourceField];\n\n  if (!isBlank(sourceValue)) {\n    return sourceValue;\n  }\n\n  if (!isBlank(columnSpec.defaultValue)) {\n    return columnSpec.defaultValue;\n  }\n\n  return \"\";\n}\n\nfunction buildValidationFieldList(columnSpecByField) {\n  const fields = Object.keys(columnSpecByField);\n  const validationFields = [];\n\n  for (let index = 0; index < fields.length; index += 1) {\n    const field = fields[index];\n    const template = columnSpecByField[field].template || \"\";\n\n    if (template) {\n      validationFields.push(field);\n    }\n  }\n\n  return validationFields;\n}\n\nfunction buildFirstMeaningfulValueByField(\n  normalizedRows,\n  columnSpecByField,\n  fieldsToScan\n) {\n  const firstValueByField = Object.create(null);\n  let remainingFieldCount = fieldsToScan.length;\n\n  for (\n    let rowIndex = 0;\n    rowIndex < normalizedRows.length && remainingFieldCount > 0;\n    rowIndex += 1\n  ) {\n    const normalizedRow = normalizedRows[rowIndex];\n\n    for (let fieldIndex = 0; fieldIndex < fieldsToScan.length; fieldIndex += 1) {\n      const field = fieldsToScan[fieldIndex];\n\n      if (Object.prototype.hasOwnProperty.call(firstValueByField, field)) {\n        continue;\n      }\n\n      const columnSpec = columnSpecByField[field];\n      const rawValue = getSourceValue(normalizedRow, columnSpec);\n\n      if (!isBlank(rawValue)) {\n        firstValueByField[field] = rawValue;\n        remainingFieldCount -= 1;\n      }\n    }\n  }\n\n  return firstValueByField;\n}\n\nfunction isLinkCell(value) {\n  return (\n    isPlainObject(value) &&\n    isNonEmptyString(value.label) &&\n    (\n      typeof value.href === \"undefined\" ||\n      value.href === null ||\n      typeof value.href === \"string\"\n    )\n  );\n}\n\nfunction hasRenderableHref(value) {\n  return typeof value.href === \"string\" && value.href.trim().length > 0;\n}\n\nfunction isBadgeCell(value) {\n  return (\n    isPlainObject(value) &&\n    isNonEmptyString(value.label) &&\n    isNonEmptyString(value.status)\n  );\n}\n\nfunction validateTemplateAgainstSampleValue(field, template, sampleValue) {\n  if (!template || isBlank(sampleValue)) {\n    return;\n  }\n\n  if (template === \"deepLinkTemplate\" && !isLinkCell(sampleValue)) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Column \" +\n        field +\n        \" is configured as deepLinkTemplate but the source value is not a valid link object.\"\n    );\n  }\n\n  if (template === \"badgeTemplate\" && !isBadgeCell(sampleValue)) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Column \" +\n        field +\n        \" is configured as badgeTemplate but the source value is not a valid badge object.\"\n    );\n  }\n}\n\nfunction buildPreparedColumnSpecByField(\n  baseColumnSpecByField,\n  firstMeaningfulValueByField\n) {\n  const preparedColumnSpecByField = Object.create(null);\n  const fields = Object.keys(baseColumnSpecByField);\n\n  for (let index = 0; index < fields.length; index += 1) {\n    const field = fields[index];\n    const baseColumnSpec = baseColumnSpecByField[field];\n    const sourceTemplate = baseColumnSpec.template || \"\";\n    const sampleValue = Object.prototype.hasOwnProperty.call(\n      firstMeaningfulValueByField,\n      field\n    )\n      ? firstMeaningfulValueByField[field]\n      : \"\";\n\n    validateTemplateAgainstSampleValue(field, sourceTemplate, sampleValue);\n\n    preparedColumnSpecByField[field] = {\n      ...baseColumnSpec,\n      template: sourceTemplate,\n      renderTemplate: sourceTemplate\n    };\n  }\n\n  return preparedColumnSpecByField;\n}\n\nfunction validateBadgeStatus(status) {\n  if (!SUPPORTED_BADGE_STATUSES.includes(status)) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Unsupported badge status: \" + status\n    );\n  }\n}\n\nfunction formatBadgeCell(rawValue) {\n  validateBadgeStatus(rawValue.status);\n\n  if (ENABLE_ARTIFACT_BADGE_TOKEN === false) {\n    return rawValue.label;\n  }\n\n  return (\n    \"{badge:{\" +\n    buildTokenObject({\n      text: rawValue.label,\n      status: rawValue.status\n    }) +\n    \"}}\"\n  );\n}\n\nfunction normalizeLinkInput(rawValue) {\n  if (isLinkCell(rawValue)) {\n    return {\n      label: rawValue.label,\n      href: typeof rawValue.href === \"string\" ? rawValue.href : \"\"\n    };\n  }\n\n  throwFormatterError(\n    \"INVALID_REQUEST\",\n    \"Link cell must be an object with non-empty label. href may be empty for plain text fallback.\"\n  );\n}\n\nfunction splitHrefParts(href) {\n  const text = String(href || \"\").trim();\n\n  if (!text) {\n    throwFormatterError(\"INVALID_REQUEST\", \"Link href is required.\");\n  }\n\n  const hashIndex = text.indexOf(\"#\");\n  const beforeHash = hashIndex >= 0 ? text.slice(0, hashIndex) : text;\n  const hash = hashIndex >= 0 ? text.slice(hashIndex) : \"\";\n\n  const queryIndex = beforeHash.indexOf(\"?\");\n  const pathPart = queryIndex >= 0 ? beforeHash.slice(0, queryIndex) : beforeHash;\n  const search = queryIndex >= 0 ? beforeHash.slice(queryIndex) : \"\";\n\n  return {\n    href: text,\n    pathPart,\n    search,\n    hash\n  };\n}\n\nfunction isAbsoluteHttpHref(href) {\n  return /^https?:\\/\\//i.test(String(href || \"\").trim());\n}\n\nfunction hasExplicitHost(href) {\n  return isAbsoluteHttpHref(href);\n}\n\nfunction extractHostFromAbsoluteHref(href) {\n  const text = String(href || \"\").trim();\n  const match = text.match(/^https?:\\/\\/([^\\/?#]+)(.*)?$/i);\n\n  if (!match) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Absolute link href must include a valid host: \" + text\n    );\n  }\n\n  return match[1];\n}\n\nfunction extractPathQueryHashFromAbsoluteHref(href) {\n  const text = String(href || \"\").trim();\n  const match = text.match(/^https?:\\/\\/[^\\/?#]+(\\/[^?#]*)?(\\?[^#]*)?(#.*)?$/i);\n\n  if (!match) {\n    return \"/\";\n  }\n\n  return (match[1] || \"/\") + (match[2] || \"\") + (match[3] || \"\");\n}\n\nfunction isDeeplinkHref(href) {\n  return String(href || \"\")\n    .toLowerCase()\n    .includes(\"deeplink\");\n}\n\nfunction classifyLinkHref(href) {\n  if (isDeeplinkHref(href)) {\n    return \"deeplink\";\n  }\n\n  if (!hasExplicitHost(href)) {\n    return \"relativeLink\";\n  }\n\n  return \"externalLink\";\n}\n\nfunction inferFamilyFromPath(path) {\n  const normalizedPath = String(path || \"\").toLowerCase();\n\n  if (/(^|\\/)hcmui\\//.test(normalizedPath)) {\n    return \"HCM\";\n  }\n\n  if (/(^|\\/)crmui\\//.test(normalizedPath)) {\n    return \"CRM\";\n  }\n\n  return \"FSCM\";\n}\n\nfunction stripLeadingSlash(path) {\n  return String(path || \"\").replace(/^\\/+/, \"\");\n}\n\nfunction stripUiShellPrefix(path) {\n  return String(path || \"\").replace(/^(fscmui|hcmui|crmui)\\//i, \"\");\n}\n\nfunction normalizeRelativeHref(href) {\n  const parts = splitHrefParts(href);\n  let normalizedPath = parts.pathPart + parts.search + parts.hash;\n\n  normalizedPath = stripLeadingSlash(normalizedPath);\n  normalizedPath = stripUiShellPrefix(normalizedPath);\n\n  return normalizedPath;\n}\n\nfunction getQueryParamValue(href, key) {\n  const parts = splitHrefParts(href);\n  const query = parts.search.startsWith(\"?\")\n    ? parts.search.slice(1)\n    : parts.search;\n\n  if (!query) {\n    return \"\";\n  }\n\n  const pairs = query.split(\"&\");\n\n  for (let index = 0; index < pairs.length; index += 1) {\n    const pair = pairs[index];\n\n    if (!pair) {\n      continue;\n    }\n\n    const equalIndex = pair.indexOf(\"=\");\n    const rawKey = equalIndex >= 0 ? pair.slice(0, equalIndex) : pair;\n    const rawValue = equalIndex >= 0 ? pair.slice(equalIndex + 1) : \"\";\n\n    if (decodeURIComponent(rawKey) === key) {\n      return decodeURIComponent(rawValue);\n    }\n  }\n\n  return \"\";\n}\n\nfunction buildRelativeLinkToken(rawValue) {\n  const link = normalizeLinkInput(rawValue);\n  const normalizedUrl = normalizeRelativeHref(link.href);\n  const family = inferFamilyFromPath(link.href);\n\n  return (\n    \"{relativeLink:{\" +\n    buildTokenObject({\n      url: normalizedUrl,\n      text: link.label,\n      family\n    }) +\n    \"}}\"\n  );\n}\n\nfunction buildDeeplinkToken(rawValue) {\n  const link = normalizeLinkInput(rawValue);\n  const objType = getQueryParamValue(link.href, \"objType\");\n  const action = getQueryParamValue(link.href, \"action\");\n  const objKey = getQueryParamValue(link.href, \"objKey\");\n  const pathWithQuery = hasExplicitHost(link.href)\n    ? extractPathQueryHashFromAbsoluteHref(link.href)\n    : normalizeRelativeHref(link.href);\n  const family = inferFamilyFromPath(pathWithQuery);\n\n  if (!isNonEmptyString(objType) || !isNonEmptyString(action)) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Deep link href must include objType and action: \" + link.href\n    );\n  }\n\n  return (\n    \"{deeplink:{\" +\n    buildTokenObject({\n      objType,\n      action,\n      ...(isNonEmptyString(objKey) ? { objKey } : {}),\n      text: link.label,\n      family,\n      ...(hasExplicitHost(link.href)\n        ? { host: extractHostFromAbsoluteHref(link.href) }\n        : {})\n    }) +\n    \"}}\"\n  );\n}\n\nfunction buildExternalLinkToken(rawValue) {\n  const link = normalizeLinkInput(rawValue);\n\n  if (!hasExplicitHost(link.href)) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"External link href must include a host: \" + link.href\n    );\n  }\n\n  return (\n    \"{externalLink:{\" +\n    buildTokenObject({\n      url: extractPathQueryHashFromAbsoluteHref(link.href),\n      text: link.label,\n      host: extractHostFromAbsoluteHref(link.href)\n    }) +\n    \"}}\"\n  );\n}\n\nfunction formatLinkCell(rawValue) {\n  const link = normalizeLinkInput(rawValue);\n\n  if (!hasRenderableHref(link)) {\n    return link.label;\n  }\n\n  const linkKind = classifyLinkHref(link.href);\n\n  if (linkKind === \"deeplink\") {\n    return buildDeeplinkToken(link);\n  }\n\n  if (linkKind === \"relativeLink\") {\n    return buildRelativeLinkToken(link);\n  }\n\n  return buildExternalLinkToken(link);\n}\n\nfunction extractDatePortion(value) {\n  if (isBlank(value)) {\n    return \"\";\n  }\n\n  if (value instanceof Date && !Number.isNaN(value.getTime())) {\n    return value.toISOString().slice(0, 10);\n  }\n\n  const text = String(value).trim();\n  const match = text.match(/^(\\d{4}-\\d{2}-\\d{2})(?:[T\\s].*)?$/);\n\n  return match ? match[1] : \"\";\n}\n\nfunction makeDateToken(value) {\n  return \"{date:\" + value + \"}\";\n}\n\nfunction makeAmountToken(amountValue, currencyValue) {\n  return \"{amount:\" + amountValue + \",currency:\" + currencyValue + \"}\";\n}\n\nfunction formatPlainCell(rawValue) {\n  if (isPlainObject(rawValue)) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Unsupported structured table cell shape. Supported structured shapes are link {label, href} and badge {label, status}.\"\n    );\n  }\n\n  return toCellString(rawValue);\n}\n\nfunction formatDateCell(rawValue) {\n  const normalizedDate = extractDatePortion(rawValue);\n  return normalizedDate ? makeDateToken(normalizedDate) : \"\";\n}\n\nfunction formatMonetaryCell(rawValue, normalizedRow, columnConfig) {\n  const currencyValue = normalizedRow[columnConfig.currencySourceField];\n\n  if (isBlank(currencyValue)) {\n    return \"\";\n  }\n\n  return makeAmountToken(rawValue, currencyValue);\n}\n\nfunction formatPrimitiveCellValue(rawValue, normalizedRow, columnConfig) {\n  if (columnConfig.formatterType === \"date\") {\n    return formatDateCell(rawValue);\n  }\n\n  if (columnConfig.formatterType === \"monetary\") {\n    return formatMonetaryCell(rawValue, normalizedRow, columnConfig);\n  }\n\n  return formatPlainCell(rawValue);\n}\n\nfunction formatStructuredCell(rawValue, columnConfig) {\n  if (columnConfig.formatterType === \"link\") {\n    return formatLinkCell(rawValue);\n  }\n\n  if (columnConfig.formatterType === \"badge\") {\n    return formatBadgeCell(rawValue);\n  }\n\n  return null;\n}\n\nfunction formatCellValue(normalizedRow, columnConfig) {\n  const rawValue = getSourceValue(normalizedRow, columnConfig);\n\n  if (isBlank(rawValue)) {\n    return \"\";\n  }\n\n  const structuredCellValue = formatStructuredCell(rawValue, columnConfig);\n\n  if (structuredCellValue !== null) {\n    return structuredCellValue;\n  }\n\n  return formatPrimitiveCellValue(rawValue, normalizedRow, columnConfig);\n}\n\nfunction compileColumnConfigs(columnOrder, columnSpecByField) {\n  const compiledColumns = new Array(columnOrder.length);\n\n  for (let index = 0; index < columnOrder.length; index += 1) {\n    const field = columnOrder[index];\n    const columnSpec = columnSpecByField[field];\n    const renderTemplate = columnSpec.renderTemplate || columnSpec.template || \"\";\n\n    let formatterType = \"plain\";\n\n    if (renderTemplate === \"dateTemplate\") {\n      formatterType = \"date\";\n    } else if (renderTemplate === \"monetaryTemplate\") {\n      formatterType = \"monetary\";\n    } else if (renderTemplate === \"deepLinkTemplate\") {\n      formatterType = \"link\";\n    } else if (renderTemplate === \"badgeTemplate\") {\n      formatterType = \"badge\";\n    }\n\n    compiledColumns[index] = {\n      ...columnSpec,\n      renderTemplate,\n      formatterType\n    };\n  }\n\n  return compiledColumns;\n}\n\nfunction buildRenderedRows(normalizedRows, compiledColumns) {\n  const renderedRows = new Array(normalizedRows.length);\n\n  for (let rowIndex = 0; rowIndex < normalizedRows.length; rowIndex += 1) {\n    const normalizedRow = normalizedRows[rowIndex];\n    const renderedRow = {};\n\n    for (let columnIndex = 0; columnIndex < compiledColumns.length; columnIndex += 1) {\n      const columnConfig = compiledColumns[columnIndex];\n      renderedRow[columnConfig.field] = formatCellValue(\n        normalizedRow,\n        columnConfig\n      );\n    }\n\n    renderedRows[rowIndex] = renderedRow;\n  }\n\n  return renderedRows;\n}\n\nconst sharedTableContext = parsePlanningContext(plannedRendering);\nconst chunk = parseCurrentChunk(currentChunk);\nconst normalizedRows = buildNormalizedRows(chunk.rows);\nconst validationFields = buildValidationFieldList(\n  sharedTableContext.columnSpecByField\n);\nconst firstMeaningfulValueByField = buildFirstMeaningfulValueByField(\n  normalizedRows,\n  sharedTableContext.columnSpecByField,\n  validationFields\n);\nconst preparedColumnSpecByField = buildPreparedColumnSpecByField(\n  sharedTableContext.columnSpecByField,\n  firstMeaningfulValueByField\n);\nconst compiledColumns = compileColumnConfigs(\n  sharedTableContext.columnOrder,\n  preparedColumnSpecByField\n);\n\nreturn {\n  chunkIndex: chunk.chunkIndex,\n  renderedRows: buildRenderedRows(normalizedRows, compiledColumns)\n};"
                          },
