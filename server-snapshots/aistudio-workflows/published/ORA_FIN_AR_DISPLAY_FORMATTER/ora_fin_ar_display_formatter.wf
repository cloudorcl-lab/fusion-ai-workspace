                {
                  "metadata": {
                    "name": "Plan Table Rendering",
                    "returnType": "object",
                    "sourceCode": "/*\n  Summary:\n  - Read the prepared table transform context produced by PREPARE_TABLE_TRANSFORM.\n  - Preserve all shared table metadata exactly once for both artifact and root rendering.\n  - Split artifact/full table rows into fixed-size row chunks.\n  - Build root preview rows separately from artifact rows.\n  - Enforce the agreed row policies:\n    - artifact/full table supports up to 500 rows\n    - artifact rows are chunked at 100 rows per chunk\n    - root preview never exceeds 20 rows\n  - Keep root preview semantics aligned to chatDisplayConfig while still applying the hard root max.\n  - Return a clean internal planning contract for downstream chunk rendering and root rendering.\n*/\n\nconst currentItem = $context.$nodes.AUTHOR_COMPONENTS.$currentItem || {};\nconst preparedTransformRaw =\n  $context.$nodes.AUTHOR_COMPONENTS.PREPARE_TABLE_TRANSFORM.$output.result;\n\nconst preparedTransform =\n  typeof preparedTransformRaw === \"string\"\n    ? JSON.parse(preparedTransformRaw)\n    : preparedTransformRaw || {};\n\nconst ARTIFACT_CHUNK_SIZE_ROWS = 100;\nconst MAX_ARTIFACT_ROWS = 500;\nconst MAX_ROOT_ROWS_HARD = 20;\nconst DEFAULT_ROOT_TABLE_ROW_LIMIT = 10;\n\nfunction throwFormatterError(code, message, details) {\n  const error = new Error(\"[\" + code + \"] \" + message);\n  error.errorType = code;\n  error.details = details || {};\n  throw error;\n}\n\nfunction isPlainObject(value) {\n  return value !== null && typeof value === \"object\" && !Array.isArray(value);\n}\n\nfunction parsePreparedTransformContext(value) {\n  if (!isPlainObject(value)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"Prepared table transform context is missing or invalid.\"\n    );\n  }\n\n  if (!isPlainObject(value.transformSpec)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"Prepared table transform context is missing transformSpec.\"\n    );\n  }\n\n  if (!isPlainObject(value.columnSpecByField)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"Prepared table transform context is missing columnSpecByField.\"\n    );\n  }\n\n  if (!Array.isArray(value.columnOrder)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"Prepared table transform context is missing columnOrder.\"\n    );\n  }\n\n  if (!Array.isArray(value.sourceRows)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"Prepared table transform context is missing sourceRows.\"\n    );\n  }\n\n  return value;\n}\n\nfunction resolveRootPreviewConfig(transformSpec) {\n  const chatDisplayConfig =\n    isPlainObject(transformSpec.chatDisplayConfig)\n      ? transformSpec.chatDisplayConfig\n      : {};\n\n  const limitRowsInChat =\n    typeof chatDisplayConfig.limitRowsInChat === \"boolean\"\n      ? chatDisplayConfig.limitRowsInChat\n      : true;\n\n  const configuredRowLimit =\n    typeof chatDisplayConfig.rowLimit === \"number\" &&\n    Number.isInteger(chatDisplayConfig.rowLimit) &&\n    chatDisplayConfig.rowLimit >= 0\n      ? chatDisplayConfig.rowLimit\n      : DEFAULT_ROOT_TABLE_ROW_LIMIT;\n\n  const requestedRowLimit = limitRowsInChat\n    ? configuredRowLimit\n    : Number.POSITIVE_INFINITY;\n\n  return {\n    limitRowsInChat,\n    configuredRowLimit,\n    requestedRowLimit\n  };\n}\n\nfunction resolveArtifactRows(sourceRows) {\n  if (sourceRows.length <= MAX_ARTIFACT_ROWS) {\n    return {\n      rows: sourceRows,\n      wasTrimmed: false\n    };\n  }\n\n  return {\n    rows: sourceRows.slice(0, MAX_ARTIFACT_ROWS),\n    wasTrimmed: true\n  };\n}\n\nfunction resolveRootPreviewRows(sourceRows, rootPreviewConfig) {\n  const appliedRowLimit = Math.min(\n    sourceRows.length,\n    rootPreviewConfig.requestedRowLimit,\n    MAX_ROOT_ROWS_HARD\n  );\n\n  return {\n    rows: sourceRows.slice(0, appliedRowLimit),\n    appliedRowLimit,\n    wasTrimmed: sourceRows.length > appliedRowLimit\n  };\n}\n\nfunction buildArtifactChunks(rows) {\n  const chunks = [];\n\n  for (\n    let startRowIndex = 0, chunkIndex = 0;\n    startRowIndex < rows.length;\n    startRowIndex += ARTIFACT_CHUNK_SIZE_ROWS, chunkIndex += 1\n  ) {\n    const endRowIndexExclusive = Math.min(\n      startRowIndex + ARTIFACT_CHUNK_SIZE_ROWS,\n      rows.length\n    );\n\n    chunks.push({\n      chunkIndex,\n      startRowIndex,\n      endRowIndexExclusive,\n      rows: rows.slice(startRowIndex, endRowIndexExclusive)\n    });\n  }\n\n  return chunks;\n}\n\nfunction buildPlanningMetadata(\n  sourceRows,\n  artifactRowsResult,\n  rootPreviewRowsResult,\n  rootPreviewConfig,\n  artifactChunks,\n  columnOrder\n) {\n  return {\n    artifactChunkSizeRows: ARTIFACT_CHUNK_SIZE_ROWS,\n    maxArtifactRows: MAX_ARTIFACT_ROWS,\n    maxRootRowsHard: MAX_ROOT_ROWS_HARD,\n    originalRowCount: sourceRows.length,\n    artifactRowCount: artifactRowsResult.rows.length,\n    rootPreviewRowCount: rootPreviewRowsResult.rows.length,\n    renderedColumnCount: columnOrder.length,\n    chunkCount: artifactChunks.length,\n    artifactRowsWereTrimmed: artifactRowsResult.wasTrimmed,\n    rootRowsWereTrimmed: rootPreviewRowsResult.wasTrimmed,\n    rootPreviewConfig: {\n      limitRowsInChat: rootPreviewConfig.limitRowsInChat,\n      configuredRowLimit: rootPreviewConfig.configuredRowLimit,\n      requestedRowLimit:\n        rootPreviewConfig.requestedRowLimit === Number.POSITIVE_INFINITY\n          ? \"unbounded\"\n          : rootPreviewConfig.requestedRowLimit,\n      appliedRowLimit: rootPreviewRowsResult.appliedRowLimit\n    }\n  };\n}\n\nconst preparedContext = parsePreparedTransformContext(preparedTransform);\nconst sourceRows = preparedContext.sourceRows;\nconst rootPreviewConfig = resolveRootPreviewConfig(\n  preparedContext.transformSpec\n);\nconst artifactRowsResult = resolveArtifactRows(sourceRows);\nconst rootPreviewRowsResult = resolveRootPreviewRows(\n  sourceRows,\n  rootPreviewConfig\n);\nconst artifactChunks = buildArtifactChunks(artifactRowsResult.rows);\n\nreturn {\n  id: currentItem.id || preparedContext.id || \"\",\n  sharedTableContext: {\n    transformSpec: preparedContext.transformSpec,\n    columnSpecByField: preparedContext.columnSpecByField,\n    columnOrder: preparedContext.columnOrder,\n    accessibility: preparedContext.accessibility\n  },\n  artifactChunks,\n  rootPreviewRows: rootPreviewRowsResult.rows,\n  planningMetadata: buildPlanningMetadata(\n    sourceRows,\n    artifactRowsResult,\n    rootPreviewRowsResult,\n    rootPreviewConfig,\n    artifactChunks,\n    preparedContext.columnOrder\n  )\n};"
                  },
