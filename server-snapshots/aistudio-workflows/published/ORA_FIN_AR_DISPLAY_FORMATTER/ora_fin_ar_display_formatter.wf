                  "metadata": {
                    "name": "Build Canvas Payload",
                    "returnType": "object",
                    "sourceCode": "const currentItemRaw = $context.$nodes.AUTHOR_COMPONENTS.$currentItem;\n\nfunction parseIfString(value) {\n  let parsed = value;\n\n  while (typeof parsed === \"string\") {\n    parsed = JSON.parse(parsed);\n  }\n\n  return parsed;\n}\n\nfunction throwFormatterError(code, message, details) {\n  const error = new Error(\"[\" + code + \"] \" + message);\n  error.errorType = code;\n  error.details = details || {};\n  throw error;\n}\n\nconst item = parseIfString(currentItemRaw);\n\nif (!item || typeof item !== \"object\") {\n  throwFormatterError(\n    \"INVALID_REQUEST\",\n    \"AUTHOR_COMPONENTS currentItem is missing or invalid.\"\n  );\n}\n\nif (!item.id) {\n  throwFormatterError(\n    \"INVALID_REQUEST\",\n    \"Canvas component id is required.\"\n  );\n}\n\nif (item.type !== \"canvas\") {\n  throwFormatterError(\n    \"INVALID_REQUEST\",\n    \"Canvas passthrough node received non-canvas component type: \" + item.type\n  );\n}\n\nif (typeof item.data === \"undefined\") {\n  throwFormatterError(\n    \"INVALID_REQUEST\",\n    \"Canvas component must include data: \" + item.id\n  );\n}\n\nreturn {\n  id: item.id,\n  authoredPayload: item.data\n};"
                  },
