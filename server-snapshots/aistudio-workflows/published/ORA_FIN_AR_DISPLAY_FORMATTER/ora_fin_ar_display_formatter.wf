                  "metadata": {
                    "name": "Merge Table Payload Chunks",
                    "returnType": "object",
                    "sourceCode": "/*\n  Summary:\n  - Read rendered artifact chunk outputs from the artifact chunk loop.\n  - Read shared validated table metadata from PLAN_TABLE_RENDERING.\n  - Read rootAuthoredPayload from BUILD_ROOT_TABLE_PAYLOAD.\n  - Merge artifact chunk rows in chunkIndex order.\n  - Build one final authoredPayload for the full/artifact table.\n  - Preserve the current outward authored component contract:\n    - id\n    - authoredPayload\n    - rootAuthoredPayload\n  - Keep chunking fully internal so downstream nodes remain unchanged.\n*/\n\nconst chunkOutputsRaw = $context.$nodes.AUTHOR_COMPONENTS.RENDER_ARTIFACT_TABLE_CHUNKS.$output;\nconst plannedRenderingRaw =\n  $context.$nodes.AUTHOR_COMPONENTS.PLAN_TABLE_RENDERING.$output.result;\nconst rootPayloadRaw =\n  $context.$nodes.AUTHOR_COMPONENTS.BUILD_ROOT_TABLE_PAYLOAD.$output.result;\n\nconst plannedRendering =\n  typeof plannedRenderingRaw === \"string\"\n    ? JSON.parse(plannedRenderingRaw)\n    : plannedRenderingRaw || {};\n\nconst rootPayloadResult =\n  typeof rootPayloadRaw === \"string\"\n    ? JSON.parse(rootPayloadRaw)\n    : rootPayloadRaw || {};\n\nfunction throwFormatterError(code, message, details) {\n  const error = new Error(\"[\" + code + \"] \" + message);\n  error.errorType = code;\n  error.details = details || {};\n  throw error;\n}\n\nfunction isPlainObject(value) {\n  return value !== null && typeof value === \"object\" && !Array.isArray(value);\n}\n\nfunction normalizeKey(value) {\n  return String(value || \"\")\n    .replace(/[^a-zA-Z0-9]/g, \"\")\n    .toUpperCase();\n}\n\nfunction parsePlanningContext(value) {\n  if (!isPlainObject(value)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"Planned table rendering context is missing or invalid.\"\n    );\n  }\n\n  if (!isPlainObject(value.sharedTableContext)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"PLAN_TABLE_RENDERING output is missing sharedTableContext.\"\n    );\n  }\n\n  const sharedTableContext = value.sharedTableContext;\n\n  if (!isPlainObject(sharedTableContext.transformSpec)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"sharedTableContext is missing transformSpec.\"\n    );\n  }\n\n  if (!isPlainObject(sharedTableContext.columnSpecByField)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"sharedTableContext is missing columnSpecByField.\"\n    );\n  }\n\n  if (!Array.isArray(sharedTableContext.columnOrder)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"sharedTableContext is missing columnOrder.\"\n    );\n  }\n\n  return value;\n}\n\nfunction parseRootPayloadResult(value) {\n  if (!isPlainObject(value)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"BUILD_ROOT_TABLE_PAYLOAD output is missing or invalid.\"\n    );\n  }\n\n  if (!isPlainObject(value.rootAuthoredPayload)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"BUILD_ROOT_TABLE_PAYLOAD output is missing rootAuthoredPayload.\"\n    );\n  }\n\n  return value;\n}\n\nfunction unwrapChunkOutput(value, index) {\n  let parsed = value;\n  let unwrapDepth = 0;\n\n  while (typeof parsed === \"string\") {\n    try {\n      parsed = JSON.parse(parsed);\n    } catch (error) {\n      throwFormatterError(\n        \"PROCESSING_ERROR\",\n        \"Failed to parse stringified artifact chunk output at index \" + index + \".\",\n        {\n          index,\n          parseMessage: error.message\n        }\n      );\n    }\n  }\n\n  while (\n    parsed &&\n    typeof parsed === \"object\" &&\n    !Array.isArray(parsed) &&\n    typeof parsed.result !== \"undefined\"\n  ) {\n    if (parsed.error) {\n      throwFormatterError(\n        \"PROCESSING_ERROR\",\n        \"Artifact chunk output failed before merge at index \" + index + \".\",\n        {\n          index,\n          upstreamError: parsed.error\n        }\n      );\n    }\n\n    parsed = parsed.result;\n    unwrapDepth += 1;\n\n    if (unwrapDepth > 10) {\n      throwFormatterError(\n        \"PROCESSING_ERROR\",\n        \"Artifact chunk output exceeded supported wrapper depth.\",\n        { index }\n      );\n    }\n\n    while (typeof parsed === \"string\") {\n      try {\n        parsed = JSON.parse(parsed);\n      } catch (error) {\n        throwFormatterError(\n          \"PROCESSING_ERROR\",\n          \"Failed to parse nested stringified artifact chunk output at index \" + index + \".\",\n          {\n            index,\n            parseMessage: error.message\n          }\n        );\n      }\n    }\n  }\n\n  return parsed;\n}\n\nfunction parseChunkOutputs(value) {\n  if (!Array.isArray(value)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"Artifact chunk loop output is invalid. Expected an array.\"\n    );\n  }\n\n  const unwrappedOutputs = new Array(value.length);\n\n  for (let index = 0; index < value.length; index += 1) {\n    const parsedChunk = unwrapChunkOutput(value[index], index);\n\n    if (!isPlainObject(parsedChunk)) {\n      throwFormatterError(\n        \"PROCESSING_ERROR\",\n        \"Artifact chunk output is missing or invalid after unwrap.\",\n        { index }\n      );\n    }\n\n    if (!Number.isInteger(parsedChunk.chunkIndex) || parsedChunk.chunkIndex < 0) {\n      throwFormatterError(\n        \"PROCESSING_ERROR\",\n        \"Artifact chunk output is missing a valid chunkIndex.\",\n        { index, value: parsedChunk }\n      );\n    }\n\n    if (!Array.isArray(parsedChunk.renderedRows)) {\n      throwFormatterError(\n        \"PROCESSING_ERROR\",\n        \"Artifact chunk output is missing renderedRows.\",\n        { index, chunkIndex: parsedChunk.chunkIndex }\n      );\n    }\n\n    unwrappedOutputs[index] = parsedChunk;\n  }\n\n  return unwrappedOutputs;\n}\n\nfunction buildColumns(columnOrder, columnSpecByField) {\n  const columns = new Array(columnOrder.length);\n\n  for (let index = 0; index < columnOrder.length; index += 1) {\n    const field = columnOrder[index];\n    const columnSpec = columnSpecByField[field];\n\n    columns[index] = {\n      headerText: columnSpec.headerText,\n      field: columnSpec.field,\n      className: columnSpec.className || \"\",\n      resizable: columnSpec.resizable || \"enabled\",\n      id: columnSpec.field,\n      template: columnSpec.template || \"\"\n    };\n  }\n\n  return columns;\n}\n\nfunction buildKeyAttributes(transformSpec, columnSpecByField, columnOrder) {\n  if (\n    Array.isArray(transformSpec.keyAttributes) &&\n    transformSpec.keyAttributes.length > 0\n  ) {\n    const keyAttributes = new Array(transformSpec.keyAttributes.length);\n\n    for (let index = 0; index < transformSpec.keyAttributes.length; index += 1) {\n      keyAttributes[index] = normalizeKey(transformSpec.keyAttributes[index]);\n    }\n\n    return keyAttributes;\n  }\n\n  let fallbackField = columnOrder[0];\n\n  for (let index = 0; index < columnOrder.length; index += 1) {\n    if (/ID|NUMBER/.test(columnOrder[index])) {\n      fallbackField = columnOrder[index];\n      break;\n    }\n  }\n\n  if (!columnSpecByField[fallbackField]) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"Unable to derive a valid key attribute.\"\n    );\n  }\n\n  return [fallbackField];\n}\n\nfunction mergeArtifactRows(chunkOutputs) {\n  const sortedOutputs = chunkOutputs.slice().sort((left, right) => {\n    return left.chunkIndex - right.chunkIndex;\n  });\n\n  const seenChunkIndexes = new Set();\n  const mergedRows = [];\n\n  for (let index = 0; index < sortedOutputs.length; index += 1) {\n    const output = sortedOutputs[index];\n\n    if (seenChunkIndexes.has(output.chunkIndex)) {\n      throwFormatterError(\n        \"PROCESSING_ERROR\",\n        \"Duplicate artifact chunkIndex encountered during merge: \" + output.chunkIndex\n      );\n    }\n\n    seenChunkIndexes.add(output.chunkIndex);\n\n    for (let rowIndex = 0; rowIndex < output.renderedRows.length; rowIndex += 1) {\n      mergedRows.push(output.renderedRows[rowIndex]);\n    }\n  }\n\n  return mergedRows;\n}\n\nconst planningContext = parsePlanningContext(plannedRendering);\nconst sharedTableContext = planningContext.sharedTableContext;\nconst parsedRootPayload = parseRootPayloadResult(rootPayloadResult);\nconst parsedChunkOutputs = parseChunkOutputs(chunkOutputsRaw);\nconst mergedArtifactRows = mergeArtifactRows(parsedChunkOutputs);\nconst keyAttributes = buildKeyAttributes(\n  sharedTableContext.transformSpec,\n  sharedTableContext.columnSpecByField,\n  sharedTableContext.columnOrder\n);\n\nreturn {\n  id: parsedRootPayload.id || planningContext.id || \"\",\n  authoredPayload: {\n    type: \"table\",\n    headerText:\n      sharedTableContext.transformSpec.headerText ||\n      sharedTableContext.transformSpec.heading ||\n      \"\",\n    rows: {\n      items: mergedArtifactRows\n    },\n    columns: {\n      items: buildColumns(\n        sharedTableContext.columnOrder,\n        sharedTableContext.columnSpecByField\n      )\n    },\n    keyAttributes: {\n      items: keyAttributes\n    },\n    ...(sharedTableContext.accessibility\n      ? { accessibility: sharedTableContext.accessibility }\n      : {})\n  },\n  rootAuthoredPayload: parsedRootPayload.rootAuthoredPayload\n};"
                  },
