        {
          "metadata": {
            "errorNodeId": "1774612546174",
            "name": "Append Authored Components",
            "returnType": "object",
            "sourceCode": "/*\n  Summary:\n  - Read authored component outputs produced by the AUTHOR_COMPONENTS loop.\n  - Normalize each loop result into one authored component payload object.\n  - Validate that each authored component has:\n    - a component id\n    - an authoredPayload\n  - Merge authoredPayload into the matching component inside authoredDisplayPlan.\n  - Preserve rootAuthoredPayload separately as component.rootData when present.\n  - Return the fully merged authoredDisplayPlan for final assembly.\n  - Surface the real upstream failure with index and raw output preview.\n*/\n\ntry {\n  const outputs = $context.$nodes.AUTHOR_COMPONENTS.$output;\n  const plan = $context.$variables.authoredDisplayPlan;\n\n  function throwFormatterError(code, message, details) {\n    const error = new Error(\"[\" + code + \"] \" + message);\n    error.errorType = code;\n    error.details = details || {};\n    throw error;\n  }\n\n  function safeCloneForDebug(value) {\n    try {\n      return JSON.parse(JSON.stringify(value));\n    } catch (error) {\n      return String(value);\n    }\n  }\n\n  function buildPreview(value) {\n    const text = String(value || \"\");\n    return text.length > 500 ? text.slice(0, 500) + \"...\" : text;\n  }\n\n  if (!plan || typeof plan !== \"object\" || !Array.isArray(plan.components)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"authoredDisplayPlan is missing or invalid before authored component merge.\"\n    );\n  }\n\n  if (!Array.isArray(outputs)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"AUTHOR_COMPONENTS output is invalid. Expected an array of authored component results.\",\n      { outputType: typeof outputs }\n    );\n  }\n\n  function unwrapAuthoredComponent(value, index) {\n    let parsed = value;\n    let unwrapDepth = 0;\n\n    while (typeof parsed === \"string\") {\n      try {\n        parsed = JSON.parse(parsed);\n      } catch (error) {\n        throwFormatterError(\n          \"PROCESSING_ERROR\",\n          \"Failed to parse stringified authored component output at loop index \" + index + \".\",\n          {\n            index,\n            rawPreview: buildPreview(parsed),\n            parseMessage: error.message\n          }\n        );\n      }\n    }\n\n    while (\n      parsed &&\n      typeof parsed === \"object\" &&\n      !Array.isArray(parsed) &&\n      typeof parsed.result !== \"undefined\"\n    ) {\n      if (parsed.error) {\n        throwFormatterError(\n          \"PROCESSING_ERROR\",\n          \"AUTHOR_COMPONENTS entry failed before merge at loop index \" + index + \".\",\n          {\n            index,\n            upstreamError: parsed.error,\n            value: safeCloneForDebug(parsed)\n          }\n        );\n      }\n\n      parsed = parsed.result;\n      unwrapDepth += 1;\n\n      if (unwrapDepth > 10) {\n        throwFormatterError(\n          \"PROCESSING_ERROR\",\n          \"AUTHOR_COMPONENTS entry exceeded supported wrapper depth.\",\n          {\n            index,\n            value: safeCloneForDebug(value)\n          }\n        );\n      }\n\n      while (typeof parsed === \"string\") {\n        try {\n          parsed = JSON.parse(parsed);\n        } catch (error) {\n          throwFormatterError(\n            \"PROCESSING_ERROR\",\n            \"Failed to parse nested stringified authored component output at loop index \" + index + \".\",\n            {\n              index,\n              rawPreview: buildPreview(parsed),\n              parseMessage: error.message\n            }\n          );\n        }\n      }\n    }\n\n    return parsed;\n  }\n\n  for (let i = 0; i < outputs.length; i += 1) {\n    const authoredComponent = unwrapAuthoredComponent(outputs[i], i);\n\n    if (\n      !authoredComponent ||\n      typeof authoredComponent !== \"object\" ||\n      !authoredComponent.id\n    ) {\n      throwFormatterError(\n        \"PROCESSING_ERROR\",\n        \"An authored component result is missing id.\",\n        { index: i, value: safeCloneForDebug(authoredComponent) }\n      );\n    }\n\n    if (typeof authoredComponent.authoredPayload === \"undefined\") {\n      throwFormatterError(\n        \"PROCESSING_ERROR\",\n        \"An authored component result is missing authoredPayload.\",\n        {\n          index: i,\n          componentId: authoredComponent.id,\n          value: safeCloneForDebug(authoredComponent)\n        }\n      );\n    }\n\n    const component = plan.components.find(\n      (item) => item && item.id === authoredComponent.id\n    );\n\n    if (!component) {\n      throwFormatterError(\n        \"PROCESSING_ERROR\",\n        \"Authored component id was not found in authoredDisplayPlan.components.\",\n        {\n          index: i,\n          missingComponentId: authoredComponent.id,\n          availableComponentIds: plan.components.map((item) =>\n            item && item.id ? item.id : null\n          )\n        }\n      );\n    }\n\n    component.data = authoredComponent.authoredPayload;\n\n    if (typeof authoredComponent.rootAuthoredPayload !== \"undefined\") {\n      component.rootData = authoredComponent.rootAuthoredPayload;\n    }\n  }\n\n  return plan;\n} catch (error) {\n  if (error && error.errorType) {\n    throw error;\n  }\n\n  throwFormatterError(\n    \"PROCESSING_ERROR\",\n    \"Unexpected failure while merging authored component payloads.\",\n    {\n      message: error && error.message ? error.message : String(error)\n    }\n  );\n}"
