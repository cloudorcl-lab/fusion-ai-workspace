                  "code": "CHECK_PREAUTHORED_TABLE",
                  "convergenceTargetId": "end_1774441309277",
                  "id": "1775981700000",
                  "inputs": [
                    {
                      "id": "1775981700000_1",
                      "name": "condition",
                      "type": "string",
                      "value": "{{$context.$nodes.AUTHOR_COMPONENTS.$currentItem.formattingMode === \"preAuthored\"}}"
                    }
                  ],
                  "type": "CONDITION"
                },
                {
                  "metadata": {
                    "errorNodeId": "1774612546174",
                    "name": "Build Pre-authored Table Payload",
                    "returnType": "object",
                    "sourceCode": "/*\n  Summary:\n  - Build a table payload directly for trusted callers that already know the row shape and column order.\n  - Avoid the LLM table-authoring path for deterministic, workflow-owned tables.\n  - Keep the output compatible with the existing formatter assembler: authoredPayload is the full canvas table and rootAuthoredPayload is the chat preview table.\n*/\n\nconst MONETARY_FIELD_HINTS = [\n  \"AMOUNT\",\n  \"BALANCE\",\n  \"RECEIPT\",\n  \"PAYMENT\",\n  \"SURPLUS\",\n  \"DEFICIT\",\n  \"TARGET\",\n  \"VARIANCE\",\n  \"CASHPOSITION\"\n];\n\nfunction clone(value) {\n  return JSON.parse(JSON.stringify(value));\n}\n\nfunction isPlainObject(value) {\n  return value !== null && typeof value === \"object\" && !Array.isArray(value);\n}\n\nfunction isNonEmptyString(value) {\n  return typeof value === \"string\" && value.trim().length > 0;\n}\n\nfunction normalizeNumberOrNull(value) {\n  if (typeof value === \"number\") {\n    return Number.isFinite(value) ? value : null;\n  }\n\n  if (typeof value === \"string\" && value.trim().length) {\n    const numericValue = Number(value.replace(/,/g, \"\"));\n    return Number.isFinite(numericValue) ? numericValue : null;\n  }\n\n  return null;\n}\n\nfunction titleCase(field) {\n  return String(field || \"\")\n    .replace(/_/g, \" \")\n    .replace(/([a-z])([A-Z])/g, \"$1 $2\")\n    .split(/\\s+/)\n    .filter(Boolean)\n    .map((word) => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())\n    .join(\" \");\n}\n\nfunction getColumnOrder(item, rows) {\n  if (Array.isArray(item.columnOrder) && item.columnOrder.length) {\n    return item.columnOrder.filter(isNonEmptyString).map((field) => field.trim());\n  }\n\n  if (rows.length && isPlainObject(rows[0])) {\n    return Object.keys(rows[0]).filter((field) => field.charAt(0) !== \"_\");\n  }\n\n  return [];\n}\n\nfunction isDateField(field) {\n  return /Date$/.test(field) && !/DateTime$/.test(field);\n}\n\nfunction isMonetaryField(field) {\n  const normalized = String(field || \"\").replace(/[^a-zA-Z]/g, \"\").toUpperCase();\n  if (!normalized || /(COUNT|DAYS|ID|FLAG|DATE|TIME)$/.test(normalized)) {\n    return false;\n  }\n\n  return MONETARY_FIELD_HINTS.some((hint) => normalized.includes(hint));\n}\n\nfunction resolveCurrencyCode(row) {\n  const candidates = [\n    row.Currency,\n    row.BalanceCurrency,\n    row.CurrencyCode,\n    row.TransactionCurrency,\n    row.currency,\n    row.accountCurrency\n  ];\n\n  for (const value of candidates) {\n    if (typeof value === \"string\" && /^[A-Z]{3}$/.test(value.trim())) {\n      return value.trim();\n    }\n  }\n\n  return \"\";\n}\n\nfunction formatDateToken(value) {\n  if (value === null || value === undefined || value === \"\") {\n    return \"\";\n  }\n\n  const raw = String(value).trim();\n  const dateMatch = raw.match(/^([0-9]{4}-[0-9]{2}-[0-9]{2})/);\n  if (dateMatch) {\n    return \"{date:\" + dateMatch[1] + \"}\";\n  }\n\n  const parsed = new Date(raw);\n  if (!Number.isNaN(parsed.getTime())) {\n    return \"{date:\" + parsed.toISOString().slice(0, 10) + \"}\";\n  }\n\n  return raw;\n}\n\nfunction formatCellValue(row, field) {\n  const value = row[field];\n  if (value === null || value === undefined) {\n    return \"\";\n  }\n\n  const numericValue = isMonetaryField(field) ? normalizeNumberOrNull(value) : null;\n  const currencyCode = resolveCurrencyCode(row);\n  if (numericValue !== null && currencyCode) {\n    return \"{amount:\" + numericValue + \",currency:\" + currencyCode + \"}\";\n  }\n\n  if (isDateField(field)) {\n    return formatDateToken(value);\n  }\n\n  if (typeof value === \"string\") {\n    return value;\n  }\n\n  return String(value);\n}\n\nfunction buildRows(rows, columnOrder) {\n  return rows.map((row) => {\n    const outputRow = {};\n    columnOrder.forEach((field) => {\n      outputRow[field] = formatCellValue(row, field);\n    });\n    return outputRow;\n  });\n}\n\nfunction buildColumns(columnOrder) {\n  return columnOrder.map((field) => ({\n    headerText: titleCase(field) || field,\n    field,\n    id: field,\n    resizable: \"enabled\",\n    className: \"\",\n    template: isMonetaryField(field)\n      ? \"monetaryTemplate\"\n      : isDateField(field)\n        ? \"dateTemplate\"\n        : \"\"\n  }));\n}\n\nfunction buildKeyAttributes(columnOrder, rows) {\n  const preferred = [\n    [\"LegalEntity\", \"Currency\"],\n    [\"LegalEntity\", \"BankAccount\", \"Currency\"],\n    [\"BankAccount\", \"Currency\"],\n    [\"LegalEntity\"],\n    [\"BankAccount\"]\n  ];\n\n  const available = new Set(columnOrder);\n  for (const candidate of preferred) {\n    if (!candidate.every((field) => available.has(field))) {\n      continue;\n    }\n\n    const seen = new Set();\n    let unique = true;\n    for (const row of rows) {\n      const key = candidate.map((field) => String(row[field] || \"\")).join(\"||\");\n      if (seen.has(key)) {\n        unique = false;\n        break;\n      }\n      seen.add(key);\n    }\n\n    if (unique) {\n      return { items: candidate };\n    }\n  }\n\n  return { items: columnOrder.length ? [columnOrder[0]] : [] };\n}\n\nfunction normalizeChatDisplayConfig(config) {\n  const source = isPlainObject(config) ? config : {};\n  const limitRowsInChat = typeof source.limitRowsInChat === \"boolean\" ? source.limitRowsInChat : true;\n  const rowLimit = Number.isInteger(source.rowLimit) && source.rowLimit >= 0 ? source.rowLimit : 5;\n  return { limitRowsInChat, rowLimit };\n}\n\nfunction buildPayload(item, rows, columnOrder, rowLimit, limitRows) {\n  const formattedRows = buildRows(rows, columnOrder);\n  const visibleRows = limitRows ? formattedRows.slice(0, rowLimit) : formattedRows;\n  const columns = buildColumns(columnOrder);\n  const keyAttributes = buildKeyAttributes(columnOrder, formattedRows);\n  const headerText = isNonEmptyString(item.title) ? item.title.trim() : \"Details\";\n\n  return {\n    type: \"table\",\n    headerText,\n    rows: { items: visibleRows },\n    columns: { items: columns },\n    keyAttributes,\n    accessibility: {\n      \"aria-label\": \"Table showing \" + headerText\n    }\n  };\n}\n\nconst currentItem = $context.$nodes.AUTHOR_COMPONENTS.$currentItem || {};\nconst rows = Array.isArray(currentItem.data) ? currentItem.data.filter(isPlainObject) : [];\nconst columnOrder = getColumnOrder(currentItem, rows);\nconst chatDisplayConfig = normalizeChatDisplayConfig(currentItem.chatDisplayConfig);\n\nif (!currentItem.id || !rows.length || !columnOrder.length) {\n  throw new Error(\"Invalid pre-authored table component input.\");\n}\n\nreturn {\n  id: currentItem.id,\n  authoredPayload: buildPayload(currentItem, rows, columnOrder, rows.length, false),\n  rootAuthoredPayload: buildPayload(\n    currentItem,\n    rows,\n    columnOrder,\n    chatDisplayConfig.rowLimit,\n    chatDisplayConfig.limitRowsInChat\n  )\n};"
                  },
                  "outcomes": {
                    "success": "end_1774441309277"
                  },
                  "code": "BUILD_PREAUTHORED_TABLE_PAYLOAD",
                  "id": "1775981701000",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "errorNodeId": "1774612546174",
                    "name": "Build Table Context",
                    "returnType": "object",
                    "sourceCode": "/*\n  Summary:\n  - Read the current table component context.\n  - Normalize source row keys into a stable format for LLM consumption.\n  - Build the effective column order from component metadata or the first row.\n  - Build one representative sample row by filling each column with the first meaningful value found across source rows.\n  - Return a compact table context payload for downstream table authoring.\n*/\n\nfunction normalizeKey(value) {\n  return String(value || \"\")\n    .replace(/[^a-zA-Z0-9]/g, \"\")\n    .toUpperCase();\n}\n\nfunction isMeaningful(value) {\n  return value !== null && value !== undefined && value !== \"\";\n}\n\n// Normalize source row keys so the LLM sees a stable shape such as\n// RECEIPTNUMBER instead of mixed forms like \"Receipt Number\" or \"receiptNumber\".\nfunction buildNormalizedRow(rawRow) {\n  const normalizedRow = {};\n\n  Object.keys(rawRow || {}).forEach((key) => {\n    normalizedRow[normalizeKey(key)] = rawRow[key];\n  });\n\n  return normalizedRow;\n}\n\n// Respect an explicit column order when present.\n// Otherwise, fall back to the key order from the first row.\nfunction buildColumnOrder(currentItem, rawRows) {\n  if (Array.isArray(currentItem.columnOrder) && currentItem.columnOrder.length > 0) {\n    return currentItem.columnOrder.map(normalizeKey);\n  }\n\n  const firstRow = rawRows[0] || {};\n  return Object.keys(firstRow).map(normalizeKey);\n}\n\n// Build one representative sample row by filling each display column with the\n// first meaningful value found across the normalized source rows.\nfunction buildRepresentativeSampleRow(rows, preferredKeys) {\n  const sampleRow = {};\n  let filledColumnCount = 0;\n\n  rows.forEach((row) => {\n    preferredKeys.forEach((key) => {\n      if (isMeaningful(sampleRow[key])) {\n        return;\n      }\n\n      if (isMeaningful(row[key])) {\n        sampleRow[key] = row[key];\n        filledColumnCount += 1;\n      }\n    });\n  });\n\n  if (filledColumnCount === 0 && rows.length > 0) {\n    return rows[0];\n  }\n\n  return sampleRow;\n}\n\nconst currentItem = $context.$nodes.AUTHOR_COMPONENTS.$currentItem || {};\nconst rawRows = Array.isArray(currentItem.data) ? currentItem.data : [];\n\n// Normalize the full row set once so we can derive both column order and a\n// representative sample row from a consistent key format.\nconst normalizedRows = rawRows.map(buildNormalizedRow);\nconst columnOrder = buildColumnOrder(currentItem, rawRows);\nconst sampleRow = buildRepresentativeSampleRow(normalizedRows, columnOrder);\n\n// Return a compact payload for the LLM instead of the full dataset.\nreturn {\n  id: currentItem.id || \"\",\n  title: currentItem.title || \"\",\n  authoringHints: currentItem.authoringHints || \"\",\n  columnOrder,\n  rowCount: rawRows.length,\n  sampleRow\n};"
                  },
