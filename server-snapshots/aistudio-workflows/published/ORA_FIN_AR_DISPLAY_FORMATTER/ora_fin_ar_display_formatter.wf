                {
                  "metadata": {
                    "errorNodeId": "1774612546174",
                    "name": "Build Pre-authored Action Payload",
                    "returnType": "object",
                    "sourceCode": "/*\n  Summary:\n  - Build an action payload directly for trusted callers.\n  - Avoid the LLM action-authoring path for deterministic workflow-owned actions.\n*/\n\nfunction isPlainObject(value) {\n  return value !== null && typeof value === \"object\" && !Array.isArray(value);\n}\n\nfunction isNonEmptyString(value) {\n  return typeof value === \"string\" && value.trim().length > 0;\n}\n\nfunction normalizeActionItems(data) {\n  if (Array.isArray(data)) {\n    return data.filter(isNonEmptyString).map((item) => item.trim());\n  }\n\n  if (isPlainObject(data) && Array.isArray(data.items)) {\n    return data.items.filter(isNonEmptyString).map((item) => item.trim());\n  }\n\n  return [];\n}\n\nconst currentItem = $context.$nodes.AUTHOR_COMPONENTS.$currentItem || {};\nconst actions = normalizeActionItems(currentItem.data);\n\nif (!currentItem.id || !actions.length) {\n  throw new Error(\"Invalid pre-authored action component input.\");\n}\n\nreturn {\n  id: currentItem.id,\n  authoredPayload: {\n    actions: {\n      items: actions\n    }\n  }\n};"
                  },
                  "outcomes": {
                    "success": "end_1774441309277"
                  },
                  "code": "BUILD_PREAUTHORED_ACTION_PAYLOAD",
                  "id": "1775981711000",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
