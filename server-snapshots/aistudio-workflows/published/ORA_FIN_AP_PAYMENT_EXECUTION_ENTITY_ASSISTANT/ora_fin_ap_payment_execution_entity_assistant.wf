        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_PAYABLES_PAYMENTENTITYRECOGNITIONSERVICE",
            "functionName": "get_named_entities_with_usecase",
            "name": "NER Service Invocation"
          },
          "outcomes": {
            "success": "1770726907797"
          },
          "code": "FIN_AP_BO_NER_SERVICE_INVOCATION",
          "id": "1766052381734",
          "inputs": [
            {
              "id": "1768373282014_1",
              "name": "payload",
              "type": "string",
              "value": "{{$context.$nodes.FIN_AP_CODE_CONSTRUCT_NER_PAYLOAD.$output.result}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Get Entity Names",
            "returnType": "array",
            "sourceCode": "const data = $context.$nodes.FIN_AP_BO_NER_SERVICE_INVOCATION.$output;\nconst matches = data.matches || [];\nlet hasUnique = false;\nlet uniqueEntities = [];\nlet perfectScoreAmbiguous = [];\nlet ambiguousEntities = [];\n\nfor (const match of matches) {\n  if (match.matchStatus === \"unique\") {\n    hasUnique = true;\n    uniqueEntities = uniqueEntities.concat(match.entities);\n  } else if (match.matchStatus === \"ambiguous\") {\n    for (const entity of match.entities) {\n      if (entity.score === 100) {\n        perfectScoreAmbiguous.push(entity);\n      } else {\n        ambiguousEntities.push(entity);\n      }\n    }\n  }\n}\n\nlet output = [];\nif (hasUnique) {\n  output = uniqueEntities\n    .concat(perfectScoreAmbiguous)\n    .sort((a, b) => b.score - a.score)\n    .map(entity => ({\n      entity: entity.entity,\n      id: entity.id,\n      name: entity.name,\n      score: entity.score\n    }));\n} else if (ambiguousEntities.length > 0 || perfectScoreAmbiguous.length > 0) {\n  const allAmbiguous = perfectScoreAmbiguous.concat(\n    ambiguousEntities.filter(entity => entity.score > 70)\n  );\n  if (allAmbiguous.length > 0) {\n    output = allAmbiguous\n      .sort((a, b) => b.score - a.score)\n      .map(entity => ({\n        entity: entity.entity,\n        id: entity.id,\n        name: entity.name,\n        score: entity.score\n      }));\n  }\n}\nreturn output;"
          },
          "outcomes": {
            "success": "1767766048714"
          },
          "code": "FIN_AP_CODE_GET_ENTITY_NAMES",
          "id": "1766052460912",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
