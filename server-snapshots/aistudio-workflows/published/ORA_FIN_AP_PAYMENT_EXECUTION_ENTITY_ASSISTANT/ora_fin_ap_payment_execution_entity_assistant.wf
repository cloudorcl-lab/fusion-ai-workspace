        {
          "metadata": {
            "name": "Parsing Code for Drilldown Use Case",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.FIN_AP_BO_NER_SERVICE_INVOCATION.$output;\nconst matches = data.matches || [];\n\nconst allEntities = matches.flatMap(match => match.entities || []);\n\nconst output = allEntities\n  .filter(entity => entity.score > 70)\n  .sort((a, b) => b.score - a.score)\n  .map(entity => ({\n    entity: entity.entity,\n    id: entity.id,\n    name: entity.name,\n    score: entity.score\n  }));\n\nreturn output;"
          },
          "outcomes": {
            "success": "1770727258495"
          },
