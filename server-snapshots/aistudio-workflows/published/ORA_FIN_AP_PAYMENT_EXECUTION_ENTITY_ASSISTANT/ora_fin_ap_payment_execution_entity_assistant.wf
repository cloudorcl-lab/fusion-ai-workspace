        {
          "metadata": {
            "name": "Construct NER Payload",
            "returnType": "object",
            "sourceCode": "const userInput = $context.$system.$inputMessage;\nconst useCaseKey = $context.$triggers.REST.$input.useCaseKey;\nconst keywords = $context.$triggers.REST.$input.keywords;\n\nconst payload = { limit: 20 };\n\nif (userInput) {\n  payload.input = userInput;\n}\nif (useCaseKey) {\n  payload.useCaseKey = useCaseKey;\n}\nif (keywords) {\n  payload.keywords = keywords;\n}\n\nreturn payload;"
          },
          "outcomes": {
            "success": "1766052381734"
          },
