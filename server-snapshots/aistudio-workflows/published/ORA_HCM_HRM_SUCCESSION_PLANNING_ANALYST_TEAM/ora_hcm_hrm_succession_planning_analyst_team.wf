        },
        {
          "metadata": {
            "name": "Extract Person Name"
          },
          "outcomes": {
            "success": "1773943761924"
          },
          "diagram": {
            "x": 5855,
            "y": 5206
          },
          "code": "EXTRACT_PERSON_NAME",
          "convergenceTargetId": "1772142220001",
          "id": "1772142590070",
          "inputs": [
            {
              "id": "1772142590073_1",
              "name": "prompt",
              "type": "string",
              "value": "Extract personName and personNumber from {{$context.$system.$inputMessage}}.  Do not derive person number from person name.  Unless person number is explicitly mentioned, set it to \"\".  Set withinMyTeam to true only when the user explicitly refers to the user's own team or organization, using first-person ownership language such as:\n- \"my team\"\n- \"my organization\"\n- \"under me\"\n- \"my direct reports\"\n- \"on my team\"\n- \"reports to me\"\n\nSet withinMyTeam to false when the text refers to another person's team, even if it contains phrases like:\n- \"James Douglas's direct reports\"\n- \"his team\"\n- \"their reports\"\n- \"Connor's team\"\n\nExamples:\n- Who are the employees who are critical under <person name>?\n- List the critical employees in my team\n- Show me all employees with high risk of loss within <person name>'s team\n- Show me all at-risk employees within <person name>'s organization\n- What happens if <person name> moves out of her role hypothetically? \n- <person name> is planning to move to a different department. Who can we promote in place of <person name>?"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"personName\": {\n            \"type\": \"string\"\n        },\n        \"personNumber\": {\n            \"type\": \"string\"\n        },\n        \"withinMyTeam\": {\n            \"type\": \"boolean\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "If personName or personNumber Provided"
          },
          "outcomes": {
            "true": "1776063020812",
            "false": "1772142220001"
          },
          "diagram": {
            "x": 5804,
            "y": 5428
          },
          "code": "IF_PERSONNAME_PROVIDED",
          "convergenceTargetId": "1772142220001",
          "id": "1773943761924",
          "inputs": [
            {
              "id": "1773943761925_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_PERSON_NAME.$output.personName !== '' || $context.$nodes.EXTRACT_PERSON_NAME.$output.personNumber !== ''}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Get Complete vQuery",
            "returnType": "string",
            "sourceCode": "let query = \"\";\nlet searchFields = \"\";\nlet personNumber = $context.$nodes.EXTRACT_PERSON_NAME.$output.personNumber;\nlet personName = $context.$nodes.EXTRACT_PERSON_NAME.$output.personName;\nif (personNumber.length > 0) {\n    query = '\"query\": \"' + personNumber + '\"';\n    searchFields = '\"searchFields\": [ \"PersonNumber\" ]';\n}\nelse {\n    query = '\"query\": \"' + personName + '\"';\n    searchFields = '\"searchFields\": [ \"DisplayName\" ]';\n}\nlet filters = '\"filters\": [{ \"name\": \"PrimaryAssignmentOnly\", \"value\": \"True\"}';\nif ( $context.$nodes.EXTRACT_PERSON_NAME.$output.withinMyTeam ) {\n    filters += ', {\"name\": \"Reports\", \"value\": \"ALL\"}';\n}\nfilters += ']';\nlet securityFilters = '\"securityFilters\": {\"type\": \"PersonSearch\", \"value\": \"AdvancedSearch\"}';\nlet displayFields = '\"displayFields\": [\"DisplayName\", \"PersonId\", \"PersonNumber\", \"AssignmentId\", \"AssignmentNumber\", \"BusinessTitle\", \"ManagerDisplayName\", \"AssignmentUserStatus\", \"WorkerType\", \"WorkEmail\", \"WorkPhone\"]';\n\nreturn '{' + query + ',' + searchFields + ',' + filters + ',' + securityFilters + ',' + displayFields + '}';"
          },
          "outcomes": {
            "success": "1773952083554"
          },
          "diagram": {
            "x": 5346.90642615558,
            "y": 5603.172491544532
          },
          "code": "GET_COMPLETE_VQUERY",
          "id": "1776063020812",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
