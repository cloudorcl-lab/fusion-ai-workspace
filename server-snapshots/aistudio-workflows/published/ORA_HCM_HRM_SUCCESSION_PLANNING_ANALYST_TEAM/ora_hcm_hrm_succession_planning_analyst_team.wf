            "name": "Get readinessCandidates count for each readinessLevel",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.GET_AT_RISK_SUCCESSION_PLANS.$output;\nconst results = [];\nconst employeeMap = new Map();\nfor (let i = 0; i < data.items.length; i++) {\n\n    const emp = data.items[i];\n    const displayName = emp.DisplayName;\n\n    if (!employeeMap.has(displayName)) { \n        employeeMap.set(displayName, {\n            displayName,\n            readinessCodesWithSuccessors: new Set()\n        });\n    }\n    \n    const employeeAgg = employeeMap.get(displayName);\n    const successionPlans = emp.successionPlans.items;\n\n    for (let j = 0; j < successionPlans.length; j++) {\n\n        const plan = successionPlans[j];\n        const planName = plan.PlanName;\n\n        const readinessLevels = plan.readinessLevels.items;\n\n        for (let k = 0; k < readinessLevels.length; k++) {\n\n            const readinessLevel = readinessLevels[k];\n            const readinessCode = readinessLevel.ReadinessCode;\n\n            const candidateCount =\n                readinessLevel.readinessCandidates.items.length;\n\n            results.push({\n                DisplayName: displayName,\n                PlanName: planName,\n                ReadinessCode: readinessCode,\n                CandidateCount: candidateCount\n            });\n\n            if (candidateCount > 0) {\n              employeeAgg.readinessCodesWithSuccessors.add(readinessCode);\n            }\n        }\n    }\n}\n\nconst totalDirectReports = employeeMap.size;\n\nconst readinessCounts = {};\nfor (const emp of employeeMap.values()) {\n    for (const code of emp.readinessCodesWithSuccessors) {\n        readinessCounts[code] = (readinessCounts[code] || 0) + 1;\n    }\n}\n\nconst readinessPercentages = {};\nfor (const [code, count] of Object.entries(readinessCounts)) {\n    readinessPercentages[code] = totalDirectReports === 0\n        ? 0\n        : Number(((count / totalDirectReports) * 100).toFixed(1));\n}\n\nreturn {\n  details: results,\n  summary: {\n          totalDirectReports,\n          readinessCounts,\n          readinessPercentages\n    }\n};"
          },
          "outcomes": {
            "success": "1777273205850"
          },
          "diagram": {
            "x": 6416.594137542277,
            "y": 7815.089064261557
          },
          "code": "GET_READINESSCANDIDATES_COUNT_FOR_EACH_READINESSLEVEL",
          "id": "1777704919617",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Show at-risk succession plans"
          },
