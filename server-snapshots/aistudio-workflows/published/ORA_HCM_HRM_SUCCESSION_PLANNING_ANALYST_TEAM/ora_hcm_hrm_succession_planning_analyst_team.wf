{
  "workflowId": "300000331068268",
  "workflowCode": "ORA_HCM_HRM_SUCCESSION_PLANNING_ANALYST_TEAM",
  "name": "Succession Planning Analyst",
  "description": "Analyzes the succession related Talent Profile ratings such as risk of loss, impact of loss, and mobility and identifies team members who don't have any succession plans created for them. It also analyzes the efficacy of succession planning for a person who has left the organization.",
  "specification": {
    "dataPipeline": {
      "pipelineNodes": [
