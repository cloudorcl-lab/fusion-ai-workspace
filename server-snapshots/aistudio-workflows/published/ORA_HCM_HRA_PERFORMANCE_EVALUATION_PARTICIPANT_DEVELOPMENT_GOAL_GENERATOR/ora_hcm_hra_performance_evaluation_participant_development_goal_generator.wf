                  },
                  "code": "IFCHECKITEMVSSUMMARY",
                  "convergenceTargetId": "1765792776479",
                  "id": "1765792708987",
                  "inputs": [
                    {
                      "id": "1765792708988_1",
                      "name": "condition",
                      "type": "string",
