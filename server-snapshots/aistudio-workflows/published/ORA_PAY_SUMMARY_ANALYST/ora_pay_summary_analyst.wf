        {
          "metadata": {
            "name": "E9 Arrears NT Reason"
          },
          "outcomes": {
            "success": "1762510080548"
          },
          "code": "E9_ARREARS_NT_REASON",
          "id": "1764923725037",
          "inputs": [
            {
              "id": "1764923725038_1",
              "name": "prompt",
              "type": "string",
              "value": "{{$context.$variables.llmPersona}} \n\n# Payroll Run Results Arrears data \n {{$context.$nodes.E9_GET_RUN_RESULTS_ARREARS.$output}}\n\n# Payroll Run Results Not Taken data\n {{$context.$nodes.E9_GET_RUN_RESULTS_NT.$output }}\n\n# Exception Logic:\nReview the provided data. If any run result has a non-zero value for the input value \"Not Taken\" or \"Arrear\", flag this as an exception. Ignore any run results for the input value \"Clear Arrears\" in this logic. If there are no non-zero values for \"Not Taken\" or \"Arrear\", it is not an exception.\n\n# Exception Reporting format:\nIf an exception is found, group the results by element. Start your response with:\n    \"There is an exception due to partial deduction for the following element(s):\"\n    Then list the element name, input value name, and amount for each exception.\nIf no exception is found, output:\n    \"No exception due to partial deduction in this payroll calculation.\"\n\n{{$context.$variables.llmSysPrompt}}"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_GLOBALPAY_PAYROLLCALCULATIONENTRIESHISTORY",
            "functionName": "get_calculation_entries_history",
            "name": "E10 Get Calc History"
          },
          "outcomes": {
            "success": "1764923919969"
          },
          "code": "E10_GET_CALC_HISTORY",
          "id": "1764923861325",
          "inputs": [
            {
              "id": "1767359036040_1",
