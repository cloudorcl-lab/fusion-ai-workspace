          },
          "outcomes": {
            "success": "1763368188145"
          },
          "code": "GET_FIRST_ASSIGNMENT",
          "id": "1767358886497",
          "inputs": [
            {
              "id": "1767358912549_1",
              "name": "personId",
              "type": "integer",
              "value": "{{$context.$nodes.GET_PERSON_ID.$output.items[0].PersonId}}"
