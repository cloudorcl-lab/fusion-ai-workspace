              "type": "number",
              "value": "{{$context.$variables.assignmentId}}"
            },
            {
              "id": "1767359036042_3",
              "name": "pEffectiveStartDate",
              "type": "string",
              "value": "{{$context.$nodes.GET_VALIDATION_DATES.$output.EarnStartDate}}"
            },
            {
