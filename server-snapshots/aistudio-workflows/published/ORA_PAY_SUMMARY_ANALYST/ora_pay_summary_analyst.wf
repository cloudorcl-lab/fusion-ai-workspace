          "code": "E8_COSTING_REASON",
          "id": "1764940135918",
          "inputs": [
            {
              "id": "1764940135921_1",
              "name": "prompt",
              "type": "string",
              "value": "{{$context.$variables.llmPersona}} \n\n# Costing Results Data\n{{$context.$nodes.E8_GET_COSTING_RESULTS.$output}}\n\n# Exception Logic:\nReview the provided data. For each cost result, normalize AccountType by trimming whitespace and comparing case-insensitively.\n    If the normalized AccountType contains the word “suspense” or “default” (e.g., “Suspense”, “Suspense Account”, “Default”, “Default Account”, or any variant), mark it as an exception.\n    If AccountType has any value other than the variation of suspense or default word, do not flag it as an exception. \n\nExamples of values that should trigger an exception for AccountType field: Suspense, Suspense Account, Payroll Suspense, Default, Default Account\n\n# Exception Reporting format:\nIf an exception exists, output: “One or more cost results are costed to Suspense or Default Account.”\n\nIf there are no exceptions, output: “No exception due to suspense or default account in cost results in this payroll calculation.”\n\n{{$context.$variables.llmSysPrompt}}"
            }
          ],
          "type": "LLM"
        },
