{
  "workflowId": "300000327004806",
  "workflowCode": "ORA_PAY_SUMMARY_ANALYST",
  "name": "Payroll Summary Analyst",
  "description": "The Payroll Summary Analyst is responsible for promptly and accurately providing administrators with the employee information needed to validate payroll results and respond to employee queries. The agent will improve the efficiency of the teams that process payroll and the teams that respond to payroll queries raised by employees using the agentic workflow functionality.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
