          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "E6 Filter EE Response",
            "returnType": "object",
            "sourceCode": "const src = $context.$nodes.E6_GET_EE_HISTORY.$output;\n  const result = { items: [] };\n\n  const srcItems = src.items;\n  if (!Array.isArray(srcItems)) return result;\n\n  for (let i = 0, il = srcItems.length; i < il; i++) {\n    const item = srcItems[i];\n\n    const outItem = {\n      cardBaseName: item.cardBaseName,\n      cardName: item.cardName,\n      description: item.description,\n      effectiveEndDate: item.effectiveEndDate,\n      effectiveStartDate: item.effectiveStartDate,\n      entries: []\n    };\n\n    const srcEntries = item.entries;\n    if (Array.isArray(srcEntries)) {\n      for (let j = 0, jl = srcEntries.length; j < jl; j++) {\n        const e = srcEntries[j];\n\n        const outEntry = {\n          LegislativeDataGroupId: e.LegislativeDataGroupId,\n          CreationDate: e.CreationDate,\n          PayrollAssignmentId: e.PayrollAssignmentId,\n          Category: e.Category,\n          ProcessingType: e.ProcessingTypeDisplayValue,\n          ElementName: e.ElementName || \"?\",\n          UsageLevel: e.UsageLevel,\n          PayrollRelationshipNumber: e.PayrollRelationshipNumber,\n          elementEntryValues: []\n        };\n\n        const srcValues = e.elementEntryValues;\n        if (Array.isArray(srcValues)) {\n          for (let k = 0, kl = srcValues.length; k < kl; k++) {\n            const v = srcValues[k];\n\n            outEntry.elementEntryValues.push({\n              EffectiveEndDate: v.EffectiveEndDate,\n              EffectiveStartDate: v.EffectiveStartDate,\n              InputValueName: v.InputValueName,\n              ReservedInputValue: v.ReservedInputValue,\n              ElementEntryId: v.ElementEntryId,\n              Value: v.ScreenEntryValue || v.DefaultValue || \"?\"\n            });\n          }\n        }\n\n        outItem.entries.push(outEntry);\n      }\n    }\n\n    result.items.push(outItem);\n  }\n\n  return result;"
          },
          "outcomes": {
            "success": "1771831581868"
          },
          "code": "E6_FILTER_EE_RESPONSE",
          "id": "1767933792803",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "E6 Pre Reason",
            "returnType": "object",
            "sourceCode": "const START_DATE = $context.$nodes.GET_VALIDATION_DATES.$output.EarnStartDate;\nconst END_DATE = $context.$nodes.GET_VALIDATION_DATES.$output.EarnEndDate;\n\nconst payload = $context.$nodes.E6_FILTER_EE_RESPONSE.$output.result;\n\nconst items = payload.items;\n\nconst assignmentMap = {}; // key: AssignmentId -> { ElementEntries: [ ... ] }\nconst payrollMap = {};    // key: PayrollRelationshipNumber -> { ElementEntries: [ ... ] }\nconst bucket = {}; // key: ElementName|Label:Id|InputName -> [ 's|e|v', ... ]\nconst assignmentElementIndex = {}; // key: AssignmentId|ElementName -> element entry object\nconst payrollElementIndex = {};    // key: PayrollRelationshipNumber|ElementName -> element entry object\n\nfunction pushEntryValue(isAssignment, id, elementName, entryValue) {\n  if (isAssignment) {\n    if (!assignmentMap[id]) assignmentMap[id] = { ElementEntries: [] };\n    const idxKey = id + '|' + elementName;\n    if (!assignmentElementIndex[idxKey]) {\n      assignmentElementIndex[idxKey] = { ElementName: elementName, EntryValues: [] };\n      assignmentMap[id].ElementEntries.push(assignmentElementIndex[idxKey]);\n    }\n    assignmentElementIndex[idxKey].EntryValues.push(entryValue);\n  } else {\n    if (!payrollMap[id]) payrollMap[id] = { ElementEntries: [] };\n    const idxKey = id + '|' + elementName;\n    if (!payrollElementIndex[idxKey]) {\n      payrollElementIndex[idxKey] = { ElementName: elementName, EntryValues: [] };\n      payrollMap[id].ElementEntries.push(payrollElementIndex[idxKey]);\n    }\n    payrollElementIndex[idxKey].EntryValues.push(entryValue);\n  }\n}\n\nfor (const item of items) {\n  const entries = (item && item.entries) || [];\n  for (const entry of entries) {\n    if (!entry || entry.ProcessingType !== 'Recurring') continue;\n\n    const usage = entry.UsageLevel;\n    let idField = null;\n    if (usage === 'PA') idField = 'PayrollAssignmentId';\n    else if (usage === 'PR') idField = 'PayrollRelationshipNumber';\n    if (!idField) continue;\n\n    const idValue = entry[idField];\n    const labelName = usage === 'PA' ? 'Assignment' : 'Payroll Relationship';\n    const evs = (entry.elementEntryValues) || [];\n    const el = entry.ElementName;\n    for (const ev of evs) {\n      const s = ev && ev.EffectiveStartDate;\n      const e = ev && ev.EffectiveEndDate;\n      const v = ev && ev.Value;\n      const n = ev && ev.InputValueName;\n      if (!s || !e || !n) continue;\n      if (v === '?') continue; // ignore placeholders\n      const key = el + '|' + labelName + ':' + idValue + '|' + n;\n      if (!bucket[key]) bucket[key] = [];\n      bucket[key].push(s + '|' + e + '|' + v);\n    }\n  }\n}\n\n// Build output rows across entries grouped by ElementName + id + InputValueName.\n// Show only 1 row per InputValueName when either:\n// 1) start is within range and end is on/after range end => isCreated\n// 2) start is on/before range start and end is within range => isEndDated\nfor (const k in bucket) {\n  if (!Object.prototype.hasOwnProperty.call(bucket, k)) continue;\n  let arr = bucket[k];\n  // de-duplicate exact s|e|v triples\n  const uniq = {};\n  for (const rec of arr) uniq[rec] = true;\n  arr = Object.keys(uniq);\n  // sort lexicographically by s then e then v (dates are YYYY-MM-DD)\n  arr.sort();\n\n  // Helper to parse grouping info from key k = ElementName|Label:Id|InputName\n  const p1 = k.indexOf('|');\n  const el = k.substring(0, p1);\n  const rest = k.substring(p1 + 1);\n  const p2 = rest.lastIndexOf('|');\n  const labelAndId = rest.substring(0, p2);\n  const inputName = rest.substring(p2 + 1);\n  const isAssignment = labelAndId.startsWith('Assignment:');\n  const id = isAssignment\n    ? labelAndId.substring('Assignment:'.length)\n    : labelAndId.substring('Payroll Relationship:'.length);\n\n  let selected = null;\n\n  const records = arr.map(rec => {\n    const parts = rec.split('|');\n    return { s: parts[0], e: parts[1], v: parts[2] };\n  });\n\n  // If a timeline is continuous across the window boundaries,\n  // surface in-range value transitions as changes.\n  const firstStart = records.length ? records[0].s : null;\n  const lastEnd = records.length ? records[records.length - 1].e : null;\n  const spansAcrossWindow = !!firstStart && !!lastEnd && firstStart < START_DATE && lastEnd > END_DATE;\n\n  if (spansAcrossWindow && records.length > 1) {\n    for (let i = 1; i < records.length; i++) {\n      const prev = records[i - 1];\n      const curr = records[i];\n      if (curr.s >= START_DATE && curr.s <= END_DATE && prev.v !== curr.v) {\n        pushEntryValue(isAssignment, id, el, {\n          InputValueName: inputName,\n          FromValue: prev.v,\n          ToValue: curr.v,\n          AsOfDate: curr.s,\n          isChanged: true\n        });\n      }\n    }\n\n    // When a spanning timeline exists, we only surface in-range changes.\n    // Do not classify it as created/end-dated.\n    continue;\n  }\n\n  // Prefer end-dated events when both exist for same input.\n  // (If both isCreated and isEndDated are possible in range, keep only isEndDated.)\n  for (const rec of arr) {\n    const parts = rec.split('|');\n    const s = parts[0], e = parts[1], v = parts[2];\n    // Treat as true end-dated only when the record does not continue\n    // into another subsequent effective-dated row for the same input.\n    const hasSubsequentRecord = arr.some(other => {\n      const op = other.split('|');\n      const os = op[0];\n      return os > e;\n    });\n\n    if (s <= START_DATE && e >= START_DATE && e <= END_DATE && !hasSubsequentRecord) {\n      selected = {\n        InputValueName: inputName,\n        Value: v,\n        EffectiveStartDate: s,\n        EffectiveEndDate: e,\n        AsOfDate: e,\n        isEndDated: true\n      };\n      break;\n    }\n  }\n\n  if (!selected) {\n    for (const rec of arr) {\n      const parts = rec.split('|');\n      const s = parts[0], e = parts[1], v = parts[2];\n      if (s >= START_DATE && s <= END_DATE && e >= END_DATE) {\n        selected = {\n          InputValueName: inputName,\n          Value: v,\n          EffectiveStartDate: s,\n          EffectiveEndDate: e,\n          AsOfDate: s,\n          isCreated: true\n        };\n        break;\n      }\n    }\n  }\n\n  if (selected) {\n    pushEntryValue(isAssignment, id, el, selected);\n  }\n}\n\nfunction collapseElementEntries(mapObj) {\n  for (const id in mapObj) {\n    if (!Object.prototype.hasOwnProperty.call(mapObj, id)) continue;\n    const elements = (mapObj[id] && mapObj[id].ElementEntries) || [];\n    for (const element of elements) {\n      const values = (element && element.EntryValues) || [];\n      if (!values.length) continue;\n\n      const createdValues = values.filter(v => v && v.isCreated === true);\n      const endDatedValues = values.filter(v => v && v.isEndDated === true);\n\n      const createdStartDates = createdValues.map(v => v.EffectiveStartDate).filter(Boolean);\n      const endDatedEndDates = endDatedValues.map(v => v.EffectiveEndDate).filter(Boolean);\n\n      const allCreatedSameStart =\n        createdValues.length === values.length &&\n        createdStartDates.length === values.length &&\n        new Set(createdStartDates).size === 1;\n\n      const allEndDatedSameEnd =\n        endDatedValues.length === values.length &&\n        endDatedEndDates.length === values.length &&\n        new Set(endDatedEndDates).size === 1;\n\n      // If both are true, prefer end-dated summary to align with precedence rule.\n      if (allEndDatedSameEnd) {\n        element.isEndDated = true;\n        element.AsOfDate = endDatedEndDates[0];\n        delete element.EntryValues;\n      } else if (allCreatedSameStart) {\n        element.isCreated = true;\n        element.AsOfDate = createdStartDates[0];\n        delete element.EntryValues;\n      }\n    }\n  }\n}\n\ncollapseElementEntries(assignmentMap);\ncollapseElementEntries(payrollMap);\n\n// Final grouped object exposed as `output`\nconst output = {\n  AssignmentChanges: Object.keys(assignmentMap).map(id => ({\n    AssignmentId: id,\n    ElementEntries: (assignmentMap[id] && assignmentMap[id].ElementEntries) || []\n  })),\n  PayrollRelationshipChanges: Object.keys(payrollMap).map(id => ({\n    PayrollRelationshipNumber: id,\n    ElementEntries: (payrollMap[id] && payrollMap[id].ElementEntries) || []\n  }))\n};\nreturn output;\n"
          },
