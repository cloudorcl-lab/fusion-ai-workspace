    },\n          \"name\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"kind\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"totalResults\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ]\n}",
          "type": "BO_FUNCTION"
