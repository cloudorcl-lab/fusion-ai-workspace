        \"NoOfLabels\",\n          \"PrintHeaderId\",\n          \"PrintLineId\"\n        ],\n        \"properties\": {\n          \"NoOfLabels\": {\n            \"type\": \"number\"\n          },\n          \"PrintHeaderId\": {\n            \"type\": \"number\"\n          },\n          \"PrintLineId\": {\n            \"type\": \"number\"\n          },\n          \"ObjectKeysDFF\": {\n            \"type\": \"array\",\n            \"uniqueItems\": true,\n            \"minItems\": 1,\n            \"items\": {\n              \"required\": [\n                \"PrintLineId\",\n                \"__FLEX_Context\",\n                \"__FLEX_Context_DisplayValue\",\n                \"itemNumber\",\n                \"serialNumber\"\n              ],\n              \"properties\": {\n                \"PrintLineId\": {\n                  \"type\": \"number\"\n                },\n                \"__FLEX_Context\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"__FLEX_Context_DisplayValue\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"itemNumber\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"lotNumber\": {\n                  \"type\": \"object\",\n                  \"properties\": {},\n                  \"required\": []\n                },\n                \"serialNumber\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"links\": {\n                  \"type\": \"array\",\n                  \"uniqueItems\": true,\n                  \"minItems\": 1,\n                  \"items\": {\n                    \"required\": [\n                      \"rel\",\n                      \"href\",\n                      \"name\",\n                      \"kind\"\n                    ],\n                    \"properties\": {\n                      \"rel\": {\n                        \"type\": \"string\",\n                        \"minLength\": 1\n                      },\n                      \"href\": {\n                        \"type\": \"string\",\n                        \"minLength\": 1\n                      },\n                      \"name\": {\n                        \"type\": \"string\",\n                        \"minLength\": 1\n                      },\n                      \"kind\": {\n                        \"type\": \"string\",\n                        \"minLength\": 1\n                      },\n                      \"properties\": {\n                        \"type\": \"object\",\n                        \"properties\": {\n                          \"changeIndicator\": {\n                            \"type\": \"string\",\n                            \"minLength\": 1\n                          }\n                        },\n                        \"required\": [\n                          \"changeIndicator\"\n                        ]\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          },\n          \"links\": {\n            \"type\": \"array\",\n            \"uniqueItems\": true,\n            \"minItems\": 1,\n            \"items\": {\n              \"required\": [\n                \"rel\",\n                \"href\",\n                \"name\",\n                \"kind\"\n              ],\n              \"properties\": {\n                \"rel\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"href\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"name\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"kind\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"properties\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"changeIndicator\": {\n                      \"type\": \"string\",\n                      \"minLength\": 1\n                    }\n                  },\n                  \"required\": [\n                    \"changeIndicator\"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"href\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"name\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"kind\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"properties\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"changeIndicator\": {\n                \"type\": \"string\",\n                \"minLength\": 1\n              }\n            },\n            \"required\": [\n              \"changeIndicator\"\n            ]\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"PrintHeaderId\",\n    \"ContextName\",\n    \"ContextValue\",\n    \"OrganizationId\",\n    \"PrintLabelType\",\n    \"ErrorCode\",\n    \"ErrorExplanation\",\n    \"ProcessJobId\",\n    \"Printer\",\n    \"ReportDownloadURL\",\n    \"OrganizationCode\",\n    \"OrganizationName\",\n    \"UseOnlineModeFlag\",\n    \"SubmitFlag\",\n    \"EmailFromAddress\",\n    \"EmailServer\",\n    \"EmailToAddresses\",\n    \"printLines\",