                        {
                          "metadata": {
                            "name": "Collect Next Lot From Transaction for Lot Label",
                            "returnType": "array",
                            "sourceCode": "let oldArray = $context.$variables.LotData;\n\nlet itemFromReceipt =\n  $context.$nodes.FOR_EACH_LSR_ITEM_GET_LOT_KEY_FOR_LOT_LABELS.GET_ITEM_NUMBER_FOR_LOT_LOT_LABEL.$output.result;\n\nlet transID =\n  $context.$nodes.FOR_EACH_LSR_ITEM_GET_LOT_KEY_FOR_LOT_LABELS.GET_TRANSACTION_ID_FOR_LOT_LABEL.$output.result;\n\nlet jsonData = $context.$nodes.FOR_EACH_LSR_ITEM_GET_LOT_KEY_FOR_LOT_LABELS.WHILE_TRANSACTION_HAS_MORE_LOT_FOR_LOT_LABELS.FETCH_NEXT_LOT_IN_RECEIPT_TRANSACTION_FOR_LOT_LABEL.$output;\n\nlet transactionData = [...oldArray];\n\njsonData.items.forEach(item => {\n  // Skip this item if LotNumber is null/undefined/empty\n  if (item.LotNumber == null || String(item.LotNumber).trim() === \"\") {\n    return; // skip this one, continue with next\n  }\n\n  transactionData.push({\n    lot: item.LotNumber,\n    itemNumber: itemFromReceipt\n  });\n});\n\n// If your environment needs assignment instead of return, use: result = transactionData;\nreturn transactionData;"
                          },
                          "outcomes": {
                            "success": "1773632704931"
                          },
                          "code": "COLLECT_NEXT_LOT_FROM_TRANSACTION_FOR_LOT_LABEL",
                          "id": "1773632632104",
