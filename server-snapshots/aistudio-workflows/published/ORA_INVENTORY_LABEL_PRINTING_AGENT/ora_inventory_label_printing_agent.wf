          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"description\": \"\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"PrintHeaderId\": {\n      \"type\": \"number\"\n    },\n    \"ContextName\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"ContextValue\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"OrganizationId\": {\n      \"type\": \"number\"\n    },\n    \"PrintLabelType\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"ErrorCode\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"ErrorExplanation\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"ProcessJobId\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"Printer\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"ReportDownloadURL\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"OrganizationCode\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"OrganizationName\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"UseOnlineModeFlag\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"SubmitFlag\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"EmailFromAddress\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"EmailServer\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"EmailToAddresses\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"printLines\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"NoOfLabels\",\n          \"PrintHeaderId\",\n          \"PrintLineId\"\n        ],\n        \"properties\": {\n          \"NoOfLabels\": {\n            \"type\": \"number\"\n          },\n          \"PrintHeaderId\": {\n            \"type\": \"number\"\n          },\n          \"PrintLineId\": {\n            \"type\": \"number\"\n          },\n          \"ObjectKeysDFF\": {\n            \"type\": \"array\",\n            \"uniqueItems\": true,\n            \"minItems\": 1,\n            \"items\": {\n              \"required\": [\n                \"PrintLineId\",\n                \"__FLEX_Context\",\n                \"__FLEX_Context_DisplayValue\",\n                \"subinventory\",\n                \"locatorName\",\n                \"allLocators\"\n              ],\n              \"properties\": {\n                \"PrintLineId\": {\n                  \"type\": \"number\"\n                },\n                \"__FLEX_Context\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"__FLEX_Context_DisplayValue\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"subinventory\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"locatorName\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"allLocators\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"links\": {\n                  \"type\": \"array\",\n                  \"uniqueItems\": true,\n                  \"minItems\": 1,\n                  \"items\": {\n                    \"required\": [\n                      \"rel\",\n                      \"href\",\n                      \"name\",\n                      \"kind\"\n                    ],\n                    \"properties\": {\n                      \"rel\": {\n                        \"type\": \"string\",\n                        \"minLength\": 1\n                      },\n                      \"href\": {\n                        \"type\": \"string\",\n                        \"minLength\": 1\n                      },\n                      \"name\": {\n                        \"type\": \"string\",\n                        \"minLength\": 1\n                      },\n                      \"kind\": {\n                        \"type\": \"string\",\n                        \"minLength\": 1\n                      },\n                      \"properties\": {\n                        \"type\": \"object\",\n                        \"properties\": {\n                          \"changeIndicator\": {\n                            \"type\": \"string\",\n                            \"minLength\": 1\n                          }\n                        },\n                        \"required\": [\n                          \"changeIndicator\"\n                        ]\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          },\n          \"links\": {\n            \"type\": \"array\",\n            \"uniqueItems\": true,\n            \"minItems\": 1,\n            \"items\": {\n              \"required\": [\n                \"rel\",\n                \"href\",\n                \"name\",\n                \"kind\"\n              ],\n              \"properties\": {\n                \"rel\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"href\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"name\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"kind\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"properties\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"changeIndicator\": {\n                      \"type\": \"string\",\n                      \"minLength\": 1\n                    }\n                  },\n                  \"required\": [\n                    \"changeIndicator\"\n                  ]\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"href\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"name\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"kind\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"properties\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"changeIndicator\": {\n                \"type\": \"string\",\n                \"minLength\": 1\n              }\n            },\n            \"required\": [\n              \"changeIndicator\"\n            ]\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"PrintHeaderId\",\n    \"ContextName\",\n    \"ContextValue\",\n    \"OrganizationId\",\n    \"PrintLabelType\",\n    \"ErrorCode\",\n    \"ErrorExplanation\",\n    \"ProcessJobId\",\n    \"Printer\",\n    \"ReportDownloadURL\",\n    \"OrganizationCode\",\n    \"OrganizationName\",\n    \"UseOnlineModeFlag\",\n    \"SubmitFlag\",\n    \"EmailFromAddress\",\n    \"EmailServer\",\n    \"EmailToAddresses\",\n    \"printLines\",\