                    "name": "Collect Lot Data from Transaction History for Lot Labels",
                    "returnType": "array",
                    "sourceCode": "let oldArray = $context.$variables.LotData;\n\nlet itemFromReceipt = $context.$nodes.FOR_EACH_LSR_ITEM_GET_LOT_KEY_FOR_LOT_LABELS.GET_ITEM_NUMBER_FOR_LOT_LOT_LABEL.$output.result;\n\nlet transID = $context.$nodes.FOR_EACH_LSR_ITEM_GET_LOT_KEY_FOR_LOT_LABELS.GET_TRANSACTION_ID_FOR_LOT_LABEL.$output.result;\n\nlet jsonData = $context.$nodes.FOR_EACH_LSR_ITEM_GET_LOT_KEY_FOR_LOT_LABELS.FETCH_LOT_FROM_TRANSACTION_HISTORY_FOR_LOT_LABEL.$output;\n\nlet transactionData = [...oldArray];\n\njsonData.items.forEach(item => {\n  // Skip this item if LotNumber is null/undefined/empty\n  if (item.LotNumber == null || String(item.LotNumber).trim() === \"\") {\n    return; // skip this one, continue with next\n  }\n\n  transactionData.push({\n    lot: item.LotNumber,\n    itemNumber: itemFromReceipt\n  });\n});\n\n// If your environment needs assignment instead of return, use: result = transactionData;\nreturn transactionData;"
                  },
