          "code": "LPN_OBJECT_LLM",
          "id": "1773969867395",
          "inputs": [
            {
              "id": "1773969867395_1",
              "name": "prompt",
              "type": "string",
              "value": "Make a valid JSON object using the following data. Use the keys and values provided. If the values are not given then just set that value as null. \n\n\"ReportName\": {{$context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.ReportName}}\n\"Receipt\": {{$context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.Receipt}}\n\"Shipment\": {{$context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.Shipment}}\n\"Organization\": {{$context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.Organization}}\n\"Associated\": {{$context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.Associated}}\n\"Onhand\": {{$context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.Onhand}}\n\"Subinventory\": {{$context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.Subinventory}}\n\"Locator\": {{$context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.Locator}}\n\"Zone\": {{$context.$nodes.PRINT_LOCATION_LABEL.$output.Zone}}\n\"Printer\": {{$context.$nodes.PRINT_LOCATION_LABEL.$output.Printer}}\n\"EmailFrom\": {{$context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.EmailFromAddress}}\n\"EmailTo\": {{$context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.EmailToAddress}}\n\"EmailServer\": {{$context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.EmailServer}}\n\"ReportURL\": {{$context.$nodes.PRINT_LPN_LABEL.$output.ReportDownloadURL}}\n\"JobProcess\": {{$context.$nodes.PRINT_LPN_LABEL.$output.ProcessJobId}}"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Check Shipment for LPN Label",
            "returnType": "boolean",
            "sourceCode": "let shipment = $context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.Shipment;\n\n// Treat null, undefined, \"null\", and empty/whitespace as invalid\nlet isValid =\n  shipment !== null &&\n  shipment !== undefined &&\n  String(shipment).trim().toLowerCase() !== 'null' &&\n  String(shipment).trim() !== '';\n\nreturn isValid;"
          },
          "outcomes": {
            "success": "1773966214071"
          },
          "code": "CHECK_SHIPMENT_FOR_LPN_LABEL",
          "convergenceTargetId": "1773966214071",
          "id": "1773966186121",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Check Online Mode for Delivery Label",
            "returnType": "string",
            "sourceCode": "//If Email or Printer provided we need to return false string as we need to launch ess job to print and send emails.\n//Otherwise true and get download link.\n\nlet printer    = $context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.Printer;\nlet EmailTo    = $context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.EmailToAddress;\n\n// normalize to trimmed strings (or empty if null/undefined)\nlet printerStr     = (printer    == null ? '' : String(printer).trim());\nlet emailToStr     = (EmailTo    == null ? '' : String(EmailTo).trim());\n\n// treat \"null\" as empty too\nlet printerProvided =\n  printerStr !== '' && printerStr.toLowerCase() !== 'null';\nlet emailToProvided =\n  emailToStr !== '' && emailToStr.toLowerCase() !== 'null';\n\n// any value provided?\nlet anyProvided =\n  printerProvided || emailToProvided;\n\n// if any provided \"false\", if none provided \"true\"\nreturn anyProvided ? \"false\" : \"true\";"
          },
          "outcomes": {
            "success": "1773879361764"
          },
          "code": "CHECK_ONLINE_MODE_FOR_DELIVERY_LABEL",
          "id": "1774046356555",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
