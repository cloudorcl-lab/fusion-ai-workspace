        {
          "metadata": {
            "name": "Check if Email Requested for Label",
            "returnType": "boolean",
            "sourceCode": "//If Email or Printer provided we need to return false string as we need to launch ess job to print and send emails.\n//Otherwise true and get download link.\n\nlet EmailTo    = $context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.EmailToAddress;\nlet emailToStr     = (EmailTo    == null ? '' : String(EmailTo).trim());\n\n\nlet emailToProvided =\n  emailToStr !== '' && emailToStr.toLowerCase() !== 'null';\n\n// any value provided?\nlet anyProvided = emailToProvided;\n\nreturn anyProvided;"
          },
          "outcomes": {
            "success": "1774647093284"
          },
          "code": "CHECK_IF_EMAIL_REQUESTED_FOR_LABEL",
          "id": "1774658246066",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
