          "metadata": {
            "name": "Lot JSON",
            "returnType": "string",
            "sourceCode": "let lotNumbers = $context.$variables.LotData;\n\nlet result = '[';\n\nfor (let i = 0; i < lotNumbers.length; i++) {\n  let obj = {\n    \"NoOfLabels\": 1,\n    \"ObjectKeysDFF\": [\n      {\n        \"itemNumber\": lotNumbers[i].itemNumber,\n        \"lotNumber\": lotNumbers[i].lot,\n        \"serialNumber\": null\n      }\n    ]\n  };\n\n  if (i !== 0) {\n    result += ',\\n';\n  }\n  result += JSON.stringify(obj);\n}\n\nresult += ']';\nreturn result;"
          },
          "outcomes": {
            "success": "1774147282528"
          },
