                {
                  "metadata": {
                    "name": "Collect Next LPN in Receipt for LPN Label",
                    "returnType": "array",
                    "sourceCode": "let oldArray = $context.$variables.LPNData;\n\nlet jsonData = $context.$nodes.WHILE_RECEIPT_HAS_MORE_LPN_FOR_LPN_LABEL.FETCH_NEXT_LPN_IN_RECEIPT_FOR_LPN_LABEL.$output;\n\nlet transactionData = [...oldArray];\n\njsonData.items.forEach(item => {\n  let lpn = item.LicensePlateNumber;\n\n  // Only add if not null/undefined/empty/whitespace\n  if (lpn != null && String(lpn).trim() !== '') {\n    transactionData.push({\n      lpn: lpn\n    });\n  }\n});\n\nreturn transactionData;"
                  },
