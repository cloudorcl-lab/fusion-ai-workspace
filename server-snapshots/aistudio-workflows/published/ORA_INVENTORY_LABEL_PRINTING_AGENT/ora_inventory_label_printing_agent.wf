        {
          "metadata": {
            "name": "Items JSON",
            "returnType": "array",
            "sourceCode": "let itemNumbers = $context.$variables.ItemData;\n\n\nlet result = '[';\n\n// Generate objects for each item number\nfor (let i = 0; i < itemNumbers.length; i++) {\n    let obj = {\n        \"NoOfLabels\": 1,\n        \"ObjectKeysDFF\": [\n            {\n                \"itemNumber\": itemNumbers[i]\n            }\n        ]\n    };\n\n    // Append the object to the result string\n    if (i !== 0) {\n        result += ',\\n';\n    }\n    result += JSON.stringify(obj);\n}\n\nresult += ']';\nreturn result;"
          },
          "outcomes": {
            "success": "1774150283915"
          },
          "code": "ITEMS_JSON",
