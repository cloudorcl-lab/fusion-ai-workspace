            "name": "Check Shipment Lot Label",
            "returnType": "boolean",
            "sourceCode": "let shipment = $context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.Shipment;\n\n// Treat null, undefined, \"null\", and empty/whitespace as invalid\nlet isValid =\n  shipment !== null &&\n  shipment !== undefined &&\n  String(shipment).trim().toLowerCase() !== 'null' &&\n  String(shipment).trim() !== '';\n\nreturn isValid;"
