            "name": "Check Receipt for Item Labels",
            "returnType": "boolean",
            "sourceCode": "let receipt = $context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.Receipt;\n\n// Treat null, undefined, \"null\", and empty/whitespace as invalid\nlet isValid =\n  receipt !== null &&\n  receipt !== undefined &&\n  String(receipt).trim().toLowerCase() !== 'null' &&\n  String(receipt).trim() !== '';\n\nreturn isValid;"
          },
