                  "metadata": {
                    "name": "Collect Onhand Locator Serials for Serial Labels",
                    "returnType": "array",
                    "sourceCode": "let oldArray = $context.$variables.SerialData \nlet currentItem = $context.$nodes.FOR_EACH_ITEM_IN_ONHAND_LOCATOR_FOR_SERIAL_LABELS.$currentItem;\n\nlet jsonData = $context.$nodes.FOR_EACH_ITEM_IN_ONHAND_LOCATOR_FOR_SERIAL_LABELS.FETCH_ONHAND_LOCATOR_SERIAL_NUMBERS_FOR_SERIAL_LABELS.$output;\n\nlet transactionData = [...oldArray];\n\n// Assuming jsonData.items is an array of objects with TransactionId and ItemNumber properties\njsonData.items.forEach(item => {\n  transactionData.push({\n    serialNumber: item.SerialNumber,\n    itemNumber: currentItem\n  });\n});\n\nreturn transactionData;"
                  },
