            "name": "Delivery JSON",
            "returnType": "string",
            "sourceCode": "let deliveries = $context.$variables.DeliveryData;\n\nlet result = '[';\n\nfor (let i = 0; i < deliveries.length; i++) {\n  let obj = {\n    \"NoOfLabels\": 1,\n    \"ObjectKeysDFF\": [\n      {\n        \"deliveryNumber\": deliveries[i].delivery\n      }\n    ]\n  };\n\n  if (i !== 0) {\n    result += ',\\n';\n  }\n  result += JSON.stringify(obj);\n}\n\nresult += ']';\nreturn result;"
          },
          "outcomes": {
            "success": "1773879282951"
          },
