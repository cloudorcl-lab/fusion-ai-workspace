        {
          "metadata": {
            "name": "Check Get Subinv and Locators in Org Location Label",
            "returnType": "boolean",
            "sourceCode": "//In order to get all Subinventories and Locations in an Organization we need to make sure user didn't provide a subinv, locator, or Zone. \n\nlet sub  = $context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.Subinventory;\nlet loc  = $context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.Locator;\nlet org  = $context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.Organization;\nlet zone = $context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.Zone;\n\n// normalize values to trimmed strings (or empty if null/undefined)\nlet subStr  = (sub  == null ? '' : String(sub).trim());\nlet locStr  = (loc  == null ? '' : String(loc).trim());\nlet orgStr  = (org  == null ? '' : String(org).trim());\nlet zoneStr = (zone == null ? '' : String(zone).trim());\n\n// Org must be provided (non-empty, not \"null\")\nlet orgOk =\n  orgStr !== '' &&\n  orgStr.toLowerCase() !== 'null';\n\n// Everything else must be empty or \"null\"\nlet subOk  = (subStr  === '' || subStr.toLowerCase()  === 'null');\nlet locOk  = (locStr  === '' || locStr.toLowerCase()  === 'null');\nlet zoneOk = (zoneStr === '' || zoneStr.toLowerCase() === 'null');\n\nlet isValid = orgOk && subOk && locOk && zoneOk;\n\nreturn isValid;"
          },
          "outcomes": {
            "success": "1773720307325"
          },
          "code": "CHECK_SUB_AND_LOC_IN_ORG_FOR_LOCATION_LABEL",
          "id": "1773719627638",
