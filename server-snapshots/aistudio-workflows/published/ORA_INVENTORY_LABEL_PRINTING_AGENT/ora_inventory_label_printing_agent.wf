                            "sourceCode": "let oldArray = $context.$variables.SerialData;\nlet itemFromReceipt = $context.$nodes.FOR_EACH_LOT_KEY_GET_SERIAL_NUMBERS_FOR_SERIAL_LABELS.GET_ITEM_NUMBER_FOR_A_LOTS_SERIAL_FOR_SERIAL_LABELS.$output.result;\n\nlet jsonData = $context.$nodes.FOR_EACH_LOT_KEY_GET_SERIAL_NUMBERS_FOR_SERIAL_LABELS.WHILE_LOT_HAS_MORE_SERIAL_NUMBERS_FOR_SERIAL_LABELS.FETCH_NEXT_SERIAL_NUMBERS_FOR_LOT_FOR_SERIAL_LABELS.$output;\n\nlet transactionData = [...oldArray];\n\njsonData.items.forEach(item => {\n  transactionData.push({\n    serialNumber: item.SerialNumber,\n    itemNumber: itemFromReceipt\n  });\n});\n\nreturn transactionData;"
