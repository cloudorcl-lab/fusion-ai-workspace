            "sourceCode": "let getAssoc = $context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.Associated;\nlet sub = $context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.Subinventory;\n\n// Treat null, undefined, \"null\", and empty/whitespace as invalid\nlet isValid =\n  sub !== null &&\n  sub !== undefined &&\n  String(sub).trim().toLowerCase() !== 'null' &&\n  String(sub).trim() !== '';\n\nisValid = (getAssoc === true || getAssoc === 'true') && isValid;\n\nreturn isValid;"
