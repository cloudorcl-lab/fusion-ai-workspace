        {
          "metadata": {
            "name": "Collect Active Locators in Subinv for Location Label",
            "returnType": "array",
            "sourceCode": "let oldArray = $context.$variables.LocationData;\n\nlet jsonData = $context.$nodes.FETCH_ACTIVE_LOCATORS_IN_A_SUBINVENTORY_FOR_LOCATION_LABEL.$output;\n\nlet transactionData = [...oldArray];\n\n// Assuming jsonData.items is an array of objects with TransactionId and ItemNumber properties\njsonData.items.forEach(item => {\n  transactionData.push({\n    subinventory: item.SubinventoryCode,\n    locator: item.Locator\n  });\n});\n\nreturn transactionData;"
          },
          "outcomes": {
            "success": "1773773117608"
          },
