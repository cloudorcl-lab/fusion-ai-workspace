        {
          "metadata": {
            "name": "Collect Lot Numbers in Shipment for Lot Labels",
            "returnType": "array",
            "sourceCode": "let oldArray = $context.$variables.LotData;\n\nlet jsonData = $context.$nodes.FETCH_SHIPMENT_LINE_LOTS_FOR_LOT_LABELS.$output;\n\nlet transactionData = [...oldArray];\n\n// Assuming jsonData.items is an array of objects with LotNumber and Item\njsonData.items.forEach(item => {\n  // Skip this item if LotNumber is null/undefined/empty\n  if (item.LotNumber == null || String(item.LotNumber).trim() === \"\") {\n    return; // skip this one, continue with next\n  }\n\n  transactionData.push({\n    lot: item.LotNumber,\n    itemNumber: item.Item\n  });\n});\n\n// If your environment does not allow return, do: result = transactionData;\nreturn transactionData;"
          },
          "outcomes": {
