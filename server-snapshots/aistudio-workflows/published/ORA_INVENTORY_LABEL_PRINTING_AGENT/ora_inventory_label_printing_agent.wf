                            "returnType": "array",
                            "sourceCode": "let oldArray = $context.$variables.SerialData;\nlet currentItem = $context.$nodes.FOR_EACH_ITEM_IN_SHIPMENT_FOR_SERIAL_LABELS.GET_ITEM_NUMBER_FOR_SERIAL_LABELS.$output.result;\nlet jsonData = $context.$nodes.FOR_EACH_ITEM_IN_SHIPMENT_FOR_SERIAL_LABELS.WHILE_ITEM_IN_SHIPMENT_HAS_MORE_SERIAL_NUMBER_FOR_SERIAL_LABELS.FETCH_NEXT_SERIAL_FROM_SHIPMENT_LINE_FOR_SERIAL_LABELS.$output;\n\nlet transactionData = [...oldArray];\n\n// Assuming jsonData.items is an array of objects with TransactionId and ItemNumber properties\njsonData.items.forEach(item => {\n  transactionData.push({\n    serialNumber: item.FromSerialNumber,\n    itemNumber: currentItem\n  });\n});\n\nreturn transactionData;"
                          },
