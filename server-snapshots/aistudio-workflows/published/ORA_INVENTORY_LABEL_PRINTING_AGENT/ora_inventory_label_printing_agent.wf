        {
          "metadata": {
            "name": "Location JSON",
            "returnType": "string",
            "sourceCode": "let locationData = $context.$variables.LocationData;\n\nlet result = '[';\n\nfor (let i = 0; i < locationData.length; i++) {\n  let obj;\n\n  // If locator is present and not empty, include it\n  if (locationData[i].locator != null &&\n      String(locationData[i].locator).trim() !== '') {\n\n    obj = {\n      \"NoOfLabels\": 1,\n      \"ObjectKeysDFF\": [\n        {\n          \"subinventory\": locationData[i].subinventory,\n          \"locatorName\": locationData[i].locator\n        }\n      ]\n    };\n\n  } else {\n    // Subinventory only\n    obj = {\n      \"NoOfLabels\": 1,\n      \"ObjectKeysDFF\": [\n        {\n          \"subinventory\": locationData[i].subinventory\n        }\n      ]\n    };\n  }\n\n  if (i !== 0) {\n    result += ',\\n';\n  }\n  result += JSON.stringify(obj);\n}\n\nresult += ']';\nreturn result;"
          },
          "outcomes": {
            "success": "1773725807721"
          },
          "code": "LOCATION_JSON",
          "id": "1773724842961",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
