        {
          "metadata": {
            "name": "Unique Serial Numbers Only Per Item",
            "returnType": "array",
            "sourceCode": "let rawData = $context.$variables.SerialData;\n\nlet seen = new Set();\nlet unique = [];\n\nrawData.forEach(entry => {\n  // key can be item+serial, adjust if serials are globally unique\n  const key = `${entry.itemNumber}::${entry.serialNumber}`;\n\n  if (!seen.has(key)) {\n    seen.add(key);\n    unique.push(entry);\n  }\n});\n\n// unique now has only distinct { itemNumber, serialNumber } pairs\nreturn unique;"
          },
          "outcomes": {
            "success": "1773443659688"
          },
          "code": "UNIQUE_SERIAL_NUMBERS_ONLY_PER_ITEM",
          "id": "1773443605114",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Serial Numbers JSON",
            "returnType": "string",
            "sourceCode": "let serialNumbers = $context.$nodes.UNIQUE_SERIAL_NUMBERS_ONLY_PER_ITEM.$output.result;\n\nlet result = '[';\n\nfor (let i = 0; i < serialNumbers.length; i++) {\n  let obj = {\n    \"NoOfLabels\": 1,\n    \"ObjectKeysDFF\": [\n      {\n        \"itemNumber\": serialNumbers[i].itemNumber,\n        \"lotNumber\": null,\n        \"serialNumber\": serialNumbers[i].serialNumber\n      }\n    ]\n  };\n\n  if (i !== 0) {\n    result += ',\\n';\n  }\n  result += JSON.stringify(obj);\n}\n\nresult += ']';\nreturn result;"
          },
          "outcomes": {
            "success": "1774149969004"
          },
