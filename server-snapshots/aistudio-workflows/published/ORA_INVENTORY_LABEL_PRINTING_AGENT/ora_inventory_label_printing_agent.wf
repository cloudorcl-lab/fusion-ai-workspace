                    "name": "Collect Lots for Item in Onhand Subinv for Lot Labels",
                    "returnType": "array",
                    "sourceCode": "let oldArray = $context.$variables.LotData;\n\nlet jsonData =\n  $context.$nodes.FOR_EACH_ITEM_IN_ONHAND_SUBINVENTORY_GET_LOTS_FOR_LOT_LABELS.GET_LOTS_FOR_EACH_ITEM_FOR_LOT_LABELS.$output;\n\nlet transactionData = [...oldArray];\n\njsonData.items.forEach(item => {\n  // Skip this item if LotNumber is null/undefined/empty\n  if (item.LotNumber == null || String(item.LotNumber).trim() === \"\") {\n    return; // skip this one, continue with next\n  }\n\n  transactionData.push({\n    lot: item.LotNumber,\n    itemNumber: item.ItemNumber\n  });\n});\n\n// If your environment needs assignment instead of return,\nreturn transactionData;"
