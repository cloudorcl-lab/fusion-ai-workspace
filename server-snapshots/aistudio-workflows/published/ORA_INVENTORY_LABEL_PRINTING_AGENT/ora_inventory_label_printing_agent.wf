                  "metadata": {
                    "name": "Collect Next Item in Onhand Subinv for Lot Label",
                    "returnType": "array",
                    "sourceCode": "let oldArray = $context.$variables.ItemData;\n\nlet jsonData = $context.$nodes.WHILE_ONHAND_SUBINV_HAS_MORE_ITEMS_FOR_LOT_LABELS.FETCH_NEXT_ITEM_IN_ONHAND_SUBINV_FOR_LOT_LABELS.$output;\n\nlet itemIds = [...oldArray];\n\njsonData.items.forEach(item => { \n\nif(item.LotControlCode === \"2\"){\nitemIds.push(item.InventoryItemId); \n}\n\n});\n\nreturn itemIds;"
                  },
