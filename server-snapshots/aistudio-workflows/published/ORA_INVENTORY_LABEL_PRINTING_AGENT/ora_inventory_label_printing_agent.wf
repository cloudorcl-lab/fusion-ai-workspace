            "name": "Check Serial Label Receipt",
            "returnType": "boolean",
            "sourceCode": "let rec = $context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.Receipt;\n\n// Treat null, undefined, \"null\", and empty/whitespace as invalid\nlet isValid =\n  rec !== null &&\n  rec !== undefined &&\n  String(rec).trim().toLowerCase() !== 'null' &&\n  String(rec).trim() !== '';\n\nreturn isValid;"
