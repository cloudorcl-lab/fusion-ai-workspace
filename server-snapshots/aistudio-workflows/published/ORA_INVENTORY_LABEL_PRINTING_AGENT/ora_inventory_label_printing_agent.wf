        {
          "metadata": {
            "name": "Construct Label Chat Window Message",
            "returnType": "string",
            "sourceCode": "//Change Log: 26D Inventory Events has the ability to Prevent Job Process from Occurring Changed Message to just say Print Request has Benn Submitted \n// Safely get the LLM output node\nconst llmOutput = $context?.$nodes?.RETURN_LLM_RESULTS?.$output;\n\n// If it's null/undefined/empty, bail out early\nif (!llmOutput || Object.keys(llmOutput).length === 0) {\n  return;\n}\n\nlet reportDispName = llmOutput[\"ReportName\"];\nlet reportURL      = llmOutput[\"ReportURL\"];\nlet process        = llmOutput[\"JobProcess\"];\n\nlet paramStr = \"\";\nlet userRequestInput = $context?.$triggers?.EMAIL?.$input?.content?.trim()\n  ? $context.$triggers.EMAIL.$input.content\n  : $context?.$system?.$inputMessage;\n\n// Get single object instead of array\nlet input = $context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output || {};\nlet printer = input[\"Printer\"];\n\n// Decide the main sentence based on process / printer\nlet hasProcess = process != null && String(process).trim() !== \"\";\nlet hasPrinter = printer != null && String(printer).trim() !== \"\" && String(printer).trim() !== \"None\";\n\nlet mainSentence = hasProcess\n  ? `As requested, please find the ${reportDispName} printing process below.`\n  : hasPrinter\n    ? `As requested, your print request has been submitted.`\n    : `As requested, please find the ${reportDispName} attached.`;\n\n// Basic Report information\nlet emailBody = `<div style=\"font-family: Arial, sans-serif; font-size: 14px; color:#222;\">\n    <p style=\"margin:0 0 10px 0;\">\n      <b>Request:</b> \"${userRequestInput}\"</br></br>\n      ${mainSentence}\n    </p>\n    <div style=\"padding:12px; background:#F4F6F8; border:1px solid #D0D7DE; border-radius:6px;\">`;\n\n// Only include the report link if reportURL is non-empty\nif (reportURL != null && String(reportURL).trim() !== \"\") {\n  emailBody += `\n       <p style=\"margin:0;\"><b>Report:</b> <a href=\"${reportURL}\">${reportDispName}</a></p>`;\n}\n\n// Include Job Process if available, otherwise show print request message if printer is available\nif (hasProcess) {\n  emailBody += `\n      <p style=\"margin:0;\"><b>Job Process:</b> ${process}</p>`;\n} else if (hasPrinter) {\n  emailBody += `\n      <p style=\"margin:0;\">Print request has been submitted.</p>`;\n}\n\n// Always include Generated On\nemailBody += `\n      <p style=\"margin:6px 0 0 0;\"><b>Generated On:</b> ${new Date().toISOString()}</p>`;\n\n// Build parameters list directly from the Label Data Extraction Node output\nif (input && Object.keys(input).length > 0) {\n  paramStr = Object.entries(input)\n    .filter(([key, value]) =>\n      key !== \"ReportName\" &&\n      key !== \"ReportURL\" &&\n      value !== null &&\n      value !== false &&\n      !(key === \"Printer\" && (value === \"None\" || value == null))\n    )\n    .map(([key, value]) => `<li style=\"margin:2px 0;\">${key}: ${value}</li>`)\n    .join(\"\");\n\n  if (paramStr) {\n    emailBody += `<p style=\"margin:6px 0 0 0;\"><b>Parameters:</b></p>\n  <ul style=\"margin:3px 0 0 0; padding-left:18px;\">${paramStr}</ul>`;\n  }\n}\n\nemailBody += `</div>`;\n\nemailBody += `<p style=\"margin:12px 0 0 0; font-size:12px; color:#555;\">\n      If you did not request this report, please contact support.\n    </p>\n  </div>`;\n\nreturn emailBody.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\").replace(/'/g, \"&apos;\");"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "CONSTRUCT_LABEL_CHAT_WINDOW_MESSAGE",
          "id": "1774636836571",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get Email Server",
            "returnType": "array",
            "sourceCode": "//If Email or Printer provided we need to return false string as we need to launch ess job to print and send emails.\n//Otherwise true and get download link.\n\nlet EmailTo    = $context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.EmailToAddress;\nlet emailToStr     = (EmailTo    == null ? '' : String(EmailTo).trim());\n\n\nlet emailToProvided =\n  emailToStr !== '' && emailToStr.toLowerCase() !== 'null';\n\n// any value provided?\nlet anyProvided = emailToProvided;\n\n\n\nlet emailServer = $context.$triggers.REST.$input.EmailServer;\nlet emailFrom   = $context.$triggers.REST.$input.ReportsFromEmail;\n\nlet result = \"\";\n// If EmailTo has a value, return [emailServer, emailFrom]; otherwise, return [].\nif (emailToProvided) {\n  result = emailServer;\n} else {\n   result =  \"\";\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1774649035165"
          },
          "code": "GET_EMAIL_SERVER",
          "convergenceTargetId": "1773443113564",
          "id": "1774647093284",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get Email From",
            "returnType": "string",
            "sourceCode": "//If Email or Printer provided we need to return false string as we need to launch ess job to print and send emails.\n//Otherwise true and get download link.\n\nlet EmailTo    = $context.$nodes.LABEL_DATA_EXTRACTION_NODE.$output.EmailToAddress;\nlet emailToStr     = (EmailTo    == null ? '' : String(EmailTo).trim());\n\n\nlet emailToProvided =\n  emailToStr !== '' && emailToStr.toLowerCase() !== 'null';\n\n// any value provided?\nlet anyProvided = emailToProvided;\n\n\n\nlet emailServer = $context.$triggers.REST.$input.EmailServer;\nlet emailFrom   = $context.$triggers.REST.$input.ReportsFromEmail;\n\nlet result = \"\";\n// If EmailTo has a value, return [emailServer, emailFrom]; otherwise, return [].\nif (emailToProvided) {\n  result = emailFrom;\n} else {\n   result =  \"\";\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1773443113564"
          },
          "code": "GET_EMAIL_FROM",
          "convergenceTargetId": "1773443113564",
          "id": "1774649035165",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
