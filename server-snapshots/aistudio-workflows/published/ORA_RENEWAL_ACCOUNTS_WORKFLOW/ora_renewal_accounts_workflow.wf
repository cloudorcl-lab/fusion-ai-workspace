        {
          "metadata": {
            "name": "Set Parent Product ID",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  const parentProductIdRaw = $context.$variables?.parentProductId;\n  let parentProductId = \"\";\n\n  if (typeof parentProductIdRaw === \"string\") {\n    // Normalize to uppercase for case-insensitive check\n    const parentProductIdUpper = parentProductIdRaw.toUpperCase();\n    if (parentProductIdUpper.startsWith(\"FUSION_\")) {\n      // Remove prefix length from original string to preserve case after prefix\n      parentProductId = parentProductIdRaw.substring(\"FUSION_\".length);\n    } else {\n      parentProductId = parentProductIdRaw;\n    }\n  }\n\n  result = parentProductId;\n  $context.$variables.parentProductId = parentProductId;\n} catch (error) {\n  result = parentProductId;\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1782218584128"
          },
          "code": "SET_PARENT_PRODUCT_ID",
          "id": "1779158157720",
          "inputs": [],
          "type": "CODE",
          "diagram": {
            "x": 5456.067907510183,
            "y": 5520.551306449433
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "name": "Set Child Ids",
            "returnType": "object",
            "sourceCode": "let result = \"\";\n\ntry {\n\n const items = $context.$nodes?.GET_CHILD_PRODUCTS?.$output?.items || [];\n\n  if (Array.isArray(items) && items.length > 0) {\n\n    const productResult = items[0]?.productResult;\n\n    if (typeof productResult === \"string\") {\n\n      const parsedProductResult = JSON.parse(productResult);\n\n      const childProducts = parsedProductResult?.childProducts;\n\n      if (Array.isArray(childProducts)) {\n        const childProductIds= childProducts.map(child => child?.childProductId).filter(id => typeof id === \"string\" && id.length > 0).map(id => `'${id}'`).join(\",\");\n        result = childProductIds ;\n\n      }\n\n    }\n\n  }\n\n} catch (error) {\n\n  result = \"\";\n\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776901176608"
          },
          "code": "SET_CHILD_IDS",
          "id": "1779158157721",
          "inputs": [],
          "type": "CODE",
