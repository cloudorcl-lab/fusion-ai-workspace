        {
          "metadata": {
            "name": "Retrieve Parent Product Name and Id",
            "returnType": "object",
            "sourceCode": "const appInput = $context.$triggers.REST.$input.OraAppContext;\n\nlet result = { parentProductId: \"\", parentProductName: \"\" };\ntry {\n  let appContextRaw = appInput;\n  let appContextStr = \"\";\n  const appContextMatch = appContextRaw.match(/appContext=([^\\s]+)/);\n  if (appContextMatch) {\n    appContextStr = decodeURIComponent(appContextMatch[1]);\n  } else {\n    appContextStr = appContextRaw;\n  }\n  if ((appContextStr.startsWith('\"') && appContextStr.endsWith('\"')) || (appContextStr.startsWith(\"'\") && appContextStr.endsWith(\"'\"))) {\n    appContextStr = appContextStr.slice(1, -1);\n  }\n  let parentProductId = \"\";\n  let parentProductName = \"\";\n  if (appContextStr.startsWith('{') && appContextStr.endsWith('}')) {\n    try {\n      const obj = JSON.parse(appContextStr);\n      parentProductId = obj.parentProductId || \"\";\n      parentProductName = obj.parentProductName || \"\";\n    } catch (jsonError) {\n      const pairs = appContextStr.slice(1, -1).split(',');\n      pairs.forEach(pair => {\n        const [key, value] = pair.split(':').map(s => s.trim());\n        if (key === 'parentProductId') parentProductId = value || \"\";\n        else if (key === 'parentProductName') parentProductName = value || \"\";\n      });\n    }\n  } else {\n    const pairs = appContextStr.split(',');\n    pairs.forEach(pair => {\n      let key = \"\";\n      let value = \"\";\n      if (pair.includes('=')) {\n        [key, value] = pair.split('=').map(s => s.trim());\n      } else if (pair.includes(':')) {\n        [key, value] = pair.split(':').map(s => s.trim());\n      }\n      if (key === 'parentProductId') parentProductId = value || \"\";\n      else if (key === 'parentProductName') parentProductName = value || \"\";\n    });\n  }\n  parentProductName = parentProductName.replace(/\\+/g, ' ');\n  result = { parentProductId, parentProductName };\n} catch (error) {\n  result = { parentProductId: \"\", parentProductName: \"\" };\n}\nreturn result;"
          },
          "outcomes": {
            "success": "1779158157718"
          },
