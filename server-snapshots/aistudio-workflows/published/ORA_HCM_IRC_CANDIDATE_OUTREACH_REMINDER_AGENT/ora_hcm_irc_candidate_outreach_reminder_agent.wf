        {
          "metadata": {
            "name": "ParseAndLimitRemindersToBeProcessed",
            "returnType": "array",
            "sourceCode": "const remindersToBeProcessed = $context.$nodes.FETCH_OUTREACH_REMINDER_RECIPIENTS.$output.result || [];\nconst settings = $context.$nodes.FETCH_TWO_WAY_EMAIL_SETTINGS.$output.items || [];\nconst limit = $context.$triggers.REST.$input.NumberOfRemindersToProcess;\n \nconst isTwoWayEmailEnabledForExternalCandidates = settings.some(i => i.SettingCode === 'TWO_WAY_EMAIL_ENABLED_EXTERNAL_CANDIDATES' && i.SettingValue === 'Y');\nconst isTwoWayEmailEnabledForInternalCandidates = settings.some(i => i.SettingCode === 'TWO_WAY_EMAIL_ENABLED_INTERNAL_CANDIDATES' && i.SettingValue === 'Y');\n\nconst result = remindersToBeProcessed.filter((item) => {\n    const isInternal = item.isInternal === 'Y';\n    if (isInternal && !isTwoWayEmailEnabledForInternalCandidates) {\n        return false;\n    }\n\n    if (!isInternal && !isTwoWayEmailEnabledForExternalCandidates) {\n        return false;\n    }\n\n    return true;\n}).slice(0, limit);\n\nreturn result;"
          },
          "outcomes": {
            "success": "1766081931992"
          },
          "code": "PARSE_AND_LIMIT_REMINDERS_TO_BE_PROCESSED",
          "id": "1766081654175",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
