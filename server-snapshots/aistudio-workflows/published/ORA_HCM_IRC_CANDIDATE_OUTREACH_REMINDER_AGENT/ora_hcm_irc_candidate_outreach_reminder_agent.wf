        {
          "metadata": {
            "name": "CheckTwoWayEmailEnablement",
            "returnType": "boolean",
            "sourceCode": "const settings = $context.$nodes.FETCH_TWO_WAY_EMAIL_SETTINGS.$output.items || [];\n\nconst isTwoWayEmailEnabledForExternalCandidates = settings.some(i => i.SettingCode === 'TWO_WAY_EMAIL_ENABLED_EXTERNAL_CANDIDATES' && i.SettingValue === 'Y');\nconst isTwoWayEmailEnabledForInternalCandidates = settings.some(i => i.SettingCode === 'TWO_WAY_EMAIL_ENABLED_INTERNAL_CANDIDATES' && i.SettingValue === 'Y');\n\nreturn isTwoWayEmailEnabledForExternalCandidates || isTwoWayEmailEnabledForInternalCandidates;"
          },
          "outcomes": {
            "success": "1766081446128"
          },
          "code": "CHECK_TWO_WAY_EMAIL_ENABLEMENT",
          "id": "1766081351547",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
