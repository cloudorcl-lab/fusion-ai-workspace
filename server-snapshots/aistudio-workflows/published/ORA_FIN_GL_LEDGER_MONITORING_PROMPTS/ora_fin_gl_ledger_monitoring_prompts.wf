        {
          "id": "1781013243796",
          "code": "BUILD_CREATE_MONITORING_PROMPT_PAYLOAD",
          "type": "CODE",
          "metadata": {
            "name": "Build Create Monitoring Prompt Payload ",
            "sourceCode": "let app_ctx = $context.$nodes.PROCESS_APPLICATION_CONTEXT.$output.result ;\nlet input_values = $context.$nodes.PREPARE_PAYLOAD_FOR_CREATE.$output.result ;\nlet query = $context.$nodes.POST_INSERT_MONITORING_PROMPT_EXPRESSION.$output?.query ;\n\nlet paylaod  = {\n    \"policies\": {\n        \"items\": [\n            {\n                \"policyName\": input_values.monitoringprompt,\n                \"description\": input_values.monitoringprompt,\n                \"categoryCode\": input_values.categorycode,\n                \"timespan\": input_values.timespan,\n                \"rulePriorityCode\": input_values.ruleprioritycode,\n                \"ruleActionTypeCode\": \"ORA_INFORMATIONAL\",\n                \"startExecutionTime\":input_values.startexecutiontime,\n                \"bossFilter\": {\n                    \"determinentContext\": [\n                        \"ledgerId\"\n                    ],\n                    \"steps\": [\n                        {\n                            \"id\": 1,\n                            \"order\": 1,\n                            \"bossExtract\": query,\n                            \"securityContext\": [\n                                \"ledgerId\"\n                            ],\n                            \"SecurityContextValue\": [\n                                {\n                                    \"ledgerId\": app_ctx.ledgerId\n                                }\n                            ]\n                        }\n                    ],\n                    \"formula\": {\n                        \"conditions\": [],\n                        \"logicalOperator\": \"AND\"\n                    }\n                },\n                \"schedule\": {\n                    \"frequencyCode\": input_values.frequencycode,\n                    \"scheduledTime\": input_values.scheduledtime\n                },\n                \"actions\": input_values.actions,\n                ...(input_values.endexecutiontime !== \"\"\n          ? { endExecutionTime: input_values.endexecutiontime }\n          : {})\n            }\n        ]\n    },\n    \"sensorCode\": \"LedgerInsights\",\n    \"sensorType\": \"Signals\"\n}\n\nreturn JSON.stringify(paylaod);",
            "returnType": "object",
            "sourceType": "code"
          },
