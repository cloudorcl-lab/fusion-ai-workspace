          "id": "1781115064710",
          "code": "ERROR_HANDLER",
          "type": "CODE",
          "metadata": {
            "name": "Error Handler",
            "returnType": "string",
            "sourceCode": "let nodeCode = $context.$error.$nodeCode;\nlet errorMsg = \"Error\";\n\nswitch (nodeCode) {\n  case \"FETCH_EXTRACT_MONITORING_CONDITION\":\n    errorMsg = \"Issue with Creating Prompt\";\n    break;\n\n  case \"FETCH_EXTRACT_TIMESPAN_FREQUENCY\":\n  case \"EXTRACT_TIMESPAN_FREQUENCY_FOR_MONITORING_PROMPT\":\n  case \"RESOLVE_TIMESPAN_PERIOD\":\n  case \"RESOLVE_TIMESPAN_PERIOD_FOR_EDIT\":\n    errorMsg =\n      \"Fetching time span failed, Please enter a valid time frame. For example: 1pm PST, Every Monday at 12:00 AM, or D+5 to D+2\";\n    break;\n\n  case \"MONITORING_PROMPT_DETERMINE_QUESTION_TYPE\":\n    errorMsg =\n      \"New process exceptions monitoring prompts aren't currently supported\";\n    break;\n\n  case \"FETCH_QUERY_AND_INTENTS_FOR_MONITORING_PROMPT\":\n    errorMsg =\n      \"Fetching BQL failed, Intent details couldn't be completely determined based on the entered prompt\";\n    break;\n\n  case \"FETCH_EXTRACT_FINANCIAL_TIME_PERIOD\":\n  case \"POST_INSERT_MONITORING_PROMPT_EXPRESSION\":\n    errorMsg = \"Something Went Wrong\";\n    break;\n\n  case \"CREATE_MONITORING_PROMPT\":\n  case \"UPDATE_MONITORING_PROMPT\":\n    errorMsg = JSON.parse($context.$error.$errorMessage)?.error;\n    break;\n\n  case \"UPDATE_PROMPT_POLICY_STATUS\":\n    errorMsg = \"Monitoring Prompt cannot be enabled/disabled\"\n    break;\n}\n\nreturn errorMsg;"
          },
