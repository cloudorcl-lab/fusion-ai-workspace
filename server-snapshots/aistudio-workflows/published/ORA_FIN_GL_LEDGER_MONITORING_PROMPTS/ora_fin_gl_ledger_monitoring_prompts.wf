        {
          "metadata": {
            "name": "Process Helper data",
            "returnType": "object",
            "sourceCode": "\n\nlet toLabelValueArray = (input) => {\n    if (!input || !Array.isArray(input.items)) return [];\n\n    return input.items.map(item => ({\n        label: item.Meaning,\n        value: item.LookupCode,\n        imageUrl : item?.ImageUrl\n    }));\n};\n\nconst ORA_GL_RULE_CATEGORY_result = $context.$nodes.PROCESS_APPLICATION_CONTEXT.$output.result.ORA_GL_RULE_CATEGORY?.items || [];\nconst ORA_FUN_RULE_PRIORITY_result = $context.$nodes.PROCESS_APPLICATION_CONTEXT.$output.result.ORA_FUN_RULE_PRIORITY?.items || [];\nconst ORA_FUN_RULE_FREQUENCY_result = $context.$nodes.PROCESS_APPLICATION_CONTEXT.$output.result.ORA_FUN_RULE_FREQUENCY?.items || [];\n\nlet finalResult = {\n    ORA_GL_RULE_CATEGORY: ORA_GL_RULE_CATEGORY_result,\n    ORA_FUN_RULE_PRIORITY: ORA_FUN_RULE_PRIORITY_result,\n    ORA_FUN_RULE_FREQUENCY: ORA_FUN_RULE_FREQUENCY_result\n};\n\nreturn finalResult;"
          },
          "outcomes": {
            "success": "1776609397119"
          },
          "diagram": {
            "x": 9338.5,
            "y": 5872
          },
          "code": "PROCESS_HELPER_DATA",
          "id": "1776604887715",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Determine User Action",
            "returnType": "string",
            "sourceCode": "let resolvedActionCode = \"createMonitoringPrompt\";\n\n/* createMonitoringPrompt , showMoreMonitoringPrompt */\n\ntry {\n    const rawInput = $context.$app.$OraAction || $context.$system.$inputMessage || \"\";\n\n    if (rawInput.startsWith('<oraFormSubmit')) {\n        const match = rawInput.match(/<oraFormSubmit\\s+id=[\"']([^\"']*)[\"'][^>]*>(.*?)<\\/oraFormSubmit>/s);\n\n        if (match && match[1]) {\n            resolvedActionCode = match[1]; // <-- directly use form id\n        }\n    } else {\n        let parsedInput = {};\n\n        if (rawInput) {\n            parsedInput = JSON.parse(rawInput);\n            if (typeof parsedInput === \"string\") {\n                parsedInput = JSON.parse(parsedInput);\n            }\n        }\n\n        if (parsedInput?.actionCode) {\n            resolvedActionCode = parsedInput.actionCode;\n        }\n    }\n} catch (e) {}\n\nreturn resolvedActionCode;"
          },
          "outcomes": {
            "success": "1776608791551"
          },
