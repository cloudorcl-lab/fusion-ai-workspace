            "sourceCode": "let formValues = $context.$nodes.PROCESS_PROMPT_STATUS_PAYLOAD.$output.result || {};\nlet ruleId = formValues.ruleid;\nlet enabled = !(formValues.status === \"Enabled\");\n\nlet payload = {\n    \"policies\": {\n        \"items\": [\n            {\n                \"ruleId\": ruleId,\n                \"enabled\": enabled\n            }\n        ]\n    }\n}\n\n// Disable for all payload.\nif($context.$variables.isAdmin && !enabled && formValues.disable === \"all\") {\n  payload = {\n  ...payload,\n  \"persona\": \"admin\",\n  \"scope\": \"all\"\n  }\n}\n\nreturn JSON.stringify(payload);",
