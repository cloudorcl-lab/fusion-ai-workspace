          "code": "PREPARE_PAYLOAD_FOR_CREATE_MONITORING_PROMPT_CONFIRMATION",
          "id": "1776708436947",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "id": "1781076629125",
          "code": "PREPARE_INPUT_CONFIRMATION_OBJECT_FOR_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Input Confirmation Object For Create",
            "returnType": "object",
            "sourceCode": "const preparedConfirmation =\n  $context.$nodes.PREPARE_PAYLOAD_FOR_CREATE_MONITORING_PROMPT_CONFIRMATION.$output?.result || {};\n\nconst formResponse =\n  $context.$nodes.PROCESS_PAYLOAD_FOR_EVALUATE_MONITORING_PROMPT.$output?.result || {};\n\nconst FrequencyOptions = Array.isArray($context.$variables.OraFunRuleFrequency)\n  ? $context.$variables.OraFunRuleFrequency\n  : [];\n\nconst PriorityOptions = Array.isArray($context.$variables.OraFUNRulePriority)\n  ? $context.$variables.OraFUNRulePriority\n  : [];\n\nconst CategoryOptions = Array.isArray($context.$variables.OraGLRuleCategory)\n  ? $context.$variables.OraGLRuleCategory\n  : [];\n\nfunction parseIfJsonString(value) {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  try {\n    const parsed = JSON.parse(value);\n    return typeof parsed === \"string\" ? parseIfJsonString(parsed) : parsed;\n  } catch (e) {\n    return value;\n  }\n}\n\nfunction toObject(value) {\n  const parsed = parseIfJsonString(value);\n  return parsed && typeof parsed === \"object\" && !Array.isArray(parsed)\n    ? parsed\n    : {};\n}\n\nfunction getMeaningFromLookup(options, lookupCode) {\n  if (!lookupCode || !Array.isArray(options)) {\n    return lookupCode;\n  }\n\n  const match = options.find(item => item.LookupCode === lookupCode);\n  return match?.Meaning || lookupCode;\n}\n\nfunction convertFallbackCodesToMeanings(response) {\n  const output = { ...response };\n\n  if (output.frequency) {\n    output.frequency = getMeaningFromLookup(FrequencyOptions, output.frequency);\n  }\n\n  if (output.priority) {\n    output.priority = getMeaningFromLookup(PriorityOptions, output.priority);\n  }\n\n  if (output.category) {\n    output.category = getMeaningFromLookup(CategoryOptions, output.category);\n  }\n\n  return output;\n}\n\nfunction buildIntentStringFromArray(intentArr) {\n  if (!Array.isArray(intentArr)) {\n    return \"\";\n  }\n\n  return intentArr\n    .filter(item => item && typeof item === \"object\")\n    .map(item => {\n      const name = item.name ?? item.Name ?? item.dimensionName ?? \"\";\n      const value = item.value ?? item.Value ?? item.memberName ?? \"\";\n\n      if (name && value) {\n        return `${name}: ${value}`;\n      }\n\n      return name || value || \"\";\n    })\n    .filter(Boolean)\n    .join(\", \");\n}\n\nconst intent = parseIfJsonString(preparedConfirmation.intent);\nconst intentString = buildIntentStringFromArray(intent);\nconst fallbackFormResponse = toObject(formResponse);\nconst convertedFallback = convertFallbackCodesToMeanings(fallbackFormResponse);\n\nconst inputObj = intentString\n  ? {\n      ...convertedFallback,\n      ...{Intents: intentString}\n    }\n  : convertedFallback;\n\nreturn inputObj;"
          },
          "diagram": {
            "x": 6142.125,
            "y": 9700
          },
          "outcomes": {
            "success": "1781076726720"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1781076726720",
          "code": "PREPARE_ACTIONS_DATA_FOR_CONFIRMATION",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Actions Data For Confirmation",
            "sourceCode": "const preparedConfirmation =\n  $context.$nodes.PREPARE_PAYLOAD_FOR_CREATE_MONITORING_PROMPT_CONFIRMATION.$output?.result || {};\n\nconst formResponse =\n  $context.$nodes.PROCESS_PAYLOAD_FOR_EVALUATE_MONITORING_PROMPT.$output?.result || {};\n\nfunction parseIfJsonString(value) {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  try {\n    const parsed = JSON.parse(value);\n    return typeof parsed === \"string\" ? parseIfJsonString(parsed) : parsed;\n  } catch (e) {\n    return value;\n  }\n}\n\nfunction toObject(value) {\n  const parsed = parseIfJsonString(value);\n  return parsed && typeof parsed === \"object\" && !Array.isArray(parsed)\n    ? parsed\n    : {};\n}\n\nconst hasResponseProperty =\n  Object.prototype.hasOwnProperty.call(preparedConfirmation, \"response\");\n\nconst resolvedObj = hasResponseProperty\n  ? toObject(preparedConfirmation.response)\n  : toObject(preparedConfirmation);\n\nconst parsedFormResponse = toObject(formResponse);\n\nfunction buildInvoke(actionCode, rowData) {\n  const payload = {\n    rowData,\n    actionCode\n  };\n\n  return `ora.Invoke(\"${actionCode}\", ${JSON.stringify(payload)})`;\n}\n\nreturn {\n  actions: {\n    confirm: {\n      title: \"Confirm\",\n      shortDescription: \"\",\n      actionText: \"Confirm\",\n      followUpCommand: buildInvoke(\n        \"confirmMonitoringPromptCreateForm\",\n        resolvedObj\n      )\n    },\n    edit: {\n      title: \"Edit\",\n      shortDescription: \"\",\n      actionText: \"Edit\",\n      followUpCommand: buildInvoke(\n        \"cancelMonitoringPromptCreateForm\",\n        parsedFormResponse\n      )\n    }\n  }\n};",
            "returnType": "object"
          },
          "diagram": {
            "x": 6173.625,
            "y": 9922
          },
          "outcomes": {
            "success": "1776710572615"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "aiAppOutputSpecification": {
