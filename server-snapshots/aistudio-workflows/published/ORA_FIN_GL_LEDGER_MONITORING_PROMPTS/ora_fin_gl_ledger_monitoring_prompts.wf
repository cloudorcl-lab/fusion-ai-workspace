        {
          "metadata": {
            "name": "Process Input for Monitoring Prompt Edit",
            "returnType": "object",
            "sourceCode": "const rawInput = $context.$app.$OraAction || $context.$system.$inputMessage;\n\nlet parsedPayload = {};\nlet resolvedActionCode = \"\";\n\nfunction normalizeKey(key) {\n    return String(key)\n        .toLowerCase()\n        .replace(/[^a-z0-9]/g, \"\");\n}\n\ntry {\n    if (rawInput.startsWith(\"<oraFormSubmit\")) {\n        const match = rawInput.match(/<oraFormSubmit\\s+id=[\"']([^\"']*)[\"'][^>]*>(.*?)<\\/oraFormSubmit>/s);\n\n        if (!match) {\n            throw new Error(\"Invalid oraFormSubmit format\");\n        }\n\n        resolvedActionCode = match[1];\n\n        const jsonArray = JSON.parse(match[2]);\n\n        parsedPayload = jsonArray.reduce((acc, item) => {\n            if (!item.id) {\n                throw new Error(\"Invalid item structure\");\n            }\n\n            const normalizedKey = normalizeKey(item.id);\n            acc[normalizedKey] = item.value;\n\n            return acc;\n        }, {});\n    }\n} catch (e) {\n\n}\n\nreturn parsedPayload;"
          },
