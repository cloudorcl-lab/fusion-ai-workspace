        {
          "id": "1781271735803",
          "code": "PROCESS_PERIOD_EXPRESSION_FROM_TIMESPAN_FOR_EDIT",
          "type": "CODE",
          "metadata": {
            "name": "Process Period Expression From Timespan for Edit",
            "returnType": "object",
            "sourceCode": "const safeParse = (value, fallback) => {\n  if (value === undefined || value === null || value === \"\") {\n    return fallback;\n  }\n\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  try {\n    return JSON.parse(value);\n  } catch (e) {\n    return fallback;\n  }\n};\n\n\nconst insightsExtTimespanFreq = $context.$nodes.EXTRACT_TIMESPAN_FREQUENCY_FOR_MONITORING_PROMPT.$output?.output;\nconst insightsExtTimespanFreqObj = safeParse(insightsExtTimespanFreq, {});\nlet periodspan = insightsExtTimespanFreqObj.timespan;\n\nlet values = periodspan\n      .split(\",\")                     // split by comma\n      .map(part => part.trim())       // trim spaces\n      .map(part => part.split(/[\\+\\-]/)[0].trim());\n\nreturn {\nperiodic: insightsExtTimespanFreqObj.periodic,\nexpressionCode: values[0]\n}"
          },
          "diagram": {
