        {
          "id": "1780947919970",
          "code": "PREPARE_PAYLOAD_FOR_MONITORING_PROMPT",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Payload for Monitoring Prompt",
            "returnType": "string",
            "sourceCode": "const formValues =\n  $context.$nodes.PROCESS_INPUT_FOR_MONITORING_PROMPT_EDIT.$output?.result || {};\n\nconst resolvedValues =\n  $context.$nodes.PROCESS_RESPONSE_FOR_TIMESPAN_FREQUENCY.$output?.result || {};\n\nconst payload = {\n  policies: {\n    items: [\n      {\n        ruleId: resolvedValues.ruleId,\n        categoryCode: resolvedValues.categoryCode,\n        rulePriorityCode: resolvedValues.rulePriorityCode,\n        schedule: {\n          frequencyCode: resolvedValues.frequencyCode,\n          scheduledTime: resolvedValues.scheduledTime\n        },\n        ...(resolvedValues.startExecutionTime !== \"\"\n          ? { startExecutionTime: resolvedValues.startExecutionTime }\n          : {}),\n        ...(resolvedValues.startExecutionTime !== \"\"\n          ? {timespan: resolvedValues.timespan }\n          : {}),\n        ...(resolvedValues.endExecutionTime !== \"\"\n          ? { endExecutionTime: resolvedValues.endExecutionTime }\n          : {}),\n        ...(resolvedValues.actions && resolvedValues.actions.length > 0\n          ? { actions: resolvedValues.actions }\n          : {})\n      }\n    ]\n  }\n};\n\nreturn JSON.stringify(payload);"
          },
