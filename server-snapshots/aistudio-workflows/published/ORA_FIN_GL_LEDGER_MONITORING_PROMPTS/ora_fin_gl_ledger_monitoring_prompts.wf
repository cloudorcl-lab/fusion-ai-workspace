        {
          "id": "1782987359639",
          "code": "PROCESS_DETERMINE_QUESTION_TYPE_RESPONSE",
          "type": "CODE",
          "metadata": {
            "name": "Process Determine Question Type Response",
            "returnType": "object",
            "sourceCode": "const safeParse = (value, fallback) => {\n  if (value === undefined || value === null || value === \"\") {\n    return fallback;\n  }\n\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  try {\n    return JSON.parse(value);\n  } catch (e) {\n    return fallback;\n  }\n};\n\nconst rawOutput = $context.$nodes.MONITORING_PROMPT_DETERMINE_QUESTION_TYPE.$output?.output;\nconst parsedOutput = safeParse(rawOutput, {});\nlet app_ctx = $context.$nodes.PROCESS_APPLICATION_CONTEXT.$output.result || {};\nlet input_values = $context.$nodes.PROCESS_PAYLOAD_FOR_EVALUATE_MONITORING_PROMPT.$output.result || {};\n\n\nlet contextAVName = app_ctx.bossAvName || \"\";\nlet contextModuleName = app_ctx.avModuleName || \"\";\n\nlet currentAVName = parsedOutput.analyticView;\nlet currentModuleName = parsedOutput.module;\nlet currentBusinessObject = parsedOutput.businessObject;\nlet currentBusinessView = parsedOutput.businessView;\n\nlet bossAiBody = {};\n\nif (currentAVName === contextAVName) { // balances\n    bossAiBody = {\n        \"userQuestion\": input_values?.monitoringprompt,\n        \"taskType\": \"NL2BQL-DATA\",\n        // \"faiSearch\": true,\n        \"includeData\": false,\n        \"chartOfAccountsId\": app_ctx?.chartOfAccountsId,\n        \"addLedgerId\": true,\n        \"queries\": [\n            {\n                \"analyticView\": currentAVName ? currentAVName : contextAVName,\n                \"module\": currentModuleName ? currentModuleName : contextModuleName,\n                \"query\": {},\n                \"time_period\": [],\n                \"ledgerContext\": [app_ctx?.ledgerName],\n                \"ledgerCategory\": app_ctx?.ledgerCategory\n            }\n        ]\n    }\n}\nelse if (currentBusinessObject != undefined && currentBusinessView != undefined) { //journals/subledger BV\n    bossAiBody = {\n        \"userQuestion\": input_values?.monitoringprompt,\n        \"taskType\": \"NL2BQL-GENERIC\",\n        // \"faiSearch\": true,\n        \"includeData\": false,\n        \"chartOfAccountsId\": app_ctx?.chartOfAccountsId,\n        \"addLedgerId\": true,\n        \"queries\": [{\n            \"businessObject\": currentBusinessObject,\n            \"businessView\": currentBusinessView,\n            \"module\": currentModuleName ? currentModuleName : contextModuleName,\n            \"query\": {},\n            \"time_period\": [],\n            \"ledgerContext\": [app_ctx?.ledgerName],\n            \"ledgerCategory\": app_ctx?.ledgerCategory\n        }]\n    }\n}\nelse if (currentAVName && currentAVName != contextAVName) { //journals/subledger AV\n    bossAiBody = {\n        \"userQuestion\": input_values?.monitoringprompt,\n        \"taskType\": \"NL2BQL-GENERIC\",\n        \"includeData\": false,\n        \"chartOfAccountsId\": app_ctx?.chartOfAccountsId,\n        \"addLedgerId\": true,\n        \"queries\": [\n            {\n                \"analyticView\": currentAVName,\n                \"module\": currentModuleName ? currentModuleName : contextModuleName,\n                \"query\": {},\n                \"time_period\": [],\n                \"ledgerContext\": [app_ctx?.ledgerName],\n                \"ledgerCategory\": app_ctx?.ledgerCategory\n            }\n        ]\n    }\n}\n\nreturn JSON.stringify(bossAiBody);"
          },
