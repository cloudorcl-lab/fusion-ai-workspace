        {
          "metadata": {
            "name": "Process Create Monitoring Prompt Action Payload",
            "returnType": "object",
            "sourceCode": "const rawInput = $context.$app.$OraAction || $context.$system.$inputMessage;\n\nlet rowData = {};\n\nfunction normalizeKey(key) {\n  return String(key)\n    .toLowerCase()\n    .replace(/[^a-z0-9]/g, \"\");\n}\n\nfunction normalizeObjectKeys(obj) {\n  return Object.entries(obj || {}).reduce((acc, [key, value]) => {\n    acc[normalizeKey(key)] = value;\n    return acc;\n  }, {});\n}\n\ntry {\n  const inputMessage = rawInput || \"\";\n\n  if (inputMessage) {\n    let parsedInput = JSON.parse(inputMessage);\n\n    // handle double-encoded JSON\n    if (typeof parsedInput === \"string\") {\n      parsedInput = JSON.parse(parsedInput);\n    }\n\n    rowData = normalizeObjectKeys(parsedInput?.rowData || {});\n  }\n} catch (e) {}\n\nreturn rowData;"
          },
