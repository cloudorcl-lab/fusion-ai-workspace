            "sourceCode": "const rawQuery = $context.$nodes.PROCESS_CREATE_MONITORING_PROMPT_ACTION_PAYLOAD.$output.result.nlrqueryobj;\n\nlet query = {};\n\nif (rawQuery && typeof rawQuery === \"object\" && !Array.isArray(rawQuery)) {\n  query = rawQuery;\n} else if (typeof rawQuery === \"string\") {\n  try {\n    const parsedQuery = JSON.parse(rawQuery);\n\n    if (parsedQuery && typeof parsedQuery === \"object\" && !Array.isArray(parsedQuery)) {\n      query = parsedQuery;\n    }\n  } catch (e) {}\n}\n\nlet expression = $context.$nodes.FETCH_EXTRACT_FINANCIAL_TIME_PERIOD.$output.output || \"\";\nlet lhsCodes = [\n    \"accountingPeriodHierarchy.$memberName\",\n    \"accountingDate.$memberName\",\n    \"accountingPeriod.$memberName\",\n    \"fiscalDate.$memberName\",\n    \"periodName\",\n    \"periodName.$memberName\",\n    \"accountingDate\",\n    \"accountingPeriod\",\n    \"fiscalDate\"\n  ];\nlet replaceAttributeAliases = false;\nlet coaId = $context.$nodes.PROCESS_APPLICATION_CONTEXT.$output.result.chartOfAccountsId;\n\nlet payload = {\nquery,\nexpression,\nlhsCodes,\nreplaceAttributeAliases,\ncoaId\n}\n\nreturn JSON.stringify(payload);",
            "returnType": "object"
          },
