        {
          "id": "1780936626751",
          "code": "DISPLAY_PROMPT_POLICY_STATUS_CHANGE",
          "type": "LLM",
          "metadata": {
            "name": "Display Prompt Policy Status Change",
            "answerInUserLanguage": true
          },
          "diagram": {
