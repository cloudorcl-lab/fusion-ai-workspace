        {
          "id": "1781122497481",
          "code": "PREPARE_PAYLOAD_FOR_CREATE",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Payload For Create",
            "returnType": "object",
            "sourceCode": "const safeParse = (value, fallback) => {\n  if (value === undefined || value === null || value === \"\") {\n    return fallback;\n  }\n\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  try {\n    return JSON.parse(value);\n  } catch (e) {\n    return fallback;\n  }\n};\n\nfunction replaceAndCalculate(expr, periodDateStr, variableName) {\n  // console.log(\"In FUNCTION FOR TIMESPAN RESOLUTION\")\n  let periodDate = new Date(periodDateStr);\n\n  // Helper to format YYYY-MM-DD\n  const formatDate = (d) => d.toISOString().split(\"T\")[0];\n\n  // Build dynamic regex for the variable name\n  let regex = new RegExp(variableName + \"\\\\s*([-+]\\\\d+)?\", \"g\");\n\n  // Replace dynamically\n  return expr.replace(regex, (match, offset) => {\n    let d = new Date(periodDate);\n\n    if (offset) {\n      d.setDate(d.getDate() + parseInt(offset, 10));\n    }\n\n    return formatDate(d);\n  });\n}\n\nconst insightsExtTimespanFreq =\n  $context.$nodes.FETCH_EXTRACT_TIMESPAN_FREQUENCY.$output?.output;\n\nconst formValues =\n  $context.$nodes.PROCESS_CREATE_MONITORING_PROMPT_ACTION_PAYLOAD.$output.result?.formresp || {};\n\nconst insightsExtTimespanFreqObj = safeParse(insightsExtTimespanFreq, {});\n\nlet resolvedDates = [];\nlet periodspan = \"\";\nlet periodExpression = \"\";\nconst currentDate = new Date().toISOString().slice(0, 10);\n\nif (insightsExtTimespanFreqObj && insightsExtTimespanFreqObj.scheduleTime) {\n\n  periodspan = insightsExtTimespanFreqObj.timespan;\n  // console.log('executionTime-->', executionTime);\n  // console.log('periodspan-->', periodspan)\n  // console.log('periodic -->', insightsExtTimespanFreqObj.periodic)\n\n  if (periodspan && insightsExtTimespanFreqObj.periodic) {\n    //fetch the periodExpressionCode\n    let values = periodspan\n      .split(\",\")                     // split by comma\n      .map(part => part.trim())       // trim spaces\n      .map(part => part.split(/[\\+\\-]/)[0].trim()); // take only before + or -\n    // console.log('D value --> ', values[0]);\n\n    periodExpression = periodspan.replace(new RegExp(values[0], 'g'), `{{${values[0]}}}`);\n    // console.log(\"periodExpression -->\", periodExpression)\n\n\n\n    //call the rest endpoint to get the period date\n    const response = $context.$nodes.RESOLVE_TIMESPAN_PERIOD.$output;\n    // console.log('Response -->', JSON.stringify(response));\n\n    //if response, call function to get the start and end date\n    // console.log('resolvedDate -->', response.body.resolvedDate);\n    // console.log('resolvedDate 2 -->', response.body.resolvedDate);\n    //resolvedDates = await $fragment.functions.replaceAndCalculate(periodspan, response.body.resolvedDate, values[0]);\n    resolvedDates = replaceAndCalculate(periodspan, response.resolvedDate, values[0]);\n    resolvedDates = resolvedDates.split(\",\").map(d => d.trim());\n    const endDate = new Date(resolvedDates[1]).toISOString().slice(0, 10);\n    if (endDate < currentDate) {\n      resolvedDates = replaceAndCalculate(periodspan, response.nextResolvedDate, values[0]);\n      resolvedDates = resolvedDates.split(\",\").map(d => d.trim());\n    }\n    // console.log('resoved date -->', resolvedDates);\n    // console.log('resoved date -->', resolvedDates.split(\",\").map(d => d.trim()));\n\n    //<TODO> check for null timespan and populate with current dates\n  } else {\n    periodExpression = periodspan;\n    resolvedDates = periodspan.split(\",\").map(d => d.trim());\n  }\n}\n\nconst timezone = insightsExtTimespanFreqObj?.timezone || \"UTC\";\nconst executionDate = new Date().toISOString().split(\"T\")[0];\n\nconst timespan = JSON.stringify({\n  displayValue: formValues.timeframe || \"\",\n  resolvedValue: periodExpression || \"\"\n});\n\nlet startexecutiontime = resolvedDates?.[0] ? `${resolvedDates[0]}T00:00 UTC` : \"\";\nif (resolvedDates?.[0] < currentDate || resolvedDates?.[0] === \"\") {\n  startexecutiontime = `${currentDate}T00:00 UTC`\n}\n\nlet endexecutiontime = \"\";\nif (resolvedDates?.[1] && resolvedDates?.[1] !== null && resolvedDates?.[1] !== \"null\") {\n  endexecutiontime = resolvedDates?.[1] ? `${resolvedDates[1]}T23:59 UTC` : \"3000-01-01T23:59 UTC\";\n}\nelse if (resolvedDates?.[1] == null || resolvedDates?.[1] == 'null') {\n  endexecutiontime = \"3000-01-01T23:59 UTC\";\n}\n\n\nlet actions = [];\nlet inputRecipients = formValues.recipients || \"\";\nconst recipients = (inputRecipients)\n  .split(\",\")\n  .map(name => name.trim().replace(/\\s+/g, \"_\"))\n  .filter(Boolean);\n\nconst recipientType = formValues?.recipienttype || undefined;\n\nif (recipientType === undefined) {\n    actions.push({\n    actionOrder: 1,\n    actionType: \"INSIGHT\",\n    actionParameters: {\n    recipients: [\n        { \n        value: $context.$user.$name, \n        type: \"ORA_USER\" \n        }\n        ]\n    }\n    });\n}\nelse if (recipientType === \"Role\") {\n    actions.push({\n    actionOrder: 1,\n    actionType: \"INSIGHT\",\n    actionParameters: {\n        recipients: [\n        { \n            value: recipients[0], \n            type: \"ORA_ROLE\" \n        }\n        ]\n    }\n    });\n}\nelse if (recipientType === \"User\") {\n    const formattedRecipients = recipients.map(user => ({\n    value: user,\n    type: \"ORA_USER\"\n    }));\n\n    actions.push({\n    actionOrder: 1,\n    actionType: \"INSIGHT\",\n    actionParameters: {\n        recipients: formattedRecipients\n    }\n    });\n}\n\nconst output = {\n  monitoringprompt: formValues.monitoringprompt,\n  categorycode: formValues.category,\n  ruleprioritycode: formValues.priority,\n  frequencycode: formValues.frequency,\n  scheduledtime: insightsExtTimespanFreqObj?.scheduleTime ? insightsExtTimespanFreqObj.scheduleTime.replace(/^(\\d{2}:\\d{2})\\s*,/,`$1 ${insightsExtTimespanFreqObj.timezone || \"UTC\"},`): \"00:00 UTC, -, -, -, -, -, -\",\n  startexecutiontime,\n  timespan,\n  endexecutiontime,\n  actions\n};\n\nreturn output;"
          },
