            "y": 7870
          },
          "code": "PROCESS_SELECTED_MONITORING_PROMPT",
          "id": "1776399126730",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "id": "1781171204680",
          "code": "PREPARE_ACTIONS_FOR_SELECTED_MONITORING_PROMPT",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Actions For Selected Monitoring Prompt",
            "returnType": "object",
            "sourceCode": "let isAdmin = $context.$variables.isAdmin;\nlet rowData = $context.$nodes.PROCESS_SELECTED_MONITORING_PROMPT.$output.result;\n\nfunction buildInvokeCommand(actionName, context) {\n  return `ora.Invoke(\"${actionName}\", ${JSON.stringify(context)})`;\n}\n\nfunction buildAction({\n  title,\n  actionText,\n  actionName,\n  rowData,\n  actionCode\n}) {\n  return {\n    title,\n    shortDescription: \"\",\n    actionText,\n    followUpCommand: buildInvokeCommand(actionName, {\n      rowData,\n      actionCode\n    })\n  };\n}\n\nfunction normalizeStatus(status) {\n  return String(status || \"\").trim().toLowerCase();\n}\n\nfunction buildMonitoringPromptActions(input) {\n  const rowData = input || {};\n  const status = rowData.Status ?? \"Disabled\";\n\n  const isEnabled = normalizeStatus(status) === \"enabled\";\n\n  const actions = [];\n\n  actions.push(\n    buildAction({\n      title: \"Edit\",\n      actionText: \"Edit Prompt\",\n      actionName: \"editMonitoringPrompt\",\n      rowData,\n      actionCode: \"editMonitoringPrompt\"\n    })\n  );\n\n  if (isEnabled) {\n    if (isAdmin) {\n      actions.push(\n        buildAction({\n          title: \"Disable for myself\",\n          actionText: \"Disable for myself\",\n          actionName: \"changePolicyStatus\",\n          rowData: {\n            ...rowData,\n            disable: \"self\"},\n          actionCode: \"changePolicyStatus\"\n        })\n      );\n\n      actions.push(\n        buildAction({\n          title: \"Disable for all\",\n          actionText: \"Disable for all\",\n          actionName: \"changePolicyStatus\",\n          rowData: {\n            ...rowData,\n            disable: \"all\"},\n          actionCode: \"changePolicyStatus\"\n        })\n      );\n    } else {\n      actions.push(\n        buildAction({\n          title: \"Disable\",\n          actionText: \"Disable\",\n          actionName: \"changePolicyStatus\",\n          rowData,\n          actionCode: \"changePolicyStatus\"\n        })\n      );\n    }\n  } else {\n    actions.push(\n      buildAction({\n        title: \"Enable\",\n        actionText: \"Enable\",\n        actionName: \"changePolicyStatus\",\n        rowData,\n        actionCode: \"changePolicyStatus\"\n      })\n    );\n  }\n\n  actions.push(\n    buildAction({\n      title: \"Duplicate\",\n      actionText: \"Duplicate Prompt\",\n      actionName: \"duplicatePromptTemplate\",\n      rowData,\n      actionCode: \"duplicatePromptTemplate\"\n    })\n  );\n\n  return actions;\n}\n\n\nconst result = buildMonitoringPromptActions(rowData);\n\nreturn result;"
          },
          "diagram": {
            "x": 8370,
            "y": 8092
          },
