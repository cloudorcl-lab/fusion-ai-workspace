        {
          "metadata": {
            "name": "Process Query and Intent Response",
            "returnType": "object",
            "sourceCode": "const formResp =\n  $context.$nodes.PROCESS_PAYLOAD_FOR_EVALUATE_MONITORING_PROMPT.$output?.result || {};\n\nconst nlresolverResp =\n  $context.$nodes.FETCH_QUERY_AND_INTENTS_FOR_MONITORING_PROMPT.$output || {};\n\nif (nlresolverResp.errorCode || nlresolverResp.errorMessage) {\n  return {\n    errorMessage: \"Intent details couldn't be completely determined based on the entered prompt.\"\n  };\n}\n\nconst response = {\n  formResp,\n  nlrQueryObj: JSON.stringify(nlresolverResp?.queries?.[0] || {})\n};\n\nreturn response;"
          },
          "outcomes": {
            "success": "1783070410392"
          },
          "diagram": {
            "x": 6465.75,
            "y": 9034
          },
          "code": "PROCESS_QUERY_AND_INTENT_RESPONSE",
          "id": "1776624860789",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Prepare Payload For Create Monitoring Prompt Confirmation",
            "returnType": "object",
            "sourceCode": "const safeParse = (value, fallback) => {\n  if (value === undefined || value === null || value === \"\") {\n    return fallback;\n  }\n\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  try {\n    return JSON.parse(value);\n  } catch (e) {\n    return fallback;\n  }\n};\n\nconst resp = safeParse($context.$nodes.PROCESS_QUERY_AND_INTENT_RESPONSE.$output.result, {});\nconst nlrQuery = safeParse(resp.nlrQueryObj, {});\nconst rawIntentDetails = safeParse(nlrQuery.intentDetails, {});\n\nconst rawOutput = $context.$nodes.MONITORING_PROMPT_DETERMINE_QUESTION_TYPE.$output?.output;\nconst parsedOutput = safeParse(rawOutput, {});\nlet app_ctx = $context.$nodes.PROCESS_APPLICATION_CONTEXT.$output.result || {};\n\nlet contextAVName = app_ctx.bossAvName || \"\";\nlet contextModuleName = app_ctx.avModuleName || \"\";\n\nlet currentAVName = parsedOutput.analyticView;\n\nlet metadata = app_ctx.hierarchyMetaData || {};\n\nconst prepareAgentBqlChips = (bqlRes, avMetadata, chipsToExclude)=>{\n    let bqlChipsArr = [];\n    avMetadata = Object.fromEntries(\n        Object.entries(avMetadata).filter(([key, value]) => {\n            return typeof value === 'object' && value !== null && 'segmentTypeCode' in value && (value.segmentTypeCode === \"COA\" || value.segmentTypeCode === \"AC\" || value.segmentTypeCode === \"T\" || value.segmentTypeCode === \"L\");\n        })\n    );\n    // // console.log(\"avMEatdata\", avMetadata);\n    let cleanedBql = bqlRes.replace(/[\\n\\t]/g, '');\n\n    let filtersArr = cleanedBql.split(\"AND\");\n    let filters = {};\n    filtersArr.forEach(f => {\n        let hierName = \"\";\n        let attribute = \"\";\n        if (f.split(\".$memberName\").length > 1) {\n            hierName = f.split(\".$memberName\")[0].trim();\n            attribute = \"memberName\";\n        }\n        else if (f.split(\".$memberDescription\").length > 1) {\n            hierName = f.split(\".$memberDescription\")[0].trim();\n            attribute = \"memberDescription\";\n        }\n\n        if (hierName === \"\") return;\n        if (f.includes(\"=\")) {\n            let filterVal = f.split(\"=\")[1];\n            filterVal = filterVal.trim().replace(/^[\"']|[\"']$/g, '');\n            if (hierName in filters) {\n                let hierObj = filters[hierName];\n                hierObj[attribute] = filterVal;\n                filters[hierName] = hierObj;\n            }\n            else {\n                let hierObj = {};\n                hierObj[attribute] = filterVal;\n                filters[hierName] = hierObj;\n            }\n        }\n        else {\n            try {\n                const inMatch = f.match(/IN\\s*\\(([^)]+)\\)/i);\n                if (inMatch) {\n                    let inValues = inMatch[1].trim().replace(/'/g, '').split(',').map(val => val.trim()).join(', ');\n                    if (hierName in filters) {\n                        let hierObj = filters[hierName];\n                        hierObj[attribute] = inValues;\n                        filters[hierName] = hierObj;\n                    }\n                    else {\n                        let hierObj = {};\n                        hierObj[attribute] = inValues;\n                        filters[hierName] = hierObj;\n                    }\n                }\n            }\n            catch (e) {\n                return;\n            }\n        }\n    });\n\n    let povArr = [];\n    Object.entries(filters).forEach(([key, value]) => {\n        if (!(key in avMetadata) || (chipsToExclude.includes(avMetadata[key].dimensionAttributeName.replace('vFR', 'vf')))) {\n            return;\n        }\n        let filterObj = {};\n        let label = avMetadata[key].label;\n        if (label.toLowerCase().includes('accountingperiod')) {\n            label = \"Accounting Period\";\n        }\n        filterObj[\"dimensionName\"] = label;\n        filterObj[\"memberName\"] = value.memberName;\n        filterObj[\"memberDescription\"] = value.memberDescription === undefined ? value.memberName : value.memberDescription;\n        filterObj[\"treeDetails\"] = \"All VF Accounts-v1\";\n\n        povArr.push(filterObj);\n    });\n    // povArr.sort((a,b)=> a.columnOrder - b.columnOrder);\n    return povArr;\n}\n\nconst prepareBVbqlChips = (intentDetails) => {\n  let povArr = [];\n  Object.entries(intentDetails).forEach(([key, value]) => {\n    let filterObj = {};\n    filterObj[\"name\"] = key;\n    filterObj[\"value\"] = value;\n    filterObj[\"memberDescription\"] = value;\n    // filterObj[\"treeDetails\"] =\"All VF Accounts-v1\";\n\n    povArr.push(filterObj);\n  });\n  return povArr;\n}\n\nconst PrepareIntents = () => {\n\n  let preparedChips = [];\n\n  if (currentAVName === contextAVName) {\n    let bossQuery = nlrQuery;\n    let chipsToExclude = [];\n    let filter = bossQuery.analyticViews.avUsage1.filter;\n    preparedChips = prepareAgentBqlChips(filter, metadata, chipsToExclude);\n  } else {\n    preparedChips = prepareBVbqlChips(rawIntentDetails);\n  }\n\n  return preparedChips;\n}\n\nreturn {\n  response: resp,\n  intent: PrepareIntents()\n};"
          },
          "outcomes": {
            "success": "1781076629125"
          },
