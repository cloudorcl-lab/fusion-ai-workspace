        {
          "metadata": {
            "name": "Process Selected Monitoring Prompt",
            "returnType": "object",
            "sourceCode": "let rowData = {};\n\ntry {\n    const rawInput = $context.$app.$OraAction || $context.$system.$inputMessage || \"\";\n\n    if (rawInput) {\n        let parsedInput = JSON.parse(rawInput);\n\n        // handle double-encoded JSON\n        if (typeof parsedInput === \"string\") {\n            parsedInput = JSON.parse(parsedInput);\n        }\n\n        rowData = parsedInput?.rowData || {};\n    }\n} catch (e) {}\n\n\nlet output = {\n    ruleId: rowData.ruleId,\n    MonitoringPrompt: rowData.monitoringPrompt,\n    Category: rowData.categoryCodeMeaning,\n    CategoryCode: rowData.categoryCode,\n    Frequency: rowData.frequencyCodeMeaning,\n    FrequencyCode: rowData.frequencyCode,\n    TimeFrame: rowData.timeframe,\n    Priority: rowData.rulePriorityCodeMeaning,\n    PriorityCode: rowData.rulePriorityCode,\n    ruleActionTypeCode: rowData.ruleActionTypeCode,\n    CreatedBy: rowData.createdBy,\n    Status: rowData.status,\n    RecipientType: rowData.recipientType,\n    recipients: rowData.assignedTo\n}  \n\nreturn output;"
          },
