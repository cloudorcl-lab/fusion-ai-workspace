                {
                  "metadata": {
                    "name": "PromptGenerator"
                  },
                  "outcomes": {
                    "success": "1767720062012"
                  },
                  "code": "PROMPTGENERATOR",
                  "id": "1767719949334",
                  "inputs": [
                    {
                      "id": "1767719949335_1",
                      "name": "prompt",
                      "type": "string",
                      "value": "You are an expert Prompt Generator for Oracle Agent Studio workflows.\n\nYou are given a SINGLE workflow node of type \"LLM\".\nYour task is to generate a production-grade LLM prompt for this node.\n\nUse the node's \"characteristic\" field as the authoritative description of what the LLM must do.\n\nPrompt construction rules:\n1. Clearly define the assistant’s role.\n2. Clearly define the task to perform.\n3. Do NOT suggest input format.\n4. Do NOT suggest output format.\n5. Do NOT infer, hallucinate, or invent values.\n6. Do NOT include natural language explanations in the output.\n7. The prompt must be deterministic and safe for downstream Business Object consumption.\n\nOutput requirements:\n- Return ONLY the generated prompt text.\n- Do NOT wrap the output in JSON.\n- Do NOT include commentary, headers, or explanations.\n- Populate llmPrompt with the generated prompt\n\nInput LLM node:\n {{$context.$nodes.LOOPNODES.$currentItem}}"
                    }
                  ],
                  "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"llmPrompt\": {\n            \"type\": \"string\"\n        }\n    }\n}",
                  "type": "LLM"
                },
                {
                  "metadata": {
                    "name": "ResolveBONodeParams",
                    "returnType": "object",
                    "sourceCode": "const curbonode = $context.$nodes.LOOPNODES.$currentItem;\nconst curbonodeidx = $context.$nodes.LOOPNODES.$currentItemIndex;\nconst prevllmnodeidx = $context.$nodes.LOOPNODES.$currentItemIndex - 1;\n//const prevllmnode = $context.$triggers.REST.$input.inputArray[prevllmnodeidx]\nconst prevllmnode = $context.$nodes.FLATTENARRAY.$output.result[prevllmnodeidx];\n\n\n// Ensure interimArray exists\nlet tempvar = $context.$variables.interimArray || [];\n\nlet resolvedParams;\n\nlet myparams = [];\nlet boParams = [];\nlet i;\nlet nodecode;\n\n   if ( curbonode && curbonode.businessObjectFunction && curbonode.businessObjectFunction.implementation && curbonode.businessObjectFunction.implementation.parameters ) { \n\nboParams = curbonode.businessObjectFunction.implementation.parameters; \nnodecode = prevllmnode.code\n\n}\n\n    for (i = 0; i < boParams.length; i++) {\n        myparams.push({\n        name: boParams[i].name,\n        value: \"{{$context.$nodes.\" + nodecode + \".$output.\" + boParams[i].name + \"}}\"\n        });\n    }\n\n    resolvedParams = {\n        node_id: curbonode.node_id || curbonodeidx,\n        node_type: curbonode.code,\n        characteristic: curbonode.characteristic,\n        params: myparams\n    };\n\n $context.$variables.resolvedNodes.push(resolvedParams);\nreturn resolvedParams;"
                  },
                  "outcomes": {
                    "success": "end_1767718986500"
                  },
                  "code": "RESOLVEBONODEPARAMS",
                  "id": "1767720007005",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "prepareLLMParams",
                    "returnType": "object",
                    "sourceCode": "const node = $context.$nodes.LOOPNODES.$currentItem;\nconst idx = $context.$nodes.LOOPNODES.$currentItemIndex + 1;\n\n$context.$variables.resolvedNodes = $context.$variables.resolvedNodes || [];\nlet resolvedParams = {\n        code: node.code || (\"llm_node_\"+ idx),\n        node_id: node.node_id || idx, \n        node_type: \"LLM\",\n        characteristic: node.characteristic,\n        params: {\n            prompt: $context.$nodes.LOOPNODES.PROMPTGENERATOR.$output.llmPrompt\n        }\n};\n\n// Add the object to the array\n$context.$variables.resolvedNodes.push(resolvedParams);\nreturn resolvedParams;"
                  },
                  "outcomes": {
                    "success": "end_1767718986500"
                  },
                  "code": "PREPARELLMPARAMS",
                  "id": "1767720062012",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "CodeParams",
                    "returnType": "object",
                    "sourceCode": "const node = $context.$nodes.LOOPNODES.$currentItem;\nconst idx = $context.$nodes.LOOPNODES.$currentItemIndex + 1;\n\n// Ensure interimArray exists\nlet tempvar = $context.$variables.interimArray || [];\n\nlet resolvedParams;\n\nresolvedParams = {\n        node_id: node.node_id || idx,\n        node_type: node.node_type,\n        characteristic: node.characteristic\n    };\n\n $context.$variables.resolvedNodes.push(resolvedParams);\nreturn resolvedParams;"
                  },
                  "outcomes": {
                    "success": "end_1767718986500"
                  },
                  "code": "CODEPARAMS",
                  "id": "1767720093201",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "Add (TOOL Case)",
                    "description": "Add node for TOOL case branch"
