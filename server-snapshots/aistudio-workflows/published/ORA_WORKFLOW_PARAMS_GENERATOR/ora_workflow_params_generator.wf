        {
          "metadata": {
            "name": "setFlattenArray"
          },
          "outcomes": {
            "success": "1767718986500"
          },
          "code": "SETFLATTENARRAY",
          "id": "1772646956145",
          "inputs": [
            {
              "id": "1772646973589",
              "name": "flattenArray",
              "scope": "JOB",
              "type": "object",
              "value": "{{$context.$nodes.FLATTENARRAY.$output.result}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "flattenArray",
            "returnType": "object",
            "sourceCode": "let nodes =$context.$triggers.REST.$input.inputArray;\nlet flattenNodes = [];\n\nwhile (nodes.length) {\n    const node = nodes.shift();\n    flattenNodes.push(node);\n    if (node.true && node.true.length) { \n        for (const innerNode of node.true) {\n            nodes.push(innerNode);\n        }\n        delete node.true;\n        delete node.characteristic;\n    }\n    if (node.false && node.false.length) { \n        for (const innerNode of node.false) {\n            nodes.push(innerNode);\n        }\n        delete node.false;\n        delete node.characteristic;\n    }\n    if (node.children && node.children.length) { \n        for (const innerNode of node.children) {\n            nodes.push(innerNode);\n        }\n        delete node.children;\n        delete node.characteristic;\n    }\n}\n\nreturn flattenNodes;"
          },
          "outcomes": {
            "success": "1772646956145"
          },
          "code": "FLATTENARRAY",
          "convergenceTargetId": "1772646956145",
          "id": "1772577499406",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "flattenData",
            "returnType": "object",
            "sourceCode": "let resolvedNodes = [];\n\n// Each iteration of loopNodes returns a JSON string\nfor (const output of $context.$nodes.LOOPNODES.$output ) {\n    let res = output;\n    try {\n        res = JSON.parse(res);\n    } catch(err) {}\n    if (res && res.result) {\n        resolvedNodes.push(res.result);\n    }\n}\n\n\nreturn {resolvedNodes};"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "FLATTENDATA",
          "convergenceTargetId": "1772729479160",
          "id": "1767720207689",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
      ],
