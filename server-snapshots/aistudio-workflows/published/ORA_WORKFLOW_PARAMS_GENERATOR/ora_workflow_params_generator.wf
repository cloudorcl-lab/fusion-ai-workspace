                },
                {
                  "metadata": {
                    "name": "EmailGenerator"
                  },
                  "outcomes": {
                    "success": "1772224511729"
                  },
                  "code": "EMAILGENERATOR",
                  "id": "1772224466884",
                  "inputs": [
                    {
                      "id": "1772224466886_1",
                      "name": "prompt",
                      "type": "string",
                      "value": "You are an assistant that parses a {{$context.$nodes.LOOPNODES.$currentItem}}  , {$context.$triggers.REST.$input.inputArray}} and user input and extracts required fields into a JSON object. \nYour task is: read the user inputs exactly as provided and produce a single JSON object with only these two fields: from_email and to_email. \n\nList of emails construction rules:\n1. For from_email: it could appear as sender address, email sender, from, message sender.  If the input contains a valid email address, return it exactly; if no valid email is present, set from_email to email1@mail.com.\n2. For to_email: It could be appear as recipient, recipientEmail, recipient's email address to email, to, addressee, primary recipient. If the input contains a valid email address, return it exactly; if no valid email is present, set to_email to email2@mail.com.\n3. Should populate the fields to_email and from_email .\n4. The to_email and from_email must contains a valid email address.\n5. Have to validate that the to_email and from_email are not empty.\n6. Do NOT suggest input format.\n7. Do NOT suggest output format.\n8. Do NOT infer, hallucinate, or invent values.\n9. Do NOT include natural language explanations in the output.\n\nOutput requirements:\n- Return ONLY valid email's accounts\n- Do NOT include commentary, headers, or explanations.\n- Do not emit any additional keys, metadata, comments, or explanatory text.\n- Output only the JSON object and nothing else."
                    }
                  ],
                  "type": "LLM",
                  "convergenceTargetId": "1772224511729"
                },
                {
                  "metadata": {
                    "name": "EmailParams",
                    "returnType": "object",
                    "sourceCode": "//\n\nconst emailNode = $context.$nodes.LOOPNODES.$currentItem;\nconst emailNodeId = $context.$nodes.LOOPNODES.$currentItemIndex ;\nconst previousNode = $context.$nodes.FLATTENARRAY.$output.result[emailNodeId - 1];\n\n\nlet body;\nif (previousNode && previousNode.node_type === 'LLM') {\n  body = `{{$context.$nodes.${previousNode.code}.$output}}`;\n}\n$context.$variables.resolvedNodes = $context.$variables.resolvedNodes || [];\nlet resolvedParams = {\n        code: emailNode.code  || (\"email_\" + emailNodeId),\n        node_id: emailNodeId, \n        node_type: \"EMAIL\",\n        params: {\n            sender: $context.$nodes.LOOPNODES.EMAILGENERATOR.$output.from_email,\n            toList: $context.$nodes.LOOPNODES.EMAILGENERATOR.$output.to_email,\n            //ccList: [],\n            subject: emailNode.characteristic.subject,\n            body: body || emailNode.characteristic.body,\n        }\n};\n\n// Add the object to the resolvedNodes\n$context.$variables.resolvedNodes.push(resolvedParams);\nreturn resolvedParams;"
                  },
                  "outcomes": {
                    "success": "end_1767718986500"
                  },
                  "code": "EMAILPARAMS",
                  "convergenceTargetId": "1772498351447",
                  "id": "1772224511729",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "IFParams",
                    "returnType": "object",
                    "sourceCode": "const ifNode =  $context.$nodes.LOOPNODES.$currentItem;\nconst ifNodeId =  $context.$nodes.LOOPNODES.$currentItemIndex;\nconst previousNode = $context.$nodes.FLATTENARRAY.$output.result[ifNodeId-1];\n\n$context.$variables.resolvedNodes = $context.$variables.resolvedNodes || [];\n\nconst ifConditionOutput = $context.$nodes.LOOPNODES.IF_CONDITION.$output ;\nconst condition = ifConditionOutput.condition !== 'valid' ? `{{$context.$nodes.${previousNode.code }.$output.${ ifConditionOutput.condition} ${ifConditionOutput.comparison} }}` : \"{{!!$context.$nodes.\" + previousNode.code + \".$output}}\";\nlet resolvedParams = {\n        code: ifNode.code  || (\"if_node_\" + ifNodeId),\n        node_id: ifNode.node_id || ifNodeId, \n        node_type: \"IF\",\n       characteristic: ifNode.characteristic,\n        params: {\n            \"If Condition\":  condition,\n        },\n};\n\n// Add the object to the resolvedNodes\n$context.$variables.resolvedNodes.push(resolvedParams);\nreturn resolvedParams;"
                  },
                  "outcomes": {
                    "success": "end_1767718986500"
                  },
                  "code": "IFPARAMS",
                  "convergenceTargetId": "1772498351447",
                  "id": "1772224548387",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "ifInfo",
                    "returnType": "object",
                    "sourceCode": "const ifNode =  $context.$nodes.LOOPNODES.$currentItem;\nconst ifNodeId =  $context.$nodes.LOOPNODES.$currentItemIndex;\nconst previousNode = $context.$nodes.FLATTENARRAY.$output.result[ifNodeId-1];\nlet boParams;      \nif (previousNode && previousNode.businessObjectFunction && previousNode.businessObjectFunction.implementation && previousNode.businessObjectFunction.implementation.parameters && previousNode.businessObjectFunction.implementation.parameters.length) {\n     boParams = previousNode.businessObjectFunction.implementation.parameters\n }\nconst previousNodeParams = [];\nif (boParams && boParams.length) {\n  for (const field of boParams) {\n    previousNodeParams[field.name] = {type: field.dataType, items: field.items}; \n  }\n}\nconst ret = {\n  condition:  ifNode.condition,\n  previousNodeType: previousNode ? previousNode.node_type : null,\n  previousNodeParams,\n}; \n\nret;"
                  },
                  "outcomes": {
                    "success": "1772784786664"
                  },
                  "code": "IFINFO",
                  "id": "1772783714836",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "IF Condition"
                  },
                  "outcomes": {
                    "success": "1772224548387"
                  },
                  "code": "IF_CONDITION",
                  "id": "1772784786664",
                  "inputs": [
                    {
                      "id": "1772784786667_1",
                      "name": "prompt",
                      "type": "string",
                      "value": "You will be passed the expected input to an if condition and fields for a rest call.\n\nIf the condition is to return if valid, return\n{condition: \"valid\"}\n\nOtherwise, if the condition references a field \n{\n  condition: <the name of the fields, and only that field with no parent object>,\n  comparison: <a a single valid JavasScript condition the field is being compared to; include the operator but not the field>\n} \n\nInputs:\ncondition:  {{$context.$nodes.LOOPNODES.IFINFO.$output.result.condition}} \nparamaters:  {{$context.$nodes.LOOPNODES.IFINFO.$output.result.previousNodeParams}} \nprevious node type:  {{$context.$nodes.LOOPNODES.IFINFO.$output.result.previousNodeType}} \n\n"
                    }
                  ],
                  "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"comparison\": {\n            \"type\": \"string\"\n        },\n        \"condition\": {\n            \"type\": \"string\"\n        }\n    }\n}",
                  "type": "LLM"
                }
              ],
