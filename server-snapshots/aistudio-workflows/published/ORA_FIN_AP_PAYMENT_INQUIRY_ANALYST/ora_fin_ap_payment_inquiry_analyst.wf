                {
                  "id": "1784110755617",
                  "code": "FORMAT_PAYMENT_RECONCILIATION_EXCEPTION",
                  "type": "CODE",
                  "metadata": {
                    "name": "Format Payment Reconciliation Exception",
                    "returnType": "object",
                    "sourceCode": "var response = $context.$nodes.FETCH_PAYMENT_CLEARING_RECONCILIATION_EXCEPTIONS.$output;\n\nvar currentItem = $context.$nodes.FIN_AP_FOR_PAYMENT_INQUIRY_OBJECT_FETCH_LOOP.$currentItem || {};\nvar fieldsConfig = currentItem.fields || {};\nvar fields = fieldsConfig.fields || currentItem.fields || [];\nvar fieldAlias = fieldsConfig.fieldAlias || currentItem.fieldAlias || {};\nvar columns = currentItem.columns || [];\n\nfunction hasOwn(obj, key) {\n    return Object.prototype.hasOwnProperty.call(obj, key);\n}\n\nfunction trimValue(value) {\n    return String(value).replace(/^\\s+|\\s+$/g, \"\");\n}\n\nfunction normalizeKey(key) {\n    return String(key || \"\").replace(/[^a-zA-Z0-9]/g, \"\").toLowerCase();\n}\n\nfunction formatValue(value) {\n    if (typeof value === \"string\" && value.indexOf(\"T00:00:00Z\") > -1) {\n        return value.substring(0, 10);\n    }\n    return value;\n}\n\nfunction getRowValue(row, key) {\n    if (!key) {\n        return null;\n    }\n\n    if (hasOwn(row, key)) {\n        return row[key];\n    }\n\n    var wanted = normalizeKey(key);\n\n    for (var rowKey in row) {\n        if (hasOwn(row, rowKey) && normalizeKey(rowKey) === wanted) {\n            return row[rowKey];\n        }\n    }\n\n    return null;\n}\n\n// Normalize response\nif (typeof response === \"string\") {\n    try {\n        response = JSON.parse(response);\n    } catch (e) {\n        response = [];\n    }\n}\n\nif (!Array.isArray(response)) {\n    response = response ? [response] : [];\n}\n\n// Normalize fieldAlias\nif (typeof fieldAlias === \"string\") {\n    try {\n        fieldAlias = JSON.parse(fieldAlias);\n    } catch (e1) {\n        fieldAlias = {};\n    }\n}\n\nif (!fieldAlias || typeof fieldAlias !== \"object\" || Array.isArray(fieldAlias)) {\n    fieldAlias = {};\n}\n\n// Fallback aliases for this extraction\nif (Object.keys(fieldAlias).length === 0) {\n    fieldAlias = {\n        \"Payment Number\": \"paymentNumber\",\n        \"Supplier\": \"supplierName\",\n        \"Bank Account\": \"bankAccountName\",\n        \"Payment Amount\": \"paymentAmount\",\n        \"Payment Date\": \"paymentDate\",\n        \"Cleared Amount\": \"clearedAmount\",\n        \"Cleared Date\": \"clearedDate\",\n        \"Exception\": \"exception\",\n        \"Variance\": \"variance\"\n    };\n}\n\n// Normalize fields\nvar normalizedFields = [];\n\nif (typeof fields === \"string\") {\n    var splitFields = fields.split(\",\");\n    for (var i = 0; i < splitFields.length; i++) {\n        var fieldName = trimValue(splitFields[i]);\n        if (fieldName) {\n            normalizedFields.push(fieldName);\n        }\n    }\n} else if (Array.isArray(fields)) {\n    for (var j = 0; j < fields.length; j++) {\n        var arrayFieldName = trimValue(fields[j]);\n        if (arrayFieldName) {\n            normalizedFields.push(arrayFieldName);\n        }\n    }\n}\n\nfields = normalizedFields;\n\n// Build reverse alias map\nvar reverseAlias = {};\n\nfor (var alias in fieldAlias) {\n    if (hasOwn(fieldAlias, alias)) {\n        reverseAlias[fieldAlias[alias]] = alias;\n    }\n}\n\n// Build column order\nvar columnOrder = [];\n\nif (fields.length > 0) {\n    for (var f = 0; f < fields.length; f++) {\n        var field = fields[f];\n        columnOrder.push(reverseAlias[field] || field);\n    }\n}\n\nif (columnOrder.length === 0) {\n    for (var aliasName in fieldAlias) {\n        if (hasOwn(fieldAlias, aliasName)) {\n            columnOrder.push(aliasName);\n        }\n    }\n}\n\n// Build table rows\nvar content = [];\n\nfor (var r = 0; r < response.length; r++) {\n    var row = response[r] || {};\n    var normalizedRow = {};\n\n    for (var c = 0; c < columnOrder.length; c++) {\n        var columnAlias = columnOrder[c];\n        var fieldPath = fieldAlias[columnAlias] || columnAlias;\n        normalizedRow[columnAlias] = formatValue(getRowValue(row, fieldPath));\n    }\n\n    content.push(normalizedRow);\n}\n\nvar output = {\n    type: \"table\",\n    heading: \"Payment Exceptions\",\n    columnOrder: columnOrder,\n    content: content\n};\n\nreturn output;"
