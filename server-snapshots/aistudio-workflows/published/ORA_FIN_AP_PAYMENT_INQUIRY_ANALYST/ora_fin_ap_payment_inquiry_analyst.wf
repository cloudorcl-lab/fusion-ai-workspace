          "id": "1772686862255",
          "inputs": [
            {
              "id": "1775449827063",
              "name": "pprPaymentMethodVsSupplierDefault",
              "value": "{\"name\":\"pprPaymentMethodVsSupplierDefault\",\"type\":\"extraction\",\"examples\":[\"Show me payments where the payment method differs from the default method\",\"Show payments with mismatched payment methods\",\"List payments where PPR payment method is different from default payment method\",\"Is there a mismatch between the Payment Method on the PPR FIN_02001245 and the Default Methods on the Supplier Site?\"],\"description\":\"Use this shape whenever the user requests payments where the PPR payment method does not match the supplier default payment method. The SQL skeleton must remain unchanged except for replacing the optional {filter} placeholder with a caller-generated SQL filter fragment or an empty string.\",\"fields\":\"PAYMENTNUMBER,PAYMENTDATE,PPRPAYMENTMETHOD,DEFAULTPAYMENTMETHOD,PAYMENTAMOUNT,CURRENCYCODE,SUPPLIERSITENAME\",\"fieldAlias\":{\"Payment Number\":\"PAYMENTNUMBER\",\"Payment Date\":\"PAYMENTDATE\",\"PPR Payment Method\":\"PPRPAYMENTMETHOD\",\"Default Payment Method\":\"DEFAULTPAYMENTMETHOD\",\"Payment Amount\":\"PAYMENTAMOUNT\",\"Currency Code\":\"CURRENCYCODE\",\"Supplier Site Name\":\"SUPPLIERSITENAME\"},\"extractionQuery\":{\"viewQueries\":{\"pprPayments\":{\"module\":\"oraErpCorePaymentsFundsDisbursement\",\"businessObject\":\"PayablesDisbursementPayment\",\"view\":\"disbursementPayments\",\"fieldAliases\":{\"payablesPayment.paymentNumber\":\"paymentNumber\",\"paymentDate\":\"paymentDate\",\"paymentAmount\":\"paymentAmount\",\"paymentCurrencyCode\":\"currencyCode\",\"payablesPayment.paymentStatus.meaning\":\"paymentStatus\",\"payablesPayment.paymentId\":\"paymentId\",\"supplierSite.id\":\"supplierSite\",\"supplierSite.name\":\"supplierSiteName\",\"paymentMethod.code\":\"pprPaymentMethodCode\",\"paymentMethod.paymentMethodName\":\"pprPaymentMethod\",\"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\":\"pprName\"}},\"supplierDefaults\":{\"module\":\"oraErpCorePaymentInstruments\",\"businessObject\":\"ExternalPartyDisbursementPaymentMethodAssignment\",\"view\":\"ExternalPartyDisbursementPaymentMethodAssignments\",\"fieldAliases\":{\"externalPayablesDisbursementPayee.supplierSite.id\":\"supplierSite\",\"paymentMethod.code\":\"defaultPaymentMethodCode\",\"paymentMethod.paymentMethodName\":\"defaultPaymentMethod\",\"primaryFlag\":\"primaryFlag\"}}},\"select\":\"select p.paymentNumber, p.paymentDate, p.pprPaymentMethod, s.defaultPaymentMethod, p.paymentAmount, p.currencyCode, p.supplierSiteName, p.paymentId from pprPayments p left join supplierDefaults s on p.supplierSite = s.supplierSite where p.pprPaymentMethodCode!=s.defaultPaymentMethodCode {filter} order by p.paymentDate desc, p.paymentNumber desc\"},\"instructions\":[\"Return fields and fieldAlias exactly as provided.\",\"Keep extractionQuery.viewQueries and the base select unchanged except for {filter} substitution.\",\"When the user supplies supported additional constraints, return them in the top-level filter string using the supported extraction aliases.\",\"When no supported additional constraints exist, return filter as an empty string and replace {filter} with an empty string.\",\"Do not change the selected fields, joins, aliases, or viewQueries.\",\"Never pass {filter} through to the BO function.\",\"When the user mentions a payment process request or PPR, and NER Resolved Entities contains resolvedEntities.ppr[*].pprName, use that pprName as a supported filter.\",\"For this extraction, filter PPR name using SQL alias p.pprName.\",\"Do not use pprId because this extraction shape exposes pprName, not a PPR id alias.\",\"For PPR filters, set filter to: AND p.pprName = '<PPR_NAME>' and replace {filter} with the same fragment in extractionQuery.select.\"],\"filterConstruction\":{\"placeholder\":\"{filter}\",\"emptyReplacement\":\"\",\"outputContract\":\"For extraction shapes, return any additional filter as the top-level filter string. The runtime normalizer injects that filter into extractionQuery.select before the BO call.\",\"supportedAliases\":[\"p.paymentNumber\",\"p.paymentDate\",\"p.pprPaymentMethod\",\"p.pprPaymentMethodCode\",\"p.paymentAmount\",\"p.currencyCode\",\"p.paymentStatus\",\"p.paymentId\",\"p.supplierSite\",\"p.supplierSiteName\",\"p.pprName\",\"s.defaultPaymentMethod\",\"s.defaultPaymentMethodCode\",\"s.primaryFlag\"],\"rules\":[\"Construct the top-level filter only when the user asks for additional constraints beyond the payment-method mismatch condition already in the SQL.\",\"Use only the aliases listed in supportedAliases when building extraction SQL filters.\",\"A non-empty filter should be a SQL fragment suitable to append after an existing WHERE condition; prefer a leading AND, for example: and p.currencyCode = 'USD'.\",\"If no supported additional filter exists, set filter to an empty string.\",\"Do not URL-encode values in extraction SQL. Escape single quotes inside SQL string literals by doubling them.\",\"Inspect NER Resolved Entities as arbitrary JSON context. Do not assume a fixed resolvedEntities schema; use values only when their meaning is clear from keys, labels, or the user input.\",\"Do not use an id value unless this extraction shape exposes a matching id alias in supportedAliases.\"]}}"
            },
            {
              "id": "1774333570539",
              "name": "paymentRunInstallmentsShapeDef",
              "value": "{  \"name\": \"paymentRunInstallments\",  \"description\": \"This is the shape to be used for retrieving transmission configuration details for a payment file \",  \"fields\": [    \"payablesDisbursementPayment.payablesPayment.paymentNumber\",    \"payablesDisbursementPayment.paymentDate\",    \"paymentMethod.paymentMethodName\",    \"payablesDisbursementPayment.paymentAmount\",    \"paymentCurrencyCode\",    \"payeeParty.name\",    \"supplierSite.name\",    \"bankAccount.name\",    \"payablesDisbursementPayment.payablesPayment.paymentStatus.meaning\",    \"payablesDisbursementPayment.payablesPayment.paymentId\"  ],  \"filters\": [    {      \"attribute\": \"payablesDisbursementPayment.paymentAmount\",      \"type\": \"number\",      \"operators\": [        \">\",        \">=\",        \"<\",        \"<=\",        \"=\"      ]    },    {      \"attribute\": \"bankAccount.name\",      \"type\": \"string\",      \"operators\": [        \"=\",        \"IN\"      ]    },    {      \"attribute\": \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\",      \"type\": \"string\",      \"operators\": [        \"=\",        \"IN\",        \"CONTAINS\"      ]    },    {      \"attribute\": \"payablesDisbursementPayment.bepErrorCode\",      \"type\": \"string\",      \"operators\": [        \"=\",        \"IN\",        \"CONTAINS\"      ]    },    {      \"attribute\": \"payablesDisbursementPayment .payablesPaymentFile.transmissionDate\",      \"type\": \"date\",      \"operators\": [        \"=\",        \">=\",        \"<=\"      ]    },    {      \"attribute\": \"payablesDisbursementPayment.paymentStatus.lookupCode\",      \"type\": \"string\",      \"operators\": [        \"=\"      ],      \"possibleValues\": [        {          \"lookupCode\": \"ACKNOWLEDGED\",          \"meaning\": \"Acknowledged\",          \"functionalFilter\": []        },        {          \"lookupCode\": \"BANK_VALIDATED\",          \"meaning\": \"Validated by payment system\",          \"functionalFilter\": []        },        {          \"lookupCode\": \"CREATED\",          \"meaning\": \"Pending file creation\",          \"functionalFilter\": [            \"InProgress\"          ]        },        {          \"lookupCode\": \"FAILED_BY_CALLING_APP\",          \"meaning\": \"Rejected by source product update\",          \"functionalFilter\": [            \"Rejected\"          ]        },        {          \"lookupCode\": \"FAILED_BY_REJECTION_LEVEL\",          \"meaning\": \"Rejected by processing option\",          \"functionalFilter\": [            \"Rejected\"          ]        },        {          \"lookupCode\": \"FAILED_VALIDATION\",          \"meaning\": \"Failed validation\",          \"functionalFilter\": [            \"Failed\"          ]        },        {          \"lookupCode\": \"FORMATTED\",          \"meaning\": \"Formatted\",          \"functionalFilter\": [            \"InProgress (conditional)\"          ]        },        {          \"lookupCode\": \"INSTRUCTION_CREATED\",          \"meaning\": \"Payment file created\",          \"functionalFilter\": [            \"InProgress\"          ]        },        {          \"lookupCode\": \"INSTRUCTION_FAILED_VALIDATION\",          \"meaning\": \"Payment file failed validation\",          \"functionalFilter\": []        },        {          \"lookupCode\": \"ISSUED\",          \"meaning\": \"Printed\",          \"functionalFilter\": []        },        {          \"lookupCode\": \"MODIFIED\",          \"meaning\": \"Modified by removing documents\",          \"functionalFilter\": [            \"InProgress\"          ]        },        {          \"lookupCode\": \"MODIFIED_PAYEE_BANK_ACCOUNT\",          \"meaning\": \"Modified by updating payee bank account\",          \"functionalFilter\": [            \"InProgress\"          ]        },        {          \"lookupCode\": \"PAID\",          \"meaning\": \"Paid\",          \"functionalFilter\": []        },        {          \"lookupCode\": \"PENDING_ACK\",          \"meaning\": \"Completed and pending acknowledgment\",          \"functionalFilter\": []        },        {          \"lookupCode\": \"PERFORM_AUTO_RETRY\",          \"meaning\": \"Auto Retry Payments\",          \"functionalFilter\": [            \"InProgress\"          ]        },        {          \"lookupCode\": \"READY_TO_REPRINT\",          \"meaning\": \"Ready for reprint\",          \"functionalFilter\": [            \"InProgress\"          ]        },        {          \"lookupCode\": \"REJECTED\",          \"meaning\": \"Rejected\",          \"functionalFilter\": [            \"Rejected\",            \"Failed\"          ]        },        {          \"lookupCode\": \"REMOVED\",          \"meaning\": \"Removed\",          \"functionalFilter\": [            \"Rejected\"          ]        },        {          \"lookupCode\": \"REMOVED_DOCUMENT_SPOILED\",          \"meaning\": \"Removed due to spoiled payment document\",          \"functionalFilter\": [            \"Rejected\"          ]        },        {          \"lookupCode\": \"REMOVED_INSTRUCTION_TERMINATED\",          \"meaning\": \"Removed due to terminated payment file\",          \"functionalFilter\": [            \"Rejected\"          ]        },        {          \"lookupCode\": \"REMOVED_PAYMENT_STOPPED\",          \"meaning\": \"Removed due to stopped payment\",          \"functionalFilter\": []        },        {          \"lookupCode\": \"REMOVED_REQUEST_TERMINATED\",          \"meaning\": \"Removed due to terminated payment process request\",          \"functionalFilter\": [            \"Rejected\"          ]        },        {          \"lookupCode\": \"REQUEST_IN_TRANSIT\",          \"meaning\": \"Payments In Transit\",          \"functionalFilter\": [            \"InProgress\"          ]        },        {          \"lookupCode\": \"SUBMITTED_FOR_PRINTING\",          \"meaning\": \"Submitted for printing\",          \"functionalFilter\": [            \"InProgress\"          ]        },        {          \"lookupCode\": \"TRANSMITTED\",          \"meaning\": \"Transmitted\",          \"functionalFilter\": [            \"InProgress (conditional)\"          ]        },        {          \"lookupCode\": \"TRANSMITTED_PENDING_ACK\",          \"meaning\": \"Transmitted and pending acknowledgment\",          \"functionalFilter\": [            \"InProgress\"          ]        },        {          \"lookupCode\": \"VOID\",          \"meaning\": \"Void\",          \"functionalFilter\": []        },        {          \"lookupCode\": \"VOID_BY_OVERFLOW\",          \"meaning\": \"Void by overflow\",          \"functionalFilter\": []        },        {          \"lookupCode\": \"VOID_BY_OVERFLOW_REPRINT\",          \"meaning\": \"Void by overflow during reprint\",          \"functionalFilter\": []        },        {          \"lookupCode\": \"VOID_BY_SETUP\",          \"meaning\": \"Void by setup\",          \"functionalFilter\": []        },        {          \"lookupCode\": \"VOID_BY_SETUP_REPRINT\",          \"meaning\": \"Void by setup during reprint\",          \"functionalFilter\": []        }      ]    }  ],  \"fieldAlias\": {    \"Payment Number\": \"payablesDisbursementPayment.payablesPayment.paymentNumber\",    \"Payment Date\": \"payablesDisbursementPayment.paymentDate\",    \"Payment Method\": \"paymentMethod.paymentMethodName\",    \"Payment Amount\": \"payablesDisbursementPayment.paymentAmount\",    \"Currency\": \"paymentCurrencyCode\",    \"Supplier\": \"payeeParty.name\",    \"Supplier Site\": \"supplierSite.name\",    \"Disbursement Bank Account\": \"bankAccount.name\",    \"Payment Status\": \"payablesDisbursementPayment.payablesPayment.paymentStatus.meaning\"  },  \"drivers\": [    {      \"topic\": \"Show me rejected payments with error codes, suppliers, and invoice details\",      \"description\": \"Retrieve payments that are voided/rejected and contain error details. Strictly use the provided filter without modification to ensure only payments with non-null error codes and VOID status are returned.\",      \"fields\": \"payablesDisbursementPayment.paymentReferenceNumber,payablesDisbursementPayment.paymentDate,paymentMethod.paymentMethodName,payablesDisbursementPayment.paymentAmount,paymentCurrencyCode,payablesDisbursementPayment.payablesPayment.supplierName,supplierSite.name,bankAccount.name,payablesDisbursementPayment.paymentStatus.meaning,payablesInvoiceInstallment.invoiceTransaction.invoiceNumber,payablesInvoiceInstallment.invoiceTransaction.invoiceDate,payablesInvoiceInstallment.installmentNumber,payablesDisbursementPayment.paymentId,payablesDisbursementPayment.bepErrorCode,payablesDisbursementPayment.bepErrorMessageText,payablesDisbursementPayment.payablesPaymentFile.paymentInstructionId\",      \"filter\": \"payablesDisbursementPayment.bepErrorCode!=null and payablesDisbursementPayment.paymentStatus.lookupCode='VOID'\",      \"fieldAlias\": {        \"Payment Reference Number\": \"payablesDisbursementPayment.paymentReferenceNumber\",        \"Payment Date\": \"payablesDisbursementPayment.paymentDate\",        \"Payment Method\": \"paymentMethod.paymentMethodName\",        \"Payment Amount\": \"payablesDisbursementPayment.paymentAmount\",        \"Currency\": \"paymentCurrencyCode\",        \"Supplier\": \"payablesDisbursementPayment.payablesPayment.supplierName\",        \"Supplier Site\": \"supplierSite.name\",        \"Disbursement Bank Account\": \"bankAccount.name\",        \"Payment Status\": \"payablesDisbursementPayment.paymentStatus.meaning\",        \"Invoice Number\": \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\",        \"Invoice Date\": \"payablesInvoiceInstallment.invoiceTransaction.invoiceDate\",        \"Installment Number\": \"payablesInvoiceInstallment.installmentNumber\",        \"Payment Id\": \"payablesDisbursementPayment.paymentId\",        \"Error Code\": \"payablesDisbursementPayment.bepErrorCode\",        \"Error Message\": \"payablesDisbursementPayment.bepErrorMessageText\",        \"Payment Status\": \"payablesDisbursementPayment.paymentStatus.meaning\",        \"Payment File Id\": \"payablesDisbursementPayment.payablesPaymentFile.paymentInstructionId\",      }    }  ],  \"sortBy\": \"payablesDisbursementPayment.paymentDate:desc,payablesDisbursementPayment.payablesPayment.paymentNumber:desc\"}"
            },
            {
              "id": "1772686880395",
              "name": "payablesDisbursementPaymentShapeDef",
              "value": "{\"name\":\"payablesDisbursementPayment\",\"description\":\"This is the shape to be used for retrieving transmission configuration details for a payment file \",\"fields\":[\"payablesPayment.paymentNumber\",\"paymentDate\",\"paymentMethod.paymentMethodName\",\"paymentAmount\",\"paymentCurrencyCode\",\"payeeName\",\"supplierSite.name\",\"disbursementBankAccount.name\",\"payablesPayment.paymentStatus.meaning\",\"paymentInstrument.paymentInstrumentAlias\",\"paymentInstrument.instrumentType\",\"digitalPaymentAccount.virtualCardProgram.vcardProgramName\",\"paymentMode.lookupCode\",\"paymentMode.meaning\"],\"filters\":[{\"attribute\":\"supplierSite.name\",\"type\":\"string\",\"operators\":[\"=\"]},{\"attribute\":\"paymentInstrument.paymentInstrumentAlias\",\"type\":\"string\",\"operators\":[\"=\",\"IN\"]},{\"attribute\":\"paymentInstrument.instrumentType\",\"type\":\"string\",\"operators\":[\"=\",\"IN\"],\"possibleValues\":[{\"lookupCode\":\"ORA_CE_FUND_CARD_GROUP_ACCOUNT\",\"meaning\":\"JPM\"},{\"lookupCode\":\"ORA_CE_FUNDING_CARD_ACCOUNT\",\"meaning\":\"Mastercard\"}]},{\"attribute\":\"digitalPaymentAccount.virtualCardProgram.vcardProgramName\",\"type\":\"string\",\"operators\":[\"=\",\"IN\"]},{\"attribute\":\"paymentsPayablesPaymentProcessRequest. paymentProcessRequestName\",\"type\":\"string\",\"operators\":[\"=\"]},{\"attribute\":\"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",\"type\":\"string\",\"operators\":[\"=\"],\"possibleValues\":[]},{\"attribute\":\"paymentMode.lookupCode\",\"type\":\"string\",\"operators\":[\"=\"],\"possibleValues\":[{\"lookupCode\":\"VIRTUAL_CARD\",\"meaning\":\"Virtual Card\"}]},{\"attribute\":\"timeCreated\",\"type\":\"date-time\",\"operators\":[\"=\",\">=\",\"<=\"]},{\"attribute\":\"stopRequestDate\",\"type\":\"date\",\"operators\":[\"=\",\">=\",\"<=\"]},{\"attribute\":\"payablesPayment.paymentNumber\",\"type\":\"string\",\"operators\":[\"=\",\"IN\"]},{\"attribute\":\"payeeName\",\"type\":\"string\",\"operators\":[\"=\",\"IN\"]},{\"attribute\":\"paymentCurrencyCode\",\"type\":\"string\",\"operators\":[\"=\",\"IN\"]},{\"attribute\":\"paymentAmount\",\"type\":\"number\",\"operators\":[\">\",\">=\",\"<\",\"<=\",\"=\"]},{\"attribute\":\"paymentDate\",\"type\":\"date\",\"operators\":[\"=\",\">=\",\"<=\"]},{\"attribute\":\"disbursementBankAccount.name\",\"type\":\"string\",\"operators\":[\"=\",\"IN\"]},{\"attribute\":\"paymentMethod.paymentMethodName\",\"type\":\"string\",\"operators\":[\"=\"]},{\"attribute\":\"paymentStatus.lookupCode\",\"type\":\"string\",\"operators\":[\"=\"],\"possibleValues\":[{\"lookupCode\":\"ACKNOWLEDGED\",\"meaning\":\"Acknowledged\",\"functionalFilter\":[]},{\"lookupCode\":\"BANK_VALIDATED\",\"meaning\":\"Validated by payment system\",\"functionalFilter\":[]},{\"lookupCode\":\"CREATED\",\"meaning\":\"Pending file creation\",\"functionalFilter\":[\"InProgress\"]},{\"lookupCode\":\"FAILED_BY_CALLING_APP\",\"meaning\":\"Rejected by source product update\",\"functionalFilter\":[\"Rejected\"]},{\"lookupCode\":\"FAILED_BY_REJECTION_LEVEL\",\"meaning\":\"Rejected by processing option\",\"functionalFilter\":[\"Rejected\"]},{\"lookupCode\":\"FAILED_VALIDATION\",\"meaning\":\"Failed validation\",\"functionalFilter\":[\"Failed\"]},{\"lookupCode\":\"FORMATTED\",\"meaning\":\"Formatted\",\"functionalFilter\":[\"InProgress (conditional)\"]},{\"lookupCode\":\"INSTRUCTION_CREATED\",\"meaning\":\"Payment file created\",\"functionalFilter\":[\"InProgress\"]},{\"lookupCode\":\"INSTRUCTION_FAILED_VALIDATION\",\"meaning\":\"Payment file failed validation\",\"functionalFilter\":[]},{\"lookupCode\":\"ISSUED\",\"meaning\":\"Printed\",\"functionalFilter\":[]},{\"lookupCode\":\"MODIFIED\",\"meaning\":\"Modified by removing documents\",\"functionalFilter\":[\"InProgress\"]},{\"lookupCode\":\"MODIFIED_PAYEE_BANK_ACCOUNT\",\"meaning\":\"Modified by updating payee bank account\",\"functionalFilter\":[\"InProgress\"]},{\"lookupCode\":\"PAID\",\"meaning\":\"Paid\",\"functionalFilter\":[]},{\"lookupCode\":\"PENDING_ACK\",\"meaning\":\"Completed and pending acknowledgment\",\"functionalFilter\":[]},{\"lookupCode\":\"PERFORM_AUTO_RETRY\",\"meaning\":\"Auto Retry Payments\",\"functionalFilter\":[\"InProgress\"]},{\"lookupCode\":\"READY_TO_REPRINT\",\"meaning\":\"Ready for reprint\",\"functionalFilter\":[\"InProgress\"]},{\"lookupCode\":\"REJECTED\",\"meaning\":\"Rejected\",\"functionalFilter\":[\"Rejected\",\"Failed\"]},{\"lookupCode\":\"REMOVED\",\"meaning\":\"Removed\",\"functionalFilter\":[\"Rejected\"]},{\"lookupCode\":\"REMOVED_DOCUMENT_SPOILED\",\"meaning\":\"Removed due to spoiled payment document\",\"functionalFilter\":[\"Rejected\"]},{\"lookupCode\":\"REMOVED_INSTRUCTION_TERMINATED\",\"meaning\":\"Removed due to terminated payment file\",\"functionalFilter\":[\"Rejected\"]},{\"lookupCode\":\"REMOVED_PAYMENT_STOPPED\",\"meaning\":\"Removed due to stopped payment\",\"functionalFilter\":[]},{\"lookupCode\":\"REMOVED_REQUEST_TERMINATED\",\"meaning\":\"Removed due to terminated payment process request\",\"functionalFilter\":[\"Rejected\"]},{\"lookupCode\":\"REQUEST_IN_TRANSIT\",\"meaning\":\"Payments In Transit\",\"functionalFilter\":[\"InProgress\"]},{\"lookupCode\":\"SUBMITTED_FOR_PRINTING\",\"meaning\":\"Submitted for printing\",\"functionalFilter\":[\"InProgress\"]},{\"lookupCode\":\"TRANSMITTED\",\"meaning\":\"Transmitted\",\"functionalFilter\":[\"InProgress (conditional)\"]},{\"lookupCode\":\"TRANSMITTED_PENDING_ACK\",\"meaning\":\"Transmitted and pending acknowledgment\",\"functionalFilter\":[\"InProgress\"]},{\"lookupCode\":\"VOID\",\"meaning\":\"Void\",\"functionalFilter\":[]},{\"lookupCode\":\"VOID_BY_OVERFLOW\",\"meaning\":\"Void by overflow\",\"functionalFilter\":[]},{\"lookupCode\":\"VOID_BY_OVERFLOW_REPRINT\",\"meaning\":\"Void by overflow during reprint\",\"functionalFilter\":[]},{\"lookupCode\":\"VOID_BY_SETUP\",\"meaning\":\"Void by setup\",\"functionalFilter\":[]},{\"lookupCode\":\"VOID_BY_SETUP_REPRINT\",\"meaning\":\"Void by setup during reprint\",\"functionalFilter\":[]}]},{\"attribute\":\"payablesPayment.paymentStatus.lookupCode\",\"possibleValues\":[{\"lookupCode\":\"CLEARED\",\"meaning\":\"Cleared\",\"functionalFilter\":[\"Completed\"]},{\"lookupCode\":\"CLEARED BUT UNACCOUNTED\",\"meaning\":\"Cleared but unaccounted\",\"functionalFilter\":[]},{\"lookupCode\":\"ISSUED\",\"meaning\":\"Issued\",\"functionalFilter\":[\"Completed\"]},{\"lookupCode\":\"NEGOTIABLE\",\"meaning\":\"Negotiable\",\"functionalFilter\":[\"Unreconciled\",\"Completed\"]},{\"lookupCode\":\"ORA_ESCHEATED\",\"meaning\":\"Escheated\",\"functionalFilter\":[\"Completed\"]},{\"lookupCode\":\"ORA_ESCHEATMENT_INITIATED\",\"meaning\":\"Escheatment Initiated\",\"functionalFilter\":[\"Completed\"]},{\"lookupCode\":\"ORA_ESCHEATMENT_INPROGRESS\",\"meaning\":\"Obsolete: Escheatment In Progress\",\"functionalFilter\":[]},{\"lookupCode\":\"ORA_ESCHEAT_INPROGRESS\",\"meaning\":\"Selected for Escheatment\",\"functionalFilter\":[\"Completed\"]},{\"lookupCode\":\"OVERFLOW\",\"meaning\":\"Overflow\",\"functionalFilter\":[]},{\"lookupCode\":\"RECONCILED\",\"meaning\":\"Reconciled\",\"functionalFilter\":[\"Completed\"]},{\"lookupCode\":\"RECONCILED UNACCOUNTED\",\"meaning\":\"Reconciled unaccounted\",\"functionalFilter\":[]},{\"lookupCode\":\"SET UP\",\"meaning\":\"Setup\",\"functionalFilter\":[]},{\"lookupCode\":\"SPOILED\",\"meaning\":\"Spoiled\",\"functionalFilter\":[]},{\"lookupCode\":\"STOP INITIATED\",\"meaning\":\"Stop initiated\",\"functionalFilter\":[\"Completed\"]},{\"lookupCode\":\"UNCONFIRMED SET UP\",\"meaning\":\"Unconfirmed setup\",\"functionalFilter\":[]},{\"lookupCode\":\"VOIDED\",\"meaning\":\"Voided\",\"functionalFilter\":[\"Voided\"]}],\"type\":\"string\",\"operators\":[\"=\",\"IN\",\"!=\"]},{\"attribute\":\"businessUnit.id\",\"type\":\"string\",\"operators\":[\"=\",\"IN\"]},{\"attribute\":\"legalEntity.legalEntityId\",\"type\":\"string\",\"operators\":[\"=\",\"IN\"]},{\"attribute\":\"payablesPaymentFile.paymentInstructionId\",\"type\":\"string\",\"operators\":[\"=\",\"IN\"]},{\"attribute\":\"payablesPayment.paymentType.lookupCode\",\"possibleValues\":[{\"lookupCode\":\"A\",\"meaning\":\"Payment Process Request\"},{\"lookupCode\":\"M\",\"meaning\":\"Manual\"},{\"lookupCode\":\"N\",\"meaning\":\"Netting\"},{\"lookupCode\":\"Q\",\"meaning\":\"Quick\"},{\"lookupCode\":\"R\",\"meaning\":\"Refund\"},{\"lookupCode\":\"CASH\",\"meaning\":\"Cash\"},{\"lookupCode\":\"CHECK\",\"meaning\":\"Check\"},{\"lookupCode\":\"CREDIT_CARD\",\"meaning\":\"Credit Card\"}],\"type\":\"string\",\"operators\":[\"=\",\"IN\"]},{\"attribute\":\"maturityDate\",\"type\":\"date\",\"operators\":[\"=\",\">=\",\"<=\"]},{\"attribute\":\"voidDate\",\"type\":\"date\",\"operators\":[\"=\",\">=\",\"<=\"]},{\"attribute\":\"bankStatusCode\",\"possibleValues\":[{\"code\":\"ACCC\",\"meaning\":\"Accepted Settlement Completed Creditor Account: Settlement on the creditor's account has been completed.\"},{\"code\":\"ACCP\",\"meaning\":\"Accepted Customer Profile: Preceding check of technical validation was successful. Customer profile check was also successful.\"},{\"code\":\"ACSC\",\"meaning\":\"Accepted Settlement Completed Debitor Account: Settlement completed. This can be used by a Market Infrastructure reporting to Infrastructure Participant or an Account Servicer to Account Owner to report that the transaction account entry has been completed. It is for transaction status reasons, not for financial information, and can only be used after bilateral agreement.\"},{\"code\":\"ACSP\",\"meaning\":\"Accepted Settlement InProcess: All preceding checks such as technical validation and customer profile were successful, and the payment instruction has been accepted for execution.\"},{\"code\":\"ACTC\",\"meaning\":\"Accepted Technical Validation: Authentication and syntactical and semantical validation are successful.\"},{\"code\":\"ACWC\",\"meaning\":\"Accepted With Change: Instruction is accepted, but a change will be made, such as a date or remittance not sent.\"},{\"code\":\"ACWP\",\"meaning\":\"Accepted Without Posting: Payment instruction included in the credit transfer is accepted without being posted to the creditor customer’s account.\"},{\"code\":\"PDNG\",\"meaning\":\"Received: Payment instruction included in the credit transfer is accepted without being posted to the creditor customer’s account.\"},{\"code\":\"RCVD\",\"meaning\":\"Received: Payment instruction has been received.\"},{\"code\":\"RJCT\",\"meaning\":\"Rejected: Payment instruction has been rejected.\"},{\"code\":\"UNKN\",\"meaning\":\"Unknown: Status received from the bank does not match any known code.\"},{\"code\":\"ACFC\",\"meaning\":\"Accepted Funds Checked: Preceding check of technical validation and customer profile was successful, and an automatic funds check was positive.\"},{\"code\":\"CANC\",\"meaning\":\"Cancelled: Payment initiation has been successfully cancelled after receiving a request for cancellation. This code is to be used in the context of APIs only.\"},{\"code\":\"PATC\",\"meaning\":\"Partially Accepted Technical Correct: Payment initiation needs multiple authentications, where some but not all have been performed. Syntactical and semantical validations are successful.\"},{\"code\":\"PRES\",\"meaning\":\"Presented: Request for Payment has been presented to the Debtor.\"},{\"code\":\"BLCK\",\"meaning\":\"Blocked: Payment transaction previously reported with status 'ACWP' is blocked, for example, funds will neither be posted to the Creditor's account nor be returned to the Debtor.\"}],\"type\":\"string\",\"operators\":[\"=\",\"IN\",\"!=\"]}],\"fieldAlias\":{\"Payment Number\":\"payablesPayment.paymentNumber\",\"Payment Date\":\"paymentDate\",\"Payment Method\":\"paymentMethod.paymentMethodName\",\"Payment Amount\":\"paymentAmount\",\"Currency\":\"paymentCurrencyCode\",\"Supplier\":\"payeeName\",\"Supplier Site\":\"supplierSite.name\",\"Disbursement Bank Account\":\"disbursementBankAccount.name\",\"Funding Card Account\":\"paymentInstrument.paymentInstrumentAlias\",\"Payment Mode\":\"paymentMode.meaning\",\"Virtual Card Program\":\"digitalPaymentAccount.virtualCardProgram.vcardProgramName\",\"Payment Status\":\"payablesPayment.paymentStatus.meaning\"},\"drivers\":[{\"topic\":\"FINAP-8717 virtual card payment filters\",\"description\":\"Use this driver for payment-level virtual-card payment inquiries by payment mode, funding card account, virtual-card program or financing program name, JPM card program type, or Mastercard card program type. Do not use payment method for payment mode. Do not use payment-system-name fields for JPM or Mastercard virtual-card program questions.\",\"fields\":\"paymentReferenceNumber,payablesPayment.paymentNumber,paymentDate,paymentMethod.paymentMethodName,paymentAmount,paymentCurrencyCode,payeeName,supplierSite.name,paymentMode.lookupCode,paymentMode.meaning,paymentInstrument.paymentInstrumentAlias,paymentInstrument.instrumentType,digitalPaymentAccount.virtualCardProgram.vcardProgramName,paymentStatus.meaning,payablesPayment.paymentStatus.meaning\",\"filter\":\"paymentMode[lookupCode='VIRTUAL_CARD']\",\"fieldAlias\":{\"Payment Number\":\"payablesPayment.paymentNumber\",\"Payment Reference\":\"paymentReferenceNumber\",\"Payment Date\":\"paymentDate\",\"Payment Method\":\"paymentMethod.paymentMethodName\",\"Payment Mode\":\"paymentMode.meaning\",\"Payment Amount\":\"paymentAmount\",\"Currency\":\"paymentCurrencyCode\",\"Supplier\":\"payeeName\",\"Supplier Site\":\"supplierSite.name\",\"Funding Card Account\":\"paymentInstrument.paymentInstrumentAlias\",\"Virtual Card Program\":\"digitalPaymentAccount.virtualCardProgram.vcardProgramName\",\"Payment Status\":\"paymentStatus.meaning\"},\"examples\":[{\"userInput\":\"Show payments which have payment mode as virtual card\",\"filter\":\"paymentMode[lookupCode='VIRTUAL_CARD']\"},{\"userInput\":\"Show payments for funding card account AutoIBY RCN12 USD Vision Ops\",\"filter\":\"paymentMode[lookupCode='VIRTUAL_CARD'] AND paymentInstrument.paymentInstrumentAlias='AutoIBY RCN12 USD Vision Ops'\"},{\"userInput\":\"Show payments using virtual card program JPPMVC\",\"filter\":\"paymentMode[lookupCode='VIRTUAL_CARD'] AND digitalPaymentAccount.virtualCardProgram.vcardProgramName='JPPMVC'\"},{\"userInput\":\"Show payments for financing program JPPMVC\",\"filter\":\"paymentMode[lookupCode='VIRTUAL_CARD'] AND digitalPaymentAccount.virtualCardProgram.vcardProgramName='JPPMVC'\"},{\"userInput\":\"How many payments were made using JPM virtual card program?\",\"filter\":\"paymentMode[lookupCode='VIRTUAL_CARD'] AND paymentInstrument.instrumentType='ORA_CE_FUND_CARD_GROUP_ACCOUNT'\"},{\"userInput\":\"Show Mastercard virtual card payments\",\"filter\":\"paymentMode[lookupCode='VIRTUAL_CARD'] AND paymentInstrument.instrumentType='ORA_CE_FUNDING_CARD_ACCOUNT'\"}]},{\"topic\":\"Show me all payments that were voided through JPM L2 acknowledgement files in last one week.\",\"fields\":\"paymentReferenceNumber,paymentDate,paymentMethod.paymentMethodName,paymentAmount,paymentCurrencyCode,payablesPayment.supplierName,disbursementBankAccount.name,payablesPaymentFile.paymentInstructionId,payablesPayment.paymentStatus.meaning,disbursementInboundFile.fileName,disbursementInboundFile.inboundFileProcessingStatus.meaning,disbursementInboundFile.paymentSystem.paymentSystemName\",\"filter\":\"timeCreated >= '<START_DATETIME>' AND timeCreated <= '<END_DATETIME>' AND disbursementInboundFile.paymentSystem.paymentSystemName LIKE '%25JPM%25' AND paymentStatus.lookupCode = 'VOID' AND disbursementInboundFile.id != null\",\"fieldAlias\":{\"Payment Reference Number\":\"paymentReferenceNumber\",\"Payment Date\":\"paymentDate\",\"Payment Method\":\"paymentMethod.paymentMethodName\",\"Payment Amount\":\"paymentAmount\",\"Currency\":\"paymentCurrencyCode\",\"Supplier\":\"payeeName\",\"Supplier Site\":\"supplierSite.name\",\"Disbursement Bank Account\":\"disbursementBankAccount.name\",\"Payment Instruction ID\":\"payablesPaymentFile.paymentInstructionId\",\"Payment Status\":\"payablesPayment.paymentStatus.meaning\",\"Inbound File Name\":\"disbursementInboundFile.fileName\",\"Inbound File Status\":\"disbursementInboundFile.inboundFileProcessingStatus.meaning\",\"Payment System\":\"disbursementInboundFile.paymentSystem.paymentSystemName\"}},{\"topic\":\"Show me the payments made using funding card account xxxx\",\"fields\":[\"payablesPayment.paymentNumber\",\"paymentDate\",\"paymentMethod.paymentMethodName\",\"paymentAmount\",\"paymentCurrencyCode\",\"payeeName\",\"supplierSite.name\",\"payablesPayment.paymentStatus.meaning\",\"paymentInstrument.paymentInstrumentAlias\"],\"filter\":\"paymentInstrument.paymentInstrumentAlias='xxxx'\",\"fieldAlias\":{\"Payment Number\":\"payablesPayment.paymentNumber\",\"Payment Date\":\"paymentDate\",\"Payment Method\":\"paymentMethod.paymentMethodName\",\"Payment Amount\":\"paymentAmount\",\"Currency\":\"paymentCurrencyCode\",\"Supplier\":\"payeeName\",\"Supplier Site\":\"supplierSite.name\",\"Funding Card Account\":\"paymentInstrument.paymentInstrumentAlias\",\"Payment Status\":\"payablesPayment.paymentStatus.meaning\"}},{\"topic\":\"Show virtual card payments for supplier x in the last 30 days where the payment system status is Accepted but payment status is not Cleared.\",\"fields\":\"payablesPayment.paymentNumber,paymentDate,paymentMethod.paymentMethodName,paymentAmount,paymentCurrencyCode,payeeName,payablesPayment.paymentStatus.meaning\",\"fieldAlias\":{\"Payment Number\":\"payablesPayment.paymentNumber\",\"Payment Date\":\"paymentDate\",\"Payment Method\":\"paymentMethod.paymentMethodName\",\"Payment Amount\":\"paymentAmount\",\"Currency\":\"paymentCurrencyCode\",\"Supplier\":\"payeeName\",\"Supplier Site\":\"supplierSite.name\",\"Funding Card Account\":\"paymentInstrument.paymentInstrumentAlias\",\"Payment Status\":\"payablesPayment.paymentStatus.meaning\"},\"filter\":\"paymentMode.lookupCode='VIRTUAL_CARD' AND payeeName='x' AND paymentDate>='2026-03-15' AND paymentDate<'2026-04-15' AND paymentStatus.lookupCode='ACKNOWLEDGED' AND payablesPayment.paymentStatus.lookupCode!='CLEARED'\"},{\"topic\":\"Show me why for payments in file XYZ, legal entity ID is null for some suppliers?\",\"fields\":\"paymentReferenceNumber,payablesPayment.supplierName,supplierSite.name\",\"fieldAlias\":{\"Payment Reference Number\":\"paymentReferenceNumber\",\"Supplier\":\"payablesPayment.supplierName\",\"Supplier Site\":\"supplierSite.name\"},\"filter\":\"legalEntity.legalEntityId !== null, payablesPaymentFile.paymentInstructionId='XYZ'\"},{\"topic\":\"Show payments that were rejected or voided as part of acknowledgement\",\"description\":\"Payments that were either rejected or voided and have an acknowledgement error (bepErrorCode present).\",\"statuses\":[\"REJECTED\",\"VOID\"],\"filter\":\"paymentStatus.lookupCode IN ('REJECTED','VOID') AND bepErrorCode != NULL\"},{\"topic\":\"What are all the payments that are stuck because of failure (paymentStatus.lookupCode)\",\"description\":\"Payment statuses that denote a failure/error condition.\",\"statuses\":[\"FAILED_VALIDATION\",\"REJECTED\"],\"filter\":\"paymentStatus.lookupCode IN ('FAILED_VALIDATION','REJECTED')\"},{\"topic\":\"What are all the payments that are rejected (paymentStatus.lookupCode)\",\"description\":\"Payment statuses that denote rejection or removal/termination by processing.\",\"statuses\":[\"FAILED_BY_CALLING_APP\",\"FAILED_BY_REJECTION_LEVEL\",\"REJECTED\",\"REMOVED\",\"REMOVED_DOCUMENT_SPOILED\",\"REMOVED_INSTRUCTION_TERMINATED\",\"REMOVED_REQUEST_TERMINATED\"],\"filter\":\"paymentStatus.lookupCode IN ('FAILED_BY_CALLING_APP','FAILED_BY_REJECTION_LEVEL','REJECTED','REMOVED','REMOVED_DOCUMENT_SPOILED','REMOVED_INSTRUCTION_TERMINATED','REMOVED_REQUEST_TERMINATED')\"},{\"topic\":\"What are all the payments that are in progress (paymentStatus.lookupCode)\",\"description\":\"Payment statuses that indicate the payment is still processing (including conditional cases based on flags).\",\"statuses\":[\"CREATED\",\"INSTRUCTION_CREATED\",\"MODIFIED\",\"MODIFIED_PAYEE_BANK_ACCOUNT\",\"PERFORM_AUTO_RETRY\",\"READY_TO_REPRINT\",\"REQUEST_IN_TRANSIT\",\"SUBMITTED_FOR_PRINTING\",\"TRANSMITTED_PENDING_ACK\",\"FORMATTED (when paymentCompleteFlag=false)\",\"TRANSMITTED (when paymentCompleteFlag=false and paymentInitiation!='IMMEDIATE')\"],\"filter\":\"paymentStatus.lookupCode IN ('CREATED','INSTRUCTION_CREATED','MODIFIED','MODIFIED_PAYEE_BANK_ACCOUNT','PERFORM_AUTO_RETRY','READY_TO_REPRINT','REQUEST_IN_TRANSIT','SUBMITTED_FOR_PRINTING','TRANSMITTED_PENDING_ACK') or (paymentStatus.lookupCode='FORMATTED' and paymentCompleteFlag=false) or (paymentStatus.lookupCode='TRANSMITTED' and paymentCompleteFlag=false and paymentsPayablesPaymentProcessRequest.paymentInitiation.lookupCode!='IMMEDIATE')\"},{\"topic\":\"What are all the checks that are unreconciled (payablesPayment.paymentStatus.lookupCode)\",\"description\":\"Check statuses that indicate the check is still negotiable/unreconciled.\",\"statuses\":[\"NEGOTIABLE\"],\"filter\":\"paymentStatus.lookupCode IN ('NEGOTIABLE')\"},{\"topic\":\"What are all the checks that are completed (payablesPayment.paymentStatus.lookupCode)\",\"description\":\"Check statuses that indicate the check lifecycle is completed/cleared/reconciled or progressed into escheat/stop initiated.\",\"statuses\":[\"ISSUED\",\"CLEARED\",\"RECONCILED\",\"NEGOTIABLE\",\"ORA_ESCHEATED\",\"ORA_ESCHEATMENT_INITIATED\",\"ORA_ESCHEAT_INPROGRESS\",\"STOP INITIATED\"],\"filter\":\"paymentStatus.lookupCode IN ('ISSUED','CLEARED','RECONCILED','NEGOTIABLE','ORA_ESCHEATED','ORA_ESCHEATMENT_INITIATED','ORA_ESCHEAT_INPROGRESS','STOP INITIATED')\"},{\"topic\":\"What are all the checks that are voided (payablesPayment.paymentStatus.lookupCode)\",\"description\":\"Check statuses that indicate the check was voided (including overflow/setup variants).\",\"statuses\":[\"VOIDED\"],\"filter\":\"paymentStatus.lookupCode IN ('VOIDED')\"},{\"topic\":\"What are all the payments that are stuck because of failure (paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode)\",\"description\":\"Statuses in the PPR lifecycle that denote a failure or error condition.\",\"statuses\":[\"PENDING_REVIEW_DOC_VAL_ERRORS\",\"PENDING_REVIEW_PMT_VAL_ERRORS\",\"VALIDATION_FAILED\",\"FAILED_PAYMENT_VALIDATION\",\"MISSING RATES\",\"MISSING_X_RATES\",\"ORA_APPROVAL_ERROR\",\"TERMINATED\"],\"filter\":\"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode IN ('PENDING_REVIEW_DOC_VAL_ERRORS','PENDING_REVIEW_PMT_VAL_ERRORS','VALIDATION_FAILED','FAILED_PAYMENT_VALIDATION','MISSING%20RATES','MISSING_X_RATES','ORA_APPROVAL_ERROR','TERMINATED')\"},{\"topic\":\"Show me unreconciled payments\",\"description\":\"Payables Disbursement Payments with filter as (payablesPayment.paymentStatus.lookupCode='NEGOTIABLE')\"},{\"topic\":\"how many payments with bank status ACCC (Accepted Settlement Completed Creditor Account)\",\"description\":\"count of Payables Disbursement Payments with filter as (bankStatusCode='ACCC')\"},{\"topic\":\"how many payments with bank status ACCP (Accepted Customer Profile)\",\"description\":\"count of Payables Disbursement Payments with filter as (bankStatusCode='ACCP')\"},{\"topic\":\"how many payments with bank status ACSC (Accepted Settlement Completed Debitor Account)\",\"description\":\"count of Payables Disbursement Payments with filter as (bankStatusCode='ACSC')\"},{\"topic\":\"how many payments with bank status ACSP (Accepted Settlement InProcess)\",\"description\":\"count of Payables Disbursement Payments with filter as (bankStatusCode='ACSP')\"},{\"topic\":\"how many payments with bank status ACTC (Accepted Technical Validation)\",\"description\":\"count of Payables Disbursement Payments with filter as (bankStatusCode='ACTC')\"},{\"topic\":\"how many payments with bank status ACWC (Accepted With Change)\",\"description\":\"count of Payables Disbursement Payments with filter as (bankStatusCode='ACWC')\"},{\"topic\":\"how many payments with bank status ACWP (Accepted Without Posting)\",\"description\":\"count of Payables Disbursement Payments with filter as (bankStatusCode='ACWP')\"},{\"topic\":\"how many payments with bank status PDNG (Pending/Received)\",\"description\":\"count of Payables Disbursement Payments with filter as (bankStatusCode='PDNG')\"},{\"topic\":\"how many payments with bank status RCVD (Received)\",\"description\":\"count of Payables Disbursement Payments with filter as (bankStatusCode='RCVD')\"},{\"topic\":\"how many payments with bank status RJCT (Rejected)\",\"description\":\"count of Payables Disbursement Payments with filter as (bankStatusCode='RJCT')\"},{\"topic\":\"how many payments with bank status UNKN (Unknown)\",\"description\":\"count of Payables Disbursement Payments with filter as (bankStatusCode='UNKN')\"},{\"topic\":\"how many payments with bank status ACFC (Accepted Funds Checked)\",\"description\":\"count of Payables Disbursement Payments with filter as (bankStatusCode='ACFC')\"},{\"topic\":\"how many payments with bank status CANC (Cancelled)\",\"description\":\"count of Payables Disbursement Payments with filter as (bankStatusCode='CANC')\"},{\"topic\":\"how many payments with bank status PATC (Partially Accepted Technical Correct)\",\"description\":\"count of Payables Disbursement Payments with filter as (bankStatusCode='PATC')\"},{\"topic\":\"how many payments with bank status PRES (Presented)\",\"description\":\"count of Payables Disbursement Payments with filter as (bankStatusCode='PRES')\"},{\"topic\":\"how many payments with bank status BLCK (Blocked)\",\"description\":\"count of Payables Disbursement Payments with filter as (bankStatusCode='BLCK')\"}],\"sortBy\":\"paymentDate:desc,payablesPayment.paymentNumber:desc\"}"
            },
            {
              "id": "1772686862255_lateSupplierInvoicePaymentsShapeDef",
              "name": "lateSupplierInvoicePaymentsShapeDef",
              "value": "{    \"key\": \"lateSupplierInvoicePayments\",    \"name\": \"lateSupplierInvoicePayments\",    \"type\": \"EXTRACTION\",    \"module\": \"oraErpCorePayablesPayments\",    \"businessObject\": \"PayablesInvoicePayment\",    \"description\": \"Use this runtime extraction when the user asks for late payments to a supplier or payee in a recent payment-date window and needs row-level payment, invoice, due-date, payment-term, and lost-discount detail.\",    \"exampleQuestions\": [        \"Show late payments to Supplier ABC in the last 30 days.\",        \"List late payments to Advanced Network Devices over the last 60 days with discount lost.\",        \"Show payments made after due date for Supplier Y and include payment terms.\"    ],    \"fields\": {        \"fields\": [            \"daysLate\",            \"payeePartyName\",            \"supplierSiteName\",            \"paymentNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"paymentStatusMeaning\",            \"invoiceNumber\",            \"invoiceAmount\",            \"dueDate\",            \"paymentTerm\",            \"discountLost\"        ],        \"fieldAlias\": {            \"Days Late\": \"daysLate\",            \"Payee/Party\": \"payeePartyName\",            \"Supplier Site\": \"supplierSiteName\",            \"Payment Number\": \"paymentNumber\",            \"Payment Date\": \"paymentDate\",            \"Payment Amount\": \"paymentAmount\",            \"Payment Currency\": \"paymentCurrencyCode\",            \"Payment Status\": \"paymentStatusMeaning\",            \"Invoice Number\": \"invoiceNumber\",            \"Invoice Amount\": \"invoiceAmount\",            \"Due Date\": \"dueDate\",            \"Payment Terms\": \"paymentTerm\",            \"Discount Lost\": \"discountLost\"        }    },    \"supportedFilters\": [        {            \"name\": \"paymentDate\",            \"attribute\": \"paymentDate\",            \"type\": \"date\",            \"possibleValues\": [],            \"usage\": \"Use when the user gives a payment-date window such as last 30 days; resolve relative dates to ISO date literals before execution.\",            \"valueFromUser\": \"Payment Date or date range\"        },        {            \"name\": \"payeePartyName\",            \"attribute\": \"payeePartyName\",            \"type\": \"string\",            \"possibleValues\": [],            \"usage\": \"Use when the user names a supplier, payee, or party for the late-payment review.\",            \"valueFromUser\": \"Supplier, payee, or party\"        },        {            \"name\": \"supplierSiteName\",            \"attribute\": \"supplierSiteName\",            \"type\": \"string\",            \"possibleValues\": [],            \"usage\": \"Use when the user narrows the late-payment review to a supplier site.\",            \"valueFromUser\": \"Supplier Site\"        },        {            \"name\": \"paymentCurrencyCode\",            \"attribute\": \"paymentCurrencyCode\",            \"type\": \"string\",            \"possibleValues\": [],            \"usage\": \"Use when the user filters late payments by payment currency.\",            \"valueFromUser\": \"Payment Currency\"        },        {            \"name\": \"paymentStatusMeaning\",            \"attribute\": \"paymentStatusMeaning\",            \"type\": \"string\",            \"possibleValues\": [                \"Negotiable\",                \"Cleared\"            ],            \"usage\": \"Use when the user filters late payments by payment status meaning; this late-payment inquiry defaults to Negotiable and Cleared.\",            \"valueFromUser\": \"Payment Status\"        },        {            \"name\": \"paymentStatusLookupCode\",            \"attribute\": \"paymentStatusLookupCode\",            \"type\": \"string\",            \"possibleValues\": [                \"NEGOTIABLE\",                \"CLEARED\"            ],            \"usage\": \"Use when filtering by stored payment status code; this late-payment inquiry defaults to NEGOTIABLE and CLEARED.\",            \"valueFromUser\": \"Payment Status Code\"        },        {            \"name\": \"paymentNumber\",            \"attribute\": \"paymentNumber\",            \"type\": \"string\",            \"possibleValues\": [],            \"usage\": \"Use when the user identifies a specific payment number.\",            \"valueFromUser\": \"Payment Number\"        },        {            \"name\": \"invoiceNumber\",            \"attribute\": \"invoiceNumber\",            \"type\": \"string\",            \"possibleValues\": [],            \"usage\": \"Use when the user identifies a specific invoice number.\",            \"valueFromUser\": \"Invoice Number\"        },        {            \"name\": \"dueDate\",            \"attribute\": \"dueDate\",            \"type\": \"date\",            \"possibleValues\": [],            \"usage\": \"Use when the user narrows late payments by installment due date.\",            \"valueFromUser\": \"Due Date\"        },        {            \"name\": \"paymentTerm\",            \"attribute\": \"paymentTerm\",            \"type\": \"string\",            \"possibleValues\": [],            \"usage\": \"Use when the user filters late payments by invoice payment terms.\",            \"valueFromUser\": \"Payment Terms\"        },        {            \"name\": \"payablesInvoiceType\",            \"attribute\": \"payablesInvoiceType\",            \"type\": \"enum\",            \"possibleValues\": [                \"STANDARD\"            ],            \"usage\": \"Keep this fixed to STANDARD for the default late supplier invoice-payment inquiry unless the user explicitly asks for another invoice type.\",            \"valueFromUser\": \"Payables Invoice Type\"        }    ],    \"dateFilterGuidance\": {        \"description\": \"For late-payment questions, apply the requested date window to `p.paymentDate` and keep the lateness predicate `p.paymentDate > p.dueDate`. Interpret requests such as current date minus 30 days through current date as the resolved start date through the response as-of date, then emit ISO date literals before execution.\",        \"patterns\": [            {                \"userRequest\": \"last N days, last 30 days, recent late payments\",                \"clause\": \"filter `p.paymentDate` between the resolved start and end dates, require `p.paymentDate > p.dueDate`, default payment status to NEGOTIABLE or CLEARED, and default invoice type to STANDARD\"            }        ]    },    \"extractionQuery\": {        \"viewQueries\": {        \"invoicePayments\": {            \"module\": \"oraErpCorePayablesPayments\",            \"businessObject\": \"PayablesInvoicePayment\",            \"view\": \"payablesInvoicePaymentDetail\",            \"fieldAliases\": {            \"payment.supplier.name\": \"payeePartyName\",            \"payment.supplierSite.name\": \"supplierSiteName\",            \"payment.paymentNumber\": \"paymentNumber\",            \"payment.paymentDate\": \"paymentDate\",            \"payment.paymentAmount\": \"paymentAmount\",            \"paymentCurrency.currencyCode\": \"paymentCurrencyCode\",            \"payment.paymentStatus.lookupCode\": \"paymentStatusLookupCode\",            \"payment.paymentStatus.meaning\": \"paymentStatusMeaning\",            \"invoiceInstallment.invoiceId\": \"invoiceId\",            \"invoiceInstallment.invoiceTransaction.invoiceNumber\": \"invoiceNumber\",            \"invoiceInstallment.installmentNumber\": \"installmentNumber\",            \"invoiceInstallment.invoiceTransaction.invoiceAmount\": \"invoiceAmount\",            \"invoiceInstallment.invoiceTransaction.paymentTerm.paymentTerm\": \"paymentTerm\",            \"invoiceInstallment.invoiceTransaction.invoiceTypeCode.lookupCode\": \"payablesInvoiceType\",            \"invoiceInstallment.dueDate\": \"dueDate\",            \"discountLost\": \"discountLost\",            \"reversalFlag\": \"reversalFlag\"            }        }        },    \"select\": \"select (p.paymentDate - p.dueDate) as \\\"Days Late\\\", p.payeePartyName as \\\"Payee/Party\\\", p.supplierSiteName as \\\"Supplier Site\\\", p.paymentNumber as \\\"Payment Number\\\", p.paymentDate as \\\"Payment Date\\\", p.paymentAmount as \\\"Payment Amount\\\", p.paymentCurrencyCode as \\\"Payment Currency\\\", p.paymentStatusMeaning as \\\"Payment Status\\\", p.invoiceNumber as \\\"Invoice Number\\\", p.invoiceAmount as \\\"Invoice Amount\\\", p.dueDate as \\\"Due Date\\\", p.paymentTerm as \\\"Payment Terms\\\", p.discountLost as \\\"Discount Lost\\\" from invoicePayments p where p.paymentDate > p.dueDate and (p.reversalFlag != 'Y' or p.reversalFlag is null) and upper(p.payeePartyName) = upper('<SUPPLIER_NAME_FROM_USER>') and p.paymentDate >= DATE'<START_DATE_YYYY-MM-DD>' and p.paymentDate <= DATE'<END_DATE_YYYY-MM-DD>' and p.paymentStatusLookupCode in ('NEGOTIABLE','CLEARED') and p.payablesInvoiceType = 'STANDARD'\"  },    \"businessDrivers\": [        {            \"name\": \"latePaymentsToSupplierInDateWindow\",            \"description\": \"Return row-level late payments to a named supplier or payee for a resolved payment-date window.\",            \"when\": \"User asks for late payments to a particular supplier in the last N days or a specific date range.\",            \"fieldsToReturn\": [                \"daysLate\",                \"payeePartyName\",                \"supplierSiteName\",                \"paymentNumber\",                \"paymentDate\",                \"paymentAmount\",                \"paymentCurrencyCode\",                \"paymentStatusMeaning\",                \"invoiceNumber\",                \"invoiceAmount\",                \"dueDate\",                \"paymentTerm\",                \"discountLost\"            ],            \"extraFilterExpressions\": [                \"p.paymentDate > p.dueDate\",                \"upper(p.payeePartyName) = upper('<SUPPLIER_NAME_FROM_USER>')\",                \"p.paymentDate >= '<START_DATE_YYYY-MM-DD>'\",                \"p.paymentDate <= '<END_DATE_YYYY-MM-DD>'\",                \"p.paymentStatusLookupCode in ('NEGOTIABLE','CLEARED')\",                \"p.payablesInvoiceType = 'STANDARD'\",                \"p.reversalFlag != 'Y' or p.reversalFlag is null\"            ],            \"notes\": \"Compute Days Late as payment date minus installment due date. Keep the paid-payment population on invoicePayments and pull payment terms and invoice type through invoiceInstallment.invoiceTransaction to avoid losing paid rows in a separate schedule join.\"        },        {            \"name\": \"latePaymentsWithDiscountLost\",            \"description\": \"Return late supplier payments with lost-discount evidence for invoice-payment rows.\",            \"when\": \"User asks for late payments and explicitly wants discount lost, missed early-payment discount, or payment-term context.\",            \"fieldsToReturn\": [                \"daysLate\",                \"payeePartyName\",                \"paymentNumber\",                \"paymentDate\",                \"paymentAmount\",                \"paymentCurrencyCode\",                \"invoiceNumber\",                \"dueDate\",                \"paymentTerm\",                \"discountLost\"            ],            \"extraFilterExpressions\": [                \"p.paymentDate > p.dueDate\",                \"p.paymentStatusLookupCode in ('NEGOTIABLE','CLEARED')\",                \"p.payablesInvoiceType = 'STANDARD'\",                \"p.discountLost is not null\",                \"upper(p.payeePartyName) = upper('<SUPPLIER_NAME_FROM_USER>')\"            ],            \"notes\": \"Discount Lost is sourced from the invoice-payment detail row; the extraction does not recompute it from payment terms.\"        }    ],    \"additionalInstructions\": [        \"Use this extraction instead of the generic payablesInvoicePaymentDetailExtraction when the user asks for late supplier payments and needs the full inquiry output including Days Late, Supplier Site, Payment Terms, and Discount Lost.\",        \"Treat Payee/Party as the payment supplier name from the invoice-payment detail source when a separate payee-party field is not exposed by that source.\",        \"Resolve last-N-days windows, including current-date-minus-N through current-date phrasing, to concrete ISO date literals before execution; do not leave relative words or SQL date functions in the final query.\",        \"Default the late-payment inquiry to paymentStatusLookupCode in ('NEGOTIABLE','CLEARED') and payablesInvoiceType = 'STANDARD' unless the user explicitly asks for a different status or invoice type.\",        \"Keep the paid-payment population on invoicePayments. Pull paymentTerm and payablesInvoiceType from invoiceInstallment.invoiceTransaction through the invoice-payment detail view instead of joining a separate schedule rowset.\",        \"Keep the extractionQuery exactly as provided.\",        \"Do not change the selected fields, joins, or aliases.\",        \"Do no insert url encoded characters in the final select query\"    ]}"
            },
            {
              "id": "1772686862255_paymentClearingReconciliationExceptionsShapeDef",
              "name": "paymentClearingReconciliationExceptionsShapeDef",
              "value": "{ \"key\": \"paymentClearingReconciliationExceptions\", \"name\": \"paymentClearingReconciliationExceptions\", \"type\": \"EXTRACTION\", \"module\": \"oraErpCorePayablesPayments\", \"businessObject\": \"PayablesPayment\", \"description\": \"Use this payment-level runtime extraction when the user asks for clearing or reconciliation exceptions where the payment record and bank-clearing evidence do not align. It returns detail rows for uncleared, amount mismatch, voided-and-cleared, and cleared-before-issue payments. The SQL skeleton must remain unchanged except for replacing the {filter} placeholder with a caller-generated SQL filter fragment or an empty string.\", \"exampleQuestions\": [ \"Show payment exceptions for Vision Operations and BOA-204 between 2026-07-01 and 2026-07-31 including uncleared, amount mismatch, voided-and-cleared, and cleared-before-issue payments.\", \"Which payments have clearing or reconciliation exceptions for this business unit and bank account?\", \"List uncleared and amount-mismatch payments for this bank account by payment date.\", \"Show voided payments that still have clearing evidence and payments cleared before issue date.\" ], \"fields\": { \"fields\": [ \"paymentNumber\", \"supplierName\", \"bankAccountName\", \"paymentAmount\", \"paymentDate\", \"clearedAmount\", \"clearedDate\", \"exception\", \"variance\" ], \"fieldAlias\": { \"Payment Number\": \"paymentNumber\", \"Supplier\": \"supplierName\", \"Bank Account\": \"bankAccountName\", \"Payment Amount\": \"paymentAmount\", \"Payment Date\": \"paymentDate\", \"Cleared Amount\": \"clearedAmount\", \"Cleared Date\": \"clearedDate\", \"Exception\": \"exception\", \"Variance\": \"variance\" } }, \"supportedFilters\": [ { \"name\": \"businessUnitName\", \"attribute\": \"businessUnitName\", \"type\": \"string\", \"possibleValues\": [], \"usage\": \"Required when the user provides a business unit. Add this to the top-level extraction filter as businessUnitName = '<Business Unit>'.\", \"valueFromUser\": \"Business Unit\" }, { \"name\": \"bankAccountName\", \"attribute\": \"bankAccountName\", \"type\": \"string\", \"possibleValues\": [], \"usage\": \"Required when the user provides the disbursement bank account. Add this to the top-level extraction filter as bankAccountName = '<Bank Account>'.\", \"valueFromUser\": \"Bank Account\" }, { \"name\": \"paymentDate\", \"attribute\": \"paymentDate\", \"type\": \"date\", \"possibleValues\": [], \"usage\": \"Required. Use the user-provided start and end dates as the payment-date window. Add this to the top-level extraction filter using paymentDate >= DATE '<START_DATE_YYYY-MM-DD>' and paymentDate < DATE '<END_DATE_PLUS_ONE_DAY_YYYY-MM-DD>'.\", \"valueFromUser\": \"Payment Date start and end\" }, { \"name\": \"exception\", \"attribute\": \"exception\", \"type\": \"enum\", \"possibleValues\": [ \"UNCLEARED\", \"AMOUNT_MISMATCH\", \"VOIDED_AND_CLEARED\", \"CLEARED_BEFORE_ISSUE\" ], \"usage\": \"Use only when the user requests a subset of clearing or reconciliation exception types. By default include all four supported types. For subset filtering, translate requested exception enum values to the matching predicates in filterConstruction.exceptionPredicateMap and append them to the top-level filter. Do not filter on the computed exception alias inside the base WHERE clause.\", \"valueFromUser\": \"Exception\" }, { \"name\": \"supplierName\", \"attribute\": \"supplierName\", \"type\": \"string\", \"possibleValues\": [], \"usage\": \"Use only when the user narrows the exception review to one supplier. Add this to the top-level extraction filter as supplierName = '<Supplier>'.\", \"valueFromUser\": \"Supplier\" } ], \"dateFilterGuidance\": { \"description\": \"Apply the user-provided start and end dates to `paymentDate`, not clearing date or void date. Resolve relative dates to ISO date literals before execution.\", \"patterns\": [ { \"userRequest\": \"between <Start Date> and <End Date>\", \"clause\": \"paymentDate >= DATE '<START_DATE_YYYY-MM-DD>' and paymentDate < DATE '<END_DATE_PLUS_ONE_DAY_YYYY-MM-DD>'\" } ] }, \"extractionQuery\": { \"viewQueries\": { \"payablesPaymentDetail\": { \"module\": \"oraErpCorePayablesPayments\", \"businessObject\": \"PayablesPayment\", \"view\": \"payablesPaymentDetail\", \"fieldAliases\": { \"paymentNumber\": \"paymentNumber\", \"supplier.name\": \"supplierName\", \"bankAccountBusinessUnitAssignment.bankAccount.name\": \"bankAccountName\", \"paymentAmount\": \"paymentAmount\", \"paymentDate\": \"paymentDate\", \"clearingAmount\": \"clearingAmount\", \"clearingDate\": \"clearingDate\", \"voidDate\": \"voidDate\", \"reconciledFlag\": \"reconciledFlag\", \"businessUnit.name\": \"businessUnitName\" } } }, \"select\": \"select paymentNumber, supplierName, bankAccountName, paymentAmount, paymentDate, clearingAmount as clearedAmount, clearingDate as clearedDate, case when voidDate is not null and clearingDate is not null then 'VOIDED_AND_CLEARED' when clearingDate is not null and paymentDate is not null and clearingDate < paymentDate then 'CLEARED_BEFORE_ISSUE' when clearingAmount is not null and abs(paymentAmount - clearingAmount) > 0.005 then 'AMOUNT_MISMATCH' when clearingDate is null or nvl(reconciledFlag, 'N') = 'N' then 'UNCLEARED' end as exception, paymentAmount - coalesce(clearingAmount, 0) as variance from payablesPaymentDetail where 1 = 1 {filter} and (clearingDate is null or nvl(reconciledFlag, 'N') = 'N' or (clearingAmount is not null and abs(paymentAmount - clearingAmount) > 0.005) or (voidDate is not null and clearingDate is not null) or (clearingDate is not null and paymentDate is not null and clearingDate < paymentDate)) order by paymentDate asc, paymentNumber asc\", \"return\": [ { \"name\": \"paymentNumber\", \"type\": \"int64\" }, { \"name\": \"supplierName\", \"type\": \"string\" }, { \"name\": \"bankAccountName\", \"type\": \"string\" }, { \"name\": \"paymentAmount\", \"type\": \"number\" }, { \"name\": \"paymentDate\", \"type\": \"date\" }, { \"name\": \"clearedAmount\", \"type\": \"number\" }, { \"name\": \"clearedDate\", \"type\": \"date\" }, { \"name\": \"exception\", \"type\": \"string\" }, { \"name\": \"variance\", \"type\": \"number\" } ] }, \"instructions\": [ \"Return fields and fieldAlias exactly as provided.\", \"Keep extractionQuery.viewQueries and the base select unchanged except for {filter} substitution.\", \"When the user supplies supported required or additional constraints, return them in the top-level filter string using the supported extraction aliases.\", \"When no supported constraints exist, return filter as an empty string and replace {filter} with an empty string.\", \"Business Unit, Bank Account, Start Date, and End Date are required for this shape. Ask for any missing required value before execution.\", \"Do not change the selected fields, joins, aliases, exception case expression, exception predicates, order by, or viewQueries.\", \"Never pass {filter} through to the BO function.\", \"Do not URL-encode values in extraction SQL.\" ], \"filterConstruction\": { \"placeholder\": \"{filter}\", \"emptyReplacement\": \"\", \"outputContract\": \"For this extraction shape, return all supported filters as a top-level filter string and return extractionQuery.select with {filter} replaced by that fragment before the BO call.\", \"requiredAliases\": [ \"businessUnitName\", \"bankAccountName\", \"paymentDate\" ], \"supportedAliases\": [ \"businessUnitName\", \"bankAccountName\", \"paymentDate\", \"supplierName\", \"paymentAmount\", \"clearingAmount\", \"clearingDate\", \"voidDate\", \"reconciledFlag\" ], \"rules\": [ \"Construct the top-level filter from supported user constraints, including the required business unit, bank account, and payment-date window.\", \"Use only the aliases listed in supportedAliases when building extraction SQL filters.\", \"A non-empty filter must be a SQL fragment suitable to append after an existing WHERE condition; use a leading AND, for example: and businessUnitName = 'Vision Operations'.\", \"For date windows, use an inclusive start and exclusive end: and paymentDate >= DATE '2026-07-01' and paymentDate < DATE '2026-08-01'.\", \"For requested exception subsets, translate each requested enum value to exceptionPredicateMap and append one grouped predicate, for example: and ((clearingDate is null or nvl(reconciledFlag, 'N') = 'N') or (clearingAmount is not null and abs(paymentAmount - clearingAmount) > 0.005)).\", \"Treat reconciledFlag as a Y/N character flag. Use nvl(reconciledFlag, 'N') = 'N' for unreconciled checks; do not compare it to boolean true or false.\", \"Do not append a filter such as and exception = 'UNCLEARED' inside the base select because exception is a computed output alias.\", \"If no supported filter exists, set filter to an empty string.\", \"Do not URL-encode values in extraction SQL. Escape single quotes inside SQL string literals by doubling them.\", \"Inspect NER Resolved Entities as arbitrary JSON context. Do not assume a fixed resolvedEntities schema; use values only when their meaning is clear from keys, labels, or the user input.\", \"Do not use an id value unless this extraction shape exposes a matching id alias in supportedAliases.\" ], \"exceptionPredicateMap\": { \"UNCLEARED\": \"clearingDate is null or nvl(reconciledFlag, 'N') = 'N'\", \"AMOUNT_MISMATCH\": \"clearingAmount is not null and abs(paymentAmount - clearingAmount) > 0.005\", \"VOIDED_AND_CLEARED\": \"voidDate is not null and clearingDate is not null\", \"CLEARED_BEFORE_ISSUE\": \"clearingDate is not null and paymentDate is not null and clearingDate < paymentDate\" } }, \"businessDrivers\": [ { \"name\": \"paymentClearingExceptionsByBusinessUnitAndBankAccount\", \"description\": \"Return payment-level clearing and reconciliation exceptions for a business unit, bank account, and payment-date window.\", \"when\": \"User asks to show payment exceptions including uncleared, amount mismatch, voided-and-cleared, and cleared-before-issue payments.\", \"fieldsToReturn\": [ \"paymentNumber\", \"supplierName\", \"bankAccountName\", \"paymentAmount\", \"paymentDate\", \"clearedAmount\", \"clearedDate\", \"exception\", \"variance\" ], \"extraFilterExpressions\": [ \"and businessUnitName = '<BUSINESS_UNIT_FROM_USER>'\", \"and bankAccountName = '<BANK_ACCOUNT_FROM_USER>'\", \"and paymentDate >= DATE '<START_DATE_YYYY-MM-DD>'\", \"and paymentDate < DATE '<END_DATE_PLUS_ONE_DAY_YYYY-MM-DD>'\", \"The base exception predicate is already present in extractionQuery.select. Do not duplicate it in the top-level filter unless the user requests a subset of exception types.\" ], \"notes\": \"Classify the Exception column from the same predicates. Use the priority order voided-and-cleared, cleared-before-issue, amount mismatch, then uncleared when a payment satisfies more than one condition.\" }, { \"name\": \"paymentClearingExceptionsForSelectedExceptionTypes\", \"description\": \"Return the same payment exception detail table but restricted to one or more requested exception categories.\", \"when\": \"User asks for only uncleared, amount mismatch, voided-and-cleared, or cleared-before-issue payments.\", \"fieldsToReturn\": [ \"paymentNumber\", \"supplierName\", \"bankAccountName\", \"paymentAmount\", \"paymentDate\", \"clearedAmount\", \"clearedDate\", \"exception\", \"variance\" ], \"extraFilterExpressions\": [ \"UNCLEARED: clearingDate is null or nvl(reconciledFlag, 'N') = 'N'\", \"AMOUNT_MISMATCH: clearingAmount is not null and abs(paymentAmount - clearingAmount) > 0.005\", \"VOIDED_AND_CLEARED: voidDate is not null and clearingDate is not null\", \"CLEARED_BEFORE_ISSUE: clearingDate is not null and paymentDate is not null and clearingDate < paymentDate\" ], \"notes\": \"Keep the requested output columns unchanged. Restrict the exception predicates only when the user explicitly asks for a subset.\" } ], \"additionalInstructions\": [ \"Use this shape instead of an AV because `Exception` and `Variance` are row-level computed values.\", \"Business Unit, Bank Account, Start Date, and End Date are required for this user query. Ask for any missing value before execution.\", \"Variance must be calculated as Payment Amount minus Cleared Amount. Use `paymentAmount - coalesce(clearingAmount, 0)` so uncleared payments show the unresolved payment amount as variance.\", \"Treat `reconciledFlag` as a Y/N character flag. Use `nvl(reconciledFlag, 'N') = 'N'` when checking unreconciled payments.\", \"For next-step guidance outside the table: uncleared payments should be checked against bank statements or acknowledgements; amount mismatches should be investigated against bank charges, FX, or partial clearing; voided-and-cleared payments need reversal/void accounting review; cleared-before-issue payments need date correction or bank evidence review.\", \"Do not apply a row limit before the exception predicates are evaluated.\", \"Copy viewQueries exactly. Copy select exactly except replacing the {filter} placeholder.\", \"Do not alter aliases, selected fields, joins, or exception predicates.\", \"Do not insert URL-encoded characters in the final select query.\", \"Never emit a final extractionQuery.select that still contains {filter}.\" ]}"
            }
          ],
          "type": "SET_FIELDS",
