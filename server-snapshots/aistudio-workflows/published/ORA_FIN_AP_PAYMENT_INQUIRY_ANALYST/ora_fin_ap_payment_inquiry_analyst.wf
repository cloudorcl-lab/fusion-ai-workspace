                    "name": "Normalize Extraction Query Filter Placeholder",
                    "returnType": "object",
                    "sourceCode": "let currentItem = $context.$nodes.FIN_AP_FOR_PAYMENT_INQUIRY_OBJECT_FETCH_LOOP.$currentItem || {};\nlet extractionQuery = currentItem.extractionQuery;\nlet normalized = {};\n\nif (typeof extractionQuery === \"string\") {\n    try {\n        extractionQuery = JSON.parse(extractionQuery);\n    } catch (e) {\n        extractionQuery = {};\n    }\n}\n\nif (extractionQuery && typeof extractionQuery === \"object\") {\n    normalized = JSON.parse(JSON.stringify(extractionQuery));\n}\n\nlet select = typeof normalized.select === \"string\" ? normalized.select : \"\";\nlet filter = typeof currentItem.filter === \"string\" ? currentItem.filter : \"\";\nfilter = filter.trim();\n\nif (filter === \"{filter}\") {\n    filter = \"\";\n}\nfilter = filter.split(\"{filter}\").join(\"\").trim();\n\nif (filter) {\n    if (/^where\b/i.test(filter)) {\n        filter = filter.replace(/^where\b/i, \"and\").trim();\n    } else if (!/^(and|or)\b/i.test(filter)) {\n        filter = \"and \" + filter;\n    }\n}\n\nif (select.indexOf(\"{filter}\") >= 0) {\n    select = select.split(\"{filter}\").join(filter);\n} else if (filter && select.toLowerCase().indexOf(filter.toLowerCase()) < 0) {\n    select = select + \" \" + filter;\n}\n\n// Last-resort guard: the extraction BO accepts only complete select statements.\nselect = select.split(\"{filter}\").join(\"\");\nnormalized.select = select.trim();\n\nreturn normalized;"
