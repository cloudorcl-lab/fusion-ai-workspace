                {
                  "metadata": {
                    "name": "Format Payment Method Vs Supplier Default 1",
                    "returnType": "array",
                    "sourceCode": "var response = $context.$nodes.FIN_AP_BO_FUNC_FETCH_LATE_SUPPLIER_INVOICE_PAYMENTS.$output;\n\nvar currentItem = $context.$nodes.FIN_AP_FOR_PAYMENT_INQUIRY_OBJECT_FETCH_LOOP.$currentItem || {};\nvar fields = currentItem.fields || [];\nvar fieldAlias = currentItem.fieldAlias || {};\nvar columns = currentItem.columns || [];\n\nfunction hasOwn(obj, key) {\n    return Object.prototype.hasOwnProperty.call(obj, key);\n}\n\nfunction trimValue(value) {\n    return String(value).replace(/^\\s+|\\s+$/g, \"\");\n}\n\nfunction formatValue(value) {\n    if (typeof value === \"string\" && value.length >= 20) {\n        if (value.indexOf(\"T00:00:00Z\") > -1) {\n            return value.substring(0, 10);\n        }\n    }\n    return value;\n}\n\n// Normalize response\nif (typeof response === \"string\") {\n    try {\n        response = JSON.parse(response);\n    } catch (e) {\n        response = [];\n    }\n}\n\nif (!Array.isArray(response)) {\n    response = response ? [response] : [];\n}\n\n// Normalize fieldAlias: expected shape is { \"Days Late\": \"daysLate\" }\nif (typeof fieldAlias === \"string\") {\n    try {\n        fieldAlias = JSON.parse(fieldAlias);\n    } catch (e1) {\n        try {\n            fieldAlias = JSON.parse(\"{\" + fieldAlias + \"}\");\n        } catch (e2) {\n            fieldAlias = {};\n        }\n    }\n}\n\nif (!fieldAlias || typeof fieldAlias !== \"object\" || Array.isArray(fieldAlias)) {\n    fieldAlias = {};\n}\n\n// Normalize columns\nif (typeof columns === \"string\") {\n    try {\n        columns = JSON.parse(columns);\n    } catch (e3) {\n        columns = [];\n    }\n}\n\nif (!Array.isArray(columns)) {\n    columns = [];\n}\n\n// Normalize fields\nvar normalizedFields = [];\n\nif (typeof fields === \"string\") {\n    var splitFields = fields.split(\",\");\n    for (var i = 0; i < splitFields.length; i++) {\n        var fieldName = trimValue(splitFields[i]);\n        if (fieldName) {\n            normalizedFields.push(fieldName);\n        }\n    }\n} else if (Array.isArray(fields)) {\n    for (var j = 0; j < fields.length; j++) {\n        var arrayFieldName = trimValue(fields[j]);\n        if (arrayFieldName) {\n            normalizedFields.push(arrayFieldName);\n        }\n    }\n}\n\nfields = normalizedFields;\n\n// If columns are supplied, derive fieldAlias and fields from columns\nif (columns.length > 0) {\n    var derivedAlias = {};\n    var derivedFields = [];\n\n    for (var k = 0; k < columns.length; k++) {\n        var col = columns[k] || {};\n        if (col.label && col.path) {\n            derivedAlias[col.label] = col.path;\n            derivedFields.push(col.path);\n        }\n    }\n\n    if (Object.keys(derivedAlias).length > 0) {\n        fieldAlias = derivedAlias;\n    }\n\n    if (fields.length === 0) {\n        fields = derivedFields;\n    }\n}\n\n// Build reverse alias map: internal field name -> display label\nvar reverseAlias = {};\n\nfor (var alias in fieldAlias) {\n    if (hasOwn(fieldAlias, alias)) {\n        reverseAlias[fieldAlias[alias]] = alias;\n    }\n}\n\n// Build column order\nvar columnOrder = [];\n\nif (fields.length > 0) {\n    for (var f = 0; f < fields.length; f++) {\n        var field = fields[f];\n\n        if (reverseAlias[field]) {\n            columnOrder.push(reverseAlias[field]);\n        } else if (fieldAlias[field]) {\n            columnOrder.push(field);\n        }\n    }\n}\n\n// Fallback to fieldAlias order\nif (columnOrder.length === 0) {\n    for (var aliasName in fieldAlias) {\n        if (hasOwn(fieldAlias, aliasName)) {\n            columnOrder.push(aliasName);\n        }\n    }\n}\n\n// Final fallback: use response keys in returned order\nif (columnOrder.length === 0 && response.length > 0) {\n    for (var responseKey in response[0]) {\n        if (hasOwn(response[0], responseKey)) {\n            columnOrder.push(responseKey);\n        }\n    }\n}\n\n// Normalize row keys to display aliases and format dates\nvar content = [];\n\nfor (var r = 0; r < response.length; r++) {\n    var row = response[r] || {};\n    var normalizedRow = {};\n\n    for (var c = 0; c < columnOrder.length; c++) {\n        var columnAlias = columnOrder[c];\n        var fieldPath = fieldAlias[columnAlias];\n\n        if (hasOwn(row, columnAlias)) {\n            normalizedRow[columnAlias] = formatValue(row[columnAlias]);\n        } else if (fieldPath && hasOwn(row, fieldPath)) {\n            normalizedRow[columnAlias] = formatValue(row[fieldPath]);\n        } else {\n            normalizedRow[columnAlias] = null;\n        }\n    }\n\n    content.push(normalizedRow);\n}\n\nvar output = {\n    type: \"table\",\n    heading: \"Payments\",\n    columnOrder: columnOrder,\n    content: content\n};\n\nreturn output;"
