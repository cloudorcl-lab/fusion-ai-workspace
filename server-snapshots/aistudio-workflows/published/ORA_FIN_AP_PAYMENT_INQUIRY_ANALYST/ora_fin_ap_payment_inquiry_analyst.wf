                {
                  "metadata": {
                    "name": "Format Payment Disbursement Inquiry Data",
                    "returnType": "object",
                    "sourceCode": "let paymentFiles = $context.$nodes.FIN_AP_BO_FUNC_FETCH_PAYMENT_DISBURSEMENT_PAYABLES_DETAILS.$output.items;\n\nlet fields = $context.$nodes.FIN_AP_FOR_PAYMENT_INQUIRY_OBJECT_FETCH_LOOP.$currentItem.fields;\n\nlet fieldAlias = $context.$nodes.FIN_AP_FOR_PAYMENT_INQUIRY_OBJECT_FETCH_LOOP.$currentItem.fieldAlias;\nlet columns = $context.$nodes.FIN_AP_FOR_PAYMENT_INQUIRY_OBJECT_FETCH_LOOP.$currentItem.columns;\n\n// Ensure fieldAlias is an object\nif (typeof fieldAlias === \"string\") {\n    fieldAlias = JSON.parse(\"{\" + fieldAlias + \"}\");\n}\n\n// Ensure columns is an array when supplied as a string\nif (typeof columns === \"string\") {\n    try {\n        columns = JSON.parse(columns);\n    } catch (e) {\n        columns = [];\n    }\n}\nif (!Array.isArray(columns)) {\n    columns = [];\n}\n\n// If columns are present, derive fields and fieldAlias from them\nif (columns.length) {\n    let derivedAlias = {};\n    let derivedFields = [];\n    for (let i = 0; i < columns.length; i++) {\n        let col = columns[i] || {};\n        if (col.label && col.path) {\n            derivedAlias[col.label] = col.path;\n            derivedFields.push(col.path);\n        }\n    }\n    if (Object.keys(derivedAlias).length) {\n        fieldAlias = derivedAlias;\n    }\n    if (!fields || !fields.trim()) {\n        fields = derivedFields.join(\",\");\n    }\n}\n\n// ?? Reverse map (fieldPath → alias)\nlet reverseAlias = {};\nfor (let alias in fieldAlias) {\n    reverseAlias[fieldAlias[alias]] = alias;\n}\n\n// ?? Filter only valid fields (present in fieldAlias) in correct order\nlet fieldsArr = fields.split(',');\nlet validFields = fieldsArr.filter(f => reverseAlias[f]);\n\n// ?? Column order = aliases in correct order\nlet columnOrder = validFields.map(f => reverseAlias[f]);\n\nlet processedFiles = [];\n\n// ?? Process data\nfor (let i = 0; i < paymentFiles.length; i++) {\n    let file = paymentFiles[i];\n    let newFile = {};\n\n    for (let j = 0; j < validFields.length; j++) {\n        let fieldPath = validFields[j];\n        let alias = reverseAlias[fieldPath];\n\n        let pathParts = fieldPath.split('.');\n        let value = file;\n\n        for (let k = 0; k < pathParts.length; k++) {\n            if (value && Object.prototype.hasOwnProperty.call(value, pathParts[k])) {\n                value = value[pathParts[k]];\n            } else {\n                value = \"\";\n                break;\n            }\n        }\n\n        // ?? Custom deeplink logic for Payment Number\n        if (alias === \"Payment Number\" || alias === \"Payment Reference Number\") {\n            let paymentNumber = file?.payablesPayment?.paymentNumber || file?.paymentReferenceNumber || \"\";\n            let paymentId = file?.payablesPayment?.paymentId || \"\";\n\n            newFile[alias] = paymentNumber\n                ? `{deeplink:{objType:AP_VIEWPAYMENT,action:VIEW,objKey:CheckId=${paymentId};ModeId=0,text:${paymentNumber}}}`\n                : \"\";\n        } else if (alias === \"Payment Instruction ID\") {\n            let paymentFileNumber = file?.payablesPaymentFile?.paymentInstructionId || \"\";\n\n            newFile[alias] = paymentFileNumber ? `{deeplink:{objType:AP_VIEWPAYMENTFILE,action:VIEW,objKey:paymentInstructionId=${paymentFileNumber},text:${paymentFileNumber}}}`: \"\";\n        }\n        else {\n            newFile[alias] = (value === null || value === undefined) ? \"\" : value;\n        }\n    }\n\n    processedFiles.push(newFile);\n}\n\n// ?? Final output\nlet output = {\n    type: \"table\",\n    heading: \"Payments\",\n    columnOrder: columnOrder,\n    content: processedFiles\n};\n\nreturn output;"
