        {
          "metadata": {
            "name": "GetEmailAttributeValues",
            "returnType": "object",
            "sourceCode": "const input = JSON.parse($context.$triggers.REST.$input.Payload);\n\nconst normalizeEmails = (value) =>\n  (typeof value === \"string\" && value.trim().length > 0)\n    ? value.split(\",\").map(e => e.trim()).filter(e => e.length > 0)\n    : [];\n\nconst toList = normalizeEmails(input.To);\nconst ccList = normalizeEmails(input.Cc);\n\nconst outboundMsgPartsArr = [\n  ...toList.map(email => ({\n    PartTypeCd: \"ORA_SVC_TO\",\n    PartName: \"To\",\n    PartValue: email\n  })),\n  ...ccList.map(email => ({\n    PartTypeCd: \"ORA_SVC_CC\",   // change if your REST expects same code\n    PartName: \"Cc\",\n    PartValue: email\n  }))\n];\n\nif (outboundMsgPartsArr.length === 0) {\n  throw new Error(\"No recipients found in To/Cc.\");\n}\n\nconst restPayload = {\n  ChannelId: input.ChannelId ?? null,\n  SourceObjId: input.SourceObjId ?? null,\n  SourceObjTypeCd: input.SourceObjTypeCd ?? \"InboundMessages\",\n  SourceObjTemplateName: input.SourceObjTemplateName ?? null,\n  SourceObjPkName: input.SourceObjPkName ?? null,\n  Subject: input.Subject ?? null,\n  Body: input.Body ?? null,\n  SourceCd: input.SourceCd ?? \"ORA_SVC_API\",\n  StripeCd: input.StripeCd ?? \"\",\n  ReplyToAddress: input.ReplyToAddress ?? null,\n  ChannelTypeCd: input.ChannelTypeCd ?? null,     \n  SourceMsgObjTypeCd: input.SourceMsgObjTypeCd ?? null,\n  OutboundMessageNumber: input.OutboundMessageNumber ?? null,\n  SenderName: input.SenderName ?? null,\n  SenderEmailSourceCd: input.SenderEmailSourceCd ?? null,\n\n  // Tool expects {partsArray} raw JSON, so pass STRINGIFIED array\n  OutboundMsgParts: JSON.stringify(outboundMsgPartsArr)\n};\n\nreturn restPayload;\n"
          },
          "outcomes": {
            "success": "1766594763806"
          },
          "code": "GETEMAILATTRIBUTEVALUES",
          "id": "1766566868994",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
