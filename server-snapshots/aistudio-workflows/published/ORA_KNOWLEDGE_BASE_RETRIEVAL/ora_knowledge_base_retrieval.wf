          "code": "FETCH_REFERENCED_BOS",
          "id": "1777583890545",
          "inputs": [
            {
              "id": "1779821586045_1",
              "name": "queries",
              "type": "string",
              "value": "{{$context.$nodes.CREATE_BO_QUERY.$output.result.boQueries}}"
            },
            {
              "id": "1779821586046_2",
              "name": "filters",
