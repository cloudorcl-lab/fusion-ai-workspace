        {
          "metadata": {
            "name": "blank if"
          },
          "outcomes": {
            "true": "1778010184204",
            "false": "add_false_1776899985318"
          },
          "code": "BLANK_IF",
          "convergenceTargetId": "end",
          "id": "1776899985318",
          "inputs": [
            {
              "id": "1776899985321_1",
              "name": "condition",
              "type": "string",
              "value": "{{true}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Create Suggestions",
            "returnType": "object",
            "sourceCode": "const processedNewNodes = $context.$variables.processedNewNodes;\nconst nodes = $context.$nodes.POST_PROCESS.$output.result.nodes;\n\n// Restrict boFunctions to BO that are used\nconst boFunctions = $context.$variables.boFunctions ;\n\nfor (const boFunction of Object.values(boFunctions)) {\n  delete boFunction.kbObject; \n}\n\nconst suggestions = [];\nconst processedNewNodesArr = Object.values(processedNewNodes);\n\nconst processNewNodesBoToNodes = {};\n\nfor (const node of nodes) {\n  node.existingNode = true;\n}\nfor (const node of [...processedNewNodesArr, ...nodes]) {\n  if (node.BusinessObjectCode && node.BusinessObjectCode.indexOf('ORA_SYSTEM') > -1) {\n    continue;\n  }\n  let suggestion;\n  const key = node.existingNode &&  node.businessObjectFunction ? node.businessObjectFunction.BusinessObjectCode + ':' + node.businessObjectFunction.FunctionName : node.BusinessObjectCode + ':' + node.FunctionName;\n  if (boFunctions[key]) {\n    boFunctions[key].usedByNode = true;\n  }\n  if (node.existingNode) {\n    delete node.existingNode;\n    if (!processedNewNodesArr.length) {\n      let processSuggestions  = false;\n      if (node.parametersMapping && node.parametersMapping.length) {\n        for (const param of node.parametersMapping) {\n          if (param && param.mainParameterSource && param.mainParameterSource.BusinessObjectCode === 'ORA_SYSTEM_CONSTANT' && param.mainParameterSource.AttributeValue) {\n            param.value = param.mainParameterSource.AttributeValue;\n            param.source = 'kb_static';\n          } else if (param && param.mainParameterSource && param.mainParameterSource.BusinessObjectCode === 'ORA_SYSTEM_USER') {\n            processSuggestions = true;\n            continue;\n          }\n        }\n      }\n      if (!processSuggestions) {\n        continue;\n      }\n    }\n    suggestion = `Set node ${node.code} to businessObject ${node.businessObjectFunction.BusinessObjectCode} function ${node.businessObjectFunction.FunctionName}.`;\n  } else {\n    const matchKey = node.BusinessObjectCode + ':' + node.FunctionName;\n    if (!processNewNodesBoToNodes[matchKey]) {\n      processNewNodesBoToNodes[matchKey] = [];\n    }\n    processNewNodesBoToNodes[matchKey].push(node);\n    suggestion = `Add a Business Object Function node with BusinessObjectCode ${node.BusinessObjectCode} and functionName ${node.FunctionName} with node code \"${node.code}\". `;\n    if (node.businessObjectFunction && node.businessObjectFunction.IsCollectionResource) {\n      suggestion += `This node is a collection and returns an \"items\" array. If need only the first item, use \"restResults.items[0]\". `;\n      if (node.businessObjectFunction.OutputTypeUsage == 'OBJECT' ) {\n        suggestion += \"It's typical to only ever use the first item of this BOF. \"\n      }\n    }\n  }\n  if (boFunctions[key]) {\n    boFunctions[key].usedByNode = true;\n  }\n  if (node.outputsParamsMapping && node.outputsParamsMapping.length) {\n    const suggestedOutputs = [];\n    for (const param of node.outputsParamsMapping) {\n      if (param && param.mainParameterSource ) {\n        const mainParameterSource = param.mainParameterSource;\n        if (mainParameterSource.BusinessObjectCode && mainParameterSource.AttributeName) {\n          if (node.businessObjectFunction && node.businessObjectFunction.IsCollectionResource) {\n            suggestedOutputs.push(`Output \"${mainParameterSource.AttributeName}\" as inout to node ${param.code} input name=\"${param.param_name}\". When need the value of the first item (e.g. when this node is expected to return one result and loop is not needed), use \"restResults.items[0].${mainParameterSource.AttributeName}\". `);\n          } else {\n            suggestedOutputs.push(`Output \"${mainParameterSource.AttributeName}\" for input to node ${param.code} input \"${param.param_name}\". `);\n          }\n        } else if (mainParameterSource.BusinessObjectCode === 'ORA_SYSTEM_CONSTANT' && mainParameterSource.Rules) {\n          for (const rule of mainParameterSource.Rules) {\n            if (rule.Inputs && Array.isArray(rule.Inputs)) {\n              for (const innerItem of rule.Inputs) {\n                suggestedOutputs.push(`Output ${innerItem.AttributeName} for input to node ${param.code} as part of a expression.`);\n              }\n            }\n          }\n        }\n      }\n    }\n    if (suggestedOutputs.length) {\n      suggestion += `Add or adjust these Outputs: ${suggestedOutputs.join('; ')}`;\n    }\n  }  \n  if (node.parametersMapping && node.parametersMapping.length) {\n    const suggestedInputs = [];\n    for (const param of node.parametersMapping) {\n      if (param && param.mainParameterSource) {\n        const mainParameterSource = param.mainParameterSource;\n        if (!mainParameterSource.BusinessObjectCode) {\n           param.mainParameterSource.missingBOC = true;\n          continue;\n        }\n        if (mainParameterSource.BusinessObjectCode.indexOf('ORA_SYSTEM') === -1) {\n          // Try and find the source node. \n          const matchKey = mainParameterSource.BusinessObjectCode + ':' + mainParameterSource.FunctionName;\n          const nodeCode = processNewNodesBoToNodes[matchKey] && processNewNodesBoToNodes[matchKey].length === 1 ? processNewNodesBoToNodes[matchKey][0].code : null;\n          const nodeIdentifier = nodeCode ? `node ${nodeCode}` : `businessObject ${mainParameterSource.BusinessObjectCode} function ${mainParameterSource.FunctionName}`;\n          suggestedInputs.push(`Input with name=\"${param.param_name}\" sourced via ${nodeIdentifier} output\"${mainParameterSource.AttributeName}\". `);\n        } else if (mainParameterSource.BusinessObjectCode === 'ORA_SYSTEM_USER') {\n          suggestedInputs.push(`\"${param.param_name}\" from user input.`);\n        } else if (mainParameterSource.BusinessObjectCode === 'ORA_SYSTEM_CONSTANT' && !mainParameterSource.Rules) {\n          suggestedInputs.push(`\"${param.param_name}\" with static value \"${mainParameterSource.AttributeValue}\".`);\n        } else if (mainParameterSource.BusinessObjectCode === 'ORA_SYSTEM_CONSTANT' && mainParameterSource.Rules) {\n          const outcomeTexts = [];\n          for (const outcome of mainParameterSource.Values) {\n            outcomeTexts.push(`If outcome equals \"${outcome.outcome}\", use value ${outcome.value}`);\n          }\n          const ruleTexts = []\n          for (const rule of mainParameterSource.Rules) {\n            const innerItemTexts = [];\n            if (rule.Inputs && Array.isArray(rule.Inputs)) {\n              for (const innerItem of rule.Inputs) {\n                const matchKey = innerItem.BusinessObjectCode.BusinessObjectCode + ':' + innerItem.BusinessObjectCode.FunctionName;\n                const nodeCode = processNewNodesBoToNodes[matchKey].length === 1 ? processNewNodesBoToNodes[matchKey][0].code : null;\n                const nodeIdentifier = nodeCode ? `node ${nodeCode}` : `businessObject ${innerItem.BusinessObjectCode.BusinessObjectCode} function ${innerItem.BusinessObjectCode.FunctionName}`;\n                innerItemTexts.push(`${nodeIdentifier} output ${innerItem.AttributeName} ${innerItem.Operator} ${innerItem.Value}`)\n              }\n            }\n            ruleTexts.push(`(${innerItemTexts.join(rule.InputOperation)})`)\n          }\n          suggestedInputs.push(`${mainParameterSource.AttributeName} based off this logic: Determine outcome via: ${ruleTexts.join(',')}, ${outcomeTexts.join(',')}.`);\n        }\n      }\n    }\n    if (suggestedInputs.length) {\n      suggestion += `Add or adjust these Inputs: ${suggestedInputs.join('; ')}`;\n    }\n  }\n  if (suggestion) {\n    suggestions.push(suggestion);\n  }\n}\n\nif (suggestions.length) {\n  suggestions.unshift('Inputs may have different capitlization from outputs, respect captilization, use outputName as needed to indicate correct capitlized ending.')\n}\n\n// Limit extra BOs\nconst max = 10;\nlet i = 0;\nfor (const key in boFunctions) {\n   if (!boFunctions[key].usedByNode) {\n     i++;\n     if (i > max) {\n        delete boFunctions[key];\n     }\n   }\n}\nconst obj = {suggestions, nodes, boFunctions};\n\nreturn obj;"
          },
