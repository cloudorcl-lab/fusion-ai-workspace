        },
        {
          "metadata": {
            "name": "Identify BOs",
            "returnType": "object",
            "sourceCode": "const boMapping = {};\nconst boFunctions = $context.$variables.boFunctions ;\nconst nodes = $context.$variables.processNext || [];\n\nfor (const node of nodes) {\n  const parametersMapping = node.parametersMapping ? node.parametersMapping : null;\n  if (!parametersMapping) {\n    node.missing = true;\n  }\n const referenceRelationships = node.referenceRelationships ? node.referenceRelationships : (node.businessObjectFunction && node.businessObjectFunction.referenceRelationships ? node.businessObjectFunction.referenceRelationships : null);\n  if (referenceRelationships) {\n    for (const rel of referenceRelationships) {\n      const matchKey = rel.BusinessObjectCode + ':' + rel.FunctionName;\n      if (!boMapping[matchKey]) {\n        boMapping[matchKey] = {\n          BusinessObjectCode: rel.BusinessObjectCode, \n          FunctionName: rel.FunctionName,\n          businessObjectFunction: boFunctions[matchKey],\n          providesInputsFor: [],\n          providesOutputsFor: []\n        };\n      }\n      boMapping[matchKey].providesOutputsFor.push( {\n        parentNodeCode: node.code,\n        RelationshipAttributes: rel.RelationshipAttributes,\n      });\n    }\n  }\n  if (parametersMapping) {\n    for (const param of parametersMapping) {\n      if (param.mainParameterSource) {\n        const mainSource = param.mainParameterSource;\n        if (mainSource.BusinessObjectCode && mainSource.FunctionName && mainSource.BusinessObjectCode.indexOf('ORA_SYSTEM') === -1) {\n          const matchKey = mainSource.BusinessObjectCode + ':' + mainSource.FunctionName;\n          if (!boMapping[matchKey]) {\n            boMapping[matchKey] = {\n              BusinessObjectCode: mainSource.BusinessObjectCode, \n              FunctionName: mainSource.FunctionName,\n              businessObjectFunction: boFunctions[matchKey],\n              providesInputsFor: [],\n              providesOutputsFor: [],\n              referenceRelationshipsNeeded: []\n            };\n          }\n          boMapping[matchKey].providesInputsFor.push( {\n            sourceNodeCode: node.code,\n            paramName: param.param_name,\n            atrributeName: mainSource.AttributeName,\n            mainParameterSource: param.mainParameterSource,\n          });\n        } else if (mainSource.Rules && Array.isArray(mainSource.Rules)) {\n          for (const rule of mainSource.Rules) {\n            if (rule.Inputs && Array.isArray(rule.Inputs)) {\n              for (const innerItem of rule.Inputs) {\n                if (innerItem.BusinessObjectCode && innerItem.FunctionName && innerItem.BusinessObjectCode.indexOf('ORA_SYSTEM') === -1) {\n                  const matchKey = innerItem.BusinessObjectCode + ':' + innerItem.FunctionName;\n                  if (!boMapping[matchKey]) {\n                    boMapping[matchKey] = {\n                      BusinessObjectCode: innerItem.BusinessObjectCode, \n                      FunctionName: innerItem.FunctionName,\n                      businessObjectFunction: boFunctions[matchKey],\n                      providesInputsFor: [],\n                      providesOutputsFor: [],\n                      referenceRelationshipsNeeded: []\n                    };\n                  }\n                  boMapping[matchKey].providesInputsFor.push( {\n                    sourceNodeCode: node.code,\n                    paramName: param.param_name,\n                    atrributeName: innerItem.AttributeName,\n                    mainParameterSource: param.mainParameterSource,\n                  });\n                }\n              }\n            }\n          }\n        } else {\n          node.noMap = true;\n        }\n      }\n    }\n  }\n}\nreturn {boMapping, hasNewBos: Object.values(boMapping).length > 0, nodes};"
          },
