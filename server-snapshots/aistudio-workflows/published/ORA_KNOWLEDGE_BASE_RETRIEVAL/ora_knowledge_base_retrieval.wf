          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Post Process Fetch Referenced",
            "returnType": "object",
            "sourceCode": "const queries = $context.$nodes.FETCH_REFERENCED_BOS.$output.queries;\nconst boFunctions = $context.$variables.boFunctions ;\n\n/* Due to LLM token limitation, reduce the tokens by picking only necessary fields*/\nconst newBosFunctions = [];\nif (queries) {\n  for (const queryObj of queries) {\n    for (const boObjectMetaData of queryObj.results) {\n      const boObject = boObjectMetaData.metadata;\n      const boObjectFields = {\n        \"BusinessObjectCode\": boObject.BusinessObjectCode,\n        \"BusinessObjectName\": boObject.BusinessObjectName,\n        \"BusinessObjectDescription\": boObject.BusinessObjectDescription,\n      };\n\n      if (boObject.Functions && Array.isArray(boObject.Functions)) {\n        for (const boFunction of boObject.Functions) {\n\n          const matchKey = boObject.BusinessObjectCode + ':' + boFunction.FunctionName;\n          const boFunctionFields = {\n            \"FunctionName\": boFunction.FunctionName,\n            \"FunctionDescription\": boFunction.FunctionDescription,\n            \"ActionName\": boFunction.ActionName,\n           \"IsCollectionResource\": boFunction.FunctionName === 'get_person_information_by_assignment_id' || boFunction.FunctionName == 'fetch_loggedIn_user_assignmentId' ? true : boFunction.OutputType === \"COLLECTION\",\n\n            \"InputParmeters\": boFunction.InputParmeters,\n            \"OutputAttributes\": boFunction.OutputAttributes,\n            \"ReferenceRelationships\": boFunction.ReferenceRelationships,\n            \"MatchKey\": matchKey,\n         \"OutputTypeUsage\": boFunction.OutputTypeUsage,\n         \"OutputType\": boFunction.OutputType,\n            ...boObjectFields\n          };\n          boFunctions[matchKey] = boFunctionFields;\n          newBosFunctions.push(boFunctionFields);\n\n        }\n      }\n    }\n  }\n}\n\nconst nodes = $context.$nodes.CREATE_BO_QUERY.$output.result.nodesToFetchBo;\nconst newNodes = [];\nfor (const node of nodes) { \n  node.businessObjectFunction = boFunctions[node.BusinessObjectCode + ':' + node.FunctionName];\n  if (node.businessObjectFunction) {\n     // Cleanup\n    delete node.InputParmeters;\n    delete node.parametersMapping;\n    delete node.is_collection;\n    delete node.idField;\n    newNodes.push(node);\n  }\n}\nconst ret = {newNodes, newBosFunctions, boFunctions};\n\nreturn ret;"
          },
