        {
          "metadata": {
            "name": "combine for processedNodes",
            "returnType": "object",
            "sourceCode": "const paramMap = {};\nconst newNodes = $context.$nodes.DETERMINE_NEW_SOURCES.$output.nodes;\nconst processNext = $context.$variables.processNext || [];\nif (newNodes && Array.isArray(newNodes)) {\n  for (const node of newNodes) {\n     paramMap[node.code] = node;\n  }\n}\nconst processedNewNodes =  $context.$variables.processedNewNodes; \n\nconst nodes = $context.$nodes.POST_PROCESS_FETCH_REFERENCED.$output.result.newNodes;\nfor (const node of nodes) { \n    node.parametersMapping = paramMap[node.code] ? paramMap[node.code].parametersMapping : [];\n    node.referenceRelationships = paramMap[node.code] ? paramMap[node.code].referenceRelationships : [];\n  if (!processedNewNodes[node.code]) {\n    processedNewNodes[node.code] = node;\n  } else {\n    processedNewNodes[node.code].parametersMapping = node.parametersMapping;\n  }\n  processNext.push(node);\n}\n\nreturn {processedNewNodes, processNext};"
          },
