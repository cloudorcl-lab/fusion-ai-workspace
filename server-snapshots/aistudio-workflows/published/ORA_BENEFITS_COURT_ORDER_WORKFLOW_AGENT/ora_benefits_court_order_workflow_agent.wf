          "code": "SETPLANTYPEID",
          "id": "1760692601413",
          "inputs": [
            {
              "id": "1760692601414_1",
              "name": "prompt",
              "type": "string",
              "value": "Merge the following two JSON objects.\n\nYour input are -\n\nplanTypeList = {{$context.$nodes.FINDMATCHINGPLANTYPEID.$output.matchedPlanType}}\nmatchedDependent = {{$context.$nodes.MATCHDEPENDENTNAME.$output}} \n\nGoal:\nMerge these so that for each object in matchedDependent.items, you find the entry in planTypeList with the same CoverageTypeName and add a new attribute PlanTypeId to that item.\n\nRules:\n\nMatch CoverageTypeName using an exact string match.\nIf multiple planTypeList entries match, use the first match.\nIf no match is found, set PlanTypeId to null.\nPreserve all existing fields and structure in matchedDependent; only add PlanTypeId and MatchedPlanTypeName to each item.\nDo not modify planTypeList.\n\nPlease provide the merged result in valid JSON format."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema \",\n  \"type\": \"object\",\n  \"properties\": {\n    \"matchedDependent\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"DisplayName\": {\n            \"type\": \"string\"\n          },\n          \"PersonId\": {\n            \"type\": \"string\"\n          },\n          \"RelationshipMeaning\": {\n            \"type\": \"string\"\n          },\n          \"CoverageTypeName\": {\n            \"type\": \"string\"\n          },\n          \"MatchedPlanTypeName\": {\n            \"type\": \"string\"\n          },\n          \"PlanTypeId\": {\n            \"type\": \"Number\"\n          }\n        }\n      }\n    }\n  }\n}",
          "type": "LLM"
        },
        {
