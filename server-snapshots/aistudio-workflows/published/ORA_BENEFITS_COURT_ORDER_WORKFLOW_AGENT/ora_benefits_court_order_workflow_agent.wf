              "value": "Execute the below java script code to check PersonId is valid.\n\nconst raw = \"{{$context.$variables.personId}}\"; \nconst trimmed = (raw ?? \"\").toString().trim();\n\n// Strict numeric check\nconst isNumeric = trimmed !== \"\" && !Number.isNaN(Number(trimmed));\n\nlet personIdExists;\nif (isNumeric) {\nvalidPersonId = true; // personId is a valid number or numeric string\n} else {\nvalidPersonId = false; // not numeric (pure string or empty)\n}"
            }
