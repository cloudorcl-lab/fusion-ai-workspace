        {
          "metadata": {
            "errorNodeId": "1770368190138",
            "name": "constructWOAreaKey",
            "returnType": "object",
            "sourceCode": "// Work order Integration configuration output\nvar integrationConfig = $context.$nodes.SERVICE_WORK_ORDER_INTEGRATION_CONFIGURATION.$output || {};\n\nvar woIntegConfigItem = integrationConfig.items && integrationConfig.items.length > 0\n  ? integrationConfig.items[0]\n  : {};\n\n// Get WoAreaKey from the configuration\nvar woAreaStr = woIntegConfigItem.WoAreaKey || \"\";\nvar woAreaFields = woAreaStr.split(\",\");\n\n// Get WoZoneKey from configuration\nvar woZoneStr = woIntegConfigItem.WoZoneKey || \"\";\nvar woZoneFields = woZoneStr.split(\",\");\n\n// Get the Work order details\nvar workOrderPayload = $context.$nodes.SERVICE_CUSTOMER_WORK_ORDER.$output || {};\n\n// Collect key=value strings\nvar keyValuePairs = [];\nvar failedZoneFields = [];\n\n// Build key=value pairs from WoAreaKey\nfor (var i = 0; i < woAreaFields.length; i++) {\n  var fieldName = woAreaFields[i].trim();\n\n  if (fieldName.length > 0) {\n    var value = workOrderPayload[fieldName];\n\n    if (value !== undefined && value !== null) {\n      keyValuePairs.push(fieldName + \"=\" + String(value));\n    }\n  }\n}\n\n// Validate WoZoneKey fields\nfor (var j = 0; j < woZoneFields.length; j++) {\n  var zoneField = woZoneFields[j].trim();\n\n  if (zoneField.length > 0) {\n    var zoneValue = workOrderPayload[zoneField];\n\n    if (zoneValue === undefined || zoneValue === null || zoneValue === \"\") {\n      failedZoneFields.push(zoneField);\n    }\n  }\n}\n\n// Prepare final values\nvar result = null;\nvar isWoZoneKeyValid = true;\n\nif (failedZoneFields.length === 0) {\n  result = keyValuePairs.join(\",\");\n} else {\n  isWoZoneKeyValid = false;\n}\n\n// Construct return object first\nvar responseObject = {};\nresponseObject.workAreaKeyValuePairs = result;\nresponseObject.isWoZoneKeyValid = isWoZoneKeyValid;\nresponseObject.failedWoZoneFields = failedZoneFields;\n\nreturn responseObject;"
          },
          "outcomes": {
            "success": "1766382946515"
          },
          "code": "CONSTRUCTWOAREAKEY",
          "convergenceTargetId": "1766382946515",
          "id": "1766232957812",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1770368190138",
            "name": "prepareSchdulerInfo",
            "returnType": "object",
            "sourceCode": "// ---- Get Scheduler Configurations ----\nvar workOrderIntegConfig =\n  $context.$nodes.SERVICE_WORK_ORDER_INTEGRATION_CONFIGURATION.$output || {};\n\n// Get Work Order Integration configuration item\nvar woIntegConfigItem =\n  workOrderIntegConfig.items && workOrderIntegConfig.items.length > 0\n    ? workOrderIntegConfig.items[0]\n    : {};\n\n// Get Scheduler Configuration item\nvar sch =\n  woIntegConfigItem.WoSchedulerConfigs &&\n  woIntegConfigItem.WoSchedulerConfigs.items &&\n  woIntegConfigItem.WoSchedulerConfigs.items.length > 0\n    ? woIntegConfigItem.WoSchedulerConfigs.items[0]\n    : {};\n\n// ---- Build single result object ----\nvar result = {\n  SchedulerCd: sch.SchedulerCd || \"\",\n  SchedulerTypeCd: sch.SchedulerTypeCd || \"\",\n\n  HighQuotaCutoff:\n    sch.HighQuotaCutoff !== undefined && sch.HighQuotaCutoff !== null\n      ? sch.HighQuotaCutoff\n      : \"\",\n\n  LowQuotaCutoff:\n    sch.LowQuotaCutoff !== undefined && sch.LowQuotaCutoff !== null\n      ? sch.LowQuotaCutoff\n      : \"\",\n\n  CurrentDayBuffer:\n    sch.CurrentDayBuffer !== undefined && sch.CurrentDayBuffer !== null\n      ? sch.CurrentDayBuffer\n      : \"\"\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1767079106160"
          },
          "code": "PREPARESCHDULERINFO",
          "convergenceTargetId": "1767079106160",
          "id": "1766382946515",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
