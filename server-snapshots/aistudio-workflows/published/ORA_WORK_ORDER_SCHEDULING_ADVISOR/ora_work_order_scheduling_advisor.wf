              "id": "1768986090526_1",
              "name": "returnValue",
              "type": "string",
              "value": "{{ $context.$nodes.SERVICE_WORK_ORDER_SCHEDULING_ASSISTANT.$output.recommendations}}"
            }
          ],
          "type": "RETURN"
        },
