          },
          "code": "RESOLVETZUSINGLLM",
          "convergenceTargetId": "1769499887680",
          "id": "1768831879192",
          "inputs": [
            {
              "id": "1768831879193_1",
              "name": "prompt",
              "type": "string",
              "value": "Input Variables:\n'systemDateTime' = {{$context.$system.$currentDateTime}}\n'timezone' = {{$context.$variables.TimeZone}} \n'currentDayBuffer' = {{$context.$variables.CurrentDayBuffer}} \n\nInstructions\nUse 'systemDateTime' as the only time source. Convert it to the specified 'timezone', then add 'currentDayBuffer' (in minutes) to the converted date-time. Derive 'CurrentDateTime' from this adjusted value. Do not use or reference the system’s local time."
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"CurrentDateTime\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "errorNodeId": "1770368190138",
            "name": "From-To Date Evaluator",
            "returnType": "object",
            "sourceCode": "// Prefer StartDate if provided, otherwise fallback to LLM-resolved datetime\nconst inputDateTime =  $context.$variables.StartDate ||  $context.$nodes.RESOLVETZUSINGLLM.$output.CurrentDateTime ||  \"\";\n\n// Normalize to YYYY-MM-DD safely\nlet dateFromStr = \"\";\n\n// Case 1: ISO datetime with T\nif (inputDateTime.indexOf(\"T\") !== -1) {\n  dateFromStr = inputDateTime.split(\"T\")[0];\n}\n// Case 2: Plain date YYYY-MM-DD\nelse if (inputDateTime.length >= 10) {\n  dateFromStr = inputDateTime.substring(0, 10);\n}\n\n// Create Date object using UTC to avoid timezone drift\nconst dateFrom = new Date(dateFromStr + \"T00:00:00Z\");\n\n// Add 14 days\nconst dateTo = new Date(dateFrom);\ndateTo.setUTCDate(dateFrom.getUTCDate() + 14);\n\n// Final result\nlet result = {\n  dateFrom: dateFromStr,\n  dateTo: dateTo.toISOString().split(\"T\")[0]\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1770809031363"
          },
          "code": "FROMTO_DATE_EVALUATOR",
          "convergenceTargetId": "1766230536182",
          "id": "1766226130139",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
