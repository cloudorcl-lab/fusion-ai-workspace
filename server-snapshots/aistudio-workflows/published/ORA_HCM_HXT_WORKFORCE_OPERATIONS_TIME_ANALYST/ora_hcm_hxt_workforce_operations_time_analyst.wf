            {
              "id": "1767080237153_1",
              "name": "prompt",
              "type": "string",
              "value": "Data:\nTimecards in submitted status : {{$context.$nodes.SUMMARY_TIMECARDS_SUBMITTED.$output}} \nTimecards pending payroll transfer : {{$context.$nodes.SUMMARY_TIMECARDS_PAYROLL.$output}} \nMissing Timecards : {{$context.$nodes.SUMMARY_MISSING_TIMECARDS.$output}} . Only consider MissingPersonTC and ignore PersonWithTC. If no data is present for MissingPersonTC, then ignore it.\n\nProvide 2 sentences summary of the above time cards data.\n\nDisplay all dates in {{$context.$nodes.GETUSERPREFERENCES.$output.items[0].DateFormat}} format."
            }
          ],
          "type": "LLM"
        },
