        {
          "metadata": {
            "name": "Parse Messages",
            "returnType": "object",
            "sourceCode": "const messageObjs = $context.$variables.messagesArray;\nvar resultMessages = [];\nmessageObjs.forEach((msg) => {\n resultMessages.push(JSON.parse(msg).items);\n});\n\nvar resultArray = [];\n\nfor(var i=0;i<resultMessages.length;i++){\n  var singleMessageSet = resultMessages[i];\n  for(var j=0;j<singleMessageSet.length;j++){\n    var singleMsg = singleMessageSet[j];\n    var temp = {};\n    temp.TimeEntryId = singleMsg.TimeEntryId;\n    temp.MessageText = singleMsg.MessageText;\n    resultArray.push(temp);\n    }\n  }\n\nconst entryObjs = $context.$nodes.GET_TIME_ENTRIES.$output.result.items;\nvar newArray = [];\nfor(var i=0; i< entryObjs.length;i++){\n var newObj = {};\n newObj.PersonName = entryObjs[i].PersonName;\n newObj.ExceptionType = entryObjs[i].TimeEntryException;\n newObj.TimeEntryDate = entryObjs[i].TimeEntryDate;\n newObj.TimeEntryId = entryObjs[i].TmRecId;\n for(var j=0; i< resultArray.length;j++){\n  var resObj = resultArray[j];\n  if(resObj.TimeEntryId == newObj.TimeEntryId){\n   newObj.MessageText = resObj.MessageText;\n   break;\n   }\n }\n newArray.push(newObj);\n}\n\nreturn newArray;"
          },
          "outcomes": {
            "success": "1767881741578"
          },
          "code": "PARSE_MESSAGES",
          "id": "1767871172736",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
