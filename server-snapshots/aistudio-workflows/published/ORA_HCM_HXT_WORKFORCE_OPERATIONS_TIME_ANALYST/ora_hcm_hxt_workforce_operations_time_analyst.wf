            "sourceCode": "var payload = $context.$nodes.RETRIEVE_PAYLOAD.$output.result;\nvar timecardArray = [];\n\npayload.Timecards.split(\",\").forEach(id => {\n  timecardArray.push({id: Number(id)});\n});\n\nreturn timecardArray;"
