            {
              "id": "1767881741579_1",
              "name": "prompt",
              "type": "string",
              "value": "Data : {{$context.$nodes.PARSE_MESSAGES.$output.result}}\n\nUse this data to display a messageListWidget of time card exceptions.\n\nDisplay the following data as per the mapping :\n\nName : <PersonName>\nException Type : <ExceptionType>, in capitalized word\nEntry Date : <TimeEntryDate>\nMessage : generate a manager description from <MessageText> \nSuggestion: Generate a suggestion of action for the manager to resolve the exception\n\nBadgeText is <ExceptionType>, in capitalized word\n\nOutput rules :\n- Only display the messageListWidget \n- Do not display any additional data\n- Create an individual card for each record\n- Format dates with date only \n- Display all dates in {{$context.$nodes.GETUSERPREFERENCES.$output.items[0].DateFormat}} format."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Create End Date",
            "returnType": "string",
            "sourceCode": "const startDate = new Date();\nstartDate.setDate(startDate.getDate() - 1);\nconst format = (date) => date.toISOString().split('T')[0];\nlet output = format(startDate);\nreturn output;"
          },
          "outcomes": {
            "success": "1766399481008"
          },
          "code": "CREATE_END_DATE",
          "id": "1767886039019",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Combine Timecard Data",
            "returnType": "object",
            "sourceCode": "let tcData;\ntry{\nlet missingTCData = $context.$nodes.GET_MISSING_TIMECARDS.$output;\ntcData = $context.$nodes.GET_ALL_TIME_CARDS_GROUPED_BY_STATUS.$output;\nlet finalMissingTCCount = {};\nif(missingTCData.result.facets[0].values[0].value===\"MissingPersonTC\"){\n      finalMissingTCCount = missingTCData.result.facets[0].values[0];\n}else if(missingTCData.result.facets[0].values[1] && missingTCData.result.facets[0].values[1].value===\"MissingPersonTC\"){\n      finalMissingTCCount = missingTCData.result.facets[0].values[1];\n}else{\n      finalMissingTCCount = {value: \"MissingPersonTC\", count: 0}\n}\nfinalMissingTCCount.displayValue = \"Missing\";\ntcData.facets[0].values.push(finalMissingTCCount);\nreturn tcData;\n} catch (e){\n  return tcData || { facets: [{ values: [] }] };\n}"
          },
          "outcomes": {
            "success": "1766473362805"
          },
          "code": "COMBINE_TIMECARD_DATA",
