          "metadata": {
            "name": "Similar SR Output",
            "returnType": "object",
            "sourceCode": "let result = { srNumber: \"\", srId: \"\", solution: \"\" };\n\nif($context.$triggers.REST.$input.isVectorSearchEnabled){ \n    const filtered = $context.$nodes.APPLY_SCORE_FILTER?.$output?.result;\n    if (filtered && filtered.length > 0) {\n        result = {\n            srNumber: filtered[0].number,\n            srId: filtered[0].id,\n            solution: filtered[0].resolveDescription\n        };\n    }\n} else{\n    const similarSR = $context.$nodes.GETSIMILARSR?.$output;\n    if (similarSR && similarSR.length > 0) {\n        result = {\n            srNumber: similarSR[0].srNumber,\n            srId: similarSR[0].srId,\n            solution: similarSR[0].resolveDescription\n        };\n    }\n}\nreturn result;"
          },
          "outcomes": {
