          },
          "code": "ACTIONPLANTEMPLATELOOKUP",
          "id": "1773953871684",
          "inputs": [
            {
              "id": "1773953871684_1",
              "name": "question",
              "type": "string",
              "value": "{{$context.$nodes.ACTION_PLAN_TEMPLATE_INPUT.$output.result}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"AnswerWithCitations\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"value\": {\n      \"type\": \"string\",\n      \"description\": \"The answer text.\"\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"description\": \"List of citations relevant to the answer.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"citedText\": {\n            \"type\": \"string\",\n            \"description\": \"The cited text.\"\n          }\n        },\n        \"required\": [\n          \"citedText\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"value\",\n    \"citations\"\n  ],\n  \"additionalProperties\": false\n}",
          "type": "RAG_DOCUMENT_TOOL"
        },
        {
          "metadata": {
            "name": "Action Plan Template Input",
            "returnType": "string",
            "sourceCode": "const userQuery = $context.$triggers.REST.$input.objectNumber != '' ? JSON.stringify($context.$nodes.SRDETAILS.$output.result) : $context.$system.$inputMessage + \"  \" + $context.$triggers.REST.$input.objectContext\nconst solution = $context.$nodes.FINDRESOLUTION.$output.proposedResolutionSummary\nconst prefix = \"Only find answer in the provided reference, do not generate your own answers. Return only the matching **Template Number**. If no matching template is found, return **null**.  Find best possible action plan template number for: \"\n\nvar question;\n\nif (solution && solution !== \"No relevant resolution found\") {\n    question = prefix + solution;\n} else {\n    question = prefix + userQuery;\n}\n\n\nreturn question"
          },
          "outcomes": {
            "success": "1773953871684"
          },
          "code": "ACTION_PLAN_TEMPLATE_INPUT",
          "id": "1773953950007",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Create HTML format messages",
            "returnType": "string",
            "sourceCode": "const output = $context?.$nodes?.SETAGENTMESSAGESTRUTURE?.$output?.result?.output || {};\n\nconst summary = output.Summary || \"No summary available\";\nlet referenceInfo = output.listOfArticles || \"\";\nlet similarSR = output.listOfSimilarSrs || \"\"; \n\nconst safeSummary = String(summary)\n  .replace(/&/g, \"&amp;\")\n  .replace(/</g, \"&lt;\")\n  .replace(/>/g, \"&gt;\");\n\n\nif (referenceInfo && similarSR) {\n  referenceInfo = referenceInfo + \",\" + similarSR;\n} else if (similarSR) {\n  referenceInfo = similarSR;\n}\n\nlet formattedReferences = \"\";\n\nif (referenceInfo) {\n\n  referenceInfo = String(referenceInfo);\n\n  const parts = referenceInfo.split(\",\");\n\n  let links = [];\n\n  for (let i = 0; i < parts.length; i++) {\n    const id = parts[i].trim();\n\n    if (id) {\n      const safeId = id\n        .replace(/&/g, \"&amp;\")\n        .replace(/</g, \"&lt;\")\n        .replace(/>/g, \"&gt;\");\n\n      links.push(`<span class=\"internal_dynlink\" external-doc-id=\"${safeId}\" lang=\"en\">${safeId}</span>`);\n    }\n  }\n\n  if (links.length > 0) {\n    formattedReferences = links.join(\", \");\n  }\n}\n\nlet htmlMessage;\nif (output.ObjectType=== \"WorkOrder\" ||  output.Summary===\"No relevant resolution found\"){\n htmlMessage = `\n<b>Summary</b>\n<p>${safeSummary}</p>\n\n`;\n}\nelse if (output.ObjectType=== \"ActionPlanTemplate\" &&  output.ObjectKey!= null){\n htmlMessage = `\n<b>Summary</b>\n<p>${safeSummary}</p>\n\n<b>What Actions Were Taken</b>\n<p>An action plan \"Recommended Plan\" has been created for review.</p>\n\n`;\n}\nelse {\n htmlMessage = `\n<b>Summary</b>\n<p>${safeSummary}</p>\n\n\n<b>What Actions Were Taken</b>\n<p>An action plan \"Resolution Plan\" has been created for review.</p>\n`;\n\n}\n\nif (formattedReferences) {\n  htmlMessage += `\n<b>Reference Information</b>\n<p>${formattedReferences}</p>\n`;\n}\n\nreturn htmlMessage;"
          },
          "outcomes": {
            "success": "1772193145009"
          },
          "code": "CREATE_HTML_FORMAT_MESSAGES",
          "id": "1775712132538",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
