        {
          "metadata": {
            "name": "create html  message for error",
            "returnType": "string",
            "sourceCode": "let node;\n\nif ($context.$nodes.GETSRDATA.$status === \"failure\") {\n    node = $context.$nodes.GETSRDATA;\n}\nelse if ( $context.$nodes.GET_ALL_MESSAGE.$status === \"failure\") {\n    node = $context.$nodes.GET_ALL_MESSAGE;\n}\nelse if ( $context.$nodes.KNOWLEDGESEARCH.$status === \"failure\") {\n    node = $context.$nodes.KNOWLEDGESEARCH;\n}\nelse if ( $context.$nodes.KNOWLEDGESEARCH1.$status === \"failure\") {\n    node = $context.$nodes.KNOWLEDGESEARCH1;\n}\nelse if ( $context.$nodes.KNOWLEDGESEARCH2.$status === \"failure\") {\n    node = $context.$nodes.KNOWLEDGESEARCH2;\n}\nelse if ( $context.$nodes.GETARTICLECONTENT.$status === \"failure\") {\n    node = $context.$nodes.GETARTICLECONTENT;\n} \nelse if ( $context.$nodes.GETARTICLECONTENT1.$status === \"failure\") {\n    node = $context.$nodes.GETARTICLECONTENT1;\n}\nelse if ( $context.$nodes.GETARTICLECONTENT2.$status === \"failure\") {\n    node = $context.$nodes.GETARTICLECONTENT2;\n}\nelse if ( $context.$nodes.GET_SEMANTIC_SIMILAR_SR.$status === \"failure\") {\n    node = $context.$nodes.GET_SEMANTIC_SIMILAR_SR;\n} \nelse if ( $context.$nodes.GETSIMILARSR.$status === \"failure\") {\n    node = $context.$nodes.GETSIMILARSR;\n}     \nelse if ( $context.$nodes.FINDSIMILARWO.$status === \"failure\") {\n    node = $context.$nodes.FINDSIMILARWO;\n} \nelse if ( $context.$nodes.FINDSIMILARAP.$status === \"failure\") {\n    node = $context.$nodes.FINDSIMILARAP;\n}\nelse if ( $context.$nodes.ACTIONPLANTEMPLATELOOKUP.$status === \"failure\") {\n    node = $context.$nodes.ACTIONPLANTEMPLATELOOKUP;\n}\nelse if (  $context.$nodes.CREATEMESSAGE.$status === \"failure\") {\n    node = $context.$nodes.CREATEMESSAGE;\n} \nelse if ( $context.$nodes.CREATE_MESSAGE_ENGAGEMENT.$status === \"failure\") {\n    node = $context.$nodes.CREATE_MESSAGE_ENGAGEMENT;\n} \nelse if ( $context.$nodes.GETACTIONPLANBYOBJECTID.$status === \"failure\") {\n    node = $context.$nodes.GETACTIONPLANBYOBJECTID;\n} \nelse if ( $context.$nodes.CANCEL_ACTION_PLAN.$status === \"failure\") {\n    node = $context.$nodes.CANCEL_ACTION_PLAN;\n} \nelse if ( $context.$nodes.ADDACTIONTOOBJECT.$status === \"failure\") {\n    node = $context.$nodes.ADDACTIONTOOBJECT;\n} \nelse if ( $context.$nodes.CREATE_ACTION_PLAN_RECORD_METRICS.$status === \"failure\") {\n    node = $context.$nodes.CREATE_ACTION_PLAN_RECORD_METRICS;\n}  \n\nconst summary = node?.$error?.$info || \"\";\nconst status = node?.$status || \"\";\n\n\nconst summaryText = `${summary}`;\n\nlet htmlMessage = `\n<b>Summary</b>\n<p>We couldn’t complete the request because a required detail could not be retrieved. Please contact your administrator.</p>\n\n<b>Error Details: </b>\n<p>\n-info: ${summaryText}<br>\n-status: ${status}<br>\n</p>\n\n<b>What actions were taken: </b>\n<p>No action was taken.</p>\n`;\n\nreturn htmlMessage;"
          },
          "outcomes": {
            "success": "1775720905380"
          },
