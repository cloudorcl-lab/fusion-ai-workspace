            "name": "returnLLMResponse",
            "returnType": "object",
            "sourceCode": "if (\n   $context.$nodes.CREATEMESSAGE.$status === \"failure\" ||\n  $context.$nodes.CREATE_MESSAGE_ENGAGEMENT.$status === \"failure\" ||\n  $context.$nodes.GETACTIONPLANBYOBJECTID.$status === \"failure\" ||\n  $context.$nodes.CANCEL_ACTION_PLAN.$status === \"failure\" ||\n  $context.$nodes.ADDACTIONTOOBJECT.$status === \"failure\" ||\n  $context.$nodes.CREATE_ACTION_PLAN_RECORD_METRICS.$status === \"failure\" \n) {\n  throw new Error(\"Some MESSAGE OR ACTION PLAN CALL FAILED\");\n}\n\n\n$context.$nodes.SETAGENTMESSAGESTRUTURE.$output.result.output"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "RETURNLLMRESPONSE",
          "id": "1764330099294",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1775720862821",
            "name": "SetAgentMessageStructure",
            "returnType": "string",
            "sourceCode": "if (\n  $context.$nodes.FINDSIMILARWO.$status === \"failure\" ||\n  $context.$nodes.ACTIONPLANTEMPLATELOOKUP.$status === \"failure\" ||\n  $context.$nodes.FINDSIMILARAP.$status === \"failure\"\n) {\n  throw new Error(\"FINDSIMILARWO OR FINDSIMILARAP OR ACTIONPLANTEMPLATELOOKUP  CALL FAILED\");\n}\n\n\n\n\nconst wo = $context.$nodes.PRESENTFINALANSWERWO?.$output;\nconst ap = $context.$nodes.PRESENTFINALANSWERAP?.$output;\nconst normal = $context.$nodes.PRESENTFINALANSWER?.$output;\n\n// Pick the first non-null output\nlet output = null;\n\nif (wo != null) {\n  output = wo;\n} else if (ap != null) {\n  output = ap;\n} else if (normal != null) {\n  output = normal;\n} else {\n  output = {}; // fallback\n}\n\nlet actionNumber;\n\nif (output.followupIntent === \"resolution_change\" || output.followupIntent === \"presentation_change\") {\n  output.Explanation = \"\";\n}\n\ndelete output.followupIntent;\n\nif (\n  output.ObjectType === \"ActionPlanTemplate\" &&\n  output.ObjectKey != null &&\n  output.ObjectKey !== \"NA\" &&\n  output.ObjectKey !== \"\"\n) {\n  actionNumber =\n    $context.$triggers.REST.$input.objectType === \"ServiceRequest\"\n      ? \"ORA_SVC_ACT_RECOMM_101\"\n      : $context.$triggers.REST.$input.objectType === \"HRHelpDeskRequest\"\n      ? \"ORA_SVC_ACT_RECOMM_102\"\n      : $context.$triggers.REST.$input.objectType === \"InternalServiceRequest\"\n      ? \"ORA_SVC_ACT_RECOMM_103\"\n      : null;\n} else if (output.ObjectType === \"ActionPlanTemplate\") {\n  actionNumber =\n    $context.$triggers.REST.$input.objectType === \"ServiceRequest\"\n      ? \"ORA_SVC_ACT_101\"\n      : $context.$triggers.REST.$input.objectType === \"HRHelpDeskRequest\"\n      ? \"ORA_SVC_ACT_102\"\n      : $context.$triggers.REST.$input.objectType === \"InternalServiceRequest\"\n      ? \"ORA_SVC_ACT_103\"\n      : null;\n}\n\n// Final output\nconst llmOutput = {\n  output,\n  workflowCode: $context.$workflow.$name,\n  jobId: $context.$workflow.$jobId,\n  conversationId: $context.$workflow.$conversationId,\n  actionNumber\n};\n\nreturn JSON.stringify(llmOutput, null, 2);"
          },
          "outcomes": {
            "success": "1765791720422"
          },
