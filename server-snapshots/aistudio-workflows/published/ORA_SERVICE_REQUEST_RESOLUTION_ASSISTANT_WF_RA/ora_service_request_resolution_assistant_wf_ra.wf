          "metadata": {
            "name": "get_ActionPlanToBeCanceled",
            "returnType": "string",
            "sourceCode": "const actionPlans = $context.$nodes.GETACTIONPLANBYOBJECTID.$output;\nconst items = actionPlans?.items || [];\nconst workflowCode = $context.$workflow.$name;\nconst canceledActionPlanStatusCd = \"ORA_SVC_CANCELED\";\nconst completedActionPlanStatusCd = \"ORA_SVC_COMPLETED\";\n\nconst actionPlanToBeCanceled = items\n  .filter(item =>  item.StatusCd && !item.StatusCd.includes(canceledActionPlanStatusCd) && !item.StatusCd.includes(completedActionPlanStatusCd)  && item.Message && item.Message.includes(workflowCode))\n  .sort((a, b) => new Date(b.CreationDate) - new Date(a.CreationDate))\n  .map(item => item.ActionPlanNumber)[0] || \"\";\n\nreturn actionPlanToBeCanceled;"
          },
          "outcomes": {
            "success": "1770282790209"
          },
