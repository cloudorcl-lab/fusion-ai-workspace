        {
          "metadata": {
            "name": "Apply Score Filter",
            "returnType": "object",
            "sourceCode": "const similarSR = $context.$nodes.GET_SEMANTIC_SIMILAR_SR.$output.items\n\nconst filteredItems = similarSR\n    .filter(item => item.$context?.search?.score > 60)\n    .map(item => ({\n        id: item.id,\n        number: item.number,\n        resolveDescription: item.resolveDescription\n    }));\n\nreturn filteredItems"
          },
          "outcomes": {
            "success": "1773944264484"
          },
          "code": "APPLY_SCORE_FILTER",
          "id": "1773949969014",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1775720862821",
            "name": "ActionPlanTemplateLookUp",
            "toolCode": "ORA_ACTION_PLAN_TEMPLATE_LOOKUP"
          },
          "outcomes": {
