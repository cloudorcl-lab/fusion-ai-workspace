        {
          "metadata": {
            "errorNodeId": "1775720862821",
            "name": "getInputContextUsedForOutput",
            "returnType": "object",
            "sourceCode": "if (\n  $context.$nodes.KNOWLEDGESEARCH.$status === \"failure\" ||\n  $context.$nodes.KNOWLEDGESEARCH1.$status === \"failure\" ||\n  $context.$nodes.KNOWLEDGESEARCH2.$status === \"failure\" ||\n  $context.$nodes.GETARTICLECONTENT.$status === \"failure\" ||\n  $context.$nodes.GETARTICLECONTENT1.$status === \"failure\" ||\n  $context.$nodes.GET_SEMANTIC_SIMILAR_SR.$status === \"failure\" ||\n   $context.$nodes.GETSIMILARSR.$status === \"failure\" ||\n  $context.$nodes.GETARTICLECONTENT2.$status === \"failure\" \n) {\n     throw new Error(\"ANY KNOWLEDGESEARCH OR ANY GETSIMILARSR CALL FAILED\");\n}\n\n\nvar srSet = new Set();\nvar articleSet = new Set();\nvar inputSources = $context.$nodes.FINDRESOLUTION.$output.consideredInputs; \n\nif (inputSources.indexOf(\"SimilarSROutput\") !== -1) {\n   srSet.add($context.$variables.similarSrNumber) \n}\n\n\nif (inputSources.indexOf(\"KnowledgeOutput1\") !== -1) {\n\n    var knNode = $context.$nodes.KNOWLEDGESEARCH;\n    var knowledgeItems = (knNode && knNode.$output && knNode.$output.items) \n        ? knNode.$output.items \n        : [];\n\n    if (knowledgeItems.length > 0 && knowledgeItems[0] && knowledgeItems[0].documentId) {\n        articleSet.add(knowledgeItems[0].documentId);\n    }\n}\n\n\nif (inputSources.indexOf(\"KnowledgeOutput2\") !== -1) {\n\n    var knNode1 = $context.$nodes.KNOWLEDGESEARCH1;\n    var knowledgeItems1 = (knNode1 && knNode1.$output && knNode1.$output.items) \n        ? knNode1.$output.items \n        : [];\n\n    if (knowledgeItems1.length > 0 && knowledgeItems1[0] && knowledgeItems1[0].documentId) {\n        articleSet.add(knowledgeItems1[0].documentId);\n    }\n}\n\n\nif (inputSources.indexOf(\"KnowledgeOutput3\") !== -1) {\n\n    var knNode2 = $context.$nodes.KNOWLEDGESEARCH2;\n    var knowledgeItems2 = (knNode2 && knNode2.$output && knNode2.$output.items) \n        ? knNode2.$output.items \n        : [];\n\n    if (knowledgeItems2.length > 0 && knowledgeItems2[0] && knowledgeItems2[0].documentId) {\n        articleSet.add(knowledgeItems2[0].documentId);\n    }\n}\n\n\nreturn  {  \"srList\": Array.from(srSet), \"articleList\": Array.from(articleSet) };"
          },
