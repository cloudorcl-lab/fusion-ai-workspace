        {
          "metadata": {
            "errorNodeId": "1775720862821",
            "name": "srDetails",
            "returnType": "string",
            "sourceCode": "if (\n  $context?.$nodes?.GETSRDATA?.$status === \"failure\" ||\n  $context?.$nodes?.GET_ALL_MESSAGE?.$status === \"failure\"\n) {\n  throw new Error(\"GETSRDATA OR GET_ALL_MESSAGE CALL FAILED\");\n}\n\n\nif ($context.$triggers.REST.$input.objectNumber !== null) {\n\n  const srAttributesRaw = $context.$nodes.GETSRDATA.$output;\n\n  const srAttributes = (srAttributesRaw && srAttributesRaw.content)\n    ? srAttributesRaw.content\n    : (srAttributesRaw || {});\n\n  const messagesResponse = $context.$nodes.GET_ALL_MESSAGE.$output;\n\n  const result = {};\n\n  // Copy SR attributes except @context\n  for (const key in srAttributes) {\n    if (key !== \"@context\") {\n      result[key] = srAttributes[key];\n    }\n  }\n\n  const items = messagesResponse?.items || [];\n\n  // Flatten messages\n  const flattenedMessages = items.map(m => {\n    const sender = m?.MessageTypeCd\n      ? (m.MessageTypeCd.includes(\"CUSTOMER\") ? \"Customer\" :\n         m.MessageTypeCd.includes(\"RESPONSE\") ? \"Agent\" : \"System\")\n      : \"Unknown\";\n\n    const timestamp = m?.CreationDate || \"\";\n\n    const text = m?.MessageContent\n      ? m.MessageContent.replace(/<[^>]+>/g, \"\").trim()\n      : \"\";\n\n    return `${sender}${timestamp ? \" (\" + timestamp + \")\" : \"\"}: ${text}`;\n  });\n\n  result.Messages = flattenedMessages;\n  result.MessageCount = flattenedMessages.length;\n\n  return JSON.stringify(result, null, 2);\n\n} \n\n  return $context.$triggers.REST.$input.content  ;"
          },
          "outcomes": {
            "success": "1772172347902"
          },
          "code": "SRDETAILS",
          "convergenceTargetId": "1764248257812",
          "id": "1764064527800",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
