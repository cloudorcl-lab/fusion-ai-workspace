        {
          "metadata": {
            "name": "PrepareAppointmentList",
            "returnType": "object",
            "sourceCode": "const obj = $context.$nodes.GET_OUTCOME_FOR_ACTIVITY_FROM_AI_OUTCOME_STORE.$output ;\nlet output = {};\n\nlet numOfDays= $context.$triggers.REST.$input?.action?.config?.numOfDays ;\nif (numOfDays!==\"\" && numOfDays >7 ){\nnumOfDays = 7;\n\noutput.QExpressionAppointments = {\n    op: '$and',\n    criteria: [\n        {\n            op: '$eq',\n            attribute: \"ActivityFunctionCode\",\n            value: \"APPOINTMENT\"\n        },\n        {\n            op: \"$wi\",\n            attribute: \"SortDate\",\n            value1: \"now/d\",\n            value2: `now/d+${numOfDays}d`   // This will result in \"now/d+4d\" if x = 4\n        },\n       {\n                        \"op\": \"$ne\",\n                        \"attribute\": \"ListOfContacts\",\n                        \"value\": \"\"\n                    }\n    ]\n};\n\nreturn output;\n\n\n} else if(numOfDays!==\"\" && numOfDays <=7 ){\n\nif (numOfDays <1 ){\n   numOfDays = 1;\n}\noutput.QExpressionAppointments = {\n    op: '$and',\n    criteria: [\n        {\n            op: '$eq',\n            attribute: \"ActivityFunctionCode\",\n            value: \"APPOINTMENT\"\n        },\n        {\n            op: \"$wi\",\n            attribute: \"SortDate\",\n            value1: \"now/d\",\n            value2: `now/d+${numOfDays}d`   // This will result in \"now/d+4d\" if x = 4\n        },\n      {\n                        \"op\": \"$ne\",\n                        \"attribute\": \"ListOfContacts\",\n                        \"value\": \"\"\n                    }\n    ]\n};\n\nreturn output;\n} \n\n\nif(Array.isArray(obj?.items) && obj?.items?.length > 0){\noutput.QExpressionAppointments = {\n        \"op\": \"$or\",\n        \"criteria\": [\n            {\n                \"op\": \"$and\",\n                \"criteria\": [\n                    {\n                        \"op\": \"$eq\",\n                        \"attribute\": \"ActivityFunctionCode\",\n                        \"value\": \"APPOINTMENT\"\n                    },\n                    {\n                        \"op\": \"$wi\",\n                        \"attribute\": \"SortDate\",\n                        \"value1\": \"now/d+6d\",\n                        \"value2\": \"now/d+7d\"\n                    },\n                    {\n                        \"op\": \"$ne\",\n                        \"attribute\": \"ListOfContacts\",\n                        \"value\": \"\"\n                    }\n                ]\n            },\n            {\n                \"op\": \"$and\",\n                \"criteria\": [\n                    {\n                        \"op\": \"$eq\",\n                        \"attribute\": \"ActivityFunctionCode\",\n                        \"value\": \"APPOINTMENT\"\n                    },\n                    {\n                        \"op\": \"$wi\",\n                        \"attribute\": \"SortDate\",\n                        \"value1\": \"now/d\",\n                        \"value2\": \"now/d+6d\"\n                    },\n                     {\n                        \"op\": \"$wi\",\n                        \"attribute\": \"LastUpdateDate\",\n                        \"value1\": \"now/d-1d\",\n                        \"value2\": \"now/d+1d\"\n                    },\n                    {\n                        \"op\": \"$ne\",\n                        \"attribute\": \"ListOfContacts\",\n                        \"value\": \"\"\n                    }\n                ]\n            }\n        ]\n    };\n\n}else{\noutput.QExpressionAppointments = {\n        op: '$and',\n        criteria: [\n            {\n                op: '$eq',\n                attribute: \"ActivityFunctionCode\",\n                value: \"APPOINTMENT\"\n            },\n\t\t\t{\"op\": \"$wi\", \"attribute\": \"SortDate\", \"value1\": \"now/d\", \"value2\": \"now/d+7d\"},\n{\n                        \"op\": \"$ne\",\n                        \"attribute\": \"ListOfContacts\",\n                        \"value\": \"\"\n                    }\n\t\t\t\n        ]\n    };\n}\n\nreturn output ;"
          },
          "outcomes": {
            "success": "1775024866805"
          },
