            "name": "requiredMAXResponseChar",
            "returnType": "string",
            "sourceCode": "const defaultLength = 900;\nconst summaryLength = $context.$triggers.REST.$input.summaryLength;\nif (summaryLength === null || summaryLength === undefined || summaryLength === \"\") {\n    return defaultLength;\n  }\n\n  const n = Number(summaryLength);\n  if (Number.isNaN(n)) return defaultLength; \n\n  let maxLength;\n  if (n >= 800) {\n    maxLength = n - 200;\n  } else if (n >= 500 && n < 800) {\n    maxLength = n - 150;\n  } else if (n >= 300 && n < 500) {\n    maxLength = n - 100;\n  } else if (n >= 100 && n < 300) {\n    maxLength = n - 80;\n  } else if (n < 100) {\n    maxLength = n - 20;\n  } else {\n    maxLength = n - 15;\n  }\n\n  return String(maxLength);"
          },
          "outcomes": {
            "success": "1760441974395"
          },
          "code": "REQUIREDMAXRESPONSECHAR",
          "id": "1772184303800",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "inputValidationAndPopulateError",
            "returnType": "string",
            "sourceCode": "const inputData = $context.$triggers.REST.$input;\n\nif (inputData.objectNumber == '' && inputData.content == '') {\n      return \"Please provide either Object Number or content\";\n}\n\nif (inputData.objectNumber == '') {\n  return \"\";\n}\n\nlet errorMessage = \"\";\nif (inputData.objectName != \"Case\") {\nerrorMessage += \"ObjectName is invalid, please pass Case.\";\n}\n\nif (inputData.promptCode != '' && (inputData.promptCode != \"Case_Summarization\" && inputData.promptCode != \"Case_Solution_Summarization\")) {\n     errorMessage += \" PromptCode is invalid.\";\n}\n\nreturn errorMessage;"
          },
          "outcomes": {
            "success": "1772194387571"
          },
          "code": "INPUTVALIDATIONANDPOPULATEERROR",
          "id": "1772194229737",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
