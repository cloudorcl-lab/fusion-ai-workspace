                          "sourceCode": "function parse(value) {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  const text = value.trim();\n\n  if (!text || (text[0] !== \"{\" && text[0] !== \"[\")) {\n    return value;\n  }\n\n  try {\n    return JSON.parse(text);\n  } catch (e) {\n    return value;\n  }\n}\n\nfunction unwrap(output) {\n  output = parse(output);\n\n  if (output?.result !== undefined) {\n    return unwrap(output.result);\n  }\n\n  if (output?.output !== undefined) {\n    return unwrap(output.output);\n  }\n\n  return output ?? {};\n}\n\nfunction appendResult(output, results) {\n  const unwrapped = unwrap(output);\n\n  if (Array.isArray(unwrapped)) {\n    for (const item of unwrapped) {\n      appendResult(item, results);\n    }\n    return;\n  }\n\n  if (unwrapped && typeof unwrapped === \"object\") {\n    if (\n      Array.isArray(unwrapped.validPolicyDetails) ||\n      Array.isArray(unwrapped.errorPolicyDetails) ||\n      Array.isArray(unwrapped.mappingSetPayloadByTarget)\n    ) {\n      results.push(unwrapped);\n    }\n  }\n}\n\nconst chunkResults = [];\nappendResult($context.$nodes.POLICYDETAILSFORMS.$output, chunkResults);\n\nconst validPolicyDetails = [];\nconst errorPolicyDetails = [];\nconst groupedMappingSetPayloadByTarget = {};\n\nfor (const result of chunkResults) {\n  for (const detail of result.validPolicyDetails || []) {\n    validPolicyDetails.push(detail);\n  }\n\n  for (const detail of result.errorPolicyDetails || []) {\n    errorPolicyDetails.push(detail);\n  }\n\n  for (const target of result.mappingSetPayloadByTarget || []) {\n    const targetCode = target.TargetAttributeCode || target.MappingSetCode || \"UNKNOWN\";\n\n    if (!groupedMappingSetPayloadByTarget[targetCode]) {\n      groupedMappingSetPayloadByTarget[targetCode] = {\n        ...target,\n        TargetName: target.TargetName || null,\n        TargetAttributeCode: target.TargetAttributeCode || null,\n        MappingSetCode: target.MappingSetCode || null,\n        MSPayload: []\n      };\n    }\n\n    for (const row of target.MSPayload || []) {\n      groupedMappingSetPayloadByTarget[targetCode].MSPayload.push(row);\n    }\n  }\n}\n\nreturn {\n  validPolicyDetails,\n  errorPolicyDetails,\n  mappingSetPayloadByTarget: Object.values(groupedMappingSetPayloadByTarget)\n};",
