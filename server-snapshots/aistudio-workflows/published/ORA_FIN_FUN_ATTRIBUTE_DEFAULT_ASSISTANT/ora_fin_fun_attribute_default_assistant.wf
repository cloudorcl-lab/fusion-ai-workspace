                {
                  "metadata": {
                    "name": "returnRuleMetadata",
                    "returnType": "object",
                    "sourceCode": "\nfunction getSourceIndex() {\n  try {\n    const output = $context.$nodes.BUILD_ATTRIBUTE_SOURCE_INDEX.$output;\n    return (output && output.result !== undefined ? output.result : output) || {};\n  } catch (e) {\n    return {};\n  }\n}\n\nfunction getSourceIndexName(attributeCode) {\n  const index = getSourceIndex();\n  const row = ((index.byCode || {})[attributeCode]) || {};\n  return row.DisplayName || row.AttributeName || row.Name || row.Prompt || row.AttributeCode || \"\";\n}\n\nfunction parse(value) {\n  if (typeof value !== \"string\") return value;\n  const text = value.trim();\n  if (!text || (text[0] !== \"{\" && text[0] !== \"[\")) return value;\n  try { return JSON.parse(text); } catch (e) { return value; }\n}\n\nfunction unwrap(output) {\n  let current = output;\n  for (let depth = 0; depth < 8; depth += 1) {\n    current = parse(current);\n    if (current && typeof current === \"object\" && current.result !== undefined) { current = current.result; continue; }\n    if (current && typeof current === \"object\" && current.output !== undefined) { current = current.output; continue; }\n    if (current && typeof current === \"object\" && current.body !== undefined) { current = current.body; continue; }\n    return current || {};\n  }\n  return current || {};\n}\n\nfunction firstItem(output) {\n  const unwrapped = unwrap(output);\n  if (Array.isArray(unwrapped)) return unwrapped[0] || {};\n  if (Array.isArray(unwrapped.items)) return unwrapped.items[0] || {};\n  return unwrapped && typeof unwrapped === \"object\" ? unwrapped : {};\n}\n\nfunction normalize(value) {\n  return String(value || \"\").trim().toUpperCase();\n}\n\nconst target = $context.$nodes.BUILDTARGETRULEDEFINITIONS.$output.result || {};\nconst expectedMappingSetCode = target.mappingSetPrefix || target.MappingSetCode || \"\";\nconst existingRule = firstItem($context.$nodes.GET_RULES_BY_TARGET?.$output);\nconst existingRuleMappingSetCode = existingRule.MappingSetCode || \"\";\nconst createdRule = firstItem($context.$nodes.CREATE_ATTRIBUTE_BUILDER_RULE?.$output);\nconst reusedMappingSet = firstItem($context.$nodes.GETRULEMAPPINGSET?.$output);\nconst createdMappingSet = firstItem($context.$nodes.CREATE_ATTRIBUTE_BUILDER_MAPPING_SET?.$output);\nconst reusedFlavor = firstItem($context.$nodes.GETRULEMAPPINGSETFLAVOR?.$output);\nconst createdFlavor = firstItem($context.$nodes.CREATE_ATTRIBUTE_BUILDER_MAPPING_SETFLAVOR?.$output);\n\nconst mappingSet = reusedMappingSet.MappingSetId ? reusedMappingSet : createdMappingSet;\nconst flavor = reusedFlavor.MappingSetFlavorId ? reusedFlavor : createdFlavor;\nconst ruleMatchedMappingSet =\n  !!existingRule.AttributeRuleId &&\n  normalize(existingRuleMappingSetCode) === normalize(expectedMappingSetCode);\n\nreturn {\n  TargetAttributeCode: target.code || existingRule.TargetAttribute || null,\n  TargetName: getSourceIndexName(target.TargetAttributeCode || target.code) || target.TargetAttributeCode || target.code || null,\n  MappingSetCode: mappingSet.MappingSetCode || expectedMappingSetCode || existingRuleMappingSetCode || null,\n  MappingSetId: mappingSet.MappingSetId || null,\n  MappingSetFlavorId: flavor.MappingSetFlavorId || null,\n  StripeId: flavor.StripeId ?? null,\n  AttributeRuleId: createdRule.AttributeRuleId || existingRule.AttributeRuleId || null,\n  ExistingRuleMappingSetCode: existingRuleMappingSetCode || null,\n  reusedExistingRule: ruleMatchedMappingSet,\n  ruleMatchedMappingSet,\n  mappingSetExisted: !!reusedMappingSet.MappingSetId,\n  mappingSetCreated: !!createdMappingSet.MappingSetId\n};"
