          },
          "code": "MERGETARGETCHUNKRESULTS",
          "convergenceTargetId": "1900000002001",
          "id": "1900000000190",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Return Attribute Builder Payload",
            "returnType": "object",
            "sourceCode": "// Code Node: Merge Publish Status Back to Original Policy Details\n\nfunction getPath(root, path) {\n  let current = root;\n\n  for (let i = 0; i < path.length; i += 1) {\n    if (current === null || current === undefined) {\n      return undefined;\n    }\n\n    current = current[path[i]];\n  }\n\n  return current;\n}\n\nfunction tryParseJson(value) {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  const text = value.trim();\n\n  if (!text) {\n    return value;\n  }\n\n  try {\n    return JSON.parse(text);\n  } catch (e) {\n    // Continue to fallback parsing below.\n  }\n\n  const firstBrace = text.indexOf(\"{\");\n  const firstBracket = text.indexOf(\"[\");\n  const start = firstBrace >= 0 && firstBracket >= 0\n    ? Math.min(firstBrace, firstBracket)\n    : Math.max(firstBrace, firstBracket);\n  const end = Math.max(text.lastIndexOf(\"}\"), text.lastIndexOf(\"]\"));\n\n  if (start >= 0 && end > start) {\n    try {\n      return JSON.parse(text.substring(start, end + 1));\n    } catch (e) {\n      return value;\n    }\n  }\n\n  return value;\n}\n\nfunction unwrapOutput(output) {\n  let current = output;\n  const seen = new WeakSet();\n\n  for (let depth = 0; depth < 8; depth += 1) {\n    if (current === null || current === undefined || current === \"\") {\n      return {};\n    }\n\n    const parsed = tryParseJson(current);\n\n    if (parsed !== current) {\n      current = parsed;\n      continue;\n    }\n\n    if (Array.isArray(current) && current.length === 1) {\n      current = current[0];\n      continue;\n    }\n\n    if (typeof current === \"object\") {\n      if (seen.has(current)) {\n        return current;\n      }\n\n      seen.add(current);\n\n      if (current.result !== undefined) {\n        current = current.result;\n        continue;\n      }\n\n      if (current.output !== undefined) {\n        current = current.output;\n        continue;\n      }\n\n      if (current.body !== undefined) {\n        current = current.body;\n        continue;\n      }\n    }\n\n    return current;\n  }\n\n  return current;\n}\n\nfunction normalize(value) {\n  return String(value || \"\").trim();\n}\n\nfunction getDetailId(detail) {\n  return normalize(\n    detail &&\n    (\n      detail.detailId ||\n      detail.DetailId ||\n      detail.id\n    )\n  );\n}\n\nfunction getOriginalPolicyDetails(input) {\n  const unwrapped = unwrapOutput(input);\n\n  if (Array.isArray(unwrapped)) {\n    return unwrapped;\n  }\n\n  if (Array.isArray(unwrapped.policyDetails)) {\n    return unwrapped.policyDetails;\n  }\n\n  if (\n    unwrapped.result &&\n    Array.isArray(unwrapped.result.policyDetails)\n  ) {\n    return unwrapped.result.policyDetails;\n  }\n\n  return [];\n}\n\nfunction normalizePart(part) {\n  const unwrappedPart = unwrapOutput(part);\n\n  if (!unwrappedPart || typeof unwrappedPart !== \"object\") {\n    return null;\n  }\n\n  return {\n    ...unwrappedPart,\n    payload: unwrapOutput(unwrappedPart.payload)\n  };\n}\n\nfunction appendParts(output, parts) {\n  const unwrapped = unwrapOutput(output);\n\n  if (!unwrapped) {\n    return;\n  }\n\n  if (Array.isArray(unwrapped)) {\n    for (let i = 0; i < unwrapped.length; i += 1) {\n      appendParts(unwrapped[i], parts);\n    }\n\n    return;\n  }\n\n  if (typeof unwrapped !== \"object\") {\n    return;\n  }\n\n  if (Array.isArray(unwrapped.parts)) {\n    for (let i = 0; i < unwrapped.parts.length; i += 1) {\n      const part = normalizePart(unwrapped.parts[i]);\n\n      if (part) {\n        parts.push(part);\n      }\n    }\n\n    return;\n  }\n\n  if (Array.isArray(unwrapped.items)) {\n    appendParts(unwrapped.items, parts);\n    return;\n  }\n\n  if (unwrapped.id && unwrapped.payload) {\n    const part = normalizePart(unwrapped);\n\n    if (part) {\n      parts.push(part);\n    }\n  }\n}\n\nfunction addMappingNodeOutputs(candidates, node) {\n  if (!node || typeof node !== \"object\") {\n    return;\n  }\n\n  if (node.$output !== undefined) {\n    candidates.push(node.$output);\n  }\n\n  const children = Object.values(node);\n\n  for (let i = 0; i < children.length; i += 1) {\n    const child = children[i];\n\n    if (child && typeof child === \"object\" && child.$output !== undefined) {\n      candidates.push(child.$output);\n    }\n  }\n}\n\nfunction getInsertOutputCandidates(context) {\n  const candidates = [];\n  const directCandidates = [\n    getPath(context, [\"$nodes\", \"MERGETARGETCHUNKRESULTS\", \"$output\"]),\n    getPath(context, [\"$nodes\", \"PROCESS_TARGET_ATTRIBUTE_CHUNKS\", \"$output\"]),\n    getPath(context, [\"$nodes\", \"CREATE_ATTRIBUTE_BUILDER_MAPPINGS\", \"CREATE_ATTRIBUTE_BUILDER_MAPPINGSBATCH\", \"$output\"]),\n    getPath(context, [\"$nodes\", \"CREATE_ATTRIBUTE_BUILDER_MAPPINGSBATCH\", \"$output\"]),\n    getPath(context, [\"$variables\", \"insertOutput\"]),\n    getPath(context, [\"$variables\", \"mappingSetInsertOutput\"])\n  ];\n\n  for (let i = 0; i < directCandidates.length; i += 1) {\n    if (directCandidates[i] !== undefined && directCandidates[i] !== null) {\n      candidates.push(directCandidates[i]);\n    }\n  }\n\n  const nodes = getPath(context, [\"$nodes\"]) || {};\n  const nodeNames = Object.keys(nodes);\n\n  for (let i = 0; i < nodeNames.length; i += 1) {\n    const nodeName = nodeNames[i];\n\n    if (nodeName.toLowerCase().indexOf(\"mapping\") >= 0) {\n      addMappingNodeOutputs(candidates, nodes[nodeName]);\n    }\n  }\n\n  return candidates;\n}\n\nfunction normalizeKey(value) {\n  return String(value || \"\").trim().toUpperCase().replace(/[^A-Z0-9]+/g, \"\");\n}\n\nfunction humanizeAttributeCode(code) {\n  return String(code || \"\")\n    .replace(/^ORA_/, \"\")\n    .replace(/_(ID|CODE|LOOKUP_CODE|CCID)$/, \"\")\n    .split(\"_\")\n    .filter(Boolean)\n    .map(part => part.charAt(0).toUpperCase() + part.slice(1).toLowerCase())\n    .join(\" \");\n}\n\nfunction resolveTargetCodeFromDetail(detail, targetRuleDefinitionMap) {\n  const target = Array.isArray(detail && detail.targets) ? detail.targets[0] || {} : {};\n  const targetText = String(target.attribute || \"\").trim();\n\n  if (targetRuleDefinitionMap[targetText]) {\n    return targetText;\n  }\n\n  const policyId = String(detail && detail.policyId || \"\");\n  if (policyId.indexOf(\"P_\") === 0) {\n    const fromPolicy = policyId.slice(2);\n    if (targetRuleDefinitionMap[fromPolicy]) {\n      return fromPolicy;\n    }\n  }\n\n  const targetNorm = normalizeKey(targetText);\n  const codes = Object.keys(targetRuleDefinitionMap || {});\n  for (let i = 0; i < codes.length; i += 1) {\n    const code = codes[i];\n    if (normalizeKey(code) === targetNorm || normalizeKey(humanizeAttributeCode(code)) === targetNorm) {\n      return code;\n    }\n  }\n\n  return \"\";\n}\n\nfunction getSourceIndexForDependencyCheck() {\n  const indexOutput = getPath($context, [\"$nodes\", \"BUILD_ATTRIBUTE_SOURCE_INDEX\", \"$output\"]);\n  const index = unwrapOutput(indexOutput);\n  return index && typeof index === \"object\" ? index : {};\n}\n\nfunction getDependencyNameCandidates(dependencyCode) {\n  const candidates = [\n    dependencyCode,\n    humanizeAttributeCode(dependencyCode)\n  ];\n  const sourceIndex = getSourceIndexForDependencyCheck();\n  const row = (sourceIndex.byCode || {})[dependencyCode] || {};\n  const fields = [\n    row.DisplayName,\n    row.AttributeName,\n    row.Name,\n    row.Prompt,\n    row.AttributeCode\n  ];\n\n  for (let i = 0; i < fields.length; i += 1) {\n    if (fields[i]) {\n      candidates.push(fields[i]);\n    }\n  }\n\n  const knownAliases = {\n    ORA_BU_ID: [\"Business Unit\", \"BU\"],\n    ORA_LEGAL_ENTITY_ID: [\"Legal Entity\", \"LE\"],\n    ORA_PRIMARY_LEDGER_ID: [\"Primary Ledger\", \"Ledger\"],\n    ORA_SHIP_TO_LOCATION_ID: [\"Ship to-Location\", \"Ship To Location\"]\n  };\n  const aliases = knownAliases[dependencyCode] || [];\n  for (let i = 0; i < aliases.length; i += 1) {\n    candidates.push(aliases[i]);\n  }\n\n  const normalized = {};\n  for (let i = 0; i < candidates.length; i += 1) {\n    const key = normalizeKey(candidates[i]);\n    if (key) normalized[key] = true;\n  }\n  return normalized;\n}\n\nfunction hasDependencyInfluence(detail, dependencyCode) {\n  const dependencyNames = getDependencyNameCandidates(dependencyCode);\n  const influences = Array.isArray(detail && detail.influences) ? detail.influences : [];\n\n  for (let i = 0; i < influences.length; i += 1) {\n    const influence = influences[i] || {};\n    const candidates = [\n      influence.attribute,\n      influence.attributeCode,\n      influence.attributeName\n    ];\n\n    for (let j = 0; j < candidates.length; j += 1) {\n      const attributeNorm = normalizeKey(candidates[j]);\n      if (attributeNorm && dependencyNames[attributeNorm]) {\n        return true;\n      }\n    }\n  }\n\n  return false;\n}\n\nfunction addMissingDependencyErrors(policyDetails, attributeDefinitionMap, targetRuleDefinitionMap, errorByDetailId) {\n  for (let i = 0; i < policyDetails.length; i += 1) {\n    const detail = policyDetails[i] || {};\n    const detailId = getDetailId(detail);\n    if (!detailId || errorByDetailId.has(detailId)) {\n      continue;\n    }\n\n    const targetCode = resolveTargetCodeFromDetail(detail, targetRuleDefinitionMap);\n    const targetDefinition = targetCode ? attributeDefinitionMap[targetCode] || {} : {};\n    const dependencyCode = targetDefinition.dependsOn || \"\";\n\n    if (!dependencyCode || hasDependencyInfluence(detail, dependencyCode)) {\n      continue;\n    }\n\n    const target = Array.isArray(detail.targets) ? detail.targets[0] || {} : {};\n    const targetName = target.attribute || humanizeAttributeCode(targetCode) || targetCode;\n    errorByDetailId.set(detailId, \"Missing required dependency \" + humanizeAttributeCode(dependencyCode) + \" for \" + targetName + \".\");\n  }\n}\n\nfunction buildUnresolvedValueMessage(detail) {\n  const messages = [];\n\n  function addResolvedMessages(items, label) {\n    const list = Array.isArray(items) ? items : [];\n    for (let i = 0; i < list.length; i += 1) {\n      const item = list[i] || {};\n      const value = item.value;\n      const hasValue = value !== null && value !== undefined && value !== \"\";\n      const hasValueId = item.valueId !== null && item.valueId !== undefined && item.valueId !== \"\";\n      if (hasValue && !hasValueId) {\n        const attributeName = item.attributeName || item.attribute || item.attributeCode || \"Unknown\";\n        messages.push(\"Value \" + value + \" is invalid for \" + label + \" \" + attributeName + \".\");\n      }\n    }\n  }\n\n  if (detail && Array.isArray(detail.errors) && detail.errors.length > 0) {\n    for (let i = 0; i < detail.errors.length; i += 1) {\n      if (detail.errors[i] && detail.errors[i].message) {\n        messages.push(detail.errors[i].message);\n      }\n    }\n  }\n\n  addResolvedMessages(detail && detail.resolvedInfluences, \"Source\");\n  addResolvedMessages(detail && detail.resolvedTargets, \"Target Attribute\");\n\n  if (messages.length === 0) {\n    const originalInfluences = Array.isArray(detail && detail.influences) ? detail.influences : [];\n    for (let i = 0; i < originalInfluences.length; i += 1) {\n      const source = originalInfluences[i] || {};\n      const value = source.value;\n      const hasValue = value !== null && value !== undefined && value !== \"\";\n      const valueText = String(value || \"\");\n      if (hasValue && /INVALID|FOR_ATTRIBUTE_BUILDER/i.test(valueText)) {\n        const attributeName = source.attributeName || source.attribute || source.attributeCode || \"Unknown\";\n        messages.push(\"Value \" + value + \" is invalid for Source \" + attributeName + \".\");\n      }\n    }\n  }\n\n  if (messages.length === 0) {\n    const originalTargets = Array.isArray(detail && detail.targets) ? detail.targets : [];\n    for (let i = 0; i < originalTargets.length; i += 1) {\n      const target = originalTargets[i] || {};\n      const value = target.value;\n      const hasValue = value !== null && value !== undefined && value !== \"\";\n      if (hasValue) {\n        const attributeName = target.attributeName || target.attribute || target.attributeCode || \"Unknown\";\n        messages.push(\"Value \" + value + \" is invalid for Target Attribute \" + attributeName + \".\");\n      }\n    }\n  }\n\n  if (messages.length > 0) {\n    return messages.join(\" \");\n  }\n\n  return \"Value ID was not resolved for this policy detail.\";\n}\n\nfunction buildSpecificUnresolvedMessage(detail) {\n  const message = buildUnresolvedValueMessage(detail);\n  return message && message !== \"Value ID was not resolved for this policy detail.\"\n    ? message\n    : \"\";\n}\n\nfunction getErrorMessage(detail) {\n  if (detail && detail.errorMessage) {\n    return detail.errorMessage;\n  }\n\n  if (detail && Array.isArray(detail.errors) && detail.errors.length > 0) {\n    return detail.errors\n      .map(error => error.message)\n      .filter(Boolean)\n      .join(\" \");\n  }\n\n  return \"\";\n}\n\nfunction isSuccessfulInsertPart(part) {\n  const payload = part.payload || {};\n  const status =\n    part.status ??\n    part.statusCode ??\n    part.Status ??\n    part.StatusCode ??\n    getPath(part, [\"response\", \"status\"]) ??\n    getPath(part, [\"response\", \"statusCode\"]);\n\n  if (status !== null && status !== undefined && status !== \"\") {\n    const numericStatus = Number(status);\n\n    if (Number.isFinite(numericStatus)) {\n      return numericStatus >= 200 && numericStatus < 300;\n    }\n  }\n\n  if (\n    part.error ||\n    part.errors ||\n    getPath(payload, [\"error\"]) ||\n    getPath(payload, [\"errors\"])\n  ) {\n    return false;\n  }\n\n  return Boolean(\n    getPath(payload, [\"MappingSetValueId\"]) ||\n    getPath(payload, [\"@context\"]) ||\n    getPath(payload, [\"@context\", \"key\"])\n  );\n}\n\nfunction getInsertErrorMessage(part) {\n  const payload = part.payload || {};\n\n  return (\n    getPath(part, [\"error\", \"message\"]) ||\n    getPath(payload, [\"error\", \"message\"]) ||\n    getPath(payload, [\"title\"]) ||\n    getPath(payload, [\"detail\"]) ||\n    part.message ||\n    \"Mapping set value was not published.\"\n  );\n}\n\nfunction cloneInfluencesOrTargets(items) {\n  if (!Array.isArray(items)) {\n    return [];\n  }\n\n  return items.map(item => ({\n    attribute: item.attribute,\n    value: item.value\n  }));\n}\n\nfunction buildFallbackOriginalDetails(validationResult) {\n  const validPolicyDetails = Array.isArray(validationResult.validPolicyDetails)\n    ? validationResult.validPolicyDetails\n    : [];\n\n  const errorPolicyDetails = Array.isArray(validationResult.errorPolicyDetails)\n    ? validationResult.errorPolicyDetails\n    : [];\n\n  return validPolicyDetails.concat(errorPolicyDetails).map(detail => ({\n    detailId: detail.detailId,\n    policyId: detail.policyId,\n    status: \"\",\n    category: detail.category,\n    subCategory: detail.subCategory,\n    priority: detail.priority,\n    errorMessage: \"\",\n    policyDetailStatement: detail.policyDetailStatement,\n    influences: cloneInfluencesOrTargets(detail.influences),\n    targets: cloneInfluencesOrTargets(detail.targets)\n  }));\n}\n\nfunction getReturnPayloadResult(context) {\n  const payload = unwrapOutput(\n    getPath(context, [\"$nodes\", \"RETURNPAYLOAD\", \"$output\", \"result\"])\n  );\n\n  return payload && typeof payload === \"object\" && !Array.isArray(payload)\n    ? payload\n    : {};\n}\n\nfunction buildReturnFinalPayload(context) {\n  const nodes = context.$nodes || {};\n  const variables = context.$variables || {};\n  const returnPayloadResult = getReturnPayloadResult(context);\n  const validationOutput =\n    getPath(nodes, [\"MERGETARGETCHUNKRESULTS\", \"$output\"]) ||\n    getPath(nodes, [\"MERGEPOLICYDETAILSFORMS\", \"$output\"]) ||\n    getPath(nodes, [\"POLICYDETAILSFORMS\", \"$output\"]) ||\n    variables.policyDetailsFormsOutput ||\n    variables.validationOutput ||\n    {};\n\n  const originalPolicyDetailsInput = Array.isArray(variables.policyDetails)\n    ? variables.policyDetails\n    : variables.pInputPayload;\n\n  const validationResult = unwrapOutput(validationOutput);\n  const validPolicyDetails = Array.isArray(validationResult.validPolicyDetails)\n    ? validationResult.validPolicyDetails\n    : [];\n  const errorPolicyDetails = Array.isArray(validationResult.errorPolicyDetails)\n    ? validationResult.errorPolicyDetails\n    : [];\n\n  const sourcePolicyDetails = getOriginalPolicyDetails(originalPolicyDetailsInput);\n  const policyDetailsSource = sourcePolicyDetails.length > 0\n    ? sourcePolicyDetails\n    : buildFallbackOriginalDetails(validationResult);\n\n  const validDetailIds = new Set();\n\n  for (let i = 0; i < validPolicyDetails.length; i += 1) {\n    const detailId = getDetailId(validPolicyDetails[i]);\n\n    if (detailId) {\n      validDetailIds.add(detailId);\n    }\n  }\n\n  const validationErrorByDetailId = new Map();\n  const unresolvedErrorByDetailId = new Map();\n  addMissingDependencyErrors(policyDetailsSource, variables.attributeDefinitionMap || {}, variables.targetRuleDefinitionMap || {}, validationErrorByDetailId);\n\n  function collectSpecificUnresolvedErrors(value) {\n    const unwrapped = unwrapOutput(value);\n\n    if (!unwrapped) {\n      return;\n    }\n\n    if (Array.isArray(unwrapped)) {\n      for (let i = 0; i < unwrapped.length; i += 1) {\n        collectSpecificUnresolvedErrors(unwrapped[i]);\n      }\n      return;\n    }\n\n    if (typeof unwrapped !== \"object\") {\n      return;\n    }\n\n    const rows = [];\n    if (Array.isArray(unwrapped.validPolicyDetails)) rows.push(...unwrapped.validPolicyDetails);\n    if (Array.isArray(unwrapped.errorPolicyDetails)) rows.push(...unwrapped.errorPolicyDetails);\n\n    for (let i = 0; i < rows.length; i += 1) {\n      const detail = rows[i];\n      const detailId = getDetailId(detail);\n      const message = buildSpecificUnresolvedMessage(detail);\n      if (detailId && message && !unresolvedErrorByDetailId.has(detailId)) {\n        unresolvedErrorByDetailId.set(detailId, message);\n      }\n    }\n\n    if (Array.isArray(unwrapped.targetResults)) collectSpecificUnresolvedErrors(unwrapped.targetResults);\n    if (Array.isArray(unwrapped.policyBatchResults)) collectSpecificUnresolvedErrors(unwrapped.policyBatchResults);\n    if (Array.isArray(unwrapped.items)) collectSpecificUnresolvedErrors(unwrapped.items);\n  }\n\n  function collectErrorPolicyDetails(value) {\n    const unwrapped = unwrapOutput(value);\n\n    if (!unwrapped) {\n      return;\n    }\n\n    if (Array.isArray(unwrapped)) {\n      for (let i = 0; i < unwrapped.length; i += 1) {\n        collectErrorPolicyDetails(unwrapped[i]);\n      }\n      return;\n    }\n\n    if (typeof unwrapped !== \"object\") {\n      return;\n    }\n\n    if (Array.isArray(unwrapped.errorPolicyDetails)) {\n      for (let i = 0; i < unwrapped.errorPolicyDetails.length; i += 1) {\n        const detail = unwrapped.errorPolicyDetails[i];\n        const detailId = getDetailId(detail);\n        const message = getErrorMessage(detail);\n\n        if (detailId && message && !validationErrorByDetailId.has(detailId)) {\n          validationErrorByDetailId.set(detailId, message);\n        }\n      }\n    }\n\n    if (Array.isArray(unwrapped.targetResults)) {\n      collectErrorPolicyDetails(unwrapped.targetResults);\n    }\n\n    if (Array.isArray(unwrapped.policyBatchResults)) {\n      collectErrorPolicyDetails(unwrapped.policyBatchResults);\n    }\n\n    if (Array.isArray(unwrapped.items)) {\n      collectErrorPolicyDetails(unwrapped.items);\n    }\n  }\n\n  collectSpecificUnresolvedErrors(validationResult);\n  collectSpecificUnresolvedErrors(getPath(nodes, [\"PROCESS_TARGET_ATTRIBUTE_CHUNKS\", \"$output\"]));\n  collectSpecificUnresolvedErrors(getPath(nodes, [\"MERGETARGETCHUNKRESULTS\", \"$output\"]));\n\n  collectErrorPolicyDetails(validationResult);\n  collectErrorPolicyDetails(getPath(nodes, [\"PROCESS_TARGET_ATTRIBUTE_CHUNKS\", \"$output\"]));\n  collectErrorPolicyDetails(getPath(nodes, [\"MERGETARGETCHUNKRESULTS\", \"$output\"]));\n\n  for (let i = 0; i < errorPolicyDetails.length; i += 1) {\n    const detail = errorPolicyDetails[i];\n    const detailId = getDetailId(detail);\n\n    if (!detailId) {\n      continue;\n    }\n\n    const message = getErrorMessage(detail);\n\n    if (message) {\n      validationErrorByDetailId.set(detailId, message);\n    }\n  }\n\n  const insertParts = [];\n  const insertOutputCandidates = getInsertOutputCandidates(context);\n\n  for (let i = 0; i < insertOutputCandidates.length; i += 1) {\n    appendParts(insertOutputCandidates[i], insertParts);\n  }\n\n  const publishedDetailIds = new Set();\n  const publishErrorByDetailId = new Map();\n  const expectedMappingDetailIds = new Set();\n\n  function collectExpectedMappingDetailIds(value) {\n    const unwrapped = unwrapOutput(value);\n\n    if (!unwrapped) {\n      return;\n    }\n\n    if (Array.isArray(unwrapped)) {\n      for (let i = 0; i < unwrapped.length; i += 1) {\n        collectExpectedMappingDetailIds(unwrapped[i]);\n      }\n      return;\n    }\n\n    if (typeof unwrapped !== \"object\") {\n      return;\n    }\n\n    if (Array.isArray(unwrapped.mappingSetPayloadByTarget)) {\n      collectExpectedMappingDetailIds(unwrapped.mappingSetPayloadByTarget);\n      return;\n    }\n\n    if (Array.isArray(unwrapped.MSPayload)) {\n      for (let i = 0; i < unwrapped.MSPayload.length; i += 1) {\n        const detailId = getDetailId(unwrapped.MSPayload[i]);\n        if (detailId) {\n          expectedMappingDetailIds.add(detailId);\n        }\n      }\n      return;\n    }\n\n    const detailId = getDetailId(unwrapped);\n    if (detailId && (unwrapped.OutputValueId || unwrapped.ValueConstant || unwrapped.Input1SourceValueId)) {\n      expectedMappingDetailIds.add(detailId);\n    }\n  }\n\n  collectExpectedMappingDetailIds(validationResult);\n\n  for (let i = 0; i < insertParts.length; i += 1) {\n    const part = insertParts[i];\n    const detailId = normalize(part.id);\n\n    if (!detailId) {\n      continue;\n    }\n\n    if (isSuccessfulInsertPart(part)) {\n      publishedDetailIds.add(detailId);\n      continue;\n    }\n\n    const errorMessage = getInsertErrorMessage(part);\n    publishErrorByDetailId.set(detailId, errorMessage);\n  }\n\n  const updatedPolicyDetails = policyDetailsSource.map(detail => {\n    const detailId = getDetailId(detail);\n    const updatedDetail = {\n      ...detail\n    };\n\n    if (validationErrorByDetailId.has(detailId)) {\n      updatedDetail.status = \"Publish_Error\";\n      updatedDetail.errorMessage = validationErrorByDetailId.get(detailId);\n      return updatedDetail;\n    }\n\n    if (publishedDetailIds.has(detailId)) {\n      updatedDetail.status = \"Published\";\n      updatedDetail.errorMessage = \"\";\n      return updatedDetail;\n    }\n\n    if (publishErrorByDetailId.has(detailId)) {\n      updatedDetail.status = \"Publish_Error\";\n      updatedDetail.errorMessage = publishErrorByDetailId.get(detailId);\n      return updatedDetail;\n    }\n\n    if (expectedMappingDetailIds.has(detailId)) {\n      updatedDetail.status = \"Published\";\n      updatedDetail.errorMessage = \"\";\n      return updatedDetail;\n    }\n\n    if (validDetailIds.has(detailId)) {\n      updatedDetail.status = \"Publish_Error\";\n      updatedDetail.errorMessage = \"Mapping set value was not published.\";\n      return updatedDetail;\n    }\n\n    updatedDetail.status = \"Publish_Error\";\n    updatedDetail.errorMessage =\n      updatedDetail.errorMessage ||\n      unresolvedErrorByDetailId.get(detailId) ||\n      buildUnresolvedValueMessage(detail);\n\n    return updatedDetail;\n  });\n\n  return {\n    ...returnPayloadResult,\n    policyDetails: updatedPolicyDetails\n  };\n}\n\nreturn buildReturnFinalPayload($context);\n"
