                          "sourceCode": "const buildOutput = $context.$nodes.BUILDATTRIBUTEVALUESMAP.$output || {};\nconst resolvedOutput = $context.$nodes.ATTRIBUTE_VALUES_BUILDER.$output || {};\n\nconst norm = v => String(v ?? \"\").trim().toUpperCase();\nconst quote = v => `'${String(v ?? \"\").replace(/'/g, \"''\")}'`;\n\nfunction parse(v) {\n  if (typeof v !== \"string\") return v;\n  const s = v.trim();\n  if (s[0] !== \"{\" && s[0] !== \"[\") return v;\n  try { return JSON.parse(s); } catch { return v; }\n}\n\nfunction unwrap(v) {\n  v = parse(v);\n  return v?.result ?? v?.body ?? v?.output ?? v ?? {};\n}\n\nconst toArray = v => Array.isArray(v) ? v : Object.values(v || {});\n\nfunction collections(v) {\n  v = unwrap(v);\n  if (Array.isArray(v)) return v.flatMap(collections);\n  return v?.collection || v?.dependentCollection || (v && typeof v === \"object\" ? [v] : []);\n}\n\nconst buildResult = unwrap(buildOutput);\nconst dependentCollection = buildResult.dependentCollection || toArray(buildResult.dependentAttributeValuesMap);\n\nconst resolvedIds = new Map();\n\nfor (const attr of collections(resolvedOutput)) {\n  for (const val of toArray(attr.values)) {\n    if (attr.attributeCode && val.valueId != null) {\n      resolvedIds.set(`${attr.attributeCode}::${norm(val.value)}`, val.valueId);\n    }\n  }\n}\n\nconst resolvedId = (code, value) =>\n  code ? resolvedIds.get(`${code}::${norm(value)}`) || null : null;\n\nconst grouped = new Map();\n\nfor (const attr of dependentCollection) {\n  for (const item of toArray(attr.values)) {\n    const dependsOn = item.dependsOn || attr.dependsOn;\n    const parentDependsOn = item.parentDependsOn || attr.parentDependsOn || null;\n    const dependsOnValueId = item.dependsOnValueId || resolvedId(dependsOn, item.dependsOnValue);\n    const parentDependsOnValueId =\n      item.parentDependsOnValueId || resolvedId(parentDependsOn, item.parentDependsOnValue);\n\n    const key = [\n      attr.attributeCode,\n      dependsOn,\n      dependsOnValueId || norm(item.dependsOnValue),\n      parentDependsOn || \"\",\n      parentDependsOnValueId || norm(item.parentDependsOnValue)\n    ].join(\"::\");\n\n    let group = grouped.get(key);\n\n    if (!group) {\n      group = {\n        attributeCode: attr.attributeCode,\n        attributeName: attr.attributeName,\n        sourceType: attr.sourceType,\n        api: attr.api,\n        param: attr.param,\n        dependsOn,\n        dependsOnName: item.dependsOnName || attr.dependsOnName,\n        dependsOnValue: item.dependsOnValue,\n        dependsOnValueId,\n        parentDependsOn,\n        parentDependsOnName: item.parentDependsOnName || attr.parentDependsOnName || null,\n        parentDependsOnValue: item.parentDependsOnValue || null,\n        parentDependsOnValueId,\n        dependencyDepth: item.dependencyDepth || attr.dependencyDepth || 1,\n        valueList: [],\n        detailIds: new Set()\n      };\n\n      grouped.set(key, group);\n    }\n\n    group.valueList.push(item.value);\n    for (const id of item.detailIds || []) group.detailIds.add(id);\n  }\n}\n\nreturn [...grouped.values()].map(g => ({\n  ...g,\n  detailIds: [...g.detailIds],\n  values: g.valueList.map(quote).join(\",\")\n}));"
