            "name": "Build Lookup Value Index",
            "returnType": "object",
            "sourceCode": "function parse(value) {\n  if (typeof value !== \"string\") return value;\n  const text = value.trim();\n  if (!text || (text[0] !== \"{\" && text[0] !== \"[\")) return value;\n  try { return JSON.parse(text); } catch (e) { return value; }\n}\n\nfunction collectItems(value, output) {\n  value = parse(value);\n  if (value == null) return;\n  if (Array.isArray(value)) {\n    for (let i = 0; i < value.length; i++) collectItems(value[i], output);\n    return;\n  }\n  if (typeof value !== \"object\") return;\n  if (Array.isArray(value.items)) collectItems(value.items, output);\n  if (value.result !== undefined) collectItems(value.result, output);\n  if (value.body !== undefined) collectItems(value.body, output);\n  if (value.output !== undefined) collectItems(value.output, output);\n  if (value.$output !== undefined) collectItems(value.$output, output);\n  if (value.LookupType !== undefined || value.LookupCode !== undefined || value.Meaning !== undefined) {\n    output.push(value);\n  }\n}\n\nfunction compact(value) {\n  return String(value == null ? \"\" : value).trim();\n}\n\nfunction norm(value) {\n  return compact(value).replace(/\\s+/g, \" \").toUpperCase();\n}\n\nfunction addExact(index, lookupType, key, row) {\n  const exactKey = compact(key);\n  if (!lookupType || !exactKey) return;\n  const mapKey = lookupType + \"|\" + exactKey;\n  if (!index.exact[mapKey]) index.exact[mapKey] = row;\n}\n\nfunction addNormalized(index, lookupType, key, row) {\n  const normalizedKey = norm(key);\n  if (!lookupType || !normalizedKey) return;\n  const mapKey = lookupType + \"|\" + normalizedKey;\n  const existing = index.normalized[mapKey];\n  if (!existing) {\n    index.normalized[mapKey] = row;\n    return;\n  }\n  if (existing.LookupCode !== row.LookupCode || existing.Meaning !== row.Meaning) {\n    index.ambiguous[mapKey] = true;\n    delete index.normalized[mapKey];\n  }\n}\n\nconst rows = [];\ncollectItems($context.$nodes.FETCH_REQUIRED_LOOKUP_VALUES.$output, rows);\n\nconst index = { exact: {}, normalized: {}, ambiguous: {}, countsByType: {}, rowCount: 0 };\nfor (let i = 0; i < rows.length; i++) {\n  const source = rows[i] || {};\n  const lookupType = compact(source.LookupType);\n  const lookupCode = compact(source.LookupCode);\n  const meaning = compact(source.Meaning);\n  if (!lookupType || !lookupCode) continue;\n\n  const row = {\n    LookupType: lookupType,\n    LookupCode: lookupCode,\n    Meaning: meaning,\n    Description: compact(source.Description)\n  };\n\n  index.rowCount += 1;\n  index.countsByType[lookupType] = (index.countsByType[lookupType] || 0) + 1;\n\n  addExact(index, lookupType, lookupCode, row);\n  addExact(index, lookupType, meaning, row);\n  addExact(index, lookupType, row.Description, row);\n  addNormalized(index, lookupType, lookupCode, row);\n  addNormalized(index, lookupType, meaning, row);\n  addNormalized(index, lookupType, row.Description, row);\n}\n\nreturn index;"
          },
