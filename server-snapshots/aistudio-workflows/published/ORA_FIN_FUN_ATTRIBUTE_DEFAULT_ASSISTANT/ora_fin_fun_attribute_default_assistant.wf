        {
          "metadata": {
            "name": "Build Omitted Target Cleanup List",
            "returnType": "array",
            "sourceCode": "const splitOutput = $context.$nodes.SPLITPAYLOADBYTARGET?.$output?.result || [];\nconst targetRuleDefinitionMap = $context.$variables.targetRuleDefinitionMap || {};\n\nfunction normalize(value) {\n  return String(value || \"\").trim().toUpperCase();\n}\n\nfunction looseNormalize(value) {\n  return normalize(value).replace(/[^A-Z0-9]+/g, \"\");\n}\n\nfunction humanizeAttributeCode(code) {\n  return String(code || \"\")\n    .replace(/^ORA_/, \"\")\n    .replace(/_(ID|CODE|LOOKUP_CODE|CCID)$/, \"\")\n    .split(\"_\")\n    .filter(Boolean)\n    .map(part => part.charAt(0).toUpperCase() + part.slice(1).toLowerCase())\n    .join(\" \");\n}\n\nfunction getSourceIndex() {\n  try {\n    const output = $context.$nodes.BUILD_ATTRIBUTE_SOURCE_INDEX.$output;\n    return (output && output.result !== undefined ? output.result : output) || {};\n  } catch (e) {\n    return {};\n  }\n}\n\nfunction addPresentTarget(presentTargets, value) {\n  const text = String(value || \"\").trim();\n  if (!text) return;\n  presentTargets[normalize(text)] = true;\n  presentTargets[looseNormalize(text)] = true;\n}\n\nfunction addResolvedPresentTarget(presentTargets, value) {\n  addPresentTarget(presentTargets, value);\n  const text = String(value || \"\").trim();\n  if (!text) return;\n\n  const sourceIndex = getSourceIndex();\n  const byCode = sourceIndex.byCode || {};\n  const byNormalizedName = sourceIndex.byNormalizedName || {};\n  const resolvedCode =\n    byCode[text] ? text :\n      byNormalizedName[normalize(text)] ||\n      byNormalizedName[looseNormalize(text)] ||\n      \"\";\n\n  if (resolvedCode) addPresentTarget(presentTargets, resolvedCode);\n}\n\nconst presentTargets = {};\n\nfor (let i = 0; i < splitOutput.length; i += 1) {\n  const chunk = splitOutput[i] || {};\n  addResolvedPresentTarget(presentTargets, chunk.targetAttributeCode);\n  addResolvedPresentTarget(presentTargets, chunk.targetAttribute);\n\n  const policyDetails = Array.isArray(chunk.policyDetails) ? chunk.policyDetails : [];\n  for (let p = 0; p < policyDetails.length; p += 1) {\n    const targets = Array.isArray(policyDetails[p].targets) ? policyDetails[p].targets : [];\n    for (let t = 0; t < targets.length; t += 1) {\n      const target = targets[t] || {};\n      addResolvedPresentTarget(presentTargets, target.attributeCode || target.code);\n      addResolvedPresentTarget(presentTargets, target.attribute);\n      addResolvedPresentTarget(presentTargets, target.attributeName);\n    }\n  }\n}\n\nconst omittedTargets = [];\n\nfor (const code of Object.keys(targetRuleDefinitionMap)) {\n  const rule = targetRuleDefinitionMap[code] || {};\n  if (rule.enabled === false) continue;\n\n  const targetNames = [\n    code,\n    rule.code,\n    rule.TargetAttributeCode,\n    rule.targetAttributeCode,\n    rule.TargetName,\n    rule.name,\n    humanizeAttributeCode(code)\n  ];\n\n  let isPresent = false;\n  for (const value of targetNames) {\n    if (presentTargets[normalize(value)] || presentTargets[looseNormalize(value)]) {\n      isPresent = true;\n      break;\n    }\n  }\n\n  if (!isPresent) {\n    omittedTargets.push({\n      TargetAttributeCode: rule.code || code,\n      TargetName: rule.TargetName || rule.name || humanizeAttributeCode(code)\n    });\n  }\n}\n\nreturn omittedTargets;"
