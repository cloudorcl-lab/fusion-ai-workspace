                            "sourceCode": "function parse(value) {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  const text = value.trim();\n\n  if (!text || (text[0] !== \"{\" && text[0] !== \"[\")) {\n    return value;\n  }\n\n  try {\n    return JSON.parse(text);\n  } catch (e) {\n    return value;\n  }\n}\n\nfunction unwrap(output) {\n  let current = output;\n\n  for (let depth = 0; depth < 8; depth += 1) {\n    current = parse(current);\n\n    if (current && typeof current === \"object\" && current.result !== undefined) {\n      current = current.result;\n      continue;\n    }\n\n    if (current && typeof current === \"object\" && current.output !== undefined) {\n      current = current.output;\n      continue;\n    }\n\n    return current;\n  }\n\n  return current;\n}\n\nfunction appendParts(output, parts) {\n  const value = unwrap(output);\n\n  if (!value) {\n    return;\n  }\n\n  if (Array.isArray(value)) {\n    for (const item of value) {\n      appendParts(item, parts);\n    }\n    return;\n  }\n\n  if (typeof value !== \"object\") {\n    return;\n  }\n\n  if (Array.isArray(value.parts)) {\n    for (const part of value.parts) {\n      parts.push(part);\n    }\n    return;\n  }\n\n  if (value.id && value.payload) {\n    parts.push(value);\n  }\n}\n\nconst buildOutput = unwrap($context.$nodes.CREATE_ATTRIBUTE_BUILDER_MAPPINGS.BUILDMAPPINGS.$output) || {};\nconst parts = [];\n\nappendParts($context.$nodes.CREATE_ATTRIBUTE_BUILDER_MAPPINGS.CREATE_ATTRIBUTE_BUILDER_MAPPINGSBATCH.$output, parts);\n\nreturn {\n  parts,\n  replaceSummary: {\n    ...(buildOutput.replaceSummary || {}),\n    insertedCount: parts.length\n  }\n};"
