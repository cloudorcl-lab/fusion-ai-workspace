                                    "name": "returnDepValues",
                                    "returnType": "object",
                                    "sourceCode": "const payload = JSON.parse(JSON.stringify($context.$nodes.DEPENDENT_ATTRIBUTE_VALUE_BUILDER.$currentItem || {}));\nfunction parse(value) {\n  if (typeof value !== \"string\") return value;\n  const text = value.trim();\n  if (!text || (text[0] !== \"{\" && text[0] !== \"[\")) return value;\n  try { return JSON.parse(text); } catch (e) { return value; }\n}\nfunction norm(value) { return String(value == null ? \"\" : value).trim().toUpperCase(); }\nfunction collectItems(value, output) {\n  value = parse(value);\n  if (value == null) return;\n  if (Array.isArray(value)) { for (let i = 0; i < value.length; i++) collectItems(value[i], output); return; }\n  if (typeof value !== \"object\") return;\n  if (Array.isArray(value.items)) collectItems(value.items, output);\n  if (value.result !== undefined) collectItems(value.result, output);\n  if (value.$output !== undefined) collectItems(value.$output, output);\n  if (value.Value !== undefined || value.ValueId !== undefined) output.push(value);\n}\nconst items = [];\ncollectItems($context.$nodes.DEPENDENT_ATTRIBUTE_VALUE_BUILDER.GETDEPVALUES.$output || [], items);\nconst byName = {};\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i] || {};\n  const name = norm(item.Value);\n  if (name && item.ValueId !== undefined && item.ValueId !== null && item.ValueId !== \"\" && byName[name] === undefined) byName[name] = item.ValueId;\n}\nconst sourceValues = payload.valueList || payload.values || [];\nconst rawValues = Array.isArray(sourceValues) ? sourceValues : String(sourceValues || \"\").split(\",\");\nconst resolvedValues = [];\nconst valueIdMap = {};\nfor (let i = 0; i < rawValues.length; i++) {\n  const rawEntry = rawValues[i];\n  const rawValue = typeof rawEntry === \"object\" ? rawEntry.value : rawEntry;\n  const cleanValue = String(rawValue == null ? \"\" : rawValue).replace(/^'+|'+$/g, \"\");\n  if (!norm(cleanValue)) continue;\n  const resolvedId = byName[norm(cleanValue)] || null;\n  resolvedValues.push({ value: cleanValue, valueId: resolvedId });\n  if (resolvedId) valueIdMap[cleanValue] = resolvedId;\n}\npayload.values = resolvedValues;\npayload.valueIdMap = valueIdMap;\nreturn payload;"
