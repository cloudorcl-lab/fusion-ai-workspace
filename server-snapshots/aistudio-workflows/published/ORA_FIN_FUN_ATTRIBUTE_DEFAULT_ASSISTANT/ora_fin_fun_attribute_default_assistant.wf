                {
                  "metadata": {
                    "name": "Chunk Target Policy Details",
                    "sourceCode": "const currentTarget = $context.$nodes.PROCESS_TARGET_ATTRIBUTE_CHUNKS.$currentItem || {};\nconst policyDetails = Array.isArray(currentTarget.policyDetails) ? currentTarget.policyDetails : [];\nconst chunkSize = 100;\nconst chunks = [];\n\nfor (let i = 0; i < policyDetails.length; i += chunkSize) {\n  chunks.push({\n    chunkIndex: chunks.length,\n    targetAttribute: currentTarget.targetAttribute || null,\n    targetAttributeCode: currentTarget.targetAttributeCode || null,\n    targetGroupIndex: currentTarget.targetGroupIndex ?? 0,\n    policyChunkIndex: chunks.length,\n    policyDetails: policyDetails.slice(i, i + chunkSize)\n  });\n}\n\nreturn chunks;",
                    "returnType": "array"
                  },
                  "outcomes": {
                    "success": "1900000000400"
                  },
                  "diagram": {
                    "x": 8945,
                    "y": 11562
                  },
                  "code": "CHUNK_TARGET_POLICY_DETAILS",
                  "id": "1900000000401",
                  "inputs": [],
                  "type": "CODE",
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "metadata": {
                    "name": "Merge Target Policy Batches",
                    "sourceCode": "function safeGet(fn) { try { return fn(); } catch (e) { return null; } }\nfunction parse(value) {\n  if (typeof value !== \"string\") return value;\n  const text = value.trim();\n  if (!text || (text[0] !== \"{\" && text[0] !== \"[\")) return value;\n  try { return JSON.parse(text); } catch (e) { return value; }\n}\n\nfunction unwrap(value) {\n  value = parse(value);\n  if (value && typeof value === \"object\" && value.result !== undefined) return unwrap(value.result);\n  if (value && typeof value === \"object\" && value.output !== undefined) return unwrap(value.output);\n  if (value && typeof value === \"object\" && value.body !== undefined) return unwrap(value.body);\n  return value;\n}\n\nfunction appendArray(target, value) {\n  const unwrapped = unwrap(value);\n  if (!Array.isArray(unwrapped)) return;\n  for (let i = 0; i < unwrapped.length; i += 1) target.push(unwrapped[i]);\n}\n\nfunction scan(value, state) {\n  const unwrapped = unwrap(value);\n  if (!unwrapped) return;\n\n  if (Array.isArray(unwrapped)) {\n    for (let i = 0; i < unwrapped.length; i += 1) scan(unwrapped[i], state);\n    return;\n  }\n\n  if (typeof unwrapped !== \"object\") return;\n\n  appendArray(state.validPolicyDetails, unwrapped.validPolicyDetails);\n  appendArray(state.errorPolicyDetails, unwrapped.errorPolicyDetails);\n\n  const targets = Array.isArray(unwrapped.mappingSetPayloadByTarget)\n    ? unwrapped.mappingSetPayloadByTarget\n    : [];\n\n  for (let i = 0; i < targets.length; i += 1) {\n    const target = targets[i] || {};\n    const targetCode = target.TargetAttributeCode || target.MappingSetCode || \"UNKNOWN\";\n    if (!state.mappingSetPayloadByTarget[targetCode]) {\n      state.mappingSetPayloadByTarget[targetCode] = {\n        ...target,\n        TargetName: target.TargetName || null,\n        TargetAttributeCode: target.TargetAttributeCode || null,\n        MappingSetCode: target.MappingSetCode || null,\n        MSPayload: []\n      };\n    }\n    const rows = Array.isArray(target.MSPayload) ? target.MSPayload : [];\n    for (let r = 0; r < rows.length; r += 1) {\n      state.mappingSetPayloadByTarget[targetCode].MSPayload.push(rows[r]);\n    }\n  }\n\n  const keys = Object.keys(unwrapped);\n  for (let i = 0; i < keys.length; i += 1) {\n    const key = keys[i];\n    if (key === \"validPolicyDetails\" || key === \"errorPolicyDetails\" || key === \"mappingSetPayloadByTarget\") continue;\n    const child = unwrapped[key];\n    if (child && typeof child === \"object\") scan(child, state);\n  }\n}\n\nconst state = {\n  validPolicyDetails: [],\n  errorPolicyDetails: [],\n  mappingSetPayloadByTarget: {}\n};\n\nscan(\n  safeGet(() => $context.$nodes.PROCESS_TARGET_POLICY_BATCHES.$output) ||\n  safeGet(() => $context.$nodes.PROCESS_TARGET_ATTRIBUTE_CHUNKS.PROCESS_TARGET_POLICY_BATCHES.$output) ||\n  {},\n  state\n);\n\nfunction dedupeDetails(rows) {\n  const out = [];\n  const seen = {};\n  for (const row of rows || []) {\n    const key = String(row && (row.detailId || row.DetailId || row.id) || \"\");\n    if (!key || seen[key]) continue;\n    seen[key] = true;\n    out.push(row);\n  }\n  return out;\n}\n\nfunction dedupeMappingRows(rows) {\n  const out = [];\n  const seen = {};\n  for (const row of rows || []) {\n    const key = String(row && (row.detailId || row.DetailId || row.id || [\n      row.InputValue1, row.InputValue2, row.InputValue3, row.InputValue4, row.InputValue5,\n      row.InputValue6, row.InputValue7, row.InputValue8, row.InputValue9, row.InputValue10,\n      row.OutputValue || row.TargetValue\n    ].join(\"|\")));\n    if (!key || seen[key]) continue;\n    seen[key] = true;\n    out.push(row);\n  }\n  return out;\n}\n\nconst mappingSetPayloadByTarget = Object.values(state.mappingSetPayloadByTarget);\nfor (const target of mappingSetPayloadByTarget) {\n  target.MSPayload = dedupeMappingRows(target.MSPayload);\n}\n\nfunction normalizeErrorStatuses(rows) {\n  const out = [];\n  for (const row of rows || []) {\n    if (row && typeof row === \"object\") {\n      out.push({ ...row, status: \"Publish_Error\" });\n    } else {\n      out.push(row);\n    }\n  }\n  return out;\n}\n\nreturn {\n  validPolicyDetails: dedupeDetails(state.validPolicyDetails),\n  errorPolicyDetails: normalizeErrorStatuses(dedupeDetails(state.errorPolicyDetails)),\n  mappingSetPayloadByTarget\n};",
                    "returnType": "object"
                  },
                  "outcomes": {
                    "success": "1900000000502"
                  },
                  "diagram": {
                    "x": 8945,
                    "y": 17988
                  },
                  "code": "MERGETARGETPOLICYBATCHES",
                  "id": "1900000000404",
                  "inputs": [],
                  "type": "CODE",
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "metadata": {
                    "name": "Build Target Rule Definition",
                    "returnType": "object",
                    "sourceCode": "const currentTarget = $context.$nodes.PROCESS_TARGET_ATTRIBUTE_CHUNKS.$currentItem || {};\nconst targetRuleDefinitionMap = $context.$variables.targetRuleDefinitionMap || {};\nconst attributeDefinitionMap = $context.$variables.attributeDefinitionMap || {};\n\nfunction getSourceIndex() {\n  try {\n    const output = $context.$nodes.BUILD_ATTRIBUTE_SOURCE_INDEX.$output;\n    return (output && output.result !== undefined ? output.result : output) || {};\n  } catch (e) {\n    return {};\n  }\n}\n\nfunction looseNormalizeName(value) {\n  return String(value || \"\").trim().toUpperCase().replace(/[^A-Z0-9]+/g, \"\");\n}\n\nfunction getSourceIndexRow(attributeCode) {\n  const index = getSourceIndex();\n  return (index.byCode || {})[attributeCode] || {};\n}\n\nfunction getSourceIndexName(attributeCode) {\n  const row = getSourceIndexRow(attributeCode);\n  return row.DisplayName || row.AttributeName || row.Name || row.Prompt || row.AttributeCode || \"\";\n}\n\nfunction resolveCodeFromSourceIndex(value) {\n  const text = String(value || \"\").trim();\n  if (!text) return null;\n  const index = getSourceIndex();\n  const byCode = index.byCode || {};\n  const byName = index.byNormalizedName || {};\n  if (byCode[text]) return text;\n  return byName[normalize(text)] || byName[looseNormalizeName(text)] || null;\n}\n\nfunction normalize(value) {\n  return String(value || \"\").trim().toUpperCase();\n}\n\nconst ruleLookup = {};\nfor (const code of Object.keys(targetRuleDefinitionMap)) {\n  const rule = targetRuleDefinitionMap[code] || {};\n  ruleLookup[normalize(code)] = code;\n  ruleLookup[normalize(rule.code)] = code;\n  }\n\nconst candidates = [];\n\nfunction addCandidate(value) {\n  const text = String(value || \"\").trim();\n  if (text) candidates.push(text);\n}\n\naddCandidate(currentTarget.targetAttributeCode);\naddCandidate(currentTarget.targetAttribute);\n\nconst policyDetails = Array.isArray(currentTarget.policyDetails) ? currentTarget.policyDetails : [];\nfor (let i = 0; i < policyDetails.length && candidates.length === 0; i += 1) {\n  const targets = Array.isArray(policyDetails[i].targets) ? policyDetails[i].targets : [];\n  for (let t = 0; t < targets.length; t += 1) {\n    addCandidate(targets[t].attributeCode || targets[t].code || targets[t].attribute || targets[t].attributeName);\n  }\n}\n\nlet resolvedCode = null;\nfor (let i = 0; i < candidates.length; i += 1) {\n  const normalizedCandidate = normalize(candidates[i]);\n  resolvedCode = ruleLookup[normalizedCandidate] || resolveCodeFromSourceIndex(candidates[i]);\n  if (resolvedCode) break;\n}\n\nconst rule = resolvedCode ? targetRuleDefinitionMap[resolvedCode] : null;\n\nif (!rule || rule.enabled === false) {\n  throw new Error(\"No enabled target rule definition was found for the current target attribute.\");\n}\n\nconst targetDefinition = attributeDefinitionMap[resolvedCode] || {};\nreturn {\n  ...rule,\n  valueset: rule.valueset || rule.valueSet || targetDefinition.param || targetDefinition.valueSet || \"\",\n  targetType: rule.targetType || (targetDefinition.sourceType ? String(targetDefinition.sourceType).replace(\"_\", \"\") : \"\")\n};"
                  },
                  "outcomes": {
                    "success": "1900000000143"
                  },
                  "diagram": {
                    "x": 5510,
                    "y": 11562
                  },
                  "code": "BUILDTARGETRULEDEFINITIONS",
                  "id": "1900000000085",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE",
                  "sourceCode": "const currentTargetChunk = $context.$nodes.PROCESS_TARGET_ATTRIBUTE_CHUNKS.$currentItem || {};\nconst validPolicyDetails = currentTargetChunk.validPolicyDetails || [];\nconst targetRuleDefinitionMap = $context.$variables.targetRuleDefinitionMap || {};\n\nfunction normalize(value) {\n  return String(value || \"\").trim().toUpperCase();\n}\n\nconst ruleLookup = {};\n\nfor (const code of Object.keys(targetRuleDefinitionMap)) {\n  const rule = targetRuleDefinitionMap[code] || {};\n  ruleLookup[normalize(code)] = code;\n  ruleLookup[normalize(rule.code)] = code;\n  }\n\nconst targetCodes = [];\nconst seen = {};\n\nfunction addTargetCode(value) {\n  const resolvedCode = ruleLookup[normalize(value)];\n\n  if (!resolvedCode || seen[resolvedCode]) {\n    return;\n  }\n\n  seen[resolvedCode] = true;\n  targetCodes.push(resolvedCode);\n}\n\nfor (const detail of validPolicyDetails) {\n  const resolvedTargets = Array.isArray(detail.resolvedTargets) ? detail.resolvedTargets : [];\n  const targets = Array.isArray(detail.targets) ? detail.targets : [];\n\n  for (const target of resolvedTargets) {\n    addTargetCode(target.attributeCode || target.code || target.attribute || target.attributeName);\n  }\n\n  if (resolvedTargets.length === 0) {\n    for (const target of targets) {\n      addTargetCode(target.attributeCode || target.code || target.attribute || target.attributeName);\n    }\n  }\n}\n\nreturn targetCodes\n  .map(code => targetRuleDefinitionMap[code])\n  .filter(rule => rule && rule.enabled !== false);"
                },
                {
