                                    "sourceCode": "const payload = JSON.parse(JSON.stringify($context.$nodes.ATTRIBUTE_VALUES_BUILDER.$currentItem || {}));\nconst restOutput = $context.$nodes.ATTRIBUTE_VALUES_BUILDER.GETDELIVERYCHANNELDETAILS.$output || [];\nfunction parse(value) { if (typeof value !== \"string\") return value; const text = value.trim(); if (!text || (text[0] !== \"{\" && text[0] !== \"[\")) return value; try { return JSON.parse(text); } catch (e) { return value; } }\nfunction compact(value) { return String(value == null ? \"\" : value).trim(); }\nfunction norm(value) { return compact(value).replace(/\\s+/g, \" \").toUpperCase(); }\nfunction collectItems(value, output) { value = parse(value); if (value == null) return; if (Array.isArray(value)) { for (let i = 0; i < value.length; i++) collectItems(value[i], output); return; } if (typeof value !== \"object\") return; if (Array.isArray(value.items)) collectItems(value.items, output); if (value.result !== undefined) collectItems(value.result, output); if (value.$output !== undefined) collectItems(value.$output, output); if (value.PaymentCodeName !== undefined || value.PaymentCode !== undefined) output.push(value); }\nconst items = [];\ncollectItems(restOutput, items);\nconst byName = {};\nfor (let i = 0; i < items.length; i++) { const item = items[i] || {}; const name = norm(item.PaymentCodeName); const resolvedId = item.PaymentCode; if (name && resolvedId !== undefined && resolvedId !== null && resolvedId !== \"\" && byName[name] === undefined) byName[name] = resolvedId; }\nconst values = Array.isArray(payload.values) ? payload.values : Object.values(payload.values || {});\nfor (let i = 0; i < values.length; i++) { const entry = values[i] || {}; if (entry.valueId !== undefined && entry.valueId !== null && entry.valueId !== \"\") continue; const rawValue = compact(entry.value); const resolvedId = byName[norm(rawValue)]; if (resolvedId !== undefined && resolvedId !== null && resolvedId !== \"\") entry.valueId = resolvedId; else entry.valueResolutionError = \"Delivery Channel value \" + rawValue + \" was not found.\"; }\nreturn payload;"
