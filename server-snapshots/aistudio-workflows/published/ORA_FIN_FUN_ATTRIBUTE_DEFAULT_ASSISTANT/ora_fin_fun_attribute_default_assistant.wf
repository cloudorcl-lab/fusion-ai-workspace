        {
          "metadata": {
            "name": "Split Payload By Target Attribute",
            "returnType": "array",
            "sourceCode": "const details = Array.isArray($context.$variables.policyDetails) ? $context.$variables.policyDetails : [];\nconst groups = {};\nconst order = [];\n\nfunction targetKey(detail) {\n  const targets = Array.isArray(detail.targets) ? detail.targets : [];\n  if (targets.length === 0) return \"NO_TARGET\";\n  return targets.map(target => String(target.attribute || \"\").trim()).filter(Boolean).sort().join(\"|\") || \"NO_TARGET\";\n}\n\nfor (let i = 0; i < details.length; i++) {\n  const detail = details[i];\n  const key = targetKey(detail);\n  if (!groups[key]) {\n    groups[key] = [];\n    order.push(key);\n  }\n  groups[key].push(detail);\n}\n\nconst chunks = [];\nfor (let g = 0; g < order.length; g++) {\n  const targetAttribute = order[g];\n  chunks.push({\n    chunkIndex: chunks.length,\n    targetAttribute,\n    targetGroupIndex: g,\n    policyChunkIndex: 0,\n    policyDetails: groups[targetAttribute] || []\n  });\n}\n\nreturn chunks;"
          },
          "outcomes": {
            "success": "1900000002002"
          },
          "code": "SPLITPAYLOADBYTARGET",
          "id": "1900000000001",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Build Attribute Metadata Request",
            "returnType": "object",
            "sourceCode": "function parse(value) {\n  if (typeof value !== \"string\") return value;\n  const text = value.trim();\n  if (!text || (text[0] !== \"{\" && text[0] !== \"[\")) return value;\n  try { return JSON.parse(text); } catch (e) { return value; }\n}\n\nfunction asObject(value) {\n  value = parse(value);\n  return value && typeof value === \"object\" && !Array.isArray(value) ? value : {};\n}\n\nfunction normalize(value) {\n  return String(value == null ? \"\" : value).trim().replace(/\\s+/g, \" \").toUpperCase();\n}\n\nfunction addUnique(array, seen, value) {\n  const text = String(value == null ? \"\" : value).trim();\n  if (!text) return;\n  const key = normalize(text);\n  if (seen[key]) return;\n  seen[key] = true;\n  array.push(text);\n}\n\nfunction addAttribute(code) {\n  addUnique(attributeCodes, attributeSeen, code);\n}\n\nfunction addLookupType(value) {\n  addUnique(lookupTypes, lookupSeen, value);\n}\n\nfunction visitDefinition(code, definition) {\n  addAttribute(code);\n  if (!definition || typeof definition !== \"object\") return;\n  addAttribute(definition.code);\n  addAttribute(definition.dependsOn);\n  const sourceType = normalize(definition.sourceType || definition.callType);\n  const apiName = normalize(definition.apiName || definition.api);\n  if (sourceType === \"LOOKUP\" || sourceType === \"LOOKUPTYPE\" || apiName === \"GETLOOKUPVALUES\") {\n    addLookupType(definition.lookupType || definition.sourceTypeVal || definition.param || definition.apiParam);\n  }\n}\n\nconst attributeDefinitionMap = asObject($context.$variables.attributeDefinitionMap);\nconst targetRuleDefinitionMap = asObject($context.$variables.targetRuleDefinitionMap);\nconst attributeCodes = [];\nconst attributeSeen = {};\nconst lookupTypes = [];\nconst lookupSeen = {};\n\nfor (const code of Object.keys(targetRuleDefinitionMap)) {\n  const rule = targetRuleDefinitionMap[code] || {};\n  if (rule.enabled === false) continue;\n  visitDefinition(code, attributeDefinitionMap[code] || rule);\n  addAttribute(rule.code);\n  const influencers = Array.isArray(rule.allowedInfluencers) ? rule.allowedInfluencers : [];\n  for (const item of influencers) {\n    if (typeof item === \"string\") {\n      visitDefinition(item, attributeDefinitionMap[item]);\n      continue;\n    }\n    const influencerCode = item && item.code;\n    visitDefinition(influencerCode, attributeDefinitionMap[influencerCode] || item);\n    addLookupType(item && item.lookupType);\n    if (normalize(item && item.sourceType) === \"LOOKUP\") addLookupType(item && item.sourceTypeVal);\n  }\n}\n\nfor (const code of Object.keys(attributeDefinitionMap)) {\n  const definition = attributeDefinitionMap[code] || {};\n  if (definition.dependsOn && attributeSeen[normalize(definition.dependsOn)]) {\n    visitDefinition(definition.dependsOn, attributeDefinitionMap[definition.dependsOn]);\n  }\n}\n\nfunction quoteSql(value) {\n  return \"'\" + String(value).replace(/'/g, \"''\") + \"'\";\n}\n\nreturn {\n  attributeCodes,\n  lookupTypes,\n  lookupTypeSqlList: lookupTypes.length ? \"(\" + lookupTypes.map(quoteSql).join(\",\") + \")\" : \"('__NO_ATTRIBUTE_BUILDER_LOOKUPS__')\"\n};"
          },
          "outcomes": {
            "success": "1900000000803"
          },
          "code": "BUILD_ATTRIBUTE_METADATA_REQUEST",
