                          "sourceCode": "const validationOutput = $context.$nodes.POLICYDETAILSFORMS.$currentItem || $context.$nodes.PROCESS_TARGET_ATTRIBUTE_CHUNKS.$currentItem || {};\nconst validPolicyDetails = Array.isArray(validationOutput.validPolicyDetails)\n  ? validationOutput.validPolicyDetails\n  : [];\nconst errorPolicyDetails = Array.isArray(validationOutput.errorPolicyDetails)\n  ? validationOutput.errorPolicyDetails\n  : [];\nconst chunkSize = 100;\nconst chunks = [];\n\nfor (let i = 0; i < validPolicyDetails.length; i += chunkSize) {\n  chunks.push({\n    chunkIndex: chunks.length,\n    validPolicyDetails: validPolicyDetails.slice(i, i + chunkSize),\n    errorPolicyDetails: chunks.length === 0 ? errorPolicyDetails : []\n  });\n}\n\nif (chunks.length === 0) {\n  chunks.push({\n    chunkIndex: 0,\n    validPolicyDetails: [],\n    errorPolicyDetails\n  });\n}\n\nreturn chunks;",
