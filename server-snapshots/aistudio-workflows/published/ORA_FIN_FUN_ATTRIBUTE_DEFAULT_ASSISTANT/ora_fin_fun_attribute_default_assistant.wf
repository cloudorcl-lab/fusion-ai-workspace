                                {
                                  "metadata": {
                                    "name": "policyDetailsFormsChunk",
                                    "returnType": "object",
                                    "sourceCode": "function safeGet(fn) { try { return fn(); } catch (e) { return null; } }\nconst validationOutput =\n  safeGet(() => $context.$nodes.POLICYDETAILSFORMS.$currentItem) ||\n  safeGet(() => $context.$nodes.VALIDATE_RULE_DEFINITIONS.$output.result) ||\n  safeGet(() => $context.$nodes.PROCESS_TARGET_POLICY_BATCHES.VALIDATE_RULE_DEFINITIONS.$output.result) ||\n  safeGet(() => $context.$nodes.PROCESS_TARGET_ATTRIBUTE_CHUNKS.PROCESS_TARGET_POLICY_BATCHES.VALIDATE_RULE_DEFINITIONS.$output.result) ||\n  {};\n\nconst independentResolutionOutput =\n  $context.$nodes.ATTRIBUTE_VALUES_BUILDER.$output || {};\n\nconst dependentResolutionOutput =\n  $context.$nodes.DEPENDENT_ATTRIBUTE_VALUE_BUILDER.$output || {};\n\nconst targetRuleDefinitionMap =\n  $context.$variables.targetRuleDefinitionMap || {};\n\nconst attributeDefinitionMap =\n  $context.$variables.attributeDefinitionMap || {};\n\nconst MAX_INPUTS = 10;\n\nfunction parse(value) {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  const text = value.trim();\n\n  if (!text || (text[0] !== \"{\" && text[0] !== \"[\")) {\n    return value;\n  }\n\n  try {\n    return JSON.parse(text);\n  } catch (e) {\n    return value;\n  }\n}\n\nfunction unwrapOutput(output) {\n  output = parse(output);\n\n  if (Array.isArray(output)) {\n    return output\n      .flatMap(item => {\n        const unwrapped = unwrapOutput(item);\n        return Array.isArray(unwrapped) ? unwrapped : [unwrapped];\n      })\n      .filter(Boolean);\n  }\n\n  const nested = output?.result ?? output?.body ?? output?.output;\n\n  return nested === undefined\n    ? (output ?? {})\n    : unwrapOutput(nested);\n}\n\nconst normalizeCache = {};\n\nfunction getSourceIndex() {\n  try {\n    const output = $context.$nodes.BUILD_ATTRIBUTE_SOURCE_INDEX.$output;\n    return (output && output.result !== undefined ? output.result : output) || {};\n  } catch (e) {\n    return {};\n  }\n}\n\nfunction looseNormalizeName(value) {\n  return String(value || \"\").trim().toUpperCase().replace(/[^A-Z0-9]+/g, \"\");\n}\n\nfunction getSourceIndexRow(attributeCode) {\n  const index = getSourceIndex();\n  return (index.byCode || {})[attributeCode] || {};\n}\n\nfunction getSourceIndexName(attributeCode) {\n  const row = getSourceIndexRow(attributeCode);\n  return row.DisplayName || row.AttributeName || row.Name || row.Prompt || row.AttributeCode || \"\";\n}\n\nfunction resolveCodeFromSourceIndex(value) {\n  const text = String(value || \"\").trim();\n  if (!text) return null;\n  const index = getSourceIndex();\n  const byCode = index.byCode || {};\n  const byName = index.byNormalizedName || {};\n  if (byCode[text]) return text;\n  return byName[normalize(text)] || byName[looseNormalizeName(text)] || null;\n}\n\nfunction normalize(value) {\n  const raw = String(value || \"\");\n\n  if (normalizeCache[raw] !== undefined) {\n    return normalizeCache[raw];\n  }\n\n  const normalized = raw.trim().toUpperCase();\n  normalizeCache[raw] = normalized;\n  return normalized;\n}\n\nfunction toArray(value) {\n  return Array.isArray(value) ? value : [];\n}\n\nfunction mergeIndependentMaps(input) {\n  const merged = {};\n\n  for (const attr of toArray(input)) {\n    if (!attr?.attributeCode) {\n      continue;\n    }\n\n    const code = attr.attributeCode;\n\n    merged[code] = {\n      ...attr,\n      values: {}\n    };\n\n    for (const val of toArray(attr.values)) {\n      if (val?.value !== null && val?.value !== undefined) {\n        merged[code].values[normalize(val.value)] = val;\n      }\n    }\n  }\n\n  return merged;\n}\n\nfunction normalizeDependentGroups(input) {\n  return toArray(input).filter(item => item?.attributeCode);\n}\n\nfunction createDependentLookup(dependentGroups) {\n  const byAttributeDetailValue = {};\n  const groupsByAttribute = {};\n\n  for (const group of dependentGroups) {\n    if (!group || !group.attributeCode) {\n      continue;\n    }\n\n    const attributeCode = group.attributeCode;\n    const normalizedValueIdMap = {};\n    const valueIdMap = group.valueIdMap || {};\n\n    for (const rawValue of Object.keys(valueIdMap)) {\n      normalizedValueIdMap[normalize(rawValue)] = valueIdMap[rawValue];\n    }\n\n    group.normalizedValueIdMap = normalizedValueIdMap;\n\n    if (!groupsByAttribute[attributeCode]) {\n      groupsByAttribute[attributeCode] = [];\n    }\n\n    groupsByAttribute[attributeCode].push(group);\n\n    const detailIds = Array.isArray(group.detailIds) ? group.detailIds : [];\n\n    for (const detailId of detailIds) {\n      for (const normalizedValue of Object.keys(normalizedValueIdMap)) {\n        byAttributeDetailValue[\n          attributeCode + \"|\" + detailId + \"|\" + normalizedValue\n        ] = normalizedValueIdMap[normalizedValue];\n      }\n    }\n  }\n\n  return {\n    byAttributeDetailValue,\n    groupsByAttribute\n  };\n}\n\nfunction createDetailAttributeValueMap(detail) {\n  const valuesByAttribute = {};\n\n  for (const item of detail.resolvedInfluences || []) {\n    if (item.attributeCode && valuesByAttribute[item.attributeCode] === undefined) {\n      valuesByAttribute[item.attributeCode] = item.value;\n    }\n  }\n\n  for (const item of detail.resolvedTargets || []) {\n    if (item.attributeCode && valuesByAttribute[item.attributeCode] === undefined) {\n      valuesByAttribute[item.attributeCode] = item.value;\n    }\n  }\n\n  return valuesByAttribute;\n}\n\nfunction getAttributeName(attributeCode) {\n  return getSourceIndexName(attributeCode) || attributeCode;\n}\n\nfunction getIndependentValueId(independentMap, attributeCode, value) {\n  if (!attributeCode) {\n    return null;\n  }\n\n  const attributeData = independentMap[attributeCode];\n\n  if (!attributeData || !attributeData.values) {\n    return null;\n  }\n\n  const key = normalize(value);\n  const item = attributeData.values[key];\n\n  return item?.valueId || null;\n}\n\nfunction findResolvedItem(detail, sectionName, originalItem, index) {\n  const resolvedList =\n    sectionName === \"influences\"\n      ? detail.resolvedInfluences || []\n      : detail.resolvedTargets || [];\n\n  if (resolvedList[index]) {\n    return resolvedList[index];\n  }\n\n  for (const resolved of resolvedList) {\n    if (\n      normalize(resolved.attribute) === normalize(originalItem.attribute) ||\n      normalize(resolved.attributeName) === normalize(originalItem.attribute) ||\n      normalize(resolved.attributeCode) === normalize(originalItem.attribute)\n    ) {\n      return resolved;\n    }\n  }\n\n  return null;\n}\n\nfunction getDependentValueId(dependentLookup, detail, detailAttributeValues, attributeCode, value) {\n  const requestedValue = normalize(value);\n  const directKey = attributeCode + \"|\" + detail.detailId + \"|\" + requestedValue;\n  const directValueId = dependentLookup.byAttributeDetailValue[directKey];\n\n  if (directValueId) {\n    return directValueId;\n  }\n\n  const matchingGroups = dependentLookup.groupsByAttribute[attributeCode] || [];\n\n  for (const group of matchingGroups) {\n    const dependsOn = group.dependsOn;\n    const dependsOnValueInDetail = detailAttributeValues[dependsOn];\n\n    if (\n      dependsOn &&\n      dependsOnValueInDetail &&\n      normalize(dependsOnValueInDetail) !== normalize(group.dependsOnValue)\n    ) {\n      continue;\n    }\n\n    const parentDependsOn = group.parentDependsOn;\n\n    if (parentDependsOn) {\n      const parentValueInDetail = detailAttributeValues[parentDependsOn];\n\n      if (\n        parentValueInDetail &&\n        normalize(parentValueInDetail) !== normalize(group.parentDependsOnValue)\n      ) {\n        continue;\n      }\n    }\n\n    const valueId = group.normalizedValueIdMap?.[requestedValue];\n\n    if (valueId) {\n      return valueId;\n    }\n  }\n\n  return null;\n}\n\nfunction resolveValueId(detail, detailAttributeValues, resolvedItem, independentMap, dependentLookup) {\n  if (!resolvedItem) {\n    return null;\n  }\n\n  const attributeCode = resolvedItem.attributeCode;\n  const value = resolvedItem.value;\n  const definition = resolvedItem.definition || {};\n  const hasDependency = !!definition.dependsOn;\n\n  if (hasDependency) {\n    return getDependentValueId(\n      dependentLookup,\n      detail,\n      detailAttributeValues,\n      attributeCode,\n      value\n    );\n  }\n\n  return getIndependentValueId(\n    independentMap,\n    attributeCode,\n    value\n  );\n}\n\nfunction stampOriginalItems(detail, sectionName) {\n  const originalList = Array.isArray(detail[sectionName])\n    ? detail[sectionName]\n    : [];\n  const resolvedList =\n    sectionName === \"influences\"\n      ? detail.resolvedInfluences || []\n      : detail.resolvedTargets || [];\n\n  return originalList.map((item, index) => {\n    const resolvedItem = resolvedList[index];\n\n    if (!resolvedItem) {\n      return item;\n    }\n\n    return {\n      ...item,\n      attributeCode: resolvedItem.attributeCode,\n      attributeName: resolvedItem.attributeName,\n      valueId: resolvedItem.valueId ?? null\n    };\n  });\n}\n\nfunction stampResolvedItems(detail, sectionName, independentMap, dependentLookup) {\n  const resolvedList =\n    sectionName === \"influences\"\n      ? detail.resolvedInfluences || []\n      : detail.resolvedTargets || [];\n  const detailAttributeValues = createDetailAttributeValueMap(detail);\n\n  return resolvedList.map(item => {\n    const valueId = resolveValueId(\n      detail,\n      detailAttributeValues,\n      item,\n      independentMap,\n      dependentLookup\n    );\n\n    return {\n      ...item,\n      valueId\n    };\n  });\n}\n\nfunction buildValueErrors(detail, stampedInfluences, stampedTargets) {\n  const errors = [];\n\n  for (const item of stampedInfluences) {\n    if (!item.valueId) {\n      errors.push({\n        code: \"INVALID_SOURCE_VALUE\",\n        message: `Value ${item.value} is invalid for Source ${item.attributeName || item.attribute}.`\n      });\n    }\n  }\n\n  for (const item of stampedTargets) {\n    if (!item.valueId) {\n      errors.push({\n        code: \"INVALID_TARGET_VALUE\",\n        message: `Value ${item.value} is invalid for Target Attribute ${item.attributeName || item.attribute}.`\n      });\n    }\n  }\n\n  return errors;\n}\nfunction getAllowedInfluencerCode(influencer) {\n  if (typeof influencer === \"string\") {\n    return influencer;\n  }\n\n  return influencer?.code || null;\n}\n\nfunction getAllowedInfluencerInputSeq(influencer, fallbackIndex) {\n  const inputSeq = Number(influencer?.inputSeq);\n\n  if (Number.isFinite(inputSeq) && inputSeq >= 1 && inputSeq <= MAX_INPUTS) {\n    return inputSeq;\n  }\n\n  return fallbackIndex + 1;\n}\n\nfunction normalizeAllowedInfluencers(targetRule) {\n  const allowedInfluencers = Array.isArray(targetRule?.allowedInfluencers)\n    ? targetRule.allowedInfluencers\n    : [];\n\n  return allowedInfluencers\n    .map((influencer, index) => ({\n      code: getAllowedInfluencerCode(influencer),\n      inputSeq: getAllowedInfluencerInputSeq(influencer, index)\n    }))\n    .filter(influencer =>\n      influencer.code &&\n      influencer.inputSeq >= 1 &&\n      influencer.inputSeq <= MAX_INPUTS\n    )\n    .sort((a, b) => a.inputSeq - b.inputSeq)\n    .slice(0, MAX_INPUTS);\n}\n\nfunction createInfluenceByCode(detail) {\n  const influenceByCode = {};\n  const influences = detail.resolvedInfluences || detail.influences || [];\n\n  for (const influence of influences) {\n    const code = normalize(influence.attributeCode);\n\n    if (code && influenceByCode[code] === undefined) {\n      influenceByCode[code] = influence;\n    }\n  }\n\n  return influenceByCode;\n}\n\nfunction findInfluenceByCode(detail, sourceCode) {\n  const influenceByCode = detail._influenceByCode || {};\n  return influenceByCode[normalize(sourceCode)] || null;\n}\n\nfunction getAllowedInfluencers(targetRule) {\n  if (!targetRule._allowedInfluencers) {\n    targetRule._allowedInfluencers = normalizeAllowedInfluencers(targetRule);\n  }\n\n  return targetRule._allowedInfluencers;\n}\n\nfunction buildMappingSetPayloadRow(detail, target, targetRule) {\n  const row = {\n    detailId: detail.detailId,\n    policyId: detail.policyId,\n    priority: detail.priority,\n\n    OutputValue: target.value ?? null,\n    OutputValueId: target.valueId ?? null\n  };\n\n  const allowedInfluencers = getAllowedInfluencers(targetRule);\n\n  for (const influencer of allowedInfluencers) {\n    const inputNumber = influencer.inputSeq;\n    const source = findInfluenceByCode(detail, influencer.code);\n\n    if (source) {\n      row[`Input${inputNumber}SourceValue`] = source.value ?? \"\";\n      row[`Input${inputNumber}SourceValueId`] = source.valueId ?? \"\";\n    } else {\n      row[`Input${inputNumber}SourceValue`] = \"*\";\n      row[`Input${inputNumber}SourceValueId`] = \"*\";\n    }\n  }\n\n  return row;\n}\n\nfunction buildMappingSetPayloadByTarget(stampedDetails) {\n  const groupedByTarget = {};\n\n  for (const detail of stampedDetails) {\n    const targets = detail.resolvedTargets || detail.targets || [];\n\n    for (const target of targets) {\n      const targetCode = target.attributeCode;\n      const targetRule = targetRuleDefinitionMap[targetCode];\n\n      if (!targetCode || !targetRule) {\n        continue;\n      }\n\n      if (!groupedByTarget[targetCode]) {\n        groupedByTarget[targetCode] = {\n          TargetName: getSourceIndexName(targetCode) || target.attributeName || target.attribute || targetCode || null,\n          TargetAttributeCode: targetCode,\n          MappingSetCode: targetRule.mappingSetPrefix || null,\n          MSPayload: []\n        };\n      }\n\n      groupedByTarget[targetCode].MSPayload.push(\n        buildMappingSetPayloadRow(detail, target, targetRule)\n      );\n    }\n  }\n\n  return Object.values(groupedByTarget);\n}\nconst validationResult = unwrapOutput(validationOutput);\n\nconst independentMap = mergeIndependentMaps(\n  unwrapOutput(independentResolutionOutput)\n);\n\nconst dependentGroups = normalizeDependentGroups(\n  unwrapOutput(dependentResolutionOutput)\n);\nconst dependentLookup = createDependentLookup(dependentGroups);\n\nconst validPolicyDetails = validationResult.validPolicyDetails || [];\nconst existingErrorPolicyDetails = validationResult.errorPolicyDetails || [];\n\nconst stampedValidPolicyDetails = [];\nconst valueErrorPolicyDetails = [];\nconst groupedMappingSetPayloadByTarget = {};\n\nfunction addMappingRowsForDetail(detail) {\n  const targets = detail.resolvedTargets || detail.targets || [];\n\n  for (const target of targets) {\n    const targetCode = target.attributeCode;\n    const targetRule = targetRuleDefinitionMap[targetCode];\n\n    if (!targetCode || !targetRule) {\n      continue;\n    }\n\n    if (!groupedMappingSetPayloadByTarget[targetCode]) {\n      groupedMappingSetPayloadByTarget[targetCode] = {\n        TargetName: getSourceIndexName(targetCode) || target.attributeName || target.attribute || targetCode || null,\n        TargetAttributeCode: targetCode,\n        MappingSetCode: targetRule.mappingSetPrefix || null,\n        MSPayload: []\n      };\n    }\n\n    groupedMappingSetPayloadByTarget[targetCode].MSPayload.push(\n      buildMappingSetPayloadRow(detail, target, targetRule)\n    );\n  }\n}\n\nfor (const detail of validPolicyDetails) {\n  const stampedResolvedInfluences = [];\n  const stampedResolvedTargets = [];\n  const detailAttributeValues = createDetailAttributeValueMap(detail);\n\n  for (const item of detail.resolvedInfluences || []) {\n    stampedResolvedInfluences.push({\n      attribute: item.attribute,\n      attributeName: item.attributeName,\n      attributeCode: item.attributeCode,\n      value: item.value,\n      valueId: resolveValueId(\n        detail,\n        detailAttributeValues,\n        item,\n        independentMap,\n        dependentLookup\n      )\n    });\n  }\n\n  for (const item of detail.resolvedTargets || []) {\n    stampedResolvedTargets.push({\n      attribute: item.attribute,\n      attributeName: item.attributeName,\n      attributeCode: item.attributeCode,\n      value: item.value,\n      valueId: resolveValueId(\n        detail,\n        detailAttributeValues,\n        item,\n        independentMap,\n        dependentLookup\n      )\n    });\n  }\n\n  const valueErrors = buildValueErrors(\n    detail,\n    stampedResolvedInfluences,\n    stampedResolvedTargets\n  );\n\n  const compactDetail = {\n    detailId: detail.detailId,\n    policyId: detail.policyId,\n    priority: detail.priority,\n    resolvedInfluences: stampedResolvedInfluences,\n    resolvedTargets: stampedResolvedTargets\n  };\n  const stampedDetail = compactDetail;\n  stampedDetail._influenceByCode = createInfluenceByCode(stampedDetail);\n\n  if (valueErrors.length > 0) {\n    valueErrorPolicyDetails.push({\n      detailId: detail.detailId,\n      policyId: detail.policyId,\n      status: \"Publish_Error\",\n      errorMessage: valueErrors.map(error => error.message).join(\" \"),\n      errors: [\n        ...(detail.errors || []),\n        ...valueErrors\n      ]\n    });\n  } else {\n    const validStampedDetail = {\n      ...stampedDetail,\n      status: \"Valid\",\n      errorMessage: null\n    };\n\n    stampedValidPolicyDetails.push({\n      detailId: detail.detailId,\n      policyId: detail.policyId,\n      status: \"Valid\",\n      errorMessage: null\n    });\n    addMappingRowsForDetail(validStampedDetail);\n  }\n}\n\nconst mappingSetPayloadByTarget =\n  Object.values(groupedMappingSetPayloadByTarget);\n\nreturn {\n  validPolicyDetails: stampedValidPolicyDetails,\n  errorPolicyDetails: [\n    ...existingErrorPolicyDetails,\n    ...valueErrorPolicyDetails\n  ],\n  mappingSetPayloadByTarget\n};\n"
                                  },
