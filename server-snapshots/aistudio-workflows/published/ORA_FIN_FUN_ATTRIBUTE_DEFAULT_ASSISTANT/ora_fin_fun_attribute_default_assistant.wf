                            "name": "Validate Rule Definitions Chunk",
                            "sourceCode": "function safeGet(fn) { try { return fn(); } catch (e) { return null; } }\nfunction parseLocal(value) {\n  if (typeof value !== \"string\") return value;\n  const text = value.trim();\n  if (!text || (text[0] !== \"{\" && text[0] !== \"[\")) return value;\n  try { return JSON.parse(text); } catch (e) { return value; }\n}\nfunction unwrapLocal(value) {\n  value = parseLocal(value);\n  if (value && typeof value === \"object\" && value.result !== undefined) return unwrapLocal(value.result);\n  if (value && typeof value === \"object\" && value.output !== undefined) return unwrapLocal(value.output);\n  if (value && typeof value === \"object\" && value.body !== undefined) return unwrapLocal(value.body);\n  return value;\n}\nfunction firstChunk(value) {\n  const unwrapped = unwrapLocal(value);\n  if (Array.isArray(unwrapped)) return unwrapped[0] || {};\n  return unwrapped || {};\n}\nfunction pickChunk(value) {\n  const chunk = firstChunk(value);\n  return chunk && Array.isArray(chunk.policyDetails) ? chunk : null;\n}\nconst currentChunk =\n  pickChunk(safeGet(() => $context.$nodes.PROCESS_TARGET_POLICY_BATCHES.$currentItem)) ||\n  pickChunk(safeGet(() => $context.$nodes.PROCESS_TARGET_ATTRIBUTE_CHUNKS.PROCESS_TARGET_POLICY_BATCHES.$currentItem)) ||\n  pickChunk(safeGet(() => $context.$nodes.PROCESS_TARGET_ATTRIBUTE_CHUNKS.CHUNK_TARGET_POLICY_DETAILS.$output)) ||\n  pickChunk(safeGet(() => $context.$nodes.PROCESS_TARGET_ATTRIBUTE_CHUNKS.$currentItem)) ||\n  {};\nconst policyDetails = Array.isArray(currentChunk.policyDetails) ? currentChunk.policyDetails : [];\nconst debugPolicyContext = {\n  currentChunkKeys: currentChunk && typeof currentChunk === \"object\" ? Object.keys(currentChunk).slice(0, 20) : [],\n  policyDetailsLength: policyDetails.length,\n  directBatchType: typeof safeGet(() => $context.$nodes.PROCESS_TARGET_POLICY_BATCHES.$currentItem),\n  nestedBatchType: typeof safeGet(() => $context.$nodes.PROCESS_TARGET_ATTRIBUTE_CHUNKS.PROCESS_TARGET_POLICY_BATCHES.$currentItem),\n  chunkOutputType: typeof safeGet(() => $context.$nodes.PROCESS_TARGET_ATTRIBUTE_CHUNKS.CHUNK_TARGET_POLICY_DETAILS.$output),\n  outerTargetType: typeof safeGet(() => $context.$nodes.PROCESS_TARGET_ATTRIBUTE_CHUNKS.$currentItem)\n};\nconst attributeDefinitionMap = $context.$variables.attributeDefinitionMap || {};\nconst targetRuleDefinitionMap = $context.$variables.targetRuleDefinitionMap || {};\n\nconst sourceIndex = (function() {\n  try {\n    const output = $context.$nodes.BUILD_ATTRIBUTE_SOURCE_INDEX.$output;\n    const result = output && output.result !== undefined ? output.result : output;\n    return result || {};\n  } catch (e) {\n    return {};\n  }\n})();\nfunction resolveFromSourceIndex(input) {\n  const text = String(input || \"\").trim();\n  if (!text) return null;\n  const byCode = sourceIndex.byCode || {};\n  const byName = sourceIndex.byNormalizedName || {};\n  const row = byCode[text] || byCode[byName[normalize(text)]];\n  if (!row || !row.AttributeCode) return null;\n  return {\n    code: row.AttributeCode,\n    name: row.DisplayName || row.AttributeName || row.AttributeCode,\n    definition: attributeDefinitionMap[row.AttributeCode] || null,\n    rule: targetRuleDefinitionMap[row.AttributeCode] || null\n  };\n}\n\nfunction getSourceIndex() {\n  try {\n    const output = $context.$nodes.BUILD_ATTRIBUTE_SOURCE_INDEX.$output;\n    return (output && output.result !== undefined ? output.result : output) || {};\n  } catch (e) {\n    return {};\n  }\n}\n\nfunction looseNormalizeName(value) {\n  return String(value || \"\").trim().toUpperCase().replace(/[^A-Z0-9]+/g, \"\");\n}\n\nfunction getSourceIndexRow(attributeCode) {\n  const index = getSourceIndex();\n  return (index.byCode || {})[attributeCode] || {};\n}\n\nfunction getSourceIndexName(attributeCode) {\n  const row = getSourceIndexRow(attributeCode);\n  return row.DisplayName || row.AttributeName || row.Name || row.Prompt || row.AttributeCode || \"\";\n}\n\nfunction resolveCodeFromSourceIndex(value) {\n  const text = String(value || \"\").trim();\n  if (!text) return null;\n  const index = getSourceIndex();\n  const byCode = index.byCode || {};\n  const byName = index.byNormalizedName || {};\n  if (byCode[text]) return text;\n  return byName[normalize(text)] || byName[looseNormalizeName(text)] || null;\n}\n\nfunction normalize(value) { return String(value || \"\").trim().toUpperCase(); }\nfunction clone(value) { return JSON.parse(JSON.stringify(value)); }\nfunction getAttributeName(code) {\n  return getSourceIndexName(code) || code;\n}\nfunction resolveAttribute(attribute, includeTargets) {\n  const sourceResolved = resolveFromSourceIndex(attribute);\n  if (sourceResolved && (sourceResolved.definition || sourceResolved.rule)) return sourceResolved;\n\n  const input = String(attribute || \"\").trim();\n  const inputNorm = normalize(input);\n  const indexedCode = resolveCodeFromSourceIndex(input);\n  if (indexedCode && (attributeDefinitionMap[indexedCode] || targetRuleDefinitionMap[indexedCode])) return { code: indexedCode, name: getAttributeName(indexedCode), definition: attributeDefinitionMap[indexedCode] || null, rule: targetRuleDefinitionMap[indexedCode] || null };\n  const maps = includeTargets ? [targetRuleDefinitionMap, attributeDefinitionMap] : [attributeDefinitionMap, targetRuleDefinitionMap];\n  for (let m = 0; m < maps.length; m++) {\n    const map = maps[m] || {};\n    if (map[input]) return { code: input, name: getAttributeName(input), definition: attributeDefinitionMap[input] || null, rule: targetRuleDefinitionMap[input] || null };\n    const keys = Object.keys(map);\n    for (let i = 0; i < keys.length; i++) {\n      const code = keys[i];\n      const def = map[code] || {};\n      if (normalize(code) === inputNorm || normalize(def.code) === inputNorm || normalize(def.name) === inputNorm) {\n        return { code, name: getAttributeName(code), definition: attributeDefinitionMap[code] || null, rule: targetRuleDefinitionMap[code] || null };\n      }\n    }\n  }\n  return { code: null, name: input, definition: null, rule: null };\n}\nfunction allowedCode(influencer) { return typeof influencer === \"string\" ? influencer : influencer?.code; }\nfunction dependencyCodeForTarget(targetDefinition, targetRule) {\n  return (\n    (targetDefinition && targetDefinition.dependsOn) ||\n    (targetRule && (targetRule.dependsOn || targetRule.dependentAttributeCode || targetRule.dependencyAttributeCode)) ||\n    \"\"\n  );\n}\nfunction hasInfluenceCode(resolvedInfluences, code) {\n  const wanted = normalize(code);\n  return resolvedInfluences.some(item => normalize(item.attributeCode) === wanted);\n}\nfunction createPublishError(detail, message, code) {\n  const copy = createError(detail, message, code);\n  copy.status = \"Publish_Error\";\n  return copy;\n}\nfunction createError(detail, message, code) {\n  const copy = clone(detail);\n  copy.status = \"Invalid\";\n  copy.errorMessage = message;\n  copy.errors = (copy.errors || []).concat([{ code: code || \"VALIDATE_RULE_DEFINITIONS\", message }]);\n  return copy;\n}\n\nconst validPolicyDetails = [];\nconst errorPolicyDetails = [];\n\nfor (let d = 0; d < policyDetails.length; d++) {\n  const detail = clone(policyDetails[d] || {});\n  const targets = Array.isArray(detail.targets) ? detail.targets : [];\n  if (targets.length !== 1) {\n    errorPolicyDetails.push(createError(detail, \"Each policy detail must have exactly one target attribute after target split.\", \"INVALID_TARGET_COUNT\"));\n    continue;\n  }\n\n  const targetResolved = resolveAttribute(targets[0].attribute, true);\n  const targetCode = targetResolved.code;\n  const targetRule = targetCode ? targetRuleDefinitionMap[targetCode] : null;\n  if (!targetCode || !targetRule) {\n    errorPolicyDetails.push(createError(detail, \"Unsupported target attribute \" + targets[0].attribute + \".\", \"UNSUPPORTED_TARGET_ATTRIBUTE\"));\n    continue;\n  }\n  if (currentChunk.targetAttribute && normalize(currentChunk.targetAttribute) !== normalize(targets[0].attribute) && normalize(currentChunk.targetAttribute) !== normalize(targetCode) && normalize(currentChunk.targetAttribute) !== normalize(targetResolved.name)) {\n    errorPolicyDetails.push(createError(detail, \"Policy detail target \" + targets[0].attribute + \" does not match current target chunk \" + currentChunk.targetAttribute + \".\", \"TARGET_CHUNK_MISMATCH\"));\n    continue;\n  }\n\n  const allowed = {};\n  const allowedList = Array.isArray(targetRule.allowedInfluencers) ? targetRule.allowedInfluencers : [];\n  for (let i = 0; i < allowedList.length; i++) {\n    const code = allowedCode(allowedList[i]);\n    if (code) allowed[code] = true;\n  }\n\n  const resolvedInfluences = [];\n  const influences = Array.isArray(detail.influences) ? detail.influences : [];\n  let hasError = false;\n  for (let i = 0; i < influences.length; i++) {\n    const influence = influences[i] || {};\n    const resolved = resolveAttribute(influence.attribute, false);\n    if (!resolved.code || !resolved.definition) {\n      errorPolicyDetails.push(createError(detail, \"Unsupported source attribute \" + influence.attribute + \".\", \"UNSUPPORTED_SOURCE_ATTRIBUTE\"));\n      hasError = true;\n      break;\n    }\n    if (allowedList.length > 0 && !allowed[resolved.code]) {\n      errorPolicyDetails.push(createError(detail, resolved.name + \" is not configured as an allowed source for \" + targetResolved.name + \".\", \"SOURCE_NOT_ALLOWED\"));\n      hasError = true;\n      break;\n    }\n    resolvedInfluences.push({ ...influence, attributeCode: resolved.code, attributeName: resolved.name, definition: resolved.definition });\n  }\n  if (hasError) continue;\n\n  const targetDefinition = attributeDefinitionMap[targetCode] || null;\n  const targetDependsOn = dependencyCodeForTarget(targetDefinition, targetRule);\n  if (targetDependsOn && !hasInfluenceCode(resolvedInfluences, targetDependsOn)) {\n    const dependencyName = getAttributeName(targetDependsOn) || targetDependsOn;\n    const targetName = targetResolved.name || targets[0].attribute || targetCode;\n    errorPolicyDetails.push(createPublishError(detail, \"Missing required dependency \" + dependencyName + \" for \" + targetName + \".\", \"MISSING_REQUIRED_DEPENDENCY\"));\n    continue;\n  }\n\n  const resolvedTargets = [{ ...targets[0], attributeCode: targetCode, attributeName: targetResolved.name, definition: targetDefinition, rule: targetRule }];\n  validPolicyDetails.push({ ...detail, resolvedInfluences, resolvedTargets, targetAttributeCode: targetCode, targetAttributeName: targetResolved.name });\n}\n\nreturn {\n  chunkIndex: currentChunk.chunkIndex,\n  targetAttribute: currentChunk.targetAttribute,\n  targetAttributeCode: validPolicyDetails[0]?.targetAttributeCode || null,\n  validPolicyDetails,\n  errorPolicyDetails,\n  debugPolicyContext\n};",
