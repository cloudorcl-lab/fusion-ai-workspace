            "name": "Build Omitted Target Rule Delete Payload",
            "returnType": "object",
            "sourceCode": "function parse(value) {\n  if (typeof value !== \"string\") return value;\n  const text = value.trim();\n  if (!text || (text[0] !== \"{\" && text[0] !== \"[\")) return value;\n  try { return JSON.parse(text); } catch (e) { return value; }\n}\n\nfunction unwrap(value) {\n  let current = value;\n  for (let depth = 0; depth < 8; depth += 1) {\n    current = parse(current);\n    if (current && typeof current === \"object\" && current.result !== undefined) {\n      current = current.result;\n      continue;\n    }\n    if (current && typeof current === \"object\" && current.output !== undefined) {\n      current = current.output;\n      continue;\n    }\n    if (current && typeof current === \"object\" && current.body !== undefined) {\n      current = current.body;\n      continue;\n    }\n    return current || {};\n  }\n  return current || {};\n}\n\nfunction normalize(value) {\n  return String(value == null ? \"\" : value).trim().toUpperCase();\n}\n\nfunction toRows(value) {\n  const unwrapped = unwrap(value);\n  if (Array.isArray(unwrapped)) return unwrapped;\n  if (Array.isArray(unwrapped.items)) return unwrapped.items;\n  if (Array.isArray(unwrapped.results)) return unwrapped.results;\n  if (Array.isArray(unwrapped.collection)) return unwrapped.collection;\n  return [];\n}\n\nconst omittedRows = toRows($context.$nodes.BUILD_OMITTED_TARGET_CLEANUP_LIST?.$output);\nconst omittedTargets = new Set();\n\nfor (const row of omittedRows) {\n  const code = normalize(row && row.TargetAttributeCode);\n  if (code) omittedTargets.add(code);\n}\n\nconst rules = toRows($context.$nodes.GET_ALL_ATTRIBUTE_DERIVATION_RULES?.$output);\nconst parts = [];\nconst seenRuleIds = new Set();\n\nfor (const rule of rules) {\n  if (!rule || normalize(rule.Entity) !== \"ORA_PT_AP\") continue;\n  if (!omittedTargets.has(normalize(rule.TargetAttribute))) continue;\n\n  const ruleId = String(rule.AttributeRuleId == null ? \"\" : rule.AttributeRuleId).trim();\n  if (!ruleId || seenRuleIds.has(ruleId)) continue;\n\n  seenRuleIds.add(ruleId);\n  parts.push({\n    id: ruleId,\n    path: \"/attributeDerivationRules/\" + encodeURIComponent(ruleId),\n    operation: \"delete\"\n  });\n}\n\nconst result = {\n  parts,\n  omittedTargetCount: omittedTargets.size,\n  matchedRuleCount: parts.length\n};\nreturn result;"
