        {
          "metadata": {
            "description": "Combines per-target processing outputs for the final payload.",
            "name": "Merge Target Chunk Results",
            "returnType": "object",
            "sourceCode": "function parse(value) {\n  if (typeof value !== \"string\") return value;\n  const text = value.trim();\n  if (!text || (text[0] !== \"{\" && text[0] !== \"[\")) return value;\n  try { return JSON.parse(text); } catch (e) { return value; }\n}\n\nfunction unwrap(value) {\n  value = parse(value);\n  if (value && typeof value === \"object\" && value.result !== undefined) return unwrap(value.result);\n  if (value && typeof value === \"object\" && value.output !== undefined) return unwrap(value.output);\n  if (value && typeof value === \"object\" && value.body !== undefined) return unwrap(value.body);\n  return value;\n}\n\nfunction appendArray(target, value) {\n  const unwrapped = unwrap(value);\n  if (!Array.isArray(unwrapped)) return;\n  for (let i = 0; i < unwrapped.length; i++) target.push(unwrapped[i]);\n}\n\nfunction scan(value, state) {\n  const unwrapped = unwrap(value);\n  if (!unwrapped) return;\n  if (Array.isArray(unwrapped)) {\n    for (let i = 0; i < unwrapped.length; i++) scan(unwrapped[i], state);\n    return;\n  }\n  if (typeof unwrapped !== \"object\") return;\n\n  appendArray(state.validPolicyDetails, unwrapped.validPolicyDetails);\n  appendArray(state.errorPolicyDetails, unwrapped.errorPolicyDetails);\n  appendArray(state.targetChunks, unwrapped.targetChunks);\n  if (Array.isArray(unwrapped.parts)) appendArray(state.parts, unwrapped.parts);\n  if (unwrapped.id && unwrapped.payload) state.parts.push(unwrapped);\n\n  const keys = Object.keys(unwrapped);\n  for (let i = 0; i < keys.length; i++) {\n    const key = keys[i];\n    if (key === \"validPolicyDetails\" || key === \"errorPolicyDetails\" || key === \"targetChunks\" || key === \"parts\") continue;\n    const child = unwrapped[key];\n    if (child && typeof child === \"object\") scan(child, state);\n  }\n}\n\nconst processOutput = unwrap($context.$nodes.PROCESS_TARGET_ATTRIBUTE_CHUNKS.$output);\nconst state = {\n  validPolicyDetails: [],\n  errorPolicyDetails: [],\n  targetChunks: unwrap($context.$nodes.SPLITPAYLOADBYTARGET.$output.result) || [],\n  chunkOutputs: processOutput,\n  parts: []\n};\nscan(processOutput, state);\nreturn state;"
          },
