                                    "sourceCode": "const currentItem = $context.$nodes.DEPENDENT_ATTRIBUTE_VALUE_BUILDER.$currentItem || {};\nconst valueSetId = $context.$nodes.DEPENDENT_ATTRIBUTE_VALUE_BUILDER.GETVALUESETID.$output.result || \"\";\nfunction norm(value) { return String(value == null ? \"\" : value).trim().toUpperCase(); }\nfunction quote(value) { return \"'\" + String(value == null ? \"\" : value).replace(/'/g, \"''\") + \"'\"; }\nconst source = currentItem.valueList || currentItem.values || [];\nconst rawValues = Array.isArray(source) ? source : String(source || \"\").split(\",\");\nconst misses = [];\nconst seen = {};\nfor (let i = 0; i < rawValues.length; i++) {\n  const raw = typeof rawValues[i] === \"object\" ? rawValues[i].value : rawValues[i];\n  const normalized = norm(raw);\n  if (!normalized || seen[normalized]) continue;\n  seen[normalized] = true;\n  misses.push(raw);\n}\nconst collection = [];\nfor (let i = 0; i < misses.length; i += 100) {\n  const chunk = misses.slice(i, i + 100);\n  collection.push({ chunkIndex: collection.length, pValuesetId: valueSetId, pDepValue: currentItem.dependsOnValueId || \"\", values: chunk.map(quote).join(\",\"), valueList: chunk });\n}\nreturn { collection, totalValues: rawValues.length, missCount: misses.length };"
