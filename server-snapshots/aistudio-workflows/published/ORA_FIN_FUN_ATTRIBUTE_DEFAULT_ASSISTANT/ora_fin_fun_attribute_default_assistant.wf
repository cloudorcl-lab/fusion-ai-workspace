          },
          "outcomes": {
            "success": "1767951181436"
          },
          "code": "READ_AGENT",
          "convergenceTargetId": "1767951181436",
          "id": "1767951024970",
          "inputs": [
            {
              "id": "1768233045988_1",
              "name": "message",
              "type": "string"
            },
            {
              "id": "1768233045991_2",
              "name": "pApplicationContext",
              "type": "string",
              "value": "{{$context.$variables.pEntityClassCode}}"
            },
            {
              "id": "1768233045994_3",
              "name": "pInputPayload",
              "type": "object",
              "value": "{{$context.$variables.pInputPayload}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
        },
        {
          "metadata": {
            "name": "Process Save Payload",
            "returnType": "object",
            "sourceCode": "var payload = $context.$variables.pInputPayload;\nvar pAttributeMapping = $context.$variables.pAttributeMapping;\n\n\ntry {\n  if (typeof pAttributeMapping === \"string\" && pAttributeMapping.trim() !== \"\") {\n    pAttributeMapping = JSON.parse(pAttributeMapping);\n  }\n} catch (e) {\n  pAttributeMapping = null;\n}\n\n\nif (typeof payload === \"string\" && payload.trim() !== \"\") {\n  payload = JSON.parse(payload);\n}\n\nvar agentOperation = payload.agentOperation;\n\n// ── Normalize Ruleset ────────────────────────────────────\nvar rulesets = payload.Ruleset;\n\nif (typeof rulesets === \"string\" && rulesets.trim() !== \"\") {\n  rulesets = JSON.parse(rulesets);\n}\n\nif (!Array.isArray(rulesets)) {\n  rulesets = [rulesets];\n}\n\nvar now = new Date();\nvar yy  = now.getFullYear().toString().slice(-2);\nvar mm  = (\"0\" + (now.getMonth() + 1)).slice(-2);\nvar dd  = (\"0\" + now.getDate()).slice(-2);\nvar hh  = (\"0\" + now.getHours()).slice(-2);\nvar min = (\"0\" + now.getMinutes()).slice(-2);\nvar ss  = (\"0\" + now.getSeconds()).slice(-2);\nvar ms  = (\"00\" + now.getMilliseconds()).slice(-3);\nvar mappingSetCode = \"PTAP\" + yy + mm + dd + hh + min + ss + ms;\n\nvar out = {\n  createMappingSetAndRule: [],\n  createMappingSetValue: [],\n  updateRuleStatus: [],\n  updateMappingSetValue: [],\n  deleteRules: []\n};\n\nfor (var s = 0; s < rulesets.length; s++) {\n  var rules = rulesets[s].rules;\n\n  for (var i = 0; i < rules.length; i++) {\n    var rule = rules[i];\n\n    var ruleId             = null;\n    var mappingSetId       = null;\n    var mappingSetFlavorId = null;\n    var mappingSetValueId  = null;\n\n    if (rule.rulePK) {\n      var ids = rule.rulePK.split(\",\");\n      ruleId             = ids[0] || null;\n      mappingSetId       = ids[1] || null;\n      mappingSetFlavorId = ids[2] || null;\n      mappingSetValueId  = ids[3] || null;\n      mappingSetCode     = ids[4] || null;\n    }\n\n    var statusCode = rule.ruleStatus === \"Active\" ? \"A\" : \"I\";\n\n    // ── Extract mappingset conditions only ──────────────────\n    var mappingConditions = [];\n    for (var c = 0; c < rule.ruleConditions.length; c++) {\n      if (rule.ruleConditions[c].conditionType === \"mappingset\") {\n        mappingConditions.push(rule.ruleConditions[c]);\n      }\n    }\n\n    var noOfInputs = mappingConditions.length > 10 ? 10 : mappingConditions.length;\n    if (noOfInputs < 1) {\n      noOfInputs = 1;\n    }\n\n    // ── Source attribute key array for flavor input REST loop\n    var sourceInputArray = [];\n    for (var v = 0; v < noOfInputs; v++) {\n      var srcKey = mappingConditions[v].attributeKey;\n      var srcValueSetCode = null;\n      var srcLookupCode   = null;\n\n      try {\n        if (pAttributeMapping && pAttributeMapping[srcKey]) {\n          if (pAttributeMapping[srcKey].apiName === \"getValueSetValues\") {\n            srcValueSetCode = pAttributeMapping[srcKey].apiParam || null;\n          } else if (pAttributeMapping[srcKey].apiName === \"getLookupValues\") {\n            srcLookupCode = pAttributeMapping[srcKey].apiParam || null;\n          }\n        }\n      } catch (e) {\n        srcValueSetCode = null;\n        srcLookupCode   = null;\n      }\n\n      sourceInputArray.push({\n        inputNo:            v + 1,\n        sourceCode:         srcKey,\n        displayLabel:       mappingConditions[v].attribute,\n        sourceValueSetCode: srcValueSetCode,\n        sourceLookupCode:   srcLookupCode\n      });\n    }\n\n    // ── Flat inputValue1..N and inputKey1..N for value row ──\n    var inputValues = {};\n    var inputKeys   = {};\n    for (var v = 0; v < noOfInputs; v++) {\n      var num = v + 1;\n      inputValues[\"inputValue\" + num] = mappingConditions[v].valueKey;\n      inputKeys[\"inputKey\" + num]     = mappingConditions[v].attributeKey;\n    }\n    // Pad remaining slots to inputValue10 with null\n    for (var v = noOfInputs + 1; v <= 10; v++) {\n      inputValues[\"inputValue\" + v] = null;\n    }\n\n    // ── Outcomes ────────────────────────────────────────────\n    var targetAttributeKey = rule.ruleOutcomes[0].value1Key;\n    var targetValueKey     = rule.ruleOutcomes[1].value2Key;\n\n    // ── Resolve target valueset / lookup code ────────────────\n    var targetValueSetCode = null;\n    var targetLookupCode   = null;\n\n    try {\n      if (pAttributeMapping && pAttributeMapping[targetAttributeKey]) {\n        if (pAttributeMapping[targetAttributeKey].apiName === \"getValueSetValues\") {\n          targetValueSetCode = pAttributeMapping[targetAttributeKey].apiParam || null;\n        } else if (pAttributeMapping[targetAttributeKey].apiName === \"getLookupValues\") {\n          targetLookupCode = pAttributeMapping[targetAttributeKey].apiParam || null;\n        }\n      }\n    } catch (e) {\n      targetValueSetCode = null;\n      targetLookupCode   = null;\n    }\n\n    var base = {\n      uiId: rule.uiId,\n      ids: {\n        ruleId:             ruleId,\n        mappingSetId:       mappingSetId,\n        mappingSetFlavorId: mappingSetFlavorId,\n        mappingSetValueId:  mappingSetValueId,\n        mappingSetCode:     mappingSetCode\n      }\n    };\n\n    // ── CREATE ──────────────────────────────────────────────\n    if (rule.ruleOperation === \"CREATE\") {\n\n      if (!rule.rulePK) {\n        base.action = \"CREATE_MAPPINGSET_AND_RULE\";\n\n        base.mappingSetPayload = {\n          MappingSetCode:     mappingSetCode,\n          MappingSetName:     mappingSetCode,\n          StatusCode:         statusCode,\n          NoOfInputs:         noOfInputs,\n          TargetAttribute:    targetAttributeKey,\n          TargetValueSetCode: targetValueSetCode,\n          TargetLookupCode:   targetLookupCode\n        };\n\n        base.sourceInputArray = sourceInputArray;\n\n        base.mappingSetValuePayload = {\n          NoOfInputs:  noOfInputs,\n          TargetValue: targetValueKey\n        };\n        for (var k in inputValues) {\n          base.mappingSetValuePayload[k] = inputValues[k];\n        }\n        for (var k in inputKeys) {\n          base.mappingSetValuePayload[k] = inputKeys[k];\n        }\n\n        base.rulePayload = {\n          StatusCode: statusCode,\n          Priority:   1\n        };\n\n        out.createMappingSetAndRule.push(base);\n\n      } else {\n        base.action = \"CREATE_MAPPINGSET_VALUE\";\n\n        base.sourceInputArray = sourceInputArray;\n\n        base.mappingSetValuePayload = {\n          MappingSetId: mappingSetId,\n          NoOfInputs:   noOfInputs,\n          TargetValue:  targetValueKey\n        };\n        for (var k in inputValues) {\n          base.mappingSetValuePayload[k] = inputValues[k];\n        }\n        for (var k in inputKeys) {\n          base.mappingSetValuePayload[k] = inputKeys[k];\n        }\n\n        out.createMappingSetValue.push(base);\n      }\n    }\n\n    // ── UPDATE ──────────────────────────────────────────────\n    if (rule.ruleOperation === \"UPDATE\") {\n\n      if (mappingSetValueId) {\n        base.action = \"UPDATE_MAPPINGSET_VALUE\";\n\n        base.sourceInputArray = sourceInputArray;\n\n        base.mappingSetValuePayload = {\n          MappingSetValueId: mappingSetValueId,\n          MappingSetId:      mappingSetId,\n          NoOfInputs:        noOfInputs,\n          TargetValue:       targetValueKey,\n          StatusCode:        statusCode\n        };\n        for (var k in inputValues) {\n          base.mappingSetValuePayload[k] = inputValues[k];\n        }\n        for (var k in inputKeys) {\n          base.mappingSetValuePayload[k] = inputKeys[k];\n        }\n\n        out.updateMappingSetValue.push(base);\n\n      } else {\n        base.action = \"UPDATE_RULE_STATUS\";\n\n        base.rulePayload = {\n          RuleId:     ruleId,\n          StatusCode: statusCode\n        };\n\n        out.updateRuleStatus.push(base);\n      }\n    }\n\n    // ── DELETE ──────────────────────────────────────────────\n    if (rule.ruleOperation === \"DELETE\") {\n      base.action = \"DELETE_RULE\";\n\n      base.rulePayload = {\n        RuleId: ruleId\n      };\n\n      out.deleteRules.push(base);\n    }\n  }\n}\n\nreturn out;"
          },
          "outcomes": {
            "success": "1771355935939"
          },
          "code": "PROCESS_SAVE_PAYLOAD",
