                                  "metadata": {
                                    "name": "Delivery Channel Details",
                                    "returnType": "object",
                                    "sourceCode": "const currentItem = $context.$nodes.ATTRIBUTE_VALUES_BUILDER.$currentItem || {};\nfunction norm(value) { return String(value == null ? \"\" : value).trim().toUpperCase(); }\nfunction quote(value) { return \"'\" + String(value == null ? \"\" : value).replace(/'/g, \"''\") + \"'\"; }\nconst values = Array.isArray(currentItem.values) ? currentItem.values : Object.values(currentItem.values || {});\nconst misses = [];\nconst seen = {};\nfor (let i = 0; i < values.length; i++) {\n  const entry = values[i] || {};\n  const rawValue = entry.value;\n  const normalized = norm(rawValue);\n  if (!normalized || seen[normalized]) continue;\n  seen[normalized] = true;\n  if (entry.valueId !== undefined && entry.valueId !== null && entry.valueId !== \"\") continue;\n  misses.push(rawValue);\n}\nconst collection = [];\nfor (let i = 0; i < misses.length; i += 100) {\n  const chunk = misses.slice(i, i + 100);\n  collection.push({ chunkIndex: collection.length, paramValues: chunk.map(quote).join(\",\"), values: chunk });\n}\nreturn { collection, totalValues: values.length, missCount: misses.length };"
                                  },
                                  "outcomes": {
                                    "success": "1900000001101"
                                  },
