                          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                          "type": "CODE",
                          "sourceCode": "// Code Node: Build Attribute Values Map\n\nconst currentTargetChunk = $context.$nodes.PROCESS_TARGET_ATTRIBUTE_CHUNKS.$currentItem || {};\nconst validPolicyDetails = currentTargetChunk.validPolicyDetails || [];\nconst attributeDefinitionMap = $context.$variables.attributeDefinitionMap || {};\nconst targetRuleDefinitionMap = $context.$variables.targetRuleDefinitionMap || {};\n\nconst attributeValuesMap = {};\nconst dependentAttributeValuesMap = {};\nconst dependencyErrors = [];\n\nfunction getSourceIndex() {\n  try {\n    const output = $context.$nodes.BUILD_ATTRIBUTE_SOURCE_INDEX.$output;\n    return (output && output.result !== undefined ? output.result : output) || {};\n  } catch (e) {\n    return {};\n  }\n}\n\nfunction looseNormalizeName(value) {\n  return String(value || \"\").trim().toUpperCase().replace(/[^A-Z0-9]+/g, \"\");\n}\n\nfunction getSourceIndexRow(attributeCode) {\n  const index = getSourceIndex();\n  return (index.byCode || {})[attributeCode] || {};\n}\n\nfunction getSourceIndexName(attributeCode) {\n  const row = getSourceIndexRow(attributeCode);\n  return row.DisplayName || row.AttributeName || row.Name || row.Prompt || row.AttributeCode || \"\";\n}\n\nfunction resolveCodeFromSourceIndex(value) {\n  const text = String(value || \"\").trim();\n  if (!text) return null;\n  const index = getSourceIndex();\n  const byCode = index.byCode || {};\n  const byName = index.byNormalizedName || {};\n  if (byCode[text]) return text;\n  return byName[normalize(text)] || byName[looseNormalizeName(text)] || null;\n}\n\nfunction normalize(value) {\n  return String(value || \"\").trim().toUpperCase();\n}\n\nfunction valueKey(value) {\n  return normalize(value);\n}\n\nfunction addUnique(array, value) {\n  if (!value) {\n    return;\n  }\n\n  if (!array._seen) {\n    array._seen = new Set(array);\n  }\n\n  if (!array._seen.has(value)) {\n    array._seen.add(value);\n    array.push(value);\n  }\n}\n\nfunction getAttributeName(attributeCode) {\n  return getSourceIndexName(attributeCode) || attributeCode;\n}\n\nfunction resolveAttribute(attribute) {\n  const input = String(attribute || \"\").trim();\n  const inputNorm = normalize(input);\n\n  if (attributeDefinitionMap[input] || targetRuleDefinitionMap[input]) {\n    return {\n      code: input,\n      name: getAttributeName(input),\n      definition: attributeDefinitionMap[input] || null,\n      rule: targetRuleDefinitionMap[input] || null\n    };\n  }\n\n  for (const [code, definition] of Object.entries(attributeDefinitionMap)) {\n    if (\n      normalize(code) === inputNorm ||\n      normalize(definition.code) === inputNorm\n    ) {\n      return {\n        code,\n        name: getAttributeName(code),\n        definition,\n        rule: targetRuleDefinitionMap[code] || null\n      };\n    }\n  }\n\n  for (const [code, rule] of Object.entries(targetRuleDefinitionMap)) {\n    if (\n      normalize(code) === inputNorm ||\n      normalize(rule.code) === inputNorm\n    ) {\n      return {\n        code,\n        name: getAttributeName(code),\n        definition: attributeDefinitionMap[code] || null,\n        rule\n      };\n    }\n  }\n\n  return {\n    code: null,\n    name: input,\n    definition: null,\n    rule: null\n  };\n}\n\nfunction getDetailAttributes(detail) {\n  const attributes = [];\n\n  if (Array.isArray(detail.resolvedInfluences) && detail.resolvedInfluences.length > 0) {\n    for (const item of detail.resolvedInfluences) {\n      attributes.push({\n        attributeCode: item.attributeCode,\n        attributeName: item.attributeName || getAttributeName(item.attributeCode),\n        value: item.value,\n        role: \"SOURCE\",\n        definition: item.definition || attributeDefinitionMap[item.attributeCode]\n      });\n    }\n  } else {\n    for (const item of detail.influences || []) {\n      const resolved = resolveAttribute(item.attribute);\n\n      attributes.push({\n        attributeCode: resolved.code,\n        attributeName: resolved.name,\n        value: item.value,\n        role: \"SOURCE\",\n        definition: resolved.definition\n      });\n    }\n  }\n\n  if (Array.isArray(detail.resolvedTargets) && detail.resolvedTargets.length > 0) {\n    for (const item of detail.resolvedTargets) {\n      attributes.push({\n        attributeCode: item.attributeCode,\n        attributeName: item.attributeName || getAttributeName(item.attributeCode),\n        value: item.value,\n        role: \"TARGET\",\n        definition: item.definition || attributeDefinitionMap[item.attributeCode]\n      });\n    }\n  } else {\n    for (const item of detail.targets || []) {\n      const resolved = resolveAttribute(item.attribute);\n\n      attributes.push({\n        attributeCode: resolved.code,\n        attributeName: resolved.name,\n        value: item.value,\n        role: \"TARGET\",\n        definition: resolved.definition\n      });\n    }\n  }\n\n  return attributes;\n}\n\nfunction findAttributeInDetail(detailAttributes, attributeCode) {\n  return detailAttributes.find(item => item.attributeCode === attributeCode);\n}\n\nfunction addDependencyError(detail, message) {\n  const alreadyExists = dependencyErrors.some(\n    error => error.detailId === detail.detailId && error.message === message\n  );\n\n  if (!alreadyExists) {\n    dependencyErrors.push({\n      detailId: detail.detailId,\n      message\n    });\n  }\n}\n\nfunction addNormalAttributeValue(item, detail, roleOverride) {\n  const attributeCode = item.attributeCode;\n  const definition = item.definition || attributeDefinitionMap[attributeCode];\n\n  if (!attributeCode || !definition) {\n    return;\n  }\n\n  const role = roleOverride || item.role;\n\n  if (!attributeValuesMap[attributeCode]) {\n    attributeValuesMap[attributeCode] = {\n      attributeCode,\n      attributeName: item.attributeName || getAttributeName(attributeCode),\n      sourceType: definition.sourceType,\n      api: definition.api,\n      param: definition.param,\n      dependsOn: null,\n      values: {}\n    };\n  }\n\n  const key = valueKey(item.value);\n\n  if (!attributeValuesMap[attributeCode].values[key]) {\n    attributeValuesMap[attributeCode].values[key] = {\n      value: item.value,\n      valueId: null,\n      roles: [],\n      detailIds: []\n    };\n  }\n\n  addUnique(attributeValuesMap[attributeCode].values[key].roles, role);\n  addUnique(attributeValuesMap[attributeCode].values[key].detailIds, detail.detailId);\n}\n\nfunction buildDependencyInfo(item, detail, detailAttributes) {\n  const attributeCode = item.attributeCode;\n  const attributeName = item.attributeName || getAttributeName(attributeCode);\n  const definition = item.definition || attributeDefinitionMap[attributeCode];\n  const dependsOn = definition?.dependsOn;\n\n  if (!dependsOn) {\n    return {\n      hasDependency: false\n    };\n  }\n\n  const dependsOnName = getAttributeName(dependsOn);\n  const dependencyItem = findAttributeInDetail(detailAttributes, dependsOn);\n\n  if (!dependencyItem || String(dependencyItem.value || \"\").trim() === \"\") {\n    addDependencyError(detail, `${dependsOnName} is mandatory for ${attributeName}.`);\n\n    return {\n      hasError: true\n    };\n  }\n\n  const dependencyDefinition =\n    dependencyItem.definition || attributeDefinitionMap[dependsOn];\n  const parentDependsOn = dependencyDefinition?.dependsOn || null;\n\n  if (!parentDependsOn) {\n    return {\n      hasDependency: true,\n      dependencyDepth: 1,\n      dependsOn,\n      dependsOnName,\n      dependsOnValue: dependencyItem.value,\n      parentDependsOn: null,\n      parentDependsOnName: null,\n      parentDependsOnValue: null\n    };\n  }\n\n  const parentDependsOnName = getAttributeName(parentDependsOn);\n  const parentDependencyItem = findAttributeInDetail(detailAttributes, parentDependsOn);\n\n  if (!parentDependencyItem || String(parentDependencyItem.value || \"\").trim() === \"\") {\n    addDependencyError(detail, `${parentDependsOnName} is mandatory for ${dependsOnName}.`);\n\n    return {\n      hasError: true\n    };\n  }\n\n  const parentDependencyDefinition =\n    parentDependencyItem.definition || attributeDefinitionMap[parentDependsOn];\n\n  if (parentDependencyDefinition?.dependsOn) {\n    addDependencyError(detail, `Only two-level dependency is supported for ${attributeName}.`);\n\n    return {\n      hasError: true\n    };\n  }\n\n  return {\n    hasDependency: true,\n    dependencyDepth: 2,\n    dependsOn,\n    dependsOnName,\n    dependsOnValue: dependencyItem.value,\n    parentDependsOn,\n    parentDependsOnName,\n    parentDependsOnValue: parentDependencyItem.value\n  };\n}\n\nfunction buildDependentValueKey(item, dependencyInfo) {\n  const parts = [];\n\n  if (dependencyInfo.parentDependsOn) {\n    parts.push(dependencyInfo.parentDependsOn);\n    parts.push(valueKey(dependencyInfo.parentDependsOnValue));\n  }\n\n  parts.push(dependencyInfo.dependsOn);\n  parts.push(valueKey(dependencyInfo.dependsOnValue));\n  parts.push(item.attributeCode);\n  parts.push(valueKey(item.value));\n\n  return parts.join(\"::\");\n}\n\nfunction addDependentAttributeValue(item, detail, detailAttributes, roleOverride) {\n  const attributeCode = item.attributeCode;\n  const attributeName = item.attributeName || getAttributeName(attributeCode);\n  const definition = item.definition || attributeDefinitionMap[attributeCode];\n\n  if (!attributeCode || !definition) {\n    return;\n  }\n\n  const dependencyInfo = buildDependencyInfo(item, detail, detailAttributes);\n\n  if (dependencyInfo.hasError || !dependencyInfo.hasDependency) {\n    return;\n  }\n\n  const role = roleOverride || item.role;\n\n  if (!dependentAttributeValuesMap[attributeCode]) {\n    dependentAttributeValuesMap[attributeCode] = {\n      attributeCode,\n      attributeName,\n      sourceType: definition.sourceType,\n      api: definition.api,\n      param: definition.param,\n      dependsOn: dependencyInfo.dependsOn,\n      dependsOnName: dependencyInfo.dependsOnName,\n      parentDependsOn: dependencyInfo.parentDependsOn,\n      parentDependsOnName: dependencyInfo.parentDependsOnName,\n      dependencyDepth: dependencyInfo.dependencyDepth,\n      values: {}\n    };\n  }\n\n  const key = buildDependentValueKey(item, dependencyInfo);\n\n  if (!dependentAttributeValuesMap[attributeCode].values[key]) {\n    const dependencyChain = [];\n\n    if (dependencyInfo.parentDependsOn) {\n      dependencyChain.push({\n        attributeCode: dependencyInfo.parentDependsOn,\n        attributeName: dependencyInfo.parentDependsOnName,\n        value: dependencyInfo.parentDependsOnValue,\n        valueId: null\n      });\n    }\n\n    dependencyChain.push({\n      attributeCode: dependencyInfo.dependsOn,\n      attributeName: dependencyInfo.dependsOnName,\n      value: dependencyInfo.dependsOnValue,\n      valueId: null\n    });\n\n    dependentAttributeValuesMap[attributeCode].values[key] = {\n      value: item.value,\n      valueId: null,\n      dependsOn: dependencyInfo.dependsOn,\n      dependsOnName: dependencyInfo.dependsOnName,\n      dependsOnValue: dependencyInfo.dependsOnValue,\n      dependsOnValueId: null,\n      parentDependsOn: dependencyInfo.parentDependsOn,\n      parentDependsOnName: dependencyInfo.parentDependsOnName,\n      parentDependsOnValue: dependencyInfo.parentDependsOnValue,\n      parentDependsOnValueId: null,\n      dependencyDepth: dependencyInfo.dependencyDepth,\n      dependencyChain,\n      roles: [],\n      detailIds: []\n    };\n  }\n\n  addUnique(dependentAttributeValuesMap[attributeCode].values[key].roles, role);\n  addUnique(dependentAttributeValuesMap[attributeCode].values[key].detailIds, detail.detailId);\n\n  const dependencyItem = findAttributeInDetail(detailAttributes, dependencyInfo.dependsOn);\n\n  if (dependencyItem) {\n    const dependencyDefinition =\n      dependencyItem.definition || attributeDefinitionMap[dependencyInfo.dependsOn];\n\n    if (dependencyDefinition?.dependsOn) {\n      addDependentAttributeValue(dependencyItem, detail, detailAttributes, \"DEPENDENCY\");\n    } else {\n      addNormalAttributeValue(dependencyItem, detail, \"DEPENDENCY\");\n    }\n  }\n\n  if (dependencyInfo.parentDependsOn) {\n    const parentDependencyItem = findAttributeInDetail(\n      detailAttributes,\n      dependencyInfo.parentDependsOn\n    );\n\n    if (parentDependencyItem) {\n      addNormalAttributeValue(parentDependencyItem, detail, \"DEPENDENCY\");\n    }\n  }\n}\n\n\nfunction cleanInternalSets(value) {\n  if (Array.isArray(value)) {\n    delete value._seen;\n    for (const item of value) cleanInternalSets(item);\n    return value;\n  }\n  if (value && typeof value === \"object\") {\n    for (const key of Object.keys(value)) cleanInternalSets(value[key]);\n  }\n  return value;\n}\n\nfunction toCollectionArray(valuesMap) {\n  return Object.values(valuesMap).map(attribute => ({\n    ...attribute,\n    values: Object.values(attribute.values)\n  }));\n}\n\nfor (const detail of validPolicyDetails) {\n  const detailAttributes = getDetailAttributes(detail);\n\n  for (const item of detailAttributes) {\n    const definition = item.definition || attributeDefinitionMap[item.attributeCode];\n\n    if (!item.attributeCode || !definition) {\n      continue;\n    }\n\n    if (definition.dependsOn) {\n      addDependentAttributeValue(item, detail, detailAttributes);\n    } else {\n      addNormalAttributeValue(item, detail);\n    }\n  }\n}\n\nreturn {\n  collection: toCollectionArray(attributeValuesMap),\n  dependentCollection: toCollectionArray(dependentAttributeValuesMap),\n  dependencyErrors\n};\n"
