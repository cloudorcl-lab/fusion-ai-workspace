              "id": "1775553772777",
              "name": "pAttributeMapping",
              "scope": "JOB",
              "type": "object",
              "value": "{\n  \"ORA_INVOICE_CURRENCY_CODE\": {\n    \"callType\": \"tvvs\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_AP_CURRENCY_VS\",\n    \"depValue\": null\n  },\n  \"ORA_TAXATION_COUNTRY\": {\n    \"callType\": \"tvvs\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"HZ_VALIDATION_COUNTRY\",\n    \"depValue\": null\n  },\n  \"ORA_SHIP_TO_LOCATION_ID\": {\n    \"callType\": \"tvvs\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_AP_HR_LOCATION_ID_VS\",\n    \"depValue\": null\n  },\n  \"ORA_PAYMENT_CURRENCY_CODE\": {\n    \"callType\": \"tvvs\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_AP_CURRENCY_VS\",\n    \"depValue\": null\n  },\n  \"ORA_DISTRIBUTION_SET_ID\": {\n    \"callType\": \"DEPTVVS\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_AP_DIST_SET_VS\",\n    \"depValue\": \"ORA_BU_ID\"\n  },\n  \"ORA_REQUESTER_ID\": {\n    \"callType\": \"tvvs\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_AP_REQUESTER_ID_VS\",\n    \"depValue\": null\n  },\n  \"ORA_PURCHASING_CATEGORY_ID\": {\n    \"callType\": \"tvvs\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_CST_XLA_PUR_CATEGORIES_VS\",\n    \"depValue\": null\n  },\n  \"ORA_ASSET_BOOK_TYPE_CODE\": {\n    \"callType\": \"tvvs\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_FA_ASSET_BOOKS\",\n    \"depValue\": null\n  },\n  \"ORA_ASSET_CATEGORY_ID\": {\n    \"callType\": \"tvvs\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_FA_ASSET_CATEGORIES\",\n    \"depValue\": null\n  },\n  \"ORA_PROJ_CONTRACT_ID\": {\n    \"callType\": \"DEPTVVS\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_PJC_AWARD_ATTRIB_DFLT_VS\",\n    \"depValue\": \"ORA_PROJECT_ID\"\n  },\n  \"ORA_PROJ_ORGANIZATION_ID\": {\n    \"callType\": \"DEPTVVS\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_PJC_EXPORG_ATTRIB_DFLT_VS\",\n    \"depValue\": \"ORA_BU_ID\"\n  },\n  \"ORA_PROJ_EXP_TYPE_ID\": {\n    \"callType\": \"DEPTVVS\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_PJC_EXPTYPE_ATTRIB_DFLT_VS\",\n    \"depValue\": \"ORA_PROJECT_ID\"\n  },\n  \"ORA_PROJ_FUNDING_SOURCE\": {\n    \"callType\": \"DEPTVVS\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_PJC_FS_ATTRIB_DFLT_VS\",\n    \"depValue\": \"ORA_PROJ_CONTRACT_ID\"\n  },\n  \"ORA_PROJ_TASK_ID\": {\n    \"callType\": \"DEPTVVS\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_PJC_TASK_ATTRIB_DFLT_VS\",\n    \"depValue\": \"ORA_PROJECT_ID\"\n  },\n  \"ORA_DOCUMENT_SUB_TYPE\": {\n    \"callType\": \"tvvs\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_ZX_FC_DOC_SUB_TYPE_VS\",\n    \"depValue\": null\n  },\n  \"ORA_INTENDED_USE\": {\n    \"callType\": \"tvvs\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_ZX_FC_INTND_USE_VS\",\n    \"depValue\": null\n  },\n  \"ORA_PROD_FISC_CLASSIFICATION\": {\n    \"callType\": \"tvvs\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_ZX_FC_PROD_FISC_CLASS_VS\",\n    \"depValue\": null\n  },\n  \"ORA_USER_DEFINED_FISC_CLASS\": {\n    \"callType\": \"tvvs\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_ZX_FC_USER_DEFINED_VS\",\n    \"depValue\": null\n  },\n  \"ORA_FINAL_DISCHARGE_LOC_ID\": {\n    \"callType\": \"tvvs\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_ZX_FINAL_DISCHRG_LOC_VS\",\n    \"depValue\": null\n  },\n  \"ORA_PRODUCT_TYPE\": {\n    \"callType\": \"tvvs\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_ZX_PRODUCT_TYPES_VS\",\n    \"depValue\": null\n  },\n  \"ORA_LINE_DISTRIBUTION_CCID\": {\n    \"callType\": \"DEPTVVS\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_AP_CODE_COMBINATIONS\",\n    \"depValue\": \"ORA_PRIMARY_LEDGER_ID\"\n  },\n  \"ORA_LIABILITY_CCID\": {\n    \"callType\": \"DEPTVVS\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_AP_CODE_COMBINATIONS\",\n    \"depValue\": \"ORA_PRIMARY_LEDGER_ID\"\n  },\n  \"ORA_DEF_ACCTG_ACCRUAL_CCID\": {\n    \"callType\": \"DEPTVVS\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_AP_CODE_COMBINATIONS\",\n    \"depValue\": \"ORA_PRIMARY_LEDGER_ID\"\n  },\n  \"ORA_LEGAL_ENTITY_COUNTRY\": {\n    \"callType\": \"tvvs\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"HZ_VALIDATION_COUNTRY\",\n    \"depValue\": null\n  },\n  \"ORA_PROJECT_ID\": {\n    \"callType\": \"DEPTVVS\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_PJC_PROJECT_ATTRIBBUILDER_VS\",\n    \"depValue\": \"ORA_BU_ID\"\n  },\n  \"ORA_PRODUCT_CATEGORY\": {\n    \"callType\": \"tvvs\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_ZX_FC_PRODUCT_CATEGORIES_VS\",\n    \"depValue\": null\n  },\n  \"ORA_TRX_BUSINESS_CATEGORY\": {\n    \"callType\": \"tvvs\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_ZX_FC_BUSINESS_CATEGORIES_VS\",\n    \"depValue\": null\n  },\n  \"ORA_REGIONAL_INFORMATION\": {\n    \"callType\": \"DEPTVVS\",\n    \"apiName\": \"getValueSetValues\",\n    \"apiParam\": \"ORA_AP_INV_GDF_CONTEXT\",\n    \"depValue\": \"ORA_LEGAL_ENTITY_ID\"\n  },\n  \"ORA_AP_INVOICE_SOURCE\": {\n    \"callType\": \"lookupType\",\n    \"apiName\": \"getLookupValues\",\n    \"apiParam\": \"SOURCE\",\n    \"depValue\": null\n  },\n  \"ORA_PAY_GROUP_LOOKUP_CODE\": {\n    \"callType\": \"lookupType\",\n    \"apiName\": \"getLookupValues\",\n    \"apiParam\": \"PAY GROUP\",\n    \"depValue\": null\n  },\n  \"ORA_VENDOR_TYPE_LOOKUP_CODE\": {\n    \"callType\": \"lookupType\",\n    \"apiName\": \"getLookupValues\",\n    \"apiParam\": \"POZ_VENDOR_TYPE\",\n    \"depValue\": null\n  },\n  \"ORA_ASSETS_TRACKING_FLAG\": {\n    \"callType\": \"lookupType\",\n    \"apiName\": \"getLookupValues\",\n    \"apiParam\": \"LINE_YES_NO\",\n    \"depValue\": null\n  },\n  \"ORA_INVOICE_TYPE_CODE\": {\n    \"callType\": \"lookupType\",\n    \"apiName\": \"getLookupValues\",\n    \"apiParam\": \"INVOICE TYPE\",\n    \"depValue\": null\n  },\n  \"ORA_LINE_TYPE_CODE\": {\n    \"callType\": \"lookupType\",\n    \"apiName\": \"getLookupValues\",\n    \"apiParam\": \"INVOICE LINE TYPE\",\n    \"depValue\": null\n  }\n}"
