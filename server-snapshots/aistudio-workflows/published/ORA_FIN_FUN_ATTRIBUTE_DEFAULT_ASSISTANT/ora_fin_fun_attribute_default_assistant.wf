        {
          "metadata": {
            "name": "Build Attribute Source Index",
            "returnType": "object",
            "sourceCode": "function parse(value) {\n  if (typeof value !== \"string\") return value;\n  const text = value.trim();\n  if (!text || (text[0] !== \"{\" && text[0] !== \"[\")) return value;\n  try { return JSON.parse(text); } catch (e) { return value; }\n}\n\nfunction unwrap(value) {\n  value = parse(value);\n  if (value && typeof value === \"object\" && value.result !== undefined) return unwrap(value.result);\n  if (value && typeof value === \"object\" && value.output !== undefined) return unwrap(value.output);\n  if (value && typeof value === \"object\" && value.body !== undefined) return unwrap(value.body);\n  return value;\n}\n\nfunction collectItems(value, rows) {\n  value = unwrap(value);\n  if (value == null) return;\n  if (Array.isArray(value)) {\n    for (const item of value) collectItems(item, rows);\n    return;\n  }\n  if (typeof value !== \"object\") return;\n  if (Array.isArray(value.items)) collectItems(value.items, rows);\n  if (Array.isArray(value.results)) collectItems(value.results, rows);\n  if (value.$output !== undefined) collectItems(value.$output, rows);\n  if (value.AttributeCode || value.SourceCode || value.AttributeName || value.DisplayName || value.Prompt || value.TargetTableId) rows.push(value);\n  for (const key of Object.keys(value)) {\n    if (key === \"items\" || key === \"results\" || key === \"$output\") continue;\n    const child = value[key];\n    if (child && typeof child === \"object\") collectItems(child, rows);\n  }\n}\n\nfunction norm(value) {\n  return String(value == null ? \"\" : value).trim().replace(/\\s+/g, \" \").toUpperCase();\n}\n\nfunction looseNorm(value) {\n  return String(value == null ? \"\" : value).trim().replace(/[^A-Za-z0-9]+/g, \"\").toUpperCase();\n}\n\nfunction firstNonBlank() {\n  for (let i = 0; i < arguments.length; i++) {\n    const value = arguments[i];\n    if (value !== undefined && value !== null && String(value).trim() !== \"\") return value;\n  }\n  return \"\";\n}\n\nfunction addName(index, name, code) {\n  const key = norm(name);\n  const looseKey = looseNorm(name);\n  if (!key || !code) return;\n  const existing = index.byNormalizedName[key];\n  if (!existing) {\n    index.byNormalizedName[key] = code;\n  } else if (existing !== code) {\n    index.ambiguousNames[key] = true;\n    delete index.byNormalizedName[key];\n  }\n  if (looseKey && looseKey !== key) {\n    const looseExisting = index.byNormalizedName[looseKey];\n    if (!looseExisting) {\n      index.byNormalizedName[looseKey] = code;\n    } else if (looseExisting !== code) {\n      index.ambiguousNames[looseKey] = true;\n      delete index.byNormalizedName[looseKey];\n    }\n  }\n}\n\nconst rows = [];\ncollectItems($context.$nodes.GETALLSOURCES_CALL.$output, rows);\nconst request = unwrap($context.$nodes.BUILD_ATTRIBUTE_METADATA_REQUEST.$output) || {};\nconst attributeDefinitionMap = $context.$variables.attributeDefinitionMap || {};\nconst targetRuleDefinitionMap = $context.$variables.targetRuleDefinitionMap || {};\nconst index = { byCode: {}, byNormalizedName: {}, ambiguousNames: {}, rowCount: 0, requestedAttributeCodes: request.attributeCodes || [] };\n\nfor (const row of rows) {\n  const code = String(firstNonBlank(row.AttributeCode, row.SourceCode, row.SourceAttributeCode, row.Code)).trim();\n  if (!code) continue;\n  const displayName = String(firstNonBlank(row.AttributeName, row.DisplayName, row.Prompt, row.Name, row.Meaning, code)).trim();\n  const normalized = {\n    ...row,\n    AttributeCode: code,\n    DisplayName: displayName,\n    TargetTableId: firstNonBlank(row.TargetTableId, row.SourceApplicationId, row.SourceTableId, row.TableId),\n    LookupTypeCode: firstNonBlank(row.LookupTypeCode, row.LookupType, row.SourceLookupCode),\n    ValueSetCode: firstNonBlank(row.ValueSetCode, row.ValueSetId, row.SourceValueSetCode)\n  };\n  index.byCode[code] = { ...(index.byCode[code] || {}), ...normalized };\n  addName(index, code, code);\n  addName(index, displayName, code);\n  addName(index, row.AttributeName, code);\n  addName(index, row.DisplayName, code);\n  addName(index, row.Prompt, code);\n  index.rowCount += 1;\n}\n\nfor (const [code, definition] of Object.entries(attributeDefinitionMap)) {\n  const existing = index.byCode[code] || {};\n  const displayName = firstNonBlank(existing.DisplayName, code);\n  index.byCode[code] = { ...definition, ...existing, AttributeCode: code, DisplayName: displayName };\n  addName(index, code, code);\n  addName(index, displayName, code);\n}\n\nfor (const [code, rule] of Object.entries(targetRuleDefinitionMap)) {\n  const existing = index.byCode[code] || {};\n  const displayName = firstNonBlank(existing.DisplayName, code);\n  index.byCode[code] = { ...rule, ...existing, AttributeCode: code, DisplayName: displayName };\n  addName(index, code, code);\n  addName(index, displayName, code);\n}\n\nreturn index;"
          },
