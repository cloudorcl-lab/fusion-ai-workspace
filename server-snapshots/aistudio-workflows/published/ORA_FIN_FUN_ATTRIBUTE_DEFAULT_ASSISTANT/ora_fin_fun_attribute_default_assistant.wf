                            "sourceCode": "// Code Node: Build Mapping Set Values REST Batch Payload With Flavor Replace\n\nconst currentTargetOutput =\n  $context.$nodes.CREATE_ATTRIBUTE_BUILDER_MAPPINGS.ENRICHTARGETMAPPINGMETADATA?.$output?.result ||\n  $context.$nodes.CREATE_ATTRIBUTE_BUILDER_MAPPINGS.$currentItem ||\n  null;\n\nconst previousOutput =\n  $context.$nodes.PROCESS_TARGET_ATTRIBUTE_CHUNKS.MERGETARGETPOLICYBATCHES?.$output?.result ||\n  $context.$nodes.PROCESS_TARGET_ATTRIBUTE_CHUNKS.MERGETARGETPOLICYBATCHES?.$output ||\n  {};\n\nconst mappingSetOutput = {};\n\nconst createdFlavorOutput =\n  $context.$nodes.PROCESS_TARGET_ATTRIBUTE_CHUNKS.EXTRACT_TARGET_CREATED_MAPPING_SET_FLAVOR?.$output ||\n  $context.$nodes.PROCESS_TARGET_ATTRIBUTE_CHUNKS.CREATE_TARGET_REPLACEMENT_MAPPING_SET_FLAVOR?.$output ||\n  {};\n\nconst oldFlavorOutput =\n  $context.$nodes.PROCESS_TARGET_ATTRIBUTE_CHUNKS.RETURNRULEMETADATA?.$output || {};\n\nconst MAX_INPUTS = 10;\n\nfunction tryParseJson(value) {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  let text = value.trim();\n\n  if (!text) {\n    return value;\n  }\n\n  try {\n    return JSON.parse(text);\n  } catch (e) {\n    // Continue.\n  }\n\n  if (\n    (text.startsWith(\"'\") && text.endsWith(\"'\")) ||\n    (text.startsWith(\"\\\"\") && text.endsWith(\"\\\"\"))\n  ) {\n    text = text.substring(1, text.length - 1);\n\n    try {\n      return JSON.parse(text);\n    } catch (e) {\n      // Continue.\n    }\n\n  }\n\n  const firstObject = text.indexOf(\"{\");\n  const firstArray = text.indexOf(\"[\");\n  let start = -1;\n\n  if (firstObject >= 0 && firstArray >= 0) {\n    start = Math.min(firstObject, firstArray);\n  } else if (firstObject >= 0) {\n    start = firstObject;\n  } else if (firstArray >= 0) {\n    start = firstArray;\n  }\n\n  const end = Math.max(text.lastIndexOf(\"}\"), text.lastIndexOf(\"]\"));\n\n  if (start >= 0 && end > start) {\n    try {\n      return JSON.parse(text.substring(start, end + 1));\n    } catch (e) {\n      return value;\n    }\n  }\n\n  return value;\n}\n\nfunction unwrapOutput(output) {\n  if (output === null || output === undefined || output === \"\") {\n    return {};\n  }\n\n  const parsed = tryParseJson(output);\n\n  if (parsed !== output) {\n    return unwrapOutput(parsed);\n  }\n\n  if (Array.isArray(output)) {\n    if (output.length === 1) {\n      return unwrapOutput(output[0]);\n    }\n\n    return output.map(item => unwrapOutput(item));\n  }\n\n  if (typeof output === \"object\") {\n    if (output.result !== undefined) {\n      return unwrapOutput(output.result);\n    }\n\n    if (output.output !== undefined) {\n      return unwrapOutput(output.output);\n    }\n\n    if (output.body !== undefined) {\n      return unwrapOutput(output.body);\n    }\n  }\n\n  return output;\n}\n\nfunction getItems(output) {\n  const unwrappedOutput = unwrapOutput(output);\n\n  if (Array.isArray(unwrappedOutput)) {\n    return unwrappedOutput;\n  }\n\n  if (Array.isArray(unwrappedOutput.items)) {\n    return unwrappedOutput.items;\n  }\n\n  if (Array.isArray(unwrappedOutput.collection)) {\n    return unwrappedOutput.collection;\n  }\n\n  if (unwrappedOutput && typeof unwrappedOutput === \"object\") {\n    return [unwrappedOutput];\n  }\n\n  return [];\n}\n\nfunction normalize(value) {\n  return String(value ?? \"\").trim().toUpperCase();\n}\n\nfunction getTargetCollection(currentTarget, fallbackOutput) {\n  const unwrappedCurrentTarget = unwrapOutput(currentTarget);\n\n  if (\n    unwrappedCurrentTarget &&\n    !Array.isArray(unwrappedCurrentTarget) &&\n    typeof unwrappedCurrentTarget === \"object\" &&\n    (\n      unwrappedCurrentTarget.TargetAttributeCode ||\n      unwrappedCurrentTarget.MappingSetCode ||\n      Array.isArray(unwrappedCurrentTarget.MSPayload)\n    )\n  ) {\n    return [unwrappedCurrentTarget];\n  }\n\n  if (Array.isArray(unwrappedCurrentTarget)) {\n    return unwrappedCurrentTarget;\n  }\n\n  const unwrappedFallbackOutput = unwrapOutput(fallbackOutput);\n\n  if (Array.isArray(unwrappedFallbackOutput)) {\n    return unwrappedFallbackOutput;\n  }\n\n  if (Array.isArray(unwrappedFallbackOutput.collection)) {\n    return unwrappedFallbackOutput.collection;\n  }\n\n  if (Array.isArray(unwrappedFallbackOutput.mappingSetPayloadByTarget)) {\n    return unwrappedFallbackOutput.mappingSetPayloadByTarget;\n  }\n\n  return [];\n}\n\nfunction findMappingSetItem(target, targetIndex, mappingSetItems) {\n  const targetMappingSetCode = normalize(target.MappingSetCode);\n  const targetAttributeCode = normalize(target.TargetAttributeCode);\n\n  for (const item of mappingSetItems) {\n    if (\n      normalize(item.MappingSetCode) === targetMappingSetCode ||\n      normalize(item.mappingSetCode) === targetMappingSetCode ||\n      normalize(item.Code) === targetMappingSetCode ||\n      normalize(item.code) === targetMappingSetCode ||\n      normalize(item.TargetAttributeCode) === targetAttributeCode ||\n      normalize(item.targetAttributeCode) === targetAttributeCode\n    ) {\n      return item;\n    }\n  }\n\n  return mappingSetItems[targetIndex] || mappingSetItems[0] || {};\n}\n\nfunction getMappingSetId(target, targetIndex, mappingSetItems) {\n  if (target.MappingSetId || target.mappingSetId) {\n    return target.MappingSetId || target.mappingSetId;\n  }\n\n  const mappingSetItem = findMappingSetItem(target, targetIndex, mappingSetItems);\n\n  return mappingSetItem.MappingSetId || mappingSetItem.mappingSetId || \"\";\n}\n\nfunction buildMappingSetValuePath(mappingSetId, mappingSetFlavorId) {\n  return \"/attributeDerivationMappingSets/\" + mappingSetId + \"/child/FunAdmMappingSetFlavor/\" + mappingSetFlavorId + \"/child/FunAdmMappingSetValues\";\n}\n\nfunction addInputValueConstants(payload, row) {\n  for (let i = 1; i <= MAX_INPUTS; i++) {\n    const sourceValueIdKey = \"Input\" + i + \"SourceValueId\";\n\n    if (Object.prototype.hasOwnProperty.call(row, sourceValueIdKey)) {\n      payload[\"InputValueConstant\" + i] = row[sourceValueIdKey] ?? \"\";\n    }\n  }\n}\n\nconst targetCollection = getTargetCollection(currentTargetOutput, previousOutput);\nconst mappingSetItems = getItems(mappingSetOutput);\nconst createdFlavor = unwrapOutput(createdFlavorOutput) || {};\nconst oldFlavor = unwrapOutput(oldFlavorOutput) || {};\nconst newMappingSetFlavorId = createdFlavor.MappingSetFlavorId || createdFlavor.mappingSetFlavorId || \"\";\nconst oldMappingSetFlavorId =\n  oldFlavor.MappingSetFlavorId ||\n  oldFlavor.mappingSetFlavorId ||\n  unwrapOutput(currentTargetOutput).MappingSetFlavorId ||\n  \"\";\nconst newStripeId = createdFlavor.StripeId ?? createdFlavor.stripeId ?? unwrapOutput(currentTargetOutput).StripeId ?? oldFlavor.StripeId ?? 0;\n\nconst parts = [];\nlet desiredCount = 0;\n\nfor (let targetIndex = 0; targetIndex < targetCollection.length; targetIndex++) {\n  const target = targetCollection[targetIndex];\n  const mappingSetId = getMappingSetId(target, targetIndex, mappingSetItems);\n  const mappingSetCode = target.MappingSetCode || \"\";\n  const msPayloadRows = Array.isArray(target.MSPayload) ? target.MSPayload : [];\n\n  for (const row of msPayloadRows) {\n    const payload = {\n      EffectiveEndDate: \"4712-12-31\",\n      EffectiveStartDate: \"1951-01-01\",\n      Enabled: \"Y\"\n    };\n\n    addInputValueConstants(payload, row);\n\n    payload.MappingSetCode = mappingSetCode;\n    payload.StripeId = newStripeId;\n    payload.ValueConstant = row.OutputValueId ?? \"\";\n\n    desiredCount += 1;\n\n    parts.push({\n      id: String(row.detailId || (\"part\" + desiredCount)),\n      path: buildMappingSetValuePath(mappingSetId, newMappingSetFlavorId),\n      operation: \"create\",\n      payload\n    });\n  }\n}\n\nreturn {\n  parts,\n  replaceSummary: {\n    flavorDeleted: !!oldMappingSetFlavorId,\n    flavorCreated: !!newMappingSetFlavorId,\n    createCount: parts.length,\n    mappingSetId: parts.length > 0 ? parts[0].path.split(\"/\")[2] : null,\n    mappingSetFlavorId: newMappingSetFlavorId || null\n  }\n};"
