                  "code": "PREPARE_EXPRESSION_DELETE",
                  "id": "PREPARE_EXPRESSION_DELETE",
                  "metadata": {
                    "name": "Prepare Expression Delete",
                    "returnType": "object",
                    "position": {
                      "x": 1520,
                      "y": 200
                    },
                    "sourceCode": "var normalized = ($context.$nodes && $context.$nodes.NORMALIZE_ROLLBACK_ACTION && $context.$nodes.NORMALIZE_ROLLBACK_ACTION.$output)\n  ? $context.$nodes.NORMALIZE_ROLLBACK_ACTION.$output.result\n  : null;\nvar action = normalized && normalized.action\n  ? normalized.action\n  : null;\n\nvar normalizeUrl = function(url) {\n  if (!url) {\n    return null;\n  }\n  var s = String(url);\n  var idx = s.indexOf('/fscmRestApi/');\n  return idx >= 0 ? s.substring(idx) : s;\n};\n\nvar extractKeyFromCanonicalUrl = function(url) {\n  var normalized = normalizeUrl(url);\n  if (!normalized) {\n    return null;\n  }\n  var parts = normalized.split('/');\n  var last = parts.length ? parts[parts.length - 1] : null;\n  if (!last) {\n    return null;\n  }\n  try {\n    return decodeURIComponent(last);\n  } catch (_err) {\n    return last;\n  }\n};\n\nvar result = new Object();\nresult.expressionId = null;\n\nif (action && action.type === 'expression') {\n  if (action.deleteId) {\n    result.expressionId = String(action.deleteId);\n  } else {\n    var fromUrl = extractKeyFromCanonicalUrl(action.canonicalUrl);\n    if (fromUrl) {\n      result.expressionId = fromUrl;\n    } else if (action.icId !== null && action.orgId !== null) {\n      result.expressionId = String(action.orgId) + ',' + String(action.icId);\n    } else if (action.icId !== null) {\n      result.expressionId = String(action.icId);\n    }\n  }\n}\n\nreturn result;"
