            "name": "Assemble Rollback Result",
            "returnType": "object",
            "sourceCode": "var prepared = ($context.$nodes.PREPARE_ROLLBACK_REQUEST && $context.$nodes.PREPARE_ROLLBACK_REQUEST.$output)\n  ? $context.$nodes.PREPARE_ROLLBACK_REQUEST.$output.result\n  : new Object();\n\nvar errors = prepared.errors ? prepared.errors.slice ? prepared.errors.slice() : prepared.errors : [];\nif (!Array.isArray(errors)) {\n  errors = [];\n}\nvar rawActionResults = $context.$variables.actionResults;\nvar rawRollbackActions = $context.$variables.rollbackActions;\nvar stateErrors = [];\nvar actionResults = [];\nvar rollbackActions = [];\nif (rawActionResults === undefined || rawActionResults === null) {\n  actionResults = [];\n} else if (Array.isArray(rawActionResults)) {\n  actionResults = rawActionResults;\n} else {\n  stateErrors.push('Malformed rollback state: actionResults must be an array.');\n}\nif (rawRollbackActions === undefined || rawRollbackActions === null) {\n  rollbackActions = [];\n} else if (Array.isArray(rawRollbackActions)) {\n  rollbackActions = rawRollbackActions;\n} else {\n  stateErrors.push('Malformed rollback state: rollbackActions must be an array.');\n}\nvar rolledBackCount = 0;\nvar alreadyMissingCount = 0;\nvar failedCount = 0;\nvar skippedCount = 0;\nvar malformedCount = 0;\nvar rolledBackActions = [];\nvar alreadyMissingActions = [];\nvar failedActions = [];\nvar skippedActions = [];\nvar i = 0;\nfor (i = 0; i < actionResults.length; i += 1) {\n  var entry = actionResults[i] ? actionResults[i] : new Object();\n  if (entry.status === 'ROLLED_BACK') {\n    rolledBackCount += 1;\n    rolledBackActions.push(entry);\n  } else if (entry.status === 'ALREADY_MISSING') {\n    alreadyMissingCount += 1;\n    alreadyMissingActions.push(entry);\n  } else if (entry.status === 'FAILED') {\n    failedCount += 1;\n    failedActions.push(entry);\n  } else if (entry.status === 'SKIPPED') {\n    skippedCount += 1;\n    skippedActions.push(entry);\n  } else {\n    malformedCount += 1;\n    failedCount += 1;\n    failedActions.push(entry);\n  }\n  if (entry.internalFailure === true) {\n    malformedCount += 1;\n  }\n}\n\nvar result = new Object();\nresult.valid = prepared.valid === true;\nfor (i = 0; i < stateErrors.length; i += 1) {\n  errors.push(stateErrors[i]);\n}\nif (malformedCount > 0 && stateErrors.length === 0) {\n  errors.push('Malformed rollback audit state detected.');\n}\nresult.errors = errors;\nresult.warnings = prepared.warnings ? prepared.warnings : [];\nresult.executionMode = prepared.executionMode ? prepared.executionMode : 'publishFailureRollback';\nresult.requestCounts = prepared.requestCounts ? prepared.requestCounts : new Object();\nresult.actions = actionResults;\nresult.rollbackAudit = actionResults;\nresult.processedCount = actionResults.length;\nresult.totalActions = rollbackActions.length;\nvar candidates = result.requestCounts && result.requestCounts.candidates ? Number(result.requestCounts.candidates) : 0;\nvar accepted = result.requestCounts && result.requestCounts.accepted ? Number(result.requestCounts.accepted) : 0;\nvar remainingActions = [];\nvar processedByIndex = new Object();\nfor (i = 0; i < actionResults.length; i += 1) {\n  var processedIndex = actionResults[i] && actionResults[i].index !== undefined && actionResults[i].index !== null\n    ? String(actionResults[i].index)\n    : String(i);\n  processedByIndex[processedIndex] = true;\n}\nfor (i = 0; i < rollbackActions.length; i += 1) {\n  var planned = rollbackActions[i] ? rollbackActions[i] : new Object();\n  var plannedIndex = planned.sourceIndex !== undefined && planned.sourceIndex !== null\n    ? String(planned.sourceIndex)\n    : (planned.sequence !== undefined && planned.sequence !== null ? String(planned.sequence) : String(i));\n  if (!processedByIndex[plannedIndex]) {\n    remainingActions.push(planned);\n  }\n}\nvar fullyProcessed = stateErrors.length === 0 && malformedCount === 0 && result.processedCount === result.totalActions && remainingActions.length === 0;\nresult.executionSummary = {\n  candidates: candidates,\n  accepted: accepted,\n  skippedDuringPreparation: result.requestCounts && result.requestCounts.skippedDuringPreparation\n    ? Number(result.requestCounts.skippedDuringPreparation)\n    : (candidates - accepted),\n  rolledBackCount: rolledBackCount,\n  alreadyMissingCount: alreadyMissingCount,\n  failedCount: failedCount,\n  skippedCount: skippedCount,\n  malformedCount: malformedCount,\n  remainingActions: remainingActions.length,\n  fullyProcessed: fullyProcessed\n};\nresult.actionOutcomes = {\n  rolledBack: rolledBackActions,\n  alreadyMissing: alreadyMissingActions,\n  skipped: skippedActions,\n  failed: failedActions,\n  remaining: remainingActions\n};\nif (stateErrors.length > 0 || malformedCount > 0) {\n  result.status = 'INTERNAL_FAILURE';\n} else if (prepared.valid !== true) {\n  result.status = 'FAILED_VALIDATION';\n} else if (!fullyProcessed || failedCount > 0 || skippedCount > 0) {\n  result.status = 'PARTIAL_FAILURE';\n} else {\n  result.status = 'SUCCESS';\n}\nresult.message = prepared.valid !== true\n  ? 'Rollback request rejected by validation guardrails'\n  : (result.status === 'INTERNAL_FAILURE'\n      ? 'Rollback audit failed because workflow state was malformed'\n      : (result.status !== 'SUCCESS'\n      ? 'Rollback completed with manual cleanup required'\n      : 'Rollback completed'));\n\nreturn result;"
