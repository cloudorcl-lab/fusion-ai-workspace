                  "code": "NORMALIZE_ROLLBACK_ACTION",
                  "id": "NORMALIZE_ROLLBACK_ACTION",
                  "metadata": {
                    "name": "Normalize Rollback Action",
                    "returnType": "object",
                    "position": {
                      "x": 220,
                      "y": 200
                    },
                    "sourceCode": "var loopAction = ($context.$nodes && $context.$nodes.ROLLBACK_LOOP)\n  ? $context.$nodes.ROLLBACK_LOOP.$currentItem\n  : null;\nvar action = loopAction ? loopAction : null;\nvar rawActionResults = $context.$variables.actionResults;\nvar actionResults = rawActionResults === undefined || rawActionResults === null\n  ? []\n  : (Array.isArray(rawActionResults) ? rawActionResults : []);\n\nvar toNumber = function(value) {\n  if (value === null || value === undefined || value === '') {\n    return null;\n  }\n  var n = Number(value);\n  return isNaN(n) ? null : n;\n};\n\nvar resultIndex = actionResults.length;\nif (action) {\n  var sourceIndex = toNumber(action.sourceIndex);\n  var sequence = toNumber(action.sequence);\n  if (sourceIndex !== null) {\n    resultIndex = sourceIndex;\n  } else if (sequence !== null) {\n    resultIndex = sequence;\n  }\n}\n\nvar result = new Object();\nresult.hasAction = !!action;\nresult.action = action;\nresult.resultIndex = resultIndex;\nresult.stateErrors = Array.isArray(rawActionResults) || rawActionResults === undefined || rawActionResults === null\n  ? []\n  : ['Malformed rollback state: actionResults must be an array.'];\n\nreturn result;"
