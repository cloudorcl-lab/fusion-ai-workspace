        {
          "id": "1",
          "code": "PREPARE_ROLLBACK_REQUEST",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Rollback Request",
            "returnType": "object",
            "sourceCode": "var trigger = ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input)\n  ? $context.$triggers.REST.$input\n  : new Object();\n\nvar parseMaybeJson = function(value) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n  if (typeof value !== 'string') {\n    return value;\n  }\n  try {\n    return JSON.parse(value);\n  } catch (_err) {\n    return null;\n  }\n};\n\nvar toNumber = function(value) {\n  if (value === null || value === undefined || value === '') {\n    return null;\n  }\n  var n = Number(value);\n  return isNaN(n) ? null : n;\n};\n\nvar normalizeUrl = function(url) {\n  if (!url) {\n    return null;\n  }\n  var s = String(url);\n  var idx = s.indexOf('/fscmRestApi/');\n  return idx >= 0 ? s.substring(idx) : s;\n};\n\nvar normalizeType = function(value) {\n  var t = value ? String(value).toLowerCase() : '';\n  if (t === 'component') {\n    return 'component';\n  }\n  if (t === 'measure') {\n    return 'measure';\n  }\n  if (t === 'expression') {\n    return 'expression';\n  }\n  if (t === 'plan') {\n    return 'plan';\n  }\n  if (t === 'ratetable') {\n    return 'rateTable';\n  }\n  if (t === 'ratedimension') {\n    return 'rateDimension';\n  }\n  if (t === 'ratedimensiontier') {\n    return 'rateDimensionTier';\n  }\n  return null;\n};\n\nvar publisherResult = parseMaybeJson(trigger.publisherResult);\nif (publisherResult && publisherResult.result !== undefined) {\n  publisherResult = parseMaybeJson(publisherResult.result);\n}\nif (publisherResult && publisherResult.output !== undefined) {\n  publisherResult = parseMaybeJson(publisherResult.output);\n}\n\nvar rollbackPayload = parseMaybeJson(trigger.rollbackPayload);\nif (!rollbackPayload && publisherResult && publisherResult.rollbackPayload) {\n  rollbackPayload = parseMaybeJson(publisherResult.rollbackPayload);\n}\n\nvar errors = [];\nvar warnings = [];\n\nif (!rollbackPayload || typeof rollbackPayload !== 'object') {\n  errors.push('Missing rollbackPayload for publish-failure rollback.');\n}\n\nvar createdEntities = rollbackPayload && rollbackPayload.createdEntities && rollbackPayload.createdEntities.length\n  ? rollbackPayload.createdEntities\n  : [];\n\nvar rawType = function(value) {\n  return value ? String(value).toLowerCase() : '';\n};\n\nvar hasParentCreateForChild = function(raw) {\n  var type = rawType(raw && raw.type);\n  var i = 0;\n  if (type === 'ratedimensiontier') {\n    var parentDimensionId = toNumber(raw ? raw.dimensionId : null);\n    if (parentDimensionId === null) {\n      return false;\n    }\n    for (i = 0; i < createdEntities.length; i += 1) {\n      var candidateDim = createdEntities[i] ? createdEntities[i] : new Object();\n      if (rawType(candidateDim.type) === 'ratedimension' && toNumber(candidateDim.icId) === parentDimensionId) {\n        return true;\n      }\n    }\n    return false;\n  }\n  if (type === 'ratetablerate') {\n    var parentRateTableId = toNumber(raw ? raw.rateTableId : null);\n    if (parentRateTableId === null) {\n      return false;\n    }\n    for (i = 0; i < createdEntities.length; i += 1) {\n      var candidateTable = createdEntities[i] ? createdEntities[i] : new Object();\n      if (rawType(candidateTable.type) === 'ratetable' && toNumber(candidateTable.icId) === parentRateTableId) {\n        return true;\n      }\n    }\n    return false;\n  }\n  return false;\n};\n\nvar toAction = function(raw) {\n  var type = normalizeType(raw && raw.type);\n  if (!type) {\n    return null;\n  }\n  return {\n    sequence: toNumber(raw ? raw.sequence : null),\n    sourceIndex: toNumber(raw ? raw.sourceIndex : null),\n    type: type,\n    parserId: raw && raw.parserId ? String(raw.parserId) : null,\n    name: raw && raw.name ? String(raw.name) : null,\n    icId: toNumber(raw ? raw.icId : null),\n    dimensionId: toNumber(raw ? raw.dimensionId : null),\n    tierId: toNumber(raw ? raw.tierId : null),\n    orgId: toNumber(raw ? raw.orgId : null),\n    deleteId: raw && raw.deleteId ? String(raw.deleteId) : null,\n    canonicalUrl: raw && raw.canonicalUrl ? normalizeUrl(raw.canonicalUrl) : null\n  };\n};\n\nvar isActionSupported = function(action) {\n  if (!action) {\n    return false;\n  }\n  if (action.type === 'component') {\n    return !!action.canonicalUrl || !!action.deleteId || action.icId !== null;\n  }\n  if (action.type === 'measure' || action.type === 'plan') {\n    return action.icId !== null;\n  }\n  if (action.type === 'rateTable' || action.type === 'rateDimension') {\n    return action.icId !== null;\n  }\n  if (action.type === 'rateDimensionTier') {\n    return action.dimensionId !== null && action.tierId !== null;\n  }\n  if (action.type === 'expression') {\n    return !!action.deleteId || !!action.canonicalUrl || action.icId !== null;\n  }\n  return false;\n};\n\nvar accepted = [];\nvar dedup = new Object();\nvar i = 0;\nfor (i = 0; i < createdEntities.length; i += 1) {\n  var raw = createdEntities[i] ? createdEntities[i] : new Object();\n  var action = toAction(raw);\n  if (!action) {\n    if (hasParentCreateForChild(raw)) {\n      continue;\n    }\n    warnings.push('Skipping rollback ledger entry with unsupported type: ' + String(raw.type));\n    continue;\n  }\n  if (!isActionSupported(action)) {\n    warnings.push('Skipping rollback ledger entry with missing identifiers: ' + String(action.type) + (action.parserId ? (' [' + String(action.parserId) + ']') : ''));\n    continue;\n  }\n  var sig = action.type + '|';\n  if (action.parserId) {\n    sig += 'P|' + action.parserId;\n  } else if (action.deleteId) {\n    sig += 'D|' + action.deleteId;\n  } else if (action.icId !== null) {\n    sig += 'I|' + String(action.icId);\n  } else {\n    sig += 'X|' + String(i);\n  }\n  if (!dedup[sig]) {\n    dedup[sig] = true;\n    action.sourceIndex = i;\n    accepted.push(action);\n  }\n}\n\naccepted.sort(function(left, right) {\n  var leftType = left && left.type ? String(left.type) : '';\n  var rightType = right && right.type ? String(right.type) : '';\n  if (leftType === 'plan' && rightType !== 'plan') {\n    return 1;\n  }\n  if (rightType === 'plan' && leftType !== 'plan') {\n    return -1;\n  }\n  var leftSequence = left && left.sequence !== null ? Number(left.sequence) : null;\n  var rightSequence = right && right.sequence !== null ? Number(right.sequence) : null;\n  if (leftSequence !== null && rightSequence !== null && leftSequence !== rightSequence) {\n    return rightSequence - leftSequence;\n  }\n  var leftIndex = left && left.sourceIndex !== null ? Number(left.sourceIndex) : -1;\n  var rightIndex = right && right.sourceIndex !== null ? Number(right.sourceIndex) : -1;\n  return rightIndex - leftIndex;\n});\n\nvar result = new Object();\nresult.valid = errors.length === 0;\nresult.errors = errors;\nresult.warnings = warnings;\nresult.executionMode = 'publishFailureRollback';\nresult.orderedActions = accepted;\nresult.requestCounts = {\n  candidates: createdEntities.length,\n  accepted: accepted.length,\n  skippedDuringPreparation: createdEntities.length - accepted.length\n};\nreturn result;"
          },
