                  "code": "PREPARE_COMPONENT_DELETE",
                  "id": "PREPARE_COMPONENT_DELETE",
                  "metadata": {
                    "name": "Prepare Component Delete",
                    "returnType": "object",
                    "position": {
                      "x": 820,
                      "y": 200
                    },
                    "sourceCode": "var normalized = ($context.$nodes && $context.$nodes.NORMALIZE_ROLLBACK_ACTION && $context.$nodes.NORMALIZE_ROLLBACK_ACTION.$output)\n  ? $context.$nodes.NORMALIZE_ROLLBACK_ACTION.$output.result\n  : null;\nvar action = normalized && normalized.action\n  ? normalized.action\n  : null;\n\nvar normalizeUrl = function(url) {\n  if (!url) {\n    return null;\n  }\n  var s = String(url);\n  var idx = s.indexOf('/fscmRestApi/');\n  return idx >= 0 ? s.substring(idx) : s;\n};\n\nvar pathTailAfterResource = function(value, resourceName) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n  var text = String(value).trim();\n  if (!text) {\n    return null;\n  }\n  var resource = String(resourceName || '').replace(/^\\/|\\/$/g, '');\n  var escapedResource = resource.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n  var match = text.match(new RegExp('/fscmRestApi/resources/[^/]+/' + escapedResource + '/([^?]+)'));\n  if (match && match[1]) {\n    return match[1];\n  }\n\n  var marker = '/' + resource + '/';\n  var idx = text.indexOf(marker);\n  if (idx === 0) {\n    var tail = text.substring(marker.length);\n    var queryIdx = tail.indexOf('?');\n    if (queryIdx >= 0) {\n      tail = tail.substring(0, queryIdx);\n    }\n    return tail ? tail : null;\n  }\n  if (text.indexOf('/fscmRestApi/') >= 0 || /^https?:\\/\\//i.test(text) || text.charAt(0) === '/') {\n    return null;\n  }\n  return text;\n};\n\nvar componentPathTail = function(value) {\n  return pathTailAfterResource(value, 'planComponents');\n};\n\nvar result = new Object();\nresult.useCanonicalUrl = false;\nresult.componentUrl = null;\nresult.componentId = null;\nresult.stateErrors = [];\n\nif (action && action.type === 'component') {\n  if (action.canonicalUrl) {\n    result.useCanonicalUrl = true;\n    result.componentUrl = componentPathTail(normalizeUrl(action.canonicalUrl));\n    if (!result.componentUrl) {\n      result.useCanonicalUrl = false;\n      result.stateErrors.push('Component rollback requires a valid canonical URL under planComponents.');\n    }\n  } else {\n    result.stateErrors.push('Component rollback requires canonicalUrl; composite component keys are not valid for deletion.');\n  }\n}\n\nreturn result;"
