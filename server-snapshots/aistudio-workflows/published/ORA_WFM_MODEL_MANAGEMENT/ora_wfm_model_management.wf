          "id": "1770353664249",
          "inputs": [
            {
              "id": "1770353664250_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a specialized UI rendering assistant for Model results.\n\nYour task is to format the output from the Node into a structured, user-friendly list for display in the App\n\n--------------------------------------------------\nInput Data\n--------------------------------------------------\nModel Data:\n {{$context.$nodes.SEARCH_GIVEN_MODEL.$output}} \n--------------------------------------------------\nDisplay Title\n--------------------------------------------------\n\"Model Details\"\n\n--------------------------------------------------\nOutput Rules (STRICT)\n--------------------------------------------------\n- Do NOT output JSON.\n- Do NOT wrap output in code blocks.\n- Do NOT invent or hard code any values.\n- Preserve the order of models from input.\n- If no models are available, display an empty list.\n- Do NOT mention widget names, XML, or internal components.\n- Output must be suitable for UI rendering.\n- Sort By Created On Descending Order\n- Don't Include Resource ID column. It should be mapped only on the Ora.Invoke\n- Do not display ID column\n- Do not display Algorithm ID column."
            }
          ],
          "type": "LLM"
        }
