          "code": "GET_HINT",
          "id": "1768193992429",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Prepare Switch"
          },
          "outcomes": {
            "InitDisplay": "1768232027934",
            "default": "1768194129854",
            "InvokeAction": "1768194111316"
          },
          "code": "PREPARE_SWITCH",
          "convergenceTargetId": "end",
          "id": "1768194029891",
          "inputs": [
            {
              "id": "1768194029892_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$nodes.GET_HINT.$output.result}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
            "name": "Create Search Query",
            "returnType": "string",
            "sourceCode": "const raw = $context.$triggers.REST.$input.OraAction;\n\nif (!raw) {\n  return \"No OraAction found\";\n}\n\nlet payload = null;\n\n// If OraAction is a string → parse JSON\nif (typeof raw === \"string\") {\n  try {\n    payload = JSON.parse(raw);\n  } catch (e) {\n    return \"Failed to parse OraAction JSON\";\n  }\n}\n// If OraAction is already an object\nelse if (typeof raw === \"object\") {\n  payload = raw;\n}\n\nif (!payload || !payload.model) {\n  return \"No model found in InvokeAction payload\";\n}\n\nconst model = payload.model;\nconst id = payload.id;\n\nconst query =\n  `Get the model details of :Model Name: ${model}, Resource ID:${id}`;\n\nreturn query;"
          },
          "outcomes": {
            "success": "1770016109689"
          },
          "code": "CREATE_SEARCH_QUERY",
          "id": "1768194111316",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "default",
            "returnType": "string",
            "sourceCode": "return \"This is from Init default Node\""
          },
          "outcomes": {
