        {
          "metadata": {
            "name": "IT Classifier"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "IT_CLASSIFIER",
          "id": "1764335060474",
          "inputs": [
            {
              "id": "1764335060477_1",
              "name": "prompt",
              "type": "string",
              "value": "Task:\nFor each expression in the list below, determine whether it is related to information technology (IT).\n\nList to review:\n  {{$context.$triggers.REST.$input.terms}}\n\nInstructions:\n- Do not speculate, infer, or assume any context not explicitly present in an expression.\n- Evaluate each expression independently; do not assume expressions share a context.\n- Ignore acronyms, abbreviations, or unknown words that do not clearly indicate an IT relationship.\n- Consider each expression as a whole; do not split or modify it.\n\nDecision criteria:\n- Set itRelated to \"no\" if:\n  - The expression lacks sufficient context or is not commonly associated with IT.\n  - The expression could reasonably be associated with a different (non-IT) area of work.\n- Set itRelated to \"yes\" only if the expression is clearly or most commonly used to refer to information technology, even if alternate non-IT meanings exist."
            }
          ],
          "outputSpecification": "[\n  {\n      \"expression\": \"expression 1\",\n      \"itRelated\": \"yes\"\n  },\n {\n      \"expression\": \"expression 2\",\n      \"itRelated\": \"no\"\n  }\n]",
          "type": "LLM"
        }
      ],
      "rootNode": "start",
      "variables": [],
      "errorHandlers": [
        {
          "type": "EMAIL",
          "inputs": [
