D3C4B5A6478899CCDDEEFF001126\",\n              documentId: \"NKJAVA5\",\n              version: \"1.0\",\n              answerId: 10030005,\n              links: [\n                {\n                  rel: \"self\",\n                  href: \"https://dev.java/learn/api/streams/\",\n                  mediaType: \"text/html\",\n                  method: \"GET\"\n                },\n                {\n                  rel: \"canonical\",\n                  href: \"https://cptckfgqy.fusionapps.ocs.oc-test.com/api/knowledge-management/v2/articles/A1B2C3D4E5F6478899AABBCCDDEEFF05\",\n                  mediaType: \"application/json\",\n                  method: \"GET\"\n                },\n                {\n                  rel: \"collection\",\n                  href: \"https://cptckfgqy.fusionapps.ocs.oc-test.com/api/knowledge-management/v2/articles\",\n                  mediaType: \"application/json\",\n                  method: \"GET\"\n                }\n              ],\n              published: true,\n              pending: false,\n              checkedOut: false,\n              excerpt: \"Official Stream API guide covering map-filter-reduce, collectors, optional, and parallel streams.\",\n              score: 0.968,\n              sourceType: \"EXTERNAL_WEB\",\n              contentTypeAttributes: {\n                NK_WEB_JAVA: {\n                  URL: \"https://dev.java/learn/api/streams/\",\n                  TITLE: \"The Stream API\",\n                  METADATA: {\n                    clickUrl: \"https://dev.java/learn/api/streams/\",\n                    mimeType: \"text/html\"\n                  },\n                  EXT_CONTENT_LOCALE: \"en_US\"\n                }\n              },\n              dataType: \"CMS-XML\"\n            },\n            {\n              recordId: \"A1B2C3D4E5F6478899AABBCCDDEEFF06\",\n              versionId: \"F1E2D3C4B5A6478899CCDDEEFF001127\",\n              documentId: \"NKJAVA6\",\n              version: \"1.0\",\n              answerId: 10030006,\n              links: [\n                {\n                  rel: \"self\",\n                  href: \"https://dev.java/learn/modules/\",\n                  mediaType: \"text/html\",\n                  method: \"GET\"\n                },\n                {\n                  rel: \"canonical\",\n                  href: \"https://cptckfgqy.fusionapps.ocs.oc-test.com/api/knowledge-management/v2/articles/A1B2C3D4E5F6478899AABBCCDDEEFF06\",\n                  mediaType: \"application/json\",\n                  method: \"GET\"\n                },\n                {\n                  rel: \"collection\",\n                  href: \"https://cptckfgqy.fusionapps.ocs.oc-test.com/api/knowledge-management/v2/articles\",\n                  mediaType: \"application/json\",\n                  method: \"GET\"\n                }\n              ],\n              published: true,\n              pending: false,\n              checkedOut: false,\n              excerpt: \"Covers Java modules, encapsulation, services, unnamed modules, automatic modules, and modular builds.\",\n              score: 0.963,\n              sourceType: \"EXTERNAL_WEB\",\n              contentTypeAttributes: {\n                NK_WEB_JAVA: {\n                  URL: \"https://dev.java/learn/modules/\",\n                  TITLE: \"Modules\",\n                  METADATA: {\n                    clickUrl: \"https://dev.java/learn/modules/\",\n                    mimeType: \"text/html\"\n                  },\n                  EXT_CONTENT_LOCALE: \"en_US\"\n                }\n              },\n              dataType: \"CMS-XML\"\n            },\n            {\n              recordId: \"A1B2C3D4E5F6478899AABBCCDDEEFF07\",\n              versionId: \"F1E2D3C4B5A6478899CCDDEEFF001128\",\n              documentId: \"NKJAVA7\",\n              version: \"1.0\",\n              answerId: 10030007,\n              links: [\n                {\n                  rel: \"self\",\n                  href: \"https://dev.java/learn/new-features/virtual-threads/\",\n                  mediaType: \"text/html\",\n                  method: \"GET\"\n                },\n                {\n                  rel: \"canonical\",\n                  href: \"https://cptckfgqy.fusionapps.ocs.oc-test.com/api/knowledge-management/v2/articles/A1B2C3D4E5F6478899AABBCCDDEEFF07\",\n                  mediaType: \"application/json\",\n                  method: \"GET\"\n                },\n                {\n                  rel: \"collection\",\n                  href: \"https://cptckfgqy.fusionapps.ocs.oc-test.com/api/knowledge-management/v2/articles\",\n                  mediaType: \"application/json\",\n                  method: \"GET\"\n                }\n              ],\n              published: true,\n              pending: false,\n              checkedOut: false,\n              excerpt: \"Explains virtual threads in Java and why they help server applications handle large numbers of concurrent requests.\",\n              score: 0.958,\n              sourceType: \"EXTERNAL_WEB\",\n              contentTypeAttributes: {\n                NK_WEB_JAVA: {\n                  URL: \"https://dev.java/learn/new-features/virtual-threads/\",\n                  TITLE: \"Virtual Threads\",\n                  METADATA: {\n                    clickUrl: \"https://dev.java/learn/new-features/virtual-threads/\",\n                    mimeType: \"text/html\"\n                  },\n                  EXT_CONTENT_LOCALE: \"en_US\"\n                }\n              },\n              dataType: \"CMS-XML\"\n            },\n            {\n              recordId: \"A1B2C3D4E5F6478899AABBCCDDEEFF08\",\n              versionId: \"F1E2D3C4B5A6478899CCDDEEFF001129\",\n              documentId: \"NKJAVA8\",\n              version: \"1.0\",\n              answerId: 10030008,\n              links: [\n                {\n                  rel: \"self\",\n                  href: \"https://docs.oracle.com/en/java/javas