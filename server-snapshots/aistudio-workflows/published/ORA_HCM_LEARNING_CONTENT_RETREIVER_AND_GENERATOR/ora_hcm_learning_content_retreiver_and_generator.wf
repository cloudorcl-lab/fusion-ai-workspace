        {
          "metadata": {
            "name": "Collate Ouput",
            "returnType": "object",
            "sourceCode": "function cleanString(value) {\n  return value === undefined || value === null ? \"\" : String(value).replace(/\\r/g, \"\").trim();\n}\n\nfunction parseBoolean(value) {\n  if (typeof value === \"boolean\") {\n    return value;\n  }\n\n  var normalized = cleanString(value).toLowerCase();\n  return normalized === \"true\" || normalized === \"1\" || normalized === \"yes\";\n}\n\nfunction getNodeOutput(contextNodes, nodeCode) {\n  return contextNodes[nodeCode] && contextNodes[nodeCode].$output ? contextNodes[nodeCode].$output : null;\n}\n\nfunction getNodeResult(contextNodes, nodeCode) {\n  var nodeOutput = getNodeOutput(contextNodes, nodeCode);\n  return nodeOutput ? nodeOutput.result || null : null;\n}\n\nfunction getFillGapsSetting(contextVariables, configurationOutput) {\n  var fillGapsValue = contextVariables.fillGapsUsingLLMKnowledge;\n\n  if (fillGapsValue === undefined || fillGapsValue === null) {\n    fillGapsValue = configurationOutput.fillGapsUsingLLMKnowledge;\n  }\n\n  return fillGapsValue;\n}\n\nfunction getSourcePriority(value) {\n  var sourcePriority = Number(value);\n  return Number.isFinite(sourcePriority) ? sourcePriority : 0;\n}\n\nfunction normalizeCitation(citation) {\n  citation = citation || {};\n\n  return {\n    title: cleanString(citation.title),\n    metadata: cleanString(citation.metadata),\n    link: cleanString(citation.link)\n  };\n}\n\nfunction compareDiscoveredSources(left, right) {\n  if (left.priority !== right.priority) {\n    return left.priority - right.priority;\n  }\n\n  if (left.sourceType !== right.sourceType) {\n    return left.sourceType < right.sourceType ? -1 : 1;\n  }\n\n  return left.normalizedNodeCode < right.normalizedNodeCode ? -1 : 1;\n}\n\nfunction compareOrderedChunks(left, right) {\n  if (left.priority !== right.priority) {\n    return left.priority - right.priority;\n  }\n\n  if (left.sourceType !== right.sourceType) {\n    return left.sourceType < right.sourceType ? -1 : 1;\n  }\n\n  return left.sequence - right.sequence;\n}\n\nfunction getCanonicalCitationKey(citation) {\n  if (!citation.title) {\n    return \"\";\n  }\n\n  return JSON.stringify([citation.title, citation.metadata, citation.link]);\n}\n\nvar context = $context || {};\nvar contextNodes = context.$nodes || {};\nvar contextVariables = context.$variables || {};\nvar systemContext = context.$system || {};\nvar configurationOutput = getNodeOutput(contextNodes, \"CONFIGURATION_DETAILS\") || {};\nvar question = cleanString(systemContext.$inputMessage);\nvar fillGapsUsingLLMKnowledge = parseBoolean(getFillGapsSetting(contextVariables, configurationOutput));\nvar orderedChunks = [];\nvar discoveredSources = [];\nvar nodeCodes = Object.keys(contextNodes);\nvar citationNumberByKey = {};\nvar availableCitations = [];\n\nfor (var nodeIndex = 0; nodeIndex < nodeCodes.length; nodeIndex += 1) {\n  var nodeCode = nodeCodes[nodeIndex];\n  var nodeResult = getNodeResult(contextNodes, nodeCode);\n\n  if (!nodeResult || !Array.isArray(nodeResult.contentChunks) || !cleanString(nodeResult.source)) {\n    continue;\n  }\n\n  var sourceType = cleanString(nodeResult.source);\n  var sourcePriority = getSourcePriority(nodeResult.sourcePriority);\n\n  discoveredSources.push({\n    sourceType: sourceType,\n    priority: sourcePriority,\n    normalizedNodeCode: nodeCode\n  });\n\n  for (var chunkIndex = 0; chunkIndex < nodeResult.contentChunks.length; chunkIndex += 1) {\n    var chunkEntry = nodeResult.contentChunks[chunkIndex] || {};\n    var contentChunk = cleanString(chunkEntry.contentChunk);\n\n    if (!contentChunk) {\n      continue;\n    }\n\n    var sequence = Number(chunkEntry.sequence);\n    if (!Number.isFinite(sequence)) {\n      sequence = chunkIndex;\n    }\n\n    orderedChunks.push({\n      sourceType: sourceType,\n      priority: sourcePriority,\n      sequence: sequence,\n      contentChunk: contentChunk,\n      citation: normalizeCitation(chunkEntry.citation)\n    });\n  }\n}\n\ndiscoveredSources.sort(compareDiscoveredSources);\norderedChunks.sort(compareOrderedChunks);\n\nfor (var orderedIndex = 0; orderedIndex < orderedChunks.length; orderedIndex += 1) {\n  var orderedChunk = orderedChunks[orderedIndex];\n  var citationKey = getCanonicalCitationKey(orderedChunk.citation);\n  var citationNumber = null;\n\n  if (citationKey) {\n    citationNumber = citationNumberByKey[citationKey];\n\n    if (!citationNumber) {\n      citationNumber = availableCitations.length + 1;\n      citationNumberByKey[citationKey] = citationNumber;\n      availableCitations.push({\n        citationNumber: citationNumber,\n        title: orderedChunk.citation.title,\n        metadata: orderedChunk.citation.metadata,\n        link: orderedChunk.citation.link\n      });\n    }\n  }\n\n  orderedChunk.citationNumber = citationNumber;\n  delete orderedChunk.sequence;\n}\n\nvar result = {\n  question: question,\n  fillGapsUsingLLMKnowledge: fillGapsUsingLLMKnowledge,\n  sourcePriorities: discoveredSources,\n  availableCitations: availableCitations,\n  orderedChunks: orderedChunks\n};\n\nreturn result;"
          },
