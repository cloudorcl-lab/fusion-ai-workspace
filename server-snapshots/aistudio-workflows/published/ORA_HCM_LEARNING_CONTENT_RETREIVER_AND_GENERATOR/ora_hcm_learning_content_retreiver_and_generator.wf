            "sourceCode": "//Replace this with a tool or a BO that fetches the content from any configured source\n\nvar webCrawlerResponse = {\n  jsonrpc: \"2.0\",\n  id: \"4\",\n  result: {\n    content: [\n      {\n        type: \"text\",\n        text: {\n          items: [\n            {\n              recordId: \"A1B2C3D4E5F6478899AABBCCDDEEFF01\",\n              versionId: \"F1E2D3C4B5A6478899CCDDEEFF001122\",\n              documentId: \"NKJAVA1\",\n              version: \"1.0\",\n              answerId: 10030001,\n              links: [\n                {\n                  rel: \"self\",\n                  href: \"https://dev.java/learn/\",\n                  mediaType: \"text/html\",\n                  method: \"GET\"\n                },\n                {\n                  rel: \"canonical\",\n                  href: \"https://cptckfgqy.fusionapps.ocs.oc-test.com/api/knowledge-management/v2/articles/A1B2C3D4E5F6478899AABBCCDDEEFF01\",\n                  mediaType: \"application/json\",\n                  method: \"GET\"\n                },\n                {\n                  rel: \"collection\",\n                  href: \"https://cptckfgqy.fusionapps.ocs.oc-test.com/api/knowledge-management/v2/articles\",\n                  mediaType: \"application/json\",\n                  method: \"GET\"\n                }\n              ],\n              published: true,\n              pending: false,\n              checkedOut: false,\n              excerpt: \"Official Java learning hub with tutorials for getting started, language features, APIs, modules, JVM tools, and more.\",\n              score: 0.991,\n              sourceType: \"EXTERNAL_WEB\",\n              contentTypeAttributes: {\n                NK_WEB_JAVA: {\n                  URL: \"https://dev.java/learn/\",\n                  TITLE: \"Learn Java\",\n                  METADATA: {\n                    clickUrl: \"https://dev.java/learn/\",\n                    mimeType: \"text/html\"\n                  },\n                  EXT_CONTENT_LOCALE: \"en_US\"\n                }\n              },\n              dataType: \"CMS-XML\"\n            },\n            {\n              recordId: \"A1B2C3D4E5F6478899AABBCCDDEEFF02\",\n              versionId: \"F1E2D3C4B5A6478899CCDDEEFF001123\",\n              documentId: \"NKJAVA2\",\n              version: \"1.0\",\n              answerId: 10030002,\n              links: [\n                {\n                  rel: \"self\",\n                  href: \"https://dev.java/learn/language-basics/\",\n                  mediaType: \"text/html\",\n                  method: \"GET\"\n                },\n                {\n                  rel: \"canonical\",\n                  href: \"https://cptckfgqy.fusionapps.ocs.oc-test.com/api/knowledge-management/v2/articles/A1B2C3D4E5F6478899AABBCCDDEEFF02\",\n                  mediaType: \"application/json\",\n                  method: \"GET\"\n                },\n                {\n                  rel: \"collection\",\n                  href: \"https://cptckfgqy.fusionapps.ocs.oc-test.com/api/knowledge-management/v2/articles\",\n                  mediaType: \"application/json\",\n                  method: \"GET\"\n                }\n              ],\n              published: true,\n              pending: false,\n              checkedOut: false,\n              excerpt: \"Covers Java language basics including variables, operators, expressions, statements, blocks, and control flow.\",\n              score: 0.984,\n              sourceType: \"EXTERNAL_WEB\",\n              contentTypeAttributes: {\n                NK_WEB_JAVA: {\n                  URL: \"https://dev.java/learn/language-basics/\",\n                  TITLE: \"Java Language Basics\",\n                  METADATA: {\n                    clickUrl: \"https://dev.java/learn/language-basics/\",\n                    mimeType: \"text/html\"\n                  },\n                  EXT_CONTENT_LOCALE: \"en_US\"\n                }\n              },\n              dataType: \"CMS-XML\"\n            },\n            {\n              recordId: \"A1B2C3D4E5F6478899AABBCCDDEEFF03\",\n              versionId: \"F1E2D3C4B5A6478899CCDDEEFF001124\",\n              documentId: \"NKJAVA3\",\n              version: \"1.0\",\n              answerId: 10030003,\n              links: [\n                {\n                  rel: \"self\",\n                  href: \"https://dev.java/learn/generics/\",\n                  mediaType: \"text/html\",\n                  method: \"GET\"\n                },\n                {\n                  rel: \"canonical\",\n                  href: \"https://cptckfgqy.fusionapps.ocs.oc-test.com/api/knowledge-management/v2/articles/A1B2C3D4E5F6478899AABBCCDDEEFF03\",\n                  mediaType: \"application/json\",\n                  method: \"GET\"\n                },\n                {\n                  rel: \"collection\",\n                  href: \"https://cptckfgqy.fusionapps.ocs.oc-test.com/api/knowledge-management/v2/articles\",\n                  mediaType: \"application/json\",\n                  method: \"GET\"\n                }\n              ],\n              published: true,\n              pending: false,\n              checkedOut: false,\n              excerpt: \"Explains Java generics, type inference, wildcards, type erasure, and common restrictions.\",\n              score: 0.978,\n              sourceType: \"EXTERNAL_WEB\",\n              contentTypeAttributes: {\n                NK_WEB_JAVA: {\n                  URL: \"https://dev.java/learn/generics/\",\n                  TITLE: \"Generics\",\n                  METADATA: {\n                    clickUrl: \"https://dev.java/learn/generics/\",\n                    mimeType: \"text/html\"\n                  },\n                  EXT_CONTENT_LOCALE: \"en_US\"\n                }\n              },\n              dataType: \"CMS-XML\"\n            },\n            {\n              recordId: \"A1B2C3D4E5F6478899AABBCCDDE