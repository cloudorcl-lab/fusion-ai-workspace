        {
          "metadata": {
            "name": "Normalize Indexed Learning Content",
            "returnType": "object",
            "sourceCode": "function cleanString(value) {\n  return value === undefined || value === null ? \"\" : String(value).replace(/\\r/g, \"\").trim();\n}\n\nfunction parseBoolean(value) {\n  if (typeof value === \"boolean\") {\n    return value;\n  }\n\n  var normalized = cleanString(value).toLowerCase();\n  return normalized === \"true\" || normalized === \"1\" || normalized === \"yes\";\n}\n\nfunction getNodeOutput(contextNodes, nodeCode) {\n  return contextNodes[nodeCode] && contextNodes[nodeCode].$output ? contextNodes[nodeCode].$output : null;\n}\n\nfunction getConfiguredNumber(primaryValue, fallbackValue, defaultValue) {\n  var numericValue = Number(primaryValue);\n\n  if (!Number.isFinite(numericValue)) {\n    numericValue = Number(fallbackValue);\n  }\n\n  return Number.isFinite(numericValue) ? numericValue : defaultValue;\n}\n\nfunction getFillGapsSetting(contextVariables, configurationOutput) {\n  var fillGapsValue = contextVariables.fillGapsUsingLLMKnowledge;\n\n  if (fillGapsValue === undefined || fillGapsValue === null) {\n    fillGapsValue = configurationOutput.fillGapsUsingLLMKnowledge;\n  }\n\n  return fillGapsValue;\n}\n\nfunction extractDeepLink(deepLinkOutput) {\n  var deepLinkText = \"\";\n\n  try {\n    deepLinkText = JSON.stringify(deepLinkOutput || {});\n  } catch (error) {\n    deepLinkText = \"\";\n  }\n\n  if (!deepLinkText) {\n    return \"\";\n  }\n\n  var httpIndex = deepLinkText.indexOf(\"http\");\n  if (httpIndex < 0) {\n    return \"\";\n  }\n\n  var endIndex = httpIndex;\n  while (\n    endIndex < deepLinkText.length &&\n    deepLinkText[endIndex] !== \"\\\"\" &&\n    deepLinkText[endIndex] !== \" \" &&\n    deepLinkText[endIndex] !== \"\\n\"\n  ) {\n    endIndex += 1;\n  }\n\n  return cleanString(deepLinkText.slice(httpIndex, endIndex).replace(/\\\\+$/, \"\"));\n}\n\nfunction buildLearningItemDeepLink(deepLinkTemplate, learningItemId) {\n  var template = cleanString(deepLinkTemplate);\n  var itemId = cleanString(learningItemId);\n\n  if (!itemId) {\n    return \"\";\n  }\n\n  if (!template) {\n    return \"\";\n  }\n\n  if (template.indexOf(\"learningItemId=\") >= 0) {\n    return template.replace(/learningItemId=[^&]*/, \"learningItemId=\" + encodeURIComponent(itemId));\n  }\n\n  return template + (template.indexOf(\"?\") >= 0 ? \"&\" : \"?\") + \"learningItemId=\" + encodeURIComponent(itemId);\n}\n\nfunction getSemanticItems(semanticOutput) {\n  var candidateLists = [\n    semanticOutput && semanticOutput.results,\n    semanticOutput && semanticOutput.result && semanticOutput.result.results,\n    semanticOutput && semanticOutput.result && semanticOutput.result.items,\n    semanticOutput && semanticOutput.items\n  ];\n\n  for (var index = 0; index < candidateLists.length; index += 1) {\n    if (Array.isArray(candidateLists[index])) {\n      return candidateLists[index];\n    }\n  }\n\n  return [];\n}\n\nfunction decodeEntities(value) {\n  return cleanString(value)\n    .replace(/&/gi, \"&\")\n    .replace(/</gi, \"<\")\n    .replace(/>/gi, \">\")\n    .split(String.fromCharCode(38) + 'quot;').join(String.fromCharCode(34))\n    .replace(/'/gi, \"'\");\n}\n\nfunction cleanTaggedLineValue(value) {\n  var cleaned = decodeEntities(value);\n\n  if (!cleaned) {\n    return \"\";\n  }\n\n  if (cleaned.charAt(0) === \"|\") {\n    cleaned = cleanString(cleaned.slice(1));\n  }\n\n  cleaned = cleaned.replace(/\\s+\\|\\s*$/, \"\");\n  return cleanString(cleaned);\n}\n\nfunction getTaggedValue(supportingChunks, label) {\n  var expression = new RegExp(\"(?:^|\\\\n)\\\\s*\\\\|?\\\\s*\" + label + \"\\\\s*:\\\\s*(.+)\", \"i\");\n  var match = supportingChunks.match(expression);\n  return match ? cleanTaggedLineValue(match[1]) : \"\";\n}\n\nfunction getCitationTitle(semanticItem, supportingChunks) {\n  var semanticMetadata = semanticItem.metadata || {};\n  var candidateTitles = [\n    cleanString(semanticMetadata.learningItemTitle),\n    cleanString(semanticItem.learningItemTitle),\n    getTaggedValue(supportingChunks, \"HEADING\"),\n    cleanString(semanticMetadata.heading),\n    cleanString(semanticItem.heading)\n  ];\n\n  for (var index = 0; index < candidateTitles.length; index += 1) {\n    var candidateTitle = cleanString(candidateTitles[index]);\n\n    if (candidateTitle) {\n      return candidateTitle;\n    }\n  }\n\n  return \"\";\n}\n\nvar context = $context || {};\nvar contextNodes = context.$nodes || {};\nvar contextVariables = context.$variables || {};\nvar systemContext = context.$system || {};\nvar configurationOutput = getNodeOutput(contextNodes, \"CONFIGURATION_DETAILS\") || {};\nvar question = cleanString(systemContext.$inputMessage);\nvar fillGapsUsingLLMKnowledgeRaw = getFillGapsSetting(contextVariables, configurationOutput);\nvar configuredPriority = getConfiguredNumber(\n  contextVariables.learnKnowledgePriority,\n  configurationOutput.learnKnowledgePriority,\n  0\n);\nvar semanticOutput = getNodeOutput(contextNodes, \"FETCH_FROM_INDEXED_LEARNING_CONTENT\");\nvar semanticItems = getSemanticItems(semanticOutput);\nvar semanticDeepLinkTemplate = extractDeepLink(getNodeOutput(contextNodes, \"LEARNING_ITEM_DEEP_LINK\"));\nvar contentChunks = [];\n\nfor (var semanticIndex = 0; semanticIndex < semanticItems.length; semanticIndex += 1) {\n  var semanticItem = semanticItems[semanticIndex] || {};\n  var semanticMetadata = semanticItem.metadata || {};\n  var semanticLearningItemId = cleanString(semanticMetadata.learningItemId);\n  var itemDeepLink = buildLearningItemDeepLink(semanticDeepLinkTemplate, semanticLearningItemId);\n  var itemLinks = itemDeepLink ? [{ rel: \"deepLink\", href: itemDeepLink }] : [];\n  var supportingChunks = cleanString(semanticItem.supportingChunks);\n\n  if (!supportingChunks) {\n    continue;\n  }\n\n  contentChunks.push({\n    sequence: semanticIndex,\n    contentChunk: supportingChunks,\n    citation: {\n      title: getCitationTitle(semanticItem, supportingChunks),\n      metadata: \"\",\n      link: itemDeepLink\n    },\n    links: itemLinks,\n    rawItem: semanticItem\n  });\n}\n\nvar result = {\n  question: question,\n  source: \"Indexed Learning Content\",\n  sourcePriority: configuredPriority,\n  llmEnabled: parseBoolean(fillGapsUsingLLMKnowledgeRaw),\n  contentChunks: contentChunks\n};\n\nreturn result;"
          },
