        {
          "metadata": {
            "name": "Normalize Content Intelligence",
            "returnType": "object",
            "sourceCode": "function cleanString(value) {\n  return value === undefined || value === null ? \"\" : String(value).replace(/\\r/g, \"\").trim();\n}\n\nfunction parseBoolean(value) {\n  if (typeof value === \"boolean\") {\n    return value;\n  }\n\n  var normalized = cleanString(value).toLowerCase();\n  return normalized === \"true\" || normalized === \"1\" || normalized === \"yes\";\n}\n\nfunction parseJsonValue(value) {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  var trimmed = cleanString(value);\n  if (!trimmed) {\n    return value;\n  }\n\n  try {\n    return JSON.parse(trimmed);\n  } catch (error) {\n    return value;\n  }\n}\n\nfunction getNodeOutput(contextNodes, nodeCode) {\n  return contextNodes[nodeCode] && contextNodes[nodeCode].$output ? contextNodes[nodeCode].$output : null;\n}\n\nfunction getVariableOrFallback(contextVariables, configurationOutput, fieldName) {\n  var value = contextVariables[fieldName];\n\n  if (value === undefined || value === null) {\n    value = configurationOutput[fieldName];\n  }\n\n  return value;\n}\n\nfunction getConfiguredSources(configurationOutput, contextVariables) {\n  var sourcePrioritiesValue = parseJsonValue(getVariableOrFallback(contextVariables, configurationOutput, \"sourcePriorities\"));\n\n  if (Array.isArray(sourcePrioritiesValue)) {\n    return sourcePrioritiesValue;\n  }\n\n  return [\n    {\n      sourceType: \"Content Intelligence\",\n      priority: Number(getVariableOrFallback(contextVariables, configurationOutput, \"contentIntelligencePriority\")),\n      normalizedNodeCode: \"NORMALIZE_CONTENT_INTELLIGENCE\"\n    },\n    {\n      sourceType: \"Indexed Learning Content\",\n      priority: Number(getVariableOrFallback(contextVariables, configurationOutput, \"learnKnowledgePriority\")),\n      normalizedNodeCode: \"NORMALIZE_INDEXED_LEARNING_CONTENT\"\n    }\n  ];\n}\n\nfunction getSourceConfig(configuredSources, sourceType) {\n  for (var index = 0; index < configuredSources.length; index += 1) {\n    var configuredSource = configuredSources[index] || {};\n\n    if (cleanString(configuredSource.sourceType) === sourceType) {\n      return configuredSource;\n    }\n  }\n\n  return {};\n}\n\nfunction getWebItems(webOutput) {\n  var candidateLists = [\n    webOutput &&\n      webOutput.result &&\n      webOutput.result.result &&\n      Array.isArray(webOutput.result.result.content) &&\n      webOutput.result.result.content[0] &&\n      webOutput.result.result.content[0].text &&\n      webOutput.result.result.content[0].text.items,\n    webOutput &&\n      webOutput.result &&\n      Array.isArray(webOutput.result.content) &&\n      webOutput.result.content[0] &&\n      webOutput.result.content[0].text &&\n      webOutput.result.content[0].text.items,\n    webOutput &&\n      Array.isArray(webOutput.content) &&\n      webOutput.content[0] &&\n      webOutput.content[0].text &&\n      webOutput.content[0].text.items,\n    webOutput && webOutput.items\n  ];\n\n  for (var index = 0; index < candidateLists.length; index += 1) {\n    if (Array.isArray(candidateLists[index])) {\n      return candidateLists[index];\n    }\n  }\n\n  return [];\n}\n\nfunction getAttributeBlock(webItem) {\n  var contentTypeAttributes = webItem.contentTypeAttributes || {};\n  var attributeBlock = contentTypeAttributes.NK_WEB_AGENTIC_APPS || null;\n\n  if (attributeBlock) {\n    return attributeBlock;\n  }\n\n  var attributeKeys = Object.keys(contentTypeAttributes);\n  return attributeKeys.length > 0 ? contentTypeAttributes[attributeKeys[0]] || {} : {};\n}\n\nfunction getSelfLink(webItem) {\n  if (!Array.isArray(webItem.links)) {\n    return \"\";\n  }\n\n  for (var index = 0; index < webItem.links.length; index += 1) {\n    var linkItem = webItem.links[index] || {};\n\n    if (linkItem.rel === \"self\" && linkItem.href) {\n      return cleanString(linkItem.href);\n    }\n  }\n\n  return \"\";\n}\n\nvar context = $context || {};\nvar contextNodes = context.$nodes || {};\nvar contextVariables = context.$variables || {};\nvar systemContext = context.$system || {};\nvar configurationOutput = getNodeOutput(contextNodes, \"CONFIGURATION_DETAILS\") || {};\nvar configuredSources = getConfiguredSources(configurationOutput, contextVariables);\nvar sourceConfig = getSourceConfig(configuredSources, \"Content Intelligence\");\nvar configuredPriority = Number(sourceConfig.priority);\nvar question = cleanString(systemContext.$inputMessage);\nvar fillGapsUsingLLMKnowledgeRaw = getVariableOrFallback(contextVariables, configurationOutput, \"fillGapsUsingLLMKnowledge\");\nvar webItems = getWebItems(getNodeOutput(contextNodes, \"WEB_CRAWLER_BYPASS_TEMP\"));\nvar contentChunks = [];\n\nif (!Number.isFinite(configuredPriority)) {\n  configuredPriority = 0;\n}\n\nfor (var webIndex = 0; webIndex < webItems.length; webIndex += 1) {\n  var webItem = webItems[webIndex] || {};\n  var excerpt = cleanString(webItem.excerpt);\n\n  if (!excerpt) {\n    continue;\n  }\n\n  var attributeBlock = getAttributeBlock(webItem);\n  var metadataBlock = attributeBlock.METADATA || {};\n\n  contentChunks.push({\n    sequence: webIndex,\n    contentChunk: excerpt,\n    citation: {\n      title: cleanString(attributeBlock.TITLE || webItem.documentId || \"Web Content\"),\n      metadata: \"\",\n      link: cleanString(attributeBlock.URL || metadataBlock.clickUrl || getSelfLink(webItem))\n    },\n    rawItem: webItem\n  });\n}\n\nvar result = {\n  question: question,\n  source: \"Content Intelligence\",\n  sourcePriority: configuredPriority,\n  llmEnabled: parseBoolean(fillGapsUsingLLMKnowledgeRaw),\n  contentChunks: contentChunks\n};\n\nreturn result;"
          },
