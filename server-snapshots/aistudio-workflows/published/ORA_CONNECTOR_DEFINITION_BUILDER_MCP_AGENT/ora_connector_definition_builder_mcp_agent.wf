            "name": "Validate ToolsList Response",
            "returnType": "object",
            "sourceCode": "var toolsListNode = ($context && $context.$nodes) ? $context.$nodes['GET_MCP_TOOLS_LIST'] : null;\nif (!toolsListNode || toolsListNode.$output === undefined || toolsListNode.$output === null) {\n  throw new Error('Validation error: tools list response is missing from GET_MCP_TOOLS_LIST node');\n}\nvar toolsListPayload = toolsListNode.$output;\nif (typeof toolsListPayload === 'string') { try { toolsListPayload = JSON.parse(toolsListPayload); } catch (payloadParseError) {} }\nif (toolsListPayload && typeof toolsListPayload.response === 'string') { try { toolsListPayload = JSON.parse(toolsListPayload.response); } catch (nestedPayloadParseError) {} }\nvar responseRoot = toolsListPayload;\nfor (var unwrapDepth = 0; unwrapDepth < 3; unwrapDepth++) {\n  if (responseRoot && responseRoot.result && typeof responseRoot.result === 'object') { responseRoot = responseRoot.result; } else { break; }\n}\nvar discoveredTools = (responseRoot && responseRoot.tools && responseRoot.tools.length !== undefined) ? responseRoot.tools : [];\nvar discoveredResources = (responseRoot && responseRoot.resources && responseRoot.resources.length !== undefined) ? responseRoot.resources : [];\nvar discoveredPrompts = (responseRoot && responseRoot.prompts && responseRoot.prompts.length !== undefined) ? responseRoot.prompts : [];\nvar toolsCount = discoveredTools.length;\nif (toolsCount === 0 && responseRoot && responseRoot.toolCount !== undefined) {\n  var parsedToolCount = parseInt(responseRoot.toolCount, 10);\n  if (!isNaN(parsedToolCount) && parsedToolCount > 0) { toolsCount = parsedToolCount; }\n}\nvar resourcesCount = discoveredResources.length;\nvar promptsCount = discoveredPrompts.length;\nif (!((toolsCount > 0) || (resourcesCount > 0) || (promptsCount > 0))) {\n  throw new Error('Validation error: tools list response must include at least one tool, resource, or prompt');\n}\nreturn { selectedBranch: 'GET_MCP_TOOLS_LIST', toolsCount: toolsCount, resourcesCount: resourcesCount, promptsCount: promptsCount, validationStatus: true };\n"
