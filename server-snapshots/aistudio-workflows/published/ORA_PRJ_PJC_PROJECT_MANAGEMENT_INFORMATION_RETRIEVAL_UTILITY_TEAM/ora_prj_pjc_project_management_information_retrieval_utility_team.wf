{
  "workflowId": "300000331058297",
  "workflowCode": "ORA_PRJ_PJC_PROJECT_MANAGEMENT_INFORMATION_RETRIEVAL_UTILITY_TEAM",
  "name": "Project Management Information Retrieval Utility",
  "description": "Retrieves supplemental project management details by locating relevant records, extracting matching information, and preparing a clear response for the calling step.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
