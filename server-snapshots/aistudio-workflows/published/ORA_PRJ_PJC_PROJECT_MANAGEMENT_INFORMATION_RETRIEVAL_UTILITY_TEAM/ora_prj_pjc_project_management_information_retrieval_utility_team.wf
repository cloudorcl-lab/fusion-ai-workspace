        {
          "metadata": {
            "errorNodeId": "1773410772222",
            "name": "Extract Project Cost Category URL Parameters",
            "returnType": "string",
            "sourceCode": "let projectCostCategoryFilter = $context.$nodes.EXTRACT_COST_CATEGORY_FILTER.$output.additionalEntitiesFilter;\nlet projectCostCategoryFields = $context.$variables.prjPjcVarConvProjectCostCategoryInquirySelect;\n\nlet parts = [];\n\nif (projectCostCategoryFilter) {\n  parts.push(`$filter=${encodeURIComponent(projectCostCategoryFilter)}`);\n}\n\nif (projectCostCategoryFields) {\n  parts.push(`$fields=${encodeURIComponent(projectCostCategoryFields)}`);\n}\n\nreturn parts.join(\"&\");"
          },
          "outcomes": {
            "success": "1773134787586"
          },
          "code": "EXTRACT_PROJECT_COST_CATEGORY_URL_PARAMETERS",
          "id": "1773420417260",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1773410772222",
            "name": "Create Project Cost Category Response Object",
            "returnType": "array",
            "sourceCode": "let projectsCostCategoryResponse = $context.$nodes.PROJECT_COST_CATEGORY_INQUIRY?.$output;\n\nlet item = projectsCostCategoryResponse?.items?.[0] ?? {};\n\nlet projectscostcategoryinquiryArray = [\n  { \"Name\": item?.name ?? \"\" },\n  { \"Description\": item?.description ?? \"\" },\n  { \"From Date\": item?.fromDate ?? \"\" },\n  { \"To Date\": item?.toDate ?? \"\" },\n  { \"Creation Date\": item?.timeCreated ?? \"\" },\n  { \"Created By\": item?.createdBy ?? \"\" },\n  { \"Last Updated Date\": item?.timeUpdated ?? \"\" },\n  { \"Last Updated By\": item?.updatedBy ?? \"\" }\n];\n\nreturn projectscostcategoryinquiryArray;"
          },
          "outcomes": {
            "success": "1773134842374"
          },
          "code": "CREATE_PROJECT_COST_CATEGORY_RESPONSE_OBJECT",
          "id": "1773483840566",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
