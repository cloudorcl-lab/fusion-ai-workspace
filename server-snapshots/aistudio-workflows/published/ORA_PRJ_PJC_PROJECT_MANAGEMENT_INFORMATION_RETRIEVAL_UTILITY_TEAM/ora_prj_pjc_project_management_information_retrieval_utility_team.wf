            "returnType": "string",
            "sourceCode": "let projectFilter = $context.$nodes.EXTRACT_PROJECT_AND_TASK_FILTER.$output.projectAdditionalEntitiesFilter;\nlet parts = [];\nparts.push(`$fields=${encodeURIComponent(\"id\")}`);\nif (projectFilter) {\n  parts.push(`$filter=${encodeURIComponent(projectFilter)}`);\n}\nreturn parts.join(\"&\");"
