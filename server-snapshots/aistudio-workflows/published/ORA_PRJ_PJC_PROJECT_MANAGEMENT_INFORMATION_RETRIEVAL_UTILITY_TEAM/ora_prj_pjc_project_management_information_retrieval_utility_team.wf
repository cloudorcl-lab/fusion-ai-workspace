            "errorNodeId": "1773410772222",
            "name": "Extract Award Funding Source URL Parameters",
            "returnType": "string",
            "sourceCode": "let prjPjcVarConvAwardFundingSourcesInquiryFields = $context.$variables.prjPjcVarConvAwardFundingSourcesInquiry;\nlet awardFundingSourcesFilter = $context.$nodes.FUNDING_SOURCE_FILTER_EXTRACTION.$output.fundingSourcesFilter;\nlet awardId = $context.$nodes.GET_AWARD_ID.$output.result;\n\nlet parts = [];\n\nif (prjPjcVarConvAwardFundingSourcesInquiryFields) {\n  parts.push(`fields=${encodeURIComponent(prjPjcVarConvAwardFundingSourcesInquiryFields)}`);\n}\n\nlet finalFilter = \"\";\n\nif (awardFundingSourcesFilter && awardId) {\n  finalFilter = `(${awardFundingSourcesFilter}) AND AwardId = ${awardId}`;\n} else if (awardFundingSourcesFilter) {\n  finalFilter = awardFundingSourcesFilter;\n} else if (awardId) {\n  finalFilter = `AwardId = ${awardId}`;\n}\n\nif (finalFilter) {\n  parts.push(`q=${encodeURIComponent(finalFilter)}`);\n}\n\nreturn parts.join(\"&\");"
          },
