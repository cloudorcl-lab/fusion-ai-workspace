            "sourceCode": "return $context.$nodes.EXTRACT_PROJECT_AND_TASK_FILTER.$output.taskFilterFormed && $context.$nodes.EXTRACT_PROJECT_AND_TASK_FILTER.$output.projectFilterFormed;"
