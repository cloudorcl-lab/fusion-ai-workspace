            "name": "Create Cost Type Inquiry Response Object",
            "returnType": "array",
            "sourceCode": "let costTypeInquiryResponse = $context.$nodes.PROJECT_COST_TYPE_INQUIRY?.$output;\n\nlet item = costTypeInquiryResponse?.items?.[0] ?? {};\n\nlet costtypeinquiryArray = [\n  { \"Name\": item?.name ?? \"\" },\n  { \"Description\": item?.description ?? \"\" },\n  { \"Cost Category Name\": item?.costCategory?.name ?? \"\" },\n  { \"Revenue Category Code\": item?.revenueCategory?.lookupCode ?? \"\" },\n  { \"Rate Required\": item?.rateRequiredFlag ?? \"\" },\n  { \"Proceeds of Sale\": item?.proceedsOfSaleFlag ?? \"\" },\n  { \"From Date\": item?.fromDate ?? \"\" },\n  { \"To Date\": item?.toDate ?? \"\" },\n  { \"Creation Date\": item?.timeCreated ?? \"\" },\n  { \"Created By\": item?.createdBy ?? \"\" },\n  { \"Last Updated Date\": item?.timeUpdated ?? \"\" },\n  { \"Last Updated By\": item?.updatedBy ?? \"\" }\n];\n\nreturn costtypeinquiryArray;"
          },
