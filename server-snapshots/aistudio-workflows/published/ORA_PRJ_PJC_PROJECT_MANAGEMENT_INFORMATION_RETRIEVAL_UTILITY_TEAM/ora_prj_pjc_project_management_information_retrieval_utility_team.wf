            "sourceCode": "let fundingSourceInquiryResponse = $context.$nodes.FUNDING_SOURCE_INQUIRY.$output;\n\nif (typeof fundingSourceInquiryResponse === \"string\") {\n  try {\n    fundingSourceInquiryResponse = JSON.parse(fundingSourceInquiryResponse);\n  } catch (e) {\n    fundingSourceInquiryResponse = {};\n  }\n}\n\nlet item = fundingSourceInquiryResponse?.items?.[0] ?? {};\n\nlet fundingsourceinquiryArray = [\n  { \"Funding Source Number\": item?.FundingSourceNumber ?? \"\" },\n  { \"Funding Source Name\": item?.FundingSourceName ?? \"\" },\n  { \"Funding Source Type Name\": item?.FundingSourceTypeName ?? \"\" },\n  { \"Funding Source Type Code\": item?.FundingSourceTypeCode ?? \"\" },\n  { \"Funding Source From Date\": item?.FundingSourceFromDate ?? \"\" },\n  { \"Funding Source To Date\": item?.FundingSourceToDate ?? \"\" }\n];\n\nreturn fundingsourceinquiryArray;"
