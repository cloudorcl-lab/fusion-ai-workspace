            "name": "Extract Cost Organization Parameters",
            "returnType": "object",
            "sourceCode": "let costOrganizationFilter = $context.$nodes.COST_ORGANIZATION_FILTER_EXTRACTION.$output.additionalEntitiesFilter;\nlet costOrganizationFields = $context.$variables.prjPjcVarConvCostOrganizationExtractSelect;\nlet costOrganizationPayload = $context.$variables.prjPjcVarConvCostOrganizationExtractPayload;\nlet payloadObj = JSON.parse(costOrganizationPayload);\nlet modifiedPayloadObj = JSON.parse(JSON.stringify(payloadObj)); // Deep copy\nmodifiedPayloadObj.select = modifiedPayloadObj.select\n    .replace(\"{selectClause}\", costOrganizationFields)\n    .replace(\"{whereClause}\", costOrganizationFilter);\nreturn JSON.stringify(modifiedPayloadObj);"
