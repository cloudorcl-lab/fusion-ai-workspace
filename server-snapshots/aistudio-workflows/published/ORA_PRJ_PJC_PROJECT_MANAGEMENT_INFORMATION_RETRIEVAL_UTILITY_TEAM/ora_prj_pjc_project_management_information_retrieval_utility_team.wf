            "sourceCode": "let projectRoleFilter = $context.$nodes.PROJECT_ROLE_FILTER_EXTRACTION.$output.additionalEntitiesFilter;\nlet projectRoleFields = $context.$variables.prjPjcVarUqprojectRolesInquiry;\n\nlet parts = [];\n\nif (projectRoleFilter) {\n  parts.push(`$filter=${encodeURIComponent(projectRoleFilter)}`);\n}\n\nif (projectRoleFields) {\n  parts.push(`$fields=${encodeURIComponent(projectRoleFields)}`);\n}\n\nreturn parts.join(\"&\");"
