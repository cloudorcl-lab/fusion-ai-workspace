              "type": "string",
              "value": "{{$context.$variables.prjPjcVarUqClarifyingResponse != null && $context.$variables.prjPjcVarUqClarifyingResponse != \"\"}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.75
              },
              "code": "ORA_LLM_MODEL_PROVIDER_CERT_BASIC_LLAMA_3_3_70B",
              "model": "ORA_LLM_MODEL_GPT_OSS_120B",
              "modelName": "Gpt Oss",
              "provider": "CERT_BASIC"
            },
            "name": "Provide Clarifying Response"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "PROVIDE_CLARIFYING_RESPONSE",
          "id": "1773410772222",
          "inputs": [
            {
              "id": "1773410772223_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a post-processor. You receive a single input string called ClarifyingResponse from {{$context.$variables.prjPjcVarUqClarifyingResponse}}.\n\n###Input ClarifyingResponse:\n{{$context.$variables.prjPjcVarUqClarifyingResponse}}\n\n###Instructions:\n1. If ClarifyingResponse is empty, blank, null, the text \"null\", or only whitespace, you MUST respond with EXACTLY this string and nothing else:\n\"We couldn’t complete your request right now due to a temporary service, access, or environment issue. Try again in a few minutes. If the problem continues, check that you have the required access or contact your administrator.\"\n\n2. If ClarifyingResponse is not empty, you MUST respond with ClarifyingResponse EXACTLY as received, with no modifications, no added text, and no formatting changes.\n\n###Output Format (Critical):\n- Return only the final string.\n- Do not wrap it in JSON, XML, or any other structure.\n- Do not add any explanations, prefixes, suffixes, or examples."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "errorNodeId": "1773410772222",
            "name": "Check If Additional Information Attribute Values Are Empty",
            "returnType": "boolean",
            "sourceCode": "let additionalInformation = $context.$variables.prjPjcVarConvAdditionalInformationResponse;\n\nif (typeof additionalInformation === \"string\") {\n  try {\n    additionalInformation = JSON.parse(additionalInformation);\n  } catch (e) {\n    additionalInformation = [];\n  }\n}\n\nif (!Array.isArray(additionalInformation)) {\n  additionalInformation = [];\n}\n\nlet dataObj = additionalInformation[0] ?? {};\n\nif (!dataObj || typeof dataObj !== \"object\" || Array.isArray(dataObj)) {\n  dataObj = {};\n}\n\nlet keys = Object.keys(dataObj);\n\nif (keys.length === 0) {\n  return true;\n}\n\nlet allEmpty = keys.every(key => {\n  let value = dataObj[key];\n\n  if (value == null) return true;\n\n  if (typeof value === \"string\" && value.trim() === \"\") return true;\n\n  return false;\n});\n\nreturn allEmpty;"
          },
          "outcomes": {
            "success": "1773485461960"
          },
          "code": "CHECK_IF_ADDITIONAL_INFORMATION_ATTRIBUTE_VALUES_ARE_EMPTY",
          "id": "1773485217100",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
