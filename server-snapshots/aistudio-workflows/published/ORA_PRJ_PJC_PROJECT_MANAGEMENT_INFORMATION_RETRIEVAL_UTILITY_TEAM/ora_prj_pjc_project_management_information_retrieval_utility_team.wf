        {
          "metadata": {
            "errorNodeId": "1773410772222",
            "name": "Create Project Cost Extract Response Object",
            "returnType": "array",
            "sourceCode": "let costExtractResponse = $context.$nodes.PROJECT_COST_INQUIRY.$output;\n\nlet item = costExtractResponse?.[0] ?? {};\n\nlet costinquiryArray = [\n  { \"Transaction Number\": item?.TRANSACTIONNUMBER ?? \"\" },\n  { \"Transaction Date\": item?.TRANSACTIONDATE ?? \"\" },\n  { \"Project Number\": item?.PROJECTNUMBER ?? \"\" },\n  { \"Project Name\": item?.PROJECTNAME ?? \"\" },\n  { \"Task Number\": item?.TASKNUMBER ?? \"\" },\n  { \"Task Name\": item?.TASKNAME ?? \"\" },\n  { \"Contract Number\": item?.CONTRACTNUMBER ?? \"\" },\n  { \"Contract Name\": item?.CONTRACTNAME ?? \"\" },\n  { \"Funding Source Number\": item?.FUNDINGSOURCENUMBER ?? \"\" },\n  { \"Project Role Name\": item?.PROJECTROLENAME ?? \"\" },\n  { \"Person Job Name\": item?.PERSONJOBNAME ?? \"\" },\n  { \"Business Unit Name\": item?.BUSINESSUNITNAME ?? \"\" },\n  { \"Transaction Source Name\": item?.TRANSACTIONSOURCENAME ?? \"\" },\n  { \"Document Name\": item?.DOCUMENTNAME ?? \"\" },\n  { \"Document Entry Name\": item?.DOCUMENTENTRYNAME ?? \"\" },\n  { \"Quantity\": item?.QUANTITY ?? \"\" },\n  { \"Raw Cost in Transaction Currency\": item?.RAWCOSTINTRANSACTIONCURRENCY ?? \"\" },\n  { \"Burdened Cost in Transaction Currency\": item?.BURDENEDCOSTINTRANSACTIONCURRENCY ?? \"\" },\n  { \"Provider Ledger Raw Cost\": item?.RAWCOSTINPROVIDERLEDGERCURRENCY ?? \"\" },\n  { \"Burdened Cost\": item?.BURDENEDCOSTINPROVIDERLEDGERCURRENCY ?? \"\" },\n  { \"Provider Ledger Currency Code\": item?.PROVIDERLEDGERCURRENCYCODE ?? \"\" },\n  { \"Project Cost Type Name\": item?.PROJECTCOSTTYPENAME ?? \"\" },\n  { \"Invoice Number\": item?.INVOICENUMBER ?? \"\" },\n  { \"Supplier Number\": item?.SUPPLIERNUMBER ?? \"\" },\n  { \"Supplier Name\": item?.SUPPLIERNAME ?? \"\" },\n  { \"Purchase Order Number\": item?.PURCHASEORDERNUMBER ?? \"\" },\n  { \"Sales Order Number\": item?.SALESORDERNUMBER ?? \"\" },\n  { \"Work Order Number\": item?.WORKORDERNUMBER ?? \"\" },\n  { \"Shipment Number\": item?.SHIPMENTNUMBER ?? \"\" },\n  { \"Receipt Number\": item?.RECEIPTNUMBER ?? \"\" },\n  { \"Payment Number\": item?.PAYMENTNUMBER ?? \"\" },\n  { \"Transfer Order Number\": item?.TRANSFERORDERNUMBER ?? \"\" },\n  { \"Original Transaction Reference\": item?.ORIGINALTRANSACTIONREFERENCE ?? \"\" },\n  { \"Net Zero Item\": item?.NETZEROITEMFLAG ?? \"\" },\n  { \"Accrual\": item?.ACCRUALFLAG ?? \"\" },\n  { \"Provider Accrual Date\": item?.PROVIDERACCRUALDATE ?? \"\" },\n  { \"Receiver Accrual Date\": item?.RECEIVERACCRUALDATE ?? \"\" },\n  { \"Included In Asset Line\": item?.INCLUDEDINASSETLINE ?? \"\" },\n  { \"Transferred From Transaction Number\": item?.TRANSFERREDFROMTRANSACTIONNUMBER ?? \"\" },\n  { \"Adjusted Transaction Number\": item?.ADJUSTINGTRANSACTIONNUMBER ?? \"\" },\n  { \"Created By\": item?.CREATEDBY ?? \"\" },\n  { \"Created On\": item?.TIMECREATED ?? \"\" }\n];\n\nreturn costinquiryArray;"
          },
          "outcomes": {
            "success": "1773667764871"
          },
