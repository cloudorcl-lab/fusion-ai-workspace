            "sourceCode": "const entity = $context.$variables.prjPjcVarConvLastResponseFilterEntity;\nconst entityValue = typeof entity === \"string\" ? entity.trim() : \"\";\n\nlet message = \"\";\n\nif (!entityValue) {\n  message = \"The requested information is not valid. Please provide the correct details.\";\n} else {\n  message = `I couldn't find that <b>${entityValue}</b>. Search uses exact values and is case sensitive. Check the <b>${entityValue}</b> details and try again.`;\n}\nreturn message;"
