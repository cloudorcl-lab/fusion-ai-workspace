        {
          "metadata": {
            "errorNodeId": "1773410772222",
            "name": "Additional Information Response Generator",
            "returnType": "string",
            "sourceCode": "let input = $context.$variables.prjPjcVarConvAdditionalInformationResponse;\n\nif (typeof input === \"string\") {\n  try {\n    input = JSON.parse(input);\n  } catch (e) {\n    input = [];\n  }\n}\n\nlet dataObj = {};\n\nif (Array.isArray(input)) {\n  for (let obj of input) {\n    if (obj && typeof obj === \"object\" && !Array.isArray(obj)) {\n      Object.assign(dataObj, obj);\n    }\n  }\n}\n\nif (!dataObj || typeof dataObj !== \"object\" || Array.isArray(dataObj)) {\n  dataObj = {};\n}\n\nlet rows = [];\n\nfunction escapeHtml(str) {\n  return String(str)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n}\n\nfor (let key in dataObj) {\n  let val = dataObj[key];\n\n  if (val === null || val === undefined || val === \"\") {\n    val = \"—\";\n  }\n\n  if (typeof val !== \"string\") {\n    try {\n      val = JSON.stringify(val);\n    } catch (e) {\n      val = String(val);\n    }\n  }\n\n  rows.push({ key: escapeHtml(key), val: escapeHtml(val) });\n}\n\nlet html = \"\";\n\nhtml += \"<div style=\\\"font-family:'Oracle Sans', Arial, sans-serif; font-size:13px; margin:10px 0 0 0;\\\">Here are the details -<br><br></div>\";\nhtml += \"<div style=\\\"display:block; max-width:100%; max-height:320px; overflow:auto; box-sizing:border-box; font-size:12px;\\\">\";\nhtml += \"<table cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" style=\\\"width:100%; border-collapse:collapse; font-family:'Oracle Sans', Arial, sans-serif; table-layout:fixed; border:1px solid #E4E1DD; font-size:12px;\\\">\";\nhtml += \"<colgroup><col style=\\\"width:40%;\\\"><col style=\\\"width:60%;\\\"></colgroup>\";\n\nhtml += \"<thead>\";\nhtml += \"<tr style=\\\"font-weight:bold; position:sticky; top:0; background:#FFFFFF; z-index:2;\\\">\";\nhtml += \"<th style=\\\"padding:6px; text-align:left; border:1px solid #E4E1DD; position:sticky; top:0; background:#FFFFFF; z-index:3;\\\">Field</th>\";\nhtml += \"<th style=\\\"padding:6px; text-align:left; border:1px solid #E4E1DD; position:sticky; top:0; background:#FFFFFF; z-index:3;\\\">Value</th>\";\nhtml += \"</tr>\";\nhtml += \"</thead>\";\n\nhtml += \"<tbody>\";\n\nif (rows.length === 0) {\n  html += \"<tr><td colspan=\\\"2\\\" style=\\\"padding:12px; text-align:center; border:1px solid #E4E1DD;\\\">No Data</td></tr>\";\n} else {\n  for (let row of rows) {\n    html += \"<tr>\";\n    html += \"<td style=\\\"padding:6px; border:1px solid #E4E1DD; overflow-wrap:anywhere;\\\">\" + row.key + \"</td>\";\n    html += \"<td style=\\\"padding:6px; border:1px solid #E4E1DD; overflow-wrap:anywhere;\\\">\" + row.val + \"</td>\";\n    html += \"</tr>\";\n  }\n}\n\nhtml += \"</tbody></table></div>\";\nreturn html;"
          },
