            "name": "Extract Project URL Parameters",
            "returnType": "string",
            "sourceCode": "let projectFilter = $context.$nodes.EXTRACT_PROJECT_FILTER.$output.additionalEntitiesFilter;\nlet projectFields = $context.$variables.prjPjcVarConvProjectsInquirySelect;\n\nlet parts = [];\n\nif (projectFilter) parts.push(`$filter=${encodeURIComponent(projectFilter)}`);\nif (projectFields) parts.push(`$fields=${encodeURIComponent(projectFields)}`);\n\nreturn parts.join(\"&\");"
          },
          "outcomes": {
