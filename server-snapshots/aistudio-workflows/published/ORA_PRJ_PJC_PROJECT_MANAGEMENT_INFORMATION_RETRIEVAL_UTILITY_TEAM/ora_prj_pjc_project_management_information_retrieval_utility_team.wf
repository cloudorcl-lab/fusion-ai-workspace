          "metadata": {
            "errorNodeId": "1773410772222",
            "name": "Extract Project Cost Parameters",
            "returnType": "object",
            "sourceCode": "let costFilter = $context.$nodes.EXTRACT_PROJECT_COST_FILTER.$output.costEntitiesFilter;\nlet costFields = $context.$variables.prjPjcVarConvProjectCostExtractSelect;\nlet costPayload = $context.$variables.prjPjcVarConvCostTransactionsExtractPayload;\n\nlet payloadObj = typeof costPayload === \"string\" ? JSON.parse(costPayload) : costPayload;\nlet modifiedPayloadObj = JSON.parse(JSON.stringify(payloadObj));\n\nmodifiedPayloadObj.select = modifiedPayloadObj.select\n    .replace(\"{selectClause}\", costFields)\n    .replace(\"{whereClause}\", costFilter);\n\nreturn JSON.stringify(modifiedPayloadObj);"
          },
          "outcomes": {
            "success": "1773667626183"
          },
