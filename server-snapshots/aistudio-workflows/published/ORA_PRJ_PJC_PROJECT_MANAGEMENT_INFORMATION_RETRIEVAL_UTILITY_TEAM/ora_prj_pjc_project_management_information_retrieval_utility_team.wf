            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "errorNodeId": "1773410772222",
            "name": "Create Project Inquiry Response Object",
            "returnType": "array",
            "sourceCode": "let projectsInquiryResponse = $context.$nodes.PROJECT_INQUIRY?.$output;\n\nlet item = projectsInquiryResponse?.items?.[0] ?? {};\n\nlet projectsinquiryArray = [\n  { \"Project Number\": item?.projectNumber ?? \"\" },\n  { \"Project Name\": item?.name ?? \"\" },\n  { \"Description\": item?.description ?? \"\" },\n  { \"Project Type Name\": item?.projectType?.name ?? \"\" },\n  { \"Project Unit Name\": item?.projectUnit?.name ?? \"\" },\n  { \"Business Unit Name\": item?.businessUnit?.name ?? \"\" },\n  { \"Project Organization Name\": item?.projectOrganization?.name ?? \"\" },\n  { \"Legal Entity Name\": item?.legalEntity?.legalEntityName ?? \"\" },\n  { \"Project Currency Code\": item?.projectCurrency?.currencyCode ?? \"\" },\n  { \"Project Ledger Currency Code\": item?.projectLedgerCurrency?.currencyCode ?? \"\" },\n  { \"Start Date\": item?.startDate ?? \"\" },\n  { \"Finish Date\": item?.finishDate ?? \"\" },\n  { \"Capital Event Processing Method\": item?.capitalEventProcessingMethod ?? \"\" },\n  { \"Allow Charges from All Provider Business Units\": item?.allowCrossChargeFlag ?? \"\" },\n  { \"Creation Date\": item?.timeCreated ?? \"\" },\n  { \"Created By\": item?.createdBy ?? \"\" },\n  { \"Last Updated Date\": item?.timeUpdated ?? \"\" },\n  { \"Last Updated By\": item?.updatedBy ?? \"\" }\n];\n\nreturn projectsinquiryArray;"
          },
          "outcomes": {
            "success": "1772797997736"
          },
          "code": "CREATE_PROJECT_INQUIRY_RESPONSE_OBJECT",
