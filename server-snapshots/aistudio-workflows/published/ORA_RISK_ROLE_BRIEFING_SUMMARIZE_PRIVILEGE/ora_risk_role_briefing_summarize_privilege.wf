          "code": "PRIVILEGE_SUMMARIZER",
          "id": "1763644049381",
          "inputs": [
            {
              "id": "1763644049383_1",
              "name": "prompt",
              "type": "string",
              "value": "Assume the role of a role analyzer highly skilled at grouping privileges into broad clusters.\n\nInstructions:\n- Read the following privilege names and descriptions:\n  {{$context.$triggers.REST.$input.privilegeList}}\n\n- Your goal is to create the SMALLEST POSSIBLE NUMBER of categories, by grouping all related or similar privileges together into as FEW broad, logical categories as you reasonably can.\n\n- Only create separate categories when a privilege clearly cannot be grouped with others based on function or meaning.\n\n- Avoid splitting privileges into separate categories for minor differences—be generous in grouping.\n\nFor each category, provide ONLY:\n- A concise category name (broad, without unnecessary detail)\n- A brief description (1–2 sentences, clearly explaining the group)\n\nDO NOT create categories for minor differences. DO NOT repeat or create similar categories. \nCheck your categories and MERGE any that could reasonably be combined.\n\nTranslate all category names and descriptions into the {{$context.$triggers.REST.$input.outputLang}} language.\nPlease ensure that every word—including category names and all parts of the descriptions—is translated. Do not leave any words untranslated, unless they are proper nouns."
            }
          ],
          "outputSpecification": "[\n  {\n    \"index\": 1,\n    \"name\": \"Cluster heading\",\n    \"description\": \"Cluster description\"\n  },\n  {\n    \"index\": 2,\n    \"name\": \"Cluster heading\",\n    \"description\": \"Cluster description\"\n  }\n]",
          "type": "LLM"
        }
      ],
