            "name": "Format Guided Resource Task Options",
            "returnType": "object",
            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\n\nfunction parseMaybe(value) {\n  var current = value;\n  var depth = 0;\n  while (typeof current === 'string' && trimString(current) !== '' && depth < 6) {\n    try {\n      current = JSON.parse(current);\n      depth += 1;\n    } catch (ignore1) {\n      break;\n    }\n  }\n  return current;\n}\n\nfunction getItems(value) {\n  var current = parseMaybe(value);\n  var depth = 0;\n  while (current && depth < 6) {\n    if (Array.isArray(current)) {\n      return current;\n    }\n    if (Array.isArray(current.items)) {\n      return current.items;\n    }\n    if (current.output !== undefined) {\n      current = parseMaybe(current.output);\n      depth += 1;\n      continue;\n    }\n    if (current.result !== undefined) {\n      current = parseMaybe(current.result);\n      depth += 1;\n      continue;\n    }\n    break;\n  }\n  return [];\n}\n\nfunction pad2(value) {\n  value = parseInt(value, 10);\n  return (value < 10 ? '0' : '') + value;\n}\n\nfunction toIsoDate(rawValue) {\n  var raw = trimString(rawValue);\n  var months = {\n    jan: '01', january: '01',\n    feb: '02', february: '02',\n    mar: '03', march: '03',\n    apr: '04', april: '04',\n    may: '05',\n    jun: '06', june: '06',\n    jul: '07', july: '07',\n    aug: '08', august: '08',\n    sep: '09', sept: '09', september: '09',\n    oct: '10', october: '10',\n    nov: '11', november: '11',\n    dec: '12', december: '12'\n  };\n  var parsedDate;\n  var match;\n  var key;\n  if (!raw) {\n    return '';\n  }\n  raw = raw.replace(/,/g, ' ').replace(/(\\d+)(st|nd|rd|th)\\b/gi, '$1').replace(/\\s+/g, ' ').trim();\n  match = raw.match(/^(\\d{4})[-\\/](\\d{1,2})[-\\/](\\d{1,2})/);\n  if (match) {\n    return match[1] + '-' + pad2(match[2]) + '-' + pad2(match[3]);\n  }\n  match = raw.match(/^(\\d{1,2})[-\\/](\\d{1,2})[-\\/](\\d{4})$/);\n  if (match) {\n    return match[3] + '-' + pad2(match[1]) + '-' + pad2(match[2]);\n  }\n  match = raw.toLowerCase().match(/^([a-z]+)\\s+(\\d{1,2})\\s+(\\d{4})$/);\n  if (match) {\n    key = match[1];\n    if (months[key]) {\n      return match[3] + '-' + months[key] + '-' + pad2(match[2]);\n    }\n  }\n  match = raw.toLowerCase().match(/^(\\d{1,2})\\s+([a-z]+)\\s+(\\d{4})$/);\n  if (match) {\n    key = match[2];\n    if (months[key]) {\n      return match[3] + '-' + months[key] + '-' + pad2(match[1]);\n    }\n  }\n  parsedDate = new Date(raw);\n  if (!isNaN(parsedDate.getTime())) {\n    return parsedDate.getUTCFullYear() + '-' + pad2(parsedDate.getUTCMonth() + 1) + '-' + pad2(parsedDate.getUTCDate());\n  }\n  return '';\n}\n\nfunction toMmDdYyyy(rawValue) {\n  var iso = toIsoDate(rawValue);\n  var match = iso.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);\n  if (!match) {\n    return trimString(rawValue);\n  }\n  return match[2] + '/' + match[3] + '/' + match[1];\n}\n\nfunction compareDates(left, right) {\n  left = toIsoDate(left);\n  right = toIsoDate(right);\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(left) || !/^\\d{4}-\\d{2}-\\d{2}$/.test(right)) {\n    return null;\n  }\n  if (left === right) {\n    return 0;\n  }\n  return left < right ? -1 : 1;\n}\n\nfunction monthIndex(dateText) {\n  var dateValue = toIsoDate(dateText);\n  var match = dateValue.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);\n  if (!match) {\n    return null;\n  }\n  return Number(match[1]) * 12 + Number(match[2]) - 1;\n}\n\nfunction monthCountInclusive(startDate, endDate) {\n  var startIndex = monthIndex(startDate);\n  var endIndex = monthIndex(endDate);\n  if (startIndex === null || endIndex === null || endIndex < startIndex) {\n    return null;\n  }\n  return endIndex - startIndex + 1;\n}\n\nfunction parseNumber(value) {\n  var text;\n  var num;\n  if (value === null || value === undefined || value === '') {\n    return null;\n  }\n  if (typeof value === 'number') {\n    return isNaN(value) ? null : value;\n  }\n  text = trimString(value);\n  if (!text) {\n    return null;\n  }\n  if (/^\\(.+\\)$/.test(text)) {\n    text = '-' + text.slice(1, -1);\n  }\n  text = text.replace(/[$,\\s]/g, '');\n  num = Number(text);\n  return isNaN(num) ? null : num;\n}\n\nfunction addAmount(total, value) {\n  var num = parseNumber(value);\n  if (num === null) {\n    return total;\n  }\n  return total === null ? num : total + num;\n}\n\nfunction firstValue(item, names) {\n  var i;\n  var value;\n  item = item || {};\n  for (i = 0; i < names.length; i++) {\n    value = item[names[i]];\n    if (value !== undefined && value !== null && trimString(value) !== '') {\n      return value;\n    }\n  }\n  return '';\n}\n\nfunction amountFromPlanning(item, names) {\n  var planningRows = getItems(item && item.PlanningAmounts !== undefined ? item.PlanningAmounts : []);\n  var total = null;\n  var i;\n  for (i = 0; i < planningRows.length; i++) {\n    total = addAmount(total, firstValue(planningRows[i] || {}, names));\n  }\n  return total;\n}\n\nfunction plannedQuantity(item) {\n  var quantity = amountFromPlanning(item, ['PlannedQuantity', 'Quantity']);\n  if (quantity === null) {\n    quantity = parseNumber(firstValue(item, ['PlannedQuantity', 'plannedQuantity', 'Quantity', 'quantity']));\n  }\n  if (quantity === null) {\n    quantity = parseNumber(firstValue(item, ['PlannedEffortHours', 'plannedEffortHours', 'PlannedEffort', 'plannedEffort', 'EffortInHours', 'effortInHours']));\n  }\n  return quantity;\n}\n\nfunction remainingEffort(quantity, startDate, endDate, effectiveDate) {\n  var planned = parseNumber(quantity);\n  var start = toIsoDate(startDate);\n  var end = toIsoDate(endDate);\n  var effective = toIsoDate(effectiveDate);\n  var totalMonths;\n  var remainingMonths;\n  if (planned === null) {\n    return null;\n  }\n  if (!effective || !end || !/^\\d{4}-\\d{2}-\\d{2}$/.test(effective) || !/^\\d{4}-\\d{2}-\\d{2}$/.test(end)) {\n    return planned;\n  }\n  if (compareDates(effective, end) > 0) {\n    return null;\n  }\n  if (!start || !/^\\d{4}-\\d{2}-\\d{2}$/.test(start) || compareDates(effective, start) <= 0) {\n    return planned;\n  }\n  totalMonths = monthCountInclusive(start, end);\n  remainingMonths = monthCountInclusive(effective, end);\n  if (totalMonths === null || remainingMonths === null || totalMonths <= 0) {\n    return planned;\n  }\n  return planned * remainingMonths / totalMonths;\n}\n\nfunction normalizeKey(value) {\n  return trimString(value).toLowerCase().replace(/\\b(?:mr|mrs|ms|miss|dr)\\.?\\b/g, ' ').replace(/[^a-z0-9]+/g, '');\n}\n\nfunction scoreName(name, requestedKey) {\n  var candidateKey = normalizeKey(name);\n  if (!candidateKey || !requestedKey) {\n    return 0;\n  }\n  if (candidateKey === requestedKey) {\n    return 100;\n  }\n  if (candidateKey.indexOf(requestedKey) > -1 || requestedKey.indexOf(candidateKey) > -1) {\n    return 50;\n  }\n  return 0;\n}\n\nfunction buildTaskOption(item, optionIndex, projectName, projectId, planVersionId, effectiveDate) {\n  var startDate = firstValue(item, ['PlanningStartDate', 'planningStartDate', 'AssignmentStartDate', 'assignmentStartDate', 'PlannedStartDate', 'StartDate', 'startDate', 'BaselineStartDate']);\n  var finishDate = firstValue(item, ['PlanningFinishDate', 'planningFinishDate', 'PlanningEndDate', 'AssignmentEndDate', 'assignmentEndDate', 'PlannedFinishDate', 'FinishDate', 'finishDate', 'EndDate', 'endDate', 'BaselineFinishDate']);\n  var planned = plannedQuantity(item);\n  var remaining = remainingEffort(planned, startDate, finishDate, effectiveDate);\n  if (remaining === null) {\n    return null;\n  }\n  return {\n    optionIndex: optionIndex,\n    projectName: projectName,\n    taskId: trimString(item.TaskId || item.taskId || ''),\n    taskNumber: trimString(item.TaskNumber || item.taskNumber || ''),\n    taskName: trimString(item.TaskName || item.taskName || item.SummaryTaskName || item.summaryTaskName || ''),\n    planningElementId: trimString(item.PlanningElementId || item.planningElementId || ''),\n    rbsElementId: trimString(item.RbsElementId || item.rbsElementId || ''),\n    oldResourceElementId: trimString(item.RbsElementId || item.rbsElementId || ''),\n    resourceName: trimString(item.ResourceName || item.resourceName || ''),\n    projectId: trimString(projectId || item.ProjectId || item.projectId || ''),\n    planVersionId: trimString(planVersionId || item.PlanVersionId || item.planVersionId || ''),\n    planClassCode: '0',\n    planningStartDate: toMmDdYyyy(startDate),\n    planningFinishDate: toMmDdYyyy(finishDate),\n    plannedEffortHours: planned,\n    remainingEffortHours: remaining\n  };\n}\n\nvar fetchAssignments = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FETCH_GUIDED_ASSIGNMENTS.$output || {};\nvar plan = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_SELECT_PLAN.$output.result || {};\nvar request = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_RESOLVE_DIRECT_TIMING_OVERRIDE_V1.$output.result || {};\nvar effectiveState = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_EFFECTIVE_STATE_V2.$output.result || {};\nvar variables = $context.$variables || {};\nvar currentResource = trimString(request.resourceName || variables.ResourceName || effectiveState.ResourceName || '');\nvar replacementResource = trimString(request.replacementResourceName || variables.ReplacementResourceName || effectiveState.ReplacementResourceName || '');\nvar projectName = trimString(request.projectName || variables.ProjectName || effectiveState.ProjectName || plan.projectName || plan.ProjectName || '');\nvar projectId = trimString(plan.projectId || plan.ProjectId || '');\nvar planVersionId = trimString(plan.planVersionId || plan.PlanVersionId || '');\nvar effectiveDate = toIsoDate(request.unavailabilityDate || variables.UnavailabilityDate || effectiveState.UnavailabilityDate || '');\nvar requestedKey = normalizeKey(currentResource);\nvar sourceItems = getItems(fetchAssignments.items !== undefined ? fetchAssignments.items : fetchAssignments);\nvar options = [];\nvar seen = {};\nvar i;\nvar item;\nvar itemResource;\nvar finishDate;\nvar taskKey;\nvar option;\n\nfor (i = 0; i < sourceItems.length; i++) {\n  item = parseMaybe(sourceItems[i]) || {};\n  itemResource = trimString(item.ResourceName || item.resourceName || currentResource || '');\n  if (requestedKey && scoreName(itemResource, requestedKey) <= 0) {\n    continue;\n  }\n  finishDate = toIsoDate(firstValue(item, ['PlanningFinishDate', 'planningFinishDate', 'PlanningEndDate', 'AssignmentEndDate', 'assignmentEndDate', 'PlannedFinishDate', 'FinishDate', 'finishDate', 'EndDate', 'endDate', 'BaselineFinishDate']));\n  if (effectiveDate && finishDate && effectiveDate > finishDate) {\n    continue;\n  }\n  taskKey = trimString(item.TaskId || item.taskId || item.PlanningElementId || item.planningElementId || item.TaskNumber || item.taskNumber || item.TaskName || item.taskName || ('idx_' + i));\n  if (!taskKey || seen[taskKey]) {\n    continue;\n  }\n  option = buildTaskOption(item, options.length + 1, projectName, projectId, planVersionId, effectiveDate);\n  if (!option) {\n    continue;\n  }\n  seen[taskKey] = true;\n  options.push(option);\n}\n\nif (options.length) {\n  return {\n    response: 'Impacted assignments identified for review.',\n    intentStart: 'Y',\n    intentEnd: 'N',\n    nextStage: 'TASK_SELECTION',\n    roleOptionsJson: '[]',\n    taskOptionsJson: JSON.stringify(options),\n    taskCount: options.length,\n    replacementResourceName: replacementResource,\n    terminationDate: effectiveDate\n  };\n}\n\nreturn {\n  response: effectiveDate\n    ? 'I could not find active assignments for ' + currentResource + ' in ' + projectName + ' that continue on or after effective date ' + effectiveDate + '.'\n    : 'I could not find active assignments for ' + currentResource + ' in ' + projectName + '.',\n  intentStart: 'N',\n  intentEnd: 'Y',\n  nextStage: '',\n  roleOptionsJson: '[]',\n  taskOptionsJson: '[]',\n  taskCount: 0,\n  replacementResourceName: replacementResource,\n  termin