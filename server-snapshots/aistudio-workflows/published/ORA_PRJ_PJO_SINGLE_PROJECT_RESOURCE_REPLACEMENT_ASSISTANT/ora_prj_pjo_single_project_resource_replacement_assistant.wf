            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\n\nvar variables = $context.$variables || {};\nvar effectiveState = (($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_EFFECTIVE_STATE_V2 || {}).$output || {}).result || {};\nvar requestedReplacement = trimString(variables.ReplacementResourceName || effectiveState.ReplacementResourceName || '');\nvar requestedSource = trimString(variables.RoleName || effectiveState.RoleName || variables.ResourceName || effectiveState.ResourceName || '');\nvar requestedTarget = requestedReplacement || requestedSource || 'the requested person, role, or job';\nvar projectName = trimString(variables.ProjectName || effectiveState.ProjectName || '');\nvar projectText = projectName ? ' in project ' + projectName : '';\nvar message = 'I could not find ' + requestedTarget + ' as an available person, role, or job' + projectText + '. Please provide an exact person, role, or job that already exists in the project resources. No replacement was performed.';\nvar result = {\n  response: message,\n  intentStart: 'N',\n  intentEnd: 'Y'\n};\nreturn result;"
