        {
          "metadata": {
            "errorNodeId": "1781000000199",
            "name": "Post Commit Summarize Current Plan",
            "returnType": "object",
            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\nfunction toNumber(value) {\n  if (value == null || value === '') {\n    return null;\n  }\n  value = Number(value);\n  return isNaN(value) ? null : value;\n}\nfunction formatAmount(value) {\n  var numberValue = toNumber(value);\n  var parts;\n  var text;\n  var sign;\n  if (numberValue === null) {\n    return 'N/A';\n  }\n  sign = numberValue < 0 ? '-' : '';\n  text = Math.abs(numberValue).toFixed(2);\n  parts = text.split('.');\n  parts[0] = parts[0].replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',');\n  return sign + '$' + parts[0] + '.' + parts[1];\n}\nfunction parseMaybe(value) {\n  var current = value;\n  var depth = 0;\n  while (typeof current === 'string' && trimString(current) !== '' && depth < 6) {\n    try {\n      current = JSON.parse(current);\n      depth += 1;\n    } catch (ignore1) {\n      break;\n    }\n  }\n  return current;\n}\nfunction extractItems(value) {\n  var current = parseMaybe(value);\n  var depth = 0;\n  while (current && depth < 6) {\n    if (Array.isArray(current.items)) {\n      return current.items;\n    }\n    if (current.output !== undefined) {\n      current = parseMaybe(current.output);\n      depth += 1;\n      continue;\n    }\n    if (current.result !== undefined) {\n      current = parseMaybe(current.result);\n      depth += 1;\n      continue;\n    }\n    break;\n  }\n  return Array.isArray(current) ? current : [];\n}\nfunction parsePendingItems(raw) {\n  var items = [];\n  try {\n    items = JSON.parse(decodeURIComponent(raw || '[]'));\n  } catch (ignore2) {\n    try {\n      items = JSON.parse(raw || '[]');\n    } catch (ignore3) {\n      items = [];\n    }\n  }\n  return Array.isArray(items) ? items : [];\n}\nfunction parsePayloadTaskId(item) {\n  var payload = parseMaybe(item.Payload || item.payload || '');\n  return trimString(payload && payload.taskId ? payload.taskId : '');\n}\nfunction buildTaskMapFromAssignments(assignments) {\n  var map = {};\n  var i;\n  var assignment;\n  var taskId;\n  for (i = 0; i < assignments.length; i++) {\n    assignment = parseMaybe(assignments[i]) || {};\n    taskId = trimString(assignment.TaskId || assignment.taskId || '');\n    if (!taskId || map[taskId]) {\n      continue;\n    }\n    map[taskId] = {\n      taskNumber: trimString(assignment.TaskNumber || assignment.taskNumber || ''),\n      taskName: trimString(assignment.TaskName || assignment.taskName || '')\n    };\n  }\n  return map;\n}\nfunction mergeTaskMaps(baseMap, extraMap) {\n  var key;\n  for (key in extraMap) {\n    if (extraMap.hasOwnProperty(key) && !baseMap[key]) {\n      baseMap[key] = extraMap[key];\n    }\n  }\n  return baseMap;\n}\nfunction taskLabel(item, taskMap) {\n  var taskId = trimString(item.TaskId || item.taskId || parsePayloadTaskId(item));\n  var mapped = taskId && taskMap[taskId] ? taskMap[taskId] : {};\n  var taskNumber = trimString(item.TaskNumber || item.taskNumber || mapped.taskNumber || '');\n  var taskName = trimString(item.TaskName || item.taskName || mapped.taskName || '');\n  return (taskNumber ? taskNumber + ' - ' : '') + (taskName || (taskId ? 'Task ' + taskId : 'Task'));\n}\nvar context = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_POST_COMMIT_BUDGET_CONTEXT_V3.$output.result || {};\nvar variables = $context.$variables || {};\nvar effectiveState = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_EFFECTIVE_STATE_V2.$output.result || {};\nvar planItems = extractItems((($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_POST_COMMIT_GET_CURRENT_PLAN_V1 || {}).$output) || {});\nvar plan = planItems.length ? (planItems[0] || {}) : {};\nvar storedAssignments = extractItems(variables.SelectedTaskAssignmentsJson || effectiveState.SelectedTaskAssignmentsJson || []);\nvar taskMap = buildTaskMapFromAssignments(extractItems(plan && plan.ResourceAssignments !== undefined ? plan.ResourceAssignments : []));\nmergeTaskMaps(taskMap, buildTaskMapFromAssignments(storedAssignments));\nvar pendingItems = parsePendingItems(String(context.pendingItemsJson || '[]'));\nvar taskLines = [];\nvar seen = {};\nvar i;\nvar item;\nvar key;\nvar label;\nvar effectiveDate = trimString(context.unavailabilityDate || '');\nfor (i = 0; i < pendingItems.length; i++) {\n  item = pendingItems[i] || {};\n  key = trimString(item.TaskId || item.taskId || parsePayloadTaskId(item) || item.TaskNumber || item.taskNumber || taskLabel(item, taskMap));\n  if (!key || seen[key]) {\n    continue;\n  }\n  seen[key] = true;\n  label = taskLabel(item, taskMap);\n  taskLines.push('| ' + String(taskLines.length + 1) + ' | ' + label.replace(/\\|/g, '/') + ' |');\n}\nreturn {\n  summaryText:\n    '- Replacement completed.' + '\\n\\n' +\n    '| Project | Replaced From | Replaced To | Replaced Assignments | Effective Date |' + '\\n' +\n    '| --- | --- | --- | --- | --- |' + '\\n' +\n    '| ' + trimString(plan.ProjectName || plan.ProjectNumber || context.projectName || '').replace(/\\|/g, '/') + ' | ' + trimString(context.oldResourceName || 'requested assignments').replace(/\\|/g, '/') + ' | ' + trimString(context.newResourceName || '').replace(/\\|/g, '/') + ' | ' + String(context.updatedAssignments || 0) + ' | ' + (effectiveDate || 'Full replacement') + ' |' + '\\n\\n' +\n    (taskLines.length ? ('| S No. | Replaced Task |' + '\\n' + '| --- | --- |' + '\\n' + taskLines.join('\\n') + '\\n\\n') : '') +\n    '| Metric | Current Plan Amount |' + '\\n' +\n    '| --- | --- |' + '\\n' +\n    '| Burdened Cost | ' + formatAmount(plan.BurdenedCostInProjectCurrency) + ' |' + '\\n' +\n    '| Revenue | ' + formatAmount(plan.RevenueInProjectCurrency) + ' |' + '\\n' +\n    '| Margin | ' + formatAmount(plan.Margin) + ' |'\n};"
