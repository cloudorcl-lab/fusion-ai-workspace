            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\n\nfunction quoteForQuery(value) {\n  return trimString(value).replace(/'/g, \"''\");\n}\n\nfunction buildBudgetFilter(projectName) {\n  var onlyFlag = 'only' + 'D' + 'ata';\n  if (!projectName) {\n    return '?' + onlyFlag + '=true&limit=1';\n  }\n  return \"?q=ProjectName='\" + quoteForQuery(projectName) + \"'&\" + onlyFlag + '=true&limit=1';\n}\n\nvar effectiveState = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_EFFECTIVE_STATE_V2.$output.result || {};\nvar variables = $context.$variables || {};\nvar raw = String(variables.PendingReplacementItemsJson || effectiveState.PendingReplacementItemsJson || '[]');\nvar items = [];\nvar first = {};\ntry {\n  items = JSON.parse(decodeURIComponent(raw || '[]'));\n} catch (ignore1) {\n  try {\n    items = JSON.parse(raw || '[]');\n  } catch (ignore2) {\n    items = [];\n  }\n}\nfirst = items.length ? (items[0] || {}) : {};\nvar projectName = trimString(variables.PendingProjectName || effectiveState.PendingProjectName || '');\nvar result = {\n  projectName: projectName,\n  oldResourceName: trimString(variables.PendingOldResourceName || effectiveState.PendingOldResourceName || ''),\n  newResourceName: trimString(variables.PendingNewResourceName || effectiveState.PendingNewResourceName || ''),\n  unavailabilityDate: trimString(variables.PendingUnavailabilityDate || effectiveState.PendingUnavailabilityDate || ''),\n  pendingItemsJson: String(raw || '[]'),\n  updatedAssignments: items.length,\n  planVersionId: trimString(first.PlanVersionId || first.planVersionId || ''),\n  budgetSourceFilterCriteria: buildBudgetFilter(projectName)\n};\nreturn result;"
