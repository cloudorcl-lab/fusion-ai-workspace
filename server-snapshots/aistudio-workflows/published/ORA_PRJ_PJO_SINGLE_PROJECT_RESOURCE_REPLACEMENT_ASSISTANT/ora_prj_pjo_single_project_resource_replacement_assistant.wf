            "name": "Format Role Options",
            "returnType": "object",
            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\n\nfunction pad2(value) {\n  value = parseInt(value, 10);\n  return (value < 10 ? '0' : '') + value;\n}\n\nfunction toMmDdYyyy(rawValue) {\n  var raw = trimString(rawValue);\n  var match;\n  var parsedDate;\n  if (!raw) {\n    return '';\n  }\n  match = raw.match(/^(\\d{4})-(\\d{1,2})-(\\d{1,2})/);\n  if (match) {\n    return pad2(match[2]) + '/' + pad2(match[3]) + '/' + match[1];\n  }\n  match = raw.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})$/);\n  if (match) {\n    return pad2(match[1]) + '/' + pad2(match[2]) + '/' + match[3];\n  }\n  match = raw.match(/^(\\d{4})\\/(\\d{1,2})\\/(\\d{1,2})$/);\n  if (match) {\n    return pad2(match[2]) + '/' + pad2(match[3]) + '/' + match[1];\n  }\n  parsedDate = new Date(raw);\n  if (!isNaN(parsedDate.getTime())) {\n    return pad2(parsedDate.getUTCMonth() + 1) + '/' + pad2(parsedDate.getUTCDate()) + '/' + parsedDate.getUTCFullYear();\n  }\n  return raw;\n}\n\nfunction parseMaybe(value) {\n  var current = value;\n  var depth = 0;\n  while (typeof current === 'string' && trimString(current) !== '' && depth < 6) {\n    try {\n      current = JSON.parse(current);\n      depth += 1;\n    } catch (ignore1) {\n      break;\n    }\n  }\n  return current;\n}\n\nfunction unwrapRoot(value) {\n  var current = value;\n  var depth = 0;\n  while (current !== null && current !== undefined && depth < 8) {\n    current = parseMaybe(current);\n    if (Array.isArray(current)) {\n      return current;\n    }\n    if (current && typeof current === 'object') {\n      if (Array.isArray(current.items)) {\n        return current;\n      }\n      if (current.output !== undefined) {\n        current = current.output;\n        depth += 1;\n        continue;\n      }\n      if (current.result !== undefined) {\n        current = current.result;\n        depth += 1;\n        continue;\n      }\n      if (current.response !== undefined && typeof current.response !== 'string') {\n        current = current.response;\n        depth += 1;\n        continue;\n      }\n    }\n    break;\n  }\n  return current;\n}\n\nfunction normalizeKey(value) {\n  return trimString(value).toLowerCase().replace(/[^a-z0-9]+/g, '');\n}\n\nfunction tokenize(value) {\n  var raw = trimString(value).toLowerCase().replace(/[^a-z0-9]+/g, ' ').split(/\\s+/);\n  var out = [];\n  var seen = {};\n  var i;\n  var token;\n  for (i = 0; i < raw.length; i += 1) {\n    token = trimString(raw[i]);\n    if (!token || token === 'and' || token === 'or' || token === 'the' || seen[token]) {\n      continue;\n    }\n    seen[token] = true;\n    out.push(token);\n  }\n  return out;\n}\n\nfunction cleanRoleDisplay(value) {\n  return trimString(value).replace(/[:\\-]\\s*labor$/i, '').replace(/\\s+/g, ' ').trim();\n}\n\nfunction getItems(container) {\n  var current = unwrapRoot(container);\n  if (Array.isArray(current)) {\n    return current;\n  }\n  if (current && Array.isArray(current.items)) {\n    return current.items;\n  }\n  return [];\n}\n\nfunction findSelectedPlan(fetchPlanOutput, planVersionId, projectName) {\n  var items = getItems(fetchPlanOutput);\n  var fallback = null;\n  var i;\n  var item;\n  for (i = 0; i < items.length; i += 1) {\n    item = parseMaybe(items[i]) || {};\n    if (planVersionId && trimString(item.PlanVersionId || item.planVersionId || '') === planVersionId) {\n      return item;\n    }\n    if (!fallback && projectName && trimString(item.ProjectName || item.projectName || '') === projectName) {\n      fallback = item;\n      if (trimString(item.PlanVersionStatus || item.planVersionStatus || '') === 'Current Working') {\n        return item;\n      }\n    }\n  }\n  if (fallback) {\n    return fallback;\n  }\n  for (i = 0; i < items.length; i += 1) {\n    item = parseMaybe(items[i]) || {};\n    if (trimString(item.PlanVersionStatus || item.planVersionStatus || '') === 'Current Working') {\n      return item;\n    }\n  }\n  return items.length ? (parseMaybe(items[0]) || {}) : {};\n}\n\nfunction getAssignments(planItem) {\n  return getItems(planItem && planItem.ResourceAssignments !== undefined ? planItem.ResourceAssignments : []);\n}\n\nfunction collectElements(rawPrbsOutput) {\n  var items = getItems(rawPrbsOutput);\n  var out = [];\n  var i;\n  var j;\n  var item;\n  var elements;\n  for (i = 0; i < items.length; i += 1) {\n    item = parseMaybe(items[i]) || {};\n    elements = getItems(item.Elements !== undefined ? item.Elements : []);\n    for (j = 0; j < elements.length; j += 1) {\n      out.push(parseMaybe(elements[j]) || {});\n    }\n  }\n  return out;\n}\n\nfunction roleMatchScore(bucket, requestedName) {\n  var requestedKey = normalizeKey(requestedName);\n  var displayKey = normalizeKey(bucket.displayName || bucket.roleName || '');\n  var jobCodeKey = normalizeKey(bucket.jobCode || '');\n  var requestedTokens = tokenize(requestedName);\n  var score = 0;\n  var i;\n  if (!requestedKey) {\n    return 0;\n  }\n  if (displayKey && displayKey === requestedKey) {\n    return 100;\n  }\n  if (jobCodeKey && jobCodeKey === requestedKey) {\n    return 95;\n  }\n  if (displayKey && (displayKey.indexOf(requestedKey) > -1 || requestedKey.indexOf(displayKey) > -1)) {\n    score = Math.max(score, 80);\n  }\n  if (jobCodeKey && (jobCodeKey.indexOf(requestedKey) > -1 || requestedKey.indexOf(jobCodeKey) > -1)) {\n    score = Math.max(score, 75);\n  }\n  for (i = 0; i < requestedTokens.length; i += 1) {\n    if (displayKey.indexOf(requestedTokens[i]) > -1 || jobCodeKey.indexOf(requestedTokens[i]) > -1) {\n      score += 12;\n    }\n  }\n  return score;\n}\n\nfunction noRoleResult(projectName, requestedName) {\n  var response = requestedName\n    ? 'I could not find role/job ' + requestedName + ' with task assignments in ' + (projectName || 'the selected project') + '.'\n    : 'I could not find any roles or jobs with task assignments in ' + (projectName || 'the selected project') + '.';\n  return {\n    response: response,\n    intentStart: 'N',\n    intentEnd: 'Y',\n    nextStage: '',\n    roleOptionsJson: '[]',\n    taskOptionsJson: '[]',\n    taskCount: 0,\n    roleCount: 0\n  };\n}\n\nvar req = ($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_RESOLVE_REQUEST_V5.$output || {}).result || {};\nvar effective = ($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_EFFECTIVE_STATE_V2.$output || {}).result || {};\nvar project = (($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_SELECT_PLAN.$output || {}).result) || {};\nvar fetchPlanOutput = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FETCH_PLAN.$output || {};\nvar prbsOutput = ($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FETCH_MATCH_PRBS_RESOURCES.$output || {}).items ? $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FETCH_MATCH_PRBS_RESOURCES.$output : (($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FETCH_PRBS_RESOURCES || {}).$output || {});\nvar activeIntent = trimString(req.intent || effective.Intent || $context.$variables.Intent || '');\nvar roleName = trimString(req.roleName || effective.RoleName || $context.$variables.RoleName || '');\nvar currentResource = trimString(req.resourceName || effective.ResourceName || $context.$variables.ResourceName || '');\nvar replacementResource = trimString(req.replacementResourceName || effective.ReplacementResourceName || $context.$variables.ReplacementResourceName || '');\nvar projectName = trimString(req.projectName || effective.ProjectName || $context.$variables.ProjectName || '');\nvar isRoleIntent = activeIntent === 'REPLACE_ROLE_WITH_NAMED_PERSON' || activeIntent === 'REPLACE_ALL_ROLES_WITH_NAMED_PERSONS';\nvar shouldTryRole = isRoleIntent || (activeIntent === 'REPLACE_UNAVAILABLE_RESOURCE' && currentResource !== '' && replacementResource !== '');\nvar guidedResult = (($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FORMAT_GUIDED_RESOURCE_TASK_OPTIONS_V3 || {}).$output || {}).result || null;\nif (!isRoleIntent && guidedResult && Number(guidedResult.taskCount || 0) > 0) {\n  return guidedResult;\n}\nvar requestedRoleName = roleName;\nvar selectedPlan = findSelectedPlan(fetchPlanOutput, trimString(project.planVersionId || ''), projectName);\nvar projectId = trimString(project.projectId || project.ProjectId || selectedPlan.ProjectId || selectedPlan.projectId || '');\nvar planVersionId = trimString(project.planVersionId || project.PlanVersionId || selectedPlan.PlanVersionId || selectedPlan.planVersionId || '');\nvar assignments = getAssignments(selectedPlan);\nvar prbsElements = collectElements(prbsOutput);\nvar elementById = {};\nvar buckets = {};\nvar order = [];\nvar i;\nvar j;\nvar item;\nvar element;\nvar displayName;\nvar key;\nvar taskKey;\nvar taskOption;\nvar roleType;\nvar result;\n\nif (!requestedRoleName && (activeIntent === 'REPLACE_ROLE_WITH_NAMED_PERSON' || (activeIntent === 'REPLACE_UNAVAILABLE_RESOURCE' && currentResource && replacementResource))) {\n  requestedRoleName = currentResource;\n}\n\nfor (i = 0; i < prbsElements.length; i += 1) {\n  element = prbsElements[i] || {};\n  key = trimString(element.ResourceElementId || element.resourceElementId || element.RbsElementId || element.rbsElementId || '');\n  if (key) {\n    elementById[key] = element;\n  }\n}\n\nfor (i = 0; i < assignments.length; i += 1) {\n  item = parseMaybe(assignments[i]) || {};\n  element = elementById[trimString(item.RbsElementId || item.rbsElementId || '')] || null;\n  if (!element) {\n    continue;\n  }\n  if (!trimString(element.ProjectRoleId || element.projectRoleId || '') && !trimString(element.JobId || element.jobId || '')) {\n    continue;\n  }\n  displayName = trimString(element.ProjectRoleName || element.projectRoleName || element.JobName || element.jobName || cleanRoleDisplay(item.ResourceName || item.resourceName || element.ResourceName || element.resourceName || ''));\n  if (!displayName) {\n    continue;\n  }\n  roleType = trimString(element.ProjectRoleId || element.projectRoleId || '') ? 'Project Role' : 'Job';\n  key = normalizeKey(displayName) + '|' + trimString(element.ProjectRoleId || element.projectRoleId || '') + '|' + trimString(element.JobId || element.jobId || '');\n  if (!buckets[key]) {\n    buckets[key] = {\n      roleName: displayName,\n      displayName: displayName,\n      roleType: roleType,\n      projectRoleId: trimString(element.ProjectRoleId || element.projectRoleId || ''),\n      jobId: trimString(element.JobId || element.jobId || ''),\n      jobCode: trimString(element.JobCode || element.jobCode || ''),\n      resourceElementId: trimString(item.RbsElementId || item.rbsElementId || element.ResourceElementId || element.resourceElementId || ''),\n      taskOptions: [],\n      seen: {},\n      labels: []\n    };\n    order.push(key);\n  }\n  taskKey = trimString(item.TaskId || item.taskId || item.TaskNumber || item.taskNumber || item.TaskName || item.taskName || ('idx_' + i));\n  if (buckets[key].seen[taskKey]) {\n    continue;\n  }\n  buckets[key].seen[taskKey] = true;\n  taskOption = {\n    optionIndex: buckets[key].taskOptions.length + 1,\n    taskId: trimString(item.TaskId || item.taskId || ''),\n    taskNumber: trimString(item.TaskNumber || item.taskNumber || ''),\n    taskName: trimString(item.TaskName || item.taskName || ''),\n    planningElementId: trimString(item.PlanningElementId || item.planningElementId || ''),\n    rbsElementId: trimString(item.RbsElementId || item.rbsElementId || ''),\n    oldResourceElementId: trimString(item.RbsElementId || item.rbsElementId || ''),\n    resourceName: trimString(item.ResourceName || item.resourceName || ''),\n    roleName: displayName,\n    projectRoleId: trimString(element.ProjectRoleId || element.projectRoleId || ''),\n    jobId: trimString(element.JobId || element.jobId || ''),\n    jobCode: trimString(element.JobCode || element.jobCode || ''),\n    projectId: projectId,\n    planVersionId: planVersionId,\n    planClassCode: '0',\n    planningStartDate: toMmDdYyyy(item.PlanningStartDate || item.planningStartDate || ''),\n    planningFinishDate: toMmDdYyyy(item.PlanningFinishDate || item.planningFinishDate || '')\n  };\n  buckets[key].taskOptions.push(taskOption);\n  if (buckets[key].labels.length < 3) {\n    buckets[key].labels.push((taskOption.taskNumber ? taskOption.taskNumber + ' - ' : '') + taskOption.taskName);\n  }\n}\n\nif (!shouldTryRole || !order.length) {\n  result = noRoleResult(projectName, requestedRoleName);\n} else if (requestedRoleName) {\n  var matchedKeys = [];\n  var bestScore = 0;\n  var score;\n  var selectedTasks = [];\n  var taskLines = [];\n  for (i = 0; i < order.length; i += 1) {\n    score = roleMatchScore(buckets[order[i]], requestedRoleName);\n    if (score > bestScore) {\n      bestScore = score;\n      matchedKeys = [order[i]];\n    } else if (score > 0 && score === bestScore) {\n      matchedKeys.push(order[i]);\n    }\n  }\n  if (!matchedKeys.length || bestScore <= 0) {\n    result = noRoleResult(projectName, requestedRoleName);\n  } else {\n    for (i = 0; i < matchedKeys.length; i += 1) {\n      var bucket = buckets[matchedKeys[i]];\n      for (j = 0; j < bucket.taskOptions.length; j += 1) {\n        taskOption = bucket.taskOptions[j] || {};\n        taskOption.optionIndex = selectedTasks.length + 1;\n        selectedTasks.push(taskOption);\n        taskLines.push(String(taskOption.optionIndex) + '. ' + (taskOption.taskNumber ? taskOption.taskNumber + ' - ' : '') + taskOption.taskName + (matchedKeys.length > 1 ? ' (' + bucket.displayName + ')' : ''));\n      }\n    }\n    if (!selectedTasks.length) {\n      result = noRoleResult(projectName, requestedRoleName);\n    } else {\n      result = {\n        response: 'Select task option number(s), task name(s), or all:' + String.fromCharCode(10) + taskLines.join(String.fromCharCode(10)),\n        intentStart: 'Y',\n        intentEnd: 'N',\n        nextStage: 'TASK_SELECTION',\n        roleOptionsJson: '[]',\n        taskOptionsJson: JSON.stringify(selectedTasks),\n        taskCount: selectedTasks.length,\n        roleCount: matchedKeys.length\n      };\n    }\n  }\n} else {\n  var options = [];\n  var lines = [];\n  for (i = 0; i < order.length; i += 1) {\n    var bucketForOption = buckets[order[i]];\n    for (j = 0; j < bucketForOption.taskOptions.length; j += 1) {\n      bucketForOption.taskOptions[j].optionIndex = j + 1;\n    }\n    options.push({\n      optionIndex: options.length + 1,\n      roleName: bucketForOption.roleName,\n      displayName: bucketForOption.displayName,\n      roleType: bucketForOption.roleType,\n      projectRoleId: bucketForOption.projectRoleId,\n      jobId: bucketForOption.jobId,\n      jobCode: bucketForOption.jobCode,\n      resourceElementId: bucketForOption.resourceElementId,\n      taskCount: bucketForOption.taskOptions.length,\n      taskSummary: bucketForOption.labels.join('; '),\n      taskOptionsJson: JSON.stringify(bucketForOption.taskOptions)\n    });\n  }\n  for (i = 0; i < options.length; i += 1) {\n    options[i].optionIndex = i + 1;\n    lines.push(String(options[i].optionIndex) + '. ' + trimString(options[i].displayName || options[i].roleName) + (options[i].taskSummary ? ' (' + options[i].taskSummary + ')' : ''));\n  }\n  result = {\n    response: 'Select the role/job you want to replace:' + String.fromCharCode(10) + lines.join(String.fromCharCode(10)),\n    intentStart: 'Y',\n    intentEnd: 'N',\n    nextStage: 'ROLE_SELECTION',\n    roleOptionsJson: JSON.stringify(options),\n    taskOptionsJson: '[]',\n    taskCount: 0,\n    roleCount: options.length\n  };\n}\n\nif (!isRoleIntent && result && String(result.response || '').indexOf('I could not find role/job ') === 0 && guidedResult) {\n  return guidedResult;\n}\nreturn result;"
