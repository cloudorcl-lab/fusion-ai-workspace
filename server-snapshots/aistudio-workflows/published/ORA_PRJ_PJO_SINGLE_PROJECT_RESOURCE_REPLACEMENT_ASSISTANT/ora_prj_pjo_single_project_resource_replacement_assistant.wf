            "name": "Format Commit Response",
            "returnType": "object",
            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\n\nfunction parseMaybe(value) {\n  var current = value;\n  var depth = 0;\n  while (typeof current === 'string' && trimString(current) !== '' && depth < 6) {\n    try {\n      current = JSON.parse(current);\n      depth += 1;\n    } catch (ignore1) {\n      break;\n    }\n  }\n  return current;\n}\n\nfunction extractItems(value) {\n  var current = parseMaybe(value);\n  var depth = 0;\n  while (current && depth < 6) {\n    if (Array.isArray(current)) {\n      return current;\n    }\n    if (Array.isArray(current.items)) {\n      return current.items;\n    }\n    if (current.output !== undefined) {\n      current = parseMaybe(current.output);\n      depth += 1;\n      continue;\n    }\n    if (current.result !== undefined) {\n      current = parseMaybe(current.result);\n      depth += 1;\n      continue;\n    }\n    break;\n  }\n  return [];\n}\n\nfunction parsePendingItems(raw) {\n  var items = [];\n  try {\n    items = JSON.parse(decodeURIComponent(raw || '[]'));\n  } catch (ignore1) {\n    try {\n      items = JSON.parse(raw || '[]');\n    } catch (ignore2) {\n      items = [];\n    }\n  }\n  return Array.isArray(items) ? items : [];\n}\n\nfunction toNumberWord(value) {\n  var words = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];\n  return value >= 1 && value <= 10 ? words[value] : String(value);\n}\n\nfunction formatLongDate(rawValue) {\n  var raw = trimString(rawValue);\n  var match = raw.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);\n  var names = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];\n  if (!match) {\n    return raw;\n  }\n  return names[Number(match[2]) - 1] + ' ' + String(Number(match[3])) + ', ' + match[1];\n}\n\nvar effectiveState = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_EFFECTIVE_STATE_V2.$output.result || {};\nvar variables = $context.$variables || {};\nvar context = (($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_POST_COMMIT_BUDGET_CONTEXT_V3 || {}).$output || {}).result || {};\nvar planItems = extractItems((($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_POST_COMMIT_GET_CURRENT_PLAN_V1 || {}).$output) || {});\nvar projectName = trimString(context.projectName || variables.PendingProjectName || effectiveState.PendingProjectName || variables.ProjectName || effectiveState.ProjectName || '');\nvar oldResourceName = trimString(context.oldResourceName || variables.PendingOldResourceName || effectiveState.PendingOldResourceName || 'requested assignments');\nvar newResourceName = trimString(context.newResourceName || variables.PendingNewResourceName || effectiveState.PendingNewResourceName || '');\nvar effectiveDate = trimString(context.unavailabilityDate || variables.PendingUnavailabilityDate || effectiveState.PendingUnavailabilityDate || '');\nvar pendingItemsJson = trimString(context.pendingItemsJson || variables.PendingReplacementItemsJson || effectiveState.PendingReplacementItemsJson || '[]');\nvar pendingItems = parsePendingItems(pendingItemsJson);\nvar count = pendingItems.length || Number(context.updatedAssignments || 0);\nvar countText = toNumberWord(count);\nvar noun = count === 1 ? 'assignment was' : 'assignments were';\nvar response = 'Replacement completed successfully. ' + oldResourceName + ' has been replaced with ' + newResourceName + ' across the impacted ' + projectName + ' assignments effective ' + formatLongDate(effectiveDate) + '. ' + countText + ' ' + noun + ' updated.';\nvar hasCurrentWorkingPlan = planItems.length > 0;\n\nif (hasCurrentWorkingPlan) {\n  response += '\\n\\nWould you like me to update the budget for ' + projectName + '?';\n  return {\n    response: response,\n    intentStart: 'Y',\n    intentEnd: 'N',\n    pendingAction: 'BUDGET_FOLLOWUP_CONFIRM',\n    pendingItemsJson: pendingItemsJson || '[]',\n    pendingProjectName: projectName,\n    pendingOldResourceName: oldResourceName,\n    pendingNewResourceName: newResourceName,\n    pendingUnavailabilityDate: effectiveDate,\n    nextStage: 'BUDGET_FOLLOWUP_CONFIRM'\n  };\n}\n\nreturn {\n  response: response,\n  intentStart: 'N',\n  intentEnd: 'Y',\n  pendingAction: '',\n  pendingItemsJson: '[]',\n  pendingProjectName: '',\n  pendingOldResourceName: '',\n  pendingNewResourceName: '',\n  pendingUnavailabilityDate: '',\n  nextStage: ''\n};\n"
