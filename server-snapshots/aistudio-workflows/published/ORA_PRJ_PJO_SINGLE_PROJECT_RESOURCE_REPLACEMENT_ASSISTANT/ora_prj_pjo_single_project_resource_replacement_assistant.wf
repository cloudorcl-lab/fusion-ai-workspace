          "metadata": {
            "errorNodeId": "1781000000199",
            "name": "Parse Task Selection",
            "returnType": "object",
            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\n\nfunction parseArray(value) {\n  if (Array.isArray(value)) {\n    return value;\n  }\n  if (typeof value === 'string' && trimString(value)) {\n    try {\n      value = JSON.parse(value);\n      return Array.isArray(value) ? value : [];\n    } catch (ignore1) {}\n  }\n  return [];\n}\n\nfunction normalize(value) {\n  return trimString(value).toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();\n}\n\nfunction normalizeKey(value) {\n  return normalize(value).replace(/\\s+/g, '');\n}\n\nfunction allSelectionRequested(message) {\n  var text = normalize(message);\n  return text === 'all' ||\n    text === 'yes' ||\n    text === 'y' ||\n    text === 'proceed' ||\n    text === 'go ahead' ||\n    text === 'ok' ||\n    text === 'okay' ||\n    text === 'sure' ||\n    text === 'confirm' ||\n    text === 'confirmed' ||\n    text === 'replace all' ||\n    text === 'all assignments' ||\n    text === 'all tasks' ||\n    text === 'all impacted assignments' ||\n    text === 'across all impacted assignments' ||\n    text === 'across the project' ||\n    text === 'across project' ||\n    text.indexOf('all impacted assignment') > -1 ||\n    text.indexOf('across all') > -1;\n}\n\nfunction wordNumber(value) {\n  var map = {\n    one: '1', first: '1',\n    two: '2', second: '2',\n    three: '3', third: '3',\n    four: '4', fourth: '4',\n    five: '5', fifth: '5',\n    six: '6', sixth: '6',\n    seven: '7', seventh: '7',\n    eight: '8', eighth: '8',\n    nine: '9', ninth: '9',\n    ten: '10', tenth: '10',\n    eleven: '11', eleventh: '11',\n    twelve: '12', twelfth: '12',\n    last: 'LAST', final: 'LAST'\n  };\n  return map[value] || value;\n}\n\nfunction rangeEndpoint(value, optionCount) {\n  var mapped = wordNumber(normalize(value));\n  var numberValue;\n  if (mapped === 'LAST') {\n    return optionCount > 0 ? optionCount : null;\n  }\n  if (!/^\\d+$/.test(mapped)) {\n    return null;\n  }\n  numberValue = Number(mapped);\n  return numberValue > 0 ? numberValue : null;\n}\n\nfunction pushRangeNumbers(rawMessage, explicitNumbers, optionCount) {\n  var text = trimString(rawMessage).toLowerCase();\n  var numericPattern = /\\b(\\d+)\\s*(?:-|to|through|thru)\\s*(\\d+)\\b/g;\n  var wordPattern = /\\b(first|one|second|two|third|three|fourth|four|fifth|five|sixth|six|seventh|seven|eighth|eight|ninth|nine|tenth|ten|eleventh|eleven|twelfth|twelve|last|final)\\s*(?:-|to|through|thru)\\s*(first|one|second|two|third|three|fourth|four|fifth|five|sixth|six|seventh|seven|eighth|eight|ninth|nine|tenth|ten|eleventh|eleven|twelfth|twelve|last|final)\\b/g;\n  var match;\n  var start;\n  var end;\n  var step;\n  var current;\n\n  while ((match = numericPattern.exec(text)) !== null) {\n    start = rangeEndpoint(match[1], optionCount);\n    end = rangeEndpoint(match[2], optionCount);\n    if (start === null || end === null) {\n      continue;\n    }\n    step = start <= end ? 1 : -1;\n    for (current = start; step > 0 ? current <= end : current >= end; current += step) {\n      explicitNumbers.push(String(current));\n    }\n  }\n\n  while ((match = wordPattern.exec(text)) !== null) {\n    start = rangeEndpoint(match[1], optionCount);\n    end = rangeEndpoint(match[2], optionCount);\n    if (start === null || end === null) {\n      continue;\n    }\n    step = start <= end ? 1 : -1;\n    for (current = start; step > 0 ? current <= end : current >= end; current += step) {\n      explicitNumbers.push(String(current));\n    }\n  }\n}\n\nfunction addSelected(selectedByKey, option, fallbackIndex) {\n  var key = trimString(option.taskId || option.planningElementId || option.optionIndex || ('idx_' + fallbackIndex));\n  selectedByKey[key] = option;\n}\n\nfunction optionMatchesText(option, text) {\n  var requestedKey = normalizeKey(text);\n  var taskName = normalize(option.taskName);\n  var taskNameKey = normalizeKey(option.taskName);\n  var taskNumber = normalize(option.taskNumber);\n  if (!requestedKey) {\n    return false;\n  }\n  if (requestedKey === normalizeKey(option.optionIndex) || requestedKey === normalizeKey(taskNumber) || requestedKey === taskNameKey) {\n    return true;\n  }\n  return taskNameKey && (taskNameKey.indexOf(requestedKey) > -1 || requestedKey.indexOf(taskNameKey) > -1 || taskName.indexOf(normalize(text)) > -1);\n}\n\nfunction finish(selected, selectionMode) {\n  return {\n    matched: selected.length > 0,\n    selectedTasks: selected,\n    selectedTasksJson: JSON.stringify(selected),\n    selectionMode: selectionMode || 'SPECIFIC',\n    response: selected.length ? '' : 'Reply with S. No., task names, task numbers, first/second, option ranges like 1-4, or all impacted assignments.',\n    intentStart: 'Y',\n    intentEnd: 'N'\n  };\n}\n\nvar state = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_EFFECTIVE_STATE_V2.$output.result || {};\nvar variables = $context.$variables || {};\nvar message = trimString(variables.EffectiveInputMessage || state.EffectiveInputMessage || '');\nvar options = parseArray(variables.TaskOptionsJson || state.TaskOptionsJson || []);\nvar text = normalize(message);\nvar tokens = [];\nvar selectedByKey = {};\nvar selected = [];\nvar exact = [];\nvar partial = [];\nvar explicitNumbers = [];\nvar i;\nvar j;\nvar option;\nvar token;\nvar optionIndex;\nvar taskNumber;\nvar taskName;\nvar phrase;\nvar key;\nvar numberValue;\n\nif (allSelectionRequested(message)) {\n  return finish(options, 'ALL');\n}\n\npushRangeNumbers(message, explicitNumbers, options.length);\ntokens = text.split(/[\\s,;]+/);\nfor (i = 0; i < tokens.length; i++) {\n  tokens[i] = wordNumber(tokens[i]);\n  if (/^\\d+$/.test(tokens[i])) {\n    explicitNumbers.push(tokens[i]);\n  } else if (tokens[i] === 'LAST' && options.length) {\n    explicitNumbers.push(String(options.length));\n  }\n}\n\nfor (i = 0; i < explicitNumbers.length; i++) {\n  numberValue = explicitNumbers[i];\n  for (j = 0; j < options.length; j++) {\n    option = options[j] || {};\n    if (numberValue === normalize(option.optionIndex) || numberValue === normalize(option.taskNumber)) {\n      addSelected(selectedByKey, option, j);\n    }\n  }\n}\n\nphrase = text\n  .replace(/\\bs\\s*no\\b/g, ' ')\n  .replace(/\\bserial\\s*no\\b/g, ' ')\n  .replace(/\\boption\\s*(?:number|no)?\\b/g, ' ')\n  .replace(/\\btask(?:s)?\\b/g, ' ')\n  .replace(/\\b(?:select|choose|only|specific|assignment|assignments|and|or|the|from|to|through|thru)\\b/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nif (phrase && !Object.keys(selectedByKey).length) {\n  for (i = 0; i < options.length; i++) {\n    option = options[i] || {};\n    if (optionMatchesText(option, phrase)) {\n      addSelected(selectedByKey, option, i);\n    }\n  }\n}\n\nif (!Object.keys(selectedByKey).length && tokens.length === 1 && tokens[0]) {\n  token = tokens[0];\n  for (i = 0; i < options.length; i++) {\n    option = options[i] || {};\n    optionIndex = normalize(option.optionIndex);\n    taskNumber = normalize(option.taskNumber);\n    taskName = normalize(option.taskName);\n    if (token === optionIndex || token === taskNumber || token === taskName) {\n      exact.push(option);\n    } else if (taskName && (taskName.indexOf(token) > -1 || token.indexOf(taskName) > -1)) {\n      partial.push(option);\n    }\n  }\n  selected = exact.length ? exact : partial;\n  return finish(selected, 'SPECIFIC');\n}\n\nif (!Object.keys(selectedByKey).length) {\n  for (i = 0; i < options.length; i++) {\n    option = options[i] || {};\n    optionIndex = normalize(option.optionIndex);\n    taskNumber = normalize(option.taskNumber);\n    taskName = normalize(option.taskName);\n    for (j = 0; j < tokens.length; j++) {\n      token = tokens[j];\n      if (!token || /^(s|no|serial|option|number|task|tasks|and|or|the|select|choose|only|specific|assignment|assignments|from|to|through|thru)$/.test(token)) {\n        continue;\n      }\n      if (token === optionIndex || token === taskNumber || (taskName && (taskName === token || taskName.indexOf(token) > -1))) {\n        addSelected(selectedByKey, option, i);\n      }\n    }\n  }\n}\n\nfor (key in selectedByKey) {\n  if (Object.prototype.hasOwnProperty.call(selectedByKey, key)) {\n    selected.push(selectedByKey[key]);\n  }\n}\nreturn finish(selected, 'SPECIFIC');\n"
          },
