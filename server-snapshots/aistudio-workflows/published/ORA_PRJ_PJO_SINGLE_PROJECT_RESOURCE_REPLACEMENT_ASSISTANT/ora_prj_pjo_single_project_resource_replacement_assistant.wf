            "returnType": "object",
            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\n\nfunction parseMaybe(value) {\n  var current = value;\n  var depth = 0;\n  while (typeof current === 'string' && trimString(current) !== '' && depth < 6) {\n    try {\n      current = JSON.parse(current);\n      depth += 1;\n    } catch (ignore1) {\n      break;\n    }\n  }\n  return current;\n}\n\nfunction getItems(container) {\n  var current = parseMaybe(container);\n  var depth = 0;\n  while (current !== null && current !== undefined && depth < 8) {\n    if (Array.isArray(current)) {\n      return current;\n    }\n    if (current && typeof current === 'object') {\n      if (Array.isArray(current.items)) {\n        return current.items;\n      }\n      if (current.output !== undefined) {\n        current = parseMaybe(current.output);\n        depth += 1;\n        continue;\n      }\n      if (current.result !== undefined) {\n        current = parseMaybe(current.result);\n        depth += 1;\n        continue;\n      }\n    }\n    break;\n  }\n  return [];\n}\n\nfunction normalizeKey(value) {\n  return trimString(value).toLowerCase().replace(/\\b(?:mr|mrs|ms|miss|dr)\\.?/g, ' ').replace(/[^a-z0-9]+/g, '');\n}\n\nfunction tokenize(value) {\n  var raw = trimString(value).toLowerCase().replace(/\\b(?:mr|mrs|ms|miss|dr)\\.?/g, ' ').replace(/[^a-z0-9]+/g, ' ').split(/\\s+/);\n  var out = [];\n  var seen = {};\n  var i;\n  var token;\n  for (i = 0; i < raw.length; i++) {\n    token = trimString(raw[i]);\n    if (!token || seen[token]) {\n      continue;\n    }\n    seen[token] = true;\n    out.push(token);\n  }\n  return out;\n}\n\nfunction scoreName(name, requestedTokens, requestedKey) {\n  var candidateKey = normalizeKey(name);\n  var score = 0;\n  var i;\n  if (!candidateKey) {\n    return 0;\n  }\n  if (requestedKey && candidateKey === requestedKey) {\n    return 100;\n  }\n  if (requestedKey && candidateKey.indexOf(requestedKey) > -1) {\n    score += 50;\n  }\n  if (requestedKey && requestedKey.indexOf(candidateKey) > -1) {\n    score += 25;\n  }\n  for (i = 0; i < requestedTokens.length; i++) {\n    if (candidateKey.indexOf(requestedTokens[i]) > -1) {\n      score += 10;\n    }\n  }\n  return score;\n}\n\nfunction selectedPlan(fetchPlanOutput, planVersionId, projectName) {\n  var plans = getItems(fetchPlanOutput);\n  var fallback = null;\n  var i;\n  var item;\n  for (i = 0; i < plans.length; i++) {\n    item = parseMaybe(plans[i]) || {};\n    if (planVersionId && trimString(item.PlanVersionId || '') === trimString(planVersionId)) {\n      return item;\n    }\n    if (!fallback && projectName && trimString(item.ProjectName || '') === trimString(projectName)) {\n      fallback = item;\n      if (trimString(item.PlanVersionStatus || '') === 'Current Working') {\n        return item;\n      }\n    }\n  }\n  return fallback || (plans.length ? (parseMaybe(plans[0]) || {}) : {});\n}\n\nfunction bestAssignmentName(raw, assignments) {\n  var requestedKey = normalizeKey(raw);\n  var requestedTokens = tokenize(raw);\n  var grouped = {};\n  var best = null;\n  var i;\n  var item;\n  var name;\n  var group;\n  if (!requestedKey) {\n    return '';\n  }\n  for (i = 0; i < assignments.length; i++) {\n    item = parseMaybe(assignments[i]) || {};\n    name = trimString(item.ResourceName || '');\n    if (!name) {\n      continue;\n    }\n    if (!grouped[name]) {\n      grouped[name] = {\n        name: name,\n        score: scoreName(name, requestedTokens, requestedKey),\n        count: 0\n      };\n    }\n    grouped[name].count += 1;\n  }\n  for (name in grouped) {\n    if (!grouped.hasOwnProperty(name)) {\n      continue;\n    }\n    group = grouped[name];\n    if (group.score <= 0) {\n      continue;\n    }\n    if (!best || group.score > best.score || (group.score === best.score && group.count > best.count) || (group.score === best.score && group.count === best.count && group.name.length > best.name.length)) {\n      best = group;\n    }\n  }\n  return best ? best.name : '';\n}\n\nfunction bestPrbsName(raw, prbsOutput) {\n  var requestedKey = normalizeKey(raw);\n  var requestedTokens = tokenize(raw);\n  var items = getItems(prbsOutput);\n  var best = null;\n  var i;\n  var j;\n  var elements;\n  var element;\n  var name;\n  var score;\n  var id;\n  if (!requestedKey) {\n    return '';\n  }\n  for (i = 0; i < items.length; i++) {\n    elements = getItems((items[i] || {}).Elements || []);\n    for (j = 0; j < elements.length; j++) {\n      element = elements[j] || {};\n      name = trimString(element.ResourceName || element.PersonName || element.ProjectRoleName || element.JobName || element.Name || '');\n      id = trimString(element.RbsElementId || element.ElementId || element.ElementIdentifier || element.ResourceElementId || '');\n      if (!name || !id || element.DisabledFlag === true || element.DisabledFlag === 'Y') {\n        continue;\n      }\n      score = scoreName(name, requestedTokens, requestedKey);\n      if (score <= 0) {\n        continue;\n      }\n      if (!best || score > best.score || (score === best.score && name.length > best.name.length)) {\n        best = { name: name, score: score };\n      }\n    }\n  }\n  return best ? best.name : '';\n}\n\nvar variables = $context.$variables || {};\nvar intent = trimString(variables.Intent || '');\nvar raw = trimString(variables.ResourceName || '');\nvar result = {\n  resourceName: raw,\n  matched: false\n};\nvar planContext;\nvar planItem;\nvar assignments;\nvar matchedName;\n\nif ((intent !== 'REPLACE_UNAVAILABLE_RESOURCE' && intent !== 'REPLACE_RESOURCE_ACROSS_ALL_PROJECTS') || !raw) {\n  return result;\n}\n\nplanContext = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_SELECT_PLAN.$output.result || {};\nplanItem = selectedPlan($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FETCH_PLAN.$output || {}, trimString(planContext.planVersionId || ''), trimString(variables.ProjectName || ''));\nassignments = getItems(planItem.ResourceAssignments || []);\nmatchedName = bestAssignmentName(raw, assignments);\nif (!matchedName) {\n  matchedName = bestPrbsName(raw, $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FETCH_MATCH_PRBS_RESOURCES.$output || {});\n}\nif (matchedName) {\n  result = {\n    resourceName: matchedName,\n    matched: normalizeKey(matchedName) !== normalizeKey(raw)\n  };\n}\nreturn result;"
