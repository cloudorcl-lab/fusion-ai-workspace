            "returnType": "object",
            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\n\nfunction parseArray(value) {\n  if (Array.isArray(value)) {\n    return value;\n  }\n  if (typeof value === 'string' && trimString(value)) {\n    try {\n      value = JSON.parse(value);\n      return Array.isArray(value) ? value : [];\n    } catch (ignore1) {}\n  }\n  return [];\n}\n\nfunction fallbackResult() {\n  return {\n    response: 'I could not prepare task options.',\n    intentStart: 'N',\n    intentEnd: 'Y',\n    nextStage: '',\n    roleOptionsJson: '[]',\n    taskOptionsJson: '[]',\n    taskCount: 0,\n    roleCount: 0\n  };\n}\n\nfunction pickResponse(nodeCode) {\n  var node = $context.$nodes[nodeCode];\n  if (node && node.$output && node.$output.result && node.$output.result.response !== undefined) {\n    return node.$output.result;\n  }\n  return null;\n}\n\nfunction tableCell(value) {\n  value = trimString(value);\n  return value ? value.replace(/\\|/g, '/') : 'N/A';\n}\n\nfunction formatEffort(value) {\n  var num;\n  value = trimString(value);\n  if (!value) {\n    return 'N/A';\n  }\n  num = Number(value);\n  if (isNaN(num)) {\n    return tableCell(value);\n  }\n  return Math.abs(num - Math.round(num)) < 0.005 ? String(Math.round(num)) : String(Math.round(num * 100) / 100);\n}\n\nfunction toIsoDate(rawValue) {\n  var raw = trimString(rawValue);\n  var parsedDate;\n  var match;\n  if (!raw) {\n    return '';\n  }\n  match = raw.match(/^(\\d{4})-(\\d{1,2})-(\\d{1,2})/);\n  if (match) {\n    return match[1] + '-' + ('0' + match[2]).slice(-2) + '-' + ('0' + match[3]).slice(-2);\n  }\n  match = raw.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})$/);\n  if (match) {\n    return match[3] + '-' + ('0' + match[1]).slice(-2) + '-' + ('0' + match[2]).slice(-2);\n  }\n  parsedDate = new Date(raw);\n  if (!isNaN(parsedDate.getTime())) {\n    return parsedDate.getUTCFullYear() + '-' + ('0' + (parsedDate.getUTCMonth() + 1)).slice(-2) + '-' + ('0' + parsedDate.getUTCDate()).slice(-2);\n  }\n  return '';\n}\n\nfunction formatShortDate(rawValue) {\n  var iso = toIsoDate(rawValue);\n  var parts = iso.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);\n  if (!parts) {\n    return tableCell(rawValue);\n  }\n  return parts[2] + '/' + parts[3] + '/' + parts[1];\n}\n\nfunction formatLongDate(rawValue) {\n  var iso = toIsoDate(rawValue);\n  var parts = iso.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);\n  var names = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];\n  if (!parts) {\n    return trimString(rawValue);\n  }\n  return names[Number(parts[2]) - 1] + ' ' + String(Number(parts[3])) + ', ' + parts[1];\n}\n\nfunction buildAssignmentTable(projectName, options) {\n  var lines = [\n    '| S No. | Project | Summary Task | Planned Effort (Hours) | Remaining Effort (Hours) | Assignment Start Date | Assignment Finish Date |',\n    '| --- | --- | --- | --- | --- | --- | --- |'\n  ];\n  var i;\n  var item;\n  for (i = 0; i < options.length; i++) {\n    item = options[i] || {};\n    lines.push('| ' + tableCell(item.optionIndex || String(i + 1)) +\n      ' | ' + tableCell(item.projectName || projectName) +\n      ' | ' + tableCell(item.taskName || item.taskNumber || ('Task ' + String(i + 1))) +\n      ' | ' + formatEffort(item.plannedEffortHours) +\n      ' | ' + formatEffort(item.remainingEffortHours) +\n      ' | ' + formatShortDate(item.planningStartDate) +\n      ' | ' + formatShortDate(item.planningFinishDate) + ' |');\n  }\n  return lines.join('\\n');\n}\n\nfunction formatImpactedAssignments(chosen, currentResource, replacementResource, projectName, effectiveDate) {\n  var options = parseArray(chosen.taskOptionsJson || []);\n  var count = options.length;\n  var noun = count === 1 ? 'assignment' : 'assignments';\n  var formattedDate = formatLongDate(effectiveDate);\n  var response;\n  if (!count || !effectiveDate) {\n    return chosen;\n  }\n  response = currentResource + ' currently has ' + String(count) + ' ' + noun + ' in ' + projectName + ' that are impacted by this replacement effective ' + formattedDate + '. These assignments were identified based on the effective date and include active assignments that continue on or after that date. Assignments that have already ended or belong to closed projects are not included. For assignments already in progress, the remaining effort will be reassigned from the effective date onward, and any existing effort adjustments will be preserved.';\n  response += '\\n\\nImpacted Assignments\\n\\n' + buildAssignmentTable(projectName, options);\n  response += '\\n\\nWould you like to proceed with the replacement across all impacted assignments in ' + projectName + ', or only specific task assignments? Reply yes/all for all, or reply with S. No., first/second, a range like 1-4, task number, or task name for specific assignments.';\n  chosen.response = response;\n  chosen.taskOptionsJson = JSON.stringify(options);\n  chosen.taskCount = count;\n  chosen.nextStage = 'TASK_SELECTION';\n  return chosen;\n}\n\nvar state = ($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_EFFECTIVE_STATE_V2.$output || {}).result || {};\nvar req = ($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_RESOLVE_REQUEST_V5.$output || {}).result || {};\nvar resolved = ($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_RESOLVE_DIRECT_TIMING_OVERRIDE_V1.$output || {}).result || {};\nvar currentResource = trimString(resolved.resourceName || req.resourceName || $context.$variables.ResourceName || (($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_RESOLVE_RESOURCE_ALIAS.$output || {}).result || {}).resourceName || 'the requested resource');\nvar replacementResource = trimString(resolved.replacementResourceName || req.replacementResourceName || $context.$variables.ReplacementResourceName || state.ReplacementResourceName || '');\nvar projectName = trimString(resolved.projectName || req.projectName || $context.$variables.ProjectName || state.ProjectName || 'the selected project');\nvar effectiveDate = trimString(resolved.unavailabilityDate || req.unavailabilityDate || $context.$variables.UnavailabilityDate || state.UnavailabilityDate || '');\nvar roleNode = pickResponse('PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FORMAT_ROLE_OPTIONS_V2');\nvar guidedNode = pickResponse('PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FORMAT_GUIDED_RESOURCE_TASK_OPTIONS_V3');\nvar chosen = null;\nvar roleChosen = false;\n\nif (roleNode) {\n  chosen = roleNode;\n  roleChosen = true;\n} else if (guidedNode) {\n  chosen = guidedNode;\n}\nif (!chosen) {\n  chosen = fallbackResult();\n}\nif (!roleChosen && typeof chosen.response === 'string' && chosen.response.indexOf('I could not find any roles or jobs with task assignments in ') === 0) {\n  chosen = {\n    response: 'I could not find tasks for ' + currentResource + ' in ' + projectName + '.',\n    intentStart: 'N',\n    intentEnd: 'Y',\n    nextStage: '',\n    roleOptionsJson: '[]',\n    taskOptionsJson: '[]',\n    taskCount: 0,\n    roleCount: 0\n  };\n}\nif (!roleChosen && Number(chosen.taskCount || 0) > 0) {\n  chosen = formatImpactedAssignments(chosen, currentResource, replacementResource, projectName, effectiveDate);\n}\nreturn chosen;\n"
          },
