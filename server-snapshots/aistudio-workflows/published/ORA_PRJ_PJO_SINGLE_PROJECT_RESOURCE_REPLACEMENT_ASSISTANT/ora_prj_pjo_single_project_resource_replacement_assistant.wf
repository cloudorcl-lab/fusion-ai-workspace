            "name": "Build Guided Proposal",
            "returnType": "object",
            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\n\nfunction parseArray(value) {\n  if (Array.isArray(value)) {\n    return value;\n  }\n  if (typeof value === 'string' && trimString(value)) {\n    try {\n      value = JSON.parse(value);\n      return Array.isArray(value) ? value : [];\n    } catch (ignore1) {}\n  }\n  return [];\n}\n\nfunction parseObject(value) {\n  if (value && typeof value === 'object' && !Array.isArray(value)) {\n    return value;\n  }\n  if (typeof value === 'string' && trimString(value)) {\n    try {\n      value = JSON.parse(value);\n      return value && typeof value === 'object' && !Array.isArray(value) ? value : {};\n    } catch (ignore1) {}\n  }\n  return {};\n}\n\nfunction normalizeKey(value) {\n  return trimString(value).toLowerCase().replace(/\\b(?:mr|mrs|ms|miss|dr)\\.?\\b/g, ' ').replace(/[^a-z0-9]+/g, '');\n}\n\nfunction findReplacementByName(rawReplacementName, currentResourceName) {\n  var requestedKey = normalizeKey(rawReplacementName);\n  var currentKey = normalizeKey(currentResourceName);\n  var prbsOutput = ($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FETCH_MATCH_PRBS_RESOURCES || {}).$output || {};\n  var prbsItems = prbsOutput.items || [];\n  var best = null;\n  var bestScore = 0;\n  var tied = false;\n  var i;\n  var j;\n  var elements;\n  var element;\n  var candidateName;\n  var candidateId;\n  var candidateKey;\n  var score;\n  if (!requestedKey) {\n    return {};\n  }\n  for (i = 0; i < prbsItems.length; i++) {\n    elements = prbsItems[i] && prbsItems[i].Elements && prbsItems[i].Elements.items ? prbsItems[i].Elements.items : [];\n    for (j = 0; j < elements.length; j++) {\n      element = elements[j] || {};\n      candidateName = trimString(element.ResourceName || element.PersonName || element.PersonEmail || element.Name || '');\n      candidateId = trimString(element.RbsElementId || element.ElementId || element.ElementIdentifier || element.ResourceElementId || '');\n      candidateKey = normalizeKey(candidateName);\n      if (!candidateName || !candidateId || !candidateKey || candidateKey === currentKey || element.DisabledFlag === true || element.DisabledFlag === 'Y') {\n        continue;\n      }\n      score = candidateKey === requestedKey ? 100 : ((candidateKey.indexOf(requestedKey) > -1 || requestedKey.indexOf(candidateKey) > -1) ? 50 : 0);\n      if (score > bestScore) {\n        bestScore = score;\n        best = { resourceName: candidateName, resourceElementId: candidateId };\n        tied = false;\n      } else if (score && score === bestScore && best && normalizeKey(best.resourceName) !== candidateKey) {\n        tied = true;\n      }\n    }\n  }\n  return best && !tied ? best : {};\n}\n\nvar effectiveState = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_EFFECTIVE_STATE_V2.$output.result || {};\nvar variables = $context.$variables || {};\nvar taskSelectionNode = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_PARSE_TASK_SELECTION_V2;\nvar directPickNode = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_RESOLVE_DIRECT_REPLACEMENT_PICK_V2;\nvar parsedTaskSelection = taskSelectionNode && taskSelectionNode.$output && taskSelectionNode.$output.result ? taskSelectionNode.$output.result : {};\nvar directPick = directPickNode && directPickNode.$output && directPickNode.$output.result ? directPickNode.$output.result : {};\nvar selectedTasks = [];\nvar storedTasks = variables.SelectedTaskAssignmentsJson || effectiveState.SelectedTaskAssignmentsJson;\nvar storedRecommendation = variables.SelectedRecommendationJson || effectiveState.SelectedRecommendationJson;\nvar pick = {};\nvar items = [];\nvar i;\nvar task;\nvar payload;\nvar replacementStage = trimString(variables.ReplacementStage || effectiveState.ReplacementStage || '');\nvar unavailabilityDate = trimString(variables.UnavailabilityDate || effectiveState.UnavailabilityDate || '');\nvar currentResourceName = trimString((variables.Intent || effectiveState.Intent || '') === 'REPLACE_ROLE_WITH_NAMED_PERSON' ? (variables.RoleName || effectiveState.RoleName || '') : (variables.ResourceName || effectiveState.ResourceName || ''));\nvar rawReplacementName = trimString(variables.ReplacementResourceName || effectiveState.ReplacementResourceName || '');\nvar projectName = trimString(variables.ProjectName || effectiveState.ProjectName || '');\nvar autoCommit = parsedTaskSelection.matched === true || replacementStage === 'AUTO_COMMIT_RECOMMENDATION';\n\nif (Array.isArray(parsedTaskSelection.selectedTasks) && parsedTaskSelection.selectedTasks.length) {\n  selectedTasks = parsedTaskSelection.selectedTasks;\n} else {\n  selectedTasks = parseArray(storedTasks);\n}\n\nif (directPick.matched === true && typeof directPick.pickJson === 'string' && directPick.pickJson !== '') {\n  pick = parseObject(directPick.pickJson);\n}\nif (!pick.resourceElementId) {\n  pick = parseObject(storedRecommendation);\n}\nif (!pick.resourceElementId) {\n  pick = findReplacementByName(rawReplacementName, currentResourceName);\n}\n\nif (!unavailabilityDate) {\n  return {\n    response: 'Please enter the effective start date for this replacement. I need the effective date to identify the impacted active assignments.',\n    intentStart: 'Y',\n    intentEnd: 'N',\n    pendingAction: '',\n    pendingItemsJson: '',\n    pendingProjectName: projectName,\n    pendingOldResourceName: currentResourceName,\n    pendingNewResourceName: trimString(pick.resourceName || rawReplacementName),\n    pendingUnavailabilityDate: '',\n    selectedRecommendationJson: pick.resourceElementId ? JSON.stringify(pick) : '',\n    nextStage: 'DIRECT_REPLACEMENT_DECISION',\n    autoCommit: false\n  };\n}\n\nif (!selectedTasks.length || !pick.resourceElementId) {\n  return {\n    response: 'I could not prepare the replacement proposal. Please select the tasks and replacement resource again.',\n    intentStart: 'N',\n    intentEnd: 'Y',\n    pendingAction: '',\n    pendingItemsJson: '',\n    pendingProjectName: '',\n    pendingOldResourceName: '',\n    pendingNewResourceName: '',\n    pendingUnavailabilityDate: '',\n    nextStage: '',\n    autoCommit: false\n  };\n}\n\nfor (i = 0; i < selectedTasks.length; i++) {\n  task = selectedTasks[i] || {};\n  payload = {\n    oldResourceElementId: trimString(task.oldResourceElementId || task.rbsElementId || ''),\n    newResourceElementId: trimString(pick.resourceElementId || ''),\n    oldResourceEndDate: unavailabilityDate,\n    taskId: trimString(task.taskId || '')\n  };\n  items.push({\n    PlanVersionId: trimString(task.planVersionId || $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_SELECT_PLAN.$output.result.planVersionId || ''),\n    Payload: JSON.stringify(payload),\n    TaskId: trimString(task.taskId || ''),\n    TaskNumber: trimString(task.taskNumber || ''),\n    TaskName: trimString(task.taskName || ''),\n    ProjectName: trimString(task.projectName || projectName),\n    PlannedEffortHours: task.plannedEffortHours,\n    RemainingEffortHours: task.remainingEffortHours,\n    PlanningStartDate: task.planningStartDate,\n    PlanningFinishDate: task.planningFinishDate\n  });\n}\n\nreturn {\n  response: autoCommit\n    ? 'Committing the replacement across the selected impacted assignments in ' + projectName + '.'\n    : 'Prepared ' + String(items.length) + ' replacement updates in ' + projectName + ' using ' + trimString(pick.resourceName || rawReplacementName) + '. Reply proceed to commit.',\n  intentStart: 'Y',\n  intentEnd: 'N',\n  pendingAction: 'COMMIT_REPLACEMENT',\n  pendingItemsJson: encodeURIComponent(JSON.stringify(items)),\n  pendingProjectName: projectName,\n  pendingOldResourceName: currentResourceName,\n  pendingNewResourceName: trimString(pick.resourceName || rawReplacementName),\n  pendingUnavailabilityDate: unavailabilityDate,\n  nextStage: '',\n  autoCommit: autoCommit\n};\n"
