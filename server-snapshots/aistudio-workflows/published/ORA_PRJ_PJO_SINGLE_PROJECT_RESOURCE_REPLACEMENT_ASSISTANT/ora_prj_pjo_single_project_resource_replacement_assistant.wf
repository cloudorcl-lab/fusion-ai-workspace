          "metadata": {
            "errorNodeId": "1781000000199",
            "name": "Select Working Plan",
            "returnType": "object",
            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\n\nfunction norm(value) {\n  return trimString(value).toLowerCase().replace(/[^a-z0-9]+/g, '');\n}\n\nfunction parseArray(value) {\n  if (Array.isArray(value)) {\n    return value;\n  }\n  if (typeof value === 'string' && trimString(value) !== '') {\n    try {\n      var parsed = JSON.parse(value);\n      return Array.isArray(parsed) ? parsed : [];\n    } catch (ignore) {}\n  }\n  return [];\n}\n\nvar items = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FETCH_PLAN.$output.items || [];\nvar effectiveState = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_EFFECTIVE_STATE_V2.$output.result || {};\nvar query = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_BUILD_PLAN_QUERY.$output.result || {};\nvar requested = trimString(query.requestedProjectName || $context.$variables.ProjectName || effectiveState.ProjectName || '');\nvar selectedTasks = parseArray($context.$variables.SelectedTaskAssignmentsJson || effectiveState.SelectedTaskAssignmentsJson || '[]');\nvar firstTask = selectedTasks.length ? (selectedTasks[0] || {}) : {};\nvar selected = null;\nvar i;\nvar item;\n\nif (requested) {\n  for (i = 0; i < items.length; i++) {\n    item = items[i] || {};\n    if (norm(item.ProjectName) === norm(requested) && String(item.PlanVersionStatus || '') === 'Current Working') {\n      selected = item;\n      break;\n    }\n  }\n  for (i = 0; !selected && i < items.length; i++) {\n    item = items[i] || {};\n    if (norm(item.ProjectName) === norm(requested)) {\n      selected = item;\n      break;\n    }\n  }\n}\n\nfor (i = 0; !selected && i < items.length; i++) {\n  item = items[i] || {};\n  if (item.PlanVersionStatus === 'Current Working') {\n    selected = item;\n    break;\n  }\n}\n\nif (!selected && items.length) {\n  selected = items[0];\n}\n\nif (selected) {\n  return {\n    planFound: true,\n    planVersionId: trimString(selected.PlanVersionId || ''),\n    projectId: selected.ProjectId,\n    projectName: trimString(selected.ProjectName || requested || ''),\n    projectNumber: trimString(selected.ProjectNumber || '')\n  };\n}\n\nif (trimString(firstTask.planVersionId || firstTask.PlanVersionId || '') && trimString(firstTask.projectId || firstTask.ProjectId || '')) {\n  return {\n    planFound: true,\n    planVersionId: trimString(firstTask.planVersionId || firstTask.PlanVersionId || ''),\n    projectId: trimString(firstTask.projectId || firstTask.ProjectId || ''),\n    projectName: requested,\n    projectNumber: trimString(firstTask.projectNumber || firstTask.ProjectNumber || requested || '')\n  };\n}\n\nreturn {\n  planFound: false,\n  planVersionId: '',\n  projectId: null,\n  projectName: '',\n  projectNumber: ''\n};"
          },
