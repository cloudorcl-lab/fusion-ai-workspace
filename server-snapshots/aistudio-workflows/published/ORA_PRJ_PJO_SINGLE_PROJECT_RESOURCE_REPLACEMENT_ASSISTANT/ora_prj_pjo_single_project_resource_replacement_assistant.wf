            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\n\nfunction clean(value) {\n  value = trimString(value);\n  return /^[^A-Za-z0-9]+$/.test(value) ? '' : value;\n}\n\nfunction pad2(value) {\n  value = parseInt(value, 10);\n  return (value < 10 ? '0' : '') + value;\n}\n\nfunction normalizeDate(rawValue) {\n  var raw = trimString(rawValue);\n  var months = {\n    jan: '01', january: '01',\n    feb: '02', february: '02',\n    mar: '03', march: '03',\n    apr: '04', april: '04',\n    may: '05',\n    jun: '06', june: '06',\n    jul: '07', july: '07',\n    aug: '08', august: '08',\n    sep: '09', sept: '09', september: '09',\n    oct: '10', october: '10',\n    nov: '11', november: '11',\n    dec: '12', december: '12'\n  };\n  var match;\n\n  raw = raw.replace(/,/g, ' ').replace(/(\\d+)(st|nd|rd|th)\\b/gi, '$1').replace(/\\s+/g, ' ').trim();\n  match = raw.match(/^(\\d{4})[-\\/](\\d{1,2})[-\\/](\\d{1,2})$/);\n  if (match) {\n    return match[1] + '-' + pad2(match[2]) + '-' + pad2(match[3]);\n  }\n  match = raw.match(/^(\\d{1,2})[-\\/](\\d{1,2})[-\\/](\\d{4})$/);\n  if (match) {\n    return match[3] + '-' + pad2(match[1]) + '-' + pad2(match[2]);\n  }\n  match = raw.toLowerCase().match(/^([a-z]+)\\s+(\\d{1,2})\\s+(\\d{4})$/);\n  if (match && months[match[1]]) {\n    return match[3] + '-' + months[match[1]] + '-' + pad2(match[2]);\n  }\n  match = raw.toLowerCase().match(/^(\\d{1,2})\\s+([a-z]+)\\s+(\\d{4})$/);\n  if (match && months[match[2]]) {\n    return match[3] + '-' + months[match[2]] + '-' + pad2(match[1]);\n  }\n  return '';\n}\n\nfunction extractInlineDate(value) {\n  var text = String(value || '');\n  var match =\n    text.match(/\\b\\d{4}[-\\/]\\d{1,2}[-\\/]\\d{1,2}\\b/) ||\n    text.match(/\\b\\d{1,2}[-\\/]\\d{1,2}[-\\/]\\d{4}\\b/) ||\n    text.match(/\\b[A-Za-z]+\\s+\\d{1,2}(?:st|nd|rd|th)?(?:,)?\\s+\\d{4}\\b/i) ||\n    text.match(/\\b\\d{1,2}\\s+[A-Za-z]+(?:,)?\\s+\\d{4}\\b/i);\n  return match ? trimS