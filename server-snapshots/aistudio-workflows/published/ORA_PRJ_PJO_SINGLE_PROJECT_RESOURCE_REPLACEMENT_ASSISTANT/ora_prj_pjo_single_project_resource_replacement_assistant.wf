            "name": "Format Plan Not Found",
            "returnType": "object",
            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\n\nfunction normalizeName(value) {\n  return trimString(value).toLowerCase().replace(/[^a-z0-9]/g, '');\n}\n\nfunction levenshtein(a, b) {\n  var m = a.length;\n  var n = b.length;\n  var dp = [];\n  var i;\n  var j;\n\n  for (i = 0; i <= m; i++) {\n    dp[i] = [i];\n  }\n  for (j = 1; j <= n; j++) {\n    dp[0][j] = j;\n  }\n  for (i = 1; i <= m; i++) {\n    for (j = 1; j <= n; j++) {\n      if (a.charAt(i - 1) === b.charAt(j - 1)) {\n        dp[i][j] = dp[i - 1][j - 1];\n      } else {\n        dp[i][j] = Math.min(dp[i - 1][j - 1], dp[i - 1][j], dp[i][j - 1]) + 1;\n      }\n    }\n  }\n  return dp[m][n];\n}\n\nvar requestedProject = trimString($context.$variables.ProjectName || '');\nvar raw = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FETCH_PROJECT_SUGGESTIONS.$output || {};\nvar items = raw.items || [];\nvar target = normalizeName(requestedProject);\nvar scored = [];\nvar seen = {};\nvar i;\n\nfor (i = 0; i < items.length; i++) {\n  var item = items[i] || {};\n  var projectName = trimString(item.ProjectName || '');\n  var projectNumber = trimString(item.ProjectNumber || '');\n  var key = projectName || projectNumber;\n  var normalized;\n  var score;\n\n  if (!projectName || seen[key]) {\n    continue;\n  }\n  seen[key] = true;\n  normalized = normalizeName(projectName);\n  if (!normalized) {\n    continue;\n  }\n\n  score = normalized === target ? 1000 : 0;\n  if (!score && target) {\n    if (normalized.indexOf(target) >= 0 || target.indexOf(normalized) >= 0) {\n      score = 700 - Math.abs(normalized.length - target.length);\n    } else {\n      score = 400 - levenshtein(normalized, target);\n    }\n  }\n\n  scored.push({\n    projectName: projectName,\n    projectNumber: projectNumber,\n    score: score\n  });\n}\n\nscored.sort(function(a, b) {\n  if (b.score !== a.score) {\n    return b.score - a.score;\n  }\n  return a.projectName < b.projectName ? -1 : (a.projectName > b.projectName ? 1 : 0);\n});\n\nvar matches = [];\nvar bestScore = scored.length ? scored[0].score : 0;\nfor (i = 0; i < scored.length && matches.length < 5; i++) {\n  if ((bestScore >= 396 && scored[i].score >= 396) || (bestScore < 396 && i < 3)) {\n    matches.push({\n      optionIndex: matches.length + 1,\n      projectName: scored[i].projectName,\n      projectNumber: scored[i].projectNumber\n    });\n  }\n}\n\nvar lines = [];\nfor (i = 0; i < matches.length; i++) {\n  lines.push(String(matches[i].optionIndex) + '. ' + matches[i].projectName + (matches[i].projectNumber ? ' (' + matches[i].projectNumber + ')' : ''));\n}\n\nreturn {\n  response: matches.length\n    ? 'Could not find the matching project name provided by you: ' + requestedProject + '.' + String.fromCharCode(10) + String.fromCharCode(10) + 'These project names closely match:' + String.fromCharCode(10) + lines.join(String.fromCharCode(10)) + String.fromCharCode(10) + String.fromCharCode(10) + 'Reply with one of the project names above and I will continue.'\n    : 'Could not find the matching project name provided by you: ' + requestedProject + '. Reply with the exact project name and I will continue.',\n  intentStart: 'Y',\n  intentEnd: 'N',\n  nextStage: 'PROJECT_SELECTION',\n  projectSuggestionsJson: JSON.stringify(matches),\n  pendingProjectName: '',\n  pendingOldResourceName: trimString($context.$variables.PendingOldResourceName || ''),\n  pendingNewResourceName: trimString($context.$variables.PendingNewResourceName || ''),\n  pendingUnavailabilityDate: trimString($context.$variables.PendingUnavailabilityDate || '')\n};"
