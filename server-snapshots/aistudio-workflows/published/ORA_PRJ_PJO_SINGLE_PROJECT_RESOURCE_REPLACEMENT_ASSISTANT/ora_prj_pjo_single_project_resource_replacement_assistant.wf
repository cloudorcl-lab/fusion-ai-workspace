            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\n\nfunction cleanField(value) {\n  var text = trimString(value).replace(/^[,;:.\\-\\s]+|[,;:.\\-\\s]+$/g, '').trim();\n  if (!text || /^[^A-Za-z0-9]+$/.test(text)) {\n    return '';\n  }\n  return text;\n}\n\nfunction normalizeLooseKey(value) {\n  return cleanField(value).toLowerCase().replace(/[^a-z0-9]+/g, '');\n}\n\nvar parsed = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_PARSE_REQUEST_V4.$output.result || {};\nvar state = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_EFFECTIVE_STATE_V2.$output.result || $context.$variables || {};\nvar message = String(state.EffectiveInputMessage || '').trim();\nvar lower = message.toLowerCase();\nvar intent = String(parsed.intent || 'OUT_OF_SCOPE');\nvar parsedProjectName = cleanField(parsed.projectName || null);\nvar parsedResourceName = cleanField(parsed.resourceName || null);\nvar parsedReplacementResourceName = cleanField(parsed.replacementResourceName || null);\nvar parsedRoleName = cleanField(parsed.roleName || null);\nvar parsedUnavailabilityDate = cleanField(parsed.unavailabilityDate || null);\nvar hasNamedSwap = !!(parsedResourceName && parsedReplacementResourceName);\nvar crossProjectSignal = /\\bacross\\s+all\\s+projects\\b|\\ball\\s+projects\\b/i.test(lower);\nvar allRolesSignal = /\\breplace\\s+all\\s+roles\\b/i.test(lower);\nvar genericRoleReplacementSignal = allRolesSignal || /\\breplace\\s+(?:a|the)?\\s*role\\b/i.test(lower) || /\\brole\\s+with\\s+named\\s+person\\b/i.test(lower) || (/\\bnamed\\s+person\\b/i.test(lower) && /\\brole\\b/i.test(lower));\nvar roleSignal = intent === 'REPLACE_ROLE_WITH_NAMED_PERSON' || intent === 'REPLACE_ALL_ROLES_WITH_NAMED_PERSONS' || lower.indexOf('replace role') === 0 || /\\brole\\b/i.test(lower);\nvar hasProjectHint = !!(parsedProjectName || /\\b(?:in|on)\\b\\s+[A-Za-z0-9_-]+/i.test(message));\nvar unavailableSignal = /\\b(terminated|termination|long\\s+leave|unavailable|backfill|replace\\s+(?:a\\s+)?terminated\\s+resource|replace\\s+(?:an\\s+)?unavailable\\s+resource)\\b/i.test(lower);\nvar activeUnavailableCollection =\n  state.INTENT_START === 'Y' &&\n  state.INTENT_END !== 'Y' &&\n  String(state.Intent || '') === 'REPLACE_UNAVAILABLE_RESOURCE' &&\n  !cleanField(state.ReplacementResourceName || '') &&\n  !/\\breplace\\s+.+\\s+with\\s+.+/i.test(message);\n\nif (allRolesSignal) {\n  intent = 'REPLACE_ALL_ROLES_WITH_NAMED_PERSONS';\n} else if (genericRoleReplacementSignal) {\n  intent = 'REPLACE_ROLE_WITH_NAMED_PERSON';\n} else if (unavailableSignal && !roleSignal) {\n  intent = 'REPLACE_UNAVAILABLE_RESOURCE';\n} else if (hasNamedSwap && !roleSignal && (crossProjectSignal || hasProjectHint)) {\n  intent = crossProjectSignal ? 'REPLACE_RESOURCE_ACROSS_ALL_PROJECTS' : 'REPLACE_UNAVAILABLE_RESOURCE';\n}\n\nif (crossProjectSignal && hasNamedSwap && !roleSignal) {\n  intent = 'REPLACE_RESOURCE_ACROSS_ALL_PROJECTS';\n}\n\nif (\n  state.INTENT_START === 'Y' &&\n  state.INTENT_END !== 'Y' &&\n  String(state.Intent || '') === 'REPLACE_ROLE_WITH_NAMED_PERSON' &&\n  intent === 'REPLACE_ROLE_WITH_NAMED_PERSON' &&\n  (!parsedRoleName || String(parsedRoleName).trim() === '') &&\n  String(state.ReplacementStage || '') === 'ROLE_SELECTION'\n) {\n  parsedRoleName = '';\n}\n\nif (\n  activeUnavailableCollection &&\n  !cleanField(state.ResourceName || '') &&\n  !parsedResourceName &&\n  parsedReplacementResourceName &&\n  !parsedUnavailabilityDate\n) {\n  parsedResourceName = parsedReplacementResourceName;\n  parsedReplacementResourceName = '';\n}\n\nif (parsedProjectName && parsedResourceName && !parsedReplacementResourceName && !parsedRoleName) {\n  var normalizedProjectKey = normalizeLooseKey(parsedProjectName);\n  var normalizedResourceKey = normalizeLooseKey(parsedResourceName);\n  if (normalizedProjectKey && normalizedResourceKey && normalizedProjectKey.indexOf(normalizedResourceKey) === 0) {\n    parsedResourceName = '';\