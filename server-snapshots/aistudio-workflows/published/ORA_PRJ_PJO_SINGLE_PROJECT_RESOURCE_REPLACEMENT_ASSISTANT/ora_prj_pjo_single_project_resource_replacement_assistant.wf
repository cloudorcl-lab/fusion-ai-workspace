            "sourceCode": "function trimString(value) { return String(value == null ? '' : value).trim(); } var req = ($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_RESOLVE_REQUEST_V5.$output || {}).result || {}; var state = ($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_EFFECTIVE_STATE_V2.$output || {}).result || {}; var alias = (($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_RESOLVE_RESOURCE_ALIAS || {}).$output || {}).result || {}; var intent = trimString(req.intent || $context.$variables.Intent || state.Intent || ''); var projectName = trimString(req.projectName || $context.$variables.ProjectName || ''); var roleName = trimString(req.roleName || $context.$variables.RoleName || ''); var rawResourceName = trimString(req.resourceName || $context.$variables.ResourceName || ''); var resolvedResourceName = trimString(alias.resourceName || rawResourceName); var replacementResourceName = trimString(req.replacementResourceName || $context.$variables.ReplacementResourceName || ''); var routeKey = intent; var message = ''; var oldResource = resolvedResourceName || rawResourceName; var directNamedSwap = intent === 'REPLACE_UNAVAILABLE_RESOURCE' && oldResource !== '' && replacementResourceName !== '' && roleName === ''; if (intent === 'REPLACE_ALL_ROLES_WITH_NAMED_PERSONS') { routeKey = 'REPLACE_ROLE_WITH_NAMED_PERSON_ROLE_SELECTION'; message = projectName ? ('List all roles or jobs in project ' + projectName) : ''; } else if (intent === 'REPLACE_ROLE_WITH_NAMED_PERSON' && roleName === '') { routeKey = 'REPLACE_ROLE_WITH_NAMED_PERSON_ROLE_SELECTION'; message = projectName ? ('List all roles or jobs in project ' + projectName) : ''; } else if (directNamedSwap) { routeKey = 'REPLACE_UNAVAILABLE_RESOURCE'; message = (projectName && resolvedResourceName) ? ('Get task details of ' + projectName + ' for resource ' + resolvedResourceName) : ''; oldResource = resolvedResourceName || rawResourceName; } else if (intent === 'REPLACE_UNAVAILABLE_RESOURCE') { routeKey = 'REPLACE_UNAVAILABLE_RESOURCE'; message = (projectName && resolvedResourceName) ? ('Get task details of ' + projectName + ' for resource ' + resolvedResourceName) : ''; oldResource = resolvedResourceName || rawResourceName; } return { routeKey: routeKey, message: message, projectName: projectName, oldResource: oldResource };"
