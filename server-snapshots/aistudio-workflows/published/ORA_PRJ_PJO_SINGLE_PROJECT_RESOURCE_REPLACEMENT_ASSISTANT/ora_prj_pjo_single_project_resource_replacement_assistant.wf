            "sourceCode": "function trimString(value) { return String(value == null ? '' : value).trim(); }\nfunction parsePendingItems(raw) {\n  var items = [];\n  try { items = JSON.parse(decodeURIComponent(raw || '[]')); }\n  catch (ignore1) {\n    try { items = JSON.parse(raw || '[]'); }\n    catch (ignore2) { items = []; }\n  }\n  return Array.isArray(items) ? items : [];\n}\nvar variables = $context.$variables || {};\nvar effectiveState = (($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_EFFECTIVE_STATE_V2 || {}).$output || {}).result || {};\nvar raw = String(variables.PendingReplacementItemsJson || effectiveState.PendingReplacementItemsJson || '[]');\nvar items = parsePendingItems(raw);\nvar first = items.length ? (items[0] || {}) : {};\nvar projectName = trimString(variables.PendingProjectName || effectiveState.PendingProjectName || variables.ProjectName || effectiveState.ProjectName || '');\nvar planVersionId = trimString(first.PlanVersionId || first.planVersionId || variables.PendingPlanVersionId || effectiveState.PendingPlanVersionId || '');\nreturn {\n  projectName: projectName,\n  planVersionId: planVersionId,\n  pendingItemsJson: raw,\n  message: 'Synchronize project budget for project ' + projectName + ' using financial project plan version ' + planVersionId\n};"
