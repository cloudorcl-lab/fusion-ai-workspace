            "name": "Build Plan Query",
            "returnType": "object",
            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\n\nfunction parseArray(value) {\n  if (Array.isArray(value)) {\n    return value;\n  }\n  if (typeof value === 'string' && trimString(value) !== '') {\n    try {\n      var parsed = JSON.parse(value);\n      return Array.isArray(parsed) ? parsed : [];\n    } catch (ignore) {}\n  }\n  return [];\n}\n\nfunction esc(value) {\n  return String(value || '').replace(/'/g, \"''\");\n}\n\nvar f = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_EFFECTIVE_STATE_V2.$output.result || {};\nvar requestedProject = trimString($context.$variables.ProjectName || f.ProjectName || '');\nvar selectedTasks = parseArray($context.$variables.SelectedTaskAssignmentsJson || f.SelectedTaskAssignmentsJson || '[]');\nvar firstTask = selectedTasks.length ? (selectedTasks[0] || {}) : {};\nvar filter = '';\n\nif (!requestedProject) {\n  requestedProject = trimString(firstTask.projectName || firstTask.ProjectName || '');\n}\n\nif (requestedProject && /[ -]/.test(requestedProject) && requestedProject.indexOf('_') === -1) {\n  filter = \"?q=ProjectName LIKE '%\" + esc(requestedProject) + \"%'&expand=PlanningOptions,ResourceAssignments,ResourceAssignments.PlanningAmounts&limit=100&onlyData=true\";\n} else if (requestedProject) {\n  filter = \"?q=ProjectName='\" + esc(requestedProject) + \"'&expand=PlanningOptions,ResourceAssignments,ResourceAssignments.PlanningAmounts&limit=25&onlyData=true\";\n} else {\n  filter = \"?expand=PlanningOptions,ResourceAssignments,ResourceAssignments.PlanningAmounts&limit=25&onlyData=true\";\n}\n\nreturn {\n  filterCriteria: filter,\n  requestedProjectName: requestedProject,\n  forwardedProjectId: trimString(firstTask.projectId || firstTask.ProjectId || ''),\n  forwardedPlanVersionId: trimString(firstTask.planVersionId || firstTask.PlanVersionId || '')\n};"
          },
