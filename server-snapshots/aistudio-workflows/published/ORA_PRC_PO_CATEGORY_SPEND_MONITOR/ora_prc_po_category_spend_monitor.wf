        {
          "metadata": {
            "name": "Build CSV Values for Mas Return",
            "returnType": "object",
            "sourceCode": "const rows = $context.$nodes.FORMAT_TOP_OUTLIERS_FOR_DISPLAY.$output.result.formattedRows;\nconst rowsInPool = rows.filter((row) => row.reqsInPoolFlag === \"Y\");\nconst reqLinesInPool = rowsInPool\n  .map((row) => ({\n    requisitionHeaderId: row.requisitionHeaderId,\n    requisitionLineId: row.requisitionLineId,\n    display: row.requisitionLineDisplay,\n    requesterName: row.requesterName,\n    requisitioningBU: row.requisitioningBUName\n  }))\n  .filter((row) => row.requisitionHeaderId != null && String(row.requisitionHeaderId).trim() !== \"\" && row.requisitionLineId != null && String(row.requisitionLineId).trim() !== \"\");\n\nreturn {\n  requisitionLineDisplaysInPoolCsv: rowsInPool.map((row) => row.requisitionLineDisplay).join(\", \"),\n  reqLinesInPoolJson: JSON.stringify(reqLinesInPool)\n};"
          },
