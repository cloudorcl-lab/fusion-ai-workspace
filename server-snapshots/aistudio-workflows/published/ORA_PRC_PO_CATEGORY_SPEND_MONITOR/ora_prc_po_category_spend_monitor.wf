   {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"CurrencyCode\": {\n            \"type\": \"string\"\n          },\n          \"Name\": {\n            \"type\": \"string\"\n          },\n          \"Description\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"EnabledFlag\": {\n            \"type\": \"string\"\n          },\n          \"StartDateActive\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\",\n                \"format\": \"date\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"EndDateActive\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\",\n                \"format\": \"date\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"IssuingTerritoryCode\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"Symbol\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"Precision\": {\n            \"anyOf\": [\n              {\n                \"type\": \"integer\",\n                \"format\": \"int32\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"ExtendedPrecision\": {\n            \"anyOf\": [\n              {\n                \"type\": \"integer\",\n                \"format\": \"int32\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"CurrencyFlag\": {\n            \"type\": \"string\"\n          }\n        },\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ]\n}",
