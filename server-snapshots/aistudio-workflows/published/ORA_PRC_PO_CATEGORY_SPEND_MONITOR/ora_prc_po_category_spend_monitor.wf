          "inputs": [
            {
              "id": "1778046099999_returnValue",
              "name": "returnValue",
              "type": "string",
              "value": "{\n  \"severity\": \"Medium\",\n  \"description\": \"Unusually high amounts for category\",\n  \"total\": 0,\n  \"riskCode\": \"highAmountForCategory\",\n  \"payload\": {\n    \"riskType\": \"highAmountForCategory\",\n    \"prcBUId\": {{$context.$variables.prcBUId}}\n  }\n}"
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "name": "Get Currencies Requiring Conversion",
            "returnType": "object",
            "sourceCode": "const rows = $context.$nodes.CLEAN_REQUISITION_LINES_FOR_OUTLIER_SCORE.$output.result.requisitionLines;\nconst target = $context.$variables.defaultPrcBUCurrency;\nconst currencySet = new Set();\n\nfor (const row of rows) {\n  if (row.currencyCode === target) continue;\n  if (row.functionalCurrencyCode === target) continue;\n\n  currencySet.add(row.currencyCode);\n}\n\nreturn Array.from(currencySet);"
          },
          "outcomes": {
            "success": "1776826006895"
          },
          "code": "GET_CURRENCIES_REQUIRING_CONVERSION",
          "id": "1776825705409",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Find Currency Conversions Needed"
          },
          "outcomes": {
            "success": "1778011370173"
          },
          "code": "FIND_CURRENCY_CONVERSIONS_NEEDED",
          "id": "1776826006895",
          "inputs": [
            {
              "id": "1776826006895_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": ""
            },
            {
              "id": "1776826006895_prompt",
              "name": "prompt",
              "type": "string",
              "value": "You are given a list of source currency codes in {{$context.$nodes.GET_CURRENCIES_REQUIRING_CONVERSION.$output.result}} and a target currency {{$context.$variables.defaultPrcBUCurrency}}.\nIf the list of source currency codes is empty, return an empty JSON object {}.\nOtherwise, return ONLY a valid JSON object map where each key is a source currency code and each value is the numeric conversion rate to the target currency.\nDo not include markdown, explanations, or extra text.\nExample: {\"CAD\":0.73,\"INR\":0.012}"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Determine Line Value Path",
            "returnType": "object",
            "sourceCode": "const rows = $context.$nodes.CLEAN_REQUISITION_LINES_FOR_OUTLIER_SCORE.$output.result.requisitionLines;\nconst targetCurrency = $context.$variables.defaultPrcBUCurrency;\nconst classifiedRows = [];\n\nfor (const row of rows) {\n  const isServiceLine = row.currencyAmount != null;\n\n  let valuePath = \"CONVERT_CURRENCY_VALUE\";\n  if (row.currencyCode === targetCurrency) valuePath = \"USE_CURRENCY_VALUE\";\n  else if (row.functionalCurrencyCode === targetCurrency) valuePath = \"USE_FUNCTIONAL_CURRENCY_VALUE\";\n\n  classifiedRows.push({\n    lineType: isServiceLine ? \"SERVICE\" : \"QUANTITY\",\n    valuePath,\n    targetCurrency,\n    quantity: row.quantity,\n    currencyUnitPrice: row.currencyUnitPrice,\n    price: row.Price,\n    currencyAmount: row.currencyAmount,\n    amount: row.amount,\n    requisitionLineId: row.requisitionLineId,\n    requisitionHeaderId: row.requisitionHeaderId,\n    categoryId: row.categoryId,\n    requisitionNumber: row.requisitionNumber,\n    lineNumber: row.lineNumber,\n    currencyCode: row.currencyCode,\n    functionalCurrencyCode: row.functionalCurrencyCode,\n    reqsInPoolFlag: row.reqsInPoolFlag,\n    requesterName: row.requesterName,\n    requisitioningBUName: row.requisitioningBUName,\n    itemCategoryName: row.itemCategoryName,\n    itemDescription: row.itemDescription,\n    buyerEmailAddr: row.buyerEmailAddr,\n    buyerName: row.buyerName\n  });\n}\n\nreturn {\n  classifiedRows,\n  total: classifiedRows.length\n};"
          },
          "outcomes": {
            "success": "1778011370174"
          },
          "code": "DETERMINE_LINE_VALUE_PATH",
          "id": "1778011370173",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Calculate Line Value In Target Currency",
            "returnType": "object",
            "sourceCode": "function parseConversionMap(rawOutput) {\n  const candidate = rawOutput?.result ?? rawOutput?.output ?? rawOutput;\n  if (candidate && typeof candidate === \"object\" && !Array.isArray(candidate)) return candidate;\n  if (typeof candidate !== \"string\") return {};\n\n  const text = candidate.trim();\n  if (text === \"\") return {};\n\n  try {\n    const parsed = JSON.parse(text);\n    return parsed && typeof parsed === \"object\" && !Array.isArray(parsed) ? parsed : {};\n  } catch (e) {\n    return {};\n  }\n}\n\nconst sourceRows = $context.$nodes.DETERMINE_LINE_VALUE_PATH.$output.result.classifiedRows;\nconst rows = Array.isArray(sourceRows) ? sourceRows : [];\nconst conversionMap = parseConversionMap($context.$nodes.FIND_CURRENCY_CONVERSIONS_NEEDED.$output);\nconst convertedRows = [];\n\nfor (const row of rows) {\n  let conversionRate = 1;\n\n  if (row.valuePath === \"CONVERT_CURRENCY_VALUE\") {\n    const rawRate = conversionMap[row.currencyCode];\n    conversionRate = typeof rawRate === \"number\" ? rawRate : Number(rawRate);\n\n    if (!Number.isFinite(conversionRate) || conversionRate <= 0) continue;\n  }\n\n  let reqLineAmount;\n\n  if (row.lineType === \"SERVICE\") {\n    const lineAmount = row.valuePath === \"USE_FUNCTIONAL_CURRENCY_VALUE\"\n      ? row.amount\n      : row.currencyAmount;\n\n    reqLineAmount = lineAmount * conversionRate;\n  } else {\n    const unitPrice = row.valuePath === \"USE_FUNCTIONAL_CURRENCY_VALUE\"\n      ? row.price\n      : row.currencyUnitPrice;\n\n    reqLineAmount = row.quantity * unitPrice * conversionRate;\n  }\n\n  convertedRows.push({\n    ...row,\n    reqLineAmount\n  });\n}\n\nreturn {\n  convertedRows,\n  total: convertedRows.length\n};"
          },
          "outcomes": {
            "success": "1777245492802"
          },
          "code": "CALCULATE_LINE_VALUE_IN_TARGET_CURRENCY",
          "id": "1778011370174",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Calculate Category IQR",
            "returnType": "object",
            "sourceCode": "function percentileInclusiveLinear(sortedValues, percentile) {\n  const items = Array.isArray(sortedValues) ? sortedValues : [];\n  const n = items.length;\n  if (n === 0) return null;\n  if (n === 1) return items[0];\n\n  const p = Math.min(Math.max(percentile, 0), 1);\n  const rank = (n - 1) * p;\n  const lowerIndex = Math.floor(rank);\n  const upperIndex = Math.ceil(rank);\n\n  if (lowerIndex === upperIndex) return items[lowerIndex];\n\n  const weight = rank - lowerIndex;\n  return items[lowerIndex] * (1 - weight) + items[upperIndex] * weight;\n}\n\nfunction calculateCategoryIqrStats(rows) {\n  const items = Array.isArray(rows) ? rows : [];\n  const byCategoryAmounts = {};\n\n  for (const row of items) {\n    const categoryId = String(row.categoryId);\n    const amount = row.reqLineAmount;\n\n    if (!byCategoryAmounts[categoryId]) {\n      byCategoryAmounts[categoryId] = [];\n    }\n    byCategoryAmounts[categoryId].push(amount);\n  }\n\n  const byCategory = {};\n\n  for (const categoryId of Object.keys(byCategoryAmounts)) {\n    const amounts = byCategoryAmounts[categoryId];\n    const categoryReqLineCount = amounts.length;\n\n    if (categoryReqLineCount < 10) {\n      continue;\n    }\n\n    const sortedAmounts = [...amounts].sort((a, b) => a - b);\n    const q1 = percentileInclusiveLinear(sortedAmounts, 0.25);\n    const q3 = percentileInclusiveLinear(sortedAmounts, 0.75);\n    const iqr = q3 - q1;\n    const upperOutlierThreshold = q3 + 1.5 * iqr;\n\n    if (!Number.isFinite(upperOutlierThreshold) || upperOutlierThreshold <= 0) {\n      continue;\n    }\n\n    byCategory[categoryId] = {\n      categoryReqLineCount,\n      q1,\n      q3,\n      iqr,\n      upperOutlierThreshold\n    };\n  }\n\n  return {\n    byCategory,\n    totalCategories: Object.keys(byCategory).length\n  };\n}\n\nconst result = calculateCategoryIqrStats(\n  $context.$nodes.CALCULATE_LINE_VALUE_IN_TARGET_CURRENCY.$output.result.convertedRows\n);\n\nreturn result;"
          },
          "outcomes": {
            "success": "1777245492803"
          },
          "code": "CALCULATE_CATEGORY_IQR",
          "id": "1777245492802",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Calculate Outlier Score",
            "returnType": "object",
            "sourceCode": "function calculateOutlierScore(rows, byCategory) {\n  const items = Array.isArray(rows) ? rows : [];\n  const categoryMap = byCategory && typeof byCategory === \"object\" ? byCategory : {};\n  const requisitionLinesWithOutlierScore = [];\n\n  for (const row of items) {\n    const categoryId = String(row.categoryId);\n    const categoryStats = categoryMap[categoryId];\n\n    if (!categoryStats) continue;\n\n    const upperOutlierThreshold = categoryStats.upperOutlierThreshold;\n\n    if (row.reqLineAmount <= upperOutlierThreshold) continue;\n\n    requisitionLinesWithOutlierScore.push({\n      ...row,\n      outlierScore: row.reqLineAmount / upperOutlierThreshold\n    });\n  }\n\n  return {\n    requisitionLinesWithOutlierScore,\n    total: requisitionLinesWithOutlierScore.length\n  };\n}\n\nconst result = calculateOutlierScore(\n  $context.$nodes.CALCULATE_LINE_VALUE_IN_TARGET_CURRENCY.$output.result.convertedRows,\n  $context.$nodes.CALCULATE_CATEGORY_IQR.$output.result.byCategory\n);\n\nreturn result;"
          },
          "outcomes": {
            "success": "1777245492804"
          },
          "code": "CALCULATE_OUTLIER_SCORE",
          "id": "1777245492803",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Select Final Top Outliers",
            "returnType": "object",
            "sourceCode": "function selectFinalTopOutliers(rows) {\n  const items = Array.isArray(rows) ? rows : [];\n  const winnersByCategory = {};\n  let sequence = 0;\n\n  for (const row of items) {\n    const categoryId = String(row.categoryId);\n    const outlierScore = row.outlierScore;\n    const reqLineAmount = row.reqLineAmount;\n    const existing = winnersByCategory[categoryId];\n\n    const candidate = {\n      ...row,\n      outlierScore,\n      reqLineAmount,\n      _sequence: sequence\n    };\n    sequence += 1;\n\n    if (!existing) {\n      winnersByCategory[categoryId] = candidate;\n      continue;\n    }\n\n    if (candidate.outlierScore > existing.outlierScore) {\n      winnersByCategory[categoryId] = candidate;\n      continue;\n    }\n\n    if (candidate.outlierScore === existing.outlierScore && candidate.reqLineAmount > existing.reqLineAmount) {\n      winnersByCategory[categoryId] = candidate;\n    }\n  }\n\n  const selectedReqLines = Object.values(winnersByCategory)\n    .sort((a, b) => {\n      if (b.outlierScore !== a.outlierScore) return b.outlierScore - a.outlierScore;\n      if (b.reqLineAmount !== a.reqLineAmount) return b.reqLineAmount - a.reqLineAmount;\n      return a._sequence - b._sequence;\n    })\n    .slice(0, 10)\n    .map((row) => {\n      const { _sequence, ...rest } = row;\n      return rest;\n    });\n\n  return {\n    selectedReqLines,\n    total: selectedReqLines.length\n  };\n}\n\nconst result = selectFinalTopOutliers(\n  $context.$nodes.CALCULATE_OUTLIER_SCORE.$output.result.requisitionLinesWithOutlierScore\n);\n\nreturn result;"
          },
          "outcomes": {
            "success": "1778046100001"
          },
          "code": "SELECT_FINAL_TOP_OUTLIERS",
