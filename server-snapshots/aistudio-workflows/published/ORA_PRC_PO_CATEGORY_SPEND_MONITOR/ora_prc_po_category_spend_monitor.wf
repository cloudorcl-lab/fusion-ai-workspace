        {
          "metadata": {
            "name": "Normalize Requisition Lines",
            "returnType": "object",
            "sourceCode": "function normalizeRequisitionLines(requisitions) {\n  const normalized = [];\n\n  for (const req of requisitions) {\n    const src = req._source;\n\n    normalized.push({\n      requisitionLineId: src.requisitionLineId ?? null,\n      requisitionHeaderId: src.requisitionHeaderId ?? null,\n      requesterName: src.requester?.name ?? null,\n      lineNumber: src.lineNumber ?? null,\n      categoryId: src.categoryId ?? null,\n      reqsInPoolFlag: src.reqsInPoolFlag ?? null,\n      currencyAmount: src.currencyAmount ?? null,\n      amount: src.amount ?? null,\n      quantity: src.quantity ?? null,\n      currencyUnitPrice: src.currencyUnitPrice ?? null,\n      Price: src.Price ?? null,\n      currencyCode: src.currencyCode ?? null,\n      functionalCurrencyCode: src.header?.functionalCurrencyCode ?? null,\n      requisitionNumber: src.requisitionNumber ?? src.header?.requisitionNumber ?? null,\n      requisitioningBUName: src.header?.requisitioningBU?.name ?? null,\n      itemCategoryName: src.itemCategory?.name ?? null,\n      itemDescription: src.itemDescription ?? null,\n      buyerEmailAddr: src.buyerEmail?.buyerEmailAddress?.buyerEmailAddr ?? null,\n      buyerName: src.buyer?.name ?? null\n    });\n  }\n\n  return {\n    requisitionLines: normalized,\n    total: normalized.length\n  };\n}\n\nconst result = normalizeRequisitionLines(\n  $context.$nodes.GET_REQUISITIONS_IN_LAST_30_DAYS.$output.hits.hits\n);\n\nreturn result;"
          },
          "outcomes": {
            "success": "1778046100000"
          },
          "code": "NORMALIZE_REQUISITION_LINES",
          "id": "1776881295412",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
