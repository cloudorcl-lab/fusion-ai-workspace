        {
          "metadata": {
            "name": "Format Top Outliers For Display",
            "returnType": "object",
            "sourceCode": "function isNullishOrEmpty(value) {\n  return value == null || (typeof value === \"string\" && value.trim() === \"\");\n}\n\nfunction sanitizeSeparator(value, fallback) {\n  if (typeof value !== \"string\") return fallback;\n  const text = value.trim();\n  return text !== \"\" ? text : fallback;\n}\n\nfunction resolveSingleLocalizedValue(value) {\n  if (value == null) return null;\n\n  if (typeof value === \"string\") {\n    const text = value.trim();\n    return text !== \"\" ? text : null;\n  }\n\n  if (typeof value === \"number\" || typeof value === \"boolean\") {\n    return String(value);\n  }\n\n  if (typeof value === \"object\") {\n    for (const key of Object.keys(value)) {\n      const localized = value[key];\n      if (localized == null) continue;\n\n      if (typeof localized === \"string\") {\n        const text = localized.trim();\n        if (text !== \"\") return text;\n        continue;\n      }\n\n      if (typeof localized === \"number\" || typeof localized === \"boolean\") {\n        return String(localized);\n      }\n    }\n  }\n\n  return null;\n}\n\nfunction toFiniteNumber(value) {\n  if (value == null || value === \"\") return null;\n  const n = typeof value === \"number\" ? value : Number(value);\n  return Number.isFinite(n) ? n : null;\n}\n\nfunction formatNumber(value, decimalSeparator, groupingSeparator, decimals) {\n  const n = toFiniteNumber(value);\n  if (n == null) return null;\n\n  const fixed = n.toFixed(decimals);\n  const negative = fixed.startsWith(\"-\");\n  const unsigned = negative ? fixed.slice(1) : fixed;\n\n  const parts = unsigned.split(\".\");\n  const integerPart = parts[0];\n  const fractionalPart = parts[1] ?? \"\";\n\n  const groupedInteger = integerPart.replace(/\\B(?=(\\d{3})+(?!\\d))/g, groupingSeparator);\n  const withDecimals = decimals > 0\n    ? `${groupedInteger}${decimalSeparator}${fractionalPart}`\n    : groupedInteger;\n\n  return negative ? `-${withDecimals}` : withDecimals;\n}\n\nfunction normalizeCurrencyCode(value) {\n  return String(value || \"\").trim().toUpperCase();\n}\n\nfunction toPrecision(value) {\n  const n = toFiniteNumber(value);\n  if (n == null || n < 0) return null;\n  return Math.trunc(n);\n}\n\nfunction buildCurrencyPrecisionMap(items) {\n  const map = {};\n  for (const item of Array.isArray(items) ? items : []) {\n    const currencyCode = normalizeCurrencyCode(item.CurrencyCode ?? item.currencyCode ?? item.Currency ?? item.currency);\n    const precision = toPrecision(item.Precision ?? item.precision ?? item.CurrencyPrecision ?? item.currencyPrecision);\n    if (currencyCode && precision != null) map[currencyCode] = precision;\n  }\n  return map;\n}\n\nfunction getCurrencyPrecision(currencyCode, currencyPrecisionMap, fallback) {\n  const precision = currencyPrecisionMap[normalizeCurrencyCode(currencyCode)];\n  return precision != null ? precision : fallback;\n}\n\nfunction formatAmountDisplay(amount, currencyCode, decimalSeparator, groupingSeparator, currencyPrecisionMap, fallbackPrecision) {\n  const currency = normalizeCurrencyCode(currencyCode);\n  if (!currency) return \"-\";\n\n  const precision = getCurrencyPrecision(currency, currencyPrecisionMap, fallbackPrecision);\n  const amountText = formatNumber(amount, decimalSeparator, groupingSeparator, precision);\n  if (amountText == null) return \"-\";\n  return amountText;\n}\n\nfunction formatTopOutliers(rows, prefs, currencyItems, defaultCurrency) {\n  const decimalSeparator = sanitizeSeparator(prefs?.DecimalSeparator, \".\");\n  const groupingSeparator = sanitizeSeparator(prefs?.GroupingSeparator, \",\");\n  const currencyPrecisionMap = buildCurrencyPrecisionMap(currencyItems);\n  const defaultCurrencyPrecision = 2;\n  const scoreDecimals = 2;\n\n  const items = Array.isArray(rows) ? rows : [];\n  const formattedRows = items.map((row) => {\n    const requesterName = resolveSingleLocalizedValue(row?.requesterName);\n    const requisitioningBUName = resolveSingleLocalizedValue(row?.requisitioningBUName);\n    const itemCategoryName = resolveSingleLocalizedValue(row?.itemCategoryName);\n    const itemDescription = resolveSingleLocalizedValue(row?.itemDescription);\n\n    const requisitionNumber = row?.requisitionNumber;\n    const lineNumber = row?.lineNumber;\n    const targetCurrency = defaultCurrency;\n    const approximateAmountDisplay = formatAmountDisplay(\n      row?.reqLineAmount,\n      targetCurrency,\n      decimalSeparator,\n      groupingSeparator,\n      currencyPrecisionMap,\n      defaultCurrencyPrecision\n    );\n    const outlierScoreText = formatNumber(row?.outlierScore, decimalSeparator, groupingSeparator, scoreDecimals);\n\n    const requisitionLineDisplay =\n      isNullishOrEmpty(requisitionNumber) || isNullishOrEmpty(lineNumber)\n        ? \"-\"\n        : `${String(requisitionNumber)} - ${String(lineNumber)}`;\n\n    return {\n      ...row,\n      requesterName,\n      requisitioningBUName,\n      itemCategoryName,\n      itemDescription,\n      requisitionLineDisplay,\n      approximateAmountDisplay,\n      outlierScoreDisplay: outlierScoreText ?? \"-\"\n    };\n  });\n\n  return {\n    formattedRows,\n    total: formattedRows.length,\n    formatting: {\n      decimalSeparator,\n      groupingSeparator,\n      currencyPrecisionSource: \"GET_CURRENCIES\",\n      defaultCurrencyPrecision,\n      scoreDecimals\n    }\n  };\n}\n\nconst result = formatTopOutliers(\n  $context.$nodes.SELECT_FINAL_TOP_OUTLIERS.$output.result.selectedReqLines,\n  $context.$nodes.GET_USER_SESSION_PREFERENCES.$output.items?.[0],\n  $context.$nodes.GET_CURRENCIES.$output.items,\n  $context.$variables.defaultPrcBUCurrency\n);\n\nreturn result;"
          },
          "outcomes": {
            "success": "1777336148774"
          },
          "code": "FORMAT_TOP_OUTLIERS_FOR_DISPLAY",
          "id": "1777336148747",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
