          "convergenceTargetId": "end",
          "id": "1778476302442",
          "inputs": [
            {
              "id": "1778476302442_condition",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.OraMessageHint === 'InitDisplay'}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Clean Requisition Lines For Outlier Score",
            "returnType": "object",
            "sourceCode": "function isBlank(value) {\n  return value == null || (typeof value === \"string\" && value.trim() === \"\");\n}\n\n//Counts how many rows were discarded for each reason.\nfunction addReason(summary, reason) {\n  summary[reason] = (summary[reason] ?? 0) + 1;\n}\n\nfunction getEligibility(row, targetCurrency) {\n  if (row.categoryId == null) {\n    return { keep: false, reason: \"MISSING_CATEGORY_ID\" };\n  }\n\n  if (isBlank(row.currencyCode)) {\n    return { keep: false, reason: \"MISSING_CURRENCY_CODE\" };\n  }\n\n  const isServiceLine = row.currencyAmount != null;\n  const useCurrencyValue = row.currencyCode === targetCurrency;\n  const useFunctionalCurrencyValue = row.functionalCurrencyCode === targetCurrency;\n\n  if (isServiceLine) {\n    if (useCurrencyValue || !useFunctionalCurrencyValue) {\n      return row.currencyAmount == null\n        ? { keep: false, reason: \"MISSING_SERVICE_CURRENCY_AMOUNT\" }\n        : { keep: true };\n    }\n\n    return row.amount == null\n      ? { keep: false, reason: \"MISSING_SERVICE_FUNCTIONAL_AMOUNT\" }\n      : { keep: true };\n  }\n\n  if (row.quantity == null) {\n    return { keep: false, reason: \"MISSING_QUANTITY\" };\n  }\n\n  if (useCurrencyValue || !useFunctionalCurrencyValue) {\n    return row.currencyUnitPrice == null\n      ? { keep: false, reason: \"MISSING_CURRENCY_UNIT_PRICE\" }\n      : { keep: true };\n  }\n\n  return row.Price == null\n    ? { keep: false, reason: \"MISSING_FUNCTIONAL_PRICE\" }\n    : { keep: true };\n}\n\nconst sourceRows = $context.$nodes.NORMALIZE_REQUISITION_LINES.$output.result.requisitionLines;\nconst rows = Array.isArray(sourceRows) ? sourceRows : [];\nconst targetCurrency = $context.$variables.defaultPrcBUCurrency;\nconst requisitionLines = [];\nconst discardedByReason = {};\n\nfor (const row of rows) {\n  const eligibility = getEligibility(row, targetCurrency);\n\n  if (eligibility.keep) {\n    requisitionLines.push(row);\n  } else {\n    addReason(discardedByReason, eligibility.reason);\n  }\n}\n\nreturn {\n  requisitionLines,\n  total: requisitionLines.length,\n  discardedTotal: rows.length - requisitionLines.length,\n  discardedByReason\n};"
          },
          "outcomes": {
            "success": "1776825705409"
          },
          "code": "CLEAN_REQUISITION_LINES_FOR_OUTLIER_SCORE",
          "id": "1778046100000",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
