          }
        },
        {
          "id": "1782155966776",
          "code": "FORMAT_CROSS_SELL_CHILD_PRODUCT_IDS",
          "type": "CODE",
          "metadata": {
            "name": "Format Cross Sell Child Product IDs",
            "returnType": "object",
            "sourceCode": "let result = \"\";\ntry {\n  const rawTargetProductId = $context.$variables?.targetProductId;\n  const targetProductId = rawTargetProductId === null || rawTargetProductId === undefined ? \"\" : String(rawTargetProductId).trim();\n  const ids = [];\n\n  if (targetProductId) {\n    ids.push(targetProductId);\n    if (targetProductId.toUpperCase().startsWith(\"FUSION_\")) {\n      ids.push(targetProductId.substring(\"FUSION_\".length));\n    }\n  }\n\n  const uniqueIds = Array.from(new Set(ids.filter(Boolean)));\n  result = uniqueIds.map(id => `'${String(id).replace(/'/g, \"''\")}'`).join(\",\");\n} catch (error) {\n  result = \"\";\n}\n\nreturn result;"
          },
          "diagram": {
            "x": 5458.133017492708,
            "y": 5792.53243440233
          },
          "outcomes": {
            "success": "1782156011189"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1782156011189",
          "code": "FETCH_CROSS_SELL_ACCOUNT_DATA",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Fetch Cross Sell Account Data",
            "errorNodeId": "1765177844910",
            "businessObjectCode": "ORA_CX_MARKETING_EXTRACTIONQUERIES",
            "functionName": "getCrossSellForChildProducts"
          },
          "diagram": {
            "x": 5535.94998666065,
            "y": 5929.640302886199
          },
          "outcomes": {
            "success": "1782156217266"
          },
          "inputs": [
            {
              "id": "1782156011189_pageOffset",
              "name": "pageOffset",
              "value": "0",
              "required": true
            },
            {
              "id": "1782156011189_pageLimit",
              "name": "pageLimit",
              "value": "10",
              "required": true,
              "type": "number"
            },
            {
              "id": "1782156011189_childProductIds",
              "name": "childProductIds",
              "value": "{{$context.$nodes.FORMAT_CROSS_SELL_CHILD_PRODUCT_IDS.$output.result}}",
              "required": true,
              "type": "number"
            }
          ]
        },
        {
          "id": "1782156217266",
          "code": "PREPARE_BUYING_GROUP_DISPLAY_DATA",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Buying Group Display Data",
            "returnType": "object",
            "sourceCode": "const buyingGroupOutput = $context.$nodes.FETCH_BUYING_GROUPS.$output;\nconst crossSellOutput = $context.$nodes.FETCH_CROSS_SELL_ACCOUNT_DATA.$output;\n\nconst parseIfJsonString = value => {\n  if (typeof value !== 'string') return value;\n  const trimmed = value.trim();\n  if (!trimmed) return value;\n  if (!trimmed.startsWith('{') && !trimmed.startsWith('[')) return value;\n  try {\n    return JSON.parse(trimmed);\n  } catch (error) {\n    return value;\n  }\n};\n\nconst getItems = output => {\n  const parsed = parseIfJsonString(output);\n  if (!parsed) return [];\n  if (Array.isArray(parsed)) return parsed;\n  if (Array.isArray(parsed.items)) return parsed.items;\n  if (Array.isArray(parsed.Items)) return parsed.Items;\n\n  const candidateKeys = ['result', 'data', 'body', 'payload', 'response', 'value'];\n  for (const key of candidateKeys) {\n    const child = parseIfJsonString(parsed[key]);\n    if (Array.isArray(child)) return child;\n    if (child && Array.isArray(child.items)) return child.items;\n    if (child && Array.isArray(child.Items)) return child.Items;\n  }\n\n  return [];\n};\n\nconst getValue = (record, names) => {\n  const parsedRecord = parseIfJsonString(record);\n  if (!parsedRecord || typeof parsedRecord !== 'object') return undefined;\n  for (const name of names) {\n    if (parsedRecord[name] !== undefined && parsedRecord[name] !== null) return parsedRecord[name];\n  }\n  const lowerCaseMap = Object.keys(parsedRecord).reduce((acc, key) => {\n    acc[key.toLowerCase()] = parsedRecord[key];\n    return acc;\n  }, {});\n  for (const name of names) {\n    const value = lowerCaseMap[name.toLowerCase()];\n    if (value !== undefined && value !== null) return value;\n  }\n  return undefined;\n};\n\nconst toNumber = value => {\n  if (value === null || value === undefined || value === '') return null;\n  if (typeof value === 'string') {\n    const normalized = value.replace(/,/g, '').trim();\n    if (!normalized) return null;\n    const numberValue = Number(normalized);\n    return Number.isFinite(numberValue) ? numberValue : null;\n  }\n  const numberValue = Number(value);\n  return Number.isFinite(numberValue) ? numberValue : null;\n};\n\nconst normalizeId = value => {\n  if (value === null || value === undefined) return '';\n  const normalized = String(value).trim();\n  return normalized.toUpperCase().startsWith('FUSION_') ? normalized.substring('FUSION_'.length) : normalized;\n};\n\nconst uniqueJoin = values => {\n  const seen = new Set();\n  const result = [];\n  values.forEach(value => {\n    if (value === null || value === undefined) return;\n    String(value).split(',').map(item => item.trim()).filter(Boolean).forEach(item => {\n      const key = item.toLowerCase();\n      if (!seen.has(key)) {\n        seen.add(key);\n        result.push(item);\n      }\n    });\n  });\n  return result.join(', ');\n};\n\nconst buyingGroupItems = getItems(buyingGroupOutput);\nconst crossSellItems = getItems(crossSellOutput);\nconst targetProductId = normalizeId($context.$variables?.targetProductId);\nconst targetProductName = ($context.$variables?.targetProductName || '').toString().trim().toLowerCase();\n\nconst crossSellRecord = crossSellItems.find(item => {\n  const rowProductId = normalizeId(getValue(item, ['targetProductId', 'TargetProductId', 'productId', 'ProductId', 'childProductId', 'ChildProductId']));\n  if (targetProductId && rowProductId && targetProductId === rowProductId) return true;\n  const rowProductName = (getValue(item, ['targetProductName', 'TargetProductName', 'productName', 'ProductName']) || '').toString().trim().toLowerCase();\n  return Boolean(targetProductName && rowProductName && targetProductName === rowProductName);\n}) || crossSellItems.find(item => toNumber(getValue(item, ['accounts', 'Accounts', 'accountCount', 'AccountCount'])) !== null);\n\nconst denominator = crossSellRecord\n  ? toNumber(getValue(crossSellRecord, ['accounts', 'Accounts', 'accountCount', 'AccountCount']))\n  : null;\n\nconst groups = new Map();\nbuyingGroupItems.forEach(item => {\n  const buyerRole = getValue(item, ['buyerRole', 'BuyerRole', 'buyerRoleName', 'BuyerRoleName', 'role', 'Role']);\n  if (buyerRole === undefined || buyerRole === null || String(buyerRole).trim() === '') return;\n  const roleName = String(buyerRole).trim();\n  if (!groups.has(roleName)) {\n    groups.set(roleName, { buyerRole: roleName, personas: [], accountCounts: [] });\n  }\n  const group = groups.get(roleName);\n  group.personas.push(getValue(item, ['personas', 'Personas', 'personaNames', 'PersonaNames', 'persona', 'Persona', 'personaName', 'PersonaName']));\n  const accountCount = toNumber(getValue(item, ['accountCount', 'AccountCount', 'accounts', 'Accounts']));\n  if (accountCount !== null) group.accountCounts.push(accountCount);\n});\n\nconst tableRows = Array.from(groups.values()).map(group => {\n  const numerator = group.accountCounts.length > 0 ? group.accountCounts[0] : null;\n  const hasValidMetrics = numerator !== null && denominator !== null && denominator > 0;\n  return {\n    'Buyer Role': group.buyerRole,\n    'Persona': uniqueJoin(group.personas),\n    '# of Accounts With Role': hasValidMetrics ? `${numerator}/${denominator}` : '',\n    'Percentage': hasValidMetrics ? `${Math.round((numerator / denominator) * 100)}%` : ''\n  };\n});\n\nreturn {\n  denominator,\n  denominatorSource: 'CROSS_SELL_ACCOUNTS_WORKFLOW.GET_CROSS_SELL_PRODUCTS.items.accounts',\n  crossSellRowsUsed: crossSellItems.length,\n  buyingGroupRowsUsed: buyingGroupItems.length,\n  columns: ['Buyer Role', 'Persona', '# of Accounts With Role', 'Percentage'],\n  rows: tableRows\n};"
          },
          "diagram": {
            "x": 5460.563637918265,
            "y": 6082.750237609432
          },
          "outcomes": {
