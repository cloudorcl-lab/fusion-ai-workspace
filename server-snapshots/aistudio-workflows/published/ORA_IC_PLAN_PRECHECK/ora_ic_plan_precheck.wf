        {
          "id": "17",
          "code": "PREPARE_FETCH_CANDIDATE",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Existing Plan Match",
            "returnType": "object",
            "sourceCode": "var inputPlan = $context.$variables.plan;\nvar preparedQueries = ($context.$nodes.PREPARE_EXISTENCE_QUERIES && $context.$nodes.PREPARE_EXISTENCE_QUERIES.$output)\n  ? $context.$nodes.PREPARE_EXISTENCE_QUERIES.$output.result\n  : new Object();\n\nvar parseMaybeJson = function(value) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n  if (typeof value !== 'string') {\n    return value;\n  }\n  try {\n    return JSON.parse(value);\n  } catch (_err) {\n    return null;\n  }\n};\n\nvar extractBoItems = function(nodeCode) {\n  var raw = $context.$nodes && $context.$nodes[nodeCode] ? $context.$nodes[nodeCode].$output : null;\n  var obj = parseMaybeJson(raw);\n  if (!obj || typeof obj !== 'object') {\n    return [];\n  }\n  if (obj.items && obj.items.length !== undefined) {\n    return obj.items;\n  }\n  if (obj.result && obj.result.items && obj.result.items.length !== undefined) {\n    return obj.result.items;\n  }\n  return [];\n};\n\nvar normalizeKey = function(value) {\n  if (value === null || value === undefined || String(value).trim().length === 0) {\n    return null;\n  }\n  return String(value).trim().toUpperCase();\n};\n\nvar normalizeDate = function(value) {\n  if (!value) {\n    return null;\n  }\n  var text = String(value).substring(0, 10);\n  var parsed = new Date(text + 'T00:00:00Z');\n  if (isNaN(parsed.getTime())) {\n    return null;\n  }\n  return parsed;\n};\n\nvar datesOverlap = function(startA, endA, startB, endB) {\n  if (!startA || !endA || !startB || !endB) {\n    return false;\n  }\n  return !(endA < startB || endB < startA);\n};\n\nvar plan = parseMaybeJson(inputPlan) || new Object();\nvar compensationPlan = plan && plan.compensationPlan ? plan.compensationPlan : new Object();\nvar planNameKey = normalizeKey(compensationPlan.planName || compensationPlan.name);\nvar planStart = normalizeDate(compensationPlan.effectiveStartDate);\nvar planEnd = normalizeDate(compensationPlan.effectiveEndDate);\nvar resolvedOrgId = preparedQueries && preparedQueries.orgId !== undefined && preparedQueries.orgId !== null && String(preparedQueries.orgId).trim() !== ''\n  ? Number(preparedQueries.orgId)\n  : null;\nif (resolvedOrgId !== null && isNaN(resolvedOrgId)) {\n  resolvedOrgId = null;\n}\n\nvar existingPlans = extractBoItems('QUERY_EXISTING_PLANS');\nvar candidates = [];\nvar i = 0;\nfor (i = 0; i < existingPlans.length; i += 1) {\n  var item = existingPlans[i] ? existingPlans[i] : new Object();\n  if (!planNameKey || normalizeKey(item.Name) !== planNameKey) {\n    continue;\n  }\n  if (resolvedOrgId !== null && item.OrgId !== undefined && item.OrgId !== null && Number(item.OrgId) !== resolvedOrgId) {\n    continue;\n  }\n  var existingStart = normalizeDate(item.StartDate);\n  var existingEnd = normalizeDate(item.EndDate);\n  if (planStart && planEnd && existingStart && existingEnd && !datesOverlap(planStart, planEnd, existingStart, existingEnd)) {\n    continue;\n  }\n  candidates.push({\n    planId: item.CompensationPlanId !== undefined && item.CompensationPlanId !== null ? Number(item.CompensationPlanId) : null,\n    name: item.Name ? String(item.Name) : null,\n    orgId: item.OrgId !== undefined && item.OrgId !== null ? Number(item.OrgId) : resolvedOrgId,\n    startDate: item.StartDate ? String(item.StartDate) : null,\n    endDate: item.EndDate ? String(item.EndDate) : null,\n    raw: item\n  });\n}\n\nvar result = new Object();\nresult.planName = compensationPlan.planName || compensationPlan.name || null;\nresult.planNameKey = planNameKey;\nresult.resolvedOrgId = resolvedOrgId;\nresult.candidateCount = candidates.length;\nresult.candidates = candidates;\nresult.shouldFetchExisting = candidates.length === 1 && candidates[0].planId !== null;\nresult.hasSingleConfidentMatch = result.shouldFetchExisting;\nresult.hasAmbiguousMatches = candidates.length > 1;\nresult.existingPlan = result.shouldFetchExisting ? {\n  planId: candidates[0].planId,\n  name: candidates[0].name,\n  orgId: candidates[0].orgId,\n  startDate: candidates[0].startDate,\n  endDate: candidates[0].endDate,\n  confidence: 'HIGH',\n  matchBasis: ['NAME', 'ORG', 'DATE_OVERLAP']\n} : null;\nreturn result;"
          },
          "outcomes": {
            "success": "18"
          },
          "inputs": [],
          "diagram": {
            "x": 5000,
            "y": 8960
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "18",
          "code": "RUN_PRECHECK",
          "type": "CODE",
          "metadata": {
            "name": "Run Precheck",
            "returnType": "object",
            "sourceCode": "// RUN_PRECHECK - Validate plan against org catalog before publish.\n\nvar inputPlan = $context.$variables.plan;\n\nvar parseMaybeJson = function(value) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n  if (typeof value !== 'string') {\n    return value;\n  }\n  try {\n    return JSON.parse(value);\n  } catch (_err) {\n    return null;\n  }\n};\n\nvar deepClone = function(value) {\n  if (value === null || value === undefined) {\n    return value;\n  }\n  return JSON.parse(JSON.stringify(value));\n};\n\nvar extractOrgCatalog = function(value) {\n  var obj = parseMaybeJson(value);\n  if (obj && obj.output !== undefined) {\n    var child = parseMaybeJson(obj.output);\n    if (child && child.result && child.result.catalog) {\n      return child.result.catalog;\n    }\n    if (child && child.catalog) {\n      return child.catalog;\n    }\n  }\n  if (obj && obj.result && obj.result.catalog) {\n    return obj.result.catalog;\n  }\n  if (obj && obj.catalog) {\n    return obj.catalog;\n  }\n  return obj && typeof obj === 'object' ? obj : new Object();\n};\n\ninputPlan = parseMaybeJson(inputPlan) || new Object();\nvar embeddedCatalog = inputPlan && inputPlan.metadata && typeof inputPlan.metadata === 'object'\n  ? inputPlan.metadata.orgCatalog\n  : null;\nvar inputCatalog = embeddedCatalog;\nif ((inputCatalog === null || inputCatalog === undefined) && $context.$nodes && $context.$nodes.CALL_ORG_CATALOG) {\n  inputCatalog = $context.$nodes.CALL_ORG_CATALOG.$output;\n}\ninputCatalog = extractOrgCatalog(inputCatalog);\n\nvar plan = (inputPlan && inputPlan.planComponents) ? inputPlan : new Object();\nvar catalog = (inputCatalog && typeof inputCatalog === 'object') ? inputCatalog : new Object();\n\nvar issues = [];\nvar warnings = [];\nvar appliedMutations = [];\nvar pendingExpressionNameMutations = [];\nvar pendingRateInputExpressionNameMutations = [];\nvar pendingRateDimensionNameMutations = [];\n\nvar buildRepairHint = function(code, context, entityRef) {\n  var ref = entityRef || new Object();\n  var targetKind = ref.entityType ? String(ref.entityType) : null;\n  var targetId = ref.entityId ? String(ref.entityId) : null;\n  var targetName = ref.entityName ? String(ref.entityName) : null;\n  var ctx = context || new Object();\n\n  var withTarget = function(hint) {\n    var out = hint || new Object();\n    if (!out.targetKind && targetKind) {\n      out.targetKind = targetKind;\n    }\n    if (targetId && (!out.targetKind || out.targetKind === targetKind)) {\n      out.targetId = targetId;\n    }\n    if (targetName && (!out.targetKind || out.targetKind === targetKind)) {\n      out.targetName = targetName;\n    }\n    return out;\n  };\n\n  if (code === 'PLAN_NAME_ALREADY_EXISTS') {\n    return withTarget({\n      mutationKind: 'UPDATE_PLAN_FIELD',\n      targetKind: 'plan',\n      field: 'planName',\n      currentValue: ctx.planName || targetName || null,\n      needs: 'newNameOrSuffix'\n    });\n  }\n  if (code === 'COMPONENT_NAME_ALREADY_EXISTS') {\n    return withTarget({\n      mutationKind: 'RENAME_ENTITY',\n      targetKind: 'component',\n      needs: 'newNameOrSuffix'\n    });\n  }\n  if (code === 'MEASURE_NAME_ALREADY_EXISTS') {\n    return withTarget({\n      mutationKind: 'RENAME_ENTITY',\n      targetKind: 'measure',\n      needs: 'newNameOrSuffix'\n    });\n  }\n  if (code === 'RATE_TABLE_NAME_ALREADY_EXISTS') {\n    return withTarget({\n      mutationKind: 'RENAME_ENTITY',\n      targetKind: targetKind === 'scorecard' ? 'scorecard' : 'rateTable',\n      needs: 'newNameOrSuffix'\n    });\n  }\n  if (code === 'RATE_DIMENSION_NAME_ALREADY_EXISTS') {\n    return withTarget({\n      mutationKind: 'RENAME_ENTITY',\n      targetKind: 'rateDimension',\n      targetName: ctx.rateDimensionName || ctx.dimensionName || null,\n      needs: 'newNameOrSuffix'\n    });\n  }\n\n  if (code === 'PLAN_START_DATE_REQUIRED') {\n    return withTarget({\n      mutationKind: 'UPDATE_PLAN_FIELD',\n      targetKind: 'plan',\n      field: 'effectiveStartDate',\n      needs: 'scalarValue'\n    });\n  }\n  if (code === 'PLAN_END_DATE_REQUIRED') {\n    return withTarget({\n      mutationKind: 'UPDATE_PLAN_FIELD',\n      targetKind: 'plan',\n      field: 'effectiveEndDate',\n      needs: 'scalarValue'\n    });\n  }\n  if (code === 'PLAN_DATES_INVALID' || code === 'PLAN_DATES_NOT_IN_DEFINED_PERIOD') {\n    return withTarget({\n      mutationKind: 'UPDATE_PLAN_FIELD',\n      targetKind: 'plan',\n      fields: ['effectiveStartDate', 'effectiveEndDate'],\n      needs: 'scalarValue'\n    });\n  }\n  if (code === 'COMPONENT_DATES_INVALID') {\n    return withTarget({\n      mutationKind: 'UPDATE_COMPONENT_FIELD',\n      targetKind: 'component',\n      fields: ['startDate', 'endDate'],\n      needs: 'scalarValue'\n    });\n  }\n  if (code === 'MEASURE_DATES_INVALID' || code === 'MEASURE_DATES_OUTSIDE_PARENT_RANGE') {\n    return withTarget({\n      mutationKind: 'UPDATE_MEASURE_FIELD',\n      targetKind: 'measure',\n      fields: ['startDate', 'endDate'],\n      needs: 'scalarValue'\n    });\n  }\n\n  if (code === 'UNKNOWN_CREDIT_CATEGORY') {\n    return withTarget({\n      mutationKind: 'UPDATE_MEASURE_FIELD',\n      targetKind: 'measure',\n      field: 'creditCategories',\n      currentValue: ctx.categoryName || null,\n      needs: 'supportedScalarValue'\n    });\n  }\n  if (code === 'INVALID_INCENTIVE_TYPE') {\n    return withTarget({\n      mutationKind: 'UPDATE_COMPONENT_FIELD',\n      targetKind: 'component',\n      field: 'incentiveType',\n      currentValue: ctx.incentiveType || null,\n      needs: 'supportedScalarValue'\n    });\n  }\n  if (code === 'INVALID_PROCESS_TRANSACTION') {\n    return withTarget({\n      mutationKind: 'UPDATE_MEASURE_FIELD',\n      targetKind: 'measure',\n      field: 'processTransaction',\n      currentValue: ctx.processTransaction || null,\n      needs: 'supportedScalarValue'\n    });\n  }\n  if (code === 'INVALID_PERFORMANCE_INTERVAL') {\n    return withTarget({\n      mutationKind: 'UPDATE_MEASURE_FIELD',\n      targetKind: 'measure',\n      field: 'performanceInterval',\n      currentValue: ctx.interval || null,\n      needs: 'supportedScalarValue'\n    });\n  }\n  if (code === 'UNIT_OF_MEASURE_INVALID') {\n    return withTarget({\n      mutationKind: 'UPDATE_MEASURE_FIELD',\n      targetKind: 'measure',\n      field: 'unitOfMeasure',\n      currentValue: ctx.unitOfMeasure || null,\n      needs: 'supportedScalarValue'\n    });\n  }\n  if (code === 'RATE_TABLE_TYPE_INVALID') {\n    return withTarget({\n      mutationKind: 'UPDATE_RATE_TABLE_METADATA',\n      targetKind: targetKind === 'scorecard' ? 'scorecard' : 'rateTable',\n      field: 'rateTableType',\n      currentValue: ctx.rateTableType || null,\n      needs: 'supportedScalarValue'\n    });\n  }\n  if (code === 'RATE_DIMENSION_TYPE_INVALID') {\n    return withTarget({\n      mutationKind: 'UPDATE_RATE_DIMENSION_METADATA',\n      targetKind: 'rateDimension',\n      field: 'dimensionType',\n      currentValue: ctx.dimensionType || null,\n      needs: 'supportedScalarValue'\n    });\n  }\n\n  return null;\n};\n\nvar buildRepairMetadata = function(code, severity, path, context, entityRef) {\n  var metadata = {\n    fixable: false,\n    autoFixCandidate: false,\n    repairPromptHint: null,\n    repairHint: null\n  };\n\n  if (code === 'UNSUPPORTED_FORMULA_REFERENCE_MAPPING') {\n    metadata.fixable = true;\n    metadata.autoFixCandidate = false;\n    metadata.repairPromptHint = 'Replace formula-result style references at ' + path + ' with a supported IC reference such as Measure result or Plan component result.';\n    return metadata;\n  }\n\n  var fixableCodes = {\n    ORG_CONTEXT_REQUIRED: true,\n    PLAN_NAME_REQUIRED: true,\n    PLAN_START_DATE_REQUIRED: true,\n    PLAN_END_DATE_REQUIRED: true,\n    PLAN_DATES_INVALID: true,\n    PLAN_DATES_NOT_IN_DEFINED_PERIOD: true,\n    COMPONENT_DUPLICATE_ID: true,\n    COMPONENT_NAME_DUPLICATE_IN_INPUT: true,\n    COMPONENT_NAME_REQUIRED: true,\n    COMPONENT_DATES_INVALID: true,\n    INVALID_INCENTIVE_TYPE: true,\n    COMPONENT_MEASURE_LINK_MISSING: true,\n    COMPONENT_FORMULA_MISSING: true,\n    COMPONENT_RATE_TABLE_LINK_MISSING: true,\n    RATE_DIM_INPUT_WITHOUT_RATE_TABLE: true,\n    PRIMARY_RATE_TABLE_REFERENCE_INVALID: true,\n    RATE_TABLE_INPUT_EXPRESSION_INVALID: true,\n    MEASURE_DUPLICATE_ID: true,\n    MEASURE_NAME_DUPLICATE_IN_COMPONENT: true,\n    MEASURE_NAME_REQUIRED: true,\n    MEASURE_DATES_INVALID: true,\n    MEASURE_DATES_OUTSIDE_PARENT_RANGE: true,\n    UNIT_OF_MEASURE_INVALID: true,\n    GOAL_TARGET_INVALID: true,\n    INVALID_PROCESS_TRANSACTION: true,\n    INVALID_PERFORMANCE_INTERVAL: true,\n    MEASURE_FORMULA_MISSING: true,\n    FORMULA_EXPRESSION_EMPTY: true,\n    RATE_DIM_INPUT_WITHOUT_MEASURE_FORMULA: true,\n    SCORECARD_INPUT_EXPRESSION_INVALID: true,\n    RATE_TABLE_DUPLICATE_ID: true,\n    RATE_TABLE_NAME_DUPLICATE_IN_INPUT: true,\n    RATE_TABLE_NAME_REQUIRED: true,\n    RATE_TABLE_NAME_ALREADY_EXISTS: true,\n    RATE_DIMENSION_NAME_ALREADY_EXISTS: true,\n    RATE_TABLE_TYPE_INVALID: true,\n    RATE_DIMENSION_NAME_REQUIRED: true,\n    RATE_DIMENSION_TYPE_INVALID: true,\n    RATE_TIER_MIN_MAX_INVALID: true,\n    RATE_TIER_GAP: true,\n    RATE_TIER_OVERLAP: true,\n    RATE_TABLE_RATE_ROW_EMPTY: true,\n    RATE_TABLE_RATE_VALUE_MISSING: true,\n    RATE_ROW_TIER_UNRESOLVED: true,\n    AMBIGUOUS_GENERIC_RATE_INPUT_EXPRESSION: true,\n    RATE_INPUT_EXPRESSION_NAME_REQUIRED: true,\n    EXPRESSION_VARIABLE_SET_MISMATCH: true,\n    MISSING_EXPRESSION_RESOLUTION: true,\n    UNRESOLVED_EXPRESSION_VARIABLES: true,\n    MISSING_EXPRESSION_TOKENS: true,\n    NON_CANONICAL_EXPRESSION_TOKEN: true,\n    INVALID_EXPRESSION_TOKEN_SHAPE: true,\n    TOKEN_RESOLUTION_MISMATCH: true,\n    MISSING_VARIABLE_MAPPING: true,\n    INVALID_MEASURE_RESULT_MAPPING: true,\n    INVALID_COMPONENT_RESULT_MAPPING: true,\n    INVALID_ATTRIBUTE_MAPPING: true,\n    UNSUPPORTED_FORMULA_REFERENCE_MAPPING: true,\n    UNKNOWN_CREDIT_CATEGORY: true,\n    UNKNOWN_EXPRESSION_DETAIL_TYPE: true,\n    PLAN_NAME_ALREADY_EXISTS: true,\n    COMPONENT_NAME_ALREADY_EXISTS: true,\n    MEASURE_NAME_ALREADY_EXISTS: true,\n    EXPRESSION_NAME_ALREADY_EXISTS: true,\n    COMPONENT_SEQUENCE_INVALID: true,\n    COMPONENT_SEQUENCE_TOO_LOW: true,\n    COMPONENT_SEQUENCE_DEPENDENCY_CYCLE: true,\n    MEASURE_CALCULATION_SEQUENCE_INVALID: true,\n    MEASURE_SEQUENCE_DEPENDENCY_CYCLE: true\n  };\n  if (fixableCodes[code]) {\n    metadata.fixable = true;\n  }\n\n  var autoFixCodes = {\n    INVALID_INCENTIVE_TYPE: true,\n    INVALID_PROCESS_TRANSACTION: true,\n    UNIT_OF_MEASURE_INVALID: true,\n    INVALID_PERFORMANCE_INTERVAL: true\n  };\n  if (autoFixCodes[code]) {\n    metadata.autoFixCandidate = true;\n  }\n\n  if (metadata.fixable) {\n    metadata.repairPromptHint = 'Fix issue ' + code + ' at ' + path + ' based on the issue context and current org catalog constraints.';\n  }\n  if (severity === 'WARNING' && !metadata.fixable) {\n    metadata.repairPromptHint = 'Review warning ' + code + ' at ' + path + ' and decide whether a plan edit is needed.';\n  }\n  metadata.repairHint = buildRepairHint(code, context || null, entityRef || null);\n  return metadata;\n};\n\nvar inferEntityFromPath = function(path) {\n  var pathText = path ? String(path) : '';\n  var ref = {\n    entityType: null,\n    entityId: null,\n    entityName: null\n  };\n\n  if (!pathText) {\n    return ref;\n  }\n\n  if (pathText.indexOf('compensationPlan.') === 0 || pathText.indexOf('metadata.') === 0) {\n    ref.entityType = 'plan';\n    ref.entityId = plan && plan.metadata && plan.metadata.planId ? String(plan.metadata.planId) : null;\n    ref.entityName = plan && plan.compensationPlan && plan.compensationPlan.planName ? String(plan.compensationPlan.planName) : null;\n    return ref;\n  }\n\n  var componentMatch = pathText.match(/planComponents\\[(\\d+)\\]/);\n  if (!componentMatch || !plan || !plan.planComponents) {\n    return ref;\n  }\n\n  var componentIndex = Number(componentMatch[1]);\n  var component = plan.planComponents[componentIndex] ? plan.planComponents[componentIndex] : null;\n  if (!component) {\n    return ref;\n  }\n\n  ref.entityType = 'component';\n  ref.entityId = component.componentId ? String(component.componentId) : null;\n  ref.entityName = component.componentName ? String(component.componentName) : null;\n\n  var measureMatch = pathText.match(/performanceMeasures\\[(\\d+)\\]/);\n  if (measureMatch && component.performanceMeasures) {\n    var measureIndex = Number(measureMatch[1]);\n    var measure = component.performanceMeasures[measureIndex] ? component.performanceMeasures[measureIndex] : null;\n    if (measure) {\n      ref.entityType = 'measure';\n      ref.entityId = measure.measureId ? String(measure.measureId) : ref.entityId;\n      ref.entityName = measure.measureName ? String(measure.measureName) : ref.entityName;\n      if ((pathText.indexOf('.formula') !== -1 || pathText.indexOf('.expression') !== -1) && measure.formula) {\n        ref.entityType = 'formula';\n        ref.entityId = measure.formula.formulaId ? String(measure.formula.formulaId) : ref.entityId;\n        ref.entityName = measure.formula.formulaName\n          ? String(measure.formula.formulaName)\n          : ref.entityName;\n      }\n      var scorecardMatch = pathText.match(/scorecards\\[(\\d+)\\]/);\n      if (scorecardMatch && measure.scorecards) {\n        var scorecardIndex = Number(scorecardMatch[1]);\n        var scorecard = measure.scorecards[scorecardIndex] ? measure.scorecards[scorecardIndex] : null;\n        if (scorecard) {\n          ref.entityType = 'rateTable';\n          ref.entityId = scorecard.rateTableId ? String(scorecard.rateTableId) : ref.entityId;\n          ref.entityName = scorecard.rateTableName\n            ? String(scorecard.rateTableName)\n            : (scorecard.scorecardName ? String(scorecard.scorecardName) : ref.entityName);\n          var scorecardDimensionMatch = pathText.match(/dimensions\\[(\\d+)\\]\\.(dimensionName|dimensionType|unitOfMeasure|splitFlag|accumulateFlag)/);\n          if (scorecardDimensionMatch && scorecard.dimensions) {\n            var scorecardDimensionIndex = Number(scorecardDimensionMatch[1]);\n            var scorecardDimension = scorecard.dimensions[scorecardDimensionIndex] ? scorecard.dimensions[scorecardDimensionIndex] : null;\n            if (scorecardDimension) {\n              ref.entityType = 'rateDimension';\n              ref.entityId = scorecardDimension.dimensionId ? String(scorecardDimension.dimensionId) : null;\n              ref.entityName = scorecardDimension.dimensionName ? String(scorecardDimension.dimensionName) : ref.entityName;\n            }\n          }\n        }\n      }\n      return ref;\n    }\n  }\n\n  var formulaMatch = pathText.match(/formulas\\[(\\d+)\\]/);\n  if (formulaMatch && component.formulas) {\n    var formulaIndex = Number(formulaMatch[1]);\n    var formula = component.formulas[formulaIndex] ? component.formulas[formulaIndex] : null;\n    if (formula) {\n      ref.entityType = 'formula';\n      ref.entityId = formula.formulaId ? String(formula.formulaId) : ref.entityId;\n      ref.entityName = formula.formulaName ? String(formula.formulaName) : ref.entityName;\n      return ref;\n    }\n  }\n\n  var rateTableMatch = pathText.match(/rateTables\\[(\\d+)\\]/);\n  if (rateTableMatch && component.rateTables) {\n    var rateTableIndex = Number(rateTableMatch[1]);\n    var rateTable = component.rateTables[rateTableIndex] ? component.rateTables[rateTableIndex] : null;\n    if (rateTable) {\n      ref.entityType = 'rateTable';\n      ref.entityId = rateTable.rateTableId ? String(rateTable.rateTableId) : ref.entityId;\n      ref.entityName = rateTable.rateTableName\n        ? String(rateTable.rateTableName)\n        : (rateTable.name ? String(rateTable.name) : ref.entityName);\n      var rateDimensionMatch = pathText.m