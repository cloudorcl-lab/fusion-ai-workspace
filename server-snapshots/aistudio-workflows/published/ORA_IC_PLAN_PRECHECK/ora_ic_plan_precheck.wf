          "code": "PREPARE_ORG_CATALOG_INPUT",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Org Catalog Input",
            "returnType": "object",
            "sourceCode": "var inputPlan = $context.$variables.plan;\nvar inputOrgId = $context.$variables.orgId;\n\nvar parseMaybeJson = function(value) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n  if (typeof value !== 'string') {\n    return value;\n  }\n  try {\n    return JSON.parse(value);\n  } catch (_err) {\n    return null;\n  }\n};\n\nvar isBlank = function(value) {\n  return value === null || value === undefined || String(value).trim().length === 0;\n};\n\nvar normalizeDate = function(value) {\n  if (isBlank(value)) {\n    return null;\n  }\n  return String(value).trim().substring(0, 10);\n};\n\nvar plan = parseMaybeJson(inputPlan) || new Object();\nvar compPlan = plan && plan.compensationPlan && typeof plan.compensationPlan === 'object'\n  ? plan.compensationPlan\n  : new Object();\nvar embeddedCatalog = plan && plan.metadata && typeof plan.metadata === 'object'\n  ? plan.metadata.orgCatalog\n  : null;\nvar hasEmbeddedCatalog = !!(embeddedCatalog && typeof embeddedCatalog === 'object' && Object.keys(embeddedCatalog).length > 0);\n\nvar planOrgId = !isBlank(compPlan.orgId) ? Number(compPlan.orgId) : null;\nif (planOrgId !== null && isNaN(planOrgId)) {\n  planOrgId = null;\n}\n\nvar triggerOrgId = !isBlank(inputOrgId) ? Number(inputOrgId) : null;\nif (triggerOrgId !== null && isNaN(triggerOrgId)) {\n  triggerOrgId = null;\n}\n\nvar orgId = planOrgId !== null ? planOrgId : triggerOrgId;\nvar businessUnitName = !isBlank(compPlan.businessUnit)\n  ? String(compPlan.businessUnit).trim()\n  : (!isBlank(compPlan.businessUnitName) ? String(compPlan.businessUnitName).trim() : null);\n\nvar result = new Object();\nresult.orgId = orgId;\nresult.businessUnitName = businessUnitName;\nresult.shouldCall = !hasEmbeddedCatalog && (\n  orgId !== null || !isBlank(businessUnitName)\n);\nresult.hasEmbeddedCatalog = hasEmbeddedCatalog;\nreturn result;"
          },
