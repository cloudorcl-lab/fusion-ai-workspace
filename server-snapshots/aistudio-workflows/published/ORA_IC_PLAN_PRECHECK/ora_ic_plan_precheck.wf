        {
          "id": "6",
          "code": "PREPARE_EXISTENCE_QUERIES",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Existence Queries",
            "returnType": "object",
            "sourceCode": "var inputPlan = $context.$variables.plan;\n\nvar parseMaybeJson = function(value) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n  if (typeof value !== 'string') {\n    return value;\n  }\n  try {\n    return JSON.parse(value);\n  } catch (_err) {\n    return null;\n  }\n};\n\nvar extractOrgCatalog = function(value) {\n  var obj = parseMaybeJson(value);\n  if (obj && obj.output !== undefined) {\n    var child = parseMaybeJson(obj.output);\n    if (child && child.result && child.result.catalog) {\n      return child.result.catalog;\n    }\n    if (child && child.catalog) {\n      return child.catalog;\n    }\n  }\n  if (obj && obj.result && obj.result.catalog) {\n    return obj.result.catalog;\n  }\n  if (obj && obj.catalog) {\n    return obj.catalog;\n  }\n  return obj && typeof obj === 'object' ? obj : null;\n};\n\nvar plan = parseMaybeJson(inputPlan);\nvar embeddedCatalog = plan && plan.metadata && typeof plan.metadata === 'object'\n  ? plan.metadata.orgCatalog\n  : null;\nvar inputCatalog = embeddedCatalog;\nif ((inputCatalog === null || inputCatalog === undefined) && $context.$nodes && $context.$nodes.CALL_ORG_CATALOG) {\n  inputCatalog = $context.$nodes.CALL_ORG_CATALOG.$output;\n}\nvar catalog = extractOrgCatalog(inputCatalog);\nvar compPlan = plan && plan.compensationPlan && typeof plan.compensationPlan === 'object'\n  ? plan.compensationPlan\n  : null;\nvar planOrgId = compPlan && compPlan.orgId !== undefined && compPlan.orgId !== null && String(compPlan.orgId).trim() !== ''\n  ? compPlan.orgId\n  : null;\nvar resolvedOrgId = catalog && catalog.orgContext && catalog.orgContext.resolvedOrgId !== undefined\n  ? catalog.orgContext.resolvedOrgId\n  : null;\nvar orgId = planOrgId !== null\n  ? planOrgId\n  : (resolvedOrgId !== undefined && resolvedOrgId !== null && String(resolvedOrgId).trim() !== ''\n    ? resolvedOrgId\n    : null);\n\nvar isBlank = function(value) {\n  return value === null || value === undefined || String(value).trim().length === 0;\n};\n\nvar normalizeDate = function(value) {\n  if (isBlank(value)) {\n    return null;\n  }\n  return String(value).trim().substring(0, 10);\n};\n\nvar normalizeKey = function(value) {\n  return isBlank(value) ? null : String(value).trim().toUpperCase();\n};\n\nvar stripCollisionSuffix = function(value) {\n  if (isBlank(value)) {\n    return '';\n  }\n  return String(value)\n    .replace(/_copy_[0-9a-fA-F]{6}$/i, '')\n    .replace(/\\s+\\d{3}$/i, '')\n    .trim();\n};\n\nvar hasRateInputExpressionContent = function(rateInput) {\n  if (!rateInput || typeof rateInput !== 'object') {\n    return false;\n  }\n  if (rateInput.tokens && rateInput.tokens.length !== undefined && rateInput.tokens.length > 0) {\n    return true;\n  }\n  if (!isBlank(rateInput.inputExpression)) {\n    return true;\n  }\n  if (!isBlank(rateInput.simpleExpression)) {\n    return true;\n  }\n  if (!isBlank(rateInput.displayText)) {\n    return true;\n  }\n  return false;\n};\n\nvar buildRateInputExpressionName = function(rateInput) {\n  if (!rateInput || typeof rateInput !== 'object') {\n    return null;\n  }\n  if (!isBlank(rateInput.inputExpressionName)) {\n    return String(rateInput.inputExpressionName).trim();\n  }\n  return null;\n};\n\nvar addRateInputExpressionName = function(target, rateInput) {\n  if (!hasRateInputExpressionContent(rateInput)) {\n    return;\n  }\n  var expressionName = buildRateInputExpressionName(rateInput);\n  addUniqueName(target, expressionName);\n  if (!isBlank(expressionName) && String(expressionName).trim().length > 76) {\n    addUniqueName(target, String(expressionName).trim().substring(0, 76));\n  }\n};\n\nvar addUniqueName = function(target, value) {\n  var key = normalizeKey(value);\n  if (!key) {\n    return;\n  }\n  if (!target._seen) {\n    target._seen = new Object();\n  }\n  if (target._seen[key]) {\n    return;\n  }\n  target._seen[key] = true;\n  target.items.push(String(value).trim());\n};\n\nvar addRateDimensionName = function(target, value) {\n  addUniqueName(target, value);\n  if (!isBlank(value) && String(value).trim().length > 76) {\n    addUniqueName(target, String(value).trim().substring(0, 76));\n  }\n};\n\nvar escapeQueryValue = function(value) {\n  return String(value).replace(/'/g, \"''\");\n};\n\nvar buildNoMatchQuery = function(fieldName, resolvedOrgIdValue) {\n  if (resolvedOrgIdValue !== undefined && resolvedOrgIdValue !== null && String(resolvedOrgIdValue).trim() !== '') {\n    return 'OrgId=' + String(resolvedOrgIdValue) + \" and \" + fieldName + \" = '__ORA_IC_PLAN_PRECHECK_NO_MATCH__'\";\n  }\n  return fieldName + \" = '__ORA_IC_PLAN_PRECHECK_NO_MATCH__'\";\n};\n\nvar buildNameQuery = function(fieldName, resolvedOrgIdValue, names) {\n  if (resolvedOrgIdValue === undefined || resolvedOrgIdValue === null || String(resolvedOrgIdValue).trim() === '') {\n    return buildNoMatchQuery(fieldName, null);\n  }\n  if (!names || names.length === 0) {\n    return buildNoMatchQuery(fieldName, resolvedOrgIdValue);\n  }\n  var clauses = [];\n  var i = 0;\n  for (i = 0; i < names.length; i += 1) {\n    clauses.push(fieldName + \" = '\" + escapeQueryValue(names[i]) + \"'\");\n  }\n  if (clauses.length === 1) {\n    return 'OrgId=' + String(resolvedOrgIdValue) + ' and ' + clauses[0];\n  }\n  return 'OrgId=' + String(resolvedOrgIdValue) + ' and (' + clauses.join(' or ') + ')';\n};\n\nvar buildFamilyNameQuery = function(fieldName, resolvedOrgIdValue, names) {\n  if (resolvedOrgIdValue === undefined || resolvedOrgIdValue === null || String(resolvedOrgIdValue).trim() === '') {\n    return buildNoMatchQuery(fieldName, null);\n  }\n  if (!names || names.length === 0) {\n    return buildNoMatchQuery(fieldName, resolvedOrgIdValue);\n  }\n  var clauses = [];\n  var seenFamilies = new Object();\n  var i = 0;\n  for (i = 0; i < names.length; i += 1) {\n    var familyBase = stripCollisionSuffix(names[i]);\n    var familyKey = normalizeKey(familyBase);\n    if (!familyKey || seenFamilies[familyKey]) {\n      continue;\n    }\n    seenFamilies[familyKey] = true;\n    clauses.push(fieldName + \" = '\" + escapeQueryValue(familyBase) + \"'\");\n    clauses.push(fieldName + \" like '\" + escapeQueryValue(familyBase) + \" %'\");\n  }\n  if (clauses.length === 0) {\n    return buildNoMatchQuery(fieldName, resolvedOrgIdValue);\n  }\n  if (clauses.length === 1) {\n    return 'OrgId=' + String(resolvedOrgIdValue) + ' and ' + clauses[0];\n  }\n  return 'OrgId=' + String(resolvedOrgIdValue) + ' and (' + clauses.join(' or ') + ')';\n};\n\nvar buildFamilyNameQueries = function(fieldName, resolvedOrgIdValue, names) {\n  var noMatch = {\n    familyBase: null,\n    q: buildNoMatchQuery(fieldName, resolvedOrgIdValue)\n  };\n  if (resolvedOrgIdValue === undefined || resolvedOrgIdValue === null || String(resolvedOrgIdValue).trim() === '') {\n    return [noMatch];\n  }\n  if (!names || names.length === 0) {\n    return [noMatch];\n  }\n  var queries = [];\n  var seenFamilies = new Object();\n  var i = 0;\n  for (i = 0; i < names.length; i += 1) {\n    var familyBase = stripCollisionSuffix(names[i]);\n    var familyKey = normalizeKey(familyBase);\n    if (!familyKey || seenFamilies[familyKey]) {\n      continue;\n    }\n    seenFamilies[familyKey] = true;\n    queries.push({\n      familyBase: familyBase,\n      q: 'OrgId=' + String(resolvedOrgIdValue)\n        + ' and ('\n        + fieldName + \" = '\" + escapeQueryValue(familyBase) + \"'\"\n        + ' or '\n        + fieldName + \" like '\" + escapeQueryValue(familyBase) + \" %'\"\n        + ')'\n    });\n  }\n  return queries.length > 0 ? queries : [noMatch];\n};\n\nvar names = {\n  planNames: { items: [] },\n  componentNames: { items: [] },\n  measureNames: { items: [] },\n  expressionNames: { items: [] },\n  rateTableNames: { items: [] },\n  rateDimensionNames: { items: [] },\n  creditCategoryNames: { items: [] }\n};\n\nif (compPlan) {\n  addUniqueName(names.planNames, compPlan.planName || compPlan.name);\n}\n\nvar planComponents = plan && plan.planComponents && plan.planComponents.length !== undefined\n  ? plan.planComponents\n  : [];\nvar componentIndex = 0;\nfor (componentIndex = 0; componentIndex < planComponents.length; componentIndex += 1) {\n  var component = planComponents[componentIndex] ? planComponents[componentIndex] : new Object();\n  addUniqueName(names.componentNames, component.componentName || component.name);\n\n  var componentFormulas = component.formulas && component.formulas.length !== undefined\n    ? component.formulas\n    : [];\n  var formulaIndex = 0;\n  for (formulaIndex = 0; formulaIndex < componentFormulas.length; formulaIndex += 1) {\n    var componentFormula = componentFormulas[formulaIndex] ? componentFormulas[formulaIndex] : new Object();\n    addUniqueName(names.expressionNames, componentFormula.formulaName || componentFormula.name);\n  }\n\n  var measures = component.performanceMeasures && component.performanceMeasures.length !== undefined\n    ? component.performanceMeasures\n    : [];\n  var measureIndex = 0;\n  for (measureIndex = 0; measureIndex < measures.length; measureIndex += 1) {\n    var measure = measures[measureIndex] ? measures[measureIndex] : new Object();\n    addUniqueName(names.measureNames, measure.measureName || measure.name);\n    if (measure.formula && typeof measure.formula === 'object') {\n      addUniqueName(names.expressionNames, measure.formula.formulaName || measure.formula.name);\n    }\n    var measureRateInputs = measure.rateDimensionalInputs && measure.rateDimensionalInputs.length !== undefined\n      ? measure.rateDimensionalInputs\n      : [];\n    var measureRateInputIndex = 0;\n    for (measureRateInputIndex = 0; measureRateInputIndex < measureRateInputs.length; measureRateInputIndex += 1) {\n      addRateInputExpressionName(\n        names.expressionNames,\n        measureRateInputs[measureRateInputIndex]\n      );\n    }\n    var categories = measure.creditCategories && measure.creditCategories.length !== undefined\n      ? measure.creditCategories\n      : [];\n    var categoryIndex = 0;\n    for (categoryIndex = 0; categoryIndex < categories.length; categoryIndex += 1) {\n      var category = categories[categoryIndex] ? categories[categoryIndex] : new Object();\n      addUniqueName(names.creditCategoryNames, category.categoryName || category.name);\n    }\n    var scorecards = measure.scorecards && measure.scorecards.length !== undefined\n      ? measure.scorecards\n      : [];\n    var scorecardIndex = 0;\n    for (scorecardIndex = 0; scorecardIndex < scorecards.length; scorecardIndex += 1) {\n      var scorecard = scorecards[scorecardIndex] ? scorecards[scorecardIndex] : new Object();\n      addUniqueName(names.rateTableNames, scorecard.rateTableName || scorecard.scorecardName || scorecard.name);\n      var scorecardDimensions = scorecard.dimensions && scorecard.dimensions.length !== undefined\n        ? scorecard.dimensions\n        : [];\n      var scorecardDimensionIndex = 0;\n      for (scorecardDimensionIndex = 0; scorecardDimensionIndex < scorecardDimensions.length; scorecardDimensionIndex += 1) {\n        var scorecardDimension = scorecardDimensions[scorecardDimensionIndex] ? scorecardDimensions[scorecardDimensionIndex] : new Object();\n        addRateDimensionName(names.rateDimensionNames, scorecardDimension.dimensionName || scorecardDimension.name);\n      }\n    }\n  }\n\n  var rateTables = component.rateTables && component.rateTables.length !== undefined\n    ? component.rateTables\n    : [];\n  var rateTableIndex = 0;\n  for (rateTableIndex = 0; rateTableIndex < rateTables.length; rateTableIndex += 1) {\n    var rateTable = rateTables[rateTableIndex] ? rateTables[rateTableIndex] : new Object();\n    addUniqueName(names.rateTableNames, rateTable.rateTableName || rateTable.name);\n    var dimensions = rateTable.dimensions && rateTable.dimensions.length !== undefined\n      ? rateTable.dimensions\n      : [];\n    var dimensionIndex = 0;\n    for (dimensionIndex = 0; dimensionIndex < dimensions.length; dimensionIndex += 1) {\n      var dimension = dimensions[dimensionIndex] ? dimensions[dimensionIndex] : new Object();\n      addRateDimensionName(names.rateDimensionNames, dimension.dimensionName || dimension.name);\n    }\n  }\n\n  var componentRateInputs = component.rateDimensionalInputs && component.rateDimensionalInputs.length !== undefined\n    ? component.rateDimensionalInputs\n    : [];\n  var componentRateInputIndex = 0;\n  for (componentRateInputIndex = 0; componentRateInputIndex < componentRateInputs.length; componentRateInputIndex += 1) {\n    addRateInputExpressionName(\n      names.expressionNames,\n      componentRateInputs[componentRateInputIndex]\n    );\n  }\n}\n\nvar planStartDate = normalizeDate(compPlan && compPlan.effectiveStartDate);\nvar planEndDate = normalizeDate(compPlan && compPlan.effectiveEndDate);\nvar openPeriodQuery = null;\nif (orgId !== null && orgId !== undefined && String(orgId).trim() !== '' && planStartDate && planEndDate) {\n  openPeriodQuery = \"OrgId=\" + String(orgId)\n    + \" and StartDate<='\" + planEndDate + \"'\"\n    + \" and EndDate>='\" + planStartDate + \"'\";\n} else {\n  openPeriodQuery = buildNoMatchQuery('PeriodName', orgId);\n}\n\nvar result = new Object();\nresult.orgId = orgId;\nresult.planStartDate = planStartDate;\nresult.planEndDate = planEndDate;\nresult.openPeriodQuery = openPeriodQuery;\nresult.creditCategoryQuery = buildNameQuery('Name', orgId, names.creditCategoryNames.items);\nresult.planQuery = buildNameQuery('Name', orgId, names.planNames.items);\nresult.componentQuery = buildNameQuery('Name', orgId, names.componentNames.items);\nresult.measureQuery = buildNameQuery('Name', orgId, names.measureNames.items);\nresult.expressionQuery = buildFamilyNameQuery('Name', orgId, names.expressionNames.items);\nresult.expressionQueries = buildFamilyNameQueries('Name', orgId, names.expressionNames.items);\nresult.rateTableQuery = buildNameQuery('Name', orgId, names.rateTableNames.items);\nresult.rateDimensionQuery = buildFamilyNameQuery('Name', orgId, names.rateDimensionNames.items);\nresult.rateDimensionQueries = buildFamilyNameQueries('Name', orgId, names.rateDimensionNames.items);\nreturn result;"
          },
