        {
          "metadata": {
            "name": "Construct Query Parameters To Fetch Put Away Suggestions Enabled Organizations",
            "returnType": "string",
            "sourceCode": "const organizationsList = $context.$variables.OrganizationsList ;\n \nlet orgFilterClause; \n\nif (organizationsList.length > 0) {\n     const organizationCodesCsv = organizationsList.map(code => String(code).trim()).filter(code => code !== \"\").map(code => `'${code}'`).join(\",\") ;\n     orgFilterClause = \"AND OrganizationCode IN ( \" + organizationCodesCsv  + \" )\";  \n} \n\nreturn orgFilterClause;"
          },
          "outcomes": {
            "success": "1772477616934"
          },
          "code": "CONSTRUCT_QUERY_PARAMETERS_TO_FETCH_PUTAWAY_SUGGESTIONS_ENABLED_ORGANIZATIONS",
          "convergenceTargetId": "1772469296617",
          "id": "1772437128883",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
