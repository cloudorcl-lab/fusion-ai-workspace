                            "name": "Construct Summary List Per Org",
                            "returnType": "array",
                            "sourceCode": "let OrgSummaryList = $context.$variables.OrganizationSummaryList ;\n\nif (Array.isArray(OrgSummaryList)) {\n      OrgSummaryList.push({\n            \"OrganizationCode\": $context.$nodes.LOOP_OVER_ELIGIBLE_ORGANIZATIONS.$currentItem.OrganizationCode,\n            \"EligibleReceiptLines\": $context.$nodes.LOOP_OVER_ELIGIBLE_ORGANIZATIONS.FETCH_ELIGIBLE_RECEIPT_LINES_FOR_PUT_AWAY_SUGGESTIONS.$output.count,\n            \"KanbanReceiptLines\": $context.$variables.KanbanReceiptLinesCount,\n            \"DocumentReceiptLines\": $context.$variables.DocumentReceiptLinesCount ,\n            \"HistoricReceiptLines\": $context.$variables.HistoricReceiptLinesCount \n      });\n} else {\n      OrgSummaryList = [OrgSummaryList];\n       OrgSummaryList.push({\n            \"OrganizationCode\": $context.$nodes.LOOP_OVER_ELIGIBLE_ORGANIZATIONS.$currentItem.OrganizationCode,\n            \"EligibleReceiptLines\": $context.$nodes.LOOP_OVER_ELIGIBLE_ORGANIZATIONS.FETCH_ELIGIBLE_RECEIPT_LINES_FOR_PUT_AWAY_SUGGESTIONS.$output.count,\n            \"KanbanReceiptLines\": $context.$variables.KanbanReceiptLinesCount,\n            \"DocumentReceiptLines\": $context.$variables.DocumentReceiptLinesCount,\n            \"HistoricReceiptLines\": $context.$variables.HistoricReceiptLinesCount \n      });\n}\n\nreturn OrgSummaryList;"
                          },
