                          "metadata": {
                            "name": "Construct Query Parameters To Fetch Eligible Receipt Lines For Put Away Suggestions",
                            "returnType": "string",
                            "sourceCode": "const receiptNumber = $context.$variables.ReceiptNumber ;\nconst itemNumber = $context.$variables.ItemNumber ;\n\nconst filters = [{ filter: \"ExcludeTxnsWithPutAwaySuggestions\" }];\n\nif (receiptNumber !== null && receiptNumber !== \"\") {\n    filters.push({\n      filter: \"PutawayReceiptLOV\",\n      value: String(receiptNumber)\n    }); \n}\n\nif (itemNumber !== null && itemNumber !== \"\") {\n    filters.push({\n      filter: \"PutawayItemLOV\",\n      value: String(itemNumber) \n    }); \n}\n\nreturn JSON.stringify(filters);"
                          },
                          "outcomes": {
                            "success": "1772522224760"
                          },
