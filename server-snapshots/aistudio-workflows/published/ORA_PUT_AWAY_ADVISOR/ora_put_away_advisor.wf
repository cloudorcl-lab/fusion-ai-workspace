                                  "metadata": {
                                    "name": "Check For Kanban Card Subinventory"
                                  },
                                  "outcomes": {
                                    "true": "1775074734938",
                                    "false": "1773831817366"
                                  },
                                  "code": "CHECK_FOR_KANBAN_CARD_SUBINVENTORY",
                                  "convergenceTargetId": "end_1773816392650",
                                  "id": "1773337340889",
                                  "inputs": [
                                    {
                                      "id": "1773337340890_1",
                                      "name": "condition",
                                      "type": "string",
                                      "value": "{{$context.$nodes.LOOP_OVER_ELIGIBLE_RECEIPT_LINES.$currentItem.KanbanCard?.SubinventoryCode != null}}"
                                    }
                                  ],
                                  "type": "CONDITION"
                                },
                                {
                                  "metadata": {
                                    "name": "Check Document Level SubInventory",
                                    "returnType": "boolean",
                                    "sourceCode": "const sourceDocumentCode = $context.$nodes.LOOP_OVER_ELIGIBLE_RECEIPT_LINES.$currentItem.SourceDocumentCode;\n\nlet hasSubinventory = false;\n\nif (sourceDocumentCode === \"PO\") {\n      const poDistributions = $context.$nodes.LOOP_OVER_ELIGIBLE_RECEIPT_LINES.$currentItem.PODistributions;\n      hasSubinventory = poDistributions.some((distribution) => {\n          const documentSubinventory = distribution?.Subinventory;\n          return documentSubinventory !== null && documentSubinventory !== undefined && documentSubinventory !== \"\";\n      });\n} else if (sourceDocumentCode === \"TRANSFER ORDER\" || sourceDocumentCode === \"INVENTORY\") {\n      const documentSubinventory = $context.$nodes.LOOP_OVER_ELIGIBLE_RECEIPT_LINES.$currentItem.ShipmentLine?.Subinventory;\n      hasSubinventory = documentSubinventory !== null && documentSubinventory !== undefined && documentSubinventory !== \"\";\n}\n\nreturn hasSubinventory;"
                                  },
                                  "outcomes": {
                                    "success": "1773926599487"
                                  },
                                  "code": "CHECK_DOCUMENT_LEVEL_SUBINVENTORY",
                                  "convergenceTargetId": "1773338619714",
                                  "id": "1773831817366",
                                  "inputs": [],
                                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                                  "type": "CODE"
                                },
                                {
                                  "metadata": {
