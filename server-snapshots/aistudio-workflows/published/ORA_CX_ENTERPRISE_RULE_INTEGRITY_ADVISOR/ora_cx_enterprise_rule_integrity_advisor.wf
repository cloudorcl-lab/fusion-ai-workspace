{
  "workflowId": "100002355226879",
  "workflowCode": "ORA_CX_ENTERPRISE_RULE_INTEGRITY_ADVISOR",
  "name": "Rule Integrity Analyst",
  "description": "Advises user about the integrity of a Product offering rule when given the required inputs.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
