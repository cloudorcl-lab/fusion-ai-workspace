            "name": "Return Exception Types",
            "returnType": "object",
            "sourceCode": "// 1. Data Assignment\nvar inputCategoryRaw = $context.$variables.prjPjcVarConvUserExceptionCategory; \nvar ragWithText = $context.$variables.prjPjcVarConvMessageRagWithText;\nvar summarizedData = $context.$variables.prjPjcVarConvSummarizedData;\n\n// Extract the name string\nvar inputCategory = \"\";\nif (inputCategoryRaw) {\n    if (Array.isArray(inputCategoryRaw) && inputCategoryRaw.length > 0) {\n        inputCategory = inputCategoryRaw[0].ExceptionCategoryName;\n    } else if (typeof inputCategoryRaw === 'object') {\n        // Check if it's a direct string or an object with the property\n        inputCategory = inputCategoryRaw.ExceptionCategoryName || inputCategoryRaw;\n    } else if (typeof inputCategoryRaw === 'string') {\n        inputCategory = inputCategoryRaw;\n    }\n}\n\nvar combinedMessages = (ragWithText && Array.isArray(ragWithText.CombinedMessages)) ? ragWithText.CombinedMessages : [];\nvar rows = (summarizedData && Array.isArray(summarizedData)) ? summarizedData : [];\n\nvar finalOutput = [];\nvar counter = 1;\n\n// 2. Processing Logic\nif (inputCategory && rows.length > 0) {\n    for (var i = 0; i < rows.length; i++) {\n        var currentRow = rows[i];\n        var currentKey = currentRow.MessageTextKey;\n        var currentCount = currentRow.Count;\n\n        // SKIP row if MessageTextKey is missing (handles the {\"Count\": 7} case)\n        if (!currentKey) {\n            continue; \n        }\n\n        // Find match in RAG data\n        var match = combinedMessages.find(function(m) {\n            return m.ExceptionCategory === inputCategory && m.MessageTextKey === currentKey;\n        });\n\n        if (match) {\n            finalOutput.push({\n                \"ExceptionCategoryName\": inputCategory,\n                \"ExceptionType\": match.MessageText,\n                 \"ExceptionTypeDetail\": match.MessageDetailText,\n                \"MessageTextKey\": currentKey,\n                \"SerialNumber\": counter,\n                \"Count\": currentCount\n            });\n            counter++;\n        }\n    }\n}\n\n// 3. Final Output Logic\nvar result = {\n    \"SummarizedRows\": finalOutput\n};\n\nreturn JSON.stringify(result);"
          },
          "outcomes": {
            "success": "1771482055366"
          },
