        {
          "metadata": {
            "name": "Return Exception Details",
            "returnType": "object",
            "sourceCode": "// 1. Data Assignment & Robust Initialization\nvar nodeData = $context.$nodes.PRJ_PJC_LLM_INTENT_RECOGNIZER.$output.UserEnteredExceptionType;\nvar varData = $context.$variables.prjPjcVarConvUserExceptionType;\nvar ragWithText = $context.$variables.prjPjcVarConvMessageRagWithText;\n\n// --- STEP 1: Initialize inputTypeRaw with Fallback Logic ---\n// If nodeData is an empty array or null, use varData\nvar inputTypeRaw = (Array.isArray(nodeData) && nodeData.length > 0) ? nodeData : (nodeData && !Array.isArray(nodeData) ? nodeData : varData);\n\nvar inputMessageText = \"\";\n\nif (inputTypeRaw) {\n    if (Array.isArray(inputTypeRaw) && inputTypeRaw.length > 0) {\n        // Case: Data is an Array, check both key variations\n        inputMessageText = inputTypeRaw[0].ExceptionTypeName || inputTypeRaw[0].name || \"\"; \n    } else if (typeof inputTypeRaw === 'object') {\n        // Case: Data is a direct Object, check both key variations\n        inputMessageText = inputTypeRaw.ExceptionTypeName || inputTypeRaw.name || \"\";\n    }\n}\n\nvar combinedMessages = (ragWithText && Array.isArray(ragWithText.CombinedMessages)) ? ragWithText.CombinedMessages : [];\n\n// 2. Processing Logic\nvar result = {\n    \"ResolutionOptions\": \"\",\n    \"ReferenceAttributes\": \"\",\n    \"MessageTextKey\": \"\"\n};\n\n// --- STEP 2: Verify it's a string before calling .toLowerCase() ---\nif (typeof inputMessageText === 'string' && inputMessageText.trim() !== \"\") {\n    var searchStr = inputMessageText.toLowerCase().trim();\n\n    var match = combinedMessages.find(function(m) {\n        // Safe check for MessageText before comparison\n        return m.MessageText && m.MessageText.toLowerCase().trim() === searchStr;\n    });\n\n    if (match) {\n        result.ResolutionOptions = match.ResolutionOptions || \"\";\n        result.ReferenceAttributes = match.ReferenceAttributes || \"\";\n        result.MessageTextKey = match.MessageTextKey || \"\";\n    }\n}\n\n// 3. Final Output\nreturn JSON.stringify(result);"
          },
