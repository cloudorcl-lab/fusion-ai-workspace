        {
          "metadata": {
            "name": "Select Clause",
            "returnType": "object",
            "sourceCode": "// 1. Data Assignment\nvar rawInput = $context.$variables.prjPjcVarConvExceptionDetails; \nvar items = [];\nif (rawInput) {\n    if (Array.isArray(rawInput)) {\n        items = rawInput;\n    } else {\n        items = [rawInput];\n    }\n}\n\n// External variables for context\nvar messageRag = $context.$variables.prjPjcVarConvMessageRAG;\nvar displayToAttributeMap = $context.$variables.prjPjcVarConvDisplaytoAttributeMap;\n\n// 2. Processing Logic: Extracting Technical Attribute Names\nvar attributeNames = [];\n\nfor (var i = 0; i < items.length; i++) {\n    try {\n        // Handle input if it's a stringified JSON or a direct object\n        var record = typeof items[i] === 'string' ? JSON.parse(items[i]) : items[i];\n        var inputKey = record.MessageTextKey;\n\n        if (inputKey && messageRag && messageRag.messages) {\n            // Find the specific message details in your RAG data\n            var ragMatch = messageRag.messages.find(function(m) {\n                return m.MessageTextKey === inputKey;\n            });\n\n            if (ragMatch && ragMatch.ReferenceAttributes) {\n                // Split comma-separated display values: e.g., \"Project Number, Task Name\"\n                var displayValues = ragMatch.ReferenceAttributes.split(',');\n\n                displayValues.forEach(function(val) {\n                    var trimmedVal = val.trim();\n                    \n                    // Look up the DB Attribute Name from the display-to-attribute mapping\n                    var mapping = (displayToAttributeMap && displayToAttributeMap.DisplaytoAttributeMap) \n                        ? displayToAttributeMap.DisplaytoAttributeMap.find(function(map) {\n                            return map.DisplayValue.toLowerCase().trim() === trimmedVal.toLowerCase();\n                        }) : null;\n\n                    if (mapping) {\n                        // Check if the mapping contains multiple attributes (e.g., \"projectNumber, projectName\")\n                        if (mapping.AttributeName.indexOf(\",\") !== -1) {\n                            var multiAttrs = mapping.AttributeName.split(\",\");\n                            multiAttrs.forEach(function(subAttr) {\n                                var cleanSub = subAttr.trim();\n                                if (attributeNames.indexOf(cleanSub) === -1) {\n                                    attributeNames.push(cleanSub);\n                                }\n                            });\n                        } else {\n                            // Standard single attribute mapping\n                            if (attributeNames.indexOf(mapping.AttributeName) === -1) {\n                                attributeNames.push(mapping.AttributeName);\n                            }\n                        }\n                    }\n                });\n            }\n        }\n    } catch (e) {\n        // Skip records that fail parsing to prevent script termination\n        continue;\n    }\n}\n\n// 3. Filtering and String Formation\n// Requirement: Remove 'transactionDate' specifically from the select clause\nvar filteredAttributes = attributeNames.filter(function(attr) {\n    return attr !== \"transactionDate\";\n});\n\nvar finalSelectString = \"\";\n\nif (filteredAttributes.length > 0) {\n    // Join names into a SQL-friendly comma-separated string\n    finalSelectString = filteredAttributes.join(\", \");\n} else {\n    // Fallback ID to ensure the SQL query doesn't have an empty SELECT clause\n    finalSelectString = \"unprocessedProjectCostTransactionId\"; \n}\n\n// 4. Final Result\nreturn finalSelectString;"
          },
