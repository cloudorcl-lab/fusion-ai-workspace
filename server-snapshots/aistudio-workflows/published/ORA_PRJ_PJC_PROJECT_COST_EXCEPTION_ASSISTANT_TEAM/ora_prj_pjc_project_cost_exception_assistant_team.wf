        {
          "metadata": {
            "name": "Return Categories",
            "returnType": "object",
            "sourceCode": "// 1. Data Assignment\nvar summarizedData = $context.$variables.prjPjcVarConvSummarizedData;\nvar messageRAG = $context.$variables.prjPjcVarConvMessageRAG;\n\nvar rows = (summarizedData && Array.isArray(summarizedData)) ? summarizedData : [];\nvar ragMessages = (messageRAG && Array.isArray(messageRAG.messages)) ? messageRAG.messages : [];\n\nvar totalExceptionCount = 0;\nvar categoryMap = {}; // Used to aggregate counts by Category Name\n\n// 2. Processing and Mapping Logic\nfor (var i = 0; i < rows.length; i++) {\n    var row = rows[i];\n    var currentCount = parseInt(row.Count) || 0;\n    var currentKey = row.MessageTextKey;\n\n    // A. Add to global total\n    totalExceptionCount += currentCount;\n\n    // B. Find the Category for this MessageTextKey in RAG data\n    var ragMatch = ragMessages.find(function(m) {\n        return m.MessageTextKey === currentKey;\n    });\n\n    // Default to \"Uncategorized\" if no match found\n    var categoryName = (ragMatch && ragMatch.ExceptionCategory) ? ragMatch.ExceptionCategory : \"Uncategorized Exception\";\n\n    // C. Group and Aggregate by Category\n    if (!categoryMap[categoryName]) {\n        categoryMap[categoryName] = 0;\n    }\n    categoryMap[categoryName] += currentCount;\n}\n\n// 3. Transform Map into Final Array with Serial Numbers\nvar costCategoryArray = [];\nvar counter = 1;\n\nfor (var catName in categoryMap) {\n    if (categoryMap.hasOwnProperty(catName)) {\n        costCategoryArray.push({\n            \"ExceptionCategory\": catName,\n            \"Count\": categoryMap[catName],\n            \"SerialNumber\": counter\n        });\n        counter++;\n    }\n}\n\n// 4. Final Output Structure\nvar result = {\n    \"CostCategory\": costCategoryArray\n};\n\nreturn JSON.stringify(result);"
          },
