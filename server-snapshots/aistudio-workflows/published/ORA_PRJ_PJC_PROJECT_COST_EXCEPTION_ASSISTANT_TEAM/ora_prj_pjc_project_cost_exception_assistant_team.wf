          "metadata": {
            "name": "Return Project Accounting Date Range",
            "returnType": "string",
            "sourceCode": "// 1. Data Assignment\nvar filterString = $context.$nodes.PRJ_PJC_CODE_CREATE_FILTER_STRING.$output.result || \"\";\n\n// 2. Extraction Logic\n// Extract transactionDate BETWEEN TO_DATE('dd-mm-yyyy', 'DD-MM-YYYY') AND TO_DATE('dd-mm-yyyy', 'DD-MM-YYYY')\nvar ProjectAccountingDateRange = null;\n\nvar regex = /projectAccountingDate\\s+BETWEEN\\s+TO_DATE\\('(\\d{2}-\\d{2}-\\d{4})',\\s*'DD-MM-YYYY'\\)\\s+AND\\s+TO_DATE\\('(\\d{2}-\\d{2}-\\d{4})',\\s*'DD-MM-YYYY'\\)/i;\n\nvar match = filterString.match(regex);\n\nif (match) {\n    var startDate = match[1];\n    var endDate = match[2];\n    ProjectAccountingDateRange = startDate + \" - \" + endDate;\n}\n\n// 3. Final Output Logic\nvar result = {\n    \"extractedProjectAccountingDateRange\": ProjectAccountingDateRange\n};\n\nreturn JSON.stringify(result);"
          },
          "outcomes": {
            "success": "1773846899283"
          },
