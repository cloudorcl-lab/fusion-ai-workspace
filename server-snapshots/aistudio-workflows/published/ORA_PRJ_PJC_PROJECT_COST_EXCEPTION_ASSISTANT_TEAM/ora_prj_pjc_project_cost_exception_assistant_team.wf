          },
          "outcomes": {
            "success": "1771313278810"
          },
          "code": "PRJ_PJC_BUSINESS_OBJECT_FUNCTION_STRING_EXTRACTION_DEFAULT_DEPLOYMENT",
          "id": "1771309755534",
          "inputs": [],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"DeploymentId\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Extract Deployment ID",
            "returnType": "object",
            "sourceCode": "// 1. Data Assignment \n// Assuming the JSON is stored in a variable or node output\nvar inputData = $context.$nodes.PRJ_PJC_BUSINESS_OBJECT_FUNCTION_STRING_EXTRACTION_DEFAULT_DEPLOYMENT.$output;\n\n// 2. Extract Deployment ID\n// We normalize the input in case it is still a string\nvar data = (typeof inputData === 'string') ? JSON.parse(inputData) : inputData;\nvar deploymentId = (data && data.deploymentId) ? data.deploymentId : null;\n\n// 3. Return the result\nreturn deploymentId;"
          },
          "outcomes": {
            "success": "1771310921339"
          },
          "code": "PRJ_PJC_CODE_EXTRACT_DEPLOYMENT_ID",
          "id": "1771313278810",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_PRJ_ORAPRJCOMM_PROJECTCOMMONSTRINGSINQUIRY",
            "functionName": "GET_ALL_STRINGS_FROM_BUNDLE",
            "name": "Message Key Value Extraction"
          },
          "outcomes": {
