        {
          "metadata": {
            "name": "Extract Additional Reference Attributes",
            "returnType": "object",
            "sourceCode": "// 1. Data Assignment\nvar rawInput = $context.$variables.prjPjcVarConvExceptionDetails;\nvar items = [];\nif (rawInput) {\n    items = Array.isArray(rawInput) ? rawInput : [rawInput];\n}\n\n// 2. Configuration: Add new attribute checks here in the future\n// Key: The string to look for in ReferenceAttributes\n// Value: The flag name to set to \"Y\" if found\nvar attributeTriggers = {\n    \"Cost Type Classification Start Date\": \"CostTypeClassificationInfoNeeded\",\n    \"Cost Type Classification End Date\": \"CostTypeClassificationInfoNeeded\",\n    \"Worker\":\"PersonInfoNeeded\",\n    \"Worker Assignment Number\":\"PersonInfoNeeded\"\n    \n    // Example for future: \"Tax ID\": \"TaxInfoNeeded\"\n};\n\n// 3. Initialize Results Object\n// We pre-set all possible flags to \"N\"\nvar flags = {\n    CostTypeClassificationInfoNeeded: \"N\",\n    PersonInfoNeeded : \"N\"\n};\n\n// 4. Processing Logic\nfor (var i = 0; i < items.length; i++) {\n    var refAttrs = String(items[i].ReferenceAttributes || \"\");\n\n    // Loop through our configuration to check for matches\n    for (var searchString in attributeTriggers) {\n        var flagName = attributeTriggers[searchString];\n\n        // If the attribute is found and we haven't already set this flag to \"Y\"\n        if (refAttrs.indexOf(searchString) !== -1) {\n            flags[flagName] = \"Y\";\n        }\n    }\n}\n\n// 5. Result Generation\n// This returns the flags object (e.g., { \"CostTypeClassificationInfoNeeded\": \"Y\" })\nreturn JSON.stringify(flags);"
          },
