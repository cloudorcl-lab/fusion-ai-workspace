            "sourceCode": "// 1. Data Assignment\nvar currentState = String($context.$variables.prjPjcVarConvCurrentState || \"\").toUpperCase();\nvar ambiguousText = $context.$nodes.PRJ_PJC_LLM_INTENT_RECOGNIZER.$output.AmbiguousText;\n\nvar response = \"\";\n\n// 2. Logic & Conditionals\nif (ambiguousText === \"Please ensure to give proper Search identifiers\") {\n    // Return text as it is for Rule 1\n    response = ambiguousText;\n} \nelse {\n    // Check Current State for Case 1 and Case 2\n    if (currentState === \"EXCEPTION_CATEGORIES\") {\n        response = \"I can only show you exception types for one valid category at a time. Enter the number or name of one valid exception category to see a summary of exception types.\";\n    } \n    else if (currentState === \"EXCEPTION_TYPES\") {\n        response = \"I can only show you exception details for one valid type at a time. Enter the number or name of one valid exception type to see a summary of exception details.\";\n    } \n    else {\n        // Fallback in case state is neither, but ambiguousText was provided\n        response = ambiguousText || \"Please ensure you are using the correct identifiers and try again.\";\n    }\n}\n\n// 3. Final Output\nreturn response;"
          },
