          },
          "code": "PRJ_PJC_BUSINESS_OBJECT_FUNCTION_MESSAGE_KEY_VALUE_EXTRACTION",
          "id": "1771310921339",
          "inputs": [
            {
              "id": "1773122013348_1",
              "name": "deploymentId",
              "type": "string",
              "value": "{{$context.$nodes.PRJ_PJC_CODE_EXTRACT_DEPLOYMENT_ID.$output.result}}"
            },
            {
              "id": "1773122013349_2",
              "name": "locale",
              "type": "string",
              "value": "en"
            },
            {
              "id": "1773122013350_3",
              "name": "bundleId",
              "type": "string",
              "value": "build/model/modules/oraErpCoreProjectCostTransactions/resources/translations/oraErpCoreProjectCostTransactionsRBundle-i18n.json"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"title\": \"Translation Bundle Schema\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"bundle\": {\n      \"type\": \"string\",\n      \"description\": \"Path to the resource bundle file.\"\n    },\n    \"locale\": {\n      \"type\": \"string\",\n      \"description\": \"Language code (e.g., 'en').\"\n    },\n    \"strings\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"patternProperties\": {\n          \"^@@\": { \"type\": \"string\" },\n          \"^@\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"description\": { \"type\": \"string\" },\n              \"x-StrId\": { \"type\": \"string\" },\n              \"x-StrType\": { \"type\": \"string\" },\n              \"x-StrStatus\": { \"type\": \"string\" },\n              \"x-SRKey\": { \"type\": \"string\" }\n            },\n            \"required\": [\"description\", \"x-StrId\", \"x-StrType\", \"x-SRKey\"]\n          },\n          \"^[A-Za-z]\": { \"type\": \"string\" }\n        }\n      }\n    }\n  },\n  \"required\": [\"bundle\", \"locale\", \"strings\"]\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Convert Messagebundle To Message Text JSON",
            "returnType": "object",
            "sourceCode": "// 1. Data Assignment\nvar sourceData = $context.$nodes.PRJ_PJC_BUSINESS_OBJECT_FUNCTION_MESSAGE_KEY_VALUE_EXTRACTION.$output;\n\n// 2. Setup Results\nvar outputMessages = [];\n\n// 3. Logic Block\nif (sourceData && Array.isArray(sourceData.strings)) {\n    for (var i = 0; i < sourceData.strings.length; i++) {\n        var stringBlock = sourceData.strings[i];\n        var keys = Object.keys(stringBlock);\n\n        for (var j = 0; j < keys.length; j++) {\n            var key = keys[j];\n            var value = stringBlock[key];\n\n            // Filter Criteria:\n            // 1. Key must start with a letter (A-Za-z)\n            // 2. Key must NOT start with @ or @@\n            // 3. Key must NOT start with \"ColAttr\"\n            // 4. Value must be a string\n            if (/^[A-Za-z]/.test(key) && \n                key.indexOf(\"ColAttr\") !== 0 && \n                typeof value === 'string') {\n                \n                outputMessages.push({\n                    \"MessageTextKey\": key,\n                    \"MessageText\": value\n                });\n            }\n        }\n    }\n}\n\n// 4. Final Structured Output\nvar result = {\n    \"messages\": outputMessages\n};\n\nreturn JSON.stringify(result);"
          },
          "outcomes": {
            "success": "1769947186069"
          },
          "code": "PRJ_PJC_CODE_CONVERT_MESSAGEBUNDLE_TO_MESSAGE_TEXT_JSON",
          "id": "1771312283428",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
