            "sourceCode": "var raw = $context.$nodes.PRJ_PJC_LOOP_PREPARE_EXCEPTION_DETAILS_SUMMARY.$output;\n\nvar sum = {\n  ExceptionDetails: [],\n  ResolutionOptions: ''\n};\n\nif (Array.isArray(raw) && raw.length > 0) {\n  try {\n    sum = typeof raw[0] === 'string' ? JSON.parse(raw[0]) : raw[0];\n  } catch (e) {\n    sum = {\n      ExceptionDetails: [],\n      ResolutionOptions: ''\n    };\n  }\n} else if (typeof raw === 'string') {\n  try {\n    sum = JSON.parse(raw);\n  } catch (e) {\n    sum = {\n      ExceptionDetails: [],\n      ResolutionOptions: ''\n    };\n  }\n} else if (raw && typeof raw === 'object') {\n  sum = raw;\n}\n\nif (!sum || typeof sum !== 'object') {\n  sum = {\n    ExceptionDetails: [],\n    ResolutionOptions: ''\n  };\n}\n\nvar tv = $context.$variables.prjPjcVarConvUserExceptionType;\nvar typ = 'Unknown Exception Type';\n\ntry {\n  var to = typeof tv === 'string' ? JSON.parse(tv) : tv;\n\n  typ = String(\n    to.ExceptionTypeName ||\n    (\n      to.UserEnteredType &&\n      to.UserEnteredType[0] &&\n      to.UserEnteredType[0].ExceptionTypeName\n    ) ||\n    'Unknown Exception Type'\n  );\n} catch (e) {\n  typ = 'Unknown Exception Type';\n}\n\nvar f = $context.$variables.prjPjcVarConvFilter || {};\n\nvar fs = Array.isArray(f.Filter)\n  ? f.Filter\n  : (f.Filter ? [f.Filter] : []);\n\nvar a = $context.$variables.prjPjcVarConvCreationDateDaysRange;\nvar b = $context.$variables.prjPjcVarConvProjectCostDateDaysRange;\nvar c = $context.$variables.prjPjcVarConvProjectAccountingDateDaysRange;\n\nvar crit = [];\nvar rows = [];\nvar opts = [];\nvar t = 0;\n\nvar list = Array.isArray(sum.ExceptionDetails) ? sum.ExceptionDetails : [];\nvar m = list.length > 20 ? 20 : list.length;\n\nvar fieldByLabel = {};\nvar usedFields = {};\nvar detailColumns = [];\n\nfunction cleanLabel(s) {\n  return String(s || '')\n    .replace(/<[^>]*>/g, '')\n    .replace(/\\*\\*/g, '')\n    .replace(/[{}.,]/g, '')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nfunction cleanValue(s) {\n  return String(s || '')\n    .replace(/<[^>]*>/g, '')\n    .replace(/\\*\\*/g, '')\n    .replace(/[{}]/g, '')\n    .replace(/Unprocessed Project Cost Transaction Id/g, 'Unprocessed Transaction Reference')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nfunction makeFieldName(label) {\n  var base = cleanLabel(label)\n    .replace(/[^A-Za-z0-9]+/g, '_')\n    .replace(/^_+|_+$/g, '')\n    .toLowerCase();\n\n  if (!base) {\n    base = 'attribute';\n  }\n\n  return 'attr_' + base;\n}\n\nfunction getFieldForLabel(label) {\n  var header = cleanLabel(label);\n\n  if (!header) {\n    header = 'Attribute';\n  }\n\n  var labelKey = header.toLowerCase();\n\n  if (fieldByLabel[labelKey]) {\n    return fieldByLabel[labelKey];\n  }\n\n  var base = makeFieldName(header);\n  var field = base;\n  var seq = 2;\n\n  while (usedFields[field]) {\n    field = base + '_' + seq;\n    seq++;\n  }\n\n  usedFields[field] = true;\n  fieldByLabel[labelKey] = field;\n\n  detailColumns.push({\n    headerText: header,\n    field: field,\n    id: field,\n    resizable: 'enabled',\n    className: '',\n    template: ''\n  });\n\n  return field;\n}\n\nfunction parseSummarizedRow(text) {\n  var s = String(text || '')\n    .replace(/<[^>]*>/g, '')\n    .replace(/Unprocessed Project Cost Transaction Id/g, 'Unprocessed Transaction Reference')\n    .replace(/\\r?\\n/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n\n  var re = /(^|,\\s*)\\*{0,2}\\s*([^,:*][^:,]*?)\\s*\\*{0,2}\\s*:/g;\n  var hits = [];\n  var match;\n\n  while ((match = re.exec(s)) !== null) {\n    var key = cleanLabel(match[2]);\n\n    if (key) {\n      hits.push({\n        key: key,\n        itemStart: match.index,\n        valueStart: re.lastIndex\n      });\n    }\n  }\n\n  var pairs = [];\n\n  if (!hits.length) {\n    pairs.push({\n      key: 'Exception Details',\n      value: cleanValue(s || 'Not available')\n    });\n\n    return pairs;\n  }\n\n  for (var i = 0; i < hits.length; i++) {\n    var end = (i + 1 < hits.length) ? hits[i + 1].itemStart : s.length;\n\n    var value = s.slice(hits[i].valueStart, end)\n      .replace(/^\\s*,\\s*/, '')\n      .replace(/\\s*,\\s*$/, '');\n\n    pairs.push({\n      key: hits[i].key,\n      value: cleanValue(value || 'Not available')\n    });\n  }\n\n  return pairs;\n}\n\nfor (var i = 0; i < fs.length; i++) {\n  var x = fs[i] || {};\n  var k = String(x.AttributeName || '').toLowerCase();\n  var v = x.AttributeValue;\n\n  if (k.indexOf('creationdate') !== -1 && a) {\n    v = a;\n  } else if (k.indexOf('transactiondate') !== -1 && b) {\n    v = b;\n  } else if (k.indexOf('projectaccountingdate') !== -1 && c) {\n    v = c;\n  }\n\n  if (v !== null && v !== undefined && String(v).trim() !== '') {\n    crit.push(\n      (x.DisplayLabel || 'Filter') +\n      ': ' +\n      String(v).replace(/^['\"]|['\"]$/g, '')\n    );\n  }\n}\n\ncrit.push('Exception Type: ' + typ);\n\nfor (var j = 0; j < list.length; j++) {\n  var cnt1 = parseInt(list[j].Count, 10);\n\n  if (!isNaN(cnt1)) {\n    t += cnt1;\n  }\n}\n\nfor (var n = 0; n < m; n++) {\n  var y = list[n] || {};\n  var cnt = parseInt(y.Count, 10);\n\n  if (isNaN(cnt)) {\n    cnt = 0;\n  }\n\n  var row = {\n    no: String(n + 1),\n    count: String(cnt)\n  };\n\n  var pairs = parseSummarizedRow(y.SummarizedRow || 'Not available');\n\n  for (var q = 0; q < pairs.length; q++) {\n    var field = getFieldForLabel(pairs[q].key);\n    row[field] = pairs[q].value;\n  }\n\n  rows.push(row);\n}\n\nfor (var rr = 0; rr < rows.length; rr++) {\n  for (var cc = 0; cc < detailColumns.length; cc++) {\n    var colField = detailColumns[cc].field;\n\n    if (rows[rr][colField] === undefined) {\n      rows[rr][colField] = '';\n    }\n  }\n}\n\nvar ro = String(sum.ResolutionOptions || '').split(',');\n\nfor (var p = 0; p < ro.length; p++) {\n  var z = String(ro[p] || '').trim();\n\n  if (z) {\n    opts.push({\n      id: String(p + 1),\n      Default: z,\n      value: z\n    });\n  }\n}\n\nvar dt = String($context.$system.$currentDateTime || '');\n\nvar ts = dt\n  ? dt.slice(8, 10) + '-' +\n    dt.slice(5, 7) + '-' +\n    dt.slice(0, 4) + ' ' +\n    dt.slice(11, 16)\n  : String($context.$system.$currentDate || '');\n\nvar filterSuffix = crit.length\n  ? ' Filters applied: ' + crit.join('; ') + '.'\n  : '';\n\nvar resp = [\n  {\n    display_type: 'text',\n    display_sequence: 1,\n    text: rows.length\n      ? 'Found ' + t + ' exceptions for ' + typ + '.' +\n        filterSuffix +\n        (list.length > 20 ? ' Showing the first 20 rows only.' : '')\n      : 'No exception details were found for ' + typ + '.' + filterSuffix\n  }\n];\n\nif (rows.length) {\n  var tableColumns = [\n    {\n      headerText: 'No.',\n      field: 'no',\n      id: 'no',\n      resizable: 'enabled',\n      className: '',\n      template: ''\n    }\n  ];\n\n  for (var dc = 0; dc < detailColumns.length; dc++) {\n    tableColumns.push(detailColumns[dc]);\n  }\n\n  tableColumns.push({\n    headerText: 'Count',\n    field: 'count',\n    id: 'count',\n    resizable: 'enabled',\n    className: '',\n    template: ''\n  });\n\n  resp.push({\n    display_type: 'table',\n    heading: 'Exception Details',\n    display_sequence: 2,\n    rows: {\n      items: rows\n    },\n    columns: {\n      items: tableColumns\n    },\n    keyAttributes: {\n      items: ['no']\n    },\n    accessibility: {\n      'aria-label': 'Project cost exception details',\n      'row.accessible-row-header': 'no'\n    }\n  });\n}\n\nif (opts.length) {\n  resp.push({\n    display_type: 'list',\n    display_sequence: resp.length + 1,\n    header: 'Possible resolution options',\n    fields: {\n      items: opts\n    },\n    selection_mode: 'none',\n    keyAttributes: {\n      items: ['id']\n    },\n    accessibility: {\n      'aria-label': 'Resolution options'\n    }\n  });\n}\n\nresp.push({\n  display_type: 'action',\n  display_sequence: resp.length + 1,\n  actions: {\n    items: ['Exception Types', 'Exception Categories']\n  }\n});\n\nvar intent = 'EXCEPTION_DETAILS';\n\nvar o = {\n  agent: ($context.$workflow && $context.$workflow.$code) ||\n    'ORA_PRJ_PJC_PROJECT_COST_EXCEPTION_ASSISTANT_TEAM',\n  intent: intent,\n  schema_version: '1',\n  title: 'Project Cost Exception Details',\n  description: 'Detailed exception summary for the selected exception type.',\n  timestamp: ts,\n  agent_response: resp,\n  atomicAgentDetails: (function () {\n    var filters = [];\n    var allFilters = [];\n    var oldCat = null;\n    var oldType = null;\n\n    var parts = crit.length ? crit : [];\n\n    for (var j = 0; j < parts.length; j++) {\n      var part = parts[j] || '';\n      var idx = part.indexOf(':');\n\n      var label = idx > -1 ? part.slice(0, idx).trim() : '';\n      var value = idx > -1 ? part.slice(idx + 1).trim() : '';\n      var key = label.toLowerCase().replace(/\\s+/g, '');\n\n      if (label && value) {\n        allFilters.push(label + ':' + value);\n      }\n\n      if (key === 'exceptioncategory') {\n        oldCat = value || null;\n      } else if (key === 'exceptiontype') {\n        oldType = value || null;\n      } else if (label && value) {\n        filters.push(label + ':' + value);\n      }\n    }\n\n    return {\n      atomicAgentCode: (($context.$workflow && $context.$workflow.$code) ||\n        'ORA_PRJ_PJC_PROJECT_COST_EXCEPTION_ASSISTANT_TEAM_RITO_V2'),\n      filters: filters.length\n        ? filters.join(', ')\n        : (allFilters.length ? allFilters.join(', ') : ''),\n      contextDetails: {\n        \"Old Exception Category Name\": oldCat || null,\n        \"Old Exception Type Name\": oldType || null\n      },\n      atomicAgentContext: intent\n    };\n  })()\n};\n\nreturn JSON.stringify(o);"
