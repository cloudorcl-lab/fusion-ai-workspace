        {
          "metadata": {
            "name": "Agent Capability Display Text",
            "returnType": "string",
            "sourceCode": "const html = \"<span>Hi. I'm the Project Cost Exceptions Assistant.</span><br><br><span>I can help you identify and analyze unprocessed project cost exceptions.</span><br><br><span>I will list possible resolution options for each type of exception, but please note that I can't currently execute any corrective actions at this time.</span><br><br><span>Note that unless you request otherwise, I only query exceptions created in the last 90 days.</span><br><br><span>I can search on all exceptions or you can let me know which exceptions you're interested in. For example, exceptions for a particular business unit, transaction source, exception type, transaction date range, etc.</span><br><br><span>When specifying filter criteria, be sure to include the object name in addition to the value so that I know where to search.  For example, \\\"Show me the exceptions for <b>project</b> 12345\\\" or \\\"Get exceptions for <b>business unit</b> Vision Operations\\\".</span><br><br><span>Note that non-date attributes are searched using a case sensitive, partial match.  For example, \\\"Show exceptions for project <b>Abc</b>\\\" would match projects <b>Abc</b>, <b>Abcd</b>, and <b>PAbc</b>, but it wouldn't match project <b>abc</b>.</span>\";\n\nreturn html;"
          },
          "outcomes": {
            "success": "1775401831389"
          },
          "code": "PRJ_PJC_CODE_AGENT_CAPABILITY_DISPLAY_TEXT",
          "id": "1775401782562",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
