                  "id": "1774615929397",
                  "inputs": [
                    {
                      "id": "1774615955039_1",
                      "name": "payload",
                      "type": "string",
                      "value": "{{$context.$nodes.PRJ_PJC_LOOP_ADDITIONAL_KEY_ATTRIBUTES_QUERY.PRJ_PJC_CODE_EXTRACT_PERSON_DETAILS_PAYLOAD.$output.result}}"
                    }
                  ],
                  "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"id\": {\n            \"type\": \"number\"\n        },\n        \"assignmentNumber\": {\n            \"type\": \"string\"\n        },\n        \"displayName\": {\n            \"type\": \"string\"\n        },\n        \"personNumber\": {\n            \"type\": \"string\"\n        }\n    }\n}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "Create JSON Output",
                    "returnType": "object",
                    "sourceCode": "// 1. Access the output directly (it is likely already an object)\nconst data = $context.$nodes.PRJ_PJC_LOOP_ADDITIONAL_KEY_ATTRIBUTES_QUERY.PRJ_PJC_BUSINESS_OBJECT_FUNCTION_GET_PERSON_INFO_DATA.$output;\n\n// 2. Access the first item in the main array\n// We add a check for data.items to ensure the node actually returned data\nconst worker = data && data.items ? data.items[0] : null;\n\nif (!worker) {\n  return { error: \"No worker data found\" };\n}\n\n// 3. Extract the specific nested fields\nconst extracted = {\n  personId: worker.id,\n  personNumber: worker.personDetail?.personNumber,\n  worker: worker.names?.items?.[0]?.displayName,\n  assignmentNumber: worker.workRelationships?.items?.[0]?.assignments?.items?.[0]?.assignmentNumber\n};\n\nreturn extracted;"
                  },
                  "outcomes": {
