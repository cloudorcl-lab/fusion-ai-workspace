          "metadata": {
            "name": "Message Text Key Clause",
            "returnType": "string",
            "sourceCode": "// 1. Data Assignment\nvar rawInput = $context.$variables.prjPjcVarConvExceptionDetails; \n\n// Normalize: If it's a single object, wrap it in an array so the loop works\nvar items = [];\nif (rawInput) {\n    if (Array.isArray(rawInput)) {\n        items = rawInput;\n    } else {\n        items = [rawInput];\n    }\n}\n\nvar keys = [];\n\n// 2. Parse and Extract MessageTextKey\nfor (var i = 0; i < items.length; i++) {\n    try {\n        var record = typeof items[i] === 'string' ? JSON.parse(items[i]) : items[i];\n        \n        var key = record.MessageTextKey;\n\n        if (key) {\n            keys.push(\"'\" + key + \"'\");\n        }\n    } catch (e) {\n        continue;\n    }\n}\n\n// 3. Join and Format\nvar finalMessageText = \"\";\n\nif (keys.length > 0) {\n    finalMessageText = \"(\" + keys.join(\",\") + \")\";\n} else {\n    finalMessageText = \"('')\"; \n}\n\n// 4. Final Output\nreturn finalMessageText;"
          },
