        {
          "metadata": {
            "name": "Exception Type Table 1"
          },
          "outcomes": {},
          "code": "PRJ_PJC_RETURN_EXCEPTION_TYPE_TABLE_1",
          "convergenceTargetId": "end",
          "id": "1769951279882",
          "inputs": [
            {
              "id": "1775325745056_2",
              "name": "returnValue",
              "type": "string",
              "value": "{{$context.$nodes.PRJ_PJC_CODE_CHECK_SOURCE.$output.result == \"RedwoodUI\" ? $context.$nodes.PRJ_PJC_CODE_EXCEPTION_TYPE_GROUP_DISPLAY_JSONCODE_1.$output.result : $context.$nodes.PRJ_PJC_CODE_EXCEPTION_TYPE_GROUP_DISPLAY_HTMLCODE_1.$output.result}}"
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "name": "Exception Details Display HTML",
            "returnType": "string",
            "sourceCode": "// 1. Data Assignment & Date Variable Retrieval\nvar rawPrepareOutput = $context.$nodes.PRJ_PJC_LOOP_PREPARE_EXCEPTION_DETAILS_SUMMARY.$output;\nvar filterData = $context.$variables.prjPjcVarConvFilter;\n\n// Extract Exception Type Name\nvar exceptionTypeVar = $context.$variables.prjPjcVarConvUserExceptionType;\nvar exceptionTypeName = \"NULL\";\nif (exceptionTypeVar) {\n    var typeObj = (typeof exceptionTypeVar === \"string\") ? JSON.parse(exceptionTypeVar) : exceptionTypeVar;\n    exceptionTypeName = typeObj.ExceptionTypeName || \"NULL\";\n}\n\n// Directly read date ranges from variables\nvar creationDateRange = $context.$variables.prjPjcVarConvCreationDateDaysRange;\nvar projectCostDateRange = $context.$variables.prjPjcVarConvProjectCostDateDaysRange;\nvar projectAccountingDateRange = $context.$variables.prjPjcVarConvProjectAccountingDateDaysRange;\n\n// Deep link URL comes as string enclosed in quotes\nvar deepLinkRaw = $context.$nodes.PRJ_PJC_LLM_MUC_DEEP_LINK_URL.$output.deepLinkURL;\nvar manageUnprocessedCostsDeepLink = \"#\";\nif (typeof deepLinkRaw === \"string\" && deepLinkRaw.trim() !== \"\") {\n    manageUnprocessedCostsDeepLink = deepLinkRaw.trim().replace(/^\"(.*)\"$/, \"$1\");\n}\n\nvar ExceptionDetailsSummary = {\n    ExceptionDetails: [],\n    ResolutionOptions: \"\",\n    BoldWords: \"\"\n};\n\n// 2. Parse Input\nif (Array.isArray(rawPrepareOutput) && rawPrepareOutput.length > 0) {\n    try {\n        ExceptionDetailsSummary = JSON.parse(rawPrepareOutput[0]);\n    } catch (e) {\n        ExceptionDetailsSummary = { ExceptionDetails: [], ResolutionOptions: \"\", BoldWords: \"\" };\n    }\n}\n\n// 3. Extract Bold Words\nvar extractedBoldWords = [];\nif (ExceptionDetailsSummary.BoldWords) {\n    var boldParts = ExceptionDetailsSummary.BoldWords.split(\",\");\n    for (var bw = 0; bw < boldParts.length; bw++) {\n        var cleanedWord = boldParts[bw].replace(/\\*/g, \"\").trim();\n        if (cleanedWord.length > 0) {\n            extractedBoldWords.push(cleanedWord);\n        }\n    }\n}\n\n// Helper: escape regex special characters\nfunction escapeRegex(text) {\n    return String(text).replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n}\n\n// Helper: apply bolding only to key text\nfunction applyBoldWordsToKey(text, words) {\n    var result = String(text);\n    for (var i = 0; i < words.length; i++) {\n        var word = words[i];\n        if (!word) continue;\n        var regex = new RegExp(\"(\" + escapeRegex(word) + \")\", \"gi\");\n        result = result.replace(regex, '<span style=\"font-weight:700;\">$1</span>');\n    }\n    return result;\n}\n\n// 4. Process Filter Criteria\nvar filterDisplayLines = \"\";\nvar rawFilters = (filterData && filterData.Filter) ? filterData.Filter : [];\nvar filterList = Array.isArray(rawFilters) ? rawFilters : (rawFilters ? [rawFilters] : []);\n\nfor (var j = 0; j < filterList.length; j++) {\n    var filterItem = filterList[j];\n    if (filterItem) {\n        var label = filterItem.DisplayLabel || \"NULL\";\n        var attrName = (filterItem.AttributeName || \"\").toLowerCase();\n        var value = filterItem.AttributeValue || \"NULL\";\n        var displayValue = value;\n\n        if (attrName.indexOf(\"creationdate\") !== -1) {\n            displayValue = creationDateRange || value;\n        } else if (attrName.indexOf(\"transactiondate\") !== -1) {\n            displayValue = projectCostDateRange || value;\n        } else if (attrName.indexOf(\"projectaccountingdate\") !== -1) {\n            displayValue = projectAccountingDateRange || value;\n        }\n\n        if (displayValue !== null && displayValue !== undefined) {\n            displayValue = String(displayValue).trim().replace(/^'(.*)'$/, \"$1\").replace(/^\"(.*)\"$/, \"$1\");\n        } else {\n            displayValue = \"NULL\";\n        }\n\n        filterDisplayLines +=\n            \"<tr>\" +\n                '<td style=\"padding:2px 12px 2px 0; vertical-align:top; white-space:nowrap;\">' + label + \":</td>\" +\n                '<td style=\"padding:2px 0; vertical-align:top;\">' + displayValue + \"</td>\" +\n            \"</tr>\";\n    }\n}\n\n// 5. Build Table Rows\nvar totalExceptionCount = 0;\nvar tableRowsHtml = \"\";\nvar details = ExceptionDetailsSummary.ExceptionDetails || [];\nvar hasData = details && details.length > 0;\n\n// Compute total across ALL rows\nfor (var t = 0; t < details.length; t++) {\n    totalExceptionCount += parseInt(details[t].Count, 10) || 0;\n}\n\n// Limit display to 20 rows only\nvar maxRowsToDisplay = 20;\nvar displayedDetails = hasData ? details.slice(0, maxRowsToDisplay) : [];\nvar hasMoreThan20Rows = details.length > maxRowsToDisplay;\n\n// Build HTML only for first 20 rows\nif (hasData) {\n    for (var i = 0; i < displayedDetails.length; i++) {\n        var row = displayedDetails[i];\n        var rowCount = parseInt(row.Count, 10) || 0;\n\n        var detailsContent = \"\";\n        var rowText = row.SummarizedRow || \"\";\n\n        // Parse SummarizedRow\n        var rawPairs = rowText.split(\", \");\n        for (var p = 0; p < rawPairs.length; p++) {\n            var part = rawPairs[p];\n            var colonIndex = part.indexOf(\":\");\n            if (colonIndex === -1) continue;\n\n            var key = part.substring(0, colonIndex).replace(/\\*/g, \"\").trim();\n            var valueText = part.substring(colonIndex + 1).replace(/\\*/g, \"\").trim();\n\n            if (key === \"\") continue;\n\n            // Rename key if it appears in the summarized text\n            if (key === \"Unprocessed Project Cost Transaction Id\") {\n                key = \"Unprocessed Transaction Reference\";\n            }\n\n            // Bold only the KEY, not the VALUE\n            var keySpan = '<span style=\"font-weight:700;\">' + key + \"</span>\";\n            keySpan = applyBoldWordsToKey(keySpan, extractedBoldWords);\n\n            detailsContent += keySpan + \": \" + valueText + \"<br/>\";\n        }\n\n        // If txn id exists on the row object, show it even when not in SummarizedRow\n        var txnId = row[\"Unprocessed Project Cost Transaction Id\"];\n        if (!txnId) {\n            txnId = row[\"unprocessedProjectCostTransactionId\"];\n        }\n\n        if (txnId) {\n            detailsContent +=\n                '<span style=\"font-weight:700;\">Unprocessed Transaction Reference</span>: ' +\n                String(txnId).trim() +\n                \"<br/>\";\n        }\n\n        tableRowsHtml +=\n            \"<tr>\" +\n                '<td style=\"padding:8px 10px; border:1px solid #E4E1DD; text-align:center;\">' + (i + 1) + \"</td>\" +\n                '<td style=\"padding:8px 10px; border:1px solid #E4E1DD; white-space:normal; overflow-wrap:anywhere;\">' + detailsContent + \"</td>\" +\n                '<td style=\"padding:8px 10px; border:1px solid #E4E1DD; text-align:right;\">' + rowCount + \"</td>\" +\n            \"</tr>\";\n    }\n}\n\n// 6. Final Assembly\nvar headerBlock =\n'<div style=\"font-family:\\'Oracle Sans\\', Arial, sans-serif; font-size:13; color:#000000; margin-top:10px;\">' +\n    \"I've found <b>\" + totalExceptionCount + \"</b> exceptions using this criteria:<br/>\" +\n    '<table style=\"margin-top:6px; border-collapse:collapse; font-family:\\'Oracle Sans\\', Arial, sans-serif; font-size:13; color:#000000;\">' +\n        \"<tbody>\" +\n            filterDisplayLines +\n            \"<tr>\" +\n                '<td style=\"padding:2px 12px 2px 0; vertical-align:top; white-space:nowrap;\">Exception Type:</td>' +\n                '<td style=\"padding:2px 0; vertical-align:top;\">' + exceptionTypeName + \"</td>\" +\n            \"</tr>\" +\n        \"</tbody>\" +\n    \"</table>\" +\n\"</div>\";\n\nvar mainContent = \"\";\n\nif (hasData) {\n    var tableBlock =\n    '<div style=\"max-height:400px; overflow-y:auto; border:1px solid #E4E1DD; margin-top:12px;\">' +\n        '<table style=\"width:100%; border-collapse:collapse; font-family:\\'Oracle Sans\\', Arial, sans-serif; font-size:12; color:#000000; table-layout:fixed;\">' +\n            '<colgroup><col style=\"width:10%;\"><col style=\"width:75%;\"><col style=\"width:15%;\"></colgroup>' +\n            '<thead style=\"position:sticky; top:0; z-index:1;\">' +\n                '<tr style=\"background:#ffffff; color:#000000; text-align:left; font-weight:800;\">' +\n                    '<th style=\"padding:8px 10px; border:1px solid #E4E1DD; text-align:center;\">No.</th>' +\n                    '<th style=\"padding:8px 10px; border:1px solid #E4E1DD;\">Exception Details</th>' +\n                    '<th style=\"padding:8px 10px; border:1px solid #E4E1DD; text-align:right;\">Count</th>' +\n                \"</tr>\" +\n            \"</thead>\" +\n            \"<tbody>\" + tableRowsHtml + \"</tbody>\" +\n        \"</table>\" +\n    \"</div>\";\n\n    var moreDataMessage = \"\";\n    if (hasMoreThan20Rows) {\n        moreDataMessage =\n            '<div style=\"font-family:\\'Oracle Sans\\', Arial, sans-serif; font-size:13; color:#000000; margin:10px 0 0 0;\">' +\n                'There are more than 20 exception detail records for the exception type matching your search criteria. I can only display 20 records.<br/><br/>' +\n                'Revise your search criteria or query the exceptions in the <a href=\"' + manageUnprocessedCostsDeepLink + '\" style=\"font-weight:700;\">Manage Unprocessed Costs</a> page.' +\n            \"</div>\";\n    }\n\n    var resOptionsRaw = ExceptionDetailsSummary.ResolutionOptions ? ExceptionDetailsSummary.ResolutionOptions.split(\",\") : [];\n    var resOptionsListHtml = \"\";\n\n    if (resOptionsRaw.length > 0) {\n        for (var r = 0; r < resOptionsRaw.length; r++) {\n            resOptionsListHtml += \"<li>\" + resOptionsRaw[r].trim() + \"</li>\";\n        }\n    } else {\n        resOptionsListHtml = \"<li>NULL</li>\";\n    }\n\n    var resolutionBlock =\n    '<div style=\"font-family:\\'Oracle Sans\\', Arial, sans-serif; font-size:13; margin-top:10px;\">' +\n        \"Possible resolution options for this exception type are:\" +\n        \"<ul>\" + resOptionsListHtml + \"</ul>\" +\n    \"</div>\";\n\n    var footerBlock =\n    '<div style=\"font-family:\\'Oracle Sans\\', Arial, sans-serif; font-size:13; color:#000000; margin-top:10px;\">' +\n        \" Enter one of the following:\" +\n        '<ul style=\"margin-top:5px;\">' +\n            \"<li><b>Exception Types</b>, to return to the summarization of exceptions by type.</li>\" +\n            \"<li><b>Exception Categories</b>, to return to the summarization of exceptions by category.</li>\" +\n            \"<li><b>Start Over</b>, to initiate a new query.</li>\" +\n        \"</ul>\" +\n    \"</div>\";\n\n    mainContent = tableBlock + moreDataMessage + resolutionBlock + footerBlock;\n} else {\n    mainContent =\n        '<div style=\"font-family:\\'Oracle Sans\\', Arial, sans-serif; font-size:13; margin-top:10px;\">' +\n        'Revise your filter criteria or enter <b>\"Get all exceptions\"</b> to initiate another query.' +\n        \"</div>\";\n}\n\nreturn headerBlock + mainContent;"
          },
          "outcomes": {
            "success": "1775394185667"
          },
          "code": "PRJ_PJC_CODE_EXCEPTION_DETAILS_DISPLAY_HTML",
