        {
          "metadata": {
            "name": "Create Filter String",
            "returnType": "string",
            "sourceCode": "// 1. Data Assignment\nvar filterData = $context.$variables.prjPjcVarConvFilter;\nvar mappingData = $context.$variables.prjPjcVarConvDisplaytoAttributeMap;\n\nvar filters = (filterData && Array.isArray(filterData.Filter)) ? filterData.Filter : [];\nvar mappingList = (mappingData && Array.isArray(mappingData.DisplaytoAttributeMap)) ? mappingData.DisplaytoAttributeMap : [];\n\nvar filterSegments = [];\nvar allValid = true;\n\n// Helper: normalize date like 6-1-2026 -> 06-01-2026\nfunction normalizeDate(dateStr) {\n    var parts = dateStr.split(\"-\");\n    if (parts.length !== 3) return null;\n\n    var day = parts[0].trim();\n    var month = parts[1].trim();\n    var year = parts[2].trim();\n\n    if (!day || !month || !year) return null;\n\n    if (day.length === 1) day = \"0\" + day;\n    if (month.length === 1) month = \"0\" + month;\n\n    return day + \"-\" + month + \"-\" + year;\n}\n\n// 2. Process each filter\nfor (var i = 0; i < filters.length; i++) {\n    var rawAttr = (filters[i].AttributeName || \"\").trim();\n    var attrVal = (filters[i].AttributeValue || \"\").trim();\n\n    if (rawAttr && attrVal) {\n        var foundMapping = false;\n        var finalAttrName = \"\";\n\n        // 3. Mapping Logic\n        for (var j = 0; j < mappingList.length; j++) {\n            var mapItem = mappingList[j] || {};\n            var displayValue = (mapItem.DisplayValue || \"\").toLowerCase().trim();\n            var attributeName = (mapItem.AttributeName || \"\").toLowerCase().trim();\n            var compareRawAttr = rawAttr.toLowerCase().trim();\n\n            if (displayValue === compareRawAttr || attributeName === compareRawAttr) {\n                finalAttrName = mapItem.AttributeName;\n                foundMapping = true;\n                break;\n            }\n        }\n\n        if (!foundMapping) {\n            finalAttrName = rawAttr;\n            foundMapping = true;\n        }\n\n        // 4. Special Handling Logic\n        if (foundMapping) {\n            var isDateAttr = finalAttrName.toLowerCase().endsWith(\"date\");\n\n            if (isDateAttr) {\n                // --- UPDATED DATE LOGIC WITH TRUNC ---\n                var cleanVal = attrVal.replace(/^'|'$/g, \"\").trim();\n                var betweenMatch = cleanVal.match(/^BETWEEN\\s+(\\d{1,2}-\\d{1,2}-\\d{4})\\s+and\\s+(\\d{1,2}-\\d{1,2}-\\d{4})$/i);\n\n                if (betweenMatch) {\n                    var startDate = normalizeDate(betweenMatch[1]);\n                    var endDate = normalizeDate(betweenMatch[2]);\n\n                    if (startDate && endDate) {\n                        // Added TRUNC() around the column name\n                        filterSegments.push(\n                            \"TRUNC(\" + finalAttrName + \")\" +\n                            \" BETWEEN TO_DATE('\" + startDate + \"', 'DD-MM-YYYY') AND TO_DATE('\" + endDate + \"', 'DD-MM-YYYY')\"\n                        );\n                    } else {\n                        allValid = false;\n                        break;\n                    }\n                } else {\n                    allValid = false;\n                    break;\n                }\n\n            } else {\n                // --- NON-DATE LOGIC (LIKE Syntax) ---\n                var values = attrVal.replace(/'/g, \"\").split(\",\").map(function(v) {\n                    return v.trim();\n                }).filter(function(v) {\n                    return v !== \"\";\n                });\n\n                var targetAttributes = finalAttrName.split(\",\").map(function(a) {\n                    return a.trim();\n                }).filter(function(a) {\n                    return a !== \"\";\n                });\n\n                var attributeConditionGroup = [];\n                for (var a = 0; a < targetAttributes.length; a++) {\n                    var attr = targetAttributes[a];\n                    var valueConditionGroup = [];\n                    for (var b = 0; b < values.length; b++) {\n                        valueConditionGroup.push(attr + \" like '%\" + values[b] + \"%'\");\n                    }\n                    if (valueConditionGroup.length > 1) {\n                        attributeConditionGroup.push(\"(\" + valueConditionGroup.join(\" OR \") + \")\");\n                    } else if (valueConditionGroup.length === 1) {\n                        attributeConditionGroup.push(valueConditionGroup[0]);\n                    }\n                }\n\n                if (attributeConditionGroup.length > 1) {\n                    filterSegments.push(\"(\" + attributeConditionGroup.join(\" OR \") + \")\");\n                } else if (attributeConditionGroup.length === 1) {\n                    filterSegments.push(attributeConditionGroup[0]);\n                } else {\n                    allValid = false;\n                    break;\n                }\n            }\n        } else {\n            allValid = false;\n            break;\n        }\n    }\n}\n\n// 5. Final Output Logic\nvar finalResult = \"1=1\";\nif (allValid && filterSegments.length > 0) {\n    finalResult = filterSegments.join(\" and \");\n}\n\n// 6. Post-Processing: Replace fundingSourceName\nif (finalResult.indexOf(\"fundingSourceName\") !== -1) {\n    var decodeExpression = \"DECODE(fundingSourceType, 'S', customername, 'O', organizationname, 'N', name)\";\n    finalResult = finalResult.replace(/fundingSourceName/g, decodeExpression);\n}\n\nreturn finalResult;"
          },
          "outcomes": {
            "success": "1773851903173"
          },
          "code": "PRJ_PJC_CODE_CREATE_FILTER_STRING",
          "convergenceTargetId": "1772640384196",
          "id": "1770902723183",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Return Creation Date Range",
            "returnType": "string",
            "sourceCode": "// 1. Data Assignment\nvar filterString = $context.$nodes.PRJ_PJC_CODE_CREATE_FILTER_STRING.$output.result || \"\";\n\n// 2. Extraction Logic\n// Updated regex to handle TRUNC(creationDate) or creationDate\n// \\s* matches optional whitespace inside and outside parentheses\nvar regex = /(?:TRUNC\\s*\\(\\s*)?creationDate(?:\\s*\\))?\\s+BETWEEN\\s+TO_DATE\\('(\\d{2}-\\d{2}-\\d{4})',\\s*'DD-MM-YYYY'\\)\\s+AND\\s+TO_DATE\\('(\\d{2}-\\d{2}-\\d{4})',\\s*'DD-MM-YYYY'\\)/i;\n\nvar match = filterString.match(regex);\nvar creationDateRange = null;\n\nif (match) {\n    // match[1] is the first date, match[2] is the second date\n    var startDate = match[1];\n    var endDate = match[2];\n    creationDateRange = startDate + \" - \" + endDate;\n}\n\n// 3. Final Output Logic\nvar result = {\n    \"extractedCreationDateRange\": creationDateRange\n};\n\nreturn JSON.stringify(result);"
          },
          "outcomes": {
            "success": "1773852022549"
          },
          "code": "PRJ_PJC_CODE_RETURN_CREATION_DATE_RANGE",
