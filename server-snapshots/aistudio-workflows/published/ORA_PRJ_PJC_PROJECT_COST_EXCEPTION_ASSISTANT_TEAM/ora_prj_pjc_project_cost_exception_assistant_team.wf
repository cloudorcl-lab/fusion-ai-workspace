        {
          "metadata": {
            "name": "Return Project Cost Date Range",
            "returnType": "string",
            "sourceCode": "// 1. Data Assignment\nvar filterString = $context.$nodes.PRJ_PJC_CODE_CREATE_FILTER_STRING.$output.result || \"\";\n\n// 2. Extraction Logic\n// Updated regex to handle TRUNC(transactionDate) or transactionDate\n// \\s* matches optional whitespace inside and outside parentheses\nvar regex = /(?:TRUNC\\s*\\(\\s*)?transactionDate(?:\\s*\\))?\\s+BETWEEN\\s+TO_DATE\\('(\\d{2}-\\d{2}-\\d{4})',\\s*'DD-MM-YYYY'\\)\\s+AND\\s+TO_DATE\\('(\\d{2}-\\d{2}-\\d{4})',\\s*'DD-MM-YYYY'\\)/i;\n\nvar match = filterString.match(regex);\nvar ProjectCostDateRange = null;\n\nif (match) {\n    // match[1] is the first date, match[2] is the second date\n    var startDate = match[1];\n    var endDate = match[2];\n    ProjectCostDateRange = startDate + \" - \" + endDate;\n}\n\n// 3. Final Output Logic\nvar result = {\n    \"extractedProjectCostDateRange\": ProjectCostDateRange\n};\n\nreturn JSON.stringify(result);"
          },
