          "code": "PRJ_PJC_SET_VARIABLE_SET_REFRESHED_DATA",
          "convergenceTargetId": "1772640384196",
          "id": "1770906451983",
          "inputs": [
            {
              "id": "1770906464623",
              "name": "prjPjcVarConvSummarizedData",
              "scope": "JOB",
              "type": "array",
              "value": "{{$context.$nodes.PRJ_PJC_BUSINESS_OBJECT_FUNCTION_REFRESH_EXCEPTION_DATA.$output}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Extract Key Information",
            "returnType": "object",
            "sourceCode": "// 1. Data Assignment & Fallbacks\nvar exceptionCategoryJson = $context.$variables.prjPjcVarConvMessageRAG;\nvar exceptionTypeJson = $context.$variables.prjPjcVarConvMessageText;\nvar summarizedData = $context.$variables.prjPjcVarConvSummarizedData;\nvar currentState = String($context.$variables.prjPjcVarConvCurrentState || \"\"); \nvar userEnteredCategoryRaw = $context.$variables.prjPjcVarConvUserExceptionCategory;\nvar userEnteredTypeRaw = $context.$variables.prjPjcVarConvUserExceptionType;\nvar allCategoriesRaw = $context.$variables.prjPjcVarConvAllCategories;\nvar source1 = $context.$variables.prjPjcVarConvCostExceptionTypes;\nvar source2 = $context.$variables.prjPjcVarConvCostExceptionTypeCategoryWise;\nvar sourceContext = String((($context.$nodes.PRJ_PJC_CODE_CHECK_SOURCE || {}).$output || {}).result || \"\");\nvar relevancyCheckerOutput = (($context.$nodes.PRJ_PJC_LLM_RELEVANCY_CHECKER || {}).$output) || {};\n\n\n// 2. Normalize Input\nvar rawInput = $context.$system.$inputMessage || \"\";\nvar cleanInput = (typeof rawInput === 'string' ? rawInput : JSON.stringify(rawInput)).toLowerCase().trim();\n\nvar tableRowNumber = relevancyCheckerOutput.TableRowNumber;\nvar hasNoTableRowNumber = (\n    tableRowNumber === undefined ||\n    tableRowNumber === null ||\n    String(tableRowNumber).trim() === \"\"\n);\n\nvar isExceptionCategoriesRequest = cleanInput.includes(\"exception categories\") && hasNoTableRowNumber;\nvar isExceptionTypesRequest = cleanInput.includes(\"exception types\") && hasNoTableRowNumber;\n\nvar redwoodPFCACategoryName = relevancyCheckerOutput.PFCACategoryName;\nvar redwoodPFCAExceptionTypeName = relevancyCheckerOutput.PFCAExceptionTypeName;\n\nif (isExceptionTypesRequest && sourceContext === \"RedwoodUI\") {\n    redwoodPFCACategoryName = relevancyCheckerOutput.PFCAOldCategoryName;\n}\nelse if(isExceptionCategoriesRequest && sourceContext === \"RedwoodUI\" ){redwoodPFCACategoryName = null;\n redwoodPFCAExceptionTypeName = null;\n}\nelse if (relevancyCheckerOutput.PFCAOldUserIntent === 'EXCEPTION_TYPES' && sourceContext === \"RedwoodUI\" && (redwoodPFCACategoryName === undefined || redwoodPFCACategoryName === null || String(redwoodPFCACategoryName).trim() === \"\" )) {\n    redwoodPFCACategoryName = relevancyCheckerOutput.PFCAOldCategoryName;\n}\nelse if (relevancyCheckerOutput.PFCAOldUserIntent === 'EXCEPTION_DETAILS' && sourceContext === \"RedwoodUI\" && (redwoodPFCAExceptionTypeName === undefined || redwoodPFCAExceptionTypeName === null || String(redwoodPFCAExceptionTypeName).trim() === \"\" )) {\n    redwoodPFCAExceptionTypeName = relevancyCheckerOutput.PFCAOldExceptionTypeName;\n};\n\n\n\n\n// Logic Triggers\nvar isResetRequest = (cleanInput === \"start over\" || cleanInput === \"reset\");\nvar isCapabilityQuery = (cleanInput === \"learn what i can do\");\nvar isSetupEnquiry = (cleanInput.includes(\"setup\"));\n\n\nvar sanitizedInput = cleanInput.replace(/[,/#!$%\\^&\\*;:{}=\\_`~()'?]/g, \" \").replace(/\\s+/g, \" \").trim();\nvar tempText = \" \" + sanitizedInput + \" \"; \n\n// 3. Data Source Setup\nvar catMsgs = (exceptionCategoryJson && exceptionCategoryJson.messages) ? exceptionCategoryJson.messages : [];\nvar typeMsgs = (exceptionTypeJson && exceptionTypeJson.messages) ? exceptionTypeJson.messages : [];\nvar sumRows = (summarizedData && summarizedData) ? summarizedData : [];\nvar costCats = (allCategoriesRaw && Array.isArray(allCategoriesRaw.CostCategory)) ? allCategoriesRaw.CostCategory : [];\nvar costExRows = (source1 && Array.isArray(source1.SummarizedRows)) ? source1.SummarizedRows : (source2 && Array.isArray(source2.SummarizedRows) ? source2.SummarizedRows : []);\n\nvar matchedExceptionCategories = [];\nvar matchedExceptionTypes = [];\nvar matchedFilters = [];\n\n// 4. Calculate totalExceptionCount\nvar totalExceptionCount = 0;\nfor (var s = 0; s < sumRows.length; s++) {\n    totalExceptionCount += parseInt(sumRows[s].Count) || 0;\n}\n\n// 5. PHASE: Extraction by Text Match (Longest string first)\nvar typeItems = [];\nfor (var i = 0; i < typeMsgs.length; i++) { if (typeMsgs[i].MessageText) typeItems.push(typeMsgs[i].MessageText); }\ntypeItems.sort(function(a, b) { return b.length - a.length; });\n\nfor (var j = 0; j < typeItems.length; j++) {\n    var sType = typeItems[j].toLowerCase().replace(/[.,\\/#!$%\\^&\\*;:{}=_`~()'?]/g, \" \").replace(/\\s+/g, \" \").trim();\n    if (tempText.indexOf(sType) !== -1) { \n        matchedExceptionTypes.push(typeItems[j]); \n        tempText = tempText.split(sType).join(\" ### \"); \n    }\n}\n\nvar catItems = [];\nfor (var i = 0; i < catMsgs.length; i++) { if (catMsgs[i].ExceptionCategory) catItems.push(catMsgs[i].ExceptionCategory); }\ncatItems.sort(function(a, b) { return b.length - a.length; });\n\nfor (var j = 0; j < catItems.length; j++) {\n    var sCat = catItems[j].toLowerCase().replace(/[.,\\/#!$%\\^&\\*;:{}=_`~()'?]/g, \" \").replace(/\\s+/g, \" \").trim();\n    if (tempText.indexOf(\" \" + sCat + \" \") !== -1) { \n        matchedExceptionCategories.push(catItems[j]); \n        tempText = tempText.split(sCat).join(\" ### \"); \n    }\n}\n\n// 6. PHASE: Generic Keyword & Serial Number Extraction\nvar genericSerialRegex = \"\\\\s+(?:number|no\\\\.|no|having|#|at)?\\\\s*(\\\\d+)\\\\b\";\nvar catKeywordMatch = tempText.match(new RegExp(\"\\\\b(?:exception category|category)\" + genericSerialRegex, \"i\"));\nvar typeKeywordMatch = tempText.match(new RegExp(\"\\\\b(?:exception type|type)\" + genericSerialRegex, \"i\"));\n\nif (catKeywordMatch) {\n    var numC = parseInt(catKeywordMatch[1]);\n    var foundCatK = costCats.find(function(c) { return c.SerialNumber === numC; });\n    if (foundCatK) {\n        matchedExceptionCategories.push(foundCatK.ExceptionCategory);\n        tempText = tempText.replace(catKeywordMatch[0], \" ### \"); // Clear the number used\n    }\n} \n\nif (typeKeywordMatch) {\n    var numT = parseInt(typeKeywordMatch[1]);\n    var foundTypeK = costExRows.find(function(e) { return e.SerialNumber === numT; });\n    if (foundTypeK) {\n        matchedExceptionTypes.push(foundTypeK.ExceptionType);\n        tempText = tempText.replace(typeKeywordMatch[0], \" ### \"); // Clear the number used\n    }\n}\n\n// 7. NEW PHASE: Date Filter Extraction (Prevents \"2\" from being a Serial Number)\nvar dateFilterRegex = /\\b(?:last|past)\\s+(\\d+)\\s+(months?|days?|weeks?|wks?|years?|yrs?|yr|quarters?|qtrs?)\\b/i;\nvar dateMatch = tempText.match(dateFilterRegex);\n\nif (dateMatch) {\n\n\n    // CRITICAL: Remove the date text so Step 8 doesn't see the number \"2\"\n    tempText = tempText.replace(dateMatch[0], \" ### \");\n}\n\n// 8. PHASE: Standalone Serial Number Fallback\nif (!catKeywordMatch && !typeKeywordMatch) {\n    var numS = null;\n\n    // Attempt to get numS from the LLM Relevancy Checker node\n    var nodeOutput = $context.$nodes.PRJ_PJC_LLM_RELEVANCY_CHECKER.$output.TableRowNumber;\n    \n    if (nodeOutput !== undefined && nodeOutput !== null && nodeOutput !== \"\") {\n        numS = parseInt(nodeOutput);\n    } \n\n\n\n    //  Extraction logic if numS was populated by either method\n    if (numS !== null && !isNaN(numS)) {\n        if (currentState.toUpperCase().indexOf(\"EXCEPTION_CATEGORIES\") !== -1) {\n            var foundCatS = costCats.find(function(c) { return c.SerialNumber === numS; });\n            if (foundCatS) matchedExceptionCategories.push(foundCatS.ExceptionCategory);\n            \n        } else if (currentState.toUpperCase().indexOf(\"EXCEPTION_TYPES\") !== -1) {\n            var foundTypeS = costExRows.find(function(e) { return e.SerialNumber === numS; });\n            if (foundTypeS) matchedExceptionTypes.push(foundTypeS.ExceptionType);\n        }\n    }\n}\n\n// 8A. PHASE: RedwoodUI PFCA Context Fallback\nif (sourceContext === \"RedwoodUI\") {\n    if (matchedExceptionCategories.length === 0 && redwoodPFCACategoryName !== undefined && redwoodPFCACategoryName !== null) {\n        var normalizedPFCACategoryName = String(redwoodPFCACategoryName).trim();\n        if (normalizedPFCACategoryName && matchedExceptionCategories.indexOf(normalizedPFCACategoryName) === -1) {\n            matchedExceptionCategories.push(normalizedPFCACategoryName);\n        }\n    }\n    if (matchedExceptionTypes.length === 0 && redwoodPFCAExceptionTypeName !== undefined && redwoodPFCAExceptionTypeName !== null) {\n        var normalizedPFCAExceptionTypeName = String(redwoodPFCAExceptionTypeName).trim();\n        if (normalizedPFCAExceptionTypeName && matchedExceptionTypes.indexOf(normalizedPFCAExceptionTypeName) === -1) {\n            matchedExceptionTypes.push(normalizedPFCAExceptionTypeName);\n        }\n    }\n}\n\n// 9. Result Generation & Intent Logic\nif(sourceContext !== \"RedwoodUI\")\nvar matchedIntent = String($context.$variables.prjPjcVarConvUserIntent || \"EXCEPTION_CATEGORIES\"); \nelse\n var matchedIntent = String(relevancyCheckerOutput.PFCAOldUserIntent || \"EXCEPTION_CATEGORIES\");\n\nif (isResetRequest) {\n    matchedIntent = \"EXCEPTION_CATEGORIES\";\n    matchedExceptionCategories = [];\n    matchedExceptionTypes = [];\n    matchedFilters = [];\n}\nelse if (isCapabilityQuery) {\n    matchedIntent = \"ABOUT\";\n} \nelse if (isSetupEnquiry) {\n    matchedIntent = \"SETUP_ENQUIRY\";\n}\nelse if (isExceptionCategoriesRequest && matchedExceptionCategories.length === 0) {\n    matchedIntent = \"EXCEPTION_CATEGORIES\";\n}\nelse if (isExceptionTypesRequest && matchedExceptionTypes.length === 0) {\n    matchedIntent = \"EXCEPTION_TYPES\";\n}\nelse if (matchedExceptionTypes.length > 0) {\n    matchedIntent = \"EXCEPTION_DETAILS\";\n} else if (matchedExceptionCategories.length > 0) {\n    matchedIntent = \"EXCEPTION_TYPES\";\n} \n\n// Fallback for high-volume view\nif (!isResetRequest && !isCapabilityQuery && !isSetupEnquiry && !isExceptionCategoriesRequest && !isExceptionTypesRequest && \n    totalExceptionCount > 0 && totalExceptionCount <= 20 && matchedExceptionTypes.length === 0 && matchedExceptionCategories.length === 0) {\n    matchedIntent = \"EXCEPTION_TYPES\";\n}\n\n// 10. CONTEXT RESTORATION\nif (!isResetRequest && !isSetupEnquiry) {\n    if (matchedIntent === \"EXCEPTION_TYPES\" && matchedExceptionCategories.length === 0 && totalExceptionCount > 20) {\n        if (Array.isArray(userEnteredCategoryRaw) && userEnteredCategoryRaw.length > 0) {\n            matchedExceptionCategories.push(userEnteredCategoryRaw[0].ExceptionCategoryName);\n        }\n    }\n    if (matchedIntent === \"EXCEPTION_DETAILS\" && matchedExceptionTypes.length === 0) {\n        if (Array.isArray(userEnteredTypeRaw) && userEnteredTypeRaw.length > 0) {\n            matchedExceptionTypes.push(userEnteredTypeRaw[0].ExceptionTypeName);\n        }\n    }\n}\n\nvar result = {\n    matchedIntent: matchedIntent,\n    matchedExceptionCategories: matchedExceptionCategories,\n    matchedExceptionTypes: matchedExceptionTypes,\n    matchedFilters: matchedFilters,\n    totalExceptionCount: totalExceptionCount\n};\n\nreturn JSON.stringify(result);"
          },
