          "metadata": {
            "name": "Extract Exception Category Name",
            "returnType": "array",
            "sourceCode": "// 1. Resolve Data with \"Empty Array\" Protection\nvar nodeData = $context.$nodes.PRJ_PJC_LLM_INTENT_RECOGNIZER.$output.UserEnteredCategory;\nvar varData = $context.$variables.prjPjcVarConvUserExceptionCategory;\n\n// Fallback logic: If nodeData is an empty array or null, use varData\nvar catData = (Array.isArray(nodeData) && nodeData.length > 0) ? nodeData : (nodeData && !Array.isArray(nodeData) ? nodeData : varData);\n\nvar exceptionCategoryName = null;\nvar serialNumber = null;\n\n// 2. Extract Data (Handling both Array and Object formats + key fallbacks)\nif (catData) {\n    if (Array.isArray(catData) && catData.length > 0) {\n        // Checks for ExceptionCategoryName, then falls back to .name\n        exceptionCategoryName = catData[0].ExceptionCategoryName || catData[0].name || null;\n        serialNumber = catData[0].SerialNumber || null;\n    } else if (typeof catData === 'object' && Object.keys(catData).length > 0) {\n        // Checks for ExceptionCategoryName, then falls back to .name\n        exceptionCategoryName = catData.ExceptionCategoryName || catData.name || null;\n        serialNumber = catData.SerialNumber || null;\n    }\n}\n\n// 3. Final Output\nvar result = {\n    \"ExceptionCategoryName\": exceptionCategoryName,\n    \"SerialNumber\": serialNumber\n};\n\nreturn JSON.stringify(result);"
