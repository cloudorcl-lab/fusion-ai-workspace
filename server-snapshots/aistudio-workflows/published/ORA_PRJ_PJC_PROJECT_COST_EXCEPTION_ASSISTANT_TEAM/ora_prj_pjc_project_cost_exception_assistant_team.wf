            {
              "id": "1769947266308",
              "name": "prjPjcVarConvMessageRAG",
              "scope": "JOB",
              "type": "array",
              "value": "{\n  \"messages\": [\n    {\n      \"ExceptionCategory\": \"Uncategorized Exception\",\n      \"MessageTextKey\": \"\",\n      \"ReferenceAttributes\": \"\",\n      \"ResolutionOptions\": \"\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_FAILED_TO_DRV_HCM_ASSGN2\",\n      \"ReferenceAttributes\": \"Worker, Transaction Date\",\n      \"ResolutionOptions\": \"Ensure the worker has an active primary HCM assignment as of the transaction Date., Change the transaction Date.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_FAILED_TO_DRV_HCM_JOB2\",\n      \"ReferenceAttributes\": \"Worker, Worker Assignment Number, Transaction Date\",\n      \"ResolutionOptions\": \"Provide a job on the worker's active HCM assignment., Change the transaction Date.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_FAILED_TO_DRV_HCM_ORGN2\",\n      \"ReferenceAttributes\": \"Worker, Worker Assignment Number, Transaction Date\",\n      \"ResolutionOptions\": \"Provide an organization on the worker's active HCM assignment., Change the transaction Date.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_FAILED_TO_DRV_HCM_PTYPE2\",\n      \"ReferenceAttributes\": \"Worker, Worker Assignment Number, Transaction Date\",\n      \"ResolutionOptions\": \"Ensure the worker's HCM assignment is active as of the transaction date and has a user person type that's mapped to the internal person type of Employee or Contingent Worker., Change the transaction Date.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_FAILED_TO_DRV_WORKTYPE2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number, Project Type, Task Name, Task Number\",\n      \"ResolutionOptions\": \"Assign a work type for the transaction on either the task, project, or project type.\"\n    },\n    {\n      \"ExceptionCategory\": \"Grant Management\",\n      \"MessageTextKey\": \"PJC_AWDDIST_COST_DIST_FAILED2\",\n      \"ReferenceAttributes\": \"Funding Pattern Name\",\n      \"ResolutionOptions\": \"View the distribution results for more details and update the funding pattern as appropriate.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accrual Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_ACRV_NEVER_OPEN_GL2\",\n      \"ReferenceAttributes\": \"transaction Date, Accounting Date, Accounting Period\",\n      \"ResolutionOptions\": \"Open the initial accounting period., Change the transaction Date of the accrual transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accrual Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_ACR_NEVER_OPEN_GL2\",\n      \"ReferenceAttributes\": \"transaction Date, Accounting Date, Accounting Period\",\n      \"ResolutionOptions\": \"Open the initial accounting period., Change the transaction Date of the accrual transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_NEVER_OPEN_GL2\",\n      \"ReferenceAttributes\": \"transaction Date, Accounting Date, Accounting Period\",\n      \"ResolutionOptions\": \"Open the initial accounting period., Change the transaction Date of the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_NEVER_OPEN_PA2\",\n      \"ReferenceAttributes\": \"Project Accounting Date, Accounting Period\",\n      \"ResolutionOptions\": \"Open the initial accounting period covering the project accounting date., Change the transaction Date so that it's in an active period.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accrual Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_PRV_ACRV_NOT_DEF_GL2\",\n      \"ReferenceAttributes\": \"transaction Date, Accounting Date\",\n      \"ResolutionOptions\": \"Create a provider accounting period that covers the accounting date of the accrual transaction reversal., Change the transaction Date of the accrual transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accrual Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_PRV_ACRV_NOT_DEF_PA2\",\n      \"ReferenceAttributes\": \"transaction Date, Accounting Date, Accounting Period\",\n      \"ResolutionOptions\": \"Create a provider project accounting period that starts within the accounting period., Change the transaction Date of the accrual transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accrual Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_PRV_ACRV_NO_ACTV_GL2\",\n      \"ReferenceAttributes\": \"Accounting Date, Accounting Period\",\n      \"ResolutionOptions\": \"Change the status of the accounting period covering the provider accounting date of the accrual reversal transaction to Open or Future Enterable., Change the transaction Date of the accrual transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accrual Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_PRV_ACRV_NO_ACTV_GLCP2\",\n      \"ReferenceAttributes\": \"Accounting Date, Accounting Period\",\n      \"ResolutionOptions\": \"Change the status of the accounting period covering the provider accounting date of the accrual reversal transaction to Open, Future Enterable, or Close Pending., Change the transaction Date of the accrual transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accrual Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_PRV_ACR_NOT_DEF_GL2\",\n      \"ReferenceAttributes\": \"transaction Date, Accounting Date\",\n      \"ResolutionOptions\": \"Create a provider accounting period that covers the accounting date of the transaction., Change the transaction Date of the accrual transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accrual Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_PRV_ACR_NOT_DEF_PA2\",\n      \"ReferenceAttributes\": \"transaction Date, Project Accounting Date\",\n      \"ResolutionOptions\": \"Create a provider project accounting period that covers the accounting date of the transaction., Change the transaction Date of the accrual transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accrual Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_PRV_ACR_NO_ACTV_GL2\",\n      \"ReferenceAttributes\": \"Accounting Date, Accounting Period\",\n      \"ResolutionOptions\": \"Change the status of the accounting period covering the provider accounting date of the accrual transaction to Open or Future Enterable., Change the transaction Date of the accrual transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accrual Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_PRV_ACR_NO_ACTV_GL_CP2\",\n      \"ReferenceAttributes\": \"Accounting Date, Accounting Period\",\n      \"ResolutionOptions\": \"Change the status of the accounting period covering the provider accounting date of the accrual transaction to Open, Future Enterable, or Close Pending., Change the transaction Date of the accrual transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accrual Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_PRV_ACR_PA_OUTSIDE_GL2\",\n      \"ReferenceAttributes\": \"Project Accounting Date, Accounting Period\",\n      \"ResolutionOptions\": \"Open a project accounting period that's in the date range of the derived accounting period., Change the transaction Date on the accrual transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_PRV_EXT_NO_ACTV_GL2\",\n      \"ReferenceAttributes\": \"Accounting Date, Accounting Period\",\n      \"ResolutionOptions\": \"Change the status of the accounting period covering the provider accounting date of the third-party transaction to Open or Future Enterable., Change the provider accounting date on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_PRV_NOT_DEF_GL2\",\n      \"ReferenceAttributes\": \"Accounting Date\",\n      \"ResolutionOptions\": \"Create a provider accounting period that covers the accounting date of the transaction., Change the transaction Date of the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_PRV_NOT_DEF_PA2\",\n      \"ReferenceAttributes\": \"Accounting Date\",\n      \"ResolutionOptions\": \"Create a provider project accounting period that covers the accounting date of the transaction., Change the transaction Date of the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_PRV_NO_ACTV_GL2\",\n      \"ReferenceAttributes\": \"Accounting Date, Accounting Period\",\n      \"ResolutionOptions\": \"Change the status of the accounting period covering the provider accounting date of the transaction to Open or Future Enterable., Change the transaction Date of the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_PRV_NO_ACTV_GL_CP2\",\n      \"ReferenceAttributes\": \"Accounting Date, Accounting Period\",\n      \"ResolutionOptions\": \"Change the status of the accounting period covering the provider accounting date of the transaction to Open, Future Enterable, or Close Pending., Change the transaction Date of the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_PRV_NO_ACTV_PA2\",\n      \"ReferenceAttributes\": \"Project Accounting Date, Project Accounting Period\",\n      \"ResolutionOptions\": \"Change the status of the accounting period covering the provider project accounting date of the transaction to Open or Future Enterable., Change the transaction Date of the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_RCV_EXT_NO_ACTV_GL2\",\n      \"ReferenceAttributes\": \"Receiver Accounting Date, Receiver Accounting Period\",\n      \"ResolutionOptions\": \"Change the status of the accounting period covering the receiver accounting date of the third-party transaction to Open or Future Enterable., Change the receiver accounting date on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_RCV_NOT_DEF_GL2\",\n      \"ReferenceAttributes\": \"Receiver Accounting Date\",\n      \"ResolutionOptions\": \"Create a receiver accounting period that covers the accounting date of the transaction., Change the transaction Date of the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_RCV_NOT_DEF_PA2\",\n      \"ReferenceAttributes\": \"Receiver Accounting Date\",\n      \"ResolutionOptions\": \"Create a receiver project accounting period that covers the accounting date of the transaction., Change the transaction Date of the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_RCV_NO_ACTV_GL2\",\n      \"ReferenceAttributes\": \"Receiver Accounting Date, Receiver Accounting Period\",\n      \"ResolutionOptions\": \"Change the status of the accounting period covering the receiver accounting date of the transaction to Open or Future Enterable., Change the transaction Date of the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_RCV_NO_ACTV_GL_CP2\",\n      \"ReferenceAttributes\": \"Receiver Accounting Date, Receiver Accounting Period\",\n      \"ResolutionOptions\": \"Change the status of the accounting period covering the receiver accounting date of the transaction to Open, Future Enterable, or Close Pending., Change the transaction Date of the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_RCV_NO_ACTV_PA2\",\n      \"ReferenceAttributes\": \"Receiver Accounting Date, Receiver Project Accounting Period\",\n      \"ResolutionOptions\": \"Change the status of the accounting period covering the receiver accounting date of the transaction to Open or Future Enterable., Change the transaction Date of the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_PRV_PA_OUTSIDE_GL2\",\n      \"ReferenceAttributes\": \"Project Accounting Date\",\n      \"ResolutionOptions\": \"Open a project accounting period that's in the date range of the derived accounting period., Change the transaction Date of the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accrual Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_RCV_ACRV_NOT_DEF_GL2\",\n      \"ReferenceAttributes\": \"Receiver Accounting Date\",\n      \"ResolutionOptions\": \"Create a receiver accounting period that covers the accounting date of the accrual transaction reversal., Change the transaction Date of the accrual transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accrual Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_RCV_ACRV_NOT_DEF_PA2\",\n      \"ReferenceAttributes\": \"Receiver Accounting Date, Accounting Period\",\n      \"ResolutionOptions\": \"Create a receiver project accounting period that starts within the accounting period., Change the transaction Date of the accrual transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accrual Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_RCV_ACRV_NO_ACTV_GL2\",\n      \"ReferenceAttributes\": \"Receiver Accounting Date, Receiver Accounting Period\",\n      \"ResolutionOptions\": \"Change the status of the accounting period covering the receiver accounting date of the accrual reversal transaction to Open or Future Enterable., Change the transaction Date on the accrual transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accrual Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_RCV_ACRV_NO_ACTV_GLCP2\",\n      \"ReferenceAttributes\": \"Receiver Accounting Date, Receiver Accounting Period\",\n      \"ResolutionOptions\": \"Change the status of the accounting period covering the receiver accounting date of the accrual reversal transaction to Open, Future Enterable, or Close Pending., Change the transaction Date on the accrual transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accrual Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_RCV_ACR_NOT_DEF_PA2\",\n      \"ReferenceAttributes\": \"Receiver Accounting Date\",\n      \"ResolutionOptions\": \"Create a receiver project accounting period that covers the accounting date of the accrual transaction., Change the transaction Date of the accrual transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accrual Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_RCV_ACR_NO_ACTV_GL2\",\n      \"ReferenceAttributes\": \"Receiver Accounting Date, Receiver Accounting Period\",\n      \"ResolutionOptions\": \"Change the status of the accounting period covering the receiver accounting date of the accrual transaction to Open or Future Enterable.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accrual Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_RCV_ACR_NO_ACTV_GL_CP2\",\n      \"ReferenceAttributes\": \"Receiver Accounting Date, Receiver Accounting Period\",\n      \"ResolutionOptions\": \"Change the status of the accounting period covering the receiver accounting date of the accrual transaction to Open, Future Enterable, or Close Pending.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accrual Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_RCV_ACR_NOT_DEF_GL2\",\n      \"ReferenceAttributes\": \"Receiver Accounting Date\",\n      \"ResolutionOptions\": \"Create a receiver accounting period that covers the accounting date of the accrual transaction., Change the transaction Date of the accrual transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accrual Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_RCV_ACR_PA_OUTSIDE_GL2\",\n      \"ReferenceAttributes\": \"Receiver Project Accounting Date, Accounting Period\",\n      \"ResolutionOptions\": \"Open a project accounting period that's in the date range of the derived accounting period.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_PRV_NO_ACTV_PA_CP2\",\n      \"ReferenceAttributes\": \"Accounting Date, Accounting Period\",\n      \"ResolutionOptions\": \"Change the status of the project accounting period covering the provider accounting date of the transaction to Open, Future Enterable, or Close Pending.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_RCV_NO_ACTV_PA_CP2\",\n      \"ReferenceAttributes\": \"Receiver Accounting Date, Receiver Accounting Period\",\n      \"ResolutionOptions\": \"Change the status of the project accounting period covering the receiver accounting date of the transaction to Open, Future Enterable, or Close Pending.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounting Period\",\n      \"MessageTextKey\": \"PJF_CAL_RCV_PA_OUTSIDE_GL2\",\n      \"ReferenceAttributes\": \"Receiver Project Accounting Date\",\n      \"ResolutionOptions\": \"Open a project accounting period that's in the date range of the derived accounting period., Change the transaction Date on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Unexpected System Error\",\n      \"MessageTextKey\": \"PJF_GENERIC_ERROR2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Original Transaction Reference\",\n      \"ResolutionOptions\": \"Try importing the transaction again. If it fails again, contact your help desk.\"\n    },\n    {\n      \"ExceptionCategory\": \"Burdening\",\n      \"MessageTextKey\": \"PJF_IND_NO_COMPILED_MULT2\",\n      \"ReferenceAttributes\": \"Burden Schedule Version Name, Cost Organization, Cost Type\",\n      \"ResolutionOptions\": \"Generate burden cost multipliers for the cost organization or cost type.\"\n    },\n    {\n      \"ExceptionCategory\": \"Burdening\",\n      \"MessageTextKey\": \"PJF_IND_REVISION_NOT_BUILT2\",\n      \"ReferenceAttributes\": \"Burden Schedule Version Name\",\n      \"ResolutionOptions\": \"Build the burden schedule version.\"\n    },\n    {\n      \"ExceptionCategory\": \"Burdening\",\n      \"MessageTextKey\": \"PJF_PRICE_NO_COST_BASE2\",\n      \"ReferenceAttributes\": \"Burden Structure Name, Cost Type\",\n      \"ResolutionOptions\": \"Assign the cost type to a cost base in the burden structure., Change the cost type of the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Rate Definition\",\n      \"MessageTextKey\": \"PJF_PRICE_NO_COST_RULE2\",\n      \"ReferenceAttributes\": \"Business Unit, Cost Organization\",\n      \"ResolutionOptions\": \"Ensure that there's a labor organization costing rule active for at least the provider business unit.\"\n    },\n    {\n      \"ExceptionCategory\": \"Burdening\",\n      \"MessageTextKey\": \"PJF_PRICE_NO_IRS_REVISION2\",\n      \"ReferenceAttributes\": \"Burden Schedule Name, Transaction Date\",\n      \"ResolutionOptions\": \"Ensure there's a burden schedule version for the burden schedule as of the transaction Date.\"\n    },\n    {\n      \"ExceptionCategory\": \"Rate Definition\",\n      \"MessageTextKey\": \"PJF_PRICE_NO_PERSON_RATE2\",\n      \"ReferenceAttributes\": \"Worker, Rate Schedule, Transaction Date\",\n      \"ResolutionOptions\": \"Enter a worker-specific cost rate in the appropriate rate schedule effective as of the transaction Date.\"\n    },\n    {\n      \"ExceptionCategory\": \"Rate Definition\",\n      \"MessageTextKey\": \"PJF_PRICE_NO_JOB_RATE4\",\n      \"ReferenceAttributes\": \"Worker Job, Rate Schedule, Transaction Date\",\n      \"ResolutionOptions\": \"Enter a worker job-specific cost rate in the appropriate rate schedule effective as of the transaction Date.\"\n    },\n    {\n      \"ExceptionCategory\": \"Rate Definition\",\n      \"MessageTextKey\": \"PJF_PRICE_NO_NL_COST_RULE2\",\n      \"ReferenceAttributes\": \"Business Unit, Cost Organization\",\n      \"ResolutionOptions\": \"Ensure that there's a nonlabor organization costing rule active for at least the provider business unit.\"\n    },\n    {\n      \"ExceptionCategory\": \"Rate Definition\",\n      \"MessageTextKey\": \"PJF_PRICE_NO_NL_SCH_RATE2\",\n      \"ReferenceAttributes\": \"Nonlabor Resource, Rate Schedule, Transaction Date\",\n      \"ResolutionOptions\": \"Enter a cost rate for the nonlabor resource in the appropriate rate schedule effective as of the transaction Date.\"\n    },\n    {\n      \"ExceptionCategory\": \"Currency Conversion\",\n      \"MessageTextKey\": \"PJF_CURR_ACCT_NO_EXCH_RATE2\",\n      \"ReferenceAttributes\": \"Transaction Currency Code, Provider Ledger Currency Code, Transaction Date\",\n      \"ResolutionOptions\": \"Provide a rate with the appropriate rate type and rate date to convert the amount in transaction currency to the provider ledger currency amount.\"\n    },\n    {\n      \"ExceptionCategory\": \"Currency Conversion\",\n      \"MessageTextKey\": \"PJF_CURR_EXCEED_ROUND_LIMIT2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Document Entry, Original Transaction Reference\",\n      \"ResolutionOptions\": \"Update the ledger raw cost on the transaction, Change the tolerance limit\"\n    },\n    {\n      \"ExceptionCategory\": \"Currency Conversion\",\n      \"MessageTextKey\": \"PJF_CURR_PC_NO_EXCH_RATE2\",\n      \"ReferenceAttributes\": \"Transaction Currency Code, Project Currency Code, Transaction Date\",\n      \"ResolutionOptions\": \"Provide a rate with the appropriate rate type and rate date to convert the amount in transaction currency to the project currency amount.\"\n    },\n    {\n      \"ExceptionCategory\": \"Currency Conversion\",\n      \"MessageTextKey\": \"PJF_CURR_PL_NO_EXCH_RATE2\",\n      \"ReferenceAttributes\": \"Transaction Currency Code, Receiver Ledger Currency Code, Transaction Date\",\n      \"ResolutionOptions\": \"Provide a rate with the appropriate rate type and rate date to convert the amount in transaction currency to the receiver ledger currency amount.\"\n    },\n    {\n      \"ExceptionCategory\": \"Currency Conversion\",\n      \"MessageTextKey\": \"PJF_CURR_RATE_NOT_FOUND2\",\n      \"ReferenceAttributes\": \"Transaction Currency Code, Provider Ledger Currency Code, Receiver Ledger Currency Code, Project Currency Code, Transaction Date\",\n      \"ResolutionOptions\": \"Provide a rate to convert transaction currency to provider ledger currency, receiver ledger currency, or project currency.\"\n    },\n    {\n      \"ExceptionCategory\": \"Burdening\",\n      \"MessageTextKey\": \"PJF_IND_NO_COMP_SET_NO_DATE2\",\n      \"ReferenceAttributes\": \"Burden Schedule Name, Burden Schedule Version Name, Transaction Date\",\n      \"ResolutionOptions\": \"Compile the multipliers for the burden schedule version.\"\n    },\n    {\n      \"ExceptionCategory\": \"Burdening\",\n      \"MessageTextKey\": \"PJF_PRICE_NO_IRS_REV_NO_DATE2\",\n      \"ReferenceAttributes\": \"Burden Schedule Name, Transaction Date\",\n      \"ResolutionOptions\": \"Change the dates of the existing burden schedule version., Create a new version that's active as of the transaction Date.\"\n    },\n    {\n      \"ExceptionCategory\": \"Rate Definition\",\n      \"MessageTextKey\": \"PJF_PRICE_NO_JOB_RATE3\",\n      \"ReferenceAttributes\": \"Worker Job, Job Rate Schedule, Job Rate Schedule Job Set\",\n      \"ResolutionOptions\": \"Add the worker's job to the job rate schedule., Map the worker's job to an existing job in the job set used in the job rate schedule.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounted Cost Account Issues\",\n      \"MessageTextKey\": \"PJC_BURDEN_CR_CCID_NULL2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Batch \",\n      \"ResolutionOptions\": \"Update the unprocessed project cost transaction to add a valid burden cost credit account\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounted Cost Account Issues\",\n      \"MessageTextKey\": \"PJC_BURDEN_DR_CCID_INVALID2\",\n      \"ReferenceAttributes\": \"Burden Cost Debit Account Concatenated Segments, Burden Cost Debit Account Code Combination ID\",\n      \"ResolutionOptions\": \"Update the burden cost debit account for the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounted Cost Account Issues\",\n      \"MessageTextKey\": \"PJC_BURDEN_DR_CCID_NULL2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Batch \",\n      \"ResolutionOptions\": \"Update the transaction to add a burden cost debit account.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounted Cost Account Issues\",\n      \"MessageTextKey\": \"PJC_DR_CCID_IS_INVALID2\",\n      \"ReferenceAttributes\": \"Raw Cost Debit Account Concatenated Segments, Raw Cost Debit Account Code Combination ID\",\n      \"ResolutionOptions\": \"Update the raw cost debit account for the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounted Cost Account Issues\",\n      \"MessageTextKey\": \"PJC_DR_CCID_IS_NULL2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Batch \",\n      \"ResolutionOptions\": \"Update the transaction to add a raw cost debit account.\"\n    },\n    {\n      \"ExceptionCategory\": \"Duplicate Transaction\",\n      \"MessageTextKey\": \"PJC_DUPLICATE_TXN2\",\n      \"ReferenceAttributes\": \"Original Transaction Reference, Transaction Source, Document Name, Document Entry\",\n      \"ResolutionOptions\": \"Revise the original transaction reference, Update the transaction source document entry to allow duplicate original transaction reference values\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_TXN_QTY_IS_NULL2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Batch , Cost Type\",\n      \"ResolutionOptions\": \"Enter a quantity for the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Project Cost Reversals\",\n      \"MessageTextKey\": \"PJC_TXN_RVRSDORIGTXNREF_NULL2\",\n      \"ReferenceAttributes\": \"Original Transaction Reference, Unmatched Transaction\",\n      \"ResolutionOptions\": \"Enter the reference to the original transaction for this reversing transaction., Change the unmatched negative transaction option to Yes for this transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounted Cost Account Issues\",\n      \"MessageTextKey\": \"PJC_CR_CCID_IS_INVALID2\",\n      \"ReferenceAttributes\": \"Raw Cost Credit Account Concatenated Segments, Raw Cost Credit Account Code Combination ID\",\n      \"ResolutionOptions\": \"Update the raw cost credit account for the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounted Cost Account Issues\",\n      \"MessageTextKey\": \"PJC_CR_CCID_IS_NULL2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Batch \",\n      \"ResolutionOptions\": \"Update the transaction to add a raw cost credit account.\"\n    },\n    {\n      \"ExceptionCategory\": \"Project Definition\",\n      \"MessageTextKey\": \"PJC_EX_PROJECT_DATE2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number, Project Start Date, Project Finish Date, Transaction Date\",\n      \"ResolutionOptions\": \"Update the project dates., Change the transaction Date on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_DENOM_CURRENCY_REQUIRED2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Batch \",\n      \"ResolutionOptions\": \"Enter a transaction currency for the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Project Definition\",\n      \"MessageTextKey\": \"PJC_TASK_NOT_XCHARGE2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number, Task Name, Task Number, Allow Cross-Charges Indicator\",\n      \"ResolutionOptions\": \"Enable the option on the task that allows cross-charges from other business units., Change the task on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_WORK_TYPE_IS_INACTIVE2\",\n      \"ReferenceAttributes\": \"Work Type, Transaction Date\",\n      \"ResolutionOptions\": \"Modify the effectivity dates of the work type., Update the date of the unprocessed project cost transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_EXP_NOTINBUEXPHIER2\",\n      \"ReferenceAttributes\": \"Business Unit, Cost Organization Hierarchy Name, Cost Organization\",\n      \"ResolutionOptions\": \"Add the transaction's cost organization to the business unit's cost organization hierarchy., Change the cost organization of the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_VI_VEND_ID_NOT_ACTIVE2\",\n      \"ReferenceAttributes\": \"Supplier Name, Supplier Start Date, Supplier End Date, Transaction Date\",\n      \"ResolutionOptions\": \"Change the effectivity dates of the supplier., Change the supplier on the project cost transaction., Change the transaction Date on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Project Definition\",\n      \"MessageTextKey\": \"PJC_TR_EPE_TASK_TXN_CTRLS2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number, Task Name, Task Number\",\n      \"ResolutionOptions\": \"Modify the exclusive task-level transaction controls to allow the project cost transaction., Change the attributes of the project cost transaction so that it passes the task-level exclusive transaction controls.\"\n    },\n    {\n      \"ExceptionCategory\": \"Project Definition\",\n      \"MessageTextKey\": \"PJC_RETIREMENT_TASK_NOT_CAP2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number, Task Name, Task Number, Retirement Cost Indicator\",\n      \"ResolutionOptions\": \"Change the capitalizable flag on the project cost transaction., Change the task on the project cost transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Burdening\",\n      \"MessageTextKey\": \"PJC_TRXSRC_NOTALLOW_BURDEN2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Import Burdened Cost Amounts Indicator\",\n      \"ResolutionOptions\": \"Remove the burdened cost from the transaction., Change the transaction source document setup to allow import of burdened cost amounts.\"\n    },\n    {\n      \"ExceptionCategory\": \"Project Cost Reversals\",\n      \"MessageTextKey\": \"PJC_MATCHED_TXN_PENDING_ADJ2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number\",\n      \"ResolutionOptions\": \"Complete or cancel the adjustment for the existing project cost before reversing it.\"\n    },\n    {\n      \"ExceptionCategory\": \"Project Cost Reversals\",\n      \"MessageTextKey\": \"PJC_MULT_MATCHED_REVERSALS2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number, Reversed Original Transaction Reference\",\n      \"ResolutionOptions\": \"Ensure that there's only one reversing transaction for the same original project cost.\"\n    },\n    {\n      \"ExceptionCategory\": \"Burdening\",\n      \"MessageTextKey\": \"PJC_PROJ_NOT_ALLOW_BURDEN2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Import Burdened Cost Amounts Indicator, Transaction Raw Cost Amount, Transaction Burdened Cost Amount\",\n      \"ResolutionOptions\": \"Update either the transaction currency raw cost or burdened cost so that they're the same., Update the transaction source document to enable import of burden amounts.\"\n    },\n    {\n      \"ExceptionCategory\": \"Project Definition\",\n      \"MessageTextKey\": \"PJC_PRJ_TC_TXN_NOT_CHARGEABLE2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number\",\n      \"ResolutionOptions\": \"Modify the exclusive project-level transaction controls to allow the project cost transaction., Change the attributes of the project cost transaction so that it passes the project-level exclusive transaction controls.\"\n    },\n    {\n      \"ExceptionCategory\": \"Project Definition\",\n      \"MessageTextKey\": \"PJC_PROJECT_NOT_XCHARGE2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number, Business Unit\",\n      \"ResolutionOptions\": \"Modify the project's cross-charge options to allow this transaction., Change the project on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_ORG_NOT_OWNER_OF_NL_RSRC2\",\n      \"ReferenceAttributes\": \"Nonlabor Resource Organization, Nonlabor Resource\",\n      \"ResolutionOptions\": \"Assign the nonlabor resource organization to the nonlabor resource., Change the nonlabor resource organization on the project cost transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_PERSON_MAND_FOR_ER2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Batch \",\n      \"ResolutionOptions\": \"Enter a worker for the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_PERSON_MAND_FOR_TIME2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Batch \",\n      \"ResolutionOptions\": \"Enter a worker for the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_NO_ACCT_CURR_RATE2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Batch , Transaction Currency Code, Provider Ledger Currency Code, Transaction Date\",\n      \"ResolutionOptions\": \"Enter a currency conversion rate for the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_NO_ACCT_CURR_RATE_DATE2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Batch, Transaction Currency Code, Provider Ledger Currency Code, Transaction Date\",\n      \"ResolutionOptions\": \"Enter a currency conversion date for the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_NO_ACCT_CURR_RATE_TYPE2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Batch, Transaction Currency Code, Provider Ledger Currency Code, Transaction Date\",\n      \"ResolutionOptions\": \"Enter a currency conversion rate type for the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Inactive or Invalid Reference Object\",\n      \"MessageTextKey\": \"PJC_INVALID_DENOM_CURRENCY2\",\n      \"ReferenceAttributes\": \"Transaction Currency Code, Transaction Date\",\n      \"ResolutionOptions\": \"Ensure the transaction currency code is active as of the transaction Date., Change the transaction currency code on the transaction., Change the transaction Date on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Project Definition\",\n      \"MessageTextKey\": \"PJC_NEW_TXNS_NOT_ALLOWED2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number, Project Status\",\n      \"ResolutionOptions\": \"Change the project's status to one that allows new transactions., Change the project on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_PRVDR_GL_DATE_IS_NULL2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Batch , Transaction Date\",\n      \"ResolutionOptions\": \"Enter an accounting date for the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounted Cost Account Issues\",\n      \"MessageTextKey\": \"PJC_INVALID_ACCT_DENOM_COST2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Batch \",\n      \"ResolutionOptions\": \"Update either the provider ledger currency raw cost amount or the transaction currency cost amount, Update the transaction currency.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_INVALID_BURDEN_AMOUNT2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Batch \",\n      \"ResolutionOptions\": \"Enter a burden cost amount for the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_INVALID_RECEIPT_CURRENCY2\",\n      \"ReferenceAttributes\": \"Receipt Currency Code\",\n      \"ResolutionOptions\": \"Enable the receipt currency for use in accounting entries., Change the receipt currency to a general ledger currency.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounted Cost Account Issues\",\n      \"MessageTextKey\": \"PJC_INVLD_BRDN_ACCT_DENOM_CST2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Batch \",\n      \"ResolutionOptions\": \"Update either the provider ledger burdened currency amount or the transaction currency burdened cost amount, Update the transaction currency.\"\n    },\n    {\n      \"ExceptionCategory\": \"Inactive or Invalid Reference Object\",\n      \"MessageTextKey\": \"PJC_NOT_ALLOW_OVR_EMP_ORG2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Allow Override of Person Organization Indicator, Worker Assignment Department Name\",\n      \"ResolutionOptions\": \"Change the cost organization on the transaction to be the worker's assigned department as of the transaction Date., Enable the Allow Override of Person Organization option on the transaction source document.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_NO_ACCT_COST2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Batch \",\n      \"ResolutionOptions\": \"Enter a provider ledger raw cost for the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Project Definition\",\n      \"MessageTextKey\": \"PJC_NOMATCH_INCL_PRJ_TXN_CTRL2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number\",\n      \"ResolutionOptions\": \"Change the inclusive project-level transaction controls to allow the project cost transaction., Change the attributes of the project cost transaction so that it passes the project-level inclusive transaction controls.\"\n    },\n    {\n      \"ExceptionCategory\": \"Project Definition\",\n      \"MessageTextKey\": \"PJC_NOMATCH_INCL_TSK_TXN_CTRL2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number, Task Name, Task Number\",\n      \"ResolutionOptions\": \"Change the inclusive task-level transaction controls to allow the project cost transaction., Change the attributes of the project cost transaction so that it passes the task-level inclusive transaction controls.\"\n    },\n    {\n      \"ExceptionCategory\": \"Project Definition\",\n      \"MessageTextKey\": \"PJC_PRJ_NOT_ENABLED_FOR_BILL2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number, Project Type\",\n      \"ResolutionOptions\": \"Change the billable status of the project cost transaction., Change the project on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Project Definition\",\n      \"MessageTextKey\": \"PJC_PRJ_NOT_ENABLED_FOR_CAP2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number, Project Type\",\n      \"ResolutionOptions\": \"Change the capitalizable status of the project cost transaction., Change the project on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Burdening\",\n      \"MessageTextKey\": \"PJC_INVALID_BURDEN_TRANS2\",\n      \"ReferenceAttributes\": \"Transaction Quantity, Transaction Currency Raw Cost, Cost Type, Cost Type Classification \",\n      \"ResolutionOptions\": \"Update either the transaction currency or the transaction currency raw cost amount so that they are both 0.\"\n    },\n    {\n      \"ExceptionCategory\": \"Inactive or Invalid Reference Object\",\n      \"MessageTextKey\": \"PJC_NL_RSRC_ORG_INACTIVE_HCM2\",\n      \"ReferenceAttributes\": \"Nonlabor Resource Organization, Transaction Date\",\n      \"ResolutionOptions\": \"Ensure the nonlabor resource organization is active as of the transaction Date., Change the transaction Date on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_NL_RSRC_ORG_MAND_FOR_USG2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Batch , Nonlabor Resource\",\n      \"ResolutionOptions\": \"Enter a nonlabor resource organization for the usage transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Inactive or Invalid Reference Object\",\n      \"MessageTextKey\": \"PJC_NL_TXN_EXP_TYPE_DIFF2\",\n      \"ReferenceAttributes\": \"Cost Type, Nonlabor Resource Cost Type\",\n      \"ResolutionOptions\": \"Change the associated cost type for the nonlabor resource., Change the cost type of the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_NO_RAW_COST2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Batch \",\n      \"ResolutionOptions\": \"Enter a transaction raw cost for the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Inactive or Invalid Reference Object\",\n      \"MessageTextKey\": \"PJC_INVALID_HR_DEPL_PER_TYPE2\",\n      \"ReferenceAttributes\": \"Worker Person Type, Worker System Person Type\",\n      \"ResolutionOptions\": \"Change the person type on the worker's HCM assignment active as of the project cost to one that is mapped to the internal person type of Employee or Contingent Worker.\"\n    },\n    {\n      \"ExceptionCategory\": \"Inactive or Invalid Reference Object\",\n      \"MessageTextKey\": \"PJC_NLRO_NOT_ACTIVE2\",\n      \"ReferenceAttributes\": \"Nonlabor Resource, Nonlabor Resource Organization, Nonlabor Resource Organization Assignment Start Date, Nonlabor Resource Organization Assignment End Date, Transaction Date\",\n      \"ResolutionOptions\": \"Change the dates of the nonlabor resource organization's assignment to the nonlabor resource., Change the transaction Date of the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_NLTXN_PERSON_ORG_MAND2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Type\",\n      \"ResolutionOptions\": \"Enter either a worker or a cost organization for the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Inactive or Invalid Reference Object\",\n      \"MessageTextKey\": \"PJC_NL_RSRC_INACTIVE2\",\n      \"ReferenceAttributes\": \"Nonlabor Resource, Nonlabor Resource Start Date, Nonlabor Resource End Date, Transaction Date\",\n      \"ResolutionOptions\": \"Change the active dates of the nonlabor resource., Change the transaction Date on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_AWARD_NOT_PROVIDED2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Batch , Project Name, Project Number\",\n      \"ResolutionOptions\": \"Enter an award for the sponsored project on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Project Definition\",\n      \"MessageTextKey\": \"PJC_BILLABLE_FLAG_INTERNAL_FS2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number, Funding Source Name\",\n      \"ResolutionOptions\": \"Change the billable status of the project cost transaction., Change the project on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Inactive or Invalid Reference Object\",\n      \"MessageTextKey\": \"PJC_TXN_DOC_IS_CMT_SRC2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Commitment Source Indicator\",\n      \"ResolutionOptions\": \"Change the transaction source of the transaction to one that isn't a commitment source.\"\n    },\n    {\n      \"ExceptionCategory\": \"Inactive or Invalid Reference Object\",\n      \"MessageTextKey\": \"PJC_EXPORG_NOTDENORM2\",\n      \"ReferenceAttributes\": \"Cost Organization\",\n      \"ResolutionOptions\": \"Run the Maintain Project Organizations process to enable this cost organization for project costs., Change the cost organization on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Grant Management\",\n      \"MessageTextKey\": \"PJC_GMS_EIDATE_NOTIN_AWDDATES2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number, Award Name, Award Number, Award Start Date, Award End Date, Transaction Date\",\n      \"ResolutionOptions\": \"Update the award dates., Change the transaction Date on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Inactive or Invalid Reference Object\",\n      \"MessageTextKey\": \"PJC_EXP_ORG_INACTIVE2\",\n      \"ReferenceAttributes\": \"Cost Organization, Cost Organization Classification Start Date, Cost Organization Classification End Date, Transaction Date\",\n      \"ResolutionOptions\": \"Ensure that the cost organization classification for the organization is active as of the transaction Date., Change the cost organization on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Inactive or Invalid Reference Object\",\n      \"MessageTextKey\": \"PJC_EXP_TYPE_SLF_INVL_COMBO2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Document Entry, Document Entry Cost Type Classification , Cost Type, Cost Type Classification  , Cost Type Classification Start Date, Cost Type Classification End Date\",\n      \"ResolutionOptions\": \"Change the cost type on the transaction to one that is classified with the same cost type classification used by the transaction source document entry.\"\n    },\n    {\n      \"ExceptionCategory\": \"Inactive or Invalid Reference Object\",\n      \"MessageTextKey\": \"PJC_EXPTYP_SLF_COMBO_INACTIVE2\",\n      \"ReferenceAttributes\": \"Cost Type, Cost Type Classification , Cost Type Classification Start Date, Cost Type Classification End Date, Transaction Date\",\n      \"ResolutionOptions\": \"Ensure that the cost type classification assigned to the cost type is active as of the transaction Date., Change the cost type on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Project Definition\",\n      \"MessageTextKey\": \"PJC_EXP_TASK_NOT_CHARGEABLE2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number, Task Name, Task Number\",\n      \"ResolutionOptions\": \"Enable the chargeable option on the task in the project plan., Change the task on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Inactive or Invalid Reference Object\",\n      \"MessageTextKey\": \"PJC_EXP_TYPE_INACTIVE2\",\n      \"ReferenceAttributes\": \"Cost Type, Cost Type Start Date, Cost Type End Date, Transaction Date\",\n      \"ResolutionOptions\": \"Change the effectivity dates of the cost type., Change the cost type on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Inactive or Invalid Reference Object\",\n      \"MessageTextKey\": \"PJC_EXP_TYPE_PU_INVALID2\",\n      \"ReferenceAttributes\": \"Cost Type, Project Unit\",\n      \"ResolutionOptions\": \"Ensure that the cost type is assigned to a data reference set used by the project's project unit., Change the cost type on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Project Definition\",\n      \"MessageTextKey\": \"PJC_EXP_TASK_EFF_DATES2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number, Task Name, Task Number, Task Transaction Start Date, Task Transaction End Date, Transaction Date\",\n      \"ResolutionOptions\": \"Update the task transaction dates., Change the transaction Date on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Inactive or Invalid Reference Object\",\n      \"MessageTextKey\": \"PJC_WORK_TYPE_PU_INVALID2\",\n      \"ReferenceAttributes\": \"Work Type, Project Unit\",\n      \"ResolutionOptions\": \"Ensure that the work type is assigned to a data reference set used by the project's project unit., Change the work type on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Project Definition\",\n      \"MessageTextKey\": \"PJC_EXP_TASK_NOT_LEAF_NODE2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number, Task Name, Task Number\",\n      \"ResolutionOptions\": \"Delete the subtasks under the task charged., Change the task on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Grant Management\",\n      \"MessageTextKey\": \"PJC_NOGMS_NONSPON_ERR2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number\",\n      \"ResolutionOptions\": \"Remove the contract and funding source values from the transaction., Change the project on the transaction to a sponsored project.\"\n    },\n    {\n      \"ExceptionCategory\": \"Grant Management\",\n      \"MessageTextKey\": \"PJC_FS_NOTVALID_FORSPONPRJ2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number, Award Name, Award Number, Funding Source Name\",\n      \"ResolutionOptions\": \"Change the funding source on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_FS_NOT_PROVIDED2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Batch , Project Name, Project Number\",\n      \"ResolutionOptions\": \"Enter a funding source for the sponsored project on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Project Cost Reversals\",\n      \"MessageTextKey\": \"PJC_ROTR_NOT_ALLOWED2\",\n      \"ReferenceAttributes\": \"Reversed Original Transaction Reference, Unmatched Transaction\",\n      \"ResolutionOptions\": \"Remove the reversed original transaction reference on the transaction., Change the unmatched negative transaction indicator to No for the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Grant Management\",\n      \"MessageTextKey\": \"PJC_SPONSPRJ_CNTRTLN_INACTIVE2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number, Award Name, Award Number\",\n      \"ResolutionOptions\": \"Ensure that the sponsored project's association with the contract line is active., Change the project on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Grant Management\",\n      \"MessageTextKey\": \"PJC_CONTRACT_LINE_INACTIVE2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number, Award Name, Award Number\",\n      \"ResolutionOptions\": \"Ensure that the sponsored project's associated contract line is active., Change the project on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Grant Management\",\n      \"MessageTextKey\": \"PJC_CONTRACT_INACTIVE2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number, Award Name, Award Number\",\n      \"ResolutionOptions\": \"Ensure that the sponsored project's associated contract is active., Change the project on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Grant Management\",\n      \"MessageTextKey\": \"PJC_NOFS_DERIVED2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number\",\n      \"ResolutionOptions\": \"Ensure that the sponsored project has an award., Change the project on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Grant Management\",\n      \"MessageTextKey\": \"PJC_NOAWD_DERIVED2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number\",\n      \"ResolutionOptions\": \"Ensure that the sponsored project has a funding source., Change the project on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Burdening\",\n      \"MessageTextKey\": \"PJC_PROJ_BURDEN_NOT_ALLOWED2\",\n      \"ReferenceAttributes\": \"Project Type, Transaction Source, Document Name\",\n      \"ResolutionOptions\": \"Remove the burdened cost from the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Project Cost Reversals\",\n      \"MessageTextKey\": \"PJC_NO_MATCHING_ITEM2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number\",\n      \"ResolutionOptions\": \"Change the transaction attributes to match an original transaction to reverse., Enable the unmatched negative item option for this negative transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Burdening\",\n      \"MessageTextKey\": \"PJC_PROJ_NOT_ALLOW_BURDEN_TXN2\",\n      \"ReferenceAttributes\": \"Project Type, Cost Type Classification \",\n      \"ResolutionOptions\": \"Enable burdening for the project's project type., Change the cost type classification to a value other than Burden Transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounted Cost Account Issues\",\n      \"MessageTextKey\": \"PJC_BURDEN_CR_CCID_INVALID2\",\n      \"ReferenceAttributes\": \"Burden Cost Credit Account Concatenated Segments, Burden Cost Credit Account Code Combination ID\",\n      \"ResolutionOptions\": \"Update the burden cost credit account for the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounted Cost Account Issues\",\n      \"MessageTextKey\": \"PJC_BURDENED_DR_CCID_NULL2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Batch \",\n      \"ResolutionOptions\": \"Update the transaction to add a burdened cost debit account.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounted Cost Account Issues\",\n      \"MessageTextKey\": \"PJC_BURDENED_CR_CCID_INVALID2\",\n      \"ReferenceAttributes\": \"Burdened Cost Credit Account Concatenated Segments, Burdened Cost Credit Account Code Combination ID\",\n      \"ResolutionOptions\": \"Update the burdened cost credit account for the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounted Cost Account Issues\",\n      \"MessageTextKey\": \"PJC_BURDENED_CR_CCID_NULL2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Batch \",\n      \"ResolutionOptions\": \"Update the transaction to add a burdened cost credit account.\"\n    },\n    {\n      \"ExceptionCategory\": \"Accounted Cost Account Issues\",\n      \"MessageTextKey\": \"PJC_BURDENED_DR_CCID_INVALID2\",\n      \"ReferenceAttributes\": \"Burdened Cost Debit Account Concatenated Segments, Burdened Cost Debit Account Code Combination ID\",\n      \"ResolutionOptions\": \"Update the burdened cost debit account for the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Unexpected System Error\",\n      \"MessageTextKey\": \"PJC_VI_TXN_PERSON_NOT_NULL2\",\n      \"ReferenceAttributes\": \"Worker\",\n      \"ResolutionOptions\": \"N/a.\"\n    },\n    {\n      \"ExceptionCategory\": \"Grant Management\",\n      \"MessageTextKey\": \"PJC_INTFS_BURD_NOT_ALLOWED2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number, Award Name, Award Number, Funding Source Name\",\n      \"ResolutionOptions\": \"Enable burdening for the sponsored project, award, and internal funding source combination., Remove the burden cost from the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJC_ACCT_BURDENED_COST_NULL2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document Name, Cost Batch , Provider Ledger Currency Code\",\n      \"ResolutionOptions\": \"Enter a burdened cost in provider ledger currency for the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Grant Management\",\n      \"MessageTextKey\": \"GMS_AWD_NOTVALID_FORSPONPRJ2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number, Award Name, Award Number\",\n      \"ResolutionOptions\": \"Associate the sponsored project with the award., Change the project on the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Grant Management\",\n      \"MessageTextKey\": \"GMS_NOBPFORAWARD2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number, Award Name, Award Number, Transaction Date\",\n      \"ResolutionOptions\": \"Update the award dates or the award budget periods to ensure a budget period exists for the budget date.\"\n    },\n    {\n      \"ExceptionCategory\": \"Inactive or Invalid Reference Object\",\n      \"MessageTextKey\": \"PJC_TXN_DOC_INACTIVE2\",\n      \"ReferenceAttributes\": \"Transaction Source, Document\",\n      \"ResolutionOptions\": \"Change the date of the transaction., Change the effective dates of the transaction source document.\"\n    },\n    {\n      \"ExceptionCategory\": \"Budgetary Control\",\n      \"MessageTextKey\": \"PJC_XCC_BC_FR_FAIL2\",\n      \"ReferenceAttributes\": \"Project Name, Project Number\",\n      \"ResolutionOptions\": \"Modify the control budget to provide funds for this transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Derivation Failure or Missing Attribute\",\n      \"MessageTextKey\": \"PJF_PROJ_ROLE_MAND_FOR_COST2\",\n      \"ReferenceAttributes\": \"Worker Name, Worker Number, Transaction Date\",\n      \"ResolutionOptions\": \"Enter a project role for the transaction.\"\n    },\n    {\n      \"ExceptionCategory\": \"Rate Definition\",\n      \"MessageTextKey\": \"PJF_PRICE_NO_PROJ_ROLE_RATE2\",\n      \"ReferenceAttributes\": \"Project Role, Cost Rate Schedule Name, Transaction Date\",\n      \"ResolutionOptions\": \"Enter a project role cost rate in the appropriate rate schedule effective as of the project cost date.\"\n    }\n\n  ]\n}"
            }
          ],
