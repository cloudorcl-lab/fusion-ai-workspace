                    "name": "Message Text Key",
                    "returnType": "string",
                    "sourceCode": "// 1. Define the target keys to look for\nvar personTargetKeys = [\n    \"PJC_FAILED_TO_DRV_HCM_JOB2\",\n    \"PJC_FAILED_TO_DRV_HCM_ORGN2\",\n    \"PJC_FAILED_TO_DRV_HCM_PTYPE2\",\n    \"PJC_FAILED_TO_DRV_HCM_ASSGN2\",\n    \"PJF_PRICE_NO_PERSON_RATE2\"\n];\n\n// 2. Data Assignment & Normalization\nvar rawInput = $context.$variables.prjPjcVarConvExceptionDetails; \nvar items = [];\n\nif (rawInput) {\n    items = Array.isArray(rawInput) ? rawInput : [rawInput];\n}\n\nvar foundMatch = false;\n\n// 3. Parse and Check for keys\nfor (var i = 0; i < items.length; i++) {\n    try {\n        var record = typeof items[i] === 'string' ? JSON.parse(items[i]) : items[i];\n        var key = record.MessageTextKey;\n\n        // Check if the current key exists in our renamed target list\n        if (key && personTargetKeys.indexOf(key) !== -1) {\n            foundMatch = true;\n            break; \n        }\n    } catch (e) {\n        continue;\n    }\n}\n\n// 4. Return \"PERSONDETAILS\" if a match is found\nif (foundMatch) {\n    return \"PERSONDETAILS\";\n}\n\n// Optional: Define what happens if NO match is found\nreturn \"NOMATCHFOUND\";"
                  },
                  "outcomes": {
                    "success": "1773744035832"
                  },
