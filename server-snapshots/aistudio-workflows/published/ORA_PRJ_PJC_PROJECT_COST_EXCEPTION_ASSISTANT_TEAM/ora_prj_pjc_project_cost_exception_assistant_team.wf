  "name": "Project Cost Exceptions Assistant",
  "description": "Assists project accountants in identifying and analyzing unprocessed project cost exceptions. This assistant streamlines exception investigation and resolution by summarizing and categorizing exceptions and proposing resolution options for each type of exception.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
