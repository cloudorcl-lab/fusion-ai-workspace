              "scope": "JOB",
              "type": "array",
              "value": "{\n  \"DisplaytoAttributeMap\": [\n    {\n      \"DisplayValue\": \"Cost Batch\",\n      \"AttributeName\": \"costBatch\",\n      \"Searchable\": \"Yes\",\n      \"Synonyms\": \"cost batch, batch name, cost batch id, cost batch reference, batch\"\n    },\n    {\n      \"DisplayValue\": \"Project Role\",\n      \"AttributeName\": \"projectRole\",\n      \"Searchable\": \"No\",\n      \"Synonyms\": \"project role\"\n    },\n    {\n      \"DisplayValue\": \"Unmatched Transaction\",\n      \"AttributeName\": \"unmatchedNegativeTransactionIndicator\",\n      \"Searchable\": \"Yes\",\n      \"Synonyms\": \"unmatched negative flag, negative transaction flag, unmatched transaction flag\"\n    },\n    {\n      \"DisplayValue\": \"Creation Date\",\n      \"AttributeName\": \"creationDate\",\n      \"Searchable\": \"Yes\",\n      \"Synonyms\": \"created date, date created, record creation date, created on, date of creation\"\n    },\n    {\n      \"DisplayValue\": \"Project Number\",\n      \"AttributeName\": \"projectNumber\",\n      \"Searchable\": \"Yes\",\n      \"Synonyms\": \"project no, project id, project identifier, project reference number, project code\"\n    },\n    {\n      \"DisplayValue\": \"Project Name\",\n      \"AttributeName\": \"projectName\",\n      \"Searchable\": \"Yes\",\n      \"Synonyms\": \"project title, project, project label, project description, project name\"\n    },\n    {\n      \"DisplayValue\": \"Billable\",\n      \"AttributeName\": \"billable\",\n      \"Searchable\": \"Yes\",\n      \"Synonyms\": \"billable flag, billable indicator\"\n    },\n    {\n      \"DisplayValue\": \"Capitalizable\",\n      \"AttributeName\": \"capitalizable\",\n      \"Searchable\": \"Yes\",\n      \"Synonyms\": \"capitalizable flag, capitalizable indicator, assetizable, capitalization flag\"\n    },\n    {\n      \"DisplayValue\": \"Task Number\",\n      \"AttributeName\": \"taskNumber\",\n      \"Searchable\": \"Yes\",\n      \"Synonyms\": \"task no, task id, task identifier, task reference number, task code\"\n    },\n    {\n      \"DisplayValue\": \"Transaction Source\",\n      \"AttributeName\": \"transactionSourceName\",\n      \"Searchable\": \"Yes\",\n      \"Synonyms\": \"source name, transaction source, source system name, import source name, transaction origin\"\n    },\n    {\n      \"DisplayValue\": \"Task Name\",\n      \"AttributeName\": \"taskName\",\n      \"Searchable\": \"Yes\",\n      \"Synonyms\": \"task title, task label, task description\"\n    },\n    {\n      \"DisplayValue\": \"Task Transaction Start Date\",\n      \"AttributeName\": \"taskTransactionStartDate\",\n      \"Searchable\": \"Yes\",\n      \"Synonyms\": \"task start date, transaction start date\"\n    },\n    {\n      \"DisplayValue\": \"Task Transaction End Date\",\n      \"AttributeName\": \"taskTransactionEndDate\",\n      \"Searchable\": \"Yes\",\n      \"Synonyms\": \"task end date, transaction end date; task finish date\"\n    },\n    {\n      \"DisplayValue\": \"Transaction Date\",\n      \"AttributeName\": \"transactionDate\",\n      \"Searchable\": \"Yes\",\n      \"Synonyms\": \"project cost date, expenditure item date, cost date, expense date, expenditure date\"\n    },\n    {\n      \"DisplayValue\": \"Transaction Date\",\n      \"AttributeName\": \"transactionDate\",\n      \"Searchable\": \"Yes\",\n      \"Synonyms\": \"project cost date, expenditure item date, cost date, expense date, expenditure date\"\n    },\n    {\n      \"DisplayValue\": \"Rate Schedule\",\n      \"AttributeName\": \"rateScheduleName\",\n      \"Searchable\": \"No\",\n      \"Synonyms\": \"rate schedule name, rate plan name, pricing schedule name, schedule name\"\n    },\n    {\n      \"DisplayValue\": \"Unprocessed Transaction Reference\",\n      \"AttributeName\": \"unprocessedProjectCostTransactionId\",\n      \"Searchable\": \"Yes\",\n      \"Synonyms\": \"unprocessed transaction reference id, unprocessed cost transaction id, transaction reference id, unprocessed project cost ref id\"\n    },\n    {\n      \"DisplayValue\": \"Burden Cost Credit Account Code Combination ID\",\n      \"AttributeName\": \"burdenCostCreditAccountCodeCombinationId\",\n      \"Searchable\": \"No\",\n      \"Synonyms\": \"burden cost credit account, burden cost credit\"\n    },\n    {\n      \"DisplayValue\": \"Burden Cost Debit Account Code Combination ID\",\n      \"AttributeName\": \"burdenCostDebitAccountCodeCombinationId\",\n      \"Searchable\": \"No\",\n      \"Synonyms\": \"burden cost debit account, burden cost debit\"\n    },\n    {\n      \"DisplayValue\": \"Burdened Cost Credit Account Code Combination ID\",\n      \"AttributeName\": \"burdenedCostCreditAccountCodeCombinationId\",\n      \"Searchable\": \"No\",\n      \"Synonyms\": \"burdened cost credit account, burdened cost credit\"\n    },\n    {\n      \"DisplayValue\": \"Burdened Cost Debit Account Code Combination ID\",\n      \"AttributeName\": \"burdenedCostDebitAccountCodeCombinationId\",\n      \"Searchable\": \"No\",\n      \"Synonyms\": \"burdened cost debit account, burdened cost debit\"\n    },\n    {\n      \"DisplayValue\": \"Original Transaction Reference\",\n      \"AttributeName\": \"originalTransactionReference\",\n      \"Searchable\": \"Yes\",\n      \"Synonyms\": \"original reference, source transaction reference, original ref, transaction reference, source ref, orig trx ref\"\n    },\n    {\n      \"DisplayValue\": \"Provider Ledger Currency Burdened Cost Amount\",\n      \"AttributeName\": \"providerLedgerCurrencyBurdenedCostAmount\",\n      \"Searchable\": \"No\",\n      \"Synonyms\": \"provider burdened cost amount, burdened cost amount, provider burdened amount\"\n    },\n    {\n      \"DisplayValue\": \"Provider Ledger Currency Raw Cost Amount\",\n      \"AttributeName\": \"providerLedgerCurrencyRawCostAmount\",\n      \"Searchable\": \"No\",\n      \"Synonyms\": \"provider raw cost amount, raw cost amount, provider raw amount\"\n    },\n    {\n      \"DisplayValue\": \"Provider Ledger Currency Code\",\n      \"AttributeName\": \"providerLedgerCurrencyCode\",\n      \"Searchable\": \"No\",\n      \"Synonyms\": \"provider currency code, ledger currency, provider ledger currency, currency code\"\n    },\n    {\n      \"DisplayValue\": \"Receiver Ledger Currency Code\",\n      \"AttributeName\": \"receiverLedgerCurrencyCode\",\n      \"Searchable\": \"No\",\n      \"Synonyms\": \"receiver currency code, receiver ledger currency\"\n    },\n    {\n      \"DisplayValue\": \"Transaction Currency Code\",\n      \"AttributeName\": \"transactionCurrencyCode\",\n      \"Searchable\": \"No\",\n      \"Synonyms\": \"transaction currency code, transaction currency, trx currency code, trx currency\"\n    },\n    {\n      \"DisplayValue\": \"Project Currency Code\",\n      \"AttributeName\": \"projectCurrencyCode\",\n      \"Searchable\": \"No\",\n      \"Synonyms\": \"project currency\"\n    },\n    {\n      \"DisplayValue\": \"Raw Cost Debit Account Code Combination ID\",\n      \"AttributeName\": \"rawCostDebitAccountCodeCombinationId\",\n      \"Searchable\": \"No\",\n      \"Synonyms\": \"raw cost debit account, raw cost debit\"\n    },\n    {\n      \"DisplayValue\": \"Raw Cost Credit Account Code Combination ID\",\n      \"AttributeName\": \"rawCostCreditAccountCodeCombinationId\",\n      \"Searchable\": \"No\",\n      \"Synonyms\": \"raw cost credit account, raw cost credit\"\n    },\n    {\n      \"DisplayValue\": \"Reversed Original Transaction Reference\",\n      \"AttributeName\": \"reversedOriginalTransactionReference\",\n      \"Searchable\": \"No\",\n      \"Synonyms\": \"reversed reference, reversal reference, reversed original ref, original transaction reversal, reversal transaction reference\"\n    },\n    {\n      \"DisplayValue\": \"Transaction Burdened Cost Amount\",\n      \"AttributeName\": \"transactionBurdenedCostAmount\",\n      \"Searchable\": \"No\",\n      \"Synonyms\": \"burdened cost amount, transaction burdened amount, txn burdened cost, burdened amount\"\n    },\n    {\n      \"DisplayValue\": \"Transaction Raw Cost Amount\",\n      \"AttributeName\": \"transactionRawCostAmount\",\n      \"Searchable\": \"No\",\n      \"Synonyms\": \"raw cost amount, transaction raw amount, transaction cost amount, raw amount, transaction amount\"\n    },\n    {\n      \"DisplayValue\": \"Transaction Quantity\",\n      \"AttributeName\": \"transactionQuantity\",\n      \"Searchable\": \"No\",\n      \"Synonyms\": \"quantity, units, transaction units, qty\"\n    },\n    {\n      \"DisplayValue\": \"Project Start Date\",\n      \"AttributeName\": \"projectStartDate\",\n      \"Searchable\": \"Yes\",\n      \"Synonyms\": \"project begin date, project commencement date, effective start date, project launch date\"\n    },\n    {\n      \"DisplayValue\": \"Project Finish Date\",\n      \"AttributeName\": \"projectFinishDate\",\n      \"Searchable\": \"Yes\",\n      \"Synonyms\": \"project end date, completion date, project closure date, end date\"\n    },\n    {\n      \"DisplayValue\": \"Project Status\",\n      \"AttributeName\": \"projectStatusName\",\n      \"Searchable\": \"Yes\",\n      \"Synonyms\": \"project status, status name, project lifecycle status, status\"\n    },\n    {\n      \"DisplayValue\": \"Project Unit\",\n      \"AttributeName\": \"projectUnitName\",\n      \"Searchable\": \"Yes\",\n      \"Synonyms\": \"project unit, unit name, project org unit\"\n    },\n    {\n      \"DisplayValue\": \"Project Type\",\n      \"AttributeName\": \"projectTypeName\",\n      \"Searchable\": \"Yes\",\n      \"Synonyms\": \"project type, type name\"\n    },\n    {\n      \"DisplayValue\": \"Burden Cost Debit Account Concatenated Segments\",\n      \"AttributeName\": \"burdenCostDebitAccountConcatenatedSegments\",\n      \"Searchable\": \"No\",\n      \"Synonyms\": \"burden cost debit segments, burden  debit concatenated account segments, 