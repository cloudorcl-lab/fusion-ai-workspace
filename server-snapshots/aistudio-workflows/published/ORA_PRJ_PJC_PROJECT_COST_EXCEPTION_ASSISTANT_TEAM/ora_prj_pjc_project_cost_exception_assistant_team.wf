          },
          "code": "PRJ_PJC_SET_VARIABLE_SET_SESSION_INFO",
          "id": "1774452172234",
          "inputs": [
            {
              "id": "1774452179278",
              "name": "prjPjcVarConvUserSessionInfo",
              "scope": "JOB",
              "type": "object",
              "value": "{{$context.$nodes.PRJ_PJC_USERSESSION_TOOL_USER_SESSION_TOOL.$output}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Category group HTML Content",
            "returnType": "string",
            "sourceCode": "// 1. Data Assignment\nvar categoriesInput = $context.$nodes.PRJ_PJC_CODE_RETURN_CATEGORIES.$output.result;\nvar filterData = $context.$variables.prjPjcVarConvFilter;\n\n// Directly read date ranges from variables\nvar creationDateRange = $context.$variables.prjPjcVarConvCreationDateDaysRange;\nvar projectCostDateRange = $context.$variables.prjPjcVarConvProjectCostDateDaysRange;\nvar projectAccountingDateRange = $context.$variables.prjPjcVarConvProjectAccountingDateDaysRange;\n\n// Helper to suppress empty quotes / blank values\nfunction cleanDisplayValue(val) {\n    if (val === null || val === undefined) {\n        return \"\";\n    }\n\n    var str = String(val).trim();\n\n    if (\n        str === \"\" ||\n        str === '\"\"' ||\n        str === \"''\" ||\n        str === '\" \"' ||\n        str === \"' '\" ||\n        str.toLowerCase() === \"null\" ||\n        str.toLowerCase() === \"undefined\"\n    ) {\n        return \"\";\n    }\n\n    // Remove only outer matching quotes\n    str = str.replace(/^'(.*)'$/, \"$1\").replace(/^\"(.*)\"$/, \"$1\");\n\n    return str;\n}\n\n// Clean date ranges\ncreationDateRange = cleanDisplayValue(creationDateRange);\nprojectCostDateRange = cleanDisplayValue(projectCostDateRange);\nprojectAccountingDateRange = cleanDisplayValue(projectAccountingDateRange);\n\nvar totalExceptionCount = 0;\nvar tableRowsHtml = \"\";\nvar costCategoryList = [];\nvar parsedInput = null;\n\n// 2. Parse Input for Cost Categories\nif (typeof categoriesInput === \"string\") {\n    try {\n        parsedInput = JSON.parse(categoriesInput);\n    } catch (e) {\n        parsedInput = null;\n    }\n} else {\n    parsedInput = categoriesInput;\n}\n\nif (parsedInput) {\n    // Check if SummarizedRows is the wrapper or if it's a direct array\n    var dataField = parsedInput.SummarizedRows || parsedInput.CostCategory || parsedInput.costCategory;\n    if (dataField && Array.isArray(dataField)) {\n        costCategoryList = dataField;\n    } else if (Array.isArray(parsedInput)) {\n        costCategoryList = parsedInput;\n    }\n}\n\n// 3. Build Table Rows Loop (Only if data exists)\nvar hasData = costCategoryList && costCategoryList.length > 0;\n\nif (hasData) {\n    for (var i = 0; i < costCategoryList.length; i++) {\n        var rowData = costCategoryList[i];\n        if (rowData) {\n            var catName = cleanDisplayValue(rowData.ExceptionCategory) || \"NULL\";\n            var countValue = parseInt(rowData.Count, 10);\n            if (isNaN(countValue)) { countValue = 0; }\n\n            var serialNo = rowData.SerialNumber || (i + 1);\n            totalExceptionCount = totalExceptionCount + countValue;\n\n            tableRowsHtml = tableRowsHtml +\n                '<tr>' +\n                    '<td style=\"padding:8px 10px; border:1px solid #E4E1DD; text-align:center;\">' + serialNo + '</td>' +\n                    '<td style=\"padding:8px 10px; border:1px solid #E4E1DD; white-space:normal; overflow-wrap:anywhere; word-wrap:break-word;\">' + catName + '</td>' +\n                    '<td style=\"padding:8px 10px; border:1px solid #E4E1DD; text-align:right;\">' + countValue + '</td>' +\n                '</tr>';\n        }\n    }\n}\n\n// 4. Parse Filter Criteria Loop\nvar filterDisplayLines = \"\";\nvar rawFilters = (filterData && filterData.Filter) ? filterData.Filter : [];\nvar filterList = Array.isArray(rawFilters) ? rawFilters : (rawFilters ? [rawFilters] : []);\n\nif (filterList.length > 0) {\n    for (var j = 0; j < filterList.length; j++) {\n        var filterItem = filterList[j];\n        if (filterItem) {\n            var label = filterItem.DisplayLabel || \"NULL\";\n            var attrName = (filterItem.AttributeName || \"\").toLowerCase();\n            var value = cleanDisplayValue(filterItem.AttributeValue);\n            var displayValue = value;\n\n            if (attrName.indexOf(\"creationdate\") !== -1) {\n                displayValue = creationDateRange || value;\n            } else if (attrName.indexOf(\"transactiondate\") !== -1) {\n                displayValue = projectCostDateRange || value;\n            } else if (attrName.indexOf(\"projectaccountingdate\") !== -1) {\n                displayValue = projectAccountingDateRange || value;\n            }\n\n            displayValue = cleanDisplayValue(displayValue);\n\n            if (displayValue !== \"\") {\n                filterDisplayLines =\n                    filterDisplayLines +\n                    \"<tr>\" +\n                        '<td style=\"padding:2px 12px 2px 0; vertical-align:top; white-space:nowrap;\">' + label + \":</td>\" +\n                        '<td style=\"padding:2px 0; vertical-align:top;\">' + displayValue + \"</td>\" +\n                    \"</tr>\";\n            }\n        }\n    }\n}\n\n// 5. Build Components\nvar headerBlock =\n'<div style=\"font-family:\\'Oracle Sans\\', Arial, sans-serif; font-size:13; margin:10px 0 0 0;\">' +\n  '<div style=\"margin:6px 0 0 0;\">' +\n    \"I've found <b> \" + totalExceptionCount + \" </b> exceptions using this criteria:<br/>\" +\n    '<table style=\"margin-top:6px; border-collapse:collapse; font-family:\\'Oracle Sans\\', Arial, sans-serif; font-size:13; color:#1f1f1f;\">' +\n      '<tbody>' +\n        filterDisplayLines +\n      '</tbody>' +\n    '</table>' +\n  '</div>' +\n'</div>';\n\nvar tableBlock = \"\";\nif (hasData) {\n    tableBlock =\n    '<table style=\"width:100%; border-collapse:collapse; font-family:\\'Oracle Sans\\', Arial, sans-serif; font-size:12; margin-top:12px;\">' +\n      '<thead>' +\n        '<tr>' +\n          '<th style=\"padding:8px 10px; border:1px solid #E4E1DD; text-align:center; white-space:nowrap; font-weight:800;\">No.</th>' +\n          '<th style=\"padding:8px 10px; border:1px solid #E4E1DD; text-align:left; white-space:nowrap; font-weight:800;\">Exception Category</th>' +\n          '<th style=\"padding:8px 10px; border:1px solid #E4E1DD; text-align:right; white-space:nowrap; font-weight:800;\">Count</th>' +\n        '</tr>' +\n      '</thead>' +\n      '<tbody>' +\n        tableRowsHtml +\n      '</tbody>' +\n    '</table>';\n}\n\nvar separator = '<hr style=\"border:none; height:10px; margin:0; visibility:hidden;\">';\n\nvar footerBlock = \"\";\nif (hasData) {\n    footerBlock =\n    '<div style=\"font-family:\\'Oracle Sans\\', Arial, sans-serif; font-size:13; margin:10px 0 0 0;\">' +\n      '<div style=\"margin:6px 0 0 0;\">' +\n        'Enter the <b>number</b> or <b>name</b> of one exception category to see a summary of exception types. Or enter additional filter criteria to further refine the exceptions.' +\n      '</div>' +\n    '</div>';\n} else {\n    // Empty/Missing State Footer\n    footerBlock =\n    '<div style=\"font-family:\\'Oracle Sans\\', Arial, sans-serif; font-size:13; color:#1f1f1f; margin:10px 0 0 0;\">' +\n      '<div style=\"margin:6px 0 0 0;\">' +\n        'Revise your filter criteria or enter <b>\"Get all exceptions\"</b> to initiate another query.' +\n      '</div>' +\n    '</div>';\n}\n\nreturn headerBlock + separator + tableBlock + footerBlock;"
