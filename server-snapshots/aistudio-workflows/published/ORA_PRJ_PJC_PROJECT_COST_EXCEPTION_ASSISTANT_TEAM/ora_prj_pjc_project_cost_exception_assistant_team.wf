        {
          "metadata": {
            "name": "Combine Message RAG With Text",
            "returnType": "object",
            "sourceCode": "// 1. Data Assignment\nvar ragData = $context.$variables.prjPjcVarConvMessageRAG;\nvar textData = $context.$variables.prjPjcVarConvMessageText;\n\nvar ragMessages = (ragData && Array.isArray(ragData.messages)) ? ragData.messages : [];\nvar textMessages = (textData && Array.isArray(textData.messages)) ? textData.messages : [];\n\nvar combinedMessages = [];\n\n// 2. Processing Logic\nfor (var i = 0; i < ragMessages.length; i++) {\n    var ragItem = ragMessages[i];\n    var currentKey = ragItem.MessageTextKey;\n\n    // Skip entries with empty MessageTextKey if necessary\n    if (!currentKey) {\n        combinedMessages.push(ragItem);\n        continue;\n    }\n\n    // Initialize the new object with RAG data\n    var combinedItem = JSON.parse(JSON.stringify(ragItem));\n\n    // Find the primary Message Text\n    var primaryTextMatch = textMessages.find(function(t) {\n        return t.MessageTextKey === currentKey;\n    });\n\n    // Find the Detailed Message Text (usually ends in _Detail)\n    var detailedTextMatch = textMessages.find(function(t) {\n        return t.MessageTextKey === currentKey + \"_Detail\";\n    });\n\n    // 3. Merging Attributes\n    if (primaryTextMatch) {\n        combinedItem.MessageText = primaryTextMatch.MessageText;\n    } else {\n        combinedItem.MessageText = \"\"; // Fallback if no text found\n    }\n\n    if (detailedTextMatch) {\n        combinedItem.MessageDetailText = detailedTextMatch.MessageText;\n    } else {\n        combinedItem.MessageDetailText = \"\"; \n    }\n\n    combinedMessages.push(combinedItem);\n}\n\n// 4. Final Output Structure\nvar result = {\n    \"CombinedMessages\": combinedMessages\n};\n\nreturn JSON.stringify(result);"
          },
          "outcomes": {
            "success": "1772823600623"
          },
          "code": "PRJ_PJC_CODE_COMBINE_MESSAGE_RAG_WITH_TEXT",
          "convergenceTargetId": "1772823346949",
          "id": "1772822767502",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
