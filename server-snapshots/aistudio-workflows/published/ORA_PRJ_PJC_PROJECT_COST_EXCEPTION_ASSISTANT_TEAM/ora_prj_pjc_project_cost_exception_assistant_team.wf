        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.75
              },
              "code": "ORA_LLM_MODEL_PROVIDER_CERT_BASIC_LLAMA_3_3_70B",
              "model": "ORA_LLM_MODEL_GPT_OSS_120B",
              "modelName": "Gpt Oss",
              "provider": "CERT_BASIC"
            },
            "name": "Extract Dates Range"
          },
          "outcomes": {
            "success": "1771582709674"
          },
          "code": "PRJ_PJC_LLM_EXTRACT_DATES_RANGE",
          "convergenceTargetId": "1771582709674",
          "id": "1773846899283",
          "inputs": [
            {
              "id": "1773846899284_1",
              "name": "prompt",
              "type": "string",
              "value": "Here is a cleaner and more explicit version of your prompt:\n\nExtract DateFormat from {{$context.$variables.prjPjcVarConvUserSessionInfo}} , which is <user session date format>.\n\nThe source dates are in DD-MM-YYYY format. Convert the following date ranges into the <user session date format> specified by DateFormat:\n\n* **CreationDateRangeInUserFormat** = apply the <user session date format> to the start date and end date in extractedCreationDateRange in {{$context.$nodes.PRJ_PJC_CODE_RETURN_CREATION_DATE_RANGE.$output.result}}\n* **ProjectCostDateRangeInUserFormat** = apply the <user session date format> to the start date and end date in  extractedProjectCostDateRange in {{$context.$nodes.PRJ_PJC_CODE_RETURN_PROJECT_COST_DATE_RANGE.$output.result}}\n* **ProjectAccountingDateRangeInUserFormat** = apply the <user session date format> to the start date and end date in extractedProjectAccountingDateRange range in {{$context.$nodes.PRJ_PJC_CODE_RETURN_PROJECT_ACCOUNTING_DATE_RANGE.$output.result}}\n\nReturn only the converted output in the same structure, with all dates formatted according to the user session DateFormat."
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"ProjectAccountingDateRangeInUserFormat\": {\n            \"type\": \"string\"\n        },\n        \"CreationDateRangeInUserFormat\": {\n            \"type\": \"string\"\n        },\n        \"ProjectCostDateRangeInUserFormat\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Category Group JSON Content",
            "returnType": "string",
            "sourceCode": "var d = $context.$nodes.PRJ_PJC_CODE_RETURN_CATEGORIES.$output.result;\n\nif (typeof d === 'string') {\n  try {\n    d = JSON.parse(d);\n  } catch (e) {\n    d = [];\n  }\n}\n\nvar r = Array.isArray(d)\n  ? d\n  : ((d && (d.SummarizedRows || d.CostCategory || d.costCategory)) || []);\n\nvar f = $context.$variables.prjPjcVarConvFilter || {};\n\nvar fs = Array.isArray(f.Filter)\n  ? f.Filter\n  : (f.Filter ? [f.Filter] : []);\n\nvar a = $context.$variables.prjPjcVarConvCreationDateDaysRange;\nvar b = $context.$variables.prjPjcVarConvProjectCostDateDaysRange;\nvar c = $context.$variables.prjPjcVarConvProjectAccountingDateDaysRange;\n\nvar crit = [];\nvar rows = [];\nvar list = [];\nvar t = 0;\n\nfor (var i = 0; i < fs.length; i++) {\n  var x = fs[i] || {};\n  var k = String(x.AttributeName || '').toLowerCase();\n  var v = x.AttributeValue;\n\n  if (k.indexOf('creationdate') !== -1 && a) {\n    v = a;\n  } else if (k.indexOf('transactiondate') !== -1 && b) {\n    v = b;\n  } else if (k.indexOf('projectaccountingdate') !== -1 && c) {\n    v = c;\n  }\n\n  if (v !== null && v !== undefined && String(v).trim() !== '') {\n    crit.push(\n      (x.DisplayLabel || 'Filter') +\n      ': ' +\n      String(v).replace(/^['\"]|['\"]$/g, '')\n    );\n  }\n}\n\nfor (var j = 0; j < r.length; j++) {\n  var y = r[j] || {};\n  var n = String(y.SerialNumber || (j + 1));\n  var cnt = parseInt(y.Count, 10);\n\n  if (isNaN(cnt)) {\n    cnt = 0;\n  }\n\n  t += cnt;\n\n  var cat = String(y.ExceptionCategory || 'Uncategorized');\n\n  rows.push({\n    no: n,\n    exceptionCategory: cat,\n    count: String(cnt)\n  });\n\n  list.push({\n    id: n,\n    Default: n + ' - ' + cat,\n    value: n\n  });\n}\n\nvar dt = String($context.$system.$currentDateTime || '');\n\nvar ts = dt\n  ? dt.slice(8, 10) + '-' +\n    dt.slice(5, 7) + '-' +\n    dt.slice(0, 4) + ' ' +\n    dt.slice(11, 16)\n  : String($context.$system.$currentDate || '');\n\nvar filterSuffix = crit.length\n  ? '