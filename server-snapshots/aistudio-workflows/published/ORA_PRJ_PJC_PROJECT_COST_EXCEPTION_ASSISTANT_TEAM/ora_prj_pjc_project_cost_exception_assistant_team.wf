              "type": "string",
              "value": "{{$context.$nodes.PRJ_PJC_CODE_CHECK_SOURCE.$output.result == \"RedwoodUI\" ? $context.$nodes.PRJ_PJC_CODE_EXCEPTION_TYPE_GROUP_DISPLAY_JSONCODE_2.$output.result : $context.$nodes.PRJ_PJC_CODE_EXCEPTION_TYPE_GROUP_DISPLAY_HTMLCODE_2.$output.result}}"
