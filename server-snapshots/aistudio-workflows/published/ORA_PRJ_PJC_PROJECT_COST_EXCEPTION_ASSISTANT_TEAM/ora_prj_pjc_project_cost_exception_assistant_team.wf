        {
          "metadata": {
            "name": "Return Exception Types 1",
            "returnType": "object",
            "sourceCode": "// 1. Initialize variables from context\nvar summarizedData = $context.$variables.prjPjcVarConvSummarizedData;\nvar messageRagData = $context.$variables.prjPjcVarConvMessageRagWithText;\n\n// 2. Safely extract arrays - using the specific constraint requested\nvar rows = (summarizedData && Array.isArray(summarizedData)) ? summarizedData : [];\n\n// Accessing messages from the RAG variable\nvar msgs = (messageRagData && Array.isArray(messageRagData.CombinedMessages)) ? messageRagData.CombinedMessages : [];\n\nvar outputRows = [];\n\n// 3. Process each summarized row\nfor (var i = 0; i < rows.length; i++) {\n    var technicalName = rows[i].MessageTextKey;\n    var rowCount = rows[i].Count;\n    \n    // Updated fallbacks\n    var descriptiveText = \"Unknown Exception Type\"; \n    var categoryName = \"Uncategorized Exception\"; \n    var descriptiveTextDetail;\n\n    // 4. Match MessageTextKey to MessageText and ExceptionCategory\n    // NOTE: If this loop doesn't find 'technicalName' in 'msgs', \n    // it remains \"Uncategorized Exception\".\n    for (var j = 0; j < msgs.length; j++) {\n        if (msgs[j].MessageTextKey === technicalName) {\n            descriptiveText = msgs[j].MessageText || descriptiveText;\n            categoryName = msgs[j].ExceptionCategory || categoryName;\n            descriptiveTextDetail = msgs[j].MessageDetailText;\n            break; \n        }\n    }\n\n    // 5. Add to the new output array\n    outputRows.push({\n        \"SerialNumber\": i + 1,\n        \"ExceptionCategory\": categoryName,\n        \"ExceptionType\": descriptiveText,\n        \"ExceptionTypeDetail\":descriptiveTextDetail,\n        \"Count\": rowCount\n    });\n}\n\n// 6. Return final JSON string\nreturn JSON.stringify({ \"SummarizedRows\": outputRows });"
