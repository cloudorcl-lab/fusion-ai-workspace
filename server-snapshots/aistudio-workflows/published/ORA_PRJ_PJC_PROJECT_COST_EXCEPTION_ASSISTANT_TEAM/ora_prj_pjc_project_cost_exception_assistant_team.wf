          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"SummarizedRows\": {\n            \"type\": \"array\",\n            \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n                        \"MessageTextKey\": {\n                                        \"type\": \"string\"\n                               },\n                                \"Count\":{\n                                        \"type\": \"integer\"\n                                }\n\n\n}\n            }\n        }\n    }\n}",
