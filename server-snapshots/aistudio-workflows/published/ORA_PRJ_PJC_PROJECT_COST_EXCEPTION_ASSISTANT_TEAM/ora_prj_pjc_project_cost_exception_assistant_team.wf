        {
          "metadata": {
            "name": "Unprocessed Data Payload",
            "returnType": "string",
            "sourceCode": "// 1. Retrieve data from Context Nodes & Variables\nvar filterString = $context.$nodes.PRJ_PJC_CODE_CREATE_FILTER_STRING.$output.result || \"\";\nvar selectList = $context.$nodes.PRJ_PJC_CODE_SELECT_CLAUSE.$output.result || \"\";\nvar messageKeys = $context.$nodes.PRJ_PJC_CODE_MESSAGE_TEXT_KEY_CLAUSE.$output.result || \"\";\n\n// --- GENERIC FLAG EXTRACTION ---\n// Handles both Array and Object structures for additional attributes\nvar rawAddRefAttrs = $context.$variables.prjPjcVarConvAdditionalReferenceAttributes;\nvar refFlags = {}; \n\nif (rawAddRefAttrs) {\n    var attrList = Array.isArray(rawAddRefAttrs) ? rawAddRefAttrs : [rawAddRefAttrs];\n    \n    for (var i = 0; i < attrList.length; i++) {\n        var attrObj = attrList[i];\n        for (var key in attrObj) {\n            if (attrObj.hasOwnProperty(key)) {\n                refFlags[key] = attrObj[key];\n            }\n        }\n    }\n}\n\n// 2. Logic to append attributes based on flags\n// Specifically checking for CostTypeClassificationInfoNeeded\nif (refFlags[\"CostTypeClassificationInfoNeeded\"] === \"Y\") {\n    if (selectList.indexOf(\"costTypeId\") === -1) {\n        selectList += (selectList.length > 0 ? \", \" : \"\") + \"costTypeId,costTypeClassificationCode\";\n    }\n}\n\nif (refFlags[\"PersonInfoNeeded\"] === \"Y\") {\n    if (selectList.indexOf(\"costTypeId\") === -1) {\n        selectList += (selectList.length > 0 ? \", \" : \"\") + \"personId\";\n    }\n}\n\n// 3. Full Attribute Mapping Master\nvar ATTRIBUTE_MAP = {\n    \"costTypeId\": \"unprocessedProjectCostTransaction.projectCostType.id\",\n    \"unprocessedProjectCostTransactionId\": \"unprocessedProjectCostTransaction.unprocessedTransactionReferenceId\",\n    \"transactionDate\": \"unprocessedProjectCostTransaction.transactionDate\",\n    \"billable\": \"unprocessedProjectCostTransaction.billable.meaning\",\n    \"costBatch\": \"unprocessedProjectCostTransaction.batchName\",\n    \"projectRole\": \"unprocessedProjectCostTransaction.projectRole.name\",\n    \"unmatchedNegativeTransactionIndicator\": \"unprocessedProjectCostTransaction.unmatchedTransactionFlag\",\n    \"creationDate\": \"unprocessedProjectCostTransaction.timeCreated\",\n    \"projectAccountingDate\": \"unprocessedProjectCostTransaction.projectAccountingDate\",\n    \"receiverAccountingDate\": \"unprocessedProjectCostTransaction.receiverAccountingDate\",\n    \"receiverProjectAccountingDate\": \"unprocessedProjectCostTransaction.receiverProjectAccountingDate\",\n    \"providerAccountingDate\": \"unprocessedProjectCostTransaction.providerAccountingDate\",\n    \"burdenCostCreditAccountCodeCombinationId\": \"unprocessedProjectCostTransaction.burdenCostCreditAccount.codeCombinationId\",\n    \"burdenCostDebitAccountCodeCombinationId\": \"unprocessedProjectCostTransaction.burdenCostDebitAccount.codeCombinationId\",\n    \"burdenedCostCreditAccountCodeCombinationId\": \"unprocessedProjectCostTransaction.burdenedCostCreditAccount.codeCombinationId\",\n    \"burdenedCostDebitAccountCodeCombinationId\": \"unprocessedProjectCostTransaction.burdenedCostDebitAccount.codeCombinationId\",\n    \"originalTransactionReference\": \"unprocessedProjectCostTransaction.originalTransactionReference\",\n    \"providerLedgerCurrencyBurdenedCostAmount\": \"unprocessedProjectCostTransaction.burdenedCostInProviderLedgerCurrency\",\n    \"providerLedgerCurrencyRawCostAmount\": \"unprocessedProjectCostTransaction.rawCostInProviderLedgerCurrency\",\n    \"projectCurrencyRawCostAmount\": \"unprocessedProjectCostTransaction.rawCostInProjectCurrency\",\n    \"projectCurrencyBurdenedCostAmount\": \"unprocessedProjectCostTransaction.burdenedCostInProjectCurrency\",\n    \"receiverLedgerCurrencyRawCostAmount\": \"unprocessedProjectCostTransaction.rawCostInReceiverLedgerCurrency\",\n    \"receiverLedgerCurrencyBurdenedCostAmount\": \"unprocessedProjectCostTransaction.burdenedCostInReceiverLedgerCurrency\",\n    \"providerLedgerCurrencyCode\": \"unprocessedProjectCostTransaction.providerLedgerCurrency.currencyCode\",\n    \"providerLedgerCurrencyName\": \"unprocessedProjectCostTransaction.providerLedgerCurrency.name\",\n    \"receiverLedgerCurrencyCode\": \"unprocessedProjectCostTransaction.receiverLedgerCurrency.currencyCode\",\n    \"receiverLedgerCurrencyName\": \"unprocessedProjectCostTransaction.receiverLedgerCurrency.name\",\n    \"transactionCurrencyCode\": \"unprocessedProjectCostTransaction.transactionCurrency.currencyCode\",\n    \"transactionCurrencyName\": \"unprocessedProjectCostTransaction.transactionCurrency.name\",\n    \"projectCurrencyCode\": \"unprocessedProjectCostTransaction.projectCurrency.currencyCode\",\n    \"projectCurrencyName\": \"unprocessedProjectCostTransaction.projectCurrency.name\",\n    \"rawCostDebitAccountCodeCombinationId\": \"unprocessedProjectCostTransaction.rawCostDebitAccount.codeCombinationId\",\n    \"rawCostCreditAccountCodeCombinationId\": \"unprocessedProjectCostTransaction.rawCostCreditAccount.codeCombinationId\",\n    \"reversedOriginalTransactionReference\": \"unprocessedProjectCostTransaction.reversedOriginalTransactionReference\",\n    \"transactionBurdenedCostAmount\": \"unprocessedProjectCostTransaction.burdenedCostInTransactionCurrency\",\n    \"transactionRawCostAmount\": \"unprocessedProjectCostTransaction.rawCostInTransactionCurrency\",\n    \"transactionQuantity\": \"unprocessedProjectCostTransaction.quantity\",\n    \"projectNumber\": \"unprocessedProjectCostTransaction.project.projectNumber\",\n    \"projectName\": \"unprocessedProjectCostTransaction.project.name\",\n    \"projectStartDate\": \"unprocessedProjectCostTransaction.project.startDate\",\n    \"projectFinishDate\": \"unprocessedProjectCostTransaction.project.finishDate\",\n    \"projectStatusName\": \"unprocessedProjectCostTransaction.project.status.name\",\n    \"projectUnitName\": \"unprocessedProjectCostTransaction.project.projectUnit.name\",\n    \"projectTypeName\": \"unprocessedProjectCostTransaction.project.projectType.name\",\n    \"burdenCostDebitAccountConcatenatedSegments\": \"unprocessedProjectCostTransaction.burdenCostDebitAccount.concatenatedSegments\",\n    \"awardName\": \"unprocessedProjectCostTransaction.award.contractName\",\n    \"awardNumber\": \"unprocessedProjectCostTransaction.contract.contractNumber\",\n    \"preAwardDate\": \"unprocessedProjectCostTransaction.award.preAwardDate\",\n    \"contractStartDate\": \"unprocessedProjectCostTransaction.contract.startDate\",\n    \"awardEndDate\": \"unprocessedProjectCostTransaction.contract.endDate\",\n    \"fundingSourceId\": \"unprocessedProjectCostTransaction.fundingSource.id\",\n    \"fundingSourceType\": \"unprocessedProjectCostTransaction.fundingSource.type\",\n    \"fundingSourceNumber\":\"unprocessedProjectCostTransaction.fundingSource.fundingSourceNumber\",\n    \"name\": \"unprocessedProjectCostTransaction.fundingSource<N>.name\",\n    \"customername\": \"unprocessedProjectCostTransaction.fundingSource<S>.customer.name\",\n    \"organizationname\": \"unprocessedProjectCostTransaction.fundingSource<O>.organization.name\",\n    \"businessUnitName\": \"unprocessedProjectCostTransaction.businessUnit.name\",\n    \"allowOverrideOfPersonOrganizationIndicator\": \"unprocessedProjectCostTransaction.document.allowOverrideOfPersonOrganizationFlag\",\n    \"commitmentSourceIndicator\": \"unprocessedProjectCostTransaction.document.commitmentSourceFlag\",\n    \"documentName\": \"unprocessedProjectCostTransaction.document.name\",\n    \"importBurdenedCostAmountsIndicator\": \"unprocessedProjectCostTransaction.document.importBurdenCostAmountFlag\",\n    \"documentEntryName\": \"unprocessedProjectCostTransaction.documentEntry.name\",\n    \"allowCrossChargesIndicator\": \"unprocessedProjectCostTransaction.documentEntry.allowCrossChargeFlag\",\n    \"documentEntryCostTypeClassificationName\": \"unprocessedProjectCostTransaction.documentEntry.costClassification.name\",\n    \"nonlaborResourceCostTypeName\": \"unprocessedProjectCostTransaction.nonlaborResource.costType.name\",\n    \"nonlaborResourceName\": \"unprocessedProjectCostTransaction.nonlaborResource.name\",\n    \"nonlaborResourceStartDate\": \"unprocessedProjectCostTransaction.nonlaborResource.fromDate\",\n    \"nonlaborResourceEndDate\": \"unprocessedProjectCostTransaction.nonlaborResource.toDate\",\n    \"nonlaborResourceOrganizationName\": \"unprocessedProjectCostTransaction.nonlaborResourceOrganization.name\",\n    \"costOrganizationName\": \"unprocessedProjectCostTransaction.projectCostOrganization.name\",\n    \"costOrganizationClassificationStartDate\": \"unprocessedProjectCostTransaction.projectCostOrganization.effectiveStartDate\",\n    \"costOrganizationClassificationEndDate\": \"unprocessedProjectCostTransaction.projectCostOrganization.effectiveEndDate\",\n    \"costTypeName\": \"unprocessedProjectCostTransaction.projectCostType.name\",\n    \"costTypeEndDate\": \"unprocessedProjectCostTransaction.projectCostType.toDate\",\n    \"costTypeStartDate\": \"unprocessedProjectCostTransaction.projectCostType.fromDate\",\n    \"costTypeClassificationName\": \"unprocessedProjectCostTransaction.projectCostClassification.name\",\n    \"costTypeClassificationCode\": \"unprocessedProjectCostTransaction.projectCostClassification.code\",\n   \"supplierName\": \"unprocessedProjectCostTransaction.supplier.name\",\n    \"supplierStartDate\": \"unprocessedProjectCostTransaction.supplier.startDateActive\",\n    \"supplierEndDate\": \"unprocessedProjectCostTransaction.supplier.endDateActive\",\n    \"taskNumber\": \"unprocessedProjectCostTransaction.task.taskNumber\",\n    \"taskName\": \"unprocessedProjectCostTransaction.task.name\",\n    \"taskTransactionStartDate\": \"unprocessedProjectCostTransaction.task.transactionStartDate\",\n    \"taskTransactionEndDate\": \"unprocessedProjectCostTransaction.task.transactionEndDate\",\n    \"transactionSourceName\": \"unprocessedProjectCostTransaction.transactionSource.name\",\n    \"workTypeName\": \"unprocessedProjectCostTransaction.workType.name\",\n    \"rateScheduleName\": \"unprocessedProjectCostTransaction.rateSchedule.name\",\n    \"workerJobName\":\"unprocessedProjectCostTransaction.personJob.name\",\n    \"personId\":\"unprocessedProjectCostTransaction.person.id\"\n};\n\n// 4. Extraction of Distinct Attributes\nvar dynamicAliases = {\n    \"id\": \"id\",\n    \"messageTextKey\": \"messageTextKey\",\n    \"messageTypeCode\":\"messageTypeCode\",\n    \"unprocessedProjectCostTransaction.transactionDate\" :  \"transactionDate\",\n    \"unprocessedProjectCostTransaction.unprocessedTransactionReferenceId\": \"unprocessedProjectCostTransactionId\"\n};\n\nvar combinedQueryString = filterString + \" \" + selectList;\n\nObject.keys(ATTRIBUTE_MAP).forEach(function(alias) {\n    var regex = new RegExp(\"\\\\b\" + alias + \"\\\\b\");\n    if (regex.test(combinedQueryString)) {\n        var sourcePath = ATTRIBUTE_MAP[alias];\n        dynamicAliases[sourcePath] = alias;\n    }\n});\n\n// --- CUSTOM MODIFICATIONS FOR MESSAGE KEYS ---\nvar conditionalSelects = \"\";\nvar conditionalGroups = \"\";\n\n// Condition 1: Award Date Logic\nif (messageKeys.indexOf(\"PJC_GMS_EIDATE_NOTIN_AWDDATES2\") !== -1) {\n    conditionalSelects += \", NVL(preAwardDate, contractStartDate) AS awardStartDate, awardEndDate\";\n    conditionalGroups += \", awardStartDate, awardEndDate\";\n    \n    dynamicAliases[\"unprocessedProjectCostTransaction.award.preAwardDate\"] = \"preAwardDate\";\n    dynamicAliases[\"unprocessedProjectCostTransaction.contract.startDate\"] = \"contractStartDate\";\n    dynamicAliases[\"unprocessedProjectCostTransaction.contract.endDate\"] = \"awardEndDate\";\n}\n\n// Condition 2: Funding Source Logic\nvar fundingKeys = [\"PJC_BILLABLE_FLAG_INTERNAL_FS2\", \"PJC_FS_NOTVALID_FORSPONPRJ2\", \"PJC_INTFS_BURD_NOT_ALLOWED2\"];\nvar hasFundingKey = fundingKeys.some(function(key) {\n    return messageKeys.indexOf(key) !== -1;\n});\n\nif (hasFundingKey) {\n    // 1. Remove fundingSourceName from selectList to prevent duplication\n    // We use a regex to find the word and handle potential leading/trailing commas\n    selectList = selectList.replace(/,?\\s*\\bfundingSourceName\\b\\s*,?/g, function(match) {\n        return match.indexOf(',') !== -1 ? ',' : ''; \n    }).replace(/^,|,$/g, '').trim();\n\n    // 2. Add the DECODE logic to conditional selects\n    conditionalSelects += \", DECODE(fundingSourceType, 'S', customername, 'O', organizationname, 'N', name) AS fundingSourceName\";\n    conditionalGroups += \", fundingSourceName\";\n    \n    // 3. Ensure component parts are in dynamicAliases\n    dynamicAliases[\"unprocessedProjectCostTransaction.fundingSource.type\"] = \"fundingSourceType\";\n    dynamicAliases[\"unprocessedProjectCostTransaction.fundingSource<S>.customer.name\"] = \"customername\";\n    dynamicAliases[\"unprocessedProjectCostTransaction.fundingSource<O>.organization.name\"] = \"organizationname\";\n    dynamicAliases[\"unprocessedProjectCostTransaction.fundingSource<N>.name\"] = \"name\";\n}\n\n// 5. Construct Final Payload\nconst payload = {\n    \"viewQueries\": {\n        \"bv\": {\n            \"module\": \"oraErpCoreProjectCostTransactions\",\n            \"businessObject\": \"UnprocessedProjectCostException\",\n            \"view\": \"unprocessedProjectCostExceptionDetails\",\n            \"fieldAliases\": dynamicAliases\n        }\n    },\n    // selectList is now cleaned of \"fundingSourceName\" to allow the DECODE alias to take its place\n    \"select\": \"SELECT count(*)\" + conditionalSelects + \", \" + selectList + \", MIN(unprocessedProjectCostTransactionId), MAX(transactionDate), MIN(transactionDate) FROM bv WHERE messageTypeCode = 'ERROR'  AND \" + filterString + \" AND messageTextKey IN \" + messageKeys + \" GROUP BY \" + selectList + conditionalGroups\n};\n\n// 6. Final Output\nreturn JSON.stringify(payload);"
          },
          "outcomes": {
            "success": "1773226647421"
          },
