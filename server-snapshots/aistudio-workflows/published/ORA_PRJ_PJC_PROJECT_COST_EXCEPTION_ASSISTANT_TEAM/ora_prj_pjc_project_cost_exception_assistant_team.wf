                {
                  "metadata": {
                    "name": "Extract Person Details Payload",
                    "returnType": "string",
                    "sourceCode": "// 1. Retrieve the data from the context\nvar rawData = $context.$nodes.PRJ_PJC_LOOP_ADDITIONAL_KEY_ATTRIBUTES_QUERY.$currentItem;\nvar data;\n\n// 2. Parse the data to JSON if it arrives as a string\ntry {\n    data = (typeof rawData === 'string') ? JSON.parse(rawData) : rawData;\n} catch (e) {\n    // Fallback if parsing fails\n    data = rawData; \n}\n\n// 3. Extract values (Handling both Array and Object structures)\nvar record = Array.isArray(data) ? data[0] : data;\n\n// Ensure we have a record before accessing properties\nvar personId = (record && record.PERSONID) ? record.PERSONID : -1;\n\n// 4. Prepare the Payload\nvar payload = {\n    \"fields\": [\n        \"id\"\n    ],\n    \"collection\": {\n        \"filter\": \"id in (\" + personId + \")\"\n    },\n    \"accessors\": {\n        \"personDetail\": {\n            \"fields\": [\n                \"personNumber\"\n            ]\n        },\n        \"workRelationships\": {\n            \"collection\": {\n                \"filter\": \"primaryFlag=true\"\n            },\n            \"accessors\": {\n                \"assignments\": {\n                    \"fields\": [\n                        \"assignmentNumber\"\n                    ],\n                    \"collection\": {\n                        \"filter\": \"primaryFlag=true\"\n                    }\n                }\n            }\n        },\n        \"names\": {\n            \"fields\": [\n                \"displayName\"\n            ],\n            \"collection\": {\n                \"filter\": \"type='GLOBAL'\"\n            }\n        }\n    }\n};\n\n// 5. Final Output\nreturn JSON.stringify(payload);"
                  },
                  "outcomes": {
                    "success": "1774615929397"
                  },
                  "code": "PRJ_PJC_CODE_EXTRACT_PERSON_DETAILS_PAYLOAD",
                  "id": "1774615886418",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
