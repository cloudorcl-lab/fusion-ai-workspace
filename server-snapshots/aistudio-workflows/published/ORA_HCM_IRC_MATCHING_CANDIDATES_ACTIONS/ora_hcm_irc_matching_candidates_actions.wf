        {
          "metadata": {
            "name": "ParseActionPayload",
            "returnType": "object",
            "sourceCode": "// 1. Get the Raw Input (Handle casing and stringified JSON)\nvar inputObj = $context.$triggers.REST.$input;\n// Use OraAction if it exists; otherwise, default to the whole input\nvar rawInput = inputObj.OraAction || inputObj.oraAction || inputObj;\n\n// Initialize variables\nvar payloadData = {};\nvar requisitionId = null;\nvar personIds = [];\nvar validationError = null;\nvar actionCode = \"UNKNOWN\";\n\n// 2. PARSE THE INPUT\ntry {\n    if (typeof rawInput === 'string') {\n        // Attempt to parse if it's a string\n        var cleanInput = rawInput.trim();\n        // Basic check to see if it's a JSON string\n        if (cleanInput.charAt(0) === '{' || cleanInput.charAt(0) === '[') {\n            payloadData = JSON.parse(cleanInput);\n        } else {\n            validationError = \"Input is a string but not valid JSON\";\n        }\n    } else if (rawInput && typeof rawInput === 'object') {\n        // Already an object, use as is\n        payloadData = rawInput;\n    } else {\n        validationError = \"Input format is unsupported\";\n    }\n} catch (e) {\n    validationError = \"JSON Parsing Failed: \" + e.message;\n}\n\n// 3. EXTRACT AND VALIDATE DATA\nif (!validationError && payloadData) {\n\n    // Extract RequisitionId (Check both casings)\n    requisitionId = payloadData.RequisitionId || payloadData.requisitionId || null;\n\n    // Extract PersonIds (Check both casings)\n    var tempPersonIds = payloadData.PersonIds || payloadData.personIds;\n\n    // Ensure PersonIds is a valid array\n    if (tempPersonIds && Array.isArray(tempPersonIds)) {\n        personIds = tempPersonIds;\n    }\n}\n\n// 4. DETERMINE ACTION CODE\n// Check if both required fields are present\nif (requisitionId && personIds.length > 0) {\n    actionCode = \"AddProspect\";\n} else if (!validationError) {\n    actionCode = \"ERROR_INVALID_PAYLOAD\";\n    validationError = \"Missing RequisitionId or PersonIds\";\n} else {\n    actionCode = \"ERROR_PARSING\";\n}\n\n// 5. CREATE RESULT\nvar result = {\n    \"actionCode\": actionCode,\n    \"actionPayload\": {\n        \"requisitionId\": String(requisitionId), // Ensure it stays a string for IDs\n        \"personIds\": personIds,\n        \"count\": personIds.length\n    },\n    \"error\": validationError\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1765185848898"
          },
          "code": "PARSEACTIONPAYLOAD",
          "id": "1769110447380",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
