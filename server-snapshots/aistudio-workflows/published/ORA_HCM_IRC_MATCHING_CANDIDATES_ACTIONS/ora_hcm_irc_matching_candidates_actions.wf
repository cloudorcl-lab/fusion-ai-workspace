{
  "workflowId": "300000326918436",
  "workflowCode": "ORA_HCM_IRC_MATCHING_CANDIDATES_ACTIONS",
  "name": "Matching Candidates Actions",
  "description": "Manages the matching candidates actions performed on candidates.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
