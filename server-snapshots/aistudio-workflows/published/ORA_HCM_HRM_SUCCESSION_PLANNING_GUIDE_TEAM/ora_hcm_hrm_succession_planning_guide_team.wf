          },
          "code": "SHOW_UNKNOWN_INTENT",
          "id": "1771554739079",
          "inputs": [
            {
              "id": "1771554739080_1",
              "name": "prompt",
              "type": "string",
              "value": "You are only responsible for answering succession related queries.  If the user’s query falls outside this scope, politely inform the user that you cannot assist with that request and clarify the kinds of queries you can support.  Do not attempt to answer unrelated questions.\nSupported user question examples:  viewing successors/candidates for a job, an employee or a position, details of succession plans, what happens when an employee leaves or who can replace them, and related readiness/ranking/status information."
            }
          ],
          "type": "LLM"
