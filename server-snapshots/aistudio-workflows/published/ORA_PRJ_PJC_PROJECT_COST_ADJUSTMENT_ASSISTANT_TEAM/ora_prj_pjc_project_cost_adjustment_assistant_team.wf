        {
          "metadata": {
            "name": "Create Adjustment Payload",
            "returnType": "string",
            "sourceCode": "let adjustmentAttributes = $context.$variables.prjPjcVarConvAdjustmentAttributes;\nlet newprojectNumber = adjustmentAttributes.ProjectNumber;\nlet newprojectName = adjustmentAttributes.ProjectName;\nlet newtaskName = adjustmentAttributes.TaskName;\nlet newtaskNumber = adjustmentAttributes.TaskNumber;\nlet justification = adjustmentAttributes.Justification;\nlet adjustmentType = $context.$variables.prjPjcVarConvAdjustmentType;\nlet projectCostTypeName = adjustmentAttributes.ExpenditureType;\nlet contractNumber = adjustmentAttributes.ContractNumber;\nlet contractName = adjustmentAttributes.ContractName;\nlet projectRoleName = adjustmentAttributes.ProjectRoleName;\nlet fundingSourceNumber = adjustmentAttributes.FundingSourceNumber;\nlet fundingSourceName = adjustmentAttributes.FundingSourceName;\nlet quantity = adjustmentAttributes.Quantity;\nlet parameters = [];\nif (adjustmentType) {\n  parameters.push({\"AdjustmentType\": adjustmentType});\n}\nif (newprojectNumber) {\n  parameters.push({\"ProjectNumber\": newprojectNumber});\n}\nif(newprojectName){\n  parameters.push({\"ProjectName\": newprojectName});\n}\nif (newtaskNumber) {\n  parameters.push({\"TaskNumber\": newtaskNumber});\n}\nif (newtaskName) {\n  parameters.push({\"TaskName\": newtaskName});\n}\nif (justification) {\n  parameters.push({\"Justification\": justification});\n}\nif (projectCostTypeName) {\n  parameters.push({\"ExpenditureType\": projectCostTypeName});\n}\nif (contractNumber) {\n  parameters.push({\"ContractNumber\": contractNumber});\n}\nif (contractName) {\n  parameters.push({\"ContractName\": contractName});\n}\nif (fundingSourceName) {\n  parameters.push({\"FundingSourceName\": fundingSourceName});\n}\nif (projectRoleName) {\n  parameters.push({\"ProjectRoleName\": projectRoleName});\n}\nif (fundingSourceNumber) {\n  parameters.push({\"FundingSourceNumber\": fundingSourceNumber});\n}\nif (quantity) {\n  parameters.push({\"Quantity\": quantity});\n}\nreturn JSON.stringify(parameters);"
          },
          "outcomes": {
            "success": "1770975435668"
          },
          "code": "CREATE_ADJUSTMENT_PAYLOAD",
          "id": "1770890905463",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
