            "sourceCode": "let criteriaSummary = $context.$variables.prjPjcVarConvCriteriaSummary;\nlet result = \"\";\nif(criteriaSummary == null || criteriaSummary === \"\"){\n   result = `<p>I couldn't find a transaction that matches the details you entered. This search requires exact, case sensitive values. Verify your entries and try again. <br><br>Need a template? Say \"Show templates for finding transactions\".</p>`;\n}else{\n   result = `<p>I couldn't find a transaction for `+criteriaSummary+ `. This search requires exact, case sensitive values. Verify your entries and try again.<br><br>Need a template? Say “Show templates for finding transactions”.</p>`;\n}\nreturn result;"
          },
