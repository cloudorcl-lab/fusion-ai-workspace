            "sourceCode": "let msg = \"\";\n\nmsg += \"<p>I found transaction \" + $context.$variables.prjPjcVarConvAdjustmentAttributes?.TransactionNumber;\n\nlet str = $context.$nodes.VALIDATE_ADJUSTMENT_PAYLOAD.$output?.output ?? \"\";\nlet output = JSON.parse(str);\nlet invalidAttribute = output?.result?.invalidAttribute ?? \"\";\n\nif(invalidAttribute != null && invalidAttribute !== \"\" && invalidAttribute !== \"Justification\"){\n      if($context.$variables.prjPjcVarConvAdjustmentAttributes[invalidAttribute] != null && $context.$variables.prjPjcVarConvAdjustmentAttributes[invalidAttribute] !== \"\"){\n           msg += \". <br><br> One or more destination values couldn't be found for this adjustment: \" + invalidAttribute.toLowerCase() + \" \" + $context.$variables.prjPjcVarConvAdjustmentAttributes[invalidAttribute] + \".\"\n      }\n      msg += \" <br><br> Review the destination values you entered, then provide the correct entries to continue.</p>\";\n      return msg;\n}\n\nlet missingAttributes = output?.result?.missingAttributes ?? [];\nmissingAttributes = missingAttributes.filter((attr) => attr !== \"Justification\");\n\nif(missingAttributes != null && Array.isArray(missingAttributes) && missingAttributes.length > 0){\n      msg += \". <br><br>Tell me the target \";\n      for(let i = 0; i<missingAttributes.length; i++){\n           msg += missingAttributes[i].toLowerCase();\n      }\n      msg += \" so I can prepare the adjustment.</p>\";\n      return msg;\n}\nmsg+= ' and prepared the adjustment for review.<br><br> Enter \"Review\" to check the adjustment summary before it can be submitted.</p>';\nreturn msg;"
