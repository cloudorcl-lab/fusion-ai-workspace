          "id": "1772787077663",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.75
              },
              "code": "ORA_LLM_MODEL_PROVIDER_CERT_BASIC_LLAMA_3_3_70B",
              "model": "ORA_LLM_MODEL_GPT_OSS_120B",
              "modelName": "Gpt Oss",
              "provider": "CERT_BASIC"
            },
            "name": "Generate Additional Information"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "GENERATE_ADDITIONAL_INFORMATION",
          "id": "1772805353013",
          "inputs": [
            {
              "id": "1772805353016_1",
              "name": "prompt",
              "type": "string",
              "value": "Display to the user: {{$context.$nodes.ADDITIONAL_INFORMATION_EXTRACTOR.$output.output}} \n\n###Formatting Instructions (Critical)\nDisplay Just the exact string as it is, not in JSON format, not with double quotes.\nDo not try to explain/add anything."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Adjustment Summary Content",
            "returnType": "string",
            "sourceCode": "const adjustmentAttributes = $context.$variables.prjPjcVarConvAdjustmentAttributes || {};\n\nconst raw = $context.$variables.prjPjcVarConvIdentifiedProjectCostDetails;\n\nlet payload = raw;\nif (typeof payload === \"string\") {\n  try {\n    payload = JSON.parse(payload);\n  } catch (e) {\n    payload = {};\n  }\n}\n\nconst resultArr =\n  (Array.isArray(payload) && payload) ||\n  (Array.isArray(payload?.result) && payload.result) ||\n  (Array.isArray(payload?.body?.result) && payload.body.result) ||\n  (Array.isArray(payload?.data?.result) && payload.data.result) ||\n  [];\n\nconst identifiedProjectCostDetails = resultArr[0] || {};\n\nconst date = new Date();\nconst day = String(date.getDate()).padStart(2, '0');\nconst month = String(date.getMonth() + 1).padStart(2, '0');\nconst year = date.getFullYear();\nconst formattedDate = `${month}/${day}/${year}`;\n\nconst hasJustification = !!adjustmentAttributes.Justification;\n\n// Project\nconst hasProject = !!adjustmentAttributes.ProjectNumber || !!adjustmentAttributes.ProjectName;\nlet projectFrom = \"\";\nif (adjustmentAttributes.ProjectNumber) projectFrom += identifiedProjectCostDetails.PROJECTNUMBER || \"\";\nif (adjustmentAttributes.ProjectName) {\n  if (projectFrom) projectFrom += \" - \";\n  projectFrom += identifiedProjectCostDetails.PROJECTNAME || \"\";\n}\n\nlet projectTo = \"\";\nif (adjustmentAttributes.ProjectNumber) projectTo += adjustmentAttributes.ProjectNumber;\nif (adjustmentAttributes.ProjectName) {\n  if (projectTo) projectTo += \" - \";\n  projectTo += adjustmentAttributes.ProjectName;\n}\n\n// Task\nconst hasTask = !!adjustmentAttributes.TaskNumber || !!adjustmentAttributes.TaskName;\nlet taskFrom = \"\";\nif (adjustmentAttributes.TaskNumber) taskFrom += identifiedProjectCostDetails.TASKNUMBER || \"\";\nif (adjustmentAttributes.TaskName) {\n  if (taskFrom) taskFrom += \" - \";\n  // FIX: TASKNAME (not TASK)\n  taskFrom += identifiedProjectCostDetails.TASKNAME || \"\";\n}\n\nlet taskTo = \"\";\nif (adjustmentAttributes.TaskNumber) taskTo += adjustmentAttributes.TaskNumber;\nif (adjustmentAttributes.TaskName) {\n  if (taskTo) taskTo += \" - \";\n  taskTo += adjustmentAttributes.TaskName;\n}\n\n// Expenditure Type\nconst hasExpenditureType = !!adjustmentAttributes.ExpenditureType;\nconst expFrom = identifiedProjectCostDetails.PROJECTCOSTTYPENAME || \"\";\nconst expTo = adjustmentAttributes.ExpenditureType || \"\";\n\n// Contract\nconst hasContract = !!adjustmentAttributes.ContractNumber || !!adjustmentAttributes.ContractName;\nlet contractFrom = \"\";\nif (adjustmentAttributes.ContractNumber) contractFrom += identifiedProjectCostDetails.CONTRACTNUMBER || \"\";\nif (adjustmentAttributes.ContractName) {\n  if (contractFrom) contractFrom += \" - \";\n  contractFrom += identifiedProjectCostDetails.CONTRACTNAME || \"\";\n}\nlet contractTo = \"\";\nif (adjustmentAttributes.ContractNumber) contractTo += adjustmentAttributes.ContractNumber;\nif (adjustmentAttributes.ContractName) {\n  if (contractTo) contractTo += \" - \";\n  contractTo += adjustmentAttributes.ContractName;\n}\n\n// Project Role\nconst hasProjectRole = !!adjustmentAttributes.ProjectRoleName;\nconst roleFrom = identifiedProjectCostDetails.PROJECTROLENAME || \"\";\nconst roleTo = adjustmentAttributes.ProjectRoleName || \"\";\n\n// Funding Source\nconst hasFundingSource = !!adjustmentAttributes.FundingSourceNumber || !!adjustmentAttributes.FundingSourceName;\nlet fundingFrom = \"\";\nif (adjustmentAttributes.FundingSourceNumber) fundingFrom += identifiedProjectCostDetails.FUNDINGSOURCENUMBER || \"\";\nif (adjustmentAttributes.FundingSourceName) {\n  if (fundingFrom) fundingFrom += \" - \";\n  fundingFrom += identifiedProjectCostDetails.FUNDINGSOURCENAME || \"\";\n}\nlet fundingTo = \"\";\nif (adjustmentAttributes.FundingSourceNumber) fundingTo += adjustmentAttributes.FundingSourceNumber;\nif (adjustmentAttributes.FundingSourceName) {\n  if (fundingTo) fundingTo += \" - \";\n  fundingTo += adjustmentAttributes.FundingSourceName;\n}\n\n// Currency code fallback (your sample doesn’t include PROVIDERLEDGERCURRENCYCODE)\nconst currencyCode =\n  identifiedProjectCostDetails.PROVIDERLEDGERCURRENCYCODE ||\n  identifiedProjectCostDetails.TRANSACTIONCURRENCYCODE ||\n  \"\";\n\nlet html = `<p style=\"font-family: 'Oracle Sans', Arial, sans-serif; font-size: 13px; margin-bottom: 18px;\">\n<br></br>The proposed adjustment will result in the following changes to the original transaction once approved.\nAll amounts are in provider ledger currency.\n</p>\n<h4 style=\"font-family: 'Oracle Sans', Arial, sans-serif; font-size: 14px; margin-top: 10px; margin-bottom: 10px;\">\n  Transaction Details\n</h4>\n<ul style=\"font-family: 'Oracle Sans', Arial, sans-serif; font-size: 13px; border-radius: 6px; padding: 16px 30px 16px 35px; margin-bottom: 18px;\">\n  <li><strong>Transaction Number:</strong> ${identifiedProjectCostDetails.TRANSACTIONNUMBER || \"\"}</li>\n  <li><strong>Business Unit:</strong> ${identifiedProjectCostDetails.BUSINESSUNITNAME || \"\"}</li>\n  <li><strong>Adjustment Date:</strong> ${formattedDate}</li>\n  <li><strong>Total Burdened Cost of Adjusted Transactions:</strong> ${identifiedProjectCostDetails.BURDENEDCOSTINTRANSACTIONCURRENCY || \"\"} ${currencyCode}</li>`;\n\nif (hasJustification) {\n  html += `<li><strong>Justification:</strong> ${adjustmentAttributes.Justification || \"\"}</li>`;\n}\n\nhtml += `</ul>\n<h4 style=\"font-family: 'Oracle Sans', Arial, sans-serif; font-size: 14px; margin-top: 10px; margin-bottom: 10px;\">\n  Adjustment Details: Transfer\n</h4>\n<table style=\"border-collapse: collapse; width: 100%; font-family: 'Oracle Sans', Arial, sans-serif; font-size: 12px; margin-bottom: 18px; border:1px solid #E4E1DD;\">\n  <thead>\n    <tr>\n      <th style=\"font-size: 12px; padding: 10px 10px; border:1px solid #E4E1DD;\">Transaction Attribute</th>\n      <th style=\"font-size: 12px; padding: 10px 10px; border:1px solid #E4E1DD;\">Transferred From</th>\n      <th style=\"font-size: 12px; padding: 10px 10px; border:1px solid #E4E1DD;\">Transferred To</th>\n    </tr>\n  </thead>\n  <tbody>`;\n\nif (hasProject) {\n  html += `<tr>\n      <td style=\"font-size: 12px; padding: 8px; border:1px solid #E4E1DD;\">Project Number/Name</td>\n      <td style=\"font-size: 12px; padding: 8px; border:1px solid #E4E1DD;\">${projectFrom}</td>\n      <td style=\"font-size: 12px; padding: 8px; border:1px solid #E4E1DD;\">${projectTo}</td>\n    </tr>`;\n}\nif (hasTask) {\n  html += `<tr>\n      <td style=\"font-size: 12px; padding: 8px; border:1px solid #E4E1DD;\">Task Number/Name</td>\n      <td style=\"font-size: 12px; padding: 8px; border:1px solid #E4E1DD;\">${taskFrom}</td>\n      <td style=\"font-size: 12px;; padding: 8px; border:1px solid #E4E1DD;\">${taskTo}</td>\n    </tr>`;\n}\nif (hasExpenditureType) {\n  html += `<tr>\n      <td style=\"font-size: 12px; padding: 8px; border:1px solid #E4E1DD;\">Expenditure Type</td>\n      <td style=\"font-size: 12px; padding: 8px; border:1px solid #E4E1DD;\">${expFrom}</td>\n      <td style=\"font-size: 12px; padding: 8px; border:1px solid #E4E1DD;\">${expTo}</td>\n    </tr>`;\n}\nif (hasContract) {\n  html += `<tr>\n      <td style=\"font-size: 12px; padding: 8px; border:1px solid #E4E1DD;\">Contract Number/Name</td>\n      <td style=\"font-size: 12px; padding: 8px; border:1px solid #E4E1DD;\">${contractFrom}</td>\n      <td style=\"font-size: 12px; padding: 8px; border:1px solid #E4E1DD;\">${contractTo}</td>\n    </tr>`;\n}\nif (hasProjectRole) {\n  html += `<tr>\n      <td style=\"font-size: 12px; padding: 8px; border:1px solid #E4E1DD;\">Project Role Name</td>\n      <td style=\"font-size: 12px; padding: 8px; border:1px solid #E4E1DD;\">${roleFrom}</td>\n      <td style=\"font-size: 12px; padding: 8px; border:1px solid #E4E1DD;\">${roleTo}</td>\n    </tr>`;\n}\nif (hasFundingSource) {\n  html += `<tr>\n      <td style=\"font-size: 12px; padding: 8px; border:1px solid #E4E1DD;\">Funding Source Number/Name</td>\n      <td style=\"font-size: 12px; padding: 8px; border:1px solid #E4E1DD;\">${fundingFrom}</td>\n      <td style=\"font-size: 12px; padding: 8px; border:1px solid #E4E1DD;\">${fundingTo}</td>\n    </tr>`;\n}\n\nhtml += `  </tbody>\n</table>\n<p style=\"font-family: 'Oracle Sans', Arial, sans-serif; font-size: 13px; margin-top: 30px;\">\n  If everything looks correct, approve the adjustment. If anything is incorrect, indicate the field to change. For example: Change task to 1.1.\n</p>`;\n\nreturn html;"
          },
          "outcomes": {
            "success": "1770386345764"
          },
          "code": "ADJUSTMENT_SUMMARY_CONTENT",
          "id": "1773033840277",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
