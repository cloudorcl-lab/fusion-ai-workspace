        {
          "metadata": {
            "errorNodeId": "1774600841996",
            "name": "Generate Cancel Adjustment Response",
            "returnType": "string",
            "sourceCode": "var apiResponse = $context.$nodes.CANCEL_ADJUSTMENT.$output?.result ?? null;\nvar result = \"\";\n\nconst escapeHtml = (v) =>\n  String(v ?? \"\")\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n\nif (apiResponse == null) {\n  result = `<p>We couldn't complete your request right now due to a temporary service, access, or environment issue. Try again in a few minutes. If the problem continues, check that you have the required access or contact your administrator.</p>`;\n} else {\n  result = `<p>${escapeHtml(apiResponse)}<br><br>To make another adjustment, do one of the following: <ul style=\"list-style-type: circle;\"><li>Send a complete request. For example: Transfer transaction 17285 to project 100, task 11.</li><li>Provide project, task, and transaction date to help me identify the transaction first. </li></ul><br>Need a template? Say \"Show templates for project cost transfer\". Or reply \"End\".</p>`;\n}\nreturn result;"
          },
          "outcomes": {
            "success": "1770727202398"
          },
