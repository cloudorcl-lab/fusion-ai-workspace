            "sourceCode": "let BVDetails= $context.$variables.prjPjcVarConvProjectCostsExtractBVDetails;\nlet selectClause='count(1)';\nlet whereClause= $context.$variables.prjPjcVarConvFilterFormed;\nlet result='{'+ BVDetails + ', \"select\":\"select ' + selectClause + ' from costs where 1=1 ' + whereClause + '\"}';\nreturn result;"
