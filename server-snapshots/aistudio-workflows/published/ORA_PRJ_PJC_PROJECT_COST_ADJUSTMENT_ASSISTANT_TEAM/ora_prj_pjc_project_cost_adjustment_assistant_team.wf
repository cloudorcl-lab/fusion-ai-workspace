              "type": "array",
              "value": "[\"transactionNumber\",\"transactionDate\",\"createdBy\",\"timeCreated\",\"projectNumber\",\"projectName\",\"taskNumber\",\"taskName\",\"contractNumber\",\"contractName\",\"fundingSourceNumber\",\"transactionSourceName\",\"supplierNumber\",\"supplierName\",\"personId\",\"originalTransactionReference\",\"netZeroItemFlag\",\"transferredFromTransactionNumber\",\"adjustingTransactionNumber\",\"accrualFlag\",\"providerAccrualDate\",\"receiverAccrualDate\",\"projectType\",\"documentName\",\"documentEntryName\",\"projectRoleName\",\"personJobName\",\"businessUnitName\",\"burdenedCostInProviderLedgerCurrency\",\"rawCostInProviderLedgerCurrency\",\"burdenedCostInTransactionCurrency\",\"rawCostInTransactionCurrency\",\"quantity\",\"projectCostTypeName\",\"salesOrderNumber\",\"shipmentNumber\",\"workOrderNumber\",\"invoiceNumber\",\"receiptNumber\",\"purchaseOrderNumber\",\"paymentNumber\",\"transferOrderNumber\",\"includedInAssetLine\",\"capitalEventId\",\"projectCostOrganizationName\"]"
