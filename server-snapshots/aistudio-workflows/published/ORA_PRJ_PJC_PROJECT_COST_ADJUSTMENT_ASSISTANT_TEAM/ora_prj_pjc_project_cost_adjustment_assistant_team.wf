          "type": "CONDITION"
        },
        {
          "metadata": {
            "errorNodeId": "1774600841996",
            "name": "Form Project Costs Display List Extract Payload",
            "returnType": "string",
            "sourceCode": "let BVDetails= $context.$variables.prjPjcVarConvProjectCostsExtractBVDetails ;\nlet selectClause= $context.$variables.prjPjcVarConvCostDisplaySelectColumns;\nlet whereClause= $context.$variables.prjPjcVarConvFilterFormed ;\nlet limitClause = \" and rownum <= \" + $context.$variables.prjPjcVarConvShowMoreLimit;\nlet result='{'+ BVDetails + ', \"select\":\"select ' + selectClause + ' from costs where 1=1 ' + whereClause + limitClause + ' order by timeCreated desc '  +'\"}';\nreturn result;"
          },
          "outcomes": {
            "success": "1773313497484"
          },
          "code": "FORM_PROJECT_COSTS_DISPLAY_LIST_EXTRACT_PAYLOAD",
          "convergenceTargetId": "1775495400885",
          "id": "1773313450580",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
