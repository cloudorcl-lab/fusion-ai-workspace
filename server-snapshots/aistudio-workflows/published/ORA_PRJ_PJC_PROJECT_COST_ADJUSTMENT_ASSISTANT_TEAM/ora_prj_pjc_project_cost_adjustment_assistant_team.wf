              "scope": "JOB",
              "type": "string",
              "value": "transactionNumber, transactionDate, createdBy, timeCreated, projectNumber, projectName, taskNumber, taskName, contractNumber, contractName, fundingSourceNumber, supplierNumber, supplierName, personId, originalTransactionReference, netZeroItemFlag, transferredFromTransactionNumber, adjustingTransactionNumber, accrualFlag, providerAccrualDate, receiverAccrualDate, projectName, taskName, documentName, documentEntryName, projectRoleName, personJobName, businessUnitName, burdenedCostInProviderLedgerCurrency, rawCostInProviderLedgerCurrency, burdenedCostInTransactionCurrency, rawCostInTransactionCurrency, quantity, projectCostTypeName, salesOrderNumber, shipmentNumber, workOrderNumber, invoiceNumber, receiptNumber, purchaseOrderNumber, paymentNumber, transferOrderNumber, includedInAssetLine, providerLedgerCurrencyCode,transactionSourceName, DECODE(fundingSourceType, 'S', fundingSourceCustomerName, 'O', fundingSourceOrganizationName, 'N', fundingSourceName) as fundingSourceName"
