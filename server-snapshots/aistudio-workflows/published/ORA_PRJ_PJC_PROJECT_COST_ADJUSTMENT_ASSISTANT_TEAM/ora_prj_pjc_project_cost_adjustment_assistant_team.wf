        {
          "metadata": {
            "errorNodeId": "1774600841996",
            "name": "Generate Costs Display HTML",
            "returnType": "string",
            "sourceCode": "var costDetailsArr =$context.$nodes.SHOW_MORE_DATA_FETCH.$output;\nvar totalCosts = costDetailsArr?.length ?? 0;\nvar criteriaSummary = $context.$variables.prjPjcVarConvCriteriaSummary;\nconst escapeHtml = (v) => String(v ?? \"\").replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\").replace(/'/g, \"&#39;\");\nconst header = `\n<div style=\"font-family:'Oracle Sans', Arial, sans-serif; font-size:13px; margin:10px 0 0 0;\">\n  I found <b>${totalCosts}</b> matching transactions for ${criteriaSummary}. Showing 1–${totalCosts} of ${totalCosts} below.\n</div>\n<br>\n<div style=\"display:block; max-width:100%; max-height:320px; overflow:auto; box-sizing:border-box; font-size:12px\">\n  <table cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%; border-collapse:collapse; font-family:'Oracle Sans', Arial, sans-serif; table-layout:fixed; border:1px solid #E4E1DD;\">\n    <colgroup>\n      <col style=\"width:10%;\">\n      <col style=\"width:15%;\">\n      <col style=\"width:15%;\">\n      <col style=\"width:16%;\">\n      <col style=\"width:13%;\">\n      <col style=\"width:15%;\">\n      <col style=\"width:16%;\">\n    </colgroup>\n    <thead>\n      <tr style=\"font-weight:bold;\">\n        <th style=\"padding:6px; text-align:center; white-space:normal; border:1px solid #E4E1DD;\">No.</th>\n        <th style=\"padding:6px; text-align:left; white-space:normal; border:1px solid #E4E1DD;\">Transaction Number</th>\n        <th style=\"padding:6px; text-align:left; white-space:normal; border:1px solid #E4E1DD;\">Business Unit</th>\n        <th style=\"padding:6px; text-align:left; white-space:normal; border:1px solid #E4E1DD;\">Project Number</th>\n        <th style=\"padding:6px; text-align:left; white-space:normal; border:1px solid #E4E1DD;\">Task Number</th>\n        <th style=\"padding:6px; text-align:left; white-space:normal; border:1px solid #E4E1DD;\">Expenditure Item Date</th>\n        <th style=\"padding:6px; text-align:left; white-space:normal; border:1px solid #E4E1DD;\">Total Burdened Cost</th>\n      </tr>\n    </thead>\n    <tbody>`.trim();\n\nconst body = Array.isArray(costDetailsArr) && costDetailsArr.length > 0 ? costDetailsArr.map((r,i) => {\n      const rownum = i+1;\n      const date = new Date(r.TRANSACTIONDATE);\n      const day = String(date.getDate()).padStart(2, '0');\n      const month = String(date.getMonth() + 1).padStart(2, '0');\n      const year = date.getFullYear();\n      const formattedDate = `${month}/${day}/${year}`;\n\n      return `\n      <tr>\n        <td style=\"padding:6px; text-align:center; white-space:normal; overflow-wrap:anywhere; border:1px solid #E4E1DD;\">${rownum}</td>\n        <td style=\"padding:6px; text-align:left; white-space:normal; overflow-wrap:anywhere; border:1px solid #E4E1DD;\">${escapeHtml(r.TRANSACTIONNUMBER)}</td>\n        <td style=\"padding:6px; text-align:left; white-space:normal; overflow-wrap:anywhere; border:1px solid #E4E1DD;\">${escapeHtml(r.BUSINESSUNITNAME)}</td>\n        <td style=\"padding:6px; text-align:left; white-space:normal; overflow-wrap:anywhere; border:1px solid #E4E1DD;\">${escapeHtml(r.PROJECTNUMBER)}</td>\n        <td style=\"padding:6px; text-align:left; white-space:normal; overflow-wrap:anywhere; border:1px solid #E4E1DD;\">${escapeHtml(r.TASKNUMBER)}</td>\n        <td style=\"padding:6px; text-align:left; white-space:normal; overflow-wrap:anywhere; border:1px solid #E4E1DD;\">${escapeHtml(formattedDate)}</td>\n        <td style=\"padding:6px; text-align:right; white-space:normal; overflow-wrap:anywhere; border:1px solid #E4E1DD;\">${escapeHtml(r.BURDENEDCOSTINTRANSACTIONCURRENCY)} ${escapeHtml(r.PROVIDERLEDGERCURRENCYCODE)}</td>\n      </tr>`.trim();\n    })\n    .join(\"\\n\") : `\n      <tr>\n        <td colspan=\"7\" style=\"padding:12px; text-align:center; white-space:normal;\">\n          No Data\n        </td>\n      </tr>`.trim();\n\nconst footer = `\n    </tbody>\n  </table>\n</div>\n<br>\n<div style=\"font-family:'Oracle Sans', Arial, sans-serif; font-size:13px; margin:10px 0 0 0;\">\n  Select a transaction number to continue, or refine your search to narrow the results.\n</div>`.trim();\n\n  return `${header}\\n${body}\\n${footer}`;"
          },
          "outcomes": {
            "success": "1775495480593"
          },
          "code": "GENERATE_COSTS_DISPLAY_HTML",
