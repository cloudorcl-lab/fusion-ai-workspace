            "name": "Set Transaction Number In Adjustment Attributes",
            "returnType": "object",
            "sourceCode": "let adjustmentAttributes = $context.$variables.prjPjcVarConvAdjustmentAttributes;\nif(adjustmentAttributes == null || adjustmentAttributes === \"\") {\n      adjustmentAttributes = {};\n}\nlet costDetailOutput = $context.$nodes.FETCH_PROJECT_COST_DETAILS.$output;\nlet value = null;\nif (Array.isArray(costDetailOutput) && costDetailOutput.length > 0) {\n  value = costDetailOutput[0].TRANSACTIONNUMBER;\n}\nadjustmentAttributes['TransactionNumber'] = value;\nreturn adjustmentAttributes;"
          },
