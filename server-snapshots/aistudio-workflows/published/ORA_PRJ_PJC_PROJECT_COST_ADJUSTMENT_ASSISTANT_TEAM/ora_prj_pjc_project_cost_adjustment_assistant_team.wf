              "value": "{\n  \"Transaction\": [\"transactionNumber\"],\n  \"Transaction Date\" : [\"transactionDate\"],\n  \"Transaction Created on\": [\"timeCreated\"],\n  \"Created by\": [\"createdBy\"],\n  \"Project\": [\"projectNumber\", \"projectName\"],\n  \"Task\": [\"taskNumber\", \"taskName\"],\n  \"Contract\": [\"contractNumber\", \"contractName\"],\n  \"Funding Source\": [\"fundingSourceNumber\", \"fundingSourceName\"],\n  \"Supplier\": [\"supplierNumber\", \"supplierName\"],\n  \"Person\": [\"personId\"],\n  \"Project Role Name\": [\"projectRoleName\"],\n  \"Person Job Name\": [\"personJobName\"],\n  \"Original Transaction Reference\": [\"originalTransactionReference\"],\n  \"Transferred From Transaction Number\": [\"transferredFromTransactionNumber\"],\n  \"Adjusting Transaction Number\": [\"adjustingTransactionNumber\"],\n  \"Net-Zero Item Flag\": [\"netZeroItemFlag\"],\n  \"Accrual Flag\": [\"accrualFlag\"],\n  \"Provider Accrual Date\": [\"providerAccrualDate\"],\n  \"Receiver Accrual Date\": [\"receiverAccrualDate\"],\n  \"Document\": [\"documentName\"],\n  \"Document Entry Name\": [\"documentEntryName\"],\n  \"Business Unit\": [\"businessUnitName\"],\n   \"Burdened Cost (Provider Ledger Currency)\": [\"burdenedCostInProviderLedgerCurrency\"],\n  \"Raw Cost (Provider Ledger Currency)\": [\"rawCostInProviderLedgerCurrency\"],\n  \"Burdened Cost (Transaction Currency)\": [\"burdenedCostInTransactionCurrency\"],\n  \"Raw Cost (Transaction Currency)\": [\"rawCostInTransactionCurrency\"],\n  \"Quantity\": [\"quantity\"]\n  \"Cost Type\": [\"projectCostTypeName\"],\n  \"Sales Order\": [\"salesOrderNumber\"],\n  \"Shipment\": [\"shipmentNumber\"],\n  \"Work Order\": [\"workOrderNumber\"],\n  \"Invoice\": [\"invoiceNumber\"],\n  \"Receipt\": [\"receiptNumber\"],\n  \"Purchase Order\": [\"purchaseOrderNumber\"],\n  \"Payment\": [\"paymentNumber\"],\n  \"Transfer Order\": [\"transferOrderNumber\"],\n  \"Transaction Source\": [\"transactionSourceName\"]\n}"
            },
            {
              "id": "1774333003394",
              "name": "prjPjcVarConvCostDisplaySelectColumns",
              "scope": "JOB",
              "type": "array",
              "value": "transactionNumber,businessUnitName,projectNumber,taskNumber,transactionDate,burdenedCostInTransactionCurrency,providerLedgerCurrencyCode"
            },
            {
              "id": "1772788032479",
              "name": "prjPjcVarConvProjectCostsExtractBVDetails",
              "scope": "JOB",
              "type": "string",
              "value": "\"viewQueries\": {\n      \"costs\": {\n        \"module\": \"oraErpCoreProjectCostTransactions\",\n        \"businessObject\": \"ProjectCostTransaction\",\n        \"view\": \"projectCostTransactionDetails\",\n        \"fieldAliases\": {\n            \"transactionNumber\": \"transactionNumber\",\n            \"transactionDate\": \"transactionDate\",\n            \"createdBy\": \"createdBy\", \n            \"timeCreated\": \"timeCreated\", \n            \"project.projectNumber\": \"projectNumber\", \n            \"project.name\": \"projectName\",\n            \"task.taskNumber\": \"taskNumber\",\n            \"task.name\": \"taskName\",\t\n            \"contract.contractNumber\": \"contractNumber\",\n            \"contract.contractName\": \"contractName\",\n            \"transactionSource.name\": \"transactionSourceName\",\n            \"fundingSource.fundingSourceNumber\": \"fundingSourceNumber\",\n            \"fundingSource<N>.name\" : \"fundingSourceName\",\n            \"fundingSource<S>.customer.name\" : \"fundingSourceCustomerName\",\n            \"fundingSource<O>.organization.name\" : \"fundingSourceOrganizationName\",\n            \"fundingSource.type\" : \"fundingSourceType\",\n            \"supplier.supplierNumber\": \"supplierNumber\",\t\n            \"supplier.name\": \"supplierName\",\n            \"person.id\": \"personId\",\t\t\n            \"originalTransactionReference\": \"originalTransactionReference\",\n            \"netZeroItemFlag\": \"netZeroItemFlag\",\n            \"transferredFromTransactionNumber\": \"transferredFromTransactionNumber\",\n            \"adjustingTransactionNumber\": \"adjustingTransactionNumber\",\n            \"accrualFlag\": \"accrualFlag\", \n            \"providerAccrualDate\": \"providerAccrualDate\",\n            \"receiverAccrualDate\": \"receiverAccrualDate\",\n            \"document.name\": \"documentName\",\t\t\n            \"documentEntry.name\": \"documentEntryName\",\t\n            \"projectRole.name\": \"projectRoleName\",\n            \"personJob.name\": \"personJobName\",\n            \"businessUnit.name\": \"businessUnitName\",\n            \"burdenedCostInProviderLedgerCurrency\" : \"burdenedCostInProviderLedgerCurrency\",\n            \"rawCostInProviderLedgerCurrency\":\"rawCostInProviderLedgerCurrency\",\n            \"burdenedCostInTransactionCurrency\":\"burdenedCostInTransactionCurrency\",\n            \"rawCostInTransactionCurrency\":\"rawCostInTransactionCurrency\",\n            \"quantity\":\"quantity\",\n            \"projectCostType.name\": \"projectCostTypeName\",\n            \"salesOrderNumber\": \"salesOrderNumber\",\n            \"shipmentNumber\": \"shipmentNumber\",\n            \"workOrderNumber\": \"workOrderNumber\",\n            \"invoiceNumber\": \"invoiceNumber\",\n            \"receiptNumber\": \"receiptNumber\",\n            \"purchaseOrderNumber\": \"purchaseOrderNumber\",\n            \"paymentNumber\": \"paymentNumber\",\n            \"transferOrderNumber\": \"transferOrderNumber\",\n            \"includedInAssetLine\": \"includedInAssetLine\",\n            \"providerLedgerCurrency.currencyCode\" : \"providerLedgerCurrencyCode\",\n            \"projectCostOrganization.name\" : \"projectCostOrganizationName\"\n        }\n      }\n    }"
            },
            {
