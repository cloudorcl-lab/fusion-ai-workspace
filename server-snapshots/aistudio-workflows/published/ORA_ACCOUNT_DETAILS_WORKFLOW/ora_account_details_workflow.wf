          },
          "code": "GENERATE_ACCOUNT_SUBTITLE",
          "id": "1768257279478",
          "inputs": [
            {
              "id": "1768257279481_1",
              "name": "prompt",
              "type": "string",
              "value": "Based on the program JSON object {{$context.$nodes.GET_ACCOUNT_DETAIL.$output}} . Extract values and output exactly one line in this format (no extra text):\n\nAccount:\"<accountName>\", Industry: \"<industry>\", Region: \"<region>\", Account ARR: \"<arr>\"\n\nExtraction rules:\n\n<accountName> = accountName\n<industry> = industry\n<region> = region (if null, populate as All)\n<arr> = arr (Convert to represent in Billion or Million with 2 decimal points)\n\nHard constraints:\n\nOutput must be a single line in the exact format above.\n\nDo not add commentary, labels beyond those shown, or additional fields.\n\nIf any extracted value is missing/null, output it as an empty string."
            }
          ],
          "type": "LLM",
          "diagram": {
            "x": 7952,
            "y": 6370
          }
