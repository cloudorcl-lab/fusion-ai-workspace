        {
          "metadata": {
            "name": "Build Opportunity Payload",
            "returnType": "object",
            "sourceCode": "let result = {};\nconst accountId = $context.$variables.accountId;\nconst productId = $context.$variables.targetProductId;\nconst description = \"Cross Sell Opportunity for \" + $context.$variables.targetProductName;\n\n\nresult = {\n      \"targetAccountIdentifier\": accountId,\n      \"productIdentifier\": productId,\n      \"descriptionText\": description\n    };\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776898574698"
          },
