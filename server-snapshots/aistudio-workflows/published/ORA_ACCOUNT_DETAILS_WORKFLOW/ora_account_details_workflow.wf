            "errorNodeId": "1768257152225",
            "name": "Retrieve Account Id from Context",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  const appInputEncoded = $context.$triggers.REST.$input.OraAppContext || \"\";\n  let appInputJson = decodeURIComponent(appInputEncoded);\n appInputJson = appInputJson.replace(/:\\+\"/g, ': \"');\n  appInputJson = appInputJson.replace(/\\+\"/g, '\"');\n\n  const data = JSON.parse(appInputJson);\n  result.accountId = data.accountId || undefined;\n  result.targetProductId = data.targetProductId || undefined;\n  if (data.targetProductName) {\n    result.targetProductName = data.targetProductName.replace(/\\+/g, \" \");\n  }\n  result.checkOpportunity = data.checkOpportunity || false;\n} catch (error) {\n  result = {};\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1768256099171"
          },
          "code": "RETRIEVE_ACCOUNT_ID_FROM_CONTEXT",
          "id": "1768256044520",
          "inputs": [],
