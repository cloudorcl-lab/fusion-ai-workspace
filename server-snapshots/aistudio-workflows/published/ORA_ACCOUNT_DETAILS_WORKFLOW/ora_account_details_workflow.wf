          "id": "1768279868591",
          "inputs": [
            {
              "id": "1768279868592_1",
              "name": "prompt",
              "type": "string",
              "value": "Generate one high priority actionable insight with following properties:\n\ntitle: <AccountName>\nshortDescription: <shortDescription>\nactionText: \"Create Opportunity\",\npriority: \"high\",\nfollowUpCommand: \"ora.Invoke(createOpportunity, createOpportunity({\\\"targetProductId\\\":\\\"{{$context.$variables.targetProductId}}\\\",\\\"accountId\\\":\\\"{{$context.$variables.accountId}}\\\"}))\"\n\n<AccountName> = accountName from {{$context.$nodes.GET_ACCOUNT_DETAIL.$output}}\n<shortDescription> = Generate a simple statement to suggest to create opportunity for this cross sell for {{$context.$variables.targetProductName}}"
            }
          ],
          "type": "LLM",
          "diagram": {
            "x": 5532.5,
            "y": 7036
          }
        },
        {
          "metadata": {
            "name": "Retrieve Action Parameters",
            "returnType": "object",
            "sourceCode": "var payload = $context.$triggers.REST.$input.OraAction;\n\nconst jsonMatch = payload.match(/\\(\\{([\\s\\S]*)\\}\\)/);\n\nif (jsonMatch && jsonMatch.length > 1) {\n  var jsonString = `{${jsonMatch[1]}}`;\n\n  jsonString = jsonString.replace(/\\\\\\\"/g, '\"');\n\n  const obj = JSON.parse(jsonString);\n  return JSON.stringify(obj);\n}\n\nreturn \"\";"
          },
          "outcomes": {
            "success": "1781817881830"
          },
