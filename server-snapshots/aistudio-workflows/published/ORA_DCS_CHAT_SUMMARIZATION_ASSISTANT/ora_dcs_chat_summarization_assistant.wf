{
  "workflowId": "300000331058023",
  "workflowCode": "ORA_DCS_CHAT_SUMMARIZATION_ASSISTANT",
  "name": "DCS Chat Summarization Assistant",
  "description": "A chat summarization assistant that condenses long conversations into clear, actionable summaries—capturing key decisions, open questions, owners, and next steps—while respecting enterprise security and privacy requirements.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [
      {
        "name": "chatdata",
        "type": "object",
        "value": "{{$context.$triggers.REST.$input.chatdata}}"
      }
    ],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
