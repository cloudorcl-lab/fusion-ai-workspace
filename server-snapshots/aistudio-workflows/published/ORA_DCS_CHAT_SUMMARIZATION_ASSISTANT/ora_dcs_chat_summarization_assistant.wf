            "typeSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://example.com/schemas/chat-webhook-payload.schema.json\",\n  \"title\": \"Chat Webhook Payload\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"chat\"],\n  \"properties\": {\n    \"isProxyUser\": {\n      \"type\": \"boolean\",\n      \"description\": \"Optional flag indicating whether the request is for a proxy user flow.\"\n    },\n    \"summarySizeWords\": {\n      \"type\": \"integer\",\n      \"description\": \"Optional summary length target in words. Defaults to 500 when omitted.\"\n    },\n    \"chat\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"identifier\": {\n          \"type\": \"string\",\n          \"description\": \"Interaction identifier such as 300100647113347\",\n          \"minLength\": 1\n        },\n        \"subject\": {\n          \"type\": \"string\",\n          \"description\": \"Optional chat subject when a transcript is provided.\"\n        },\n        \"messages\": {\n          \"type\": \"array\",\n          \"description\": \"Optional transcript payload used instead of fetching by interaction id.\",\n          \"minItems\": 1,\n          \"items\": {\n            \"type\": \"object\",\n            \"additionalProperties\": false,\n            \"required\": [\"MessageContent\"],\n            \"properties\": {\n              \"MessageContent\": {\n                \"type\": \"string\"\n              },\n              \"MessageDate\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"MessageTypeCd\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"SenderType\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"PartyName\": {\n                \"type\": [\"string\", \"null\"]\n              }\n            }\n          }\n        }\n      },\n      \"anyOf\": [\n        {\n          \"required\": [\"identifier\"]\n        },\n        {\n          \"required\": [\"messages\"]\n        }\n      ]\n    }\n  }\n}"
