                      "value": "{{$context.$variables.pageLimit}}",
                      "required": false
                    },
                    {
                      "id": "1775913901001_1",
                      "name": "offset",
                      "value": "{{$context.$variables.offset}}",
                      "required": false
                    },
                    {
                      "id": "1775913901001_4",
                      "name": "totalRequest",
                      "value": "true",
                      "required": false
                    }
                  ],
                  "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://example.com/schemas/chatTranscriptResponse.schema.json\",\n  \"title\": \"ChatTranscriptResponse\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"items\", \"totalResults\", \"count\", \"hasMore\", \"limit\", \"offset\", \"links\"],\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"MessageContent\"],\n        \"properties\": {\n          \"MessageContent\": {\n            \"type\": \"string\",\n            \"description\": \"The content of the message.\"\n          },\n          \"MessageDate\": {\n            \"type\": [\"string\", \"null\"],\n            \"description\": \"The date and time when the message was created.\"\n          },\n          \"MessageTypeCd\": {\n            \"type\": [\"string\", \"null\"],\n            \"description\": \"The message type code.\"\n          },\n          \"SenderType\": {\n            \"type\": [\"string\", \"null\"],\n            \"description\": \"The sender type.\"\n          },\n          \"PartyName\": {\n            \"type\": [\"string\", \"null\"],\n            \"description\": \"The sender display name.\"\n          }\n        }\n      }\n    },\n    \"totalResults\": { \"type\": \"integer\", \"minimum\": 0 },\n    \"count\": { \"type\": \"integer\", \"minimum\": 0 },\n    \"hasMore\": { \"type\": \"boolean\" },\n    \"limit\": { \"type\": \"integer\", \"minimum\": 0 },\n    \"offset\": { \"type\": \"integer\", \"minimum\": 0 },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"properties\": {\n          \"rel\": { \"type\": \"string\" },\n          \"href\": { \"type\": \"string\", \"format\": \"uri\" },\n          \"name\": { \"type\": \"string\" },\n          \"kind\": { \"type\": \"string\" }\n        }\n      }\n    }\n  }\n}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "businessObjectCode": "ORA_CX_SERVICECEN_CHATTRANSCRIPTS",
                    "functionName": "getall_chatTranscript",
                    "name": "Fetch Chat Messages Page"
                  },
                  "outcomes": {
                    "success": "1775083012099"
                  },
                  "diagram": {
                    "x": 5393.338898109504,
                    "y": 6811.554086133184
                  },
                  "code": "FETCH_CHAT_MESSAGES_PAGE",
                  "id": "1772638003445",
                  "inputs": [
                    {
                      "id": "1772804951330_1",
                      "name": "offset",
                      "type": "string",
                      "value": "{{$context.$variables.offset}}"
                    },
                    {
                      "id": "1772804951331_2",
                      "name": "limit",
                      "type": "string",
                      "value": "{{$context.$variables.pageLimit}}"
                    },
                    {
                      "id": "1772804951331_3",
                      "name": "fields",
                      "type": "string",
                      "value": "MessageContent,MessageDate,MessageTypeCd,SenderType,PartyName"
                    },
                    {
                      "id": "1772804951332_4",
                      "name": "totalRequest",
                      "type": "string",
                      "value": "true"
                    },
                    {
                      "id": "1772804951333_5",
                      "name": "q",
                      "type": "string",
                      "value": "{{$context.$nodes.INITIAL_INTERACTION_ID_Q_PARAM_BUILDING.$output.result}}"
                    }
                  ],
                  "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://example.com/schemas/chatTranscriptResponse.schema.json\",\n  \"title\": \"ChatTranscriptResponse\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"items\", \"totalResults\", \"count\", \"hasMore\", \"limit\", \"offset\", \"links\"],\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"MessageContent\"],\n        \"properties\": {\n          \"MessageContent\": {\n            \"type\": \"string\",\n            \"description\": \"The content of the message.\"\n          },\n          \"MessageDate\": {\n            \"type\": [\"string\", \"null\"],\n            \"description\": \"The date and time when the message was created.\"\n          },\n          \"MessageTypeCd\": {\n            \"type\": [\"string\", \"null\"],\n            \"description\": \"The message type code.\"\n          },\n          \"SenderType\": {\n            \"type\": [\"string\", \"null\"],\n            \"description\": \"The sender type.\"\n          },\n          \"PartyName\": {\n            \"type\": [\"string\", \"null\"],\n            \"description\": \"The sender display name.\"\n          }\n        }\n      }\n    },\n    \"totalResults\": { \"type\": \"integer\", \"minimum\": 0 },\n    \"count\": { \"type\": \"integer\", \"minimum\": 0 },\n    \"hasMore\": { \"type\": \"boolean\" },\n    \"limit\": { \"type\": \"integer\", \"minimum\": 0 },\n    \"offset\": { \"type\": \"integer\", \"minimum\": 0 },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"properties\": {\n          \"rel\": { \"type\": \"string\" },\n          \"href\": { \"type\": \"string\", \"format\": \"uri\" },\n          \"name\": { \"type\": \"string\" },\n          \"kind\": { \"type\": \"string\" }\n        }\n      }\n    }\n  }\n}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "Compute Pagination State",
                    "language": "JAVASCRIPT",
                    "returnType": "object",
                    "sourceCode": "const isProxyUser = $context.$triggers.REST.$input.chatdata && $context.$triggers.REST.$input.chatdata.isProxyUser === true;\nconst pageOutput = isProxyUser\n  ? ($context.$nodes.FETCH_ALL_CHAT_MESSAGES.FETCH_PROXY_CHAT_MESSAGES_PAGE.$output || {})\n  : ($context.$nodes.FETCH_ALL_CHAT_MESSAGES.FETCH_CHAT_MESSAGES_PAGE.$output || {});\nconst existingMessages = Array.isArray($context.$variables.MESSAGES) ? $context.$variables.MESSAGES : [];\nconst pageMessages = Array.isArray(pageOutput.items) ? pageOutput.items : [];\nconst pageCount = Number(pageOutput.count || pageMessages.length || 0);\nconst nextHasMore = pageOutput.hasMore === true;\nconst nextFetchIterations = Number($context.$variables.fetchIterations || 0) + 1;\nif (nextHasMore && pageCount <= 0) {\n  throw new Error('Chat transcript pagination did not advance: hasMore=true but count=0');\n}\nif (nextHasMore && nextFetchIterations >= 50) {\n  throw new Error('Chat transcript pagination exceeded the WHILE iteration safety limit before completion');\n}\nconst result = {\n  messages: existingMessages.concat(pageMessages),\n  offset: Number($context.$variables.offset || 0) + pageCount,\n  hasMore: nextHasMore,\n  fetchIterations: nextFetchIterations\n};\nreturn result;"
                  },
                  "outcomes": {
                    "success": "1772805748048"
                  },
                  "diagram": {
                    "x": 5160.838898109504,
                    "y": 7033.554086133184
                  },
                  "code": "COMPUTE_PAGINATION_STATE",
                  "id": "1775083012099",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "Store Pagination State"
                  },
                  "outcomes": {
                    "success": "end_1772725499526"
                  },
                  "diagram": {
                    "x": 5160.838898109504,
                    "y": 7255.554086133184
                  },
                  "code": "STORE_PAGINATION_STATE",
                  "id": "1772805748048",
                  "inputs": [
                    {
                      "id": "1772805771498",
                      "name": "MESSAGES",
                      "scope": "JOB",
                      "type": "array",
                      "value": "{{$context.$nodes.FETCH_ALL_CHAT_MESSAGES.COMPUTE_PAGINATION_STATE.$output.result.messages}}"
                    },
                    {
                      "id": "1772805771499",
                      "name": "offset",
                      "scope": "JOB",
                      "type": "integer",
                      "value": "{{$context.$nodes.FETCH_ALL_CHAT_MESSAGES.COMPUTE_PAGINATION_STATE.$output.result.offset}}"
                    },
                    {
                      "id": "1772805771500",
                      "name": "hasMore",
                      "scope": "JOB",
                      "type": "boolean",
                      "value": "{{$context.$nodes.FETCH_ALL_CHAT_MESSAGES.COMPUTE_PAGINATION_STATE.$output.result.hasMore}}"
                    },
                    {
                      "id": "1772805771501",
                      "name": "fetchIterations",
                      "scope": "JOB",
                      "type": "integer",
                      "value": "{{$context.$nodes.FETCH_ALL_CHAT_MESSAGES.COMPUTE_PAGINATION_STATE.$output.result.fetchIterations}}"
                    }
                  ],
                  "type": "SET_FIELDS"
                },
                {
                  "metadata": {
                    "description": "End of while loop body",
                    "name": "End"
                  },
                  "outcomes": {},
                  "code": "END",
                  "id": "end_1772725499526",
                  "inputs": [],
                  "type": "END"
                }
              ]
            },
            "name": "Fetch All Chat Messages"
          },
          "outcomes": {
            "success": "1775076557715"
          },
          "code": "FETCH_ALL_CHAT_MESSAGES",
          "id": "1772725499526",
          "inputs": [
            {
              "id": "1772725499530_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$variables.hasMore === true && $context.$variables.fetchIterations < 50}}"
            }
          ],
          "type": "WHILE"
        },
        {
          "metadata": {
            "name": "Create Chunks",
            "returnType": "object",
            "sourceCode": "const messages = $context.$variables.MESSAGES || [];\nconst contextWindowInputSize = $context.$variables.contextWindowTokens || 0;\nconst chunks = [];\nlet currentMessages = [];\nlet currentTokens = 0;\nlet currentTranscript = \"\";\nfor (let i = 0; i < messages.length; i++) {\n  const message = messages[i] || {};\n  let text = message.MessageContent ?? \"\";\n  if (typeof text !== 'string') {\n    text = text ?? \"\";\n  }\n  if (text.length > 0) {\n    const candidate = text.replace(/\\s+/g, \"\");\n    if (candidate.length % 4 === 0 && /^[A-Za-z0-9+/=]+$/.test(candidate)) {\n      try {\n        const decoded = atob(candidate);\n        if (/^[\\x09\\x0A\\x0D\\x20-\\x7E]*$/.test(decoded) && btoa(decoded) === candidate) {\n          text = decoded;\n        }\n      } catch (e) {\n      }\n    }\n  }\n  if (text.length === 0) {\n    continue;\n  }\n  const tokenCount = Math.ceil(text.length / 4);\n  const normalizedMessage = { ...message, MessageContent: text };\n  const transcriptLine = `[${message.MessageDate ?? \"\"}] ${message.PartyName ?? \"Unknown\"} - ${message.SenderType ?? \"Unknown\"} - ${message.MessageTypeCd ?? \"Unknown\"}\\n${text}`;\n  if (currentMessages.length > 0 && currentTokens + tokenCount > contextWindowInputSize) {\n    chunks.push({ messages: currentMessages, transcript: currentTranscript });\n    currentMessages = [];\n    currentTokens = 0;\n    currentTranscript = \"\";\n  }\n  currentMessages.push(normalizedMessage);\n  currentTokens += tokenCount;\n  currentTranscript = currentTranscript ? `${currentTranscript}\\n\\n${transcriptLine}` : transcriptLine;\n  if (contextWindowInputSize > 0 && tokenCount > contextWindowInputSize) {\n    chunks.push({ messages: currentMessages, transcript: currentTranscript });\n    currentMessages = [];\n    currentTokens = 0;\n    currentTranscript = \"\";\n  }\n}\nif (currentMessages.length > 0) {\n  chunks.push({ messages: currentMessages, transcript: currentTranscript });\n}\nconst result = { chunks: chunks, chunkCount: chunks.length, hasMultipleChunks: chunks.length > 1 };\nreturn result;"
          },
          "outcomes": {
            "success": "1776031005399"
          },
          "code": "CREATE_CHUNKS",
          "id": "1775076557715",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Extract First Chunk Transcript",
            "returnType": "string",
            "sourceCode": "const chunkResult = $context.$nodes.CREATE_CHUNKS.$output.result || {};\nconst chunks = Array.isArray(chunkResult.chunks) ? chunkResult.chunks : [];\nconst firstChunk = chunks.length > 0 ? chunks[0] : null;\nif (!firstChunk || typeof firstChunk.transcript !== 'string' || firstChunk.transcript.trim().length === 0) {\n  throw new Error('First chunk transcript is missing');\n}\nreturn firstChunk.transcript;"
          },
          "outcomes": {
            "success": "1775080668734"
          },
          "code": "EXTRACT_FIRST_CHUNK_TRANSCRIPT",
          "id": "1776031005399",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Summarize First Chunk"
          },
          "outcomes": {
            "success": "1776031005401"
          },
          "code": "LLM_SUMMARY_OF_FIRST_CHUNK",
          "id": "1775080668734",
          "inputs": [
            {
              "id": "1775080668734_1",
              "name": "prompt",
              "type": "string",
              "value": "You are summarizing the first chunk of a customer service chat transcript.\nUse only the provided transcript. Do not invent details.\n\nReturn only a JSON object with exactly these top-level fields:\n- \"summary\": a concise plain-language summary that mentions the issue, actions taken, resolution status, and whether follow-up is needed only when the transcript supports those points. Write the summary from the customer's point of view, in second person, as if the customer asked for the summary. Prefer phrasing such as \"you contacted the agent\" and \"your KX 250\" instead of third-person wording such as \"the customer contacted the agent\" or \"his KX 250\". Keep it to about {{$context.$variables.summarySizeWords}} words or less.\n- \"chunkHandoff\": a small handoff object used by the next chunk. It must contain:\n  - \"recentTopic\": short string or empty string\n  - \"recentStatus\": short string or empty string\n  - \"pendingTopics\": array of zero or more objects with fields \"topic\", \"customerQuestion\", and \"status\"\n\nRules for chunkHandoff:\n- Include only unresolved topics or questions that are explicitly present in this chunk.\n- If a question is asked but not answered in this chunk, include it in pendingTopics with status \"awaiting_answer\".\n- Keep pendingTopics small and focused on the most relevant unresolved items.\n- If nothing is pending, use an empty array.\n- Do not include topics that are already resolved within this chunk.\n\nChat transcript:\n{{$context.$nodes.EXTRACT_FIRST_CHUNK_TRANSCRIPT.$output.result}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"summary\": {\n      \"type\": \"string\"\n    },\n    \"chunkHandoff\": {\n      \"type\": \"object\"\n    }\n  },\n  \"required\": [\n    \"summary\",\n    \"chunkHandoff\"\n  ]\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Normalize First Chunk Summary",
            "returnType": "object",
            "sourceCode": "let v = $context.$nodes.LLM_SUMMARY_OF_FIRST_CHUNK.$output;\nif (typeof v === 'string') {\n  const t = v.trim();\n  if (t) {\n    try {\n      v = JSON.parse(t);\n    } catch (e) {\n      v = { summary: t };\n    }\n  } else {\n    v = {};\n  }\n} else if (v && typeof v === 'object' && v.result && typeof v.result === 'object' && v.summary === undefined && v.chunkHandoff === undefined) {\n  v = v.result;\n} else if (!v || typeof v !== 'object') {\n  v = {};\n}\nconst h = v.chunkHandoff && typeof v.chunkHandoff === 'object' ? v.chunkHandoff : {};\nconst p = [];\nif (Array.isArray(h.pendingTopics)) {\n  for (let i = 0; i < h.pendingTopics.length; i++) {\n    const x = h.pendingTopics[i] || {};\n    const topic = typeof x.topic === 'string' ? x.topic.trim() : '';\n    const q = typeof x.customerQuestion === 'string' ? x.customerQuestion.trim() : '';\n    const status = typeof x.status === 'string' && x.status.trim() ? x.status.trim() : 'awaiting_answer';\n    if (topic || q) {\n      p.push({ topic: topic, customerQuestion: q, status: status });\n    }\n  }\n}\nconst n = {\n  recentTopic: typeof h.recentTopic === 'string' ? h.recentTopic.trim() : '',\n  recentStatus: typeof h.recentStatus === 'string' ? h.recentStatus.trim() : '',\n  pendingTopics: p\n};\nconst result = {\n  summary: typeof v.summary === 'string' ? v.summary.trim() : '',\n  chunkHandoff: n,\n  chunkHandoffText: JSON.stringify(n)\n};\nreturn result;"
          },
