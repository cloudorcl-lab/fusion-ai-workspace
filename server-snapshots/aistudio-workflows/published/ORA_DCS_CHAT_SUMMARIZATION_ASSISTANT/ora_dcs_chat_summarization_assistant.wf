                  "type": "CONDITION"
                },
                {
                  "metadata": {
                    "businessObjectCode": "ORA_CX_SERVICECEN_PUDSCHATINTERACTIONSWITHINTERACTIONID",
                    "functionName": "get_chatinteractions_by_id",
                    "name": "Fetch Proxy Chat Messages Page"
                  },
                  "outcomes": {
                    "success": "1775083012099"
                  },
                  "diagram": {
                    "x": 4928.338898109504,
                    "y": 6811.554086133184
                  },
                  "code": "FETCH_PROXY_CHAT_MESSAGES_PAGE",
                  "id": "1775913901001",
                  "inputs": [
                    {
                      "id": "1775913901001_interactionId",
                      "name": "interactionId",
                      "value": "{{$context.$nodes.EXTRACT_INTERACTION_ID.$output.result}}",
                      "required": false
                    },
                    {
                      "id": "1775913901001_3",
                      "name": "fields",
                      "value": "MessageContent,MessageDate,MessageTypeCd,SenderType,PartyName",
                      "required": false
                    },
                    {
                      "id": "1775913901001_2",
