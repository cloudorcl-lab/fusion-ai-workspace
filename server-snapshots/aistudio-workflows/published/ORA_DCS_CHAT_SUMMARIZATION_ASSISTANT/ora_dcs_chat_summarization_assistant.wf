          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "name": "Extract Interaction ID",
            "returnType": "object",
            "sourceCode": "const payload = $context.$triggers.REST.$input.chatdata || {};\nconst chat = payload.chat || {};\nconst interactionIdentifier = typeof chat.identifier === 'string' ? chat.identifier.trim() : '';\nconst messages = Array.isArray(chat.messages) ? chat.messages : [];\nlet result = null;\nif (interactionIdentifier) {\n  result = interactionIdentifier;\n} else if (messages.length > 0) {\n  result = null;\n} else {\n  throw new Error(\"Provide either chat.identifier (InteractionId) or a non-empty chat.messages array in the payload\");\n}\nreturn result;"
          },
          "outcomes": {
            "success": "1772723663332"
          },
          "code": "EXTRACT_INTERACTION_ID",
          "id": "1772452768594",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Initialize the tokens, page, response limits"
          },
          "outcomes": {
            "success": "1772642518176"
          },
          "code": "INIT_LIMITS",
          "id": "1772723663332",
          "inputs": [
            {
              "id": "1772804725665",
              "name": "offset",
              "value": "0"
            },
            {
              "id": "1772803996413",
              "name": "MESSAGES",
              "value": "{{$context.$triggers.REST.$input.chatdata.chat && $context.$triggers.REST.$input.chatdata.chat.messages ? $context.$triggers.REST.$input.chatdata.chat.messages : []}}"
            },
            {
              "id": "1772724202244",
              "name": "summarySizeWords",
              "value": "{{$context.$triggers.REST.$input.chatdata && $context.$triggers.REST.$input.chatdata.summarySizeWords != null ? $context.$triggers.REST.$input.chatdata.summarySizeWords : 500}}"
            },
            {
              "id": "1772724109187",
              "name": "contextWindowTokens",
              "value": "400000"
            },
            {
              "id": "1772723699161",
              "name": "pageLimit",
              "value": "500"
            },
            {
              "id": "1772723699162",
              "name": "hasMore",
              "value": "{{$context.$triggers.REST.$input.chatdata.chat && $context.$triggers.REST.$input.chatdata.chat.messages && $context.$triggers.REST.$input.chatdata.chat.messages.length > 0 ? false : true}}"
            },
            {
              "id": "1772723699163",
              "name": "fetchIterations",
              "value": "0"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Initial InteractionId q param building",
            "returnType": "object",
            "sourceCode": "const interactionId = $context.$nodes.EXTRACT_INTERACTION_ID.$output.result;\nlet result = '';\nif (typeof interactionId === 'string' && interactionId.trim().length > 0) {\n  result = `InteractionId=${interactionId}`;\n}\nreturn result;"
          },
          "outcomes": {
            "success": "1772725499526"
          },
          "code": "INITIAL_INTERACTION_ID_Q_PARAM_BUILDING",
          "id": "1772642518176",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "dataPipeline": {
              "rootNode": "1775913901000",
              "pipelineNodes": [
                {
