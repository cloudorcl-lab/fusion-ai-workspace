            "name": "GenerateQueryForSchedule",
            "returnType": "object",
            "sourceCode": "const orgId = $context.$variables.OrganizationId;\nconst currentDateStr = $context.$system.$currentDate;\nconst remDays = Number($context.$variables.DaysUntilMonthEnd || 0);\n\nconst currentDate = new Date(currentDateStr);\n\nconst endOfMonth = new Date(currentDate);\nendOfMonth.setMonth(endOfMonth.getMonth() + 1, 0);\n\nconst thresholdDate = new Date(endOfMonth);\nthresholdDate.setDate(thresholdDate.getDate() - remDays);\n\nif (currentDate < thresholdDate) {\n  return JSON.stringify(null);\n}\n\nconst fromDate = currentDate.toISOString().split(\"T\")[0];\nconst toDate = endOfMonth.toISOString().split(\"T\")[0];\n\nconst qParam =\n  \"fields=Order,ShipmentLine,OrderTypeCode,LineStatusCode,LineStatus,LineUnitPrice,SourceRequestedQuantity,RequestedQuantity,ShippingPriorityCode,ShippingPriority,ScheduledShipDate,CurrencyCode,CurrencyName,RequestedQuantityUOM,SourceRequestedQuantityUOM,SourceSystemCode\" +\n  \"&onlyData=true\" +\n  \"&q=OrganizationId=\" + orgId +\n  \" and (LineStatusCode='R' or LineStatusCode='B')\" +\n  \" and ScheduledShipDate>='\" + fromDate + \"'\" +\n  \" and ScheduledShipDate<='\" + toDate + \"'\" +\n  \"&orderBy=Order\" +\n  \"&limit=50\";\n\nconst result = {\n  fromDate: fromDate,\n  toDate: toDate,\n  thresholdDate: thresholdDate.toISOString().split(\"T\")[0],\n  qParam: qParam\n};\n\nreturn JSON.stringify(result);"
          },
          "outcomes": {
            "success": "1776363413848"
          },
          "code": "GENERATEQUERYFORSCHEDULE",
          "convergenceTargetId": "1775034859749",
          "id": "1775034744848",
