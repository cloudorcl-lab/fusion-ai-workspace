        {
          "metadata": {
            "name": "GetOrderNumbersForActions",
            "returnType": "object",
            "sourceCode": "const input = $context.$nodes.READ_EMAILS_FOR_ACTIONS.$output;\n\nconst orderNumbers = new Set();\n\n// Loop through each item in the input array\nfor (let i = 0; i < input.length; i++) {\n  // Check if 'text' field exists and is a valid JSON string\n  if (input[i] && input[i].text) {\n    try {\n      // Parse the text field into a JSON object\n      const textObject = JSON.parse(input[i].text);\n\n      // Check if 'Order' field exists within the parsed text\n      if (textObject.Order) {\n        // Add it to the Set (avoids duplicates)\n        orderNumbers.add(textObject.Order);\n      }\n    } catch (error) {\n      // Ignore the error (console logs are removed as per your request)\n    }\n  }\n}\n\n// Convert the Set to an array and return the result\nconst uniqueOrderNumbers = Array.from(orderNumbers);\n\nreturn uniqueOrderNumbers;"
          },
          "outcomes": {
            "success": "1771825837268"
          },
