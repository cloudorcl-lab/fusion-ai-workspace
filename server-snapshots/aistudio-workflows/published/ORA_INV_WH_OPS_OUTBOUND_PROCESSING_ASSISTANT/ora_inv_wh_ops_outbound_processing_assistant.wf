          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"description\": \"\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"Order\",\n          \"ShipmentLine\",\n          \"OrderTypeCode\",\n          \"LineStatusCode\",\n          \"LineStatus\",\n          \"LineUnitPrice\",\n          \"SourceRequestedQuantity\",\n          \"RequestedQuantity\",\n          \"ShippingPriorityCode\",\n          \"ShippingPriority\",\n          \"ScheduledShipDate\",\n          \"CurrencyCode\",\n          \"CurrencyName\",\n          \"RequestedQuantityUOM\",\n          \"SourceRequestedQuantityUOM\",\n          \"SourceSystemCode\"\n        ],\n        \"properties\": {\n          \"Order\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"ShipmentLine\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"OrderTypeCode\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"LineStatusCode\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"LineStatus\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"LineUnitPrice\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"SourceRequestedQuantity\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"RequestedQuantity\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"ShippingPriorityCode\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"ShippingPriority\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"ScheduledShipDate\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"CurrencyCode\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"CurrencyName\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"RequestedQuantityUOM\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"SourceRequestedQuantityUOM\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"SourceSystemCode\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"@context\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"key\": {\n                \"type\": \"string\",\n                \"minLength\": 1\n              }\n            },\n            \"required\": [\n              \"key\"\n            ]\n          }\n        }\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"href\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"name\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"kind\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ]\n}",
          "type": "BO_FUNCTION"
