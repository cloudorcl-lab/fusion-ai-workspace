                  ],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"description\": \"\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"Order\",\n          \"OrderTypeCode\",\n          \"LineStatusCode\",\n          \"SoldToCustomer\"\n        ],\n        \"properties\": {\n          \"Order\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"OrderTypeCode\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"LineStatusCode\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"SoldToCustomer\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"@context\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"key\": {\n                \"type\": \"string\",\n                \"minLength\": 1\n              }\n            },\n            \"required\": [\n              \"key\"\n            ]\n          }\n        }\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"href\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"name\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"kind\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ]\n}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "GenerateQueryForOrder",
                    "returnType": "string",
                    "sourceCode": "// Build the querystring dynamically\nconst orgId = $context.$variables.OrganizationId;\nconst order = $context.$nodes.GETCUSTOMERNAMES.$currentItem;\n\nconst qs =\n  \"fields=Order,OrderTypeCode,LineStatusCode,SoldToCustomer\" +\n  \"&onlyData=true\" +\n  \"&q=OrganizationId=\" + orgId + \" and Order='\" + order + \"'\";\n\nreturn qs;"
                  },
                  "outcomes": {
                    "success": "1771825877013"
                  },
                  "code": "GENERATEQUERYFORORDER",
                  "id": "1773666802602",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
