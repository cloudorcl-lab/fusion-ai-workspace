        {
          "metadata": {
            "name": "GenerateQueryForUnreservedDemand",
            "returnType": "string",
            "sourceCode": "const orgId = $context.$variables.OrganizationId;\nconst currentDateStr = $context.$system.$currentDate;\n\n// Use actual current timestamp (no forcing to 00:00:00)\nconst startDate = new Date(currentDateStr);\n\n// Add 48 hours\nconst endDate = new Date(startDate);\nendDate.setHours(endDate.getHours() + 48);\n\n// Format to YYYY-MM-DDTHH:mm:ss\nconst formatDateTime = (date) => {\n  const yyyy = date.getFullYear();\n  const mm = String(date.getMonth() + 1).padStart(2, \"0\");\n  const dd = String(date.getDate()).padStart(2, \"0\");\n  const hh = String(date.getHours()).padStart(2, \"0\");\n  const mi = String(date.getMinutes()).padStart(2, \"0\");\n  const ss = String(date.getSeconds()).padStart(2, \"0\");\n  return `${yyyy}-${mm}-${dd}T${hh}:${mi}:${ss}`;\n};\n\nconst fromDate = formatDateTime(startDate);\nconst toDate = formatDateTime(endDate);\n\nconst qParam =\n  \"finder=findByNoDemandReservation;bindOrganizationId=\" + orgId +\n  \"&fields=Order,OrderTypeCode,ScheduledShipDate,LineStatusCode,OrganizationId,SoldToCustomer,Item,SourceOrderId,SourceOrderLineId,RequestedQuantity,RequestedQuantityUOM,LineStatus,LineUnitPrice,SourceDocumentTypeId\" +\n  \"&onlyData=true\" +\n  \"&q=LineStatusCode IN ('R','B')\" +\n  \" AND ScheduledShipDate >= '\" + fromDate + \"'\" +\n  \" AND ScheduledShipDate < '\" + toDate + \"'\" +\n  \" AND OrganizationId=\" + orgId +\n  \"&limit=50\";\n\n/*return {\n  qParam,\n  fromDate,\n  toDate\n};*/\n\nreturn qParam;"
          },
          "outcomes": {
            "success": "1776152356544"
          },
          "code": "GENERATEQUERYFORUNRESERVEDDEMAND",
          "convergenceTargetId": "1776245519682",
          "id": "1776152279649",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
