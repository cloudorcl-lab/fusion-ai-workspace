          "metadata": {
            "name": "Override Intent",
            "returnType": "string",
            "sourceCode": "let originalIntent = $context.$app.$OraMessageHint;\n\n// Handle cases for \"InitDisplay\" or \"Summary\"\nif (originalIntent === \"InitDisplay\" || originalIntent === \"Summary\") {\n    originalIntent = \"InitDisplay\";\n}\n\n// Check if the trigger type is EMAIL and modify intent accordingly\nif ($context.$system.$triggerType === 'EMAIL') {\n    originalIntent = 'SaveEmail';\n    return originalIntent;\n}\n\n \nif ($context.$system.$inputMessage === 'START') {\n    originalIntent = 'ScheduleFlow';\n    return originalIntent;\n}\n\n// Handle REST input intent override\nif ($context.$triggers.REST.$input.intentOverride) {\n    originalIntent = $context.$triggers.REST.$input.intentOverride;\n}\n\n\n    return originalIntent;"
          },
          "outcomes": {
            "success": "1771481778160"
          },
