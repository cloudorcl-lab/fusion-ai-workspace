          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"description\": \"\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"Order\",\n          \"RequestedQuantity\",\n          \"RequestedQuantityUOM\",\n          \"ScheduledShipDate\",\n          \"Item\",\n          \"UnitPrice\"\n        ],\n        \"properties\": {\n          \"Order\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"RequestedQuantity\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"RequestedQuantityUOM\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"ShippingPriorityCode\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"ScheduledShipDate\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"Item\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"UnitPrice\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"@context\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"key\": {\n                \"type\": \"string\",\n                \"minLength\": 1\n              }\n            },\n            \"required\": [\n              \"key\"\n            ]\n          }\n        }\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"href\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"name\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"kind\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ]\n}",
