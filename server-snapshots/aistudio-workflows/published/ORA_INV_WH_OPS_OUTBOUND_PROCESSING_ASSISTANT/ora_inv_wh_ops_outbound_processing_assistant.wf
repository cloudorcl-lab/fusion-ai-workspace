        {
          "metadata": {
            "name": "GetOrderNumbersForComms",
            "returnType": "object",
            "sourceCode": "const input = $context.$nodes.READ_EMAILS_FOR_COMMUNICATIONS.$output;\n\n// Map to deduplicate by Order\nconst orderMap = new Map();\n\n// Loop through input\nfor (let i = 0; i < input.length; i++) {\n  if (input[i] && input[i].text) {\n    try {\n      const textObject = JSON.parse(input[i].text);\n\n      if (textObject.Order && !orderMap.has(textObject.Order)) {\n        orderMap.set(textObject.Order, {\n          Order: textObject.Order,\n          fromAddress: textObject.fromAddress || null,\n          content: textObject.content || null\n        });\n      }\n    } catch (e) {\n      // Ignore malformed JSON\n    }\n  }\n}\n\n// Convert Map values to array\nconst result = Array.from(orderMap.values());\n\nreturn result;"
          },
          "outcomes": {
            "success": "1771997931264"
          },
