        {
          "metadata": {
            "name": "FormatUnreservedData",
            "returnType": "object",
            "sourceCode": "const items = Array.isArray($context.$nodes.GETUNRESERVEDORDERLINES.$output.items)\n  ? $context.$nodes.GETUNRESERVEDORDERLINES.$output.items\n  : [];\n\nconst grouped = new Map();\n\nfor (const row of items) {\n  const key = row.SourceOrderLineId;\n  if (!key) continue;\n\n  const qty = Number(row.RequestedQuantity ?? 0);\n\n  if (!grouped.has(key)) {\n    grouped.set(key, {\n      Order:row.Order,\n      SourceOrderId: row.SourceOrderId,\n      SourceOrderLineId: row.SourceOrderLineId,\n      SourceDocumentTypeId: row.SourceDocumentTypeId,\n      Item: row.Item,\n      \"RequestedQuantity\": 0,\n      \"RequestedQuantityUOM\": row.RequestedQuantityUOM,\n      Customer: row.SoldToCustomer\n    });\n  }\n\n  const agg = grouped.get(key);\n  agg[\"RequestedQuantity\"] += qty;\n}\n\nconst result = Array.from(grouped.values()).map(row => ({\n  ...row,\n  \"RequestedQuantity\": String(row[\"RequestedQuantity\"])\n}));\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776244788481"
          },
