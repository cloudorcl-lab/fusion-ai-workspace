              "type": "integer"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"index\": {\n        \"type\": \"integer\"\n      },\n      \"text\": {\n        \"type\": \"string\"\n      }\n    },\n    \"required\": [\n      \"index\",\n      \"text\"\n    ]\n  }\n}",
          "type": "VECTOR_DB_READER"
        },
        {
          "metadata": {
            "name": "GetActionedOrders",
            "returnType": "array",
            "sourceCode": "const input = $context.$nodes.READ_VECTOR_FOR_ACTIONS.$output;\nconst orderMap = new Map(); // to avoid duplicates\n\n// Loop through each item in the input array\nfor (let i = 0; i < input.length; i++) {\n  if (input[i] && input[i].text) {\n    try {\n      const textObject = JSON.parse(input[i].text);\n\n      if (textObject.Order) {\n        orderMap.set(textObject.Order, {\n          Order: textObject.Order,\n          Customer: textObject.Customer\n        });\n      }\n    } catch (error) {\n      // ignore\n    }\n  }\n}\n\n// Convert map values to array\nreturn Array.from(orderMap.values());"
          },
          "outcomes": {
            "success": "1775208875043"
          },
          "code": "GETACTIONEDORDERS",
          "id": "1775200402577",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
