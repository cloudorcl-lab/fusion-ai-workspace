            "sourceCode": "// Get original object\nconst data = $context.$nodes.PRIORITY_ORDER_MAIL_EXTRACT.$output;\n\n// Get additional values\nconst batchId = $context.$nodes.PICKRELEASEPRIORITYDEMANDORDER.$output.BatchId;\nconst batchName = $context.$nodes.PICKRELEASEPRIORITYDEMANDORDER.$output.PickingBatchName;\nconst customer = $context.$nodes.FETCHORDERTYPE.$output.items[0].SoldToCustomer;\n\n// Add new fields\ndata.BatchId = batchId;\ndata.BatchName = batchName;\ndata.Customer = customer;\n// Return updated object\nreturn data;"
