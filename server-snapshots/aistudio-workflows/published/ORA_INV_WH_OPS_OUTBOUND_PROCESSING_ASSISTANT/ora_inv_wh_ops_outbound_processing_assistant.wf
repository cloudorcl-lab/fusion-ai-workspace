        {
          "metadata": {
            "name": "GenerateQueryForOrderDetails",
            "returnType": "string",
            "sourceCode": "// Build the querystring dynamically\nconst orgId = $context.$variables.OrganizationId;\nconst order = $context.$nodes.EXTRACT_ORDERNUMBER.$output.result;\n\nconst qs =\n  \"fields=Order,OrderTypeCode,LineStatusCode,SourceSystemCode\" +\n  \"&onlyData=true\" +\n  \"&q=OrganizationId=\" + orgId + \" and Order='\" + order + \"'\";\n\nreturn qs;"
