          "metadata": {
            "name": "ExtractOrderParams",
            "returnType": "object",
            "sourceCode": "// Assuming the input is directly the suggestion JSON\nconst suggestion = $context.$nodes.RESOLVE_ACTION.$output.result.suggestion;\n\n// Initialize the fields you want to extract\nlet order = null;\nlet organization = null;\n\n// Check if the suggestion object is valid\nif (suggestion) {\n  // Extract the values from the suggestion object\n  order = suggestion.Order;\n  organization = suggestion.Organization;\n}\n\n// Create a new object with the extracted fields\nconst obj = {\n  Order: order,\n  Organization: organization\n};\n\n// Return the object containing Order and Organization\nreturn obj;"
          },
          "outcomes": {
            "success": "1776330120970"
          },
          "code": "EXTRACTORDERPARAMS",
          "id": "1771877087684",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
