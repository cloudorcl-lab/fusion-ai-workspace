        {
          "metadata": {
            "name": "FormatAwaitingPickingData",
            "returnType": "array",
            "sourceCode": "const input = $context.$nodes.GETAPORDERS.$output.items;\n\nconst grouped = new Map();\n\nfor (const row of input) {\n  const orderNumber = row.Order;\n\n  if (!grouped.has(orderNumber)) {\n    grouped.set(orderNumber, {\n      OrderNumber: orderNumber,\n      Customer: row.SoldToCustomer,\n      LineCount: 0\n    });\n  }\n\n  grouped.get(orderNumber).LineCount += 1;\n}\n\n// Return list of JSON (single array)\nreturn [\n  {\n    json: Array.from(grouped.values())\n  }\n];"
          },
          "outcomes": {
            "success": "1771485698489"
          },
          "code": "FORMATAWAITINGPICKINGDATA",
          "id": "1776742971052",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "FormatShortageData",
            "returnType": "array",
            "sourceCode": "const input = $context.$nodes.GETSHORTAGEORDERS.$output.items;\n\nif (!Array.isArray(input) || input.length === 0) {\n  return [];\n}\n\nconst grouped = new Map();\n\nfor (const row of input) {\n  const item = row.Item;\n  const order = row.Order;\n  const qty = Number(row.RequestedQuantity ?? 0);\n  const unitPrice = Number(row.UnitPrice ?? 0);\n  const uom = row.RequestedQuantityUOM;\n\n  const key = `${item}||${order}`;\n\n  if (!grouped.has(key)) {\n    grouped.set(key, {\n      Item: item,\n      Order: order,\n      Qty: 0,\n      UOM: uom,\n      DelayedDemandValue: 0,\n      LineCount: 0\n    });\n  }\n\n  const current = grouped.get(key);\n\n  current.Qty += Number.isFinite(qty) ? qty : 0;\n  current.DelayedDemandValue += (Number.isFinite(qty) ? qty : 0) * (Number.isFinite(unitPrice) ? unitPrice : 0);\n  current.LineCount += 1;\n}\n\nreturn Array.from(grouped.values()).map(row => ({\n  json: row\n}));"
          },
          "outcomes": {
            "success": "1771485494935"
          },
          "code": "FORMATSHORTAGEDATA",
          "id": "1776743589712",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
