        {
          "metadata": {
            "name": "PrepareDataForActions",
            "returnType": "object",
            "sourceCode": "const orders = $context.$nodes.GETORDERNUMBERSFORACTIONS.$output.result;\nconst customerResponses = $context.$nodes.GETCUSTOMERNAMES.$output;\n\nconst resultOrders = []; // renamed\nconst processedOrdersList = [];\n\n// Handle case when there are no orders\nif (!orders || orders.length === 0) {\n  return {\n    resultOrders: [],\n    processedOrdersList: []\n  };\n}\n\nfor (let i = 0; i < orders.length; i++) {\n  if (!customerResponses[i]) continue;\n\n  let parsed;\n  try {\n    parsed = JSON.parse(customerResponses[i]);\n  } catch {\n    continue;\n  }\n\n  if (!parsed.items || parsed.items.length === 0) continue;\n\n  const customer = parsed.items[0].SoldToCustomer;\n  if (!customer) continue;\n\n  const noLineStatusR = parsed.items.every(item => item.LineStatusCode !== 'R');\n  const hasLineStatusR = parsed.items.some(item => item.LineStatusCode === 'R');\n\n  if (noLineStatusR) {\n    processedOrdersList.push(orders[i]);\n  }\n\n  if (hasLineStatusR) {\n    resultOrders.push({\n      Order: orders[i],\n      Customer: customer\n    });\n  }\n}\n\n// Return updated names\nreturn {\n  resultOrders,\n  processedOrdersList\n};"
          },
          "outcomes": {
            "success": "1773667435851"
          },
          "code": "PREPAREDATAFORACTIONS",
          "convergenceTargetId": "1775200138915",
          "id": "1771826317285",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "FetchShippedRows",
            "returnType": "array",
            "sourceCode": "const processedOrders = $context.$nodes.PREPAREDATAFORACTIONS.$output.result.processedOrdersList;\nconst emails = $context.$nodes.READ_EMAILS_FOR_ACTIONS.$output;\n\n// Guard checks\nif (\n  !processedOrders ||\n  !Array.isArray(processedOrders) ||\n  processedOrders.length === 0 ||\n  !Array.isArray(emails)\n) {\n  return [];\n}\n\n// Collect matching documentIdentifiers\nconst result = [];\n\n// Iterate through processedOrders (which is a list of orders)\nfor (let i = 0; i < processedOrders.length; i++) {\n  const orderNumber = processedOrders[i]; // Extract the order number\n  \n  // Iterate through emails and find matching document identifiers\n  for (let j = 0; j < emails.length; j++) {\n    if (emails[j].Order === orderNumber) {\n      result.push(emails[j].documentIdentifier);\n    }\n  }\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1773667808386"
          },
          "code": "FETCHSHIPPEDROWS",
