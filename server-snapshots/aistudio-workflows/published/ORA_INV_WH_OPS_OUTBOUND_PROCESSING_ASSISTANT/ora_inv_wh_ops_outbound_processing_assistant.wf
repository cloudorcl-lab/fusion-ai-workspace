          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"description\": \"\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"Order\",\n          \"OrderTypeCode\",\n          \"ScheduledShipDate\",\n          \"LineStatusCode\",\n          \"OrganizationId\",\n          \"SoldToCustomer\",\n          \"Item\",\n          \"SourceOrderId\",\n          \"SourceOrderLineId\",\n          \"RequestedQuantity\",\n          \"RequestedQuantityUOM\",\n          \"LineStatus\",\n          \"LineUnitPrice\",\n          \"SourceDocumentTypeId\"\n        ],\n        \"properties\": {\n          \"Order\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"OrderTypeCode\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"ScheduledShipDate\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"LineStatusCode\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"OrganizationId\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"SoldToCustomer\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"Item\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"SourceOrderId\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"SourceOrderLineId\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"RequestedQuantity\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"RequestedQuantityUOM\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n      