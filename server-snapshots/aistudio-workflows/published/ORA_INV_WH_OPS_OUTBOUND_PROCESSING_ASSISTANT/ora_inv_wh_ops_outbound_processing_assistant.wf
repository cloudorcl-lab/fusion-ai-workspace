            "success": "1773654080308"
          },
          "code": "CHECKORGLEVELAVAILABILITY",
          "id": "1773653523012",
          "inputs": [
            {
              "id": "1773653523014_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.GETDISTINCTITEMIDS.$output.result}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "ATRPerItemCheck",
            "returnType": "object",
            "sourceCode": "let input1 = $context.$nodes.CHECKORGLEVELAVAILABILITY.$output;  // Input 1: org-level availability data\nlet input2 = $context.$nodes.GETDISTINCTITEMIDS.$output.result;   // Input 2: requested items with quantities\n\n// Initialize result object\nlet result = {\n  \"res\": true,        // Set default result to true\n  \"UnAvailList\": []   // Empty list to hold unavailable items\n};\n\n// Ensure both input1 is an array of strings and input2 is valid\nif (Array.isArray(input1) && input1.length > 0 && Array.isArray(input2) && input1.length === input2.length) {\n    // Loop through each item in Input 2 (the distinct items list)\n    input2.forEach((item, index) => {\n        // Parse the corresponding JSON string from Input 1\n        let parsedItem = JSON.parse(input1[index]);\n\n        // Check if parsedItem has valid \"items\" array\n        if (parsedItem && Array.isArray(parsedItem.items) && parsedItem.items.length > 0) {\n            let matchedItem = parsedItem.items[0]; // Since it's an array, take the first item\n\n            // Check if AvailableToTransactQuantity is less than TotalRequestedQuantity\n            let availableQuantity = parseInt(matchedItem.AvailableToTransactQuantity);  // Convert to integer\n\n            if (availableQuantity < item.TotalRequestedQuantity) {\n                result.res = false;  // Set result to false since one item is unavailable\n                result.UnAvailList.push({\n                    \"ItemId\": item.ItemId,\n                    \"Item\": item.Item\n                });\n            }\n        } else {\n            result.res = false; // If there's an issue with the parsed item\n            result.UnAvailList.push({\n                \"ItemId\": item.ItemId,\n                \"Item\": item.Item\n            });\n        }\n    });\n} else {\n    // If input1 is not a valid array of strings, or input2 is not an array, or their lengths don't match\n    result.res = false;\n    result.error = \"Input arrays are invalid or have mismatched lengths.\";\n}\n\nlet jsonString = JSON.stringify(result);\n\n// Output the valid JSON string\nreturn jsonString;"
          },
          "outcomes": {
            "success": "1773656252508"
          },
          "code": "ATRPERITEMCHECK",
          "id": "1773654080308",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "RespondStockAvailability"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "RESPONDSTOCKAVAILABILITY",
          "id": "1773656252508",
          "inputs": [
            {
              "id": "1773656252509_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an assistant helping a user understand their order and stock situation.\n\n## Inputs\n1) **User message / intent**:  \n`{{$context.$system.$inputMessage}}`\n\n2) **Order lines (items + requested quantity)**:  \n`{{$context.$nodes.GETDISTINCTITEMIDS.$output.result}}`\n\n3) **Availability details by item **:  \n`{{$context.$nodes.CHECKORGLEVELAVAILABILITY.$output}}`\n\n## Task\n- Infer the user’s intent from the **user message** \n- Produce a short, business-friendly summary of:\n  - Items in the order and requested quantities\n  - Stock availability picture for each item (available vs short)\n  - Any notable constraints (e.g., availability split across orgs/locations, partial availability)\n\n## Matching / Logic\n- Match availability by **Item ID** (use the most reliable common key present).\n- For each item:\n  - RequestedQty = from order lines\n  - AvailableQty = from availability (sum across orgs if multiple rows exist, unless the user asked for org-level breakdown)\n  - Status rules:\n    - If AvailableQty >= RequestedQty → **Available**\n    - If 0 < AvailableQty < RequestedQty → **Partially available (Short = Requested - Available)**\n    - If AvailableQty = 0 or no record → **Not available / No availability found**\n\n## Output Requirements\n- Keep it concise (2-3 lines)\n- Use this format:\n\n**Order & Stock Summary**\n- Item <id/name>: Requested <x>, Available <y> → <status>\n- …\n\n**Overall**\n- <#> items fully available, <#> partially available, <#> unavailable\n- Call out the biggest shortages (top 1–3)\n\n## Guardrails\n- Do not invent quantities. If data is missing, say “availability not found in returned data”.\n- If the user’s request cannot be satisfied with given data, ask one clarifying question.\n\n---"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "AutonomousCheck"
          },
          "outcomes": {
            "true": "1775121686784",
            "false": "1771577136636"
          },
          "code": "AUTONOMOUSCHECK",
          "convergenceTargetId": "end",
