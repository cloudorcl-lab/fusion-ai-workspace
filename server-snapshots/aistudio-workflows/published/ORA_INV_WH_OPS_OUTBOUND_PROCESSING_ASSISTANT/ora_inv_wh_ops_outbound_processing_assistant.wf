nCity\",\n    \"InitialDestinationPostalCode\",\n    \"InitialDestinationState\",\n    \"InitialDestinationProvince\",\n    \"InitialDestination\",\n    \"CatalogId\",\n    \"CatalogName\",\n    \"CategoryId\",\n    \"CategoryName\",\n    \"InventoryItemId\",\n    \"ItemNumber\",\n    \"ItemDescription\",\n    \"PickFromSubinventory\",\n    \"PickFromLocatorId\",\n    \"PickFromLocator\",\n    \"StagingSubinventory\",\n    \"StagingLocatorId\",\n    \"StagingLocator\",\n    \"ReleaseSequenceRuleId\",\n    \"ReleaseSequenceRule\",\n    \"PickSlipGroupingRuleId\",\n    \"PickSlipGroupingRule\",\n    \"AutoPickConfirmFlag\",\n    \"TradeComplianceMethod\",\n    \"ShipConfirmRuleId\",\n    \"ShipConfirmRule\",\n    \"ActualShipDate\",\n    \"CreateShipmentsFlag\",\n    \"ShipmentCreationCriteriaCode\",\n    \"ShipmentCreationCriteria\",\n    \"AutomaticallyPackFlag\",\n    \"AppendShipmentsFlag\",\n    \"CreatedBy\",\n    \"CreationDate\",\n    \"PickReleaseFlag\",\n    \"ReleaseMode\",\n    \"ReturnStatus\",\n    \"ReturnMessage\",\n    \"ProjectCostingProjectId\",\n    \"ProjectCostingProjectNumber\",\n    \"ProjectCostingProjectName\",\n    \"ProjectCostingTaskId\",\n    \"ProjectCostingTaskNumber\",\n    \"ProjectCostingTaskName\",\n    \"ResendFlag\",\n    \"SubmitOutboundShipmentRequestFlag\",\n    \"GeographyIdentifierId\",\n    \"ShipmentLinesProcessed\",\n    \"ShipmentLinesSubstituted\",\n    \"ShipmentLinesCanceled\",\n    \"ShipmentLinesBackordered\",\n    \"ShipmentLinesReleased\",\n    \"ShipmentLinesStaged\",\n    \"ShipmentLinesShipped\",\n    \"ShipmentLinesPicks\",\n    \"ShipmentLinesPickSlips\",\n    \"ReleaseLocatorId\",\n    \"ReleaseLocator\",\n    \"AutoShipOnPickConfirmFlag\",\n    \"LoadName\",\n    \"SourceOrderTypeCode\",\n    \"SourceOrderTypeName\",\n    \"ReleaseSubinventoryName\",\n    \"PickFromSubinventoryName\",\n    \"StagingSubinventoryName\",\n    \"SourceName\",\n    \"links\"\n  ]\n}",
