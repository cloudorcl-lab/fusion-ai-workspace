        {
          "metadata": {
            "name": "GenerateQueryForOrderInfo",
            "returnType": "string",
            "sourceCode": "// Build the querystring dynamically\nconst orgId = $context.$variables.OrganizationId;\nconst order = $context.$nodes.EXTRACT_ORDER_NUMBER_FROM_USER_QUERY.$output.OrderNumber;\n\n \nconst qs =\n  \"fields=ShipmentLine,Item,SoldToCustomer,LineStatus,InventoryItemId,RequestedQuantity,RequestedQuantityUOM,LineStatusCode\" +\n  \"&onlyData=true\" +\n  \"&q=OrganizationId=\" + orgId + \" and Order='\" + order + \"'\";\n\nreturn qs;"
          },
          "outcomes": {
            "success": "1771493793285"
          },
          "code": "GENERATEQUERYFORORDERINFO",
          "id": "1773643563032",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "getDistinctItemIds",
            "returnType": "object",
            "sourceCode": "const input = $context.$nodes.GETORDERDETAILS.$output.items;\n\n// Initialize an object to store the aggregated data\nlet aggregatedData = {};\n\n// Loop through each item in the input\ninput.forEach((item) => {\n  const itemName = item.Item;  // Get the item name\n  const requestedQuantity = item.RequestedQuantity;  // Convert RequestedQuantity to integer\n  const itemId = item.InventoryItemId; // Get the ItemId\n  \n  // If the item already exists in aggregatedData, add the requested quantity to it\n  if (aggregatedData[itemName]) {\n    aggregatedData[itemName].TotalRequestedQuantity += requestedQuantity;\n  } else {\n    // Otherwise, create a new entry for the item\n    aggregatedData[itemName] = {\n      TotalRequestedQuantity: requestedQuantity,\n      ItemId: itemId  // Store the ItemId\n    };\n  }\n});\n\n// Format the result as an array of objects\nconst result = Object.keys(aggregatedData).map(itemName => ({\n  Item: itemName,\n  ItemId: aggregatedData[itemName].ItemId,\n  TotalRequestedQuantity: aggregatedData[itemName].TotalRequestedQuantity\n}));\n\n// Output the result\nreturn result;"
          },
          "outcomes": {
            "success": "1773653523012"
          },
          "code": "GETDISTINCTITEMIDS",
          "id": "1773652529597",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
