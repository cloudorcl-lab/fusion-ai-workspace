          "metadata": {
            "name": "Filter Orders for Current Organization",
            "returnType": "array",
            "sourceCode": "const responses = $context.$nodes.GETEACHORDERDETAIL.$output;\nconst orders = $context.$nodes.GETORDERNUMBERSFORCOMMS.$output.result ;\n\nconst result = [];\n\nfor (let i = 0; i < responses.length; i++) {\n  let parsed = responses[i];\n\n  // Parse only if needed\n  if (typeof parsed === 'string') {\n    parsed = JSON.parse(parsed);\n  }\n\n  if (parsed.items && parsed.items.length > 0) {\n    result.push(orders[i].Order);\n  }\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1771781425617"
          },
