            "sourceCode": "let payload = $context.$nodes.INVOKE_ORGANIZATION_CHOOSER_WORKFLOW.$output.output;\n\nif (typeof payload === \"string\") {\n  payload = JSON.parse(payload );\n}\n\n\nreturn payload;"
          },
