            "name": "PrepareQueryForOrderInfo",
            "returnType": "string",
            "sourceCode": "// Build the querystring dynamically\nconst order = $context.$nodes.EXTRACTORDERPARAMS.$output.result.Order;\nconst org = $context.$variables.OrganizationId;\n\nconst qs =\n  \"fields=ShipmentLine,Item,SoldToCustomer,LineStatus,InventoryItemId,LineStatusCode\" +\n  \"&onlyData=true\" +\n  \"&q= Order ='\" + order + \"' AND OrganizationId ='\" + org + \"'\";\n\nreturn qs;"
          },
