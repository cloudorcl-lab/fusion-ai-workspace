            "returnType": "object",
            "sourceCode": "let oraAppContext;\nlet obj;\n\nif ($context.$app && $context.$app.$OraAppContext) {\n  oraAppContext = $context.$app.$OraAppContext;\n} else if (\n  $context.$triggers &&\n  $context.$triggers.REST &&\n  $context.$triggers.REST.$input &&\n  $context.$triggers.REST.$input.OraAppContext\n) {\n  oraAppContext = $context.$triggers.REST.$input.OraAppContext;\n}\n\n// Parse only if it exists\nif (oraAppContext) {\n  try {\n    obj = typeof oraAppContext === \"string\"\n      ? JSON.parse(oraAppContext)\n      : oraAppContext;\n  } catch (e) {\n    obj = null;\n  }\n}\n\nreturn obj;"
          },
          "outcomes": {
