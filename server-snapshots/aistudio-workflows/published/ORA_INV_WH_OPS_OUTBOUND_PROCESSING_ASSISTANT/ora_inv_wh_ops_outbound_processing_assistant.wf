        {
          "metadata": {
            "name": "SummariseDelayedDemand",
            "returnType": "object",
            "sourceCode": "const rawItems = $context?.$nodes?.GETDELAYEDDEMAND?.$output?.items;\nconst items = Array.isArray(rawItems) ? rawItems : [];\n\nconst isBlank = (value) =>\n  value === null || value === undefined || String(value).trim() === \"\";\n\nconst normalize = (value) => (isBlank(value) ? null : String(value).trim());\n\n// Customer counts\nconst customerMap = new Map();\n\nfor (const item of items) {\n  if (!item || typeof item !== \"object\" || Array.isArray(item)) continue;\n\n  const customer = normalize(item.SoldToCustomer);\n  customerMap.set(customer, (customerMap.get(customer) || 0) + 1);\n}\n\nconst customerDelaySummary = Array.from(customerMap.entries())\n  .map(([SoldToCustomer, DelayedOrderCount]) => ({\n    SoldToCustomer,\n    DelayedOrderCount\n  }))\n  .sort((a, b) => {\n    if (b.DelayedOrderCount !== a.DelayedOrderCount) {\n      return b.DelayedOrderCount - a.DelayedOrderCount;\n    }\n    if (a.SoldToCustomer === null && b.SoldToCustomer !== null) return 1;\n    if (a.SoldToCustomer !== null && b.SoldToCustomer === null) return -1;\n    return String(a.SoldToCustomer).localeCompare(String(b.SoldToCustomer));\n  });\n\n// Priority counts\nconst validItems = items.filter((item) => item && typeof item === \"object\" && !Array.isArray(item));\nconst allPrioritiesNull =\n  validItems.length > 0 && validItems.every((item) => isBlank(item.ShippingPriorityCode));\n\nconst priorityMap = new Map();\n\nfor (const item of validItems) {\n  const priority = normalize(item.ShippingPriorityCode);\n  priorityMap.set(priority, (priorityMap.get(priority) || 0) + 1);\n}\n\nconst shippingPrioritySummary = {\n  allPrioritiesNull,\n  priorityCounts: Array.from(priorityMap.entries())\n    .map(([ShippingPriorityCode, DelayedOrderCount]) => ({\n      ShippingPriorityCode,\n      DelayedOrderCount\n    }))\n    .sort((a, b) => {\n      if (b.DelayedOrderCount !== a.DelayedOrderCount) {\n        return b.DelayedOrderCount - a.DelayedOrderCount;\n      }\n      if (a.ShippingPriorityCode === null && b.ShippingPriorityCode !== null) return 1;\n      if (a.ShippingPriorityCode !== null && b.ShippingPriorityCode === null) return -1;\n      return String(a.ShippingPriorityCode).localeCompare(String(b.ShippingPriorityCode));\n    })\n};\n\nreturn {\n  customerDelaySummary,\n  shippingPrioritySummary\n};"
          },
          "outcomes": {
            "success": "1771565561124"
          },
          "code": "SUMMARISEDELAYEDDEMAND",
          "id": "1782966835013",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
