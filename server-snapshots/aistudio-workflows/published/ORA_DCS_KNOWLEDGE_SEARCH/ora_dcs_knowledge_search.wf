{
  "workflowId": "100002355226874",
  "workflowCode": "ORA_DCS_KNOWLEDGE_SEARCH",
  "name": "DCS Knowledge Search",
  "description": "Use knowledge to answer a user's questions.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1768491832911"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "description": "End of data pipeline",
            "name": "End"
          },
          "outcomes": {},
          "code": "END",
          "id": "end",
          "inputs": [],
          "type": "END"
        },
        {
          "metadata": {
            "name": "Rephrase Question"
          },
          "outcomes": {
            "success": "1768403496717"
          },
          "code": "REPHRASE_QUESTION",
          "id": "1768403293302",
          "inputs": [
            {
              "id": "1768403293303_1",
              "name": "prompt",
              "type": "string",
              "value": "### Inputs:\n<userQuestion>{{$context.$system.$inputMessage}}</userQuestion>\n<chatHistory>{{$context.$variables.chatHistory}}</chatHistory>\n\n### Instructions:\n+ Rephrase userQuestion into a question only to ask a knowledge base enhancing the question with additional context from entries prefixed with USER: in chatHistory to create a cohesive question.\n+ Keep the question short.\n+ Do not add any additional information to the question that has not been provided by the user in userQuestion or attributed to USER: in chatHistory.\n+ Do not include details of any previously asked questions.\n+ Do not add context after the question.\n+ Do not add clarifying questions to the question only additional context. \n+ Do not add ticket or service request numbers.\n+ Do not include USER: in the resulting question."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "If Article Found"
          },
          "outcomes": {
            "true": "1768405731959",
            "false": "1768490591998"
          },
          "code": "IF_ARTICLE_FOUND",
          "convergenceTargetId": "end",
          "id": "1768403362549",
          "inputs": [
            {
              "id": "1768403362550_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.SEARCH_KNOWLEDGE.$output.items?.length>0 && $context.$nodes.SEARCH_KNOWLEDGE.$output.items[0].score>$context.$variables.minimumScore}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "dataPipeline": {
              "pipelineNodes": [
                {
                  "metadata": {
                    "name": "Start",
                    "description": "Start of data pipeline"
                  },
                  "outcomes": {
                    "success": "1768403445593"
                  },
                  "id": "start_1768403406761",
                  "code": "START_1768403406761",
                  "type": "START"
                },
                {
                  "metadata": {
                    "name": "End",
                    "description": "End of data pipeline"
                  },
                  "id": "end_1768403406761",
                  "code": "END_1768403406761",
                  "type": "END"
                },
                {
                  "metadata": {
                    "businessObjectCode": "ORA_CX_SERVICECEN_DCSKNOWLEDGESEARCH",
                    "functionName": "getArticle",
                    "processJson": true,
                    "name": "Get Article"
                  },
                  "outcomes": {
                    "success": "end_1768403406761"
                  },
                  "code": "GET_ARTICLE",
                  "id": "1768403445593",
                  "inputs": [
                    {
                      "id": "1768403463152_1",
                      "name": "answerId",
                      "type": "string",
                      "value": "{{$context.$nodes.GET_ARTICLES.$currentItem.answerId}}"
                    }
                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                }
              ],
              "rootNode": "start_1768403406761"
            },
            "loopType": "PARALLEL",
            "name": "Get Articles"
          },
          "outcomes": {
            "success": "1768403564286"
          },
          "code": "GET_ARTICLES",
          "id": "1768403406761",
          "inputs": [
            {
              "id": "1768403406762_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.FILTER_BY_MINIMUM_SCORE.$output.result}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_CX_SERVICECEN_DCSKNOWLEDGESEARCH",
            "functionName": "searchKnowledge",
            "name": "Search Knowledge"
          },
          "outcomes": {
            "success": "1768403362549"
          },
          "code": "SEARCH_KNOWLEDGE",
          "id": "1768403496717",
          "inputs": [
            {
              "id": "1768403510652_1",
              "name": "question",
              "type": "string",
              "value": "{{$context.$nodes.REPHRASE_QUESTION.$output}}"
            },
            {
              "id": "1768403510653_2",
              "name": "stripeCd",
              "type": "string",
              "value": "ORA_SVC_CRM"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Get Content Bodies",
            "returnType": "string",
            "sourceCode": "const answers = $context.$nodes.GET_ARTICLES.$output;\n\nconst index = 0;\nlet result = '';\n\nanswers.forEach((answer, index) => {\n  result += `<contentBody${index}>${JSON.stringify(JSON.parse(answer).contentBody)}</contentBody${index}>`;\n});\n\nreturn result;"
          },
          "outcomes": {
            "success": "1768405083550"
          },
          "code": "GET_CONTENT_BODIES",
          "id": "1768403564286",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Generate Answer"
          },
          "outcomes": {
            "success": "1768405484734"
          },
          "code": "GENERATE_ANSWER",
          "id": "1768403646420",
          "inputs": [
            {
              "id": "1768403646421_1",
              "name": "prompt",
              "type": "string",
              "value": "### Input\n<userQuestion>{{$context.$nodes.REPHRASE_QUESTION.$output}}</userQuestion>\n<chatHistory>{{$context.$variables.chatHistory}}</chatHistory>\n{{$context.$nodes.GET_CONTENT_BODIES.$output.result}}\n\n### Instructions\n+ Format you response using HTML.\n+ Start by providing a paragraph with a single declarative sentence fragment that rephrases userQuestion to introduce the answer. The goal is to create a \"lead-in\" phrase.\n+ Using only the information contained in the contentBody values give a concise answer or list of steps to the user to answer userQuestion. If content contains unrelated information or steps the user states they have already tried in chatHistory or userQuestion do not include them.\n+ Ensure consistent formatting in the generated response, e.g. single empty lines between sections.\n+ Do not suggest answers that have already been given in chatHistory.\n+ Do not use headers in the generated HTML.\n+ Do not say from the provided content or similar."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Get Citations",
            "returnType": "string",
            "sourceCode": "return $context.$nodes.FILTER_BY_MINIMUM_SCORE.$output.result.map(item => item.documentId).join(', ');"
          },
          "outcomes": {
            "success": "1768403646420"
          },
          "code": "GET_CITATIONS",
          "id": "1768405083550",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Return Answer"
          },
          "outcomes": {},
          "code": "RETURN_ANSWER",
          "convergenceTargetId": "end",
          "id": "1768405484734",
          "inputs": [
            {
              "id": "1768405484737_1",
              "name": "returnValue",
              "type": "string",
              "value": "{{$context.$nodes.GENERATE_ANSWER.$output}}\n<br>\nAI Generated From: {{$context.$nodes.GET_CITATIONS.$output.result}}"
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "name": "Set Minimum Score"
          },
          "outcomes": {
            "success": "1768403293302"
          },
          "code": "SET_MINIMUM_SCORE",
          "id": "1768405661544",
          "inputs": [
            {
              "id": "1768405695673",
              "name": "minimumScore",
              "scope": "JOB",
              "type": "number",
              "value": "20"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Filter By Minimum Score",
            "returnType": "array",
            "sourceCode": "return $context.$nodes.SEARCH_KNOWLEDGE.$output.items.filter(item => item.score > $context.$variables.minimumScore);"
          },
          "outcomes": {
            "success": "1768403406761"
          },
          "code": "FILTER_BY_MINIMUM_SCORE",
          "id": "1768405731959",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "If True"
          },
          "outcomes": {
