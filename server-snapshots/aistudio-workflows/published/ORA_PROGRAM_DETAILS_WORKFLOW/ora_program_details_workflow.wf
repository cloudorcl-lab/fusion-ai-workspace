          "metadata": {
            "name": "Retrieve Program Id from Context",
            "returnType": "string",
            "sourceCode": "let appInput = $context.$triggers.REST.$input?.OraAppContext;\n\nif (!appInput || !appInput.includes(\"programId=\")) {\n  appInput = \"programId=300100667189576\";\n}\n\nconst pairs = appInput.split(',');\n\nconst data = pairs.reduce((acc, pair) => {\n  const [key, value] = pair.split('=');\n  if (key && value) {\n    acc[key.trim()] = value.trim();\n  }\n  return acc;\n}, {});\n\nif (data.programId) {\n  return data.programId;\n}\n\nreturn \"\";"
          },
          "outcomes": {
            "success": "1765682374150"
          },
          "code": "RETRIEVE_PROGRAM_ID_FROM_CONTEXT",
          "id": "1765682331981",
          "inputs": [],
