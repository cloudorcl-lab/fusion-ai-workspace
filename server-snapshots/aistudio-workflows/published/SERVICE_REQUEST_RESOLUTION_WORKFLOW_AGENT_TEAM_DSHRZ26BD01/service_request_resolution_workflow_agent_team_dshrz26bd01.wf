{
  "workflowId": "300000328938520",
  "workflowCode": "SERVICE_REQUEST_RESOLUTION_WORKFLOW_AGENT_TEAM_DSHRZ26BD01",
  "name": "Service Request Resolution Workflow Advisor DSHRZ26BD01",
  "description": "Service Request Resolution Workflow is responsible for triggering classification agent and resolution agent.\n** Updated April 14, 2026 (26BD01)",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
