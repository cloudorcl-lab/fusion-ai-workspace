        {
          "metadata": {
            "name": "Return Approved Resolution"
          },
          "outcomes": {},
          "code": "RETURN_APPROVED_RESOLUTION",
          "convergenceTargetId": "end",
          "id": "1765749156755",
          "inputs": [
            {
              "id": "1765749156757_1",
              "name": "returnValue",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_APPROVED_RESOLUTION.$output.result}}"
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "name": "Decode Input Flow"
          },
          "outcomes": {
            "success": "1765749116105"
          },
          "code": "DECIDEINTENTUSINGINPUT",
          "convergenceTargetId": "1765749103456",
          "id": "1765238460260",
          "inputs": [
            {
              "id": "1765238460262_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an intent-classification agent. Your task is to determine whether the customer has *clearly accepted, approved, agreed with, or is satisfied* with the provided resolution.\n\n### Rules:\n- Return **\"true\"** only if the input message clearly expresses acceptance/approval (e.g., “yes that works”, “issue resolved”, “I agree”, “approved”, “happy with the solution”).\n- Return **\"false\"** for all other cases.\n- Return **\"false\"** if the input message is missing, empty, or does not indicate clear acceptance.\n- Do **not** output anything except **\"true\"** or **\"false\"**.\n\n### User Input:\n{{$context.$system.$inputMessage}}"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Extract Approved Resolution",
            "returnType": "string",
            "sourceCode": "let chatHistory = $context.$system.$chatHistory;\nlet finalResolution = null;\n\nif (chatHistory) {\n  try {\n    const aiMatches = [...chatHistory.matchAll(/AI:\\s*(\\{.*?\\})(?=(\\nUSER:|$))/gs)];\n\n    if (aiMatches && aiMatches[aiMatches.length - 1][1]) {\n      const parsed = JSON.parse(aiMatches[aiMatches.length - 1][1]);\n\n      finalResolution =\n        parsed?.result?.output?.Summary ||\n        parsed?.result?.output?.shortSummary ||\n        null;\n    }\n  } catch (e) {\n    finalResolution = null;\n  }\n}\n\nreturn finalResolution;"
          },
          "outcomes": {
            "success": "1765749156755"
          },
          "code": "EXTRACT_APPROVED_RESOLUTION",
          "convergenceTargetId": "1765749156755",
          "id": "1765315438109",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
