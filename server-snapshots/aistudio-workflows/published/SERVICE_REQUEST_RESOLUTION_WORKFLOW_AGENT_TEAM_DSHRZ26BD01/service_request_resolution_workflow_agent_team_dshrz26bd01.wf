        {
          "metadata": {
            "name": "Initialize Variable",
            "returnType": "object",
            "sourceCode": "let iteration = 0;\nlet lastStatus = \"\";\n\nlet text = $context.$system.$chatHistory;\n\nif (text) {\n\n  const iterationMatches = [...text.matchAll(/\"?iteration\"?:\\s*(\\d+)/g)];\n  const statusMatches = [...text.matchAll(/\"?status\"?:\\s*\\\\?\"([^\"\\\\]+)\\\\?\"/g)];\n\n  if (iterationMatches.length > 0) {\n    iteration = Number(iterationMatches.at(-1)[1]);\n    iteration++;\n  }\n\n  if (statusMatches.length > 0) {\n    lastStatus = statusMatches.at(-1)[1];\n  }\n}\n\nvar output = {\n  iteration,\n  lastStatus\n};\n\nreturn output;"
          },
          "outcomes": {
            "success": "1765849428148"
          },
          "code": "INITIALIZE_VARIABLE",
          "convergenceTargetId": "1765238460260",
          "id": "1765249736480",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "If Need Decode Input"
          },
          "outcomes": {
            "true": "1765238460260",
            "false": "add_false_1765749061503"
          },
          "code": "IF_NEED_DECODE_INPUT",
          "convergenceTargetId": "end",
          "id": "1765749061503",
