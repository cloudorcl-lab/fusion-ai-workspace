            "sourceCode": "const result = {};\n\nconst categoryItem = $context?.$nodes?.FETCH_CATEGORY?.$output?.items?.[0];\nif (categoryItem?.CategoryId != null) {\n  result.CategoryId = categoryItem.CategoryId;\n}\n\nconst productItem = $context?.$nodes?.FETCH_PRODUCT?.$output?.items?.[0];\nif (productItem?.ProductGroupId != null) {\n  result.ProdGroupId = productItem.ProductGroupId;\n}\n\nreturn result;"
