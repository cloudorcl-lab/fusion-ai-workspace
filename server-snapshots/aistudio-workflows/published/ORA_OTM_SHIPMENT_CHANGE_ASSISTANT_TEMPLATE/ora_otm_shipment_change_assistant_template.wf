                {
                  "metadata": {
                    "name": "Collect ShipmentGid for Each Shipment"
                  },
                  "outcomes": {
                    "success": "1775161677473"
                  },
                  "code": "COLLECT_SHIPMENTGID_FOR_EACH_SHIPMENT",
                  "id": "1774360121500",
                  "inputs": [
                    {
                      "id": "1774360121503_1",
                      "name": "prompt",
                      "type": "string",
                      "value": "You are given a JSON object as input.\n\nExtract these fields from the input:\n- count\n- domainName\n- shipmentXid\n\nBuild shipmentGid using these rules:\n- If domainName is exactly \"PUBLIC\", shipmentGid = shipmentXid\n- Otherwise, shipmentGid = domainName + \".\" + shipmentXid\n\nReturn only the following JSON object:\n{\n  \"count\": <count>,\n  \"shipment\": [\"<shipmentGid>\"]\n}\n\nRules:\n- shipment must always be a string array with exactly one element\n- Do not include any extra fields\n- Do not wrap the output in markdown or code fences\n- Return valid JSON only\n\nInput:\n{{$context.$nodes.FOR_INPUT_SHIPMENT.CHECK_EACH_SHIPMENT.$output}}"
                    }
                  ],
                  "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"shipment\": {\n            \"type\": \"array\",\n            \"items\": {\n                \"type\": \"object\",\n                \"properties\": {}\n            }\n        },\n        \"count\": {\n            \"type\": \"number\"\n        }\n    }\n}",
                  "type": "LLM"
                },
                {
                  "metadata": {
                    "name": "Shipment Found in For Loop"
                  },
                  "outcomes": {
                    "true": "1775161845456",
                    "false": "1775162497199"
                  },
                  "code": "SHIPMENT_FOUND_IN_FOR_LOOP",
                  "convergenceTargetId": "end_1774359179386",
                  "id": "1775161677473",
                  "inputs": [
                    {
                      "id": "1775161677474_1",
                      "name": "condition",
                      "type": "string",
                      "value": "{{$context.$nodes.FOR_INPUT_SHIPMENT.COLLECT_SHIPMENTGID_FOR_EACH_SHIPMENT.$output.count !== 0}}"
                    }
                  ],
                  "type": "CONDITION"
                },
                {
                  "metadata": {
                    "name": "Add Valid Shipment",
                    "returnType": "array",
                    "sourceCode": "var val = $context.$variables.validShipmentArr \nvar shipment = $context.$nodes.FOR_INPUT_SHIPMENT.COLLECT_SHIPMENTGID_FOR_EACH_SHIPMENT.$output.shipment[0] \nvar arr\n\n//preprocessing\n//val that is extracted from context variable is not necessarily an array\n//when only one item in array, the array will be treated as number\nif (Array.isArray(val) && val.length > 0) {\n  // non-empty array\n  arr = val\n} else if (typeof val === \"string\" && val.trim().length > 0) {\n  // non-empty string\n  arr = [val]\n} else if (typeof val === \"number\") {\n  // valid number (not NaN, Infinity, -Infinity)\n  arr = [String(val)]\n} else {\n  // null/undefined/empty array/empty string/not a finite number/other types\n  arr = []\n}\n\nif (!arr.includes(shipment)) {\n  arr.push(shipment)\n}\n\nreturn arr"
                  },
                  "outcomes": {
                    "success": "1775162604276"
                  },
                  "code": "ADD_VALID_SHIPMENT",
                  "id": "1775161845456",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
