                {
                  "metadata": {
                    "name": "Add Into CollabIdArr",
                    "returnType": "array",
                    "sourceCode": "var val = $context.$variables.collabIdArr\nvar collabId = $context.$nodes.FOR_VALID_SHIPMENT.FIND_MAX_COLLAB_ID.$output.collabId \nvar arr\n\n//preprocessing\n//val that is extracted from context variable is not necessarily an array\n//when only one item in array, the array will be treated as number\nif (Array.isArray(val) && val.length > 0) {\n  // non-empty array\n  arr = val\n} else if (typeof val === \"string\" && val.trim().length > 0) {\n  // non-empty string\n  arr = [val]\n} else if (typeof val === \"number\") {\n  // valid number (not NaN, Infinity, -Infinity)\n  arr = [String(val)]\n} else {\n  // null/undefined/empty array/empty string/not a finite number/other types\n  arr = []\n}\n\nif (!arr.includes(collabId)) {\n  arr.push(collabId)\n}\n\nreturn arr"
                  },
                  "outcomes": {
                    "success": "1775220517859"
                  },
                  "code": "ADD_INTO_COLLABIDARR",
                  "id": "1775163255016",
                  "inputs": [],
