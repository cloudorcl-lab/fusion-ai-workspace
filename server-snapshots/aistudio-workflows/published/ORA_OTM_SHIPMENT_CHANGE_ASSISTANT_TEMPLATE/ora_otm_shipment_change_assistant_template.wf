        {
          "metadata": {
            "name": "Handle Error for Change Serv Prov",
            "returnType": "string",
            "sourceCode": "function formatResponse(response) {\n  //Response from BO may not be json\n  if (typeof response === 'string' && response.includes('\"status\":500')) {\n    return \"SECURE RESOURCES status cannot be any of the following: SECURE RESOURCES_TENDERED, SECURE RESOURCES_PICKUP NOTIFICATION, SECURE RESOURCES_BOOKED, SECURE RESOURCES_ACCEPTED. Shipment may need to have its tender withdrawn before the service provider can be changed.\";\n  }\n\n  // Safely parse the response if it's a JSON string\n  try {\n    response = typeof response === 'string' ? JSON.parse(response) : response;\n  } catch (e) {\n    return response;\n  }\n\n  // Handle 500 error first\n  if (response && response.status === 500) {\n    return \"SECURE RESOURCES status cannot be any of the following: SECURE RESOURCES_TENDERED, SECURE RESOURCES_PICKUP NOTIFICATION, SECURE RESOURCES_BOOKED, SECURE RESOURCES_ACCEPTED. Shipment may need to have its tender withdrawn before the service provider can be changed.\";\n  }\n\n  // Initialize an empty result string\n  let result = \"\";\n\n  // Check if 'o:errorDetails' exists and is an array\n  if (response[\"o:errorDetails\"] && Array.isArray(response[\"o:errorDetails\"])) {\n    // Look for o:errorPath in the details, if present\n    let errorPathFound = false;\n    response[\"o:errorDetails\"].forEach(detail => {\n      // Check if o:errorPath exists directly in the detail object\n      if (detail[\"o:errorPath\"]) {\n        result += `${detail[\"o:errorPath\"]}\\n`;  // Show o:errorPath if it exists\n        errorPathFound = true;  // Mark that we found an errorPath\n      }\n    });\n\n    // If no o:errorPath was found, fallback to showing the 'detail'\n    if (!errorPathFound) {\n      result += `${response.detail}\\n`;\n    }\n  } else {\n    // If no o:errorDetails exists, just show the 'detail'\n    result += `${response.detail}\\n`;\n  }\n\n  return result;\n}\n\n// Check if error info exists\nif ($context.$nodes.CHANGE_SERVICE_PROVIDER.$error) {\n  return formatResponse($context.$nodes.CHANGE_SERVICE_PROVIDER.$error.$info)\n}\nelse\n  return \"An error occurred while changing the service provider. Please try again later or contact support if the issue persists.\""
          },
          "outcomes": {
            "success": "1774990938278"
          },
          "code": "HANDLE_ERROR_FOR_CHANGE_SERV_PROV",
          "id": "1774990865779",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
