        {
          "metadata": {
            "name": "Build BS Exception Extract",
            "returnType": "object",
            "sourceCode": "var filterClause = $context.$variables.BankStmtObj.filterClause;\n\nvar queryFilter = {\n  \"viewQueries\": {\n    \"inboundFiles\": {\n      \"module\": \"oraErpCoreBankStatements\",\n      \"businessObject\": \"BankStatementFile\",\n      \"view\": \"bankStatementFileDetail\",\n      \"fieldAliases\": {\n        \"id\": \"inboundFileId\",\n        \"fileName\": \"fileName\",\n        \"timeCreated\": \"timeCreated\",\n        \"documentFileTransferStatus\": \"documentFileTransferStatus\",\n        \"processingSummary\": \"summary\",\n        \"paymentProcessFormat.paymentFormatCode\": \"bankStatementFormatCode\",\n        \"paymentProcessFormat.formatName\": \"bankStatementFormatName\",\n        \"inboundFileProcessingStatus.lookupCode\": \"inboundFileProcessingStatusCode\"\n      }\n    },\n    \"statementHeaders\": {\n      \"module\": \"oraErpCoreBankStatements\",\n      \"businessObject\": \"BankAccountStatement\",\n      \"view\": \"bankAccountStatementsExtract\",\n      \"fieldAliases\": {\n        \"id\": \"statementHeaderId\",\n        \"bankAccount.bank.name\": \"bankName\",\n        \"inboundFile.id\": \"inboundFileId\"\n      }\n    },\n    \"receiptBatch\": {\n      \"module\": \"oraErpCoreReceivablesPayments\",\n      \"businessObject\": \"ReceivablesManualReceiptBatch\",\n      \"view\": \"receivablesManualReceiptBatchesExtract\",\n      \"fieldAliases\": {\n        \"batchId\": \"batchId\",\n        \"name\": \"receiptBatchStatementHeaderId\",\n        \"actualCount\": \"actualCount\"\n      }\n    }\n  },\n  \"namedSelects\": [\n    {\n      \"name\": \"receiptBatchByStatementHeader\",\n      \"select\": \"select receiptBatchStatementHeaderId, min(batchId) as batchId from receiptBatch where nvl(actualCount, 0) <> 0 group by receiptBatchStatementHeaderId\"\n    },\n    {\n      \"name\": \"statementHeaderFileDetails\",\n      \"select\": \"select s.inboundFileId as inboundFileId, min(b.batchId) as batchId, listagg(distinct s.bankName, ', ') within group (order by s.bankName) as bankName from statementHeaders s left outer join receiptBatchByStatementHeader b on b.receiptBatchStatementHeaderId = to_char(s.statementHeaderId) group by s.inboundFileId\"\n    },\n    {\n      \"name\": \"erroredBankStatementFiles\",\n      \"select\": \"select f.fileName, nvl(f.bankStatementFormatName, f.bankStatementFormatCode) as bankStatementFormat, f.bankStatementFormatCode, f.inboundFileProcessingStatusCode, f.documentFileTransferStatus, f.timeCreated, f.summary, h.batchId as batchId, h.bankName as bankName from inboundFiles f left outer join statementHeaderFileDetails h on h.inboundFileId = f.inboundFileId\"\n    }\n  ],\n  \"select\": \"select json_object( 'label' value documentFileTransferStatus, 'status' value 'warning' ) as status, 'Bank Statement' as type, json_object( 'label' value fileName, 'href' value '/fscmUI/faces/oracle/apps/financials/receivables/receipts/desktopReceiptRemittance/di/excel/ViewandEditReceiptCreationErrors.xlsx?batchId=' || batchId || '&podName={@faPodName}' ) as documentName, bankStatementFormat as format, summary, bankName as sender, timeCreated as processed from erroredBankStatementFiles where 1=1 \" + filterClause + \"\"\n};\n\n// and documentFileTransferStatus in ('Ingestion Error', 'Import Error', 'Receipt Creation Exception') and fileName='TestFile.ISO.CAMT52.xml'\n\n\n\nreturn queryFilter;"
          },
          "outcomes": {
            "success": "1779712127189"
          },
