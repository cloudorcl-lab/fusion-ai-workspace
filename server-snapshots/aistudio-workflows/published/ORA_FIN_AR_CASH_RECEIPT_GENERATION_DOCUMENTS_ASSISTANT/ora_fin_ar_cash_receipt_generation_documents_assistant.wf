{
  "workflowId": "300000331058197",
  "workflowCode": "ORA_FIN_AR_CASH_RECEIPT_GENERATION_DOCUMENTS_ASSISTANT",
  "name": "Cash Receipt Generation Documents Assistant",
  "description": "The assistant is a document-processing sub-agent within the Cash Receipts Generation workflow that reviews and summarizes receipt-processing documents such as bank statements, lockbox files, and remittance advices. It extracts key payment details, identifies matching references, highlights discrepancies, and provides processing insights to support accurate cash receipt creation and application.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
