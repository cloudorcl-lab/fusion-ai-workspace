        {
          "metadata": {
            "name": "Response Parser",
            "returnType": "object",
            "sourceCode": "var response = $context.$variables.compiledFileData;\n\nfunction buildCounts({\n  filterArray,\n\n  remittanceAdviceSuccessfulData,\n  remittanceAdviceExceptionsData,\n\n  lockboxSuccessfulData,\n  lockboxExceptionsData,\n\n  bankStatementSuccessfulData,\n  bankStatementExceptionsData\n}) {\n  const counts = {\n    \"Remittance Advice\": {\n      intentException: \"\",\n      errors: null,\n      warnings: null,\n      successful: null\n    },\n    \"Lockbox\": {\n      intentException: \"\",\n      errors: null,\n      successful: null\n    },\n    \"Bank Statement\": {\n      intentException: \"\",\n      errors: null,\n      successful: null\n    }\n  };\n\n  const dataMap = {\n    \"Remittance Advice\": {\n      successfulData: remittanceAdviceSuccessfulData,\n      exceptionsData: remittanceAdviceExceptionsData,\n    },\n    \"Lockbox\": {\n      successfulData: lockboxSuccessfulData,\n      exceptionsData: lockboxExceptionsData\n    },\n    \"Bank Statement\": {\n      successfulData: bankStatementSuccessfulData,\n      exceptionsData: bankStatementExceptionsData\n    }\n  };\n\n  filterArray.forEach((filter) => {\n    const sourceType = filter.sourceType;\n\n    if (!counts[sourceType]) {\n      return;\n    }\n\n    counts[sourceType].intentException = filter.exception;\n\n    // Set counts only when exception is not empty.\n    // If exception is \"\", errors and successful remain null.\n    if (filter.exception === \"n\" || filter.exception === \"both\") {\n\t  counts[sourceType].successful = dataMap[sourceType].successfulData.length;\n\t}\n\n\tif (filter.exception === \"y\" || filter.exception === \"both\") {\n\t\tif(sourceType === \"Remittance Advice\"){\n\t\t\tconst warningCount = $context.$nodes.FETCH_REMITTANCE_ADVICES_WITH_EXCEPTIONS.$output ? $context.$nodes.FETCH_REMITTANCE_ADVICES_WITH_EXCEPTIONS.$output.length : 0;\n\n\t\t\tif (warningCount > 0) {\n\t\t\t  counts[sourceType].warning = warningCount;\n\t\t\t  counts[sourceType].errors =\n\t\t\t    dataMap[sourceType].exceptionsData.length - warningCount;\n\t\t\t} else {\n\t\t\t  counts[sourceType].errors = dataMap[sourceType].exceptionsData.length;\n\t\t\t}\n\t\t}\n\t  \telse{\n\t  \t\tcounts[sourceType].errors = dataMap[sourceType].exceptionsData.length;\n\t  \t}\n\t}\n  });\n\n  return counts;\n}\n\nvar deepLink = \"n\";\nfunction getExceptionType(filterArray) {\n  const hasRemittanceAdvice = filterArray.some(\n    (item) => item.sourceType === \"Remittance Advice\"\n  );\n\n  const hasLockbox = filterArray.some(\n    (item) => item.sourceType === \"Lockbox\"\n  );\n\n  const hasBankStatement = filterArray.some(\n    (item) => item.sourceType === \"Bank Statement\"\n  );\n\n  const hasBankFile = hasLockbox || hasBankStatement;\n\n  if (hasRemittanceAdvice && hasBankFile) {\n    deepLink = \"y\";\n    return \"Customer Payment File Exceptions\";\n  }\n\n  if (hasRemittanceAdvice) {\n    deepLink = \"y\";\n    return \"Remittance Advice Exceptions\";\n  }\n\n  if (hasLockbox && hasBankStatement) {\n    return \"Bank File Exceptions\";\n  }\n\n  if (hasLockbox) {\n    return \"Lockbox File Exceptions\";\n  }\n\n  if (hasBankStatement) {\n    return \"Bank Statement File Exceptions\";\n  }\n\n  return \"\";\n}\n\nconst filterArray = $context.$variables.UserIntent;\n\nconst summary = buildCounts({\n  filterArray,\n  remittanceAdviceSuccessfulData: $context.$variables.remittanceAdviceSuccessfulData,\n  remittanceAdviceExceptionsData: $context.$variables.remittanceAdviceExceptionsData,\n  remittanceAdviceWarningData: $context.$nodes.FETCH_REMITTANCE_ADVICES_WITH_EXCEPTIONS.$output,\n  lockboxSuccessfulData: $context.$variables.lockboxSuccessfulData,\n  lockboxExceptionsData: $context.$variables.lockboxExceptionsData,\n  bankStatementSuccessfulData: $context.$variables.bankStatementSuccessfulData ,\n  bankStatementExceptionsData: $context.$variables.bankStatementExceptionsData \n});\n\nreturn {\n  title: getExceptionType(filterArray),\n  summary: summary,\n  response: response,\n  deepLink: deepLink\n};"
          },
          "outcomes": {
            "success": "1779194249421"
          },
