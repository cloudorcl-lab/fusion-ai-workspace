          "metadata": {
            "name": "Build Remittance Advice Extract Payload",
            "returnType": "object",
            "sourceCode": "const filterClause = $context.$variables.RemittanceAdviceObj.filterClause;\n\nvar queryString = {\n  \"viewQueries\": {\n    \"receivablesRemittanceAdvice\": {\n      \"module\": \"oraErpCoreReceivablesPayments\",\n      \"businessObject\": \"ReceivablesRemittanceAdvice\",\n      \"view\": \"receivablesRemittanceAdviceDetail\",\n      \"fieldAliases\": {\n        \"remittanceAdviceId\": \"remittanceAdviceId\",\n        \"statusCode\": \"statusCode\",\n        \"documentReference\": \"documentReference\",\n        \"timeCreated\": \"timeCreated\"\n      }\n    }\n  },\n  \"select\": \"select remittanceAdviceId, documentReference from receivablesRemittanceAdvice where (statusCode='ERROR' or statusCode='WARNING' or statusCode='UNMATCHED') and documentReference is not null \"\n};\n\nreturn queryString;"
          },
          "outcomes": {
            "success": "1779115843817"
          },
          "code": "BUILD_REMITTANCE_ADVICE_EXTRACT_PAYLOAD",
          "id": "1779115779654",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_FINANCIALC_WORKFLOWEXTRACT",
            "functionName": "extract",
            "name": "Fetch Remittance Advices with Exceptions"
