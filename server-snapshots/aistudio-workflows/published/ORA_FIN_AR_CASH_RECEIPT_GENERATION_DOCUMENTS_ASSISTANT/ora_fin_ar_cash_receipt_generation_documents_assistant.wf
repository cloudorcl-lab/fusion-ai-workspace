            "returnType": "object",
            "sourceCode": "var filterClause = $context.$variables.LockboxObj.filterClause;\n\nvar queryFilter = {\n    \"viewQueries\": {\n        \"receivablesLockboxTransmission\": {\n            \"module\": \"oraErpCoreReceivablesPayments\",\n            \"businessObject\": \"ReceivablesLockboxTransmission\",\n            \"view\": \"receivablesLockboxTransmissionsExtract\",\n            \"fieldAliases\": {\n                \"transmissionName\": \"transmissionName\",\n                \"controlCount\": \"controlCount\",\n                \"validatedCount\": \"validatedCount\",\n                \"documentName\": \"documentName\",\n                \"documentFormat\": \"format\",\n                \"processingSummary\": \"summary\",\n                \"timeCreated\": \"timeCreated\"\n            }\n        }\n    },\n    \"select\": \"select json_object( 'label' value 'Complete', 'status' value 'success' ) as status, 'Lockbox' as type, json_object( 'label' value transmissionName, 'href' value '') as documentName, format, validatedCount || ' Receipts Created' as summary, timeCreated as Processed from receivablesLockboxTransmission where controlCount is not null and validatedCount is not null and (controlCount - validatedCount) = 0 \" + filterClause + \"\"\n};\n\nreturn queryFilter;"
