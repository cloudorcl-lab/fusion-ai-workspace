        {
          "metadata": {
            "name": "Merge File Data",
            "returnType": "array",
            "sourceCode": "const a = Array.isArray($context.$variables.compiledRemittanceAdviceData)\n  ? $context.$variables.compiledRemittanceAdviceData\n  : [];\n\nconst b = Array.isArray( $context.$variables.compiledLockboxData )\n  ? $context.$variables.compiledLockboxData\n  : [];\n\nconst c = Array.isArray( $context.$variables.compiledBankStatementData )\n  ? $context.$variables.compiledBankStatementData\n  : [];\n\nreturn a.concat(b, c);"
          },
