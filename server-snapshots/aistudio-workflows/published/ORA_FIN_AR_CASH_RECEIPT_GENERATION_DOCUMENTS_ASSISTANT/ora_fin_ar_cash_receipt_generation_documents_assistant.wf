        {
          "metadata": {
            "name": "Build DocIO query filter",
            "returnType": "object",
            "sourceCode": "let result = {};\n\ntry {\n  const processFileInquiry = $context.$variables.RemittanceAdviceObj || {};\n\n  function escapeFilterString(value) {\n    return String(value).replace(/'/g, \"''\");\n  }\n\n  // Function to replace sysdate - N with actual ISO date string\n  function replaceSysdateWithActualDate(input) {\n    return input.replace(/sysdate\\s*-\\s*(\\d+)/gi, (_, days) => {\n      const date = new Date();\n      date.setDate(date.getDate() - Number(days));\n\n      // Format as ISO string without milliseconds\n      const formattedDate = date.toISOString().slice(0, 19) + \"Z\";\n      return `'${formattedDate}'`;\n    });\n  }\n\n  let filterClause = \"\";\n\n  if (\n    processFileInquiry.filterClause &&\n    processFileInquiry.filterClause.trim() !== \"\"\n  ) {\n    filterClause = replaceSysdateWithActualDate(processFileInquiry.filterClause);\n  }\n\n  // Fetch response from FETCH_INGESTED_REMITTANCE_ADVICES output\n  const response =\n    $context.$nodes.FETCH_INGESTED_REMITTANCE_ADVICES.$output || {};\n\n  function getDocumentReferences(response) {\n    return (\n      response?.items\n        ?.map(item => item?.DOCUMENTREFERENCE)\n        .filter(ref => ref !== null && ref !== undefined && ref !== \"\") || []\n    );\n  }\n\n  function buildPreparedDocumentsFilter(documentReferences) {\n    if (documentReferences.length === 0) {\n      return \"\";\n    }\n\n    const joinedRefs = documentReferences\n      .map(ref =>\n        typeof ref === \"string\" ? `'${escapeFilterString(ref)}'` : ref\n      )\n      .join(\",\");\n\n    return `logicalDocumentIdentifier in (${joinedRefs})`;\n  }\n\n  const documentReferences = getDocumentReferences(response);\n  const preparedDocumentsFilter =\n    buildPreparedDocumentsFilter(documentReferences);\n\n  let incomingDocsFilter =\n    \"trainingMode='N' and stream.flow.flowCode='FIN_AR_CREATE_REMITTANCE_ADVICES'\";\n\n  if (preparedDocumentsFilter) {\n    incomingDocsFilter += ` and (preparedDocuments[${preparedDocumentsFilter}])`;\n  }\n\n  const transformedDocsFilter =\n  `${preparedDocumentsFilter} ${filterClause}`.trim();\n\n  result = {\n    incomingDocsFilter,\n    transformedDocsFilter\n  };\n} catch (error) {\n  result = {\n    incomingDocsFilter: \"\",\n    transformedDocsFilter: \"\"\n  };\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1779135424907"
          },
          "code": "BUILD_DOCIO_QUERY_FILTER",
