        {
          "metadata": {
            "name": "Transform Remittance Advice Data",
            "returnType": "array",
            "sourceCode": "const inputJsonObject =\n  $context.$nodes.FETCH_DOCIO_REMITTANCE_ADVICE_DATA.$output || {};\n\nfunction safeStringValue(value, defaultValue = \"\") {\n  return value === null || value === undefined ? defaultValue : value;\n}\n\nfunction getErrorSummary(transactionStatistics) {\n  const value = String(transactionStatistics ?? \"\").trim();\n\n  if (!value) {\n    return \"File Processing Failed\";\n  }\n\n  const errorCount = value.split(\",\").length;\n  return `${errorCount} Error(s)`;\n}\n\nconst remitAdvErrors =\n  $context.$nodes.FETCH_REMITTANCE_ADVICES_WITH_EXCEPTIONS.$output || [];\n\nconst documentReferences =\n  remitAdvErrors\n    .map(item => item?.DOCUMENTREFERENCE)\n    .filter(ref => ref !== null && ref !== undefined)\n    .map(ref => String(ref).trim());\n\nfunction getStatus(logicalDocumentIdentifier) {\n  const logicalDocumentIdentifierValue =\n    String(logicalDocumentIdentifier ?? \"\").trim();\n\n  if (documentReferences.includes(logicalDocumentIdentifierValue)) {\n    return {\n      label: \"Warning\",\n      status: \"warningSubtle\"\n    };\n  }\n\n  return {\n    label: \"File Processing Failed\",\n    status: \"dangerSubtle\"\n  };\n}\n\nfunction convertInputJsonObjectToFileStatusArray(inputObject) {\n  const sourceFileArray = Array.isArray(inputObject?.items)\n    ? inputObject.items\n    : [];\n\n  return sourceFileArray.flatMap((sourceFileObject) => {\n    const preparedDocumentArray = Array.isArray(\n      sourceFileObject?.preparedDocuments?.items\n    )\n      ? sourceFileObject.preparedDocuments.items\n      : [];\n\n    return preparedDocumentArray.map((preparedDocumentObject) => {\n      return {\n        status: getStatus(preparedDocumentObject?.logicalDocumentIdentifier),\n        documentName: {\n          label: safeStringValue(preparedDocumentObject?.logicalDocumentName),\n          href: \"\"\n        },\n        format: safeStringValue(\n          preparedDocumentObject?.logicalDocumentFormat\n        ).toUpperCase(),\n        summary: getErrorSummary(\n          preparedDocumentObject?.transactionStatistics\n        ),\n        sender: safeStringValue(sourceFileObject?.stream?.submitter),\n        processed: safeStringValue(sourceFileObject?.stream?.startTime)\n      };\n    });\n  });\n}\n\nconst fileStatusArray = convertInputJsonObjectToFileStatusArray(inputJsonObject);\n\nreturn fileStatusArray;"
          },
          "outcomes": {
            "success": "1779116190718"
          },
