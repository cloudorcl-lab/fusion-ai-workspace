          },
          "code": "FETCH_REMITTANCE_ADVICES_WITH_EXCEPTIONS",
          "id": "1779115843817",
          "inputs": [
            {
              "id": "1779115866786_1",
              "name": "query",
              "type": "string",
              "value": "{{$context.$nodes.BUILD_REMITTANCE_ADVICE_EXTRACT_PAYLOAD.$output.result}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Build Query Filter",
            "returnType": "object",
            "sourceCode": "let result = {};\n\ntry {\n  const processFileInquiry = $context.$variables.RemittanceAdviceObj || {};\n\n  const remittanceAdviceReferenceArray =\n    $context.$nodes.FETCH_REMITTANCE_ADVICES_WITH_EXCEPTIONS.$output || [];\n\n  function escapeFilterString(value) {\n    return String(value).replace(/'/g, \"''\");\n  }\n\n  // Function to replace sysdate - N with actual ISO date string\n  function replaceSysdateWithActualDate(input) {\n    return input.replace(/sysdate\\s*-\\s*(\\d+)/gi, (_, days) => {\n      const date = new Date();\n      date.setDate(date.getDate() - Number(days));\n\n      // Format as ISO string without milliseconds\n      const formattedDate = date.toISOString().slice(0, 19) + \"Z\";\n      return `'${formattedDate}'`;\n    });\n  }\n\n  let filterClause = \"\";\n\n  if (\n    processFileInquiry.filterClause &&\n    processFileInquiry.filterClause.trim() !== \"\"\n  ) {\n    filterClause = replaceSysdateWithActualDate(processFileInquiry.filterClause);\n  }\n\n  // Build filter condition for preparedDocuments based on DOCUMENTREFERENCE values\n  function buildPreparedDocumentsFilter(referenceArray) {\n    const documentReferences = referenceArray\n      .map(item => item?.DOCUMENTREFERENCE)\n      .filter(ref => ref !== null && ref !== undefined && ref !== \"\");\n\n    const statusCondition = \"logicalDocumentStatus != 'ORA_SUCCEEDED'\";\n\n    if (documentReferences.length === 0) {\n      return statusCondition;\n    }\n\n    const joinedRefs = documentReferences\n      .map(ref =>\n        typeof ref === \"string\" ? `'${escapeFilterString(ref)}'` : ref\n      )\n      .join(\",\");\n\n    const identifierCondition =\n      `logicalDocumentIdentifier in (${joinedRefs})`;\n\n    return `(${statusCondition} or ${identifierCondition})`;\n  }\n\n  const preparedDocumentsFilter =\n    buildPreparedDocumentsFilter(remittanceAdviceReferenceArray);\n\n  const incomingDocsFilter =\n    \"trainingMode='N' and stream.flow.flowCode='FIN_AR_CREATE_REMITTANCE_ADVICES' and \" +\n    `(preparedDocuments[${preparedDocumentsFilter}])`;\n\n  const transformedDocsFilter =\n  `${preparedDocumentsFilter} ${filterClause}`.trim();\n\n  result = {\n    incomingDocsFilter,\n    transformedDocsFilter\n  };\n} catch (error) {\n  result = {\n    incomingDocsFilter: \"\",\n    transformedDocsFilter: \"\"\n  };\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1779116028113"
          },
          "code": "BUILD_QUERY_FILTER",
          "id": "1779115910354",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
