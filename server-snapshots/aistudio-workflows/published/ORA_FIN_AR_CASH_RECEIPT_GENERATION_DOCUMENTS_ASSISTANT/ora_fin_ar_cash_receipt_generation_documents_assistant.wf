        {
          "metadata": {
            "name": "Transform QOP data",
            "returnType": "array",
            "sourceCode": "const inputJsonObject = $context.$nodes.FETCH_INGESTED_DATA_FROM_DOCIO.$output || {};\n\nfunction safeStringValue(value, defaultValue = \"\") {\n  return value === null || value === undefined ? defaultValue : value;\n}\n\nfunction convertInputJsonObjectToFileStatusArray(inputObject) {\n  const sourceFileArray = Array.isArray(inputObject?.items) ? inputObject.items : [];\n\n  return sourceFileArray.flatMap((sourceFileObject) => {\n    const preparedDocumentArray = Array.isArray(sourceFileObject?.preparedDocuments?.items)\n      ? sourceFileObject.preparedDocuments.items\n      : [];\n\n    return preparedDocumentArray.map((preparedDocumentObject) => {\n      return {\n        documentId: preparedDocumentObject?.logicalDocumentIdentifier,\n        fileType: \"Remittance Advice\",\n        status: {\n          label: \"Completed\",\n          status: \"success\",\n         },\n        documentName: {\n          label: safeStringValue(preparedDocumentObject?.logicalDocumentName),\n          href: \"\"\n        },\n        format: safeStringValue(preparedDocumentObject?.logicalDocumentFormat).toUpperCase(),\n        summary: safeStringValue(preparedDocumentObject?.transactionStatistics),\n        sender: safeStringValue(sourceFileObject?.stream?.submitter),\n        processed: safeStringValue(sourceFileObject?.stream?.startTime),\n      };\n    });\n  });\n}\n\nconst fileStatusArray = convertInputJsonObjectToFileStatusArray(inputJsonObject);\n\nreturn fileStatusArray;"
          },
