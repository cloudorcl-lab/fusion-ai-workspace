            "returnType": "object",
            "sourceCode": "var data = $context.$nodes.RESPONSE_PARSER.$output.result.response ;\n\nif (data.length === 0) {\n  return {\n    messages: [\n      {\n        id: \"no_data_summary\",\n        type: \"text\",\n        contentPolicy: \"author\",\n        authoringHints: \"return no data found.\",\n        data: \"No data found.\"\n      }\n    ]\n  };\n}\n\nvar messagesArr = \n[\n\t{\n\t    id: \"summary\",\n\t    type: \"text\",\n\t    contentPolicy: \"author\",\n\t    authoringHints: \"preserve\",\n\t    data: $context.$nodes.OUTPUT_SUMMARIZER.$output \n\t},\n\t{\n\t  id: \"details_table\",\n\t  type: \"table\",\n\t  title: $context.$nodes.RESPONSE_PARSER.$output.result.title,\n\t  authoringHints: \"\",\n\t  data: $context.$nodes.RESPONSE_PARSER.$output.result.response\n\t}\n];\n\nif($context.$nodes.RESPONSE_PARSER.$output.result.deepLink === \"y\"){\n\tmessagesArr.push({\n\t  id: \"deeplinks\",\n\t  type: \"text\",\n\t  contentPolicy: \"author\",\n\t  authoringHints: \"Return the given html data as it is.\",\n\t  data: \"\\\"<a href=\\\\\\\"https://cptchieqy.fusionapps.ocs.oc-test.com/fscmUI/faces/oracle/apps/financials/receivables/receipts/desktopReceiptRemittance/di/excel/ViewandEditRemittanceAdviceCreationErrors.xlsx?podName=cptchieqy\\\\\\\">Resolve Remittance Advice Exceptions</a>\\\"\"\n\t});\n}\n\nreturn {\n  messages : messagesArr\n};"
