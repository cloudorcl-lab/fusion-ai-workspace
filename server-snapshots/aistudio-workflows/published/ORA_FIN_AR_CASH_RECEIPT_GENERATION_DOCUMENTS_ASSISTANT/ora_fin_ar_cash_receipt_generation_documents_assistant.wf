          "id": "1779135178404",
          "inputs": [
            {
              "id": "1779135226124_1",
              "name": "query",
              "type": "string",
              "value": "{{$context.$nodes.BUILD_REMITTANCE_ADVICE_INGESTED_DATA_PAYLOAD.$output.result}}"
