          "type": "CODE",
          "metadata": {
            "name": "Form update link payload",
            "sourceCode": "let result;\n\nlet assetDetail = $context.$nodes.FETCH_ASSET_DETAILS.$output.items[0];\nlet submitPayload =\n  $context.$nodes.GET_FORM_DETAILS.$output.result.submitPayload;\nlet linkId =  $context.$nodes.GET_FORM_DETAILS.$output.result.linkId || \"\";\nif (submitPayload?.length) {\n  // If submitPayload is wrapped in <oraFormSubmit>...</oraFormSubmit>, extract inner JSON\n  let payloadText = submitPayload.trim();\n\n  let tagMatch = payloadText.match(\n    /<oraFormSubmit\\b[^>]*>([\\s\\S]*)<\\/oraFormSubmit>/,\n  );\n\n  if (tagMatch) {\n    payloadText = tagMatch[1];\n  }\n\n  let updatedLinkFields = JSON.parse(payloadText);\n  let jsonModelData = JSON.parse(assetDetail.jsonModel);\n  let linkItem = { name: \"\" , trackingEnabled: false}; \n\n   updatedLinkFields.forEach((field) => {\n    if (field.id === \"name\") {\n      linkItem.name = field.value;\n    }\n     if (field.id === \"trackingEnabled\") {\n      linkItem.trackingEnabled = field.value.toLowerCase() === \"yes\" ? true : false;\n    }\n   });\n\n\n  jsonModelData.links.forEach((link) => {\n    if (link.id === linkId) {\n      link.name = linkItem.name;\n      link.trackingEnabled = linkItem.trackingEnabled;\n    }\n   });\n\n  result = {\n     etag: `\"${assetDetail.$context.etag}\"`,\n    payload: {\n        ...assetDetail, jsonModel: JSON.stringify(jsonModelData)\n    }\n  }\n\n} else {\n  result = assetDetail;\n}\n\nreturn result;\n",
            "returnType": "object"
          },
          "diagram": {
            "x": 7272.5,
            "y": 9640
          },
          "outcomes": {
            "success": "1781886301494"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
