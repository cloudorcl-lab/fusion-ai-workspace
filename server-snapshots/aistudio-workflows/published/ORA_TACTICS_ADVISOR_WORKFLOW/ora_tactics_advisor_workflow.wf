            "name": "Get Tactic and Program Identifier",
            "returnType": "object",
            "sourceCode": "let result = { TacticId: \"\", ProgramId: \"\" };\ntry {\n  const oraAppContext = $context.$app?.$OraAppContext || \"\";\n  let parsedContext = {};\n  try {\n    parsedContext = JSON.parse(oraAppContext);\n  } catch (parseError) {\n    parsedContext = {};\n  }\n  result = {\n    TacticId: parsedContext.TacticId || \"\",\n    ProgramId: parsedContext.ProgramId || \"\"\n  };\n} catch (error) {\n  result = { TacticId: \"\", ProgramId: \"\" };\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1779180433125"
          },
