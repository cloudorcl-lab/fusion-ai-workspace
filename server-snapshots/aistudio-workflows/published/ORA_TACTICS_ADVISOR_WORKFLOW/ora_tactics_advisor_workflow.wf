        {
          "metadata": {
            "name": "Determine Action",
            "returnType": "object",
            "sourceCode": "let result = \"\";\ntry {\nlet oraActionRaw = $context.$app.$OraAction || \"\";\n  if (typeof oraActionRaw !== \"string\") {\n    if (typeof oraActionRaw === \"object\" && oraActionRaw !== null) {\n      oraActionRaw = oraActionRaw.OraAction || \"\";\n    } else {\n      oraActionRaw = \"\";\n    }\n  } else {\n    const trimmed = oraActionRaw.trim();\n    if ((trimmed.startsWith(\"{\") && trimmed.endsWith(\"}\")) || (trimmed.startsWith(\"[\") && trimmed.endsWith(\"]\"))) {\n      try {\n        const parsed = JSON.parse(trimmed);\nresult = trimmed;\n        oraActionRaw = parsed?.action || \"\";\n      } catch (e) {\n      }\n    }\n  }\n\n  const possibleActions = [\n    \"viewSettings\",\n    \"ActivateTactic\",\n    \"previewProof\",\n    \"sendEmailProof\",\n    \"oraFormSubmit\",\n    \"editLink\",\n  ];\n  \n  const oraAction = oraActionRaw.startsWith(\"<\") ? oraActionRaw.substring(1) : oraActionRaw;\n  const matchedAction = possibleActions.find(action => oraAction.startsWith(action));\n  \n  if (matchedAction) {\n    result = matchedAction\n  } else {\n    const matchedAction = possibleActions.includes(oraActionRaw);\n    result = matchedAction || \"\";\n  }\n} catch (error) {\n  result = \"eror\";\n}\n\nreturn result;",
            "sourceType": "code"
          },
