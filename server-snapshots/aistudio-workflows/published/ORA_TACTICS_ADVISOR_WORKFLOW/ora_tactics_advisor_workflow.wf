        {
          "id": "1779160076606",
          "code": "IN_APP_RESPONSE",
          "type": "LLM",
          "metadata": {
            "name": "In APP Response"
          },
          "diagram": {
            "x": 12216,
            "y": 7258
          },
          "outcomes": {
            "success": "end"
          },
          "inputs": [
            {
              "id": "1779160076606_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "Output must contain only oraInfoDisplay and oraInsight contents. Must not contain any other text.\n\nAlso, WidgetRow \"mode\" must be \"edit\". Do not change it \nAlso use the followig for widget title and subtitle, do not generate. \"title\": \"Feature Highlight In-app Engagement Banner\",\n  \"subtitle\": \"A dismissible banner that appears across the top of Fusion pages to prompt users to learn more\","
            },
            {
              "id": "1779160076606_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Create the artifactPreviewWidget using the exact row definition below.\n\nSTRICT REQUIREMENTS:\n- Preserve `title`, `subtitle`, `content.title`, and `content.subtitle` EXACTLY as provided.\n- Do NOT rewrite, summarize, paraphrase, localize, shorten, capitalize differently, or infer alternative wording.\n- Do NOT generate replacement titles or subtitles.\n- Use the exact string values verbatim in the final output.\n- Any modification to these fields is considered an invalid response.\n\nSTRUCTURE PRESERVATION RULES:\n- Preserve the entire widget structure exactly as provided.\n- Do NOT add, remove, rename, reorder, or restructure properties.\n- Preserve all existing field names, hierarchy, and JSON formatting patterns.\n- Replace ONLY the intended editable content values.\n- Keep all IDs and configuration fields intact unless explicitly instructed otherwise.\n\nRow:\n{\n  \"artifactId\": \"1\",\n  \n  \"mode\": \"edit\",\n  \"content\": {\n    \"id\": \"1\",\n    \"type\": \"richText\",\n    \"title\": \"Feature Highlight In-app Engagement Banner\",\n    \"subtitle\": \"A dismissible banner that appears across the top of Fusion pages to prompt users to learn more\",\n    \"value\": {{$context.$variables.sampleInAppTemplate}},\n    \"url\": \"\",\n    \"mediaType\": \"binary\",\n    \"useApplicationSecurity\": false,\n    \"highlightText\": \"\",\n    \"commitText\": \"Save\"\n  },\n  \"actionText\": \"Review\"\n}\n\nOUTPUT REQUIREMENTS:\n- Return ONLY the final artifactPreviewWidget output.\n- Do NOT include commentary, explanations, markdown, analysis, or intermediate objects.\n- Ensure the final JSON is valid and complete.\n- Preserve all template-specific structure and configuration exactly as provided."
            }
          ],
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "enableActions": true,
              "layouts": [
                "ORA_LAYOUT_ARTIFACT_PREVIEW"
              ],
              "enableCommunications": true
            }
          }
        },
        {
          "id": "1779160149150",
          "code": "SET_RENEWAL_LANDING_TEMPLATE",
          "type": "SET_FIELDS",
          "metadata": {
            "name": "Set Renewal Landing Template"
          },
          "diagram": {
            "x": 12517.5,
            "y": 7036
          },
          "outcomes": {
            "success": "1779160183240"
          },
          "inputs": [
            {
              "id": "1779160149150_sampleRenewalLandingTemplate",
              "name": "sampleRenewalLandingTemplate",
              "value": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/><title>Oracle Fusion Agentic Applications for HR</title><style>@media(max-width:1000px){    body{overflow:auto !important;}    .page{height:auto !important;}    header, main, footer{height:auto !important;}    header{flex-direction:column !important; gap:15px !important; padding:20px !important;}    .main-title{font-size:34px !important;}    .subheadline{font-size:18px !important;}    main{padding:30px !important;}}</style></head><body style=\"font-family: Arial, Helvetica, sans-serif; background:#ffffff; color:#1f1f1f; height:100vh; overflow:hidden; margin:0; padding:0; box-sizing:border-box;\"><div class=\"page\" style=\"display:flex; flex-direction:column; height:100vh; margin:0; padding:0; box-sizing:border-box;\"><!-- HEADER --><header style=\"height:10vh; min-height:80px; background:#111111; color:white; display:flex; align-items:center; justify-content:space-between; padding:0 40px; margin:0; box-sizing:border-box;\"><div class=\"logo\" style=\"display:flex; align-items:center; margin:0; padding:0; box-sizing:border-box;\"><img alt=\"Oracle\" height=\"12\" src=\"https://www.oracle.com/webfolder/dms/tb/images/tb-oracle-white-123x16px.png\" style=\"display:block; width:92px; height:12px; border:0; margin:0; padding:0; box-sizing:border-box;\" width=\"92\"/></div><div class=\"header-right\" style=\"display:flex; align-items:center; gap:30px; color:#d6d6d6; font-size:15px; margin:0; padding:0; box-sizing:border-box;\"><span>Products</span><span>Industries</span><span>Resources</span><span>Support</span></div></header><!-- BODY --><main style=\"height:80vh; overflow:auto; background:#ffffff; padding:50px 80px; margin:0; box-sizing:border-box;\"><h1 class=\"main-title\" style=\"font-size:48px; line-height:1.2; margin:0 0 25px 0; padding:0; color:#1a1a1a; max-width:1200px; box-sizing:border-box;\">            Oracle Fusion Agentic Applications for HR        </h1><div class=\"subheadline\" style=\"font-size:22px; color:#444; margin:0 0 25px 0; padding:0; max-width:1100px; box-sizing:border-box;\">            Feature highlight: AI-powered workspaces designed to help HR teams streamline            decisions, reduce manual effort, and improve employee experiences        </div><img alt=\"Fusion Agentic Applications for HR\" class=\"hero-image\" src=\"https://www.oracle.com/a/pr/img/rc24-agentic-hcm.jpg\" style=\"width:100%; max-width:1000px; border-radius:6px; margin:0 0 40px 0; padding:0; box-sizing:border-box; display:block;\"/><div class=\"content\" style=\"max-width:1200px; font-size:18px; line-height:1.8; color:#333; margin:0; padding:0; box-sizing:border-box;\"><p style=\"margin:0 0 28px 0; padding:0; box-sizing:border-box;\">                Built into Oracle Fusion Cloud Applications, Fusion Agentic                Applications for HR bring specialized AI agents into everyday                HR processes. They can securely use unified enterprise data,                workflows, policies, approval hierarchies, permissions, and                transactional context to help teams move from insight to action.            </p><p style=\"margin:0 0 28px 0; padding:0; box-sizing:border-box;\">                HR leaders and managers are being asked to deliver better                employee experiences, make faster decisions, and support                compliance efforts, all while operating with leaner teams and                more complex policies.            </p><p style=\"margin:0 0 28px 0; padding:0; box-sizing:border-box;\">                Running on Oracle Cloud Infrastructure and extending Oracle Fusion                Cloud Applications, Fusion Agentic Applications are designed to                move beyond assistance toward coordinated execution across HR work.            </p><ul style=\"padding-left:25px; margin:0 0 30px 0; box-sizing:border-box;\"><li style=\"margin:0 0 18px 0; padding:0; box-sizing:border-box;\"><strong style=\"color:#000; margin:0; padding:0; box-sizing:border-box;\">Career Advancement Command Center:</strong>                    Helps HR leaders promote career mobility and connect employees                    to open roles.                </li><li style=\"margin:0 0 18px 0; padding:0; box-sizing:border-box;\"><strong style=\"color:#000; margin:0; padding:0; box-sizing:border-box;\">Contract Compliance Workspace:</strong>                    Helps HR leaders automate contract execution and semantically                    analyze agreements.                </li><li style=\"margin:0 0 18px 0; padding:0; box-sizing:border-box;\"><strong style=\"color:#000; margin:0; padding:0; box-sizing:border-box;\">Hiring Workspace for Store Managers:</strong>                    Helps retail store managers reduce administrative work.                </li><li style=\"margin:0 0 18px 0; padding:0; box-sizing:border-box;\"><strong style=\"color:#000; margin:0; padding:0; box-sizing:border-box;\">Manager Concierge Workspace:</strong>                    Helps managers prioritize what needs attention and take                    policy-backed actions.                </li><li style=\"margin:0 0 18px 0; padding:0; box-sizing:border-box;\"><strong style=\"color:#000; margin:0; padding:0; box-sizing:border-box;\">My Help Workspace for Employees:</strong>                    Helps employees resolve issues faster and stay on top                    of requests.                </li><li style=\"margin:0 0 18px 0; padding:0; box-sizing:border-box;\"><strong style=\"color:#000; margin:0; padding:0; box-sizing:border-box;\">Team Learning Workspace for Managers:</strong>                    Helps managers upskill their teams and identify                    emerging skill gaps.                </li><li style=\"margin:0 0 18px 0; padding:0; box-sizing:border-box;\"><strong style=\"color:#000; margin:0; padding:0; box-sizing:border-box;\">Team Talent Calibration and Review Workspace:</strong>                    Helps managers conduct more consistent talent review                    assessments.                </li><li style=\"margin:0 0 18px 0; padding:0; box-sizing:border-box;\"><strong style=\"color:#000; margin:0; padding:0; box-sizing:border-box;\">Workforce Operations Command Center:</strong>                    Helps managers execute workforce scheduling and absence                    operations faster.                </li></ul><p style=\"margin:0 0 28px 0; padding:0; box-sizing:border-box;\">                Fusion Agentic Applications for HR are supported by an AI ecosystem                anchored by Oracle AI Agent Studio.            </p><p style=\"margin:0 0 28px 0; padding:0; box-sizing:border-box;\">                Explore how Oracle Fusion Applications can help teams simplify                work, connect data, and act with greater confidence. Visit                www.oracle.com/applications            </p></div></main><!-- FOOTER --><footer style=\"height:10vh; min-height:80px; background:#111111; color:#bdbdbd; display:flex; align-items:center; justify-content:center; font-size:14px; margin:0; padding:0; box-sizing:border-box;\">        © 2026 Oracle Corporation    </footer></div></body></html>"
            }
          ]
        },
        {
