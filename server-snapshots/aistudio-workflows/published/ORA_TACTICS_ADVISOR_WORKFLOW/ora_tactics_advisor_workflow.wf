          "code": "GET_PROOF_ADDRESS",
          "type": "CODE",
          "metadata": {
            "name": "Get proof address",
            "sourceCode": "let result;\ntry {\n  // Safely access asset details and form submit payload\n  let assetDetail = $context.$nodes?.FETCH_ASSET_DETAILS?.$output?.items?.[0];\n  let submitPayload =\n    $context.$nodes?.GET_FORM_DETAILS?.$output?.result?.submitPayload;\n\n  if (assetDetail && submitPayload) {\n    // Extract inner JSON if wrapped in <oraFormSubmit> tags\n    let payloadText = submitPayload.trim();\n    let tagMatch = payloadText.match(\n      /<oraFormSubmit\\b[^>]*>([\\s\\S]*)<\\/oraFormSubmit>/,\n    );\n    if (tagMatch) {\n      payloadText = tagMatch[1];\n    }\n\n    result = JSON.parse(payloadText)[0].value;\n\n  } else {\n    result = \"\";\n  }\n  \n} catch (error) {\n  // On error, return empty string\n  result = \"\";\n}\n\nreturn result;\n",
            "returnType": "string"
          },
