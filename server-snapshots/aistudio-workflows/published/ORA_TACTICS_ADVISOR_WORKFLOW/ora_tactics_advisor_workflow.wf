        {
          "id": "1781770335666",
          "code": "PROOF_PAYLOAD",
          "type": "CODE",
          "metadata": {
            "name": "Proof payload",
            "returnType": "object",
            "sourceCode": "let result;\ntry {\n  // Safely access the first asset detail item\n  let assetDetail = $context.$nodes.FETCH_ASSET_DETAILS?.$output?.items?.[0];\n  if (!assetDetail) {\n    // If no asset detail found, return a safe default object\n    result = {\n      limit: 1,\n      toAddresses: [],\n      message: {},\n      offset: 0\n    };\n  } else {\n    // Parse the entire jsonModel string safely\n    let jsonData = {};\n    try {\n      jsonData = JSON.parse(assetDetail.jsonModel);\n    } catch (parseError) {\n      // If parsing fails, fallback to empty object\n      jsonData = {};\n    }\n\n    let domain = assetDetail.domain;\n\n    // Compose the result object with entire jsonData included\n    result = {\n      limit: 1,\n      toAddresses: [$context.$nodes.GET_PROOF_ADDRESS?.$output?.result || {}],\n      message: { \n        ...jsonData,\n        id: assetDetail.id,\n        versionNumber: assetDetail.$context?.etag, // optional chaining for etag\n        domain \n      },\n      offset: 0\n    };\n  }\n} catch (error) {\n  // On any error, return safe default object\n  result = {\n    limit: 1,\n    toAddresses: [],\n    message: {},\n    offset: 0\n  };\n}\n\nreturn result;"
          },
