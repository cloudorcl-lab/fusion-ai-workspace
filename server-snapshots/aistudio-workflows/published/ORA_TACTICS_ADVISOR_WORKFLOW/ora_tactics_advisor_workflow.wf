          "inputs": [
            {
              "id": "1779159948483_sampleInAppTemplate",
              "name": "sampleInAppTemplate",
              "value": "<!doctype html><html lang=en><head><meta charset=utf-8><meta name=viewport content=\"width=device-width,initial-scale=1\"><title>Fusion HCM Banner</title></head><body style=\"margin:0;background:#d4d6d7;display:flex;justify-content:center;padding:24px;overflow-x:hidden\"><svg viewBox=\"0 0 2048 350\" style=\"width:72vw;max-width:100%;height:auto;background:#f7f5f4;box-shadow:0 8px 28px #0003;font-family:Arial,sans-serif\">    <image href=\"data:image/webp;base64,\" x=\"0\" y=\"100\" width=\"2048\" height=\"24\" preserveAspectRatio=\"none\"/>  <rect x=\"0\" y=\"124\" width=\"2048\" height=\"160\" fill=\"#438195\"/>  <text x=\"34\" y=\"175\" font-size=\"32\" font-weight=\"800\" fill=\"#fff\">Coming Soon: New Agentic Applications for HR in Fusion HCM</text>  <text x=\"34\" y=\"213\" font-size=\"24\" font-weight=\"500\" fill=\"#fff\">New class of enterprise applications reinvent HR processes by unlocking time,</text>  <text x=\"34\" y=\"243\" font-size=\"24\" font-weight=\"500\" fill=\"#fff\">capacity, and outcomes that were previously out of reach</text>  <rect x=\"1618\" y=\"153\" width=\"132\" height=\"50\" rx=\"5\" fill=\"#ffffff12\" stroke=\"#ffffffb8\" stroke-width=\"2\"/>  <text x=\"1684\" y=\"185\" text-anchor=\"middle\" font-size=\"24\" font-weight=\"700\" fill=\"#fff\">Learn More</text>  <text x=\"1795\" y=\"185\" font-size=\"24\" font-weight=\"700\" fill=\"#fff\">Dismiss</text>  </svg></body></html>"
            }
