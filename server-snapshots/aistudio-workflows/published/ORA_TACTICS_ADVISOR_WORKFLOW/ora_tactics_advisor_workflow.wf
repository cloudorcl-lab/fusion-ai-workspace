            "name": "Refine data for landing page settings",
            "sourceCode": "let result = {};\ntry {\n  let emailData = $context.$nodes.FETCH_MESSAGE_DETAILS.$output.items[0];\n  let jsonData = JSON.parse(emailData.jsonModel);\n\n  const fetchedDomainList =\n    $context.$nodes?.FETCH_DOMAINS?.$output?.items || [];\n  const domainsList = fetchedDomainList.map((item) => ({\n    value: item.id,\n    label: item.primaryDomain,\n  }));\n\n  const settingsData = {\n    id: emailData.id || \"\",\n    name: emailData.name || \"\",\n    description: jsonData.description || \"\",\n    pageTitle: jsonData.pageTitle || \"\",\n    domainId: emailData.domain?.id || \"\",\n    domainName:\n      fetchedDomainList.find((item) => item.id === emailData.domain?.id)\n        ?.primaryDomain || \"\",\nlinks: jsonData.links,\n  };\n\n  result = { settingsData, domainsList };\n} catch (error) {\n  result = { settingsData: {}, domainsList: [] };\n}\n\nreturn result;",
            "returnType": "object"
