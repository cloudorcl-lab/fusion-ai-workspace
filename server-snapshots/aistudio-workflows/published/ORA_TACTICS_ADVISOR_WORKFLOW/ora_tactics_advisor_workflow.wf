              "name": "prompt",
              "type": "string",
              "value": "Input: {{$context.$nodes.REFINE_DATA_FOR_LANDING_PAGE_SETTINGS.$output.result}}\n\nTask:\nCreate an Editable Record Widget from the input data and a MultiRecord widget from the `input.links` data with below oraInfoDisplay content.\n\n<oraInfoDisplay key=\"<review-lp-settings>\">\n{\n  \"patternId\": \"recordWidget\",\n  \"config\": {\n    \"id\": `${input.id}-lpSettings`,\n    \"readOnly\": false,\n    \"submitText\": \"Save\",\n    \"fields\": [\n      {\n        \"id\": \"name\",\n        \"type\": \"text\",\n        \"label\": \"Name\",\n        \"value\": input.name\n      },\n      {\n        \"id\": \"description\",\n        \"type\": \"text\",\n        \"label\": \"Description\",\n        \"value\": input.description\n      },\n      {\n        \"id\": \"pageTitle\",\n        \"type\": \"text\",\n        \"label\": \"pageTitle\",\n        \"value\": input.pageTitle\n      }\n      {\n        \"id\": \"domain\",\n        \"type\": \"select\",\n        \"label\": \"Domain Name\",\n        \"value\": input.domainId,\n        \"options\": input.domainsList\n      }\n    ]\n  }\n}\n</oraInfoDisplay>\n\n<oraInfoDisplay key=\"edit-lp-links\">\n  {\n    title: \"Link tracking\",\n    patternId: \"multiRecordWidget\",\n    config: {\n      subtitle: \"Manage tracked URLs for this landingPage\",\n      cols: [\n        \"Name\",\n        \"ID\",\n        \"Type\",\n        \"URL\",\n        \"Tracking\",\n      ],\n      rows: (() => {\n        let assetId = input.id\n        let rows = input.links.map((link) => ({\n          return {cells: [\n            link.name || \"-\",\n            link.id,\n            link.type,\n            link.url || \"-\",\n            link.trackingEnabled ? \"On\" : \"Off\"\n          ],\n          action: {\n            text: \"Edit\",\n            command: `ora.Invoke(\"editLink\", { \"action\": \"editLink\",  \"assetId\": \"${assetId}\", \"linkData\": \"${link}\" })`,\n          }\n        }\n      }))\n      return rows.length > 0 ? rows : cells: [\"Links are not configured for the email\"]\n      })();,\n    },\n  }\n</oraInfoDisplay>\n\nDo not generate description\nIf values of the field are not found use empty string\nDo not fill with generated content\n"
            },
            {
              "id": "1781648548785_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "Output must include only oraInfoDisplay. Do not add any additional text"
            }
          ],
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "enableActions": true,
              "layouts": [
                "ORA_LAYOUT_RECORD"
              ]
            }
          }
        },
