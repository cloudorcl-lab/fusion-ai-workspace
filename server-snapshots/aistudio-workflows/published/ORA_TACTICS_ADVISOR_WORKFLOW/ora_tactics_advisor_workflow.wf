          "id": "1781205543615",
          "code": "GET_FORM_DETAILS",
          "type": "CODE",
          "metadata": {
            "name": "Get form details",
            "sourceCode": "let result = {\n  submitId: \"\",\n  submitPayload: \"\"\n}\n\nlet oraAction = $context.$app.$OraAction || \"\";\nconst match = oraAction.match(\n  /<oraFormSubmit\\s+id=\"([^\"]+)\"\\s*>([\\s\\S]*?)<\\/oraFormSubmit\\s*>/\n);\n\nif (!match) {\n  throw new Error(\"Invalid oraFormSubmit payload\");\n}\n\nresult.submitId = match[1];\nresult.submitAction = match[1].split(\"-\")[1]\nresult.submitPayload = match[2];\nif (match[1].split(\"-\")[2] && result.submitAction === \"updateLink\") {\n  result.linkId = match[1].split(\"-\")[2]\n}\nreturn result;",
            "returnType": "object"
          },
