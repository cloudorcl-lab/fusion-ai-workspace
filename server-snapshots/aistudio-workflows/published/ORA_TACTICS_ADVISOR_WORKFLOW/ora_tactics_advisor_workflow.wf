          "code": "GET_SUCCESS_CRITERIA",
          "type": "CODE",
          "metadata": {
            "name": "Get Success Criteria",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  // Access the jsonModel string from GET_TACTIC_DETAILS output\n  const jsonModelString = $context.$nodes?.GET_TACTIC_DETAILS?.$output?.jsonModel || \"\";\n\n  // Parse JSON string safely\n  let parsedJson = {};\n  if (jsonModelString) {\n    try {\n      parsedJson = JSON.parse(jsonModelString);\n    } catch (parseError) {\n      // If parsing fails, fallback to empty object\n      parsedJson = {};\n    }\n  }\n\n  // Access nested property sampleAutomationJsonModel.config.successCriteria safely\n  result = parsedJson?.config?.successCriteria || {};\n} catch (error) {\n  result = {};\n}\n\nreturn result;"
          },
