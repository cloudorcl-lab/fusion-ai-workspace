        {
          "metadata": {
            "name": "Refine tactic references",
            "returnType": "array",
            "sourceCode": "let result = []\nlet jsonString = $context.$nodes.GET_TACTIC_DETAILS?.$output?.jsonModel;\nlet jsonData = {};\n\nif (typeof jsonString === \"string\" && jsonString.trim() !== \"\") {\n  jsonData = JSON.parse(jsonString);\n}\n\nif (jsonData?.references?.length) {\n  jsonData.references.forEach((item) => {\n    if (item.category.includes(\"Email\") || item.category === \"Landing Page\") {\n  if(item.id) {\n      result.push(item);\n}\n    }\n  });\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1782140656489"
          },
          "code": "REFINE_TACTIC_REFERENCES",
          "id": "1778460787600",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
