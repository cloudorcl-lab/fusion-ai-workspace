        {
          "id": "1781166801582",
          "code": "STRUCTURE_API_DATA",
          "type": "CODE",
          "metadata": {
            "name": "structure API data",
            "returnType": "object",
            "sourceCode": "let result = { emails: [], landingPages: [] };\ntry {\n  // Safely access the FETCH_REFERENCES output\n  const apiDataRaw = $context.$nodes?.FETCH_REFERENCES?.$output;\n  // apiDataRaw might be an array of strings or objects; ensure it's an array\n  const apiDataArray = Array.isArray(apiDataRaw) ? apiDataRaw : [];\n\n  apiDataArray.forEach((item) => {\n    let itemData = null;\n    // item might be a JSON string or already an object\n    if (typeof item === \"string\") {\n      try {\n        itemData = JSON.parse(item);\n      } catch (e) {\n        // If parsing fails, skip this item\n        itemData = null;\n      }\n    } else if (typeof item === \"object\" && item !== null) {\n      itemData = item;\n    }\n\n    if (!itemData) return; // skip invalid data\n\n    const channel = itemData.channel?.toLowerCase();\n\n    let jsonModel = {};\n    try {\n      jsonModel = JSON.parse(itemData.jsonModel || \"{}\");\n    } catch (e) {\n      jsonModel = {};\n    }\n\n    // Safely access nested properties with optional chaining\n    let htmlContent = jsonModel?.canvases?.html?.content || \"\";\n    htmlContent = htmlContent.replace(/\\{\\{\\s*(cxTag|trackingPixel)\\s*\\(\\s*\\)\\s*\\}\\}/gi, \"\");\n    const envelope = jsonModel?.envelope || {};\n\n    const assetData = {\n      id: itemData.id || \"\",\n      name: itemData.name || \"\",\n      description: itemData.description || \"\",\n      channel: itemData.channel || \"\",\n      htmlContent: htmlContent,\n    };\n    if (channel === \"email\") {\n      result.emails.push({ ...assetData });\n    } else if (channel === \"landingpage\") {\n      result.landingPages.push({ ...assetData });\n    }\n  });\n} catch (error) {\n  // On error, return empty structure\n  result = { emails: [], landingPages: [] };\n}\n\nreturn result;\n"
          },
          "diagram": {
            "x": 11167.5,
            "y": 7756
          },
          "outcomes": {
            "success": "1780593594415"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1780593594415",
