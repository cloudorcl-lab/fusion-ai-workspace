          "outcomes": {
            "success": "end"
          },
          "inputs": [
            {
              "id": "1780593594415_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "Output must contain only oraInfoDisplay and oraInsight contents. Must not contain any other text, explanations, markdown, or extra text."
            },
            {
              "id": "1780593594415_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Create the artifactPreviewWidgets for each item in email list {{$context.$nodes.STRUCTURE_API_DATA.$output.result.emails}} and landing page list {{$context.$nodes.STRUCTURE_API_DATA.$output.result.landingPages}} only\nSTRICT REQUIREMENTS:\n- DO NOT add any title/heading or subtitle/complemetary text or Panel description to the panel. The panel Header and Description fields SHOULD be EMPTY\n- DO NOT rewrite, summarize, rephrase, localize, capitalize differently, or infer alternative wording.\n- DO NOT generate new titles or subtitles.\n- Use the exact string values verbatim in the final output.\n- Only populate the widget structure and insights.\nFor both lists strictly follow below structure\nRow:\n{\n  \"artifactId\": <item.id>,\n  \"mode\": \"edit\",\n  \"content\": {\n    \"id\": \"<item.id>-artifact\",\n    \"type\": \"RichText\",\n    \"title\": <item.name>,\n    \"subtitle\": <item.description || \"\">,\n    \"value\":<item.jsonModel.canvases.content.html>,\n    \"url\": \"\",\n    \"mediaType\": \"binary\",\n    \"useApplicationSecurity\": false,\n    \"highlightText\": \"\",\n \"commitText\": \"Save\"\n  },\n \"actionText\": \"Review\"\n}\nFor each artifactWidget of email, add below two PRIORITY actions:\n\n<oraInsights>\n{\n  \"title\": \"<item.name>\",\n  \"shortDescription\": \"<item.description>\",\n  \"actionText\": \"Review Email Settings\",\n  \"priority\": true,\n  \"followUpCommand\": \"ora.Invoke(\\\"reviewEmailSettings\\\", {\\\"action\\\": \\\"viewSettings\\\", \\\"assetId\\\": <item.id matching artifactId> } )\"\n}\n</oraInsight>\n\n<oraInsights>\n{\n  \"title\": \"<item.name>\",\n  \"shortDescription\": \"<item.description>\",\n  \"actionText\": \"Send Email Proof\",\n  \"priority\": true,\n  \"followUpCommand\": \"ora.Invoke(\\\"sendEmailProof\\\", {\\\"action\\\": \\\"sendEmailProof\\\", \\\"assetId\\\": <item.id matching artifactId> })\"\n}\n</oraInsight>\n\nFor each artifactWidget of landingPage, add below two PRIORITY actions:\n\n<oraInsights>\n{\n  \"title\": \"<item.name>\",\n  \"shortDescription\": \"<item.description>\",\n  \"actionText\": \"Review Landing Page Settings\",\n  \"priority\": true,\n    \"followUpCommand\": \"ora.Invoke(\\\"reviewLandingPageSettings\\\", {\\\"action\\\": \\\"viewSettings\\\", \\\"assetId\\\": <item.id matching artifactId> } )\"\n}\n</oraInsight>\n\n<oraInsights>\n{\n  \"title\": \"<item.name>\",\n  \"shortDescription\": \"<item.description>\",\n  \"actionText\": \"Preview Proof\",\n  \"priority\": true,\n    \"followUpCommand\": \"ora.Invoke(\\\"previewProof\\\", {\\\"action\\\": \\\"previewProof\\\", \\\"assetId\\\": <item.id matching artifactId> } )\"\n}\n</oraInsight>\n\n"
            }
          ],
          "aiAppOutputSpecification": {
