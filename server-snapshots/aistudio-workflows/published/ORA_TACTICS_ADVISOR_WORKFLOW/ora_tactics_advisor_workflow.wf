        {
          "id": "1781848051410",
          "code": "RETRIEVE_SEGMENT_ID",
          "type": "CODE",
          "metadata": {
            "name": "Retrieve Segment ID",
            "returnType": "string",
            "sourceCode": "let result = \"\";\ntry {\n  // Access the stages array from GET_JSON_MODEL node output\n  const stages = $context.$nodes?.GET_JSON_MODEL?.$output?.result?.stages || [];\n\n  // Find the first stage with type \"segment\"\n  const segmentStage = stages.find(stage => stage?.type === \"segment\");\n\n  // Extract segmentId from the configuration object if available\n  if (segmentStage?.configuration?.segmentId) {\n    result = segmentStage.configuration.segmentId;\n  } else {\n    result = \"\"; // Return empty string if not found\n  }\n} catch (error) {\n  result = \"\"; // Return empty string on error\n}\n\nreturn result;"
          },
          "diagram": {
            "x": 8953,
            "y": 7997
          },
          "outcomes": {
            "success": "1781848092661"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
