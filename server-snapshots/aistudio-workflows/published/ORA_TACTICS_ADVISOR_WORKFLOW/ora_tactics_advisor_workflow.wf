        {
          "id": "1781615182928",
          "code": "REFINE_DATA_FOR_EMAIL_SETTINGS",
          "type": "CODE",
          "metadata": {
            "name": "Refine data for email settings",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  let emailData = $context.$nodes.FETCH_MESSAGE_DETAILS.$output.items[0];\n  let jsonData = JSON.parse(emailData.jsonModel);\n\n  const fetchedDomainList =\n    $context.$nodes?.FETCH_DOMAINS?.$output?.items || [];\n  const domainsList = fetchedDomainList.map((item) => ({\n    value: item.id,\n    label: item.primaryDomain,\n  }));\n\n  const settingsData = {\n    id: emailData.id || \"\",\n    name: emailData.name || \"\",\n    description: jsonData.description || \"\",\n    subjectLine: jsonData.subjectLine || \"\",\n    domainId: emailData.domain?.id || \"\",\n    domainName:\n      fetchedDomainList.find((item) => item.id === emailData.domain?.id)\n        ?.primaryDomain || \"\",\n    fromName: jsonData.envelope.fromName || \"\",\n    fromAddress: jsonData.envelope.fromAddress || \"\",\n    replyToName: jsonData.envelope.replyToName || \"\",\n    replyToAddress: jsonData.envelope.replyToAddress || \"\",\n    encoding: jsonData.encoding || \"\",\n    trackOpens: jsonData.tracking.includes(\"open\") ? \"Yes\" : \"No\",\n    trackClicks:  jsonData.tracking.includes(\"click\") ? \"Yes\" : \"No\",\n    links: jsonData.links,\n  };\n\n  result = { settingsData, domainsList };\n} catch (error) {\n  result = { settingsData: {}, domainsList: [] };\n}\n\nreturn result;",
            "sourceType": "code"
          },
          "diagram": {
            "x": 7581.5,
            "y": 9862
          },
          "outcomes": {
            "success": "1780917592042"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1780917592042",
          "code": "VIEWEMAILSETTINGS",
          "type": "LLM",
          "metadata": {
            "name": "viewEmailSettings"
          },
          "diagram": {
            "x": 7603.625,
            "y": 10084
          },
          "outcomes": {
            "success": "end"
          },
          "inputs": [
            {
              "id": "1780917592042_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "Output must include only oraInfoDisplay. Do not add any additional text. You must adhere to the standard oraInfoDisplay Knowledge Base."
            },
            {
              "id": "1780917592042_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Input: {{$context.$nodes.REFINE_DATA_FOR_EMAIL_SETTINGS.$output.result}}\n\nTask:\nCreate an Editable Record Widget from the input data and a MultiRecord widget from the `input.links` data with below oraInfoDisplay content.\n\n<oraInfoDisplay key=\"<review-email-settings>\">\n{\n  \"patternId\": \"recordWidget\",\n  \"config\": {\n    \"id\": `${input.id}-emailSettings`,\n    \"readOnly\": false,\n    \"submitText\": \"Save\",\n    \"fields\": [\n      {\n        \"id\": \"name\",\n        \"type\": \"text\",\n        \"label\": \"Name\",\n        \"value\": input.name\n      },\n      {\n        \"id\": \"description\",\n        \"type\": \"text\",\n        \"label\": \"Description\",\n        \"value\": input.description\n      },\n      {\n        \"id\": \"subjectLine\",\n        \"type\": \"text\",\n        \"label\": \"Subject Line\",\n        \"value\": input.subjectLine\n      }\n      {\n        \"id\": \"domain\",\n        \"type\": \"select\",\n        \"label\": \"Domain Name\",\n        \"value\": input.domainId,\n        \"options\": input.domainsList\n      },\n      {\n        \"id\": \"fromName\",\n        \"type\": \"text\",\n        \"label\": \"Sender Name\",\n        \"value\": input.fromName\n      },\n      {\n        \"id\": \"fromAddress\",\n        \"type\": \"text\",\n        \"label\": \"Sender Email Address\",\n        \"value\": input.fromAddress\n      },\n      {\n        \"id\": \"replyToName\",\n        \"type\": \"text\",\n        \"label\": \"Reply to Name\",\n        \"value\": input.replyToName\n      },\n      {\n        \"id\": \"replyToAddress\",\n        \"type\": \"text\",\n        \"label\": \"Reply to Email Address\",\n        \"value\": input.replyToAddress\n      },\n      {\n        \"id\": \"encoding\",\n        \"type\": \"text\",\n        \"label\": \"Encoding\",\n        \"value\": \"Unicode (\" + input.encoding + \")\"\n      },\n      {\n        \"id\": \"trackOpens\",\n        \"type\": \"select\",\n        \"label\": \"Track Opens\",\n        \"value\": input.trackOpens.includes(\"open\") ? \"yes\" : \"no\",\n        \"options\": [\n          { \"value\": \"Yes\", \"label\": \"Yes\" },\n          { \"value\": \"No\", \"label\": \"No\" }\n        ]\n      },\n      {\n        \"id\": \"trackClicks\",\n        \"type\": \"select\",\n        \"label\": \"Track Clicks\",\n        \"value\": input.trackClicks.includes(\"click\") ? \"yes\" : \"no\",\n        \"options\": [\n          { \"value\": \"Yes\", \"label\": \"Yes\" },\n          { \"value\": \"No\", \"label\": \"No\" }\n        ]\n      }\n    ]\n  }\n}\n</oraInfoDisplay>\n\n  <oraInfoDisplay key=\"edit-links\">\n  {\n    title: \"Link tracking\",\n    patternId: \"multiRecordWidget\",\n    config: {\n      subtitle: \"Manage tracked URLs for this email\",\n      cols: [\n        \"Name\",\n        \"ID\",\n        \"Type\",\n        \"URL\",\n        \"Tracking\",\n      ],\n      rows: (() => {\n        let assetId = input.id\n        let rows = input.links.map((link) => ({\n          return {cells: [\n            link.name || \"-\",\n            link.id,\n            link.type,\n            link.url || \"-\",\n            link.trackingEnabled ? \"On\" : \"Off\"\n          ],\n          action: {\n            text: \"Edit\",\n            command: `ora.Invoke(\"editLink\", { \"action\": \"editLink\",  \"assetId\": \"${assetId}\", \"linkData\": \"${link}\" })`,\n          }\n        }\n      }))\n      return rows.length > 0 ? rows : cells: [\"Links are not configured for the email\"]\n      })();,\n    },\n  }\n  </oraInfoDisplay>\n\nDo not generate description\nIf values of the field are not found use empty string\nDo not fill with generated content\n\n"
            }
          ],
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_RECORD",
                "ORA_LAYOUT_MULTIRECORD"
              ],
              "customNotes": "",
              "enableActions": true
            }
          },
          "outputSpecification": ""
        },
        {
          "id": "1781648491456",
