        {
          "id": "1782140656489",
          "code": "RETRIEVE_SEGMENT_CONFIGURATION",
          "type": "CODE",
          "metadata": {
            "description": "",
            "name": "Retrieve Segment Configuration",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  // Access the jsonModel string from GET_TACTIC_DETAILS output\n  const jsonModelString = $context.$nodes?.GET_TACTIC_DETAILS?.$output?.jsonModel || \"\";\n\n  // Parse JSON string safely\n  let parsedJson = {};\n  if (jsonModelString) {\n    try {\n      parsedJson = JSON.parse(jsonModelString);\n    } catch (parseError) {\n      // If parsing fails, fallback to empty object\n      parsedJson = {};\n    }\n  }\n\n  const stages =\n    parsedJson?.sampleAutomationJsonModel?.stages || parsedJson?.stages;\n\n  const segmentStage = stages.find(stage => stage?.type === \"segment\");\nconst triggerStage = stages.find(stage => stage?.type === \"trigger\");\n  result = segmentStage?.configuration?.schedule || triggerStage?.triggerSettings;\n} catch (error) {\n  result = {};\n}\n\nreturn result;"
          },
          "diagram": {
