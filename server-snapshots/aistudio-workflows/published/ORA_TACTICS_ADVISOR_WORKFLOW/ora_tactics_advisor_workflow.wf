          "code": "UPDATE_LP_WITH_FORM_DATA",
          "type": "CODE",
          "metadata": {
            "name": "Update LP with form data",
            "sourceCode": "let result;\n\nlet assetDetail = $context.$nodes.FETCH_ASSET_DETAILS.$output.items[0];\nlet submitPayload =\n  $context.$nodes.GET_FORM_DETAILS.$output.result.submitPayload;\n\nif (submitPayload?.length) {\n  // If submitPayload is wrapped in <oraFormSubmit>...</oraFormSubmit>, extract inner JSON\n  let payloadText = submitPayload.trim();\n\n  let tagMatch = payloadText.match(\n    /<oraFormSubmit\\b[^>]*>([\\s\\S]*)<\\/oraFormSubmit>/,\n  );\n\n  if (tagMatch) {\n    payloadText = tagMatch[1];\n  }\n\n  let updatedEmailFields = JSON.parse(payloadText);\n  let jsonModelData = JSON.parse(assetDetail.jsonModel);\n\n  updatedEmailFields.forEach((item) => {\n    switch (item.id) {\n      case \"name\":\n        if (item.value && assetDetail.name && jsonModelData.name) {\n          assetDetail.name = item.value\n          jsonModelData.name = item.value\n        }\n        break;\n      case \"description\":\n        assetDetail.description = item.value\n        jsonModelData.description = item.value\n        break;\n      case \"domain\":\n        if (item.value && assetDetail.domain && jsonModelData.domain) {\n          assetDetail.domain.id = item.value\n          jsonModelData.domain.id = item.value\n        }\n        break;\n      case \"pageTitle\":\n        jsonModelData.pageTitle = item.value;\n        break;\n    }\n  });\n  result = {\n    etag: `\"${assetDetail.$context.etag}\"`,\n    payload: {\n        ...assetDetail, jsonModel: JSON.stringify(jsonModelData)\n    }\n  }\n\n} else {\n  result = assetDetail;\n}\n\nreturn result;\n",
            "returnType": "object"
          },
