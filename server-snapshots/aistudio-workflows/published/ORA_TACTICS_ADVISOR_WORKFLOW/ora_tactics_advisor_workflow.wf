            "name": "Update email with form data",
            "returnType": "object",
            "sourceCode": "let result;\n\nlet assetDetail = $context.$nodes.FETCH_ASSET_DETAILS.$output.items[0];\nlet submitPayload =\n  $context.$nodes.GET_FORM_DETAILS.$output.result.submitPayload;\n\nif (submitPayload?.length) {\n  // If submitPayload is wrapped in <oraFormSubmit>...</oraFormSubmit>, extract inner JSON\n  let payloadText = submitPayload.trim();\n\n  let tagMatch = payloadText.match(\n    /<oraFormSubmit\\b[^>]*>([\\s\\S]*)<\\/oraFormSubmit>/,\n  );\n\n  if (tagMatch) {\n    payloadText = tagMatch[1];\n  }\n\n  let updatedEmailFields = JSON.parse(payloadText);\n  let jsonModelData = JSON.parse(assetDetail.jsonModel);\n\n  updatedEmailFields.forEach((item) => {\n    switch (item.id) {\n      case \"name\" : \n        if (item.value) {\n           assetDetail.name = item.value\n          jsonModelData.name = item.value\n        }\n        break;\n\n      case \"domain\":\n        if (item.value && assetDetail.domain && jsonModelData.domain) {\n          assetDetail.domain.id = item.value\n          jsonModelData.domain.id = item.value\n        }\n        break;\n\n      case \"description\":\n        assetDetail.description = item.value\n        jsonModelData.description = item.value\n        break;\n\n      case \"subjectLine\":\n        jsonModelData.subjectLine = item.value\n        break;\n\n      case \"fromName\":\n        jsonModelData.envelope.fromName = item.value;\n        break;\n\n      case \"fromAddress\":\n        jsonModelData.envelope.fromAddress = item.value;\n        break;\n\n      case \"replyToName\":\n        jsonModelData.envelope.replyToName = item.value;\n        break;\n\n      case \"replyToAddress\":\n        jsonModelData.envelope.replyToAddress = item.value;\n        break;\n\n      case \"trackOpens\":\n        if (item.value.toLowerCase() === \"yes\") {\n          !jsonModelData.tracking.includes(\"open\") ??\n            jsonModelData.tracking.push(\"open\");\n        } else if (item.value.toLowerCase() === \"no\") {\n          jsonModelData.tracking = jsonModelData.tracking.filter(\n            (value) => value !== \"open\",\n          );\n        }\n        break;\n\n      case \"trackClicks\":\n        if (item.value.toLowerCase() === \"yes\") {\n          if (!jsonModelData.tracking.includes(\"click\")) {\n            jsonModelData.tracking.push(\"click\");\n          }\n        } else if (item.value.toLowerCase() === \"no\") {\n          jsonModelData.tracking = jsonModelData.tracking.filter(\n            (value) => value !== \"click\",\n          );\n        }\n        break;\n    }\n  });\n  result = {\n    etag: `\"${assetDetail.$context.etag}\"`,\n    payload: {\n        ...assetDetail, jsonModel: JSON.stringify(jsonModelData)\n    }\n  }\n\n} else {\n  result = assetDetail;\n}\n\nreturn result;\n"
          },
          "diagram": {
            "x": 5000,
            "y": 9640
          },
          "outcomes": {
            "success": "1781649029888"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
