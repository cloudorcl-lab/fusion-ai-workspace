          "type": "CODE",
          "metadata": {
            "name": "Updated Automation Json Payload",
            "returnType": "object",
            "sourceCode": "let result = \"\";\ntry {\n  // Get mcpsQueryRef from GET_SEGMENT_PUBLISH_ID node\n  const items = $context.$nodes?.GET_SEGMENT_PUBLISH_ID?.$output?.items || [];\n  const mcpsQueryRef = items.length > 0 ? items[0]?.mcpsQueryRef || \"\" : \"\";\n\n  // Get the JSON model from GET_JSON_MODEL node\n  const jsonModel = $context.$nodes?.GET_JSON_MODEL?.$output?.result || {};\n\n  // Deep clone the jsonModel to avoid mutating original data\n  const updatedModel = JSON.parse(JSON.stringify(jsonModel));\n\n  // Find the stage with type \"segment\" and update configuration.segmentUniqueId\n  if (Array.isArray(updatedModel.stages)) {\n    for (let stage of updatedModel.stages) {\n      if (stage.type === \"segment\" && stage.configuration) {\n        stage.configuration.segmentUniqueId = mcpsQueryRef;\n        break; // Assuming only one segment stage needs update\n      }\n    }\n  }\n\n  // Return the updated JSON model as string\n  result = JSON.stringify(updatedModel);\n} catch (error) {\n  result = \"\";\n}\n\nreturn result;"
          },
          "diagram": {
            "x": 8933.5,
            "y": 8939
          },
          "outcomes": {
            "success": "1781848298513"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
