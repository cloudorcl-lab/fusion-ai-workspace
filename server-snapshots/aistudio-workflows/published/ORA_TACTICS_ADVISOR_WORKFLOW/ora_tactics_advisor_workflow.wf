            "sourceCode": "let result = {};\nlet action = $context.$nodes.GET_FORM_DETAILS.$output.result.submitAction;\n\nif (action === \"emailSettings\")\n  result = $context.$nodes.UPDATE_EMAIL_WITH_FORM_DATA.$output.result\n\nif (action === \"lpSettings\")\n  result = $context.$nodes.UPDATE_LP_WITH_FORM_DATA.$output.result\n\nreturn result;\n"
          },
