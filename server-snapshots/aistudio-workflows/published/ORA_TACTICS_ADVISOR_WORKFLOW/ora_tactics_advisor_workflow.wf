        {
          "id": "1781672147298",
          "code": "REFINE_JSON_DATA_FOR_PROOF",
          "type": "CODE",
          "metadata": {
            "name": "Refine JSON data for proof",
            "returnType": "object",
            "sourceCode": "let result;\ntry {\n  // Safely access the first asset detail item\n  let assetDetail = $context.$nodes.GET_ASSET_DETAILS?.$output?.items?.[0];\n  if (!assetDetail) {\n    // If no asset detail found, return a safe default object\n    result = {\n      limit: 1,\n      toAddresses: [],\n      message: {},\n      offset: 0\n    };\n  } else {\n    // Parse the entire jsonModel string safely\n    let jsonData = {};\n    try {\n      jsonData = JSON.parse(assetDetail.jsonModel);\n    } catch (parseError) {\n      // If parsing fails, fallback to empty object\n      jsonData = {};\n    }\n\n    let domain = assetDetail.domain;\n\n    // Compose the result object with entire jsonData included\n    result = {\n      limit: 1,\n      toAddresses: [],\n      message: { \n        ...jsonData,\n        id: assetDetail.id,\n        versionNumber: assetDetail.$context.etag,\n        domain \n      },\n      offset: 0\n    };\n  }\n} catch (error) {\n  // On any error, return safe default object\n  result = {\n    limit: 1,\n    toAddresses: [],\n    message: {},\n    offset: 0\n  };\n}\n\nreturn result;"
          },
          "diagram": {
            "x": 8463.5,
            "y": 9418
          },
          "outcomes": {
            "success": "1781672077464"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
