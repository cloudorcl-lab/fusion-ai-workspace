        {
          "id": "1781479393533",
          "code": "STRUCTURE_ASSET_CONTENT",
          "type": "CODE",
          "metadata": {
            "name": "Structure Asset content",
            "sourceCode": "let result = {};\ntry {\n  // Safely access asset details and form submit payload\n  let assetDetail = $context.$nodes?.FETCH_ASSET_DETAILS?.$output?.items?.[0];\n  let submitPayload =\n    $context.$nodes?.GET_FORM_DETAILS?.$output?.result?.submitPayload;\n\n  if (assetDetail && submitPayload) {\n    // Extract inner JSON if wrapped in <oraFormSubmit> tags\n    let payloadText = submitPayload.trim();\n    let tagMatch = payloadText.match(\n      /<oraFormSubmit\\b[^>]*>([\\s\\S]*)<\\/oraFormSubmit>/,\n    );\n    if (tagMatch) {\n      payloadText = tagMatch[1];\n    }\n\n    let newHtml = JSON.parse(payloadText).newValue;\n    let subjectLine = JSON.parse(assetDetail.jsonModel).subjectLine;\n    \n    result = {\n      id: assetDetail.id,\nchannel: assetDetail.channel,\n      etag: `\"${assetDetail.$context?.etag}\"`,\n      htmlContent: newHtml,\n      subjectLine: subjectLine || \"\"\n    };\n  } else {\n    result = {};\n  }\n  \n} catch (error) {\n  // On error, return empty object\n  result = {};\n}\n\nreturn result;\n",
            "returnType": "object",
            "description": ""
          },
