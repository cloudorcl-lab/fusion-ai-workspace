            "errorNodeId": "1775421000001",
            "name": "Prepare Expenditure Type Match Inputs",
            "language": "JAVASCRIPT",
            "returnType": "object",
            "sourceCode": "const cfg=$context.$nodes.PRJ_PJF_CODE_BUILD_RESOURCE_TYPE_REGISTRY.$output.result.expenditure_type||{};\nconst e=$context.$input.extractedResources&&Array.isArray($context.$input.extractedResources.resources)?$context.$input.extractedResources.resources:[];\nconst raw=$context.$nodes.PRJ_PJF_BO_FETCH_EXISTING_EXPENDITURE_TYPE_FORMAT_RESOURCES.$output.items||[];\nconst c=[],x=[];\nfor(const i of e){if(i&&i.ResourceType===cfg.resourceType)c.push(i);}\nfor(const i of raw){if(i&&Array.isArray(i.Elements)){for(const j of i.Elements){if(j)x.push(j);}}else if(i)x.push(i);}\nreturn {config:cfg,candidateResources:c,existingResources:x};"
          },
