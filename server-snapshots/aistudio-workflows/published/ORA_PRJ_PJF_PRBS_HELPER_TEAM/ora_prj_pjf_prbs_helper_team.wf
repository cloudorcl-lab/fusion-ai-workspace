            "language": "JAVASCRIPT",
            "returnType": "object",
            "sourceCode": "const ids=['PRJ_PJF_CODE_NORMALIZE_EXPENDITURE_TYPE_MATCH_RESULT','PRJ_PJF_CODE_BUILD_EMPTY_EXPENDITURE_TYPE_RESULT','PRJ_PJF_CODE_NORMALIZE_PROJECT_ROLE_MATCH_RESULT','PRJ_PJF_CODE_BUILD_EMPTY_PROJECT_ROLE_RESULT'],m=[],nr=[],seen={};for(const id of ids){const o=(($context.$nodes[id]||{}).$output)||{},p=o.result!==undefined?o.result:(o.output!==undefined?o.output:o);if(p&&typeof p==='object'){for(const x of p.matches||[])m.push(x);for(const x of p.newResources||[])nr.push(x);}else if(typeof p==='string')try{const j=JSON.parse(p)||{};for(const x of j.matches||[])m.push(x);for(const x of j.newResources||[])nr.push(x);}catch(e){}}const d=[];for(const x of m){const k=String(x&&x.Type||'')+'::'+(String(x&&x.Id||'')||String(x&&x.Name||'').toLowerCase().trim().replace(/\\s+/g,' '));if(!seen[k]){seen[k]=1;d.push(x);}}let rows='';if(!d.length)rows='<tr><td>-</td><td>No matches found</td><td>-</td></tr>';for(const x of d){rows+='<tr><td>'+String(x&&x.Type||'').replace(/&/g,'&').replace(/</g,'<').replace(/>/g,'>')+'</td><td>'+String(x&&x.Name||'').replace(/&/g,'&').replace(/</g,'<').replace(/>/g,'>')+'</td><td>'+(x&&x.PresentInExisting?'Yes':'No')+'</td></tr>';}const a=String($context.$input.rbsPrjAssignmentId||''),parts=[],pk={};let c=1;for(const x of nr){const k=JSON.stringify(x,Object.keys(x||{}).sort());if(!pk[k]){pk[k]=1;parts.push({id:'part'+c++,path:'/projectPlanningRbs/'+a+'/child/Elements',operation:'create',payload:x});}}return {AllowResourceChangesFlag:true,resources:d,htmlReport:'<table border=\"1\" cellspacing=\"0\" cellpadding=\"4\"><thead><tr><th>Type</th><th>Name</th><th>PresentInExisting</th></tr></thead><tbody>'+rows+'</tbody></table>',newResources:JSON.stringify({parts:parts})};"
