            "name": "Resolve Supported Formats",
            "language": "JAVASCRIPT",
            "returnType": "object",
            "sourceCode": "const src=$context.$nodes.PRJ_PJF_BO_FETCH_PRBS_FORMATS.$output.items||[];const byName={};for(const item of src){const list=item&&Array.isArray(item.Formats)?item.Formats:[item];for(const f of list){if(f&&f.FormatName){byName[String(f.FormatName).toLowerCase().trim()]={available:true,formatId:String(f.FormatId||'')};}}}return {expenditure_type:(byName['expenditure type']||{available:false,formatId:''}),project_role:(byName['project role']||{available:false,formatId:''})};"
          },
          "outcomes": {
