            "language": "JAVASCRIPT",
            "returnType": "object",
            "sourceCode": "const cfg=$context.$nodes.PRJ_PJF_CODE_BUILD_RESOURCE_TYPE_REGISTRY.$output.result.expenditure_type||{};\nconst defaults=cfg.normalizationDefaults||{};\nconst out=$context.$nodes.PRJ_PJF_LLM_MATCH_EXPENDITURE_TYPE_RESOURCES.$output||{};\nconst rawMatches=Array.isArray(out.matches)?out.matches:[];\nconst seen={},newSeen={},matches=[],newResources=[];\nfor(const item of rawMatches){\n  const name=String(item&&item.Name==null?'':item&&item.Name).trim();\n  if(!name)continue;\n  const type=String(item&&item.Type==null?\"\":item&&item.Type).trim()||String(defaults.typeLabel||cfg.typeLabel||'Expenditure Type');\n  const id=String(item&&item.Id==null?'':item&&item.Id).trim();\n  const present=(item&&item.PresentInExisting)===true||String(item&&item.PresentInExisting).toLowerCase()==='true';\n  const key=type+'::'+(id||name.toLowerCase().replace(/[.,;:\\/\\\\\\-_\\'\"()\\[\\]{}]+/g,' ').replace(/\\s+/g,' ').trim());\n  if(seen[key])continue;\n  seen[key]=1;\n  matches.push({Type:type,Id:id,Name:name,PresentInExisting:present});\n  if(!present){\n    const payload={ResourceClassName:String(defaults.resourceClassName||cfg.resourceClassName||'Financial resources'),FormatName:String(cfg.typeLabel||'Expenditure Type')};\n    payload[String(defaults.payloadFieldName||cfg.payloadFieldName||'ExpenditureTypeName')]=name;\n    const payloadKey=JSON.stringify(payload,Object.keys(payload).sort());\n    if(!newSeen[payloadKey]){newSeen[payloadKey]=1;newResources.push(payload);}\n  }\n}\nreturn {matches:matches,newResources:newResources};"
