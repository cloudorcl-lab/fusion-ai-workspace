            "sourceCode": "let data = $context.$nodes.FIN_AP_CODE_PREPROCESS_SUMMARY.$output.result \nconst str = typeof data === \"string\" ? data : JSON.stringify(data);\n\n// optional: normalize whitespace (slightly better estimate)\nconst cleaned = str.replace(/\\s+/g, \" \");\n\n// rough estimate: 1 token ≈ 4 characters\nconst tokenCount = Math.ceil(cleaned.length / 4);\nreturn tokenCount;"
