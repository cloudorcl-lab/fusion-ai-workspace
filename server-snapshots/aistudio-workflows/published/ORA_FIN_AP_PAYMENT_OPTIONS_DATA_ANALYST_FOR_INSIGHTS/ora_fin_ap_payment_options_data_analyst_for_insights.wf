          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "name": "Pre Process Extraction Data for Options",
            "returnType": "array",
            "sourceCode": "const input = $context.$nodes.FIN_AP_BO_FUNCTION_EXTRACT_BQL_FOR_OPTIONS.$output;\n\nconst output = Array.isArray(input)\n  ? input.map(item => {\n      // Create a shallow copy of the item\n      const newItem = {};\n      Object.keys(item).forEach(key => {\n        newItem[key] = item[key] === null ? \"\" : item[key];\n      });\n      return newItem;\n    })\n  : [];\n\nreturn output;"
          },
          "outcomes": {
            "success": "1766035142630"
          },
          "code": "FIN_AP_CODE_PRE_PROCESS_EXTRACTION_DATA_OPTIONS",
          "convergenceTargetId": "1764675221539",
          "id": "1765978489189",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Options Insight Router"
          },
          "outcomes": {
            "Installments or upcoming payment runs requiring readiness review": "1766402217433",
            "default": "add_default_1766035142630"
          },
          "code": "FIN_AP_SWITCH_OPTIONS_INSIGHT_ROUTER",
          "convergenceTargetId": "end",
          "id": "1766035142630",
          "inputs": [
            {
              "id": "1766035142632_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.insightContext.insightsName}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
            "name": "Process Payment Run Readiness For Options",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.FIN_AP_CODE_PRE_PROCESS_EXTRACTION_DATA_OPTIONS.$output.result;\nconst summaryText =($context.$variables.summary ?? \"\").toString().trim() ||\"Here are the details:\";\nconst observationColumnMap = {\n  \"Supplier offers accepted but installments remain unpaid\": [\n    \"Supplier\",\n    \"Invoice Count\",\n    \"Installment Count\",\n    \"Outstanding Balance\",\n    \"Offer Acceptance Date\"\n  ],\n  \"Invoices ready to pay have prepayments available to apply\": [\n    \"Supplier\",\n    \"Invoice Count\",\n    \"Installment Count\",\n    \"Outstanding Balance\",\n    \"Available Prepayment Amount\"\n  ],\n  \"Installments due this week in currency different from ledger\": [\n    \"Supplier\",\n    \"Invoice Count\",\n    \"Installment Count\",\n    \"Outstanding Balance\"\n  ],\n  \"Installments overdue by more than 30 days\": [\n    \"Supplier\",\n    \"Invoice Count\",\n    \"Installment Count\",\n    \"Outstanding Balance\"\n  ]\n};\n\n// Unique observations present in data\nconst observationsSet = [\n  ...new Set(\n    data.map(item => item[\"Observations\"]).filter(x => !!x)\n  )\n];\n\n// Show the 5-row message only if at least one observation has 5 or more rows\nconst hasObservationWithFiveOrMoreRows = observationsSet.some(observation =>\n  data.filter(\n    item => (item[\"Observations\"] || \"\").toLowerCase() === observation.toLowerCase()\n  ).length >= 5\n);\n\nconst tables = observationsSet.map((observation) => {\n  const matchedKey = Object.keys(observationColumnMap).find(\n    obKey => obKey.toLowerCase() === observation.toLowerCase()\n  );\n  const columns = matchedKey ? observationColumnMap[matchedKey] : [];\n  if (columns.length === 0) return null;\n\n  const rows = data\n    .filter(item => (item[\"Observations\"] || \"\").toLowerCase() === observation.toLowerCase())\n    .map(item => {\n      const row = {};\n      for (let i = 0; i < columns.length; i++) {\n        const col = columns[i];\n        if (col === \"Due Date\" || col === \"Offer Acceptance Date\") {\n          let val = item[col];\n          if (!val) {\n            row[col] = val;\n          } else if (/^\\d{4}-\\d{2}-\\d{2}$/.test(val)) {\n            row[col] = val;\n          } else {\n            const d = new Date(val);\n            if (!isNaN(d.valueOf())) {\n              const month = String(d.getMonth() + 1).padStart(2, \"0\");\n              const day = String(d.getDate()).padStart(2, \"0\");\n              row[col] = `${d.getFullYear()}-${month}-${day}`;\n            } else {\n              row[col] = val;\n            }\n          }\n        } else {\n          row[col] = item[col];\n        }\n      }\n      return row;\n    });\n\n  return {\n    type: \"table\",\n    heading: observation,\n    content: rows,\n    columnOrder: columns\n  };\n}).filter(Boolean);\n\n// Build summarizeData in final order with correct sequence values:\n// summary -> optional 5 row message -> tables -> suggestions\nconst summarizeData = [];\nlet sequence = 1;\n\nsummarizeData.push({\n  type: \"text\",\n  content: [summaryText],\n  sequence: sequence++\n});\n\nif (hasObservationWithFiveOrMoreRows) {\n  summarizeData.push({\n    type: \"text\",\n    content: [\"Showing up to 5 items below to keep this view focused.\"],\n    sequence: sequence++\n  });\n}\n\ntables.forEach(table => {\n  summarizeData.push({\n    ...table,\n    sequence: sequence++\n  });\n});\n\nsummarizeData.push({\n  type: \"actions\",\n  content: [\n    \"Collaborate offline to ensure payment readiness.\"\n  ],\n  sequence: sequence++\n});\n\nconst result = {\n  useSummarizationPrompt: false,\n  summarizeData\n};\n\nlet finalResult;\nif($context.$nodes.FIN_AP_BO_FUNCTION_EXTRACT_BQL_FOR_OPTIONS.$status  == \"failure\")\nreturn null;\nelse if (!Array.isArray(data) || data.length === 0) {\n  finalResult = {\n    useSummarizationPrompt: true,\n    summarizeData: [{\n      type: \"text\",\n      content: [\"This insight has been resolved. There’s nothing to review at the moment.\"],\n      sequence: 1\n    }]\n  };\n} else {\n  finalResult = result;\n}\n\nreturn finalResult.summarizeData;"
          },
          "outcomes": {
            "success": "1776967914709"
          },
          "code": "FIN_AP_CODE_PROCESS_PAYMENT_RUN_READINESS_FOR_OPTIONS",
          "id": "1766402217433",
