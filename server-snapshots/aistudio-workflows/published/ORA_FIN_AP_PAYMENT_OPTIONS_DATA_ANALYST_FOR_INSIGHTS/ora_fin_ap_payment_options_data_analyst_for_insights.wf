          },
          "code": "EXTRACT_SUMMARY_BQL_RESPONSE",
          "convergenceTargetId": "1776777288336",
          "id": "1776775128900",
          "inputs": [
            {
              "id": "1776775164224_1",
              "name": "extraction_query_json_object",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.insightContext.summaryBql}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Preprocess Summary",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.EXTRACT_SUMMARY_BQL_RESPONSE.$output || [];\n\nconst conditionConfig = {\n  \"Installments overdue by more than 30 days\": {\n    sortOrder: 1,\n    phrase: \"outstanding and overdue balances\",\n    sentenceType: \"overdue\"\n  },\n  \"Invoices ready to pay have prepayments available to apply\": {\n    sortOrder: 2,\n    phrase: \"ready to pay with prepayments available\",\n    sentenceType: \"prepayments\"\n  },\n  \"Supplier offers accepted but installments remain unpaid\": {\n    sortOrder: 3,\n    phrase: \"pending payment after offer acceptance\",\n    sentenceType: \"supplierOffers\"\n  },\n  \"Installments due this week in currency different from ledger\": {\n    sortOrder: 4,\n    phrase: \"due this week in a currency different from ledger\",\n    sentenceType: \"nonLedgerCurrency\"\n  }\n};\n\nconst toNumber = value => {\n  if (value === null || value === undefined || value === \"\") return 0;\n  return Number(value) || 0;\n};\n\nconst grouped = {};\n\nfor (const item of data) {\n  const condition = item[\"Business Condition\"];\n  const currency = item[\"Invoice Currency\"];\n  const config = conditionConfig[condition];\n\n  if (!config || !currency) {\n    continue;\n  }\n\n  if (!grouped[condition]) {\n    grouped[condition] = {\n      businessCondition: condition,\n      phrase: config.phrase,\n      sentenceType: config.sentenceType,\n      sortOrder: config.sortOrder,\n      totalInvoiceCount: 0,\n      totalInstallmentCount: 0,\n      currencies: {}\n    };\n  }\n\n  grouped[condition].totalInvoiceCount += toNumber(item[\"Invoice Count\"]);\n  grouped[condition].totalInstallmentCount += toNumber(item[\"Installment Count\"]);\n\n  if (!grouped[condition].currencies[currency]) {\n    grouped[condition].currencies[currency] = {\n      currency,\n      totalOutstandingBalance: 0\n    };\n  }\n\n  grouped[condition].currencies[currency].totalOutstandingBalance += toNumber(\n    item[\"Total Outstanding Balance\"]\n  );\n}\n\nconst result = Object.values(grouped)\n  .sort((a, b) => a.sortOrder - b.sortOrder)\n  .map(item => ({\n    phrase: item.phrase,\n    sentenceType: item.sentenceType,\n    invoiceCount: item.totalInvoiceCount,\n    installmentCount: item.totalInstallmentCount,\n    topCurrencies: Object.values(item.currencies)\n      .sort((a, b) => b.totalOutstandingBalance - a.totalOutstandingBalance)\n      .slice(0, 2)\n  }));\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776968827844"
          },
          "code": "FIN_AP_CODE_PREPROCESS_SUMMARY",
