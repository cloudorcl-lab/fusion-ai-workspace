{
  "workflowId": "300000331056445",
  "workflowCode": "ORA_SELFSERVICE_QUOTE_SUMMARIZATION_AGENT",
  "name": "SelfService Quote Summarization Agent",
  "description": "The SelfService Quote Summarization Agent quickly turns quote information into a simple, easy-to-read summary. It helps understand the overall quote at a glance, making review faster and decision-making easier.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
