        {
          "metadata": {
            "name": "Process Execution Most frequent payment rejection errors in the last 30 days",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.FIN_AP_CODE_PRE_PROCESS_EXTRACTION_DATA_EXECUTION.$output.result || [];\nconst summaryText =($context.$variables.summary ?? \"\").toString().trim() || \"Here are the details:\";\nconst columns = [\n  \"Rejection Reason\",\n  \"Payment File Count\",\n  \"Payment Count\"\n];\n\nlet finalResult;\n\nif ( $context.$nodes.FIN_AP_BO_FUNCTION_EXTRACT_BQL_FOR_EXECUTION.$status == 'failure')\nreturn null;\nelse if (!Array.isArray(data) || data.length === 0) {\n  finalResult = {\n    agentResponse: [{\n      type: \"text\",\n      content: [\"This insight has been resolved. There’s nothing to review at the moment.\"],\n      sequence: 1\n    }]\n  };\n} else {\n  const summarizedData = data.map((item) => {\n    const rec = {};\n    columns.forEach((col) => {\n      rec[col] = item[col];\n    });\n    return rec;\n  });\n\n  const showTopFiveMessage = summarizedData.length >= 5;\n\n  const agentResponse = [];\n  let seq = 1;\n\n  agentResponse.push({\n    type: \"text\",\n    content: [summaryText],\n    sequence: seq++\n  });\n\n  if (showTopFiveMessage) {\n    agentResponse.push({\n      type: \"text\",\n      content: [\"Showing up to 5 items below to keep this view focused.\"],\n      sequence: seq++\n    });\n  }\n\n  agentResponse.push({\n    type: \"table\",\n    heading: \"Recurring payment rejection errors in last 30 days\",\n    content: summarizedData,\n    sequence: seq++,\n    columnOrder: columns\n  });\n\n  agentResponse.push({\n    type: \"actions\",\n    content: [\n      \"Collaborate offline or verify setups to reduce repeated rejections.\"\n    ],\n    sequence: seq++\n  });\n\n  finalResult = { agentResponse };\n}\n\nreturn finalResult.agentResponse;"
          },
          "outcomes": {
            "success": "1769750707948"
          },
          "code": "FIN_AP_CODE_PROCESS_EXECUTION_MOST_FREQUENT_PAYMENT_REJECTION_ERRORS_IN_THE_LAST_30_DAYS",
          "id": "1768899905716",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
