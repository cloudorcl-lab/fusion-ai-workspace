            "Payments pending approval for more than 5 days": "1773727018313",
            "Payments with unresolved acknowledgments, rejections, or validation errors": "1768889362422",
            "Recurring payment rejection errors in last 30 days": "1768899905716",
            "Recurring card settlement errors in last 30 days": "1768892872158",
            "Payments remaining unsettled or unreconciled": "1776083815491",
            "Supplier financial profile requiring attention": "1779901461850"
          },
          "code": "FIN_AP_SWITCH_EXECUTION_INSIGHT_ROUTER",
          "convergenceTargetId": "end",
          "id": "1766035142630",
          "inputs": [
            {
              "id": "1766035142632_1",
              "name": "caseExpression",
              "type": "string",
