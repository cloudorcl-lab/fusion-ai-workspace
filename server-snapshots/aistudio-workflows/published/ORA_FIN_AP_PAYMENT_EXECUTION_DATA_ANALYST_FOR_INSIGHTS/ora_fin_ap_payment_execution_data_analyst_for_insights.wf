        {
          "metadata": {
            "name": "Process Execution Payments Remain Unsettled or Unreconciled",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.FIN_AP_CODE_PRE_PROCESS_EXTRACTION_DATA_EXECUTION.$output.result || [];\nconst summaryText =($context.$variables.summary ?? \"\").toString().trim() || \"Here are the details:\";\nconst allObservations = [\n  \"Payments not yet cleared and reconciled\",\n  \"Virtual card payments not cleared after more than 5 days\",\n  \"Virtual card authorization or settlement failed\",\n  \"Virtual cards that will expire in next 15 days\",\n  \"Virtual card payments that are cleared but not yet billed\",\n  \"Virtual card settlement amount differs from payment amount\",\n  \"Virtual card payment amount differs from card statement line\",\n  \"Payments with stop requested in past 7 days\",\n  \"Card statement lines that couldn't be matched to any payment\"\n].filter((obs) => data.some((row) => row.Observations === obs));\n\nconst observationColumnMap = {\n  \"Payments not yet cleared and reconciled\": [\n    \"Disbursement Bank\",\n    \"Payment Method\",\n    \"Payment Count\",\n    \"Payee Count\",\n    \"Total Payment Amount\"\n  ],\n  \"Virtual card payments not cleared after more than 5 days\": [\n    \"Supplier\",\n    \"Funding Card Account\",\n    \"Payment Count\",\n    \"Total Payment Amount\"\n  ],\n  \"Virtual card authorization or settlement failed\": [\n    \"Supplier\",\n    \"Funding Card Issuing Bank\",\n    \"Funding Card Account\",\n    \"Payment Count\",\n    \"Total Payment Amount\",\n    \"Decline Reason\"\n  ],\n  \"Virtual cards that will expire in next 15 days\": [\n     \"Supplier\",\n     \"Funding Card Account\",\n     \"Payment Count\",\n     \"Total Payment Amount\"\n  ],\n  \"Virtual card payments that are cleared but not yet billed\": [\n    \"Funding Card Issuing Bank\",\n    \"Funding Card Account\",\n    \"Payment Count\",\n    \"Payee Count\",\n    \"Total Payment Amount\",\n    \"Total Settlement Amount\"\n  ],\n  \"Virtual card settlement amount differs from payment amount\": [\n    \"Supplier\",\n    \"Funding Card Issuing Bank\",\n    \"Funding Card Account\",\n    \"Payment Count\",\n    \"Total Payment Amount\",\n    \"Total Settlement Amount\"\n  ],\n  \"Virtual card payment amount differs from card statement line\": [\n    \"Supplier\",\n    \"Funding Card Issuing Bank\",\n    \"Funding Card Account\",\n    \"Payment Count\",\n    \"Total Payment Amount\",\n    \"Total Settlement Amount\",\n    \"Total Billed Amount\"\n  ],\n  \"Payments with stop requested in past 7 days\": [\n    \"Supplier\",\n    \"Disbursement Bank\",\n    \"Funding Card Issuing Bank\",\n    \"Payment Method\",\n    \"Payment Count\",\n    \"Total Payment Amount\"\n  ],\n  \"Card statement lines that couldn't be matched to any payment\": [\n    \"Statement Date\",\n    \"Line Number\",\n    \"Line Amount\",\n    \"Funding Card Account\",\n    \"Funding Card Issuing Bank\",\n    \"Payment Reference\"\n  ]\n};\n\nconst formatDate = (val) => {\n  if (val === null || val === undefined || val === \"\") {\n    return \"\";\n  }\n  if (typeof val === \"string\" && /^\\d{4}-\\d{2}-\\d{2}$/.test(val)) {\n    return val;\n  }\n  const d = new Date(val);\n  if (!isNaN(d.valueOf())) {\n    const month = String(d.getMonth() + 1).padStart(2, \"0\");\n    const day = String(d.getDate()).padStart(2, \"0\");\n    return `${d.getFullYear()}-${month}-${day}`;\n  }\n  return val;\n};\n\nlet finalResult;\n\nif ( $context.$nodes.FIN_AP_BO_FUNCTION_EXTRACT_BQL_FOR_EXECUTION.$status == 'failure')\nreturn null;\nelse if (!Array.isArray(data) || data.length === 0) {\n  finalResult = {\n    agentResponse: [\n      {\n        type: \"text\",\n        content: [\n          \"This insight has been resolved. There’s nothing to review at the moment.\"\n        ],\n        sequence: 1\n      }\n    ]\n  };\n} else {\n  const rawTables = allObservations.map((obs) => {\n    const columns = observationColumnMap[obs];\n    if (!columns) return null;\n\n    const rowsForObs = data.filter((row) => row.Observations === obs);\n\n    const formattedRows = rowsForObs.map((item) => {\n      const entry = {};\n\n      columns.forEach((col) => {\n        let val = item[col];\n\n        if (col === \"Payment Number\" && val) {\n          const paymentId = item.PAYMENTID;\n          entry[col] = paymentId\n            ? `{deeplink:{objType:AP_VIEWPAYMENT,action:VIEW,objKey:CheckId=${paymentId},text:${val}}}`\n            : val;\n        } else if (\n          col === \"Payment Date\" ||\n          col === \"Cleared Date\" ||\n          col === \"Stop Date\" ||\n          col === \"Statement Date\"\n        ) {\n          entry[col] = formatDate(val);\n        } else if (val === null || val === undefined || val === \"\") {\n          entry[col] = \"\";\n        } else {\n          entry[col] = val;\n        }\n      });\n\n      return entry;\n    });\n\n    return {\n      type: \"table\",\n      heading: obs,\n      content: formattedRows,\n      columnOrder: columns\n    };\n  }).filter(Boolean);\n\n  const showTopFiveMessage = rawTables.some((table) => Array.isArray(table.content) && table.content.length >= 5);\n\n  const agentResponse = [];\n  let seq = 1;\n\n  agentResponse.push({\n    type: \"text\",\n    content: [summaryText],\n    sequence: seq++\n  });\n\n  if (showTopFiveMessage) {\n    agentResponse.push({\n      type: \"text\",\n      content: [\"Showing up to 5 items below to keep this view focused.\"],\n      sequence: seq++\n    });\n  }\n\n  rawTables.forEach((table) => {\n    agentResponse.push({\n      ...table,\n      sequence: seq++\n    });\n  });\n\n  agentResponse.push({\n    type: \"actions\",\n    content: [\n      \"Collaborate offline to understand settlement issues or reconciliation delays.\"\n    ],\n    sequence: seq++\n  });\n\n  finalResult = {\n    agentResponse\n  };\n}\n\nreturn finalResult.agentResponse;"
          },
          "outcomes": {
            "success": "1776085824717"
          },
          "code": "FIN_AP_PROCESS_EXECUTION_PAYMENTS_REMAIN_UNSETTLED_OR_UNRECONCILED",
          "id": "1776083815491",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Return Execution Payments remaining unsettled or unreconciled"
          },
          "outcomes": {},
          "code": "FIN_AP_RETURN_EXECUTION_PAYMENTS_REMAINING_UNSETTLED_OR_UNRECONCILED",
          "convergenceTargetId": "1773726838943",
          "id": "1776085824717",
          "inputs": [
            {
              "id": "1776085824718_1",
              "name": "returnValue",
              "type": "string",
              "value": "{{$context.$nodes.FIN_AP_PROCESS_EXECUTION_PAYMENTS_REMAIN_UNSETTLED_OR_UNRECONCILED.$output.result}}"
            }
