        {
          "metadata": {
            "name": "Process Execution Payments with unresolved acknowledgments, rejections, or validation errors",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.FIN_AP_CODE_PRE_PROCESS_EXTRACTION_DATA_EXECUTION.$output.result || [];\nconst summaryText =($context.$variables.summary ?? \"\").toString().trim() || \"Here are the details:\";\n\nconst observationColumnMap = {\n  \"Payment files rejected in acknowledgment\": [\n    \"Payment File Reference\",\n    \"Payment File Status\",\n    \"Payment Process Request\",\n    \"Payment Date\",\n    \"Termination Date\",\n    \"Payments Recorded\",\n    \"Disbursement Bank\",\n    \"Funding Card Account\",\n    \"Payment Process Profile\",\n    \"Inbound File Name\",\n    \"Inbound File Status\"\n  ],\n  \"Payment files pending action due to acknowledgment failure\": [\n    \"Payment File Reference\",\n    \"Payment File Status\",\n    \"Payment Process Request\",\n    \"Payment Date\",\n    \"Payments Recorded\",\n    \"Disbursement Bank\",\n    \"Funding Card Account\",\n    \"Payment Process Profile\",\n    \"Inbound File Status\"\n  ],\n  \"Payment files partially acknowledged\": [\n    \"Payment File Reference\",\n    \"Payment File Status\",\n    \"Payment Process Request\",\n    \"Payment Date\",\n    \"Payments Recorded\",\n    \"Disbursement Bank\",\n    \"Funding Card Account\",\n    \"Payment Process Profile\",\n    \"Inbound File Name\",\n    \"Inbound File Status\"\n  ],\n  \"Payment files pending acknowledgment for more than 24 hours\": [\n    \"Payment File Reference\",\n    \"Payment File Status\",\n    \"Payment Process Request\",\n    \"Payment Date\",\n    \"Payments Recorded\",\n    \"Disbursement Bank\",\n    \"Funding Card Account\",\n    \"Payment Process Profile\"\n  ],\n  \"Payments rejected in acknowledgment\": [\n    \"Payment Business Unit\",\n    \"Payment Reference\",\n    \"Payment Process Request\",\n    \"Payment Date\",\n    \"Amount\",\n    \"Payee\",\n    \"Payment Method\",\n    \"Error Reason\",\n    \"Additional Information\"\n  ],\n  \"Payments failed validation\": [\n    \"Payment Business Unit\",\n    \"Payment Process Request\",\n    \"Payment Date\",\n    \"Amount\",\n    \"Payee\",\n    \"Payment Method\",\n    \"Error Reason\"\n  ]\n};\n\nconst bankColumns = [\"Disbursement Bank\", \"Funding Card Account\"];\n\nconst columnAliases = {\n  \"Funding Card Account\": [\"Funding Card Account\", \"Funding Card Issuing Bank\"]\n};\n\nconst isBlankValue = (val) =>\n  val === null ||\n  val === undefined ||\n  (typeof val === \"string\" && (val.trim() === \"\" || val.trim() === \"-\"));\n\nconst getColumnValue = (row, col) => {\n  const aliases = columnAliases[col] || [col];\n\n  for (const alias of aliases) {\n    const val = row[alias];\n    if (!isBlankValue(val)) {\n      return val;\n    }\n  }\n\n  return row[col];\n};\n\nconst formatDate = (val) => {\n  if (!val) {\n    return val;\n  }\n  if (typeof val === \"string\" && /^\\d{4}-\\d{2}-\\d{2}/.test(val)) {\n    return val.substring(0, 10);\n  }\n  const d = new Date(val);\n  if (!isNaN(d.valueOf())) {\n    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, \"0\")}-${String(d.getDate()).padStart(2, \"0\")}`;\n  }\n  return val;\n};\n\nconst getVisibleColumns = (cols, rows) => {\n  return cols.filter((col) => {\n    if (!bankColumns.includes(col)) {\n      return true;\n    }\n\n    return rows.some((row) => !isBlankValue(getColumnValue(row, col)));\n  });\n};\n\nlet finalResult;\n\nif ( $context.$nodes.FIN_AP_BO_FUNCTION_EXTRACT_BQL_FOR_EXECUTION.$status == 'failure')\nreturn null;\nelse if (!Array.isArray(data) || data.length === 0) {\n  finalResult = {\n    agentResponse: [{\n      type: \"text\",\n      content: [\"This insight has been resolved. There’s nothing to review at the moment.\"],\n      sequence: 1\n    }]\n  };\n} else {\n  const uniqueObs = [...new Set(data.map((row) => row.Observations))];\n\n  const rawTables = uniqueObs.map((obs) => {\n    const baseCols = observationColumnMap[obs];\n    if (!baseCols) return null;\n\n    const group = data.filter((row) => row.Observations === obs);\n    const cols = getVisibleColumns(baseCols, group);\n\n    const formattedRows = group.map((item) => {\n      const entry = {};\n\n      cols.forEach((col) => {\n        let val = getColumnValue(item, col);\n\n        if (col.includes(\"Date\")) {\n          val = formatDate(val);\n        }\n\n        if (bankColumns.includes(col) && isBlankValue(val)) {\n          val = \"-\";\n        }\n\n        if (col === \"Payment File Reference\" && val) {\n          entry[col] = `{deeplink:{objType:AP_VIEWPAYMENTFILE,action:VIEW,objKey:paymentInstructionId=${item[\"Payment File Reference\"]},text:${item[\"Payment File Reference\"]}}}`;\n        } else {\n          entry[col] = val;\n        }\n      });\n\n      return entry;\n    });\n\n    return {\n      type: \"table\",\n      heading: obs,\n      content: formattedRows,\n      columnOrder: cols\n    };\n  }).filter(Boolean);\n\n  const showTopFiveMessage = rawTables.some((table) => Array.isArray(table.content) && table.content.length >= 5);\n\n  const agentResponse = [];\n  let seq = 1;\n\n  agentResponse.push({\n    type: \"text\",\n    content: [summaryText],\n    sequence: seq++\n  });\n\n  if (showTopFiveMessage) {\n    agentResponse.push({\n      type: \"text\",\n      content: [\"Showing up to 5 items below to keep this view focused.\"],\n      sequence: seq++\n    });\n  }\n\n  rawTables.forEach((table) => {\n    agentResponse.push({\n      ...table,\n      sequence: seq++\n    });\n  });\n\n  agentResponse.push({\n    type: \"actions\",\n    content: [\n      \"Use links in the table to review details and take appropriate actions.\"\n    ],\n    sequence: seq++\n  });\n\n  finalResult = { agentResponse };\n}\n\nreturn finalResult.agentResponse;"
          },
          "outcomes": {
            "success": "1769750436213"
          },
          "code": "FIN_AP_CODE_PROCESS_EXECUTION_PAYMENTS_WITH_UNRESOLVED_ACKNOWLEDGMENTS_REJECTIONS_OR_VALIDATION_ERRORS",
