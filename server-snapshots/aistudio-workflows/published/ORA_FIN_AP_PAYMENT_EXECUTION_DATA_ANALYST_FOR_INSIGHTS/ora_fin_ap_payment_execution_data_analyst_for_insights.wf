        {
          "metadata": {
            "name": "Process Financial Profile Requiring Attention",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.FIN_AP_CODE_PRE_PROCESS_EXTRACTION_DATA_EXECUTION.$output.result || [];\nconst summaryText =($context.$variables.summary ?? \"\").toString().trim() || \"Here are the details:\";\n\n\nconst allObservations = [\n  \"Recipient emails missing for supplier offer communication\",\n  \"Supplier sites on payment hold with due or overdue invoices\",\n].filter((obs) => Array.isArray(data) && data.some((row) => row.Observations === obs));\n\nconst observationColumnMap = {\n  \"Recipient emails missing for supplier offer communication\": [\n    \"Supplier or Party\",\n    \"Installment Count\",\n    \"Outstanding Balance\",\n  ],\n  \"Supplier sites on payment hold with due or overdue invoices\": [\n    \"Supplier or Party\",\n    \"Supplier Site\",\n    \"Installment Count\",\n    \"Outstanding Balance\",\n    \"On Hold Since\",\n    \"Hold Reason\",\n  ],\n};\n\nconst formatDate = (val) => {\n  if (val === null || val === undefined || val === \"\") {\n    return val;\n  }\n\n  if (typeof val === \"string\" && /^\\d{4}-\\d{2}-\\d{2}$/.test(val)) {\n    return val;\n  }\n\n  const d = new Date(val);\n  if (!isNaN(d.valueOf())) {\n    const month = String(d.getMonth() + 1).padStart(2, \"0\");\n    const day = String(d.getDate()).padStart(2, \"0\");\n    return `${d.getFullYear()}-${month}-${day}`;\n  }\n\n  return val;\n};\n\nlet finalResult;\n\nif ( $context.$nodes.FIN_AP_BO_FUNCTION_EXTRACT_BQL_FOR_EXECUTION.$status == 'failure')\nreturn null;\nelse if (!Array.isArray(data) || data.length === 0) {\n  finalResult = {\n    agentResponse: [\n      {\n        type: \"text\",\n        content: [\n          \"This insight has been resolved. There’s nothing to review at the moment.\",\n        ],\n        sequence: 1,\n      },\n    ],\n  };\n} else {\n  const rawTables = allObservations\n    .map((obs) => {\n      const columns = observationColumnMap[obs];\n      if (!columns) return null;\n\n      const rowsForObs = data.filter((row) => row.Observations === obs);\n\n      const formattedRows = rowsForObs.map((item) => {\n        const entry = {};\n\n        columns.forEach((col) => {\n          let val = item[col];\n\n          if (\n            col === \"Due Date\" ||\n            col === \"Offer Acceptance Date\" ||\n            col === \"On Hold Since\"\n          ) {\n            val = formatDate(val);\n          }\n\n          entry[col] = val;\n        });\n\n        return entry;\n      });\n\n      return {\n        type: \"table\",\n        heading: obs,\n        content: formattedRows,\n        columnOrder: columns,\n      };\n    })\n    .filter(Boolean);\n\n  const showTopFiveMessage = rawTables.some((table) => Array.isArray(table.content) && table.content.length >= 5);\n\n  const agentResponse = [];\n  let seq = 1;\n\n  agentResponse.push({\n    type: \"text\",\n    content: [summaryText],\n    sequence: seq++\n  });\n\n  if (showTopFiveMessage) {\n    agentResponse.push({\n      type: \"text\",\n      content: [\"Showing up to 5 items below to keep this view focused.\"],\n      sequence: seq++\n    });\n  }\n\n  rawTables.forEach((table) => {\n    agentResponse.push({\n      ...table,\n      sequence: seq++\n    });\n  });\n\n  agentResponse.push({\n    type: \"actions\",\n    content: [\n      \"Collaborate offline to get the supplier financial profile updated.\"\n    ],\n    sequence: seq++,\n  });\n\n  finalResult = {\n    agentResponse,\n  };\n}\n\nreturn finalResult.agentResponse;"
          },
          "outcomes": {
            "success": "1779901526280"
          },
          "code": "FIN_AP_CODE_PROCESS_FINANCIAL_PROFILE_REQUIRING_ATTENTION",
