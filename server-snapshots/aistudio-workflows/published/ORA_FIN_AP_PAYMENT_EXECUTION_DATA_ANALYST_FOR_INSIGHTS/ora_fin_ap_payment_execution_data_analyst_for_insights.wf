        {
          "metadata": {
            "name": "Process payments pending approval for more than 5 days",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.FIN_AP_CODE_PRE_PROCESS_EXTRACTION_DATA_EXECUTION.$output.result || [];\nconst summaryText =($context.$variables.summary ?? \"\").toString().trim() || \"Here are the details:\";\n\nconst observationColumnMap = {\n  \"Payments pending approval for more than 5 days\": [\n    \"Payment Process Request\",\n    \"Payment Process Request Status\",\n    \"Payment Date\",\n    \"Payment Count\",\n    \"Installment Count\"\n  ]\n};\n\nconst requestBasedObservations = [\n  \"Payments pending approval for more than 5 days\"\n];\n\nconst formatDate = (val) => {\n  if (!val) {\n    return val;\n  }\n  if (typeof val === \"string\" && /^\\d{4}-\\d{2}-\\d{2}/.test(val)) {\n    return val.substring(0, 10);\n  }\n  const d = new Date(val);\n  if (!isNaN(d.valueOf())) {\n    const month = String(d.getMonth() + 1).padStart(2, \"0\");\n    const day = String(d.getDate()).padStart(2, \"0\");\n    return `${d.getFullYear()}-${month}-${day}`;\n  }\n  return val;\n};\n\nconst buildPprObjKey = (item) => {\n  let objKey = `checkrunId=${item.checkrunid}`;\n  objKey = item.paymentProcessRequestId\n    ? objKey + `;pmtProcessRequestId=${item.paymentProcessRequestId}`\n    : objKey;\n  return objKey;\n};\n\nlet finalResult;\n\nif ( $context.$nodes.FIN_AP_BO_FUNCTION_EXTRACT_BQL_FOR_EXECUTION.$status == 'failure')\nreturn null;\nelse if (!Array.isArray(data) || data.length === 0) {\n  finalResult = {\n    agentResponse: [{\n      type: \"text\",\n      content: [\"This insight has been resolved. There’s nothing to review at the moment.\"],\n      sequence: 1\n    }]\n  };\n} else {\n  const observationsSet = [];\n  for (let i = 0; i < data.length; i++) {\n    const obs = data[i][\"Observations\"];\n    if (obs && !observationsSet.includes(obs)) {\n      observationsSet.push(obs);\n    }\n  }\n\n  const rawTables = [];\n  for (let oidx = 0; oidx < observationsSet.length; oidx++) {\n    const observation = observationsSet[oidx];\n    const columns = observationColumnMap[observation];\n    if (!columns) continue;\n\n    const rows = [];\n    for (let j = 0; j < data.length; j++) {\n      const item = data[j];\n      if (item[\"Observations\"] !== observation) continue;\n\n      const row = {};\n      let pprValue = item[\"Payment Process Request\"];\n      let pprStatusValue = item[\"Payment Process Request Status\"];\n\n      if (requestBasedObservations.includes(observation)) {\n        pprValue = `{deeplink:{objType:AP_VIEWPPR,action:VIEW,objKey:${buildPprObjKey(item)},text:${item[\"Payment Process Request\"]}}}`;\n      }\n\n      pprStatusValue = `{deeplink:{objType:AP_PPRACTION,action:EDIT,objKey:${buildPprObjKey(item)},text:${item[\"Payment Process Request Status\"]}}}`;\n\n      for (let k = 0; k < columns.length; k++) {\n        const col = columns[k];\n        if (col === \"Payment Process Request\") {\n          row[col] = pprValue;\n        } else if (col === \"Payment Process Request Status\") {\n          row[col] = pprStatusValue;\n        } else if (col === \"Payment Date\") {\n          row[col] = formatDate(item[col]);\n        } else {\n          row[col] = item[col];\n        }\n      }\n\n      rows.push(row);\n    }\n\n    rawTables.push({\n      type: \"table\",\n      heading: observation,\n      content: rows,\n      columnOrder: columns\n    });\n  }\n\n  const showTopFiveMessage = rawTables.some((table) => Array.isArray(table.content) && table.content.length >= 5);\n\n  const agentResponse = [];\n  let seq = 1;\n\n  agentResponse.push({\n    type: \"text\",\n    content: [summaryText],\n    sequence: seq++\n  });\n\n  if (showTopFiveMessage) {\n    agentResponse.push({\n      type: \"text\",\n      content: [\"Showing up to 5 items below to keep this view focused.\"],\n      sequence: seq++\n    });\n  }\n\n  rawTables.forEach((table) => {\n    agentResponse.push({\n      ...table,\n      sequence: seq++\n    });\n  });\n\n  agentResponse.push({\n    type: \"actions\",\n    content: [\n      \"Use links in the table to review details and take appropriate actions.\"\n    ],\n    sequence: seq++\n  });\n\n  finalResult = { agentResponse };\n}\n\nreturn finalResult.agentResponse;"
          },
