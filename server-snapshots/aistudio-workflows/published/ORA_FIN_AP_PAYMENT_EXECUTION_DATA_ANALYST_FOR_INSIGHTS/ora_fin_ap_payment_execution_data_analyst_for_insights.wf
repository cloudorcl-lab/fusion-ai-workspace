            }
          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
            "name": "Process Execution Payment Runs Requiring Attention",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.FIN_AP_CODE_PRE_PROCESS_EXTRACTION_DATA_EXECUTION.$output.result;\nconst summaryText =($context.$variables.summary ?? \"\").toString().trim() ||\"Here are the details:\";\n\n// Hardcoded mapping from your HTML table (columns with '-' omitted)\nconst observationColumnMap = {\n  \"Payment process requests need more information\": [\n    \"Payment Process Request\",\n    \"Payment Process Request Status\",\n    \"Payment Date\",\n    \"Pending Since\"\n  ],\n  \"Payment process requests pending installments review\": [\n    \"Payment Process Request\",\n    \"Payment Process Request Status\",\n    \"Payment Date\",\n    \"Pending Since\"\n  ],\n  \"Payment files that failed transmission\": [\n    \"Payment Process Request\",\n    \"Payment Process Request Status\",\n    \"Payment Date\",\n    \"Pending Since\",\n    \"Payment File Reference\",\n    \"Payment File Status\"\n  ],\n  \"Payment process requests failed document validation\": [\n    \"Payment Process Request\",\n    \"Payment Process Request Status\",\n    \"Payment Date\",\n    \"Termination Date\"\n  ],\n  \"Payment files failed formatting and pending action\": [\n    \"Payment Process Request\",\n    \"Payment Process Request Status\",\n    \"Payment Date\",\n    \"Pending Since\",\n    \"Payment File Reference\",\n    \"Payment File Status\"\n  ],\n  \"Payment process requests failed payment validation\": [\n    \"Payment Process Request\",\n    \"Payment Process Request Status\",\n    \"Payment Date\",\n    \"Termination Date\"\n  ],\n  \"Payment process requests missing cross-currency rates\": [\n    \"Payment Process Request\",\n    \"Payment Process Request Status\",\n    \"Payment Date\",\n    \"Pending Since\"\n  ],\n  \"Payment process requests pending proposed payment review\": [\n    \"Payment Process Request\",\n    \"Payment Process Request Status\",\n    \"Payment Date\",\n    \"Pending Since\"\n  ],\n  \"Payment process requests pending to resolve document errors\": [\n    \"Payment Process Request\",\n    \"Payment Process Request Status\",\n    \"Payment Date\",\n    \"Pending Since\"\n  ],\n  \"Payment process requests missing payment conversion rates\": [\n    \"Payment Process Request\",\n    \"Payment Process Request Status\",\n    \"Payment Date\",\n    \"Pending Since\"\n  ],\n  \"Payment process requests pending to resolve payment errors\": [\n    \"Payment Process Request\",\n    \"Payment Process Request Status\",\n    \"Payment Date\",\n    \"Pending Since\"\n  ],\n  \"Payment files formatted and ready for printing\": [\n    \"Payment Process Request\",\n    \"Payment Process Request Status\",\n    \"Payment Date\",\n    \"Pending Since\",\n    \"Payment File Reference\",\n    \"Payment File Status\"\n  ],\n  \"Payment files submitted for printing awaiting confirmation\": [\n    \"Payment Process Request\",\n    \"Payment Process Request Status\",\n    \"Payment Date\",\n    \"Pending Since\",\n    \"Payment File Reference\",\n    \"Payment File Status\"\n  ],\n  \"Payment process requests waiting for payment file creation\": [\n    \"Payment Process Request\",\n    \"Payment Process Request Status\",\n    \"Payment Date\",\n    \"Pending Since\"\n  ],\n  \"Payment files formatted and ready for transmission\": [\n    \"Payment Process Request\",\n    \"Payment Process Request Status\",\n    \"Payment Date\",\n    \"Pending Since\",\n    \"Payment File Reference\",\n    \"Payment File Status\"\n  ],\n  \"Payment files created and pending action\": [\n    \"Payment Process Request\",\n    \"Payment Process Request Status\",\n    \"Payment Date\",\n    \"Pending Since\",\n    \"Payment File Reference\",\n    \"Payment File Status\"\n  ],\n  \"Payment files with validation failures and pending action\": [\n    \"Payment Process Request\",\n    \"Payment Process Request Status\",\n    \"Payment Date\",\n    \"Pending Since\",\n    \"Payment File Reference\",\n    \"Payment File Status\"\n  ],\n  \"Payment files ready for recording check print status\": [\n    \"Payment Process Request\",\n    \"Payment Process Request Status\",\n    \"Payment Date\",\n    \"Pending Since\",\n    \"Payment File Reference\",\n    \"Payment File Status\"\n  ],\n  \"Payments pending confirmation\": [\n    \"Payment Process Request\",\n    \"Payment Process Request Status\",\n    \"Payment Date\",\n    \"Pending Since\",\n    \"Payment File Reference\",\n    \"Payment File Status\"\n  ]\n};\n\n// For deeplink logic\nconst fileBasedObservations = [\n  \"Payment files failed formatting and pending action\",\n  \"Payment files that failed transmission\",\n  \"Payment files formatted and ready for printing\",\n  \"Payment files submitted for printing awaiting confirmation\",\n  \"Payment files formatted and ready for transmission\",\n  \"Payment files created and pending action\",\n  \"Payment files with validation failures and pending action\",\n  \"Payment files ready for recording check print status\",\n  \"Payments pending confirmation\"\n];\n\nconst requestBasedObservations = [\n  \"Payment process requests failed document validation\",\n  \"Payment process requests failed payment validation\",\n  \"Payment process requests missing cross-currency rates\",\n  \"Payment process requests pending installments review\",\n  \"Payment process requests need more information\",\n  \"Payment process requests pending proposed payment review\",\n  \"Payment process requests pending to resolve document errors\",\n  \"Payment process requests missing payment conversion rates\",\n  \"Payment process requests pending to resolve payment errors\",\n  \"Payment process requests waiting for payment file creation\"\n];\n\n// Status code sets for deeplinks\nconst pprStatusCodesForDeeplink = new Set([\n  \"PENDING_REVIEW_PMT_VAL_ERRORS\",\n  \"PENDING_REVIEW\",\n  \"ORA_REQUIRE_APPROVAL\",\n  \"ORA_APPROVAL_INITIATED\",\n  \"ORA_APPROVED\",\n  \"ORA_APPROVAL_ERROR\",\n  \"ORA_APPROVAL_WITHDRAWN\",\n  \"PENDING_REVIEW_DOC_VAL_ERRORS\",\n  \"REVIEW\",\n  \"MISSING RATES\",\n  \"MISSING_X_RATES\",\n  \"INFORMATION_REQUIRED\"\n]);\n\nconst paymentFileStatusCodesForDeeplink = new Set([\n  \"PENDING_ACK\",\n  \"CREATED\",\n  \"CREATED_READY_FOR_FORMATTING\",\n  \"CREATED_READY_FOR_PRINTING\",\n  \"CREATION_ERROR\",\n  \"FORMATTED\",\n  \"FORMATTED_READY_FOR_PRINTING\",\n  \"FORMATTED_READY_TO_TRANSMIT\",\n  \"FORMATTING_FAILED\",\n  \"PENDING_ACTION_ACK_FAILURE\",\n  \"SUBMITTED_FOR_PRINTING\",\n  \"TRANSMISSION_FAILED\",\n  \"FORMATTED_ELECTRONIC\",\n  \"TRANSMITTED\",\n  \"PRINTED\"\n]);\n\nconst formatDate = (val) => {\n  if (!val) {\n    return val;\n  }\n  if (typeof val === \"string\" && /^\\d{4}-\\d{2}-\\d{2}/.test(val)) {\n    return val.substring(0, 10);\n  }\n  const d = new Date(val);\n  if (!isNaN(d.valueOf())) {\n    const month = String(d.getMonth() + 1).padStart(2, \"0\");\n    const day = String(d.getDate()).padStart(2, \"0\");\n    return `${d.getFullYear()}-${month}-${day}`;\n  }\n  return val;\n};\n\nconst buildPprObjKey = (item) => {\n  let objKey = `checkrunId=${item.checkrunid}`;\n  objKey = item.paymentProcessRequestId\n    ? objKey + `;pmtProcessRequestId=${item.paymentProcessRequestId}`\n    : objKey;\n  return objKey;\n};\n\nlet finalResult;\nif ( $context.$nodes.FIN_AP_BO_FUNCTION_EXTRACT_BQL_FOR_EXECUTION.$status == 'failure')\nreturn null;\nelse if (!Array.isArray(data) || data.length === 0) {\n  finalResult = {\n    agentResponse: [\n      {\n        type: \"text\",\n        content: [\"This insight has been resolved. There’s nothing to review at the moment.\"],\n        sequence: 1\n      }\n    ]\n  };\n} else {\n  const observationsSet = [];\n  for (let i = 0; i < data.length; i++) {\n    const obs = data[i][\"Observations\"];\n    if (obs && !observationsSet.includes(obs)) {\n      observationsSet.push(obs);\n    }\n  }\n\n  const rawTables = [];\n  for (let oidx = 0; oidx < observationsSet.length; oidx++) {\n    const observation = observationsSet[oidx];\n    const columns = observationColumnMap[observation];\n    if (!columns) continue;\n\n    const rows = [];\n    for (let j = 0; j < data.length; j++) {\n      const item = data[j];\n      if (item[\"Observations\"] !== observation) continue;\n\n      const row = {};\n      let pprValue = item[\"Payment Process Request\"];\n      let pprStatusValue = item[\"Payment Process Request Status\"];\n      let fileRefValue = item[\"Payment File Reference\"];\n      let fileStatusValue = item[\"Payment File Status\"];\n\n      if (fileBasedObservations.includes(observation) || requestBasedObservations.includes(observation)) {\n        pprValue = `{deeplink:{objType:AP_VIEWPPR,action:VIEW,objKey:${buildPprObjKey(item)},text:${item[\"Payment Process Request\"]}}}`;\n      }\n\n      if (pprStatusCodesForDeeplink.has(item[\"Payment Process Request Status Code\"])) {\n        pprStatusValue = `{deeplink:{objType:AP_PPRACTION,action:EDIT,objKey:${buildPprObjKey(item)},text:${item[\"Payment Process Request Status\"]}}}`;\n      }\n\n      if (fileBasedObservations.includes(observation)) {\n        fileRefValue = `{deeplink:{objType:AP_VIEWPAYMENTFILE,action:VIEW,objKey:paymentInstructionId=${item[\"Payment File Reference\"]},text:${item[\"Payment File Reference\"]}}}`;\n      }\n\n      if (paymentFileStatusCodesForDeeplink.has(item[\"Payment File Status Code\"])) {\n        fileStatusValue = `{deeplink:{objType:AP_PAYMENTFILEACTION,action:EDIT,objKey:paymentInstructionId=${item[\"Payment File Reference\"]},text:${item[\"Payment File Status\"]}}}`;\n      }\n\n      for (let k = 0; k < columns.length; k++) {\n        const col = columns[k];\n        if (col === \"Payment Process Request\") {\n          row[col] = pprValue;\n        } else if (col === \"Payment Process Request Status\") {\n          row[col] = pprStatusValue;\n        } else if (col === \"Payment File Reference\") {\n          row[col] = fileRefValue;\n        } else if (col === \"Payment File Status\") {\n          row[col] = fileStatusValue;\n        } else if (col === \"Payment Date\" || col === \"Pending Since\" || col === \"Termination Date\") {\n          row[col] = formatDate(item[col]);\n        } else {\n          row[col] = item[col];\n        }\n      }\n\n      rows.push(row);\n    }\n\n    rawTables.push({\n      type: \"table\",\n      heading: observation,\n      content: rows,\n      columnOrder: columns\n    });\n  }\n\n  const showTopFiveMessage = rawTables.some((table) => Array.isArray(table.content) && table.content.length >= 5);\n\n  const agentResponse = [];\n  let seq = 1;\n\n  agentResponse.push({\n    type: \"text\",\n    content: [summaryText],\n    sequence: seq++\n  });\n\n  if (showTopFiveMessage) {\n    agentResponse.push({\n      type: \"text\",\n      content: [\"Showing up to 5 items below to keep this view focused.\"],\n      sequence: seq++\n    });\n  }\n\n  rawTables.forEach((table) => {\n    agentResponse.push({\n      ...table,\n      sequence: seq++\n    });\n  });\n\n  agentResponse.push({\n    type: \"actions\",\n    content: [\n      \"Use links in the table to review details and take appropriate actions.\"\n    ],\n    sequence: seq++\n  });\n\n  finalResult = {\n    agentResponse\n  };\n}\n\nreturn finalResult.agentResponse;"
          },
