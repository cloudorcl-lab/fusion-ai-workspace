{
  "workflowId": "100002355226979",
  "workflowCode": "ORA_FIN_AP_PAYMENT_EXECUTION_DATA_ANALYST_FOR_INSIGHTS",
  "name": "Payment Execution Data Analyst for Insights",
  "description": "Extracts the latest payment execution related data associated with insights. The analyst supports payment specialists by analyzing current transaction status and execution details based on defined monitoring prompts. Used to supply accurate, up to date data for insight review and follow on actions.",
  "specification": {
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
