        {
          "metadata": {
            "name": "Pre Process Extraction Data for Execution",
            "returnType": "array",
            "sourceCode": "const input = $context.$nodes.FIN_AP_BO_FUNCTION_EXTRACT_BQL_FOR_EXECUTION.$output;\nconst output = Array.isArray(input)\n  ? input.map(item => {\n      // Create a shallow copy of the item\n      const newItem = {};\n      Object.keys(item).forEach(key => {\n        newItem[key] = item[key] === null ? \"\" : item[key];\n      });\n      return newItem;\n    })\n  : [];\nreturn output;"
          },
          "outcomes": {
            "success": "1777006584968"
          },
          "code": "FIN_AP_CODE_PRE_PROCESS_EXTRACTION_DATA_EXECUTION",
          "convergenceTargetId": "1777375883073",
          "id": "1765978489189",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Preprocess Summary Data",
            "returnType": "object",
            "sourceCode": "const insightName = $context.$triggers.REST.$input.insightContext.insightsName;\nconst data = $context.$nodes.FIN_AP_BO_FUNCTION_EXTRACT_SUMMARY_DATA.$output || [];\nlet result = [];\n\nconst n = (value) => Number(value || 0);\nconst hasValue = (value) =>\n  value !== null &&\n  value !== undefined &&\n  value !== \"\" &&\n  value !== \"-\" &&\n  value !== \"N/A\";\n\nconst minDate = (current, next) => {\n  if (!hasValue(next)) return current;\n  if (!hasValue(current)) return next;\n  return next < current ? next : current;\n};\n\nconst sortByAmountDesc = (items) =>\n  items.sort((a, b) => n(b.totalPaymentAmount) - n(a.totalPaymentAmount));\n\nif (insightName === \"Payment runs requiring attention\") {\n  const grouped = {};\n\n  for (const item of data) {\n    const condition = item[\"Business Condition\"];\n    if (!hasValue(condition)) continue;\n\n    if (!grouped[condition]) {\n      grouped[condition] = {\n        businessCondition: condition,\n        totalPaymentProcessRequestCount: 0,\n        totalPaymentFileCount: 0,\n        earliestPendingSince: null,\n        businessUnits: {}\n      };\n    }\n\n    grouped[condition].totalPaymentProcessRequestCount += n(item[\"Payment Process Request Count\"]);\n    grouped[condition].totalPaymentFileCount += n(item[\"Payment File Count\"]);\n    grouped[condition].earliestPendingSince = minDate(\n      grouped[condition].earliestPendingSince,\n      item[\"Pending Since or Termination Date\"]\n    );\n\n    const bu = item[\"Business Unit\"];\n    if (hasValue(bu)) {\n      if (!grouped[condition].businessUnits[bu]) {\n        grouped[condition].businessUnits[bu] = 0;\n      }\n      grouped[condition].businessUnits[bu] += n(item[\"Payment Process Request Count\"]);\n    }\n  }\n\n  result = Object.values(grouped).map((obs) => ({\n    ...obs,\n    businessUnits: Object.entries(obs.businessUnits).map(([name, count]) => ({ name, count }))\n  }));\n} else if (insightName === \"Payments remaining unsettled or unreconciled\") {\n  const grouped = {};\n\n  for (const item of data) {\n    const condition = item[\"Business Condition\"];\n    if (!hasValue(condition)) continue;\n\n    if (!grouped[condition]) {\n      grouped[condition] = {\n        businessCondition: condition,\n        totalPaymentCount: 0,\n        totalPayeeCount: 0,\n        currencies: {}\n      };\n    }\n\n    grouped[condition].totalPaymentCount += n(item[\"Payment Count\"]);\n    grouped[condition].totalPayeeCount += n(item[\"Payee Count\"]);\n\n    const currency = hasValue(item[\"Currency\"]) ? item[\"Currency\"] : item[\"Payment Currency\"];\n    if (hasValue(currency)) {\n      if (!grouped[condition].currencies[currency]) {\n        grouped[condition].currencies[currency] = {\n          currency,\n          paymentCount: 0,\n          payeeCount: 0,\n          totalPaymentAmount: 0\n        };\n      }\n\n      grouped[condition].currencies[currency].paymentCount += n(item[\"Payment Count\"]);\n      grouped[condition].currencies[currency].payeeCount += n(item[\"Payee Count\"]);\n      grouped[condition].currencies[currency].totalPaymentAmount += n(item[\"Total Payment Amount\"]);\n    }\n  }\n\n  result = Object.values(grouped).map((obs) => ({\n    ...obs,\n    currencies: sortByAmountDesc(Object.values(obs.currencies))\n  }));\n} else if (insightName === \"Payments pending approval for more than 5 days\") {\n  const grouped = {};\n\n  for (const item of data) {\n    const condition = item[\"Business Condition\"];\n    if (!hasValue(condition)) continue;\n\n    if (!grouped[condition]) {\n      grouped[condition] = {\n        businessCondition: condition,\n        totalPaymentProcessRequestCount: 0,\n        totalPaymentCount: 0,\n        totalInstallmentCount: 0,\n        currencies: {}\n      };\n    }\n\n    grouped[condition].totalPaymentProcessRequestCount += n(item[\"Payment Process Request Count\"]);\n    grouped[condition].totalPaymentCount += n(item[\"Payment Count\"]);\n    grouped[condition].totalInstallmentCount += n(item[\"Installment Count\"]);\n\n    const currency = item[\"Payment Currency\"];\n    if (hasValue(currency)) {\n      if (!grouped[condition].currencies[currency]) {\n        grouped[condition].currencies[currency] = {\n          currency,\n          paymentCount: 0,\n          installmentCount: 0,\n          totalPaymentAmount: 0\n        };\n      }\n\n      grouped[condition].currencies[currency].paymentCount += n(item[\"Payment Count\"]);\n      grouped[condition].currencies[currency].installmentCount += n(item[\"Installment Count\"]);\n      grouped[condition].currencies[currency].totalPaymentAmount += n(item[\"Total Payment Amount\"]);\n    }\n  }\n\n  result = Object.values(grouped).map((obs) => ({\n    ...obs,\n    currencies: sortByAmountDesc(Object.values(obs.currencies))\n  }));\n} else if (insightName === \"Recurring payment rejection errors in last 30 days\") {\n  const grouped = {};\n\n  for (const item of data) {\n    const condition = item[\"Business Condition\"];\n    const reason = item[\"Rejection Reason\"];\n    if (!hasValue(condition)) continue;\n\n    if (!grouped[condition]) {\n      grouped[condition] = {\n        businessCondition: condition,\n        totalPaymentFileCount: 0,\n        totalPaymentCount: 0,\n        rejectionReasons: {}\n      };\n    }\n\n    grouped[condition].totalPaymentFileCount += n(item[\"Payment File Count\"]);\n    grouped[condition].totalPaymentCount += n(item[\"Payment Count\"]);\n\n    if (hasValue(reason)) {\n      if (!grouped[condition].rejectionReasons[reason]) {\n        grouped[condition].rejectionReasons[reason] = {\n          reason,\n          paymentFileCount: 0,\n          paymentCount: 0\n        };\n      }\n\n      grouped[condition].rejectionReasons[reason].paymentFileCount += n(item[\"Payment File Count\"]);\n      grouped[condition].rejectionReasons[reason].paymentCount += n(item[\"Payment Count\"]);\n    }\n  }\n\n  result = Object.values(grouped).map((obs) => ({\n    ...obs,\n    rejectionReasons: Object.values(obs.rejectionReasons).sort(\n      (a, b) => n(b.paymentCount) - n(a.paymentCount)\n    )\n  }));\n} else if (insightName === \"Recurring card settlement errors in last 30 days\") {\n  const grouped = {};\n\n  for (const item of data) {\n    const condition = item[\"Business Condition\"];\n    const reason = item[\"Error Reason\"];\n    if (!hasValue(condition)) continue;\n\n    if (!grouped[condition]) {\n      grouped[condition] = {\n        businessCondition: condition,\n        totalPaymentFileCount: 0,\n        totalPaymentCount: 0,\n        errorReasons: {}\n      };\n    }\n\n    grouped[condition].totalPaymentFileCount += n(item[\"Payment File Count\"]);\n    grouped[condition].totalPaymentCount += n(item[\"Payment Count\"]);\n\n    if (hasValue(reason)) {\n      if (!grouped[condition].errorReasons[reason]) {\n        grouped[condition].errorReasons[reason] = {\n          reason,\n          paymentFileCount: 0,\n          paymentCount: 0\n        };\n      }\n\n      grouped[condition].errorReasons[reason].paymentFileCount += n(item[\"Payment File Count\"]);\n      grouped[condition].errorReasons[reason].paymentCount += n(item[\"Payment Count\"]);\n    }\n  }\n\n  result = Object.values(grouped).map((obs) => ({\n    ...obs,\n    errorReasons: Object.values(obs.errorReasons).sort(\n      (a, b) => n(b.paymentCount) - n(a.paymentCount)\n    )\n  }));\n} else if (insightName === \"Payments with unresolved acknowledgments, rejections, or validation errors\") {\n  const grouped = {};\n\n  const fileLevelConditions = new Set([\n    \"Payment files rejected in acknowledgment\",\n    \"Payment files pending action due to acknowledgment failure\",\n    \"Payment files partially acknowledged\",\n    \"Payment files pending acknowledgment for more than 24 hours\"\n  ]);\n\n  const paymentLevelConditions = new Set([\n    \"Payments rejected in acknowledgment\",\n    \"Payments failed validation\"\n  ]);\n\n  for (const item of data) {\n    const condition = item[\"Business Condition\"];\n    if (!hasValue(condition)) continue;\n\n    if (!grouped[condition]) {\n      grouped[condition] = {\n        businessCondition: condition,\n        earliestPendingSince: null\n      };\n    }\n\n    grouped[condition].earliestPendingSince = minDate(\n      grouped[condition].earliestPendingSince,\n      item[\"Pending Since or Termination Date\"] || item[\"Payment Date\"]\n    );\n\n    if (fileLevelConditions.has(condition)) {\n      if (!grouped[condition].banks) {\n        grouped[condition].totalPaymentFileCount = 0;\n        grouped[condition].banks = {};\n      }\n\n      grouped[condition].totalPaymentFileCount += n(item[\"Payment File Count\"]);\n\n      const bank = item[\"Disbursement Bank or Funding Card Issuer\"];\n      if (hasValue(bank)) {\n        if (!grouped[condition].banks[bank]) {\n          grouped[condition].banks[bank] = {\n            bank,\n            paymentFileCount: 0\n          };\n        }\n        grouped[condition].banks[bank].paymentFileCount += n(item[\"Payment File Count\"]);\n      }\n    }\n\n    if (paymentLevelConditions.has(condition)) {\n      if (!grouped[condition].currencies) {\n        grouped[condition].totalPaymentCount = 0;\n        grouped[condition].currencies = {};\n      }\n\n      grouped[condition].totalPaymentCount += n(item[\"Payment Count\"]);\n\n      const currency = item[\"Payment Currency\"];\n      if (hasValue(currency)) {\n        if (!grouped[condition].currencies[currency]) {\n          grouped[condition].currencies[currency] = {\n            currency,\n            paymentCount: 0,\n            totalPaymentAmount: 0\n          };\n        }\n\n        grouped[condition].currencies[currency].paymentCount += n(item[\"Payment Count\"]);\n        grouped[condition].currencies[currency].totalPaymentAmount += n(item[\"Total Payment Amount\"]);\n      }\n    }\n  }\n\n  result = Object.values(grouped).map((obs) => {\n    if (obs.banks) {\n      return {\n        businessCondition: obs.businessCondition,\n        totalPaymentFileCount: obs.totalPaymentFileCount,\n        earliestPendingSince: obs.earliestPendingSince,\n        banks: Object.values(obs.banks).sort(\n          (a, b) => n(b.paymentFileCount) - n(a.paymentFileCount)\n        )\n      };\n    }\n\n    if (obs.currencies) {\n      return {\n        businessCondition: obs.businessCondition,\n        totalPaymentCount: obs.totalPaymentCount,\n        earliestPendingSince: obs.earliestPendingSince,\n        currencies: sortByAmountDesc(Object.values(obs.currencies))\n      };\n    }\n\n    return obs;\n  });\n} else if (insightName === \"Supplier financial profile requiring attention\") {\n  const grouped = {};\n\n  for (const item of data) {\n    const condition = item[\"Business Condition\"];\n    if (!hasValue(condition)) continue;\n\n    if (!grouped[condition]) {\n      grouped[condition] = {\n        businessCondition: condition,\n        totalSupplierCount: 0,\n        totalInstallmentCount: 0,\n        currencies: {}\n      };\n    }\n\n    grouped[condition].totalSupplierCount += n(item[\"Supplier Count\"]);\n    grouped[condition].totalInstallmentCount += n(item[\"Installment Count\"]);\n\n    const currency = item[\"Payment Currency\"];\n    if (hasValue(currency)) {\n      if (!grouped[condition].currencies[currency]) {\n        grouped[condition].currencies[currency] = {\n          currency,\n          supplierCount: 0,\n          installmentCount: 0,\n          totalOutstandingBalance: 0\n        };\n      }\n\n      grouped[condition].currencies[currency].supplierCount += n(item[\"Supplier Count\"]);\n      grouped[condition].currencies[currency].installmentCount += n(item[\"Installment Count\"]);\n      grouped[condition].currencies[currency].totalOutstandingBalance += n(item[\"Total Outstanding Balance\"]);\n    }\n  }\n\n  result = Object.values(grouped).map((obs) => ({\n    ...obs,\n    currencies: Object.values(obs.currencies).sort(\n      (a, b) => n(b.totalOutstandingBalance) - n(a.totalOutstandingBalance)\n    )\n  }));\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1777013880370"
          },
          "code": "FIN_AP_CODE_PREPROCESS_SUMMARY_DATA",
          "convergenceTargetId": "1777375883073",
