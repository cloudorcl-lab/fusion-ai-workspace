          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Check token size",
            "returnType": "number",
            "sourceCode": "let data = $context.$nodes.FIN_AP_CODE_PREPROCESS_SUMMARY_DATA.$output.result;\nconst str = typeof data === \"string\" ? data : JSON.stringify(data);\n\n// optional: normalize whitespace (slightly better estimate)\nconst cleaned = str.replace(/\\s+/g, \" \");\n\n// rough estimate: 1 token ≈ 4 characters\nconst tokenCount = Math.ceil(cleaned.length / 4);\nreturn tokenCount;"
          },
          "outcomes": {
