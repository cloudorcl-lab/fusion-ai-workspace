        {
          "metadata": {
            "name": "Process Execution Payments rejected or failed",
            "returnType": "array",
            "sourceCode": "const data = $context.$nodes.FIN_AP_CODE_PRE_PROCESS_EXTRACTION_DATA_EXECUTION.$output.result || [];\nconst summaryText =($context.$variables.summary ?? \"\").toString().trim() || \"Here are the details:\";\nconst observationColumnMap = {\n  \"Recurring card settlement errors in last 30 days\": [\n    \"Error Reason\",\n    \"Payment File Count\",\n    \"Payment Count\"\n  ]\n};\n\nconst formatDate = (val) => {\n  if (!val) {\n    return val;\n  }\n  if (typeof val === \"string\" && /^\\d{4}-\\d{2}-\\d{2}/.test(val)) {\n    return val.substring(0, 10);\n  }\n  const dt = new Date(val);\n  if (!isNaN(dt.valueOf())) {\n    return `${dt.getFullYear()}-${String(dt.getMonth() + 1).padStart(2, \"0\")}-${String(dt.getDate()).padStart(2, \"0\")}`;\n  }\n  return val;\n};\n\nlet finalResult;\n\nif ( $context.$nodes.FIN_AP_BO_FUNCTION_EXTRACT_BQL_FOR_EXECUTION.$status == 'failure')\nreturn null;\nelse if (!Array.isArray(data) || data.length === 0) {\n  finalResult = {\n    agentResponse: [{\n      type: \"text\",\n      content: [\"This insight has been resolved. There’s nothing to review at the moment.\"],\n      sequence: 1\n    }]\n  };\n} else {\n  const obsSet = Array.from(new Set(data.map((row) => row.Observations)));\n\n  const rawTables = obsSet.map((obs) => {\n    const columns = observationColumnMap[obs];\n    if (!columns) return null;\n\n    const rowsForObs = data.filter((row) => row.Observations === obs);\n\n    const formattedRows = rowsForObs.map((row) => {\n      const entry = {};\n      columns.forEach((col) => {\n        let val = row[col];\n        if (col.includes(\"Date\")) {\n          val = formatDate(val);\n        }\n        entry[col] = val;\n      });\n      return entry;\n    });\n\n    return {\n      type: \"table\",\n      heading: obs,\n      content: formattedRows,\n      columnOrder: columns\n    };\n  }).filter(Boolean);\n\n  const showTopFiveMessage = rawTables.some((table) => Array.isArray(table.content) && table.content.length >= 5);\n\n  const agentResponse = [];\n  let seq = 1;\n\n  agentResponse.push({\n    type: \"text\",\n    content: [summaryText],\n    sequence: seq++\n  });\n\n  if (showTopFiveMessage) {\n    agentResponse.push({\n      type: \"text\",\n      content: [\"Showing up to 5 items below to keep this view focused.\"],\n      sequence: seq++\n    });\n  }\n\n  rawTables.forEach((table) => {\n    agentResponse.push({\n      ...table,\n      sequence: seq++\n    });\n  });\n\n  agentResponse.push({\n    type: \"actions\",\n    content: [\n      \"Collaborate offline or verify setups to reduce repeated errors\"\n    ],\n    sequence: seq++\n  });\n\n  finalResult = { agentResponse };\n}\n\nreturn finalResult.agentResponse;"
          },
          "outcomes": {
            "success": "1769748878417"
          },
