              "name": "returnValue",
              "type": "string",
              "value": "Request to approve the transaction has been submitted"
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "name": "construct transaction map list",
            "returnType": "array",
            "sourceCode": "var passedUserComment  = $context.$variables.userComment ;\nvar passedTxnId = $context.$variables.transactionId ;\nvar x = [\n      {\n        \"transactionId\": passedTxnId,\n        \"action\": \"APPROVE\",\n        \"actionComment\": passedUserComment\n     }\n    ];\nreturn x;"
          },
          "outcomes": {
            "success": "1779178049552"
          },
