          },
          "outcomes": {
            "success": "1764062214599"
          },
          "code": "GET_USERNAME",
          "convergenceTargetId": "1764062214599",
          "id": "1764062157335",
          "inputs": [],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {},
              "code": "ORA_MODEL_CONFIG_PREMIUM_OPEN_AI_GPT_4_1_MINI",
              "model": "OCI_GPT_5_MINI",
              "provider": "CERT_PREMIUM"
            },
            "name": "Extract Transaction Id"
          },
          "outcomes": {
            "success": "1764175184194"
          },
          "code": "EXTRACT_TRANSACTION_ID",
          "id": "1764175042640",
          "inputs": [
            {
              "id": "1764175042641_1",
              "name": "prompt",
              "type": "string",
              "value": "From the provided input message extract the transaction id ``` {{$context.$system.$inputMessage}} ```\nExample\nuserInput: approve 300103651358143\noutput: 300103651358143"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "set transaction id from llm call"
          },
          "outcomes": {
            "success": "1779177654436"
          },
          "code": "SET_TRANSACTION_ID_FROM_LLM_CALL",
          "id": "1764175184194",
          "inputs": [
            {
              "id": "1764175197954",
              "name": "transactionId",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_TRANSACTION_ID.$output}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "extract user comment from input"
          },
          "outcomes": {
            "success": "1779177941269"
          },
          "code": "EXTRACT_USER_COMMENT_FROM_INPUT",
          "id": "1779177654436",
          "inputs": [
            {
              "id": "1779177654438_1",
              "name": "prompt",
              "type": "string",
              "value": "Read the following input : {{$context.$system.$inputMessage}}\n\nYou are supposed to extract the exact comment that the user has provided along with the transaction id.\nA comment is a remark that the user wants to attach with the approval to provide some information.\nIt is not necessary that the user will provide the comments.\nIn case, user has not provided any comment, you should return : NO_COMMENTS_PROVIDED.\nDo not append any additional text before or after the response.\nDo not add any labels before the comment.\n\nExample : approve 300100668328524 and add the following comment : This grade is approved from my side\nResponse: This grade is approved from my side\n\n\nExample : approve 300100668321235\nResponse: NO_COMMENTS_PROVIDED"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "set comment in variable"
          },
          "outcomes": {
            "success": "1779178009804"
          },
          "code": "SET_COMMENT_IN_VARIABLE",
          "id": "1779177941269",
          "inputs": [
            {
              "id": "1779177951489",
              "name": "userComment",
              "scope": "JOB",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_USER_COMMENT_FROM_INPUT.$output}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "check if comment provided"
          },
          "outcomes": {
            "true": "add_true_1779178009804",
            "false": "1779182577204"
          },
          "code": "CHECK_IF_COMMENT_PROVIDED",
          "convergenceTargetId": "1764062157335",
          "id": "1779178009804",
          "inputs": [
            {
              "id": "1779178009806_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$variables.userComment === 'NO_COMMENTS_PROVIDED'}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "description": "Add node for true branch",
            "name": "Add (True Branch)"
          },
          "outcomes": {
            "success": "1764062157335"
          },
          "id": "add_true_1779178009804",
          "inputs": [],
          "type": "ADD"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_BUSINESSPROCESSNOTIFICATIONACTION",
            "functionName": "perform_async_action",
            "processJson": true,
            "name": "call approve with comments api"
          },
          "outcomes": {
            "success": "1779178253281"
          },
          "code": "CALL_APPROVE_WITH_COMMENTS_API",
          "id": "1779178049552",
          "inputs": [
            {
              "id": "1780311662256_1",
              "name": "transactionMapList",
              "type": "string",
              "value": "{{$context.$nodes.CONSTRUCT_TRANSACTION_MAP_LIST.$output.result}}"
            },
            {
              "id": "1780311662257_2",
