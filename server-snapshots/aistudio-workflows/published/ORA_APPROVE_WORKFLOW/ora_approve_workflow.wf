          },
          "outcomes": {
            "success": "1764062283975"
          },
          "code": "EXTRACT_USERNAME",
          "id": "1764062214599",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "set username var"
          },
          "outcomes": {
            "success": "1764061354740"
          },
          "code": "SET_USERNAME_VAR",
          "id": "1764062283975",
          "inputs": [
            {
              "id": "1764062291600",
              "name": "loggedInUserName",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_USERNAME.$output.result}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_SELF_DETAIL_OBJECT",
