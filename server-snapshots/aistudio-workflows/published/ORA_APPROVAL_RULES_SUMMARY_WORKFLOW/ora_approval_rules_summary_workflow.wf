            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"FinalStageResponse\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"finalStageResponse\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"StageName\": { \"type\": [\"string\", \"null\"] },\n          \"ParallelRuleSetName\": { \"type\": [\"string\", \"null\"] },\n          \"SerialRuleSetName\": { \"type\": [\"string\", \"null\"] },\n          \"OnlyRuleSetName\": { \"type\": [\"string\", \"null\"] },\n          \"State\": { \"type\": [\"string\", \"null\"] }\n        },\n        \"required\": [\"StageName\", \"ParallelRuleSetName\", \"SerialRuleSetName\", \"OnlyRuleSetName\", \"State\"]\n      }\n    },\n    \"isRuleSaved\": { \"type\": \"string\" },\n    \"finalJsonResponse\": { \"type\": \"object\" }\n  },\n  \"required\": [\"finalStageResponse\", \"isRuleSaved\", \"finalJsonResponse\"]\n}",
          "type": "BO_FUNCTION"
