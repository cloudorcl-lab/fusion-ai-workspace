          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"AbsenceApprovalGraph\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"linkArray\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": { \"type\": \"string\" },\n          \"startNode\": { \"type\": \"string\" },\n          \"endNode\": { \"type\": \"string\" }\n        },\n        \"required\": [\"id\", \"startNode\", \"endNode\"]\n      }\n    },\n    \"isMultipleStages\": {\n      \"type\": \"string\",\n      \"enum\": [\"true\", \"false\"]\n    },\n    \"nodeArray\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": { \"type\": \"string\" },\n          \"nodeTitle\": { \"type\": \"string\" },\n          \"nodeText\": { \"type\": \"string\" },\n          \"size\": { \"type\": \"string\" },\n          \"shortDesc\": { \"type\": \"string\" },\n          \"parent\": { \"type\": \"string\" },\n          \"participantType\": { \"type\": \"string\" },\n          \"ruleSetName\": { \"type\": \"string\" },\n          \"ignoreParticipant\": { \"type\": \"string\" },\n          \"isStage\": { \"type\": \"string\" },\n          \"isPS7Enabled\": { \"type\": \"string\" },\n          \"IsRepeatingStage\": { \"type\": \"string\" },\n          \"CollectionName\": { \"type\": \"string\" },\n          \"isSharedAttachments\": { \"type\": \"string\" },\n          \"voteOutcomeApprvPerc\": { \"type\": [\"string\", \"null\"] },\n          \"voteOutcomeRejectPerc\": { \"type\": [\"string\", \"null\"] },\n          \"voteOutcomeAnyPerc\": { \"type\": [\"string\", \"null\"] },\n          \"isAllConsensusRequired\": { \"type\": \"string\" },\n          \"voteDefaultOutcome\": { \"type\": [\"string\", \"null\"] },\n          \"isVoteSharedAttachments\": { \"type\": \"string\" },\n          \"isFirstResponderWins\": { \"type\": \"string\" }\n        },\n        \"required\": [\"id\", \"nodeTitle\", \"nodeText\", \"size\", \"shortDesc\"]\n      }\n    }\n  },\n  \"required\": [\"linkArray\", \"isMultipleStages\", \"nodeArray\"]\n}",
          "type": "BO_FUNCTION"
        },
