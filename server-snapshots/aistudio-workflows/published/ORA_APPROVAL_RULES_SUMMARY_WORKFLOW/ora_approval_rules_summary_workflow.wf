          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"BusinessProcessApprovalOptionsResponse\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"ApprovalOptionsId\": { \"type\": \"string\" },\n          \"ProcessId\": { \"type\": \"string\" },\n          \"ApprovalDisabledFlag\": { \"type\": \"boolean\" },\n          \"CreatedBy\": { \"type\": \"string\" },\n          \"CreationDate\": { \"type\": \"string\", \"format\": \"date-time\" },\n          \"LastUpdatedBy\": { \"type\": \"string\" },\n          \"LastUpdateDate\": { \"type\": \"string\", \"format\": \"date-time\" },\n          \"TransactionModuleIdentifier\": { \"type\": \"string\" },\n          \"TransactionSubModuleIdentifier\": { \"type\": [\"string\", \"null\"] },\n          \"Name\": { \"type\": \"string\" },\n          \"ApprovalDisabledValue\": { \"type\": \"string\" },\n          \"IsParallelTransactionEnabled\": { \"type\": \"string\" },\n          \"atomicProcess\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"items\": {\n                \"type\": \"array\"\n              },\n              \"count\": { \"type\": \"integer\" },\n              \"hasMore\": { \"type\": \"boolean\" },\n              \"limit\": { \"type\": \"integer\" },\n              \"offset\": { \"type\": \"integer\" },\n              \"links\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"rel\": { \"type\": \"string\" },\n                    \"href\": { \"type\": \"string\", \"format\": \"uri\" },\n                    \"name\": { \"type\": \"string\" },\n                    \"kind\": { \"type\": \"string\" }\n                  },\n                  \"required\": [\"rel\", \"href\", \"name\", \"kind\"]\n                }\n              }\n            },\n            \"required\": [\"items\", \"count\", \"hasMore\", \"limit\", \"offset\", \"links\"]\n          },\n          \"aiCommentsConfigurations\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"items\": {\n                \"type\": \"array\"\n              },\n              \"count\": { \"type\": \"integer\" },\n              \"hasMore\": { \"type\": \"boolean\" },\n              \"limit\": { \"type\": \"integer\" },\n              \"offset\": { \"type\": \"integer\" },\n              \"links\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"rel\": { \"type\": \"string\" },\n                    \"href\": { \"type\": \"string\", \"format\": \"uri\" },\n                    \"name\": { \"type\": \"string\" },\n                    \"kind\": { \"type\": \"string\" }\n                  },\n                  \"required\": [\"rel\", \"href\", \"name\", \"kind\"]\n                }\n              }\n            },\n            \"required\": [\"items\", \"count\", \"hasMore\", \"limit\", \"offset\", \"links\"]\n          },\n          \"@context\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"key\": { \"type\": \"string\" }\n            },\n            \"required\": [\"key\"]\n          }\n        },\n        \"required\": [\n          \"ApprovalOptionsId\",\n          \"ProcessId\",\n          \"ApprovalDisabledFlag\",\n          \"CreatedBy\",\n          \"CreationDate\",\n          \"LastUpdatedBy\",\n          \"LastUpdateDate\",\n          \"TransactionModuleIdentifier\",\n          \"TransactionSubModuleIdentifier\",\n          \"Name\",\n          \"ApprovalDisabledValue\",\n          \"IsParallelTransactionEnabled\",\n          \"atomicProcess\",\n          \"aiCommentsConfigurations\",\n          \"@context\"\n        ]\n      }\n    },\n    \"count\": { \"type\": \"integer\" },\n    \"hasMore\": { \"type\": \"boolean\" },\n    \"limit\": { \"type\": \"integer\" },\n    \"offset\": { \"type\": \"integer\" },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": { \"type\": \"string\" },\n          \"href\": { \"type\": \"string\", \"format\": \"uri\" },\n          \"name\": { \"type\": \"string\" },\n          \"kind\": { \"type\": \"string\" }\n        },\n        \"required\": [\"rel\", \"href\", \"name\", \"kind\"]\n      }\n    }\n  },\n  \"required\": [\"items\", \"count\", \"hasMore\", \"limit\", \"offset\", \"links\"]\n}",
