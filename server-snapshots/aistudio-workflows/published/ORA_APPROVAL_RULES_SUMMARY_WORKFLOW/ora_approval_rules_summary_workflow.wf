          "code": "APPROVAL_RULES_SUMMARY_AGENT",
          "id": "1762432370876",
          "inputs": [
            {
              "id": "1762432370877_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an agent that extracts either a process id or a process name from {{$context.$system.$inputMessage}} for approval rule summary. \nRefer below examples to extract process_name and process_id from user input.\n\nExamples:\nInput: \"Create summary for process id 356278917\"\nOutput: { \"process_id\": 356278917 }\n\nInput: \"Rules summary of Hire an Employee\"\nOutput: { \"process_name\": \"Hire an Employee\" }\n\nInput: \"Rules configured for Promote\"\nOutput: { \"process_name\": \"Promote\" }\n\nInput: \"Please provide an approval rule summary for the Create Position process\"\nOutput: { \"process_name\": \"Create Position\" }\n\nInput: \"rules summary for the Transfer\"\nOutput: { \"process_name\": \"Transfer\"}\n\nInput: \"Approval rules summary for Promote and change position\"\nOutput: { \"process_name\": \"Promote and change position\" }\n\nUsers may not specifically mention keyword process name or process id in the input, you will have to use examples provided above to identify the value for process_id and process_name. \n\nInstructions: \n1. If the user input contains a process id, extract that value as \"process_id\" in the JSON output.\n2. If the user input contains a process name, extract that value as \"process_name\" in the JSON output. \n\nReturn both process_id and process_name."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"ProcessIdentifierResponse\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"process_id\": {\n      \"type\": \"string\"\n    },\n    \"process_name\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\"process_id\", \"process_name\"]\n}",
          "type": "LLM"
        },
