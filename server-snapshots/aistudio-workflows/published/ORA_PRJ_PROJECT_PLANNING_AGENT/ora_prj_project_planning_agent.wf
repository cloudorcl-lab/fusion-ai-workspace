{
  "workflowId": "300000331058435",
  "workflowCode": "ORA_PRJ_PROJECT_PLANNING_AGENT",
  "name": "Project Planning Agent",
  "description": "Manages the end-to-end project lifecycle from initiation through planning, execution monitoring, change management, analysis, and closure. Converts business inputs into structured project plans with aligned scope, schedule, budget, resources, and performance measures. Supports detailed plan creation, budget and resource planning, change request processing, approved change order implementation, touchless progress capture, and continuous analysis of feasibility, tradeoffs, risks, and variances to drive informed decisions. Helps teams keep projects aligned to business goals by continuously updating plans, monitoring execution signals, and enabling faster, more informed decision-making across the project lifecycle.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
