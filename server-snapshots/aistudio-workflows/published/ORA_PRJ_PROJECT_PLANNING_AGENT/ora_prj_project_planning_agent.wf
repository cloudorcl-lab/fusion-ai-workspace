          "code": "PRJ_PJO_LLM_GENERATE_OFF_TOPIC_RESPONSE",
          "id": "1782000101032",
          "inputs": [
            {
              "id": "1782000101032_prompt",
              "name": "prompt",
              "type": "string",
              "value": "You are the off-topic response writer for the Project Planning Agent.\n\nLatest user message: {{$context.$system.$inputMessage}}\nRouter reason: {{$context.$nodes.PRJ_PJO_LLM_PROJECT_PLANNING_AGENT_ROUTE_REQUEST.$output.reason}}\n\nTask:\nGenerate one concise, friendly response for this non-actionable or off-topic user message.\n\nRules:\n- Only respond to the current off-topic or greeting message.\n- Do not route the request.\n- Do not start, create, update, or inspect a project.\n- Do not claim that any project action was performed.\n- Do not answer unrelated external-domain requests. Politely redirect to project planning help.\n- For greetings like Hey, Hi, or Hello, greet the user naturally and mention that you can help with project initiation, project setup, planning questions, resources, and change implementation.\n- For capability questions, briefly describe supported project planning tasks.\n- Keep the text warm, professional, and under 80 words.\n\nReturn JSON only with no markdown in this exact shape:\n{\n  \"intent\": \"welcome\",\n  \"title\": \"Welcome\",\n  \"text\": \"\"\n}\n\nAllowed intent values: welcome, off_topic, unsupported, unclear."
            },
            {
              "id": "1782000101032_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "You generate concise user-facing JSON responses for Oracle Fusion Project Planning Agent off-topic or greeting turns."
            }
          ],
          "outputSpecification": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"intent\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"text\":{\"type\":\"string\"}},\"required\":[\"intent\",\"title\",\"text\"]}",
          "type": "LLM"
        },
        {
          "metadata": {
            "errorNodeId": "1779901000105",
            "name": "Build Off Topic Redwood Response",
            "returnType": "object",
            "sourceCode": "var o={};try{o=$context.$nodes.PRJ_PJO_LLM_GENERATE_OFF_TOPIC_RESPONSE.$output||{}}catch(e){o={}}function s(x){if(x===null||x===undefined)return \"\";return String(x).replace(/[\\s\\u00A0]+/g,\" \" ).trim()}function oneOf(v,a,d){v=s(v).toLowerCase();for(var i=0;i<a.length;i++){if(v===a[i])return v}return d}var rawText=s(o.text);var rawTitle=s(o.title);var intent=oneOf(o.intent,[\"welcome\",\"off_topic\",\"unsupported\",\"unclear\"],\"off_topic\");var msg=s($context.$system&&$context.$system.$inputMessage);var greeting=/^(hi|hello|hey|good morning|good afternoon|good evening)\\b/i.test(msg);if(!rawText){if(greeting){intent=\"welcome\";rawTitle=rawTitle||\"Welcome\";rawText=\"Hello. I can help with project initiation, project setup, planning questions, resources, and change implementation. Tell me what you would like to do next.\"}else{rawTitle=rawTitle||\"Project planning help\";rawText=\"I can help with Oracle Fusion project planning tasks such as project initiation, project setup, project plan questions, resources, and change implementation. Please share a project-planning request.\"}}if(!rawTitle){rawTitle=intent===\"welcome\"?\"Welcome\":\"Project planning help\"}if(rawText.length>600)rawText=rawText.substring(0,597)+\"...\";var content={agent:\"project_planning_agent\",intent:intent,schema_version:\"1\",title:rawTitle,description:\"Off-topic response from Project Planning Agent\",timestamp:\"\",topicName:rawTitle,agent_response:[{display_type:\"text\",display_sequence:1,text:rawText,expand:{display:\"true\",headerText:\"Summary\"}}]};return {redwoodResponse:{content:content},content:content,redwoodContent:JSON.stringify(content)};"
          },
          "outcomes": {
            "success": "1779901000111"
          },
          "code": "PRJ_PJO_CODE_BUILD_OFF_TOPIC_REDWOOD_RESPONSE",
          "id": "1782000101033",
          "inputs": [
