              "value": "{{($context.$variables.prjPjfActiveAtomicAgentDetails&&$context.$variables.prjPjfActiveAtomicAgentDetails.atomicAgentCode=='PRJ_PJF_PROJECT_INITIATION_ASSISTANT_TEAM')?$context.$variables.prjPjfActiveAtomicAgentDetails:null}}"
