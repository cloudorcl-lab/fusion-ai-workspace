 || null;\n  if (parsed.redwoodResponse && Object.prototype.hasOwnProperty.call(parsed.redwoodResponse, 'content')) {\n    redwoodContent = stringifyContent(filterRedwoodContent(parsed.redwoodResponse.content));\n  }\n}\n\nreturn {\n  rawOutput: stringifyContent(rawOutput),\n  isContractResponse: isContractResponse,\n  redwoodResponse: redwoodResponse,\n  redwoodContent: redwoodContent,\n  atomicAgentDetails: atomicAgentDetails\n};"
