        {
          "metadata": {
            "name": "Split Change Implementation Response",
            "returnType": "object",
            "sourceCode": "function safeParse(value) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n  if (typeof value === 'object') {\n    return value;\n  }\n  if (typeof value !== 'string') {\n    return null;\n  }\n  var trimmed = value.trim();\n  if (!trimmed) {\n    return null;\n  }\n  try {\n    return JSON.parse(trimmed);\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction clone(value) {\n  if (value === null || value === undefined) {\n    return value;\n  }\n  try {\n    return JSON.parse(JSON.stringify(value));\n  } catch (e) {\n    return value;\n  }\n}\n\nfunction filterAgentResponse(agentResponse) {\n  if (!Array.isArray(agentResponse)) {\n    return agentResponse;\n  }\n  var allowed = { text: true, table: true, list: true };\n  return agentResponse.filter(function (item) {\n    return item && allowed[String(item.display_type || '').toLowerCase()];\n  });\n}\n\nfunction filterRedwoodContent(content) {\n  var filtered = clone(content);\n  if (filtered && typeof filtered === 'object') {\n    if (Array.isArray(filtered.agent_response)) {\n      filtered.agent_response = filterAgentResponse(filtered.agent_response);\n    }\n    if (Array.isArray(filtered.agentResponse)) {\n      filtered.agentResponse = filterAgentResponse(filtered.agentResponse);\n    }\n  }\n  return filtered;\n}\n\nvar rawOutput = $context.$nodes.PRJ_PJO_WORKFLOW_PROJECT_PLANNING_AGENT_CALL_CHANGE_IMPLEMENTATION_ASSISTANT.$output.output;\nvar parsed = safeParse(rawOutput);\nvar redwoodResponse = parsed && parsed.redwoodResponse ? parsed.redwoodResponse : null;\nvar redwoodContent = redwoodResponse && redwoodResponse.content !== undefined ? redwoodResponse.content : rawOutput;\nvar atomicAgentDetails = parsed && parsed.atomicAgentDetails ? parsed.atomicAgentDetails : null;\n\nreturn {\n  rawOutput: rawOutput,\n  isContractResponse: !!redwoodResponse,\n  redwoodResponse: redwoodResponse,\n  redwoodContent: filterRedwoodContent(redwoodContent),\n  atomicAgentDetails: atomicAgentDetails\n};"
          },
