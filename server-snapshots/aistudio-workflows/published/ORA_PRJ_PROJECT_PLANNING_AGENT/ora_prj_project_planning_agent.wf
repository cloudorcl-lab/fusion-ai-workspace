            "name": "Format Change Request Initiation Response",
            "returnType": "object",
            "sourceCode": "function parseJsonSafe( value, fallback) {\n  if( typeof value === 'string') {\n    try {\n      return JSON.parse( value);\n    }\n    catch( e) {\n      return fallback;\n    }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\nfunction stringifyContent( value) {\n  if( value === null || value === undefined ) {\n    return '';\n  }\n  if( typeof value === 'string') {\n    return value;\n  }\n  try {\n    return JSON.stringify( value);\n  }\n  catch( e) {\n    return String( value);\n  }\n}\nfunction clone( value) {\n  if( value === null || value === undefined ) {\n    return value;\n  }\n  try {\n    return JSON.parse( JSON.stringify( value));\n  }\n  catch( e) {\n    return value;\n  }\n}\nfunction isSupportedDisplayItem( item) {\n  if( ! item || typeof item !== 'object') {\n    return false;\n  }\n  var displayType = item.display_type || item.displayType || '';\n  displayType = String( displayType).toLowerCase();\n  return displayType === 'text' || displayType === 'table' || displayType === 'list' || displayType === 'card' || displayType === 'chart' || displayType === 'action';\n}\nfunction filterRedwoodContent( content) {\n  if( Array.isArray( content)) {\n    return content.filter( isSupportedDisplayItem);\n  }\n  if( content && typeof content === 'object' && Array.isArray( content.agent_response)) {\n    var filteredContent = {};\n    for( var key in content) {\n      if( Object.prototype.hasOwnProperty.call( content, key)) {\n        filteredContent[ key] = content[ key];\n      }\n    } filteredContent.agent_response = content.agent_response.filter( isSupportedDisplayItem);\n    return filteredContent;\n  }\n  if( content && typeof content === 'object' && Array.isArray( content.agentResponse)) {\n    var filteredResponseContent = {};\n    for( var responseKey in content) {\n      if( Object.prototype.hasOwnProperty.call( content, responseKey)) {\n        filteredResponseContent[ responseKey] = content[ responseKey];\n      }\n    } filteredResponseContent.agentResponse = content.agentResponse.filter( isSupportedDisplayItem);\n    return filteredResponseContent;\n  }\n  return content;\n}\nfunction asArray( value) {\n  return Array.isArray( value) ? value : [];\n}\nfunction sameChangeRequestInitiationAgent( details) {\n  return details && details.atomicAgentCode === 'PRJ_PJE_PROJECT_CHANGE_REQUEST_INITIATION_ASSISTANT_STRATEGIC_TEAM_V2_V2';\n}\nfunction previousChangeRequestInitiationDetails() {\n  try {\n    var previousDetails = parseJsonSafe( $context.$variables.prjPjfActiveAtomicAgentDetails, null );\n    return sameChangeRequestInitiationAgent( previousDetails) ? previousDetails : null;\n  }\n  catch( e) {\n    return null;\n  }\n}\nfunction buildHistoryEntry( responsePayload, rawOutput) {\n  var userMessage = '';\n  try {\n    userMessage = $context.$system.$inputMessage || '';\n  }\n  catch( e) {}\n  return {\n    turnNumber: 0,\n    userMessage: userMessage,\n    assistantResponse: clone( responsePayload),\n    rawChildOutput: stringifyContent( rawOutput)\n  };\n}\nfunction appendResponseHistory( atomicAgentDetails, responsePayload, rawOutput) {\n  var previousDetails = previousChangeRequestInitiationDetails();\n  var history = [];\n  if( sameChangeRequestInitiationAgent( previousDetails)) {\n    history = asArray( previousDetails.atomicAgentResponseHistory).slice();\n    if( ! history.length && previousDetails.contextDetails) {\n      history = asArray( previousDetails.contextDetails.prjPjfVarConvAtomicAgentResponseHistory).slice();\n    }\n    if( ! history.length && previousDetails.contextDetails) {\n      history = asArray( previousDetails.contextDetails.prjPjeVarConvAtomicAgentResponseHistory).slice();\n    }\n    if( ! history.length && previousDetails.atomicAgentResponse) {\n      history.push( {\n        turnNumber: 1,\n        userMessage: previousDetails.contextDetails ? previousDetails.contextDetails.prjPjeVarConvLatestUserMessage : '',\n        assistantResponse: clone( previousDetails.atomicAgentResponse)\n      });\n    }\n  }\n  var currentEntry = buildHistoryEntry( responsePayload, rawOutput);\n  currentEntry.turnNumber = history.length + 1;\n  history.push( currentEntry);\n  var enrichedDetails = clone( atomicAgentDetails) || {};\n  enrichedDetails.atomicAgentResponse = clone( responsePayload);\n  enrichedDetails.atomicAgentResponseHistory = history;\n  if( ! enrichedDetails.contextDetails || typeof enrichedDetails.contextDetails !== 'object') {\n    enrichedDetails.contextDetails = {};\n  } enrichedDetails.contextDetails.prjPjfVarConvAtomicAgentResponseHistory = history;\n  enrichedDetails.contextDetails.prjPjeVarConvAtomicAgentResponseHistory = history;\n  return enrichedDetails;\n}\nvar rawOutput = '';\ntry {\n  rawOutput = $context.$nodes.PRJ_PJO_WORKFLOW_PROJECT_PLANNING_AGENT_CALL_CHANGE_REQUEST_INITIATION_ASSISTANT.$output.output;\n}\ncatch( e) {\n  rawOutput = '';\n}\nvar parsed = parseJsonSafe( rawOutput, null );\nvar redwoodResponse = null;\nvar atomicAgentDetails = null;\nvar redwoodContent = stringifyContent( rawOutput);\nvar isEnvelopeResponse = false;\nvar responsePayload = null;\nif( parsed && typeof parsed === 'object' && parsed.redwoodResponse) {\n  isEnvelopeResponse = true;\n  redwoodResponse = parsed.redwoodResponse;\n  atomicAgentDetails = parsed.atomicAgentDetails || null;\n  if( parsed.redwoodResponse && Object.prototype.hasOwnProperty.call( parsed.redwoodResponse, 'content')) {\n    responsePayload = filterRedwoodContent( parsed.redwoodResponse.content);\n    redwoodContent = stringifyContent( responsePayload);\n  }\n}\nif( ! atomicAgentDetails) {\n  atomicAgentDetails = previousChangeRequestInitiationDetails();\n}\nif( atomicAgentDetails) {\n  atomicAgentDetails = appendResponseHistory( atomicAgentDetails, responsePayload || redwoodContent, rawOutput);\n}\nreturn {\n  rawOutput: stringifyContent( rawOutput),\n  isEnvelopeResponse: isEnvelopeResponse,\n  redwoodResponse: redwoodResponse,\n  redwoodContent: redwoodContent,\n  atomicAgentDetails: atomicAgentDetails,\n  formattedOutput: redwoodContent\n};"
