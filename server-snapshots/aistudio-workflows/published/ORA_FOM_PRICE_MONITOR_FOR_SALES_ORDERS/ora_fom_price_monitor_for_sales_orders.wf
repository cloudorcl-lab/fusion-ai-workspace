        {
          "metadata": {
            "errorNodeId": "1775367234187",
            "name": "Get Return Reason And Type Meanings",
            "returnType": "object",
            "sourceCode": "// Read inputs from context\nconst reasonItems = $context.$nodes.GET_CANCEL_REASON_CODES.$output.LookupData;\nconst returnTypeItems = $context.$nodes.GET_ALL_RETURN_TYPES.$output.LookupData;\n\nconst returnReasonCode = $context.$nodes.GET_DEFAULT_CANCEL_REASON_CODE.$output.defaultReturnReason;\nconst returnMethodCode = $context.$nodes.GET_DEFAULT_CANCEL_REASON_CODE.$output.defaultReturnMethod;\n\n// Default response structure\nlet response = {\n  returnReason: {\n    LookupCode: null,\n    Meaning: null,\n    Description: null\n  },\n  returnMethod: {\n    LookupCode: null,\n    Meaning: null,\n    Description: null\n  }\n};\n\n// Resolve Return Reason (from reason codes list)\nif (Array.isArray(reasonItems) && returnReasonCode != null) {\n  const item = reasonItems.find(\n    (x) => String(x.LookupCode).trim() === String(returnReasonCode).trim()\n  );\n\n  if (item) {\n    response.returnReason = {\n      LookupCode: item.LookupCode ?? null,\n      Meaning: item.Meaning ?? null,\n      Description: item.Description ?? null\n    };\n  }\n}\n\n// Resolve Return Method (from return types list)\nif (Array.isArray(returnTypeItems) && returnMethodCode != null) {\n  const item = returnTypeItems.find(\n    (x) => String(x.LookupCode).trim() === String(returnMethodCode).trim()\n  );\n\n  if (item) {\n    response.returnMethod = {\n      LookupCode: item.LookupCode ?? null,\n      Meaning: item.Meaning ?? null,\n      Description: item.Description ?? null\n    };\n  }\n}\n\nreturn response;"
          },
          "outcomes": {
            "success": "1774780649718"
          },
          "code": "GET_RETURN_REASON_AND_TYPE_MEANINGS",
          "id": "1775965265561",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_completion_tokens": 32000,
                "reasoning_effort": "low"
              },
              "code": "ORA_MODEL_CONFIG_PREMIUM_OPEN_AI_GPT_4_1_MINI",
              "model": "OCI_GPT_5_MINI",
              "modelName": "Gpt-5 Mini",
              "provider": "CERT_PREMIUM"
            },
            "name": "Extract Return Order Details"
          },
          "outcomes": {
            "success": "1775841812251"
          },
          "code": "EXTRACT_RETURN_ORDER_DETAILS",
          "id": "1773731001523",
          "inputs": [
            {
              "id": "1773731001525_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a deterministic intent extraction and semantic matching engine for return order requests.\n\nYour task is to extract only the information that is explicitly present in the customer message, except where the rules below explicitly allow semantic derivation for return reason and return type.\n\nReturn only valid JSON.\n\n--------------------------------------------------\nINPUT VARIABLES\n--------------------------------------------------\n\nCUSTOMER_MESSAGE = {{$context.$system.$inputMessage}} \nALLOWED_RETURN_TYPES = {{$context.$nodes.GET_RETURN_TYPES.$output.LookupData}}\nALLOWED_RETURN_REASONS = {{$context.$nodes.GET_RETURN_REASON_CODES.$output.LookupData}}\nRAG_RETURN_TYPE_SUGGESTIONS = {{$context.$nodes.GET_RETURN_REASON_AND_TYPE_MEANING.$output.result.returnReasonMappings}}\nDEFAULT_RETURN_REASON_CODE = {{$context.$nodes.GET_DEFAULT_RETURN_REASON_CODE_AND_TYPE.$output.defaultReturnReason}}\nDEFAULT_RETURN_REASON_MEANING = {{$context.$nodes.GET_RETURN_REASON_AND_TYPE_MEANING.$output.result.defaultReturnReasonMeaning}}\nDEFAULT_RETURN_METHOD_CODE = {{$context.$nodes.GET_DEFAULT_RETURN_REASON_CODE_AND_TYPE.$output.defaultReturnMethod}}\nDEFAULT_RETURN_METHOD_MEANING = {{$context.$nodes.GET_RETURN_REASON_AND_TYPE_MEANING.$output.result.defaultReturnTypeMeaning}}\n\nORDER_NUMBER = {{$context.$nodes.EXTRACT_ORDER_NUMBER_AND_USER_INTENT.$output.OrderNumber}}\n\n--------------------------------------------------\nSTRICT OUTPUT RULES\n--------------------------------------------------\n\n- Return only valid JSON.\n- Do not return explanations, markdown, comments, or extra text.\n- Use only the input variables provided above.\n- Do not invent unsupported values.\n- Do not return empty strings unless explicitly required by the schema.\n- If line numbers or item references are present, place return reason and return type only inside returnOrderLines.\n- Do not include header-level return reason or return type when line or item targets exist.\n- If no line numbers and no item references are present, place return reason and return type at the header level.\n- Multiple lines or items may each have their own reason and return type.\n- If the same intent applies to multiple lines or items, duplicate the same reason and type across all relevant entries.\n\n--------------------------------------------------\nCORE INTERPRETATION RULES\n--------------------------------------------------\n\n1. Extract the order number first.\n2. Extract line numbers and item references.\n3. Identify the return type/return method only if it is explicitly present.\n4. Identify the return reason if it is explicitly present or can be semantically derived under the rules below.\n5. If no explicit return reason exists, derive the closest valid reason only when the message clearly conveys one.\n6. If neither reason nor type can be derived, use the defaults.\n\nImportant:\n- Prefer a valid semantic match over the default whenever the message contains a meaningful return reason.\n- Do not use the default values merely because the message is informal, paraphrased, or embedded in a sentence.\n- Do not require exact wording from the allowed reason list.\n- The matcher must be reason-agnostic: map any semantically valid complaint to the best allowed reason, not to a hardcoded phrase pattern.\n\n--------------------------------------------------\nRETURN REASON DETECTION AND SEMANTIC MATCHING\n--------------------------------------------------\n\nA return reason is considered present whenever CUSTOMER_MESSAGE contains a phrase whose meaning is semantically equivalent to one of the entries in ALLOWED_RETURN_REASONS, even if the wording is informal, indirect, paraphrased, or embedded in a sentence about a line or item.\n\nDo not:\n- require exact wording from the allowed reason list\n- restrict reason detection to trigger phrases such as \"because\", \"due to\", or \"reason\"\n- rely only on literal token overlap\n\nInstead:\n1. Detect the underlying customer problem or complaint expressed in the message.\n2. Compare that meaning against all entries in ALLOWED_RETURN_REASONS.\n3. Select the single closest allowed reason by semantic equivalence.\n4. Use the matched canonical Meaning and LookupCode from ALLOWED_RETURN_REASONS.\n5. Fall back to DEFAULT_RETURN_REASON_CODE and DEFAULT_RETURN_REASON_MEANING only when no allowed reason is a valid semantic fit.\n\nThis applies uniformly to all return reasons, including but not limited to:\n- missing parts / incomplete / partial delivery / missing pieces\n- damaged / broken / cracked / scratched\n- defective / not working / malfunctioning\n- late delivery / delayed\n- wrong item / incorrect item\n- missing item / not received / never received\n- not ordered / did not order\n- not wanted / no longer need\n- discontinued / obsolete / item discontinued\n\nIf multiple allowed reasons are plausible, choose the best semantic match with the highest confidence.\nIf confidence is too low, use the default reason with score 0.\n\n--------------------------------------------------\nRETURN REASON MATCHING\n--------------------------------------------------\n\nApply this section only if a return reason is explicitly present or can be semantically derived.\n\n1. Normalize the meaning, not the wording.\n2. Match against ALLOWED_RETURN_REASONS by semantic closeness.\n3. Prefer the closest canonical meaning over lexical similarity.\n4. Use the matched LookupCode from ALLOWED_RETURN_REASONS.\n5. Set ReturnReasonMatchedValue to the matched Meaning from ALLOWED_RETURN_REASONS.\n6. Set ReturnReasonMatchScore as follows:\n   - 90-100 for direct or near-direct semantic matches\n   - 70-89 for clear paraphrases\n   - 50-69 for weaker but still valid intent matches\n7. If no valid semantic match exists, use:\n   - ReturnReasonInput = null\n   - ReturnReasonCode = DEFAULT_RETURN_REASON_CODE\n   - ReturnReasonMatchedValue = DEFAULT_RETURN_REASON_MEANING\n   - ReturnReasonMatchScore = 0\n\nExamples:\n- \"as they are missing some parts\" -> nearest allowed reason for missing parts\n- \"parts are missing\" -> nearest allowed reason for missing parts\n- \"incomplete\" -> nearest allowed reason for missing parts\n- \"not complete\" -> nearest allowed reason for missing parts\n- \"arrived incomplete\" -> nearest allowed reason for missing parts\n- \"broken\" -> nearest allowed reason for damaged item\n- \"does not work\" -> nearest allowed reason for defective item\n- \"delayed\" -> nearest allowed reason for late delivery\n- \"wrong item\" -> nearest allowed reason for wrong item\n- \"did not receive it\" -> nearest allowed reason for missing item\n- \"no longer need it\" -> nearest allowed reason for not wanted\n- \"item is discontinued\" -> nearest allowed reason for discontinued item, if such a reason exists in ALLOWED_RETURN_REASONS; otherwise fall back to default\n\n--------------------------------------------------\nRETURN TYPE RULES\n--------------------------------------------------\n\nReturn type handling is separate from return reason.\n\n1. First check whether CUSTOMER_MESSAGE contains an explicit return type or return method.\n2. If an explicit return type or return method is present, match it against ALLOWED_RETURN_TYPES.\n3. If a valid match is found:\n   - ReturnTypeInput = exact text from CUSTOMER_MESSAGE\n   - ReturnTypeMatchedValue = matched Meaning\n   - ReturnTypeCode = matched LookupCode\n   - ReturnTypeMatchScore = 50-100\n\n4. If CUSTOMER_MESSAGE contains a return reason but no explicit return type or return method:\n   - ReturnTypeInput must be null\n   - derive the returnMethodCode from RAG_RETURN_TYPE_SUGGESTIONS using the matched ReturnReasonCode\n   - then match that returnMethodCode against ALLOWED_RETURN_TYPES and populate:\n     - ReturnTypeMatchedValue = matched Meaning\n     - ReturnTypeCode = matched LookupCode\n     - ReturnTypeMatchScore = 0\n   - do not use the DEFAULT_RETURN_METHOD_CODE unless no mapping exists\n\n5. If no mapping exists in RAG_RETURN_TYPE_SUGGESTIONS for the matched reason:\n   - ReturnTypeInput = null\n   - ReturnTypeMatchedValue = DEFAULT_RETURN_METHOD_MEANING\n   - ReturnTypeCode = DEFAULT_RETURN_METHOD_CODE\n   - ReturnTypeMatchScore = 0\n\nImportant:\n- If a reason maps to a return type through RAG_RETURN_TYPE_SUGGESTIONS, always use that mapping.\n- Do not invent a return type.\n- Do not use the default return type when a valid mapped return type exists.\n- Return type must follow the reason-to-type mapping, not the other way around.\n\n--------------------------------------------------\nABSENCE RULES\n--------------------------------------------------\n\nIf CUSTOMER_MESSAGE does not contain an explicit or derivable return reason:\n- ReturnReasonInput = null\n- ReturnReasonCode = DEFAULT_RETURN_REASON_CODE\n- ReturnReasonMatchedValue = DEFAULT_RETURN_REASON_MEANING\n- ReturnReasonMatchScore = 0\n\nIf CUSTOMER_MESSAGE contains a derivable return reason but no explicit return type or return method:\n- ReturnTypeInput = null\n- ReturnTypeCode = mapped returnMethodCode from RAG_RETURN_TYPE_SUGGESTIONS for the matched ReturnReasonCode\n- ReturnTypeMatchedValue = matched Meaning for that mapped returnMethodCode from ALLOWED_RETURN_TYPES\n- ReturnTypeMatchScore = 0\n\nIf CUSTOMER_MESSAGE does not contain an explicit or derivable return type or return method, and no return reason can be matched:\n- ReturnTypeInput = null\n- ReturnTypeCode = DEFAULT_RETURN_METHOD_CODE\n- ReturnTypeMatchedValue = DEFAULT_RETURN_METHOD_MEANING\n- ReturnTypeMatchScore = 0\n\nDo not override these rules unless a real semantic reason or type can be matched.\n\n--------------------------------------------------\nLINE EXTRACTION RULES\n--------------------------------------------------\n\nExtract line numbers as strings.\n\nValid examples:\n- \"line 1\" -> [\"1\"]\n- \"line 1-1\" -> [\"1-1\"]\n- \"lines 1,2\" -> [\"1\",\"2\"]\n- \"line 1 and 2\" -> [\"1\",\"2\"]\n- \"line 2-6\" -> [\"2-6\"]\n- \"return 1,2 from order 7878\" -> [\"1\",\"2\"]\n- \"return 3 and 4 from order 123\" -> [\"3\",\"4\"]\n\nRange expansion:\nIf CUSTOMER_MESSAGE contains an explicit numeric range using:\n- \"to\"\n- \"through\"\n\nthen expand to the full sequence.\n\nExamples:\n- \"lines 1 to 5\" -> [\"1\",\"2\",\"3\",\"4\",\"5\"]\n- \"lines 2 through 4\" -> [\"2\",\"3\",\"4\"]\n\nImportant:\n- \"-\" is not a range delimiter.\n- Values such as \"1-3\" or \"2-6\" must be preserved as-is because they may represent split line identifiers.\n- Do not expand \"1-1\", \"1-3\", or similar hyphenated identifiers.\n- Remove duplicates.\n- Preserve logical order.\n\n--------------------------------------------------\nITEM EXTRACTION RULES\n--------------------------------------------------\n\nExtract item references only when explicitly present, or when a concrete item noun is clearly the direct object of the return request.\n\nSupported explicit patterns:\n- \"item ABC123\" -> ItemNumber = \"ABC123\"\n- \"product XYZ\" -> ItemNumber = \"XYZ\"\n- \"return item laptop\" -> ItemNumber = \"laptop\"\n\nSupported implicit patterns:\n- \"return laptop from order 78787\" -> ItemNumber = \"laptop\"\n- \"return printer order 12345\" -> ItemNumber = \"printer\"\n- \"return charger\" -> ItemNumber = \"charger\"\n\nUnified rule:\n- If a single concrete noun or identifier appears immediately after the verb \"return\", or after keywords such as \"item\" or \"product\", treat it as ItemNumber.\n- Prefer the noun closest to the verb \"return\".\n\nIf both explicit and implicit forms exist, prioritize the explicit form:\n- \"return item laptop\" -> \"laptop\"\n\nPreserve the original text exactly as ItemNumber.\nDo not normalize, map, or transform item values.\n\n--------------------------------------------------\nASSOCIATION RULES\n--------------------------------------------------\n\n- LineNumber and ItemNumber are different entities.\n- Do not combine them into one field.\n- If one reason or type applies to multiple lines or items, duplicate the same reason or type across all relevant entries.\n- If the message clearly applies a reason only to a subset of lines, assign it only to those lines.\n\n--------------------------------------------------\nREJECTION RULES\n--------------------------------------------------\n\nReject only if any of the following is true:\n1. Order number is missing.\n2. The request is quantity-only without line-level or item-level specificity.\n3. The message is ambiguous, for example:\n   - some items\n   - a few items\n   - return several\n4. The content is unrelated to a return request.\n5. The request specifies only quantities, for example:\n   - \"return 2 items\"\n   - \"return 6 quantity of item\"\n   - \"return 5 quantity of line\"\n\nIn those cases return exactly:\n{\n  \"Action\": \"REJECT\",\n  \"reason\": \"UNSUPPORTED_REQUEST\"\n}\n\n--------------------------------------------------\nOUTPUT FORMAT\n--------------------------------------------------\n\nIf lines or items are present:\n{\n  \"Action\": \"RETURN_ORDER\",\n  \"OrderNumber\": \"<order_number>\",\n  \"returnOrderLines\": [\n    {\n      \"LineNumber\": \"<line_or_null>\",\n      \"ItemNumber\": \"<item_or_null>\",\n      \"ReturnReasonInput\": null or \"<exact_text_or_intent>\",\n      \"ReturnReasonMatchedValue\": null or \"<meaning>\",\n      \"ReturnReasonCode\": null or \"<code>\",\n      \"ReturnReasonMatchScore\": <0-100>,\n      \"ReturnTypeInput\": null or \"<exact_text>\",\n      \"ReturnTypeMatchedValue\": null or \"<meaning>\",\n      \"ReturnTypeCode\": null or \"<code>\",\n      \"ReturnTypeMatchScore\": <0-100>\n    }\n  ]\n}\n\nIf no lines or items are present:\n{\n  \"Action\": \"RETURN_ORDER\",\n  \"OrderNumber\": \"<order_number>\",\n  \"ReturnReasonInput\": null or \"<exact_text_or_intent>\",\n  \"ReturnReasonMatchedValue\": null or \"<meaning>\",\n  \"ReturnReasonCode\": null or \"<code>\",\n  \"ReturnReasonMatchScore\": <0-100>,\n  \"ReturnTypeInput\": null or \"<exact_text>\",\n  \"ReturnTypeMatchedValue\": null or \"<meaning>\",\n  \"ReturnTypeCode\": null or \"<code>\",\n  \"ReturnTypeMatchScore\": <0-100>\n}\n\n--------------------------------------------------\nDECISION PRIORITY\n--------------------------------------------------\n\n1. Extract OrderNumber.\n2. Extract line or item targets.\n3. Detect explicit return type.\n4. Detect explicit or semantically clear return reason.\n5. Match the reason to ALLOWED_RETURN_REASONS.\n6. Derive the return type from RAG_RETURN_TYPE_SUGGESTIONS when explicit type is absent or invalid.\n7. Use defaults only when no valid semantic mapping exists.\n\n--------------------------------------------------\nNEGATIVE CONSTRAINTS\n--------------------------------------------------\n\n- Do not require the customer to say \"because\" or \"due to\" for a reason to be recognized.\n- Do not ignore nearby reason-bearing text just because the sentence is informal.\n- Do not default to ORA_NOT_WANTED if the message clearly indicates another valid reason such as damage, defect, delay, wrong item, missing item, not ordered, not wanted, incomplete shipment, or discontinued item.\n- Do not return empty strings where null is expected.\n- Do not use unsupported fallback values.\n\n--------------------------------------------------\nEXAMPLES\n--------------------------------------------------\n\nExample 1\nInput: return order 520832 because damaged for return for credit\n\nOutput:\n{\n  \"Action\": \"RETURN_ORDER\",\n  \"OrderNumber\": \"520832\",\n  \"ReturnReasonInput\": \"damaged\",\n  \"ReturnReasonMatchedValue\": \"The item is damaged\",\n  \"ReturnReasonCode\": \"ORA_DAMAGED_ITEM\",\n  \"ReturnReasonMatchScore\": 95,\n  \"ReturnTypeInput\": \"return for credit\",\n  \"ReturnTypeMatchedValue\": \"Return for credit\",\n  \"ReturnTypeCode\": \"ORA_CREDIT_ONLY\",\n  \"ReturnTypeMatchScore\": 95\n}\n\nExample 2\nInput: return order 520832 because late delivery\n\nOutput:\n{\n  \"Action\": \"RETURN_ORDER\",\n  \"OrderNumber\": \"520832\",\n  \"ReturnReasonInput\": \"late delivery\",\n  \"ReturnReasonMatchedValue\": \"The item was delivered late\",\n  \"ReturnReasonCode\": \"ORA_LATE_DELIVERY\",\n  \"ReturnReasonMatchScore\": 95,\n  \"ReturnTypeInput\": null,\n  \"ReturnTypeMatchedValue\": \"Return for credit and return the item\",\n  \"ReturnTypeCode\": \"ORA_RETURN\",\n  \"ReturnTypeMatchScore\": 0\n}\n\nExample 3\nInput: return lines 1 to 3 of order 520832 because damaged and line 4 because missing parts\n\nOutput:\n{\n  \"Action\": \"RETURN_ORDER\",\n  \"OrderNumber\": \"520832\",\n  \"returnOrderLines\": [\n    {\n      \"LineNumber\": \"1\",\n      \"ItemNumber\": null,\n      \"ReturnReasonInput\": \"damaged\",\n      \"ReturnReasonMatchedValue\": \"The item is damaged\",\n      \"ReturnReasonCode\": \"ORA_DAMAGED_ITEM\",\n      \"ReturnReasonMatchScore\": 95,\n      \"ReturnTypeInput\": null,\n      \"ReturnTypeMatchedValue\": \"Return for credit and return the item\",\n      \"ReturnTypeCode\": \"ORA_RETURN\",\n      \"ReturnTypeMatchScore\": 0\n    },\n    {\n      \"LineNumber\": \"2\",\n      \"ItemNumber\": null,\n      \"ReturnReasonInput\": \"damaged\",\n      \"ReturnReasonMatchedValue\": \"The item is damaged\",\n      \"ReturnReasonCode\": \"ORA_DAMAGED_ITEM\",\n      \"ReturnReasonMatchScore\": 95,\n      \"ReturnTypeInput\": null,\n      \"ReturnTypeMatchedValue\": \"Return for credit and return the item\",\n      \"ReturnTypeCode\": \"ORA_RETURN\",\n      \"ReturnTypeMatchScore\": 0\n    },\n    {\n      \"LineNumber\": \"3\",\n      \"ItemNumber\": null,\n      \"ReturnReasonInput\": \"damaged\",\n      \"ReturnReasonMatchedValue\": \"The item is damaged\",\n      \"ReturnReasonCode\": \"ORA_DAMAGED_ITEM\",\n      \"ReturnReasonMatchScore\": 95,\n      \"ReturnTypeInput\": null,\n      \"ReturnTypeMatchedValue\": \"Return for credit and return the item\",\n      \"ReturnTypeCode\": \"ORA_RETURN\",\n      \"ReturnTypeMatchScore\": 0\n    },\n    {\n      \"LineNumber\": \"4\",\n      \"ItemNumber\": null,\n      \"ReturnReasonInput\": \"missing parts\",\n      \"ReturnReasonMatchedValue\": \"The item is missing parts\",\n      \"ReturnReasonCode\": \"ORA_MISSING_PARTS\",\n      \"ReturnReasonMatchScore\": 95,\n      \"ReturnTypeInput\": null,\n      \"ReturnTypeMatchedValue\": \"Return for credit and return the item\",\n      \"ReturnTypeCode\": \"ORA_RETURN\",\n      \"ReturnTypeMatchScore\": 0\n    }\n  ]\n}\n\nExample 4\nInput: return line 1 and 2 as they are missing some parts of order 787878\n\nOutput:\n{\n  \"Action\": \"RETURN_ORDER\",\n  \"OrderNumber\": \"787878\",\n  \"returnOrderLines\": [\n    {\n      \"LineNumber\": \"1\",\n      \"ItemNumber\": null,\n      \"ReturnReasonInput\": \"missing some parts\",\n      \"ReturnReasonMatchedValue\": \"The item is missing parts\",\n      \"ReturnReasonCode\": \"ORA_MISSING_PARTS\",\n      \"ReturnReasonMatchScore\": 95,\n      \"ReturnTypeInput\": null,\n      \"ReturnTypeMatchedValue\": \"Return for credit and return the item\",\n      \"ReturnTypeCode\": \"ORA_RETURN\",\n      \"ReturnTypeMatchScore\": 0\n    },\n    {\n      \"LineNumber\": \"2\",\n      \"ItemNumber\": null,\n      \"ReturnReasonInput\": \"missing some parts\",\n      \"ReturnReasonMatchedValue\": \"The item is missing parts\",\n      \"ReturnReasonCode\": \"ORA_MISSING_PARTS\",\n      \"ReturnReasonMatchScore\": 95,\n      \"ReturnTypeInput\": null,\n      \"ReturnTypeMatchedValue\": \"Return for credit and return the item\",\n      \"ReturnTypeCode\": \"ORA_RETURN\",\n      \"ReturnTypeMatchScore\": 0\n    }\n  ]\n}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"Action\": {\n      \"type\": \"string\"\n    },\n    \"OrderNumber\": {\n      \"type\": \"string\"\n    },\n    \"returnOrderLines\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"LineNumber\": {\n            \"type\": \"string\"\n          },\n          \"ItemNumber\": {\n            \"type\": \"string\"\n          },\n          \"ReturnReasonInput\": {\n            \"type\": \"string\"\n          },\n          \"ReturnReasonMatchedValue\": {\n            \"type\": \"string\"\n          },\n          \"ReturnReasonCode\": {\n            \"type\": \"string\"\n          },\n          \"ReturnReasonMatchScore\": {\n            \"type\": \"number\"\n          },\n          \"ReturnTypeInput\": {},\n          \"ReturnTypeMatchedValue\": {\n            \"type\": \"string\"\n          },\n          \"ReturnTypeCode\": {\n            \"type\": \"string\"\n          },\n          \"ReturnTypeMatchScore\": {\n            \"type\": \"number\"\n          }\n        }\n      }\n    },\n    \"ReturnReasonInput\": {\n      \"type\": \"string\"\n    },\n    \"ReturnReasonMatchedValue\": {\n      \"type\": \"string\"\n    },\n    \"ReturnReasonCode\": {\n      \"type\": \"string\"\n    },\n    \"ReturnReasonMatchScore\": {\n      \"type\": \"number\"\n    },\n    \"ReturnTypeInput\": {},\n    \"ReturnTypeMatchedValue\": {\n      \"type\": \"string\"\n    },\n    \"ReturnTypeCode\": {\n      \"type\": \"string\"\n    },\n    \"ReturnTypeMatchScore\": {\n      \"type\": \"number\"\n    }\n  }\n}",
