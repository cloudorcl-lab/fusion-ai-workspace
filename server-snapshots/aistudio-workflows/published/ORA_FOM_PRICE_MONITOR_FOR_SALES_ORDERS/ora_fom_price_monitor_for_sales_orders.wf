            "name": "Derive Single Header Id",
            "returnType": "number",
            "sourceCode": "const payload = $context.$nodes.GETHEADERID.$output;\nconst items = payload?.items ?? [];\nconst count = payload?.count ?? items.length;\n\nif (count === 0 || count > 2) {\n  return null;\n}\n\nif (count === 1) {\n  return items[0]?.HeaderId ?? null;\n}\n\nconst selectedItem =\n  items.find(item => item.SubmittedFlag === true || item.SubmittedFlag === \"Y\") ??\n  items[0];\n\nreturn selectedItem?.HeaderId ?? null;"
          },
