          "metadata": {
            "name": "Convert Cancel Payload to JSON object",
            "returnType": "object",
            "sourceCode": "function isValidJSON(str) {\n  try {\n    JSON.parse(str);\n    return true;\n  } catch (e) {\n    return false;\n  }\n}\n\nfunction mapToJsonString(str) {\n  return str\n    .replace(/=/g, ':')\n    .replace(/([{,]\\s*)([A-Za-z0-9_]+):/g, '$1\"$2\":')\n    .replace(/:\\s*([A-Za-z_][A-Za-z0-9_]*)/g, ':\"$1\"');\n}\n\n// ===== MAIN LOGIC =====\n\nlet rawPayload = $context.$nodes.PARSE_ACTION_PAYLOAD.$output.result.payload; \nlet finalPayload;\n\nif (typeof rawPayload === \"object\") {\n  //  already JSON object → stringify directly\n  finalPayload = JSON.stringify(rawPayload);\n\n} else if (typeof rawPayload === \"string\" && isValidJSON(rawPayload)) {\n  //  valid JSON string\n  finalPayload = rawPayload;\n\n} else if (typeof rawPayload === \"string\") {\n  //  map-style string → convert\n  const converted = mapToJsonString(rawPayload);\n  finalPayload = JSON.stringify(JSON.parse(converted));\n\n} else {\n  return rawPayload;\n}\n\nreturn finalPayload;"
          },
          "outcomes": {
            "success": "1775454241971"
          },
          "code": "CONVERT_CANCEL_PAYLOAD_TO_JSON_OBJECT",
          "id": "1776130103346",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
