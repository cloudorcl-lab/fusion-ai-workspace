        {
          "metadata": {
            "name": "Extract PO Encoded File Details",
            "returnType": "object",
            "sourceCode": "let input = $context.$nodes.READ_PO_ENCODED_DATA_FROM_CONVERSAION?.$output ?? {};\n\ntry {\n  if (typeof input === \"string\") {\n    input = JSON.parse(input);\n  }\n} catch (e) {\n  input = {};\n}\n\nconst rawFiles = input?.ORA_CHAT_ATTACHMENTS_RAW_FILECONTENT ?? {};\n\nlet fileName = \"\";\nlet base64EncodedFileContent = \"\";\n\nif (rawFiles && typeof rawFiles === \"object\") {\n  const keys = Object.keys(rawFiles);\n\n  if (keys.length > 0) {\n    fileName = keys[0] || \"\";\n\n    const fileObj = rawFiles[fileName] ?? {};\n    base64EncodedFileContent = fileObj?.bas64EncodedFileContent ?? \"\";\n  }\n}\n\nreturn {\n  fileName,\n  base64EncodedFileContent\n};"
          },
          "outcomes": {
            "success": "1771570244058"
          },
          "code": "EXTRACT_PO_ENCODED_FILE_DETAILS",
          "id": "1778780916965",
