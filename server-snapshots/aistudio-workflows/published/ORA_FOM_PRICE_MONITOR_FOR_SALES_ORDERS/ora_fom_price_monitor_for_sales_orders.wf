        {
          "metadata": {
            "errorNodeId": "1773826578512",
            "name": "Convert Return WF response to JSON",
            "returnType": "object",
            "sourceCode": "const input = JSON.parse($context.$nodes.INVOKE_RETURN_WF_TO_GET_DETAILS.$output.output);\n\nconst root = input?.items ?? input;\n\nconst status = input?.Status ?? \"SUCCESS\";\nconst message = input?.Message ?? null;\n\nconst output = {\n  Status: status,\n  Message: message,\n\n  returnOrderPayload: (() => {\n    const payload = root?.returnOrderPayload;\n    if (!payload) return null;\n\n    return {\n      ...payload,\n      returnOrderLines: Array.isArray(payload?.returnOrderLines)\n        ? payload.returnOrderLines\n        : []\n    };\n  })()\n};\n\n// Lookups\nconst allowedReasonCodes = $context.$nodes.GET_RETURN_REASON_CODES.$output.LookupData|| [];\nconst reasonLookup = new Map(\n  allowedReasonCodes\n    .filter(r => r?.LookupCode != null)\n    .map(r => [String(r.LookupCode).trim().toLowerCase(), r.Meaning ?? \"\"])\n);\n\nconst allowedReturnTypes = $context.$nodes.GET_RETURN_TYPES.$output.LookupData|| [];\nconst typeLookup = new Map(\n  allowedReturnTypes\n    .filter(t => t?.LookupCode != null)\n    .map(t => [String(t.LookupCode).trim().toLowerCase(), t.Meaning ?? \"\"])\n);\n\nfunction getMatchedValue(map, code) {\n  if (!code) return null;\n  const val = map.get(String(code).trim().toLowerCase());\n  return val && String(val).trim() !== \"\" ? val : null;\n}\n\nfunction toKey(v) {\n  return v == null ? null : String(v).trim();\n}\n\n// Your sorting logic\nconst parseLineNumber = (val) => {\n  if (!val) return { start: 0, end: 0, isRange: false };\n  const parts = String(val)\n    .split('-')\n    .map((x) => Number(x));\n  if (parts.length === 1) {\n    return { start: parts[0], end: parts[0], isRange: false };\n  }\n  return {\n    start: parts[0],\n    end: parts[1],\n    isRange: true\n  };\n};\nconst compareDisplayLineNumber = (a, b) => {\n  const aLine = parseLineNumber(a.DisplayLineNumber);\n  const bLine = parseLineNumber(b.DisplayLineNumber);\n  if (aLine.start !== bLine.start) {\n    return aLine.start - bLine.start;\n  }\n  if (aLine.isRange !== bLine.isRange) {\n    return aLine.isRange ? 1 : -1;\n  }\n  return aLine.end - bLine.end;\n};\n\n// Success case\nif (status !== \"ERROR\" && status !== \"UNHANDLED_ERROR\") {\n  const returnLines =Array.isArray(root?.returnOrderPayload?.returnOrderLines) \n  ? root.returnOrderPayload.returnOrderLines \n  : [];\n\n  const eligibleLines = Array.isArray(root?.eligibleLines)\n    ? root.eligibleLines\n    : [];\n\n  const nonEligibleLines = Array.isArray(root?.nonEligibleLines)\n    ? root.nonEligibleLines\n    : [];\n\n  const eligibleMap = new Map(\n    eligibleLines\n      .filter(l => l?.FulfillLineId != null)\n      .map(l => [toKey(l.FulfillLineId), l])\n  );\n\n  // Header-level attributes from root only\n  output.HeaderId = root?.HeaderId ?? null;\n  output.OrderNumber = root?.OrderNumber ?? null;\n  output.SoldToPartyName = root?.SoldToPartyName ?? null;\n  output.TransactionalCurrencyCode = root?.TransactionalCurrencyCode ?? null;\n\n  // Total\n  output.TotalAmount = eligibleLines.reduce((sum, l) => {\n    const amt = Number(l?.LineAmount);\n    return sum + (Number.isFinite(amt) ? amt : 0);\n  }, 0);\n\n  // Enriched lines\n  output.returnOrderLines = returnLines.map(line => {\n    const key = toKey(line?.FulfillLineId);\n    const match = eligibleMap.get(key) || null;\n\n    const reasonCode =\n      line?.ReturnReasonCode ??\n      match?.ReturnReasonCode ??\n      null;\n\n    const typeCode =\n      line?.ReturnTypeCode ??\n      line?.ReturnType ??\n      match?.ReturnTypeCode ??\n      match?.ReturnType ??\n      null;\n\n    return {\n      FulfillLineId: line?.FulfillLineId ?? null,\n      Quantity: line?.Quantity ?? match?.FulfilledQuantity ?? match?.OrderedQuantity ?? null,\n      OrderedUOMCode: line?.OrderedUOMCode ?? null,\n\n      ReturnReasonCode: reasonCode,\n      ReturnReasonMatchedValue:\n        match?.ReturnReasonMatchedValue ?? getMatchedValue(reasonLookup, reasonCode),\n\nReturnReasonMatchedValue:\n  match?.ReturnReasonMatchedValue &&\n  String(match.ReturnReasonMatchedValue).trim() !== \"\"\n    ? match.ReturnReasonMatchedValue\n    : getMatchedValue(reasonLookup, reasonCode) ||\n      reasonCode || null,\n      ReturnReasonMatchScore:\n        match?.ReturnReasonMatchScore ?? (reasonCode ? 100 : 0),\n\n      ReturnTypeCode: typeCode,\n      ReturnTypeMatchedValue:\n        match?.ReturnTypeMatchedValue ?? getMatchedValue(typeLookup, typeCode),\n      ReturnTypeMatchScore:\n        match?.ReturnTypeMatchScore ?? (typeCode ? 100 : 0)\n    };\n  });\n\n  // Preserve arrays\n  output.nonEligibleLines = nonEligibleLines;\n\n  // Counts\n  output.returnOrderLinesCount = returnLines.length;\n  output.eligibleLinesCount = eligibleLines.length;\n  output.nonEligibleLinesCount = nonEligibleLines.length;\n  \n  // Sort eligibleLines\n  const sortedEligibleLines = [...eligibleLines].sort(compareDisplayLineNumber);\n\n  output.eligibleLines = sortedEligibleLines;\n\noutput.orderLinesText =\n  output.returnOrderLinesCount === 0\n    ? `0 items`\n    : output.returnOrderLinesCount === 1\n    ? `1 item`\n    : `${output.returnOrderLinesCount} items`;\n\noutput.returnLinesText =\n  output.returnOrderLinesCount === 0\n    ? \"0 lines are eligible for return\"\n    : output.returnOrderLinesCount === 1\n    ? \"1 line is eligible for return\"\n    : `${output.returnOrderLinesCount} lines are eligible for return`;\n}\n\nreturn output;"
          },
          "outcomes": {
            "success": "1773826522229"
          },
          "code": "CONVERT_RETURN_WF_RESPONSE_TO_JSON",
          "id": "1775805685089",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1775367234187",
            "name": "Convert Cancel WF response to JSON",
            "returnType": "object",
            "sourceCode": "const input = JSON.parse($context.$nodes.INVOKE_CANCEL_WF.$output.output);\n\nconst payload = input.items;\n\n// Allowed Reason Codes lookup: LookupCode -> Meaning\nconst allowedReasonCodes = $context.$nodes.GET_CANCEL_REASON_CODES.$output.LookupData || [];\nconst reasonLookup = new Map(\n  allowedReasonCodes\n    .filter(r => r && r.LookupCode != null)\n    .map(r => [String(r.LookupCode).trim(), r.Meaning ?? \"\"])\n);\n\n// Default return reason/type values\nconst DEFAULT_RETURN_REASON_CODE =\n  $context.$nodes.GET_RETURN_REASON_AND_TYPE_MEANINGS.$output.result.returnReason.LookupCode;\n\nconst DEFAULT_RETURN_REASON_MEANING =\n  $context.$nodes.GET_RETURN_REASON_AND_TYPE_MEANINGS.$output.result.returnReason.Meaning;\n\nconst DEFAULT_RETURN_TYPE_CODE =\n  $context.$nodes.GET_RETURN_REASON_AND_TYPE_MEANINGS.$output.result.returnMethod.LookupCode;\n\nconst DEFAULT_RETURN_TYPE_MEANING =\n  $context.$nodes.GET_RETURN_REASON_AND_TYPE_MEANINGS.$output.result.returnMethod.Meaning;\n\nconst status = input?.Status ?? \"SUCCESS\";\nconst message = input?.Message ?? null;\n\nconst output = {};\noutput.Status = status;\noutput.Message = message;\n\n// Helper to populate CancelReasonMatchedValue at HEADER level\nfunction getMatchedReasonValue(code) {\n  if (code == null) return null;\n  const matchedMeaning = reasonLookup.get(String(code).trim());\n  return matchedMeaning != null && String(matchedMeaning).trim() !== \"\"\n    ? matchedMeaning\n    : null;\n}\n\n// YOUR preferred parsing logic\nconst parseLineNumber = (val) => {\n  if (!val) return { start: 0, end: 0, isRange: false };\n\n  const parts = String(val)\n    .split('-')\n    .map((x) => Number(x));\n\n  if (parts.length === 1) {\n    return { start: parts[0], end: parts[0], isRange: false };\n  }\n\n  return {\n    start: parts[0],\n    end: parts[1],\n    isRange: true\n  };\n};\n\n// YOUR comparator\nconst compareDisplayLineNumber = (a, b) => {\n  const aLine = parseLineNumber(a.DisplayLineNumber);\n  const bLine = parseLineNumber(b.DisplayLineNumber);\n\n  if (aLine.start !== bLine.start) {\n    return aLine.start - bLine.start;\n  }\n\n  if (aLine.isRange !== bLine.isRange) {\n    return aLine.isRange ? 1 : -1;\n  }\n\n  return aLine.end - bLine.end;\n};\n\n// Success case\nif (status !== \"ERROR\" && status !== \"UNHANDLED_ERROR\") {\n  const cancelAmount = Number(payload?.TotalEligibleCancelAmount || 0);\n  const returnAmount = Number(payload?.TotalEligibleReturnAmount || 0);\n\n  const cancelLines = Array.isArray(payload?.cancelEligibleLines)\n    ? payload.cancelEligibleLines\n    : [];\n\n  const returnLines = Array.isArray(payload?.returnEligibleLines)\n    ? payload.returnEligibleLines\n    : [];\n\n  const nonEligibleLines = payload?.nonEligibleLines ?? [];\n\n  const cancelCount = cancelLines.length;\n  const returnCount = returnLines.length;\n  const nonEligibleCount = nonEligibleLines.length;\n\n  output.HeaderId = payload?.HeaderId ?? null;\n  output.OrderNumber = payload?.OrderNumber ?? null;\n  output.SoldToPartyName = payload?.SoldToPartyName ?? null;\n  output.TransactionalCurrencyCode = payload?.TransactionalCurrencyCode ?? null;\n\n  // HEADER LEVEL Cancel Reason\n  const headerReasonCode = $context.$nodes.EXTRACT_CANCEL_ORDER_DETAILS.$output.CancelReasonCode;\n  output.CancelReasonCode = headerReasonCode;\n  output.CancelReasonMatchedValue = getMatchedReasonValue(headerReasonCode);\n\n  // TRANSFORM cancelEligibleLinesPaylod → requests structure\n  const cancelRequest = Array.isArray(payload?.cancelEligibleLinesPaylod)\n    ? payload.cancelEligibleLinesPaylod.map(line => ({\n        FulfillLineId: line?.FulfillLineId,\n        HeaderId: line?.HeaderId ?? payload?.HeaderId\n      }))\n    : [];\n\n  output.cancelEligibleLinesPaylod = JSON.stringify({\n    requests: cancelRequest,\n    CancelReasonCode: headerReasonCode\n  });\n\n  // SORT cancelEligibleLines\n  const sortedCancelLines = [...cancelLines].sort(compareDisplayLineNumber);\n\n  // SORT returnEligibleLines\n  const sortedReturnLines = [...returnLines].sort(compareDisplayLineNumber);\n\n  output.cancelEligibleLines = sortedCancelLines;\n  output.nonEligibleLines = nonEligibleLines;\n\n  output.returnEligibleLines = sortedReturnLines.map(line => ({\n    ...line,\n    ReturnReasonMeaning: DEFAULT_RETURN_REASON_MEANING,\n    ReturnTypeMeaning: DEFAULT_RETURN_TYPE_MEANING\n  }));\n\n  // Build returnEligibleLinesPaylod\n  const returnOrderLines = Array.isArray(payload?.returnEligibleLinesPaylod)\n    ? payload.returnEligibleLinesPaylod.map(line => ({\n        FulfillLineId: line?.FulfillLineId ?? null,\n        Quantity: line?.Quantity ?? null,\n        ReturnReasonCode: DEFAULT_RETURN_REASON_CODE,\n        ReturnType: DEFAULT_RETURN_TYPE_CODE,\n        OrderedUOMCode: line?.OrderedUomCode ?? null\n      }))\n    : [];\n  output.returnEligibleLinesPaylod = {\n    HeaderId: payload?.HeaderId ?? null,\n    returnOrderLines\n  };\n\n  // Counts\n  output.cancelEligibleLinesCount = cancelCount;\n  output.returnEligibleLinesCount = returnCount;\n  output.nonEligibleLinesCount = nonEligibleCount;\n\n  // Total lines (cancel + return only)\n  output.totalLinesCount = cancelCount + returnCount;\n\n  // Total Amount\n  output.TotalAmount = cancelAmount + returnAmount;\n\n  // Helper for singular/plural\n  function getLineText(count, singular, plural) {\n    return `${count} ${count === 1 ? singular : plural}`;\n  }\n\n  output.orderLinesText = `${getLineText(output.totalLinesCount, \"item\", \"items\")}`;\n\n  output.cancelLinesText =\n    cancelCount === 1\n      ? \"1 line is eligible for cancel\"\n      : `${cancelCount} lines are eligible for cancel`;\n\n  output.returnLinesText =\n    returnCount === 1\n      ? \"1 line is eligible for return\"\n      : `${returnCount} lines are eligible for return`;\n}\n\nreturn output;"
          },
