            "errorNodeId": "1770069207483",
            "name": "Parse_Action",
            "returnType": "array",
            "sourceCode": "const str = $context.$triggers.REST.$input.OraAction;\nconst payload = JSON.parse(str);\nconst action = payload. actionCode;\nlet array =[];\narray.push(action);\narray.push(payload);\nreturn array;"
          },
