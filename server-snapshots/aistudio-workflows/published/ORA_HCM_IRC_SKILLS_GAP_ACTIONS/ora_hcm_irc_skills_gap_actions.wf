            "success": "1765651099665"
          },
          "code": "PARSEACTION",
          "id": "1765404114355",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": null,
            "name": "PARSE_DATA",
            "returnType": "object",
            "sourceCode": "const data = $context.$triggers.REST.$input.data;\nconst json = JSON.parse(data);\n\nreturn json;"
          },
