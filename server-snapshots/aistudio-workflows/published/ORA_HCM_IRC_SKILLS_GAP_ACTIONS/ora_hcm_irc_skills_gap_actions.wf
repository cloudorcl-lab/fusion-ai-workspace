              "name": "learningItemId",
              "type": "string",
              "value": "{{$context.$variables.payload.learningItemId}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"description\": \"\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"learningItemId\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"learningItemNumber\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"learningItemType\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"learningItemTypeMeaning\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"learningItemTitle\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"learningItemDescription\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"liShortDescription\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"learningItemRatingAverage\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemRatingCount\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemPublishedDate\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"learningItemPublishedSince\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"learningItemPublishedSinceUnits\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"learningItemMinimumPrice\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemMaximumPrice\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemPriceCurrency\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemLastModifiedDate\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"learningItemPublisherDisplayName\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItem