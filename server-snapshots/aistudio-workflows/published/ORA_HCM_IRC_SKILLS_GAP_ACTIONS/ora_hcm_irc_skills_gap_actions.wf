": {},\n      \"required\": []\n    },\n    \"learningItemInstructorDisplayName\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemInstructorPersonNumber\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemInstructorEmailAddress\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemCoordEmailAddress\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemCoordDisplayName\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemBusinessDriver\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemLearningLevel\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemCoordPersonId\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemAuthorPersonId\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemInstructorPersonId\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemInstructorPhoneNumber\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemAuthorPhoneNumber\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemCoordPhoneNumber\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemSourcePublishedDate\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemAvailableCapacity\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"isWaitlistEnabled\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemStartDateUTC\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemEndDateUTC\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemTimezone\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemAvailableWaitlistCapacity\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemTrailerLink\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemCoverArtLink\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"learningItemDetailsDeepLink\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"learningItemDetailsEmbedLink\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"learningItemIsNewFlag\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"learningItemViewCount\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"learningItemThumbnailLink\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"learningItemPublishedSinceUnitsMeaning\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"learningItemTrailerThumbnailLink\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemSelfEnrollmentURL\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"learningItemProviderTypeMeaning\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemAuthorTypeMeaning\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"learningItemInstructorTypeMeaning\": {\n      \"ty