          "code": "VERIFYIFFEEDBACKRECEIVEDFORREPORTS",
          "id": "1770110615365",
          "inputs": [
            {
              "id": "1770110615366_1",
              "name": "prompt",
              "type": "string",
              "value": "\"FeedbackVariable\" - {{$context.$nodes.HUMANAPPROVALNODE.$feedbackRecieved}}\n\n\"DirectReportsArray\" - {{$context.$variables.directReports}} \n\n\"DirectReportsArray\" is an Array of Objects - Like a collection item. Each Object in the Array corresponds to a particular direct report, and you could see the report's related data in each object. \n\nAll the direct reports will be there in this Array - \"DirectReportsArray\".\n\nTask:\n\n1) If the \"FeedbackVariable\" is empty, null, or undefined, then assign \"DirectReportsArray\" to the \"DirectReportsToPromote\" output variable **exactly as it is** without any modifications or filtering.\n\n2) Else if the \"FeedbackVariable\" is non-empty:\n - This FeedbackVariable will contain a list of AssignmentNumbers.\n - Extract the Assignment Numbers and filter the \"DirectReportsArray\" Array with these AssignmentNumbers and assign it to the \"DirectReportsToPromote\" output variable. \n - Strictly do not modify any fields inside the objects (including WorkerType, profileCompletenessRanking, ManagerNotesAndFeedback, FinalConsolidatedSummary etc); only filter the array.\n - STRICTLY Preserve original input order."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"Generated Schema\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"DirectReportsToPromote\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"result\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"isPendingTxnPresent\": {\n                \"type\": \"boolean\"\n              },\n              \"WorkerType\": {\n                \"type\": \"string\"\n              },\n              \"profileCompletenessRanking\": {\n                \"type\": \"integer\"\n              },\n              \"RequiredEnterpriseSeniority\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"GeneralRulesForPromotion\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"GeneralRulesForPromotionAreViolated\": {\n                \"type\": \"boolean\"\n              },\n              \"EnterpriseSeniority\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"SalaryHikePercent\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"ConfigurationObject\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"AssignmentMap\": {\n                    \"type\": \"object\"\n                  },\n                  \"ProfileOptionsMap\": {\n                    \"type\": \"object\"\n                  },\n                  \"ActionOccurrenceMap\": {\n                    \"type\": \"object\"\n                  },\n                  \"SeniorityMap\": {\n                    \"type\": \"object\"\n                  }\n                },\n                \"required\": [\n                  \"AssignmentMap\",\n                  \"ProfileOptionsMap\",\n                  \"ActionOccurrenceMap\",\n                  \"SeniorityMap\"\n                ]\n              },\n              \"ProposedBusinessTitle\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"CurrentSalaryAmountWithCurrencyCodeAndSalaryBasis\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"CurrentSalaryAmountWithCurrencyCode\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"ProposedSalaryAmountWithCurrencyCodeAndSalaryBasis\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"ProposedSalaryAmountWithCurrencyCode\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"SalaryBasisName\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"CurrencyCode\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"RequiredJobSeniority\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"RequiredPerformanceRating\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"ProposedJobName\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"ProposedJobId\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"CurrentJobName\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"IsPerformanceRatingSatisfied\": {\n                \"type\": \"boolean\"\n              },\n              \"IsJobSenioritySatisfied\": {\n                \"type\": \"boolean\"\n              },\n              \"IsEnterpriseSenioritySatisfied\": {\n                \"type\": \"boolean\"\n              },\n              \"SalaryAmount\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"PersonId\": {\n                \"type\": \"integer\"\n              },\n              \"AssignmentId\": {\n                \"type\": \"integer\"\n              },\n              \"SalaryBasisId\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"DisplayName\": {\n                \"type\": \"string\"\n              },\n              \"PersonNumber\": {\n                \"type\": \"string\"\n              },\n              \"AssignmentNumber\": {\n                \"type\": \"string\"\n              },\n              \"CurrentBusinessTitle\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"JobSeniority\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"PerformanceRating\": {\n                \"type\": [\"string\", \"null\"]\n              },\n              \"ManagerNotesAndFeedback\": {\n                \"type\": \"object\"\n              },\n              \"ConnectionFeedback\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"OverallSentimentLabel\": {\n                    \"type\": \"string\"\n                  },\n                  \"OverallSentimentScore\": {\n                    \"type\": \"integer\"\n                  },\n                  \"FinalConsolidatedSummary\": {\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"OverallSentimentLabel\",\n                  \"OverallSentimentScore\",\n                  \"FinalConsolidatedSummary\"\n                ]\n              }\n            },\n            \"required\": [\n              \"isPendingTxnPresent\",\n              \"WorkerType\",\n              \"profileCompletenessRanking\",\n              \"RequiredEnterpriseSeniority\",\n              \"GeneralRulesForPromotion\",\n              \"GeneralRulesForPromotionAreViolated\",\n              \"SalaryHikePercent\",\n              \"ConfigurationObject\",\n              \"ProposedBusinessTitle\",\n              \"RequiredJobSeniority\",\n              \"RequiredPerformanceRating\",\n              \"ProposedJobName\",\n              \"ProposedJobId\",\n              \"CurrentJobName\",\n              \"IsPerformanceRatingSatisfied\",\n              \"IsJobSenioritySatisfied\",\n              \"IsEnterpriseSenioritySatisfied\",\n              \"PersonId\",\n              \"AssignmentId\",\n              \"DisplayName\",\n              \"PersonNumber\",\n              \"AssignmentNumber\",\n              \"CurrentBusinessTitle\",\n              \"ManagerNotesAndFeedback\",\n              \"ConnectionFeedback\"\n            ]\n          }\n        },\n        \"required\": [\n          \"result\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"DirectReportsToPromote\"\n  ]\n}",
          "type": "LLM"
        },
