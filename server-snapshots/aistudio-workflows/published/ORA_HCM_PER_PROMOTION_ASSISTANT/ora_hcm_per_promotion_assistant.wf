        {
          "metadata": {
            "name": "prepareSalaryInput",
            "returnType": "object",
            "sourceCode": "let salaryObj = {\n    \"mode\": \"string\",\n    \"assignmentId\": $context.$variables.WorkerSearchResponse.singleMatchingRecord.AssignmentId,\n    \"effectiveDate\": $context.$variables.userInputs.EffectiveDate,\n    \"inputParams\": {\n        \"FlowName\": \"coreHrVBflow\",\n        \"FlowType\": \"Promotion\",\n        \"ActionId\": $context.$variables.assignmentWorkflowResponse.AgentResponse.ActionId,\n        \"GradeId\": $context.$variables.assignmentWorkflowResponse.AgentResponse.GradeId,\n        \"LocationId\": $context.$variables.assignmentWorkflowResponse.AgentResponse.EmploymentConfigurationsObject.AssignmentMap.LocationId,\n        \"BusinessUnitId\": $context.$variables.assignmentWorkflowResponse.AgentResponse.EmploymentConfigurationsObject.AssignmentMap.BusinessUnitId,\n        \"JobId\": $context.$variables.assignmentWorkflowResponse.AgentResponse.JobId,\n        \"LegalEntityId\": $context.$variables.assignmentWorkflowResponse.AgentResponse.EmploymentConfigurationsObject.AssignmentMap.LegalEntityId\n    },\n    \"salaryParams\": {\n        \"AdjustmentAmount\": $context.$variables.userInputs.SalaryAdjustmentAmount,\n        \"AdjustmentPercentage\": $context.$variables.userInputs.SalaryAdjustmentPercentage,\n        \"SalaryAmount\": $context.$variables.userInputs.SalaryAmount\n    }\n}\n\n\nreturn salaryObj"
          },
          "outcomes": {
            "success": "1771590187533"
          },
