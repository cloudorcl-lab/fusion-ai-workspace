        {
          "metadata": {
            "name": "prepareConfirmationScreenVariables",
            "returnType": "object",
            "sourceCode": "let confirmationScreenOutputs = {} ;\nconfirmationScreenOutputs.managerAssignmentNotes =  $context.$variables.AssignmentNotes || \"Not Available\"\nconfirmationScreenOutputs.connectionsComments = $context.$variables.assignmentWorkflowResponse.ConnectionFeedback.FinalConsolidatedSummary\nconfirmationScreenOutputs.connectionsFeedbackScore =  $context.$variables.assignmentWorkflowResponse.ConnectionFeedback.OverallSentimentScore\nconfirmationScreenOutputs.connectionsFeedbackLabel =  $context.$variables.assignmentWorkflowResponse.ConnectionFeedback.OverallSentimentLabel\n\nconfirmationScreenOutputs.Action = $context.$variables.assignmentWorkflowResponse.AgentResponse.ActionName \nconfirmationScreenOutputs.defaultAction = $context.$variables.assignmentWorkflowResponse.AgentResponse.EmploymentConfigurationsObject.ActionOccurrenceMap.ActionName\nconfirmationScreenOutputs.ActionReason= $context.$variables.assignmentWorkflowResponse.AgentResponse.ActionReasonName || \"Not Available\"\nconfirmationScreenOutputs.CurrentJobName= $context.$variables.assignmentWorkflowResponse.AgentResponse.EmploymentConfigurationsObject.AssignmentMap.JobName || '-'\nconfirmationScreenOutputs.ProposedJobName= $context.$variables.assignmentWorkflowResponse.AgentResponse.JobName || '-'\nconfirmationScreenOutputs.CurrentGradeName= $context.$variables.assignmentWorkflowResponse.AgentResponse.EmploymentConfigurationsObject.AssignmentMap.GradeName || '-'\nconfirmationScreenOutputs.ProposedGradeName= $context.$variables.assignmentWorkflowResponse.AgentResponse.GradeName || '-'\nconfirmationScreenOutputs.CurrentBusinessTitle= $context.$variables.assignmentWorkflowResponse.AgentResponse.EmploymentConfigurationsObject.AssignmentMap.BusinessTitle || '-'\nconfirmationScreenOutputs.ProposedBusinessTitle= $context.$variables.userInputs.BusinessTitle || $context.$variables.assignmentWorkflowResponse.AgentResponse.JobName || '-'\nconfirmationScreenOutputs.JobSeniority= $context.$variables.assignmentWorkflowResponse.AgentResponse.JobSeniority || 'Not Available'\nconfirmationScreenOutputs.EnterpriseSeniority= $context.$variables.assignmentWorkflowResponse.AgentResponse.EnterpriseSeniority || 'Not Available'\nconfirmationScreenOutputs.PerformanceRating= $context.$variables.assignmentWorkflowResponse.AgentResponse.PerformanceRating || 'Not Available'\nconfirmationScreenOutputs.EffectiveDate= $context.$variables.userInputs.EffectiveDate \nconfirmationScreenOutputs.DisplayName= $context.$variables.WorkerSearchResponse.singleMatchingRecord.DisplayName\nconfirmationScreenOutputs.PromotionCriteriaDocumentEligibility= $context.$variables.assignmentWorkflowResponse.AgentResponse.eligibleAsPerPromotionCriteriaDocument == true? \"Yes\" : \"No\"\nconfirmationScreenOutputs.CollectiveAgreementDocumentEligibility= $context.$variables.assignmentWorkflowResponse.AgentResponse.eligibleAsPerPromotionComplainceDocument == true ? \"Yes\" : \"No\"\nconfirmationScreenOutputs.PromotionCriterias = {\"requiredJobSeniority\" : $context.$variables.assignmentWorkflowResponse.AgentResponse.requiredJobSeniorityAsPerCriteriaDocument,\"requiredPerformanceRating\":$context.$variables.assignmentWorkflowResponse.AgentResponse.requiredPerformanceRatingAsPerCriteriaDocument}\nconfirmationScreenOutputs.ComplianceCriterias = {\"requiredEnterpriseSeniority\" : $context.$variables.assignmentWorkflowResponse.AgentResponse.requiredEnterpriseSeniorityAsPerCompliance}\n\n\n//salary details\nlet salaryOutput = $context.$variables.salaryWorkflowResponse\nlet currSalaryDetails = $context.$nodes.PARSECURRENTSALARYOUTPUT.$output?.result\nif(salaryOutput && salaryOutput.newSalary != null && salaryOutput.newSalary != undefined)\n{\n confirmationScreenOutputs.renderSalaryChanges = true\n confirmationScreenOutputs.CurrentSalary = currSalaryDetails.currentSalary.SalaryAmount\n confirmationScreenOutputs.ProposedSalary = salaryOutput.newSalary.SalaryAmount\n}\n\n\n\nif(salaryOutput && salaryOutput.error!= null )\n{\n confirmationScreenOutputs.renderSalaryError = true\n confirmationScreenOutputs.salaryErrorMessage = salaryOutput.error\n}\n\nreturn confirmationScreenOutputs;"
          },
          "outcomes": {
            "success": "1762450136067"
          },
