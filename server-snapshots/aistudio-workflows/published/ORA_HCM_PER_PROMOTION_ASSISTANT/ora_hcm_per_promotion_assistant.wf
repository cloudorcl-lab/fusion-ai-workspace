          "outcomes": {
            "success": "1767935855909"
          },
          "code": "PARSE_UPLOADED_DIRECT_REPORTS_TOOL",
          "convergenceTargetId": "1767935855909",
          "id": "1769769930150",
          "inputs": [
            {
              "id": "1769769930151_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a data extraction engine.\n\nYou will be given a document that may contain a table with the following columns:\n- Current Job\n- Proposed Job\n- Proposed Salary Hike\n\nDocument - {{$context.$nodes.PROMOTION_CONFIGURATION_DOCUMENT.$output.value}} \n\nYour task is to extract the table data and return it strictly as a JSON array of objects and assign it to \"DirectReportsDocument\".\n\nRules:\n1. Return ONLY valid JSON. Do not include explanations, comments, or markdown.\n2. Each row in the table must be converted into one object in the array.\n3. Each object must have exactly these keys:\n   - \"currentJob\"\n   - \"proposedJob\"\n   - \"salaryHikePercent\"\n4. The value of \"salaryHikePercent\" must be a number (integer or decimal) without the % symbol.\n5. Preserve the row order as it appears in the document.\n6. If a cell is empty or missing, use null.\n7. If no valid table is found, return an empty array [].\n\nOutput format example:\n\n[\n  {\n    \"currentJob\": \"Example Role A\",\n    \"proposedJob\": \"Example Role B\",\n    \"salaryHikePercent\": 10\n  }\n]\n\nNow process the uploaded document and produce the JSON output."
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"DirectReportsDocument\": {\n            \"type\": \"array\",\n            \"items\": {\n                \"type\": \"object\",\n                \"properties\": {}\n            }\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "PrepareSubmissionPayload",
            "returnType": "array",
            "sourceCode": "let effectiveDate = $context.$variables.userInputs.EffectiveDate\nlet displayName = $context.$variables.userInputs.DisplayName\nlet userInputs = $context.$variables.userInputs\nlet rawData = $context.$variables.assignmentWorkflowResponse;\nlet empObject = rawData.AgentResponse.EmploymentConfigurationsObject;\nlet PersonId = empObject.AssignmentMap.PersonId;\nlet AssignmentId = empObject.AssignmentMap.AssignmentId;\nlet PeriodOfServiceId = empObject.AssignmentMap.PeriodOfServiceId;\nlet proposedBusinessTitle = $context.$nodes.ANALYSEUSERQUERY.$output.BusinessTitle || rawData.AgentResponse.JobName\nlet proposedJobId = rawData.AgentResponse.JobId != \"\" && rawData.AgentResponse.JobId != \"NA\" ? rawData.AgentResponse.JobId: null \nlet proposedGradeId = rawData.AgentResponse.GradeId != \"\" && rawData.AgentResponse.GradeId != \"NA\" ? rawData.AgentResponse.GradeId : null\nlet proposedActionCode = rawData.AgentResponse.ActionCode || empObject.ActionOccurrenceMap.ActionCode;\nlet proposedActionReasonCode = rawData.AgentResponse.ActionReasonCode != \"NA\" && rawData.AgentResponse.ActionReasonCode != \"\" ?  rawData.AgentResponse.ActionReasonCode: null;\nlet proposedActionId = rawData.AgentResponse.ActionId || empObject.ActionOccurrenceMap.ActionId;\nlet proposedActionReasonId = rawData.AgentResponse.ActionReasonId != \"\" && rawData.AgentResponse.ActionReasonId != \"NA\" ? rawData.AgentResponse.ActionReasonId: null ;\nlet reentryDeeplinkobjKey = \"pAssignmentId=\" + AssignmentId + \";pEffectiveDate=\" + effectiveDate + \";pDisplayName=\" + displayName + \";pPersonId=\" + PersonId + \";pBusinessTitle=\" + empObject.AssignmentMap.BusinessTitle + \";pAssignmentNumber=\" + empObject.AssignmentMap.AssignmentNumber\nlet salaryUpdated = $context.$nodes.ANALYSEUSERQUERY.$output.isSalaryUpdated\nlet salaryResponse = $context.$variables.salaryWorkflowResponse;\nlet peerFeedback = $context.$nodes.PREPARECONFIRMATIONSCREENVARIABLES.$output.result.connectionsComments;\nlet result = \"\"\nif(peerFeedback != null && peerFeedback != undefined && peerFeedback != \"\" )\n{\nlet notes = $context.$variables.AssignmentNotes+\"\\n\\n\"+\"<b>Peer Feedback Summary:</b> \"+$context.$nodes.PREPARECONFIRMATIONSCREENVARIABLES.$output.result.connectionsComments;\nconst paragraphs = notes.split('\\n\\n'); \nconst htmlParagraphs = paragraphs.map(paragraph => `<p>${paragraph}</p>`); \nresult = htmlParagraphs.join(''); \n}\nelse\n{\nlet notes = $context.$variables.AssignmentNotes;\nconst paragraphs = notes.split('\\n\\n'); \nconst htmlParagraphs = paragraphs.map(paragraph => `<p>${paragraph}</p>`); \nresult = htmlParagraphs.join(''); \n}\n\n\nlet assignmentPart = {\n    \"payload\": {\n        \"inputParameterMap\": {\n            \"DisplayName\": displayName,\n            \"PersonId\": PersonId,\n            \"AssignmentId\": AssignmentId,\n            \"EffectiveDate\": effectiveDate,\n            \"PersonNumber\": \"\",\n            \"ModuleIdentifier\": \"Promotions\",\n            \"EffectiveStartDate\": empObject.AssignmentMap.EffectiveStartDate,\n            \"EffectiveEndDate\": empObject.AssignmentMap.EffectiveEndDate,\n            \"EffectiveLatestChange\": empObject.AssignmentMap.EffectiveLatestChange,\n            \"EffectiveSequence\": empObject.AssignmentMap.EffectiveSequence,\n        },\n        \"hcmParams\": {\n            \"EMP_Groovy_ActionTypeCode\": [\n                \"String\",\n                \"EMPL_PROMOTION\"\n            ],\n            \"EMP_Groovy_ActionCode\": [\n                \"String\",\n                proposedActionCode\n            ],\n            \"EMP_Groovy_ActionReasonCode\": [\n                \"String\",\n                proposedActionReasonCode\n            ],\n            \"EMP_Groovy_ACT_OCC_ASSIGNMENT_ID\": [\n                \"Long\",\n                AssignmentId\n            ],\n            \"EMP_Groovy_ACT_OCC_PERIOD_OF_SERVICE_ID\": [\n                \"String\",\n                empObject.AssignmentMap.PeriodOfServiceId\n            ],\n            \"EMP_Groovy_ACT_OCC_PERSON_ID\": [\n                \"Long\",\n                PersonId\n            ],\n            \"AssignmentId\": [\n                \"Long\",\n                AssignmentId\n            ],\n            \"EMP_Groovy_LegalEntityId\": [\n                \"Long\",\n                empObject.AssignmentMap.LegalEntityId\n            ],\n            \"EMP_Groovy_PeriodType\": [\n                \"String\",\n                \"E\"\n            ],\n            \"EMP_Groovy_LegislationCode\": [\n                \"String\",\n                empObject.AssignmentMap.LegislationCode\n            ],\n            \"ModuleIdentifier\": [\n                \"String\",\n                \"Promotions\"\n            ],\n            \"EMP_ModuleIdentifier\": [\n                \"String\",\n                \"Promotions\"\n            ],\n            \"EMP_Groovy_NewLegalEntityId\": [\n                \"Long\",\n                empObject.AssignmentMap.LegalEntityId\n            ],\n            \"EMP_Groovy_NewLegislationCode\": [\n                \"String\",\n                empObject.AssignmentMap.LegislationCode\n            ],\n            \"EMP_AssignmentId\": [\n                \"Long\",\n                AssignmentId\n            ],\n            \"isHDLWorker\": [\n                \"String\",\n                \"N\"\n            ]\n        },\n        \"assignmentModifiedAttributes\": {\n            \"EffectiveOfDate\": effectiveDate,\n            \"ActionCode\": proposedActionCode,\n            \"ReasonCode\": proposedActionReasonCode,\n            \"JobSetId\": empObject.AssignmentMap.JobSetId,\n            \"GradeSetId\": empObject.AssignmentMap.GradeSetId,\n            \"LocationSetId\": empObject.AssignmentMap.LocationSetId,\n            \"DepartmentSetId\": empObject.AssignmentMap.DepartmentSetId,\n            \"RecordCreator\": \"VB_Promotions\",\n            \"ActionOccurrenceId\": empObject.ActionOccurrenceMap.ActionOccurrenceId,\n            \"ActionTypeCode\": \"EMPL_PROMOTION\",\n            \"AsgInformationCategory\": empObject.AssignmentMap.LegislationCode,\n            \"AssAttributeCategory\": null\n        },\n        \"positionAttributes\": {},\n        \"actionOccurrenceMap\": {\n            \"ActionOccurrenceId\": empObject.ActionOccurrenceMap.ActionOccurrenceId,\n            \"ActionId\": proposedActionId,\n            \"ActionDate\": effectiveDate,\n            \"ActionReasonId\": proposedActionReasonId,\n            \"ProposedStartDate\": null,\n            \"BusinessUnitId\": empObject.AssignmentMap.BusinessUnitId,\n            \"PositionId\": empObject.AssignmentMap.PositionId,\n            \"EntityId\": AssignmentId,\n            \"EntityType\": \"ASSIGNMENT\",\n            \"ParentEntityKeyId\": PersonId,\n            \"ParentEntityType\": \"PERSON\",\n            \"ParentEntityName\": displayName,\n            \"ActionTypeCode\": \"EMPL_PROMOTION\",\n            \"ActionCode\": proposedActionCode,\n            \"ActionName\": \"Promotion\",\n            \"ActionReasonCode\": proposedActionReasonCode\n        },\n        \"operation\": \"submit\"\n    },\n    \"id\": \"assignmentPart\",\n    \"operation\": \"invoke\",\n    \"path\": \"/employmentAssignments/action/performOperationAndValidation\",\n    \"effectiveOf\": \"RangeStartDate=\" + effectiveDate\n}\n\nlet assignmentNotesPart = {\n            \"payload\": {\n                \"AsgEffectiveStartDate\": effectiveDate,\n                \"AssignmentId\":  AssignmentId,\n                \"AsgEffectiveSequence\": 1,\n                \"Notes\":  result\n            },\n            \"id\": \"assignmentNotes\",\n            \"operation\": \"create\",\n            \"path\": \"/assignmentNotes\"\n        }\n\nlet salaryPart = {}\n\nlet reloadInputData = {}\nreloadInputData.SubmittedFrom = \"AgentPromotions\"\nreloadInputData.ActionOccurrenceId = empObject.ActionOccurrenceMap.ActionOccurrenceId\nreloadInputData.ActionId = proposedActionId\nreloadInputData.ActionCode = proposedActionCode\nreloadInputData.ActionTypeCode = \"EMPL_PROMOTION\"\nreloadInputData.ActionReasonId = proposedActionReasonId\nreloadInputData.ReasonCode = proposedActionReasonCode\nreloadInputData.ActionDate = effectiveDate\nreloadInputData.BusinessUnitId = empObject.AssignmentMap.BusinessUnitId\nreloadInputData.JobSetId = empObject.AssignmentMap.JobSetId\nreloadInputData.GradeSetId = empObject.AssignmentMap.JobSetId\nreloadInputData.LocationSetId = empObject.AssignmentMap.JobSetId\nreloadInputData.DepartmentSetId = empObject.AssignmentMap.JobSetId\nreloadInputData.EffectiveDate = effectiveDate\n\nlet storeTxnPart = {\n    \"id\": \"storeTxnData\",\n    \"operation\": \"invoke\",\n    \"path\": \"/employmentAssignments/action/processEmploymentTransactionData\",\n    \"payload\": {\n        \"operation\": \"storeTransactionData\",\n        \"inputParameterMap\": {\n            \"ReloadInputData\": \"\",\n            \"EffectiveDate\": effectiveDate\n        }\n    }\n}\n\nlet submitPart = {\n    \"id\": \"submit\",\n    \"operation\": \"create\",\n    \"payload\": {\n        \"OperationType\": \"SubmitForApproval\"\n    },\n    \"path\": \"/businessProcessTransactionContextInformation\"\n}\n\nlet partsArray = [{\n    \"payload\": {\n        \"ModuleIdentifier\": \"Promotions\",\n        \"Object\": \"PER_ALL_ASSIGNMENTS_M\",\n        \"ReentryDeeplinkObjType\": \"PROMOTE\",\n        \"ReentryDeeplinkAction\": \"EDIT_IN_VB\",\n        \"ReentryDeeplinkObjKey\": reentryDeeplinkobjKey,\n        \"ObjectId\": AssignmentId,\n        \"OperationType\": \"ContextInitialization\",\n        \"ApplicationId\": 800,\n        \"ModuleGroup\": \"PER\",\n        \"Subject\": \"PER_PERSONS\",\n        \"SubjectId\": PersonId,\n        \"TransactionContextAdditionalAttributes\": [\n            {\n                \"Name\": \"Attribute30\",\n                \"Value\": \"VbAppUi\"\n            },\n            {\n                \"Name\": \"Attribute10\",\n                \"Value\": \"Mobile\"\n            }\n        ],\n        \"TransactionContextPayloadSequence\": [\n            {\n                \"Name\": \"oracle_hcm_employmentprocessUI:combined_when_and_why_fragment\",\n                \"Sequence\": 1,\n                \"VBResourceName\": \"/vbcs/hcm/employment-processui/fragments/combined_when_and_why_fragment\"\n            },\n            {\n                \"Name\": \"oracle_hcm_employmentprocessUI:combined_position_override_fragment\",\n                \"Sequence\": 2,\n                \"VBResourceName\": \"/vbcs/hcm/employment-processui/fragments/combined_position_override_fragment\"\n            },\n            {\n                \"Name\": \"oracle_hcm_employmentprocessUI:combined_additional_assignment_info_fragment\",\n                \"Sequence\": 3,\n                \"VBResourceName\": \"/vbcs/hcm/employment-processui/fragments/combined_additional_assignment_info_fragment\"\n            },\n            {\n                \"Name\": \"oracle_hcm_employmentprocessUI:combined_assignment_fragment\",\n                \"Sequence\": 4,\n                \"VBResourceName\": \"/vbcs/hcm/employment-processui/fragments/combined_assignment_fragment\"\n            },\n            {\n                \"Name\": \"oracle_hcm_employmentprocessUI:combined_weeklyworkinghours_fragment\",\n                \"Sequence\": 5,\n                \"VBResourceName\": \"/vbcs/hcm/employment-processui/fragments/combined_weeklyworkinghours_fragment\"\n            },\n            {\n                \"Name\": \"oracle_hcm_employmentprocessUI:combined_maintain_managers_fragment\",\n                \"Sequence\": 6,\n                \"VBResourceName\": \"/vbcs/hcm/employment-processui/fragments/combined_maintain_managers_fragment\"\n            },\n            {\n                \"Name\": \"oracle_hcm_employmentprocessUI:combined_contracts_fragment\",\n                \"Sequence\": 7,\n                \"VBResourceName\": \"/vbcs/hcm/employment-processui/fragments/combined_contracts_fragment\"\n            },\n            {\n                \"Name\": \"oracle_hcm_payrollrelationshipspublicUI:payrolldetails\",\n                \"Sequence\": 8,\n                \"VBResourceName\": \"/vbcs/hcm/payroll-relationships-publicui/fragments/payrolldetails\"\n            },\n            {\n                \"Name\": \"oracle_hcm_compensationpublicUI:create-salary\",\n                \"Sequence\": 9,\n                \"VBResourceName\": \"/vbcs/hcm/compensation-publicui/fragments/create-salary\"\n            },\n            {\n                \"Name\": \"oracle_hcm_compensationpublicUI:individual-compensation\",\n                \"Sequence\": 10,\n                \"VBResourceName\": \"/vbcs/hcm/compensation-publicui/fragments/individual-compensation-section\"\n            },\n            {\n                \"Name\": \"oracle_hcm_employmentprocessUI:combined_reassign_directs_fragment\",\n                \"Sequence\": 11,\n                \"VBResourceName\": \"/vbcs/hcm/employment-processui/fragments/combined_reassign_directs_fragment\"\n            },\n            {\n                \"Name\": \"oracle_hcm_employmentprocessUI:combined_add_directs_fragment\",\n                \"Sequence\": 12,\n                \"VBResourceName\": \"/vbcs/hcm/employment-processui/fragments/combined_add_directs_fragment\"\n            },\n            {\n                \"Name\": \"oracle_hcm_documentrecordspublicUI:document-records\",\n                \"Sequence\": 13,\n                \"VBResourceName\": \"/vbcs/hcm/document-records-public-ui/fragments/document-records\"\n            },\n            {\n                \"Name\": \"oracle_hcm_transactionpublicUI:approval-comment-attachments\",\n                \"Sequence\": 14,\n                \"VBResourceName\": \"/vbcs/hcm/transaction-publicui/fragments/approval-comment-attachments\"\n            },\n            {\n                \"Name\": \"oracle_hcm_employmentpublicUI:senioritydates_fragment\",\n                \"Sequence\": 15,\n                \"VBResourceName\": \"/vbcs/hcm/employment-publicui/fragments/senioritydates_fragment\"\n            },\n            {\n                \"Name\": \"oracle_hcm_employmentprocessUI:seniority_dates_fragment\",\n                \"Sequence\": 16,\n                \"VBResourceName\": \"/vbcs/hcm/people-publicui/fragments/worker-representatives\"\n            },\n            {\n                \"Name\": \"storeTxnData\",\n                \"Sequence\": 17,\n                \"VBResourceName\": \"/vbcs/hcm/employment-processui/fragments/combined_assignment_fragment\"\n            }\n        ],\n        \"UserInteractionInformation\": [\n            {\n                \"Name\": \"WhenAndWhy\",\n                \"Value\": \"Y\"\n            },\n            {\n                \"Name\": \"Assignment\",\n                \"Value\": \"Y\",\n                \"Visited\": \"Y\"\n            },\n            {\n                \"Name\": \"SeniorityDates\",\n                \"Value\": \"Y\"\n            },\n            {\n                \"Name\": \"NeedHelp\",\n                \"Value\": \"Y\"\n            }\n        ],\n        \"TransactionContextPayloadAttributes\": [\n        ]\n    },\n    \"id\": \"approvals\",\n    \"path\": \"/businessProcessTransactionContextInformation\",\n    \"operation\": \"create\"\n}]\n\n    assignmentPart.payload.hcmParams[\"EMP_Groovy_GradeStepId\"] = [\"String\", empObject.AssignmentMap.GradeStepId]\n    assignmentPart.payload.hcmParams[\"EMP_Groovy_GradeStepName\"] = [\"String\", empObject.AssignmentMap.GradeStepName]\n\nif (proposedBusinessTitle != null) {\n    assignmentPart.payload.assignmentModifiedAttributes.BusinessTitle = proposedBusinessTitle\n    reloadInputData.BusinessTitle = proposedBusinessTitle\n}\nif (proposedJobId != null) {\n    assignmentPart.payload.assignmentModifiedAttributes.JobId = proposedJobId\n    assignmentPart.payload.assignmentModifiedAttributes.BusinessTitle = proposedBusinessTitle\n    \n    reloadInputData.JobId = proposedJobId\n    reloadInputData.BusinessTitle = proposedBusinessTitle\n}\nif (proposedGradeId != null) {\n    assignmentPart.payload.assignmentModifiedAttributes.GradeId = proposedGradeId\n    assignmentPart.payload.assignmentModifiedAttributes.OldGradeStepId = empObject.AssignmentMap.GradeStepId !=\"\" && empObject.AssignmentMap.GradeStepId != \"NA\" ? empObject.AssignmentMap.GradeStepId : null\n    assignmentPart.payload.assignmentModifiedAttributes.GradeStepId = null\n\n    assignmentPart.payload.hcmParams[\"EMP_Groovy_GradeStepId\"] = [\"String\", null]\n    assignmentPart.payload.hcmParams[\"EMP_Groovy_GradeStepName\"] = [\"String\", null]\n\n    reloadInputData.GradeId = proposedGradeId\n    reloadInputData.GradeStepId = null\n\n}\npartsArray.push(assignmentPart);\n\nif(result != null && result != \"Not Available\")\npartsArray.push(assignmentNotesPart);\n\nif (salaryUpdated){\n    partsArray[0].payload.UserInteractionInformation.push(\n     {\n                \"Name\": \"Salary\",\n                \"Value\": \"Y\",\n                \"Visited\": \"Y\"\n     }\n    );\n     if($context.$variables.salaryWorkflowResponse.salaryBatchPart != null){\n    partsArray.push($context.$variables.salaryWorkflowResponse.salaryBatchPart);\n}\n}\n\n\nstoreTxnPart.payload.inputParameterMap.ReloadInputData = JSON.stringify(reloadInputData)\n\npartsArray.push(storeTxnPart);\npartsArray.push(submitPart);\n\n\n\n\nreturn partsArray"
          },
