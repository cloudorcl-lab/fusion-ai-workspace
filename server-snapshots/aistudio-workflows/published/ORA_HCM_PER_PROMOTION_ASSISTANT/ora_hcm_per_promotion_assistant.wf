            "sourceCode": "let errorMessageType = \"\";\n\nif($context.$variables.assignmentWorkflowResponse?.InvalidAttributesObject?.isInvalidAttributesPresent){\n     errorMessageType = \"invalidAttributesPresentMessage\";\n}\nif($context.$variables.assignmentWorkflowResponse.PendingTransactionsPresent){\n     errorMessageType = \"pendingTxnMessage\";\n}\nif($context.$variables.assignmentWorkflowResponse.GeneralRulesForPromotionAreViolated){\n     errorMessageType = \"generalRulesViolatedMessage\";\n}\nif($context.$nodes.ANALYSEUSERQUERY.$output.ifUnsupportedAttributesPresent || $context.$nodes.ANALYSEUSERQUERY.$output.ifUnsupportedSalaryAttributesPresent){\n     errorMessageType = \"unsupportedAttributeMessage\";\n}\nif($context.$nodes.CHECK_FOR_PENDING_WORKER.$output.result){\n     errorMessageType = \"pendingWorkerMessage\";\n}\n\nreturn errorMessageType;"
          },
