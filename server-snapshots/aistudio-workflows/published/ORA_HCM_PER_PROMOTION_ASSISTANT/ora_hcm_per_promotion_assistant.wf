              "value": "[\n    {\n        \"RequiredJobSeniority\": \"6 years, 0 months, and 0 days\",\n        \"CurrentSalaryAmountWithCurrencyCodeAndSalaryBasis\": \"9000 USD VDK_AL_SAL_BASIS2_CDRM30SEP\",\n        \"SalaryAmount\": 9000,\n        \"CurrentJobName\": \"Application Developer1\",\n        \"SalaryBasisName\": \"VDK_AL_SAL_BASIS2_CDRM30SEP\",\n        \"SalaryHikePercent\": \"\",\n        \"SalaryBasisId\": 300100620702468,\n        \"IsJobSenioritySatisfied\": true,\n        \"CurrencyCode\": \"USD\",\n        \"ProposedBusinessTitle\": \"ZHRT-Computer Control Programmer\",\n        \"ProposedSalaryAmountWithCurrencyCode\": \"9000 USD\",\n        \"RequiredPerformanceRating\": \"3/5\",\n        \"ConfigurationObject\": {\n            \"AssignmentMap\": {\n                \"PeriodOfServiceId\": 300100678886556,\n                \"DerivedStandardWorkingHours\": 40,\n                \"EffectiveLatestChange\": \"Y\",\n                \"LegislationCode\": \"US\",\n                \"JobName\": \"Application Developer1\",\n                \"CalculateWorkmeasureFlag\": \"Y\",\n                \"LocationSetId\": 0,\n                \"GradeSetId\": 0,\n                \"BusinessTitle\": \"Application Developer1\",\n                \"LegalEntityId\": 300100544320719,\n                \"JobCode\": \"AD1\",\n                \"EffectiveSequence\": 1,\n                \"AssignmentId\": 300100678886574,\n                \"AssignmentNumber\": \"E955940008298139\",\n                \"JobId\": 300100122073942,\n                \"WorkingHoursFrequency\": \"W\",\n                \"EffectiveEndDate\": \"4712-12-31\",\n                \"JobSetId\": 0,\n                \"BusinessUnitId\": 300100149752826,\n                \"StandardAnnualWorkingDuration\": 12,\n                \"DepartmentSetId\": 0,\n                \"AnnualWorkingDurationUnits\": \"M\",\n                \"WorkingHours\": 40,\n                \"DerivedStandardWorkingHoursFrequency\": \"W\",\n                \"PersonId\": 300100678886549,\n                \"HeadCount\": 1,\n                \"AdjustedFTE\": 1,\n                \"Fte\": 1,\n                \"EffectiveStartDate\": \"2020-02-01\"\n            },\n            \"ProfileOptionsMap\": {\n                \"ORA_PER_EMPL_DEFAULT_BUSINESS_TITLE_FROM\": \"J\",\n                \"PER_DEFAULT_GRADE_FROM_JOB_POSITION\": \"Y\",\n                \"PER_ENFORCE_VALID_GRADES\": \"N\",\n                \"ORA_PER_EMPL_INVOL_TERM_RESIGNATION_ENABLED\": \"Y\"\n            },\n            \"ActionOccurrenceMap\": {\n                \"ActionName\": \"Promotion\",\n                \"ActionId\": 100010026278026,\n                \"ActionTypeCode\": \"EMPL_PROMOTION\",\n                \"ActionCode\": \"PROMOTION\",\n                \"ActionOccurrenceId\": 300100683921403\n            },\n            \"SeniorityMap\": {\n                \"SeniorityVersion\": \"V3\"\n            }\n        },\n        \"AssignmentId\": 300100678886574,\n        \"DisplayName\": \"James Bhalla\",\n        \"AssignmentNumber\": \"E955940008298139\",\n        \"PersonNumber\": \"955940008298139\",\n        \"ProposedSalaryAmountWithCurrencyCodeAndSalaryBasis\": \"9000 USD VDK_AL_SAL_BASIS2_CDRM30SEP\",\n        \"CurrentBusinessTitle\": \"Application Developer1\",\n        \"JobSeniority\": \"6 Years, 0 Months and 2 Days\",\n        \"PersonId\": 300100678886549,\n        \"ProposedJobName\": \"ZHRT-Computer Control Programmer\",\n        \"CurrentSalaryAmountWithCurrencyCode\": \"9000 USD\",\n        \"IsPerformanceRatingSatisfied\": false,\n        \"ProposedJobId\": \"300100006108905\"\n    }\n]"
