          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"Generated schema for Root\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"summary\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"offset\": {\n                \"type\": \"string\"\n              },\n              \"limit\": {\n                \"type\": \"string\"\n              },\n              \"hasMore\": {\n                \"type\": \"string\"\n              },\n              \"count\": {\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"offset\",\n              \"limit\",\n              \"hasMore\",\n              \"count\"\n            ]\n          }\n        },\n        \"items\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"Status\": {\n                \"type\": \"string\"\n              },\n              \"RespondentStatusDescription\": {\n                \"type\": \"string\"\n              },\n              \"CreationDate\": {\n                \"type\": \"string\"\n              },\n              \"OwnerName\": {\n                \"type\": \"string\"\n              },\n              \"Description\": {\n                \"type\": \"string\"\n              },\n              \"MaximumCapacity\": {\n                \"type\": \"string\"\n              },\n              \"RegisteredCount\": {\n                \"type\": \"string\"\n              },\n              \"City\": {},\n              \"EndDate\": {\n                \"type\": \"string\"\n              },\n              \"Name\": {\n                \"type\": \"string\"\n              },\n              \"StartDate\": {\n                \"type\": \"string\"\n   