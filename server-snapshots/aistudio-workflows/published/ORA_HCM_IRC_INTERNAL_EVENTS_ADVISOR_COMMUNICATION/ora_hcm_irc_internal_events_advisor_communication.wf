          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "ProcessEventOwnerDetails",
            "returnType": "array",
            "sourceCode": "const data = $context.$nodes.GETEVENTOWNERDETAILS.$output\nconst result = data.items.map(person => {\n    // Extract DisplayName\n    const displayName = person.names.items[0]?.DisplayName || '';\n\n    // Extract EmailAddress (taking first or primary)\n    const emailObj = person.emails.items.find(e => e.PrimaryFlag) || person.emails.items[0] || {};\n    const emailAddress = emailObj.EmailAddress || '';\n\n    // Extract and Concatenate Phone Number Parts\n    const phoneObj = person.phones.items[0] || {};\n    const phoneNumber = [phoneObj.CountryCodeNumber, phoneObj.AreaCode, phoneObj.PhoneNumber]\n      .filter(Boolean)\n      .join('-');\n\n    return {\n      DisplayName: displayName,\n      EmailAddress: emailAddress,\n      PhoneNumber: phoneNumber\n    };\n  });\nreturn result;"
          },
          "outcomes": {
            "success": "1765955543497"
          },
          "code": "PROCESSEVENTOWNERDETAILS",
          "convergenceTargetId": "1770117774024",
          "id": "1768203664056",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "ProcessData",
            "returnType": "object",
            "sourceCode": "const data = JSON.parse($context.$nodes.GETEVENTREADINESS.$output.output);\n\nconst fitAnalysis = data.EventEmployeeFitAnalysis;\nconst extracted = {\n    ReadinessScore: fitAnalysis.ReadinessScore,\n    RecommendedPrerequisites: fitAnalysis.RecommendedPrerequisites,\n    SkillRecommendations: fitAnalysis.SkillRecommendations\n};\n\nextracted.Name=$context.$nodes.GETUPCOMINGREGISTEREDEVENTDETAILS.$output.Name\nextracted.StartDate=$context.$nodes.GETUPCOMINGREGISTEREDEVENTDETAILS.$output.StartDate\nconst EventTeam = $context.$nodes.PROCESSEVENTOWNERDETAILS.$output.result \nextracted.EventTeam = EventTeam\nconst meetingLink = $context.$nodes.GETUPCOMINGREGISTEREDEVENTDETAILS.$output.WebConfLink\nconst meetingDetails = $context.$nodes.GETUPCOMINGREGISTEREDEVENTDETAILS.$output.MeetingDetails\nconst LocationDetails = $context.$nodes.GETUPCOMINGREGISTEREDEVENTDETAILS.$output.LocationDetails\nconst city = $context.$nodes.GETUPCOMINGREGISTEREDEVENTDETAILS.$output.City\nconst state = $context.$nodes.GETUPCOMINGREGISTEREDEVENTDETAILS.$output.State\nconst country = $context.$nodes.GETUPCOMINGREGISTEREDEVENTDETAILS.$output.Country\nconst format = $context.$nodes.GETUPCOMINGREGISTEREDEVENTDETAILS.$output.Format\n\nif (format === 'Virtual') {\n\n    if (meetingLink != null) {\n        extracted.meetingLink = meetingLink;\n    }\n    if (meetingDetails != null) {\n        extracted.meetingDetails = meetingDetails;\n    }\n} else {\n    const parts = [\n        LocationDetails,\n        city,\n        state,\n        country\n    ].filter(value => value != null && value !== '').join(', ');\nextracted.LocationDetails = parts;\n}\n\nreturn extracted;"
          },
          "outcomes": {
            "success": "1765976599941"
          },
          "code": "PROCESSDATA",
          "convergenceTargetId": "1770117774024",
          "id": "1765955543497",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.75
              },
              "code": "ORA_LLM_PREMIUM",
              "model": "OPEN_AI_GPT_4_1_MINI",
              "modelName": "GPT-4.1 mini",
              "provider": "CERT_PREMIUM"
            },
            "name": "Summarize Event Readiness"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "SUMMARIZE_EVENT_READINESS",
          "convergenceTargetId": "1770117774024",
          "id": "1765976599941",
          "inputs": [
            {
              "id": "1765976599944_1",
              "name": "prompt",
              "type": "string",
              "value": "Input: {{$context.$nodes.PROCESSDATA.$output.result}}\n\nDisplay a brief and concise message about the user's registration for the upcoming event. Followed, by this display the following details.\n\nAlways display only the following fields, each on a single line and showing only the value:\n\nEvent Name\nEvent Start Date (convert from UTC to {{$context.$nodes.GET_SELF_DETAILS.$output.items[0].TimeZone}}, applying daylight savings if applicable, and format using {{$context.$nodes.GET_SELF_DETAILS.$output.items[0].DateFormat}} <space> {{$context.$nodes.GET_SELF_DETAILS.$output.items[0].TimeFormat}} <space> {{$context.$nodes.GET_SELF_DETAILS.$output.items[0].TimeZone}})\nLocationDetails or, if not present, both Meeting Details and WebConfLink\nBased on the pre requisites data and the skill gaps identified, display a list of actions to be taken to prepare for the event. Provide as much details as possible. Include the resources that employee can refer to prepare for it. If you are not able to to determine the pre requisites, omit this section.\nEvent Team - Display the contact details of event team\nDo not include explanations or extra field labels. Keep the output concise and direct."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n \"Summary\": {\n      \"type\": \"string\",\n      \"description\": \"A 1-sentence summary about users's upcoming event\"\n    },\n    \"EventName\": {\n      \"type\": \"string\",\n      \"description\": \"Name of the event\"\n    },\n    \"EventStartDate\": {\n      \"type\": \"string\",\n      \"description\": \"Event start date and time in the user's local timezone and preferred format\"\n    },\n    \"RecommendedActions\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" },\n      \"description\": \"List of recommended actions to be taken before the event\"\n    },\n    \"LocationDetails\": {\n      \"type\": \"string\",\n      \"description\": \"Physical event location, if available\"\n    },\n    \"MeetingDetails\": {\n      \"type\": \"string\",\n      \"description\": \"Virtual meeting details, if LocationDetails is not present\"\n    },\n    \"WebConfLink\": {\n      \"type\": \"string\",\n      \"description\": \"Web conference link, if LocationDetails is not present\",\n      \"format\": \"uri\"\n    },\n  \"EventTeam\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" },\n      \"description\": \"Event Team Contact Details\"\n    }\n  },\n  \"required\": [\n    \"EventName\",\n    \"EventStartDate\",\n    \"EventReadinessScore\",\n    \"Summary\",\n    \"RecommendedActions\",\n\"EventTeam\"\n  ],\n  \"oneOf\": [\n    { \"required\": [\"LocationDetails\"] },\n    { \"required\": [\"MeetingDetails\", \"WebConfLink\"] }\n  ],\n  \"additionalProperties\": false\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Return Empty State"
          },
          "outcomes": {},
          "code": "RETURN_EMPTY_STATE",
          "convergenceTargetId": "end",
