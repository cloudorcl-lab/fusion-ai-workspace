        {
          "metadata": {
            "name": "GetEventOwenrPersonIds",
            "returnType": "string",
            "sourceCode": "const owners = $context.$nodes.GETUPCOMINGREGISTEREDEVENTDETAILS.$output.owners?.items || [];\nconst personIdString = owners\n  .map(owner => `'${owner.OwnerPersonId}'`)\n  .join(' OR ');\n\nconst queryString = `PersonId LIKE ${personIdString}`;\nreturn queryString;"
          },
          "outcomes": {
            "success": "1768201975451"
          },
          "code": "GETEVENTOWENRPERSONIDS",
          "convergenceTargetId": "1770117774024",
          "id": "1768198033635",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_RECRUITING_ICCGETWORKERDETAILS",
            "functionName": "getEventTeamDetails",
            "name": "GetEventOwnerDetails"
          },
          "outcomes": {
            "success": "1768203664056"
          },
          "code": "GETEVENTOWNERDETAILS",
          "convergenceTargetId": "1770117774024",
          "id": "1768201975451",
          "inputs": [
            {
              "id": "1768202820213_1",
              "name": "PersonId",
              "type": "string",
              "value": "{{$context.$nodes.GETEVENTOWENRPERSONIDS.$output.result}}"
