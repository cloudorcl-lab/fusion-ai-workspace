          "convergenceTargetId": "1770117774024",
          "id": "1765955194458",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"Generated schema for Root\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"PersonNumber\": {\n            \"type\": \"string\"\n          },\n          \"UserDistinguishedName\": {\n            \"type\": \"string\"\n          },\n          \"Username\": {\n            \"type\": \"string\"\n          },\n          \"DisplayName\": {\n            \"type\": \"string\"\n          },\n          \"FirstName\": {\n            \"type\": \"string\"\n          },\n          \"LastName\": {\n            \"type\": \"string\"\n          },\n          \"MiddleNames\": {},\n          \"KnownAs\": {},\n          \"NameType\": {\n            \"type\": \"string\"\n          },\n          \"Suffix\": {},\n          \"Title\": {},\n          \"EmailAddress\": {\n            \"type\": \"string\"\n          },\n          \"Honors\": {},\n          \"PreNameAdjunct\": {},\n          \"AccessibilityMode\": {\n            \"type\": \"string\"\n          },\n          \"ClientEncoding\": {\n            \"type\": \"string\"\n          },\n          \"ColorContrast\": {\n            \"type\": \"string\"\n          },\n          \"Currency\": {\n            \"type\": \"string\"\n          },\n          \"DateFormat\": {\n            \"type\": \"string\"\n          },\n          \"DecimalSeparator\": {\n            \"type\": \"string\"\n          },\n          \"FontSize\": {\n            \"type\": \"string\"\n          },\n          \"GroupingSeparator\": {\n            \"type\": \"string\"\n          },\n          \"Language\": {\n            \"type\": \"string\"\n          },\n          \"NumberFormat\": {\n            \"type\": \"string\"\n          },\n          \"ServerTime\": {\n            \"type\": \"string\"\n          },\n          \"Territory\": {\n            \"type\": \"string\"\n          },\n          \"TimeFormat\": {\n            \"type\": \"string\"\n          },\n          \"TimeZone\": {\n            \"type\": \"string\"\n          },\n          \"DefaultLanguage\": {\n            \"type\": \"string\"\n          },\n          \"DisplayNameLanguage\": {\n            \"type\": \"string\"\n          },\n          \"Initials\": {\n            \"type\": \"string\"\n          },\n          \"AccountType\": {\n            \"type\": \"string\"\n          },\n          \"links\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"rel\": {\n                  \"type\": \"string\"\n                },\n                \"href\": {\n                  \"type\": \"string\"\n                },\n                \"name\": {\n                  \"type\": \"string\"\n                },\n                \"kind\": {\n                  \"type\": \"string\"\n                },\n                \"properties\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"changeIndicator\": {\n                      \"type\": \"string\"\n                    }\n                  },\n                  \"required\": [\n                    \"changeIndicator\"\n                  ]\n                }\n              },\n              \"required\": [\n                \"rel\",\n                \"href\",\n                \"name\",\n                \"kind\"\n              ]\n            }\n          }\n        },\n        \"required\": [\n          \"PersonNumber\",\n          \"UserDistinguishedName\",\n          \"Username\",\n          \"DisplayName\",\n          \"FirstName\",\n          \"LastName\",\n          \"MiddleNames\",\n          \"KnownAs\",\n          \"NameType\",\n          \"Suffix\",\n          \"Title\",\n          \"EmailAddress\",\n          \"Honors\",\n          \"PreNameAdjunct\",\n          \"AccessibilityMode\",\n          \"ClientEncoding\",\n          \"ColorContrast\",\n          \"Currency\",\n          \"DateFormat\",\n          \"DecimalSeparator\",\n          \"FontSize\",\n          \"GroupingSeparator\",\n          \"Language\",\n          \"NumberFormat\",\n          \"ServerTime\",\n          \"Territory\",\n          \"TimeFormat\",\n          \"TimeZone\",\n          \"DefaultLanguage\",\n          \"DisplayNameLanguage\",\n          \"Initials\",\n          \"AccountType\",\n          \"links\"\n        ]\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ]\n}",
