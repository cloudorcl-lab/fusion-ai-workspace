wnerPersonId\": {\n            \"type\": \"number\"\n          },\n          \"OwnerTypeCode\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"DisplayName\",\n          \"EmployeeEventId\",\n          \"EmployeeEventOwnerId\",\n          \"FirstName\",\n          \"FullName\",\n          \"LastName\",\n          \"OwnerPersonId\",\n          \"OwnerTypeCode\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"CategoryNames\",\n    \"City\",\n    \"Country\",\n    \"CreationDate\",\n    \"Description\",\n    \"EmployeeEventId\",\n    \"EndDate\",\n    \"EventNumber\",\n    \"EventStatusCode\",\n    \"Format\",\n    \"FormatCode\",\n    \"LastRegisterDate\",\n    \"LocationDetails\",\n    \"MaximumCapacity\",\n    \"MeetingDetails\",\n    \"Name\",\n    \"OwnerName\",\n    \"RegisteredCount\",\n    \"RespondentStatusCode\",\n    \"StartDate\",\n    \"State\",\n    \"Status\",\n    \"TimezoneCode\",\n    \"WebConfLink\",\n    \"owners\"\n  ]\n}",
