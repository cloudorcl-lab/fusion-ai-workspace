                    "success": "1764223718686"
                  },
                  "code": "GET_ORGANIZATION",
                  "convergenceTargetId": "1764223565029",
                  "id": "1763975745924",
                  "inputs": [
                    {
                      "id": "1765794132933_1",
                      "name": "PartyNumber",
                      "type": "string",
