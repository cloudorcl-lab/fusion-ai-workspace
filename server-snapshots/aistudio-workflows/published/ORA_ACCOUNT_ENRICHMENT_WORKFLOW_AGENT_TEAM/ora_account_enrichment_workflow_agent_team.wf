                      "name": "prompt",
                      "type": "string",
                      "value": "You are responsible for selecting best match record from a list of matched records found in the DnB system, based on user-requested data.\n\nDo not return any match if OrganizationName is not matching after Standardization.\n\nDo not match if locality is not same.\n\nThe top order of the records are having higher revenue and larger in size.\n\n###Input\nUser Requested Data {{$context.$nodes.LOOP.$currentItem}} \n\nMatch Records {{$context.$nodes.LOOP.FIND_IN_DAAS.$output.items}}"
                    }
                  ],
                  "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"Id\": {\n            \"type\": \"string\"\n        }\n    }\n}",
                  "type": "LLM"
                },
                {
                  "metadata": {
                    "name": "Add (False Branch)",
                    "description": "Add node for false branch"
                  },
                  "outcomes": {
                    "success": "1764228433543"
                  },
                  "id": "add_false_1766485925608",
                  "type": "ADD"
                },
                {
                  "metadata": {
                    "name": "CombineData",
                    "returnType": "object",
                    "sourceCode": "const source1 = $context.$nodes.LOOP.RETRIEVE_FROM_DAAS?.$output?.result || {};\nconst source2 = $context.$nodes.LOOP.GET_ACCOUNT?.$output?.items?.[0] || {};\nconst source3 = $context.$nodes.LOOP.GET_ORGANIZATION?.$output?.items?.[0] || {};\nconst source4 = $context.$nodes.LOOP.$currentItem || {};\n\n// Priority: Rank 1 → Rank 2 → Rank 3 → Rank 4\nconst sourcesByPriority = [source1, source2, source3, source4];\n\nconst fieldMappings = {\n  OrganizationName: [\"OrganizationName\"],\n  YearEstablished: [\"YearEstablished\"],\n  ControlYear: [\"ControlYear\"],\n  YearIncorporated: [\"YearIncorporated\"],\n  StockSymbol: [\"StockSymbol\"],\n  FiscalYearendMonth: [\"FiscalYearendMonth\"],\n  CurrentFiscalYearPotentialRevenueAmount: [\"CurrentFiscalYearPotentialRevenueAmount\"],\n  PreferredFunctionalCurrency: [\"PreferredFunctionalCurrency\"],\n  NextFiscalYearPotentialRevenueAmount: [\"NextFiscalYearPotentialRevenueAmount\"],\n  TaxpayerIdentificationNumber: [\"JgzzFiscalCode\", \"TaxpayerIdentificationNumber\"],\n  DUNSNumber: [\"DUNSNumberC\", \"DUNSNumber\"],\n  ParentDUNSNumber: [\"ParentDUNSNumberC\", \"ParentDUNSNumber\"],\n  SourceSystem: [\"SourceSystem\"],\n  SourceSystemReferenceValue: [\"SourceSystemReferenceValue\"],\n  DomesticUltimateDUNSNumber: [\"DomesticUltimateDUNSNumberC\", \"DomesticUltimateDUNSNumber\"],\n  GlobalUltimateDUNSNumber: [\"GlobalUltimateDUNSNumberC\", \"GlobalUltimateDUNSNumber\"],\n  CEOName: [\"CEOName\"],\n  HQBranchIndicator: [\"HQBranchIndicator\"],\n  ParentOrSubsidiaryIndicator: [\"ParentSubInd\", \"ParentOrSubsidiaryIndicator\"],\n  OrganizationSize: [\"OrganizationSize\"],\n  PartyNumber: [\"PartyNumber\"],\n  OrganizationType: [\"OrganizationType\"],\n  LineOfBusiness: [\"LineOfBusiness\"],\n  CurrencyCode: [\"CurrencyCode\"],\n  AddressLine1: [\"PrimaryAddress.Address1\", \"Address1\", \"AddressLine1\"],\n  AddressLine2: [\"PrimaryAddress.Address2\", \"Address2\", \"AddressLine2\"],\n  AddressLine3: [\"Address3\", \"AddressLine3\"],\n  AddressLine4: [\"Address4\", \"AddressLine4\"],\n  Building: [\"Building\"],\n  City: [\"PrimaryAddress.City\", \"City\"],\n  Country: [\"PrimaryAddress.Country\", \"Country\"],\n  County: [\"PrimaryAddress.County\", \"County\"],\n  FloorNumber: [\"FloorNumber\"],\n  PostalCode: [\"PrimaryAddress.PostalCode\", \"PostalCode\"],\n  PostalPlus4Code: [\"PrimaryAddress.PostalPlus4Code\", \"PostalPlus4Code\"],\n  Province: [\"Province\"],\n  State: [\"PrimaryAddress.State\", \"State\"],\n  Description: [\"Description\"],\n  PhoneNumber: [\"PhoneNumber\"],\n  PhoneCountryCode: [\"PhoneCountryCode\"],\n  EmailAddress: [\"EmailAddress\"],\n  URL: [\"CompanyWebsite\", \"Url\", \"URL\"],\n  EmployeesTotal: [\"EmployeesTotal\"],\n  ImportIndicator: [\"ImportInd\", \"ImportIndicator\"],\n  ExportIndicator: [\"ExportInd\", \"ExportIndicator\"],\n  WomanOwnedIndicator: [\"WomanOwnedInd\", \"WomanOwnedIndicator\"],\n  EmployeesAtPrimaryAddress: [\"EmployeesAtPrimaryAddress\"],\n  EmployeesAtPrimaryAddressEstimation: [\"EmployeesAtPrimaryAddressEstimation\"],\n  EmployeesAtPrimaryAddressMinimum: [\"EmployeesAtPrimaryAddressMinimum\"],\n  TotalEmployeesEstimatedIndicator: [\"TotalEmployeesEstimatedIndicator\"],\n  TotalEmployeesIndicator: [\"TotalEmployeesIndicator\"],\n  TotalEmployeesMinimumIndicator: [\"TotalEmployeesMinimumIndicator\"],\n  RentOrOwnIndicator: [\"RentOwnInd\", \"RentOrOwnIndicator\"],\n  LaborSurplusIndicator: [\"LaborSurplusInd\", \"LaborSurplusIndicator\"],\n  MinorityOwnedIndicator: [\"MinorityOwnedInd\", \"MinorityOwnedIndicator\"],\n  MinorityOwnedType: [\"MinorityOwnedType\"],\n  PublicPrivateOwnershipFlag: [\"PublicPrivateOwnershipFlag\"],\n  LegalStatus: [\"LegalStatus\"]\n};\n\nconst output = {};\n\n// Consolidation logic \nfor (const field in fieldMappings) {\n  let finalValue = \"\";\n\n  for (let i = 0; i < sourcesByPriority.length; i++) {\n    const src = sourcesByPriority[i];\n    const attributes = fieldMappings[field];\n\n    for (let j = 0; j < attributes.length; j++) {\n      const attr = attributes[j];\n      const value = src?.[attr];\n\n      if (value !== null && value !== undefined && value !== \"\") {\n        finalValue = value;\n        break;\n      }\n    }\n\n    if (finalValue !== \"\") break;\n  }\n\n  output[field] = finalValue;\n}\n//removing http\noutput.URL = output.URL?.replace(/^https?:\\/\\//i, '');\nsource2.URL = source2.URL?.replace(/^https?:\\/\\//i, '');\n\n// EnrichNeeded = false only if output matches Source2 exactly\nlet enrichNeeded = false;\n\nfor (const field in fieldMappings) {\n  const source2Value = source2?.[field] ?? \"\";\n  if (output[field] !== source2Value) {\n    enrichNeeded = true;\n    break;\n  }\n}\noutput.ParentAccountPartyNumber = source2.ParentAccountPartyNumber;\noutput.PhoneVerificationStatus = source2.PhoneVerificationStatus;\noutput.EmailVerificationStatus = source2.EmailVerificationStatus;\n\noutput.EnrichNeeded = enrichNeeded;\noutput.HierarchyData = [];\n\n//HierarchyData\nconst hierarchies =  $context.$nodes.LOOP.LOOP2?.$output || [];\nfor(const item of hierarchies){\n    const hierData = {};\n    const str = item.replace(/<a\\b[^>]*>(.*?)<\\/a>/gi, '$1').replace(/'\\\\\\\"/g, \"'\").replace(/\\\\\\\"'/g, \"'\");\n    const src = JSON.parse(str).result;\n    \n    for (const field in fieldMappings) {\n       const attributes = fieldMappings[field];\n       hierData[field]  = src[attributes[0]];\n   }\n    output.HierarchyData.push(hierData);\n}\n\nreturn output;"
                  },
                  "outcomes": {
                    "success": "1764578178877"
                  },
                  "code": "COMBINEDATA",
                  "id": "1767864221388",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                }
              ],
