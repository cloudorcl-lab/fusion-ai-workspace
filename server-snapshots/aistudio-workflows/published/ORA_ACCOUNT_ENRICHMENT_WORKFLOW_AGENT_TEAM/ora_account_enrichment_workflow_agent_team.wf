                },
                {
                  "metadata": {
                    "name": "Prepare Search String",
                    "returnType": "object",
                    "sourceCode": "let party;\nif($context.$nodes.LOOP.$currentItem.PartyNumber && $context.$nodes.LOOP.$currentItem.PartyNumber.length > 0)\n{\n if($context.$nodes.LOOP.$currentItem.UsageCode == 'SALES_ACCOUNT' || $context.$nodes.LOOP.$currentItem.UsageCode == 'SALES_PROSPECT')\n {\n     party = $context.$nodes.LOOP.GET_ACCOUNT.$output.items[0];\n }else\n {\n    party = $context.$nodes.LOOP.GET_ORGANIZATION.$output.items[0];\n  }\n}else\n{\n    party = $context.$nodes.LOOP.$currentItem;\n}\n\nconst isEmpty = v => v == null || String(v).trim() === \"\";\n\nlet fields = [\n  party.OrganizationName?.replace(/[.,]/g, \"\"),\n  party.City,\n  isEmpty(party.City) ? party.State:\"\",\n  isEmpty(party.City) && isEmpty(party.State) ? party.CountryName : \"\"\n];\nconst searchString =  fields.filter(v => v && v.length > 0).join(\" \");\n\n\nlet daasId = \"\";\nif(party.DUNSNumber && party.DUNSNumber.length > 0){\n  const chars = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=\";\n  const str = `DNB,${party.DUNSNumber},1,1`;\n  let output = '';\n  let i = 0;\n  while (i < str.length) {\n    const c1 = str.charCodeAt(i++);\n    const c2 = str.charCodeAt(i++);\n    const c3 = str.charCodeAt(i++);\n\n    const e1 = c1 >> 2;\n    const e2 = ((c1 & 3) << 4) | (c2 >> 4);\n    const e3 = isNaN(c2) ? 64 : ((c2 & 15) << 2) | (c3 >> 6);\n    const e4 = isNaN(c3) ? 64 : (c3 & 63);\n\n    output += chars[e1] + chars[e2] + chars[e3] + chars[e4];\n   }\n   daasId = output;\n}\n  \nreturn {\"DAASSearchString\": searchString, \"daasId\": daasId};"
                  },
                  "outcomes": {
                    "success": "1764227329496"
                  },
                  "code": "PREPARE_SEARCH_STRING",
                  "convergenceTargetId": "end_1764223243457",
                  "id": "1764223718686",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
