                {
                  "metadata": {
                    "name": "Hierarchy Info",
                    "returnType": "array",
                    "sourceCode": "const hier = [];\nif(!$context.$nodes.LOOP.$currentItem.enrichHierarchy)\n    return hier;\n\nconst domestic = $context.$nodes.LOOP.RETRIEVE_FROM_DAAS.$output.result.DomesticUltimateDUNSNumberC;\nconst global = $context.$nodes.LOOP.RETRIEVE_FROM_DAAS.$output.result.GlobalUltimateDUNSNumberC;\nconst current = $context.$nodes.LOOP.RETRIEVE_FROM_DAAS.$output.result.DUNSNumberC;\n\n\n// Push Domestic if not duplicate\nif (domestic && domestic.length > 0 && domestic !== current && !hier.includes(domestic)) {\n  hier.push(domestic);\n}\n\n// Push Global if not duplicate\nif (global && global.length > 0 && global !== current && !hier.includes(global)) {\n  hier.push(global);\n}\n\n// Prepare encoded list\nconst hierId = [];\nconst chars = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=\";\n\nfor (const item of hier) {\n  const str = `DNB,${item},1,1`;\n  let output = '';\n  let i = 0;\n  while (i < str.length) {\n    const c1 = str.charCodeAt(i++);\n    const c2 = str.charCodeAt(i++);\n    const c3 = str.charCodeAt(i++);\n\n    const e1 = c1 >> 2;\n    const e2 = ((c1 & 3) << 4) | (c2 >> 4);\n    const e3 = isNaN(c2) ? 64 : ((c2 & 15) << 2) | (c3 >> 6);\n    const e4 = isNaN(c3) ? 64 : (c3 & 63);\n\n    output += chars[e1] + chars[e2] + chars[e3] + chars[e4];\n  }\n\n  hierId.push(output);\n}\n\nreturn hierId;"
                  },
                  "outcomes": {
                    "success": "1764262069640"
                  },
                  "code": "HIERARCHY_INFO",
                  "id": "1764261157726",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
