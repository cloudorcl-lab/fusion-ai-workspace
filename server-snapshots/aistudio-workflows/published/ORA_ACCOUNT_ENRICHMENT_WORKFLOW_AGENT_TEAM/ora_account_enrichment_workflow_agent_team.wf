                  "metadata": {
                    "name": "Combine Verification Result",
                    "returnType": "object",
                    "sourceCode": "const output = $context.$nodes.LOOP.COMBINEDATA.$output.result \n//phone\nif( $context.$nodes.LOOP.PHONE_PRESENT.$output)\n{\n   output.PhoneVerificationStatus = $context.$nodes.LOOP.VERIFY_PHONE.$output.VerificationCode;\n}\n//email\nif($context.$nodes.LOOP.EMAIL_ADDRESS_PRESENT.$output)\n{\n   output.EmailVerificationStatus = $context.$nodes.LOOP.VERIFY_EMAILADDRESS.$output.VerificationCode;\n}\n\nif($context.$nodes.LOOP.FOUND_RESULT.$output)\n{\n   output.SourceSystem = \"DAAS\";\n  output.DataCloudStatus = \"SCHEDULED_TO_ENRICH\";\n  output.SourceSystemReferenceValue = $context.$nodes.LOOP.PREPARE_SEARCH_STRING.$output.result.daasId.length > 0 ?     $context.$nodes.LOOP.PREPARE_SEARCH_STRING.$output.result.daasId : $context.$nodes.LOOP.FIND_IN_DAAS.$output.items[0].Id;\n}\nreturn output;"
                  },
