        {
          "metadata": {
            "name": "Get parameters",
            "returnType": "object",
            "sourceCode": "const raw = $context.$triggers.REST.$input.OraAction;\n\n// Parse JSON safely\nlet obj = {};\n\ntry {\n  obj = typeof raw === \"string\" ? JSON.parse(raw) : raw;\n} catch (e) {\n  throw new Error(\"Invalid OraAction payload format\");\n}\n\nconst len = Object.keys(obj).length;\n\nreturn { obj, len };"
          },
          "outcomes": {
            "success": "1775457320189"
          },
          "diagram": {
            "x": 5568.903550192331,
            "y": 5673.564138234308
          },
          "code": "GET_PARAMETERS",
          "id": "1775457119685",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get Qualification Ids",
            "returnType": "object",
            "sourceCode": "let str = $context.$triggers.REST.$input.OraAction;\n\n// Split on '-' to remove prefix, then split on ',' to get numbers as strings\nlet parts = str.split('-');\nlet arr = parts[1].split(',');\nlet len = arr.length;\nreturn {arr, len};"
          },
          "outcomes": {
            "success": "1775459474047"
          },
          "diagram": {
            "x": 6247.895206436495,
            "y": 5680.014607424285
          },
          "code": "GET_QUALIFICATION_IDS",
          "id": "1775459358409",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Filter Required Qualification Areas",
            "returnType": "object",
            "sourceCode": "const agents = $context.$nodes.GET_PROCUREMENT_AGENTS.$output.items || [];\nconst qualifications = $context.$nodes.FETCH_TIER_WISE_REQUIREMENTS.$output || {};\n\n// Build a lookup map for faster matching\nconst agentMap = {};\nagents.forEach(agent => {\n  if (agent.ProcurementBU) {\n    agentMap[agent.ProcurementBU] = agent;\n  }\n});\n\n// Output object\nconst result = {};\n\n// Iterate over all keys in qualifications\nObject.keys(qualifications).forEach(key => {\n  // Skip trackerId\n  if (key === \"trackerId\") return;\n\n  const tierArray = qualifications[key];\n\n  // Ensure it's an array\n  //if (!Array.isArray(tierArray)) return;\n\n  // Filter valid qualification entries\n  const filtered = tierArray.filter(item => {\n    const bu = item.procurement_business_unit;\n\n    if (!bu) return false;\n\n    const agent = agentMap[bu];\n\n    // Condition 1: BU exists\n    if (!agent) return false;\n\n    // Condition 2: ManageQualificationsAllowedFlag = true\n    if (agent.ManageQualificationsAllowedFlag !== true) return false;\n\n    // Condition 3: AccessLevelToOtherAgentsQualificationsCode != NONE\n    if (\n      agent.AccessLevelToOtherAgentsQualificationsCode === \"NONE\"\n    ) {\n      return false;\n    }\n\n    return true;\n  });\n\n  // Only add tier if it still has valid items\n  if (filtered.length > 0) {\n    result[key] = filtered;\n  }\n});\n\n// Return final cleaned structure\nreturn result;"
          },
          "diagram": {
            "x": 7346.798471363576,
            "y": 5597.543925692619
          },
          "outcomes": {
            "success": "1777548961721"
          },
          "id": "1776767457165",
          "code": "FILTER_REQUIRED_QUALIFICATION_AREAS",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
