          "metadata": {
            "dataPipeline": {
              "rootNode": "start_1776249591460",
              "pipelineNodes": [
                {
                  "metadata": {
                    "description": "Start of data pipeline",
                    "name": "Start"
                  },
                  "diagram": {
                    "x": 7534.423474773257,
                    "y": 5894.742617479782
                  },
                  "outcomes": {
                    "success": "1776249591462"
                  },
                  "id": "start_1776249591460",
                  "code": "START",
                  "type": "START",
                  "inputs": []
                },
                {
                  "metadata": {
                    "name": "Prepare payload for GET Suppliers",
                    "returnType": "object",
                    "sourceCode": "const supplierTiers = $context.$nodes.PROCESS_CSV_DATA.$output.result ?? [];\n\nconst chunkSize = $context.$variables.supplierChunkSize;\nconst itr = $context.$variables.supplierIterator;\n\n// Slice the required chunk\nconst chunk = supplierTiers.slice(itr * chunkSize, (itr + 1) * chunkSize);\n\n// Build names & numbers only for this chunk\nconst supplierNames = chunk.map(item => `'${item.Supplier}'`).filter(Boolean);\nconst supplierNumbers = chunk.map(item => `'${item.SupplierNumber}'`).filter(Boolean);\n\nconst names = supplierNames.join(\",\");\nconst numbers = supplierNumbers.join(\",\");\n\n// Count only current chunk\nconst count = chunk.length;\n\nreturn { names, numbers, count };"
                  },
                  "diagram": {
                    "x": 7356.423474773257,
                    "y": 5906.369598970596
                  },
                  "outcomes": {
                    "success": "1776249591463"
                  },
                  "id": "1776249591462",
                  "code": "PREPARE_PAYLOAD_FOR_GET_SUPPLIERS",
                  "type": "CODE",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "metadata": {
                    "description": "get the suppliers based on user's csv file.",
                    "businessObjectCode": "ORA_PRC_SUPPLIERQU_POQSUPPLIERS",
                    "name": "Get suppliers",
                    "functionName": "getSelectedSuppliers",
                    "errorNodeId": "1777894583963"
                  },
                  "diagram": {
                    "x": 7384.923474773257,
                    "y": 6017.585917591498
                  },
                  "outcomes": {
                    "success": "1776249591464"
                  },
                  "id": "1776249591463",
                  "code": "GET_SUPPLIERS",
                  "type": "BO_FUNCTION",
                  "inputs": [
                    {
                      "id": "1776249591463_supplierNumbers",
                      "name": "supplierNumbers",
                      "value": "{{$context.$nodes.FETCH_SUPPLIERS_DETAILS.PREPARE_PAYLOAD_FOR_GET_SUPPLIERS.$output.result.numbers}}",
                      "required": true
                    },
                    {
                      "id": "1776249591463_fields",
                      "name": "fields",
                      "value": "SupplierId,Supplier,SupplierNumber,CreationDate",
                      "required": true
                    },
                    {
                      "id": "1776249591463_limit",
                      "name": "limit",
                      "value": "{{$context.$variables.limit}}",
                      "required": true
                    },
                    {
                      "id": "1776249591463_offset",
                      "name": "offset",
                      "value": "0",
                      "required": true
                    }
                  ]
                },
                {
                  "metadata": {
                    "description": "This code node reformats the business object output to include the Supplier Tier as well - fetched from csv file.",
                    "name": "Format Supplier Data",
                    "returnType": "object",
                    "sourceCode": "// input 1: supplier tiers from CSV\nconst supplierTiers = $context.$nodes.PROCESS_CSV_DATA.$output.result ?? [];\n\n// input 2: current chunk response\nconst suppliersResponse = $context.$nodes.FETCH_SUPPLIERS_DETAILS.GET_SUPPLIERS.$output ?? {};\n\n// existing accumulated variable\nconst suppliers = $context.$variables.suppliers || { items: [] };\n\nconst tierMap = {};\nsupplierTiers.forEach(item => {\n  tierMap[String(item.SupplierNumber)] = item.SupplierTier;\n});\n\n// --------------------------------------------------\n// Transform current chunk\n// --------------------------------------------------\nconst chunkItems = (suppliersResponse.items || []).map(item => {\n  return {\n    Supplier: item.Supplier,\n    SupplierId: item.SupplierId,\n    SupplierNumber: item.SupplierNumber,\n    CreationDate: item.CreationDate\n      ? item.CreationDate.split(\"T\")[0]\n      : null,\n    Tier: tierMap[item.SupplierNumber] || null\n  };\n});\n\nsuppliers.items.push(...chunkItems);\n\nreturn suppliers;"
                  },
                  "diagram": {
                    "x": 7384.923474773257,
                    "y": 6135.949570494924
                  },
                  "outcomes": {
                    "success": "1776249591465"
                  },
                  "id": "1776249591464",
                  "code": "FORMAT_SUPPLIER_DATA",
                  "type": "CODE",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "metadata": {
                    "name": "update supplier variables"
                  },
                  "diagram": {
