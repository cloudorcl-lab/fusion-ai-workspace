            "name": "return action",
            "returnType": "string",
            "sourceCode": "let action = $context.$triggers.REST.$input.OraMessageHint;\n\nconst cache = $context.$variables.computedPanelData;\nconst hasCache = !!(cache && Object.keys(cache).length > 0);\n\nif (action === \"Query\") {\n  action = hasCache ? action : \"Init\";\n} else if (action === \"InitDisplay\" || action === \"InitActions\" || action === \"Summary\" || action === \"InitCommunications\") {\n  action = \"Init\";\n}\n\nreturn action;"
          },
          "outcomes": {
            "success": "1776236275621"
