                    {
                      "id": "1776934574020_tierPathMap",
                      "name": "tierPathMap",
                      "value": "{{$context.$nodes.SUPPLIERID_LIST.$output.result.tierPathMap}}"
                    },
                    {
                      "id": "1776934574020_maxTierLength",
                      "name": "maxTierLength",
                      "value": "{{$context.$nodes.SUPPLIERID_LIST.$output.result.maxTierLength || 0}}"
                    }
                  ]
                },
                {
                  "metadata": {
                    "name": "SupplierId list",
                    "returnType": "object",
                    "sourceCode": "const suppliers = $context.$variables.suppliers.items ?? [];\nconst chunkSize = $context.$variables.supplierChunkSize;\nconst itr = $context.$variables.supplierIterator;\n\n// 1) group ids by tier\nconst byTier = {};\nfor (const s of suppliers) {\n  const tier = s.Tier || \"UNSPECIFIED\";\n  const id = s.SupplierId;\n  if (!id) continue;\n  if (!byTier[tier]) byTier[tier] = [];\n  byTier[tier].push(String(id));\n}\n\n// 2) build stable tier->path map once (or reuse existing)\nlet tierPathMap = $context.$variables.tierPathMap || {};\nif (Object.keys(tierPathMap).length === 0) {\n  const tiers = Object.keys(byTier).sort(); // deterministic\n  for (let i = 0; i < Math.min(4, tiers.length); i++) {\n    tierPathMap[`path${i + 1}`] = tiers[i];\n  }\n}\n\n// 3) produce fixed path payloads\nconst result = { tierPathMap };\nlet maxTierLength = 0;\n\nfor (let i = 1; i <= 4; i++) {\n  const tierName = tierPathMap[`path${i}`] || null;\n  const ids = tierName ? (byTier[tierName] || []) : [];\n  maxTierLength = Math.max(maxTierLength, ids.length);\n\n  const start = itr * chunkSize;\n  const end = (itr + 1) * chunkSize;\n  const chunk = ids.slice(start, end);\n\n  result[`path${i}`] = {\n    tierName,\n    supplierIdsCsv: chunk.join(\",\"),\n    hasSuppliers: chunk.length > 0\n  };\n}\n\nresult.maxTierLength = maxTierLength;\nreturn result;"
                  },
