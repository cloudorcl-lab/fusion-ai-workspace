                  "id": "start_1775457527824",
                  "code": "START",
                  "type": "START",
                  "inputs": []
                },
                {
                  "metadata": {
                    "name": "Prepare Initiative Payload",
                    "sourceCode": "const payloadObj = $context.$nodes.GET_PARAMETERS.$output.result.obj;\nconst keys = Object.keys(payloadObj);\nconst totalSuppliers = keys.length;\nconst noOfSuppliers = $context.$variables.totalSuppliers;\nconst index = totalSuppliers - noOfSuppliers;\nconst supplierId = keys[index];\nconst qualAreas = payloadObj[supplierId];\nconst groupedByBU = {};\n\nif (Array.isArray(qualAreas)) {\n  for (let i = 0; i < qualAreas.length; i++) {\n    const bu = qualAreas[i].business_unit;\n    const qualId = qualAreas[i].qualAreaId;\n\n    if (!groupedByBU[bu]) {\n      groupedByBU[bu] = [];\n    }\n\n    groupedByBU[bu].push(qualId);\n  }\n}\nconst initiatives = [];\n\nconst buKeys = Object.keys(groupedByBU);\n\nfor (let b = 0; b < buKeys.length; b++) {\n\n  const bu = buKeys[b];\n  const qualIds = groupedByBU[bu];\n\n  let quals = \"[\";\n\n  for (let i = 0; i < qualIds.length; i++) {\n    if (i > 0) quals += \",\";\n    quals += \"{\\\"QualificationAreaId\\\":\\\"\" + qualIds[i] + \"\\\"}\";\n  }\n\n  quals += \"]\";\n\n  const suppliers = \"[{\\\"SupplierId\\\":\\\"\" + supplierId +\n    \"\\\",\\\"InternalResponderId\\\":\\\"\" +\n    $context.$app.$OraUserContext.userId + \"\\\"}]\";\n\n  initiatives.push({\n    title: \"Supplier Compliance Initiative\",\n    owner: $context.$app.$OraUserContext.userId,\n    suppliers,\n    quals,\n    type: \"Qualification\",\n    PrcBu: bu\n  });\n}\n\nreturn initiatives;",
                    "returnType": "object"
                  },
                  "diagram": {
                    "x": 5014.642844638744,
                    "y": 5998.749462116424
                  },
                  "outcomes": {
                    "success": "1776681197193"
                  },
                  "id": "1775457589802",
                  "code": "PREPARE_INITIATIVE_PAYLOAD",
                  "type": "CODE",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
