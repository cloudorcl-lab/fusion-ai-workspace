          "code": "FETCH_ALL_QUALIFICATIONS",
          "id": "1776243511064",
          "inputs": [
            {
              "id": "1776243511064_condition",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$variables.supplierIterator == 0 || ($context.$variables.supplierIterator*$context.$variables.supplierChunkSize < $context.$variables.maxTierLength)}}"
            }
          ],
          "type": "WHILE"
        },
        {
          "metadata": {
            "description": "Find the suppliers who doesn't have required qualifications/expected outcome",
            "name": "Suppliers Missing Qualifications",
            "returnType": "object",
            "sourceCode": "// --------------------------------------------------\n// Inputs\n// --------------------------------------------------\nconst supplierList = $context.$variables.suppliers.items ?? [];\nconst tierRequirementsMap = $context.$nodes.REQUIRED_QUAL_AREAS.$output.result.result ?? {};\nconst qualificationRecords = $context.$variables.Qualifications.items ?? [];\n\n// --------------------------------------------------\n// Precompute tier requirements lookup\n// --------------------------------------------------\nconst tierRequirementLookup = Object.fromEntries(\n  Object.entries(tierRequirementsMap).map(([tier, requirements]) => [\n    tier,\n    requirements\n      .filter(req => req.OriginalQualAreaId != null && req.QualAreaId != null)\n      .map(req => ({\n        originalQualAreaId: req.OriginalQualAreaId,\n        qualAreaId: req.QualAreaId,\n        businessUnit: req.business_unit,\n        expectedOutcomes: (req.required_outcome || \"\")\n          .split(\",\")\n          .map(v => v.trim())\n          .filter(Boolean)\n      }))\n  ])\n);\n\n// --------------------------------------------------\n// Build supplier state map\n// --------------------------------------------------\nconst supplierStateMap = Object.fromEntries(\n  supplierList.map(supplier => [\n    supplier.SupplierId,\n    {\n      supplierName: supplier.Supplier,\n      tier: supplier.Tier,\n      outcomesByKey: {},\n      processedKeys: new Set()\n    }\n  ])\n);\n\nfor (const record of qualificationRecords) {\n  const supplierState = supplierStateMap[record.SupplierId];\n  if (!supplierState) continue;\n\n  const tierRequirements = tierRequirementLookup[supplierState.tier] ?? [];\n  if (tierRequirements.length === 0) continue;\n\n  const originalAreaId = record.OriginalQualificationAreaId;\n  const recordBU = record.ProcurementBU;\n\n  const requirement = tierRequirements.find(\n    req => req.originalQualAreaId === originalAreaId && req.businessUnit === recordBU\n  );\n\n  if (!requirement) continue;\n\n  const key = originalAreaId + \"|\" + recordBU;\n  if (supplierState.processedKeys.has(key)) continue;\n\n  supplierState.processedKeys.add(key);\n\n  if (!record.QualificationOutcome) continue;\n\n  const isExpected = requirement.expectedOutcomes.includes(record.QualificationOutcome);\n  const isOnHold =\n    record.PurchasingOnHoldFlag === true ||\n    record.PurchasingOnHoldFlag === \"true\" ||\n    record.PurchasingOnHoldFlag === \"Y\";\n\n  // If adverse qualification is already on purchase hold, suppress it.\n  if (!isExpected && isOnHold) continue;\n\n  supplierState.outcomesByKey[key] = {\n    originalQualAreaId: originalAreaId,\n    qualAreaId: requirement.qualAreaId,\n    business_unit: recordBU,\n    outcome: isExpected ? \"NA\" : record.QualificationOutcome,\n    qualificationId: record.QualificationId,\n    procurementBUId: record.ProcurementBUId,\n    supplierSiteId: record.SupplierSiteId,\n    purchasingOnHoldFlag: isOnHold\n  };\n}\n\nconst resultByTier = {};\nconst tierMissingMap = {};\nconst suppliersWithUnexpectedOutcomes = [];\n\nfor (const [supplierId, state] of Object.entries(supplierStateMap)) {\n  const tierRequirements = tierRequirementLookup[state.tier] ?? [];\n\n  const missingQualifications = tierRequirements\n    .filter(req => {\n      const key = req.originalQualAreaId + \"|\" + req.businessUnit;\n      return !state.processedKeys.has(key);\n    })\n    .map(req => ({\n      qualAreaId: req.qualAreaId,\n      business_unit: req.businessUnit\n    }));\n\n  const requiredBusinessUnits = Array.from(\n    new Set(tierRequirements.map(req => req.businessUnit).filter(Boolean))\n  );\n\n  const hasUnexpectedOutcome = Object.values(state.outcomesByKey).some(\n    o => o && o.outcome !== \"NA\"\n  );\n\n  if (hasUnexpectedOutcome) {\n    suppliersWithUnexpectedOutcomes.push({\n      supplierId,\n      supplierName: state.supplierName,\n      tier: state.tier,\n      requiredBusinessUnits,\n      outcomes: state.outcomesByKey\n    });\n  }\n\n  if (missingQualifications.length === 0 && !hasUnexpectedOutcome) continue;\n\n  if (!resultByTier[state.tier]) {\n    resultByTier[state.tier] = {\n      noOfSuppliersMissingQuals: 0,\n      suppliers: {}\n    };\n    tierMissingMap[state.tier] = {};\n  }\n\n  if (missingQualifications.length > 0) {\n    resultByTier[state.tier].noOfSuppliersMissingQuals++;\n    tierMissingMap[state.tier][supplierId] = missingQualifications;\n  }\n\n  resultByTier[state.tier].suppliers[supplierId] = {\n    supplierName: state.supplierName,\n    requiredBusinessUnits,\n    missingQualifications,\n    outcomes: state.outcomesByKey\n  };\n}\n\nreturn {\n  result: resultByTier,\n  tierWiseMissingMap: tierMissingMap,\n  suppliersWithUnexpectedOutcomes,\n  unexpectedOutcomeSupplierCount: suppliersWithUnexpectedOutcomes.length\n};"
          },
          "outcomes": {
            "success": "1776939354567"
          },
          "diagram": {
            "x": 8454.146537601478,
            "y": 9053.202633341949
          },
          "code": "SUPPLIERS_MISSING_QUALIFICATIONS",
          "id": "1774954700958",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
