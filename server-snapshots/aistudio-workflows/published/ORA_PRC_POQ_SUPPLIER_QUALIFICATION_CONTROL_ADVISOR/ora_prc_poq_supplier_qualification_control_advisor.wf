              "id": "1776237112728_condition",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$variables.supplierIterator == 0 || $context.$variables.supplierIterator*$context.$variables.supplierChunkSize < $context.$nodes.PROCESS_CSV_DATA.$output.result.length}}"
            }
          ],
          "type": "WHILE"
        },
        {
          "metadata": {
            "description": "get a string of supplierids to query the bof",
            "name": "Prepare Payload For GET Qualifications",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.FILTER_REQUIRED_QUALIFICATION_AREAS.$output.result ?? {};\n\nconst requiredQualificationAreas = Array.from(\n  new Set(\n    Object.values(data)\n      .flat()\n      .map(item => item.qualification_area)\n      .filter(Boolean)\n      .map(area => `'${area.replace(/&/g, '%26')}'`)\n  )\n).join(',');\n\nreturn { requiredQualificationAreas };"
          },
          "outcomes": {
            "success": "1776249661068"
          },
          "diagram": {
            "x": 7337.230607933806,
            "y": 6395.0525535847055
          },
