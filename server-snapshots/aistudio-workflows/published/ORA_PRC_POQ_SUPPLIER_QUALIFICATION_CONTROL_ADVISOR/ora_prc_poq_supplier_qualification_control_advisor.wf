                {
                  "metadata": {
                    "name": "Merge Tier Qualification Results",
                    "returnType": "object",
                    "sourceCode": "const existing = $context.$variables.Qualifications || { items: [] };\n\nconst t1 = $context.$nodes.FETCH_ALL_QUALIFICATIONS.RETURN_TIER1_QUALIFICATIONS.$output.result || { items: [] };\n\nconst t2 = $context.$nodes.FETCH_ALL_QUALIFICATIONS.RETURN_TIER2_QUALIFICATIONS.$output.result || { items: [] };\n\nconst t3 = $context.$nodes.FETCH_ALL_QUALIFICATIONS.RETURN_TIER3_QUALIFICATIONS.$output.result || { items: [] };\n\nconst t4 = $context.$nodes.FETCH_ALL_QUALIFICATIONS.RETURN_TIER4_QUALIFICATIONS.$output.result || { items: [] };\n\nconst collected = []\n  .concat(Array.isArray(t1.items) ? t1.items : [])\n  .concat(Array.isArray(t2.items) ? t2.items : [])\n  .concat(Array.isArray(t3.items) ? t3.items : [])\n  .concat(Array.isArray(t4.items) ? t4.items : []);\n\nconst merged = { ...existing };\nmerged.items = (existing.items || []).concat(collected);\nmerged.count = merged.items.length;\nmerged.hasMore = false;\nmerged.limit = 0;\nmerged.offset = 0;\nreturn merged;"
                  },
