          "code": "MAP_QUALIFICATION_AREAS_TO_IDS",
          "id": "1776249661068",
          "inputs": [
            {
              "id": "1775719314664_QualAreas",
              "name": "QualAreas",
              "type": "string",
              "value": "{{$context.$nodes.PREPARE_PAYLOAD_FOR_GET_QUALIFICATIONS.$output.result.requiredQualificationAreas}}"
            },
            {
              "id": "1775719314664_status",
              "name": "status",
              "value": "'Active'"
            },
            {
              "id": "1775719314664_fields",
              "name": "fields",
              "value": "QualAreaId,OriginalQualAreaId,QualArea,QualAreaStatus"
            },
            {
              "id": "1775719314664_offset",
              "name": "offset",
              "value": "0"
            },
            {
              "id": "1775719314664_limit",
              "name": "limit",
              "value": "{{$context.$variables.limit}}",
              "type": "string"
            }
          ],
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "description": "",
            "name": "Required Qual Areas",
            "returnType": "object",
            "sourceCode": "// Inputs\nconst llmOutput = $context.$nodes.FILTER_REQUIRED_QUALIFICATION_AREAS.$output.result ?? {};\nconst boOutput = $context.$nodes.MAP_QUALIFICATION_AREAS_TO_IDS.$output?.items ?? [];\n\n// Build lookup map: QualArea â†’ IDs\nconst qualAreaLookup = {};\n\nboOutput.forEach(item => {\n  if (item.QualArea) {\n    qualAreaLookup[item.QualArea.trim()] = {\n      QualAreaId: item.QualAreaId,\n      OriginalQualAreaId: item.OriginalQualAreaId\n    };\n  }\n});\n\nconst result = {};\nconst origQualAreaIds = [];\n\n// NEW: tier-wise OriginalQualAreaId collection\nconst tierWiseOrigQualAreaIds = {};\n\nfor (const [tier, areas] of Object.entries(llmOutput)) {\n  if (!Array.isArray(areas)) continue;\n\n  result[tier] = [];\n  tierWiseOrigQualAreaIds[tier] = [];\n\n  areas.forEach(areaObj => {\n    const areaName = areaObj.qualification_area?.trim();\n\n    const mappedIds = qualAreaLookup[areaName] || {};\n\n    const enrichedObj = {\n      qualification_area: areaName,\n      required_outcome: areaObj.required_outcome,\n      business_unit: areaObj.procurement_business_unit?.trim(),\n      QualAreaId: mappedIds.QualAreaId || null,\n      OriginalQualAreaId: mappedIds.OriginalQualAreaId || null\n    };\n\n    result[tier].push(enrichedObj);\n\n    if (mappedIds.OriginalQualAreaId) {\n      origQualAreaIds.push(mappedIds.OriginalQualAreaId);\n      tierWiseOrigQualAreaIds[tier].push(mappedIds.OriginalQualAreaId);\n    }\n  });\n\n  // dedupe tier-wise ids and convert to CSV\n  tierWiseOrigQualAreaIds[tier] = Array.from(new Set(tierWiseOrigQualAreaIds[tier])).join(\",\");\n}\n\nconst OrigQualAreaIdPayload = origQualAreaIds.join(\",\");\n\nreturn { result, OrigQualAreaIdPayload, tierWiseOrigQualAreaIds };"
          },
          "outcomes": {
            "success": "1775126917228"
          },
          "diagram": {
            "x": 7593.926190760918,
            "y": 6768.200471568205
          },
