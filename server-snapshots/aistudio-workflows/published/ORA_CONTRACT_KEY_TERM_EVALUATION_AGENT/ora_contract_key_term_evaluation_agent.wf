          "metadata": {
            "name": "final merged rest response",
            "returnType": "object",
            "sourceCode": "// This will be the final merged output you return\n  const finalMergedOutput = { items: [] };\nconst pagedResponsesRaw= $context.$nodes.ITERATE_AND_GET_LATEST_CONTRACT_KEY_TERMS.$output \n\n  for (const currentPagedResponseRaw of pagedResponsesRaw) {\n  \n    const currentPagedResponseObject =\n      typeof currentPagedResponseRaw === \"string\"\n        ? JSON.parse(currentPagedResponseRaw)\n        : currentPagedResponseRaw;\n\n    // 2) Your sample  looks like:\n    //    { result: { offset: 0, result: \"<json string>\" }, console:\"\", timedOut:false }\n    const currentResultJsonString =\n      currentPagedResponseObject?.result?.result \n\n    // If this page doesn't have a result payload, skip it\n    if (!currentResultJsonString) continue;\n\n    // 3) Parse the inner result JSON string -> becomes { items: [...] }\n    const currentResultObject = JSON.parse(currentResultJsonString);\n\n    // 4) Merge current page \"items\" into the final output\n    const currentItemsArray = currentResultObject?.items;\n    if (Array.isArray(currentItemsArray)) {\n      finalMergedOutput.items.push(...currentItemsArray);\n    }\n  }\n // { items: [ ...all merged items... ] }\n  return finalMergedOutput;"
          },
          "outcomes": {
            "success": "1772647469581"
          },
