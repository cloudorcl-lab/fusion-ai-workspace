                  "type": "END"
                },
                {
                  "aiAppOutputSpecification": {
                    "dataDisplay": {
                      "layouts": [
                        "ORA_LAYOUT_MULTIRECORD"
                      ],
                      "enableActions": false,
                      "enableCommunications": false
                    }
                  },
                  "metadata": {
                    "name": "classify"
                  },
                  "outcomes": {
                    "success": "end_1772647558316"
                  },
                  "code": "CLASSIFY",
                  "convergenceTargetId": "1772649385842",
                  "id": "1769725391520",
                  "inputs": [
                    {
                      "id": "1769725391522_1",
                      "name": "prompt",
                      "type": "string",
                      "value": "You are a contract clause classifier.\n\nInputs (exactly two):\n1) RulesJSON: a JSON object with array RulesJSON.rules. Each rule has:\n   - keyTermName (string)\n   - standard (string)\n   - fallbacks (array of { name, text })\n   - notAcceptable (string)\n\n2) KeyTermsGroupedJSON: a JSON array in this format:\n   [\n     {\n       \"keyTermName\": \"<term>\",\n       \"values\": [\n         { \"valueId\": <number>, \"valueText\": \"<value1>\" },\n         { \"valueId\": <number>, \"valueText\": \"<value2>\" }\n       ]\n     },\n     ...\n   ]\n\nTask:\nFor EACH value object inside EACH keyTermName group, produce a separate classification.\n\nFor each (keyTermName, valueText):\n1) Find the matching rule in RulesJSON.rules by keyTermName (case-insensitive, trim whitespace).\n2) Compare the valueText to the rule positions semantically (meaning-based, not exact text).\n3) Assign exactly one label:\n   - \"PROHIBITED\" if the valueText aligns with or implies any Not Acceptable concept(s).\n     If any prohibited concept is present, choose PROHIBITED even if other language seems acceptable.\n   - \"STANDARD\" if it aligns best with Standard and does not introduce prohibited concepts.\n   - \"FALLBACK1\" if it aligns best with a fallback1 position OR\n   - \"FALLBACK2\" if it aligns best with a fallback2 position\n   - IF it is mixed/unclear but not clearly prohibited, set \"classification\": PROHIBITED\n4) Conservative policy:\n   - If uncertain between STANDARD and FALLBACK → choose FALLBACK.\n   - If uncertain whether prohibited concepts are present → choose PROHIBITED.\n   - If a matching rule cannot be confidently found → choose PROHIBITED.\n\nOutput:\n- Return ONLY valid JSON (no markdown, no extra text).\n- Preserve the same grouping structure as the input.\n- For each input object, output:\n  {\n    \"keyTermName\": \"<as provided>\",\n    \"results\": [\n      {\n        \"valueId\": <original valueId>,\n        \"classification\": \"PROHIBITED|STANDARD|FALLBACK1|FALLBACK2|null\"\n      }\n    ]\n  }\n- Do NOT output valueText.\n\nInput 1:\n {{$context.$nodes.RULES_DEFINITION.$output.result}}\n\nInput 2:\n {{$context.$nodes.FOR_EACH_KEY_TERM.$currentItem}}"
                    }
                  ],
                  "type": "LLM"
                }
              ],
              "rootNode": "start_1772647558316"
            },
            "loopType": "PARALLEL",
            "name": "For each key term"
          },
          "outcomes": {
            "success": "1772651819466"
          },
          "code": "FOR_EACH_KEY_TERM",
          "id": "1772647558316",
          "inputs": [
            {
              "id": "1772647558317_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.GROUP_UNIQUE_KEYTERM_VALUES_INTO_BATCHES.$output.result}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "group unique keyterm values into batches",
            "returnType": "array",
            "sourceCode": "const batchesArray = [];\nconst batchSize=250;\nconst uniqueKeyTermsArray= $context.$nodes.EXTRACT_UNIQUE_KEY_TERM_VALUES.$output.result \n  const safeUniqueKeyTermsArray = Array.isArray(uniqueKeyTermsArray) ? uniqueKeyTermsArray : [];\n\n  for (const currentKeyTermGroup of safeUniqueKeyTermsArray) {\n    const keyTermName = ((currentKeyTermGroup?.keyTermName ?? \"\") + \"\").trim();\n    const valuesArray = Array.isArray(currentKeyTermGroup?.values)\n      ? currentKeyTermGroup.values\n      : [];\n\n    if (!keyTermName || valuesArray.length === 0) continue;\n\n    for (let startIndex = 0; startIndex < valuesArray.length; startIndex += batchSize) {\n      batchesArray.push({\n        keyTermName,\n        values: valuesArray.slice(startIndex, startIndex + batchSize)\n      });\n    }\n  }\n\n  return batchesArray;"
          },
          "outcomes": {
            "success": "1772647558316"
          },
          "code": "GROUP_UNIQUE_KEYTERM_VALUES_INTO_BATCHES",
          "id": "1772649089034",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "construct batch payloads",
            "returnType": "object",
            "sourceCode": "// Builds batch REST payloads (each batch has up to 50 \"parts\")\n//\n// Prereqs / assumptions:\n// 1) $context.$nodes.FINAL_MERGED_REST_RESPONSE.$output.result is the merged contracts payload\n//    shaped like: { items: [ { ContractId, LatestExtractId, latestContractKeyTerms:{items:[...] } }, ... ] }\n//\n// 2) $context.$nodes.FOR_EACH_KEY_TERM.$output is the LLM classification output shaped like:\n//    [ { keyTermName, results: [ { valueId, classification }, ... ] }, ... ]\n//\n// 3) You ALSO need the mapping from (keyTermName + valueText) -> valueId that you generated earlier.\n//    That mapping comes from the output of your \"uniqueKeyTermsArray\" builder method:\n//    [ { keyTermName, values: [ { valueId, valueText }, ... ] }, ... ]\n//\n//    Put that array in a node and reference it below in `uniqueKeyTermsWithValueIdsRaw`.\n//    If you don't provide this mapping, you cannot reliably map a contract's KeyTermValue -> valueId.\nconst uniqueKeyTermsWithValueIdsRaw =\n $context.$nodes.EXTRACT_UNIQUE_KEY_TERM_VALUES.$output.result; // <-- change node name to your actual node\n\nconst llmClassificationsRaw = $context.$nodes.FOR_EACH_KEY_TERM.$output;\n\nconst mergedContractsPayloadRaw = $context.$nodes.FINAL_MERGED_REST_RESPONSE.$output.result \n\n// -------------------- 1) Normalize/parse inputs --------------------\nconst uniqueKeyTermsWithValueIdsArray = Array.isArray(uniqueKeyTermsWithValueIdsRaw)\n  ? uniqueKeyTermsWithValueIdsRaw\n  : [];\n\nconst llmClassificationsArray = Array.isArray(llmClassificationsRaw)\n  ? llmClassificationsRaw.flatMap((currentItem) => {\n      // each item is expected to be a JSON string representing an array\n      if (typeof currentItem === \"string\") {\n        try {\n          const parsed = JSON.parse(currentItem);\n\n          // parsed is usually an array like [ { keyTermName, results } ]\n          if (Array.isArray(parsed)) return parsed;\n\n          // fallback if it ever returns an object\n          if (parsed && typeof parsed === \"object\") return [parsed];\n\n          return [];\n        } catch (e) {\n          return [];\n        }\n      }\n\n      // if it’s already an array/object (just in case)\n      if (Array.isArray(currentItem)) return currentItem;\n      if (currentItem && typeof currentItem === \"object\") return [currentItem];\n\n      return [];\n    })\n  : [];\n\nconst mergedContractsPayload =\n  typeof mergedContractsPayloadRaw === \"string\"\n    ? JSON.parse(mergedContractsPayloadRaw)\n    : mergedContractsPayloadRaw;\n\nconst contractsArray = Array.isArray(mergedContractsPayload?.items)\n  ? mergedContractsPayload.items\n  : [];\n\n// -------------------- 2) Build index: (keyTermName -> valueTextNormalized -> valueId) --------------------\nconst keyTermNameToValueTextToValueIdMap = new Map();\n\nfor (const currentKeyTermGroup of uniqueKeyTermsWithValueIdsArray) {\n  const keyTermNameText = ((currentKeyTermGroup?.keyTermName ?? \"\") + \"\").trim();\n  if (!keyTermNameText) continue;\n\n  const keyTermNameNormalized = keyTermNameText.toLowerCase();\n  const valuesArray = Array.isArray(currentKeyTermGroup?.values)\n    ? currentKeyTermGroup.values\n    : [];\n\n  if (!keyTermNameToValueTextToValueIdMap.has(keyTermNameNormalized)) {\n    keyTermNameToValueTextToValueIdMap.set(keyTermNameNormalized, new Map());\n  }\n\n  const valueTextToValueIdMap = keyTermNameToValueTextToValueIdMap.get(keyTermNameNormalized);\n\n  for (const currentValueEntry of valuesArray) {\n    const valueId = currentValueEntry?.valueId;\n    const valueText = ((currentValueEntry?.valueText ?? \"\") + \"\").trim();\n    if (!valueText || valueId == null) continue;\n\n    const valueTextNormalized = valueText.toLowerCase();\n    if (!valueTextToValueIdMap.has(valueTextNormalized)) {\n      valueTextToValueIdMap.set(valueTextNormalized, valueId);\n    }\n  }\n}\n\n// -------------------- 3) Build index: (keyTermName -> valueId -> classification) --------------------\nconst keyTermNameToValueIdToClassificationMap = new Map();\n\nfor (const currentClassificationGroup of llmClassificationsArray) {\n  const keyTermNameText = ((currentClassificationGroup?.keyTermName ?? \"\") + \"\").trim();\n  if (!keyTermNameText) continue;\n\n  const keyTermNameNormalized = keyTermNameText.toLowerCase();\n  const resultsArray = Array.isArray(currentClassificationGroup?.results)\n    ? currentClassificationGroup.results\n    : [];\n\n  if (!keyTermNameToValueIdToClassificationMap.has(keyTermNameNormalized)) {\n    keyTermNameToValueIdToClassificationMap.set(keyTermNameNormalized, new Map());\n  }\n\n  const valueIdToClassificationMap = keyTermNameToValueIdToClassificationMap.get(keyTermNameNormalized);\n\n  for (const currentResult of resultsArray) {\n    const valueId = currentResult?.valueId;\n    const classification = ((currentResult?.classification ?? \"\") + \"\").trim();\n\n    // allow null/empty classification to mean \"skip\"\n    if (valueId == null || !classification) continue;\n\n    valueIdToClassificationMap.set(valueId, classification);\n  }\n}\n\n// -------------------- 4) Build \"parts\" updates per contract --------------------\nconst allPartsArray = [];\nlet partSequenceNumber = 0;\n\nfor (const currentContract of contractsArray) {\n  const contractId = currentContract?.ContractId;\n  const latestExtractId = currentContract?.LatestExtractId;\n\n  if (contractId == null || latestExtractId == null) continue;\n\n  const contractKeyTermsArray = Array.isArray(currentContract?.latestContractKeyTerms?.items)\n    ? currentContract.latestContractKeyTerms.items\n    : [];\n\n  const contractKeyTermsUpdatesArray = [];\n\n  for (const currentContractKeyTerm of contractKeyTermsArray) {\n    const keyTermId = currentContractKeyTerm?.KeyTermId;\n    const keyTermNameText = ((currentContractKeyTerm?.KeyTermName ?? \"\") + \"\").trim();\n    const keyTermValueText = ((currentContractKeyTerm?.KeyTermValue ?? \"\") + \"\").trim();\n\n    if (keyTermId == null || !keyTermNameText || !keyTermValueText) continue;\n\n    const keyTermNameNormalized = keyTermNameText.toLowerCase();\n    const keyTermValueNormalized = keyTermValueText.toLowerCase();\n\n    const valueTextToValueIdMap = keyTermNameToValueTextToValueIdMap.get(keyTermNameNormalized);\n    const valueIdToClassificationMap = keyTermNameToValueIdToClassificationMap.get(keyTermNameNormalized);\n\n    if (!valueTextToValueIdMap || !valueIdToClassificationMap) continue;\n\n    // Convert contract value text -> valueId (from your earlier numbering step)\n    const valueId = valueTextToValueIdMap.get(keyTermValueNormalized);\n    if (valueId == null) continue;\n\n    // Get the classification for that valueId\n    const deviationCode = valueIdToClassificationMap.get(valueId);\n    if (!deviationCode) continue;\n\n    contractKeyTermsUpdatesArray.push({\n      Id: String(keyTermId),\n      KeyTermDeviationCode: deviationCode\n    });\n  }\n\n  // Skip contracts with nothing to update\n  if (contractKeyTermsUpdatesArray.length === 0) continue;\n\n  allPartsArray.push({\n    id: `part${partSequenceNumber++}`,\n    operation: \"upsert\",\n    path: \"/contracts\", // matches your sample\n    payload: {\n      ContractId: String(contractId),\n      contractKeyTermExtracts: [\n        {\n          Id: String(latestExtractId),\n          contractKeyTerms: contractKeyTermsUpdatesArray\n        }\n      ]\n    }\n  });\n}\n\n// -------------------- 5) Chunk parts into batches of 50 and return --------------------\nconst maxPartsPerBatch = 50;\nconst batchedRequestsArray = [];\n\nfor (let startIndex = 0; startIndex < allPartsArray.length; startIndex += maxPartsPerBatch) {\n  batchedRequestsArray.push({\n    parts: allPartsArray.slice(startIndex, startIndex + maxPartsPerBatch)\n  });\n}\n\nreturn batchedRequestsArray;"
          },
          "outcomes": {
