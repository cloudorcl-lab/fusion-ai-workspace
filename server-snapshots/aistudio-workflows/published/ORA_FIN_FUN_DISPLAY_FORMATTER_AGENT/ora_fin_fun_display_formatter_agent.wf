                  "code": "PREPARE_TABLE_TRANSFORM",
                  "id": "1778685707793",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "errorNodeId": "1779181925964",
                    "name": "Build Authored Table Payload",
                    "returnType": "object",
                    "sourceCode": "/*\n  Summary:\n  - Read the prepared table transform context.\n  - Read the original rows from the current table component.\n  - Resolve the effective rendering template for each column by combining:\n    - LLM-authored transform metadata\n    - explicit structured cell objects found in source rows\n  - Build two table payload variants:\n    - authoredPayload for inner table rendering\n    - rootAuthoredPayload for root table rendering\n  - Preserve existing behavior for plain, date, and monetary cells.\n  - Add structured runtime support for:\n    - link cells: { label, href }\n    - badge cells: { label, status }\n  - Emit link and badge tokens using renderer token-object syntax, not JSON.\n  - Keep root-table badge rendering temporary and toggle-driven.\n*/\n\nconst currentItem = $context.$nodes.AUTHOR_COMPONENTS.$currentItem || {};\nconst preparedTransformRaw =\n  $context.$nodes.AUTHOR_COMPONENTS.PREPARE_TABLE_TRANSFORM.$output.result;\n\nconst rawRows = Array.isArray(currentItem.data) ? currentItem.data : [];\nconst preparedTransform =\n  typeof preparedTransformRaw === \"string\"\n    ? JSON.parse(preparedTransformRaw)\n    : preparedTransformRaw || {};\n\n/*\n  Temporary product behavior:\n  - Inner table supports badge token rendering.\n  - Root table still renders badge cells as plain label text.\n  - When root-table badge support arrives, flip this to true.\n*/\nconst ENABLE_ROOT_TABLE_BADGE_TOKEN = false;\nconst DEFAULT_ROOT_TABLE_ROW_LIMIT = 10;\n\nconst SUPPORTED_BADGE_STATUSES = [\n  \"success\",\n  \"danger\",\n  \"info\",\n  \"warning\",\n  \"neutral\",\n  \"neutralSubtle\",\n  \"dangerSubtle\",\n  \"successSubtle\",\n  \"warningSubtle\",\n  \"infoSubtle\"\n];\n\n/* --- Error Handling --- */\n\nfunction throwFormatterError(code, message, details) {\n  const error = new Error(\"[\" + code + \"] \" + message);\n  error.errorType = code;\n  error.details = details || {};\n  throw error;\n}\n\n/* --- General Value Helpers --- */\n\nfunction normalizeKey(value) {\n  return String(value || \"\")\n    .replace(/[^a-zA-Z0-9]/g, \"\")\n    .toUpperCase();\n}\n\nfunction isBlank(value) {\n  return value === null || value === undefined || value === \"\";\n}\n\nfunction isPlainObject(value) {\n  return value !== null && typeof value === \"object\" && !Array.isArray(value);\n}\n\nfunction isNonEmptyString(value) {\n  return typeof value === \"string\" && value.trim().length > 0;\n}\n\nfunction toCellString(value) {\n  return isBlank(value) ? \"\" : String(value);\n}\n\nfunction sanitizeTokenValue(value) {\n  return String(value || \"\")\n    .replace(/[{}]/g, \"\")\n    .replace(/,/g, \"\")\n    .trim();\n}\n\nfunction buildTokenObject(fields) {\n  return Object.keys(fields)\n    .filter((key) => !isBlank(fields[key]))\n    .map((key) => key + \":\" + sanitizeTokenValue(fields[key]))\n    .join(\",\");\n}\n\n/* --- Input Context Parsing --- */\n\nfunction parsePreparedTransformContext(value) {\n  if (!value || typeof value !== \"object\") {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"Prepared table transform context is missing or invalid.\"\n    );\n  }\n\n  if (!value.transformSpec || typeof value.transformSpec !== \"object\") {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"Prepared table transform context is missing transformSpec.\"\n    );\n  }\n\n  if (!value.columnSpecByField || typeof value.columnSpecByField !== \"object\") {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"Prepared table transform context is missing columnSpecByField.\"\n    );\n  }\n\n  if (!Array.isArray(value.columnOrder)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"Prepared table transform context is missing columnOrder.\"\n    );\n  }\n\n  return value;\n}\n\n/* --- Row Normalization --- */\n\n// Normalize source keys so lookups stay consistent even if the API sends\n// \"Receipt Number\", \"receiptNumber\", or \"RECEIPTNUMBER\".\nfunction buildNormalizedRow(rawRow) {\n  const normalizedRow = {};\n\n  Object.keys(rawRow || {}).forEach((key) => {\n    normalizedRow[normalizeKey(key)] = rawRow[key];\n  });\n\n  return normalizedRow;\n}\n\nfunction getSourceValue(normalizedRow, columnSpec) {\n  const sourceValue = normalizedRow[columnSpec.sourceField];\n\n  if (!isBlank(sourceValue)) {\n    return sourceValue;\n  }\n\n  if (!isBlank(columnSpec.defaultValue)) {\n    return columnSpec.defaultValue;\n  }\n\n  return \"\";\n}\n\nfunction getFirstMeaningfulSourceValue(sourceRows, columnSpec) {\n  for (let index = 0; index < sourceRows.length; index += 1) {\n    const normalizedRow = buildNormalizedRow(sourceRows[index]);\n    const rawValue = getSourceValue(normalizedRow, columnSpec);\n\n    if (!isBlank(rawValue)) {\n      return rawValue;\n    }\n  }\n\n  return \"\";\n}\n\n/* ---- Structured Cell Detection --- */\n\nfunction isLinkCell(value) {\n  return (\n    isPlainObject(value) &&\n    isNonEmptyString(value.label) &&\n    isNonEmptyString(value.href)\n  );\n}\n\nfunction isBadgeCell(value) {\n  return (\n    isPlainObject(value) &&\n    isNonEmptyString(value.label) &&\n    isNonEmptyString(value.status)\n  );\n}\n\nfunction detectStructuredCellTemplate(rawValue) {\n  if (isLinkCell(rawValue)) {\n    return \"deepLinkTemplate\";\n  }\n\n  if (isBadgeCell(rawValue)) {\n    return \"badgeTemplate\";\n  }\n\n  return null;\n}\n\n/*\n  Runtime is the source of truth for explicit structured values.\n  If a row clearly contains a link or badge object, that intent wins even if\n  the LLM authored a different template.\n*/\nfunction resolveEffectiveColumnTemplate(rawValue, columnSpec) {\n  const structuredTemplate = detectStructuredCellTemplate(rawValue);\n\n  if (structuredTemplate) {\n    return structuredTemplate;\n  }\n\n  return columnSpec.template || \"\";\n}\n\nfunction buildResolvedColumnSpecByField(\n  baseColumnSpecByField,\n  sourceRows,\n  options\n) {\n  const resolvedColumnSpecByField = Object.create(null);\n\n  Object.keys(baseColumnSpecByField).forEach((field) => {\n    const baseColumnSpec = baseColumnSpecByField[field];\n    const sampleValue = getFirstMeaningfulSourceValue(sourceRows, baseColumnSpec);\n    const effectiveTemplate = resolveEffectiveColumnTemplate(\n      sampleValue,\n      baseColumnSpec\n    );\n\n    let finalTemplate = effectiveTemplate;\n\n    if (\n      effectiveTemplate === \"badgeTemplate\" &&\n      options.allowBadgeToken === false\n    ) {\n      finalTemplate = \"\";\n    }\n\n    resolvedColumnSpecByField[field] = {\n      ...baseColumnSpec,\n      template: finalTemplate\n    };\n  });\n\n  return resolvedColumnSpecByField;\n}\n\n/* ---- Badge Helpers ---- */\n\nfunction validateBadgeStatus(status) {\n  if (!SUPPORTED_BADGE_STATUSES.includes(status)) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Unsupported badge status: \" + status\n    );\n  }\n}\n\nfunction formatBadgeCell(rawValue, options) {\n  validateBadgeStatus(rawValue.status);\n\n  if (options.allowBadgeToken === false) {\n    return rawValue.label;\n  }\n\n  return (\n    \"{badge:{\" +\n    buildTokenObject({\n      text: rawValue.label,\n      status: rawValue.status\n    }) +\n    \"}}\"\n  );\n}\n\n/* --- Link Helpers --- */\n\nfunction normalizeLinkInput(rawValue) {\n  if (isLinkCell(rawValue)) {\n    return rawValue;\n  }\n\n  throwFormatterError(\n    \"INVALID_REQUEST\",\n    \"Link cell must be an object with non-empty label and href.\"\n  );\n}\n\nfunction splitHrefParts(href) {\n  const text = String(href || \"\").trim();\n\n  if (!text) {\n    throwFormatterError(\"INVALID_REQUEST\", \"Link href is required.\");\n  }\n\n  const hashIndex = text.indexOf(\"#\");\n  const beforeHash = hashIndex >= 0 ? text.slice(0, hashIndex) : text;\n  const hash = hashIndex >= 0 ? text.slice(hashIndex) : \"\";\n\n  const queryIndex = beforeHash.indexOf(\"?\");\n  const pathPart = queryIndex >= 0 ? beforeHash.slice(0, queryIndex) : beforeHash;\n  const search = queryIndex >= 0 ? beforeHash.slice(queryIndex) : \"\";\n\n  return {\n    href: text,\n    pathPart,\n    search,\n    hash\n  };\n}\n\nfunction isAbsoluteHttpHref(href) {\n  return /^https?:\\/\\//i.test(String(href || \"\").trim());\n}\n\nfunction hasExplicitHost(href) {\n  return isAbsoluteHttpHref(href);\n}\n\nfunction extractHostFromAbsoluteHref(href) {\n  const text = String(href || \"\").trim();\n  const match = text.match(/^https?:\\/\\/([^\\/?#]+)(.*)?$/i);\n\n  if (!match) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Absolute link href must include a valid host: \" + text\n    );\n  }\n\n  return match[1];\n}\n\nfunction extractPathQueryHashFromAbsoluteHref(href) {\n  const text = String(href || \"\").trim();\n  const match = text.match(/^https?:\\/\\/[^\\/?#]+(\\/[^?#]*)?(\\?[^#]*)?(#.*)?$/i);\n\n  if (!match) {\n    return \"/\";\n  }\n\n  return (match[1] || \"/\") + (match[2] || \"\") + (match[3] || \"\");\n}\n\nfunction isDeeplinkHref(href) {\n  return String(href || \"\").toLowerCase().includes(\"deeplink\");\n}\n\nfunction classifyLinkHref(href) {\n  if (isDeeplinkHref(href)) {\n    return \"deeplink\";\n  }\n\n  if (!hasExplicitHost(href)) {\n    return \"relativeLink\";\n  }\n\n  return \"externalLink\";\n}\n\nfunction inferFamilyFromPath(path) {\n  const normalizedPath = String(path || \"\").toLowerCase();\n\n  if (/(^|\\/)hcmui\\//.test(normalizedPath)) {\n    return \"HCM\";\n  }\n\n  if (/(^|\\/)crmui\\//.test(normalizedPath)) {\n    return \"CRM\";\n  }\n\n  return \"FSCM\";\n}\n\nfunction stripLeadingSlash(path) {\n  return String(path || \"\").replace(/^\\/+/, \"\");\n}\n\nfunction stripUiShellPrefix(path) {\n  return String(path || \"\").replace(/^(fscmui|hcmui|crmui)\\//i, \"\");\n}\n\nfunction normalizeRelativeHref(href) {\n  const parts = splitHrefParts(href);\n  let normalizedPath = parts.pathPart + parts.search + parts.hash;\n\n  normalizedPath = stripLeadingSlash(normalizedPath);\n  normalizedPath = stripUiShellPrefix(normalizedPath);\n\n  return normalizedPath;\n}\n\nfunction getQueryParamValue(href, key) {\n  const parts = splitHrefParts(href);\n  const query = parts.search.startsWith(\"?\")\n    ? parts.search.slice(1)\n    : parts.search;\n\n  if (!query) {\n    return \"\";\n  }\n\n  const pairs = query.split(\"&\");\n\n  for (let index = 0; index < pairs.length; index += 1) {\n    const pair = pairs[index];\n\n    if (!pair) {\n      continue;\n    }\n\n    const equalIndex = pair.indexOf(\"=\");\n    const rawKey = equalIndex >= 0 ? pair.slice(0, equalIndex) : pair;\n    const rawValue = equalIndex >= 0 ? pair.slice(equalIndex + 1) : \"\";\n\n    if (decodeURIComponent(rawKey) === key) {\n      return decodeURIComponent(rawValue);\n    }\n  }\n\n  return \"\";\n}\n\nfunction buildRelativeLinkToken(rawValue) {\n  const link = normalizeLinkInput(rawValue);\n  const normalizedUrl = normalizeRelativeHref(link.href);\n  const family = inferFamilyFromPath(link.href);\n\n  return (\n    \"{relativeLink:{\" +\n    buildTokenObject({\n      url: normalizedUrl,\n      text: link.label,\n      family\n    }) +\n    \"}}\"\n  );\n}\n\nfunction buildDeeplinkToken(rawValue) {\n  const link = normalizeLinkInput(rawValue);\n  const objType = getQueryParamValue(link.href, \"objType\");\n  const action = getQueryParamValue(link.href, \"action\");\n  const objKey = getQueryParamValue(link.href, \"objKey\");\n  const pathWithQuery = hasExplicitHost(link.href)\n    ? extractPathQueryHashFromAbsoluteHref(link.href)\n    : normalizeRelativeHref(link.href);\n  const family = inferFamilyFromPath(pathWithQuery);\n\n  if (!isNonEmptyString(objType) || !isNonEmptyString(action)) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Deep link href must include objType and action: \" + link.href\n    );\n  }\n\n  return (\n    \"{deeplink:{\" +\n    buildTokenObject({\n      objType,\n      action,\n      ...(isNonEmptyString(objKey) ? { objKey } : {}),\n      text: link.label,\n      family,\n      ...(hasExplicitHost(link.href)\n        ? { host: extractHostFromAbsoluteHref(link.href) }\n        : {})\n    }) +\n    \"}}\"\n  );\n}\n\nfunction buildExternalLinkToken(rawValue) {\n  const link = normalizeLinkInput(rawValue);\n\n  if (!hasExplicitHost(link.href)) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"External link href must include a host: \" + link.href\n    );\n  }\n\n  return (\n    \"{externalLink:{\" +\n    buildTokenObject({\n      url: extractPathQueryHashFromAbsoluteHref(link.href),\n      text: link.label,\n      host: extractHostFromAbsoluteHref(link.href)\n    }) +\n    \"}}\"\n  );\n}\n\nfunction formatLinkCell(rawValue) {\n  const link = normalizeLinkInput(rawValue);\n  const linkKind = classifyLinkHref(link.href);\n\n  if (linkKind === \"deeplink\") {\n    return buildDeeplinkToken(link);\n  }\n\n  if (linkKind === \"relativeLink\") {\n    return buildRelativeLinkToken(link);\n  }\n\n  return buildExternalLinkToken(link);\n}\n\n/* --- Primitive Value Formatting --- */\n\n// Accept either YYYY-MM-DD or timestamp strings like:\n// - 2009-08-19T00:00:00Z\n// - 2009-08-19 00:00:00\n// If the value does not look like a date, return empty string.\nfunction extractDatePortion(value) {\n  if (isBlank(value)) {\n    return \"\";\n  }\n\n  if (value instanceof Date && !Number.isNaN(value.getTime())) {\n    return value.toISOString().slice(0, 10);\n  }\n\n  const text = String(value).trim();\n  const match = text.match(/^(\\d{4}-\\d{2}-\\d{2})(?:[T\\s].*)?$/);\n\n  return match ? match[1] : \"\";\n}\n\nfunction makeDateToken(value) {\n  return \"{date:\" + value + \"}\";\n}\n\nfunction makeAmountToken(amountValue, currencyValue) {\n  return \"{amount:\" + amountValue + \",currency:\" + currencyValue + \"}\";\n}\n\nfunction formatPlainCell(rawValue) {\n  if (isPlainObject(rawValue)) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Unsupported structured table cell shape. Supported structured shapes are link {label, href} and badge {label, status}.\"\n    );\n  }\n\n  return toCellString(rawValue);\n}\n\nfunction formatDateCell(rawValue) {\n  const normalizedDate = extractDatePortion(rawValue);\n  return normalizedDate ? makeDateToken(normalizedDate) : \"\";\n}\n\nfunction formatMonetaryCell(rawValue, normalizedRow, columnSpec) {\n  const currencyValue = normalizedRow[columnSpec.currencySourceField];\n\n  if (isBlank(currencyValue)) {\n    return \"\";\n  }\n\n  return makeAmountToken(rawValue, currencyValue);\n}\n\nfunction formatPrimitiveCellValue(\n  rawValue,\n  normalizedRow,\n  columnSpec,\n  effectiveTemplate\n) {\n  if (effectiveTemplate === \"dateTemplate\") {\n    return formatDateCell(rawValue);\n  }\n\n  if (effectiveTemplate === \"monetaryTemplate\") {\n    return formatMonetaryCell(rawValue, normalizedRow, columnSpec);\n  }\n\n  return formatPlainCell(rawValue);\n}\n\n/* --- Final Cell Rendering --- */\n\nfunction formatStructuredCell(rawValue, effectiveTemplate, options) {\n  if (effectiveTemplate === \"deepLinkTemplate\") {\n    return formatLinkCell(rawValue);\n  }\n\n  if (effectiveTemplate === \"badgeTemplate\") {\n    return formatBadgeCell(rawValue, options);\n  }\n\n  return null;\n}\n\nfunction formatCellValue(normalizedRow, columnSpec, options) {\n  const rawValue = getSourceValue(normalizedRow, columnSpec);\n\n  if (isBlank(rawValue)) {\n    return \"\";\n  }\n\n  const effectiveTemplate = resolveEffectiveColumnTemplate(rawValue, columnSpec);\n  const structuredCellValue = formatStructuredCell(\n    rawValue,\n    effectiveTemplate,\n    options\n  );\n\n  if (structuredCellValue !== null) {\n    return structuredCellValue;\n  }\n\n  return formatPrimitiveCellValue(\n    rawValue,\n    normalizedRow,\n    columnSpec,\n    effectiveTemplate\n  );\n}\n\n/* --- Payload Builders -- */\n\nfunction buildColumns(columnOrder, columnSpecByField) {\n  return columnOrder.map((field) => {\n    const columnSpec = columnSpecByField[field];\n\n    return {\n      headerText: columnSpec.headerText,\n      field: columnSpec.field,\n      className: columnSpec.className || \"\",\n      resizable: columnSpec.resizable || \"enabled\",\n      id: columnSpec.field,\n      template: columnSpec.template || \"\"\n    };\n  });\n}\n\nfunction buildRows(sourceRows, columnOrder, columnSpecByField, options) {\n  return sourceRows.map((rawRow) => {\n    const normalizedRow = buildNormalizedRow(rawRow);\n    const renderedRow = {};\n\n    columnOrder.forEach((field) => {\n      const columnSpec = columnSpecByField[field];\n      renderedRow[field] = formatCellValue(normalizedRow, columnSpec, options);\n    });\n\n    return renderedRow;\n  });\n}\n\nfunction buildKeyAttributes(transformSpec, columnSpecByField, columnOrder) {\n  if (\n    Array.isArray(transformSpec.keyAttributes) &&\n    transformSpec.keyAttributes.length > 0\n  ) {\n    return transformSpec.keyAttributes.map(normalizeKey);\n  }\n\n  const fallbackField =\n    columnOrder.find((field) => /ID|NUMBER/.test(field)) || columnOrder[0];\n\n  if (!columnSpecByField[fallbackField]) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"Unable to derive a valid key attribute.\"\n    );\n  }\n\n  return [fallbackField];\n}\n\nfunction resolveRootPreviewRowLimit(transformSpec) {\n  const chatDisplayConfig =\n    transformSpec &&\n    typeof transformSpec.chatDisplayConfig === \"object\" &&\n    !Array.isArray(transformSpec.chatDisplayConfig)\n      ? transformSpec.chatDisplayConfig\n      : {};\n\n  const limitRowsInChat =\n    typeof chatDisplayConfig.limitRowsInChat === \"boolean\"\n      ? chatDisplayConfig.limitRowsInChat\n      : true;\n\n  const rowLimit =\n    typeof chatDisplayConfig.rowLimit === \"number\" &&\n    Number.isInteger(chatDisplayConfig.rowLimit) &&\n    chatDisplayConfig.rowLimit >= 0\n      ? chatDisplayConfig.rowLimit\n      : DEFAULT_ROOT_TABLE_ROW_LIMIT;\n\n  return {\n    limitRowsInChat,\n    rowLimit\n  };\n}\n\nfunction resolveRootPreviewRows(sourceRows, transformSpec) {\n  const previewConfig = resolveRootPreviewRowLimit(transformSpec);\n\n  if (!previewConfig.limitRowsInChat) {\n    return sourceRows;\n  }\n\n  return sourceRows.slice(0, previewConfig.rowLimit);\n}\n\nfunction buildAuthoredPayload(\n  transformSpec,\n  sourceRows,\n  columnOrder,\n  columnSpecByField,\n  accessibility,\n  options\n) {\n  return {\n    type: \"table\",\n    headerText: transformSpec.headerText || transformSpec.heading || \"\",\n    rows: {\n      items: buildRows(sourceRows, columnOrder, columnSpecByField, options)\n    },\n    columns: {\n      items: buildColumns(columnOrder, columnSpecByField)\n    },\n    keyAttributes: {\n      items: buildKeyAttributes(transformSpec, columnSpecByField, columnOrder)\n    },\n    ...(accessibility ? { accessibility } : {})\n  };\n}\n\n/* --- Render Configurations ---*/\n\nconst INNER_TABLE_RENDER_OPTIONS = {\n  allowBadgeToken: true\n};\n\nconst ROOT_TABLE_RENDER_OPTIONS = {\n  allowBadgeToken: ENABLE_ROOT_TABLE_BADGE_TOKEN\n};\n\n/* --- Execution --- */\n\nconst preparedContext = parsePreparedTransformContext(preparedTransform);\nconst transformSpec = preparedContext.transformSpec;\nconst columnOrder = preparedContext.columnOrder;\nconst accessibility = preparedContext.accessibility;\nconst rootPreviewRows = resolveRootPreviewRows(rawRows, transformSpec);\n\nconst innerColumnSpecByField = buildResolvedColumnSpecByField(\n  preparedContext.columnSpecByField,\n  rawRows,\n  INNER_TABLE_RENDER_OPTIONS\n);\n\nconst rootColumnSpecByField = buildResolvedColumnSpecByField(\n  preparedContext.columnSpecByField,\n  rootPreviewRows,\n  ROOT_TABLE_RENDER_OPTIONS\n);\n\nconst resultSet =  {\n  id: currentItem.id || \"\",\n  authoredPayload: buildAuthoredPayload(\n    transformSpec,\n    rawRows,\n    columnOrder,\n    innerColumnSpecByField,\n    accessibility,\n    INNER_TABLE_RENDER_OPTIONS\n  ),\n  rootAuthoredPayload: buildAuthoredPayload(\n    transformSpec,\n    rootPreviewRows,\n    columnOrder,\n    rootColumnSpecByField,\n    accessibility,\n    ROOT_TABLE_RENDER_OPTIONS\n  )\n};\n\nreturn resultSet;"
