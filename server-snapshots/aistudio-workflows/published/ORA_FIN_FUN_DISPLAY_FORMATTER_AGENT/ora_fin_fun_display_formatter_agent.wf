                  "code": "NORMALIZE_TEXT",
                  "id": "1777270193165",
                  "inputs": [
                    {
                      "id": "1777270193166_1",
                      "name": "prompt",
                      "type": "string",
                      "value": "Your job is to author exactly one component payload for the current component context.\n\nYou must return exactly one valid JSON object that conforms to the Text component schema in the current context, and nothing else.\n\n-----------------------------\nINPUTS\n\nThe full current component context is available at:\n{{$context.$nodes.AUTHOR_COMPONENTS.$currentItem}}\n\nRead the following from it:\n- raw data: `data`\n- authoring hints: `authoringHints`\n- component id: `id`\n\n-----------------------------\nHard Immutability Rule (NON-NEGOTIABLE):\n- The original content MUST remain EXACTLY as provided.\n- You are STRICTLY FORBIDDEN from changing, correcting, rephrasing, summarizing, restructuring, or interpreting ANY part of the content.\n- This includes grammar fixes, spelling corrections, formatting improvements, or stylistic edits.\n- EVEN IF the content contains errors, inconsistencies, or poor grammar, it MUST be preserved exactly as-is.\n- ANY deviation from the original wording (other than the allowed normalization below) is a FAILURE.\n\nRules:\n- Use the Text schema only.\n- Put the message in `text`.\n- Include `heading` only if a visible heading is clearly needed.\n- DO NOT change, summarize, rephrase, or reinterpret the original content in any way.\n\nNormalization (STRICTLY LIMITED):\n- Only normalize monetary amounts, full dates, and links.\n- Do NOT alter any other part of the content.\n\n- Convert monetary amounts → `{amount:<value>,currency:<CURRENCY_CODE>}`\n  Example:\n       1. USD 1200 → {amount:1200,currency:USD}\n       2. $1200 → {amount:1200,currency:USD}\n\n- Convert full dates (day, month, year only) → `{date:<YYYY-MM-DD>}`\n  Example: March 5, 2026 → {date:2026-03-05}\n\n- Do not convert partial dates like \"March 2026\" or \"2026\".\n\n- Convert every detected link into an HTML anchor tag.\n- Keep the visible anchor text exactly as it appears in the source.\n- When text is immediately followed by a URL in parentheses, use that immediately preceding text as the anchor text and use the URL inside parentheses as the href.\n- Example:\n  `here(https://example.com)` → `<a href=\"https://example.com\" target=\"_blank\" rel=\"noopener noreferrer\">here</a>`\n- When the source contains only a raw URL, use that URL itself as the anchor text.\n- Replace the original plain-text link notation in place with the anchor tag.\n- Use this exact anchor format:\n  `<a href=\"...\" target=\"_blank\" rel=\"noopener noreferrer\">...</a>`\n\n\nConstraints:\n- Preserve the original content exactly except for the required normalization.\n- Do not add, remove, or modify wording, structure, or meaning.\n- Do not add unsupported keys.\n- Return only the final JSON object.\n- IMPORTANT: the `id` must be exactly {{$context.$nodes.AUTHOR_COMPONENTS.$currentItem.id}}\n\n-----------------------------\nSelf-validation:\n- Ensure that NO content changes were made beyond monetary, date, and link normalization.\n- Verify strict adherence to `authoringHints` (selection, ordering, wording, formatting).\n- If any hint conflicts with normalization, apply normalization only without altering content meaning.\n- Do not return output that violates these constraints."
                    }
                  ],
                  "outputSpecification": "{\n  \"title\": \"Text Artifact Payload\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"id\", \"authoredPayload\"],\n  \"properties\": {\n    \"id\": {\n      \"type\": \"string\"\n    },\n    \"authoredPayload\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"text\"],\n      \"properties\": {\n        \"heading\": {\n          \"type\": \"string\"\n        },\n        \"text\": {\n          \"type\": \"string\"\n        }\n      }\n    }\n  }\n}",
                  "type": "LLM"
                },
                {
                  "metadata": {
                    "name": "Build Canvas Payload",
                    "returnType": "object",
                    "sourceCode": "const currentItemRaw = $context.$nodes.AUTHOR_COMPONENTS.$currentItem;\n\nfunction parseIfString(value) {\n  let parsed = value;\n\n  while (typeof parsed === \"string\") {\n    parsed = JSON.parse(parsed);\n  }\n\n  return parsed;\n}\n\nfunction throwFormatterError(code, message, details) {\n  const error = new Error(\"[\" + code + \"] \" + message);\n  error.errorType = code;\n  error.details = details || {};\n  throw error;\n}\n\nconst item = parseIfString(currentItemRaw);\n\nif (!item || typeof item !== \"object\") {\n  throwFormatterError(\n    \"INVALID_REQUEST\",\n    \"AUTHOR_COMPONENTS currentItem is missing or invalid.\"\n  );\n}\n\nif (!item.id) {\n  throwFormatterError(\n    \"INVALID_REQUEST\",\n    \"Canvas component id is required.\"\n  );\n}\n\nif (item.type !== \"canvas\") {\n  throwFormatterError(\n    \"INVALID_REQUEST\",\n    \"Canvas passthrough node received non-canvas component type: \" + item.type\n  );\n}\n\nif (typeof item.data === \"undefined\") {\n  throwFormatterError(\n    \"INVALID_REQUEST\",\n    \"Canvas component must include data: \" + item.id\n  );\n}\n\nreturn {\n  id: item.id,\n  authoredPayload: item.data\n};"
                  },
                  "outcomes": {
                    "success": "end_1774441309277"
                  },
                  "diagram": {
                    "x": 4720.114324889597,
                    "y": 5715.369559415579
                  },
                  "code": "BUILD_CANVAS_PAYLOAD",
                  "id": "1779284220907",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "errorNodeId": "1779181925964",
                    "name": "Prepare Table Transform",
                    "returnType": "object",
                    "sourceCode": "/*\n  Summary:\n  - Read the table transform spec returned by the LLM.\n  - Validate the top-level authoring output shape.\n  - Normalize transform column metadata into a lookup keyed by rendered field.\n  - Build the effective rendered column order after exclusions.\n  - Validate template, monetary, key attribute, and accessibility rules.\n  - Return a clean normalized transform context for downstream row rendering.\n*/\n\nconst currentItem = $context.$nodes.AUTHOR_COMPONENTS.$currentItem || {};\nconst llmOutputRaw = $context.$nodes.AUTHOR_COMPONENTS.AUTHOR_TABLE_TRANSFORM.$output;\n\nconst transformAuthoringOutput =\n  typeof llmOutputRaw === \"string\"\n    ? JSON.parse(llmOutputRaw)\n    : llmOutputRaw || {};\n\nconst SUPPORTED_COLUMN_TEMPLATES = [\n  \"\",\n  \"dateTemplate\",\n  \"monetaryTemplate\",\n  \"deepLinkTemplate\",\n  \"badgeTemplate\"\n];\n\nfunction throwFormatterError(code, message, details) {\n  const error = new Error(\"[\" + code + \"] \" + message);\n  error.errorType = code;\n  error.details = details || {};\n  throw error;\n}\n\nfunction normalizeKey(value) {\n  return String(value || \"\")\n    .replace(/[^a-zA-Z0-9]/g, \"\")\n    .toUpperCase();\n}\n\nfunction parseAuthoringOutput(output) {\n  if (!output || typeof output !== \"object\") {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"Transform authoring output is missing or invalid.\"\n    );\n  }\n\n  if (output.authoringMode !== \"transformSpec\") {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"Expected authoringMode to be 'transformSpec'.\"\n    );\n  }\n\n  if (!output.transformSpec || typeof output.transformSpec !== \"object\") {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"transformSpec is missing.\"\n    );\n  }\n\n  if (output.transformSpec.kind !== \"table\") {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"Expected transformSpec.kind to be 'table'.\"\n    );\n  }\n\n  return output;\n}\n\n// Build one lookup keyed by rendered field so validation and downstream\n// rendering both use the same normalized column metadata.\nfunction buildColumnSpecMap(transformSpec) {\n  const columnSpecByField = Object.create(null);\n\n  (transformSpec.columns || []).forEach((column) => {\n    if (!column || typeof column !== \"object\") {\n      throwFormatterError(\n        \"PROCESSING_ERROR\",\n        \"Each transformSpec.columns entry must be an object.\"\n      );\n    }\n\n    if (!column.field) {\n      throwFormatterError(\n        \"PROCESSING_ERROR\",\n        \"Each transformSpec.columns entry must include field.\"\n      );\n    }\n\n    if (!column.sourceField) {\n      throwFormatterError(\n        \"PROCESSING_ERROR\",\n        \"Each transformSpec.columns entry must include sourceField.\"\n      );\n    }\n\n    const normalizedField = normalizeKey(column.field);\n\n    if (columnSpecByField[normalizedField]) {\n      throwFormatterError(\n        \"PROCESSING_ERROR\",\n        \"Duplicate transform column field: \" + column.field\n      );\n    }\n\n    columnSpecByField[normalizedField] = {\n      ...column,\n      field: normalizedField,\n      sourceField: normalizeKey(column.sourceField),\n      currencySourceField: column.currencySourceField\n        ? normalizeKey(column.currencySourceField)\n        : undefined\n    };\n  });\n\n  return columnSpecByField;\n}\n\nfunction buildEffectiveColumnOrder(transformSpec) {\n  const rawColumnOrder = Array.isArray(transformSpec.columnOrder)\n    ? transformSpec.columnOrder.map(normalizeKey)\n    : [];\n\n  const excludedFields = Array.isArray(transformSpec.excludedSourceFields)\n    ? transformSpec.excludedSourceFields.map(normalizeKey)\n    : [];\n\n  if (rawColumnOrder.length === 0) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"transformSpec.columnOrder must contain at least one field.\"\n    );\n  }\n\n  // Exclusions win over source-driven order. This matters when helper fields\n  // such as CURRENCYCODE are present in the source order but should not render.\n  return rawColumnOrder.filter((field) => !excludedFields.includes(field));\n}\n\nfunction validateColumnOrder(columnOrder, columnSpecByField) {\n  if (columnOrder.length === 0) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"No rendered columns remain after applying excludedSourceFields.\"\n    );\n  }\n\n  columnOrder.forEach((field) => {\n    if (!columnSpecByField[field]) {\n      throwFormatterError(\n        \"PROCESSING_ERROR\",\n        \"columnOrder field has no matching column spec: \" + field\n      );\n    }\n  });\n}\n\nfunction validateColumnTemplates(columnSpecByField) {\n  Object.keys(columnSpecByField).forEach((field) => {\n    const column = columnSpecByField[field];\n\n    if (!SUPPORTED_COLUMN_TEMPLATES.includes(column.template)) {\n      throwFormatterError(\n        \"PROCESSING_ERROR\",\n        \"Unsupported column template: \" + column.template + \" for field: \" + field\n      );\n    }\n\n    if (column.template === \"monetaryTemplate\" && !column.currencySourceField) {\n      throwFormatterError(\n        \"PROCESSING_ERROR\",\n        \"Monetary column must include currencySourceField: \" + field\n      );\n    }\n  });\n}\n\nfunction validateKeyAttributes(transformSpec, columnOrder) {\n  if (!Array.isArray(transformSpec.keyAttributes)) {\n    return;\n  }\n\n  transformSpec.keyAttributes.forEach((field) => {\n    const normalizedField = normalizeKey(field);\n\n    if (!columnOrder.includes(normalizedField)) {\n      throwFormatterError(\n        \"PROCESSING_ERROR\",\n        \"keyAttributes contains a field not present in rendered columns: \" + field\n      );\n    }\n  });\n}\n\nfunction validateAccessibility(transformSpec, columnOrder) {\n  const accessibleRowHeader =\n    transformSpec.accessibility &&\n    transformSpec.accessibility[\"row.accessible-row-header\"];\n\n  if (!accessibleRowHeader) {\n    return;\n  }\n\n  const normalizedHeaderField = normalizeKey(accessibleRowHeader);\n\n  if (!columnOrder.includes(normalizedHeaderField)) {\n    throwFormatterError(\n      \"PROCESSING_ERROR\",\n      \"row.accessible-row-header must point to a rendered field: \" +\n        accessibleRowHeader\n    );\n  }\n}\n\nfunction buildAccessibility(transformSpec) {\n  if (!transformSpec.accessibility) {\n    return undefined;\n  }\n\n  const result = {\n    \"aria-label\": transformSpec.accessibility[\"aria-label\"]\n  };\n\n  if (transformSpec.accessibility[\"row.accessible-row-header\"]) {\n    result[\"row.accessible-row-header\"] = normalizeKey(\n      transformSpec.accessibility[\"row.accessible-row-header\"]\n    );\n  }\n\n  return result;\n}\n\nfunction validateTransformSpec(transformSpec, columnSpecByField) {\n  const columnOrder = buildEffectiveColumnOrder(transformSpec);\n\n  validateColumnOrder(columnOrder, columnSpecByField);\n  validateColumnTemplates(columnSpecByField);\n  validateKeyAttributes(transformSpec, columnOrder);\n  validateAccessibility(transformSpec, columnOrder);\n\n  return columnOrder;\n}\n\nconst parsedOutput = parseAuthoringOutput(transformAuthoringOutput);\nconst transformSpec = parsedOutput.transformSpec;\nconst columnSpecByField = buildColumnSpecMap(transformSpec);\nconst columnOrder = validateTransformSpec(transformSpec, columnSpecByField);\nconst accessibility = buildAccessibility(transformSpec);\n\nreturn {\n  id: currentItem.id || \"\",\n  transformSpec,\n  columnSpecByField,\n  columnOrder,\n  accessibility\n};"
                  },
                  "outcomes": {
                    "success": "1778685804537"
