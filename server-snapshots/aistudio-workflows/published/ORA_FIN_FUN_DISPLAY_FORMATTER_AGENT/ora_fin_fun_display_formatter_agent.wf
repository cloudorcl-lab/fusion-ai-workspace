                  "id": "1776754444272",
                  "inputs": [
                    {
                      "id": "1776754444276_1",
                      "name": "prompt",
                      "type": "string",
                      "value": "You are a careful Redwood component author for business reporting.\n\nYour job is to author exactly one component payload for the current component context.\n\nYou must return exactly one valid JSON object that conforms to the Action component schema in the current context, and nothing else.\n\n----------------------------\n\nThe full current component context is available at:\n{{$context.$nodes.AUTHOR_COMPONENTS.$currentItem}}\n\nRead the following from it:\n- raw data: `data`\n- authoring hints: `authoringHints`\n- component id: `id`\n\n----------------------------\n\nRules:\n- Use the Action schema only.\n- Return exactly one of:\n  - `recommendations`\n  - `actions`\n- Never return both.\n- Each of  `recommendations.items` or actions.items` or must be an array of plain strings.\n- Preserve the intended order of items.\n- Write in a clear, professional business reporting tone.\n\n\nSelection rule:\n- Return `recommendations` only when `authoringHints` explicitly contain the exact word `recommendations` or the exact phrase `recommendation list`.\n- In every other case, return `actions`.\n\nExamples:\n- `authoringHints: \"Return recommendations.\"` -> `{\"recommendations\":{\"items\":[\"Item 1\"]}}`\n- `authoringHints: \"Return recommendation list.\"` -> `{\"recommendations\":{\"items\":[\"Item 1\"]}}`\n- `authoringHints: \"Return recommended actions.\"` -> `{\"actions\":{\"items\":[\"Item 1\"]}}`\n- `authoringHints: \"Return next steps.\"` -> `{\"actions\":{\"items\":[\"Item 1\"]}}`\n\n\nConstraints:\n- IMPORTANT: the `id` must be exactly {{$context.$nodes.AUTHOR_COMPONENTS.$currentItem.id}}\n- Return only the final JSON object.\n\nSelf-validation:\n- Before returning the final JSON, verify that you have strictly followed `authoringHints` when present.\n- If `authoringHints` specify selection, ordering, wording style, or formatting, ensure the output follows them exactly.\n- You must follow the selction rule - Return `recommendations` only when the authoringHints explicitly contain the word `recommendations` or the phrase `recommendation list`.\n- Do not return output that ignores or weakens `authoringHints`."
                    }
                  ],
                  "outputSpecification": "{\n    \"title\": \"Action Artifact Payload\",\n    \"type\": \"object\",\n    \"additionalProperties\": false,\n    \"required\": [\n        \"id\",\n        \"authoredPayload\"\n    ],\n    \"properties\": {\n        \"id\": {\n            \"type\": \"string\"\n        },\n        \"authoredPayload\": {\n            \"title\": \"Action Artifact Payload\",\n            \"type\": \"object\",\n            \"additionalProperties\": false,\n            \"properties\": {\n                \"actions\": {\n                    \"type\": \"object\",\n                    \"additionalProperties\": false,\n                    \"required\": [\n                        \"items\"\n                    ],\n                    \"properties\": {\n                        \"items\": {\n                            \"type\": \"array\",\n                            \"minItems\": 1,\n                            \"items\": {\n                                \"type\": \"string\"\n                            }\n                        }\n                    }\n                },\n                \"recommendations\": {\n                    \"type\": \"object\",\n                    \"additionalProperties\": false,\n                    \"required\": [\n                        \"items\"\n                    ],\n                    \"properties\": {\n                        \"items\": {\n                            \"type\": \"array\",\n                            \"minItems\": 1,\n                            \"items\": {\n                                \"type\": \"string\"\n                            }\n                        }\n                    }\n                }\n            },\n            \"oneOf\": [\n                {\n                    \"required\": [\n                        \"actions\"\n                    ],\n                    \"not\": {\n                        \"required\": [\n                            \"recommendations\"\n                        ]\n                    }\n                },\n                {\n                    \"required\": [\n                        \"recommendations\"\n                    ],\n                    \"not\": {\n                        \"required\": [\n                            \"actions\"\n                        ]\n                    }\n                }\n            ]\n        }\n    }\n}",
                  "type": "LLM"
                },
                {
                  "metadata": {
                    "errorNodeId": "1774612546174",
                    "name": "Build Table Context",
                    "returnType": "object",
                    "sourceCode": "/*\n  Summary:\n  - Read the current table component context.\n  - Normalize source row keys into a stable format for LLM consumption.\n  - Build the effective column order from component metadata or the first row.\n  - Build one representative sample row by filling each column with the first meaningful value found across source rows.\n  - Return a compact table context payload for downstream table authoring.\n*/\n\nfunction normalizeKey(value) {\n  return String(value || \"\")\n    .replace(/[^a-zA-Z0-9]/g, \"\")\n    .toUpperCase();\n}\n\nfunction isMeaningful(value) {\n  return value !== null && value !== undefined && value !== \"\";\n}\n\n// Normalize source row keys so the LLM sees a stable shape such as\n// RECEIPTNUMBER instead of mixed forms like \"Receipt Number\" or \"receiptNumber\".\nfunction buildNormalizedRow(rawRow) {\n  const normalizedRow = {};\n\n  Object.keys(rawRow || {}).forEach((key) => {\n    normalizedRow[normalizeKey(key)] = rawRow[key];\n  });\n\n  return normalizedRow;\n}\n\n// Respect an explicit column order when present.\n// Otherwise, fall back to the key order from the first row.\nfunction buildColumnOrder(currentItem, rawRows) {\n  if (Array.isArray(currentItem.columnOrder) && currentItem.columnOrder.length > 0) {\n    return currentItem.columnOrder.map(normalizeKey);\n  }\n\n  const firstRow = rawRows[0] || {};\n  return Object.keys(firstRow).map(normalizeKey);\n}\n\n// Build one representative sample row by filling each display column with the\n// first meaningful value found across the normalized source rows.\nfunction buildRepresentativeSampleRow(rows, preferredKeys) {\n  const sampleRow = {};\n  let filledColumnCount = 0;\n\n  rows.forEach((row) => {\n    preferredKeys.forEach((key) => {\n      if (isMeaningful(sampleRow[key])) {\n        return;\n      }\n\n      if (isMeaningful(row[key])) {\n        sampleRow[key] = row[key];\n        filledColumnCount += 1;\n      }\n    });\n  });\n\n  if (filledColumnCount === 0 && rows.length > 0) {\n    return rows[0];\n  }\n\n  return sampleRow;\n}\n\nconst currentItem = $context.$nodes.AUTHOR_COMPONENTS.$currentItem || {};\nconst rawRows = Array.isArray(currentItem.data) ? currentItem.data : [];\n\n// Normalize the full row set once so we can derive both column order and a\n// representative sample row from a consistent key format.\nconst normalizedRows = rawRows.map(buildNormalizedRow);\nconst columnOrder = buildColumnOrder(currentItem, rawRows);\nconst sampleRow = buildRepresentativeSampleRow(normalizedRows, columnOrder);\n\n// Return a compact payload for the LLM instead of the full dataset.\nreturn {\n  id: currentItem.id || \"\",\n  title: currentItem.title || \"\",\n  authoringHints: currentItem.authoringHints || \"\",\n  columnOrder,\n  rowCount: rawRows.length,\n  sampleRow\n};"
                  },
