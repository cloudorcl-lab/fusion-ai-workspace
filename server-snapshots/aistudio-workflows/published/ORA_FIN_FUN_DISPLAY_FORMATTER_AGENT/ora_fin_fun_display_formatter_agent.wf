                  "metadata": {
                    "name": "Build List Payload",
                    "returnType": "object",
                    "sourceCode": "/*\n  Summary:\n  - Read the current list component context from AUTHOR_COMPONENTS.\n  - Validate the top-level list input shape.\n  - Support list data items as:\n    - non-empty strings\n    - link objects: { label, href }\n  - Generate synthetic item ids so consumers do not need to provide them.\n  - Generate accessibility aria-label from title or list content.\n  - Normalize selectionMode into selection_mode.\n  - Format link items using the same renderer token logic as table support:\n    - deeplink\n    - relativeLink\n    - externalLink\n  - Emit a strict authoredPayload that matches the list schema contract.\n*/\n\nconst currentItemRaw = $context.$nodes.AUTHOR_COMPONENTS.$currentItem;\n\n/* --- General Helpers --- */\n\nfunction parseIfString(value) {\n  let parsed = value;\n\n  while (typeof parsed === \"string\") {\n    parsed = JSON.parse(parsed);\n  }\n\n  return parsed;\n}\n\nfunction throwFormatterError(code, message, details) {\n  const error = new Error(\"[\" + code + \"] \" + message);\n  error.errorType = code;\n  error.details = details || {};\n  throw error;\n}\n\nfunction isPlainObject(value) {\n  return value !== null && typeof value === \"object\" && !Array.isArray(value);\n}\n\nfunction isNonEmptyString(value) {\n  return typeof value === \"string\" && value.trim().length > 0;\n}\n\nfunction isBlank(value) {\n  return value === null || value === undefined || value === \"\";\n}\n\nfunction sanitizeTokenValue(value) {\n  return String(value || \"\")\n    .replace(/[{}]/g, \"\")\n    .replace(/,/g, \"\")\n    .trim();\n}\n\nfunction buildTokenObject(fields) {\n  return Object.keys(fields)\n    .filter((key) => !isBlank(fields[key]))\n    .map((key) => key + \":\" + sanitizeTokenValue(fields[key]))\n    .join(\",\");\n}\n\n/* --- Input Validation --- */\n\nfunction isLinkItem(value) {\n  return (\n    isPlainObject(value) &&\n    isNonEmptyString(value.label) &&\n    isNonEmptyString(value.href)\n  );\n}\n\nfunction isStringItem(value) {\n  return isNonEmptyString(value);\n}\n\nfunction normalizeSelectionMode(value) {\n  const normalizedValue = isNonEmptyString(value)\n    ? value.trim().toLowerCase()\n    : \"none\";\n\n  if (![\"none\", \"single\", \"multiple\"].includes(normalizedValue)) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"List selectionMode must be one of: none, single, multiple.\"\n    );\n  }\n\n  return normalizedValue;\n}\n\nfunction validateCurrentItem(item) {\n  if (!item || typeof item !== \"object\") {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"AUTHOR_COMPONENTS currentItem is missing or invalid.\"\n    );\n  }\n\n  if (!isNonEmptyString(item.id)) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"List component id is required.\"\n    );\n  }\n\n  if (item.type !== \"list\") {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"BUILD_LIST_PAYLOAD received non-list component type: \" + item.type\n    );\n  }\n\n  if (!Array.isArray(item.data)) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"List component data must be an array: \" + item.id\n    );\n  }\n\n  if (item.data.length === 0) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"List component data is empty: \" + item.id\n    );\n  }\n\n  item.data.forEach((entry, index) => {\n    if (isStringItem(entry) || isLinkItem(entry)) {\n      return;\n    }\n\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"List component data must contain only non-empty strings or link objects {label, href}. Invalid item at index \" +\n        index +\n        \" for component: \" +\n        item.id\n    );\n  });\n\n  normalizeSelectionMode(item.selectionMode);\n}\n\n/* --- Link Helpers --- */\n\nfunction normalizeLinkInput(rawValue) {\n  if (isLinkItem(rawValue)) {\n    return rawValue;\n  }\n\n  throwFormatterError(\n    \"INVALID_REQUEST\",\n    \"List link item must be an object with non-empty label and href.\"\n  );\n}\n\nfunction splitHrefParts(href) {\n  const text = String(href || \"\").trim();\n\n  if (!text) {\n    throwFormatterError(\"INVALID_REQUEST\", \"Link href is required.\");\n  }\n\n  const hashIndex = text.indexOf(\"#\");\n  const beforeHash = hashIndex >= 0 ? text.slice(0, hashIndex) : text;\n  const hash = hashIndex >= 0 ? text.slice(hashIndex) : \"\";\n\n  const queryIndex = beforeHash.indexOf(\"?\");\n  const pathPart = queryIndex >= 0 ? beforeHash.slice(0, queryIndex) : beforeHash;\n  const search = queryIndex >= 0 ? beforeHash.slice(queryIndex) : \"\";\n\n  return {\n    href: text,\n    pathPart,\n    search,\n    hash\n  };\n}\n\nfunction isAbsoluteHttpHref(href) {\n  return /^https?:\\/\\//i.test(String(href || \"\").trim());\n}\n\nfunction hasExplicitHost(href) {\n  return isAbsoluteHttpHref(href);\n}\n\nfunction extractHostFromAbsoluteHref(href) {\n  const text = String(href || \"\").trim();\n  const match = text.match(/^https?:\\/\\/([^\\/?#]+)(.*)?$/i);\n\n  if (!match) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Absolute link href must include a valid host: \" + text\n    );\n  }\n\n  return match[1];\n}\n\nfunction extractPathQueryHashFromAbsoluteHref(href) {\n  const text = String(href || \"\").trim();\n  const match = text.match(/^https?:\\/\\/[^\\/?#]+(\\/[^?#]*)?(\\?[^#]*)?(#.*)?$/i);\n\n  if (!match) {\n    return \"/\";\n  }\n\n  return (match[1] || \"/\") + (match[2] || \"\") + (match[3] || \"\");\n}\n\nfunction isDeeplinkHref(href) {\n  return String(href || \"\").toLowerCase().includes(\"deeplink\");\n}\n\nfunction classifyLinkHref(href) {\n  if (isDeeplinkHref(href)) {\n    return \"deeplink\";\n  }\n\n  if (!hasExplicitHost(href)) {\n    return \"relativeLink\";\n  }\n\n  return \"externalLink\";\n}\n\nfunction inferFamilyFromPath(path) {\n  const normalizedPath = String(path || \"\").toLowerCase();\n\n  if (/(^|\\/)hcmui\\//.test(normalizedPath)) {\n    return \"HCM\";\n  }\n\n  if (/(^|\\/)crmui\\//.test(normalizedPath)) {\n    return \"CRM\";\n  }\n\n  return \"FSCM\";\n}\n\nfunction stripLeadingSlash(path) {\n  return String(path || \"\").replace(/^\\/+/, \"\");\n}\n\nfunction stripUiShellPrefix(path) {\n  return String(path || \"\").replace(/^(fscmui|hcmui|crmui)\\//i, \"\");\n}\n\nfunction normalizeRelativeHref(href) {\n  const parts = splitHrefParts(href);\n  let normalizedPath = parts.pathPart + parts.search + parts.hash;\n\n  normalizedPath = stripLeadingSlash(normalizedPath);\n  normalizedPath = stripUiShellPrefix(normalizedPath);\n\n  return normalizedPath;\n}\n\nfunction getQueryParamValue(href, key) {\n  const parts = splitHrefParts(href);\n  const query = parts.search.startsWith(\"?\")\n    ? parts.search.slice(1)\n    : parts.search;\n\n  if (!query) {\n    return \"\";\n  }\n\n  const pairs = query.split(\"&\");\n\n  for (let index = 0; index < pairs.length; index += 1) {\n    const pair = pairs[index];\n\n    if (!pair) {\n      continue;\n    }\n\n    const equalIndex = pair.indexOf(\"=\");\n    const rawKey = equalIndex >= 0 ? pair.slice(0, equalIndex) : pair;\n    const rawValue = equalIndex >= 0 ? pair.slice(equalIndex + 1) : \"\";\n\n    if (decodeURIComponent(rawKey) === key) {\n      return decodeURIComponent(rawValue);\n    }\n  }\n\n  return \"\";\n}\n\nfunction buildRelativeLinkToken(rawValue) {\n  const link = normalizeLinkInput(rawValue);\n  const normalizedUrl = normalizeRelativeHref(link.href);\n  const family = inferFamilyFromPath(link.href);\n\n  return (\n    \"{relativeLink:{\" +\n    buildTokenObject({\n      url: normalizedUrl,\n      text: link.label,\n      family\n    }) +\n    \"}}\"\n  );\n}\n\nfunction buildDeeplinkToken(rawValue) {\n  const link = normalizeLinkInput(rawValue);\n  const objType = getQueryParamValue(link.href, \"objType\");\n  const action = getQueryParamValue(link.href, \"action\");\n  const objKey = getQueryParamValue(link.href, \"objKey\");\n  const pathWithQuery = hasExplicitHost(link.href)\n    ? extractPathQueryHashFromAbsoluteHref(link.href)\n    : normalizeRelativeHref(link.href);\n  const family = inferFamilyFromPath(pathWithQuery);\n\n  if (!isNonEmptyString(objType) || !isNonEmptyString(action)) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Deep link href must include objType and action: \" + link.href\n    );\n  }\n\n  return (\n    \"{deeplink:{\" +\n    buildTokenObject({\n      objType,\n      action,\n      ...(isNonEmptyString(objKey) ? { objKey } : {}),\n      text: link.label,\n      family,\n      ...(hasExplicitHost(link.href)\n        ? { host: extractHostFromAbsoluteHref(link.href) }\n        : {})\n    }) +\n    \"}}\"\n  );\n}\n\nfunction buildExternalLinkToken(rawValue) {\n  const link = normalizeLinkInput(rawValue);\n\n  if (!hasExplicitHost(link.href)) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"External link href must include a host: \" + link.href\n    );\n  }\n\n  return (\n    \"{externalLink:{\" +\n    buildTokenObject({\n      url: extractPathQueryHashFromAbsoluteHref(link.href),\n      text: link.label,\n      host: extractHostFromAbsoluteHref(link.href)\n    }) +\n    \"}}\"\n  );\n}\n\nfunction formatLinkValue(rawValue) {\n  const link = normalizeLinkInput(rawValue);\n  const linkKind = classifyLinkHref(link.href);\n\n  if (linkKind === \"deeplink\") {\n    return buildDeeplinkToken(link);\n  }\n\n  if (linkKind === \"relativeLink\") {\n    return buildRelativeLinkToken(link);\n  }\n\n  return buildExternalLinkToken(link);\n}\n\n/* --- Accessibility Helpers --- */\n\nfunction buildAriaLabel(item) {\n  if (isNonEmptyString(item.title)) {\n    return item.title;\n  }\n\n  for (let index = 0; index < item.data.length; index += 1) {\n    const entry = item.data[index];\n\n    if (isStringItem(entry)) {\n      return entry.trim();\n    }\n\n    if (isLinkItem(entry)) {\n      return entry.label.trim();\n    }\n  }\n\n  return \"List\";\n}\n\n/* --- Item Builders --- */\n\nfunction buildSyntheticItemId(componentId, index) {\n  return componentId + \"_\" + String(index + 1);\n}\n\nfunction formatListItemValue(rawItem) {\n  if (isStringItem(rawItem)) {\n    return rawItem.trim();\n  }\n\n  if (isLinkItem(rawItem)) {\n    return formatLinkValue(rawItem);\n  }\n\n  throwFormatterError(\n    \"INVALID_REQUEST\",\n    \"Unsupported list item type encountered during payload build.\"\n  );\n}\n\nfunction buildListFieldItem(componentId, rawItem, index) {\n  const value = formatListItemValue(rawItem);\n\n  return {\n    id: buildSyntheticItemId(componentId, index),\n    Default: value,\n    value\n  };\n}\n\n/* --- Final Payload Builder --- */\n\nfunction buildListPayload(item) {\n  const header = isNonEmptyString(item.title) ? item.title : \"\";\n  const selectionMode = normalizeSelectionMode(item.selectionMode);\n\n  return {\n    header,\n    fields: {\n      items: item.data.map((entry, index) =>\n        buildListFieldItem(item.id, entry, index)\n      )\n    },\n    keyAttributes: {\n      items: [\"id\"]\n    },\n    selection_mode: selectionMode,\n    accessibility: {\n      \"aria-label\": buildAriaLabel(item)\n    }\n  };\n}\n\n/* --- Execution --- */\n\nconst currentItem = parseIfString(currentItemRaw);\n\nvalidateCurrentItem(currentItem);\n\nreturn {\n  id: currentItem.id,\n  authoredPayload: buildListPayload(currentItem)\n};"
                  },
