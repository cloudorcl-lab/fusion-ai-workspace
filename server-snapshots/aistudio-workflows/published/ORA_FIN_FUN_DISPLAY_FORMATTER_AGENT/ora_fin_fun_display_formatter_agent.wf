        {
          "metadata": {
            "name": "Handle Exceptions",
            "returnType": "object",
            "sourceCode": "const errorMessage = $context.$error.$errorMessage || \"\";\nconst isInvalidRequest = errorMessage.includes(\"[INVALID_REQUEST]\");\nconst isProcessingError = errorMessage.includes(\"[PROCESSING_ERROR]\");\nconst isInternalError = errorMessage.includes(\"[INTERNAL_ERROR]\");\n\nconst isDebugEnabled = String($context.$triggers.REST.$input.isDebugEnabled || \"Y\")\n  .trim()\n  .toUpperCase();\n\nconst workflowName = String($context.$triggers.REST.$input.workflowName || \"\")\n  .trim();\n\n// Let unknown errors continue.\nif (!isInvalidRequest && !isProcessingError && !isInternalError) {\n  throw new Error(errorMessage || \"Unhandled error\");\n}\n\nlet responseText;\n\nif (isDebugEnabled === \"Y\") {\n  responseText = errorMessage;\n} else if (isInvalidRequest) {\n  responseText =\n    \"The request could not be processed because some input is invalid. Please review the request details and try again.\";\n} else if (isProcessingError) {\n  responseText =\n    \"The display formatter could not complete the request. Please try again. If the issue continues, contact support.\";\n} else {\n  responseText =\n    \"The display formatter encountered an unexpected error. Please try again later. If the issue continues, contact support.\";\n}\n\nreturn {\n  agent: workflowName || $context.$workflow.$name,\n  agent_response: [\n    {\n      display_type: \"text\",\n      display_sequence: 1,\n      text: responseText\n    }\n  ]\n};"
          },
          "outcomes": {
            "success": "1774612624748"
          },
          "code": "HANDLEEXCEPTIONS",
          "id": "1774612546174",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1774612546174",
            "name": "Compile Display Plan",
            "returnType": "object",
            "sourceCode": "/*\n  Summary:\n  - Read the consumer-supplied template input.\n  - Build a valid DisplayPlan with meta, components, and groups.\n  - Keep text, action, list, and canvas components ungrouped.\n  - Build drilldownView groups from grouped table and scoreboard messages.\n  - Enforce grouping rules so consumers do not need to know display-plan mechanics.\n  - Default text contentPolicy to \"author\" when missing or empty.\n  - Validate text contentPolicy against: author, normalizeOnly, preserve.\n  - Default table chatDisplayConfig to limitRowsInChat: true and rowLimit: 8.\n  - Use direct data for all component types.\n  - For table components, require data to be a non-empty array of row objects and derive columnOrder here.\n  - For action components, require data to be either:\n    - an array of strings, or\n    - an object with an items array of strings.\n  - For list components, require data to be a non-empty array of:\n    - non-empty strings, or\n    - link objects with non-empty label and href.\n  - Do not require consumers to send isPrimary.\n  - Internally mark grouped tables as isPrimary: true so downstream behavior stays unchanged.\n*/\n\nconst templateInputRaw = $context.$triggers.REST.$input.displayTemplate;\nconst workflowName = $context.$triggers.REST.$input.workflowName || \"\";\n\nconst SUPPORTED_COMPONENT_TYPES = [\n  \"text\",\n  \"table\",\n  \"scoreboard\",\n  \"action\",\n  \"list\",\n  \"canvas\"\n];\nconst SUPPORTED_CONTENT_POLICIES = [\"author\", \"normalizeOnly\", \"preserve\"];\nconst SUPPORTED_LIST_SELECTION_MODES = [\"none\", \"single\", \"multiple\"];\nconst DEFAULT_TABLE_CHAT_ROW_LIMIT = 10;\n\nfunction parseIfString(value) {\n  let parsed = value;\n\n  while (typeof parsed === \"string\") {\n    parsed = JSON.parse(parsed);\n  }\n\n  return parsed;\n}\n\nfunction clone(value) {\n  return JSON.parse(JSON.stringify(value));\n}\n\nfunction isNonEmptyString(value) {\n  return typeof value === \"string\" && value.trim().length > 0;\n}\n\nfunction isPlainObject(value) {\n  return value !== null && typeof value === \"object\" && !Array.isArray(value);\n}\n\nfunction isLinkObject(value) {\n  return (\n    isPlainObject(value) &&\n    isNonEmptyString(value.label) &&\n    isNonEmptyString(value.href)\n  );\n}\n\nfunction throwFormatterError(code, message, details) {\n  const error = new Error(\"[\" + code + \"] \" + message);\n  error.errorType = code;\n  error.details = details || {};\n  throw error;\n}\n\nfunction normalizeContentPolicy(value) {\n  if (!isNonEmptyString(value)) {\n    return \"author\";\n  }\n\n  const normalizedInput = value.trim().toLowerCase();\n  const matchedValue = SUPPORTED_CONTENT_POLICIES.find(\n    (item) => item.toLowerCase() === normalizedInput\n  );\n\n  if (!matchedValue) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Invalid contentPolicy. Supported values are: author, normalizeOnly, preserve.\"\n    );\n  }\n\n  return matchedValue;\n}\n\nfunction normalizeChatDisplayConfig(value) {\n  const config = isPlainObject(value) ? value : {};\n\n  const limitRowsInChat =\n    typeof config.limitRowsInChat === \"boolean\"\n      ? config.limitRowsInChat\n      : true;\n\n  const rowLimit =\n    typeof config.rowLimit === \"undefined\" ||\n    config.rowLimit === null ||\n    config.rowLimit === \"\"\n      ? DEFAULT_TABLE_CHAT_ROW_LIMIT\n      : config.rowLimit;\n\n  if (!Number.isInteger(rowLimit) || rowLimit < 0) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Invalid chatDisplayConfig.rowLimit. It must be a non-negative integer.\"\n    );\n  }\n\n  return {\n    limitRowsInChat,\n    rowLimit\n  };\n}\n\nfunction normalizeListSelectionMode(value) {\n  if (!isNonEmptyString(value)) {\n    return \"none\";\n  }\n\n  const normalizedValue = value.trim().toLowerCase();\n\n  if (!SUPPORTED_LIST_SELECTION_MODES.includes(normalizedValue)) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Invalid list selectionMode. Supported values are: none, single, multiple.\"\n    );\n  }\n\n  return normalizedValue;\n}\n\nfunction normalizeTemplateInput(input) {\n  if (!isPlainObject(input)) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Template input is missing or invalid. Build Display Template must return one object with messages.\"\n    );\n  }\n\n  if (!Array.isArray(input.messages) || input.messages.length === 0) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"messages must be a non-empty array. Add at least one message block to the template.\"\n    );\n  }\n\n  return input;\n}\n\nfunction validateCanvasCount(messages) {\n  let canvasCount = 0;\n\n  for (let index = 0; index < messages.length; index += 1) {\n    const item = messages[index];\n\n    if (item && item.type === \"canvas\") {\n      canvasCount += 1;\n\n      if (canvasCount > 1) {\n        throwFormatterError(\n          \"INVALID_REQUEST\",\n          \"Only one canvas component is allowed in a request.\"\n        );\n      }\n    }\n  }\n}\n\nfunction validateUniqueComponentIds(messages) {\n  const seen = new Set();\n\n  messages.forEach((item) => {\n    if (!isNonEmptyString(item.id)) {\n      throwFormatterError(\n        \"INVALID_REQUEST\",\n        \"Each component must include a non-empty id.\"\n      );\n    }\n\n    if (seen.has(item.id)) {\n      throwFormatterError(\n        \"INVALID_REQUEST\",\n        \"Duplicate component id found: \" + item.id\n      );\n    }\n\n    seen.add(item.id);\n  });\n}\n\nfunction ensureDataPresent(input, componentLabel) {\n  if (typeof input.data === \"undefined\") {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      componentLabel + \" component must include data: \" + input.id\n    );\n  }\n}\n\nfunction validateTextData(input) {\n  ensureDataPresent(input, \"Text\");\n}\n\nfunction validateTableData(input) {\n  if (typeof input.data === \"undefined\") {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Table component data is missing: \" +\n        input.id +\n        \". Table components must use direct data as an array of row objects. If there is no row data, do not use a table template. Use a text template instead.\"\n    );\n  }\n\n  if (!Array.isArray(input.data)) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Table component data must be an array of row objects: \" +\n        input.id +\n        \". If your source does not return row data, use a text template instead.\"\n    );\n  }\n\n  if (input.data.length === 0) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Table component data is empty: \" +\n        input.id +\n        \". If there are no rows to show, do not use a table template. Use a text template instead.\"\n    );\n  }\n\n  for (let index = 0; index < input.data.length; index += 1) {\n    const row = input.data[index];\n\n    if (!isPlainObject(row)) {\n      throwFormatterError(\n        \"INVALID_REQUEST\",\n        \"Table component rows must be objects. Invalid row at index \" +\n          index +\n          \" for component: \" +\n          input.id\n      );\n    }\n  }\n}\n\nfunction validateScoreboardData(input) {\n  ensureDataPresent(input, \"Scoreboard\");\n\n  if (Array.isArray(input.data) && input.data.length === 0) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Scoreboard component data is empty: \" +\n        input.id +\n        \". If there are no KPIs to show, remove the scoreboard component from the template.\"\n    );\n  }\n}\n\nfunction validateCanvasData(input) {\n  ensureDataPresent(input, \"Canvas\");\n}\n\nfunction validateActionData(input) {\n  ensureDataPresent(input, \"Action\");\n\n  const data = input.data;\n\n  if (Array.isArray(data)) {\n    if (data.length === 0) {\n      throwFormatterError(\n        \"INVALID_REQUEST\",\n        \"Action component data array is empty: \" +\n          input.id +\n          \". Provide at least one action item or remove the action component.\"\n      );\n    }\n\n    data.forEach((item, index) => {\n      if (!isNonEmptyString(item)) {\n        throwFormatterError(\n          \"INVALID_REQUEST\",\n          \"Action component data array must contain only non-empty strings. Invalid item at index \" +\n            index +\n            \" for component: \" +\n            input.id\n        );\n      }\n    });\n    return;\n  }\n\n  if (isPlainObject(data) && Array.isArray(data.items)) {\n    if (data.items.length === 0) {\n      throwFormatterError(\n        \"INVALID_REQUEST\",\n        \"Action component data.items is empty: \" +\n          input.id +\n          \". Provide at least one action item or remove the action component.\"\n      );\n    }\n\n    data.items.forEach((item, index) => {\n      if (!isNonEmptyString(item)) {\n        throwFormatterError(\n          \"INVALID_REQUEST\",\n          \"Action component data.items must contain only non-empty strings. Invalid item at index \" +\n            index +\n            \" for component: \" +\n            input.id\n        );\n      }\n    });\n    return;\n  }\n\n  throwFormatterError(\n    \"INVALID_REQUEST\",\n    \"Action component data must be either an array of strings or an object with an items array of strings: \" +\n      input.id\n  );\n}\n\nfunction validateListData(input) {\n  ensureDataPresent(input, \"List\");\n\n  if (!Array.isArray(input.data)) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"List component data must be an array: \" + input.id\n    );\n  }\n\n  if (input.data.length === 0) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"List component data is empty: \" + input.id\n    );\n  }\n\n  input.data.forEach((item, index) => {\n    if (isNonEmptyString(item)) {\n      return;\n    }\n\n    if (isLinkObject(item)) {\n      return;\n    }\n\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"List component data must contain only non-empty strings or link objects {label, href}. Invalid item at index \" +\n        index +\n        \" for component: \" +\n        input.id\n    );\n  });\n\n  normalizeListSelectionMode(input.selectionMode);\n}\n\nfunction buildColumnOrderFromTableData(rows) {\n  if (!Array.isArray(rows) || rows.length === 0) {\n    return [];\n  }\n\n  const firstRow = rows[0];\n\n  if (!isPlainObject(firstRow)) {\n    return [];\n  }\n\n  return Object.keys(firstRow);\n}\n\nfunction validateInputShape(input) {\n  if (!isNonEmptyString(input.type)) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Component type is required for id: \" + input.id\n    );\n  }\n\n  if (!SUPPORTED_COMPONENT_TYPES.includes(input.type)) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Unsupported component type: \" + input.type\n    );\n  }\n\n  if (input.type === \"text\") {\n    if (isNonEmptyString(input.groupId) || isNonEmptyString(input.groupTitle)) {\n      throwFormatterError(\n        \"INVALID_REQUEST\",\n        \"Text components cannot be grouped: \" + input.id\n      );\n    }\n\n    validateTextData(input);\n    normalizeContentPolicy(input.contentPolicy);\n    return;\n  }\n\n  if (input.type === \"action\") {\n    if (isNonEmptyString(input.groupId) || isNonEmptyString(input.groupTitle)) {\n      throwFormatterError(\n        \"INVALID_REQUEST\",\n        \"Action components cannot be grouped: \" + input.id\n      );\n    }\n\n    validateActionData(input);\n    return;\n  }\n\n  if (input.type === \"list\") {\n    if (isNonEmptyString(input.groupId) || isNonEmptyString(input.groupTitle)) {\n      throwFormatterError(\n        \"INVALID_REQUEST\",\n        \"List components cannot be grouped: \" + input.id\n      );\n    }\n\n    validateListData(input);\n    return;\n  }\n\n  if (input.type === \"canvas\") {\n    if (isNonEmptyString(input.groupId) || isNonEmptyString(input.groupTitle)) {\n      throwFormatterError(\n        \"INVALID_REQUEST\",\n        \"Canvas components cannot be grouped: \" + input.id\n      );\n    }\n\n    validateCanvasData(input);\n    return;\n  }\n\n  if (input.type === \"table\") {\n    validateTableData(input);\n\n    if (isNonEmptyString(input.groupId) && !isNonEmptyString(input.groupTitle)) {\n      throwFormatterError(\n        \"INVALID_REQUEST\",\n        \"Grouped table component must include groupTitle: \" + input.id\n      );\n    }\n\n    normalizeChatDisplayConfig(input.chatDisplayConfig);\n    return;\n  }\n\n  if (input.type === \"scoreboard\") {\n    if (!isNonEmptyString(input.groupId) || !isNonEmptyString(input.groupTitle)) {\n      throwFormatterError(\n        \"INVALID_REQUEST\",\n        \"Scoreboard components must be grouped: \" + input.id\n      );\n    }\n\n    validateScoreboardData(input);\n    return;\n  }\n}\n\nfunction buildComponent(input) {\n  const component = {\n    id: input.id,\n    type: input.type\n  };\n\n  if (isNonEmptyString(input.title)) {\n    component.title = input.title;\n  }\n\n  if (isNonEmptyString(input.authoringHints)) {\n    component.authoringHints = input.authoringHints;\n  }\n\n  if (input.type === \"text\") {\n    component.contentPolicy = normalizeContentPolicy(input.contentPolicy);\n    component.data = clone(input.data);\n    return component;\n  }\n\n  if (input.type === \"table\") {\n    component.data = clone(input.data);\n    component.columnOrder = buildColumnOrderFromTableData(input.data);\n    component.chatDisplayConfig = normalizeChatDisplayConfig(input.chatDisplayConfig);\n\n    if (isNonEmptyString(input.groupId)) {\n      component.isPrimary = true;\n    }\n\n    return component;\n  }\n\n  if (input.type === \"scoreboard\") {\n    component.data = clone(input.data);\n    return component;\n  }\n\n  if (input.type === \"list\") {\n    component.data = clone(input.data);\n    component.selectionMode = normalizeListSelectionMode(input.selectionMode);\n    return component;\n  }\n\n  if (input.type === \"canvas\") {\n    component.data = clone(input.data);\n    return component;\n  }\n\n  if (input.type === \"action\") {\n    component.data = clone(input.data);\n    return component;\n  }\n\n  throwFormatterError(\n    \"INVALID_REQUEST\",\n    \"Unsupported component type while building component: \" + input.type\n  );\n}\n\nfunction collectGroups(messages) {\n  const groupsById = Object.create(null);\n\n  messages.forEach((input) => {\n    if (!isNonEmptyString(input.groupId)) {\n      return;\n    }\n\n    if (!groupsById[input.groupId]) {\n      groupsById[input.groupId] = {\n        groupId: input.groupId,\n        groupTitle: input.groupTitle,\n        inputs: []\n      };\n    }\n\n    const group = groupsById[input.groupId];\n\n    if (!isNonEmptyString(group.groupTitle) && isNonEmptyString(input.groupTitle)) {\n      group.groupTitle = input.groupTitle;\n    }\n\n    if (\n      isNonEmptyString(group.groupTitle) &&\n      isNonEmptyString(input.groupTitle) &&\n      group.groupTitle !== input.groupTitle\n    ) {\n      throwFormatterError(\n        \"INVALID_REQUEST\",\n        \"Conflicting groupTitle values found for groupId: \" + input.groupId\n      );\n    }\n\n    group.inputs.push(input);\n  });\n\n  return groupsById;\n}\n\nfunction buildGroup(group) {\n  if (!isNonEmptyString(group.groupTitle)) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Grouped components must include groupTitle for groupId: \" + group.groupId\n    );\n  }\n\n  const tables = group.inputs.filter(\n    (input) => input.type === \"table\"\n  );\n\n  if (tables.length !== 1) {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      \"Each group must contain exactly one table. groupId: \" + group.groupId\n    );\n  }\n\n  const primaryTable = tables[0];\n\n  group.inputs.forEach((input) => {\n    if (input.id === primaryTable.id) {\n      return;\n    }\n\n    if (![\"scoreboard\"].includes(input.type)) {\n      throwFormatterError(\n        \"INVALID_REQUEST\",\n        \"Only scoreboard is allowed as supporting grouped content for now. groupId: \" +\n          group.groupId\n      );\n    }\n  });\n\n  return {\n    groupId: group.groupId,\n    groupTitle: group.groupTitle,\n    behavior: \"drilldownView\",\n    primaryComponentId: primaryTable.id,\n    componentIds: group.inputs.map((input) => input.id)\n  };\n}\n\nfunction buildDisplayPlan(templateInput) {\n  const normalizedInput = normalizeTemplateInput(templateInput);\n  const messages = normalizedInput.messages;\n\n  validateCanvasCount(messages);\n  validateUniqueComponentIds(messages);\n  messages.forEach(validateInputShape);\n\n  const components = messages.map(buildComponent);\n  const groupsById = collectGroups(messages);\n  const groups = Object.values(groupsById).map(buildGroup);\n\n  return {\n    meta: {\n      agentName: workflowName\n    },\n    components,\n    groups\n  };\n}\n\nconst templateInput = parseIfString(templateInputRaw);\nreturn buildDisplayPlan(templateInput);"
          },
