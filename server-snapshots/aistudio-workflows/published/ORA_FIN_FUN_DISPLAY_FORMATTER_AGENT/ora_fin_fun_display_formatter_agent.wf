          "code": "MODIFYDATA",
          "id": "1774448049164",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1774612546174",
            "name": "Assemble Authored Components",
            "returnType": "object",
            "sourceCode": "/*\n  Summary:\n  - Assemble the authored display plan into the final agent_response payload.\n  - Keep root table rendering separate from inner table rendering:\n    - root tables use component.rootData when available\n    - inner artifact tables continue to use component.data\n  - Preserve authored component order when building root blocks.\n  - Build standalone root blocks, grouped table drilldown blocks, and the optional defaultView canvas block.\n  - Apply root-table row limiting through chatDisplayConfig.\n  - Always keep action blocks at the end of the final response.\n*/\n\nconst DEFAULT_TABLE_CHAT_ROW_LIMIT = 5;\n\nfunction _clone(value) {\n  if (value === undefined) {\n    return undefined;\n  }\n\n  return JSON.parse(JSON.stringify(value));\n}\n\nfunction throwFormatterError(code, message, details) {\n  const error = new Error(\"[\" + code + \"] \" + message);\n  error.errorType = code;\n  error.details = details || {};\n  throw error;\n}\n\nfunction _throwDisplayPlanRuleError(message, details) {\n  const error = new Error(message);\n  error.errorType = \"DISPLAY_PLAN_RULE_ERROR\";\n  error.details = details || {};\n  throw error;\n}\n\nfunction _assert(condition, message, details) {\n  if (!condition) {\n    _throwDisplayPlanRuleError(message, details);\n  }\n}\n\nfunction _normalizeTableChatDisplayConfig(chatDisplayConfig) {\n  const config =\n    chatDisplayConfig &&\n    typeof chatDisplayConfig === \"object\" &&\n    !Array.isArray(chatDisplayConfig)\n      ? chatDisplayConfig\n      : {};\n\n  const limitRowsInChat =\n    typeof config.limitRowsInChat === \"boolean\"\n      ? config.limitRowsInChat\n      : true;\n\n  const rowLimit =\n    typeof config.rowLimit === \"number\" &&\n    Number.isInteger(config.rowLimit) &&\n    config.rowLimit >= 0\n      ? config.rowLimit\n      : DEFAULT_TABLE_CHAT_ROW_LIMIT;\n\n  return {\n    limitRowsInChat,\n    rowLimit\n  };\n}\n\n// Root table rendering may differ from inner artifact rendering.\n// When rootData exists, use it only for the root table block.\nfunction _getRootTablePayload(component) {\n  return component.rootData || component.data;\n}\n\n// Build a fast lookup for components by id and validate the top-level shape.\nfunction _buildIndexes(authoredDisplayPlan) {\n  _assert(\n    authoredDisplayPlan && typeof authoredDisplayPlan === \"object\",\n    \"authoredDisplayPlan must be an object\"\n  );\n  _assert(\n    Array.isArray(authoredDisplayPlan.components),\n    \"components must be an array\"\n  );\n  _assert(\n    Array.isArray(authoredDisplayPlan.groups),\n    \"groups must be an array\"\n  );\n\n  const componentsById = Object.create(null);\n\n  for (const component of authoredDisplayPlan.components) {\n    _assert(\n      component && typeof component === \"object\",\n      \"each component must be an object\"\n    );\n    _assert(component.id, \"each component must have an id\");\n    _assert(\n      !componentsById[component.id],\n      `duplicate component id: ${component.id}`,\n      { componentId: component.id }\n    );\n    componentsById[component.id] = component;\n  }\n\n  return { componentsById };\n}\n\n// Validate group rules and collect all grouped component ids.\nfunction _validateGroups(authoredDisplayPlan, componentsById) {\n  const groupedComponentIds = new Set();\n  let defaultViewCount = 0;\n\n  for (const group of authoredDisplayPlan.groups) {\n    _assert(group && typeof group === \"object\", \"each group must be an object\");\n    _assert(group.groupId, \"groupId is required\");\n    _assert(group.groupTitle, \"groupTitle is required\");\n    _assert(group.behavior, \"behavior is required\");\n    _assert(group.primaryComponentId, \"primaryComponentId is required\");\n    _assert(\n      Array.isArray(group.componentIds),\n      `group ${group.groupId} componentIds must be an array`\n    );\n    _assert(\n      group.componentIds.length > 0,\n      `group ${group.groupId} must contain at least one component id`\n    );\n\n    if (group.behavior === \"defaultView\") {\n      defaultViewCount += 1;\n    }\n\n    _assert(\n      componentsById[group.primaryComponentId],\n      `group ${group.groupId} primaryComponentId not found: ${group.primaryComponentId}`,\n      {\n        groupId: group.groupId,\n        primaryComponentId: group.primaryComponentId\n      }\n    );\n\n    _assert(\n      group.componentIds.includes(group.primaryComponentId),\n      `group ${group.groupId} must include primaryComponentId in componentIds`,\n      {\n        groupId: group.groupId,\n        primaryComponentId: group.primaryComponentId\n      }\n    );\n\n    for (const componentId of group.componentIds) {\n      const component = componentsById[componentId];\n      _assert(\n        component,\n        `group ${group.groupId} references unknown component id: ${componentId}`,\n        { groupId: group.groupId, componentId }\n      );\n      _assert(\n        !groupedComponentIds.has(componentId),\n        `component ${componentId} cannot belong to multiple groups`,\n        { componentId }\n      );\n      groupedComponentIds.add(componentId);\n    }\n\n    const primaryComponent = componentsById[group.primaryComponentId];\n\n    if (group.behavior === \"drilldownView\") {\n      _assert(\n        primaryComponent.type === \"table\",\n        `drilldownView group ${group.groupId} must have table as primary`,\n        { groupId: group.groupId, primaryType: primaryComponent.type }\n      );\n\n      for (const componentId of group.componentIds) {\n        const type = componentsById[componentId].type;\n        const allowedTypes = [\"table\", \"scoreboard\"];\n        _assert(\n          allowedTypes.includes(type),\n          `component type ${type} is not allowed in drilldownView group ${group.groupId}`,\n          { groupId: group.groupId, componentId, type }\n        );\n      }\n    } else if (group.behavior === \"defaultView\") {\n      const allowedPrimaryTypes = [\"email\", \"summaryRichText\"];\n      const allowedTypes = [\"email\", \"summaryRichText\"];\n\n      _assert(\n        allowedPrimaryTypes.includes(primaryComponent.type),\n        `defaultView group ${group.groupId} has invalid primary type ${primaryComponent.type}`,\n        { groupId: group.groupId, primaryType: primaryComponent.type }\n      );\n\n      for (const componentId of group.componentIds) {\n        const type = componentsById[componentId].type;\n        _assert(\n          allowedTypes.includes(type),\n          `component type ${type} is not allowed in defaultView group ${group.groupId}`,\n          { groupId: group.groupId, componentId, type }\n        );\n      }\n    } else {\n      _throwDisplayPlanRuleError(\n        `unsupported group behavior: ${group.behavior}`,\n        { behavior: group.behavior, groupId: group.groupId }\n      );\n    }\n  }\n\n  _assert(\n    defaultViewCount <= 1,\n    \"only one defaultView group is allowed for now\"\n  );\n\n  return { groupedComponentIds };\n}\n\nfunction _buildInnerTablePayload(tablePayload, headerText) {\n  return {\n    type: \"table\",\n    headerText: headerText || tablePayload.headerText || \"\",\n    rows: _clone(tablePayload.rows),\n    columns: _clone(tablePayload.columns),\n    keyAttributes: _clone(tablePayload.keyAttributes)\n  };\n}\n\n// Build a root table block. Row trimming is controlled through table chatDisplayConfig.\nfunction _buildRootTableBlock(\n  tablePayload,\n  heading,\n  shouldLimitRows,\n  rowLimit\n) {\n  const block = {\n    display_type: \"table\",\n    rows: _clone(tablePayload.rows),\n    columns: _clone(tablePayload.columns),\n    keyAttributes: _clone(tablePayload.keyAttributes),\n    ...(tablePayload.accessibility\n      ? { accessibility: _clone(tablePayload.accessibility) }\n      : {})\n  };\n\n  if (heading) {\n    block.heading = heading;\n  }\n\n  if (shouldLimitRows && Array.isArray(block.rows?.items)) {\n    block.rows.items = block.rows.items.slice(0, rowLimit);\n  }\n\n  return block;\n}\n\nfunction _buildStandaloneRootBlock(component) {\n  if (component.type === \"text\") {\n    const block = {\n      display_type: \"text\",\n      text: component.data.text\n    };\n\n    if (component.title) {\n      block.heading = component.title;\n    }\n\n    return block;\n  }\n\n  if (component.type === \"table\") {\n  const rootTablePayload = _getRootTablePayload(component);\n  const tableHeading = component.title || rootTablePayload.headerText || \"\";\n  const chatDisplayConfig = _normalizeTableChatDisplayConfig(\n    component.chatDisplayConfig\n  );\n  const shouldLimitRows = chatDisplayConfig.limitRowsInChat;\n  const rowLimit = chatDisplayConfig.rowLimit;\n\n  const block = _buildRootTableBlock(\n    rootTablePayload,\n    tableHeading,\n    shouldLimitRows,\n    rowLimit\n  );\n\n  block.artifact = {\n    contextMarker: \"artifactCard\",\n    canvasHeaderText: tableHeading || \"Details\",\n    artifacts: [\n      _buildInnerTablePayload(\n        component.data,\n        tableHeading || \"Details\"\n      )\n    ]\n  };\n\n  return block;\n}\n\n  if (component.type === \"list\") {\n    const block = {\n      display_type: \"list\",\n      header: component.title || component.data.header,\n      fields: _clone(component.data.fields),\n      keyAttributes: _clone(component.data.keyAttributes),\n      accessibility: _clone(component.data.accessibility)\n    };\n\n    if (component.data.selection_mode) {\n      block.selection_mode = component.data.selection_mode;\n    }\n\n    return block;\n  }\n\n  if (component.type === \"action\") {\n    const block = { display_type: \"action\" };\n\n    if (component.data.actions) {\n      block.actions = _clone(component.data.actions);\n    } else {\n      block.recommendations = _clone(component.data.recommendations);\n    }\n\n    return block;\n  }\n\nif (component.type === \"canvas\") {\n  return {\n    display_type: \"canvas\",\n    canvas_content: _clone(component.data)\n  };\n}\n\n  _throwDisplayPlanRuleError(\n    `ungrouped component type not supported at root: ${component.type}`,\n    { componentId: component.id, type: component.type }\n  );\n}\n\nfunction _buildDrilldownGroupBlock(group, componentsById) {\n  const primaryComponent = componentsById[group.primaryComponentId];\n  const primaryRootTablePayload = _getRootTablePayload(primaryComponent);\n  const tableHeading = group.groupTitle;\n  const chatDisplayConfig = _normalizeTableChatDisplayConfig(\n    primaryComponent.chatDisplayConfig\n  );\n  const shouldLimitRows = chatDisplayConfig.limitRowsInChat;\n  const rowLimit = chatDisplayConfig.rowLimit;\n\n  const block = _buildRootTableBlock(\n    primaryRootTablePayload,\n    tableHeading,\n    shouldLimitRows,\n    rowLimit\n  );\n\n  const artifacts = [];\n  let hasSupportingTableLikeDetail = false;\n\n  for (const componentId of group.componentIds) {\n    if (componentId === group.primaryComponentId) {\n      continue;\n    }\n\n    const component = componentsById[componentId];\n    if (component.type === \"table\") {\n      hasSupportingTableLikeDetail = true;\n    }\n\n    artifacts.push(_clone(component.data));\n  }\n\n  // Grouped drilldown should remain self-contained.\n  // Always include the inner primary table inside the artifact when there is\n  // no explicit supporting table.\n  if (!hasSupportingTableLikeDetail) {\n    artifacts.unshift(\n      _buildInnerTablePayload(primaryComponent.data, tableHeading)\n    );\n  }\n\n  if (artifacts.length > 0) {\n    block.artifact = {\n      contextMarker: \"artifactCard\",\n      canvasHeaderText: tableHeading,\n      artifacts\n    };\n  }\n\n  return block;\n}\n\n// Preserve authored component order at root.\n// When a grouped table primary is encountered, render the full drilldown block\n// at that exact position and skip the grouped supporting components later.\nfunction _appendRootBlocksInAuthorOrder(\n  rootBlocks,\n  authoredDisplayPlan,\n  groupedComponentIds,\n  componentsById\n) {\n  const drilldownGroupsByPrimaryComponentId = Object.create(null);\n  const renderedDrilldownGroupIds = new Set();\n\n  for (const group of authoredDisplayPlan.groups) {\n    if (group.behavior === \"drilldownView\") {\n      drilldownGroupsByPrimaryComponentId[group.primaryComponentId] = group;\n    }\n  }\n\n  for (const component of authoredDisplayPlan.components) {\n    const drilldownGroup = drilldownGroupsByPrimaryComponentId[component.id];\n\n    if (drilldownGroup) {\n      if (!renderedDrilldownGroupIds.has(drilldownGroup.groupId)) {\n        rootBlocks.push(\n          _buildDrilldownGroupBlock(drilldownGroup, componentsById)\n        );\n        renderedDrilldownGroupIds.add(drilldownGroup.groupId);\n      }\n      continue;\n    }\n\n    if (groupedComponentIds.has(component.id)) {\n      continue;\n    }\n\n    rootBlocks.push(_buildStandaloneRootBlock(component));\n  }\n}\n\n// Add the single allowed defaultView group as a canvas block.\nfunction _appendDefaultViewCanvas(\n  rootBlocks,\n  authoredDisplayPlan,\n  componentsById\n) {\n  const group = authoredDisplayPlan.groups.find(\n    (item) => item.behavior === \"defaultView\"\n  );\n\n  if (!group) {\n    return;\n  }\n\n  rootBlocks.push({\n    display_type: \"canvas\",\n    canvas_content: {\n      contextMarker: \"canvas\",\n      canvasHeaderText: group.groupTitle,\n      artifacts: group.componentIds.map((componentId) =>\n        _clone(componentsById[componentId].data)\n      )\n    }\n  });\n}\n\nfunction _moveActionBlocksToEnd(rootBlocks) {\n  const nonActionBlocks = [];\n  const actionBlocks = [];\n\n  for (const block of rootBlocks) {\n    if (block.display_type === \"action\") {\n      actionBlocks.push(block);\n    } else {\n      nonActionBlocks.push(block);\n    }\n  }\n\n  return nonActionBlocks.concat(actionBlocks);\n}\n\nfunction assembleAuthoredDisplayPlan(authoredDisplayPlan) {\n  const { componentsById } = _buildIndexes(authoredDisplayPlan);\n  const { groupedComponentIds } = _validateGroups(\n    authoredDisplayPlan,\n    componentsById\n  );\n\n  const root = {\n    agent: authoredDisplayPlan.meta.agentName,\n    agent_response: []\n  };\n\n  const rootBlocks = [];\n\n  _appendRootBlocksInAuthorOrder(\n    rootBlocks,\n    authoredDisplayPlan,\n    groupedComponentIds,\n    componentsById\n  );\n  _appendDefaultViewCanvas(rootBlocks, authoredDisplayPlan, componentsById);\n\n  const orderedRootBlocks = _moveActionBlocksToEnd(rootBlocks);\n\n  orderedRootBlocks.forEach((block, index) => {\n    block.display_sequence = index + 1;\n  });\n\n  root.agent_response = orderedRootBlocks;\n  return root;\n}\n\ntry {\n  const raw = $context.$nodes.MODIFYDATA.$output.result;\n\n  const authoredDisplayPlan =\n    typeof raw === \"string\"\n      ? JSON.parse(raw)\n      : Array.isArray(raw)\n        ? raw[0]\n        : raw?.result && Array.isArray(raw.result.components)\n          ? raw.result\n          : raw;\n\n  return assembleAuthoredDisplayPlan(authoredDisplayPlan);\n} catch (error) {\n  if (error && error.errorType === \"DISPLAY_PLAN_RULE_ERROR\") {\n    throwFormatterError(\n      \"INVALID_REQUEST\",\n      error.message || \"Invalid display plan supplied to assembler.\",\n      error.details\n    );\n  }\n\n  if (error && error.errorType) {\n    throw error;\n  }\n\n  throwFormatterError(\n    \"PROCESSING_ERROR\",\n    \"Failed while assembling the authored display plan.\",\n    {\n      message: error && error.message ? error.message : String(error)\n    }\n  );\n}"
          },
