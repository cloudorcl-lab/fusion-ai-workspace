{
  "workflowId": "100002355227042",
  "workflowCode": "ORA_RMC_DATA_GENERATION_ASSISTANT",
  "name": "RMC Data Generation Assistant",
  "description": "Coordinates staged security data generation tasks based on the requested run mode and executes only the relevant data production steps.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
