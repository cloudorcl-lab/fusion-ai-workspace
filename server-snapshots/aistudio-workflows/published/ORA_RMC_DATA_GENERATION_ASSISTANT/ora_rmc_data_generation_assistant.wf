      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "CALL_CREATE_CLOBS_WORKFLOW"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "name": "Parse Run Mode",
            "returnType": "object",
            "sourceCode": "var runMode = ($context.$app && $context.$app.$OraAppContext) ? $context.$app.$OraAppContext : 'ALL';\nrunMode = String(runMode).toUpperCase().trim();\nvar validModes = ['ALL', 'STAGE1', 'STAGE2', 'INTRAROLE', 'USER_ACCESS', 'ADVISOR', 'BUSINESS_PROCESS', 'TRANSACTION'];\nvar isValid = false;\nfor (var i = 0; i < validModes.length; i++) { if (validModes[i] === runMode) { isValid = true; break; } }\nif (!isValid) { runMode = 'ALL'; }\nvar stage1 = ['ORA_RMC_INTRAROLE_VIOLATIONS_GENERATOR', 'ORA_RMC_USER_ACCESS_VIOLATIONS_GENERATOR', 'ORA_RMC_ROLE_RECOMMENDATIONS_GENERATOR'];\nvar stage2 = ['ORA_RMC_BUSINESS_PROCESS_COMPLIANCE_GENERATOR', 'ORA_RMC_TRANSACTION_VIOLATIONS_GENERATOR'];\nvar workflows = [];\nif (runMode === 'ALL') { workflows = stage1.concat(stage2); }\nelse if (runMode === 'STAGE1') { workflows = stage1; }\nelse if (runMode === 'STAGE2') { workflows = stage2; }\nelse { var map = { INTRAROLE: stage1[0], USER_ACCESS: stage1[1], ADVISOR: stage1[2], BUSINESS_PROCESS: stage2[0], TRANSACTION: stage2[1] }; if (map[runMode]) workflows.push(map[runMode]); }\nvar result = { runMode: runMode, workflowsToRun: workflows, count: workflows.length, timestamp: new Date().toISOString() };\nreturn result;"
          },
          "outcomes": {
            "success": "SWITCH_RUN_MODE"
          },
          "code": "PARSE_RUN_MODE",
          "id": "PARSE_RUN_MODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Switch Run Mode"
          },
          "outcomes": {
            "ALL": "CALL_INTRAROLE_ALL",
            "STAGE1": "CALL_INTRAROLE_S1",
            "STAGE2": "CALL_BP_S2",
            "INTRAROLE": "CALL_INTRAROLE_ONLY",
            "USER_ACCESS": "CALL_USER_ACCESS_ONLY",
            "ADVISOR": "CALL_ADVISOR_ONLY",
            "BUSINESS_PROCESS": "CALL_BP_ONLY",
            "TRANSACTION": "CALL_TRANS_ONLY"
          },
          "code": "SWITCH_RUN_MODE",
          "convergenceTargetId": "DISPLAY_RESULT",
          "id": "SWITCH_RUN_MODE",
          "inputs": [
            {
              "id": "SWITCH_RUN_MODE_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$nodes.PARSE_RUN_MODE.$output.result.runMode}}"
            }
          ],
          "type": "SWITCH"
        },
