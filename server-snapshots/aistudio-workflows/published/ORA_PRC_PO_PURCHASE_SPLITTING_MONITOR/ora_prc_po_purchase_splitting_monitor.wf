        {
          "metadata": {
            "name": "Create ReqBU Requester Supplier Requests Data Structure",
            "returnType": "object",
            "sourceCode": "let response;\nif ($context.$triggers.REST.$input.OraMessageHint === \"Count\") {\n  response = $context.$nodes.GET_SPLIT_PURCHASE_RISK_INITIAL_DATA_LAST_30_DAYS.$output;\n} else if ($context.$triggers.REST.$input.OraMessageHint === \"InitDisplay\") {\n  response = $context.$nodes.GET_SPLIT_PURCHASE_RISK_DRILLDOWN_DATA_LAST_30_DAYS.$output;\n} else {\n  return {};\n}\n\nlet suppliersWithOnlyOneTransactionWithRequester = {};\n/**\nconst buckets = response.aggregations?.by_requester?.buckets || [];\nbuckets.forEach(requesterBucket => {\n  const requesterId = requesterBucket.key;\n  const suppliers = requesterBucket.by_supplier?.buckets || [];\n  const singleCountSuppliers = suppliers.filter( supplier => supplier.doc_count === 1).map(supplier => supplier.key);\n  if (singleCountSuppliers.length > 0) {\n    suppliersWithOnlyOneTransactionWithRequester[requesterId] = singleCountSuppliers;\n  }\n});\n*/\n\nlet requestsByReqBuRequesterSupplier = {};\nfor (const hit of response.hits.hits) {\n  const hitData = hit[ \"_source\"];\n\n  const reqBUId = hitData.header?.requisitioningBUId;\n  const requesterId = hitData.requesterId;\n  const supplierId = hitData.supplier?.supplierId;\n\n  const itemDescription = hitData.itemDescription?.US;\n  const reqNumber = hitData.header?.requisitionNumber;\n  const reqLineNumber = hitData.lineNumber;\n  const reqLineId = hitData.requisitionLineId;\n  const requisitionHeaderId = hitData.requisitionHeaderId;\n  const functionalCurrency = hitData.header?.functionalCurrencyCode;\n  const currencyCode = hitData.currencyCode;\n  const quantity = hitData.quantity;\n  const currencyUnitPrice = hitData.currencyUnitPrice;\n  const currencyAmount = hitData.currencyAmount;\n  const buyerName = hitData.buyer?.name;\n  const buyerEmail = hitData.buyerEmail?.buyerEmailAddress?.buyerEmailAddr;\n  const reqsInPoolFlag = hitData.reqsInPoolFlag;\n  const requesterName = hitData.requester?.name;\n  const reqBUName = hitData.header?.requisitioningBU?.name?.US;\n  const supplierName = hitData.supplier?.supplierName?.name?.US;\n\n  const lastUpdateDateInISOFormat = hitData.LastUpdateDate;\n  let lastUpdateDate;\n  if (lastUpdateDateInISOFormat) {\n    lastUpdateDate = lastUpdateDateInISOFormat.split(\"T\")[0];\n  } \n\n  const creationDateInISOFormat = hitData.creationDate;\n  let creationDate;\n  if (creationDateInISOFormat) {\n    creationDate = creationDateInISOFormat.split(\"T\")[0];\n  } \n\n  let amountInFunctionalCurrency = 0;\n  if (currencyAmount) {\n    amountInFunctionalCurrency = currencyAmount;\n  } else if (quantity && currencyUnitPrice) {\n    amountInFunctionalCurrency = quantity * currencyUnitPrice;\n  }\n  \n  if (reqBUId && requesterId && supplierId && itemDescription) {\n    if (!!suppliersWithOnlyOneTransactionWithRequester[requesterId] && Array.isArray(suppliersWithOnlyOneTransactionWithRequester[requesterId]) && suppliersWithOnlyOneTransactionWithRequester[requesterId].includes(supplierId)) {\n      continue;\n    }\n\n    if (!requestsByReqBuRequesterSupplier[reqBUId]) {\n      requestsByReqBuRequesterSupplier[reqBUId] = {};\n    }\n    if (!requestsByReqBuRequesterSupplier[reqBUId][requesterId]) {\n      requestsByReqBuRequesterSupplier[reqBUId][requesterId] = {};\n    }\n    if (!requestsByReqBuRequesterSupplier[reqBUId][requesterId][supplierId]) {\n      requestsByReqBuRequesterSupplier[reqBUId][requesterId][supplierId] = [];\n    }\n\n    if (!requestsByReqBuRequesterSupplier[reqBUId][requesterId][supplierId].includes(itemDescription)) {\n      requestsByReqBuRequesterSupplier[reqBUId][requesterId][supplierId].push({ itemDescription: itemDescription, reqNumber: reqNumber, reqLineNumber: reqLineNumber, reqLineId: reqLineId, requisitionHeaderId: requisitionHeaderId, functionalCurrency: functionalCurrency, amountInFunctionalCurrency: amountInFunctionalCurrency, currencyCode: currencyCode, quantity: quantity, currencyUnitPrice: currencyUnitPrice, currencyAmount: currencyAmount, lastUpdateDate: lastUpdateDate, creationDate: creationDate, buyerName: buyerName, buyerEmail: buyerEmail, reqsInPoolFlag: reqsInPoolFlag, requesterName: requesterName, reqBUName: reqBUName, supplierName: supplierName });\n    }\n  }\n}\n\nreturn requestsByReqBuRequesterSupplier;"
          },
          "outcomes": {
            "success": "1778869916867"
