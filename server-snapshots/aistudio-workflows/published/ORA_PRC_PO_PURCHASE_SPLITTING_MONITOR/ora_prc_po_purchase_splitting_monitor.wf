          "type": "SWITCH"
        },
        {
          "metadata": {
            "name": "Construct Base Widget Data Structure",
            "returnType": "object",
            "sourceCode": "const splitPurchaseData = $context.$nodes.EXCLUDE_SPLIT_PURCHASE_GROUPS_LESS_THAN_5000USD.$output.result;\n\nconst totalSplitPurchases = splitPurchaseData.totalSplitPurchases;\n\nconst ret = {\n  severity: \"High\",\n  description: \"Possible purchase splitting\",\n  total: totalSplitPurchases,\n  riskCode: \"splitPurchases\",\n  payload: {\n    riskType: \"splitPurchases\",\n    prcBUId: $context.$variables.prcBUId\n  }\n};\n\nreturn ret;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "CONSTRUCT_BASE_WIDGET_DATA_STRUCTURE",
          "id": "1776919858531",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Identify 5 Most Recently Updated Item Buckets",
            "returnType": "object",
            "sourceCode": "const splitPurchases = $context.$nodes.EXCLUDE_SPLIT_PURCHASE_GROUPS_LESS_THAN_5000USD.$output.result.requests;\n\nconst bucketLatestDate = new Map();\n\n// Step 1: Traverse and compute latest date per bucket\nfor (const buId in splitPurchases) {\n  for (const requesterId in splitPurchases[buId]) {\n    for (const supplierId in splitPurchases[buId][requesterId]) {\n      const buckets = splitPurchases[buId][requesterId][supplierId];\n\n      for (const bucketName in buckets) {\n        const requests = buckets[bucketName];\n\n        for (const req of requests) {\n          const date = new Date(req.lastUpdateDate);\n\n          if (\n            !bucketLatestDate.has(bucketName) ||\n            date > bucketLatestDate.get(bucketName)\n          ) {\n            bucketLatestDate.set(bucketName, date);\n          }\n        }\n      }\n    }\n  }\n}\n\n// Step 2: Get top 5 bucket names\nconst topBuckets = [...bucketLatestDate.entries()]\n  .sort((a, b) => b[1] - a[1]) // descending\n  .slice(0, 5)\n  .map(([name]) => name);\n\nconst topBucketSet = new Set(topBuckets);\n\n// Step 3: Rebuild filtered structure\nlet ret = {};\n\nfor (const buId in splitPurchases) {\n  for (const requesterId in splitPurchases[buId]) {\n    for (const supplierId in splitPurchases[buId][requesterId]) {\n      const buckets = splitPurchases[buId][requesterId][supplierId];\n\n      for (const bucketName in buckets) {\n        if (!topBucketSet.has(bucketName)) continue;\n\n        // Initialize nested structure safely\n        ret[buId] ??= {};\n        ret[buId][requesterId] ??= {};\n        ret[buId][requesterId][supplierId] ??= {};\n\n        ret[buId][requesterId][supplierId][bucketName] = buckets[bucketName];\n      }\n    }\n  }\n}\n\nreturn ret;"
          },
          "outcomes": {
            "success": "1778275209309"
          },
          "code": "IDENTIFY_5_MOST_RECENTLY_UPDATED_ITEM_BUCKETS",
          "id": "1777049795985",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get User Session Preferences",
            "toolCode": "ORA_USER_SESSION_TOOL"
          },
          "outcomes": {
            "success": "1778275209310"
          },
          "code": "GET_USER_SESSION_PREFERENCES",
          "id": "1778275209309",
          "inputs": [],
          "type": "TOOL"
        },
        {
          "metadata": {
            "name": "Construct Drilldown Widget Data Structure",
            "returnType": "object",
            "sourceCode": "const splitPurchases = $context.$nodes.IDENTIFY_5_MOST_RECENTLY_UPDATED_ITEM_BUCKETS.$output.result;\n\nlet dataForDrillDownWidget = {};\nlet tableIndex = 1;\nlet reqLinesForReturnMassAction = [];\nlet requisitionLineDisplayForReturnMassAction = [];\n\nfunction isEmpty(value) {\n  return value == null || String(value).trim() === \"\";\n}\n\nfunction toFiniteNumber(value) {\n  if (value == null || value === \"\") return null;\n  const n = typeof value === \"number\" ? value : Number(value);\n  return Number.isFinite(n) ? n : null;\n}\n\nfunction sanitizeSeparator(value, fallback) {\n  if (typeof value !== \"string\") return fallback;\n  const text = value.trim();\n  return text !== \"\" ? text : fallback;\n}\n\nfunction sanitizeDatePattern(value) {\n  if (typeof value !== \"string\") return \"M/d/yyyy\";\n  const text = value.trim();\n  return text !== \"\" ? text : \"M/d/yyyy\";\n}\n\nfunction pad2(value) {\n  return String(value).padStart(2, \"0\");\n}\n\nfunction formatDate(value, datePattern) {\n  if (isEmpty(value)) return \"-\";\n\n  const dateText = String(value).split(\"T\")[0];\n  const match = dateText.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);\n  if (!match) return dateText;\n\n  const year = match[1];\n  const month = Number(match[2]);\n  const day = Number(match[3]);\n  const tokens = {\n    yyyy: year,\n    YYYY: year,\n    yy: year.slice(-2),\n    YY: year.slice(-2),\n    MM: pad2(month),\n    M: String(month),\n    dd: pad2(day),\n    d: String(day)\n  };\n\n  return datePattern.replace(/yyyy|YYYY|yy|YY|MM|M|dd|d/g, (token) => tokens[token]);\n}\n\nfunction formatNumber(value, decimalSeparator, groupingSeparator, decimals) {\n  const n = toFiniteNumber(value);\n  if (n == null) return null;\n\n  const fixed = n.toFixed(decimals);\n  const negative = fixed.startsWith(\"-\");\n  const unsigned = negative ? fixed.slice(1) : fixed;\n  const parts = unsigned.split(\".\");\n  const integerPart = parts[0];\n  const fractionalPart = parts[1] ?? \"\";\n  const groupedInteger = integerPart.replace(/\\B(?=(\\d{3})+(?!\\d))/g, groupingSeparator);\n  const withDecimals = decimals > 0\n    ? groupedInteger + decimalSeparator + fractionalPart\n    : groupedInteger;\n\n  return negative ? \"-\" + withDecimals : withDecimals;\n}\n\nfunction normalizeCurrencyCode(value) {\n  return String(value || \"\").trim().toUpperCase();\n}\n\nfunction toPrecision(value) {\n  const n = toFiniteNumber(value);\n  if (n == null || n < 0) return null;\n  return Math.trunc(n);\n}\n\nfunction buildCurrencyPrecisionMap(items) {\n  const map = {};\n  for (const item of Array.isArray(items) ? items : []) {\n    const currencyCode = normalizeCurrencyCode(item.CurrencyCode ?? item.currencyCode ?? item.Currency ?? item.currency);\n    const precision = toPrecision(item.Precision ?? item.precision ?? item.CurrencyPrecision ?? item.currencyPrecision);\n    if (currencyCode && precision != null) map[currencyCode] = precision;\n  }\n  return map;\n}\n\nfunction getCurrencyPrecision(currencyCode, currencyPrecisionMap, fallback) {\n  const precision = currencyPrecisionMap[normalizeCurrencyCode(currencyCode)];\n  return precision != null ? precision : fallback;\n}\n\nfunction formatAmountDisplay(amount, currencyCode, decimalSeparator, groupingSeparator, currencyPrecisionMap, fallbackPrecision) {\n  const currency = normalizeCurrencyCode(currencyCode);\n  const precision = getCurrencyPrecision(currency, currencyPrecisionMap, fallbackPrecision);\n  const amountText = formatNumber(amount, decimalSeparator, groupingSeparator, precision);\n  if (amountText == null) return \"-\";\n  return currency ? amountText + \" \" + currency : amountText;\n}\n\n\nfunction buildDisplay(reqNumber, reqLineNumber) {\n  return String(reqNumber) + \"-\" + String(reqLineNumber);\n}\n\nfunction buildReqLinePayload(request) {\n  return {\n    requisitionHeaderId: request.requisitionHeaderId,\n    requisitionLineId: request.reqLineId,\n    display: buildDisplay(request.reqNumber, request.reqLineNumber),\n    requesterName: request.requesterName,\n    requisitioningBU: request.reqBUName\n  };\n}\n\nfunction hasRequiredReturnIds(reqLine) {\n  return reqLine.requisitionHeaderId != null && String(reqLine.requisitionHeaderId).trim() !== \"\" && reqLine.requisitionLineId != null && String(reqLine.requisitionLineId).trim() !== \"\";\n}\n\nconst prefs = $context.$nodes.GET_USER_SESSION_PREFERENCES?.$output?.items?.[0];\nconst datePattern = sanitizeDatePattern(prefs?.DateFormat);\nconst decimalSeparator = sanitizeSeparator(prefs?.DecimalSeparator, \".\");\nconst groupingSeparator = sanitizeSeparator(prefs?.GroupingSeparator, \",\");\nconst currencyPrecisionMap = buildCurrencyPrecisionMap($context.$nodes.GET_CURRENCIES?.$output?.items);\nconst defaultCurrencyPrecision = 2;\n\nfunction getHeaderAndRequests(bucketRequests) {\n  const firstRequest = bucketRequests[0] || {};\n\n  let totalAmount = 0;\n  for (const request of bucketRequests) {\n    if (request.reqsInPoolFlag === \"Y\") {\n      const reqLine = buildReqLinePayload(request);\n      if (hasRequiredReturnIds(reqLine)) {\n        reqLinesForReturnMassAction.push(reqLine);\n      }\n      requisitionLineDisplayForReturnMassAction.push(reqLine.display);\n    }\n    totalAmount += request.amountInFunctionalCurrency || 0;\n  }\n\n  const functionalCurrency = firstRequest.functionalCurrency;\n  const header = {\n    requesterName: firstRequest.requesterName,\n    reqBUName: firstRequest.reqBUName,\n    supplierName: firstRequest.supplierName,\n    functionalCurrency: functionalCurrency,\n    totalAmount: totalAmount,\n    totalAmountDisplay: formatAmountDisplay(totalAmount, functionalCurrency, decimalSeparator, groupingSeparator, currencyPrecisionMap, defaultCurrencyPrecision)\n  };\n\n  const requests = bucketRequests.map((req) => ({\n    reqNumber: req.reqNumber,\n    reqLineNumber: req.reqLineNumber,\n    reqLineId: req.reqLineId,\n    requisitionHeaderId: req.requisitionHeaderId,\n    display: buildDisplay(req.reqNumber, req.reqLineNumber),\n    requesterName: req.requesterName,\n    reqBUName: req.reqBUName,\n    description: req.itemDescription,\n    amount: req.amountInFunctionalCurrency,\n    amountDisplay: formatAmountDisplay(req.amountInFunctionalCurrency, functionalCurrency, decimalSeparator, groupingSeparator, currencyPrecisionMap, defaultCurrencyPrecision),\n    creationDate: req.creationDate,\n    creationDateDisplay: formatDate(req.creationDate, datePattern),\n    buyerName: req.buyerName,\n    buyerEmail: req.buyerEmail,\n    reqsInPoolFlag: req.reqsInPoolFlag\n  }));\n\n  return { header, requests };\n}\n\nfunction buildReturnPayload() {\n  return {\n    dataForDrillDownWidget: dataForDrillDownWidget,\n    reqLinesForReturnMassActionJson: JSON.stringify(reqLinesForReturnMassAction),\n    requisitionLineDisplayForReturnMassAction: requisitionLineDisplayForReturnMassAction.join(\", \")\n  };\n}\n\nfor (const [reqBUId, requesterIds] of Object.entries(splitPurchases)) {\n  for (const [requesterId, supplierIds] of Object.entries(requesterIds)) {\n    for (const [supplierId, itemBuckets] of Object.entries(supplierIds)) {\n      for (const [bucketName, bucketRequests] of Object.entries(itemBuckets)) {\n        const { header, requests } = getHeaderAndRequests(bucketRequests);\n\n        dataForDrillDownWidget[\"table\" + tableIndex] = {\n          header: header,\n          requests: requests\n        };\n\n        tableIndex += 1;\n        if (tableIndex > 5) {\n          return buildReturnPayload();\n        }\n      }\n    }\n  }\n}\n\nreturn buildReturnPayload();"
          },
          "outcomes": {
            "success": "1778275209308"
          },
          "code": "CONSTRUCT_DRILLDOWN_WIDGET_DATA_STRUCTURE",
          "id": "1776919889629",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_MULTIRECORD"
              ],
              "enableActions": true
            }
          },
          "metadata": {
            "name": "Render Split Purchase Drilldown Widget"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "RENDER_SPLIT_PURCHASE_DRILLDOWN_WIDGET",
          "id": "1778275209308",
          "inputs": [
            {
              "id": "1778275209308_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": ""
            },
            {
              "id": "1778275209308_prompt",
              "name": "prompt",
              "type": "string",
              "value": "### Overview\nRender the provided split purchase drilldown data as up to 5 multiRecordWidgets. Each table in dataForDrillDownWidget maps to one widget: table1, table2, and so on.\n\nUse the data exactly as provided here:\n{{$context.$nodes.CONSTRUCT_DRILLDOWN_WIDGET_DATA_STRUCTURE.$output.result}}\n\n### Column Mapping\nUse a multiRecordWidget with columns in this exact order:\n1. Requisition - Line -> requests.reqNumber - requests.reqLineNumber\n2. Description -> requests.description\n3. Amount -> requests.amountDisplay. Use amountDisplay exactly as provided.\n4. Creation Date -> requests.creationDateDisplay\n\n### Row Actions\nFor each row, add a row action only when requests.reqsInPoolFlag = \"Y\":\n- If requests.reqsInPoolFlag = \"Y\": text = \"Return\", command = ora.Invoke(\"returnToRequester\", { \"actionName\": \"returnToRequester\", \"requesterName\": header.requesterName, \"requisitionLineDisplay\": requests.display, \"reqLines\": [{ \"requisitionHeaderId\": requests.requisitionHeaderId, \"requisitionLineId\": requests.reqLineId, \"display\": requests.display, \"requesterName\": requests.requesterName, \"requisitioningBU\": requests.reqBUName }] })\n- For any other requests.reqsInPoolFlag value, including \"P\", omit the row action.\n\n### Widget Title\nFor each widget, use this exact title pattern:\n\"<header.requesterName> created multiple requisitions with <header.supplierName> in <header.reqBUName> totaling <header.totalAmountDisplay> over the past 30 days.\"\n\n### Widget Description\nFor each widget, evaluate only that widget's own requests rows.\n- If at least one row has requests.reqsInPoolFlag = \"P\", set the widget description to exactly: \"Requisition lines on a purchase order can���t be returned to requester\"\n- Otherwise, leave the widget description empty.\n\n### Optional Mass Return Insight\nIf reqLinesForReturnMassActionJson is not an empty array, include exactly one oraInsight after the widgets with:\n- title: \"Return Unprocessed Lines to Requester\"\n- shortDescription: \"Return all unprocessed requisition lines shown to their requesters.\"\n- actionText: \"Return Unprocessed Lines to Requester\"\n- followUpCommand: ora.Invoke(\"returnToRequesterMassAction\", { \"actionName\": \"returnToRequesterMassAction\", \"requisitionLineDisplay\": \"<requisitionLineDisplayForReturnMassAction>\", \"reqLines\": <reqLinesForReturnMassActionJson> })\nReplace <requisitionLineDisplayForReturnMassAction> and <reqLinesForReturnMassActionJson> with the exact values from the provided data. <reqLinesForReturnMassActionJson> must remain a JSON array, not a quoted string.\n\n### Output Format\nOutput only oraInfoDisplay blocks and the optional oraInsight. Do not output markdown fences or extra prose. Preserve the table order table1 through table5 when present. Values are preformatted; do not reformat numbers or dates."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_PRC_PURCHASING_CURRENCIESLISTOFVALUESFORPURCHASING",
            "description": "Retrieves currency codes and precision values used to format monetary amounts.",
            "functionName": "GetCurrencies",
            "processJson": true,
            "name": "Get Currencies"
          },
          "outcomes": {
            "success": "1776919889629"
          },
          "code": "GET_CURRENCIES",
          "id": "1778275209310",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"totalResults\": {\n      \"type\": \"integer\"\n    },\n    \"count\": {\n      \"type\": \"integer\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"integer\"\n    },\n    \"offset\": {\n      \"type\": \"integer\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"rel\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"self\",\n              \"lov\",\n              \"parent\",\n              \"canonical\",\n              \"child\",\n              \"enclosure\",\n              \"action\",\n              \"custom\"\n            ]\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"collection\",\n              \"item\",\n              \"describe\",\n              \"other\"\n            ]\n          }\n        },\n        \"additionalProperties\": false\n      }\n    },\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"@context\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"key\": {\n                \"type\": \"string\"\n              },\n              \"headers\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"ETag\": {\n                    \"type\": \"string\"\n                  }\n                },\n                \"additionalProperties\": false\n              },\n              \"links\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"href\": {\n                      \"type\": \"string\"\n                    },\n                    \"rel\": {\n                      \"type\": \"string\",\n                      \"enum\": [\n                        \"self\",\n                        \"lov\",\n                        \"parent\",\n                        \"canonical\",\n                        \"child\",\n                        \"enclosure\",\n                        \"action\",\n                        \"custom\"\n                      ]\n                    },\n                    \"name\": {\n                      \"type\": \"string\"\n                    },\n                    \"kind\": {\n                      \"type\": \"string\",\n                      \"enum\": [\n                        \"collection\",\n                        \"item\",\n                        \"describe\",\n                        \"other\"\n                      ]\n                    }\n                  },\n                  \"additionalProperties\": false\n                }\n              }\n            },\n            \"additionalProperties\": false\n          },\n          \"ActiveDate\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"CurrencyFormat\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"CurrencyFormatWithSymbol\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"CurrencyFormatWithCode\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"CurrencyCode\": {\n            \"type\": \"string\"\n          },\n          \"Name\": {\n            \"type\": \"string\"\n          },\n          \"Description\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"EnabledFlag\": {\n            \"type\": \"string\"\n          },\n          \"StartDateActive\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\",\n                \"format\": \"date\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"EndDateActive\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\",\n                \"format\": \"date\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"IssuingTerritoryCode\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"Symbol\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"Precision\": {\n            \"anyOf\": [\n              {\n                \"type\": \"integer\",\n                \"format\": \"int32\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"ExtendedPrecision\": {\n            \"anyOf\": [\n              {\n                \"type\": \"integer\",\n                \"format\": \"int32\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"CurrencyFlag\": {\n            \"type\": \"string\"\n          }\n        },\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ]\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Identify Unique Currencies",
            "returnType": "array",
            "sourceCode": "const requestsByTuple = $context.$nodes.CREATE_REQBU_REQUESTER_SUPPLIER_REQUESTS_DATA_STRUCTURE.$output.result;\n\nlet uniqueCurrencies = [];\nfor (const [reqBUId, requesterIds] of Object.entries(requestsByTuple)) {\n  for (const [requesterId, supplierIds] of Object.entries(requesterIds)) {\n    for (const [supplierId, requests] of Object.entries(supplierIds)) {\n      for (const request of requests) {\n        const functionalCurrency = request.functionalCurrency;\n        if (functionalCurrency !== \"USD\" && !uniqueCurrencies.includes(functionalCurrency)) {\n          uniqueCurrencies.push(functionalCurrency);\n        }\n      }\n    }\n  }\n}\n\nreturn uniqueCurrencies;"
          },
          "outcomes": {
            "success": "1778878801599"
          },
          "code": "IDENTIFY_UNIQUE_CURRENCIES",
          "id": "1778869916867",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get Currency Conversions"
          },
          "outcomes": {
            "success": "1778879497427"
          },
          "code": "GET_CURRENCY_CONVERSIONS",
          "id": "1778872473772",
          "inputs": [
            {
              "id": "1778872473772_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": ""
            },
            {
              "id": "1778872473772_prompt",
              "name": "prompt",
              "type": "string",
              "value": "### Instructions\nGive me the currency conversion rates for these currencies to US Dollar to the best of your knowledge: {{$context.$nodes.IDENTIFY_UNIQUE_CURRENCIES.$output.result}} \n\n### Output Schema\nReturn only valid JSON in the following format. No markdown. No code fences. No explanation.\nIf no currencies are given, simply return {}.\n\nFor input: [\"CUR1\", \"CUR2\"]\nOutput:\n{\n  \"CUR1\": 1.57,\n  \"CUR2\": 4.59\n}"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "If currency conversion is necessary"
          },
          "outcomes": {
            "false": "1776878978594",
            "true": "1778872473772"
          },
          "code": "IF_CURRENCY_CONVERSION_IS_NECESSARY",
          "convergenceTargetId": "1778880792050",
          "id": "1778878801599",
          "inputs": [
            {
              "id": "1778878801599_condition",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.IDENTIFY_UNIQUE_CURRENCIES.$output.result.length > 0}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Normalize Amounts to USD",
            "returnType": "object",
            "sourceCode": "let requestsByTuple = $context.$nodes.CREATE_REQBU_REQUESTER_SUPPLIER_REQUESTS_DATA_STRUCTURE.$output.result;\nconst currConversionRates = $context.$nodes.GET_CURRENCY_CONVERSIONS.$output;\n\nfor (const [reqBUId, requesterIds] of Object.entries(requestsByTuple)) {\n  for (const [requesterId, supplierIds] of Object.entries(requesterIds)) {\n    for (const [supplierId, requests] of Object.entries(supplierIds)) {\n      for (const request of requests) {\n        const functionalCurrency = request.functionalCurrency;\n        if (functionalCurrency !== \"USD\") {\n          const currencyConversion = currConversionRates[functionalCurrency];\n          if (currencyConversion) {\n            request.amountInUSD = request.amountInFunctionalCurrency * currencyConversion;\n          }\n        }\n      }\n    }\n  }\n}\n\nreturn requestsByTuple;"
          },
          "outcomes": {
            "success": "1778880731179"
          },
          "code": "NORMALIZE_AMOUNTS_TO_USD",
          "id": "1778879497427",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Set Item Buckets To Empty Obj"
          },
          "outcomes": {
            "success": "1776901282407"
          },
          "code": "SET_ITEM_BUCKETS_TO_EMPTY_OBJ",
          "id": "1778880662733",
          "inputs": [
            {
              "id": "1778880662733_itemBuckets",
              "name": "itemBuckets",
              "value": "{}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Set Requester Requests - With Currency Conversion"
          },
          "outcomes": {
            "success": "1778880792050"
          },
          "code": "SET_REQUESTER_REQUESTS_WITH_CURRENCY_CONVERSION",
          "id": "1778880731179",
          "inputs": [
            {
              "id": "1778880731179_requesterRequestsByReqBuBySupplier",
              "name": "requesterRequestsByReqBuBySupplier",
              "value": "{{$context.$nodes.NORMALIZE_AMOUNTS_TO_USD.$output.result}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Exclude ReqBU/Requester/Supplier Groupings Less Than 5k USD",
            "returnType": "object",
            "sourceCode": "const requestsByTupleWithUSDAmounts = $context.$variables.requesterRequestsByReqBuBySupplier;\n\nlet requestsByTupleWithAmountAbove5000 = {};\n\nfor (const [reqBUId, requesterIds] of Object.entries(requestsByTupleWithUSDAmounts)) {\n  for (const [requesterId, supplierIds] of Object.entries(requesterIds)) {\n    for (const [supplierId, requests] of Object.entries(supplierIds)) {\n      let totalAmountInTupleUSD = 0;\n      for (const request of requests) {\n        // Note: amountInUSD will be populated if currency conversion was done. Else amountInFunctionalCurrency will be populated.\n        const amountInUSD = request.amountInUSD ? request.amountInUSD : request.amountInFunctionalCurrency;\n        if (amountInUSD) {\n          totalAmountInTupleUSD += amountInUSD;\n        }\n      }\n      if (totalAmountInTupleUSD >= 5000) {\n        requestsByTupleWithAmountAbove5000[reqBUId] ??= {};\n        requestsByTupleWithAmountAbove5000[reqBUId][requesterId] ??= {};       \n        requestsByTupleWithAmountAbove5000[reqBUId][requesterId][supplierId] = requests;\n      }\n    }\n  }\n}\n\nreturn requestsByTupleWithAmountAbove5000;"
          },
          "outcomes": {
            "success": "1778880662733"
          },
          "code": "EXCLUDE_REQBU_REQUESTER_SUPPLIER_GROUPINGS_LESS_THAN_5K_USD",
          "id": "1778880792050",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Exclude Split Purchase Groups Less Than 5000USD",
            "returnType": "object",
            "sourceCode": "const splitPurchases = $context.$nodes.IDENTIFY_PURCHASE_SPLITTING_BEHAVIOR.$output.result;\nlet splitPurchasesMoreThan5000USD = {};\nlet totalSplitPurchases = 0;\n\nfor (const [reqBUId, requesterIds] of Object.entries(splitPurchases)) {\n  for (const [requesterId, supplierIds] of Object.entries(requesterIds)) {\n    for (const [supplierId, itemBuckets] of Object.entries(supplierIds)) {\n      for (const [bucketName, bucketRequests] of Object.entries(itemBuckets)) {\n        let totalAmountInItemBucketUSD = 0;\n        for (const request of bucketRequests) {\n          const amountInUSD = request.amountInUSD ? request.amountInUSD : request.amountInFunctionalCurrency;\n          if (amountInUSD) {\n            totalAmountInItemBucketUSD += amountInUSD;\n          }\n        }\n        if (totalAmountInItemBucketUSD >= 5000) {\n          totalSplitPurchases += bucketRequests.length;\n\n          splitPurchasesMoreThan5000USD[reqBUId] ??= {};\n          splitPurchasesMoreThan5000USD[reqBUId][requesterId] ??= {};\n          splitPurchasesMoreThan5000USD[reqBUId][requesterId][supplierId] ??= {};\n          splitPurchasesMoreThan5000USD[reqBUId][requesterId][supplierId][bucketName] = bucketRequests;\n        }\n      }\n    }\n  }\n}\n\nconst ret = {\n  totalSplitPurchases: totalSplitPurchases,\n  requests: splitPurchasesMoreThan5000USD\n};\n\nreturn ret;"
          },
          "outcomes": {
            "success": "1778891880737"
          },
          "code": "EXCLUDE_SPLIT_PURCHASE_GROUPS_LESS_THAN_5000USD",
          "id": "1778891880733",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
