                                    "sourceCode": "const currentReqBUId = $context.$nodes.ITERATE_OVER_REQUISITION_BUS.$currentItem;\nconst currentRequesterId = $context.$nodes.ITERATE_OVER_REQUISITION_BUS.ITERATE_OVER_REQUESTERS.$currentItem;\nconst currentSupplierId = $context.$nodes.ITERATE_OVER_REQUISITION_BUS.ITERATE_OVER_REQUESTERS.ITERATE_OVER_SUPPLIERS.$currentItem;\n\nlet currentItemBuckets = $context.$variables.itemBuckets;\n\ncurrentItemBuckets[currentReqBUId] ??= {};\ncurrentItemBuckets[currentReqBUId][currentRequesterId] ??= {};\n\ncurrentItemBuckets[currentReqBUId][currentRequesterId][currentSupplierId] = $context.$variables.generatedItemBuckets;\n\nreturn currentItemBuckets;"
