        {
          "metadata": {
            "name": "Sort Requester Requests By Supplier Item Bucket",
            "returnType": "object",
            "sourceCode": "const itemBuckets = $context.$variables.itemBuckets;\n\nlet requestsByItemBucket = {};\n\nfor (const [reqBUId, requesterIds] of Object.entries(itemBuckets)) {\n  for (const [requesterId, supplierIds] of Object.entries(requesterIds)) {\n    for (const [supplierId, itemBucketData] of Object.entries(supplierIds)) {\n      const { buckets, items } = itemBucketData;\n      const requests = $context.$variables.requesterRequestsByReqBuBySupplier[reqBUId][requesterId][supplierId];\n      if (buckets && items) {\n        for (const request of requests) {\n          const itemDescription = request.itemDescription;\n          const bucketName = buckets[items[itemDescription]];\n          \n          requestsByItemBucket[reqBUId] ??= {};\n          requestsByItemBucket[reqBUId][requesterId] ??= {};\n          requestsByItemBucket[reqBUId][requesterId][supplierId] ??= {};\n          requestsByItemBucket[reqBUId][requesterId][supplierId][bucketName] ??= [];\n          requestsByItemBucket[reqBUId][requesterId][supplierId][bucketName].push(request);\n        }\n      }\n    }\n  }\n}\n\nreturn requestsByItemBucket;"
          },
          "outcomes": {
            "success": "1776878978596"
          },
          "code": "SORT_REQUESTER_REQUESTS_BY_SUPPLIER_ITEM_BUCKET",
          "id": "1776878978597",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Identify Purchase Splitting Behavior",
            "returnType": "object",
            "sourceCode": "const requestsByItemBucket = $context.$nodes.SORT_REQUESTER_REQUESTS_BY_SUPPLIER_ITEM_BUCKET.$output.result;\n\nlet splitPurchaseRequests = {};\n\nfor (const [reqBUId, requesterIds] of Object.entries(requestsByItemBucket)) {\n  for (const [requesterId, supplierIds] of Object.entries(requesterIds)) {\n    for (const [supplierId, itemBuckets] of Object.entries(supplierIds)) {\n      for (const [bucketName, bucketRequests] of Object.entries(itemBuckets)) {\n        if (Array.isArray(bucketRequests) && bucketRequests.length > 1) {\n          splitPurchaseRequests[reqBUId] ??= {};\n          splitPurchaseRequests[reqBUId][requesterId] ??= {};\n          splitPurchaseRequests[reqBUId][requesterId][supplierId] ??= {};\n          splitPurchaseRequests[reqBUId][requesterId][supplierId][bucketName] = bucketRequests;\n        }\n      }\n    }\n  }\n}\n\n\n\nreturn splitPurchaseRequests;"
          },
          "outcomes": {
            "success": "1778891880733"
          },
          "code": "IDENTIFY_PURCHASE_SPLITTING_BEHAVIOR",
          "id": "1776878978596",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
