                    "name": "ProcessOutput",
                    "returnType": "array",
                    "sourceCode": "let responseArr = $context.$nodes.PROCESSRECORDS.READFROMDB.$output;\n\nconst outputArray= responseArr.map(item => ({\n  id: $context.$nodes.PROCESSRECORDS.$currentItem.id,\n  vectorSearchScore: item.vectorSearchScore,\n textSearchScore:  item.textSearchScore,\n  docIdentifier: item.documentIdentifier\n}));\n\nreturn outputArray;"
