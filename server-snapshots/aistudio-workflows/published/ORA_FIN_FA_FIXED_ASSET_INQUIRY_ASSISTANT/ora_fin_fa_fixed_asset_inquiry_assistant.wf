        {
          "metadata": {
            "name": "prepareTransactionList",
            "returnType": "object",
            "sourceCode": "const bookNameVar = $context.$variables.bookTypeCode;\n\nconst payload = {\n  viewQueries: {\n    financialTransaction: {\n      module: \"oraErpCoreFixedAssets\",\n      businessObject: \"AssetTransaction\",\n      view: \"financialTransactionDetail\",\n      fieldAliases: {\n        transactionHeaderId: \"transactionHeaderId\",\n        transactionTypeCode: \"transactionTypeCode\",\n        bookName: \"bookName\",\n        effectiveDate: \"effectiveDate\",\n        comments: \"comments\",\n        \"asset.assetNumber\": \"assetNumber\",\n        \"asset.assetId\": \"assetId\"\n      }\n    },\n    bookPeriod: {\n      module: \"oraErpCoreFixedAssetsSetup\",\n      businessObject: \"AssetBookPeriod\",\n      view: \"bookPeriodDetail\",\n      fieldAliases: {\n        bookName: \"periodBookName\",\n        periodOpenDate: \"periodOpenDate\",\n        periodCloseDate: \"periodCloseDate\"\n      }\n    }\n  },\n\n  select: `\n    SELECT\n      transactionHeaderId,\n      transactionTypeCode,\n      assetNumber,\n      assetId,\n      effectiveDate,\n      comments\n    FROM financialTransaction, bookPeriod\n    WHERE bookName = periodBookName\n      AND bookName = '${bookNameVar}'\n      AND periodCloseDate IS NULL\n      AND (\n        transactionTypeCode IN ('ADDITION', 'TRANSFER', 'ADJUSTMENT')\n        OR transactionTypeCode LIKE '%RETIRE%'\n      )\n      AND transactionTypeCode NOT IN ('TRANSFER IN', 'TRANSFER OUT')\n      AND effectiveDate >= periodOpenDate\n    ORDER BY effectiveDate DESC\n    FETCH FIRST 10 ROWS ONLY\n  `\n};\n\nreturn JSON.stringify(payload);"
          },
