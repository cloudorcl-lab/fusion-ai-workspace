          "metadata": {
            "name": "prepareDistDetails",
            "returnType": "object",
            "sourceCode": "const bookNameVar = $context.$variables.bookTypeCode;\nconst assetNumberVar = $context.$variables.searchIdentifier;\n\nconst payload = {\n  viewQueries: {\n    assetCurrDist: {\n      module: \"oraErpCoreFixedAssets\",\n      businessObject: \"AssetDistribution\",\n      view: \"assignmentDetail\",\n      fieldAliases: {\n        distributionId: \"distributionId\",\n        bookName: \"bookName\",\n        unitsAssigned: \"unitsAssigned\",\n        effectiveDate: \"effectiveDate\",\n        ineffectiveDate: \"ineffectiveDate\",\n        \"asset.assetId\": \"assetId\",\n        \"asset.assetNumber\": \"assetNumber\",\n        \"location.locationId\": \"locationId\",\n        \"location.locationConcatenatedSegment\": \"locationConcatenatedSegment\",\n        \"depreciationExpenseAccount.codeCombinationId\": \"codeCombinationId\",\n        \"depreciationExpenseAccount.concatenatedSegments\": \"concatenatedSegments\"\n      }\n    }\n  },\n  select: `\n    SELECT\n      a.distributionId,\n      a.bookName,\n      a.unitsAssigned,\n      a.effectiveDate,\n      a.ineffectiveDate,\n      a.assetId,\n      a.locationId,\n      a.locationConcatenatedSegment,\n      a.codeCombinationId,\n      a.concatenatedSegments\n    FROM assetCurrDist a\n    WHERE a.bookName = '${bookNameVar}'\n      AND a.assetNumber = '${assetNumberVar}'\n      AND a.ineffectiveDate IS NULL\n  `\n};\n\nreturn JSON.stringify(payload);"
          },
          "outcomes": {
            "success": "1779691853738"
          },
          "code": "PREPAREDISTDETAILS",
          "id": "1779691615813",
          "inputs": [],
