        {
          "metadata": {
            "name": "extractTransTypeCode",
            "returnType": "object",
            "sourceCode": "const rawRequestedTransactionNumber =\n  $context.$nodes.FETCHTRANSACTIONNUMFROMUSERINPUT.$output.transactionNumber;\n\nconst requestedTransactionNumber = String(rawRequestedTransactionNumber || \"\")\n  .match(/\\d+/)?.[0];\n\nconst searchOutput = $context.$nodes.GETLISTOFALLTRANS.$output;\n\nconst transactions = Array.isArray(searchOutput)\n  ? searchOutput\n  : searchOutput?.output?.response || searchOutput?.response || [];\n\nconst matchedTransaction = transactions.find(row =>\n  String(row.TRANSACTIONHEADERID).trim() === requestedTransactionNumber\n);\n\nconst transactionTypeCode = matchedTransaction?.TRANSACTIONTYPECODE || null;\n\nconst mappedTransactionTypeCode =\n  transactionTypeCode === \"ADDITION\" || transactionTypeCode === \"ADJUSTMENT\"\n    ? \"ADD_ADJ\"\n    : transactionTypeCode === \"TRANSFER\"\n      ? \"TRANSFER\"\n      : String(transactionTypeCode || \"\").toUpperCase().includes(\"RETIRE\")\n        ? \"RETIREMENT\"\n        : null;\n\nreturn {\n  transactionFound: !!matchedTransaction,\n  transactionNumber: matchedTransaction?.TRANSACTIONHEADERID || null,\n  transactionTypeCode,\n  mappedTransactionTypeCode,\n  assetNumber: matchedTransaction?.ASSETNUMBER || null,\n  assetId: matchedTransaction?.ASSETID || null,\n  debug: {\n    rawRequestedTransactionNumber,\n    requestedTransactionNumber,\n    transactionIdsSeen: transactions.map(row => row.TRANSACTIONHEADERID)\n  }\n};"
          },
          "outcomes": {
            "success": "1783341727797"
          },
