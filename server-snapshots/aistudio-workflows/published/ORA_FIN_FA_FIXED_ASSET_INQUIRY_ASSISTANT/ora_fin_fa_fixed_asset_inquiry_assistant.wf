          "metadata": {
            "name": "prepForBookDetails",
            "returnType": "object",
            "sourceCode": "const bookNameVar = $context.$variables.bookTypeCode;\nconst params = JSON.parse( $context.$nodes.GETBOOKDETAILS.$output.ParameterList);\n\nreturn {\n  output: {\n    response: [\n      {\n        BOOKNAME: bookNameVar || \"\",\n        PERIODID: Number(params.X_PERIOD_COUNTER),\n        PERIODNAME: params.X_PERIOD_NAME || \"\",\n        PERIODOPENDATE: params.X_CAL_PERIOD_OPEN_DATE,\n        PERIODCLOSEDATE: params.X_CAL_PERIOD_CLOSE_DATE || null,\n        CURRENCYCODE: params.X_CURRENCY_CODE || \"\",\n        LEDGERNAME: params.X_LEDGER_NAME || \"\"\n      }\n    ]\n  }\n};"
          },
          "outcomes": {
            "success": "1777361319915"
          },
