        {
          "metadata": {
            "name": "prepareDeprnDetailsPayload",
            "returnType": "object",
            "sourceCode": "const bookNameVar = $context.$variables.bookTypeCode;\nconst assetNumberVar = $context.$variables.searchIdentifier;\nconst currOpenPeriodVar = $context.$variables.bookDetails.output.response[0].PERIODID;\n\nconst payload = {\n  viewQueries: {\n    assetDepreciation: {\n      module: \"oraErpCoreFixedAssetDepreciation\",\n      businessObject: \"AssetPeriodicDepreciationDetail\",\n      view: \"depreciationDetail\",\n      fieldAliases: {\n        \"asset.assetNumber\": \"assetNumber\",\n        distributionId: \"distributionId\",\n        bookName: \"bookName\",\n        periodId: \"periodId\",\n        depreciationSourceCode: \"depreciationSourceCode\",\n        depreciationRunDate: \"depreciationRunDate\",\n        depreciationAmount: \"depreciationAmount\",\n        ytdDepreciation: \"ytdDepreciation\",\n        depreciationReserve: \"depreciationReserve\",\n        additionCostToClear: \"additionCostToClear\",\n        cost: \"cost\",\n        depreciationAdjustmentAmount: \"depreciationAdjustmentAmount\",\n        revaluationAmortization: \"revaluationAmortization\",\n        revaluationDepreciationExpense: \"revaluationDepreciationExpense\",\n        revaluationReserve: \"revaluationReserve\",\n        ytdRevaluationDepreciationExpense: \"ytdRevaluationDepreciationExpense\",\n        bonusDepreciationAmount: \"bonusDepreciationAmount\",\n        bonusYtdDepreciation: \"bonusYtdDepreciation\",\n        bonusDepreciationReserve: \"bonusDepreciationReserve\",\n        bonusDepreciationAdjustmentAmount: \"bonusDepreciationAdjustmentAmount\",\n        capitalAdjustment: \"capitalAdjustment\",\n        generalFund: \"generalFund\",\n        impairmentAmount: \"impairmentAmount\",\n        impairmentReserve: \"impairmentReserve\",\n        ytdImpairment: \"ytdImpairment\",\n        revaluationAmortizationBalance: \"revaluationAmortizationBalance\",\n        ytdRevaluationReserveAmortization: \"ytdRevaluationReserveAmortization\",\n        revaluationReserveAmortizationAdjustmentAmount: \"revaluationReserveAmortizationAdjustmentAmount\",\n        backlogDepreciationReserve: \"backlogDepreciationReserve\",\n        ytdBacklogDepreciation: \"ytdBacklogDepreciation\",\n        \"depreciationPeriod.periodName\": \"periodName\"\n      }\n    }\n  },\n\n  select: `\n    SELECT\n      assetNumber,\n      periodName,\n      distributionId,\n      bookName,\n      periodId,\n      depreciationSourceCode,\n      depreciationRunDate,\n      depreciationAmount,\n      ytdDepreciation,\n      depreciationReserve,\n      additionCostToClear,\n      cost,\n      depreciationAdjustmentAmount,\n      revaluationAmortization,\n      revaluationDepreciationExpense,\n      revaluationReserve,\n      ytdRevaluationDepreciationExpense,\n      bonusDepreciationAmount,\n      bonusYtdDepreciation,\n      bonusDepreciationReserve,\n      bonusDepreciationAdjustmentAmount,\n      capitalAdjustment,\n      generalFund,\n      impairmentAmount,\n      impairmentReserve,\n      ytdImpairment,\n      revaluationAmortizationBalance,\n      ytdRevaluationReserveAmortization,\n      revaluationReserveAmortizationAdjustmentAmount,\n      backlogDepreciationReserve,\n      ytdBacklogDepreciation\n    FROM assetDepreciation\n    WHERE bookName = '${bookNameVar}'\n      AND assetNumber = '${assetNumberVar}'\n      AND periodId >= ${currOpenPeriodVar} - 3\n  `\n};\n\nreturn JSON.stringify(payload);"
          },
          "outcomes": {
            "success": "1778127014106"
          },
