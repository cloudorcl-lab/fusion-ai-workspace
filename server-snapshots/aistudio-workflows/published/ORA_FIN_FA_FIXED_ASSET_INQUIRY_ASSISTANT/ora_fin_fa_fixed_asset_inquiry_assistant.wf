        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_FIXEDASSET_GETBOOKPERIODSUMMARY",
            "functionName": "getBookPeriodSummary",
            "name": "Transaction Detail Service"
          },
          "outcomes": {
            "success": "1776948676636"
          },
          "code": "TRANSACTION_DETAILS_SERVICE",
          "id": "1773253966663",
          "inputs": [
            {
              "id": "1774371489873_1",
              "name": "bookTypeCode",
              "type": "string",
              "value": "{{$context.$variables.bookTypeCode}}"
            },
            {
              "id": "1774371489875_2",
              "name": "periodCounter",
              "type": "string",
              "value": "{{$context.$variables.bookDetails.output.response[0].PERIODID}}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"ParameterList\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "curr_period_activity_for_book_htlm",
            "returnType": "string",
            "sourceCode": "let parameterList = $context.$nodes.TRANSACTION_DETAILS_SERVICE.$output.ParameterList;\nconst bookTypeCode = $context.$variables.bookTypeCode; \nconst chatCounter = $context.$variables.FaInqChatCounter;\nconst periodName = normalize($context.$variables.bookDetails.output.response?.[0]?.PERIODNAME);\nconst prefs = $context.$variables.currencyFormatDetails || {};\n\nlet assetHtml = \"\";\n\ntry {\n  parameterList = typeof parameterList === \"string\" ? JSON.parse(parameterList) : parameterList;\n} catch (e) {\n  parameterList = null;\n}\n\nfunction normalize(val) {\n  return val === undefined || val === null ? \"\" : String(val).trim();\n}\n\nfunction formatAmount(amount, groupingSeparator, decimalSeparator, precision) {\n  if (amount == null || normalize(amount) === \"\" || normalize(amount).toUpperCase() === \"NA\") {\n    return \"-\";\n  }\n\n  const num = Number(String(amount).replace(/,/g, \"\"));\n  if (isNaN(num)) return \"-\";\n\n  const isNegative = num < 0;\n  const fixed = Math.abs(num).toFixed(precision);\n  let [integerPart, decimalPart] = fixed.split(\".\");\n\n  integerPart = integerPart.replace(/\\B(?=(\\d{3})+(?!\\d))/g, groupingSeparator);\n\n  const formatted = decimalPart\n    ? integerPart + decimalSeparator + decimalPart\n    : integerPart;\n\n  return (isNegative ? \"-\" : \"\") + (prefs.symbol || \"\") + formatted;\n}\n\nconst status = normalize(parameterList?.X_RETURN_STATUS).toUpperCase();\nconst msgCount = normalize(parameterList?.X_MSG_COUNT);\n\nconst isApiIssue =\n  !parameterList ||\n  (parameterList.X_RETURN_STATUS === \"E\" &&\n    (parameterList.X_MSG_COUNT === \"0\" || parameterList.X_MSG_COUNT === \"1\"));\n\nif (isApiIssue) {\n  assetHtml = `<div style=\"font-family:'Oracle Sans'; margin-bottom:10px; background:#f9fafb; padding:12px 16px;\">\n  <br>\n  <div style=\"font-size:14px; font-weight:400;\">\n   The requested fixed asset information is currently unavailable to me and may be added in a future release.\n  </div>\n<br>\n<div style=\"font-family:'Oracle Sans'; font-size:12px; margin:7px 0;\">\n  Type 'HELP' to know about my capabilities.\n</div>\n</div>`;\n} else {\n  const data = Array.isArray(parameterList) ? parameterList[0] : parameterList;\n\n  const values = {\n    totalCost: formatAmount(data?.X_TOTAL_COST, prefs.groupingSeparator, prefs.decimalSeparator, prefs.precision),\n    reserve: formatAmount(data?.X_TOTAL_RESERVE, prefs.groupingSeparator, prefs.decimalSeparator, prefs.precision),\n    nbv: formatAmount(data?.X_NET_BOOK_VALUE, prefs.groupingSeparator, prefs.decimalSeparator, prefs.precision),\n    ledger: normalize(data?.X_LEDGER_NAME) || \"-\",\n    currency: normalize(data?.X_CURRENCY) || \"-\",\n    additions: normalize(data?.X_ADDITION_CNT) || \"-\",\n    adjustments: normalize(data?.X_ADJUSTMENT_CNT) || \"-\",\n    transfers: normalize(data?.X_TRANSFER_CNT) || \"-\",\n    addPending: normalize(data?.X_PENDING_ADDITION_CNT) || \"-\",\n    adjPending: normalize(data?.X_PENDING_ADJUSTMENT_CNT) || \"-\",\n    retPending: normalize(data?.X_PENDING_RETIREMENT_CNT) || \"-\",\n    transPending: normalize(data?.X_PENDING_TRANSFER_CNT) || \"-\",\n    lastRun: normalize(data?.X_LAST_DEPRN_RUN_DATE) || \"-\"\n  };\n\n  assetHtml = `<div style=\"background:#f9fafb; padding:12px 16px;\">\n<div style=\"width:100%; max-width:100%; overflow:hidden;\">\n  <div style=\"font-size: 18px; font-weight: 500; line-height: 1.15;\">\n<br>\n    <strong>Current Period Activity</strong><br>\n  </div>\n  <br>\n  <div style=\"display:flex; justify-content:space-between; font-size:14px; margin:0 0 4px 0; width:550px;\">\n    <div><strong>Book</strong> ${bookTypeCode || \"-\"}</div>\n    <div><strong>Period</strong> ${periodName || \"-\"}</div>\n  </div>\n  <div style=\"display:flex; justify-content:space-between; font-size:14px; margin:0 0 4px 0; width:550px;\">\n    <div><strong>Ledger Name</strong> ${values.ledger}</div>\n    <div><strong>Currency</strong> ${values.currency}</div>\n  </div>\n  <div style=\"display:flex; font-size:14px; margin:0; width:550px;\">\n    <div><strong>Last Depreciation Run</strong> ${values.lastRun}</div>\n  </div>\n\n  <br>\n\n  <b>Transactions Summary</b>\n  <br><br>\n  <div style=\"width:100vw; box-sizing:border-box; overflow-x:auto;\">\n    <table style=\"\n      width:89%;\n      border-collapse:collapse;\n      border:1px solid #d9d9d9;\n      table-layout:fixed;\n      font-size:14px;\n      box-sizing:border-box;\n    \">\n      <colgroup>\n        <col style=\"width:20%;\">\n        <col style=\"width:20%;\">\n        <col style=\"width:20%;\">\n        <col style=\"width:20%;\">\n        <col style=\"width:20%;\">\n      </colgroup>\n\n      <thead style=\"background-color:#f3f4f6;\">\n        <tr>\n          <th style=\"text-align:left; border:1px solid #d9d9d9; padding:12px 14px;\">Status</th>\n          <th style=\"text-align:left; border:1px solid #d9d9d9; padding:12px 14px;\">Addition</th>\n          <th style=\"text-align:left; border:1px solid #d9d9d9; padding:12px 14px;\">Adjustment</th>\n          <th style=\"text-align:left; border:1px solid #d9d9d9; padding:12px 14px;\">Retirement</th>\n          <th style=\"text-align:left; border:1px solid #d9d9d9; padding:12px 14px;\">Transfer</th>\n        </tr>\n      </thead>\n\n      <tbody>\n        <tr style=\"background-color:#ffffff;\">\n          <td style=\"text-align:left; border:1px solid #d9d9d9; padding:12px 14px;\">Posted</td>\n          <td style=\"text-align:left; border:1px solid #d9d9d9; padding:12px 14px;\">${values.additions}</td>\n          <td style=\"text-align:left; border:1px solid #d9d9d9; padding:12px 14px;\">${values.adjustments}</td>\n          <td style=\"text-align:left; border:1px solid #d9d9d9; padding:12px 14px;\">2</td>\n          <td style=\"text-align:left; border:1px solid #d9d9d9; padding:12px 14px;\">${values.transfers}</td>\n        </tr>\n        <tr style=\"background-color:#ffffff;\">\n          <td style=\"text-align:left; border:1px solid #d9d9d9; padding:12px 14px;\">In progress</td>\n          <td style=\"text-align:left; border:1px solid #d9d9d9; padding:12px 14px;\">${values.addPending}</td>\n          <td style=\"text-align:left; border:1px solid #d9d9d9; padding:12px 14px;\">${values.adjPending}</td>\n          <td style=\"text-align:left; border:1px solid #d9d9d9; padding:12px 14px;\">${values.retPending}</td>\n          <td style=\"text-align:left; border:1px solid #d9d9d9; padding:12px 14px;\">${values.transPending}</td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n\n  <br>\n\n  <div style=\"margin-bottom:10px;\">\n    If you would like to see the transaction details for this book, type:\n  </div>\n\n  <div>\n    <div style=\"font-weight:500; font-size:12px; padding:4px 6px; border-radius:3px; border:1px solid #d1d5db; background-color:#f9fafb; display:inline-block;\">\n      \"show me recent transaction details in [book name] book\"\n    </div>\n  </div>\n</div>\n</div>`;\n\n  if (chatCounter <= 2) {\n    assetHtml += `<div style=\"background:#f9fafb; padding:12px 16px;\">\n      <div style=\"font-family:'Oracle Sans'; font-size:12px; margin:5px 0;\">\n        Type 'HELP' to know about my capabilities.\n      </div>\n    </div>`;\n  }\n}\n\nreturn assetHtml;"
          },
          "outcomes": {
            "success": "1776948729153"
          },
          "code": "CURRPERIODACTIVITYFORBOOKHTLM",
          "id": "1776948676636",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "return node for curr period activity"
          },
          "outcomes": {},
          "code": "RETURN_NODE_FOR_CURR_PERIOD_ACTIVITY",
          "convergenceTargetId": "end",
          "id": "1776948729153",
          "inputs": [
            {
              "id": "1776948729154_1",
              "name": "returnValue",
              "type": "string",
              "value": "{{$context.$nodes.CURRPERIODACTIVITYFORBOOKHTLM.$output.result}}"
            }
