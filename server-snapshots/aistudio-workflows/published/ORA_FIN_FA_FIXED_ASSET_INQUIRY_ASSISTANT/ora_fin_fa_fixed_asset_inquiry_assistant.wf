        {
          "metadata": {
            "name": "Extracting List Of Assets",
            "returnType": "string",
            "sourceCode": "function normalize(value) {\n  if (value === undefined || value === null) return \"-\";\n  const str = String(value).trim();\n  return str === \"\" ? \"-\" : str;\n}\n\nfunction getRecords(source) {\n  if (source === undefined || source === null) return [];\n\n  if (Array.isArray(source)) return source;\n  if (Array.isArray(source?.output?.response)) return source.output.response;\n  if (Array.isArray(source?.response)) return source.response;\n\n  return [];\n}\n\nfunction getValue(row, upperKey, lowerKey = \"\") {\n  return row?.[upperKey] ?? (lowerKey ? row?.[lowerKey] : undefined) ?? \"-\";\n}\n\nfunction resolveAssetNumber(value) {\n  const normalized = normalize(value);\n  return normalized === \"-\" ? searchIdentifier : normalized;\n}\n\nconst bookDetails = getRecords($context.$variables.bookDetails?.output?.response);\nconst bookRecord = bookDetails[0] || {};\nconst chatCounter = Number($context.$variables.FaInqChatCounter ?? 0);\n\nconst assetListDetails = getRecords($context.$variables.assetListDetails);\nconst prefs = $context.$variables.currencyFormatDetails || {};\nconst searchIdentifier = normalize($context.$variables.searchIdentifier);\nconst bookTypeCode = $context.$variables.bookTypeCode;\nconst inputMessage = String($context.$system.$inputMessage || \"\");\n\nlet assetHtml = \"\";\n\nfunction makeCamelCasing(str) {\n  if (str === null || str === \"CIP\") return str;\n  if (!str || String(str).trim() === \"\") return \"-\";\n  const s = String(str);\n  return s[0].toUpperCase() + s.slice(1).toLowerCase();\n}\n\nfunction formatAmount(amount, groupingSeparator, decimalSeparator, precision) {\n  if (amount === undefined || amount === null || amount === \"\") return \"-\";\n\n  const numericAmount = Number(String(amount).replace(/,/g, \"\"));\n  if (isNaN(numericAmount)) return String(amount);\n\n  const isNegative = numericAmount < 0;\n  const fixed = Math.abs(numericAmount).toFixed(precision);\n  let [integerPart, decimalPart] = fixed.split(\".\");\n\n  integerPart = integerPart.replace(/\\B(?=(\\d{3})+(?!\\d))/g, groupingSeparator);\n\n  const formatted = decimalPart ? integerPart + decimalSeparator + decimalPart : integerPart;\n  return (isNegative ? \"-\" : \"\") + formatted;\n}\n\nfunction formatCurrencyAmount(amount) {\n  return formatAmount(\n    amount,\n    prefs.groupingSeparator || \",\",\n    prefs.decimalSeparator || \".\",\n    prefs.precision ?? 2\n  );\n}\n\nfunction pluralize(word, count) {\n  return count === 1 ? word : `${word}s`;\n}\n\nfunction cleanCriteriaText(message) {\n  let text = String(message || \"\").trim();\n\n  text = text.replace(/^(show|get|give|display|list|find|fetch)\\s+(me\\s+)?/i, \"\");\n  text = text.replace(/^(the\\s+)?list\\s+of\\s+/i, \"\");\n  text = text.replace(/^(the\\s+)?assets?\\s*/i, \"assets \");\n  text = text.replace(/[?.!,;:]+$/g, \"\");\n  text = text.trim();\n\n  return text || \"assets matching the requested criteria\";\n}\n\nfunction normalizeConditionText(text) {\n  return String(text || \"\")\n    .replace(/\\s+/g, \" \")\n    .replace(/\\bwhere\\b/i, \"where\")\n    .replace(/\\band\\b/gi, \"and\")\n    .replace(/\\bis greater than or equal to\\b/gi, \"is greater than or equal to\")\n    .replace(/\\bis greater than\\b/gi, \"is greater than\")\n    .replace(/\\bis less than or equal to\\b/gi, \"is less than or equal to\")\n    .replace(/\\bis less than\\b/gi, \"is less than\")\n    .replace(/\\bcontains\\b/gi, \"contains\")\n    .replace(/\\bstarts with\\b/gi, \"starts with\")\n    .replace(/\\bends with\\b/gi, \"ends with\")\n    .trim();\n}\n\nfunction buildDynamicSummary(totalCount) {\n  const count = totalCount || 0;\n  const assetWord = pluralize(\"asset\", count);\n  const bookText = normalize(bookTypeCode || bookRecord.BOOKNAME);\n\n  const criteriaText = normalizeConditionText(cleanCriteriaText(inputMessage));\n  const hasBookInQuestion = /\\bbook\\b|\\bbook name\\b|\\bbook type\\b|\\bbooktype\\b/i.test(criteriaText);\n  const bookSuffix = !hasBookInQuestion && bookText !== \"-\" ? ` in ${bookText}` : \"\";\n\n  if (count === 1) {\n    return `I found 1 asset${bookSuffix} matching: ${criteriaText}.`;\n  }\n\n  return `Here is the list of the ${count} most recently created ${assetWord}${bookSuffix} matching: ${criteriaText}.`;\n}\n\nfunction leftSummaryBlock() {\n  return `\n    <div style=\"display:flex; flex-direction:column; gap:6px; min-width:220px;\">\n      <div style=\"display:flex; gap:6px; white-space:nowrap; align-items:baseline;\">\n        <strong>Book</strong><span>${normalize(bookRecord.BOOKNAME || bookTypeCode)}</span>\n      </div>\n      <div style=\"display:flex; gap:6px; white-space:nowrap; align-items:baseline;\">\n        <strong>Period</strong><span>${normalize(bookRecord.PERIODNAME)}</span>\n      </div>\n    </div>`;\n}\n\nfunction rightSummaryBlockGeneral() {\n  return `\n    <div style=\"display:flex; flex-direction:column; gap:6px; min-width:260px; align-items:flex-start;\">\n      <div style=\"display:flex; gap:6px; white-space:nowrap; align-items:baseline;\">\n        <strong>Ledger Name</strong><span>${normalize(bookRecord.LEDGERNAME)}</span>\n      </div>\n      <div style=\"display:flex; gap:6px; white-space:nowrap; align-items:baseline;\">\n        <strong>Currency</strong><span>${normalize(bookRecord.CURRENCYCODE)}</span>\n      </div>\n    </div>`;\n}\n\nfunction generalHeaderHtml() {\n  return `\n    <div style=\"display:flex; justify-content:flex-start; align-items:flex-start; gap:72px; flex-wrap:wrap; max-width:760px; width:100%;\">\n      ${leftSummaryBlock()}\n      ${rightSummaryBlockGeneral()}\n    </div>`;\n}\n\nconst helpHtml =\n  chatCounter <= 2\n    ? `<div style=\"font-family:'Oracle Sans'; font-size:12px; margin-top:6px;\">Type 'HELP' to know about my capabilities.</div>`\n    : \"\";\n\nconst isApiIssue = assetListDetails.length === 0;\n\nif (isApiIssue) {\n  assetHtml = `<div style=\"font-family:'Oracle Sans'; margin-bottom:10px; background:#f9fafb; padding:12px 16px;\">\n    <br>\n    <div style=\"font-size:14px; font-weight:400;\">\n      The requested fixed asset information is currently unavailable to me. Kindly change your search criteria.\n    </div>\n    <br>\n    <div style=\"font-family:'Oracle Sans'; font-size:12px; margin:7px 0;\">\n      Type 'HELP' to know about my capabilities.\n    </div>\n  </div>`;\n} else {\n  const rowCount = Math.min(assetListDetails.length, 10);\n  const summaryText = buildDynamicSummary(rowCount);\n\n  let rowsHtml = \"\";\n\n  for (let i = 0; i < rowCount; i++) {\n    const row = assetListDetails[i] || {};\n\n    const assetNumber = resolveAssetNumber(getValue(row, \"ASSETNUMBER\", \"assetNumber\"));\n    const description = normalize(getValue(row, \"DESCRIPTION\", \"description\"));\n    const serialNumber = normalize(getValue(row, \"SERIALNUMBER\", \"serialNumber\"));\n    const tagNumber = normalize(getValue(row, \"TAGNUMBER\", \"tagNumber\"));\n    const assetType = makeCamelCasing(getValue(row, \"ASSETTYPE\", \"assetType\"));\n    const category = normalize(getValue(row, \"CATEGORYCONCATENATEDSEGMENT\", \"categoryConcatenatedSegment\"));\n    const cost = formatCurrencyAmount(getValue(row, \"COST\", \"cost\"));\n\n    const rowNumber = i + 1;\n    const isOdd = rowNumber % 2 !== 0;\n\n    rowsHtml += `<tr style=\"background-color: ${isOdd ? \"#ffffff\" : \"transparent\"};\">\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left; vertical-align:middle; white-space:normal;\">${rowNumber}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left; vertical-align:middle; white-space:normal;\">${assetNumber}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left; vertical-align:middle; white-space:normal;\">${description}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left; vertical-align:middle; white-space:normal;\">${serialNumber}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left; vertical-align:middle; white-space:normal;\">${tagNumber}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left; vertical-align:middle; white-space:normal;\">${assetType}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left; vertical-align:middle; white-space:normal;\">${category}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:right; vertical-align:middle; white-space:normal;\">${cost}</td>\n    </tr>`;\n  }\n\n  assetHtml = `<div style=\"background:#f9fafb; padding:12px 16px;\">\n    <div style=\"font-family:'Oracle Sans'; margin-bottom:10px;\">\n      <div style=\"font-size:16px;font-weight:500; margin-bottom:4px;\">\n  <b>${summaryText}</b>\n</div>\n<br>\n\n      <div style=\"font-size:14px; font-weight:400;\">\n        ${generalHeaderHtml()}\n      </div>\n    </div>\n\n    <div style=\"width:100%; max-width:100%; border:1px solid #d6d9dc; overflow:hidden;\">\n      <table style=\"width:100%; border-collapse:collapse; table-layout:fixed; font-size:14px;\">\n        <colgroup>\n          <col style=\"width:3%;\">\n          <col style=\"width:13%;\">\n          <col style=\"width:20%;\">\n          <col style=\"width:12%;\">\n          <col style=\"width:12%;\">\n          <col style=\"width:9%;\">\n          <col style=\"width:18%;\">\n          <col style=\"width:13%;\">\n        </colgroup>\n        <thead style=\"background-color:#f3f4f6;\">\n          <tr>\n            <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Row</th>\n            <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Asset Number</th>\n            <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Description</th>\n            <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Serial Number</th>\n            <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Tag Number</th>\n            <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Asset Type</th>\n            <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Category</th>\n            <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:right;\">Cost</th>\n          </tr>\n        </thead>\n        <tbody>\n          ${rowsHtml}\n        </tbody>\n      </table>\n    </div>\n\n${rowCount === 10\n      ? `<div style=\"font-size:12px; color:#6b7280; margin-bottom:10px;\">\n  Note: This table displays the most recently created matching assets available in this view. Additional matching assets may also exist.\n</div>`\n      : \"\"}\n\n    <div style=\"font-family:'Oracle Sans'; font-size:14px; margin:12px 0;\">\n      If you want to inquire about any other asset, kindly enter the asset number. For example:\n      <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n        \"show me the details for the asset [asset number]\"\n      </div>\n    </div>\n\n    <div style=\"font-family:'Oracle Sans'; font-size:14px; margin:12px 0;\">\n      For more details about an asset ask for\n      <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\"> \n        \"show me the financial details for the asset [asset number]\"\n      </div>\n    </div>\n\n    ${helpHtml}\n  </div>`;\n}\n\nreturn assetHtml;"
          },
          "outcomes": {
            "success": "1782371888736"
          },
          "code": "EXTRACTING_LIST_OF_ASSETS",
          "id": "1782371840605",
