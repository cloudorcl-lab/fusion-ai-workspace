              "id": "1771235414430_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an intelligent agent. Your task is to assign the book type code and parameter list \n\nStep 1: Populate below fields:\nbookTypeCode: {{$context.$variables.bookTypeCode}} \nParameterList: {{$context.$nodes.CHECKBOOKSECURITY.$output.ParameterList}} \n\nStep 2: Extract X_ACCESS_FLAG from ParameterList and assign to accessFlag.\n\n#Output:\nReturn only this JSON:\n\n{\n  \"bookTypeCode\": <value>\n  \"parameterList\": <value>\n  \"accessFlag\": <'Y'||'NB'||'NF'||'NDS'||'N'>\n}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"accessFlag\": {\n            \"type\": \"string\"\n        },\n        \"parameterList\": {\n            \"type\": \"string\"\n        },\n        \"bookTypeCode\": {\n            \"type\": \"string\"\n        }\n    }\n}",
