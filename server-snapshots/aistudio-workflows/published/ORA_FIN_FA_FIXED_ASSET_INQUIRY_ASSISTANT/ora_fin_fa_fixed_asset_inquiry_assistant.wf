          "code": "FETCHTRANSACTIONNUMFROMUSERINPUT",
          "id": "1781710537875",
          "inputs": [
            {
              "id": "1781710537876_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an agent which helps user drilldown to the Transaction Inquiry.\n\nA. You need to extract Transaction Number first. \nPoint 1. to extract Transaction Number (aka transactionNumber) from the User Input: {{$context.$system.$inputMessage}} \n\nB. You need to get Book:\nPoint 1. first try get Book : {{$context.$variables.bookTypeCode}}\n\nAction: \n1. Once you get the Transaction Number (transactionNumber) and Book (bookTypeCode) pass these as an output. \n\nOutput:\n{\n \"bookTypeCode\": <value>,\n \"transactionNumber\": <value>\n}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"transactionNumber\": {\n            \"type\": \"string\"\n        },\n        \"bookTypeCode\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Displaying Entities",
            "returnType": "string",
            "sourceCode": "function escapeHtml(value) {\n  if (value === null || value === undefined) return \"\";\n  return String(value)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n}\n\nfunction toArray(value) {\n  if (!value) return [];\n  return Array.isArray(value) ? value : [value];\n}\n\nfunction normalizeValue(v) {\n  if (v === null || v === undefined) return \"\";\n  if (typeof v === \"object\") return JSON.stringify(v);\n  return String(v);\n}\n\nconst data = typeof input === \"string\" ? JSON.parse($context.$nodes.EXTRACTING_WHERE_CLAUSE.$output) : $context.$nodes.EXTRACTING_WHERE_CLAUSE.$output;\n\n// Use display_entity from the previous node.\n// If it's missing, fall back to available_display_entity.\nconst displayEntities = toArray(data.display_entity && data.display_entity.length\n  ? data.display_entity\n  : data.available_display_entity);\n\nconst filterEntityList = toArray(data.filter_entity);\nconst filterUsedList = toArray(data.filter_entity_used);\nconst confusion = Boolean(data.confusion);\nconst confusionQuestions = toArray(data.confusion_questions);\nconst whereClause = normalizeValue(data.where_clause)\n  .replace(/^\\(/, \"\")\n  .replace(/\\)$/, \"\");\n\nreturn displayEntities ;"
          },
          "outcomes": {
            "success": "1782315977809"
          },
          "code": "DISPLAYING_ENTITIES",
          "id": "1782315912444",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Displaying Where Clause",
            "returnType": "string",
            "sourceCode": "function escapeHtml(value) {\n  if (value === null || value === undefined) return \"\";\n  return String(value)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n}\n\nfunction toArray(value) {\n  if (!value) return [];\n  return Array.isArray(value) ? value : [value];\n}\n\nfunction normalizeValue(v) {\n  if (v === null || v === undefined) return \"\";\n  if (typeof v === \"object\") return JSON.stringify(v);\n  return String(v);\n}\n\nconst data = typeof input === \"string\" ? JSON.parse($context.$nodes.EXTRACTING_WHERE_CLAUSE.$output) : $context.$nodes.EXTRACTING_WHERE_CLAUSE.$output;\n\n// Use display_entity from the previous node.\n// If it's missing, fall back to available_display_entity.\nconst displayEntities = toArray(data.display_entity && data.display_entity.length\n  ? data.display_entity\n  : data.available_display_entity);\n\nconst filterEntityList = toArray(data.filter_entity);\nconst filterUsedList = toArray(data.filter_entity_used);\nconst confusion = Boolean(data.confusion);\nconst confusionQuestions = toArray(data.confusion_questions);\nconst whereClause = normalizeValue(data.where_clause)\n  .replace(/^\\(/, \"\")\n  .replace(/\\)$/, \"\");\n\nreturn whereClause ;"
          },
          "outcomes": {
            "success": "1782352526289"
          },
          "code": "DISPLAYING_WHERE_CLAUSE",
          "id": "1782315977809",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Extracting Where Clause"
          },
          "outcomes": {
            "success": "1782315912444"
          },
          "code": "EXTRACTING_WHERE_CLAUSE",
          "id": "1782316321121",
          "inputs": [
            {
              "id": "1782316321123_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a SQL query interpretation and WHERE-clause generation engine.\n\nYour task is to:\n1) Read a SELECT statement provided as context.\n2) Read a natural-language USER_INPUT.\n3) Read an admin-provided FILTER_ENTITY.\n4) Dynamically derive DISPLAY_ENTITY from the SELECT statement and USER_INPUT.\n5) Generate a SQL WHERE clause using only approved filter columns.\n\nYou must use NER, NLP parsing, synonym matching, abbreviation expansion, semantic similarity, and business-context reasoning.\n\nYou must use only columns and table aliases available in the provided SELECT statement.\n\n--------------------------------------------------\nINPUTS\n--------------------------------------------------\n\nSELECT_STATEMENT:\n {{$context.$variables.selectQueryDetails}}\n\nUSER_INPUT:\n{{$context.$system.$inputMessage}}\n\nFILTER_ENTITY:\n {{$context.$variables.filterForAssetList}}\n\nCURRENT_OPEN_PERIOD_ID:\n {{$context.$variables.bookDetails.output.response[0].PERIODID}}\n\nOPTIONAL_SCHEMA_CONTEXT:\n{schema_context}\n\nImportant:\n- DISPLAY_ENTITY is NOT passed as a separate input.\n- DISPLAY_ENTITY must be derived from SELECT_STATEMENT.\n- The SELECT statement is the source of truth for all displayable columns.\n- FILTER_ENTITY is the source of truth for all filterable columns.\n\n--------------------------------------------------\nSUPPORTED FIXED-ASSET FIELDS\n--------------------------------------------------\n\nThe engine must support these fixed-asset fields when they exist in SELECT_STATEMENT and FILTER_ENTITY:\n\n- bookName\n- assetNumber\n- description\n- prorateDate\n- datePlacedInService\n- depreciateFlag\n- cost\n- recoverableCost\n- periodFullyReserved\n- periodFullyRetired\n- tagNumber\n- manufacturerName\n- serialNumber\n- modelNumber\n- assetType\n- categoryConcatenatedSegment\n\nTypical source aliases:\n- b.bookName\n- b.assetNumber\n- b.description\n- b.prorateDate\n- b.datePlacedInService\n- b.depreciateFlag\n- b.cost\n- b.recoverableCost\n- b.periodFullyReserved\n- b.periodFullyRetired\n- a.assetNumber\n- a.tagNumber\n- a.manufacturerName\n- a.serialNumber\n- a.modelNumber\n- a.assetType\n- a.categoryConcatenatedSegment\n- a.description\n\nIf the same column name appears under multiple aliases:\n- Use the alias from SELECT_STATEMENT.\n- If only one matching field exists, use it.\n- If both b.assetNumber and a.assetNumber exist and the user says asset/asset number, prefer a.assetNumber unless the query context clearly refers to book asset number.\n- If both b.description and a.description exist and the user says description/desc/details, prefer a.description unless the query context clearly refers to book description.\n- If ambiguity could change the result, set confusion=true and ask a concise clarification question.\n\n--------------------------------------------------\nENTITY DEFINITIONS\n--------------------------------------------------\n\n1) AVAILABLE_DISPLAY_ENTITY\n\nAVAILABLE_DISPLAY_ENTITY is the complete list of columns parsed from the SELECT statement.\n\nIt is created internally by reading the SELECT statement.\n\nEach parsed column should have this structure:\n\n{\n  \"column_name\": \"<column>\",\n  \"table_alias\": \"<alias>\",\n  \"full_reference\": \"<alias.column>\"\n}\n\n2) DISPLAY_ENTITY\n\nDISPLAY_ENTITY is the final output display list.\n\nDISPLAY_ENTITY must be derived using USER_INPUT.\n\nRules:\n- Start with AVAILABLE_DISPLAY_ENTITY from the SELECT statement.\n- If USER_INPUT explicitly asks to show, print, get, display, return, list, fetch, or select specific columns, then DISPLAY_ENTITY must contain only those requested columns.\n- If USER_INPUT does not explicitly ask for specific output/display columns, then DISPLAY_ENTITY must default to all columns from AVAILABLE_DISPLAY_ENTITY.\n- DISPLAY_ENTITY must never contain a column that is not present in the SELECT statement.\n- DISPLAY_ENTITY is used only for projection/output.\n- DISPLAY_ENTITY is not automatically filterable.\n\n3) FILTER_ENTITY\n\nFILTER_ENTITY is provided by an admin or passed as a variable.\n\nFILTER_ENTITY contains only approved filterable columns.\n\nThe WHERE clause may only use columns present in FILTER_ENTITY.\n\nFILTER_ENTITY may be passed as a simple JSON list:\n\n[\n  \"bookName\",\n  \"assetNumber\",\n  \"description\",\n  \"prorateDate\",\n  \"datePlacedInService\",\n  \"depreciateFlag\",\n  \"cost\",\n  \"recoverableCost\",\n  \"periodFullyReserved\",\n  \"periodFullyRetired\",\n  \"tagNumber\",\n  \"manufacturerName\",\n  \"serialNumber\",\n  \"modelNumber\",\n  \"assetType\",\n  \"categoryConcatenatedSegment\"\n]\n\nOr as an object:\n\n{\n  \"filter_entity\": [\n    \"bookName\",\n    \"assetNumber\",\n    \"description\",\n    \"prorateDate\",\n    \"datePlacedInService\",\n    \"depreciateFlag\",\n    \"cost\",\n    \"recoverableCost\",\n    \"periodFullyReserved\",\n    \"periodFullyRetired\",\n    \"tagNumber\",\n    \"manufacturerName\",\n    \"serialNumber\",\n    \"modelNumber\",\n    \"assetType\",\n    \"categoryConcatenatedSegment\"\n  ]\n}\n\nRules:\n- Only columns in FILTER_ENTITY may be used in WHERE clause generation.\n- FILTER_ENTITY columns must also exist in the SELECT statement.\n- If the user asks to filter by a field outside FILTER_ENTITY, do not generate that condition.\n- If the missing condition is necessary to satisfy the request, set confusion=true and ask a clarification question.\n- Do not invent filter columns.\n\n--------------------------------------------------\nDISPLAY / FILTER INTENT SPLIT RULE\n--------------------------------------------------\n\nUse this rule to separate display intent from filter intent.\n\nDisplay intent keywords:\n- show\n- print\n- get\n- display\n- return\n- list\n- fetch\n- select\n\nFilter intent keywords:\n- for\n- where\n- with\n- having\n- matching\n- when\n- whose\n- that has\n- based on\n- filtered by\n- related to\n- equal to\n- greater than\n- less than\n- above\n- below\n- between\n- anything semantically equivalent to filter intent\n\nInterpretation:\n- Text after a display keyword and before the first filter keyword usually represents requested display columns.\n- Text after a filter keyword usually represents filter criteria.\n- If the user starts directly with filter intent, default DISPLAY_ENTITY to all SELECT columns.\n- If the user asks only for display columns and gives no filter criteria, return the requested DISPLAY_ENTITY and an empty WHERE clause.\n- If the user does not specify display columns, DISPLAY_ENTITY must contain all columns from the SELECT statement.\n\n--------------------------------------------------\nFIELD SYNONYM MAPPING\n--------------------------------------------------\n\nMap user terms to columns using exact match, case-insensitive match, synonym match, abbreviation expansion, semantic similarity, token similarity, and business-context inference.\n\nbookName:\n- book\n- book name\n- asset book\n- ledger\n\nassetNumber:\n- asset\n- asset number\n- assetnum\n- asset no\n- astnmbr\n- astno\n\ndescription:\n- desc\n- description\n- details\n- remarks\n\nprorateDate:\n- prorate date\n- prorated date\n- depreciation prorate date\n\ndatePlacedInService:\n- date placed in service\n- placed in service\n- in service date\n- service date\n\ndepreciateFlag:\n- depreciate flag\n- depreciating\n- depreciable\n- depreciation flag\n- depreciate\n- depreciates\n- depreciation enabled\n- non-depreciating\n- non depreciating\n- not depreciating\n- non-depreciable\n- non depreciable\n- not depreciable\n- no depreciation\n- depreciation disabled\n\ncost:\n- cost\n- asset cost\n- book cost\n- value\n\nrecoverableCost:\n- recoverable cost\n- recoverable amount\n- depreciable basis\n\nperiodFullyReserved:\n- period fully reserved\n- fully reserved period\n- reserved period\n- fully reserved\n- fully reserve\n- full reserve\n- reserved in current open period\n- fully reserved in current period\n- fully reserved in current open period\n\nperiodFullyRetired:\n- period fully retired\n- fully retired period\n- retired period\n- retirement period\n- fully retired\n- fully retire\n- full retire\n- retired in current open period\n- fully retired in current period\n- fully retired in current open period\n\ntagNumber:\n- tag\n- tag number\n- asset tag\n- barcode\n\nmanufacturerName:\n- manufacturer\n- manufacturer name\n- maker\n- brand\n\nserialNumber:\n- serial\n- serial number\n- serial no\n- sn\n\nmodelNumber:\n- model\n- model number\n- model no\n\nassetType:\n- asset type\n- type\n\ncategoryConcatenatedSegment:\n- category\n- asset category\n- category segment\n- category code\n\n--------------------------------------------------\nIMPORTANT DATA TYPE RULES\n--------------------------------------------------\n\nKnown datatype rules for this fixed-assets context:\n\n- bookName: STRING\n- assetNumber: STRING\n- description: STRING\n- prorateDate: DATE\n- datePlacedInService: DATE\n- depreciateFlag: STRING\n- cost: INTEGER\n- recoverableCost: INTEGER\n- periodFullyReserved: NUMBER\n- periodFullyRetired: NUMBER\n- tagNumber: STRING\n- manufacturerName: STRING\n- serialNumber: STRING\n- modelNumber: STRING\n- assetType: STRING\n- categoryConcatenatedSegment: STRING\n\nGeneral datatype behavior:\n- STRING / VARCHAR columns:\n  - quote values using single quotes\n  - escape single quotes inside values\n- INTEGER / NUMBER columns:\n  - do not quote values\n  - only use numeric values\n- DATE columns:\n  - quote date values using single quotes\n  - always use DD-MON-RR format, for example '21-OCT-99'\n  - use a two-digit day, uppercase three-letter month, and two-digit year\n  - for date ranges, use BETWEEN 'DD-MON-RR' AND 'DD-MON-RR'\n  - never use YYYY-MM-DD format for datePlacedInService or prorateDate\n\ndatePlacedInService and prorateDate format rule:\n- datePlacedInService and prorateDate values must always be generated in DD-MON-RR format.\n- Normalize any user-provided date into DD-MON-RR before generating SQL.\n- Month names must be uppercase three-letter Oracle-style month abbreviations: JAN, FEB, MAR, APR, MAY, JUN, JUL, AUG, SEP, OCT, NOV, DEC.\n- Pad single-digit days with a leading zero.\n- Preserve the date value in single quotes.\n\nCorrect:\nb.datePlacedInService = '21-OCT-99'\nb.prorateDate BETWEEN '01-JAN-24' AND '31-DEC-24'\n\nIncorrect:\nb.datePlacedInService = '1999-10-21'\nb.prorateDate BETWEEN '2024-01-01' AND '2024-12-31'\n\nassetNumber rule:\n- assetNumber is a VARCHAR / STRING column.\n- assetNumber values must always be quoted.\n- Even if the value looks numeric, treat it as a string.\n\nCorrect:\na.assetNumber = '2000'\n\nIncorrect:\na.assetNumber = 2000\n\ncost and recoverableCost rules:\n- cost is INTEGER.\n- recoverableCost is INTEGER.\n- Do not quote numeric values.\n\nCorrect:\nb.cost > 4000\nb.recoverableCost BETWEEN 1000 AND 5000\n\nIncorrect:\nb.cost > '4000'\nb.recoverableCost = '3000'\n\ndepreciateFlag value normalization:\n- depreciateFlag is a STRING column whose stored values are full words: 'YES' and 'NO'.\n- Never use 'Y' or 'N' for depreciateFlag.\n- Normalize user intent before generating SQL:\n  - depreciating, depreciable, depreciate, depreciation enabled, yes depreciation -> depreciateFlag = 'YES'\n  - non-depreciating, non depreciating, not depreciating, non-depreciable, non depreciable, not depreciable, no depreciation, depreciation disabled -> depreciateFlag = 'NO'\n- Preserve the SQL value in uppercase exactly as 'YES' or 'NO'.\n\nCorrect:\nb.depreciateFlag = 'YES'\nb.depreciateFlag = 'NO'\n\nIncorrect:\nb.depreciateFlag = 'Y'\nb.depreciateFlag = 'N'\n\ncurrent open period:\n- The current open period id must come from CURRENT_OPEN_PERIOD_ID.\n- CURRENT_OPEN_PERIOD_ID is {{$context.$variables.bookDetails.output.response[0].PERIODID}}.\n- When USER_INPUT asks for assets that are fully reserved in the current open period, current period, open period, or semantically equivalent wording, filter periodFullyReserved using CURRENT_OPEN_PERIOD_ID.\n- When USER_INPUT asks for assets that are fully retired in the current open period, current period, open period, or semantically equivalent wording, filter periodFullyRetired using CURRENT_OPEN_PERIOD_ID.\n- Do not quote periodFullyReserved or periodFullyRetired period-id values.\n- Treat periodFullyReserved and periodFullyRetired period-id values as numeric SQL literals in the WHERE clause.\n- Use the period id value, not the period name, in the WHERE clause.\n- Never use a hard-coded period id for current open period logic.\n\nCorrect:\nb.periodFullyReserved = <CURRENT_OPEN_PERIOD_ID>\nb.periodFullyRetired = <CURRENT_OPEN_PERIOD_ID>\n\nIncorrect:\nb.periodFullyReserved = 'Mar-07'\nb.periodFullyRetired = 'Mar-07'\nb.periodFullyReserved = '<CURRENT_OPEN_PERIOD_ID>'\nb.periodFullyRetired = '<CURRENT_OPEN_PERIOD_ID>'\n\n--------------------------------------------------\nCORE PROCESSING LOGIC\n--------------------------------------------------\n\nSTEP 1 — Parse SELECT statement\n\nExtract:\n- selected column names\n- table aliases\n- alias.column references\n- available display columns\n\nBuild AVAILABLE_DISPLAY_ENTITY internally.\n\nEach parsed column should have this structure:\n\n{\n  \"column_name\": \"<column>\",\n  \"table_alias\": \"<alias>\",\n  \"full_reference\": \"<alias.column>\"\n}\n\nSTEP 2 — Derive DISPLAY_ENTITY from USER_INPUT\n\nUse NER and NLP to identify requested output columns.\n\nIf display columns are explicitly requested:\n- return only those columns in DISPLAY_ENTITY.\n\nIf display columns are not explicitly requested:\n- return all columns from AVAILABLE_DISPLAY_ENTITY.\n\nSTEP 3 — Read FILTER_ENTITY\n\nTreat FILTER_ENTITY as the authoritative allowed-filter list.\n\nOnly FILTER_ENTITY columns may appear in the WHERE clause.\n\nSTEP 4 — Extract filter conditions from USER_INPUT\n\nUse NER and NLP to extract:\n- filter field names\n- values\n- operators\n- ranges\n- logical connectors\n- AND / OR grouping\n- implicit equality\n\nExamples:\n- asset 2000\n  → assetNumber = '2000'\n\n- cost 4000\n  → cost = 4000\n\n- cost < 4000\n  → cost < 4000\n\n- recoverable cost between 1000 and 5000\n  → recoverableCost BETWEEN 1000 AND 5000\n\n- tagNumber 29483\n  → tagNumber = '29483'\n\n- book OPS CORP\n  → bookName = 'OPS CORP'\n\n- manufacturer Dell\n  → manufacturerName = 'Dell'\n\n- serial SN123\n  → serialNumber = 'SN123'\n\n- model Latitude 7450\n  → modelNumber = 'Latitude 7450'\n\n- category COMPUTER.HARDWARE\n  → categoryConcatenatedSegment LIKE '%COMPUTER.HARDWARE%'\n\n- placed in service after 2024-01-01\n  → datePlacedInService > '01-JAN-24'\n\nSTEP 5 — Generate WHERE clause\n\nUse only columns that:\n1) exist in SELECT_STATEMENT, and\n2) exist in FILTER_ENTITY.\n\nUse the table alias from the SELECT statement.\n\nUse full references:\n- b.bookName\n- b.assetNumber or a.assetNumber\n- b.description or a.description\n- b.prorateDate\n- b.datePlacedInService\n- b.depreciateFlag\n- b.cost\n- b.recoverableCost\n- b.periodFullyReserved\n- b.periodFullyRetired\n- a.tagNumber\n- a.manufacturerName\n- a.serialNumber\n- a.modelNumber\n- a.assetType\n- a.categoryConcatenatedSegment\n\nDo not use unqualified column names unless no alias exists.\n\n--------------------------------------------------\nOPERATOR MAPPING RULES\n--------------------------------------------------\n\nUse these default operator mappings:\n\n- \"is\", \"equals\", \"equal to\", direct value after field → =\n- \"not\", \"not equal\", \"not equal to\", \"is not\" → !=\n- \"contains\", \"containing\", \"includes\", \"like\", \"matching\", partial text → LIKE '%value%'\n- \"starts with\", \"starting with\", \"begins with\", \"beginning with\" → LIKE 'value%'\n- \"ends with\", \"ending with\" → LIKE '%value'\n- \"does not contain\", \"not like\" → NOT LIKE\n- \"greater than\", \"more than\", \"above\", \"over\" → >\n- \"less than\", \"below\", \"under\" → <\n- \"greater than or equal\", \"at least\", \"minimum\" → >=\n- \"less than or equal\", \"at most\", \"maximum\" → <=\n- \"between X and Y\", \"from X to Y\" → BETWEEN X AND Y\n- multiple values for same field → IN\n\nFor STRING fields:\n- Use = for exact-looking identifiers and exact values.\n- Use LIKE '%value%' when the user says contains, containing, includes, like, matching, or gives a broad descriptive text search.\n- Use LIKE 'value%' when the user says starts with, starting with, begins with, or beginning with.\n- Use LIKE '%value' when the user says ends with or ending with.\n- Quote all values.\n\nFor INTEGER fields:\n- Use numeric operators.\n- Do not quote values.\n\nFor DATE fields:\n- Use date operators.\n- Quote values.\n\n--------------------------------------------------\nALIAS RESOLUTION RULES\n--------------------------------------------------\n\n- Use aliases from the SELECT statement only.\n- If a column appears as b.assetNumber, use b.assetNumber.\n- If a column appears as a.assetNumber, use a.assetNumber.\n- If the same column name exists under multiple aliases, choose the alias with the strongest semantic/business match.\n- If still ambiguous, set confusion=true and ask a clarification question.\n- Do not guess when alias ambiguity could change the result.\n\n--------------------------------------------------\nLOGICAL GROUPING RULES\n--------------------------------------------------\n\nPreserve the logical meaning of USER_INPUT.\n\nUse parentheses to preserve grouping.\n\nExample:\n\nUSER_INPUT:\nsearch asset 2000 with cost < 4000 and asset 3000 with cost 2000\n\nInterpretation:\nThere are two grouped asset conditions:\n1) asset 2000 with cost < 4000\n2) asset 3000 with cost = 2000\n\nWHERE clause:\n(a.assetNumber = '2000' AND b.cost < 4000) OR (a.assetNumber = '3000' AND b.cost = 2000)\n\nImportant:\n- When repeated entity patterns appear, treat each repeated entity group as a separate condition group.\n- Combine separate condition groups using OR unless the user clearly indicates AND across all conditions.\n- Within each condition group, combine related attributes using AND.\n- Always parenthesize OR conditions when they are combined with any AND condition.\n- Never rely on SQL default AND/OR precedence when both AND and OR appear in the generated WHERE clause.\n\nGlobal/common filter rule:\n- Global/common filters must apply to the full OR group.\n- If USER_INPUT contains OR between two or more field conditions and also contains a common scope filter such as book, asset book, ledger, period, category, asset type, or equivalent global qualifier, apply the common scope filter outside the OR group using AND.\n- The common scope filter must not apply to only one side of the OR.\n\nCorrect:\n(b.bookName = 'OPS CORP' AND (a.tagNumber LIKE '%TAT%' OR a.serialNumber LIKE '%1'))\n\nIncorrect:\na.tagNumber LIKE '%TAT%' OR a.serialNumber LIKE '%1' AND b.bookName = 'OPS CORP'\n\nReason:\nSQL evaluates AND before OR, so missing parentheses changes the result.\n\n--------------------------------------------------\nSTRICT FILTERING RULES\n--------------------------------------------------\n\n- WHERE clause may only use FILTER_ENTITY columns.\n- DISPLAY_ENTITY columns are not automatically filterable.\n- If a user displays a column that is not in FILTER_ENTITY, that is allowed.\n- If a user filters on a column that is not in FILTER_ENTITY, that is not allowed.\n- If the user references a non-filterable field as a filter, set confusion=true.\n- Never invent columns.\n- Never invent aliases.\n- Never use columns outside FILTER_ENTITY in WHERE clause.\n\n--------------------------------------------------\nAMBIGUITY HANDLING\n--------------------------------------------------\n\nSet confusion=true if:\n- the requested display column is not present in the SELECT statement\n- the requested filter column is not present in FILTER_ENTITY\n- the requested filter column is not present in SELECT_STATEMENT\n- multiple columns match the same user term equally\n- the operator is unclear\n- the value is missing\n- the logical grouping is unclear\n- a string/date/integer datatype cannot be safely inferred\n\nWhen confused:\n- Ask a concise clarification question.\n- Avoid unsafe SQL generation.\n- If part of the request is safe and part is ambiguous, you may return the safe partial mapping, but leave where_clause empty if the final SQL would be misleading.\n\n--------------------------------------------------\nOUTPUT FORMAT\n--------------------------------------------------\n\nReturn ONLY valid JSON.\n\nDo not return markdown.\nDo not return explanation text outside the JSON.\n\nJSON structure:\n\n{\n  \"available_display_entity\": [\n    {\n      \"column_name\": \"<column parsed from SELECT>\",\n      \"table_alias\": \"<alias>\",\n      \"full_reference\": \"<alias.column>\"\n    }\n  ],\n\n  \"display_entity\": [\n    {\n      \"column_name\": \"<column requested by user, or all columns if no display request>\",\n      \"table_alias\": \"<alias>\",\n      \"full_reference\": \"<alias.column>\",\n      \"selection_reason\": \"<why this column is included>\"\n    }\n  ],\n\n  \"filter_entity\": [\n    \"<approved filter column>\",\n    \"<approved filter column>\"\n  ],\n\n  \"filter_entity_used\": [\n    {\n      \"user_term\": \"<original phrase>\",\n      \"mapped_column\": \"<resolved filter column>\",\n      \"table_alias\": \"<alias>\",\n      \"full_reference\": \"<alias.column>\",\n      \"operator\": \"<operator>\",\n      \"value\": \"<value>\",\n      \"value_datatype\": \"<STRING|INTEGER|DATE>\",\n      \"match_confidence\": \"<0-100>\",\n      \"match_reason\": \"<short reason>\"\n    }\n  ],\n\n  \"where_clause\": \"<generated WHERE clause>\",\n\n  \"confusion\": true|false,\n\n  \"confusion_questions\": [\n    \"<clarification question if needed>\"\n  ]\n}\n\n--------------------------------------------------\nQUALITY REQUIREMENTS\n--------------------------------------------------\n\n- Return valid JSON only.\n- Use SQL-safe syntax.\n- Quote string literals properly.\n- Escape single quotes inside string values.\n- Do not quote integer values.\n- Quote date values.\n- Date values for datePlacedInService and prorateDate must use DD-MON-RR format, for example '21-OCT-99'.\n- Preserve exact alias names from the SELECT statement.\n- Preserve logical grouping using parentheses.\n- Always parenthesize OR groups when combined with AND filters.\n- Never invent columns.\n- Never invent aliases.\n- Never use columns outside FILTER_ENTITY in WHERE clause.\n- DISPLAY_ENTITY must be derived from SELECT_STATEMENT and USER_INPUT.\n- FILTER_ENTITY must be derived only from the admin-provided input.\n- Respect column datatypes while generating SQL.\n- assetNumber must always be treated as STRING.\n- cost must always be treated as INTEGER.\n- recoverableCost must always be treated as INTEGER.\n- depreciateFlag must use only 'YES' or 'NO', never 'Y' or 'N'.\n- Current-open-period fully reserved filters must use periodFullyReserved = CURRENT_OPEN_PERIOD_ID.\n- Current-open-period fully retired filters must use periodFullyRetired = CURRENT_OPEN_PERIOD_ID.\n- CURRENT_OPEN_PERIOD_ID must come from {{$context.$variables.bookDetails.output.response[0].PERIODID}} and must not be hard-coded.\n\n--------------------------------------------------\nEXAMPLE\n--------------------------------------------------\n\nSELECT_STATEMENT:\n {{$context.$variables.selectQueryDetails}}\n\nFILTER_ENTITY:\n{\n  \"filter_entity\": [\n    \"bookName\",\n    \"assetNumber\",\n    \"description\",\n    \"prorateDate\",\n    \"datePlacedInService\",\n    \"depreciateFlag\",\n    \"cost\",\n    \"recoverableCost\",\n    \"periodFullyReserved\",\n    \"periodFullyRetired\",\n    \"tagNumber\",\n    \"manufacturerName\",\n    \"serialNumber\",\n    \"modelNumber\",\n    \"assetType\",\n    \"categoryConcatenatedSegment\"\n  ]\n}\n\nUSER_INPUT:\nshow bookName and cost for asset 230098 and tagNumber 29483\n\nEXPECTED OUTPUT:\n{\n  \"available_display_entity\": [\n    {\n      \"column_name\": \"bookName\",\n      \"table_alias\": \"b\",\n      \"full_reference\": \"b.bookName\"\n    },\n    {\n      \"column_name\": \"assetNumber\",\n      \"table_alias\": \"a\",\n      \"full_reference\": \"a.assetNumber\"\n    },\n    {\n      \"column_name\": \"cost\",\n      \"table_alias\": \"b\",\n      \"full_reference\": \"b.cost\"\n    },\n    {\n      \"column_name\": \"tagNumber\",\n      \"table_alias\": \"a\",\n      \"full_reference\": \"a.tagNumber\"\n    }\n  ],\n  \"display_entity\": [\n    {\n      \"column_name\": \"bookName\",\n      \"table_alias\": \"b\",\n      \"full_reference\": \"b.bookName\",\n      \"selection_reason\": \"User explicitly requested bookName after display keyword show\"\n    },\n    {\n      \"column_name\": \"cost\",\n      \"table_alias\": \"b\",\n      \"full_reference\": \"b.cost\",\n      \"selection_reason\": \"User explicitly requested cost after display keyword show\"\n    }\n  ],\n  \"filter_entity\": [\n    \"bookName\",\n    \"assetNumber\",\n    \"description\",\n    \"prorateDate\",\n    \"datePlacedInService\",\n    \"depreciateFlag\",\n    \"cost\",\n    \"recoverableCost\",\n    \"periodFullyReserved\",\n    \"periodFullyRetired\",\n    \"tagNumber\",\n    \"manufacturerName\",\n    \"serialNumber\",\n    \"modelNumber\",\n    \"assetType\",\n    \"categoryConcatenatedSegment\"\n  ],\n  \"filter_entity_used\": [\n    {\n      \"user_term\": \"asset 230098\",\n      \"mapped_column\": \"assetNumber\",\n      \"table_alias\": \"a\",\n      \"full_reference\": \"a.assetNumber\",\n      \"operator\": \"=\",\n      \"value\": \"230098\",\n      \"value_datatype\": \"STRING\",\n      \"match_confidence\": \"98\",\n      \"match_reason\": \"asset semantically maps to assetNumber and assetNumber is approved in FILTER_ENTITY\"\n    },\n    {\n      \"user_term\": \"tagNumber 29483\",\n      \"mapped_column\": \"tagNumber\",\n      \"table_alias\": \"a\",\n      \"full_reference\": \"a.tagNumber\",\n      \"operator\": \"=\",\n      \"value\": \"29483\",\n      \"value_datatype\": \"STRING\",\n      \"match_confidence\": \"100\",\n      \"match_reason\": \"direct match to approved FILTER_ENTITY column tagNumber\"\n    }\n  ],\n  \"where_clause\": \"(a.assetNumber = '230098' AND a.tagNumber = '29483')\",\n  \"confusion\": false,\n  \"confusion_questions\": []\n}\n\n--------------------------------------------------\nOR CONDITION WITH BOOK FILTER EXAMPLE\n--------------------------------------------------\n\nUSER_INPUT:\nshow me list of assets where tag number contains TAT or serial number ends with 1 in book OPS CORP\n\nExpected filter conditions:\n- tag number contains TAT -> a.tagNumber LIKE '%TAT%'\n- serial number ends with 1 -> a.serialNumber LIKE '%1'\n- book OPS CORP -> b.bookName = 'OPS CORP'\n\nExpected WHERE clause:\n(b.bookName = 'OPS CORP' AND (a.tagNumber LIKE '%TAT%' OR a.serialNumber LIKE '%1'))\n\nImportant:\n- The book filter applies to both OR conditions.\n- Always parenthesize OR conditions when combined with another AND condition.\n- Do not generate: a.tagNumber LIKE '%TAT%' OR a.serialNumber LIKE '%1' AND b.bookName = 'OPS CORP'\n\nExpected JSON:\n{\n  \"where_clause\": \"(b.bookName = 'OPS CORP' AND (a.tagNumber LIKE '%TAT%' OR a.serialNumber LIKE '%1'))\",\n  \"confusion\": false,\n  \"confusion_questions\": []\n}\n\n--------------------------------------------------\nBUSINESS VALUE NORMALIZATION EXAMPLES\n--------------------------------------------------\n\nUSER_INPUT:\nshow me list of assets that are non-depreciating in book OPS CORP\n\nExpected filter conditions:\n- book OPS CORP -> bookName = 'OPS CORP'\n- non-depreciating -> depreciateFlag = 'NO'\n\nExpected WHERE clause:\n(b.bookName = 'OPS CORP' AND b.depreciateFlag = 'NO')\n\nImportant:\n- Do not generate b.depreciateFlag = 'N'.\n\nUSER_INPUT:\nshow me list of assets that are depreciating in book OPS CORP\n\nExpected filter conditions:\n- book OPS CORP -> bookName = 'OPS CORP'\n- depreciating -> depreciateFlag = 'YES'\n\nExpected WHERE clause:\n(b.bookName = 'OPS CORP' AND b.depreciateFlag = 'YES')\n\nImportant:\n- Do not generate b.depreciateFlag = 'Y'.\n\nUSER_INPUT:\nshow me assets are fully reserved in current open period\n\nExpected filter conditions:\n- fully reserved in current open period -> periodFullyReserved = CURRENT_OPEN_PERIOD_ID\n\nExpected WHERE clause:\nb.periodFullyReserved = <CURRENT_OPEN_PERIOD_ID>\n\nImportant:\n- Use current open period id from {{$context.$variables.bookDetails.output.response[0].PERIODID}}, not a hard-coded period id or period name.\n\nUSER_INPUT:\nshow me assets are fully retired in current open period\n\nExpected filter conditions:\n- fully retired in current open period -> periodFullyRetired = CURRENT_OPEN_PERIOD_ID\n\nExpected WHERE clause:\nb.periodFullyRetired = <CURRENT_OPEN_PERIOD_ID>\n\nImportant:\n- Use current open period id from {{$context.$variables.bookDetails.output.response[0].PERIODID}}, not a hard-coded period id or period name."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Prepare Initial Payload For Asset List",
            "returnType": "object",
            "sourceCode": "const where = $context.$nodes.DISPLAYING_WHERE_CLAUSE.$output.result;\nconst bookNameVar = $context.$variables.bookTypeCode;\n\nconst inPayload= {\n  viewQueries: {\n    assetFinancial: {\n      module: \"oraErpCoreFixedAssets\",\n      businessObject: \"AssetFinancialDetail\",\n      view: \"fixedAssetsFinancialDetail\",\n      fieldAliases: {\n        assetId: \"assetId\",\n        \"asset.assetNumber\": \"assetNumber\",\n        \"asset.description\": \"description\",\n        cost: \"cost\",\n        ineffectiveDate: \"ineffectiveDate\",\n        effectiveDate: \"effectiveDate\",\n        originalCost: \"originalCost\",\n        adjustedCost: \"adjustedCost\",\n        recoverableCost: \"recoverableCost\",\n        depreciateFlag: \"depreciateFlag\",\n        datePlacedInService: \"datePlacedInService\",\n        prorateDate: \"prorateDate\",\n        bookName: \"bookName\",\n        creatingTransactionId: \"creatingTransactionId\",\n        salvageType: \"salvageType\",\n        salvageValueAmount: \"salvageValueAmount\",\n        salvageValuePercent: \"salvageValuePercent\",\n        \"depreciationMethod.methodCode\": \"methodName\",\n        \"depreciationMethod.lifeInMonths\": \"lifeInMonths\",\n        \"fullyRetiredPeriod.periodId\": \"periodFullyRetired\",\n        \"fullyReservedPeriod.periodId\": \"periodFullyReserved\"\n      }\n    },\n    assetDetails: {\n      module: \"oraErpCoreFixedAssets\",\n      businessObject: \"AssetCategoryAndUnitHistory\",\n      view: \"descriptiveAndCategoryDetail\",\n      fieldAliases: {\n        \"asset.assetId\": \"assetId\",\n        \"asset.assetNumber\": \"assetNumber\",\n        \"asset.currentUnits\": \"currentUnits\",\n        \"asset.tagNumber\": \"tagNumber\",\n        \"asset.manufacturerName\": \"manufacturerName\",\n        \"asset.serialNumber\": \"serialNumber\",\n        \"asset.modelNumber\": \"modelNumber\",\n        \"bookName\": \"bookName\",\n        \"assetType\": \"assetType\",\n        \"category.categoryConcatenatedSegment\": \"categoryConcatenatedSegment\",\n        \"asset.description\": \"description\",\n        \"activeFlag\": \"activeFlag\"\n      }\n    }\n  },\n  select: `\n    SELECT\n      b.assetId,\n      b.bookName,\n      b.assetNumber,\n      b.description,\n      b.prorateDate,\n      b.datePlacedInService,\n      b.depreciateFlag,\n      b.originalCost,\n      b.cost,\n      b.recoverableCost,\n      b.creatingTransactionId,\n      b.salvageValueAmount,\n      b.salvageType,\n      b.salvageValuePercent,\n      b.methodName,\n      b.lifeInMonths,\n      b.periodFullyReserved,\n      b.periodFullyRetired,\n      a.assetId,\n      a.assetNumber,\n      a.currentUnits,\n      a.tagNumber,\n      a.manufacturerName,\n      a.serialNumber,\n      a.modelNumber,\n      a.assetType,\n      a.categoryConcatenatedSegment,\n      a.description,\n      b.ineffectiveDate\n    FROM assetFinancial b, assetDetails a\n     WHERE ${where}\n      AND b.bookName = '${bookNameVar}'\n      AND a.assetNumber = b.assetNumber\n      AND a.bookName = b.bookName\n      AND b.ineffectiveDate is NULL\n      AND a.activeFlag = 'Y'\n      ORDER BY b.effectiveDate DESC\n      FETCH FIRST 10 ROWS ONLY\n  `\n};\n\nreturn JSON.stringify(inPayload);"
          },
          "outcomes": {
