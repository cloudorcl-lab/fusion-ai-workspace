              "id": "1780492226169_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an intelligent agent. Your task is to assign the book type code and parameter list \n\nStep 1: Populate below fields:\nbookTypeCode: {{$context.$nodes.BOOKACCESSCLASSIFICATION.$output.bookName}}\nParameterList: {{$context.$nodes.CHECKBOOKACCESSFORUSER.$output.ParameterList}} \n\nStep 2: Extract X_ACCESS_FLAG from ParameterList and assign to accessFlag.\n\n#Output:\nReturn only this JSON:\n\n{\n  \"bookTypeCode\": <value>\n  \"accessFlag\": <'Y'||'NB'||'NF'||'NDS'||'N'>\n}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"accessFlag\": {\n            \"type\": \"string\"\n        },\n        \"bookTypeCode\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "singleBookAccessMessage",
            "returnType": "string",
            "sourceCode": "const accessFlag = $context.$nodes.CHECKBOOKACCESSFLAG.$output.accessFlag;\nconst bookTypeCode = $context.$nodes.CHECKBOOKACCESSFLAG.$output.bookTypeCode;\n\nlet htmlString = '';\n\nif (accessFlag === 'NB') {\n\n  htmlString = `\n  <div style=\"background:#f9fafb; padding:12px 16px;\">\n    <div style=\"\n      font-family:'Oracle Sans';\n      font-size:14px;\n    \">\n      I couldn’t identify the book clearly. Please enter it again.\n    </div>\n\n    <br>\n\n    <div style=\"\n      font-family:'Oracle Sans';\n      font-size:12px;\n      margin:7px 0;\n    \">\n      Type 'HELP' to know about my capabilities.\n    </div>\n  </div>\n  `;\n\n} else if (accessFlag === 'Y') {\n\n  htmlString = `\n  <div style=\"background:#f9fafb; padding:12px 16px;\">\n\n    <div style=\"\n      font-family:'Oracle Sans';\n      font-size:16px;\n    \">\n      <b>Access confirmed!</b><br><br>\n    </div>\n\n    <div style=\"\n      font-family:'Oracle Sans';\n      font-size:14px;\n    \">\n      You have the required access to the book <b>${bookTypeCode}</b>. You can now proceed with Fixed Assets inquiries for this book.\n    </div>\n\n    <br>\n\n    <div style=\"\n      font-family:'Oracle Sans';\n      font-size:12px;\n      margin:7px 0;\n    \">\n      Type 'HELP' to know about my capabilities.\n      <br>&nbsp;\n    </div>\n\n  </div>\n  `;\n\n} else if (\n  accessFlag === 'NF' ||\n  accessFlag === 'NDS' ||\n  accessFlag === 'N'\n) {\n\n  htmlString = `\n  <div style=\"background:#f9fafb; padding:12px 16px;\">\n\n    <div style=\"\n      font-family:'Oracle Sans';\n      font-size:16px;\n    \">\n      <b>Access Denied !</b><br><br>\n    </div>\n\n    <div style=\"\n      font-family:'Oracle Sans';\n      font-size:14px;\n    \">\n      Sorry, you don’t have access to book <b>${bookTypeCode}</b>.<br>\n      Please contact your system administrator to request the required permissions.\n    </div>\n\n    <br>\n\n    <div style=\"\n      font-family:'Oracle Sans';\n      font-size:12px;\n      margin:7px 0;\n    \">\n      Type 'HELP' to know about my capabilities.\n      <br>&nbsp;\n    </div>\n\n  </div>\n  `;\n}\n\nreturn htmlString;"
          },
          "outcomes": {
            "success": "1780492959702"
          },
          "code": "SINGLEBOOKACCESSMESSAGE",
          "id": "1780492906351",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
