        {
          "metadata": {
            "name": "SINGLE ASSET EXTRACTOR",
            "returnType": "string",
            "sourceCode": "function normalize(value) {\n  if (value === undefined || value === null) return \"NA\";\n  const str = String(value).trim();\n  return str === \"\" ? \"NA\" : str;\n}\n\nfunction resolveAssetNumber(value) {\n  const normalized = normalize(value);\n  return normalized === \"NA\" ? searchIdentifier : normalized;\n}\n\nconst bookDetails = getRecords($context.$variables.bookDetails.output.response);\nconst bookRecord = bookDetails[0] || {};\nconst chatCounter = Number($context.$variables.FaInqChatCounter ?? 0);\n\nconst assetHeaderFinancialDetails = getRecords($context.$variables.assetHeaderFinancialDetails);\nconst assetDeprnDetails = getRecords($context.$variables.assetDeprnDetails);\nconst assetDistDetails = getRecords($context.$variables.assetDistDetails);\nconst prefs = $context.$variables.currencyFormatDetails || {};\nconst searchIdentifier = normalize($context.$variables.searchIdentifier);\n\nfunction toRecordArray(value) {\n  if (value === undefined || value === null || String(value).trim() === \"\") {\n    return [];\n  }\n  return Array.isArray(value) ? value : [value];\n}\n\nfunction getRecords(source) {\n  if (source === undefined || source === null) return [];\n\n  if (Array.isArray(source)) return source;\n  if (Array.isArray(source?.output?.response)) return source.output.response;\n  if (Array.isArray(source?.response)) return source.response;\n\n  return [];\n}\n\nfunction getValue(row, upperKey, lowerKey = \"\") {\n  return row?.[upperKey] ?? (lowerKey ? row?.[lowerKey] : undefined) ?? \"NA\";\n}\n\nfunction makeCamelCasing(str) {\n  if (str === null || str === \"CIP\") return str;\n  if (!str || String(str).trim() === \"\") return \"NA\";\n  const s = String(str);\n  return s[0].toUpperCase() + s.slice(1).toLowerCase();\n}\n\nfunction toYesNo(value) {\n  const normalized = String(value ?? \"\").trim().toUpperCase();\n  if ([\"Y\", \"YES\", \"TRUE\", \"1\"].includes(normalized)) return \"Yes\";\n  if ([\"N\", \"NO\", \"FALSE\", \"0\"].includes(normalized)) return \"No\";\n  return value ?? \"NA\";\n}\n\nfunction formatDateTime(value) {\n  if (value === undefined || value === null || String(value).trim() === \"\") {\n    return \"NA\";\n  }\n\n  const date = new Date(value);\n  if (isNaN(date.getTime())) return \"NA\";\n\n  const format = String(prefs.DateFormat || \"M/d/yy\");\n\n  const pad2 = (n) => String(n).padStart(2, \"0\");\n\n  const day = date.getDate();\n  const month = date.getMonth() + 1;\n  const year = date.getFullYear();\n  const yy = String(year).slice(-2);\n\n  const monthShort = date.toLocaleString(\"en-GB\", { month: \"short\" });\n  const monthLong = date.toLocaleString(\"en-GB\", { month: \"long\" });\n  const weekdayShort = date.toLocaleString(\"en-GB\", { weekday: \"short\" });\n  const weekdayLong = date.toLocaleString(\"en-GB\", { weekday: \"long\" });\n\n  const hour24 = date.getHours();\n  const hour12 = hour24 % 12 || 12;\n  const minute = date.getMinutes();\n  const second = date.getSeconds();\n  const ampm = hour24 >= 12 ? \"PM\" : \"AM\";\n\n  const tokens = {\n    yyyy: String(year),\n    yy: yy,\n    MMMM: monthLong,\n    MMM: monthShort,\n    MM: pad2(month),\n    M: String(month),\n    dd: pad2(day),\n    d: String(day),\n    EEEE: weekdayLong,\n    EEE: weekdayShort,\n    HH: pad2(hour24),\n    H: String(hour24),\n    hh: pad2(hour12),\n    h: String(hour12),\n    mm: pad2(minute),\n    m: String(minute),\n    ss: pad2(second),\n    s: String(second),\n    a: ampm.toLowerCase(),\n    A: ampm\n  };\n\n  return format.replace(\n    /yyyy|yy|MMMM|MMM|MM|M|dd|d|EEEE|EEE|HH|H|hh|h|mm|m|ss|s|A|a/g,\n    (match) => tokens[match] ?? match\n  );\n}\n\nfunction formatAmount(amount, groupingSeparator, decimalSeparator, precision) {\n  if (amount === undefined || amount === null || amount === \"\") return \"NA\";\n\n  const numericAmount = Number(String(amount).replace(/,/g, \"\"));\n  if (isNaN(numericAmount)) return String(amount);\n\n  const isNegative = numericAmount < 0;\n  const fixed = Math.abs(numericAmount).toFixed(precision);\n  let [integerPart, decimalPart] = fixed.split(\".\");\n\n  integerPart = integerPart.replace(/\\B(?=(\\d{3})+(?!\\d))/g, groupingSeparator);\n\n  const formatted = decimalPart ? integerPart + decimalSeparator + decimalPart : integerPart;\n  return (isNegative ? \"-\" : \"\") + formatted;\n}\n\nfunction formatCurrencyAmount(amount) {\n  return formatAmount(\n    amount,\n    prefs.groupingSeparator || \",\",\n    prefs.decimalSeparator || \".\",\n    prefs.precision ?? 2\n  );\n}\n\nfunction formatSalvageType(value) {\n  const normalized = String(value ?? \"\").trim().toUpperCase();\n\n  if (normalized === \"AMT\") return \"Amount\";\n  if (normalized === \"PCT\") return \"Percent\";\n\n  return value ?? \"NA\";\n}\n\nfunction leftSummaryBlock() {\n  return `\n    <div style=\"display:flex; flex-direction:column; gap:6px; min-width:220px;\">\n      <div style=\"display:flex; gap:6px; white-space:nowrap; align-items:baseline;\">\n        <strong>Book</strong><span>${normalize(bookRecord.BOOKNAME)}</span>\n      </div>\n      <div style=\"display:flex; gap:6px; white-space:nowrap; align-items:baseline;\">\n        <strong>Period</strong><span>${normalize(bookRecord.PERIODNAME)}</span>\n      </div>\n    </div>`;\n}\n\nfunction rightSummaryBlockGeneral() {\n  return `\n    <div style=\"display:flex; flex-direction:column; gap:6px; min-width:260px; align-items:flex-start;\">\n      <div style=\"display:flex; gap:6px; white-space:nowrap; align-items:baseline;\">\n        <strong>Ledger Name</strong><span>${normalize(bookRecord.LEDGERNAME)}</span>\n      </div>\n      <div style=\"display:flex; gap:6px; white-space:nowrap; align-items:baseline;\">\n        <strong>Currency</strong><span>${normalize(bookRecord.CURRENCYCODE)}</span>\n      </div>\n    </div>`;\n}\n\nfunction generalHeaderHtml() {\n  return `\n    <div style=\"display:flex; justify-content:flex-start; align-items:flex-start; gap:72px; flex-wrap:wrap; max-width:760px; width:100%;\">\n      ${leftSummaryBlock()}\n      ${rightSummaryBlockGeneral()}\n    </div>`;\n}\n\nfunction depreciationHeaderHtml(assetNumber, depreciateValue, depreciableBasisAmount, costValue) {\n  return `\n    <div style=\"display:flex; align-items:flex-start; gap:110px; max-width:900px; width:100%;\">\n\n      <div style=\"display:flex; flex-direction:column; gap:10px; min-width:240px;\">\n        <div style=\"display:flex; gap:8px; align-items:baseline;\">\n          <strong>Book</strong>\n          <span>${normalize(bookRecord.BOOKNAME)}</span>\n        </div>\n\n        <div style=\"display:flex; gap:8px; align-items:baseline;\">\n          <strong>Period</strong>\n          <span>${normalize(bookRecord.PERIODNAME)}</span>\n        </div>\n\n        <div style=\"display:flex; gap:8px; align-items:baseline;\">\n          <strong>Currency</strong>\n          <span>${normalize(bookRecord.CURRENCYCODE)}</span>\n        </div>\n\n        <div style=\"display:flex; gap:8px; align-items:baseline;\">\n          <strong>Depreciate</strong>\n          <span>${normalize(depreciateValue)}</span>\n        </div>\n      </div>\n\n      <div style=\"display:flex; flex-direction:column; gap:10px; min-width:340px;\">\n        <div style=\"display:flex; gap:8px; align-items:baseline;\">\n          <strong>Asset Number</strong>\n          <span>${normalize(assetNumber)}</span>\n        </div>\n\n        <div style=\"display:flex; gap:8px; align-items:baseline;\">\n          <strong>Ledger Name</strong>\n          <span>${normalize(bookRecord.LEDGERNAME)}</span>\n        </div>\n\n        <div style=\"display:flex; gap:8px; align-items:baseline;\">\n          <strong>Cost</strong>\n          <span style=\"text-align:right;\">${normalize(costValue)}</span>\n        </div>\n\n        <div style=\"display:flex; gap:8px; align-items:baseline;\">\n          <strong>Depreciable Basis Amount</strong>\n          <span style=\"text-align:right;\">${normalize(depreciableBasisAmount)}</span>\n        </div>\n      </div>\n\n    </div>\n  `;\n}\n\nconst helpHtml =\n  chatCounter <= 2\n    ? `<div style=\"font-family:'Oracle Sans'; font-size:12px; margin-top:6px;\">Type 'HELP' to know about my capabilities.</div>`\n    : \"\";\n\nconst userQuestion = String($context.$nodes.USER_INPUT_PROCESSOR.$output.userQuestion || \"\");\n\nconst normalizedQuestion = userQuestion\n  .toUpperCase()\n  .replace(/[-_]/g, \" \")\n  .replace(/\\s+/g, \" \")\n  .trim();\n\nconst hasFinancialKeyword = normalizedQuestion.includes(\"FINANCIAL\");\n\nconst hasDistributionKeyword = normalizedQuestion.includes(\"DISTRIBUTION\");\n\nconst hasNBVKeyword =\n  normalizedQuestion.includes(\"NBV\") ||\n  normalizedQuestion.includes(\"NET BOOK VALUE\") ||\n  normalizedQuestion.includes(\"BOOK VALUE\");\n\nconst hasDepreciationKeyword =\n  normalizedQuestion.includes(\"DEPRECIATION\") ||\n  normalizedQuestion.includes(\"DEPRN\");\n\nconst hasGeneralKeyword =\n  normalizedQuestion.includes(\"GENERAL DETAILS\") ||\n  (normalizedQuestion.includes(\"DETAILS\") &&\n    !hasFinancialKeyword &&\n    !hasDistributionKeyword &&\n    !hasNBVKeyword &&\n    !hasDepreciationKeyword);\n\nlet intentName = \"\";\n\nif (hasGeneralKeyword) {\n  intentName = \"GENERAL_DETAILS\";\n} else if (hasFinancialKeyword) {\n  intentName = \"FINANCIAL_DETAILS\";\n} else if (hasDistributionKeyword) {\n  intentName = \"DISTRIBUTION_DETAILS\";\n} else if (hasDepreciationKeyword) {\n  intentName = \"DEPRECIATION_DETAILS\";\n} else if (hasNBVKeyword) {\n  intentName = \"NBV_DETAILS\";\n}\n\nconst records = assetHeaderFinancialDetails;\n\nlet assetHtml = \"\";\n\nif (intentName === \"GENERAL_DETAILS\") {\n  let rowsHtml = \"\";\n\n  for (let i = 0; i < records.length; i++) {\n    const row = records[i] || {};\n    const assetNumber = resolveAssetNumber(row.ASSETNUMBER);\n    const serialNumber = row.SERIALNUMBER || \"-\";\n    const tagNumber = row.TAGNUMBER || \"-\";\n    const assetType = makeCamelCasing(row.ASSETTYPE || \"NA\");\n    const currentUnits = row.CURRENTUNITS ?? \"NA\";\n    const categoryId = row.CATEGORYCONCATENATEDSEGMENT ?? \"NA\";\n    const cost = formatCurrencyAmount(row.COST);\n\n    rowsHtml += `<tr style=\"background-color:#ffffff;\">\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${assetNumber}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${serialNumber}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${tagNumber}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${assetType}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${currentUnits}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${categoryId}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:right;\">${cost}</td>\n    </tr>`;\n  }\n\n  assetHtml = `\n<div style=\"background:#f9fafb; padding:12px 16px;\">\n  <div style=\"font-family:'Oracle Sans'; margin-bottom:10px;\">\n    <div style=\"font-size:16px; font-weight:500; margin-bottom:8px;\">\n      <br>\n      <b>Asset Details as requested</b>\n    </div>\n    <br>\n    <div style=\"font-size:14px; font-weight:400; margin-bottom:8px;\">\n      ${generalHeaderHtml()}\n    </div>\n  </div>\n  <br>\n\n  <div style=\"width:100%; max-width:100%; border:1px solid #d6d9dc; overflow:hidden;\">\n    <table style=\"width:100%; border-collapse:collapse; table-layout:fixed; font-size:14px;\">\n      <colgroup>\n        <col style=\"width:16%;\">\n        <col style=\"width:16%;\">\n        <col style=\"width:14%;\">\n        <col style=\"width:16%;\">\n        <col style=\"width:10%;\">\n        <col style=\"width:18%;\">\n        <col style=\"width:10%;\">\n      </colgroup>\n      <thead style=\"background-color:#f3f4f6;\">\n        <tr>\n          <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Asset Number</th>\n          <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Serial Number</th>\n          <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Tag Number</th>\n          <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Asset Type</th>\n          <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Units</th>\n          <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Category</th>\n          <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:right;\">Cost</th>\n        </tr>\n      </thead>\n      <tbody>\n        ${rowsHtml}\n      </tbody>\n    </table>\n  </div>\n\n  <br>\n  <div style=\"font-family:'Oracle Sans'; font-size:14px; margin:12px 0;\"> \n    <div>Do you want more asset details? Enter an option below.</div>\n    <ul>\n      <li>Financial Details</li>\n      <li>Depreciation Details</li>\n      <li>Distribution Details</li>\n    </ul>\n  </div>\n\n  <div style=\"font-family:'Oracle Sans'; font-size:14px; margin:12px 0;\">\n    If you want to inquire about any other asset, kindly enter the asset number. For example:\n    <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n      \"show me list of assets that ends with [search string] in [book name] book\"\n    </div>\n  </div>\n\n  ${helpHtml}\n</div>`;\n} else if (intentName === \"FINANCIAL_DETAILS\") {\n  let rowsHtml = \"\";\n\n  for (let i = 0; i < records.length; i++) {\n    const row = records[i] || {};\n    const assetNumber = resolveAssetNumber(row.ASSETNUMBER);\n    const dpis = formatDateTime(row.DATEPLACEDINSERVICE);\n    const prorateDate = formatDateTime(row.PRORATEDATE);\n    const assetCost = formatCurrencyAmount(row.COST);\n    const adjustedCost = formatCurrencyAmount(row.RECOVERABLECOST);\n    const salvageValue = formatCurrencyAmount(row.SALVAGEVALUEAMOUNT);\n    const salvageType = formatSalvageType(row.SALVAGETYPE);\n    const depFlag = toYesNo(row.DEPRECIATEFLAG);\n    const fullyReserve = row.PERIODFULLYRESERVED == null ? \"No\" : \"Yes\";\n    const fullyRetire = row.PERIODFULLYRETIRED == null ? \"No\" : \"Yes\";\n\n    rowsHtml += `<tr style=\"background-color:#ffffff;\">\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${assetNumber}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${dpis}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${prorateDate}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:right;\">${assetCost}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:right;\">${adjustedCost}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:right;\">${salvageValue}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${salvageType}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${depFlag}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${fullyReserve}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${fullyRetire}</td>\n    </tr>`;\n  }\n\n  assetHtml = `\n<div style=\"background:#f9fafb; padding:12px 16px;\">\n  <div style=\"font-family:'Oracle Sans'; margin-bottom:10px;\">\n    <div style=\"font-size:16px; font-weight:500; margin-bottom:8px;\">\n      <br>\n      <b>Financial Details as requested</b>\n    </div>\n    <br>\n    <div style=\"font-size:14px; margin-bottom:8px;\">\n      ${generalHeaderHtml()}\n    </div>\n  </div>\n  <br>\n\n  <div style=\"width:100%; max-width:100%; border:1px solid #d6d9dc; overflow-x:auto;\">\n    <table style=\"width:100%; min-width:1200px; border-collapse:collapse; table-layout:fixed; font-size:14px;\">\n      <colgroup>\n        <col style=\"width:12%;\">\n        <col style=\"width:12%;\">\n        <col style=\"width:12%;\">\n        <col style=\"width:12%;\">\n        <col style=\"width:12%;\">\n        <col style=\"width:12%;\">\n        <col style=\"width:10%;\">\n        <col style=\"width:8%;\">\n        <col style=\"width:10%;\">\n        <col style=\"width:10%;\">\n      </colgroup>\n      <thead style=\"background-color:#f3f4f6;\">\n        <tr>\n          <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Asset Number</th>\n          <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">In Service Date</th>\n          <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Prorate Date</th>\n          <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:right;\">Asset Cost</th>\n          <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:right;\">Adjusted Cost</th>\n          <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:right;\">Salvage Value</th>\n          <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Salvage Type</th>\n          <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Depreciate</th>\n          <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Fully Reserve</th>\n          <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Fully Retire</th>\n        </tr>\n      </thead>\n      <tbody>\n        ${rowsHtml}\n      </tbody>\n    </table>\n  </div>\n\n  <br>\n  <div style=\"font-family:'Oracle Sans'; font-size:14px; margin:12px 0;\"> \n    <div>Do you want more asset details? Enter an option below.</div>\n    <ul>\n      <li>General Details</li>\n      <li>Depreciation Details</li>\n      <li>Distribution Details</li>\n    </ul>\n  </div>\n\n  <div style=\"font-family:'Oracle Sans'; font-size:14px; margin:12px 0;\">\n    If you want to inquire about any other asset, kindly enter the asset number. For example:\n    <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n      \"show me list of assets that ends with [search string] in [book name] book\"\n    </div>\n  </div>\n\n  ${helpHtml}\n</div>`;\n} else if (intentName === \"DEPRECIATION_DETAILS\") {\n  const deprnRecords = assetDeprnDetails;\n  const headerRecord = assetHeaderFinancialDetails[0] || {};\n  const deprnSummary = deprnRecords[0] || {};\n\n  const headerAssetNumber = resolveAssetNumber(getValue(deprnSummary, \"ASSETNUMBER\"));\n  const headerCost = formatCurrencyAmount(getValue(deprnSummary, \"COST\"));\n  const headerDepreciateFlag = toYesNo(headerRecord.DEPRECIATEFLAG);\n  const depreciableBasisAmount = formatCurrencyAmount(getValue(deprnSummary, \"COST\"));\n\n  let rowsHtml = \"\";\n  const monthMap = {\n  jan: 0, feb: 1, mar: 2, apr: 3, may: 4, jun: 5,\n  jul: 6, aug: 7, sep: 8, oct: 9, nov: 10, dec: 11\n};\n\nconst sortedDeprnRecords = [...deprnRecords].sort((a, b) => {\n  const [aMon, aYr] = getValue(a, \"PERIODNAME\").toLowerCase().split(\"-\");\n  const [bMon, bYr] = getValue(b, \"PERIODNAME\").toLowerCase().split(\"-\");\n\n  const aDate = new Date(2000 + Number(aYr), monthMap[aMon]);\n  const bDate = new Date(2000 + Number(bYr), monthMap[bMon]);\n\n  return bDate - aDate; // newest first\n});\n\n for (let i = 0; i < sortedDeprnRecords.length; i++) {\n  const row = sortedDeprnRecords[i] || {};\n\n    const rowPeriodName = getValue(row, \"PERIODNAME\");\n    const distID = getValue(row, \"DISTRIBUTIONID\");\n    const distributionCost = formatCurrencyAmount(getValue(row, \"COST\"));\n    const deprnAmount = formatCurrencyAmount(getValue(row, \"DEPRECIATIONAMOUNT\"));\n    const ytdDeprn = formatCurrencyAmount(getValue(row, \"YTDDEPRECIATION\"));\n    const deprnReserve = formatCurrencyAmount(getValue(row, \"DEPRECIATIONRESERVE\"));\n    const deprnAdjustmentAmount = formatCurrencyAmount(getValue(row, \"DEPRECIATIONADJUSTMENTAMOUNT\"));\n    const bonusDeprnAmount = formatCurrencyAmount(getValue(row, \"BONUSDEPRECIATIONAMOUNT\"));\n    const bonusYTDDeprnAmount = formatCurrencyAmount(getValue(row, \"BONUSYTDDEPRECIATION\"));\n    const bonusDeprnReserve = formatCurrencyAmount(getValue(row, \"BONUSDEPRECIATIONRESERVE\"));\n\n    rowsHtml += `<tr style=\"background-color:${i % 2 === 0 ? \"#ffffff\" : \"#f3f4f6\"};\">\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left; vertical-align:middle; word-break:break-word;\">${rowPeriodName}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left; vertical-align:middle; word-break:break-word;\">${distID}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:right; vertical-align:middle; word-break:break-word;\">${distributionCost}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:right; vertical-align:middle; word-break:break-word;\">${deprnAmount}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:right; vertical-align:middle; word-break:break-word;\">${ytdDeprn}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:right; vertical-align:middle; word-break:break-word;\">${deprnReserve}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:right; vertical-align:middle; word-break:break-word;\">${deprnAdjustmentAmount}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:right; vertical-align:middle; word-break:break-word;\">${bonusDeprnAmount}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:right; vertical-align:middle; word-break:break-word;\">${bonusYTDDeprnAmount}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:right; vertical-align:middle; word-break:break-word;\">${bonusDeprnReserve}</td>\n    </tr>`;\n  }\n\n  assetHtml = `\n<div style=\"background:#f9fafb; padding:12px 12px;\">\n  <div style=\"font-family:'Oracle Sans'; margin-bottom:14px;\">\n    <div style=\"font-size:16px; font-weight:500; margin-bottom:6px;\">\n      <br>\n      <b>Depreciation Details as requested</b>\n    </div>\n    <br>\n    <div style=\"font-size:14px; font-weight:400;\">\n      ${depreciationHeaderHtml(headerAssetNumber, headerDepreciateFlag, depreciableBasisAmount, headerCost)}\n    </div>\n  </div>\n  <br>\n\n  <div style=\"background:#f9fafb; padding:12px 12px 12px 4px;\">\n    <div style=\"width:100%; max-width:100%; border:1px solid #d6d9dc; overflow-x:auto;\">\n      <table style=\"width:100%; min-width:1100px; border-collapse:collapse; table-layout:fixed; font-size:14px;\">\n        <colgroup>\n          <col style=\"width:6%;\">\n          <col style=\"width:8%;\">\n          <col style=\"width:8%;\">\n          <col style=\"width:10%;\">\n          <col style=\"width:8%;\">\n          <col style=\"width:10%;\">\n          <col style=\"width:14%;\">\n          <col style=\"width:13%;\">\n          <col style=\"width:14%;\">\n          <col style=\"width:12.5%;\">\n        </colgroup>\n        <thead style=\"background-color:#f3f4f6;\">\n          <tr>\n            <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left; vertical-align:middle; word-break:break-word;\">Period</th>\n            <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left; vertical-align:middle; word-break:break-word;\">Distribution ID</th>\n            <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:right; vertical-align:middle; word-break:break-word;\">Distribution Cost</th>\n            <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:right; vertical-align:middle; word-break:break-word;\">Depreciation Amount</th>\n            <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:right; vertical-align:middle; word-break:break-word;\">YTD Depreciation</th>\n            <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:right; vertical-align:middle; word-break:break-word;\">Depreciation Reserve</th>\n            <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:right; vertical-align:middle; word-break:break-word;\">Depreciation Adjustment Amount</th>\n            <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:right; vertical-align:middle; word-break:break-word;\">Bonus Depreciation Amount</th>\n            <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:right; vertical-align:middle; word-break:break-word;\">Bonus YTD Depreciation Amount</th>\n            <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:right; vertical-align:middle; word-break:break-word;\">Bonus Depreciation Reserve</th>\n          </tr>\n        </thead>\n        <tbody>\n          ${rowsHtml}\n        </tbody>\n      </table>\n    </div>\n    <br>\n\n    <div style=\"font-family:'Oracle Sans'; font-size:14px; margin:12px 0;\">\n      <div>Do you want more asset details? Enter an option below.</div>\n      <ul>\n        <li>General Details</li>\n        <li>Financial Details</li>\n        <li>Distribution Details</li>\n      </ul>\n    </div>\n\n    <div style=\"font-family:'Oracle Sans'; font-size:14px; margin:12px 0;\">\n      If you want to inquire about any other asset, kindly enter the asset number. For example:\n      <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-top:6px;\">\n        \"show me list of assets that ends with [search string] in [book name] book\"\n      </div>\n    </div>\n\n    ${helpHtml}\n  </div>\n</div>`;\n} else if (intentName === \"DISTRIBUTION_DETAILS\") {\n  const distRecords = assetDistDetails;\n\n  let rowsHtml = \"\";\n\n  for (let i = 0; i < distRecords.length; i++) {\n    const row = distRecords[i] || {};\n\n    const assetNumber = resolveAssetNumber(getValue(row, \"ASSETNUMBER\"));\n    const locationID = getValue(row, \"LOCATIONCONCATENATEDSEGMENT\");\n    const CCID = getValue(row, \"CONCATENATEDSEGMENTS\");\n    const unitsAssigned = getValue(row, \"UNITSASSIGNED\");\n    const distID = getValue(row, \"DISTRIBUTIONID\");\n\n    rowsHtml += `<tr style=\"background-color:#ffffff;\">\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${assetNumber}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${distID}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${unitsAssigned}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${locationID}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${CCID}</td>\n    </tr>`;\n  }\n\n  assetHtml = `\n<div style=\"background:#f9fafb; padding:12px 16px;\">\n  <div style=\"font-family:'Oracle Sans'; margin-bottom:10px;\">\n    <div style=\"font-size:16px;font-weight:500; margin-bottom:4px;\">\n      <br>\n      <b>Distribution Details as requested</b>\n    </div>\n    <br>\n    <div style=\"font-size:14px;\">\n      ${generalHeaderHtml()}\n    </div>\n  </div>\n  <br>\n\n  <div style=\"width:100%; max-width:100%; border:1px solid #d6d9dc; overflow:hidden;\">\n    <table style=\"width:100%; border-collapse:collapse; table-layout:fixed; font-size:14px;\">\n      <colgroup>\n        <col style=\"width:20%;\">\n        <col style=\"width:20%;\">\n        <col style=\"width:20%;\">\n        <col style=\"width:20%;\">\n        <col style=\"width:20%;\">\n      </colgroup>\n      <thead style=\"background-color:#f3f4f6;\">\n        <tr>\n          <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left; vertical-align:middle; white-space:normal;\">Asset Number</th>\n          <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left; vertical-align:middle; white-space:normal;\">Distribution Id</th>\n          <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left; vertical-align:middle; white-space:normal;\">Units Assigned</th>\n          <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left; vertical-align:middle; white-space:normal;\">Location</th>\n          <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left; vertical-align:middle; white-space:normal;\">Expense Account</th>\n        </tr>\n      </thead>\n      <tbody>\n        ${rowsHtml}\n      </tbody>\n    </table>\n  </div>\n\n  <br>\n  <div style=\"font-family:'Oracle Sans'; font-size:14px; margin:12px 0;\"> \n    <div>Do you want more asset details? Enter an option below.</div>\n    <ul>\n      <li>General Details</li>\n      <li>Financial Details</li>\n      <li>Depreciation Details</li>\n    </ul>\n  </div>\n\n  <div style=\"font-family:'Oracle Sans'; font-size:14px; margin:12px 0;\">\n    If you want to inquire about any other asset, kindly enter the asset number. For example:\n    <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n      \"show me list of assets that ends with [search string] in [book name] book\"\n    </div>\n  </div>\n\n  ${helpHtml}\n</div>`;\n} else if (intentName === \"NBV_DETAILS\") {\n\n  const deprnRecords = assetDeprnDetails;\n\n  const monthMap = {\n    jan: 0, feb: 1, mar: 2, apr: 3, may: 4, jun: 5,\n    jul: 6, aug: 7, sep: 8, oct: 9, nov: 10, dec: 11\n  };\n\n  function toNumberSafe(value) {\n    if (value === undefined || value === null || value === \"\") return 0;\n\n    const num = Number(String(value).replace(/,/g, \"\"));\n    return isNaN(num) ? 0 : num;\n  }\n\n  const sortedDeprnRecords = [...deprnRecords].sort((a, b) => {\n    const [aMon, aYr] = String(getValue(a, \"PERIODNAME\")).toLowerCase().split(\"-\");\n    const [bMon, bYr] = String(getValue(b, \"PERIODNAME\")).toLowerCase().split(\"-\");\n\n    const aDate = new Date(2000 + Number(aYr), monthMap[aMon]);\n    const bDate = new Date(2000 + Number(bYr), monthMap[bMon]);\n\n    return bDate - aDate;\n  });\n\n  const latestRecord = sortedDeprnRecords[0] || {};\n\n  const assetNumber = resolveAssetNumber(getValue(latestRecord, \"ASSETNUMBER\"));\n  const periodName = getValue(latestRecord, \"PERIODNAME\");\n\n  const cost = toNumberSafe(getValue(latestRecord, \"COST\"));\n  const deprnReserve = toNumberSafe(getValue(latestRecord, \"DEPRECIATIONRESERVE\"));\n  const bonusDeprnReserve = toNumberSafe(getValue(latestRecord, \"BONUSDEPRECIATIONRESERVE\"));\n\n  const nbv = cost - deprnReserve - bonusDeprnReserve;\n\n  assetHtml = `\n<div style=\"background:#f9fafb; padding:12px 16px;\">\n\n  <div style=\"font-family:'Oracle Sans'; margin-bottom:10px;\">\n    <div style=\"font-size:16px; font-weight:500; margin-bottom:8px;\">\n      <br>\n      <b>NBV Details as requested</b>\n    </div>\n\n    <br>\n\n    <div style=\"font-size:14px;\">\n      ${generalHeaderHtml()}\n    </div>\n  </div>\n\n  <br>\n\n  <div style=\"width:100%; max-width:700px; border:1px solid #d6d9dc;\">\n    <table style=\"width:100%; border-collapse:collapse; font-size:14px;\">\n      <tbody>\n\n        <tr>\n          <td style=\"border:1px solid #d6d9dc; padding:8px; font-weight:bold; width:40%;\">\n            Asset Number\n          </td>\n          <td style=\"border:1px solid #d6d9dc; padding:8px;\">\n            ${normalize(assetNumber)}\n          </td>\n        </tr>\n\n        <tr>\n          <td style=\"border:1px solid #d6d9dc; padding:8px; font-weight:bold;\">\n            Cost\n          </td>\n          <td style=\"border:1px solid #d6d9dc; padding:8px; text-align:left;\">\n            ${formatCurrencyAmount(cost)}\n          </td>\n        </tr>\n\n        <tr>\n          <td style=\"border:1px solid #d6d9dc; padding:8px; font-weight:bold;\">\n            Depreciation Reserve\n          </td>\n          <td style=\"border:1px solid #d6d9dc; padding:8px; text-align:left;\">\n            ${formatCurrencyAmount(deprnReserve)}\n          </td>\n        </tr>\n\n        <tr>\n          <td style=\"border:1px solid #d6d9dc; padding:8px; font-weight:bold;\">\n            Bonus Depreciation Reserve\n          </td>\n          <td style=\"border:1px solid #d6d9dc; padding:8px; text-align:left;\">\n            ${formatCurrencyAmount(bonusDeprnReserve)}\n          </td>\n        </tr>\n\n        <tr style=\"background-color:#f3f4f6;\">\n          <td style=\"border:1px solid #d6d9dc; padding:8px; font-weight:bold;\">\n            Net Book Value (NBV)\n          </td>\n          <td style=\"border:1px solid #d6d9dc; padding:8px; text-align:left; font-weight:bold;\">\n            ${formatCurrencyAmount(nbv)}\n          </td>\n        </tr>\n\n      </tbody>\n    </table>\n  </div>\n\n  <br>\n\n  <div style=\"font-family:'Oracle Sans'; font-size:14px; margin:12px 0;\">\n    <div>Do you want more asset details? Enter an option below.</div>\n    <ul>\n      <li>General Details</li>\n      <li>Financial Details</li>\n      <li>Depreciation Details</li>\n      <li>Distribution Details</li>\n    </ul>\n  </div>\n\n  <div style=\"font-family:'Oracle Sans'; font-size:14px; margin:12px 0;\">\n    If you want to inquire about any other asset, kindly enter the asset number. For example:\n    <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n      \"show me list of assets that ends with [search string] in [book name] book\"\n    </div>\n  </div>\n\n  ${helpHtml}\n\n</div>`;\n}\nreturn assetHtml;"
          },
          "outcomes": {
            "success": "1776947970872"
          },
          "code": "SINGLE_ASSET_EXTRACTOR",
          "id": "1776182566306",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
