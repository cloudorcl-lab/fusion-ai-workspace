        {
          "metadata": {
            "name": "DisplayFinancialTransDetails",
            "returnType": "string",
            "sourceCode": "function getRecords(source) {\n  if (source === undefined || source === null) return [];\n\n  if (typeof source === \"string\") {\n    try {\n      source = JSON.parse(source);\n    } catch (e) {\n      return [];\n    }\n  }\n\n  if (Array.isArray(source)) return source;\n\n  let response =\n    source?.output?.response ??\n    source?.response ??\n    source?.output ??\n    source;\n\n  if (typeof response === \"string\") {\n    try {\n      response = JSON.parse(response);\n    } catch (e) {\n      return [];\n    }\n  }\n\n  if (Array.isArray(response)) return response;\n  if (Array.isArray(response?.items)) return response.items;\n  if (Array.isArray(response?.records)) return response.records;\n  if (Array.isArray(response?.rows)) return response.rows;\n\n  return [];\n}\n\nfunction normalize(value) {\n  if (value === undefined || value === null) return \"-\";\n  const str = String(value).trim();\n  return str === \"\" || str === \"NA\" ? \"-\" : str;\n}\n\nfunction getValue(row, ...keys) {\n  for (const key of keys) {\n    const value = row?.[key] ?? row?.[String(key).toUpperCase()];\n    if (value !== undefined && value !== null && String(value).trim() !== \"\") {\n      return value;\n    }\n  }\n  return \"NA\";\n}\n\nfunction escapeHtml(value) {\n  return normalize(value)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\");\n}\n\nfunction makeCamelCasing(str) {\n  if (str === null || str === \"CIP\") return str;\n  if (!str || String(str).trim() === \"\") return \"NA\";\n\n  return String(str)\n    .replace(/_/g, \" \")\n    .toLowerCase()\n    .replace(/\\b\\w/g, ch => ch.toUpperCase());\n}\n\nfunction toYesNo(value) {\n  const normalized = String(value ?? \"\").trim().toUpperCase();\n  if ([\"Y\", \"YES\", \"TRUE\", \"1\"].includes(normalized)) return \"Yes\";\n  if ([\"N\", \"NO\", \"FALSE\", \"0\"].includes(normalized)) return \"No\";\n  return normalize(value);\n}\n\nconst prefs = $context.$variables.currencyFormatDetails || {};\nconst bookDetails = getRecords($context.$variables.bookDetails?.output?.response);\nconst bookRecord = bookDetails[0] || {};\nconst chatCounter = Number($context.$variables.FaInqChatCounter ?? 0);\n\nconst helpHtml =\n  chatCounter <= 2\n    ? `<div style=\"font-family:'Oracle Sans'; font-size:12px; margin-top:6px;\">Type 'HELP' to know about my capabilities.</div>`\n    : \"\";\n\nconst assetFinancialTransDetails = getRecords(\n  $context.$variables.assetFinancialTransDetails\n);\n\nconst transactionRecord = assetFinancialTransDetails[0] || {};\n\nconst transactionTypeCodeRaw = normalize(\n  $context.$nodes.EXTRACTTRANSTYPECODE.$output.result.transactionTypeCode\n);\nconst transactionTypeCode = transactionTypeCodeRaw.toUpperCase();\n\nconst isAdjustmentTransaction = transactionTypeCode.includes(\"ADJUST\");\nconst isAdditionTransaction = transactionTypeCode.includes(\"ADD\");\n\nfunction formatDateTime(value) {\n  if (value === undefined || value === null || String(value).trim() === \"\") {\n    return \"NA\";\n  }\n\n  const date = new Date(value);\n  if (isNaN(date.getTime())) return normalize(value);\n\n  const format = String(prefs.DateFormat || \"M/d/yy\");\n  const pad2 = n => String(n).padStart(2, \"0\");\n\n  const day = date.getDate();\n  const month = date.getMonth() + 1;\n  const year = date.getFullYear();\n  const yy = String(year).slice(-2);\n\n  const tokens = {\n    yyyy: String(year),\n    yy,\n    MMMM: date.toLocaleString(\"en-GB\", { month: \"long\" }),\n    MMM: date.toLocaleString(\"en-GB\", { month: \"short\" }),\n    MM: pad2(month),\n    M: String(month),\n    dd: pad2(day),\n    d: String(day)\n  };\n\n  return format.replace(/yyyy|yy|MMMM|MMM|MM|M|dd|d/g, match => tokens[match] ?? match);\n}\n\nfunction formatAmount(amount, groupingSeparator, decimalSeparator, precision) {\n  if (amount === undefined || amount === null || amount === \"\") return \"NA\";\n\n  const numericAmount = Number(String(amount).replace(/,/g, \"\"));\n  if (isNaN(numericAmount)) return String(amount);\n\n  const isNegative = numericAmount < 0;\n  const fixed = Math.abs(numericAmount).toFixed(precision);\n  let [integerPart, decimalPart] = fixed.split(\".\");\n\n  integerPart = integerPart.replace(/\\B(?=(\\d{3})+(?!\\d))/g, groupingSeparator);\n\n  const formatted = decimalPart ? integerPart + decimalSeparator + decimalPart : integerPart;\n  return (isNegative ? \"-\" : \"\") + formatted;\n}\n\nfunction formatCurrencyAmount(amount) {\n  return formatAmount(\n    amount,\n    prefs.groupingSeparator || \",\",\n    prefs.decimalSeparator || \".\",\n    prefs.precision ?? 2\n  );\n}\n\nfunction formatNumber(value) {\n  return formatAmount(\n    value,\n    prefs.groupingSeparator || \",\",\n    prefs.decimalSeparator || \".\",\n    prefs.precision ?? 2\n  );\n}\n\nfunction summaryValue(primaryKey, bookKey) {\n  const transactionValue = getValue(transactionRecord, primaryKey);\n  return normalize(transactionValue !== \"NA\" ? transactionValue : getValue(bookRecord, bookKey));\n}\n\nfunction renderSummaryItem(label, value) {\n  return `\n    <div style=\"display:flex; gap:6px; white-space:nowrap; align-items:baseline;\">\n      <strong>${escapeHtml(label)}</strong><span>${escapeHtml(value)}</span>\n    </div>`;\n}\n\nfunction renderBookLedgerSummary() {\n  const bookName = summaryValue(\"bookName\", \"BOOKNAME\");\n  const periodName = normalize(getValue(bookRecord, \"PERIODNAME\", \"periodName\"));\n  const ledgerName = summaryValue(\"ledgerName\", \"LEDGERNAME\");\n  const currencyCode = summaryValue(\"currencyCode\", \"CURRENCYCODE\");\n\n  return `\n    <div style=\"display:flex; justify-content:flex-start; align-items:flex-start; gap:225px; flex-wrap:wrap; max-width:760px; width:100%; margin-bottom:14px;\">\n      <div style=\"display:flex; flex-direction:column; gap:6px; min-width:220px;\">\n        ${renderSummaryItem(\"Book\", bookName)}\n        ${renderSummaryItem(\"Open Period\", periodName)}\n      </div>\n      <div style=\"display:flex; flex-direction:column; gap:6px; min-width:260px; align-items:flex-start;\">\n        ${renderSummaryItem(\"Ledger Name\", ledgerName)}\n        ${renderSummaryItem(\"Ledger Currency\", currencyCode)}\n      </div>\n    </div>`;\n}\n\nfunction renderAssetTransactionSummary() {\n  const assetNumber = getValue(transactionRecord, \"assetNumber\");\n  const assetDescription = getValue(transactionRecord, \"assetDescription\");\n  const transactionHeaderId = getValue(transactionRecord, \"transactionHeaderId\");\n  const transactionType = makeCamelCasing(transactionTypeCodeRaw);\n  const transactionDate = formatDateTime(getValue(transactionRecord, \"transactionDate\"));\n  const comments = getValue(transactionRecord, \"comments\");\n\n  return `\n    <div style=\"display:flex; justify-content:flex-start; align-items:flex-start; gap:225px; flex-wrap:wrap; max-width:760px; width:100%; margin-bottom:14px;\">\n      <div style=\"display:flex; flex-direction:column; gap:6px; min-width:220px;\">\n        ${renderSummaryItem(\"Asset Number\", assetNumber)}\n        ${renderSummaryItem(\"Asset Description\", assetDescription)}\n        ${renderSummaryItem(\"Transaction Number\", transactionHeaderId)}\n      </div>\n      <div style=\"display:flex; flex-direction:column; gap:6px; min-width:260px; align-items:flex-start;\">\n        ${renderSummaryItem(\"Transaction Type\", transactionType)}\n        ${renderSummaryItem(\"Transaction Date\", transactionDate)}\n        ${comments !== \"NA\" ? renderSummaryItem(\"Comments\", comments) : \"\"}\n      </div>\n    </div>`;\n}\n\nfunction getPrefixedValue(prefix, key) {\n  return getValue(\n    transactionRecord,\n    `${prefix}${key}`,\n    `${prefix}_${key}`,\n    `${prefix.toUpperCase()}${key.toUpperCase()}`,\n    `${prefix.toUpperCase()}_${key.toUpperCase()}`,\n    key,\n    key.toUpperCase()\n  );\n}\n\nfunction renderComparisonTable() {\n  const columns = [\n    [\"Date Placed in Service\", \"DatePlacedInService\", formatDateTime],\n    [\"Prorate Date\", \"ProrateDate\", formatDateTime],\n    [\"Cost\", \"Cost\", formatCurrencyAmount],\n    [\"Depreciable Basis Amount\", \"AdjustedCost\", formatCurrencyAmount],\n    [\"Salvage Amount\", \"SalvageValueAmount\", formatCurrencyAmount],\n    [\"Salvage Percent\", \"SalvageValuePercent\", formatNumber],\n    [\"Depreciate\", \"DepreciateFlag\", toYesNo],\n    [\"Depreciation Method \", \"DepreciationMethodCode\", normalize],\n    [\"Method Type\", \"MethodType\", makeCamelCasing],\n    [\"Life In Months\", \"LifeInMonths\", normalize]\n    // [\"Active Flag\", \"ActiveFlag\", toYesNo]\n  ];\n\n  const detailTitle = isAdditionTransaction\n    ? \"Addition Details\"\n    : isAdjustmentTransaction\n      ? \"Adjustment Details\"\n      : \"Transaction Details\";\n\n  const rowsToRender = isAdditionTransaction\n    ? [[\"\", \"current\"]]\n    : [\n        [\"Current Record\", \"current\"],\n        [\"Previous Record\", \"prior\"]\n      ];\n\n  function renderHeader() {\n    return columns\n      .map(([label]) => `<th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left; white-space:nowrap;\">${escapeHtml(label)}</th>`)\n      .join(\"\");\n  }\n\n  function renderRow(rowLabel, prefix) {\n    const rowLabelCell = isAdditionTransaction\n      ? \"\"\n      : `\n        <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left; font-weight:600; background:#f3f4f6; white-space:nowrap;\">\n          ${escapeHtml(rowLabel)}\n        </td>`;\n\n    const cells = columns\n      .map(([, key, formatter]) => {\n        const value = getPrefixedValue(prefix, key);\n        const displayValue = formatter ? formatter(value) : normalize(value);\n        const textAlign = [\"Cost\", \"AdjustedCost\", \"SalvageValueAmount\"].includes(key) ? \"right\" : \"left\";\n\n        return `<td style=\"border:1px solid #d6d9dc; padding:6px; text-align:${textAlign}; white-space:nowrap;\">${escapeHtml(displayValue)}</td>`;\n      })\n      .join(\"\");\n\n    return `\n      <tr>\n        ${rowLabelCell}\n        ${cells}\n      </tr>`;\n  }\n\n  return `\n    <div style=\"margin-top:14px;\">\n      <div style=\"font-size:15px; font-weight:600; margin-bottom:6px;\">\n        ${escapeHtml(detailTitle)}\n      </div>\n\n      <div style=\"width:100%; overflow-x:auto;\">\n        <table style=\"\n          width:max-content;\n          min-width:100%;\n          border-collapse:collapse;\n          border:1px solid #d9d9d9;\n          font-size:14px;\n          box-sizing:border-box;\n        \">\n          <thead style=\"background-color:#f3f4f6;\">\n            <tr style=\"font-size:12px;\">\n              ${isAdditionTransaction ? \"\" : `<th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left; white-space:nowrap;\">Record Type</th>`}\n              ${renderHeader()}\n            </tr>\n          </thead>\n          <tbody>\n            ${rowsToRender.map(([rowLabel, prefix]) => renderRow(rowLabel, prefix)).join(\"\")}\n          </tbody>\n        </table>\n      </div>\n    </div>`;\n}\n\nfunction renderFollowUpSection() {\n  return `\n    <div style=\"margin-top:10px; margin-bottom:8px;\">\n        If you would like to see any specific transaction details for this book, type:\n        <span style=\"font-size:11px; padding:4px 6px; border:1px solid #d1d5db; background:#f9fafb;\">\n          \"show me transaction details for [transaction number]\"\n        </span>\n      </div>\n    ${helpHtml}`;\n}\n\nlet assetHtml = \"\";\n\nif (!transactionRecord || Object.keys(transactionRecord).length === 0) {\n  assetHtml = `<div style=\"font-family:'Oracle Sans'; margin-bottom:10px; background:#f9fafb; padding:12px 16px;\">\n    <br>\n    <div style=\"font-size:14px; font-weight:400;\">\n      No transaction details are available to display. Please change your search criteria and try again.\n    </div>\n    <br>\n    ${renderFollowUpSection()}\n  </div>`;\n} else {\n  assetHtml = `<div style=\"background:#f9fafb; padding:12px 16px;\">\n    <div style=\"font-family:'Oracle Sans'; font-size:14px; width:100%;\">\n      <div style=\"font-size:16px; font-weight:600; margin-bottom:8px;\">\n        Here is the detailed information of the transaction record\n      </div>\n\n      ${renderBookLedgerSummary()}\n      ${renderAssetTransactionSummary()}\n      ${renderComparisonTable()}\n      ${renderFollowUpSection()}\n    </div>\n  </div>`;\n}\n\nreturn assetHtml;"
          },
          "outcomes": {
            "success": "1783327338220"
          },
          "code": "DISPLAYFINANCIALTRANSDETAILS",
          "convergenceTargetId": "1783325287877",
          "id": "1781788067996",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "returnForAddAdjTrans"
