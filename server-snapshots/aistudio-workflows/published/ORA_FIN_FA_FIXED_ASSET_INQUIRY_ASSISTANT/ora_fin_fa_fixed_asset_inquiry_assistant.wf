            "name": "prepareFinancialTransactionDetails",
            "returnType": "object",
            "sourceCode": "const bookNameVar = $context.$variables.bookTypeCode;\nconst transNumber = $context.$nodes.FETCHTRANSACTIONNUMFROMUSERINPUT.$output.transactionNumber;\n\nconst payload = {\n  viewQueries: {\n    financialTransaction: {\n      module: \"oraErpCoreFixedAssets\",\n      businessObject: \"AssetTransaction\",\n      view: \"financialTransactionDetail\",\n      fieldAliases: {\n        \"asset.assetNumber\": \"assetNumber\",\n        \"asset.assetId\": \"assetId\",\n        \"asset.description\": \"assetDescription\",\n        transactionHeaderId: \"transactionHeaderId\",\n        bookName: \"bookName\",\n        transactionDate: \"transactionDate\",\n        transactionTypeCode: \"transactionTypeCode\",\n        comments: \"comments\",\n        \"assetBook.name\": \"assetBookName\",\n        \"assetBook.ledger.name\": \"ledgerName\",\n        \"assetBook.ledger.currency.currencyCode\": \"currencyCode\",\n\n        \"priorFinancialTransaction.creatingTransactionId\": \"priorCreatingTransactionId\",\n        \"priorFinancialTransaction.terminatingTransactionId\": \"priorTerminatingTransactionId\",\n        \"priorFinancialTransaction.bookName\": \"priorBookName\",\n        \"priorFinancialTransaction.assetId\": \"priorAssetId\",\n        \"priorFinancialTransaction.datePlacedInService\": \"priorDatePlacedInService\",\n        \"priorFinancialTransaction.prorateDate\": \"priorProrateDate\",\n        \"priorFinancialTransaction.depreciationStartDate\": \"priorDepreciationStartDate\",\n        \"priorFinancialTransaction.effectiveDate\": \"priorEffectiveDate\",\n        \"priorFinancialTransaction.ineffectiveDate\": \"priorIneffectiveDate\",\n        \"priorFinancialTransaction.cost\": \"priorCost\",\n        \"priorFinancialTransaction.originalCost\": \"priorOriginalCost\",\n        \"priorFinancialTransaction.adjustedCost\": \"priorAdjustedCost\",\n        \"priorFinancialTransaction.recoverableCost\": \"priorRecoverableCost\",\n        \"priorFinancialTransaction.adjustedRecoverableCost\": \"priorAdjustedRecoverableCost\",\n        \"priorFinancialTransaction.assetOldAdjustedCost\": \"priorAssetOldAdjustedCost\",\n        \"priorFinancialTransaction.cipCost\": \"priorCipCost\",\n        \"priorFinancialTransaction.revaluedCost\": \"priorRevaluedCost\",\n        \"priorFinancialTransaction.historicalCost\": \"priorHistoricalCost\",\n        \"priorFinancialTransaction.fairValue\": \"priorFairValue\",\n        \"priorFinancialTransaction.revaluationAmortizationBasis\": \"priorRevaluationAmortizationBasis\",\n        \"priorFinancialTransaction.revaluationCostCeiling\": \"priorRevaluationCostCeiling\",\n        \"priorFinancialTransaction.adjustedCostAtTheEndOfFiscalYear\": \"priorAdjustedCostAtFiscalYearEnd\",\n        \"priorFinancialTransaction.periodEndAdjustedCost\": \"priorPeriodEndAdjustedCost\",\n        \"priorFinancialTransaction.salvageValueAmount\": \"priorSalvageValueAmount\",\n        \"priorFinancialTransaction.salvageValuePercent\": \"priorSalvageValuePercent\",\n        \"priorFinancialTransaction.salvageType\": \"priorSalvageType\",\n        \"priorFinancialTransaction.depreciationLimitType\": \"priorDepreciationLimitType\",\n        \"priorFinancialTransaction.depreciationLimitPercent\": \"priorDepreciationLimitPercent\",\n        \"priorFinancialTransaction.depreciationLimitAmount\": \"priorDepreciationLimitAmount\",\n        \"priorFinancialTransaction.priorDepreciationLimitAmount\": \"priorSnapshotPriorDepreciationLimitAmount\",\n        \"priorFinancialTransaction.priorYearDepreciationReserve\": \"priorYearDepreciationReserve\",\n        \"priorFinancialTransaction.priorYearDepreciationReserveBeforeTransaction\": \"priorYearDepreciationReserveBeforeTxn\",\n        \"priorFinancialTransaction.priorYearRevaluationReserve\": \"priorYearRevaluationReserve\",\n        \"priorFinancialTransaction.priorYearRevaluationReserveBeforeTransaction\": \"priorYearRevaluationReserveBeforeTxn\",\n        \"priorFinancialTransaction.bonusAdjustedCost\": \"priorBonusAdjustedCost\",\n        \"priorFinancialTransaction.ytdSaleProceeds\": \"priorYtdSaleProceeds\",\n        \"priorFinancialTransaction.lifeToDateSaleProceeds\": \"priorLifeToDateSaleProceeds\",\n        \"priorFinancialTransaction.lifeToDateCostOfRemoval\": \"priorLifeToDateCostOfRemoval\",\n        \"priorFinancialTransaction.terminalGainOrLossAmount\": \"priorTerminalGainOrLossAmount\",\n        \"priorFinancialTransaction.capitalizeFlag\": \"priorCapitalizeFlag\",\n        \"priorFinancialTransaction.depreciateFlag\": \"priorDepreciateFlag\",\n        \"priorFinancialTransaction.activeFlag\": \"priorActiveFlag\",\n        \"priorFinancialTransaction.productionCapacity\": \"priorProductionCapacity\",\n        \"priorFinancialTransaction.adjustedCapacity\": \"priorAdjustedCapacity\",\n        \"priorFinancialTransaction.unitOfMeasure\": \"priorUnitOfMeasure\",\n        \"priorFinancialTransaction.depreciationRateInUse\": \"priorDepreciationRateInUse\",\n        \"priorFinancialTransaction.nbvAtSwitch\": \"priorNbvAtSwitch\",\n        \"priorFinancialTransaction.remainingLifeFromInServiceDate\": \"priorRemainingLifeFromInServiceDate\",\n        \"priorFinancialTransaction.remainingLifeFromProrateDate\": \"priorRemainingLifeFromProrateDate\",\n        \"priorFinancialTransaction.depreciationMethod.methodCode\": \"priorDepreciationMethodCode\",\n        \"priorFinancialTransaction.depreciationMethod.methodType\": \"priorMethodType\",\n        \"priorFinancialTransaction.depreciationMethod.lifeInMonths\": \"priorLifeInMonths\",\n\n        \"currentFinancialTransaction.creatingTransactionId\": \"currentCreatingTransactionId\",\n        \"currentFinancialTransaction.terminatingTransactionId\": \"currentTerminatingTransactionId\",\n        \"currentFinancialTransaction.bookName\": \"currentBookName\",\n        \"currentFinancialTransaction.assetId\": \"currentAssetId\",\n        \"currentFinancialTransaction.datePlacedInService\": \"currentDatePlacedInService\",\n        \"currentFinancialTransaction.prorateDate\": \"currentProrateDate\",\n        \"currentFinancialTransaction.depreciationStartDate\": \"currentDepreciationStartDate\",\n        \"currentFinancialTransaction.effectiveDate\": \"currentEffectiveDate\",\n        \"currentFinancialTransaction.ineffectiveDate\": \"currentIneffectiveDate\",\n        \"currentFinancialTransaction.cost\": \"currentCost\",\n        \"currentFinancialTransaction.originalCost\": \"currentOriginalCost\",\n        \"currentFinancialTransaction.adjustedCost\": \"currentAdjustedCost\",\n        \"currentFinancialTransaction.recoverableCost\": \"currentRecoverableCost\",\n        \"currentFinancialTransaction.adjustedRecoverableCost\": \"currentAdjustedRecoverableCost\",\n        \"currentFinancialTransaction.assetOldAdjustedCost\": \"currentAssetOldAdjustedCost\",\n        \"currentFinancialTransaction.cipCost\": \"currentCipCost\",\n        \"currentFinancialTransaction.revaluedCost\": \"currentRevaluedCost\",\n        \"currentFinancialTransaction.historicalCost\": \"currentHistoricalCost\",\n        \"currentFinancialTransaction.fairValue\": \"currentFairValue\",\n        \"currentFinancialTransaction.revaluationAmortizationBasis\": \"currentRevaluationAmortizationBasis\",\n        \"currentFinancialTransaction.revaluationCostCeiling\": \"currentRevaluationCostCeiling\",\n        \"currentFinancialTransaction.adjustedCostAtTheEndOfFiscalYear\": \"currentAdjustedCostAtFiscalYearEnd\",\n        \"currentFinancialTransaction.periodEndAdjustedCost\": \"currentPeriodEndAdjustedCost\",\n        \"currentFinancialTransaction.salvageValueAmount\": \"currentSalvageValueAmount\",\n        \"currentFinancialTransaction.salvageValuePercent\": \"currentSalvageValuePercent\",\n        \"currentFinancialTransaction.salvageType\": \"currentSalvageType\",\n        \"currentFinancialTransaction.depreciationLimitType\": \"currentDepreciationLimitType\",\n        \"currentFinancialTransaction.depreciationLimitPercent\": \"currentDepreciationLimitPercent\",\n        \"currentFinancialTransaction.depreciationLimitAmount\": \"currentDepreciationLimitAmount\",\n        \"currentFinancialTransaction.priorDepreciationLimitAmount\": \"currentSnapshotPriorDepreciationLimitAmount\",\n        \"currentFinancialTransaction.priorYearDepreciationReserve\": \"currentPriorYearDepreciationReserve\",\n        \"currentFinancialTransaction.priorYearDepreciationReserveBeforeTransaction\": \"currentPriorYearDepreciationReserveBeforeTxn\",\n        \"currentFinancialTransaction.priorYearRevaluationReserve\": \"currentPriorYearRevaluationReserve\",\n        \"currentFinancialTransaction.priorYearRevaluationReserveBeforeTransaction\": \"currentPriorYearRevaluationReserveBeforeTxn\",\n        \"currentFinancialTransaction.bonusAdjustedCost\": \"currentBonusAdjustedCost\",\n        \"currentFinancialTransaction.ytdSaleProceeds\": \"currentYtdSaleProceeds\",\n        \"currentFinancialTransaction.lifeToDateSaleProceeds\": \"currentLifeToDateSaleProceeds\",\n        \"currentFinancialTransaction.lifeToDateCostOfRemoval\": \"currentLifeToDateCostOfRemoval\",\n        \"currentFinancialTransaction.terminalGainOrLossAmount\": \"currentTerminalGainOrLossAmount\",\n        \"currentFinancialTransaction.capitalizeFlag\": \"currentCapitalizeFlag\",\n        \"currentFinancialTransaction.depreciateFlag\": \"currentDepreciateFlag\",\n        \"currentFinancialTransaction.activeFlag\": \"currentActiveFlag\",\n        \"currentFinancialTransaction.productionCapacity\": \"currentProductionCapacity\",\n        \"currentFinancialTransaction.adjustedCapacity\": \"currentAdjustedCapacity\",\n        \"currentFinancialTransaction.unitOfMeasure\": \"currentUnitOfMeasure\",\n        \"currentFinancialTransaction.depreciationRateInUse\": \"currentDepreciationRateInUse\",\n        \"currentFinancialTransaction.nbvAtSwitch\": \"currentNbvAtSwitch\",\n        \"currentFinancialTransaction.remainingLifeFromInServiceDate\": \"currentRemainingLifeFromInServiceDate\",\n        \"currentFinancialTransaction.remainingLifeFromProrateDate\": \"currentRemainingLifeFromProrateDate\",\n        \"currentFinancialTransaction.depreciationMethod.methodCode\": \"currentDepreciationMethodCode\",\n        \"currentFinancialTransaction.depreciationMethod.methodType\": \"currentMethodType\",\n        \"currentFinancialTransaction.depreciationMethod.lifeInMonths\": \"currentLifeInMonths\"\n      }\n    }\n  },\n\n  select: `\n    SELECT\n      assetNumber,\n      assetId,\n      assetDescription,\n      transactionHeaderId,\n      bookName,\n      transactionDate,\n      transactionTypeCode,\n      comments,\n      assetBookName,\n      ledgerName,\n      currencyCode,\n\n      priorCreatingTransactionId,\n      priorTerminatingTransactionId,\n      priorBookName,\n      priorAssetId,\n      priorDatePlacedInService,\n      priorProrateDate,\n      priorDepreciationStartDate,\n      priorEffectiveDate,\n      priorIneffectiveDate,\n      priorCost,\n      priorOriginalCost,\n      priorAdjustedCost,\n      priorRecoverableCost,\n      priorAdjustedRecoverableCost,\n      priorAssetOldAdjustedCost,\n      priorCipCost,\n      priorRevaluedCost,\n      priorHistoricalCost,\n      priorFairValue,\n      priorRevaluationAmortizationBasis,\n      priorRevaluationCostCeiling,\n      priorAdjustedCostAtFiscalYearEnd,\n      priorPeriodEndAdjustedCost,\n      priorSalvageValueAmount,\n      priorSalvageValuePercent,\n      priorSalvageType,\n      priorDepreciationLimitType,\n      priorDepreciationLimitPercent,\n      priorDepreciationLimitAmount,\n      priorSnapshotPriorDepreciationLimitAmount,\n      priorYearDepreciationReserve,\n      priorYearDepreciationReserveBeforeTxn,\n      priorYearRevaluationReserve,\n      priorYearRevaluationReserveBeforeTxn,\n      priorBonusAdjustedCost,\n      priorYtdSaleProceeds,\n      priorLifeToDateSaleProceeds,\n      priorLifeToDateCostOfRemoval,\n      priorTerminalGainOrLossAmount,\n      priorCapitalizeFlag,\n      priorDepreciateFlag,\n      priorActiveFlag,\n      priorProductionCapacity,\n      priorAdjustedCapacity,\n      priorUnitOfMeasure,\n      priorDepreciationRateInUse,\n      priorNbvAtSwitch,\n      priorRemainingLifeFromInServiceDate,\n      priorRemainingLifeFromProrateDate,\n      priorDepreciationMethodCode,\n      priorMethodType,\n      priorLifeInMonths,\n\n      currentCreatingTransactionId,\n      currentTerminatingTransactionId,\n      currentBookName,\n      currentAssetId,\n      currentDatePlacedInService,\n      currentProrateDate,\n      currentDepreciationStartDate,\n      currentEffectiveDate,\n      currentIneffectiveDate,\n      currentCost,\n      currentOriginalCost,\n      currentAdjustedCost,\n      currentRecoverableCost,\n      currentAdjustedRecoverableCost,\n      currentAssetOldAdjustedCost,\n      currentCipCost,\n      currentRevaluedCost,\n      currentHistoricalCost,\n      currentFairValue,\n      currentRevaluationAmortizationBasis,\n      currentRevaluationCostCeiling,\n      currentAdjustedCostAtFiscalYearEnd,\n      currentPeriodEndAdjustedCost,\n      currentSalvageValueAmount,\n      currentSalvageValuePercent,\n      currentSalvageType,\n      currentDepreciationLimitType,\n      currentDepreciationLimitPercent,\n      currentDepreciationLimitAmount,\n      currentSnapshotPriorDepreciationLimitAmount,\n      currentPriorYearDepreciationReserve,\n      currentPriorYearDepreciationReserveBeforeTxn,\n      currentPriorYearRevaluationReserve,\n      currentPriorYearRevaluationReserveBeforeTxn,\n      currentBonusAdjustedCost,\n      currentYtdSaleProceeds,\n      currentLifeToDateSaleProceeds,\n      currentLifeToDateCostOfRemoval,\n      currentTerminalGainOrLossAmount,\n      currentCapitalizeFlag,\n      currentDepreciateFlag,\n      currentActiveFlag,\n      currentProductionCapacity,\n      currentAdjustedCapacity,\n      currentUnitOfMeasure,\n      currentDepreciationRateInUse,\n      currentNbvAtSwitch,\n      currentRemainingLifeFromInServiceDate,\n      currentRemainingLifeFromProrateDate,\n      currentDepreciationMethodCode,\n      currentMethodType,\n      currentLifeInMonths\n    FROM financialTransaction\n    WHERE transactionHeaderId ='${transNumber}'\n    AND bookName ='${bookNameVar}'\n  `\n};\n\nreturn JSON.stringify(payload);"
          },
          "outcomes": {
            "success": "1781788340071"
          },
          "code": "PREPAREFINANCIALTRANSACTIONDETAILS",
          "convergenceTargetId": "1783325287877",
