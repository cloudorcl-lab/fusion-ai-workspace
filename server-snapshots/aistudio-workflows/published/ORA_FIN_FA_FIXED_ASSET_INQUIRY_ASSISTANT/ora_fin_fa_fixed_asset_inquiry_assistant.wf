        {
          "metadata": {
            "name": "Multiple Transaction Details Processor"
          },
          "outcomes": {
            "success": "1782976772352"
          },
          "code": "MULTPLE_TRANSACTION_DETAILS_PROCESSOR",
          "id": "1773126120157",
          "inputs": [
            {
              "id": "1773126120159_1",
              "name": "prompt",
              "type": "string",
              "value": "You are and intelligent agent DO as instructed :\n\n1. When {{$context.$nodes.INTENTCLASSIFIER.$output.requestType = 'LIST_TRANS'}}\n\n2. Then Assign transactionTypeCode : {{$context.$nodes.PROMPT_INPUT_PROCESSOR.$output.transactionTypeCode}}\n    - make the transactionTypeCode upper case always (like ADDITION, RETIREMENT, ADJUSTMENT, RETIREMENT, TRANSFER)\n   - one important rule - if transactionTypeCode contains \"recent\" word followed by transaction type code (addition, retirement, adjustment or transfer) then ignore the recent keyword. for example - \"recent retirement\" will be termed as \"retirement\", \"recent addition\" will be termed as \"addition\", \"recent transfer\" will be termed as \"transfer\", \"recent adjustment\" will be termed as \"adjustment\".\n- when user asks \"show me list of recent transactions\" then assign transactionTypeCode as LIST_TRANS\n\n3. Assign bookTypeCode : {{$context.$variables.bookTypeCode}} \n\nReturn the output clearly and concisely and as instructed.\n\noutput: \n{\n \"bookTypeCode\": <value>,\n \"transactionTypeCode\": <value or null>\n}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"transactionTypeCode\": {\n            \"type\": \"string\"\n        },\n        \"bookTypeCode\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Code For Transaction List",
            "returnType": "string",
            "sourceCode": "let parameterList = $context.$nodes.GETLISTTRANS.$output;\n\nconst bookTypeCode =\n  $context.$variables.bookTypeCode ||\n  $context.$nodes.BOOKACCESSCHECKER?.$output?.bookTypeCode ||\n  \"-\";\n\nconst transactionTypeCode =\n  $context.$nodes.MULTPLE_TRANSACTION_DETAILS_PROCESSOR?.$output?.transactionTypeCode ||\n  \"list_trans\";\n\nconst chatCounter = Number($context.$variables.FaInqChatCounter ?? 0);\n\nfunction getRecords(source) {\n  if (source === undefined || source === null) return [];\n\n  if (typeof source === \"string\") {\n    try {\n      source = JSON.parse(source);\n    } catch (e) {\n      return [];\n    }\n  }\n\n  if (Array.isArray(source)) return source;\n\n  let response =\n    source?.output?.response ??\n    source?.response ??\n    source?.output ??\n    source;\n\n  if (typeof response === \"string\") {\n    try {\n      response = JSON.parse(response);\n    } catch (e) {\n      return [];\n    }\n  }\n\n  if (Array.isArray(response)) return response;\n  if (Array.isArray(response?.items)) return response.items;\n  if (Array.isArray(response?.records)) return response.records;\n  if (Array.isArray(response?.rows)) return response.rows;\n\n  return [];\n}\n\nfunction normalize(value) {\n  if (value === undefined || value === null) return \"-\";\n\n  const str = String(value).trim();\n\n  if (str === \"\" || str.toUpperCase() === \"NA\") return \"-\";\n\n  return str;\n}\n\nfunction getValue(row, ...keys) {\n  for (const key of keys) {\n    const value = row?.[key] ?? row?.[String(key).toUpperCase()];\n    const normalizedValue = normalize(value);\n\n    if (normalizedValue !== \"-\") {\n      return normalizedValue;\n    }\n  }\n\n  return \"-\";\n}\n\nfunction escapeHtml(value) {\n  return normalize(value)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\");\n}\n\nfunction makeCamelCasing(value) {\n  const str = normalize(value);\n  if (str === \"-\") return \"-\";\n\n  return str\n    .replace(/_/g, \" \")\n    .toLowerCase()\n    .replace(/\\b\\w/g, ch => ch.toUpperCase());\n}\n\nfunction formatDate(value) {\n  if (value === undefined || value === null || String(value).trim() === \"\") {\n    return \"-\";\n  }\n\n  const date = new Date(value);\n  if (isNaN(date.getTime())) return normalize(value);\n\n  const day = String(date.getDate()).padStart(2, \"0\");\n  const month = String(date.getMonth() + 1).padStart(2, \"0\");\n  const year = date.getFullYear();\n\n  return `${month}/${day}/${year}`;\n}\n\nconst rows = getRecords(parameterList);\nconst bookDetails = getRecords($context.$variables.bookDetails?.output?.response);\nconst bookRecord = bookDetails[0] || {};\nconst firstRow = rows[0] || {};\n\nfunction summaryValue(rowKey, bookKey, fallback) {\n  const rowValue = getValue(firstRow, rowKey);\n  if (rowValue !== \"-\") return rowValue;\n\n  const bookValue = getValue(bookRecord, bookKey);\n  if (bookValue !== \"-\") return bookValue;\n\n  return normalize(fallback);\n}\n\nfunction leftSummaryBlock() {\n  return `\n    <div style=\"display:flex; flex-direction:column; gap:6px; min-width:220px;\">\n      <div style=\"display:flex; gap:6px; white-space:nowrap; align-items:baseline;\">\n        <strong>Book</strong><span>${escapeHtml(summaryValue(\"bookName\", \"BOOKNAME\", bookTypeCode))}</span>\n      </div>\n      <div style=\"display:flex; gap:6px; white-space:nowrap; align-items:baseline;\">\n        <strong>Period</strong><span>${escapeHtml(getValue(bookRecord, \"PERIODNAME\", \"periodName\"))}</span>\n      </div>\n    </div>`;\n}\n\nfunction rightSummaryBlockGeneral() {\n  return `\n    <div style=\"display:flex; flex-direction:column; gap:6px; min-width:260px; align-items:flex-start;\">\n      <div style=\"display:flex; gap:6px; white-space:nowrap; align-items:baseline;\">\n        <strong>Ledger Name</strong><span>${escapeHtml(summaryValue(\"ledgerName\", \"LEDGERNAME\"))}</span>\n      </div>\n      <div style=\"display:flex; gap:6px; white-space:nowrap; align-items:baseline;\">\n        <strong>Currency</strong><span>${escapeHtml(summaryValue(\"currencyCode\", \"CURRENCYCODE\"))}</span>\n      </div>\n    </div>`;\n}\n\nfunction generalHeaderHtml() {\n  return `\n    <div style=\"display:flex; justify-content:flex-start; align-items:flex-start; gap:72px; flex-wrap:wrap; max-width:760px; width:100%; margin-bottom:14px;\">\n      ${leftSummaryBlock()}\n      ${rightSummaryBlockGeneral()}\n    </div>`;\n}\n\nfunction getHeaderText() {\n  switch (transactionTypeCode) {\n    case \"ADDITION\":\n      return \"Recent Additions\";\n    case \"RETIREMENT\":\n      return \"Recent Retirements\";\n    case \"ADJUSTMENT\":\n      return \"Recent Adjustments\";\n    case \"TRANSFER\":\n      return \"Recent Transfers\";\n    case \"list_trans\":\n    default:\n      return \"Recent Transactions\";\n  }\n}\n\nconst helpHtml =\n  chatCounter <= 2\n    ? `<div style=\"font-family:'Oracle Sans'; font-size:12px; margin-top:8px;\">Type 'HELP' to know about my capabilities.</div>`\n    : \"\";\n\nlet assetHtml = \"\";\n\nif (!rows || rows.length === 0) {\n  assetHtml = `<div style=\"font-family:'Oracle Sans'; margin-bottom:10px; background:#f9fafb; padding:12px 16px;\">\n    <br>\n    <div style=\"font-size:14px; font-weight:400;\">\n      No transaction details are available to display. Please change your search criteria and try again.\n    </div>\n    <br>\n    ${helpHtml}\n  </div>`;\n} else {\n  let rowsHtml = \"\";\n\n  rows.forEach((row, index) => {\n    const isOdd = (index + 1) % 2 !== 0;\n\n    const assetNumber = getValue(row, \"assetNumber\");\n    const assetId = getValue(row, \"assetId\");\n    const transactionNumber = getValue(row, \"transactionHeaderId\");\n    const transactionType = makeCamelCasing(getValue(row, \"transactionTypeCode\"));\n    const effectiveDate = formatDate(getValue(row, \"effectiveDate\"));\n    const comments = getValue(row, \"comments\");\n\n    rowsHtml += `<tr style=\"background-color:${isOdd ? \"#ffffff\" : \"transparent\"};\">\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${index + 1}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${escapeHtml(assetNumber)}</td>\n      <!--<td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${escapeHtml(assetId)}</td>-->\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${escapeHtml(transactionNumber)}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${escapeHtml(transactionType)}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${escapeHtml(effectiveDate)}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${escapeHtml(comments)}</td>\n    </tr>`;\n  });\n\n  assetHtml = `<div style=\"background:#f9fafb; padding:12px 16px;\">\n    <div style=\"font-family:'Oracle Sans'; font-size:14px; width:100%;\">\n      <div style=\"font-size:16px; font-weight:600; margin-bottom:8px;\">\n        ${escapeHtml(getHeaderText())}\n      </div>\n\n      ${generalHeaderHtml()}\n\n      <div style=\"box-sizing:border-box; overflow-x:auto;\">\n        <table style=\"\n          width:100%;\n          border-collapse:collapse;\n          border:1px solid #d9d9d9;\n          table-layout:fixed;\n          font-size:14px;\n          box-sizing:border-box;\n        \">\n          <colgroup>\n            <col style=\"width:7%;\">\n            <col style=\"width:15%;\">\n            <!--<col style=\"width:13%;\">-->\n            <col style=\"width:18%;\">\n            <col style=\"width:20%;\">\n            <col style=\"width:20%;\">\n            <col style=\"width:20%;\">\n          </colgroup>\n          <thead style=\"background-color:#f3f4f6;\">\n            <tr style=\"font-size:12px;\">\n              <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Row</th>\n              <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Asset Number</th>\n              <!--<th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Asset ID</th>-->\n              <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Transaction Number</th>\n              <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Transaction Type</th>\n              <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:right;\">Effective Date</th>\n              <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Comments</th>\n            </tr>\n          </thead>\n          <tbody>\n            ${rowsHtml}\n          </tbody>\n        </table>\n      </div>\n\n<br>\n<div style=\"font-size:12px; color:#6b7280; margin-bottom:10px;\">\n  Note: As of now the supported transactions are Additions , Adjustments , Transfers and Retirements.\n</div>\n\n      <div style=\"margin-top:10px; margin-bottom:8px;\">\n        If you would like to see any specific transaction details for this book, type:\n        <span style=\"font-size:11px; padding:4px 6px; border:1px solid #d1d5db; background:#f9fafb;\">\n          \"show me transaction details for [transaction number]\"\n        </span>\n      </div>\n\n      ${helpHtml}\n    </div>\n  </div>`;\n}\n\nreturn assetHtml;"
          },
          "outcomes": {
            "success": "1776948136575"
          },
          "code": "CODE_FOR_TRANSACTION_LIST",
          "id": "1776683566596",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
