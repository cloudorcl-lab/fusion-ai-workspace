        {
          "metadata": {
            "name": "prepareTransferTransPayload",
            "returnType": "object",
            "sourceCode": "const headerAssetId = $context.$nodes.EXTRACTTRANSTYPECODE.$output.result.assetId;\nconst bookName = $context.$variables.bookTypeCode;\n\nconst payload = {\n  viewQueries: {\n    assignmentHeader: {\n      module: \"oraErpCoreFixedAssets\",\n      businessObject: \"AssetTransaction\",\n      view: \"assignmentTransactionDetail\",\n      fieldAliases: {\n        transactionHeaderId: \"headerTransactionHeaderId\",\n        bookName: \"headerBookName\",\n        transactionDate: \"headerTransactionDate\",\n        effectiveDate: \"headerEffectiveDate\",\n        transactionTypeCode: \"headerTransactionTypeCode\",\n        transactionSubtype: \"headerTransactionSubtype\",\n        transactionSource: \"headerTransactionSource\",\n        transactionGroup: \"headerTransactionGroup\",\n        comments: \"headerComments\",\n\n        \"asset.assetId\": \"headerAssetId\",\n        \"asset.assetNumber\": \"assetNumber\",\n        \"asset.description\": \"assetDescription\",\n\n        \"assetBook.name\": \"assetBookName\",\n        \"assetBook.ledger.name\": \"ledgerName\",\n        \"assetBook.ledger.currency.currencyCode\": \"currencyCode\"\n      }\n    },\n\n    assignmentDistribution: {\n      module: \"oraErpCoreFixedAssets\",\n      businessObject: \"AssetDistribution\",\n      view: \"assignmentDetail\",\n      fieldAliases: {\n        \"asset.assetId\": \"distributionAssetId\",\n\n        distributionId: \"distributionId\",\n        bookName: \"distributionBookName\",\n        unitsAssigned: \"unitsAssigned\",\n        transactionUnits: \"transactionUnits\",\n        effectiveDate: \"assignmentEffectiveDate\",\n        ineffectiveDate: \"assignmentIneffectiveDate\",\n        activeFlag: \"assignmentActiveFlag\",\n\n        \"location.locationConcatenatedSegment\": \"location\",\n        \"depreciationExpenseAccount.concatenatedSegments\": \"expenseAccount\",\n\n        \"person.personNumber\": \"personNumber\",\n        \"person.globalName.fullName\": \"employeeName\",\n\n        \"sourceTransaction.transactionHeaderId\": \"creatingTransactionHeaderId\",\n        \"sourceTransaction.transactionDate\": \"creatingTransactionDate\",\n        \"sourceTransaction.transactionTypeCode\": \"creatingTransactionTypeCode\",\n\n        \"terminatedTransaction.transactionHeaderId\": \"terminatingTransactionHeaderId\",\n        \"terminatedTransaction.transactionDate\": \"terminatingTransactionDate\",\n        \"terminatedTransaction.transactionTypeCode\": \"terminatingTransactionTypeCode\"\n      }\n    }\n  },\n\n  select: `\n    SELECT\n      assetNumber,\n      assetDescription,\n      headerTransactionHeaderId,\n      headerBookName,\n      headerTransactionDate,\n      headerEffectiveDate,\n      headerTransactionTypeCode,\n      headerTransactionSubtype,\n      headerTransactionSource,\n      headerTransactionGroup,\n      headerComments,\n      assetBookName,\n      ledgerName,\n      currencyCode,\n      distributionId,\n      unitsAssigned,\n      transactionUnits,\n      assignmentEffectiveDate,\n      assignmentIneffectiveDate,\n      assignmentActiveFlag,\n      location,\n      expenseAccount,\n      personNumber,\n      employeeName,\n      creatingTransactionHeaderId,\n      creatingTransactionDate,\n      creatingTransactionTypeCode,\n      terminatingTransactionHeaderId,\n      terminatingTransactionDate,\n      terminatingTransactionTypeCode\n    FROM assignmentHeader, assignmentDistribution\n    WHERE headerBookName = distributionBookName\n      AND headerAssetId = distributionAssetId\n      AND (\n        creatingTransactionHeaderId = headerTransactionHeaderId\n        OR terminatingTransactionHeaderId = headerTransactionHeaderId\n      )\n      AND headerAssetId = ${headerAssetId}\n      AND headerBookName = '${bookName}'\n      AND headerTransactionTypeCode = 'TRANSFER'\n    ORDER BY distributionId\n  `\n};\n\nreturn JSON.stringify(payload);"
          },
          "outcomes": {
            "success": "1783327997273"
          },
          "code": "PREPARETRANSFERTRANSPAYLOAD",
          "id": "1783327910140",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_FIXEDASSET_DATAEXTRACTOR",
            "functionName": "bossExtractApi",
            "name": "getTransferTransDetails"
          },
          "outcomes": {
            "success": "1783338191162"
          },
          "code": "GETTRANSFERTRANSDETAILS",
          "id": "1783327997273",
          "inputs": [
            {
              "id": "1783328021010_1",
              "name": "payload",
              "type": "string",
              "value": "{{$context.$nodes.PREPARETRANSFERTRANSPAYLOAD.$output.result}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "DisplayForTransferTransaction",
            "returnType": "string",
            "sourceCode": "let parameterList = $context.$nodes.GETTRANSFERTRANSDETAILS.$output;\n\nconst bookTypeCode =\n  $context.$variables.bookTypeCode ||\n  $context.$nodes.BOOKACCESSCHECKER?.$output?.bookTypeCode ||\n  \"-\";\n\nconst chatCounter = Number($context.$variables.FaInqChatCounter ?? 0);\n\nfunction getRecords(source) {\n  if (source === undefined || source === null) return [];\n\n  if (typeof source === \"string\") {\n    try {\n      source = JSON.parse(source);\n    } catch (e) {\n      return [];\n    }\n  }\n\n  if (Array.isArray(source)) return source;\n\n  let response =\n    source?.output?.response ??\n    source?.response ??\n    source?.output ??\n    source;\n\n  if (typeof response === \"string\") {\n    try {\n      response = JSON.parse(response);\n    } catch (e) {\n      return [];\n    }\n  }\n\n  if (Array.isArray(response)) return response;\n  if (Array.isArray(response?.items)) return response.items;\n  if (Array.isArray(response?.records)) return response.records;\n  if (Array.isArray(response?.rows)) return response.rows;\n\n  return [];\n}\n\nfunction normalize(value) {\n  if (value === undefined || value === null) return \"-\";\n\n  const str = String(value).trim();\n\n  if (str === \"\" || str.toUpperCase() === \"NA\") return \"-\";\n\n  return str;\n}\n\nfunction getValue(row, ...keys) {\n  for (const key of keys) {\n    const value = row?.[key] ?? row?.[String(key).toUpperCase()];\n    const normalizedValue = normalize(value);\n\n    if (normalizedValue !== \"-\") {\n      return normalizedValue;\n    }\n  }\n\n  return \"-\";\n}\n\nfunction escapeHtml(value) {\n  return normalize(value)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\");\n}\n\nfunction makeCamelCasing(value) {\n  const str = normalize(value);\n  if (str === \"-\") return \"-\";\n\n  return str\n    .replace(/_/g, \" \")\n    .toLowerCase()\n    .replace(/\\b\\w/g, ch => ch.toUpperCase());\n}\n\nfunction formatDate(value) {\n  if (value === undefined || value === null || String(value).trim() === \"\") {\n    return \"-\";\n  }\n\n  const date = new Date(value);\n  if (isNaN(date.getTime())) return normalize(value);\n\n  const day = String(date.getDate()).padStart(2, \"0\");\n  const month = String(date.getMonth() + 1).padStart(2, \"0\");\n  const year = date.getFullYear();\n\n  return `${month}/${day}/${year}`;\n}\n\nconst rows = getRecords(parameterList);\nconst firstRow = rows[0] || {};\n\nfunction firstAvailable(...keys) {\n  return getValue(firstRow, ...keys);\n}\n\nfunction summaryBlock() {\n  return `\n    <div style=\"display:flex; justify-content:flex-start; align-items:flex-start; gap:56px; flex-wrap:wrap; max-width:980px; width:100%; margin-bottom:14px;\">\n      <div style=\"display:flex; flex-direction:column; gap:6px; min-width:260px;\">\n        <div style=\"display:flex; gap:6px; white-space:nowrap; align-items:baseline;\">\n          <strong>Asset Number</strong><span>${escapeHtml(firstAvailable(\"assetNumber\"))}</span>\n        </div>\n        <div style=\"display:flex; gap:6px; white-space:nowrap; align-items:baseline;\">\n          <strong>Asset Description</strong><span>${escapeHtml(firstAvailable(\"assetDescription\"))}</span>\n        </div>\n        <div style=\"display:flex; gap:6px; white-space:nowrap; align-items:baseline;\">\n          <strong>Book</strong><span>${escapeHtml(firstAvailable(\"headerBookName\", \"distributionBookName\") || bookTypeCode)}</span>\n        </div>\n        <div style=\"display:flex; gap:6px; white-space:nowrap; align-items:baseline;\">\n          <strong>Ledger</strong><span>${escapeHtml(firstAvailable(\"ledgerName\"))}</span>\n        </div>\n      </div>\n\n      <div style=\"display:flex; flex-direction:column; gap:6px; min-width:280px;\">\n        <div style=\"display:flex; gap:6px; white-space:nowrap; align-items:baseline;\">\n          <strong>Transaction Number</strong><span>${escapeHtml(firstAvailable(\"headerTransactionHeaderId\"))}</span>\n        </div>\n        <div style=\"display:flex; gap:6px; white-space:nowrap; align-items:baseline;\">\n          <strong>Transaction Type</strong><span>${escapeHtml(makeCamelCasing(firstAvailable(\"headerTransactionTypeCode\")))}</span>\n        </div>\n        <div style=\"display:flex; gap:6px; white-space:nowrap; align-items:baseline;\">\n          <strong>Effective Date</strong><span>${escapeHtml(formatDate(firstAvailable(\"headerEffectiveDate\")))}</span>\n        </div>\n        <div style=\"display:flex; gap:6px; white-space:nowrap; align-items:baseline;\">\n          <strong>Currency</strong><span>${escapeHtml(firstAvailable(\"currencyCode\"))}</span>\n        </div>\n      </div>\n    </div>`;\n}\n\nconst helpHtml =\n  chatCounter <= 2\n    ? `<div style=\"font-family:'Oracle Sans'; font-size:12px; margin-top:8px;\">Type 'HELP' to know about my capabilities.</div>`\n    : \"\";\n\nlet assetHtml = \"\";\n\nif (!rows || rows.length === 0) {\n  assetHtml = `<div style=\"font-family:'Oracle Sans'; margin-bottom:10px; background:#f9fafb; padding:12px 16px;\">\n    <br>\n    <div style=\"font-size:14px; font-weight:400;\">\n      No transfer transaction details are available to display. Please change your search criteria and try again.\n    </div>\n    <br>\n    ${helpHtml}\n  </div>`;\n} else {\n  let rowsHtml = \"\";\n\n  rows.forEach((row, index) => {\n    const isOdd = (index + 1) % 2 !== 0;\n\n    const distributionId = getValue(row, \"distributionId\");\n    const unitsAssigned = getValue(row, \"unitsAssigned\");\n    const transactionUnits = getValue(row, \"transactionUnits\");\n    const assignmentEffectiveDate = formatDate(getValue(row, \"assignmentEffectiveDate\"));\n    const assignmentIneffectiveDate = formatDate(getValue(row, \"assignmentIneffectiveDate\"));\n    const activeFlag = getValue(row, \"assignmentActiveFlag\");\n    const location = getValue(row, \"location\");\n    const expenseAccount = getValue(row, \"expenseAccount\");\n    const personNumber = getValue(row, \"personNumber\");\n    const employeeName = getValue(row, \"employeeName\");\n    const creatingTransactionHeaderId = getValue(row, \"creatingTransactionHeaderId\");\n    const terminatingTransactionHeaderId = getValue(row, \"terminatingTransactionHeaderId\");\n\n    rowsHtml += `<tr style=\"background-color:${isOdd ? \"#ffffff\" : \"transparent\"};\">\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${index + 1}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${escapeHtml(distributionId)}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${escapeHtml(unitsAssigned)}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${escapeHtml(transactionUnits)}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${escapeHtml(assignmentEffectiveDate)}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${escapeHtml(assignmentIneffectiveDate)}</td>\n      <!--<td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${escapeHtml(activeFlag)}</td>-->\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${escapeHtml(location)}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${escapeHtml(expenseAccount)}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${escapeHtml(personNumber)}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${escapeHtml(employeeName)}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${escapeHtml(creatingTransactionHeaderId)}</td>\n      <td style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">${escapeHtml(terminatingTransactionHeaderId)}</td>\n    </tr>`;\n  });\n\n  assetHtml = `<div style=\"background:#f9fafb; padding:12px 16px;\">\n    <div style=\"font-family:'Oracle Sans'; font-size:14px; width:100%;\">\n      <div style=\"font-size:16px; font-weight:600; margin-bottom:8px;\">\n        Here is the detailed information of the transaction record\n      </div>\n\n      ${summaryBlock()}\n\n      <div style=\"box-sizing:border-box; overflow-x:auto;\">\n        <table style=\"\n          width:100%;\n          border-collapse:collapse;\n          border:1px solid #d9d9d9;\n          table-layout:fixed;\n          font-size:14px;\n          box-sizing:border-box;\n        \">\n          <colgroup>\n            <col style=\"width:5%;\">\n            <col style=\"width:9%;\">\n            <col style=\"width:8%;\">\n            <col style=\"width:8%;\">\n            <col style=\"width:9%;\">\n            <col style=\"width:9%;\">\n            <!--<col style=\"width:7%;\">-->\n            <col style=\"width:12%;\">\n            <col style=\"width:16%;\">\n            <col style=\"width:10%;\">\n            <col style=\"width:14%;\">\n            <col style=\"width:10%;\">\n            <col style=\"width:10%;\">\n          </colgroup>\n          <thead style=\"background-color:#f3f4f6;\">\n            <tr style=\"font-size:12px;\">\n              <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Row</th>\n              <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Distribution ID</th>\n              <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Units Assigned</th>\n              <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Transfer Units</th>\n              <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Effective Date</th>\n              <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Ineffective Date</th>\n              <!--<th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Active</th>-->\n              <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Location</th>\n              <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Expense Account</th>\n              <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Person Number</th>\n              <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Employee Name</th>\n              <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Creating Txn</th>\n              <th style=\"border:1px solid #d6d9dc; padding:6px; text-align:left;\">Terminating Txn</th>\n            </tr>\n          </thead>\n          <tbody>\n            ${rowsHtml}\n          </tbody>\n        </table>\n      </div>\n\n      <div style=\"margin-top:10px; margin-bottom:8px;\">\n        Transfer details show the asset assignment distributions impacted by this transaction.\n      </div>\n<br>\n\n<div style=\"margin-top:10px; margin-bottom:8px;\">\n        If you would like to see any specific transaction details for this book, type:\n        <span style=\"font-size:11px; padding:4px 6px; border:1px solid #d1d5db; background:#f9fafb;\">\n          \"show me transaction details for [transaction number]\"\n        </span>\n      </div>\n\n      ${helpHtml}\n    </div>\n  </div>`;\n}\n\nreturn assetHtml;"
          },
          "outcomes": {
            "success": "1783338327795"
          },
