              "id": "1780643184353_1",
              "name": "bookTypeCode",
              "type": "string"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "logicForGuardrails",
            "returnType": "string",
            "sourceCode": "const classification =\n  $context.$nodes.USER_INPUT_ENTRY_POINT.$output.classification;\n\nlet assetHtml = \"\";\n\nconst helpHtml = `<div style=\"font-family:'Oracle Sans'; font-size:12px; margin:2px;\">\n  Type 'HELP' to know about my capabilities.\n</div>`;\n\nif (classification === \"isIrrelevantquestion\") {\n  assetHtml = `<div style=\"background:#f9fafb; padding:12px 16px;\">\n    <div style=\"font-family:'Oracle Sans'; margin-bottom:10px;\">\n      <div style=\"font-size:14px; font-weight:400;\">\n        This request is outside my scope. I can help with fixed asset details, asset transactions, depreciation, and related inquiries.\n      </div>\n      <br>\n      ${helpHtml}\n    </div>\n  </div>`;\n} else if (classification === \"isRelevantbutnotinscope\") {\n  assetHtml = `<div style=\"background:#f9fafb; padding:12px 16px;\">\n    <div style=\"font-family:'Oracle Sans'; margin-bottom:10px;\">\n      <div style=\"font-size:14px; font-weight:400;\">\n        This request is outside my scope. I can help with fixed asset details, asset transactions, depreciation, and related inquiries.\n      </div>\n      <br>\n      ${helpHtml}\n    </div>\n  </div>`;\n} else if (classification === \"isInScopeButNotAvl\") {\n  assetHtml = `<div style=\"background:#f9fafb; padding:12px 16px;\">\n    <div style=\"font-family:'Oracle Sans'; margin-bottom:10px;\">\n      <div style=\"font-size:14px; font-weight:400;\">\n        The requested fixed asset information is currently unavailable to me and may be added in a future release.\n      </div>\n      <br>\n      ${helpHtml}\n    </div>\n  </div>`;\n} else {\n  assetHtml = `<div style=\"background:#f9fafb; padding:12px 16px;\">\n    <div style=\"font-family:'Oracle Sans'; margin-bottom:10px;\">\n      <div style=\"font-size:14px; font-weight:400;\">\n        I am not able to understand what you are trying to ask. Please rephrase your question.\n      </div>\n      <br>\n      ${helpHtml}\n    </div>\n  </div>`;\n}\n\nreturn assetHtml;"
          },
          "outcomes": {
            "success": "1778737467303"
          },
          "code": "LOGICFORGUARDRAILS",
          "id": "1778736615109",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "returnGuardrailsResponse"
          },
          "outcomes": {},
          "code": "RETURNGUARDRAILSRESPONSE",
          "convergenceTargetId": "end",
          "id": "1778737467303",
          "inputs": [
            {
              "id": "1778737467305_1",
              "name": "returnValue",
              "type": "string",
              "value": "{{$context.$nodes.LOGICFORGUARDRAILS.$output.result}}"
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "name": "prepAssetSingleValueQuestions",
            "returnType": "string",
            "sourceCode": "const assetHeaderFinancialDetails = $context.$variables.assetHeaderFinancialDetails || [];\nconst assetDeprnDetails = $context.$variables.assetDeprnDetails || {};\nconst assetDistDetails = $context.$variables.assetDistDetails || {};\nconst prefs = $context.$variables.currencyFormatDetails || {};\nconst chatCounter = Number($context.$variables.FaInqChatCounter ?? 0);\nconst userQuestion = String($context.$system.$inputMessage || \"\");\n\n// --------------------------------------------------\n// Helpers\n// --------------------------------------------------\nfunction normalize(value) {\n  if (value === undefined || value === null) return \"\";\n  return String(value).trim();\n}\n\nfunction normalizeText(text) {\n  return String(text || \"\")\n    .toLowerCase()\n    .replace(/[^a-z0-9]+/g, \" \")\n    .trim();\n}\n\nfunction tokenize(text) {\n  return normalizeText(text)\n    .split(/\\s+/)\n    .filter(Boolean)\n    .filter(token => ![\n      \"what\", \"is\", \"are\", \"the\", \"a\", \"an\", \"for\", \"of\", \"to\", \"and\", \"in\",\n      \"on\", \"at\", \"show\", \"tell\", \"me\", \"please\", \"asset\", \"number\", \"details\",\n      \"detail\", \"value\", \"give\", \"return\", \"find\", \"get\", \"with\", \"about\",\n      \"this\", \"that\", \"it\", \"its\", \"my\", \"your\", \"kindly\"\n    ].includes(token));\n}\n\nfunction titleCase(str) {\n  return String(str || \"\")\n    .toLowerCase()\n    .split(\" \")\n    .filter(Boolean)\n    .map(word => word.charAt(0).toUpperCase() + word.slice(1))\n    .join(\" \");\n}\n\nfunction isPlainObject(value) {\n  return Object.prototype.toString.call(value) === \"[object Object]\";\n}\n\nfunction toRecordArray(value) {\n  if (value === undefined || value === null) return [];\n  if (Array.isArray(value)) return value;\n  if (String(value).trim() === \"\") return [];\n  return [value];\n}\n\nfunction getRecordsFromSource(source) {\n  if (source === undefined || source === null) return [];\n\n  if (Array.isArray(source)) return source;\n  if (Array.isArray(source?.output?.response)) return source.output.response;\n  if (Array.isArray(source?.response)) return source.response;\n  if (Array.isArray(source?.distributionDetails)) return source.distributionDetails;\n\n  if (isPlainObject(source) && Object.keys(source).length > 0) return [source];\n\n  return [];\n}\n\nfunction getHeaderRecords() {\n  return getRecordsFromSource(assetHeaderFinancialDetails);\n}\n\nfunction getDeprnRecords() {\n  return getRecordsFromSource(assetDeprnDetails);\n}\n\nfunction getDistRecords() {\n  return getRecordsFromSource(assetDistDetails?.distributionDetails || assetDistDetails);\n}\n\nfunction getRecordAssetNumber(record) {\n  return normalize(\n    record?.ASSETNUMBER ??\n    record?.assetNumber ??\n    record?.assetnumber ??\n    record?.ASSET_NUMBER\n  );\n}\n\nfunction getRecordValue(record, keys) {\n  if (!record) return \"\";\n\n  for (const key of keys) {\n    if (record[key] !== undefined && record[key] !== null && String(record[key]).trim() !== \"\") {\n      return record[key];\n    }\n\n    const actualKey = Object.keys(record).find(\n      recordKey => recordKey.toUpperCase() === key.toUpperCase()\n    );\n\n    if (\n      actualKey &&\n      record[actualKey] !== undefined &&\n      record[actualKey] !== null &&\n      String(record[actualKey]).trim() !== \"\"\n    ) {\n      return record[actualKey];\n    }\n  }\n\n  return \"\";\n}\n\nfunction getFirstMatchingRecord(records, assetNumber) {\n  const arr = Array.isArray(records) ? records : getRecordsFromSource(records);\n  const targetAsset = normalize(assetNumber).toUpperCase();\n\n  if (!arr.length) return {};\n\n  if (targetAsset) {\n    const recordsWithAsset = arr.filter(row => getRecordAssetNumber(row));\n    const exactMatch = recordsWithAsset.find(\n      row => getRecordAssetNumber(row).toUpperCase() === targetAsset\n    );\n\n    if (exactMatch) return exactMatch;\n\n    if (recordsWithAsset.length > 0) return {};\n  }\n\n  return arr[0] || {};\n}\n\nfunction extractAssetNumber(text) {\n  const q = String(text || \"\");\n  const directPatterns = [\n    /asset\\s*number\\s*[:#]?\\s*([A-Za-z0-9._-]+)/i,\n    /asset\\s*no\\.?\\s*[:#]?\\s*([A-Za-z0-9._-]+)/i\n  ];\n\n  for (const pattern of directPatterns) {\n    const match = q.match(pattern);\n    if (match && match[1]) return match[1].trim();\n  }\n\n  const skipWords = new Set([\n    \"type\", \"life\", \"cost\", \"method\", \"details\", \"detail\", \"book\", \"number\",\n    \"category\", \"value\", \"reserve\", \"location\", \"distribution\", \"financial\",\n    \"depreciation\", \"deprn\", \"dpis\", \"date\"\n  ]);\n\n  const genericMatches = q.matchAll(/\\basset\\s+([A-Za-z0-9._-]+)\\b/ig);\n\n  for (const match of genericMatches) {\n    const candidate = String(match[1] || \"\").trim();\n    if (candidate && !skipWords.has(candidate.toLowerCase())) {\n      return candidate;\n    }\n  }\n\n  return \"\";\n}\n\nfunction getCurrentAssetNumber() {\n  const recordGroups = [\n    getHeaderRecords(),\n    getDeprnRecords(),\n    getDistRecords()\n  ];\n\n  for (const records of recordGroups) {\n    for (const record of records) {\n      const assetNumber = getRecordAssetNumber(record);\n      if (assetNumber) return assetNumber;\n    }\n  }\n\n  return \"\";\n}\n\nfunction extractBookName(text) {\n  const q = String(text || \"\");\n  const match = q.match(/\\bin\\s+book\\s+(.+?)(?:\\s+for\\s+asset|\\s+asset|$)/i);\n  return match && match[1] ? match[1].trim().replace(/[?.!,;:]+$/, \"\") : \"\";\n}\n\nfunction stripContext(question) {\n  let q = String(question || \"\");\n\n  q = q.replace(/\\basset\\s*number\\s*[:#]?\\s*[A-Za-z0-9._-]+\\b/ig, \" \");\n  q = q.replace(/\\basset\\s*no\\.?\\s*[:#]?\\s*[A-Za-z0-9._-]+\\b/ig, \" \");\n  q = q.replace(/\\basset\\s+(?=[A-Za-z0-9._-]*\\d)[A-Za-z0-9._-]+\\b/ig, \" \");\n  q = q.replace(/\\bin\\s+book\\s+.+$/ig, \" \");\n  q = q.replace(/\\bbook\\s+.+$/ig, \" \");\n  q = q.replace(/\\bthis\\s+asset\\b/ig, \" \");\n  q = q.replace(/\\bcurrent\\s+asset\\b/ig, \" \");\n\n  return q;\n}\n\nfunction getAcronym(text) {\n  return normalizeText(text)\n    .split(/\\s+/)\n    .filter(Boolean)\n    .map(word => word[0])\n    .join(\"\");\n}\n\nfunction humanizeKey(key) {\n  if (!key) return \"Field\";\n\n  return String(key)\n    .replace(/^X_/, \"\")\n    .replace(/_/g, \" \")\n    .replace(/([a-z])([A-Z])/g, \"$1 $2\")\n    .replace(/([A-Z]+)([A-Z][a-z])/g, \"$1 $2\")\n    .replace(/\\s+/g, \" \")\n    .trim()\n    .toLowerCase()\n    .replace(/\\b\\w/g, c => c.toUpperCase());\n}\n\nfunction displayLabelFromQuestion(fieldPhrase, fallbackKey) {\n  const cleaned = normalizeText(fieldPhrase);\n  if (!cleaned) return humanizeKey(fallbackKey);\n\n  const compact = cleaned.replace(/\\s+/g, \"\");\n  if (compact.length <= 6 && cleaned.split(/\\s+/).length === 1) {\n    return compact.toUpperCase();\n  }\n\n  return titleCase(cleaned);\n}\n\nfunction formatDate(value) {\n  if (!value) return \"NA\";\n\n  const date = new Date(value);\n  if (isNaN(date.getTime())) return String(value);\n\n  return date.toLocaleDateString(\"en-GB\", {\n    day: \"2-digit\",\n    month: \"short\",\n    year: \"numeric\"\n  });\n}\n\nfunction formatAmount(amount) {\n  if (amount === undefined || amount === null || amount === \"\") return \"NA\";\n\n  const numericAmount = Number(String(amount).replace(/,/g, \"\"));\n  if (isNaN(numericAmount)) return String(amount);\n\n  const fixed = numericAmount.toFixed(prefs.precision ?? 2);\n  let [integerPart, decimalPart] = fixed.split(\".\");\n\n  integerPart = integerPart.replace(\n    /\\B(?=(\\d{3})+(?!\\d))/g,\n    prefs.groupingSeparator || \",\"\n  );\n\n  return integerPart + (prefs.decimalSeparator || \".\") + decimalPart;\n}\n\nfunction toYesNo(value) {\n  const normalized = String(value || \"\").toUpperCase();\n  if ([\"Y\", \"YES\", \"TRUE\", \"1\"].includes(normalized)) return \"Yes\";\n  if ([\"N\", \"NO\", \"FALSE\", \"0\"].includes(normalized)) return \"No\";\n  return String(value);\n}\n\nfunction flattenObject(value, path = [], out = []) {\n  if (value === null || value === undefined) return out;\n\n  if (Array.isArray(value)) {\n    value.forEach((item, index) => flattenObject(item, path.concat(index), out));\n    return out;\n  }\n\n  if (isPlainObject(value)) {\n    Object.keys(value).forEach(key => {\n      flattenObject(value[key], path.concat(key), out);\n    });\n    return out;\n  }\n\n  out.push({\n    path: path.join(\".\"),\n    key: path[path.length - 1],\n    value\n  });\n\n  return out;\n}\n\nfunction collectRecords() {\n  return [\n    ...getHeaderRecords(),\n    ...getDeprnRecords(),\n    ...getDistRecords()\n  ];\n}\n\nfunction recordBookText(record) {\n  const flat = flattenObject(record);\n\n  for (const item of flat) {\n    const key = normalizeText(item.key || \"\");\n    const path = normalizeText(item.path || \"\");\n    const value = normalize(item.value).toLowerCase();\n\n    if (\n      key.includes(\"book\") ||\n      path.includes(\"book\") ||\n      key.includes(\"ledger\") ||\n      path.includes(\"ledger\")\n    ) {\n      return value;\n    }\n  }\n\n  return \"\";\n}\n\nfunction scoreRecord(record, assetNumber, bookName) {\n  let score = 0;\n\n  const recordAsset = getRecordAssetNumber(record).toUpperCase();\n  const targetAsset = normalize(assetNumber).toUpperCase();\n  const targetBook = normalize(bookName).toLowerCase();\n\n  if (targetAsset && recordAsset === targetAsset) score += 100;\n\n  if (targetBook) {\n    const bookText = recordBookText(record);\n    if (bookText && bookText === targetBook) score += 50;\n    else if (bookText && (bookText.includes(targetBook) || targetBook.includes(bookText))) score += 25;\n  }\n\n  return score;\n}\n\nfunction findMatchingRecord(assetNumber, bookName) {\n  const allRecords = collectRecords();\n  if (!allRecords.length) return null;\n\n  const targetAsset = normalize(assetNumber).toUpperCase();\n\n  const scored = allRecords.map(record => ({\n    record,\n    score: scoreRecord(record, targetAsset, bookName),\n    asset: getRecordAssetNumber(record)\n  }));\n\n  if (targetAsset) {\n    const exactAssetMatches = scored.filter(\n      x => x.asset && x.asset.toUpperCase() === targetAsset\n    );\n\n    if (exactAssetMatches.length) {\n      exactAssetMatches.sort((a, b) => b.score - a.score);\n      return exactAssetMatches[0].record;\n    }\n\n    const recordsWithAsset = scored.filter(x => x.asset);\n    if (recordsWithAsset.length) return null;\n  }\n\n  scored.sort((a, b) => b.score - a.score);\n  return scored[0]?.record || null;\n}\n\nfunction extractFieldPhrase(question) {\n  let q = stripContext(question);\n\n  q = q.replace(/\\bwhat's\\b/ig, \" \");\n  q = q.replace(/\\bwhats\\b/ig, \" \");\n  q = q.replace(/\\bwhat\\b/ig, \" \");\n  q = q.replace(/\\bis\\b/ig, \" \");\n  q = q.replace(/\\bare\\b/ig, \" \");\n  q = q.replace(/\\bthe\\b/ig, \" \");\n  q = q.replace(/\\bplease\\b/ig, \" \");\n  q = q.replace(/\\bgive\\b/ig, \" \");\n  q = q.replace(/\\bshow\\b/ig, \" \");\n  q = q.replace(/\\btell\\b/ig, \" \");\n  q = q.replace(/\\bme\\b/ig, \" \");\n  q = q.replace(/\\bkindly\\b/ig, \" \");\n\n  q = normalizeText(q);\n\n  const tokens = q.split(/\\s+/).filter(Boolean).filter(token => ![\n    \"what\", \"is\", \"are\", \"the\", \"a\", \"an\", \"for\", \"of\", \"to\", \"and\", \"in\",\n    \"on\", \"at\", \"show\", \"tell\", \"me\", \"please\", \"asset\", \"number\", \"details\",\n    \"detail\", \"value\", \"give\", \"return\", \"find\", \"get\", \"with\", \"about\",\n    \"this\", \"that\", \"it\", \"its\", \"my\", \"your\", \"kindly\"\n  ].includes(token));\n\n  return tokens.join(\" \");\n}\n\nfunction buildVariants(candidate) {\n  const human = humanizeKey(candidate.key);\n  const humanNorm = normalizeText(human);\n  const keyNorm = normalizeText(candidate.key);\n  const pathNorm = normalizeText(candidate.path);\n\n  return {\n    human: humanNorm,\n    compact: humanNorm.replace(/\\s+/g, \"\"),\n    acronym: getAcronym(human),\n    raw: keyNorm,\n    path: pathNorm\n  };\n}\n\nfunction scoreCandidate(fieldQuestion, candidate) {\n  const q = normalizeText(fieldQuestion);\n  const qCompact = q.replace(/\\s+/g, \"\");\n  const qAcronym = getAcronym(q);\n  const qTokens = tokenize(q);\n\n  const variants = buildVariants(candidate);\n\n  let score = 0;\n\n  if (!q) return 0;\n\n  if (variants.human === q) score += 100;\n  if (variants.raw === q) score += 95;\n  if (variants.compact === qCompact) score += 90;\n  if (variants.acronym && variants.acronym === qAcronym) score += 85;\n\n  if (variants.human.includes(q)) score += 60;\n  if (variants.raw.includes(q)) score += 55;\n  if (q.includes(variants.human)) score += 45;\n  if (q.includes(variants.raw)) score += 40;\n  if (variants.path.includes(q)) score += 25;\n\n  const candidateTokens = tokenize(variants.human || variants.raw || variants.path);\n  const overlap = qTokens.filter(tok => candidateTokens.includes(tok)).length;\n  score += overlap * 18;\n\n  for (const token of qTokens) {\n    if (variants.human.includes(token)) score += 12;\n    if (variants.raw.includes(token)) score += 12;\n    if (variants.path.includes(token)) score += 8;\n  }\n\n  const askingForBook = q.includes(\"book\") || q.includes(\"ledger\");\n  const isBookLike =\n    variants.raw.includes(\"book\") ||\n    variants.raw.includes(\"ledger\") ||\n    variants.path.includes(\"book\") ||\n    variants.path.includes(\"ledger\");\n\n  if (isBookLike && !askingForBook) score -= 40;\n\n  return score;\n}\n\nfunction formatValue(key, value) {\n  const normalizedKey = normalizeText(key);\n\n  if (\n    normalizedKey.includes(\"date\") ||\n    normalizedKey.includes(\"service\") ||\n    normalizedKey.includes(\"period\")\n  ) {\n    return formatDate(value);\n  }\n\n  if (\n    normalizedKey.includes(\"amount\") ||\n    normalizedKey.includes(\"cost\") ||\n    normalizedKey.includes(\"value\") ||\n    normalizedKey.includes(\"reserve\") ||\n    normalizedKey.includes(\"price\")\n  ) {\n    return formatAmount(value);\n  }\n\n  if (\n    normalizedKey.includes(\"flag\") ||\n    normalizedKey.endsWith(\"ind\") ||\n    normalizedKey.endsWith(\"yn\")\n  ) {\n    return toYesNo(value);\n  }\n\n  return normalize(value);\n}\n\nfunction getHelpHtml() {\n  return chatCounter <= 2\n    ? `\n      <div style=\"font-family:'Oracle Sans'; font-size:12px; margin:2px 0 0 0; background:#f9fafb;\">\n        Type 'HELP' to know about my capabilities.\n      </div>\n    `\n    : \"\";\n}\n\nfunction renderFieldAnswer(label, assetNumber, value, formatterKey = \"\") {\n  const formattedValue = value\n    ? formatValue(formatterKey || label, value)\n    : \"NA\";\n\n  return `\n    <div style=\"font-family:'Oracle Sans'; font-size:14px; margin:2px 0 0 0; background:#f9fafb; padding:12px 16px;\">\n      <br>\n      The ${label} for asset number ${assetNumber} is ${formattedValue}.<br>\n      Please let me know if you need any additional details related to this asset.\n      <br>&nbsp;\n    </div>\n\n    ${getHelpHtml()}\n  `;\n}\n\nfunction answerKnownOracleField(question, assetNumber) {\n  const q = normalizeText(question);\n  const qTokens = tokenize(question);\n\n  const headerRecord = getFirstMatchingRecord(getHeaderRecords(), assetNumber);\n  const deprnRecord = getFirstMatchingRecord(getDeprnRecords(), assetNumber);\n  const distRecord = getFirstMatchingRecord(getDistRecords(), assetNumber);\n\n  function valueFromAnyRecord(keys) {\n    return (\n      getRecordValue(headerRecord, keys) ||\n      getRecordValue(deprnRecord, keys) ||\n      getRecordValue(distRecord, keys)\n    );\n  }\n\n  if (\n    q.includes(\"inception date\") ||\n    q.includes(\"date of inception\")\n  ) {\n    return renderFieldAnswer(\n      \"Inception Date\",\n      assetNumber,\n      valueFromAnyRecord([\"DATEPLACEDINSERVICE\", \"DATE_PLACED_IN_SERVICE\", \"DPIS\"]),\n      \"DATEPLACEDINSERVICE\"\n    );\n  }\n\n  if (\n    q.includes(\"dpis\") ||\n    q.includes(\"date placed in service\") ||\n    q.includes(\"placed in service\") ||\n    q.includes(\"in service date\") ||\n    q.includes(\"service date\")\n  ) {\n    return renderFieldAnswer(\n      \"DPIS\",\n      assetNumber,\n      valueFromAnyRecord([\"DATEPLACEDINSERVICE\", \"DATE_PLACED_IN_SERVICE\", \"DPIS\"]),\n      \"DATEPLACEDINSERVICE\"\n    );\n  }\n\n  if (q.includes(\"prorate date\")) {\n    return renderFieldAnswer(\n      \"Prorate Date\",\n      assetNumber,\n      valueFromAnyRecord([\"PRORATEDATE\", \"PRORATE_DATE\"]),\n      \"PRORATEDATE\"\n    );\n  }\n\n  const asksForDepreciationMethod =\n    q.includes(\"deprn method\") ||\n    q.includes(\"depreciation method\") ||\n    q.includes(\"method used\") ||\n    q.includes(\"method assigned\") ||\n    qTokens.includes(\"method\");\n\n  if (asksForDepreciationMethod) {\n    const method = valueFromAnyRecord([\n      \"METHODNAME\",\n      \"DEPRNMETHOD\",\n      \"DEPRN_METHOD\",\n      \"DEPRECIATIONMETHOD\",\n      \"DEPRECIATION_METHOD\",\n      \"METHOD\",\n      \"METHODCODE\",\n      \"METHOD_CODE\",\n      \"DEPRNMETHODCODE\",\n      \"DEPRN_METHOD_CODE\",\n      \"DEPRECIATIONMETHODCODE\",\n      \"DEPRECIATION_METHOD_CODE\"\n    ]);\n\n    const lifeInMonths = valueFromAnyRecord([\n      \"LIFEINMONTHS\",\n      \"LIFE_IN_MONTHS\",\n      \"LIFEMONTHS\",\n      \"LIFE_MONTHS\",\n      \"USEFULLIFEINMONTHS\",\n      \"USEFUL_LIFE_IN_MONTHS\",\n      \"ASSETLIFEINMONTHS\",\n      \"ASSET_LIFE_IN_MONTHS\"\n    ]);\n\n    return renderFieldAnswer(\n      \"Depreciation Method\",\n      assetNumber,\n      `${method || \"NA\"}, Life in months: ${lifeInMonths || \"NA\"}`\n    );\n  }\n\n  if (\n    q.includes(\"life in months\") ||\n    q.includes(\"useful life\") ||\n    q.includes(\"asset life\")\n  ) {\n    return renderFieldAnswer(\n      \"Life In Months\",\n      assetNumber,\n      valueFromAnyRecord([\n        \"LIFEINMONTHS\",\n        \"LIFE_IN_MONTHS\",\n        \"LIFEMONTHS\",\n        \"LIFE_MONTHS\",\n        \"USEFULLIFEINMONTHS\",\n        \"USEFUL_LIFE_IN_MONTHS\",\n        \"ASSETLIFEINMONTHS\",\n        \"ASSET_LIFE_IN_MONTHS\"\n      ])\n    );\n  }\n\n  return \"\";\n}\n\n// --------------------------------------------------\n// Main Logic\n// --------------------------------------------------\nconst assetNumber = extractAssetNumber(userQuestion) || getCurrentAssetNumber();\nconst bookName = extractBookName(userQuestion);\nconst fieldQuestion = extractFieldPhrase(userQuestion);\n\nif (!assetNumber) {\n  return `\n    <div style=\"font-family:'Oracle Sans'; font-size:14px; margin:2px 0 0 0; background:#f9fafb; padding:12px 16px;\">\n      <br>\n      I need the asset number to process your request. Please include it and try again.<br>\n      <br>&nbsp;\n    </div>\n    ${getHelpHtml()}\n  `;\n}\n\nconst matchedRecord = findMatchingRecord(assetNumber, bookName);\n\nif (!matchedRecord) {\n  return `\n    <div style=\"font-family:'Oracle Sans'; font-size:14px; margin:2px 0 0 0; background:#f9fafb; padding:12px 16px;\">\n      <br>\n      Asset number ${assetNumber} was not found in the current asset details.<br>\n      Please verify the asset number and try again.\n      <br>&nbsp;\n    </div>\n    ${getHelpHtml()}\n  `;\n}\n\nconst knownFieldAnswer = answerKnownOracleField(userQuestion, assetNumber);\n\nif (knownFieldAnswer) {\n  return knownFieldAnswer;\n}\n\nconst flattened = flattenObject(matchedRecord);\nconst scored = flattened.map(item => ({\n  ...item,\n  score: scoreCandidate(fieldQuestion, item)\n}));\n\nscored.sort((a, b) => b.score - a.score);\n\nconst bestMatch = scored[0];\n\nif (!bestMatch || bestMatch.score < 10) {\n  return `\n    <div style=\"font-family:'Oracle Sans'; font-size:14px; margin:2px 0 0 0; background:#f9fafb; padding:12px 16px;\">\n      <br>\n      The requested information is not available for asset number ${assetNumber}.<br>\n      Please let me know if you need to know about any other field.\n      <br>&nbsp;\n    </div>\n    ${getHelpHtml()}\n  `;\n}\n\nconst fieldLabel = displayLabelFromQuestion(fieldQuestion, bestMatch.key);\nconst formattedValue = formatValue(bestMatch.key, bestMatch.value) || \"NA\";\n\nreturn `\n  <div style=\"font-family:'Oracle Sans'; font-size:14px; margin:2px 0 0 0; background:#f9fafb; padding:12px 16px;\">\n    <br>\n    The ${fieldLabel} for asset number ${assetNumber} is ${formattedValue}.<br>\n    Please let me know if you need any additional details related to this asset.\n    <br>&nbsp;\n  </div>\n\n  ${getHelpHtml()}\n`;"
          },
          "outcomes": {
            "success": "1779170614987"
          },
          "code": "PREPASSETSINGLEVALUEQUESTIONS",
          "id": "1779170299769",
          "inputs": [],
