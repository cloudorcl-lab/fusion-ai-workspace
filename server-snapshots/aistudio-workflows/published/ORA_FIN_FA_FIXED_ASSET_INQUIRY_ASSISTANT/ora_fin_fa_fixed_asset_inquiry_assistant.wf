{
  "workflowId": "300000331058810",
  "workflowCode": "ORA_FIN_FA_FIXED_ASSET_INQUIRY_ASSISTANT",
  "name": "Fixed Asset Inquiry Assistant",
  "description": "Helps to quickly understand and resolve questions about fixed assets. It enables them to inquire about asset details, cost, and depreciation details (YTD/period depreciation, accumulated depreciation, reserve).",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1776318775385"
          },
          "code": "START",
          "id": "start",
