          "code": "SETFINANCIALTRANSACTIONDETAILS",
          "convergenceTargetId": "1783325287877",
          "id": "1781711431464",
          "inputs": [
            {
              "id": "1781711448484",
              "name": "assetFinancialTransDetails",
              "scope": "JOB",
