        {
          "metadata": {
            "name": "prepareCurrencyFormatDetails",
            "returnType": "object",
            "sourceCode": "const fallbackUser = $context.$variables.userSessionDetails ?? {};\nconst user =\n  $context.$nodes.GETUSERSESSION.$output?.items?.[0] ?? fallbackUser;\n\nconst currency =\n  $context.$variables.bookDetails.output.response[0].CURRENCYCODE ?? {};\n\n// build and return one object\nreturn {\n    groupingSeparator: user?.GroupingSeparator ?? \"\",\n    decimalSeparator: user?.DecimalSeparator ?? \"\",\n    dateFormat: user?.DateFormat ?? \"\",\n    timeFormat: user?.TimeFormat ?? \"\",\n    precision: currency?.Precision ?? null,\n    symbol: currency?.Symbol ?? \"\",\n    name: currency?.Name ?? \"\",\n    currencyFormat: currency?.CurrencyFormat ?? \"\",\n    currencyFormatWithSymbol: currency?.CurrencyFormatWithSymbol ?? \"\",\n    currencyFormatWithCode: currency?.CurrencyFormatWithCode ?? \"\"\n};"
          },
          "outcomes": {
            "success": "1777898358495"
          },
          "code": "PREPARECURRENCYFORMATDETAILS",
          "id": "1777898029033",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
