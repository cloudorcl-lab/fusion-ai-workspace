        {
          "metadata": {
            "name": "prepareTransList",
            "returnType": "object",
            "sourceCode": "const bookNameVar = $context.$variables.bookTypeCode;\n\nconst rawTransactionTypeCode =\n  $context.$nodes.MULTPLE_TRANSACTION_DETAILS_PROCESSOR?.$output?.transactionTypeCode;\n\nconst transactionTypeCode =\n  rawTransactionTypeCode === undefined || rawTransactionTypeCode === null\n    ? \"\"\n    : String(rawTransactionTypeCode).trim().toUpperCase();\n\nfunction escapeSqlValue(value) {\n  return String(value).replace(/'/g, \"''\");\n}\n\nconst supportedTransactionTypeCondition = `\n    AND transactionTypeCode NOT IN ('TRANSFER IN', 'TRANSFER OUT')\n    AND (\n      transactionTypeCode IN ('ADDITION', 'TRANSFER', 'ADJUSTMENT')\n      OR transactionTypeCode LIKE '%RETIRE%'\n    )\n  `;\n\nlet transactionTypeCondition = \"\";\n\nif (!transactionTypeCode || transactionTypeCode === \"LIST_TRANS\") {\n  transactionTypeCondition = supportedTransactionTypeCondition;\n} else if (transactionTypeCode === \"ADDITION\") {\n  transactionTypeCondition = `\n    AND transactionTypeCode = 'ADDITION'\n  `;\n} else if (transactionTypeCode === \"TRANSFER\") {\n  transactionTypeCondition = `\n    AND transactionTypeCode = 'TRANSFER'\n    AND transactionTypeCode NOT IN ('TRANSFER IN', 'TRANSFER OUT')\n  `;\n} else if (transactionTypeCode === \"ADJUSTMENT\") {\n  transactionTypeCondition = `\n    AND transactionTypeCode = 'ADJUSTMENT'\n  `;\n} else if (transactionTypeCode.includes(\"RETIRE\")) {\n  transactionTypeCondition = `\n    AND transactionTypeCode LIKE '%RETIRE%'\n  `;\n} else {\n  transactionTypeCondition = `\n    AND 1 = 0\n  `;\n}\n\nconst payload = {\n  viewQueries: {\n    financialTransaction: {\n      module: \"oraErpCoreFixedAssets\",\n      businessObject: \"AssetTransaction\",\n      view: \"financialTransactionDetail\",\n      fieldAliases: {\n        transactionHeaderId: \"transactionHeaderId\",\n        transactionTypeCode: \"transactionTypeCode\",\n        bookName: \"bookName\",\n        effectiveDate: \"effectiveDate\",\n        comments: \"comments\",\n        \"asset.assetNumber\": \"assetNumber\",\n        \"asset.assetId\": \"assetId\"\n      }\n    },\n    bookPeriod: {\n      module: \"oraErpCoreFixedAssetsSetup\",\n      businessObject: \"AssetBookPeriod\",\n      view: \"bookPeriodDetail\",\n      fieldAliases: {\n        bookName: \"periodBookName\",\n        periodOpenDate: \"periodOpenDate\",\n        periodCloseDate: \"periodCloseDate\"\n      }\n    }\n  },\n\n  select: `\n    SELECT\n      transactionHeaderId,\n      transactionTypeCode,\n      assetNumber,\n      assetId,\n      effectiveDate,\n      comments\n    FROM financialTransaction, bookPeriod\n    WHERE bookName = periodBookName\n      AND bookName = '${escapeSqlValue(bookNameVar)}'\n      AND periodCloseDate IS NULL\n      ${transactionTypeCondition}\n      AND effectiveDate >= periodOpenDate\n    ORDER BY effectiveDate DESC\n    FETCH FIRST 10 ROWS ONLY\n  `\n};\n\nreturn JSON.stringify(payload);"
          },
          "outcomes": {
            "success": "1782976882933"
          },
