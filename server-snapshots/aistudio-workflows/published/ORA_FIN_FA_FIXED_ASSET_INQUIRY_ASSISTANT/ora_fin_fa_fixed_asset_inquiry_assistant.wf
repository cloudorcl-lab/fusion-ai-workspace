              "name": "prompt",
              "type": "string",
              "value": "You are generating a REST API request payload.\n\nInputs:\n- bookTypeCode: {{$context.$variables.bookTypeCode}} \n- for searchIdentifier : {{$context.$variables.searchIdentifier}}\n\nRules:\n1. set bookTypeCode from: {{$context.$variables.bookTypeCode}}\n2. set searchIdentifier from: {{$context.$variables.searchIdentifier}}\n\nExamples of output:\n\noutput: \n{\n  \"bookTypeCode\": <value>,\n  \"assetNumber\": <searchIdentifier>,\n  \"assetId\": <value or absolute nothing>,\n  \"tagNumber\": <''>,\n  \"serialNumber\": <''>,\n}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"serialNumber\": {\n            \"type\": \"string\"\n        },\n        \"tagNumber\": {\n            \"type\": \"string\"\n        },\n        \"assetNumber\": {\n            \"type\": \"string\"\n        },\n        \"assetId\": {\n            \"type\": \"number\"\n        },\n        \"bookTypeCode\": {\n            \"type\": \"string\"\n        }\n    }\n}",
