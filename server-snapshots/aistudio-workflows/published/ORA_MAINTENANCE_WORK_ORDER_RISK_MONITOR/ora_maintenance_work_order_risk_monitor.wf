        {
          "metadata": {
            "name": "Get data from context and default dates",
            "returnType": "object",
            "sourceCode": "// Get current date (may be string or Date depending on platform)\nconst today = $context.$system.$currentDate ;\n\n// StartDate = today - 30 days\nconst startDateObj = new Date(today);\nstartDateObj.setDate(startDateObj.getDate() - 30);\n\n// EndDate = today + 7 days\nconst endDateObj = new Date(today);\nendDateObj.setDate(endDateObj.getDate() + 7);\n\nconst StartDate = startDateObj.toISOString().split('T')[0];\nconst EndDate = endDateObj.toISOString().split('T')[0];\nconst Limit = 100;\n\n//Get Org Context\nconst appContext = $context.$app.$OraAppContext ?? $context.$triggers.REST.$input.OraAppContext;\nlet OrganizationId = null;\n\nif (appContext != null && appContext.trim() != '') {\n  if (typeof appContext === 'object') {\n    OrganizationId = appContext?.OrganizationId ?? null;\n  } else if (typeof appContext === 'number') {\n    OrganizationId = String(appContext);\n  } else if (typeof appContext === 'string') {\n    const s = appContext.trim();\n    if (s.startsWith('{') || s.startsWith('[')) {\n      try {\n        const obj = JSON.parse(s);\n        OrganizationId = obj?.OrganizationId ?? null;\n      } catch {\n        // Malformed JSON; fall back to treating as plain ID or first CSV part\n        OrganizationId = s.includes(',') ? s.split(',')[0].trim() : s;\n      }\n    } else {\n      OrganizationId = s.includes(',') ? s.split(',')[0].trim() : s;\n    }\n  } else {\n    OrganizationId = String(appContext).trim() || null;\n  }\n}\n\nconst result = {StartDate, EndDate, Limit, OrganizationId};\nreturn result;"
          },
          "outcomes": {
            "success": "1767760652134"
          },
          "code": "GET_CONTEXT_DEFAULT_DATES",
          "id": "1767815766370",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
