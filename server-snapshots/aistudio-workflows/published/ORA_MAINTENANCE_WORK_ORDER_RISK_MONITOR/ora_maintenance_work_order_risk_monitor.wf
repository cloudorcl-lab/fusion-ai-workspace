        {
          "metadata": {
            "name": "Filter At Risk Work Orders",
            "returnType": "object",
            "sourceCode": "const rawItems = $context?.$nodes?.FETCH_WORK_ORDERS?.$output?.items ?? [];\nconst items = Array.isArray(rawItems) ? rawItems : [];\n\nconst now = new Date($context?.$system?.$currentDate ?? Date.now());\n\n// Helpers\nconst toDate = (v) => {\n  const s = String(v ?? '').trim();\n  const d = s ? new Date(s) : null;\n  return d && !Number.isNaN(d.getTime()) ? d : null;\n};\n\nconst byAtRiskWorkOrder = new Map();\nlet PastDueCount = 0;\nlet MissingAssignmentsCount = 0;\n\nfor (const it of items) {\n  const WorkOrderNumber = it?.WorkOrderNumber;\n  if (!WorkOrderNumber) continue;\n\n  // Derive ResourceType: any LABOR -> 'LABOR', else first type or null\n  const resReqs = it?.['WorkOrderOperationInformation.WorkOrderOperationResourceInformation'];\n  const arrRes = Array.isArray(resReqs) ? resReqs : [];\n  const hasLabor = arrRes.some(r =>\n    String(r?.['WorkOrderOperationInformation.WorkOrderOperationResourceInformation.ResourceInformation.ResourceType'] ?? '')\n      .toUpperCase() === 'LABOR'\n  );\n  const fallbackType =\n    arrRes[0]?.['WorkOrderOperationInformation.WorkOrderOperationResourceInformation.ResourceInformation.ResourceType'] ?? null;\n  const ResourceType = hasLabor ? 'LABOR' : fallbackType;\n\n  const endDate = toDate(it?.PlannedCompletionDate);\n  const isPast = !!endDate && endDate < now;\n  const resourceAssignCode = String(it?.ResourceAssignCode ?? '').toLowerCase();\n  const isMissingAssign = hasLabor && (resourceAssignCode === 'unassigned' || resourceAssignCode === 'partially assigned');\n  const assignmentStatus = isMissingAssign || resourceAssignCode === 'assigned' ? resourceAssignCode : '';\n\n  PastDueCount += isPast ? 1 : 0;\n  MissingAssignmentsCount += isMissingAssign ? 1 : 0;\n\n  if (isPast || isMissingAssign) {\n    const rec = {\n      WorkOrderNumber,\n      WorkOrderType: it?.WorkOrderType,\n      WorkOrderDescription: ((it?.WorkOrderDescription ?? '').toString().trim() || ''),\n      AssetNumber : it?.WoaInformation?.[0]?.['WoaInformation.AssetInformation.AssetNumber'],\n      WorkStatusName: it?.['WorkOrderStatusInformation.WorkStatusName'],\n      ResourceAssignCode: it?.ResourceAssignCode,\n      PlannedStartDate: it?.PlannedStartDate,\n      PlannedCompletionDate: it?.PlannedCompletionDate,\n      WorkOrderPriority : it?.WorkOrderPriority,\n      ResourceType,\n      PastDueFlag: isPast,\n      AssignmentStatus: assignmentStatus,\n      MissingAssignmentFlag: isMissingAssign,\n    };\n    byAtRiskWorkOrder.set(WorkOrderNumber, rec);\n  }\n}\n\nconst AtRiskWorkOrders = Array.from(byAtRiskWorkOrder.values());\n\nconst result = { PastDueCount, MissingAssignmentsCount, AtRiskWorkOrders };\nreturn result;"
          },
          "outcomes": {
            "success": "1767762459641"
          },
          "code": "FILTER_AT_RISK_WORK_ORDERS",
          "id": "1771594150914",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
