            "sourceCode": "var m=$context.$variables.prjPjfVarConvFinalResponseModel||{};if(typeof m==='string'){try{m=JSON.parse(m)}catch(x){m={message:m};}}var A=['&','<','>','\"',\"'\"],B=['&amp;','&lt;','&gt;','&quot;','&#39;'];var w=Array.isArray(m.warnings)?m.warnings:[],st=String(m.status||'').toLowerCase(),rt=String(m.responseType||'').toLowerCase();var tone=(st==='error'||rt.indexOf('error')>=0)?'e':((st==='success'&&w.length===0)?'s':((st==='needs_input'||st==='needs input')?'n':(w.length?'w':'i')));var th={s:['#067647','#ecfdf3','#abefc6','Ready'],n:['#175cd3','#eff8ff','#b2ddff','Needs input'],w:['#b54708','#fffbeb','#fedf89','Attention'],e:['#b42318','#fff1f0','#fecdca','Action needed'],i:['#344054','#f8fafc','#d0d5dd','Info']}[tone];var C='border:1px solid #d0d7de;',D=' style=\"'+C+'padding:8px;vertical-align:top;background:#fff;color:#111827;word-break:break-word\"';var v=String(m.title||m.responseType||'Project Initiation Result');for(var q=0;q<A.length;q++){v=v.split(A[q]).join(B[q]);}var h='<div class=\"bubble\" style=\"font-family:Arial,Helvetica,sans-serif;background:#fff;color:#111827;border:1px solid '+th[2]+';border-radius:8px;overflow:hidden;line-height:1.45;max-width:960px;color-scheme:light\"><div style=\"background:'+th[1]+';border-bottom:1px solid '+th[2]+';padding:14px 18px\"><div style=\"display:inline-block;margin:0 0 8px;padding:2px 8px;border:1px solid '+th[2]+';border-radius:999px;color:'+th[0]+';font-size:12px;font-weight:700\">'+th[3]+'</div><h2 style=\"margin:0;font-size:20px;color:#101828\">'+v+'</h2></div><div style=\"padding:16px 18px\">';v=String(m.message||m.summary||m.result||'').replace(/[\\s\\u00A0]+/g,' ').trim();if(v.length>1000)v=v.substring(0,997)+'...';var mm=v.match(/https?:\\/\\/[^\\s\"'<>]+/);if(mm){var pre=v.substring(0,mm.index),u=mm[0],post=v.substring(mm.index+u.length);for(q=0;q<A.length;q++){pre=pre.split(A[q]).join(B[q]);u=u.split(A[q]).join(B[q]);post=post.split(A[q]).join(B[q]);}v=pre+'<a href=\"'+u+'\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#175cd3;text-decoration:underline;word-break:break-all\">'+u+'</a>'+post;}else{for(q=0;q<A.length;q++){v=v.split(A[q]).join(B[q]);}}if(v)h+='<p style=\"margin:0 0 14px;font-size:14px;color:#344054\">'+v+'</p>';var ss=Array.isArray(m.sections)?m.sections:[],r=0,hasWarnSec=false;for(var i=0;i<ss.length;i++){var x=ss[i]||{},it=Array.isArray(x.items)?x.items:[],rs=Array.isArray(x.rows)?x.rows:[],cs=Array.isArray(x.columns)?x.columns:[];if(String(x.title||'').replace(/[\\s\\u00A0]+/g,' ').trim().toLowerCase()==='warnings and follow-up')hasWarnSec=true;h+='<section style=\"margin-top:14px;padding-top:12px;border-top:1px solid #eaecf0\">';v=String(x.title||'');for(q=0;q<A.length;q++){v=v.split(A[q]).join(B[q]);}if(v)h+='<h3 style=\"margin:0 0 8px;font-size:15px;color:#101828\">'+v+'</h3>';v=String(x.content||'').replace(/[\\s\\u00A0]+/g,' ').trim();if(v.length>900)v=v.substring(0,897)+'...';mm=v.match(/https?:\\/\\/[^\\s\"'<>]+/);if(mm){pre=v.substring(0,mm.index);u=mm[0];post=v.substring(mm.index+u.length);for(q=0;q<A.length;q++){pre=pre.split(A[q]).join(B[q]);u=u.split(A[q]).join(B[q]);post=post.split(A[q]).join(B[q]);}v=pre+'<a href=\"'+u+'\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#175cd3;text-decoration:underline;word-break:break-all\">'+u+'</a>'+post;}else{for(q=0;q<A.length;q++){v=v.split(A[q]).join(B[q]);}}if(v)h+='<p style=\"margin:0 0 10px;font-size:14px;color:#344054\">'+v+'</p>';if(it.length){h+='<ul style=\"margin:0;padding-left:20px;color:#344054;font-size:14px\">';for(var j=0;j<it.length;j++){v=String(it[j]||'').replace(/[\\s\\u00A0]+/g,' ').trim();if(v.length>350)v=v.substring(0,347)+'...';mm=v.match(/https?:\\/\\/[^\\s\"'<>]+/);if(mm){pre=v.substring(0,mm.index);u=mm[0];post=v.substring(mm.index+u.length);for(q=0;q<A.length;q++){pre=pre.split(A[q]).join(B[q]);u=u.split(A[q]).join(B[q]);post=post.split(A[q]).join(B[q]);}v=pre+'<a href=\"'+u+'\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#175cd3;text-decoration:underline;word-break:break-all\">'+u+'</a>'+post;}else{for(q=0;q<A.length;q++){v=v.split(A[q]).join(B[q]);}}h+='<li>'+v+'</li>';}h+='</ul>';}if(rs.length&&String(x.sectionType||'')==='taskOutline'){var heads=cs.length?cs:['Task #','Task name','Parent task #','Description','Start','Finish'];h+='<div style=\"overflow-x:auto\"><table style=\"width:100%;border-collapse:collapse;font-size:13px\"><thead><tr>';for(var hc=0;hc<heads.length;hc++){v=String(heads[hc]||'');for(q=0;q<A.length;q++)v=v.split(A[q]).join(B[q]);h+='<th style=\"'+C+'padding:8px;vertical-align:top;background:#f2f4f7;color:#344054;text-align:left;font-weight:700;word-break:break-word\">'+v+'</th>'}h+='</tr></thead><tbody>';for(var rr=0;rr<rs.length;rr++){var ar=Array.isArray(rs[rr])?rs[rr]:[],num=String(ar[0]||''),parent=String(ar[2]||''),lvl=0;if(parent&&parent!=='Not provided')lvl=1;else{var dots=(num.match(/\\./g)||[]).length;if(dots>1)lvl=Math.min(2,dots-1)}h+='<tr>';for(var kk=0;kk<heads.length;kk++){v=String(ar[kk]||'');for(q=0;q<A.length;q++)v=v.split(A[q]).join(B[q]);if(kk===1&&lvl>0)h+='<td style=\"'+C+'padding:8px 8px 8px '+(8+lvl*22)+'px;vertical-align:top;background:#fff;color:#111827;word-break:break-word\">'+v+'</td>';else h+='<td'+D+'>'+v+'</td>'}h+='</tr>'}h+='</tbody></table></div>'}else if(rs.length&&String(x.title||'')==='Task - Resource Assignments'){var groups=[],gmap={};for(var gr=0;gr<rs.length;gr++){var row=Array.isArray(rs[gr])?rs[gr]:[],gk=String(row[0]||'')+'|'+String(row[1]||'');if(!gmap[gk]){gmap[gk]={taskNo:row[0],taskName:row[1],count:0,names:[]};groups.push(gmap[gk])}gmap[gk].count++;if(String(row[2]||'')&&String(row[2]||'')!=='No resource selected')gmap[gk].names.push(String(row[2]||''))}h+='<div style=\"overflow-x:auto\"><table style=\"width:100%;border-collapse:collapse;font-size:13px\"><thead><tr>';var ah=['Task #','Task','Resource count','Resources'];for(var ac=0;ac<ah.length;ac++){h+='<th style=\"'+C+'padding:8px;vertical-align:top;background:#f2f4f7;color:#344054;text-align:left;font-weight:700;word-break:break-word\">'+ah[ac]+'</th>'}h+='</tr></thead><tbody>';for(var gi=0;gi<groups.length;gi++){var g=groups[gi],seen={},names=[];for(var ni=0;ni<g.names.length;ni++){var nm=String(g.names[ni]||'');if(nm&&!seen[nm]){seen[nm]=true;names.push(nm)}}var vals=[g.taskNo,g.taskName,g.count,names.length?names.join(', '):'No resource selected'];h+='<tr>';for(var av=0;av<vals.length;av++){v=String(vals[av]||'');for(q=0;q<A.length;q++)v=v.split(A[q]).join(B[q]);h+='<td'+D+'>'+v+'</td>'}h+='</tr>'}h+='</tbody></table></div>'}else if(rs.length){h+='<div style=\"overflow-x:auto\"><table style=\"width:100%;border-collapse:collapse;font-size:13px\">';if(cs.length){h+='<thead><tr>';for(var c=0;c<cs.length;c++){v=String(cs[c]||'');for(q=0;q<A.length;q++){v=v.split(A[q]).join(B[q]);}h+='<th style=\"'+C+'padding:8px;vertical-align:top;background:#f2f4f7;color:#344054;text-align:left;font-weight:700;word-break:break-word\">'+v+'</th>';}h+='</tr></thead>';}h+='<tbody>';for(r=0;r<rs.length;r++){var row=rs[r];h+='<tr>';if(Array.isArray(row)){for(var k=0;k<row.length;k++){v=String(row[k]||'');mm=v.match(/https?:\\/\\/[^\\s\"\\'<>]+/);if(mm){pre=v.substring(0,mm.index);u=mm[0];post=v.substring(mm.index+u.length);var lab2=(String(x.title||'')==='Important links'&&k===1&&row[0])?String(row[0]):u;for(q=0;q<A.length;q++){pre=pre.split(A[q]).join(B[q]);u=u.split(A[q]).join(B[q]);post=post.split(A[q]).join(B[q]);lab2=lab2.split(A[q]).join(B[q]);}v=pre+'<a href=\"'+u+'\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#175cd3;text-decoration:underline;word-break:break-word\">'+lab2+'</a>'+post;}else{for(q=0;q<A.length;q++){v=v.split(A[q]).join(B[q]);}}h+='<td'+D+'>'+v+'</td>';}}else{for(var key2 in row){v=String(row[key2]||'');mm=v.match(/https?:\\/\\/[^\\s\"\\'<>]+/);if(mm){pre=v.substring(0,mm.index);u=mm[0];post=v.substring(mm.index+u.length);for(q=0;q<A.length;q++){pre=pre.split(A[q]).join(B[q]);u=u.split(A[q]).join(B[q]);post=post.split(A[q]).join(B[q]);}v=pre+'<a href=\"'+u+'\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#175cd3;text-decoration:underline;word-break:break-all\">'+u+'</a>'+post;}else{for(q=0;q<A.length;q++){v=v.split(A[q]).join(B[q]);}}h+='<td'+D+'>'+v+'</td>';}}h+='</tr>';}h+='</tbody></table></div>';}h+='</section>';}if(w.length&&!hasWarnSec){h+='<section style=\"margin-top:14px;padding:12px;border:1px solid #fedf89;border-radius:8px;background:#fffbeb\"><b style=\"color:#93370d\">Warnings and follow-up</b><ul style=\"margin:8px 0 0;padding-left:20px;color:#7a2e0e;font-size:14px\">';for(i=0;i<w.length;i++){v=String(w[i]||'');mm=v.match(/https?:\\/\\/[^\\s\"'<>]+/);if(mm){pre=v.substring(0,mm.index);u=mm[0];post=v.substring(mm.index+u.length);for(q=0;q<A.length;q++){pre=pre.split(A[q]).join(B[q]);u=u.split(A[q]).join(B[q]);post=post.split(A[q]).join(B[q]);}v=pre+'<a href=\"'+u+'\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#175cd3;text-decoration:underline;word-break:break-all\">'+u+'</a>'+post;}else{for(q=0;q<A.length;q++){v=v.split(A[q]).join(B[q]);}}h+='<li>'+v+'</li>';}h+='</ul></section>';}var na=m.nextAction||{},p=String(na.prompt||''),acts=Array.isArray(na.allowedUserActions)?na.allowedUserActions:[];if(p||acts.length){for(q=0;q<A.length;q++){p=p.split(A[q]).join(B[q]);}h+='<section style=\"margin-top:14px;padding:12px;border:1px solid #d0d5dd;border-radius:8px;background:#f8fafc\"><b>Next action</b>';if(p)h+='<p style=\"margin:6px 0 8px;font-size:14px;color:#344054\">'+p+'</p>';if(acts.length){h+='<p style=\"margin:0 0 6px;font-size:13px;color:#475467;font-weight:700\">Suggested replies</p><ul style=\"margin:0;padding-left:20px;color:#344054;font-size:14px\">';for(i=0;i<acts.length;i++){v=String(acts[i]||'');for(q=0;q<A.length;q++){v=v.split(A[q]).join(B[q]);}h+='<li>'+v+'</li>';}h+='</ul>';}h+='</section>';}return h+'</div></div>';"
