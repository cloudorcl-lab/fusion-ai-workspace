            "y": 5872
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1782060301003",
          "code": "PRJ_PJF_CODE_ENFORCE_MISSING_DOCUMENT_GATE",
          "type": "CODE",
          "metadata": {
            "name": "Enforce Missing Document Gate",
            "sourceCode": "function text(value, fallback) {\n  if (value === null || value === undefined) {\n    return fallback || '';\n  }\n  var s = String(value).replace(/[\\s\\u00A0]+/g, ' ').trim();\n  return s || (fallback || '');\n}\n\nfunction boolValue(value) {\n  if (value === true) {\n    return true;\n  }\n  if (value === false || value === null || value === undefined) {\n    return false;\n  }\n  if (typeof value === 'string') {\n    var s = value.toLowerCase().trim();\n    return s === 'true' || s === 'yes' || s === 'y';\n  }\n  return Boolean(value);\n}\n\nvar classifier = {};\ntry {\n  classifier = $context.$nodes.PRJ_PJF_LLM_CLASSIFY_LATEST_USER_INTENT.$output || {};\n} catch (e) {}\n\nvar documentCheck = {};\ntry {\n  documentCheck = $context.$nodes.PRJ_PJF_CODE_CHECK_UNIFIED_DOCUMENT_ATTACHED.$output.result || {};\n} catch (e2) {}\n\nvar actionabilityLevel = text(classifier.actionabilityLevel, '');\nvar operationKind = text(classifier.operationKind, 'UNKNOWN');\nvar intentType = text(classifier.intentType, 'UNCLEAR');\nvar queryType = text(classifier.queryType, '');\nvar controlType = text(classifier.controlType, '');\nvar confidence = text(classifier.confidence, 'LOW');\nvar mentionsDocumentDependency = boolValue(classifier.mentionsDocumentDependency);\nvar documentAttached = boolValue(documentCheck.documentAttached);\nvar missingDocumentForAction = operationKind === 'ACTIONABLE' && mentionsDocumentDependency && !documentAttached;\n\nif (missingDocumentForAction) {\n  operationKind = 'QUERY';\n  intentType = 'MISSING_DOCUMENT';\n  queryType = 'DOCUMENT_GUIDANCE';\n  controlType = '';\n  confidence = 'HIGH';\n}\n\nreturn {\n  actionabilityLevel: actionabilityLevel,\n  operationKind: operationKind,\n  intentType: intentType,\n  queryType: queryType,\n  controlType: controlType,\n  confidence: confidence,\n  mentionsDocumentDependency: mentionsDocumentDependency,\n  documentAttached: documentAttached,\n  missingDocumentForAction: missingDocumentForAction,\n  documentDependencyConfidence: text(classifier.documentDependencyConfidence, ''),\n  documentDependencyEvidence: text(classifier.documentDependencyEvidence, '')\n};",
            "returnType": "object"
          },
