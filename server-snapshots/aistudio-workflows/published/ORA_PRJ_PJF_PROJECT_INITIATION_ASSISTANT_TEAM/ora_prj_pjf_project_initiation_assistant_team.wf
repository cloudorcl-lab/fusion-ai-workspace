){var z=A(x[ks[k]]);if(z)return z}}}return''}\nvar msg=A(e)||'The project initiation request could not be completed.';\nif(msg.length>900)msg=msg.substring(0,897)+'...';\nreturn {responseType:'WORKFLOW_ERROR',status:'error',title:'Project initiation could not be completed',message:msg,sections:[{sectionType:'keyValue',title:'Business error',columns:['Detail','Value'],rows:[['Error',msg]],items:[],content:''}],warnings:[],nextAction:{prompt:'Start a new request after correcting the issue.',allowedUserActions:[]},context:{currentStage:String(v.prjPjfVarConvWorkflowStage||'FAILED'),intentType:String(v.prjPjfVarConvLatestUserIntent||'')}};"
