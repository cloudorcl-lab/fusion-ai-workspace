            "errorNodeId": "1773637992507",
            "name": "Resolve Strategic Context Details",
            "returnType": "object",
            "sourceCode": "function parseJsonSafe(value, fallback) {\n  if (typeof value === 'string') {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return fallback;\n    }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\n\nfunction asObject(value) {\n  var parsed = parseJsonSafe(value, null);\n  return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};\n}\n\nfunction hasOwn(objectValue, fieldName) {\n  return objectValue && typeof objectValue === 'object' && Object.prototype.hasOwnProperty.call(objectValue, fieldName);\n}\n\nfunction workflowVar(fieldName) {\n  try {\n    if ($context.$variables && Object.prototype.hasOwnProperty.call($context.$variables, fieldName)) {\n      var value = $context.$variables[fieldName];\n      return value === undefined ? null : value;\n    }\n  } catch (e) {}\n  return null;\n}\n\nfunction restInput() {\n  try {\n    if ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input && typeof $context.$triggers.REST.$input === 'object') {\n      return $context.$triggers.REST.$input;\n    }\n  } catch (e) {}\n  return {};\n}\n\nfunction currentInputMessage() {\n  try {\n    return $context.$system.$inputMessage || '';\n  } catch (e) {\n    return '';\n  }\n}\n\nfunction currentAttachmentText() {\n  try {\n    return $context.$nodes.PRJ_PJF_TOOL_EXTRACT_ATTACHMENT_TEXT.$output;\n  } catch (e) {\n    return null;\n  }\n}\n\nvar input = restInput();\nvar passedAtomicDetails = asObject(hasOwn(input, 'prjPjfActiveAtomicAgentDetails') ? input.prjPjfActiveAtomicAgentDetails : workflowVar('prjPjfVarConvActiveAtomicAgentDetails'));\nvar contextDetails = asObject(passedAtomicDetails.contextDetails);\nvar names = [\"prjPjfVarConvResourceCreationHelperResult\", \"prjPjfVarConvProjectProposalDeepLink\", \"prjPjfVarConvProjectOverviewDeepLink\", \"prjPjfVarConvFinancialPlanVersionId\", \"prjPjfVarConvCreatedProjectResult\", \"prjPjfVarConvSessionUserDetails\", \"prjPjfVarConvTaskResourceAssignments\", \"prjPjfVarConvPrimaryPlanningRbsResources\", \"prjPjfVarConvPrimaryPlanningRbsId\", \"prjPjfVarConvFinalProjectTasks\", \"prjPjfVarConvFetchedTemplateTasksForExecutionPlan\", \"prjPjfVarConvSelectedProjectTemplateId\", \"prjPjfVarConvProjectTemplateSelectionResult\", \"prjPjfVarConvExtractedProjectResources\", \"prjPjfVarConvExtractedProjectTasks\", \"prjPjfVarConvExtractedProjectAttributes\", \"prjPjfVarConvRequestedWorkflowObjects\", \"prjPjfVarConvShouldContinueWorkflowLoop\", \"prjPjfVarConvLatestOperationKind\", \"prjPjfVarConvLatestQueryType\", \"prjPjfVarConvLatestControlType\", \"prjPjfVarConvLatestIntentConfidence\", \"prjPjfVarConvProjectValidationResult\", \"prjPjfVarConvProjectValidationErrors\", \"prjPjfVarConvTaskValidationResult\", \"prjPjfVarConvTaskValidationErrors\", \"prjPjfVarConvCreateReadinessValidationResult\", \"prjPjfVarConvCreateReadinessValidationErrors\", \"prjPjfVarConvMissingRequiredProjectAttributes\", \"prjPjfVarConvProjectCreationWarnings\", \"prjPjfVarConvRequirementContext\", \"prjPjfVarConvEffectiveRequirementContext\", \"prjPjfVarConvProjectRequirementContext\", \"prjPjfVarConvTaskRequirementContext\", \"prjPjfVarConvTemplateRequirementContext\", \"prjPjfVarConvLatestUserIntent\", \"prjPjfVarConvUploadedDocumentText\", \"prjPjfVarConvWorkflowStage\", \"prjPjfVarConvLatestUserMessage\", \"prjPjfVarConvFinalResponseModel\", \"prjPjfVarConvHasFinalResponseModel\", \"prjPjfVarConvExtractedProjectMilestones\"];\nvar result = {};\n\nfor (var i = 0; i < names.length; i++) {\n  var name = names[i];\n  result[name] = hasOwn(contextDetails, name) ? contextDetails[name] : workflowVar(name);\n}\n\nif (hasOwn(input, 'prjPjfStrategicAttachContent') && input.prjPjfStrategicAttachContent !== null && input.prjPjfStrategicAttachContent !== undefined) {\n  result.prjPjfVarConvUploadedDocumentText = input.prjPjfStrategicAttachContent;\n} else if (!hasOwn(contextDetails, 'prjPjfVarConvUploadedDocumentText')) {\n  result.prjPjfVarConvUploadedDocumentText = currentAttachmentText();\n}\n\nif (result.prjPjfVarConvWorkflowStage === null || result.prjPjfVarConvWorkflowStage === undefined || result.prjPjfVarConvWorkflowStage === '') {\n  result.prjPjfVarConvWorkflowStage = workflowVar('prjPjfVarConvWorkflowStage') || 'NEW_REQUEST';\n}\n\nresult.prjPjfVarConvLatestUserMessage = currentInputMessage();\nresult.prjPjfVarConvHasFinalResponseModel = false;\nreturn result;"
