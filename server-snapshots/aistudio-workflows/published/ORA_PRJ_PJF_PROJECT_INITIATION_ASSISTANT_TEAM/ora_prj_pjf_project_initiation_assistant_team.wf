                  "metadata": {
                    "name": "Generate Task-to-Resource Recommendations",
                    "errorNodeId": "1779001000200",
                    "modelConfiguration": {
                      "code": "ORA_LLM_MODEL_PROVIDER_CERT_BASIC_LLAMA_3_3_70B",
                      "modelName": "Gpt Oss",
                      "provider": "CERT_BASIC",
