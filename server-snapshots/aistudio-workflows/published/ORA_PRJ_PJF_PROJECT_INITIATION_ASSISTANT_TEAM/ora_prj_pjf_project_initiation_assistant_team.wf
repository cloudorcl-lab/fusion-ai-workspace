                    "language": "JAVASCRIPT",
                    "returnType": "object",
                    "sourceCode": "function asText(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  return String(value).replace(/[\\s\\u00A0]+/g, ' ').trim();\n}\n\nfunction firstItem(value) {\n  if (value && Array.isArray(value.items) && value.items.length > 0) {\n    return value.items[0] || {};\n  }\n  return value || {};\n}\n\nvar sessionUserDetails = {};\ntry {\n  sessionUserDetails = $context.$variables.prjPjfVarConvSessionUserDetails || {};\n} catch (e) {\n  sessionUserDetails = {};\n}\n\nvar currentUser = firstItem(sessionUserDetails);\nvar personNumber = asText(currentUser.PersonNumber || currentUser.personNumber || currentUser.person_number || currentUser.PERSON_NUMBER);\nvar fields = 'workRelationships.assignments.businessUnit.name,workRelationships.assignments.assignmentStatusType,workRelationships.assignments.primaryFlag';\nvar urlParameters = '$fields=' + fields + '&$filter=personDetail.personNumber=' + personNumber;\nvar result = {\n  personNumber: personNumber,\n  hasPersonNumber: personNumber !== '',\n  urlParameters: urlParameters\n};\nreturn result;"
