ion treatment.\");\nif(winner.scoreBreakdown.burdeningAlignment<0) warn.push(\"The selected template differs from the requested burden enabled treatment.\");\nreturn {matchFound:true,selectionResult:normalizeSelection({matchFound:true,selectionMode:safe?\"RANKED_MATCH\":\"RANKED_FALLBACK\",selectedTemplate:winner,topCandidates:finalCandidates.slice(0,5),warnings:warn,assumptions:[],debug:{rankingApplied:true,llmRankingApplied:llmApplied,fallbackApplied:safe!==true,recencyApplied:ranked.recencyApplied===true,confidence:winner.confidence||null,ambiguityFlag:safe!==true,llmSemanticApplied:llmApplied,hardMismatchCapped:winner.scoreBreakdown.hardMismatchCapped===true,deterministicScore:winner.scoreBreakdown.deterministicScore,semanticScore:winner.scoreBreakdown.semanticScore,finalScore:winner.scoreBreakdown.finalScore}})};",
