                {
                  "metadata": {
                    "name": "Build Task Assignment Batch Payload",
                    "errorNodeId": "1779101000013",
                    "language": "JAVASCRIPT",
                    "returnType": "object",
                    "sourceCode": "var planId = String($context.$variables.prjPjfVarConvFinancialPlanVersionId || ''); var src = $context.$variables.prjPjfVarConvTaskResourceAssignments || {}; var rows = []; if (Array.isArray(src)) { rows = src; } else if (Array.isArray(src.taskResourceAssignments)) { rows = src.taskResourceAssignments; } else if (Array.isArray(src.assignments)) { rows = src.assignments; } var parts = []; var idx = 1; for (var i = 0; i < rows.length; i++) { var row = rows[i] || {}; var taskNumber = row.TaskNumber || row.taskNumber || row.Task || row.task || ''; var directResource = row.ResourceName || row.resourceName || ''; var resources = Array.isArray(row.recommendedResources) ? row.recommendedResources : []; if (resources.length === 0 && directResource) { resources = [{ResourceName: directResource, resourceName: directResource}]; } for (var j = 0; j < resources.length; j++) { var res = resources[j] || {}; var resourceName = res.ResourceName || res.resourceName || res.name || ''; if (taskNumber && resourceName) { parts.push({id: 'part' + idx, path: '/financialProjectPlans/' + planId + '/child/ResourceAssignments', operation: 'create', payload: {TaskNumber: String(taskNumber), ResourceName: String(resourceName)}}); idx++; } } } return {parts: parts};"
                  },
