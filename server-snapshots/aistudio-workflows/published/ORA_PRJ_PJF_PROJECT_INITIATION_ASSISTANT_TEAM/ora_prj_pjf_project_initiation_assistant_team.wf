                  "metadata": {
                    "name": "Validate Project Attributes",
                    "returnType": "object",
                    "sourceCode": "var project=$context.$variables.prjPjfVarConvExtractedProjectAttributes||{};\nvar out={},errors=[],warnings=[];\nfunction S(v){return v===null||v===undefined?'':String(v).replace(/[\\s\\u00A0]+/g,' ').trim()}\nfunction has(v){return S(v)!==''}\nfunction E(field,label,msg,type){errors.push({objectType:'ProjectHeader',field:field,displayName:label,message:msg,validationType:type||'INVALID_VALUE',severity:'BLOCK_REVIEW'});}\nfunction D(v){var s=S(v),m=s.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);if(!m)return null;var t=Date.UTC(+m[1],+m[2]-1,+m[3]),z=new Date(t);return z.getUTCFullYear()==+m[1]&&z.getUTCMonth()==+m[2]-1&&z.getUTCDate()==+m[3]?t:null}\nfunction today(){var raw=(($context.$system&&$context.$system.$currentDateTime)||new Date().toISOString())+'';var m=raw.match(/^(\\d{4}-\\d{2}-\\d{2})/);return m?m[1]:new Date().toISOString().slice(0,10)}\nfunction appendDate(n,d){n=S(n);if(!n)return n;if(new RegExp('(?:^|\\\\s)'+d.replace(/-/g,'\\\\-')+'$').test(n))return n;return n+' '+d}\nvar p={};for(var k in project){if(project.hasOwnProperty(k))p[k]=project[k]}\nvar src=S(p.ProjectNameSource||p.projectNameSource||'UNKNOWN').toUpperCase();if(src!=='USER_EXPLICIT'&&src!=='DOCUMENT_EXTRACTED'&&src!=='ASSISTANT_GENERATED')src='UNKNOWN';var msg=S(($context.$variables&&$context.$variables.prjPjfVarConvLatestUserMessage)||'');var asksGen=/not\\s+providing\\s+a\\s+project\\s+name|generate\\s+(a\\s+)?(suitable\\s+)?project\\s+name|you\\s+generate\\s+.*project\\s+name/i.test(msg);var explicit=/project\\s+named|project\\s+name\\s*(is|:|=)|called\\s+[A-Z0-9]/i.test(msg);if(asksGen&&!explicit)src='ASSISTANT_GENERATED';p.ProjectNameSource=src;\nif(src==='ASSISTANT_GENERATED'&&has(p.ProjectName)){p.ProjectNameBase=p.ProjectNameBase||p.ProjectName;p.ProjectName=appendDate(p.ProjectName,today());warnings.push('Assistant-generated project name was suffixed with the current date.');}\nvar bu=p.BusinessUnit||p.BusinessUnitName;\nif(!has(p.ProjectName))E('ProjectName','Project Name','Project Name is required.','MISSING_REQUIRED_FIELD');\nif(!has(p.ProjectNumber))E('ProjectNumber','Project Number','Project Number is required.','MISSING_REQUIRED_FIELD');\nif(!has(p.ProjectStartDate))E('ProjectStartDate','Project Start Date','Project Start Date is required.','MISSING_REQUIRED_FIELD');\nif(!has(bu))E('BusinessUnit','Business Unit','Business Unit is required.','MISSING_REQUIRED_FIELD');\nvar ps=has(p.ProjectStartDate)?D(p.ProjectStartDate):null,pe=has(p.ProjectEndDate)?D(p.ProjectEndDate):null;\nif(has(p.ProjectStartDate)&&ps===null)E('ProjectStartDate','Project Start Date','Project Start Date must use YYYY-MM-DD format.','INVALID_DATE_FORMAT');\nif(has(p.ProjectEndDate)&&pe===null)E('ProjectEndDate','Project End Date','Project End Date must use YYYY-MM-DD format.','INVALID_DATE_FORMAT');\nif(ps!==null&&pe!==null&&pe<ps)E('ProjectEndDate','Project End Date','Project End Date cannot be earlier than Project Start Date.','INVALID_DATE_ORDER');\nreturn {isValid:errors.length===0,errors:errors,warnings:warnings,normalizedProject:p,missingFields:errors.filter(function(e){return e.validationType==='MISSING_REQUIRED_FIELD'}).map(function(e){return e.field}),invalidFields:errors.filter(function(e){return e.validationType!=='MISSING_REQUIRED_FIELD'}).map(function(e){return e.field})};",
