icScore,0)),finalScore=round2((deterministicScore*0.6)+(semanticScore*0.4)),hardMismatchCapped=false;\n  if(num(base.hardMismatchCount,0)>0){var cap=49-((num(base.hardMismatchCount,0)-1)*4);if(finalScore>cap) finalScore=cap;hardMismatchCapped=true;}\n  var scoreBreakdown={semanticNameFit:semName,semanticDescriptionFit:semDesc,semanticIntentFit:semIntent,textRelevance:semanticScore,capitalizationAlignment:num(base.scoreBreakdown&&base.scoreBreakdown.capitalizationAlignment,0),billingAlignment:num(base.scoreBreakdown&&base.scoreBreakdown.billingAlignment,0),burdeningAlignment:num(base.scoreBreakdown&&base.scoreBreakdown.burdeningAlignment,0),businessUnitAlignment:0,projectTypeAlignment:0,recencyBoost:num(base.scoreBreakdown&&base.scoreBreakdown.recencyBoost,0),deterministicScore:deterministicScore,semanticScore:semanticScore,finalScore:finalScore,hardMismatchCapped:hardMismatchCapped};\n  var matched=base.matchedCriteria||{};\n  matched.textRelevance={matchedTerms:sem&&Array.isArray(sem.matchedSignals)?sem.matchedSignals:[],matchedPhrases:sem&&Array.isArray(sem.matchedSignals)?sem.matchedSignals:[]};\n  finalCandidates.push({templateId:base.id,templateName:base.n,templateDetails:base.templateDetails||null,templateTasks:[],rationale:sem&&sem.rationale?sem.rationale:\"Combined deterministic and semantic template scoring.\",totalScore:finalScore,scoreBreakdown:scoreBreakdown,matchedCriteria:matched,confidence:semConf,hardMismatchCount:num(base.hardMismatchCount,0),semanticMatchedSignals:sem&&Array.isArray(sem.matchedSignals)?sem.matchedSignals:[],semanticMismatchSignals:sem&&Array.isArray(sem.mismatchSignals)?sem.mismatchSignals:[]});\n}\nfinalCandidates.sort(function(a,b){if(b.totalScore!==a.totalScore) return b.totalScore-a.totalScore;if(b.confidence!==a.confidence) return b.confidence-a.confidence;return num(b.scoreBreakdown.deterministicScore,0)-num(a.scoreBreakdown.deterministicScore,0);});\nvar winner=finalCandidates[0]||null,runnerUp=finalCandidates[1]||null,gap=(