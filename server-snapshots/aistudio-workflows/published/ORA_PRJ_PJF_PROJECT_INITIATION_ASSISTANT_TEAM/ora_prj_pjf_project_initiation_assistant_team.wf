                    "language": "JAVASCRIPT",
                    "returnType": "object",
                    "sourceCode": "function asText(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  return String(value).replace(/[\\s\\u00A0]+/g, ' ').trim();\n}\n\nfunction asArray(value) {\n  if (!value) {\n    return [];\n  }\n  if (Array.isArray(value)) {\n    return value;\n  }\n  if (Array.isArray(value.items)) {\n    return value.items;\n  }\n  return [];\n}\n\nfunction isTrue(value) {\n  if (value === true) {\n    return true;\n  }\n  if (typeof value === 'string') {\n    return value.toLowerCase().trim() === 'true';\n  }\n  return false;\n}\n\nfunction cloneObject(value) {\n  var output = {};\n  if (value && typeof value === 'object' && !Array.isArray(value)) {\n    for (var key in value) {\n      if (Object.prototype.hasOwnProperty.call(value, key)) {\n        output[key] = value[key];\n      }\n    }\n  }\n  return output;\n}\n\nfunction findDefaultBusinessUnit(workersOutput) {\n  var workers = asArray(workersOutput && workersOutput.items ? workersOutput.items : workersOutput);\n  for (var w = 0; w < workers.length; w++) {\n    var relationships = asArray(workers[w] && workers[w].workRelationships);\n    for (var r = 0; r < relationships.length; r++) {\n      var assignments = asArray(relationships[r] && relationships[r].assignments);\n      for (var a = 0; a < assignments.length; a++) {\n        var assignment = assignments[a] || {};\n        var status = asText(assignment.assignmentStatusType).toUpperCase();\n        var primary = isTrue(assignment.primaryFlag);\n        var businessUnit = asText(assignment.businessUnit && assignment.businessUnit.name);\n        if (status === 'ACTIVE' && primary && businessUnit) {\n          return {\n            businessUnit: businessUnit,\n            assignmentStatusType: status,\n            primaryFlag: primary\n          };\n        }\n      }\n    }\n  }\n  return {\n    businessUnit: '',\n    assignmentStatusType: '',\n    primaryFlag: false\n  };\n}\n\nvar project = cloneObject($context.$variables.prjPjfVarConvExtractedProjectAttributes || {});\nvar existingBusinessUnit = asText(project.BusinessUnit || project.BusinessUnitName);\nvar workersOutput = {};\ntry {\n  workersOutput = $context.$nodes.PRJ_PJF_WHILE_PROCESS_WORKFLOW_STAGES.PRJ_PJF_BO_FUNCTION_FETCH_BU_DEFAULT_WORKERS_FOR_CURRENT_USER.$output || {};\n} catch (e) {\n  workersOutput = {};\n}\n\nvar urlResult = {};\ntry {\n  urlResult = $context.$nodes.PRJ_PJF_WHILE_PROCESS_WORKFLOW_STAGES.PRJ_PJF_CODE_BUILD_BU_DEFAULT_WORKER_INQUIRY_URL_PARAMETERS.$output.result || {};\n} catch (e2) {\n  urlResult = {};\n}\n\nvar selected = findDefaultBusinessUnit(workersOutput);\nvar defaultApplied = !existingBusinessUnit && selected.businessUnit !== '';\nif (defaultApplied) {\n  project.BusinessUnit = selected.businessUnit;\n  project.BusinessUnitName = selected.businessUnit;\n  project.BusinessUnitDefaultedFlag = true;\n  project.BusinessUnitDefaultSource = 'CURRENT_USER_PRIMARY_ASSIGNMENT';\n  project.BusinessUnitDefaultPersonNumber = asText(urlResult.personNumber);\n}\n\nvar result = {\n  defaultApplied: defaultApplied,\n  defaultBusinessUnit: selected.businessUnit,\n  defaultSource: defaultApplied ? 'CURRENT_USER_PRIMARY_ASSIGNMENT' : '',\n  personNumber: asText(urlResult.personNumber),\n  project: project\n};\nreturn result;"
