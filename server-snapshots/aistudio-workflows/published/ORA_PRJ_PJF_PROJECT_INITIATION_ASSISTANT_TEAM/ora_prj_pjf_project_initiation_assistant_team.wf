                    "sourceCode": "var o=$context.$nodes.PRJ_PJF_WHILE_PROCESS_WORKFLOW_STAGES.PRJ_PJF_BO_FUNCTION_FETCH_PROJECT_TEMPLATES.$output||{};function arr(v){if(Array.isArray(v))return v;if(v&&Array.isArray(v.items))return v.items;if(v&&Array.isArray(v.data))return v.data;if(v&&Array.isArray(v.results))return v.results;if(v&&v.result){if(Array.isArray(v.result))return v.result;if(Array.isArray(v.result.items))return v.result.items;if(Array.isArray(v.result.data))return v.result.data;}return [];}function text(v){if(v===null||v===undefined)return \"\";if(typeof v===\"string\"||typeof v===\"number\"||typeof v===\"boolean\"){var s=((\"\"+v).trim());return s===\"[object Object]\"?\"\":s;}return \"\";}function label(v){if(v===null||v===undefined)return \"\";if(typeof v===\"string\"||typeof v===\"number\"||typeof v===\"boolean\")return text(v);if(typeof v===\"object\"){return text(v.name||v.Name||v.label||v.Label||v.value||v.Value||v.id||v.Id||v.businessUnitId||v.projectTypeId||v.code||v.Code||\"\");}return \"\";}function bool(v){if(v===true||v===false)return v;var s=text(v).toLowerCase();if(s===\"true\"||s===\"y\"||s===\"yes\")return true;if(s===\"false\"||s===\"n\"||s===\"no\")return false;return null;}function norm(v){return text(v).toLowerCase().replace(/[^a-z0-9]+/g,\" \").trim();}var a=arr(o),l=[],responseHasMore=o&&o.hasMore===true;for(var i=0;i<a.length;i++){var t=a[i]||{};var id=text(t.id||t.ProjectTemplateId||t.projectTemplateId||t.templateId||t.TemplateId);var n=text(t.name||t.ProjectTemplateName||t.projectTemplateName||t.templateName||t.TemplateName||t.title);if(!n)continue;var r=text(t.description||t.ProjectTemplateDescription||t.projectTemplateDescription||t.templateDescription||t.TemplateDescription);var m=label(t.businessUnit&&typeof t.businessUnit===\"object\"?t.businessUnit.name:t.businessUnitName||t.BusinessUnitName||t.businessUnit);var p=label(t.projectType&&typeof t.projectType===\"object\"?t.projectType.name:t.projectTypeName||t.ProjectTypeName||t.projectType);var c=bool(t.capitalizableFlag);if(c===null&&t.projectType&&typeof t.projectType===\"object\")c=bool(t.projectType.enableCapitalizationFlag);var b=bool(t.billingFlag);if(b===null&&t.projectType&&typeof t.projectType===\"object\")b=bool(t.projectType.enableBillingFlag);var u=bool(t.burdeningFlag);if(u===null&&t.projectType&&typeof t.projectType===\"object\")u=bool(t.projectType.enableBurdeningFlag);var templateDetails={ProjectTemplateId:id||null,ProjectTemplateName:n,ProjectTemplateDescription:r||null,BusinessUnitName:m||null,ProjectTypeName:p||null,BillingFlag:b,CapitalizableFlag:c,BurdeningFlag:u};l.push({templateId:id,templateName:n,templateDescription:r,businessUnitName:m,projectTypeName:p,capitalizableFlag:c,billingFlag:b,burdeningFlag:u,templateDetails:templateDetails,nameNormalized:norm(n),searchText:norm(n+\" \"+r+\" \"+m+\" \"+p)});}return {count:l.length,items:l,rawCount:a.length,responseHasMore:responseHasMore,schemaHint:\"PROJECT_TEMPLATES_INQUIRY_V1\"};",
                    "errorNodeId": "1779001000200"
