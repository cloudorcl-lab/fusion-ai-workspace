          "code": "PRJ_PJF_CODE_CHECK_UNIFIED_DOCUMENT_ATTACHED",
          "type": "CODE",
          "metadata": {
            "name": "Check Unified Document Attached",
            "sourceCode": "function parseJsonSafe(value) {\n  if (typeof value === 'string') {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return value;\n    }\n  }\n  return value;\n}\n\nfunction hasText(value) {\n  value = parseJsonSafe(value);\n  if (value === null || value === undefined) {\n    return false;\n  }\n  if (typeof value === 'string') {\n    return value.replace(/[\\s\\u00A0]+/g, ' ').trim() !== '';\n  }\n  if (Array.isArray(value)) {\n    for (var i = 0; i < value.length; i++) {\n      if (hasText(value[i])) {\n        return true;\n      }\n    }\n    return false;\n  }\n  if (typeof value === 'object') {\n    var keys = Object.keys(value);\n    if (!keys.length) {\n      return false;\n    }\n    var preferredTextFields = ['text', 'content', 'extractedText', 'documentText', 'fileContent'];\n    for (var p = 0; p < preferredTextFields.length; p++) {\n      var fieldName = preferredTextFields[p];\n      if (Object.prototype.hasOwnProperty.call(value, fieldName) && hasText(value[fieldName])) {\n        return true;\n      }\n    }\n    for (var k = 0; k < keys.length; k++) {\n      if (hasText(value[keys[k]])) {\n        return true;\n      }\n    }\n    return false;\n  }\n  return String(value).replace(/[\\s\\u00A0]+/g, ' ').trim() !== '';\n}\n\nvar unifiedDocumentText = null;\ntry {\n  unifiedDocumentText = $context.$variables.prjPjfVarConvUploadedDocumentText;\n} catch (e) {}\n\nvar documentAttached = hasText(unifiedDocumentText);\nreturn {\n  documentAttached: documentAttached,\n  documentProvidedLabel: documentAttached ? 'YES' : 'NO'\n};",
            "returnType": "object"
          },
