30)rb=Math.min(0.5,rb+0.1);if(rb>0)ra=true;}\n  var hardMismatchCount=0;\n  if(s.capitalizableRequired!==null&&x.capitalizableFlag!==null&&x.capitalizableFlag!==s.capitalizableRequired) hardMismatchCount++;\n  if(s.billingRequired!==null&&x.billingFlag!==null&&x.billingFlag!==s.billingRequired) hardMismatchCount++;\n  if(s.burdeningRequired!==null&&x.burdeningFlag!==null&&x.burdeningFlag!==s.burdeningRequired) hardMismatchCount++;\n  var e={id:x.templateId,n:x.templateName,templateDescription:x.templateDescription||\"\",templateDetails:x.templateDetails||null,deterministicScore:deterministicBase+rb,deterministicBaseScore:deterministicBase,hardMismatchCount:hardMismatchCount,scoreBreakdown:{capitalizationAlignment:ca,billingAlignment:bi,burdeningAlignment:bu,businessUnitAlignment:0,projectTypeAlignment:0,recencyBoost:rb},matchedCriteria:{directTemplateReference:{provided:s.hasDirectTemplateReference===true,extractedTemplateName:s.directTemplateName||null,matchType:s.hasDirectTemplateReference===true?\"ranked_fallback\":\"none\"},capitalization:{requested:s.capitalizableRequired,template:x.capitalizableFlag},billing:{requested:s.billingRequired,template:x.billingFlag},burdening:{requested:s.burdeningRequired,template:x.burdeningFlag},businessUnit:{requested:s.businessUnitHint||null,template:x.businessUnitName||null},projectType:{requested:s.projectTypeHint||null,template:x.projectTypeName||null},recency:{lastUsedByUser:recent?recent.lastUsed:null,usageCount:recent?recent.count:0},textRelevance:{matchedTerms:[],matchedPhrases:[]}},businessUnitName:x.businessUnitName||\"\",projectTypeName:x.projectTypeName||\"\",fromDate:x.fromDate||null,toDate:x.toDate||null,billingFlag:x.billingFlag,capitalizableFlag:x.capitalizableFlag,burdeningFlag:x.burdeningFlag,lastUsedByUser:recent?recent.lastUsed:null,usageCount:recent?recent.count:0};\n  o.push(e);\n}\nvar candidates=[];\nfor(var h=0;h<o.length;h++){\n  var y=o[h];\n  candidates.push({templateId:y.id,templateName:y.n,templateDescription:y.templateDescription,businessUnitName:y.businessUnitName,projectTypeName:y.projectTypeName,fromDate:y.fromDate,toDate:y.toDate,billingFlag:y.billingFlag,capitalizableFlag:y.capitalizableFlag,burdeningFlag:y.burdeningFlag,lastUsedByUser:y.lastUsedByUser,usageCount:y.usageCount,deterministicScore:y.deterministicScore,hardMismatchCount:y.hardMismatchCount});\n}\nvar dw=[];if(Array.isArray(f.warnings))dw=dw.concat(f.warnings);if(Array.isArray(direct.warnings))dw=dw.concat(direct.warnings);return {top:o,requestSummary:{businessUnitHint:s.businessUnitHint||null,projectTypeHint:s.projectTypeHint||null,billingRequired:s.billingRequired,capitalizableRequired:s.capitalizableRequired,burdeningRequired:s.burdeningRequired,relevanceTerms:s.relevanceTerms||[],relevancePhrases:s.relevancePhrases||[],directTemplateName:s.directTemplateName||null},candidates:candidates,promptCandidates:JSON.stringify(candidates),recencyApplied:ra===true,directWarnings:dw,dateFilterSummary:{applied:f.dateFilteringApplied===true,fallbackApplied:f.dateFilterFallbackApplied===true,filteredOutCount:f.filteredOutCount||0,projectStartDate:f.projectStartDate||null,projectEndDate:f.projectEndDate||null}};",
