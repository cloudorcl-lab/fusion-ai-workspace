        {
          "metadata": {
            "name": "Build Redwood UI Response",
            "returnType": "string",
            "sourceCode": "function parseJsonSafe(value, fallback) {\n  if (typeof value === 'string') {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return fallback;\n    }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\n\nfunction asObject(value, fallback) {\n  var parsed = parseJsonSafe(value, null);\n  if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {\n    return parsed;\n  }\n  return fallback;\n}\n\nfunction asArray(value) {\n  return Array.isArray(value) ? value : [];\n}\n\nfunction normalizeString(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  if (typeof value === 'object') {\n    try {\n      return JSON.stringify(value).replace(/[\\s\\u00A0]+/g, ' ').trim();\n    } catch (e) {\n      return String(value).replace(/[\\s\\u00A0]+/g, ' ').trim();\n    }\n  }\n  return String(value).replace(/[\\s\\u00A0]+/g, ' ').trim();\n}\n\nfunction toCamelId(value, fallback) {\n  var text = normalizeString(value).toLowerCase();\n  var special = {\n    'task #': 'taskNumber',\n    'task number': 'taskNumber',\n    'task name': 'taskName',\n    'parent task #': 'parentTaskNumber',\n    'parent task number': 'parentTaskNumber',\n    'project name': 'projectName',\n    'project number': 'projectNumber',\n    'business unit': 'businessUnit',\n    'start date': 'startDate',\n    'end date': 'endDate',\n    'template name': 'templateName',\n    'template id': 'templateId',\n    'resource count': 'resourceCount',\n    'resources': 'resources',\n    'field': 'field',\n    'value': 'value'\n  };\n  if (special[text]) {\n    return special[text];\n  }\n  var parts = text.replace(/[^a-z0-9]+/g, ' ').trim().split(/\\s+/).filter(function (part) { return Boolean(part); });\n  if (!parts.length) {\n    return fallback;\n  }\n  var id = parts[0];\n  for (var i = 1; i < parts.length; i++) {\n    id += parts[i].charAt(0).toUpperCase() + parts[i].slice(1);\n  }\n  return id || fallback;\n}\n\nfunction uniqueFieldId(base, used) {\n  var id = base || 'value';\n  var candidate = id;\n  var index = 2;\n  while (used[candidate]) {\n    candidate = id + index;\n    index++;\n  }\n  used[candidate] = true;\n  return candidate;\n}\n\nfunction firstNonEmpty(values) {\n  for (var i = 0; i < values.length; i++) {\n    var value = normalizeString(values[i]);\n    if (value) {\n      return value;\n    }\n  }\n  return '';\n}\n\nfunction extractUrl(value) {\n  var text = normalizeString(value);\n  var match = text.match(/https?:\\/\\/[^\\s\\\"'<>]+/i);\n  return match ? match[0] : '';\n}\n\nfunction toRelativeFscmUiUrl(url) {\n  var text = normalizeString(url);\n  var marker = text.toLowerCase().indexOf(\"fscmui\");\n  if (marker < 0) {\n    return \"\";\n  }\n  return text.substring(marker);\n}\n\nfunction buildRelativeLinkCell(urlValue, linkTextValue) {\n  var relativeUrl = toRelativeFscmUiUrl(extractUrl(urlValue));\n  if (!relativeUrl) {\n    return normalizeString(urlValue);\n  }\n  var linkText = normalizeString(linkTextValue) || normalizeString(urlValue);\n  return '{relativeLink:{url:' + relativeUrl + ',text:' + linkText + '}}';\n}\n\n\nfunction getWorkflowVariable(name) {\n  try {\n    if ($context.$variables && Object.prototype.hasOwnProperty.call($context.$variables, name)) {\n      var value = $context.$variables[name];\n      return value === undefined ? null : value;\n    }\n  } catch (e) {}\n  return null;\n}\n\nfunction buildContextDetails(variableNames) {\n  var details = {};\n  for (var i = 0; i < variableNames.length; i++) {\n    details[variableNames[i]] = getWorkflowVariable(variableNames[i]);\n  }\n  return details;\n}\n\nfunction buildColumns(section, rawRows) {\n  var labels = asArray(section.columns);\n  if (!labels.length && rawRows.length) {\n    if (Array.isArray(rawRows[0])) {\n      for (var i = 0; i < rawRows[0].length; i++) {\n        labels.push('Column ' + (i + 1));\n      }\n    } else if (rawRows[0] && typeof rawRows[0] === 'object') {\n      labels = Object.keys(rawRows[0]);\n    }\n  }\n  if (!labels.length) {\n    labels = ['Value'];\n  }\n\n  var used = {};\n  var columns = [];\n  for (var c = 0; c < labels.length; c++) {\n    var header = normalizeString(labels[c]) || ('Column ' + (c + 1));\n    var field = uniqueFieldId(toCamelId(header, 'column' + (c + 1)), used);\n    columns.push({\n      headerText: header,\n      field: field,\n      className: '',\n      resizable: 'enabled',\n      id: field,\n      template: ''\n    });\n  }\n  return columns;\n}\n\nfunction buildRows(rawRows, columns, linkFields) {\n  var rows = [];\n  for (var r = 0; r < rawRows.length; r++) {\n    var rawRow = rawRows[r];\n    var row = {};\n    if (Array.isArray(rawRow)) {\n      var normalizedArrayValues = [];\n      for (var a = 0; a < columns.length; a++) {\n        normalizedArrayValues.push(normalizeString(rawRow[a]));\n      }\n      for (var c = 0; c < columns.length; c++) {\n        var normalizedValue = normalizedArrayValues[c];\n        var rowTextCandidates = [];\n        for (var ca = 0; ca < normalizedArrayValues.length; ca++) {\n          if (ca !== c) {\n            rowTextCandidates.push(normalizedArrayValues[ca]);\n          }\n        }\n        var url = extractUrl(normalizedValue);\n        if (url && toRelativeFscmUiUrl(url)) {\n          row[columns[c].field] = buildRelativeLinkCell(normalizedValue, firstNonEmpty(rowTextCandidates));\n          linkFields[columns[c].field] = true;\n        } else {\n          row[columns[c].field] = normalizedValue;\n        }\n      }\n    } else if (rawRow && typeof rawRow === 'object') {\n      var normalizedObjectValues = [];\n      for (var v = 0; v < columns.length; v++) {\n        var valueColumn = columns[v];\n        var valueSource = rawRow[valueColumn.field];\n        if (valueSource === undefined) {\n          valueSource = rawRow[valueColumn.headerText];\n        }\n        normalizedObjectValues.push(normalizeString(valueSource));\n      }\n      for (var k = 0; k < columns.length; k++) {\n        var column = columns[k];\n        var sourceValue = normalizedObjectValues[k];\n        var objectTextCandidates = [];\n        for (var co = 0; co < normalizedObjectValues.length; co++) {\n          if (co !== k) {\n            objectTextCandidates.push(normalizedObjectValues[co]);\n          }\n        }\n        var objectUrl = extractUrl(sourceValue);\n        if (objectUrl && toRelativeFscmUiUrl(objectUrl)) {\n          row[column.field] = buildRelativeLinkCell(sourceValue, firstNonEmpty(objectTextCandidates));\n          linkFields[column.field] = true;\n        } else {\n          row[column.field] = sourceValue;\n        }\n      }\n    }\n    rows.push(row);\n  }\n  return rows;\n}\n\nfunction buildTableBlock(section, sequence) {\n  var rawRows = asArray(section.rows);\n  var columns = buildColumns(section, rawRows);\n  var linkFields = {};\n  var rows = buildRows(rawRows, columns, linkFields);\n  for (var c = 0; c < columns.length; c++) {\n    if (linkFields[columns[c].field]) {\n      columns[c].template = 'deepLinkTemplate';\n    }\n  }\n  var key = columns.length ? columns[0].field : 'id';\n  var heading = normalizeString(section.title) || 'Project Initiation Details';\n  return {\n    display_type: 'table',\n    display_sequence: sequence,\n    heading: heading,\n    rows: { items: rows },\n    columns: { items: columns },\n    keyAttributes: { items: [key] },\n    accessibility: {\n      'aria-label': 'This table lists ' + heading + ' for project initiation review',\n      'row.accessible-row-header': key\n    }\n  };\n}\n\nfunction buildListItem(rawItem, index) {\n  var fallbackId = 'item' + (index + 1);\n  if (rawItem && typeof rawItem === 'object' && !Array.isArray(rawItem)) {\n    var defaultText = firstNonEmpty([\n      rawItem.Default,\n      rawItem.default,\n      rawItem.label,\n      rawItem.title,\n      rawItem.name,\n      rawItem.text,\n      rawItem.item,\n      rawItem.value\n    ]);\n    var valueText = firstNonEmpty([rawItem.value, rawItem.Value, defaultText]);\n    var listItem = {\n      id: firstNonEmpty([rawItem.id, rawItem.Id, fallbackId]) || fallbackId,\n      Default: defaultText || valueText || fallbackId,\n      value: valueText || defaultText || fallbackId\n    };\n\n    var optionalFields = ['secondary', 'tertiary', 'quaternary', 'metadata', 'overline'];\n    for (var i = 0; i < optionalFields.length; i++) {\n      var field = optionalFields[i];\n      var fieldValue = normalizeString(rawItem[field]);\n      if (fieldValue) {\n        listItem[field] = fieldValue;\n      }\n    }\n\n    if (rawItem.navigation && typeof rawItem.navigation === 'object') {\n      var label = normalizeString(rawItem.navigation.label);\n      var href = normalizeString(rawItem.navigation.href);\n      if (label && href) {\n        listItem.navigation = { label: label, href: href };\n      }\n    }\n\n    return listItem;\n  }\n\n  var text = normalizeString(rawItem);\n  return {\n    id: fallbackId,\n    Default: text || fallbackId,\n    value: text || fallbackId\n  };\n}\n\nfunction buildListBlock(section, sequence, selectionMode) {\n  var rawItems = asArray(section.items);\n  var items = [];\n  for (var i = 0; i < rawItems.length; i++) {\n    var item = buildListItem(rawItems[i], i);\n    if (normalizeString(item.value) || normalizeString(item.Default)) {\n      items.push(item);\n    }\n  }\n\n  var header = normalizeString(section.title) || 'Project Initiation Items';\n  return {\n    display_type: 'list',\n    display_sequence: sequence,\n    header: header,\n    fields: { items: items },\n    selection_mode: selectionMode || 'none',\n    keyAttributes: { items: ['id'] },\n    accessibility: {\n      'aria-label': 'This list displays ' + header + ' for project initiation review'\n    }\n  };\n}\n\nfunction buildTextFromSection(section, includeTitleWhenNoContent) {\n  var lines = [];\n  var heading = normalizeString(section.title);\n  var content = normalizeString(section.content);\n  if (content) {\n    lines.push(content);\n  } else if (includeTitleWhenNoContent && heading) {\n    lines.push(heading);\n  }\n  return lines.join('\\n');\n}\n\nfunction buildTextBlock(text, sequence, heading) {\n  var block = {\n    display_type: 'text',\n    display_sequence: sequence,\n    text: text\n  };\n  if (heading) {\n    block.heading = heading;\n  }\n  return block;\n}\n\nvar responseModel = asObject($context.$variables.prjPjfVarConvFinalResponseModel, {});\nvar sections = asArray(responseModel.sections);\nvar warnings = asArray(responseModel.warnings);\nvar nextAction = asObject(responseModel.nextAction, {});\nvar title = normalizeString(responseModel.title || responseModel.responseType || 'Project Initiation Result');\nvar description = normalizeString(responseModel.message || responseModel.summary || responseModel.result || title);\nvar intent = normalizeString(responseModel.responseType || (responseModel.context && responseModel.context.intentType) || $context.$variables.prjPjfVarConvLatestUserIntent || 'PROJECT_INITIATION_RESPONSE');\n\nvar blocks = [];\nvar sequence = 1;\nvar leadText = description || title;\nif (leadText) {\n  blocks.push(buildTextBlock(leadText, sequence, title));\n  sequence++;\n}\nfor (var i = 0; i < sections.length; i++) {\n  var section = sections[i] || {};\n  if (section.hideInRedwood === true || normalizeString(section.redwoodDisplay).toLowerCase() === 'hidden') {\n    continue;\n  }\n  var rows = asArray(section.rows);\n  var items = asArray(section.items);\n  if (rows.length) {\n    blocks.push(buildTableBlock(section, sequence));\n    sequence++;\n    continue;\n  }\n\n  var text = buildTextFromSection(section, !items.length);\n  if (text) {\n    blocks.push(buildTextBlock(text, sequence, normalizeString(section.title)));\n    sequence++;\n  }\n\n  if (items.length) {\n    blocks.push(buildListBlock(section, sequence, 'none'));\n    sequence++;\n  }\n}\n\n// Keep warnings in the response model/context for default HTML and diagnostics,\n// but do not render them as visible Redwood response blocks.\n\nvar actions = asArray(nextAction.allowedUserActions).map(function (value) { return normalizeString(value); }).filter(function (value) { return Boolean(value); });\nif (actions.length) {\n  blocks.push({\n    display_type: 'action',\n    display_sequence: sequence,\n    recommendations: { items: actions }\n  });\n  sequence++;\n}\n\nvar redwoodPayload = {\n  agent: 'PRJ_PJF_PROJECT_INITIATION_ASSISTANT_TEAM',\n  intent: intent,\n  schema_version: '1',\n  title: title,\n  description: description,\n  timestamp: new Date().toISOString(),\n  agent_response: blocks\n};\n\nvar conversationVariableNames = [\"prjPjfVarConvResourceCreationHelperResult\", \"prjPjfVarConvProjectProposalDeepLink\", \"prjPjfVarConvProjectOverviewDeepLink\", \"prjPjfVarConvFinancialPlanVersionId\", \"prjPjfVarConvCreatedProjectResult\", \"prjPjfVarConvSessionUserDetails\", \"prjPjfVarConvTaskResourceAssignments\", \"prjPjfVarConvPrimaryPlanningRbsResources\", \"prjPjfVarConvPrimaryPlanningRbsId\", \"prjPjfVarConvFinalProjectTasks\", \"prjPjfVarConvFetchedTemplateTasksForExecutionPlan\", \"prjPjfVarConvSelectedProjectTemplateId\", \"prjPjfVarConvProjectTemplateSelectionResult\", \"prjPjfVarConvExtractedProjectResources\", \"prjPjfVarConvExtractedProjectTasks\", \"prjPjfVarConvExtractedProjectAttributes\", \"prjPjfVarConvRequestedWorkflowObjects\", \"prjPjfVarConvShouldContinueWorkflowLoop\", \"prjPjfVarConvLatestOperationKind\", \"prjPjfVarConvLatestQueryType\", \"prjPjfVarConvLatestControlType\", \"prjPjfVarConvLatestIntentConfidence\", \"prjPjfVarConvProjectValidationResult\", \"prjPjfVarConvProjectValidationErrors\", \"prjPjfVarConvTaskValidationResult\", \"prjPjfVarConvTaskValidationErrors\", \"prjPjfVarConvCreateReadinessValidationResult\", \"prjPjfVarConvCreateReadinessValidationErrors\", \"prjPjfVarConvMissingRequiredProjectAttributes\", \"prjPjfVarConvProjectCreationWarnings\", \"prjPjfVarConvRequirementContext\", \"prjPjfVarConvEffectiveRequirementContext\", \"prjPjfVarConvProjectRequirementContext\", \"prjPjfVarConvTaskRequirementContext\", \"prjPjfVarConvTemplateRequirementContext\", \"prjPjfVarConvLatestUserIntent\", \"prjPjfVarConvUploadedDocumentText\", \"prjPjfVarConvWorkflowStage\", \"prjPjfVarConvLatestUserMessage\", \"prjPjfVarConvFinalResponseModel\", \"prjPjfVarConvHasFinalResponseModel\", \"prjPjfVarConvExtractedProjectMilestones\"];\nvar atomicAgentDetails = {\n  atomicAgentCode: 'PRJ_PJF_PROJECT_INITIATION_ASSISTANT_TEAM',\n  atomicAgentContext: 'Project Creation',\n  contextDetails: buildContextDetails(conversationVariableNames),\n  filters: null,\n  atomicAgentResponse: redwoodPayload\n};\n\nreturn JSON.stringify({\n  redwoodResponse: {\n    type: 'redwood',\n    content: redwoodPayload\n  },\n  atomicAgentDetails: atomicAgentDetails\n});\n"
