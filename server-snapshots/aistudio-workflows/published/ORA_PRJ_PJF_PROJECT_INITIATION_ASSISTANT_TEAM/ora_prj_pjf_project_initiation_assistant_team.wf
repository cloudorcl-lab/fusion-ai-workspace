            "returnType": "boolean",
            "sourceCode": "function normalizeString(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  return String(value).trim();\n}\n\nfunction firstNonEmpty(values) {\n  for (var i = 0; i < values.length; i++) {\n    var value = normalizeString(values[i]);\n    if (value) {\n      return value;\n    }\n  }\n  return '';\n}\n\nvar restInput = {};\ntry {\n  if ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input && typeof $context.$triggers.REST.$input === 'object') {\n    restInput = $context.$triggers.REST.$input;\n  }\n} catch (e) {}\n\nvar prjPjfRoutingContext = firstNonEmpty([\n  restInput.prjPjfRoutingContext,\n  $context.$variables.prjPjfVarConvRoutingContext\n]);\n\nreturn prjPjfRoutingContext.toLowerCase() === 'redwoodui';"
