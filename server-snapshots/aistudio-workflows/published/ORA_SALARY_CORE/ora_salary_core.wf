        {
          "metadata": {
            "name": "formatDbSalaryDetails",
            "returnType": "object",
            "sourceCode": "let dbSalaryDetails = {};\n\nif ($context.$nodes.GETSALARYDETAILS.$output && $context.$nodes.GETSALARYDETAILS.$output.result && $context.$nodes.GETSALARYDETAILS.$output.result.Salary) {\ndbSalaryDetails = $context.$nodes.GETSALARYDETAILS.$output.result.Salary[0];\n}\nelse{\nreturn dbSalaryDetails; \n}\n\nlet getterOutput = $context.$nodes.FINDBYASGIDANDDATE.$output.items[0];\n\ndbSalaryDetails.DateFrom = getterOutput.DateFrom ;\ndbSalaryDetails.DateTo= getterOutput.DateTo;\ndbSalaryDetails.hasFutureSalary= getterOutput.hasFutureSalary;\n\nreturn dbSalaryDetails;"
          },
          "outcomes": {
            "success": "1767789392072"
          },
          "code": "FORMATDBSALARYDETAILS",
          "id": "1767789247681",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
