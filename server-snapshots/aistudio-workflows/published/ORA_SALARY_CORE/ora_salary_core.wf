        {
          "metadata": {
            "name": "constructOutputObjWithPayload",
            "returnType": "object",
            "sourceCode": "let returnObj = {};\nlet curSalaryAmount = $context.$variables.updatedSalaryDetails.SalaryAmount;\n\nif(curSalaryAmount == null){\n    returnObj.error = \"Invalid Flow Name\";\n    return returnObj;\n}\nelse if( $context.$triggers.REST.$input.salaryParams.Frequency &&  $context.$triggers.REST.$input.salaryParams.Frequency.toLowerCase() != $context.$variables.updatedSalaryDetails.FrequencyName.toLowerCase() ){\n    returnObj.error = \"The employee’s salary frequency is \" + $context.$variables.updatedSalaryDetails.FrequencyName + \". Please update the proposed salary to use the same frequency.\" ;\n    return returnObj;\n}\nelse if( $context.$triggers.REST.$input.salaryParams.Currency&&  $context.$triggers.REST.$input.salaryParams.Currency.toLowerCase() != $context.$variables.updatedSalaryDetails.CurrencyCode.toLowerCase() ){\n    returnObj.error = \"The employee’s salary currency is \" + $context.$variables.updatedSalaryDetails.CurrencyCode + \". Please update the proposed salary to use the same currency.\" ;\n    return returnObj;\n}\nelse{\n    curSalaryAmount = Number(curSalaryAmount);\n}\n\nlet newSalaryAmount = $context.$triggers.REST.$input.salaryParams.SalaryAmount;\n\nif (newSalaryAmount == null) {\n    let adjAmount = $context.$triggers.REST.$input.salaryParams.AdjustmentAmount;\n    if (adjAmount == null) {\n      let adjPercentage = Number($context.$triggers.REST.$input.salaryParams.AdjustmentPercentage);\n      newSalaryAmount = curSalaryAmount + (curSalaryAmount * adjPercentage / 100);\n    } else {\n      adjAmount = Number(adjAmount);\n      newSalaryAmount = curSalaryAmount + adjAmount;\n    }\n}\n\n\nnewSalaryAmount = Number(newSalaryAmount);\n\n\nlet rangeErrorWarning = $context.$variables.updatedSalaryDetails.RangeErrorWarning;\nlet rangeMinimum = $context.$variables.updatedSalaryDetails.SalaryRangeMinimum;\nlet rangeMaximum = $context.$variables.updatedSalaryDetails.SalaryRangeMaximum;\n\nif (rangeMinimum != null) {\n    if (newSalaryAmount < Number(rangeMinimum) || newSalaryAmount > Number(rangeMaximum)) {\n        if (rangeErrorWarning == 'ERROR') {\n            returnObj.error = \"Salary is out of the range.\";\n            return returnObj;\n        } else {\n            returnObj.warning = \"Salary is out of the range.\";\n        }\n    }\n}\n\nlet salaryBatchPart = {};\n\nsalaryBatchPart.id = \"createSalary1\";\nsalaryBatchPart.path = \"/compensationSalaries\";\nsalaryBatchPart.operation = \"create\";\n\nlet payload = {};\npayload.AssignmentId = $context.$triggers.REST.$input.assignmentId;\npayload.DateFrom = $context.$triggers.REST.$input.effectiveDate;\npayload.DateTo = $context.$variables.updatedSalaryDetails.DateTo;\npayload.SalaryBasisId = $context.$variables.updatedSalaryDetails.SalaryBasisId;\npayload.ActionId = $context.$triggers.REST.$input.inputParams.ActionId;\npayload.ActionReasonId= $context.$triggers.REST.$input.inputParams.ActionReasonId;\npayload.SalaryAmount= newSalaryAmount;\npayload.NextSalReviewDate = null;\n\nsalaryBatchPart.payload = payload;\n\nlet updatedSalary = $context.$variables.updatedSalaryDetails;\nlet newSalary = {};\nnewSalary.SalaryAmount = newSalaryAmount;\nnewSalary.CurrencyCode = updatedSalary.CurrencyCode;\nnewSalary.FrequencyName = updatedSalary.FrequencyName;\nnewSalary.SalaryBasisName = updatedSalary.DisplayName;\nnewSalary.DateFrom = updatedSalary.DateFrom;\nnewSalary.DateTo = updatedSalary.DateTo;\nnewSalary.LegalEmployerName = updatedSalary.LegalEmployerName;\nnewSalary.ActionName = updatedSalary.ActionName;\nnewSalary.ActionReason = updatedSalary.ActionReason;\nnewSalary.GradeName = updatedSalary.GradeName;\nnewSalary.FTEValue = updatedSalary.FTEValue;\nnewSalary.SalaryRangeMinimum = updatedSalary.SalaryRangeMinimum;\nnewSalary.SalaryRangeMidPoint = updatedSalary.SalaryRangeMidPoint;\nnewSalary.SalaryRangeMaximum = updatedSalary.SalaryRangeMaximum;\n\n\nreturnObj.salaryBatchPart = salaryBatchPart;\nreturnObj.newSalary =  newSalary;\n\nreturnObj.currentSalary = $context.$variables.dbSalaryDetails ;\n\nreturn returnObj;"
          },
          "outcomes": {
            "success": "1767792323669"
          },
          "code": "CONSTRUCTOUTPUTOBJWITHPAYLOAD",
          "id": "1767791679445",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
