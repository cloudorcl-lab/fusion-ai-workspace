        {
          "metadata": {
            "name": "ifEditMode"
          },
          "outcomes": {
            "true": "1767790262094",
            "false": "1767790079358"
          },
          "code": "IFEDITMODE",
          "convergenceTargetId": "1767788861658",
          "id": "1767789481119",
          "inputs": [
            {
              "id": "1767789481121_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.mode == 'edit'}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "createReturnObjWithSalaryData",
            "returnType": "object",
            "sourceCode": "let returnObj = {};\nreturnObj.currentSalary = $context.$variables.dbSalaryDetails ;\n\nif( $context.$variables.dbSalaryDetails.SalaryBasisId == null ) {\nreturnObj.warning = \"Worker doesn't have an existing salary.\";\n}\n\nif( $context.$variables.dbSalaryDetails.SalaryBasisType != null && $context.$variables.dbSalaryDetails.SalaryBasisType != 'U' ) {\nreturnObj.warning = \"Can't update the salary because the salary basis uses components.\";\n}\nelse if ($context.$variables.dbSalaryDetails.PendingTransactionExists == 'Y' ){\nreturnObj.warning = \"Can't update the salary because a salary change is pending approval.\";\n}\n\nreturn returnObj;"
          },
          "outcomes": {
            "success": "1767790144474"
          },
          "code": "CREATERETURNOBJWITHSALARYDATA",
          "id": "1767790079358",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "setReturnObjWithSalaryData"
          },
          "outcomes": {
            "success": "1767788861658"
          },
          "code": "SETRETURNOBJWITHSALARYDATA",
          "id": "1767790144474",
          "inputs": [
            {
              "id": "1767790150140",
              "name": "returnObj",
              "type": "object",
              "value": "{{$context.$nodes.CREATERETURNOBJWITHSALARYDATA.$output.result}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "checkIfEditPossible",
            "returnType": "object",
            "sourceCode": "let returnObj = {};\n\n//salary row not present\nif ($context.$variables.dbSalaryDetails.SalaryBasisId == null) {\n    returnObj.error = \"Can't update the salary because this worker doesn't have an existing salary.\";\n}\n\n//pending salary transaction\nelse if ($context.$variables.dbSalaryDetails.PendingTransactionExists== 'Y'){\n  returnObj.error = \"Can't update the salary because a salary change is pending approval.\";\n}\n\n//salaryBasisType not U\nelse if ($context.$variables.dbSalaryDetails.SalaryBasisType != 'U') {\n  returnObj.error = \"Can't update the salary because the salary basis uses components.\";\n}\n\n// future salary exists\nelse if ($context.$variables.dbSalaryDetails.hasFutureSalary == 'Y') {\n  returnObj.error = \"Can't update the salary because future salary changes exist.\";\n}\n\n// salary correction not supported\nelse if ( $context.$variables.dbSalaryDetails.DateFrom == $context.$triggers.REST.$input.effectiveDate ) {\n  returnObj.error = \"Salary correction isn't supported. A salary record already exists for the specified date.\";\n}\n\n//amount/percentage null \nelse if ($context.$triggers.REST.$input.salaryParams.SalaryAmount == null && $context.$triggers.REST.$input.salaryParams.AdjustmentAmount == null && $context.$triggers.REST.$input.salaryParams.AdjustmentPercentage == null) {\n  returnObj.error = \"Provide a new salary amount, adjustment amount, or adjustment percentage.\";\n}\n\nreturn returnObj;"
          },
          "outcomes": {
            "success": "1767791540653"
          },
          "code": "CHECKIFEDITPOSSIBLE",
          "id": "1767790262094",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
