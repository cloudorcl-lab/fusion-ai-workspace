    "dtRunProfiles": {
      "activeProfileId": "fe07206b-43f8-4d18-8503-8731fa97fb2c",
      "profiles": [
        {
          "id": "fe07206b-43f8-4d18-8503-8731fa97fb2c",
          "name": "with salesMotionContext",
          "type": "rest",
          "agenticAppMode": "query",
          "restConfigJson": "{\n  \"context\": {\n    \"opty_data\": [\n      {\n        \"_entity\": \"Opportunity\",\n        \"OptyId\": 300100648058813,\n        \"Owner\": { \"PartyId\": 100010037456865 },\n        \"CreationDate\": \"2026-05-26T03:48:41.000+0000\",\n        \"ListOfRevenues\": [\n          {\n            \"RevnId\": 300100648058818,\n            \"Primary\": true,\n            \"CrmCurcyCode\": \"USD\",\n            \"RevnAmountCurcyCode_localizedValue\": \"US Dollar\",\n            \"CrmCurcyCode_localizedValue\": \"US Dollar\",\n            \"RevnAmount\": \"1062000\",\n            \"RevnAmountCurcyCode\": \"USD\"\n          },\n          {\n            \"RevnId\": 300100648058826,\n            \"Primary\": false,\n            \"InventoryItemId\": {\n              \"InventoryItemId\": 300100648058785,\n              \"Name_localizedValue\": \"Oracle AI Sales Acceleration Platform\"\n            },\n            \"CrmCurcyCode\": \"USD\",\n            \"RevnAmountCurcyCode_localizedValue\": \"US Dollar\",\n            \"CrmCurcyCode_localizedValue\": \"US Dollar\",\n            \"RevnAmount\": \"1062000\",\n            \"RevnAmountCurcyCode\": \"USD\"\n          }\n        ],\n        \"SalesMethodId\": \"100000012430001\",\n        \"PrConPartyId\": {\n          \"PartyId\": 300100648058716,\n          \"PartyName\": \"Maya Raman\"\n        },\n        \"StatusCode_localizedValue\": \"Open\",\n        \"StatusCode\": \"OPEN\",\n        \"Name\": \"NVIDIA - Executive Acquisition Dashboard R2 07\",\n        \"ListOfContacts\": [\n          {\n            \"OptyConId\": 300100648058832,\n            \"PerPartyId\": {\n              \"PrimaryAddress\": {\n                \"FormattedAddress\": \"4112 Oak Ave,SANTA CLARA, 28289\"\n              },\n              \"PartyNumber\": \"CDRM_1018701\",\n              \"PartyId\": 300100648058716,\n              \"PrimaryPhone\": { \"FormattedPhone\": \"+1 14085550101\" },\n              \"PartyName\": \"Maya Raman\",\n              \"PrimaryEmail\": {\n                \"EmailAddress\": \"maya.raman@nvidia.example.com\"\n              },\n              \"JobTitle\": \"Chief Revenue Officer\"\n            }\n          }\n        ],\n        \"ListOfResourcesForTheTeam\": [\n          {\n            \"ResourceId\": {\n              \"PartyId\": 100010037456865,\n              \"PartyName\": \"Matt Hooper\",\n              \"PrimaryEmail\": {\n                \"EmailAddress\": \"mhoope@4roappdev.onmicrosoft.com\"\n              }\n            },\n            \"OptyResourceId\": 300100648058829\n          }\n        ],\n        \"OptyNumber\": \"CDRM_153644\",\n        \"LastUpdatedBy\": \"MHoope\",\n        \"PrimaryRevenue\": {\n          \"RevnAmountCurcyCode_localizedValue\": \"US Dollar\",\n          \"RevnAmount\": \"1062000\",\n          \"RevnAmountCurcyCode\": \"USD\",\n          \"WinProb\": 15\n        },\n        \"CreatedBy\": \"MHoope\",\n        \"CustomerAccount\": {\n          \"PartyNumber\": \"CDRM_1018700\",\n          \"PartyId\": 300100648058703,\n          \"PartyUniqueName\": \"NVIDIA Corporation Agent Compare 20260526 R2 (Santa Clara, US)\"\n        },\n        \"SalesMethodId_localizedValue\": \"Standard Sales Process\",\n        \"SalesStage\": {\n          \"StgOrderEnum\": \"100000012430005\",\n          \"StgOrderEnum_localizedValue\": \"04 - Presentation\"\n        },\n        \"ListOfLeads\": null,\n        \"EffectiveDate\": \"2026-09-10T00:00:00.000+0000\",\n        \"LastUpdateDate\": \"2026-05-26T03:48:41.320+0000\"\n      }\n    ],\n    \"engagement\": {},\n    \"engagements\": { \"items\": [] },\n    \"insight_data\": \"<b>Sentiment</b>: Positive\\n<div style=\\\"margin-left: 20px;\\\">\\n<ul>\\n  <li><b>Customer Needs</b>: Addressing migration challenges with legacy platform fragmentation, regulated workload readiness, downtime limits, and executive reporting requirements.</li>\\n  <li><b>Risk Mitigation</b>: Compliance and legal teams engaged early; main risks identified as cutover disruption, control validation, and procurement delays with accepted mitigation plans.</li>\\n  <li><b>Buying Process</b>: Customer confirmed decision roles and agreed to include executive sponsors in alignment calls; next buying step depends on a documented business case.</li>\\n  <li><b>Engagement Depth</b>: Multiple detailed calls covering executive alignment, risk and compliance, decision criteria, and discovery with Maya Raman, Chief Revenue Officer.</li>\\n  <li><b>Products</b>: Opportunity involves Oracle AI Sales Acceleration Platform with a revenue amount of 1,062,000 USD.</li>\\n  <li><b>Key Contacts</b>: Maya Raman (Chief Revenue Officer) driving requirements and decision criteria; Matt Hooper (internal owner) coordinating engagement.</li>\\n  <li><b>Sales Stage</b>: Currently in presentation phase with active follow-up appointment scheduled.</li>\\n</ul>\\n</div>\",\n    \"sales_motion_context\": [\n      {\n        \"objectiveId\": \"300100651956191\",\n        \"objectiveStatus\": \"NOT_STARTED\",\n        \"name\": \"Establish Strategic Interest\",\n        \"highValueActivities\": {\n          \"items\": [\n            {\n              \"highValueActivityId\": \"300100651956192\",\n              \"highValueActivityStatus\": \"NOT_STARTED\",\n              \"justification\": \" \",\n              \"name\": \"Position Industry Use Case and Value Realized\",\n              \"description\": \"Position Industry Use Case and Examples of Value Realized\",\n              \"evaluationText\": \"Effectively articulate how Oracle's solutions address the unique challenges and opportunities of the customer's industry, using concrete, relevant use cases that demonstrate measurable outcomes.\"\n            },\n            {\n              \"highValueActivityId\": \"300100651956195\",\n              \"highValueActivityStatus\": \"NOT_STARTED\",\n              \"justification\": \" \",\n              \"name\": \"Position Business Value Proposition\",\n              \"description\": \"Position Business Value Proposition\",\n              \"evaluationText\": \"Clearly articulate how the solution uniquely addresses the customer's business priorities and delivers measurable outcomes through engagement. Completion requires engagement that validates alignment with key stakeholders, delivery of a tailored value presentation, and documented customer acknowledgment of relevance and impact.\"\n            },\n            {\n              \"highValueActivityId\": \"300100651956194\",\n              \"highValueActivityStatus\": \"NOT_STARTED\",\n              \"justification\": \" \",\n              \"name\": \"Deliver personalized Value Center\",\n              \"description\": \"Deliver personalized Value Center\",\n              \"evaluationText\": \"Provide bespoke customer content that provides real-life customer stories and business outcomes that supports the customer‚‚Äôs initiative and creates trust and confidence in selecting Oracle. Tailor the buying experience by providing a centralized, digital hub (Value Center) where prospects and customers access curated content, personalized demos, value propositions, proposals, and relevant collateral. Actions: Set up a dedicated Digital Sales Room (DSR) for each key account or opportunity. Curate content specific to the customer's industry, pain points, and objectives, using Seismic‚Äôs content management features. Use analytics to monitor engagement (what content was viewed/downloaded, which stakeholders interacted). Continuously update the Value Center to reflect new discoveries, address objections, and demonstrate value as the sales process evolves.\"\n            },\n            {\n              \"highValueActivityId\": \"300100651956193\",\n              \"highValueActivityStatus\": \"NOT_STARTED\",\n              \"justification\": \" \",\n              \"name\": \"Present the Business-Centric Differentiation\",\n              \"description\": \"Present the Business-Centric Competitive Differentiation\",\n              \"evaluationText\": \"Clearly articulating how Oracle‚Äôs solutions uniquely address the customer‚Äôs specific business objectives and challenges in ways superior to those of competitors. This is a critical part of the Oracle Sales Process, ensuring the customer perceives clear, relevant, and differentiated value.\"\n            }\n          ]\n        }\n      },\n      {\n        \"objectiveId\": \"300100651956196\",\n        \"objectiveStatus\": \"NOT_STARTED\",\n        \"name\": \"Validate Solution Fit and Buying Intent\",\n        \"highValueActivities\": {\n          \"items\": [\n            {\n              \"highValueActivityId\": \"300100651956197\",\n              \"highValueActivityStatus\": \"NOT_STARTED\",\n              \"justification\": \" \",\n              \"name\": \"Deliver applicable Business Value Assessment\",\n              \"description\": \"Deliver applicable Business Value Assessment\",\n              \"evaluationText\": \"Deliver a tailored Business Value Assessment (BVA) to the customer, demonstrating Oracle's understanding of their business challenges and quantifying the value Oracle solutions can deliver.\"\n            },\n            {\n              \"highValueActivityId\": \"300100651956201\",\n              \"highValueActivityStatus\": \"NOT_STARTED\",\n              \"justification\": \" \",\n              \"name\": \"Invite customer to relevant Marketing Event\",\n              \"description\": \"Invite customer to relevant Marketing Event\",\n              \"evaluationText\": \"This activity involves identifying a customer's interests and business needs, aligning those with upcoming Oracle or partner-hosted marketing events, and extending a personalized invitation. The goal is to foster stronger customer relationships, showcase Oracle's value proposition, and progress sales opportunities by increasing customer engagement and awareness.\"\n            },\n            {\n              \"highValueActivityId\": \"300100651956200\",\n              \"highValueActivityStatus\": \"NOT_STARTED\",\n              \"justification\": \" \",\n              \"name\": \"Deliver and align on Joint Execution Plan\",\n              \"description\": \"Deliver and align on Oracle and Customer Joint Execution Plan\",\n              \"evaluationText\": \"The High Value Activity for sales when delivering and aligning on the Oracle and Customer Joint Execution Plan involves: Collaboratively finalizing a clear, actionable plan with the customer that details roles, responsibilities, timelines, and key milestones for both Oracle and the customer stakeholders. Gaining mutual agreement and commitment from both Oracle and the customer on this plan to ensure alignment around objectives, measures of success, and next steps. Establishing governance and communication cadence (e.g., regular check-ins, progress reviews) to proactively manage risks and keep the plan on track. Ensuring buy-in from executive sponsors on both sides, reinforcing shared accountability and partnership towards achieving the desired business outcomes.\"\n            },\n            {\n              \"highValueActivityId\": \"300100651956199\",\n              \"highValueActivityStatus\": \"NOT_STARTED\",\n              \"justification\": \" \",\n              \"name\": \"Deliver Executive overview and Business benefits\",\n              \"description\": \"Deliver Executive overview and Business benefits of the Fusion Suite\",\n              \"evaluationText\": \"Present Oracle's comprehensive suite of solutions to executive decision-makers within a prospect or existing client's organization. The goal is to: Demonstrate Value: Clearly articulate the business benefits, ROI, and strategic impact of Oracle‚Äôs solutions. Engage Executives: Tailor messaging to the executive audience's business priorities and challenges. Establish Oracle‚Äôs Leadership: Position Oracle as a trusted partner with industry-leading technology and expertise. Drive Next Steps: Secure executives buy-in and advance the sales cycle by aligning on business goals and identifying actionable next steps.\"\n            },\n            {\n              \"highValueActivityId\": \"300100651956198\",\n              \"highValueActivityStatus\": \"NOT_STARTED\",\n              \"justification\": \" \",\n              \"name\": \"Deliver Oracle AI Executive Presentation\",\n              \"description\": \"Deliver Oracle AI Executive Presentation\",\n              \"evaluationText\": \"Present Oracle's Artificial Intelligence (AI) capabilities, solutions, and value propositions to key executive stakeholders at customer organizations. The goal is to position Oracle as a trusted partner in the customer's AI transformation journey, uncover business opportunities, and advance the sales cycle for Oracle AI solutions.\"\n            }\n          ]\n        }\n      }\n    ]\n  },\n  \"insightNumber\": \"\",\n  \"insightId\": \"\",\n  \"puid\": \"\",\n  \"id\": \"\"\n}"
        }
      ]
