        {
          "metadata": {
            "name": "payload for AIOutcome",
            "returnType": "array",
            "sourceCode": "let recomResponse = $context.$nodes.RECOMMENDED_ACTIONS_GENERATION.$output.actions;\n\nconst date = new Date(); \n// Add 30 days\ndate.setDate(date.getDate() + 30); \n\n// Format output\nconst expiryTime = (date.toISOString());\n\nconst effectiveDate = new Date().toISOString();\n\nlet recommendation = recomResponse.map(recom=>({type:recom.Type, label:recom.Title,description:recom.Task,explainability:recom. Expandability}));\n\nlet summary = {\n\"schemaVersion\":\"1.0\",\n  what: {\n    title:\"Opportunity Recommendations\",\n    summary: \"Opportunity Recommendations\",\n  },\n  next: {\"actions\":recommendation}\n}\nlet payload = [\n  {\n    outcomeType: \"RECOMMENDATION\",\n    primaryObjectKey: $context.$triggers.REST.$input.id,\nexpiryTime : expiryTime,\neffectiveDate:effectiveDate,\n    urgency: \"MEDIUM\",\n    payload: JSON.stringify(summary),\n    primaryObjectAltKey: $context.$triggers.REST.$input.puid,\n    category: \"ENGAGEMENT\",\n    generatedBy: \"agent:recommendationAgent/v1\",\n    \"$operation\": \"MERGE\",\n    \"$lookupBy\": {\n      outcomeType: \"RECOMMENDATION\",\n      outcomeSubtype: \"NEXT_STEP_RECOMMENDATION\",\n      category: \"ENGAGEMENT\",\n      primaryObjectType: \"OPPORTUNITY\",\n      primaryObjectAltKey: $context.$triggers.REST.$input.puid,\n    },\n    outcomeSubtype: \"NEXT_STEP_RECOMMENDATION\",\n    primaryObjectType: \"OPPORTUNITY\",\n    status: \"ACTIVE\",\n  },\n];\nreturn payload"
          },
          "outcomes": {
            "success": "1778131866616"
          },
          "code": "PAYLOAD_FOR_AIOUTCOME",
