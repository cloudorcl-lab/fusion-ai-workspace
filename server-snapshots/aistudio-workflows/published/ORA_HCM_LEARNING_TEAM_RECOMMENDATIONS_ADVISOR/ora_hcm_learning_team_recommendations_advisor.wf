        {
          "metadata": {
            "name": "Parse Learning Item Ids",
            "returnType": "object",
            "sourceCode": "const facets = $context.$nodes.GET_LEARNING_RECOMMENDATIONS.$output.facets;\nlet objectTitleFacet = null;\nif (Array.isArray(facets)) {\n  for (let facetIndex = 0; facetIndex < facets.length; facetIndex += 1) {\n    let facet = facets[facetIndex];\n    if (facet && facet.name === \"objectTitle\") {\n      objectTitleFacet = facet;\n      break;\n    }\n  }\n}\nlet ids = [];\nif (objectTitleFacet && Array.isArray(objectTitleFacet.values)) {\n  for (let valueIndex = 0; valueIndex < objectTitleFacet.values.length && ids.length < 4; valueIndex += 1) {\n    let id = Number(objectTitleFacet.values[valueIndex] && objectTitleFacet.values[valueIndex].value);\n    if (Number.isInteger(id) && Number.isFinite(id)) {\n      ids.push(id);\n    }\n  }\n}\nlet result = {\n  learningItemIds: JSON.stringify(ids)\n};\nreturn result;"
          },
          "outcomes": {
            "success": "1771015732507"
          },
