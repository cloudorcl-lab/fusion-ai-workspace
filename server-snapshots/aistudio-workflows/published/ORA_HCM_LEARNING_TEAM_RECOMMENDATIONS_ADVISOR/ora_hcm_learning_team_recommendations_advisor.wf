        {
          "metadata": {
            "name": "Person Information Payload",
            "returnType": "object",
            "sourceCode": "let thisPersonNumber = $context.$nodes.GET_USER_INFO.$output.items[0].PersonNumber;\n\nlet payload = {\n    \"filters\":[\n        {\n            \"name\":\"PersonNumber\",\n            \"term\": thisPersonNumber\n        }\n    ],\n    \"securityFilters\": { \"type\": \"QuickAction\", \"value\": \"EmploymentInformation\", \"context\": \"MyClientGroups\" },\n    \"displayFields\": [\n        \"DisplayName\",\n        \"AssignmentId\",\n        \"PersonId\",\n        \"PersonNumber\"\n    ]\n};\n\nreturn payload;"
          },
          "outcomes": {
            "success": "1768284144718"
          },
          "code": "PERSON_INFORMATION_PAYLOAD",
          "convergenceTargetId": "1768330607062",
          "id": "1768284072506",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
