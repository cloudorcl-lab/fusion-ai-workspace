        {
          "metadata": {
            "name": "Extract Learning Item Details",
            "returnType": "object",
            "sourceCode": "let oraAction = $context.$app.$OraAction;\n\nconst query = oraAction.replace(/^\"+|\"+$/g, '').trim(); \n\nlet params = {}; \n\nfor (const pair of query.split('&')) { \n  if (!pair) continue; \n  const eq = pair.indexOf('='); \n  const key = (eq >= 0 ? pair.slice(0, eq) : pair).trim(); \n  let value = eq >= 0 ? pair.slice(eq + 1) : '';  \n  params[key] = value;\n}\n\nreturn params;"
          },
          "outcomes": {
            "success": "1768325010993"
          },
          "code": "EXTRACT_LEARNING_ITEM_DETAILS",
          "convergenceTargetId": "1768282227592",
          "id": "1768278698401",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Action Type"
          },
          "outcomes": {
