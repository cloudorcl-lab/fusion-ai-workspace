        {
          "metadata": {
            "name": "Extract Enrollment Details",
            "returnType": "object",
            "sourceCode": "const input = $context.$app.$OraAction;\nlet formValues = {};\nlet formId = '';\nconst match = input.match(/<oraFormSubmit\\s+id=[\"']([^\"']*)[\"'][^>]*>(.*?)<\\/oraFormSubmit>/s);\n\nif (match) {\n  formId = match[1];\n  formValues = match[2];\n}\n\nconst formParts = formId.split(\"_\");\nconst learningItemId = formParts[0];\nconst actionType = formParts[1];\n\nif (typeof formValues === 'string') {\n  try {\n    formValues = JSON.parse(formValues);\n  } catch (e) {\n    formValues = [];\n  }\n}\n\nlet submittedDetails = {};\nfor (let valueIndex = 0; valueIndex < formValues.length; valueIndex += 1) {\n  let field = formValues[valueIndex];\n  let matched = String(field.id).match(/assign_([^\">]+)$/);\n  if (matched) {\n    submittedDetails[matched[1]] = field.value;\n  }\n}\n\nfunction parseDateText(value) {\n  const text = String(value || '').slice(0, 10);\n  const match = text.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);\n  if (!match) {\n    return null;\n  }\n  return new Date(Date.UTC(Number(match[1]), Number(match[2]) - 1, Number(match[3])));\n}\n\nfunction formatDate(date) {\n  return date.toISOString().slice(0, 10);\n}\n\nconst currentDateText = String($context.$system.$currentDate || '').slice(0, 10);\nlet currentDate = parseDateText(currentDateText);\nif (!currentDate) {\n  currentDate = new Date();\n  currentDate = new Date(Date.UTC(currentDate.getUTCFullYear(), currentDate.getUTCMonth(), currentDate.getUTCDate()));\n}\nconst minimumDueDateValue = new Date(currentDate.getTime());\nminimumDueDateValue.setUTCDate(minimumDueDateValue.getUTCDate() + 1);\nconst minimumDueDate = formatDate(minimumDueDateValue);\nconst submittedDueDate = String(submittedDetails.assignmentDueDate || '').slice(0, 10);\nconst submittedDate = parseDateText(submittedDueDate);\nconst assignmentDueDateInvalid = !submittedDate || submittedDueDate < minimumDueDate;\n\nsubmittedDetails.learningItemId = learningItemId;\nsubmittedDetails.actionType = actionType;\nsubmittedDetails.assignTo = submittedDetails.assignTo || \"DIRECTS\";\nsubmittedDetails.assignmentMinimumDueDate = minimumDueDate;\nsubmittedDetails.assignmentDueDateInvalid = assignmentDueDateInvalid;\nsubmittedDetails.assignmentValidationMessage = assignmentDueDateInvalid\n  ? 'Assignment due date must be after the assigned on date. Select ' + minimumDueDate + ' or a later date.'\n  : '';\n\nreturn submittedDetails;"
          },
          "outcomes": {
            "success": "1778225000002"
          },
          "code": "EXTRACT_SUBMITTED_DETAILS",
          "convergenceTargetId": "1778225000002",
          "id": "1768282262700",
