            {
              "id": "1768331857797_1",
              "name": "prompt",
              "type": "string",
              "value": "If recommendation_response is empty, output exactly: Recommendation was not possible.\n\nOtherwise:\n- Extract profileCriteria from recommendation_response.\n- Output exactly:\n  Successfully recommended to your <profileCriteria.sourceTypeMeaning>.\n\nDo not include any other text.\n\nINPUT:\n<recommendation_response>{{$context.$nodes.CREATE_RECOMMENDATION.$output}}</recommendation_response>"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_LEARNING_LEARNINGRECOMMENDATIONS",
            "errorNodeId": "1768331857795",
            "functionName": "create_wlfRecommendationProfiles",
            "name": "Create Recommendation"
          },
          "outcomes": {
            "success": "1768331857795"
          },
          "code": "CREATE_RECOMMENDATION",
          "convergenceTargetId": "1768331857795",
          "id": "1768331811526",
          "inputs": [
            {
              "id": "1768331830951_1",
              "name": "payload",
              "type": "string",
              "value": "{{$context.$nodes.RECOMMENDATION_PAYLOAD.$output.result}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Recommendation Payload",
            "returnType": "object",
            "sourceCode": "const details = $context.$nodes.EXTRACT_RECOMMENDATION_DETAILS.$output.result;\nconst recommendationTitle = [\"Recommendation by\", $context.$nodes.GET_USER_INFO.$output.items[0].DisplayName].join(\" - \");\n\nlet payload = {\n    \"recommendationProfileTitle\": recommendationTitle,\n    \"priority\": \"ORA_WLF_RECOM_PRIORITY_DEFAULT\",\n    \"recommendationProfileType\": \"ORA_WLF_RECOM_TYPE_SPECIFIC\",\n    \"recommendationComments\": details.recommendationComments,\n    \"profileCriteria\": [\n        {\n            \"sourceType\": details.assignTo,\n            \"sourceId\": $context.$nodes.GET_PERSON_INFORMATION.$output.items[0].PersonId\n        }\n    ],\n    \"resourceConfig\": [\n        {\n            \"objectCategory\": \"LEARNING_ITEMS\",\n            \"objectId\": details.learningItemId\n        }\n    ],\n    \"recommenderConfig\": [\n        {\n            \"recommendationCategory\": \"ORA_WLF_RECOM_COLLEAGUE\"\n        }\n    ],\n    \"startDate\": $context.$system.$currentDate,\n    \"recommendAs\": \"ORA_RECOM_SELF\",\n    \"processingRule\": \"ORA_WLF_RECOM_PRULE_ONE_TIME\",\n    \"dataSecurityPrivilege\": \"ORA_MANAGER\"\n}\n\nreturn payload;"
          },
          "outcomes": {
            "success": "1768331811526"
          },
          "code": "RECOMMENDATION_PAYLOAD",
          "convergenceTargetId": "1768331811526",
          "id": "1768331578533",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Extract Recommendation Details",
            "returnType": "object",
            "sourceCode": "const input = $context.$app.$OraAction;\nlet formValues = {};\nlet formId = '';\nconst match = input.match(/<oraFormSubmit\\s+id=[\"']([^\"']*)[\"'][^>]*>(.*?)<\\/oraFormSubmit>/s);\n\nif (match) {\n  formId = match[1];\n  formValues = match[2];\n}\n\nconst formParts = formId.split(\"_\");\nconst learningItemId = formParts[0];\nconst actionType = formParts[1];\n\nif (typeof formValues === 'string') {\n  try {\n    formValues = JSON.parse(formValues);\n  } catch (e) {\n    formValues = [];\n  }\n}\n\nlet submittedDetails = {};\nfor (let valueIndex = 0; valueIndex < formValues.length; valueIndex += 1) {\n  let field = formValues[valueIndex];\n  let matched = String(field.id).match(/recommend_([^\">]+)$/);\n  if (matched) {\n    submittedDetails[matched[1]] = field.value;\n  }\n}\n\nsubmittedDetails.learningItemId = learningItemId;\nsubmittedDetails.actionType = actionType;\nsubmittedDetails.assignTo = \"ORA_DIRECTS\";\n\nreturn submittedDetails;"
          },
          "outcomes": {
            "success": "1768331578533"
          },
          "code": "EXTRACT_RECOMMENDATION_DETAILS",
          "convergenceTargetId": "1768331578533",
          "id": "1768330767735",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
      ],
