          "code": "RENDER_ASSIGNMENT_FORM",
          "convergenceTargetId": "1768325056621",
          "id": "1768278932045",
          "inputs": [
            {
              "id": "1768278932046_1",
              "name": "prompt",
              "type": "string",
              "value": "Render a deterministic manager assignment form.\n\nOutput exactly one editable Record form and nothing else.\nDo not summarize, explain, or omit any required field.\n\nContext\n- Learning item title: {{$context.$nodes.EXTRACT_LEARNING_ITEM_DETAILS.$output.result.learningItemTitle}}\n- Learning item id: {{$context.$nodes.EXTRACT_LEARNING_ITEM_DETAILS.$output.result.learningItemId}}\n- Minimum allowed assignment due date: {{$context.$nodes.PREPARE_ASSIGNMENT_DATE_RULES.$output.result.minimumDueDate}}\n- Date validation message: {{$context.$nodes.PREPARE_ASSIGNMENT_DATE_RULES.$output.result.validationMessage}}\n\nForm requirements\n- Form id must be \"<<learningItemId>>_assign\".\n- Render exactly 3 fields in this order:\n  1. Assignment Due Date\n  2. Notes\n  3. Who should receive this assignment?\n- Assignment Due Date must be a date picker.\n- Assignment Due Date default value must be the minimum allowed assignment due date.\n- Assignment Due Date must allow only future dates starting from the minimum allowed assignment due date.\n- Do not allow today or any past date to be selected.\n- The third field must be visible in the form.\n- The third field must be a select/dropdown control.\n- The third field must be shown even when there is only one allowed option.\n- The only allowed option is label \"My Directs\" with value \"DIRECTS\".\n- Default selected value must be \"DIRECTS\".\n\nDo not add or remove fields."
            }
          ],
          "type": "LLM"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
