        {
          "metadata": {
            "name": "Prepare Recommendations Display",
            "returnType": "object",
            "sourceCode": "const facets = $context.$nodes.GET_LEARNING_RECOMMENDATIONS.$output.facets;\nlet objectTitleFacet = null;\nif (Array.isArray(facets)) {\n  for (let facetIndex = 0; facetIndex < facets.length; facetIndex += 1) {\n    let facet = facets[facetIndex];\n    if (facet && facet.name === \"objectTitle\") {\n      objectTitleFacet = facet;\n      break;\n    }\n  }\n}\nlet facetValues = [];\nif (objectTitleFacet && Array.isArray(objectTitleFacet.values)) {\n  facetValues = objectTitleFacet.values;\n}\nlet countsById = {};\nfor (let valueIndex = 0; valueIndex < facetValues.length; valueIndex += 1) {\n  let entry = facetValues[valueIndex];\n  let id = Number(entry && entry.value);\n  if (Number.isInteger(id) && Number.isFinite(id) && countsById[id] == null) {\n    let parsedCount = Number(entry && entry.count);\n    countsById[id] = Number.isFinite(parsedCount) ? parsedCount : 0;\n  }\n}\nlet items = [];\nif (Array.isArray($context.$nodes.GET_LEARNING_ITEMS_FROM_CATALOG.$output.items)) {\n  items = $context.$nodes.GET_LEARNING_ITEMS_FROM_CATALOG.$output.items;\n}\nlet candidateRows = [];\nfor (let itemIndex = 0; itemIndex < items.length; itemIndex += 1) {\n  let item = items[itemIndex];\n  let learningItemId = Number(item && item.learningItemId);\n  let learningTitle = String((item && item.learningItemTitle) || \"\").trim();\n  let learningFormat = String((item && (item.learningItemDisplayTypeMeaning || item.learningItemTypeMeaning)) || \"\").trim();\n  let summary = String((item && (item.liShortDescription || item.learningItemDescription || item.learningItemTitle)) || \"\").trim();\n  let recommendationCount = countsById[learningItemId];\n  if (learningTitle && learningFormat && summary && Number.isFinite(recommendationCount)) {\n    let assignAction = 'ora.Invoke(assignLearning, \"learningItemId=' + learningItemId + '&learningItemTitle=' + encodeURIComponent(learningTitle) + '&actionType=assign\")';\n    candidateRows.push({\n      learningItemId: learningItemId,\n      learningTitle: learningTitle,\n      learningFormat: learningFormat,\n      summary: summary,\n      recommendationCount: recommendationCount,\n      assignAction: assignAction\n    });\n  }\n}\nlet rows = [];\nwhile (candidateRows.length > 0 && rows.length < 4) {\n  let bestIndex = 0;\n  for (let candidateIndex = 1; candidateIndex < candidateRows.length; candidateIndex += 1) {\n    let current = candidateRows[candidateIndex];\n    let best = candidateRows[bestIndex];\n    let isBetter = false;\n    if (current.recommendationCount > best.recommendationCount) {\n      isBetter = true;\n    } else if (current.recommendationCount === best.recommendationCount && current.learningTitle.localeCompare(best.learningTitle) < 0) {\n      isBetter = true;\n    }\n    if (isBetter) {\n      bestIndex = candidateIndex;\n    }\n  }\n  rows.push(candidateRows[bestIndex]);\n  candidateRows.splice(bestIndex, 1);\n}\nfor (let rowIndex = 0; rowIndex < rows.length; rowIndex += 1) {\n  rows[rowIndex].displayOrder = rowIndex + 1;\n}\nlet result = {\n  asOfDate: $context.$system.$currentDate,\n  totalDisplayed: rows.length,\n  emptyStateTitle: \"No recommended learning available\",\n  emptyStateDescription: \"No high-value learning recommendations are available for your directs right now.\",\n  rows: rows\n};\nreturn result;"
          },
          "outcomes": {
            "success": "1768345424498"
          },
