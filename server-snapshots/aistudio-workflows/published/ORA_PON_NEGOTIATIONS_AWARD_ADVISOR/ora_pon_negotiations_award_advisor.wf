          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"Generated schema for Root\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"AuctionHeaderId\": {\n            \"type\": \"number\"\n          },\n          \"RecommendedAwardId\": {\n            \"type\": \"number\"\n          },\n          \"Supplier\": {\n            \"type\": \"string\"\n          },\n          \"SupplierId\": {\n            \"type\": \"number\"\n          },\n          \"SupplierContactId\": {\n            \"type\": \"number\"\n          },\n          \"CurrencyCode\": {\n            \"type\": \"string\"\n          },\n          \"SupplierSite\": {\n            \"type\": \"string\"\n          },\n          \"SupplierSiteId\": {\n            \"type\": \"number\"\n          },\n          \"ShortlistFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"ResponseAmount\": {\n            \"type\": \"number\"\n          },\n          \"CompositeScore\": {\n            \"type\": \"number\"\n          },\n          \"TransformedRank\": {\n            \"type\": \"number\"\n          },\n          \"CompositeRank\": {\n            \"type\": \"number\"\n          },\n          \"VendorId\": {\n            \"type\": \"number\"\n          },\n          \"ResponseNumber\": {\n            \"type\": \"number\"\n          },\n          \"RecommendedAwardAmount\": {\n            \"type\": \"number\"\n          },\n          \"PotentialSavingsAmount\": {\n            \"type\": \"number\"\n          },\n          \"NumberOfAwardedLines\": {\n            \"type\": \"number\"\n          },\n          \"SupplierContact\": {\n            \"type\": \"string\"\n          },\n          \"PotentialSavingsPercentage\": {\n            \"type\": \"number\"\n          },\n          \"Score\": {},\n          \"lines\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"items\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"Item\": {\n                      \"type\": \"string\"\n                    },\n                    \"UnitOfMeasure\": {\n                      \"type\": \"string\"\n                    },\n                    \"AuctionHeaderId\": {\n                      \"type\": \"number\"\n                    },\n                    \"LineId\": {\n                      \"type\": \"number\"\n                    },\n                    \"Description\": {\n                      \"type\": \"string\"\n                    },\n                    \"AwardQuantity\": {\n                      \"type\": \"number\"\n                    },\n                    \"RecommendedAwardId\": {\n                      \"type\": \"number\"\n                    },\n                    \"ResponseNumber\": {\n                      \"type\": \"number\"\n                    },\n                    \"ResponsePrice\": {\n                      \"type\": \"number\"\n                    },\n                    \"Rank\": {\n                      \"type\": \"number\"\n                    },\n                    \"ResponseQuantity\": {\n                      \"type\": \"number\"\n                    },\n                    \"CurrentPrice\": {\n                      \"type\": \"number\"\n                    },\n                    \"SavingsAmount\": {\n                      \"type\": \"number\"\n                    },\n                    \"AwardAmount\": {\n                      \"type\": \"number\"\n                    },\n                    \"SavingsPercentage\": {\n                      \"type\": \"number\"\n                    },\n                    \"Line\": {\n                      \"type\": \"string\"\n                    },\n                    \"ItemRevision\": {\n                      \"type\": \"string\"\n                    },\n                    \"AgreementQuantity\": {\n                       \"type\": \"number\"\n                    },\n                    \"TargetPrice\": {\n                       \"type\": \"number\"\n                    }\n                  },\n                  \"required\": [\n                    \"Item\",\n                    \"AuctionHeaderId\",\n                    \"LineId\",\n                    \"Description\",\n                    \"AwardQuantity\",\n                    \"RecommendedAwardId\",\n                    \"ResponseNumber\",\n                    \"ResponsePrice\",\n                    \"Rank\",\n                    \"ResponseQuantity\",\n                    \"CurrentPrice\",\n                    \"SavingsAmount\",\n                    \"AwardAmount\",\n                    \"SavingsPercentage\",\n                    \"Line\",\n                    \"ItemRevision\",\n                    \"AgreementQuantity\",\n                    \"TargetPrice\"\n                  ]\n                }\n              }\n            },\n            \"required\": [\n              \"items\"\n            ]\n          }\n        },\n        \"required\": [\n          \"AuctionHeaderId\",\n          \"RecommendedAwardId\",\n          \"Supplier\",\n          \"SupplierId\",\n          \"SupplierContactId\",\n          \"CurrencyCode\",\n          \"SupplierSiteId\",\n          \"ShortlistFlag\",\n          \"ResponseAmount\",\n          \"CompositeScore\",\n          \"TransformedRank\",\n          \"CompositeRank\",\n          \"VendorId\",\n          \"ResponseNumber\",\n          \"RecommendedAwardAmount\",\n          \"PotentialSavingsAmount\",\n          \"NumberOfAwardedLines\",\n          \"SupplierContact\",\n          \"PotentialSavingsPercentage\",\n          \"Score\",\n          \"lines\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"items\"\n  ]\n}",
