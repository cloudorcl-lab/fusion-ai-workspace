            "name": "Facets Mapped?",
            "returnType": "boolean",
            "sourceCode": "(() => {\n  try {\n    const raw = $context?.$nodes?.CREATE_FACET_LOVS_PAYLOAD?.$output;\n    const obj = typeof raw === \"string\" ? JSON.parse(raw) : raw; \n    // Unwrap common wrappers\n    const pl = obj?.payload ?? obj?.body_template ?? obj;\n\n   // Facets might be an array or a JSON string\n   const f = pl?.facets;\n   const facets = typeof f === \"string\" ? JSON.parse(f) : f;\n\n   return Array.isArray(facets) && facets.length > 0;\n\n  } catch {\n    return false;\n  }\n})()"
          },
