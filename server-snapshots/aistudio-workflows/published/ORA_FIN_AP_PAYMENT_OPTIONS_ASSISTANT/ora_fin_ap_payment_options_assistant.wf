              "value": "{{($context.$nodes.FIN_AP_CODE_VERIFY_NER_RESULT.$output.result.hasNERError === true && $context.$nodes.FIN_AP_LLM_GET_REQUESTED_ARTIFACT_DETAILS.$output.resolvedAmbiguityFromList !== true) || ( $context.$nodes.FIN_AP_LLM_GET_REQUESTED_ARTIFACT_DETAILS.$output.ambiguousMessage != null && $context.$nodes.FIN_AP_LLM_GET_REQUESTED_ARTIFACT_DETAILS.$output.ambiguousMessage !== \"\")}}"
            }
          ],
