          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"settlementDays\": {\n            \"type\": \"number\"\n          },\n          \"businessUnitId\": {\n            \"type\": \"number\"\n          },\n          \"allowFinalMatchingFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"allowMatchingDistributionOverrideFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"allowForceApprovalFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"allowAdjustmentsToPaidInvoicesFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"allowRemitToSupplierOverrideForThirdPartyPaymentsFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"allowPayeeOverrideForThirdPartyPaymentsFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"allowOverrideOfSupplierSiteBankAccountFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"alwaysTakeDiscFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"requireAccountingBeforeApproval\": {\n            \"type\": \"string\"\n          },\n          \"enableInvoiceApprovalFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"createInterestInvoicesFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"bankChargeDeductionType\": {\n            \"type\": \"null\"\n          },\n          \"budgetDateBasis\": {\n            \"type\": \"string\"\n          },\n          \"useDistributionFromPurchaseOrderFlag\": {\n            \"type\": \"null\"\n          },\n          \"discountAllocationMethod\": {\n            \"type\": \"string\"\n          },\n          \"excludeTaxFromDiscountCalculationFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"paymentRequestPaymentPriority\": {\n            \"type\": \"number\"\n          },\n          \"paymentRequestPayGroup\": {\n            \"type\": \"null\"\n          },\n          \"excludeFreightFromDiscountCalculationFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"glDateFromReceiptFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"minimumInterestAmount\": {\n            \"type\": \"number\"\n          },\n          \"invoiceCurrency\": {\n            \"type\": \"string\"\n          },\n          \"allowInvoiceDocumentCategoryOverrideFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"lastUpdateDate\": {\n            \"type\": \"string\"\n          },\n          \"requireConversionRateEntryForPaymentsFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"paymentCurrency\": {\n            \"type\": \"string\"\n          },\n          \"payDateBasis\": {\n            \"type\": \"string\"\n          },\n          \"allowPaymentDocumentCategoryOverrideFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"paymentPriority\": {\n            \"type\": \"number\"\n          },\n          \"allowPaymentDateBeforeTheSystemDateFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"showAvailablePrepaymentsDuringInvoiceEntryFlag\": {\n            \"type\": \"null\"\n          },\n          \"interestAllocationMethodFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"recalculateInvoiceInstallmentsFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"receiptAcceptanceDays\": {\n            \"type\": \"number\"\n          },\n          \"enableInvoiceAccountCodingWorkflowFlag\": {\n            \"type\": \"null\"\n          },\n          \"allowInvoiceBackdatingForSelfServiceInvoicesFlag\": {\n            \"type\": \"null\"\n          },\n          \"limitInvoiceToSinglePurchaseOrderForSelfServiceInvoicesFlag\": {\n            \"type\": \"null\"\n          },\n          \"allowUnitPriceChangeForQuantityBasedMatchesForSelfServiceInvoices\": {\n            \"type\": \"null\"\n          },\n          \"termsDateBasis\": {\n            \"type\": \"string\"\n          },\n          \"transferPOdistributionAdditionalInformationFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"requireValidationBeforeApprovalFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"payGroup\": {\n            \"type\": \"null\"\n          },\n          \"accountForPayment\": {\n            \"type\": \"string\"\n          },\n          \"lastUpdateLogin\": {\n            \"type\": \"string\"\n          },\n          \"lastUpdatedBy\": {\n            \"type\": \"string\"\n          },\n          \"createdBy\": {\n            \"type\": \"string\"\n          },\n          \"creationDate\": {\n            \"type\": \"string\"\n          },\n          \"businessUnitName\": {\n            \"type\": \"string\"\n          },\n          \"paymentRequestPaymentTerms\": {\n            \"type\": \"string\"\n          },\n          \"interestExpenseDistribution\": {\n            \"type\": \"null\"\n          },\n          \"prepaymentPaymentTerms\": {\n            \"type\": \"string\"\n          },\n          \"amountTolerances\": {\n            \"type\": \"null\"\n          },\n          \"paymentTerms\": {\n            \"type\": \"string\"\n          },\n          \"quantityTolerances\": {\n            \"type\": \"null\"\n          },\n          \"ledgerId\": {\n            \"type\": \"number\"\n          },\n          \"ledgerCurrency\": {\n            \"type\": \"string\"\n          },\n          \"federalIdentificationNumber\": {\n            \"type\": \"null\"\n          },\n          \"locationId\": {\n            \"type\": \"null\"\n          },\n          \"allowAddressChange\": {\n            \"type\": \"string\"\n          },\n          \"IncomeTaxCombinedFilingProgram\": {\n            \"type\": \"string\"\n          },\n          \"incomeTaxRegion\": {\n            \"type\": \"null\"\n          },\n          \"supplierTaxRegion\": {\n            \"type\": \"string\"\n          },\n          \"USSGLTransactionCode\": {\n            \"type\": \"null\"\n          },\n          \"USSGLTrxDescriptiveFlexfieldContext\": {\n            \"type\": \"null\"\n          },\n          \"includeWitholdingDistInIncometaxreports\": {\n            \"type\": \"string\"\n          },\n          \"requireInvoiceGroup\": {\n            \"type\": \"string\"\n          },\n          \"attachmentMandatoryForSelfServiceInvoicesFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"disallowAttachmentDeleteFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"AccountingDateBasis\": {\n            \"type\": \"string\"\n          },\n          \"links\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"properties\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"changeIndicator\": {\n                      \"type\": \"string\"\n                    }\n                  },\n                  \"required\": [\n                    \"changeIndicator\"\n                  ],\n                  \"additionalProperties\": false\n                },\n                \"rel\": {\n                  \"type\": \"string\"\n                },\n                \"href\": {\n                  \"type\": \"string\"\n                },\n                \"name\": {\n                  \"type\": \"string\"\n                },\n                \"kind\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"required\": [\n                \"rel\",\n                \"href\",\n                \"name\",\n                \"kind\"\n              ],\n              \"additionalProperties\": true\n            }\n          }\n        },\n        \"required\": [\n          \"settlementDays\",\n          \"businessUnitId\",\n          \"allowFinalMatchingFlag\",\n          \"allowMatchingDistributionOverrideFlag\",\n          \"allowForceApprovalFlag\",\n          \"allowAdjustmentsToPaidInvoicesFlag\",\n          \"allowRemitToSupplierOverrideForThirdPartyPaymentsFlag\",\n          \"allowPayeeOverrideForThirdPartyPaymentsFlag\",\n          \"allowOverrideOfSupplierSiteBankAccountFlag\",\n          \"alwaysTakeDiscFlag\",\n          \"requireAccountingBeforeApproval\",\n          \"enableInvoiceApprovalFlag\",\n          \"createInterestInvoicesFlag\",\n          \"bankChargeDeductionType\",\n          \"budgetDateBasis\",\n          \"useDistributionFromPurchaseOrderFlag\",\n          \"discountAllocationMethod\",\n          \"excludeTaxFromDiscountCalculationFlag\",\n          \"paymentRequestPaymentPriority\",\n          \"paymentRequestPayGroup\",\n          \"excludeFreightFromDiscountCalculationFlag\",\n          \"glDateFromReceiptFlag\",\n          \"minimumInterestAmount\",\n          \"invoiceCurrency\",\n          \"allowInvoiceDocumentCategoryOverrideFlag\",\n          \"lastUpdateDate\",\n          \"requireConversionRateEntryForPaymentsFlag\",\n          \"paymentCurrency\",\n          \"payDateBasis\",\n          \"allowPaymentDocumentCategoryOverrideFlag\",\n          \"paymentPriority\",\n          \"allowPaymentDateBeforeTheSystemDateFlag\",\n          \"showAvailablePrepaymentsDuringInvoiceEntryFlag\",\n          \"interestAllocationMethodFlag\",\n          \"recalculateInvoiceInstallmentsFlag\",\n          \"receiptAcceptanceDays\",\n          \"enableInvoiceAccountCodingWorkflowFlag\",\n          \"allowInvoiceBackdatingForSelfServiceInvoicesFlag\",\n          \"limitInvoiceToSinglePurchaseOrderForSelfServiceInvoicesFlag\",\n          \"allowUnitPriceChangeForQuantityBasedMatchesForSelfServiceInvoices\",\n          \"termsDateBasis\",\n          \"transferPOdistributionAdditionalInformationFlag\",\n          \"requireValidationBeforeApprovalFlag\",\n          \"payGroup\",\n          \"accountForPayment\",\n          \"lastUpdateLogin\",\n          \"lastUpdatedBy\",\n          \"createdBy\",\n          \"creationDate\",\n          \"businessUnitName\",\n          \"paymentRequestPaymentTerms\",\n          \"interestExpenseDistribution\",\n          \"prepaymentPaymentTerms\",\n          \"amountTolerances\",\n          \"paymentTerms\",\n          \"quantityTolerances\",\n          \"ledgerId\",\n          \"ledgerCurrency\",\n          \"federalIdentificationNumber\",\n          \"locationId\",\n          \"allowAddressChange\",\n          \"IncomeTaxCombinedFilingProgram\",\n          \"incomeTaxRegion\",\n          \"supplierTaxRegion\",\n          \"USSGLTransactionCode\",\n          \"USSGLTrxDescriptiveFlexfieldContext\",\n          \"includeWitholdingDistInIncometaxreports\",\n          \"requireInvoiceGroup\",\n          \"attachmentMandatoryForSelfServiceInvoicesFlag\",\n          \"disallowAttachmentDeleteFlag\",\n          \"AccountingDateBasis\",\n          \"links\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ],\n  \"additionalProperties\": false\n}"
        },
