          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get Top 5 BU Name List",
            "returnType": "array",
            "sourceCode": "let apiResponse = $context.$nodes.FIN_AP_BUSINESS_OBJECT_FUNCTION_GET_5_BU_SUGGESTION.$output.items || [];\n\nlet businessUnitNames = [];\n\nfor (const bu of apiResponse) {\n    businessUnitNames.push(bu.name);\n}\n\nreturn businessUnitNames;"
          },
          "outcomes": {
            "success": "1770714150167"
