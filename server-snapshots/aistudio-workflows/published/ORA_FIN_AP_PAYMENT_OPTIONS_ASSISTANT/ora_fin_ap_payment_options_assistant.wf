        {
          "metadata": {
            "name": "Evaluate Single BU Suggestion",
            "returnType": "object",
            "sourceCode": "const items = $context.$nodes.FIN_AP_BUSINESS_OBJECT_FUNCTION_GET_5_BU_SUGGESTION.$output?.items || [];\nconst identifiedBusinessUnits = Array.isArray($context.$variables.identifiedBusinessUnits)\n  ? [...$context.$variables.identifiedBusinessUnits]\n  : [];\n\nlet exists = false;\nlet businessUnit = null;\n\nif (items.length === 1) {\n  businessUnit = {\n    entity: \"Business unit\",\n    id: items[0].$id,\n    name: items[0].name,\n    source: \"EV\",\n    score: 100\n  };\n\n  for (const bu of identifiedBusinessUnits) {\n    if (String(bu.id) === String(businessUnit.id) && bu.name === businessUnit.name) {\n      exists = true;\n      break;\n    }\n  }\n}\n\nconst shouldAddBusinessUnit = items.length === 1 && !exists;\n\nif (shouldAddBusinessUnit) {\n  identifiedBusinessUnits.push(businessUnit);\n}\n\nreturn {\n  shouldAddBusinessUnit,\n  identifiedBusinessUnits,\n  businessUnit\n};"
          },
          "outcomes": {
            "success": "1781162907365"
          },
          "diagram": {
