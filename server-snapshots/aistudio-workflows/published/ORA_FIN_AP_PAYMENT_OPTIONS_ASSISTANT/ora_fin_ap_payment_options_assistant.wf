        {
          "metadata": {
            "name": "Validate BU and Currency",
            "returnType": "object",
            "sourceCode": "const businessUnitName = $context.$variables.businessUnitName;\nconst currency = $context.$variables.currencyCode;\n\nlet result = {\n    \"validBusinessUnitAndCurrency\": true,\n    \"status\": \"Valid Business Unit and Currency Details\",\n    \"buMissing\": false\n}\n\nconst isEmpty = (val) =>\n  val === null || val === undefined || String(val).trim() === '';\n\nif (isEmpty(businessUnitName) && isEmpty(currency)) {\n  result.validBusinessUnitAndCurrency = false;\n  result.status = \"Business Unit and Currency Details are Missing\";\n  result.buMissing = true;\n} else if (isEmpty(businessUnitName)) {\n  result.validBusinessUnitAndCurrency = false;\n  result.status = \"Business Unit Detail Is Missing\";\n  result.buMissing = true;\n} else if (isEmpty(currency)) {\n  result.validBusinessUnitAndCurrency = false;\n  result.status = \"Currency Detail Is Missing\";\n  result.buMissing = false;\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1768234757827"
          },
