          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Content Summarizer For Missing Information Collector",
            "returnType": "array",
            "sourceCode": "let missingObjectStatus = $context.$nodes.FIN_AP_CODE_VALIDATE_BU_AND_CURRENCY.$output.result.status;\n\nlet result = []\n\nif (missingObjectStatus === 'Business Unit and Currency Details are Missing') {\n  result =  [\n    {\n      type: \"text\",\n      content: \"Please provide the Business Unit and the Currency.\",\n      sequence: 1\n    },\n    {\n      type: \"list\",\n      heading: \"Business Unit suggestions:\",\n      content: $context.$nodes.FIN_AP_CODE_GET_TOP_5_BU_NAME_LIST.$output.result,\n      sequence: 2\n    }\n  ];\n} else if (missingObjectStatus === 'Business Unit Detail Is Missing') {\n  result = [\n    {\n      type: \"text\",\n      content: \"Please provide the Business Unit.\",\n      sequence: 1\n    },\n    {\n      type: \"list\",\n      heading: \"Business Unit suggestions:\",\n      content: $context.$nodes.FIN_AP_CODE_GET_TOP_5_BU_NAME_LIST.$output.result,\n      sequence: 2\n    }\n  ];\n} else {\n  result =  [\n    {\n      type: \"text\",\n      content: \"Please provide the Currency.\",\n      sequence: 1\n    }\n  ];\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1771252233926"
          },
