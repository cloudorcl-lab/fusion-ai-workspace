            "name": "Extract Spend Response Context",
            "sourceCode": "let spendOutput =\n  $context.$nodes.FIN_AP_SPEND_ANALYSIS_WORKFLOW.$output.output;\n\nif (typeof spendOutput === \"string\") {\n  try {\n    spendOutput = JSON.parse(spendOutput);\n  } catch (e) {\n    spendOutput = { message: spendOutput };\n  }\n}\n\nconst response = Array.isArray(spendOutput)\n  ? spendOutput\n  : Array.isArray(spendOutput?.output)\n    ? spendOutput.output\n    : typeof spendOutput?.message === \"string\" &&\n        spendOutput.message.trim() !== \"\"\n      ? [\n          {\n            type: \"text\",\n            content: spendOutput.message,\n            sequence: 1\n          }\n        ]\n      : [];\n\nreturn {\n  response,\n  supplierSpendOffset: Number.isFinite(Number(spendOutput?.offset))\n    ? Number(spendOutput.offset)\n    : 0\n};",
