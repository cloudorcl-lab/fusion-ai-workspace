            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Verify NER Result",
            "returnType": "object",
            "sourceCode": "const nerResult = $context.$nodes.FIN_AP_BUSINESS_OBJECT_FUNCTION_NAMED_ENTITY_RECOGNITION_SERVICE.$output;\n\nconst existingBusinessUnits = Array.isArray($context.$variables.identifiedBusinessUnits)\n  ? [...$context.$variables.identifiedBusinessUnits]\n  : [];\n\nconst exitingSuppliers = Array.isArray($context.$variables.identifiedSuppliers)\n  ? [...$context.$variables.identifiedSuppliers]\n  : [];\n\nconst exitingPaymentTerms = Array.isArray($context.$variables.identifiedPaymentTerms)\n  ? [...$context.$variables.identifiedPaymentTerms]\n  : [];\n\nconst exitingLegalEntities = Array.isArray($context.$variables.identifiedLegalEntities)\n  ? [...$context.$variables.identifiedLegalEntities]\n  : [];\n\nlet result = {\n  hasNERError: false,\n  identifiedBusinessUnits: existingBusinessUnits,\n  identifiedSuppliers: exitingSuppliers,\n  identifiedPaymentTerms: exitingPaymentTerms,\n  identifiedLegalEntities: exitingLegalEntities,\n  ambiguousEntities: []\n};\n\nif (nerResult.status === \"NO_MATCHES\" || nerResult.status === \"not_found\") {\n  result.hasNERError = true;\n} else {\n  for (let match of nerResult.matches) {\n   if (match.matchStatus === \"unique\"){\n       for (let uniqueEntities of match.entities){\n           switch (uniqueEntities.entity) {\n              case \"Business unit\":\n                result.identifiedBusinessUnits.push(uniqueEntities);\n                break;\n              case \"Supplier\":\n                result.identifiedSuppliers.push(uniqueEntities);\n                break;\n              case \"Payment Term\":\n                result.identifiedPaymentTerms.push(uniqueEntities);\n                break;\n              case \"Legal Entity\":\n                result.identifiedLegalEntities.push(uniqueEntities);\n                break;\n            }\n       }\n   } else if (match.matchStatus === \"ambiguous\"){\n       for (let ambiguousEntities of match.entities){\n            if (ambiguousEntities.score === 100){\n              switch (ambiguousEntities.entity) {\n                case \"Business unit\":\n                  result.identifiedBusinessUnits.push(ambiguousEntities);\n                  break;\n                case \"Supplier\":\n                  result.identifiedSuppliers.push(ambiguousEntities);\n                  break;\n                case \"Payment Term\":\n                  result.identifiedPaymentTerms.push(ambiguousEntities);\n                  break;\n                case \"Legal Entity\":\n                  result.identifiedLegalEntities.push(ambiguousEntities);\n                  break;\n              }\n            } else {\n                result.hasNERError = true;\n                result.ambiguousEntities.push(ambiguousEntities);\n            }\n       }\n   }\n   else if (match.matchStatus === \"NO_MATCHES\" || match.matchStatus === \"not_found\"){\n        result.hasNERError = true;\n        result.ambiguousEntities.push(match.keyword);\n    }\n  }\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1771308819890"
          },
          "diagram": {
            "x": 8262.5,
            "y": 7924
          },
          "code": "FIN_AP_CODE_VERIFY_NER_RESULT",
