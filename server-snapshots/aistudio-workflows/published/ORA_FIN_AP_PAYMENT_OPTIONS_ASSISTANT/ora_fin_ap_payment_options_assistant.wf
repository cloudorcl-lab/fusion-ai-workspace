          "code": "FIN_AP_BUSINESS_OBJECT_FUNCTION_NAMED_ENTITY_RECOGNITION_SERVICE",
          "id": "1770808965917",
          "inputs": [
            {
              "id": "1770810458011_2",
              "name": "input",
              "value": "{{$context.$nodes.FIN_AP_LLM_SUPERVISOR_AGENT.$output.nerString}}",
              "required": true
            },
            {
              "id": "1770810458010_1",
              "name": "keywords",
              "value": "{{$context.$nodes.FIN_AP_LLM_SUPERVISOR_AGENT.$output.nerExtractedKeywords}}",
