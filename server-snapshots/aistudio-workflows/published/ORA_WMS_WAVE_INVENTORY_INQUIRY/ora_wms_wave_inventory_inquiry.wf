          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"wavenumber\": {\n            \"type\": \"string\"\n        },\n        \"containernumber\": {\n            \"type\": \"string\"\n        },\n        \"activelocation\": {\n            \"type\": \"string\"\n        },\n        \"area\": {\n            \"type\": \"string\"\n        },\n        \"aisle\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "AGENT"
