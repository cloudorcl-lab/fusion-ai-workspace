            {
              "id": "1767996750220",
              "name": "OrganizationId",
              "scope": "JOB",
              "type": "number",
              "value": "{{$context.$nodes.GET_DATE_RANGE.$output.result.OrganizationId}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Get Date Range",
            "returnType": "object",
            "sourceCode": "// Get current date (string or Date depending on platform)\nconst today = new Date($context.$system.$currentDate);\n\nconst Limit = 100;\n\n// startTime = today - 14 days (start of day)\nconst startDateObj = new Date(today);\nstartDateObj.setDate(startDateObj.getDate() - 14);\nstartDateObj.setHours(0, 0, 0, 0);\n\n// endTime = today \nconst endDateObj = new Date(today);\nendDateObj.setDate(endDateObj.getDate());\nendDateObj.setHours(23, 59, 59, 999);\n\n// Full ISO date-time strings\nconst startTime = startDateObj.toISOString();\nconst endTime = endDateObj.toISOString();\n\n//Get Org Context\nconst appContext = $context.$app.$OraAppContext ?? $context.$triggers.REST.$input.OraAppContext;\nlet OrganizationId;\n\n// Check for all empty cases: undefined, null, empty string, and whitespace only\nif (appContext && String(appContext).trim() !== '') {\n    try {\n        // Try parsing as JSON\n        const contextObj = JSON.parse(appContext);\n        OrganizationId = contextObj.OrganizationId;\n    } catch (e) {\n        // Fallback: comma-separated string\n       OrganizationId= String(appContext).trim();\n    }\n}\n\n\nreturn { startTime, endTime,OrganizationId,Limit };"
          },
          "outcomes": {
            "success": "1767996727739"
          },
          "code": "GET_DATE_RANGE",
          "id": "1767997418859",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
