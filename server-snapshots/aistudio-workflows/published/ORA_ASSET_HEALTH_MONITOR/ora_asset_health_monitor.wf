                },
                {
                  "metadata": {
                    "businessObjectCode": "ORA_SCM_MNT_MAINTENANCE_ASSETS",
                    "functionName": "oraScmMnt_getAssetByAssetId",
                    "processJson": true,
                    "name": "Get Asset Information"
                  },
                  "outcomes": {
                    "success": "1770629883544"
                  },
                  "code": "GET_ASSET_INFORMATION",
                  "id": "1771241370380",
                  "inputs": [
                    {
                      "id": "1771244417248_1",
                      "name": "AssetId",
                      "type": "integer",
                      "value": "{{$context.$nodes.GET_ASSETS_DETAIL_AND_RECENT_WORK_ORDER_CREATED.$currentItem}}"
                    }
                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "Asset And Work Order Information",
                    "returnType": "array",
                    "sourceCode": "const assetDetails = $context.$nodes.GET_ASSETS_DETAIL_AND_RECENT_WORK_ORDER_CREATED.GET_ASSET_INFORMATION.$output?.items?.[0]; \nconst selectedAssetDetails = assetDetails\n      ? {\n      AssetId: assetDetails.AssetId,\n      AssetNumber: assetDetails.AssetNumber,\n      Description: assetDetails.Description,\n      ItemNumber: assetDetails.ItemNumber,\n      ItemDescription: assetDetails.ItemDescription,\n      OperatingOrganizationCode: assetDetails.OperatingOrganizationCode,\n      LocationOrganizationCode: assetDetails.LocationOrganizationCode,\n      CurrentLocationContext: assetDetails.CurrentLocationContext,\n      CurrentLocationName: assetDetails.CurrentLocationName\n    }\n  : null;\n\nconst assetWorkOrders = $context.$nodes.GET_ASSETS_DETAIL_AND_RECENT_WORK_ORDER_CREATED.GET_ASSET_FROM_WORK_ORDER.$output?.items?.map(item => item.WorkOrderNumber) || [];\nconst rec = {AssetDetails: selectedAssetDetails, WorkOrderNumber: assetWorkOrders };\n\nreturn rec;"
                  },
                  "outcomes": {
                    "success": "end_1770629827725"
                  },
                  "code": "ASSET_AND_WORK_ORDER_INFORMATION",
                  "convergenceTargetId": "1771241853963",
                  "id": "1770706514402",
