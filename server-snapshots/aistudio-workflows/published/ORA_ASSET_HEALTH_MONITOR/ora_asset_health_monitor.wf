                  },
                  "code": "GET_ASSET_FROM_WORK_ORDER",
                  "id": "1770629883544",
                  "inputs": [
                    {
                      "id": "1771244571707_1",
                      "name": "pQparam",
                      "type": "string",
                      "value": "{{\"(PlannedStartDate BETWEEN '\" + $context.$variables.startTime.trim() + \"' AND '\" + $context.$variables.endTime.trim() + \"') AND OrganizationId=\"+$context.$variables.OrganizationId+\" AND WorkOrderTypeCode = 'CORRECTIVE' AND WorkOrderSubTypeCode = 'ORA_CONDITION_BASED' AND WorkOrderStatusCode = 'ORA_UNRELEASED' AND AssetId = \"+ $context.$nodes.GET_ASSETS_DETAIL_AND_RECENT_WORK_ORDER_CREATED.$currentItem}}"
                    },
                    {
                      "id": "1771244571708_2",
