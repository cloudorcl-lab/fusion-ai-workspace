  "workflowCode": "ORA_GOAL_CREATION_ASSISTANT",
  "name": "Goal Creation Assistant",
  "description": "Creates a goal based on the goal name, the employee’s or manager’s department and business title or suggests goals based on the manager’s comments in the previous performance evaluation document.",
