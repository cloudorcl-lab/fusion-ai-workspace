        {
          "metadata": {
            "name": "Set Mode",
            "returnType": "string",
            "sourceCode": "const mode = $context.$triggers.REST.$input.ExecutionMode;\nif (mode.toUpperCase() !== \"RECOMMEND_ONLY\" && mode.toUpperCase() !== \"ACT\") {\n  throw new Error(\"ExecutionMode must be RECOMMEND_ONLY or ACT\");\n}\nreturn mode.toUpperCase();"
          },
          "outcomes": {
            "success": "1767125355314"
          },
          "code": "SET_MODE",
          "id": "1767125355301",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
