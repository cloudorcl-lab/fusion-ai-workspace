        {
          "metadata": {
            "name": "Collect Operations",
            "returnType": "array",
            "sourceCode": "const result = $context.$nodes.GET_OPERATION_DETAIL_FOR_REQUESTED_WORK_ORDERS.$output;\nconst inputs = $context.$nodes.INIT_INPUTS.$output.result.workOrdersToAssign;\nconst operations = [];\n\nresult.forEach((e) => {\n  const data = typeof e === \"string\" ? JSON.parse(e) : e;\n  const items = data.items || [];\n\n  items.forEach((item) => {\n    const inputWO = inputs.find(i => \n      i.WorkOrderNumber === item.WorkOrderNumber &&\n      i.OperationSequenceNumber.toString() === item.OperationSequenceNumber.toString()\n    );\n    if (inputWO) {\n      item.AssignedQuantity = inputWO.AssignedQuantity;\n      item.CurrentAssignments = inputWO.CurrentAssignments;\n      operations.push(item);\n    }\n  });\n});\n\nreturn operations;"
          },
          "outcomes": {
            "success": "1767385524767"
          },
          "code": "COLLECT_OPERATIONS",
          "id": "1767903833311",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
