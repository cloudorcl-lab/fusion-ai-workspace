        {
          "metadata": {
            "name": "Init Inputs",
            "returnType": "object",
            "sourceCode": "const wcId = $context.$triggers.REST.$input.WorkCenterId;\nif (!wcId) {\n  throw new Error('WorkCenterId is required');\n}\nlet workOrdersToAssign = $context.$triggers.REST.$input.WorkOrders;\nworkOrdersToAssign = workOrdersToAssign ? workOrdersToAssign : [];\n\nconst res = { workCenterId: wcId , workOrdersToAssign}\n\nreturn res;"
          },
          "outcomes": {
            "success": "1767125355308"
          },
          "code": "INIT_INPUTS",
          "id": "1767125355306",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Build Assignment Request Payload",
            "returnType": "object",
            "sourceCode": "const recommendation = $context.$triggers.REST.$input.Recommendation;\n\nconst requestPayload = [];\nconst organizationId = $context.$triggers.REST.$input.OrganizationId;\n\nrecommendation.RecommendedAssignments.forEach((assignment) => {\n  let sourceWorkstationId = null;\n  if (assignment.SourceWorkstationId !== null || assignment.SourceWorkstationId !== undefined) {\n    sourceWorkstationId = assignment.SourceWorkstationId;\n  }\n  requestPayload.push({\n    OrganizationId: organizationId,\n    WoOperationId: recommendation.WoOperationId,\n    AssignedQuantity: assignment.AssignedQuantity,\n    SourceWorkstationId: sourceWorkstationId,\n    TargetWorkstationId: assignment.WorkstationId,\n    postion: null,\n  });\n});\n\n\nreturn requestPayload;"
          },
          "outcomes": {
            "success": "1768071492077"
          },
          "code": "BUILD_ASSIGNMENT_REQUEST_PAYLOAD",
          "id": "1767925816532",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
