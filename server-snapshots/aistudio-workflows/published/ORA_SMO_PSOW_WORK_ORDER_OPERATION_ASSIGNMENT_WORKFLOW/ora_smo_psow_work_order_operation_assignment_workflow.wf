",\n            \"enum\": [\"CURRENT\", \"NEXT\"]\n          }\n        }\n      }\n    },\n    \"Workstations\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"properties\": {\n          \"WorkstationId\": {\n            \"type\": \"number\"\n          },\n          \"WorkstationCode\": {\n            \"type\": \"string\"\n          },\n          \"WorkstationName\": {\n            \"type\": \"string\"\n          },\n          \"AvailableCapacity\": {\n            \"type\": \"string\"\n          },\n          \"WorkstationStatusCode\": {\n            \"type\": \"string\"\n          },\n          \"OpenExceptions\": {\n            \"type\": \"integer\",\n            \"minimum\": 0\n          },\n          \"WorkstationEquipmentResources\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"additionalProperties\": false,\n              \"properties\": {\n                \"EquipmentInstanceId\": {\n                  \"type\": \"number\"\n                },\n                \"ResourceId\": {\n                  \"type\": \"number\"\n                },\n                \"EquipmentInstanceCode\": {\n                  \"type\": \"string\"\n                },\n                \"EquipmentInstanceName\": {\n                  \"type\": \"string\"\n                },\n                \"ResourceName\": {\n                  \"type\": \"string\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}",
