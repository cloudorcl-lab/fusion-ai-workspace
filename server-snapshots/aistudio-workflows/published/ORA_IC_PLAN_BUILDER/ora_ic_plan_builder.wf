{
  "workflowId": "300000331067443",
  "workflowCode": "ORA_IC_PLAN_BUILDER",
  "name": "IC Plan Builder",
  "description": "Plan Builder with Expression Resolution and Description Generation. Parses plan documents using parallel LLM extractors, processes components in a loop, and uses shared workflows for expression resolution and description generation.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
