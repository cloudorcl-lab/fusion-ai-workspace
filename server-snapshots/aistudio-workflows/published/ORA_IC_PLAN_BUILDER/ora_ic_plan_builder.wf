        {
          "id": "1",
          "code": "DOCUMENT_TOOL",
          "type": "TOOL",
          "metadata": {
            "name": "Document Tool",
            "toolCode": "ORA_MULTI_FILE_PROCESSOR_TOOL",
            "parseFiles": true
          },
          "outcomes": {
