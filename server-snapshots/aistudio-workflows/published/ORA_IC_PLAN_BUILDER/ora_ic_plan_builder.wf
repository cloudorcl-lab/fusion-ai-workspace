            "name": "Apply Precheck Output",
            "returnType": "string",
            "sourceCode": "// APPLY_PRECHECK_OUTPUT - Merge precheck report into resolved plan payload.\n\nvar basePlanRaw = $context.$nodes.ADAPT_RESOLVER_OUTPUT ? $context.$nodes.ADAPT_RESOLVER_OUTPUT.$output.result : null;\nvar precheckRaw = $context.$nodes.CALL_PLAN_PRECHECK ? $context.$nodes.CALL_PLAN_PRECHECK.$output : null;\nvar orgCatalogRaw = $context.$nodes.CALL_ORG_CATALOG ? $context.$nodes.CALL_ORG_CATALOG.$output : null;\n\nvar parseMaybeJson = function(value) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n  if (typeof value !== 'string') {\n    return value;\n  }\n  try {\n    return JSON.parse(value);\n  } catch (_err) {\n    return null;\n  }\n};\n\nvar extractPrecheck = function(workflowOutput) {\n  var envelope = parseMaybeJson(workflowOutput);\n  if (!envelope || envelope.output === undefined) {\n    return null;\n  }\n  var child = parseMaybeJson(envelope.output);\n  if (child && child.result) {\n    return parseMaybeJson(child.result);\n  }\n  return child;\n};\n\nvar extractOrgCatalog = function(workflowOutput) {\n  var envelope = parseMaybeJson(workflowOutput);\n  if (!envelope || typeof envelope !== 'object') {\n    return null;\n  }\n  if (envelope.output !== undefined) {\n    var child = parseMaybeJson(envelope.output);\n    if (child && child.result && child.result.catalog) {\n      return child.result.catalog;\n    }\n    if (child && child.catalog) {\n      return child.catalog;\n    }\n  }\n  if (envelope.result && envelope.result.catalog) {\n    return envelope.result.catalog;\n  }\n  if (envelope.catalog) {\n    return envelope.catalog;\n  }\n  if (envelope.staticLookups || envelope.expressionCatalog || envelope.intervals || envelope.orgContext) {\n    return envelope;\n  }\n  return null;\n};\n\nvar deepClone = function(value) {\n  if (value === null || value === undefined) {\n    return value;\n  }\n  return JSON.parse(JSON.stringify(value));\n};\n\nvar buildCompactPrecheck = function(precheck) {\n  if (!precheck || typeof precheck !== 'object') {\n    return null;\n  }\n  var feedback = precheck.feedback && typeof precheck.feedback === 'object' ? precheck.feedback : null;\n  if (!feedback) {\n    var legacyFindings = [];\n    var legacyIssues = precheck.issues ? precheck.issues : [];\n    var legacyWarnings = precheck.warnings ? precheck.warnings : [];\n    var i = 0;\n    var mapFinding = function(item) {\n      var finding = item ? item : new Object();\n      var compact = {\n        code: finding.code ? String(finding.code) : null,\n        severity: finding.severity ? String(finding.severity) : 'ERROR',\n        path: finding.path ? String(finding.path) : null,\n        message: finding.message ? String(finding.message) : 'Validation issue detected.'\n      };\n      if (finding.suggestedAction) {\n        compact.suggestedAction = String(finding.suggestedAction);\n      } else if (finding.repairPromptHint) {\n        compact.suggestedAction = String(finding.repairPromptHint);\n      }\n      if (finding.context && typeof finding.context === 'object') {\n        compact.context = deepClone(finding.context);\n      }\n      return compact;\n    };\n    for (i = 0; i < legacyIssues.length; i += 1) {\n      legacyFindings.push(mapFinding(legacyIssues[i]));\n    }\n    for (i = 0; i < legacyWarnings.length; i += 1) {\n      legacyFindings.push(mapFinding(legacyWarnings[i]));\n    }\n    feedback = {\n      passed: precheck.passed === true,\n      publishReadiness: precheck.publishReadiness ? String(precheck.publishReadiness) : (precheck.passed === true ? 'READY' : 'BLOCKED'),\n      summary: {\n        errorCount: legacyIssues.length,\n        warningCount: legacyWarnings.length\n      },\n      findings: legacyFindings,\n      actions: {\n        requiresUserConfirmation: precheck.requiresUserConfirmation === true,\n        recommendedStrategy: precheck.recommendedStrategy ? String(precheck.recommendedStrategy) : null,\n        defaultStrategy: precheck.defaultStrategy ? String(precheck.defaultStrategy) : null,\n        availableStrategies: precheck.availableStrategies && precheck.availableStrategies.length !== undefined ? deepClone(precheck.availableStrategies) : []\n      }\n    };\n  }\n\n  var compact = {\n    contractVersion: precheck.contractVersion ? String(precheck.contractVersion) : null,\n    passed: precheck.passed === true,\n    feedback: deepClone(feedback)\n  };\n  compact.feedback.findings = compact.feedback.findings && compact.feedback.findings.length !== undefined\n    ? compact.feedback.findings.slice(0, 20)\n    : [];\n  if (precheck.appliedMutations && precheck.appliedMutations.length !== undefined && precheck.appliedMutations.length > 0) {\n    compact.appliedMutations = deepClone(precheck.appliedMutations);\n  }\n  return compact;\n};\n\nvar hasPrecheckOutcome = function(precheck) {\n  if (!precheck || typeof precheck !== 'object') {\n    return false;\n  }\n  if (precheck.passed === true || precheck.passed === false) {\n    return true;\n  }\n  return !!(precheck.feedback && (precheck.feedback.passed === true || precheck.feedback.passed === false));\n};\n\nvar basePlan = parseMaybeJson(basePlanRaw);\nif (!basePlan || typeof basePlan !== 'object') {\n  return typeof basePlanRaw === 'string' ? basePlanRaw : JSON.stringify(new Object());\n}\n\nvar precheck = extractPrecheck(precheckRaw);\n\nif (!hasPrecheckOutcome(precheck)) {\n  return JSON.stringify(basePlan);\n}\n\nvar outputPlan = precheck && precheck.resolvedPlan && typeof precheck.resolvedPlan === 'object'\n  ? deepClone(precheck.resolvedPlan)\n  : deepClone(basePlan);\n\nif (!outputPlan.metadata || typeof outputPlan.metadata !== 'object') {\n  outputPlan.metadata = new Object();\n}\n\nvar compactOrgCatalog = extractOrgCatalog(orgCatalogRaw);\nif (compactOrgCatalog) {\n  outputPlan.metadata.orgCatalog = deepClone(compactOrgCatalog);\n}\n\nvar compactPrecheck = buildCompactPrecheck(precheck);\nif (compactPrecheck) {\n  outputPlan.metadata.precheck = compactPrecheck;\n}\n\nreturn JSON.stringify(outputPlan);"
          },
