              var rtOptions = [];\n                    for (var rtCandIdx = 0; rtCandIdx < rtMatch.candidates.length; rtCandIdx++) {\n                        rtOptions.push(componentRateTables[rtMatch.candidates[rtCandIdx]].rateTableName);\n                    }\n                    openQuestions.push({\n                        type: 'WIRING_RATE_TABLE_MATCH',\n                        path: componentPath + '.rateTables',\n                        context: rtContext,\n                        message: 'Ambiguous scorecard rate table match for assignment.',\n                        options: rtOptions,\n                        source: 'WIRING_LLM'\n                    });\n                    warnings.push('Ambiguous scorecard rate table match for \"' + assignment.rateTableName + '\"');\n                } else {\n                    warnings.push('Scorecard rate table \"' + assignment.rateTableName + '\" not found in component');\n                }\n                continue;\n            }\n            var matchingRT = componentRateTables[rtMatch.index];\n            scorecardAssignedRateTableIds[matchingRT.rateTableId] = true;\n\n            // Initialize scorecards array if not exists, then APPEND (not overwrite)\n            // This supports multiple date-ranged rate tables for the same measure\n            if (!targetPM.scorecards) {\n                targetPM.scorecards = [];\n            }\n            var scorecardTable = {\n                rateTableName: matchingRT.rateTableName,\n                description: valueOrNull(matchingRT.description),\n                rateTableType: matchingRT.rateTableType,\n                confidence: valueOrNull(matchingRT.confidence),\n                status: valueOrNull(matchingRT.status),\n                reviewNotes: valueOrNull(matchingRT.reviewNotes),\n                dimensions: matchingRT.dimensions || [],\n                rateValues: matchingRT.rateValues || []\n            };\n\n            targetPM.scorecards.push({\n                scorecardId: 'SC_' + targetPM.measureId + '_' + matchingRT.rateTableId,\n                rateTableId: matchingRT.rateTableId,\n                startDate: matchingRT.effectiveStartDate || planDetails.effectiveStartDate || today,\n                endDate: valueOrNull(matchingRT.effectiveEndDate),\n                rateTableName: scorecardTable.rateTableName,\n                description: scorecardTable.description,\n                rateTableType: scorecardTable.rateTableType,\n                dimensions: scorecardTable.dimensions,\n                rateValues: scorecardTable.rateValues\n            });\n\n            // Build dimensional inputs ONLY ONCE per measure (shared across all scorecards)\n            // All date-ranged rate tables for a measure share the same dimension structure\n            if (!targetPM.rateDimensionalInputs) {\n                var dimInputs = [];\n                var dims = matchingRT.dimensions || [];\n                var rtDimInputs = dimInputsByRT[assignment.rateTableName] || dimInputsByRT[matchingRT.rateTableName] || [];\n\n                for (var dimIdx = 0; dimIdx < dims.length; dimIdx++) {\n                    var dimSeq = dimIdx + 1;\n                    var dimName = dims[dimIdx].dimensionName;\n\n                    // Find matching dimension input assignment\n                    var matchingDimInput = null;\n                    for (var mdiIdx = 0; mdiIdx < rtDimInputs.length; mdiIdx++) {\n                        if (rtDimInputs[mdiIdx].dimensionSequence === dimSeq) {\n                            matchingDimInput = rtDimInputs[mdiIdx];\n                            break;\n                        }\n                    }\n\n                    var measureInputExpressionId = 'EXPR_' + targetPM.measureId + '_' + matchingRT.rateTableId + '_DIM' + dimSeq;\n                    var measureInputShell = buildRateInputExpressionShell(\n                        measureInputExpressionId,\n                        buildRateInputExpressionName(matchingDimInput, dims[dimIdx]),\n                        matchingDimInput ? matchingDimInput.inputExpression : valueOrNull(dims[dimIdx].inputExpression),\n                        matchingDimInput ? valueOrNull(matchingDimInput.description) : valueOrNull(dims[dimIdx].description),\n                        matchingRT.rateTableName\n                    );\n\n                    dimInputs.push({\n                        inputId: 'PMINPUT_' + targetPM.measureId + '_DIM' + dimSeq,\n                        expressionId: measureInputShell.expressionId,\n                        inputExpressionName: measureInputShell.inputExpressionName,\n                        rateTableId: matchingRT.rateTableId,\n                        rateTableName: valueOrNull(matchingRT.rateTableName),\n                        dimensionId: valueOrNull(dims[dimIdx].dimensionId || dims[dimIdx].rateDimensionId),\n                        dimensionSequence: dimSeq,\n                        dimensionName: valueOrNull(dimName),\n                        description: measureInputShell.description,\n                        displayText: measureInputShell.displayText,\n                        inputExpression: measureInputShell.simpleExpression,\n                        simpleExpression: measureInputShell.simpleExpression,\n                        tokens: measureInputShell.tokens,\n                        intent: measureInputShell.intent,\n                        splitFlag: null,\n                        accumulateFlag: null,\n                        _resolution: measureInputShell._resolution\n                    });\n                }\n\n                targetPM.rateDimensionalInputs = dimInputs;\n            }\n\n        }\n        // COMPONENT_LEVEL rate tables don't need special wiring here -\n        // they're already referenced in formulas via RTR\n    }\n\n    // Collect wiring ambiguities for recipe/user resolution\n    for (var ambIdx = 0; ambIdx < wiringAmbiguities.length; ambIdx++) {\n        var amb = wiringAmbiguities[ambIdx];\n        var ambContext = amb.rateTableName || 'UNKNOWN_RATE_TABLE';\n        if (hasValue(amb.dimensionName)) {\n            ambContext += '.' + amb.dimensionName;\n        }\n        if (hasValue(amb.dimensionSequence)) {\n            ambContext += '#dim' + amb.dimensionSequence;\n        }\n        if (hasValue(amb.targetMeasure)) {\n            ambContext += '|measure=' + amb.targetMeasure;\n        }\n        if (hasValue(amb.targetFormula)) {\n            ambContext += '|formula=' + amb.targetFormula;\n        }\n        openQuestions.push({\n            type: 'WIRING_' + amb.type,\n            path: componentPath + '.rateTables',\n            context: ambContext,\n            message: amb.message,\n            options: amb.options || [],\n            source: 'WIRING_LLM'\n        });\n    }\n\n    // Collect incentive formula ambiguities from extractor\n    for (var fAmbIdx = 0; fAmbIdx < formulaAmbiguities.length; fAmbIdx++) {\n        var fAmb = formulaAmbiguities[fAmbIdx];\n        openQuestions.push({\n            type: 'INCENTIVE_' + (fAmb.type || 'FORMULA_AMBIGUITY'),\n            path: componentPath + '.formulas',\n            context: componentDetails.componentName || componentPath,\n            message: fAmb.message || 'Incentive formula ambiguity reported by extractor.',\n            options: fAmb.options || [],\n            source: 'PC_EXPRESSION_EXTRACTOR'\n        });\n    }\n\n    if (componentFormulas.length === 0) {\n        openQuestions.push({\n            type: 'INCENTIVE_FORMULA_MISSING',\n            path: componentPath + '.formulas',\n            context: componentDetails.componentName || componentPath,\n            message: 'No component incentive formula was extracted. Rerun with full context or manual review is required.',\n            options: ['RERUN_WITH_FULL_DOCUMENT', 'MANUAL_REVIEW'],\n            source: 'ASSEMBLER_GUARD'\n        });\n        warnings.push('Missing incentive formula for component \"' + (componentDetails.componentName || componentPath) + '\"');\n    }\n\n    // Add component's open questions to global collection\n    for (var oqIdx = 0; oqIdx < openQuestions.length; oqIdx++) {\n        allOpenQuestions.push(openQuestions[oqIdx]);\n    }\n\n    // === CONFIGURATION INFERENCE APPLICATION ===\n    // Apply splitOption, splitFlag, accumulateFlag from Wiring LLM configurationInferences\n    // Confidence thresholds: >=80% apply silently, 70-79% apply with warning, <70% already in ambiguities\n\n    for (var ciApplyIdx = 0; ciApplyIdx < configurationInferences.length; ciApplyIdx++) {\n        var configInf = configurationInferences[ciApplyIdx];\n\n        // Skip low confidence (already handled by ambiguities)\n        if (configInf.confidence < 0.7) {\n            continue;\n        }\n\n        // Find matching rate table\n        var configMatch = resolveNameMatch(\n            componentRateTables,\n            configInf.rateTableName,\n            (table) => table.rateTableName\n        );\n        if (configMatch.index < 0) {\n            if (configMatch.ambiguous) {\n                var configOptions = [];\n                for (var cfgCandIdx = 0; cfgCandIdx < configMatch.candidates.length; cfgCandIdx++) {\n                    configOptions.push(componentRateTables[configMatch.candidates[cfgCandIdx]].rateTableName);\n                }\n                openQuestions.push({\n                    type: 'WIRING_RATE_TABLE_MATCH',\n                    path: componentPath + '.rateTables',\n                    context: 'configInference=' + configInf.rateTableName,\n                    message: 'Ambiguous configuration inference rate table match.',\n                    options: configOptions,\n                    source: 'WIRING_LLM'\n                });\n                warnings.push('Ambiguous configuration inference rate table match: ' + configInf.rateTableName);\n            } else {\n                warnings.push('Configuration inference references unknown rate table: ' + configInf.rateTableName);\n            }\n            continue;\n        }\n        var matchingCIRTIdx = configMatch.index;\n        var matchingCIRT = componentRateTables[matchingCIRTIdx];\n\n        // splitOption is source-defaulted (NONE) and only overridden by explicit component extraction.\n        // Wiring LLM may infer splitOption, but we keep it advisory to avoid semantic drift.\n        if (configInf.splitOption) {\n            if (componentSplitOption !== configInf.splitOption) {\n                // Conflicting splitOption from different rate tables\n                warnings.push('Split option preserved from ' + splitOptionSource + ' as ' + componentSplitOption + '; ignored wiring inference ' + configInf.splitOption + ' from \"' + configInf.rateTableName + '\".');\n            }\n        }\n\n        // Apply splitFlag to rate table dimension\n        if (configInf.splitDimensionSequence) {\n            var splitDimIdx = configInf.splitDimensionSequence - 1;\n            var rtDims = matchingCIRT.dimensions || [];\n\n            if (rtDims[splitDimIdx] && (rtDims[splitDimIdx].splitFlag === null || rtDims[splitDimIdx].splitFlag === undefined)) {\n                rtDims[splitDimIdx].splitFlag = true;\n\n                autoAppliedSettings.push({\n                    path: componentPath + '.rateTables[' + matchingCIRTIdx + '].dimensions[' + splitDimIdx + '].splitFlag',\n                    value: true,\n                    source: 'WIRING_LLM',\n                    confidence: configInf.confidence\n                });\n            }\n        }\n\n        // Apply accumulateFlag and splitFlag to scorecard dimensional inputs\n        // Find measure(s) with scorecard linked to this rate table\n        for (var pmAccIdx = 0; pmAccIdx < performanceMeasures.length; pmAccIdx++) {\n            var pmAcc = performanceMeasures[pmAccIdx];\n            var pmScorecards = pmAcc.scorecards || [];\n\n            for (var scIdx = 0; scIdx < pmScorecards.length; scIdx++) {\n                var expectedScorecardId = 'SC_' + pmAcc.measureId + '_' + matchingCIRT.rateTableId;\n                if (pmScorecards[scIdx].scorecardId === expectedScorecardId) {\n                    // Found measure with this scorecard\n                    var scInputs = pmAcc.rateDimensionalInputs || [];\n\n                    // Apply accumulateFlag to all scorecard inputs (if set)\n                    if (configInf.accumulateFlag !== null && configInf.accumulateFlag !== undefined) {\n                        for (var sciIdx = 0; sciIdx < scInputs.length; sciIdx++) {\n                            if (scInputs[sciIdx].accumulateFlag === null || scInputs[sciIdx].accumulateFlag === undefined) {\n                                scInputs[sciIdx].accumulateFlag = configInf.accumulateFlag;\n\n                                autoAppliedSettings.push({\n                                    path: componentPath + '.performanceMeasures[' + pmAccIdx + '].rateDimensionalInputs[' + sciIdx + '].accumulateFlag',\n                                    value: configInf.accumulateFlag,\n                                    source: 'WIRING_LLM',\n                                    confidence: configInf.confidence\n                                });\n                            }\n                        }\n                    }\n\n                    // Apply splitFlag to scorecard input matching splitDimensionSequence\n                    if (configInf.splitDimensionSequence) {\n                        var scSplitIdx = configInf.splitDimensionSequence - 1;\n                        if (scInputs[scSplitIdx] && (scInputs[scSplitIdx].splitFlag === null || scInputs[scSplitIdx].splitFlag === undefined)) {\n                            scInputs[scSplitIdx].splitFlag = true;\n\n                            autoAppliedSettings.push({\n                                path: componentPath + '.performanceMeasures[' + pmAccIdx + '].rateDimensionalInputs[' + scSplitIdx + '].splitFlag',\n                                value: true,\n                                source: 'WIRING_LLM',\n                                confidence: configInf.confidence\n                            });\n                        }\n                    }\n                }\n            }\n        }\n\n        // Store firstTierAsThreshold for deployer (if set)\n        if (configInf.firstTierAsThreshold !== null && configInf.firstTierAsThreshold !== undefined) {\n            matchingCIRT._firstTierAsThreshold = configInf.firstTierAsThreshold;\n        }\n    }\n\n    // === PATTERN-BASED AUTO-APPLY SETTINGS ===\n    // Apply settings when pattern confidence >= threshold AND field is null\n    // Note: splitOption defaults to source NONE/explicit extraction; wiring inference is advisory only.\n\n    // YTD_TRUEUP pattern -> trueUp=true, resetInterval=org annual-ish interval on first formula\n    var ytdTrueupConf = getPatternConfidence('YTD_TRUEUP');\n    if (ytdTrueupConf >= 0.80 && componentFormulas.length > 0) {\n        var firstFormula = componentFormulas[0];\n        if (firstFormula.trueUp === null || firstFormula.trueUp === undefined) {\n            firstFormula.trueUp = true;\n            autoAppliedSettings.push({\n                path: componentPath + '.formulas[0].trueUp',\n                value: true,\n                patternId: 'YTD_TRUEUP',\n                confidence: ytdTrueupConf\n            });\n        }\n        if (firstFormula.resetInterval === null || firstFormula.resetInterval === undefined) {\n            firstFormula.resetInterval = getPreferredAnnualIntervalLabel();\n            autoAppliedSettings.push({\n                path: componentPath + '.formulas[0].resetInterval',\n                value: firstFormula.resetInterval,\n                patternId: 'YTD_TRUEUP',\n                confidence: ytdTrueupConf\n            });\n        }\n    }\n\n    // HURDLE_MEASURE pattern -> earningBasis=false on measures\n    var hurdleConf = getPatternConfidence('HURDLE_MEASURE');\n    if (hurdleConf >= 0.80) {\n        for (var hurdleIdx = 0; hurdleIdx < performanceMeasures.length; hurdleIdx++) {\n            var hurdleMeasure = performanceMeasures[hurdleIdx];\n            if (hurdleMeasure.earningBasis === null || hurdleMeasure.earningBasis === undefined) {\n                hurdleMeasure.earningBasis = false;\n                autoAppliedSettings.push({\n                    path: componentPath + '.performanceMeasures[' + hurdleIdx + '].earningBasis',\n                    value: false,\n                    patternId: 'HURDLE_MEASURE',\n                    confidence: hurdleConf\n                });\n            }\n        }\n    }\n\n    var componentRateTableLinks = [];\n    var componentOwnedRateTables = [];\n    for (var linkedRtIdx = 0; linkedRtIdx < componentRateTables.length; linkedRtIdx++) {\n        var linkedRt = componentRateTables[linkedRtIdx];\n        if (!scorecardAssignedRateTableIds[linkedRt.rateTableId]) {\n            componentRateTableLinks.push({\n                rateTableId: linkedRt.rateTableId,\n                rateTableName: valueOrNull(linkedRt.rateTableName),\n                startDate: valueOrNull(componentDetails.startDate) || valueOrNull(planDetails.effectiveStartDate) || today,\n                endDate: valueOrNull(componentDetails.endDate)\n            });\n            componentOwnedRateTables.push(linkedRt);\n        }\n    }\n\n    // Keep component-level links and full payload only for component-owned rate tables.\n    // Scorecard-owned tables live exclusively under measure.scorecards.\n\n    var componentRateDimensionalInputs = [];\n    for (var cRtIdx = 0; cRtIdx < componentOwnedRateTables.length; cRtIdx++) {\n        var cRt = componentOwnedRateTables[cRtIdx];\n        var cDims = cRt.dimensions || [];\n        var cRtDimInputs = dimInputsByRT[cRt.rateTableName] || [];\n        for (var cDimIdx = 0; cDimIdx < cDims.length; cDimIdx++) {\n            var cDim = cDims[cDimIdx];\n            if (!cDim) {\n                continue;\n            }\n            var cDimSequence = hasValue(cDim.dimensionSequence) ? cDim.dimensionSequence : (cDimIdx + 1);\n            var cMatchingDimInput = null;\n            for (var cMdiIdx = 0; cMdiIdx < cRtDimInputs.length; cMdiIdx++) {\n                if (cRtDimInputs[cMdiIdx].dimensionSequence === cDimSequence) {\n                    cMatchingDimInput = cRtDimInputs[cMdiIdx];\n                    break;\n                }\n            }\n            var componentInputExpression = cMatchingDimInput\n                ? valueOrNull(cMatchingDimInput.inputExpression)\n                : valueOrNull(cDim.inputExpression);\n            if (!hasValue(componentInputExpression) || String(componentInputExpression).trim().length === 0) {\n                continue;\n            }\n            var componentInputExpressionId = 'EXPR_' + componentId + '_' + cRt.rateTableId + '_DIM' + cDimSequence;\n            var componentInputShell = buildRateInputExpressionShell(\n                componentInputExpressionId,\n                buildRateInputExpressionName(cMatchingDimInput, cDim),\n                componentInputExpression,\n                cMatchingDimInput ? valueOrNull(cMatchingDimInput.description) : valueOrNull(cDim.description),\n                cRt.rateTableName\n            );\n\n            componentRateDimensionalInputs.push({\n                inputId: 'RINPUT_' + componentId + '_' + cRt.rateTableId + '_DIM' + cDimSequence,\n                expressionId: componentInputShell.expressionId,\n                inputExpressionName: componentInputShell.inputExpressionName,\n                rateTableId: cRt.rateTableId,\n                rateTableName: valueOrNull(cRt.rateTableName),\n                dimensionId: valueOrNull(cDim.dimensionId || cDim.rateDimensionId),\n                dimensionSequence: cDimSequence,\n                dimensionName: valueOrNull(cDim.dimensionName),\n                description: componentInputShell.description,\n                displayText: componentInputShell.displayText,\n                inputExpression: componentInputShell.simpleExpression,\n                simpleExpression: componentInputShell.simpleExpression,\n                tokens: componentInputShell.tokens,\n                intent: componentInputShell.intent,\n                splitFlag: valueOrNull(cDim.splitFlag),\n                accumulateFlag: null,\n                _resolution: componentInputShell._resolution\n            });\n        }\n    }\n\n    planComponents.push({\n        componentId: componentId,\n        componentName: componentDetails.componentName,\n        componentType: componentDetails.componentType,\n        incentiveType: valueOrNull(componentDetails.incentiveType),\n        description: valueOrNull(componentDetails.description),\n        startDate: valueOrNull(componentDetails.startDate),\n        endDate: valueOrNull(componentDetails.endDate),\n        targetIncentivePercent: (componentDetails.targetIncentivePercent === null || componentDetails.targetIncentivePercent === undefined)\n            ? null\n            : componentDetails.targetIncentivePercent,\n        splitOption: componentSplitOption,\n        eligibleRoles: null,\n        sequenceNumber: sequenceNumber,\n        confidence: valueOrNull(compConf),\n        status: statusForConfidence(compConf),\n        reviewNotes: null,\n        performanceMeasures: performanceMeasures,\n        rateTables: componentOwnedRateTables,\n        componentRateTables: componentRateTableLinks.length > 0 ? componentRateTableLinks : undefined,\n        rateDimensionalInputs: componentRateDimensionalInputs.length > 0 ? componentRateDimensionalInputs : undefined,\n        formulas: componentFormulas\n    });\n\n    sequenceNumber++;\n}\n\n// Calculate overall confidence\nvar overallConfidence = null;\nif (confidenceScores.length > 0) {\n    var sum = 0;\n    for (var i = 0; i < confidenceScores.length; i++) { sum += confidenceScores[i]; }\n    overallConfidence = Math.round((sum / confidenceScores.length) * 100) / 100;\n}\n\n// Build the plan ID (inline)\nvar pName = planDetails.planName || 'UNKNOWN';\nvar planId = makeGeneratedId('PLAN_', pName, 'UNKNOWN', 'P001');\n\n// Assemble final output (without _resolution - will be added by Expression LLM Agent)\nvar result = {\n    metadata: {\n        schemaVersion: '1.0.0',\n        planId: planId,\n        planName: planDetails.planName,\n        createdDate: today,\n        description: valueOrNull(planDetails.description),\n        sourceDocument: null,\n        sourceType: 'BRD_PARSED',\n        overallConfidence: overallConfidence,\n        // Temporarily suppress builder-only scaffolding noise from the emitted plan JSON.\n        // _autoAppliedSettings: autoAppliedSettings,\n        lastModifiedDate: null,\n        lastModifiedBy: null,\n        fetchedFrom: null,\n        fetchedDate: null\n    },\n    compensationPlan: {\n        planName: planDetails.planName,\n        description: valueOrNull(planDetails.description),\n        businessUnit: valueOrNull(planDetails.businessUnit),\n        effectiveStartDate: valueOrNull(planDetails.effectiveStartDate),\n        effectiveEndDate: valueOrNull(planDetails.effectiveEndDate),\n        targetIncentive: valueOrNull(planDetails.targetIncentive),\n        allowCreditCategoryOverlapFlag: valueOrNull(planDetails.allowCreditCategoryOverlapFlag),\n        status: 'DRAFT',\n        reviewNotes: null\n    },\n    planComponents: planComponents\n    // Temporarily suppress ambiguity scaffolding from the emitted plan JSON.\n    // _warnings: warnings,\n    // _openQuestions: allOpenQuestions\n};\n\napplyParserDefaultsToPlan(result);\n\nreturn JSON.stringify(result);"
          },
