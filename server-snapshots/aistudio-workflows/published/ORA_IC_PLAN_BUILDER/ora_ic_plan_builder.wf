        {
          "id": "1763096851001",
          "code": "ASSEMBLE_PARSER_OUTPUT",
          "type": "CODE",
          "metadata": {
            "name": "Assemble Parser Output",
            "returnType": "object",
            "sourceCode": "// ASSEMBLE_PARSER_OUTPUT - Plan Builder CODE node\n// Assembles extracted data into Parser Schema v1.0 format\n// - Assembles WITHOUT _resolution (Expression Resolver runs after this)\n// - Adds scorecard wiring and pattern-based auto-apply settings\n\nvar planDetails = $context.$nodes.PLAN_DETAILS_EXTRACTOR.$output;\nvar loopOutput = $context.$nodes.PLAN_COMPONENT_LOOP.$output;\nvar triageOutput = $context.$variables.triageOutput || null;\nvar orgCatalogRaw = $context.$nodes.CALL_ORG_CATALOG\n  ? $context.$nodes.CALL_ORG_CATALOG.$output\n  : null;\n\n// Compute today's date early (used for scorecard startDate fallback)\nvar today = new Date().toISOString().split('T')[0];\n\n// LOOP output structure: array where each item has {\"0\": {content: \"...\"}, \"1\": {content: \"...\"}, ...}\n// Keys: 0=componentDetail, 1=measures, 2=rateTables, 3=formulas, 4=wiringOutput\n\n// Collect all confidence scores and low confidence paths\nvar confidenceScores = [];\nvar lowConfidenceItems = [];\nvar warnings = [];\nvar autoAppliedSettings = [];\nvar allOpenQuestions = [];\n\nvar safeParse = (label, raw, fallback) => {\n    if (raw === null || raw === undefined || raw === '') {\n        return fallback;\n    }\n    if (typeof raw !== 'string') {\n        return raw;\n    }\n    var text = raw;\n    if (text.indexOf('```') === 0) {\n        text = text.replace(/^```json?\\n?/, '').replace(/\\n?```$/, '');\n    }\n    try {\n        return JSON.parse(text);\n    } catch (e) {\n        warnings.push('Failed to parse ' + label + ': ' + e.message);\n        return fallback;\n    }\n};\n\nvar extractOrgCatalog = function(workflowOutput) {\n    var envelope = safeParse('orgCatalog', workflowOutput, null);\n    if (!envelope || typeof envelope !== 'object') {\n        return null;\n    }\n    if (envelope.catalog) {\n        return envelope.catalog;\n    }\n    if (envelope.result && envelope.result.catalog) {\n        return envelope.result.catalog;\n    }\n    if (envelope.output !== undefined) {\n        var child = safeParse('orgCatalog.output', envelope.output, null);\n        if (child && child.catalog) {\n            return child.catalog;\n        }\n        if (child && child.result && child.result.catalog) {\n            return child.result.catalog;\n        }\n    }\n    return envelope;\n};\n\nvar orgCatalog = extractOrgCatalog(orgCatalogRaw);\n\nvar normalizeIntervalToken = function(value) {\n    if (value === null || value === undefined) {\n        return null;\n    }\n    var text = String(value).trim().toUpperCase();\n    if (!text) {\n        return null;\n    }\n    return text.replace(/[\\s\\-_]+/g, '');\n};\n\nvar formatCanonicalRangeLabel = function(minimumAmount, maximumAmount) {\n    return String(minimumAmount) + ' - ' + String(maximumAmount);\n};\n\nvar normalizeRangeTextForParsing = function(value) {\n    return String(value)\n        .trim()\n        .replace(/,/g, '')\n        .replace(/[$%]/g, '')\n        .replace(/\\s+/g, ' ')\n        .trim();\n};\n\nvar inferRangeOpenEndedMax = function(dimension) {\n    var maxAbsBound = 0;\n    var collectBound = function(candidate) {\n        if (typeof candidate !== 'number' || !isFinite(candidate)) {\n            return;\n        }\n        var absValue = Math.abs(candidate);\n        if (absValue > maxAbsBound) {\n            maxAbsBound = absValue;\n        }\n    };\n    var collectFromText = function(text) {\n        if (text === null || text === undefined) {\n            return;\n        }\n        var normalizedText = normalizeRangeTextForParsing(text);\n        var matches = normalizedText.match(/-?\\d+(?:\\.\\d+)?/g) || [];\n        for (var matchIdx = 0; matchIdx < matches.length; matchIdx += 1) {\n            collectBound(Number(matches[matchIdx]));\n        }\n    };\n\n    if (dimension && Array.isArray(dimension.values)) {\n        for (var valueIdx = 0; valueIdx < dimension.values.length; valueIdx += 1) {\n            collectFromText(dimension.values[valueIdx]);\n        }\n    }\n    if (dimension && Array.isArray(dimension.tiers)) {\n        for (var tierIdx = 0; tierIdx < dimension.tiers.length; tierIdx += 1) {\n            var tier = dimension.tiers[tierIdx];\n            if (!tier || typeof tier !== 'object') {\n                continue;\n            }\n            collectBound(tier.minimumAmount);\n            collectBound(tier.maximumAmount);\n            collectFromText(tier.stringValue);\n        }\n    }\n\n    if (!(maxAbsBound > 0)) {\n        return 999999;\n    }\n\n    var integerDigits = String(Math.floor(maxAbsBound)).replace('-', '').length;\n    var farDigits = Math.max(integerDigits + 3, 6);\n    if (farDigits > 15) {\n        farDigits = 15;\n    }\n    return Number(new Array(farDigits + 1).join('9'));\n};\n\nvar parseRangeTierFromValue = function(value, openEndedMax) {\n    if (value === null || value === undefined) {\n        return null;\n    }\n    var text = String(value).trim();\n    if (!text) {\n        return null;\n    }\n    var normalizedText = normalizeRangeTextForParsing(text);\n    var resolvedOpenEndedMax = typeof openEndedMax === 'number' && isFinite(openEndedMax)\n        ? openEndedMax\n        : 999999;\n\n    var boundedMatch = normalizedText.match(/^(-?\\d+(?:\\.\\d+)?)\\s*-\\s*(-?\\d+(?:\\.\\d+)?)$/);\n    if (boundedMatch) {\n        var boundedMin = Number(boundedMatch[1]);\n        var boundedMax = Number(boundedMatch[2]);\n        return {\n            stringValue: formatCanonicalRangeLabel(boundedMin, boundedMax),\n            minimumAmount: boundedMin,\n            maximumAmount: boundedMax\n        };\n    }\n\n    var openEndedMatch = normalizedText.match(/^(-?\\d+(?:\\.\\d+)?)\\s*\\+$/);\n    if (openEndedMatch) {\n        var openEndedMin = Number(openEndedMatch[1]);\n        return {\n            stringValue: formatCanonicalRangeLabel(openEndedMin, resolvedOpenEndedMax),\n            minimumAmount: openEndedMin,\n            maximumAmount: res