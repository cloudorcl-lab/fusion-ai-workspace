tion: null\n    };\n};\n\nvar normalizeName = (v) => {\n    if (!hasValue(v)) {\n        return '';\n    }\n    return String(v).toLowerCase().replace(/[^a-z0-9]+/g, '');\n};\n\nvar resolveNameMatch = (items, target, selector) => {\n    if (!hasValue(target) || !items || items.length === 0) {\n        return { index: -1, strategy: 'NONE', ambiguous: false, candidates: [] };\n    }\n\n    var targetText = String(target).trim();\n    var exactMatches = [];\n    for (var i = 0; i < items.length; i++) {\n        var value = selector(items[i]);\n        if (hasValue(value) && String(value).trim() === targetText) {\n            exactMatches.push(i);\n        }\n    }\n    if (exactMatches.length === 1) {\n        return { index: exactMatches[0], strategy: 'EXACT', ambiguous: false, candidates: [] };\n    }\n    if (exactMatches.length > 1) {\n        return { index: -1, strategy: 'EXACT', ambiguous: true, candidates: exactMatches };\n    }\n\n    var normTarget = normalizeName(targetText);\n    if (!normTarget) {\n        return { index: -1, strategy: 'NORMALIZED', ambiguous: false, candidates: [] };\n    }\n\n    var normalizedMatches = [];\n    for (var j = 0; j < items.length; j++) {\n        var normValue = normalizeName(selector(items[j]));\n        if (normValue && normValue === normTarget) {\n            normalizedMatches.push(j);\n        }\n    }\n    if (normalizedMatches.length === 1) {\n        return { index: normalizedMatches[0], strategy: 'NORMALIZED', ambiguous: false, candidates: [] };\n    }\n    if (normalizedMatches.length > 1) {\n        return { index: -1, strategy: 'NORMALIZED', ambiguous: true, candidates: normalizedMatches };\n    }\n\n    var containsMatches = [];\n    for (var k = 0; k < items.length; k++) {\n        var candidateNorm = normalizeName(selector(items[k]));\n        if (candidateNorm && (candidateNorm.indexOf(normTarget) >= 0 || normTarget.indexOf(candidateNorm) >= 0)) {\n            containsMatches.push(k);\n        }\n    }\n    