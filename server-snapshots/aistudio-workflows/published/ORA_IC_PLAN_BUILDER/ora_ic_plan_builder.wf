        {
          "id": "7",
          "code": "PLAN_COMPONENT_LOOP",
          "type": "LOOP",
          "metadata": {
            "name": "Plan Component Loop",
            "loopType": "SEQUENTIAL",
            "dataPipeline": {
              "rootNode": "start_1763095839856",
              "pipelineNodes": [
                {
                  "type": "START",
                  "code": "START_1763095839856",
                  "id": "start_1763095839856",
                  "metadata": {
                    "name": "Start",
                    "description": "Start of component loop"
                  },
                  "outcomes": {
                    "success": "SLICE_FOR_COMPONENT"
                  },
                  "inputs": []
                },
                {
                  "type": "CODE",
                  "code": "SLICE_FOR_COMPONENT",
                  "id": "SLICE_FOR_COMPONENT",
                  "metadata": {
                    "name": "Slice For Component",
                    "returnType": "object",
                    "position": {
                      "x": 140,
                      "y": 200
                    },
                    "sourceCode": "var fullDocumentText = $context.$nodes.PREPARE_DOCUMENT_TEXT.$output.result;\nif (typeof fullDocumentText !== 'string') {\n    fullDocumentText = fullDocumentText === null || fullDocumentText === undefined\n        ? ''\n        : String(fullDocumentText);\n}\n\nvar classifierRaw = $context.$nodes.DOCUMENT_SECTION_CLASSIFIER.$output;\nvar currentItem = $context.$nodes.PLAN_COMPONENT_LOOP.$currentItem;\n\nvar parseJson = (value) => {\n    if (value === null || value === undefined) {\n        return null;\n    }\n    if (typeof value !== 'string') {\n        return value;\n    }\n    var text = value;\n    if (text.indexOf('```') === 0) {\n        text = text.replace(/^```json?\\n?/, '').replace(/\\n?```$/, '');\n    }\n    try {\n        return JSON.parse(text);\n    } catch (e) {\n        return null;\n    }\n};\n\nvar unwrapClassifier = (raw) => {\n    var obj = parseJson(raw);\n    if (obj && obj.result !== undefined) {\n        obj = parseJson(obj.result);\n    }\n    if (!obj || typeof obj !== 'object') {\n        var empty = new Object();\n        empty.globalSummary = '';\n        empty.componentSections = [];\n        return empty;\n    }\n    var result = new Object();\n    result.globalSummary = typeof obj.globalSummary === 'string' ? obj.globalSummary : '';\n    result.componentSections = Array.isArray(obj.componentSections) ? obj.componentSections : [];\n    return result;\n};\n\nvar normalizeName = (value) => {\n    if (value === null || value === undefined) {\n        return '';\n    }\n    return String(value).toLowerCase().replace(/[^a-z0-9]+/g, '');\n};\nvar fullDocumentLower = fullDocumentText.toLowerCase();\n\nvar findAnchorPosition = (anchorText, fromOriginalIndex) => {\n    if (!anchorText || !String(anchorText).trim()) {\n        return -1;\n    }\n    var searchFrom = fromOriginalIndex || 0;\n\n    var rawAnchor = String(anchorText);\n    var directIndex = fullDocumentLower.indexOf(rawAnchor.toLowerCase(), searchFrom);\n    if (directIndex >= 0) {\n        return directIndex;\n    }\n    return -1;\n};\n\nvar resolveSection = (sections, componentName) => {\n    if (!sections || sections.length === 0) {\n        return null;\n    }\n    var name = String(componentName || '').trim();\n    var normalizedName = normalizeName(name);\n\n    // Exact match\n    for (var i = 0; i < sections.length; i++) {\n        if (String(sections[i].componentName || '').trim() === name) {\n            return sections[i];\n        }\n    }\n\n    // Normalized match\n    var normalizedMatches = [];\n    for (var j = 0; j < sections.length; j++) {\n        if (normalizeName(sections[j].componentName) === normalizedName) {\n            normalizedMatches.push(sections[j]);\n        }\n    }\n    if (normalizedMatches.length === 1) {\n        return normalizedMatches[0];\n    }\n    if (normalizedMatches.length > 1) {\n        return null;\n    }\n\n    // Contains match\n    var containsMatches = [];\n    for (var k = 0; k < sections.length; k++) {\n        var candidateNormalized = normalizeName(sections[k].componentName);\n        if (!candidateNormalized) {\n            continue;\n        }\n        if (candidateNormalized.indexOf(normalizedName) >= 0 || normalizedName.indexOf(candidateNormalized) >= 0) {\n            containsMatches.push(sections[k]);\n        }\n    }\n    if (containsMatches.length === 1) {\n        return containsMatches[0];\n    }\n\n    return null;\n};\n\nvar classifier = unwrapClassifier(classifierRaw);\nvar globalSummary = classifier.globalSummary || '';\nvar sections = classifier.componentSections || [];\nvar currentComponentName = typeof currentItem === 'string'\n    ? currentItem\n    : (currentItem && currentItem.componentName ? currentItem.componentName : String(currentItem || ''));\n\nvar buildOutput = (mode, contextText, componentText) => {\n    var parts = [];\n    parts.push('SLICE MODE: ' + mode);\n    parts.push('');\n    parts.push('PLAN CONTEXT:');\n    parts.push(contextText || '');\n    parts.push('');\n    parts.push('COMPONENT SECTION:');\n    parts.push(componentText || '');\n    return parts.join('\\n');\n};\n\nvar fallback = (mode) => buildOutput(mode, globalSummary, fullDocumentText);\n\nvar section = resolveSection(sections, currentComponentName);\nif (!section) {\n    return fallback('FALLBACK_NO_MATCH');\n}\n\nvar startIndex = findAnchorPosition(section.startsAt, 0);\nif (startIndex < 0) {\n    return fallback('FALLBACK_ANCHOR_MISS');\n}\n\nvar endIndex = fullDocumentText.length;\nif (section.endsAt !== null && section.endsAt !== undefined && String(section.endsAt).trim() !== '') {\n    endIndex = findAnchorPosition(section.endsAt, startIndex + 1);\n    if (endIndex < 0 || endIndex <= startIndex) {\n        return fallback('FALLBACK_ANCHOR_MISS');\n    }\n}\n\nvar slice = fullDocumentText.substring(startIndex, endIndex).trim();\nif (!slice || slice.length < 200) {\n    return fallback('FALLBACK_TOO_SHORT');\n}\n\nreturn buildOutput('CLASSIFIED', globalSummary, slice);"
                  },
