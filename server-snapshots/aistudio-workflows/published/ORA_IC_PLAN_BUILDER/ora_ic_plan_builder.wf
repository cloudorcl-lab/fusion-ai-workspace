mponents[' + (sequenceNumber - 1) + ']';\n\n    // Track component confidence (inline)\n    var compConf = componentDetails.confidence;\n    trackConfidence(compConf, componentPath + '.confidence');\n\n    // Build performance measures\n    var performanceMeasures = [];\n    var measureList = measures.measures || [];\n    for (var mIdx = 0; mIdx < measureList.length; mIdx++) {\n        var m = measureList[mIdx];\n        var mName = m.measureName || 'MEASURE';\n        var measureScope = componentScope + '_M' + padGeneratedIndex(mIdx + 1);\n        var measureId = makeGeneratedId('PM_', mName, 'MEASURE', measureScope);\n        var measurePath = componentPath + '.performanceMeasures[' + mIdx + ']';\n\n        // Track measure confidence\n        var mConf = m.confidence;\n        trackConfidence(mConf, measurePath + '.confidence');\n\n        // Build goals\n        var goals = [];\n        var goalList = m.goals || [];\n        for (var gIdx = 0; gIdx < goalList.length; gIdx++) {\n            var g = goalList[gIdx];\n            var gConf = g.confidence;\n            trackConfidence(gConf, measurePath + '.goals[' + gIdx + '].confidence');\n            var goalRecord = {\n                targetAmount: g.targetAmount,\n                periodType: g.periodType,\n                periodNumber: valueOrNull(g.periodNumber),\n                distributeEvenlyFlag: valueOrNull(g.distributeEvenlyFlag),\n                startDate: valueOrNull(g.startDate),\n                endDate: valueOrNull(g.endDate),\n                confidence: valueOrNull(gConf),\n                status: statusForConfidence(gConf),\n                reviewNotes: null\n            };\n            if (hasValue(g.targetUnitOfMeasure)) {\n                goalRecord.targetUnitOfMeasure = g.targetUnitOfMeasure;\n            }\n            goals.push(goalRecord);\n        }\n\n        // Build credit categories\n        var creditCategories = [];\n        var ccList = m.creditCategories || [];\n        for (var