abel = referenceOwnerType === 'MEASURE' ? 'measure' : 'formula';\n        var contextKey = ownerLabel + '=' + ownerName + '|rateTable=' + refTableName;\n        if (rtMatch.ambiguous) {\n            var ambiguousOptions = [];\n            for (var candidateIdx = 0; candidateIdx < rtMatch.candidates.length; candidateIdx++) {\n                ambiguousOptions.push(componentRateTables[rtMatch.candidates[candidateIdx]].rateTableName);\n            }\n            openQuestions.push({\n                type: 'WIRING_RATE_TABLE_MATCH',\n                path: path,\n                context: contextKey,\n                message: 'Ambiguous match for a formula-referenced rate table.',\n                options: ambiguousOptions,\n                source: 'ASSEMBLER_CROSSCHECK'\n            });\n            warnings.push('Ambiguous formula-referenced rate table match for \"' + refTableName + '\" from ' + ownerLabel + ' \"' + ownerName + '\".');\n            return;\n        }\n\n        openQuestions.push({\n            type: 'WIRING_RATE_TABLE_MATCH',\n            path: path,\n            context: contextKey,\n            message: 'Formula references a rate table that was not extracted for this component.',\n            options: knownRateTableNames,\n            source: 'ASSEMBLER_CROSSCHECK'\n        });\n        warnings.push('Formula references unknown rate table \"' + refTableName + '\" from ' + ownerLabel + ' \"' + ownerName + '\".');\n    };\n\n    for (var pmRtIdx = 0; pmRtIdx < performanceMeasures.length; pmRtIdx++) {\n        var pmRt = performanceMeasures[pmRtIdx];\n        var pmReferencedRateTables = (pmRt && pmRt.formula && pmRt.formula.expression && pmRt.formula.expression.referencedRateTables)\n            ? pmRt.formula.expression.referencedRateTables\n            : [];\n        for (var pmRefIdx = 0; pmRefIdx < pmReferencedRateTables.length; pmRefIdx++) {\n            registerReferencedRateTableGap(\n                'MEASURE',\n                pmRt.measureName,\