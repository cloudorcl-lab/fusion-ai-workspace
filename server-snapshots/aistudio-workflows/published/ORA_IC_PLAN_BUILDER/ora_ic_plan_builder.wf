        {
          "id": "2",
          "code": "PREPARE_DOCUMENT_TEXT",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Document Text",
            "returnType": "object",
            "sourceCode": "var stringifyValue = (value) => {\n  try {\n    return JSON.stringify(value);\n  } catch {\n    return String(value);\n  }\n};\n\nvar toDocumentText = (toolOutput) => {\n  if (!toolOutput || typeof toolOutput !== 'object') {\n    return '';\n  }\n\n  var chunks = [];\n  var entries = Object.entries(toolOutput);\n\n  for (var idx = 0; idx < entries.length; idx += 1) {\n    var entry = entries[idx];\n    var key = entry[0];\n    var value = entry[1];\n\n    if (key === 'ORA_CHAT_ATTACHMENTS_RAW_FILECONTENT') {\n      continue;\n    }\n    if (value === null || value === undefined) {\n      continue;\n    }\n\n    if (typeof value === 'string') {\n      var trimmed = value.trim();\n      if (trimmed) {\n        chunks.push(`FILE: ${key}\\n${trimmed}`);\n      }\n      continue;\n    }\n\n    if (typeof value === 'object') {\n      var candidateText =\n        (typeof value.text === 'string' && value.text) ||\n        (typeof value.content === 'string' && value.content) ||\n        (typeof value.extractedText === 'string' && value.extractedText) ||\n        '';\n\n      if (candidateText.trim()) {\n        chunks.push(`FILE: ${key}\\n${candidateText.trim()}`);\n      } else {\n        chunks.push(`FILE: ${key}\\n${stringifyValue(value)}`);\n      }\n      continue;\n    }\n\n    chunks.push(`FILE: ${key}\\n${String(value)}`);\n  }\n\n  return chunks.join('\\n\\n').trim();\n};\n\nvar triggerText = $context.$triggers.REST.$input.planDocument;\nif (typeof triggerText === 'string' && triggerText.trim()) {\n  return triggerText;\n}\n\nvar documentToolOutput = $context.$nodes.DOCUMENT_TOOL.$output;\nreturn toDocumentText(documentToolOutput);"
          },
          "outcomes": {
            "success": "3"
          },
          "inputs": [],
          "diagram": {
            "x": 5000,
            "y": 5660
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "3",
          "code": "PARALLEL_1763095499421",
          "type": "PARALLEL",
          "metadata": {
            "name": "Run in Parallel"
          },
          "outcomes": {
            "0": "4",
            "1": "5"
          },
          "inputs": [],
          "diagram": {
            "x": 5000,
            "y": 5880
          },
          "convergenceTargetId": "1763096851002"
        },
        {
          "id": "4",
          "code": "PLAN_DETAILS_EXTRACTOR",
          "type": "LLM",
          "metadata": {
            "name": "Plan Details Extractor",
            "reasoningEffort": "low"
          },
          "outcomes": {
            "success": "1763096851002"
          },
          "inputs": [
            {
              "id": "4_prompt",
              "name": "prompt",
              "type": "string",
              "value": "You are an expert at analyzing compensation plan documents. Extract the high-level metadata from this document.\n\nDOCUMENT TEXT:\n{{$context.$nodes.PREPARE_DOCUMENT_TEXT.$output.result}}\n\nINSTRUCTIONS:\n1. Identify the plan name (look for titles, headers, or \"Plan Name:\" labels)\n   - Check document title, headers, executive summary\n   - Look for explicit \"Plan Name:\" or \"Program Name:\" labels\n   - If multiple names exist, choose the most prominent/official one\n\n2. Extract a brief description of the plan's purpose\n   - Summarize in 1-2 sentences\n   - Focus on strategic objectives and what the plan incentivizes\n   - Look in executive summary, plan purpose, or introduction sections\n\n3. Find the business unit if mentioned\n   - Department, division, or organizational unit\n   - Examples: \"Sales Organization\", \"Customer Success\", \"Enterprise Sales\"\n\n4. Extract start and end dates if present\n   - Format dates as YYYY-MM-DD\n   - Look for \"Effective Date\", \"Performance Period\", \"Plan Year\"\n   - Common patterns: \"January 1, 2025\" → \"2025-01-01\"\n   - If fiscal year is mentioned, convert to calendar dates\n\n5. Extract plan-level target incentive if present\n   - Look for terms: \"target incentive\", \"on-target earnings\", \"OTE\", \"expected payout\"\n   - Return numeric amount without currency symbols or commas\n   - If not explicitly stated, set to null\n\n6. Extract whether credit category overlap is allowed across components\n   - Return true only when the document explicitly allows shared/reused credit categories\n   - Return false when explicitly disallowed\n   - If not stated, set to null\n\nBe precise and conservative in your extraction. If information is not clearly stated, mark it as null.\n\nOUTPUT FORMAT:\nRespond ONLY with valid JSON matching this exact schema:\n\n{\n  \"planName\": \"string (required) - The official name of the compensation plan\",\n  \"description\": \"string or null - Brief description of plan purpose\",\n  \"businessUnit\": \"string or null - Business unit or organization\",\n  \"effectiveStartDate\": \"string (YYYY-MM-DD format) or null - Plan start date\",\n  \"effectiveEndDate\": \"string (YYYY-MM-DD format) or null - Plan end date\",\n  \"targetIncentive\": \"number or null - Plan-level OTE/target incentive\",\n  \"allowCreditCategoryOverlapFlag\": \"boolean or null - Whether earning-basis measures can share credit categories\"\n}\n\nIMPORTANT REMINDERS:\n- Respond with ONLY the JSON object, no additional text or explanations\n- Do not include markdown code blocks or formatting\n- All field names must match exactly as specified\n- Use null for missing values, not empty strings or \"N/A\"\n- Dates must be in YYYY-MM-DD format"
            }
          ],
          "diagram": {
            "x": 5000,
            "y": 6100
          },
          "outputSpecification": "{\"$schema\": \"http://json-schema.org/draft-07/schema#\", \"type\": \"object\", \"properties\": {\"planName\": {\"type\": \"string\", \"description\": \"The official name of the compensation plan\", \"minLength\": 1}, \"description\": {\"type\": [\"string\", \"null\"], \"description\": \"Brief description of the plan's purpose\"}, \"businessUnit\": {\"type\": [\"string\", \"null\"], \"description\": \"Business unit or organizational division\"}, \"effectiveStartDate\": {\"type\": [\"string\", \"null\"], \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\", \"description\": \"Plan start date in YYYY-MM-DD format\"}, \"effectiveEndDate\": {\"type\": [\"string\", \"null\"], \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\", \"description\": \"Plan end date in YYYY-MM-DD format\"}, \"targetIncentive\": {\"type\": [\"number\", \"null\"], \"minimum\": 0, \"description\": \"Plan-level target incentive (OTE)\"}, \"allowCreditCategoryOverlapFlag\": {\"type\": [\"boolean\", \"null\"], \"default\": false, \"description\": \"Whether earning-basis measures may share credit categories across components\"}}, \"required\": [\"planName\"], \"additionalProperties\": false}"
        },
        {
          "id": "5",
          "code": "DOCUMENT_SECTION_CLASSIFIER",
          "type": "LLM",
          "metadata": {
            "name": "Document Section Classifier",
            "reasoningEffort": "low"
          },
          "outcomes": {
            "success": "1763096851002"
          },
          "inputs": [
            {
              "id": "5_prompt",
              "name": "prompt",
              "type": "string",
              "value": "You are an expert at segmenting compensation plan documents for reliable extraction.\n\nDOCUMENT TEXT:\n{{$context.$nodes.PREPARE_DOCUMENT_TEXT.$output.result}}\n\nTASK:\n\nProduce structured output with:\n1) A concise global plan summary (shared context only)\n2) Component section boundaries using start/end anchor phrases\n\nRULES:\n\n- Global summary is for shared plan context only (plan-level rules, definitions, cadence, caps, thresholds, dependencies).\n- Do NOT copy detailed measure formulas, rate tiers, or payout table values into global summary.\n- Component sections must preserve extraction-critical details via anchor boundaries.\n\nCOMPONENT IDENTIFICATION (CRITICAL):\n\n- A component is a top-level payout structure (bonus/commission/incentive) that has its own payout logic.\n- Do NOT treat narrative headings as components (e.g., \"Purpose\", \"Eligibility\", \"Administration\", \"Measure\", \"Data Requirements\").\n- Component names are typically the named payout sections (e.g., \"Territory Quota Bonus\", \"Account Expansion Revenue\").\n- If the document lists \"Component 1/2/3\" headings, use the component name inside those sections (not the heading label itself).\n- Measures, KPIs, weighted scorecard rows, and quota metrics inside one payout construct are NOT components.\n- If the document has one payout construct with multiple weighted measures, return ONE component section that spans the full payout logic, not one section per measure.\n- Do NOT use headings like \"Measure 1\", \"Measure 2\", \"Revenue Recognition\", \"Pay Frequency\", or \"True-Up\" as component names unless the document explicitly labels them as a component/bonus/commission section.\n- When there is only one payout construct and it does not have a clean explicit component title, return a single component section using the best available payout label. If needed, synthesize a stable descriptive name based on the plan (for example, \"<plan name> incentive component\").\n\nCOMPONENT SECTION ANCHORS:\n\n- `startsAt`: phrase that marks where component-specific detail begins.\n- `endsAt`: phrase that marks where component-specific detail ends.\n- Anchors should be long and specific enough to be unique when possible.\n- If component runs to end of document, use null for `endsAt`.\n\nGLOBAL SUMMARY SHOULD INCLUDE (when present):\n\n- Plan name, effective dates, target incentive (if present)\n- Processing cadence / pay frequency\n- Cross-component rules (caps, thresholds, gatekeepers, banking, hurdles)\n- Key calculation definitions shared across components\n\nOUTPUT FORMAT:\n\nReturn ONLY valid JSON. No markdown.\n\n{\n  \"globalSummary\": \"string\",\n  \"componentSections\": [\n    {\n      \"componentName\": \"string\",\n      \"startsAt\": \"string\",\n      \"endsAt\": \"string or null\",\n      \"confidence\": 0.0,\n      \"evidence\": \"string\"\n    }\n  ]\n}\n\nIMPORTANT:\n\n- Include all identified top-level payout components only.\n- Exclude headings that describe plan metadata or implementation guidance (purpose, eligibility, administration, examples).\n- Component names should match document terminology as closely as possible.\n- If the plan is really a single component with multiple measures, output exactly one `componentSections` entry.\n- If uncertain on a boundary, still provide best anchor and lower confidence."
            }
          ],
          "diagram": {
            "x": 5000,
            "y": 6320
          },
          "outputSpecification": "{\"$schema\": \"http://json-schema.org/draft-07/schema#\", \"type\": \"object\", \"properties\": {\"globalSummary\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"Condensed shared plan context\"}, \"componentSections\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"componentName\": {\"type\": \"string\", \"minLength\": 1}, \"startsAt\": {\"type\": \"string\", \"minLength\": 1}, \"endsAt\": {\"type\": [\"string\", \"null\"]}, \"confidence\": {\"type\": \"number\", \"minimum\": 0.0, \"maximum\": 1.0}, \"evidence\": {\"type\": \"string\", \"minLength\": 1}}, \"required\": [\"componentName\", \"startsAt\", \"endsAt\", \"confidence\", \"evidence\"], \"additionalProperties\": false}}}, \"required\": [\"globalSummary\", \"componentSections\"], \"additionalProperties\": false}"
        },
        {
          "id": "6",
          "code": "BUILD_LOOKUP_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Build Lookup Context",
            "returnType": "object",
            "sourceCode": "var orgCatalogRaw = $context.$nodes.CALL_ORG_CATALOG\n  ? $context.$nodes.CALL_ORG_CATALOG.$output\n  : null;\n\nvar parseMaybeJson = function(value) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n  if (typeof value !== 'string') {\n    return value;\n  }\n  try {\n    return JSON.parse(value);\n  } catch (_err) {\n    return null;\n  }\n};\n\nvar extractOrgCatalog = function(workflowOutput) {\n  var envelope = parseMaybeJson(workflowOutput);\n  if (envelope && envelope.output !== undefined) {\n    var child = parseMaybeJson(envelope.output);\n    if (child && child.result && child.result.catalog) {\n      return child.result.catalog;\n    }\n    if (child && child.catalog) {\n      return child.catalog;\n    }\n  }\n  if (envelope && envelope.result && envelope.result.catalog) {\n    return envelope.result.catalog;\n  }\n  if (envelope && envelope.catalog) {\n    return envelope.catalog;\n  }\n  return null;\n};\n\nvar orgCatalog = extractOrgCatalog(orgCatalogRaw);\n\nvar staticLookups = orgCatalog && orgCatalog.staticLookups ? orgCatalog.staticLookups : new Object();\n\nvar getAllowed = function(type, fallback) {\n  var out = [];\n  var seen = new Object();\n  var rows = staticLookups[type] && staticLookups[type].allowedCodes ? staticLookups[type].allowedCodes : fallback;\n  rows = rows && rows.length !== undefined ? rows : [];\n  for (var i = 0; i < rows.length; i += 1) {\n    if (rows[i] === null || rows[i] === undefined) {\n      continue;\n    }\n    var value = String(rows[i]).toUpperCase();\n    if (!seen[value]) {\n      seen[value] = true;\n      out.push(value);\n    }\n  }\n  return out;\n};\n\nvar getIntervalAllowed = function(catalog) {\n  var rows = catalog && catalog.intervals && catalog.intervals.length !== undefined\n    ? catalog.intervals\n    : [];\n  var out = [];\n  var seen = new Object();\n  for (var i = 0; i < rows.length; i += 1) {\n    var row = rows[i] ? rows[i] : new Object();\n    var value = row.intervalName !== undefined && row.intervalName !== null ? String(row.intervalName).trim() : '';\n    if (!value || seen[value]) {\n      continue;\n    }\n    seen[value] = true;\n    out.push(value);\n  }\n  if (out.length === 0) {\n    return ['Period', 'Quarter', 'Year'];\n  }\n  return out;\n};\n\nvar componentTypeAllowed = getAllowed('CN_REPORT_GROUP', ['BONUS', 'COMMISSION', 'STANDARD']);\nvar incentiveTypeAllowed = getAllowed('CN_PLAN_INCENTIVE_TYPE', ['COMMISSION', 'BONUS']);\nvar includeIndirectCreditsAllowed = getAllowed('CN_PLAN_INDIRECT_CREDIT', ['NONE', 'ALL', 'MGR', 'TEAM']);\nvar processTransactionAllowed = getAllowed('CN_PROCESS_TXN', ['GROUP', 'INDIVIDUAL']);\nvar commissionUnitAllowed = getAllowed('CN_COMMISSION_UNIT_CODE', ['AMOUNT', 'PERCENT']);\nvar intervalAllowed = getIntervalAllowed(orgCatalog);\nvar intervalAllowedText = intervalAllowed.join(', ');\n\nvar lines = [];\nlines.push('LOOKUP CONTEXT');\nlines.push('');\nlines.push('Component type values: ' + componentTypeAllowed.join(', '));\nlines.push('Incentive type values: ' + incentiveTypeAllowed.join(', '));\nlines.push('Include indirect credits values: ' + includeIndirectCreditsAllowed.join(', '));\nlines.push('Process transaction values: ' + processTransactionAllowed.join(', '));\nlines.push('Commission unit values: ' + commissionUnitAllowed.join(', '));\nlines.push('');\nlines.push('Notes:');\nlines.push('- Use exact codes from these lists for lookup-backed fields.');\nlines.push('- componentType must be one of the supported component type values.');\nlines.push('- incentiveType must be one of the supported incentive type values, or null when not applicable.');\nlines.push('- For performanceInterval, payoutFrequency, and resetInterval, use the exact supported values provided separately in the prompt.');\nlines.push('- Parser-only values such as QUANTITY, SCORE, STRING, and EXPRESSION remain allowed where the schema already supports them.');\n\nvar result = new Object();\nresult.lookupContextText = lines.join('\\n');\nresult.performanceIntervalValues = intervalAllowedText;\nresult.payoutFrequencyValues = intervalAllowedText;\nresult.resetIntervalValues = intervalAllowedText;\n\nreturn result;"
          },
          "outcomes": {
            "success": "7"
