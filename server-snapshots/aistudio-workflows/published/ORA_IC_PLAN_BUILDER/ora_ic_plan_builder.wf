            "name": "Adapt Description Output",
            "returnType": "string",
            "sourceCode": "// ADAPT_DESC_OUTPUT - Plan Builder CODE node\n// Adapt Description Output\n//\n// Adapter: Extract plan from Description Generator output\n// Error handling: If Description Generator fails, pass through the resolved plan\n// NOTE: AI Studio CODE nodes don't support return inside try block\n\n// Get fallback plan (plan after precheck, before description generation)\nvar fallbackPlan = $context.$nodes.APPLY_PRECHECK_OUTPUT.$output.result;\nvar fallbackResult = typeof fallbackPlan === 'string' ? fallbackPlan : JSON.stringify(fallbackPlan);\n\nvar workflowResponse = $context.$nodes.CALL_DESCRIPTION_GENERATOR.$output;\n\n// Check if workflow response exists\nif (!workflowResponse) {\n    return fallbackResult;\n}\n\nvar parseMaybeJson = function(value) {\n    if (value === null || value === undefined) {\n        return null;\n    }\n    if (typeof value !== 'string') {\n        return value;\n    }\n    try {\n        return JSON.parse(value);\n    } catch (_err) {\n        return null;\n    }\n};\n\nvar extractDescriptionOutput = function(value) {\n    var envelope = parseMaybeJson(value);\n    if (!envelope || envelope.output === undefined) {\n        return null;\n    }\n    return parseMaybeJson(envelope.output);\n};\n\nvar output = extractDescriptionOutput(workflowResponse);\nif (!output) {\n    return fallbackResult;\n}\n\n// Extract the plan with descriptions\nvar planWithDescriptions = output.planWithDescriptions;\nif (!planWithDescriptions) {\n    return fallbackResult;\n}\n\nvar plan = parseMaybeJson(planWithDescriptions);\nif (!plan) {\n    return fallbackResult;\n}\n\nvar fallbackPlanObj = parseMaybeJson(fallbackPlan);\n\nif (fallbackPlanObj && fallbackPlanObj.metadata && fallbackPlanObj.metadata.precheck) {\n    if (!plan.metadata) {\n        plan.metadata = new Object();\n    }\n    if (!plan.metadata.precheck) {\n        plan.metadata.precheck = fallbackPlanObj.metadata.precheck;\n    }\n}\n\nif (fallbackPlanObj && fallbackPlanObj.metadata && fallbackPlanObj.metadata.orgCatalog) {\n    if (!plan.metadata) {\n        plan.metadata = new Object();\n    }\n    if (!plan.metadata.orgCatalog) {\n        plan.metadata.orgCatalog = fallbackPlanObj.metadata.orgCatalog;\n    }\n}\n\nreturn JSON.stringify(plan);"
          },
