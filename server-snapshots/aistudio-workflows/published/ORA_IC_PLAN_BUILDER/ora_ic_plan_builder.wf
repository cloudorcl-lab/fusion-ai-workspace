                }\n                )\n            };\n        }\n\n        performanceMeasures.push({\n            measureId: measureId,\n            measureName: m.measureName,\n            description: valueOrNull(m.description),\n            measureType: m.measureType || undefined,\n            unitOfMeasure: m.unitOfMeasure,\n            processTransaction: m.processTransaction,\n            splitOption: valueOrNull(m.splitOption),\n            runningTotalFlag: valueOrNull(m.runningTotalFlag),\n            weight: valueOrNull(m.weight),\n            performanceInterval: hasValue(m.performanceInterval) ? findCatalogIntervalLabel(m.performanceInterval) : null,\n            startDate: valueOrNull(m.startDate),\n            endDate: valueOrNull(m.endDate),\n            confidence: valueOrNull(mConf),\n            status: statusForConfidence(mConf),\n            reviewNotes: null,\n            goals: goals,\n            formula: measureFormula,\n            creditCategories: creditCategories\n            // NOTE: scorecards and rateDimensionalInputs are added during wiring phase\n            // if a scorecard is detected. They are omitted (not null) if no scorecard.\n        });\n    }\n\n    // Build rate tables\n    var componentRateTables = [];\n    var rtList = rateTables.rateTables || [];\n    for (var rtIdx = 0; rtIdx < rtList.length; rtIdx++) {\n        var rt = rtList[rtIdx];\n        var rtName = rt.rateTableName || 'RATETABLE';\n        var rateTableScope = componentScope + '_RT' + padGeneratedIndex(rtIdx + 1);\n        var rateTableId = makeGeneratedId('RT_', rtName, 'RATETABLE', rateTableScope);\n        var rtPath = componentPath + '.rateTables[' + rtIdx + ']';\n\n        var rtConf = rt.confidence;\n        trackConfidence(rtConf, rtPath + '.confidence');\n\n        var rateValues = [];\n        var pvList = rt.rateValues || [];\n        for (var pvIdx = 0; pvIdx < pvList.length; pvIdx++) {\n            var pv = pvList[pvIdx];\n            var pvConf =