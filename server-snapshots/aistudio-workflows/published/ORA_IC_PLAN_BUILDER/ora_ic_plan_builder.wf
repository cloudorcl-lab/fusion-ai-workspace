        {
          "id": "1763096851004",
          "code": "ADAPT_RESOLVER_OUTPUT",
          "type": "CODE",
          "metadata": {
            "name": "Adapt Resolver Output",
            "returnType": "string",
            "sourceCode": "var fallbackPlan = $context.$nodes.ASSEMBLE_PARSER_OUTPUT.$output.result;\nvar fallbackResult = typeof fallbackPlan === 'string' ? fallbackPlan : JSON.stringify(fallbackPlan);\n\nvar workflowResponse = $context.$nodes.CALL_EXPRESSION_RESOLVER.$output;\n\nvar parseMaybeJson = function(value) {\n    if (value === null || value === undefined) {\n        return null;\n    }\n    if (typeof value !== 'string') {\n        return value;\n    }\n    try {\n        return JSON.parse(value);\n    } catch (_err) {\n        return null;\n    }\n};\n\nvar extractPlanFromResolverWorkflow = function(candidate) {\n    var envelope = parseMaybeJson(candidate);\n    if (!envelope || typeof envelope !== 'object') {\n        return null;\n    }\n\n    if (envelope.planWithResolutions) {\n        var directPlan = parseMaybeJson(envelope.planWithResolutions);\n        return (directPlan && directPlan.compensationPlan && directPlan.planComponents) ? directPlan : null;\n    }\n\n    if (envelope.result !== undefined) {\n        var fromResult = extractPlanFromResolverWorkflow(envelope.result);\n        if (fromResult) {\n            return fromResult;\n        }\n    }\n\n    if (envelope.output !== undefined) {\n        var fromOutput = extractPlanFromResolverWorkflow(envelope.output);\n        if (fromOutput) {\n            return fromOutput;\n        }\n    }\n\n    return null;\n};\n\nvar normalizePlanOutput = function(planObj) {\n    var parsedPlan = parseMaybeJson(planObj);\n    if (!parsedPlan || typeof parsedPlan !== 'object') {\n        return null;\n    }\n    return parsedPlan;\n};\n\nif (!workflowResponse) {\n    var fallbackPlanMissingWorkflow = normalizePlanOutput(fallbackPlan);\n    return fallbackPlanMissingWorkflow ? JSON.stringify(fallbackPlanMissingWorkflow) : fallbackResult;\n}\n\nvar plan = extractPlanFromResolverWorkflow(workflowResponse);\nif (!plan) {\n    var fallbackPlanMissingOutput = normalizePlanOutput(fallbackPlan);\n    return fallbackPlanMissingOutput ? JSON.stringify(fallbackPlanMissingOutput) : fallbackResult;\n}\n\nreturn JSON.stringify(plan);"
          },
