                {
                  "metadata": {
                    "name": "Fetch candidate names",
                    "returnType": "array",
                    "sourceCode": "let items  = $context.$nodes.LOOP_OVER_PLANIDS.GET_PLAN_CANDIDATE_HISTORY.$output.items;\n\n// First, filter by ModifiedColumn\nconst filteredItems = items.filter(\n    item => item.ModifiedColumn === \"SUCCESSION_STATUS\"\n);\n\nconst uniqueCandidates = [];\nconst seenNames = new Set();\n\nfor (const item of filteredItems) {\n  const name = item.CandidateDisplayName;  \n  if (!seenNames.has(name)) {\n    uniqueCandidates.push({      \n      CandidateDisplayName: name,      \n      NewDisplayValue: item.NewDisplayValue    \n    });    \n    seenNames.add(name);  \n  }\n}\n\nreturn uniqueCandidates;"
                  },
                  "outcomes": {
                    "success": "end_1771405358917"
                  },
                  "diagram": {
                    "x": 5450.5,
                    "y": 8170
