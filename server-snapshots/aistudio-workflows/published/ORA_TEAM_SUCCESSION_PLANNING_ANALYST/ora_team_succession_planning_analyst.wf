{
  "workflowId": "100002355227220",
  "workflowCode": "ORA_TEAM_SUCCESSION_PLANNING_ANALYST",
  "name": "Team Succession Planning Analyst",
  "description": "Provides managers with self-service access to their team's succession information, including the count and names of critical team members or direct reports who don't have succession plans, count and names of team members who don't have Ready-Now successors, succession plans that need attention because their incumbents or candidates have moved to new roles or are no longer working for the organization. It also recommends actions to the manager based on the succession summary that it generates for the manager's team.",
