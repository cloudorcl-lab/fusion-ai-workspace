          "id": "1771403937725",
          "inputs": [
            {
              "id": "1771403937726_1",
              "name": "prompt",
              "type": "string",
              "value": "From {{$context.$system.$inputMessage}}, extract DateFrom, given today's date is {{$context.$system.$currentDate}}.\n\nIf user mentions last n days, set DateFrom to n days prior to today's date.\nIf user mentions last n months, set DateFrom to n months prior to today's date.\nIf user mentions recently, set DateFrom to 7 days prior to today's date.\nIf user didn't mention any date or month, set DateFrom to 3 months prior to today's date.\n\nOutput strictly a single JSON object having key, \"DateFrom\" which has the date extracted from the user input.\n{\"DateFrom\":<extracted date>}"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
