            "name": "Get all role changed candidates",
            "returnType": "array",
            "sourceCode": "let output = $context.$nodes.LOOP_OVER_PLANIDS.$output;\n\nconst jsonArray = output.map(item => JSON.parse(item));\n\nconst allResults = []; // This will hold the combined result items\n\nfor (let i = 0; i < jsonArray.length; i++) {  \n  const resultArray = jsonArray[i].result;  \n  for (let j = 0; j < resultArray.length; j++) {    \n    allResults.push(resultArray[j]);  \n  }\n}\n\nreturn allResults;"
          },
