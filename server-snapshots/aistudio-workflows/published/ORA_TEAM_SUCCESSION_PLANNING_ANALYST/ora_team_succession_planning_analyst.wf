        {
          "metadata": {
            "name": "Retrieve persons with succession Plans",
            "returnType": "array",
            "sourceCode": "let items = $context.$nodes.DIRECT_REPORTS_WITH_SUCCESSION_PLAN.$output.items;\n\nlet names = [];\n\nfor (let i = 0; i < items.length; i++) {\n    let emp = items[i];\n\n    names.push(emp.DisplayName);\n}\n\n\nreturn names;"
          },
          "outcomes": {
            "success": "1767863173368"
          },
          "code": "RETRIEVE_PERSONS_WITH_SUCCESSION_PLANS",
          "convergenceTargetId": "1767863173368",
          "id": "1767947945268",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Retrieve persons without ready-now candidates",
            "returnType": "object",
            "sourceCode": "let items = $context.$nodes.DIRECT_REPORTS_WITH_SUCCESSION_PLAN.$output.items;\n\nlet names = [];\nlet planIdsSet = new Set();\n\nfor (let i = 0; i < items.length; i++) {\n  let emp = items[i];\n  const plans = (emp.successionPlans && Array.isArray(emp.successionPlans.items))? emp.successionPlans.items : [];\n    \n  let hasReadyNow = false;\n      \n  for (let p = 0; p < plans.length; p++) {\n    const plan = plans[p];\n    const levels = (plan.readinessLevels && Array.isArray(plan.readinessLevels.items))? plan.readinessLevels.items : [];\n                  \n    planIdsSet.add(plan.PlanId);\n                      \n    for (let r = 0; r < levels.length; r++) {\n      const level = levels[r];\n      if (level.ReadinessCode === 'READY_NOW') {\n        const total = Number(level.TotalCandidates || 0);\n        const candidateItems = (level.readinessCandidates && Array.isArray(level.readinessCandidates.items)) ? level.readinessCandidates.items : [];\n        if (total > 0 || candidateItems.length > 0) {\n          hasReadyNow = true;\n          break;\n        }\n      }\n    }\n  }\n                                                    \n  if (!hasReadyNow) {\n    names.push(emp.DisplayName);\n  }\n}\n      \nlet planIdsArray = Array.from(planIdsSet);\n\nlet returnObject = {};\n\nreturnObject[\"names\"] = names;\n\nreturnObject[\"planIds\"] = planIdsArray;\n\nreturn returnObject;"
          },
          "outcomes": {
            "success": "1771405358917"
          },
          "code": "RETRIEVE_PERSONS_WITHOUT_READYNOW_CANDIDATES",
          "convergenceTargetId": "1771405358917",
          "id": "1767863173368",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
