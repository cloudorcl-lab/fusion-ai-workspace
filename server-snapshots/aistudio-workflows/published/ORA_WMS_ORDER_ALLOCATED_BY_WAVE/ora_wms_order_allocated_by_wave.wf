          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result_count\": { \"type\": \"integer\" },\n    \"page_count\": { \"type\": \"integer\" },\n    \"page_nbr\": { \"type\": \"integer\" },\n    \"next_page\": { \"type\": [\"string\", \"null\"] },\n    \"previous_page\": { \"type\": [\"string\", \"null\"] },\n    \"results\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"wave_id__run_nbr\": { \n           \"type\": \"string\" ,\n           \"description\":\"This is the Wave Number\"\n           },\n          \"status_id\": {\n          \"type\": \"integer\",\n            \"description\": \"Status of the  Allocation\"\n            },\n          \"task_id__task_nbr\": {\n          \"type\": \"string\",\n          \"description\":\"Task Number created\"\n           },\n          \"order_dtl_id\": { \n           \"type\": \"integer\",\n          \"description\":\"Order Detail identifier.\"\n           },\n          \"order_dtl_id__orig_ord_qty\": { \n          \"type\": \"number\",\n          \"description\":\"Order Detail original order quantity.\"\n          },\n          \"order_dtl_id__alloc_qty\": { \n          \"type\": \"number\",\n          \"description\":\"Order Detail allocated  quantity.\"\n         }\n        },\n        \"required\": [\n          \"wave_id__run_nbr\",\n          \"status_id\",\n          \"task_id__task_nbr\",\n          \"order_dtl_id\",\n          \"order_dtl_id__orig_ord_qty\",\n          \"order_dtl_id__alloc_qty\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"result_count\",\n    \"page_count\",\n    \"page_nbr\",\n    \"next_page\",\n    \"previous_page\",\n    \"results\"\n  ]\n}",
