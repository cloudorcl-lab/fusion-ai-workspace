", \"create_user\", \"create_ts\", \"mod_user\", \"mod_ts\", \"facility_id\",\n          \"company_id\", \"order_nbr\", \"order_type_id\", \"status_id\", \"ord_date\",\n          \"dest_facility_id\", \"shipto_facility_id\", \"order_dtl_set\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"result_count\", \"page_count\", \"page_nbr\", \"next_page\", \"previous_page\", \"results\"\n  ]\n}",
