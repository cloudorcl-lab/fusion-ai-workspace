          "code": "DISPLAYSTATUS",
          "id": "1774344669900",
          "inputs": [
            {
              "id": "1774344669901_1",
              "name": "prompt",
              "type": "string",
              "value": "If {{$context.$nodes.SCRAPITEMS.$output.status}} is \"SUCCESS\" then \n     Display `Item {{$context.$variables.ItemNumber}} has been scrapped successfully from Subinventory {{$context.$nodes.EXTRACTINPUT.$output.result.Subinventory}}` \nElse \n      Display `Scrapping Failed`\n\nDon't assume anything else and don't show anything else just show text based on if else logic. Don't show the entire if block."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "PrepareWidgetsToDisplay",
            "returnType": "object",
            "sourceCode": "// --- Step 0: Extract input & items ---\nconst items = $context.$nodes.EXTRACTITEMSFORMLOOPOUTPUT?.$output?.items ?? [];\nconst SourceOrganization = $context.$variables.OrganizationCode ?? \"\";\nconst AvailableForTransfer = $context.$nodes.EXTRACTINPUT?.$output?.result?.AvailableQuantity ?? 0;\nconst SourceSubinventory = $context.$nodes.EXTRACTINPUT?.$output?.result?.Subinventory ?? \"\";\nconst SourceLocator = $context.$nodes.EXTRACTINPUT?.$output?.result?.LocatorId ?? \"\";\nconst scrapInput = $context.$nodes.EXTRACTINPUT?.$output?.result ?? {};\nconst itemNumber = $context.$variables.ItemNumber ?? \"\";\nconst pItemId = $context.$variables.pItemId ?? \"\";\nconst OrganizationId = $context.$variables.OrganizationId ?? \"\";\nconst OrganizationCode = $context.$variables.OrganizationCode ?? \"\";\nconst PrimaryUOMName = $context.$variables.PrimaryUOM ?? \"\";\nconst PrimaryUOMCode = $context.$variables.PrimaryUOMCode ?? \"\";\n\n// --- Step 1: Prepare MultiRecord rows ---\nconst multiRecordWidgetRows = items\n  .map(item => {\n    const requiredQty = (item.TotalDemandQuantity ?? 0) - (item.TotalSupplyQuantity ?? 0);\n    // Skip rows where required quantity <= 0 or Source = Destination\n    if (requiredQty <= 0 || SourceOrganization === (item.OrganizationCode ?? \"\")) return null;\n\n    const actionQty = Math.min(requiredQty, AvailableForTransfer);\n\n    return {\n      cells: [\n        SourceOrganization, // Source Organization\n        item.OrganizationCode ?? null, // Destination Organization\n        (item.TotalSupplyQuantity ?? 0) + \" \" + (PrimaryUOMName || PrimaryUOMCode || \"\"), // Supply at Destination\n        (item.TotalDemandQuantity ?? 0) + \" \" + (PrimaryUOMName || PrimaryUOMCode || \"\"), // Demand at Destination\n        requiredQty + \" \" + (PrimaryUOMName || PrimaryUOMCode || \"\"), // Required Qty At Destination\n        AvailableForTransfer + \" \" + (PrimaryUOMName || PrimaryUOMCode || \"\"), // Available Quantity for Transfer\n        item.InventoryItemId\n      ],\n      action: [\n        {\n          text: \"Create Transfer Order\",\n          command: `ora.Agent(\"OrderCreation\", ${JSON.stringify({\n            SourceOrganization,\n            SourceSubinventory,\n            SourceLocator,\n            DestinationOganizationId: item.OrganizationId ?? null,\n            DestinationOrganization: item.OrganizationCode ?? null,\n            InventoryItemId: item.InventoryItemId,\n            Quantity: actionQty,\n            SupplyAtDestination: item.TotalSupplyQuantity ?? 0,\n            DemandAtDestination: item.TotalDemandQuantity ?? 0,\n            RequiredQtyAtDestination: requiredQty,\n            AvailableForTransfer\n          })})`\n        }\n      ]\n    };\n  })\n  .filter(row => row !== null);\n\n// --- Step 2: Build MultiRecord Widget ---\nlet multiRecordWidget = null;\nif (multiRecordWidgetRows.length > 0) {\n  multiRecordWidget = {\n    title: \"Demand At Other Organizations\",\n    patternId: \"multiRecordWidget\",\n    description: \"Shows supply, demand, and required quantities per destination\",\n    properties: {\n      subtitle: \"Transfer Overview\",\n      cols: [\n        \"Source Organization\",\n        \"Destination Organization\",\n        \"Supply at Destination\",\n        \"Demand at Destination\",\n        \"Required Qty At Destination\",\n        \"Available Quantity For Transfer\",\n        \"Inventory Item ID\"\n      ],\n      rows: multiRecordWidgetRows\n    }\n  };\n}\n\n// --- Step 3: Build No Demand Card ---\nlet noDemandCard = null;\nif (!multiRecordWidget) {\n  noDemandCard = {\n    title: \"No Demand at Present\",\n    patternId: \"cardWidget\",\n    description: \"Currently there is no demand at other organizations\",\n    properties: {\n      subject: \"No Demand\",\n      summary: \"Currently there is no demand at other organizations\",\n      variant: null\n    }\n  };\n}\n\n// --- Step 4: Build Scrap Card with action ---\nlet scrapCard = null;\nif (scrapInput.Quantity && scrapInput.Quantity > 0) {\n  const locatorPart = scrapInput.LocatorName ? `and Locator ${scrapInput.LocatorName}` : \"\";\n  scrapCard = {\n    title: \"Scrap\",\n    patternId: \"cardWidget\",\n    description: `Suggesting Scrap ${scrapInput.Quantity} ${(PrimaryUOMName || PrimaryUOMCode || \"\")} of ${itemNumber} from subinventory ${scrapInput.Subinventory}${locatorPart}`,\n    properties: {\n      subject: \"Scrap\",\n      summary: `Scrap ${scrapInput.Quantity} ${(PrimaryUOMName || PrimaryUOMCode || \"\")} of ${itemNumber} from subinventory ${scrapInput.Subinventory}${locatorPart}`,\n      variant: null,\n      link: {\n        text: \"Scrap\",\n        action: `ora.Agent(${JSON.stringify({\n          command: \"Scrap\",\n          OrganizationId,\n          OrganizationCode,\n          InventoryItemId: pItemId,\n          ItemNumber: itemNumber,\n          Quantity: scrapInput.Quantity,\n          Subinventory: scrapInput.Subinventory,\n          LocatorId: scrapInput.LocatorId ?? null,\n          LocatorName: scrapInput.LocatorName ?? null,\n          TransactionTypeId: \"32\",\n          IsConsigned: \"3\"\n        })})`\n      }\n    }\n  };\n}\n\n// --- Step 5: Return all widgets/cards ---\nreturn {\n  multiRecordWidget,\n  noDemandCard,\n  scrapCard\n};"
          },
          "outcomes": {
            "success": "1774337739098"
          },
          "code": "PREPAREWIDGETSTODISPLAY",
