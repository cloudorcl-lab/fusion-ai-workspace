        {
          "metadata": {
            "name": "CombinePayloads",
            "returnType": "object",
            "sourceCode": "// Payloads with bucket labels\nconst restPayloads = [\n  { bucket: \"0 - 29\", data: $context.$nodes.GETLOCATIONSFOR029.$output.items ?? [] },\n  { bucket: \"30 - 59\", data: $context.$nodes.GETLOCATIONSFOR3059.$output.items ?? [] },\n  { bucket: \"60 - 89\", data: $context.$nodes.GETLOCATIONSFOR6089.$output.items ?? [] },\n  { bucket: \"90 - 119\", data: $context.$nodes.GETLOCATIONSFOR90119.$output.items ?? [] },\n  { bucket: \"120+\", data: $context.$nodes.GETLOCATIONSFOR120.$output.items ?? [] }\n];\n\n// Final flattened array\nconst combinedItems = [];\n\n// Loop through each bucket\nfor (let i = 0; i < restPayloads.length; i++) {\n  const bucketName = restPayloads[i].bucket;\n  const items = restPayloads[i].data;\n\n  // Skip if no data\n  if (!items || items.length === 0) {\n    continue;\n  }\n\n  // Loop through items\n  for (let j = 0; j < items.length; j++) {\n    combinedItems.push({\n      InventoryAge: bucketName,\n      ...items[j]\n    });\n  }\n}\n\n// Final output\nreturn {\n  items: combinedItems\n};"
          },
          "outcomes": {
            "success": "1774242848387"
          },
          "code": "COMBINEPAYLOADS",
          "convergenceTargetId": "1774241837970",
          "id": "1774263690032",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "PrepareMultiRecordWidget",
            "returnType": "object",
            "sourceCode": "const AgingBuckets = $context.$nodes.COMBINEPAYLOADS.$output.result.items ?? [];\nconst OrganizationId = $context.$variables.OrganizationId;\nconst OrganizationCode = $context.$variables.OrganizationCode ?? \"\";\nconst ItemNumber = $context.$variables.ItemNumber ?? \"\";\nconst PrimaryUOMName = $context.$variables.PrimaryUOM ?? \"\";\nconst PrimaryUOMCode = $context.$variables.PrimaryUOMCode ?? \"\";\n\n// Step 1: Sort AgingBuckets properly\nconst getOrder = (age) => {\n  if (!age) return 999;\n  if (age.includes(\"+\")) return parseInt(age, 10); // \"120+\" → 120\n  return parseInt(age.split(\"-\")[0], 10);         // \"30 - 59\" → 30\n};\n\nAgingBuckets.sort((a, b) => getOrder(a.InventoryAge) - getOrder(b.InventoryAge));\n\n// Step 2: Prepare rows with multiple actions per row\nconst multiRecordWidgetRows = [];\n\nfor (let i = 0; i < AgingBuckets.length; i++) {\n  const row = AgingBuckets[i];\n\n  multiRecordWidgetRows.push({\n    cells: [\n      row.InventoryAge ?? \"\",   // Inventory Age\n      row.onhandQuantity != null ? `${row.onhandQuantity} ${PrimaryUOMName || PrimaryUOMCode || \"\"}`.trim() : \"\", // Quantity\n      row.subinventory ?? \"\",   // Subinventory\n      row.locatorName ?? \"\"     // Locator\n    ],\n    // Single row, multiple clickable actions\n    action:\n      {\n        text: \"Get Suggestions\",\n        command: `ora.Agent(${JSON.stringify({\n          command: \"GetSuggestions\",\n          OrganizationId,\n          OrganizationCode,\n          InventoryItemId: row.itemId,\n          ItemNumber,\n          Quantity: row.onhandQuantity,\n          Subinventory: row.subinventory,\n          LocatorName: row.locatorName,\n          LocatorId: row.locatorId\n        })})`\n      }\n  });\n}\n\n// Step 3: Build widget\nlet multiRecordWidget = null;\n\nif (multiRecordWidgetRows.length > 0) {\n  multiRecordWidget = {\n    title: \"Inventory Aging Details for item \" + ItemNumber,\n    patternId: \"multiRecordWidget\",\n    description: \"Detailed view of inventory by aging bucket, subinventory, and locator\",\n    properties: {\n      subtitle: \"Inventory distribution across aging buckets\",\n      cols: [\n        \"Inventory Age (days)\",\n        \"Quantity\",\n        \"Subinventory\",\n        \"Locator\"\n      ],\n      rows: multiRecordWidgetRows\n    }\n  };\n}\n\nreturn { multiRecordWidget };"
          },
          "outcomes": {
            "success": "1774331962381"
          },
          "code": "PREPAREMULTIRECORDWIDGET",
          "convergenceTargetId": "1774241837970",
          "id": "1774242848387",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
