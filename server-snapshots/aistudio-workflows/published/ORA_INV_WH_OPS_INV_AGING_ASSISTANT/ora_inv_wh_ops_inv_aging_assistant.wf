      \"DestinationOrganization\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"InvOrgEnabledForProjectTracking\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"DestinationType\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"DestinationTypeCode\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"DestinationSubinventory\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"PersonId\": {\n            \"type\": \"number\"\n          },\n          \"Requester\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"RequesterId\": {\n            \"type\": \"number\"\n          },\n          \"RequisitioningBU\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"SetId\": {\n            \"type\": \"number\"\n          },\n          \"RequisitioningBUId\": {\n            \"type\": \"number\"\n          },\n          \"UserPreferenceId\": {\n            \"type\": \"number\"\n          },\n          \"RequisitionBUOptionsOrganizationId\": {\n            \"type\": \"number\"\n          },\n          \"ShopSearchTableViewEnabledFlag\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"CartTableViewEnabledFlag\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"MyRequisitionsHeaderViewEnabledFlag\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"WorkOrderId\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"WorkOrder\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"WorkOrderOperationId\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"WorkOrderOperationSequence\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"AllowDirectPurchasesForWorkOrdersFlag\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"requisitioningOptions\": {\n            \"type\": \"array\",\n            \"uniqueItems\": true,\n            \"minItems\": 1,\n            \"items\": {\n              \"required\": [\n                \"RequestedDeliveryDateOffset\"\n              ],\n              \"properties\": {\n                \"RequestedDeliveryDateOffset\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"href\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"name\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"kind\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ]\n}",
