                {
                  "metadata": {
                    "name": "PrepareOutputOfLoop",
                    "returnType": "object",
                    "sourceCode": "// Step 1: Get the array of items from REST call\nlet inputItems = $context.$nodes.LOOPORGS.GETDEMANDATOTHERORGS.$output.items ?? [];\n\n// Dynamically get OrganizationCode for the current loop index\nconst OrganizationCode = $context.$nodes.GETACCESSIBLEORGS.$output.items[\n  $context.$nodes.LOOPORGS.$currentItemIndex\n].OrganizationCode;\n\n// Step 2: Loop through each item and add to LoopOutput\nfor (let i = 0; i < inputItems.length; i++) {\n  const currentItem = inputItems[i];\n\n  if (!currentItem) continue; // Skip null/undefined\n\n  // Add current item with OrganizationCode\n  $context.$nodes.INITIALIZELOOPOUTPUT.$output.result.items.push({\n    ...currentItem,    // Keep all existing fields\n    OrganizationCode   // Add extra OrganizationCode field\n  });\n}\n\n// Step 3: Return updated LoopOutput\nreturn $context.$nodes.INITIALIZELOOPOUTPUT.$output.result;"
                  },
                  "outcomes": {
                    "success": "end_1774335189708"
                  },
                  "code": "PREPAREOUTPUTOFLOOP",
                  "id": "1774335857610",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE",
                  "convergenceTargetId": "1774460384660"
                }
              ],
