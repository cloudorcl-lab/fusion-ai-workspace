          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"description\": \"\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"status\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"shipmentNumber\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    }\n  },\n  \"required\": [\n    \"status\",\n    \"shipmentNumber\"\n  ]\n}",
