            "name": "DisplayUpdateMessage",
            "returnType": "string",
            "sourceCode": "let data = $context.$nodes.UPDATEQUEUE.$output;\nlet msg = (data && typeof data === \"object\") \n    ? `The Service Request has been successfully assigned to the ${$context.$nodes.BUILDUPDATESRPAYLOAD.$output.result?.Queue}`\n    : \"The requested operation failed. Please try again later and if the issue persists, contact your administrator.\"\n\nreturn msg;"
          },
          "outcomes": {
            "success": "1773380217660"
          },
          "code": "DISPLAYUPDATEMESSAGE",
          "id": "1773328265739",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "DisplayMessage",
            "returnType": "string",
            "sourceCode": "let data = $context.$nodes.ADDTOTEAM.$output;\nlet msg;\nif (data && typeof data === \"object\") {\n    // Success case\n    msg = `${$context.$nodes.BUILDADDTOTEAMPAYLOAD.$output.result.AgentName} has been added to the SR team`;\n} else {\n    // Error case\n    let errStr = $context.$nodes.ADDTOTEAM.$error?.$info;\n    if(errStr && errStr !=\"\")\n     {\n       let errObj; \n       errObj = JSON.parse(errStr);\n       errObj = errObj[\"o:errorDetails\"][0];\n       msg = errObj.detail;\n     }\n     else\n       msg = \"The requested operation failed. Please try again later and if the issue persists, contact your administrator.\"\n}\nreturn msg;"
          },
          "outcomes": {
            "success": "1773380217660"
          },
          "code": "DISPLAYMESSAGE",
          "id": "1773331152327",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
