        {
          "metadata": {
            "name": "calculateNoOfRows",
            "returnType": "number",
            "sourceCode": "const response = $context.$nodes.GETSTALLEDSRS.$output || {};\n\nlet ctx = {};\ntry {\n  ctx = JSON.parse($context.$app.$OraAppContext || \"{}\");\n} catch (e) {\n  ctx = {};\n}\n\nconst excludeSet = new Set(ctx.excludedSRs || []);\n\nconst totalRows = (response.Rows || [])\n  .filter(row => !excludeSet.has(row.Column0))\n  .length;\n\nreturn totalRows;"
