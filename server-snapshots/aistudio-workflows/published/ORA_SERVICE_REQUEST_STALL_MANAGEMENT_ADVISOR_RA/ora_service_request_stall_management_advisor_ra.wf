                {
                  "metadata": {
                    "name": "processTop5ResolvedSRs",
                    "returnType": "array",
                    "sourceCode": "var dataMap = $context.$variables.Top5ResolvedSRs || {};\n\nconst data = $context.$nodes.EXECUTETOP5RESOLVEDSRS.FETCHTOP5SIMILARRESOLVEDSRS.$output;\nlet result = dataMap;\n\nif (data && Array.isArray(data.items) && data.items.length > 0) {\n  const currentItem = $context.$nodes.EXECUTETOP5RESOLVEDSRS.$currentItem || {};\n  const refNo =\n    currentItem.ReferenceNumber ||\n    currentItem.SrNumber ||\n    currentItem.SR_NUMBER ||\n    currentItem.referenceNumber;\n\n  const similarResolved = data.items.map(it => ({\n    srNumber: it.SrNumber || null,\n    title: it.Title || null,\n    problemDescription: it.ProblemDescription || null,\n    queueName: it.QueueName || null,\n    queueId: it.QueueId || null,\n    assigneePersonName: it.AssigneePersonName || null,\n    assigneeResourceId: it.AssigneeResourceId || null\n  }));\n\n  result[refNo] = {\n    similarResolvedSRs: similarResolved,\n    offset: data.offset ?? 0,\n    count: data.count ?? similarResolved.length,\n    hasMore: data.hasMore ?? false,\n    limit: data.limit ?? similarResolved.length\n  };\n}\n\nreturn result;"
                  },
