          "code": "CALCULATEROWSTOSHOW",
          "convergenceTargetId": "1774272715183",
          "id": "1771476646379",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "condenseArray",
            "returnType": "array",
            "sourceCode": "const response = $context.$nodes.GETSTALLEDSRS.$output || {};\nconst ctx = JSON.parse($context.$app.$OraAppContext || \"{}\");\nconst excludeSet = new Set(ctx.excludedSRs || []);\nconst accounts = $context.$nodes.GETACCOUNTNAME.$output || {};\nconst accountTierMapBySRNumber = $context.$nodes.BUILDACCOUNTTIERMAPBYSRNUMBER.$output?.result || {};\n\n// Build SR -> account/contact map\nconst accountMap = new Map(\n  (accounts.Rows || []).map(r => [\n    r.Column0,\n    {\n      account: r.Column1 || null,\n      contact: r.Column2 || null\n    }\n  ])\n);\n\nlet result = (response.Rows || [])\n  .filter(row => !excludeSet.has(row.Column0))\n  .map(row => {\n    let problemDesc = row.Column2 ?? null;\n\n    if (problemDesc && problemDesc.length > 100) {\n      // problemDesc = problemDesc.substring(0, 100) + \"...\";\n    }\n\n    const accObj = accountMap.get(row.Column0) || {};\n    const accountName = accObj.account || accObj.contact || \"\";\n    const accountScoreObj = accountTierMapBySRNumber[row.Column0] || {};\n    const rawTier = accountScoreObj.accountScoringTier;\n\n    const normalizedTier =\n      rawTier == null || rawTier === \"\"\n        ? null\n        : String(rawTier).replace(/^Tier\\s*/i, \"\").trim();\n\n    const subtitle = accountName\n      ? (normalizedTier ? `${accountName} - Tier ${normalizedTier}` : accountName)\n      : \"\";\n\n    let timestamp = null;\n\n    if (row.Column15) {\n      const openDate = new Date(row.Column15);\n      const now = new Date();\n\n      const diffMs = now - openDate;\n      const diffHours = diffMs / (1000 * 60 * 60);\n      const diffDays = diffHours / 24;\n\n      if (diffHours < 1) {\n        timestamp = \"Just now\";\n      } else if (diffHours < 24) {\n        const hrs = Math.floor(diffHours);\n        timestamp = `${hrs} hour${hrs !== 1 ? \"s\" : \"\"} ago`;\n      } else {\n        const days = Math.floor(diffDays);\n        timestamp = `${days} day${days !== 1 ? \"s\" : \"\"} ago`;\n      }\n    }\n\n    let priority = null;\n    const severity = (row.Column4 || \"\").toLowerCase();\n\n    if (severity === \"high\") priority = \"alert\";\n    else if (severity === \"medium\") priority = \"warning\";\n    else if (severity === \"low\") priority = \"medium\";\n\n    return {\n      \"ReferenceNumber\": row.Column0,\n      \"SrID\": row.Column13,\n      \"Urgency Score\": row.Column8 != null ? Math.round(Number(row.Column8)) : null,\n      \"Title\": row.Column1 ?? null,\n      \"Problem Description\": problemDesc,\n      \"StatusType\": row.Column5 ?? null,\n      \"Queue\": row.Column9 ?? null,\n      \"Assigned\": row.Column10 ?? null,\n      \"PersonID\": row.Column14 ?? null,\n      \"categoryID\": row.Column11 ?? null,\n      \"productID\": row.Column12 ?? null,\n      \"Severity\": row.Column4 ?? null,\n      \"priority\": priority,\n      \"isCritical\": row.Column3 ?? null,\n      \"Subtitle\": subtitle,\n      \"accountPartyNumber\": accountScoreObj.accountPartyNumber ?? null,\n      \"accountScore\": accountScoreObj.accountScore ?? null,\n      \"timestamp\": timestamp,\n      \"Primary Concern Category\": null,\n      \"Justification\": null\n    };\n  })\n  .sort((a, b) => (b[\"Urgency Score\"] ?? -Infinity) - (a[\"Urgency Score\"] ?? -Infinity));\n\nif (result.length > 10) {\n  result = result.slice(0, 10);\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776785319274"
          },
          "code": "CONDENSEARRAY",
          "convergenceTargetId": "1774272715183",
          "id": "1771397192679",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
