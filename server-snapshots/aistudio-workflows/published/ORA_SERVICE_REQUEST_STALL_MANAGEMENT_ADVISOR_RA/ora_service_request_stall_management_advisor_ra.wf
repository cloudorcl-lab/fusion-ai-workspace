            "sourceCode": "let StalledSRs = $context.$nodes.GETSRS.$output;\nlet excludedSRs = $context.$nodes.GETEXCLUDEDSRS.$output;\n\nlet stalledList = StalledSRs.items.map(item => item.SrNumber);\nlet excludedList = excludedSRs.items.map(item => item.SrNumber);\n\nlet finalSRs = stalledList.filter(sr => !excludedList.includes(sr));\n\nlet inClause = finalSRs.length > 0\n  ? `('${finalSRs.join(\"','\")}')`\n  : `('-1')`;\n\nreturn `SrNumber in ${inClause}`;"
