        {
          "metadata": {
            "name": "buildAccountTierMapBySRNumber",
            "returnType": "object",
            "sourceCode": "const srItems = $context.$nodes.GETACCOUNTPARTYNUMBER.$output?.items || [];\nconst accountItems = $context.$nodes.FETCHALLACCOUNTSCORESTALL.$output?.items || [];\n\nconst accountMap = new Map(\n  accountItems.map(item => [\n    item.PartyNumber,\n    {\n      accountPartyNumber: item.PartyNumber ?? null,\n      accountScore: item.AccountScore ?? null,\n      accountScoringTier: item.AccountScoringTier ?? null\n    }\n  ])\n);\n\nconst tierMap = {};\n\nsrItems.forEach(item => {\n  const srNumber = item.SrNumber;\n  if (!srNumber) return;\n\n  tierMap[srNumber] = accountMap.get(item.AccountPartyNumber) || {\n    accountPartyNumber: item.AccountPartyNumber ?? null,\n    accountScore: null,\n    accountScoringTier: null\n  };\n});\n\nreturn tierMap;"
          },
