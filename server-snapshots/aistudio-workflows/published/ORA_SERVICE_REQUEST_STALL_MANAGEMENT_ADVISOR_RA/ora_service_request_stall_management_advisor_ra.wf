        {
          "metadata": {
            "name": "getAccountNameQuery",
            "returnType": "string",
            "sourceCode": "let StalledSRs = $context.$nodes.GETSRS.$output;\nlet excludedSRs = $context.$nodes.GETEXCLUDEDSRS.$output;\n\n// Step 1: Extract SR Numbers\nlet stalledList = StalledSRs.items.map(item => item.SrNumber);\nlet excludedList = excludedSRs.items.map(item => item.SrNumber);\n\n// Step 2: Remove excluded SRs\nlet finalSRs = stalledList.filter(sr => !excludedList.includes(sr));\n\n// Step 3: Handle empty case\nlet inClause = finalSRs.length > 0 \n  ? `IN ('${finalSRs.join(\"','\")}')`\n  : `IN ('-1')`; // safe fallback\n\n\n// Step 4: Build SQL\nlet sqlQuery = `\nSELECT \n  \"Service - CRM Service Requests Real Time\".\"Service Request\".\"Service Request Number\" AS SR_NUMBER,\n  \"Service - CRM Service Requests Real Time\".\"Customer\".\"Corporate Account Name\" AS AccountName,\n  \"Service - CRM Service Requests Real Time\".\"Contact\".\"First Name\" || ' ' || \n  \"Service - CRM Service Requests Real Time\".\"Contact\".\"Last Name\" AS CONTACT_NAME\nFROM \"Service - CRM Service Requests Real Time\"\nWHERE \"Service - CRM Service Requests Real Time\".\"Service Request\".\"Service Request Number\" ${inClause}\n`;\n\n// Step 5: Build full payload\nlet payload = {\n  executionOptions: {\n    async: \"false\",\n    presentationInfo: \"false\",\n    refresh: \"false\",\n    maxRowsPerPage: 40\n  },\n  outputFormat: \"SAWRowsetSchemaAndData\",\n  sessionId: \"1\",\n  sqlQuery: sqlQuery\n};\n\n// Step 6: Return as string\nreturn JSON.stringify(payload);"
          },
