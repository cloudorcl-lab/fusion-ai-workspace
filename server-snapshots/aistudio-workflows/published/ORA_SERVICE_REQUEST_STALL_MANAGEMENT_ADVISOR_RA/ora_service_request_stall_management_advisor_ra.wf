          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "getSRIds",
            "returnType": "string",
            "sourceCode": "let StalledSRs = $context.$nodes.GETSRS.$output;\nlet excludedSRs = $context.$nodes.GETEXCLUDEDSRS.$output;\n\n// Step 1: Extract SR Numbers\nlet stalledList = StalledSRs.items.map(item => item.SrNumber);\nlet excludedList = excludedSRs.items.map(item => item.SrNumber);\n\n// Step 2: Remove excluded SRs\nlet finalSRs = stalledList.filter(sr => !excludedList.includes(sr));\n\n// Step 3: Handle empty case\nlet inClause = finalSRs.length > 0 ? `IN ('${finalSRs.join(\"','\")}')`: `IN ('-1')`; // safe fallback\n\n// Step 4: Build SQL\nlet sqlQuery = `\nSELECT \n  \"Service - CRM Service Requests Real Time\".\"Service Request\".\"Service Request Number\" AS SR_NUMBER,\n  \"Service - CRM Service Requests Real Time\".\"Service Request\".\"Title\" AS TITLE,\n  \"Service - CRM Service Requests Real Time\".\"Service Request\".\"Problem Description\" AS PROBLEM_DESCRIPTION,\n  \"Service - CRM Service Requests Real Time\".\"Service Request\".\"Critical Flag\" AS CRITICAL_FLAG,\n  \"Service - CRM Service Requests Real Time\".\"Service Request\".\"Severity\" AS SEVERITY,\n  \"Service - CRM Service Requests Real Time\".\"Service Request\".\"Status\" AS STATUS_TYPE,\n  \"Service - CRM Service Requests Real Time\".\"Service Request\".\"Creation Date\" AS CREATION_DATE,\n  \"Service - CRM Service Requests Real Time\".\"Service Request\".\"Last Update Date\" AS LAST_UPDATE_DATE,\n  COALESCE(\"Service Request Lifecycle Facts\".\"Total Duration as In Progress SR (Days)\",0)*0.2 + \n  COALESCE(\"Service Request Lifecycle Facts\".\"Total Duration as Waiting SR (Days)\",0)*0.4 + \n  TIMESTAMPDIFF(SQL_TSI_DAY,\n    \"Service - CRM Service Requests Real Time\".\"Service Request\".\"Last Update Date\",\n    CURRENT_DATE\n  )*0.4 AS STAGNATION_SCORE,\n  \"Service - CRM Service Requests Real Time\".\"Service Request Queue\".\"Queue Name\" AS QUEUE,\n  \"Service - CRM Service Requests Real Time\".\"Employee\".\"Employee Name\" AS ASSIGNEE,\n  \"Service - CRM Service Requests Real Time\".\"Service Request\".\"Category Id\" AS CATEGORY_ID,\n  \"Service - CRM Service Requests Real Time\".\"Service Request\".\"Inventory Item Id\" AS PRODUCT_ID,\n  \"Service - CRM Service Requests Real Time\".\"Service Request\".\"Service Request ID\" AS SR_ID,\n  \"Service - CRM Service Requests Real Time\".\"Employee\".\"Person Id\" AS PersonID,\n  \"Service - CRM Service Requests Real Time\".\"Service Request\".\"Open Date\" AS OpenDate\n  \nFROM \"Service - CRM Service Request Lifecycle\"\nWHERE \"Service - CRM Service Requests Real Time\".\"Service Request\".\"Service Request Number\" ${inClause}\nORDER BY STAGNATION_SCORE DESC\nFETCH FIRST 40 ROWS ONLY\n`;\n\n// Step 5: Build full payload\nlet payload = {\n  executionOptions: {\n    async: \"false\",\n    presentationInfo: \"false\",\n    refresh: \"false\",\n    maxRowsPerPage: 40\n  },\n  outputFormat: \"SAWRowsetSchemaAndData\",\n  sessionId: \"1\",\n  sqlQuery: sqlQuery\n};\n\n// Step 6: Return as string\nreturn JSON.stringify(payload);"
          },
          "outcomes": {
            "success": "1771389220387"
          },
          "code": "GETSRIDS",
