        {
          "metadata": {
            "name": "preparePriortizeSRsInput",
            "returnType": "array",
            "sourceCode": "const stalledSrs = Array.isArray($context.$nodes.CONDENSEARRAY.$output?.result)\n  ? $context.$nodes.CONDENSEARRAY.$output.result\n  : [];\n\nreturn stalledSrs.map(item => ({\n  \"ReferenceNumber\": item.ReferenceNumber ?? null,\n  \"Stagnation Score\": item[\"Urgency Score\"] ?? null,\n  \"Critical Flag\": item.isCritical ?? null,\n  \"Severity\": item.Severity ?? null,\n  \"StatusType\": item.StatusType ?? null,\n  \"Title\": item.Title ?? null,\n  \"Problem Description\": item[\"Problem Description\"] ?? null,\n  \"Subtitle\": item.Subtitle ?? \"\",\n  \"accountScore\": item.accountScore ?? null\n}));"
          },
          "outcomes": {
