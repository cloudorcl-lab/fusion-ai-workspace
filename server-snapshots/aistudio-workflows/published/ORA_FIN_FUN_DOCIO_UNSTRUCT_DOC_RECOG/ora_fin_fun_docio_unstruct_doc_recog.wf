        {
          "metadata": {
            "name": "Validate Recognition Response",
            "returnType": "object",
            "sourceCode": "// TRANSFORMATION SPEC EXTRACTOR (WITH NODE STATUS HANDLING)\nvar node = $context.$nodes.FIN_FUN_BOF_RECOGNIZE_DOCUMENT;\nvar nodeStatus = node ? node.$status : null;\nvar boResponse = node ? node.$output : null;\nvar result = null;\n\n// 1. NODE EXECUTION FAILURE\nif (nodeStatus === \"failure\" || nodeStatus === \"FAILURE\") {\n    var errorInfo = node.$error;\n    var errorMessage = \"Unstructured Document Recognition execution failed.\";\n    var errorCode = \"EXECUTION_ERROR\";\n    if (errorInfo && typeof errorInfo === \"object\") {\n        if (typeof errorInfo.$info === \"string\" && errorInfo.$info.trim()) {\n            errorMessage = errorInfo.$info;\n        } else if (typeof errorInfo.message === \"string\" && errorInfo.message.trim()) {\n            errorMessage = errorInfo.message;\n        } else if (typeof errorInfo.error === \"string\" && errorInfo.error.trim()) {\n            errorMessage = errorInfo.error;\n        }\n        if (errorInfo.code) {\n            errorCode = errorInfo.code;\n        }\n    }\n    result = {\n        status: \"ERROR\",\n        error: {\n            stage: \"Unstructured Document Recognition\",\n            code: errorCode,\n            message: errorMessage\n        }\n    };\n}\n// 2. MALFORMED OR MISSING RESPONSE\nelse if (!boResponse || typeof boResponse !== \"object\") {\n    result = {\n        status: \"ERROR\",\n        error: {\n            stage: \"Extract Transformation\",\n            code: \"MALFORMED_TOOL_RESPONSE\",\n            message: \"Business Object response is missing or invalid.\"\n        }\n    };\n}\n// 3. FAILURE STATUS FROM BO RESPONSE\nelse if (boResponse.status && boResponse.status !== \"SUCCESS\") {\n    result = {\n        status: \"ERROR\",\n        error: {\n            stage: \"Unstructured Document Recognition\",\n            code: \"EXECUTION_ERROR\",\n            message: \"Unstructured document recognition failed.\"\n        }\n    };\n}\n// 4. MISSING OR BLANK CONTENT\nelse if (!boResponse.content || String(boResponse.content).trim() === \"\") {\n    result = {\n        status: \"ERROR\",\n        error: {\n            stage: \"Extract Transformation\",\n            code: \"MISSING_TRANSFORMATION\",\n            message: \"No valid transformation found in response.\"\n        }\n    };\n}\n// 5. SUCCESS  PASS THROUGH AS-IS\nelse {\n    result = boResponse;\n}\n\nresult;"
          },
          "outcomes": {
            "success": "1768412408752"
          },
          "code": "FIN_FUN_CODE_VALIDATE_RECOGNITION",
          "id": "1768412204211",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
