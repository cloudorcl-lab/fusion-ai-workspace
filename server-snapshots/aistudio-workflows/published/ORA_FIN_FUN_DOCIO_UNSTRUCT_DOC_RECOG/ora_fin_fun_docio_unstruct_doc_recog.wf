{
  "workflowId": "300000326919171",
  "workflowCode": "ORA_FIN_FUN_DOCIO_UNSTRUCT_DOC_RECOG",
  "name": "Doc IO Unstructured Document Recognition",
  "description": "Processes unstructured documents such as scanned images or PDFs in multiple languages. Organizes the extracted information into structured data aligned with Oracle application schemas, delivering Oracle compatible JSON output for seamless ingestion by downstream processes.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
