            "name": "Return Validation Error",
            "returnType": "object",
            "sourceCode": "// ===============================\n// PREPARE AGENT EXECUTION ERROR\n// ===============================\n\n// Read validator output\nvar validationResult = (\n    $context.$nodes.FIN_FUN_CODE_VALIDATE_PAYLOAD &&\n    $context.$nodes.FIN_FUN_CODE_VALIDATE_PAYLOAD.$output &&\n    $context.$nodes.FIN_FUN_CODE_VALIDATE_PAYLOAD.$output.result\n)\n    ? $context.$nodes.FIN_FUN_CODE_VALIDATE_PAYLOAD.$output.result\n    : null;\n\n// Read configurable error message\nvar agentErrorMessage = (\n    $context.$variables.agentErrorMessage &&\n    String($context.$variables.agentErrorMessage).trim() !== \"\"\n)\n    ? String($context.$variables.agentErrorMessage).trim()\n    : \"Agent execution failed.\";\n\n// Fallback generic error if validator returned nothing\nif (!validationResult) {\n    validationResult = {\n        status: \"ERROR\",\n        error: {\n            stage: \"Agent Execution\",\n            code: \"AGENT_EXECUTION_FAILED\",\n            message: agentErrorMessage\n        }\n    };\n}\n\n// Return error response\nvalidationResult;"
