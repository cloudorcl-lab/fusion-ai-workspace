          "code": "FIN_FUN_IF_CONDITION_RECOGNITION_SUCCESS",
          "convergenceTargetId": "end",
          "id": "1768412408752",
          "inputs": [
            {
              "id": "1768412408758_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.FIN_FUN_CODE_VALIDATE_RECOGNITION.$output.result.status == \"SUCCESS\" && $context.$nodes.FIN_FUN_CODE_VALIDATE_RECOGNITION.$output.result.content != null}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Return Structured Data",
            "returnType": "object",
            "sourceCode": "const successResult = $context.$variables.recognitionResponse;\n\n// Parse outer JSON if it's a string\nconst data = typeof successResult === 'string' ? JSON.parse(successResult) : successResult;\n\n// Parse inner content if it's a string form of JSON\nif (typeof data.content === 'string') {\n   const innerContent = data.content.trim();\n   if ((innerContent.startsWith(\"{\") && innerContent.endsWith(\"}\")) || (innerContent.startsWith(\"[{\") && innerContent.endsWith(\"}]\"))) {\n     data.content = JSON.parse(data.content);\n   }\n}\n\n// Return parsed data\nreturn data;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "FIN_FUN_CODE_RETURN_STRUCTURED_DATA",
          "id": "1768412537528",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1768412816586",
            "name": "Wait For Retry",
            "returnType": "object",
            "sourceCode": "// Record start timestamp\nvar startTime = new Date().toISOString();\n\n// ---  second delay (blocking) ---\nvar delayMs = 30000; // 30 seconds\nvar start = new Date().getTime();\nwhile (new Date().getTime() - start < delayMs) {\n  // busy wait\n}\n\n// Record end timestamp\nvar endTime = new Date().toISOString();\n\n// Build result object\nvar result = {\n  status: \"OK\",\n  startTime: startTime,\n  endTime: endTime,\n  message: \"30 second delay completed\"\n};\n\n\nresult;"
          },
          "outcomes": {
            "success": "1768412816586"
          },
          "code": "FIN_FUN_CODE_WAIT_FOR_RETRY",
          "id": "1768412690749",
