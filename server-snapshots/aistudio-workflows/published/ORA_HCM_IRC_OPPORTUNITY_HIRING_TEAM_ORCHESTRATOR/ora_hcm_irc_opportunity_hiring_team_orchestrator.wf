          "metadata": {
            "name": "Parse App Context Data",
            "returnType": "object",
            "sourceCode": "var appContext = $context.$app.$OraAppContext;\nvar contextObj = {};\nif (appContext && typeof appContext === \"string\") {\n  try { contextObj = JSON.parse(appContext); } catch (e) { contextObj = {}; }\n} else if (appContext && typeof appContext === \"object\") {\n  contextObj = appContext;\n}\nif (!contextObj || typeof contextObj !== \"object\") { contextObj = {}; }\nreturn contextObj;"
          },
          "outcomes": {
