        {
          "metadata": {
            "name": "GetContactsInfo",
            "returnType": "object",
            "sourceCode": "const rawString = $context.$nodes.GET_OPPORTUNITY_DETAILS.$output.output;\nlet data = {};\nif($context.$variables.OpportunityType == 'Job' ) {\ndata= JSON.parse(rawString).result.contacts;\n} else {\nconst input = JSON.parse(rawString).result;\ndata = input.teamMembers.items.map(tm => {\n    if (tm.TeamMemberName === input.GigManagerName) {\n      return {\n        ...tm,\n        TeamMemberName: input.GigManagerName,\n        TeamMemberPhoneNumber: input.GigManagerPhoneNumber,\n        TeamMemberEmailAddress: input.GigManagerEmail,\n        Position: input.GigManagerPosition,\nGigManager: true\n      };\n    } else {\n      // For other entries, add Position as blank\n      return {\n        ...tm,\n        Position: \"\",\nGigManager: false\n      };\n    }\n  });\n}\nreturn data;"
          },
          "outcomes": {
            "success": "1767954789757"
          },
          "code": "GETCONTACTSINFO",
          "id": "1767963161734",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
