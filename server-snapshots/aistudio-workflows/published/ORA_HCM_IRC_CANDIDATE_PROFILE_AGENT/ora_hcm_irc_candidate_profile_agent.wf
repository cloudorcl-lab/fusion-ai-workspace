                {
                  "metadata": {
                    "name": "Identify content type label",
                    "returnType": "string",
                    "sourceCode": "const ContentTypeId = Number( $context.$nodes.RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE.$currentItem.contentTypeId);\n\nlet typeLabel = \"INVALID\";\nif(ContentTypeId == 103){\n    typeLabel = \"Licenses and Certifications\";\n}else if(ContentTypeId == 106){\n    typeLabel = \"Education Degree\";\n}\nelse if(ContentTypeId == 109){\n    typeLabel = \"Language\"\n}\n\nreturn typeLabel;"
                  },
                  "outcomes": {
                    "success": "1768815719135"
                  },
                  "code": "IDENTIFY_CONTENT_TYPE_LABEL",
                  "id": "1768815647406",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "Find terms associated with the value"
                  },
                  "outcomes": {
                    "success": "1768815871257"
                  },
                  "code": "FIND_TERMS_ASSOCIATED_WITH_THE_VALUE",
                  "id": "1768815719135",
                  "inputs": [
                    {
                      "id": "1768815719137_1",
                      "name": "prompt",
                      "type": "string",
                      "value": "You are an AI agent that is capable of extracting terms associated with each string in a given input array of strings.\n\nINPUT:\nContentType : {{$context.$nodes.RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE.IDENTIFY_CONTENT_TYPE_LABEL.$output.result}}\nInputStrings : {{$context.$nodes.RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE.UPDATE_MATCHING_RECORDS_FROM_DIRECT_VALUE_MAPPING.$output.result.unresolved}}\n\nINSTRUCTIONS :\n  * For each string in Input Strings, follow below steps to find terms associated\n    - CASE 1: If ContentType is License and certification\n      # Given string is the name of a certification or license. List out all relevant synonyms, alternate names, certification codes, or commonly used abbreviations for this certification. For each synonym or alternate name, dont need to provide explaination or more details. Just the name is enough.\n      # Once all the synonyms are identified, extract terms from each of the synonyms and original text itself. Exclude articles (The , a, an ), conjunctions and prepositions. Only relavant terms are needed.\n        Example: \"AWS Certified Cloud Practitioner\" => AWS,Cloud,Practitioner,Amazon,Web,Services\n      # Combine all the terms and create an array of terms.\n      # Exclude these terms - \"Certification\",\"Certified\",\"Certificate\"\n      \n    - CASE 2: If ContentType is Education Degree\n      # Given string is the name of an education degree. List out all relevant synonyms, alternate names or commonly used abbreviations for this education. For each synonym or alternate name, dont need to provide explaination or more details. Just the name is enough.\n      # Once all the synonyms are identified, extract terms from each of the synonyms and original text itself. Exclude articles (The , a, an ), conjunctions and prepositions. Only relavant terms are needed.\n        Example:  \"Master of Arts\" => Masters,Master,Arts,Art\n      # Combine all the terms and create an array of terms.\n      \n    - - CASE 1: If ContentType is Language\n      # Given string is the name of a language. List out all relevant synonyms, alternate names, or commonly used abbreviations for this language. For each synonym or alternate name, dont need to provide explaination or more details. Just the name is enough.\n        Example \"German\" => German,Deutsch\n      # Combine all the synonyms and create an array of terms.\n      \n    \n    * Each term should be a strictly single word.\n    * Filter duplicates from the final array of terms and limit to maximum 6 records in array of terms.\n\n  * Return in below JSON Array format \n  [\n      {\n          \"key\": \"<string1>\", \"value\": []\n      },\n      {\n        \"key\": \"<string2>\", \"value\": []\n    }\n  ]\n  where key is each string and value is array of terms associated with each strings."
                    }
                  ],
                  "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n            \"type\": \"array\",\n            \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n                    \"key\": {\n                        \"type\":\"string\"\n                    },\n                    \"value\": {\n                        \"type\": \"array\",\n                            \"items\": {\n                            \"type\": \"string\"\n                        }\n                    }\n                }\n            }\n        }",
                  "type": "LLM"
                },
                {
                  "metadata": {
                    "name": "Prepare IN cluse for terms",
                    "returnType": "array",
                    "sourceCode": "// gets in clause for each content item string for example \"AWS certified solution architect\" : lower(NAME) like '%amazon%' OR lower(name) like '%web%' OR lower(NAME) like %services% OR lower(NAEM)  like '%aws%\n\nconst ContentTypeId = Number( $context.$nodes.RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE.$currentItem.contentTypeId);\n\nconst termsArr = $context.$nodes.RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE.FIND_TERMS_ASSOCIATED_WITH_THE_VALUE.$output;\n\n// remove common terms such as certified,certificate ..etc which might appear in most certifiction names and hence not useful in filtering records\n// This was already mentioned in LLM prompt, but still for some certifications like OCP, it gives \"Certified\" in terms array\n\nif (ContentTypeId == 103) {\n    termsArr.forEach(item => {\n        item.value = item.value.filter(val => ['certification','certified','certificate','licence'].indexOf(val.toLowerCase()) == -1);\n        \n    });\n}\n\nconst terms = termsArr.reduce((cumulative, eachItem) => { { cumulative[eachItem.key] = eachItem.value; return cumulative } }, {});\n\n\nconst ret = Object.keys(terms).map(key=>{\n    const termsArr = terms[key];\n    const  likeClause = termsArr.map((val)=> {\n        return  `lower(Name) like '%25${val.toLowerCase()}%25' `;\n    });\n    return{\n        key:key,\n        likeClause:likeClause.join('OR ')\n    }\n\n});\nreturn ret;"
                  },
                  "outcomes": {
                    "success": "1768815943453"
                  },
                  "code": "PREPARE_IN_CLUSE_FOR_TERMS",
                  "id": "1768815871257",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
