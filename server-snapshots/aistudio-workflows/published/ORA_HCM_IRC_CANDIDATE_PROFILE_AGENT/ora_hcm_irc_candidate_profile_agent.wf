          },
          "outcomes": {
            "success": "1768452946289"
          },
          "code": "RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE",
          "convergenceTargetId": "1769706191519",
          "id": "1768401032126",
          "inputs": [
            {
              "id": "1768401032128_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_MATCHING_CONTENT_TYPE_AND_SECTION_RECORD.$output.result}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "Associate content item id to records",
            "returnType": "object",
            "sourceCode": "//ASSOCIATE_CONTENT_ITEM_ID_TO_RECORDS\nlet education= $context.$variables.education;\nlet  certifications = $context.$variables.certifications;\nlet languages = $context.$variables.languages;\n\nconst  forEachOutput =  $context.$nodes.RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE.$output;\nconst metadataList = $context.$nodes.EXTRACT_MATCHING_CONTENT_TYPE_AND_SECTION_RECORD.$output.result ;\n\n\nforEachOutput.map(output=>JSON.parse(output)).forEach(output =>{\n\n    const record = output.result;\n    const resolvedEntries = record.resolved;\n    const unresolvedEntries = record.unresolved;\n    const resolvedWithLLMMapping = record.resolvedValueMap||{};\n    const metadata = metadataList.find(item=>item.contentTypeId == record.contentTypeId);\n    if(record.contentTypeId == \"103\"){\n        let mapped =[];\n        if(metadata.valueSetId){\n            mapped = certifications.map(item=>{\n                if(unresolvedEntries.indexOf(item.Certification) != -1){\n                    item.ContentItemId=-1;\n                }else{\n                    item.ContentItemId=resolvedEntries[item.Certification];\n                    item.PersistedValue = resolvedWithLLMMapping[item.Certification];\n                }\n                return item;\n            });\n        }else{\n            mapped = certifications.map(item=>{ \n                item.TextValueToPersist = item.Certification;\n                return item;\n            });\n        }\n        certifications = mapped; \n    }else if(record.contentTypeId == \"106\"){\n        let mapped =[];\n        if(metadata.valueSetId){\n            mapped = education.map(item=>{\n                if(unresolvedEntries.indexOf(item.Degree) != -1){\n                    item.ContentItemId=-1;\n                }else{\n                    item.ContentItemId=resolvedEntries[item.Degree];\n                    item.PersistedValue = resolvedWithLLMMapping[item.Degree];\n                    const resolvedSchools = record.resolvedEducationEstablishments;\n                    if(resolvedSchools &&  item.School && resolvedSchools[item.School]){\n                        const establishmentId = resolvedSchools[item.School];\n                        item.EstablishmentId = establishmentId;\n                    }\n                }\n                return item;\n            });\n        }else{\n             mapped = education.map(item=>{ \n                item.TextValueToPersist = item.Degree;\n                return item;\n            });\n        }\n        education = mapped;\n    }else if(record.contentTypeId == \"109\"){\n        let mapped =[];\n        if(metadata.valueSetId){\n             mapped = languages.map(item=>{\n                if(unresolvedEntries.indexOf(item.Language) != -1){\n                    item.ContentItemId=-1;\n                }else{\n                    item.ContentItemId=resolvedEntries[item.Language];\n                    item.PersistedValue = resolvedWithLLMMapping[item.Language];\n                }\n                 item.speakingLevelModelId = metadata.speakingLevelModelId;\n                 item.writingLevelModelId = metadata.writingLevelModelId;\n                 item.readingLevelModelId = metadata.readingLevelModelId;\n                return item;\n            });\n        }else{\n            mapped = languages.map(item=>{ \n                item.TextValueToPersist = item.Language;\n                return item;\n            });\n        }\n        languages = mapped;\n    }\n});\n\nreturn {education,certifications,languages};"
          },
          "outcomes": {
            "success": "1768452998044"
          },
          "code": "ASSOCIATE_CONTENT_ITEM_ID_TO_RECORDS",
          "convergenceTargetId": "1769706191519",
          "id": "1768452946289",
          "inputs": [],
