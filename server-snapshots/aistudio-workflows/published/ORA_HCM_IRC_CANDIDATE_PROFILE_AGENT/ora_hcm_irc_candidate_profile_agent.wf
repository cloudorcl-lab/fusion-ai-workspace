        {
          "metadata": {
            "name": "find country code"
          },
          "outcomes": {
            "success": "1773651759420"
          },
          "code": "FIND_PHONE_COUNTRY_CODE_TERRITORY_CODE",
          "id": "1773995534172",
          "inputs": [
            {
              "id": "1773995534176_1",
              "name": "prompt",
              "type": "string",
              "value": "Your job is to identify ISO 2 letter country code (Alpha-2) for a person with given details. The input is in json format  containing  person address and phone number details.\n\nINPUT :\nPersonDetails : {{$context.$triggers.REST.$input.candidateProfile.candidateBasicInfo}}\nPhoneCountryCode : {{$context.$triggers.REST.$input.candidateProfile.candidateBasicInfo.CountryCode}}\n\nINSTRUCTIONS :\n1. Derive ISO country code :\n  * Use the person's address attributes (City,StateOrProvince,PostalCode and Country)  and PhoneCountryCode input  to identify the 2   letter country code. \n  * If PhoneCountryCode is present, then derive the ISO country code using PhoneCountryCode.\n       * If PhoneCountryCode  is not present then use  the Country to derive ISO country code.\n       * If Neither Country   nor PhoneCountryCode present then  rely on City,StateOrProvince and PostalCode attributes to derive ISO country code.\n  * If multiple matching countries are found  , use the first country for deriving output.\n  * Return ONLY the  ISO country code. No need to include any additional  information such as reason .  Just  ISO country code  is enough.\n2.Derive PhoneCountryCode \n  * If the PhoneCountryCode is empty, then derive it using  person's address attributes (City,StateOrProvince,PostalCode and Country) \n      - If Country is present  , derive the PhoneCountryCode using country , else try to figure out using City,StateOrProvince or PostalCode \n * If the PhoneCountryCode input is not empty, then use the same for output PhoneCountryCode as well \n * Remove any \"+\" character in PhoneCountryCode. Only the number is needed. For example \"+91\" => \"91\", \"+1\"=> 1\n\nOUTPUT:\nUsing the above steps  find out the ISO country code  (Alpha-2) and PhoneCountryCode  and return in below JSON format\n{\n PhoneCountryCode:<PhoneCountryCode derived>,\n ISOCountryCode:< ISO country code   derived>\n}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"ISOCountryCode\": {\n            \"type\": \"string\"\n        },\n        \"PhoneCountryCode\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
