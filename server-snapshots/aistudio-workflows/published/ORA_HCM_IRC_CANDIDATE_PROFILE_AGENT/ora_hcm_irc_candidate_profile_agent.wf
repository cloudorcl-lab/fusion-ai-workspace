                    "returnType": "object",
                    "sourceCode": "let profileResponse = [];\nlet result = {};\nconst outputArr = $context?.$nodes?.SAVE_LANGUAGE_ITEMS?.$output;\n\nif (Array.isArray(outputArr)) {\n    profileResponse = outputArr.flatMap(item => {\n        try {\n            return [JSON.parse(item)];\n        } catch (e) {\n            return [];\n        }\n    });\n}\nconst successCount = profileResponse?.filter(output => output?.result != null).length || 0;\nlet status = null;\n\nif ($context.$variables.languages != null && $context.$variables.languages.length > 0) {\n    const totalCount = $context.$variables.languages.length\n    if (successCount == 0) {\n        status = \"FAILURE\";\n    } else if (successCount == totalCount) {\n        status = \"SUCCESS\";\n    } else {\n        status = \"PARTIAL_SUCCESS\";\n    }\n}\n\nresult.ProfileLanguageStatus = status;\nresult.ProfileResponse = profileResponse;\n\nreturn result;"
