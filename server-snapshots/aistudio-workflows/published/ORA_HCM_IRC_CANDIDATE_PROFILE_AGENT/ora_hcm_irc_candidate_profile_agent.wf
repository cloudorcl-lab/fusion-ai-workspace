                  "inputs": [
                    {
                      "id": "1768401253057_1",
                      "name": "contentTypeId",
                      "type": "string",
                      "value": "{{$context.$nodes.RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE.$currentItem.contentTypeId}}"
                    },
                    {
