        {
          "metadata": {
            "name": "Pre process Input Data",
            "returnType": "object",
            "sourceCode": "// add missing key attributes from payload\nlet  education = $context.$triggers.REST.$input.candidateProfile.profileEducationItemArray;\nlet certifications = $context.$triggers.REST.$input.candidateProfile.profileCertificationItemArray;\nlet languages = $context.$triggers.REST.$input.candidateProfile.profileLanguageItemArray;\nlet skills = $context.$triggers.REST.$input.candidateProfile.profileSkillItemArray;\nlet workExp = $context.$triggers.REST.$input.candidateProfile.profileWorkHistoryItemArray;\n\neducation?.forEach( (edu) =>\n     { \n        edu.Degree = edu.LeadingAttributeValue||edu.Degree  ;\n        edu.School = edu.Establishment||edu.School ;\n    } \n);\ncertifications?.forEach( (cert) => \n    { cert.Certification = cert.LeadingAttributeValue||cert.Certification  }\n);\nlanguages?.forEach( (lang) => \n    { lang.Language = lang.LeadingAttributeValue||lang.Language  }\n);\nworkExp?.forEach( (exp) => \n    { exp.Employer = exp.LeadingAttributeValue|| exp.Employer }\n);\nskills = skills?.map(skill=>skill.LeadingAttributeValue||skill);\n\nreturn {education:education||[],certifications:certifications||[],languages:languages||[],skills:skills||[],workExp:workExp||[]};"
          },
          "outcomes": {
            "success": "1767094878466"
          },
          "code": "PRE_PROCESS_INPUT_DATA",
          "id": "1769597002654",
          "inputs": [],
