        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_RECRUITING_RECRUITINGCANDIDATEPROFILECONTENTS",
            "functionName": "getall_profileTypeSectionsLOV",
            "name": "Fetch  configured profile contents"
          },
          "outcomes": {
            "success": "1767616881296"
          },
          "code": "FETCH_CONFIGURED_PROFILE_CONTENTS",
          "convergenceTargetId": "1769684253059",
          "id": "1767109135890",
          "inputs": [
            {
              "id": "1767109210217_1",
              "name": "q",
              "type": "string",
              "value": "ContentTypeId%20IN%20%28103%2C106%2C109%2C117%2C129%2C134%29%20and%20ProfileTypeId%3D1%20and%20SubscriberCode%3D%27IRC%27"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"SectionId\": {\n            \"type\": \"string\"\n        },\n        \"ContentTypeId\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Format Content Sections",
            "returnType": "array",
            "sourceCode": "let contentSections = {};\nlet contentItems = [];\n\n$context.$nodes.FETCH_CONFIGURED_PROFILE_CONTENTS.$output.items.forEach(item => {\n        \n        if (!contentSections.educationExists && item.ContentTypeId === \"106\") {\n            contentSections.educationExists = true;\n            contentItems.push(item);\n        }\n        \n        if (!contentSections.licenseExists && item.ContentTypeId === \"103\") {\n            contentSections.licenseExists = true;\n            contentItems.push(item);\n        }\n        \n        if (!contentSections.languageExists && item.ContentTypeId === \"109\") {\n            contentSections.languageExists = true;\n            contentItems.push(item);\n        }\n        \n        if (!contentSections.workReqExists && item.ContentTypeId === \"117\") {\n            contentSections.workReqExists = true;\n            contentItems.push(item);\n        }\n        \n        if (!contentSections.prevEmploymentExists && item.ContentTypeId === \"129\") {\n            contentSections.prevEmploymentExists = true;\n            contentItems.push(item);\n        }\n        \n        if (!contentSections.skillExists && item.ContentTypeId === \"134\") {\n            contentSections.skillExists = true;\n            contentItems.push(item);\n        }\n    });\n\nreturn contentItems"
          },
          "outcomes": {
            "success": "1769705950128"
          },
          "code": "FORMAT_CONTENT_SECTIONS",
          "convergenceTargetId": "1769684253059",
          "id": "1767616881296",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "If Content Item Id resolution Needed"
          },
          "outcomes": {
            "true": "1768392595072",
            "false": "add_false_1769705950128"
          },
          "code": "IF_CONTENT_ITEM_ID_RESOLUTION_NEEDED",
          "convergenceTargetId": "end",
          "id": "1769705950128",
          "inputs": [
            {
              "id": "1769705950130_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$variables.education?.length > 0 ||  $context.$variables.certifications?.length > 0 || $context.$variables.languages?.length > 0}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Prepare Profile contents for ItemId resolution",
            "returnType": "object",
            "sourceCode": "const contentSections = $context.$nodes.FORMAT_CONTENT_SECTIONS.$output.result;\nconst educations = $context.$variables.education .map(item => item.Degree);\nconst languages  = $context.$variables.languages ?.map(item => item.Language);\nconst certifications  =$context.$variables.certifications ?.map(item => item.Certification);\nconst schools = $context.$variables.education .map(item => item.School);\n\n\nconst output = contentSections.map((section) => {\n    let values = [];\n    const retObj = {\n        \"sectionId\": section.SectionId,\n        \"contentTypeId\": section.ContentTypeId\n    }\n    switch(section.ContentTypeId)\n    {\n        case \"103\":\n            retObj.values = certifications;\n            break;\n        case \"106\":\n            retObj.values = educations;\n            retObj.secondaryValues = schools;\n            break;\n        case \"109\":\n            retObj.values = languages;\n            break;\n    }\n     \n    return retObj;\n}).filter(contentValues=>contentValues.values?.length > 0 );\n\nreturn output;"
          },
          "outcomes": {
            "success": "1768400079752"
          },
          "code": "PREPARE_PROFILE_CONTENTS_FOR_ITEMID_RESOLUTION",
          "convergenceTargetId": "1769706093628",
          "id": "1768392595072",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_RECRUITING_RECRUITINGCANDIDATESTALENTPROFILETYPES",
            "functionName": "getall_talentProfileTypes",
            "name": "Fetch Talent Profile Types"
          },
          "outcomes": {
            "success": "1768400487296"
          },
          "code": "FETCH_TALENT_PROFILE_TYPES",
          "convergenceTargetId": "1769706093628",
          "id": "1768400079752",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"contentSections\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"items\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"properties\": {\n                      \"type\": \"object\",\n                      \"properties\": {\n                        \"items\": {\n                          \"type\": \"array\",\n                          \"items\": {\n                            \"type\": \"object\",\n                            \"properties\": {\n                              \"ValueSetName\": {\n                                \"type\": \"string\"\n                              },\n                              \"FieldName\": {\n                                \"type\": \"string\"\n                              },\n                              \"DefaultValue\": {\n                                \"type\": \"string\"\n                              }\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Extract Matching Content type and section record",
            "returnType": "object",
            "sourceCode": "//EXTRACT_MATCHING_CONTENT_TYPE_AND_SECTION_RECORD\nconst profileTypes = $context.$nodes.FETCH_TALENT_PROFILE_TYPES.$output.items[0].contentSections.items;\n\nconst result = $context.$nodes.PREPARE_PROFILE_CONTENTS_FOR_ITEMID_RESOLUTION.$output.result.map((contentTypeSpec) => {\n        const contentTypeId = contentTypeSpec.contentTypeId;\n        const sectionId = contentTypeSpec.sectionId;\n        const outputObj = contentTypeSpec;\n        const matchingRecord = profileTypes?.find((profileType) => { return profileType.ContentTypeId == contentTypeId && profileType.SectionId == sectionId });\n        let matchingRecordsContentItemIdFieldMetadata = matchingRecord?.properties?.items?.find(field => field.FieldName == \"CONTENT_ITEM_ID\");\n        if (matchingRecordsContentItemIdFieldMetadata && matchingRecordsContentItemIdFieldMetadata.InputType == 'VALUESET' && matchingRecordsContentItemIdFieldMetadata.ValueSetName) {\n            outputObj.valueSetId = matchingRecordsContentItemIdFieldMetadata.ValueSetName;\n        }else{\n            if(Number(contentTypeId) == 106 ){\n                matchingRecordsContentItemIdFieldMetadata = matchingRecord?.properties?.items?.find(field => field.FieldName == \"DEGREE_NAME\");\n                outputObj.apiFieldName= \"DegreeName\";\n            }\n            if(Number(contentTypeId) == 103 ){\n                matchingRecordsContentItemIdFieldMetadata = matchingRecord?.properties?.items?.find(field => field.FieldName == \"CERTIFICATION_NAME\");\n                outputObj.apiFieldName= \"CertificationName\";\n            }\n            if(Number(contentTypeId) == 109 ){\n                matchingRecordsContentItemIdFieldMetadata = matchingRecord?.properties?.items?.find(field => field.FieldName == \"LANGUAGE\");\n                outputObj.apiFieldName= \"Language\";\n            }\n        }\n\n        if(Number(contentTypeId) == 106 ){\n            const matchingRecordsSchoolIDMetadata = matchingRecord?.properties?.items?.find(field => field.FieldName == \"EDUCATIONAL_ESTABLISHMENT_ID\");\n            if(matchingRecordsSchoolIDMetadata.ValueSetName)\n            {\n                outputObj.establishmentValueSetId= matchingRecordsSchoolIDMetadata.ValueSetName;\n            }    \n        }\n        if(Number(contentTypeId) == 109 ){\n            const matchingRecordsLanguageProficiencyModels = matchingRecord?.properties?.items?.filter(field => (field.FieldName == \"SPEAKING_LEVEL_ID\" || field.FieldName == \"WRITING_LEVEL_ID\" || field.FieldName == \"READING_LEVEL_ID\") );\n            matchingRecordsLanguageProficiencyModels.forEach((fieldMD) => {\n                if (fieldMD.FieldName == \"SPEAKING_LEVEL_ID\") {\n                    outputObj.speakingLevelModelId  = fieldMD.ValueSetName;\n                }\n                else if (fieldMD.FieldName == \"WRITING_LEVEL_ID\") {\n                    outputObj.writingLevelModelId  = fieldMD.ValueSetName;\n                 }\n                 else if (fieldMD.FieldName == \"READING_LEVEL_ID\") {\n                    outputObj.readingLevelModelId  = fieldMD.ValueSetName;\n                }\n            }\n            );\n            outputObj.apiFieldName = \"Language\";\n        }\n\n        return outputObj;\n    }\n\n\n\n    )\n\nreturn result;"
          },
          "outcomes": {
            "success": "1768401032126"
          },
          "code": "EXTRACT_MATCHING_CONTENT_TYPE_AND_SECTION_RECORD",
          "convergenceTargetId": "1769706191519",
          "id": "1768400487296",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "dataPipeline": {
              "pipelineNodes": [
                {
                  "metadata": {
                    "name": "Start",
                    "description": "Start of data pipeline"
                  },
                  "outcomes": {
                    "success": "1768401176548"
