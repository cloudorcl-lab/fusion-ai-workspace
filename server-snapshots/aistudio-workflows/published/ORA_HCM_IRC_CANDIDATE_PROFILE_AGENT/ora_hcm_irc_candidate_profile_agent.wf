                  "type": "START"
                },
                {
                  "metadata": {
                    "name": "End",
                    "description": "End of data pipeline"
                  },
                  "id": "end_1768401032126",
                  "code": "END_1768401032126",
                  "type": "END"
                },
                {
                  "metadata": {
                    "name": "Prepare IN clause",
                    "returnType": "object",
                    "sourceCode": "const contentTypeData = $context.$nodes.RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE.$currentItem;\nlet values = contentTypeData.values;\nconst retObj = {};\n// escape single quote and join with comma\nlet  IN_Clause = values.map(value=>\"'\"+value.replace(\"'\",\"''\")+\"'\").join(',');\nretObj.contentItemInClause = IN_Clause;\n\nif(contentTypeData.secondaryValues){\n    if(Number(contentTypeData.contentTypeId) == 106 ){\n        // handle school names also\n        values = contentTypeData.secondaryValues;\n        IN_Clause = values.map(value=>\"'\"+value.replace(\"'\",\"''\")+\"'\").join(',');\n        retObj.secondaryDataInClause = IN_Clause;\n    }\n}\n\nreturn retObj;"
                  },
                  "outcomes": {
                    "success": "1771471658634"
                  },
                  "code": "PREPARE_IN_CLAUSE",
                  "id": "1768401176548",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "Update matching records from direct  value mappingy",
                    "returnType": "object",
                    "sourceCode": "const contentType = $context.$nodes.RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE.$currentItem.contentTypeId;\nconst valueSetId = $context.$nodes.RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE.$currentItem.valueSetId;\nconst establishmentValueSetId = $context.$nodes.RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE.$currentItem.establishmentValueSetId;\n\nconst values = $context.$nodes.RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE.$currentItem.values;\nconst resolvedValues = {};\n\nif(valueSetId){\n    const resultItems = $context.$nodes.RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE.FETCH_ITEM_FROM_LOV_WITH_IN_CLAUSE.$output.items||[];\n    resultItems.forEach( (item) =>{\n        const name =  item.Name;\n        const contentItemId = item.ContentItemId;\n        const matchingRecord = values.find(value=>value.toLowerCase() == name.toLowerCase());\n        if(matchingRecord && matchingRecord.length > 0 ){\n            resolvedValues[matchingRecord] = Number(contentItemId);\n        }\n\n    }\n    );\n}\n\nconst retObj = {resolved:resolvedValues};\nif(valueSetId){\n    retObj.unresolved = values.filter(value=>resolvedValues[value] == undefined);\n}else{\n    // if not value set , then non need to resolve pending items\n    retObj.unresolved = [];\n}\n\nif(Number(contentType) == 106  ){\n    // identify resolved establishment names as well\n    if(establishmentValueSetId){\n        const schools =  $context.$nodes.RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE.FETCH_SCHOOL_NAMES_LOV_FOR_CANDIDATES_SCHOOL.$output.items;\n        const schoolNamesFromInput = $context.$nodes.RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE.$currentItem.secondaryValues||[];\n        const resolvedSchools = {};\n        schools.forEach( (item) =>{\n            const name =  item.Name;\n            const contentItemId = item.ContentItemId;\n            const matchingRecord = schoolNamesFromInput.find(value=>value.toLowerCase() == name.toLowerCase());\n            if(matchingRecord && matchingRecord.length > 0 ){\n                resolvedSchools[matchingRecord] = Number(contentItemId);\n            }\n\n        }\n        );\n        retObj.resolvedEducationEstablishments = resolvedSchools;\n    }\n}\n\nreturn retObj;"
                  },
                  "outcomes": {
                    "success": "1768401393536"
                  },
                  "code": "UPDATE_MATCHING_RECORDS_FROM_DIRECT_VALUE_MAPPING",
                  "id": "1768401334638",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "If unresolved present"
                  },
                  "outcomes": {
                    "true": "1768815647406",
                    "false": "1768401682493"
                  },
                  "code": "IF_UNRESOLVED_PRESENT",
                  "convergenceTargetId": "end_1768401032126",
                  "id": "1768401393536",
                  "inputs": [
                    {
                      "id": "1768401393537_1",
                      "name": "condition",
                      "type": "string",
                      "value": "{{($context.$nodes.RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE.UPDATE_MATCHING_RECORDS_FROM_DIRECT_VALUE_MAPPING.$output.result.unresolved.length > 0 ) && $context.$variables.resolveContentItemIdUsingLLM}}"
                    }
                  ],
                  "type": "CONDITION"
                },
                {
                  "metadata": {
                    "name": "Prepare output  combining  content items from API and LLM",
                    "returnType": "object",
                    "sourceCode": "const llmOutput = \n $context.$nodes.RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE.RESOLVE_EACH_CONTENT_VALUE_WITH_TOKEN_LIKE_CLAUSE.$output ;\nconst values = $context.$nodes.RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE.$currentItem.values;\nconst outputFromAPI = $context.$nodes.RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE.UPDATE_MATCHING_RECORDS_FROM_DIRECT_VALUE_MAPPING.$output.result ;\n\nconst retVal = {contentTypeId: $context.$nodes.RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE.$currentItem.contentTypeId ,\nresolved:outputFromAPI.resolved,\nunresolved:[],\nresolvedValueMap:{}\n}\n// reduce llm output of parllel execution array to simple object\n\nconst llmOutToObject = llmOutput.map(item=>JSON.parse(item)).reduce((result,item)=>{ result[item.Name]= {Name:item.NameAvailableInLOV, ContentItemId:Number(item.ContentItemId)};return result},{});\n\n// for unresolved tokens check in LLM output if a matching entry was found\noutputFromAPI.unresolved.forEach( (value)=>{\n        \n    \n    if(llmOutToObject[value]?.ContentItemId != -1 ){\n            retVal.resolved[value] = llmOutToObject[value].ContentItemId ;\n            retVal.resolvedValueMap[value] = llmOutToObject[value].Name;\n        }else{\n            retVal.unresolved.push(value);\n        }\n    }\n);\nif(outputFromAPI.resolvedEducationEstablishments){\n    retVal.resolvedEducationEstablishments = outputFromAPI.resolvedEducationEstablishments;\n}\nreturn retVal;"
                  },
                  "outcomes": {
                    "success": "end_1768401032126"
                  },
                  "code": "COMBINE_RESOLVED_CONTENT_ITEMS_FROM_API_AND_LLM",
                  "id": "1768401602333",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "Prepare output object",
                    "returnType": "object",
                    "sourceCode": "const outputFromAPI = $context.$nodes.RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE.UPDATE_MATCHING_RECORDS_FROM_DIRECT_VALUE_MAPPING.$output.result ;\n\nconst result =   { contentTypeId: $context.$nodes.RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE.$currentItem.contentTypeId ,\nresolved:outputFromAPI.resolved ,\nunresolved: $context.$nodes.RESOLVE_CONTENT_ITEM_IDS_FOR_EACH_CONTENT_TYPE.UPDATE_MATCHING_RECORDS_FROM_DIRECT_VALUE_MAPPING.$output.result.unresolved\n};\nif(outputFromAPI.resolvedEducationEstablishments){\n    result.resolvedEducationEstablishments = outputFromAPI.resolvedEducationEstablishments;\n}\n\nreturn result;"
                  },
                  "outcomes": {
                    "success": "end_1768401032126"
                  },
                  "code": "PREPARE_OUTPUT_OBJECT",
                  "id": "1768401682493",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
