          "id": "1767687574330",
          "inputs": [
            {
              "id": "1767687574332_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.FORMAT_CONTENT_SECTIONS.$output.result}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "Process Output",
            "returnType": "string",
            "sourceCode": "let response = $context.$variables.response;\nlet status = response.Status || {};\nconst phoneCreateResult = $context.$nodes.CREATE_CANDIDATE_PHONE_RECORD.$output ;\nconst attachmentCreateResult= $context.$nodes.ATTACHMENT_CREATION_FOR_RESUME.$output ;\n\n\nconst education= $context.$variables.education ;\nconst  certifications = $context.$variables.certifications ;\nconst languages = $context.$variables.languages;\n\nconst skills= $context.$variables.skills ;\nconst  workHistory = $context.$variables.workHistory ;\n\nif ($context.$nodes?.IRCCANDPROFILEBO?.$status === \"failure\" ||   $context.$nodes?.IRCCANDPROFILEBO_NO_ST?.$status === \"failure\") {\n    status.CandidateStatus = \"FAILURE\";\n    response.CandidateDetails = null;\n} else {\n    status.CandidateStatus = \"SUCCESS\";\n    const candData = $context.$nodes?.IRCCANDPROFILEBO?.$output || $context.$nodes?.IRCCANDPROFILEBO_NO_ST?.$output;\n    const attachmentData = $context.$nodes?.ATTACHMENT_CREATION_FOR_RESUME?.$output;\n    response.CandidateDetails = {CandidateNumber:candData?.CandidateNumber,PersonId:candData.PersonId};\n    if(attachmentData){\n        response.CandidateDetails.AttachedDocumentId = attachmentData.AttachedDocumentId;\n    }\n}\n\ntry {\n    const profileResponse = $context.$nodes?.SAVE_CONTENT_ITEMS?.$output?.map(item => JSON.parse(item));\n    if (profileResponse && profileResponse != null) {\n        status.ProfileLanguageStatus = profileResponse?.find(item => item != false && item?.result?.ProfileLanguageStatus != null)?.result?.ProfileLanguageStatus || null;\n        status.ProfileEducationStatus = profileResponse?.find(item => item != false && item?.result?.ProfileEducationStatus != null)?.result?.ProfileEducationStatus || null;\n        status.ProfileCertificationStatus = profileResponse?.find(item => item != false && item?.result?.ProfileCertificationStatus != null)?.result?.ProfileCertificationStatus || null;\n        status.ProfileExperienceStatus = profileResponse?.find(item => item != false && item?.result?.ProfileExperienceStatus!= null)?.result?.ProfileExperienceStatus || null;\n        status.ProfileWorkReqStatus = profileResponse?.find(item => item != false && item?.result?.ProfileWorkReqStatus!= null)?.result?.ProfileWorkReqStatus || null;\n        status.ProfileSKillsStatus = profileResponse?.find(item => item != false && item?.result?.ProfileSKillsStatus != null)?.result?.ProfileSKillsStatus || null;\n        status.CandidateAttachmentStatus = (attachmentCreateResult?.AttachedDocumentId  || ($context.$triggers.REST.$input.resumeTrackerId && $context.$triggers.REST.$input.resumeTrackerId.trim() == '') )? 'SUCCESS':'FAILURE';\n        status.CandidatePhoneStatus = phoneCreateResult?.PhoneId ? 'SUCCESS':'FAILURE';\n\n    }\n} catch (e) {\n}\n\nresponse.Status = status;\n\n\nconst additionalInfo ={};\n\n\nif($context.$nodes?.SAVE_CONTENT_ITEMS?.$output){\n    const saveOutput = $context.$nodes?.SAVE_CONTENT_ITEMS?.$output;\n    const individualOutputs = saveOutput.map(output=>JSON.parse(output).result)||[];\n    additionalInfo.certification = {failed:[],skipped:[],modified:[],persisted:[]};\n    additionalInfo.education = {failed:[],skipped:[],modified:[],persisted:[]};\n    additionalInfo.language = {failed:[],skipped:[],modified:[],persisted:[]};\n    additionalInfo.skills = {failed:[],skipped:[],modified:[],persisted:[]};\n    additionalInfo.workHistory = {failed:[],skipped:[],modified:[],persisted:[]};\n\n\n    individualOutputs.forEach(output=>{\n            if(output?.ProfileCertificationStatus){\n                let savedValues = output?.ProfileResponse?.map(resp=>resp.result)||[];\n\n                certifications.forEach(inputItem=>{\n                    const addnlInfoForContentType  = additionalInfo.certification;\n                    const matchingRecord  = savedValues.find(savedItem=>{\n                        return  (savedItem.CertificationName && (savedItem.CertificationName == inputItem.TextValueToPersist)) || ( (String(savedItem.ContentItemId) == String(inputItem.ContentItemId)) && savedItem.ContentItemId )\n                    });\n                    if(matchingRecord ){\n                        //item is saved -> 2 possibilities , either persisted with LLM with modified value , in which case we append PersistedValue to the input object, else the same value is saved\n                        if(inputItem.PersistedValue){\n                            addnlInfoForContentType.modified.push({originalValue:inputItem.Certification ,persistedValue:inputItem.PersistedValue })\n                        }else{\n                            addnlInfoForContentType.persisted.push(inputItem.Certification);\n                        }\n                    }else if(inputItem.ContentItemId == -1){\n                        addnlInfoForContentType.skipped.push(inputItem.Certification);\n                    }else{\n                        addnlInfoForContentType.failed.push(inputItem.Certification);\n                    }\n                });\n\n            }else if(output?.ProfileLanguageStatus){\n                \n                let savedValues = output?.ProfileResponse?.map(resp=>resp.result)||[];\n\n                languages.forEach(inputItem=>{\n                    const addnlInfoForContentType  = additionalInfo.language;\n                    const matchingRecord  = savedValues.find(savedItem=>{\n                        return  (savedItem.Language && (savedItem.Language == inputItem.TextValueToPersist)) || ( (String(savedItem.ContentItemId) == String(inputItem.ContentItemId)) && savedItem.ContentItemId );\n                    });\n                    if(matchingRecord ){\n                        //item is saved -> 2 possibilities , either persisted with LLM with modified value , in which case we append PersistedValue, else the same value is saved\n                        if(inputItem.PersistedValue){\n                            addnlInfoForContentType.modified.push({originalValue:inputItem.Language ,persistedValue:inputItem.PersistedValue });\n                        }else{\n                            addnlInfoForContentType.persisted.push(inputItem.Language);\n                        }\n                    }else if(inputItem.ContentItemId == -1){\n                        addnlInfoForContentType.skipped.push(inputItem.Language);\n                    }else{\n                        addnlInfoForContentType.failed.push(inputItem.Language);\n                    }\n                });\n            }else if(output?.ProfileExperienceStatus){\n                let savedValues = output?.ProfileResponse?.map(resp=>resp.result)||[];\n\n                workHistory.forEach(inputItem=>{\n                    const addnlInfoForContentType  = additionalInfo.workHistory;\n                    const matchingRecord  = savedValues.find(savedItem=>{\n                        return  (savedItem.EmployerName && (savedItem.EmployerName == inputItem.Employer));\n                    });\n                    if(matchingRecord ){\n                        addnlInfoForContentType.persisted.push(inputItem.Employer);\n                    }else{\n                        addnlInfoForContentType.failed.push(inputItem.Employer);\n                    }\n                });\n            }else if(output?.ProfileSKillsStatus){\n                let savedValues = output?.ProfileResponse?.map(resp=>resp.result)||[];\n\n                skills.forEach(inputItem=>{\n                    const addnlInfoForContentType  = additionalInfo.skills;\n                    const matchingRecord  = savedValues.find(savedItem=>{\n                        return  (savedItem.Skill && (savedItem.Skill == inputItem));\n                    });\n                    if(matchingRecord ){\n                        addnlInfoForContentType.persisted.push(inputItem);\n                    }else{\n                        addnlInfoForContentType.failed.push(inputItem);\n                    }\n                });\n\n            }else if(output?.ProfileEducationStatus){\n                \n                 let savedValues = output?.ProfileResponse?.map(resp=>resp.result)||[];\n\n                education.forEach(inputItem=>{\n                    const addnlInfoForContentType  = additionalInfo.education;\n                    const matchingRecord  = savedValues.find(savedItem=>{\n                        return  (savedItem.DegreeName && (savedItem.DegreeName == inputItem.TextValueToPersist)) || ( (String(savedItem.ContentItemId) == String(inputItem.ContentItemId)) && savedItem.ContentItemId );\n                    });\n                    if(matchingRecord ){\n                        //item is saved -> 2 possibilities , either persisted with LLM with modified value , in which case we append PersistedValue, else the same value is saved\n                        if(inputItem.PersistedValue){\n                            addnlInfoForContentType.modified.push({originalValue:inputItem.Degree ,persistedValue:inputItem.PersistedValue });\n                        }else{\n                            addnlInfoForContentType.persisted.push(inputItem.Degree);\n                        }\n                    }else if(inputItem.ContentItemId == -1){\n                        addnlInfoForContentType.skipped.push(inputItem.Degree);\n                    }else{\n                        addnlInfoForContentType.failed.push(inputItem.Degree);\n                    }\n                });\n            } \n        }\n    );\n\n}\n\n// Check errored Nodes for basic creation , phone and atatchment and if failed , add the response to error info for consumer's ref\nconst basicCreationError = $context.$nodes?.IRCCANDPROFILEBO?.$error || $context.$nodes?.IRCCANDPROFILEBO_NO_ST?.$error;\nconst phoneError = $context.$nodes?.CREATE_CANDIDATE_PHONE_RECORD?.$error;\nconst attachmentError = $context.$nodes?.ATTACHMENT_CREATION_FOR_RESUME?.$error;\nconst addressError = $context.$nodes?.CREATE_ADDRESS?.$error;\n\nif(basicCreationError ){\n    additionalInfo.basicInfo = {error:JSON.parse(basicCreationError.$info)};\n}\nif(phoneError ){\n    additionalInfo.phone = {error:JSON.parse(phoneError.$info)};\n}\nif(attachmentError ){\n    additionalInfo.attachment = {error:JSON.parse(attachmentError.$info)};\n}\nif(addressError ){\n    additionalInfo.address = {error:JSON.parse(addressError.$info)};\n}\n\n\nresponse.AdditionalInfo = additionalInfo;\n\n\n\nreturn JSON.stringify(response, null, 2);"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "PROCESS_OUTPUT",
          "convergenceTargetId": "1768463968675",
          "id": "1767877157467",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
