          "metadata": {
            "name": "Consolidate All Output",
            "returnType": "object",
            "sourceCode": "const contactSummary = $context.$nodes.CONSOLIDATE_CONTACT_DATA.$output.result??[];\nconst accountSummary = JSON.stringify($context.$nodes.ACCOUNT_SUMMARY_FILE_CONTENT.$output??\"\");\nlet context = $context.$variables.context ;\nif(Object.hasOwn(context,\"result\")){\ncontext = context.result;\n}\nconst optyData = context?.opty_data??{};\nconst insightsData = JSON.stringify(context?.insight_data??\"\");\nconst newEngagements = context?.engagements??\"\" \n\nlet retObj = {contactSummary: JSON.stringify(contactSummary),accountSummary:accountSummary,optyData:optyData, insightsData:insightsData, newEngagements: newEngagements }\nreturn retObj;"
