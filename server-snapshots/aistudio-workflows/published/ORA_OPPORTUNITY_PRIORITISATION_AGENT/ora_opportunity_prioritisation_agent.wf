        {
          "metadata": {
            "name": "Set Contact and Account",
            "returnType": "object",
            "sourceCode": "let obj = $context.$variables.context; \nif(Object.hasOwn(obj,\"result\")){\nobj = obj.result;\n}\nlet optyData = obj?.opty_data[0];\nlet returnObj = {};\nreturnObj.account = optyData?.CustomerAccount?.PartyNumber;\nlet contactList = optyData?.ListOfContacts??[];\nreturnObj.contacts = contactList.map(contact=>contact?.PerPartyId?.PartyNumber);\nreturnObj.optyData = optyData;\nreturn returnObj;"
          },
          "outcomes": {
            "success": "1769684053334"
          },
