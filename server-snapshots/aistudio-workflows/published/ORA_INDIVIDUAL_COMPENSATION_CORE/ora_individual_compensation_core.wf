              "id": "1763112844492_1",
              "name": "condition",
              "type": "string",
              "value": "{{($context.$triggers.REST.$input.IsReadOnly && $context.$variables.FlowParams.Query.Intent !== 'TRANSACTION') || $context.$variables.FlowParams.Query.Intent === 'QUERY' || $context.$variables.FlowParams.Query.Intent === 'CHECK_ELIGIBILITY' || ($context.$variables.FlowParams.Query.Intent === 'TRANSACTION' && $context.$variables.FlowParams.Query.Operation === 'CREATE' && !$context.$triggers.REST.$input.IsReadOnly)}}"
            }
          ],
          "type": "CONDITION"
        },
