          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"items\": {\n            \"type\": \"array\",\n            \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n                    \"Name\": {\n                        \"type\": \"string\"\n                    },\n                    \"BaseName\": {\n                        \"type\": \"string\"\n                    },\n                    \"InputValueId\": {\n                        \"type\": \"string\"\n                    },\n                    \"Uom\": {\n                        \"type\": \"string\"\n                    },\n                    \"MandatoryFlag\": {\n                        \"type\": \"string\"\n                    },\n                    \"DefaultValue\": {\n                        \"type\": \"string\"\n                    },\n                    \"UserEnterableFlag\": {\n                        \"type\": \"string\"\n                    }\n                }\n            }\n        }\n    }\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Prepare Entry Template",
            "returnType": "object",
            "sourceCode": "const checkResult = {\n    PlanDetails: $context.$nodes.GET_SELECTED_PLAN_OPTION.$output.selectedPlanOption,\n    InputValues: $context.$nodes.GET_INPUT_VALUES.$output.items,\n    IsSupported: true,\n    Reason: null\n};\n\n// Add PlanInfo\ncheckResult.PlanDetails.PlanInfo = $context.$nodes.GET_PLAN_INFORMATION.$output.items[0].InstructionText;\n\n// DOR linked\nif (checkResult.PlanDetails.DocumentTypeId) {\n    checkResult.IsSupported = false;\n    checkResult.Reason = `You can't create allocations for this plan option with this agent because attachments are required.`;\n    return checkResult;\n}\n\n// Budget linked\nif (checkResult.PlanDetails.PoolIdToConsume || checkResult.PlanDetails.PeriodId) {\n    checkResult.IsSupported = false;\n    checkResult.Reason = `You can't create allocations for this plan option with this agent because it's linked to a budget.`;\n    return checkResult;\n}\n\n// Stock linked\nif (checkResult.PlanDetails.NonMonetaryUOM === 'SHARE') {\n    checkResult.IsSupported = false;\n    checkResult.Reason = `You can't create allocations for this plan option with this agent because it's linked with stock.`;\n    return checkResult;\n}\n\nconst inputValueTemplate = [];\n\nfor (const inputValue of checkResult.InputValues) {\n\n    // LOV without default value → not supported\n    if (\n        inputValue.UserEnterableFlag === 'Y' &&\n        inputValue.MandatoryFlag === 'Y' &&\n        inputValue.DataSource &&\n        !inputValue.DefaultValue\n    ) {\n        checkResult.IsSupported = false;\n        checkResult.Reason = `You can't create allocations for this plan option with this agent because a required choice list doesn't have a default value.`;\n        return checkResult;\n    }\n\n    // Build template\n    if (inputValue.DataSource) {\n        if (inputValue.DefaultValue) {\n            inputValueTemplate.push({\n                Name: inputValue.Name,\n                Value: `${inputValue.DefaultValue ?? ''} (Do not modify)`,\n                DisplaySequence: inputValue.DisplaySequence,\n                InputValueId: inputValue.InputValueId,\n                Uom: inputValue.Uom\n            });\n        }\n    } else {\n        if (inputValue.UserEnterableFlag === 'Y' || (inputValue.UserEnterableFlag === 'N' && inputValue.DefaultValue)) {\n            let defaultValue = (inputValue.UserEnterableFlag === 'N') ? `${inputValue.DefaultValue} (Do not modify)` : inputValue.DefaultValue;\n            inputValueTemplate.push({\n                Name: inputValue.Name,\n                Value: defaultValue,\n                DisplaySequence: inputValue.DisplaySequence,\n                InputValueId: inputValue.InputValueId\n            });\n        }\n    }\n}\n\n// Build entry template\nconst entryTemplate = {\n    Header: 'Create a new record',\n    Plan: checkResult.PlanDetails.PlanName,\n    Option: checkResult.PlanDetails.ComponentName,\n    StartDate: checkResult.PlanDetails.StartDate,\n    InputValues: inputValueTemplate\n};\n\n// Handle StartDate\nif (\n    !(\n        checkResult.PlanDetails.StartDateCode === 'FIXED_DATE' ||\n        checkResult.PlanDetails.StartDateCode === 'USER_CHOOSE_DATE'\n    )\n) {\n    entryTemplate.StartDate =\n        `${entryTemplate.StartDate} (Do not modify)`;\n}\n\n// Handle EndDate for recurring elements\nif (checkResult.PlanDetails.ProcessingType === 'R') {\n\n    let defaultEndDate = checkResult.PlanDetails.EndDate;\n    if (defaultEndDate === '4712-12-31') {\n        defaultEndDate = 'Ongoing';\n    }\n\n    if (\n        checkResult.PlanDetails.EndDateCode === null ||\n        checkResult.PlanDetails.EndDateCode === 'ONGOING_OR_USER_CHOOSE_DATE' ||\n        checkResult.PlanDetails.EndDateCode === 'USER_CHOOSE_DATE'\n    ) {\n        entryTemplate.EndDate = defaultEndDate;\n    } else {\n        entryTemplate.EndDate =\n            `${defaultEndDate} (Do not modify)`;\n    }\n}\n\ncheckResult.EntryTemplate = entryTemplate;\n\nreturn checkResult;"
          },
          "outcomes": {
            "success": "1763133494551"
          },
          "code": "PREPARE_ENTRY_TEMPLATE",
          "id": "1763131328579",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
