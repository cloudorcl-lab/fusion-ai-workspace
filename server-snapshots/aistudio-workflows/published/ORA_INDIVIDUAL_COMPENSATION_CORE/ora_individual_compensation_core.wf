            {
              "id": "1764667598454_1",
              "name": "prompt",
              "type": "string",
              "value": "Map and Return the Following Output Structure:\n\n1. IsPayload:\nSet this value to false.\n\n2. Message:\nReturn a single, polite, and user-friendly message informing the user that they are currently not allowed to make changes to their allocations.\n\nMessage Guidelines:\n- Explain that allocation changes are temporarily unavailable due to a pending transaction waiting for approval\n- Clearly state that the user can still:\n  - View their current allocations\n  - Check their eligibility for plans\n- Do NOT speculate, confirm, or invent system states.\n- Do NOT suggest workarounds or ways to bypass the restriction.\n- Keep the tone neutral, respectful, and helpful.\n- Return only the final user-facing message\n\n3. BatchPayload:\nReturn an empty array []"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"BatchPayload\": {\n            \"type\": \"array\",\n            \"items\": {\n                \"type\": \"object\",\n                \"properties\": {}\n            }\n        },\n        \"Message\": {\n            \"type\": \"string\"\n        },\n        \"IsPayload\": {\n            \"type\": \"boolean\"\n        }\n    }\n}",
          "type": "LLM"
        },
