          "inputs": [
            {
              "id": "1764672697982_1",
              "name": "prompt",
              "type": "string",
              "value": "From the user input ({{$context.$system.$inputMessage}}):\n\n1. Extract and normalize fields\n  - Identify and extract plan, option, start date, and end date.\n  - Convert start date and end date to ISO format (YYYY-MM-DD).\n  - If the user specifies \"Ongoing\" as the end date, set the end date to 4712-12-31.\n\n2. Map extracted values to InputValueIds\n  - For each extracted field, locate the matching object in {{$context.$variables.RecordDetails.InputValues}} by comparing the field name with its BaseName.\n  - For each match:\n      -- Set InputValueId to the corresponding ID from the matched object.\n      -- Set ScreenEntryValue to the value provided by the user (after normalization).\n      -- If a value is missing or blank, set ScreenEntryValue = null.\n      -- If Uom is M, the ScreenEntryValue should be formatted as currency value (with 2 decimal places by default) without any currency code. If value is a whole number, REMOVE the decimal places. (For e.g. 100.00 should be 100)\n      -- If Uom is I or N, the ScreenEntryValue should be formatted as number. If the input is not a valid number, set ScreenEntryValue as null\n      -- If Uom is T, the ScreenEntryValue should be formatted as time in HH:MM format."
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"InputValues\": {\n            \"type\": \"array\",\n            \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n                    \"InputValueId\": {\n                        \"type\": \"string\"\n                    },\n                    \"ScreenEntryValue\": {\n                        \"type\": \"string\"\n                    }\n                }\n            }\n        },\n        \"EndDate\": {\n            \"type\": \"string\"\n        },\n        \"StartDate\": {\n            \"type\": \"string\"\n        },\n        \"Option\": {\n            \"type\": \"string\"\n        },\n        \"Plan\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Validate And Create Payload",
            "returnType": "object",
            "sourceCode": "const flowParams = $context.$variables.FlowParams;\nconst planDetails = $context.$variables.RecordDetails.PlanDetails;\nconst inputValues = $context.$variables.RecordDetails.InputValues;\nconst userInput = $context.$nodes.PARSE_USER_INPUT.$output;\nconst reviewTemplate = JSON.parse(JSON.stringify($context.$variables.RecordDetails.EntryTemplate));\nconst traceId = $context.$workflow.$traceId;\n\nconst userInputValuesMap = {};\nfor (const userInputValue of userInput.InputValues || []) {\n    userInputValuesMap[userInputValue.InputValueId] = userInputValue.ScreenEntryValue;\n}\n\nlet validationErrors = [];\n\nlet eeValuesPayload = [];\nfor (let inputValue of inputValues) {\n    const entryValue = userInputValuesMap[inputValue.InputValueId] ?? inputValue.ScreenEntryValue;\n\n    if (inputValue.MandatoryFlag == 'Y' && !entryValue) {\n        return {\n            IsPayload: false,\n            Message: `Enter a value for ${inputValue.Name} and resubmit your request.`,\n            BatchPayload: {}\n        };\n    }\n\n    let eeValuePayload = {\n        ScreenEntryValue: inputValue.ScreenEntryValue,\n        InputValueId: inputValue.InputValueId\n    }\n\n    if (inputValue.UserEnterableFlag === 'Y') {\n        eeValuePayload.ScreenEntryValue = entryValue;\n        for (const ip of reviewTemplate.InputValues) {\n            if (ip.InputValueId === eeValuePayload.InputValueId) {\n                let displayValue = entryValue;\n                if (ip.Uom === 'M' && entryValue != null && !Number.isNaN(Number(entryValue))) {\n                    displayValue = `${Number(entryValue).toFixed(2)} ${planDetails.InputCurrencyCode}`;\n                }\n                ip.Value = displayValue;\n                eeValuePayload.ScreenEntryValue = displayValue;\n                break;\n            }\n        }\n    }\n    eeValuesPayload.push(eeValuePayload);\n}\n\n\nlet startDate = userInput.StartDate;\nif(!startDate){\n    startDate = planDetails.StartDate;\n}\nif (!(planDetails.StartDateCode === 'FIXED_DATE' ||\n    planDetails.StartDateCode === 'USER_CHOOSE_DATE') && startDate != planDetails.StartDate) {\n    return {\n        IsPayload: false,\n        Message: `The start date must be ${planDetails.StartDate}. Update and resubmit your request.`,\n        BatchPayload: {}\n    };\n}\n\nlet effectiveOfString = 'RangeStartDate=' + startDate;\nreviewTemplate.StartDate = startDate;\n\nif (new Date(startDate) < new Date(flowParams.EffectiveDate)) {\n    return {\n        IsPayload: false,\n        Message: `The start date must be on or after ${flowParams.EffectiveDate}. Update and resubmit your request.`,\n        BatchPayload: {}\n    };\n}\n\nif (planDetails.ProcessingType == 'R') {\n    let endDate = userInput.EndDate ?? planDetails.EndDate;\n\n    if (!(planDetails.EndDateCode === null ||\n        planDetails.EndDateCode === 'ONGOING_OR_USER_CHOOSE_DATE' ||\n        planDetails.EndDateCode === 'USER_CHOOSE_DATE') && endDate != planDetails.EndDate) {\n        return {\n            IsPayload: false,\n            Message: `The end date must be ${planDetails.EndDate}. Update and resubmit your request.`,\n            BatchPayload: {}\n        };\n    }\n    effectiveOfString += ';RangeEndDate=' + endDate;\n    reviewTemplate.EndDate = endDate;\n\n    if (new Date(startDate) > new Date(endDate)) {\n        return {\n            IsPayload: false,\n            Message: `The end date must be on or after the start date. Update and resubmit your request.`,\n            BatchPayload: {}\n        };\n    }\n}\n\nconst eeBatchPartPayload = {\n    CreatorType: 'VC',\n    ElementTypeId: planDetails.ElementTypeId,\n    EntryType: 'E',\n    PersonId: flowParams.PersonId,\n    AssignmentId: flowParams.AssignmentId,\n    Intent: flowParams.ElementEntryIntent,\n    elementEntryValues: eeValuesPayload\n};\n\nconst DORDeepLinkBaseURL = '[FA Endpoint Placeholder]/'\n    + 'faces/deeplink?objType=REDWOOD_DOCUMENT_RECORD&action=EDIT_IN_VB&objKey=pPersonId=' + flowParams.PersonId\n    + ';pReadOnly=true;pSimplifiedMode=true;pTxnDataOnly=true;pDocumentsOfRecordId=';\n\nconst hcmParamsMap = {\n    DisplayName: { value: flowParams.DisplayName, type: 'String' },\n    compEffectiveDate: { value: flowParams.EffectiveDate, type: 'SQLDate' },\n    compAssignmentId: { value: flowParams.AssignmentId, type: 'Long' },\n    compPersonId: { value: flowParams.PersonId, type: 'Long' },\n    AssignmentId: { value: flowParams.AssignmentId, type: 'Long' },\n    PersonId: { value: flowParams.PersonId, type: 'Long' },\n    compTermOrAssignment: { value: 'A', type: 'String' },\n    hcmPerActionId: { value: flowParams.ActionId, type: 'Long' },\n    compLegalEntityId: { value: flowParams.LegalEntityId, type: 'Long' },\n    intent: { value: flowParams.ElementEntryIntent, type: 'String' },\n    CmpAtchDeepLinkUrl: { value: DORDeepLinkBaseURL, type: 'String' },\n    CompEleIsTxnCtxtSet: { value: 'N', type: 'String' },\n    Source: {value: 'AI Agent', type: 'String'},\n    TraceId: {value: traceId, type: 'String'}\n}\n\n\nif (flowParams.IsICStandAloneFlow) {\n    hcmParamsMap.rulesClassPath = {\n        'value': 'oracle.apps.hcm.compensation.variableCompensation.allocations.protectedUiModel.common.VarCompConflictMatchingImpl',\n        'type': 'String'\n    };\n}\n\nconst batchParts = [];\n\nbatchParts.push({\n    'id': 'setICHCMParams',\n    'path': '/individualCompensationDetails/action/setICHCMParams',\n    'operation': 'invoke',\n    'payload': {\n        'params': hcmParamsMap\n    }\n});\n\nbatchParts.push({\n    id: 'icElementEntry',\n    path: '/elementEntries',\n    operation: 'create',\n    effectiveOf: effectiveOfString,\n    payload: eeBatchPartPayload\n});\n\nconst output = {\n    IsPayload: true,\n    BatchPayload: batchParts,\n    Message: null,\n    ReviewTemplate: reviewTemplate\n};\n\nreturn output;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "VALIDATE_AND_CREATE_PAYLOAD",
          "id": "1764672752772",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
      ],
