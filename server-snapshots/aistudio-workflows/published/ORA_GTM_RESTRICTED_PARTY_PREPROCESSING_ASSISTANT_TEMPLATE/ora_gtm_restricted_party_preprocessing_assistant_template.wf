          "outputSpecification": "{\n  \"type\": \"object\",\n  \"additionalProperties\": true,\n  \"properties\": {\n    \"hasMore\": { \"type\": \"boolean\" },\n    \"limit\": { \"type\": \"integer\" },\n    \"count\": { \"type\": \"integer\" },\n    \"offset\": { \"type\": \"integer\" },\n\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": true,\n        \"properties\": {\n          \"contactGid\": { \"type\": \"string\" },\n          \"contactXid\": { \"type\": \"string\" },\n          \"isPrimaryContact\": { \"type\": \"boolean\" },\n          \"routeThroughLocation\": { \"type\": \"boolean\" },\n          \"contactType\": { \"type\": \"string\" },\n          \"isBroadcast\": { \"type\": \"boolean\" },\n\n          \"location\": {\n            \"type\": \"object\",\n            \"additionalProperties\": true,\n            \"properties\": {\n              \"locationGid\": { \"type\": \"string\" },\n              \"locationXid\": { \"type\": \"string\" },\n              \"locationName\": { \"type\": \"string\" },\n              \"city\": { \"type\": \"string\" },\n              \"province\": { \"type\": \"string\" },\n              \"postalCode\": { \"type\": \"string\" },\n              \"countryCode3Gid\": { \"type\": \"string\" },\n              \"timeZoneGid\": { \"type\": \"string\" },\n\n              \"isTemporary\": { \"type\": \"boolean\" },\n              \"isMakeApptBeforePlan\": { \"type\": \"boolean\" },\n              \"isShipperKnown\": { \"type\": \"boolean\" },\n              \"isAddressValid\": { \"type\": \"string\" },\n              \"isLtlSplitable\": { \"type\": \"boolean\" },\n\n              \"useAppointmentPriority\": { \"type\": \"boolean\" },\n              \"scheduleLowPriorityAppoint\": { \"type\": \"boolean\" },\n              \"enforceTimeWindowAppoint\": { \"type\": \"boolean\" },\n              \"scheduleInfeasibleAppoint\": { \"type\": \"boolean\" },\n\n              \"bbIsNewStore\": { \"type\": \"boolean\" },\n              \"excludeFromRouteExecution\": { \"type\": \"boolean\" },\n              \"isTemplate\": { \"type\": \"boolean\" },\n              \"allowDriverRest\": { \"type\": \"boolean\" },\n\n              \"apptObjectType\": { \"type\": \"string\" },\n              \"isFixedAddress\": { \"type\": \"boolean\" },\n              \"primaryAddressLineSeq\": { \"type\": \"integer\" },\n\n              \"domainName\": { \"type\": \"string\" },\n              \"isActive\": { \"type\": \"boolean\" },\n\n              \"addressUpdateDate\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"value\": { \"type\": \"string\", \"format\": \"date-time\" }\n                }\n              },\n              \"updateDate\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"value\": { \"type\": \"string\", \"format\": \"date-time\" }\n                }\n              },\n              \"insertDate\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"value\": { \"type\": \"string\", \"format\": \"date-time\" }\n                }\n              },\n\n              \"normalizedAttrs\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"links\": {\n                    \"type\": \"array\",\n                    \"items\": {\n                      \"type\": \"object\",\n                      \"properties\": {\n                        \"rel\": { \"type\": \"string\" },\n                        \"href\": { \"type\": \"string\" }\n                      }\n                    }\n                  }\n                }\n              },\n\n              \"contacts\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"links\": {\n                    \"type\": \"array\",\n                    \"items\": {\n                      \"type\": \"object\",\n                      \"properties\": {\n                        \"rel\": { \"type\": \"string\" },\n                        \"href\": { \"type\": \"string\" }\n                      }\n                    }\n                  }\n                }\n              },\n\n              \"addresses\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"hasMore\": { \"type\": \"boolean\" },\n                  \"totalResults\": { \"type\": \"integer\" },\n                  \"limit\": { \"type\": \"integer\" },\n                  \"count\": { \"type\": \"integer\" },\n                  \"offset\": { \"type\": \"integer\" },\n\n                  \"items\": {\n                    \"type\": \"array\",\n                    \"items\": {\n                      \"type\": \"object\",\n                      \"properties\": {\n                        \"lineSequence\": { \"type\": \"integer\" },\n                        \"addressLine\": { \"type\": \"string\" },\n                        \"domainName\": { \"type\": \"string\" },\n                        \"insertDate\": {\n                          \"type\": \"object\",\n                          \"properties\": {\n                            \"value\": {\n                              \"type\": \"string\",\n                              \"format\": \"date-time\"\n                            }\n                          }\n                        },\n                        \"links\": {\n                          \"type\": \"array\",\n                          \"items\": {\n                            \"type\": \"object\",\n                            \"properties\": {\n                              \"rel\": { \"type\": \"string\" },\n                              \"href\": { \"type\": \"string\" }\n                            }\n                          }\n                        }\n                      },\n                      \"required\": [\"lineSequence\", \"addressLine\"]\n                    }\n                  }\n                },\n                \"required\": [\"items\"]\n              },\n\n              \"links\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"rel\": { \"type\": \"string\" },\n                    \"href\": { \"type\": \"string\" }\n                  }\n                }\n              }\n            }\n          },\n\n          \"isEmailVirusProtected\": { \"type\": \"boolean\" },\n          \"consolidatedNotifyOnly\": { \"type\": \"boolean\" },\n          \"isNotificationOn\": { \"type\": \"boolean\" },\n          \"isFromAddress\": { \"type\": \"boolean\" },\n          \"sendAsMessage\": { \"type\": \"boolean\" },\n\n          \"domainName\": { \"type\": \"string\" },\n          \"alternateName\": { \"type\": \"string\" },\n          \"companyName\": { \"type\": \"string\" },\n\n          \"nameAddressUpdateDate\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"value\": { \"type\": \"string\", \"format\": \"date-time\" }\n            }\n          },\n          \"updateDate\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"value\": { \"type\": \"string\", \"format\": \"date-time\" }\n            }\n          },\n          \"insertDate\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"value\": { \"type\": \"string\", \"format\": \"date-time\" }\n            }\n          },\n\n          \"normalizedAttrs\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"links\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"rel\": { \"type\": \"string\" },\n                    \"href\": { \"type\": \"string\" }\n                  }\n                }\n              }\n            }\n          },\n\n          \"links\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"rel\": { \"type\": \"string\" },\n                \"href\": { \"type\": \"string\" }\n              }\n            }\n          }\n        },\n        \"required\": [\"contactGid\", \"contactXid\"]\n      }\n    },\n\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": { \"type\": \"string\" },\n          \"href\": { \"type\": \"string\" }\n        }\n      }\n    }\n  },\n\n  \"required\": [\"items\"]\n}",
