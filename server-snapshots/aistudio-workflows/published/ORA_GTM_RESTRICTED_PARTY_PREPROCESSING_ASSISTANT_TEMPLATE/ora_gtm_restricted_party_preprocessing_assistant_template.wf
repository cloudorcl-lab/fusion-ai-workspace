        {
          "metadata": {
            "name": "Prepare normalized contact attributes",
            "returnType": "array",
            "sourceCode": "function toText(value) {\n  if (value === null || value === undefined) return null;\n  const text = String(value).trim();\n  return text.length ? text : null;\n}\n\nconst party = $context.$nodes.FETCH_PARTY_DETAILS.$output.items[0] ?? {};\nconst normalized = $context.$nodes.NORMALIZE_NAME?.$output ?? {};\n\nconst contactGid = toText(party.contactGid);\nconst domainName =\n  toText(party.domainName) ??\n  (contactGid && contactGid.includes(\".\") ? contactGid.split(\".\")[0] : null);\n\nconst items = [\n  {\n    attributeName: \"FIRSTNAME\",\n    normalizedText: toText(normalized.firstNameNormalized),\n    domainName,\n    sourceType: \"AI\"\n  },\n  {\n    attributeName: \"LASTNAME\",\n    normalizedText: toText(normalized.lastNameNormalized),\n    domainName,\n    sourceType: \"AI\"\n  },\n  {\n    attributeName: \"COMPANYNAME\",\n    normalizedText: toText(normalized.companyNameNormalized),\n    domainName,\n    sourceType: \"AI\"\n  },\n  {\n    attributeName: \"ALTERNATENAME\",\n    normalizedText: toText(normalized.alternateNameNormalized),\n    domainName,\n    sourceType: \"AI\"\n  }\n].filter(item => item.normalizedText !== null);\n\nreturn items;"
          },
          "outcomes": {
            "success": "1776060284356"
          },
          "code": "PREPARE_NORMALIZED_CONTACT_ATTRIBUTES",
          "convergenceTargetId": "1776286223808",
