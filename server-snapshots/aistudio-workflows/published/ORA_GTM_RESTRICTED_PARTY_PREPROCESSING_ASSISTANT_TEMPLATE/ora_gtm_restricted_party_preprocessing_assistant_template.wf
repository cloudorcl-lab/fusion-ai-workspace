        {
          "metadata": {
            "name": "Extract screening fields",
            "returnType": "object",
            "sourceCode": "const party = $context.$nodes.FETCH_PARTY_DETAILS.$output.items[0];\nconst addresses = party?.location?.addresses?.items ?? [];\n\nconst sortedAddresses = [...addresses]\n  .filter(a => a && typeof a.lineSequence === \"number\")\n  .sort((a, b) => a.lineSequence - b.lineSequence);\n\nconst result = {\n  firstName: party?.firstName ?? null,\n  lastName: party?.lastName ?? null,\n  alternateName: party?.alternateName ?? null,\n  companyName: party?.companyName ?? null,\n\n  addressLine1: sortedAddresses[0]?.addressLine ?? null,\n  addressLine2: sortedAddresses[1]?.addressLine ?? null,\n  addressLine3: sortedAddresses[2]?.addressLine ?? null,\n\n  city: party?.location?.city ?? null,\n  province: party?.location?.province ?? null,\n  postalCode: party?.location?.postalCode ?? null,\n  country: party?.location?.countryCode3Gid ?? null\n}\n\nconsole.log(result)\n\nreturn result;"
          },
          "outcomes": {
            "success": "1775071389481"
          },
          "code": "EXTRACT_SCREENING_FIELDS",
          "id": "1775057718223",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
