            "name": "Prepare normalized location attributes",
            "returnType": "array",
            "sourceCode": "function toText(value) {\n  if (value === null || value === undefined) return null;\n  const text = String(value).trim();\n  return text.length ? text : null;\n}\n\nconst party = $context.$nodes.FETCH_PARTY_DETAILS?.$output ?? {};\nconst normalized = $context.$nodes.NORMALIZE_ADDRESS?.$output ?? {};\n\nconst location = party.location ?? {};\nconst locationGid = toText(location.locationGid);\nconst domainName =\n  toText(location.domainName) ??\n  toText(party.domainName) ??\n  (locationGid && locationGid.includes(\".\") ? locationGid.split(\".\")[0] : null);\n\nconst items = [\n  {\n    attributeName: \"ADDRESSLINE1\",\n    normalizedText: toText(normalized.normalizedAddressLine1),\n    domainName,\n    sourceType: \"AI\"\n  },\n  {\n    attributeName: \"ADDRESSLINE2\",\n    normalizedText: toText(normalized.normalizedAddressLine2),\n    domainName,\n    sourceType: \"AI\"\n  },\n  {\n    attributeName: \"ADDRESSLINE3\",\n    normalizedText: toText(normalized.normalizedAddressLine3),\n    domainName,\n    sourceType: \"AI\"\n  },\n  {\n    attributeName: \"CITY\",\n    normalizedText: toText(normalized.normalizedCity),\n    domainName,\n    sourceType: \"AI\"\n  },\n  {\n    attributeName: \"PROVINCE\",\n    normalizedText: toText(normalized.normalizedProvince),\n    domainName,\n    sourceType: \"AI\"\n  },\n  {\n    attributeName: \"POSTALCODE\",\n    normalizedText: toText(normalized.normalizedPostalCode),\n    domainName,\n    sourceType: \"AI\"\n  },\n  {\n    attributeName: \"COUNTRY\",\n    normalizedText: toText(normalized.normalizedCountry),\n    domainName,\n    sourceType: \"AI\"\n  }\n].filter(item => item.normalizedText !== null);\n\nreturn items;"
          },
          "outcomes": {
            "success": "1776352044529"
          },
