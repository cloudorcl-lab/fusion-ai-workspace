        {
          "metadata": {
            "name": "Simplify Draft Negotiations",
            "returnType": "object",
            "sourceCode": "const rawList =  $context.$nodes.GET_DRAFT_NEGOTIATIONS.$output.items &&  $context.$nodes.GET_DRAFT_NEGOTIATIONS.$output.items ?  $context.$nodes.GET_DRAFT_NEGOTIATIONS.$output.items : ( $context.$nodes.GET_DRAFT_NEGOTIATIONS.$output.items || []);\n\nconst result = rawList.reduce((acc, item) => {\n    \n    if (!acc.seenIds.has(item.AuctionHeaderId)) { \n        acc.seenIds.add(item.AuctionHeaderId);\n\n        const created = new Date(item.CreationDate);\n        const now = new Date(item.CurrentDateTime);\n        const diffInMs = now - created;\n        const diffInDays = diffInMs / (1000 * 60 * 60 * 24);\n\n        acc.uniqueList.push({\n             AuctionHeaderId: item.AuctionHeaderId,\n             Status: item.NegotiationStatusCode,\n             DifferenceInDays: Number(diffInDays.toFixed(3))\n        });\n    }\n\n    return acc;\n\n}, { seenIds: new Set(), uniqueList: [] }); \n\nlet obj= {\n    NegotiationsList: result.uniqueList,\n    NegotiationsCount: result.uniqueList.length\n\n  };\n\n \n  return obj;"
          },
