          "metadata": {
            "name": "Analysis Results",
            "returnType": "object",
            "sourceCode": "let draftAnalysis = $context.$nodes.ANALIZE_DRAFT_NEEDING_ATTENTION.$output;\nlet activeAnalysis = $context.$nodes.ANALIZE_ACTIVE_NEGOTIATIONS.$output;\nlet pendingAward = $context.$nodes.ANALIZE_PENDING_AWARD.$output;\n\nfunction buildIndexedObject(...items) {\n  return Object.fromEntries(items.map((item, index) => [index, item]));\n}\n\nlet variable = buildIndexedObject(\n  draftAnalysis,\n  activeAnalysis,\n  pendingAward\n);\n\nreturn variable;"
