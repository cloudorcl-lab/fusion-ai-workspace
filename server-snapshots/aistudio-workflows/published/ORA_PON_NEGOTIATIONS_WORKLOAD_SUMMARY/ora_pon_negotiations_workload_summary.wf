        {
          "metadata": {
            "name": "Simplify Active Data",
            "returnType": "object",
            "sourceCode": "const rawList =\n  $context.$nodes.GET_ACTIVE_NEGOTIATIONS.$output.items\n    ? $context.$nodes.GET_ACTIVE_NEGOTIATIONS.$output.items\n    : [];\n\nconst result = rawList.reduce((acc, item) => {\n    const created = new Date(item.CloseDate);\n    const now = new Date(item.CurrentDateTime);\n    const diffInMs = created - now;\n    const diffInDays = diffInMs / (1000 * 60 * 60 * 24);\n\n    const suppliersCountExists =\n        Object.prototype.hasOwnProperty.call(item, \"SuppliersCount\");\n\n    const supplierResponsesExists =\n        Object.prototype.hasOwnProperty.call(item, \"SupplierResponses\");\n\n    const suppliersCount = item.SuppliersCount;\n    const supplierResponses = item.SupplierResponses;\n\n    const hasLowSupplierParticipation =\n        suppliersCountExists &&\n        supplierResponsesExists &&\n        suppliersCount >= 0 &&\n        supplierResponses >= 0 &&\n        supplierResponses <= suppliersCount &&\n        (\n            supplierResponses === 0 ||\n            supplierResponses / suppliersCount <= 0.250\n        );\n\n    if (\n        !acc.seenIds.has(item.AuctionHeaderId) &&\n        diffInDays <= 5.000 &&\n        hasLowSupplierParticipation\n    ) {\n        acc.seenIds.add(item.AuctionHeaderId);\n\n        acc.uniqueList.push({\n            AuctionHeaderId: item.AuctionHeaderId,\n            Status: item.NegotiationStatusCode,\n            DifferenceInDays: diffInDays.toFixed(3),\n            SuppliersCount: item.SuppliersCount,\n            SupplierResponses: item.SupplierResponses\n        });\n    }\n\n    return acc;\n\n}, { seenIds: new Set(), uniqueList: [] });\n\nlet obj = {\n    NegotiationsCount: result.uniqueList.length,\n    NegotiationsList: result.uniqueList\n};\n\nreturn obj;"
