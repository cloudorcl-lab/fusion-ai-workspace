          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"Generated schema for Root\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"AuctionHeaderId\": {\n            \"type\": \"number\"\n          },\n          \"NegotiationTitle\": {\n            \"type\": \"string\"\n          },\n          \"NegotiationType\": {\n            \"type\": \"string\"\n          },\n          \"Negotiation\": {\n            \"type\": \"string\"\n          },\n          \"NegotiationStatus\": {\n            \"type\": \"string\"\n          },\n          \"NegotiationStatusCode\": {\n            \"type\": \"string\"\n          },\n          \"OpenDate\": {\n            \"type\": \"string\"\n          },\n          \"CloseDate\": {\n            \"type\": \"string\"\n          },\n          \"TimeRemaining\": {\n            \"type\": \"string\"\n          },\n          \"SuppliersCount\": {\n            \"type\": \"number\"\n          },\n          \"SupplierResponses\": {\n            \"type\": \"number\"\n          },\n          \"CreationDate\": {\n            \"type\": \"string\"\n          },\n          \"NegApprovalSubmitDate\": {\n            \"type\": \"string\"\n          },\n          \"AuctionStatusCode\": {\n            \"type\": \"string\"\n          },\n          \"LastUpdateDate\": {\n            \"type\": \"string\"\n          },\n           \"CurrentDateTime\": {\n            \"type\": \"string\"\n          },\n           \"AwardDate\": {\n            \"type\": \"string\"\n          },\n           \"AwardApprovalSubmitDate\": {\n            \"type\": \"string\"\n          },\n          \"ProcurementBUId\": { \"type\": \"number\" },\n          \"ProcurementBU\": { \"type\": \"string\" },\n          \"BuyerId\": { \"type\": \"number\" },\n          \"Buyer\": { \"type\": \"string\" }\n