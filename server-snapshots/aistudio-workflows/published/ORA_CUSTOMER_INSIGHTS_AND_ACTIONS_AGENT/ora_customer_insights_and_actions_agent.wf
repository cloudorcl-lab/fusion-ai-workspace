              },
              "code": "ORA_MODEL_CONFIG_PREMIUM_OPEN_AI_GPT_4_1_MINI",
              "model": "OCI_GPT_5_MINI",
              "modelName": "Gpt-5 Mini",
              "provider": "CERT_PREMIUM"
            },
            "name": "LLMCustomerSummary"
          },
          "outcomes": {
            "success": "1770573796689"
          },
          "code": "LLMCUSTOMERSUMMARY",
          "convergenceTargetId": "1770573101125",
          "id": "1764780240579",
          "inputs": [
            {
              "id": "1764780240581_1",
              "name": "prompt",
              "type": "string",
              "value": "INPUT\n\nAccount Products:\n{{$context.$nodes.GETACCOUNTPRODUCTS.$output}}\n\nBuying Groups:\n{{$context.$nodes.GETBUYINGGROUPSFORACCOUNTS.$output}}\n\nProduct Profiler Result:\n{{$context.$nodes.PRODUCTPROFILERCODE.$output.result}}\n\nAccount Insight Type Override:\n{{$context.$triggers.REST.$input.action.config.accountInsightType}}\n\nROLE\n\nYou generate one executive-friendly customer summary.\n\nReturn valid JSON only.\n\nSUMMARY RULES\n\ncustomerSummary:\n- Write 1 to 2 concise executive-friendly sentences.\n- Summarize the account across products and buying groups.\n- Do not mention explicit numbers, counts, percentages, scores, lists, or bullets.\n- Use Product Profiler Result only as context for the summary posture.\n- If accountInsightType is exactly EXPANSION, emphasize expansion readiness, positive momentum, buying group maturity, and growth opportunity.\n- If accountInsightType is exactly RISK, emphasize risk drivers, stability concerns, adoption challenges, and areas needing attention.\n- If accountInsightType is missing, empty, null, or any other value, infer the posture from Product Profiler Result:\n  - If riskProductIds has values and expansionProductIds has no values, emphasize risk drivers, stability concerns, adoption challenges, and areas needing attention.\n  - If expansionProductIds has values and riskProductIds has no values, emphasize expansion readiness, positive momentum, buying group maturity, and growth opportunity.\n  - If both riskProductIds and expansionProductIds have values, balance expansion opportunity with clear acknowledgement of risk.\n  - If neither riskProductIds nor expansionProductIds has values, describe a stable but neutral posture with no strong expansion or risk signals.\n- If the input is insufficient for a meaningful narrative, return:\n  \"There is no meaningful data for this customer.\"\n\nOUTPUT CONTRACT\n\nReturn exactly this JSON object:\n\n{\n  \"customerSummary\": \"string\"\n}\n\nFINAL RULES\n\n- Return only the JSON object.\n- Do not add extra properties.\n- Do not add comments or markdown.\n- Ensure customerSummary is always present.\n- Ensure the response is valid JSON."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"customerOutput1\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"customerSummary\": { \"type\": \"string\" }\n  }\n}",
          "type": "LLM"
        },
