            "name": "constructFilterForBuyingGroups",
            "returnType": "string",
            "sourceCode": "const accountId = $context.$triggers.REST.$input.action.config.accountId;\nconst expansionProductIds = $context.$nodes.PRODUCTPROFILERCODE.$output.result.expansionProductIds;\n\nconst expansionProductIdList = expansionProductIds.map((id) => `'${id}'`).join(\", \");\n\nreturn `fusionAccount.id=${accountId} and accountProductIdentifier in (${expansionProductIdList})`;"
