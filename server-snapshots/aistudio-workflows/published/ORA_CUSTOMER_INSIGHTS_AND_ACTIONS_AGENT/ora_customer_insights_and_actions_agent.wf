          "metadata": {
            "name": "constructMYFilter",
            "returnType": "string",
            "sourceCode": "// Resolve product filter.\n// Default behavior is enabled when filterProductByTerritory is null/undefined.\n\nlet productFilter = \"1=1\";\nconst filterProductByTerritory = $context.$triggers.REST.$input.filterConfiguration.filterProductByTerritory;\n\nif (\n  filterProductByTerritory === null ||\n  filterProductByTerritory === undefined ||\n  filterProductByTerritory === true ||\n  filterProductByTerritory === \"true\"\n) {\n  productFilter =\n    \"((productType = 'PRODUCT_GROUP' and \" +\n    \"fusionProductGroup[parentProductGroupHierarchies[\" +\n    \"baseUsageFlag = true and firstProductGroup[\" +\n    \"territoryCoverages[territory[territoryResources[resource.partyId=@faContext.partyId]]]]]]) \" +\n    \"or (productType = 'Item' and fusionProduct[\" +\n    \"territoryCoverages[territory[territoryResources[resource.partyId=@faContext.partyId]]] \" +\n    \"or parentProductGroups[activeFlag = true and startDate < @currentDateTime \" +\n    \"and endDate > @currentDateTime and productGroup[\" +\n    \"parentProductGroupHierarchies[baseUsageFlag = true and firstProductGroup[\" +\n    \"territoryCoverages[territory[territoryResources[resource.partyId=@faContext.partyId]]]]]]]]))\";\n}\n\nreturn productFilter;"
          },
          "outcomes": {
            "success": "1765476256890"
          },
          "code": "CONSTRUCTMYFILTER",
          "id": "1770154981329",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
