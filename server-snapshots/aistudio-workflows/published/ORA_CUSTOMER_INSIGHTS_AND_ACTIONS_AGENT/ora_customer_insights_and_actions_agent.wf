            "returnType": "object",
            "sourceCode": "const raw = $context.$nodes.GETOPENAPIBUYINGGROUPS.$output;\nconst openApiJson = typeof raw === \"string\" ? JSON.parse(raw) : raw;\nconst schemas = openApiJson?.components?.schemas || {};\n\nconst businessObjects = [];\n\nfor (const [schemaName, schemaDef] of Object.entries(schemas)) {\n  if (!Array.isArray(schemaDef?.allOf)) {\n    continue;\n  }\n\n  let businessObjectTitle = null;\n  let businessObjectDescription = \"\";\n  let fieldsSchemaName = null;\n\n  for (const part of schemaDef.allOf) {\n    if (part?.type === \"object\" && (part.title || part.description)) {\n      businessObjectTitle = part.title || schemaName;\n      businessObjectDescription = part.description || \"\";\n    }\n\n    if (part?.$ref) {\n      fieldsSchemaName = part.$ref.replace(\"#/components/schemas/\", \"\");\n    }\n  }\n\n  if (!businessObjectTitle || !fieldsSchemaName) {\n    continue;\n  }\n\n  const fieldsSchema = schemas[fieldsSchemaName];\n  const properties = fieldsSchema?.properties;\n\n  if (!properties) {\n    continue;\n  }\n\n  const attributes = [];\n\n  for (const [attributeName, attributeDef] of Object.entries(properties)) {\n    attributes.push({\n      name: attributeName,\n      description: attributeDef?.description || \"No description available\"\n    });\n  }\n\n  businessObjects.push({\n    businessObjectName: schemaName,\n    businessObjectTitle,\n    businessObjectDescription,\n    fieldsSchemaName,\n    attributes\n  });\n}\n\nreturn businessObjects;"
          },
