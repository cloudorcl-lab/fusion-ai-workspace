        {
          "metadata": {
            "name": "CustomerInsightsResponse",
            "returnType": "object",
            "sourceCode": "const c1 = $context.$nodes.LLMCUSTOMERSUMMARY?.$output || {};\nconst c2 = $context.$nodes.LLMEXPANSIONPRODUCTSFORINSIGHTS?.$output || {};\nconst c3 = $context.$nodes.LLMRISKPRODUCTSFORINSIGHTS?.$output || {};\nconst c4 = $context.$nodes.LLMCUSTOMERACTIONS?.$output || {};\n\nconst profilerResult = $context.$nodes.PRODUCTPROFILERCODE?.$output?.result || {};\nconst accountInsightType = $context.$triggers.REST.$input.action?.config?.accountInsightType;\n\nconst asArray = (value) => Array.isArray(value) ? value : [];\n\nconst {expansionProductIds, riskProductIds, ownedProductIds} = profilerResult;\n\nlet expansionFlag = expansionProductIds.length > 0;\nlet riskFlag = riskProductIds.length > 0;\n\nif (accountInsightType === \"EXPANSION\") {\n  expansionFlag = true;\n  riskFlag = false;\n} else if (accountInsightType === \"RISK\") {\n  expansionFlag = false;\n  riskFlag = true;\n}\n\nconst hasMoreExpansionProducts = expansionProductIds.length > 5;\nconst hasMoreRiskProducts = riskProductIds.length > 5;\nconst hasMoreOwnedProducts =\n  ownedProductIds.length > 5 ||\n  (riskProductIds.length > 0 && ownedProductIds.length > 0);\n\nconst expansionProducts = Array.isArray(c2.expansionProducts?.items)\n  ? c2.expansionProducts.items.slice(0, 5)\n  : [];\n\nconst riskProducts = Array.isArray(c3.riskProducts?.items)\n  ? c3.riskProducts.items.slice(0, 5)\n  : [];\n\nconst actionItems = Array.isArray(c4.actions?.items)\n  ? c4.actions.items\n  : [];\n\nconst accountProducts = $context.$nodes.GETACCOUNTPRODUCTS.$output?.items ?? [];\n\nconst ownedProducts = accountProducts\n  .filter((product) => product?.ownershipStatus === \"ORA_ACTIVE\")\n  .slice(0, 5)\n  .map((product) =>\n    Object.fromEntries(\n      Object.entries(product).filter(\n        ([, value]) => value === null || typeof value !== \"object\"\n      )\n    )\n  );\n\nconst result = {\n  customerSummary: c1.customerSummary || \"\",\n  expansionFlag,\n  riskFlag,\n  hasMoreExpansionProducts,\n  hasMoreRiskProducts,\n  hasMoreOwnedProducts,\n  actions: {\n    items: actionItems\n  },\n  expansionProducts: {\n    items: expansionProducts\n  },\n  riskProducts: {\n    items: riskProducts\n  },\n  ownedProducts: {\n    items: ownedProducts\n  }\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1770573935613"
          },
