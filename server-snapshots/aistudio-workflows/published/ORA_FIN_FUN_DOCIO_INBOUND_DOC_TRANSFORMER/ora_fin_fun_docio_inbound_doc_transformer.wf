        {
          "metadata": {
            "name": "Input Payload Validator",
            "returnType": "object",
            "sourceCode": "// ===============================\n// INPUT VALIDATION & PAYLOAD WRAPPER\n// ===============================\n\nconst raw = $context.$system.$inputMessage;\nlet input;\nlet result = null;\n\n// 1. Parse input safely (handle double stringification)\nif (typeof raw === \"string\") {\n    try {\n        const parsed = JSON.parse(raw);\n        if (typeof parsed === \"string\") {\n            input = JSON.parse(parsed);\n        } else {\n            input = parsed;\n        }\n    } catch (e) {\n        // Return error immediately on parse failure\n        return {\n            status: \"ERROR\",\n            error: {\n                stage: \"Input Validation\",\n                code: \"MALFORMED_INPUT\",\n                message: \"Input is not valid JSON.\"\n            }\n        };\n    }\n} else {\n    input = raw;\n}\n\n// 2. Validate input presence and type\nif (!input || typeof input !== \"object\") {\n    return {\n        status: \"ERROR\",\n        error: {\n            stage: \"Input Validation\",\n            code: \"INVALID_STRUCTURE\",\n            message: \"Input payload is missing or invalid.\"\n        }\n    };\n}\n\n// 3. Required field validation\nconst missingFields = [];\nif (typeof input.content !== \"string\" || input.content.trim() === \"\") {\n    missingFields.push(\"content\");\n}\nif (typeof input.documentFileName !== \"string\" || input.documentFileName.trim() === \"\") {\n    missingFields.push(\"documentFileName\");\n}\n\n// Check at least one document identifier is present and valid\nconst hasDocumentField =\n    (typeof input.documentInBase64 === \"string\" && input.documentInBase64.trim() !== \"\") ||\n    (typeof input.documentLink === \"string\" && input.documentLink.trim() !== \"\") ||\n    (typeof input.documentId === \"string\" && input.documentId.trim() !== \"\") ||\n    (typeof input.documentId === \"number\");\n\nif (!hasDocumentField) {\n    missingFields.push(\"one of: documentInBase64, documentLink, documentId\");\n}\n\nif (missingFields.length) {\n    return {\n        status: \"ERROR\",\n        error: {\n            stage: \"Input Validation\",\n            code: \"MISSING_REQUIRED_FIELDS\",\n            message: `Missing or invalid fields: ${missingFields.join(\", \")}`\n        }\n    };\n}\n\n// 4. Build payload (exclude 'status', add 'direction', add 'additionalDetails' only if present)\nconst payload = {};\nObject.keys(input).forEach(key => {\n    if (key !== \"status\" && (key !== \"additionalDetails\")) {\n        payload[key] = input[key];\n    }\n});\npayload.direction = payload.direction || \"ORA_INBOUND\";\nif (input.hasOwnProperty(\"additionalDetails\")) {\n    payload.additionalDetails = input.additionalDetails;\n}\n\nresult = { payload };\n\n// 5. Return result\nreturn result;"
          },
          "outcomes": {
            "success": "1767333979994"
          },
          "code": "FIN_FUN_CODE_INPUT_PAYLOAD_VALIDATOR",
          "id": "1767332335775",
