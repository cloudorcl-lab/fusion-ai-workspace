        {
          "metadata": {
            "name": "Return Validation Error",
            "returnType": "object",
            "sourceCode": "// Read validator output\nvar validationResult =\n    $context.$nodes.FIN_FUN_CODE_INPUT_PAYLOAD_VALIDATOR &&\n    $context.$nodes.FIN_FUN_CODE_INPUT_PAYLOAD_VALIDATOR.$output &&\n    $context.$nodes.FIN_FUN_CODE_INPUT_PAYLOAD_VALIDATOR.$output.result\n        ? $context.$nodes.FIN_FUN_CODE_INPUT_PAYLOAD_VALIDATOR.$output.result\n        : null;\n\n// Use standard error message\nvar agentErrorMessage = \"Doc IO Inbound Document Transformer Agent execution failed.\";\n// Fallback generic error if validator returned nothing\nif (!validationResult) {\n    validationResult = {\n        status: \"ERROR\",\n        error: {\n            stage: \"Agent Execution\",\n            code: \"AGENT_EXECUTION_FAILED\",\n            message: agentErrorMessage\n        }\n    };\n}\n\n// Return error response\nvalidationResult;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "FIN_FUN_CODE_RETURN_VALIDATION_ERROR",
          "id": "1767334300369",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Extract Transformed Data",
            "returnType": "object",
            "sourceCode": "// APPLY TRANSFORMATION OUTPUT CHECKER\nvar node = $context.$nodes.FIN_FUN_BOF_APPLY_TRANSFORMATION;\nvar nodeStatus = node && typeof node.$status === \"string\" ? node.$status.trim().toUpperCase() : null;\nvar nodeOutput = node ? node.$output : null;\nvar result = null;\n\n// 1. NODE EXECUTION FAILURE\nif (nodeStatus === \"FAILURE\") {\n    var errorInfo = node.$error;\n    var errorMessage = \"Apply Transformation execution failed.\";\n    var errorCode = \"EXECUTION_ERROR\";\n    if (errorInfo && typeof errorInfo === \"object\") {\n        if (typeof errorInfo.$info === \"string\" && errorInfo.$info.trim()) {\n            errorMessage = errorInfo.$info;\n        } else if (typeof errorInfo.message === \"string\" && errorInfo.message.trim()) {\n            errorMessage = errorInfo.message;\n        } else if (typeof errorInfo.error === \"string\" && errorInfo.error.trim()) {\n            errorMessage = errorInfo.error;\n        }\n        if (errorInfo.code) {\n            errorCode = errorInfo.code;\n        }\n    }\n    result = {\n        status: \"ERROR\",\n        error: {\n            stage: \"Apply Transformation\",\n            code: errorCode,\n            message: errorMessage\n        }\n    };\n}\n// 2. MALFORMED OR MISSING RESPONSE\nelse if (!nodeOutput || typeof nodeOutput !== \"object\") {\n    result = {\n        status: \"ERROR\",\n        error: {\n            stage: \"Apply Transformation\",\n            code: \"MALFORMED_TOOL_RESPONSE\",\n            message: \"Apply Transformation response is missing or invalid.\"\n        }\n    };\n}\n// 3. FAILURE STATUS FROM NODE OUTPUT\nelse if (nodeOutput.status && String(nodeOutput.status).trim().toUpperCase() !== \"SUCCESS\") {\n    result = {\n        status: \"ERROR\",\n        error: {\n            stage: \"Apply Transformation\",\n            code: \"EXECUTION_ERROR\",\n            message: \"Apply Transformation returned failure status.\"\n        }\n    };\n}\n// 4. SUCCESS PASS THROUGH AS-IS\nelse {\n    result = nodeOutput;\n}\n\nresult;"
          },
