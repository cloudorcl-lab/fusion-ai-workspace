{
  "workflowId": "300000331064126",
  "workflowCode": "ORA_COST_PROCESSOR_ERROR_RESOLUTION_ADVISOR",
  "name": "Cost Processor Error Resolution Advisor",
  "description": "This AI agent intelligently recommends resolution steps for pre-processor, cost processor, and COGS-related errors.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
