        {
          "metadata": {
            "name": "Generate Expense Query",
            "returnType": "string",
            "sourceCode": "let personId = $context.$variables.context?.personId \nlet expenseQuery = $context.$nodes.EXPENSE_INQUIRY_ROUTER.$output?.expenseQuery;\n\nconst normalizedPersonId = personId == null\n  ? \"\"\n  : String(personId).trim().replace(/^\"+|\"+$/g, \"\");\n\nlet updatedExpenseQuery = typeof expenseQuery === \"string\"\n  ? expenseQuery.replace(/\\{personId\\}/g, normalizedPersonId)\n  : \"\";\n\n\nif (expenseQuery === \"\" && !expenseQuery.includes(\"merchantName\") && !expenseQuery.includes(\"expenseType\") && !expenseQuery.includes(\"receiptAmount\") && !expenseQuery.includes(\"expenseDate\")){\n updatedExpenseQuery = \"$filter=(person[id=-1])\";\n}\n\nreturn updatedExpenseQuery;"
          },
          "outcomes": {
            "success": "1773355818530"
          },
          "code": "GENERATE_EXPENSE_QUERY",
          "id": "1773355771351",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
