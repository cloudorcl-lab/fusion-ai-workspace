              "id": "1773339912936_1",
              "name": "prompt",
              "type": "string",
              "value": "User message: {{$context.$system.$inputMessage}}\nImmediately preceding assistant message: Extract the last AI response from the {{$context.$system.$chatHistory}}\nIngress point: {{$context.$variables.context.ingressPoint}}\nObject id in context: {{$context.$variables.objectIdInContext}}\nWebhook Object Id: {{$context.$triggers.REST.$input.objectId}}\nEnabled features: {{$context.$variables.context.features}}\n\n{{$context.$nodes.EXTRACT_AGENT_PROMPT.$output.result.mainPrompt}}"
            }
          ],
          "outputSpecification": "{{$context.$nodes.EXTRACT_AGENT_PROMPT.$output.result.summarizerPrompt}}",
          "type": "LLM"
        },
