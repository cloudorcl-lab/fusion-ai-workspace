        {
          "metadata": {
            "name": "APPEND CANVAS CONTENT",
            "returnType": "object",
            "sourceCode": "const rawOutput = $context.$nodes.FORMAT_PC_OUTPUT.$output;\nconst canvasContent = $context.$variables.canvasContent;\n\nfunction normalizeCanvasContent(value) {\n  if (value && typeof value === \"object\" && !Array.isArray(value)) return value;\n  if (typeof value === \"string\" && value.trim().startsWith(\"{\")) {\n    try {\n      const parsed = JSON.parse(value);\n      if (parsed && typeof parsed === \"object\" && !Array.isArray(parsed)) return parsed;\n    } catch (_) {}\n  }\n  return { expenseId: \"\", updatedFields: [] };\n}\n\nfunction markCanvasIfResolved(canvas, responses) {\n  if (!canvas || typeof canvas !== \"object\") return canvas;\n\n  const updatedArray = Array.isArray(canvas.updatedFields)\n    ? canvas.updatedFields\n    : [];\n\n  const textBlocks = Array.isArray(responses)\n    ? responses.filter(block => block && block.display_type === \"text\")\n    : [];\n\n  const shouldMarkUpdated = textBlocks.some(block => {\n    const text = typeof block?.text === \"string\" ? block.text.toLowerCase() : \"\";\n    if (!text) return false;\n    return (\n      text.includes(\"expense is ready for submission\") ||\n      text.includes(\"no open issues\") ||\n      text.includes(\"updated\")\n    );\n  });\n\n  if (shouldMarkUpdated) {\n    const existing = updatedArray.find(\n      entry =>\n        entry &&\n        typeof entry.field === \"string\" &&\n        entry.field.toLowerCase() === \"updated\"\n    );\n    if (existing) {\n      existing.value = true;\n      existing.status = existing.status || \"SUCCESS\";\n      existing.source = existing.source || \"system\";\n    } else {\n      updatedArray.push({\n        field: \"Updated\",\n        value: true,\n        source: \"system\",\n        status: \"SUCCESS\"\n      });\n    }\n  }\n\n  canvas.updatedFields = updatedArray;\n  return canvas;\n}\n\nlet parsedOutput;\nif (typeof rawOutput === \"string\" && rawOutput.trim().startsWith(\"{\")) {\n  try {\n    parsedOutput = JSON.parse(rawOutput);\n  } catch (_) {\n    parsedOutput = {};\n  }\n} else if (rawOutput && typeof rawOutput === \"object\") {\n  parsedOutput = rawOutput;\n} else {\n  parsedOutput = {};\n}\n\nif (!Array.isArray(parsedOutput.agent_response)) {\n  parsedOutput.agent_response = [];\n}\n\nconst resolvedCanvas = markCanvasIfResolved(\n  normalizeCanvasContent(canvasContent),\n  parsedOutput.agent_response\n);\n\nconst canvasBlock = parsedOutput.agent_response.find(\n  block => block && block.display_type === \"canvas\"\n);\n\nif (canvasBlock) {\n  canvasBlock.canvas_content = resolvedCanvas;\n} else {\n  parsedOutput.agent_response.push({\n    display_type: \"canvas\",\n    display_sequence: parsedOutput.agent_response.length + 1,\n    canvas_content: resolvedCanvas\n  });\n}\n\nreturn parsedOutput;"
          },
