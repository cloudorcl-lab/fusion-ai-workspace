              "type": "string"
            },
            {
              "id": "1778047459274_7",
              "name": "userMessage",
              "type": "string",
              "value": "{{$context.$system.$inputMessage}}"
            },
            {
              "id": "1778047459278_8",
              "name": "preparerId",
              "type": "string"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
        },
        {
          "metadata": {
            "name": "Extract Updated Fields",
            "returnType": "object",
            "sourceCode": "// ── helpers ──────────────────────────────────────────────────────────────\nfunction safeStr(v) {\n  if (v === null || v === undefined) return \"\";\n  return String(v).trim();\n}\n\nfunction friendlyField(raw) {\n  if (!raw) return \"\";\n  const key = safeStr(raw).toLowerCase().replace(/[\\s_-]+/g, \"\");\n  const map = {\n    merchantname: \"Merchant name\",\n    expensetype: \"Expense type\",\n    startdate: \"Date\",\n    enddate: \"Date\",\n    expensedate: \"Date\",\n    receiptamount: \"Receipt amount\",\n    receiptcurrency: \"Currency\",\n    currencycode: \"Currency\",\n    costcenter: \"Cost center\",\n    projectnumber: \"Project number\",\n    tasknumber: \"Task number\",\n    justification: \"Justification\",\n    receiptmissingjustification: \"Justification\",\n    description: \"Description\",\n    location: \"Location\",\n    attendees: \"Attendees\",\n    receipt: \"Receipt\",\n    numberofnights: \"Number of nights\",\n    numberofattendees: \"Number of attendees\",\n    billedamount: \"Billed amount\",\n    receiptdate: \"Receipt date\",\n    expensereportname: \"Expense report name\"\n  };\n  return map[key] || raw;\n}\n\nfunction normalizeField(raw) {\n  if (!raw) return \"\";\n  let trimmed = safeStr(raw).replace(/\\b(has|was)\\s+(been|set|updated)\\b.*$/i, \"\").trim();\n  if (!trimmed) trimmed = safeStr(raw);\n  return friendlyField(trimmed);\n}\n\n// ── 1. Pull raw compliance output safely ──────────────────────────────────\nconst rawPcOutput = $context.$nodes.POLICY_COMPLIANCE?.$output?.output;\nconst pcOutputRaw = typeof rawPcOutput === \"string\" ? safeStr(rawPcOutput) : \"\";\n\n// ── 2. Expense id (stringify numbers) ─────────────────────────────────────\nconst expenseId = safeStr($context.$variables.objectIdInContext);\n\n// ── 3. Parse structured payload if available ─────────────────────────────\nconst updatedFields = [];\nlet pcOutput = {};\ntry {\n  pcOutput = pcOutputRaw.startsWith(\"{\")\n    ? JSON.parse(pcOutputRaw)\n    : (rawPcOutput && typeof rawPcOutput === \"object\" ? rawPcOutput : {});\n} catch (e) {\n  pcOutput = rawPcOutput && typeof rawPcOutput === \"object\" ? rawPcOutput : {};\n}\n\n// ── 4. acknowledgements / defaults ───────────────────────────────────────\nconst ackData = pcOutput?.summarizedData?.acknowledgements?.data\n             || pcOutput?.acknowledgements\n             || [];\nif (Array.isArray(ackData)) {\n  for (const item of ackData) {\n    const field = normalizeField(item?.fieldName || item?.field || item?.attributeName || \"\");\n    const value = safeStr(item?.fieldValue ?? item?.value ?? item?.attributeValue ?? \"\");\n    if (field && value) {\n      updatedFields.push({ field, value, source: \"acknowledgement\", status: \"SUCCESS\" });\n    }\n  }\n}\n\nconst defaultsData = pcOutput?.summarizedData?.defaults?.data\n                  || pcOutput?.defaults\n                  || [];\nif (Array.isArray(defaultsData)) {\n  for (const item of defaultsData) {\n    const field = normalizeField(item?.fieldName || item?.field || item?.attributeName || \"\");\n    const value = safeStr(item?.fieldValue ?? item?.value ?? item?.attributeValue ?? \"\");\n    if (field && value) {\n      updatedFields.push({ field, value, source: \"default\", status: \"SUCCESS\" });\n    }\n  }\n}\n\n// ── 5. Narrative extraction (always allowed now) ──────────────────────────\nconst narrativeText =\n  pcOutputRaw ||\n  safeStr(pcOutput?.output || pcOutput?.summary || pcOutput?.message || pcOutput?.text || \"\");\n\nif (narrativeText.length > 0) {\n  const patterns = [\n    /(\\w[\\w\\s]*?)\\s+has been updated to\\s+(.+?)(?:\\.|,|$)/gi,\n    /(\\w[\\w\\s]*?)\\s+has been set to\\s+(.+?)(?:\\.|,|$)/gi,\n    /(\\w[\\w\\s]*?)\\s+was updated to\\s+(.+?)(?:\\.|,|$)/gi,\n    /(\\w[\\w\\s]*?)\\s+was set to\\s+(.+?)(?:\\.|,|$)/gi,\n    /(\\w[\\w\\s]*?)\\s+updated to\\s+(.+?)(?:\\.|,|$)/gi,\n    /(\\w[\\w\\s]*?)\\s+set to\\s+(.+?)(?:\\.|,|$)/gi,\n    /(\\w[\\w\\s]*?)\\s+changed to\\s+(.+?)(?:\\.|,|$)/gi,\n    /updated\\s+(\\w[\\w\\s]*?)\\s+to\\s+(.+?)(?:\\.|,|$)/gi,\n    /(\\w[\\w\\s]*?)\\s+is now\\s+(.+?)(?:\\.|,|$)/gi\n  ];\n\n  for (const pattern of patterns) {\n    let match;\n    while ((match = pattern.exec(narrativeText)) !== null) {\n      const field = normalizeField(match[1]);\n      const value = safeStr(match[2]);\n      if (!field || !value) continue;\n      updatedFields.push({ field, value, source: \"narrative\", status: \"SUCCESS\" });\n    }\n  }\n}\n\n// ── 6. Tool-call fallback (if the platform exposes nodes) ─────────────────\nconst pcNodes = $context.$nodes.POLICY_COMPLIANCE?.$output?.nodes ?? [];\nconst UPDATE_KEYWORDS = [\"update\", \"patch\", \"add\", \"delete\", \"remove\", \"set\", \"attach\", \"upload\"];\nconst SKIP_KEYS = new Set([\n  \"expenseid\",\n  \"id\",\n  \"partnerexpenseid\",\n  \"preparerid\",\n  \"personid\",\n  \"etag\",\n  \"channel\",\n  \"mode\",\n  \"isreplyflow\",\n  \"message\",\n  \"userinputmessage\",\n  \"usermessage\"\n]);\n\nfunction isUpdateTool(name) {\n  const lower = (name || \"\").toLowerCase();\n  if (lower.includes(\"get\") || lower.includes(\"fetch\") || lower.includes(\"search\") ||\n      lower.includes(\"read\") || lower.includes(\"list\") || lower.includes(\"check\")) return false;\n  return UPDATE_KEYWORDS.some(k => lower.includes(k));\n}\n\nfor (const node of pcNodes) {\n  const toolName = node.toolName || node.name || node.code || \"\";\n  if (!isUpdateTool(toolName)) continue;\n  const nodeStatus = safeStr(node.output?.status || node.status || \"SUCCESS\").toUpperCase();\n  if (nodeStatus === \"ERROR\" || nodeStatus === \"FAILURE\" || nodeStatus === \"FAILED\") continue;\n\n  const inp = node.input || node.inputs || {};\n  if (inp.field !== undefined && inp.value !== undefined) {\n    updatedFields.push({\n      field: normalizeField(safeStr(inp.field)),\n      value: safeStr(inp.value),\n      source: \"tool\",\n      status: nodeStatus\n    });\n    continue;\n  }\n  if (inp.attributeName !== undefined && inp.attributeValue !== undefined) {\n    updatedFields.push({\n      field: normalizeField(safeStr(inp.attributeName)),\n      value: safeStr(inp.attributeValue),\n      source: \"tool\",\n      status: nodeStatus\n    });\n    continue;\n  }\n  for (const [k, v] of Object.entries(inp)) {\n    if (SKIP_KEYS.has(k.toLowerCase())) continue;\n    if (v === null || v === undefined || v === \"\") continue;\n    updatedFields.push({\n      field: friendlyField(k),\n      value: safeStr(v),\n      source: \"tool\",\n      status: nodeStatus\n    });\n  }\n}\n\n// ── 7. Merge with previous turn (newest wins) ─────────────────────────────\nlet prevFields = [];\ntry {\n  const prev = $context.$variables.canvasContent;\n  const parsed = prev && typeof prev === \"object\" ? prev\n               : (typeof prev === \"string\" && prev ? JSON.parse(prev) : null);\n  if (Array.isArray(parsed?.updatedFields)) prevFields = parsed.updatedFields;\n} catch (e) {}\n\nconst fieldMap = new Map();\nfor (const f of [...prevFields, ...updatedFields]) {\n  if (!f || !f.field) continue;\n  fieldMap.set(f.field.toLowerCase(), { ...f });\n}\nconst mergedFields = Array.from(fieldMap.values());\n\n// ── 8. Build outputs (object + JSON literal for the LLM prompt) ───────────\nconst canvasContent = {\n  expenseId: expenseId,\n  updatedFields: mergedFields\n};\n\nconst canvasContentLiteral = JSON.stringify(canvasContent);\n\nreturn {\n  canvasContent,\n  canvasContentLiteral\n};"
          },
          "outcomes": {
            "success": "persist_canvas_content"
          },
          "code": "EXTRACT_UPDATED_FIELDS",
          "id": "extract_updated_fields",
          "inputs": [],
          "outputSpecification": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"result\": {\"type\": \"object\"}, \"timeout\": {\"type\": \"boolean\"}, \"error\": {\"type\": \"string\"}}, \"required\": [\"output\", \"timeout\", \"error\"]}",
          "type": "CODE"
        },
        {
