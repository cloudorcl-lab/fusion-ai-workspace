  "name": "Expense Assistant",
  "description": "This workflow dynamically directs users to either the Expense Policy Inquiry Assistant or the Expense Policy Compliance Assistant based on the user's intent identified in the chat.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
