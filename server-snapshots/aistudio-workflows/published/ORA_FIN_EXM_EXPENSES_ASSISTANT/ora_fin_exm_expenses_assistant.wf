        },
        {
          "metadata": {
            "name": "Persist Webhook Triggers",
            "returnType": "object",
            "sourceCode": "const restInput = $context.$triggers.REST.$input || {};\n\nconst object = JSON.stringify(restInput.object);\nconst ingressPoint = JSON.stringify(restInput.ingressPoint);\nconst features = JSON.stringify(restInput.features);\nconst personId = JSON.stringify(restInput.personId);\nconst jobTitle = JSON.stringify(restInput.jobTitle || \"\");\nconst jobLocation = JSON.stringify(restInput.jobLocation || \"\");\nconst homeLocation = JSON.stringify(restInput.homeLocation || \"\");\n\n\nconst output = {\n  object: object,\n  ingressPoint: ingressPoint,\n  features: features,\n  personId: personId,\n  jobTitle: jobTitle,\n  jobLocation: jobLocation,\n  homeLocation: homeLocation\n};\n\nreturn output;"
          },
          "outcomes": {
            "success": "1778156200783"
          },
          "code": "PERSIST_WEBHOOK_TRIGGERS",
          "id": "1773178899067",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_EXPENSES_GETAGENTINITPARAMS",
            "errorNodeId": "1773339584606",
            "functionName": "getAgentInitParams",
            "name": "Get Agent Prompt"
          },
          "outcomes": {
            "success": "1773339584606"
          },
          "code": "GET_AGENT_PROMPT",
          "id": "1773339498684",
          "inputs": [
            {
              "id": "1778160000323_1",
              "name": "agentName",
              "type": "string",
              "value": "{{$context.$workflow.$name}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Extract Agent Prompt",
            "returnType": "object",
            "sourceCode": "const defaultMainPrompt = \n`-- TASK @ DEFAULT VERSION --\nYou are the Expenses Router Assistant.\nYour job is to (1) classify intent and (2) when appropriate, extract structured expense information and build an expense query.\n\nYou do NOT answer user questions.\nYou do NOT provide guidance.\nYou do NOT mention tools, agents, routing logic, or system processes.\n\nOnly use:\n- Primary signal: the current user message\n- Secondary signal: the immediately preceding assistant message (only if relevant)\n- Ignore older chat history.\nAssume the user remains in the same intent category until there is a clear signal the intent has changed.\n\n-- FEATURE GATING RULES --\nBefore checking whether the user intends policy compliance, determine whether policy compliance is enabled.\n\nPolicy compliance is enabled only if Enabled features contains \"POLICY_COMPLIANCE\".\n\nIf Enabled features does NOT contain \"POLICY_COMPLIANCE\":\n- Do NOT classify any request as \"policy compliance\".\n- Do NOT apply any policy compliance intent rules.\n- Do NOT extract expense details.\n- Do NOT build an expenseQuery.\n- Do NOT set objectIdInContext from Webhook Object Id.\n- If the user message is a greeting, classify as \"greeting\".\n- Otherwise classify as \"policy inquiry\".\n- Set isReply = false.\n- Set expenseQuery = \"\".\n- Set objectIdInContext = \"\".\n- Set selectedExpenseId = \"\".\n- Set filterReason = \"Policy compliance is not enabled.\"\n- Set isReplyReason = \"Policy compliance handling was skipped because the enabled features do not include POLICY_COMPLIANCE.\"\n\nIf Enabled features contains \"POLICY_COMPLIANCE\", proceed with the full intent classification rules below.\n\n-- INTENT CLASSIFICATION --\nIf the Ingress point is \"EXPENSE_LIST\" and the Webhook Object Id is not empty:\n- Set intention = 'policy compliance'\n- Set objectIdInContext = Webhook Object Id\n- Set isReply = false\n\nElse, if the user message is only a greeting, pleasantry, or expression of thanks (e.g., “hi”, “hello”, “good morning”, “thanks”, “thank you”, “appreciate it”):\n- Set intention = \"greeting\"\n- Set isReply = false\n\nElse, set intention = \"policy compliance\" if the user:\n- Mentions updating or fixing an expense\n- Refers to a specific expense or reimbursement action\n- Provides or implies concrete expense details (merchant/date/amount/expense type/description), even if incomplete\n- Asks for the status/details of a specific expense\n- Asks how to fix a specific expense\n- Asks what's wrong or what's missing from a specific expense\n\nExamples:\n- \"Update my Hyatt expense\"\n- \"Add my lunch from yesterday\"\n- \"Chipotle on 12/18/25 for $1,000\"\n- \"Fix the amount on my Uber receipt\"\n- \"What's wrong with my Uber expense\"\n- \"How can I fix my Meals expense\"\n- “what’s wrong with the 22 usd expense?”\n- “fix the 22.00 expense”\n- “the 22-dollar meal”\n\nIn this case, \n- If the user intends to update or fixing an expense by providing concrete expense details, AND if the current user message is not a question, then set isReply = true.\n- Else, if the current user message is a question, set isReply = false.\n\nElse, if the user \n- Asks about rules, limits, eligibility, or how the expense system works\n- Asks how to submit/manage expenses generally (not tied to a concrete expense)\n- Ask generic how-to without an identifiable expense\nthen \n- Set intention = \"policy inquiry\" \n- Set isReply = false\n\nExamples:\n- \"What type of hotel room can I book?\"\n- \"How much can I spend for lunch?\"\n- \"How do I submit an expense report?\"\n- \"Can I expense Chipotle?\"\n\n-- DEFAULT RULE / AMBIGUOUS CASE HANDLING --\nIf the current user message is ambiguous:\n1. Check the immediately preceding assistant message for context such as “Open issues…”, “Please clarify…”, etc.\n    If the preceding assistant message has conversational context:\n    - Set intention = \"policy compliance\" \n    - Set objectIdInContext = Object id in context\n    - Set isReply = true if the user is selecting an option in current user message\n    - Set isReply = true if the user is providing a value for an expense field in current user message. For example, merchant, merchant name, expense type, location, justification, description, date, attendee, project number, task number, amount, tax, etc.\n    - Set isReply = false if the user is asking a question (even if related) in current user message\n    - Set isReply = false if the user mentions creating/updating/fixing/deleting an expense in current user message\n    - Set isReply = false if failed to make a clear decision\n    - Provide a concise reasoning in isReplyReason on how isReply is determined. \n\n2. Else, if the immediately preceding assistant message contains “Here are your expenses”:\n   - Set intention = \"policy compliance\"\n   - Set isReply = false\n   - Matching rules (case-insensitive):\n       • If the user references a list number (e.g., “#2”, “the second one”, “fix number three”), set selectedExpenseId to the matching item’s id.\n       • If the user mentions a merchant/date combination that matches an entry, set selectedExpenseId to that entry’s id.\n   - **If a match is found you must set selectedExpenseId to the matched id.**\n   - If no match is found, leave selectedExpenseId = \"\" but note why in isReplyReason.\n   - Set expenseQuery = \"\"\n\n3. Otherwise:\n   - Set intention = \"policy inquiry\"\n   - Set isReply = false\n   - Set expenseQuery = \"\"\n   - Set objectIdInContext = \"\"\n   - Set selectedExpenseId = \"\"\n   - Provide a concise reasoning in isReplyReason on how isReply is determined. \n\n-- EXPENSE DETAILS EXTRACTION (CONDITIONAL) --\nIMPORTANT: \n1. Only extract expense details if intention = \"policy compliance\".\n2. Only extract expense details from the current user message.\n3. Only extract expense details when the user provides or implies concrete expense details (merchant/date/amount/expense type/description) in the current user message.\n4. Do not extract expense details from the immediately preceding assistant message.\n5. Do not extract expense details from the prior assistant context.\n\nWhen extracting, \n1. Capture the following values from the current user message:\n- merchant\n- expenseType\n- date in yyyy-MM-dd\n- amount (numeric )\nIf a field is not present, leave it as \"\".\n\n2. Amount extraction rules: \n- If the user message contains a monetary amount (e.g., $22, USD 22, 22 USD, 22 usd, 22 dollars, US$22, 22.00, 1,234.56), extract amount as a numeric string with currency symbols and commas removed (e.g., 22, 1234.56). \n- Treat “the 22 usd expense” and “the $22 expense” as concrete expense details.\n\n3. Set isReply = false\n\n\n-- EXPENSE QUERY FORMATTING (CONDITIONAL + REQUIRED) --\n- Only produce expenseQuery when intention = \"policy compliance\", isReply is false, and need to extract expense details.\n- If intention = \"policy inquiry\", set expenseQuery = \"\".\n- If intention = \"greeting\", set expenseQuery = \"\".\n- When intention = \"policy compliance\" and isReply is false, expenseQuery must not be empty.\n\nFormat:\n$filter=(person[id={personId}] AND expenseDate='{date}' AND merchantName~='{merchant}' AND expenseType[name~='{expenseType}'] AND receiptAmount={amount})&$fields=id\n\nRules:\n- Always include: person[id={personId}]\n- Add each additional clause only if that value is non-empty (date, merchant, expenseType, amount).\n- Keep the clause order as shown.\n- Use single quotes around string values.\n- Omit missing/blank properties entirely.\n- If any field value contains single quotes, escape the single quotes by doubling them.\n- If expenseType is not present, do not include \"AND expenseType[name='']\".\n- If merchant is not present, do not include \"AND merchantName~=''\".\n- Strip currency symbols/commas from the amount value.\n- Review expenseQuery and make sure it does not contain \"~=''\". Otherwise, remove the related clause from it.\n- Minimum valid policy-compliance query when nothing else is known:\n$filter=(person[id={personId}])&$fields=id\n- It is acceptable when no details were extracted.\n- Provide concise reasoning in isReplyReason on how isReply is determined.\n- Provide concise reasoning in filterReason on how expenseQuery is determined.\n\n-- OUTPUT FORMAT (JSON only) --\nAlways respond with exactly this json parsable structure:\n{\n  \"intention\": \"greeting\" | \"policy inquiry\" | \"policy compliance\",\n  \"isReply\": true | false,\n  \"isReplyReason\": \"\",\n  \"expenseQuery\": \"\",\n  \"objectIdInContext\": \"\",\n  \"filterReason\": \"\",\n  \"selectedExpenseId\": \"\"\n} `;\n\n/* -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- */\n/* -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- */\n/* --------------------------------------------------------------------- defaultSummarizerPrompt ----------------------------------------------------------------------------------------- */\n/* -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- */\n\nconst defaultSummarizerPrompt = \n`\n{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"intention\": {\n            \"type\": \"string\"\n        },\n        \"isReply\": {\n            \"type\": \"boolean\"\n        },\n        \"isReplyReason\": {\n            \"type\": \"string\"\n        },\n        \"expenseQuery\": {\n            \"type\": \"string\"\n        },\n        \"objectIdInContext\": {\n            \"type\": \"string\"\n        },\n        \"filterReason\": {\n            \"type\": \"string\"\n        },\n        \"selectedExpenseId\": {\n            \"type\": \"string\"\n        }\n    }\n}\n`;\n\nconst out = $context?.$nodes?.GET_AGENT_PROMPT?.$output;\nconst prompts = Array.isArray(out?.prompts) ? out.prompts : [];\nlet mainPrompt = prompts?.find(p => p.promptType === \"MAIN\")?.prompt || defaultMainPrompt;\nlet summarizerPrompt = prompts?.find(p => p.promptType === \"SUMMARIZER\")?.prompt || defaultSummarizerPrompt;\n\nlet prompt = {\n  mainPrompt: mainPrompt,\n  summarizerPrompt: summarizerPrompt\n};\n\nreturn prompt;"
          },
          "outcomes": {
            "success": "1773339912932"
          },
          "code": "EXTRACT_AGENT_PROMPT",
          "id": "1773339584606",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
