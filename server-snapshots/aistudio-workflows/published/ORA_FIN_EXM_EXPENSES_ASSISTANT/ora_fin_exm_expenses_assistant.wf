        {
          "metadata": {
            "name": "APPEND_UNSUBMITTED_LIST",
            "returnType": "object",
            "sourceCode": "const appendSource = $context.$nodes.APPEND_CANVAS_CONTENT?.$output;\nconst unsubmittedSource = $context.$variables.unsubmittedExpenseList;\n\nfunction parseObject(value) {\n  if (value && typeof value === \"object\") return value;\n  if (typeof value === \"string\" && value.trim().startsWith(\"{\")) {\n    try {\n      return JSON.parse(value);\n    } catch (_) {}\n  }\n  return {};\n}\n\nlet payload = parseObject(appendSource);\nif (payload?.result) payload = payload.result;\nif (payload?.result) payload = payload.result;\nif (!payload || typeof payload !== \"object\") {\n  payload = {};\n}\n\nif (!Array.isArray(payload.agent_response)) {\n  payload.agent_response = [];\n}\n\nconst validationStatusCode =\n  $context.$nodes.GET_VALIDATION_STATUS_CODE?.$output?.validationStatusCode;\n\nconst textBlock = payload.agent_response.find(\n  block => block?.display_type === \"text\"\n);\n\nconst responseText =\n  typeof textBlock?.text === \"string\" ? textBlock.text.toLowerCase() : \"\";\n\nconst isClean = validationStatusCode === \"CLEAN\";\nconst isReadyForSubmission = responseText.includes(\n  \"expense is ready for submission\"\n);\n\n// Do not add display_sequence 3 unless expense is clean and response says ready.\nif (!isClean || !isReadyForSubmission) {\n  return payload;\n}\n\nconst unsubmittedPayload = parseObject(unsubmittedSource);\nconst expenses = Array.isArray(unsubmittedPayload?.unsubmittedExpenses)\n  ? unsubmittedPayload.unsubmittedExpenses\n  : [];\n\nconst nextSequence =\n  payload.agent_response.reduce((max, block) => {\n    const seq = Number(block?.display_sequence);\n    return Number.isFinite(seq) && seq > max ? seq : max;\n  }, 0) + 1;\n\nconst items = expenses.length > 0\n  ? expenses.map((item, index) => {\n      const merchant = item?.merchant || \"Merchant not provided\";\n      const date = item?.expenseDate ? ` on {date:${item.expenseDate}}` : \"\";\n      const type = item?.expenseTypeName || \"Expense\";\n\n      const hasAmount =\n        item?.receiptAmount &&\n        item.receiptAmount.value !== null &&\n        item.receiptAmount.value !== undefined &&\n        item.receiptAmount.value !== \"\";\n\n      const amount = hasAmount\n        ? ` - {amount:${item.receiptAmount.value},currency:${item.receiptAmount.currency || \"USD\"}}`\n        : \"\";\n\n      return {\n        id: String(item?.id ?? \"\"),\n        Default: `${index + 1}. `,\n        value: `${merchant}${date} for ${type}${amount}`\n      };\n    })\n  : [\n      {\n        id: \"\",\n        Default: \"1. \",\n        value: \"You have no unsubmitted expenses right now.\"\n      }\n    ];\n\npayload.agent_response.push({\n  display_type: \"list\",\n  display_sequence: nextSequence,\n  header: \"Here are your expenses\",\n  fields: {\n    items\n  },\n  selection_mode: expenses.length > 0 ? \"single\" : \"none\",\n  keyAttributes: {\n    items: [\"id\"]\n  },\n  accessibility: {\n    \"aria-label\": \"Unsubmitted expenses list\"\n  }\n});\n\nreturn payload;"
          },
