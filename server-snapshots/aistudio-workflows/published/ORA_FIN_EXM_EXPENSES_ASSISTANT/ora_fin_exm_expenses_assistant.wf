        {
          "metadata": {
            "name": "Format Payload",
            "returnType": "object",
            "sourceCode": "const boOutput = $context.$nodes.FETCH_UNSUBMITTED_EXPENSES_BO.$output ?? {};\n\nconst rawExpenses =\n  Array.isArray(boOutput?.items) ? boOutput.items :\n  Array.isArray(boOutput?.result?.items) ? boOutput.result.items :\n  Array.isArray(boOutput?.output?.items) ? boOutput.output.items :\n  Array.isArray(boOutput) ? boOutput :\n  [];\n\nconst formattedExpenses = rawExpenses.map((item = {}) => ({\n  id: item.id ?? \"\",\n  merchant: item.merchantName ?? \"Unknown Merchant\",\n  expenseDate: item.expenseDate ?? \"\",\n  expenseTypeName: item.expenseType?.name ?? \"Expense\",\n  receiptAmount:\n    item.receiptAmount !== null && item.receiptAmount !== undefined\n      ? {\n          value: Number(item.receiptAmount),\n          currency: item.receiptCurrency?.currencyCode ?? \"USD\"\n        }\n      : null\n}));\n\nreturn { unsubmittedExpenses: formattedExpenses };"
          },
          "outcomes": {
            "success": "1774596133542"
          },
          "code": "FORMAT_PAYLOAD",
          "id": "1774596078713",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
