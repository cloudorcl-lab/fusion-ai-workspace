            "name": "Transform Output For Amount",
            "returnType": "object",
            "sourceCode": "var supplierFlag = $context.$nodes.GETINTAKEREQUESTLINE.$output.items[0].NewSupplierFlag == true;\nvar reqHeaderId = \"\";\nvar reqNumber = \"\";\nvar output = {};\nif(supplierFlag){\noutput[\"RequisitionHeaderId\"] = $context.$nodes.CREATEREQUISITIONV1.$output.RequisitionHeaderId;\noutput[\"Requisition\"] = $context.$nodes.CREATEREQUISITIONV1.$output.Requisition;\n}else{\noutput[\"RequisitionHeaderId\"] = $context.$nodes.CREATE_REQ_EXISTING_SUPPLIER_FOR_AMOUNT.$output.RequisitionHeaderId;\noutput[\"Requisition\"] = $context.$nodes.CREATE_REQ_EXISTING_SUPPLIER_FOR_AMOUNT.$output.Requisition;\n}\n\nreturn output;"
          },
