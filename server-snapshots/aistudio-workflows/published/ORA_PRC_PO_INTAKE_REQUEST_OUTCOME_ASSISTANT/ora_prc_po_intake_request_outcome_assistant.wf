            "name": "transformGETHeaderError",
            "returnType": "string",
            "sourceCode": "var raw = $context.$nodes.INTAKEREQUESTBOFUN.$error.$info || \"\";\n\n// Ensure string\nvar message = (typeof raw === \"string\") ? raw : JSON.stringify(raw);\n\n// Extract errorCode\nvar errorCode = \"\";\n\nif (message) {\n  var match = message.match(/error family\\s+([A-Z_]+)/i);\n  if (match && match[1]) {\n    errorCode = match[1].trim();\n  }\n}\n\n// ✅ Return ONLY extracted value\nerrorCode;"
          },
          "outcomes": {
            "success": "1777357353705"
          },
          "code": "TRANSFORMGETHEADERERROR",
          "id": "1777357329100",
          "inputs": [],
