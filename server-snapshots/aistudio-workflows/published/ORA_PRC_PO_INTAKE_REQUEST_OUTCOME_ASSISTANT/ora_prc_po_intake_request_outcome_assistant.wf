        {
          "metadata": {
            "name": "Transform Create Requisition For Quantity Error Code",
            "returnType": "string",
            "sourceCode": "var raw = $context.$nodes.CREATE_REQUISITION_FOR_QUANTITY.$error.$info || \n          $context.$nodes.CREATE_REQUISITION_FOR_QUANTITY.$output.Requisition;\n\n// Ensure object\nvar source = (typeof raw === \"string\") ? JSON.parse(raw) : raw;\n\n// Support both formats\nvar errorDetails = source[\"o:errorDetails\"] || \n                   (source.returnValue ? source.returnValue[\"o:errorDetails\"] : []) || [];\n\nvar result = {};\n\nfor(var i=0; i<10; i++){\nresult[\"errorCode\" + i] = null;\nresult[\"errorInfo\" + i] = null;\n}\nvar j=0;\n// Fill values (NO duplicate handling now)\nfor (var i = 0; i < errorDetails.length && i < 10; i++) {\n\n  var item = errorDetails[i];\n\n  var rawCode = item[\"o:errorCode\"];\n  var detail  = item[\"detail\"];\n\n  var errorCode = null;\n\n  // Extract code after :::\n  if (rawCode && typeof rawCode === \"string\") {\n    errorCode = rawCode.split(\":::\").pop().trim();\n  }\n\n  if(!(/^[0-9]+$/.test(errorCode))){\n     result[\"errorCode\" + j] = errorCode;\n     result[\"errorInfo\" + j] = detail ? detail : null;\n     j+=1;\n  }\n}\n\n// Final output\nJSON.stringify(result);"
          },
          "outcomes": {
            "success": "1776515841683"
          },
          "code": "TRANSFORM_CREATE_REQUISITION_FOR_QUANTITY_ERROR_CODE",
          "id": "1776515751688",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
