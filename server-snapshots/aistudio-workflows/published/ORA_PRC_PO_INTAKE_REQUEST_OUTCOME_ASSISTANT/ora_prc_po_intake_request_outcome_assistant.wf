        {
          "metadata": {
            "name": "TransformGETLineError",
            "returnType": "string",
            "sourceCode": "var raw = $context.$nodes.GETINTAKEREQUESTLINE.$error.$info || $context.$nodes.GETINTAKEREQUESTLINE.$output;\n\n// Parse input safely\nvar source;\nif (typeof raw === \"string\") {\n  source = JSON.parse(raw);\n} else {\n  source = raw || {};\n}\n\nvar seen = {};\nvar errorArray = [];\nvar errorDetails = source[\"o:errorDetails\"] || [];\n\nfor (var i = 0; i < errorDetails.length; i++) {\n  var item = errorDetails[i] || {};\n  var rawCode = item[\"o:errorCode\"];\n  var detail  = item[\"detail\"];\n  var errorCode = null;\n\n  if (rawCode && typeof rawCode === \"string\") {\n    var parts = rawCode.split(\":::\");\n    errorCode = (parts.length > 1 ? parts[1] : rawCode).trim();\n  }\n\n  var errorInfo = detail ? detail.trim() : \"\";\n\n  if (errorCode &&\n      errorCode !== \"\" &&\n      errorCode.toLowerCase() !== \"null\") {\n    var key = errorCode + \"||\" + errorInfo;\n    if (!seen[key]) {\n      seen[key] = true;\n      errorArray.push({\n        errorCode: errorCode,\n        errorInfo: errorInfo\n      });\n    }\n  }\n}\n\n// Build JSON string using single quotes as delimiters — no \\ needed\nvar errorItems = '';\nfor (var j = 0; j < errorArray.length; j++) {\n  if (j > 0) {\n    errorItems = errorItems + ',';\n  }\n  errorItems = errorItems + '{\"errorCode\":\"' + errorArray[j].errorCode + '\",\"errorInfo\":\"' + errorArray[j].errorInfo + '\"}';\n}\n\nvar output = '{\"errors\":{\"error\":[' + errorItems + ']}}';\n\nreturn output;"
          },
          "outcomes": {
            "success": "1774329286538"
          },
          "code": "TRANSFORMGETLINEERROR",
          "id": "1774522546931",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
