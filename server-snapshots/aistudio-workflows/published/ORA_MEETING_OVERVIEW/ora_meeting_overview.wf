                {
                  "metadata": {
                    "name": "Get Meeting Insights",
                    "businessObjectCode": "ORA_CX_SALESFORCE_AIOUTCOMESTORE",
                    "functionName": "getOutcomeBy_AltKey_SubType"
                  },
                  "diagram": {
