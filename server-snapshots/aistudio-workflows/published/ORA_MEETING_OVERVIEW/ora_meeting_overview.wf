                  "id": "1776024024093",
                  "code": "GET_MEETING_INSIGHTS",
                  "type": "BO_FUNCTION",
                  "inputs": [
                    {
                      "id": "1776024024093_ObjectType",
                      "name": "ObjectType",
                      "value": "ACTIVITY",
                      "required": true
                    },
                    {
                      "id": "1776024024093_ObjectAltKey",
