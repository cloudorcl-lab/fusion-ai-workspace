              "type": "string",
              "value": "{        \"op\": \"$and\",        \"criteria\": [            {                \"op\": \"$in\",                \"attribute\": \"ActivityFunctionCode\",                \"values\": [                    \"APPOINTMENT\"                ]            },            {                \"op\": \"$wi\",                \"attribute\": \"SortDate\",                \"value1\": \"now/d\",                \"value2\": \"now/d+7d\"            },            {                \"op\": \"$eq\",                \"attribute\": \"RecordSet\",                \"value\": \"RECORDS_RESOURCE\"            },            {                \"op\": \"$ne\",                \"attribute\": \"ListOfContacts\",                \"value\": \"\"            }        ]    }"
