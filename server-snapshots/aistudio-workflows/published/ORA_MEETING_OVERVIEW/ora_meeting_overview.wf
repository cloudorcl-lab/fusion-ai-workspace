        {
          "id": "1779920762667",
          "code": "SET_MEETING_OUTPUT",
          "type": "CODE",
          "metadata": {
            "name": "Set Meeting Output",
            "sourceCode": "let result = [];\ntry {\n  const meetingDetails = $context.$variables?.meetingDetails || [];\n  const currentDate = new Date($context.$system?.$currentDate || new Date().toISOString());\n\n  // Helper function to calculate difference in days between two dates\n  function diffDays(date1, date2) {\n    const utc1 = Date.UTC(date1.getFullYear(), date1.getMonth(), date1.getDate());\n    const utc2 = Date.UTC(date2.getFullYear(), date2.getMonth(), date2.getDate());\n    return Math.floor((utc2 - utc1) / (1000 * 60 * 60 * 24));\n  }\n\n  result = meetingDetails.map(meeting => {\n    const startDateStr = meeting.ActivityStartDate; // TODO: Inferred 'ActivityStartDate' from user text 'ActivityStartDate'\n    let duration = \"\";\n\n    if (startDateStr) {\n      const startDate = new Date(startDateStr);\n      const daysDiff = diffDays(currentDate, startDate);\n\n      if (daysDiff === 0) {\n        duration = \"Today\";\n      } else if (daysDiff === 1) {\n        duration = \"Tomorrow\";\n      } else if (daysDiff > 1) {\n        duration = `In ${daysDiff} days`;\n      } else {\n        // If startDate is in the past or invalid difference\n        duration = \"\";\n      }\n      if(meeting.Urgency == \"CRITICAL\"){\n        duration = \"Critical\";\n      }\n    }\n\n    return { ...meeting, duration };\n  });\n} catch (error) {\n  result = [];\n}\n\nreturn result;",
            "returnType": "array"
          },
