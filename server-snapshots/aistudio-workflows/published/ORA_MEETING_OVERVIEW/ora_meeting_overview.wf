                      "name": "OutcomeSubType",
                      "value": "STATE_SUMMARY",
                      "required": true
                    }
                  ]
                },
                {
                  "metadata": {
                    "name": "Populate Meeting Detail",
                    "sourceCode": "let result = [];\ntry {\n  const meetingRow = $context.$nodes.MEETING_LOOP.$currentItem || {};\n  const insights = $context.$nodes.MEETING_LOOP.GET_MEETING_INSIGHTS.$output?.items || [];\n  const firstInsight = insights.length > 0 ? insights[0] : null;\n  let parsedPayload = {};\n  if (firstInsight && typeof firstInsight.payload === 'string') {\n    try {\n      parsedPayload = JSON.parse(firstInsight.payload);\n    } catch (e) {\n      parsedPayload = {};\n    }\n  }\n\n  // Check for payload.what.facts.opportunityInsights and opportunityId property\n  if (\n    parsedPayload?.what?.facts?.opportunityInsights &&\n    typeof parsedPayload.what.facts.opportunityInsights.opportunityId !== 'undefined'\n  ) {\n    const oppId = parsedPayload.what.facts.opportunityInsights.opportunityId;\n    if (oppId === null || typeof oppId !== 'string' || oppId.length <= 1) {\n      parsedPayload.what.facts.opportunityInsights.opportunityId = null;\n    }\n  }\n\n  // Extract ListOfContacts array safely\n  const listOfContacts = Array.isArray(meetingRow.ListOfContacts) ? meetingRow.ListOfContacts : [];\n\n  // Extract up to first 2 ContactId.PartyName values and join as comma and space separated string\n  const contactPartiesArray = listOfContacts\n    .map(contact => {\n      // TODO: Inferred 'ContactId' from user text 'ContactId'\n      // TODO: Inferred 'PartyName' from user text 'PartyName'\n      return contact?.ContactId?.PartyName || null;\n    })\n    .filter(name => name !== null)\n    .slice(0, 2);\n\n  const contactParties = contactPartiesArray.join(\", \"); // comma and space separator\n\n  // Create consolidatedMeeting with new ContactParties property as string\n  const consolidatedMeeting = { ...meetingRow, payload: parsedPayload, ContactParties: contactParties, Urgency: firstInsight.urgency };\n\n  const currentMeetingDetails = Array.isArray($context.$variables?.meetingDetails) ? $context.$variables.meetingDetails : [];\n  result = [...currentMeetingDetails, consolidatedMeeting];\n} catch (error) {\n  result = Array.isArray($context.$variables?.meetingDetails) ? $context.meetingDetails : [];\n}\n\nreturn result;",
                    "returnType": "array"
                  },
                  "diagram": {
                    "x": 6125,
                    "y": 5891
                  },
                  "outcomes": {
