        {
          "metadata": {
            "name": "Parse Ora Action",
            "returnType": "object",
            "sourceCode": "function tryParseJson(text) {\n  try {\n    return JSON.parse(text);\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction toFieldsMap(fieldsArray) {\n  const map = {};\n  for (const field of Array.isArray(fieldsArray) ? fieldsArray : []) {\n    const id = field?.id;\n    if (typeof id !== \"string\" || id.trim() === \"\") continue;\n    map[id] = field?.value ?? null;\n  }\n  return map;\n}\n\nconst rawValue = $context.$triggers.REST.$input.OraAction;\nconst rawInput = String(rawValue || \"\").trim();\n\nif (!rawInput) {\n  return {\n    actionName: \"default\",\n    payload: {},\n    error: \"OraAction is empty\"\n  };\n}\n\nconst formSubmitMatch = rawInput.match(/<oraFormSubmit\\s+id=[\"']([^\"']*)[\"'][^>]*>(.*?)<\\/oraFormSubmit>/s);\nif (formSubmitMatch) {\n  const formId = String(formSubmitMatch[1] || \"\").trim() || \"default\";\n  const fieldsRaw = String(formSubmitMatch[2] || \"\").trim();\n  const parsedFields = tryParseJson(fieldsRaw);\n  const fieldsArray = Array.isArray(parsedFields) ? parsedFields : [];\n\n  return {\n    actionName: \"formSubmit\",\n    payload: {\n      formId,\n      fields: toFieldsMap(fieldsArray),\n      rawFields: fieldsArray\n    }\n  };\n}\n\nconst parsedObject =\n  rawValue && typeof rawValue === \"object\" && !Array.isArray(rawValue)\n    ? rawValue\n    : tryParseJson(rawInput);\n\nif (!parsedObject || Array.isArray(parsedObject) || typeof parsedObject !== \"object\") {\n  return {\n    actionName: \"default\",\n    payload: {},\n    error: \"OraAction must be a JSON object for InvokeAction\",\n    rawAction: rawInput\n  };\n}\n\nconst actionName = String(parsedObject.actionName || \"\").trim();\nif (actionName === \"returnToRequester\" || actionName === \"returnToRequesterMassAction\" || actionName === \"messageBuyer\") {\n  return {\n    actionName,\n    payload: parsedObject\n  };\n}\n\nreturn {\n  actionName: \"default\",\n  payload: parsedObject\n};"
          },
          "outcomes": {
            "success": "1779000000004"
          },
          "code": "PARSE_ORA_ACTION",
          "id": "1",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 8526.5,
            "y": 5206
          }
