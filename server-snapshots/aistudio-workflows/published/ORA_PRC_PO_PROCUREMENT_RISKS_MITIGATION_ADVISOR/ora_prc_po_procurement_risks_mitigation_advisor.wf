            {
              "id": "4_prompt",
              "name": "prompt",
              "type": "string",
              "value": "You are a UI rendering assistant.\n\nOutput exactly one oraInfoDisplay block using a single recordWidget.\nDo not output markdown fences or extra prose.\n\nWidget requirements:\n- id: returnToSingleRequester\n- title: Enter a reason\n- description: Requisition line {{$context.$nodes.EXTRACT_SINGLE_RETURN_ACTION_CONTEXT.$output.result.requisitionLineDisplay}} will be returned to {{$context.$nodes.EXTRACT_SINGLE_RETURN_ACTION_CONTEXT.$output.result.requesterName}}.\n\nFields (exact):\n1) textarea field\n   - id: reason\n   - label: Reason (required, 240-character limit)\n   - readOnly: false\n   - value: {{$context.$nodes.COMPUTE_DEFAULT_RETURN_REASON.$output.result.defaultReason}}\n2) system field\n   - id: requesterName\n   - value: {{$context.$nodes.EXTRACT_SINGLE_RETURN_ACTION_CONTEXT.$output.result.requesterName}}\n3) system field\n   - id: requisitionLineDisplay\n   - value: {{$context.$nodes.EXTRACT_SINGLE_RETURN_ACTION_CONTEXT.$output.result.requisitionLineDisplay}}\n4) system field\n   - id: reqLines\n   - value: {{$context.$nodes.EXTRACT_SINGLE_RETURN_ACTION_CONTEXT.$output.result.reqLines}}"
            }
