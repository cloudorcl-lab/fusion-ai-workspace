        {
          "metadata": {
            "name": "Normalize Return Lines",
            "returnType": "object",
            "sourceCode": "function tryParseJson(value) {\n  if (value == null || value === '') return null;\n  if (typeof value === 'object') return value;\n  try {\n    return JSON.parse(String(value));\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction toList(value) {\n  if (Array.isArray(value)) return value;\n  const parsed = tryParseJson(value);\n  if (Array.isArray(parsed)) return parsed;\n  return [];\n}\n\nfunction compact(value) {\n  return value == null ? '' : String(value).trim();\n}\n\nfunction normalizeLine(item) {\n  if (!item || typeof item !== 'object') return null;\n  const requisitionHeaderId = compact(item.requisitionHeaderId ?? item.RequisitionHeaderId ?? item.headerId);\n  const requisitionLineId = compact(item.requisitionLineId ?? item.RequisitionLineId);\n  if (!requisitionHeaderId || !requisitionLineId) return null;\n  return {\n    requisitionHeaderId,\n    requisitionLineId,\n    display: compact(item.display ?? item.requisitionLineDisplay ?? item.RequisitionLineDisplay) || requisitionLineId,\n    requisitioningBU: compact(item.requisitioningBU ?? item.RequisitioningBU ?? item.requisitioningBUName ?? item.RequisitioningBUName ?? item.requisitioningBusinessUnit ?? item.RequisitioningBusinessUnit ?? item.requisitioningBusinessUnitName ?? item.RequisitioningBusinessUnitName),\n    requesterName: compact(item.requesterName ?? item.RequesterName ?? item.requester?.name ?? item.Requester?.Name) || '-'\n  };\n}\n\nconst submitted = $context.$nodes.EXTRACT_SUBMITTED_FORM_DATA.$output.result || {};\nconst rawLines = toList(submitted.reqLines);\nconst byLineId = new Map();\nfor (const item of rawLines) {\n  const line = normalizeLine(item);\n  if (line) byLineId.set(line.requisitionLineId, line);\n}\n\nconst groupsByHeader = new Map();\nfor (const line of byLineId.values()) {\n  const group = groupsByHeader.get(line.requisitionHeaderId) || {\n    requisitionHeaderId: line.requisitionHeaderId,\n    requisitionLineIds: [],\n    lines: []\n  };\n  group.requisitionLineIds.push(line.requisitionLineId);\n  group.lines.push(line);\n  groupsByHeader.set(line.requisitionHeaderId, group);\n}\n\nconst groups = Array.from(groupsByHeader.values()).map(group => ({\n  ...group,\n  requisitionLineIdsCsv: group.requisitionLineIds.join(',')\n}));\n\nreturn {\n  submittedCount: byLineId.size,\n  lines: Array.from(byLineId.values()),\n  groups\n};"
          },
