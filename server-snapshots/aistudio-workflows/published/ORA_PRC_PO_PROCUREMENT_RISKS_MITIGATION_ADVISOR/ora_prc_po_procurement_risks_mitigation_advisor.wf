        },
        {
          "metadata": {
            "name": "Filter Returnable Lines",
            "returnType": "object",
            "sourceCode": "function tryParseJson(value) {\n  if (typeof value !== 'string') return value;\n  try {\n    return JSON.parse(value);\n  } catch (e) {\n    return value;\n  }\n}\n\nfunction compact(value) {\n  return value == null ? '' : String(value).trim();\n}\n\nfunction asArray(value) {\n  const parsed = tryParseJson(value);\n  if (Array.isArray(parsed)) return parsed.map(tryParseJson);\n  if (parsed == null) return [];\n  return [parsed];\n}\n\nfunction collectItems(value, output) {\n  const parsed = tryParseJson(value);\n  if (parsed == null) return;\n  if (Array.isArray(parsed)) {\n    for (const item of parsed) collectItems(item, output);\n    return;\n  }\n  if (typeof parsed === 'object') {\n    if (Array.isArray(parsed.items)) {\n      for (const item of parsed.items) output.push(item);\n    }\n    collectItems(parsed.result, output);\n    collectItems(parsed.body, output);\n    collectItems(parsed.data, output);\n  }\n}\n\nfunction normalizeBuyerProcessingFlag(value) {\n  if (value === true) return 'Y';\n  if (value === false) return 'N';\n  return compact(value);\n}\n\nfunction isReturnable(line) {\n  return compact(line.lineStatus).toUpperCase() === 'APPROVED'\n    && compact(line.requisitionLineInPool).toUpperCase() === 'Y'\n    && compact(line.buyerProcessingFlag).toUpperCase() === 'N';\n}\n\nfunction resultRow(row) {\n  return {\n    requisitionLineDisplay: compact(row.display) || String(row.requisitionLineId),\n    requisitioningBU: compact(row.requisitioningBU) || '-',\n    requesterName: compact(row.requesterName) || '-'\n  };\n}\n\nconst submitted = $context.$nodes.NORMALIZE_MASS_RETURN_LINES.$output.result || {};\nconst groups = Array.isArray(submitted.groups) ? submitted.groups : [];\nconst loopOutputs = asArray($context.$nodes.VALIDATE_MASS_RETURN_LINE_GROUPS.$output);\nconst validationRows = [];\n\nfor (let groupIndex = 0; groupIndex < groups.length; groupIndex++) {\n  const currentGroup = groups[groupIndex] || {};\n  const expectedByLineId = new Map();\n  for (const line of currentGroup.lines || []) {\n    expectedByLineId.set(String(line.requisitionLineId), line);\n  }\n\n  const serviceItems = [];\n  collectItems(loopOutputs[groupIndex], serviceItems);\n  const returnedLineIds = new Set();\n\n  for (const item of serviceItems) {\n    const requisitionLineId = compact(item.RequisitionLineId ?? item.requisitionLineId);\n    if (!requisitionLineId) continue;\n    returnedLineIds.add(requisitionLineId);\n    const source = expectedByLineId.get(requisitionLineId) || {};\n    validationRows.push({\n      requisitionHeaderId: compact(item.RequisitionHeaderId ?? item.requisitionHeaderId ?? currentGroup.requisitionHeaderId),\n      requisitionLineId,\n      display: source.display || requisitionLineId,\n      requisitioningBU: compact(item.RequisitioningBU ?? item.requisitioningBU ?? item.RequisitioningBUName ?? item.requisitioningBUName ?? item.RequisitioningBusinessUnit ?? item.requisitioningBusinessUnit ?? item.RequisitioningBusinessUnitName ?? item.requisitioningBusinessUnitName ?? source.requisitioningBU),\n      requesterName: source.requesterName || '-',\n      lineStatus: compact(item.LineStatus ?? item.lineStatus ?? item.LineStatusCode ?? item.lineStatusCode ?? item.Status ?? item.status),\n      requisitionLineInPool: item.RequisitionLineInPool ?? item.requisitionLineInPool ?? item.RequisitionLineInPoolFlag ?? item.requisitionLineInPoolFlag ?? item.reqsInPoolFlag,\n      buyerProcessingFlag: normalizeBuyerProcessingFlag(item.BuyerProcessingFlag ?? item.buyerProcessingFlag ?? item.BuyerProcessingFlagCode ?? item.buyerProcessingFlagCode ?? ''),\n      found: true\n    });\n  }\n\n  for (const [lineId, source] of expectedByLineId.entries()) {\n    if (returnedLineIds.has(lineId)) continue;\n    validationRows.push({\n      requisitionHeaderId: source.requisitionHeaderId,\n      requisitionLineId: lineId,\n      display: source.display || lineId,\n      requisitioningBU: source.requisitioningBU || '',\n      requesterName: source.requesterName || '-',\n      lineStatus: '',\n      requisitionLineInPool: '',\n      buyerProcessingFlag: '',\n      found: false\n    });\n  }\n}\n\nconst eligible = [];\nconst skipped = [];\nfor (const row of validationRows) {\n  if (isReturnable(row)) eligible.push(row);\n  else skipped.push(row);\n}\n\nconst eligibleReqLineIds = eligible.map(row => String(row.requisitionLineId));\nconst skippedReqLineIds = skipped.map(row => String(row.requisitionLineId));\nconst eligibleRows = eligible.map(resultRow);\nconst skippedRows = skipped.map(resultRow);\n\nreturn {\n  submittedCount: submitted.submittedCount || validationRows.length,\n  eligibleCount: eligibleReqLineIds.length,\n  skippedCount: skippedReqLineIds.length,\n  eligibleReqLineIds,\n  skippedReqLineIds,\n  eligibleRows,\n  skippedRows,\n  eligibleReqLineIdsCsv: eligibleReqLineIds.join(','),\n  skippedReqLineIdsCsv: skippedReqLineIds.join(','),\n  returnReason: submitted.returnReason,\n  validationRows\n};"
          },
          "outcomes": {
            "success": "any_returnable_mass_return_lines"
          },
