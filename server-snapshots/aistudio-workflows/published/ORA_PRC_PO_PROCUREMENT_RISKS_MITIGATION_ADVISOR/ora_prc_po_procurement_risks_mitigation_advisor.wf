        {
          "metadata": {
            "name": "Extract Submitted Form Data",
            "returnType": "object",
            "sourceCode": "function tryParseJson(value) {\n  if (value == null || value === '') return null;\n  if (typeof value === 'object') return value;\n  try {\n    return JSON.parse(String(value));\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction deriveDisplayFromReqLines(reqLines) {\n  const lines = Array.isArray(reqLines) ? reqLines : [];\n  return lines\n    .map(line => line?.display ?? line?.requisitionLineDisplay ?? line?.RequisitionLineDisplay ?? line?.requisitionLineId ?? line?.RequisitionLineId)\n    .filter(value => value != null && String(value).trim() !== '')\n    .map(value => String(value).trim())\n    .join(', ');\n}\n\nconst rawActionContext = String($context.$triggers.REST.$input.OraAction || '');\nconst formSubmitMatch = rawActionContext.match(/<oraFormSubmit\\s+id=[\"']([^\"']*)[\"'][^>]*>(.*?)<\\/oraFormSubmit>/s);\n\nlet ret = {};\n\nif (formSubmitMatch) {\n  const formId = String(formSubmitMatch[1] || '').trim();\n  const rawPayload = String(formSubmitMatch[2] || '').trim();\n\n  ret.formId = formId;\n  ret.isMassAction = formId === 'returnToRequesterMassAction';\n\n  try {\n    const parsedPayload = JSON.parse(rawPayload);\n    if (Array.isArray(parsedPayload)) {\n      const reqLinesObj = parsedPayload.find(item => item?.id === 'reqLines');\n      const reqLines = reqLinesObj ? tryParseJson(reqLinesObj.value) ?? reqLinesObj.value : null;\n      ret.reqLines = reqLines;\n\n      const reasonObj = parsedPayload.find(item => item?.id === 'reason');\n      ret.reason = String(reasonObj?.value ?? '');\n\n      const requesterNameObj = parsedPayload.find(item => item?.id === 'requesterName');\n      ret.requesterName = String(requesterNameObj?.value ?? (ret.isMassAction ? 'requesters' : 'requester')).trim();\n\n      const requisitionLineDisplayObj = parsedPayload.find(item => item?.id === 'requisitionLineDisplay');\n      ret.requisitionLineDisplay = String(requisitionLineDisplayObj?.value ?? deriveDisplayFromReqLines(reqLines)).trim();\n    }\n  } catch (err) {\n    ret.error = 'PARSE_ERROR';\n  }\n}\n\nreturn ret;"
          },
          "outcomes": {
            "success": "1777581472323"
          },
