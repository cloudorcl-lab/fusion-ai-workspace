        {
          "metadata": {
            "name": "Compute Default Return Reason",
            "returnType": "object",
            "sourceCode": "function text(value) {\n  return value == null ? '' : String(value).trim();\n}\n\nfunction defaultReasonForRiskType(riskType) {\n  const normalized = text(riskType);\n\n  if (normalized === 'splitPurchases') {\n    return 'Please review existing requisitions raised for similar products/services and confirm whether this request is distinct from those requests.';\n  }\n\n  if (normalized === 'highAmountForCategory') {\n    return 'The amount of this requisition line appears to be significantly higher than comparable purchases and current market pricing. Please review and provide justification for the pricing submitted.';\n  }\n\n  if (normalized === 'highValueVagueDesc') {\n    return 'The requisition description lacks sufficient detail, and pricing appears unusually high for the stated goods/services. Please update the description with clear scope, and business justification, and verify the pricing before resubmission.';\n  }\n\n  return '';\n}\n\nconst riskType = text($context.$triggers.REST.$input.riskType);\nconst result = {\n  riskType,\n  defaultReason: defaultReasonForRiskType(riskType)\n};\nreturn result;"
          },
          "outcomes": {
            "success": "2"
          },
          "code": "COMPUTE_DEFAULT_RETURN_REASON",
          "id": "1779000000004",
