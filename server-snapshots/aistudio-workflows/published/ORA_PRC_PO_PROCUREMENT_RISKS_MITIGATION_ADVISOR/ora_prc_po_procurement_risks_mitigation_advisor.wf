        {
          "metadata": {
            "name": "Build Return To Requesters Result Display Data",
            "returnType": "object",
            "sourceCode": "const validation = $context.$nodes.FILTER_RETURNABLE_MASS_RETURN_LINES?.$output?.result || {};\nconst skippedCount = Number(validation.skippedCount || 0);\nconst eligibleCount = Number(validation.eligibleCount || 0);\nconst returnedRows = Array.isArray(validation.eligibleRows) ? validation.eligibleRows : [];\nconst skippedRows = Array.isArray(validation.skippedRows) ? validation.skippedRows : [];\n\nfunction cleanCell(value) {\n  return String(value == null || value === '' ? '-' : value)\n    .replace(/[\\r\\n]+/g, ' ')\n    .trim() || '-';\n}\n\nfunction normalizeRows(rows) {\n  return rows.map(row => ({\n    requisitionLineDisplay: cleanCell(row.requisitionLineDisplay),\n    requisitioningBU: cleanCell(row.requisitioningBU),\n    requesterName: cleanCell(row.requesterName)\n  }));\n}\n\nconst hasReturnedRows = eligibleCount > 0;\nconst hasSkippedRows = skippedCount > 0;\nconst isMixedOutcome = hasReturnedRows && hasSkippedRows;\nconst returnedResultRows = normalizeRows(returnedRows);\nconst skippedResultRows = normalizeRows(skippedRows);\nconst returnedTitle = `Requisition lines were returned.`;\nconst noReturnedTitle = `Requisition lines couldn't be returned because they're no longer available.`;\nconst mixedOutcomeTitle = `Some requisition lines were returned. However, the following lines couldn't be returned because they're no longer available.`;\n\nreturn {\n  returnedTitle,\n  skippedTitle: noReturnedTitle,\n  noReturnedTitle,\n  summaryTitle: isMixedOutcome ? mixedOutcomeTitle : (hasReturnedRows ? returnedTitle : noReturnedTitle),\n  simpleMessage: hasReturnedRows ? returnedTitle : noReturnedTitle,\n  returnedCount: eligibleCount,\n  skippedCount,\n  returnedRows: returnedResultRows,\n  skippedRows: skippedResultRows,\n  displayRows: isMixedOutcome ? skippedResultRows : returnedResultRows,\n  hasReturnedRows,\n  hasSkippedRows,\n  isMixedOutcome\n};"
          },
          "outcomes": {
            "success": "is_mixed_return_outcome"
          },
