        {
          "id": "1779000000006",
          "code": "VALIDATE_RETURN_REASON",
          "type": "CODE",
          "metadata": {
            "name": "Validate Return Reason",
            "description": "Validates submitted return reason before invoking ReturnLinesToPreparer.",
            "sourceCode": "function text(value) {\n  return value == null ? \"\" : String(value);\n}\n\nconst submitted = $context.$nodes.EXTRACT_SUBMITTED_FORM_DATA?.$output?.result || {};\nconst rawReason = text(submitted.reason);\nconst trimmedReason = rawReason.trim();\n\nif (!trimmedReason) {\n  return {\n    isValid: false,\n    validationCode: \"POR-2011486\",\n    validationMessage: \"You must provide a reason for returning requisition lines. (POR-2011486)\"\n  };\n}\n\nif (rawReason.length > 240) {\n  return {\n    isValid: false,\n    validationCode: \"POR-2011488\",\n    validationMessage: \"The reason for returning requisition lines or reassigning the buyer can't exceed 240 characters. (POR-2011488)\"\n  };\n}\n\nreturn {\n  isValid: true,\n  validationCode: \"\",\n  validationMessage: \"\"\n};",
            "returnType": "object"
          },
          "outcomes": {
