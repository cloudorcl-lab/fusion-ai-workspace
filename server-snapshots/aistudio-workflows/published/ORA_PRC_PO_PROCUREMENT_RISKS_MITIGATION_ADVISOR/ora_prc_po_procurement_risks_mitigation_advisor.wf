            "name": "Validate Extracted Form Data",
            "returnType": "string",
            "sourceCode": "let result = \"\";\ntry {\n  const submittedFormData = $context.$nodes?.EXTRACT_SUBMITTED_FORM_DATA?.$output?.result || {};\n  const isEmptyObject =\n    typeof submittedFormData === \"object\" &&\n    !Array.isArray(submittedFormData) &&\n    Object.keys(submittedFormData).length === 0;\n  const reqLines = submittedFormData.reqLines;\n  const hasReqLines = Array.isArray(reqLines) && reqLines.length > 0;\n\n  if (!submittedFormData || isEmptyObject || submittedFormData.error === \"PARSE_ERROR\" || !hasReqLines) {\n    result = \"ERROR\";\n  } else {\n    result = \"SUCCESS\";\n  }\n} catch (error) {\n  result = \"ERROR\";\n}\n\nreturn result;"
          },
