          "code": "FIN_AP_PROGRAM_IDENTIFER_IN_PPR",
          "id": "1780570397834",
          "inputs": [
            {
              "id": "1780570397835_1",
              "name": "prompt",
              "type": "string",
              "value": "Use your intelligence to identify the program type from {{$context.$system.$inputMessage}} \nChat history: {{$context.$triggers.REST.$input.chatHistory}}\n\nIdentify the program type only when the user is asking about payment process request templates.\n\nPriority order:\n1. If the user asks about Dynamic discounting, DD, or early payment, output: DynamicDiscountPPR\n2. If the user asks about Virtual card, Virtual credit card, or VCC, output: virtualCardPPR\n3. If the user asks about Supply chain financing or SCF, output: scfPPR\n4. Otherwise, output: standardPPR\n\nRules:\n- If the user asks for payment process request templates filtered only by business unit and currency, output: standardPPR\n- If the user asks for supported Payment Programs, output: standardPPR\n- If multiple program types are mentioned, choose the most specific match using the priority order above\n- If the request is not about payment process request templates, output: standardPPR\n\nGuard rail:\n- Output only one of these four keywords:\n  DynamicDiscountPPR\n  virtualCardPPR\n  scfPPR\n  standardPPR\n- Do not add any other text"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Check PPR Query Based on Program Type"
          },
          "outcomes": {
            "true": "1780570522826",
            "false": "1780570590083"
          },
          "code": "FIN_AP_CHECK_PPR_QUERY_BASED_ON_PROGRAM_TYPE",
          "convergenceTargetId": "end",
          "id": "1780570481276",
          "inputs": [
            {
              "id": "1780570481277_1",
