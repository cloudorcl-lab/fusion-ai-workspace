          "outcomes": {
            "true": "1780570618219",
            "false": "1780570997528"
          },
          "code": "FIN_AP_CHECK_FOR_FILTRATION_BASED_ON_DD",
          "convergenceTargetId": "1780570997528",
          "id": "1780570590083",
          "inputs": [
            {
              "id": "1780570590084_1",
              "name": "condition",
              "type": "string",
