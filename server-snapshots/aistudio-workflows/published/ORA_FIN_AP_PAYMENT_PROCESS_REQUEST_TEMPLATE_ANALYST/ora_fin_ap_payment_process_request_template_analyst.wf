              "value": "{{$context.$nodes.FIN_AP_CODE_SELECT_OUTPUT_AND_RETURN.$output.result}}"
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "name": "Construct Filter for PPR Data Fetch",
            "returnType": "string",
            "sourceCode": "let queryType = $context.$nodes.FIN_AP_PROGRAM_IDENTIFER_IN_PPR.$output;\n\nconst currencyList =\n  $context.$nodes.FIN_AP_EXTRACT_BUSINESS_UNIT_AND_CURRENCY?.$output?.currency;\n\nconst businessUnitList =\n  $context.$nodes.FIN_AP_EXTRACT_BUSINESS_UNIT_AND_CURRENCY?.$output?.businessUnit;\n\nconst conditions = [];\n\nif (currencyList) {\n  conditions.push(`currencyCodes LIKE '%${currencyList}%'`);\n}\n\nif (businessUnitList) {\n  conditions.push(`businessUnitNames LIKE '%${businessUnitList}%'`);\n}\n\nif (queryType === \"DynamicDiscountPPR\") {\n  const templateResult =\n    $context.$nodes.FIN_AP_EXTRACT_DD_TEMPLATE_NAMES?.$output?.result;\n\n  if (templateResult) {\n    const templateList = templateResult\n      .split(\",\")\n      .map(name => `'${name.trim()}'`)\n      .join(\", \");\n\n    conditions.push(`templateName IN (${templateList})`);\n  }\n}\n\nif(queryType === \"virtualCardPPR\"){\n  \n  conditions.push(`paymentModeCode='VIRTUAL_CARD'`);\n}\n\nlet filter = \"$limit=20\";\n\nif (conditions.length > 0) {\n  filter += `&$filter=${conditions.join(\" AND \")}`;\n}\n\nreturn filter;"
          },
          "outcomes": {
            "success": "1780571067682"
          },
          "code": "FIN_AP_CONSTRUCT_FILTER_FOR_PPR_DATA_FETCHFIN_AP_CONSTRUCT_FILTER_FOR_PPR_DATA_FETCH",
          "id": "1780570997528",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
