        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.25
              },
              "code": "ORA_LLM_MODEL_PROVIDER_CERT_BASIC_LLAMA_3_3_70B",
              "model": "ORA_LLM_MODEL_GPT_OSS_120B",
              "modelName": "GPT OSS 120B (Basic)",
              "provider": "CERT_BASIC"
            },
            "name": "Response for resolving template"
          },
          "outcomes": {
            "success": "1768144272777"
          },
          "code": "FIN_AP_LLM_RESPONSE_FOR_RESOLVING_TEMPLATE",
          "id": "1768144386753",
          "inputs": [
            {
              "id": "1768144386755_1",
              "name": "prompt",
              "type": "string",
              "value": "# Declarations\n\n- Input message: {{$context.$system.$inputMessage}}\n- Chat history: {{$context.$triggers.REST.$input.chatHistory }}\n- Directly fetched Entities: {{$context.$nodes.FIN_AP_BO_FUNCTION_GET_PPR_TEMPLATES_BY_ACCELERATION_FLAG.$output}}\n- Matched Entities: {{$context.$nodes.FIN_AP_CODE_SEARCH_OUTPUT_PARSER.$output.result}}\n\n# Primary goal\nAssume the role of a Payment Process Request Template Retriever Agent, whose primary purpose is to aid the user in resolving to a particular PPR template for PPR scheduling\n\n# Instructions\nEnsure that the template keyword used for search is also mentioned in the summary.\nIf Directly fetched entities has data\n   - List the template names asking the user about which one to select and use\nElse\n   - If Matched entities has results\n           - List the template names asking the user about which one to select and use\n     - Else\n        - Use details from the input message and chat history to inform the user that no valid match was found. Clearly reference what was attempted or asked, and politely request more specific information to proceed.\n\nYou must be polite, concise, and only perform the actions described above. Do not take any actions outside of this prompt. Always leverage both the input message and chat history to construct informative and contextually relevant replies"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Extract DD Template Names",
            "returnType": "string",
            "sourceCode": "let data = $context.$nodes.FIN_AP_GET_DD_TEMPLATE_NAME?.$output?.items;\n\nlet templateNames = data\n  .map(item => item.templateName)\n  .filter(Boolean)\n  .join(\", \");\n\nreturn templateNames;"
          },
          "outcomes": {
            "success": "1780570997528"
          },
          "code": "FIN_AP_EXTRACT_DD_TEMPLATE_NAMES",
          "id": "1780570694917",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Select output and return",
            "returnType": "object",
            "sourceCode": "let userResponse;\nlet templatesToList = $context.$nodes.FIN_AP_CODE_SET_TEMPLATES_TO_LIST.$output.result || [];\n\nif( $context.$nodes.FIN_AP_LLM_RESPONSE_FOR_RESOLVING_TEMPLATE.$output ){\n    userResponse = $context.$nodes.FIN_AP_LLM_RESPONSE_FOR_RESOLVING_TEMPLATE.$output;\n}else{\n    userResponse = $context.$nodes.FIN_AP_LLM_RESPONSE_FOR_LISTING_TEMPLATES.$output;\n}\n\nif( $context.$nodes.FIN_AP_LLM_RESPONSE_FOR_RESOLVING_TEMPLATE.$output ){\n    let response =  [\n    {\n        \"type\": \"text\",\n        \"content\": userResponse,\n        \"sequence\": 1\n    }\n];\n\nif(templatesToList.length > 0){\n    response.push(\n        {\n            \"type\": \"table\",\n            \"heading\": \"Payment Process Request Templates\",\n            \"content\": templatesToList,\n            \"sequence\": 2\n        }\n    )\n}\n\nreturn response;\n\n}else{\n    let response = [];\n\nif(templatesToList.length > 0){\n    response .push(\n    {\n        \"type\": \"text\",\n        \"content\": userResponse,\n        \"sequence\": 1\n    });\n    response.push(\n        {\n            \"type\": \"table\",\n            \"heading\": \"Payment Process Request Templates\",\n            \"content\": templatesToList,\n            \"sequence\": 2\n        }\n    );\n\n} else{\n    \n    response.push(\n            {\n        \"type\": \"text\",\n        \"content\": \"No matching payment process request templates were found for the above mentioned criteria\",\n        \"sequence\": 1\n    }\n    );\n}\n\nreturn response;\n}\n\n\n\n"
          },
          "outcomes": {
            "success": "1768180317773"
          },
          "code": "FIN_AP_CODE_SELECT_OUTPUT_AND_RETURN",
          "id": "1768144272777",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Set templates to list",
            "returnType": "array",
            "sourceCode": "let result;\nlet queryType = $context.$nodes.FIN_AP_LLM_IDENTIFY_QUERY_TYPE.$output;\n\nlet byAccCode = $context.$nodes.FIN_AP_BO_FUNCTION_GET_PPR_TEMPLATES_BY_ACCELERATION_FLAG?.$output;\nlet bySearch = $context.$nodes.FIN_AP_CODE_SEARCH_OUTPUT_PARSER?.$output?.result;\n\n// Use Standard PPR output if present, otherwise Virtual Card output\nlet pprDetails = $context.$nodes.FIN_AP_GET_PPR_DETAILS_FILTERED_ON_BU_AND_CURRENCY?.$output?.items || [];\nif (queryType == \"getPprTemplateForDD\") {\n\n    result = byAccCode.items.map(i => ({\n        templateName: i.templateName\n    }));\n\n} else if (queryType == \"getPprTemplateByBUandCurrency\") {\n\n    let programType = $context.$nodes.FIN_AP_PROGRAM_IDENTIFER_IN_PPR.$output;\n    const templateResult =\n        $context.$nodes.FIN_AP_EXTRACT_DD_TEMPLATE_NAMES?.$output?.result;\n\n    if (programType == \"DynamicDiscountPPR\" && templateResult!=[]) {\n        result = pprDetails.map(i => {\n\n            let paymentProgramType = \"Standard Payment Process Template\";\n\n            if (i.paymentModeCode === \"VIRTUAL_CARD\") {\n                paymentProgramType = \"Virtual Card\";\n            } else if (\n                !i.paymentModeCode &&\n                [\"ORA_DD_ONLY\", \"ORA_DD_YES\"].includes(i.acceleratedInvoicesCode)\n            ) {\n                paymentProgramType = \"Dynamic Discounting Program\";\n            }\n\n            let status = \"Active\";\n\n            if (\n                i.inactiveDate &&\n                new Date(i.inactiveDate) <= new Date()\n            ) {\n                status = \"Inactive\";\n            }\n\n            return {\n                \"Template Name\": i.templateName,\n                \"Payment Program Type\": paymentProgramType,\n                \"Status\": status,\n                \"Description\": i.description,\n                \"Business Units\": i.businessUnitNames,\n                \"Legal Entities\": i.legalEntityNames,\n                \"Payment Currencies\": i.currencyCodes,\n                \"Pay Groups\": i.supplierPayGroups,\n                \"Invoice Sources\": i.invoiceSources,\n                \"Disbursement Bank Account\": i.bankAccountName\n            };\n        });\n    }else{\n\n        return [] ;\n    }\n\n\n\n} else {\n\n    result = bySearch.map(i => ({\n        templateName: i.name\n    }));\n\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1768144248256"
          },
          "code": "FIN_AP_CODE_SET_TEMPLATES_TO_LIST",
          "id": "1768144657295",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
