{
  "workflowId": "100002355226968",
  "workflowCode": "ORA_FIN_AP_VIRTUAL_CARD_OFFER_EMAIL_DRAFT_GENERATOR",
  "name": "Virtual Card Offer Email Draft Generator",
  "description": "The Virtual Card Offer Email Draft Generator retrieves draft offer details and composes supplier-addressed email drafts for the selected Virtual Card program. It produces only Virtual Card email drafts, which users can copy and send to suppliers.",
  "specification": {
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
