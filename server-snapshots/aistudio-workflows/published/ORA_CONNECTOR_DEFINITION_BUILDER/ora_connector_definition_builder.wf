          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"id\": \"http://fusionaistudio.com/schemas/service-catalog-article.json\",\n  \"title\": \"Fusion AI Studio — Service Catalog Article\",\n  \"description\": \"Schema for validating service catalog article content populated by the EXA research agent.\",\n  \"type\": \"object\",\n  \"required\": [\n    \"TITLE\",\n    \"OVERVIEW\",\n    \"FEATURES\",\n    \"BENEFITS\",\n    \"PRICING_AND_LICENSING\",\n    \"ADDITIONAL_RESOURCES\"\n  ],\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"TITLE\": {\n      \"id\": \"#/properties/TITLE\",\n      \"type\": \"string\",\n      \"description\": \"Formal product or service name. Plain text only, no HTML.\",\n      \"minLength\": 1,\n      \"maxLength\": 100,\n      \"pattern\": \"^[^<>]+$\"\n    },\n    \"OVERVIEW\": {\n      \"id\": \"#/properties/OVERVIEW\",\n      \"type\": \"string\",\n      \"description\": \"2–3 sentence plain-text summary of the service. No HTML tags permitted.\",\n      \"minLength\": 50,\n      \"maxLength\": 800,\n      \"pattern\": \"^[^<>]+$\"\n    },\n    \"FEATURES\": {\n      \"id\": \"#/properties/FEATURES\",\n      \"type\": \"string\",\n      \"description\": \"One or more <p style=\\\"margin-left:0px;\\\"><strong>[Feature Name]: </strong>[Description]</p> blocks. Minimum 3 features.\",\n      \"minLength\": 1,\n      \"pattern\": \"^(<p style=\\\"margin-left:0px;\\\"><strong>.+?:\\\\s*<\\\\/strong>.+?<\\\\/p>){3,}$\"\n    },\n    \"BENEFITS\": {\n      \"id\": \"#/properties/BENEFITS\",\n      \"type\": \"string\",\n      \"description\": \"One or more <p><strong>[Benefit Title]:</strong> [Description]</p> blocks. Minimum 3 benefits.\",\n      \"minLength\": 1,\n      \"pattern\": \"^(<p><strong>.+?:<\\\\/strong>\\\\s*.+?<\\\\/p>){3,}$\"\n    },\n    \"PRICING_AND_LICENSING\": {\n      \"id\": \"#/properties/PRICING_AND_LICENSING\",\n      \"type\": \"string\",\n      \"description\": \"A clickable pricing link wrapped in a paragraph, or an empty string if not found.\",\n      \"pattern\": \"^(<p><a href=\\\"https://[^\\\"<>\\\\s]+\\\"(?: [^<>]*)?>[^<>]+<\\\\/a><\\\\/p>|)$\"\n    },\n    \"ADDITIONAL_RESOURCES\": {\n      \"id\": \"#/properties/ADDITIONAL_RESOURCES\",\n      \"type\": \"string\",\n      \"description\": \"A clickable docs or getting-started link wrapped in a paragraph, or an empty string if not found.\",\n      \"pattern\": \"^(<p><a href=\\\"https://[^\\\"<>\\\\s]+\\\"(?: [^<>]*)?>[^<>]+<\\\\/a><\\\\/p>|)$\"\n    }\n  }\n}",
          "type": "AGENT",
