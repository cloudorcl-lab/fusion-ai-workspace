          "metadata": {
            "name": "UI Auth Spec Normalizer",
            "returnType": "object",
            "sourceCode": "function parse(v){if(v&&typeof v==='object'&&v.result!==undefined)v=v.result;if(typeof v==='string'){try{return JSON.parse(v)}catch(e){return {sections:[]}}}return v&&typeof v==='object'?v:{sections:[]}}\nfunction fieldFromBinding(v){v=(v||'')+'';var p='$'+'{authentication.';var i=v.indexOf(p);if(i<0)return null;var j=v.indexOf('}',i);return j>i?v.substring(i+p.length,j):null}\nfunction title(s){return (s||'').replace(/[-_]+/g,' ').replace(/\\b\\w/g,function(c){return c.toUpperCase()})}\nfunction authLabel(p){var id=p&&p.id||'';if(id==='apiKey')return 'API Key';if(id==='bearer')return 'Bearer Token';if(id==='basic')return 'Basic Authentication';if(id==='oauth2_client_credentials')return 'OAuth2 Client Credentials';if(id==='oci_api_signature')return 'OCI API Signature 1.0';return p.displayName||id}\nfunction lovFromProfiles(profiles){return profiles.map(function(p){return {label:authLabel(p),value:p.id}})}\nfunction fieldType(code,b,authType){var lower=(code+' '+b+' '+(authType||'')).toLowerCase();return /password|secret|token|key|credential/.test(lower)?'password':'text'}\nvar ui=parse($context.$nodes.UI_SPEC_GENERATOR.$output),auth=parse($context.$nodes.AUTH_METADATA_GENERATOR.$output),profiles=auth.profiles||[];ui.sections=ui.sections||[];var idx=-1,sec=null;for(var i=0;i<ui.sections.length;i++)if(ui.sections[i].code==='authentication'){idx=i;sec=ui.sections[i];break}if(!sec){sec={code:'authentication',title:'Authentication',type:'static',visible:true,required:false,helpText:null,fields:[]};ui.sections.splice(ui.sections.length?1:0,0,sec);idx=ui.sections.indexOf(sec)}\nsec.code='authentication';sec.title=sec.title||'Authentication';sec.type='static';sec.visible=true;sec.required=profiles.length>0;sec.helpText=sec.helpText===undefined?null:sec.helpText;sec.fields=[];\nif(profiles.length>1)sec.fields.push({code:'authType',title:'Authentication Type',type:'singleSelectLov',required:true,visible:true,defaultValue:auth.defaultProfile||profiles[0].id,LOV:lovFromProfiles(profiles)});\nfor(var p=0;p<profiles.length;p++){var pr=profiles[p],vis=profiles.length>1?\"authType === '\"+pr.id+\"'\":true,bindings=pr.inputBindings||{};for(var b in bindings){var code=fieldFromBinding(bindings[b])||b;var typ=fieldType(code,b,pr.authType);sec.fields.push({code:code,title:title(code),type:typ,required:true,visible:vis,isSecret:typ==='password'});}}\nui.sections[idx]=sec;return ui;",
