{type:'string'},preferObject);if(s.oneOf)s=pickVariant(s.oneOf,preferObject);if(s.anyOf)s=pickVariant(s.anyOf,preferObject);if(s.allOf)s=mergeAllOf(s.allOf);if(!s.type){if(s.properties)s.type='object';else if(s.items)s.type='array';else s.type=preferObject?'object':'string'}if(s.items)s.items=norm(s.items,preferObject);if(s.properties){var ps={};for(var pk in s.properties){var nestedPrefer=preferObject||preferNestedObject(pk);ps[pk]=norm(s.properties[pk],nestedPrefer)}s.properties=ps}delete s.$ref;delete s.oneOf;delete s.anyOf;delete s.allOf;return s}\nfunction addReq(rq,k){if(rq.indexOf(k)<0)rq.push(k)}\nfunction seed(s){var t=(s&&s.type)||'string';return t==='array'?[]:t==='object'?{}:t==='boolean'?false:(t==='integer'||t==='number')?0:''}\nvar H={get:1,post:1,put:1,patch:1,delete:1,head:1,options:1,trace:1},R=[];\nfor(var A in P){var I=P[A]||{},PP=I.parameters||[];for(var M in I){if(!H[M])continue;var X=I[M]||{},N=(X.operationId||M+'_'+A)+'';N=N.toLowerCase().replace(/[^a-z0-9]+/g,'_').replace(/^_|_$/g,'')||'op';var D=X.description||X.summary||N,Q={},L=PP.concat(X.parameters||[]),PS={},RQ=[],PathKeys={};\nfor(var i=0;i<L.length;i++){var V=L[i]||{},K=V.name;if(!K)continue;var W=V.in||'query';if(W==='header'&&/auth|api|key|token|secret|password/i.test(K))continue;Q[K]={source:'toolArg',required:!!V.required,target:W+'.'+K};PS[K]=norm(V.schema||{type:'string'},false);if(W==='path'){Q[K].required=true;PathKeys[K]=true;addReq(RQ,K)}else if(V.required)addReq(RQ,K)}\nvar RB=X.requestBody,BT=null;if(RB){RB=resolve(RB,true);var Cnt=RB.content||{},SC=(Cnt['application/json']||Cnt[Object.keys(Cnt)[0]]||{}).schema||{};SC=norm(SC,true);var G=SC.properties||{};BT={};if(!SC.properties){Q.body={source:'toolArg',required:!!RB.required,target:'body'};PS.body=SC.type?SC:{type:'object',additionalProperties:true};if(RB.required)addReq(RQ,'body')}else{var RR=SC.required||[];for(var B in G){var Prefer=preferNestedObject(B);var S=norm(G[B],Prefer);var Req=RR.indexOf(B)>-1;if(PathKeys[B]