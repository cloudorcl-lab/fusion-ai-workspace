            "sourceCode": "var hex = \"0123456789ABCDEF\";\nvar externalId2 = \"\";\nfor (var i = 0; i < 32; i++) {\n  externalId2 += hex.charAt(Math.floor(Math.random() * 16));\n}\nvar externalDocId = \"\";\ndo {\n  externalDocId = \"\";\n  for (var j = 0; j < 32; j++) {\n    externalDocId += hex.charAt(Math.floor(Math.random() * 16));\n  }\n} while (externalDocId === externalId2);\nvar result = { externalId2: externalId2, externalDocId: externalDocId };\nreturn result;",
            "language": "JAVASCRIPT"
