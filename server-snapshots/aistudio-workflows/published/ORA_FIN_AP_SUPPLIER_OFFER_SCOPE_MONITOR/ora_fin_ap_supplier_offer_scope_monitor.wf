{
  "workflowId": "100002355226966",
  "workflowCode": "ORA_FIN_AP_SUPPLIER_OFFER_SCOPE_MONITOR",
  "name": "Supplier Offer Scope Monitor",
  "description": "Detects and manages user requests that fall outside the supported scope. This assistant identifies off-topic or restricted queries, explains the applicable boundaries, and guides the user to stay on topic",
  "specification": {
    "dataPipeline": {
      "pipelineNodes": [
