        {
          "metadata": {
            "name": "Get payload to get recent conversations",
            "returnType": "object",
            "sourceCode": "const minutesBack = Number($context.$triggers.REST.$input.sinceLastMinutes ?? 60);\nconst cutoffIso = new Date(Date.now() - minutesBack * 60 * 1000)\n  .toISOString()\n  .replace(/\\.\\d{3}Z$/, 'Z');\n\nconst query = \"CreationDate >= '\" + cutoffIso + \"'\";\nconst fields = \"ConversationId,ConversationNumber\";\nconst sort = \"CreationDate:desc\";\n\nconst payload = { query, fields, sort };\nreturn payload;"
          },
          "outcomes": {
            "success": "1774852113432"
          },
          "code": "GET_PAYLOAD_TO_GET_RECENT_CONVERSATIONS",
          "id": "1774852080716",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_CX_SALESFORCE_EMAILS",
            "functionName": "get_all_emails",
            "name": "Get latest email messages"
          },
          "outcomes": {
            "success": "1774852658458"
          },
          "code": "GET_LATEST_EMAIL_MESSAGES",
          "id": "1774852113432",
          "inputs": [
            {
              "id": "1774852113432_query",
