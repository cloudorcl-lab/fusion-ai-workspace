                  },
                  "code": "CHECK_IF_ACCOUNT_ASSOCIATED",
                  "convergenceTargetId": "end",
                  "id": "1774853022879",
                  "inputs": [
                    {
                      "id": "1774853022881_1",
                      "name": "condition",
                      "type": "string",
                      "value": "{{$context.$variables.engagementContext\n  && $context.$variables.engagementContext.association\n  && $context.$variables.engagementContext.association.isAcntAssociated}}"
                    }
                  ],
                  "type": "CONDITION"
                },
                {
                  "metadata": {
                    "name": "Build adaptive search payload for account",
                    "returnType": "object",
                    "sourceCode": "const context = $context.$variables.engagementContext || {};\nconst contacts = context.customerContactEmails || [];\n\nconst values = contacts\n  .map(email => (email || '').trim().toLowerCase())\n  .filter((email, idx, arr) => email && arr.indexOf(email) === idx);\n\nconst payload = {\n  limit: 10,\n  sort: [],\n  entity: 'Account',\n  q: {\n    op: '$in',\n    attribute: 'ListOfContacts.SubjectId.PrimaryEmail',\n    values\n  },\n  fields: ['PartyId', 'PartyNumber']\n};\n\nreturn payload;\n"
                  },
                  "outcomes": {
                    "success": "1774947399561"
                  },
                  "diagram": {
                    "x": 5206.75,
                    "y": 7253
                  },
                  "code": "BUILD_ADAPTIVE_SEARCH_PAYLOAD_FOR_ACCOUNT",
                  "id": "1774947323221",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
