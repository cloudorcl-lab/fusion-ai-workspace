              "name": "fields",
              "type": "string",
              "value": "{{$context.$nodes.GET_PAYLOAD_TO_GET_RECENT_CONVERSATIONS.$output.result.fields}}"
            },
            {
              "id": "1774852113432_sort",
              "name": "sort",
              "type": "string",
              "value": "{{$context.$nodes.GET_PAYLOAD_TO_GET_RECENT_CONVERSATIONS.$output.result.sort}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Get Conversation Ids",
            "returnType": "array",
            "sourceCode": "const items = $context.$nodes.GET_LATEST_EMAIL_MESSAGES.$output.items ?? [];\n\nconst uniqueConversationIds = new Set();\n\nreturn items\n  .filter(({ ConversationId }) => {\n    if (uniqueConversationIds.has(ConversationId)) return false;\n    uniqueConversationIds.add(ConversationId);\n    return true;\n  })\n  .map(({ ConversationId, ConversationNumber }) => ({\n    ConversationId,\n    ConversationNumber\n  }));"
          },
          "outcomes": {
            "success": "1774852705961"
          },
          "code": "GET_CONVERSATION_IDS",
          "id": "1774852658458",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
