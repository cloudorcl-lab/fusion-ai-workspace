                },
                {
                  "metadata": {
                    "name": "Parse account association response",
                    "returnType": "object",
                    "sourceCode": "const context = $context.$variables.engagementContext || {};\nconst association = context.association || {};\nconst resp = $context.$nodes.GET_ACCOUNTS.$output || [];\n\nconst accounts = (Array.isArray(resp) ? resp : [])\n  .filter(item => item && item.PartyNumber)\n  .map(item => ({\n    accountPartyNumber: item.PartyNumber,\n    accountPartyId: item.PartyId\n  }));\n\nassociation.accounts = accounts;\nassociation.isAcntAssociated = accounts.length > 0;\nassociation.isAssociated =\n  association.isAcntAssociated || association.isOptyAssociated || false;\n\nconst cntxtUpd = {\n  ...context,\n  association\n};\n\nreturn cntxtUpd;"
                  },
                  "outcomes": {
                    "success": "1774955663351"
                  },
