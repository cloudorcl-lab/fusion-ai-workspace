          "metadata": {
            "name": "Process Receivables Responses",
            "sourceCode": "let transactions_prev = $context.$nodes.EXECUTE_ACCOUNTED_TRANSACTION_SUMMARY_PREV_PERIOD.$output || [];\nlet transactions_curr = $context.$nodes.EXECUTE_ACCOUNTED_TRANSACTION_SUMMARY_CURR_PERIOD.$output || [];\nlet receipts_prev = $context.$nodes.EXECUTE_ACCOUNTED_RECEIPT_SUMMARY_PREV_PERIOD.$output || [];\nlet receipts_curr = $context.$nodes.EXECUTE_ACCOUNTED_RECEIPT_SUMMARY_CURR_PERIOD.$output || [];\n\nconst obj = {\n  previous: {\n    transactions: transactions_prev,\n    receipts: receipts_prev\n  },\n  current: {\n    transactions: transactions_curr,\n    receipts: receipts_curr\n  }\n};\n\nreturn obj;",
            "returnType": "object"
          },
