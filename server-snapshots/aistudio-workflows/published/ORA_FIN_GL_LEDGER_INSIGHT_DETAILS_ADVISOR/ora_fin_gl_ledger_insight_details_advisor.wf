        },
        {
          "id": "1779964689497",
          "code": "IDENTIFY_TOP_JOURNAL_SOURCES",
          "type": "CODE",
          "metadata": {
            "name": "Identify Top Journal Sources",
            "returnType": "array",
            "sourceCode": "try {\n\n    const result = $context.$nodes.PROCESS_JOURNALS_SOURCES_DATA.$output.result || [];\n\n    if (!Array.isArray(result) || result.length === 0) {\n\n      return [];\n\n    }\n\n    // Aggregate netAccountedAmount by journalSource\n\n    const sourceMap = {};\n\n    result.forEach(item => {\n\n      const source = item.journalSource;\n\n      const amount = Math.abs(\n\n        Number(item.netAccountedAmount || 0)\n\n      );\n\n      if (!sourceMap[source]) {\n\n        sourceMap[source] = 0;\n\n      }\n\n      sourceMap[source] += amount;\n\n    });\n\n    // Convert to array\n\n    const sources = Object.entries(sourceMap).map(([journalSource, amount]) => ({\n\n      journalSource,\n\n      netAccountedAmount: amount\n\n    }));\n\n    // Sort descending\n\n    sources.sort((a, b) => b.netAccountedAmount - a.netAccountedAmount);\n\n    // Total amount\n\n    const total = sources.reduce(\n\n      (sum, item) => sum + item.netAccountedAmount,\n\n      0\n\n    );\n\n    // Pick sources contributing to 80%\n\n    let cumulative = 0;\n\n    const selected = [];\n\n    for (const item of sources) {\n\n      const contributionPct =\n\n        total === 0\n\n          ? 0\n\n          : (item.netAccountedAmount / total) * 100;\n\n      cumulative += contributionPct;\n\n      selected.push(item.journalSource);\n\n      // Stop at 80% OR top 5\n\n      if (cumulative >= 80 || selected.length >= 5) {\n\n        break;\n\n      }\n\n    }\n\n    return selected;\n\n  } catch (error) {\n\n    console.error(\"Failed to process journal sources:\", error);\n\n    return [];\n\n  }"
          },
