          "metadata": {
            "name": "Parse Application Context",
            "returnType": "object",
            "sourceCode": "let parseIfString = (value, fallback = {}) => {\n  if (!value) return fallback;\n\n  if (typeof value === \"string\") {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return fallback;\n    }\n  }\n\n  if (typeof value === \"object\") {\n    return value;\n  }\n\n  return fallback;\n};\n\nlet resultRaw = $context.$nodes.FETCH_APPLICATION_CONTEXT.$output.output || \"{}\";\n\nlet appContextRaw =\n  $context.$variables.OraAppContext ||\n  $context.$triggers.REST.$input.OraAppContext ||\n  \"{}\";\n\nlet appContext = parseIfString(appContextRaw);\nlet res = parseIfString(resultRaw);\n\nreturn {\n  ...(res?.result || {}),\n  insightId: appContext?.insightId\n};"
          },
