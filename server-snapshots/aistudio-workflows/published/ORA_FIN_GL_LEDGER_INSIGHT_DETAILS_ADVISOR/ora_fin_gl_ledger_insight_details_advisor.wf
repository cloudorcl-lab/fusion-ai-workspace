          "metadata": {
            "name": "Determine Message Hint",
            "returnType": "string",
            "sourceCode": "let oraMsg = $context.$app.$OraMessageHint || \"\";\nlet msg = \"\";\n\nlet resolvedActionCode = \"openInsight\";\n\ntry {\n  const rawInput = $context.$app.$OraAction || \"\";\n\n  if ( (typeof rawInput == 'string') &&  rawInput.startsWith(\"<oraFormSubmit\")) {\n    const match = rawInput.match(\n      /<oraFormSubmit\\s+id=[\"']([^\"']*)[\"'][^>]*>(.*?)<\\/oraFormSubmit>/s\n    );\n\n    if (match && match[1]) {\n      resolvedActionCode = match[1];\n    }\n  } else {\n    let parsedInput = {};\n\n    if (rawInput) {\n      parsedInput = JSON.parse(rawInput);\n\n      if (typeof parsedInput === \"string\") {\n        parsedInput = JSON.parse(parsedInput);\n      }\n    }\n\n    if (parsedInput?.secActionCode) {\n      resolvedActionCode = parsedInput.secActionCode;\n    }\n  }\n} catch (e) {}\n\n\nlet count = $context.$nodes.INITIALIZE_APPLICATION_CONTEXT.$input.count;\n\nif (\n//  (count===1 && oraMsg === \"Query\") ||\n  oraMsg === \"InitDisplay\" ||\n  oraMsg === \"Summary\" ||\n  oraMsg === \"InitSubtitle\" ||\n  (oraMsg === \"InvokeAction\" && resolvedActionCode === \"explain\")\n) {\n  msg = \"initialFlow\";\n} else {\n  msg = oraMsg;\n}\n\nreturn msg;"
          },
