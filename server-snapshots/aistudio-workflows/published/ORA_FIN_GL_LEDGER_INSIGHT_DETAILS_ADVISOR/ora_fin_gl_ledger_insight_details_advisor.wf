        {
          "metadata": {
            "description": "",
            "name": "Process Journals Data Response",
            "returnType": "array",
            "sourceCode": "let prevJournals = $context.$nodes?.FETCH_JOURNALS_DATA_FOR_PREVIOUS_PERIOD?.$output || [];\nlet currJournals = $context.$nodes?.FETCH_JOURNALS_DATA_FOR_CURRENT_PERIOD?.$output || [];\n\nreturn [...prevJournals,  ...currJournals];\n\n/*\nconst getJournalsFromAvExtract = avExtractResult => {\n  const records =\n    avExtractResult?.ledgerLevelAvData?.flatMap(level =>\n      level?.childLevelAvData?.records ??\n      level?.currentLevelAvData?.records ??\n      []\n    ) ?? [];\n\n  return records;\n};\n*/"
          },
