          "id": "1779359692829",
          "code": "PREPARE_JOURNAL_PAYLOADS_FOR_BOTH_PERIODS",
          "type": "PARALLEL",
          "inputs": [],
          "convergenceTargetId": "1779343313764"
        },
        {
          "metadata": {
            "name": "Prepare Payload For Variance Queries",
            "sourceCode": "let result = {};\ntry {\n  const prevPayloadOutput = $context.$nodes?.FETCH_PREVIOUS_PERIOD_PAYABLES_PAYLOADS_FROM_SOURCE?.$output;\n  const currPayloadOutput = $context.$nodes?.FETCH_CURRENT_PERIOD_PAYABLES_PAYLOADS_FROM_SOURCE?.$output;\n\n  let prevResult = {};\n  if (prevPayloadOutput && typeof prevPayloadOutput.output === 'string') {\n    try {\n      prevResult = JSON.parse(prevPayloadOutput.output);\n    } catch {\n      prevResult = {};\n    }\n  } else if (prevPayloadOutput && typeof prevPayloadOutput.output === 'object' && prevPayloadOutput.output !== null) {\n    prevResult = prevPayloadOutput.output;\n  } else {\n    prevResult = {};\n  }\n\n  let currResult = {};\n  if (currPayloadOutput && typeof currPayloadOutput.output === 'string') {\n    try {\n      currResult = JSON.parse(currPayloadOutput.output);\n    } catch {\n      currResult = {};\n    }\n  } else if (currPayloadOutput && typeof currPayloadOutput.output === 'object' && currPayloadOutput.output !== null) {\n    currResult = currPayloadOutput.output;\n  } else {\n    currResult = {};\n  }\n\n  // Combine prevResult and currResult into a single object with keys suffixed by _prev and _curr respectively\n  const combinedResult = {};\n\n  // Add keys from prevResult with _prev suffix\n  prevResult = prevResult?.result || {};\n  for (const key in prevResult) {\n    if (Object.prototype.hasOwnProperty.call(prevResult, key)) {\n      combinedResult[`${key}_prev`] = prevResult[key];\n    }\n  }\n\n  // Add keys from currResult with _curr suffix\n  currResult = currResult?.result || {};\n  for (const key in currResult) {\n    if (Object.prototype.hasOwnProperty.call(currResult, key)) {\n      combinedResult[`${key}_curr`] = currResult[key];\n    }\n  }\n\n  result = combinedResult;\n} catch (error) {\n  result = {};\n}\n\nreturn result;",
            "returnType": "object"
          },
