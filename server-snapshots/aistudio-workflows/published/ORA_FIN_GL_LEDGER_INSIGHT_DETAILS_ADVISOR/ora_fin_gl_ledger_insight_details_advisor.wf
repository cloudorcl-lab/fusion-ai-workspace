          "id": "1779343711816",
          "code": "EXECUTE_PAYABLES_QUERIES",
          "type": "PARALLEL",
          "inputs": [],
          "convergenceTargetId": "1779469457659"
        },
        {
          "metadata": {
            "name": "Identify Top Suppliers",
            "sourceCode": "let obj = $context.$nodes.PROCESS_PAYABLES_RESPONSE.$output.result || {};\n\nconst previousSupplierMap = {};\nconst currentSupplierMap = {};\n\n// Previous invoices\nfor (const invoice of obj.previous?.invoices || []) {\n  const supplier = invoice.supplier;\n\n  if (!previousSupplierMap[supplier]) {\n    previousSupplierMap[supplier] = {\n      invoiceNet: 0,\n      paymentNet: 0\n    };\n  }\n\n  previousSupplierMap[supplier].invoiceNet += invoice.netUnroundedAccountedAmount || 0;\n}\n\n// Previous payments\nfor (const payment of obj.previous?.payments || []) {\n  const supplier = payment.supplier;\n\n  if (!previousSupplierMap[supplier]) {\n    previousSupplierMap[supplier] = {\n      invoiceNet: 0,\n      paymentNet: 0\n    };\n  }\n\n  previousSupplierMap[supplier].paymentNet += payment.netUnroundedAccountedAmount || 0;\n}\n\n// Current invoices\nfor (const invoice of obj.current?.invoices || []) {\n  const supplier = invoice.supplier;\n\n  if (!currentSupplierMap[supplier]) {\n    currentSupplierMap[supplier] = {\n      invoiceNet: 0,\n      paymentNet: 0\n    };\n  }\n\n  currentSupplierMap[supplier].invoiceNet += invoice.netUnroundedAccountedAmount || 0;\n}\n\n// Current payments\nfor (const payment of obj.current?.payments || []) {\n  const supplier = payment.supplier;\n\n  if (!currentSupplierMap[supplier]) {\n    currentSupplierMap[supplier] = {\n      invoiceNet: 0,\n      paymentNet: 0\n    };\n  }\n\n  currentSupplierMap[supplier].paymentNet += payment.netUnroundedAccountedAmount || 0;\n}\n\nconst suppliers = new Set([\n  ...Object.keys(previousSupplierMap),\n  ...Object.keys(currentSupplierMap)\n]);\n\nconst supplierRanking = [];\n\nfor (const supplier of suppliers) {\n  const previousInvoiceNet = previousSupplierMap[supplier]?.invoiceNet || 0;\n  const previousPaymentNet = previousSupplierMap[supplier]?.paymentNet || 0;\n\n  const currentInvoiceNet = currentSupplierMap[supplier]?.invoiceNet || 0;\n  const currentPaymentNet = currentSupplierMap[supplier]?.paymentNet || 0;\n\n  const previousPeriodNetActivity = Math.abs(previousInvoiceNet - previousPaymentNet);\n  const currentPeriodNetActivity = Math.abs(currentInvoiceNet - currentPaymentNet);\n\n  const variance = currentPeriodNetActivity - previousPeriodNetActivity;\n\n  supplierRanking.push({\n    supplier,\n    previousInvoiceNet,\n    previousPaymentNet,\n    previousPeriodNetActivity,\n    currentInvoiceNet,\n    currentPaymentNet,\n    currentPeriodNetActivity,\n    variance,\n    rankingAmount: Math.abs(variance)\n  });\n}\n\nconst topSuppliers = supplierRanking\n  .sort((a, b) => b.rankingAmount - a.rankingAmount)\n\nreturn topSuppliers;\n/*\nconst top3Suppliers = topSuppliers.map(item => item.supplier);\nreturn top3Suppliers;\n*/",
            "returnType": "array"
          },
