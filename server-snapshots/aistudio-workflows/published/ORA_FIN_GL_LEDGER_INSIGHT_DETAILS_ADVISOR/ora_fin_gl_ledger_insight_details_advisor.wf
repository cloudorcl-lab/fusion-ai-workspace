        {
          "metadata": {
            "name": "Process Payables Invoice Response",
            "sourceCode": "let invoice_prev = $context.$nodes.EXECUTE_SUBLEDGER_TXN_PREV_PERIOD.$output || [];\nlet invoice_curr = $context.$nodes.EXECUTE_SUBLEDGER_TXN_CURRENT_PERIOD.$output || [];\nlet payments_prev = $context.$nodes.EXECUTE_SUBLEDGER_PAYMENTS_PREV_PERIOD.$output || [];\nlet payments_curr = $context.$nodes.EXECUTE_SUBLEDGER_PAYMENTS_CURRENT_PERIOD.$output || [];\nlet pre_payments_prev = $context.$nodes.EXECUTE_SUBLEDGER_PRE_PAYMENTS_PREV_PERIOD.$output || [];\nlet pre_payments_curr = $context.$nodes.EXECUTE_SUBLEDGER_PRE_PAYMENTS_CURRENT_PERIOD.$output || []; \n\n\nconst obj = {\n  previous: {\n    invoices: invoice_prev,\n    payments: payments_prev,\n    pre_payments: pre_payments_prev\n  },\n  current: {\n    invoices: invoice_curr,\n    payments: payments_curr,\n    pre_payments: pre_payments_curr\n  }\n};\n\nreturn obj;",
