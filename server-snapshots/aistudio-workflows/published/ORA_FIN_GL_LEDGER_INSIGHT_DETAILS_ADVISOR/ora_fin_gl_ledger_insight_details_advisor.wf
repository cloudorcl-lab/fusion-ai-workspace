        {
          "metadata": {
            "name": "Process payload for previous period - Journals",
            "sourceCode": "const parseStringSafely = (input) => {\n  let payload = input;\n  let parseDepth = 0;\n  const maxParseDepth = 10;\n\n  try {\n    while (typeof payload === \"string\" && parseDepth < maxParseDepth) {\n      const trimmed = payload.trim();\n\n      if (!trimmed) {\n        return {};\n      }\n\n      payload = JSON.parse(trimmed);\n      parseDepth++;\n    }\n\n    return payload ?? {};\n  } catch (error) {\n    return {};\n  }\n};\n\nconst outputPayload =\n  $context.$nodes?.FETCH_PAYLOAD_FOR_PREVIOUS_PERIOD_JOURNALS?.$output?.output ?? \"\";\n\nconst parsedPayload = parseStringSafely(outputPayload);\n\nreturn parsedPayload?.result ?? {};",
            "returnType": "object"
          },
