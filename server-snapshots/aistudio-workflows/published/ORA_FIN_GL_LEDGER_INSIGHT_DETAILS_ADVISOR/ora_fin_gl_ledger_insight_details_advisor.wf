        {
          "id": "1781186865215",
          "code": "CONSTRUCT_ADDITIONAL_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Construct Additional Context",
            "returnType": "object",
            "sourceCode": "let obj = {\n  /*\n  bossExtract: {\n    queries\n  },\n  */\n  bossExtract: null,\n  ledgerContext: $context.$nodes?.PARSE_APPLICATION_CONTEXT?.$output?.result?.ledgerName || \"\",\n  analyticView: $context.$nodes?.PARSE_APPLICATION_CONTEXT?.$output?.result?.bossAvName || \"\",\n  ledgerId: $context.$nodes?.PARSE_APPLICATION_CONTEXT?.$output?.result?.ledgerId || \"\",\n  chartOfAccountsId: $context.$nodes?.PARSE_APPLICATION_CONTEXT?.$output?.result?.chartOfAccountsId || \"\",\n  ledgerCategory: $context.$nodes?.PARSE_APPLICATION_CONTEXT?.$output?.result?.ledgerCategory || \"\",\n  conversationId: $context.$workflow?.$conversationId || \"\"\n  // queryType: $context.$nodes?.PROCESS_INSIGHT_CRITERIA_TYPE?.$output?.result?.queryType || \"\"\n};\n\nlet handoffChatHistory =\n  $context.$variables?.initQueryHandoffChatHistory || \"\";\n\nif (handoffChatHistory && typeof handoffChatHistory === \"object\") {\n  try {\n    handoffChatHistory = JSON.stringify(handoffChatHistory);\n  } catch (e) {\n    handoffChatHistory = \"\";\n  }\n} else if (typeof handoffChatHistory !== \"string\") {\n  handoffChatHistory = String(handoffChatHistory || \"\");\n}\n\nlet systemChatHistory = $context.$system?.$chatHistory || \"\";\n\nif (systemChatHistory && typeof systemChatHistory === \"object\") {\n  try {\n    systemChatHistory = JSON.stringify(systemChatHistory);\n  } catch (e) {\n    systemChatHistory = \"\";\n  }\n} else if (typeof systemChatHistory !== \"string\") {\n  systemChatHistory = String(systemChatHistory || \"\");\n}\n\nobj.handoffChatHistory = [handoffChatHistory, systemChatHistory]\n  .filter(Boolean)\n  .join(\"\\n\");\n\nreturn obj;"
          },
