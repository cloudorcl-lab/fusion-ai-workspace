        {
          "metadata": {
            "name": "Pre Process Payables Invoice Queries",
            "returnType": "object",
            "sourceCode": "let payload = $context.$nodes.PREPARE_PAYLOAD_FOR_VARIANCE_QUERIES.$output.result;\nlet topSuppliers = $context.$nodes.IDENTIFY_TOP_SUPPLIERS.$output.result || [];\ntopSuppliers = topSuppliers\n  .slice(0, 3)\n  .map(item => item?.supplier)\n  .filter(Boolean);\n\nlet supplierQuery = `supplierName IN (${topSuppliers.map(name => `'${name}'`).join(\", \")})`;\n\nif(topSuppliers.length == 0) supplierQuery = `1=1`;\n\nconst replacePlaceholderInEntrySelects = (\n  inputObj,\n  replacement,\n  placeholder = \"$ora_query_by_entity\"\n) => {\n  Object.values(inputObj ?? {}).forEach(entry => {\n    if (typeof entry?.select === \"string\") {\n      entry.select = entry.select.replaceAll(placeholder, replacement);\n    }\n  });\n\n  return inputObj;\n};\n\nreturn replacePlaceholderInEntrySelects(payload, supplierQuery, \"$ora_query_by_entity\");"
          },
