            "name": "Process Journals Query Payload 1",
            "sourceCode": "let result = {};\ntry {\n  \n    const payloadString = $context.$nodes?.PREPARE_JOURNALS_QUERY_FROM_SOURCE_QUERY?.$output?.output || '';\n    if (typeof payloadString === 'string' && payloadString.trim().length > 0) {\n      const parsedPayload = JSON.parse(payloadString);\n      result = parsedPayload.result || {};\n    } else {\n      result = {};\n    }\n  \n} catch (error) {\n  result = {};\n}\nreturn result;",
            "returnType": "object"
          },
