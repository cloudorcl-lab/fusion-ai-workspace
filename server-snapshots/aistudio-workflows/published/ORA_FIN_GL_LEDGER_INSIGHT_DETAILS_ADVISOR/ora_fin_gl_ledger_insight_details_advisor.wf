          "metadata": {
            "description": "",
            "name": "Process Journals Sources Data",
            "sourceCode": "let journals = $context.$nodes?.FETCH_JOURNALS_SOURCES?.$output || [];\n\nreturn journals;\n/*\nconst getJournals = avExtractResult => {\n  const records =\n    avExtractResult?.ledgerLevelAvData?.flatMap(level =>\n      level?.childLevelAvData?.records ??\n      level?.currentLevelAvData?.records ??\n      []\n    ) ?? [];\n\n  return records;\n};\n\nlet avExtractResult = $context.$nodes?.FETCH_JOURNALS_SOURCES?.$output?.avExtractResult;\nreturn getJournals(avExtractResult) || [];\n*/",
            "returnType": "array"
          },
          "diagram": {
