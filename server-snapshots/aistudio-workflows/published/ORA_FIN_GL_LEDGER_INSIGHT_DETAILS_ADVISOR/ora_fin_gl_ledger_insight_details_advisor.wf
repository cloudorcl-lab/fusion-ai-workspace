        {
          "id": "1779978209854",
          "code": "PROCESS_JOURNALS_QUERY_PAYLOAD",
          "type": "CODE",
          "metadata": {
            "name": "Process Journals Query Payload",
            "returnType": "object",
            "sourceCode": "const parseStringSafely = (input) => {\n  let payload = input;\n  let parseDepth = 0;\n  const maxParseDepth = 10;\n\n  try {\n    while (typeof payload === \"string\" && parseDepth < maxParseDepth) {\n      const trimmed = payload.trim();\n\n      if (!trimmed) {\n        return {};\n      }\n\n      payload = JSON.parse(trimmed);\n      parseDepth++;\n    }\n\n    return payload ?? {};\n  } catch (error) {\n    return {};\n  }\n};\n\nconst outputPayload =\n  $context.$nodes?.PREPARE_JOURNEYS_QUERY_FROM_BALANCES?.$output?.output ?? \"\";\n\nconst parsedPayload = parseStringSafely(outputPayload);\n\nreturn parsedPayload?.result ?? {};"
          },
          "diagram": {
