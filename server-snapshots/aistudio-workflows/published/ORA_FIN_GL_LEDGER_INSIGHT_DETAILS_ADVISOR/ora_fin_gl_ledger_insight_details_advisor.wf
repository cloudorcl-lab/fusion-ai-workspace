        {
          "metadata": {
            "name": "Prepare Receivables Transaction Queries",
            "returnType": "object",
            "sourceCode": "let payload = $context.$nodes.PREPARE_PAYLOAD_FOR_VARIANCE_QUERIES.$output.result;\nlet topCustomers = $context.$nodes.IDENTIFY_TOP_CUSTOMERS.$output.result || [];\n\ntopCustomers = topCustomers\n  .slice(0, 3)\n  .map(item => item?.customer)\n  .filter(Boolean);\n\nconst customerList = topCustomers.map(name => `'${name}'`).join(\", \");\n\nconst replacePlaceholderInEntrySelects = (\n  inputObj,\n  placeholder = \"$ora_query_by_entity\"\n) => {\n  Object.values(inputObj ?? {}).forEach(entry => {\n    if (typeof entry?.select === \"string\") {\n      let customerQuery = `1=1`;\n\n      if (topCustomers.length > 0) {\n        const returnFields = entry?.return?.map(field => field.name) || [];\n\n        if (returnFields.includes(\"billToCustomerName\")) {\n          customerQuery = `billToCustomerName IN (${customerList})`;\n        } else if (returnFields.includes(\"customerName\")) {\n          customerQuery = `customerName IN (${customerList})`;\n        }\n      }\n\n      entry.select = entry.select.replaceAll(placeholder, customerQuery);\n    }\n  });\n\n  return inputObj;\n};\n\nreturn replacePlaceholderInEntrySelects(payload, \"$ora_query_by_entity\");"
          },
