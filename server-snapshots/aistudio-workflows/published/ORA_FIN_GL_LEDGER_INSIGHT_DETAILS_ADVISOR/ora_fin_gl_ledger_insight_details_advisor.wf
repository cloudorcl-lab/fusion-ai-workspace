          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "name": "Process Input Parameters for previous period - Journals",
            "sourceCode": "let payload = {};\n\npayload.flowName = \"default\";\npayload.outputType = \"FETCH_JOURNALS_AV_FROM_BALANCES_AV\";\n\n\npayload.queryByPeriod = true;\n\npayload.isCurrentPeriod = false;\npayload.groupBy = [ 'journalSource', 'accountingDate' ];\n\npayload.insightDetails = $context.$nodes.PARSE_INSIGHT_DETAILS.$output.result;\n\npayload.balancesAVRequest = $context.$nodes.PREPARE_PAYLOAD_FOR_BALANCES.$output.result.queries[0];\n\npayload.balancesAVResponse = $context.$nodes.FETCH_BALANCES_DATA_FOR_QUERY.$output;\n\npayload.avMetadata  = [];\npayload.chartOfAccountsMetadata = [];\n\npayload.ledgerName = $context.$nodes.PARSE_APPLICATION_CONTEXT.$output.result.ledgerName;\n\npayload.chartOfAccountsId  = $context.$nodes.PARSE_APPLICATION_CONTEXT.$output.result.chartOfAccountsId;\n\npayload.PARSE_APP_CONTEXT = $context.$nodes.PARSE_APPLICATION_CONTEXT.$output.result;\n\npayload.insightDetails = $context.$nodes.PARSE_INSIGHT_DETAILS.$output.result;\n\npayload.defaultQualifiers = {\n  currency: \"currency\",\n  accountingPeriod: \"fiscalDate\"\n};\n\npayload.defaultDimensions = {\n  \"currency\": {\n    \"currency\": {\n      \"aliases\": {\n        \"$memberName\": \"currency\",\n        \"currencyCode\": \"currencyCode\"\n      }\n    }\n  },\n  \"postingStatus\": {\n    \"postingStatus\": {\n      \"aliases\": {\n        \"$levelName\": \"postingStatusLevel\",\n        \"postingStatusCode\": \"postingStatusCode\"\n      }\n    }\n  },\n  \"fiscalDate\": {\n    \"fiscalDate\": {\n      \"aliases\": {\n        \"$levelName\": \"accountingDateLevel\",\n        \"$memberName\": \"accountingDate\"\n      }\n    }\n  },\n  \"journalSource\": {\n    \"journalSource\": {\n      \"aliases\": {\n        \"$memberName\": \"journalSource\"\n      }\n    }\n  }\n};\n\npayload.defaultFilters = [\n  `fiscalDate.$levelName = 'PERIOD'`,\n  `postingStatus.postingStatusCode = 'P'`,\n  `postingStatus.$levelName = 'POSTINGSTATUS'`,\n  `journalSource.$levelName = 'JESOURCENAME'`,\n  `(accountedCredit != 0 OR accountedDebit != 0 OR enteredDebit != 0 OR enteredCredit != 0 )`\n];\n\npayload.measureAliases = {\n  netAccountedAmount: \"netAccountedAmount\",\n  accountedCredit: \"accountedCredit\",\n  accountedDebit: \"accountedDebit\",\n  enteredDebit: \"enteredDebit\",\n  enteredCredit: \"enteredCredit\",\n  netEnteredAmount: \"netEnteredAmount\",\n};\n\npayload.module = \"oraErpCoreAccountedTransactionsRuntime\";\npayload.name = \"ora_erp_core_accountedTransactions_runtime_x__JournalSummary\";\npayload.orderBy = \"netAccountedAmount\";\n\n\nreturn payload;",
            "returnType": "object"
          },
