            {
              "id": "1783052641836_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Input - {{$context.$nodes.DETERMINE_INSIGHT_FLOW_TYPE.$output.result.periodNames}}\n\nExtract period values from `accountingPeriod.$memberName`.\n\nReturn only this object:\n\n{\n  currPeriod: \"\",\n  prevPeriod: \"\"\n}\n\nRules:\n- If `accountingPeriod.$memberName` has multiple values, use the latest period as `currPeriod` and the other/previous period as `prevPeriod`.\n- If it has one value, use the same value for both `currPeriod` and `prevPeriod`.\n- Ignore everything else.\n- Return only the object. No explanation."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"OutputSpec\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"currPeriod\": {\n      \"type\": \"string\"\n    },\n    \"prevPeriod\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"currPeriod\",\n    \"prevPeriod\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "metadata": {
            "name": "Prepare Payload for Metadata",
            "returnType": "object",
            "sourceCode": "let ledgerId = $context.$nodes.PARSE_APPLICATION_CONTEXT.$output.result?.ledgerId;\nlet payload = {\n    \"parameters\": {\n        \"ledgerId\": ledgerId\n    },\n    \"select\": \"SELECT  funAvMetadata.analyticViewName,funAvMetadataDetail.dimensionDisplayName, funAvMetadataDetail.dimensionSequenceNumber,funAvMetadataDetail.hierarchyDisplayName,funAvMetadataDetail.hierarchyName, funAvMetadataDetail.dimensionAttributeName  FROM  ledger, funAvMetadata,funAvMetadataDetail  WHERE ledger.ledgerId = :ledgerId and ledger.chartOfAccountsId = funAvMetadata.chartOfAccountsId and ledger.calendarId = funAvMetadata.accountingCalendarId and funAvMetadata.usageCode = 'GL_BALANCES_AV' and funAvMetadata.analyticViewId = funAvMetadataDetail.analyticViewId and funAvMetadataDetail.segmentTypeCode = 'COA' order by funAvMetadataDetail.dimensionSequenceNumber\",\n    \"viewQueries\": {\n        \"ledger\": {\n            \"module\": \"oraErpCoreStructure\",\n            \"businessObject\": \"Ledger\",\n            \"view\": \"ledgerList\",\n            \"fieldAliases\": {\n                \"ledgerId\": \"ledgerId\",\n                \"chartOfAccount.structureInstanceNumber\": \"chartOfAccountsId\",\n                \"calendar.calendarId\": \"calendarId\"\n            }\n        },\n        \"funAvMetadata\": {\n            \"module\": \"oraErpCoreCommonObjects\",\n            \"businessObject\": \"AnalyticViewMetadata\",\n            \"view\": \"analyticViewMetadataList\",\n            \"fieldAliases\": {\n                \"usageCode\": \"usageCode\",\n                \"setupFlag\": \"setupFlag\",\n                \"userDefinedName\": \"userDefinedName\",\n                \"analyticViewName\": \"analyticViewName\",\n                \"calendar.calendarId\": \"accountingCalendarId\",\n                \"structureInstance.structureInstanceNumber\": \"chartOfAccountsId\",\n                \"analyticViewId\": \"analyticViewId\"\n            }\n        },\n        \"funAvMetadataDetail\": {\n            \"module\": \"oraErpCoreCommonObjects\",\n            \"businessObject\": \"AnalyticViewMetadataDetail\",\n            \"view\": \"analyticViewMetadataDetailList\",\n            \"fieldAliases\": {\n                \"segmentTypeCode\": \"segmentTypeCode\",\n                \"dimensionLevelAttributes\": \"dimensionLevelAttributes\",\n                \"hierarchyDisplayName\": \"hierarchyDisplayName\",\n                \"dimensionLevelDescriptions\": \"dimensionLevelDescriptions\",\n                \"dimensionSequenceNumber\": \"dimensionSequenceNumber\",\n                \"dimensionAttributes\": \"dimensionAttributes\",\n                \"hierarchyName\": \"hierarchyName\",\n                \"valueSet.valueSetId\": \"valueSetId\",\n                \"dimensionDisplayName\": \"dimensionDisplayName\",\n                \"hierarchyAttributes\": \"hierarchyAttributes\",\n                \"uiFlag\": \"uiFlag\",\n                \"sourceViewName\": \"sourceViewName\",\n                \"dimensionAttributeName\": \"dimensionAttributeName\",\n                \"tree.treeVersionGUID\": \"treeVersionId\",\n                \"analyticViewId\": \"analyticViewId\"\n            }\n        }\n    }\n};\n\nreturn payload;"
          },
          "outcomes": {
            "success": "1778740096574"
          },
