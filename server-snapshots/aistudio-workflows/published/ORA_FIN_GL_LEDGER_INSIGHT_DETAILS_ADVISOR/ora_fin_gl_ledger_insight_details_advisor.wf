          "metadata": {
            "name": "Extract Insight Crtieria",
            "returnType": "object",
            "sourceCode": "let insight = $context.$nodes.FETCH_INSIGHT_DETAILS.$output?.items[0];\nlet policy = insight.sensorSignal.policy;\nlet ruleName = policy?.ruleName;\nlet categoryCode = policy?.categoryCode;\n  let filter = policy?.bossFilter;\n  let decoded = atob(filter || \"\");\n  let parsed = JSON.parse(decoded);\n  let bossExtract = parsed?.steps?.[0]?.bossExtract;\nbossExtract = JSON.stringify(bossExtract);\n\nlet output = {};\noutput.categoryCode = categoryCode;\noutput.bossExtract = bossExtract;\n\nreturn output;"
          },
