            "sourceCode": "let core_txn_prev = $context.$nodes.EXECUTE_RECEIVABLE_ACC_CORE_TXN_PREV_PERIOD.$output || [];\nlet core_txn_curr = $context.$nodes.EXECUTE_RECEIVABLE_ACC_CORE_TXN_CURR_PERIOD.$output || [];\n\nlet adjustments_prev = $context.$nodes.EXECUTE_RECEIVABLE_ACC_ADJUSTMENT_PREV_PERIOD.$output || [];\nlet adjustments_curr = $context.$nodes.EXECUTE_RECEIVABLE_ACC_ADJUSTMENT_CURR_PERIOD.$output || [];\n\nlet credit_memo_apps_prev = $context.$nodes.EXECUTE_RECEIVABLE_ACC_CREDIT_MEMO_APP_PREV_PERIOD.$output || [];\nlet credit_memo_apps_curr = $context.$nodes.EXECUTE_RECEIVABLE_ACC_CREDIT_MEMO_APP_CURR_PERIOD.$output || [];\n\nlet misc_receipts_prev = $context.$nodes.EXECUTE_RECEIVABLE_ACC_MISC_RECEIPT_PREV_PERIOD.$output || [];\nlet misc_receipts_curr = $context.$nodes.EXECUTE_RECEIVABLE_ACC_MISC_RECEIPT_CURR_PERIOD.$output || [];\n\nlet standard_receipts_prev = $context.$nodes.EXECUTE_RECEIVABLE_ACC_STANDARD_RECEIPT_PREV_PERIOD.$output || [];\nlet standard_receipts_curr = $context.$nodes.EXECUTE_RECEIVABLE_ACC_STANDARD_RECEIPT_CURR_PERIOD.$output || [];\n\nlet cash_receipt_history_prev = $context.$nodes.EXECUTE_RECEIVABLE_ACC_CASH_RECEIPT_HISTORY_PREV_PERIOD.$output || [];\nlet cash_receipt_history_curr = $context.$nodes.EXECUTE_RECEIVABLE_ACC_CASH_RECEIPT_HISTORY_CURR_PERIOD.$output || [];\n\nconst obj = {\n  previous: {\n    core_transactions: core_txn_prev,\n    adjustments: adjustments_prev,\n    credit_memo_applications: credit_memo_apps_prev,\n    miscellaneous_receipts: misc_receipts_prev,\n    standard_receipts: standard_receipts_prev,\n    cash_receipt_history: cash_receipt_history_prev\n  },\n  current: {\n    core_transactions: core_txn_curr,\n    adjustments: adjustments_curr,\n    credit_memo_applications: credit_memo_apps_curr,\n    miscellaneous_receipts: misc_receipts_curr,\n    standard_receipts: standard_receipts_curr,\n    cash_receipt_history: cash_receipt_history_curr\n  }\n};\n\nreturn obj;",
            "returnType": "object"
          },
