        {
          "id": "1779969286775",
          "code": "PROCESS_RESOLVED_INSIGHT_CRITERIA",
          "type": "CODE",
          "metadata": {
            "name": "Process Resolved Insight Criteria",
            "returnType": "object",
            "sourceCode": "let output = $context.$nodes.RESOLVE_FILTER_PERIODS_FOR_INSIGHT.$output;\nif(typeof output == 'string'){\n  return JSON.parse(output);\n}\nreturn output;"
          },
          "diagram": {
            "x": 11950,
            "y": 8314
          },
          "outcomes": {
            "success": "1780897486084"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1780897486084",
          "code": "PROCESS_INSIGHT_CRITERIA_TYPE",
          "type": "CODE",
          "metadata": {
            "name": "Process Insight Criteria Type",
            "sourceCode": "const safeJsonParse = (value) => {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  try {\n    return JSON.parse(value);\n  } catch (e) {\n    return null;\n  }\n};\n\nconst getPayload = () => {\n  let payload = $context.$nodes.PROCESS_RESOLVED_INSIGHT_CRITERIA.$output.result || \"\";\n\n  payload = safeJsonParse(payload);\n\n  if (typeof payload === \"string\") {\n    payload = safeJsonParse(payload);\n  }\n\n  return payload || {};\n};\n\nconst getAccountingControlsSourceType = (payload) => {\n  if (payload.viewQueries) {\n    return \"BV\";\n  }\n\n  if (payload.analyticViews) {\n    return \"AV\";\n  }\n\n  return \"\";\n};\n\nconst getVarianceOrAccountingControls = (payload) => {\n  let periodNames = [];\n\n  try {\n    periodNames = getAccountingPeriodMemberNames(payload) || [];\n  } catch (e) {\n    return \"ORA_OTHERS\";\n  }\n\n  return periodNames.length === 2\n    ? \"ORA_VARIANCE\"\n    : \"ORA_OTHERS\";\n};\n\nconst getQueryType = () => {\n  const payload = getPayload();\n\n  const subjectType = getVarianceOrAccountingControls(payload);\n\n  // Rule 1: Variance is always AV\n  if (subjectType === \"ORA_VARIANCE\") {\n    return {\n      subjectType,\n      queryType: \"avExtract\"\n    };\n  }\n\n  // Rule 2: Accounting Controls can be AV or BV\n  const sourceType = getAccountingControlsSourceType(payload);\n\n  if (sourceType === \"BV\") {\n    return {\n      subjectType,\n      queryType: \"bvExtract\"\n    };\n  }\n\n  if (sourceType === \"AV\") {\n    return {\n      subjectType,\n      queryType: \"avExtract\"\n    };\n  }\n\n  return {\n    subjectType,\n    queryType: \"\"\n  };\n};\n\nreturn getQueryType();",
            "returnType": "object"
          },
          "diagram": {
            "x": 11968,
            "y": 8536
          },
          "outcomes": {
            "success": "1780900254715"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
