          "id": "1780405482208",
          "code": "GENERATE_DISPLAY_FOR_JOURNALS_LINES",
          "type": "LLM",
          "metadata": {
            "name": "Generate Display For Journals Lines",
            "answerInUserLanguage": true
          },
