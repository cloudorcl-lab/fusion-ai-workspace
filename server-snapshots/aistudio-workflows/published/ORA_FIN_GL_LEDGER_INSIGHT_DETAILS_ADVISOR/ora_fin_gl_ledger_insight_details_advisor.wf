        {
          "id": "1779962996452",
          "code": "IDENTIFYING_JOURNALS_OR_BALANCES_FOR_QUERY",
          "type": "CODE",
          "metadata": {
            "name": "Identifying Journals Or Balances For Query",
            "returnType": "string",
            "sourceCode": "let bossQ =  JSON.parse( $context.$nodes.RESOLVE_FILTER_PERIODS_FOR_INSIGHT.$output || '');\nlet queries = [];\n\nif(typeof bossQ == \"string\"){\n    bossQ = JSON.parse(bossQ);\n}\n\nif(bossQ.viewQueries) return 'JournalsBV';\nelse if( bossQ.analyticViews ){\n  let name = bossQ.analyticViews.avUsage1.name || '';\n  if( name.endsWith('JournalSummary') ){\n    return 'JournalsAV';\n  }  \n return 'BalancesAV';\n}\n\nreturn '';"
          },
          "diagram": {
            "x": 11453.5,
            "y": 8980
          },
          "outcomes": {
            "success": "1780936515367"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
