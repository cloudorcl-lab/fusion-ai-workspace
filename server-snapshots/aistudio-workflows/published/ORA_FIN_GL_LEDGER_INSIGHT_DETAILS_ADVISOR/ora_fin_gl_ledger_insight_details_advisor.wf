        {
          "metadata": {
            "name": "Process Payables Response",
            "sourceCode": "let invoice_prev = $context.$nodes.EXECUTE_TXN_PREV_PERIOD.$output || [];\nlet invoice_curr = $context.$nodes.EXECUTE_TXN_CURR_PERIOD.$output || [];\nlet payments_prev = $context.$nodes.EXECUTE_PAYMENTS_PREV_PERIOD.$output || [];\nlet payments_curr = $context.$nodes.EXECUTE_PAYMENTS_CURR_PERIOD.$output || [];\n\nconst obj = {\n  previous: {\n    invoices: invoice_prev,\n    payments: payments_prev\n  },\n  current: {\n    invoices: invoice_curr,\n    payments: payments_curr\n  }\n};\n\nreturn obj;",
