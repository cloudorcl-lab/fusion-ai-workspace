            "sourceCode": "let payload = {};\n\npayload.query = $context.$nodes.EXTRACT_INSIGHT_CRTIERIA.$output.result?.bossExtract;\npayload.moduleId = \"47110F64AC0B08E2E040449823C60DB6\";\n\npayload.contextAttribute = \"ledgerId\";\npayload.contextValue = $context.$nodes.PARSE_APPLICATION_CONTEXT.$output.result.ledgerId;\n\npayload.categoryCode = $context.$nodes.EXTRACT_INSIGHT_CRTIERIA.$output.result.bossExtract?.categoryCode;\npayload.resolveExpression = true;\npayload.conditions = [];\npayload.logicalOperator = \"AND\";\npayload.transformQuery = false;\n\nreturn payload;"
          },
