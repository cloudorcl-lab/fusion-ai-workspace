          "id": "1779550198316",
          "code": "PROCESS_JOURNALS_DATA_RESPONSE",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "name": "Process Journals Data By Source and Period",
            "returnType": "array",
            "sourceCode": "const groupByAccountingDateAndJournalSource = (data) =>\n  Object.values(\n    data.reduce((acc, row) => {\n      const key = `${row.accountingDate}||${row.journalSource}`;\n\n      acc[key] ??= {\n        accountingDate: row.accountingDate,\n        journalSource: row.journalSource,\n        enteredDebit: 0,\n        enteredCredit: 0,\n        netEnteredAmount: 0,\n        accountedDebit: 0,\n        accountedCredit: 0,\n        netAccountedAmount: 0,\n        rows: []\n      };\n\n      acc[key].enteredDebit += Number(row.enteredDebit || 0);\n      acc[key].enteredCredit += Number(row.enteredCredit || 0);\n      acc[key].netEnteredAmount += Number(row.netEnteredAmount || 0);\n      acc[key].accountedDebit += Number(row.accountedDebit || 0);\n      acc[key].accountedCredit += Number(row.accountedCredit || 0);\n      acc[key].netAccountedAmount += Number(row.netAccountedAmount || 0);\n\n      acc[key].rows.push(row);\n\n      return acc;\n    }, {})\n  );\n\nlet groupByAccountingDateAndJournalSourceData = groupByAccountingDateAndJournalSource($context.$nodes.PROCESS_JOURNALS_DATA_RESPONSE.$output.result );\n\nreturn groupByAccountingDateAndJournalSourceData;"
          },
          "diagram": {
            "x": 11338,
            "y": 13823
          },
          "outcomes": {
            "success": "1780996195774"
          },
          "id": "1779550204200",
          "code": "PROCESS_JOURNALS_DATA_BY_SOURCE_AND_PERIOD",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "name": "Prepare Top Journal Sources",
            "returnType": "array",
            "sourceCode": "let result = [];\nlet records = $context.$nodes.IDENTIFYING_TOP_JOURNAL_SOURCES.$output.result || [];\n\ntry {\n  const selectedSources = [];\n  let cumulativeContribution = 0;\n\n  for (const journal of records || []) {\n    const source = journal?.journalSource;\n    const contribution = journal?.contributionPercent ?? 0;\n\n    if (!source) {\n      continue;\n    }\n    selectedSources.push(source);\n    /*\n    if (source === \"Payables\" || source === \"Receivables\") {\n\n    } else {\n      selectedSources.push(\"Others\");\n    }\n    */\n    cumulativeContribution += contribution;\n\n    if (cumulativeContribution >= 80 || selectedSources.length >= 5) {\n      break;\n    }\n  }\n\n  result = [...new Set(selectedSources)];\n\n} catch (error) {\n  result = [];\n}\n\nreturn result;",
            "description": ""
          },
          "diagram": {
            "x": 11405.5,
            "y": 14267
          },
          "outcomes": {
            "success": "1779359692829"
          },
          "id": "1779550208122",
          "code": "PREPARE_TOP_JOURNAL_SOURCES",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1780996195774",
          "code": "IDENTIFYING_TOP_JOURNAL_SOURCES",
          "type": "CODE",
          "metadata": {
            "name": "Identifying Top Journal Sources",
            "sourceCode": "let arr = $context.$nodes.PROCESS_JOURNALS_DATA_BY_SOURCE_AND_PERIOD.$output.result || [];\n\nlet periodContext = $context.$nodes.PROCESS_ACCOUNTING_PERIODS.$output || {};\n\nlet prevPeriod = periodContext.prevPeriod;\nlet currPeriod = periodContext.currPeriod;\n\nlet sourceMap = {};\n\narr.forEach(item => {\n  let source = item.journalSource;\n  let period = item.accountingDate;\n  let amount = item.netAccountedAmount ?? 0;\n\n  if (!sourceMap[source]) {\n    sourceMap[source] = {\n      journalSource: source,\n      previousAmount: 0,\n      currentAmount: 0,\n      variance: 0,\n      contributionPercent: 0,\n      rank: 0\n    };\n  }\n\n  if (period === prevPeriod) {\n    sourceMap[source].previousAmount += amount;\n  } else if (period === currPeriod) {\n    sourceMap[source].currentAmount += amount;\n  }\n});\n\nlet result = Object.values(sourceMap).map(item => {\n  item.variance = item.currentAmount - item.previousAmount;\n  return item;\n});\n\nlet totalAbsVariance = result.reduce((sum, item) => {\n  return sum + Math.abs(item.variance);\n}, 0);\n\nresult.forEach(item => {\n  item.contributionPercent =\n    totalAbsVariance === 0\n      ? 0\n      : (Math.abs(item.variance) / totalAbsVariance) * 100;\n});\n\nresult.sort((a, b) => b.contributionPercent - a.contributionPercent);\n\nresult.forEach((item, index) => {\n  item.rank = index + 1;\n});\n\nreturn result;",
            "returnType": "array"
          },
          "diagram": {
            "x": 11387.5,
            "y": 14045
          },
          "outcomes": {
            "success": "1779550208122"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
