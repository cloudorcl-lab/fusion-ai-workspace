                    "sourceCode": "const safeParse = (value) => {\n  if (typeof value === \"string\") {\n    try {\n      return JSON.parse(value);\n    } catch (error) {\n      return {};\n    }\n  }\n\n  return value || {};\n};\n\nlet previous = safeParse(\n  $context.$nodes.EXEC_OTHER_SOURCES_PAYLOADS.EXECUTE_OTHERS_BV_PREV_PERIOD_1.$output\n);\n\nlet current = safeParse(\n  $context.$nodes.EXEC_OTHER_SOURCES_PAYLOADS.EXECUTE_OTHERS_BV_CURR_PERIOD_1.$output\n);\n\nlet source = $context.$nodes.EXEC_OTHER_SOURCES_PAYLOADS.$currentItem || \"Others\";\n\nreturn {\n  [source]: {\n    current,\n    previous\n  }\n};"
                  },
