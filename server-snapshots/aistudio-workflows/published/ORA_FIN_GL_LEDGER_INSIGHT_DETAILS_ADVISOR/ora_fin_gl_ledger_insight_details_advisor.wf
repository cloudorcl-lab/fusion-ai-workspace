          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}"
        },
        {
          "id": "1781184848331",
          "code": "PREPARE_ADDITIONAL_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Additional Context",
            "returnType": "object",
            "sourceCode": "let obj = {\n  /*  bossExtract: {\n    queries\n  },*/ bossExtract: null,\n  ledgerContext: $context?.$nodes?.PARSE_APPLICATION_CONTEXT?.$output?.result?.ledgerName || \"\",\n  analyticView: $context?.$nodes?.PARSE_APPLICATION_CONTEXT?.$output?.result?.bossAvName || \"\",\n  ledgerId: $context?.$nodes?.PARSE_APPLICATION_CONTEXT?.$output?.result?.ledgerId || \"\",\n  chartOfAccountsId: $context?.$nodes?.PARSE_APPLICATION_CONTEXT?.$output?.result?.chartOfAccountsId || \"\",\n  ledgerCategory: $context?.$nodes?.PARSE_APPLICATION_CONTEXT?.$output?.result?.ledgerCategory || \"\",\n  conversationId: $context.$workflow.$conversationId,\n  //   queryType: $context?.$nodes?.PROCESS_INSIGHT_CRITERIA_TYPE?.$output?.result?.queryType || \"\"\n};\n\nlet parseIfString = (value, fallback = {}) => {\n  if (!value) return fallback;\n\n  if (typeof value === \"string\") {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return fallback;\n    }\n  }\n  return value;\n}\n\nlet OraUiContext = $context.$app.$OraUiContext;\n\nobj.handoffChatHistory = [\n  {\n    \"role\": \"USER\",\n    \"text\": $context.$nodes.PARSE_INSIGHT_DETAILS.$output.result.ruleName\n  },\n  {\n    \"role\": \"AI\",\n    \"text\": {\n      \"agent\": \"ora_fin_fun_insights_assistant\",\n      \"agent_response\": parseIfString(OraUiContext)\n    }\n  }\n]\nreturn obj;"
          },
