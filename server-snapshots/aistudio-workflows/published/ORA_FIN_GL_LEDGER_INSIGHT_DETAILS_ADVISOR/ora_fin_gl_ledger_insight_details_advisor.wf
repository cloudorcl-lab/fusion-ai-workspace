        {
          "metadata": {
            "name": "Parse Insight Details",
            "returnType": "object",
            "sourceCode": "let insight = $context.$nodes.FETCH_INSIGHT_DETAILS.$output?.items?.[0];\n\nlet categoryCodeLookup = $context.$variables.OraGLRuleCategory ?? [];\n\nconst categoryLookup = new Map(\n  categoryCodeLookup.map(item => [item.value, item])\n);\n\nlet insightRecipientId = insight?.insightRecipientId;\n\nlet policy = insight?.sensorSignal?.policy;\nlet ruleName = policy?.ruleName;\nlet categoryCode = policy?.categoryCode;\nlet categoryCodeMeaning = categoryLookup.get(categoryCode)?.label;\n\nlet statusCode = insight?.status?.lookupCode;\nlet statusMeaning = insight?.status?.meaning;\n\nlet showOpenActions = statusCode === \"ORA_OPEN\";\nlet showReopenActions = statusCode === \"ORA_DISMISSED\";\n\nlet showExplain = (\n  showOpenActions\n);\n\nlet ledgerId = $context.$nodes.PARSE_APPLICATION_CONTEXT.$output?.result?.ledgerId;\n\nlet insightSummaryMatch = insight?.sensorSignal?.sensorInsightDetails?.items?.find(\n  item => String(item?.insightContextValueId) === String(ledgerId)\n);\n\nlet insightSummary = insightSummaryMatch?.insightSummary ?? \"\";\n\nreturn {\n  insightRecipientId,\n  ruleName,\n  categoryCode,\n  categoryCodeMeaning,\n  insightSummary,\n  statusCode,\n  statusMeaning,\n  showExplain,\n  showOpenActions,\n  showReopenActions\n};"
          },
          "outcomes": {
            "success": "1780935745222"
          },
          "diagram": {
            "x": 12203.5,
            "y": 7204
          },
