        {
          "id": "1779964689501",
          "code": "PREPARE_PAYLOAD_FOR_JOURNALS_QUERY",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Payload for Journals Query",
            "returnType": "object",
            "sourceCode": "let payload = {};\n\npayload.flowName = \"default\";\npayload.outputType = \"FETCH_JOURNALS_BV_FROM_JOURNALS_AV\";\n\npayload.module = 'oraErpCoreAccountingEntries';\npayload.businessObject = 'JournalLine';\npayload.view = 'generalLedgerJournalDetail';\n\npayload.balancesAVRequest = $context.$nodes.PREPARE_JOURNALS_AV_PAYLOAD.$output.result.queries[0];\npayload.balancesAVResponse = $context.$nodes.EXECUTE_JOURNALS_AV_QUERY.$output;\npayload.avMetadata  = $context.$nodes.FETCH_METADATA_INFORMATION.$output;\n\npayload.chartOfAccountsMetadata = $context.$nodes.FETCH_COA_METADATA_INFORMATION.$output?.result;\n\npayload.ledgerName = $context.$nodes.PARSE_APPLICATION_CONTEXT.$output.result.ledgerName;\n\npayload.chartOfAccountsId  = $context.$nodes.PARSE_APPLICATION_CONTEXT.$output.result.chartOfAccountsId;\n\npayload.PARSE_APP_CONTEXT = $context.$nodes.PARSE_APPLICATION_CONTEXT.$output.result;\n\npayload.insightDetails = $context.$nodes.PARSE_INSIGHT_DETAILS.$output.result;\n\npayload.defaultQueries = [\n  \"(accountedCredit != 0 OR accountedDebit != 0 OR enteredDebit != 0 OR enteredCredit != 0 )\",\n  \"batchStatusCode = 'P'\"\n];\n\npayload.fieldAliases = {\n\"header.batch.description\": \"batchDescription\",\n          \"ledger.ledgerId\": \"ledgerId\",\n          \"header.batch.errorMessage\": \"errorMessage\",\n          \"periodName\": \"periodName\",\n          \"description\": \"lineDescription\",\n          \"header.batch.name\": \"batchName\",\n          \"netEnteredAmount\": \"netEnteredAmount\",\n          \"ledger.name\": \"ledgerName\",\n          \"netAccountedAmount\": \"netAccountedAmount\",\n          \"header.name\": \"journalName\",\n          \"dateCreated\": \"dateCreated\",\n          \"currency.currencyCode\": \"enteredCurrency\",\n          \"account.concatenatedSegments\": \"concatenatedSegments\",\n          \"journalLineNumber\": \"journalLineNumber\",\n          \"currencyConversionDate\": \"currencyConversionDate\",\n          \"accountingDate\": \"accountingDate\",\n          \"updatedBy\": \"updatedBy\",\n          \"accountedCredit\": \"accountedCredit\",\n          \"header.journalSource.userJeSourceName\": \"journalSource\",\n          \"header.description\": \"journalDescription\",\n          \"ledger.currency.currencyCode\": \"ledgerCurrencyCode\",\n          \"header.batch.lookupBatchStatus.meaning\": \"batchStatus\",\n          \"dateUpdated\": \"dateUpdated\",\n          \"createdBy\": \"createdBy\",\n          \"header.batch.lookupBatchStatus.lookupCode\": \"batchStatusCode\",\n          \"accountedDebit\": \"accountedDebit\",\n          \"enteredDebit\": \"enteredDebit\",\n          \"enteredCredit\": \"enteredCredit\",\n          \"currencyConversionRate\": \"currencyConversionRate\",\n          \"header.journalCategory.userJeCategoryName\": \"journalCategory\"\n        }\n\nreturn payload;"
          },
