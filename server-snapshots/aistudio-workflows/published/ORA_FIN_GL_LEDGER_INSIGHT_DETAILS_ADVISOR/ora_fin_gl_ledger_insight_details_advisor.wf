          "code": "SET_RECEIVABLES_RESPONSES",
          "type": "SET_FIELDS",
          "inputs": [
            {
              "id": "1779470894898_ReceivablesAVResponse",
              "name": "ReceivablesAVResponse",
              "value": "{{$context.$nodes.PROCESS_RECEIVABLES_RESPONSES.$output.result}}"
            }
          ]
        },
        {
          "metadata": {
            "name": "Identify Top Customers",
            "sourceCode": "let obj = $context.$nodes.PROCESS_RECEIVABLES_RESPONSES.$output.result || {};\n\nconst previousCustomerMap = {};\nconst currentCustomerMap = {};\n\nfunction getCustomer(row) {\n  const customer = row?.customer;\n\n  return customer === null || customer === undefined || String(customer).trim() === \"\"\n    ? \"Unknown Customer\"\n    : String(customer).trim();\n}\n\nfunction getAmount(row) {\n  const amount = Number(row?.netUnroundedAccountedAmount);\n  return Number.isFinite(amount) ? amount : 0;\n}\n\nfunction initCustomer(map, customer) {\n  if (!map[customer]) {\n    map[customer] = {\n      transactionNet: 0,\n      receiptNet: 0\n    };\n  }\n}\n\n// Previous transactions\nfor (const transaction of obj.previous?.transactions || []) {\n  const customer = getCustomer(transaction);\n\n  initCustomer(previousCustomerMap, customer);\n\n  previousCustomerMap[customer].transactionNet += getAmount(transaction);\n}\n\n// Previous receipts\nfor (const receipt of obj.previous?.receipts || []) {\n  const customer = getCustomer(receipt);\n\n  initCustomer(previousCustomerMap, customer);\n\n  previousCustomerMap[customer].receiptNet += getAmount(receipt);\n}\n\n// Current transactions\nfor (const transaction of obj.current?.transactions || []) {\n  const customer = getCustomer(transaction);\n\n  initCustomer(currentCustomerMap, customer);\n\n  currentCustomerMap[customer].transactionNet += getAmount(transaction);\n}\n\n// Current receipts\nfor (const receipt of obj.current?.receipts || []) {\n  const customer = getCustomer(receipt);\n\n  initCustomer(currentCustomerMap, customer);\n\n  currentCustomerMap[customer].receiptNet += getAmount(receipt);\n}\n\nconst customers = new Set([\n  ...Object.keys(previousCustomerMap),\n  ...Object.keys(currentCustomerMap)\n]);\n\nconst customerRanking = [];\n\nfor (const customer of customers) {\n  const previousTransactionNet = previousCustomerMap[customer]?.transactionNet || 0;\n  const previousReceiptNet = previousCustomerMap[customer]?.receiptNet || 0;\n\n  const currentTransactionNet = currentCustomerMap[customer]?.transactionNet || 0;\n  const currentReceiptNet = currentCustomerMap[customer]?.receiptNet || 0;\n\n  const previousPeriodNetActivity = Math.abs(previousTransactionNet - previousReceiptNet);\n  const currentPeriodNetActivity = Math.abs(currentTransactionNet - currentReceiptNet);\n\n  const variance = currentPeriodNetActivity - previousPeriodNetActivity;\n\n  customerRanking.push({\n    customer,\n    previousTransactionNet,\n    previousReceiptNet,\n    previousPeriodNetActivity,\n    currentTransactionNet,\n    currentReceiptNet,\n    currentPeriodNetActivity,\n    variance,\n    rankingAmount: Math.abs(variance)\n  });\n}\n\nconst topCustomers = customerRanking\n  .sort((a, b) => b.rankingAmount - a.rankingAmount);\n\nreturn topCustomers;\n\n/*\nconst top3Customers = topCustomers.map(item => item.customer);\nreturn top3Customers;\n*/",
            "returnType": "array"
          },
          "diagram": {
            "x": 11963.25,
            "y": 17867
          },
          "outcomes": {
            "success": "1779445707776"
          },
          "id": "1779470899028",
          "code": "IDENTIFY_TOP_CUSTOMERS",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
