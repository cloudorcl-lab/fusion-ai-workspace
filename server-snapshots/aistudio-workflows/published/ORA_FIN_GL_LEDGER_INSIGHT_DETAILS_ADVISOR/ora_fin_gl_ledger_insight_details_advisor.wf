          "type": "CODE",
          "metadata": {
            "name": "Parse Other Sources Responses",
            "sourceCode": "let fetchPayloads =  $context.$nodes.EXEC_OTHER_SOURCES_PAYLOADS.$output;\n\n// Top-level output may be a JSON string\nif (typeof fetchPayloads === 'string') {\n  fetchPayloads = JSON.parse(fetchPayloads || '[]');\n}\n\nfetchPayloads = Array.isArray(fetchPayloads) ? fetchPayloads : [];\n\nlet output = fetchPayloads.map(item => {\n  let parsed = item;\n\n  // Each item in your array is also a JSON string\n  if (typeof item === 'string') {\n    parsed = JSON.parse(item);\n  }\n\n  return parsed?.result;\n}).filter(Boolean);\n\nreturn output;",
            "returnType": "array"
          },
