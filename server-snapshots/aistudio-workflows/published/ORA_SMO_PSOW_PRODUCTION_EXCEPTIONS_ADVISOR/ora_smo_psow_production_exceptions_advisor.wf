        {
          "metadata": {
            "name": "Extract Exceptions",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.GET_OPEN_EXCEPTIONS.$output;\nconst shiftData = $context.$nodes.EXTRACT_SHIFT_DATA.$output.result;\nconst currentShiftStartTimeWithOffset = shiftData.currentShiftStartTimeWithOffset;\n\nfunction getOffsetMinutes(offsetDateInput) {\n    if (!offsetDateInput) return null;\n\n    const offsetMatch = String(offsetDateInput).match(/(Z|[+-]\\d{2}(?::?\\d{2})?)$/);\n    if (!offsetMatch) return null;\n\n    const offset = offsetMatch[1];\n    if (offset === \"Z\") return 0;\n\n    const match = offset.match(/^([+-])(\\d{2})(?::?(\\d{2}))?$/);\n    if (!match) return null;\n\n    const sign = match[1] === \"+\" ? 1 : -1;\n    const hours = Number(match[2]);\n    const minutes = Number(match[3] || \"0\");\n\n    return sign * (hours * 60 + minutes);\n}\n\nfunction isSameUtcDate(a, b) {\n    return (\n        a.getUTCFullYear() === b.getUTCFullYear() &&\n        a.getUTCMonth() === b.getUTCMonth() &&\n        a.getUTCDate() === b.getUTCDate()\n    );\n}\n\nfunction formatUtcUsingOffsetDate(offsetDateInput, utcInput) {\n    const offsetMinutes = getOffsetMinutes(offsetDateInput);\n    if (offsetMinutes === null) return null;\n\n    const utcDate = new Date(utcInput);\n    if (!Number.isFinite(utcDate.getTime())) return null;\n\n    const localDate = new Date(utcDate.getTime() + offsetMinutes * 60 * 1000);\n    const localNow = new Date(Date.now() + offsetMinutes * 60 * 1000);\n\n    const hour = String(localDate.getUTCHours()).padStart(2, \"0\");\n    const minute = String(localDate.getUTCMinutes()).padStart(2, \"0\");\n\n    if (isSameUtcDate(localDate, localNow)) {\n        return `Today, ${hour}:${minute}`;\n    }\n\n    const months = [\n        \"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\",\n        \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\",\n    ];\n\n    const month = months[localDate.getUTCMonth()];\n    const day = String(localDate.getUTCDate()).padStart(2, \"0\");\n\n    return `${month} ${day}, ${hour}:${minute}`;\n}\n\nconst transformed = data.items\n    .filter(item => item.WorkstationId != null)\n    .map(item => ({\n        Id: item.ExceptionId,\n        Number: item.ExceptionNumber,\n        Type: item.ExceptionType,\n        ExceptionDescription: item.ExceptionDescription,\n        SeverityDescription: item.SeverityDescription,\n        SeverityCode: item.SeverityCode,\n        ExpectedResolutionDate: item.ExpectedResolutionDate,\n        ExpectedResolutionDateLocal: item.ExpectedResolutionDate != null ? formatUtcUsingOffsetDate(currentShiftStartTimeWithOffset, item.ExpectedResolutionDate) : null,\n        ImpactedWorkOrdersCount: item?.ImpactedWorkOrderOperations?.items?.length ?? 0,\n        ImpactedWorkOrders: item?.ImpactedWorkOrderOperations?.items,\n        Status: item.WorkflowStatusCode ? item.WorkflowStatusCode.replace(\"ORA_MFG_\", \"\") : null,\n        WorkstationId: item.WorkstationId\n    }));\n\nreturn transformed;",
            "sourceType": "code"
          },
          "outcomes": {
            "success": "1774930705816"
          },
          "diagram": {
            "x": 5300.763668173204,
            "y": 6903.65192760294
          },
          "code": "EXTRACT_EXCEPTIONS",
