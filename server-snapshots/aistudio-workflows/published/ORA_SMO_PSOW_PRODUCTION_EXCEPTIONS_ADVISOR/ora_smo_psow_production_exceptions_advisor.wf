        {
          "metadata": {
            "name": "Get List of Resource Instance Ids",
            "returnType": "string",
            "sourceCode": "const workCenterData = $context.$nodes.GET_WORKSTATION_EQUIPMENT_RESOURCES_FOR_WORKCENTER.$output;\n\nconst resources = workCenterData.Workstations.items.flatMap(ws => \n    ws.WorkstationEquipmentResources.items.map(eq => ({\n        // Workstation Identifiers\n        workstationId: ws.WorkstationId,\n        workstationCode: ws.WorkstationCode,\n        workstationStatus: ws.WorkstationStatusCode,\n        \n        // Equipment/Resource Identifiers\n        equipmentInstanceId: eq.EquipmentInstanceId,\n        equipmentInstanceCode: eq.EquipmentInstanceCode,\n        resourceId: eq.ResourceId,\n        resourceName: eq.ResourceName,\n       \n        orgId: workCenterData.OrganizationId\n    }))\n);\n\nconst wooResources = $context.$nodes.GET_WORK_ORDER_OPERATION_RESOURCES.$output.result;\n\nconst activeResourceIds = new Set(\n    wooResources\n        .map(woo => woo.ResourceId)\n        .filter(id => id !== null)\n);\n\nconst finalResources = resources.filter(asset => \n    activeResourceIds.has(asset.resourceId)\n);\n\nconst equipmentInstanceIdList = [...new Set(\n    finalResources.map(resource => resource.equipmentInstanceId)\n)].join(',');\n\nreturn equipmentInstanceIdList;"
          },
