          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"OrganizationId\": {\n            \"type\": \"number\"\n          },\n          \"OrganizationCode\": {\n            \"type\": \"string\"\n          },\n          \"OrganizationName\": {\n            \"type\": \"string\"\n          },\n          \"WorkCenterId\": {\n            \"type\": \"string\"\n          },\n          \"WorkCenterCode\": {\n            \"type\": \"string\"\n          },\n          \"WorkCenterName\": {\n            \"type\": \"string\"\n          },\n          \"WorkCenterDescription\": {\n            \"type\": \"string\"\n          },\n          \"InactiveDate\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ],\n            \"format\": \"date-time\"\n          },\n          \"WorkAreaId\": {\n            \"type\": \"number\"\n          },\n          \"HcmDepartmentId\": {\n            \"type\": [\n              \"number\",\n              \"null\"\n            ]\n          },\n          \"HcmDepartmentMeaning\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          },\n          \"WorkAreaCode\": {\n            \"type\": \"string\"\n          },\n          \"WorkAreaName\": {\n            \"type\": \"string\"\n          },\n          \"WorkAreaDescription\": {\n            \"type\": \"string\"\n          },\n          \"OverrideScheduleFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"ResourceCount\": {\n            \"type\": \"number\"\n          },\n          \"Status\": {\n            \"type\": \"string\"\n          },\n          \"ManualWIPMovementFlag\": {\n            \"type\": [\n              \"boolean\",\n              \"null\"\n            ]\n          },\n          \"links\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"rel\": {\n                  \"type\": \"string\"\n                },\n                \"href\": {\n                  \"type\": \"string\"\n                },\n                \"name\": {\n                  \"type\": \"string\"\n                },\n                \"kind\": {\n                  \"type\": \"string\"\n                },\n                \"properties\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"changeIndicator\": {\n                      \"type\": \"string\"\n                    }\n                  }\n                }\n              },\n              \"required\": [\n                \"rel\",\n                \"href\",\n                \"name\",\n                \"kind\"\n              ]\n            }\n          }\n        },\n        \"required\": [\n          \"OrganizationId\",\n          \"OrganizationCode\",\n          \"OrganizationName\",\n          \"WorkCenterId\",\n          \"WorkCenterCode\",\n          \"WorkCenterName\",\n          \"WorkCenterDescription\",\n          \"WorkAreaId\",\n          \"WorkAreaCode\",\n          \"WorkAreaName\",\n          \"WorkAreaDescription\",\n          \"OverrideScheduleFlag\",\n          \"ResourceCount\",\n          \"Status\",\n          \"links\"\n        ]\n      }\n    },\n    \"count\": {\n      \"type\": \"integer\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"integer\"\n    },\n    \"offset\": {\n      \"type\": \"integer\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\"\n          },\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ]\n}",
