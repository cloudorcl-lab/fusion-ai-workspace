        {
          "metadata": {
            "name": "Extract Shift Data",
            "returnType": "object",
            "sourceCode": "const shifts = $context.$nodes.GET_SHIFT_DETAILS.$output.result;\nconst currentShift = shifts.find(shift => shift.ShiftType === \"CURRENT_SHIFT\");\nconst shiftTimes = {\n    currentShiftStartTime: currentShift.StartDateTimeUTC,\n    currentShiftEndTime: currentShift.EndDateTimeUTC,\n    plantTimeZoneCode: currentShift.PlantTimezoneCode,\n    currentShiftStartTimeWithOffset: currentShift.StartDateTime\n};\n\nreturn shiftTimes;"
          },
          "diagram": {
            "x": 5525.565888405224,
            "y": 6782.346850505765
          },
          "outcomes": {
            "success": "1767673428321"
          },
          "id": "1778201279896",
          "code": "EXTRACT_SHIFT_DATA",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "name": "Process Maintenance Work Orders",
            "returnType": "object",
            "sourceCode": "const mwos = $context.$nodes.GET_MAINTENANCE_WORK_ORDERS.$output;\nconst shiftData = $context.$nodes.EXTRACT_SHIFT_DATA.$output.result;\nconst currentShiftStartTimeWithOffset = shiftData.currentShiftStartTimeWithOffset;\n\nfunction getOffsetMinutes(offsetDateInput) {\n  if (!offsetDateInput) return null;\n\n  const offsetMatch = String(offsetDateInput).match(/(Z|[+-]\\d{2}(?::?\\d{2})?)$/);\n  if (!offsetMatch) return null;\n\n  const offset = offsetMatch[1];\n  if (offset === \"Z\") return 0;\n\n  const match = offset.match(/^([+-])(\\d{2})(?::?(\\d{2}))?$/);\n  if (!match) return null;\n\n  const sign = match[1] === \"+\" ? 1 : -1;\n  const hours = Number(match[2]);\n  const minutes = Number(match[3] || \"0\");\n\n  return sign * (hours * 60 + minutes);\n}\n\nfunction isSameUtcDate(a, b) {\n  return (\n    a.getUTCFullYear() === b.getUTCFullYear() &&\n    a.getUTCMonth() === b.getUTCMonth() &&\n    a.getUTCDate() === b.getUTCDate()\n  );\n}\n\nfunction formatUtcUsingOffsetDate(offsetDateInput, utcInput) {\n  const offsetMinutes = getOffsetMinutes(offsetDateInput);\n  if (offsetMinutes === null) return null;\n\n  const utcDate = new Date(utcInput);\n  if (!Number.isFinite(utcDate.getTime())) return null;\n\n  const localDate = new Date(utcDate.getTime() + offsetMinutes * 60 * 1000);\n  const localNow = new Date(Date.now() + offsetMinutes * 60 * 1000);\n\n  const hour = String(localDate.getUTCHours()).padStart(2, \"0\");\n  const minute = String(localDate.getUTCMinutes()).padStart(2, \"0\");\n\n  if (isSameUtcDate(localDate, localNow)) {\n    return `Today, ${hour}:${minute}`;\n  }\n\n  const months = [\n    \"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\",\n    \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\",\n  ];\n\n  const month = months[localDate.getUTCMonth()];\n  const day = String(localDate.getUTCDate()).padStart(2, \"0\");\n\n  return `${month} ${day}, ${hour}:${minute}`;\n}\n\nconst result = mwos.items.map((mwo) => {\n  const plannedStartDateLocal = formatUtcUsingOffsetDate(currentShiftStartTimeWithOffset, mwo.PlannedStartDate);\n  const plannedCompleteDateLocal = formatUtcUsingOffsetDate(currentShiftStartTimeWithOffset, mwo.PlannedCompletionDate);\n  return {\n    ...mwo,\n    PlannedStartDateLocal: plannedStartDateLocal,\n    PlannedCompleteDateLocal: plannedCompleteDateLocal\n  };\n});\n\nreturn result;"
          },
          "diagram": {
            "x": 6148.70247027542,
            "y": 11810.944007327455
          },
          "outcomes": {
            "success": "1775057162618"
          },
          "id": "1778201942347",
          "code": "PROCESS_MAINTENANCE_WORK_ORDERS",
