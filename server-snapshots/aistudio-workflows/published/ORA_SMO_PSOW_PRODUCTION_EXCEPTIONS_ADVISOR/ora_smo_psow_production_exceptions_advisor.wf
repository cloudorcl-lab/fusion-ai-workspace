          "metadata": {
            "name": "Get Maintenance Work Order Query",
            "returnType": "string",
            "sourceCode": "const data = $context.$nodes.GET_ASSET_DETAILS_FOR_EQUIPMENT_INSTANCES.$output;\n\n// 1. Extract asset numbers with safety checks for nested arrays\nconst assetNumbers = (data?.items || []).flatMap(resource => \n    (resource.EquipmentInstance?.items || [])\n        .map(instance => instance.AssetNumber)\n        .filter(val => val) \n);\n\n// 2. Determine the content of the IN clause\n// If uniqueAssets has items, format them. Otherwise, default to '0'.\nconst uniqueAssets = [...new Set(assetNumbers)];\nconst assetListFormatted = uniqueAssets.length > 0 \n    ? uniqueAssets.map(asset => `'${asset}'`).join(',') \n    : \"'0'\";\n\n// 3. Construct the final filter string\nconst statusFilter = \"WorkOrderStatusCode IN ('ORA_RELEASED','ORA_UNRELEASED')\";\nconst finalFilterString = `${statusFilter} AND (AssetNumber IN (${assetListFormatted}))`;\n\nreturn finalFilterString;"
          },
          "outcomes": {
            "success": "1775056780593"
          },
