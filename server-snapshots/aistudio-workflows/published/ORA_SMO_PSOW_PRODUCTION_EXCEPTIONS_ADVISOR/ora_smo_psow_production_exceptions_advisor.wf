          "metadata": {
            "name": "Process Exceptions",
            "returnType": "object",
            "sourceCode": "const exceptions = $context.$nodes.EXTRACT_EXCEPTIONS.$output.result;\n\nconst maintenanceWorkOrders = $context.$nodes.FETCH_MAINTENANCE_WORK_ORDER_DOCREF.$output.items;\n\nconst workstationStatuses = $context.$nodes.PROCESS_FETCHING_WORKSTATION_STATUSES.$output.result;\n\nconst allowedSeverities = new Set([\"ORA_CRITICAL\", \"ORA_HIGH\"]);\n\nconst mergedPayload = exceptions.map((exception) => {\n  const exceptionId = String(exception.Id);\n\n  const matchedWorkOrders = maintenanceWorkOrders.filter((bRec) => {\n    const docItems = bRec?.documentReference?.items || [];\n    return docItems.some(\n      (item) => String(item?.DocumentHeaderId) === exceptionId\n    );\n  });\n\n  const matchedWorkstationStatus = workstationStatuses.find(ws => ws.WorkstationId === exception.WorkstationId);\n  const workstationStatusCode = matchedWorkstationStatus?.WorkstationStatusCode ?? null;\n  exception.WorkstationStatusCode = workstationStatusCode;\n\n  const showWorkstationDownButton = exception.Type === \"Resource\" && exception.WorkstationStatusCode !== \"DOWN\" && allowedSeverities.has(exception.SeverityCode);\n\n  return {\n    ...exception,\n    MaintenanceWorkOrders: matchedWorkOrders,\n    showWorkstationDownButton\n  };\n});\n\nreturn mergedPayload;"
          },
          "outcomes": {
            "success": "1763753720612"
          },
          "diagram": {
