        {
          "metadata": {
            "name": "Extract Actionable Exceptions",
            "returnType": "object",
            "sourceCode": "const input = $context.$nodes.GET_OPEN_EXCEPTIONS.$output?.items || [];\n\nconst isPresent = (val) => val != null && val !== \"\";\n\nconst processedExceptions = $context.$nodes.PROCESS_EXCEPTIONS.$output.result;\n\nconst targetSeverities = [\"ORA_CRITICAL\", \"ORA_HIGH\"];\n\n// 1. Filter equipmentExceptions\nconst equipmentExceptions = input.filter(ex => \n    ex.ExceptionType === \"Resource\" && \n    ex.ResourceType === \"EQUIPMENT\" && \n   isPresent(ex.ResourceInstanceId) && targetSeverities.includes(ex.SeverityCode)\n);\n\n// Remove equipment exceptions when matching processed exception has non-empty MaintenanceWorkOrders\nconst idsToExclude = new Set(\n  processedExceptions\n    .filter(\n      (p) =>\n        Array.isArray(p.MaintenanceWorkOrders) &&\n        p.MaintenanceWorkOrders.length > 0\n    )\n    .map((p) => String(p.Id))\n);\n\nconst filteredEquipmentExceptions = equipmentExceptions.filter(\n  (e) => !idsToExclude.has(String(e.ExceptionId))\n);\n\n// 2. Filter materialExceptions\nconst materialExceptions = input.filter(ex => \n    ex.ExceptionType === \"Component\"\n);\n\n// 3. Extract Unique Equipment Instance IDs\nconst equipmentInstanceIds = [...new Set(filteredEquipmentExceptions.map(ex => ex?.ResourceInstanceId))].join(\",\");\n\n// 4. Final Result\nconst result = {\n    equipmentExceptions: filteredEquipmentExceptions,\n    materialExceptions,\n    equipmentInstanceIds\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1773670090408"
          },
          "diagram": {
