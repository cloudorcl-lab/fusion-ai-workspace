            "name": "GET WORK ORDER OPERATION RESOURCES",
            "returnType": "object",
            "sourceCode": "const input = $context.$nodes.GET_WORK_ORDER_OPERATIONS_FOR_WORK_ORDERS.$output;\nconst workOrderOperationResources = [];\n\ninput.forEach((jsonString) => {\n  try {\n    const data = JSON.parse(jsonString);\n\n    if (data.items && data.items.length > 0) {\n      data.items.forEach((item) => {\n        const resources = item.EquipmentResources?.items || [];\n\n        if (resources.length === 0) {\n          // Flatten with nulls if no resources exist\n          workOrderOperationResources.push(buildResourceObject(item, null));\n        } else {\n          // Create a unique object for every resource found\n          resources.forEach((res) => {\n            workOrderOperationResources.push(buildResourceObject(item, res));\n          });\n        }\n      });\n    }\n  } catch (e) {\n    console.error(\"Error parsing JSON segment:\", e);\n  }\n});\n\n// Renamed helper function\nfunction buildResourceObject(item, res) {\n  return {\n    WorkOrderOperationResourceId: res ? res.WorkOrderOperationResourceId : null,\n    ResourceId: res ? res.ResourceId : null,\n    ResourceName: res ? res.ResourceName : null,\n    WoOperationId: item.WoOperationId || null,\n    OperationSequence: item.OperationSequenceNumber || null,\n    OperationName: item.OperationName || null,\n    WorkOrderId: item.WorkOrderId || null,\n    WorkOrderNumber: item.WorkOrderNumber || null,\n    ItemNumber: item.ItemNumber || null,\n    TotalQuantity: item.TotalQuantity || null,\n    PlannedStartDate: item.PlannedStartDate || null,\n    PlannedCompletionDate: item.PlannedCompletionDate || null\n  };\n}\n\nreturn workOrderOperationResources;"
          },
          "outcomes": {
            "success": "1775053173041"
          },
          "diagram": {
            "x": 6104,
            "y": 10514
          },
          "code": "GET_WORK_ORDER_OPERATION_RESOURCES",
          "id": "1775029545358",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
