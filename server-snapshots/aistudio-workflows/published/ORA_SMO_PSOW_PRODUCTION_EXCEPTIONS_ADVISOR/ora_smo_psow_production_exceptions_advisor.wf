            "sourceCode": "const extractedParams = $context.$nodes.EXTRACT_ACTION_PARAMS.$output.result;\nconst orgCode = $context.$nodes.GET_ASSET_FROM_ASSET_NUMBER.$output.items[0].OperatingOrganizationCode\nconst assetNumber = extractedParams.params.AssetNumber\nconst exceptionNumber = extractedParams.params.ExceptionNumber\nconst exceptionId = extractedParams.params.ExceptionId\nconst resourceCode = extractedParams.params.ResourceCode\nconst resourceId = extractedParams.params.ResourceId\nconst equipmentInstanceIdentifier = extractedParams.params.EquipmentInstanceIdentifier \nconst equipmentInstanceId = extractedParams.params.EquipmentInstanceId\nconst assetId = extractedParams.params.AssetId\n\nconst output = {\n  OrganizationCode: orgCode,\n  AssetNumber: assetNumber,\n  WorkOrderTypeCode: \"CORRECTIVE\",\n  WorkOrderSubTypeCode: \"ORA_PLANNED\",\n  documentReference: [{\n       DocumentType: \"ORA_PRODUCTION_EXCEPTION\",\n       DocumentNumber: exceptionNumber,\n       DocumentHeaderId: exceptionId, \n       DocumentLineNumber: resourceCode,\n       DocumentLineId: resourceId,\n       DocumentSubLineNumber: equipmentInstanceIdentifier,\n       DocumentSubLineId: equipmentInstanceId,\n       DocumentSubLineLevelOneNumber: assetNumber,\n       DocumentSubLineLevelOneId: assetId,\n       SourceSystemId: 10601,\n       SourceSystemTypeCode: \"INTERNAL\" \n }]\n};\n\n// Convert to JSON string\nconst outputJson = JSON.stringify(output);\n\nreturn outputJson;"
          },
