        {
          "metadata": {
            "name": "GET EXCEPTIONS WITH ASSET DETAILS",
            "returnType": "object",
            "sourceCode": "const equipmentExceptions = $context.$nodes.EXTRACT_ACTIONABLE_EXCEPTIONS?.$output?.result?.equipmentExceptions || [];\n\nconst isPresent = (val) => val != null && val !== \"\";\n\nconst allAssetInstances = ($context.$nodes.GET_ASSET_DETAILS?.$output?.items || []).flatMap(\n    resource => resource?.EquipmentInstance?.items || []\n);\n\nconst assetLookup = new Map(\n    allAssetInstances.map(asset => [String(asset.EquipmentInstanceId), asset])\n);\n\nconst exceptionsWithAssetDetails = equipmentExceptions.map(ex => {\n    const assetMatch = assetLookup.get(String(ex.ResourceInstanceId));\n\n    return {\n        AssetId: assetMatch?.AssetId || null,\n        AssetNumber: assetMatch?.AssetNumber || null,\n        ExceptionNumber: ex?.ExceptionNumber,\n        ExceptionId: ex?.ExceptionId,\n        ResourceCode: ex?.ResourceCode,\n        ResourceId: ex?.ResourceId,\n        EquipmentInstanceIdentifier: assetMatch?.EquipmentIdentifier || ex?.ResourceInstanceCode,\n        EquipmentInstanceId: ex?.ResourceInstanceId,\nExceptionDescription:\nex?.ExceptionDescription\n    };\n}).filter(item => isPresent(item.AssetNumber));\n\nreturn exceptionsWithAssetDetails;"
          },
          "outcomes": {
            "success": "1766872998635"
