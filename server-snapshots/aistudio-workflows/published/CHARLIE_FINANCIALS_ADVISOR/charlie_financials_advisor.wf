          "metadata": {
            "name": "Prepare Data",
            "returnType": "string",
            "sourceCode": "const data = `<advisor id=\"BETA_FINANCIALS_ADVISOR\">\n\n    <description>\n        Provides insights into the company's financial performance against budget, with a focus on operating expenses (OpEx). It highlights significant variances by department and spending category, and details week-over-week changes.\n    </description>\n\n    <knowledge>\n\n        <!-- Section 1: Top-Level OpEx Summary for the Current Quarter -->\n        <opex_summary quarter=\"Q3 2025\" last_updated=\"2025-09-12T18:00:00Z\">\n            <current_qtr_actual_mtd currency=\"USD\">15250000</current_qtr_actual_mtd>\n            <current_qtr_budget_mtd currency=\"USD\">14800000</current_qtr_budget_mtd>\n            <variance currency=\"USD\">450000</variance>\n            <variance_percent>3.04</variance_percent>\n            <status>Over Budget</status>\n        </opex_summary>\n\n        <!-- Section 2: Operating Expenses vs. Budget by Department (Quarter-to-Date) -->\n        <opex_by_department>\n            <department name=\"Sales & Marketing\">\n                <actual_spend>6100000</actual_spend>\n                <budgeted_spend>5800000</budgeted_spend>\n                <variance>300000</variance>\n                <spend_categories>\n                    <category name=\"Travel & Entertainment\">\n                        <actual>952000</actual>\n                        <budget>850000</budget>\n                        <status>Over Budget</status>\n                    </category>\n                    <category name=\"Marketing Programs\">\n                        <actual>2500000</actual>\n                        <budget>2400000</budget>\n                        <status>Over Budget</status>\n                    </category>\n                </spend_categories>\n            </department>\n            <department name=\"Engineering\">\n                <actual_spend>5500000</actual_spend>\n                <budgeted_spend>5500000</budgeted_spend>\n                <variance>0</variance>\n                 <spend_categories>\n                    <category name=\"Cloud Infrastructure\">\n                        <actual>1850000</actual>\n                        <budget>2000000</budget>\n                        <status>Under Budget</status>\n                    </category>\n                    <category name=\"Software Licensing\">\n                        <actual>450000</actual>\n                        <budget>400000</budget>\n                        <status>Over Budget</status>\n                    </category>\n                </spend_categories>\n            </department>\n            <department name=\"Product\">\n                <actual_spend>1500000</actual_spend>\n                <budgeted_spend>1500000</budgeted_spend>\n                <variance>0</variance>\n            </department>\n            <department name=\"Operations & G&A\">\n                <actual_spend>2150000</actual_spend>\n                <budgeted_spend>2000000</budgeted_spend>\n                <variance>150000</variance>\n                 <spend_categories>\n                    <category name=\"Contractor & Professional Services\">\n                        <actual>750000</actual>\n                        <budget>600000</budget>\n                        <status>Over Budget</status>\n                    </category>\n                 </spend_categories>\n            </department>\n        </opex_by_department>\n\n        <!-- Section 3: Weekly Variance History -->\n        <weekly_variance_history>\n            <weekly_variance_report for_week_ending=\"2025-09-12\">\n                <change department=\"Sales & Marketing\" category=\"Travel & Entertainment\">\n                    <weekly_increase_percent>12</weekly_increase_percent>\n                    <weekly_increase_amount>88000</weekly_increase_amount>\n                    <reason>Significant increase in travel spend this week, driven by the sales team's end-of-quarter push for deal closures and attendance at the industry conference in Las Vegas.</reason>\n                    <source>Corporate Card Expense Reports</source>\n                </change>\n                <change department=\"Operations & G&A\" category=\"Contractor & Professional Services\">\n                     <weekly_increase_percent>8</weekly_increase_percent>\n                     <weekly_increase_amount>55000</weekly_increase_amount>\n                     <reason>HR department spend is over budget due to an unplanned 3-month extension for a contractor supporting the Workday implementation. This was approved to de-risk the project's go-live date.</reason>\n                     <source>HR Department Accrual Report</source>\n                </change>\n                <change department=\"Engineering\" category=\"Cloud Infrastructure\">\n                    <weekly_decrease_percent>5</weekly_decrease_percent>\n                    <weekly_decrease_amount>97000</weekly_decrease_amount>\n                    <reason>Cloud spend decreased following the SRE team's optimization efforts last month. Decommissioning of legacy test environments is now reflected in the billing cycle.</reason>\n                    <source>AWS Cost Explorer</source>\n                </change>\n            </weekly_variance_report>\n            <weekly_variance_report for_week_ending=\"2025-09-05\">\n                <change department=\"Sales & Marketing\" category=\"Travel & Entertainment\">\n                    <weekly_increase_percent>7</weekly_increase_percent>\n                    <weekly_increase_amount>51000</weekly_increase_amount>\n                    <reason>Initial ramp-up in travel as sales team begins travel for end-of-quarter meetings and the Las Vegas conference.</reason>\n                    <source>Corporate Card Expense Reports</source>\n                </change>\n                <change department=\"Operations & G&A\" category=\"Contractor & Professional Services\">\n                     <weekly_increase_percent>9</weekly_increase_percent>\n                     <weekly_increase_amount>60000</weekly_increase_amount>\n                     <reason>First full week of billing for the extended Workday implementation contractor.</reason>\n                     <source>HR Department Accrual Report</source>\n                </change>\n                 <change department=\"Engineering\" category=\"Cloud Infrastructure\">\n                    <weekly_decrease_percent>3</weekly_decrease_percent>\n                    <weekly_decrease_amount>55000</weekly_decrease_amount>\n                    <reason>Early positive results from cloud optimization efforts; savings beginning to materialize.</reason>\n                    <source>AWS Cost Explorer</source>\n                </change>\n            </weekly_variance_report>\n             <weekly_variance_report for_week_ending=\"2025-08-29\">\n                <change department=\"Sales & Marketing\" category=\"Travel & Entertainment\">\n                    <weekly_increase_percent>2</weekly_increase_percent>\n                    <weekly_increase_amount>15000</weekly_increase_amount>\n                    <reason>Normal week-over-week travel fluctuation.</reason>\n                    <source>Corporate Card Expense Reports</source>\n                </change>\n                <change department=\"Engineering\" category=\"Software Licensing\">\n                     <weekly_increase_percent>15</weekly_increase_percent>\n                     <weekly_increase_amount>60000</weekly_increase_amount>\n                     <reason>Annual renewal of visualization software licenses for the data science team processed this week.</reason>\n                     <source>Vendor Invoices</source>\n                </change>\n            </weekly_variance_report>\n        </weekly_variance_history>\n\n    </knowledge>\n\n    # Must follow instructions when replying\n\n    ** IMPORTANT ** You must use the following guidelines when constructing any reply:\n\n\n    # Supported Follow Up Actions\n\n    1. Approve spending freeze\n    2. Approve non-critical travel freeze\n\n</advisor>`;\n\nreturn data;"
          },
          "outcomes": {
            "success": "1763418484914"
          },
          "code": "PREPARE_DATA",
          "id": "1763418452144",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Switch"
          },
          "outcomes": {
            "InitDisplay": "1763418509986",
            "Query": "1763419263325",
            "Summary": "1763419553945",
