        {
          "metadata": {
            "name": "Apply Score Filter",
            "returnType": "object",
            "sourceCode": "var jsonData = $context.$nodes.GET_SIMILAR_SERVICE_REQUEST.$output ;\nvar filteredItems = jsonData.items.filter(row => row.$context.search.vectorScore >= $context.$variables.varScore);\nconst result = filteredItems.map(({ messages, ...rest }) => rest);\nreturn result;"
          },
          "outcomes": {
            "success": "end"
