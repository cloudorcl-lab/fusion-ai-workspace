            "name": "Check Content Length"
          },
          "outcomes": {
            "true": "1772617511311",
            "false": "add_false_1772617451765"
          },
          "code": "CHECK_CONTENT_LENGTH",
          "convergenceTargetId": "1771305955283",
          "id": "1772617451765",
          "inputs": [
            {
              "id": "1772617451768_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$variables.varContent.length>2000}}"
