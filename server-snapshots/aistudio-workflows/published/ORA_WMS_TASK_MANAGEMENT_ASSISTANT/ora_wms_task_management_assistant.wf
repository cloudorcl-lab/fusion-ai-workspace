        {
          "metadata": {
            "name": "mergeOrders",
            "returnType": "array",
            "sourceCode": "const combinedResults = [...$context.$nodes.GETLATEORDERS.$output.results, ...$context.$nodes.GETLATEORDERHAVINGTASKS.$output.results]; \nconst filteredResults = combinedResults.map(item => ({\n    order_nbr: item.order_nbr,\n    req_ship_date: item.req_ship_date,\n    cust_name: item.cust_name,\n    create_ts: item.create_ts\n  }));\nfilteredResults.sort((a, b) => new Date(b.create_ts) - new Date(a.create_ts));\n\nconst lateOrders = filteredResults\n\nconst html =lateOrders.map(order => `\n        <strong>Order Number:</strong> ${order.order_nbr}<br>\n        <strong>Required Ship Date:</strong> ${order.req_ship_date}<br>\n        <strong>Customer Name:</strong> ${order.cust_name}<br>\n        <strong>Create TS:</strong> ${order.create_ts}<br>\n        <hr>\n    `).join(' ');\nreturn html;"
          },
          "outcomes": {
            "success": "1765358703545"
          },
          "code": "MERGEORDERS",
          "id": "1765358602652",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
