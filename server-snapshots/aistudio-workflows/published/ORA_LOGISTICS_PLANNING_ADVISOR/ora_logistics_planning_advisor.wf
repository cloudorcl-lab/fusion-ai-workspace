            "sourceCode": "const orderIdArray=[...new Set( $context.$nodes.DEDUPLICATE_WMS_DATA.$output.result.map(item => item[\"Order Nbr\"]))];\nconst csv = orderIdArray.join(',');\nreturn csv;"
