            "functionName": "getWmsOrderForOtm",
            "processJson": true,
            "name": "Get WMS Orders"
          },
          "outcomes": {
            "success": "1768374687876"
          },
          "code": "GET_WMS_ORDERS",
          "convergenceTargetId": "1766575979579",
          "id": "1768148331781",
          "inputs": [
            {
              "id": "1771424535731_1",
              "name": "order_no",
              "type": "string",
              "value": "{{$context.$nodes.GET_FA_ORDER_NBR.$output.result}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Reduce OTM Data for Metrics",
            "returnType": "array",
            "sourceCode": "const otmShipmentData = $context.$nodes.GET_OTM_SHIPMENTS.$output.items;\n\n// Config\nconst RANGE_SIZE = 10;\nconst MAX_UTIL = 100;\n\n// Build ranges [0,10), [10,20), ..., [90,100]\nconst ranges = [];\nfor (let start = 0; start < MAX_UTIL; start += RANGE_SIZE) {\n  const end = Math.min(start + RANGE_SIZE, MAX_UTIL);\n  ranges.push({ start, end });\n}\n\n// Initialize metrics map\nconst metricsMap = new Map();\nfor (let i = 0; i < ranges.length; i++) {\n  const r = ranges[i];\n  const key = `${r.start}-${r.end}`;\n  const mid = (r.start + r.end) / 2;\n  metricsMap.set(key, {\n    range_mid: mid,\n    shipmentCount: 0\n  });\n}\n\n// Iterate shipments and bucket counts using max(volumeUtilization, weightUtilization)\nfor (let i = 0; i < (otmShipmentData ? otmShipmentData.length : 0); i++) {\n  const item = otmShipmentData[i];\n\n  let v = item && item.volumeUtilization != null ? Number(item.volumeUtilization) : null;\n  let w = item && item.weightUtilization != null ? Number(item.weightUtilization) : null;\n\n  // Require at least one to be a number\n  const hasV = v != null && !Number.isNaN(v);\n  const hasW = w != null && !Number.isNaN(w);\n  if (!hasV && !hasW) continue;\n\n  // Convert to 0–100 scale\n  if (hasV) v = v * 100;\n  if (hasW) w = w * 100;\n\n  // Compute max, clamp to [0, 100]\n  let m;\n  if (hasV && hasW) {\n    m = Math.max(v, w);\n  } else {\n    m = hasV ? v : w;\n  }\n  if (m < 0) m = 0;\n  if (m > MAX_UTIL) m = MAX_UTIL;\n\n  // Bucket selection, inclusive of MAX_UTIL in last bucket\n  const start = m === MAX_UTIL ? MAX_UTIL - RANGE_SIZE : Math.floor(m / RANGE_SIZE) * RANGE_SIZE;\n  const end = start + RANGE_SIZE;\n  const key = `${start}-${end}`;\n\n  if (metricsMap.has(key)) {\n    const bucket = metricsMap.get(key);\n    bucket.shipmentCount += 1;\n  }\n}\n\n// Final metrics array ordered by range\nconst metricsData = [];\nfor (let i = 0; i < ranges.length; i++) {\n  const r = ranges[i];\n  const key = `${r.start}-${r.end}`;\n  metricsData.push(metricsMap.get(key));\n}\n\nreturn { metricsData };"
          },
          "outcomes": {
            "success": "1767092261858"
          },
          "code": "REDUCE_OTM_DATA_FOR_METRICS",
          "id": "1768327787638",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Deduplicate WMS Data",
            "returnType": "array",
            "sourceCode": "var wmsData = $context.$nodes.GET_WMS_ORDERS.$output.results || [];\nvar seenIds = new Set();\nvar unique = [];\nfor (var i = 0; i < wmsData.length; i++) {\nvar id = wmsData[i] && wmsData[i][\"Order Nbr\"];\nif (id === undefined || id === null || !seenIds.has(id)) {\nunique.push(wmsData[i]);\nif (id !== undefined && id !== null) seenIds.add(id);\n}\n}\nwmsData = unique;"
          },
          "outcomes": {
            "success": "1768546019500"
          },
