            "name": "Extract Shipment Gids",
            "returnType": "string",
            "sourceCode": "const data = $context.$nodes.GET_OTM_ORDER_MOVEMEMENTS.$output;\n\n// 1) extract shipmentGids into an array\nconst shipmentGids = (data?.items || [])\n  .map(item => item?.shipment?.shipmentGid)\n  .filter(Boolean);\n\n// 2) turn into a string like: [\"gid1\", \"gid2\", ...]\nconst shipmentGidsString = JSON.stringify(shipmentGids).replace(/\",\"/g, '\", \"');\n\nreturn shipmentGidsString;"
          },
