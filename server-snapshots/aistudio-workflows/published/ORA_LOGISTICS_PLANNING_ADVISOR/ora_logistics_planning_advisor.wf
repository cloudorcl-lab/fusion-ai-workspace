        {
          "metadata": {
            "name": "Get WMS Appt Nbr",
            "returnType": "string",
            "sourceCode": "const shipments = $context.$nodes.GET_OTM_SHIPMENTS.$output?.items;\n\nconst ap = new Set();\n\nif (Array.isArray(shipments)) {\nshipments.forEach(shipment => {\nconst val = shipment?.attribute3 ?? shipment?.[\"attribute3\"];\nif (val != null && val !== \"\") {\nap.add(String(val).trim());\n}\n});\n}\n\nreturn Array.from(ap).join(\",\");"
          },
