              "id": "1768143637817_1",
              "name": "prompt",
              "type": "string",
              "value": "Summarize the following OTM Order Release Data and WMS Data in exactly three sentences (no more, no less), preceded by a short, catchy header (3–6 words, Title Case, use h3 tag). Include: total number of orders and their shared source and destination, pickup window (state early and late only without showing actual dates) and the fixed itinerary, combined totals for volumes, weights, and package counts, notable shipment composition (how many ship units and which packaged items), and planning or status highlights from both systems (for example, OTM planning status (in plain english, not exact value), WMS Created versus Allocated, and whether an external load number is present). Do not include URLs, do not display any dates or any bulk plan identifiers, do not use bold or italics or other emphasis, and write in clear, neutral business English; call out any duplicates or inconsistencies such as multiple WMS entries for the same order or missing external load numbers. Highlight the WMS orders that may need wave planning based on the wms order statuses.\n\nData:\nOTM Order Release Data: {{$context.$nodes.REMOVE_NON_PLANNING_STATUSES.$output.result}}\nWMS Data: {{$context.$nodes.GET_WMS_ORDERS.$output}}\n\nAvoid any extra newlines. Do not put sentences in a new line."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_OTMLOGISTICSAPPBO",
            "functionName": "get_orders_latest",
            "processJson": true,
            "name": "Get OTM Order Releases"
          },
          "outcomes": {
            "success": "1768146279729"
          },
          "code": "GET_OTM_ORDER_RELEASES",
          "convergenceTargetId": "1766575979579",
          "id": "1766929601498",
          "inputs": [
            {
              "id": "1772001829339_1",
              "name": "date1",
              "type": "string",
              "value": "{{$context.$nodes.GET_CURRENT_DATE.$output.result[0]}}"
            },
            {
              "id": "1772001829340_2",
              "name": "date2",
              "type": "string",
              "value": "{{$context.$nodes.GET_CURRENT_DATE.$output.result[1]}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Consolidate OTM Data",
            "returnType": "array",
            "sourceCode": "const data = $context.$nodes.GET_OTM_ORDER_RELEASES.$output;\n\nconst resultArray = (data?.items ?? []).map((it) => {\n  // Line-level refnums (flatten across all lines under it.lines.items)\n  const lineRefnums =\n    (it?.lines?.items ?? [])\n      .flatMap((ln) => ln?.refnums?.items ?? [])\n      .filter(Boolean);\n\n  // Header-level refnums (fallback)\n  const headerRefnums = it?.refnums?.items ?? [];\n\n  // Prefer line-level refnums\n  const refnumsItems = (lineRefnums && lineRefnums.length > 0) ? lineRefnums : headerRefnums;\n\n  // FAOrderNbr from line-level ORDER NUMBER using orlRefnumValue\n  const faOrderNbrFromLines =\n    lineRefnums\n      ?.find((r) => (r?.orderReleaseRefnumQualGid ?? \"\").endsWith(\".ORDER NUMBER\"))\n      ?.orlRefnumValue ?? null;\n\n  return {\n    sourceLocation: {\n      locationName: it?.sourceLocation?.locationName ?? null,\n      city: it?.sourceLocation?.city ?? null,\n      countryCode3Gid: it?.sourceLocation?.countryCode3Gid ?? null,\n      timeZoneGid: it?.sourceLocation?.timeZoneGid ?? null,\n    },\n    destinationLocation: {\n      locationName: it?.destinationLocation?.locationName ?? null,\n      city: it?.destinationLocation?.city ?? null,\n      countryCode3Gid: it?.destinationLocation?.countryCode3Gid ?? null,\n      timeZoneGid: it?.destinationLocation?.timeZoneGid ?? null,\n    },\n    earlyPickupDate: it?.earlyPickupDate?.value ?? it?.earlyPickupDate ?? null,\n    earlyDeliveryDate: it?.earlyDeliveryDate?.value ?? it?.earlyDeliveryDate ?? null,\n\n    // Use orlRefnumValue from line-level ORDER NUMBER\n    FAOrderNbr: faOrderNbrFromLines,\n\n    // Expose refnums used (line-level preferred, otherwise header)\n    refnums: refnumsItems.map((r) => ({\n      orderReleaseRefnumQualGid: r?.orderReleaseRefnumQualGid ?? null,\n      // For line-level entries, value is orlRefnumValue; for header, it's orderReleaseRefnumValue\n      value: (r?.orlRefnumValue ?? r?.orderReleaseRefnumValue ?? null),\n      level: r?.orlRefnumValue != null ? \"LINE\" : \"HEADER\",\n    })),\n\n    totalWeight: {\n      unit: it?.totalWeight?.unit ?? null,\n      value: it?.totalWeight?.value ?? null,\n    },\n    totalVolume: {\n      unit: it?.totalVolume?.unit ?? null,\n      value: it?.totalVolume?.value ?? null,\n    },\n    statuses: (it?.statuses?.items ?? [])\n      .filter((s) => {\n        const t = s?.statusTypeGid ?? \"\";\n        return t.endsWith(\".PLANNING\") || t.endsWith(\".READY_TO_SHIP\");\n      })\n      .map((s) => ({\n        statusTypeGid: s?.statusTypeGid ?? null,\n        statusValueGid: s?.statusValueGid ?? null,\n      })),\n    orderReleaseXid: it?.orderReleaseXid ?? null,\n  };\n});\n\nreturn resultArray;"
          },
          "outcomes": {
            "success": "1768148255301"
          },
          "code": "CONSOLIDATE_OTM_DATA",
          "convergenceTargetId": "1766575979579",
          "id": "1768146279729",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get FA Order Nbr",
            "returnType": "string",
            "sourceCode": "const data = $context.$nodes.CONSOLIDATE_OTM_DATA.$output.result;\n\nconst orderNumbers = new Set();\nfor (const item of (data ?? [])) {\n  const fa = item?.FAOrderNbr;\n  if (fa != null && fa !== \"\") {\n    orderNumbers.add(String(fa));\n  }\n}\n\n// Comma-separated string\nconst orderNumbersCsv = [...orderNumbers].join(\",\");\nreturn orderNumbersCsv;"
          },
          "outcomes": {
            "success": "1768148331781"
          },
          "code": "GET_FA_ORDER_NBR",
          "convergenceTargetId": "1766575979579",
          "id": "1768148255301",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
