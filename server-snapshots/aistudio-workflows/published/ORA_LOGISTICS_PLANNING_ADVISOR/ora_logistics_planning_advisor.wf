        {
          "metadata": {
            "name": "Get Order Release Gids",
            "returnType": "string",
            "sourceCode": "// response can be either an object or a JSON string\nconst response = $context.$nodes.GET_OTM_ORDER_RELEASES.$output;\nconst data = (typeof response === \"string\") ? JSON.parse(response) : response;\n\n// 1) extract orderReleaseGids into an array\nconst orderReleaseGids = (data?.items || [])\n  .map(item => item?.orderReleaseGid)\n  .filter(Boolean);\n\n// 2) turn into a string like: [\"gid1\", \"gid2\", ...]\nconst gidsString = JSON.stringify(orderReleaseGids).replace(/\",\"/g, '\", \"');\n\nreturn gidsString;"
          },
