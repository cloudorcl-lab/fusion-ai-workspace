        {
          "metadata": {
            "name": "Get Current Date",
            "returnType": "array",
            "sourceCode": "const now = new Date($context.$system.$currentDateTime);\nconst threeDaysMs = 7 * 24 * 60 * 60 * 1000;\n\nconst start = new Date(now.getTime() - threeDaysMs); // 3 days before\nconst end = new Date(now.getTime() + threeDaysMs); // 3 days after\n\nconst dateWindow = [start.toISOString(), end.toISOString()];\nreturn dateWindow;"
          },
          "outcomes": {
            "success": "1766929601498"
          },
          "code": "GET_CURRENT_DATE",
          "id": "1771935422111",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
