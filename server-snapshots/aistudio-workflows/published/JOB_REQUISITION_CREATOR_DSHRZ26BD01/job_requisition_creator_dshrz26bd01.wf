        {
          "metadata": {
            "name": "ExtractUserKeyWords"
          },
          "outcomes": {
            "success": "1772466985662"
          },
          "code": "ExtractUserKeyWords",
          "id": "1771240234248",
          "inputs": [
            {
              "id": "1771240234250_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an AI assistant specialized in keyword extraction for HR systems. \nYour specific task is to extract the core job title or role from {{$context.$system.$inputMessage}} to help search for the correct job requisition template.\n\n*Extraction Rules:*\n1. Extract ONLY the core job title, department, or role.\n2. Correct any spelling errors in the extracted keywords.\n3. Strip away conversational filler (e.g., \"I need a\", \"Create a\").\n4. Remove generic filler words related to employment (e.g., \"employee\", \"worker\", \"job\", \"person\", \"requisition\").\n\n*Examples:*\n- Input: I need a Deli Associate.\n  Output: Deli Associate\n- Input: Create a job requisition for a Payroll Clerk.\n  Output: Payroll Clerk\n- Input: I need a Junior Deli Associate.\n  Output: Junior Deli Associate\n- Input: I need a Deli employee.\n  Output: Deli\n- Input: We are hiring a sftware enginer.\n  Output: Software Engineer\n\n*OUTPUT FORMAT:*\nOutput strictly a single string containing the extracted, corrected keywords. Do not include any prefixes, labels (like \"Output:\"), or punctuation."
            }
          ],
          "outputSpecification": "",
          "type": "LLM"
        },
