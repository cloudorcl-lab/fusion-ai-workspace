              "name": "documentIdentifierItem",
              "type": "string",
              "value": "{{$context.$variables.productItemDocId}}"
            },
            {
              "id": "1774251498816_3",
              "name": "description",
              "type": "string",
              "value": "{{$context.$system.$inputMessage}}"
            },
            {
              "id": "1774251498816_4",
              "name": "productUsage",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.usageCode}}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"value\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "description": "Validates that product query input is present before ingesting.",
            "name": "Validate Product Query"
          },
          "outcomes": {
            "true": "1773166769191",
            "false": "1774341771516"
          },
          "code": "VALIDATE_PRODUCT_QUERY",
          "convergenceTargetId": "end",
          "id": "1773166424780",
          "inputs": [
            {
              "id": "1773166424781_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.query != null && $context.$triggers.REST.$input.query != \"\"}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_CX_SERVICECEN_SRRAGOPERATIONS",
            "description": "Deletes product document from RAG based on productType selection.",
            "errorNodeId": "1773205515104",
            "functionName": "productDelete",
            "processJson": true,
            "name": "Delete Product Data From RAG"
          },
          "outcomes": {
            "success": "1773205515104"
          },
          "code": "DELETE_PRODUCT_DATA_FROM_RAG",
          "id": "1773205479333",
          "inputs": [
            {
              "id": "1774251567005_1",
              "name": "documentIdentifier",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.documentIdToDelete || ($context.$triggers.REST.$input.productType===\"productGroup\" ? $context.$variables.productGroupDocId : $context.$triggers.REST.$input.productType===\"productItem\" ? $context.$variables.productItemDocId:$context.$variables.indexName)}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "description": "Computes pagination offsets from totalResults and fetchSize.",
            "name": "Calculate Category Offset",
            "returnType": "array",
            "sourceCode": "const total = $context.$nodes.FETCH_CATEGORY_COUNT.$output.totalResults;\nconst fetchSizevar = $context.$variables.fetchSize;\n\nlet offsets = [];\nfor (let i = 0; i < total; i = i + fetchSizevar) {\n  offsets.push(i);\n}\n\nreturn offsets;"
          },
          "outcomes": {
            "success": "1773135817608"
          },
          "code": "CALCULATE_CATEGORY_OFFSET",
          "id": "1773135753300",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "description": "Returns category error response to the caller.",
            "name": "Return Invalid Category Query Response"
          },
          "outcomes": {},
          "code": "RETURN_INVALID_CATEGORY_QUERY_RESPONSE",
          "convergenceTargetId": "end",
          "id": "1773135659639",
          "inputs": [
            {
              "id": "1773135659641_1",
              "name": "returnValue",
              "type": "string",
              "value": "{{$context.$nodes.FORMAT_ERROR_MESSAGE_FOR_CATEGORY.$output.result}}"
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "description": "LLM extracts product value from RAG answer.",
            "name": "Extract Product Name"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "EXTRACT_PRODUCT_NAME",
          "id": "1773169150611",
          "inputs": [
            {
              "id": "1773169150612_1",
              "name": "prompt",
              "type": "string",
              "value": "Extract the value of the `product` field from the following input:\n\nanswerData: {{$context.$nodes.FETCH_PRODUCT_DATA_FROM_RAG.$output.value}}\n\nOutput Rules:\n\n* Use exactly the following format:\n\n```json\n{\"product\":\"<product>\"}\n```\n\n* Replace `<product>` with the extracted value.\n* If the `product` field is missing, null, empty, return:\n\n```json\n{\"product\":\"\"}\n```\n\n* Do not include explanations or extra text.\n* Return only the specified JSON format."
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"product\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "description": "Routes flow by productType input to product group or product item ingestion.",
            "name": "Check ProductType"
          },
          "outcomes": {
            "productGroup": "1773168386852",
            "productItem": "1773167008683"
          },
          "code": "CHECK_PRODUCTTYPE",
          "convergenceTargetId": "end",
          "id": "1773166769191",
          "inputs": [
            {
              "id": "1773166769194_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.productType}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
            "description": "Builds a user friendly error message for product failures.",
            "name": "Format Error Message For Product",
            "returnType": "string",
            "sourceCode": "let errorMsg = \"Ingestion failed for product. Please check the provided values and retry.\";\n\ntry {\n\n    if (!$context.$triggers.REST.$input.query) {\n        errorMsg = \"Please provide a valid product query value.\";\n    }\n\n    else if ($context.$nodes.FETCH_PRODUCT_ITEM_COUNT.$error?.$info) {\n        try {\n            const err = JSON.parse(\n                $context.$nodes.FETCH_PRODUCT_ITEM_COUNT.$error.$info\n            );\n\n            errorMsg =\n                err?.[\"o:errorDetails\"]?.[0]?.detail ||\n                \"Invalid Product Item Query\";\n\n        } catch (e) {\n            errorMsg = \"Invalid Product Item Query\";\n        }\n    }\n\n    else if ($context.$nodes.FETCH_PRODUCT_GROUP_COUNT.$error?.$info) {\n        try {\n            const err = JSON.parse(\n                $context.$nodes.FETCH_PRODUCT_GROUP_COUNT.$error.$info\n            );\n\n            errorMsg =\n                err?.[\"o:errorDetails\"]?.[0]?.detail ||\n                \"Invalid Product Group Query\";\n\n        } catch (e) {\n            errorMsg = \"Invalid Product Group Query\";\n        }\n    }\n\n    else if ($context.$nodes.INGEST_PRODUCT_ITEM_INTO_RAG.$error?.$info) {\n        try {\n            const err = JSON.parse(\n                $context.$nodes.INGEST_PRODUCT_ITEM_INTO_RAG.$error.$info\n            );\n\n            errorMsg =\n                err?.details?.[0]?.detail ||\n                \"Ingestion failed for product.\";\n\n        } catch (e) {\n            errorMsg = \"Ingestion failed for product.\";\n        }\n    }\n\n    else if ($context.$nodes.INGEST_PRODUCT_GROUP_INTO_RAG.$error?.$info) {\n        try {\n            const err = JSON.parse(\n                $context.$nodes.INGEST_PRODUCT_GROUP_INTO_RAG.$error.$info\n            );\n\n            errorMsg =\n                err?.details?.[0]?.detail ||\n                \"Ingestion failed for product.\";\n\n        } catch (e) {\n            errorMsg = \"Ingestion failed for product.\";\n        }\n    }\n\n} catch (error) {\n    errorMsg = \"Ingestion failed for product. Please check the provided values and retry.\";\n}\n\nreturn errorMsg;"
          },
          "outcomes": {
            "success": "1773166584539"
          },
          "code": "FORMAT_ERROR_MESSAGE_FOR_PRODUCT",
          "id": "1774341771516",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
