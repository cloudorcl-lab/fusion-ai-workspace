                },
                {
                  "metadata": {
                    "businessObjectCode": "ORA_CX_SERVICECEN_GET_SR_CATEGORY_AND_PRODUCTS",
                    "functionName": "fetchCategory",
                    "processJson": true,
                    "name": "Fetch Category Data",
                    "description": "Fetches one page of category records for the current offset.",
                    "errorNodeId": "1774337590257"
