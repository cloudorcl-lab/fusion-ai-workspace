        {
          "metadata": {
            "description": "Normalizes and flattens fetched category records into JSON for ingestion.",
            "name": "Clean Category Data",
            "returnType": "string",
            "sourceCode": "const categoryList = $context.$nodes.FETCH_CATEGORY_DATA_IN_LOOP.$output || [];\n\nconst categoryResponse = categoryList.flatMap(category => {\n    const parsed = typeof category === 'string' ? JSON.parse(category) : category;\n\n    if (parsed && Array.isArray(parsed.items)) {\n        return parsed.items.map(item => ({\n            CategoryCode: item.CategoryCode,\n            CategoryName: item.CategoryName,\n            CategoryDescription: item.CategoryDescription,\n            BUOrgId: item.BUOrgId\n        }));\n    }\n\n    return [];\n});\n\nreturn JSON.stringify(categoryResponse);"
          },
          "outcomes": {
            "success": "1773165319136"
          },
          "code": "CLEAN_CATEGORY_DATA",
          "id": "1773135937376",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "description": "Computes pagination offsets for product group retrieval.",
            "name": "Calculate Product Group Offset",
            "returnType": "array",
            "sourceCode": "const totalResults = $context.$nodes.FETCH_PRODUCT_GROUP_COUNT.$output.totalResults;\n\nconst fetchSizevar = $context.$variables.fetchSize;\n\nlet offsets = [];\nfor (let i = 0; i < totalResults; i = i + fetchSizevar) {\n  offsets.push(i);\n}\n\nreturn offsets;"
          },
          "outcomes": {
            "success": "1773168507892"
          },
          "code": "CALCULATE_PRODUCT_GROUP_OFFSET",
          "id": "1773168442493",
          "inputs": [],
