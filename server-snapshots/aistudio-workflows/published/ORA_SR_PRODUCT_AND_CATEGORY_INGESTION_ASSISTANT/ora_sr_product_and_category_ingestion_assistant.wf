        {
          "metadata": {
            "description": "Normalizes and flattens product group records into JSON for ingestion.",
            "name": "Clean Product Group Data",
            "returnType": "string",
            "sourceCode": "const productGroups = $context.$nodes.FETCH_PRODUCT_DATA_LOOP.$output;\n\nconst productGroupList = [];\n\nproductGroups.forEach(productGroupResponse => {\n  const parsedProductGroup = typeof productGroupResponse === 'string'\n    ? JSON.parse(productGroupResponse)\n    : productGroupResponse;\n\n  if (parsedProductGroup && Array.isArray(parsedProductGroup.items)) {\n    parsedProductGroup.items.forEach(productGroupItem => {\n      const formattedProductGroup = {\n        productGroupId: productGroupItem.ProductGroupId,\n        productGroupName: productGroupItem.ProductGroupName,\n        productGroupDescription: productGroupItem.ProductGroupDescription,\n        usageCode: productGroupItem.UsageCode\n      };\n\n      productGroupList.push(formattedProductGroup);\n    });\n  }\n});\n\nreturn JSON.stringify(productGroupList);"
          },
          "outcomes": {
            "success": "1773168765714"
          },
          "code": "CLEAN_PRODUCT_GROUP_DATA",
          "id": "1773168616242",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "description": "Normalizes and flattens product item records into JSON for ingestion.",
            "name": "Clean Product Item Data",
            "returnType": "string",
            "sourceCode": "const productItems = $context.$nodes.FETCH_PRODUCT_ITEM_IN_LOOP.$output;\n\nconst productItemList = [];\n\nproductItems.forEach(productItemResponse => {\n  const parsedProductItem = typeof productItemResponse === 'string'\n    ? JSON.parse(productItemResponse)\n    : productItemResponse;\n\n  if (parsedProductItem && Array.isArray(parsedProductItem.items)) {\n    parsedProductItem.items.forEach(productItem => {\n      const formattedProductItem = {\n        productItemId: productItem.InventoryItemId,\n        productItemName: productItem.Description,\n        productItemDescription: productItem.LongDescription,\n        usageCode: productItem.UsageCode\n      };\n\n      productItemList.push(formattedProductItem);\n    });\n  }\n});\n\nreturn JSON.stringify(productItemList);"
          },
          "outcomes": {
            "success": "1773168254907"
          },
          "code": "CLEAN_PRODUCT_ITEM_DATA",
          "id": "1773167368282",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
