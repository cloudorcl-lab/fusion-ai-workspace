          "inputs": [
            {
              "id": "1774251255866_1",
              "name": "documentIdentifier",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.documentIdToDelete || $context.$variables.indexName}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "description": "Routes product operation read ingest or delete based on request.",
            "name": "Product Operation Router"
          },
          "outcomes": {
            "read": "1773169046504",
            "ingest": "1773166424780",
            "delete": "1773205479333"
          },
          "code": "PRODUCT_OPERATION_ROUTER",
          "convergenceTargetId": "end",
          "id": "1773166024058",
          "inputs": [
            {
              "id": "1773166024059_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.operation}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
            "description": "LLM extracts category value from RAG answer and validates BUOrgId match.",
            "name": "Extract Category Name"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "EXTRACT_CATEGORY_NAME",
          "id": "1773136430001",
          "inputs": [
            {
              "id": "1773136430002_1",
              "name": "prompt",
              "type": "string",
              "value": "Extract the value of the `category` field from the following input:\n\n`answerAPIData`: {{$context.$nodes.FETCH_CATEGORY_DATA_FROM_RAG.$output.value}}\n\n### Instructions\n\n* Parse `answerAPIData` and identify the `category`.\n* Return the `category` if found.\n* If no category is found, return an empty JSON: {}.\n\n### Output Rules\n\n* Return ONLY valid JSON\n* Do not include explanations or extra fields\n\n### Output Format\n\nIf category exists:\n{\"category\":\"<category>\"}\n\nIf no category found:\n{}\n"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"category\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_CX_SERVICECEN_GET_SR_CATEGORY_AND_PRODUCTS",
            "description": "Fetches total category count for pagination from source service.",
            "errorNodeId": "1774337590257",
            "functionName": "fetchCategory",
            "processJson": true,
            "name": "Fetch Category Count"
          },
          "outcomes": {
            "success": "1773135753300"
          },
          "code": "FETCH_CATEGORY_COUNT",
          "id": "1773135682907",
          "inputs": [
            {
              "id": "1774332870899_1",
              "name": "qparam",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.query}}"
            },
            {
              "id": "1774332870900_2",
              "name": "limit",
              "type": "string",
              "value": "1"
            },
            {
              "id": "1774332870901_3",
              "name": "offset",
              "type": "string",
              "value": "0"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n    \"totalResults\": {\n        \"type\": \"number\"\n    },\n        \"items\": {\n            \"type\": \"array\",\n            \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n                    \"CategoryId\": {\n                        \"type\": \"string\"\n                    },\n                    \"CategoryName\": {\n                        \"type\": \"string\"\n                    },\n                    \"CategoryCode\": {\n                        \"type\": \"string\"\n                    },\n                    \"BUOrgId\": {\n                        \"type\": \"string\"\n                    }\n                }\n            }\n        }\n    }\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "description": "Builds a user friendly error message for category failures.",
            "name": "Format Error Message For Category",
            "returnType": "string",
            "sourceCode": "let errorMsg = \"Ingestion failed for category. Please check the provided values and retry.\";\n\ntry {\n\n    if (!$context.$triggers.REST.$input.query) {\n        errorMsg = \"Please provide a valid category query value.\";\n    }\n\n    else if ($context.$nodes.FETCH_CATEGORY_COUNT.$error?.$info) {\n        try {\n            const invalidQueryError = JSON.parse(\n                $context.$nodes.FETCH_CATEGORY_COUNT.$error.$info\n            );\n\n            errorMsg =\n                invalidQueryError?.[\"o:errorDetails\"]?.[0]?.detail ||\n                \"Invalid Query\";\n\n        } catch (error) {\n            errorMsg = \"Please provide a valid category query value.\";\n        }\n    }\n\n    else if ($context.$nodes.INGEST_CATEGORY_DATA_INTO_RAG.$error?.$info) {\n        try {\n            const errorInfo = JSON.parse(\n                $context.$nodes.INGEST_CATEGORY_DATA_INTO_RAG.$error.$info\n            );\n\n            errorMsg =\n                errorInfo?.details?.[0]?.detail ||\n                \"Ingestion failed for category.\";\n\n        } catch (error) {\n            errorMsg = \"Ingestion failed for category.\";\n        }\n    }\n\n} catch (error) {\n    errorMsg = \"Ingestion failed for category. Please check the provided values and retry.\";\n}\n\nreturn errorMsg;"
          },
          "outcomes": {
            "success": "1773135659639"
          },
          "code": "FORMAT_ERROR_MESSAGE_FOR_CATEGORY",
          "id": "1774337590257",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "description": "Returns success message for category deletion.",
            "name": "Return Category Deletion Response"
          },
          "outcomes": {},
          "code": "RETURN_CATEGORY_DELETION_RESPONSE",
          "convergenceTargetId": "end",
          "id": "1773204988506",
          "inputs": [
            {
              "id": "1773204988507_1",
              "name": "returnValue",
              "type": "string",
              "value": "Document deleted successfully for the following documentId: {{$context.$nodes.DELETE_CATEGORY_DATA_FROM_RAG.$input.documentIdentifier}}."
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
