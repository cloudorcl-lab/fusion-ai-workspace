{
  "workflowId": "300000331068155",
  "workflowCode": "ORA_SR_PRODUCT_AND_CATEGORY_INGESTION_ASSISTANT",
  "name": "SR Product and Category Ingestion Assistant",
  "description": "Designed to assist administrators and implementers in ingesting Product and Category content into the RAG data tool to enhance Service Request automation AI agents, ensuring the data is correctly structured and available to improve predictions grounded in your site’s product and category data.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Entry point for SR product and category ingestion assistant.",
            "name": "Start"
          },
          "outcomes": {
            "success": "1773135294250"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "description": "Derives indexName and fetchSize variables for downstream operations.",
            "name": "Set Index"
          },
          "outcomes": {
            "success": "1773135142227"
          },
          "code": "SET_INDEX",
          "id": "1773135294250",
          "inputs": [
            {
              "id": "1773135382923",
              "name": "fetchSize",
              "scope": "JOB",
              "type": "number",
              "value": "500"
            },
            {
              "id": "1773135313645",
              "name": "indexName",
              "scope": "JOB",
              "type": "string",
              "value": "{{'fa-svc-' + ($context.$triggers.REST.$input.objectType === 'InternalServiceRequest' ? 'isr' : ($context.$triggers.REST.$input.objectType === 'HRHelpDeskRequest' ? 'hrhd' : ($context.$triggers.REST.$input.objectType === 'Case' ? 'case' : 'crm'))) + '-' + ($context.$triggers.REST.$input.entityType === 'product' ? 'products' : 'categories')}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "description": "Routes flow by entityType input to category or product handlers.",
            "name": "Entity Type Router"
          },
          "outcomes": {
            "category": "1773135410379",
            "product": "1773165974263"
          },
          "code": "ENTITY_TYPE_ROUTER",
          "convergenceTargetId": "end",
          "id": "1773135142227",
          "inputs": [
            {
              "id": "1773135142228_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.entityType}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
            "description": "Routes category operation read ingest or delete based on request.",
            "name": "Category Operation Router"
          },
          "outcomes": {
            "read": "1773163704529",
            "ingest": "1773135519276",
            "delete": "1773204904138"
          },
          "code": "CATEGORY_OPERATION_ROUTER",
          "convergenceTargetId": "end",
          "id": "1773135410379",
          "inputs": [
            {
              "id": "1773135410381_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.operation}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
            "description": "Builds product group and item document identifiers from indexName.",
