            "returnType": "array",
            "sourceCode": "const totalResults = $context.$nodes.FETCH_PRODUCT_ITEM_COUNT.$output.totalResults;\n\nconst fetchSizevar = $context.$variables.fetchSize;\n\nlet offsets = [];\nfor (let i = 0; i < totalResults; i = i + fetchSizevar) {\n  offsets.push(i);\n}\n\nreturn offsets;"
          },
