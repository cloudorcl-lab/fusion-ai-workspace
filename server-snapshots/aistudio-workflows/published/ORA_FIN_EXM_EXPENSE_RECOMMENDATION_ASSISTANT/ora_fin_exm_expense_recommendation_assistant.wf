            "sourceCode": "let resolvedEntitiesArray = [\n  $context.$variables.recommendedProjects,\n  $context.$variables.recommendedAccounts,\n  $context.$variables.recommendedAttendees,\n  $context.$variables.recommendedNonEmployeeAttendee,\n  $context.$variables.recommendedSpendAuth,\n  $context.$variables.resolvedCustomer \n].filter(item => item != null && item !== \"\");\n\nlet payload = { resolvedEntities: resolvedEntitiesArray };\nreturn payload;"
