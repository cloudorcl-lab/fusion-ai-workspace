        {
          "metadata": {
            "name": "Extract Resolved Entities",
            "returnType": "object",
            "sourceCode": "let input = $context.$triggers.REST.$input.InputRest.resolvedEntities;\n\nlet projectsEntity = input.find(entity => entity.name === \"Projects\");\nlet accountsEntity = input.find(entity => entity.name === \"Accounts\");\nlet attendeeEntity = input.find(entity => entity.name === \"Attendees\");\nlet nonEmpAttEntity = input.find(entity => entity.name === \"NonEmployeeAttendees\");\nlet spendAuthEntity=input.find(entity => entity.name === \"SpendAuth\");\nlet customer=input.find(entity => entity.name === \"Customers\");\n\n\nreturn {projects: projectsEntity,accounts: accountsEntity,attendee: attendeeEntity,nonemployeeAttendee:nonEmpAttEntity, spendAuth:spendAuthEntity,customer:customer};"
          },
          "outcomes": {
            "success": "1769436690496"
          },
          "code": "EXTRACT_RESOLVED_ENTITIES",
          "id": "1768922142861",
          "inputs": [],
