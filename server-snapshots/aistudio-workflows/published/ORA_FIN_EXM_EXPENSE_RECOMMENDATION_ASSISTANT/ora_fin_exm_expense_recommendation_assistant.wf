        {
          "metadata": {
            "name": "RankNonEmployeeAttendee",
            "returnType": "object",
            "sourceCode": "let nonEmployeeEntity = $context?.$variables?.resolvedNonEmployeeAttendee ?? null;\nlet attendeeExpenseHistory = $context?.$nodes?.GET_ATTENDEE_HISTORY?.$output ?? null;\nif (!nonEmployeeEntity?.resolvedValues || nonEmployeeEntity.resolvedValues.length === 0) {\n    return null;\n}\nlet recommendedNonEmployeeAttendee = nonEmployeeEntity;\nlet items = attendeeExpenseHistory?.items ?? [];\nlet attendeesFromHistory = [];\nitems.forEach(item => {\n    if (item?.expenseAttendees?.items && Array.isArray(item.expenseAttendees.items)) {\n        attendeesFromHistory.push(...item.expenseAttendees.items);\n    }\n});\nlet historyNames = new Set(\n    attendeesFromHistory\n        .map(a => a?.name?.trim().toLowerCase())\n        .filter(Boolean)\n);\nlet historyEmails = new Set(\n    attendeesFromHistory\n        .map(a => a?.emailAddress?.trim().toLowerCase())\n        .filter(Boolean)\n);\nnonEmployeeEntity.resolvedValues.forEach(resolvedValue => {\n    if (resolvedValue.status !== \"ORA_RECOMMENDATION\") return;\n    let matched = [];\n    let unmatched = [];\n    (resolvedValue.matches || []).forEach(match => {\n        let name = match?.fieldValue?.name?.trim().toLowerCase();\n        let id = match?.fieldValue?.id?.trim().toLowerCase();\n        let isMatched = (name && historyNames.has(name)) || (id && historyEmails.has(id));\n        if (isMatched) {\n            matched.push(match);\n        } else {\n            unmatched.push(match);\n        }\n    });\n    let rank = 1;\n    matched.forEach(match => {\n        match.predictionRank = String(rank++);\n        match.ruleCode = \"ORA_MRU_7_DAYS\";\n    });\n    unmatched.forEach(match => {\n        match.predictionRank = String(rank++);\n    });\n    let orderedMatches = matched.concat(unmatched);\n    resolvedValue.matches = orderedMatches.slice(0, 3);\n});\nrecommendedNonEmployeeAttendee = nonEmployeeEntity;\nreturn recommendedNonEmployeeAttendee;"
          },
          "outcomes": {
            "success": "1769676258298"
          },
          "code": "RANKNONEMPLOYEEATTENDEE",
          "convergenceTargetId": "1769676258298",
