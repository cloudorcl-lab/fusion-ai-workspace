          "code": "FORMOUTPUTPAYLOAD",
          "id": "1769531657495",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Order Projects Recommendation",
            "returnType": "object",
            "sourceCode": "const matches = $context.$variables.resolvedProjects.resolvedValues[0].matches;\nconst expenseHistory = $context.$nodes.GET_PROJECT_HISTORY.$output;\n\n// Build map: projectId-taskId => most recent expenseDate\nconst usageMap = {};\nfor (const item of expenseHistory.items) {\n    const projId = item.ora_flex_projectsCostCollection__info.xProjectUId?.id;\n    const taskId = item.ora_flex_projectsCostCollection__info.xTaskUId?.id;\n    const expenseDate = item.expense.expenseDate;\n    if (projId && taskId && expenseDate) {\n        const key = `${projId}-${taskId}`;\n        if (!usageMap[key] || usageMap[key] < expenseDate) {\n            usageMap[key] = expenseDate; // Store most recent\n        }\n    }\n}\n\n// Attach recency info to matches\nconst matchWithUsage = matches.map(m => {\n    const projId = m.fieldValue.projectId;\n    const taskId = m.fieldValue.taskId;\n    const key = `${projId}-${taskId}`;\n    const recentUse = usageMap[key] || null; // null means never used in expenses\n    return { match: m, recentUse };\n});\n\n// Sort:\n// 1. Most recent non-null recentUse comes first\n// 2. In case of tie or nulls, preserve order in original recommendations (predictionRank)\nmatchWithUsage.sort((a, b) => {\n    if (a.recentUse && b.recentUse) {\n        // Descending by date\n        return b.recentUse.localeCompare(a.recentUse);\n    }\n    if (a.recentUse) return -1;\n    if (b.recentUse) return 1;\n    // Both never used: by predictionRank (smaller rank is higher)\n    return Number(a.match.predictionRank) - Number(b.match.predictionRank);\n});\n\n// Assign consecutive predictionRank values (1, 2, 3) to top 3 matches\nconst top3 = matchWithUsage.slice(0, 3).map((m, idx) => {\n    m.match.predictionRank = idx + 1; // Assign 1 to first, 2 to second, 3 to third\n    return m.match;\n});\n\nreturn top3;"
          },
          "outcomes": {
            "success": "1769446225858"
          },
          "code": "ORDERPROJECTSRECOMMENDATION",
          "id": "1769587684582",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
