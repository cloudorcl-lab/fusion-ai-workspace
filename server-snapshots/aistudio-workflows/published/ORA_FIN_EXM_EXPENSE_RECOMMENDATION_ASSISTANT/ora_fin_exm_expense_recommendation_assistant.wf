              "id": "1769447321966_1",
              "name": "prompt",
              "type": "string",
              "value": "let resolvedAccountsVar= {{$context.$variables.resolvedAccounts}}\n\n{{$context.$nodes.EXTRACTACCOUNTRECPROMPT.$output.result.mainPrompt}}"
            }
          ],
