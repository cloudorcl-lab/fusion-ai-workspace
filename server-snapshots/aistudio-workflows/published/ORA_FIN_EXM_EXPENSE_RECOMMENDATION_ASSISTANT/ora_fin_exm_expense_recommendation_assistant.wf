        {
          "metadata": {
            "name": "Check Spend Auth Related Errror Code",
            "returnType": "boolean",
            "sourceCode": "let found = false;\nconst data = $context.$triggers.REST.$input.expenseErrors;\nconst stack = [data];  // Stack should start as an array with data inside\n\n//const decomposedInstructions=JSON.parse($context.$triggers.REST.$input.userDecompositionAgentOutput).result.DecomposedInstructions || []; \nlet raw = $context.$triggers.REST.$input.userDecompositionAgentOutput;\n\n// Step 1: ensure outer object\nif (typeof raw === \"string\") {\n  raw = JSON.parse(raw);\n}\n\n// Step 2: parse inner \"output\"\nlet output = raw.output;\n\nif (typeof output === \"string\") {\n  output = JSON.parse(output);\n}\n\n// Step 3: safely extract\nconst decomposedInstructions =\n  output?.result?.DecomposedInstructions || [];\nconst userInputSpendAuth = decomposedInstructions.some(item => item.field === \"spendAuthorizationLine\");\n\nwhile (stack.length > 0 && !found) {\n    const item = stack.pop();\n    if (typeof item === 'object' && item !== null) {\n        for (const key in item) {\n            if (key === 'Spend Authorization Line Id') {\n                found = true;\n                break;\n            }\n            const value = item[key];\n            if (value === 'Spend Authorization Line Id') {\n                found = true;\n                break;\n            }\n            // If the value is an object or array, add to stack\n            if (typeof value === 'object' && value !== null) {\n                stack.push(value);\n            }\n        }\n    } else if (Array.isArray(item)) {\n        for (const val of item) {\n            if (val === 'Spend Authorization Line Id') {\n                found = true;\n                break;\n            }\n            if (typeof val === 'object' && val !== null) {\n                stack.push(val);\n            }\n        }\n    }\n}\n\nreturn found || userInputSpendAuth;"
          },
          "outcomes": {
            "success": "1769524875957"
          },
          "code": "CHECK_SPEND_AUTH_RELATED_ERRROR_CODE",
