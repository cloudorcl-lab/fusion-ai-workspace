          "code": "SETNONEMPLOYEEATTENDEERECOMMDATIONS",
          "id": "1769676258298",
          "inputs": [
            {
              "id": "1769676284511",
              "name": "recommendedNonEmployeeAttendee",
              "type": "object",
              "value": "{{$context.$nodes.RANKNONEMPLOYEEATTENDEE.$output.result}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "RankAttendeeRecommdations",
            "returnType": "object",
            "sourceCode": "let attendeeEntity = $context?.$variables?.resolvedAttendees ?? null;\nlet attendeeExpenseHistory = $context?.$nodes?.GET_ATTENDEE_HISTORY?.$output ?? null;\nif (!attendeeEntity?.resolvedValues || attendeeEntity.resolvedValues.length === 0) {\n    return null;\n}\nlet recommendedEmployeeAttendee = attendeeEntity;\nlet items = attendeeExpenseHistory?.items ?? [];\nlet attendeesFromHistory = [];\nitems.forEach(item => {\n    if (item?.expenseAttendees?.items && Array.isArray(item.expenseAttendees.items)) {\n        attendeesFromHistory.push(...item.expenseAttendees.items);\n    }\n});\nlet historyNames = new Set(\n    attendeesFromHistory\n        .map(a => a?.name?.trim().toLowerCase())\n        .filter(Boolean)\n);\nlet historyEmails = new Set(\n    attendeesFromHistory\n        .map(a => a?.emailAddress?.trim().toLowerCase())\n        .filter(Boolean)\n);\nattendeeEntity.resolvedValues.forEach(resolvedValue => {\n    if (resolvedValue.status !== \"ORA_RECOMMENDATION\") return;\n    let matched = [];\n    let unmatched = [];\n    (resolvedValue.matches || []).forEach(match => {\n        let name = match?.fieldValue?.name?.trim().toLowerCase();\n        let id = match?.fieldValue?.id?.trim().toLowerCase();\n        let isMatched = (name && historyNames.has(name)) || (id && historyEmails.has(id));\n        if (isMatched) {\n            matched.push(match);\n        } else {\n            unmatched.push(match);\n        }\n    });\n    let rank = 1;\n    matched.forEach(match => {\n        match.predictionRank = String(rank++);\n        match.ruleCode = \"ORA_MRU_7_DAYS\";\n    });\n    unmatched.forEach(match => {\n        match.predictionRank = String(rank++);\n    });\n    let orderedMatches = matched.concat(unmatched);\n    resolvedValue.matches = orderedMatches.slice(0, 3);\n});\nrecommendedEmployeeAttendee = attendeeEntity;\nreturn recommendedEmployeeAttendee;"
          },
          "outcomes": {
            "success": "1769675868223"
          },
          "code": "RANKATTENDEERECOMMDATIONS",
          "convergenceTargetId": "1769675868223",
          "id": "1769592101932",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
