            "name": "Get Project History Payload",
            "returnType": "object",
            "sourceCode": "let date = $context.$system.$currentDate;\n\n// Subtract 30 days (or any desired interval)\nlet olderDate = new Date(date);\nolderDate.setDate(olderDate.getDate() - 30);\n\n// If you need the value as a string (e.g., 'YYYY-MM-DD')\nlet olderDateStr = olderDate.toISOString().split('T')[0];\nlet filter = \"projectCostingProjectIdentifier!=null%20AND%20expense.expenseDate>'\" + olderDateStr + \"'\";\nreturn filter;"
          },
