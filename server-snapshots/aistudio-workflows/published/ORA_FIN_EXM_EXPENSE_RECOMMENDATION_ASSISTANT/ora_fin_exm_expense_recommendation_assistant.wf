{
  "workflowId": "100002355227093",
  "workflowCode": "ORA_FIN_EXM_EXPENSE_RECOMMENDATION_ASSISTANT",
  "name": "Expense Recommendation Assistant",
  "description": "This agent generates recommendations to complete missing required expense details when the user hasn’t provided a value and the system can’t determine exactly one match or default. It also resolves ambiguous user input by proposing the most likely candidate values for fields such as project, task, attendees, spend authorization, company, and cost center, so the user can confirm or select the correct option.",
  "specification": {
