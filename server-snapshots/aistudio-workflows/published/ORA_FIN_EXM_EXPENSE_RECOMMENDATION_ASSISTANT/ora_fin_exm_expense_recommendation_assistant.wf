        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_EXPENSES_SPENDAUTHORIZATIONLINE",
            "functionName": "spendAuthorizationLineList",
            "name": "Get Spend Auth Lines"
          },
          "outcomes": {
            "success": "1769531054762"
          },
          "code": "GET_SPEND_AUTH_LINES",
          "id": "1769530928797",
          "inputs": [
            {
              "id": "1769530943782_1",
              "name": "personId",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.personId}}"
            },
            {
              "id": "1769530943782_2",
              "name": "businessUnitId",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.businessUnitId}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Create Spend Auth Recommendation",
            "returnType": "object",
            "sourceCode": "let raw = $context.$triggers.REST.$input.userDecompositionAgentOutput;\n\n// Step 1: ensure outer object\nif (typeof raw === \"string\") {\n  raw = JSON.parse(raw);\n}\n\n// Step 2: parse inner \"output\"\nlet output = raw.output;\n\nif (typeof output === \"string\") {\n  output = JSON.parse(output);\n}\n\n// Step 3: safely extract\nconst decomposedInstructions =\n  output?.result?.DecomposedInstructions || [];\n\nconst targetObject = decomposedInstructions.find(item => item.field === \"spendAuthorizationLine\");\nconst userInput = targetObject ? targetObject.value : \"\";\n//const userInput = \"Conference\";\nconst expenseDate = $context.$triggers.REST.$input.expenseDetails.expenseDate;\nconst countryCode = $context.$triggers.REST.$input.expenseDetails.expenseLocation.countryCode;\nconst expenseTypeCategoryCode = $context.$triggers.REST.$input.expenseDetails.expenseTypeCategory.lookupCode;\nconst spendAuthLines = $context.$nodes.GET_SPEND_AUTH_LINES.$output.items;\n\nlet allowSingularMatchToDefault = true;\nconst normalizedInput = userInput.trim().toLowerCase();\nlet filteredSpendAuthLines = spendAuthLines\n  // 1. FILTER by text match\n  .filter(line => {\n    if (!normalizedInput) return true; // allow all if input is empty\n\n    const auth = line.spendAuthorization;\n    const combinedText = `${line.description} ${auth.purpose} ${auth.spendAuthorizationNumber}`\n      .toLowerCase();\n\n    return combinedText.includes(normalizedInput);\n  });\n\nif (!filteredSpendAuthLines?.length) {\n  allowSingularMatchToDefault = false;\n  filteredSpendAuthLines = spendAuthLines;\n}\n\nlet recommendations = filteredSpendAuthLines\n\n  // 2. SCORE remaining lines\n  .map(line => {\n    let points = 0;\n    const auth = line.spendAuthorization;\n    const utilizedAmount = (line?.expenses || []).reduce((sum, expense) => {\n      const amount = parseFloat(expense?.functionalCurrencyAmount || \"0\");\n      return sum + (isNaN(amount) ? 0 : amount);\n    }, 0);\n\n    // Date range (+4)\n    const expDate = new Date(expenseDate);\n    const start = new Date(auth.startDate);\n    const end = new Date(auth.endDate);\n    if (expDate >= start && expDate <= end) {\n      points += 4;\n    }\n\n    // Country (+2)\n    if (auth.location.countryCode === countryCode) {\n      points += 2;\n    }\n\n    // Category (+1)\n    if (line.expenseTypeCategory.lookupCode === expenseTypeCategoryCode) {\n      points += 1;\n    }\n\n    return { ...line, utilizedAmount: utilizedAmount, calculatedPoints: points };\n  })\n\n  // 3. SORT\n  .sort((a, b) => {\n    if (b.utilizedAmount !== a.utilizedAmount) {\n      return a.utilizedAmount - b.utilizedAmount;\n    }\n    if (b.calculatedPoints !== a.calculatedPoints) {\n      return b.calculatedPoints - a.calculatedPoints;\n    }\n    return new Date(b.spendAuthorization.endDate) - new Date(a.spendAuthorization.endDate);\n  });\n\n// A maximum of 3 recommendations have to be generated\nif (recommendations.length > 3) recommendations = recommendations.slice(0, 3);\nlet result = {\n  name: \"Spend Authorization Line\",\n  resolvedValues: [{\n    inputValues: [userInput],\n    status: \"ORA_RECOMMENDATION\",\n    matches: recommendations.map((item, i) => ({\n      driverName1: \"\", driverName2: \"\", driverName3: \"\", driverName4: \"\", driverName5: \"\",\n      driverValue1: \"\", driverValue2: \"\", driverValue3: \"\", driverValue4: \"\", driverValue5: \"\",\n      predictionDisplayRule: \"ORA_REQUEST_USER_INPUT\",\n      predictionRank: i+1,\n      predictionSource: \"ORA_COMPLETION_ASSISTANT\",\n      predictionTypeCode: \"ORA_RECOMMENDATION\",\n      ruleCode: \"SPEND_AUTH_RESOLVER_SEARCH\",\n      fieldValue: {\n        id: item.$id,\n        type: item.expenseType.name,\n        description: item.description,\n        authorizedAmount: item.authorizedAmount,\n        requestedCurrency: item.requestedCurrency.currencyCode,\n        number: item.spendAuthorization.spendAuthorizationNumber,\n        startDate: item.spendAuthorization.startDate,\n        endDate: item.spendAuthorization.endDate,\n        authorizedTotal: item.spendAuthorization.authorizedTotal,\n        functionalCurrency: item.spendAuthorization.functionalCurrency.currencyCode,\n        purpose: item.spendAuthorization.purpose\n      }\n    }))\n  }]\n};\n\n// If no recommendations found, user needs to resolve in app\nif (recommendations.length === 0) result.resolvedValues[0].status = \"ORA_NOT_RESOLVED\";\n\n// If exactly one recommendation is found, we have to default it\nif (recommendations.length === 1 && allowSingularMatchToDefault) result.resolvedValues[0].status = \"ORA_DEFAULT\";\n\nreturn result;"
          },
          "outcomes": {
            "success": "1769531324492"
          },
          "code": "CREATESPENDAUTHRECOMMENDATION",
          "id": "1769531054762",
          "inputs": [],
