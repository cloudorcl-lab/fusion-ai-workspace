              "value": "{{$context.$nodes.EXTRACT_OPPORTUNITYID.$output.result.activityNumber}}",
              "required": true,
              "type": "string"
            },
            {
              "id": "1776475338688_OutcomeType",
              "name": "OutcomeType",
              "value": "SUMMARY",
              "required": true,
              "type": "string"
            },
            {
              "id": "1776475338688_OutcomeSubType",
