        {
          "id": "1779295693014",
          "code": "REFINE_RECOMMENDATIONS",
          "type": "CODE",
          "metadata": {
            "name": "Refine Recommendations",
            "sourceCode": "let result = [];\n\ntry {\n  const recommendationItems =\n    $context.$nodes?.GET_RECOMMENDATIONS?.$output?.items ||\n    $context.$nodes?.GET_RECOMMENDATIONS?.$output ||\n    [];\n\n  for (const item of recommendationItems) {\n    const payload = item?.payload;\n    if (!payload) continue;\n\n    const payloadObj =\n      typeof payload === \"string\"\n        ? JSON.parse(payload)\n        : payload;\n\n    const actions = payloadObj?.next?.actions || [];\n\n    for (const action of actions) {\n      result.push({\n        Type: action?.type || \"\",\n        Title: action?.label || \"\",\n        Task: action?.description || \"\"\n      });\n    }\n  }\n} catch (error) {\n  result = [];\n}\n\nreturn result;",
            "returnType": "array"
          },
          "diagram": {
            "x": 11951,
            "y": 6982
          },
          "outcomes": {
            "success": "1780960017119"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1780960017119",
          "code": "PAYLOAD_FOR_MEETINGS_LIST",
          "type": "CODE",
          "metadata": {
            "name": "Payload for Meetings List",
            "sourceCode": "let result = {};\ntry {\n  // Access opportunityId from upstream node SET_OPPORTUNITYID_VARIABLE\n  const opportunityNumber = $context.$nodes.GET_OPPORTUNITY.$output[0].OptyNumber;\n\n  // Prepare the dynamic values array for OpportunityId.OptyNumber\n  // If opportunityId is missing or empty, use empty array\n  const opportunityNumbers = opportunityNumber ? [opportunityNumber] : [];\n\n  // Construct the criteria array as per the required structure\n  result = {\n    op: \"$and\",\n    criteria: [\n      {\n        op: \"$in\",\n        attribute: \"ActivityFunctionCode\",\n        values: [\"APPOINTMENT\"]\n      },\n      {\n        op: \"$wi\",\n        attribute: \"SortDate\",\n        value1: \"now/d\",\n        value2: \"now/d+7d\"\n      },\n      {\n        op: \"$eq\",\n        attribute: \"RecordSet\",\n        value: \"RECORDS_RESOURCE\"\n      },\n      {\n        op: \"$ne\",\n        attribute: \"ListOfContacts\",\n        value: \"\"\n      },\n      {\n        op: \"$in\",\n        attribute: \"OpportunityId.OptyNumber\",\n        values: opportunityNumbers\n      }\n    ]\n  };\n} catch (error) {\n  // Return empty criteria structure on error\n  result = {\n    op: \"$and\",\n    criteria: []\n  };\n}\n\nreturn result;\n",
            "returnType": "object"
          },
          "diagram": {
            "x": 11951,
            "y": 7204
          },
          "outcomes": {
            "success": "1780958764145"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
