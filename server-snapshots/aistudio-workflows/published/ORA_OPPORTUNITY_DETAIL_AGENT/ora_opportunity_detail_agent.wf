        {
          "id": "1779312090277",
          "code": "GET_ENGAGEMENTS",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Get Engagements",
            "businessObjectCode": "ORA_CX_SALESFORCE_SALESFEEDS",
            "functionName": "getOpportunityFeeds"
          },
          "diagram": {
            "x": 6989,
            "y": 7204
          },
          "outcomes": {
            "success": "1779313181147"
          },
          "inputs": [
            {
              "id": "1779312090277_opportunityId",
              "name": "opportunityId",
              "value": "{{$context.$variables.opportunityId}}",
              "required": true,
              "type": "string"
            }
          ]
        },
        {
          "id": "1779313181147",
          "code": "REFINE_ENGAGEMENTS",
          "type": "CODE",
          "metadata": {
            "name": "Refine Engagements",
            "sourceCode": "let result = [];\ntry {\n  const engagements = $context.$nodes?.GET_ENGAGEMENTS?.$output?.items || [];\n  const now = new Date();\n  const oneWeekAgo = new Date(now.getTime() - 0 * 24 * 60 * 60 * 1000);\n\n  // Filter engagements from last week\n  const lastWeekEngagements = engagements.filter(e => {\n    const publishedDate = e?.published ? new Date(e.published) : null;\n    return publishedDate && publishedDate >= oneWeekAgo && publishedDate <= now;\n  });\n\n  // If less than 5 last week engagements, get recent 5 engagements\n  let selectedEngagements = [];\n  if (lastWeekEngagements.length < 5) {\n    // Sort all engagements by published descending\n    const sortedEngagements = [...engagements].sort((a, b) => {\n      const dateA = a?.published ? new Date(a.published) : new Date(0);\n      const dateB = b?.published ? new Date(b.published) : new Date(0);\n      return dateB - dateA;\n    });\n    selectedEngagements = sortedEngagements.slice(0, 5);\n  } else {\n    // Sort last week engagements by published descending\n    selectedEngagements = [...lastWeekEngagements].sort((a, b) => {\n      const dateA = a?.published ? new Date(a.published) : new Date(0);\n      const dateB = b?.published ? new Date(b.published) : new Date(0);\n      return dateB - dateA;\n    });\n  }\n\n  // Process each selected engagement\n  for (const engagement of selectedEngagements) {\n    const payloadAttributes = engagement?.object?.payloadAttributes || [];\n    const rowObject = {};\n\n    // To keep track of keys and ensure latest occurrence is kept\n    // We'll process in order, so later keys overwrite earlier ones\n    for (const attr of payloadAttributes) {\n      if (!attr?.displayFlag) continue; // Include only if displayFlag is true\n      const key = attr.name;\n      if (!key) continue;\n\n      // Determine value by priority\n      let value = null;\n      if (attr.localizedValue !== undefined && attr.localizedValue !== null) {\n        value = attr.localizedValue;\n      } else if (attr.valueString !== undefined && attr.valueString !== null) {\n        value = attr.valueString;\n      } else if (attr.valueLong !== undefined && attr.valueLong !== null) {\n        value = attr.valueLong;\n      } else if (attr.valueClob !== undefined && attr.valueClob !== null) {\n        value = attr.valueClob;\n      } else if (attr.valueDateTime !== undefined && attr.valueDateTime !== null) {\n        // Return date time as is without formatting\n        value = attr.valueDateTime;\n      } else if (attr.uri !== undefined && attr.uri !== null) {\n        value = attr.uri;\n      }\n\n      if (value !== null) {\n        rowObject[key] = value; // overwrite if duplicate key\n      }\n    }\n\n    // Add the id property from engagement to the rowObject\n    if (engagement?.id !== undefined && engagement?.id !== null) {\n      rowObject.id = engagement.id;\n    }\n\n    // Include startTime and endTime as is if present\n    if (engagement?.startTime !== undefined && engagement?.startTime !== null) {\n      rowObject.startTime = engagement.startTime;\n    }\n    if (engagement?.endTime !== undefined && engagement?.endTime !== null) {\n      rowObject.endTime = engagement.endTime;\n    }\n\n    result.push(rowObject);\n  }\n} catch (error) {\n  result = [];\n}\n\nreturn result;\n",
            "returnType": "array"
          },
          "diagram": {
            "x": 6989,
            "y": 7426
          },
          "outcomes": {
            "success": "1779314148165"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1779314148165",
          "code": "GENERATE_ENGAGEMENT_RESPONSE",
          "type": "LLM",
          "metadata": {
            "name": "Generate Engagement Response"
