        },
        {
          "id": "1779839198185",
          "code": "PREPARE_EMAIL_SUMMARY_CONTENT",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Email Summary Content",
            "returnType": "object",
            "sourceCode": "let retObj;\ntry {\n  let payload = [];\n  // TODO: Inferred 'messageString' from 'message.messageString' as per schema\n  let message = $context.$nodes.REFINE_RESPONSE_FROM_SUMMARY_ASSISTANT.$output.result.message.message || \"\";\n\n  retObj = {\n    draftFlag: true,\n    subject: payload.find(p => p.id === \"subject\")?.value || \"\",\n    body: message,\n    trackConversationFlag: true,\n    providerCode: \"EXCHANGE\",\n    toAddress: payload.find(p => p.id === \"email\")?.value || \"\",\n    ccAddress: payload.find(p => p.id === \"cc\")?.value || \"\",\n    conversationReferences: `ORA_MOO_OPTY.${payload.find(p => p.id === \"optyid\")?.value || \"\"}`,\n    msgTemplateObjectId: payload.find(p => p.id === \"optyid\")?.value || \"\",\n    messageTemplateObjTypeCd: \"ORA_MOO_OPTY\"\n  };\n} catch (error) {\n  retObj = {\n    draftFlag: true,\n    subject: \"\",\n    body: \"\",\n    trackConversationFlag: true,\n    providerCode: \"EXCHANGE\",\n    toAddress: \"\",\n    ccAddress: \"\",\n    conversationReferences: \"\",\n    msgTemplateObjectId: \"\",\n    messageTemplateObjTypeCd: \"ORA_MOO_OPTY\"\n  };\n}\n\nreturn retObj;"
          },
          "diagram": {
            "x": 10593.5,
            "y": 7648
          },
          "outcomes": {
            "success": "1779839198186"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
