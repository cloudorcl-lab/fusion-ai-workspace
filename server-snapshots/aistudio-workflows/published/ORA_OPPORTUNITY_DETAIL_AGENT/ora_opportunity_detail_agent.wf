        {
          "id": "1779494768162",
          "code": "GET_FORM_VALUES",
          "type": "CODE",
          "metadata": {
            "name": "Get Form Values",
            "sourceCode": "let result = {};\n\ntry {\n  // Access the raw string from $context.$app.$OraAction\n  const rawString = $context?.$app?.$OraAction || \"\";\n\n  // Extract the JSON array string inside <oraFormSubmit ...>...</oraFormSubmit>\n  const regex = /<oraFormSubmit[^>]*>(\\[.*?\\])<\\/oraFormSubmit>/;\n  const match = rawString.match(regex);\n\n  if (match && match[1]) {\n    // Parse the JSON array\n    const parsedArray = JSON.parse(match[1]);\n\n    // Convert array into single object\n    result = parsedArray.reduce((acc, item) => {\n      if (item && typeof item.id === \"string\" && \"value\" in item) {\n        acc[item.id] = item.value;\n      }\n      return acc;\n    }, {});\n  }\n} catch (error) {\n  result = {};\n}\n\nreturn result;",
            "returnType": "array"
          },
          "diagram": {
            "x": 9767,
            "y": 6760
          },
          "outcomes": {
            "success": "1781042608281"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1781042608281",
          "code": "REFINE_FORM_DATA",
          "type": "CODE",
          "metadata": {
            "name": "Refine Form Data",
            "sourceCode": "let result = {};\ntry {\n  // Access the form values result object safely\n  const formValues = $context.$nodes?.GET_FORM_VALUES?.$output?.result || {};\n\n  // Destructure to exclude session_context, systemPartyNumber, and action, keep other properties\n  const { session_context, systemPartyNumber, action, ...rest } = formValues;\n\n  // Return the object without the excluded properties\n  result = rest;\n} catch (error) {\n  // In case of error, return empty object\n  result = {};\n}\n\nreturn result;",
            "returnType": "object"
          },
          "diagram": {
