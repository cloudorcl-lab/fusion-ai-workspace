{
  "workflowId": "300000331068548",
  "workflowCode": "ORA_OPPORTUNITY_DETAIL_AGENT",
  "name": "Opportunity Detail Agent",
  "description": "This agent analyzes opportunity data and generates a structured summary by capturing key signals such as priority drivers, close date pressure, engagement velocity, and associated service requests. It processes and organizes these inputs to produce a consistent representation of the opportunity and its related activities within the system.",
  "specification": {
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1774721156012"
          },
          "diagram": {
            "x": 10625.5,
            "y": 5000
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "name": "Extract OpportunityId",
            "sourceCode": "let result = {};\n\ntry {\n  const oraAppContextEncoded = $context.$app?.$OraAppContext;\n\n  let opportunityId = \"\";\n  let activityNumber;\n  let task;\n  let title;\n  let action;\n\n  if (typeof oraAppContextEncoded === \"string\" && oraAppContextEncoded.trim() !== \"\") {\n\n    const decodedString = decodeURIComponent(oraAppContextEncoded);\n\n    // Normalize malformed format\n    const normalizedString = decodedString\n      .replace(/:\\+\\s*\"/g, ':\"')\n      .replace(/,\\+\\s*\"/g, ',\"')\n      .replace(/\\+/g, \" \");\n\n    let parsedContext = {};\n\n    try {\n      parsedContext = JSON.parse(normalizedString);\n    } catch (jsonError) {\n      parsedContext = {};\n    }\n\n    if (typeof parsedContext.opportunityId === \"string\") {\n      opportunityId = parsedContext.opportunityId.trim();\n    }\n\n    if (typeof parsedContext.activityNumber === \"string\" && parsedContext.activityNumber.trim() !== \"\") {\n      activityNumber = parsedContext.activityNumber.trim();\n    }\n\n    if (typeof parsedContext.task === \"string\" && parsedContext.task.trim() !== \"\") {\n      task = parsedContext.task.trim();\n    }\n\n    if (typeof parsedContext.title === \"string\" && parsedContext.title.trim() !== \"\") {\n      title = parsedContext.title.trim();\n    }\n\n    if (typeof parsedContext.action === \"string\" && parsedContext.action.trim() !== \"\") {\n      action = parsedContext.action.trim();\n    }\n  }\n\n  result = {\n    opportunityId\n  };\n\n  if (activityNumber !== undefined) {\n    result.activityNumber = activityNumber;\n  }\n\n  if (task !== undefined) {\n    result.task = task;\n  }\n\n  if (title !== undefined) {\n    result.title = title;\n  }\n\n  if (action !== undefined) {\n    result.action = action;\n  }\n\n} catch (error) {\n  result = {\n    opportunityId: \"\"\n  };\n}\n\nreturn result;",
            "returnType": "object"
          },
          "diagram": {
            "x": 10503.5,
            "y": 5206
          },
          "outcomes": {
            "success": "1774721212388"
          },
          "id": "1774721156012",
          "code": "EXTRACT_OPPORTUNITYID",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "name": "Set OpportunityId Variable"
          },
          "diagram": {
            "x": 10503.5,
            "y": 5428
          },
          "outcomes": {
            "success": "1774733737511"
          },
          "id": "1774721212388",
          "code": "SET_OPPORTUNITYID_VARIABLE",
          "type": "SET_FIELDS",
          "inputs": [
            {
              "id": "1774721212388_opportunityId",
              "name": "opportunityId",
              "value": "{{$context.$nodes.EXTRACT_OPPORTUNITYID.$output.result.opportunityId}}"
            }
          ],
          "outputSpecification": "{\"type\":\"object\",\"properties\":{\"opportunityId\":{\"type\":\"string\"}},\"required\":[\"opportunityId\"]}"
        },
        {
          "metadata": {
            "name": "Generate Opportunity Payload",
            "returnType": "object",
            "sourceCode": "let optyId = $context.$variables.opportunityId;\n\nlet payload = {\n    \"limit\": 5,\n    \"offset\": 0,\n    \"sort\": [],\n    \"entity\": \"Opportunity\",\n    \"q\": {\n        \"op\": \"$and\",\n        \"criteria\": [\n            {\n                \"op\": \"$eq\",\n                \"attribute\": \"OptyId\",\n                \"value\": optyId\n            }\n        ]\n    },\n    \"fields\": [\n        \"OptyId\",\n        \"OptyNumber\",\n        \"EffectiveDate\",\n        \"PrimaryRevenue.RevnAmount\",\n        \"Name\",\n        \"StatusCode\",\n        \"SalesStage.StgOrderEnum_localizedValue\",\n        \"ListOfRevenues.InventoryItemId.Name\",\n        \"CustomerAccount.PartyNumber\",\n        \"CustomerAccount.PartyUniqueName\",\n        \"PrConPartyId\"\n        \n    ]\n};\n\nreturn payload;"
          },
          "diagram": {
            "x": 10497.5,
            "y": 5650
          },
          "outcomes": {
            "success": "1774733380709"
          },
          "id": "1774733737511",
          "code": "GENERATE_OPPORTUNITY_PAYLOAD",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
