          "inputs": [
            {
              "id": "1779491433035_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Generate an editable Record Widget with the below Propeties\n\ntitle: Generate a short 6-word title from the meaningful display labels and values in {{$context.$nodes.PARSE_DEALS_DATA_FOR_EDIT.$output.result}} .\n\nRules:\n- Ignore placeholder values such as \"NA\", \"N\", \"null\", \"undefined\", empty strings, or values that look like abbreviations for missing data.\n- Do not include placeholder values in the title.\n- Use only real business meaning from the remaining fields.\n- If a field is missing or placeholder, infer a concise summary from the other available fields.\n- If there is not enough information to infer a specific title, use a neutral title based on the labels, not the placeholder values.\n\ndescription: Generate one clear sentence from the meaningful display labels and values in {{$context.$nodes.PARSE_DEALS_DATA_FOR_EDIT.$output.result}} .\n\nRules:\n- Ignore placeholder values such as \"NA\", \"N\", \"null\", \"undefined\", empty strings, or values that look like abbreviations for missing data.\n- Do not repeat placeholder values.\n- Infer a business-appropriate description from the remaining fields.\n- If data is insufficient, provide a neutral summary based on the labels only.\n- If there are no fields in {{$context.$nodes.PARSE_DEALS_DATA_FOR_EDIT.$output.result}} , do not generate description>\nfields: {{$context.$nodes.PARSE_DEALS_DATA_FOR_EDIT.$output.result}} "
            }
          ],
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "enableActions": true,
              "layouts": [
                "ORA_LAYOUT_RECORD"
              ]
            }
          }
