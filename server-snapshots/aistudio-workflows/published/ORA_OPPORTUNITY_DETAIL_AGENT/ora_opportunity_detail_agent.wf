        {
          "metadata": {
            "name": "Build Payload for Assistant",
            "sourceCode": "let result = {};\ntry {\n  // Access RETRIEVE_THE_OPTY_PARAMETERS output result safely\n  const opportunityParams = $context.$nodes.RETRIEVE_THE_OPTY_PARAMETERS.$output.result || {};\n\n  // Initialize assistantPayload with required properties\n  const assistantPayload = {\n    opportunityId: opportunityParams.opportunityId || null,\n    opportunityNumber: opportunityParams.opportunityNumber || null,\n    task: opportunityParams.task || null,\n    title: opportunityParams.title || null\n  };\n\n  // Access GET_INSIGHT_DATA output safely\n  const insightDataOutput = $context.$nodes.GET_INSIGHT_DATA.$output.items || null;\n\n  // Determine if insightDataOutput is array or object\n  let insightRow = null;\n  if (Array.isArray(insightDataOutput)) {\n    insightRow = insightDataOutput.length > 0 ? insightDataOutput[0] : null;\n  } else if (insightDataOutput && typeof insightDataOutput === 'object') {\n    insightRow = insightDataOutput;\n  }\n\n  if (insightRow) {\n    // Extract properties from insightRow\n    assistantPayload.insightId = insightRow.id || null;\n    assistantPayload.insightNumber = insightRow.engagementInsightNumber || null;\n\n    // Parse additionalInsightData JSON string safely\n    let additionalInsightDataObj = {};\n    try {\n      additionalInsightDataObj = insightRow.additionalInsightData ? JSON.parse(insightRow.additionalInsightData) : {};\n    } catch (parseError) {\n      additionalInsightDataObj = {};\n    }\n\n  }\n\n  result = assistantPayload;\n} catch (error) {\n  // In case of error, return empty object\n  result = {};\n}\n\nreturn result;",
            "returnType": "object"
          },
