          },
          "inputs": [
            {
              "id": "1779490270476_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "Output must contain only oraInfoDisplay elements. No extra text should be included."
            },
            {
              "id": "1779490270476_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Generate a Read only Record Widget with the below Propeties\n\ntitle: Generate a short 6-word title from the meaningful display labels and values in {{$context.$nodes.PARSE_DEALS_DATA_FOR_VIEW.$output.result}}.\n\nRules:\n- Ignore placeholder values such as \"NA\", \"N\", \"null\", \"undefined\", empty strings, or values that look like abbreviations for missing data.\n- Do not include placeholder values in the title.\n- Use only real business meaning from the remaining fields.\n- If a field is missing or placeholder, infer a concise summary from the other available fields.\n- If there is not enough information to infer a specific title, use a neutral title based on the labels, not the placeholder values.\n\ndescription: Generate one clear sentence from the meaningful display labels and values in {{$context.$nodes.PARSE_DEALS_DATA_FOR_VIEW.$output.result}}.\n\nRules:\n- Ignore placeholder values such as \"NA\", \"N\", \"null\", \"undefined\", empty strings, or values that look like abbreviations for missing data.\n- Do not repeat placeholder values.\n- Infer a business-appropriate description from the remaining fields.\n- If data is insufficient, provide a neutral summary based on the labels only.\n- If there are no fields in {{$context.$nodes.PARSE_DEALS_DATA_FOR_VIEW.$output.result}}, do not generate description>\nfields: {{$context.$nodes.PARSE_DEALS_DATA_FOR_VIEW.$output.result}} (MUST not change the id property of fields. SHould use as it is)\n\nIf there are no fields in {{$context.$nodes.PARSE_DEALS_DATA_FOR_VIEW.$output.result}} , generate a Professional response mentioning there are no Recent Deal Insighst present for the opportunity.\n\nGenerate a low priority actionable insight with below properties only if {{$context.$nodes.PARSE_DEALS_DATA_FOR_VIEW.$output.result}} has data\n\n- title: \"Edit Deal Data\"\n- shortDescription: \"Edit deal insights, updates, and customer opportunity information.\"\n- actionText: \"Edit Deal Data\"\n- priority: false\n- followUpCommand: \"ora.Invoke(editRecentDealInsights, {\\\"opportunityId\\\": \"\"+{{$context.$variables.opportunityId}},\\\"opportunityNumber\\\":\"\"+ {{$context.$nodes.GET_OPPORTUNITY.$output[0].OptyNumber}}\",\\\"action\\\":\\\"editRecentDealInsights\\\"})\""
            }
          ],
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "enableActions": true,
              "layouts": [
                "ORA_LAYOUT_RECORD"
              ]
            }
          }
        },
        {
          "id": "1779493716279",
          "code": "GET_DEALS_DATA_FOR_EDIT",
          "type": "REFERENCE",
          "metadata": {
            "name": "Get Deals Data for Edit",
            "referenceableBlockId": "DEALS_DATA_REFERENCE"
          },
          "diagram": {
