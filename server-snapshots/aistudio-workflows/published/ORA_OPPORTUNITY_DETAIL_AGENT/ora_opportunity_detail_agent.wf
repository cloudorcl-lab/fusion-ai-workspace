          "invokeActionPayload": "{\n    \"OraAction\": \"{\\\"opportunityId\\\": \\\"300100648913150\\\", \\\"opportunityNumber\\\": \\\"CDRM_159570\\\", \\\"task\\\": \\\"Initiate outreach to potential executive sponsors to build internal champions for the solution.\\\", \\\"title\\\": \\\"Identify and Engage Executive Sponsors\\\"}\",\n    \"OraMessageHint\": \"InvokeAction\",\n    \"OraUserContext\": \"{\\\"userId\\\":\\\"100010037454104\\\",\\\"guId\\\":\\\"352E980CE9686C4EF1E2CD35987EF86C\\\",\\\"fullName\\\":\\\"Matt Hooper\\\",\\\"userName\\\":\\\"MHoope\\\",\\\"isAuthenticated\\\":true,\\\"loginUrl\\\":\\\"https://cptclqhqy.fusionapps.ocs.oc-test.com:443/fscmUI/faces/FuseWelcome\\\",\\\"idcsTimeOut\\\":30,\\\"locale\\\":\\\"en\\\"}\",\n    \"triggerType\": \"REST\",\n    \"aiAppOutputSpecification\": \"[\\\"infoDisplay\\\",\\\"actions\\\",\\\"enableCommunications\\\"]\"\n}",
