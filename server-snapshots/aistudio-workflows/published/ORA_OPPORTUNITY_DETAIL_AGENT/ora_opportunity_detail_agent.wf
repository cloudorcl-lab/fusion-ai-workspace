            "sourceCode": "let result = {};\nlet assistantPayload = {}; // ✅ FIX: define it\n\ntry {\n  const insightDataOutput = $context.$nodes.GET_INSIGHT_DATA_FOR_QUERY.$output.items || null;\n\n  let insightRow = null;\n\n  if (Array.isArray(insightDataOutput)) {\n    insightRow = insightDataOutput.length > 0 ? insightDataOutput[0] : null;\n  } else if (insightDataOutput && typeof insightDataOutput === 'object') {\n    insightRow = insightDataOutput;\n  }\n\n  if (insightRow) {\n    assistantPayload.insightId = insightRow.id || null;\n    assistantPayload.insightNumber = insightRow.engagementInsightNumber || null;\n\n    let additionalInsightDataObj = {};\n\n    if (insightRow.additionalInsightData) {\n      if (typeof insightRow.additionalInsightData === \"string\") {\n        try {\n          additionalInsightDataObj = JSON.parse(insightRow.additionalInsightData);\n        } catch (e) {\n          additionalInsightDataObj = {};\n        }\n      } else if (typeof insightRow.additionalInsightData === \"object\") {\n        additionalInsightDataObj = insightRow.additionalInsightData;\n      }\n    }\n\n    assistantPayload.salesPlay = additionalInsightDataObj?.salesPlays?.all || null;\n  }\n\n  result = assistantPayload;\n\n} catch (error) {\n  // Optional: expose error for debugging\n  result = { error: error.message };\n}\n\nreturn result;",
            "returnType": "object"
          },
