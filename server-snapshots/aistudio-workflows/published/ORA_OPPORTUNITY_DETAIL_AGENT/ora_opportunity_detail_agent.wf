        {
          "id": "1779226418587",
          "code": "REFINE_ALL_OBJECTIVS",
          "type": "CODE",
          "metadata": {
            "name": "Refine All Objectivs",
            "sourceCode": "let result = [];\ntry {\n  // Access the array of insights from GET_INSIGHTS_FOR_ACTION output\n  const insights = $context.$nodes.GET_ENGAGEMENT_ACTION_INSIGHTS.$output.items || [];\n\n  // Map each insight to extract objectives array safely\n  // TODO: Inferred 'objectives' property from user text 'objectives.items'\n  const objectives = insights.flatMap(insight => insight?.objectives?.items || []);\n\n  // Map each objective to the desired output structure\n  result = objectives.map(objectiveRecord => {\n    // Extract highValueActivities array safely\n    const highValueActivitiesArray = objectiveRecord?.highValueActivities?.items || [];\n\n    // Map highValueActivities to desired structure\n    const highValueActivities = highValueActivitiesArray.map(activity => ({\n      activityName: activity?.highValueActivityDesignTime?.name || \"\",\n      activityStatus: activity?.highValueActivityStatus || \"\",\n      activityJustification: activity?.justification || \"\"\n    }));\n\n    return {\n      objectiveNumber: objectiveRecord?.objectiveNumber || \"\",\n      objectiveName: objectiveRecord?.objectiveDesignTime?.name || \"\",\n      objectiveDescription: objectiveRecord?.objectiveDesignTime?.description || \"\",\n      objectiveStatus: objectiveRecord?.objectiveStatus || \"\",\n      highValueActivities: highValueActivities\n    };\n  });\n} catch (error) {\n  result = [];\n}\n\nreturn result;",
            "returnType": "array"
          },
          "diagram": {
            "x": 6006.5,
            "y": 7648
          },
          "outcomes": {
            "success": "1779226891641"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
