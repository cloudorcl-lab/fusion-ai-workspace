        {
          "id": "1780079529519",
          "code": "GENERATE_PAYLOAD_FOR_EMAIL",
          "type": "CODE",
          "metadata": {
            "name": "Generate Payload for email",
            "returnType": "object",
            "sourceCode": "let commPtoFill =  $context.$app.$OraCommParamsToFill;\nlet commNonTemplate = $context.$app.$OraCommNonTemplateParamList;\nlet message = $context.$system.$inputMessage;\n\n\nlet retObj = {}\nretObj.draftFlag = true;\nretObj.subject = commNonTemplate.find(com=>com.id ==\"subject\").value??\"No Subject\";\nretObj.body = message;\nretObj.trackConversationFlag = true;\nretObj.providerCode = \"EXCHANGE\";\nretObj.toAddress = commNonTemplate.find(com=>com.id ==\"email\").value??\"email@email.com\";\nretObj.conversationReferences=\"\";\nretObj.messageTemplateObjTypeCd =\"ORA_MOO_OPTY\";\nretObj.msgTemplateObjectId=$context.$variables.opportunityId ;\n\nreturn retObj;  "
          },
          "diagram": {
            "x": 13892,
            "y": 6316
          },
          "outcomes": {
