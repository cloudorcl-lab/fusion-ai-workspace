        {
          "metadata": {
            "name": "Refine Response from Assistant",
            "sourceCode": "let result = { type: \"text\", message: {} };\ntry {\n  const assistantOutput = JSON.parse($context.$nodes.INVOKE_OPPORTUNITY_ASSISTANT.$output.output);\n\n  if (assistantOutput && typeof assistantOutput === \"object\") {\n\n    const responseType = assistantOutput.type;\n    if (responseType === \"text\") {\n      result = { type: \"text\", message: { messageString: \"No Results found\" } };\n    } else {\n      const primaryText = assistantOutput.primaryText || \"\";\n      const secondaryText = assistantOutput.secondaryText || \"\";\n      const postback = assistantOutput.postback || \"\";\n\n      const messageString = `# ${primaryText}\\n## ${secondaryText}\\n${postback}`;\n\n      result = {\n        type: responseType,\n        message: {\n          primaryText: primaryText,\n          secondaryText: secondaryText,\n          postback: postback,\n          messageString: messageString\n        }\n      };\n    }\n  } else {\n    // If output is not object or missing, default to text with messageString \"No Results found\"\n    result = { type: \"text\", message: { messageString: \"No Results found\" } };\n  }\n} catch (error) {\n  result = { type: \"text\", message: { messageString: \"No Results found\" } };\n}\n\nreturn result;",
            "returnType": "object"
          },
