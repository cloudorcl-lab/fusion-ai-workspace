        {
          "id": "1779493076786",
          "code": "DEALS_DATA_REFERENCE",
          "type": "REFERENCEABLEBLOCK",
          "metadata": {
            "name": "Deals Data Reference",
            "dataPipeline": {
              "rootNode": "start_1779493076786",
              "pipelineNodes": [
                {
                  "id": "start_1779493076786",
                  "code": "START",
                  "type": "START",
