                },
                {
                  "id": "1779493139052",
                  "code": "GENERATE_DEAL_INSIGHTS_PAYLOAD",
                  "type": "CODE",
                  "metadata": {
                    "name": "Generate Deal Insights Payload",
                    "sourceCode": "let result = {};\ntry {\n  const opportunityId = $context.$input.opportunityId || \"\";\n\n  result = {\n    collection: {\n      filter: \"opportunity.id=\" + opportunityId\n    },\n    fields: [\"id\", \"engagementInsightNumber\", \"additionalInsightData\"]\n  };\n} catch (error) {\n  // Return empty object on error\n  result = {};\n}\n\nreturn result;",
                    "returnType": "object"
                  },
                  "diagram": {
                    "x": 16342,
                    "y": 5241
                  },
                  "outcomes": {
                    "success": "1779493112719"
                  },
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "id": "1779493151425",
                  "code": "BUILD_INSIGHTS_DATA_WIDGET",
                  "type": "CODE",
                  "metadata": {
                    "name": "Build Insights Data Widget",
                    "sourceCode": "let result = [];\ntry {\n  // Get the first item from GET_RECENT_DEAL_INSIGHTS output items array\n  const recentInsights = $context.$nodes.GET_RECENT_DEAL_INSIGHTS.$output.items || [];\n  const firstInsight = recentInsights.length > 0 ? recentInsights[0] : null;\n \n  // Get opportunities object from additionalInsightData.dataCapture\n  const parsedData = JSON.parse(firstInsight.additionalInsightData);\n  \n  const opportunities = parsedData.dataCapture.opportunities || {};\n\n  // Get metadata array from GET_OPTY_METADATA output\n  const metadataArray = $context.$nodes?.GET_OPTY_METADATA?.$output || [];\n\n  // Build a map from metadata field to metadata object for quick lookup\n  const metadataMap = new Map();\n  for (const meta of metadataArray) {\n    if (meta?.field) {\n      metadataMap.set(meta.field, meta);\n    }\n  }\n\n  // Iterate over each key in opportunities and build output object\n  for (const key of Object.keys(opportunities)) {\n    const value = opportunities[key];\n    // Find corresponding metadata by matching key with metadata field\n    // TODO: Inferred 'field' from user text 'key' in additionalInsightData.dataCapture.opportunities\n    // The key from opportunities is likely a field name or suffix, so we try exact match first\n    // If no exact match, try to find metadata where field ends with key (case sensitive)\n    let meta = metadataMap.get(key);\n    if (!meta) {\n      // Try to find metadata where field ends with key\n      meta = metadataArray.find(m => m?.field?.endsWith(key));\n    }\n\n    // If metadata found, use its properties, else fallback\n    const attributeType = meta?.attributeType || \"text\";\n    const displayLabel = meta?.displayLabel || key;\n    const isEnum = attributeType === \"Enum\";\n    const options = isEnum ? (meta?.enums || []) : undefined;\n\n    const outputObj = {\n      id: key,\n      type: isEnum ? \"select\" : \"text\",\n      label: displayLabel,\n      value: value\n    };\n\n    if (isEnum) {\n      outputObj.options = options;\n    }\n\n    result.push(outputObj);\n  }\n} catch (error) {\n  result = [];\n}\n\nreturn result;",
                    "returnType": "array"
                  },
                  "diagram": {
                    "x": 16357,
                    "y": 5961
                  },
                  "outcomes": {
                    "success": "1779493163158"
                  },
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
