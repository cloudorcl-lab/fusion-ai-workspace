          "type": "LLM",
          "inputs": [
            {
              "id": "1774727302869_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Generate a concise executive-style customer engagement summary in markdown, in professional business language.\n\nFormat the output exactly like this:\n\n### A strong headline/title summarizing the engagement sentiment and opportunity status\n\n3 short bullet points.\n\nEach bullet should be business-readable, concise, and narrative-driven.\nFocus on renewal motion, expansion signals, customer engagement quality, stakeholder involvement, risks, and next steps.\nUse positive, natural enterprise sales language similar to executive account reviews.\nAvoid mentioning percentages directly unless critical.\nDo not mention “Sentiment: Neutral” explicitly.\nKeep the tone polished, strategic, and customer-success oriented.\nAvoid technical formatting or HTML.\n\nInput Data: `{{$context.$nodes.REFINE_SUMMARY.$output.result}}`\n"
            },
            {
              "id": "1774727302869_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": ""
            }
          ]
        },
