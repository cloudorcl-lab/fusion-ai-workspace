            "sourceCode": "let result = {};\ntry {\n  var payload = $context.$app.$OraAction;\n  var obj = payload;\n\n  if (typeof obj === \"string\") {\n    obj = obj.trim();\n    obj = JSON.parse(obj);      // first parse\n  }\n\n  if (typeof obj === \"string\") {\n    obj = JSON.parse(obj);      // second parse if it was double-encoded\n  }\n\n  result = {\n    opportunityId: obj.opportunityId,\n    opportunityNumber: obj.opportunityNumber,\n    task: obj.task,\n    title: obj.title,\n    action: obj.action,\n    activityNumber: obj.activityNumber,\n    emailAddress: obj.EmailAddress,\n    firstName: obj.FirstName,\n    lastName: obj.LastName,\n    partyNumber: obj.PartyNumber,\n    partyName: obj.PartyName\n  };\n} catch (error) {\n  result = {\n    opportunityId: null,\n    opportunityNumber: null,\n    task: null,\n    title: null,\n    action: null\n  };\n}\n\nreturn result;",
            "returnType": "object"
          },
