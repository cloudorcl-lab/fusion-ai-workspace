        {
          "id": "1781044326548",
          "code": "BUILD_CONTACT_PAYLOAD",
          "type": "CODE",
          "metadata": {
            "name": "Build Contact Payload",
            "sourceCode": "let result = {};\n\ntry {\n  const contact = $context.$nodes.GET_PARTY_DETAILS.$output || {};\n  const input = $context.$nodes.REFINE_FORM_DATA.$output.result || {};\n\n  const accountPartyId = contact.AccountPartyId || null;\n\n  const emailAddress = contact.EmailAddress || null;\n  const firstName = contact.FirstName || null;\n  const lastName = contact.LastName || null;\n\n  const favoriteContactFlag = input.primaryContact === \"Y\";\n\n  const doNotCall = input.doNotCall || \"N\";\n  const doNotEmail = input.doNotEmail || \"N\";\n\n  result = {\n    AccountPartyId: accountPartyId,\n    EmailAddress: emailAddress,\n    FirstName: firstName,\n    LastName: lastName,\n    Type: \"ZCA_CONTACT\",\n\n    FavoriteContactFlag: favoriteContactFlag,\n\n    DoCallWorkPhoneFlag: doNotCall === \"N\",\n    DoNotCallWorkPhoneFlag: doNotCall === \"Y\",\n\n    DoCallMobilePhoneFlag: doNotCall === \"N\",\n    DoNotCallMobileFlag: doNotCall === \"Y\",\n\n    DoContactEmailFlag: doNotEmail === \"N\",\n    DoNotContactEmailFlag: doNotEmail === \"Y\"\n  };\n} catch (error) {\n  result = {};\n}\n\nreturn result;",
            "returnType": "object"
          },
          "diagram": {
            "x": 9211.25,
            "y": 7870
          },
          "outcomes": {
            "success": "1781117514693"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
