            "sourceCode": "let result = {};\ntry {\n\n  const activityNumber = $context.$nodes.RETRIEVE_THE_OPTY_PARAMETERS.$output.result.activityNumber || null;\n\n  result = {\n    op: \"$eq\",\n    attribute: \"ActivityNumber\",\n    value: activityNumber\n  };\n} catch (error) {\n  // Return empty object on error\n  result = {};\n}\n\nreturn result;",
            "returnType": "object"
          },
