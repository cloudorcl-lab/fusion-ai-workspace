              "value": "Create a messagelistWidget with properties based on {{$context.$nodes.COMBINE_CONTACTS.$output.result}} \n\nEach row:\ntitle: <ContactName from each row>\nsubtitle: <JobTitle from each row>\nsummary: <AccountUniqueName from each row>\nbadgeText: if RecommendedContactFlag is true then \"Recommended\", else \"High Influence\"\npriority: if RecommendedContactFlag is true then \"info\", else \"success\"\nadditionalAction: \n          if RecommendedContactFlag is true then\n          \"text\": \"Add\",\n           \"command\": \"ora.Invoke(\\\"addRecommendedContact\\\", {\\\"FirstName\\\":\\\"<FirstName from current row>\\\",\\\"LastName\\\":\\\"<LastName from current row>\\\",\\\"EmailAddress\\\":\\\"<EmailAddress from current row>\\\",\\\"action\\\":\\\"addRecommendedContact\\\"})\"\n          else\n          \"text\": \"Linked In\",\n          \"command\": \"ora.Invoke(\\\"launchLinkedIn\\\", {\\\"id\\\":\\\"linkedIn\\\",\\\"type\\\":\\\"html\\\",\\\"title\\\":\\\"Linked Profile\\\",\\\"html\\\":{\\\"pollIntervalMs\\\":30000,\\\"maxPollAttempts\\\":24,\\\"parameters\\\":{\\\"crmOrgId\\\":\\\"<$context.$nodes.GET_APP_FOREIGN.$output.parts[0].payload.result>\\\",\\\"contact\\\":\\\"<ContactName from each row>\\\",\\\"FirstName\\\":\\\"<FirstName from each row>\\\",\\\"LastName\\\":\\\"<LastName from each row>\\\",\\\"EmailAddress\\\":\\\"<EmailAddress from each row>\\\",\\\"PartyNumber\\\":\\\"<PartyNumber from each row>\\\",\\\"AccountName\\\":\\\"<AccountName from each row>\\\"}}})\"\n        "
