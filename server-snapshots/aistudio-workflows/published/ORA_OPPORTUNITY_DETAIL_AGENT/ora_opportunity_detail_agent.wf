            "sourceCode": "let result = false;\ntry {\n  const oraAction = $context.$app?.$OraAction || \"\";\n  // Check if $OraAction starts with '<oraFormSubmit'\n  result = oraAction.startsWith(\"<oraFormSubmit\");\n} catch (error) {\n  result = false;\n}\n\nreturn result;",
