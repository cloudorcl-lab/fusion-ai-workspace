              "required": true,
              "type": "string"
            }
          ]
        },
        {
          "metadata": {
            "name": "Generate Response",
            "answerInUserLanguage": true
          },
          "diagram": {
            "x": 11477,
            "y": 7204
          },
          "outcomes": {
            "success": "end"
          },
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "enableCommunications": true,
              "enablePowerPoints": true,
              "enableActions": true
            }
          },
          "id": "1776477657850",
          "code": "GENERATE_RESPONSE",
          "type": "LLM",
          "inputs": [
            {
              "id": "1776477657850_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Using the outputs from GET_APPOINTMENT_DETAILS Data - {{$context.$nodes.GET_APPOINTMENT_DETAILS.$output}} and \nGET_ACCOUNT_INSIGHTS_FOR_MEETING Data - {{$context.$nodes.GET_ACCOUNT_INSIGHTS_FOR_MEETING.$output}}, generate a detailed meeting \npreparation summary with the following structure:\n\n## Meeting Preparation\n- Use the 'Subject' field from the first element of GET_APPOINTMENT_DETAILS output. - Mardown header level 1\n- Use the 'detailedAgenda' from GET_ACCOUNT_INSIGHTS_FOR_MEETING node's items[0].payload.what.facts.agenda.detailedAgenda.\n\nTime: <Format 'ActivityStartDate' from GET_APPOINTMENT_DETAILS node into locale date and time with local timezone at end, e.g., \"Jan 20, 2026, Thursday 3:00PM PST\" or \n  \"January 20th, Thursday 3:00PM PST\".>\n- For location, use 'Location' from GET_APPOINTMENT_DETAILS if present; otherwise, use 'ActivityDescription' location if \n  available; if neither, omit location.\n\n#### About <{{$context.$nodes.GET_ACCOUNT_INSIGHTS_FOR_MEETING.$output.items[0].payload.what.facts.accountInsights.name}}>\n- Industry: {{$context.$nodes.GET_ACCOUNT_INSIGHTS_FOR_MEETING.$output.items[0].payload.what.facts.accountInsights.industry}}\n- Sentiment: {{\n  let s = $context.$nodes.GET_ACCOUNT_INSIGHTS_FOR_MEETING.$output.items[0].payload.what.facts.accountInsights.sentiment;\n  s.charAt(0).toUpperCase()+s.slice(1)+\" sentiment: \" + $context.$nodes.GET_ACCOUNT_INSIGHTS_FOR_MEETING.$output.items[0].payload.what.facts.accountInsights.sentimentDescription\n}}\n- Products: {{$context.$nodes.GET_ACCOUNT_INSIGHTS_FOR_MEETING.$output.items[0].payload.what.facts.accountInsights.products}}\n\n\n#### \n{{\n  let opp = $context.$nodes.GET_ACCOUNT_INSIGHTS_FOR_MEETING.$output.items[0].payload.what.facts.opportunityInsights;\n  let lead = $context.$nodes.GET_ACCOUNT_INSIGHTS_FOR_MEETING.$output.items[0].payload.what.facts.leadInsights;\n  let data = opp || lead;\n  if(data){\n    let parts = [];\n    if(data.name) parts.push(data.name);\n    if(data.stage) parts.push(data.stage + (data.winProbability ? \"(\" + data.winProbability + \")\" : \"\"));\n    if(data.dealSize) parts.push(data.dealSize);\n    if(data.closeDate) parts.push(data.closeDate);\n    parts.join(\" | \");\n  }\n}} \n\n\n{{\n  let opp = $context.$nodes.GET_ACCOUNT_INSIGHTS_FOR_MEETING.$output.items[0].payload.what.facts.opportunityInsights;\n  let lead = $context.$nodes.GET_ACCOUNT_INSIGHTS_FOR_MEETING.$output.items[0].payload.what.facts.leadInsights;\n  let data = opp || lead;\n  if(data){\n    let details = [];\n    if(data.products) details.push(\"Products: \" + data.products);\n    if(data.keyStakeholder) details.push(\"Key Stakeholder: \" + data.keyStakeholder);\n    if(data.signals) details.push(\"Signals: \" + data.signals);\n    if(data.competitiveLandscape) details.push(\"Competitive Landscape: \" + data.competitiveLandscape);\n    details.join(\"\\n- \");\n  }\n}}\n\n#### Customer Attendees\n{{\n  let contacts = $context.$nodes.GET_ACCOUNT_INSIGHTS_FOR_MEETING.$output.items[0].payload.what.facts.contactRelationship || [];\n  contacts.map(c => {\n    let sentiment = c.sentiment.charAt(0).toUpperCase() + c.sentiment.slice(1) + \" sentiment: \" + c.sentimentDescription;\n    let nameTitle = c.name + (c.jobTitle ? \" (\" + c.jobTitle + \")\" : \"\");\n    let influence = c.influenceLevel.charAt(0).toUpperCase() + c.influenceLevel.slice(1) + \" influence - \" + c.influenceDescription;\n    return `- ${nameTitle}\n  - ${sentiment}\n  - ${influence}\n  - Recent Engagement: ${c.recentEngagement || \"N/A\"}`;\n  }).join(\"\\n\")\n}}\n\n#### Pre-Meeting Checklist\n- {{$context.$nodes.GET_ACCOUNT_INSIGHTS_FOR_MEETING.$output.items[0].payload.what.facts.meetingStrategyAndRecommendations.preMeetingChecklist.join(\"\\n- \")}}\n\n#### Key Talking Points\n{{\n  let points = $context.$nodes.GET_ACCOUNT_INSIGHTS_FOR_MEETING.$output.items[0].payload.what.facts.meetingStrategyAndRecommendations.talkingPoints || [];\n  points.map((p,i) => `${i+1}. ${p}`).join(\"\\n\")\n}}\n\n#### Objection Handling\n- {{$context.$nodes.GET_ACCOUNT_INSIGHTS_FOR_MEETING.$output.items[0].payload.what.facts.meetingStrategyAndRecommendations.objectionHandling.join(\"\\n- \")}}\n\n#### Intended Outcome\n- {{$context.$nodes.GET_ACCOUNT_INSIGHTS_FOR_MEETING.$output.items[0].payload.what.facts.meetingStrategyAndRecommendations.intendedOutcome.join(\"\\n- \")}}\n\n#### Recent Engagement Summary\n{{$context.$nodes.GET_ACCOUNT_INSIGHTS_FOR_MEETING.$output.items[0].payload.what.facts.recentEngagementSummary}}\n\nEnsure all markdown formatting is correct and omit any sections or fields if data is missing. Maintain proper spacing between sections without excessive blank lines."
            },
            {
              "id": "1776477657850_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "Use concise and clear language for each output section. Maintain all existing\nprompt template rules and expression formats as provided."
            }
          ]
        },
        {
          "id": "1779839237110",
          "code": "IS_ACTION_PRESENT",
          "type": "CONDITION",
          "convergenceTargetId": "end",
          "metadata": {
            "name": "Is Action Present"
