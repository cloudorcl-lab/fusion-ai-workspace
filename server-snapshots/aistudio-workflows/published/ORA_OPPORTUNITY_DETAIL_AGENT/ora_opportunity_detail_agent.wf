        {
          "id": "1779493745705",
          "code": "PARSE_DEALS_DATA_FOR_EDIT",
          "type": "CODE",
          "metadata": {
            "name": "Parse Deals Data for Edit",
            "sourceCode": "let result = [];\ntry {\n  // Get the deals data for edit from upstream node\n  const dealsData = $context.$nodes?.GET_DEALS_DATA_FOR_EDIT?.$output;\n\n  // Initialize result as an array\n  if (Array.isArray(dealsData)) {\n    result = [...dealsData];\n  } else if (dealsData) {\n    // If dealsData is an object but not array, wrap it in array\n    result = [dealsData];\n  } else {\n    result = [];\n  }\n\n  // Append the specified system action object\n  result.push({ id: \"action\", type: \"system\", value: \"editDealsData\" });\n} catch (error) {\n  result = [{ id: \"action\", type: \"system\", value: \"editDealsData\" }];\n}\n\nreturn result;",
            "returnType": "array"
          },
