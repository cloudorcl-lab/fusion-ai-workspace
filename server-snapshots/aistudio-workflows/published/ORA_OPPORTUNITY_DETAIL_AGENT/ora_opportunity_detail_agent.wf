        {
          "id": "1781029016349",
          "code": "REFINE_RECOMMENDED_CONTACTS",
          "type": "CODE",
          "metadata": {
            "name": "Refine Recommended Contacts",
            "sourceCode": "let result = [];\ntry {\n  // Access the items array safely\n  const engagementItems = $context.$nodes?.GET_RECOMMENDED_CONTACTS?.$output?.items || [];\n\n  // Iterate over each engagement insight item\n  for (const item of engagementItems) {\n    // Parse the additionalInsightData JSON string safely\n    let additionalData = {};\n    try {\n      additionalData = JSON.parse(item.additionalInsightData || '{}');\n    } catch (parseError) {\n      // If parsing fails, continue to next item\n      continue;\n    }\n\n    // Extract recommendedContacts array from parsed data\n    let recommendedContacts = additionalData.recommendedContacts;\n\n    // Map each recommended contact to the desired output structure\n    for (const contact of recommendedContacts) {\n      result.push({\n        // TODO: Inferred 'DisplayName' from user text 'LastName'\n        ContactName: (contact.FirstName || '') + ' ' + (contact.LastName || ''),\n        EmailAddress: contact.EmailAddress || '',\n        FirstName: contact.FirstName || '',\n        LastName: contact.LastName || '',\n        JobTitle: contact.JobTitle || '',\n        AccountUniqueName: contact.AccountUniqueName || '',\n        RecommendedContactFlag: true\n      });\n    }\n  }\n} catch (error) {\n  result = [];\n}\n\nreturn result;",
            "returnType": "array"
          },
          "diagram": {
            "x": 5022.5,
            "y": 8092
          },
          "outcomes": {
            "success": "1781029953653"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1781029953653",
          "code": "COMBINE_CONTACTS",
          "type": "CODE",
          "metadata": {
            "name": "Combine Contacts",
            "sourceCode": "let result = [];\ntry {\n  // Get refined recommended contacts array safely\n  const refinedRecommended = $context.$nodes?.REFINE_RECOMMENDED_CONTACTS?.$output?.result || [];\n  // Get contacts array safely\n  const contacts = $context.$nodes?.GET_CONTACTS?.$output?.items || [];\n\n  // Combine arrays with refinedRecommended first if it exists\n  result = refinedRecommended.concat(contacts);\n} catch (error) {\n  result = [];\n}\n\nreturn result;",
            "returnType": "array"
          },
