        {
          "id": "1781113181379",
          "code": "BUILD_CREATE_CONTACT_PAYLOAD",
          "type": "CODE",
          "metadata": {
            "name": "Build Create Contact Payload",
            "sourceCode": "let result = {};\n\ntry {\n  const input = $context.$nodes.REFINE_FORM_DATA.$output.result || {};\n\n  const partyName = input.partyName || \"\";\n\n  let firstName = null;\n  let lastName = null;\n\n  if (partyName.trim()) {\n    const lastSpaceIndex = partyName.trim().lastIndexOf(\" \");\n\n    if (lastSpaceIndex > 0) {\n      lastName = partyName.substring(0, lastSpaceIndex).trim();\n      firstName = partyName.substring(lastSpaceIndex + 1).trim();\n    } else {\n      firstName = partyName.trim();\n    }\n  }\n\n  const emailAddress = input.emailAddress || null;\n\n  const favoriteContactFlag = input.primaryContact === \"Y\";\n\n  const doNotCall = input.doNotCall || \"N\";\n  const doNotEmail = input.doNotEmail || \"N\";\n\n  result = {\n    EmailAddress: emailAddress,\n    FirstName: firstName,\n    LastName: lastName,\n    Type: \"ZCA_CONTACT\",\n\n    FavoriteContactFlag: favoriteContactFlag,\n\n    DoCallWorkPhoneFlag: doNotCall === \"N\",\n    DoNotCallWorkPhoneFlag: doNotCall === \"Y\",\n\n    DoCallMobilePhoneFlag: doNotCall === \"N\",\n    DoNotCallMobileFlag: doNotCall === \"Y\",\n\n    DoContactEmailFlag: doNotEmail === \"N\",\n    DoNotContactEmailFlag: doNotEmail === \"Y\"\n  };\n} catch (error) {\n  result = {};\n}\n\nreturn result;",
            "returnType": "object"
          },
          "diagram": {
            "x": 9661.25,
            "y": 7648
          },
          "outcomes": {
            "success": "1781117553487"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
