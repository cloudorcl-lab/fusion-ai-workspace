            "sourceCode": "let result = {};\ntry {\n  // Construct the payload object with filter and fields as specified\n  result = {\n    collection: {\n      filter: \"opportunity.id=\" + $context.$variables.opportunityId\n    },\n    fields: [\"engagementInsightNumber\", \"additionalInsightData\"]\n  };\n} catch (error) {\n  // Return empty object on error\n  result = {};\n}\n\nreturn result;\n",
