          },
          "id": "1776475338688",
          "code": "GET_ACCOUNT_INSIGHTS_FOR_MEETING",
          "type": "BO_FUNCTION",
          "inputs": [
            {
              "id": "1776475338688_ObjectType",
              "name": "ObjectType",
              "value": "ACTIVITY",
              "required": true,
              "type": "string"
            },
            {
              "id": "1776475338688_ObjectAltKey",
