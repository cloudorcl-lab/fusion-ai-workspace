          "metadata": {
            "name": "Refine Summary",
            "sourceCode": "let result = \"\";\ntry {\n  // Access the first item safely\n  const firstItem = $context.$nodes?.ENGAGEMENT_INSIGHTS_FOR_SOURCE_OBJECT?.$output?.items?.[0];\n  if (firstItem && firstItem.payload) {\n    // Parse the payload JSON string\n    const payloadObj = JSON.parse(firstItem.payload);\n    result = payloadObj.what?.summary || \"\";\n  } else {\n    result = \"\";\n  }\n} catch (error) {\n  result = \"\";\n}\n\nreturn result;",
            "returnType": "string"
          },
