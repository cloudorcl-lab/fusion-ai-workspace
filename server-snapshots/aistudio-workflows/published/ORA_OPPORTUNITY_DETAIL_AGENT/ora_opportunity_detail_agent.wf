        {
          "id": "1779493565241",
          "code": "PARSE_DEALS_DATA_FOR_VIEW",
          "type": "CODE",
          "metadata": {
            "name": "Parse Deals Data for View",
            "sourceCode": "let result = [];\ntry {\n  // Safely get the deals data array from upstream node\n  const dealsData = $context.$nodes?.GET_DEALS_DATA_FOR_VIEW?.$output || [];\n\n  // Ensure dealsData is an array, if not fallback to empty array\n  const dealsArray = Array.isArray(dealsData) ? dealsData : [];\n\n  // Append the specified system action object\n  result = [...dealsArray, { id: \"action\", type: \"system\", value: \"editDealsData\" }];\n} catch (error) {\n  // On error, return array with only the system action object\n  result = [{ id: \"action\", type: \"system\", value: \"editDealsData\" }];\n}\n\nreturn result;",
            "returnType": "array"
          },
          "diagram": {
            "x": 7460,
            "y": 7426
          },
          "outcomes": {
            "success": "1779490270476"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1779490270476",
          "code": "GENERATE_RECENT_DEALS_RESPONSE",
          "type": "LLM",
          "metadata": {
            "name": "Generate Recent Deals Response"
          },
          "diagram": {
