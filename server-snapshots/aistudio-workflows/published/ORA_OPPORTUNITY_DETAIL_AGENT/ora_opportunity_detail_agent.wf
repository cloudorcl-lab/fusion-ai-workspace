            "sourceCode": "let result = {};\ntry {\n  // Safely access PartyId from CREATE_CONTACT node output\n  const partyId = $context.$nodes?.CREATE_CONTACT?.$output?.PartyId || null;\n\n  result = { PERPartyId: partyId };\n} catch (error) {\n  // On error, return object with PERPartyId as null\n  result = { PERPartyId: null };\n}\n\nreturn result;",
