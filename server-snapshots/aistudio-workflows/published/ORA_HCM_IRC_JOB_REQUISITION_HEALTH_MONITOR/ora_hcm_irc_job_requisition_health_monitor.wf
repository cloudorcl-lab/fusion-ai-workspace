                    "name": "Collate Requisition Public Result",
                    "returnType": "object",
                    "sourceCode": "var currentItem = $context.$nodes.REQUISITION_PUBLIC_ENDPOINT_LOOP.$currentItem || {};\n\nvar parseObject = function(value) {\n    if (!value) return null;\n    if (typeof value === \"string\") {\n        try {\n            return JSON.parse(value);\n        } catch (e) {\n            return null;\n        }\n    }\n    if (typeof value === \"object\") {\n        return value;\n    }\n    return null;\n};\n\nvar unwrapResultObject = function(value) {\n    var parsed = parseObject(value);\n    if (!parsed) return {};\n    if (parsed.result && typeof parsed.result === \"object\" && !Array.isArray(parsed.result)) {\n        return parsed.result;\n    }\n    return parsed;\n};\n\nvar getItems = function(value) {\n    var parsed = unwrapResultObject(value);\n    if (Array.isArray(parsed)) return parsed;\n    if (Array.isArray(parsed.items)) return parsed.items;\n    return [];\n};\n\nvar mapSkills = function(value) {\n    var items = getItems(value);\n    var skills = [];\n    for (var i = 0; i < items.length; i++) {\n        var skill = items[i] || {};\n        skills.push({\n            Skills: skill.Skills,\n            Importance: skill.Importance,\n            RequiredFlag: skill.RequiredFlag,\n            MinimumYearsOfExperience: skill.MinimumYearsOfExperience\n        });\n    }\n    return skills;\n};\n\nvar mapSubmissions = function(value) {\n    var items = getItems(value);\n    var submissions = [];\n\n    for (var i = 0; i < items.length; i++) {\n        var sub = items[i] || {};\n\n        var candidateName = sub.names && sub.names.displayName ? sub.names.displayName : null;\n        var candidateNumber =\n            sub.candidates && sub.candidates[0] && sub.candidates[0].candidateNumber\n                ? sub.candidates[0].candidateNumber\n                : null;\n\n        var addr =\n            sub.candidates &&\n            sub.candidates[0] &&\n            sub.candidates[0].address &&\n            sub.candidates[0].address[0]\n                ? sub.candidates[0].address[0]\n                : null;\n\n        var location = addr\n            ? {\n                  city: addr.townOrCity || null,\n                  state: addr.region2 || null,\n                  country: addr.country || null\n              }\n            : null;\n\n        var scores = sub.applicantScore\n            ? {\n                  experience:\n                      sub.applicantScore.experienceAiScore >= 0\n                          ? sub.applicantScore.experienceAiScore\n                          : null,\n                  skills:\n                      sub.applicantScore.skillsAiScore >= 0 ? sub.applicantScore.skillsAiScore : null,\n                  education:\n                      sub.applicantScore.educationAiScore >= 0\n                          ? sub.applicantScore.educationAiScore\n                          : null,\n                  profile:\n                      sub.applicantScore.profileAiScore >= 0 ? sub.applicantScore.profileAiScore : null\n              }\n            : null;\n\n        var experiences = Array.isArray(sub.jobApplicationExperience)\n            ? sub.jobApplicationExperience.map(function(exp) {\n                  return {\n                      jobTitle: exp.jobTitle || null,\n                      employerName: exp.employerName || null\n                  };\n              })\n            : [];\n\n        var education = Array.isArray(sub.jobApplicationEducation)\n            ? sub.jobApplicationEducation.map(function(ed) {\n                  var schoolName =\n                      ed.schoolContentItems && ed.schoolContentItems.schoolName\n                          ? ed.schoolContentItems.schoolName\n                          : ed.schoolFreeText || null;\n                  return {\n                      schoolName: schoolName || null,\n                      degree: ed.degreeFreeText || null,\n                      major: ed.major || null\n                  };\n              })\n            : [];\n\n        submissions.push({\n            candidateName: candidateName,\n            candidateNumber: candidateNumber,\n            location: location,\n            submissionDate: sub.submissionDate || null,\n            phase: sub.currentPhase && sub.currentPhase.phaseName ? sub.currentPhase.phaseName : null,\n            state: sub.currentState && sub.currentState.stateName ? sub.currentState.stateName : null,\n            active: sub.activeFlag === \"Y\",\n            disqualified:\n                sub.disqualifiedFlag === \"Y\" ? true : sub.disqualifiedFlag === \"N\" ? false : null,\n            restricted: sub.isRestrictedFlag === \"Y\",\n            confirmed: sub.confirmedFlag === \"Y\",\n            addedBy: sub.addedByContextCode || null,\n            scores: scores,\n            experiences: experiences,\n            education: education\n        });\n    }\n\n    return submissions;\n};\n\nvar requisition = unwrapResultObject($context.$nodes.GET_REQUISITION_FULL_DETAILS.$output);\nvar submissions = mapSubmissions($context.$nodes.GET_JOB_APPLICATIONS.$output);\nvar skills = requisition.skills ? mapSkills(requisition.skills) : mapSkills($context.$nodes.GET_REQUISITION_FULL_DETAILS.$output);\n\nreturn {\n    RequisitionId: requisition.RequisitionId || currentItem.RequisitionId || null,\n    RequisitionNumber: requisition.RequisitionNumber || currentItem.RequisitionNumber || null,\n    Title: requisition.Title || currentItem.Title || null,\n    StateName: requisition.StateName || currentItem.StateName || null,\n    PrimaryLocationName: requisition.PrimaryLocationName || currentItem.PrimaryLocationName || null,\n    ExternalDescription: requisition.ExternalDescription || null,\n    InternalPublishedJobStartDate:\n        requisition.InternalPublishedJobStartDate || requisition.InternalPublishJobStartDate || null,\n    InternalPublishedJobEndDate:\n        requisition.InternalPublishedJobEndDate || requisition.InternalPublishJobEndDate || null,\n    ExternalPublishedJobStartDate:\n        requisition.ExternalPublishedJobStartDate || requisition.ExternalPublishJobStartDate || null,\n    ExternalPublishedJobEndDate:\n        requisition.ExternalPublishedJobEndDate || requisition.ExternalPublishJobEndDate || null,\n    CreationDate: requisition.CreationDate || currentItem.CreationDate || null,\n    HiredCount: currentItem.HiredCount,\n    JobApplicationCount: currentItem.JobApplicationCount,\n    NewJobApplicationCount: currentItem.NewJobApplicationCount,\n    ProspectCount: currentItem.ProspectCount,\n    skills: skills,\n    submissions: submissions\n};"
