    sub.candidates[0].address &&\n            sub.candidates[0].address[0]\n                ? sub.candidates[0].address[0]\n                : null;\n        var location = addr\n            ? {\n                  city: addr.townOrCity || null,\n                  state: addr.region2 || null,\n                  country: addr.country || null\n              }\n            : null;\n        var scores = sub.applicantScore\n            ? {\n                  experience:\n                      sub.applicantScore.experienceAiScore >= 0\n                          ? sub.applicantScore.experienceAiScore\n                          : null,\n                  skills:\n                      sub.applicantScore.skillsAiScore >= 0 ? sub.applicantScore.skillsAiScore : null,\n                  education:\n                      sub.applicantScore.educationAiScore >= 0\n                          ? sub.applicantScore.educationAiScore\n                          : null,\n                  profile:\n                      sub.applicantScore.profileAiScore >= 0 ? sub.applicantScore.profileAiScore : null\n              }\n            : null;\n        var experiences = Array.isArray(sub.jobApplicationExperience)\n            ? sub.jobApplicationExperience.map(function(exp) {\n                  return {\n                      jobTitle: exp.jobTitle || null,\n                      employerName: exp.employerName || null\n                  };\n              })\n            : [];\n        var education = Array.isArray(sub.jobApplicationEducation)\n            ? sub.jobApplicationEducation.map(function(ed) {\n                  var schoolName =\n                      ed.schoolContentItems && ed.schoolContentItems.schoolName\n                          ? ed.schoolContentItems.schoolName\n                          : ed.schoolFreeText || null;\n                  return {\n                      schoolName: schoolName || null,\n                      degree: ed.degreeFreeText || null,\n                      major: ed.major || null\n                  };\n              })\n            : [];\n\n        submissions.push({\n            candidateName: candidateName,\n            candidateNumber: candidateNumber,\n            location: location,\n            submissionDate: sub.submissionDate || null,\n            phase: sub.currentPhase && sub.currentPhase.phaseName ? sub.currentPhase.phaseName : null,\n            state: sub.currentState && sub.currentState.stateName ? sub.currentState.stateName : null,\n            active: sub.activeFlag === \"Y\",\n            disqualified:\n                sub.disqualifiedFlag === \"Y\" ? true : sub.disqualifiedFlag === \"N\" ? false : null,\n            restricted: sub.isRestrictedFlag === \"Y\",\n            confirmed: sub.confirmedFlag === \"Y\",\n            addedBy: sub.addedByContextCode || null,\n            scores: scores,\n            experiences: experiences,\n            education: education\n        });\n    }\n\n    return submissions;\n};\n\nfor (var i = 0; i < arr.length; i++) {\n    var directEntry = unwrapResultObject(arr[i]);\n    if (\n        directEntry &&\n        typeof directEntry === \"object\" &&\n        !Array.isArray(directEntry) &&\n        (directEntry.RequisitionId ||\n            directEntry.RequisitionNumber ||\n            directEntry.Title ||\n            directEntry.StateName ||\n            directEntry.JobApplicationCount != null)\n    ) {\n        if (!Array.isArray(directEntry.skills)) directEntry.skills = [];\n        if (!Array.isArray(directEntry.submissions)) directEntry.submissions = [];\n        results.push(directEntry);\n        continue;\n    }\n\n    var obj = parseObject(arr[i]);\n    if (!obj || typeof obj !== \"object\") {\n        continue;\n    }\n\n    var entry = {};\n    var branch0 = obj[\"0\"] || obj[0] || null;\n    if (branch0 && branch0.content) {\n        try {\n            var requisition = unwrapResultObject(branch0.content);\n            entry.RequisitionId = requisition.RequisitionId;\n            entry.RequisitionNumber = requisition.RequisitionNumber;\n            entry.Title = requisition.Title;\n            entry.StateName = requisition.StateName;\n            entry.ExternalDescription = requisition.ExternalDescription;\n            entry.InternalPublishedJobStartDate = requisition.InternalPublishedJobStartDate;\n            entry.InternalPublishedJobEndDate = requisition.InternalPublishedJobEndDate;\n            entry.ExternalPublishedJobStartDate = requisition.ExternalPublishedJobStartDate;\n            entry.ExternalPublishedJobEndDate = requisition.ExternalPublishedJobEndDate;\n            entry.CreationDate = requisition.CreationDate;\n\n            var found = reqListValues.find(function(req) {\n                return req.RequisitionId === requisition.RequisitionId;\n            }) || {};\n\n            entry.HiredCount = found.HiredCount;\n            entry.JobApplicationCount = found.JobApplicationCount;\n            entry.NewJobApplicationCount = found.NewJobApplicationCount;\n            entry.ProspectCount = found.ProspectCount;\n            entry.PrimaryLocationName = found.PrimaryLocationName;\n\n            if (requisition.skills) {\n                entry.skills = mapSkills(requisition.skills);\n            }\n        } catch (e) {\n            entry.parseError = \"Failed to parse requisition content at index \" + i + \": \" + e;\n        }\n    }\n\n    var branch1 = obj[\"1\"] || obj[1] || null;\n    if (branch1 && branch1.content) {\n        try {\n            entry.submissions = mapSubmissions(branch1.content);\n        } catch (e) {\n            entry.parseError = \"Failed to parse requisition submissions at index \" + i + \": \" + e;\n        }\n    }\n\n    if (!Array.isArray(entry.skills)) entry.skills = [];\n    if (!Array.isArray(entry.submissions)) entry.submissions = [];\n    results.push(entry);\n}\n\nreturn results;"
          },
          "outcomes": {
            "success": "1765945809258"
          },
          "code": "BUILD_REQUISITION_FULL_DETAILS",
          "id": "1765917538062",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Set Requisition Full Details Data"
          },
          "outcomes": {
            "success": "1765428185514"
          },
          "code": "SET_REQUISITION_FULL_DETAILS_DATA",
          "id": "1765945809258",
          "inputs": [
            {
              "id": "1765945818372",
              "name": "RequisitionData",
              "type": "object",
              "value": "{{$context.$nodes.BUILD_REQUISITION_FULL_DETAILS.$output.result}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "analyse req results",
            "returnType": "object",
            "sourceCode": "// ===============================\n// CONFIGURABLE CONSTANTS\n// ===============================\nvar STAGNANT_MIN_APPLICATIONS = 10;      // was 10\nvar STAGNANT_DAYS_THRESHOLD = 3;         // was 3\n\nvar SKILL_GAP_MIN_APPLICANTS = 5;        // was 5\nvar SKILL_GAP_SCORE_THRESHOLD = 3;       // was 3\n\nvar LOW_VOLUME_APPS_PER_DAY = 3;         // was 3\n\nvar VOL_ADJ_THRESHOLD_1 = 3;             // was 3\nvar VOL_ADJ_THRESHOLD_2 = 1;             // was 1\n\nvar MAX_ZERO_JA_ALLOWED = 3;             // was 3 (kept; not used in \"most recent 6\" selection)\nvar MAX_RESULTS = 6;                     // was 6\n// ===============================\n\n\n// Robust Input Normalization\nvar rawInput = $context.$variables.RequisitionData;\nvar rawData = [];\n\nif (Array.isArray(rawInput)) {\n    rawData = rawInput;\n} else if (typeof rawInput === \"string\") {\n    try {\n        var parsed = JSON.parse(rawInput);\n        if (Array.isArray(parsed)) rawData = parsed;\n        else if (parsed && Array.isArray(parsed.result)) rawData = parsed.result;\n        else if (parsed && Array.isArray(parsed.RequisitionData)) rawData = parsed.RequisitionData;\n        else if (parsed && Array.isArray(parsed.requisitions)) rawData = parsed.requisitions;\n        else if (parsed && Array.isArray(parsed.items)) rawData = parsed.items;\n    } catch (e) {\n        rawData = [];\n    }\n} else if (rawInput && typeof rawInput === \"object\") {\n    if (Array.isArray(rawInput.result)) rawData = rawInput.result;\n    else if (Array.isArray(rawInput.RequisitionData)) rawData = rawInput.RequisitionData;\n    else if (Array.isArray(rawInput.requisitions)) rawData = rawInput.requisitions;\n    else if (Array.isArray(rawInput.items)) rawData = rawInput.items;\n}\n\nvar nowMs = Date.now();\nvar analyzedReqs = [];\nvar i;\n\nfor (i = 0; i < rawData.length; i++) {\n\n    var req = rawData[i] || {};\n    var jaCount = Number(req.JobApplicationCount) || 0;\n    var newJACount = Number(req.NewJobApplicationCount) || 0;\n\n    var applicantCount = Number(req.ApplicantCount) || 0;\n    var submissions = req.submissions;\n    if (!Array.isArray(submissions)) submissions = [];\n    if (applicantCount === 0 && submissions.length > 0) applicantCount = submissions.length;\n\n    var postedStr = req.ExternalPublishedJobStartDate || req.ExternalPublishJobStartDate || req.InternalPublishedJobStartDate || req.InternalPublishJobStartDate || req.PostedDate || req.CreationDate || null;\n    var postedMs = null;\n    if (postedStr) {\n        var d1 = new Date(postedStr);\n        if (!isNaN(d1.getTime())) postedMs = d1.getTime();\n    }\n\n    var latestStr = req.LatestActivityDate || null;\n    var latestMs = null;\n\n    if (latestStr) {\n        var d2 = new Date(latestStr);\n        if (!isNaN(d2.getTime())) latestMs = d2.getTime();\n    }\n\n    if (latestMs == null && submissions.length > 0) {\n        var maxSubMs = null;\n        var s;\n        for (s = 0; s < submissions.length; s++) {\n            var sd = submissions[s] && submissions[s].submissionDate ? submissions[s].submissionDate : null;\n            if (!sd) continue;\n            var d3 = new Date(sd);\n            if (isNaN(d3.getTime())) continue;\n            var t3 = d3.getTime();\n            if (maxSubMs == null || t3 > maxSubMs) maxSubMs = t3;\n        }\n        if (maxSubMs != null) latestMs = maxSubMs;\n    }\n\n    if (latestMs == null && postedMs != null) latestMs = postedMs;\n\n    var ageDays = null;\n    if (postedMs != null) ageDays = (nowMs - postedMs) / 86400000;\n\n    var daysSinceLastActivity = null;\n    if (latestMs != null) daysSinceLastActivity = (nowMs - latestMs) / 86400000;\n\n    var denomDays = 1;\n    if (ageDays != null && ageDays > 1) denomDays = ageDays;\n    var avgAppsPerDay = jaCount / denomDays;\n\n    var skillSum = 0;\n    var skillN = 0;\n    var k;\n\n    for (k = 0; k < submissions.length; k++) {\n        var sub = submissions[k] || {};\n        var scores = sub.scores || {};\n        if (scores.skills != null && scores.skills !== \"\") {\n            var sv = Number(scores.skills);\n            if (!isNaN(sv)) {\n                skillSum += sv;\n                skillN += 1;\n            }\n        }\n    }\n\n    var avgSkillScore = null;\n    if (skillN > 0) avgSkillScore = skillSum / skillN;\n\n    var badge = \"Healthy\";\n    var badgeReason = [];\n\n    // Stagnant\n    if (badge === \"Healthy\") {\n        if (jaCount >= STAGNANT_MIN_APPLICATIONS &&\n            daysSinceLastActivity != null &&\n            daysSinceLastActivity >= STAGNANT_DAYS_THRESHOLD) {\n\n            badge = \"Stagnant\";\n            badgeReason.push(\"10+ applications but no activity for \" +\n                (Math.round(daysSinceLastActivity * 100) / 100) +\n                \" days (>= \" + STAGNANT_DAYS_THRESHOLD + \").\");\n        }\n    }\n\n    // Skill Gap\n    if (badge === \"Healthy\") {\n        if (applicantCount >= SKILL_GAP_MIN_APPLICANTS &&\n            avgSkillScore != null &&\n            avgSkillScore < SKILL_GAP_SCORE_THRESHOLD) {\n\n            badge = \"Skill Gap\";\n            badgeReason.push(\"5+ applicants but AvgSkillScore \" +\n                (Math.round(avgSkillScore * 100) / 100) +\n                \" < \" + SKILL_GAP_SCORE_THRESHOLD + \".\");\n        }\n    }\n\n    // Low Volume\n    if (badge === \"Healthy\") {\n        var stateName = (req.StateName || \"\").toLowerCase();\n        if (stateName === \"posted\" &&\n            avgAppsPerDay < LOW_VOLUME_APPS_PER_DAY) {\n\n            badge = \"Low Volume\";\n            badgeReason.push(\"Posted but AvgAppsPerDay \" +\n                (Math.round(avgAppsPerDay * 100) / 100) +\n                \" < \" + LOW_VOLUME_APPS_PER_DAY + \".\");\n        }\n    }\n\n\n    var health = 0.85;\n    if (badge === \"Stagnant\") health = 0.15;\n    else if (badge === \"Skill Gap\") health = 0.25;\n    else if (badge === \"Low Volume\") health = 0.35;\n\n    var volAdj = 0;\n    if (avgAppsPerDay < VOL_ADJ_THRESHOLD_1) volAdj = -0.05;\n    if (avgAppsPerDay < VOL_ADJ_THRESHOLD_2) volAdj = -0.10;\n\n    health = health + volAdj;\n    if (health < 0) health = 0;\n    if (health > 1) health = 1;\n\n    analyzedReqs.push({\n        RequisitionId: req.RequisitionId,\n        RequisitionNumber: req.RequisitionNumber,\n        Title: req.Title,\n        StateName: req.StateName,\n        PrimaryLocationName: req.PrimaryLocationName,\n        JobApplicationCount: jaCount,\n        NewJobApplicationCount: newJACount,\n        ApplicantCount: applicantCount,\n        AvgAppsPerDay: avgAppsPerDay,\n        AvgSkillScore: avgSkillScore,\n        DaysSinceLastActivity: daysSinceLastActivity,\n        PostingDate: postedStr,\n        ExternalPublishedJobStartDate: req.ExternalPublishedJobStartDate || req.ExternalPublishJobStartDate,\n        InternalPublishedJobStartDate: req.InternalPublishedJobStartDate || req.InternalPublishJobStartDate,\n        CreationDate: req.CreationDate,\n        Badge: badge,\n        BadgeReason: badgeReason,\n        ComputedHealth: health,\n\n        // For recency selection only (does not affect scoring/badges)\n        PostedMs: (postedMs != null ? postedMs : 0)\n    });\n}\n\n// Attention only (unchanged logic)\nvar attention = [];\nfor (i = 0; i < analyzedReqs.length; i++) {\n    if (analyzedReqs[i] && analyzedReqs[i].Badge !== \"Healthy\") {\n        attention.push(analyzedReqs[i]);\n    }\n}\n\n// ===============================\n// Return TOP 6 MOST RECENT from attention\n// WITHOUT using 'function'\n// ===============================\n\nvar picked = [];\nvar usedIds = {};\nvar count = 0;\n\nwhile (count < MAX_RESULTS) {\n\n    var bestIndex = -1;\n    var bestPostedMs = -1;\n\n    for (i = 0; i < attention.length; i++) {\n        var r = attention[i];\n        if (!r) continue;\n\n        var rid = r.RequisitionId;\n        if (rid && usedIds[rid]) continue;\n\n        var ms = 0;\n        var sortDate = r.PostingDate || r.ExternalPublishedJobStartDate || r.InternalPublishedJobStartDate || r.CreationDate;\n        if (sortDate) {\n            var dt = new Date(sortDate);\n            if (!isNaN(dt.getTime())) {\n                ms = dt.getTime();\n            }\n        }\n\n        if (ms > bestPostedMs) {\n            bestPostedMs = ms;\n            bestIndex = i;\n        }\n    }\n\n    if (bestIndex === -1) break;\n\n    var chosen = attention[bestIndex];\n    picked.push(chosen);\n\n    if (chosen && chosen.RequisitionId) {\n        usedIds[chosen.RequisitionId] = true;\n    } else {\n        usedIds[\"idx_\" + bestIndex + \"_\" + count] = true;\n    }\n\n    count++;\n}\n\npicked;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "ANALYSE_REQ_RESULTS",
          "convergenceTargetId": "1765508855410",
