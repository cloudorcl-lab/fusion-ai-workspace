          "metadata": {
            "name": "GetReqIds",
            "returnType": "object",
            "sourceCode": "const response = $context.$nodes.GET_REQUISITIONS.$output;\nconst requisitionIds = $context.$triggers.REST.$input.RequisitionIds;\n\n// If requisitionIds is provided and non-empty, filter to include ONLY these ids\nlet filteredItems = response.result.items;\nif (requisitionIds && Array.isArray(requisitionIds) && requisitionIds.length > 0) {\n  filteredItems = filteredItems.filter(item => requisitionIds.includes(item.RequisitionId));\n}\n\n// Build the result array\nconst results = filteredItems.map(item => ({\n  RequisitionId: item.RequisitionId,\n  RequisitionNumber: item.RequisitionNumber,\n  HiredCount: item.HiredCount,\n  JobApplicationCount: item.JobApplicationCount,\n  NewJobApplicationCount: item.NewJobApplicationCount,\n  ProspectCount: item.ProspectCount,\n  PrimaryLocationName: item.PrimaryLocationName\n}));\nreturn results;"
          },
          "outcomes": {
            "success": "1769754229134"
          },
