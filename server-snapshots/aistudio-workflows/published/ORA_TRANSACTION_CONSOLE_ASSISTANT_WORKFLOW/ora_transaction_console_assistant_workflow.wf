{
  "workflowId": "300000331068169",
  "workflowCode": "ORA_TRANSACTION_CONSOLE_ASSISTANT_WORKFLOW",
  "name": "Transaction console Assistant Workflow",
  "description": "Transaction console Assistant Workflow",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
