                {
                  "metadata": {
                    "businessObjectCode": "ORA_SCM_MANUFACTUR_KSEKANBANCANDDETAILSBYKANBANIDBO",
                    "functionName": "get_kanbanCards",
                    "processJson": true,
                    "name": "Get Kanban Card Details By Id"
                  },
                  "outcomes": {
                    "success": "1767595273557"
                  },
                  "code": "GET_KANBAN_CARD_DETAILS_BY_ID",
                  "id": "1767594808581",
                  "inputs": [
                    {
                      "id": "1767594826166_1",
                      "name": "kanbanCards_Id",
                      "type": "string",
                      "value": "{{$context.$nodes.ITERATE_KANBAN_CARD_ACTIVITIES.$currentItem.KanbanCardId}}"
                    }
                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "Filter based on lead time",
                    "returnType": "object",
                    "sourceCode": "let queryEnabled = $context.$nodes.CONTEXT_INDENTIFYING_AGENT?.$output?.context ? true : false;\nlet validActivity = true;\n\nif(queryEnabled){\nlet context  = $context.$nodes.CONTEXT_INDENTIFYING_AGENT.$output.context;\nlet subInventoryCodeCheck =$context.$nodes.CONTEXT_INDENTIFYING_AGENT.$output.point_of_use.subinventory.length !== 0;\nlet locatorCheck =  $context.$nodes.CONTEXT_INDENTIFYING_AGENT.$output.point_of_use.locator.length !== 0;\nlet subInventoryCodeCheckValue =$context.$nodes.CONTEXT_INDENTIFYING_AGENT.$output.point_of_use.subinventory[0];\nlet locatorCheckValue =  $context.$nodes.CONTEXT_INDENTIFYING_AGENT.$output.point_of_use.locator[0];\nlet kanbanSubInventoryCodeValue = $context.$nodes.ITERATE_KANBAN_CARD_ACTIVITIES.GET_KANBAN_CARD_DETAILS_BY_ID.$output.SubinventoryCode;\nlet kanbanLocatorValue = $context.$nodes.ITERATE_KANBAN_CARD_ACTIVITIES.GET_KANBAN_CARD_DETAILS_BY_ID.$output.Locator; \nlet itemValue =  $context.$nodes.CONTEXT_INDENTIFYING_AGENT.$output.items[0];\nlet supplierName = $context.$nodes.CONTEXT_INDENTIFYING_AGENT.$output.suppliers[0];\nlet kanbanItemValue = $context.$nodes.ITERATE_KANBAN_CARD_ACTIVITIES.GET_KANBAN_CARD_DETAILS_BY_ID.$output.ItemNumber;\nlet kanbanSupplierName = $context.$nodes.ITERATE_KANBAN_CARD_ACTIVITIES.GET_KANBAN_CARD_DETAILS_BY_ID.$output.SupplierName;\nvalidActivity = false;\n \nif(context == \"ITEM\" && itemValue == kanbanItemValue)\n validActivity = true;\n\nif(context==\"NOTHING\")\n  validActivity=true;\nif(context == \"POINT_OF_USE\" && subInventoryCodeCheck && locatorCheck)\n validActivity = (subInventoryCodeCheckValue == kanbanSubInventoryCodeValue) && (locatorCheckValue == kanbanLocatorValue) ? true : false;\n\n\nelse if(context == \"POINT_OF_USE\"  && subInventoryCodeCheck && subInventoryCodeCheckValue == kanbanSubInventoryCodeValue)\n validActivity = true;\n\nelse if(context == \"SUPPLIER\" && supplierName ==  kanbanSupplierName)\nvalidActivity = true;\n\n}\n\nif(!validActivity){\nreturn {}\n}\n\n\nlet answer={};\nconst activities = $context.$nodes.ITERATE_KANBAN_CARD_ACTIVITIES.$currentItem.Activities || [];\nconst thresholdRaw = parseFloat($context.$nodes.CONTEXT_INDENTIFYING_AGENT?.$output?.threshold);\nconst threshold = Number.isFinite(thresholdRaw) ? thresholdRaw : 2;\nconst toleranceMultiplier = 1 + (threshold / 100);\nconst card = $context.$nodes.ITERATE_KANBAN_CARD_ACTIVITIES.GET_KANBAN_CARD_DETAILS_BY_ID.$output;\n\n//const pullSeq = $context.$nodes.ITERATE_KANBAN_CARD_ACTIVITIES.GET_PULL_SEQUENCE_DETAILS_BY_ID.$output;\n\nconst cardId = card.KanbanCardId;\nconst cycleId = card.CurrentReplenishmentCycleId;\n\nconst relevantActivities = activities;\n\n\nlet latestInProcessTime = null;\nlet latestFullTime = null;\nlet replenishLeadTime;\nfor (const a of relevantActivities) {\n  const t = new Date(a.TIMEUPDATED);\n  replenishLeadTime = Number(a.REPLENISHMENTLEADTIME)??0;\n  if (a.TOSUPPLYSTATUS == 5) {\n    if (!latestInProcessTime || t > latestInProcessTime) {\n      latestInProcessTime = t;\n    }\n  }\n\n  if (a.TOSUPPLYSTATUS == 2) {\n    if (!latestFullTime || t > latestFullTime) {\n      latestFullTime = t;\n    }\n  }\n}\n\nif (!latestInProcessTime || !latestFullTime) {\nreturn answer;\n}\n\n// Card is still in process → ignore\nif (latestInProcessTime > latestFullTime) {\nreturn answer;\n}\n\nconst actualTimeInMs =\n  latestFullTime - latestInProcessTime;\n\n\nconst allowedTimeInMs =\ntoleranceMultiplier * replenishLeadTime * 24 * 60 * 60 * 1000;\nconst pullSequenceId = activities?.[0]?.PULLSEQUENCEID ?? card.PullSequenceId ?? null;\n\n\n\nif (actualTimeInMs <= allowedTimeInMs) {\n  return answer;\n}\n\nanswer= {\n  SupplierId: card.SupplierId,\n  SupplierName: card.SupplierName,\n  SupplierSiteId: card.SupplierSiteId,\n  SupplierSiteName: card.SupplierSiteName,\n  PullSequenceId: pullSequenceId,\n  KanbanCardId: cardId,\n  ReplenishmentCycleId: cycleId,\n  InProcessTime: latestInProcessTime,\n  FullTime: latestFullTime,\n  ActualSupplierProcessingTimeInMs: actualTimeInMs,\n  AllowedTimeInMs: allowedTimeInMs,\nItemNumber: card.ItemNumber,\n  BreachPercent:\n    ((actualTimeInMs - allowedTimeInMs) / allowedTimeInMs) * 100,\n  SLA_Breached: true\n};\n\nreturn answer;"
                  },
                  "outcomes": {
                    "success": "end_1767594731569"
                  },
                  "code": "FILTER_BASED_ON_LEAD_TIME",
                  "id": "1767595273557",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                }
              ],
              "rootNode": "start_1767594731569"
            },
            "loopType": "PARALLEL",
            "name": "Iterate Kanban Card Activities"
          },
          "outcomes": {
            "success": "1777267978558"
          },
          "code": "ITERATE_KANBAN_CARD_ACTIVITIES",
          "id": "1767594731569",
          "inputs": [
            {
              "id": "1767594731570_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.GROUP_BY_KANBAN_CARD_ID.$output.result}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "Group by Kanban Card Id",
            "returnType": "array",
            "sourceCode": "const activities =\n  $context.$nodes.GET_FILTERED_KANBAN_CARD_ACTIVITIES.$output || [];\n\n// Temporary map for grouping\nconst tempMap = {};\n\n// Group by KanbanCardId\nfor (const a of activities) {\n  const cardId = a.KANBANCARDID;\n\n  if (!tempMap[cardId]) {\n    tempMap[cardId] = [];\n  }\n\n  tempMap[cardId].push(a);\n}\n\n// Convert map → array of objects\nconst activitiesByKanbanCard = Object.keys(tempMap).map(cardId => ({\n  KanbanCardId: Number(cardId),\n  Activities: tempMap[cardId]\n}));\n\nreturn activitiesByKanbanCard;"
          },
          "outcomes": {
            "success": "1767594731569"
          },
          "code": "GROUP_BY_KANBAN_CARD_ID",
          "id": "1767606063004",
          "inputs": [],
