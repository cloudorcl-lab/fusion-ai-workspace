          "code": "DAYS_CODE",
          "convergenceTargetId": "1767594030519",
          "id": "1775719396717",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "PREPARE_TOP5_SUPPLIERS",
            "returnType": "array",
            "sourceCode": "const arr = $context.$nodes.ITERATE_KANBAN_CARD_ACTIVITIES.$output || [];\n\nfunction normalize(row) {\n  try {\n    const parsed = typeof row === \"string\" ? JSON.parse(row) : row;\n    return parsed && parsed.result !== undefined ? parsed.result : parsed;\n  } catch (e) {\n    return null;\n  }\n}\n\nconst records = arr\n  .map(normalize)\n  .filter(r => r && typeof r === \"object\" && !Array.isArray(r) && Object.keys(r).length > 0)\n  .filter(r => r.SLA_Breached === true && !!r.SupplierName);\n\nif (records.length === 0) return [];\n\n// rank suppliers once (shared source of truth for both display and comm)\nconst supplierMax = {};\nfor (const r of records) {\n  const supplier = r.SupplierName;\n  const breach = Number(r.BreachPercent) || 0;\n  if (!supplierMax[supplier] || breach > supplierMax[supplier]) {\n    supplierMax[supplier] = breach;\n  }\n}\n\nconst topSuppliers = Object.entries(supplierMax)\n  .sort((a, b) => b[1] - a[1])\n  .slice(0, 5)\n  .map(x => x[0]);\n\nconst topSet = new Set(topSuppliers);\n\n// return only rows belonging to the exact same top-5 suppliers\nreturn records.filter(r => topSet.has(r.SupplierName));\n"
          },
          "outcomes": {
            "success": "1767680359678"
          },
          "code": "PREPARETOP5SUPPLIERS",
          "id": "1777267978558",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
