    status: BATCH_STATUSES.CLARIFY,\n      reason: 'Which credit categories should the new measure use?',\n    };\n  }\n  return {\n    ok: true,\n    value: out,\n  };\n}\n\nfunction expressionTextFromMeasurePayload(payload) {\n  return trimString(\n    hasOwn(payload, 'formulaExpressionText')\n      ? payload.formulaExpressionText\n      : payload.expressionText\n  );\n}\n\nfunction validateRequiredCatalogField(field, rawPayload, measure, catalogContext) {\n  if (!hasOwn(rawPayload, field)) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.CLARIFY,\n      reason: 'What value should I use for ' + field + ' on the new measure?',\n    };\n  }\n  const normalized = validateCatalogField(field, rawPayload[field], catalogContext);\n  if (!normalized.ok) {\n    return normalized;\n  }\n  measure[field] = normalized.value;\n  return { ok: true };\n}\n\nfunction validateAddMeasurePayload(payload, component, catalogContext) {\n  const rawPayload = payload && typeof payload === 'object' && !Array.isArray(payload) ? payload : {};\n  const keyValidation = validateAddMeasureFlatPayloadKeys(rawPayload);\n  if (!keyValidation.ok) {\n    return keyValidation;\n  }\n\n  const nameInfo = firstPresentString(rawPayload, ['measureName']);\n  const measureName = nameInfo ? nameInfo.value : '';\n  if (!measureName) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.CLARIFY,\n      reason: 'What should I call the new measure?',\n    };\n  }\n  if (duplicateMeasureName(component, measureName)) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.CLARIFY,\n      reason: 'A measure named ' + measureName + ' already exists under ' + (component.componentName || 'that component') + '. Should I update that measure or use a different name?',\n    };\n  }\n\n  const measure = {\n    measureName,\n  };\n  const reviewFields = validateCommonConstructorReviewFields(rawPayload, measure, 'measure');\n  if (!reviewFields.ok) {\n    return reviewFields;\n  }\n  if (reviewFields.isPlaceholder) {\n    const requiredCatalogFields = ['unitOfMeasure', 'processTransaction', 'performanceInterval'];\n    for (let idx = 0; idx < requiredCatalogFields.length; idx += 1) {\n      const optional = validateOptionalCatalogField(requiredCatalogFields[idx], rawPayload, measure, catalogContext);\n      if (!optional.ok) {\n        return optional;\n      }\n    }\n    const optionalSplitOption = validateOptionalCatalogField('splitOption', rawPayload, measure, catalogContext);\n    if (!optionalSplitOption.ok) {\n      return optionalSplitOption;\n    }\n    const optionalRunningTotal = validateOptionalBooleanField('runningTotalFlag', rawPayload, measure);\n    if (!optionalRunningTotal.ok) {\n      return optionalRunningTotal;\n    }\n    const creditCategories = validateOptionalCreditCategories(rawPayload, measure, catalogContext);\n    if (!creditCategories.ok) {\n      return creditCategories;\n    }\n    return {\n      ok: true,\n      measure,\n      formulaName: '',\n      formulaExpressionText: '',\n      isPlaceholder: true,\n    };\n  }\n\n  const setupFields = ['unitOfMeasure', 'processTransaction', 'performanceInterval'];\n  for (let idx = 0; idx < setupFields.length; idx += 1) {\n    const optional = validateOptionalCatalogField(setupFields[idx], rawPayload, measure, catalogContext);\n    if (!optional.ok) {\n      return optional;\n    }\n  }\n  const defaultInterval = applyCatalogDefault('performanceInterval', 'Period', measure, catalogContext);\n  if (!defaultInterval.ok) {\n    return defaultInterval;\n  }\n  const optionalSplitOption = validateOptionalCatalogField('splitOption', rawPayload, measure, catalogContext);\n  if (!optionalSplitOption.ok) {\n    return optionalSplitOption;\n  }\n  const defaultSplitOption = applyCatalogDefault('splitOption', 'NONE', measure, catalogContext);\n  if (!defaultSplitOption.ok) {\n    return defaultSplitOption;\n  }\n  const optionalRunningTotal = validateOptionalBooleanField('runningTotalFlag', rawPayload, measure);\n  if (!optionalRunningTotal.ok) {\n    return optionalRunningTotal;\n  }\n  if (!hasOwn(rawPayload, 'runningTotalFlag')) {\n    measure.runningTotalFlag = false;\n  }\n\n  if (hasOwn(rawPayload, 'creditCategories')) {\n    const creditCategories = normalizeCreditCategories(rawPayload.creditCategories, catalogContext);\n    if (!creditCategories.ok) {\n      return creditCategories;\n    }\n    measure.creditCategories = creditCategories.value;\n  } else {\n    measure.creditCategories = [];\n  }\n\n  const formulaExpressionText = expressionTextFromMeasurePayload(rawPayload);\n  if (!formulaExpressionText) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.CLARIFY,\n      reason: 'What formula should calculate ' + measureName + '?',\n    };\n  }\n\n  return {\n    ok: true,\n    measure,\n    formulaName: trimString(rawPayload.formulaName) || measureName + ' Formula',\n    formulaExpressionText,\n  };\n}\n\nfunction normalizeBoolean(value, field) {\n  if (value === true || value === false) {\n    return {\n      ok: true,\n      value,\n    };\n  }\n  const normalized = trimString(value).toLowerCase();\n  if (normalized === 'true' || normalized === 'yes' || normalized === '1') {\n    return {\n      ok: true,\n      value: true,\n    };\n  }\n  if (normalized === 'false' || normalized === 'no' || normalized === '0') {\n    return {\n      ok: true,\n      value: false,\n    };\n  }\n  return {\n    ok: false,\n    status: BATCH_STATUSES.CLARIFY,\n    reason: 'Use true or false for ' + field + '.',\n  };\n}\n\nfunction validateAddScorecardFlatPayloadKeys(payload) {\n  const keys = Object.keys(payload || {});\n  for (let idx = 0; idx < keys.length; idx += 1) {\n    const key = keys[idx];\n    if (ADD_SCORECARD_FORBIDDEN_PAYLOAD_FIELDS.indexOf(key) !== -1) {\n      return {\n        ok: false,\n        status: BATCH_STATUSES.BLOCKED,\n        reason: 'ADD_SCORECARD payload must not include ' + key + '.',\n      };\n    }\n    if (ADD_SCORECARD_ALLOWED_PAYLOAD_FIELDS.indexOf(key) === -1) {\n      return {\n        ok: false,\n        status: BATCH_STATUSES.BLOCKED,\n        reason: 'Unsupported scorecard field \"' + key + '\".',\n      };\n    }\n  }\n  return { ok: true };\n}\n\nfunction validateAddRateTableFlatPayloadKeys(payload) {\n  const keys = Object.keys(payload || {});\n  for (let idx = 0; idx < keys.length; idx += 1) {\n    const key = keys[idx];\n    if (ADD_RATE_TABLE_FORBIDDEN_PAYLOAD_FIELDS.indexOf(key) !== -1) {\n      return {\n        ok: false,\n        status: BATCH_STATUSES.BLOCKED,\n        reason: 'ADD_RATE_TABLE payload must not include ' + key + '.',\n      };\n    }\n    if (ADD_RATE_TABLE_ALLOWED_PAYLOAD_FIELDS.indexOf(key) === -1) {\n      return {\n        ok: false,\n        status: BATCH_STATUSES.BLOCKED,\n        reason: 'Unsupported rate table field \"' + key + '\".',\n      };\n    }\n  }\n  return { ok: true };\n}\n\nfunction normalizePayoutDimension(rawDimension, index, catalogContext, ownerLabel) {\n  const label = ownerLabel || 'payout model';\n  const displayLabel = label.charAt(0).toUpperCase() + label.slice(1);\n  if (!rawDimension || typeof rawDimension !== 'object' || Array.isArray(rawDimension)) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.CLARIFY,\n      reason: 'Each ' + label + ' dimension must include a name, values, and input expression.',\n    };\n  }\n  const dimensionName = trimString(rawDimension.dimensionName || rawDimension.name);\n  if (!dimensionName) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.CLARIFY,\n      reason: 'What should I call ' + label + ' dimension ' + String(index + 1) + '?',\n    };\n  }\n  if (!hasOwn(rawDimension, 'dimensionType')) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.CLARIFY,\n      reason: 'What dimension type should I use for ' + label + ' dimension ' + dimensionName + '?',\n    };\n  }\n  const dimensionType = validateCatalogField('dimensionType', rawD