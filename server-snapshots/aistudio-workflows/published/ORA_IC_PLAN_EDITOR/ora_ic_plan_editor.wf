validateAddRateTablePayload(payload, component, catalogContext) {\n  const rawPayload = payload && typeof payload === 'object' && !Array.isArray(payload) ? payload : {};\n  const keyValidation = validateAddRateTableFlatPayloadKeys(rawPayload);\n  if (!keyValidation.ok) {\n    return keyValidation;\n  }\n  const nameInfo = firstPresentString(rawPayload, ['rateTableName']);\n  const rateTableName = nameInfo ? nameInfo.value : '';\n  if (!rateTableName) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.CLARIFY,\n      reason: 'What should I call the new rate table?',\n    };\n  }\n  const rateTable = {\n    rateTableName,\n  };\n  const reviewFields = validateCommonConstructorReviewFields(rawPayload, rateTable, 'rate table');\n  if (!reviewFields.ok) {\n    return reviewFields;\n  }\n  if (reviewFields.isPlaceholder) {\n    if (rawPayload.updateFormulaToRtr === true) {\n      return {\n        ok: false,\n        status: BATCH_STATUSES.BLOCKED,\n        reason: 'Placeholder rate tables cannot be wired into formula behavior.',\n      };\n    }\n    const optionalType = validateOptionalCatalogField('rateTableType', rawPayload, rateTable, catalogContext);\n    if (!optionalType.ok) {\n      return optionalType;\n    }\n    rateTable.dimensions = [];\n    rateTable.rateValues = [];\n    return {\n      ok: true,\n      rateTable,\n      updateFormulaToRtr: false,\n      isPlaceholder: true,\n    };\n  }\n  if (!hasOwn(rawPayload, 'rateTableType')) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.CLARIFY,\n      reason: 'What rate table type should I use for ' + rateTableName + '?',\n    };\n  }\n  const rateTableType = validateCatalogField('rateTableType', rawPayload.rateTableType, catalogContext);\n  if (!rateTableType.ok) {\n    return rateTableType;\n  }\n  const dimensions = normalizeRateTableDimensions(rawPayload.dimensions, catalogContext);\n  if (!dimensions.ok) {\n    return dimensions;\n  }\n  const rateValues = validateRateTableRateVa