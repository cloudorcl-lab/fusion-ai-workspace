        {
          "id": "30",
          "code": "PREPARE_PRECHECK_PLAN",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Precheck Plan",
            "returnType": "string",
            "sourceCode": "// PREPARE_PRECHECK_PLAN - Extract the updated plan payload for the shared precheck workflow.\n\nvar responseRaw = $context.$nodes.APPLY_RESPONSE_COMPOSER_OUTPUT\n  ? $context.$nodes.APPLY_RESPONSE_COMPOSER_OUTPUT.$output.result\n  : ($context.$nodes.APPLY_PLAN_EDITS ? $context.$nodes.APPLY_PLAN_EDITS.$output.result : null);\n\nvar parseMaybeJson = function(value) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n  if (typeof value !== 'string') {\n    return value;\n  }\n  try {\n    return JSON.parse(value);\n  } catch (_err) {\n    return null;\n  }\n};\n\nvar response = parseMaybeJson(responseRaw);\nif (!response || typeof response !== 'object' || !response.updatedPlan) {\n  return '';\n}\n\nreturn JSON.stringify(response.updatedPlan);"
          },
