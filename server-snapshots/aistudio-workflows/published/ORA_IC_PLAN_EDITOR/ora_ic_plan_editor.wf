'description')) {\n    dimension.description = rawDimension.description === null ? null : String(rawDimension.description);\n  }\n  if (hasOwn(rawDimension, 'splitFlag')) {\n    const splitFlag = normalizeBoolean(rawDimension.splitFlag, 'splitFlag');\n    if (!splitFlag.ok) {\n      return splitFlag;\n    }\n    dimension.splitFlag = splitFlag.value;\n  }\n  if (hasOwn(rawDimension, 'accumulateFlag')) {\n    const accumulateFlag = normalizeBoolean(rawDimension.accumulateFlag, 'accumulateFlag');\n    if (!accumulateFlag.ok) {\n      return accumulateFlag;\n    }\n    dimension.accumulateFlag = accumulateFlag.value;\n  }\n  return {\n    ok: true,\n    dimension,\n  };\n}\n\nfunction normalizePayoutDimensions(rawDimensions, catalogContext, ownerLabel) {\n  const label = ownerLabel || 'payout model';\n  const displayLabel = label.charAt(0).toUpperCase() + label.slice(1);\n  const dimensions = Array.isArray(rawDimensions) ? rawDimensions : [];\n  if (dimensions.length === 0) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.CLARIFY,\n      reason: 'Which dimensions should the new ' + label + ' use?',\n    };\n  }\n  if (dimensions.length > 2) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.CLARIFY,\n      reason: displayLabel + 's support at most two dimensions.',\n    };\n  }\n  const out = [];\n  const seen = {};\n  for (let idx = 0; idx < dimensions.length; idx += 1) {\n    const normalized = normalizePayoutDimension(dimensions[idx], idx, catalogContext, label);\n    if (!normalized.ok) {\n      return normalized;\n    }\n    const key = textKey(normalized.dimension.dimensionName);\n    if (seen[key]) {\n      return {\n        ok: false,\n        status: BATCH_STATUSES.CLARIFY,\n        reason: displayLabel + ' dimension names must be unique.',\n      };\n    }\n    seen[key] = true;\n    out.push(normalized.dimension);\n  }\n  return {\n    ok: true,\n    dimensions: out,\n  };\n}\n\nfunction validatePayoutRateValues(rawRateValues, dimensions, valueField, label) {\n  const rows = Array.isArray(rawRateValues) ? rawRateValues : [];\n  if (rows.length === 0) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.CLARIFY,\n      reason: 'What rate rows should I add to the new ' + label + '?',\n    };\n  }\n  const out = [];\n  for (let rowIdx = 0; rowIdx < rows.length; rowIdx += 1) {\n    const row = rows[rowIdx] || {};\n    const coordinateArray = Array.isArray(row.coordinates) ? row.coordinates : null;\n    const coordinates = row.coordinates && typeof row.coordinates === 'object' && !Array.isArray(row.coordinates)\n      ? row.coordinates\n      : {};\n    const normalizedCoordinates = {};\n    for (let dimIdx = 0; dimIdx < dimensions.length; dimIdx += 1) {\n      const dimension = dimensions[dimIdx];\n      const coordinate = coordinateArray\n        ? trimString(coordinateArray[dimIdx])\n        : trimString(coordinates[dimension.dimensionName]);\n      if (!coordinate) {\n        return {\n          ok: false,\n          status: BATCH_STATUSES.CLARIFY,\n          reason: 'Rate row ' + String(rowIdx + 1) + ' is missing a coordinate for ' + dimension.dimensionName + '.',\n        };\n      }\n      const allowed = dimension.values || [];\n      if (allowed.indexOf(coordinate) === -1) {\n        return {\n          ok: false,\n          status: BATCH_STATUSES.CLARIFY,\n          reason: 'Rate row ' + String(rowIdx + 1) + ' uses \"' + coordinate + '\" outside the values for ' + dimension.dimensionName + '.',\n        };\n      }\n      normalizedCoordinates[dimension.dimensionName] = coordinate;\n    }\n    const hasValueField = hasOwn(row, valueField);\n    const hasLegacyScore = valueField === 'rate' && hasOwn(row, 'score');\n    if (!hasValueField && !hasLegacyScore) {\n      return {\n        ok: false,\n        status: BATCH_STATUSES.CLARIFY,\n        reason: 'What rate should I use for rate row ' + String(rowIdx + 1) + '?',\n      };\n    }\n    const numericValue = Number(hasValueField ? row[valueField] : row.score);\n    const legacyScoreValue = hasLegacyScore ? Number(row.score) : null;\n    if (!Number.isFinite(numericValue) || (hasLegacyScore && !Number.isFinite(legacyScoreValue))) {\n      return {\n        ok: false,\n        status: BATCH_STATUSES.CLARIFY,\n        reason: 'Use a numeric rate for rate row ' + String(rowIdx + 1) + '.',\n      };\n    }\n    if (hasValueField && hasLegacyScore && numericValue !== legacyScoreValue) {\n      return {\n        ok: false,\n        status: BATCH_STATUSES.BLOCKED,\n        reason: 'Rate row ' + String(rowIdx + 1) + ' cannot specify conflicting rate and score values.',\n      };\n    }\n    const normalizedRow = {\n      ...clone(row),\n      coordinates: normalizedCoordinates,\n      [valueField]: numericValue,\n    };\n    delete normalizedRow.score;\n    out.push(normalizedRow);\n  }\n  return {\n    ok: true,\n    rateValues: out,\n  };\n}\n\nfunction normalizeScorecardDimensions(rawDimensions, catalogContext) {\n  return normalizePayoutDimensions(rawDimensions, catalogContext, 'scorecard');\n}\n\nfunction normalizeRateTableDimensions(rawDimensions, catalogContext) {\n  return normalizePayoutDimensions(rawDimensions, catalogContext, 'rate table');\n}\n\nfunction validateScorecardRateValues(rawRateValues, dimensions) {\n  return validatePayoutRateValues(rawRateValues, dimensions, 'rate', 'scorecard');\n}\n\nfunction validateRateTableRateValues(rawRateValues, dimensions) {\n  return validatePayoutRateValues(rawRateValues, dimensions, 'rate', 'rate table');\n}\n\nfunction validateAddScorecardPayload(payload, measure, catalogContext) {\n  const rawPayload = payload && typeof payload === 'object' && !Array.isArray(payload) ? payload : {};\n  const keyValidation = validateAddScorecardFlatPayloadKeys(rawPayload);\n  if (!keyValidation.ok) {\n    return keyValidation;\n  }\n  const nameInfo = firstPresentString(rawPayload, ['scorecardName', 'rateTableName']);\n  const scorecardName = nameInfo ? name