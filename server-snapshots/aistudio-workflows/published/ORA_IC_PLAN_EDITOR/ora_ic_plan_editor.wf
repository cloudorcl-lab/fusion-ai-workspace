ncemeasure') {\n    return OPERATION_KINDS.ADD_MEASURE;\n  }\n  if (lowered === 'addscorecard' || lowered === 'scorecardcreate' || lowered === 'createscorecard') {\n    return OPERATION_KINDS.ADD_SCORECARD;\n  }\n  if (lowered === 'addratetable' || lowered === 'ratetablecreate' || lowered === 'createratetable' || lowered === 'addpayoutschedule' || lowered === 'payoutschedulecreate') {\n    return OPERATION_KINDS.ADD_RATE_TABLE;\n  }\n  if (lowered === 'removecomponent' || lowered === 'deletecomponent' || lowered === 'dropcomponent') {\n    return OPERATION_KINDS.REMOVE_COMPONENT;\n  }\n  if (lowered === 'removemeasure' || lowered === 'deletemeasure' || lowered === 'dropmeasure' || lowered === 'removeperformancemeasure' || lowered === 'deleteperformancemeasure') {\n    return OPERATION_KINDS.REMOVE_MEASURE;\n  }\n  if (lowered === 'removescorecard' || lowered === 'deletescorecard' || lowered === 'dropscorecard') {\n    return OPERATION_KINDS.REMOVE_SCORECARD;\n  }\n  if (lowered === 'removeratetable' || lowered === 'deleteratetable' || lowered === 'dropratetable' || lowered === 'removepayoutschedule' || lowered === 'deletepayoutschedule') {\n    return OPERATION_KINDS.REMOVE_RATE_TABLE;\n  }\n  if (lowered === 'formulacomposite' || lowered === 'compositeformula') return OPERATION_KINDS.FORMULA_COMPOSITE;\n  if (lowered === 'tabularcomposite' || lowered === 'compositetabular') return OPERATION_KINDS.TABULAR_COMPOSITE;\n  if (\n    lowered === 'horizontalcomposite' ||\n    lowered === 'compositehorizontal' ||\n    lowered === 'horizontalexistingentity' ||\n    lowered === 'existingentitycomposite' ||\n    lowered === 'existingentityedit'\n  ) return OPERATION_KINDS.HORIZONTAL_COMPOSITE;\n  if (lowered === 'renameentity') return OPERATION_KINDS.RENAME_ENTITY;\n  if (lowered === 'updateplanfield' || lowered === 'updatecomponentfield' || lowered === 'updatemeasurefield') {\n    return OPERATION_KINDS.SCALAR_FIELD_UPDATE;\n  }\n  if (lowered === 'updateformulafield') return OPERATION_KINDS.FORMULA_FIELD_UPDATE;\n  if (lowered === 'updateformulaexpression') return OPERATION_KINDS.FORMULA_EXPRESSION_UPDATE;\n  if (lowered === 'updateratedimensiondefinition' || lowered === 'redefineratedimension') return OPERATION_KINDS.REDEFINE_RATE_DIMENSION;\n  if (lowered === 'updateratedimensioninputexpression') return OPERATION_KINDS.RATE_DIMENSION_INPUT_EXPRESSION_UPDATE;\n  if (lowered === 'updateratetablemetadata') return OPERATION_KINDS.RATE_TABLE_METADATA_UPDATE;\n  if (lowered === 'updateratedimensionmetadata') return OPERATION_KINDS.RATE_DIMENSION_METADATA_UPDATE;\n  if (lowered === 'updateratedimensionvalues') return OPERATION_KINDS.RATE_DIMENSION_VALUES_UPDATE;\n  if (lowered === 'updateratevalue') return OPERATION_KINDS.RATE_VALUE_UPDATE;\n  if (lowered === 'tabulartablereplacement' || lowered === 'fulltabularreplacement' || lowered === 'replacefulltable') return OPERATION_KINDS.TABULAR_TABLE_REPLACEMENT;\n  if (lowered === 'addcomponent' || lowered === 'addplancomponent') return OPERATION_KINDS.ADD_COMPONENT;\n  if (lowered === 'addmeasure' || lowered === 'addperformancemeasure') return OPERATION_KINDS.ADD_MEASURE;\n  if (lowered === 'addscorecard') return OPERATION_KINDS.ADD_SCORECARD;\n  if (lowered === 'addratetable' || lowered === 'addpayoutschedule') return OPERATION_KINDS.ADD_RATE_TABLE;\n  if (lowered === 'removecomponent' || lowered === 'deletecomponent') return OPERATION_KINDS.REMOVE_COMPONENT;\n  if (lowered === 'removemeasure' || lowered === 'deletemeasure' || lowered === 'deleteperformancemeasure') return OPERATION_KINDS.REMOVE_MEASURE;\n  if (lowered === 'removescorecard' || lowered === 'deletescorecard') return OPERATION_KINDS.REMOVE_SCORECARD;\n  if (lowered === 'removeratetable' || lowered === 'deleteratetable' || lowered === 'removepayoutschedule') return OPERATION_KINDS.REMOVE_RATE_TABLE;\n  return trimText(value);\n}\n\nfunction normalizeTargetRef(target) {\n  const raw = isPlainObject(target) ? target : {};\n  const localRef = trimText(raw.localRef || raw.localReference || '');\n  return {\n    refId: trimText(raw.refId || raw.targetRef || raw.ref || localRef),\n    localRef,\n    targetKind: normalizeTargetKind(raw.targetKind || raw.kind),\n    id: raw.id !== undefined && raw.id !== null && String(raw.id) !== '' ? String(raw.id) : null,\n    name: raw.name || raw.targetName || null,\n    owner: isPlainObject(raw.owner) ? clone(raw.owner) : {},\n  };\n}\n\nfunction normalizeStep(step) {\n  const raw = isPlainObject(step) ? step : {};\n  const payload = isPlainObject(raw.payload) ? clone(raw.payload) : {};\n  const value = hasOwn(raw, 'value')\n    ? raw.value\n    : (hasOwn(payload, 'value')\n      ? payload.value\n      : (hasOwn(raw, 'newName') ? raw.newName : payload.newName));\n  const normalized = {\n    id: trimText(raw.id || raw.stepId || raw.refId || ''),\n    operationKind: normalizeOperationKind(raw.operationKind || raw.kind || raw.operation),\n    mutationKind: trimText(raw.mutationKind || raw.mutation),\n    targetRef: trimText(raw.targetRef || raw.target || ''),\n    field: trimText(\n      raw.field ||\n      raw.collectionField ||\n      raw.planField ||\n      raw.componentField ||\n      raw.measureField ||\n      raw.formulaField ||\n      raw.rateTableField ||\n      raw.scorecardField ||\n      raw.dimensionField ||\n      payload.field\n    ),\n    value,\n    newName: hasOwn(raw, 'newName') ? trimText(raw.newName) : trimText(payload.newName),\n    expressionText: trimText(raw.expressionText || payload.expressionText),\n    editInstruction: trimText(raw.editInstruction || raw.transformationInstruction || payload.editInstruction),\n    entityName: trimText(raw.entityName || raw.componentName || raw.measureName || raw.scorecardName || raw.rateTableName || raw.name || ''),\n    localRef: trimText(raw.localRef || raw.localReference || ''),\n    payload,\n    responseFacts: isPlainObject(raw.responseFacts) ? clone(raw.responseFacts) : null,\n  };\n  FLAT_STEP_FACT_FIELDS.forEach((field) => {\n    if (hasOwn(raw, field)) {\n      normalized[field] = clone(raw[field]);\n    }\n  });\n  if (\n    normalized.operationKind !== OPERATION_KINDS.RENAME_ENTITY &&\n    normalized.operationKind !== OPERATION_KINDS.REDEFINE_RATE_DIMENSION &&\n    isNameField(normalized.field)\n  ) {\n    normalized.operationKind = OPERATION_KINDS.RENAME_ENTITY;\n    if (!normalized.newName) {\n      normalized.newName = trimText(value);\n    }\n  }\n  if (\n    !normalized.expressionText &&\n    (\n      normalized.operationKind === OPERATION_KINDS.FORMULA_EXPRESSION_UPDATE ||\n      normalized.operationKind === OPERATION_KINDS.RATE_DIMENSION_INPUT_EXPRESSION_UPDATE\n    )\n  ) {\n    normalized.expressionText = trimText(value);\n  }\n  return normalized;\n}\n\nfunction normalizeAllowedChange(change) {\n  if (typeof change === 'string') {\n    return {\n      operationKind: '',\n      targetRef: '',\n      fields: [change],\n    };\n  }\n  const raw = isPlainObject(change) ? change : {};\n  const fields = Array.isArray(raw.fields)\n    ? raw.fields.map((field) => trimText(field)).filter(Boolean)\n    : [trimText(raw.field)].filter(Boolean);\n  return {\n    operationKind: normalizeOperationKind(raw.operationKind || raw.kind || raw.operation),\n    targetRef: trimText(raw.targetRef || raw.target || ''),\n    fields,\n  };\n}\n\nfunction expandNameAuthorityRules(changes) {\n  const expanded = [];\n  const rows = Array.isArray(changes) ? changes : [];\n  for (let idx = 0; idx < rows.length; idx += 1) {\n    const change = rows[idx];\n    expanded.push(change);\n    if (!change || change.operationKind === OPERATION_KINDS.RENAME_ENTITY) {\n      continue;\n    }\n    const nameFields = (Array.isArray(change.fields) ? change.fields : []).filter(isNameField);\n    if (nameFields.length === 0) {\n      continue;\n    }\n    expanded.push({\n      ...change,\n      operationKind: OPERATION_KINDS.RENAME_ENTITY,\n      fields: nameFields,\n    });\n  }\n  return expanded;\n}\n\nfunction normalizeForbiddenChange(change) {\n  if (typeof change === 'string') {\n    return {\n      operationKind: '',\n      targetRef: '',\n      fields: [change],\n    };\n  }\n  return normalizeAllowedChange(change);\n}\n\nfunction findProhibitedContractKey(value, path) {\n  if (!value || typeof value !== 'object') {\n    return null;\n  }\n  if (Array.isArray(value)) {\n    for (let idx = 0; idx < value.length; idx += 1) {\n      const found = findProhibitedContractKey(value[idx], path.concat([String(idx)]));\n      if (found) {\n        return found;\n      }\n    }\n    return null;\n  }\n  const keys = Object.keys(value);\n  for (let idx = 0; idx < keys.length; idx += 1) {\n    const key = keys[idx];\n    if (PROHIBITED_CONTRACT_KEYS.indexOf(key) !== -1) {\n      return path.concat([key]).join('.');\n    }\n    const found = findProhibitedContractKey(value[key], path.concat([key]));\n    if (found) {\n      return found;\n    }\n  }\n  return null;\n}\n\nfunction buildResponseFacts(input) {\n  const facts = isPlainObject(input && input.responseFacts) ? clone(input.responseFacts) : {};\n  const responseFacts = {\n    request: input && input.request ? String(input.request) : '',\n    status: input && input.status ? String(input.status) : BATCH_STATUSES.BLOCKED,\n    target: facts.target || null,\n    groundedTargets: Array.isArray(facts.groundedTargets) ? facts.groundedTargets : [],\n    missingFacts: Array.isArray(facts.missingFacts) ? facts.missingFacts : [],\n    ambiguousFacts: Array.isArray(facts.ambiguousFacts) ? facts.ambiguousFacts : [],\n    conflictFacts: Array.isArray(facts.conflictFacts) ? facts.conflictFacts : [],\n    unsupportedCapabilities: Array.isArray(facts.unsupportedCapabilities) ? facts.unsupportedCapabilities : [],\n    nextAction: facts.nextAction || input && input.nextAction || '',\n    applied: input && input.applied === true,\n    reason: input && input.reason ? String(input.reason) : (facts.reason || ''),\n  };\n  if (isPlainObject(facts.pendingRecommendation)) {\n    responseFacts.pendingRecommendation = clone(facts.pendingRecommendation);\n  }\n  if (isPlainObject(facts.acceptedRecommendation)) {\n    responseFacts.acceptedRecommendation = clone(facts.acceptedRecommendation);\n  }\n  if (Array.isArray(facts.removalBlocks)) {\n    responseFacts.removalBlocks = clone(facts.removalBlocks);\n  }\n  if (Array.isArray(facts.blockingReferences)) {\n    responseFacts.blockingReferences = clone(facts.blockingReferences);\n  }\n  if (Array.isArray(facts.ownerFormulaLookupUsage)) {\n    responseFacts.ownerFormulaLookupUsage = clone(facts.ownerFormulaLookupUsage);\n  }\n  if (Array.isArray(facts.missingReplacementLogic)) {\n    responseFacts.missingReplacementLogic = clone(facts.missingReplacementLogic);\n  }\n  return responseFacts;\n}\n\nfunction responseFactsForBlockedBatch(responseFacts, blocked) {\n  const facts = isPlainObject(responseFacts) ? clone(responseFacts) : {};\n  const removalBlocks = [];\n  const rows = Array.isArray(blocked) ? blocked : [];\n  for (let idx = 0; idx < rows.length; idx += 1) {\n    const metadata = rows[idx] && rows[idx].metadata && typeof rows[idx].metadata === 'object'\n      ? rows[idx].metadata\n      : {};\n    if (Array.isArray(metadata.removalBlocks)) {\n      metadata.removalBlocks.forEach((block) => removalBlocks.push(clone(block)));\n    } else if (metadata.removalBlock) {\n      removalBlocks.push(clone(metadata.removalBlock));\n    }\n  }\n  if (removalBlocks.length === 0) {\n    return facts;\n  }\n\n  facts.removalBlocks = removalBlocks;\n  facts.blockingReferences = removalBlocks.reduce((acc, block) => (\n    acc.concat(Array.isArray(block.blockingReferences) ? block.blockingReferences : [])\n  ), []);\n  facts.ownerFormulaLookupUsage = removalBlocks.reduce((acc, block) => (\n    acc.concat(Array.isArray(block.ownerFormulaLookupUsage) ? block.ownerFormulaLookupUsage : [])\n  ), []);\n  facts.missingReplacementLogic = removalBlocks\n    .map((block) => block && block.missingReplacementLogic)\n    .filter(Boolean);\n  return facts;\n}\n\nfunction composerMetadata(input) {\n  return {\n    responseComposerRequired: true,\n    responseComposerFacts: buildResponseFacts(input),\n  };\n}\n\nfunction contractFailure(reason, responseFacts) {\n  const userReason = 'No plan change was applied because I could not safely classify the requested edit.';\n  return makeBatchResult({\n    status: BATCH_STATUSES.BLOCKED,\n    operation: 'EDIT',\n    reply: userReason,\n    blocked: [{ reason: userReason }],\n    metadata: composerMetadata({\n      status: BATCH_STATUSES.BLOCKED,\n      reason: userReason,\n      responseFacts,\n      nextAction: 'Review the requested edit and try again with the latest plan context.',\n      internalReason: reason,\n    }),\n  });\n}\n\nfunction resolveTarget(planIndex, targetRef) {\n  const target = normalizeTargetRef(targetRef);\n  if (!target.targetKind) {\n    return {\n      status: BATCH_STATUSES.BLOCKED,\n      reason: 'The edit brief omitted a target kind.',\n      target,\n    };\n  }\n  const resolved = resolveIndexedTarget(planIndex, target);\n  if (resolved.status !== 'RESOLVED') {\n    return {\n      status: resolved.status === 'CLARIFY' ? BATCH_STATUSES.CLARIFY : BATCH_STATUSES.BLOCKED,\n      reason: resolved.reason,\n      target,\n    };\n  }\n  const entry = resolved.entry || {};\n  if (entry.id) {\n    if (!target.id) {\n      return {\n        status: BATCH_STATUSES.BLOCKED,\n        reason: 'The edit target must include the stable ID for the requested ' + target.targetKind + '.',\n        target,\n      };\n    }\n    if (String(entry.id) !== String(target.id)) {\n      return {\n        status: BATCH_STATUSES.BLOCKED,\n        reason: 'The edit target stable ID does not match the current plan target.',\n        target,\n      };\n    }\n  } else {\n    return {\n      status: BATCH_STATUSES.BLOCKED,\n      reason: 'The current plan target does not expose a stable ID; name-only edit authority is not allowed.',\n      target,\n    };\n  }\n  return {\n    status: BATCH_STATUSES.APPLIED,\n    target,\n    entry,\n  };\n}\n\nfunction normalizeBrief(rawBrief) {\n  const brief = isPlainObject(rawBrief) ? rawBrief : {};\n  const targets = Array.isArray(brief.targets)\n    ? brief.targets.map(normalizeTargetRef)\n    : [];\n  const orderedSteps = Array.isArray(brief.orderedSteps)\n    ? brief.orderedSteps.map((step) => normalizeStep(step))\n    : [];\n  const allowedChanges = Array.isArray(brief.allowedChanges)\n    ? expandNameAuthorityRules(brief.allowedChanges.map(normalizeAllowedChange))\n    : [];\n  const forbiddenChanges = Array.isArray(brief.forbiddenChanges)\n    ? expandNameAuthorityRules(brief.forbiddenChanges.map(normalizeForbiddenChange))\n    : [];\n  return {\n    route: normalizeRoute(brief.route || brief.executionRoute),\n    operationKind: normalizeOperationKind(brief.operationKind || brief.kind),\n    targets,\n    dependencyRefs: Array.isArray(brief.dependencyRefs)\n      ? brief.dependencyRefs.map(normalizeTargetRef)\n      : [],\n    orderedSteps,\n    allowedChanges,\n    forbiddenChanges,\n    instructionPacks: Array.isArray(brief.instructionPacks || brief.selectedInstructionPacks)\n      ? (brief.instructionPacks || brief.selectedInstructionPacks).map((pack) => trimText(pack)).filter(Boolean)\n      : [],\n    responseFacts: isPlainObject(brief.responseFacts) ? clone(brief.responseFacts) : {},\n  };\n}\n\nfunction isConstructorOperation(operationKind) {\n  return Object.prototype.hasOwnProperty.call(CONSTRUCTOR_CREATED_TARGET_KINDS, operationKind);\n}\n\nfunction isRemoveOperation(operationKind) {\n  return operationKind === OPERATION_KINDS.REMOVE_COMPONENT ||\n    operationKind === OPERATION_KINDS.REMOVE_MEASURE ||\n    operationKind === OPERATION_KINDS.REMOVE_SCORECARD ||\n    operationKind === OPERATION_KINDS.REMOVE_RATE_TABLE;\n}\n\nfunction removeTargetKindForOperation(operationKind) {\n  if (operationKind === OPERATION_KINDS.REMOVE_COMPONENT) return 'component';\n  if (operationKind === OPERATION_KINDS.REMOVE_MEASURE) return 'measure';\n  if (operationKind === OPERATION_KINDS.REMOVE_SCORECARD) return 'scorecard';\n  if (operationKind === OPERATION_KINDS.REMOVE_RATE_TABLE) return 'rateTable';\n  return '';\n}\n\nfunction removeFieldForOperation(operationKind) {\n  if (operationKind === OPERATION_KINDS.REMOVE_COMPONENT) return 'planComponents';\n  if (operationKind === OPERATION_KINDS.REMOVE_MEASURE) return 'performanceMeasures';\n  if (operationKind === OPERATION_KINDS.REMOVE_SCORECARD) return 'scorecards';\n  if (operationKind === OPERATION_KINDS.REMOVE_RATE_TABLE) return 'rateTables';\n  return '';\n}\n\nfunction constructorCreatedTargetKind(operationKind) {\n  return CONSTRUCTOR_CREATED_TARGET_KINDS[operationKind] || '';\n}\n\nfunction isExplicitPlaceholderStep(step) {\n  return step &&\n    trimText(step.status).toUpperCase() === 'NEEDS_REVIEW' &&\n    step.userExplicitPlaceholder === true;\n}\n\nfunction validateAcceptedRecommendationPlaceholderFacts(step) {\n  if (!hasOwn(step, 'reviewNotes') || isMissingAcceptedRecommendationFact(step.reviewNotes, 'reviewNotes')) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.CLARIFY,\n      reason: 'The accepted recommendation still needs review notes before I can create a placeholder item.',\n    };\n  }\n  const unresolvedPath = findUnresolvedFactPath(step.reviewNotes, ['reviewNotes']);\n  if (unresolvedPath) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.CLARIFY,\n      reason: 'The accepted recommendation still has unresolved placeholder review notes.',\n    };\n  }\n  return { ok: true };\n}\n\nfunction validateAcceptedRecommendationResolvedFacts(brief) {\n  const accepted = brief && brief.responseFacts && isPlainObject(brief.responseFacts.acceptedRecommendation)\n    ? brief.responseFacts.acceptedRecommendation\n    : null;\n  if (!accepted) {\n    return { ok: true };\n  }\n  const steps = Array.isArray(brief.orderedSteps) ? brief.orderedSteps : [];\n  for (let idx = 0; idx < steps.length; idx += 1) {\n    const step = steps[idx] || {};\n    if (isExplicitPlaceholderStep(step)) {\n      const placeholderValidation = validateAcceptedRecommendationPlaceholderFacts(step);\n      if (!placeholderValidation.ok) {\n        return placeholderValidation;\n      }\n      continue;\n    }\n    const requiredFields = CONSTRUCTOR_REQUIRED_FACT_FIELDS[step.operationKind] || [];\n    for (let fieldIdx = 0; fieldIdx < requiredFields.length; fieldIdx += 1) {\n      const field = requiredFields[fieldIdx];\n      if (!hasOwn(step, field) || isMissingAcceptedRecommendationFact(step[field], field)) {\n        return {\n          ok: false,\n          status: BATCH_STATUSES.CLARIFY,\n          reason: 'The accepted recommendation still needs a resolved ' + field + ' before I can apply it.',\n        };\n      }\n      if (field === 'incentiveType' && step[field] === null) {\n        continue;\n      }\n      const unresolvedPath = findUnresolvedFactPath(step[field], [field]);\n      if (unresolvedPath) {\n        return {\n          ok: false,\n          status: BATCH_STATUSES.CLARIFY,\n          reason: 'The accepted recommendation still has an unresolved required fact at ' + unresolvedPath + '.',\n        };\n      }\n    }\n  }\n  return { ok: true };\n}\n\nfunction localRefTargetForStep(step) {\n  const localRef = trimText(step && step.localRef);\n  const targetKind = constructorCreatedTargetKind(step && step.operationKind);\n  if (!localRef || !targetKind) {\n    return null;\n  }\n  return {\n    refId: localRef,\n    localRef,\n    targetKind,\n    id: null,\n    name: trimText(step.entityName) || null,\n    owner: {\n      createdByStepId: trimText(step.id),\n    },\n    createdByStepId: trimText(step.id),\n    isLocalRef: true,\n  };\n}\n\nfunction targetForStep(brief, step, localRefTargets) {\n  if (step.targetRef) {\n    for (let idx = 0; idx < brief.targets.length; idx += 1) {\n      if (brief.targets[idx].refId === step.targetRef) {\n        return brief.targets[idx];\n      }\n    }\n    const localTarget = localRefTargets && localRefTargets[step.targetRef];\n    if (localTarget) {\n      return localTarget;\n    }\n  }\n  return null;\n}\n\nfunction targetRefExists(brief, targetRef) {\n  const ref = trimText(targetRef);\n  for (let idx = 0; idx < brief.targets.length; idx += 1) {\n    if (brief.targets[idx].refId === ref) {\n      return true;\n    }\n  }\n  return false;\n}\n\nfunction completeImplicitStepTargets(brief, planIndex) {\n  const steps = Array.isArray(brief && brief.orderedSteps) ? brief.orderedSteps : [];\n  for (let idx = 0; idx < steps.length; idx += 1) {\n    const step = steps[idx] || {};\n    const targetRef = trimText(step.targetRef);\n    if (!targetRef || targetRefExists(brief, targetRef)) {\n      continue;\n    }\n    const targetKind = inferredTargetKindForOperation(step.operationKind);\n    if (!targetKind) {\n      continue;\n    }\n    const resolved = resolveIndexedTarget(planIndex, {\n      targetKind,\n      id: targetRef,\n    });\n    if (resolved.status !== 'RESOLVED') {\n      return {\n        ok: false,\n        status: resolved.status === 'CLARIFY' ? BATCH_STATUSES.CLARIFY : BATCH_STATUSES.BLOCKED,\n        reason: resolved.reason,\n      };\n    }\n    const entry = resolved.entry || {};\n    if (!entry.id) {\n      return {\n        ok: false,\n        status: BATCH_STATUSES.BLOCKED,\n        reason: 'The current plan target does not expose a stable ID; name-only edit authority is not allowed.',\n      };\n    }\n    brief.targets.push({\n      refId: targetRef,\n      targetKind,\n      id: String(entry.id),\n      name: entry.name || null,\n      owner: isPlainObject(entry.owner) ? clone(entry.owner) : {},\n      implicitlyResolved: true,\n    });\n  }\n  return { ok: true };\n}\n\nfunction validateConstructorLocalRefStep(brief, step, localRefTargets) {\n  if (!isConstructorOperation(step.operationKind) || !trimText(step.localRef)) {\n    return { ok: true };\n  }\n  const localRef = trimText(step.localRef);\n  if (targetRefExists(brief, localRef) || localRefTargets[localRef]) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.BLOCKED,\n      reason: 'Constructor localRefs must be unique and must not reuse existing target refs.',\n    };\n  }\n  const localTarget = localRefTargetForStep(step);\n  if (!localTarget || !localTarget.name) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.CLARIFY,\n      reason: 'Constructor localRefs require the grounded new entity name.',\n    };\n  }\n  localRefTargets[localRef] = localTarget;\n  return { ok: true };\n}\n\nfunction localRefDependencyTarget(localRefTargets, dependencyRef) {\n  const localRef = trimText(dependencyRef && (dependencyRef.localRef || dependencyRef.refId));\n  if (!localRef || !localRefTargets || !localRefTargets[localRef]) {\n    return null;\n  }\n  return localRefTargets[localRef];\n}\n\nfunction validateLocalRefDependencyRef(dependencyRef, localTarget) {\n  if (!dependencyRef || !localTarget) {\n    return { ok: true };\n  }\n  if (dependencyRef.targetKind !== localTarget.targetKind) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.BLOCKED,\n      reason: 'The localRef dependency kind does not match the constructed object.',\n    };\n  }\n  if (dependencyRef.id) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.BLOCKED,\n      reason: 'LocalRef dependencies must not include invented stable IDs.',\n    };\n  }\n  if (!trimText(dependencyRef.name)) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.BLOCKED,\n      reason: 'LocalRef dependencies must include the constructed object name.',\n    };\n  }\n  if (localTarget.name && normalizeText(dependencyRef.name) !== normalizeText(localTarget.name)) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.BLOCKED,\n      reason: 'The localRef dependency name does not match the constructed object.',\n    };\n  }\n  return { ok: true };\n}\n\nfunction matchesScope(ruleTargetRef, stepTargetRef) {\n  return !ruleTargetRef || !stepTargetRef || ruleTargetRef === stepTargetRef;\n}\n\nfunction matchesAllowedScope(ruleTargetRef, stepTargetRef) {\n  return !!ruleTargetRef && !!stepTargetRef && ruleTargetRef === stepTargetRef;\n}\n\nfunction implicitFieldForOperation(operationKind) {\n  if (operationKind === OPERATION_KINDS.FORMULA_EXPRESSION_UPDATE) {\n    return 'expression';\n  }\n  if (operationKind === OPERATION_KINDS.REDEFINE_RATE_DIMENSION) {\n    return 'definition';\n  }\n  if (operationKind === OPERATION_KINDS.RATE_DIMENSION_INPUT_EXPRESSION_UPDATE) {\n    return 'inputExpression';\n  }\n  return '';\n}\n\nfunction normalizeAuthorityField(operationKind, field) {\n  const clean = trimText(field);\n  if (!clean) {\n    return '';\n  }\n  if (operationKind === OPERATION_KINDS.RENAME_ENTITY) {\n    if (\n      clean === 'name' ||\n      clean === 'planName' ||\n      clean === 'componentName' ||\n      clean === 'measureName' ||\n      clean === 'formulaName' ||\n      clean === 'rateTableName' ||\n      clean === 'scorecardName' ||\n      clean === 'dimensionName'\n    ) {\n      return 'name';\n    }\n  }\n  if (operationKind === OPERATION_KINDS.FORMULA_EXPRESSION_UPDATE) {\n    if (\n      clean === 'expression' ||\n      clean === 'expressionText' ||\n      clean === 'expression.expressionText' ||\n      clean === 'payload.expressionText'\n    ) {\n      return 'expression';\n    }\n  }\n  if (operationKind === OPERATION_KINDS.RATE_DIMENSION_INPUT_EXPRESSION_UPDATE) {\n    if (\n      clean === 'inputExpression' ||\n      clean === 'rateDimensionalInputs.inputExpression' ||\n      clean === 'expressionText' ||\n      clean === 'inputExpression.expressionText' ||\n      clean === 'payload.expressionText'\n    ) {\n      return 'inputExpression';\n    }\n  }\n  if (operationKind === OPERATION_KINDS.RATE_DIMENSION_METADATA_UPDATE) {\n    if (\n      clean === 'metadata' ||\n      clean === 'definition' ||\n      clean === 'dimension' ||\n      clean === 'dimensions'\n    ) {\n      return 'definition';\n    }\n    if (\n      clean === 'inputExpression' ||\n      clean === 'dimensions.inputExpression' ||\n      clean === 'rateDimensionalInputs.inputExpression'\n    ) {\n      return 'inputExpression';\n    }\n  }\n  if (operationKind === OPERATION_KINDS.REDEFINE_RATE_DIMENSION) {\n    if (\n      clean === 'definition' ||\n      clean === 'dimension' ||\n      clean === 'dimensionName' ||\n      clean === 'name' ||\n      clean === 'dimensionType' ||\n      clean === 'unitOfMeasure' ||\n      clean === 'values' ||\n      clean === 'tiers' ||\n      clean === 'inputExpression' ||\n      clean === 'rateDimensionalInputs.inputExpression' ||\n      clean === 'expressionText' ||\n      clean === 'preserveRates'\n    ) {\n      return 'definition';\n    }\n  }\n  if (operationKind === OPERATION_KINDS.ADD_MEASURE) {\n    if (\n      clean === 'formula' ||\n      clean === 'formulaName' ||\n      clean === 'formulaExpressionText' ||\n      clean === 'expressionText' ||\n      clean === 'formula.expression' ||\n      clean === 'formula.expression.simpleExpression'\n    ) {\n      return 'formula';\n    }\n  }\n  if (operationKind === OPERATION_KINDS.ADD_SCORECARD || operationKind === OPERATION_KINDS.ADD_RATE_TABLE) {\n    if (\n      clean === 'formula' ||\n      clean === 'formulaExpression' ||\n      clean === 'formula.expression' ||\n      clean === 'updateFormulaToRtr'\n    ) {\n      return 'formula.expression';\n    }\n  }\n  if (operationKind === OPERATION_KINDS.TABULAR_TABLE_REPLACEMENT) {\n    if (\n      clean === 'table' ||\n      clean === 'dimensions' ||\n      clean === 'rateValues' ||\n      clean === 'rows'\n    ) {\n      return 'table';\n    }\n  }\n  return clean;\n}\n\nfunction allowedFieldsForOperation(allowed, operationKind) {\n  const fields = Array.isArray(allowed && allowed.fields) ? allowed.fields : [];\n  const normalizeForKind = allowed.operationKind || operationKind;\n  return fields.map((field) => normalizeAuthorityField(normalizeForKind, field));\n}\n\nfunction isStepAllowed(brief, step) {\n  if (!Array.isArray(brief.allowedChanges) || brief.allowedChanges.length === 0) {\n    return false;\n  }\n  const stepField = normalizeAuthorityField(step.operationKind, step.field || implicitFieldForOperation(step.operationKind));\n  for (let idx = 0; idx < brief.allowedChanges.length; idx += 1) {\n    const allowed = brief.allowedChanges[idx];\n    const operationMatches = !allowed.operationKind || allowed.operationKind === step.operationKind;\n    const targetMatches = matchesAllowedScope(allowed.targetRef, step.targetRef);\n    const allowedFields = allowedFieldsForOperation(allowed, step.operationKind);\n    const fieldMatches = allowedFields.length === 0 || !stepField || allowedFields.indexOf(stepField) !== -1;\n    if (operationMatches && targetMatches && fieldMatches) {\n      return true;\n    }\n  }\n  return false;\n}\n\nfunction isStepForbidden(brief, step) {\n  const stepField = normalizeAuthorityField(step.operationKind, step.field || implicitFieldForOperation(step.operationKind));\n  for (let idx = 0; idx < brief.forbiddenChanges.length; idx += 1) {\n    const forbidden = brief.forbiddenChanges[idx];\n    const operationMatches = !forbidden.operationKind || forbidden.operationKind === step.operationKind;\n    const targetMatches = matchesScope(forbidden.targetRef, step.targetRef);\n    const normalizedForbiddenFields = allowedFieldsForOperation(forbidden, step.operationKind);\n    const forbiddenFields = normalizedForbiddenFields.filter((field) => !(\n      step.operationKind === OPERATION_KINDS.REDEFINE_RATE_DIMENSION &&\n      forbidden.operationKind === OPERATION_KINDS.REDEFINE_RATE_DIMENSION &&\n      field === 'definition'\n    ));\n    if (normalizedForbiddenFields.length > 0 && forbiddenFields.length === 0) {\n      continue;\n    }\n    const fieldMatches = forbiddenFields.length === 0 || (stepField && forbiddenFields.indexOf(stepField) !== -1);\n    if (operationMatches && targetMatches && fieldMatches) {\n      return true;\n    }\n  }\n  return false;\n}\n\nfunction validateExpressionStep(step) {\n  const hasExpressionText = !!trimText(step.expressionText);\n  const hasEditInstruction = !!trimText(step.editInstruction);\n  if (hasExpressionText === hasEditInstruction) {\n    return {\n      ok: false,\n      reason: 'Expression edits must include exactly one of replacement expression text or transformation instruction.',\n    };\n  }\n  return { ok: true };\n}\n\nfunction validateFormulaExpressionTarget(step, target) {\n  if (step.operationKind !== OPERATION_KINDS.FORMULA_EXPRESSION_UPDATE) {\n    return { ok: true };\n  }\n  if (target && target.isLocalRef) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.BLOCKED,\n      reason: 'Formula expression update steps must target an exact existing formula; constructor formula logic belongs on the constructor step.',\n    };\n  }\n  if (!target || target.targetKind !== 'formula') {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.BLOCKED,\n      reason: 'Formula expression update steps must target one exact existing formula.',\n    };\n  }\n  return { ok: true };\n}\n\nfunction rateDimensionRedefinitionName(step) {\n  return trimText(step.dimensionName || step.newName || step.entityName);\n}\n\nfunction rateDimensionRedefinitionValues(step) {\n  if (Array.isArray(step.values)) {\n    return step.values;\n  }\n  if (Array.isArray(step.value)) {\n    return step.value;\n  }\n  return [];\n}\n\nfunction rateDimensionRedefinitionInputExpression(step) {\n  return trimText(step.inputExpression || step.expressionText);\n}\n\nfunction rateDimensionStepInputExpression(step) {\n  if (!step) {\n    return '';\n  }\n  if (trimText(step.inputExpression)) {\n    return trimText(step.inputExpression);\n  }\n  if (isPlainObject(step.value) && trimText(step.value.inputExpression || step.value.expressionText)) {\n    return trimText(step.value.inputExpression || step.value.expressionText);\n  }\n  if (trimText(step.expressionText)) {\n    return trimText(step.expressionText);\n  }\n  if (\n    step.operationKind === OPERATION_KINDS.RATE_DIMENSION_INPUT_EXPRESSION_UPDATE &&\n    trimText(step.value)\n  ) {\n    return trimText(step.value);\n  }\n  if (\n    step.operationKind === OPERATION_KINDS.RATE_DIMENSION_METADATA_UPDATE &&\n    (\n      step.field === 'inputExpression' ||\n      step.field === 'dimensions.inputExpression' ||\n      step.field === 'rateDimensionalInputs.inputExpression'\n    ) &&\n    trimText(step.value)\n  ) {\n    return trimText(step.value);\n  }\n  return '';\n}\n\nfunction rateDimensionStepValues(step) {\n  if (!step) {\n    return [];\n  }\n  if (Array.isArray(step.values)) {\n    return step.values;\n  }\n  if (isPlainObject(step.value) && Array.isArray(step.value.values)) {\n    return step.value.values;\n  }\n  if (isPlainObject(step.value) && Array.isArray(step.value.tiers)) {\n    return step.value.tiers;\n  }\n  if (\n    step.operationKind === OPERATION_KINDS.RATE_DIMENSION_VALUES_UPDATE &&\n    Array.isArray(step.value)\n  ) {\n    return step.value;\n  }\n  if (Array.isArray(step.value) && (step.field === 'values' || step.field === 'tiers')) {\n    return step.value;\n  }\n  return [];\n}\n\nfunction rateDimensionStepDimensionName(step) {\n  if (isPlainObject(step && step.value)) {\n    return trimText(step.value.dimensionName || step.value.name || step.dimensionName || step.newName || step.entityName);\n  }\n  return trimText(step && (step.dimensionName || step.newName || step.entityName));\n}\n\nfunction rateDimensionStepDimensionType(step) {\n  if (!step) {\n    return '';\n  }\n  if (trimText(step.dimensionType)) {\n    return trimText(step.dimensionType);\n  }\n  if (isPlainObject(step.value) && trimText(step.value.dimensionType)) {\n    return trimText(step.value.dimensionType);\n  }\n  if (\n    step.operationKind === OPERATION_KINDS.RATE_DIMENSION_METADATA_UPDATE &&\n    step.field === 'dimensionType'\n  ) {\n    return trimText(step.value);\n  }\n  return '';\n}\n\nfunction rateDimensionStepUnitOfMeasure(step) {\n  if (!step) {\n    return '';\n  }\n  if (trimText(step.unitOfMeasure)) {\n    return trimText(step.unitOfMeasure);\n  }\n  if (isPlainObject(step.value) && trimText(step.value.unitOfMeasure)) {\n    return trimText(step.value.unitOfMeasure);\n  }\n  if (\n    step.operationKind === OPERATION_KINDS.RATE_DIMENSION_METADATA_UPDATE &&\n    step.field === 'unitOfMeasure'\n  ) {\n    return trimText(step.value);\n  }\n  return '';\n}\n\nfunction rateDimensionDefinitionField(field) {\n  const clean = trimText(field);\n  return clean === 'definition' || clean === 'dimension' || clean === 'dimensions';\n}\n\nfunction requestSuggestsRateDimensionReplacement(request) {\n  const text = normalizeText(request || '');\n  const hasTableShapeCue = text.indexOf('dimension') !== -1 ||\n    text.indexOf('tier') !== -1 ||\n    text.indexOf('axis') !== -1 ||\n    text.indexOf('column') !== -1 ||\n    text.indexOf('bucket') !== -1 ||\n    text.indexOf('band') !== -1 ||\n    /\\b(score|scoring|scored|rate|rating|rated)\\s+by\\b/.test(text);\n  if (!hasTableShapeCue) {\n    return false;\n  }\n  return /\\b(replace|replaced|replacing|redefine|redefined|redefining|swap|swapped|swapping|change|changed|changing|convert|converted|converting|pivot|pivoted|pivoting)\\b/.test(text) ||\n    /\\binstead of\\b/.test(text) ||\n    /\\baway from\\b/.test(text) ||\n    /\\bstop\\s+(banding|scoring|rating)\\s+by\\b/.test(text) ||\n    /\\buse\\b.+\\binstead\\b/.test(text);\n}\n\nfunction expressionLeafName(expressionText) {\n  const expression = trimText(expressionText);\n  if (!expression) {\n    return '';\n  }\n  const normalized = expression.replace(/\\[[^\\]]+\\]/g, '').replace(/\\([^)]*\\)/g, '');\n  const parts = normalized.split('.').map((part) => trimText(part)).filter(Boolean);\n  if (parts.length === 0) {\n    return '';\n  }\n  const leaf = parts[parts.length - 1]\n    .replace(/[\"']/g, '')\n    .replace(/\\s+/g, ' ')\n    .trim();\n  if (!leaf || /[+\\-*/<>=]/.test(leaf)) {\n    return '';\n  }\n  return leaf;\n}\n\nfunction splitNaturalLanguageList(text) {\n  const clean = trimText(text)\n    .replace(/\\s+/g, ' ')\n    .replace(/\\s*,?\\s+and\\s+/gi, ',');\n  return clean\n    .split(',')\n    .map((part) => trimText(part.replace(/^[\"']|[\"']$/g, '')))\n    .filter(Boolean);\n}\n\nfunction replacementValuesFromText(text) {\n  const source = trimText(text);\n  if (!source) {\n    return [];\n  }\n  const patterns = [\n    /(?:tier positions|tiers|values)\\s+as\\s+([^.;]+)/i,\n    /(?:use|set)\\s+([^.;]+?)\\s+(?:tier positions|tiers|values|columns|buckets)\\s+(?:from|driven by|using)\\b/i,\n    /with\\s+([^.;]+?)\\s+(?:tier positions|tiers|values|columns|buckets)\\s+(?:from|driven by|using)\\b/i,\n    /(?:columns|buckets|tiers|values)\\s+should\\s+be\\s+([^.;]+)/i,\n  ];\n  let match = null;\n  for (let idx = 0; idx < patterns.length; idx += 1) {\n    match = source.match(patterns[idx]);\n    if (match) {\n      break;\n    }\n  }\n  if (!match) {\n    return [];\n  }\n  const listText = trimText(match[1])\n    .replace(/,?\\s*driven by\\b.*$/i, '')\n    .replace(/,?\\s*from\\b.*$/i, '')\n    .replace(/,?\\s*using\\b.*$/i, '')\n    .replace(/,?\\s*with\\b.*$/i, '');\n  const values = splitNaturalLanguageList(listText);\n  return values.length > 1 ? values : [];\n}\n\nfunction replacementValuesFromAuthorityText(authority) {\n  const parts = [];\n  if (authority && authority.request) {\n    parts.push(authority.request);\n  }\n  const facts = authority && authority.responseFacts && typeof authority.responseFacts === 'object'\n    ? authority.responseFacts\n    : {};\n  if (facts.summary) {\n    parts.push(facts.summary);\n  }\n  for (let idx = 0; idx < parts.length; idx += 1) {\n    const values = replacementValuesFromText(parts[idx]);\n    if (values.length > 0) {\n      return values;\n    }\n  }\n  return [];\n}\n\nfunction replacementInputExpressionFromText(text) {\n  const source = trimText(text);\n  if (!source) {\n    return '';\n  }\n  const match = source.match(/\\b(?:driven by|drive from|from|using)\\s+([A-Za-z][A-Za-z0-9 _-]*(?:\\.[A-Za-z][A-Za-z0-9 _-]*)+)/i);\n  if (!match) {\n    return '';\n  }\n  return trimText(match[1]);\n}\n\nfunction replacementInputExpressionFromAuthorityText(authority) {\n  const parts = [];\n  if (authority && authority.request) {\n    parts.push(authority.request);\n  }\n  const facts = authority && authority.responseFacts && typeof authority.responseFacts === 'object'\n    ? authority.responseFacts\n    : {};\n  if (facts.summary) {\n    parts.push(facts.summary);\n  }\n  for (let idx = 0; idx < parts.length; idx += 1) {\n    const inputExpression = replacementInputExpressionFromText(parts[idx]);\n    if (inputExpression) {\n      return inputExpression;\n    }\n  }\n  return '';\n}\n\nfunction validateRateDimensionRedefinitionStep(step, target) {\n  if (step.operationKind !== OPERATION_KINDS.REDEFINE_RATE_DIMENSION) {\n    return { ok: true };\n  }\n  if (!target || target.targetKind !== 'rateDimension') {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.BLOCKED,\n      reason: 'Rate dimension redefinition steps must target one exact existing rate dimension.',\n    };\n  }\n  if (target && target.isLocalRef) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.BLOCKED,\n      reason: 'Rate dimension redefinition steps must target an exact existing rate dimension.',\n    };\n  }\n  if (!rateDimensionRedefinitionName(step)) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.CLARIFY,\n      reason: 'What should the replacement dimension be named?',\n    };\n  }\n  if (rateDimensionRedefinitionValues(step).length === 0) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.CLARIFY,\n      reason: 'What dimension values should replace the current tiers?',\n    };\n  }\n  if (!rateDimensionRedefinitionInputExpression(step)) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.CLARIFY,\n      reason: 'What input expression should drive the replacement dimension?',\n    };\n  }\n  if (step.preserveRates === false) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.BLOCKED,\n      reason: 'Rate dimension redefinition currently preserves existing rates; changing rates requires explicit rate row edits.',\n    };\n  }\n  return { ok: true };\n}\n\nfunction validateRenameAuthorityStep(step) {\n  if (step.operationKind === OPERATION_KINDS.RENAME_ENTITY) {\n    if (step.field && !isNameField(step.field)) {\n      return {\n        ok: false,\n        status: BATCH_STATUSES.BLOCKED,\n        reason: 'Rename steps may only target entity name fields.',\n      };\n    }\n    if (!trimText(step.newName || step.value)) {\n      return {\n        ok: false,\n        status: BATCH_STATUSES.CLARIFY,\n        reason: 'What should the new name be?',\n      };\n    }\n    return { ok: true };\n  }\n  if (step.operationKind === OPERATION_KINDS.REDEFINE_RATE_DIMENSION) {\n    return { ok: true };\n  }\n  if (isNameField(step.field)) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.BLOCKED,\n      reason: 'Name changes must use renameEntity; field-update operations cannot change entity names.',\n    };\n  }\n  return { ok: true };\n}\n\nfunction validateConstructorAuthorityStep(step, target) {\n  if (\n    step.operationKind !== OPERATION_KINDS.ADD_COMPONENT &&\n    step.operationKind !== OPERATION_KINDS.ADD_MEASURE &&\n    step.operationKind !== OPERATION_KINDS.ADD_SCORECARD &&\n    step.operationKind !== OPERATION_KINDS.ADD_RATE_TABLE\n  ) {\n    return { ok: true };\n  }\n  if (step.payload && Object.keys(step.payload).length > 0) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.BLOCKED,\n      reason: 'Constructor steps must keep facts flat on the ordered step, not inside payload.',\n    };\n  }\n  const requiredField = CONSTRUCTOR_STEP_FIELDS[step.operationKind];\n  if (step.field !== requiredField) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.BLOCKED,\n      reason: 'Constructor steps must use the matrix field ' + requiredField + '.',\n    };\n  }\n  if (step.operationKind === OPERATION_KINDS.ADD_RATE_TABLE) {\n    if (!target || target.targetKind !== 'component') {\n      return {\n        ok: false,\n        status: BATCH_STATUSES.BLOCKED,\n        reason: 'Add-rate-table steps must target one exact existing component or prior component localRef.',\n      };\n    }\n    if (!trimText(step.entityName)) {\n      return {\n        ok: false,\n        status: BATCH_STATUSES.CLARIFY,\n        reason: 'What should I call the new rate table?',\n      };\n    }\n    return { ok: true };\n  }\n  if (step.operationKind === OPERATION_KINDS.ADD_SCORECARD) {\n    if (!target || target.targetKind !== 'measure') {\n      return {\n        ok: false,\n        status: BATCH_STATUSES.BLOCKED,\n        reason: 'Add-scorecard steps must target one exact existing measure or prior measure localRef.',\n      };\n    }\n    if (!trimText(step.entityName)) {\n      return {\n        ok: false,\n        status: BATCH_STATUSES.CLARIFY,\n        reason: 'What should I call the new scorecard?',\n      };\n    }\n    return { ok: true };\n  }\n  if (step.operationKind === OPERATION_KINDS.ADD_MEASURE) {\n    if (!target || target.targetKind !== 'component') {\n      return {\n        ok: false,\n        status: BATCH_STATUSES.BLOCKED,\n        reason: 'Add-measure steps must target one exact existing component or prior component localRef.',\n      };\n    }\n    if (!trimText(step.entityName)) {\n      return {\n        ok: false,\n        status: BATCH_STATUSES.CLARIFY,\n        reason: 'What should I call the new measure?',\n      };\n    }\n    return { ok: true };\n  }\n  if (!target || target.targetKind !== 'plan') {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.BLOCKED,\n      reason: 'Add-component steps must target the current plan.',\n    };\n  }\n  if (!trimText(step.entityName)) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.CLARIFY,\n      reason: 'What should I call the new component?',\n    };\n  }\n  return { ok: true };\n}\n\nfunction validateRemoveAuthorityStep(step, target) {\n  if (!isRemoveOperation(step.operationKind)) {\n    return { ok: true };\n  }\n  const expectedTargetKind = removeTargetKindForOperation(step.operationKind);\n  if (!target || target.targetKind !== expectedTargetKind) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.BLOCKED,\n      reason: 'Remove steps must target one exact existing ' + expectedTargetKind + '.',\n    };\n  }\n  const expectedField = removeFieldForOperation(step.operationKind);\n  if (step.field !== expectedField) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.BLOCKED,\n      reason: 'Remove steps must use the collection field ' + expectedField + '.',\n    };\n  }\n  return { ok: true };\n}\n\nfunction requestHasExpressionConversionIntent(request) {\n  const text = normalizeText(request || '');\n  if (!text) {\n    return false;\n  }\n  const hasConversionCue = /\\b(convert|converts|converted|converting|transform|transforms|transformed|transforming|turn|turns|turned|turning)\\b/.test(text) ||\n    /\\b(?:change|replace|rework|make)\\b.+\\b(?:into|to|as)\\b/.test(text);\n  if (!hasConversionCue) {\n    return false;\n  }\n  return /\\b(expression|formula|calculation|logic)\\b/.test(text) ||\n    /\\b(?:into|to|as)\\s+(?:an?\\s+)?(?:expression|formula|calculation)\\b/.test(text);\n}\n\nfunction isTabularOnlyOperationKind(operationKind) {\n  return operationKind === OPERATION_KINDS.RATE_VALUE_UPDATE ||\n    operationKind === OPERATION_KINDS.RATE_DIMENSION_VALUES_UPDATE ||\n    operationKind === OPERATION_KINDS.TABULAR_TABLE_REPLACEMENT;\n}\n\nfunction isExpressionOperationKind(operationKind) {\n  return operationKind === OPERATION_KINDS.FORMULA_EXPRESSION_UPDATE ||\n    operationKind === OPERATION_KINDS.RATE_DIMENSION_INPUT_EXPRESSION_UPDATE ||\n    operationKind === OPERATION_KINDS.FORMULA_COMPOSITE;\n}\n\nfunction validateTurnIntentCompatibility(brief, request) {\n  if (!requestHasExpressionConversionIntent(request)) {\n    return { ok: true };\n  }\n  const steps = Array.isArray(brief && brief.orderedSteps) ? brief.orderedSteps : [];\n  if (steps.length === 0) {\n    return { ok: true };\n  }\n  const hasExpressionStep = steps.some((step) => isExpressionOperationKind(step && step.operationKind));\n  if (hasExpressionStep) {\n    return { ok: true };\n  }\n  const tabularOnly = steps.every((step) => isTabularOnlyOperationKind(step && step.operationKind));\n  if (!tabularOnly) {\n    return { ok: true };\n  }\n  return {\n    ok: false,\n    status: BATCH_STATUSES.BLOCKED,\n    reason: 'The planned edit only changes table values, but the current request asks for an expression or formula conversion.',\n  };\n}\n\nfunction normalizeNumericLiteral(value) {\n  if (value === undefined || value === null || value === '') {\n    return '';\n  }\n  const numberValue = Number(String(value).replace(/,/g, ''));\n  if (!Number.isFinite(numberValue)) {\n    return '';\n  }\n  return String(numberValue);\n}\n\nfunction numericLiteralsInText(text) {\n  const literals = {};\n  const source = String(text || '');\n  const re = /-?\\d[\\d,]*(?:\\.\\d+)?/g;\n  let match = re.exec(source);\n  while (match) {\n    const normalized = normalizeNumericLiteral(match[0]);\n    if (normalized) {\n      literals[normalized] = true;\n    }\n    match = re.exec(source);\n  }\n  return literals;\n}\n\nfunction requestHasSpecificNonTabularIntent(request) {\n  const text = normalizeText(request || '');\n  if (!text) {\n    return false;\n  }\n  if (requestHasExpressionConversionIntent(request)) {\n    return true;\n  }\n  return /\\b(rename|describe|explain|summarize|delete|remove|create|add)\\b/.test(text) &&\n    !/\\b(rate|rates|score|scores|scoring|value|values|cell|row|tier|tiers|band|bands|table|matrix)\\b/.test(text);\n}\n\nfunction coordinateKey(row, fallbackIndex) {\n  const coordinates = row && row.coordinates && typeof row.coordinates === 'object' && !Array.isArray(row.coordinates)\n    ? row.coordinates\n    : null;\n  if (!coordinates) {\n    return 'index:' + String(fallbackIndex);\n  }\n  return Object.keys(coordinates).sort().map((key) => key + '=' + String(coordinates[key])).join('|');\n}\n\nfunction oldRateLookup(rows) {\n  const lookup = {};\n  const oldRows = Array.isArray(rows) ? rows : [];\n  for (let idx = 0; idx < oldRows.length; idx += 1) {\n    lookup[coordinateKey(oldRows[idx], idx)] = oldRows[idx] && oldRows[idx].rate;\n  }\n  return lookup;\n}\n\nfunction collectUngroundedNumericTableValues(mutation, requestNumbers) {\n  const values = [];\n  if (!mutation || !mutation.payload) {\n    return values;\n  }\n  if (mutation.kind === 'UPDATE_RATE_VALUE') {\n    const oldValue = normalizeNumericLiteral(mutation.payload.oldValue);\n    const newValue = normalizeNumericLiteral(mutation.payload.value);\n    if (newValue && newValue !== oldValue && !requestNumbers[newValue]) {\n      values.push(newValue);\n    }\n    return values;\n  }\n  if (mutation.kind !== 'BULK_REPLACE_RATE_VALUES' && mutation.kind !== 'REPLACE_TABULAR_TABLE') {\n    return values;\n  }\n  const lookup = oldRateLookup(mutation.payload.oldRateValues || []);\n  const newRows = Array.isArray(mutation.payload.rateValues) ? mutation.payload.rateValues : [];\n  for (let idx = 0; idx < newRows.length; idx += 1) {\n    const row = newRows[idx] || {};\n    const oldValue = normalizeNumericLiteral(lookup[coordinateKey(row, idx)]);\n    const newValue = normalizeNumericLiteral(row.rate);\n    if (newValue && newValue !== oldValue && !requestNumbers[newValue]) {\n      values.push(newValue);\n    }\n  }\n  return Object.keys(values.reduce((acc, value) => {\n    acc[value] = true;\n    return acc;\n  }, {}));\n}\n\nfunction validateCurrentTurnNumericGrounding(finalized, request) {\n  if (!requestHasSpecificNonTabularIntent(request)) {\n    return { ok: true };\n  }\n  const requestNumbers = numericLiteralsInText(request);\n  const mutations = Array.isArray(finalized) ? finalized : [];\n  for (let idx = 0; idx < mutations.length; idx += 1) {\n    const ungrounded = collectUngroundedNumericTableValues(mutations[idx], requestNumbers);\n    if (ungrounded.length > 0) {\n      return {\n        ok: false,\n        blocked: {\n          index: idx,\n          kind: mutations[idx] && mutations[idx].kind,\n          reason: 'The planned table value edit uses a numeric value that is not grounded in the current request.',\n          metadata: {\n            ungroundedValues: ungrounded,\n          },\n        },\n      };\n    }\n  }\n  return { ok: true };\n}\n\nfunction mutationKindForScalarTarget(targetKind) {\n  if (targetKind === 'plan') return 'UPDATE_PLAN_FIELD';\n  if (targetKind === 'component') return 'UPDATE_COMPONENT_FIELD';\n  if (targetKind === 'measure') return 'UPDATE_MEASURE_FIELD';\n  if (targetKind === 'formula') return 'UPDATE_FORMULA_FIELD';\n  if (targetKind === 'rateTable' || targetKind === 'scorecard') return 'UPDATE_RATE_TABLE_METADATA';\n  if (targetKind === 'rateDimension') return 'UPDATE_RATE_DIMENSION_METADATA';\n  return '';\n}\n\nfunction defaultNameFieldForTarget(targetKind) {\n  if (targetKind === 'plan') return 'planName';\n  if (targetKind === 'component') return 'componentName';\n  if (targetKind === 'measure') return 'measureName';\n  if (targetKind === 'formula') return 'formulaName';\n  if (targetKind === 'scorecard') return 'scorecardName';\n  if (targetKind === 'rateDimension') return 'dimensionName';\n  if (targetKind === 'rateTable') return 'rateTableName';\n  return 'name';\n}\n\nfunction finalizeRenameMutation(draft, planIndex) {\n  const registryEntry = getRegistryEntry(draft.kind);\n  if (!registryEntry) {\n    return {\n      status: BATCH_STATUSES.BLOCKED,\n      reason: 'That edit is not supported yet.',\n    };\n  }\n  const targetKind = normalizeTargetKind(draft.target.targetKind);\n  if (registryEntry.targetKinds.indexOf(targetKind) === -1) {\n    return {\n      status: BATCH_STATUSES.BLOCKED,\n      reason: 'I cannot rename that kind of plan item yet.',\n    };\n  }\n  const rawPayload = isPlainObject(draft.payload) ? clone(draft.payload) : {};\n  if (!rawPayload.newName && Object.prototype.hasOwnProperty.call(rawPayload, 'value')) {\n    rawPayload.newName = rawPayload.value;\n  }\n  const payload = validateRenamePayload(rawPayload);\n  if (!payload.ok) {\n    return {\n      status: BATCH_STATUSES.CLARIFY,\n      reason: payload.reason,\n    };\n  }\n  const resolved = resolveIndexedTarget(planIndex, {\n    targetKind,\n    id: draft.target.id,\n    name: draft.target.name,\n    owner: draft.target.owner || {},\n  });\n  if (resolved.status !== 'RESOLVED') {\n    return {\n      status: resolved.status === 'CLARIFY' ? BATCH_STATUSES.CLARIFY : BATCH_STATUSES.BLOCKED,\n      reason: resolved.reason,\n    };\n  }\n  const entry = resolved.entry;\n  if (String(entry.name || '') === payload.newName) {\n    return {\n      status: BATCH_STATUSES.BLOCKED,\n      reason: (entry.name || 'That item') + ' already has that name.',\n    };\n  }\n  return {\n    status: BATCH_STATUSES.APPLIED,\n    mutation: {\n      kind: 'RENAME_ENTITY',\n      target: {\n        targetKind,\n        path: entry.path.slice(),\n        id: entry.id,\n        idGuard: makeIdGuard(entry),\n        nameField: entry.nameField || defaultNameFieldForTarget(targetKind),\n        owner: clone(entry.owner),\n        name: entry.name || '',\n      },\n      payload: {\n        oldName: entry.name || '',\n        newName: payload.newName,\n      },\n      routing: {\n        requiresAdditionalValidation: null,\n        requiresExpressionResolution: false,\n      },\n      dirtyScopes: registryEntry.dirties.slice(),\n    },\n  };\n}\n\nfunction dispatchHorizontalMutation(draft, plan, planIndex, catalogContext, idRegistry) {\n  if (draft.kind === 'RENAME_ENTITY') {\n    return finalizeRenameMutation(draft, planIndex);\n  }\n  if (draft.kind === 'UPDATE_FORMULA_EXPRESSION') {\n    return finalizeFormulaExpressionMutation(draft, planIndex, plan);\n  }\n  if (draft.kind === 'UPDATE_RATE_DIMENSION_INPUT_EXPRESSION') {\n    return finalizeRateDimensionInputExpressionMutation(draft, planIndex, plan);\n  }\n  if (draft.kind === 'UPDATE_RATE_DIMENSION_VALUES') {\n    return finalizeRateDimensionValuesMutation(draft, planIndex, plan);\n  }\n  if (draft.kind === 'UPDATE_RATE_VALUE') {\n    return finalizeRateValueMutation(draft, planIndex, plan);\n  }\n  if (draft.kind === 'BULK_REPLACE_RATE_VALUES') {\n    return finalizeBulkRateValuesMutation(draft, planIndex, plan);\n  }\n  if (draft.kind === 'REPLACE_TABULAR_TABLE') {\n    return finalizeTabularTableReplacementMutation(draft, planIndex, plan);\n  }\n  if (draft.kind === 'ADD_COMPONENT') {\n    return finalizeAddComponentMutation(draft, plan, planIndex, catalogContext, idRegistry);\n  }\n  if (draft.kind === 'ADD_MEASURE') {\n    return finalizeAddMeasureMutation(draft, plan, planIndex, catalogContext, idRegistry);\n  }\n  if (draft.kind === 'ADD_SCORECARD') {\n    return finalizeAddScorecardMutation(draft, plan, planIndex, catalogContext, idRegistry);\n  }\n  if (draft.kind === 'ADD_RATE_TABLE') {\n    return finalizeAddRateTableMutation(draft, plan, planIndex, catalogContext, idRegistry);\n  }\n  if (\n    draft.kind === 'REMOVE_COMPONENT' ||\n    draft.kind === 'REMOVE_MEASURE' ||\n    draft.kind === 'REMOVE_SCORECARD' ||\n    draft.kind === 'REMOVE_RATE_TABLE'\n  ) {\n    return finalizeRemoveLifecycleMutation(draft, planIndex, plan);\n  }\n  if (draft.kind === 'UPDATE_FORMULA_FIELD') {\n    return finalizeScalarMutation(draft, plan, planIndex, catalogContext);\n  }\n  if (\n    draft.kind === 'UPDATE_PLAN_FIELD' ||\n    draft.kind === 'UPDATE_COMPONENT_FIELD' ||\n    draft.kind === 'UPDATE_MEASURE_FIELD' ||\n    draft.kind === 'UPDATE_RATE_TABLE_METADATA' ||\n    draft.kind === 'UPDATE_RATE_DIMENSION_METADATA'\n  ) {\n    return finalizeScalarMutation(draft, plan, planIndex, catalogContext);\n  }\n  return {\n    status: BATCH_STATUSES.BLOCKED,\n    reason: 'That capability is not enabled in existing-entity editor authority.',\n  };\n}\n\nfunction draftKindFromStep(step, target) {\n  if (step.operationKind === OPERATION_KINDS.REDEFINE_RATE_DIMENSION) return 'REDEFINE_RATE_DIMENSION';\n  if (step.operationKind === OPERATION_KINDS.RENAME_ENTITY) return 'RENAME_ENTITY';\n  if (step.mutationKind) {\n    return step.mutationKind;\n  }\n  if (step.operationKind === OPERATION_KINDS.FORMULA_FIELD_UPDATE) return 'UPDATE_FORMULA_FIELD';\n  if (step.operationKind === OPERATION_KINDS.FORMULA_EXPRESSION_UPDATE) return 'UPDATE_FORMULA_EXPRESSION';\n  if (step.operationKind === OPERATION_KINDS.RATE_DIMENSION_INPUT_EXPRESSION_UPDATE) return 'UPDATE_RATE_DIMENSION_INPUT_EXPRESSION';\n  if (step.operationKind === OPERATION_KINDS.RATE_TABLE_METADATA_UPDATE) return 'UPDATE_RATE_TABLE_METADATA';\n  if (step.operationKind === OPERATION_KINDS.RATE_DIMENSION_METADATA_UPDATE) return 'UPDATE_RATE_DIMENSION_METADATA';\n  if (step.operationKind === OPERATION_KINDS.RATE_DIMENSION_VALUES_UPDATE) return 'UPDATE_RATE_DIMENSION_VALUES';\n  if (step.operationKind === OPERATION_KINDS.RATE_VALUE_UPDATE) return 'UPDATE_RATE_VALUE';\n  if (step.operationKind === OPERATION_KINDS.TABULAR_TABLE_REPLACEMENT) return 'REPLACE_TABULAR_TABLE';\n  if (step.operationKind === OPERATION_KINDS.ADD_COMPONENT) return 'ADD_COMPONENT';\n  if (step.operationKind === OPERATION_KINDS.ADD_MEASURE) return 'ADD_MEASURE';\n  if (step.operationKind === OPERATION_KINDS.ADD_SCORECARD) return 'ADD_SCORECARD';\n  if (step.operationKind === OPERATION_KINDS.ADD_RATE_TABLE) return 'ADD_RATE_TABLE';\n  if (step.operationKind === OPERATION_KINDS.REMOVE_COMPONENT) return 'REMOVE_COMPONENT';\n  if (step.operationKind === OPERATION_KINDS.REMOVE_MEASURE) return 'REMOVE_MEASURE';\n  if (step.operationKind === OPERATION_KINDS.REMOVE_SCORECARD) return 'REMOVE_SCORECARD';\n  if (step.operationKind === OPERATION_KINDS.REMOVE_RATE_TABLE) return 'REMOVE_RATE_TABLE';\n  if (step.operationKind === OPERATION_KINDS.SCALAR_FIELD_UPDATE) {\n    return mutationKindForScalarTarget(target && target.targetKind);\n  }\n  return '';\n}\n\nfunction validateBriefTargets(brief, planIndex) {\n  if (!Array.isArray(brief.targets) || brief.targets.length === 0) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.CLARIFY,\n      reason: 'Which exact plan item should I update?',\n    };\n  }\n  const resolvedTargets = [];\n  for (let idx = 0; idx < brief.targets.length; idx += 1) {\n    const resolved = resolveTarget(planIndex, brief.targets[idx]);\n    if (resolved.status !== BATCH_STATUSES.APPLIED) {\n      return {\n        ok: false,\n        status: resolved.status,\n        reason: resolved.reason,\n      };\n    }\n    resolvedTargets.push(resolved);\n  }\n  return {\n    ok: true,\n    resolvedTargets,\n  };\n}\n\nfunction validateDependencyRefs(brief, planIndex, localRefTargets) {\n  for (let idx = 0; idx < brief.dependencyRefs.length; idx += 1) {\n    const dependencyRef = brief.dependencyRefs[idx];\n    const localTarget = localRefDependencyTarget(localRefTargets, dependencyRef);\n    if (localTarget) {\n      const localValidation = validateLocalRefDependencyRef(dependencyRef, localTarget);\n      if (!localValidation.ok) {\n        return localValidation;\n      }\n      continue;\n    }\n    const resolved = resolveTarget(planIndex, dependencyRef);\n    if (resolved.status !== BATCH_STATUSES.APPLIED) {\n      return {\n        ok: false,\n        status: resolved.status,\n        reason: 'I could not verify one of the edit dependency references: ' + resolved.reason,\n      };\n    }\n  }\n  return {\n    ok: true,\n  };\n}\n\nfunction validateApplyBrief(brief, planIndex, request) {\n  if (\n    !brief.route &&\n    brief.operationKind &&\n    Array.isArray(brief.targets) &&\n    brief.targets.length > 0 &&\n    Array.isArray(brief.orderedSteps) &&\n    brief.orderedSteps.length > 0\n  ) {\n    brief.route = ROUTES.DECISION_PLANNER;\n  }\n  if (!brief.route) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.BLOCKED,\n      reason: 'The apply brief omitted an execution route.',\n    };\n  }\n  if (!brief.operationKind) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.BLOCKED,\n      reason: 'The apply brief omitted an operation kind.',\n    };\n  }\n  if (!Array.isArray(brief.orderedSteps) || brief.orderedSteps.length === 0) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.CLARIFY,\n      reason: 'I need the exact edit step before I can update the plan.',\n    };\n  }\n  const turnIntentCompatibility = validateTurnIntentCompatibility(brief, request);\n  if (!turnIntentCompatibility.ok) {\n    return turnIntentCompatibility;\n  }\n  const implicitTargetValidation = completeImplicitStepTargets(brief, planIndex);\n  if (!implicitTargetValidation.ok) {\n    return implicitTargetValidation;\n  }\n  const targetValidation = validateBriefTargets(brief, planIndex);\n  if (!targetValidation.ok) {\n    return targetValidation;\n  }\n  const localRefTargets = {};\n  for (let idx = 0; idx < brief.orderedSteps.length; idx += 1) {\n    const step = brief.orderedSteps[idx];\n    step.operationKind = step.operationKind || brief.operationKind;\n    const target = targetForStep(brief, step, localRefTargets);\n    if (!target) {\n      return {\n        ok: false,\n        status: BATCH_STATUSES.BLOCKED,\n        reason: 'The ordered step did not tie to an exact existing target or prior constructor localRef.',\n      };\n    }\n    if (!isStepAllowed(brief, step)) {\n      return {\n        ok: false,\n        status: BATCH_STATUSES.BLOCKED,\n        reason: 'The ordered step is outside its allowed changes.',\n      };\n    }\n    if (isStepForbidden(brief, step)) {\n      return {\n        ok: false,\n        status: BATCH_STATUSES.BLOCKED,\n        reason: 'The ordered step touched a forbidden change.',\n      };\n    }\n    const formulaTargetValidation = validateFormulaExpressionTarget(step, target);\n    if (!formulaTargetValidation.ok) {\n      return formulaTargetValidation;\n    }\n    const redefineRateDimensionValidation = validateRateDimensionRedefinitionStep(step, target);\n    if (!redefineRateDimensionValidation.ok) {\n      return redefineRateDimensionValidation;\n    }\n    const renameValidation = validateRenameAuthorityStep(step);\n    if (!renameValidation.ok) {\n      return renameValidation;\n    }\n    const constructorValidation = validateConstructorAuthorityStep(step, target);\n    if (!constructorValidation.ok) {\n      return constructorValidation;\n    }\n    const removeValidation = validateRemoveAuthorityStep(step, target);\n    if (!removeValidation.ok) {\n      return removeValidation;\n    }\n    const localRefValidation = validateConstructorLocalRefStep(brief, step, localRefTargets);\n    if (!localRefValidation.ok) {\n      return localRefValidation;\n    }\n  }\n  const acceptedRecommendationValidation = validateAcceptedRecommendationResolvedFacts(brief);\n  if (!acceptedRecommendationValidation.ok) {\n    return acceptedRecommendationValidation;\n  }\n  const dependencyValidation = validateDependencyRefs(brief, planIndex, localRefTargets);\n  if (!dependencyValidation.ok) {\n    return dependencyValidation;\n  }\n  if (brief.route !== ROUTES.DECISION_PLANNER) {\n    return {\n      ok: false,\n      status: BATCH_STATUSES.BLOCKED,\n      reason: 'Mutating apply decisions must use route decisionPlanner.',\n    };\n  }\n  for (let idx = 0; idx < brief.orderedSteps.length; idx += 1) {\n    const step = brief.orderedSteps[idx];\n    if (draftKindFromStep(step, targetForStep(brief, step, localRefTargets)) === '') {\n      return {\n        ok: false,\n        status: BATCH_STATUSES.BLOCKED,\n        reason: 'That planned edit capability is not enabled in existing-entity editor authority.',\n      };\n    }\n    if (\n      step.operationKind === OPERATION_KINDS.FORMULA_EXPRESSION_UPDATE ||\n      step.operationKind === OPERATION_KINDS.RATE_DIMENSION_INPUT_EXPRESSION_UPDATE\n    ) {\n      const expressionShape = validateExpressionStep(step);\n      if (!expressionShape.ok) {\n        return {\n          ok: false,\n          status: BATCH_STATUSES.BLOCKED,\n          reason: expressionShape.reason,\n        };\n      }\n    }\n  }\n  return {\n    ok: true,\n    resolvedTargets: targetValidation.resolvedTargets,\n  };\n}\n\nfunction buildBrainAuthority(input, brief, planIndex) {\n  return {\n    request: input.userMessage || '',\n    editBrief: brief,\n    targetContext: brief.targets,\n    dependencyRefs: brief.dependencyRefs,\n    orderedSteps: brief.orderedSteps,\n    allowedChanges: brief.allowedChanges,\n    forbiddenChanges: brief.forbiddenChanges,\n    instructionPacks: brief.instructionPacks || [],\n    responseFacts: brief.responseFacts || {},\n    planIndex: planIndex || null,\n  };\n}\n\nfunction finalizeBrainMutations(input, brief) {\n  const plan = input.plan || {};\n  const planIndex = buildPlanIndex(plan);\n  const authority = buildBrainAuthority(input || {}, brief, planIndex);\n  const compiled = compileBrainDraftMutations(authority, plan, planIndex);\n  if (!compiled.ok) {\n    const status = compiled.status || BATCH_STATUSES.BLOCKED;\n    return makeBatchResult({\n      status,\n      operation: 'EDIT',\n      reply: compiled.reason,\n      blocked: [{ reason: compiled.reason }],\n      metadata: composerMetadata({\n        request: authority.request,\n        status,\n        reason: compiled.reason,\n        responseFacts: authority.responseFacts,\n      }),\n    });\n  }\n\n  const catalogContext = buildCatalogContext(input.catalogContext || {});\n  const batch = finalizeDraftMutationBatch({\n    draftMutations: compiled.mutations,\n    plan: input.plan || {},\n    catalogContext,\n    userMessage: authority.request,\n    dispatchMutation: ({ draft, plan, planIndex, catalogContext: currentCatalogContext, idRegistry }) => (\n      dispatchHorizontalMutation(draft, plan, planIndex, currentCatalogContext, idRegistry)\n    ),\n    decorateFinalized: ({ finalized }) => attachBrainResolverAuthority(finalized, compiled.mutations, authority),\n    validateBatch: ({ finalized, plan, stagedPlan }) => {\n      enrichTabularBatchWithDerivedRows(finalized, plan || {});\n      const tabularConsistency = validateTabularBatchConsistency(finalized, plan || {});\n      if (!tabularConsistency.ok) {\n        return {\n          ok: false,\n          status: BATCH_STATUSES.BLOCKED,\n          blocked: [tabularConsistency.blocked],\n          reason: tabularConsistency.blocked && tabularConsistency.blocked.reason,\n        };\n      }\n      const numericGrounding = validateCurrentTurnNumericGrounding(finalized, authority.request);\n      if (!numericGrounding.ok) {\n        return {\n          ok: false,\n          status: BATCH_STATUSES.BLOCKED,\n          blocked: [numericGrounding.blocked],\n          reason: numericGrounding.blocked && numericGrounding.blocked.reason,\n        };\n      }\n      const finalReferences = validateFinalRemovedReferences(stagedPlan || {}, finalized);\n      if (!finalReferences.ok) {\n        return {\n          ok: false,\n          status: BATCH_STATUSES.BLOCKED,\n          blocked: [{\n            ...(finalReferences.blocked || {}),\n            reason: finalReferences.reason,\n          }],\n          reason: finalReferences.reason,\n        };\n      }\n      return { ok: true };\n    },\n  });\n  if (batch.status !== BATCH_STATUSES.APPLIED) {\n    const reason = batch.blocked && batch.blocked[0]\n      ? batch.blocked[0].reason\n      : 'The edit intent could not be safely finalized.';\n    const responseFacts = responseFactsForBlockedBatch(authority.responseFacts, batch.blocked || []);\n    return makeBatchResult({\n      status: batch.status,\n      operation: 'EDIT',\n      reply: reason,\n      blocked: batch.blocked || [],\n      metadata: composerMetadata({\n        request: authority.request,\n        status: batch.status,\n        reason,\n        responseFacts,\n      }),\n    });\n  }\n  return makeBatchResult({\n    status: BATCH_STATUSES.APPLIED,\n    operation: 'EDIT',\n    applied: batch.finalized,\n    dirtyScopes: batch.dirtyScopes,\n    metadata: {\n      ...batch.metadata,\n      brainOnly: true,\n      brainRoute: ROUTES.DECISION_PLANNER,\n      responseFacts: authority.responseFacts,\n      compiledMutationCount: compiled.mutations.length,\n    },\n  });\n}\n\nfunction finalizeBrainDecision(input) {\n  const brainOutput = isPlainObject(input && input.brainOutput) ? input.brainOutput : {};\n  const prohibited = findProhibitedContractKey(brainOutput, []);\n  if (prohibited) {\n    return contractFailure('The decision output included a forbidden mutation or expression artifact field: ' + prohibited + '.', brainOutput.responseFacts);\n  }\n  const registryStyleOperation = findRegistryStyleOperationKind(brainOutput, []);\n  if (registryStyleOperation) {\n    return contractFailure(\n      'The decision output included a registry-style operation kind instead of an enabled lower-camel operation kind: ' + registryStyleOperation + '.',\n      brainOutput.responseFacts\n    );\n  }\n\n  let decision = normalizeDecision(brainOutput.decision || brainOutput.intent);\n  const responseFacts = isPlainObject(brainOutput.responseFacts) ? brainOutput.responseFacts : {};\n  if (!decision && hasApplyPayload(brainOutput)) {\n    decision = DECISIONS.APPLY;\n  }\n  if (!decision) {\n    return contractFailure('The decision output did not include a supported decision.', responseFacts);\n  }\n\n  if (decision === DECISIONS.ANSWER) {\n    const answer = isPlainObject(brainOutput.answer) ? brainOutput.answer : {};\n    const text = trimText(answer.text || brainOutput.reply || brainOutput.answerText);\n    if (!text) {\n      return contractFailure('The answer decision did not include answer text.', responseFacts);\n    }\n    return makeBatchResult({\n      status: BATCH_STATUSES.ANSWER,\n      operation: 'ANSWER',\n      reply: text,\n      metadata: {\n        brainOnly: true,\n        answerFacts: answer.groundedFacts || responseFacts.groundedFacts || [],\n      },\n    });\n  }\n\n  if (decision === DECISIONS.CLARIFY) {\n    const clarify = isPlainObject(brainOutput.clarification) ? brainOutput.clarification : {};\n    const reason = trimText(clarify.question || brainOutput.reply || 'I need one more detail before I can update the plan.');\n    return makeBatchResult({\n      status: BATCH_STATUSES.CLARIFY,\n      operation: 'EDIT',\n      reply: reason,\n      blocked: [{ reason }],\n      metadata: composerMetadata({\n        request: input.userMessage,\n        status: BATCH_STATUSES.CLARIFY,\n        reason,\n        responseFacts: {\n          ...responseFacts,\n          missingFacts: clarify.missingFacts || responseFacts.missingFacts || [],\n          ambiguousFacts: clarify.ambiguousFacts || responseFacts.ambiguousFacts || [],\n          nextAction: clarify.nextAction || responseFacts.nextAction || '',\n        },\n      }),\n    });\n  }\n\n  if (decision === DECISIONS.BLOCK) {\n    const block = isPlainObject(brainOutput.block) ? brainOutput.block : {};\n    const reason = trimText(block.reason || brainOutput.reply || 'That capability is not enabled in edit-decision authority.');\n    return makeBatchResult({\n      status: BATCH_STATUSES.BLOCKED,\n      operation: 'EDIT',\n      reply: reason,\n      blocked: [{ reason }],\n      metadata: composerMetadata({\n        request: input.userMessage,\n        status: BATCH_STATUSES.BLOCKED,\n        reason,\n        responseFacts: {\n          ...responseFacts,\n          unsupportedCapabilities: block.unsupportedCapabilities || responseFacts.unsupportedCapabilities || [],\n          nextAction: block.nextAction || responseFacts.nextAction || '',\n        },\n      }),\n    });\n  }\n\n  if (isPlainObject(brainOutput.editBrief) || isPlainObject(brainOutput.applyBrief)) {\n    return contractFailure('Apply decisions must use compact changes, editView, entityDraft, or remove output.', responseFacts);\n  }\n  const compiledEditView = compileBrainEditViewOutput(brainOutput);\n  if (!compiledEditView.ok) {\n    return contractFailure(compiledEditView.reason, responseFacts);\n  }\n  const brief = normalizeBrief(compiledEditView.editBrief);\n  const planIndex = buildPlanIndex(input.plan || {});\n  const briefValidation = validateApplyBrief(brief, planIndex, input.userMessage || '');\n  if (!briefValidation.ok) {\n    const status = briefValidation.status || BATCH_STATUSES.BLOCKED;\n    return makeBatchResult({\n      status,\n      operation: 'EDIT',\n      reply: briefValidation.reason,\n      blocked: [{ reason: briefValidation.reason }],\n      metadata: composerMetadata({\n        request: input.userMessage,\n        status,\n        reason: briefValidation.reason,\n        responseFacts: brief.responseFacts,\n      }),\n    });\n  }\n\n  return finalizeBrainMutations(input, brief);\n}\n\nfunction stepById(authority, stepId) {\n  const steps = authority && Array.isArray(authority.orderedSteps) ? authority.orderedSteps : [];\n  for (let idx = 0; idx < steps.length; idx += 1) {\n    if (steps[idx].id === stepId) {\n      return steps[idx];\n    }\n  }\n  return null;\n}\n\nfunction authorityStepIndex(authority, step) {\n  const steps = authority && Array.isArray(authority.orderedSteps) ? authority.orderedSteps : [];\n  const stepId = trimText(step && step.id);\n  for (let idx = 0; idx < steps.length; idx += 1) {\n    if (trimText(steps[idx] && steps[idx].id) === stepId) {\n      return idx;\n    }\n  }\n  return -1;\n}\n\nfunction authorityLocalRefTargetByRef(authority, targetRef, step) {\n  const ref = trimText(targetRef);\n  if (!ref) {\n    return null;\n  }\n  const steps = authority && Array.isArray(authority.orderedSteps) ? authority.orderedSteps : [];\n  const stepIndex = authorityStepIndex(authority, step);\n  const end = stepIndex >= 0 ? stepIndex : steps.length;\n  for (let idx = 0; idx < end; idx += 1) {\n    const priorStep = steps[idx] || {};\n    if (trimText(priorStep.localRef) === ref) {\n      return localRefTargetForStep(priorStep);\n    }\n  }\n  return null;\n}\n\nfunction authorityTargetByRef(authority, targetRef, step) {\n  const targets = authority && Array.isArray(authority.targetContext) ? authority.targetContext : [];\n  const ref = trimText(targetRef);\n  for (let idx = 0; idx < targets.length; idx += 1) {\n    const target = normalizeTargetRef(targets[idx]);\n    if (target.refId === ref) {\n      return target;\n    }\n  }\n  return authorityLocalRefTargetByRef(authority, ref, step);\n}\n\nfunction normalizeExpressionReferenceText(value) {\n  return trimText(value).replace(/\\s+/g, ' ').toLowerCase();\n}\n\nfunction expressionMentionsNamedReference(expressionText, prefix, name) {\n  const normalizedExpression = normalizeExpressionReferenceText(expressionText);\n  const normalizedName = normalizeExpressionReferenceText(name);\n  if (!normalizedExpression || !normalizedName) {\n    return false;\n  }\n  return normalizedExpression.indexOf(prefix + normalizedName + '.') !== -1;\n}\n\nfunction targetRefFromIndexEntry(entry) {\n  if (!entry) {\n    return null;\n  }\n  return normalizeTargetRef({\n    targetKind: entry.targetKind,\n    id: entry.id || null,\n    name: entry.name || null,\n    owner: entry.owner || {},\n  });\n}\n\nfunction appendUniqueDependencyRef(refs, ref) {\n  if (!ref || !ref.targetKind) {\n    return;\n  }\n  const key = [\n    ref.targetKind,\n    ref.id || '',\n    normalizeExpressionReferenceText(ref.name || ''),\n    normalizeExpressionReferenceText(ref.owner && ref.owner.componentName),\n  ].join('|');\n  for (let idx = 0; idx < refs.length; idx += 1) {\n    const existing = normalizeTargetRef(refs[idx]);\n    const existingKey = [\n      existing.targetKind,\n      existing.id || '',\n      normalizeExpressionReferenceText(existing.name || ''),\n      normalizeExpressionReferenceText(existing.owner && existing.owner.componentName),\n    ].join('|');\n    if (existingKey === key) {\n      return;\n    }\n  }\n  refs.push(ref);\n}\n\nfunction inferExpressionDependencyRefs(authority, draftMutation) {\n  const expressionText = trimText(draftMutation && draftMutation.payload && draftMutation.payload.expressionText);\n  const planIndex = authority && authority.planIndex;\n  if (!expressionText || !planIndex || !planIndex.byKind) {\n    return [];\n  }\n\n  const inferred = [];\n  const measures = Array.isArray(planIndex.byKind.measure) ? planIndex.byKind.measure : [];\n  for (let idx = 0; idx < measures.length; idx += 1) {\n    const measure = measures[idx] || {};\n    if (expressionMentionsNamedReference(expressionText, 'measure result.', measure.name)) {\n      appendUniqueDependencyRef(inferred, targetRefFromIndexEntry(measure));\n    }\n  }\n\n  const components = Array.isArray(planIndex.byKind.component) ? planIndex.byKind.component : [];\n  for (let idx = 0; idx < components.length; idx += 1) {\n    const component = components[idx] || {};\n    if (expressionMentionsNamedReference(expressionText, 'plan component result.', component.name)) {\n      appendUniqueDependencyRef(inferred, targetRefFromIndexEntry(component));\n    }\n  }\n\n  return inferred;\n}\n\nfunction allowedPayloadFieldsForStep(authority, step) {\n  const fields = {};\n  const allowed = authority && Array.isArray(authority.allowedChanges) ? authority.allowedChanges : [];\n  for (let idx = 0; idx < allowed.length; idx += 1) {\n    const rule = allowed[idx] || {};\n    const operationMatches = !rule.operationKind || rule.operationKind === step.operationKind;\n    const targetMatches = matchesAllowedScope(rule.targetRef, step.targetRef);\n    if (!operationMatches || !targetMatches) {\n      continue;\n    }\n    const ruleFields = allowedFieldsForOperation(rule, step.operationKind);\n    for (let fieldIdx = 0; fieldIdx < ruleFields.length; fieldIdx += 1) {\n      fields[ruleFields[fieldIdx]] = true;\n    }\n  }\n  return fields;\n}\n\nfunction allowedAddComponentFieldForPayloadKey(key, allowedFields) {\n  if (key === 'userExplicitPlaceholder') {\n    return true;\n  }\n  if (\n    key === 'componentName' ||\n    key === 'componentType' ||\n    key === 'incentiveType' ||\n    key === 'description' ||\n    key === 'startDate' ||\n    key === 'endDate' ||\n    key === 'targetIncentivePercent' ||\n    key === 'splitOption' ||\n    key === 'formulaName' ||\n    key === 'formulaExpressionText' ||\n    key === 'expressionText' ||\n    key === 'status' ||\n    key === 'reviewNotes'\n  ) {\n    return allowedFields.planComponents === true || allowedFields[key] === true;\n  }\n  return allowedFields[key] === true;\n}\n\nfunction allowedAddMeasureFieldForPayloadKey(key, allowedFields) {\n  if (key === 'userExplicitPlaceholder') {\n    return true;\n  }\n  if (key === 'formulaName' || key === 'formulaExpressionText' || key === 'expressionText') {\n    return allowedFields.performanceMeasures === true || allowedFields.formula === true;\n  }\n  if (\n    key === 'measureName' ||\n    key === 'description' ||\n    key === 'startDate' ||\n    key === 'endDate' ||\n    key === 'unitOfMeasure' ||\n    key === 'processTransaction' ||\n    key === 'performanceInterval' ||\n    key === 'creditCategories' ||\n    key === 'splitOption' ||\n    key === 'runningTotalFlag' ||\n    key === 'status' ||\n    key === 'reviewNotes'\n  ) {\n    return allowedFields.performanceMeasures === true || allowedFields[key] === true;\n  }\n  return allowedFields[key] === true;\n}\n\nfunction allowedAddScorecardFieldForPayloadKey(key, allowedFields) {\n  if (key === 'userExplicitPlaceholder') {\n    return true;\n  }\n  if (\n    key === 'scorecardName' ||\n    key === 'rateTableName' ||\n    key === 'rateTableType' ||\n    key === 'description' ||\n    key === 'startDate' ||\n    key === 'endDate' ||\n    key === 'dimensions' ||\n    key === 'rateValues' ||\n    key === 'status' ||\n    key === 'reviewNotes'\n  ) {\n    return allowedFields.scorecards === true;\n  }\n  if (key === 'updateFormulaToRtr') {\n    return allowedFields['formula.expression'] === true;\n  }\n  return false;\n}\n\nfunction allowedAddRateTableFieldForPayloadKey(key, allowedFields) {\n  if (key === 'userExplicitPlaceholder') {\n    return true;\n  }\n  if (\n    key === 'rateTableName' ||\n    key === 'rateTableType' ||\n    key === 'description' ||\n    key === 'startDate' ||\n    key === 'endDate' ||\n    key === 'dimensions' ||\n    key === 'rateValues' ||\n    key === 'status' ||\n    key === 'reviewNotes'\n  ) {\n    return allowedFields.rateTables === true;\n  }\n  if (key === 'updateFormulaToRtr') {\n    return allowedFields['formula.expression'] === true;\n  }\n  return false;\n}\n\n\nfunction setPayloadField(payload, field, value) {\n  if (value !== undefined) {\n    payload[field] = clone(value);\n  }\n}\n\nfunction copyStepFields(payload, step, fields) {\n  for (let idx = 0; idx < fields.length; idx += 1) {\n    const field = fields[idx];\n    if (hasOwn(step, field)) {\n      setPayloadField(payload, field, step[field]);\n    }\n  }\n}\n\nfunction isMatrixTableLike(value) {\n  return isPlainObject(value) &&\n    isPlainObject(value.x) &&\n    Array.isArray(value.rates);\n}\n\nfunction normalizeTabularStepTable(step) {\n  const table = isMatrixTableLike(step.table) ? step.table : null;\n  if (!table) {\n    return null;\n  }\n  const flat = tabularMatrixToFlatTable(table);\n  return flat.ok ? flat.table : null;\n}\n\nfunction applyConstructorTabularTablePayload(payload, step) {\n  const table = normalizeTabularStepTable(step);\n  if (!table || !isPlainObject(table)) {\n    return;\n  }\n  if (table.rateTableType !== undefined && payload.rateTableType === undefined) {\n    payload.rateTableType = clone(table.rateTableType);\n  }\n  if (Array.isArray(table.dimensions)) {\n    payload.dimensions = clone(table.dimensions);\n  }\n  if (Array.isArray(table.rateValues)) {\n    payload.rateValues = clone(table.rateValues);\n  } else if (Array.isArray(table.rows)) {\n    payload.rateValues = clone(table.rows);\n  }\n}\n\nfunction brainPayloadForStep(step, kind) {\n  const payload = {};\n  if (kind === 'RENAME_ENTITY') {\n    payload.newName = trimText(step.newName || step.value);\n    return payload;\n  }\n  if (\n    kind === 'UPDATE_PLAN_FIELD' ||\n    kind === 'UPDATE_COMPONENT_FIELD' ||\n    kind === 'UPDATE_MEASURE_FIELD' ||\n    kind === 'UPDATE_FORMULA_FIELD' ||\n    kind === 'UPDATE_RATE_TABLE_METADATA' ||\n    kind === 'UPDATE_RATE_DIMENSION_METADATA'\n  ) {\n    payload.field = step.field;\n    payload.value = clone(step.value);\n    return payload;\n  }\n  if (kind === 'UPDATE_FORMULA_EXPRESSION' || kind === 'UPDATE_RATE_DIMENSION_INPUT_EXPRESSION') {\n    const replacementText = trimText(step.expressionText) || trimText(step.value);\n    if (replacementText) {\n      payload.expressionText = replacementText;\n    }\n    if (trimText(step.editInstruction)) {\n      payload.editInstruction = trimText(step.editInstruction);\n    }\n    return payload;\n  }\n  if (kind === 'UPDATE_RATE_DIMENSION_VALUES') {\n    if (Array.isArray(step.values)) {\n      payload.values = clone(step.values);\n    } else if (Array.isArray(step.value)) {\n      payload.values = clone(step.value);\n    }\n    if (Array.isArray(step.tiers)) {\n      payload.tiers = clone(step.tiers);\n    }\n    return payload;\n  }\n  if (kind === 'U