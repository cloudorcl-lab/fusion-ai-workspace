        {
          "id": "2",
          "code": "PREPARE_CATALOG_INPUTS",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Catalog Inputs",
            "returnType": "object",
            "sourceCode": "var fullPlanRaw = $context.$variables.fullPlan;\nvar explicitOrgId = $context.$variables.orgId;\nvar explicitOrgCatalogRaw = $context.$variables.orgCatalog;\n\nvar parseMaybeJson = function(value) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n  if (typeof value !== 'string') {\n    return value;\n  }\n  if (String(value).trim() === '' || String(value).trim() === 'null') {\n    return null;\n  }\n  try {\n    return JSON.parse(value);\n  } catch (_err) {\n    return null;\n  }\n};\n\nvar isNonEmptyObject = function(value) {\n  return !!(value && typeof value === 'object' && Object.keys(value).length > 0);\n};\n\nvar serializeCatalog = function(value, originalRaw) {\n  if (!isNonEmptyObject(value)) {\n    return null;\n  }\n  if (typeof originalRaw === 'string' && String(originalRaw).trim() !== '') {\n    return originalRaw;\n  }\n  return JSON.stringify(value);\n};\n\nvar fullPlan = parseMaybeJson(fullPlanRaw);\nvar explicitOrgCatalog = parseMaybeJson(explicitOrgCatalogRaw);\nvar embeddedOrgCatalog = fullPlan &&\n  fullPlan.metadata &&\n  typeof fullPlan.metadata === 'object' &&\n  fullPlan.metadata.orgCatalog\n    ? fullPlan.metadata.orgCatalog\n    : null;\nvar hasEmbeddedCatalog = isNonEmptyObject(embeddedOrgCatalog);\nvar normalizedOrgCatalog = serializeCatalog(explicitOrgCatalog, explicitOrgCatalogRaw) ||\n  serializeCatalog(embeddedOrgCatalog, null);\n\nvar result = new Object();\nresult.orgId = explicitOrgId !== undefined && explicitOrgId !== null && String(explicitOrgId).trim() !== ''\n  ? explicitOrgId\n  : (fullPlan && fullPlan.compensationPlan && fullPlan.compensationPlan.orgId !== undefined ? fullPlan.compensationPlan.orgId : null);\nresult.businessUnitName = fullPlan && fullPlan.compensationPlan && fullPlan.compensationPlan.businessUnit\n  ? String(fullPlan.compensationPlan.businessUnit)\n  : null;\nresult.orgCatalog = normalizedOrgCatalog;\nresult.hasEmbeddedCatalog = hasEmbeddedCatalog;\nresult.hasAvailableCatalog = normalizedOrgCatalog !== null;\n\nreturn result;"
          },
          "outcomes": {
            "success": "3"
          },
          "inputs": [],
          "diagram": {
            "x": 5225,
            "y": 5468
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
