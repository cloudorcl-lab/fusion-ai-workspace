          }
        },
        {
          "id": "59",
          "code": "APPLY_RESPONSE_COMPOSER_OUTPUT",
          "type": "CODE",
          "metadata": {
            "name": "Apply Response Composer Output",
            "returnType": "object",
            "sourceCode": "// APPLY_RESPONSE_COMPOSER_OUTPUT - Merge non-happy composed text into response.\n\nvar baseResponseRaw = $context.$nodes.APPLY_PLAN_EDITS\n  ? $context.$nodes.APPLY_PLAN_EDITS.$output.result\n  : null;\nvar composerRaw = $context.$nodes.RESPONSE_COMPOSER\n  ? $context.$nodes.RESPONSE_COMPOSER.$output\n  : null;\n\nvar parseMaybeJson = function(value) {\n  if (value === null || value === undefined || value === '') {\n    return null;\n  }\n  if (typeof value !== 'string') {\n    return value;\n  }\n  try {\n    return JSON.parse(value);\n  } catch (_err) {\n    return null;\n  }\n};\n\nvar response = parseMaybeJson(baseResponseRaw);\nif (!response || typeof response !== 'object') {\n  return typeof baseResponseRaw === 'string' ? baseResponseRaw : JSON.stringify(new Object());\n}\n\nvar composer = parseMaybeJson(composerRaw);\nvar text = '';\nif (composer && typeof composer === 'object') {\n  text = composer.text || composer.reply || composer.response || '';\n} else if (typeof composerRaw === 'string') {\n  text = composerRaw;\n}\n\ntext = String(text || '').replace(/^\\s+|\\s+$/g, '');\nif (text) {\n  response.reply = text;\n  response.userResponse = text;\n  if (!response.metadata || typeof response.metadata !== 'object') {\n    response.metadata = new Object();\n  }\n  response.metadata.responseComposed = true;\n  if (response.envelope && typeof response.envelope === 'object') {\n    response.envelope.userResponse = text;\n  }\n}\n\nreturn JSON.stringify(response);"
          },
          "outcomes": {
            "success": "18"
          },
          "inputs": [],
          "diagram": {
            "x": 5000,
            "y": 14082
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "60",
          "code": "DECISION_PLANNER",
          "type": "LLM",
          "metadata": {
            "name": "Decision Planner",
            "reasoningEffort": "medium",
            "chatHistoryEnabled": false
          },
          "outcomes": {
            "success": "61"
          },
          "inputs": [
            {
              "id": "60_prompt",
              "name": "prompt",
              "type": "string",
              "value": "You are the IC Plan Editor Decision Planner for existing-plan edits and constructor creation.\n\nReturn one JSON object only. Do not use markdown.\n\n## Trust Boundary\n\nYou own business understanding. Decide `answer`, `clarify`, `block`, or `apply`.\n\nReturn only business-facing decisions and compact business-facing changes. Do not include generated plan internals, executable formula tokens, expression mappings, resolver details, implementation instructions, plan-internal JSON objects, or lifecycle implementation details. Code and downstream validators own those artifacts.\n\nIntent classification comes first. If the user is only asking for business guidance, evaluation, options, consequences, or a recommendation and has not supplied or authorized a concrete plan change, return `answer` using grounded plan facts. If the same message supplies enough facts for a supported edit, constructor, removal, or replacement, evaluate the plan-change rules and return `apply` when the change is fully grounded. Do not turn an otherwise complete supported plan change into `clarify` merely to confirm a single safe interpretation.\n\nFor plan questions that do not authorize a change, answer directly from grounded plan facts. Answers must not describe a plan update. Put the `answer`, `clarification`, or `block` object at the top level beside `decision` and `responseFacts`; do not nest those decision objects inside `responseFacts`.\n\nUse compact business-facing output. For requests that apply a plan change, return `decision: \"apply\"` and a `changes` array. Each item in `changes` is one compact change: `kind: \"edit\"` with an `editView`, `kind: \"create\"` with an `entityDraft`, or `kind: \"remove\"` with an exact current target. Code turns these compact changes into plan JSON mechanics.\n\nPrecheck findings describe the current plan state. Do not block a requested scalar or rename edit solely because a current precheck finding reports the old value. Only treat precheck as a conflict for the requested new value when the finding or supplied catalog facts explicitly identify that exact requested value as invalid or duplicate.\n\n## Enabled Capabilities\n\nExisting-plan editing supports updates to existing entities through edit changes, new-entity creation through create changes, and safe draft removals for exact current component/measure/scorecard/rate-table targets. Represent new entities only as compact business drafts, not as implementation instructions.\n\nSupported target kinds: `plan`, `component`, `measure`, `formula`, `rateTable`, `scorecard`, `rateDimension`.\n\nEnabled compact change kinds: `edit`, `create`, and `remove`. Use a create change with `entityDraft` for new entities.\n\nAll plan changes are authored as compact changes. There is no alternate change-authoring path.\n\nStable IDs are mandatory for editable, removable, and constructor parent targets whenever the provided context has an ID. Copy the exact ID from Overall plan context or Current context details into every existing target and existing dependency ref. Names are display labels and ambiguity evidence only; never rely on names as existing-object identity. If a required existing target, constructor parent, or dependency lacks an ID in the provided context, return `clarify` or `block` rather than asking code to match by name. If Active UI context reports `staleOrMissing`, duplicate names, or ambiguous matches for the requested target, return `clarify` unless the user message and current context identify one exact current target with a stable ID.\n\nTreat Active UI context as a scoped root, not only as the directly edited object. Use Current context details to resolve relative references to included descendants and owners. If the user refers to a descendant kind and the active scope contains exactly one matching entity of that kind, that descendant is the grounded target. If the active scope contains multiple matching descendants and the user does not identify one, return `clarify`. Component scope intentionally carries compressed child measure and scorecard metadata without full tabular matrices; use it for target disambiguation. Use full tabular details only when Current context details exposes the selected measure, scorecard, or rate table table.\n\nSetup catalog facts are authority for lookup-backed setup fields. Use exact catalog codes from the value lists in Setup catalog facts, using lookup metadata meaning/description to map user wording to the code. Emit only the code, never a natural-language variant. If more than one catalog value remains plausible, return `clarify`. Examples: user wording like grouped, group, aggregate, or grouped amount maps to processTransaction code `GROUP` when that code is present; individual, each transaction, or per transaction maps to `INDIVIDUAL` when that code is present.\n\nThe expression resolver owns final formula parsing, function validation, tokenization, mappings, catalog vocabulary, and canonical expression artifacts. Do not require the decision planner to prove parser-level expression validity before applying a clear supported edit or constructor.\n\nRename authority is semantic, not scalar. Any request to change an entity name, display label, or title should be represented as a compact edit of that entity's name field in the appropriate overview view. This includes `planName`, `componentName`, `measureName`, `formulaName`, `rateTableName`, `scorecardName`, and `dimensionName`. Do not model a rename as a generic description or unrelated metadata change.\n\n`dependencyRefs` are authoritative. For expression edits, list every named component, measure, rate table, scorecard, or rate dimension that the target expression should reference. Do not ask the resolver to discover business dependencies outside this list.\n\n## Tabular Lookup Domain\n\nUse tabular lookup as the shared domain shape for scorecards and component rate tables. Resolve the target kind from plan metadata and ownership, not from the noun the user chose:\n- A scorecard is owned by a measure, and formula wiring targets the measure formula.\n- A rate table is owned by a component, and formula wiring targets the component formula.\n\nThe decision planner owns the business table shape: target role from ownership; catalog-backed `rateTableType` from the requested lookup behavior; each axis dimension's name, catalog-backed dimension type/unit, plain input expression, user-visible value labels, and numeric rate grid. Scorecards and rate tables share the same matrix schema: `x` is the first dimension, optional `y` is the second dimension, and `rates` contains numeric outputs. Business words such as score, points, rate, payout, table, matrix, schedule, or scorecard help understand intent, but they do not change the target kind or row field. Do not put source measure, component, scorecard, or rate table names in `unitOfMeasure`; wording such as \"using X output\" identifies the axis `inputExpression`. When the referenced measure has a grounded unit, use that unit for the axis; otherwise return `clarify`.\n\nUse this canonical matrix shape for new tabular constructors and full tabular replacements:\n- For existing table replacements, put the complete table in `editView.desiredView`.\n- For constructor scorecards or rate tables, put the same table fields in the compact scorecard/rate-table draft. A nested draft may either put `rateTableType`, `x`, `y`, and `rates` directly on the draft, or inside `draft.table`.\n- `rateTableType` is required for complete executable tabular constructors and should be preserved for existing replacements.\n- `table.x` must describe the first dimension. `table.y` describes the optional second dimension. Do not emit more than two dimensions.\n- Each axis object must use `dimensionName`, `dimensionType`, `unitOfMeasure`, `inputExpression`, and `values`. `unitOfMeasure` must be a supported unit such as `Amount`, `Percent`, `Quantity`, `Score`, `String`, or `Expression`, or the referenced measure's grounded unit; never put the referenced measure name, result label, or input expression text in `unitOfMeasure`. For an axis using a measure output whose measure unit is Amount, emit `unitOfMeasure: \"Amount\"` and put the measure output reference only in `inputExpression`. For range bands, emit `dimensionType: \"RANGE\"` and use interval labels such as `\"0 - 5000\"` in `values`; do not emit endpoint-only arrays such as `[\"0\", \"5000\", \"999999\"]`. `values` must be an array of user-visible string labels, not objects with min/max/label fields.\n- For one-dimensional tables, `table.rates` must be a flat numeric array ordered exactly like `table.x.values`.\n- For two-dimensional tables, `table.rates` must be a numeric matrix whose outer rows are ordered exactly like `table.x.values` and whose inner columns are ordered exactly like `table.y.values`.\n- For `rateTableType` `PERCENT`, keep row `rate` values in percentage-point scale as stated by the user. Do not convert percent values to decimal fractions.\n- `startDate` and `endDate` are optional for scorecard and rate table constructors when the request creates a single tabular lookup for the parent measure or component. If the user does not provide table dates in that single-table case, omit table dates rather than clarifying for them.\n\nDo not make tier internals, generated IDs, numeric breakpoints, coordinate references, or formula artifacts the representation of a tabular lookup. For every existing scorecard or rate table content edit, use a `TABULAR_TABLE` `editView` when the desired final table can be produced from the active tabular context and the user request. Table content edits include changing one cell rate, changing multiple rates, adding values, removing values, splitting values, combining values, replacing dimension value sets, and reshaping a one- or two-dimensional grid. This replaces the business table as a whole: include `x`, optional `y`, and the complete `rates` array or matrix in the desired final table, preserving unchanged axes and rate positions. Explicit rates supplied by the user are authoritative for the matching final positions; copy those rates exactly before preserving any unchanged or unspecified positions. Preservation never overrides an explicit rate. For partial existing-table rate edits, copy the current rates first and change only matched positions; match each target by all stated axis values. Use the selected table's `matrixOrientation` in Current context details: in 2D, rows are `x`, columns are `y`, and each cell is `rates[xIndex][yIndex]`. A single-cell request must change exactly one rate. Do not emit tier IDs, coordinate references, generated IDs, tokens, object-keyed row coordinates, or plan-internal table details. New tabular constructors require the full grounded matrix table in `entityDraft.draft` or nested scorecard/rate-table draft. Do not infer dimensions, bands, input expressions, rates, output semantics, or formula wiring from the parent object unless the user explicitly requested that copy. If the final table cannot be produced from grounded context and the user request, return `clarify`.\n\n## Existing-Entity Edit Authority\n\nUse existing-entity edit views only for exact current plan targets. These views update current objects; they do not create new objects.\n\n- For existing scalar/static edits on plan, component, or measure overview fields, use `editView` with `viewType` `PLAN_OVERVIEW`, `COMPONENT_OVERVIEW`, or `MEASURE_OVERVIEW`. Put only changed fields in `desiredView`; omitted fields are preserved.\n- For existing formula edits, use `editView` with `viewType: \"FORMULA\"`. Put formula metadata fields such as `payoutFrequency` in `desiredView`; put replacement formula logic in `desiredView.expressionText`. The resolver owns tokens, mappings, display text, and referenced-rate-table metadata.\n- For existing rate-table or scorecard metadata edits, use `editView` with `viewType` `RATE_TABLE_OVERVIEW` or `SCORECARD_OVERVIEW`. Put only changed metadata fields in `desiredView`; use `TABULAR_TABLE` when the request changes dimensions, values, input expressions, or rates.\n- For existing rate-dimension metadata edits, use `editView` with `viewType: \"RATE_DIMENSION_OVERVIEW\"` only for metadata such as `dimensionType`, `unitOfMeasure`, `splitFlag`, or `accumulateFlag`. If the request changes dimension values, rates, or table content together with an axis input expression, represent the final business table with `TABULAR_TABLE`. If the request only changes the lookup-driver expression, keep it as an input-expression edit rather than metadata.\n- For existing scorecard or rate table content edits, use `editView` with `viewType: \"TABULAR_TABLE\"` and put the complete final compact matrix table in `desiredView`. Structural table edits are full table replacements. Do not emit tier IDs, coordinate references, generated IDs, tokens, object-keyed row coordinates, or plan-internal table details.\n- Each `editView.target` must include exact current target identity: `entityType`, stable `entityId`, `name`, and `owner` when provided by Current context details.\n- Current context details shows current compact views for the scoped UI target. When an applicable current edit view is present, copy its `target` into `editView.target`. For scalar views, return only changed fields from that view's `editableFields`. For tabular views, use its `currentView` as the preservation base and return the complete final compact matrix table.\n- Do not use `editView` for constructor creation, removals, or broad component subtree replacement in this phase.\n- For any request to change a name, display label, or title, put the name field in the relevant overview `desiredView`. Do not hide a rename inside a description or unrelated metadata field.\n- Scalar/static field updates: use the exact non-name field exposed in the current overview edit view on the exact existing target. Do not require a scenario-specific instruction when the requested field is present in Current context details.\n- Collection-valued static fields are full-field replacements. When the user changes one goal, role, or credit category, emit the complete final collection and preserve unchanged items from grounded context.\n- Do not use scalar/static updates for generated IDs, names, expression internals, table dimensions/values/rates, child collections, confidence/provenance fields, or error/status internals not exposed in Current context details.\n- Expression-bearing edit views must include exactly one of `expressionText` for replacement logic or `editInstruction` for transforming the current expression.\n- Formula expression edits apply to any exact formula target in Current context details, including component payout formulas under `planComponents[].formulas[]` and measure formulas under `planComponents[].performanceMeasures[].formula`.\n- A single formula expression may reference another component, measure result, or component result. That is still one supported formula edit when the requested change edits only the exact target formula expression.\n- When the user supplies exact or pasted IC-style formula text with wording such as set exactly to, use this formula, replace with this formula, or quoted formula text, copy that replacement formula text into `expressionText`. Do not paraphrase it as `editInstruction`, do not emit tokens, and do not convert it into expression-resolution details. The expression resolver will parse and validate the text before apply.\n- A rate-dimension input-expression edit applies only to the expression that feeds an exact existing rate dimension. Do not use it for row, tier, band, cell, coordinate, or rate value changes.\n- When Active UI scoped entities contain one exact rate table or scorecard and the user says first, second, third, or nth input expression, map that ordinal to the scoped rate dimension by `dimensionSequence` or list order, then target that exact `rateDimension`. Use `expressionText` for replacement text and `editInstruction` only for transformations such as multiply the current input expression by 100.\n- Use a `TABULAR_TABLE` edit view for existing scorecard or rate table content changes, including axes, dimension values, cells, rates, and grids. Use metadata overview views only for metadata that does not change the table content. Use a rate-dimension overview edit only for a pure lookup-driver expression edit. When one request changes table content and an axis input expression together, use `TABULAR_TABLE` and put the new `inputExpression` on that axis in the full matrix table.\n- Current context details may include the selected rate table or scorecard with dimensions and rows. If that table contains one exact row or coordinate match for the user's requested bands/list values, treat the row as grounded; do not ask for internal row IDs merely because IDs are absent.\n- If the request does not provide enough detail to identify an existing target, rows, coordinates, replacement bands, replacement values, or expression logic, return `clarify`.\n- Preserve unrelated rows, dimensions, and fields.\n\n## Lifecycle And Replacement Authority\n\nUse lifecycle and replacement authority generically. You own the business decision to answer, clarify, block, or apply; deterministic code owns validation and actual draft plan application.\n\n- Draft removal is enabled only with a compact remove change targeting one exact current component, measure, scorecard, or rate table. Do not include generated IDs beyond the stable target ID, lifecycle implementation details, live delete details, temporal lifecycle fields, ordered remove instructions, or internal validation details.\n- Removal changes must include `target` with `entityType`, stable `entityId`, `name`, and `owner` when provided by Current context details.\n- Before applying a removal or delete-plus-add replacement, use Dependency graph facts to decide whether the user has supplied the missing business decision: dependencies to rewire, owner formula lookup replacement, target identity, new object facts, and whether removal is intended. If anything important is unclear, return `clarify` for the whole request.\n- Preserve identity when the user is changing the behavior of the same object: use compact edit views such as formula edits, tabular table edits, metadata edits, or constructor-owned formula wiring. Do not remove and recreate the object merely because the user said replace, convert, swap, or change.\n- Delete-plus-add replacement is not compactly supported in this phase. If the user explicitly wants a new identity and removal of the old object in one request, return `clarify` or `block` unless the request can be safely decomposed into a single supported compact edit or constructor.\n- Conversion-shaped requests are not special-cased. If the user supplies complete target-state details, express the result as a normal `editView` or `entityDraft`. If the conversion also requires removal, reparenting, or dependency rewiring that is not compactly expressible, return `clarify`.\n- Broad advice, what-if analysis, recommendations, or lifecycle explanations are `answer` decisions when grounded plan facts are available. Do not create a plan-change response for advice, and do not convert advice into an edit clarification unless the user authorizes applying a concrete plan change.\n- Permission, safety, feasibility, and consequence questions do not apply a change even when they name a supported edit. Questions like \"Can I remove X?\", \"Should I remove X?\", \"Is it safe to remove X?\", and \"What happens if I remove X?\" must return `answer`, `clarify`, or `block` with no plan change. Apply changes only after an imperative or explicit confirmation such as \"Remove X\", \"Do it\", \"Ok, remove it\", or \"Yes, apply that change\".\n- Unsupported lifecycle families still block or clarify: live IC REST delete, unlink, move, reparent, end-date-as-delete, deactivate, temporal replacement, split, merge, broad reorganization, copy-from-template, and standalone formula creation.\n\n## Composite Batch Authority\n\nUse multiple compact `changes` only when each change is independently supported and fully grounded. Constructor drafts, existing edit views, and remove changes remain distinct. Do not convert an existing edit into a constructor, or a constructor into an existing edit, just to keep the request together.\n\nOrder changes in the dependency order the plan must observe. If any requested part is unsupported, ambiguous, unlink/move/reparent/temporal lifecycle/out-of-scope, or otherwise not safely grounded, return `block` or `clarify` for the whole request; do not emit a partial apply.\n\n## Constructor Authority\n\nConstructor drafts describe new entities under exact existing parents. A component draft may include requested child measures and component rate tables; a measure draft may include requested child scorecards. Constructors are separate from existing-entity edits.\n\nShared constructor rules:\n- Always use `entityDraft` for constructor creation. The decision planner owns constructor intent, exact parent selection, domain classification, catalog-backed setup classification, formula-wiring intent, and the decision to answer, clarify, block, or apply. Deterministic code owns structural IDs, plan-internal shape, rate-dimensional input construction, formula coupling shape, expression staging, owner validation, and atomic apply.\n- Never emit constructor implementation instructions, internal action names, constructor implementation objects, plan-internal objects, generated IDs, sequence numbers, formula targets, rate-dimensional input objects, expression tokens, mappings, expression-resolution details, compiled expressions, or canonical expression internals.\n- `entityDraft.entityType` must be one of `component`, `measure`, `scorecard`, or `rateTable`.\n- `entityDraft.target` is the exact existing parent: plan for a component, component for a measure or rate table, and measure for a scorecard. Include `entityType`, stable `entityId`, `name`, and `owner` when provided.\n- `entityDraft.draft` contains compact business facts. For a component, use `name`, `componentType`, `incentiveType`, optional overview fields, optional payout formula logic as `formulaText` or `expressionText`, and optional `measures`, `payoutTable`, or `rateTables`. For a measure, use `name`, setup fields, `creditCategories`, and plain formula logic as `formulaText` or `expressionText`. For scorecards and rate tables, use `name`, `rateTableType`, optional metadata fields, `x`, optional `y`, and `rates`.\n- Nested component drafts may include child measure drafts and component-level `payoutTable` or `rateTables`. Nested measure drafts may include child `scorecard` or `scorecards`. If a scorecard belongs to a measure being created in the same request, nest that scorecard under the new measure draft instead of targeting a guessed future ID. Do not use nested plan-internal JSON objects; keep each child a compact draft.\n- Put grounded setup and domain facts directly on the compact draft: `componentType`, `incentiveType`, `unitOfMeasure`, `processTransaction`, `performanceInterval`, `creditCategories`, plain `expressionText` or `formulaText`, and the complete matrix fields for scorecards and rate tables.\n- Use `updateFormulaToRtr: true` only on a scorecard or rate-table draft when the user explicitly says the created tabular lookup should drive or replace the owner formula through RTR; omit it when wiring is absent or false. For a direct formula such as \"pay 6 percent of X output\", prefer a component or measure formula expression when that is the requested behavior rather than inventing a tabular lookup.\n- Required facts must be grounded in the user request, accepted clarification/recommendation, plan context, setup metadata, or catalog facts. Classify setup facts from the stated requirements when the meaning is clear and catalog-backed. If multiple catalog values remain plausible or the classification depends on an unstated assumption, return `clarify`.\n- For constructed measures, ordinary business wording is enough when it maps unambiguously to catalog-backed setup fields: \"amount measure\" means `unitOfMeasure: \"AMOUNT\"` when that code is present; \"percent measure\" means `unitOfMeasure: \"PERCENT\"` when present; \"grouped\" means `processTransaction: \"GROUP\"` when present; \"individual\" or \"per transaction\" means `processTransaction: \"INDIVIDUAL\"` when present. If the user omits `performanceInterval`, use the parent component's only grounded sibling measure interval when all sibling measures share one interval; otherwise return `clarify`.\n- Use Current time only to ground explicitly relative date requests into concrete `YYYY-MM-DD` constructor date facts. If the request names a fiscal period, calendar period, quarter, half, or other period label and the exact start/end dates are not supplied by context, return `clarify`; do not emit period labels as date fields.\n- Do not inherit parent dates, formulas, incentive settings, credit categories, rates, bands, tabular output semantics, or formula wiring unless the user explicitly requested that copy.\n- Normal constructor drafts create complete `DRAFT` objects and must not include `reviewNotes` or `userExplicitPlaceholder`. Only use `status: \"NEEDS_REVIEW\"`, `reviewNotes`, and `userExplicitPlaceholder: true` when the user explicitly asks for an incomplete draft, placeholder, sketch, or review item. Placeholder objects may omit required executable setup facts, but they must remain non-executable. Placeholder measures must not create executable formula logic. Placeholder scorecards and rate tables must not set `updateFormulaToRtr` and must not wire into formula behavior.\n- For scorecard and rate table constructors, clarify by default if the target owner already has that tabular lookup. Do not create additional effective-dated scorecards or rate tables in this iteration.\n- Existing formula expression edits are only for an exact existing formula target from Current context details. Do not use them for constructor formula logic. For a constructed measure, put plain formula logic on that measure draft as `expressionText` or `formulaText`. For a constructed component payout formula, put direct payout formula logic on the component draft as `expressionText` or `formulaText`; use `payoutTable` or `rateTables` with explicit RTR wiring when the user requested a lookup schedule.\n- Duplicate-name findings for the existing source plan or current sibling entities do not prove that newly requested names collide. If the user supplies clearly new names and those exact names are not present in Overall plan context or current context, do not block on duplicate-name precheck noise for existing source-plan objects.\n- If required target, name, setup facts, formula logic, tabular lookup shape, or wiring intent are missing or unclear, return `clarify`.\n- If the request asks for a new standalone formula, copy-from-template, unsupported lifecycle action, or multi-object creation that cannot be represented as compact `changes`, return `block` for this slice.\n\n## Hard Blocks\n\nAlways return `block` for:\n- Any request to output internal create instructions instead of an `entityDraft` inside a create change.\n- Any live delete, deprecate, end-date-as-delete, deactivate, temporal replacement, unlink, move, reparent, split-entity, merge-entity, or lifecycle request outside the enabled draft remove changes.\n- Any replacement or conversion request that is missing target identity, formula logic, tabular axes, input expressions, rate matrix values, or dependency handling needed to express it as normal compact changes.\n- Any request that requires constructor internals, lifecycle implementation internals, expression-resolution internals, expression tokens, expression mappings, canonical expression internals, or direct implementation artifacts.\n- Any target outside `plan`, `component`, `measure`, `formula`, `rateTable`, `scorecard`, or `rateDimension`.\n\nThe block reason must say no plan change was applied and identify the unsupported constructor, lifecycle, expression-resolution, or out-of-scope capability.\n\n## Canonical Compact Change Patterns\n\n- Existing edits use `kind: \"edit\"` and an `editView`. Put view-specific target identity in `editView.target` and only the requested final business-facing fields in `editView.desiredView`.\n- Constructor creation uses `kind: \"create\"` and an `entityDraft`. Put parent identity in `entityDraft.target` and compact business facts in `entityDraft.draft`.\n- Removals use `kind: \"remove\"` and a `target`. The target must be one exact current component, measure, scorecard, or rate table with `entityType`, stable `entityId`, `name`, and `owner` when provided.\n- Do not emit implementation instructions, internal action names, allow/deny lists, generated IDs, validation fields, expression artifacts, or plan-internal details.\n\n## Input\n\nUser message:\n`{{$context.$variables.userMessage}}`\n\nCurrent time:\n`{{$context.$variables.currentDateTime}}`\n\nEditor conversation history:\n`{{$context.$variables.editorConversationHistory}}`\n\nFollow-up references:\nResolve follow-up, pronoun, and short acceptance references only from the current user message, Editor conversation history, Active UI context, Current context details, Overall plan context, Dependency graph facts, Precheck findings, or visible prior response metadata. Editor conversation history is a curated transcript of prior editor turns for this conversation, not a source of current plan state. Use it to understand references such as \"that\", \"do it\", or \"the previous change\"; Current context details, Overall plan context, and Precheck findings remain authoritative for the current plan. For \"previous message\" questions, answer from Editor conversation history and exclude the current user message. Do not infer a plan change from old conversation payloads unless the current message clearly accepts one exact pending recommendation and the context guards still match.\n\nRecommendation acceptance:\n- When a request is genuinely missing required business facts but has exactly one concrete safe recommendation the user could accept, return `clarify` and put `responseFacts.pendingRecommendation` on the response. Do not use a pending recommendation when the same compact changes already contain every required grounded fact for a supported `apply`. Keep it sparse and business-facing: `summary`, `targets`, `proposedChanges`, `assumptions`, and `contextGuards`.\n- `pendingRecommendation.proposedChanges` are compact business changes only. They must not include generated IDs, expression-resolution details, plan-internal details, implementation instructions, or formula/token internals.\n- `contextGuards` are context checks: they must name the exact current-plan targets or absence/presence checks that must remain true before a later acceptance can apply.\n- If the current message is a short acceptance such as \"yes\", \"do that\", or \"go ahead\", apply only when visible prior response metadata contains exactly one pending recommendation, its context checks still match the current Overall plan context and Current context details, and every required constructor or edit fact is fully resolved. Emit a normal compact `apply` output and include `responseFacts.acceptedRecommendation` with the accepted recommendation summary/id.\n- Do not carry missing-value placeholder text into `pendingRecommendation.proposedChanges` or an accepted `apply`. If required facts remain unresolved after acceptance, return `clarify` and ask for those facts.\n- If acceptance could refer to multiple recommendations, the prior recommendation cannot be recovered, or any context check is stale, return `clarify`.\n\nOverall plan context:\n`{{$context.$variables.overallPlanContext}}`\n\nDependency graph facts:\n`{{$context.$variables.dependencyGraphFacts}}`\n\nCurrent context details:\n`{{$context.$variables.currentContextDetails}}`\n\nActive UI context:\n`{{$context.$variables.activeUiContext}}`\n\nSetup catalog facts:\n`{{$context.$variables.setupCatalogFacts}}`\n\nField label aliases:\n`{{$context.$variables.fieldAliasContext}}`\n\nPrecheck findings:\n`{{$context.$variables.precheckSummary}}`\n\n## Output\n\nAlways include:\n- `decision`: `answer`, `clarify`, `block`, or `apply`\n- `responseFacts`: structured grounded facts\n\nFor `answer`, include:\n- `answer.text`\n- `answer.groundedFacts`\n\nFor `clarify`, include:\n- `clarification.question`\n- `clarification.missingFacts`\n- `clarification.ambiguousFacts`\n- `clarification.nextAction`\n- optional `responseFacts.pendingRecommendation` only when the user can accept one concrete recommendation later\n\nFor `block`, include:\n- `block.reason`\n- `block.unsupportedCapabilities`\n- `block.nextAction`\n\nFor `apply`, include:\n- `changes`: non-empty array of compact changes in dependency order\n- Existing scalar/formula/metadata/table edits:\n  - change item: `{ \"kind\": \"edit\", \"editView\": { ... } }`\n  - `editView.viewType`: `PLAN_OVERVIEW`, `COMPONENT_OVERVIEW`, `MEASURE_OVERVIEW`, `FORMULA`, `RATE_TABLE_OVERVIEW`, `SCORECARD_OVERVIEW`, `RATE_DIMENSION_OVERVIEW`, or `TABULAR_TABLE`\n  - `editView.target`: exact current-plan ref with `entityType`, `entityId`, `name`, and `owner`\n  - `editView.desiredView`: sparse changed fields for overview/formula/metadata edits, or complete compact matrix table for tabular content\n- Constructor creation:\n  - change item: `{ \"kind\": \"create\", \"entityDraft\": { ... } }`\n  - `entityDraft.entityType`: `component`, `measure`, `scorecard`, or `rateTable`\n  - `entityDraft.target`: exact existing parent ref with `entityType`, `entityId`, `name`, and `owner`\n  - `entityDraft.draft`: compact business-facing constructor draft; use nested compact `measures`, `scorecard`, `payoutTable`, or `rateTables` only when those children are part of the requested new slice\n  - `entityDraft.dependencyRefs`: exact refs for named dependencies, or `[]`\n- Removal:\n  - change item: `{ \"kind\": \"remove\", \"target\": { ... } }`\n  - `target`: exact current component, measure, scorecard, or rate table with `entityType`, stable `entityId`, `name`, and `owner`\n- when applying a prior accepted recommendation, include the accepted recommendation details in top-level `responseFacts.acceptedRecommendation`\n\nUse exact IDs from Overall plan context and Current context details. If the target or dependency is ambiguous, return `clarify`. If the requested capability is outside enabled existing-plan editing, return `block`."
            }
          ],
          "diagram": {
            "x": 5000,
            "y": 14302
          },
          "outputSpecification": "{\"$schema\": \"http://json-schema.org/draft-07/schema#\", \"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"decision\": {\"type\": \"string\", \"enum\": [\"answer\", \"clarify\", \"block\", \"apply\"]}, \"answer\": {\"type\": [\"object\", \"null\"], \"additionalProperties\": true, \"properties\": {\"text\": {\"type\": \"string\"}, \"groundedFacts\": {\"type\": \"array\", \"items\": {\"type\": [\"object\", \"string\"]}}}}, \"clarification\": {\"type\": [\"object\", \"null\"], \"additionalProperties\": true, \"properties\": {\"question\": {\"type\": \"string\"}, \"missingFacts\": {\"type\": \"array\", \"items\": {\"type\": [\"object\", \"string\"]}}, \"ambiguousFacts\": {\"type\": \"array\", \"items\": {\"type\": [\"object\", \"string\"]}}, \"nextAction\": {\"type\": \"string\"}}}, \"block\": {\"type\": [\"object\", \"null\"], \"additionalProperties\": true, \"properties\": {\"reason\": {\"type\": \"string\"}, \"unsupportedCapabilities\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"nextAction\": {\"type\": \"string\"}}}, \"changes\": {\"type\": [\"array\", \"null\"], \"description\": \"Compact apply changes. Each item has kind edit, create, or remove.\", \"items\": {\"type\": \"object\", \"additionalProperties\": true, \"properties\": {\"kind\": {\"type\": \"string\", \"enum\": [\"edit\", \"create\", \"remove\"]}, \"editView\": {\"type\": \"object\", \"additionalProperties\": true}, \"entityDraft\": {\"type\": \"object\", \"additionalProperties\": true}, \"target\": {\"type\": \"object\", \"additionalProperties\": true}, \"responseFacts\": {\"type\": \"object\"}}, \"required\": [\"kind\"]}}, \"responseFacts\": {\"type\": \"object\"}}, \"required\": [\"decision\", \"responseFacts\"]}"
        },
        {
          "id": "61",
          "code": "FINALIZE_EDIT_DECISION",
          "type": "CODE",
          "metadata": {
            "name": "Finalize Edit Decision",
            "returnType": "object",
            "sourceCode": "var __ic_planIndex = (function() {\nfunction normalizeText(value) {\n  return String(value || '').trim().replace(/\\s+/g, ' ').toLowerCase();\n}\n\nfunction addIndexEntry(index, entry) {\n  index.all.push(entry);\n  if (!index.byKind[entry.targetKind]) {\n    index.byKind[entry.targetKind] = [];\n  }\n  index.byKind[entry.targetKind].push(entry);\n  if (entry.id) {\n    index.byId[entry.targetKind + ':' + String(entry.id)] = entry;\n  }\n  const nameKey = normalizeText(entry.name);\n  if (nameKey) {\n    const scopedKey = entry.targetKind + ':' + nameKey;\n    if (!index.byName[scopedKey]) {\n      index.byName[scopedKey] = [];\n    }\n    index.byName[scopedKey].push(entry);\n  }\n}\n\nfunction firstPresentId(entity, fields) {\n  for (let idx = 0; idx < fields.length; idx += 1) {\n    const value = entity && entity[fields[idx]];\n    if (value !== undefined && value !== null && String(value) !== '') {\n      return {\n        field: fields[idx],\n        value: String(value),\n      };\n    }\n  }\n  return null;\n}\n\nfunction buildPlanIndex(plan) {\n  const index = {\n    all: [],\n    byKind: {},\n    byId: {},\n    byName: {},\n  };\n\n  const compensationPlan = plan && plan.compensationPlan && typeof plan.compensationPlan === 'object'\n    ? plan.compensationPlan\n    : {};\n  const planMetadata = plan && plan.metadata && typeof plan.metadata === 'object'\n    ? plan.metadata\n    : {};\n  let planId = firstPresentId(compensationPlan, ['planId', 'compensationPlanId']);\n  let planIdPath = ['compensationPlan'];\n  if (!planId) {\n    planId = firstPresentId(planMetadata, ['planId', 'compensationPlanId']);\n    planIdPath = ['metadata'];\n  }\n  addIndexEntry(index, {\n    targetKind: 'plan',\n    id: planId ? planId.value : null,\n    idField: planId ? planId.field : 'planName',\n    idPath: planId ? planIdPath : ['compensationPlan'],\n    name: compensationPlan.planName || '',\n    nameField: 'planName',\n    path: ['compensationPlan'],\n    owner: {},\n  });\n\n  const components = plan && plan.planComponents && plan.planComponents.length !== undefined\n    ? plan.planComponents\n    : [];\n\n  for (let c = 0; c < components.length; c += 1) {\n    const component = components[c] || {};\n    const componentId = firstPresentId(component, ['componentId']);\n    addIndexEntry(index, {\n      targetKind: 'component',\n      id: componentId ? componentId.value : null,\n      idField: componentId ? componentId.field : 'componentName',\n      name: component.componentName || '',\n      nameField: 'componentName',\n      path: ['planComponents', c],\n      owner: {},\n    });\n\n    const measures = component.performanceMeasures && component.performanceMeasures.length !== undefined\n      ? component.performanceMeasures\n      : [];\n    for (let m = 0; m < measures.length; m += 1) {\n      const measure = measures[m] || {};\n      const measureId = firstPresentId(measure, ['measureId', 'performanceMeasureId']);\n      addIndexEntry(index, {\n        targetKind: 'measure',\n        id: measureId ? measureId.value : null,\n        idField: measureId ? measureId.field : 'measureName',\n        name: measure.measureName || '',\n        nameField: 'measureName',\n        path: ['planComponents', c, 'performanceMeasures', m],\n        owner: {\n          componentId: componentId ? componentId.value : null,\n          componentName: component.componentName || '',\n        },\n      });\n\n      if (measure.formula && typeof measure.formula === 'object') {\n        const measureFormula = measure.formula;\n        const measureFormulaId = firstPresentId(measureFormula, ['formulaId']);\n        addIndexEntry(index, {\n          targetKind: 'formula',\n          id: measureFormulaId ? measureFormulaId.value : null,\n          idField: measureFormulaId ? measureFormulaId.field : 'formulaName',\n          name: measureFormula.formulaName || '',\n          nameField: 'formulaName',\n          path: ['planComponents', c, 'performanceMeasures', m, 'formula'],\n          owner: {\n            componentId: componentId ? componentId.value : null,\n            componentName: component.componentName || '',\n            measureId: measureId ? measureId.value : null,\n            measureName: measure.measureName || '',\n          },\n        });\n      }\n\n      const scorecards = measure.scorecards && measure.scorecards.length !== undefined\n        ? measure.scorecards\n        : [];\n      for (let s = 0; s < scorecards.length; s += 1) {\n        const scorecard = scorecards[s] || {};\n        const scorecardId = firstPresentId(scorecard, ['scorecardId', 'rateTableId']);\n        addIndexEntry(index, {\n          targetKind: 'scorecard',\n          id: scorecardId ? scorecardId.value : null,\n          idField: scorecardId ? scorecardId.field : 'rateTableName',\n          name: scorecard.rateTableName || scorecard.scorecardName || '',\n          nameField: scorecard.rateTableName !== undefined ? 'rateTableName' : 'scorecardName',\n          path: ['planComponents', c, 'performanceMeasures', m, 'scorecards', s],\n          owner: {\n            componentId: componentId ? componentId.value : null,\n            componentName: component.componentName || '',\n            measureId: measureId ? measureId.value : null,\n            measureName: measure.measureName || '',\n          },\n        });\n        indexDimensions(index, scorecard.dimensions, ['planComponents', c, 'performanceMeasures', m, 'scorecards', s, 'dimensions'], {\n          componentId: componentId ? componentId.value : null,\n          componentName: component.componentName || '',\n          measureId: measureId ? measureId.value : null,\n          measureName: measure.measureName || '',\n          scorecardId: scorecard.scorecardId || null,\n          rateTableId: scorecard.rateTableId || null,\n          rateTableName: scorecard.rateTableName || scorecard.scorecardName || '',\n        });\n      }\n    }\n\n    const formulas = component.formulas && component.formulas.length !== undefined\n      ? component.formulas\n      : [];\n    for (let f = 0; f < formulas.length; f += 1) {\n      const formula = formulas[f] || {};\n      const formulaId = firstPresentId(formula, ['formulaId']);\n      addIndexEntry(index, {\n        targetKind: 'formula',\n        id: formulaId ? formulaId.value : null,\n        idField: formulaId ? formulaId.field : 'formulaName',\n        name: formula.formulaName || '',\n        nameField: 'formulaName',\n        path: ['planComponents', c, 'formulas', f],\n        owner: {\n          componentId: componentId ? componentId.value : null,\n          componentName: component.componentName || '',\n        },\n      });\n    }\n\n    const rateTables = component.rateTables && component.rateTables.length !== undefined\n      ? component.rateTables\n      : [];\n    for (let r = 0; r < rateTables.length; r += 1) {\n      const rateTable = rateTables[r] || {};\n      const rateTableId = firstPresentId(rateTable, ['rateTableId']);\n      addIndexEntry(index, {\n        targetKind: 'rateTable',\n        id: rateTableId ? rateTableId.value : null,\n        idField: rateTableId ? rateTableId.field : 'rateTableName',\n        name: rateTable.rateTableName || '',\n        nameField: 'rateTableName',\n        path: ['planComponents', c, 'rateTables', r],\n        owner: {\n          componentId: componentId ? componentId.value : null,\n          componentName: component.componentName || '',\n        },\n      });\n      indexDimensions(index, rateTable.dimensions, ['planComponents', c, 'rateTables', r, 'dimensions'], {\n        componentId: componentId ? componentId.value : null,\n        componentName: component.componentName || '',\n        rateTableId: rateTableId ? rateTableId.value : null,\n        rateTableName: rateTable.rateTableName || '',\n      });\n    }\n  }\n\n  return index;\n}\n\nfunction indexDimensions(index, dimensions, parentPath, owner) {\n  const rows = dimensions && dimensions.length !== undefined ? dimensions : [];\n  for (let d = 0; d < rows.length; d += 1) {\n    const dimension = rows[d] || {};\n    const dimensionId = firstPresentId(dimension, ['dimensionId', 'rateDimensionId']);\n    addIndexEntry(index, {\n      targetKind: 'rateDimension',\n      id: dimensionId ? dimensionId.value : null,\n      idField: dimensionId ? dimensionId.field : 'dimensionName',\n      name: dimension.dimensionName || '',\n      nameField: 'dimensionName',\n      path: parentPath.concat([d]),\n      owner: {\n        ...owner,\n        dimensionSequence: dimension.dimensionSequence || dimension.sequence || d + 1,\n      },\n    });\n  }\n}\n\nfunction ownerMatches(entry, target) {\n  if (!target || !target.owner) {\n    return true;\n  }\n  const owner = target.owner || {};\n  const entryOwner = entry.owner || {};\n  const fields = ['componentId', 'componentName', 'measureId', 'measureName', 'rateTableId', 'rateTableName', 'scorecardId'];\n  for (let idx = 0; idx < fields.length; idx += 1) {\n    const field = fields[idx];\n    if (owner[field] !== undefined && owner[field] !== null && String(owner[field]) !== '') {\n      if (normalizeText(entryOwner[field]) !== normalizeText(owner[field])) {\n        return false;\n      }\n    }\n  }\n  return true;\n}\n\nfunction resolveByName(index, kind, target) {\n  const name = normalizeText(target.name || target.targetName);\n  if (!name) {\n    return null;\n  }\n\n  const matches = (index.byName[kind + ':' + name] || []).filter((entry) => ownerMatches(entry, target));\n  if (matches.length === 1) {\n    return {\n      status: 'RESOLVED',\n      entry: matches[0],\n    };\n  }\n  if (matches.length > 1) {\n    return {\n      status: 'CLARIFY',\n      reason: 'I found more than one ' + kind + ' named ' + (target.name || target.targetName) + '. Which one should I rename?',\n    };\n  }\n  return null;\n}\n\nfunction resolveIndexedTarget(index, target) {\n  const kind = target && target.targetKind ? String(target.targetKind) : '';\n  if (!kind) {\n    return {\n      status: 'BLOCKED',\n      reason: 'Missing target kind.',\n    };\n  }\n\n  if (target.id !== undefined && target.id !== null && String(target.id) !== '') {\n    const byId = index.byId[kind + ':' + String(target.id)];\n    if (byId) {\n      return {\n        status: 'RESOLVED',\n        entry: byId,\n      };\n    }\n    const byName = resolveByName(index, kind, target);\n    if (byName) {\n      return byName;\n    }\n    return {\n      status: 'BLOCKED',\n      reason: 'I could not find the requested ' + kind + ' by its stable ID.',\n    };\n  }\n\n  const name = normalizeText(target.name || target.targetName);\n  if (!name) {\n    return {\n      status: 'CLARIFY',\n      reason: 'Which ' + kind + ' should I rename?',\n    };\n  }\n\n  const byName = resolveByName(index, kind, target);\n  if (byName) {\n    return byName;\n  }\n  return {\n    status: 'BLOCKED',\n    reason: 'I could not find a ' + kind + ' named ' + (target.name || target.targetName) + '.',\n  };\n}\nreturn {\nbuildPlanIndex,\n  normalizeText,\n  resolveIndexedTarget,\n};\n})();\nvar __ic_contracts = (function() {\nconst BATCH_STATUSES = Object.freeze({\n  APPLIED: 'APPLIED',\n  BLOCKED: 'BLOCKED',\n  CLARIFY: 'CLARIFY',\n  ANSWER: 'ANSWER',\n  ERROR: 'ERROR',\n});\n\nfunction makeResponseEnvelope(overrides = {}) {\n  return {\n    userResponse: overrides.userResponse || '',\n    updatedPlan: overrides.updatedPlan || null,\n    changes: overrides.changes || [],\n    precheck: overrides.precheck || null,\n    debug: {\n      status: overrides.status || BATCH_STATUSES.ERROR,\n      dirtyScopes: overrides.dirtyScopes || [],\n    },\n  };\n}\n\nfunction makeBatchResult(overrides = {}) {\n  return {\n    status: overrides.status || BATCH_STATUSES.ERROR,\n    updatedPlan: overrides.updatedPlan || null,\n    changes: overrides.changes || [],\n    applied: overrides.applied || [],\n    deferred: overrides.deferred || [],\n    blocked: overrides.blocked || [],\n    dirtyScopes: overrides.dirtyScopes || [],\n    ledger: overrides.ledger || [],\n    reply: overrides.reply || '',\n    operation: overrides.operation || 'ERROR',\n    metadata: overrides.metadata || {},\n  };\n}\nreturn {\nBATCH_STATUSES,\n  makeBatchResult,\n  makeResponseEnvelope,\n};\n})();\nvar __ic_finalizeCore = (function() {\nvar { BATCH_STATUSES, makeBatchResult } = __ic_contracts;\nvar { normalizeText, resolveIndexedTarget } = __ic_planIndex;\n\nfunction normalizeOperation(value) {\n  const operation = String(value || '').toUpperCase();\n  if (operation === 'EDIT' || operation === 'ANSWER' || operation === 'CLARIFY' || operation === 'ERROR' || operation === 'CREATE_PLAN') {\n    return operation;\n  }\n  if (operation === 'ADD' || operation === 'DELETE') {\n    return operation;\n  }\n  return 'ERROR';\n}\n\nfunction normalizeTargetKind(value) {\n  const raw = String(value || '').trim();\n  const lowered = raw.toLowerCase();\n  if (lowered === 'ratetable' || lowered === 'rate_table' || lowered === 'payoutschedule' || lowered === 'payout_schedule') {\n    return 'rateTable';\n  }\n  if (lowered === 'ratedimension' || lowered === 'rate_dimension' || lowered === 'dimension') {\n    return 'rateDimension';\n  }\n  if (lowered === 'performance_measure' || lowered === 'performancemeasure') {\n    return 'measure';\n  }\n  if (lowered === 'plan_component' || lowered === 'plancomponent') {\n    return 'component';\n  }\n  return raw;\n}\n\nfunction clone(value) {\n  if (value === null || value === undefined) {\n    return value;\n  }\n  return JSON.parse(JSON.stringify(value));\n}\n\nfunction getAtPath(root, path) {\n  let node = root;\n  for (let idx = 0; idx < path.length; idx += 1) {\n    if (node === null || node === undefined) {\n      return undefined;\n    }\n    node = node[path[idx]];\n  }\n  return node;\n}\n\nfunction ensureArray(value) {\n  return Array.isArray(value) ? value : [];\n}\n\nfunction makeIdBucket() {\n  return Object.create(null);\n}\n\nfunction isRegistryIdField(field) {\n  const text = String(field || '');\n  return text === 'id' || /Id$/.test(text) || /ID$/.test(text) || /_id$/.test(text);\n}\n\nfunction createIdRegistry(plan) {\n  const registry = {\n    byField: makeIdBucket(),\n    generated: makeIdBucket(),\n  };\n\n  function remember(field, value) {\n    if (!isRegistryIdField(field)) {\n      return;\n    }\n    if (value === undefined || value === null || typeof value === 'object' || typeof value === 'function' || String(value) === '') {\n      return;\n    }\n    const key = String(field);\n    if (!registry.byField[key]) {\n      registry.byField[key] = makeIdBucket();\n    }\n    registry.byField[key][String(value)] = true;\n  }\n\n  function shouldSkipBranch(key, depth) {\n    return (depth === 0 && key === 'metadata') || key === 'orgCatalog';\n  }\n\n  function visit(value, depth = 0) {\n    if (!value || typeof value !== 'object') {\n      return;\n    }\n    if (Array.isArray(value)) {\n      for (let idx = 0; idx < value.length; idx += 1) {\n        visit(value[idx], depth);\n      }\n      return;\n    }\n    const keys = Object.keys(value);\n    for (let idx = 0; idx < keys.length; idx += 1) {\n      const key = keys[idx];\n      if (shouldSkipBranch(key, depth)) {\n        continue;\n      }\n      const child = value[key];\n      remember(key, child);\n      visit(child, depth + 1);\n    }\n  }\n\n  visit(plan);\n  return registry;\n}\n\nfunction idRegistryHas(registry, fields, id) {\n  if (!registry || !id) {\n    return false;\n  }\n  if (registry.generated && registry.generated[String(id)]) {\n    return true;\n  }\n  for (let idx = 0; idx < fields.length; idx += 1) {\n    const fieldValues = registry.byField && registry.byField[fields[idx]];\n    if (fieldValues && fieldValues[String(id)]) {\n      return true;\n    }\n  }\n  return false;\n}\n\nfunction reserveGeneratedId(registry, fields, id) {\n  if (!registry || !id) {\n    return;\n  }\n  if (!registry.generated) {\n    registry.generated = makeIdBucket();\n  }\n  if (!registry.byField) {\n    registry.byField = makeIdBucket();\n  }\n  registry.generated[String(id)] = true;\n  for (let idx = 0; idx < fields.length; idx += 1) {\n    const field = fields[idx];\n    if (!registry.byField[field]) {\n      registry.byField[field] = makeIdBucket();\n    }\n    registry.byField[field][String(id)] = true;\n  }\n}\n\nfunction nextGeneratedId(plan, prefix, fields) {\n  const registry = plan && plan.byField ? plan : createIdRegistry(plan);\n  let counter = 1;\n  let candidate = prefix + '_' + String(counter);\n  const idFields = Array.isArray(fields) ? fields : [];\n  while (idRegistryHas(registry, idFields, candidate)) {\n    counter += 1;\n    candidate = prefix + '_' + String(counter);\n  }\n  reserveGeneratedId(registry, idFields, candidate);\n  return candidate;\n}\n\nfunction generateIdForName(idRegistry, prefix, name, fields) {\n  const registry = idRegistry || createIdRegistry({});\n  const idFields = Array.isArray(fields) ? fields : [];\n  const slug = String(name || '')\n    .toUpperCase()\n    .replace(/[^A-Z0-9]+/g, '_')\n    .replace(/^_+|_+$/g, '')\n    .slice(0, 48) || 'NEW';\n  const base = prefix + '_' + slug;\n  let candidate = base;\n  let counter = 2;\n  while (idRegistryHas(registry, idFields, candidate)) {\n    candidate = base + '_' + String(counter);\n    counter += 1;\n  }\n  reserveGeneratedId(registry, idFields, candidate);\n  return candidate;\n}\n\nfunction hasNonEmptyString(value) {\n  return value !== undefined && value !== null && String(value).trim() !== '';\n}\n\nfunction expressionTextFromCarrier(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  if (typeof value === 'string' || typeof value === 'number') {\n    return String(value).trim();\n  }\n  if (typeof value !== 'object') {\n    return '';\n  }\n  const fields = ['simpleExpression', 'expressionText', 'inputExpression', 'displayText'];\n  for (let idx = 0; idx < fields.length; idx += 1) {\n    const text = expressionTextFromCarrier(value[fields[idx]]);\n    if (text) {\n      return text;\n    }\n  }\n  return '';\n}\n\nfunction validateReviewState(entity, label, userExplicitPlaceholder) {\n  const status = entity && entity.status !== undefined && entity.status !== null\n    ? String(entity.status).trim()\n    : 'DRAFT';\n  if (status && ['DRAFT', 'NEEDS_REVIEW'].indexOf(status) === -1) {\n    return {\n      ok: false,\n      reason: 'Constructed ' + label + ' items must be DRAFT unless the user explicitly asks for a NEEDS_REVIEW placeholder.',\n    };\n  }\n  if (status === 'NEEDS_REVIEW') {\n    if (!userExplicitPlaceholder) {\n      return {\n        ok: false,\n        reason: 'I need the missing business details before I can create that ' + label + '.',\n      };\n    }\n    if (!hasNonEmptyString(entity.reviewNotes)) {\n      return {\n        ok: false,\n        reason: 'A review note is required for a placeholder ' + label + '.',\n      };\n    }\n  } else if (userExplicitPlaceholder) {\n    return {\n      ok: false,\n      reason: 'Placeholder ' + label + ' items must use NEEDS_REVIEW status with review notes.',\n    };\n  } else if (hasNonEmptyString(entity.reviewNotes)) {\n    return {\n      ok: false,\n      reason: 'Review notes are only allowed for explicit NEEDS_REVIEW placeholder ' + label + ' items.',\n    };\n  }\n  entity.status = status || 'DRAFT';\n  if (entity.reviewNotes === undefined) {\n    entity.reviewNotes = null;\n  }\n  return { ok: true };\n}\n\nfunction normalizeDraftMutation(mutation) {\n  const draft = mutation || {};\n  const target = draft.target || {};\n  const localRef = target.localRef !== undefined && target.localRef !== null ? String(target.localRef).trim() : '';\n  return {\n    kind: String(draft.kind || ''),\n    target: {\n      targetKind: normalizeTargetKind(target.targetKind || draft.targetKind),\n      refId: target.refId !== undefined && target.refId !== null ? String(target.refId).trim() : '',\n      localRef,\n      id: target.id !== undefined && target.id !== null ? String(target.id) : null,\n      name: target.name || draft.targetName || null,\n      owner: target.owner || {},\n    },\n    payload: draft.payload || {},\n    confidence: draft.confidence,\n    reason: draft.reason || '',\n  };\n}\n\nfunction blockResult(operation, reply, blocked, status) {\n  const resultStatus = status || BATCH_STATUSES.BLOCKED;\n  const blockedReason = blocked[0] && blocked[0].reason ? blocked[0].reason : '';\n  return makeBatchResult({\n    status: resultStatus,\n    operation,\n    reply: (resultStatus === BATCH_STATUSES.BLOCKED || resultStatus === BATCH_STATUSES.CLARIFY) && blockedReason\n      ? blockedReason\n      : reply || blockedReason || 'I need one more detail before I can update the plan.',\n    blocked,\n  });\n}\n\nfunction validateRenamePayload(payload) {\n  const newName = payload && payload.newName !== undefined && payload.newName !== null\n    ? String(payload.newName).trim()\n    : '';\n  if (!newName) {\n    return {\n      ok: false,\n      reason: 'What should the new name be?',\n    };\n  }\n  return {\n    ok: true,\n    newName,\n  };\n}\n\nfunction extractVariablesFromExpressionText(value) {\n  const text = String(value || '');\n  const variables = [];\n  const seen = {};\n  const regex = /\\{([^}]+)\\}/g;\n  let match = null;\n  while ((match = regex.exec(text)) !== null) {\n    const variable = String(match[1] || '').trim();\n    if (variable && !seen[variable]) {\n      seen[variable] = true;\n      variables.push(variable);\n    }\n  }\n  return variables;\n}\n\nfunction pathToResolverKey(path) {\n  const parts = [];\n  for (let idx = 0; idx < path.length; idx += 1) {\n    const part = path[idx];\n    if (typeof part === 'number') {\n      if (parts.length === 0) {\n        parts.push('[' + part + ']');\n      } else {\n        parts[parts.length - 1] += '[' + part + ']