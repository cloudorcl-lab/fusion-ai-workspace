SCORECARD' || mutation.kind === 'ADD_RATE_TABLE') {\n    return applyAddPayoutModel(plan, mutation, ledger, resolverPlan);\n  }\n  if (\n    mutation.kind === 'REMOVE_SCORECARD' ||\n    mutation.kind === 'REMOVE_RATE_TABLE' ||\n    mutation.kind === 'REMOVE_MEASURE' ||\n    mutation.kind === 'REMOVE_COMPONENT'\n  ) {\n    return applyRemoveLifecycleTarget(plan, mutation, ledger);\n  }\n  if (mutation.kind === 'RENAME_ENTITY') {\n    return applyRename(plan, mutation, ledger);\n  }\n  if (\n    mutation.kind === 'UPDATE_PLAN_FIELD' ||\n    mutation.kind === 'UPDATE_COMPONENT_FIELD' ||\n    mutation.kind === 'UPDATE_MEASURE_FIELD' ||\n    mutation.kind === 'UPDATE_FORMULA_FIELD' ||\n    mutation.kind === 'UPDATE_RATE_TABLE_METADATA' ||\n    mutation.kind === 'UPDATE_RATE_DIMENSION_METADATA'\n  ) {\n    return applyScalarUpdate(plan, mutation, ledger);\n  }\n  if (mutation.kind === 'UPDATE_FORMULA_EXPRESSION') {\n    return applyFormulaExpressionUpdate(plan, mutation, ledger, resolverPlan);\n  }\n  if (mutation.kind === 'UPDATE_RATE_DIMENSION_INPUT_EXPRESSION') {\n    return applyRateDimensionInputExpressionUpdate(plan, mutation, ledger, resolverPlan);\n  }\n  if (mutation.kind === 'UPDATE_RATE_DIMENSION_VALUES') {\n    return applyRateDimensionValuesUpdate(plan, mutation, ledger);\n  }\n  if (mutation.kind === 'UPDATE_RATE_VALUE') {\n    return applyRateValueUpdate(plan, mutation, ledger);\n  }\n  if (mutation.kind === 'BULK_REPLACE_RATE_VALUES') {\n    return applyBulkRateValuesUpdate(plan, mutation, ledger);\n  }\n  if (mutation.kind === 'REPLACE_TABULAR_TABLE') {\n    return applyTabularTableReplacement(plan, mutation, ledger);\n  }\n  return {\n    ok: false,\n    reason: 'That edit is not supported yet.',\n  };\n}\n\nfunction refreshRenameReferencesAfterBatch(plan, mutations, ledger) {\n  for (let idx = 0; idx < mutations.length; idx += 1) {\n    const mutation = mutations[idx];\n    if (!mutation || mutation.kind !== 'RENAME_ENTITY') {\n      continue;\n    }\n    updateExpressionReferences(plan, mutation, ledger);\n    updateReferencedRateTables(plan, mutation, ledger);\n    updateDimensionInputReferences(plan, mutation, ledger);\n    syncDimensionInputMirrors(plan, mutation, ledger);\n  }\n}\n\nfunction metadataForApplyFailure(finalized, status, reason) {\n  const metadata = finalized && finalized.metadata && typeof finalized.metadata === 'object'\n    ? clone(finalized.metadata)\n    : {};\n  if (metadata.brainOnly === true && metadata.responseComposerRequired !== true) {\n    metadata.responseComposerRequired = true;\n    metadata.responseComposerFacts = {\n      status,\n      request: '',\n      target: null,\n      groundedTargets: [],\n      missingFacts: [],\n      ambiguousFacts: [],\n      conflictFacts: [],\n      unsupportedCapabilities: [],\n      nextAction: 'Review the requested plan details and try again.',\n      applied: false,\n      reason: reason || '',\n      ...(metadata.responseFacts && typeof metadata.responseFacts === 'object' ? metadata.responseFacts : {}),\n    };\n    metadata.responseComposerFacts.status = status;\n    metadata.responseComposerFacts.applied = false;\n    metadata.responseComposerFacts.reason = reason || metadata.responseComposerFacts.reason || '';\n  }\n  return metadata;\n}\n\nfunction addRemovalBlockFacts(metadata, blockMetadata) {\n  if (!metadata || !metadata.responseComposerFacts || !blockMetadata || typeof blockMetadata !== 'object') {\n    return metadata;\n  }\n  const facts = metadata.responseComposerFacts;\n  if (Array.isArray(blockMetadata.removalBlocks)) {\n    facts.removalBlocks = clone(blockMetadata.removalBlocks);\n    facts.blockingReferences = facts.removalBlocks.reduce((acc, block) => (\n      acc.concat(Array.isArray(block.blockingReferences) ? block.blockingReferences : [])\n    ), []);\n    facts.ownerFormulaLookupUsage = facts.removalBlocks.reduce((acc, block) => (\n      acc.concat(Array.isArray(block.ownerFormulaLookupUsage) ? block.ownerFormulaLookupUsage : [])\n    ), []);\n    facts.missingReplacementLogic = facts.removalBlocks\n      .map((block) => block && block.missingReplacementLogic)\n      .filter(Boolean);\n  }\n  return metadata;\n}\n\nfunction metadataForApplySuccess(finalized) {\n  const source = finalized && finalized.metadata && typeof finalized.metadata === 'object'\n    ? finalized.metadata\n    : {};\n  const metadata = {};\n  if (source.brainOnly === true) {\n    metadata.brainOnly = true;\n  }\n  if (source.brainRoute) {\n    metadata.brainRoute = source.brainRoute;\n  }\n  if (source.responseFacts && typeof source.responseFacts === 'object') {\n    metadata.responseFacts = clone(source.responseFacts);\n  }\n  if (source.compiledMutationCount !== undefined) {\n    metadata.compiledMutationCount = source.compiledMutationCount;\n  }\n  return metadata;\n}\n\nfunction classifyNonHappyReason(status, reply, blocked) {\n  const rows = Array.isArray(blocked) ? blocked : [];\n  const reasonText = [\n    reply || '',\n    ...rows.map((row) => (row && row.reason ? row.reason : '')),\n  ].join(' ').toLowerCase();\n\n  if (reasonText.indexOf('rate table type') !== -1) {\n    return 'MISSING_OUTPUT_TYPE';\n  }\n  if (\n    reasonText.indexOf('matrix table shape') !== -1 ||\n    reasonText.indexOf('x and rates') !== -1 ||\n    reasonText.indexOf('replacement table') !== -1 ||\n    reasonText.indexOf('table axis') !== -1\n  ) {\n    return 'TABLE_REPLACEMENT_INCOMPLETE';\n  }\n  if (\n    reasonText.indexOf('stable id') !== -1 ||\n    reasonText.indexOf('name-only edit authority') !== -1 ||\n    reasonText.indexOf('exact plan item') !== -1 ||\n    reasonText.indexOf('exact existing target') !== -1 ||\n    reasonText.indexOf('which exact') !== -1\n  ) {\n    return 'MISSING_OR_AMBIGUOUS_TARGET';\n  }\n  if (reasonText.indexOf('target changed') !== -1 || reasonText.indexOf('target no longer exists') !== -1) {\n    return 'STALE_TARGET';\n  }\n  if (reasonText.indexOf('expression') !== -1 && reasonText.indexOf('resolve') !== -1) {\n    return 'EXPRESSION_UNRESOLVED';\n  }\n  if (reasonText.indexOf('not supported') !== -1 || reasonText.indexOf('not enabled') !== -1) {\n    return 'UNSUPPORTED_OPERATION';\n  }\n  if (status === BATCH_STATUSES.CLARIFY) {\n    return 'NEEDS_MORE_DETAIL';\n  }\n  if (status === BATCH_STATUSES.ERROR) {\n    return 'PROCESSING_ERROR';\n  }\n  return 'EDIT_NOT_APPLIED';\n}\n\nfunction ensureResponseComposerMetadata(metadata, status, operation, reply, blocked) {\n  const next = metadata && typeof metadata === 'object' ? metadata : {};\n  if (status === BATCH_STATUSES.APPLIED || status === BATCH_STATUSES.ANSWER) {\n    return next;\n  }\n\n  next.responseComposerRequired = true;\n  const facts = next.responseComposerFacts && typeof next.responseComposerFacts === 'object'\n    ? clone(next.responseComposerFacts)\n    : {};\n  facts.status = facts.status || status;\n  facts.operation = facts.operation || operation || 'EDIT';\n  facts.applied = false;\n  facts.reasonCode = facts.reasonCode || classifyNonHappyReason(status, reply, blocked);\n  facts.missingFacts = Array.isArray(facts.missingFacts) ? facts.missingFacts : [];\n  facts.ambiguousFacts = Array.isArray(facts.ambiguousFacts) ? facts.ambiguousFacts : [];\n  facts.conflictFacts = Array.isArray(facts.conflictFacts) ? facts.conflictFacts : [];\n  facts.unsupportedCapabilities = Array.isArray(facts.unsupportedCapabilities) ? facts.unsupportedCapabilities : [];\n  facts.groundedTargets = Array.isArray(facts.groundedTargets) ? facts.groundedTargets : [];\n  if (!facts.nextAction) {\n    facts.nextAction = 'Restate the target and the desired final value.';\n  }\n  next.responseComposerFacts = facts;\n  return next;\n}\n\nfunction applyMutationBatch(input) {\n  const finalized = input && input.finalized ? input.finalized : {};\n  const operation = finalized.operation || 'ERROR';\n  const status = finalized.status || BATCH_STATUSES.ERROR;\n  const reply = finalized.reply || '';\n\n  if (status === BATCH_STATUSES.ANSWER) {\n    return answerPlanQuestion(input);\n  }\n\n  if (status === BATCH_STATUSES.CLARIFY || status === BATCH_STATUSES.ERROR || status === BATCH_STATUSES.BLOCKED) {\n    const blockedReason = finalized.blocked && finalized.blocked[0] && finalized.blocked[0].reason\n      ? finalized.blocked[0].reason\n      : '';\n    const metadata = finalized.metadata || {};\n    if (metadata.brainOnly === true && metadata.responseComposerRequired !== true) {\n      metadata.responseComposerRequired = true;\n      metadata.responseComposerFacts = {\n        status,\n        request: '',\n        missingFacts: [],\n        ambiguousFacts: [],\n        conflictFacts: [],\n        unsupportedCapabilities: [],\n        nextAction: '',\n        applied: false,\n        reason: blockedReason || reply || '',\n      };\n    }\n    return makeBatchResult({\n      status,\n      operation,\n      reply: status === BATCH_STATUSES.BLOCKED && blockedReason\n        ? blockedReason\n        : reply || blockedReason || '',\n      blocked: finalized.blocked || [],\n      metadata,\n    });\n  }\n\n  if (operation === 'CREATE_PLAN') {\n    const newPlan = clone(finalized.metadata && finalized.metadata.newPlan ? finalized.metadata.newPlan : null);\n    const changes = newPlan ? [{\n      type: 'create',\n      targetKind: 'plan',\n      targetType: 'plan',\n      entityName: newPlan.compensationPlan && newPlan.compensationPlan.planName ? newPlan.compensationPlan.planName : 'plan',\n      changedFields: ['compensationPlan', 'planComponents'],\n      summary: 'Created plan.',\n    }] : [];\n    return makeBatchResult({\n      status: newPlan ? BATCH_STATUSES.APPLIED : BATCH_STATUSES.ERROR,\n      operation,\n      reply,\n      updatedPlan: newPlan,\n      changes,\n      applied: finalized.applied || [],\n      dirtyScopes: finalized.dirtyScopes || [],\n    });\n  }\n\n  const plan = clone(input.plan || null);\n  if (!plan || typeof plan !== 'object') {\n    return makeBatchResult({\n      status: BATCH_STATUSES.BLOCKED,\n      operation,\n      reply: 'I need the current plan before I can update it.',\n      blocked: [{ reason: 'Missing current plan.' }],\n    });\n  }\n\n  const mutations = finalized.applied && finalized.applied.length !== undefined ? finalized.applied : [];\n  const blocked = [];\n  for (let idx = 0; idx < mutations.length; idx += 1) {\n    const mutation = mutations[idx] || {};\n    if (!verifyIdGuard(plan, mutation.target.path, mutation.target.idGuard)) {\n      blocked.push({\n        index: idx,\n        reason: 'The target changed before the edit could be applied.',\n      });\n    }\n  }\n  if (blocked.length > 0) {\n    return makeBatchResult({\n      status: BATCH_STATUSES.BLOCKED,\n      operation,\n      reply: 'The plan changed before I could apply the edit. Please try again with the latest plan.',\n      blocked,\n    });\n  }\n\n  const ledger = [];\n  const changes = [];\n  const dirtyScopes = {};\n  const metadata = metadataForApplySuccess(finalized);\n  const resolverPlan = extractResolverPlan(input && input.resolverOutput);\n  for (let idx = 0; idx < mutations.length; idx += 1) {\n    const mutation = mutations[idx];\n    const result = applyFinalizedMutation(plan, mutation, ledger, resolverPlan);\n    if (!result.ok) {\n      return makeBatchResult({\n        status: BATCH_STATUSES.BLOCKED,\n        operation,\n        reply: result.reason,\n        blocked: [{ index: idx, reason: result.reason }],\n        metadata: metadataForApplyFailure(finalized, BATCH_STATUSES.BLOCKED, result.reason),\n      });\n    }\n    changes.push(result.change);\n    if (result.metadata && result.metadata.scopedExpressionResolution) {\n      metadata.scopedExpressionResolution = true;\n    }\n    for (let d = 0; d < mutation.dirtyScopes.length; d += 1) {\n      dirtyScopes[mutation.dirtyScopes[d]] = true;\n    }\n  }\n  refreshRenameReferencesAfterBatch(plan, mutations, ledger);\n  const finalReferences = validateFinalRemovedReferences(plan, mutations);\n  if (!finalReferences.ok) {\n    const blockMetadata = finalReferences.blocked && finalReferences.blocked.metadata\n      ? finalReferences.blocked.metadata\n      : {};\n    return makeBatchResult({\n      status: BATCH_STATUSES.BLOCKED,\n      operation,\n      reply: finalReferences.reason,\n      blocked: [{\n        index: mutations.length - 1,\n        reason: finalReferences.reason,\n        metadata: blockMetadata,\n      }],\n      metadata: addRemovalBlockFacts(\n        metadataForApplyFailure(finalized, BATCH_STATUSES.BLOCKED, finalReferences.reason),\n        blockMetadata\n      ),\n    });\n  }\n\n  return makeBatchResult({\n    status: BATCH_STATUSES.APPLIED,\n    operation,\n    reply,\n    updatedPlan: plan,\n    changes,\n    applied: mutations,\n    dirtyScopes: Object.keys(dirtyScopes),\n    ledger,\n    metadata,\n  });\n}\n\nfunction toEditorResponse(batchResult) {\n  const responseText = batchResult.reply || summarizeAppliedChanges(batchResult.changes || []);\n  const responseMetadata = ensureResponseComposerMetadata(\n    {\n      ...(batchResult.metadata || {}),\n      editStatus: batchResult.status,\n      dirtyScopes: batchResult.dirtyScopes || [],\n    },\n    batchResult.status,\n    batchResult.operation,\n    responseText,\n    batchResult.blocked || []\n  );\n  const response = {\n    operation: batchResult.operation,\n    reply: responseText,\n    userResponse: responseText,\n    updatedPlan: batchResult.updatedPlan || null,\n    changes: batchResult.changes || [],\n    precheck: null,\n    metadata: responseMetadata,\n    debug: {\n      status: batchResult.status,\n      dirtyScopes: batchResult.dirtyScopes || [],\n    },\n  };\n\n  if (batchResult.status !== BATCH_STATUSES.APPLIED) {\n    response.updatedPlan = null;\n    response.blocked = batchResult.blocked || [];\n    if (!response.reply && response.blocked.length > 0) {\n      response.reply = response.blocked[0].reason;\n      response.userResponse = response.reply;\n    }\n  }\n\n  response.envelope = makeResponseEnvelope({\n    userResponse: response.userResponse,\n    updatedPlan: response.updatedPlan,\n    changes: response.changes,\n    status: batchResult.status,\n    dirtyScopes: batchResult.dirtyScopes || [],\n  });\n\n  return response;\n}\n\nfunction summarizeAppliedChanges(changes) {\n  const rows = Array.isArray(changes) ? changes : [];\n  const summaries = [];\n  for (let idx = 0; idx < rows.length; idx += 1) {\n    const summary = rows[idx] && rows[idx].summary ? String(rows[idx].summary).trim() : '';\n    if (summary) {\n      summaries.push(summary);\n    }\n  }\n  if (summaries.length === 0) {\n    return '';\n  }\n  return summaries.join(' ');\n}\nreturn {\napplyMutationBatch,\n  toEditorResponse,\n};\n})();\n// APPLY_PLAN_EDITS - Plan Editor CODE node\n// Applies finalized edits to a cloned plan draft.\n\nvar apply = __ic_applyMutations;\n\nvar finalizedRaw = $context.$nodes.SELECT_FINALIZED_EDITS\n  ? $context.$nodes.SELECT_FINALIZED_EDITS.$output.result\n  : null;\nvar fullPlanRaw = $context.$variables.fullPlan;\nvar scopedResolverOutput = $context.$nodes.CALL_SCOPED_EXPRESSION_RESOLVER\n  ? $context.$nodes.CALL_SCOPED_EXPRESSION_RESOLVER.$output\n  : null;\n\nvar parseMaybeJson = function(value) {\n  var current = value;\n  for (var depth = 0; depth < 3; depth += 1) {\n    if (current === null || current === undefined || current === '') {\n      return null;\n    }\n    if (typeof current !== 'string') {\n      return current;\n    }\n    try {\n      current = JSON.parse(current);\n    } catch (_err) {\n      return null;\n    }\n  }\n  return current;\n};\n\nvar finalized = parseMaybeJson(finalizedRaw) || {};\nvar plan = parseMaybeJson(fullPlanRaw);\nvar batchResult = apply.applyMutationBatch({\n  finalized: finalized,\n  plan: plan,\n  resolverOutput: scopedResolverOutput\n});\n\nreturn apply.toEditorResponse(batchResult);"
