= buildPrecheckSummary(contextPlan, activeUiContext, activeScopeEntities);\nvar focusedPlanSlices = buildFocusedPlanSlices(contextPlan, planSetupMetadata, activeUiContext, userMessage, dependencyContextIndex);\nvar dependencyGraphFacts = buildDependencyGraphFacts(focusedPlanSlices, dependencyContextIndex);\nvar editableFieldCatalog = buildEditableFieldCatalog();\nvar overallPlanContext = buildOverallPlanContext(planSummary, planSetupMetadata);\nvar currentContextDetails = buildCurrentContextDetails(activeUiContext, dependencyContextIndex, activeTabularContext, activeEditViews, planSummary);\nvar catalogFacts = {\n  lookupContext: lookupContext,\n  expressionVocabulary: buildExpressionVocabulary(orgCatalog),\n  performanceIntervalValues: intervalAllowedText,\n  payoutFrequencyValues: intervalAllowedText,\n  resetIntervalValues: intervalAllowedText\n};\nvar setupCatalogFacts = {\n  lookupContext: lookupContext,\n  performanceIntervalValues: intervalAllowedText,\n  payoutFrequencyValues: intervalAllowedText,\n  resetIntervalValues: intervalAllowedText\n};\n\nvar result = {\n  planSummary: planSummary,\n  planSetupMetadata: planSetupMetadata,\n  planSetupText: planSetupText,\n  uiHint: uiHint,\n  activeUiContext: activeUiContext,\n  activeScopeEntities: activeScopeEntities,\n  activeTabularContext: activeTabularContext,\n  activeEditViews: activeEditViews,\n  overallPlanContext: overallPlanContext,\n  currentContextDetails: currentContextDetails,\n  broadPlanIndex: broadPlanIndex,\n  dependencyGraphFacts: dependencyGraphFacts,\n  focusedPlanSlices: focusedPlanSlices,\n  editableFieldCatalog: editableFieldCatalog,\n  catalogFacts: catalogFacts,\n  setupCatalogFacts: setupCatalogFacts,\n  lookupContext: lookupContext,\n  currentDateTime: runtimeCurrentDateTime,\n  fieldAliasContext: fieldAliasContext,\n  precheckSummary: precheckSummary,\n  performanceIntervalValues: intervalAllowedText,\n  payoutFrequencyValues: intervalAllowedText,\n  resetIntervalValues: intervalAllowedText\n};\nreturn result;"
