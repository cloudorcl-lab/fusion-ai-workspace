        {
          "id": "18",
          "code": "DETERMINE_EXECUTION_FLAGS",
          "type": "CODE",
          "metadata": {
            "name": "Determine Execution Flags",
            "returnType": "object",
            "sourceCode": "// DETERMINE_EXECUTION_FLAGS - Decide which expensive downstream steps should run.\n\nvar assembledRaw = $context.$nodes.APPLY_PLAN_EDITS\n  ? $context.$nodes.APPLY_PLAN_EDITS.$output.result\n  : null;\nvar runPrecheckInput = $context.$variables.runPrecheck;\n\nvar parseMaybeJson = function(value) {\n  var current = value;\n  for (var depth = 0; depth < 3; depth += 1) {\n    if (current === null || current === undefined || current === '') {\n      return null;\n    }\n    if (typeof current !== 'string') {\n      return current;\n    }\n    try {\n      current = JSON.parse(current);\n    } catch (_err) {\n      return null;\n    }\n  }\n  return current;\n};\n\nvar assembled = parseMaybeJson(assembledRaw);\nvar operation = assembled && assembled.operation ? String(assembled.operation) : '';\nvar changes = assembled && assembled.changes && assembled.changes.length !== undefined\n  ? assembled.changes\n  : [];\nvar hasUpdatedPlan = !!(assembled && assembled.updatedPlan && typeof assembled.updatedPlan === 'object');\n\nvar normalizeBoolean = function(value, defaultValue) {\n  if (value === null || value === undefined || value === '') {\n    return defaultValue;\n  }\n  if (value === true || value === false) {\n    return value;\n  }\n  var lowered = String(value).trim().toLowerCase();\n  if (lowered === 'true' || lowered === '1' || lowered === 'yes') {\n    return true;\n  }\n  if (lowered === 'false' || lowered === '0' || lowered === 'no') {\n    return false;\n  }\n  return defaultValue;\n};\n\nvar isExplicitFalse = function(value) {\n  if (value === false) {\n    return true;\n  }\n  var lowered = String(value === null || value === undefined ? '' : value).trim().toLowerCase();\n  return lowered === 'false' || lowered === '0' || lowered === 'no';\n};\n\nvar fieldMatchesAny = function(fields, patterns) {\n  if (!fields || fields.length === undefined) {\n    return false;\n  }\n  for (var i = 0; i < fields.length; i++) {\n    var field = String(fields[i] || '');\n    for (var j = 0; j < patterns.length; j++) {\n      if (field === patterns[j] || field.indexOf(patterns[j] + '.') === 0 || field.indexOf('.' + patterns[j]) !== -1) {\n        return true;\n      }\n    }\n  }\n  return false;\n};\n\nvar pathMatchesAny = function(path, patterns) {\n  if (!path || path.length === undefined) {\n    return false;\n  }\n  for (var i = 0; i < path.length; i++) {\n    var part = String(path[i] || '');\n    for (var j = 0; j < patterns.length; j++) {\n      if (part === patterns[j]) {\n        return true;\n      }\n    }\n  }\n  return false;\n};\n\nvar runResolver = false;\nvar runDescriptions = false;\nvar precheckExplicitlyDisabled = isExplicitFalse(runPrecheckInput);\nvar runPrecheck = hasUpdatedPlan && normalizeBoolean(runPrecheckInput, false);\nvar dirtyScopes = assembled && assembled.metadata && assembled.metadata.dirtyScopes && assembled.metadata.dirtyScopes.length !== undefined\n  ? assembled.metadata.dirtyScopes\n  : [];\n\nfor (var dirtyIdx = 0; dirtyIdx < dirtyScopes.length; dirtyIdx += 1) {\n  var scope = String(dirtyScopes[dirtyIdx] || '');\n  if (scope === 'precheck' && !precheckExplicitlyDisabled) {\n    runPrecheck = hasUpdatedPlan;\n  }\n}\n\nvar result = new Object();\nresult.runResolver = runResolver ? 'true' : 'false';\nresult.runDescriptions = runDescriptions ? 'true' : 'false';\nresult.runPrecheck = runPrecheck ? 'true' : 'false';\n\nreturn result;"
