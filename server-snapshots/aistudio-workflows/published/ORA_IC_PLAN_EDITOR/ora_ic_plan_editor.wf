          "metadata": {
            "name": "Build Context",
            "returnType": "object",
            "sourceCode": "// BUILD_CONTEXT - Plan Editor CODE node\n// Build Context\n//\nvar fullPlanStr = $context.$variables.fullPlan;\nvar userMessage = $context.$variables.userMessage || '';\nvar contextType = $context.$variables.contextType || '';\nvar contextId = $context.$variables.contextId || '';\nvar contextName = $context.$variables.contextName || '';\nvar systemContext = $context.$system || {};\nvar runtimeCurrentDateTime = systemContext.$currentDateTime !== undefined && systemContext.$currentDateTime !== null\n  ? String(systemContext.$currentDateTime)\n  : '';\n\nvar parseMaybeJson = function(value) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n  if (typeof value !== 'string') {\n    return value;\n  }\n  try {\n    return JSON.parse(value);\n  } catch (_err) {\n    return null;\n  }\n};\n\nvar fullPlan = parseMaybeJson(fullPlanStr);\nvar isPresentInput = function(value) {\n  return value !== null && value !== undefined && String(value).trim() !== '' && String(value).trim() !== 'null';\n};\nvar compactPlanForContext = function(plan) {\n  if (!plan || typeof plan !== 'object') {\n    return plan;\n  }\n  var compact = new Object();\n  if (plan.metadata && typeof plan.metadata === 'object') {\n    compact.metadata = new Object();\n    if (plan.metadata.planId !== undefined) {\n      compact.metadata.planId = plan.metadata.planId;\n    }\n    if (plan.metadata.compensationPlanId !== undefined) {\n      compact.metadata.compensationPlanId = plan.metadata.compensationPlanId;\n    }\n    if (plan.metadata.precheck !== undefined) {\n      compact.metadata.precheck = plan.metadata.precheck;\n    }\n  }\n  if (plan.compensationPlan !== undefined) {\n    compact.compensationPlan = plan.compensationPlan;\n  }\n  if (plan.planComponents !== undefined) {\n    compact.planComponents = plan.planComponents;\n  }\n  return compact;\n};\nvar contextPlan = compactPlanForContext(fullPlan);\nvar explicitOrgCatalogRaw = $context.$variables.orgCatalog;\nvar preparedOrgCatalogRaw = $context.$nodes.PREPARE_CATALOG_INPUTS &&\n  $context.$nodes.PREPARE_CATALOG_INPUTS.$output &&\n  $context.$nodes.PREPARE_CATALOG_INPUTS.$output.result\n    ? $context.$nodes.PREPARE_CATALOG_INPUTS.$output.result.orgCatalog\n    : null;\nvar embeddedOrgCatalogRaw = fullPlan && fullPlan.metadata && typeof fullPlan.metadata === 'object'\n  ? fullPlan.metadata.orgCatalog\n  : null;\nvar orgCatalogRaw = isPresentInput(explicitOrgCatalogRaw)\n  ? explicitOrgCatalogRaw\n  : (isPresentInput(preparedOrgCatalogRaw) ? preparedOrgCatalogRaw : embeddedOrgCatalogRaw);\nif ((orgCatalogRaw === null || orgCatalogRaw === undefined) && $context.$nodes.CALL_ORG_CATALOG_FOR_CONTEXT) {\n  orgCatalogRaw = $context.$nodes.CALL_ORG_CATALOG_FOR_CONTEXT.$output;\n}\n\nvar extractOrgCatalog = function(workflowOutput) {\n  var envelope = parseMaybeJson(workflowOutput);\n  if (!envelope || typeof envelope !== 'object') {\n    return null;\n  }\n  if (envelope.staticLookups) {\n    return envelope;\n  }\n  if (envelope && envelope.output !== undefined) {\n    var child = parseMaybeJson(envelope.output);\n    if (child && typeof child === 'object' && child.staticLookups) {\n      return child;\n    }\n    if (child && child.result && child.result.catalog) {\n      return child.result.catalog;\n    }\n    if (child && child.result && child.result.staticLookups) {\n      return child.result;\n    }\n    if (child && child.catalog) {\n      return child.catalog;\n    }\n  }\n  if (envelope && envelope.result && envelope.result.catalog) {\n    return envelope.result.catalog;\n  }\n  if (envelope && envelope.result && envelope.result.staticLookups) {\n    return envelope.result;\n  }\n  if (envelope && envelope.catalog) {\n    return envelope.catalog;\n  }\n  return null;\n};\n\nvar planSummary = { isEmpty: true, planName: '', components: [] };\nvar planSetupMetadata = { entities: [] };\n\nvar buildEditableFieldCatalog = function() {\n  return {\n    notes: [\n      'Use these declared static fields for scalar/static updates on exact existing targets.',\n      'Name fields are not listed here because name/display-label edits use renameEntity.',\n      'Generated IDs, expression internals, confidence/provenance, errorStatus, table dimensions/values/rates, and child collections remain read-only or use specialized operations.',\n      'Collection-valued static fields such as goals, eligibleRoles, and creditCategories are full-field replacements; preserve unchanged items when the user only changes part of the collection.'\n    ],\n    plan: [\n      { field: 'businessUnit', type: 'string|null' },\n      { field: 'description', type: 'string|null' },\n      { field: 'effectiveStartDate', type: 'date|null' },\n      { field: 'effectiveEndDate', type: 'date|null' },\n      { field: 'targetIncentive', type: 'number|null' },\n      { field: 'allowCreditCategoryOverlapFlag', type: 'boolean|null' },\n      { field: 'status', type: 'enum', values: ['DRAFT', 'COMPLETE', 'NEEDS_REVIEW'] },\n      { field: 'reviewNotes', type: 'string|null' }\n    ],\n    component: [\n      { field: 'description', type: 'string|null' },\n      { field: 'startDate', type: 'date|null' },\n      { field: 'endDate', type: 'date|null' },\n      { field: 'componentType', type: 'enum', catalog: 'Component type values' },\n      { field: 'incentiveType', type: 'enum|null', catalog: 'Incentive type values' },\n      { field: 'targetIncentivePercent', type: 'number|null' },\n      { field: 'eligibleRoles', type: 'string[]|null' },\n      { field: 'sequenceNumber', type: 'integer' },\n      { field: 'splitOption', type: 'enum|null', catalog: 'Split option values' },\n      { field: 'status', type: 'enum', values: ['DRAFT', 'COMPLETE', 'NEEDS_REVIEW'] },\n      { field: 'reviewNotes', type: 'string|null' }\n    ],\n    measure: [\n      { field: 'description', type: 'string|null' },\n      { field: 'startDate', type: 'date|null' },\n      { field: 'endDate', type: 'date|null' },\n      { field: 'measureType', type: 'enum', values: ['REVENUE', 'QUOTA', 'ATTAINMENT', 'CUSTOM'] },\n      { field: 'unitOfMeasure', type: 'enum', catalog: 'Commission unit values' },\n      { field: 'processTransaction', type: 'enum', catalog: 'Process transaction values' },\n      { field: 'weight', type: 'number|null' },\n      { field: 'earningBasis', type: 'boolean|null' },\n      { field: 'calculationSequence', type: 'integer|null' },\n      { field: 'performanceInterval', type: 'enum|null', catalog: 'performanceIntervalValues' },\n      { field: 'goals', type: 'Goal[] full replacement' },\n      { field: 'creditCategories', type: 'CreditCategory[] full replacement' },\n      { field: 'splitOption', type: 'enum|null', catalog: 'Split option values' },\n      { field: 'runningTotalFlag', type: 'boolean|null' },\n      { field: 'status', type: 'enum', values: ['DRAFT', 'COMPLETE', 'NEEDS_REVIEW'] },\n      { field: 'reviewNotes', type: 'string|null' }\n    ],\n    formula: [\n      { field: 'description', type: 'string|null' },\n      { field: 'formulaType', type: 'string' },\n      { field: 'payoutFrequency', type: 'enum|null', catalog: 'payoutFrequencyValues' },\n      { field: 'resetInterval', type: 'enum|null', catalog: 'resetIntervalValues' },\n      { field: 'includeIndirectCredits', type: 'enum', catalog: 'Include indirect credits values' },\n      { field: 'trueUp', type: 'boolean' },\n      { field: 'calculateEnddatedParticipants', type: 'boolean' },\n      { field: 'status', type: 'enum', values: ['DRAFT', 'COMPLETE', 'NEEDS_REVIEW'] },\n      { field: 'reviewNotes', type: 'string|null' }\n    ],\n    rateTable: [\n      { field: 'description', type: 'string|null' },\n      { field: 'rateTableType', type: 'enum', values: ['PERCENT', 'AMOUNT'] },\n      { field: 'startDate', type: 'date|null' },\n      { field: 'endDate', type: 'date|null' },\n      { field: 'status', type: 'enum', values: ['DRAFT', 'COMPLETE', 'NEEDS_REVIEW'] },\n      { field: 'reviewNotes', type: 'string|null' }\n    ],\n    scorecard: [\n      { field: 'description', type: 'string|null' },\n      { field: 'rateTableType', type: 'enum', values: ['PERCENT', 'AMOUNT'] },\n      { field: 'startDate', type: 'date|null' },\n      { field: 'endDate', type: 'date|null' },\n      { field: 'status', type: 'enum', values: ['DRAFT', 'COMPLETE', 'NEEDS_REVIEW'] },\n      { field: 'reviewNotes', type: 'string|null' }\n    ],\n    rateDimension: [\n      { field: 'dimensionType', type: 'enum', values: ['RANGE', 'LIST', 'TEXT', 'CATEGORY'] },\n      { field: 'unitOfMeasure', type: 'enum', catalog: 'Commission unit values' },\n      { field: 'splitFlag', type: 'boolean' },\n      { field: 'accumulateFlag', type: 'boolean' }\n    ],\n    goal: [\n      { field: 'targetAmount', type: 'number' },\n      { field: 'targetUnitOfMeasure', type: 'enum', values: ['AMOUNT', 'QUANTITY'] },\n      { field: 'periodType', type: 'enum', values: ['Annual', 'Quarter', 'Period'] },\n      { field: 'periodNumber', type: 'integer|null' },\n      { field: 'distributeEvenlyFlag', type: 'boolean|null' },\n      { field: 'startDate', type: 'date|null' },\n      { field: 'endDate', type: 'date|null' },\n      { field: 'status', type: 'enum', values: ['DRAFT', 'COMPLETE', 'NEEDS_REVIEW'] },\n      { field: 'reviewNotes', type: 'string|null' }\n    ]\n  };\n};\n\nvar buildFieldAliasContextText = function() {\n  return [\n    'FIELD LABEL ALIASES',\n    '- calculation type, earning type -> component.incentiveType',\n    '- transaction processing, process transaction, processing mode -> measure.processTransaction',\n    '- payout frequency, pay out frequency, payment frequency -> formula.payoutFrequency',\n    '- performance interval, measurement interval -> measure.performanceInterval',\n    '- component split option -> component.splitOption',\n    '- measure split option -> measure.splitOption',\n    '- running total, running total flag -> measure.runningTotalFlag',\n    '- reset interval -> formula.resetInterval',\n    '- include indirect credits -> formula.includeIndirectCredits',\n    '- true up -> formula.trueUp',\n    '',\n    'Routing notes:',\n    '- payout frequency, reset interval, include indirect credits, and true up are component incentive formula settings unless the user explicitly targets a measure formula.',\n    '- calculation type is a component field, not formula expression logic.',\n    '- transaction processing is a measure field, not component calculation type.'\n  ].join('\\n');\n};\n\nvar inferTypeFromPrefix = function(id) {\n  if (!id) {\n    return '';\n  }\n  var upper = String(id).toUpperCase();\n  if (upper.indexOf('PLAN_') === 0) return 'plan';\n  if (upper.indexOf('COMP_') === 0) return 'component';\n  if (upper.indexOf('MEAS_') === 0 || upper.indexOf('PM_') === 0) return 'measure';\n  if (upper.indexOf('FORMULA_') === 0 || upper.indexOf('FORM_') === 0 || upper.indexOf('EXPR_') === 0) return 'formula';\n  if (upper.indexOf('RT_') === 0) return 'rateTable';\n  if (upper.indexOf('PMINPUT_') === 0) return 'measure';\n  return '';\n};\n\nvar inferredContextType = contextType || inferTypeFromPrefix(contextId) || 'plan';\nvar inferredContextName = contextName || '';\nif (String(inferredContextType || '').toLowerCase() === 'incentiveformula') {\n  inferredContextType = 'formula';\n}\n\nvar addSetupEntity = function(kind, name, id, owner, aliases) {\n  var cleanName = trimText(name);\n  if (!cleanName) {\n    return;\n  }\n  var entity = {\n    kind: kind,\n    name: cleanName,\n    id: id !== undefined && id !== null ? String(id) : '',\n    owner: owner && typeof owner === 'object' ? owner : {}\n  };\n  var aliasRows = [];\n  var aliasValues = aliases && aliases.length !== undefined ? aliases : [];\n  for (var aliasIdx = 0; aliasIdx < aliasValues.length; aliasIdx++) {\n    var alias = aliasValues[aliasIdx];\n    if (alias !== undefined && alias !== null && String(alias) !== '' && String(alias) !== entity.id) {\n      aliasRows.push(String(alias));\n    }\n  }\n  if (aliasRows.length > 0) {\n    entity.aliasIds = aliasRows;\n  }\n  planSetupMetadata.entities.push(entity);\n};\n\nvar summarizeRateDimensions = function(dimensions) {\n  if (!dimensions || dimensions.length === undefined) {\n    return [];\n  }\n\n  var summaries = [];\n  for (var i = 0; i < dimensions.length; i++) {\n    var dimension = dimensions[i] ? dimensions[i] : {};\n    var summary = {\n      dimensionSequence: dimension.dimensionSequence || dimension.sequence || i + 1,\n      name: dimension.dimensionName || '',\n      type: dimension.dimensionType || '',\n      inputExpression: dimension.inputExpression || dimension.simpleExpression || dimension.displayText || '',\n      values: Array.isArray(dimension.values) ? dimension.values.slice() : []\n    };\n    if (dimension.splitFlag === true || dimension.splitFlag === false) {\n      summary.splitFlag = dimension.splitFlag;\n    }\n    if (dimension.accumulateFlag === true || dimension.accumulateFlag === false) {\n      summary.accumulateFlag = dimension.accumulateFlag;\n    }\n    summaries.push(summary);\n  }\n  return summaries;\n};\n\nvar addOptionalAxisFlags = function(target, dimension) {\n  if (dimension && (dimension.splitFlag === true || dimension.splitFlag === false)) {\n    target.splitFlag = dimension.splitFlag;\n  }\n  if (dimension && (dimension.accumulateFlag === true || dimension.accumulateFlag === false)) {\n    target.accumulateFlag = dimension.accumulateFlag;\n  }\n};\n\nvar compactTabularDimension = function(dimension, idx) {\n  var values = Array.isArray(dimension && dimension.values) ? dimension.values.slice() : [];\n  var compact = {\n    id: dimension && (dimension.dimensionId || dimension.rateDimensionId) || '',\n    dimensionName: dimension && dimension.dimensionName || '',\n    sequence: dimension && (dimension.dimensionSequence || dimension.sequence) || idx + 1,\n    dimensionType: dimension && dimension.dimensionType || '',\n    unitOfMeasure: dimension && dimension.unitOfMeasure || '',\n    inputExpression: dimension && (dimension.inputExpression || dimension.simpleExpression || dimension.displayText) || '',\n    values: values\n  };\n  addOptionalAxisFlags(compact, dimension);\n  return compact;\n};\n\nvar compactTabularCoordinateArray = function(row, axes) {\n  var coordinates = row && row.coordinates && typeof row.coordinates === 'object' && !Array.isArray(row.coordinates)\n    ? row.coordinates\n    : {};\n  var refs = row && row.coordinateRefs && row.coordinateRefs.length !== undefined ? row.coordinateRefs : [];\n  var values = [];\n  for (var idx = 0; idx < axes.length; idx++) {\n    var dimension = axes[idx] || {};\n    var name = dimension.dimensionName || '';\n    var value = name && coordinates[name] !== undefined && coordinates[name] !== null\n      ? String(coordinates[name])\n      : '';\n    if (!value && refs[idx] && refs[idx].tierSequence !== undefined) {\n      var tierIndex = Number(refs[idx].tierSequence) - 1;\n      if (dimension.values && tierIndex >= 0 && tierIndex < dimension.values.length) {\n        value = String(dimension.values[tierIndex]);\n      }\n    }\n    values.push(value);\n  }\n  return values;\n};\n\nvar buildTabularRatesMatrix = function(rawRows, axes) {\n  var rows = rawRows && rawRows.length !== undefined ? rawRows : [];\n  var lookup = new Object();\n  for (var rowIdx = 0; rowIdx < rows.length; rowIdx++) {\n    var row = rows[rowIdx] || {};\n    var coordinates = compactTabularCoordinateArray(row, axes);\n    lookup[coordinates.join('\\u001f')] = row.rate;\n  }\n\n  var x = axes[0] || {};\n  var xValues = x.values || [];\n  if (axes.length === 1) {\n    var oneDimensionalRates = [];\n    for (var xIdx = 0; xIdx < xValues.length; xIdx++) {\n      var oneKey = String(xValues[xIdx]);\n      oneDimensionalRates.push(lookup[oneKey] !== undefined ? lookup[oneKey] : null);\n    }\n    return oneDimensionalRates;\n  }\n\n  var y = axes[1] || {};\n  var yValues = y.values || [];\n  var matrix = [];\n  for (var rowXIdx = 0; rowXIdx < xValues.length; rowXIdx++) {\n    var matrixRow = [];\n    for (var yIdx = 0; yIdx < yValues.length; yIdx++) {\n      var key = String(xValues[rowXIdx]) + '\\u001f' + String(yValues[yIdx]);\n      matrixRow.push(lookup[key] !== undefined ? lookup[key] : null);\n    }\n    matrix.push(matrixRow);\n  }\n  return matrix;\n};\n\nvar buildMatrixOrientation = function(dimensions) {\n  var axes = dimensions && dimensions.length !== undefined ? dimensions : [];\n  var x = axes[0] || {};\n  var xValues = x.values && x.values.length !== undefined ? x.values : [];\n  var xLast = xValues.length > 0 ? xValues.length - 1 : 0;\n  var xName = x.dimensionName || 'first dimension';\n  if (axes.length < 2) {\n    return 'Matrix orientation: one-dimensional table; x[0..' + xLast + '] = ' + xName + '; rates[xIndex].';\n  }\n  var y = axes[1] || {};\n  var yValues = y.values && y.values.length !== undefined ? y.values : [];\n  var yLast = yValues.length > 0 ? yValues.length - 1 : 0;\n  var yName = y.dimensionName || 'second dimension';\n  return 'Matrix orientation: rows are x[0..' + xLast + '] = ' + xName + '; columns are y[0..' + yLast + '] = ' + yName + '; rates[xIndex][yIndex].';\n};\n\nvar buildCompactTabularTable = function(role, table, path, owner) {\n  if (!table || typeof table !== 'object') {\n    return null;\n  }\n  var rawDimensions = table.dimensions && table.dimensions.length !== undefined ? table.dimensions : [];\n  if (rawDimensions.length === 0 || rawDimensions.length > 2) {\n    return null;\n  }\n  var dimensions = [];\n  for (var idx = 0; idx < rawDimensions.length; idx++) {\n    dimensions.push(compactTabularDimension(rawDimensions[idx] || {}, idx));\n  }\n  var rawRows = table.rateValues && table.rateValues.length !== undefined ? table.rateValues : [];\n  var compact = {\n    tableRole: role,\n    path: pathToKey(path || []),\n    tableId: role === 'scorecard' ? (table.scorecardId || ta