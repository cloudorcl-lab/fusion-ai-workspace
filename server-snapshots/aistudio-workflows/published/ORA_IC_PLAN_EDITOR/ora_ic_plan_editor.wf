        {
          "id": "33",
          "code": "PREPARE_RESPONSE",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Response",
            "returnType": "object",
            "sourceCode": "// PREPARE_RESPONSE - Plan Editor CODE node\n// Prepare a single top-level response payload for the RETURN node\n\nvar responseRaw = ($context.$nodes.APPLY_PRECHECK_OUTPUT && $context.$nodes.APPLY_PRECHECK_OUTPUT.$output)\n    ? $context.$nodes.APPLY_PRECHECK_OUTPUT.$output.result\n    : null;\n\nvar parseMaybeJson = function(value) {\n    var current = value;\n    for (var depth = 0; depth < 3; depth += 1) {\n        if (current === null || current === undefined || current === '') {\n            return null;\n        }\n        if (typeof current !== 'string') {\n            return current;\n        }\n        try {\n            current = JSON.parse(current);\n        } catch (_err) {\n            return null;\n        }\n    }\n    return current;\n};\n\nvar response = parseMaybeJson(responseRaw);\nif (!response || typeof response !== 'object') {\n    response = {};\n}\n\nvar changes = response.changes && response.changes.length !== undefined\n    ? response.changes\n    : [];\nvar hasAppliedChanges = changes.length > 0;\n\nvar trimText = function(value) {\n    return String(value || '').replace(/^\\s+|\\s+$/g, '');\n};\n\nvar toSentenceCaseField = function(field) {\n    var raw = trimText(field);\n    if (!raw) {\n        return '';\n    }\n    var leaf = raw.indexOf('.') >= 0 ? raw.substring(raw.lastIndexOf('.') + 1) : raw;\n    var normalizedLeaf = leaf.replace(/_/g, '').toLowerCase();\n    // Keep chip summaries user-facing by stripping internal resolver/token fields.\n    if (normalizedLeaf === 'tokens' || normalizedLeaf === 'resolution' || normalizedLeaf === 'resolutionhints') {\n        return '';\n    }\n    if (normalizedLeaf === 'scorecards') {\n        return 'scorecard setup';\n    }\n    if (normalizedLeaf === 'ratedimensionalinputs') {\n        return 'rate inputs';\n    }\n    if (normalizedLeaf === 'ratevalues') {\n        return 'rates';\n    }\n    var spaced = leaf\n        .replace(/([a-z0-9])([A-Z])/g, '$1 $2')\n        .replace(/_/g, ' ')\n        .toLowerCase();\n    return trimText(spaced);\n};\n\nvar buildFieldSummary = function(fields) {\n    if (!fields || fields.length === undefined || fields.length === 0) {\n        return '';\n    }\n    var seen = new Object();\n    var labels = [];\n    for (var i = 0; i < fields.length; i += 1) {\n        var label = toSentenceCaseField(fields[i]);\n        if (!label || seen[label]) {\n            continue;\n        }\n        seen[label] = true;\n        labels.push(label);\n        if (labels.length >= 3) {\n            break;\n        }\n    }\n    if (labels.length === 0) {\n        return '';\n    }\n    if (labels.length === 1) {\n        return labels[0];\n    }\n    if (labels.length === 2) {\n        return labels[0] + ' and ' + labels[1];\n    }\n    return labels[0] + ', ' + labels[1] + ', and ' + labels[2];\n};\n\nvar buildChangeSummary = function(responseObj, changeList) {\n    var planNameText = responseObj.updatedPlan &&\n        responseObj.updatedPlan.compensationPlan &&\n        responseObj.updatedPlan.compensationPlan.planName\n        ? String(responseObj.updatedPlan.compensationPlan.planName)\n        : '';\n\n    if (!changeList || changeList.length === undefined || changeList.length === 0) {\n        return responseObj.reply ? String(responseObj.reply) : 'Plan editor update ready';\n    }\n\n    if (changeList.length === 1) {\n        var change = changeList[0] ? changeList[0] : new Object();\n        var changeType = change.type ? String(change.type) : '';\n        var entityName = trimText(change.entityName || change.targetName || '');\n        var targetType = trimText(change.targetType || 'item');\n        var subject = entityName || targetType;\n        if (!subject) {\n            subject = planNameText || 'plan';\n        }\n\n        if (changeType === 'rename') {\n            var beforeName = trimText(change.targetNameBefore || '');\n            var afterName = trimText(change.targetNameAfter || entityName || '');\n            if (beforeName && afterName) {\n                return 'Renamed ' + beforeName + ' to ' + afterName + '.';\n            }\n            return 'Renamed ' + subject + '.';\n        }\n        if (changeType === 'add') {\n            return 'Added ' + subject + '.';\n        }\n        if (changeType === 'delete') {\n            return 'Removed ' + subject + '.';\n        }\n        if (changeType === 'create') {\n            return responseObj.reply ? String(responseObj.reply) : ('Created ' + subject + '.');\n        }\n\n        var fieldSummary = buildFieldSummary(change.changedFields);\n        if (fieldSummary) {\n            return 'Updated ' + subject + ': ' + fieldSummary + '.';\n        }\n        return 'Updated ' + subject + '.';\n    }\n\n    return 'Applied ' + String(changeList.length) + ' changes' +\n        (planNameText ? (' in ' + planNameText) : '') +\n        '.';\n};\n\nvar sanitizeNonHappyResponseText = function(text) {\n    var raw = trimText(text);\n    if (!raw) {\n        return raw;\n    }\n    var lowered = raw.toLowerCase();\n\n    if (lowered.indexOf('stable id') !== -1 || lowered.indexOf('name-only edit authority') !== -1) {\n        return 'I could not safely identify the exact plan item to update from the current context. Please select that item in the plan or include its exact name and owner, then try again. No plan change was applied.';\n    }\n    if (\n        lowered.indexOf('matrix table shape') !== -1 ||\n        lowered.indexOf('x and rates') !== -1 ||\n        lowered.indexOf('x, optional y') !== -1\n    ) {\n        return 'I could not turn that table change into a complete final table. Please provide the final tiers or segments and the value for each final row or cell. No plan change was applied.';\n    }\n    if (\n        lowered.indexOf('rate table type') !== -1 &&\n        (\n            lowered.indexOf('not specified') !== -1 ||\n            lowered.indexOf('not been specified') !== -1 ||\n            lowered.indexOf('has not been specified') !== -1\n        )\n    ) {\n        return 'I need the output type for that scorecard or payout table before I can add it. Please specify Amount, Percent, Score, or another supported output type. No plan change was applied.';\n    }\n    if (lowered.indexOf('compiler') !== -1 || lowered.indexOf('validator') !== -1 || lowered.indexOf('schema') !== -1 || lowered.indexOf('topology') !== -1) {\n        return 'I could not safely apply that plan change from the current request. Please restate the target and the desired final value. No plan change was applied.';\n    }\n    return raw;\n};\n\nvar fallbackNonHappyResponseText = function(responseObj) {\n    var metadata = responseObj && responseObj.metadata && typeof responseObj.metadata === 'object'\n        ? responseObj.metadata\n        : new Object();\n    var facts = metadata.responseComposerFacts && typeof metadata.responseComposerFacts === 'object'\n        ? metadata.responseComposerFacts\n        : new Object();\n    var reasonCode = trimText(facts.reasonCode || '');\n    if (reasonCode === 'MISSING_OUTPUT_TYPE') {\n        return 'I need the output type for that scorecard or payout table before I can add it. Please specify Amount, Percent, Score, or another supported output type. No plan change was applied.';\n    }\n    if (reasonCode === 'TABLE_REPLACEMENT_INCOMPLETE') {\n        return 'I could not turn that table change into a complete final table. Please provide the final tiers or segments and the value for each final row or cell. No plan change was applied.';\n    }\n    if (reasonCode === 'MISSING_OR_AMBIGUOUS_TARGET') {\n        return 'I could not safely identify the exact plan item to update from the current context. Please select that item in the plan or include its exact name and owner, then try again. No plan change was applied.';\n    }\n    if (reasonCode === 'STALE_TARGET') {\n        return 'That plan item changed before I could apply the edit. Please retry from the latest plan view. No plan change was applied.';\n    }\n    if (reasonCode === 'EXPRESSION_UNRESOLVED') {\n        return 'I could not resolve the expression for that edit. Please provide the executable expression or the missing expression detail. No plan change was applied.';\n    }\n    if (reasonCode === 'UNSUPPORTED_OPERATION') {\n        return 'That edit is not available yet. Please try a supported plan edit instead. No plan change was applied.';\n    }\n    return 'I could not safely apply that plan change from the current request. Please restate the target and the desired final value. No plan change was applied.';\n};\n\nif (!hasAppliedChanges) {\n    response.updatedPlan = null;\n}\n\nvar responseText = buildChangeSummary(response, changes);\nif (!hasAppliedChanges) {\n    if (response.metadata && response.metadata.responseComposed === true && trimText(response.userResponse || response.reply)) {\n        responseText = sanitizeNonHappyResponseText(response.userResponse || response.reply);\n    } else if (response.operation && String(response.operation) === 'ANSWER' && trimText(response.userResponse || response.reply)) {\n        responseText = sanitizeNonHappyResponseText(response.userResponse || response.reply);\n    } else {\n        responseText = fallbackNonHappyResponseText(response);\n    }\n}\nvar planName = response.updatedPlan &&\n    response.updatedPlan.compensationPlan &&\n    response.updatedPlan.compensationPlan.planName\n    ? String(response.updatedPlan.compensationPlan.planName)\n    : null;\nvar labelText = planName || (response.operation ? String(response.operation) : 'Plan Editor');\nvar hasPlanChange = hasAppliedChanges;\nvar responseFacts = response.metadata &&\n    response.metadata.responseComposerFacts &&\n    typeof response.metadata.responseComposerFacts === 'object'\n    ? response.metadata.responseComposerFacts\n    : null;\nvar hasPendingRecommendation = !!(\n    responseFacts &&\n    responseFacts.pendingRecommendation &&\n    typeof responseFacts.pendingRecommendation === 'object'\n);\n\nvar now = new Date($context.$system.$currentDateTime);\nvar localeDate = now.toLocaleString('en-IN');\n\nvar workflowResponse = {\n    id: 'planEditorResult'\n};\n\nif (hasPlanChange) {\n    workflowResponse.type = 'chip';\n    workflowResponse.headerText = responseText;\n    workflowResponse.primaryText = labelText;\n    workflowResponse.secondaryText = localeDate;\n    workflowResponse.icon = 'oj-ux-ico-edit';\n    workflowResponse.postback = response;\n} else {\n    workflowResponse.type = 'text';\n    workflowResponse.text = responseText;\n    workflowResponse.reply = responseText;\n    workflowResponse.operation = response.operation ? String(response.operation) : null;\n    if (hasPendingRecommendation) {\n        workflowResponse.postback = response;\n    }\n}\n\nvar result = new Object();\nresult.workflowResponse = workflowResponse;\n\nreturn result;"
          },
          "outcomes": {
            "success": "65"
          },
          "inputs": [],
          "diagram": {
            "x": 5450,
            "y": 9020
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "32",
          "code": "APPLY_PRECHECK_OUTPUT",
          "type": "CODE",
          "metadata": {
            "name": "Apply Precheck Output",
            "returnType": "object",
            "sourceCode": "// APPLY_PRECHECK_OUTPUT - Merge compact precheck output into the plan editor response.\n\nvar baseResponseRaw = $context.$nodes.APPLY_RESPONSE_COMPOSER_OUTPUT\n  ? $context.$nodes.APPLY_RESPONSE_COMPOSER_OUTPUT.$output.result\n  : ($context.$nodes.APPLY_PLAN_EDITS ? $context.$nodes.APPLY_PLAN_EDITS.$output.result : null);\nvar precheckRaw = $context.$nodes.CALL_PLAN_PRECHECK ? $context.$nodes.CALL_PLAN_PRECHECK.$output : null;\n\nvar parseMaybeJson = function(value) {\n  var current = value;\n  for (var depth = 0; depth < 3; depth += 1) {\n    if (current === null || current === undefined || current === '') {\n      return null;\n    }\n    if (typeof current !== 'string') {\n      return current;\n    }\n    try {\n      current = JSON.parse(current);\n    } catch (_err) {\n      return null;\n    }\n  }\n  return current;\n};\n\nvar deepClone = function(value) {\n  if (value === null || value === undefined) {\n    return value;\n  }\n  return JSON.parse(JSON.stringify(value));\n};\n\nvar extractPrecheck = function(workflowOutput) {\n  var envelope = parseMaybeJson(workflowOutput);\n  if (!envelope || envelope.output === undefined) {\n    return null;\n  }\n  var child = parseMaybeJson(envelope.output);\n  if (child && child.result) {\n    return parseMaybeJson(child.result);\n  }\n  return child;\n};\n\nvar mapFinding = function(item) {\n  var finding = item ? item : new Object();\n  var compact = {\n    code: finding.code ? String(finding.code) : null,\n    severity: finding.severity ? String(finding.severity) : 'ERROR',\n    path: finding.path ? String(finding.path) : null,\n    message: finding.message ? String(finding.message) : 'Validation issue detected.'\n  };\n\n  if (finding.suggestedAction) {\n    compact.suggestedAction = String(finding.suggestedAction);\n  } else if (finding.repairPromptHint) {\n    compact.suggestedAction = String(finding.repairPromptHint);\n  }\n\n  if (finding.context && typeof finding.context === 'object') {\n    compact.context = deepClone(finding.context);\n  }\n  if (finding.repairHint && typeof finding.repairHint === 'object') {\n    compact.repairHint = deepClone(finding.repairHint);\n  }\n\n  return compact;\n};\n\nvar buildCompactPrecheck = function(precheck) {\n  if (!precheck || typeof precheck !== 'object') {\n    return null;\n  }\n\n  var feedback = precheck.feedback && typeof precheck.feedback === 'object'\n    ? deepClone(precheck.feedback)\n    : null;\n\n  if (!feedback) {\n    var issues = precheck.issues && precheck.issues.length !== undefined ? precheck.issues : [];\n    var warnings = precheck.warnings && precheck.warnings.length !== undefined ? precheck.warnings : [];\n    var findings = [];\n    var i = 0;\n\n    for (i = 0; i < issues.length; i += 1) {\n      findings.push(mapFinding(issues[i]));\n    }\n    for (i = 0; i < warnings.length; i += 1) {\n      findings.push(mapFinding(warnings[i]));\n    }\n\n    feedback = {\n      passed: precheck.passed === true,\n      publishReadiness: precheck.publishReadiness\n        ? String(precheck.publishReadiness)\n        : (precheck.passed === true ? 'READY' : 'BLOCKED'),\n      summary: {\n        errorCount: issues.length,\n        warningCount: warnings.length\n      },\n      findings: findings\n    };\n  }\n\n  feedback.findings = feedback.findings && feedback.findings.length !== undefined\n    ? feedback.findings.slice(0, 20)\n    : [];\n\n  if (!feedback.summary || typeof feedback.summary !== 'object') {\n    feedback.summary = {\n      errorCount: 0,\n      warningCount: 0\n    };\n  }\n\n  var compact = {\n    contractVersion: precheck.contractVersion ? String(precheck.contractVersion) : null,\n    passed: precheck.passed === true,\n    feedback: feedback\n  };\n  if (precheck.appliedMutations && precheck.appliedMutations.length !== undefined && precheck.appliedMutations.length > 0) {\n    compact.appliedMutations = deepClone(precheck.appliedMutations);\n  }\n  return compact;\n};\n\nvar hasPrecheckOutcome = function(precheck) {\n  if (!precheck || typeof precheck !== 'object') {\n    return false;\n  }\n  if (precheck.passed === true || precheck.passed === false) {\n    return true;\n  }\n  return !!(precheck.feedback && (precheck.feedback.passed === true || precheck.feedback.passed === false));\n};\n\nvar sanitizeExistingPrecheck = function(precheck) {\n  if (!precheck || typeof precheck !== 'object') {\n    return null;\n  }\n\n  var clone = deepClone(precheck);\n  if (clone.staticLookups) {\n    delete clone.staticLookups;\n  }\n  return clone;\n};\n\nvar precheckFailureStatus = function(compactPrecheck) {\n  if (!compactPrecheck || !compactPrecheck.feedback || compactPrecheck.feedback.passed !== false) {\n    return null;\n  }\n  var summary = compactPrecheck.feedback.summary && typeof compactPrecheck.feedback.summary === 'object'\n    ? compactPrecheck.feedback.summary\n    : {};\n  var errorCount = Number(summary.errorCount || 0);\n  return errorCount > 0 ? 'PRECHECK_BLOCKED' : 'PRECHECK_WARNING';\n};\n\nvar applyPrecheckStatus = function(responseObj, compactPrecheck) {\n  var status = precheckFailureStatus(compactPrecheck);\n  if (!status || !responseObj || typeof responseObj !== 'object') {\n    return;\n  }\n  if (!responseObj.metadata || typeof responseObj.metadata !== 'object') {\n    responseObj.metadata = new Object();\n  }\n  if (responseObj.metadata.editStatus && responseObj.metadata.editStatus !== status) {\n    responseObj.metadata.appliedEditStatus = responseObj.metadata.editStatus;\n  }\n  responseObj.metadata.editStatus = status;\n  responseObj.metadata.precheckStatus = status;\n\n  if (!responseObj.debug || typeof responseObj.debug !== 'object') {\n    responseObj.debug = new Object();\n  }\n  responseObj.debug.status = status;\n\n  if (responseObj.envelope && typeof responseObj.envelope === 'object') {\n    if (!responseObj.envelope.debug || typeof responseObj.envelope.debug !== 'object') {\n      responseObj.envelope.debug = new Object();\n    }\n    responseObj.envelope.debug.status = status;\n  }\n};\n\nvar response = parseMaybeJson(baseResponseRaw);\nif (!response || typeof response !== 'object') {\n  return typeof baseResponseRaw === 'string' ? baseResponseRaw : JSON.stringify(new Object());\n}\n\nif (response.updatedPlan && typeof response.updatedPlan === 'object') {\n  if (!response.updatedPlan.metadata || typeof response.updatedPlan.metadata !== 'object') {\n    response.updatedPlan.metadata = new Object();\n  }\n  if (response.updatedPlan.metadata.precheck) {\n    response.updatedPlan.metadata.precheck = sanitizeExistingPrecheck(response.updatedPlan.metadata.precheck);\n    if (!response.updatedPlan.metadata.precheck) {\n      delete response.updatedPlan.metadata.precheck;\n    }\n  }\n}\n\nvar precheck = extractPrecheck(precheckRaw);\nif (!hasPrecheckOutcome(precheck)) {\n  if (response.updatedPlan && response.updatedPlan.metadata && response.updatedPlan.metadata.precheck) {\n    delete response.updatedPlan.metadata.precheck;\n  }\n  if (response.precheck !== undefined) {\n    delete response.precheck;\n  }\n  return JSON.stringify(response);\n}\n\nvar compactPrecheck = buildCompactPrecheck(precheck);\nif (compactPrecheck) {\n  if (precheck.resolvedPlan && typeof precheck.resolvedPlan === 'object') {\n    response.updatedPlan = deepClone(precheck.resolvedPlan);\n  }\n  if (response.updatedPlan && typeof response.updatedPlan === 'object') {\n    if (!response.updatedPlan.metadata || typeof response.updatedPlan.metadata !== 'object') {\n      response.updatedPlan.metadata = new Object();\n    }\n    response.updatedPlan.metadata.precheck = compactPrecheck;\n  }\n  response.precheck = deepClone(compactPrecheck);\n  applyPrecheckStatus(response, compactPrecheck);\n}\n\nreturn JSON.stringify(response);"
          },
          "outcomes": {
            "success": "33"
          },
          "inputs": [],
