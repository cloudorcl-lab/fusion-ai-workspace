        {
          "id": "65",
          "code": "BUILD_EDITOR_CONVERSATION_HISTORY",
          "type": "CODE",
          "metadata": {
            "name": "Build Editor Conversation History",
            "returnType": "object",
            "sourceCode": "// BUILD_EDITOR_CONVERSATION_HISTORY - Plan Editor CODE node\n// Maintains a bounded, editor-owned conversation transcript.\n\nvar MAX_TURNS = 6;\nvar MAX_ENTRY_CHARS = 1000;\nvar MAX_HISTORY_CHARS = 6000;\nvar OMITTED_MARKER = '[Earlier editor conversation omitted]';\n\nvar trimText = function(value) {\n  return String(value || '').replace(/^\\s+|\\s+$/g, '');\n};\n\nvar normalizeMessage = function(value) {\n  var text = trimText(value).replace(/\\s+/g, ' ');\n  if (text.length > MAX_ENTRY_CHARS) {\n    return text.substring(0, MAX_ENTRY_CHARS - 20) + ' ... [truncated]';\n  }\n  return text;\n};\n\nvar parseHistoryTurns = function(historyText) {\n  var text = trimText(historyText);\n  if (!text) {\n    return [];\n  }\n  var lines = text.split('\\n');\n  var turns = [];\n  var current = null;\n  for (var idx = 0; idx < lines.length; idx += 1) {\n    var line = lines[idx];\n    if (!line || line === OMITTED_MARKER) {\n      continue;\n    }\n    if (line.charAt(0) === '[' && line.indexOf('User: ') !== 0 && line.indexOf('Editor: ') !== 0) {\n      if (current) {\n        turns.push(current);\n      }\n      current = { header: line, user: '', editor: '' };\n      continue;\n    }\n    if (line.indexOf('User: ') === 0) {\n      if (!current) {\n        current = { header: '[prior turn]', user: '', editor: '' };\n      }\n      current.user = normalizeMessage(line.substring(6));\n      continue;\n    }\n    if (line.indexOf('Editor: ') === 0) {\n      if (!current) {\n        current = { header: '[prior turn]', user: '', editor: '' };\n      }\n      current.editor = normalizeMessage(line.substring(8));\n      continue;\n    }\n    if (current && current.editor) {\n      current.editor = normalizeMessage(current.editor + ' ' + line);\n    } else if (current && current.user) {\n      current.user = normalizeMessage(current.user + ' ' + line);\n    }\n  }\n  if (current) {\n    turns.push(current);\n  }\n  return turns;\n};\n\nvar renderHistoryTurns = function(turns) {\n  var lines = [];\n  for (var idx = 0; idx < turns.length; idx += 1) {\n    var turn = turns[idx] || {};\n    lines.push(turn.header || '[prior turn]');\n    lines.push('User: ' + normalizeMessage(turn.user || ''));\n    lines.push('Editor: ' + normalizeMessage(turn.editor || ''));\n  }\n  return trimText(lines.join('\\n'));\n};\n\nvar parseMaybeJson = function(value) {\n  var current = value;\n  for (var depth = 0; depth < 4; depth += 1) {\n    if (current === null || current === undefined || current === '') {\n      return null;\n    }\n    if (typeof current !== 'string') {\n      return current;\n    }\n    try {\n      current = JSON.parse(current);\n    } catch (_err) {\n      return null;\n    }\n  }\n  return current;\n};\n\nvar extractEditorMessage = function(workflowResponse) {\n  var response = workflowResponse && typeof workflowResponse === 'object'\n    ? workflowResponse\n    : {};\n  if (response.type === 'text') {\n    return response.text || response.reply || '';\n  }\n  if (response.type === 'chip') {\n    return response.headerText || '';\n  }\n  return response.reply || response.text || response.headerText || '';\n};\n\nvar previousHistory = trimText($context.$variables.editorConversationHistory || '');\nvar previousHistoryWasLarge = previousHistory.length > MAX_HISTORY_CHARS;\nvar userMessage = normalizeMessage($context.$variables.userMessage || '');\nvar preparedResponse = $context.$nodes.PREPARE_RESPONSE &&\n  $context.$nodes.PREPARE_RESPONSE.$output &&\n  $context.$nodes.PREPARE_RESPONSE.$output.result\n    ? $context.$nodes.PREPARE_RESPONSE.$output.result.workflowResponse\n    : null;\nvar workflowResponse = parseMaybeJson(preparedResponse) || preparedResponse || {};\nvar editorMessage = normalizeMessage(extractEditorMessage(workflowResponse));\nvar currentDateTime = trimText(\n  ($context.$system && $context.$system.$currentDateTime) ||\n  $context.$variables.currentDateTime ||\n  ''\n);\nvar conversationId = trimText(\n  $context.$variables.conversationId ||\n  ($context.$system && ($context.$system.$conversationId || $context.$system.conversationId)) ||\n  ''\n);\n\nvar turnHeader = currentDateTime ? '[' + currentDateTime + ']' : '[current turn]';\nif (conversationId) {\n  turnHeader += ' conversationId=' + conversationId;\n}\n\nvar turns = parseHistoryTurns(previousHistory);\nif (turns.length === 0 && previousHistory) {\n  turns.push({\n    header: '[prior conversation]',\n    user: '',\n    editor: normalizeMessage(previousHistory)\n  });\n}\nif (userMessage || editorMessage) {\n  turns.push({\n    header: turnHeader,\n    user: userMessage,\n    editor: editorMessage\n  });\n}\n\nvar omitted = previousHistoryWasLarge || turns.length > MAX_TURNS;\nif (omitted) {\n  turns = turns.slice(turns.length - MAX_TURNS);\n}\n\nvar combined = renderHistoryTurns(turns);\nif (combined.length > MAX_HISTORY_CHARS) {\n  omitted = true;\n  combined = combined.substring(combined.length - MAX_HISTORY_CHARS);\n  var firstHeaderIndex = combined.indexOf('\\n[');\n  if (firstHeaderIndex >= 0) {\n    combined = combined.substring(firstHeaderIndex + 1);\n  }\n}\nif (omitted && combined) {\n  combined = OMITTED_MARKER + '\\n' + combined;\n}\n\nreturn {\n  editorConversationHistory: combined\n};"
          },
          "outcomes": {
            "success": "66"
          },
          "inputs": [],
          "diagram": {
