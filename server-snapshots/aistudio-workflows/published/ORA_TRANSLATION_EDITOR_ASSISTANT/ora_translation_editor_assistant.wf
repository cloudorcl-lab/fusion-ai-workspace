{
  "workflowId": "100002355226918",
  "workflowCode": "ORA_TRANSLATION_EDITOR_ASSISTANT",
  "name": "Translation Editor Assistant",
  "description": "Translation Editor Assistant translates strings from source language to target language.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1766158171036"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "description": "End of data pipeline",
            "name": "End"
          },
          "outcomes": {},
          "code": "END",
          "id": "end",
          "inputs": [],
          "type": "END"
        },
        {
          "metadata": {
            "name": "input parser",
            "returnType": "array",
            "sourceCode": "const _src = JSON.parse( $context.$system.$inputMessage );\nconst _res = _src.map(e=>{\n     const min = e.min?? 0;\n     const max = e.max?? 4000;\n     const srcLang = e.srcLang?? 'English';\n     const destLang = e.destLang?? 'English';\n     const data = e.data?? '';\n     const id = e.id;\n     return { id, min, max, srcLang, destLang, data }\n});\n\nreturn _res;"
          },
          "outcomes": {
            "success": "1766158338845"
          },
          "code": "INPUT_PARSER",
          "id": "1766158171036",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "dataPipeline": {
              "pipelineNodes": [
                {
                  "metadata": {
                    "name": "Start",
                    "description": "Start of data pipeline"
                  },
                  "outcomes": {
                    "success": "1766158361967"
                  },
                  "id": "start_1766158338845",
                  "code": "START_1766158338845",
                  "type": "START"
                },
                {
                  "metadata": {
                    "name": "End",
                    "description": "End of data pipeline"
                  },
                  "id": "end_1766158338845",
                  "code": "END_1766158338845",
                  "type": "END"
                },
                {
                  "metadata": {
                    "name": "detect lang"
                  },
                  "outcomes": {
                    "success": "end_1766158338845"
                  },
                  "code": "DETECT_LANG",
                  "id": "1766158361967",
                  "inputs": [
                    {
                      "id": "1766158361968_1",
                      "name": "prompt",
                      "type": "string",
                      "value": "*** Agent Instructions ***\nYou are a smart language detector Agent\n\n## STEPS TO FOLLOW\n- Extract `data`, `srcLang`, `destLang` and `id` fields from {{$context.$nodes.DETECT_LOOPER.$currentItem}}\n- Detect the language of `data` and store it in `detectedLang` variable\n- If detected language is same as `srcLang` then store 'true' in `sameSrcLang` variable, else store 'false'\n- If detected language is same as `destLang` then store 'true' in `sameDestLang` variable, else store 'false'\n- Return `id`, `sameSrcLang`, `sameDestLang` and `detectedLang` variables"
                    }
                  ],
                  "outputSpecification": "{\n    \"type\": \"object\",\n    \"properties\": {\n        \"id\": {\n            \"type\": \"number\"\n        },\n        \"detectedLang\": {\n            \"type\": \"string\"\n        },\n        \"sameSrcLang\": {\n            \"type\": \"boolean\"\n        },\n        \"sameDestLang\": {\n            \"type\": \"boolean\"\n        }\n   }\n}",
                  "type": "LLM"
                }
              ],
              "rootNode": "start_1766158338845"
            },
            "loopType": "PARALLEL",
            "name": "detect looper"
          },
          "outcomes": {
            "success": "1766158399846"
          },
          "code": "DETECT_LOOPER",
          "id": "1766158338845",
          "inputs": [
            {
              "id": "1766158338846_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.INPUT_PARSER.$output.result}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "merger",
            "returnType": "array",
            "sourceCode": "\nconst detArray = $context.$nodes.DETECT_LOOPER.$output ;\nconst inputArray = $context.$nodes.INPUT_PARSER.$output.result ;\n\nconst outputArray = [];\n\nconst detMap = new Map();\ndetArray.forEach(e=>{\n     const ejson = JSON.parse(e);\n     const id = Number(ejson.id);\n     detMap.set(id, ejson );\n});\n\ninputArray.forEach(e=>{\n     const id = Number(e.id);\n     const detjson = detMap.get(id);\n     if(detjson == undefined)\n        return;\n     e.detectedLang = detjson.detectedLang?? 'English';\n     e.sameDestLang = detjson.sameDestLang?? false;\n     e.sameSrcLang = detjson.sameSrcLang?? false;\n\n     if(detjson.sameDestLang) {\n           e.noTranslation = true;\n     } else {\n           e.noTranslation = false;\n           if(detjson.sameSrcLang) {\n                e.finalSrcLang = e.srcLang;\n           } else {\n                e.finalSrcLang = detjson.detectedLang;\n           }\n     }\n     outputArray.push({id: e.id, data: e.data, max: e.max, noTranslation: e.noTranslation, finalSrcLang: e.finalSrcLang, destLang: e.destLang});\n});\n\nreturn outputArray;"
          },
          "outcomes": {
            "success": "1766158439582"
          },
          "code": "MERGER",
          "id": "1766158399846",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "dataPipeline": {
              "pipelineNodes": [
                {
                  "metadata": {
                    "name": "Start",
                    "description": "Start of data pipeline"
                  },
                  "outcomes": {
                    "success": "1766158452798"
                  },
                  "id": "start_1766158439582",
                  "code": "START_1766158439582",
                  "type": "START"
                },
                {
                  "metadata": {
                    "name": "End",
                    "description": "End of data pipeline"
                  },
                  "id": "end_1766158439582",
                  "code": "END_1766158439582",
                  "type": "END"
                },
                {
                  "metadata": {
                    "name": "translator node"
                  },
                  "outcomes": {
                    "success": "end_1766158439582"
                  },
                  "code": "TRANSLATOR_NODE",
                  "id": "1766158452798",
                  "inputs": [
                    {
                      "id": "1766158452800_1",
                      "name": "prompt",
                      "type": "string",
                      "value": "*** Agent Instructions *** \nYou are a smart translator that translates text in another language\n\n## IMPORTANT PRE-PROCESSING STEPS\n- Extract below fields from {{$context.$nodes.PARALLEL_TRANSLATOR_LOOP.$currentItem}} \n      - `id`\n      - `data`\n      - `max`\n      - `noTranslation`\n      - `finalSrcLang`\n      - `destLang`\n\n## STEPS FOR TRANSLATION\n- If\n    - `noTranslation` is 'true' then rephrase the text **`data`** in `destLang` language ensuring the output with maximum of **`max`** characters length and store it as **`text`** parameter\n- Else\n    - Translate **`data`** from `finalSrcLang`  into `destLang` language ensuring the output with maximum of **`max`** characters length and store it as **`text`** parameter\n- Return **`text`** and **`id`** parameters\n\n\n*** IMPORTANT INSTRUCTIONS FOR TRANSLATION *** \n- DO NOT try to understand the user intent\n- If the provided text is small then consider the text as a UI label and return ONLY the direct, dictionary-equivalent translation\n- DO NOT replace words with descriptions or definitions\n- DO NOT form full sentences unless the input is a full sentence\n- Make sure the translation is brief and sounds professional, polite and friendly for business setting\n- Always return proper JSON format output\n- DO NOT add any new lines in the output\n- DO NOT add any kind of details of the context, like character count or translation settings, in the translation response\n- DO NOT expect any other information for the translation, just translate as it is\n- DO NOT any additional prefix similar to 'this translates to' or anything, just translate as it is\n- If the provided data is a unique id or does not seems to be translatable then return it as is\n- Keep the HTML tags in the result as well\n- If there are any HTML tags in between the text, make sure the translated text should contain those HTML tags as-is"
                    }
                  ],
                  "outputSpecification": "{\n    \"type\": \"object\",\n    \"properties\": {\n        \"id\": {\n            \"type\": \"number\"\n        },\n        \"text\": {\n            \"type\": \"string\"\n        }\n    }\n}",
                  "type": "LLM"
                }
              ],
              "rootNode": "start_1766158439582"
            },
            "loopType": "PARALLEL",
            "name": "parallel translator loop"
          },
          "outcomes": {
            "success": "1766158488976"
          },
          "code": "PARALLEL_TRANSLATOR_LOOP",
          "id": "1766158439582",
          "inputs": [
            {
              "id": "1766158439584_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.MERGER.$output.result}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "sanitize output",
            "returnType": "array",
            "sourceCode": "let result = [];\nconst outputStrList = $context.$nodes.PARALLEL_TRANSLATOR_LOOP.$output \noutputStrList.forEach(e => {\n     result.push(JSON.parse(e));\n});\n\nreturn result;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "SANITIZE_OUTPUT",
          "id": "1766158488976",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
      ],
