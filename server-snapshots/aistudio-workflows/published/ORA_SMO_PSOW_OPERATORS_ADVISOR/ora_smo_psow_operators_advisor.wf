        {
          "metadata": {
            "name": "Prepare Operator Qualification Checks",
            "returnType": "object",
            "sourceCode": "let summaryResponse = $context.$nodes.EXTRACT_WORKSTATION_WO_OPERATION_SUMMARY.$output;\n\nif (typeof summaryResponse === 'string') {\n  summaryResponse = JSON.parse(summaryResponse);\n}\n\nconst workstationDetails = Array.isArray(summaryResponse?.result?.workstationIdToWoOperationDetails)\n  ? summaryResponse.result.workstationIdToWoOperationDetails\n  : Array.isArray(summaryResponse?.workstationIdToWoOperationDetails)\n    ? summaryResponse.workstationIdToWoOperationDetails\n    : [];\n\nconst qualificationChecks = [];\n\nfor (let i = 0; i < workstationDetails.length; i++) {\n  const workstation = workstationDetails[i] || {};\n  const workstationId = workstation.WorkstationId ?? workstation.workstationId ?? null;\n  const qualificationOperations = Array.isArray(workstation.qualificationOperations)\n    ? workstation.qualificationOperations\n    : [];\n  const operators = Array.isArray(workstation.Operators)\n    ? workstation.Operators\n    : [];\n\n  for (let j = 0; j < qualificationOperations.length; j++) {\n    const operation = qualificationOperations[j] || {};\n    const woOperationId = operation.WoOperationId ?? operation.woOperationId ?? null;\n    const profileId = operation.ProfileId ?? operation.profileId ?? null;\n    const profileCode = operation.ProfileCode ?? operation.profileCode ?? null;\n\n    if (profileId == null) {\n      continue;\n    }\n\n    for (let k = 0; k < operators.length; k++) {\n      const operatorInfo = operators[k] || {};\n      const operator = operatorInfo.operator ?? operatorInfo.Operator ?? null;\n      const laborInstanceId = operatorInfo.laborInstanceId ?? operatorInfo.LaborInstanceId ?? null;\n\n      if (laborInstanceId == null) {\n        continue;\n      }\n\n      qualificationChecks.push({\n        WorkstationId: workstationId,\n        WoOperationId: woOperationId,\n        ProfileId: String(profileId),\n        ProfileCode: profileCode,\n        operator: operator,\n        laborInstanceId: String(laborInstanceId)\n      });\n    }\n  }\n}\n\nconst result = {\n  qualificationChecks\n};\n\nreturn result;"
          },
