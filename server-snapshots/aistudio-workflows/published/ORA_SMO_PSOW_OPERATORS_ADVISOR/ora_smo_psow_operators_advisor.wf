        {
          "metadata": {
            "name": "Extract Assigned Operators",
            "returnType": "object",
            "sourceCode": "let data = $context.$nodes.GET_ASSIGNED_OPERATORS.$output;\n\nif (typeof data === 'string') {\n  data = JSON.parse(data);\n}\n\nconst outputArray = [];\n\nfor (let i = 0; i < data.items.length; i++) {\n  const item = data.items[i];\n\n  if (item.CurrentlyAssignedFlag !== true) {\n    continue;\n  }\n\n  const operator = item.PersonDisplayName;\n  const isCheckedIn = item.CurrentlyCheckedinFlag;\n  const laborInstanceId = item.LaborInstanceId ?? item.LaborinstanceId ?? null;\n  const rawWorkstationId = item.WorkstationId ?? item.workstationId ?? null;\n  const workstationsStr = item.Workstations || '';\n  const workstations = workstationsStr.split(',');\n\n  for (let j = 0; j < workstations.length; j++) {\n    const workstation = workstations[j].trim();\n\n    if (!workstation) {\n      continue;\n    }\n\n    const workstationId = rawWorkstationId ?? workstation;\n\n    outputArray.push({\n      operator,\n      workstation,\n      workstationId,\n      laborInstanceId,\n      isCheckedIn\n    });\n  }\n}\n\nconst result = outputArray;\n\nreturn result;"
          },
          "outcomes": {
            "success": "1770947834518"
          },
          "code": "EXTRACT_ASSIGNED_OPERATORS",
          "id": "1768008308528",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
