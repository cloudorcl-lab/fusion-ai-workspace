        {
          "metadata": {
            "name": "Extract Shifts",
            "returnType": "object",
            "sourceCode": "const shifts = $context.$nodes.GET_SHIFT_DETAILS.$output.result;\n\nconst currentShift = shifts.find(shift => shift.ShiftType === \"CURRENT_SHIFT\");\n\nconst previousShift = shifts.find(shift => shift.ShiftType === \"PREVIOUS_SHIFT\");\n\nconst shiftTimes = {\n    currentShiftStartTime : currentShift.StartDateTimeUTC,\n    currentShiftEndTime : currentShift.EndDateTimeUTC,\n    currentShiftId : currentShift.ShiftId,\n    currentShiftDate : currentShift.StartDateTimeUTC.split('T')[0],\n    previousShiftStartTime : previousShift.StartDateTimeUTC,\n    previousShiftEndTime : previousShift.EndDateTimeUTC\n};\n\nreturn shiftTimes"
          },
          "outcomes": {
            "success": "1763752762423"
          },
          "code": "EXTRACT_SHIFTS",
          "id": "1770844419374",
