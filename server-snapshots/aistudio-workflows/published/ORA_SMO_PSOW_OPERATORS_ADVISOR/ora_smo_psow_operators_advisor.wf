        {
          "metadata": {
            "name": "Extract Workstation Wo Operation Summary",
            "returnType": "object",
            "sourceCode": "let shiftAssignmentResponse = $context.$nodes.GET_SHIFT_WORKSTATION_OPERATION_ASSIGNMENTS.$output;\nlet qualificationResponse = $context.$nodes.GET_WORKORDER_OPERATIONS_RESOURCES_WITH_QUALIFICATION.$output;\nlet assignedOperatorsResponse = $context.$nodes.EXTRACT_ASSIGNED_OPERATORS.$output;\n\nif (typeof shiftAssignmentResponse === 'string') {\n  shiftAssignmentResponse = JSON.parse(shiftAssignmentResponse);\n}\n\nif (typeof qualificationResponse === 'string') {\n  qualificationResponse = JSON.parse(qualificationResponse);\n}\n\nif (typeof assignedOperatorsResponse === 'string') {\n  assignedOperatorsResponse = JSON.parse(assignedOperatorsResponse);\n}\n\nconst shiftAssignmentEntries = Array.isArray(shiftAssignmentResponse?.items)\n  ? shiftAssignmentResponse.items\n  : [];\n\nconst qualificationEntries = Array.isArray(qualificationResponse?.items)\n  ? qualificationResponse.items\n  : [];\n\nconst assignedOperatorEntries = Array.isArray(assignedOperatorsResponse?.result)\n  ? assignedOperatorsResponse.result\n  : Array.isArray(assignedOperatorsResponse)\n    ? assignedOperatorsResponse\n    : [];\n\nconst qualificationByWoOperationId = {};\n\nfor (let i = 0; i < qualificationEntries.length; i++) {\n  const entry = qualificationEntries[i] || {};\n  const woOperationId = entry.WoOperationId ?? entry.woOperationId;\n\n  if (woOperationId == null) {\n    continue;\n  }\n\n  const woOperationKey = String(woOperationId);\n  const profileId = entry.ProfileId ?? null;\n  const profileCode = entry.ProfileCode ?? null;\n\n  if (!qualificationByWoOperationId[woOperationKey]) {\n    qualificationByWoOperationId[woOperationKey] = {\n      ProfileId: profileId,\n      ProfileCode: profileCode\n    };\n    continue;\n  }\n\n  const existing = qualificationByWoOperationId[woOperationKey];\n\n  if (existing.ProfileId == null && profileId != null) {\n    existing.ProfileId = profileId;\n  }\n\n  if (existing.ProfileCode == null && profileCode != null) {\n    existing.ProfileCode = profileCode;\n  }\n}\n\nconst detailsByWorkstationId = {};\nconst seenWoOpsByWorkstation = {};\n\nfor (let i = 0; i < shiftAssignmentEntries.length; i++) {\n  const entry = shiftAssignmentEntries[i] || {};\n  const workstationId = entry.WorkstationId;\n  const woOperationId = entry.WoOperationId;\n\n  if (workstationId == null || woOperationId == null) {\n    continue;\n  }\n\n  const workstationKey = String(workstationId);\n  const woOperationKey = String(woOperationId);\n\n  if (!detailsByWorkstationId[workstationKey]) {\n    detailsByWorkstationId[workstationKey] = {\n      operations: [],\n      qualificationOperations: []\n    };\n    seenWoOpsByWorkstation[workstationKey] = new Set();\n  }\n\n  if (seenWoOpsByWorkstation[workstationKey].has(woOperationKey)) {\n    continue;\n  }\n\n  seenWoOpsByWorkstation[workstationKey].add(woOperationKey);\n\n  const qualification = qualificationByWoOperationId[woOperationKey] || {\n    ProfileId: null,\n    ProfileCode: null\n  };\n\n  if (qualification.ProfileId == null) {\n    detailsByWorkstationId[workstationKey].operations.push({\n      WoOperationId: woOperationKey,\n      OperationName: entry.OperationName ?? null,\n      WorkOrderNumber: entry.WorkOrderNumber ?? null,\n      OperationSequenceNumber: entry.OperationSequenceNumber ?? null,\n      WorkOrderId: entry.WorkOrderId ?? null\n    });\n  } else {\n    detailsByWorkstationId[workstationKey].qualificationOperations.push({\n      WoOperationId: woOperationKey,\n      OperationName: entry.OperationName ?? null,\n      WorkOrderNumber: entry.WorkOrderNumber ?? null,\n      OperationSequenceNumber: entry.OperationSequenceNumber ?? null,\n      WorkOrderId: entry.WorkOrderId ?? null,\n      ProfileId: qualification.ProfileId,\n      ProfileCode: qualification.ProfileCode\n    });\n  }\n}\n\nconst operatorsByWorkstationId = {};\nconst seenOperatorsByWorkstation = {};\n\nfor (let i = 0; i < assignedOperatorEntries.length; i++) {\n  const entry = assignedOperatorEntries[i] || {};\n  const workstationId = entry.workstationId ?? entry.WorkstationId;\n\n  if (workstationId == null) {\n    continue;\n  }\n\n  const workstationKey = String(workstationId);\n\n  if (!operatorsByWorkstationId[workstationKey]) {\n    operatorsByWorkstationId[workstationKey] = [];\n    seenOperatorsByWorkstation[workstationKey] = new Set();\n  }\n\n  const operator = entry.operator ?? entry.Operator ?? null;\n  const laborInstanceId = entry.laborInstanceId ?? entry.LaborInstanceId ?? null;\n  const operatorKey = `${operator ?? ''}|${laborInstanceId ?? ''}`;\n\n  if (seenOperatorsByWorkstation[workstationKey].has(operatorKey)) {\n    continue;\n  }\n\n  seenOperatorsByWorkstation[workstationKey].add(operatorKey);\n  operatorsByWorkstationId[workstationKey].push({\n    operator,\n    laborInstanceId\n  });\n}\n\nconst allWorkstationIds = new Set([\n  ...Object.keys(detailsByWorkstationId),\n  ...Object.keys(operatorsByWorkstationId)\n]);\n\nconst workstationIdToWoOperationDetails = Array.from(allWorkstationIds).map(workstationId => ({\n  WorkstationId: workstationId,\n  operations: detailsByWorkstationId[workstationId]?.operations || [],\n  qualificationOperations: detailsByWorkstationId[workstationId]?.qualificationOperations || [],\n  Operators: operatorsByWorkstationId[workstationId] || []\n}));\n\nconst result = {\n  workstationIdToWoOperationDetails\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1770947834522"
          },
          "code": "EXTRACT_WORKSTATION_WO_OPERATION_SUMMARY",
