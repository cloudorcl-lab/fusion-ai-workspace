                    "name": "Build Workstation Execution Duration",
                    "returnType": "object",
                    "sourceCode": "const workstationId = $context.$nodes.LOOP_WORKSTATION_EXECUTION_DURATIONS.$currentItem;\nlet sessionsResponse = $context.$nodes.GET_SHIFT_EXECUTION_SESSIONS_BY_WORKSTATION.$output;\n\nif (typeof sessionsResponse === 'string') {\n  sessionsResponse = JSON.parse(sessionsResponse);\n}\n\nconst items = Array.isArray(sessionsResponse?.items) ? sessionsResponse.items : [];\nlet executionDurationInSecs = 0;\n\nfor (let i = 0; i < items.length; i++) {\n  const duration = Number(items[i]?.ExecutionSessionDuration);\n\n  if (Number.isFinite(duration)) {\n    executionDurationInSecs += duration;\n  }\n}\n\nconst result = {\n  workstationId,\n  executionDurationInSecs\n};\n\nreturn result;"
