            "returnType": "object",
            "sourceCode": "let assignedOperators = $context.$nodes.EXTRACT_ASSIGNED_OPERATORS.$output;\n\nif (typeof assignedOperators === 'string') {\n  assignedOperators = JSON.parse(assignedOperators);\n}\n\nconst operators = Array.isArray(assignedOperators)\n  ? assignedOperators\n  : Array.isArray(assignedOperators?.result)\n    ? assignedOperators.result\n    : [];\n\nconst workstationIds = [];\nconst seenWorkstationIds = new Set();\n\nfor (let i = 0; i < operators.length; i++) {\n  const workstationId = operators[i]?.workstationId;\n\n  if (workstationId == null) {\n    continue;\n  }\n\n  const normalizedWorkstationId = String(workstationId);\n\n  if (seenWorkstationIds.has(normalizedWorkstationId)) {\n    continue;\n  }\n\n  seenWorkstationIds.add(normalizedWorkstationId);\n  workstationIds.push(workstationId);\n}\n\nconst result = {\n  workstationIds\n};\n\nreturn result;"
