            "name": "Build WooIds For Qualification",
            "returnType": "object",
            "sourceCode": "let response = $context.$nodes.GET_SHIFT_WORKSTATION_OPERATION_ASSIGNMENTS.$output;\n\nif (typeof response === 'string') {\n  response = JSON.parse(response);\n}\n\nconst entries = Array.isArray(response?.items) ? response.items : [];\nconst distinctWoOperationIds = new Set();\n\nfor (let i = 0; i < entries.length; i++) {\n  const entry = entries[i] || {};\n  const woOperationId = entry.WoOperationId;\n\n  if (woOperationId == null) {\n    continue;\n  }\n\n  distinctWoOperationIds.add(String(woOperationId));\n}\n\nconst distinctQuotedWoOperationIds = Array.from(distinctWoOperationIds)\n  .map(id => `'${id}'`)\n  .join(',');\n\nconst result = {\n  distinctQuotedWoOperationIds\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1770947834520"
          },
          "code": "BUILD_WOO_IDS_FOR_QUALIFICATION",
