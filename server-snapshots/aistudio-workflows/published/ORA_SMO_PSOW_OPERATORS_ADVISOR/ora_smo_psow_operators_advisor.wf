            "name": "Build Clean Workstation Execution Output",
            "returnType": "object",
            "sourceCode": "let loopOutput = $context.$nodes.LOOP_WORKSTATION_EXECUTION_DURATIONS.$output;\n\nif (typeof loopOutput === 'string') {\n  try {\n    loopOutput = JSON.parse(loopOutput);\n  } catch (e) {\n    loopOutput = [];\n  }\n}\n\nconst iterations = Array.isArray(loopOutput)\n  ? loopOutput\n  : Array.isArray(loopOutput?.result)\n    ? loopOutput.result\n    : [];\n\nconst normalized = [];\n\nfor (let i = 0; i < iterations.length; i++) {\n  let iteration = iterations[i];\n\n  if (typeof iteration === 'string') {\n    try {\n      iteration = JSON.parse(iteration);\n    } catch (e) {\n      continue;\n    }\n  }\n\n  const payload = iteration?.result ?? iteration;\n  const workstationId = payload?.workstationId;\n\n  if (workstationId == null) {\n    continue;\n  }\n\n  const executionDurationInSecs = Number(payload?.executionDurationInSecs);\n\n  normalized.push({\n    workstationId: String(workstationId),\n    executionDurationInSecs: Number.isFinite(executionDurationInSecs) ? executionDurationInSecs : 0\n  });\n}\n\nconst result = normalized;\n\nreturn result;"
          },
