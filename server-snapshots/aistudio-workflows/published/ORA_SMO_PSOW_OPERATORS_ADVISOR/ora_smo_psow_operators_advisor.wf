        {
          "metadata": {
            "name": "Build Workstation Operator Qualification Status",
            "returnType": "object",
            "sourceCode": "let summaryResponse = $context.$nodes.EXTRACT_WORKSTATION_WO_OPERATION_SUMMARY.$output;\nlet preparedChecksResponse = $context.$nodes.PREPARE_OPERATOR_QUALIFICATION_CHECKS.$output;\nlet loopResponses = $context.$nodes.DETERMINE_OPERATOR_QUALIFICATIONS.$output;\n\nif (typeof summaryResponse === 'string') {\n  summaryResponse = JSON.parse(summaryResponse);\n}\n\nif (typeof preparedChecksResponse === 'string') {\n  preparedChecksResponse = JSON.parse(preparedChecksResponse);\n}\n\nif (typeof loopResponses === 'string') {\n  loopResponses = JSON.parse(loopResponses);\n}\n\nconst workstationDetails = Array.isArray(summaryResponse?.result?.workstationIdToWoOperationDetails)\n  ? summaryResponse.result.workstationIdToWoOperationDetails\n  : Array.isArray(summaryResponse?.workstationIdToWoOperationDetails)\n    ? summaryResponse.workstationIdToWoOperationDetails\n    : [];\n\nconst qualificationChecks = Array.isArray(preparedChecksResponse?.result?.qualificationChecks)\n  ? preparedChecksResponse.result.qualificationChecks\n  : Array.isArray(preparedChecksResponse?.qualificationChecks)\n    ? preparedChecksResponse.qualificationChecks\n    : [];\n\nconst responsesByIndex = Array.isArray(loopResponses)\n  ? loopResponses\n  : Array.isArray(loopResponses?.result)\n    ? loopResponses.result\n    : [];\n\nconst startDate = $context.$nodes.EXTRACT_SHIFTS.$output.result.currentShiftDate;\n\nconst operationDetailsByWsAndOp = {};\nfor (let i = 0; i < workstationDetails.length; i++) {\n  const workstation = workstationDetails[i] || {};\n  const wsId = workstation.WorkstationId;\n  const wsKey = String(wsId);\n  const qualificationOperations = Array.isArray(workstation.qualificationOperations)\n    ? workstation.qualificationOperations\n    : [];\n\n  if (!operationDetailsByWsAndOp[wsKey]) {\n    operationDetailsByWsAndOp[wsKey] = {};\n  }\n\n  for (let j = 0; j < qualificationOperations.length; j++) {\n    const operation = qualificationOperations[j] || {};\n    const woOperationId = operation.WoOperationId;\n\n    if (woOperationId == null) {\n      continue;\n    }\n\n    const opKey = String(woOperationId);\n    operationDetailsByWsAndOp[wsKey][opKey] = {\n      OperationName: operation.OperationName ?? null,\n      WorkOrderNumber: operation.WorkOrderNumber ?? null,\n      OperationSequenceNumber: operation.OperationSequenceNumber ?? null,\n      WorkOrderId: operation.WorkOrderId ?? null\n    };\n  }\n}\n\nconst statusByWsAndOp = {};\n\nfor (let i = 0; i < qualificationChecks.length; i++) {\n  const check = qualificationChecks[i] || {};\n  const workstationId = check.WorkstationId ?? null;\n  const woOperationId = check.WoOperationId ?? null;\n  const profileId = check.ProfileId ?? null;\n  const profileCode = check.ProfileCode ?? null;\n  const operator = check.operator ?? null;\n  const laborInstanceId = check.laborInstanceId ?? null;\n\n  if (workstationId == null || woOperationId == null) {\n    continue;\n  }\n\n  let iterationResponse = responsesByIndex[i];\n  if (typeof iterationResponse === 'string') {\n    try {\n      iterationResponse = JSON.parse(iterationResponse);\n    } catch (e) {\n      iterationResponse = null;\n    }\n  }\n\n  const failedResult = Array.isArray(iterationResponse?.result)\n    ? iterationResponse.result\n    : [];\n\n  let isQualified = true;\n\n  if (failedResult.length > 0) {\n    isQualified = !failedResult.some(item => {\n      const failedProfileId = item.profileId ?? item.ProfileId ?? null;\n      const failedResourceIds = item.resourceInstanceIds ?? item.ResourceInstanceIds ?? null;\n      const failedStartDate = item.startDate ?? item.StartDate ?? startDate;\n\n      return String(failedProfileId) === String(profileId)\n        && String(failedResourceIds) === String(laborInstanceId)\n        && String(failedStartDate) === String(startDate);\n    });\n  }\n\n  const wsKey = String(workstationId);\n  const opKey = String(woOperationId);\n\n  if (!statusByWsAndOp[wsKey]) {\n    statusByWsAndOp[wsKey] = {};\n  }\n\n  if (!statusByWsAndOp[wsKey][opKey]) {\n    const operationDetails = operationDetailsByWsAndOp?.[wsKey]?.[opKey] || {};\n\n    statusByWsAndOp[wsKey][opKey] = {\n      WoOperationId: opKey,\n      OperationName: operationDetails.OperationName ?? null,\n      WorkOrderNumber: operationDetails.WorkOrderNumber ?? null,\n      OperationSequenceNumber: operationDetails.OperationSequenceNumber ?? null,\n      WorkOrderId: operationDetails.WorkOrderId ?? null,\n      ProfileId: profileId,\n      ProfileCode: profileCode,\n      Operators: []\n    };\n  }\n\n  const operatorKey = `${operator ?? ''}|${laborInstanceId ?? ''}`;\n  const existingOperators = statusByWsAndOp[wsKey][opKey].Operators;\n  const exists = existingOperators.some(op => `${op.operator ?? ''}|${op.laborInstanceId ?? ''}` === operatorKey);\n\n  if (!exists) {\n    existingOperators.push({\n      operator,\n      laborInstanceId,\n      isQualified\n    });\n  }\n}\n\nconst workstationQualificationStatus = workstationDetails.map(workstation => {\n  const workstationId = workstation.WorkstationId;\n  const wsKey = String(workstationId);\n  const qualificationOperations = Array.isArray(workstation.qualificationOperations)\n    ? workstation.qualificationOperations\n    : [];\n  const operations = Array.isArray(workstation.operations)\n    ? workstation.operations\n    : [];\n\n  const operationQualifications = qualificationOperations.map(operation => {\n    const woOperationId = operation.WoOperationId;\n    const opKey = String(woOperationId);\n\n    return statusByWsAndOp?.[wsKey]?.[opKey] || {\n      WoOperationId: woOperationId,\n      OperationName: operation.OperationName ?? null,\n      WorkOrderNumber: operation.WorkOrderNumber ?? null,\n      OperationSequenceNumber: operation.OperationSequenceNumber ?? null,\n      WorkOrderId: operation.WorkOrderId ?? null,\n      ProfileId: operation.ProfileId ?? null,\n      ProfileCode: operation.ProfileCode ?? null,\n      Operators: []\n    };\n  });\n\n  return {\n    WorkstationId: workstationId,\n    operations,\n    operationQualifications\n  };\n});\n\nconst result = {\n  workstationQualificationStatus\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1770947834532"
          },
          "code": "BUILD_WORKSTATION_OPERATOR_QUALIFICATION_STATUS",
          "id": "1770947834524",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Merge Assigned Operators With Qualification Status",
            "returnType": "object",
            "sourceCode": "let assignedOperatorsResponse = $context.$nodes.EXTRACT_ASSIGNED_OPERATORS.$output;\nlet qualificationStatusResponse = $context.$nodes.BUILD_WORKSTATION_OPERATOR_QUALIFICATION_STATUS.$output;\n\nif (typeof assignedOperatorsResponse === 'string') {\n  assignedOperatorsResponse = JSON.parse(assignedOperatorsResponse);\n}\n\nif (typeof qualificationStatusResponse === 'string') {\n  qualificationStatusResponse = JSON.parse(qualificationStatusResponse);\n}\n\nconst assignedOperators = Array.isArray(assignedOperatorsResponse)\n  ? assignedOperatorsResponse\n  : Array.isArray(assignedOperatorsResponse?.result)\n    ? assignedOperatorsResponse.result\n    : [];\n\nconst workstationQualificationStatus = Array.isArray(qualificationStatusResponse?.result?.workstationQualificationStatus)\n  ? qualificationStatusResponse.result.workstationQualificationStatus\n  : Array.isArray(qualificationStatusResponse?.workstationQualificationStatus)\n    ? qualificationStatusResponse.workstationQualificationStatus\n    : [];\n\nconst workstationMetaByWs = {};\nconst qualificationByWsAndLabor = {};\n\nfor (let i = 0; i < workstationQualificationStatus.length; i++) {\n  const workstationEntry = workstationQualificationStatus[i] || {};\n  const workstationId = workstationEntry.WorkstationId;\n\n  if (workstationId == null) {\n    continue;\n  }\n\n  const wsKey = String(workstationId);\n  const operations = Array.isArray(workstationEntry.operations)\n    ? workstationEntry.operations\n    : [];\n  const operationQualifications = Array.isArray(workstationEntry.operationQualifications)\n    ? workstationEntry.operationQualifications\n    : [];\n\n  workstationMetaByWs[wsKey] = {\n    operationsCount: operations.length,\n    operationQualificationsCount: operationQualifications.length\n  };\n\n  if (!qualificationByWsAndLabor[wsKey]) {\n    qualificationByWsAndLabor[wsKey] = {};\n  }\n\n  for (let j = 0; j < operationQualifications.length; j++) {\n    const operation = operationQualifications[j] || {};\n    const woOperationId = operation.WoOperationId ?? null;\n    const operationIdentifier = String(woOperationId ?? `${j}`);\n    const woRef = `${operation.WorkOrderNumber ?? \"\"}-${operation.OperationSequenceNumber ?? \"\"}`.replace(/^[-]+|[-]+$/g, \"\").trim();\n    const operators = Array.isArray(operation.Operators) ? operation.Operators : [];\n\n    for (let k = 0; k < operators.length; k++) {\n      const operatorEntry = operators[k] || {};\n      const laborInstanceId = operatorEntry.laborInstanceId ?? operatorEntry.LaborInstanceId ?? null;\n\n      if (laborInstanceId == null) {\n        continue;\n      }\n\n      const laborKey = String(laborInstanceId);\n\n      if (!qualificationByWsAndLabor[wsKey][laborKey]) {\n        qualificationByWsAndLabor[wsKey][laborKey] = {\n          qualifiedOperationIds: new Set(),\n          notQualifiedOperationIds: new Set(),\n          notQualifiedRefs: []\n        };\n      }\n\n      const bucket = qualificationByWsAndLabor[wsKey][laborKey];\n      const isQualified = operatorEntry.isQualified === true;\n\n      if (isQualified) {\n        bucket.qualifiedOperationIds.add(operationIdentifier);\n      } else {\n        bucket.notQualifiedOperationIds.add(operationIdentifier);\n        if (woRef) {\n          bucket.notQualifiedRefs.push(woRef);\n        }\n      }\n    }\n  }\n}\n\nconst result = assignedOperators.map(entry => {\n  const workstationId = entry.workstationId ?? entry.WorkstationId ?? null;\n  const laborInstanceId = entry.laborInstanceId ?? entry.LaborInstanceId ?? null;\n\n  const wsKey = String(workstationId ?? '');\n  const laborKey = String(laborInstanceId ?? '');\n  const wsMeta = workstationMetaByWs?.[wsKey] || {\n    operationsCount: 0,\n    operationQualificationsCount: 0\n  };\n  const bucket = qualificationByWsAndLabor?.[wsKey]?.[laborKey] || {\n    qualifiedOperationIds: new Set(),\n    notQualifiedOperationIds: new Set(),\n    notQualifiedRefs: []\n  };\n\n  const qualifiedCount = bucket.qualifiedOperationIds.size;\n  const notQualifiedCount = bucket.notQualifiedOperationIds.size;\n  const totalOperationQualifications = wsMeta.operationQualificationsCount;\n  const hasOperations = wsMeta.operationsCount > 0;\n\n  let qualificationStatus = 'QUALIFIED';\n\n  if (totalOperationQualifications === 0) {\n    qualificationStatus = 'QUALIFIED';\n  } else {\n    const isQualifiedForAll = qualifiedCount === totalOperationQualifications;\n    const isNotQualifiedForAll = notQualifiedCount === totalOperationQualifications;\n\n    if (!hasOperations) {\n      if (isQualifiedForAll) {\n        qualificationStatus = 'QUALIFIED';\n      } else if (isNotQualifiedForAll) {\n        qualificationStatus = 'NOT QUALIFIED';\n      } else {\n        qualificationStatus = 'PARTIALLY QUALIFIED';\n      }\n    } else {\n      qualificationStatus = isQualifiedForAll\n        ? 'QUALIFIED'\n        : 'PARTIALLY QUALIFIED';\n    }\n  }\n\n  const seenRefs = new Set();\n  const notQualifiedRefs = [];\n  for (let i = 0; i < bucket.notQualifiedRefs.length; i++) {\n    const ref = bucket.notQualifiedRefs[i];\n    if (!ref || seenRefs.has(ref)) {\n      continue;\n    }\n    seenRefs.add(ref);\n    notQualifiedRefs.push(ref);\n  }\n\n  return {\n    ...entry,\n    qualificationStatus,\n    notQualifiedWorkOrderOperations: notQualifiedRefs.join(', ') || '-'\n  };\n});\n\nreturn result;"
          },
          "outcomes": {
            "success": "1770947834527"
          },
