        },
        {
          "metadata": {
            "name": "HTMLGeneratorOwnedAssetRetire",
            "returnType": "string",
            "sourceCode": "let data = $context.$variables.retirementJSON;\n\nfunction formatDate(dateValue) {\n    if (!dateValue) return \"\";\n\n    const dateText = String(dateValue).split(\"T\")[0];\n    const dateParts = dateText.split(\"-\");\n\n    if (dateParts.length !== 3) {\n        return dateValue;\n    }\n\n    const year = dateParts[0];\n    const month = dateParts[1];\n    const day = dateParts[2];\n\n    const userDateFormat =\n        $context.$variables.userSessionDetails.userSession.DateFormat;\n\n    const monthNumber = parseInt(month, 10);\n    const dayNumber = parseInt(day, 10);\n\n    const shortMonthNames = [\n        \"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\",\n        \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"\n    ];\n\n    const formatTokens = {\n        YYYY: year,\n        yyyy: year,\n        YY: year.slice(-2),\n        yy: year.slice(-2),\n        y: year.slice(-2),\n\n        MMM: shortMonthNames[monthNumber - 1],\n\n        MM: month,\n        M: String(monthNumber),\n\n        dd: day,\n        d: String(dayNumber)\n    };\n\n    return String(userDateFormat).replace(\n        /YYYY|yyyy|YY|yy|y|MMM|MM|M|dd|d/g,\n        function (token) {\n            return formatTokens[token] || token;\n        }\n    );\n}\n\nlet html = \"\";\nlet rows = data.assetRetirements || [];\nlet totalAssets = rows.length;\nlet allRowsValid = data.allRowsValid;\n\n// Dynamic singular / plural\nlet assetLabel = totalAssets === 1 ? \"asset\" : \"assets\";\n\nhtml += \"<div style='font-family:Segoe UI, Arial, sans-serif; font-size:13px; color:#2f2f2f; width:100%;'>\";\n\n// ================= TITLE =================\nhtml += \"<div style='font-size:16px; font-weight:600; margin-bottom:10px; color:#1f1f1f;'>\";\nhtml += \"Asset Retirement Details\";\nhtml += \"</div>\";\n\n// ================= INTRO =================\nhtml += \"<div style='margin-bottom:12px; color:#4a4a4a; line-height:1.5;'>\";\nhtml += \"You selected <b>\" + totalAssets + \"</b> \" + assetLabel + \" for retirement. \";\nhtml += \"</div>\";\n\n// ================= TABLE =================\nhtml += \"<div style='width:100%; overflow-x:auto;'>\";\nhtml += \"<table style='border-collapse:collapse; width:100%; table-layout:fixed; border:1px solid #e6e6e6; border-radius:8px; overflow:hidden;'>\";\n\n// HEADER\nhtml += \"<tr style='background-color:#f7f7f7;'>\";\n\nlet th = \"padding:10px 12px; border:1px solid #e8e8e8; font-size:13px; font-weight:600; color:#1f1f1f; text-align:left;\";\n\nhtml += \"<th style='\" + th + \" width:40px; text-align:center;'>Row</th>\";\nhtml += \"<th style='\" + th + \" width:25%;'>Description</th>\";\nhtml += \"<th style='\" + th + \" width:10%;'>Tag Number</th>\";\nhtml += \"<th style='\" + th + \" width:10%;'>Serial Number</th>\";\nhtml += \"<th style='\" + th + \" width:12%;'>In Service Date</th>\";\nhtml += \"<th style='\" + th + \" width:12%;'>Retire Date <span style='color:#d93025;'>*</span></th>\";\nhtml += \"<th style='\" + th + \" width:11%;'>Retirement Reason</th>\";\nhtml += \"<th style='\" + th + \" width:12%;'>Comments</th>\";\nhtml += \"<th style='\" + th + \" width:8%; text-align:center;'>Ready to Submit</th>\";\n\nhtml += \"</tr>\";\n\n// ROWS\nfor (let i = 0; i < rows.length; i++) {\n    let item = rows[i];\n    let bg = (i % 2 === 0) ? \"#ffffff\" : \"#fcfcfc\";\n\n    let td = \"padding:9px 10px; border:1px solid #e6e6e6; vertical-align:top; word-wrap:break-word; overflow-wrap:anywhere; line-height:1.4;\";\n    let isValid = !!item.isValid;\n\n    let statusColor = isValid ? \"#1e7a34\" : \"#b42318\";\n    let statusIcon = isValid ? \"&#10003;\" : \"&#10007;\";\n\n    html += \"<tr style='background:\" + bg + \";'>\";\n\n    html += \"<td style='\" + td + \" text-align:center; width:40px;'>\" + (item.row || \"\") + \"</td>\";\n    html += \"<td style='\" + td + \"'>\" + (item.assetDescription || \"\") + \"</td>\";\n    html += \"<td style='\" + td + \"'>\" + (item.tagNumber || \"\") + \"</td>\";\n    html += \"<td style='\" + td + \"'>\" + (item.serialNumber || \"\") + \"</td>\";\n    html += \"<td style='\" + td + \"'>\" + formatDate(item.inServiceDate) + \"</td>\";\n    html += \"<td style='\" + td + \"'>\" + formatDate(item.dateRetired) + \"</td>\";\n    html += \"<td style='\" + td + \"'>\" + (item.retirementReason || \"\") + \"</td>\";\n    html += \"<td style='\" + td + \"'>\" + (item.transactionComments || \"\") + \"</td>\";\n\n    // ===== STATUS (ICON ONLY) =====\n    html += \"<td style='\" + td + \" text-align:center;'>\";\n    html += \"<span style='color:\" + statusColor + \"; font-size:16px; font-weight:600;'>\";\n    html += statusIcon;\n    html += \"</span>\";\n    html += \"</td>\";\n\n    html += \"</tr>\";\n}\n\nhtml += \"</table>\";\nhtml += \"</div>\";\n\n// ================= BOTTOM NOTE =================\nif (!allRowsValid) {\n    html += \"<div style='margin-top:12px; color:#4a4a4a; line-height:1.5;'>\";\n    html += \"Please provide a retirement date and, optionally, the retirement reason and comments.\";\n    html += \"</div>\";\n}\n\nhtml += \"</div>\";\n\nreturn html;"
          },
          "outcomes": {
            "success": "1777289411877"
          },
          "code": "HTMLGENERATOROWNEDASSETRETIRE",
          "id": "1771839279319",
