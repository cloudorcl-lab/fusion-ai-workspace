        {
          "metadata": {
            "name": "Get Validations for Rows"
          },
          "outcomes": {
            "success": "1781826531271"
          },
          "code": "GET_VALIDATIONS_FOR_ROWS",
          "id": "1781826452780",
          "inputs": [
            {
              "id": "1781826452784_1",
              "name": "prompt",
              "type": "string",
              "value": "Using the JSON data in {{$context.$variables.retirementJSON}}, identify the rows that contain validation messages.\n\nUser request: {{$context.$variables.currentInput}}\n\nRules:\n\n1. If the user specifies one or more row numbers, return only those rows that have non-empty `validationMessages`.\n2. If the user does not specify any row numbers, return all rows in `assetRetirements` where `validationMessages` is not empty.\n3. Ignore rows that do not have validation messages.\n4. If no matching rows are found, return: \"No validation messages found for the requested rows.\"\n5. Return the result as a JSON array."
            }
          ],
          "outputSpecification": "{\n  \"allRowsValid\": \"boolean\",\n  \"validationMessages\": [\n    \"string\"\n  ],\n  \"assetRetirements\": [\n    {\n      \"row\": \"number\",\n      \"bookName\": \"string\",\n      \"assetNumber\": \"string\",\n      \"assetDescription\": \"string\",\n      \"assetId\": \"string\",\n      \"tagNumber\": \"string\",\n      \"serialNumber\": \"string\",\n      \"poNumber\": \"string\",\n      \"invoiceNumber\": \"string\",\n      \"inServiceDate\": \"string\",\n      \"dateRetired\": \"string\",\n      \"costRetired\": \"number\",\n      \"proceedsOfSale\": \"number\",\n      \"costOfRemoval\": \"number\",\n      \"retirementReason\": \"string\",\n      \"retirementConvention\": \"string\",\n      \"transactionComments\": \"string\",\n      \"isValid\": \"boolean\",\n      \"validationMessages\": [\n        \"string\"\n      ]\n    }\n  ]\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "HTMLforValidationMessages",
            "returnType": "string",
            "sourceCode": "let data = $context.$nodes.GET_VALIDATIONS_FOR_ROWS.$output || {};\n\n// Source rows\nlet rows = Array.isArray(data.assetRetirements) ? data.assetRetirements : [];\n\nfunction escapeHtml(value) {\n    if (value === null || value === undefined) return \"\";\n    return String(value)\n        .replace(/&/g, \"&amp;\")\n        .replace(/</g, \"&lt;\")\n        .replace(/>/g, \"&gt;\")\n        .replace(/\"/g, \"&quot;\")\n        .replace(/'/g, \"&#39;\");\n}\n\nfunction normalizeMessages(messages) {\n    if (!Array.isArray(messages)) return [];\n    return messages.filter(function (msg) {\n        return msg !== null && msg !== undefined && String(msg).trim() !== \"\";\n    });\n}\n\nlet html = \"\";\n\nhtml += \"<div style='font-family:Segoe UI, Arial, sans-serif; font-size:13px; color:#2f2f2f; width:100%;'>\";\n\n// ================= TITLE =================\nhtml += \"<div style='font-size:16px; font-weight:600; margin-bottom:10px; color:#1f1f1f;'>\";\nhtml += \"Validation Messages\";\nhtml += \"</div>\";\n\n// ================= INTRO =================\nhtml += \"<div style='margin-bottom:12px; line-height:1.6; color:#4a4a4a;'>\";\nhtml += \"Please review the validation details below.\";\nhtml += \"</div>\";\n\n// ================= TABLE =================\nhtml += \"<div style='width:100%;'>\";\nhtml += \"<table style='border-collapse:collapse; width:100%; table-layout:fixed;'>\";\n\n// ================= HEADER =================\nhtml += \"<tr style='background-color:#f7f7f7;'>\";\n\nlet th = \"padding:10px 12px; border:1px solid #e8e8e8; font-size:13px; font-weight:600; color:#1f1f1f; text-align:left;\";\n\nhtml += \"<th style='\" + th + \" width:60px; text-align:center;'>Row</th>\";\nhtml += \"<th style='\" + th + \" width:30%;'>Description</th>\";\nhtml += \"<th style='\" + th + \" width:65%;'>Validation Messages</th>\";\n\nhtml += \"</tr>\";\n\n// ================= ROWS =================\nfor (let i = 0; i < rows.length; i++) {\n    let item = rows[i] || {};\n    let bg = (i % 2 === 0) ? \"#ffffff\" : \"#fafafa\";\n\n    let td = \"padding:8px 10px; border:1px solid #e6e6e6; vertical-align:top; word-wrap:break-word; overflow-wrap:anywhere; line-height:1.4;\";\n\n    let rowNumber = item.row !== undefined && item.row !== null && item.row !== \"\"\n        ? item.row\n        : (i + 1);\n\n    let description = item.assetDescription || item.description || \"\";\n    let messages = normalizeMessages(item.validationMessages);\n\n    html += \"<tr style='background:\" + bg + \";' \" +\n        \"onmouseover=\\\"this.style.background='#f8f9fb'\\\" \" +\n        \"onmouseout=\\\"this.style.background='\" + bg + \"'\\\">\";\n\n    html += \"<td style='\" + td + \" text-align:center; width:60px;'>\" + escapeHtml(rowNumber) + \"</td>\";\n    html += \"<td style='\" + td + \"'>\" + escapeHtml(description) + \"</td>\";\n\n    html += \"<td style='\" + td + \"'>\";\n\n    if (messages.length > 0) {\n        html += \"<ul style='margin:0; padding-left:18px; line-height:1.6;'>\";\n        for (let j = 0; j < messages.length; j++) {\n            html += \"<li>\" + escapeHtml(messages[j]) + \"</li>\";\n        }\n        html += \"</ul>\";\n    } else {\n        html += \"<span style='color:#6b7280;'>No validation messages.</span>\";\n    }\n\n    html += \"</td>\";\n    html += \"</tr>\";\n}\n\nhtml += \"</table>\";\nhtml += \"</div>\";\n\n// ================= INFO TEXT =================\nhtml += \"<div style='margin-top:12px; line-height:1.6; color:#4a4a4a;'>\";\nhtml += \"To go back to Retirement Details, type <strong>Show Retirement Details</strong>.\";\nhtml += \"</div>\";\n\nhtml += \"</div>\";\n\nreturn html;"
          },
          "outcomes": {
            "success": "1781826572703"
          },
          "code": "HTMLFORVALIDATIONMESSAGES",
          "id": "1781826531271",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
