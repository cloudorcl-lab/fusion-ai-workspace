            "sourceCode": "const raw = $context.$nodes.RETRIEVE_DETAILS_FOR_ROWS.$output ;\n\nif (Array.isArray(raw)) {\n  return raw.map(item => JSON.parse(item));\n}\n\nreturn JSON.parse(raw);"
