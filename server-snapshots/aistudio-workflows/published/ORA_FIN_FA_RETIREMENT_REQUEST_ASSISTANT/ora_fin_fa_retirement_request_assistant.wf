        {
          "metadata": {
            "name": "Owned Assets Transaction Status HTML Generator",
            "returnType": "string",
            "sourceCode": "let data = $context.$nodes.RETIREOWNASSETSLOOP.$output;\n\nlet html = \"\";\n\n// ================= PARSE =================\nlet rows = [];\nfor (let i = 0; i < data.length; i++) {\n  rows.push(JSON.parse(data[i]));\n}\n\n// ================= SPLIT =================\nlet successRows = [];\nlet errorRows = [];\n\nfor (let i = 0; i < rows.length; i++) {\n  let status = (rows[i].returnStatus || \"\").trim().toUpperCase();\n\n  if (status === \"S\") {\n    successRows.push(rows[i]);\n  } else {\n    errorRows.push(rows[i]);\n  }\n}\n\n// ================= COUNTS =================\nlet successCount = successRows.length;\nlet errorCount = errorRows.length;\nlet totalCount = rows.length;\n\n// ================= CARD =================\nhtml += \"<div style='font-family:Segoe UI, Arial, sans-serif; font-size:13px; color:#2f2f2f; background:#ffffff; border:1px solid #e4e4e4; border-radius:6px; padding:14px;'>\";\n\n// ================= TITLE =================\nhtml += \"<div style='font-size:16px; font-weight:600; margin-bottom:8px; color:#1f1f1f;'>\";\nhtml += \"Asset Retirement Submission Summary\";\nhtml += \"</div>\";\n\n// ================= SUMMARY =================\nhtml += \"<div style='font-size:13px; color:#4f4f4f; margin-bottom:12px;'>\";\nhtml += \"Out of <b>\" + totalCount + \"</b> retirement requests, \";\nhtml += \"<b style='color:#3fa55b;'>\" + successCount + \"</b> were submitted successfully\";\n\nif (errorCount > 0) {\n  html += \" and <b style='color:#d94b3d;'>\" + errorCount + \"</b> could not be processed.\";\n} else {\n  html += \".\";\n}\n\nhtml += \"</div>\";\n\n// ================= INFO =================\nif (errorCount > 0) {\n  html += \"<div style='margin-bottom:10px; color:#5f5f5f; font-size:12px;'>\";\n  html += \"Retirement requests have been submitted. Please review the exceptions below for any records that could not be processed.\";\n  html += \"</div>\";\n}\n\n// ================= ERROR TABLE =================\nif (errorCount > 0) {\n\n  html += \"<div style='margin-bottom:8px; font-weight:600; color:#d94b3d;'>Error Records</div>\";\n\n  html += \"<div style='width:100%; overflow:auto; max-height:420px;'>\";\n  html += \"<table style='border-collapse:collapse; width:max-content;'>\";\n\n  // HEADER\n  html += \"<tr style='background-color:#f5f5f5; position:sticky; top:0;'>\";\n  html += \"<th style='padding:8px 12px; border:1px solid #e6e6e6;'>Row</th>\";\n  html += \"<th style='padding:8px 12px; border:1px solid #e6e6e6;'>Request Number</th>\";\n  html += \"<th style='padding:8px 12px; border:1px solid #e6e6e6;'>Description</th>\";\n  html += \"<th style='padding:8px 12px; border:1px solid #e6e6e6;'>Tag Number</th>\";\n  html += \"<th style='padding:8px 12px; border:1px solid #e6e6e6;'>Serial Number</th>\";\n  html += \"<th style='padding:8px 12px; border:1px solid #e6e6e6;'>Retire Date</th>\";\n  html += \"<th style='padding:8px 12px; border:1px solid #e6e6e6;'>Retirement Reason</th>\";\n  html += \"<th style='padding:8px 12px; border:1px solid #e6e6e6;'>Comments</th>\";\n  html += \"<th style='padding:8px 12px; border:1px solid #e6e6e6;'>Message</th>\";\n  html += \"<th style='padding:8px 12px; border:1px solid #e6e6e6;'>Status</th>\";\n  html += \"</tr>\";\n\n  // ROWS\n  for (let i = 0; i < errorRows.length; i++) {\n    let rowData = errorRows[i];\n    let bgColor = (i % 2 === 0) ? \"#ffffff\" : \"#fbfbfb\";\n    let msg = rowData.message || rowData.errorMessage || rowData.returnMessage || \"\";\n\n    html += \"<tr style='background-color:\" + bgColor + \";'>\";\n\n    html += \"<td style='padding:8px 12px;border:1px solid #f0f0f0;text-align:center;'>\"\n      + (rowData.row || \"\") + \"</td>\";\n\n    html += \"<td style='padding:8px 12px;border:1px solid #f0f0f0;'>\"\n      + (rowData.retirementInterfaceId || \"\") + \"</td>\";\n\n    html += \"<td style='padding:8px 12px;border:1px solid #f0f0f0; max-width:220px;'>\"\n      + (rowData.description || \"\") + \"</td>\";\n\n    html += \"<td style='padding:8px 12px;border:1px solid #f0f0f0;'>\"\n      + (rowData.tagNumber || \"\") + \"</td>\";\n\n    html += \"<td style='padding:8px 12px;border:1px solid #f0f0f0;'>\"\n      + (rowData.serialNumber || \"\") + \"</td>\";\n\n    html += \"<td style='padding:8px 12px;border:1px solid #f0f0f0;'>\"\n      + (rowData.dateRetired || \"\") + \"</td>\";\n\n    html += \"<td style='padding:8px 12px;border:1px solid #f0f0f0;'>\"\n      + (rowData.retirementReason || \"\") + \"</td>\";\n\n    html += \"<td style='padding:8px 12px;border:1px solid #f0f0f0; max-width:220px;'>\"\n      + (rowData.transactionComments || \"\") + \"</td>\";\n\n    html += \"<td style='padding:8px 12px;border:1px solid #f0f0f0; max-width:260px;'>\"\n      + msg + \"</td>\";\n\n    html += \"<td style='padding:8px 12px;border:1px solid #f0f0f0; white-space:nowrap;'>\";\n    html += \"<span style='display:inline-flex; align-items:center; gap:6px;'>\";\n    html += \"<span style='width:10px;height:10px;border-radius:50%;background:#d94b3d;'></span>\";\n    html += \"<span>Error</span>\";\n    html += \"</span>\";\n    html += \"</td>\";\n\n    html += \"</tr>\";\n  }\n\n  html += \"</table>\";\n  html += \"</div>\";\n}\n\n// ================= NO ERRORS =================\nif (errorCount === 0) {\n  html += \"<div style='margin-top:8px; color:#4f4f4f; font-weight:500;'>\";\n  html += \"To review your request status, say <b>\\\"Show my recent retirement requests</b>.\\\"\";\n  html += \"</div>\";\n}\n\nhtml += \"</div>\";\n\nreturn html;"
          },
          "outcomes": {
            "success": "1776595847727"
          },
          "code": "OWNED_ASSETS_TRANSACTION_STATUS_HTML_GENERATOR",
          "convergenceTargetId": "1776338566898",
          "id": "1775394742080",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Update Retirement Data"
          },
          "outcomes": {
            "success": "1776356467077"
          },
          "code": "UPDATE_RETIREMENT_DATA",
          "id": "1776353227768",
          "inputs": [
            {
              "id": "1776353227770_1",
              "name": "prompt",
              "type": "string",
              "value": "You are transforming {{$context.$variables.currentInput}}.\n\nUse {{$context.$variables.retirementJSON}} as the source JSON and return the same JSON shape.\nUse {{$context.$nodes.CREATERETIREMENTREASONJSON.$output.result}} as the retirement reason lookup source.\n\nReturn only valid JSON.\nReturn the complete updated JSON.\nDo not add, remove, rename, or reorder rows or fields.\n\nAllowed user-changeable fields:\n- dateRetired\n- retirementReason\n- transactionComments\n\nSystem validation fields that must be recomputed when present:\n- isValid\n- allRowsValid\n- validationMessage\n\nOnly update validationMessage if it already exists in the source JSON shape.\n\nIntent detection:\n- dateRetired is requested only when the user explicitly mentions a date field.\n- retirementReason is requested only when the user explicitly mentions retirement reason, retire reason, reason, or similar wording for the retirement reason field.\n- transactionComments is requested only when the user explicitly mentions comments, comment, transaction comments, or transactionComments.\n- If the user explicitly mentions multiple user-changeable fields in one request, treat every mentioned field as explicitly requested.\n- Examples:\n  - \"Update Retire Date and Retirement Reason\" means both fields are requested.\n  - \"Update Retire Date, Retirement Reason for all rows\" means both fields are requested for all rows.\n- Do not infer one field from another.\n- Do not update any field that was not explicitly requested.\n\nField mapping:\n- \"Retire Date\"\n- \"retire date\"\n- \"retired date\"\n- \"date retired\"\n- \"dateRetired\"\n  -> dateRetired\n\n- \"Retirement Reason\"\n- \"retire reason\"\n- \"retirementReason\"\n- \"reason\"\n  -> retirementReason\n\n- \"comments\"\n- \"comment\"\n- \"transaction comments\"\n- \"transactionComments\"\n  -> transactionComments\n\nRow targeting:\n- If the user explicitly says \"all rows\", apply requested changes to all rows.\n- If a row number is mentioned, apply changes only to that 1-based row.\n- If no row number is mentioned, apply changes to all rows.\n\nComments:\n- A comment-only request is actionable only when it includes a value.\n- If the user says \"comments\", always treat it as transactionComments.\n- Examples:\n  - update comments to XYZ\n  - set comments to XYZ\n  - change comments to XYZ\n  - comments = XYZ\n  - comments: XYZ\n  mean transactionComments = \"XYZ\".\n- Preserve the provided comment text exactly except for removing surrounding quotes.\n- If no comment value is provided, do not change transactionComments.\n- Never update transactionComments unless explicitly requested.\n\nDate rules:\n- dateRetired is required.\n- Never infer dateRetired from words like retirement, retire, process retirement, retirement reason, or reason.\n- Never compute, normalize, convert, reformat, infer, or timezone-adjust dates.\n- Never use model date, system date, server date, or conversation date.\n- Accept only explicit dates containing day, month, and 4-digit year.\n- Valid formats:\n  - M/D/YYYY\n  - MM/DD/YYYY\n  - YYYY-MM-DD\n- Standalone years are invalid.\n- Month/year values are invalid.\n- If the user says:\n  - today\n  - today's date\n  - current date\n  set dateRetired exactly to:\n  {{$context.$variables.userSessionDetails.userSession.CurrentDate}}\n- If the requested explicit date is valid, copy it exactly as provided.\n- Remove surrounding quotes if present.\n- If the requested explicit date is invalid, still write the requested value into dateRetired exactly as provided after removing surrounding quotes if present.\n- If the requested date is missing or empty, preserve the existing dateRetired.\n- Do not modify dateRetired on unaffected rows.\n\nRetirement reason lookup:\n- Build one combined list of lookup meanings across all books.\n- Remove duplicate meanings while preserving first-seen order.\n- Build one combined lookup map of:\n  - lookupCode -> meaning\n  - meaning -> lookupCode\n- Do not expose book names.\n\nRetirement reason rules:\n- retirementReason is optional.\n- Only process retirementReason when explicitly requested.\n- A requested retirement reason is valid only if it exactly matches:\n  - one lookupCode\n  OR\n  - one lookup meaning\n- Matching must be exact.\n- No fuzzy matching.\n- No semantic matching.\n- No partial matching.\n- No contains matching.\n- No starts-with matching.\n- No ends-with matching.\n- No abbreviation matching.\n- No synonym matching.\n- No fallback matching.\n- If matched by meaning, store the corresponding lookupCode.\n- If matched by lookupCode, store that lookupCode unchanged.\n- If invalid, ambiguous, missing, or no exact match exists, still write the requested value into retirementReason exactly as provided after removing surrounding quotes if present.\n- Never invent, infer, guess, derive, normalize, or map a retirement reason without an exact lookup match.\n\nValidation:\n- Recompute validation from scratch after applying changes.\n- Validate the final row state.\n- Never validate against the original state.\n- Never use existing isValid, allRowsValid, or validationMessage values to decide current validity.\n- Existing validation values may be stale and must be ignored completely.\n- Validation must be recalculated on every request, including when the previous output was valid and the current requested data is invalid.\n- Validation must also be recalculated when the previous output was invalid and the current requested data is valid.\n- Validation messages must remain exactly as specified below.\n\nA row is valid only if:\n- dateRetired exists and matches an allowed date format\nAND\n- retirementReason is blank OR exactly matches a valid lookupCode\n\nInvalid conditions:\n- Missing dateRetired\n- Invalid dateRetired\n- Invalid retirementReason\n\nValidation fields:\n- Never preserve existing isValid values.\n- Never preserve existing allRowsValid values.\n- Never preserve existing validationMessage values.\n- Recalculate validation fields from the final row state after all requested changes are applied.\n- If isValid exists on a row, set it to true only when that final row is valid; otherwise set it to false.\n- Compute one global allRowsValid value after every row has been validated.\n- The global allRowsValid value is true only when every final row is valid; otherwise it is false.\n- If allRowsValid exists anywhere in the source JSON shape, set it to the computed global allRowsValid value.\n\nRow validationMessage:\nIf validationMessage exists at row level:\n- Set to \"\" when the final row is valid.\n- Otherwise include applicable messages exactly as written:\n  - Retire Date is required.\n  - Retire Date is invalid.\n  - If retirementReason is invalid:\n    Retirement Reason is invalid. Allowed Retirement Reasons: <comma-separated list of all allowed lookup meanings from the combined lookup list>\n- The allowed retirement reasons must be the actual lookup meanings from the lookup source.\n- Do not include lookup codes.\n- Do not include book names.\n- If multiple messages exist, join them with a single space.\n- Do not preserve any previous row validationMessage text.\n\nRoot validationMessage:\nIf validationMessage exists at root:\n- Recompute it from scratch from the final row state after all row validations are complete.\n- Do not preserve any previous root validationMessage text.\n- Do not copy or summarize previous row validationMessage text.\n- Do not derive the root validationMessage from existing validationMessage fields in the source JSON.\n- Set to \"\" only when all final rows are valid.\n- If any final row has missing dateRetired or invalid dateRetired, include exactly:\n  Retire Date is invalid.\n- If any final row has invalid retirementReason, include exactly:\n  Retirement Reason is invalid.\n- If both failed anywhere across all final rows, use exactly:\n  Retire Date is invalid. Retirement Reason is invalid.\n- The root validationMessage may contain only:\n  - \"\"\n  - \"Retire Date is invalid.\"\n  - \"Retirement Reason is invalid.\"\n  - \"Retire Date is invalid. Retirement Reason is invalid.\"\n- Never include \"Retire Date is required.\" at root.\n- Never include lookup values at root.\n- Never include allowed retirement reasons at root.\n- Never include row numbers at root.\n- Never include detailed validation guidance at root.\n\nallRowsValid:\n- Recompute allRowsValid from scratch after all requested changes are applied and all final rows are validated.\n- true only if every final row is valid.\n- false otherwise.\n- Set allRowsValid to false when any row has missing dateRetired, invalid dateRetired, or invalid retirementReason.\n- Set allRowsValid to true only after confirming no final row has any validation failure.\n- Do not preserve the previous allRowsValid value.\n- Do not infer allRowsValid from the previous root validationMessage.\n- Do not infer allRowsValid from the previous row validationMessage values.\n\nChange application:\n- Apply each requested field independently.\n- If multiple fields are requested, process all requested fields.\n- Never skip a requested field because another requested field failed validation.\n- If dateRetired is valid and retirementReason is invalid:\n  - update dateRetired\n  - write the requested retirementReason value as provided\n- If retirementReason is valid and dateRetired is invalid:\n  - update retirementReason\n  - write the requested dateRetired value as provided\n- If both are valid:\n  - update both\n- If both are invalid:\n  - write both requested values as provided\n- Preserve every unchanged value exactly as received.\n- Before returning JSON, verify that every field not explicitly requested and not a system validation field remains identical to the source JSON.\n\nFinal verification before output:\n- If retirementReason was updated, verify the final stored value exactly matches a lookupCode from the lookup source only when an exact match exists.\n- If no exact lookup match exists, keep the requested raw value in retirementReason.\n- If dateRetired was updated and the requested date is valid, keep it as provided.\n- If the requested date is invalid, keep the requested raw value in dateRetired.\n- Do not revert invalid requested values.\n- Do not replace invalid requested values with the source value.\n- After validation is recomputed, verify the root validationMessage reflects the final row state and contains only the allowed root messages.\n- After validation is recomputed, verify allRowsValid equals true only when all final rows are valid and false otherwise.\n\nOutput rules:\n- Return only valid JSON.\n- Return the complete updated JSON.\n- Never return explanatory text.\n- Never return markdown.\n- Never return null.\n- Never return empty output.\n"
            }
          ],
          "outputSpecification": "{\n  \"allRowsValid\": \"boolean\",\n  \"validationMessages\": [\n    \"string\"\n  ],\n  \"assetRetirements\": [\n    {\n      \"row\": \"number\",\n      \"bookName\": \"string\",\n      \"assetNumber\": \"string\",\n      \"assetDescription\": \"string\",\n      \"assetId\": \"string\",\n      \"tagNumber\": \"string\",\n      \"serialNumber\": \"string\",\n      \"poNumber\": \"string\",\n      \"invoiceNumber\": \"string\",\n      \"inServiceDate\": \"string\",\n      \"dateRetired\": \"string\",\n      \"costRetired\": \"number\",\n      \"proceedsOfSale\": \"number\",\n      \"costOfRemoval\": \"number\",\n      \"retirementReason\": \"string\",\n      \"retirementConvention\": \"string\",\n      \"transactionComments\": \"string\",\n      \"isValid\": \"boolean\",\n      \"validationMessages\": [\n        \"string\"\n      ]\n    }\n  ]\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "HTMLGeneratorForUpdatedRetirements",
            "returnType": "string",
            "sourceCode": "let data = $context.$variables.retirementJSON || {};\n\n// Retirement reason lookup source\nlet lookupSource = $context.$nodes.CREATERETIREMENTREASONJSON.$output.result || [];\nlet lookupRows = [];\n\nif (Array.isArray(lookupSource)) {\n    if (lookupSource.length > 0 && Array.isArray(lookupSource[0].lookups)) {\n        lookupRows = lookupSource[0].lookups;\n    }\n} else if (Array.isArray(lookupSource.lookups)) {\n    lookupRows = lookupSource.lookups;\n}\n\nfunction escapeHtml(value) {\n    if (value === null || value === undefined) return \"\";\n\n    return String(value)\n        .replace(/&/g, \"&amp;\")\n        .replace(/</g, \"&lt;\")\n        .replace(/>/g, \"&gt;\")\n        .replace(/\"/g, \"&quot;\")\n        .replace(/'/g, \"&#39;\");\n}\n\nfunction formatDate(dateValue) {\n    if (!dateValue) return \"\";\n\n    const dateText = String(dateValue).split(\"T\")[0];\n    const dateParts = dateText.split(\"-\");\n\n    if (dateParts.length !== 3) {\n        return dateValue;\n    }\n\n    const year = dateParts[0];\n    const month = dateParts[1];\n    const day = dateParts[2];\n\n    const userDateFormat = $context.$variables.userSessionDetails.userSession.DateFormat;\n\n    const monthNumber = parseInt(month, 10);\n    const dayNumber = parseInt(day, 10);\n\n    const shortMonthNames = [\n        \"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\",\n        \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"\n    ];\n\n    const formatTokens = {\n        YYYY: year,\n        yyyy: year,\n        YY: year.slice(-2),\n        yy: year.slice(-2),\n        y: year.slice(-2),\n\n        MMM: shortMonthNames[monthNumber - 1],\n\n        MM: month,\n        M: String(monthNumber),\n\n        dd: day,\n        d: String(dayNumber)\n    };\n\n    return String(userDateFormat).replace(\n        /YYYY|yyyy|YY|yy|y|MMM|MM|M|dd|d/g,\n        function (token) {\n            return formatTokens[token] || token;\n        }\n    );\n}\n\n// Convert lookupCode -> meaning\nfunction getRetirementReasonMeaning(code) {\n    if (!code) return \"\";\n\n    for (let i = 0; i < lookupRows.length; i++) {\n        let lookup = lookupRows[i];\n\n        if (\n            String(lookup.lookupCode).trim().toLowerCase() ===\n            String(code).trim().toLowerCase()\n        ) {\n            return lookup.meaning || code;\n        }\n    }\n\n    return code;\n}\n\nlet html = \"\";\nlet rows = Array.isArray(data.assetRetirements) ? data.assetRetirements : [];\nlet totalAssets = rows.length;\n\n// Prefer root-level allRowsValid if present, otherwise calculate from rows\nlet allRowsValid =\n    typeof data.allRowsValid === \"boolean\"\n        ? data.allRowsValid\n        : rows.length > 0;\n\nif (typeof data.allRowsValid !== \"boolean\") {\n    for (let i = 0; i < rows.length; i++) {\n        let item = rows[i];\n        let isValid = item && (item.isValid === true || item.isValid === \"true\");\n\n        if (!isValid) {\n            allRowsValid = false;\n            break;\n        }\n    }\n}\n\n// Set global requestState when all rows are valid\nif (allRowsValid) {\n    $context.$variables.requestState = \"READY_TO_SUBMIT\";\n}\n\n// Dynamic singular / plural\nlet assetLabel = totalAssets === 1 ? \"asset\" : \"assets\";\n\nhtml += \"<div style='font-family:Segoe UI, Arial, sans-serif; font-size:13px; color:#2f2f2f; width:100%;'>\";\n\n// ================= TITLE =================\nhtml += \"<div style='font-size:16px; font-weight:600; margin-bottom:10px; color:#1f1f1f;'>\";\nhtml += \"Asset Retirement Details\";\nhtml += \"</div>\";\n\n// ================= INTRO =================\nhtml += \"<div style='margin-bottom:12px; line-height:1.6; color:#4a4a4a;'>\";\nhtml += \"I have updated the details. Please review.\";\nhtml += \"</div>\";\n\n// ================= TABLE =================\nhtml += \"<div style='width:100%;'>\";\nhtml += \"<table style='border-collapse:collapse; width:100%; table-layout:fixed;'>\";\n\n// ================= HEADER =================\nhtml += \"<tr style='background-color:#f7f7f7;'>\";\n\nlet th = \"padding:10px 12px; border:1px solid #e8e8e8; font-size:13px; font-weight:600; color:#1f1f1f; text-align:left;\";\n\nhtml += \"<th style='\" + th + \" width:40px; text-align:center;'>Row</th>\";\nhtml += \"<th style='\" + th + \" width:28%;'>Description</th>\";\nhtml += \"<th style='\" + th + \" width:12%;'>Tag Number</th>\";\nhtml += \"<th style='\" + th + \" width:12%;'>Serial Number</th>\";\nhtml += \"<th style='\" + th + \" width:12%;'>In Service Date</th>\";\nhtml += \"<th style='\" + th + \" width:12%;'>Retire Date <span style='color:#d93025;'>*</span></th>\";\nhtml += \"<th style='\" + th + \" width:10%;'>Retirement Reason</th>\";\nhtml += \"<th style='\" + th + \" width:10%;'>Comments</th>\";\nhtml += \"<th style='\" + th + \" width:10%; text-align:center;'>Ready to Submit</th>\";\n\nhtml += \"</tr>\";\n\n// ================= ROWS =================\nfor (let i = 0; i < rows.length; i++) {\n    let item = rows[i] || {};\n    let bg = (i % 2 === 0) ? \"#ffffff\" : \"#fafafa\";\n\n    let td = \"padding:8px 10px; border:1px solid #e6e6e6; vertical-align:top; word-wrap:break-word; overflow-wrap:anywhere; line-height:1.4;\";\n\n    let rowValid = item.isValid === true || item.isValid === \"true\";\n    let validationColor = rowValid ? \"#1e7a34\" : \"#b42318\";\n    let validationIcon = rowValid ? \"&#10003;\" : \"&#10007;\";\n    let rowNumber = item.row !== undefined && item.row !== null && item.row !== \"\" ? item.row : (i + 1);\n\n    html += \"<tr style='background:\" + bg + \";' \" +\n        \"onmouseover=\\\"this.style.background='#f8f9fb'\\\" \" +\n        \"onmouseout=\\\"this.style.background='\" + bg + \"'\\\">\";\n\n    html += \"<td style='\" + td + \" text-align:center; width:40px;'>\" + escapeHtml(rowNumber) + \"</td>\";\n    html += \"<td style='\" + td + \"'>\" + escapeHtml(item.assetDescription) + \"</td>\";\n    html += \"<td style='\" + td + \"'>\" + escapeHtml(item.tagNumber) + \"</td>\";\n    html += \"<td style='\" + td + \"'>\" + escapeHtml(item.serialNumber) + \"</td>\";\n    html += \"<td style='\" + td + \"'>\" + escapeHtml(formatDate(item.inServiceDate)) + \"</td>\";\n    html += \"<td style='\" + td + \"'>\" + escapeHtml(formatDate(item.dateRetired)) + \"</td>\";\n\n    // Show meaning instead of lookupCode\n    html += \"<td style='\" + td + \"'>\" + escapeHtml(getRetirementReasonMeaning(item.retirementReason)) + \"</td>\";\n\n    html += \"<td style='\" + td + \"'>\" + escapeHtml(item.transactionComments) + \"</td>\";\n\n    html += \"<td style='\" + td + \" text-align:center;'>\";\n    html += \"<span style='color:\" + validationColor + \"; font-size:16px; font-weight:600;'>\";\n    html += validationIcon;\n    html += \"</span>\";\n    html += \"</td>\";\n\n    html += \"</tr>\";\n}\n\nhtml += \"</table>\";\nhtml += \"</div>\";\n\n// ================= VALIDATION SUMMARY =================\nlet rootValidationMessages = Array.isArray(data.validationMessages)\n    ? data.validationMessages.filter(function (msg) {\n        return msg !== null && msg !== undefined && String(msg).trim() !== \"\";\n    })\n    : [];\n\nif (rootValidationMessages.length > 0) {\n    html += \"<div style='margin-top:14px; padding:12px 14px; border:1px solid #f0c6c2; background-color:#fff7f6; border-radius:6px; color:#5f1b14;'>\";\n\n    html += \"<div style='font-size:14px; font-weight:600; margin-bottom:8px; color:#9f1c12;'>\";\n    html += \"Validation Summary\";\n    html += \"</div>\";\n\n    html += \"<div style='margin-bottom:8px; font-size:13px; color:#7a1c13; font-weight:600;'>\";\n    html += \"Show validation details to view the validation errors.\";\n    html += \"</div>\";\n\n    html += \"<ul style='margin:0; padding-left:18px; line-height:1.6;'>\";\n    for (let i = 0; i < rootValidationMessages.length; i++) {\n        html += \"<li>\" + escapeHtml(rootValidationMessages[i]) + \"</li>\";\n    }\n    html += \"</ul>\";\n\n    html += \"</div>\";\n}\n\n// ================= OUTRO =================\nhtml += \"<div style='margin-top:12px; line-height:1.6; color:#4a4a4a;'>\";\n\nif (allRowsValid) {\n    html += \"All required details are available. Would you like to proceed with the retirement?\";\n} else {\n    html += \"Some required details are missing. Please review the validation summary above to proceed.\";\n}\n\nhtml += \"</div>\";\n\nhtml += \"</div>\";\n\nreturn html;"
          },
          "outcomes": {
            "success": "1779421639230"
          },
          "code": "HTMLGENERATORFORUPDATEDRETIREMENTS",
