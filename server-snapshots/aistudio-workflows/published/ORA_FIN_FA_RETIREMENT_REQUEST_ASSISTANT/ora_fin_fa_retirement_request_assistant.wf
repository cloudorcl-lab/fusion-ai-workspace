ties\": false\n            },\n            \"docioContext\": {\n              \"type\": \"object\",\n              \"description\": \"Latest known valid docioContext, or {} if validation failed.\"\n            }\n          },\n          \"additionalProperties\": false\n        }\n      ]\n    }\n  },\n  \"additionalProperties\": false\n}",
