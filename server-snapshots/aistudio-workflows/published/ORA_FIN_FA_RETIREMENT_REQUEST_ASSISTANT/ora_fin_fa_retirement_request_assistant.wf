          "code": "CREATERETIREMENTREASONJSON",
          "id": "1778584712674",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Read All Books",
            "returnType": "array",
            "sourceCode": "let data = $context.$variables.retirementJSON || {};\n\n// Get rows safely\nlet rows = Array.isArray(data.assetRetirements)\n    ? data.assetRetirements\n    : [];\n\n// Extract unique bookNames\nlet uniqueBookNames = [];\nlet seenBookNames = {};\n\n// Loop through rows\nfor (let i = 0; i < rows.length; i++) {\n    let item = rows[i];\n\n    // Updated field name from \"book\" to \"bookName\"\n    let bookName = item.bookName;\n\n    // Ignore empty/null values\n    if (bookName && !seenBookNames[bookName]) {\n        seenBookNames[bookName] = true;\n        uniqueBookNames.push(bookName);\n    }\n}\n\n// Return unique bookNames array\nreturn uniqueBookNames;"
          },
          "outcomes": {
            "success": "1778554028368"
          },
          "code": "READ_ALL_BOOKS",
          "id": "1778584928271",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get Unique Books",
            "returnType": "array",
            "sourceCode": "let data = $context.$nodes.OWNEDASSETRETIREMENTSJSONGENERATION.$output.result || {};\n\n// Safely get rows\nlet rows = Array.isArray(data.assetRetirements) ? data.assetRetirements : [];\n\n// Extract unique book names\nlet uniqueBooks = [];\nlet seenBooks = {};\n\n// Loop through rows\nfor (let i = 0; i < rows.length; i++) {\n  let item = rows[i];\n  let bookName = item.bookName;\n\n  // Ignore null/empty values\n  if (bookName && !seenBooks[bookName]) {\n    seenBooks[bookName] = true;\n    uniqueBooks.push(bookName);\n  }\n}\n\nreturn uniqueBooks;"
          },
          "outcomes": {
            "success": "1778656189100"
          },
          "code": "GET_UNIQUE_BOOKS",
          "id": "1778588935066",
          "inputs": [],
