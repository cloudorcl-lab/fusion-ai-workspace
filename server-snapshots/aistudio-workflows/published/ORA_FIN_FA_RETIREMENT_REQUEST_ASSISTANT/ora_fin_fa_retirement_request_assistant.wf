                  "code": "GET_OWNED_ASSETS_TRANSACTION_RESULTS",
                  "id": "1775394637828",
                  "inputs": [
                    {
                      "id": "1775394637834_1",
                      "name": "prompt",
                      "type": "string",
                      "value": "From {{$context.$nodes.RETIREOWNASSETSLOOP.$currentItem}}  extract the row, bookName, assetNumber, description, tagNumber, dateRetired, retirementReason, transactionComments\nFrom {{$context.$nodes.RETIREOWNASSETSLOOP.COSTRETIREOWNEDASSETS.$output}} retrieve the values X_TRANSACTION_INTERFACE_ID, X_RETIREMENT_ID , X_RETURN_STATUS, X_TRANSACTION_HEADER_ID\n\nReturn the values as json with the structure as below\n\n{\n  \"row\": row,\n  \"bookName\": bookName,\n  \"assetNumber\": assetNumber,\n  \"description\": description,\n  \"tagNumber\": tagNumber,\n  \"dateRetired\": dateRetired,\n  \"retirementReason\": retirementReason,\n  \"transactionComments\": transactionComments,\n  \"retirementInterfaceId\": X_TRANSACTION_INTERFACE_ID,\n  \"retirementId\": X_RETIREMENT_ID,\n  \"returnStatus\": X_RETURN_STATUS,\n  \"transactionHeaderId\": X_TRANSACTION_HEADER_ID,\n  \"message\": X_MSG_DATA\n}"
                    }
                  ],
                  "outputSpecification": "{\n  \"row\": row,\n  \"bookName\": bookName,\n  \"assetNumber\": assetNumber,\n  \"description\": description,\n  \"tagNumber\": tagNumber,\n  \"dateRetired\": dateRetired,\n  \"retirementReason\": retirementReason,\n  \"transactionComments\": transactionComments,\n  \"retirementInterfaceId\": X_TRANSACTION_INTERFACE_ID,\n  \"retirementId\": X_RETIREMENT_ID,\n  \"returnStatus\": X_RETURN_STATUS,\n  \"transactionHeaderId\": X_TRANSACTION_HEADER_ID,\n  \"message\": X_MSG_DATA\n}",
                  "type": "LLM"
