        {
          "metadata": {
            "name": "OwnedAssetRetirementsJSONGeneration",
            "returnType": "object",
            "sourceCode": "var response = $context.$nodes.GET_DRAFT_RETIREMENTS_BY_USER.$output;\n\n/* -------------------------------\n   FIX: ParameterList can be STRING or OBJECT\n--------------------------------*/\nvar params = response.ParameterList;\n\nif (typeof params === \"string\") {\n  params = JSON.parse(params);\n}\n\n/* -------------------------------\n   SAFE ARRAY CONVERTER\n--------------------------------*/\nfunction toArray(val) {\n  if (val === null || val === undefined) return [];\n  return String(val).split(\",\").map(v => v.trim());\n}\n\n/* -------------------------------\n   BUILD COLUMNS\n--------------------------------*/\nvar book = toArray(params.X_BOOK_TYPE_CODE_TBL);\nvar assetNumber = toArray(params.X_ASSET_NUMBER_TBL);\nvar description = toArray(params.X_ASSET_DESCRIPTION_TBL);\nvar assetId = toArray(params.X_ASSET_ID_TBL);\nvar dateRetired = toArray(params.X_DATE_RETIRED_TBL);\n\nvar tagNumber = toArray(params.X_TAG_NUMBER_TBL);\nvar serialNumber = toArray(params.X_SERIAL_NUMBER_TBL);\nvar inServiceDate = toArray(params.X_DPIS_TBL);\n\nvar costRetired = toArray(params.X_COST_RET_TBL);\nvar proceeds = toArray(params.X_PROCEEDS_OF_SALE_TBL);\nvar removal = toArray(params.X_COST_OF_REMOVAL_TBL);\n\nvar reason = toArray(params.X_RETIREMENT_TYPE_CODE_TBL);\nvar conv = toArray(params.X_RET_CONV_TBL);\nvar status = toArray(params.X_POSTING_STATUS_TBL);\nvar errorMsg = toArray(params.X_ERROR_MSG_TBL);\n\n/* ----------- EXISTING NEW FIELD ----------- */\nvar retirementInterfaceId = toArray(params.X_RET_INTERFACE_ID_TBL);\n\n/* ----------- NEW FIELD (CREATION DATE) ----------- */\nvar creationDate = toArray(params.X_CREATION_DATE_TBL);\n\n/* -------------------------------\n   ROW COUNT\n--------------------------------*/\nvar rowCount = Math.max(\n  book.length,\n  assetNumber.length,\n  description.length,\n  assetId.length,\n  dateRetired.length,\n  tagNumber.length,\n  serialNumber.length,\n  inServiceDate.length,\n  costRetired.length,\n  proceeds.length,\n  removal.length,\n  reason.length,\n  conv.length,\n  status.length,\n  errorMsg.length,\n  retirementInterfaceId.length,\n  creationDate.length\n);\n\n/* -------------------------------\n   BUILD ROWS\n--------------------------------*/\nvar assetRetirements = [];\n\nfor (var i = 0; i < rowCount; i++) {\n  assetRetirements.push({\n    row: i + 1,\n\n    retirementInterfaceId: retirementInterfaceId[i] || null,\n    creationDate: creationDate[i] || null,\n\n    bookName: book[i] || null,\n    assetNumber: assetNumber[i] || null,\n    assetDescription: description[i] || null,\n    assetId: assetId[i] || null,\n    dateRetired: dateRetired[i] || null,\n\n    tagNumber: tagNumber[i] || null,\n    serialNumber: serialNumber[i] || null,\n    inServiceDate: inServiceDate[i] || null,\n\n    costRetired: costRetired[i] ? Number(costRetired[i]) : null,\n    proceedsOfSale: proceeds[i] ? Number(proceeds[i]) : null,\n    costOfRemoval: removal[i] ? Number(removal[i]) : null,\n\n    retirementReason: reason[i] || null,\n    retirementConvention: conv[i] || null,\n    postingStatus: status[i] || null,\n\n    errorMessage: errorMsg[i] || null\n  });\n}\n\nreturn {\n  totalRecords: assetRetirements.length,\n  assetRetirements\n};"
          },
          "outcomes": {
            "success": "1778588935066"
          },
          "code": "OWNEDASSETRETIREMENTSJSONGENERATION",
          "id": "1773071300049",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "HTMLGeneratorDraftRetirementsBySelfServiceUsers",
            "returnType": "string",
            "sourceCode": "let data = $context.$nodes.OWNEDASSETRETIREMENTSJSONGENERATION.$output.result;\n\n// ONLY SAFE FALLBACK (no optional chaining)\nif (!data) {\n  data = {};\n}\n\n// Retirement reason lookup source\nlet lookupSource = $context.$nodes.CREATE_RETIREMENT_REASON_JSON_FOR_REQUESTS.$output.result || [];\nlet lookupRows = [];\n\nif (Array.isArray(lookupSource)) {\n    if (lookupSource.length > 0 && Array.isArray(lookupSource[0].lookups)) {\n        lookupRows = lookupSource[0].lookups;\n    }\n} else if (Array.isArray(lookupSource.lookups)) {\n    lookupRows = lookupSource.lookups;\n}\n\nlet rows = data.assetRetirements || [];\nlet totalRows = rows.length;\n\n// ================= DATE FORMATTER =================\nfunction formatDate(dateValue) {\n    if (!dateValue) return \"\";\n\n    const dateText = String(dateValue).split(\"T\")[0];\n    const dateParts = dateText.split(\"-\");\n\n    if (dateParts.length !== 3) {\n        return dateValue;\n    }\n\n    const year = dateParts[0];\n    const month = dateParts[1];\n    const day = dateParts[2];\n\n    const userDateFormat = $context.$variables.userSessionDetails.userSession.DateFormat;\n\n    const monthNumber = parseInt(month, 10);\n    const dayNumber = parseInt(day, 10);\n\n    const shortMonthNames = [\n        \"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\",\n        \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"\n    ];\n\n    const formatTokens = {\n        YYYY: year,\n        yyyy: year,\n        YY: year.slice(-2),\n        yy: year.slice(-2),\n        y: year.slice(-2),\n\n        MMM: shortMonthNames[monthNumber - 1],\n\n        MM: month,\n        M: String(monthNumber),\n\n        dd: day,\n        d: String(dayNumber)\n    };\n\n    return String(userDateFormat).replace(\n        /YYYY|yyyy|YY|yy|y|MMM|MM|M|dd|d/g,\n        function (token) {\n            return formatTokens[token] || token;\n        }\n    );\n}\n\n// Convert lookupCode -> meaning\nfunction getRetirementReasonMeaning(code) {\n    if (!code) return \"\";\n\n    for (let i = 0; i < lookupRows.length; i++) {\n        let lookup = lookupRows[i];\n\n        if (\n            String(lookup.lookupCode).trim().toLowerCase() ===\n            String(code).trim().toLowerCase()\n        ) {\n            return lookup.meaning || code;\n        }\n    }\n\n    return code;\n}\n\n// ================= COUNT STATUSES =================\nlet approvedCount = 0;\nlet pendingCount = 0;\nlet errorCount = 0;\n\nfor (let i = 0; i < rows.length; i++) {\n    if (rows[i].postingStatus === \"POSTED\") approvedCount++;\n    else if (rows[i].postingStatus === \"AGENT_REVIEW\") pendingCount++;\n    else if (rows[i].postingStatus === \"ERROR\") errorCount++;\n}\n\nlet html = \"\";\n\n// ================= CARD =================\nhtml += \"<div style='font-family:Segoe UI, Arial, sans-serif; font-size:13px; color:#2f2f2f; background:#ffffff; border:1px solid #e4e4e4; border-radius:6px; padding:14px;'>\";\n\n// ================= TITLE =================\nhtml += \"<div style='font-size:16px; font-weight:600; margin-bottom:6px; color:#1f1f1f;'>\";\nhtml += \"My Asset Retirement Requests\";\nhtml += \"</div>\";\n\n// ================= INTRO =================\nhtml += \"<div style='font-size:13px; color:#4f4f4f; margin-bottom:6px;'>\";\nhtml += \"I’ve pulled together your recent asset retirement requests. Here’s their current status.\";\nhtml += \"</div>\";\n\n// ================= SUMMARY =================\nhtml += \"<div style='font-size:13px; color:#4f4f4f; margin-bottom:10px;'>\";\nhtml += \"You’ve submitted <b>\" + totalRows + \"</b> requests — \";\n\nlet parts = [];\n\nif (approvedCount > 0) {\n    parts.push(\"<b style='color:#3fa55b;'>\" + approvedCount + \"</b> approved and posted\");\n}\nif (pendingCount > 0) {\n    parts.push(\"<b style='color:#f39c12;'>\" + pendingCount + \"</b> pending approval\");\n}\nif (errorCount > 0) {\n    parts.push(\"<b style='color:#d94b3d;'>\" + errorCount + \"</b> needing attention\");\n}\n\nhtml += parts.join(\", \") + \".\";\nhtml += \"</div>\";\n\n// ================= ATTENTION MESSAGE =================\nif (errorCount > 0) {\n  html += \"<div style='margin-bottom:10px; padding:8px 10px; background:#fff5f5; border:1px solid #f1d6d6; border-radius:4px; font-size:12px; color:#a94442;'>\";\n  html += \"<b>\" + errorCount + \" request\" + (errorCount > 1 ? \"s require\" : \" requires\") + \" attention.</b>\";\n  html += \"</div>\";\n}\n\n// ================= TABLE WRAPPER =================\nhtml += \"<div style='width:100%; overflow-y:auto; max-height:420px;'>\";\n\n// ================= TABLE =================\nhtml += \"<table style='border-collapse:collapse; width:100%;'>\";\n\n// HEADER\nhtml += \"<tr style='background-color:#f5f5f5; position:sticky; top:0;'>\";\n\nlet thStyle = \"padding:9px 12px; border:1px solid #e6e6e6; text-align:left; white-space:nowrap; font-weight:500;\";\n\nhtml += \"<th style='\" + thStyle + \" width:40px; text-align:center;'>Row</th>\";\nhtml += \"<th style='\" + thStyle + \" width:120px;'>Request Id</th>\";\nhtml += \"<th style='\" + thStyle + \" width:140px;'>Submission Date</th>\";\nhtml += \"<th style='\" + thStyle + \" width:180px;'>Description</th>\";\nhtml += \"<th style='\" + thStyle + \"'>Tag Number</th>\";\nhtml += \"<th style='\" + thStyle + \"'>Serial Number</th>\";\nhtml += \"<th style='\" + thStyle + \"'>In Service Date</th>\";\nhtml += \"<th style='\" + thStyle + \"'>Retire Date</th>\";\nhtml += \"<th style='\" + thStyle + \"'>Retirement Reason</th>\";\nhtml += \"<th style='\" + thStyle + \"'>Status</th>\";\n\nhtml += \"</tr>\";\n\n// ROWS\nfor (let i = 0; i < rows.length; i++) {\n\n    let r = rows[i];\n\n    let statusLabel = \"Unknown\";\n    let statusColor = \"#8a8f94\";\n    let bg = (i % 2 === 0) ? \"#ffffff\" : \"#fbfbfb\";\n\n    if (r.postingStatus === \"AGENT_REVIEW\") {\n        statusLabel = \"Pending Approval\";\n        statusColor = \"#f39c12\";\n    } else if (r.postingStatus === \"POSTED\") {\n        statusLabel = \"Approved and Posted\";\n        statusColor = \"#3fa55b\";\n    } else if (r.postingStatus === \"ERROR\") {\n        statusLabel = \"Needs Attention\";\n        statusColor = \"#d94b3d\";\n        bg = \"#fff7f7\";\n    }\n\n    html += \"<tr style='background-color:\" + bg + \";'>\";\n\n    let tdStyle = \"padding:9px 12px; border:1px solid #f0f0f0; vertical-align:top;\";\n\n    html += \"<td style='\" + tdStyle + \" text-align:center;'>\" + (i + 1) + \"</td>\";\n    html += \"<td style='\" + tdStyle + \"'>\" + (r.retirementInterfaceId || \"\") + \"</td>\";\n    html += \"<td style='\" + tdStyle + \"'>\" + formatDate(r.creationDate) + \"</td>\";\n    html += \"<td style='\" + tdStyle + \"'>\" + (r.assetDescription || \"\") + \"</td>\";\n    html += \"<td style='\" + tdStyle + \"'>\" + (r.tagNumber || \"\") + \"</td>\";\n    html += \"<td style='\" + tdStyle + \"'>\" + (r.serialNumber || \"\") + \"</td>\";\n    html += \"<td style='\" + tdStyle + \"'>\" + formatDate(r.inServiceDate) + \"</td>\";\n    html += \"<td style='\" + tdStyle + \"'>\" + formatDate(r.dateRetired) + \"</td>\";\n    html += \"<td style='\" + tdStyle + \"'>\" + getRetirementReasonMeaning(r.retirementReason) + \"</td>\";\n\n    // STATUS\n    html += \"<td style='\" + tdStyle + \" white-space:nowrap; font-weight:500;'>\";\n    html += \"<span style='display:inline-flex; align-items:center; gap:6px;'>\";\n    html += \"<span style='width:10px;height:10px;border-radius:50%;background:\" + statusColor + \";'></span>\";\n    html += \"<span>\" + statusLabel + \"</span>\";\n    html += \"</span>\";\n    html += \"</td>\";\n\n    html += \"</tr>\";\n}\n\nhtml += \"</table>\";\nhtml += \"</div>\";\n\n// ================= OUTRO =================\nhtml += \"<div style='font-size:13px; color:#4f4f4f; margin-top:6px;'>\";\n\nif (errorCount > 0) {\n    html += \"You can review and update the requests that need attention in the table, or ask me to help resolve them.\";\n} \nelse if (pendingCount > 0) {\n    html += \"If you’d like, I can help you submit new requests.\";\n} \nelse {\n    html += \"If you’d like, I can help you submit new requests.\";\n}\n\nhtml += \"</div>\";\n\nhtml += \"</div>\";\n\nreturn html;"
          },
          "outcomes": {
            "success": "1777288322846"
          },
          "code": "HTMLGENERATORDRAFTRETIREMENTSBYSELFSERVICEUSERS",
          "id": "1773154954007",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
