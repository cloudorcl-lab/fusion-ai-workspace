            "OTHER_QUESTIONS": "1779869440665"
          },
          "code": "ROUTEBASEDONINTENT",
          "convergenceTargetId": "end",
          "id": "1771838992651",
          "inputs": [
            {
              "id": "1771838992655_1",
              "name": "caseExpression",
