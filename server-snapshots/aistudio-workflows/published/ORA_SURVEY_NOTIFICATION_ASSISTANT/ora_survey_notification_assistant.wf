        {
          "metadata": {
            "name": "Build Dynamic Link",
            "returnType": "string",
            "sourceCode": "const surveyRequestId = $context.$nodes.CREATE_SURVEY_REQUEST.$output.SurveyRequestId;\n\nlet urlTemplate = $context.$variables.dynamicLink;\n\n\nlet finalUrl = urlTemplate\n  .replace('{0}', surveyRequestId);\n\nreturn finalUrl"
          },
          "outcomes": {
            "success": "1771928279817"
          },
          "code": "BUILD_DYNAMIC_LINK",
          "convergenceTargetId": "1771927255465",
          "id": "1771927662856",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Build Email Payload",
            "returnType": "object",
            "sourceCode": "let response;\n\nresponse = {\n    \"ChannelId\": $context.$triggers.REST.$input.ChannelId,\n    \"SourceObjId\": $context.$triggers.REST.$input.ObjectId ,\n    \"SourceObjTypeCd\": \"ServiceRequest\",\n    \"SourceObjTemplateName\": $context.$triggers.REST.$input.EmailTemplateName ,\n    \"Body\": $context.$nodes.BUILD_DYNAMIC_LINK.$output.result ,\n    \"Stripe\": \"ORA_SVC_CRM\",\n    \"To\": $context.$triggers.REST.$input.EmailAddress \n}\n\nreturn response;"
          },
          "outcomes": {
            "success": "1771590188341"
          },
          "code": "BUILD_EMAIL_PAYLOAD",
