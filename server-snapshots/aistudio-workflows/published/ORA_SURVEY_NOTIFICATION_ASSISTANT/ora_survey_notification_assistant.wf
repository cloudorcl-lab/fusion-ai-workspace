            "name": "Check Inputs",
            "returnType": "string",
            "sourceCode": "const input = $context.$triggers.REST.$input;\n\n  const fields = [\n    input.BUOrgId,\n    input.SurveyId,\n    input.ObjectId,\n    input.EmailAddress,\n    input.ChannelId,\n    input.EmailTemplateName,\n    input.DynamicLinkType\n  ];\n\nreturn fields.every(v => v !== null && v !== undefined && String(v).trim() !== \"\");"
          },
          "outcomes": {
