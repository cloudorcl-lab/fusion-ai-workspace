                    "returnType": "array",
                    "sourceCode": "let uomList = [];\nconst languageCode = $context.$nodes.GET_SESSION_LANGUAGE.$output.languageCode;\n$context.$nodes.KEEP_FETCHING_UOMS_IN_LOOP.FETCHING_UOMS.$output.items.forEach((currentUOM, index) => {\n\tuomList.push(\n\t\t{\n                        \"UOMId\": currentUOM.UOMId,\n\t\t\t\"UOMCode\": currentUOM.UOMCode,\n\t\t\t\"UOMClassName\":currentUOM.UOMClassName,\n\t\t\t\"UOM\": currentUOM.UOM,\n\t\t\t\"Description\": currentUOM.Description || currentUOM.UOM,\n                        \"Language\":  languageCode\n\t\t}\n\t);\n});\nreturn uomList;"
                  },
                  "outcomes": {
                    "success": "end_1767000930648"
                  },
                  "code": "PARSE_UOMS_RESPONSE",
