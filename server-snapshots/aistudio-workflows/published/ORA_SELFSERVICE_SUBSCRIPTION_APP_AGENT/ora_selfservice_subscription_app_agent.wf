        {
          "metadata": {
            "errorNodeId": "1768190969668",
            "name": "initializeFetchSubscriptionProductPayload",
            "returnType": "object",
            "sourceCode": "const fetchSubscriptionProductPayload = {\n      \"q\": {\n        \"op\": \"$and\",\n        \"criteria\": [\n          {\n            \"op\": \"$eq\",\n            \"attribute\": \"SubscriptionProductPuid\",\n            \"value\":  $context.$variables.invokedActionObj.subscriptionProductId\n          }\n        ]\n      },\n       \"fields\": [\n        \"SubscriptionProductId\",\n        \"SubscriptionProductPuid\",\n        \"StartDate\",\n        \"EndDate\",\n        \"RequestedRatePlanId\",\n        \"TotalContractValue\",\n        \"ListOfCharges\",\n        \"SubscriptionId.SubscriptionNumber\",\n        \"BillToContactNumber\",\n        \"BillToSiteUseId\",\n        \"BillToAccountId\",\n        \"ShipToPartyId\",\n        \"ShipToContactNumber\",\n        \"SalesProductType\",\n        \"ItemUnitOfMeasure\",\n        \"ProductName\",\n        \"Quantity\",\n        \"Currency\",\n        \"Status\",\n        \"Status_localizedValue\",\n        \"BillingFrequency\",\n        \"BillingFrequency_localizedValue\",\n        \"InvoicedAmount\",\n        \"EstimatedTax\",\n        \"RenewalType\",\n        \"RenewalType_localizedValue\",\n        \"MonthlyRecurringRevenue\",\n        \"TcvWithTotalUsageCharge\",\n        \"BalanceRegisterNumber\",\n        \"ExternalAssetKey\",\n        \"RatePlanId\",\n        \"PaymentMethod\",\n        \"BillToContactName\", \n        \"ShipToContactName\",\n        \"BillToContactEmail\",\n        \"ShipToContactEmail\",\n        \"WireNumber\",\n        \"PONumber\"\n      ],\n      \"limit\": 1\n};\n\nreturn fetchSubscriptionProductPayload;"
          },
          "outcomes": {
            "success": "1772018864962"
          },
          "code": "INITIALIZEFETCHSUBSCRIPTIONPRODUCTPAYLOAD",
          "convergenceTargetId": "1772018864962",
          "id": "1772018812183",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
