            "name": "Check shipping contact",
            "returnType": "string",
            "sourceCode": "let contactNumber=\"\";\nlet shipToContactNumber = $context.$nodes.EXTRACT_FURTHER_INTENT.$output.shipToContactNumber;\nlet shippingContacts = $context.$nodes.FETCH_SHIPPING_CONTACTS.$output.items;\n\nif (!$context.$nodes.FETCH_SHIPPING_CONTACTS) {\n return contactNumber;\n}\n\nif (shipToContactNumber) {\n  let matchedContact = shippingContacts.find(contact => contact.ContactNumber === shipToContactNumber);\n  if (matchedContact) {\n    return matchedContact.ContactNumber;\n  }\n} else {\n  let contactName = $context.$nodes.EXTRACT_FURTHER_INTENT.$output.shippingContactName.trim().toLowerCase();\n  let matchedContact = shippingContacts.find(contact => contact.Name.trim().toLowerCase() === contactName);\n  if (matchedContact) {\n    return matchedContact.ContactNumber;\n  }\n}\n\n return contactNumber;"
          },
