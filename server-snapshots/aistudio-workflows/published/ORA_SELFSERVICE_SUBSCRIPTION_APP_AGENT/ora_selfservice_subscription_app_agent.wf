            "name": "check contact for product",
            "returnType": "string",
            "sourceCode": "let contactNumber=\"\";\nlet billToContactNumber = $context.$nodes.EXTRACT_INTENT_FOR_SUB_PRODUCT.$output.billToContactNumber;\nlet billingContacts = $context.$nodes.SUBSCRIPTION_PRODUCT_BILLING_CONTACTS.$output.items;\n\nif (!$context.$nodes.SUBSCRIPTION_PRODUCT_BILLING_CONTACTS) {\n return contactNumber;\n}\n\nif (billToContactNumber) {\n  let matchedContact = billingContacts.find(contact => contact.ContactNumber === billToContactNumber);\n  if (matchedContact) {\n    return matchedContact.ContactNumber;\n  }\n} else {\n  let contactName = $context.$nodes.EXTRACT_INTENT_FOR_SUB_PRODUCT.$output.billingContactName.trim().toLowerCase();\n  let matchedContact = billingContacts.find(contact => contact.Name.trim().toLowerCase() === contactName);\n  if (matchedContact) {\n    return matchedContact.ContactNumber;\n  }\n}\n\n return contactNumber;"
          },
