          "id": "1775745567891",
          "inputs": [
            {
              "id": "1775745567893_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an assistant responsible for generating clear and user-friendly validation messages for subscription payment method.\n\nInput:\n1. paymentMethod (string) –  {{$context.$nodes.EXTRACT_PAYMENT_DETAILS.$output.result.data.PaymentMethod}}\n2. validationResult (object): {{$context.$nodes.VALIDATEPAYMENTDETAILSFORSUBSPRODUCT.$output.result}} \n{\n  \"valid\": boolean,\n  \"errors\": {\n    \"paymentInputRequired\": boolean,\n    \"paymentInputMaxLengthExceeded\": boolean\n  }\n}\n\nTask:\nIf validationResult.valid is false\n      - ORA_PURCHASE_ORDER → \"Please enter a valid purchase order number and submit to continue.\"\n      - ORA_WIRE → \"Please enter a valid wire number and submit to continue.\"\n      - otherwise → \"Please enter a valid payment reference and submit to continue.\"\n\nRules:\n- Keep the tone friendly, clear, and professional.\n- Use simple language for self-service users.\n- Do not mention technical field names or validation terms.\n- Return only one final message string."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "errorNodeId": "1768190969668",
            "name": "validateSubscriptionPaymentDetails",
            "returnType": "object",
            "sourceCode": "const parsed = ($context && $context.$nodes && $context.$nodes.PARSEACTION?.$output?.result) || {};\nconst actionObj = parsed?.actionObj || {};\n\nconst paymentInput = actionObj?.paymentInput || \"\";\nconst paymentMethod = $context?.$nodes?.EXTRACTSUBSCRIPTIONCONFIRMEDPAYMENTDETAILS?.$output?.result?.data?.PaymentMethod || \"\";\n\nlet validationResult = {\n  valid: true,\n  errors: {\n    paymentInputRequired: false,\n    paymentInputMaxLengthExceeded: false\n  }\n};\n\n// Determine max length based on payment method\nlet maxLength = null;\n\nif (paymentMethod === \"ORA_WIRE\") {\n  maxLength = 30;\n} else if (paymentMethod === \"ORA_PURCHASE_ORDER\") {\n  maxLength = 50;\n}\n\nconst isEmpty =  paymentInput === null ||\n  paymentInput === undefined || (typeof paymentInput === \"string\" && paymentInput.trim() === \"\");\nconst exceedsLength = typeof paymentInput === \"string\" && maxLength !== null && paymentInput.length > maxLength;\n\nif (paymentMethod === \"ORA_WIRE\" || paymentMethod === \"ORA_PURCHASE_ORDER\") {\n\n  if (isEmpty) {\n    validationResult.valid = false;\n    validationResult.errors.paymentInputRequired = true;\n  }\n\n  if (exceedsLength) {\n    validationResult.valid = false;\n    validationResult.errors.paymentInputMaxLengthExceeded = true;\n  }\n}\n\nreturn validationResult;"
          },
          "outcomes": {
            "success": "1775750056149"
          },
          "code": "VALIDATESUBSCRIPTIONPAYMENTDETAILS",
          "id": "1775749752054",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
