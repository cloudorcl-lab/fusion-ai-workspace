        {
          "metadata": {
            "errorNodeId": "1768190969668",
            "name": "parseAction",
            "returnType": "object",
            "sourceCode": "const action = $context.$app.$OraAction;\nconst match = action.match(\n  /<oraFormSubmit\\s+id=[\"']([^\"']*)[\"'][^>]*>(.*?)<\\/oraFormSubmit>/s\n);\n\nlet returnObj = { formSubmit: false }; // Initialize returnObj\nlet formValues = {};\n\nif (match) {\n const actionAndId = match[1];      // The ID value\n let firstUnderscoreIndex = actionAndId.indexOf('-$-');\n \n // Split the string at the first underscore,\n let actionName= actionAndId.slice(0, firstUnderscoreIndex);\n\nlet formId = null;\n\nif (firstUnderscoreIndex !== -1 && firstUnderscoreIndex + 3 < actionAndId.length) {\n  formId = actionAndId.slice(firstUnderscoreIndex + 3);\n}\n\n  const jsonContent = match[2];     // The JSON content\n  returnObj.formSubmit = true;\n\n  // Parse the JSON content from the match\n  let json;\n  try {\n    json = JSON.parse(jsonContent); // Wrap in array brackets for valid JSON\n  } catch (e) {\n    // Handle error in case JSON parsing fails\n    console.error('Error parsing JSON content:', e);\n  }\n\n  // Loop through the parsed JSON and set each item in formValues with id as key and value as value\n  json.forEach(item => {\n    if (item.id && item.value !== undefined) {\n      formValues[item.id] = item.value;\n    }\n  });\n\n  // Structuring returnObj after processing all items in JSON\n  returnObj.action = actionName;\n  returnObj.actionObj = formValues;  // Empty object or you can fill it with specific values if needed\n  returnObj.actionObj.formId = formId;\n} else {\n  // If no match, use the default action from context\n  let actionObj = {};\n\n  if (typeof action === \"string\") {\n    let current = action.trim();\n\n    while (true) {\n      let prev = current;\n\n      try {\n        const parsed = JSON.parse(current);\n\n        if (typeof parsed === \"string\") {\n          current = parsed.trim();\n        } else {\n          actionObj = parsed;\n          break;\n        }\n      } catch (e) {\n        const cleaned = current\n          .replace(/\\\\+\"/g, '\"')          // fix \\\" or \\\\\\\" etc.\n          .replace(/^\"(.*)\"$/s, '$1');   // remove wrapping quotes\n\n        if (cleaned === current) break; // no more progress possible\n        current = cleaned;\n      }\n\n      // stop if nothing changed to avoid infinite loop\n      if (current === prev) break;\n    }\n  } else {\n    actionObj = action;\n  }\n\n  returnObj.action = actionObj.action;\n  returnObj.actionObj = actionObj;\n}\n\nreturn returnObj;"
          },
          "outcomes": {
            "success": "1768418939988"
          },
          "code": "PARSEACTION",
          "id": "1768418861989",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
