            {
              "id": "1768190969671_1",
              "name": "prompt",
              "type": "string",
              "value": "You are handling errors across the agent flows. \nOutput exactly the following sentence and nothing else. Do not add any greeting, explanation, prefix, suffix, quotation marks, or markdown.\n\"We were unable to process your request at this time. Please try again later or contact your sales representative for assistance.\""
            }
