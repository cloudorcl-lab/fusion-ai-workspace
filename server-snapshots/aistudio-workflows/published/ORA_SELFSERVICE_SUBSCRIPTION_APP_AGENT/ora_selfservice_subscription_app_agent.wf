          "code": "EXTRACT_FURTHER_INTENT",
          "id": "1773119468920",
          "inputs": [
            {
              "id": "1773119468924_1",
              "name": "prompt",
              "type": "string",
              "value": "Role:\nYou are a specialized Intent Classification and Entity Extraction assistant for Change Contact of Subscription. Your goal is to analyze user input and extract specific parameters needed for processing change contact of subscriptions & subscription products.\n\nInput Message:\n{{$context.$system.$inputMessage}}\n\nInstructions:\nExtract Entities: Identify if the user has provided Subscription Number, Subscription Product Id, Billing Contact Name, BillToContactNumber, Shipping Contact Name, ShipToContactNumber, contact type(billing or shipping) for the subscription contact change. If a value is missing, return null. Look for any keyword, name, title, important or meaningful key/text & consider it as Subscription Number.(Strictly) \n\nIntent Classification:\nIf intent isSubscription, set Subscription Number correctly. This is very important for flow to work correctly.\n\nchangeContactFull:\nSelect this If Subscription Number/Subscription Product Id are present & any of these (BillToContactNumber, Billing Contact Name, ShipToContactNumber, Shipping Contact Name) has value other than null & is not null in the input (Strictly)\n\nchangeContactPartial: \nSelect this If only Subscription Number/Subscription Product Id are present & none of these (BillToContactNumber, Billing Contact Name, ShipToContactNumber, Shipping Contact Name) have any value in the input (Strictly). Look for any keyword, name, title, important key & consider it as Subscription Number(Strictly). Check if {{$context.$system.$chatHistory}} has Subscription Number/Subscription Product Id & pick up the latest one.\n\nValidate that correct Subscription Number/Subscription Product Id are set based on isSubscription. This is very important as flow is depend on it."
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"contactType\": {\n            \"type\": \"string\"\n        },\n        \"shipToContactNumber\": {\n            \"type\": \"string\"\n        },\n        \"shippingContactName\": {\n            \"type\": \"string\"\n        },\n        \"billToContactNumber\": {\n            \"type\": \"string\"\n        },\n        \"billingContactName\": {\n            \"type\": \"string\"\n        },\n        \"isSubscription\": {\n            \"type\": \"boolean\"\n        },\n        \"queryIntent\": {\n            \"type\": \"string\"\n        },\n        \"subscriptionProductId\": {\n            \"type\": \"string\"\n        },\n        \"subscriptionNumber\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "switchFurtherIntent"
          },
