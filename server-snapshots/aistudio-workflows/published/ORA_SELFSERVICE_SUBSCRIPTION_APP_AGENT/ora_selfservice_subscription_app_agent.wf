            "sourceCode": "const fetchSubscriptionProductPayload = {\n      \"q\": {\n        \"op\": \"$and\",\n        \"criteria\": [\n          {\n            \"op\": \"$eq\",\n            \"attribute\": \"SubscriptionProductPuid\",\n            \"value\":  $context.$variables.invokedActionObj.subscriptionProductId\n          }\n        ]\n      },\n      \"fields\": [\n        \"SubscriptionProductId\",\n        \"SubscriptionProductPuid\",\n        \"StartDate\",\n        \"EndDate\",\n        \"ProductName\",\n        \"Quantity\",\n        \"Currency\",\n        \"Status\",\n        \"Status_localizedValue\",\n        \"InvoicedAmount\",\n        \"CreditedAmount\",\n        \"EstimatedTax\"\n      ],\n      \"limit\": 1\n};\n\nreturn fetchSubscriptionProductPayload;"
          },
