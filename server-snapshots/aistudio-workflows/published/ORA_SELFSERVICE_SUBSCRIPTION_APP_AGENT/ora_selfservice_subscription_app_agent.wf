            "name": "prepare payload for current billing contact",
            "returnType": "object",
            "sourceCode": "const fetchContactPayload = {\n      \"q\": {\n        \"op\": \"$and\",\n        \"criteria\": [\n          {\n            \"op\": \"$eq\",\n            \"attribute\": \"PartyNumber\",\n            \"value\":  $context.$nodes.FETCH_SUBSCRIPTION.$output.BillToContactNumber\n          }\n        ]\n      },\n      \"fields\": [\n        \"PrimaryEmail.EmailAddress\",\n        \"ListOfEmails\",\n        \"PersonName\",\n        \"PartyNumber\"\n      ],\n      \"limit\": 1\n};\n\nreturn fetchContactPayload;"
          },
          "outcomes": {
            "success": "1772797346389"
          },
