          "metadata": {
            "errorNodeId": "1768190969668",
            "name": "getListSubscriptionPayload",
            "returnType": "object",
            "sourceCode": "const accountPartyIdRaw =\n  $context?.$nodes?.RETURN_ACCOUNT_DETAILS?.$output?.result?.AccountPartyId;\n\n// Convert to number\nconst accountPartyId = accountPartyIdRaw !== null && accountPartyIdRaw !== undefined && accountPartyIdRaw !== \"\"\n  ? Number(accountPartyIdRaw)\n  : null;\n\nconst criteria = [\n  {\n    op: \"$wi\",\n    attribute: \"EndDate\",\n    value1: \"now/d+1d\",\n    value2: \"now/d+31d\",\n  },\n  {\n    op: \"$in\",\n    attribute: \"Status\",\n    values: [\"ORA_ACTIVE\"],\n  },\n];\n\nif (accountPartyId !== null && accountPartyId !== undefined && accountPartyId !== \"\") {\n  criteria.push({\n    op: \"$eq\",\n    attribute: \"PrimaryPartyId\",\n    value: accountPartyId,\n  });\n}\n\nconst fetchSubscriptionPayload = {\n  q: { op: \"$and\", criteria },\n  sort: [{ attribute: \"SubscriptionNumber\", direction: \"descending\" }],\n  limit: 4,\n  offset: 0,\n};\n\nconst result = {};\nresult.fetchSubscriptionPayload = fetchSubscriptionPayload;\n\nreturn result ;"
          },
          "outcomes": {
            "success": "1775078041472"
          },
          "code": "GETLISTSUBSCRIPTIONPAYLOAD",
          "id": "1775077964911",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
