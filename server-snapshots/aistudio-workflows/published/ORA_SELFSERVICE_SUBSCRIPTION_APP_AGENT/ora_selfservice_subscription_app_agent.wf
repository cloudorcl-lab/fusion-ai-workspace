        {
          "metadata": {
            "errorNodeId": "1768190969668",
            "name": "initializeFetchSubscriptionPayload",
            "returnType": "object",
            "sourceCode": "const fetchSubscriptionPayload = {\n      \"q\": {\n        \"op\": \"$and\",\n        \"criteria\": [\n          {\n            \"op\": \"$eq\",\n            \"attribute\": \"SubscriptionNumber\",\n            \"value\": $context.$variables.invokedActionObj.subscriptionId\n          }\n        ]\n      },\n    \"limit\": 1\n};\n\nconst fetchSubscriptionProductPayload = {\n      \"q\": {\n        \"op\": \"$and\",\n        \"criteria\": [\n          {\n            \"op\": \"$eq\",\n            \"attribute\": \"SubscriptionId.SubscriptionNumber\",\n            \"value\":  $context.$variables.invokedActionObj.subscriptionId\n          }\n        ]\n      },\n      \"sort\": [{\n           \"attribute\": \"TotalContractValue\",\n           \"direction\": \"descending\"\n       }],\n      \"fields\": [\n        \"SubscriptionProductId\",\n        \"SubscriptionProductPuid\",\n        \"StartDate\",\n        \"EndDate\",\n        \"TotalContractValue\",\n        \"ListOfCharges\",\n        \"SubscriptionId.SubscriptionNumber\",\n        \"SalesProductType\",\n        \"ItemUnitOfMeasure\",\n        \"BillToContactNumber\",\n        \"BillToSiteUseId\",\n        \"BillToAccountId\",\n        \"ShipToParty\",\n        \"ShipToContactNumber\",\n        \"ProductName\",\n        \"Quantity\",\n        \"Currency\",\n        \"Status\",\n        \"Status_localizedValue\",\n        \"BillingFrequency\",\n        \"BillingFrequency_localizedValue\",\n        \"InvoicedAmount\",\n        \"EstimatedTax\",\n        \"RenewalType\",\n        \"RenewalType_localizedValue\",\n        \"MonthlyRecurringRevenue\",\n        \"TcvWithTotalUsageCharge\",\n        \"BalanceRegisterNumber\",\n        \"ExternalAssetKey\"\n      ],\n  \"limit\": 5\n};\n\n\n\nconst result = {};\nresult.fetchSubscriptionPayload = fetchSubscriptionPayload;\nresult.fetchSubscriptionProductsPayload = fetchSubscriptionProductPayload;\n\nreturn result ;"
          },
          "outcomes": {
            "success": "1772014841837"
          },
          "code": "INITIALIZE_FETCH_SUBSCRIPTION_PAYLOAD",
          "id": "1772014778443",
          "inputs": [],
