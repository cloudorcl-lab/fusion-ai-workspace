              "value": "SubscriptionId,ShipToPartyNumber,ShipToContactNumber,SubscriptionNumber,StatusName,BillingFrequencyName,PaymentTermsName,PrimaryPartyName,StartDate,EndDate,Currency,TotalContractValue,EstimatedTax,InvoicedAmount,TcvWithTotalUsageCharge,BillToContactNumber,BillToSiteUseId,BillToAccountId,BillToPartyId,PaymentMethod,PaymentMethodName,PONumber,WireNumber;creditCards:CreditCardPuid,InstrAssignmentId,MaskedNumber,LastUpdateDate,IssuerCode,ExpirationDate,CardHolderName"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "IdentifyMode",
            "returnType": "string",
            "sourceCode": "const input = $context?.$app?.$OraAppContext;\n\nlet obj = {};\nif (typeof input === \"string\" && input.trim() !== \"\") {\n  try {\n    obj = JSON.parse(input);\n  } catch (e) {\n    obj = {}; \n  }\n}\n\nconst mode = obj.mode ?? \"ui\";\nreturn mode;"
          },
          "outcomes": {
            "success": "1775117577313"
          },
          "code": "IDENTIFYMODE",
          "id": "1773506419236",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "SubscriptionIdentityRoute"
          },
          "outcomes": {
            "true": "1772208473242",
            "false": "1773506315328"
          },
          "code": "SUBSCRIPTIONIDENTITYROUTE",
          "convergenceTargetId": "end",
          "id": "1773506026068",
          "inputs": [
            {
              "id": "1773506026069_1",
              "name": "condition",
              "type": "string",
