            "false": "1774939047607"
          },
          "code": "CHECK_TYPE_OF_CONTACT",
          "convergenceTargetId": "end",
          "id": "1773118367492",
          "inputs": [
            {
              "id": "1773118367495_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_FURTHER_INTENT.$output.contactType === \"billing\"}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "errorNodeId": "1768190969668",
            "name": "Check contact",
            "returnType": "string",
            "sourceCode": "let contactNumber=\"\";\nlet billToContactNumber = $context.$nodes.EXTRACT_FURTHER_INTENT.$output.billToContactNumber;\nlet billingContacts = $context.$nodes.SUBSCRIPTION_BILLING_CONTACTS.$output.items;\n\nif (!$context.$nodes.SUBSCRIPTION_BILLING_CONTACTS) {\n return contactNumber;\n}\n\nif (billToContactNumber) {\n  let matchedContact = billingContacts.find(contact => contact.ContactNumber === billToContactNumber);\n  if (matchedContact) {\n    return matchedContact.ContactNumber;\n  }\n} else {\n  let contactName = $context.$nodes.EXTRACT_FURTHER_INTENT.$output.billingContactName.trim().toLowerCase();\n  let matchedContact = billingContacts.find(contact => contact.Name.trim().toLowerCase() === contactName);\n  if (matchedContact) {\n    return matchedContact.ContactNumber;\n  }\n}\n\n return contactNumber;"
          },
          "outcomes": {
            "success": "1774938666111"
          },
          "code": "CHECK_CONTACT",
          "id": "1774938586139",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
