            "errorNodeId": "1768190969668",
            "name": "Extract Payment Method",
            "returnType": "object",
            "sourceCode": "const parsed = ($context.$nodes.PARSEACTION?.$output?.result) || {};\nconst actionObj = parsed.actionObj || {};\nlet retObject = {\nformSubmit: parsed.formSubmit === true,\naction: parsed.action || \"\",\nsubscriptionProductId: actionObj.subscriptionProductId || \"\", // per new payload\npaymentMethodGroup: actionObj.paymentMethodGroup || \"\",\npaymentMethodMeaning: actionObj.paymentMethodMeaning || \"\",\nbillToSiteUseId: actionObj.billToSiteUseId || \"\",\nbillToAccountId: actionObj.billToAccountId || \"\",\nbillToPartyId: actionObj.billToPartyId || \"\",\nproductName:actionObj.productName || \"\"\n};\nreturn retObject;"
          },
          "outcomes": {
            "success": "1772650467246"
          },
