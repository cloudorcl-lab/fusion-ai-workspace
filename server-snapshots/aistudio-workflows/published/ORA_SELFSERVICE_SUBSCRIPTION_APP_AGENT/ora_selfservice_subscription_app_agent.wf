            "name": "Prepare Current Billing Contact Display",
            "returnType": "string",
            "sourceCode": "// Get billing contact details\nconst billingOutput =\n  $context?.$nodes?.GET_CURRENT_BILLING_CONTACT_DETAILS?.$output;\n\nconst billingDetails =\n  Array.isArray(billingOutput) && billingOutput.length > 0\n    ? billingOutput[0]\n    : null;\n\nlet displayValue = \"\";\n\nif (billingDetails) {\n  const contactName = billingDetails.PersonName || \"\";\n  const emailAddress = billingDetails.EmailAddress || \"\";\n\n  if (emailAddress && emailAddress.trim() !== \"\") {\n    displayValue = `${contactName} (${emailAddress})`;\n  } else {\n    displayValue = contactName;\n  }\n}\n\n// displayValue will contain:\n// \"ContactName (EmailAddress)\" if email exists\n// otherwise \"ContactName\"\nreturn displayValue;"
          },
          "outcomes": {
            "success": "1772116814199"
          },
          "code": "PREPARE_CURRENT_BILLING_CONTACT_DISPLAY",
          "convergenceTargetId": "1772652675177",
          "id": "1772116776790",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1768190969668",
            "name": "Prepare Current Shipping Contact Display",
            "returnType": "string",
            "sourceCode": "// Get shipping contact details\nconst shippingOutput =\n  $context?.$nodes?.GET_CURRENT_SHIPPING_CONTACT?.$output;\n\nconst shippingDetails =\n  Array.isArray(shippingOutput) && shippingOutput.length > 0\n    ? shippingOutput[0]\n    : null;\n\nlet displayValue = \"\";\n\nif (shippingDetails) {\n  const contactName = shippingDetails.PersonName || \"\";\n  const emailAddress = shippingDetails.EmailAddress || \"\";\n\n  if (emailAddress && emailAddress.trim() !== \"\") {\n    displayValue = `${contactName} (${emailAddress})`;\n  } else {\n    displayValue = contactName;\n  }\n}\n\n// displayValue will contain:\n// \"ContactName (EmailAddress)\" if email exists\n// otherwise \"ContactName\"\nreturn displayValue;"
          },
          "outcomes": {
            "success": "1772653498881"
          },
          "code": "PREPARE_CURRENT_SHIPPING_CONTACT_DISPLAY",
          "convergenceTargetId": "1772652675177",
