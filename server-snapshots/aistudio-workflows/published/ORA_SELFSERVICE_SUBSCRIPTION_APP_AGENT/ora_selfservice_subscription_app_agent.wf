{
  "workflowId": "300000331056444",
  "workflowCode": "ORA_SELFSERVICE_SUBSCRIPTION_APP_AGENT",
  "name": "SelfService Subscription App Agent",
  "description": "SelfService Subscription App Agent helps to manage subscriptions  with clear, value‑focused views and guided updates. See subscription and product details (number/status, start–end dates, total contract value, quantities), with product charges shown line‑by‑line (one‑time, recurring, usage) and side‑by‑side rate‑plan comparisons, including tiers and quantity updates via confirmation. Review invoices  and update payment methods or billing/shipping contacts through simple forms, with changes confirmed; natural‑language search returns concise, relevant results at the subscription or product level.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
