        {
          "metadata": {
            "errorNodeId": "1768190969668",
            "name": "extractSubscriptionConfirmedPaymentDetails",
            "returnType": "object",
            "sourceCode": "const parsed = ($context.$nodes.PARSEACTION?.$output?.result) || {};\nconst actionObj = parsed.actionObj || {};\n\nlet subscriptionNumber = \"\";\nlet paymentMethod = \"\";\nconst formId = actionObj.formId || \"\";\n\n// Extract SubscriptionNumber and PaymentMethod from formId if possible\nif (formId && formId.includes(\"-$-\")) {\n  const [subNum, payMethod] = formId.split(\"-$-\");\n  subscriptionNumber = subNum || \"\";\n  paymentMethod = payMethod || \"\";\n} else {\n  subscriptionNumber = formId || \"\";\n}\n\n// Construct result using only extracted PaymentMethod (no mapping)\nlet result = {\n    PaymentMethod: paymentMethod\n};\n\nlet finalResult = {\n    SubscriptionNumber: subscriptionNumber\n}\n\nswitch (paymentMethod) {\n    case \"ORA_CREDIT_CARD\":\n        result.InstrAssignmentId = actionObj.paymentInput || \"\";\n        result.CreditCardPuid = subscriptionNumber;\n        break;\n    case \"ORA_PURCHASE_ORDER\":\n        result.PONumber = actionObj.paymentInput || \"\";\n        break;\n    case \"ORA_WIRE\":\n        result.WireNumber = actionObj.paymentInput || \"\";\n        break;\n}\nfinalResult.data= result;\n\nreturn finalResult;"
          },
          "outcomes": {
            "success": "1775749752054"
          },
          "code": "EXTRACTSUBSCRIPTIONCONFIRMEDPAYMENTDETAILS",
          "id": "1772465126745",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "aiAppOutputSpecification": {
