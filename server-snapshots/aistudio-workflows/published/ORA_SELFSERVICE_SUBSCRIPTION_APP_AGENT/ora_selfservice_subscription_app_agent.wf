            "name": "changePaymentSubscriptionFullLLM"
          },
          "outcomes": {
            "success": "1775072509618"
          },
          "code": "CHANGEPAYMENTSUBSCRIPTIONFULLLLM",
          "convergenceTargetId": "1774948547221",
          "id": "1772649072606",
          "inputs": [
            {
              "id": "1772649072607_1",
              "name": "prompt",
              "type": "string",
              "value": "Output Rules:\n\n- Return ONLY one valid JSON object.\n- No markdown, no code fences, no explanations.\n- Use double quotes for ALL keys and values.\n- Property keys MUST match EXACTLY as specified below (case-sensitive).\n- DO NOT modify key names (no camelCase or lowercase conversion).\n- Use EXACT keys:\n  \"SubscriptionNumber\"\n  \"SubscriptionProductPuid\"\n  \"PaymentMethod\"\n  \"WireNumber\"\n  \"PONumber\"\n  \"InstrAssignmentId\"\n  \"CreditCardPuid\"\n\nLogic:\n\n1. Resolve PaymentMethod:\n\n* From {{$context.$nodes.GET_PAYMENT_METHODS.$output}}, find the item where display/name matches {{$context.$nodes.QUERYINTENTEXTRACT.$output.paymentMethod}} (case-insensitive, trimmed, allow partial match).\n* Extract its \"LookupCode\".\n* Use this resolved value directly in \"PaymentMethod\".\n\n2. If {{$context.$nodes.QUERYINTENTEXTRACT.$output.paymentMethod}} is \"Wire\" or \"Purchase Order\":\n\n* If {{$context.$nodes.QUERYINTENTEXTRACT.$output.isSubscription}} is true:\n  Return {\n  \"SubscriptionNumber\": \"{{$context.$nodes.QUERYINTENTEXTRACT.$output.subscriptionNumber}}\",\n  \"data\": {\n  \"PaymentMethod\": \"<LookupCode from GET_PAYMENT_METHODS matching paymentMethod>\",\n  \"WireNumber\": \"{{$context.$nodes.QUERYINTENTEXTRACT.$output.wireNumber}}\",\n  \"PONumber\": \"{{$context.$nodes.QUERYINTENTEXTRACT.$output.poNumber}}\"\n  }\n  }\n\n* Else:\n  Return {\n  \"SubscriptionProductPuid\": \"{{$context.$nodes.QUERYINTENTEXTRACT.$output.subscriptionProductId}}\",\n  \"data\": {\n  \"PaymentMethod\": \"<LookupCode from GET_PAYMENT_METHODS matching paymentMethod>\",\n  \"WireNumber\": \"{{$context.$nodes.QUERYINTENTEXTRACT.$output.wireNumber}}\",\n  \"PONumber\": \"{{$context.$nodes.QUERYINTENTEXTRACT.$output.poNumber}}\"\n  }\n  }\n\n3. If {{$context.$nodes.QUERYINTENTEXTRACT.$output.paymentMethod}} is \"Credit Card\":\n\n* From {{$context.$nodes.GETCREDITCARDS.$output}}, find the FIRST match using {{$context.$nodes.QUERYINTENTEXTRACT.$output.cardDetail}} (case-insensitive, partial match).\n\n* Extract \"InstrAssignmentId\".\n\n* Use this resolved value directly.\n\n* If {{$context.$nodes.QUERYINTENTEXTRACT.$output.isSubscription}} is true:\n  Return {\n  \"SubscriptionNumber\": \"{{$context.$nodes.QUERYINTENTEXTRACT.$output.subscriptionNumber}}\",\n  \"data\": {\n  \"PaymentMethod\": \"<LookupCode from GET_PAYMENT_METHODS matching paymentMethod>\",\n  \"InstrAssignmentId\": \"<InstrAssignmentId from GETCREDITCARDS matching cardDetail>\",\n  \"CreditCardPuid\": \"{{$context.$nodes.QUERYINTENTEXTRACT.$output.subscriptionNumber}}\"\n  }\n  }\n\n* Else:\n  Return {\n  \"SubscriptionProductPuid\": \"{{$context.$nodes.QUERYINTENTEXTRACT.$output.subscriptionProductId}}\",\n  \"data\": {\n  \"PaymentMethod\": \"<LookupCode from GET_PAYMENT_METHODS matching paymentMethod>\",\n  \"InstrAssignmentId\": \"<InstrAssignmentId from GETCREDITCARDS matching cardDetail>\",\n  \"CreditCardPuid\": \"{{$context.$nodes.QUERYINTENTEXTRACT.$output.subscriptionProductId}}\"\n  }\n  }"
            }
          ],
          "type": "LLM"
        },
        {
