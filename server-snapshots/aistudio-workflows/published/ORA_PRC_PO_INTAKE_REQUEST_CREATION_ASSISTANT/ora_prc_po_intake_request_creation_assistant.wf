{
  "workflowId": "300000331063916",
  "workflowCode": "ORA_PRC_PO_INTAKE_REQUEST_CREATION_ASSISTANT",
  "name": "Intake Request Creation Assistant",
  "description": "Assists employees in the intake request creation process. This assistant analyzes user input, identifies the template to be used to create the request, extracts information required to fill out the template, and presents it in a structured form back to the user. Users can review and update the information if needed, and then submit to create the intake request. On successful creation of the request, a deep link will be provided for the user to navigate to the application for further processing.",
