            "name": "User Interaction Assignment",
            "returnType": "array",
            "sourceCode": "const raw = $context.$variables.userRequirementsArray;\n\nlet feedbackReceived = $context.$system.$inputMessage;\nlet feedBackArr = (raw && raw !== 'null') ? (Array.isArray(raw) ? raw : [raw]) : [];\n\nif (feedbackReceived != null && feedbackReceived !== 'null' && $context.$variables.initialInputCaptured == false) {\n  feedBackArr = [...feedBackArr, feedbackReceived];\n}\n\nreturn feedBackArr;"
          },
          "outcomes": {
