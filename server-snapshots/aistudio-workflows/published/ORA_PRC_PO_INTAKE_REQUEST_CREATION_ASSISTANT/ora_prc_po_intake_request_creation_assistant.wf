          "metadata": {
            "name": "Chat Summary Consolidation",
            "returnType": "array",
            "sourceCode": "const raw = $context.$variables.chatSummary;\n\nlet feedbackReceived = $context.$system.$inputMessage;\nlet feedBackArr = (raw && raw !== 'null') ? (Array.isArray(raw) ? raw : [raw]) : [];\n\nif (feedbackReceived != null && feedbackReceived !== 'null') {\n  feedBackArr = [...feedBackArr, feedbackReceived];\n}\n\nreturn feedBackArr;"
          },
