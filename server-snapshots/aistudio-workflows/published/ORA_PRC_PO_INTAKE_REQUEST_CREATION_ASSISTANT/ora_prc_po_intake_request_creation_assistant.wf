        {
          "metadata": {
            "name": "Error Message Creation",
            "returnType": "string",
            "sourceCode": "const errorNodeName = $context.$variables.errorNodeName;\nconst intakeRequestNumber = $context.$variables.intakeRequestNumber;\n\nconst preCreateNodes = [\n  \"FETCH_ALL_TEMPLATE_INFORMATION\",\n  \"FETCH_SUGGESTED_TEMPLATE_ATTRIBUTES\",\n  \"FETCH_REQUIRED_TEMPLATE_ATTRIBUTES\",\n  \"CREATE_IR_POST_CALL\",\n];\n\nconst postCreateNodes = [\n  \"INTAKE_REQUEST_CURRENCY_CODE_PATCH\",\n  \"IR_LINES_GET_CALL\",\n  \"IR_LINES_INFO_PATCH_CALL\",\n];\n\nconst buildMessage = (nodeName, created) => {\n  if (created) {\n    return (\n      \"Processing error encountered in workflow node \" +\n      nodeName +\n      \". Intake Request \" +\n      intakeRequestNumber +\n      \" was created, but may be incomplete. Please open the request in the application and update it with the missing information.\"\n    );\n  }\n\n  return (\n    \"Processing error encountered in workflow node \" +\n    nodeName +\n    \". Intake Request was not created. Please close the chat session and try again. If the issue persists, please contact the Procurement Administrator.\"\n  );\n};\n\nif (preCreateNodes.includes(errorNodeName)) {\n  return buildMessage(errorNodeName, false);\n}\n\nif (postCreateNodes.includes(errorNodeName)) {\n  return buildMessage(errorNodeName, true);\n}\n\nreturn \"\";"
          },
          "outcomes": {
            "success": "1776190387025"
          },
          "code": "ERROR_MESSAGE_CREATION",
          "id": "1776190218322",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
