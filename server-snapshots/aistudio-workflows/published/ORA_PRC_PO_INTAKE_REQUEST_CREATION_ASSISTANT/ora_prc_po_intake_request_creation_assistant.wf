        {
          "metadata": {
            "errorNodeId": "1776187794575",
            "name": "Final Edit Page Hyperlink Creation",
            "returnType": "object",
            "sourceCode": "const intakeRequestNumber = $context.$variables.intakeRequestNumber;\nconst intakeRequestUrl = $context.$variables.redirectDeeplink;\n\nconst esc = (s) =>\n  String(s ?? \"\")\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n\n// Ensure URL is a plain string (some nodes return objects)\nconst url = typeof intakeRequestUrl === \"string\"\n  ? intakeRequestUrl\n  : (intakeRequestUrl && (intakeRequestUrl.url || intakeRequestUrl.href || intakeRequestUrl.link)) || \"\";\n\nconst html = `\n<div style=\"font-family:Arial, sans-serif; max-width:820px; width:100%; box-sizing:border-box; border:1px border-radius:10px; overflow:hidden;\"><br>\n  <h10>\n    Thanks!! Your Intake Request is generated with Intake Request Number -\n    <a href=\"${esc(url)}\" style=\"color:#0b5fff;\">\n      ${esc(intakeRequestNumber)}\n    </a>\n  </h10><br>\n <h9>If you want to create another request, go ahead and tell me what you need, or you can close and exit this chat session.</h9>\n</div>\n`.trim();\n\nreturn html;"
          },
          "outcomes": {
            "success": "1773828573952"
          },
          "code": "FINAL_EDIT_PAGE_HYPERLINK_CREATION",
          "id": "1773824809514",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
