        {
          "metadata": {
            "name": "Final Intake Request HTML Attribute Creation",
            "returnType": "object",
            "sourceCode": "const inputJSON = $context.$variables.extractedUserRequirementJSON;\n\nconst outputJSON = {\n  \"Amount\": inputJSON.totalEstimatedCost != null ? String(inputJSON.totalEstimatedCost) : \"\",\n  \"Currency\": \"USD\",\n  \"Description of products and services requested\": String(inputJSON.itemServiceRequired) || \"\",\n  \"Item Type\": inputJSON.itemType || \"\",\n  \"Justification\": inputJSON.justification || \"\",\n  \"Price\": inputJSON.unitPrice != null ? String(inputJSON.unitPrice) : \"\",\n  \"Quantity\": inputJSON.quantity != null ? String(inputJSON.quantity) : \"\",\n  \"RequestTitle\": inputJSON.requestTitle || \"\",\n  \"Requested date\": inputJSON.needByDate || \"\",\n  \"UOM\": inputJSON.uomCode || \"\"\n};\n\nreturn outputJSON;"
          },
          "outcomes": {
            "success": "1773822728475"
          },
