          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "IR Creation POST Payload Assignment"
          },
          "outcomes": {
            "success": "1773822921292"
          },
          "code": "IR_CREATION_POST_PAYLOAD_ASSIGNMENT",
          "convergenceTargetId": "1773822921292",
          "id": "1773822728475",
          "inputs": [
            {
              "id": "1774669996075",
              "name": "inFeedbackLoop",
              "scope": "JOB",
              "type": "boolean",
              "value": "false"
            },
            {
              "id": "1773822778153",
              "name": "aiGeneratedIntakeRequestTitle",
              "scope": "JOB",
              "type": "string",
              "value": "{{$context.$variables.extractedUserRequirementJSON.requestTitle}}"
            },
            {
              "id": "1773822754142",
              "name": "irAiGeneratedSummary",
              "scope": "JOB",
              "type": "string",
              "value": "{{$context.$variables.extractedUserRequirementJSON.itemServiceRequired}}"
            },
            {
              "id": "1773822735564",
              "name": "finalHtmlRenderJSON",
              "scope": "JOB",
              "type": "object",
              "value": "{{$context.$nodes.FINAL_INTAKE_REQUEST_HTML_ATTRIBUTE_CREATION.$output.result}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "errorNodeId": "1776244416000",
            "name": "Final Intake Request Summary HTML Creation",
            "returnType": "object",
            "sourceCode": "// 1) Read from JSON object variable named `Results`\nconst Results = $context.$variables.finalHtmlRenderJSON ?? {};\nconst templateName = $context.$variables.aiSuggestedTemplateName ?? \"\";\nconst companyPolicy = $context.$variables.allAdditionalTemplateInformation ?? \"\";\nconst requestTypeTitle = $context.$variables.extractedUserRequirementJSON.itemType ?? \"\";\nconst requiredTemplateAttributes = $context.$variables.requiredTemplateAttributesForHtmlRender ?? \"\";\nconst enabledTemplateAttributes = $context.$variables.templateAttributesForHtmlRender ?? \"\";\nconst currencySymbol = $context.$variables.displayCurrencySymbol ?? \"\";\nconst currencyCode = $context.$variables.displayCurrencyCode ?? \"\";\nconst uomCode = $context.$variables.extractedUserRequirementJSON.uomCode ?? \"\";\n\n// 2) Helpers\nconst esc = (s) =>\n  String(s ?? \"\")\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n\nconst normalizeValue = (value) => {\n  const v = String(value ?? \"\").trim();\n  return !v || v.toUpperCase() === \"NA\" ? \"Not provided\" : v;\n};\n\nconst normalizeLabel = (label) => {\n  if (label === \"RequestTitle\") return \"Request Title\";\n  if (label === \"Requested date\") return \"Requested Delivery Date\";\n  return label;\n};\n\n// ---- REQUIRED FIELDS HANDLING ----\nconst requiredAttrsArray = Array.isArray(requiredTemplateAttributes)\n  ? requiredTemplateAttributes\n  : (() => {\n      try {\n        return JSON.parse(requiredTemplateAttributes || \"[]\");\n      } catch (e) {\n        return [];\n      }\n    })();\n\nconst requiredLabelSet = new Set(\n  requiredAttrsArray.map((l) => normalizeLabel(String(l ?? \"\").trim()))\n);\n\n// helper to prepend currency symbol\nconst addCurrency = (value) => {\n  const v = String(value ?? \"\").trim();\n  return v && v.toUpperCase() !== \"NA\" ? `${currencySymbol}${v}` : v;\n};\n\n// single-row helper\nconst row = (label, value, valueStyle = \"\") => {\n  const isRequired = requiredLabelSet.has(label);\n\n  let finalValue = value;\n\n  // Apply currency symbol to Amount\n  if (label === \"Amount\") {\n    finalValue = addCurrency(value);\n  }\n\n  return `\n  <div style=\"padding:10px 0; border-top:1px solid #f3f4f6;\">\n    <div style=\"color:#6b7280; font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.04em; margin-bottom:4px;\">\n      ${esc(label)}${isRequired ? ' <span style=\"color:#C74634;\">*</span>' : \"\"}\n    </div>\n    <div style=\"color:#111827; font-size:13px; line-height:1.35; overflow-wrap:anywhere; word-break:break-word; ${valueStyle}\">\n      ${esc(normalizeValue(finalValue))}\n    </div>\n  </div>\n`;\n};\n\n// two-column row helper (Price + Currency / Quantity + UOM)\nconst rowTwoCol = (\n  leftLabel,\n  leftValue,\n  rightLabel,\n  rightValue,\n  leftValueStyle = \"\",\n  rightValueStyle = \"\"\n) => {\n  const leftReq = requiredLabelSet.has(leftLabel);\n  const rightReq = requiredLabelSet.has(rightLabel);\n\n  return `\n  <div style=\"padding:10px 0; border-top:1px solid #f3f4f6;\">\n    <table style=\"width:100%; border-collapse:collapse; table-layout:fixed;\">\n      <tr>\n        <td style=\"width:50%; padding-right:8px; vertical-align:top;\">\n          <div style=\"color:#6b7280; font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.04em; margin-bottom:4px;\">\n            ${esc(leftLabel)}${leftReq ? ' <span style=\"color:#C74634;\">*</span>' : \"\"}\n          </div>\n          <div style=\"color:#111827; font-size:13px; line-height:1.35; overflow-wrap:anywhere; word-break:break-word; ${leftValueStyle}\">\n            ${esc(normalizeValue(leftValue))}\n          </div>\n        </td>\n        <td style=\"width:50%; padding-left:8px; vertical-align:top;\">\n          <div style=\"color:#6b7280; font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.04em; margin-bottom:4px;\">\n            ${esc(rightLabel)}${rightReq ? ' <span style=\"color:#C74634;\">*</span>' : \"\"}\n          </div>\n          <div style=\"color:#111827; font-size:13px; line-height:1.35; overflow-wrap:anywhere; word-break:break-word; ${rightValueStyle}\">\n            ${esc(normalizeValue(rightValue))}\n          </div>\n        </td>\n      </tr>\n    </table>\n  </div>\n`;\n};\n\n// 3) Build HTML\nconst ORACLE_RED = \"#325257\";\nconst ORACLE_RED_DARK = \"#325257\";\n\n// Original orderedLabels array\nlet orderedLabels = $context.$nodes.EXTRACT_ORDERED_LABELS.$output.result;\n\n// normalize entries\nconst normalizedEntries = Object.entries(Results).map(([label, value]) => [\n  normalizeLabel(label),\n  value,\n]);\nconst normalizedMap = new Map(normalizedEntries);\n\n// ---- orderedLabels membership checks (gate for two-col rendering) ----\nconst orderedLabelsSet = new Set(orderedLabels);\n\n// Quantity: show only if \"Quantity\" is in orderedLabels\n// UOM: show only if \"Quantity\" is in orderedLabels (piggybacks on Quantity's presence)\nconst showQuantity = orderedLabelsSet.has(\"Quantity\");\nconst showUOM = orderedLabelsSet.has(\"Quantity\"); // UOM follows Quantity's gate\n\n// Price: show only if \"Price\" is in orderedLabels\n// Currency: show only if \"Currency\" is in orderedLabels\nconst showPrice = orderedLabels.includes(\"Price\");\nconst showCurrency = showPrice || orderedLabels.includes(\"Currency\");\n\n// Resolve actual data presence (value must also exist in Results)\nconst hasQuantity = showQuantity && normalizedMap.has(\"Quantity\");\nconst hasUOM = showUOM && normalizedMap.has(\"UOM\");\nconst hasPrice = showPrice && normalizedMap.has(\"Price\");\nconst hasCurrency = showCurrency && normalizedMap.has(\"Currency\");\n\n// Labels rendered inline (not as standalone rows)\nconst twoColSkip = new Set();\nif (showQuantity || showUOM) { twoColSkip.add(\"Quantity\"); twoColSkip.add(\"UOM\"); }\nif (showPrice || showCurrency) { twoColSkip.add(\"Price\"); twoColSkip.add(\"Currency\"); }\n\n// Build Price+Currency html — only when at least one side is gated-in and has data\nconst priceCurrencyHtml = (showPrice || showCurrency)\n  ? rowTwoCol(\n      \"Price\",\n      hasPrice ? addCurrency(normalizedMap.get(\"Price\")) : \" \",\n      \"Currency\",\n      hasCurrency ? normalizedMap.get(\"Currency\") : \" \"\n    )\n  : \"\";\n\n// Build Quantity+UOM html — only when at least one side is gated-in and has data\nconst quantityUOMHtml = (showQuantity || showUOM)\n  ? rowTwoCol(\n      \"Quantity\",\n      hasQuantity ? normalizedMap.get(\"Quantity\") : \" \",\n      \"UOM\",\n      hasUOM ? normalizedMap.get(\"UOM\") : \" \"\n    )\n  : \"\";\n\n// Anchor labels that two-column pairs are inserted after\nconst qtyAnchor = \"Requested Delivery Date\"; // Quantity+UOM inserted after this\nconst priceAnchor = \"Requested Delivery Date\"; // Price+Currency also inserted after this (same as before)\n\n// Build ordered rows, injecting two-col blocks at their anchor positions\nconst buildBaseRows = () => {\n  const result = [];\n  // Track which two-col blocks have been injected\n  let qtyUOMInjected = false;\n  let priceCurrencyInjected = false;\n\n  for (const label of orderedLabels) {\n    if (twoColSkip.has(label)) continue; // skip; rendered via two-col\n    if (!normalizedMap.has(label)) continue;\n\n    result.push(row(label, normalizedMap.get(label)));\n\n    // After the anchor, inject both two-col rows (if applicable)\n    if (label === qtyAnchor) {\n      if (quantityUOMHtml && !qtyUOMInjected) {\n        result.push(quantityUOMHtml);\n        qtyUOMInjected = true;\n      }\n      if (priceCurrencyHtml && !priceCurrencyInjected) {\n        result.push(priceCurrencyHtml);\n        priceCurrencyInjected = true;\n      }\n    }\n  }\n\n  // Append any uninjected two-col rows at the end\n  if (quantityUOMHtml && !qtyUOMInjected) result.push(quantityUOMHtml);\n  if (priceCurrencyHtml && !priceCurrencyInjected) result.push(priceCurrencyHtml);\n\n  return result.join(\"\");\n};\n\nconst baseRowsHtml = buildBaseRows();\n\n// final HTML\nconst html = `<br>\n<div style=\"font-family:Arial, sans-serif; max-width:820px; width:100%; box-sizing:border-box; border:1px solid #fbf9f8; border-radius:10px; overflow:hidden; background:#fff;\">\n  <div style=\"padding:12px 14px; background:${ORACLE_RED}; color:#fff;\">\n    <div style=\"font-size:14px; font-weight:800; margin:0; color:#fff;\">${esc(templateName)}</div>\n  </div>\n  <div style=\"padding:12px 14px; box-sizing:border-box;\">\n    ${baseRowsHtml}\n  </div>\n  <div style=\"height:6px; background:linear-gradient(90deg, ${ORACLE_RED} 0%, ${ORACLE_RED_DARK} 100%);\"></div>\n</div>\n<br>\n<div class=\"sow-notice\">\n  <p>I've identified the template that applies to your request, and filled in the information required based on what you have provided so far. If you want to change anything, please select the Request Change option and make the necessary updates, else select Approve to proceed with intake request creation.</p><br>\n<p><strong>You must select either Approve or Request Change.</p>\n  <br>\n</div>\n<style>\n  .sow-option { font-size: 0.9em; font-weight: 630; }\n  .sow-font { font-size: 0.9em; }\n</style>\n`.trim();\n\n// 4) Return\nreturn html;"
          },
          "outcomes": {
            "success": "1774693623300"
          },
          "code": "FINAL_INTAKE_REQUEST_SUMMARY_HTML_CREATION",
          "convergenceTargetId": "1774692493390",
          "id": "1773822921292",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
