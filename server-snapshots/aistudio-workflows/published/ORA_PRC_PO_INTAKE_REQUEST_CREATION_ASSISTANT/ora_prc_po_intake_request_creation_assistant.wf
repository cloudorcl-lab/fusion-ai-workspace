        {
          "metadata": {
            "errorNodeId": "1776244416000",
            "name": "Template Required Attributes List Construction",
            "returnType": "array",
            "sourceCode": "const attrArray = $context.$variables.aiSuggestedTemplateRequiredAttributes;\n\nlet output = [];\nattrArray.map(item => output.push(item[\"UILabel\"]));\n\nreturn output;"
          },
          "outcomes": {
            "success": "1773822268413"
          },
          "code": "TEMPLATE_REQUIRED_ATTRIBUTES_LIST_CONSTRUCTION",
          "convergenceTargetId": "1774251838223",
          "id": "1774251887047",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1776244416000",
            "name": "Currency Code Assignment",
            "returnType": "string",
            "sourceCode": "// Input: items array\nconst items = $context.$variables.aiSuggestedTemplateDisplayAttributes;\n\n// Find the Currency item\nconst currencyItem = items.find(item => item.UILabel === \"Currency\");\n\n// Store values in separate variables\nlet currencyDefaultValue = currencyItem?.DefaultValue ?? null;\nlet currencyDefaultValueDisplay = currencyItem?.DefaultValueDisplay ?? null;\n\n// Fallback if DefaultValue is empty or null\nif (currencyDefaultValue === \"\" || currencyDefaultValue == null) {\n  currencyDefaultValue = \"USD\";\n}\n\nreturn currencyDefaultValue;"
          },
          "outcomes": {
            "success": "1773822268413"
          },
          "code": "CURRENCY_CODE_ASSIGNMENT",
          "id": "1774871568163",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1776244416000",
            "name": "Currency Symbol Assignment",
            "returnType": "string",
            "sourceCode": "const items = $context.$variables.aiSuggestedTemplateDisplayAttributes ?? [];\n\n// Find the Currency item\nconst currencyItem = items.find(item => item?.UILabel === \"Currency\");\n\n// Extract value\nconst currencyDefaultValue = currencyItem?.DefaultValue ?? null;\n\n// Currency list\nconst currencySymbols = $context.$variables.allCurrencyList ?? {};\n\n// Lookup symbol\nconst currencySymbol = currencySymbols[currencyDefaultValue] ?? null;\n\n// Default to \"$\" if null/undefined\nreturn currencySymbol ?? \"$\";"
          },
          "outcomes": {
            "success": "1773822268413"
          },
          "code": "CURRENCY_SYMBOL_ASSIGNMENT",
          "id": "1774871858033",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1776244416000",
            "name": "Extract Ordered Labels",
            "returnType": "array",
            "sourceCode": "const attrArray = $context.$variables.aiSuggestedTemplateDisplayAttributes;\n\nlet output = [];\nattrArray.map(item => output.push(item[\"UILabel\"]));\n\nconst enabledTemplateAttributes = output ?? \"\";\n//enabledTemplateAttributes = [\"Amount\",\"Currency\",\"Description of products and services requested\",\"Item Type\",\"Justification\",\"Requested date\"]\n\n// Original orderedLabels array\nlet orderedLabels = [\n  \"Request Title\",\n  \"Description of products and services requested\",\n  \"Justification\",\n  \"Requested Delivery Date\",\n  \"Quantity\",\n  \"Amount\",\n  \"UOM\",\n  \"Price\",\n  \"Currency\"\n];\n\n// Normalize a label for comparison: lowercase + treat date variants as equal\nconst normalizeLabel = (label) => {\n  const lower = label.toLowerCase().trim();\n  if (lower === \"requested date\") return \"requested delivery date\";\n  return lower;\n};\n\n// Pre-normalize the enabled attributes (excluding \"Request Title\")\nconst normalizedEnabled = enabledTemplateAttributes\n  .filter(attr => attr.toLowerCase().trim() !== \"request title\")\n  .map(normalizeLabel);\n\n// Filter orderedLabels based on normalizedEnabled, skipping \"Request Title\" check\norderedLabels = orderedLabels.filter(label => {\n  if (label === \"Request Title\" || label === \"Description of products and services requested\") return true; // Always include Request Title (change 1)\n  return normalizedEnabled.includes(normalizeLabel(label));\n});\n\nreturn orderedLabels;"
          },
          "outcomes": {
            "success": "1773822268413"
          },
          "code": "EXTRACT_ORDERED_LABELS",
          "id": "1774888297620",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
