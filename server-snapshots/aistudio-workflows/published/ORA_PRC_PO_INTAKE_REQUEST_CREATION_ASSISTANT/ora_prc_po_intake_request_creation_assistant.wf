            "sourceCode": "const statuses = [\n  $context.$nodes.FETCH_ALL_TEMPLATE_INFORMATION.$status,\n  $context.$nodes.FETCH_SUGGESTED_TEMPLATE_ATTRIBUTES.$status,\n  $context.$nodes.FETCH_REQUIRED_TEMPLATE_ATTRIBUTES.$status,\n  $context.$nodes.CREATE_IR_POST_CALL.$status,\n  $context.$nodes.INTAKE_REQUEST_CURRENCY_CODE_PATCH.$status,\n  $context.$nodes.IR_LINES_GET_CALL.$status,\n  $context.$nodes.IR_LINES_INFO_PATCH_CALL.$status,\n];\n\nreturn statuses.some(status => status === \"failure\");"
