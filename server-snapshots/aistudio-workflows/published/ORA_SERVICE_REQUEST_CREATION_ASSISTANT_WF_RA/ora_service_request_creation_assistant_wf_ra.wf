  "name": "Service Request Creation Assistant",
  "description": "Service Request Creation Assistant manages the complete process of creating a service request, ensuring the information is accurate, enhancing it with relevant details, and preparing it for subsequent processing.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
