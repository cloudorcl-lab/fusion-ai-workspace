        {
          "metadata": {
            "name": "Cleanup the Additional Fields",
            "returnType": "object",
            "sourceCode": "let additionalFields = $context.$triggers.REST.$input.AdditionalFields;\n\n// Clean empty, null\nadditionalFields = Object.fromEntries(\n    Object.entries(additionalFields).filter(([key, value]) => {\n      if (value == null || value === \"\") return false;\n      if (Array.isArray(value)) return value.length > 0;\n      if (typeof value === \"object\") return Object.keys(value).length > 0;\n      return true;\n    })\n  );\n\n//Remove fields which no allowed on create\nlet fieldsToRemove = [\"Title\",\"ProblemDescription\",\"SeverityCd\",\"CriticalFlag\",\"CreationDate\",\"SrLastUpdatedByPartyName\",\"HeaderFlag\",\"LastUpdatedBy\",\"ReportedByEmailAddress\",\"CreatedBy\",\"ReportedByPartyName\",\"ReportedByPartyUniqueName\",\"DeleteFlag\",\"AssigneeEmailAddress\",\"LastUpdatedByEmailAddress\",\"AccountPartyName\",\"AccountPartyEmailAddress\",\"MilestoneConfigId\",\"ComplianceFlag\",\"WarnedFlag\",\"LastUpdateLogin\",\"SeverityRank\",\"SrMilestoneId\",\"UpdateFlag\",\"AssigneePartyId\",\"DueDate\",\"BusinessUnitName\",\"SrId\",\"MilestoneStatusCd\",\"MilestoneLabel\",\"StatusTypeCd\",\"LastUpdateDate\",\"LastUpdatedByPartyNumber\",\"LastUpdatedByDisplayName\",\"SeverityColorCd\",\"StatusCdMeaning\",\"StatusTypeCdMeaning\",\"SeverityCdMeaning\",\"TimeRemaining\",\"SrNumber\",\"LastResolvedDate\",\"ClosedDate\",\"AccountPartyPreferredContactMethod\",\"PrimaryContactEmailAddress\",\"PrimaryContactPreferredContactMethod\",\"PrimaryContactDoNotContactFlag\",\"ServiceZoneName\",\"ReportedByPartyUniqueName\",\"ReportedByPartyName\",\"ReportedByEmailAddress\",\"ProductItemOrgId\",\"AssetSerialNumber\",\"CategoryName\",\"RecordSet\",\"NetworkTypeCd\",\"IBAssetSerialNumber\",\"IBAssetDescription\",\"IBAssetLocationType\",\"IBAssetNumber\",\"SurveySentDate\",\"SurveyResponseDate\",\"ServiceProfileName\",\"ServiceProfilePartySiteNumber\",\"ServiceProfilePartySiteName\",\"ServiceProfilePartySiteId\",\"ServiceProfilePartySiteLocationId\",\"BillToCustomerName\",\"BillToCustomerAccountDescription\",\"BillToPartySiteName\",\"BillToPartySiteLocationId\",\"AssigneeTimezone\",\"AssigneeFormattedPhoneNumber\",\"AssigneeFormattedAddress\",\"AccountPartyFormattedPhoneNumber\",\"PrimaryContactFormattedPhoneNumber\",\"PrimaryContactFormattedAddress\",\"ReportedByFormattedPhoneNumber\",\"ResolveOutcomeCdMeaning\",\"ChannelTypeCdMeaning\",\"ResolutionCdMeaning\",\"AffectedPartyPersonName\"];\n\n\nfieldsToRemove.forEach(eachF => {\n  delete additionalFields[eachF];\n});\n\nreturn additionalFields;"
          },
          "outcomes": {
            "success": "1776045451625"
          },
          "code": "CLEANUP_THE_ADDITIONAL_FIELDS",
          "id": "1776044072209",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
