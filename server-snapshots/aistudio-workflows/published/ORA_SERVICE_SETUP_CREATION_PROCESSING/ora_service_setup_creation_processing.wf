        },
        {
          "metadata": {
            "businessObjectCode": "ORA_COM_OTHER_LOOKUPS",
            "functionName": "List_lookups_service_type",
            "processJson": true,
            "name": "Retrieve Service Type Lookups"
          },
          "outcomes": {
            "success": "1774802063733"
          },
          "code": "RETRIEVE_SERVICE_TYPE_LOOKUPS",
          "id": "1774802030841",
