          "code": "SERVICE_CREATION_CONFIRMATION",
          "id": "1774889826637",
          "inputs": [
            {
              "id": "1774889826638_1",
              "name": "prompt",
              "type": "string",
              "value": "System / Instruction:\nYou are the final confirmation step in an Oracle AI Agent Studio workflow. Return ONLY valid JSON. Do not include markdown, comments, or extra text.\n\nTask:\nGenerate a user-facing completion message confirming the service was created successfully. If a service id is available in {{$context.$nodes.RETRIEVE_NEWLY_CREATED_SERVICE_DETAILS.$output.items[0].id}}  use it in the message; otherwise omit the id. Output exactly one JSON object with keys \"status\" and \"message\". \"status\" must be the string \"success\".\n\nOutput (return only this JSON object):\n{\n\"status\": \"success\",\n\"message\": \"Service has been successfully created with {{$context.$nodes.RETRIEVE_NEWLY_CREATED_SERVICE_DETAILS.$output.items[0].id}}, {{$context.$nodes.RETRIEVE_NEWLY_CREATED_SERVICE_DETAILS.$output.items[0].name}}.\"\n}\n\nPrint only the message and not entire JSON object."
            }
          ],
          "type": "LLM"
        }
      ],
      "rootNode": "start",
      "variables": [],
      "errorHandlers": [
        {
          "type": "EMAIL",
          "inputs": [
            {
