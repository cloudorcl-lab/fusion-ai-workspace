        },
        {
          "metadata": {
            "businessObjectCode": "ORA_COM_OTHER_SERVICES",
            "functionName": "List_services_by_name",
            "processJson": true,
            "name": "Retrieve Newly Created Service Details"
          },
          "outcomes": {
            "success": "1774889501181"
          },
          "code": "RETRIEVE_NEWLY_CREATED_SERVICE_DETAILS",
          "id": "1774888541955",
          "inputs": [
            {
              "id": "1774888561704_1",
              "name": "name",
              "type": "string",
              "value": "{{$context.$nodes.VALIDATE_SERVICE_CREATION_PAYLOAD.$output.name}}"
            }
          ],
          "outputSpecification": "{}",
