        },
        {
          "metadata": {
            "name": "Request Service Creation Document Upload"
          },
          "outcomes": {
            "success": "1774801725115"
          },
          "code": "REQUEST_SERVICE_CREATION_DOCUMENT_UPLOAD",
          "id": "1774801696233",
          "inputs": [
            {
              "id": "1774801696235_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a workflow gating step in Oracle AI Agent Studio. Return ONLY valid JSON. No markdown, no commentary.\n\nTask:\nDecide whether the workflow should proceed based on:\n\nThe latest user message text.\nWhether at least one file is attached/uploaded in the conversation, as evidenced by the output of the \"Process Uploaded Documents\" step.\nInputs:\nlatestUserMessage = {{$context.$system.$inputMessage}}\nprocessedDocuments = {{$context.$nodes.PROCESS_UPLOADED_DOCUMENTS.$output}}\n\nRules:\n\nProceed ONLY if latestUserMessage equals \"Uploaded\" case-insensitively (ignore leading/trailing whitespace) AND there is at least one uploaded file/document in processedDocuments.\nIf either condition fails, do not proceed.\nReturn this JSON shape exactly:\n{\n\"proceed\": <true|false>,\n\"failureReason\": <string or null>,\n\"userMessageToShow\": <string>\n}\n\nuserMessageToShow rules:\n\nIf proceed=true: set to \"Thanks—processing your document now.\"\nIf proceed=false: instruct the user to upload at least one file and then type \"Uploaded\".\nReturn only the JSON object."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Decide Proceed Service Creation"
          },
          "outcomes": {
            "success": "1774801754045"
          },
          "code": "DECIDE_PROCEED_SERVICE_CREATION",
          "id": "1774801725115",
          "inputs": [
            {
              "id": "1774801725117_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a decision step in an Oracle AI Agent Studio workflow. Return ONLY valid JSON. No markdown, no commentary.\n\nInput:\nproceed = {{$context.$nodes.REQUEST_SERVICE_CREATION_DOCUMENT_UPLOAD.$output.proceed}}\n\nTask:\nNormalize the value of proceed and decide whether the workflow should continue.\n\nRules:\n\nIf proceed is the boolean true, or the string \"true\" (any casing, may contain leading/trailing spaces), then treat it as true.\nOtherwise treat it as false.\nReturn exactly this JSON shape:\n{\n\"proceed\": <true|false>\n}\n\nReturn only the JSON object."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Document Uploaded With Right Message"
          },
          "outcomes": {
            "true": "1774801896772",
            "false": "1774801833438"
          },
          "code": "DOCUMENT_UPLOADED_WITH_RIGHT_MESSAGE",
          "convergenceTargetId": "end",
          "id": "1774801754045",
          "inputs": [
            {
              "id": "1774801754047_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.DECIDE_PROCEED_SERVICE_CREATION.$output.proceed}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "No Document Uploaded Or Wrong Message"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "NO_DOCUMENT_UPLOADED_OR_WRONG_MESSAGE",
          "id": "1774801833438",
          "inputs": [
            {
              "id": "1774801833440_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a user-facing messaging step in an Oracle AI Agent Studio workflow. Your job is to display a single message to the user based on two upstream values. Return ONLY the message text to show in chat (no JSON, no markdown, no extra commentary).\n\nInputs:\nproceedFlag = {{$context.$nodes.REQUEST_SERVICE_CREATION_DOCUMENT_UPLOAD.$output.proceed}}\nfailureReason = {{$context.$nodes.REQUEST_SERVICE_CREATION_DOCUMENT_UPLOAD.$output.failureReason}}\nuserMessageToShow = {{$context.$nodes.REQUEST_SERVICE_CREATION_DOCUMENT_UPLOAD.$output.userMessageToShow}}\n\nRules:\n\nIf userMessageToShow is not null/empty, output userMessageToShow exactly.\nOtherwise, if failureReason is not null/empty, output: \"Unable to proceed: <failureReason>. Please upload the document (PDF/image) and then type 'Uploaded'.\"\nOtherwise output: \"Please upload the document (PDF/image) and then type 'Uploaded'.\"\nOutput only the final message text along with the value of proceedFlag."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
