          "inputs": [
            {
              "id": "1772108372479",
              "name": "DateInterpretationRules",
              "scope": "JOB",
              "type": "string",
              "value": "DATE INTERPRETATION RULES\n\n1. Input Interpretation:\n\n- Basic Rules\n    - Missing year : Use current year\n    - Date ranges : Interpret as same year unless spanning months like \"Dec to Jan\"\n\n- Relative Timeframes\n  Translate natural language periods into exact date ranges using sample date 2026-04-12 as an example:\n    - This year : 2026-01-01 to 2026-12-31\n    - Last year : 2025-01-01 to 2025-12-31\n    - Last X years : The X full calendar years prior to the current year\n        - Example :\n            -  \"Last 5 years\" : 2020-01-01 to 2025-12-31\n            -  \"Last 3 years\" : 2022-01-01 to 2025-12-31\n    - Next year : 2026-01-01 to 2026-12-31\n    - This month : 2026-04-01 to 2026-04-30\n    - Last month : 2026-03-01 to 2026-03-31\n    - Last X months : The X full calendar months before the current month\n        - Example:\n            -  \"Last 2 months\" : 2026-02-01 to 2026-03-31\n            -  \"Last 4 months\" : 2025-12-01 to 2026-03-31\n    - Last week : The full calendar week before the current week.\n        - Example:\n            - Week starting 2026-03-31 to 2026-04-06\n    - Last X weeks : X full calendar weeks before the current week\n        - Example:\n            -  \"Last 3 weeks\" : 2026-03-17 to 2026-04-06\n    - Past week : The last 7 days, including today : 2026-04-06 to 2026-04-12\n    - Past X days/weeks/months : Count backward from today\n        - Example:\n            -   \"Past 2 months\" : 2026-02-12 to 2026-04-12\n            -   \"Past 4 months\" : 2025-12-12 to 2026-04-12\n            -   \"Past 3 weeks\" : 2026-03-22 to 2026-04-12\n            -   \"Past 10 days\" : 2026-04-02 to 2026-04-12\n    - Past Year (rolling 12-month window) : 2025-04-12 to 2026-04-12"
            },
            {
              "id": "1765653786448",
              "name": "communicationDetails",
              "scope": "JOB",
              "type": "object",
              "value": "{\n  \"Communications\": [\n  {\n      \"commCode\": \"sendNewHiresIntroductionEmail\",\n      \"commType\": \"email\",\n      \"commTitle\": \"New Hires Introduction\",\n      \"commActionText\": \"Send email\",\n      \"commDescription\": \"Send email to the team for the new hires joined in team\",\n      \"commContent\": \"Introduction details of new hires along with their name, job, location to all team members. Generate the content using rich text with HTML markers.\",\n      \"commParams\": [\n        {\"toAddress\": \"\"},\n        {\"subject\": \"New Hires Introduction!!!\"}\n      ]\n    }\n  ]\n}"
            },
            {
              "id": "1763893166787",
              "name": "actionDetails",
              "type": "object",
              "value": "{\n  \"Actions\": [\n   \n    ]\n}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "PrepareVariableValues",
            "returnType": "object",
            "sourceCode": "const userPrompt = $context.$system.$inputMessage;\nconst hint = $context.$app.$OraMessageHint;\nconst strAction = $context.$app.$OraAction;\nconst actionDetails = $context.$variables.actionDetails; \nconst action = $context.$app.$OraAction;\nconst panel = $context.$app.$OraPanelName;\n\n\nlet userMessageHint = \"QUERY\";\nlet addPrompt = '';\nlet newPrompt = userPrompt;\nvar actionCode='' ;\n\nif  (hint === 'InvokeAction')  {\nactionCode='' ;\n\nif (typeof strAction === 'object') {\n    actionCode = strAction.actionCode;  \n} else {\n  var idx = strAction.indexOf('actionCode');\n  if (idx !== -1) {\n  var colonIdx = strAction.indexOf(':', idx);\n  if (colonIdx !== -1) {\n    var quoteStart = strAction.indexOf('\"', colonIdx);\n    if (quoteStart !== -1) {\n      var quoteEnd = strAction.indexOf('\"', quoteStart + 1);\n      if (quoteEnd !== -1) {\n        actionCode = strAction.substring(quoteStart + 1, quoteEnd);\n      }\n    }\n  }\n}\n}\nactionCode = actionCode.replace(/\\\\+$/, '');\nnewPrompt = \"Action is not configured. Showing default response.\";\n\nif (actionCode && actionDetails && Array.isArray(actionDetails.Actions)) {\n  for (var i = 0; i < actionDetails.Actions.length; i++) {\n    if (actionDetails.Actions[i].actionCode === actionCode) {\n      newPrompt = actionDetails.Actions[i].actionPrompt;\n      break;\n    }\n  }\n }\n}\n\nif (hint === \"InitCommunications\") {\n  addPrompt = \"get team employment details along with start date and all the talent and compensation details of team\";\n} else if (hint === \"FillParameters\") {\n  addPrompt = \"get team employment details along with start date and all the talent and compensation details of team\";\n}\n  \nif (addPrompt !== '') \n  newPrompt = addPrompt; \n\n\n\nif ( hint === \"InitDisplay\" || hint === \"Summary\" ||  hint === \"InitActions\" || hint === \"InitSubtitle\" || hint ===  \"AdditionalContent\") {\n    userMessageHint = \"INIT\";\n} else if ( hint === \"InitCommunications\" || hint === \"FillParameters\" || hint === \"GenerateTemplateContent\" || hint === \"SendCommunication\") {\n    userMessageHint = \"COMM\";\n} else if (typeof action !== \"undefined\") {\n    if (action.includes(\"sendTeamIntroduction\") || action.includes(\"modelingStrategy\") || action.includes(\"modelingOption\") ) {\n        userMessageHint = \"ACTION\";\n    }\n} else {\n    userMessageHint = \"QUERY\";\n}\n\n\nlet flowPath = \"QUERY\";\n\nif ( hint === \"InitSubtitle\" ) {\n  flowPath = \"NOQUERY\";\n} \n\nlet result = {actionCode : actionCode, newPrompt: newPrompt, userMessageHint: userMessageHint, flowPath: flowPath}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1771853879426"
          },
