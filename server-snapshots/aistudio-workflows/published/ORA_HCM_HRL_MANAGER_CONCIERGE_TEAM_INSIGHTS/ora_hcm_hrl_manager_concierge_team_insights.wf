          "outcomes": {
            "success": "end"
          },
          "code": "SHOWINITSUMMARY",
          "id": "1764964809691",
          "inputs": [
            {
              "id": "1764964809693_1",
              "name": "prompt",
              "type": "string",
              "value": "**Inputs**  \n**User Request:**  `{{$context.$variables.userPrompt}}`\n- **Query Response:** `{{$context.$variables.responseDetails}}`  \n- **Inbound Context Details:** `{{$context.$variables.contextDetails}}`  \n\n---\n### **Task Requirements**\n\n1. Generate a concise summary of the Query Response aligning with available Inbound Context Details in **no more than 250 words**. \n- Do not include details regarding actionable insights or priority actions in the response.\n- Do not include `personId`, `assignmentId' in the response text."
            }
          ],
          "type": "LLM"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [],
              "enableActions": true,
              "enableCommunications": true
