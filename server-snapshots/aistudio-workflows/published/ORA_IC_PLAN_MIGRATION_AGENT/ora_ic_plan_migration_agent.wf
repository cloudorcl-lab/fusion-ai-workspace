        {
          "type": "WHILE",
          "id": "WHILE_SEARCH_RESULTS",
          "code": "WHILE_SEARCH_RESULTS",
          "outcomes": {
            "success": "FORMAT_SEARCH_OUTPUT"
          },
          "inputs": [
            {
              "id": "1770838789212105",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$variables.search_has_more}}"
            }
          ],
          "metadata": {
            "name": "While Search Results",
            "dataPipeline": {
              "rootNode": "start_WHILE_SEARCH_RESULTS",
              "pipelineNodes": [
                {
                  "type": "START",
                  "code": "START_WHILE_SEARCH_RESULTS",
                  "id": "start_WHILE_SEARCH_RESULTS",
                  "metadata": {
                    "name": "Start",
                    "description": "Start of while"
                  },
                  "outcomes": {
                    "success": "BO_FIND_WILDCARD_PAGE"
                  },
                  "inputs": []
                },
                {
                  "metadata": {
                    "businessObjectCode": "ORA_CX_INCENTIVEC_ICCOMPENSATIONPLANS",
                    "functionName": "findPlansWithOffset",
                    "processJson": true,
                    "name": "Keyword Search Page"
                  },
                  "outcomes": {
                    "success": "MERGE_SEARCH_RESULTS"
                  },
                  "code": "BO_FIND_WILDCARD_PAGE",
                  "id": "BO_FIND_WILDCARD_PAGE",
                  "inputs": [
                    {
                      "id": "1770838789212722",
                      "name": "q",
                      "type": "string",
                      "value": "{{$context.$nodes.BUILD_SEARCH_PARAMS.$output.result.sql_query}}"
                    },
                    {
                      "id": "1770838789212795",
                      "name": "offset",
                      "type": "number",
                      "value": "{{$context.$variables.search_offset}}"
                    }
                  ],
                  "outputSpecification": "{\"type\": \"object\", \"properties\": {\"items\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"CompensationPlanId\": {\"type\": \"string\"}, \"Name\": {\"type\": \"string\"}, \"OrgId\": {\"type\": \"string\"}, \"Description\": {\"type\": \"string\"}}}}, \"hasMore\": {\"type\": \"boolean\"}, \"count\": {\"type\": \"integer\"}}, \"required\": [\"items\"]}",
                  "type": "BO_FUNCTION"
                },
                {
                  "type": "CODE",
                  "id": "MERGE_SEARCH_RESULTS",
                  "code": "MERGE_SEARCH_RESULTS",
                  "outcomes": {
                    "success": "UPDATE_SEARCH_STATE"
                  },
                  "metadata": {
                    "name": "Merge Search Results",
                    "returnType": "object",
                    "sourceCode": "/**\n * Merge Search Results\n *\n * Accumulates paged BO results into a single array of plan objects.\n */\n\nvar existing = $context.$variables.search_results;\nif (!Array.isArray(existing)) {\n    existing = [];\n}\n\nvar boOutput = $context.$nodes.BO_FIND_WILDCARD_PAGE.$output;\nvar items = [];\nvar hasMore = false;\nvar count = 0;\n\nif (boOutput && boOutput.result && Array.isArray(boOutput.result.items)) {\n    items = boOutput.result.items;\n    hasMore = boOutput.result.hasMore === true || boOutput.result.hasMore === 'true';\n    count = boOutput.result.count || 0;\n} else if (boOutput && Array.isArray(boOutput.items)) {\n    items = boOutput.items;\n    hasMore = boOutput.hasMore === true || boOutput.hasMore === 'true';\n    count = boOutput.count || 0;\n} else if (Array.isArray(boOutput)) {\n    items = boOutput;\n    count = items.length;\n}\n\nvar combined = [];\nvar seen = new Object();\n\nfor (var i = 0; i < existing.length; i++) {\n    var plan = existing[i];\n    if (!plan || plan.CompensationPlanId === undefined || plan.CompensationPlanId === null) continue;\n    var planKey = String(plan.OrgId || '') + \"_\" + String(plan.CompensationPlanId);\n    if (!seen[planKey]) {\n        seen[planKey] = true;\n        combined.push(plan);\n    }\n}\n\nfor (var j = 0; j < items.length; j++) {\n    var item = items[j];\n    if (!item || item.CompensationPlanId === undefined || item.CompensationPlanId === null) continue;\n    var itemKey = String(item.OrgId || '') + \"_\" + String(item.CompensationPlanId);\n    if (!seen[itemKey]) {\n        seen[itemKey] = true;\n        combined.push(item);\n    }\n}\n\nvar currentOffset = Number($context.$variables.search_offset || 0);\n// Advance by page size, not reported count (count can be total).\nvar nextOffset = currentOffset + Number(items.length || 0);\n\nvar result = new Object();\nresult.results = combined;\nresult.nextOffset = nextOffset;\nresult.hasMore = hasMore;\nreturn result;\n"
                  },
                  "inputs": [],
                  "outputSpecification": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"result\": {\"type\": \"object\", \"properties\": {\"results\": {\"type\": \"array\", \"items\": {\"type\": \"object\"}}, \"nextOffset\": {\"type\": \"number\"}, \"hasMore\": {\"type\": \"boolean\"}}}}}"
                },
                {
                  "type": "SET_FIELDS",
                  "id": "UPDATE_SEARCH_STATE",
                  "code": "UPDATE_SEARCH_STATE",
                  "outcomes": {
                    "success": "end_WHILE_SEARCH_RESULTS"
                  },
                  "inputs": [
                    {
                      "id": "1770838789212322",
                      "name": "search_results",
                      "type": "array",
                      "value": "{{$context.$nodes.MERGE_SEARCH_RESULTS.$output.result.results}}"
                    },
                    {
                      "id": "1770838789212663",
                      "name": "search_offset",
                      "type": "integer",
                      "value": "{{$context.$nodes.MERGE_SEARCH_RESULTS.$output.result.nextOffset}}"
                    },
                    {
                      "id": "1770838789212997",
                      "name": "search_has_more",
                      "type": "boolean",
                      "value": "{{$context.$nodes.MERGE_SEARCH_RESULTS.$output.result.hasMore}}"
                    }
                  ],
                  "metadata": {
                    "name": "Update Search State"
                  }
                },
                {
                  "type": "END",
                  "code": "END_WHILE_SEARCH_RESULTS",
                  "id": "end_WHILE_SEARCH_RESULTS",
                  "metadata": {
                    "name": "End",
                    "description": "End of while"
                  },
                  "outcomes": {},
                  "inputs": []
                }
              ]
            },
            "position": {
              "x": 750,
              "y": 200
            }
          }
        },
        {
          "type": "CODE",
          "id": "FORMAT_SEARCH_OUTPUT",
          "code": "FORMAT_SEARCH_OUTPUT",
          "outcomes": {
            "success": "end"
          },
          "inputs": [],
          "metadata": {
            "name": "Format Search Output",
            "returnType": "object",
            "sourceCode": "/**\n * Format Search Output\n * Formats accumulated search results into wrapped response.\n */\n\nvar plans = $context.$variables.search_results;\nif (!Array.isArray(plans)) {\n    plans = [];\n}\n\n// Deduplicate using array of seen IDs\nvar seenIds = [];\nvar unique = [];\n\nfor (var i = 0; i < plans.length; i++) {\n    var plan = plans[i];\n    if (!plan || plan.CompensationPlanId === undefined || plan.CompensationPlanId === null) continue;\n\n    var key = String(plan.OrgId || '') + \"_\" + String(plan.CompensationPlanId);\n    var alreadySeen = false;\n    for (var j = 0; j < seenIds.length; j++) {\n        if (seenIds[j] === key) {\n            alreadySeen = true;\n            break;\n        }\n    }\n\n    if (!alreadySeen) {\n        seenIds.push(key);\n        var obj = new Object();\n        obj.Name = plan.Name;\n        obj.CompensationPlanId = plan.CompensationPlanId;\n        obj.OrgId = plan.OrgId;\n        unique.push(obj);\n    }\n}\n\nvar destination = null;\nif ($context.$nodes.PARSE_INTENT && $context.$nodes.PARSE_INTENT.$output) {\n    destination = $context.$nodes.PARSE_INTENT.$output.destination;\n}\n\nvar result = new Object();\nresult.plans = unique;\nresult.count = unique.length;\nresult.destination = destination === undefined ? null : destination;\nreturn result;\n",
            "position": {
              "x": 900,
              "y": 200
            }
          },
          "outputSpecification": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"plans\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"CompensationPlanId\": {\"type\": \"string\"}, \"Name\": {\"type\": \"string\"}, \"OrgId\": {\"type\": \"string\"}}}}, \"count\": {\"type\": \"number\"}, \"destination\": {\"type\": [\"string\", \"null\"]}}}"
        },
        {
          "type": "SET_FIELDS",
          "id": "SET_EXPLICIT_NAMES",
          "code": "SET_EXPLICIT_NAMES",
          "outcomes": {
            "success": "LOOP_NAMES"
          },
          "inputs": [
            {
              "id": "1770838789212983",
              "name": "plan_names",
              "type": "string",
              "value": "{{ $context.$nodes.BUILD_SEARCH_PARAMS.$output.result.names }}"
            }
          ],
          "metadata": {
            "name": "Set Names from Input",
            "position": {
              "x": 650,
              "y": 200
            }
          }
        },
        {
          "type": "LOOP",
          "id": "LOOP_NAMES",
          "code": "LOOP_NAMES",
          "outcomes": {
            "success": "FORMAT_OUTPUT"
          },
          "inputs": [
            {
              "id": "1770838789212310",
              "name": "collection",
              "type": "string",
              "value": "{{ $context.$variables.plan_names }}"
            }
          ],
          "metadata": {
            "name": "Loop Names",
            "loopType": "PARALLEL",
            "dataPipeline": {
              "rootNode": "start_LOOP_NAMES",
              "pipelineNodes": [
                {
                  "type": "START",
                  "code": "START_LOOP_NAMES",
                  "id": "start_LOOP_NAMES",
                  "metadata": {
                    "name": "Start",
                    "description": "Start of loop"
                  },
                  "outcomes": {
                    "success": "BUILD_EXACT_QUERY"
                  },
                  "inputs": []
                },
                {
                  "type": "CODE",
                  "id": "BUILD_EXACT_QUERY",
                  "code": "BUILD_EXACT_QUERY",
                  "outcomes": {
                    "success": "BO_FIND_EXACT"
                  },
                  "metadata": {
                    "name": "Build Query",
                    "returnType": "string",
                    "sourceCode": "/**\n * Build Exact Query\n * Builds the SQL query for exact name match.\n * The expression evaluator doesn't support string concatenation,\n * so we need a CODE node to build the query.\n */\n\nvar planName = $context.$nodes.LOOP_NAMES.$currentItem;\nvar intent = $context.$nodes.PARSE_INTENT.$output;\n\n// Build the query - escape single quotes in plan name if any\nvar escapedName = planName;\nif (typeof planName === 'string') {\n    escapedName = planName.split(\"'\").join(\"''\");\n}\n\nvar parts = [];\nparts.push(\"Name='\" + escapedName + \"'\");\nparts.push(\"ValidForCalculation='COMPLETE'\");\n\nvar query = parts.join(\" AND \");\n\n// The BO tool path URL-decodes the `q` value using URLDecoder semantics.\n// URLDecoder treats '+' as a space, which breaks exact matches for plan names\n// that contain a literal '+'.\n//\n// Workaround: pre-encode '+' as %2B so URL-decoding restores it as '+' (not space).\nquery = query.split('+').join('%2B');\n\nreturn query;\n"
                  },
                  "inputs": [],
                  "outputSpecification": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"string\"}"
                },
                {
                  "metadata": {
                    "businessObjectCode": "ORA_CX_INCENTIVEC_ICCOMPENSATIONPLANS",
                    "functionName": "findPlans",
                    "processJson": true,
                    "name": "Fetch Plan"
                  },
                  "outcomes": {
                    "success": "GET_ITEMS"
                  },
                  "code": "BO_FIND_EXACT",
                  "id": "BO_FIND_EXACT",
                  "inputs": [
                    {
                      "id": "1770838789212442",
                      "name": "q",
                      "type": "string",
                      "value": "{{$context.$nodes.LOOP_NAMES.BUILD_EXACT_QUERY.$output.result}}"
                    }
                  ],
                  "outputSpecification": "{\"type\": \"object\", \"properties\": {\"items\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"CompensationPlanId\": {\"type\": \"string\"}, \"Name\": {\"type\": \"string\"}, \"OrgId\": {\"type\": \"string\"}, \"Description\": {\"type\": \"string\"}}}}, \"hasMore\": {\"type\": \"boolean\"}, \"count\": {\"type\": \"integer\"}}, \"required\": [\"items\"]}",
                  "type": "BO_FUNCTION"
                },
                {
                  "type": "CODE",
                  "id": "GET_ITEMS",
                  "code": "GET_ITEMS",
                  "outcomes": {
                    "success": "end_LOOP_NAMES"
                  },
                  "metadata": {
                    "name": "Get Items",
                    "returnType": "array",
                    "sourceCode": "/**\n * Get Plan Items\n * Returns filtered items from BO_FIND_EXACT output.\n * Only keeps Name and CompensationPlanId to reduce data size.\n */\n\nvar boOutput = $context.$nodes.BO_FIND_EXACT.$output;\nvar items = [];\n\n// Try to get items from the BO output\nif (boOutput && boOutput.result && boOutput.result.items) {\n    items = boOutput.result.items;\n} else if (boOutput && boOutput.items) {\n    items = boOutput.items;\n} else if (Array.isArray(boOutput)) {\n    items = boOutput;\n}\n\n// Filter to only relevant fields\nvar filtered = [];\nfor (var i = 0; i < items.length; i++) {\n    var plan = items[i];\n    if (plan && plan.Name) {\n        filtered.push({\n            Name: plan.Name,\n            CompensationPlanId: plan.CompensationPlanId,\n            OrgId: plan.OrgId\n        });\n    }\n}\n\nreturn filtered;\n"
                  },
                  "inputs": [],
                  "outputSpecification": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"array\", \"items\": {\"type\": \"object\"}}"
                },
                {
                  "type": "END",
                  "code": "END_LOOP_NAMES",
                  "id": "end_LOOP_NAMES",
                  "metadata": {
                    "name": "End",
                    "description": "End of loop"
                  },
                  "outcomes": {},
                  "inputs": []
                }
              ]
            },
            "position": {
              "x": 950,
              "y": 200
            }
          }
        },
        {
          "type": "CODE",
          "id": "FORMAT_OUTPUT",
          "code": "FORMAT_OUTPUT",
          "outcomes": {
            "success": "end"
          },
          "inputs": [],
          "metadata": {
            "name": "Format Output",
            "returnType": "object",
            "sourceCode": "/**\n * Format Output - V1\n * Extracts plans from loop and returns wrapped response.\n */\n\nvar loopOutput = $context.$nodes.LOOP_NAMES.$output;\nvar loopResults = [];\n\nif (loopOutput && loopOutput.result) {\n    loopResults = loopOutput.result;\n} else if (Array.isArray(loopOutput)) {\n    loopResults = loopOutput;\n}\n\n// Flatten all plans from loop results\nvar flat = [];\nfor (var i = 0; i < loopResults.length; i++) {\n    var item = loopResults[i];\n\n    if (typeof item === 'string') {\n        try {\n            item = JSON.parse(item);\n        } catch (e) {\n            continue;\n        }\n    }\n\n    var plans = [];\n    if (item && item.result && Array.isArray(item.result)) {\n        plans = item.result;\n    } else if (Array.isArray(item)) {\n        plans = item;\n    }\n\n    for (var j = 0; j < plans.length; j++) {\n        flat.push(plans[j]);\n    }\n}\n\n// Deduplicate using array of seen IDs\nvar seenIds = [];\nvar unique = [];\n\nfor (var k = 0; k < flat.length; k++) {\n    var plan = flat[k];\n    if (!plan || !plan.CompensationPlanId) continue;\n\n    var key = plan.OrgId + \"_\" + plan.CompensationPlanId;\n    var alreadySeen = false;\n    for (var m = 0; m < seenIds.length; m++) {\n        if (seenIds[m] === key) {\n            alreadySeen = true;\n            break;\n        }\n    }\n\n    if (!alreadySeen) {\n        seenIds.push(key);\n        // Create object by assigning properties (avoids literal syntax)\n        var obj = new Object();\n        obj.Name = plan.Name;\n        obj.CompensationPlanId = plan.CompensationPlanId;\n        obj.OrgId = plan.OrgId;\n        unique.push(obj);\n    }\n}\n\nvar destination = null;\nif ($context.$nodes.PARSE_INTENT && $context.$nodes.PARSE_INTENT.$output) {\n    destination = $context.$nodes.PARSE_INTENT.$output.destination;\n}\n\nvar result = new Object();\nresult.plans = unique;\nresult.count = unique.length;\nresult.destination = destination === undefined ? null : destination;\n\nreturn result;\n",
            "position": {
              "x": 1250,
              "y": 200
            }
          },
          "outputSpecification": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"plans\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"CompensationPlanId\": {\"type\": \"string\"}, \"Name\": {\"type\": \"string\"}, \"OrgId\": {\"type\": \"string\"}}}}, \"count\": {\"type\": \"number\"}, \"destination\": {\"type\": [\"string\", \"null\"]}}}"
        },
        {
          "type": "END",
          "code": "END",
          "id": "end",
          "outcomes": {},
          "metadata": {
