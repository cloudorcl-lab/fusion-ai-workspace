  "workflowCode": "ORA_HCM_HRA_PERFORMANCE_DOCUMENT_CHECKIN_SUMMARY_GENERATOR",
  "name": "Performance Document Check-in Summary Generator",
  "description": "Generates a summary of an employee's check-ins to display in a performance document.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
