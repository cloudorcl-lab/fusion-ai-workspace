{
  "workflowId": "300000331058000",
  "workflowCode": "ORA_AGENT_CREATION_TEAM",
  "name": "Agent Creation Team",
  "description": "Creates an agent with retires",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1763751214036"
          },
          "code": "START_1763750943231",
          "id": "start_1763750943231",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "description": "End of data pipeline",
            "name": "End"
          },
          "outcomes": {},
          "code": "END_1763750943231",
          "id": "end_1763750943231",
          "inputs": [],
          "type": "END"
        },
        {
          "metadata": {
            "name": "set initial retries"
          },
          "outcomes": {
            "success": "1763751581927"
          },
          "code": "SET_INITIAL_RETRIES",
          "id": "1763751214036",
          "inputs": [
            {
              "id": "1763751444993",
              "name": "agentCodeRetries",
              "type": "number",
              "value": "{{$context.$triggers.REST.$input.agent.AgentCode.lastIndexOf('_')  > 0? (parseInt($context.$triggers.REST.$input.agent.AgentCode.substring($context.$triggers.REST.$input.agent.AgentCode.lastIndexOf('_') + 1)) || 0)  : 0 }}"
            },
            {
              "id": "1763751222759",
              "name": "retries",
              "type": "number",
              "value": "0"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "If retries"
          },
          "outcomes": {
            "true": "1763751928401",
            "false": "add_false_1763751338437"
          },
          "code": "IF_RETRIES",
          "convergenceTargetId": "1764706108969",
          "id": "1763751338437",
          "inputs": [
            {
              "id": "1763751338440_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$variables.retries < 5}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "description": "Add node for false branch",
            "name": "Add (False Branch)"
          },
          "outcomes": {
            "success": "1764706108969"
          },
          "id": "add_false_1763751338437",
          "inputs": [],
          "type": "ADD"
        },
        {
          "metadata": {
            "name": "set agent code"
          },
          "outcomes": {
            "success": "1763751338437"
          },
          "code": "SET_AGENT_CODE",
          "id": "1763751581927",
          "inputs": [
            {
              "id": "1763751812184",
              "name": "agentCode",
              "type": "string",
              "value": "$context.$triggers.REST.$input.agent.AgentCode"
            },
            {
              "id": "1763751591290",
              "name": "agentCodeBase",
              "type": "string",
              "value": "{{$context.$variables.agentCodeRetries > 0 ? $context.$triggers.REST.$input.agent.AgentCode.slice(0, $context.$triggers.REST.$input.agent.AgentCode.lastIndexOf('_')) :  $context.$triggers.REST.$input.agent.AgentCode }}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Set Agent Code Based on Retries"
          },
          "outcomes": {
            "success": "1763752018004"
          },
          "code": "SET_AGENT_CODE_BASED_ON_RETRIES",
          "id": "1763751928401",
          "inputs": [
            {
              "id": "1763751936474",
              "name": "agentCode",
              "type": "string",
              "value": "{{ $context.$variables.retries === 0 ? $context.$variables.agentCode : $context.$variables.agentCodeBase + '_' + ($context.$variables.agentCodeRetries + $context.$variables.retries)  }}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Set retries"
          },
          "outcomes": {
            "success": "1763752221459"
          },
          "code": "SET_RETRIES",
          "id": "1763752018004",
          "inputs": [
            {
              "id": "1763752026090",
              "name": "retries",
              "type": "number",
              "value": "{{$context.$variables.retries + 1}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_OTHER_HCMAGENTCREATION",
