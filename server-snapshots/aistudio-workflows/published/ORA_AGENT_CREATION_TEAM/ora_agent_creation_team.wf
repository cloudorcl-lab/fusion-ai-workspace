        {
          "metadata": {
            "name": "Return Agent Info",
            "returnType": "object",
            "sourceCode": "const obj =  $context.$nodes.CREATE_AGENT.$output&&  $context.$nodes.CREATE_AGENT.$output.AgentId ? {\n  \"AgentId\": $context.$nodes.CREATE_AGENT.$output.AgentId,\n  \"AgentCode\": $context.$nodes.CREATE_AGENT.$output.AgentCode,\n} : {};\n\nreturn obj;"
          },
