            "sourceCode": "var planCandidates = $context.$variables.planDetail.successionPlanCandidates.items;\nfor (let i = 0; i < planCandidates .length; i++) {\n    if (planCandidates[i].PersonId === $context.$variables.employeePersonId.toString() ) { \n         return true;\n    }\n}\n\nreturn false;"
