          },
          "code": "IF_PERSONNAME_PROVIDED",
          "convergenceTargetId": "1768611579794",
          "id": "1768508880589",
          "inputs": [
            {
              "id": "1768508880591_1",
              "name": "condition",
              "type": "string",
              "value": "{{($context.$nodes.EXTRACT_DATA_FROM_USER_INPUT.$output.personName !== null && $context.$nodes.EXTRACT_DATA_FROM_USER_INPUT.$output.personName !== '') || ($context.$nodes.EXTRACT_DATA_FROM_USER_INPUT.$output.personNumber !== null && $context.$nodes.EXTRACT_DATA_FROM_USER_INPUT.$output.personNumber !== '')}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Get Complete vQuery",
            "returnType": "string",
            "sourceCode": "let query = \"\";\nlet searchFields = \"\";\nlet personNumber = $context.$nodes.EXTRACT_DATA_FROM_USER_INPUT.$output.personNumber;\nlet personName = $context.$nodes.EXTRACT_DATA_FROM_USER_INPUT.$output.personName;\nif (personNumber.length > 0) {\n    query = '\"query\": \"' + personNumber + '\"';\n    searchFields = '\"searchFields\": [ \"PersonNumber\" ]';\n}\nelse {\n    query = '\"query\": \"' + personName + '\"';\n    searchFields = '\"searchFields\": [ \"DisplayName\" ]';\n}\nlet filters = '\"filters\": [{ \"name\": \"PrimaryAssignmentOnly\", \"value\": \"True\"}';\nif ( $context.$nodes.EXTRACT_DATA_FROM_USER_INPUT.$output.withinMyTeam ) {\n    filters += ', {\"name\": \"Reports\", \"value\": \"ALL\"}';\n}\nfilters += ']';\nlet securityFilters = '\"securityFilters\": {\"type\": \"PersonSearch\", \"value\": \"AdvancedSearch\"}';\nlet displayFields = '\"displayFields\": [\"DisplayName\", \"PersonId\", \"PersonNumber\", \"AssignmentId\", \"AssignmentNumber\", \"BusinessTitle\", \"ManagerDisplayName\", \"AssignmentUserStatus\", \"WorkerType\", \"WorkEmail\", \"WorkPhone\"]';\n\nreturn '{' + query + ',' + searchFields + ',' + filters + ',' + securityFilters + ',' + displayFields + '}';"
          },
          "outcomes": {
            "success": "1768509045399"
          },
          "diagram": {
            "x": 11437.7021484375,
            "y": 5650
          },
          "code": "GET_COMPLETE_VQUERY",
          "id": "1776285333648",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
