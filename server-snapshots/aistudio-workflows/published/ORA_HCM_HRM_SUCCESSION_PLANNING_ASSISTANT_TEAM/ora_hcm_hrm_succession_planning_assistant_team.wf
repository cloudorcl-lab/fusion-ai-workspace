            "sourceCode": "var planCandidates = $context.$variables.planDetail.successionPlanCandidates.items;\nfor (let i = 0; i < planCandidates .length; i++) {\n    let candidatePersonId = $context.$nodes.GET_CANDIDATEPERSONID.$output.candidatePersonId;\n    if (planCandidates[i].PersonId === candidatePersonId.toString()) {\n         return true;\n    }\n}\n\nreturn false;"
