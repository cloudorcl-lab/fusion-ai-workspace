          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get Candidate vQuery",
            "returnType": "string",
            "sourceCode": "let query = \"\";\nlet searchFields = \"\";\nlet candidatePersonNumber = $context.$nodes.EXTRACT_DATA_FROM_USER_INPUT.$output.candidatePersonNumber;\nlet candidateName = $context.$nodes.EXTRACT_DATA_FROM_USER_INPUT.$output.candidateName;\nif (candidatePersonNumber.length > 0) {\n    query = '\"query\": \"' + candidatePersonNumber + '\"';\n    searchFields = '\"searchFields\": [ \"PersonNumber\" ]';\n}\nelse {\n    query = '\"query\": \"' + candidateName + '\"';\n    searchFields = '\"searchFields\": [ \"DisplayName\" ]';\n}\nlet filters = '\"filters\": [{ \"name\": \"PrimaryAssignmentOnly\", \"value\": \"True\"}';\nif ( $context.$nodes.EXTRACT_DATA_FROM_USER_INPUT.$output.withinMyTeam ) {\n    filters += ', {\"name\": \"Reports\", \"value\": \"ALL\"}';\n}\nfilters += ']';\nlet securityFilters = '\"securityFilters\": {\"type\": \"PersonSearch\", \"value\": \"AdvancedSearch\"}';\nlet displayFields = '\"displayFields\": [\"DisplayName\", \"PersonId\", \"PersonNumber\", \"AssignmentId\", \"AssignmentNumber\", \"BusinessTitle\", \"ManagerDisplayName\", \"AssignmentUserStatus\", \"WorkerType\", \"WorkEmail\", \"WorkPhone\"]';\n\nreturn '{' + query + ',' + searchFields + ',' + filters + ',' + securityFilters + ',' + displayFields + '}';"
          },
          "outcomes": {
            "success": "1770067519203"
          },
          "diagram": {
            "x": 6607.7744140625,
            "y": 14806
          },
