          "code": "HASCASHADVANCES",
          "convergenceTargetId": "end",
          "id": "1773336614841",
          "inputs": [
            {
              "id": "1773336614846_1",
              "name": "condition",
              "type": "string",
              "value": "{{JSON.parse($context.$nodes.CASH_ADVANCE_APPLICATION_ASSISTANT.$output.output).result.status != 'Failed'}}"
            }
