        },
        {
          "metadata": {
            "name": "Create Predictions Payload",
            "returnType": "object",
            "sourceCode": "let predictionsPayload = {};\nlet itemsArray = [];\n\nlet partnerExpensexpenseId = Number(\n    $context.$nodes.CREATE_MESSAGE_PARTNER_EXPENSE.$output.partnerExpenseId\n);\nvar expenseReportId = $context.$variables.expenseReportId;\n\nlet rawOutput = $context.$nodes.CASH_ADVANCE_APPLICATION_ASSISTANT.$output.output;\nlet parsedOutput = {};\n\nif (typeof rawOutput === \"string\" && rawOutput.trim() !== \"\") {\n    try {\n        parsedOutput = JSON.parse(rawOutput);\n    } catch (e) {\n        parsedOutput = {};\n    }\n}\n\nlet cashAdvanceData = parsedOutput.result || {};\nlet cashAdvanceSummary = cashAdvanceData.caSummery || {};\n\nlet recommendedAdv = cashAdvanceSummary.recommendedAdv || null;\n\nlet otherAdv = Array.isArray(cashAdvanceSummary.otherAdv)\n    ? cashAdvanceSummary.otherAdv\n    : [];\n\n// recommendedAdv => predictionRank = 1\nif (recommendedAdv != null) {\n\n    let fieldValueString = JSON.stringify(recommendedAdv).replace(/\"/g, '\\\\\"');\n\n    let itemPayload = {\n        \"$operation\": \"CREATE\",\n        \"partnerExpense\": {\n            \"id\": partnerExpensexpenseId\n        },\n        \"fieldName\": \"CashAdvance\",\n        \"fieldValue\": fieldValueString,\n        \"sourceObjectCode\": \"ORA_EXPENSE_REPORT\",\n        \"predictionTypeCode\": \"ORA_DEFAULTED\",\n        \"predictionDisplayRule\": \"ORA_REQUEST_USER_INPUT\",\n        \"predictionRank\": 1,\n        \"predictionSource\": \"ORA_FIN_EXM_CASH_ADV_ASSISTANT\",\n        \"ruleCode\": \"ORA_CASH_ADVANCE_DEFAULTED\",\n        \"driverName1\": \"ORA_PARTNER_EXPENSE_ID\",\n        \"driverValue1\": partnerExpensexpenseId,\n        \"driverName2\": \"ORA_SOURCE\",\n        \"driverValue2\": \"AGENT\",\n        \"driverName3\": \"ORA_CONTEXT\",\n        \"driverValue3\": \"CASH_ADVANCE\",\n        \"driverName4\": \"ORA_EXPENSE_REPORT_ID\",\n        \"driverValue4\": expenseReportId,\n        \"driverName5\": \"\",\n        \"driverValue5\": \"\"\n    };\n\n    itemsArray.push(itemPayload);\n}\n\n// otherAdv => predictionRank = index + 1\notherAdv.forEach((adv, index) => {\n\n    if (adv == null) return;\n\n    let fieldValueString = JSON.stringify(adv).replace(/\"/g, '\\\\\"');\n\n    let itemPayload = {\n        \"$operation\": \"CREATE\",\n        \"partnerExpense\": {\n            \"id\": partnerExpensexpenseId\n        },\n        \"fieldName\": \"CashAdvance\",\n        \"fieldValue\": fieldValueString,\n        \"sourceObjectCode\": \"ORA_EXPENSE_REPORT\",\n        \"predictionTypeCode\": \"ORA_RECOMMENDATION\",\n        \"predictionDisplayRule\": \"ORA_REQUEST_USER_INPUT\",\n        \"predictionRank\": index + 1,\n        \"predictionSource\": \"ORA_FIN_EXM_CASH_ADV_ASSISTANT\",\n        \"ruleCode\": \"ORA_CASH_ADVANCE_RECOMMENDATION\",\n        \"driverName1\": \"ORA_PARTNER_EXPENSE_ID\",\n        \"driverValue1\": partnerExpensexpenseId,\n        \"driverName2\": \"ORA_SOURCE\",\n        \"driverValue2\": \"AGENT\",\n        \"driverName3\": \"ORA_CONTEXT\",\n        \"driverValue3\": \"CASH_ADVANCE\",\n        \"driverName4\": \"ORA_EXPENSE_REPORT_ID\",\n        \"driverValue4\": expenseReportId,\n        \"driverName5\": \"\",\n        \"driverValue5\": \"\"\n    };\n\n   itemsArray.push(itemPayload);\n});\n\nif (itemsArray.length === 0) {\n    return {};\n}\n\npredictionsPayload[\"items\"] = itemsArray;\n\nreturn predictionsPayload;"
          },
          "outcomes": {
            "success": "1774587097069"
          },
