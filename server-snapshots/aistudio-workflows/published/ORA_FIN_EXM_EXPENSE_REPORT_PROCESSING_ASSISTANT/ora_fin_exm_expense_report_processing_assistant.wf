        {
          "metadata": {
            "name": "Extract user selection cash advance",
            "returnType": "object",
            "sourceCode": "const otherOption =\n  $context?.$nodes?.EMAILPURPOSEOUTPUT?.$output?.result?.otherOption;\n\nif (\n  otherOption === null ||\n  otherOption === undefined ||\n  String(otherOption).trim() === \"\"\n) {\n  return { cashAdvanceNumber: null };\n}\n\nconst selectedRank = String(otherOption).trim();\n\nconst items = $context?.$nodes?.GET_CASH_ADVANCES_PREDICTIONS?.$output?.items;\n\nif (!Array.isArray(items) || items.length === 0) {\n  return { cashAdvanceNumber: null };\n}\n\nconst selectedItem = items.find(\n  item => String(item?.predictionRank ?? \"\").trim() === selectedRank\n);\n\nif (!selectedItem?.fieldValue) {\n  return { cashAdvanceNumber: null };\n}\n\nconst text = String(selectedItem.fieldValue).trim();\n\nlet parsedFieldValue = null;\n\ntry {\n  parsedFieldValue = JSON.parse(text);\n} catch (e1) {\n  try {\n    parsedFieldValue = JSON.parse(text.replace(/\\\\\"/g, '\"'));\n  } catch (e2) {\n    return { cashAdvanceNumber: null };\n  }\n}\n\nreturn {\n  cashAdvanceNumber: parsedFieldValue?.cashAdvanceNumber ?? null\n};"
          },
          "outcomes": {
            "success": "1782905037213"
          },
          "code": "EXTRACT_USER_SELECTION_CASH_ADVANCE",
          "id": "1780984085627",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
