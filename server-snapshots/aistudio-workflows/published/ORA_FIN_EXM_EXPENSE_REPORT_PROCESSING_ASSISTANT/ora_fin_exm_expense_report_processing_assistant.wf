            "sourceCode": "var emailPurpose = $context.$nodes.EMAILPURPOSEOUTPUT.$output.result;\n\nvar payload = {\n  expenseStatusCode: \"SUBMITTED\"\n};\n\nif (\n  emailPurpose?.replyChoice === \"doNotApply\" &&\n  emailPurpose?.justificationForDoNotApply?.trim()\n) {\n  payload.unappliedAdvancesJustification =\n    emailPurpose.justificationForDoNotApply;\n\n  payload.cashAdvanceAppliedMethodCode = \"M\";\n}\n\nreturn payload;"
          },
