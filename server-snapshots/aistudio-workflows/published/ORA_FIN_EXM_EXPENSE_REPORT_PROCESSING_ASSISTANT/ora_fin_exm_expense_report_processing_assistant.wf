        {
          "metadata": {
            "name": "Read Value Code",
            "returnType": "object",
            "sourceCode": "var response = $context.$nodes.GET_SETUP_OPTION.$output;\nvar myBusinessUnitId = $context.$variables.businessUnitId;\n\nvar items = response?.items || [];\n\n// All Business Units value\nvar allBuValueCode = items.find(i => !i.businessUnit)?.valueCode;\n\n// Specific BU record\nvar buItem = items.find(i => i.businessUnit?.id == myBusinessUnitId);\n\n// Pick BU valueCode if available, otherwise fallback to All BU\nvar valueCode = buItem?.valueCode || allBuValueCode;\n\nreturn valueCode;"
          },
          "outcomes": {
            "success": "1773330119415"
          },
          "code": "READ_VALUE_CODE",
          "id": "1773330083102",
          "inputs": [],
