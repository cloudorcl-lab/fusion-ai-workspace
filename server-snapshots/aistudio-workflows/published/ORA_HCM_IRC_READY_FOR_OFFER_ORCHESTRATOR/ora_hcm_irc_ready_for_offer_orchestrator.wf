            "sourceCode": "function parseValue(value) {\n  if (typeof value === 'string') {\n    try {\n      return JSON.parse(value);\n    } catch (error) {\n      return null;\n    }\n  }\n  return value;\n}\nfunction asText(value) {\n  return value === undefined || value === null ? '' : String(value).trim();\n}\nfunction firstText(values) {\n  for (var valueIndex = 0; valueIndex < values.length; valueIndex += 1) {\n    var text = asText(values[valueIndex]);\n    if (text) {\n      return text;\n    }\n  }\n  return '';\n}\nvar completedFeedbacks = ($context.$nodes.PROCESS_FEEDBACKS.$output.result || {}).completed || [];\nvar applicationLoopOutput = Array.isArray($context.$nodes.APPLICATION_DETAILS_LOOP.$output) ? $context.$nodes.APPLICATION_DETAILS_LOOP.$output : [];\nvar detailsBySubmission = {};\nvar applicationDetails = [];\nfor (var i = 0; i < applicationLoopOutput.length; i += 1) {\n  var parsed = parseValue(applicationLoopOutput[i]);\n  var detail = parsed && parsed.result ? parsed.result : parsed;\n  if (!detail || !detail.SubmissionId) {\n    continue;\n  }\n  applicationDetails.push(detail);\n  detailsBySubmission[detail.SubmissionId] = detail;\n}\nvar eligibleFeedbacks = [];\nvar questionnaireInputs = [];\nfor (var feedbackIndex = 0; feedbackIndex < completedFeedbacks.length; feedbackIndex += 1) {\n  var feedback = completedFeedbacks[feedbackIndex] || {};\n  var enrichment = detailsBySubmission[feedback.SubmissionId] || {};\n  var merged = Object.assign({}, feedback, enrichment);\n  merged.CandidateName = firstText([\n    feedback.CandidateName,\n    feedback.candidateName,\n    enrichment.CandidateName,\n    enrichment.candidateName\n  ]);\n  eligibleFeedbacks.push(merged);\n  if (merged.QuestionnaireId && merged.FeedbackRequestId) {\n    questionnaireInputs.push(merged);\n  }\n}\nvar result = {\n  applicationDetails: applicationDetails,\n  eligibleFeedbacks: eligibleFeedbacks,\n  questionnaireInputs: questionnaireInputs\n};\nreturn result;\n"
