              "name": "OraAction",
              "type": "object",
              "value": "{{$context.$triggers.REST.$input.OraAction}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_CARD"
              ],
              "enableActions": false,
              "enableCommunications": false
            }
          },
          "metadata": {
            "name": "ACTIONS_LLM"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "ACTIONS_LLM",
          "id": "1768584275814",
          "inputs": [
            {
              "id": "1768584275816_1",
              "name": "prompt",
              "type": "string",
              "value": "{{$context.$nodes.ACTIONS_AGENT.$output.output}}\n\n--------------------------------------------------------------------\nERROR HANDLING\n--------------------------------------------------------------------\nIf the above output contains the text \"Error occurred on this action\":\n\n- If a candidate name exists in {{$context.$triggers.REST.$input.OraAction}}, return ONLY:\n  \"{Candidate Name} could not be moved to the Offer phase. Please try again.\"\n\n- Otherwise, return ONLY:\n  \"The candidate could not be moved to the Offer phase. Please try again.\"\n\n--------------------------------------------------------------------\nSUCCESS MESSAGE\n--------------------------------------------------------------------\nIf no error is present:\n\n- If a candidate name exists in {{$context.$triggers.REST.$input.OraAction}}, return ONLY:\n  \"{Candidate Name} has been moved to the Offer phase successfully.\"\n\n- Otherwise, return ONLY:\n  \"The candidate has been moved to the Offer phase successfully.\"\n\n--------------------------------------------------------------------\nOUTPUT RULES\n--------------------------------------------------------------------\n- Plain text only\n- One sentence only\n- Do not include any actions\n- Do not include any additional information"
            }
          ],
          "type": "LLM"
        },
