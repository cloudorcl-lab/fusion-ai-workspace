            "returnType": "object",
            "sourceCode": "function parseValue(value) {\n  if (typeof value === 'string') {\n    try {\n      return JSON.parse(value);\n    } catch (error) {\n      return null;\n    }\n  }\n  return value;\n}\nfunction asText(value) {\n  return value === undefined || value === null ? '' : String(value).trim();\n}\nfunction asNumber(value) {\n  if (value === undefined || value === null || value === '') {\n    return null;\n  }\n  var parsed = Number(value);\n  return isFinite(parsed) ? parsed : null;\n}\nfunction asBoolean(value) {\n  if (value === true || value === false) {\n    return value;\n  }\n  var text = asText(value).toLowerCase();\n  return text === 'true' || text === 'y' || text === 'yes' || text === '1';\n}\nfunction normalize(value) {\n  return asText(value).toLowerCase();\n}\nfunction compactKey(value) {\n  return asText(value).toLowerCase().replace(/[^a-z0-9]+/g, '');\n}\nfunction uniqueStrings(values) {\n  var seen = {};\n  var result = [];\n  for (var i = 0; i < values.length; i += 1) {\n    var text = asText(values[i]);\n    if (!text || seen[text]) {\n      continue;\n    }\n    seen[text] = true;\n    result.push(text);\n  }\n  return result;\n}\nfunction firstText(values) {\n  for (var valueIndex = 0; valueIndex < values.length; valueIndex += 1) {\n    var text = asText(values[valueIndex]);\n    if (text) {\n      return text;\n    }\n  }\n  return '';\n}\nfunction feedbackText(questionnaireResponses, completedFeedback) {\n  var parts = [];\n  for (var i = 0; i < questionnaireResponses.length; i += 1) {\n    var responseSet = questionnaireResponses[i] || {};\n    var responses = Array.isArray(responseSet.responses) ? responseSet.responses : [];\n    for (var j = 0; j < responses.length; j += 1) {\n      var response = responses[j] || {};\n      parts.push(response.question || '');\n      parts.push(response.answer || '');\n      parts.push(response.QuestionText || '');\n      parts.push(response.ResponseText || '');\n    }\n  }\n  for (var k = 0; k < completedFeedback.length; k += 1) {\n    var row = completedFeedback[k] || {};\n    parts.push(row.StatusTypeCodeName || '');\n    parts.push(row.FeedbackComments || '');\n    parts.push(row.Comment || '');\n    parts.push(row.Comments || '');\n  }\n  return normalize(parts.join(' '));\n}\nfunction classifyFeedback(averageRating, totalScore, maxScore, text) {\n  var pct = totalScore !== null && maxScore !== null && maxScore > 0 ? totalScore / maxScore : null;\n  var negative =\n    /(do not recommend|not recommend|poor|weak|reject|rejected|not suitable|not a fit|unreliable|failed|insufficient)/i.test(text);\n  var borderline =\n    /(borderline|mixed|some concern|concerns|needs review|follow up|hesitation|average|adequate|meets some|conditional)/i.test(text);\n  var positive =\n    /(recommend|recommended|strong|excellent|great|good|positive|hire|move forward|advance|suitable|solid|meets requirements|impressive)/i.test(text);\n  if (negative) {\n    return 'exclude';\n  }\n  if (positive) {\n    return 'positive';\n  }\n  if (averageRating !== null && averageRating >= 4) {\n    return 'positive';\n  }\n  if (pct !== null && pct >= 0.75) {\n    return 'positive';\n  }\n  if (borderline) {\n    return 'borderline';\n  }\n  if (averageRating !== null && averageRating >= 3 && averageRating < 4) {\n    return 'borderline';\n  }\n  if (pct !== null && pct >= 0.5 && pct < 0.75) {\n    return 'borderline';\n  }\n  return 'exclude';\n}\nfunction compareCandidates(left, right) {\n  var classDelta = (left.FeedbackClassification === 'positive' ? 0 : 1) - (right.FeedbackClassification === 'positive' ? 0 : 1);\n  if (classDelta !== 0) {\n    return classDelta;\n  }\n  var leftRating = asNumber(left.AverageRating);\n  var rightRating = asNumber(right.AverageRating);\n  if (leftRating !== null && rightRating !== null && leftRating !== rightRating) {\n    return rightRating - leftRating;\n  }\n  if (leftRating === null && rightRating !== null) {\n    return 1;\n  }\n  if (leftRating !== null && rightRating === null) {\n    return -1;\n  }\n  var leftScore = asNumber(left.TotalScore);\n  var rightScore = asNumber(right.TotalScore);\n  if (leftScore !== null && rightScore !== null && leftScore !== rightScore) {\n    return rightScore - leftScore;\n  }\n  if (leftScore === null && rightScore !== null) {\n    return 1;\n  }\n  if (leftScore !== null && rightScore === null) {\n    return -1;\n  }\n  var reqCompare = normalize(left.RequisitionNumber).localeCompare(normalize(right.RequisitionNumber));\n  if (reqCompare !== 0) {\n    return reqCompare;\n  }\n  var candidateCompare = normalize(left.CandidateName).localeCompare(normalize(right.CandidateName));\n  if (candidateCompare !== 0) {\n    return candidateCompare;\n  }\n  return normalize(left.SubmissionId).localeCompare(normalize(right.SubmissionId));\n}\n\nvar allFeedbacks = $context.$nodes.PROCESS_FEEDBACKS.$output.result || {};\nvar eligiblePayload = $context.$nodes.PREPARE_ELIGIBLE_FEEDBACKS.$output.result || {};\nvar eligibleFeedbacks = Array.isArray(eligiblePayload.eligibleFeedbacks) ? eligiblePayload.eligibleFeedbacks : [];\nvar questionnaireLoopOutput = Array.isArray($context.$nodes.FEEDBACK_QUESTIONAIRE_LOOP.$output)\n  ? $context.$nodes.FEEDBACK_QUESTIONAIRE_LOOP.$output\n  : [];\n\nvar questionnaireBySubmission = {};\nfor (var questionnaireIndex = 0; questionnaireIndex < questionnaireLoopOutput.length; questionnaireIndex += 1) {\n  var parsedQuestionnaire = parseValue(questionnaireLoopOutput[questionnaireIndex]);\n  var questionnaireItem = parsedQuestionnaire && parsedQuestionnaire.result ? parsedQuestionnaire.result : parsedQuestionnaire;\n  if (!questionnaireItem || !questionnaireItem.SubmissionId) {\n    continue;\n  }\n  if (!questionnaireBySubmission[questionnaireItem.SubmissionId]) {\n    questionnaireBySubmission[questionnaireItem.SubmissionId] = [];\n  }\n  questionnaireBySubmission[questionnaireItem.SubmissionId].push(questionnaireItem);\n}\n\nvar feedbacksBySubmission = {};\nfor (var feedbackIndex = 0; feedbackIndex < eligibleFeedbacks.length; feedbackIndex += 1) {\n  var feedback = eligibleFeedbacks[feedbackIndex] || {};\n  if (!feedback.SubmissionId) {\n    continue;\n  }\n  if (!feedbacksBySubmission[feedback.SubmissionId]) {\n    feedbacksBySubmission[feedback.SubmissionId] = [];\n  }\n  feedbacksBySubmission[feedback.SubmissionId].push(feedback);\n}\n\nvar readyCandidates = [];\nvar submissionIds = Object.keys(feedbacksBySubmission);\nfor (var submissionIndex = 0; submissionIndex < submissionIds.length; submissionIndex += 1) {\n  var submissionId = submissionIds[submissionIndex];\n  var completedFeedback = feedbacksBySubmission[submissionId] || [];\n  var questionnaireItems = questionnaireBySubmission[submissionId] || [];\n  if (!completedFeedback.length) {\n    continue;\n  }\n\n  var firstFeedback = completedFeedback[0] || {};\n  var candidateName = firstText(completedFeedback.map(function(item) {\n    return item.CandidateName || item.candidateName;\n  }));\n  if (!candidateName) {\n    candidateName = firstText(questionnaireItems.map(function(item) {\n      return item.CandidateName || item.candidateName;\n    }));\n  }\n  var currentPhaseKey = compactKey(firstFeedback.CurrentPhaseName);\n  var currentStateKey = compactKey(firstFeedback.CurrentStateName);\n  var terminalBlocked = currentPhaseKey.indexOf('reject') >= 0 ||\n    currentPhaseKey.indexOf('withdraw') >= 0 ||\n    currentPhaseKey.indexOf('disqualif') >= 0 ||\n    currentPhaseKey.indexOf('offer') >= 0 ||\n    currentStateKey.indexOf('reject') >= 0 ||\n    currentStateKey.indexOf('withdraw') >= 0 ||\n    currentStateKey.indexOf('disqualif') >= 0;\n  if (terminalBlocked || !asBoolean(firstFeedback.EligibleForWidget)) {\n    continue;\n  }\n\n  var participantNames = uniqueStrings(completedFeedback.map(function(item) {\n    return item.ParticipantName;\n  }));\n  var questionnaireResponses = questionnaireItems.map(function(item) {\n    return {\n      participantName: item.ParticipantName || '',\n      questionnaireId: item.QuestionnaireId || '',\n      feedbackRequestId: item.FeedbackRequestId || '',\n      questionnaireResponseId: item.QuestionnaireResponseId || '',\n      responses: Array.isArray(item.Responses) ? item.Responses : []\n    };\n  });\n  var completedFeedbackDetails = completedFeedback.map(function(item) {\n    return {\n      participantName: item.ParticipantName || '',\n      averageRating: item.AverageRating || '',\n      totalScore: item.TotalScore || '',\n      maximumPossibleScore: item.MaximumPossibleScore || '',\n      comments: item.FeedbackComments || item.Comment || item.Comments || ''\n    };\n  });\n\n  var ratingTotal = 0;\n  var ratingCount = 0;\n  var totalScore = null;\n  var maxScore = null;\n  for (var ratingIndex = 0; ratingIndex < completedFeedback.length; ratingIndex += 1) {\n    var candidateRating = asNumber(completedFeedback[ratingIndex].AverageRating);\n    if (candidateRating !== null) {\n      ratingTotal += candidateRating;\n      ratingCount += 1;\n    }\n    var rowScore = asNumber(completedFeedback[ratingIndex].TotalScore);\n    var rowMax = asNumber(completedFeedback[ratingIndex].MaximumPossibleScore);\n    if (rowScore !== null) {\n      totalScore = totalScore === null ? rowScore : totalScore + rowScore;\n    }\n    if (rowMax !== null) {\n      maxScore = maxScore === null ? rowMax : maxScore + rowMax;\n    }\n  }\n  var averageRating = ratingCount > 0 ? Math.round((ratingTotal / ratingCount) * 10) / 10 : null;\n  var text = feedbackText(questionnaireResponses, completedFeedback);\n  var classification = classifyFeedback(averageRating, totalScore, maxScore, text);\n  if (classification === 'exclude') {\n    continue;\n  }\n\n  var feedbackSummaryParts = [];\n  if (participantNames.length) {\n    feedbackSummaryParts.push('Completed feedback from ' + participantNames.join(', '));\n  } else {\n    feedbackSummaryParts.push('Completed feedback available');\n  }\n  if (questionnaireResponses.length) {\n    feedbackSummaryParts.push('interview responses available');\n  }\n  feedbackSummaryParts.push(classification === 'positive' ? 'feedback is positive' : 'feedback is borderline and needs review');\n  var feedbackSummary = feedbackSummaryParts.join('. ') + '.';\n\n  var moveForwardPayload = {\n    action: 'Move_To_Offer',\n    submissionId: firstFeedback.SubmissionId,\n    requisitionId: firstFeedback.RequisitionId || '',\n    candidateName: candidateName\n  };\n  var moreDetailsPayload = {\n    action: 'MoreDetails',\n    submissionId: firstFeedback.SubmissionId,\n    requisitionId: firstFeedback.RequisitionId || '',\n    candidateName: candidateName,\n    requisitionTitle: firstFeedback.RequisitionTitle || '',\n    requisitionNumber: firstFeedback.RequisitionNumber || '',\n    FeedbackSummary: feedbackSummary,\n    Responses: questionnaireResponses,\n    CompletedFeedback: completedFeedbackDetails,\n    AverageRating: averageRating,\n    TotalScore: totalScore,\n    MaximumPossibleScore: maxScore,\n    FeedbackProviderCount: participantNames.length,\n    FeedbackClassification: classification,\n    CurrentPhaseName: firstFeedback.CurrentPhaseName || '',\n    CurrentStateName: firstFeedback.CurrentStateName || '',\n    PreOfferStateName: firstFeedback.PreOfferStateName || ''\n  };\n\n  readyCandidates.push({\n    SubmissionId: firstFeedback.SubmissionId,\n    CandidateName: candidateName,\n    RequisitionId: firstFeedback.RequisitionId || '',\n    RequisitionTitle: firstFeedback.RequisitionTitle || '',\n    RequisitionNumber: firstFeedback.RequisitionNumber || '',\n    FeedbackSummary: feedbackSummary,\n    Responses: questionnaireResponses,\n    CompletedFeedback: completedFeedbackDetails,\n    AverageRating: averageRating,\n    TotalScore: totalScore,\n    MaximumPossibleScore: maxScore,\n    FeedbackProviderCount: participantNames.length,\n    FeedbackClassification: classification,\n    CurrentPhaseName: firstFeedback.CurrentPhaseName || '',\n    CurrentStateName: firstFeedback.CurrentStateName || '',\n    PreOfferStateName: firstFeedback.PreOfferStateName || '',\n    PrimaryActionText: classification === 'positive' ? 'Move Forward' : 'More Details',\n    PrimaryActionCommand: classification === 'positive'\n      ? 'ora.Invoke(\"MoveForward\",' + JSON.stringify(moveForwardPayload) + ')'\n      : 'ora.Invoke(\"MoreDetails\",' + JSON.stringify(moreDetailsPayload) + ')'\n  });\n}\n\nreadyCandidates.sort(compareCandidates);\n\nreturn {\n  allFeedbacks: allFeedbacks,\n  readyCandidates: readyCandidates.slice(0, 5)\n};"
          },
