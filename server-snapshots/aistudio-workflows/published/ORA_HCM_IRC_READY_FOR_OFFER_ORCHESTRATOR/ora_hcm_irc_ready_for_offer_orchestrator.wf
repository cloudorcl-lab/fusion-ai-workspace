        {
          "metadata": {
            "name": "parseReqArray",
            "returnType": "array",
            "sourceCode": "var inputPayload = $context.$nodes.TOP6REQS.$output;\nvar data = typeof inputPayload === 'string' ? JSON.parse(inputPayload) : inputPayload;\nvar resultItems = [];\nif (data && data.result && Array.isArray(data.result.items)) {\n  resultItems = data.result.items;\n} else if (data && Array.isArray(data.items)) {\n  resultItems = data.items;\n}\n\nvar requisitionIds = [];\nvar seen = {};\nfunction addRequisitionId(value) {\n  var requisitionId = value === undefined || value === null ? '' : String(value).trim();\n  if (!requisitionId || seen[requisitionId]) {\n    return;\n  }\n  seen[requisitionId] = true;\n  requisitionIds.push(requisitionId);\n}\n\n\nfor (var i = 0; i < resultItems.length; i += 1) {\n  var item = resultItems[i] || {};\n  addRequisitionId(item.RequisitionId || item.requisitionId || '');\n}\n\nreturn requisitionIds;\n"
          },
          "outcomes": {
            "success": "1773000000003"
          },
          "code": "PARSEREQARRAY",
          "id": "1773000000002",
          "inputs": [],
