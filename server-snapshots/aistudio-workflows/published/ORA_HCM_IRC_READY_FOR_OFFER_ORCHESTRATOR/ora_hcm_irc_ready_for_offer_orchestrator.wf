        {
          "metadata": {
            "name": "PROCESS_FEEDBACKS",
            "returnType": "object",
            "sourceCode": "var requisitionsFeedbacks = $context.$nodes.REQUISITIONS_FEEDBACKS_LOOP.$output;\nvar groups = {\n  ORA_COMPLETED: {},\n  ORA_REQUESTED: {},\n  ORA_SAVED: {}\n};\nfor (var i = 0; i < requisitionsFeedbacks.length; i += 1) {\n  var requisitionFeedbacksResStr = requisitionsFeedbacks[i];\n  var requisitionFeedbacksRes = {};\n  try {\n    requisitionFeedbacksRes = JSON.parse(requisitionFeedbacksResStr);\n  } catch (error) {\n    continue;\n  }\n  var items = requisitionFeedbacksRes.items || [];\n  if (!items.length) {\n    continue;\n  }\n  for (var j = 0; j < items.length; j += 1) {\n    var feedback = items[j] || {};\n    var mappedItem = {\n      RequisitionTitle: feedback.RequisitionTitle,\n      RequisitionNumber: feedback.RequisitionNumber,\n      RequisitionId: feedback.RequisitionId || '',\n      CandidateName: feedback.CandidateName,\n      SubmissionId: feedback.SubmissionId,\n      StatusTypeCodeName: feedback.StatusTypeCodeName,\n      FeedbackRequestId: feedback.FeedbackRequestId,\n      QuestionnaireId: feedback.QuestionnaireId,\n      QuestionnaireResponseId:\n        feedback.questionnaireResponses &&\n        feedback.questionnaireResponses.items &&\n        feedback.questionnaireResponses.items.length > 0\n          ? feedback.questionnaireResponses.items[0].QuestionnaireResponseId\n          : null,\n      AverageRating: feedback.AverageFeedbackRating || '',\n      TotalScore: feedback.TotalScore || '',\n      MaximumPossibleScore: feedback.MaximumPossibleScore || '',\n      ParticipantName: feedback.ParticipantName,\n      ParticipantPersonId: feedback.ParticipantId\n    };\n    var status = feedback.StatusTypeCode;\n    var reqKey = feedback.RequisitionNumber || 'Unknown';\n    if (groups[status]) {\n      if (!groups[status][reqKey]) {\n        groups[status][reqKey] = [];\n      }\n      groups[status][reqKey].push(mappedItem);\n    }\n  }\n}\nvar categories = ['ORA_COMPLETED', 'ORA_REQUESTED', 'ORA_SAVED'];\nvar finalOutput = {\n  completed: [],\n  requested: [],\n  saved: []\n};\nvar mapStatusToKey = {\n  ORA_COMPLETED: 'completed',\n  ORA_REQUESTED: 'requested',\n  ORA_SAVED: 'saved'\n};\nfor (var categoryIndex = 0; categoryIndex < categories.length; categoryIndex += 1) {\n  var category = categories[categoryIndex];\n  var outputKey = mapStatusToKey[category];\n  var categoryGroups = groups[category];\n  var requisitionKeys = Object.keys(categoryGroups);\n  var hasMore = true;\n  while (finalOutput[outputKey].length < 30 && hasMore) {\n    hasMore = false;\n    for (var reqIndex = 0; reqIndex < requisitionKeys.length; reqIndex += 1) {\n      var requisitionKey = requisitionKeys[reqIndex];\n      if (categoryGroups[requisitionKey].length > 0) {\n        finalOutput[outputKey].push(categoryGroups[requisitionKey].shift());\n        hasMore = true;\n        if (finalOutput[outputKey].length === 30) {\n          break;\n        }\n      }\n    }\n  }\n}\nreturn finalOutput;"
          },
          "outcomes": {
            "success": "1773000000005"
          },
          "code": "PROCESS_FEEDBACKS",
          "id": "1773000000004",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "UNIQUE_COMPLETED_SUBMISSIONS",
            "returnType": "array",
            "sourceCode": "var completedFeedbacks = ($context.$nodes.PROCESS_FEEDBACKS.$output.result || {}).completed || [];\nvar seen = {};\nvar submissions = [];\nfor (var i = 0; i < completedFeedbacks.length; i += 1) {\n  var item = completedFeedbacks[i] || {};\n  var submissionId = item.SubmissionId;\n  if (!submissionId || seen[submissionId]) {\n    continue;\n  }\n  seen[submissionId] = true;\n  submissions.push({\n    SubmissionId: submissionId,\n    RequisitionId: item.RequisitionId || '',\n    RequisitionNumber: item.RequisitionNumber || '',\n    RequisitionTitle: item.RequisitionTitle || ''\n  });\n}\nreturn submissions;"
          },
