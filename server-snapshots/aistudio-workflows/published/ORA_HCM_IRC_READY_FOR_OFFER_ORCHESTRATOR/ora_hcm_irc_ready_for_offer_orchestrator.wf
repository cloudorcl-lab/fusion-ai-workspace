                {
                  "metadata": {
                    "name": "PROCESS_APPLICATION_DETAIL",
                    "returnType": "object",
                    "sourceCode": "function parseValue(value) {\n  if (typeof value === 'string') {\n    try {\n      return JSON.parse(value);\n    } catch (error) {\n      return value;\n    }\n  }\n  return value;\n}\nfunction asText(value) {\n  return value === undefined || value === null ? '' : String(value).trim();\n}\nfunction pick(source, keys) {\n  if (!source || typeof source !== 'object') {\n    return null;\n  }\n  for (var i = 0; i < keys.length; i += 1) {\n    var value = source[keys[i]];\n    if (value !== undefined && value !== null && value !== '') {\n      return value;\n    }\n  }\n  return null;\n}\nfunction asArray(value) {\n  var parsed = parseValue(value);\n  if (Array.isArray(parsed)) {\n    return parsed;\n  }\n  if (parsed && Array.isArray(parsed.items)) {\n    return parsed.items;\n  }\n  if (parsed && parsed.result && Array.isArray(parsed.result.items)) {\n    return parsed.result.items;\n  }\n  if (parsed && parsed.body && Array.isArray(parsed.body.items)) {\n    return parsed.body.items;\n  }\n  return [];\n}\nfunction normalize(value) {\n  return asText(value).toLowerCase().replace(/[^a-z0-9]+/g, '');\n}\nfunction boolish(value, defaultValue) {\n  if (value === undefined || value === null || value === '') {\n    return defaultValue;\n  }\n  if (typeof value === 'boolean') {\n    return value;\n  }\n  var text = String(value).trim().toLowerCase();\n  if (text === 'true' || text === 'y' || text === 'yes' || text === '1') {\n    return true;\n  }\n  if (text === 'false' || text === 'n' || text === 'no' || text === '0') {\n    return false;\n  }\n  return defaultValue;\n}\nfunction stateItems(phase) {\n  if (!phase || typeof phase !== 'object') {\n    return [];\n  }\n  if (phase.States && Array.isArray(phase.States.items)) {\n    return phase.States.items;\n  }\n  if (Array.isArray(phase.States)) {\n    return phase.States;\n  }\n  return [];\n}\n\nfunction stateSignal(state) {\n  return normalize(pick(state, ['StateCode', 'stateCode', 'Code', 'code'])) + ' ' +\n    normalize(pick(state, ['StateName', 'stateName', 'Name', 'name']));\n}\n\nfunction isTerminalState(state) {\n  if (state && (state.IsTerminalStateFlag === true || state.isTerminalStateFlag === true)) {\n    return true;\n  }\n  var terminalText = asText(state ? pick(state, ['IsTerminalStateFlag', 'isTerminalStateFlag']) : '').toLowerCase();\n  if (terminalText === 'true' || terminalText === 'y' || terminalText === 'yes' || terminalText === '1') {\n    return true;\n  }\n  var signal = stateSignal(state);\n  return signal.indexOf('withdraw') >= 0 ||\n    signal.indexOf('reject') >= 0 ||\n    signal.indexOf('disqualif') >= 0 ||\n    signal.indexOf('declin') >= 0 ||\n    signal.indexOf('inactive') >= 0 ||\n    signal.indexOf('deleted') >= 0 ||\n    signal.indexOf('notselected') >= 0;\n}\n\nfunction isOfferReadyState(state) {\n  var signal = stateSignal(state);\n  var hasOffer = signal.indexOf('offer') >= 0;\n  var isReady = signal.indexOf('select') >= 0 ||\n    signal.indexOf('ready') >= 0 ||\n    signal.indexOf('recommend') >= 0 ||\n    signal.indexOf('approve') >= 0;\n  return hasOffer && isReady;\n}\n\nfunction choosePreOfferState(states) {\n  for (var stateIndex = 0; stateIndex < states.length; stateIndex += 1) {\n    var state = states[stateIndex] || {};\n    if (isOfferReadyState(state) && !isTerminalState(state)) {\n      return state;\n    }\n  }\n  for (var offerStateIndex = 0; offerStateIndex < states.length; offerStateIndex += 1) {\n    var offerState = states[offerStateIndex] || {};\n    if (stateSignal(offerState).indexOf('offer') >= 0 && !isTerminalState(offerState)) {\n      return offerState;\n    }\n  }\n  for (var fallbackIndex = states.length - 1; fallbackIndex >= 0; fallbackIndex -= 1) {\n    var fallbackState = states[fallbackIndex] || {};\n    if (!isTerminalState(fallbackState)) {\n      return fallbackState;\n    }\n  }\n  return states.length > 0 ? states[states.length - 1] : null;\n}\n\nvar currentItem = $context.$nodes.APPLICATION_DETAILS_LOOP.$currentItem || {};\nvar applicationRaw = parseValue($context.$nodes.APPLICATION_DETAILS_LOOP.FETCH_JOB_APPLICATION_SUMMARY.$output);\nvar application = null;\nif (applicationRaw && typeof applicationRaw === 'object') {\n  if (Array.isArray(applicationRaw.items) && applicationRaw.items.length > 0) {\n    application = applicationRaw.items[0];\n  } else if (applicationRaw.result && Array.isArray(applicationRaw.result.items) && applicationRaw.result.items.length > 0) {\n    application = applicationRaw.result.items[0];\n  } else if (applicationRaw.body && typeof applicationRaw.body === 'object') {\n    application = applicationRaw.body;\n  } else if (applicationRaw.result && typeof applicationRaw.result === 'object' && !Array.isArray(applicationRaw.result)) {\n    application = applicationRaw.result;\n  } else {\n    application = applicationRaw;\n  }\n}\n\nvar phases = asArray($context.$nodes.APPLICATION_DETAILS_LOOP.FETCH_JOB_APPLICATION_PHASES.$output);\nvar currentPhaseId = asText(pick(application, ['CurrentPhaseId', 'currentPhaseId', 'phaseId']));\nvar currentStateId = asText(pick(application, ['CurrentStateId', 'currentStateId', 'stateId']));\nvar currentPhaseName = asText(pick(application, ['CurrentPhaseName', 'currentPhaseName', 'phaseName']));\nvar currentStateName = asText(pick(application, ['CurrentStateName', 'currentStateName', 'stateName']));\nvar activeFlag = boolish(pick(application, ['ActiveFlag', 'activeFlag']), true);\nvar disqualifiedFlag = boolish(pick(application, ['DisqualifiedFlag', 'disqualifiedFlag']), false);\nvar requisitionId = asText(pick(application, ['RequisitionId', 'requisitionId'])) || asText(currentItem.RequisitionId);\nvar candidateName =\n  asText(\n    pick(application, [\n      'EmployeeDisplayName',\n      'employeeDisplayName',\n      'CandidateName',\n      'candidateName',\n      'DisplayName',\n      'displayName'\n    ])\n  ) || asText(currentItem.CandidateName || currentItem.candidateName);\n\nvar currentPhaseIndex = -1;\nfor (var phaseIndex = 0; phaseIndex < phases.length; phaseIndex += 1) {\n  var phaseCandidate = phases[phaseIndex] || {};\n  if (asText(phaseCandidate.PhaseId || phaseCandidate.phaseId) === currentPhaseId) {\n    currentPhaseIndex = phaseIndex;\n    break;\n  }\n}\nif (currentPhaseIndex === -1 && currentPhaseName) {\n  for (var phaseIndexByName = 0; phaseIndexByName < phases.length; phaseIndexByName += 1) {\n    var phaseByName = phases[phaseIndexByName] || {};\n    if (normalize(phaseByName.PhaseName || phaseByName.phaseName) === normalize(currentPhaseName)) {\n      currentPhaseIndex = phaseIndexByName;\n      break;\n    }\n  }\n}\n\nvar offerPhaseIndex = -1;\nfor (var offerIndex = 0; offerIndex < phases.length; offerIndex += 1) {\n  var offerPhaseCandidate = phases[offerIndex] || {};\n  var offerPhaseCode = normalize(offerPhaseCandidate.PhaseCode || offerPhaseCandidate.phaseCode);\n  var offerPhaseName = normalize(offerPhaseCandidate.PhaseName || offerPhaseCandidate.phaseName);\n  if (offerPhaseCode === 'offer' || offerPhaseName === 'offer' || offerPhaseCode.indexOf('offer') === 0 || offerPhaseName.indexOf('offer') === 0) {\n    offerPhaseIndex = offerIndex;\n    break;\n  }\n}\n\nvar offerPhase = offerPhaseIndex >= 0 ? phases[offerPhaseIndex] : null;\nvar offerStateItems = stateItems(offerPhase);\nvar targetOfferState = null;\nfor (var stateIndex = 0; stateIndex < offerStateItems.length; stateIndex += 1) {\n  var stateCandidate = offerStateItems[stateIndex] || {};\n  var stateCode = normalize(stateCandidate.StateCode || stateCandidate.stateCode);\n  var stateName = normalize(stateCandidate.StateName || stateCandidate.stateName);\n  if (stateCode === 'tobecreated' || stateName === 'tobecreated' || stateCode.indexOf('tobecreated') >= 0 || stateName.indexOf('tobecreated') >= 0) {\n    targetOfferState = stateCandidate;\n    break;\n  }\n}\nif (!targetOfferState && offerStateItems.length > 0) {\n  targetOfferState = offerStateItems[0];\n}\n\nvar currentPhase = currentPhaseIndex >= 0 ? phases[currentPhaseIndex] : null;\nvar currentStates = stateItems(currentPhase);\nvar currentStateCode = '';\nfor (var currentStateIndex = 0; currentStateIndex < currentStates.length; currentStateIndex += 1) {\n  var currentStateCandidate = currentStates[currentStateIndex] || {};\n  if (asText(currentStateCandidate.StateId || currentStateCandidate.stateId) === currentStateId) {\n    currentStateCode = asText(currentStateCandidate.StateCode || currentStateCandidate.stateCode);\n    break;\n  }\n}\nif (!currentStateCode) {\n  currentStateCode = currentStateName;\n}\n\nvar statusSignals = [\n  normalize(currentPhase ? currentPhase.PhaseCode || currentPhase.phaseCode : ''),\n  normalize(currentPhaseName),\n  normalize(currentStateCode),\n  normalize(currentStateName)\n];\nvar rejectedLike = false;\nfor (var signalIndex = 0; signalIndex < statusSignals.length; signalIndex += 1) {\n  var signal = statusSignals[signalIndex];\n  if (!signal) {\n    continue;\n  }\n  if (signal.indexOf('reject') >= 0 || signal.indexOf('withdraw') >= 0 || signal.indexOf('disqualif') >= 0) {\n    rejectedLike = true;\n    break;\n  }\n}\n\nvar previousOfferPhase = currentPhase;\nvar nextPhase = currentPhaseIndex >= 0 && currentPhaseIndex + 1 < phases.length ? phases[currentPhaseIndex + 1] : null;\nvar nextPhaseId = asText(nextPhase ? nextPhase.PhaseId || nextPhase.phaseId : '');\nvar nextPhaseName = asText(nextPhase ? nextPhase.PhaseName || nextPhase.phaseName : '');\nvar nextPhaseCode = asText(nextPhase ? nextPhase.PhaseCode || nextPhase.phaseCode : '');\nvar nextPhaseKey = normalize(nextPhaseCode) + ' ' + normalize(nextPhaseName);\nvar nextPhaseIsOffer = !!nextPhase && nextPhaseKey.indexOf('offer') >= 0;\nvar effectivePreOfferStateId = currentStateId;\nvar effectivePreOfferStateName = currentStateName;\nvar effectivePreOfferStateCode = currentStateCode;\nvar beforeOffer = offerPhaseIndex >= 0 && currentPhaseIndex >= 0 && currentPhaseIndex < offerPhaseIndex;\nvar immediateBeforeOffer = nextPhaseIsOffer;\nvar alreadyInOffer = offerPhaseIndex >= 0 && currentPhaseIndex === offerPhaseIndex;\nvar alreadyPastOffer = offerPhaseIndex >= 0 && currentPhaseIndex > offerPhaseIndex;\n\nvar blockingReason = '';\nif (!application) {\n  blockingReason = 'Missing job application detail';\n} else if (!phases.length) {\n  blockingReason = 'Missing job application phase graph';\n} else if (currentPhaseIndex < 0) {\n  blockingReason = 'Current phase not found in phase graph';\n} else if (!activeFlag) {\n  blockingReason = 'Candidate is inactive';\n} else if (disqualifiedFlag) {\n  blockingReason = 'Candidate is disqualified';\n} else if (rejectedLike) {\n  blockingReason = 'Candidate is withdrawn or rejected';\n} else if (alreadyInOffer) {\n  blockingReason = 'Candidate is already in offer';\n} else if (alreadyPastOffer) {\n  blockingReason = 'Candidate is already past offer';\n} else if (!nextPhase) {\n  blockingReason = 'Next phase not found';\n} else if (!nextPhaseIsOffer) {\n  blockingReason = 'Next immediate phase is not Offer';\n}\n\nvar widgetEligibilityReason = blockingReason;\nif (!widgetEligibilityReason && !immediateBeforeOffer) {\n  widgetEligibilityReason = 'Next immediate phase is not Offer';\n}\n\nvar moveEligibilityReason = blockingReason;\nif (!moveEligibilityReason && !immediateBeforeOffer) {\n  moveEligibilityReason = 'Next immediate phase is not Offer';\n}\n\nvar result = {\n  SubmissionId: asText(currentItem.SubmissionId),\n  RequisitionId: requisitionId,\n  CandidateName: candidateName,\n  CurrentPhaseId: currentPhaseId,\n  CurrentPhaseName: currentPhaseName,\n  CurrentStateId: currentStateId,\n  CurrentStateName: currentStateName,\n  OfferPhaseId: asText(offerPhase ? offerPhase.PhaseId || offerPhase.phaseId : ''),\n  OfferPhaseName: asText(offerPhase ? offerPhase.PhaseName || offerPhase.phaseName : ''),\n  OfferPhaseCode: asText(offerPhase ? offerPhase.PhaseCode || offerPhase.phaseCode : ''),\n  OfferStateId: asText(targetOfferState ? targetOfferState.StateId || targetOfferState.stateId : ''),\n  OfferStateName: asText(targetOfferState ? targetOfferState.StateName || targetOfferState.stateName : ''),\n  OfferStateCode: asText(targetOfferState ? targetOfferState.StateCode || targetOfferState.stateCode : ''),\n  NextPhaseId: nextPhaseId,\n  NextPhaseName: nextPhaseName,\n  NextPhaseCode: nextPhaseCode,\n  NextPhaseIsOffer: nextPhaseIsOffer,\n  PreviousOfferPhaseId: asText(previousOfferPhase ? previousOfferPhase.PhaseId || previousOfferPhase.phaseId : ''),\n  PreviousOfferPhaseName: asText(previousOfferPhase ? previousOfferPhase.PhaseName || previousOfferPhase.phaseName : ''),\n  PreOfferStateId: effectivePreOfferStateId,\n  PreOfferStateName: effectivePreOfferStateName,\n  PreOfferStateCode: effectivePreOfferStateCode,\n  ActiveFlag: activeFlag,\n  DisqualifiedFlag: disqualifiedFlag,\n  BeforeOffer: blockingReason === '' && beforeOffer,\n  ImmediateBeforeOffer: blockingReason === '' && immediateBeforeOffer,\n  EligibleForWidget: widgetEligibilityReason === '',\n  WidgetEligibilityReason: widgetEligibilityReason,\n  EligibleForOffer: moveEligibilityReason === '',\n  EligibilityReason: moveEligibilityReason\n};\nreturn result;\n"
