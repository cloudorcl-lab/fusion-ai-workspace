                    "returnType": "object",
                    "sourceCode": "var currentItem = $context.$nodes.FEEDBACK_QUESTIONAIRE_LOOP.$currentItem || {};\nvar response = $context.$nodes.FEEDBACK_QUESTIONAIRE_LOOP.FEEDBACK_QUESTIONAIRE.$output || {};\nvar questionnaireResponseId =\n  response &&\n  response.components &&\n  response.components.schemas &&\n  response.components.schemas.Questionnaire &&\n  response.components.schemas.Questionnaire['x-hints']\n    ? response.components.schemas.Questionnaire['x-hints'].questionnaireResponseId\n    : null;\nvar sections =\n  response &&\n  response.components &&\n  response.components.schemas &&\n  response.components.schemas.Questionnaire &&\n  response.components.schemas.Questionnaire['x-hints'] &&\n  Array.isArray(response.components.schemas.Questionnaire['x-hints'].sections)\n    ? response.components.schemas.Questionnaire['x-hints'].sections\n    : [];\nvar questionAnswer = [];\nfor (var sectionIndex = 0; sectionIndex < sections.length; sectionIndex += 1) {\n  var section = sections[sectionIndex] || {};\n  var questions = Array.isArray(section.questions) ? section.questions : [];\n  for (var questionIndex = 0; questionIndex < questions.length; questionIndex += 1) {\n    var question = questions[questionIndex] || {};\n    var answer = '';\n    if (question.renderType === 'PLAIN_TEXT') {\n      answer = question.textAnswer || '';\n    } else if (question.renderType === 'SINGLE_CHOICE_LIST') {\n      var chosenCode =\n        question.questionAnswerCode ||\n        (Array.isArray(question.questionAnswerCodes) &&\n        question.questionAnswerCodes.length > 0\n          ? question.questionAnswerCodes[0]\n          : null);\n      if (chosenCode && Array.isArray(question.availableAnswers)) {\n        for (var answerIndex = 0; answerIndex < question.availableAnswers.length; answerIndex += 1) {\n          var availableAnswer = question.availableAnswers[answerIndex] || {};\n          if (availableAnswer.answerCode === chosenCode) {\n            answer = availableAnswer.answerLabel || '';\n            break;\n          }\n        }\n      }\n    } else if (question.renderType === 'MULTIPLE_CHOICE_CHECK') {\n      var labels = [];\n      var codes = Array.isArray(question.questionAnswerCodes) ? question.questionAnswerCodes : [];\n      for (var codeIndex = 0; codeIndex < codes.length; codeIndex += 1) {\n        var code = codes[codeIndex];\n        if (!Array.isArray(question.availableAnswers)) {\n          continue;\n        }\n        for (var availableIndex = 0; availableIndex < question.availableAnswers.length; availableIndex += 1) {\n          var option = question.availableAnswers[availableIndex] || {};\n          if (option.answerCode === code && option.answerLabel) {\n            labels.push(option.answerLabel);\n            break;\n          }\n        }\n      }\n      answer = labels.join(', ');\n    }\n    questionAnswer.push({\n      question: question.title || '',\n      answer: answer\n    });\n  }\n}\nvar totalScore = Number(currentItem.TotalScore || 0);\nvar maximumPossibleScore = Number(currentItem.MaximumPossibleScore || 0);\nvar normalizedQuestionnaireScore = maximumPossibleScore > 0 ? totalScore / maximumPossibleScore : null;\nreturn Object.assign({}, currentItem, {\n  QuestionnaireResponseId: questionnaireResponseId,\n  Responses: questionAnswer,\n  NormalizedQuestionnaireScore: normalizedQuestionnaireScore\n});"
