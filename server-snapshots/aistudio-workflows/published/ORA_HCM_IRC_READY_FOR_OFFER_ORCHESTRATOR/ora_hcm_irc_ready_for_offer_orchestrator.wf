        {
          "metadata": {
            "name": "CountParticipant",
            "returnType": "object",
            "sourceCode": "const data = $context.$variables.feedbacks;\n\nconst keyMap = { Requested: 'Pending', Saved: 'InProgress', Completed: 'Completed' };\nconst statusTypes = ['Requested', 'Saved', 'Completed'];\nconst displayTypes = ['Pending', 'InProgress', 'Completed'];\n\nconst feedbacks = [\n  ...(data.requested || []),\n  ...(data.saved || []),\n  ...(data.completed || [])\n];\n\nconst summaryMap = {};\n\nfeedbacks.forEach(item => {\n  const { ParticipantName, StatusTypeCodeName } = item;\n  const displayKey = keyMap[StatusTypeCodeName];\n  if (!summaryMap[ParticipantName]) {\n    summaryMap[ParticipantName] = { ParticipantName };\n    displayTypes.forEach(type => summaryMap[ParticipantName][type] = 0);\n  }\n  summaryMap[ParticipantName][displayKey] += 1;\n});\n\nreturn summaryMap;"
          },
