                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "Add Employees To Skill",
                    "returnType": "object",
                    "sourceCode": "var acc = $context.$variables.employeesRecommendedSkills;\nif (!Array.isArray(acc)) acc = [];\n\nvar currentSkill = $context.$nodes.FOR_EACH_TOP_SKILL.$currentItem;\nvar currentEmployeeResult = $context.$nodes.FOR_EACH_TOP_SKILL.PARSE_EMPLOYEE_NAMES.$output.result;\nvar currentEmployeeItems = currentEmployeeResult && Array.isArray(currentEmployeeResult.recipientNames) ? currentEmployeeResult.recipientNames : [];\nvar skillId = currentSkill && currentSkill.skillId != null ? String(currentSkill.skillId) : '';\nvar skillTitle = currentSkill && typeof currentSkill.skillTitle === 'string' ? currentSkill.skillTitle : '';\nvar orgRecommendationCount = currentSkill && isFinite(currentSkill.orgRecommendationCount) ? Number(currentSkill.orgRecommendationCount) : 0;\nvar directCount = currentEmployeeItems.length;\n\nif (skillId && skillTitle) {\n  var idx = -1;\n  for (var i = 0; i < acc.length; i++) {\n    if (acc[i] && acc[i].skillId === skillId) { idx = i; break; }\n  }\n  var nextRow = { skillId: skillId, skillTitle: skillTitle, count: directCount, orgRecommendationCount: orgRecommendationCount, employees: currentEmployeeItems.slice() };\n  if (idx === -1) acc.push(nextRow); else acc[idx] = nextRow;\n}\nreturn acc;"
                  },
                  "outcomes": {
                    "success": "1770747543569"
                  },
                  "code": "ADD_EMPLOYEES_TO_SKILL",
                  "id": "1770747384145",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"skillId\": {\n            \"type\": \"string\"\n          },\n          \"skillTitle\": {\n            \"type\": \"string\"\n          },\n          \"count\": {\n            \"type\": \"number\"\n          },\n          \"employees\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          }\n        },\n        \"required\": [\n          \"skillId\",\n          \"skillTitle\",\n          \"count\",\n          \"employees\"\n        ]\n      }\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
