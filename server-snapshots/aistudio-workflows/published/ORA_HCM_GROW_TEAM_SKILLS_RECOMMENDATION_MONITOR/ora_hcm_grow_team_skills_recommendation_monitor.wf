            "name": "Set Hint",
            "returnType": "string",
            "sourceCode": "let hint = $context && $context.$app ? $context.$app.$OraMessageHint : null;\nconst message = $context && $context.$system && $context.$system.$inputMessage != null ? String($context.$system.$inputMessage).trim() : '';\nif (hint === \"InitDisplay\" || (hint == null && !message)) {\n  hint = \"Init\";\n} else if (hint == null && message) {\n  hint = \"Query\";\n}\nlet result = hint;\nreturn result;"
          },
          "outcomes": {
            "success": "1770681373250"
          },
          "code": "SET_HINT",
          "id": "1770681334179",
          "inputs": [],
