                },
                {
                  "metadata": {
                    "name": "Return Result",
                    "returnType": "object",
                    "sourceCode": "var result = $context.$variables.employeesRecommendedSkills;\nif (!Array.isArray(result)) result = [];\nreturn result;"
                  },
                  "outcomes": {
                    "success": "end_1770745559368"
                  },
                  "code": "RETURN_RESULT",
                  "id": "1770747572622",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"skillId\": {\n            \"type\": \"string\"\n          },\n          \"skillTitle\": {\n            \"type\": \"string\"\n          },\n          \"count\": {\n            \"type\": \"number\"\n          },\n          \"employees\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          }\n        },\n        \"required\": [\n          \"skillId\",\n          \"skillTitle\",\n          \"count\",\n          \"employees\"\n        ]\n      }\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "Prepare Recipient Names",
                    "returnType": "object",
                    "sourceCode": "const items = $context.$nodes.FOR_EACH_TOP_SKILL.GET_EMPLOYEES_RECOMMENDATIONS.$output.items;\nconst directContext = $context.$nodes.PREPARE_DIRECT_REPORT_FILTER.$output.result || {};\nconst directNameKeys = Array.isArray(directContext.directNameKeys) ? directContext.directNameKeys : [];\nconst directPersonIds = Array.isArray(directContext.directPersonIds) ? directContext.directPersonIds.map((id) => String(id)) : [];\nconst directNameLookup = {};\nconst directPersonLookup = {};\n\nfor (let index = 0; index < directNameKeys.length; index += 1) directNameLookup[String(directNameKeys[index])] = true;\nfor (let index = 0; index < directPersonIds.length; index += 1) directPersonLookup[String(directPersonIds[index])] = true;\n\nfunction clean(value) { return value == null ? '' : String(value).trim(); }\nfunction normalize(value) { return clean(value).toLocaleLowerCase().replace(/\\s+/g, ' '); }\nfunction firstValue(item, keys) {\n  for (let index = 0; index < keys.length; index += 1) {\n    const value = item && item[keys[index]];\n    if (value !== undefined && value !== null && String(value).trim() !== '') return String(value).trim();\n  }\n  return '';\n}\n\nconst byKey = {};\nif (Array.isArray(items)) {\n  for (let index = 0; index < items.length; index += 1) {\n    const item = items[index] || {};\n    const rawName = firstValue(item, ['DisplayName', 'displayName', 'PersonName', 'personName']);\n    const personId = firstValue(item, ['PersonId', 'personId', 'WorkerId', 'workerId', 'SourceId', 'sourceId']);\n    const nameKey = normalize(rawName);\n    const isDirect = (personId && directPersonLookup[personId]) || (nameKey && directNameLookup[nameKey]);\n    if (!rawName || !isDirect) continue;\n    if (byKey[nameKey] == null) byKey[nameKey] = rawName;\n  }\n}\nconst recipientNames = Object.keys(byKey).map((key) => byKey[key]);\nrecipientNames.sort((left, right) => left.localeCompare(right));\nconst result = { recipientNames: recipientNames };\nreturn result;"
                  },
                  "outcomes": {
                    "success": "1770747384145"
                  },
                  "code": "PARSE_EMPLOYEE_NAMES",
                  "id": "1770769681096",
                  "inputs": [],
