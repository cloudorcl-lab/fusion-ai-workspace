        },
        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_MYTEAM",
            "functionName": "search_for_directs",
            "name": "Fetch My Team Directs"
          },
          "outcomes": {
            "success": "1773000000002"
          },
          "code": "FETCH_MY_TEAM_DIRECTS",
          "id": "1773000000001",
          "inputs": [],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Prepare Direct Report Filter",
            "returnType": "object",
            "sourceCode": "const response = $context.$nodes.FETCH_MY_TEAM_DIRECTS.$output;\n\nfunction extractItems(value) {\n  if (Array.isArray(value && value.items)) return value.items;\n  if (Array.isArray(value)) return value;\n  if (Array.isArray(value && value.result)) return value.result;\n  return [];\n}\n\nfunction clean(value) {\n  return value == null ? '' : String(value).trim();\n}\n\nfunction normalize(value) {\n  return clean(value).toLocaleLowerCase().replace(/\\s+/g, ' ');\n}\n\nconst directItems = extractItems(response);\nconst directReports = [];\nconst directNameKeys = [];\nconst directPersonIds = [];\nconst seenNameKeys = {};\nconst seenPersonIds = {};\n\nfor (let index = 0; index < directItems.length; index += 1) {\n  const item = directItems[index] || {};\n  const displayName = clean(item.DisplayName || item.displayName || item.PersonName || item.personName || item.FullName || item.fullName);\n  const personId = clean(item.PersonId || item.personId || item.WorkerId || item.workerId);\n  const nameKey = normalize(displayName);\n\n  if (nameKey && seenNameKeys[nameKey] == null) {\n    seenNameKeys[nameKey] = true;\n    directNameKeys.push(nameKey);\n  }\n  if (personId && seenPersonIds[personId] == null) {\n    seenPersonIds[personId] = true;\n    directPersonIds.push(personId);\n  }\n  if (nameKey || personId) {\n    directReports.push({ personId: personId, displayName: displayName, nameKey: nameKey });\n  }\n}\n\nconst result = {\n  directReports: directReports,\n  directNameKeys: directNameKeys,\n  directPersonIds: directPersonIds,\n  totalDirectReports: directReports.length\n};\nreturn result;"
          },
          "outcomes": {
            "success": "1770339601954"
          },
          "code": "PREPARE_DIRECT_REPORT_FILTER",
          "id": "1773000000002",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Prepare Direct Skills Display",
            "returnType": "object",
            "sourceCode": "let rows = $context.$variables.employeesRecommendedSkills;\nif (!Array.isArray(rows)) {\n  rows = [];\n}\n\nlet maxSkills = Number($context.$variables.maxSkills);\nif (!Number.isInteger(maxSkills) || maxSkills <= 0) {\n  maxSkills = 5;\n}\n\nconst candidates = [];\nfor (let index = 0; index < rows.length; index += 1) {\n  const row = rows[index] || {};\n  const skillId = row.skillId == null ? '' : String(row.skillId).trim();\n  const skillTitle = typeof row.skillTitle === 'string' ? row.skillTitle.trim() : '';\n  const employees = Array.isArray(row.employees) ? row.employees.slice() : [];\n  const count = employees.length;\n  if (!skillId || !skillTitle || count <= 0) {\n    continue;\n  }\n  candidates.push({ skillId: skillId, skillTitle: skillTitle, count: count, orgRecommendationCount: Number(row.orgRecommendationCount || 0), employees: employees });\n}\n\ncandidates.sort((left, right) => {\n  if (right.count !== left.count) return right.count - left.count;\n  return left.skillTitle.localeCompare(right.skillTitle);\n});\n\nconst finalRows = candidates.slice(0, maxSkills);\nfor (let rowIndex = 0; rowIndex < finalRows.length; rowIndex += 1) {\n  finalRows[rowIndex].displayOrder = rowIndex + 1;\n}\n\nconst directContext = $context.$nodes.PREPARE_DIRECT_REPORT_FILTER.$output.result || {};\nconst result = {\n  rows: finalRows,\n  totalSkills: finalRows.length,\n  totalDirectReports: Number(directContext.totalDirectReports || 0),\n  asOfDate: $context.$system.$currentDate\n};\nreturn result;"
          },
          "outcomes": {
            "success": "1770681334179"
          },
          "code": "PREPARE_DIRECT_SKILLS_DISPLAY",
          "id": "1773000000003",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
