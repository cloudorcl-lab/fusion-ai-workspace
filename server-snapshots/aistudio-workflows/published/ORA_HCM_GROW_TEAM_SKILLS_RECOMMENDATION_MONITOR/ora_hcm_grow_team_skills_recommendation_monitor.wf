        {
          "metadata": {
            "name": "Prepare Top Recommended Skills",
            "returnType": "object",
            "sourceCode": "const facets = $context.$nodes.GET_RECOMMENDED_SKILLS.$output.facets;\nlet facetValues = [];\nif (Array.isArray(facets)) {\n  for (let facetIndex = 0; facetIndex < facets.length; facetIndex += 1) {\n    const facet = facets[facetIndex];\n    if (facet && facet.name === \"objectTitle\" && Array.isArray(facet.values)) {\n      facetValues = facet.values;\n      break;\n    }\n  }\n}\nif (!Array.isArray(facetValues) && Array.isArray($context.$nodes.GET_RECOMMENDED_SKILLS.$output.facets) && $context.$nodes.GET_RECOMMENDED_SKILLS.$output.facets[0] && Array.isArray($context.$nodes.GET_RECOMMENDED_SKILLS.$output.facets[0].values)) {\n  facetValues = $context.$nodes.GET_RECOMMENDED_SKILLS.$output.facets[0].values;\n}\nlet parsedLimit = Number($context.$variables.maxCandidateSkills);\nif (!Number.isInteger(parsedLimit) || parsedLimit <= 0) {\n  parsedLimit = 25;\n}\nconst rows = [];\nfor (let index = 0; index < facetValues.length && rows.length < parsedLimit; index += 1) {\n  const entry = facetValues[index] || {};\n  const skillId = entry.value == null ? \"\" : String(entry.value).trim();\n  const skillTitle = typeof entry.displayValue === \"string\" ? entry.displayValue.trim() : \"\";\n  const countValue = Number(entry.count);\n  const orgRecommendationCount = Number.isFinite(countValue) && countValue >= 0 ? countValue : 0;\n  if (!skillId || !skillTitle) continue;\n  rows.push({ skillId: skillId, skillTitle: skillTitle, count: 0, orgRecommendationCount: orgRecommendationCount });\n}\nconst result = { rows: rows, totalSkills: rows.length, asOfDate: $context.$system.$currentDate };\nreturn result;"
          },
          "outcomes": {
            "success": "1770745559368"
          },
          "code": "PARSE_TOP_SKILLS",
