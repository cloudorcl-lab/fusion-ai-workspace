          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"rows\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"skillId\": {\n                \"type\": \"string\"\n              },\n              \"skillTitle\": {\n                \"type\": \"string\"\n              },\n              \"count\": {\n                \"type\": \"number\"\n              }\n            },\n            \"required\": [\n              \"skillId\",\n              \"skillTitle\",\n              \"count\"\n            ]\n          }\n        },\n        \"totalSkills\": {\n          \"type\": \"integer\"\n        },\n        \"asOfDate\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"rows\",\n        \"totalSkills\",\n        \"asOfDate\"\n      ]\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
