        {
          "metadata": {
            "name": "Expected Shipments Prepare Request",
            "returnType": "object",
            "sourceCode": "let parameters = $context.$variables.parameters;\n\n \n\n\nlet expectedShipmentsRequest = {\n  \"size\": 1,\n  \"query\": {\n    \"bool\": {\n      \"must\": [\n        {\n          \"term\": {\n            \"DocumentNumber.raw\":  parameters.documentNumber\n          }\n        },\n        {\n          \"term\": {\n            \"OrderLine.LineNumber.raw\": parameters.lineNumber\n          }\n        },\n        {\n          \"term\": {\n            \"SourceDocumentCode.raw\":  parameters.documentType\n          }\n        }\n      ]\n    }\n  },\n  \"sort\": [\n    {\n      \"PromisedDate\": {\n        \"order\": \"asc\"\n      }\n    }\n  ]\n};\n\n\nlet retPayload = {};\n\n\n\nretPayload.expectedShipmentsRequest= expectedShipmentsRequest ;\n\n\n\nif(parameters?.documentIdentifier){\n\nretPayload.isFromShortSupply= true;\n}\nelse\n{\nretPayload.isFromShortSupply= false;\n}\n\n//retPayload.parameters=parameters;\n\n\nreturn retPayload;"
          },
          "outcomes": {
            "success": "1771650822441"
          },
          "code": "EXPECTED_SHIPMENTS_PREPARE_REQUEST",
          "id": "1771650111150",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
