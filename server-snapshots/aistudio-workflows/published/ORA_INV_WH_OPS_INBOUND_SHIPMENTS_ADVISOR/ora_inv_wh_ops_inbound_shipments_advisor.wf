        {
          "metadata": {
            "name": "Prepare Request Payload",
            "returnType": "object",
            "sourceCode": "// Sample request - toBeRecievedPurchaseOrder.json\nconst expectedPoResponse =\n  $context.$nodes.EXPECTED_SHIPMENTS_GET_ORDER_DETAILS?.$output || null;\n\nconst parameters = $context.$variables.parameters || {};\n\nconst currentOrganizationId = $context.$variables.organizationId || {};\n\nconst emailAddress = $context.$nodes.SELF_DETAILS?.$output.items[0].EmailAddress;\n\nconst expectedPoLine = expectedPoResponse?.hits?.hits?.[0]?._source || null;\nconst distribution = expectedPoLine?.OrderDistributions?.[0] || null;\nconst item = expectedPoLine?.Item || null;\n\nconst now = new Date();\nconst batchNumber = `INV_${now.getTime()}`;\nconst referenceId = now.getTime();\nconst lineReferenceId = referenceId + 1;\n\nconst quantityOrdered = Number(\n  expectedPoLine?.QuantityOrdered ?? distribution?.QuantityOrdered ?? 0\n);\nconst quantityDelivered = Number(\n  expectedPoLine?.QuantityDelivered ?? distribution?.QuantityDelivered ?? 0\n);\nconst quantityCanceled = Number(\n  expectedPoLine?.QuantityCanceled ?? distribution?.QuantityCanceled ?? 0\n);\nconst computedQuantity = Math.max(\n  0,\n  quantityOrdered - quantityDelivered - quantityCanceled\n);\nconst quantity =\n  parameters.Quantity !== undefined && parameters.Quantity !== null\n    ? Number(parameters.Quantity)\n    : computedQuantity;\n\nconst remainingQuantity = Math.max(0, quantityOrdered - quantity);\nconst newQuantity =\n  parameters.NewQuantity !== undefined && parameters.NewQuantity !== null\n    ? Number(parameters.NewQuantity)\n    : remainingQuantity;\n\nconst projectId =\n  distribution?.ProjectId ??\n  distribution?.projectId ??\n  expectedPoLine?.ProjectId ??\n  expectedPoLine?.projectId;\nconst taskId =\n  distribution?.TaskId ??\n  distribution?.taskId ??\n  expectedPoLine?.TaskId ??\n  expectedPoLine?.taskId;\n\nconst distributionDetails =\n  projectId && taskId\n    ? [\n        {\n          DistributionNumber: distribution?.DistributionNumber ?? \"1\",\n          projectDFF: [\n            {\n              projectId: String(projectId),\n              taskId: String(taskId)\n            }\n          ]\n        }\n      ]\n    : undefined;\n\nlet response = {};\n\nconst supplyRequestLine = {\n  InterfaceBatchNumber: batchNumber,\n  SupplyOrderReferenceLineNumber: \"1\",\n  SupplyOrderReferenceLineId: lineReferenceId,\n  SourceOrganizationCode: parameters.sourceOrganization,\n  DestinationOrganizationId: currentOrganizationId ,\n  ItemNumber: item.ItemNumber,\n  InterfaceSourceCode: \"DOS\",\n  SupplyOrderSource: \"INV\",\n  BackToBackFlag: expectedPoLine?.BackToBackFlag ?? \"N\",\n  NeedByDate: (expectedPoLine?.PromisedDate || expectedPoLine?.NeedByDate),\n  Quantity: quantity,\n  ...(item?.PrimaryUomCode || expectedPoLine?.UomCode || expectedPoLine?.Uom?.UomCode\n    ? {\n        UOMCode:\n          item?.PrimaryUomCode ??\n          expectedPoLine?.UomCode ??\n          expectedPoLine?.Uom?.UomCode\n      }\n    : {}),\n  DeliverToRequesterEmail: emailAddress,\n  PreparerEmail: emailAddress,\n  DestinationTypeCode: \"INVENTORY\",\n  SupplyType: \"TRANSFER\",\n  ...(distributionDetails ? { distributionDetails } : {})\n};\n\nresponse.supplyRequest = {\n  InterfaceSourceCode: \"DOS\",\n  InterfaceBatchNumber: batchNumber,\n  SupplyRequestStatus: \"NEW\",\n  SupplyRequestDate: now.toISOString(),\n  SupplyOrderSource: \"INV\",\n  SupplyOrderReferenceNumber: batchNumber,\n  SupplyOrderReferenceId: referenceId,\n  TrustedSource: 1,\n  ProcessRequestFlag: \"Y\",\n  supplyRequestLines: [supplyRequestLine]\n};\n\nconst poHeaderId = expectedPoLine?.POHeaderId ?? expectedPoLine?.OrderHeader?.POHeaderId;\nconst poLineId = expectedPoLine?.POLineId ?? expectedPoLine?.OrderLine?.POLineId;\nconst poLineLocationId = expectedPoLine?.POLineLocationId ?? distribution?.POLineLocationId;\nconst poDistributionId = distribution?.PODistributionId;\nconst unitPrice = expectedPoLine?.OrderLine?.UnitPrice;\nconst lineNumber = expectedPoLine?.OrderLine?.LineNumberAsLong;\nconst assessableValue =\n  unitPrice !== undefined && unitPrice !== null\n    ? (Number(newQuantity) * Number(unitPrice)).toFixed(2)\n    : (Number(newQuantity) * 0).toFixed(2);\n\nconst isFullCancel = Math.abs(quantity - quantityOrdered) < 0.000001;\n\nconst cancelFlag = Number(newQuantity) === 0;\n\nresponse.shortSupplyUpdate =  {\n      parts: [\n        {\n          id: \"1\",\n          path: `/draftPurchaseOrders/${poHeaderId}`,\n          operation: \"update\",\n          payload: {\n            ChangeOrderDescription: \"Ai Agent\",\n            ChangeOrderInitiatingParty: \"BUYER\"\n          }\n        },\n        {\n          id: \"2\",\n          path: `/draftPurchaseOrders/${poHeaderId}/child/lines/${poLineId}`,\n          operation: \"update\",\n          payload: {\n            CancelFlag: cancelFlag,\n            LineNumber: lineNumber,\n            Price: unitPrice,\n            Quantity: newQuantity,\n            CancelReason: null,\n            CancelUnfulfilledDemandFlag: null\n          }\n        },\n        {\n          id: \"3\",\n          path: `/draftPurchaseOrders/${poHeaderId}/child/lines/${poLineId}/child/schedules/${poLineLocationId}`,\n          operation: \"update\",\n          payload: {\n            CancelFlag: cancelFlag,\n            Quantity: newQuantity,\n            AssessableValue: assessableValue,\n            CancelReason: null\n          }\n        },\n        {\n          id: \"4\",\n          path: `/draftPurchaseOrders/${poHeaderId}/child/lines/${poLineId}/child/schedules/${poLineLocationId}/child/distributions/${poDistributionId}`,\n          operation: \"update\",\n          payload: {\n            Quantity: newQuantity,\n            Amount: null\n          }\n        }\n      ]\n    };\n\nreturn response;"
          },
          "outcomes": {
            "success": "1771660703223"
          },
