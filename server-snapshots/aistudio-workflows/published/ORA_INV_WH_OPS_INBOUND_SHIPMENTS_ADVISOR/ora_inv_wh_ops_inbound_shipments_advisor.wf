        {
          "metadata": {
            "name": "Filtered Emails By Organization",
            "returnType": "object",
            "sourceCode": "let emails = $context.$nodes.INIT_DISPLAY_READ_SHORT_SUPPLY_EMAIL.$output;\n\nlet parsedData = [];\n\nfor (let eachEmail of emails) {\n  let text = eachEmail.text;\n\n  try {\n    let payload = JSON.parse(text);\n   payload.documentIdentifier = eachEmail.documentIdentifier;\n    parsedData.push(payload);\n  } catch (err) {\n    // Skip invalid JSON emails\n    continue;\n  }\n}\n\n// Normalize both sides to string to safely compare number/string values\nlet orgId = String($context.$variables.organizationId);\n\nlet filteredData = parsedData.filter(\n  i => i.organizationId != null && String(i.organizationId) === orgId\n);\n\nreturn filteredData;"
          },
          "outcomes": {
            "success": "1771675105162"
          },
          "code": "FILTERED_EMAILS_BY_ORGANIZATION",
          "convergenceTargetId": "1771675105162",
          "id": "1771427887288",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
