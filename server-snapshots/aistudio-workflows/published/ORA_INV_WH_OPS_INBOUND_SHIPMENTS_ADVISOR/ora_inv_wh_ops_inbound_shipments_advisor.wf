        {
          "metadata": {
            "name": "prepare query for More Info On Short Order Data",
            "returnType": "string",
            "sourceCode": "const input = $context.$nodes.READ_ALL_ROWS.$output;\nconst organizationId = Number( $context.$variables.organizationId );\n\n\n// Extract unique PO Header IDs and Line IDs\nconst poHeaderIds = new Set();\nconst poLineIds = new Set();\n\nfor (const item of input) {\n  if (item.purchaseOrderHeaderId) {\n    poHeaderIds.add(Number(item.purchaseOrderHeaderId));\n  }\n\n  if (item.purchaseOrderLineId) {\n    poLineIds.add(Number(item.purchaseOrderLineId));\n  }\n\n  // In case values are only inside text JSON\n  if (item.text) {\n    const parsed = JSON.parse(item.text);\n\n    if (parsed.purchaseOrderHeaderId) {\n      poHeaderIds.add(Number(parsed.purchaseOrderHeaderId));\n    }\n\n    if (parsed.purchaseOrderLineId) {\n      poLineIds.add(Number(parsed.purchaseOrderLineId));\n    }\n  }\n}\n\n// Convert Sets to arrays\nconst headerIdArray = Array.from(poHeaderIds);\nconst lineIdArray = Array.from(poLineIds);\n\n// OrganizationId (taking first record)\n\n// Build Elasticsearch query\nconst esQuery = {\n  query: {\n    bool: {\n      filter: [\n        {\n          term: {\n            \"ScheduleStatus.raw\": \"OPEN\"\n          }\n        },\n        {\n          term: {\n            \"ToOrganizationId\": organizationId\n          }\n        },\n        {\n          terms: {\n            \"POHeaderId\": headerIdArray\n          }\n        },\n        {\n          terms: {\n            \"POLineId\": lineIdArray\n          }\n        }\n      ]\n    }\n  },\n  size: 25,\n  sort: [\n    {\n      ExpectedReceiptDate: {\n        order: \"desc\"\n      }\n    }\n  ]\n};\n\n\nreturn JSON.stringify(esQuery) ;"
          },
          "outcomes": {
            "success": "1771421544675"
          },
          "code": "PREPARE_QUERY_FOR_MORE_INFO_ON_SHORT_ORDER_DATA",
          "id": "1771431680669",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
