            "sourceCode": "let prompt = '';\n\nlet error = $context.$error.$errorMessage;\n\nprompt = `Say that your supply request creation is failed because of the error ${error}\n\n----\nStrict Output Format\n-----\n\nDo not generate  any widgets like record, multirecord etc. \n\nOutput should be simple markup language.\n`;\n\nreturn prompt;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "SUPPLY_REQUEST_ERROR_PROMPT",
          "id": "1777353399307",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Delayed Shipments LLM Prompt",
            "returnType": "string",
            "sourceCode": "let prompt = ``;\n\nprompt = `\n\nYou are a UI Results Presenter.\n\nOBJECTIVE\nGiven:\n1) User request\n2) Executed Elasticsearch query (es_query, optional)\n3) Elasticsearch response (es_response: hits + total)\n\nGenerate UI widget payload JSON that presents the search results.\n\n--------------------------------------------------\nOUTPUT GUIDELINES\n--------------------------------------------------\n- Generate a Multi record widget.\n- Do not include Action as a column\n- Avoid exposing any internal/system identifiers.\n\nInternal ID fields to exclude:\n- Any field named or ending with: \"Id\", \"ID\", \"_id\"\n- Known examples:\n  POHeaderId, POLineId, POLineLocationId,\n  ToOrganizationId, ShipToLocationId,\n  OrganizationId, DeliverToLocationId\n\nIf the user explicitly asks for IDs:\n- Do not include them\n- Prefer business-friendly alternatives\n\n--------------------------------------------------\nDATA RULES\n--------------------------------------------------\n- Use ONLY values present in es_response.\n- Do NOT invent data.\n- Do NOT compute derived business values.\n- Default page size = 25 (or fewer if fewer results).\n- Include total result count in summary.\n\n--------------------------------------------------\nTABLE RULES\n--------------------------------------------------\nTotal columns: EXACTLY 6\n\nColumns 1–5:\n- Business columns only.\n- Selected based on:\n  1) Explicit user request (excluding internal IDs)\n  2) Search constraint attributes\n  3) Key business identifiers\n- Maximum of 5 business columns.\n- Prefer stable identifiers and business-friendly fields.\n- Ignore translation objects entirely.\n- Leave cell empty if value missing.\n- Dates: format YYYY-MM-DD if possible; else pass through.\n\nFor Each Row, Add a action with title \"Details\"\n\nAction rules:\n- parameters MUST include:\n  - documentNumber\n  - lineNumber\n  - documentType\n  - inventoryItemId\n- Use only values present in the row.\n- If any of these are missing in the row, set value to null.\n\nora.Agent({\n  \"command\": \"showDetailedInfoOnOneDelayedOrder\",\n  \"agent\" : \"INV_WH_OPS_INBOUND_ADVISOR\",\n  \"subAgent\": \"INV_WH_OPS_INBOUND_SHIPMENTS_ADVISOR\",\n  \"parameters\": {\n      \"documentNumber\": <DocumentNumber>,\n      \"lineNumber\": <OrderLine.LineNumber>,\n      \"documentType\": <DocumentType.LookupCode or equivalent>,\n      \"inventoryItemId\" : <Item.ItemId>\n  }\n})\n\n--------------------------------------------------\nZERO HITS BEHAVIOR\n--------------------------------------------------\nIf totalHits == 0:\n- Return Multi record widget\n- Include 5 selected business columns\n- Include Action column\n- rows: []\n- summary must show total = 0\n\n--------------------------------------------------\nINPUTS\n--------------------------------------------------\nes_query:  \n${JSON.stringify($context.$nodes.EXPECTED_SHIPMENTS_PAST_DUE_DETAILS.$input.payload)}\n\nes_response:\n${JSON.stringify($context.$nodes.EXPECTED_SHIPMENTS_PAST_DUE_DETAILS.$output)}\n\n--------------------------------------------------\n\n`;\n\nreturn prompt;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "DELAYED_SHIPMENTS_LLM_PROMPT",
          "convergenceTargetId": "1771242567632",
          "id": "1771247540698",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Show Detailed Order",
            "returnType": "object",
            "sourceCode": "const documentNumber = $context?.$triggers?.REST?.$input?.parameters?.documentNumber;\nconst lineNumber     = $context?.$triggers?.REST?.$input?.parameters?.lineNumber;\nconst documentType   = $context?.$triggers?.REST?.$input?.parameters?.documentType;\n\nconst payload = {\n  query: {\n    bool: {\n      filter: [\n        ...(documentNumber ? [{ term: { \"DocumentNumber.raw\": String(documentNumber) } }] : []),\n        ...(lineNumber ? [{ term: { \"OrderLine.LineNumber.raw\": String(lineNumber) } }] : []),\n        ...(documentType ? [{ term: { \"SourceDocumentCode.raw\": String(documentType) } }] : []),\n      ],\n    },\n  },\n};\n\nreturn payload;"
          },
          "outcomes": {
            "success": "1771302291306"
          },
          "code": "SHOW_DETAILED_ORDER",
          "id": "1771233811496",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Prepare Email Search on Orders"
          },
          "outcomes": {
            "success": "1771414749237"
          },
          "code": "PREPARE_EMAIL_SEARCH_ON_ORDERS",
          "id": "1771414385252",
          "inputs": [
            {
              "id": "1771414385258_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an expert Elasticsearch Query Builder specialized in parsing supplier email content \nand converting it into a valid Elasticsearch request object.\n\n--------------------------------------------------\nOBJECTIVE\n--------------------------------------------------\nRead the provided email content and generate a valid Elasticsearch JSON query.\n\nThe email may reference:\n- One or multiple Purchase Orders\n- One or multiple PO Line Numbers\n- Item descriptions\n- Item numbers\n- Partial shipments\n- Delays\n- Quantities\n\nYour task is to extract all usable search constraints and construct a clean, efficient ES query.\n\nCRITICAL RULE:\nYou may ONLY use the fields listed in the \"ALLOWED FIELDS\" section below.\nNo other fields are permitted in the query under any circumstances.\n\n--------------------------------------------------\nINPUT\n--------------------------------------------------\n- email_content: {{$context.$variables.parameters}}\n\n--------------------------------------------------\nALLOWED FIELDS\n--------------------------------------------------\n- DocumentNumber\n- OrderLine.LineNumber\n- ItemDescription\n- OrderLine.ItemDescription\n- Item.ItemNumber\n\nAllowed strict keyword usage:\n- DocumentNumber.raw (for exact PO matching only)\n\nNo other fields may be used.\nDo NOT introduce additional fields even if mentioned in the email.\n\n--------------------------------------------------\nQUERY CONSTRUCTION RULES\n--------------------------------------------------\n\n1. Multi-Order Handling\n   - If multiple Document Numbers (PO numbers) are present:\n       → Use a bool query with \"should\" clauses inside filter.\n       → Set \"minimum_should_match\": 1.\n       → Do not duplicate identical values.\n\n2. Strict Matching (Exact Only — No Fuzziness)\n   - If Document Number is explicitly present:\n       → Use term query on \"DocumentNumber.raw\"\n       → Place inside filter.\n   - If Line Number is explicitly present:\n       → Use term query on \"OrderLine.LineNumber\"\n       → Place inside filter.\n   - If Item Number is explicitly present:\n       → Use term query on \"Item.ItemNumber\"\n       → Place inside filter.\n   - NEVER use fuzzy matching for these fields.\n   - NEVER use match query for these identifiers.\n\n3. Fuzzy Matching (Text Fields Only)\n   - For:\n       • ItemDescription\n       • OrderLine.ItemDescription\n   - Use match query with:\n       \"fuzziness\": \"AUTO\"\n   - Place fuzzy queries inside \"must\".\n   - Do NOT use .raw for fuzzy searches.\n\n4. Ignore Unsupported Constraints\n   - Do NOT apply quantity comparisons.\n   - Do NOT apply date filters.\n   - Do NOT use supplier, organization, or status fields.\n   - If a constraint cannot be mapped to an allowed field, ignore it.\n\n5. Mandatory Filter\n   - Always include:\n       term: { \"ScheduleStatus.raw\": \"OPEN\" }\n\n6. Default Behavior (No Usable Information)\n   If the email contains NONE of:\n       • Document Number\n       • Line Number\n       • Item description\n       • Item number\n   Then return a query that intentionally returns NO results by including:\n       term: { \"DocumentNumber.raw\": \"__NO_MATCH__\" }\n\n7. Structural Requirements\n   - Use a top-level bool query.\n   - Use:\n       • filter → for exact matches\n       • must → for fuzzy matches\n       • should → only for multi-value exact matches\n   - Avoid unnecessary nesting.\n   - Keep query minimal and clean.\n   - Do NOT use scripts.\n   - Do NOT use aggregations.\n   - Do NOT include explanations.\n   - Return ONLY valid Elasticsearch JSON.\n   - size must always be 25.\n   - Always sort by ExpectedReceiptDate (descending).\n\n\n----\nOutput\n----\nOutput should be a json with attributes \nisOrderShortSupplied, requestPayload"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"isOrderShortSupplied\": {\n            \"type\": \"boolean\"\n        },\n        \"requestPayload\": {\n            \"type\": \"object\",\n            \"properties\": {}\n        }\n    }\n}",
          "type": "LLM"
        },
