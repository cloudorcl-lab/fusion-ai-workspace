                    "sourceCode": "return {\"Reason\":$context.$nodes.LOOP.SELECT_MAIN_RECORD.$output?.Reason?.replace(/<a\\b[^>]*>(.*?)<\\/a>/gi, '$1').replace(/'\\\\\\\"/g, \"'\").replace(/\\\\\\\"'/g, \"'\"),\"PartyNumber\":$context.$nodes.LOOP.SELECT_MAIN_RECORD.$output?.MasterPartyNumber,\"UsageCode\":$context.$nodes.LOOP.RETRIEVE_PARTY_USAGE.$output?.result,\"DuplicateParty\":$context.$nodes.SELECT_MAIN_RECORD.$output?.DuplicateParty,\"LinkedParty\":$context.$nodes.SELECT_MAIN_RECORD.$output?.LinkedParty,\"Ambiguity\":$context.$nodes.SELECT_MAIN_RECORD.$output?.Ambiguity,\"LinkedPartnerParty\":$context.$nodes.SELECT_MAIN_RECORD.$output?.LinkedPartnerParty,\"LinkedSupplierParty\":$context.$nodes.SELECT_MAIN_RECORD.$output?.LinkedSupplierParty,};"
