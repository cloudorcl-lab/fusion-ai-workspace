            "name": "Set Return Value",
            "returnType": "array",
            "sourceCode": "const val = $context.$nodes.LOOP.$output;\nconst rVal = [];\ntry{\nif (Array.isArray(val)){\n for (const item of val) {\n    rVal.push(JSON.parse(item).result);\n }\n}\nelse\n{\n    rVal.push(JSON.parse(val).result);\n}\n}catch(error){\n for(let i =0; i  < $context.$nodes.CONVERT_TO_JSON.$output.result.length ; i++){\n         rVal.push({});\n }\n}\nreturn rVal;"
          },
