                  "outcomes": {
                    "true": "1764156720569",
                    "false": "add_false_1764156651010"
                  },
                  "code": "MAIN_RECORD_SELECTED",
                  "convergenceTargetId": "1764156928990",
                  "id": "1764156651010",
                  "inputs": [
                    {
                      "id": "1764156651011_1",
                      "name": "condition",
                      "type": "string",
                      "value": "{{$context.$nodes.LOOP.SELECT_MAIN_RECORD.$output.MasterPartyNumber.length > 0}}"
                    }
                  ],
                  "type": "CONDITION"
                },
                {
                  "metadata": {
                    "name": "Retrieve Party Usage",
                    "returnType": "string",
                    "sourceCode": "const usages = $context.$nodes.LOOP.EDQ_DUPLICATE_CHECK.$output.result.find(x => x.PartyNumber == $context.$nodes.LOOP.SELECT_MAIN_RECORD.$output.MasterPartyNumber).PartyUsageCodes.split(\",\");\n\nif (usages.includes(\"SALES_ACCOUNT\") || usages.includes(\"SALES_PROSPECT\")) {\n    return \"SALES_ACCOUNT\";\n}\n\nif (usages.includes(\"PARTNER\") || usages.includes(\"INACTIVE_PARTNER\")) {\n    return \"PARTNER\";\n}\n\nif (usages.includes(\"SUPPLIER\")) {\n    return \"SUPPLIER\";\n}\n\n\nif (usages.includes(\"SUPPLIER\") || usages.includes(\"INACTIVE_PARTNER\")) {\n    return \"SUPPLIER\";\n}\n\nif (usages.includes(\"CUSTOMER\")) {\n    return \"CUSTOMER\";\n}\n\nelse return \"OTHER\";"
                  },
                  "outcomes": {
                    "success": "1764156928990"
                  },
                  "code": "RETRIEVE_PARTY_USAGE",
                  "id": "1764156720569",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
