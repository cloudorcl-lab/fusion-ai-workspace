            "x": 5716,
            "y": 7426
          }
        },
        {
          "metadata": {
            "name": "Build Create Tactic Payload",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  const rawInput = $context.$triggers.REST?.$input?.OraAction || \"\";\n\n  const match = rawInput.match(/<oraFormSubmit\\s+id=[\"']([^\"']*)[\"'][^>]*>(.*?)<\\/oraFormSubmit>/s);\n  if (!match) {\n    result = {};\n  } else {\n    const id = match[1];\n    const jsonString = match[2];\n    let templateId = null;\n    if (id.includes(\"templateId_\")) {\n      const templateIdMatch = id.match(/templateId_(\\d+)/);\n      if (templateIdMatch) {\n        templateId = templateIdMatch[1];\n      }\n    }\n\n    let attributes = {};\n    try {\n      const parsedArray = JSON.parse(jsonString);\n      attributes = parsedArray.reduce((acc, item) => {\n        acc[item.id] = item.value;\n        return acc;\n      }, {});\n    } catch (e) {\n    }\n\n    result = {\n      TacticName: attributes.TacticName || null,\n      TacticObjective: attributes.TacticObjective || null,\n      TemplateId: templateId\n    };\n  }\n} catch (error) {\n  result = {};\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1780825884775"
          },
          "code": "BUILD_CREATE_TACTIC_PAYLOAD",
          "id": "1765702609764",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 5474.5,
            "y": 7648
          }
        },
        {
          "id": "1780825884775",
          "code": "RETRIEVE_TACTIC_TEMPLATE",
          "type": "CODE",
          "metadata": {
            "name": "Retrieve Tactic Template",
            "sourceCode": "let result = null;\ntry {\n  // Get the TemplateId from BUILD_CREATE_TACTIC_PAYLOAD node output\n  const buildPayloadResult = $context.$nodes?.BUILD_CREATE_TACTIC_PAYLOAD?.$output?.result || {};\n  const templateId = buildPayloadResult.TemplateId;\n\n  // Get the agent tactic templates from GET_AGENT_TACTIC_TEMPLATES node output\n  const agentTemplates = $context.$nodes?.GET_AGENT_TACTIC_TEMPLATES?.$output?.items || [];\n\n  // Find the template matching the TemplateId\n  if (templateId && Array.isArray(agentTemplates)) {\n    const foundTemplate = agentTemplates.find(template => template.id === templateId);\n    if (foundTemplate) {\n      // Parse contentJson field safely\n      let parsedContentJson = null;\n      try {\n        parsedContentJson = foundTemplate.contentJson ? JSON.parse(foundTemplate.contentJson) : null;\n      } catch (parseError) {\n        parsedContentJson = null; // fallback if JSON parsing fails\n      }\n      // Return the template with contentJson parsed\n      result = { ...foundTemplate, contentJson: parsedContentJson };\n    } else {\n      result = null;\n    }\n  } else {\n    result = null;\n  }\n} catch (error) {\n  result = null;\n}\n\nreturn result;",
            "returnType": "object"
          },
          "diagram": {
            "x": 5476,
            "y": 7870
          },
          "outcomes": {
            "success": "1781019291620"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
