          },
          "inputs": [
            {
              "id": "1778568705373_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": ""
            },
            {
              "id": "1778568705373_prompt",
              "name": "prompt",
              "type": "string",
              "value": "### 1) Generate recordWidget\nGenerate an editable recordWidget with id as the concatenation of: \"templateId_\",\n{{$context.$nodes.RETRIEVE_ACTION_PARAMETERS.$output.result.templateId}}, and fields as:\nfields: [\n  {\n    id: \"TacticName\",\n    label: \"Tactic Name\",\n    value: \"{{Generate a random text value close to but different from\n    {{$context.$nodes.GET_AGENT_TEMPLATE_DETAILS.$output.result.contentJson.templateName}} by the LLM}}\",\n    type: \"text\"\n  },\n  {\n    id: \"TacticObjective\",\n    label: \"Tactic Objective\",\n    value: \"{{Generate a precise, one-line sentence that is a reasoned summary\n    based on the content of {{$context.$nodes.GET_AGENT_TEMPLATE_DETAILS.$output.result.contentJson.whenToUse}}.\n    Do not simply repeat or copy the 'whenToUse' text but infer and synthesize a clear,\n    concise objective from it.}}\",\n    type: \"text\"\n  }\n]\nGenerate title as: Create Tactic based on {{$context.$nodes.GET_AGENT_TEMPLATE_DETAILS.$output.result.contentJson.templateName}}\nGenerate description as: \"{{Generate a precise, one-line sentence that is a reasoned summary\n    based on the content of {{$context.$nodes.GET_AGENT_TEMPLATE_DETAILS.$output.result.contentJson.whenToUse}}.\n    Do not simply repeat or copy the 'whenToUse' text but infer and synthesize a clear,\n    concise objective from it.}}\"\nHard Constraints:\n- Do not include any additional fields.\n- Do not omit any of the listed fields.\n- Do not change field names, labels, or types.\n- Do not add comments, explanations, or formatting outside this structure."
            }
          ],
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "enableActions": true,
              "layouts": [
                "ORA_LAYOUT_RECORD"
              ]
            }
          }
        },
        {
          "id": "1778567658606",
          "code": "TOP_FIT_ROWS",
          "type": "CODE",
          "metadata": {
            "name": "Top Fit Rows",
            "sourceCode": "let result = [];\ntry {\n  // Retrieve the objective from GET_PROGRAM_DETAILS node output\n  const objective = $context.$nodes?.GET_PROGRAM_DETAILS?.$output?.[0]?.objective || \"\";\n\n  // Retrieve the templates data from REFINE_THE_AI_TEMPLATES node output\n  const templatesData = $context.$nodes?.REFINE_THE_AI_TEMPLATES?.$output || {};\n\n  // Retrieve ProgramType from RETRIEVE_PROGRAM_TYPE node output\n  const programType = $context.$nodes.REFINE_PROGRAM_DATA.$output.result.ProgramType || \"\";\n\n  // Normalize text: lowercase, remove non-alphanumeric except spaces and hyphens, collapse spaces\n  const normalize = (text = \"\") =>\n    String(text)\n      .toLowerCase()\n      .replace(/[^a-z0-9\\s-]/g, \" \")\n      .replace(/\\s+/g, \" \")\n      .trim();\n\n  // Stop words set\n  const STOP_WORDS = new Set([\n    \"the\", \"and\", \"or\", \"to\", \"of\", \"a\", \"an\", \"for\", \"with\", \"on\", \"in\", \"by\", \"from\", \"that\", \"this\", \"is\", \"are\", \"be\", \"as\", \"at\", \"it\", \"you\", \"your\", \"using\", \"use\", \"want\", \"when\", \"who\", \"which\", \"will\", \"into\", \"via\", \"than\", \"only\", \"more\", \"less\"\n  ]);\n\n  // Tokenize text by normalizing, splitting, filtering stop words\n  const tokenize = (text = \"\") =>\n    normalize(text)\n      .split(\" \")\n      .filter(Boolean)\n      .filter(token => !STOP_WORDS.has(token));\n\n  // Calculate Jaccard similarity score between two texts\n  const jaccardScore = (aText, bText) => {\n    const a = new Set(tokenize(aText));\n    const b = new Set(tokenize(bText));\n    if (!a.size || !b.size) return 0;\n    let intersection = 0;\n    for (const token of a) {\n      if (b.has(token)) intersection++;\n    }\n    const union = new Set([...a, ...b]).size;\n    return intersection / union;\n  };\n\n  // Calculate phrase boost score based on presence of key phrases in objective and whenToUse\n  const phraseBoost = (objectiveText, whenToUseText) => {\n    const obj = normalize(objectiveText);\n    const use = normalize(whenToUseText);\n    const boosts = [\n      [\"cross sell\", 12],\n      [\"cpq\", 18],\n      [\"erp cloud service\", 15],\n      [\"industries\", 6],\n      [\"regions\", 6],\n      [\"segment\", 8],\n      [\"email\", 4],\n      [\"landing page\", 4],\n      [\"follow up\", 4],\n      [\"drip\", 4],\n      [\"offer\", 3]\n    ];\n    let score = 0;\n    for (const [phrase, boost] of boosts) {\n      if (obj.includes(phrase) && use.includes(phrase)) {\n        score += boost;\n      }\n    }\n    return score;\n  };\n\n  // Score a single template row based on objective and row content\n  const scoreTemplate = (objectiveText, row) => {\n    // TODO: Inferred 'contentJson' from user text 'contentJson'\n    const whenToUse = row?.contentJson?.whenToUse || \"\";\n    let score = 0;\n    score += jaccardScore(objectiveText, whenToUse) * 100;\n    score += phraseBoost(objectiveText, whenToUse);\n\n    // Add conditional bonus based on ProgramType for 'cross sell' or 'renewal'\n    const normalizedWhenToUse = normalize(whenToUse);\n    const normalizedProgramType = normalize(programType);\n    if (programType && (normalizedWhenToUse.includes(\"cross sell\") || normalizedWhenToUse.includes(\"renewal\")) &&\n        (normalizedProgramType.includes(\"cross sell\") || normalizedProgramType.includes(\"renewal\"))) {\n      score += 8;\n    }\n\n    // Other bonuses\n    if (normalizedWhenToUse.includes(\"segment\")) score += 6;\n    if (normalizedWhenToUse.includes(\"email\")) score += 3;\n    if (normalizedWhenToUse.includes(\"landing page\")) score += 3;\n    return score;\n  };\n\n  // Get top N fit rows sorted by score descending\n  const getTopFitRows = (objectiveText, templates, topN = 6) => {\n    const rows = Array.isArray(templates?.result) ? templates.result : Array.isArray(templates) ? templates : [];\n    return rows\n      .map(row => ({ ...row, _score: scoreTemplate(objectiveText, row) }))\n      .sort((a, b) => b._score - a._score)\n      .slice(0, topN)\n      .map(({ _score, ...row }) => row);\n  };\n\n  // Compute the top fit rows\n  result = getTopFitRows(objective, templatesData, 6);\n} catch (error) {\n  result = [];\n}\n\nreturn result;\n",
            "returnType": "array"
          },
          "diagram": {
            "x": 6421,
            "y": 6982
          },
          "outcomes": {
            "success": "1778561999067"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1778561999067",
          "code": "COMBINE_TACTIC_TEMPLATES",
          "type": "CODE",
          "metadata": {
            "name": "Combine Tactic Templates",
            "sourceCode": "let result = [];\ntry {\n\n  const aiTemplatesRaw = $context.$nodes.TOP_FIT_ROWS.$output.result || [];\n  const combined = [];\n\n  for (let j = 0; j < aiTemplatesRaw.length && combined.length < 6; j++) {\n    const tmpl = aiTemplatesRaw[j];\n    let contentJson = {};\n    if (tmpl.contentJson) {\n      if (typeof tmpl.contentJson === 'string') {\n        try {\n          contentJson = JSON.parse(tmpl.contentJson);\n        } catch (e) {\n          contentJson = {};\n        }\n      } else {\n        contentJson = tmpl.contentJson;\n      }\n    }\n    combined.push({\n      id: tmpl.id || \"\",\n      name: contentJson.templateName || \"\",\n      description: contentJson.whenToUse || \"\"\n    });\n  }\n result = combined.slice(0, 6);\n} catch (error) {\n  result = [];\n}\n\nreturn result;",
            "returnType": "array"
          },
          "diagram": {
