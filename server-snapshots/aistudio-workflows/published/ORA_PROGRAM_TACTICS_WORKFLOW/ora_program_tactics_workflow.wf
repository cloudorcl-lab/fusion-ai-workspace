                },
                {
                  "id": "1781087954683",
                  "code": "BUILD_SEGMENT_DATA",
                  "type": "CODE",
                  "metadata": {
                    "name": "Build Segment Data",
                    "sourceCode": "let result = {};\ntry {\n  // Access programId from variables\n  const programId = $context.$variables?.programId || \"\";\n  const timestamp = Date.now();\n  const name = `Program_Advisior_${programId}_${timestamp}`;\n\n  // Access TargetProductId and ProgramType from REFINE_PROGRAM_DATA node result\n  const refineProgramDataResult = $context.$nodes?.REFINE_PROGRAM_DATA?.$output?.result || {};\n  const targetProductName = refineProgramDataResult.TargetProductName || \"\";\n  const ownedProductName = refineProgramDataResult.OwnedProductName || \"\";\n  const programType = refineProgramDataResult.ProgramType || \"\";\n\n  // Escape single quotes for SQL string literals\n  const escapeSqlValue = (value) => {\n    return String(value || \"\").split(\"'\").join(\"''\");\n  };\n\n  let sqlTemplate = \"\";\n\n  if (programType.toLowerCase() === \"renewal\") {\n    // SQL template for renewal programType\n    sqlTemplate = `SELECT DISTINCT \"C2\".\"Contacts_ID\" AS \"Contacts_ID\"\nFROM (\n  SELECT \"C0\".\"Contacts_ID\" AS \"Contacts_ID\"\n  FROM (\n    SELECT \"C0\".\"ID\" AS \"Contacts_ID\"\n    FROM \"Default.Contacts\" \"C0\"\n    JOIN (\n      SELECT DISTINCT \"B0\".\"ContactID\" AS \"BuyingGroupMember_ContactID\"\n      FROM \"Default.BuyingGroupMember\" \"B0\"\n      WHERE (\n        \"B0\".\"ProductLevel4Name\" IN (\n          '<targetProductName>'\n        )\n      )\n    ) \"B0\" ON \"C0\".\"ContactID\" = \"B0\".\"BuyingGroupMember_ContactID\"\n  ) \"C0\"\n  JOIN (\n    SELECT \"C1\".\"ID\" AS \"Contacts_ID\"\n    FROM \"Default.Contacts\" \"C1\"\n    JOIN (\n      SELECT \"A0\".\"AccountID\" AS \"Accounts_AccountID\"\n      FROM \"Default.Accounts\" \"A0\"\n      JOIN (\n        SELECT DISTINCT \"A0\".\"Accounts_ID\" AS \"Accounts_ID\"\n        FROM (\n          (\n            SELECT \"A0\".\"ID\" AS \"Accounts_ID\"\n            FROM \"Default.Accounts\" \"A0\"\n            JOIN (\n              SELECT DISTINCT \"A1\".\"AccountID\" AS \"AccountProductIntelligence_AccountID\"\n              FROM \"Default.AccountProductIntelligence\" \"A1\"\n              WHERE (\n                TRUNC(\"A1\".\"RenewalDate\") BETWEEN TRUNC(SYSDATE) AND TRUNC(SYSDATE) + 180\n              )\n            ) \"A1\" ON \"A0\".\"AccountID\" = \"A1\".\"AccountProductIntelligence_AccountID\"\n          ) \"A0\"\n        )\n      ) \"ref_0\" ON \"A0\".\"ID\" = \"ref_0\".\"Accounts_ID\"\n    ) \"A0\" ON \"C1\".\"AccountID\" = \"A0\".\"Accounts_AccountID\"\n  ) \"C1\" ON \"C0\".\"Contacts_ID\" = \"C1\".\"Contacts_ID\"\n) \"C2\"`;\n  } else {\n    // Default SQL template\n    sqlTemplate = `SELECT DISTINCT \"C2\".\"Contacts_ID\" AS \"Contacts_ID\"\nFROM (\n  SELECT \"C0\".\"Contacts_ID\" AS \"Contacts_ID\"\n  FROM (\n    SELECT \"C0\".\"ID\" AS \"Contacts_ID\"\n    FROM \"Default.Contacts\" \"C0\"\n    JOIN (\n      SELECT DISTINCT \"B0\".\"ContactID\" AS \"BuyingGroupMember_ContactID\"\n      FROM \"Default.BuyingGroupMember\" \"B0\"\n      WHERE (\n        \"B0\".\"ProductLevel7Name\" IN (\n          '<targetProductName>'\n        )\n      )\n    ) \"B0\" ON \"C0\".\"ContactID\" = \"B0\".\"BuyingGroupMember_ContactID\"\n  ) \"C0\"\n  JOIN (\n    SELECT \"C1\".\"ID\" AS \"Contacts_ID\"\n    FROM \"Default.Contacts\" \"C1\"\n    JOIN (\n      SELECT \"A0\".\"AccountID\" AS \"Accounts_AccountID\"\n      FROM \"Default.Accounts\" \"A0\"\n      JOIN (\n         -- ACCOUNT SEGMENT STARTS HERE\n        SELECT DISTINCT \"A0\".\"Accounts_ID\" AS \"Accounts_ID\"\n        FROM (\n          (\n            SELECT \"A0\".\"ID\" AS \"Accounts_ID\"\n            FROM \"Default.Accounts\" \"A0\"\n            JOIN (\n              SELECT DISTINCT \"A1\".\"AccountID\" AS \"AccountProductIntelligence_AccountID\"\n              FROM \"Default.AccountProductIntelligence\" \"A1\"\n              WHERE (\n                (\n                  \"A1\".\"ProductLevel7Name\" IN (\n                    '<ownedProductName>'\n                  )\n                ) AND (\n                  \"A1\".\"OwnershipStatus\" IN (\n                    'Owns'\n                  )\n                )\n              )\n            ) \"A1\" ON \"A0\".\"AccountID\" = \"A1\".\"AccountProductIntelligence_AccountID\"\n          ) \"A0\"\n          JOIN (\n            SELECT \"A2\".\"ID\" AS \"Accounts_ID\"\n            FROM \"Default.Accounts\" \"A2\"\n            JOIN (\n              SELECT DISTINCT \"A3\".\"AccountID\" AS \"AccountProductIntelligence_AccountID\"\n              FROM \"Default.AccountProductIntelligence\" \"A3\"\n              WHERE (\n                (\n                  \"A3\".\"ProductLevel7Name\" IN (\n                    '<targetProductName>'\n                  )\n                ) AND (\n                  \"A3\".\"BuyingGroupPersonaCoveragePct\" > '40'\n                ) AND (\n                  \"A3\".\"BuyingGroupPersonaEngagementPct\" > '40'\n                ) AND (\n                  (\n                    \"A3\".\"OwnershipStatus\" NOT IN (\n                      'Owns'\n                    )\n                  ) OR (\n                    \"A3\".\"OwnershipStatus\" IS NULL\n                  )\n                )\n              )\n            ) \"A3\" ON \"A2\".\"AccountID\" = \"A3\".\"AccountProductIntelligence_AccountID\"\n          ) \"A2\" ON \"A0\".\"Accounts_ID\" = \"A2\".\"Accounts_ID\"\n        )\n        -- ACCOUNT SEGMENT ENDS HERE\n      ) \"ref_0\" ON \"A0\".\"ID\" = \"ref_0\".\"Accounts_ID\"\n    ) \"A0\" ON \"C1\".\"AccountID\" = \"A0\".\"Accounts_AccountID\"\n  ) \"C1\" ON \"C0\".\"Contacts_ID\" = \"C1\".\"Contacts_ID\"\n) \"C2\"`;\n  }\n\n  // Replace placeholders with escaped values\n  let sqlData = sqlTemplate.replaceAll(\"<targetProductName>\", escapeSqlValue(targetProductName));\n\n  // For default template, also replace <ownedProductName>\n  if (programType.toLowerCase() !== \"renewal\") {\n    sqlData = sqlData.replaceAll(\"<ownedProductName>\", escapeSqlValue(ownedProductName));\n  }\n\n  const jsonModelObj = {\n    canvases: {\n      sqlQuery: {\n        sql: sqlData\n      }\n    }\n  };\n\n  // Compose final result object\n  result = {\n    name: name,\n    description: \"\",\n    explanation: \"\",\n    jsonModel: JSON.stringify(jsonModelObj),\n    type: \"SQLQUERY\",\n    baseObject: \"Contacts\",\n    model: \"Default\",\n    context: \"tactic\",\n    count: null\n  };\n} catch (error) {\n  result = {};\n}\n\nreturn result;\n",
                    "returnType": "object",
                    "errorNodeId": "1781173469542",
                    "sourceType": "code"
                  },
