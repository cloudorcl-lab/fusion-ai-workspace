        {
          "id": "1781151585677",
          "code": "GET_AGENT_TACTIC_TEMPLATES",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Get Agent Tactic Templates",
            "businessObjectCode": "ORA_CX_MARKETING_DATAOBJECTS",
            "functionName": "getTacticTemplates"
          },
          "diagram": {
            "x": 5941,
            "y": 6316
          },
          "outcomes": {
            "success": "1781151585678"
          },
          "inputs": []
        },
        {
          "id": "1781151585678",
          "code": "REFINE_THE_AI_TEMPLATES",
          "type": "CODE",
          "metadata": {
            "name": "Refine the AI Templates",
            "sourceCode": "let result = [];\ntry {\n  const items = $context.$nodes.GET_AGENT_TACTIC_TEMPLATES?.$output?.items || [];\n  const programTypeResult = $context.$nodes.REFINE_PROGRAM_DATA.$output.result.ProgramType || \"\";\n\n  const normalizedProgramType = (typeof programTypeResult === \"string\" ? programTypeResult : \"\").toLowerCase();\n  let normalizedProgramTypeFinal = \"\";\n  if (normalizedProgramType === \"cross sell\" || normalizedProgramType === \"cross-sell\") {\n    normalizedProgramTypeFinal = \"cross-sell\";\n  } else if (normalizedProgramType === \"renewal\") {\n    normalizedProgramTypeFinal = \"renewal\";\n  } else {\n    normalizedProgramTypeFinal = normalizedProgramType;\n  }\n\n  result = items.filter(item => {\n    let contentJson = item.contentJson || {};\n    // Check if contentJson is a string (stringified JSON), parse it\n    if (typeof contentJson === \"string\") {\n      try {\n        contentJson = JSON.parse(contentJson);\n      } catch (e) {\n        contentJson = {};\n      }\n    }\n\n    const itemProgramTypeRaw = contentJson.programType || \"\";\n    const itemProgramTypeLower = (typeof itemProgramTypeRaw === \"string\" ? itemProgramTypeRaw : \"\").toLowerCase();\n\n    let itemProgramTypeNormalized = \"\";\n    if (itemProgramTypeLower === \"cross sell\" || itemProgramTypeLower === \"cross-sell\") {\n      itemProgramTypeNormalized = \"cross-sell\";\n    } else if (itemProgramTypeLower === \"renewal\" || itemProgramTypeLower === \"renewal return\") {\n      itemProgramTypeNormalized = \"renewal\";\n    } else {\n      itemProgramTypeNormalized = itemProgramTypeLower;\n    }\n\n    return itemProgramTypeNormalized === normalizedProgramTypeFinal;\n  }).map(item => ({\n    id: item.id,\n    contentJson: item.contentJson\n  }));\n\n} catch (error) {\n  result = [];\n}\n\nreturn result;\n",
            "returnType": "array"
          },
          "diagram": {
            "x": 5941,
            "y": 6538
          },
          "outcomes": {
            "success": "1765695187925"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
