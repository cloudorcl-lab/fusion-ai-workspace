                {
                  "id": "1781017618012",
                  "code": "SETTING_MESSAGE_ID",
                  "type": "CODE",
                  "metadata": {
                    "name": "Setting Message Id",
                    "returnType": "object",
                    "sourceCode": "let result = {};\ntry {\n  // Access the entire automationContentJsonModel from workflow variables\n  const automationContentJsonModel = $context.$variables?.automationContentJsonModel || {};\n\n  // Access the sampleAutomationJson from automationContentJsonModel\n  const sampleAutomationJson = automationContentJsonModel?.sampleAutomationJsonModel || {};\n\n  // Access the placeholder string from the current item of AUTOMATION_JSON_MODEL_BUILDER node\n  const placeholder = $context.$nodes?.AUTOMATION_JSON_MODEL_BUILDER?.$currentItem?.placeholder;\n\n  // Access the message ID from the CREATE_MESSAGE node output\n  const messageIdValue = $context.$nodes?.CREATE_MESSAGE?.$output?.id;\n\n  // Convert sampleAutomationJson to string for replacement\n  let templateString = JSON.stringify(sampleAutomationJson);\n\n  // If placeholder is a string and messageIdValue is defined, replace all occurrences of placeholder with messageIdValue\n  if (typeof placeholder === 'string' && messageIdValue !== undefined) {\n    // Escape special characters in placeholder for RegExp\n    const escapedPlaceholder = placeholder.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n    const regex = new RegExp(escapedPlaceholder, 'g');\n    templateString = templateString.replace(regex, messageIdValue);\n  }\n\n  // Parse the modified string back to object\n  const modifiedSampleAutomationJson = JSON.parse(templateString);\n\n  // Create a shallow copy of automationContentJsonModel to avoid mutating original\n  result = { ...automationContentJsonModel };\n\n  // Replace sampleAutomationJson with the modified version\n  result.sampleAutomationJsonModel = modifiedSampleAutomationJson;\n} catch (error) {\n  // On error, return empty object as required by return type\n  result = {};\n}\n\nreturn result;",
                    "errorNodeId": "1781173469542"
                  },
                  "diagram": {
                    "x": 5251,
                    "y": 10553
                  },
                  "outcomes": {
                    "success": "1781019837704"
                  },
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "id": "1781017923940",
                  "code": "SETTING_SEGMENT_ID",
                  "type": "CODE",
                  "metadata": {
                    "name": "Setting Segment Id",
                    "returnType": "object",
                    "sourceCode": "let result = [];\ntry {\n  // Access the tacticAutomationJsonModelBuilder array safely\n  const tacticModels = $context.$variables?.tacticAutomationJsonModelBuilder || [];\n\nconst placeholder = $context.$nodes?.AUTOMATION_JSON_MODEL_BUILDER?.$currentItem?.placeholder;\n  // Extract segmentId from CREATE_SEGMENT node response headers\n  let segmentId = null;\n  const responseHeaders = $context.$nodes?.CREATE_SEGMENT?.$responseHeaders;\n  if (responseHeaders) {\n    const location = responseHeaders['location'];\n    if (location && Array.isArray(location) && location.length > 0) {\n      segmentId = location[0].split(\"/\").pop();\n    }\n  }\n\n  // Access the entire automationContentJsonModel from workflow variables\n  const automationContentJsonModel = $context.$variables?.automationContentJsonModel || {};\n\n  // Access the sampleAutomationJson from automationContentJsonModel\n  const sampleAutomationJson = automationContentJsonModel?.sampleAutomationJsonModel || {};\n\n\n  // Convert sampleAutomationJson to string for replacement\n  let templateString = JSON.stringify(sampleAutomationJson);\n\n  // If placeholder is a string and messageIdValue is defined, replace all occurrences of placeholder with messageIdValue\n  if (typeof placeholder === 'string' && segmentId !== undefined) {\n    // Escape special characters in placeholder for RegExp\n    const escapedPlaceholder = placeholder.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n    const regex = new RegExp(escapedPlaceholder, 'g');\n    templateString = templateString.replace(regex, segmentId);\n  }\n\n  // Parse the modified string back to object\n  const modifiedSampleAutomationJson = JSON.parse(templateString);\n\n  // Create a shallow copy of automationContentJsonModel to avoid mutating original\n  result = { ...automationContentJsonModel };\n\n  // Replace sampleAutomationJson with the modified version\n  result.sampleAutomationJsonModel = modifiedSampleAutomationJson;\n\n\n} catch (error) {\n  // On error, return empty array as per return type\n  result = {};\n}\n\nreturn result;",
                    "errorNodeId": "1781173469542"
                  },
                  "diagram": {
                    "x": 5932,
                    "y": 9221
                  },
                  "outcomes": {
                    "success": "1781019882874"
                  },
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
