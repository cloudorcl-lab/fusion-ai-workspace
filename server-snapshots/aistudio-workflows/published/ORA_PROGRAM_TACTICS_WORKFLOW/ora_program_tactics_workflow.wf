        {
          "metadata": {
            "name": "Determine Action",
            "returnType": "string",
            "sourceCode": "let action = undefined;\nif ($context.$triggers.REST.$input.OraAction.includes(\"createTactic\"))\n  action = \"createTactic\";\nelse if ($context.$triggers.REST.$input.OraAction.includes(\"addAlltactics\"))\n  action = \"addAlltactics\";\nelse if ($context.$triggers.REST.$input.OraAction.includes(\"oraFormSubmit\"))\n  action = \"oraFormSubmit\";\n\n\nreturn action;"
          },
          "outcomes": {
            "success": "1765697655434"
          },
          "code": "DETERMINE_ACTION",
          "id": "1765697606446",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 5716,
            "y": 6982
          }
        },
        {
          "metadata": {
            "name": "Retrieve Action Parameters",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  const payload = $context.$triggers?.REST?.$input?.OraAction || \"\";\n  const paramMatch = payload.match(/\\(([^)]*)\\)/);\n\n  if (paramMatch && paramMatch.length > 1) {\n    const paramString = paramMatch[1];\n    const params = {};\n    paramString.split(',').forEach(pair => {\n      const [key, value] = pair.split('=');\n      if (key && value !== undefined) {\n        params[key.trim()] = value.trim();\n      }\n    });\n    // Extract only templateId and source\n    result = {\n      templateId: params.templateId || \"\"\n    };\n  } else {\n    result = { templateId: \"\"};\n  }\n} catch (error) {\n  result = { templateId: \"\"};\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1765697684614"
          },
          "code": "RETRIEVE_ACTION_PARAMETERS",
          "id": "1765697655434",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 5716,
            "y": 7204
          }
        },
        {
