        {
          "metadata": {
            "name": "Retrieve Program Data from Context",
            "returnType": "string",
            "sourceCode": "let result = \"\";\ntry {\n  const appInput = $context.$triggers?.REST?.$input?.OraAppContext || \"\";\n  const pairs = appInput.split(\",\");\n  const data = pairs.reduce((acc, pair) => {\n    const [key, value] = pair.split(\"=\");\n    if (key && value) {\n      acc[key.trim()] = value.trim();\n    }\n    return acc;\n  }, {});\n\n  // Get programId from parsed data, default to null if not present\n  const programId = data.programId ?? null;\n\n  // Convert object to JSON string to satisfy string return type\n  result = JSON.stringify({ programId });\n} catch (error) {\n  result = \"\";\n}\n\nreturn result;",
            "errorNodeId": "1781163643333"
          },
          "outcomes": {
            "success": "1781071481014"
          },
          "code": "RETRIEVE_PROGRAM_DATA_FROM_CONTEXT",
          "id": "1765680105947",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 5908,
            "y": 5206
          }
        },
