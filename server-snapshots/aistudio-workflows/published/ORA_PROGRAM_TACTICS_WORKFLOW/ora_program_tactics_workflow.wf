        {
          "id": "1778568298293",
          "code": "GET_AGENT_TEMPLATE_DETAILS",
          "type": "CODE",
          "metadata": {
            "name": "Get Agent Template Details",
            "sourceCode": "// to do remove\nlet result = null;\ntry {\n  const templates = $context.$nodes?.REFINE_THE_AI_TEMPLATES?.$output?.result || [];\n  const templateId = $context.$nodes?.RETRIEVE_ACTION_PARAMETERS?.$output?.result?.templateId;\n\n  const matchedTemplate = templates.find(t => t?.id === templateId);\n\n  function removeIdRecursively(obj) {\n    if (obj && typeof obj === 'object') {\n      if (Array.isArray(obj)) {\n        obj.forEach(item => removeIdRecursively(item));\n      } else {\n        Object.keys(obj).forEach(key => {\n          if (key === 'id') {\n            delete obj[key];\n          } else {\n            removeIdRecursively(obj[key]);\n          }\n        });\n      }\n    }\n  }\n\n  if (matchedTemplate) {\n    const templateClone = JSON.parse(JSON.stringify(matchedTemplate));\n    if (templateClone.contentJson) {\n      try {\n        templateClone.contentJson = JSON.parse(templateClone.contentJson);\n      } catch (e) {\n      }\n      removeIdRecursively(templateClone.contentJson);\n    }\n    result = templateClone;\n  } else {\n    result = null;\n  }\n} catch (error) {\n  result = null;\n}\n\nreturn result;",
            "returnType": "object"
          },
          "diagram": {
            "x": 6417,
            "y": 7648
          },
          "outcomes": {
