                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "id": "1781515639783",
                  "code": "MESSAGE_PAYLOAD_BUILDER",
                  "type": "CODE",
                  "metadata": {
                    "name": "Message Payload Builder",
                    "sourceCode": "let result = {};\ntry {\n  const currentItemType = $context.$nodes?.AUTOMATION_JSON_MODEL_BUILDER?.$currentItem?.name || \"\";\n\n  if (currentItemType === \"email\" || currentItemType === \"followUpEmail\") {\n    // For email or followUpEmail type, return with subjectLine and channel email\n    result = {\n      message: {\n        channel: \"email\",\n        context: \"TACTIC\",\n        designMode: \"AGENT_PROGRAM_ADVISOR\",\n        canvases: {\n          subjectLine: {\n            content: $context.$nodes?.GENERATE_ASSET_RESPONSE?.$output?.result?.title || \"\"\n          },\n          rawHtml: {\n            content: $context.$nodes?.GENERATE_ASSET_RESPONSE?.$output?.result?.content || \"\"\n          }\n        }\n      }\n    };\n  } else {\n    // For other types, channel is landingPage and remove subjectLine\n    result = {\n      message: {\n        channel: \"landingPage\",\n        context: \"TACTIC\",\n        designMode: \"AGENT_PROGRAM_ADVISOR\",\n        canvases: {\n          rawHtml: {\n            content: $context.$nodes?.GENERATE_ASSET_RESPONSE?.$output?.result?.content || \"\"\n          }\n        }\n      }\n    };\n  }\n} catch (error) {\n  // Fallback safe return\n  result = {\n    message: {\n      channel: \"landingPage\",\n      context: \"TACTIC\",\n      designMode: \"AGENT_PROGRAM_ADVISOR\",\n      canvases: {\n        rawHtml: {\n          content: \"\"\n        }\n      }\n    }\n  };\n}\n\nreturn result;",
                    "sourceType": "code",
                    "returnType": "object",
                    "errorNodeId": "1781173469542"
                  },
