                  "code": "REFINE_EMAIL_TEMPLATES",
                  "type": "CODE",
                  "metadata": {
                    "name": "Refine Email Templates",
                    "returnType": "object",
                    "sourceCode": "let result = \"\";\ntry {\n  const emailTemplates = $context.$nodes?.GET_EMAIL_TEMPLATES?.$output?.items || [];\n  if (emailTemplates.length > 0) {\n    const firstTemplate = emailTemplates[0];\n    let contentJson = firstTemplate.contentJson;\n    if (typeof contentJson === \"string\") {\n      try {\n        contentJson = JSON.parse(contentJson);\n      } catch (parseError) {\n        contentJson = {};\n      }\n    }\n    result = contentJson?.sampleOutput?.message?.canvases?.rawHtml?.content || \"\";\n  }\n} catch (error) {\n  result = \"\";\n}\n\nreturn result;"
                  },
