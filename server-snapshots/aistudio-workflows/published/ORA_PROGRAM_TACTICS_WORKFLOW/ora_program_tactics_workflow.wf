            "createTactic": "1778568298293"
          },
          "code": "INVOKE_ACTION",
          "convergenceTargetId": "end",
          "id": "1765697684614",
          "inputs": [
            {
              "id": "1765697684615_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$nodes.DETERMINE_ACTION.$output.result}}"
            }
