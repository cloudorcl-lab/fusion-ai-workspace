              "value": "{{$context.$variables.programId}}",
              "required": true,
              "type": "string"
            }
          ]
        },
        {
          "id": "1779246553108",
          "code": "REFINE_PROGRAM_DATA",
          "type": "CODE",
          "metadata": {
            "name": "Refine Program Data",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  // Access the first program item safely\n  const firstProgram = $context.$nodes?.GET_PROGRAM_DETAILS?.$output?.items?.[0] || null;\n\n  if (firstProgram) {\n    // Find attribute with key 'product'\n    const targetProductAttr = firstProgram.programAttributes?.items?.find(attr => attr.key === \"product\");\n    // Find attribute with key 'ownedproduct'\n    const ownedProductAttr = firstProgram.programAttributes?.items?.find(attr => attr.key === \"ownedproduct\");\n // Find attribute with key 'programType'\n    const programTypeAttr = firstProgram.programAttributes?.items?.find(attr => attr.key === \"programType\");\n\n    result = {\n      ProgramId: firstProgram.id || null,\n      ProgramName: firstProgram.name || null,\n      ProgramObjective: firstProgram.objective || null,\n      ProgramType: programTypeAttr ? programTypeAttr.value :\"\",\n      TargetProductId: targetProductAttr ? targetProductAttr.value : null,\n      TargetProductName: targetProductAttr ? targetProductAttr.displayValue : null,\n      OwnedProductId: ownedProductAttr ? ownedProductAttr.value : null,\n      OwnedProductName: ownedProductAttr ? ownedProductAttr.displayValue : null\n    };\n  } else {\n    // No program found, return empty object\n    result = {};\n  }\n} catch (error) {\n  // On error, return empty object\n  result = {};\n}\n\nresult.Action=\"launchTactic\";\n\nreturn result;"
          },
          "diagram": {
            "x": 5941,
            "y": 5872
          },
          "outcomes": {
            "success": "1780989300191"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
