        {
          "id": "1782135634929",
          "code": "TACTIC_NAME_NOT_UNIQUE_ERROR",
          "type": "LLM",
          "metadata": {
            "name": "Tactic Name Not Unique Error"
          },
          "diagram": {
            "x": 7707,
            "y": 5000
