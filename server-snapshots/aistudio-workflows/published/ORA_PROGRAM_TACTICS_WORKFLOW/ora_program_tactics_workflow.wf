        {
          "id": "1779246568522",
          "code": "GET_PROGRAM_DETAILS",
          "type": "BO_FUNCTION",
          "metadata": {
            "businessObjectCode": "ORA_CX_MARKETING_DATAOBJECTS",
            "name": "Get Program Details",
            "functionName": "getProgramById",
            "errorNodeId": "1781163643333"
