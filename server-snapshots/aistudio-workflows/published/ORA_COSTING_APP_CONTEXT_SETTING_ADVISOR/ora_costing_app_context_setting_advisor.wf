        {
          "metadata": {
            "name": "Return Explicit Period Never Opened",
            "returnType": "object",
            "sourceCode": "const requestedPeriod = $context.$variables.periodName;\nconst currentOpenPeriod = $context.$variables.currentOpenPeriodName || null;\nconst nextEligiblePeriod = $context.$variables.nextEligiblePeriodName || null;\nconst targetCostOrganizationId = String($context.$variables.costOrganizationId ?? \"\");\nconst targetCostBookId = String($context.$variables.costBookId ?? \"\");\n\n// Current app context from request parsing (if available)\nconst currentCtxOrg = String($context.$nodes.DETECT_REQUEST_MODE.$output.result.appContextCostOrganizationId ?? \"\");\nconst currentCtxBook = String($context.$nodes.DETECT_REQUEST_MODE.$output.result.appContextCostBookId ?? \"\");\nconst currentCtxPeriod = String($context.$nodes.DETECT_REQUEST_MODE.$output.result.appContextPeriodName ?? \"\");\n\nconst buildContext = (periodName) =>\n  periodName ? `${targetCostOrganizationId}:${targetCostBookId}:${periodName}` : null;\n\nconst currentOpenContext = buildContext(currentOpenPeriod);\nconst nextEligibleContext = buildContext(nextEligiblePeriod);\n\n// Suppress switch action when user is already on that same current-open context\nconst isAlreadyOnCurrentOpenContext =\n  !!currentOpenPeriod &&\n  currentCtxOrg === targetCostOrganizationId &&\n  currentCtxBook === targetCostBookId &&\n  currentCtxPeriod === currentOpenPeriod;\n\nconst actions = [];\nif (currentOpenPeriod && !isAlreadyOnCurrentOpenContext) {\n  actions.push({\n    code: \"SWITCH_TO_CURRENT_OPEN_PERIOD\",\n    label: `Switch to Current Open Period (${currentOpenPeriod})`,\n    targetCostOrganizationId,\n    targetCostBookId,\n    targetPeriodName: currentOpenPeriod,\n    targetContext: currentOpenContext\n  });\n}\nif (nextEligiblePeriod) {\n  actions.push({\n    code: \"OPEN_NEXT_ELIGIBLE_PERIOD\",\n    label: `Open Next Eligible Period (${nextEligiblePeriod})`,\n    targetCostOrganizationId,\n    targetCostBookId,\n    targetPeriodName: nextEligiblePeriod,\n    targetContext: nextEligibleContext\n  });\n}\n\nlet message = `Requested period (${requestedPeriod}) is Never Opened.`;\nif (currentOpenPeriod && nextEligiblePeriod && !isAlreadyOnCurrentOpenContext) {\n  message = `Requested period (${requestedPeriod}) is Never Opened. Current open period is (${currentOpenPeriod}). Next eligible period to open is (${nextEligiblePeriod}).`;\n} else if (currentOpenPeriod && !isAlreadyOnCurrentOpenContext) {\n  message = `Requested period (${requestedPeriod}) is Never Opened. Current open period is (${currentOpenPeriod}).`;\n} else if (nextEligiblePeriod) {\n  message = `Requested period (${requestedPeriod}) is Never Opened. Next eligible period to open is (${nextEligiblePeriod}).`;\n}\n\nreturn {\n  ok: false,\n  status: \"action_required\",\n  mode: \"query\",\n  data: {\n    RequestedPeriodName: requestedPeriod,\n    CurrentOpenPeriodName: currentOpenPeriod,\n    NextEligiblePeriodName: nextEligiblePeriod,\n    CostOrganizationId: targetCostOrganizationId,\n    CostBookId: targetCostBookId,\n    CurrentOpenContext: currentOpenContext,\n    NextEligibleContext: nextEligibleContext,\n    Message: message,\n    Actions: actions\n  },\n  errorCode: \"PERIOD_NEVER_OPENED\",\n  errorMessage: \"Requested period is Never Opened.\"\n};"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "RETURN_EXPLICIT_PERIOD_NEVER_OPENED",
          "id": "1880000000224",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Return Invalid Period",
            "returnType": "object",
            "sourceCode": "return {\n  ok: false,\n  status: \"error\",\n  mode: \"query\",\n  data: null,\n  errorCode: \"INVALID_PERIOD\",\n  errorMessage: \"The provided period name is invalid.\"\n};"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "RETURN_INVALID_PERIOD",
          "id": "22",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
