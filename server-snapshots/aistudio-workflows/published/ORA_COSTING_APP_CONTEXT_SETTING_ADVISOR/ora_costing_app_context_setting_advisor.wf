        {
          "metadata": {
            "name": "Normalize Query Period Text",
            "returnType": "object",
            "sourceCode": "const rawPeriodName = String(\n  $context?.$nodes?.DETECT_REQUEST_MODE?.$output?.result?.periodName ?? \"\"\n).trim();\n\nconst monthNumbers = {\n  jan: 1,\n  january: 1,\n  feb: 2,\n  february: 2,\n  mar: 3,\n  march: 3,\n  apr: 4,\n  april: 4,\n  may: 5,\n  jun: 6,\n  june: 6,\n  jul: 7,\n  july: 7,\n  aug: 8,\n  august: 8,\n  sep: 9,\n  sept: 9,\n  september: 9,\n  oct: 10,\n  october: 10,\n  nov: 11,\n  november: 11,\n  dec: 12,\n  december: 12\n};\n\nconst expandYear = (value) => {\n  const year = Number(value);\n  if (!Number.isFinite(year)) {\n    return null;\n  }\n  return year < 100 ? 2000 + year : year;\n};\n\nconst buildLookupDate = (year, month) => {\n  if (!year || !month || month < 1 || month > 12) {\n    return null;\n  }\n  return `${year}-${String(month).padStart(2, \"0\")}-01`;\n};\n\nconst normalizedText = rawPeriodName\n  .toLowerCase()\n  .replace(/[.,]/g, \" \")\n  .replace(/\\s+/g, \" \")\n  .trim();\n\nlet lookupDate = null;\nlet parsed = false;\n\nlet match = normalizedText.match(/^([a-z]+)\\s*[-/' ]?\\s*(\\d{2}|\\d{4})$/);\nif (match) {\n  lookupDate = buildLookupDate(expandYear(match[2]), monthNumbers[match[1]]);\n}\n\nif (!lookupDate) {\n  match = normalizedText.match(/^(\\d{1,2})\\s*[-/]\\s*(\\d{2}|\\d{4})$/);\n  if (match) {\n    lookupDate = buildLookupDate(expandYear(match[2]), Number(match[1]));\n  }\n}\n\nif (!lookupDate) {\n  match = normalizedText.match(/^(\\d{4})\\s*[-/]\\s*(\\d{1,2})$/);\n  if (match) {\n    lookupDate = buildLookupDate(Number(match[1]), Number(match[2]));\n  }\n}\n\nparsed = !!lookupDate;\n\nreturn {\n  rawPeriodName,\n  lookupDate,\n  parsed\n};"
          },
          "outcomes": {
            "success": "1880000000302"
          },
          "code": "NORMALIZE_QUERY_PERIOD_TEXT",
          "id": "1880000000300",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
