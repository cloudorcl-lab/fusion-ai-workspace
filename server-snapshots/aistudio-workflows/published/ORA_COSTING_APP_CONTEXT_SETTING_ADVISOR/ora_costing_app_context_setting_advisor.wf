{
  "workflowId": "300000331068629",
  "workflowCode": "ORA_COSTING_APP_CONTEXT_SETTING_ADVISOR",
  "name": "Costing Application Context Setting Advisor",
  "description": "Context-setting advisor for Costing Applicatoon. Resolves and validates cost organization, cost book, and period.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "name": "Detect Request Mode",
            "returnType": "object",
            "sourceCode": "const oraMessageHint =\n  $context?.$app?.$OraMessageHint ??\n  $context?.$triggers?.REST?.$input?.OraMessageHint ??\n  null;\n\nconst inputMessage = String($context?.$system?.$inputMessage ?? \"\").trim();\nconst appContext = String(\n  $context?.$app?.$OraAppContext ??\n    $context?.$triggers?.REST?.$input?.OraAppContext ??\n    \"\"\n).trim();\n\nconst isQueryContextIntent =\n  oraMessageHint === \"Query\" &&\n  /\\b(?:set|change|update|switch)\\b\\s+(?:to\\s+)?(?:the\\s+)?(?:cost\\s*org(?:anization)?|org|cost\\s*book|book|period)\\b/i.test(inputMessage);\n\nconst clean = (v) =>\n  (v ? v.trim().replace(/^[:\\s\"']+|[\"']+$/g, \"\") : null);\n\nconst extractByPattern = (text, pattern) => {\n  const m = text.match(pattern);\n  return m && m[1] ? clean(m[1]) : null;\n};\n\nconst costOrgPattern =\n  /\\b(?:cost\\s*org(?:anization)?|org)\\b\\s*(?:name|code)?\\s*(?:to|is|=|:)?\\s*([^,;]+?)(?=\\s*(?:,|;|\\band\\b|&|\\bcost\\s*book\\b|\\bbook\\b|\\bperiod\\b|$))/i;\n\nconst costBookPattern =\n  /\\b(?:cost\\s*book|book)\\b\\s*(?:code|name)?\\s*(?:to|is|=|:)?\\s*([^,;]+?)(?=\\s*(?:,|;|\\band\\b|&|\\bcost\\s*org(?:anization)?\\b|\\borg\\b|\\bperiod\\b|$))/i;\n\nconst periodPattern =\n  /\\bperiod(?:\\s*name)?\\b\\s*(?:to|is|=|:)?\\s*([^,;]+?)(?=\\s*(?:,|;|\\band\\b|&|\\bcost\\s*org(?:anization)?\\b|\\borg\\b|\\bcost\\s*book\\b|\\bbook\\b|$))/i;\n\nlet costOrganizationName = extractByPattern(inputMessage, costOrgPattern);\nlet costBookCode = extractByPattern(inputMessage, costBookPattern);\nlet periodName = extractByPattern(inputMessage, periodPattern);\n\n// No broad fallback. Context changes must explicitly mention cost org, cost book, or period.\n\nlet appContextCostOrganizationId = null;\nlet appContextCostBookId = null;\nlet appContextPeriodName = null;\n\nif (appContext && appContext.includes(\":\")) {\n  const parts = appContext.split(\":\").map((s) => s.trim());\n  appContextCostOrganizationId = parts[0] || null;\n  appContextCostBookId = parts[1] || null;\n  appContextPeriodName = parts.slice(2).join(\":\") || null;\n}\n\nreturn {\n  costOrganizationName,\n  costBookCode,\n  periodName,\n  appContextCostOrganizationId,\n  appContextCostBookId,\n  appContextPeriodName,\n  isQueryContextIntent\n};"
          },
          "outcomes": {
            "success": "36"
          },
          "code": "DETECT_REQUEST_MODE",
          "id": "1",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
