        {
          "metadata": {
            "name": "Set Default Cost Org From Profile",
            "returnType": "object",
            "sourceCode": "const profileOutput = $context.$nodes.GET_DEFAULT_COST_ORG_PROFILE.$output;\nconst currentUserName = $context.$user.$name;\n\nconst clean = (v) => (v == null ? null : String(v).trim());\n\nconst pickUserValue = (items, userName) => {\n  if (!Array.isArray(items)) return null;\n\n  const targetUserName = clean(userName);\n  if (!targetUserName) return null;\n\n  for (const item of items) {\n    const itemUserName = clean(item?.UserName ?? item?.userName);\n    if (itemUserName === targetUserName) {\n      const val = clean(item?.ProfileOptionValue ?? item?.profileOptionValue);\n      if (val) return val;\n    }\n  }\n\n  return null;\n};\n\nconst pickFirstValue = (items) => {\n  if (!Array.isArray(items)) return null;\n  for (const item of items) {\n    const val = clean(item?.ProfileOptionValue ?? item?.profileOptionValue);\n    if (val) return val;\n  }\n  return null;\n};\n\nconst userLevelValue = pickUserValue(\n  profileOutput?.userProfileOptionValues?.items,\n  currentUserName\n);\nconst siteLevelValue = pickFirstValue(profileOutput?.siteProfileOptionValues?.items);\n\nconst defaultCostOrganizationId = userLevelValue || siteLevelValue || null;\n\nreturn {\n  defaultCostOrganizationId\n};"
          },
          "outcomes": {
            "success": "39"
          },
          "code": "SET_DEFAULT_COST_ORG_FROM_PROFILE",
          "id": "28",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
