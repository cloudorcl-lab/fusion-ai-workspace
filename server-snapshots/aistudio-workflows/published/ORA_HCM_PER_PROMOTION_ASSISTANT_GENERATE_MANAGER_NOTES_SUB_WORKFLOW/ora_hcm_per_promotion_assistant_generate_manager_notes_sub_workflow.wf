            "name": "returnRequiredValues",
            "returnType": "object",
            "sourceCode": "let requiredInputs = {} ; \n\nrequiredInputs.display_name = $context.$variables.message.DisplayName\nrequiredInputs.action = $context.$variables.message.ActionName\nrequiredInputs.action_reason  = $context.$variables.message.ActionReasonName || \"NA\"\nrequiredInputs.current_Department = $context.$variables.message.DepartmentName || \"NA\"\nrequiredInputs.current_Location = $context.$variables.message.LocationName || \"NA\"\nrequiredInputs.Input_text = $context.$variables.message.Input_text || \"NA\"\nrequiredInputs.current_job = $context.$variables.message.CurrentJobName || \"NA\"\nrequiredInputs.proposed_job = $context.$variables.message.JobName || \"NA\"\nrequiredInputs.total_seniority = $context.$variables.message.TotalSeniority || $context.$variables.message.JobSeniority || \"NA\"\nrequiredInputs.Job_seniority = $context.$variables.message.JobSeniority || \"NA\"\n\nreturn requiredInputs"
