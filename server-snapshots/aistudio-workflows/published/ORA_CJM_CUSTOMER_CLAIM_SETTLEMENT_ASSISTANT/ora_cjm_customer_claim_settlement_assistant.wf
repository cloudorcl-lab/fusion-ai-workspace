                  "inputs": [
                    {
                      "id": "1770654206512",
                      "name": "toLoop",
                      "scope": "JOB",
                      "type": "boolean",
                      "value": "{{($context.$variables.offset <= $context.$variables.totalResults) && $context.$nodes.FETCH_OPEN_CLAIMS_IN_BATCHES.GET_OPEN_CLAIMS.$output.hasMore}}"
                    }
                  ],
                  "type": "SET_FIELDS"
                },
                {
                  "metadata": {
                    "name": "Prepare Valid Claims Array",
                    "returnType": "array",
                    "sourceCode": "const claims = $context.$nodes.FETCH_OPEN_CLAIMS_IN_BATCHES.GET_OPEN_CLAIMS.$output.items || [];\nconst filteredClaims = $context.$variables.claimArray || [];\n\nfor (const row of claims) {\n  if ((row.settlementMethods?.count || 0) == 0) {\n    filteredClaims.push(row);\n  }\n}\n\nreturn filteredClaims;"
                  },
                  "outcomes": {
                    "success": "1770654322629"
