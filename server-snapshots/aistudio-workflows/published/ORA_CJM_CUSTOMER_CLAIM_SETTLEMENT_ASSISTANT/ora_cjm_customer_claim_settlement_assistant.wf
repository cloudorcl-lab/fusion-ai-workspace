                  "code": "VALID_FOR_SUBMISSION",
                  "convergenceTargetId": "end_1769660929727",
                  "id": "1772098619112",
                  "inputs": [
                    {
                      "id": "1772098619125_1",
                      "name": "condition",
                      "type": "string",
                      "value": "{{$context.$nodes.LOOP_VALID_CLAIMS.GET_RESOLUTION_INTENT.$output.AgentAction == 'SUBMIT'}}"
                    }
                  ],
                  "type": "CONDITION"
                },
                {
                  "metadata": {
                    "name": "Set RAG Question",
                    "returnType": "string",
                    "sourceCode": "let question = \"\";\nlet resolutionIntentValue = $context.$nodes.LOOP_VALID_CLAIMS.GET_RESOLUTION_INTENT.$output.ResolutionIntent;\n\nlet settlementType = \"\";\nif (resolutionIntentValue == \"PROMOTIONAL\") {\n  settlementType = \"Promotional\";\n} else {\n  settlementType = \"Non Promotional\";\n}\n\nquestion =\n  \"Find the best matching claim policy rule from the uploaded Claim Policy document.\\n\" +\n  \"Input values:\\n\" +\n  \"Business Unit = \" + $context.$nodes.LOOP_VALID_CLAIMS.$currentItem.BusinessUnit + \"\\n\" +\n  \"Claim Source = \" + $context.$nodes.LOOP_VALID_CLAIMS.$currentItem.ClaimSource + \"\\n\" +\n  \"Bill-to Customer = \" + $context.$nodes.LOOP_VALID_CLAIMS.$currentItem.BillToCustomer + \"\\n\" +\n  \"Settlement Type = \" + settlementType + \"\\n\\n\" +\n  \"Matching instructions:\\n\" +\n  \"1. A document value of 'Any' must be treated as a wildcard match for that attribute.\\n\" +\n  \"2. Prefer an exact value match over 'Any' for the same attribute.\\n\" +\n  \"3. If multiple rows match, choose the single best rule using this priority order from the document:\\n\" +\n  \"   a. Business Unit + Settlement Type + Claim Source + Bill-to Customer\\n\" +\n  \"   b. Business Unit + Settlement Type + Bill-to Customer\\n\" +\n  \"   c. Business Unit + Settlement Type + Claim Source\\n\" +\n  \"   d. Business Unit + Settlement Type only\\n\" +\n  \"   e. Settlement Type only\\n\" +\n  \"4. Return only the final matched Rule ID, Derived Claim Type, and Derived Claim Reason.\\n\" +\n  \"5. Also mention which fields matched exactly and which fields matched through 'Any'.\";\n\nreturn question;"
                  },
                  "outcomes": {
                    "success": "1771327399940"
                  },
                  "code": "SETRAGQUESTION",
                  "convergenceTargetId": "1773151883734",
                  "id": "1771498453463",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "Call RAG Tool",
                    "toolCode": "ORA_CLAIM_TYPE_CLAIM_REASON_MAPPING_DOCUMENT"
                  },
                  "outcomes": {
                    "success": "1771327511587"
