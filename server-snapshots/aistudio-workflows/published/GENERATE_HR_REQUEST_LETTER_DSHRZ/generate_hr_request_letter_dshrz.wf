        {
          "metadata": {
            "name": "HR Request Letter LLM"
          },
          "outcomes": {
            "success": "1769440373699"
          },
          "code": "HR_REQUEST_LETTER_LLM",
          "id": "1769439758967",
          "inputs": [
            {
              "id": "1769439758969_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an intelligent agent that assists users with requests for official letters related to employment. Analyze the user’s message in {{$context.$system.$inputMessage}} and take the following actions:\n1.\tDetermine the letterType:\n•\tIf the input contains the word \"Salary\", set letterType = SALARY.\n•\tIf the input contains the word \"Employment\", set letterType = EMPLOYMENT.\n•\tIf the input contains the word \"Visa\", set letterType = VISA.\n•\tIf none of these keywords are present, set letterType = NA.\n•\tOnly recognize letter types if the corresponding keyword is explicitly mentioned.\n2.\tSpecial instructions for VISA letters:\n•\tIf letterType is VISA:\n•\tExtract the destination country (visaCountry), departure date (visaFromDate), and return date (visaToDate) from the input.\n•\tFormat dates as mm-dd-yyyy.\n•\tEnsure that visaFromDate is a future date, and visaToDate is later than visaFromDate.\n•\tIf any of these three details are missing, politely prompt the user to provide the missing information.\n3.\tOutput:\n•\tRespond with a JSON object in the following structure:\n{\n  \"letterType\": \"SALARY / EMPLOYMENT / VISA / NA\",\n  \"visaCountry\": \"if applicable\",\n  \"visaFromDate\": \"mm-dd-yyyy if applicable\",\n  \"visaToDate\": \"mm-dd-yyyy if applicable\"\n}\n•\tOnly include visaCountry, visaFromDate, and visaToDate in the output if letterType is VISA and the information is available."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"LetterRequestAgentOutput\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"letterType\": {\n      \"type\": \"string\",\n      \"enum\": [\"SALARY\", \"EMPLOYMENT\", \"VISA\", \"NA\"],\n      \"description\": \"Type of letter requested by the user.\"\n    },\n    \"visaCountry\": {\n      \"type\": \"string\",\n      \"description\": \"Destination country for the visa request, required if letterType is VISA.\"\n    },\n    \"visaFromDate\": {\n      \"type\": \"string\",\n      \"pattern\": \"^(0[1-9]|1[0-2])-([0][1-9]|[12][0-9]|3[01])-\\\\d{4}$\",\n      \"description\": \"Visa departure date in mm-dd-yyyy format, required if letterType is VISA.\"\n    },\n    \"visaToDate\": {\n      \"type\": \"string\",\n      \"pattern\": \"^(0[1-9]|1[0-2])-([0][1-9]|[12][0-9]|3[01])-\\\\d{4}$\",\n      \"description\": \"Visa return date in mm-dd-yyyy format, required if letterType is VISA.\"\n    }\n  },\n  \"required\": [\"letterType\"],\n  \"allOf\": [\n    {\n      \"if\": {\n        \"properties\": {\n          \"letterType\": { \"const\": \"VISA\" }\n        }\n      },\n      \"then\": {\n        \"required\": [\"visaCountry\", \"visaFromDate\", \"visaToDate\"]\n      }\n    }\n  ],\n  \"additionalProperties\": false\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_OTHER_HRREQUESTLETTERBIPPERSONIDBO",
