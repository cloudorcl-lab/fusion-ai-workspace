        {
          "metadata": {
            "name": "HR Request Letter Extract SOAP BIP reportBytes Code",
            "returnType": "object",
            "sourceCode": "let match = \"\";\nlet reportBytesBase64 ={};\nlet xmlString  = \"\";\n\nxmlString = $context.$nodes.HR_REQUEST_LETTER_BIP_RUN_REPORT_BO.$output;\n\nmatch = xmlString.match(/<ns2:reportBytes>([\\s\\S]*?)<\\/ns2:reportBytes>/);\n\nif (match && match[1]) \n  reportBytesBase64.reportBytes = match[1];\n\nreturn reportBytesBase64;"
          },
          "outcomes": {
            "success": "1769443137139"
          },
          "code": "HR_REQUEST_LETTER_EXTRACT_SOAP_BIP_REPORTBYTES_CODE",
          "id": "1769443004078",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
