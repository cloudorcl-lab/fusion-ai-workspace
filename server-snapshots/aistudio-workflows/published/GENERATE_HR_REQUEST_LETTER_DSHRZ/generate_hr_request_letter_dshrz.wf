          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"DocumentOfRecord\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"DocumentsOfRecordId\": { \"type\": \"integer\" },\n    \"DocumentTypeId\": { \"type\": \"integer\" },\n    \"SystemDocumentType\": { \"type\": \"string\" },\n    \"DocumentType\": { \"type\": \"string\" },\n    \"LegislationCode\": { \"type\": [\"string\", \"null\"] },\n    \"Country\": { \"type\": \"string\" },\n    \"CategoryCode\": { \"type\": \"string\" },\n    \"SubCategoryCode\": { \"type\": [\"string\", \"null\"] },\n    \"TagList\": { \"type\": [\"string\", \"null\"] },\n    \"PersonId\": { \"type\": \"integer\" },\n    \"PersonNumber\": { \"type\": \"string\" },\n    \"ListName\": { \"type\": \"string\" },\n    \"DisplayName\": { \"type\": \"string\" },\n    \"FullName\": { \"type\": \"string\" },\n    \"DocumentCode\": { \"type\": \"string\" },\n    \"DocumentName\": { \"type\": \"string\" },\n    \"DocumentNumber\": { \"type\": [\"string\", \"null\"] },\n    \"DateFrom\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n    \"DateTo\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n    \"IssuingAuthority\": { \"type\": [\"string\", \"null\"] },\n    \"IssuingCountryName\": { \"type\": [\"string\", \"null\"] },\n    \"IssuedDate\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n    \"IssuingLocation\": { \"type\": [\"string\", \"null\"] },\n    \"Comments\": { \"type\": [\"string\", \"null\"] },\n    \"Publish\": { \"type\": [\"boolean\", \"null\"] },\n    \"PublishDate\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n    \"RelatedObjectId\": { \"type\": [\"integer\", \"null\"] },\n    \"RelatedObjectIdColumn\": { \"type\": [\"string\", \"null\"] },\n    \"RelatedObjectName\": { \"type\": [\"string\", \"null\"] },\n    \"CreatedBy\": { \"type\": \"string\" },\n    \"CreationDate\": { \"type\": \"string\", \"format\": \"date-time\" },\n    \"LastUpdatedBy\": { \"type\": \"string\" },\n    \"LastUpdateDate\": { \"type\": \"string\", \"format\": \"date-time\" },\n    \"IssuingCountry\": { \"type\": [\"string\", \"null\"] },\n    \"AssignmentId\": { \"type\": \"integer\" },\n    \"AssignmentNumber\": { \"type\": [\"string\", \"null\"] },\n    \"AssignmentName\": { \"type\": \"string\" },\n    \"CreationSource\": { \"type\": \"string\" },\n    \"AttachmentsCount\": { \"type\": \"integer\" },\n    \"EditAllowedFlag\": { \"type\": \"boolean\" },\n    \"DeleteAllowedFlag\": { \"type\": \"boolean\" },\n    \"Classification\": { \"type\": [\"string\", \"null\"] },\n    \"attachments\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"AttachedDocumentId\": { \"type\": \"integer\" },\n          \"LastUpdateDate\": { \"type\": \"string\", \"format\": \"date-time\" },\n          \"LastUpdatedBy\": { \"type\": \"string\" },\n          \"DatatypeCode\": { \"type\": \"string\" },\n          \"FileName\": { \"type\": \"string\" },\n          \"DmFolderPath\": { \"type\": [\"string\", \"null\"] },\n          \"DmDocumentId\": { \"type\": \"string\" },\n          \"DmVersionNumber\": { \"type\": \"string\" },\n          \"Url\": { \"type\": [\"string\", \"null\"] },\n          \"CategoryName\": { \"type\": \"string\" },\n          \"UserName\": { \"type\": \"string\" },\n          \"Uri\": { \"type\": [\"string\", \"null\"] },\n          \"FileUrl\": { \"type\": \"string\" },\n          \"UploadedText\": { \"type\": [\"string\", \"null\"] },\n          \"UploadedFileContentType\": { \"type\": [\"string\", \"null\"] },\n          \"UploadedFileLength\": { \"type\": \"integer\" },\n          \"UploadedFileName\": { \"type\": \"string\" },\n          \"ContentRepositoryFileShared\": { \"type\": \"string\" },\n          \"Title\": { \"type\": \"string\" },\n          \"Description\": { \"type\": \"string\" },\n          \"ErrorStatusCode\": { \"type\": [\"string\", \"null\"] },\n          \"ErrorStatusMessage\": { \"type\": [\"string\", \"null\"] },\n          \"CreatedBy\": { \"type\": \"string\" },\n          \"CreationDate\": { \"type\": \"string\", \"format\": \"date-time\" },\n          \"ExpirationDate\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n          \"LastUpdatedByUserName\": { \"type\": \"string\" },\n          \"CreatedByUserName\": { \"type\": \"string\" },\n          \"AsyncTrackerId\": { \"type\": [\"string\", \"null\"] },\n          \"DownloadInfo\": { \"type\": \"string\" },\n          \"PostProcessingAction\": { \"type\": [\"string\", \"null\"] },\n          \"links\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"rel\": { \"type\": \"string\" },\n                \"href\": { \"type\": \"string\" },\n                \"name\": { \"type\": \"string\" },\n                \"kind\": { \"type\": \"string\" }\n              },\n              \"required\": [\"rel\", \"href\", \"name\", \"kind\"]\n            }\n          }\n        },\n        \"required\": [\n          \"AttachedDocumentId\", \"LastUpdateDate\", \"LastUpdatedBy\", \"DatatypeCode\",\n          \"FileName\", \"DmDocumentId\", \"DmVersionNumber\", \"CategoryName\", \"UserName\", \"FileUrl\",\n          \"UploadedFileLength\", \"UploadedFileName\", \"ContentRepositoryFileShared\", \"Title\",\n          \"Description\", \"CreatedBy\", \"CreationDate\", \"LastUpdatedByUserName\", \"CreatedByUserName\",\n          \"DownloadInfo\", \"links\"\n        ]\n      }\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": { \"type\": \"string\" },\n          \"href\": { \"type\": \"string\" },\n          \"name\": { \"type\": \"string\" },\n          \"kind\": { \"type\": \"string\" },\n          \"properties\": {\n            \"type\": \"object\"\n          }\n        },\n        \"required\": [\"rel\", \"href\", \"name\", \"kind\"]\n      }\n    }\n  },\n  \"required\": [\n    \"DocumentsOfRecordId\", \"DocumentTypeId\", \"SystemDocumentType\", \"DocumentType\", \"Country\",\n    \"CategoryCode\", \"PersonId\", \"PersonNumber\", \"ListName\", \"DisplayName\", \"FullName\",\n    \"DocumentCode\", \"DocumentName\", \"CreatedBy\", \"CreationDate\", \"LastUpdatedBy\", \"LastUpdateDate\",\n    \"AssignmentId\", \"AssignmentName\", \"CreationSource\", \"AttachmentsCount\", \"EditAllowedFlag\",\n    \"DeleteAllowedFlag\", \"attachments\", \"links\"\n  ]\n}",
