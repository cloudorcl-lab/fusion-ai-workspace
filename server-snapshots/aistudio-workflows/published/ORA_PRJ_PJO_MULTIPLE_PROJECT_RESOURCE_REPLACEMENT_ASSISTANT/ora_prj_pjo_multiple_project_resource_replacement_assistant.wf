                    "sourceCode": "function trimString(value) { return String(value == null ? '' : value).trim(); }\nfunction normalizeKey(value) { return trimString(value).toLowerCase().replace(/[^a-z0-9]+/g, ''); }\nfunction parseMaybe(value) { var current = value; var depth = 0; while (typeof current === 'string' && trimString(current) !== '' && depth < 6) { try { current = JSON.parse(current); depth += 1; } catch (ignore1) { break; } } return current; }\nfunction extractItems(value) { var current = parseMaybe(value); var depth = 0; while (current && depth < 6) { if (Array.isArray(current)) { return current; } if (Array.isArray(current.items)) { return current.items; } if (current.output !== undefined) { current = parseMaybe(current.output); depth += 1; continue; } if (current.result !== undefined) { current = parseMaybe(current.result); depth += 1; continue; } break; } return []; }\nfunction firstValue(source, names) { source = source || {}; for (var i = 0; i < names.length; i++) { var value = source[names[i]]; if (value !== undefined && value !== null && String(value).trim() !== '') { return value; } } return null; }\nfunction toNumber(value) { var text; var num; if (value === null || value === undefined || value === '') { return null; } if (typeof value === 'number') { return isNaN(value) ? null : value; } text = trimString(value); if (!text) { return null; } if (/^\\(.+\\)$/.test(text)) { text = '-' + text.slice(1, -1); } text = text.replace(/[$,\\s]/g, ''); num = Number(text); return isNaN(num) ? null : num; }\nfunction addAmount(total, value) { var num = toNumber(value); if (num === null) { return total; } return total === null ? num : total + num; }\nfunction amountFromPlanning(item, names) { var planningRows = extractItems(item && item.PlanningAmounts !== undefined ? item.PlanningAmounts : []); var total = null; for (var i = 0; i < planningRows.length; i++) { total = addAmount(total, firstValue(planningRows[i] || {}, names)); } return total; }\nfunction firstNumberValue(source, names) { var value = firstValue(source, names); return toNumber(value) !== null ? value : null; }\nfunction valueOrFallback(value, fallback) { return toNumber(value) !== null ? value : fallback; }\nvar currentItem = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FETCH_CROSS_PROJECT_POST_COMMIT_PLANS_V1.$currentItem || {};\nvar planItems = extractItems((($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FETCH_CROSS_PROJECT_POST_COMMIT_PLANS_V1.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_GET_CROSS_PROJECT_POST_COMMIT_PLAN_V1 || {}).$output) || {});\nvar assignmentItems = extractItems((($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FETCH_CROSS_PROJECT_POST_COMMIT_PLANS_V1.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_GET_CROSS_PROJECT_POST_COMMIT_ASSIGNMENTS_V1 || {}).$output) || {});\nvar plan = planItems.length ? (planItems[0] || {}) : {};\nvar expectedNewId = trimString(currentItem.NewResourceElementId || currentItem.newResourceElementId || '');\nvar expectedNewName = trimString(currentItem.NewResourceName || currentItem.newResourceName || '');\nvar expectedNewKey = normalizeKey(expectedNewName);\nvar commitVerified = false;\nvar afterResourceName = '';\nvar afterQuantity = null;\nvar afterRawCost = null;\nvar afterBurdenedCost = null;\nvar afterRevenue = null;\nvar afterPlanRawCost = firstNumberValue(plan, ['PCRawCostAmounts', 'PFCRawCostAmounts', 'RawCostAmounts', 'RawCostInProjectCurrency', 'RawCostInProjectLedgerCurrency']);\nvar afterPlanBurdenedCost = firstNumberValue(plan, ['PCBurdenedCostAmounts', 'PFCBurdenedCostAmounts', 'BurdenedCostAmounts', 'BurdenedCostInProjectCurrency', 'BurdenedCostInProjectLedgerCurrency']);\nvar afterPlanRevenue = firstNumberValue(plan, ['PCRevenueAmounts', 'PFCRevenueAmounts', 'RevenueAmounts', 'RevenueInProjectCurrency', 'RevenueInProjectLedgerCurrency']);\nvar i;\nvar assignment;\nfor (i = 0; i < assignmentItems.length; i++) {\n  assignment = assignmentItems[i] || {};\n  if (trimString(assignment.RbsElementId || '') === expectedNewId || (expectedNewKey && normalizeKey(assignment.ResourceName || '') === expectedNewKey)) {\n    commitVerified = true;\n    afterResourceName = trimString(assignment.ResourceName || expectedNewName);\n    afterQuantity = addAmount(afterQuantity, amountFromPlanning(assignment, ['Quantity', 'PlannedQuantity']));\n    afterRawCost = addAmount(afterRawCost, amountFromPlanning(assignment, ['RawCostAmounts', 'PCRawCostAmounts', 'PFCRawCostAmounts', 'RawCostInProjectCurrency', 'RawCostInProjectLedgerCurrency', 'RawCost']));\n    afterBurdenedCost = addAmount(afterBurdenedCost, amountFromPlanning(assignment, ['BurdenedCostAmounts', 'PCBurdenedCostAmounts', 'PFCBurdenedCostAmounts', 'BurdenedCostInProjectCurrency', 'BurdenedCostInProjectLedgerCurrency', 'BurdenedCost']));\n    afterRevenue = addAmount(afterRevenue, amountFromPlanning(assignment, ['RevenueAmounts', 'PCRevenueAmounts', 'PFCRevenueAmounts', 'RevenueInProjectCurrency', 'RevenueInProjectLedgerCurrency', 'Revenue']));\n  }\n}\nreturn {\n  PlanVersionId: trimString(currentItem.PlanVersionId || currentItem.planVersionId || ''),\n  ProjectName: trimString(currentItem.ProjectName || currentItem.projectName || plan.ProjectName || plan.ProjectNumber || ''),\n  ProjectNumber: trimString(currentItem.ProjectNumber || currentItem.projectNumber || plan.ProjectNumber || ''),\n  ProjectId: trimString(currentItem.ProjectId || currentItem.projectId || plan.ProjectId || ''),\n  TaskId: trimString(currentItem.TaskId || ''),\n  TaskNumber: trimString(currentItem.TaskNumber || ''),\n  TaskName: trimString(currentItem.TaskName || ''),\n  BeforeQuantity: currentItem.BeforeQuantity,\n  AfterQuantity: afterQuantity,\n  BeforeRawCost: currentItem.BeforeRawCost,\n  AfterRawCost: valueOrFallback(afterPlanRawCost, afterRawCost),\n  BeforeBurdenedCost: currentItem.BeforeBurdenedCost,\n  AfterBurdenedCost: valueOrFallback(afterPlanBurdenedCost, afterBurdenedCost),\n  BeforeRevenue: currentItem.BeforeRevenue,\n  AfterRevenue: valueOrFallback(afterPlanRevenue, afterRevenue),\n  BeforeAssignmentRawCost: currentItem.BeforeAssignmentRawCost,\n  BeforeAssignmentBurdenedCost: currentItem.BeforeAssignmentBurdenedCost,\n  BeforeAssignmentRevenue: currentItem.BeforeAssignmentRevenue,\n  AfterAssignmentRawCost: afterRawCost,\n  AfterAssignmentBurdenedCost: afterBurdenedCost,\n  AfterAssignmentRevenue: afterRevenue,\n  BeforePlanRawCost: currentItem.BeforePlanRawCost,\n  BeforePlanBurdenedCost: currentItem.BeforePlanBurdenedCost,\n  BeforePlanRevenue: currentItem.BeforePlanRevenue,\n  AfterPlanRawCost: afterPlanRawCost,\n  AfterPlanBurdenedCost: afterPlanBurdenedCost,\n  AfterPlanRevenue: afterPlanRevenue,\n  BeforeMargin: currentItem.BeforeMargin,\n  AfterMargin: plan.Margin,\n  AfterResourceName: afterResourceName || expectedNewName,\n  CommitVerified: commitVerified\n};",
