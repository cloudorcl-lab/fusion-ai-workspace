            "name": "Format Across Projects Response",
            "returnType": "object",
            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\n\nfunction parseNumber(value) {\n  var text;\n  var num;\n  if (value === null || value === undefined || value === '') {\n    return null;\n  }\n  if (typeof value === 'number') {\n    return isNaN(value) ? null : value;\n  }\n  text = trimString(value);\n  if (!text) {\n    return null;\n  }\n  if (/^\\(.+\\)$/.test(text)) {\n    text = '-' + text.slice(1, -1);\n  }\n  text = text.replace(/[$,\\s]/g, '');\n  num = Number(text);\n  return isNaN(num) ? null : num;\n}\n\nfunction formatEffort(value) {\n  var num = parseNumber(value);\n  var text;\n  if (num === null) {\n    return 'N/A';\n  }\n  text = Math.abs(num - Math.round(num)) < 0.005 ? String(Math.round(num)) : num.toFixed(2);\n  return text;\n}\n\nfunction normalizeTokens(value) {\n  return trimString(value).toLowerCase().replace(/\\b(?:mr|mrs|ms|miss|dr)\\.?/g, ' ').replace(/[^a-z0-9]+/g, ' ').trim().split(/\\s+/).filter(Boolean);\n}\n\nfunction normalizeKey(value) {\n  return normalizeTokens(value).join('');\n}\n\nfunction scoreName(requested, candidateNameValue) {\n  var requestedTokens = normalizeTokens(requested);\n  var candidateTokens = normalizeTokens(candidateNameValue);\n  var requestedKey = requestedTokens.join('');\n  var candidateKey = candidateTokens.join('');\n  var startsWithRequested = requestedTokens.length === 1 && candidateTokens.length && candidateTokens[0] === requestedTokens[0];\n  var reqStem;\n  var candStem;\n  if (!requestedKey || !candidateKey) {\n    return 0;\n  }\n  if (candidateKey === requestedKey) {\n    return 70;\n  }\n  if (startsWithRequested) {\n    return 60;\n  }\n  if (requestedTokens.length === 1 && candidateTokens.length) {\n    reqStem = requestedTokens[0].replace(/(ant|ing|er|or|s)$/,'');\n    candStem = candidateTokens[0].replace(/(ant|ing|er|or|s)$/,'');\n    if (reqStem.length >= 5 && candStem.indexOf(reqStem) === 0) {\n      return 55;\n    }\n  }\n  if (candidateKey.indexOf(requestedKey) > -1 || requestedKey.indexOf(candidateKey) > -1) {\n    return /^\\s*(labor|expense|expenses|equipment|material|financial)\\s*:/i.test(trimString(candidateNameValue)) ? 35 : 40;\n  }\n  return 0;\n}\n\nfunction parseObjectMaybe(value) {\n  var current = value;\n  var depth = 0;\n  while (typeof current === 'string' && trimString(current) !== '' && depth < 6) {\n    try {\n      current = JSON.parse(current);\n      depth += 1;\n    } catch (ignore1) {\n      break;\n    }\n  }\n  return current;\n}\n\nfunction extractItems(value) {\n  var current = parseObjectMaybe(value);\n  var depth = 0;\n  while (current && depth < 6) {\n    if (Array.isArray(current)) {\n      return current;\n    }\n    if (Array.isArray(current.items)) {\n      return current.items;\n    }\n    if (current.output !== undefined) {\n      current = parseObjectMaybe(current.output);\n      depth += 1;\n      continue;\n    }\n    if (current.result !== undefined) {\n      current = parseObjectMaybe(current.result);\n      depth += 1;\n      continue;\n    }\n    break;\n  }\n  return [];\n}\n\nfunction extractLoopRows(value) {\n  var parsed = parseObjectMaybe(value);\n  var rows = [];\n  var i;\n  var item;\n  if (Array.isArray(parsed)) {\n    for (i = 0; i < parsed.length && rows.length < 40; i++) {\n      item = parseObjectMaybe(parsed[i]);\n      if (item && item.result !== undefined) {\n        item = parseObjectMaybe(item.result);\n      } else if (item && item.output !== undefined) {\n        item = parseObjectMaybe(item.output);\n      }\n      if (item && typeof item === 'object') {\n        rows.push(item);\n      }\n    }\n  }\n  return rows;\n}\n\nfunction firstValue(source, names) {\n  source = source || {};\n  for (var i = 0; i < names.length; i++) {\n    var value = source[names[i]];\n    if (value !== undefined && value !== null && String(value).trim() !== '') {\n      return value;\n    }\n  }\n  return null;\n}\n\nfunction addAmount(total, value) {\n  var num = parseNumber(value);\n  if (num === null) {\n    return total;\n  }\n  return total === null ? num : total + num;\n}\n\nfunction amountFromPlanning(item, names) {\n  var planningRows = extractItems(item && item.PlanningAmounts !== undefined ? item.PlanningAmounts : []);\n  var total = null;\n  var i;\n  for (i = 0; i < planningRows.length; i++) {\n    total = addAmount(total, firstValue(planningRows[i] || {}, names));\n  }\n  return total;\n}\n\nfunction normalizeDate(value) {\n  var raw = trimString(value);\n  var match;\n  if (!raw) {\n    return '';\n  }\n  match = raw.match(/(\\d{4})[-\\/](\\d{1,2})[-\\/](\\d{1,2})/);\n  if (match) {\n    return match[1] + '-' + (match[2].length === 1 ? '0' + match[2] : match[2]) + '-' + (match[3].length === 1 ? '0' + match[3] : match[3]);\n  }\n  return raw;\n}\n\nfunction monthIndex(dateText) {\n  var dateValue = normalizeDate(dateText);\n  var match = dateValue.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);\n  if (!match) {\n    return null;\n  }\n  return Number(match[1]) * 12 + Number(match[2]) - 1;\n}\n\nfunction compareDates(left, right) {\n  left = normalizeDate(left);\n  right = normalizeDate(right);\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(left) || !/^\\d{4}-\\d{2}-\\d{2}$/.test(right)) {\n    return null;\n  }\n  if (left === right) {\n    return 0;\n  }\n  return left < right ? -1 : 1;\n}\n\nfunction monthCountInclusive(startDate, endDate) {\n  var startIndex = monthIndex(startDate);\n  var endIndex = monthIndex(endDate);\n  if (startIndex === null || endIndex === null || endIndex < startIndex) {\n    return null;\n  }\n  return endIndex - startIndex + 1;\n}\n\nfunction remainingEffort(quantity, startDate, endDate, effectiveDate) {\n  var planned = parseNumber(quantity);\n  var start = normalizeDate(startDate);\n  var end = normalizeDate(endDate);\n  var effective = normalizeDate(effectiveDate);\n  var totalMonths;\n  var remainingMonths;\n  if (planned === null) {\n    return null;\n  }\n  if (!effective || !end || !/^\\d{4}-\\d{2}-\\d{2}$/.test(effective) || !/^\\d{4}-\\d{2}-\\d{2}$/.test(end)) {\n    return planned;\n  }\n  if (compareDates(effective, end) > 0) {\n    return null;\n  }\n  if (!start || !/^\\d{4}-\\d{2}-\\d{2}$/.test(start) || compareDates(effective, start) <= 0) {\n    return planned;\n  }\n  totalMonths = monthCountInclusive(start, end);\n  remainingMonths = monthCountInclusive(effective, end);\n  if (totalMonths === null || remainingMonths === null || totalMonths <= 0) {\n    return planned;\n  }\n  return planned * remainingMonths / totalMonths;\n}\n\nfunction daysBetween(startDate, endDate) {\n  var start = normalizeDate(startDate);\n  var end = normalizeDate(endDate);\n  var startTime;\n  var endTime;\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(start) || !/^\\d{4}-\\d{2}-\\d{2}$/.test(end)) {\n    return null;\n  }\n  startTime = Date.UTC(Number(start.slice(0, 4)), Number(start.slice(5, 7)) - 1, Number(start.slice(8, 10)));\n  endTime = Date.UTC(Number(end.slice(0, 4)), Number(end.slice(5, 7)) - 1, Number(end.slice(8, 10)));\n  return Math.floor((endTime - startTime) / 86400000);\n}\n\nfunction assignmentSortRank(item, effectiveDate) {\n  var start = normalizeDate(item.AssignmentStartDate || item.startDate || '');\n  var end = normalizeDate(item.AssignmentEndDate || item.endDate || '');\n  var effective = normalizeDate(effectiveDate);\n  var days;\n  if (start && end && compareDates(start, effective) <= 0 && compareDates(effective, end) <= 0) {\n    return 0;\n  }\n  if (start && compareDates(start, effective) > 0) {\n    days = daysBetween(effective, start);\n    return days !== null && days <= 30 ? 1 : 2;\n  }\n  return 3;\n}\n\nfunction dateDisplay(value) {\n  var normalized = normalizeDate(value);\n  var match = normalized.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);\n  if (!match) {\n    return trimString(value) || 'N/A';\n  }\n  return match[2] + '/' + match[3] + '/' + match[1];\n}\n\nfunction longDateDisplay(value) {\n  var normalized = normalizeDate(value);\n  var monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];\n  var match = normalized.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);\n  if (!match) {\n    return trimString(value) || 'the effective date';\n  }\n  return monthNames[Number(match[2]) - 1] + ' ' + String(Number(match[3])) + ', ' + match[1];\n}\n\nfunction tableText(value) {\n  var text = trimString(value);\n  return text ? text.replace(/\\|/g, '/') : 'N/A';\n}\n\nfunction extractPlanBackedRows(value) {\n  var plans = extractItems(value);\n  var rows = [];\n  var i;\n  var j;\n  var plan;\n  var assignmentItems;\n  var item;\n  var assignments;\n  var quantity;\n  var rawCost;\n  var burdenedCost;\n  var revenue;\n  for (i = 0; i < plans.length && rows.length < 40; i++) {\n    plan = parseObjectMaybe(plans[i]) || {};\n    assignmentItems = extractItems(plan.ResourceAssignments || []);\n    assignments = [];\n    for (j = 0; j < assignmentItems.length && assignments.length < 100; j++) {\n      item = parseObjectMaybe(assignmentItems[j]) || {};\n      quantity = amountFromPlanning(item, ['PlannedQuantity', 'Quantity']);\n      if (quantity === null) {\n        quantity = parseNumber(firstValue(item, ['PlannedQuantity', 'Quantity']));\n      }\n      rawCost = amountFromPlanning(item, ['RawCostAmounts', 'PCRawCostAmounts', 'PFCRawCostAmounts', 'RawCostInProjectCurrency', 'RawCostInProjectLedgerCurrency', 'RawCost']);\n      burdenedCost = amountFromPlanning(item, ['BurdenedCostAmounts', 'PCBurdenedCostAmounts', 'PFCBurdenedCostAmounts', 'BurdenedCostInProjectCurrency', 'BurdenedCostInProjectLedgerCurrency', 'BurdenedCost']);\n      revenue = amountFromPlanning(item, ['RevenueAmounts', 'PCRevenueAmounts', 'PFCRevenueAmounts', 'RevenueInProjectCurrency', 'RevenueInProjectLedgerCurrency', 'Revenue']);\n      assignments.push({\n        taskId: trimString(item.TaskId || ''),\n        taskNumber: trimString(item.TaskNumber || ''),\n        taskName: trimString(item.TaskName || ''),\n        resourceName: trimString(item.ResourceName || ''),\n        resourceElementId: trimString(item.RbsElementId || ''),\n        oldResourceElementId: trimString(item.RbsElementId || ''),\n        planningElementId: trimString(item.PlanningElementId || ''),\n        quantity: quantity,\n        plannedEffort: quantity,\n        rawCost: rawCost,\n        burdenedCost: burdenedCost,\n        revenue: revenue,\n        startDate: trimString(firstValue(item, ['PlanningStartDate', 'AssignmentStartDate', 'PlannedStartDate', 'PlanStartDate', 'StartDate', 'BaselineStartDate']) || ''),\n        endDate: trimString(firstValue(item, ['PlanningFinishDate', 'PlanningEndDate', 'AssignmentEndDate', 'PlannedFinishDate', 'PlanFinishDate', 'FinishDate', 'EndDate', 'BaselineFinishDate']) || '')\n      });\n    }\n    rows.push({\n      projectName: trimString(plan.ProjectName || plan.ProjectNumber || ''),\n      projectNumber: trimString(plan.ProjectNumber || ''),\n      projectId: trimString(plan.ProjectId || ''),\n      planVersionId: trimString(plan.PlanVersionId || ''),\n      quantity: firstValue(plan, ['PlannedEffort', 'BaselineEffort']),\n      rawCost: firstValue(plan, ['PCRawCostAmounts', 'PFCRawCostAmounts', 'RawCostAmounts', 'RawCostInProjectCurrency', 'RawCostInProjectLedgerCurrency', 'BaselineRawCostInProjectCurrency', 'BaselineRawCostInProjectLedgerCurrency']),\n      burdenedCost: firstValue(plan, ['PCBurdenedCostAmounts', 'PFCBurdenedCostAmounts', 'BurdenedCostAmounts', 'BurdenedCostInProjectCurrency', 'BurdenedCostInProjectLedgerCurrency', 'BaselineBurdenedCostInProjectCurrency', 'BaselineBurdenedCostInProjectLedgerCurrency']),\n      revenue: firstValue(plan, ['PCRevenueAmounts', 'PFCRevenueAmounts', 'RevenueAmounts', 'RevenueInProjectCurrency', 'RevenueInProjectLedgerCurrency', 'BaselineRevenueInProjectCurrency', 'BaselineRevenueInProjectLedgerCurrency']),\n      margin: firstValue(plan, ['Margin', 'MarginPercentage']),\n      assignmentCount: assignments.length,\n      assignments: assignments,\n      namedPersonElements: []\n    });\n  }\n  return rows;\n}\n\nfunction uniqueNames(values) {\n  var seen = {};\n  var list = [];\n  var i;\n  var name;\n  var key;\n  for (i = 0; i < values.length; i++) {\n    name = trimString(values[i]);\n    key = normalizeKey(name);\n    if (!name || !key || seen[key]) {\n      continue;\n    }\n    seen[key] = true;\n    list.push(name);\n  }\n  return list;\n}\n\nfunction resolveName(requested, names) {\n  var best = '';\n  var bestScore = 0;\n  var tie = false;\n  var i;\n  var name;\n  var nameKey;\n  var score;\n  for (i = 0; i < names.length; i++) {\n    name = trimString(names[i]);\n    nameKey = normalizeKey(name);\n    score = scoreName(requested, name);\n    if (!nameKey || !score) {\n      continue;\n    }\n    if (score > bestScore) {\n      best = name;\n      bestScore = score;\n      tie = false;\n    } else if (score === bestScore && normalizeKey(best) !== nameKey) {\n      tie = true;\n    }\n  }\n  if (!best || tie) {\n    return '';\n  }\n  return best;\n}\n\nfunction parsePendingPayload(value) {\n  var raw = trimString(value);\n  var current;\n  if (!raw) {\n    return {};\n  }\n  try {\n    raw = decodeURIComponent(raw);\n  } catch (ignore0) {}\n  current = parseObjectMaybe(raw);\n  return current && typeof current === 'object' && !Array.isArray(current) ? current : {};\n}\n\nfunction ordinalIndex(text, count) {\n  var lower = trimString(text).toLowerCase();\n  var numMatch = lower.match(/(?:^|\\b)(\\d+)(?:\\b|$)/);\n  if (/^(first|one|option one|option 1)$/i.test(lower)) {\n    return count >= 1 ? 0 : -1;\n  }\n  if (/^(second|two|option two|option 2)$/i.test(lower)) {\n    return count >= 2 ? 1 : -1;\n  }\n  if (/^(third|three|option three|option 3)$/i.test(lower)) {\n    return count >= 3 ? 2 : -1;\n  }\n  if (/^(fourth|four|option four|option 4)$/i.test(lower)) {\n    return count >= 4 ? 3 : -1;\n  }\n  if (/^(fifth|five|option five|option 5)$/i.test(lower)) {\n    return count >= 5 ? 4 : -1;\n  }\n  if (/^(last|final)$/i.test(lower)) {\n    return count > 0 ? count - 1 : -1;\n  }\n  if (numMatch) {\n    var n = Number(numMatch[1]);\n    return n >= 1 && n <= count ? n - 1 : -1;\n  }\n  return -1;\n}\n\nfunction matchingOptions(requested, names) {\n  var scored = [];\n  var i;\n  var name;\n  var score;\n  var seen = {};\n  var key;\n  for (i = 0; i < names.length; i++) {\n    name = trimString(names[i]);\n    key = normalizeKey(name);\n    if (!key || seen[key]) {\n      continue;\n    }\n    seen[key] = true;\n    score = scoreName(requested, name);\n    if (score > 0) {\n      scored.push({ name: name, score: score, order: i });\n    }\n  }\n  scored.sort(function(a, b) {\n    if (b.score !== a.score) {\n      return b.score - a.score;\n    }\n    return a.order - b.order;\n  });\n  var out = [];\n  for (i = 0; i < scored.length && out.length < 8; i++) {\n    out.push(scored[i].name);\n  }\n  return out;\n}\n\nfunction isBroadResourceTerm(value) {\n  var tokens = normalizeTokens(value);\n  var first = tokens.length ? tokens[0] : '';\n  return tokens.length <= 1 && /^(consultant|consulting|consult|engineer|manager|analyst|architect|developer|designer|resource|labor)$/.test(first);\n}\n\nfunction selectResourceChoice(message, options) {\n  var idx = ordinalIndex(message, options.length);\n  var msgKey = normalizeKey(message);\n  var i;\n  var optKey;\n  if (idx >= 0) {\n    return options[idx] || '';\n  }\n  for (i = 0; i < options.length; i++) {\n    optKey = normalizeKey(options[i]);\n    if (msgKey && optKey && (msgKey === optKey || optKey.indexOf(msgKey) > -1 || msgKey.indexOf(optKey) > -1)) {\n      return options[i];\n    }\n  }\n  return '';\n}\n\nfunction shouldAskForResource(requested, options, resolvedName, alreadySelected) {\n  if (alreadySelected || options.length <= 1) {\n    return false;\n  }\n  if (!resolvedName) {\n    return true;\n  }\n  return isBroadResourceTerm(requested);\n}\n\nfunction buildClarificationResult(target, requestedOld, requestedNew, oldResolved, newResolved, options, invalidReply, effectiveDate) {\n  var label = target === 'old' ? 'current resource' : 'replacement resource';\n  var requested = target === 'old' ? requestedOld : requestedNew;\n  var lines = [];\n  var i;\n  for (i = 0; i < options.length; i++) {\n    lines.push('| ' + String(i + 1) + ' | ' + options[i].replace(/\\|/g, '/') + ' |');\n  }\n  var payload = {\n    type: 'RESOURCE_NAME_CLARIFICATION',\n    target: target,\n    requestedOld: requestedOld,\n    requestedNew: requestedNew,\n    oldResolved: oldResolved || '',\n    newResolved: newResolved || '',\n    effectiveDate: effectiveDate || '',\n    candidates: options\n  };\n  var result = {\n    response: (invalidReply ? 'I could not match that selection. ' : '') + 'I found multiple possible ' + label + ' names for \"' + requested + '\". Select the correct resource.' + String.fromCharCode(10) + String.fromCharCode(10) + '| S No. | Resource Name |' + String.fromCharCode(10) + '| --- | --- |' + String.fromCharCode(10) + lines.join(String.fromCharCode(10)) + String.fromCharCode(10) + String.fromCharCode(10) + 'Reply with an option number, first/second/last, or the exact resource name.',\n    intentStart: 'Y',\n    intentEnd: 'N',\n    pendingAction: 'RESOURCE_NAME_CLARIFICATION',\n    pendingItemsJson: encodeURIComponent(JSON.stringify(payload)),\n    pendingProjectName: '',\n    pendingOldResourceName: oldResolved || requestedOld,\n    pendingNewResourceName: newResolved || requestedNew,\n    pendingUnavailabilityDate: effectiveDate || '',\n    nextStage: 'RESOURCE_NAME_CLARIFICATION'\n  };\n  return result;\n}\n\nfunction candidateName(candidate) {\n  return trimString(candidate.resourceName || candidate.ResourceName || candidate.personName || candidate.PersonName || '');\n}\n\nfunction candidateElementId(candidate) {\n  return trimString(candidate.resourceElementId || candidate.ResourceElementId || candidate.rbsElementId || candidate.RbsElementId || '');\n}\n\nfunction candidateProjectId(candidate) {\n  return trimString(candidate.projectId || candidate.ProjectId || '');\n}\n\nfunction isDisabled(candidate) {\n  return candidate.disabledFlag === true || candidate.disabledFlag === 'Y' || candidate.DisabledFlag === true || candidate.DisabledFlag === 'Y';\n}\n\nfunction pickBestCandidate(candidates, requestedName, resolvedName, rowProjectId, requireSameProject) {\n  var best = null;\n  var bestScore = 0;\n  var bestKey = '';\n  var tie = false;\n  var i;\n  var candidate;\n  var name;\n  var nameKey;\n  var projectId;\n  var elementId;\n  var score;\n  var resolvedScore;\n  var requestedScore;\n  for (i = 0; i < candidates.length; i++) {\n    candidate = candidates[i] || {};\n    if (isDisabled(candidate)) {\n      continue;\n    }\n    name = candidateName(candidate);\n    nameKey = normalizeKey(name);\n    elementId = candidateElementId(candidate);\n    projectId = candidateProjectId(candidate);\n    if (!nameKey || !elementId) {\n      continue;\n    }\n    if (requireSameProject && rowProjectId && projectId && projectId !== rowProjectId) {\n      continue;\n    }\n    resolvedScore = resolvedName ? scoreName(resolvedName, name) : 0;\n    resolvedScore = resolvedScore ? resolvedScore + 5 : 0;\n    requestedScore = scoreName(requestedName, name);\n    score = resolvedScore > requestedScore ? resolvedScore : requestedScore;\n    if (!score) {\n      continue;\n    }\n    score += projectId && rowProjectId && projectId === rowProjectId ? 2 : 0;\n    if (score > bestScore) {\n      best = candidate;\n      bestScore = score;\n      bestKey = nameKey;\n      tie = false;\n    } else if (score === bestScore && bestKey !== nameKey) {\n      tie = true;\n    }\n  }\n  if (!best || tie) {\n    return null;\n  }\n  return best;\n}\n\nfunction buildReplacementMap(newCandidates, requestedName, resolvedName) {\n  var map = {};\n  var i;\n  var candidate;\n  var projectId;\n  var name;\n  var nameKey;\n  var elementId;\n  var score;\n  var existing;\n  for (i = 0; i < newCandidates.length; i++) {\n    candidate = newCandidates[i] || {};\n    projectId = candidateProjectId(candidate);\n    name = candidateName(candidate);\n    nameKey = normalizeKey(name);\n    elementId = candidateElementId(candidate);\n    if (!projectId || !nameKey || !elementId || isDisabled(candidate)) {\n      continue;\n    }\n    score = scoreName(resolvedName || requestedName, name) || scoreName(requestedName, name);\n    if (!score) {\n      continue;\n    }\n    existing = map[projectId];\n    if (!existing || score > existing.score) {\n      map[projectId] = { candidate: candidate, score: score, key: nameKey, tie: false };\n    } else if (score === existing.score && existing.key !== nameKey) {\n      existing.tie = true;\n    }\n  }\n  return map;\n}\n\nfunction candidateToReplacement(candidate) {\n  if (!candidate) {\n    return null;\n  }\n  return {\n    resourceName: candidateName(candidate),\n    resourceElementId: candidateElementId(candidate)\n  };\n}\n\nfunction pickReplacement(row, requestedName, resolvedName, replacementsByProject) {\n  var candidates = Array.isArray(row.namedPersonElements) ? row.namedPersonElements : [];\n  var assignments = Array.isArray(row.assignments) ? row.assignments : [];\n  var rowProjectId = trimString(row.projectId || row.ProjectId || '');\n  var mapped = rowProjectId ? replacementsByProject[rowProjectId] : null;\n  var candidate;\n  if (mapped && !mapped.tie) {\n    return candidateToReplacement(mapped.candidate);\n  }\n  candidate = pickBestCandidate(candidates, requestedName, resolvedName, rowProjectId, false);\n  if (!candidate) {\n    candidate = pickBestCandidate(assignments, requestedName, resolvedName, rowProjectId, false);\n  }\n  return candidateToReplacement(candidate);\n}\n\nfunction taskLabel(item) {\n  var number = trimString(item.taskNumber || item.TaskNumber || '');\n  var name = trimString(item.taskName || item.TaskName || '');\n  return (number ? number + ' - ' : '') + name;\n}\n\nvar loopRows = extractLoopRows((($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FETCH_ACROSS_PROJECT_ASSIGNMENTS_V1 || {}).$output) || []);\nvar planBackedRows = extractPlanBackedRows((($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FETCH_ACROSS_PROJECTS || {}).$output) || {});\nif (!loopRows.length && planBackedRows.length) {\n  loopRows = planBackedRows;\n}\nvar oldCandidates = extractItems((($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FETCH_ACROSS_PROJECTS_OLD_RESOURCE_CANDIDATES_V1 || {}).$output) || {});\nvar newCandidates = extractItems((($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FETCH_ACROSS_PROJECTS_NEW_RESOURCE_CANDIDATES_V1 || {}).$output) || {});\nvar buildContext = (($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_BUILD_ACROSS_PROJECTS_FILTER_V1 || {}).$output || {}).result || {};\nvar state = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_EFFECTIVE_STATE_V2.$output.result || $context.$variables || {};\nvar pendingAction = trimString(state.PendingAction || $context.$variables.PendingAction || '');\nvar pendingPayload = pendingAction === 'RESOURCE_NAME_CLARIFICATION' ? parsePendingPayload(state.PendingReplacementItemsJson || $context.$variables.PendingReplacementItemsJson || '') : {};\nvar currentMessage = trimString(state.EffectiveInputMessage || '');\nvar effectiveDate = normalizeDate(buildContext.effectiveDate || pendingPayload.effectiveDate || state.UnavailabilityDate || $context.$variables.UnavailabilityDate || '');\nvar requestedOld = trimString(buildContext.requestedOldResourceName || pendingPayload.oldResolved || pendingPayload.requestedOld || $context.$variables.ResourceName || '');\nvar requestedNew = trimString(buildContext.requestedNewResourceName || pendingPayload.newResolved || pendingPayload.requestedNew || $context.$variables.ReplacementResourceName || '');\nvar oldNames = [];\n