            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\n\nfunction pad2(value) {\n  value = parseInt(value, 10);\n  return (value < 10 ? '0' : '') + value;\n}\n\nfunction normalizeDate(rawValue) {\n  var raw = trimString(rawValue);\n  var months = {\n    jan: '01', january: '01',\n    feb: '02', february: '02',\n    mar: '03', march: '03',\n    apr: '04', april: '04',\n    may: '05',\n    jun: '06', june: '06',\n    jul: '07', july: '07',\n    aug: '08', august: '08',\n    sep: '09', sept: '09', september: '09',\n    oct: '10', october: '10',\n    nov: '11', november: '11',\n    dec: '12', december: '12'\n  };\n  var parts;\n  var key;\n\n  if (!raw) {\n    return '';\n  }\n\n  raw = raw.replace(/,/g, ' ').replace(/(\\d+)(st|nd|rd|th)\\b/gi, '$1').replace(/\\s+/g, ' ').trim();\n\n  parts = raw.match(/^(\\d{4})[-\\/](\\d{1,2})[-\\/](\\d{1,2})$/);\n  if (parts) {\n    return parts[1] + '-' + pad2(parts[2]) + '-' + pad2(parts[3]);\n  }\n\n  parts = raw.match(/^(\\d{1,2})[-\\/](\\d{1,2})[-\\/](\\d{4})$/);\n  if (parts) {\n    return parts[3] + '-' + pad2(parts[1]) + '-' + pad2(parts[2]);\n  }\n\n  parts = raw.toLowerCase().match(/^([a-z]+)\\s+(\\d{1,2})\\s+(\\d{4})$/);\n  if (parts) {\n    key = parts[1];\n    if (months[key]) {\n      return parts[3] + '-' + months[key] + '-' + pad2(parts[2]);\n    }\n  }\n\n  parts = raw.toLowerCase().match(/^(\\d{1,2})\\s+([a-z]+)\\s+(\\d{4})$/);\n  if (parts) {\n    key = parts[2];\n    if (months[key]) {\n      return parts[3] + '-' + months[key] + '-' + pad2(parts[1]);\n    }\n  }\n\n  return '';\n}\n\nfunction extractInlineDate(value) {\n  var text = String(value || '');\n  var match =\n    text.match(/\\b\\d{4}[-\\/]\\d{1,2}[-\\/]\\d{1,2}\\b/) ||\n    text.match(/\\b\\d{1,2}[-\\/]\\d{1,2}[-\\/]\\d{4}\\b/) ||\n    text.match(/\\b[A-Za-z]+\\s+\\d{1,2}(?:st|nd|rd|th)?(?:,)?\\s+\\d{4}\\b/i) ||\n    text.match(/\\b\\d{1,2}\\s+[A-Za-z]+(?:,)?\\s+\\d{4}\\b/i);\n  return match ? trimString(match[0] || '') : '';\n}\n\nfunction isFullReplacementReply(text) {\n  var lower = trimString(text).toLowerCase();\n\n  if (!lower) {\n    return false;\n  }\n\n  if (\n    lower === 'full' ||\n    lower === 'full replacement' ||\n    lower === 'complete replacement' ||\n    lower === 'entire replacement' ||\n    lower === 'replace fully' ||\n    lower === 'immediately' ||\n    lower === 'all' ||\n    lower === 'all assignments' ||\n    lower === 'all tasks'\n  ) {\n    return true;\n  }\n\n  if (lower.indexOf('full replacement') > -1) {\n    return true;\n  }\n\n  if (lower.indexOf('no effective date') > -1 || lower.indexOf('no unavailability date') > -1) {\n    return true;\n  }\n\n  if (\n    lower.indexOf('without effective date') > -1 ||\n    lower.indexOf('without an effective date') > -1 ||\n    lower.indexOf('without unavailability date') > -1 ||\n    lower.indexOf('without an unavailability date') > -1\n  ) {\n    return true;\n  }\n\n  return false;\n}\n\nfunction parsePendingPayload(value) {\n  var raw = trimString(value);\n  var current;\n  var depth = 0;\n  if (!raw) {\n    return {};\n  }\n  try {\n    raw = decodeURIComponent(raw);\n  } catch (ignore0) {}\n  current = raw;\n  while (typeof current === 'string' && trimString(current) !== '' && depth < 6) {\n    try {\n      current = JSON.parse(current);\n      depth += 1;\n    } catch (ignore1) {\n      break;\n    }\n  }\n  return current && typeof current === 'object' && !Array.isArray(current) ? current : {};\n}\n\nvar parsed = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_NORMALIZE_REQUEST_V4.$output.result || {};\nvar state = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_EFFECTIVE_STATE_V2.$output.result || $context.$variables || {};\nvar stage = trimString(state.ReplacementStage || '');\nvar reuseState = String(parsed.reason || '').indexOf('ACTIVE_INTENT_LOCK:') === 0;\nvar pendingAction = trimString(state.PendingAction || '');\nvar currentMessage = trimString(state.EffectiveInputMessage || '');\nvar currentLower = currentMessage.toLowerCase();\nvar rawDate = trimString(parsed.unavailabilityDate || (reuseState ? state.UnavailabilityDate || '' : ''));\nvar inlineDate = extractInlineDate(currentMessage);\nvar crossProjectSignal = /\\bacross\\s+all\\s+projects\\b|\\ball\\s+projects\\b/i.test(currentLower);\nvar parsedIntent = trimString(parsed.intent || 'OUT_OF_SCOPE');\nvar isAcrossProjectIntent = parsedIntent === 'REPLACE_RESOURCE_ACROSS_ALL_PROJECTS' || crossProjectSignal;\nvar crossProjectSelectionPending = pendingAction === 'CROSS_PROJECT_COMMIT' && stage === 'CROSS_PROJECT_APPROVAL' && currentMessage !== '' && !/^(no|n|cancel|stop|skip|not now|later)$/i.test(currentLower);\nvar crossProjectBudgetPending = pendingAction === 'CROSS_PROJECT_BUDGET_FOLLOWUP_CONFIRM' || pendingAction === 'CROSS_PROJECT_BUDGET_PROJECT_SELECTION';\nvar selectionApproval = false;\nvar hasPendingApproval = (!!parsed.approvalAction || crossProjectSelectionPending) && pendingAction && pendingAction !== 'BUDGET_SYNC_CONFIRM' && pendingAction !== 'BUDGET_GENERATE_CONFIRM' && pendingAction !== 'BUDGET_FOLLOWUP_CONFIRM';\nvar explicitSwap = /^replace\\s+.+\\s+with\\s+.+/i.test(currentMessage);\nvar unavailableSignal = /\\b(terminated|termination|long\\s+leave|unavailable|backfill)\\b/i.test(currentLower);\nvar directTimingDecisionStage = stage === 'DIRECT_REPLACEMENT_DECISION';\nvar collectingUnavailableInputs = reuseState && parsedIntent === 'REPLACE_UNAVAILABLE_RESOURCE' && !trimString(state.ResourceName || '') && !trimString(state.UnavailabilityDate || '') && !trimString(state.ReplacementResourceName || '') && !explicitSwap;\nvar pendingPayload = pendingAction === 'RESOURCE_NAME_CLARIFICATION' ? parsePendingPayload(state.PendingReplacementItemsJson || '') : {};\nvar normalizedDate;\nvar result;\n\nif (!rawDate && (stage === 'CROSS_PROJECT_EFFECTIVE_DATE' || isAcrossProjectIntent)) {\n  rawDate = inlineDate || currentMessage;\n}\nnormalizedDate = normalizeDate(rawDate);\nif (!normalizedDate && stage === 'CROSS_PROJECT_EFFECTIVE_DATE' && (inlineDate || currentMessage)) {\n  rawDate = inlineDate || currentMessage;\n  normalizedDate = normalizeDate(rawDate);\n}\n\nresult = {\n  intent: isAcrossProjectIntent ? 'REPLACE_RESOURCE_ACROSS_ALL_PROJECTS' : parsedIntent,\n  projectName: trimString(parsed.projectName || (reuseState ? state.ProjectName || '' : '')),\n  resourceName: trimString(parsed.resourceName || (reuseState ? state.ResourceName || '' : '')),\n  replacementResourceName: trimString(parsed.replacementResourceName || (reuseState ? state.ReplacementResourceName || '' : '')),\n  roleName: trimString(parsed.roleName || (reuseState ? state.RoleName || '' : '')),\n  unavailabilityDate: normalizedDate,\n  approvalAction: (!!parsed.approvalAction || crossProjectSelectionPending) && !selectionApproval,\n  isApproval: hasPendingApproval,\n  canProceed: true,\n  budgetSyncAction: '',\n  nextStage: null\n};\n\nif (/^[^A-Za-z0-9]+$/.test(result.projectName || '')) {\n  result.projectName = '';\n}\nif (/^[^A-Za-z0-9]+$/.test(result.resourceName || '')) {\n  result.resourceName = '';\n}\nif (/^[^A-Za-z0-9]+$/.test(result.replacementResourceName || '')) {\n  result.replacementResourceName = '';\n}\nif (/^[^A-Za-z0-9]+$/.test(result.roleName || '')) {\n  result.roleName = '';\n}\n\nvar normalizeLooseKey = function(value) { return trimString(value).toLowerCase().replace(/[^a-z0-9]+/g, ''); };\nif (result.projectName && result.resourceName && !result.replacementResourceName && !result.roleName) {\n  var normalizedProjectKey = normalizeLooseKey(result.projectName);\n  var normalizedResourceKey = normalizeLooseKey(result.resourceName);\n  if (normalizedProjectKey && normalizedResourceKey && normalizedProjectKey.indexOf(normalizedResourceKey) === 0) {\n    result.resourceName = '';\n  }\n}\n\nif (collectingUnavailableInputs && result.resourceName && result.replacementResourceName && result.resourceName.toLowerCase() === result.replacementResourceName.toLowerCase()) {\n  result.replacementResourceName = '';\n}\n\nif (result.intent === 'REPLACE_UNAVAILABLE_RESOURCE' && !explicitSwap && !trimString(state.ResourceName || '') && !trimString(state.ReplacementResourceName || '') && !result.resourceName && result.replacementResourceName) {\n  result.resourceName = result.replacementResourceName;\n  result.replacementResourceName = '';\n}\n\nif (isAcrossProjectIntent || pendingAction === 'RESOURCE_NAME_CLARIFICATION') {\n  result.intent = 'REPLACE_RESOURCE_ACROSS_ALL_PROJECTS';\n  if (pendingAction === 'RESOURCE_NAME_CLARIFICATION') {\n    result.resourceName = trimString(pendingPayload.oldResolved || pendingPayload.requestedOld || result.resourceName || state.ResourceName || '');\n    result.replacementResourceName = trimString(pendingPayload.newResolved || pendingPayload.requestedNew || result.replacementResourceName || state.ReplacementResourceName || '');\n    result.approvalAction = false;\n    result.isApproval = false;\n    result.canProceed = true;\n  }\n} else if (result.resourceName && result.replacementResourceName && !result.roleName) {\n  result.intent = 'REPLACE_UNAVAILABLE_RESOURCE';\n}\n\nif (crossProjectBudgetPending) {\n  result.intent = 'REPLACE_RESOURCE_ACROSS_ALL_PROJECTS';\n  result.approvalAction = true;\n  result.isApproval = true;\n  result.canProceed = true;\n  return result;\n}\n\nif (pendingAction === 'BUDGET_SYNC_CONFIRM' || pendingAction === 'BUDGET_GENERATE_CONFIRM' || pendingAction === 'BUDGET_FOLLOWUP_CONFIRM') {\n  if (/^(yes|y|sync|synchronize|generate|create|go ahead|go-ahead|proceed|ok|okay|sure)$/i.test(currentLower)) {\n    result.budgetSyncAction = 'SYNC';\n    return result;\n  }\n  if (/^(no|n|skip|not now|later)$/i.test(currentLower)) {\n    result.budgetSyncAction = 'SKIP';\n    return result;\n  }\n  result.canProceed = false;\n  result.intentStart = 'Y';\n  result.intentEnd = 'N';\n  result.userMessage = 'Reply yes to continue with budget follow-up, or reply no to skip.';\n  return result;\n}\n\nif (hasPendingApproval) {\n  return result;\n}\n\nif (result.approvalAction) {\n  result.canProceed = false;\n  result.intentEnd = 'Y';\n  result.userMessage = 'No pending replacement to approve.';\n  return result;\n}\n\nif (result.intent === 'OUT_OF_SCOPE') {\n  result.canProceed = false;\n  result.intentEnd = 'Y';\n  result.userMessage = 'This assistant handles replacements.';\n  return result;\n}\n\nif (directTimingDecisionStage) {\n  if (normalizedDate) {\n    result.unavailabilityDate = normalizedDate;\n    result.nextStage = '';\n  } else if (isFullReplacementReply(currentMessage)) {\n    result.unavailabilityDate = '';\n    result.nextStage = '';\n  } else {\n    result.canProceed = false;\n    result.intentStart = 'Y';\n    result.intentEnd = 'N';\n    result.nextStage = 'DIRECT_REPLACEMENT_DECISION';\n    result.userMessage = 'Is this a full replacement across the selected assignments, or is there an effective date? Reply full replacement or provide the effective date.';\n    return result;\n  }\n}\n\nif (result.intent === 'REPLACE_ALL_ROLES_WITH_NAMED_PERSONS' && !result.projectName) {\n  result.canProceed = false;\n  result.userMessage = 'Provide project name.';\n  return result;\n}\n\nif (result.intent === 'REPLACE_ROLE_WITH_NAMED_PERSON' && !result.projectName) {\n  result.canProceed = false;\n  result.userMessage = 'Provide project name.';\n  return result;\n}\n\nif (result.intent === 'REPLACE_RESOURCE_ACROSS_ALL_PROJECTS') {\n  if (!result.resourceName || !result.replacementResourceName) {\n    result.canProceed = false;\n    result.intentStart = 'Y';\n    result.intentEnd = 'N';\n    result.userMessage = 'Provide current and replacement resources.';\n    return result;\n  }\n  if (!normalizedDate) {\n    result.canProceed = false;\n    result.intentStart = 'Y';\n    result.intentEnd = 'N';\n    result.nextStage = 'CROSS_PROJECT_EFFECTIVE_DATE';\n    result.userMessage = 'Provide the effective start date for replacing ' + result.resourceName + ' with ' + result.replacementResourceName + ' across projects. For example, July 1, 2026.';\n    if (rawDate && !isFullReplacementReply(currentMessage)) {\n      result.userMessage += ' Use a recognizable date format, for example 2026-07-01.';\n    }\n    return result;\n  }\n  result.unavailabilityDate = normalizedDate;\n  result.nextStage = '';\n}\n\nif (result.intent === 'REPLACE_UNAVAILABLE_RESOURCE') {\n  var missingFields = [];\n  var missingText = '';\n  var directSwapWithoutDate = false;\n  var requiresUnavailableDate = ((unavailableSignal || (reuseState && trimString(state.Intent || '') === 'REPLACE_UNAVAILABLE_RESOURCE' && !explicitSwap && !trimString(state.ReplacementResourceName || '') && !trimString(result.replacementResourceName || ''))) && !normalizedDate);\n\n  if (!result.projectName) {\n    missingFields.push('project name');\n  }\n  if (!result.resourceName) {\n    missingFields.push('resource name to be replaced');\n  }\n\n  if (directSwapWithoutDate) {\n    result.canProceed = false;\n    result.intentStart = 'Y';\n    result.intentEnd = 'N';\n    result.nextStage = 'DIRECT_REPLACEMENT_DECISION';\n    result.userMessage = 'Is this a full replacement across the selected assignments, or is there an effective date? Reply full replacement or provide the effective date.';\n    return result;\n  }\n\n  if (requiresUnavailableDate) {\n    missingFields.push('unavailability date');\n  }\n\n  if (missingFields.length) {\n    result.canProceed = false;\n    if (!result.projectName && !result.resourceName && !rawDate) {\n      result.userMessage = 'Provide project name, resource name to be replaced, and unavailability date. You can provide all three at once.';\n    } else {\n      missingText = missingFields.length === 1\n        ? missingFields[0]\n        : (missingFields.length === 2\n            ? missingFields[0] + ' and ' + missingFields[1]\n            : missingFields.slice(0, missingFields.length - 1).join(', ') + ', and ' + missingFields[missingFields.length - 1]);\n      result.userMessage = 'Provide ' + missingText + '.';\n      if (missingFields.length > 1) {\n        result.userMessage += ' You can provide all remaining values at once.';\n      }\n      if (rawDate && !normalizedDate) {\n        result.userMessage += ' Use a recognizable date format, for example 2015-12-01.';\n      }\n    }\n  }\n}\n\nreturn result;\n"
