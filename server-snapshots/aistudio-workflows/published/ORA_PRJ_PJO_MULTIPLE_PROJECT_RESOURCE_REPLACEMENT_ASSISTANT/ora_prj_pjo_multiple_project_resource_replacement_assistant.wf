        {
          "metadata": {
            "errorNodeId": "1781000000199",
            "name": "Build Across Projects Old Resource Filter",
            "returnType": "object",
            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\n\nfunction esc(value) {\n  return trimString(value).replace(/'/g, \"''\");\n}\n\nfunction displayTokens(value) {\n  return trimString(value).replace(/\\b(?:mr|mrs|ms|miss|dr)\\.?/gi, ' ').replace(/[^A-Za-z0-9]+/g, ' ').trim().split(/\\s+/).filter(Boolean);\n}\n\nfunction genericSearchTerm(value) {\n  var tokens = displayTokens(value);\n  var term = tokens.length ? tokens[0] : trimString(value);\n  var lower = term.toLowerCase();\n  if (lower.indexOf('consult') === 0) {\n    return 'Consult';\n  }\n  if (lower.indexOf('engineer') === 0) {\n    return 'Engineer';\n  }\n  if (lower.indexOf('manager') === 0) {\n    return 'Manager';\n  }\n  if (lower.indexOf('analyst') === 0) {\n    return 'Analyst';\n  }\n  return term;\n}\n\nfunction searchTerm(value) {\n  var text = trimString(value);\n  var commaName = trimString(text.split(',')[0] || '');\n  var commaTokens = displayTokens(commaName);\n  var tokens;\n  var best = '';\n  var i;\n  if (commaTokens.length) {\n    return genericSearchTerm(commaTokens.join(' '));\n  }\n  tokens = displayTokens(text);\n  for (i = 0; i < tokens.length; i++) {\n    if (tokens[i].length > best.length) {\n      best = tokens[i];\n    }\n  }\n  return best;\n}\n\nfunction exactResourceName(value) {\n  var text = trimString(value).replace(/\\s+/g, ' ');\n  if (!text || text.indexOf(',') === -1) {\n    return '';\n  }\n  text = text.replace(/,\\s*mr\\s+/i, ', Mr. ');\n  text = text.replace(/,\\s*mrs\\s+/i, ', Mrs. ');\n  text = text.replace(/,\\s*ms\\s+/i, ', Ms. ');\n  text = text.replace(/,\\s*dr\\s+/i, ', Dr. ');\n  text = text.replace(/\\b(Esq|Jr|Sr)$/i, function(all, suffix) {\n    return suffix + '.';\n  });\n  return text;\n}\n\nfunction buildResourceFilter(baseFilter, requestedName) {\n  var exactName = exactResourceName(requestedName);\n  var fuzzyName = searchTerm(requestedName);\n  if (exactName) {\n    return baseFilter + \"&q=ResourceName='\" + esc(exactName) + \"'\";\n  }\n  if (fuzzyName) {\n    return baseFilter + \"&q=ResourceName like '%\" + esc(fuzzyName) + \"%'\";\n  }\n  return baseFilter;\n}\n\nvar req = ($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_RESOLVE_REQUEST_V5.$output || {}).result || {};\nvar requestedOld = trimString(req.resourceName || $context.$variables.ResourceName || '');\nvar onlyFlag = 'only' + 'D' + 'ata';\nvar baseFilter = '?' + onlyFlag + '=true&limit=100&fields=ResourceName,ProjectId,RbsElementId';\nvar result = {\n  filterCriteria: buildResourceFilter(baseFilter, requestedOld)\n};\nreturn result;"
