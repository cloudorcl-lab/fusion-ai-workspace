            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\n\nfunction parseMaybe(value) {\n  var current = value;\n  var depth = 0;\n  while (typeof current === 'string' && trimString(current) !== '' && depth < 6) {\n    try {\n      current = JSON.parse(current);\n      depth += 1;\n    } catch (ignore1) {\n      break;\n    }\n  }\n  return current;\n}\n\nfunction extractItems(value) {\n  var current = parseMaybe(value);\n  var depth = 0;\n  while (current && depth < 6) {\n    if (Array.isArray(current.items)) {\n      return current.items;\n    }\n    if (current.output !== undefined) {\n      current = parseMaybe(current.output);\n      depth += 1;\n      continue;\n    }\n    if (current.result !== undefined) {\n      current = parseMaybe(current.result);\n      depth += 1;\n      continue;\n    }\n    break;\n  }\n  return [];\n}\n\nfunction normalizeTokens(value) {\n  return trimString(value).toLowerCase().replace(/\\b(?:mr|mrs|ms|miss|dr)\\.?/g, ' ').replace(/[^a-z0-9]+/g, ' ').trim().split(/\\s+/).filter(Boolean);\n}\n\nfunction normalizeKey(value) {\n  return normalizeTokens(value).join('');\n}\n\nfunction scoreName(requested, candidateNameValue) {\n  var requestedTokens = normalizeTokens(requested);\n  var candidateTokens = normalizeTokens(candidateNameValue);\n  var requestedKey = requestedTokens.join('');\n  var candidateKey = candidateTokens.join('');\n  var startsWithRequested = requestedTokens.length === 1 && candidateTokens.length && candidateTokens[0] === requestedTokens[0];\n  if (!requestedKey || !candidateKey) {\n    return 0;\n  }\n  if (candidateKey === requestedKey) {\n    return 70;\n  }\n  if (startsWithRequested) {\n    return 60;\n  }\n  if (candidateKey.indexOf(requestedKey) > -1 || requestedKey.indexOf(candidateKey) > -1) {\n    return /^\\s*(labor|expense|expenses|equipment|material|financial)\\s*:/i.test(trimString(candidateNameValue)) ? 35 : 40;\n  }\n  return 0;\n}\n\nfunction candidateName(candidate) {\n  return trimString(candidate && (candidate.resourceName || candidate.ResourceName || candidate.personName || candidate.PersonName || ''));\n}\n\nfunction resolveName(requested, names) {\n  var best = '';\n  var bestScore = 0;\n  var tie = false;\n  var seen = {};\n  var i;\n  var name;\n  var nameKey;\n  var score;\n  for (i = 0; i < names.length; i++) {\n    name = trimString(names[i]);\n    nameKey = normalizeKey(name);\n    if (!nameKey || seen[nameKey]) {\n      continue;\n    }\n    seen[nameKey] = true;\n    score = scoreName(requested, name);\n    if (!score) {\n      continue;\n    }\n    if (score > bestScore) {\n      best = name;\n      bestScore = score;\n      tie = false;\n    } else if (score === bestScore && normalizeKey(best) !== nameKey) {\n      tie = true;\n    }\n  }\n  if (!best || tie) {\n    return '';\n  }\n  return best;\n}\n\nfunction isBroadResourceTerm(value) {\n  var tokens = normalizeTokens(value);\n  var first = tokens.length ? tokens[0] : '';\n  return tokens.length <= 1 && /^(consultant|consulting|consult|engineer|manager|analyst|architect|developer|designer|resource|labor)$/.test(first);\n}\n\nfunction broadSearchTerm(value) {\n  var tokens = normalizeTokens(value);\n  var first = tokens.length ? tokens[0] : '';\n  if (first.indexOf('consult') === 0) {\n    return 'Consult';\n  }\n  return trimString(value);\n}\n\nfunction esc(value) {\n  return trimString(value).replace(/'/g, \"''\");\n}\n\nvar req = ($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_RESOLVE_REQUEST_V5.$output || {}).result || {};\nvar pending = parseMaybe($context.$variables.PendingReplacementItemsJson || '');\nif (typeof pending === 'string') {\n  try { pending = parseMaybe(decodeURIComponent(pending)); } catch (ignore2) {}\n}\nif (!pending || typeof pending !== 'object' || Array.isArray(pending) || pending.type !== 'RESOURCE_NAME_CLARIFICATION') {\n  pending = {};\n}\nvar requestedOld = trimString(req.resourceName || pending.oldResolved || pending.requestedOld || $context.$variables.ResourceName || '');\nvar requestedNew = trimString(req.replacementResourceName || pending.newResolved || pending.requestedNew || $context.$variables.ReplacementResourceName || '');\nvar effectiveDate = trimString(req.unavailabilityDate || $context.$variables.UnavailabilityDate || '');\nvar oldCandidates = extractItems((($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FETCH_ACROSS_PROJECTS_OLD_RESOURCE_CANDIDATES_V1 || {}).$output) || {});\nvar oldNames = [];\nvar i;\nfor (i = 0; i < oldCandidates.length; i++) {\n  oldNames.push(candidateName(oldCandidates[i] || {}));\n}\nvar resolvedOld = trimString(pending.oldResolved || '') || resolveName(requestedOld, oldNames);\nvar broadOld = isBroadResourceTerm(requestedOld);\nvar queryName = broadOld ? broadSearchTerm(requestedOld) : (resolvedOld || requestedOld);\nvar onlyFlag = 'only' + 'D' + 'ata';\nvar filterCriteria = '?' + onlyFlag + '=true&limit=1';\nvar result = {\n  filterCriteria: filterCriteria,\n  requestedOldResourceName: requestedOld,\n  requestedNewResourceName: requestedNew,\n  resolvedOldResourceName: resolvedOld,\n  effectiveDate: effectiveDate\n};\nreturn result;\n"
