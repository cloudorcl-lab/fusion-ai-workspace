            "sourceCode": "function cleanupUnavailableResourceCandidate(value) {\n  return String(value || '')\n    .replace(/\\b(?:i\\s+want\\s+to\\s+replace|please\\s+replace|need\\s+to\\s+replace|replace)\\b/ig, ' ')\n    .replace(/\\b(?:a|an|the)\\b/ig, ' ')\n    .replace(/\\b(?:terminated|termination|unavailable|backfill|employee|person|resource|long\\s+leave|on\\s+long\\s+leave)\\b/ig, ' ')\n    .replace(/\\bproject(?:\\s+name)?\\b\\s*[:=-]?/ig, ' ')\n    .replace(/\\bresource(?:\\s+name)?\\b\\s*[:=-]?/ig, ' ')\n    .replace(/\\bcurrent\\s+resource\\b\\s*[:=-]?/ig, ' ')\n    .replace(/\\btermination(?:\\s+date)?\\b\\s*[:=-]?/ig, ' ')\n    .replace(/\\bunavailability(?:\\s+date)?\\b\\s*[:=-]?/ig, ' ')\n    .replace(/\\beffective(?:\\s+date)?\\b\\s*[:=-]?/ig, ' ')\n    .replace(/\\b(?:from|on)\\b\\s+(?:[A-Za-z]+\\s+\\d{1,2}(?:st|nd|rd|th)?(?:,)?\\s+\\d{4}|\\d{1,2}\\s+[A-Za-z]+(?:,)?\\s+\\d{4}|\\d{4}[-\\/]\\d{1,2}[-\\/]\\d{1,2}|\\d{1,2}[-\\/]\\d{1,2}[-\\/]\\d{4})/ig, ' ')\n    .replace(/\\b(?:in|on)\\b\\s+[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+\\b/g, ' ')\n    .replace(/\\b[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+\\b/g, ' ')\n    .replace(/[\\r\\n,;]+/g, ' ')\n    .replace(/\\band\\b/ig, ' ')\n    .replace(/\\s+/g, ' ')\n    .replace(/^[^A-Za-z0-9]+|[^A-Za-z0-9]+$/g, '')\n    .trim();\n}\nfunction cleanupSwapPartyCandidate(value) {\n  return String(value || '')\n    .replace(/^\\s*(?:a|an|the)\\s+/i, '')\n    .replace(/^\\s*(?:terminated|unavailable)\\s+/i, '')\n    .replace(/^\\s*resource\\s+/i, '')\n    .replace(/^\\s*employee\\s+/i, '')\n    .replace(/^\\s*person\\s+/i, '')\n    .replace(/\\s+/g, ' ')\n    .replace(/^[^A-Za-z0-9]+|[^A-Za-z0-9]+$/g, '')\n    .trim();\n}\nfunction cleanExtractedField(value) {\n  var text = String(value == null ? '' : value).trim();\n  text = text.replace(/^[,;:.\\-\\s]+|[,;:.\\-\\s]+$/g, '').trim();\n  if (!text || /^[^A-Za-z0-9]+$/.test(text)) {\n    return '';\n  }\n  return text;\n}\nfunction cleanupCrossProjectScope(value) {\n  var text = cleanEx