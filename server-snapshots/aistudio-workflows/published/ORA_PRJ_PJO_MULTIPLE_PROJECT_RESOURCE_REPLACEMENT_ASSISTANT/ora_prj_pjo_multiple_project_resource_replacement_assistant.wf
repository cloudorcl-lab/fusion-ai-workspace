            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\n\nfunction parseItems(raw) {\n  var text = trimString(raw);\n  var parsed = [];\n  if (!text) {\n    return [];\n  }\n  try {\n    parsed = JSON.parse(decodeURIComponent(text));\n  } catch (ignore1) {\n    try {\n      parsed = JSON.parse(text);\n    } catch (ignore2) {\n      parsed = [];\n    }\n  }\n  return Array.isArray(parsed) ? parsed : [];\n}\n\nfunction normalizeKey(value) {\n  return trimString(value).toLowerCase().replace(/[^a-z0-9]+/g, '');\n}\n\nfunction wordNumber(value) {\n  var map = {\n    one: 1, two: 2, three: 3, four: 4, five: 5,\n    six: 6, seven: 7, eight: 8, nine: 9, ten: 10,\n    first: 1, second: 2, third: 3, fourth: 4, fifth: 5,\n    sixth: 6, seventh: 7, eighth: 8, ninth: 9, tenth: 10\n  };\n  var key = trimString(value).toLowerCase();\n  var num = Number(key);\n  if (!isNaN(num) && num > 0) {\n    return Math.floor(num);\n  }\n  return map[key] || 0;\n}\n\nfunction projectKey(item) {\n  return normalizeKey(item.ProjectId || '') ||\n    normalizeKey(item.ProjectNumber || '') ||\n    normalizeKey(item.ProjectName || '') ||\n    normalizeKey(item.PlanVersionId || '');\n}\n\nfunction projectLabel(group) {\n  return trimString(group.projectName || group.projectNumber || ('option ' + String(group.index)));\n}\n\nfunction buildGroups(items) {\n  var groups = [];\n  var byKey = {};\n  var i;\n  var item;\n  var key;\n  var group;\n  for (i = 0; i < items.length; i++) {\n    item = items[i] || {};\n    key = projectKey(item);\n    if (!key) {\n      key = 'item' + String(i + 1);\n    }\n    group = byKey[key];\n    if (!group) {\n      group = {\n        index: groups.length + 1,\n        key: key,\n        projectName: trimString(item.ProjectName || ''),\n        projectNumber: trimString(item.ProjectNumber || ''),\n        items: []\n      };\n      byKey[key] = group;\n      groups.push(group);\n    }\n    group.items.push(item);\n  }\n  return groups;\n}\n\nfunction addIndex(selected, index, max) {\n  if (index >= 1 && index <= max) {\n    selected[index] = true;\n  }\n}\n\nfunction addRange(selected, start, end, max) {\n  var i;\n  if (start < 1) {\n    start = 1;\n  }\n  if (end > max) {\n    end = max;\n  }\n  for (i = start; i <= end; i++) {\n    addIndex(selected, i, max);\n  }\n}\n\nfunction selectedGroupsFromMap(groups, selected) {\n  var output = [];\n  var i;\n  for (i = 0; i < groups.length; i++) {\n    if (selected[groups[i].index]) {\n      output.push(groups[i]);\n    }\n  }\n  return output;\n}\n\nfunction selectedItemsFromMap(items, selected) {\n  var output = [];\n  var i;\n  for (i = 0; i < items.length; i++) {\n    if (selected[i + 1]) {\n      output.push(items[i]);\n    }\n  }\n  return output;\n}\n\nfunction groupsForItems(items) {\n  return buildGroups(items);\n}\n\nfunction normalizeWords(value) {\n  return trimString(value).toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim().split(/\\s+/).filter(Boolean);\n}\n\nfunction singularWord(value) {\n  value = trimString(value).toLowerCase();\n  if (value.length > 3 && value.charAt(value.length - 1) === 's') {\n    return value.slice(0, value.length - 1);\n  }\n  return value;\n}\n\nfunction compactWords(words, singularize) {\n  var out = [];\n  var i;\n  for (i = 0; i < words.length; i++) {\n    out.push(singularize ? singularWord(words[i]) : words[i]);\n  }\n  return out.join('');\n}\n\nfunction stripSelectionWords(value) {\n  var words = normalizeWords(value);\n  var out = [];\n  var skip = {\n    select: true, choose: true, use: true, update: true, commit: true, replace: true,\n    project: true, projects: true, option: true, options: true, row: true, rows: true,\n    assignment: true, assignments: true, only: true, the: true, please: true\n  };\n  var i;\n  for (i = 0; i < words.length; i++) {\n    if (!skip[words[i]]) {\n      out.push(words[i]);\n    }\n  }\n  return out.join(' ');\n}\n\nfunction phraseContains(haystackWords, needleWords) {\n  var i;\n  var j;\n  if (!needleWords.length || needleWords.length > haystackWords.length) {\n    return false;\n  }\n  for (i = 0; i <= haystackWords.length - needleWords.length; i++) {\n    for (j = 0; j < needleWords.length; j++) {\n      if (haystackWords[i + j] !== needleWords[j]) {\n        break;\n      }\n    }\n    if (j === needleWords.length) {\n      return true;\n    }\n  }\n  return false;\n}\n\nfunction projectMatchScore(message, alias) {\n  var messageWords = normalizeWords(message);\n  var strippedWords = normalizeWords(stripSelectionWords(message));\n  var aliasWords = normalizeWords(alias);\n  var messageKey = compactWords(messageWords, false);\n  var strippedKey = compactWords(strippedWords, false);\n  var aliasKey = compactWords(aliasWords, false);\n  var messageSingularKey = compactWords(messageWords, true);\n  var strippedSingularKey = compactWords(strippedWords, true);\n  var aliasSingularKey = compactWords(aliasWords, true);\n\n  if (!aliasKey || !messageKey) {\n    return 0;\n  }\n  if (messageKey === aliasKey || strippedKey === aliasKey) {\n    return 100;\n  }\n  if (messageSingularKey === aliasSingularKey || strippedSingularKey === aliasSingularKey) {\n    return 95;\n  }\n  if (aliasWords.length >= 2 && (phraseContains(messageWords, aliasWords) || phraseContains(strippedWords, aliasWords))) {\n    return 85;\n  }\n  if (aliasWords.length >= 2 && (phraseContains(messageWords.map(singularWord), aliasWords.map(singularWord)) || phraseContains(strippedWords.map(singularWord), aliasWords.map(singularWord)))) {\n    return 80;\n  }\n  if (strippedWords.length >= 2 && (aliasKey.indexOf(strippedKey) > -1 || aliasSingularKey.indexOf(strippedSingularKey) > -1)) {\n    return 65;\n  }\n  if (messageWords.length >= 2 && (aliasKey.indexOf(messageKey) > -1 || aliasSingularKey.indexOf(messageSingularKey) > -1)) {\n    return 60;\n  }\n  return 0;\n}\n\nfunction matchProjectNames(message, groups, selected) {\n  var matches = [];\n  var matched = 0;\n  var bestScore = 0;\n  var i;\n  var group;\n  var score;\n  var nameScore;\n  var numberScore;\n\n  for (i = 0; i < groups.length; i++) {\n    group = groups[i];\n    nameScore = projectMatchScore(message, group.projectName);\n    numberScore = projectMatchScore(message, group.projectNumber);\n    score = nameScore > numberScore ? nameScore : numberScore;\n    if (score > 0) {\n      matches.push({ group: group, score: score });\n      if (score > bestScore) {\n        bestScore = score;\n      }\n    }\n  }\n\n  if (!matches.length) {\n    return 0;\n  }\n\n  for (i = 0; i < matches.length; i++) {\n    if (matches[i].score === bestScore || matches[i].score >= 80) {\n      selected[matches[i].group.index] = true;\n      matched += 1;\n    }\n  }\n  return matched;\n}\n\nfunction selectIndexedItems(message, items) {\n  var text = trimString(message);\n  var lower = text.toLowerCase().replace(/\\s+/g, ' ').trim();\n  var max = items.length;\n  var selected = {};\n  var match;\n  var number;\n  var parts;\n  var start;\n  var end;\n  var i;\n  var result = { matched: false, items: [], summary: '' };\n\n  if (!max) {\n    return result;\n  }\n\n  match = lower.match(/\\b(\\d+|second|third|fourth|fifth|sixth|seventh|eighth|ninth|tenth)\\s+(?:(?:to|from)\\s+)?last\\b/);\n  if (match) {\n    number = wordNumber(match[1]);\n    addIndex(selected, max - number + 1, max);\n    result.summary = match[0];\n  } else {\n    match = lower.match(/\\bfirst(?:\\s+(\\d+|one|two|three|four|five|six|seven|eight|nine|ten))?\\b/);\n    if (match) {\n      number = wordNumber(match[1] || 'one') || 1;\n      addRange(selected, 1, number, max);\n      result.summary = 'first ' + String(number);\n    }\n\n    match = lower.match(/\\blast(?:\\s+(\\d+|one|two|three|four|five|six|seven|eight|nine|ten))?\\b/);\n    if (match) {\n      number = wordNumber(match[1] || 'one') || 1;\n      addRange(selected, max - number + 1, max, max);\n      result.summary = 'last ' + String(number);\n    }\n  }\n\n  if (!selectedItemsFromMap(items, selected).length && /^(?:(?:option|row|assignment)\\s*)?\\d+(?:\\s*(?:,|and|-)\\s*\\d+)*$/.test(lower)) {\n    parts = lower.match(/\\d+/g) || [];\n    if (lower.indexOf('-') > -1 && parts.length >= 2) {\n      start = Number(parts[0]);\n      end = Number(parts[1]);\n      if (start > end) {\n        number = start;\n        start = end;\n        end = number;\n      }\n      addRange(selected, start, end, max);\n      result.summary = 'options ' + String(start) + '-' + String(end);\n    } else {\n      for (i = 0; i < parts.length; i++) {\n        addIndex(selected, Number(parts[i]), max);\n      }\n      result.summary = 'selected option(s) ' + parts.join(', ');\n    }\n  }\n\n  if (!selectedItemsFromMap(items, selected).length) {\n    match = lower.match(/^(?:the\\s+)?(\\d+|first|second|third|fourth|fifth|sixth|seventh|eighth|ninth|tenth)(?:\\s+(?:one|row|assignment|option))?$/);\n    if (match) {\n      number = wordNumber(match[1]);\n      addIndex(selected, number, max);\n      result.summary = 'option ' + String(number);\n    }\n  }\n\n  result.items = selectedItemsFromMap(items, selected);\n  result.matched = result.items.length > 0;\n  return result;\n}\n\nfunction selectGroups(message, groups, pendingAction, items) {\n  var text = trimString(message);\n  var lower = text.toLowerCase().replace(/\\s+/g, ' ').trim();\n  var max = groups.length;\n  var selected = {};\n  var itemSelection;\n  var result = {\n    ok: true,\n    groups: [],\n    items: [],\n    summary: '',\n    message: ''\n  };\n\n  if (pendingAction !== 'CROSS_PROJECT_COMMIT') {\n    addRange(selected, 1, max, max);\n    result.groups = selectedGroupsFromMap(groups, selected);\n    result.items = items.slice(0);\n    result.summary = 'all pending assignments';\n    return result;\n  }\n\n  if (!lower || /^(approve|approved|yes|y|go ahead|go-ahead|proceed|ok|okay|sure|all|all projects|all impacted projects|across all projects|across all impacted projects|all impacted|all assignments|replace all|do all|everything)$/.test(lower)) {\n    addRange(selected, 1, max, max);\n    result.groups = selectedGroupsFromMap(groups, selected);\n    result.items = items.slice(0);\n    result.summary = 'all listed assignments';\n    return result;\n  }\n\n  if (/^(specific projects?|project selection|select projects?|choose projects?)$/.test(lower)) {\n    result.ok = false;\n    result.message = 'Specify the project name or project option number to proceed with the replacement for specific projects.';\n    return result;\n  }\n\n  if (/^(specific task assignments?(?: within a project)?|specific tasks?|task assignments?|assignment selection|select assignments?|choose assignments?)$/.test(lower)) {\n    result.ok = false;\n    result.message = 'Specify the assignment option number or range, such as 1, 2, or 1-3, to proceed with specific task assignments within a project.';\n    return result;\n  }\n\n  if (/^(no|n|cancel|stop|skip|not now|later)$/.test(lower)) {\n    result.ok = false;\n    result.message = 'No replacement was committed. Reply with all impacted projects, a project name, a project option number, or assignment option number(s) to continue.';\n    return result;\n  }\n\n  itemSelection = selectIndexedItems(text, items);\n  if (itemSelection.matched) {\n    result.items = itemSelection.items;\n    result.groups = groupsForItems(itemSelection.items);\n    result.summary = itemSelection.summary;\n    return result;\n  }\n\n  if (matchProjectNames(text, groups, selected) > 0) {\n    result.groups = selectedGroupsFromMap(groups, selected);\n    result.summary = 'matching project name';\n    for (var g = 0; g < result.groups.length; g++) {\n      for (var j = 0; j < result.groups[g].items.length; j++) {\n        result.items.push(result.groups[g].items[j]);\n      }\n    }\n    return result;\n  }\n\n  result.ok = false;\n  result.message = 'I could not match \"' + text + '\" to the listed assignments or projects. Reply with all impacted projects, a project name, a project option number, or assignment option number(s).';\n  return result;\n}\n\nvar effectiveState = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_EFFECTIVE_STATE_V2.$output.result || {};\nvar variables = $context.$variables || {};\nvar raw = String(variables.PendingReplacementItemsJson || effectiveState.PendingReplacementItemsJson || '');\nvar pendingAction = trimString(variables.PendingAction || effectiveState.PendingAction || '');\nvar message = trimString(effectiveState.EffectiveInputMessage || variables.EffectiveInputMessage || '');\nvar items = parseItems(raw);\nvar groups = buildGroups(items);\nvar selection = selectGroups(message, groups, pendingAction, items);\nvar replacementItems = [];\nvar g;\nvar j;\nvar result;\n\nif (!items.length) {\n  result = {\n    canCommit: false,\n    response: 'There is no pending replacement proposal to commit.',\n    intentStart: 'N',\n    intentEnd: 'Y',\n    replacementItems: []\n  };\n} else if (!selection.ok) {\n  result = {\n    canCommit: false,\n    response: selection.message,\n    intentStart: 'Y',\n    intentEnd: 'N',\n    replacementItems: []\n  };\n} else {\n  if (selection.items && selection.items.length) {\n    replacementItems = selection.items;\n  } else {\n    for (g = 0; g < selection.groups.length; g++) {\n      for (j = 0; j < selection.groups[g].items.length; j++) {\n        replacementItems.push(selection.groups[g].items[j]);\n      }\n    }\n  }\n  result = {\n    canCommit: replacementItems.length > 0,\n    response: '',\n    intentStart: 'Y',\n    intentEnd: 'N',\n    replacementItems: replacementItems,\n    selectedProjectCount: selection.groups.length,\n    selectedAssignmentCount: replacementItems.length,\n    selectionSummary: selection.summary,\n    selectedProjects: selection.groups.map(projectLabel)\n  };\n}\nreturn result;"
