            "name": "Format Cross Project Budget Sync Response",
            "returnType": "object",
            "sourceCode": "function trimString(value) { return String(value == null ? '' : value).trim(); }\nfunction normalizeKey(value) { return trimString(value).toLowerCase().replace(/[^a-z0-9]+/g, ''); }\nfunction toNumber(value) { var text; var num; if (value == null || value === '') { return null; } if (typeof value === 'number') { return isNaN(value) ? null : value; } text = trimString(value); if (!text) { return null; } if (/^\\(.+\\)$/.test(text)) { text = '-' + text.slice(1, -1); } text = text.replace(/[$,\\s]/g, ''); num = Number(text); return isNaN(num) ? null : num; }\nfunction addCommas(value) { return String(value).replace(/\\B(?=(\\d{3})+(?!\\d))/g, ','); }\nfunction formatAmount(value, plusForPositive) { var num = toNumber(value); var sign = ''; var cents; var whole; var fraction; if (num === null) { return 'N/A'; } if (num < 0) { sign = '-'; } else if (plusForPositive && num > 0) { sign = '+'; } cents = Math.round(Math.abs(num) * 100); whole = Math.floor(cents / 100); fraction = cents % 100; return sign + '$' + addCommas(whole) + (fraction ? '.' + (fraction < 10 ? '0' : '') + String(fraction) : ''); }\nfunction formatVariance(currentValue, revisedValue) { var current = toNumber(currentValue); var revised = toNumber(revisedValue); if (current === null || revised === null) { return 'N/A'; } return formatAmount(revised - current, true); }\nfunction tableText(value) { var text = trimString(value); return text ? text.replace(/\\|/g, '/') : 'N/A'; }\nfunction firstNumber(source, names) { var i; var num; source = source || {}; for (i = 0; i < names.length; i++) { num = toNumber(source[names[i]]); if (num !== null) { return num; } } return null; }\nfunction setFirstNumber(group, fieldName, value) { var num = toNumber(value); if (group[fieldName] === null && num !== null) { group[fieldName] = num; } }\nfunction extractText(value) { var text; if (value == null) { return ''; } if (typeof value === 'string') { text = trimString(value); if (!text) { return ''; } if (text.charAt(0) === '{' || text.charAt(0) === '[') { try { return extractText(JSON.parse(text)); } catch (ignore1) {} } return text; } if (Array.isArray(value)) { return trimString(JSON.stringify(value)); } if (typeof value === 'object') { if (value.response !== undefined) { text = extractText(value.response); if (text) { return text; } } if (value.output !== undefined) { text = extractText(value.output); if (text) { return text; } } if (value.result !== undefined) { text = extractText(value.result); if (text) { return text; } } if (value.error !== undefined) { text = extractText(value.error); if (text) { return text; } } return trimString(JSON.stringify(value)); } return trimString(value); }\nfunction extractSummaryItems(value) { var items; if (value == null) { return []; } if (Array.isArray(value)) { return value; } if (typeof value === 'string') { value = trimString(value); if (!value) { return []; } if (value.charAt(0) === '{' || value.charAt(0) === '[') { try { return extractSummaryItems(JSON.parse(value)); } catch (ignore1) { return []; } } return []; } if (typeof value === 'object') { if (value.result !== undefined) { items = extractSummaryItems(value.result); if (items.length) { return items; } } if (value.output !== undefined) { items = extractSummaryItems(value.output); if (items.length) { return items; } } if (value.response !== undefined) { items = extractSummaryItems(value.response); if (items.length) { return items; } } if (Array.isArray(value.items)) { return value.items; } if (value.PlanVersionName !== undefined || value.PlanVersionDescription !== undefined || value.OlderVersionPlanVersionName !== undefined || value.ErrorMessage !== undefined || value.PCBurdenedCostAmounts !== undefined || value.PCRevenueAmounts !== undefined || value.BurdenedCostInProjectCurrency !== undefined || value.RevenueInProjectCurrency !== undefined) { return [value]; } } return []; }\nfunction projectNameFor(item, fallback) { return trimString(item.ProjectName || item.ProjectNumber || item.Project || item.ProjectDisplayName || fallback || 'Project'); }\nfunction projectKey(item, fallback) { return normalizeKey(item.ProjectId || item.ProjectNumber || item.ProjectName || item.Project || item.ProjectDisplayName || fallback || 'Project'); }\nfunction buildImpactGroups(items, fallbackProjectName) { var groups = []; var byKey = {}; var i; var item; var key; var group; for (i = 0; i < items.length; i++) { item = items[i] || {}; key = projectKey(item, fallbackProjectName); group = byKey[key]; if (!group) { group = { projectName: projectNameFor(item, fallbackProjectName), currentCost: null, revisedCost: null, currentRevenue: null, revisedRevenue: null }; byKey[key] = group; groups.push(group); } setFirstNumber(group, 'currentCost', firstNumber(item, ['OlderVersionPCBurdenedCostAmounts', 'OlderVersionPFCBurdenedCostAmounts', 'OlderVersionBurdenedCostAmounts', 'OlderVersionBurdenedCostInProjectCurrency', 'OlderVersionBurdenedCostInProjectLedgerCurrency', 'OlderVersionPCRawCostAmounts', 'OlderVersionPFCRawCostAmounts', 'OlderVersionRawCostAmounts', 'OlderVersionRawCostInProjectCurrency', 'CurrentCost', 'BeforePlanBurdenedCost', 'BeforePlanRawCost', 'BeforeBurdenedCost', 'BeforeRawCost'])); setFirstNumber(group, 'revisedCost', firstNumber(item, ['PCBurdenedCostAmounts', 'PFCBurdenedCostAmounts', 'BurdenedCostAmounts', 'BurdenedCostInProjectCurrency', 'BurdenedCostInProjectLedgerCurrency', 'PCRawCostAmounts', 'PFCRawCostAmounts', 'RawCostAmounts', 'RawCostInProjectCurrency', 'RevisedCost', 'AfterPlanBurdenedCost', 'AfterPlanRawCost', 'AfterBurdenedCost', 'AfterRawCost'])); setFirstNumber(group, 'currentRevenue', firstNumber(item, ['OlderVersionPCRevenueAmounts', 'OlderVersionPFCRevenueAmounts', 'OlderVersionRevenueAmounts', 'OlderVersionRevenueInProjectCurrency', 'OlderVersionRevenueInProjectLedgerCurrency', 'CurrentRevenue', 'BeforePlanRevenue', 'BeforeRevenue'])); setFirstNumber(group, 'revisedRevenue', firstNumber(item, ['PCRevenueAmounts', 'PFCRevenueAmounts', 'RevenueAmounts', 'RevenueInProjectCurrency', 'RevenueInProjectLedgerCurrency', 'RevisedRevenue', 'AfterPlanRevenue', 'AfterRevenue'])); } return groups; }\nfunction buildImpactRow(group) { return '| ' + tableText(group.projectName) + ' | ' + formatAmount(group.currentCost, false) + ' | ' + formatAmount(group.revisedCost, false) + ' | ' + formatVariance(group.currentCost, group.revisedCost) + ' | ' + formatAmount(group.currentRevenue, false) + ' | ' + formatAmount(group.revisedRevenue, false) + ' | ' + formatVariance(group.currentRevenue, group.revisedRevenue) + ' |'; }\nfunction buildImpactTable(items, fallbackProjectName) { var lines = ['| Project | Current Cost | Revised Cost | Cost Variance | Current Revenue | Revised Revenue | Revenue Variance |', '| --- | --- | --- | --- | --- | --- | --- |']; var groups = buildImpactGroups(items, fallbackProjectName); var i; for (i = 0; i < groups.length; i++) { lines.push(buildImpactRow(groups[i])); } return lines.join('\\n'); }\nfunction stripMarkdownTables(value) { var lines = String(value || '').split(/\\r?\\n/); var out = []; var i; var line; var text; for (i = 0; i < lines.length; i++) { line = lines[i]; text = trimString(line); if (/^\\|.*\\|$/.test(text) || /^\\|?\\s*:?-{3,}:?\\s*(?:\\|\\s*:?-{3,}:?\\s*)+\\|?$/.test(text)) { continue; } out.push(line); } return trimString(out.join('\\n').replace(/\\n{3,}/g, '\\n\\n')); }\n\nvar raw = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_CALL_CROSS_PROJECT_BUDGET_SYNCHRONIZER_V1.$output || {};\nvar resolver = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_RESOLVE_CROSS_PROJECT_BUDGET_FOLLOWUP_V1.$output.result || {};\nvar items = extractSummaryItems(raw);\nvar summaryText = extractText(raw);\nvar response;\nvar i;\nvar item;\nvar projectName = trimString(resolver.selectedProjectName || resolver.pendingProjectName || 'the selected project');\nvar successMessage = 'A new current working version for the ' + projectName + ' project has been successfully generated from the project plan.';\nfor (i = 0; i < items.length; i++) {\n  item = items[i] || {};\n  if (trimString(item.ErrorMessage || '')) {\n    summaryText = trimString(item.ErrorMessage);\n    items = [];\n    break;\n  }\n}\nif (items.length) {\n  response = successMessage;\n} else if (!summaryText || /not completed|could not|failed|no summary da(?:ta) was available|unable to parse/i.test(summaryText)) {\n  response = 'Budget follow-up could not be completed for project ' + projectName + '. ' + (summaryText || 'The synchronizer did not return a usable summary.');\n} else {\n  response = successMessage;\n}\nvar result = {\n  response: response,\n  intentStart: 'N',\n  intentEnd: 'Y',\n  pendingAction: '',\n  pendingItemsJson: '[]',\n  pendingProjectName: '',\n  pendingOldResourceName: '',\n  pendingNewResourceName: '',\n  pendingUnavailabilityDate: '',\n  nextStage: ''\n};\nreturn result;"
