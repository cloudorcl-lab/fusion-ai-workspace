ame || ''),\n    resourceElementId: trimString(item.RbsElementId || ''),\n    oldResourceElementId: trimString(item.RbsElementId || ''),\n    planningElementId: trimString(item.PlanningElementId || ''),\n    quantity: quantity,\n    plannedEffort: quantity,\n    startDate: dateValue(item, ['PlanningStartDate', 'AssignmentStartDate', 'PlannedStartDate', 'PlanStartDate', 'StartDate', 'BaselineStartDate']),\n    endDate: dateValue(item, ['PlanningFinishDate', 'PlanningEndDate', 'AssignmentEndDate', 'PlannedFinishDate', 'PlanFinishDate', 'FinishDate', 'EndDate', 'BaselineFinishDate']),\n    rawCost: rawCost,\n    burdenedCost: burdenedCost,\n    revenue: revenue\n  });\n}\nfor (i = 0; i < elementItems.length; i++) {\n  item = parseMaybe(elementItems[i]) || {};\n  namedPersonElements.push({ resourceName: trimString(item.ResourceName || item.PersonName || ''), personName: trimString(item.PersonName || item.ResourceName || ''), personEmail: trimString(item.PersonEmail || ''), resourceElementId: trimString(item.ResourceElementId || item.RbsElementId || ''), disabledFlag: item.DisabledFlag === true || item.DisabledFlag === 'true' || item.DisabledFlag === 'Y' });\n}\nvar result = { projectName: trimString(planInfo.projectName || ''), projectNumber: trimString(planInfo.projectNumber || ''), projectId: trimString(planInfo.projectId || ''), planVersionId: trimString(planInfo.planVersionId || ''), quantity: totalQuantity, rawCost: firstValue(planInfo, ['rawCost']) || totalRawCost, burdenedCost: firstValue(planInfo, ['burdenedCost']) || totalBurdenedCost, revenue: firstValue(planInfo, ['revenue']) || totalRevenue, margin: planInfo.margin, assignmentCount: assignments.length, assignments: assignments, projectPlanningRbsId: trimString(prbsContext.projectPlanningRbsId || ''), namedPersonElements: namedPersonElements };\nreturn result;\n",
