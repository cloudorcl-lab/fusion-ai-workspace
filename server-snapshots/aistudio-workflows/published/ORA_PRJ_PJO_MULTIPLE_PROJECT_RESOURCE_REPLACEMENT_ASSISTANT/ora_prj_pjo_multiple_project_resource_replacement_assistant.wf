            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\n\nfunction parseNumber(value) {\n  if (value === null || value === undefined || value === '') {\n    return null;\n  }\n  var num = Number(value);\n  return isNaN(num) ? null : num;\n}\n\nfunction formatEffort(value) {\n  var num = parseNumber(value);\n  if (num === null) {\n    return 'N/A';\n  }\n  return Math.abs(num - Math.round(num)) < 0.005 ? String(Math.round(num)) : num.toFixed(2);\n}\n\nfunction parseObjectMaybe(value) {\n  var current = value;\n  var depth = 0;\n  while (typeof current === 'string' && trimString(current) !== '' && depth < 6) {\n    try {\n      current = JSON.parse(current);\n      depth += 1;\n    } catch (ignore1) {\n      break;\n    }\n  }\n  return current;\n}\n\nfunction extractLoopRows(value) {\n  var parsed = parseObjectMaybe(value);\n  var rows = [];\n  var i;\n  var item;\n  if (Array.isArray(parsed)) {\n    for (i = 0; i < parsed.length; i++) {\n      item = parseObjectMaybe(parsed[i]);\n      if (item && item.result !== undefined) {\n        item = parseObjectMaybe(item.result);\n      } else if (item && item.output !== undefined) {\n        item = parseObjectMaybe(item.output);\n      }\n      if (item && typeof item === 'object') {\n        rows.push(item);\n      }\n    }\n  }\n  return rows;\n}\n\nfunction extractCommitResults(value) {\n  var parsed = parseObjectMaybe(value);\n  var rows = [];\n  var i;\n  var item;\n  if (Array.isArray(parsed)) {\n    for (i = 0; i < parsed.length; i++) {\n      item = parseObjectMaybe(parsed[i]);\n      if (item && item.result !== undefined && typeof item.result !== 'object') {\n        rows.push({ result: item.result });\n      } else if (item && item.output !== undefined && typeof item.output !== 'object') {\n        rows.push({ result: item.output });\n      } else if (item && typeof item === 'object') {\n        rows.push(item);\n      } else if (typeof item === 'string') {\n        rows.push({ result: item });\n      }\n    }\n  }\n  return rows;\n}\n\nfunction isCommitAccepted(value) {\n  var result = trimString(value && value.result !== undefined ? value.result : value);\n  if (result === '') {\n    return true;\n  }\n  return /^success$/i.test(result) || /^ok$/i.test(result) || /success/i.test(result);\n}\n\nfunction normalizeDate(value) {\n  var raw = trimString(value);\n  var match = raw.match(/(\\d{4})[-\\/](\\d{1,2})[-\\/](\\d{1,2})/);\n  if (!match) {\n    return raw;\n  }\n  return match[1] + '-' + (match[2].length === 1 ? '0' + match[2] : match[2]) + '-' + (match[3].length === 1 ? '0' + match[3] : match[3]);\n}\n\nfunction longDateDisplay(value) {\n  var normalized = normalizeDate(value);\n  var monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];\n  var match = normalized.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);\n  if (!match) {\n    return trimString(value) || 'the effective date';\n  }\n  return monthNames[Number(match[2]) - 1] + ' ' + String(Number(match[3])) + ', ' + match[1];\n}\n\nfunction tableText(value) {\n  var text = trimString(value);\n  return text ? text.replace(/\\|/g, '/') : 'N/A';\n}\n\nfunction projectKey(item) {\n  return trimString(item.ProjectId || item.projectId || '') ||\n    trimString(item.ProjectNumber || item.projectNumber || '') ||\n    trimString(item.ProjectName || item.projectName || '') ||\n    trimString(item.PlanVersionId || item.planVersionId || '');\n}\n\nfunction projectLabel(item) {\n  return trimString(item.ProjectName || item.projectName || item.ProjectNumber || item.projectNumber || 'Project');\n}\n\nfunction fallbackRowsFromSelectedItems() {\n  var resolved = (($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_RESOLVE_PENDING_ITEMS_V2 || {}).$output || {}).result || {};\n  var items = resolved.replacementItems || [];\n  return Array.isArray(items) ? items : [];\n}\n\nfunction planVersionId(item) {\n  return trimString((item || {}).PlanVersionId || (item || {}).planVersionId || '');\n}\n\nfunction budgetItemKey(item, index) {\n  return projectKey(item) + '|' + trimString(item.TaskId || item.taskId || '') + '|' + trimString(item.TaskNumber || item.taskNumber || '') + '|' + planVersionId(item) + '|' + String(index);\n}\n\nfunction budgetEligibleItems(candidates) {\n  var out = [];\n  var seen = {};\n  var i;\n  var item;\n  var key;\n  for (i = 0; i < candidates.length; i++) {\n    item = candidates[i] || {};\n    if (!planVersionId(item)) {\n      continue;\n    }\n    key = budgetItemKey(item, i);\n    if (seen[key]) {\n      continue;\n    }\n    seen[key] = true;\n    out.push(item);\n  }\n  return out;\n}\n\nvar rows = extractLoopRows((($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FETCH_CROSS_PROJECT_POST_COMMIT_PLANS_V1 || {}).$output) || []);\nvar commitRows = extractCommitResults((($context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_COMMIT_REPLACEMENTS || {}).$output) || []);\nvar selected = fallbackRowsFromSelectedItems();\nif (!rows.length) {\n  rows = selected;\n}\n\nvar groups = {};\nvar order = [];\nvar verifiedCount = 0;\nvar committedCount = 0;\nvar i;\nvar row;\nvar selectedRow;\nvar key;\nvar group;\nvar commitRow;\nvar commitAccepted;\nvar oldResourceName = trimString($context.$variables.PendingOldResourceName || '');\nvar newResourceName = trimString($context.$variables.PendingNewResourceName || '');\nvar effectiveDate = trimString($context.$variables.PendingUnavailabilityDate || '');\nvar lines = [];\nvar response;\nvar budgetCandidates;\nvar budgetItems;\nvar pendingItemsJson;\nvar result;\n\nif (!rows.length) {\n  result = {\n    response: 'Cross-project replacement finished, but I could not build the post-commit summary.',\n    intentStart: 'N',\n    intentEnd: 'Y',\n    pendingAction: '',\n    pendingItemsJson: '[]',\n    pendingProjectName: '',\n    pendingOldResourceName: '',\n    pendingNewResourceName: '',\n    pendingUnavailabilityDate: '',\n    nextStage: ''\n  };\n  return result;\n}\n\nfor (i = 0; i < rows.length; i++) {\n  row = rows[i] || {};\n  selectedRow = selected[i] || row;\n  key = projectKey(row) || projectKey(selectedRow) || ('Project ' + String(i + 1));\n  if (!groups[key]) {\n    groups[key] = { projectName: projectLabel(row) || projectLabel(selectedRow), rows: 0, verified: 0, committed: 0, tasks: [], taskSeen: {}, planned: 0, remaining: 0 };\n    order.push(key);\n  }\n  group = groups[key];\n  group.rows += 1;\n  commitRow = commitRows[i] || {};\n  commitAccepted = isCommitAccepted(commitRow);\n  if (row.CommitVerified === true) {\n    group.verified += 1;\n    verifiedCount += 1;\n  }\n  if (commitAccepted) {\n    group.committed += 1;\n    committedCount += 1;\n  }\n  var task = trimString((row.TaskNumber || selectedRow.TaskNumber || '') + (row.TaskName || selectedRow.TaskName ? ' - ' + (row.TaskName || selectedRow.TaskName || '') : ''));\n  if (task && !group.taskSeen[task]) {\n    group.taskSeen[task] = true;\n    group.tasks.push(task);\n  }\n  if (parseNumber(selectedRow.BeforeQuantity) !== null) {\n    group.planned += parseNumber(selectedRow.BeforeQuantity);\n  }\n  if (parseNumber(selectedRow.RemainingQuantity) !== null) {\n    group.remaining += parseNumber(selectedRow.RemainingQuantity);\n  }\n}\n\nfor (i = 0; i < order.length; i++) {\n  group = groups[order[i]];\n  var statusText = group.verified === group.rows ? 'Verified' : (group.committed === group.rows ? 'Replaced' : (group.verified > 0 || group.committed > 0 ? 'Partially replaced' : 'Submitted'));\n  lines.push('| ' + String(i + 1) + ' | ' + statusText + ' | ' + tableText(group.projectName) + ' | ' + String(group.rows) + ' | ' + tableText(group.tasks.slice(0, 4).join('; ')) + ' | ' + formatEffort(group.planned) + ' | ' + formatEffort(group.remaining) + ' |');\n}\n\nbudgetCandidates = rows.length ? rows : selected;\nbudgetItems = budgetEligibleItems(budgetCandidates);\npendingItemsJson = budgetItems.length ? encodeURIComponent(JSON.stringify(budgetItems)) : '[]';\n\nif (committedCount > 0 || verifiedCount > 0) {\n  var updatedAssignmentCount = committedCount || verifiedCount;\n  response = 'Replacement completed successfully. ' + (oldResourceName || 'The current resource') + ' has been replaced with ' + (newResourceName || 'the replacement resource') + ' across the impacted project assignments effective ' + longDateDisplay(effectiveDate) + '. ' + String(updatedAssignmentCount) + ' assignments were updated.';\n  if (budgetItems.length) {\n    response += String.fromCharCode(10) + String.fromCharCode(10) + 'Would you like me to update the budgets for any of these projects? If so, please specify the project name.';\n    result = {\n      response: response,\n      intentStart: 'Y',\n      intentEnd: 'N',\n      pendingAction: 'CROSS_PROJECT_BUDGET_PROJECT_SELECTION',\n      pendingItemsJson: pendingItemsJson,\n      pendingProjectName: '',\n      pendingOldResourceName: oldResourceName,\n      pendingNewResourceName: newResourceName,\n      pendingUnavailabilityDate: effectiveDate,\n      nextStage: 'CROSS_PROJECT_BUDGET_PROJECT_SELECTION'\n    };\n  } else {\n    result = {\n      response: response,\n      intentStart: 'N',\n      intentEnd: 'Y',\n      pendingAction: '',\n      pendingItemsJson: '[]',\n      pendingProjectName: '',\n      pendingOldResourceName: '',\n      pendingNewResourceName: '',\n      pendingUnavailabilityDate: '',\n      nextStage: ''\n    };\n  }\n} else {\n  response = 'I could not verify any cross-project replacement updates for ' + (oldResourceName || 'the current resource') + ' to ' + (newResourceName || 'the replacement resource') + '. No assignments were confirmed as replaced.';\n  result = {\n    response: response,\n    intentStart: 'N',\n    intentEnd: 'Y',\n    pendingAction: '',\n    pendingItemsJson: '[]',\n    pendingProjectName: '',\n    pendingOldResourceName: '',\n    pendingNewResourceName: '',\n    pendingUnavailabilityDate: '',\n    nextStage: ''\n  };\n}\nreturn result;"
          },
