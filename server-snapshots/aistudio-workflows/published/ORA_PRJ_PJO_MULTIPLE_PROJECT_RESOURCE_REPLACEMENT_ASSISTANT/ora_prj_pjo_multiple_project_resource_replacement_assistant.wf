            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\n\nfunction parseItems(raw) {\n  var text = trimString(raw);\n  var parsed = [];\n  if (!text) {\n    return [];\n  }\n  try {\n    parsed = JSON.parse(decodeURIComponent(text));\n  } catch (ignore1) {\n    try {\n      parsed = JSON.parse(text);\n    } catch (ignore2) {\n      parsed = [];\n    }\n  }\n  return Array.isArray(parsed) ? parsed : [];\n}\n\nfunction normalizeKey(value) {\n  return trimString(value).toLowerCase().replace(/[^a-z0-9]+/g, '');\n}\n\nfunction toNumber(value) {\n  var text;\n  var num;\n  if (value === null || value === undefined || value === '') {\n    return null;\n  }\n  if (typeof value === 'number') {\n    return isNaN(value) ? null : value;\n  }\n  text = trimString(value);\n  if (!text) {\n    return null;\n  }\n  if (/^\\(.+\\)$/.test(text)) {\n    text = '-' + text.slice(1, -1);\n  }\n  text = text.replace(/[$,\\s]/g, '');\n  num = Number(text);\n  return isNaN(num) ? null : num;\n}\n\nfunction firstNumber(source, names) {\n  var i;\n  var num;\n  source = source || {};\n  for (i = 0; i < names.length; i++) {\n    num = toNumber(source[names[i]]);\n    if (num !== null) {\n      return num;\n    }\n  }\n  return null;\n}\n\nfunction addNumber(total, value) {\n  var num = toNumber(value);\n  if (num === null) {\n    return total;\n  }\n  return total === null ? num : total + num;\n}\n\nfunction addCommas(value) {\n  return String(value).replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',');\n}\n\nfunction formatAmount(value, plusForPositive) {\n  var num = toNumber(value);\n  var sign = '';\n  var cents;\n  var whole;\n  var fraction;\n  if (num === null) {\n    return 'N/A';\n  }\n  if (num < 0) {\n    sign = '-';\n  } else if (plusForPositive && num > 0) {\n    sign = '+';\n  }\n  cents = Math.round(Math.abs(num) * 100);\n  whole = Math.floor(cents / 100);\n  fraction = cents % 100;\n  return sign + '$' + addCommas(whole) + (fraction ? '.' + (fraction < 10 ? '0' : '') + String(fraction) : '');\n}\n\nfunction formatVariance(currentValue, revisedValue) {\n  var current = toNumber(currentValue);\n  var revised = toNumber(revisedValue);\n  if (current === null || revised === null) {\n    return 'N/A';\n  }\n  return formatAmount(revised - current, true);\n}\n\nfunction projectKey(item) {\n  return normalizeKey(item.ProjectId || item.projectId || '') ||\n    normalizeKey(item.ProjectNumber || item.projectNumber || '') ||\n    normalizeKey(item.ProjectName || item.projectName || '') ||\n    normalizeKey(item.PlanVersionId || item.planVersionId || '');\n}\n\nfunction setFirstNumber(group, fieldName, value) {\n  var num = toNumber(value);\n  if (group[fieldName] === null && num !== null) {\n    group[fieldName] = num;\n  }\n}\n\nfunction chooseNumber() {\n  var i;\n  var num;\n  for (i = 0; i < arguments.length; i++) {\n    num = toNumber(arguments[i]);\n    if (num !== null) {\n      return num;\n    }\n  }\n  return null;\n}\n\nfunction finalizeProjectGroup(group) {\n  group.currentCost = chooseNumber(group.currentCostPlan, group.currentCostAssignmentSum, group.currentCostLegacy);\n  group.revisedCost = chooseNumber(group.revisedCostPlan, group.revisedCostAssignmentSum, group.revisedCostLegacy);\n  group.currentRevenue = chooseNumber(group.currentRevenuePlan, group.currentRevenueAssignmentSum, group.currentRevenueLegacy);\n  group.revisedRevenue = chooseNumber(group.revisedRevenuePlan, group.revisedRevenueAssignmentSum, group.revisedRevenueLegacy);\n}\n\nfunction buildProjectGroups(items) {\n  var groups = [];\n  var byKey = {};\n  var i;\n  var item;\n  var key;\n  var group;\n  for (i = 0; i < items.length; i++) {\n    item = items[i] || {};\n    key = projectKey(item);\n    if (!key) {\n      key = 'item' + String(i + 1);\n    }\n    group = byKey[key];\n    if (!group) {\n      group = {\n        index: groups.length + 1,\n        key: key,\n        projectName: trimString(item.ProjectName || item.projectName || item.ProjectNumber || item.projectNumber || ''),\n        projectNumber: trimString(item.ProjectNumber || item.projectNumber || ''),\n        planVersionId: trimString(item.PlanVersionId || item.planVersionId || ''),\n        assignmentCount: 0,\n        items: [],\n        currentCost: null,\n        revisedCost: null,\n        currentRevenue: null,\n        revisedRevenue: null,\n        currentCostPlan: null,\n        revisedCostPlan: null,\n        currentRevenuePlan: null,\n        revisedRevenuePlan: null,\n        currentCostLegacy: null,\n        revisedCostLegacy: null,\n        currentRevenueLegacy: null,\n        revisedRevenueLegacy: null,\n        currentCostAssignmentSum: null,\n        revisedCostAssignmentSum: null,\n        currentRevenueAssignmentSum: null,\n        revisedRevenueAssignmentSum: null\n      };\n      byKey[key] = group;\n      groups.push(group);\n    }\n    group.assignmentCount += 1;\n    group.items.push(item);\n    if (!group.planVersionId) {\n      group.planVersionId = trimString(item.PlanVersionId || item.planVersionId || '');\n    }\n    setFirstNumber(group, 'currentCostPlan', firstNumber(item, ['BeforePlanBurdenedCost', 'BeforePlanRawCost', 'OlderVersionPCBurdenedCostAmounts', 'OlderVersionPFCBurdenedCostAmounts', 'OlderVersionBurdenedCostAmounts', 'OlderVersionBurdenedCostInProjectCurrency', 'OlderVersionBurdenedCostInProjectLedgerCurrency', 'OlderVersionPCRawCostAmounts', 'OlderVersionPFCRawCostAmounts', 'OlderVersionRawCostAmounts', 'CurrentCost']));\n    setFirstNumber(group, 'revisedCostPlan', firstNumber(item, ['AfterPlanBurdenedCost', 'AfterPlanRawCost', 'PCBurdenedCostAmounts', 'PFCBurdenedCostAmounts', 'BurdenedCostAmounts', 'BurdenedCostInProjectCurrency', 'BurdenedCostInProjectLedgerCurrency', 'PCRawCostAmounts', 'PFCRawCostAmounts', 'RawCostAmounts', 'RevisedCost']));\n    setFirstNumber(group, 'currentRevenuePlan', firstNumber(item, ['BeforePlanRevenue', 'OlderVersionPCRevenueAmounts', 'OlderVersionPFCRevenueAmounts', 'OlderVersionRevenueAmounts', 'OlderVersionRevenueInProjectCurrency', 'OlderVersionRevenueInProjectLedgerCurrency', 'CurrentRevenue']));\n    setFirstNumber(group, 'revisedRevenuePlan', firstNumber(item, ['AfterPlanRevenue', 'PCRevenueAmounts', 'PFCRevenueAmounts', 'RevenueAmounts', 'RevenueInProjectCurrency', 'RevenueInProjectLedgerCurrency', 'RevisedRevenue']));\n    group.currentCostAssignmentSum = addNumber(group.currentCostAssignmentSum, firstNumber(item, ['BeforeAssignmentBurdenedCost', 'BeforeAssignmentRawCost']));\n    group.revisedCostAssignmentSum = addNumber(group.revisedCostAssignmentSum, firstNumber(item, ['AfterAssignmentBurdenedCost', 'AfterAssignmentRawCost']));\n    group.currentRevenueAssignmentSum = addNumber(group.currentRevenueAssignmentSum, firstNumber(item, ['BeforeAssignmentRevenue']));\n    group.revisedRevenueAssignmentSum = addNumber(group.revisedRevenueAssignmentSum, firstNumber(item, ['AfterAssignmentRevenue']));\n    setFirstNumber(group, 'currentCostLegacy', firstNumber(item, ['BeforeBurdenedCost', 'BeforeRawCost']));\n    setFirstNumber(group, 'revisedCostLegacy', firstNumber(item, ['AfterBurdenedCost', 'AfterRawCost']));\n    setFirstNumber(group, 'currentRevenueLegacy', firstNumber(item, ['BeforeRevenue']));\n    setFirstNumber(group, 'revisedRevenueLegacy', firstNumber(item, ['AfterRevenue']));\n  }\n  for (i = 0; i < groups.length; i++) {\n    finalizeProjectGroup(groups[i]);\n  }\n  return groups;\n}\n\nfunction projectMatchScore(message, group) {\n  var msg = normalizeKey(message);\n  var nameKey = normalizeKey(group.projectName);\n  var numberKey = normalizeKey(group.projectNumber);\n  if (!msg) {\n    return 0;\n  }\n  if (msg === nameKey || msg === numberKey) {\n    return 100;\n  }\n  if (nameKey && (nameKey.indexOf(msg) > -1 || msg.indexOf(nameKey) > -1)) {\n    return 80;\n  }\n  if (numberKey && (numberKey.indexOf(msg) > -1 || msg.indexOf(numberKey) > -1)) {\n    return 80;\n  }\n  return 0;\n}\n\nfunction selectProject(message, groups) {\n  var lower = trimString(message).toLowerCase();\n  var numeric = lower.match(/^(?:project|option)?\\s*(\\d+)$/);\n  var best = null;\n  var bestScore = 0;\n  var tie = false;\n  var i;\n  var score;\n  if (numeric) {\n    var index = Number(numeric[1]);\n    if (index >= 1 && index <= groups.length) {\n      return groups[index - 1];\n    }\n  }\n  for (i = 0; i < groups.length; i++) {\n    score = projectMatchScore(message, groups[i]);\n    if (score > bestScore) {\n      best = groups[i];\n      bestScore = score;\n      tie = false;\n    } else if (score === bestScore && score > 0) {\n      tie = true;\n    }\n  }\n  return best && !tie ? best : null;\n}\n\nfunction groupList(groups) {\n  var lines = [];\n  var i;\n  for (i = 0; i < groups.length; i++) {\n    lines.push('| ' + String(i + 1) + ' | ' + (groups[i].projectName || 'Project') + ' | ' + groups[i].assignmentCount + ' |');\n  }\n  return '| S No. | Project | Updated Assignments |' + String.fromCharCode(10) +\n    '| --- | --- | --- |' + String.fromCharCode(10) +\n    lines.join(String.fromCharCode(10));\n}\n\nfunction impactTable(groups) {\n  var lines = ['| Project | Current Cost | Revised Cost | Cost Variance | Current Revenue | Revised Revenue | Revenue Variance |', '| --- | --- | --- | --- | --- | --- | --- |'];\n  var i;\n  var group;\n  for (i = 0; i < groups.length; i++) {\n    group = groups[i];\n    lines.push('| ' + (group.projectName || group.projectNumber || 'Project') + ' | ' + formatAmount(group.currentCost, false) + ' | ' + formatAmount(group.revisedCost, false) + ' | ' + formatVariance(group.currentCost, group.revisedCost) + ' | ' + formatAmount(group.currentRevenue, false) + ' | ' + formatAmount(group.revisedRevenue, false) + ' | ' + formatVariance(group.currentRevenue, group.revisedRevenue) + ' |');\n  }\n  return lines.join(String.fromCharCode(10));\n}\n\nvar effectiveState = $context.$nodes.PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_EFFECTIVE_STATE_V2.$output.result || {};\nvar variables = $context.$variables || {};\nvar raw = String(variables.PendingReplacementItemsJson || effectiveState.PendingReplacementItemsJson || '');\nvar pendingAction = trimString(variables.PendingAction || effectiveState.PendingAction || '');\nvar message = trimString(effectiveState.EffectiveInputMessage || variables.EffectiveInputMessage || '');\nvar lower = message.toLowerCase().replace(/\\s+/g, ' ').trim();\nvar items = parseItems(raw);\nvar groups = buildProjectGroups(items);\nvar oldResourceName = trimString(variables.PendingOldResourceName || effectiveState.PendingOldResourceName || '');\nvar newResourceName = trimString(variables.PendingNewResourceName || effectiveState.PendingNewResourceName || '');\nvar effectiveDate = trimString(variables.PendingUnavailabilityDate || effectiveState.PendingUnavailabilityDate || '');\nvar selected = null;\nvar response = '';\nvar canSync = false;\nvar actionSkip = /^(no|n|skip|not now|later|cancel|stop)$/i.test(lower);\nvar actionYes = /^(yes|y|sync|synchronize|generate|create|go ahead|go-ahead|proceed|ok|okay|sure)$/i.test(lower);\nvar allProjects = /\\b(all|every|across all|all projects|every project|group|multiple)\\b/i.test(lower);\nvar asksBudgetImpact = /\\b(show|view|display|what|impact|analysis)\\b.*\\bbudget/i.test(lower) || /\\bbudget\\b.*\\b(impact|analysis)\\b/i.test(lower);\nvar result;\n\nif (!items.length || !groups.length) {\n  result = {\n    response: 'There is no pending cross-project replacement budget follow-up.',\n    canSync: false,\n    intentStart: 'N',\n    intentEnd: 'Y',\n    pendingAction: '',\n    pendingItemsJson: '[]',\n    pendingProjectName: '',\n    pendingOldResourceName: '',\n    pendingNewResourceName: '',\n    pendingUnavailabilityDate: '',\n    nextStage: '',\n    selectedProjectName: '',\n    selectedPlanVersionId: ''\n  };\n  return result;\n}\n\nif (actionSkip) {\n  result = {\n    response: 'Budget follow-up skipped for the cross-project replacement.',\n    canSync: false,\n    intentStart: 'N',\n    intentEnd: 'Y',\n    pendingAction: '',\n    pendingItemsJson: '[]',\n    pendingProjectName: '',\n    pendingOldResourceName: '',\n    pendingNewResourceName: '',\n    pendingUnavailabilityDate: '',\n    nextStage: '',\n    selectedProjectName: '',\n    selectedPlanVersionId: ''\n  };\n  return result;\n}\n\nif (asksBudgetImpact) {\n  selected = allProjects ? null : selectProject(message, groups);\n  var impactGroups = selected ? [selected] : groups;\n  response = 'Budget Impact Analysis:' + String.fromCharCode(10) + String.fromCharCode(10) + impactTable(impactGroups);\n  response += String.fromCharCode(10) + String.fromCharCode(10) + (groups.length > 1 ? 'To update a budget, specify one project name from the table. Budget updates across multiple projects are performance intensive.' : 'Specify the project name to update the budget, or reply no to skip.');\n  result = {\n    response: response,\n    canSync: false,\n    intentStart: 'Y',\n    intentEnd: 'N',\n    pendingAction: 'CROSS_PROJECT_BUDGET_PROJECT_SELECTION',\n    pendingItemsJson: raw,\n    pendingProjectName: '',\n    pendingOldResourceName: oldResourceName,\n    pendingNewResourceName: newResourceName,\n    pendingUnavailabilityDate: effectiveDate,\n    nextStage: 'CROSS_PROJECT_BUDGET_PROJECT_SELECTION',\n    selectedProjectName: '',\n    selectedPlanVersionId: ''\n  };\n  return result;\n}\n\nif (pendingAction === 'CROSS_PROJECT_BUDGET_FOLLOWUP_CONFIRM') {\n  selected = selectProject(message.replace(/^(yes|y|sync|synchronize|generate|create|go ahead|go-ahead|proceed|ok|okay|sure)\\b/i, ''), groups);\n  if (actionYes && groups.length === 1) {\n    selected = groups[0];\n  }\n  if (actionYes && groups.length > 1 && !selected) {\n    response = 'Specify one project to update the budget. Budget updates across multiple projects are performance intensive.' + String.fromCharCode(10) + String.fromCharCode(10) + groupList(groups);\n  } else if (!actionYes && !selected) {\n    response = 'Specify one project to update the budget, ask to show budget impact, or reply no to skip.';\n  }\n} else {\n  if (actionYes) {\n    response = 'Specify one project to update the budget.' + String.fromCharCode(10) + String.fromCharCode(10) + groupList(groups);\n  } else if (allProjects) {\n    response = 'Specify one project to update the budget. Budget updates across multiple projects are performance intensive.' + String.fromCharCode(10) + String.fromCharCode(10) + groupList(groups);\n  } else {\n    selected = selectProject(message, groups);\n    if (!selected) {\n      response = 'I could not match \"' + message + '\" to one updated project. Specify one project from the list to update the budget.' + String.fromCharCode(10) + String.fromCharCode(10) + groupList(groups);\n    }\n  }\n}\n\nif (selected) {\n  canSync = true;\n  response = '';\n}\n\nresult = {\n  response: response,\n  canSync: canSync,\n  intentStart: canSync ? 'Y' : 'Y',\n  intentEnd: canSync ? 'N' : 'N',\n  pendingAction: canSync ? 'CROSS_PROJECT_BUDGET_SYNC_IN_PROGRESS' : 'CROSS_PROJECT_BUDGET_PROJECT_SELECTION',\n  pendingItemsJson: raw,\n  pendingProjectName: selected ? selected.projectName : '',\n  pendingOldResourceName: oldResourceName,\n  pendingNewResourceName: newResourceName,\n  pendingUnavailabilityDate: effectiveDate,\n  nextStage: canSync ? 'CROSS_PROJECT_BUDGET_SYNC' : 'CROSS_PROJECT_BUDGET_PROJECT_SELECTION',\n  selectedProjectName: selected ? selected.projectName : '',\n  selectedPlanVersionId: selected ? selected.planVersionId : ''\n};\nreturn result;"
