          "inputs": [
            {
              "id": "1765232069008_1",
              "name": "prompt",
              "type": "string",
              "value": "using  {{$context.$nodes.REQUISITION_ACTION_LOOP.$output}}\nactionCode -> action attribute from {{$context.$triggers.REST.$input.OraAction}}\n\ncheck the responseResult node  in the json payload\nusing this node:\nReturn a message that displays the status (Failure or Success) of the action and the requisitionTitle and requisitionNumber from the responseResult node.  If requisitionTitle and requisitionNumber are blank , state that it was an invalid requisitionId.\n\nAdd a line: \"Please see the status for the requisition below\"\n\nuse this format:\n\n<Requisition Title> - <Requisition Number>\nStatus: <status>\n\nexample:\n\nZBENJNAwesome Analyst - ZBENJN0003213\nStatus: Success\n\nDisplay nothing more than this information for the requisitions in the responseResult node."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Extract Requisition Id",
            "returnType": "array",
            "sourceCode": "var inputObj = $context.$triggers.REST.$input || {};\nvar rawInput = inputObj.OraAction || inputObj.oraAction;\nvar payloadData = {};\nvar requestedIds = [];\n\nif (typeof rawInput === 'string') {\n    var cleanInput = rawInput.trim();\n    if (cleanInput.indexOf('{') === 0) {\n        try {\n            payloadData = JSON.parse(cleanInput);\n        } catch (e) {\n            payloadData = {};\n        }\n    }\n} else if (rawInput && typeof rawInput === 'object') {\n    payloadData = rawInput;\n}\n\nif (payloadData && payloadData.requisitionId !== undefined && payloadData.requisitionId !== null) {\n    var rawReqIds = payloadData.requisitionId;\n    if (Array.isArray(rawReqIds)) {\n        for (var i = 0; i < rawReqIds.length; i++) {\n            if (rawReqIds[i] !== undefined && rawReqIds[i] !== null && rawReqIds[i] !== '') {\n                requestedIds.push(String(rawReqIds[i]));\n            }\n        }\n    } else if (rawReqIds !== '') {\n        requestedIds.push(String(rawReqIds));\n    }\n}\n\nvar rawVisibleInput = $context.$variables.WFAgentData;\nvar visibleRows = [];\n\nif (Array.isArray(rawVisibleInput)) {\n    visibleRows = rawVisibleInput;\n} else if (typeof rawVisibleInput === 'string') {\n    try {\n        var parsedVisible = JSON.parse(rawVisibleInput);\n        if (Array.isArray(parsedVisible)) {\n            visibleRows = parsedVisible;\n        } else if (parsedVisible && Array.isArray(parsedVisible.result)) {\n            visibleRows = parsedVisible.result;\n        } else if (parsedVisible && parsedVisible.result && Array.isArray(parsedVisible.result.items)) {\n            visibleRows = parsedVisible.result.items;\n        } else if (parsedVisible && Array.isArray(parsedVisible.items)) {\n            visibleRows = parsedVisible.items;\n        } else if (parsedVisible && Array.isArray(parsedVisible.requisitions)) {\n            visibleRows = parsedVisible.requisitions;\n        }\n    } catch (e2) {\n        visibleRows = [];\n    }\n} else if (rawVisibleInput && typeof rawVisibleInput === 'object') {\n    if (Array.isArray(rawVisibleInput.result)) {\n        visibleRows = rawVisibleInput.result;\n    } else if (rawVisibleInput.result && Array.isArray(rawVisibleInput.result.items)) {\n        visibleRows = rawVisibleInput.result.items;\n    } else if (Array.isArray(rawVisibleInput.items)) {\n        visibleRows = rawVisibleInput.items;\n    } else if (Array.isArray(rawVisibleInput.requisitions)) {\n        visibleRows = rawVisibleInput.requisitions;\n    }\n}\n\nvar requestedMap = {};\nfor (var j = 0; j < requestedIds.length; j++) {\n    requestedMap[requestedIds[j]] = true;\n}\n\nvar outputIds = [];\nvar outputMap = {};\n\nif (visibleRows.length > 0) {\n    for (var k = 0; k < visibleRows.length; k++) {\n        var row = visibleRows[k] || {};\n        var visibleReqId = '';\n        if (row.RequisitionId !== undefined && row.RequisitionId !== null && row.RequisitionId !== '') {\n            visibleReqId = String(row.RequisitionId);\n        }\n\n        if (visibleReqId !== '') {\n            if (requestedIds.length === 0 || requestedMap[visibleReqId] === true) {\n                if (outputMap[visibleReqId] !== true) {\n                    outputIds.push(visibleReqId);\n                    outputMap[visibleReqId] = true;\n                }\n            }\n        }\n    }\n} else {\n    for (var m = 0; m < requestedIds.length; m++) {\n        if (outputMap[requestedIds[m]] !== true) {\n            outputIds.push(requestedIds[m]);\n            outputMap[requestedIds[m]] = true;\n        }\n    }\n}\n\nreturn outputIds;"
          },
          "outcomes": {
            "success": "1769795289051"
          },
          "code": "EXTRACT_REQUISITION_ID",
          "id": "1768418628957",
