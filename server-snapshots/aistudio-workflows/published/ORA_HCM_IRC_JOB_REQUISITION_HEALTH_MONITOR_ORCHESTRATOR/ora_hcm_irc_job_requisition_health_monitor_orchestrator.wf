              "layouts": [],
              "enableActions": true,
              "enableCommunications": false
            }
          },
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.75
              },
              "code": "ORA_LLM_PREMIUM",
              "model": "OPEN_AI_GPT_4_1_MINI",
              "modelName": "GPT-4.1 mini",
              "provider": "CERT_PREMIUM"
            },
            "name": "Action LLM Widget"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "URGENT_ACTIONS",
          "id": "1765225756510",
          "inputs": [
            {
              "id": "1765225756513_1",
              "name": "prompt",
              "type": "string",
              "value": "You are provided with the exact requisition widget data below:\n{{$context.$variables.WFAgentData}}\n\nReturn action insights only. Do not return explanatory text.\n\nGenerate widget-level bulk action insights deterministically from the visible requisition rows in the input.\n\nImportant action scope rule:\n- Close and Suspend are independent widget-level bulk actions.\n- Both actions must use the same full visible requisition list from the input.\n- Do not split requisitions between Close and Suspend.\n- Do not use JobApplicationCount or NewJobApplicationCount to decide whether a requisition appears in Close or Suspend.\n- A requisition with NewJobApplicationCount = 0 and JobApplicationCount > 0 must still appear in both the Close and Suspend action payloads.\n\nInput handling:\n- Read requisitions from the array in WFAgentData, WFAgentData.result, WFAgentData.items, or WFAgentData.requisitions.\n- Preserve the input order.\n- Do not rank, re-rank, filter by urgency, or select a subset.\n- Do not drop duplicate titles.\n- Do not fabricate requisition ids.\n- Use RequisitionId for action payloads.\n\nOutput requirements:\n- Return exactly two raw <oraInsight> blocks when there is at least one requisition in the input: one Close action and one Suspend action.\n- Do not include priority.\n- Do not include row-level actions.\n- The Close action's requisitionId array must contain every visible requisition's RequisitionId.\n- The Suspend action's requisitionId array must contain every visible requisition's RequisitionId.\n- The Close and Suspend requisitionId arrays must be identical and in the same order as the input rows.\n- If there are no requisitions in the input, use empty arrays for both actions.\n\nClose insight shape:\n<oraInsight>\n{\n  \"title\": \"Close\",\n  \"shortDescription\": \"Moves the Requisitions to the Closed state\",\n  \"actionText\": \"Close Job Requisitions\",\n  \"followUpCommand\": \"ora.Invoke(\\\"CLOSEBULK\\\", {\\n  \\\"action\\\": \\\"CLOSEBULK\\\",\\n  \\\"requisitionId\\\": [<all visible RequisitionId values>]\\n})\"\n}\n</oraInsight>\n\nSuspend insight shape:\n<oraInsight>\n{\n  \"title\": \"Suspend\",\n  \"shortDescription\": \"Moves the Requisitions to the Suspended state\",\n  \"actionText\": \"Suspend Job Requisitions\",\n  \"followUpCommand\": \"ora.Invoke(\\\"SUSPENDBULK\\\", {\\n  \\\"action\\\": \\\"SUSPENDBULK\\\",\\n  \\\"requisitionId\\\": [<all visible RequisitionId values>]\\n})\"\n}\n</oraInsight>"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Draft Important Messages"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "DRAFT_IMPORTANT_MESSAGES",
          "id": "1765226050287",
          "inputs": [
            {
              "id": "1765226050288_1",
              "name": "prompt",
              "type": "string",
              "value": "You are provided with requisition data below:\n\n {{$context.$nodes.PREPARE_DATA_FOR_COMMUNICATION.$output.result}} \n\nYour task: Analyze this data to identify requisitions requiring communication or alerts, focusing on top 5 requisitions requiring attention and top K candidates proposed.\n\nIF requisitions requiring communication are found:\n\nCreate a requisition alert communication with the following exact structure:\n\n{\n  id: \"listOfCandidates\",\n  defaultValue: \"<comma-separated list of candidate names requiring attention>\"\n}\n\n{\n  id: \"statusUpdate\", \n  defaultValue: \"<Exactly three sentences summarizing the most critical requisitions requiring attention (top 5 requisitions and top K candidates proposed), their specific issues, and recommended actions>\"\n}\n\nIF no requisitions requiring communication are found:\n\nReturn an empty response with no data.\n\nRequirements:\n\n- Set generatingAgent to \"HT_REQUISITION_ORCHESTRATOR_AGENT\"\n- Set targetAgent to \"HT_REQUISITION_ORCHESTRATOR_AGENT\"\n- Set templateId to \"requisitionAlerts\"\n- Use only the requisition number/title field from the data\n- Prioritize the most critical cases in your statusUpdate (no candidate pipeline, posting issues, urgent time-to-fill, missing prospects, etc.)\n- Be specific about requisition issues in your summary (mention requisition numbers, specific problems, candidate pipeline status, posting errors)\n- Use professional, actionable language\n\nExample Output Structure:\n\n{\n  \"generatingAgent\": \"HT_REQUISITION_ORCHESTRATOR_AGENT\",\n  \"targetAgent\": \"HT_REQUISITION_ORCHESTRATOR_AGENT\",\n  \"templateId\": \"requisitionAlerts\",\n  \"parameters\": [\n    {\n      \"id\": \"listOfRequisitions\",\n      \"defaultValue\": \"<REQUISITION_NUMBER_A> - <REQUISITION_TITLE_A>, <REQUISITION_NUMBER_B> - <REQUISITION_TITLE_B>, <REQUISITION_NUMBER_C> - <REQUISITION_TITLE_C>\"\n    },\n    {\n      \"id\": \"statusUpdate\",\n      \"defaultValue\": \"<REQUISITION_NUMBER_A> (<REQUISITION_TITLE_A>) is in the top set requiring attention with a weak candidate pipeline, and proposed candidates from the data need review. <REQUISITION_NUMBER_B> (<REQUISITION_TITLE_B>) has an urgent time-to-fill risk with limited candidate flow and needs additional sourcing. <REQUISITION_NUMBER_C> (<REQUISITION_TITLE_C>) is stalled due to a posting or sourcing issue that requires immediate resolution.\"\n    }\n  ]\n}"
            }
          ],
          "type": "LLM"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_MESSAGES_LIST"
              ],
              "enableActions": true,
              "enableCommunications": false,
              "customNotes": "Displays a summary of the requisition pipelines for a recruitment application indicating their health status like applicant count etc."
            }
          },
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_completion_tokens": 32000,
                "reasoning_effort": "minimal"
              },
              "code": "ORA_MODEL_CONFIG_PREMIUM_OPEN_AI_GPT_4_1_MINI",
              "model": "OCI_GPT_5_MINI",
              "modelName": "GPT-5 mini",
              "provider": "CERT_PREMIUM"
            },
            "name": "Display LLM Agent Widget"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "DISPLAY_LLM_AGENT",
          "id": "1765229991674",
          "inputs": [
            {
              "id": "1765229991679_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a Requisition Pipeline Health Advisor.\n\nYour task is to display the provided requisition results exactly as they are in the messageListWidget (oraInfoDisplay XML) format.\n\nInput Data:\n{{$context.$variables.WFAgentData}}\n\nDIRECTIVE (ABSOLUTE):\n- Do NOT perform any health analysis.\n- Do NOT re-rank.\n- Do NOT re-evaluate badge logic.\n- Do NOT compute or display Health Score.\n- Do NOT display BadgeReason.\n- Do NOT infer, modify, normalize, or “fix” any field values.\n- Simply transform each requisition object into a corresponding oraInfoDisplay XML item.\n\nNO FILTERING OF REQUISITIONS (ABSOLUTE):\n- Do NOT apply any filtering logic.\n- Do NOT exclude any requisition.\n- Do NOT drop, skip, remove, or reorder any requisition.\n- Preserve the original input order.\n- Output item count must equal input item count.\n\nBADGE + COLOR RENDERING (USE WIDGET PRIORITY ONLY):\n- Render badge label using: badgeText = the existing Badge value exactly as provided.\n- Render badge color using ONLY the \"priority\" field.\n- Allowed priority values are ONLY: alert, warning, medium, success.\n- Do NOT use any other values (e.g., do NOT use: info, danger, RED, ORANGE, BLUE).\n- If an unsupported priority is used, the widget may default and show the wrong color.\n\nSTRICT PRIORITY LOOKUP (EXACT MATCH ONLY):\n- If Badge == \"Skill Gap\"  → priority = \"alert\"\n- If Badge == \"Low Volume\" → priority = \"warning\"\n- If Badge == \"Stagnant\"   → priority = \"medium\"\n\nNON-MATCH RULE:\n- If Badge is missing, null, empty, or not exactly one of the three values above:\n  - Render badgeText as provided (if present),\n  - Omit the priority field (do not default),\n  - Do NOT guess.\n\nMANDATORY SELF-CHECK BEFORE OUTPUT:\nFor each requisition item:\n1) Determine priority using ONLY the lookup table above.\n2) Validate:\n   - Badge \"Low Volume\" MUST have priority \"warning\" (never \"medium\").\n   - Badge \"Skill Gap\" MUST have priority \"alert\".\n   - Badge \"Stagnant\" MUST have priority \"medium\".\n3) If validation fails, STOP and correct the priority.\n4) Then generate the XML.\n\nROOT CONFIGURATION:\ntitle the section \"These requisitions need your attention\".\ndescription: Provide exactly one sentence summarizing which requisition needs the most immediate attention.\n\nDISPLAY FIELDS (SHOW ONLY THESE):\n- RequisitionTitle: \"<Title> \" - \" <RequisitionNumber>\"\n- Location: \"PrimaryLocationName\"\n- Posting Date: format as mm-dd-yyyy, derived from first available:\n    1) ExternalPublishedJobStartDate\n    2) InternalPublishedJobStartDate\n    3) CreationDate\n- Count of Active Job Applications: \"NewJobApplicationCount\" (if missing, show blank)\n- Count of Total Job Applications: \"JobApplicationCount\" (if missing, show blank)\n\nINTERACTION:\nRow action:\nora.Invoke(\"REQDRILLDOWN\", {\"requisitionId\":\"<RequisitionId>\", \"issue\":\"<BadgeText>\"})\n\nROW COMPLETENESS REQUIREMENTS:\n- The number of XML item blocks must exactly match the number of requisition objects in the input.\n- Never omit a requisition due to missing fields.\n- If a field is missing, render it blank but still output the row.\n- Never merge or collapse rows.\n\nSTRICT FORMATTING:\n- DATE FORMAT: mm-dd-yyyy only.\n- Never display timestamps.\n- Never output YYYY-MM-DD format.\n- Do not show anything in camel case or snake case, use plain english, for example: NewJobApplicationCount -> New Job Application Count\n- Do not fabricate any data."
            }
          ],
          "outputSpecification": "",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Prepare Data For Communication",
            "returnType": "object",
            "sourceCode": "//Prepare Data For Communication Agent\nreturn null;"
          },
          "outcomes": {
            "success": "1765226050287"
          },
          "code": "PREPARE_DATA_FOR_COMMUNICATION",
          "id": "1765230116849",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Prepare Agent Data",
            "returnType": "object",
            "sourceCode": "var loadedRaw = $context.$nodes.LOAD_OR_CACHE_CONTEXT.$output.output;\nvar loadedData = null;\nif (loadedRaw !== null && loadedRaw !== undefined && loadedRaw !== '') {\n  if (typeof loadedRaw === 'string') {\n    try {\n      loadedData = JSON.parse(loadedRaw);\n    } catch (e1) {\n      loadedData = null;\n    }\n  } else {\n    loadedData = loadedRaw;\n  }\n}\n\nvar runtimeInput = $context.$triggers.REST.$input || {};\nvar rawUiContext = runtimeInput.OraUiContext;\nvar uiContext = null;\nif (rawUiContext !== null && rawUiContext !== undefined && rawUiContext !== '') {\n  if (typeof rawUiContext === 'string') {\n    try {\n      uiContext = JSON.parse(rawUiContext);\n    } catch (e2) {\n      uiContext = null;\n    }\n  } else {\n    uiContext = rawUiContext;\n  }\n}\n\nvar question = $context.$system.$inputMessage;\nif (question === null || question === undefined) {\n  question = '';\n}\nquestion = String(question);\nvar questionLower = question.toLowerCase();\nvar questionTermsRaw = questionLower.replace(/[^a-z0-9]+/g, ' ').split(' ');\nvar questionTerms = [];\nvar questionNumbers = [];\nvar stopWords = {\n  'why': true,\n  'what': true,\n  'which': true,\n  'about': true,\n  'does': true,\n  'this': true,\n  'that': true,\n  'need': true,\n  'needs': true,\n  'requiring': true,\n  'require': true,\n  'attention': true,\n  'requisition': true,\n  'requisitions': true,\n  'req': true,\n  'job': true,\n  'zben': true,\n  'iq': true,\n  'feedback': true,\n  'feeedback': true,\n  'feeeedback': true,\n  'title': true,\n  'the': true,\n  'is': true,\n  'are': true,\n  'for': true,\n  'and': true\n};\nfor (var qt = 0; qt < questionTermsRaw.length; qt += 1) {\n  var qTerm = questionTermsRaw[qt];\n  if (!qTerm) {\n    continue;\n  }\n  var parsedNumber = parseInt(qTerm, 10);\n  var qTermNoZero = qTerm.replace(/^0+/, '');\n  if (!isNaN(parsedNumber) && (String(parsedNumber) === qTermNoZero || qTermNoZero === '')) {\n    questionNumbers.push(qTerm);\n  }\n  if (qTerm.length >= 3 && !stopWords[qTerm]) {\n    questionTerms.push(qTerm);\n  }\n}\n\nvar panels = [];\nif (uiContext && Object.prototype.toString.call(uiContext.panels) === '[object Array]') {\n  panels = uiContext.panels;\n}\n\nvar requisitionPanels = [];\nvar visibleItems = [];\nvar normalizedVisibleItems = [];\nvar matchedVisibleRequisitions = [];\nvar visibleTextLines = [];\nfor (var i = 0; i < panels.length; i += 1) {\n  var panel = panels[i] || {};\n  var panelNameRaw = panel.panelName === null || panel.panelName === undefined ? '' : String(panel.panelName);\n  var panelTitleRaw = panel.title === null || panel.title === undefined ? '' : String(panel.title);\n  var panelName = panelNameRaw.toLowerCase();\n  var panelTitle = panelTitleRaw.toLowerCase();\n  var agentCode = panel.agentCode === null || panel.agentCode === undefined ? '' : String(panel.agentCode);\n  var isRequisitionPanel = agentCode === 'ORA_HCM_IRC_JOB_REQUISITION_HEALTH_MONITOR_ORCHESTRATOR' ||\n    panelName.indexOf('requisition') >= 0 ||\n    panelTitle.indexOf('requisition') >= 0;\n  if (!isRequisitionPanel) {\n    continue;\n  }\n  requisitionPanels.push(panel);\n  var widgets = Object.prototype.toString.call(panel.widgets) === '[object Array]' ? panel.widgets : [];\n  for (var w = 0; w < widgets.length; w += 1) {\n    var widget = widgets[w] || {};\n    var config = widget.config || {};\n    var rawItems = [];\n    if (Object.prototype.toString.call(config.items) === '[object Array]') {\n      for (var itemIndex = 0; itemIndex < config.items.length; itemIndex += 1) {\n        rawItems.push(config.items[itemIndex]);\n      }\n    }\n    if (Object.prototype.toString.call(config.rows) === '[object Array]') {\n      for (var rowIndex = 0; rowIndex < config.rows.length; rowIndex += 1) {\n        rawItems.push(config.rows[rowIndex]);\n      }\n    }\n    for (var ri = 0; ri < rawItems.length; ri += 1) {\n      var rawItem = rawItems[ri] || {};\n      visibleItems.push(rawItem);\n\n      var title = rawItem.title === null || rawItem.title === undefined ? '' : String(rawItem.title);\n      var subtitle = rawItem.subtitle === null || rawItem.subtitle === undefined ? '' : String(rawItem.subtitle);\n      var summary = rawItem.summary === null || rawItem.summary === undefined ? '' : String(rawItem.summary);\n      var timestamp = rawItem.timestamp === null || rawItem.timestamp === undefined ? '' : String(rawItem.timestamp);\n      var action = rawItem.action === null || rawItem.action === undefined ? '' : String(rawItem.action);\n      var badge = '';\n      if (rawItem.badge !== null && rawItem.badge !== undefined) {\n        badge = String(rawItem.badge);\n      } else if (rawItem.status !== null && rawItem.status !== undefined) {\n        badge = String(rawItem.status);\n      }\n\n      var postingDate = timestamp;\n      var newJobApplicationCount = '';\n      var jobApplicationCount = '';\n      var summaryLines = summary.split(/\\r?\\n/);\n      for (var sl = 0; sl < summaryLines.length; sl += 1) {\n        var line = summaryLines[sl];\n        var colonIndex = line.indexOf(':');\n        if (colonIndex < 0) {\n          continue;\n        }\n        var key = line.slice(0, colonIndex).replace(/^\\s+|\\s+$/g, '');\n        var value = line.slice(colonIndex + 1).replace(/^\\s+|\\s+$/g, '');\n        if (key === 'Posting Date') {\n          postingDate = value;\n        } else if (key === 'New Job Application Count') {\n          newJobApplicationCount = value;\n        } else if (key === 'Job Application Count') {\n          jobApplicationCount = value;\n        }\n      }\n\n      var requisitionNumber = '';\n      var dashIndex = title.lastIndexOf(' - ');\n      if (dashIndex >= 0) {\n        requisitionNumber = title.slice(dashIndex + 3);\n      }\n\n      var reqId = '';\n      var reqIdMatch = action.match(/requisitionId[\"']?\\s*:\\s*[\"']?([0-9]+)/i);\n      if (reqIdMatch && reqIdMatch.length > 1) {\n        reqId = reqIdMatch[1];\n      }\n      var issue = '';\n      var issueMatch = action.match(/issue[\"']?\\s*:\\s*[\"']([^\"']+)[\"']/i);\n      if (issueMatch && issueMatch.length > 1) {\n        issue = issueMatch[1];\n      }\n      if (!issue && questionLower.indexOf('attention') >= 0) {\n        issue = badge;\n      }\n\n      var searchText = (title + ' ' + requisitionNumber + ' ' + subtitle + ' ' + summary + ' ' + timestamp + ' ' + badge + ' ' + issue).toLowerCase();\n      var normalizedSearchText = searchText.replace(/[^a-z0-9]+/g, '');\n      var normalizedQuestion = questionLower.replace(/[^a-z0-9]+/g, '');\n      var tokenMatches = 0;\n      for (var termIndex = 0; termIndex < questionTerms.length; termIndex += 1) {\n        var term = questionTerms[termIndex];\n        var normalizedTerm = term.replace(/[^a-z0-9]+/g, '');\n        if (searchText.indexOf(term) >= 0 || normalizedSearchText.indexOf(normalizedTerm) >= 0) {\n          tokenMatches += 1;\n        }\n      }\n      var suffixMatches = 0;\n      var itemNumberText = (title + ' ' + requisitionNumber).toLowerCase();\n      for (var numIndex = 0; numIndex < questionNumbers.length; numIndex += 1) {\n        var qNum = questionNumbers[numIndex];\n        var qNumNoZero = qNum.replace(/^0+/, '');\n        if (itemNumberText.indexOf(qNum) >= 0 || (qNumNoZero && itemNumberText.indexOf(qNumNoZero) >= 0)) {\n          suffixMatches += 1;\n        }\n      }\n      var fuzzyCodeMatch = false;\n      if (normalizedQuestion.indexOf('feedback') >= 0 || normalizedQuestion.indexOf('feeedback') >= 0 || normalizedQuestion.indexOf('feeeedback') >= 0) {\n        if (normalizedSearchText.indexOf('feedback') >= 0 && suffixMatches > 0) {\n          fuzzyCodeMatch = true;\n        }\n      }\n\n      var visibleRequisition = {\n        title: title,\n        requisitionNumber: requisitionNumber,\n        location: subtitle,\n        postingDate: postingDate,\n        newJobApplicationCount: newJobApplicationCount,\n        jobApplicationCount: jobApplicationCount,\n        issue: issue || badge,\n        requisitionId: reqId,\n        summary: summary,\n        action: action\n      };\n      normalizedVisibleItems.push(visibleRequisition);\n      visibleTextLines.push(title + ' | Location: ' + subtitle + ' | Posting Date: ' + postingDate + ' | New Applications: ' + newJobApplicationCount + ' | Total Applications: ' + jobApplicationCount + ' | Issue: ' + (issue || badge));\n      if (suffixMatches > 0 || fuzzyCodeMatch || tokenMatches >= 2 || (questionTerms.length === 1 && tokenMatches === 1)) {\n        matchedVisibleRequisitions.push(visibleRequisition);\n      }\n    }\n  }\n}\n\nreturn {\n  workflowData: loadedData,\n  visibleRequisitionPanels: requisitionPanels,\n  visibleRequisitionItems: visibleItems,\n  visibleRequisitionWidget: {\n    items: normalizedVisibleItems,\n    text: visibleTextLines.join('\\n')\n  },\n  matchedVisibleRequisitions: matchedVisibleRequisitions,\n  userQuestion: question\n};"
          },
