                  ],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
                  "type": "WORKFLOW"
                },
                {
                  "metadata": {
                    "name": "Set oraAction",
                    "returnType": "string",
                    "sourceCode": "var inputObj = $context.$triggers.REST.$input || {};\nvar rawInput = inputObj.OraAction || inputObj.oraAction;\nvar payloadData = {};\nvar detectedAction = '';\n\nif (typeof rawInput === 'string') {\n    var cleanInput = rawInput.trim();\n    if (cleanInput.indexOf('{') === 0) {\n        try {\n            payloadData = JSON.parse(cleanInput);\n            if (payloadData.action !== undefined && payloadData.action !== null) {\n                detectedAction = payloadData.action;\n            }\n        } catch (e) {\n            detectedAction = '';\n        }\n    } else {\n        detectedAction = cleanInput;\n    }\n} else if (rawInput && typeof rawInput === 'object') {\n    payloadData = rawInput;\n    if (rawInput.action !== undefined && rawInput.action !== null) {\n        detectedAction = rawInput.action;\n    } else if (rawInput.followUpCommand !== undefined && rawInput.followUpCommand !== null) {\n        detectedAction = rawInput.followUpCommand;\n    }\n}\n\nvar cleanAction = '';\nif (detectedAction !== undefined && detectedAction !== null && detectedAction !== '') {\n    cleanAction = String(detectedAction).toUpperCase().replace(/_/g, '').replace(/\\s/g, '');\n}\n\nvar childAction = cleanAction;\nif (cleanAction.indexOf('SUSPEND') >= 0) {\n    childAction = 'SUSPEND';\n} else if (cleanAction.indexOf('CLOSE') >= 0) {\n    childAction = 'CLOSE';\n}\n\nvar currentReqId = $context.$nodes.REQUISITION_ACTION_LOOP.$currentItem;\nvar outputObj = {\n    action: childAction,\n    requisitionId: currentReqId\n};\n\nreturn JSON.stringify(outputObj);"
                  },
                  "outcomes": {
                    "success": "1769790856767"
                  },
                  "code": "SET_ORAACTION",
                  "id": "1768419017444",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "Set RequisitionTitle and Number",
                    "returnType": "object",
                    "sourceCode": "var reqId = $context.$nodes.REQUISITION_ACTION_LOOP.$currentItem;\nvar normalizedReqId = '';\nif (reqId !== undefined && reqId !== null && reqId !== '') {\n    normalizedReqId = String(reqId);\n}\n\nvar rawInput = $context.$variables.WFAgentData;\nvar rawData = [];\n\nif (Array.isArray(rawInput)) {\n    rawData = rawInput;\n} else if (typeof rawInput === 'string') {\n    try {\n        var parsed = JSON.parse(rawInput);\n        if (Array.isArray(parsed)) {\n            rawData = parsed;\n        } else if (parsed && Array.isArray(parsed.result)) {\n            rawData = parsed.result;\n        } else if (parsed && parsed.result && Array.isArray(parsed.result.items)) {\n            rawData = parsed.result.items;\n        } else if (parsed && Array.isArray(parsed.requisitions)) {\n            rawData = parsed.requisitions;\n        } else if (parsed && Array.isArray(parsed.items)) {\n            rawData = parsed.items;\n        }\n    } catch (e) {\n        rawData = [];\n    }\n} else if (rawInput && typeof rawInput === 'object') {\n    if (Array.isArray(rawInput.result)) {\n        rawData = rawInput.result;\n    } else if (rawInput.result && Array.isArray(rawInput.result.items)) {\n        rawData = rawInput.result.items;\n    } else if (Array.isArray(rawInput.items)) {\n        rawData = rawInput.items;\n    } else if (Array.isArray(rawInput.requisitions)) {\n        rawData = rawInput.requisitions;\n    }\n}\n\nvar reqTitle = '';\nvar reqNumber = '';\n\nfor (var i = 0; i < rawData.length; i++) {\n    var row = rawData[i] || {};\n    var rowReqId = '';\n    if (row.RequisitionId !== undefined && row.RequisitionId !== null && row.RequisitionId !== '') {\n        rowReqId = String(row.RequisitionId);\n    }\n\n    if (rowReqId !== '' && rowReqId === normalizedReqId) {\n        if (row.Title !== undefined && row.Title !== null) {\n            reqTitle = row.Title;\n        }\n        if (row.RequisitionNumber !== undefined && row.RequisitionNumber !== null) {\n            reqNumber = row.RequisitionNumber;\n        }\n        break;\n    }\n}\n\nvar reqInfo = {\n    RequisitionId: normalizedReqId,\n    RequisitionTitle: reqTitle,\n    RequisitionNumber: reqNumber\n};\n\nreturn reqInfo;"
                  },
