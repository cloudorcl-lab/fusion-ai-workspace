            "name": "checkNoReqsReturned",
            "returnType": "boolean",
            "sourceCode": "function parseValue(value) {\n  if (!value) {\n    return null;\n  }\n  if (typeof value === 'string') {\n    try {\n      return JSON.parse(value);\n    } catch (error) {\n      return null;\n    }\n  }\n  return value;\n}\n\nvar hint = String(($context.$triggers.REST.$input || {}).OraMessageHint || '');\nif (hint === 'Query') {\n  return false;\n}\n\nvar agentData = parseValue($context.$nodes.LOAD_OR_CACHE_CONTEXT.$output.output);\nvar result = agentData && agentData.result;\nif (Array.isArray(result)) {\n  return result.length === 0 && hint !== 'Summary';\n}\nif (result && Array.isArray(result.items)) {\n  return result.items.length === 0 && hint !== 'Summary';\n}\nreturn result == null && hint !== 'Summary';"
          },
