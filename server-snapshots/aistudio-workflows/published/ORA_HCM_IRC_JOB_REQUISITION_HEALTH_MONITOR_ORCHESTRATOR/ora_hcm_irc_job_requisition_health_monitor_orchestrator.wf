            "sourceCode": "// Robust Input Normalization\nvar rawInput = $context.$variables.WFAgentData;\nvar rawData = [];\nif (Array.isArray(rawInput)) {\n    rawData = rawInput;\n} else if (typeof rawInput === 'string') {\n    try {\n        var parsed = JSON.parse(rawInput);\n        if (Array.isArray(parsed)) {\n            rawData = parsed;\n        } else if (parsed && Array.isArray(parsed.result)) {\n            rawData = parsed.result;\n        } else if (parsed && Array.isArray(parsed.requisitions)) {\n            rawData = parsed.requisitions;\n        } else if (parsed && Array.isArray(parsed.items)) {\n            rawData = parsed.items;\n        }\n    } catch (e) {\n        rawData = [];\n    }\n} else if (rawInput && typeof rawInput === 'object') {\n    if (Array.isArray(rawInput.result)) {\n        rawData = rawInput.result;\n    } else if (Array.isArray(rawInput.items)) {\n        rawData = rawInput.items;\n    } else if (Array.isArray(rawInput.requisitions)) {\n        rawData = rawInput.requisitions;\n    }\n}\n\nrawData;"
