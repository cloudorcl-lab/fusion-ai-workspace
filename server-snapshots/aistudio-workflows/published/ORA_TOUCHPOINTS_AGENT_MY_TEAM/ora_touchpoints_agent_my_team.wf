        {
          "metadata": {
            "name": "Derive Check-In Summary Parameters",
            "returnType": "object",
            "sourceCode": "var raw = null;\n\nif ($context &&\n    $context.$triggers &&\n    $context.$triggers.REST &&\n    $context.$triggers.REST.$input) {\n  raw = $context.$triggers.REST.$input.additional_context;\n}\n\nvar parsed = {};\nif (raw && typeof raw === \"string\") {\n  try {\n    parsed = JSON.parse(raw);\n  } catch (e) {\n    parsed = {};\n  }\n} else if (raw && typeof raw === \"object\") {\n  parsed = raw;\n}\n\nfunction asString(value) {\n  if (value === null || value === undefined) {\n    return \"\";\n  }\n  return String(value);\n}\n\nreturn {\n  managerPersonId: asString(parsed.managerPersonId),\n  checkInTemplateName: asString(parsed.checkInTemplateName),\n  fromDate: asString(parsed.fromDate),\n  endDate: asString(parsed.endDate),\n  managerName: asString(parsed.managerName),\n  employeeName: asString(parsed.employeeName)\n};"
          },
          "outcomes": {
            "success": "1778284911982"
          },
