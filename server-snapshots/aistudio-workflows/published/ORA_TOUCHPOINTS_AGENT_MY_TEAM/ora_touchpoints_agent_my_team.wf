        {
          "metadata": {
            "name": "Clean Team Update Summary",
            "returnType": "object",
            "sourceCode": "var raw = $context.$nodes.GET_TEAM_UPDATE_SUMMARY.$output;\nvar removeKeys = {\n  \"hasMore\": true,\n  \"limit\": true,\n  \"offset\": true,\n  \"links\": true,\n  \"@context\": true\n};\n\nfunction clean(value) {\n  if (value === null || value === undefined) {\n    return value;\n  }\n\n  if (Array.isArray(value)) {\n    var arr = [];\n    for (var i = 0; i < value.length; i++) {\n      arr.push(clean(value[i]));\n    }\n    return arr;\n  }\n\n  if (typeof value === \"object\") {\n    var obj = {};\n    var keys = Object.keys(value);\n    for (var k = 0; k < keys.length; k++) {\n      var key = keys[k];\n      if (removeKeys[key]) {\n        continue;\n      }\n      obj[key] = clean(value[key]);\n    }\n    return obj;\n  }\n\n  return value;\n}\n\nreturn clean(raw);"
          },
          "outcomes": {
            "success": "1778932000000"
          },
          "code": "CLEAN_TEAM_UPDATE_SUMMARY",
          "id": "1778284917000",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Normalize Team Update Evidence",
            "returnType": "object",
            "sourceCode": "var raw = $context.$nodes.CLEAN_TEAM_UPDATE_SUMMARY.$output.result || {};\n\nfunction asArray(value) {\n  if (!value) {\n    return [];\n  }\n  if (Array.isArray(value)) {\n    return value;\n  }\n  if (value.items && Array.isArray(value.items)) {\n    return value.items;\n  }\n  return [];\n}\n\nfunction decodeEntities(text) {\n  return String(text || '')\n    .replace(/&nbsp;/gi, ' ')\n    .replace(/&amp;/gi, '&')\n    .replace(/&lt;/gi, '<')\n    .replace(/&gt;/gi, '>')\n    .replace(/&#39;/gi, \"'\")\n    .replace(/&quot;/gi, '\"');\n}\n\nfunction htmlToText(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  return decodeEntities(String(value))\n    .replace(/<br\\s*\\/?>/gi, '\\n')\n    .replace(/<\\/p>/gi, '\\n')\n    .replace(/<\\/div>/gi, '\\n')\n    .replace(/<\\/li>/gi, '\\n')\n    .replace(/<li>/gi, '- ')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/\\r/g, '')\n    .replace(/[ \\t]+/g, ' ')\n    .replace(/\\n[ \\t]+/g, '\\n')\n    .replace(/\\n{3,}/g, '\\n\\n')\n    .trim();\n}\n\nfunction normalizeText(value) {\n  return htmlToText(value).replace(/\\s+/g, ' ').trim();\n}\n\nfunction pushUnique(arr, value) {\n  if (value && arr.indexOf(value) === -1) {\n    arr.push(value);\n  }\n}\n\nfunction pushUniqueObject(arr, obj, keyBuilder) {\n  var key = keyBuilder(obj);\n  for (var i = 0; i < arr.length; i++) {\n    if (keyBuilder(arr[i]) === key) {\n      return;\n    }\n  }\n  arr.push(obj);\n}\n\nfunction splitMeaningfulLines(text) {\n  var normalized = htmlToText(text);\n  if (!normalized) {\n    return [];\n  }\n  var lines = normalized.split(/\\n+/);\n  var result = [];\n  for (var i = 0; i < lines.length; i++) {\n    var line = normalizeText(lines[i]);\n    if (!line) {\n      continue;\n    }\n    if (line === 'Summary:' || line === 'Action Items:') {\n      continue;\n    }\n    pushUnique(result, line.replace(/^-\\s*/, ''));\n  }\n  return result;\n}\n\nfunction extractSelectedChoices(block) {\n  var choices = [];\n  var regex = /ChoiceText=([^,}]+), CorrectChoiceFlag=[^,}]+, ChoiceSelectedFlag=Y/g;\n  var match;\n  while ((match = regex.exec(block)) !== null) {\n    pushUnique(choices, normalizeText(match[1]));\n  }\n  return choices;\n}\n\nfunction extractField(block, token, endTokens) {\n  var start = block.indexOf(token);\n  if (start === -1) {\n    return '';\n  }\n  start += token.length;\n  var end = block.length;\n  for (var i = 0; i < endTokens.length; i++) {\n    var idx = block.indexOf(endTokens[i], start);\n    if (idx !== -1 && idx < end) {\n      end = idx;\n    }\n  }\n  return normalizeText(block.substring(start, end));\n}\n\nfunction parseQuestionnaireResponse(rawResponse, sourceType) {\n  if (!rawResponse) {\n    return [];\n  }\n\n  var text = String(rawResponse);\n  var marker = '{RequiredQuestionFlag=';\n  var positions = [];\n  var start = 0;\n\n  while (true) {\n    var idx = text.indexOf(marker, start);\n    if (idx === -1) {\n      break;\n    }\n    positions.push(idx);\n    start = idx + marker.length;\n  }\n\n  var parsed = [];\n  for (var p = 0; p < positions.length; p++) {\n    var block = text.substring(positions[p], p + 1 < positions.length ? positions[p + 1] : text.length);\n    var question = extractField(block, 'QuestionText=', [', ResponseComments=', ', choiceQuestionResponses=', ', QuestionInstructions=', '}], SectionName=', '}], SectionName=', '}]']);\n    var answerText = extractField(block, 'AnswerText=', ['}, QuestionInstructions=', ', QuestionInstructions=', '}, QuestionType=', ', QuestionType=', '}']);\n    var selectedChoices = extractSelectedChoices(block);\n    var answer = answerText || selectedChoices.join(', ');\n\n    if (!question || !answer) {\n      continue;\n    }\n\n    parsed.push({\n      sourceType: sourceType,\n      question: question,\n      answer: answer,\n      selectedChoices: selectedChoices\n    });\n  }\n\n  return parsed;\n}\n\nvar items = asArray(raw.items || raw);\nvar employeeMap = {};\n\nfor (var i = 0; i < items.length; i++) {\n  var item = items[i] || {};\n  var employeeName = normalizeText(item.DisplayName) || 'Unknown Employee';\n  if (!employeeMap[employeeName]) {\n    employeeMap[employeeName] = {\n      employeeName: employeeName,\n      managerName: normalizeText(item.ManagerName),\n      checkIns: [],\n      rolledUp: {\n        discussionTopics: [],\n        topicNoteEvidence: [],\n        selfReportedUpdates: [],\n        managerUpdates: [],\n        meetingSummaryEvidence: [],\n        directManagerGuidance: [],\n        evidenceChecklist: []\n      }\n    };\n  }\n\n  var employee = employeeMap[employeeName];\n  var checkIn = {\n    checkInDate: normalizeText(item.CheckInDate),\n    checkInMeetingName: normalizeText(item.CheckInMeetingName),\n    status: normalizeText(item.Status),\n    reviewPeriodName: normalizeText(item.ReviewPeriodName),\n    discussionTopics: [],\n    selfReportedUpdates: [],\n    managerUpdates: [],\n    meetingSummaryText: htmlToText(item.TranscriptSummary),\n    meetingSummaryItems: splitMeaningfulLines(item.TranscriptSummary),\n    evidenceChecklist: []\n  };\n\n  var agendaItems = asArray(item.agenda);\n  for (var a = 0; a < agendaItems.length; a++) {\n    var agendaItem = agendaItems[a] || {};\n    var topic = normalizeText(agendaItem.ReferenceName);\n    var noteItems = asArray(agendaItem.notes);\n    var noteTexts = [];\n    for (var n = 0; n < noteItems.length; n++) {\n      var note = noteItems[n] || {};\n      var noteText = htmlToText(note.NoteText);\n      if (!noteText) {\n        continue;\n      }\n      noteTexts.push(noteText);\n      pushUniqueObject(employee.rolledUp.topicNoteEvidence, {\n        topic: topic,\n        noteText: noteText,\n        checkInDate: checkIn.checkInDate,\n        checkInMeetingName: checkIn.checkInMeetingName,\n        authorName: normalizeText(note.AuthorName)\n      }, function (entry) {\n        return [entry.topic, entry.noteText, entry.checkInDate].join('|');\n      });\n      pushUnique(employee.rolledUp.directManagerGuidance, noteText);\n      pushUnique(checkIn.evidenceChecklist, 'Topic note | ' + topic + ' | ' + noteText);\n      pushUnique(employee.rolledUp.evidenceChecklist, employeeName + ' | Topic note | ' + topic + ' | ' + noteText);\n    }\n\n    if (topic || noteTexts.length) {\n      var topicEntry = {\n        topic: topic,\n        noteTexts: noteTexts\n      };\n      checkIn.discussionTopics.push(topicEntry);\n      pushUniqueObject(employee.rolledUp.discussionTopics, {\n        topic: topic,\n        noteTexts: noteTexts.slice(),\n        checkInDate: checkIn.checkInDate\n      }, function (entry) {\n        return [entry.topic, entry.noteTexts.join('||'), entry.checkInDate].join('|');\n      });\n      if (topic) {\n        pushUnique(checkIn.evidenceChecklist, 'Topic | ' + topic);\n        pushUnique(employee.rolledUp.evidenceChecklist, employeeName + ' | Topic | ' + topic);\n      }\n    }\n  }\n\n  var workerUpdates = asArray(item.workerQuestionnaires);\n  for (var w = 0; w < workerUpdates.length; w++) {\n    var parsedWorker = parseQuestionnaireResponse(workerUpdates[w] && workerUpdates[w].Response, 'employee_update');\n    for (var pw = 0; pw < parsedWorker.length; pw++) {\n      checkIn.selfReportedUpdates.push(parsedWorker[pw]);\n      pushUniqueObject(employee.rolledUp.selfReportedUpdates, parsedWorker[pw], function (entry) {\n        return [entry.question, entry.answer].join('|');\n      });\n      pushUnique(checkIn.evidenceChecklist, 'Employee update | ' + parsedWorker[pw].question + ' | ' + parsedWorker[pw].answer);\n      pushUnique(employee.rolledUp.evidenceChecklist, employeeName + ' | Employee update | ' + parsedWorker[pw].question + ' | ' + parsedWorker[pw].answer);\n    }\n  }\n\n  var managerUpdates = asArray(item.managerQuestionnaires);\n  for (var m = 0; m < managerUpdates.length; m++) {\n    var parsedManager = parseQuestionnaireResponse(managerUpdates[m] && managerUpdates[m].Response, 'manager_update');\n    for (var pm = 0; pm < parsedManager.length; pm++) {\n      checkIn.managerUpdates.push(parsedManager[pm]);\n      pushUniqueObject(employee.rolledUp.managerUpdates, parsedManager[pm], function (entry) {\n        return [entry.question, entry.answer].join('|');\n      });\n      pushUnique(checkIn.evidenceChecklist, 'Manager update | ' + parsedManager[pm].question + ' | ' + parsedManager[pm].answer);\n      pushUnique(employee.rolledUp.evidenceChecklist, employeeName + ' | Manager update | ' + parsedManager[pm].question + ' | ' + parsedManager[pm].answer);\n      if (/support or guidance|coaching|development expectation|follow[- ]?up|next step|action item/i.test(parsedManager[pm].question)) {\n        pushUnique(employee.rolledUp.directManagerGuidance, parsedManager[pm].answer);\n      }\n    }\n  }\n\n  for (var s = 0; s < checkIn.meetingSummaryItems.length; s++) {\n    var summaryItem = checkIn.meetingSummaryItems[s];\n    pushUniqueObject(employee.rolledUp.meetingSummaryEvidence, {\n      text: summaryItem,\n      checkInDate: checkIn.checkInDate,\n      checkInMeetingName: checkIn.checkInMeetingName\n    }, function (entry) {\n      return [entry.text, entry.checkInDate].join('|');\n    });\n    pushUnique(checkIn.evidenceChecklist, 'Meeting summary | ' + summaryItem);\n    pushUnique(employee.rolledUp.evidenceChecklist, employeeName + ' | Meeting summary | ' + summaryItem);\n  }\n\n  employee.checkIns.push(checkIn);\n}\n\nvar employees = Object.keys(employeeMap).sort().map(function (key) {\n  return employeeMap[key];\n});\n\nreturn {\n  sourceSummary: {\n    employeeCount: employees.length,\n    checkInCount: items.length\n  },\n  employees: employees\n};"
          },
          "outcomes": {
            "success": "1778284922772"
          },
          "code": "NORMALIZE_TEAM_UPDATE_EVIDENCE",
          "id": "1778932000000",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_completion_tokens": 32000,
                "reasoning_effort": "low"
              },
              "code": "ORA_MODEL_GPT_5_4_MINI",
              "model": "OCI_GPT_5_4_MINI",
              "modelName": "Gpt-5.4 Mini",
              "provider": "CERT_PREMIUM"
            },
            "name": "Generate Team Summary"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "GENERATE_TEAM_SUMMARY",
          "id": "1778284922772",
          "inputs": [
            {
              "id": "1778284922772_prompt",
              "name": "prompt",
              "type": "string",
              "value": "# TASK AND RESPONSIBILITIES\n\nUse the normalized evidence from {{$context.$nodes.NORMALIZE_TEAM_UPDATE_EVIDENCE.$output.result}} and evaluate every new user question from {{$context.$system.$inputMessage}} for user intent.\n\nTreat the normalized evidence as the source of truth for the selected manager, template, and date range. The data is already organized by employee and by check-in so that no meaningful source should be ignored.\n\nThe normalized evidence includes:\n- per-employee check-ins\n- discussion topics\n- topic note evidence\n- self-reported updates\n- manager observations\n- meeting summary evidence\n- direct manager guidance\n- evidence checklist entries used for coverage\n\nBefore writing the response:\n- Review the relevant employee or team evidence.\n- Use the evidence checklist to make sure no meaningful item is silently dropped.\n- Ensure every discussion topic with note text is reflected in at least one visible section.\n- Preserve manager observations, coaching guidance, development context, and agreed focus areas in Employee Summary, Achievements, or Priorities. Do not treat them as Needs Attention or Manager Attention Areas unless the employee explicitly asked for manager help or presented an unresolved blocker, concern, risk, or impediment.\n- If two items express the same idea, merge them without losing the stronger or more specific wording.\n\nSYNTHESIS RULES\n\n- The reader is the manager reviewing their own team. Do not refer to the manager in third person, do not mention the manager name, and do not write phrases like \"her manager said\", \"his manager noted\", or \"the manager also described\". Present the evidence directly, for example \"Recent strengths include...\" or \"The check-in notes indicate...\".\n- Use all available evidence types together. Do not rely mainly on meeting summary evidence.\n- Treat topic note evidence as first-class evidence.\n- Preserve material facts from agenda topics, corresponding note text, employee updates, manager updates, and meeting summary evidence.\n- If note text is more specific than the meeting summary, preserve the note text.\n- If sources conflict or the signal is mixed, state that neutrally.\n- Prefer recent check-ins for current-state statements while still preserving repeated patterns across the selected period.\n- Do not expose raw field names or internal schema labels in the visible response.\n- Do not use the visible words \"transcript\" or \"questionnaire\" in the response. Use natural phrases such as meeting summary, self-reported updates, manager observations, discussion topics, and check-in notes.\n- Be concise, but do not omit meaningful evidence merely to stay short.\n- Use plain English only.\n- Use ordinary English letters and standard ASCII punctuation where possible.\n- Do not emit non-English characters, corrupted symbols, or decorative glyphs.\n- Keep the response extractive and evidence-based. Do not add inferred coaching, recommendations, or next steps unless they are explicitly present in the check-in data.\n\n# FORMAT OF THE RESPONSE\n\nFollow these rules strictly:\n\n- Answer using only the available normalized evidence.\n- Do not make up data.\n- Default output format is HTML.\n- DO NOT APPLY any STYLE or CSS.\n- All headings and sub-headings should use bold markup.\n- Use block-level HTML tags to separate headings, sub-headings, and bullet lists.\n- Never place a section heading and an employee name in the same HTML element or on the same rendered line.\n- Do not rely on consecutive <strong> tags by themselves for line breaks. Use separate block elements such as <p>, <div>, <ul>, and <li>.\n- Use plain English only and avoid non-English characters or corrupted symbols.\n- Prefer direct factual statements over interpretive or advisory language.\n- Provide clear spacing between sections and sub-sections.\n- There are three response formats:\n  1. Team Summary format\n  2. Employee Summary format\n  3. All Other Questions format\n\n# TEAM SUMMARY FORMAT\n\nUse this format only when the user is specifically asking for a team summary. Stick to the exact order.\n\nProvide the response in clean HTML with no margins or padding. DO NOT APPLY any STYLE or CSS.\nAll headings and sub-headings should use bold markup.\n\n\"Team Overall Summary\"\n- Describe the overall summary of the team using all available evidence.\n- Do not provide any other summary like weekly or high-level summary before this section.\n- After the summary, provide a bullet list for each employee found in the input data.\n- For each employee include exactly these three subsections:\n  - \"Summary\" Provide a concise integrated summary for every employee based on all available evidence.\n  - \"Sentiment\" Indicate the sentiment in one word only: Positive, Neutral, or Negative.\n  - \"Needs Attention\"  Only when the employee explicitly asked the manager for help or attention, or presented an unresolved blocker, concern, risk, or impediment. Do not populate this section for manager-provided coaching, development context, strengths, priorities, or routine follow-up unless it is tied to an employee-raised ask or blocker. .\n\n\"Team Sentiment\"\n\n- Describe the overall sentiment of the team using all available evidence.\n- It must have two sub-sections titled exactly:\n  - Positives\n  - Negatives\n- Use meaningful bullet points.\n- Positives must include explicitly stated strengths, accomplishments, engagement signals, progress, or positive observations.\n- Negatives must include only explicitly risks, disengagement, missed commitments\n- Do not list routine development context, manager-provided guidance, strengths, or priorities as Negatives by themselves.\n- If no negative evidence exists, say: No clear negative signals were found in the available check-ins.\n\n\n\"Manager Attention Areas\"\n - List only employees who have an employee-raised ask for manager support or attention, or an unresolved blocker, concern, risk, or impediment.\n- Render the section title as its own standalone block-level heading.\n- For each employee, render the employee name in its own standalone block-level sub-header on a new line, then render a separate bullet list below it.\n- Never print an employee name on the same line as the section title.\n- Use a structure equivalent to <p><strong>Manager Attention Areas</strong></p>, then <p><strong>Employee Name</strong></p>, then <ul><li>...</li></ul>.\n- Do not invent extra coaching guidance, follow-up tasks, or recommendations.\n- Do not include manager-provided development context, strengths, priorities, or routine follow-up as attention areas unless the employee also asked for manager help or identified a blocker.\n- If no employee clearly needs attention, say: No employees have explicit support requests or unresolved blockers in the available check-ins.\n\nSeparate the three sections \"Team Overall Summary\", \"Team Sentiment\", and \"Manager Attention Areas\" with proper formatting, separator lines, and spacing between them.\n\n# EMPLOYEE SUMMARY FORMAT\n\nUse this format only when the user is specifically asking for an employee summary.\n\nProvide the response in clean HTML with no margins or padding. DO NOT APPLY any STYLE or CSS.\nAll headings and sub-headings should use bold markup.\n\nPopulate the following sections using all available evidence for that employee:\n- Employee Summary\n- Achievements\n- Blockers\n- Priorities\n- Manager Attention Areas\n\nGuidance for employee summary:\n- - The reader is the manager reviewing their own team. Do not write phrases like \"her manager said\", \"his manager noted\", or \"the manager also described\". Present manager observations directly as check-in evidence, for example \"Recent strengths include...\" or \"The check-in notes indicate...\".\n- Use discussion topics, topic note evidence, employee updates, manager updates, and meeting summary evidence together.\n- Preserve material detail while keeping the summary readable.\n- Keep the output extractive. Do not add interpretations, coaching suggestions, recommendations, or next steps that are not explicitly present in the evidence.\n- Achievements must include only explicitly stated progress, accomplishments, strengths, or positive manager observations.\n- Blockers must include only explicitly stated blockers, concerns, risks, or well-being issues.\n- Priorities must include only explicitly stated current focus areas, goals, or support requests from the check-in data. Do not turn support requests into advice.\n- Manager Attention Areas must include only explicit asks for - Manager Attention Areas must include only explicit employee asks for manager support or attention, or unresolved blockers, concerns, risks, or impediments that appear in the check-in data.\n, unresolved blockers, that appear in the check-in data.\n- Any discussion topic with note text must be reflected in at least one visible section.\n- Direct manager instructions, coaching guidance,- Manager observations, coaching guidance, development context, and agreed focus areas must not be dropped. Place them under Employee Summary, Achievements, or Priorities when they do not fit elsewhere. Do not place them under Manager Attention Areas unless the employee asked for manager help or identified a blocker, concern, risk, or impediment.\n- If a section has no supporting evidence, say that no clear evidence was found in the available check-ins.\n\n# ALL OTHER QUESTIONS FORMAT\n\nUse a normal response format unless the user is specifically asking for team summary or employee summary.\nKeep the response brief, factual, and directly tied to the user's question.\nUse all relevant available evidence.\n\n# IMPORTANT RULES\n\n1. Provide factual answers based strictly on retrieved data.\n2. Never fabricate or assume information.\n3. Do not output tool calls or internal reasoning.\n4. Do not answer questions unrelated to check-in data.\n5. Do not output personal information like PersonId or PersonNumber.\n6. Do not output your plan.\n7. Format responses clearly and professionally for easy readability.\n8. Avoid the visible words \"transcript\" and \"questionnaire\"."
            }
          ],
          "outputSpecification": "",
          "type": "LLM"
        },
