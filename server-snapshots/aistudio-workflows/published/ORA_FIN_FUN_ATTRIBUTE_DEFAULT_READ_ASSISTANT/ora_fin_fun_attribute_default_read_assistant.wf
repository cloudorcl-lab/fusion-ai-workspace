        {
          "metadata": {
            "name": "Final Payload",
            "returnType": "object",
            "sourceCode": "var input = $context.$nodes.TRANSFORM_RULES_PAYLOAD.$output.result;\nvar parsed = JSON.parse(input);\nvar ruleset = parsed.Ruleset || [];\n\nfor (var i = 0; i < ruleset.length; i++) {\n  var rules = ruleset[i].rules || [];\n  for (var j = 0; j < rules.length; j++) {\n    var rule = rules[j];\n\n    if (!rule.ruleConditions || rule.ruleConditions.length === 0) {\n      rule.businessApplicability = \"For all invoices\";\n    } else {\n      var parts = [];\n      for (var c = 0; c < rule.ruleConditions.length; c++) {\n        var cond = rule.ruleConditions[c];\n        var op = (cond.operator || \"\").toLowerCase();\n        var segment;\n        if (op === \"equals to\" || op === \"equals\" || op === \"=\") {\n          segment = cond.attribute + \" is \" + cond.attributeValue;\n        } else {\n          segment = cond.attribute + \" \" + cond.operator + \" \" + cond.attributeValue;\n        }\n        parts.push(segment);\n      }\n\n      // Inline join logic (replaces joinWithCommasAnd function)\n      var joined = \"\";\n      if (parts.length === 0) joined = \"\";\n      else if (parts.length === 1) joined = parts[0];\n      else if (parts.length === 2) joined = parts[0] + \" and \" + parts[1];\n      else joined = parts.slice(0, -1).join(\", \") + \", and \" + parts[parts.length - 1];\n\n      rule.businessApplicability = \"When \" + joined;\n    }\n\n    var targetAttr = \"\";\n    var valueToSet = \"\";\n    var outcomes = rule.ruleOutcomes || [];\n\n    for (var o = 0; o < outcomes.length; o++) {\n      var outcome = outcomes[o];\n      if (outcome.outcome1 === \"Target Attribute\") targetAttr = outcome.value1;\n      if (outcome.outcome2 === \"Value\") {\n        if (outcome.value2) valueToSet = outcome.value2;\n        else if (outcome.valueKey) valueToSet = outcome.valueKey;\n      }\n    }\n\n    if (rule.businessApplicability && targetAttr && valueToSet) {\n      rule.agentRuleText =\n        rule.businessApplicability + \", set \" + targetAttr + \" to \" + valueToSet;\n    }\n  }\n}\n\nreturn JSON.stringify(parsed);"
          },
