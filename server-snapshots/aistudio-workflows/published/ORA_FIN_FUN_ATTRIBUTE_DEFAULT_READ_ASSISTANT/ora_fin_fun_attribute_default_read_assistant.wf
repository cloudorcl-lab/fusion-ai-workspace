          "metadata": {
            "name": "Extract Mapping Sets",
            "returnType": "object",
            "sourceCode": "// Access the rules directly\nvar rules = $context?.$nodes?.GET_ALL_RULES?.$output?.items ??\n  $context?.$nodes?.GET_RULES_BY_CATEGORY?.$output?.items ??\n  $context?.$nodes?.GET_RULES_BY_TARGET_ATTRIBUTE?.$output?.items ??\n  [];\n\n// Safety check\nif (!rules || rules.length === 0) {\n    return [];\n}\n\n// Collect distinct MappingSetCodes with their associated attributes\nvar seen = [];\nvar mappingSets = [];\n\nfor (var i = 0; i < rules.length; i++) {\n    var rule = rules[i];\n\n    // Skip if MappingSetCode is null or empty\n    if (!rule.MappingSetCode) continue;\n\n    var code = rule.MappingSetCode;\n\n    // Add only unique codes\n    if (seen.indexOf(code) === -1) {\n        seen.push(code);\n        mappingSets.push({\n            mappingSetCode: rule.MappingSetCode,\n            targetAttribute: rule.TargetAttribute ?? null,\n            attributeRuleId: rule.AttributeRuleId ?? null\n        });\n    }\n}\n\n// Wrap into mappingSetRequest object\nvar outputPayload = {\n    mappingSetRequest: {\n        mappingSets: mappingSets\n    }\n};\n\n// Return the payload\nreturn outputPayload;"
          },
          "outcomes": {
            "success": "1765794359543"
          },
