        {
          "metadata": {
            "name": "Merge Mappings Output",
            "returnType": "object",
            "sourceCode": "var loopOutputs = $context.$nodes.GET_MAPPINGS.$output;\nvar combinedPayload = [];\nvar combinedApiCalls = [];\nvar apiCallSet = new Set(); // Track unique API calls\n\n// Process each mapping set's output\nfor (var i = 0; i < loopOutputs.length; i++) {\n  var outputString = loopOutputs[i];\n  \n  // Parse the JSON string to get the actual object\n  var parsedOutput = JSON.parse(outputString);\n  \n  // Extract result object\n  var mappingSetResult = parsedOutput.result;\n  \n  if (mappingSetResult && mappingSetResult.payload) {\n    var currentPayloadStartIndex = combinedPayload.length;\n    \n    // Add all rules from this mapping set to combined payload\n    for (var p = 0; p < mappingSetResult.payload.length; p++) {\n      combinedPayload.push(mappingSetResult.payload[p]);\n    }\n    \n    // Add API calls from this mapping set, adjusting ruleIndex\n    if (mappingSetResult.apiCalls && mappingSetResult.apiCalls.length > 0) {\n      for (var a = 0; a < mappingSetResult.apiCalls.length; a++) {\n        var apiCall = mappingSetResult.apiCalls[a];\n        \n        // Create unique key from the four fields\n        var uniqueKey = [\n          apiCall.valueSource,\n          apiCall.valueSourceKey,\n          apiCall.valueKey,\n          apiCall.attributeKey\n        ].join('|');\n        \n        // Only add if this combination hasn't been seen before\n        if (!apiCallSet.has(uniqueKey)) {\n          apiCallSet.add(uniqueKey);\n          \n          // Adjust ruleIndex to point to correct position in combined payload\n          var adjustedCall = {\n            ruleIndex: currentPayloadStartIndex + apiCall.ruleIndex,\n            conditionIndex: apiCall.conditionIndex,\n            valueSource: apiCall.valueSource,\n            valueSourceKey: apiCall.valueSourceKey,\n            valueKey: apiCall.valueKey,\n            value: apiCall.value,\n            depValKey:apiCall.depValueKey,\n            attributeKey: apiCall.attributeKey\n          };\n          \n          combinedApiCalls.push(adjustedCall);\n        }\n      }\n    }\n  }\n}\n\n// Create final formatted output\nvar result = {\n    payload: combinedPayload,\n    apiCalls: combinedApiCalls\n};\n\nreturn result;"
