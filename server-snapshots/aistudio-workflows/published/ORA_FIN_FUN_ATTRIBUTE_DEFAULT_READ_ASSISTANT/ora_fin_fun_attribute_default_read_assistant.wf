                {
                  "metadata": {
                    "name": "MappingSet Rules",
                    "returnType": "object",
                    "sourceCode": "var finalPayload = $context.$variables.pMappingSetRulesPayload;\nif (!finalPayload) {\n  finalPayload = [];\n}\n\nvar headerOut = $context.$nodes.GET_MAPPINGS.GET_MAPPINGSET_BY_CODE.$output;\nvar headerItems = headerOut && headerOut.items ? headerOut.items : [];\n\nvar sourceOut = $context.$nodes.GET_MAPPINGS.GET_MAPPINGSET_INPUTS.$output;\nvar sourceItems = sourceOut && sourceOut.items ? sourceOut.items : [];\n\nvar flavorOut = $context.$nodes.GET_MAPPINGS.GET_MAPPINGSET_FLAVOR.$output;\nvar flavorItems = flavorOut && flavorOut.items ? flavorOut.items : [];\n\nvar valueOut = $context.$nodes.GET_MAPPINGS.GET_MAPPINGSET_VALUES.$output;\nvar valueItems = valueOut && valueOut.items ? valueOut.items : [];\n\nvar targetAttribute = $context.$nodes.GET_MAPPINGS.$currentItem.targetAttribute;\n\nvar apiCallsNeeded = [];\nvar apiCallsSet = new Object();\nvar depValKey = null;\n\nvar depParentMap = new Object();\ndepParentMap['ORA_DISTRIBUTION_SET_ID']    = 'ORA_BU_ID';\ndepParentMap['ORA_PROJECT_ID']             = 'ORA_BU_ID';\ndepParentMap['ORA_PROJ_TASK_ID']           = 'ORA_PROJECT_ID';\ndepParentMap['ORA_PROJ_EXP_TYPE_ID']       = 'ORA_PROJECT_ID';\ndepParentMap['ORA_PROJ_ORGANIZATION_ID']   = 'ORA_BU_ID';\ndepParentMap['ORA_PROJ_CONTRACT_ID']       = 'ORA_PROJECT_ID';\ndepParentMap['ORA_PROJ_FUNDING_SOURCE']    = 'ORA_PROJ_CONTRACT_ID';\ndepParentMap['ORA_LINE_DISTRIBUTION_CCID'] = 'ORA_PRIMARY_LEDGER_ID';\ndepParentMap['ORA_DEF_ACCTG_ACCRUAL_CCID'] = 'ORA_PRIMARY_LEDGER_ID';\ndepParentMap['ORA_REGIONAL_INFORMATION'] = 'ORA_LEGAL_ENTITY_ID';\n\nif (headerItems.length > 0) {\n\n  var header = headerItems[0];\n\n  for (var v = 0; v < valueItems.length; v++) {\n\n    var valRow = valueItems[v];\n\n    var mappingRule = new Object();\n    mappingRule.MappingSetCode = header.MappingSetCode || \"\";\n    mappingRule.MappingSetId = header.MappingSetId || \"\";\n    mappingRule.MappingSetName = header.Name || \"\";\n    mappingRule.Description = header.Description || \"\";\n    mappingRule.MappingSetValueId = valRow.MappingSetValueId || \"\";\n    mappingRule.MappingSetFlavorId = valRow.MappingSetFlavorId || \"\";\n    mappingRule.ruleConditions = [];\n    mappingRule.ruleOutcomes = [];\n\n    for (var s = 0; s < sourceItems.length; s++) {\n\n      var src = sourceItems[s];\n      var idx = s + 1;\n\n      var inputKey = \"InputValueConstant\" + idx;\n      var inputVal = valRow[inputKey];\n\n      if (inputVal === null || inputVal === undefined || inputVal === \"\") {\n        continue;\n      }\n\n      var cond = new Object();\n      cond.conditionType = \"Mapset\";\n      cond.attribute = \"\";\n      cond.attributeKey = src.SourceCode || \"\";\n      cond.operator = \"Equals to\";\n      cond.operatorKey = \"=\";\n      cond.attributeValue = inputVal;\n      cond.valueKey = inputVal;\n\n      if (src.ValueSetCode && depParentMap[src.SourceCode]) {\n        cond.valueSource = \"DEPVALUESET\";\n        cond.valueSourceKey = src.ValueSetId;\n      } else if (src.ValueSetCode) {\n        cond.valueSource = \"VALUESET\";\n        cond.valueSourceKey = src.ValueSetId;\n      } else if (src.LookupType) {\n        cond.valueSource = \"LOOKUP\";\n        cond.valueSourceKey = src.LookupCode;\n      } else if (src.SourceCode == 'ORA_BU_ID') {\n        cond.valueSource = \"REST\";\n        cond.valueSourceKey = \"getBuDetails\";\n      } else if (src.SourceCode == 'ORA_PRIMARY_LEDGER_ID') {\n        cond.valueSource = \"LEDGER\";\n        cond.valueSourceKey = \"getLedgerDetails\";\n      } else if (src.SourceCode == 'ORA_PAYMENT_REASON_CODE') {\n        cond.valueSource = \"PAYREASON\";\n        cond.valueSourceKey = \"getPayReasonDetails\";\n      } else if (src.SourceCode == 'ORA_DELIVERY_CHANNEL_CODE') {\n        cond.valueSource = \"DC\";\n        cond.valueSourceKey = \"getDCDetails\";\n      } else if (src.SourceCode == 'ORA_LEGAL_ENTITY_ID') {\n        cond.valueSource = \"LE\";\n        cond.valueSourceKey = \"getLEDetails\";\n      } else {\n        cond.valueSource = \"CONSTANT\";\n        cond.valueSourceKey = null;\n      }\n\n      if (cond.valueSource !== \"CONSTANT\") {\n        var callKey = cond.valueSource + \"|\" + cond.valueSourceKey + \"|\" + cond.valueKey + \"|\" + src.SourceCode;\n\n        var srcDepValueKey = \"\";\n        var srcParentCode = depParentMap[src.SourceCode];\n        if (srcParentCode) {\n          for (var dp = 0; dp < sourceItems.length; dp++) {\n            if (sourceItems[dp].SourceCode === srcParentCode) {\n              var depInputKey = \"InputValueConstant\" + (dp + 1);\n              srcDepValueKey = valRow[depInputKey] || \"\";\n              break;\n            }\n          }\n        }\n\n        if (!apiCallsSet[callKey]) {\n          apiCallsSet[callKey] = true;\n          apiCallsNeeded.push({\n            ruleIndex: v,\n            conditionIndex: mappingRule.ruleConditions.length,\n            valueSource: cond.valueSource,\n            valueSourceKey: cond.valueSourceKey,\n            valueKey: cond.valueKey,\n            depValueKey: srcDepValueKey,\n            value: \"\",\n            attributeKey: src.SourceCode || \"\"\n          });\n        }\n      }\n\n      mappingRule.ruleConditions.push(cond);\n    }\n\n    // Loop through flavors and add API call if StripeId is not 0\n    for (var f = 0; f < flavorItems.length; f++) {\n      var flavor = flavorItems[f];\n\n      if (flavor.StripeId && parseInt(flavor.StripeId, 10) !== 0) {\n        var flavorValueKey = valRow.ValueConstant || \"\";\n\n        // If target is in depParentMap, use DEPVALUESET else VALUESET\n        var targetValueSource = depParentMap[targetAttribute] ? \"DEPVALUESET\" : \"VALUESET\";\n\n        var flavorCallKey = targetValueSource + \"|\" + flavor.StripeId + \"|\" + flavorValueKey + \"|\" + targetAttribute;\n\n        var targetDepValueKey = \"\";\n        var targetParentCode = depParentMap[targetAttribute];\n        if (targetParentCode) {\n          for (var tp = 0; tp < sourceItems.length; tp++) {\n            if (sourceItems[tp].SourceCode === targetParentCode) {\n              var targetDepInputKey = \"InputValueConstant\" + (tp + 1);\n              targetDepValueKey = valRow[targetDepInputKey] || \"\";\n              break;\n            }\n          }\n        } else {\n          var lastInputKey = \"InputValueConstant\" + sourceItems.length;\n          targetDepValueKey = valRow[lastInputKey] || \"\";\n        }\n\n        if (!apiCallsSet[flavorCallKey]) {\n          apiCallsSet[flavorCallKey] = true;\n          apiCallsNeeded.push({\n            ruleIndex: v,\n            conditionIndex: mappingRule.ruleConditions.length,\n            valueSource: targetValueSource,\n            valueSourceKey: flavor.StripeId,\n            valueKey: flavorValueKey,\n            depValueKey: targetDepValueKey,\n            value: \"\",\n            attributeKey: targetAttribute || \"\"\n          });\n        }\n      }\n    }\n\n    var outAttr = new Object();\n    outAttr.outcome1 = \"Target Attribute\";\n    outAttr.value1 = \"\";\n    mappingRule.ruleOutcomes.push(outAttr);\n\n    var outVal = new Object();\n    outVal.outcome2 = \"Value\";\n    outVal.valueKey = valRow.ValueConstant || \"\";\n    // outVal.value2 = valRow.ValueConstant || \"\";\n    mappingRule.ruleOutcomes.push(outVal);\n\n    finalPayload.push(mappingRule);\n  }\n}\n\n$context.$variables.pMappingSetRulesPayload = finalPayload;\n$context.$variables.pApiCallsNeeded = apiCallsNeeded;\n\nvar result = {\n  payload: finalPayload,\n  apiCalls: apiCallsNeeded\n};\nreturn result;"
                  },
                  "outcomes": {
                    "success": "end_1765794359543"
                  },
                  "code": "MAPPINGSET_RULES",
                  "convergenceTargetId": "1773166726357",
                  "id": "1765812581271",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                }
              ],
              "rootNode": "start_1765794359543"
            },
            "loopType": "PARALLEL",
            "name": "Get Mappings"
          },
          "outcomes": {
            "success": "1770959041060"
          },
          "code": "GET_MAPPINGS",
          "id": "1765794359543",
          "inputs": [
            {
              "id": "1765794359545_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_MAPPING_SETS.$output.result.mappingSetRequest.mappingSets}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "Transform Rules Payload",
            "returnType": "object",
            "sourceCode": "// Inputs\nvar rawRules = $context?.$nodes?.GET_ALL_RULES?.$output?.items ??\n  $context?.$nodes?.GET_RULES_BY_CATEGORY?.$output?.items ??\n  $context?.$nodes?.GET_RULES_BY_TARGET_ATTRIBUTE?.$output?.items ??\n  [];\nvar sourceAttributes = $context.$nodes.GET_ALL_SOURCE_ATTRIBUTES.$output.items || [];\nvar targetAttributes = $context.$nodes.GET_TARGET_ATTRIBUTES.$output || [];\nvar mappingRows = $context.$nodes.MERGE_MAPPINGS_OUTPUT.$output || [];\nvar mappingSetRaw = mappingRows.result;\n\n// Parse the mapping values from previous node\nvar mappingValuesRaw = $context.$nodes.MAPPING_VALUES_TRANSFORM.$output || []; \nvar mappingValuesLookup = {};\n\n// Build lookup map from mapping values\nvar mv = 0;\nwhile (mappingValuesRaw[mv] !== undefined) {\n  var mvItem = mappingValuesRaw[mv];\n  \n  if (typeof mvItem === \"string\") {\n    try { mvItem = JSON.parse(mvItem); } catch (e) { mvItem = null; }\n  }\n  \n  if (mvItem && mvItem.result) {\n    var key = mvItem.result.attributeKey + \"|\" + mvItem.result.valueKey;\n    mappingValuesLookup[key] = mvItem.result.value;\n  }\n  \n  mv++;\n}\n\n// Flatten pMappingSetRulesPayload from GET_MAPPINGS\nvar mappingSetRows = [];\n\nif (mappingSetRaw && mappingSetRaw[0] !== undefined) {\n  var i = 0;\n  while (mappingSetRaw[i] !== undefined) {\n    var e = mappingSetRaw[i];\n\n    if (typeof e === \"string\") {\n      try { e = JSON.parse(e); } catch (er) { e = null; }\n    }\n\n    if (e && e.result && e.result[0] !== undefined) {\n      var j = 0;\n      while (e.result[j] !== undefined) {\n        mappingSetRows.push(e.result[j]);\n        j++;\n      }\n    }\n\n    i++;\n  }\n} else if (mappingSetRaw && mappingSetRaw.payload) {\n  var k = 0;\n  while (mappingSetRaw.payload[k] !== undefined) {\n    mappingSetRows.push(mappingSetRaw.payload[k]);\n    k++;\n  }\n}\n\n// Lookups from source attributes\nvar srcByCode = {};\nvar srcCodeByNameLC = {};\nvar k = 0;\nfor (k = 0; k < sourceAttributes.length; k++) {\n  var s = sourceAttributes[k];\n  if (s && s.AttributeCode) srcByCode[s.AttributeCode] = s;\n  if (s && s.AttributeName) srcCodeByNameLC[s.AttributeName.toLowerCase()] = s.AttributeCode;\n}\n\n// Group raw rules by category\nvar categoryMap = {\n  \"ORA_DFF\": \"Descriptive Flexfield\",\n  \"ORA_TAX\": \"Tax\",\n  \"ORA_ACCOUNT\": \"Accounting\",\n  \"ORA_ENTERPRISE\": \"Enterprise\",\n  \"ORA_TRANSACTION\": \"Transaction\",\n  \"ORA_ASSET\": \"Asset\",\n  \"ORA_PROJECT\": \"Project\",\n  \"ORA_GLOBAL_DFF\": \"Global descriptive flexfield\"\n};\nvar categoryGroups = {};\nfor (k = 0; k < rawRules.length; k++) {\n  var rule = rawRules[k];\n  var cat = (rule && rule.AttributeCategory) ? rule.AttributeCategory : \"Unknown\";\n  if (!categoryGroups[cat]) categoryGroups[cat] = [];\n  categoryGroups[cat].push(rule);\n}\n\nvar finalPayload = [];\nvar ruleIdCounter = 1;\n\n// Transform\nfor (var catKey in categoryGroups) {\n  var rulesInCat = categoryGroups[catKey];\n  var catObj = { category: \"Defaulting\", subCategory: (categoryMap[catKey] ? categoryMap[catKey] : \"Other\"), rules: [] };\n\n  var r = 0;\n  for (r = 0; r < rulesInCat.length; r++) {\n    var rr = rulesInCat[r];\n\n    var rs = (rr && rr.StatusCode === \"A\") ? \"Active\" : \"Inactive\";\n\n    // Parse single Condition text to baseConditions\n    var baseConditions = [];\n    if (rr && rr.Condition) {\n      var condText = rr.Condition;\n      var attrName = \"\";\n      var operatorText = \"\";\n      var operatorKey = \"\";\n      var attrValue = \"\";\n      var valueKey = \"\";\n      var q1 = condText.indexOf('\"');\n      if (q1 !== -1) {\n        var q2 = condText.indexOf('\"', q1 + 1);\n        if (q2 !== -1) {\n          attrName = condText.substring(q1 + 1, q2);\n          var rest = condText.substring(q2 + 1).trim();\n          var restLC = rest.toLowerCase();\n\n          if (restLC.indexOf(\"greater than or equal to\") === 0) { operatorText = \"Greater Than Or Equal To\"; operatorKey = \">=\"; attrValue = rest.substring(\"greater than or equal to\".length).trim(); }\n          else if (restLC.indexOf(\"less than or equal to\") === 0) { operatorText = \"Less Than Or Equal To\"; operatorKey = \"<=\"; attrValue = rest.substring(\"less than or equal to\".length).trim(); }\n          else if (restLC.indexOf(\"is not null\") === 0) { operatorText = \"Has value\"; operatorKey = \"is not null\"; attrValue = \"\"; }\n          else if (restLC.indexOf(\"is null\") === 0) { operatorText = \"Has no value\"; operatorKey = \"is null\"; attrValue = \"\"; }\n          else if (restLC.indexOf(\"greater than\") === 0) { operatorText = \"Greater Than\"; operatorKey = \">\"; attrValue = rest.substring(\"greater than\".length).trim(); }\n          else if (restLC.indexOf(\"less than\") === 0) { operatorText = \"Less Than\"; operatorKey = \"<\"; attrValue = rest.substring(\"less than\".length).trim(); }\n          else if (restLC.indexOf(\"not equals\") === 0 || restLC.indexOf(\"not equal to\") === 0) {\n            operatorText = \"Not Equals\"; operatorKey = \"!=\";\n            if (restLC.indexOf(\"not equals\") === 0) attrValue = rest.substring(\"not equals\".length).trim();\n            else attrValue = rest.substring(\"not equal to\".length).trim();\n          } else if (restLC.indexOf(\"equals\") === 0 || restLC.indexOf(\"equal to\") === 0) {\n            operatorText = \"Equals\"; operatorKey = \"=\";\n            if (restLC.indexOf(\"equals\") === 0) attrValue = rest.substring(\"equals\".length).trim();\n            else attrValue = rest.substring(\"equal to\".length).trim();\n          } else { operatorText = rest; operatorKey = \"\"; attrValue = \"\"; }\n\n          if (attrValue && attrValue.charAt(0) === '\"') {\n            var vq2 = attrValue.indexOf('\"', 1);\n            if (vq2 > 0) attrValue = attrValue.substring(1, vq2);\n            else attrValue = attrValue.replace(/^\"+|\"+$/g, \"\");\n          }\n          if (attrValue && (attrValue.endsWith(\",\") || attrValue.endsWith(\".\"))) attrValue = attrValue.substring(0, attrValue.length - 1);\n          if (attrValue) {\n            var num = parseFloat(attrValue);\n            if (!isNaN(num) && String(num) === attrValue.replace(/^\\+/, \"\")) attrValue = num;\n          }\n\n          var attributeKey1 = srcCodeByNameLC[attrName.toLowerCase()] || \"\";\n          baseConditions.push({\n            conditionType: \"Condition\",\n            attribute: attrName,\n            attributeKey: attributeKey1,\n            operator: operatorText,\n            operatorKey: operatorKey,\n            attributeValue: attrValue,\n            valueKey: valueKey\n          });\n        }\n      }\n    }\n\n    // MAPPING SET\n    if (rr && rr.RuleType === \"ORA_MAPPING_SET\" && rr.MappingSetCode) {\n      var code = \"\" + rr.MappingSetCode;\n      var m = 0;\n      while (mappingSetRows[m] !== undefined) {\n        var ms = mappingSetRows[m];\n        if (ms && (\"\" + ms.MappingSetCode) === code) {\n          var conditions = [];\n          var outcomes = [];\n\n          // baseConditions first\n          var bc = 0;\n          while (baseConditions && baseConditions[bc] !== undefined) {\n            conditions.push(baseConditions[bc]);\n            bc++;\n          }\n\n          // mapset conditions - update attributeValue using lookup\n          var rc = 0;\n          while (ms.ruleConditions && ms.ruleConditions[rc] !== undefined) {\n            var cond2 = ms.ruleConditions[rc];\n            \n            if (cond2 && !cond2.attribute && cond2.attributeKey) {\n              var sa = srcByCode[cond2.attributeKey];\n              if (sa && sa.AttributeName) cond2.attribute = sa.AttributeName;\n            }\n\n            if (cond2 && cond2.attributeKey && cond2.valueKey) {\n              var lookupKey = cond2.attributeKey + \"|\" + cond2.valueKey;\n              var mappedValue = mappingValuesLookup[lookupKey];\n              \n              if (mappedValue !== null && mappedValue !== undefined) {\n                cond2.attributeValue = mappedValue;\n              } else {\n                cond2.attributeValue = cond2.valueKey;\n              }\n            }\n\n            conditions.push(cond2);\n            rc++;\n          }\n\n          // mapset outcomes - track value1Key across iterations to fix value2 lookup\n          var ro = 0;\n          var lastValue1Key = \"\";\n\n          while (ms.ruleOutcomes && ms.ruleOutcomes[ro] !== undefined) {\n            var o = ms.ruleOutcomes[ro];\n\n            // Handle Target Attribute\n            if (o && o.outcome1 === \"Target Attribute\") {\n              if (!o.value1 || o.value1 === \"\") {\n                var TargetName = (srcByCode[rr.TargetAttribute] && srcByCode[rr.TargetAttribute].AttributeName)\n                  ? srcByCode[rr.TargetAttribute].AttributeName : \"\";\n                o.value1 = TargetName;\n                o.value1Key = rr.TargetAttribute || \"\";\n              }\n              lastValue1Key = o.value1Key; // capture for use in outcome2\n            }\n\n            // Handle Value outcome\n            if (o && o.outcome2 === \"Value\") {\n              if (lastValue1Key && o.valueKey) {\n                var lookupKey2 = lastValue1Key + \"|\" + o.valueKey;\n                var mappedValue2 = mappingValuesLookup[lookupKey2];\n\n                if (mappedValue2 !== null && mappedValue2 !== undefined) {\n                  o.value2 = mappedValue2;\n                } else {\n                  o.value2 = o.valueKey;\n                }\n              } else if (o.valueKey) {\n                o.value2 = o.valueKey;\n              }\n\n              if (!o.valueKey && ms.MappingSetValueId) {\n                o.valueKey = o.value2;\n              }\n            }\n\n            outcomes.push(o);\n            ro++;\n          }\n\n          var rulePkConcat =\n            (rr.AttributeRuleId || \"\") + \",\" +\n            (ms.MappingSetId || \"\") + \",\" +\n            (ms.MappingSetFlavorId || \"\") + \",\" +\n            (ms.MappingSetValueId || \"\");\n\n          catObj.rules.push({\n            uiId: \"X_\" + (\"00\" + ruleIdCounter).slice(-3),\n            rulePK: rulePkConcat,\n            businessApplicability: rr.Applicability || \"\",\n            agentRuleText: \"<Concatenated rule details having applicability, conditions and values>\",\n            ruleConditions: conditions,\n            ruleOutcomes: outcomes,\n            agentRuleProcessStatus: \"Success\",\n            errorInfo: \"\",\n            ruleOperation: \"READ\",\n            ruleStatus: ((rr && rr.StatusCode === \"A\") ? \"Active\" : \"Inactive\")\n          });\n          ruleIdCounter++;\n        }\n        m++;\n      }\n    }\n\n    // COPY\n    if (rr && rr.RuleType === \"ORA_COPY\") {\n      var conditionsCopy = [];\n      var outcomesCopy = [];\n      var bc2 = 0;\n      for (bc2 = 0; bc2 < baseConditions.length; bc2++) conditionsCopy.push(baseConditions[bc2]);\n\n      var TargetName = (srcByCode[rr.TargetAttribute] && srcByCode[rr.TargetAttribute].AttributeName) ? srcByCode[rr.TargetAttribute].AttributeName : \"\";\n      var AttrName = (srcByCode[rr.SourceAttributeCode] && srcByCode[rr.SourceAttributeCode].AttributeName) ? srcByCode[rr.SourceAttributeCode].AttributeName : \"\";\n      outcomesCopy.push({ outcome1: \"Target Attribute\", value1: TargetName, valueKey: rr.TargetAttribute || \"\" });\n      outcomesCopy.push({ outcome2: \"Value\", value2: AttrName || \"\", valueKey: rr.SourceAttributeCode || \"\" });\n      var finalRuleCopy = {\n        uiId: \"X_\" + (\"00\" + ruleIdCounter).slice(-3),\n        rulePK: (rr.AttributeRuleId || \"\"),\n        businessApplicability: rr.Applicability || \"\",\n        agentRuleText: \"<Concatenated rule details having applicability, conditions and values>\",\n        ruleConditions: conditionsCopy,\n        ruleOutcomes: outcomesCopy,\n        agentRuleProcessStatus: \"Success\",\n        errorInfo: \"\",\n        ruleOperation: \"READ\",\n        ruleStatus: rs\n      };\n      catObj.rules.push(finalRuleCopy);\n      ruleIdCounter++;\n    }\n\n    // CONSTANT\n    if (rr && rr.RuleType === \"ORA_CONSTANT\") {\n      var conditionsConst = [];\n      var outcomesConst = [];\n      var bc3 = 0;\n      for (bc3 = 0; bc3 < baseConditions.length; bc3++) conditionsConst.push(baseConditions[bc3]);\n      conditionsConst.push({\n        conditionType: \"constant\",\n        attribute1: rr.TargetAttribute || \"\",\n        attributeKey1: rr.TargetAttributeCode || \"\",\n        operator1: \"Equals to\",\n        operatorKey1: \"=\",\n        attributeValue1: rr.TargetValue || \"\",\n        valueKey1: rr.TargetValueId || \"\"\n      });\n      outcomesConst.push({ outcome1: \"Target Attribute\", value1: rr.TargetAttribute || \"\", valueKey: rr.TargetAttributeCode || \"\" });\n      outcomesConst.push({ outcome2: \"Value\", value1: rr.TargetValue || \"\", valueKey: rr.TargetValueId || \"\" });\n      var finalRuleConst = {\n        uiId: \"X_\" + (\"00\" + ruleIdCounter).slice(-3),\n        rulePK: (rr.AttributeRuleId || \"\"),\n        businessApplicability: rr.Applicability || \"\",\n        agentRuleText: \"<Concatenated rule details having applicability, conditions and values>\",\n        ruleConditions: conditionsConst,\n        ruleOutcomes: outcomesConst,\n        agentRuleProcessStatus: \"Success\",\n        errorInfo: \"\",\n        ruleOperation: \"READ\",\n        ruleStatus: rs\n      };\n      catObj.rules.push(finalRuleConst);\n      ruleIdCounter++;\n    }\n  }\n\n  finalPayload.push(catObj);\n}\n\n// Return\nvar resultPayload = {\n  agentOperation: $context.$variables.pAgentOperation,\n  Ruleset: finalPayload\n};\n\nreturn JSON.stringify(resultPayload);"
