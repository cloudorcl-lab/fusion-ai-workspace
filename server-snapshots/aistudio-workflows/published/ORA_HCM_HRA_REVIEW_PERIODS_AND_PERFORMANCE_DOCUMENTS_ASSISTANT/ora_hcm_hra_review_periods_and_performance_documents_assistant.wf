            {
              "id": "1771038796873_1",
              "name": "prompt",
              "type": "string",
              "value": "Input Data Source - {{$context.$nodes.PARSE_DOCUMENT_DATA.$output}}\n\nBased on the input data source use a multiRecordWidget with 3 cols \n\nfirst column: \"Performance Document\" use DocumentName\nsecond column: \"Review Period\" use ReviewPeriodName\nthird column: no label, if the value on ViewBadge is true, use a badge with label 'Viewing' and set priority as \"success\", if the value on ViewBadge is false, don't display the badge \n\ndrillDownAction: ora.Invoke(\"NavigateToApp\", TemplatePeriodID numeric value and not JSON)\nNote - TemplatePeriodID here is the numeric value that matches the clicked link context from the provided Input Data Source. \n\nShow no Title and Summary"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_PERFORMANC_TEAMCALIBRATIONS",
            "functionName": "getReviewPeriodsAndPerformanceDocuments",
            "name": "Performance Documents"
          },
          "outcomes": {
            "success": "1773787724543"
          },
          "code": "PERFORMANCE_DOCUMENTS",
          "id": "1771138869760",
          "inputs": [
            {
              "id": "1771138878567_1",
              "name": "pManagerId",
              "type": "string",
              "value": "{{$context.$app.$OraUserContext.userId}}"
            },
            {
              "id": "1771138878568_2",
              "name": "pLimit",
              "type": "string",
              "value": "3"
            }
