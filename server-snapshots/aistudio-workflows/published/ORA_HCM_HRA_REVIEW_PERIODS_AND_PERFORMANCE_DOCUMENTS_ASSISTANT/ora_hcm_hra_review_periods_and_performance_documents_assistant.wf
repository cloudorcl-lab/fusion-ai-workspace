        },
        {
          "metadata": {
            "name": "No PD"
          },
          "outcomes": {},
          "code": "NO_PD",
          "convergenceTargetId": "1771038734726",
          "id": "1773787743620",
          "inputs": [
            {
              "id": "1773787743621_1",
              "name": "returnValue",
              "type": "string",
              "value": "We couldn't find any performance documents with in-progress evaluations for you to calibrate"
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "name": "Parse Document Data",
            "returnType": "object",
            "sourceCode": "var inputData = $context && $context.$nodes && $context.$nodes.PERFORMANCE_DOCUMENTS\n  ? $context.$nodes.PERFORMANCE_DOCUMENTS.$output\n  : null;\n\nvar appContext = $context && $context.$app ? $context.$app.$OraAppContext : null;\n\nvar output = []; // single return at end\n\nvar hasValidItems = false;\nif (inputData && Array.isArray(inputData.items)) {\n  hasValidItems = true;\n}\n\nvar isContextEmpty = (appContext === null || appContext === undefined || appContext === \"\");\n\nif (hasValidItems) {\n  for (var i = 0; i < inputData.items.length; i++) {\n    var item = inputData.items[i];\n\n    var viewBadge = false;\n    if (isContextEmpty) {\n      viewBadge = (i === 0);\n    } else {\n      viewBadge = (item && item.TemplatePeriodId == appContext);\n    }\n\n    output.push({\n      TemplatePeriodId: item ? item.TemplatePeriodId : null,\n      DocumentName: item ? item.DocumentName : null,\n      ReviewPeriodName: item ? item.ReviewPeriodName : null,\n      ViewBadge: viewBadge\n    });\n  }\n}\n\nreturn output;"
          },
          "outcomes": {
            "success": "1771038796872"
          },
          "code": "PARSE_DOCUMENT_DATA",
          "id": "1774915083558",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
