          "id": "1773382131192",
          "inputs": [
            {
              "id": "1773382131193_1",
              "name": "prompt",
              "type": "string",
              "value": "## CHAT HISTORY\n<chatHistory>{{$context.$system.$chatHistory}}</chatHistory>\n\n## ATTACHMENTS\n<attachments>{{$context.$app.$OraAttachments}}</attachments>\n\n## DATA\n{{$context.$nodes.PERFORMANCE_DOCUMENTS.$output}}\n\n## INSTRUCTIONS\n- Answer the Question to the best of your knowledge based on data available to you.\n- Refer the attachments if the user is asking question about the attachments.\n\n## QUESTION\n{{$context.$system.$inputMessage}}"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Do PD Exists"
          },
          "outcomes": {
            "true": "1771038734726",
            "false": "1773787743620"
          },
          "code": "DO_PD_EXISTS",
          "convergenceTargetId": "1771038734726",
          "id": "1773787724543",
          "inputs": [
            {
              "id": "1773787724545_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.PERFORMANCE_DOCUMENTS.$output.items.length > 0}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "description": "Add node for true branch",
            "name": "Add (True Branch)"
          },
          "outcomes": {
            "success": "1771038734726"
          },
          "id": "add_true_1773787724543",
          "inputs": [],
