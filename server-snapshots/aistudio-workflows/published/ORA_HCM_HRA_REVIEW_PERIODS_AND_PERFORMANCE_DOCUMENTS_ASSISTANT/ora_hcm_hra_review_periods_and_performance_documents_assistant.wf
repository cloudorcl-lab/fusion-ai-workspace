          "id": "1772174530566",
          "inputs": [
            {
              "id": "1772174530567_1",
              "name": "prompt",
              "type": "string",
              "value": "Input Data Source - {{$context.$nodes.PERFORMANCE_DOCUMENTS.$output}}\n\nReturn the DocumentName in the dataset where TemplatePeriodId matches the value in {{$context.$app.$OraAppContext}}, \nIf no TemplatePeriodId provided then show the DocumentName of the first record.\n\nNote - Do not show the key 'DocumentName'"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Handle Query"
          },
          "outcomes": {
