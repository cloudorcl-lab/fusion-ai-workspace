        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.75
              },
              "code": "ORA_LLM_MODEL_PROVIDER_CERT_BASIC_LLAMA_3_3_70B",
              "model": "ORA_LLM_MODEL_GPT_OSS_120B",
              "provider": "CERT_BASIC"
            },
            "name": "AssessmentAdvisor"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "ASSESSMENTAdvisor",
          "id": "1770392388098",
          "inputs": [
            {
              "id": "1770392388099_1",
              "name": "prompt",
              "type": "string",
              "value": "{\n  \"instructions\": {\n    \"task\": \"Grade a multiple-choice test and assess overall proficiency. Output the questions_result array first, then the summary fields, with feedback addressed to the test taker using 'you' or 'your'.\",\n    \"procedure\": [\n      \"1. For each question in user_questionnaire.questions, in order:\",\n      \"   a. Using your expertise, select the single best answer from answer_choices as correct_answer.\",\n      \"   b. Compare user_answers[0] to correct_answer:\",\n      \"      - If they match, set is_correct to 'yes'.\",\n      \"      - If not, set is_correct to 'no'.\",\n      \"   c. Add an object to questions_result with: question, user_answer, correct_answer, is_correct.\",\n      \"2. After grading all questions:\",\n      \"   - Set total_questions to the number of items in questions_result.\",\n      \"   - Set total_correct_answers to the number of items in questions_result with is_correct set to 'yes'.\",\n      \"3. Assign rating_level and rating_description as follows:\",\n      \"   - If total_correct_answers equals total_questions, assign the highest NumericRating and RatingDescription from rating_model.\",\n      \"   - If total_correct_answers is 0 or 1, assign the lowest band.\",\n      \"   - If total_correct_answers is one less than total_questions, assign the highest or next-highest band according to the rating_model.\",\n      \"   - Otherwise, choose the closest matching band in rating_model, never assigning the highest band unless all answers are correct.\",\n      \"4. Compose a concise (maximum two sentences) explanation, addressed directly to the test taker using 'you' or 'your', summarizing your overall strengths and areas for improvement.\",\n      \"5. OUTPUT JSON: Return ONLY a valid JSON object containing:\",\n      \"   - questions_result (an array in original order),\",\n      \"   - total_questions (integer),\",\n      \"   - total_correct_answers (integer),\",\n      \"   - rating_level (from rating_model),\",\n      \"   - rating_description (from rating_model),\",\n      \"   - explanation (concise; maximum two sentences; addressed to the test taker as 'you' or 'your'; must not list individual questions; no markdown, code blocks, or extra text).\"\n    ],\n    \"output_format\": {\n      \"root_object\": {\n        \"questions_result\": [\n          {\n            \"question\": \"string\",\n            \"user_answer\": \"string\",\n            \"correct_answer\": \"string\",\n            \"is_correct\": \"\\\"yes\\\" or \\\"no\\\"\"\n          }\n        ],\n        \"total_questions\": \"integer\",\n        \"total_correct_answers\": \"integer\",\n        \"rating_level\": \"integer\",\n        \"rating_description\": \"string\",\n        \"explanation\": \"string (concise; maximum two sentences; addressed to 'you' or 'your'; do not list individual questions; no markdown, code blocks, or extra text).\"\n      },\n      \"rules\": [\n        \"questions_result must appear first, followed by all summary fields in the specified order.\",\n        \"The summary counts must be calculated strictly from the questions_result array.\",\n        \"rating_level and rating_description must follow the banding rules described above.\",\n        \"The explanation must be concise (maximum two sentences) and addressed directly to the test taker using 'you' or 'your'.\",\n        \"Do not list individual questions in the explanation.\",\n        \"Return only valid RFC8259-compliant JSON. No markdown, code blocks, or extra text.\"\n      ]\n    }\n  },\n  \"input_parameters\": {\n    \"user_questionnaire\": {{$context.$triggers.REST.$input.userQuestionnaire}} ,\n    \"rating_model\": {{$context.$triggers.REST.$input.ratingModel}}\n  }\n}"
            }
          ],
          "outputSpecification": "{\n  \"type\": \"object\",\n  \"required\": [\"id\", \"choices\"],\n  \"properties\": {\n    \"id\": {\n      \"type\": \"string\",\n      \"format\": \"uuid\",\n      \"description\": \"Unique identifier for the response.\"\n    },\n    \"choices\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"maxItems\": 1,\n      \"description\": \"Always contains exactly one choice.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"index\", \"text\"],\n        \"properties\": {\n          \"index\": {\n            \"type\": \"integer\",\n            \"const\": 0,\n            \"description\": \"Always 0.\"\n          },\n          \"text\": {\n            \"type\": \"string\",\n            \"description\": \"Returned text content.\"\n          }\n        },\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"additionalProperties\": false\n}",
          "type": "LLM"
        }
      ],
