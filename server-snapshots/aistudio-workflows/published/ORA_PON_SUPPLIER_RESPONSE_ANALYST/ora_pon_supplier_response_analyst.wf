        {
          "metadata": {
            "name": "Calculate Total Amount",
            "returnType": "number",
            "sourceCode": "const lines = $context.$nodes.GET_NEGOTIATION_DETAILS.$output.lines.items;\n\nlet totalAmount = 0;\n\nfor (const line of lines) {\n   let quantity=line.Quantity;\n   let estimatedQuantity=line.EstimatedQuantity; \n   let currentPrice=line.CurrentPrice;\n\n   if(currentPrice != null){\n      let qty = 0;\n       if(quantity==null){\n           if(estimatedQuantity==null){\n                 qty = 1;\n           }else{\n                 qty = estimatedQuantity;\n           }\n           \n       }else{\n         qty = quantity;\n       }\n       totalAmount = totalAmount + (qty*currentPrice);\n   }\n}\n\nreturn totalAmount;"
          },
          "outcomes": {
            "success": "1767748854613"
          },
          "code": "CALCULATE_TOTAL_AMOUNT",
          "id": "1767748358984",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
