         \"CurrentPrice\",\n                    \"StartPrice\",\n                    \"TargetPrice\"\n\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"AuctionHeaderId\",\n    \"NegotiationTitle\",\n    \"NegotiationType\",\n    \"Negotiation\",\n    \"NegotiationStatusCode\",\n    \"OpenDate\",\n    \"CloseDate\",\n    \"SuppliersCount\",\n    \"SupplierResponses\",\n    \"AwardStatus\",\n    \"NumberOfLines\",\n    \"lines\"\n  ]\n}",
          "type": "BO_FUNCTION"
        },
