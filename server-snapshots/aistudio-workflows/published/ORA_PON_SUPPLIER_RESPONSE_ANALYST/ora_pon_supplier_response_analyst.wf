          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"Negotiation Responses\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"ResponseNumber\": {\n            \"type\": \"number\"\n          },\n          \"AuctionHeaderId\": {\n            \"type\": \"number\"\n          },\n          \"NegotiationTitle\": {\n            \"type\": \"string\"\n          },\n          \"Negotiation\": {\n            \"type\": \"string\"\n          },\n          \"CloseDate\": {\n            \"type\": \"string\"\n          },\n          \"ResponseStatus\": {\n            \"type\": \"string\"\n          },\n          \"OverallRank\": {\n            \"type\": \"string\"\n          },\n          \"ResponseAmount\": {\n            \"type\": \"string\"\n          },\n          \"SavingsInAmount\": {\n            \"type\": \"number\"\n          },\n          \"SavingsInPercent\": {\n            \"type\": \"string\"\n          },\n          \"AwardStatus\": {\n            \"type\": \"string\"\n          },\n          \"Buyer\": {\n            \"type\": \"string\"\n          },\n          \"ResponseValidUntilDate\": {\n            \"type\": \"string\"\n          },\n          \"Supplier\": {\n            \"type\": \"string\"\n          },\n          \"SupplierId\": {\n            \"type\": \"number\"\n          },\n          \"SupplierContact\": {\n            \"type\": \"string\"\n          },\n          \"SupplierContactDisplayName\": {\n            \"type\": \"string\"\n          },\n          \"SupplierContactId\": {\n            \"type\": \"number\"\n          },\n          \"SupplierSite\": {\n            \"type\": \"string\"\n          },\n          \"SupplierSiteId\": {\n            \"type\": \"number\"\n          },\n          \"CreationDate\": {\n            \"type\": \"string\"\n          },\n          \"ResponseStatusCode\": {\n            \"type\": \"string\"\n          },\n          \"LinesWinning\": {\n            \"type\": \"string\"\n          },\n          \"LinesTrailing\": {\n            \"type\": \"string\"\n          },\n          \"ResponseDate\": {\n            \"type\": \"string\"\n          },\n          \"lines\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"items\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"ResponseNumber\": {\n                      \"type\": \"number\"\n                    },\n                    \"AuctionHeaderId\": {\n                      \"type\": \"number\"\n                    },\n                    \"LineId\": {\n                      \"type\": \"number\"\n                    },\n                    \"Line\": {\n                      \"type\": \"string\"\n                    },\n                    \"LineDescription\": {\n                      \"type\": \"string\"\n                    },\n                    \"TargetPrice\": {\n\t\t      \"type\": \"number\"\n\t\t    },\n                    \"Rank\": {\n                      \"type\": \"string\"\n                    },\n                    \"ResponsePrice\": {\n                      \"type\": \"number\"\n                    },\n                    \"LineAmount\": {\n                      \"type\": \"number\"\n                    },\n                    \"ActiveResponses\": {\n                      \"type\": \"number\"\n                    }\n                  },\n                  \"required\": [\n                    \"ResponseNumber\",\n                    \"AuctionHeaderId\",\n                    \"LineId\",\n                    \"Line\",\n                    \"LineDescription\",\n                    \"TargetPrice\",\n                    \"Rank\",\n                    \"ResponsePrice\",\n                    \"LineAmount\",\n                    \"ActiveResponses\"\n                  ]\n                }\n              }\n            },\n            \"required\": [\n              \"items\"\n            ]\n          }\n        },\n        \"required\": [\n          \"ResponseNumber\",\n          \"AuctionHeaderId\",\n          \"NegotiationTitle\",\n          \"Negotiation\",\n          \"CloseDate\",\n          \"ResponseStatus\",\n          \"OverallRank\",\n          \"ResponseAmount\",\n          \"SavingsInAmount\",\n          \"SavingsInPercent\",\n          \"AwardStatus\",\n          \"Buyer\",\n          \"ResponseValidUntilDate\",\n          \"Supplier\",\n          \"SupplierId\",\n          \"SupplierContact\",\n          \"SupplierContactDisplayName\",\n          \"SupplierContactId\",\n          \"SupplierSite\",\n          \"SupplierSiteId\",\n          \"CreationDate\",\n          \"ResponseStatusCode\",\n          \"LinesWinning\",\n          \"LinesTrailing\",\n          \"ResponseDate\",\n          \"lines\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"items\"\n  ]\n}",
