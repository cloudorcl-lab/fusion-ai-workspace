          "metadata": {
            "errorNodeId": "1765961014063",
            "name": "Generate Summary",
            "returnType": "object",
            "sourceCode": "var raw = $context.$nodes.FIN_AP_LOOP_SUMMARY_ITEMS.$output;\n\nvar parsed = [];\nvar i = 0;\n\nwhile (i < raw.length) {\n  var item = raw[i];\n  var obj = null;\n\n  try {\n    obj = typeof item === \"string\" ? JSON.parse(item) : item;\n  } catch (e) {\n    i++;\n    continue;\n  }\n\n  if (obj && obj.result && Object.keys(obj.result).length > 0) {\n    parsed.push(obj);\n  }\n\n  i++;\n}\n\ni = 0;\nvar j = 0;\nvar temp;\n\nwhile (i < parsed.length) {\n  j = i + 1;\n  while (j < parsed.length) {\n    var s1 = parsed[i].result.sequence || parsed[i].result.display_sequence || 0;\n    var s2 = parsed[j].result.sequence || parsed[j].result.display_sequence || 0;\n\n    if (s1 > s2) {\n      temp = parsed[i];\n      parsed[i] = parsed[j];\n      parsed[j] = temp;\n    }\n    j++;\n  }\n  i++;\n}\n\nvar agentResponse = [];\ni = 0;\n\nwhile (i < parsed.length) {\n  var res = parsed[i].result;\n  var type = res.type ? res.type : res.display_type;\n\n  if (!type) {\n    i++;\n    continue;\n  }\n\n  if (type === \"text\") {\n    agentResponse.push({\n      display_type: \"text\",\n      display_sequence: res.sequence,\n      text: res.content\n    });\n  }\n\n  if (type === \"table\") {\n   var tableData = {\n      display_type: \"table\",\n      display_sequence: res.display_sequence,\n      heading: res.heading,\n      rows: res.rows,\n      columns: res.columns,\n      keyAttributes: res.keyAttributes,\n      accessibility: res.accessibility\n    }\n    if('contextData' in res){\n         tableData.contextData = res.contextData\n    }\n    agentResponse.push(tableData);\n  }\n\n  if (type === \"list\") {\n    var listItems = [];\n    var k = 0;\n\n    while (k < res.content.length) {\n      listItems.push({\n        id: String(k + 1),\n        Default: res.content[k],\n        value: res.content[k]\n      });\n      k++;\n    }\n\n    agentResponse.push({\n      display_type: \"list\",\n      display_sequence: res.sequence,\n      header: res.heading,\n      fields: { items: listItems },\n      selection_mode: \"none\",\n      keyAttributes: { items: [\"id\"] },\n      accessibility: { \"aria-label\": res.heading }\n    });\n  }\n\n  if (type === \"actions\") {\n    agentResponse.push({\n      display_type: \"action\",\n      display_sequence: res.sequence,\n      recommendations: {\n        items: res.content\n      }\n    });\n  }\n\n  i++;\n}\n\n\n\nvar output = {\n  agent:  $context.$triggers.REST.$input.agentName ,\n  schema_version: \"1\",\n  timestamp: $context.$system.$currentDateTime ,\n  agent_response: agentResponse\n};\n\nreturn output;"
