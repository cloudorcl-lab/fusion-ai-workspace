                  },
                  "outcomes": {
                    "success": "end_1765961201966"
                  },
                  "code": "FIN_AP_CODE_ACTION_GENERATOR",
                  "id": "1765961494452",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "errorNodeId": "1765961014063",
                    "name": "Analyze Columns",
                    "returnType": "object",
                    "sourceCode": "let content = $context.$nodes.FIN_AP_LOOP_SUMMARY_ITEMS.$currentItem\nlet disableAmountIdentification = content?.disableAmountIdentification ?? false\n\nlet jsonArray = content['content'] \nlet columnMetadata = []\nlet enableAmountFieldIdentification = !disableAmountIdentification // response formatter to identify amount fields in table\nlet amountRelations = {}\nlet columnNames = []\nlet columnKeys = [...new Set(jsonArray.flatMap(obj => Object.keys(obj)))]\nif(!content['columnOrder'] || \n    (typeof(content['columnOrder']) === \"object\" && content['columnOrder'].length === 0 )){\n    // input does not have column order\n    columnNames = columnKeys;\n}else{\n    // input has columnOrder\n    let columnOrder = content['columnOrder'];\n    let columnKeyMap = new Map(columnKeys.map(key => [key.toLowerCase(),key]));\n    //preserves the column order mentioned, but gets the column keys from jsonArray.\n    //the agent specified column order could have different casing from jsonArray keys\n    columnNames = columnOrder.map(col => columnKeyMap.get(col.toLowerCase())).filter(Boolean);\n    \n}\ncolumnKeys.forEach(key => {\n  if (!columnNames.some(name => name.toLowerCase() === key.toLowerCase())) {\n    columnNames.push(key);\n  }\n});\nconst moneyRegex = /^\\s*([+-]?\\d+(?:\\.\\d+)?)\\s+([A-Z]{3})\\s*$/;\n\nlet amountFields = []\nlet currencyFields = []\n\nif(enableAmountFieldIdentification){\n    amountFields = columnNames.filter(col => col.toLowerCase().includes(\"amount\"));\n    currencyFields = columnNames.filter(col => col.toLowerCase().includes(\"currency\"));\n\n    if(currencyFields.length>0){\n        for(const i in amountFields){\n            amountRelations[amountFields[i]] = currencyFields[i];\n        }\n    }else{\n    for(const i in amountFields){\n            amountRelations[amountFields[i]] = amountFields[i];\n        }\n    }\n}\n\nfor(const column of columnNames){\n    let meta = {}\n    let fieldName = column;\n    meta[\"field\"] = fieldName;\n    //--------------Header Derivation-----------------------\n    \n    // Extract trailing parenthesis and acronym/percentage\n    let headerMainPart = fieldName.trim();\n    let headerParenPart = \"\";\n    let headerTrailingPart = \"\";\n\n    // Match (anything) at the end (preserved as-is), plus trailing acronym/percent\n    let headerParenMatch = headerMainPart.match(/^(.*?)(\\([^\\)]*\\))(\\s+[A-Z%]+)?$/);\n    if (headerParenMatch) {\n        headerMainPart    = headerParenMatch[1];\n        headerParenPart   = headerParenMatch[2];\n        headerTrailingPart= headerParenMatch[3] || \"\";\n    } else {\n        let headerTrailingMatch = headerMainPart.match(/^(.*?)(\\s+[A-Z%]+)?$/);\n        if (headerTrailingMatch) {\n            headerMainPart     = headerTrailingMatch[1];\n            headerTrailingPart = headerTrailingMatch[2] || \"\";\n        }\n    }\n\n    // Custom word splitting to avoid touching punctuation\n    let headerMain = headerMainPart\n        .replace(/([a-z])([A-Z])/g, \"$1 $2\") // camelCase to space\n        .replace(/_/g, \" \")\n        .trim()\n        // Split into words, but include punctuation as part of word for testing, then handle separately\n        .split(/(\\s+)/)\n        .map(word => {\n            // If the word is all whitespace, return as is\n            if (/^\\s+$/.test(word)) return word;\n            // Separate leading/trailing punctuation (except inside parenthesis which is handled elsewhere)\n            let match = word.match(/^([^\\w]*)(\\w+)([^\\w]*)$/);\n            if (!match) return word; // Just in case, return as is\n            let [, lead, core, trail] = match;\n            // If the core is all uppercase and more than one letter, preserve original\n            if (core.length > 1 && /^[A-Z0-9]+$/.test(core)) return lead + core + trail;\n            // Otherwise, capitalize\n            return lead + core.charAt(0).toUpperCase() + core.slice(1).toLowerCase() + trail;\n        })\n        .join(\"\");\n\n    let headerResult = (headerMain + (headerParenPart ? headerParenPart : \"\") + (headerTrailingPart ? headerTrailingPart : \"\")).trim();\n     \n    meta['headerText'] = headerResult.replace(/ {2,}/g, \" \");\n\n    //----------------Header Derivation End\n    let columnData = jsonArray.map(obj => obj[column])\n    columnData = columnData.filter(dat => dat !== null && dat !== undefined && dat !== \"\");\n    const isAmountField = Object.prototype.hasOwnProperty.call(amountRelations,column);\n    columnMetadata.push(meta);\n\n    if(isAmountField){\n        meta['valueType'] = 'amount'\n        meta['currencyField'] = amountRelations[column]\n        continue;\n    }\n    if(columnData.length===0){\n        meta['valueType'] = \"string\";\n        continue;\n    } \n    let allNumbers = columnData.every(dat => \n        (typeof dat === \"number\" && Number.isFinite(dat)) || (typeof dat === \"string\" && dat.trim() !== \"\" && !isNaN(dat))\n    )\n    if(allNumbers){\n        meta['valueType'] = \"number\";\n        continue;\n    }\n    let linkBoolean = columnData.some(dat => typeof dat === \"string\" && (dat.startsWith(\"{deeplink\") || dat.startsWith(\"{relativeLink\")))\n    if(linkBoolean){\n        meta['valueType'] = \"link\";\n        continue;\n    }\n\n    let allMonetary = columnData.every(element => {\n        const str = String(element).trim().toUpperCase();\n        const matches = str.match(moneyRegex);\n        if(!matches) return false;\n        return true\n    }\n    )\n    if(allMonetary && enableAmountFieldIdentification){\n        meta['valueType'] = \"amount\";\n        meta['currencyField'] = column\n        continue;\n    }\n    \n    let dateBoolean = columnData.every(dat => {\n        let dateRegex = /^(\\d{4}-\\d{2}-\\d{2}|\\d{2}-\\d{2}-\\d{4})$/;\n        if (typeof dat !== \"string\") return false;\n        if(!dateRegex.test(dat)) return false;\n        let d = new Date(dat);\n        return !isNaN(d.getTime());\n    })\n    if(dateBoolean){\n        meta['valueType'] = \"date\";\n        continue;\n    }\n    meta['valueType'] = \"string\";\n}\n\nlet tableMetadata = {\n    heading: content['heading'] ? content['heading']: '',\n    primaryKey: columnNames[0],\n    columns: columnMetadata\n}\n\nreturn tableMetadata"
                  },
                  "outcomes": {
                    "success": "1769508373588"
                  },
                  "code": "FIN_AP_CODE_ANALYZE_COLUMNS",
