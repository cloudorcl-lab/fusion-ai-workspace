        {
          "metadata": {
            "errorNodeId": "1765961014063",
            "name": "Generate Text Only Components",
            "returnType": "object",
            "sourceCode": "let displayText = $context.$nodes.FIN_AP_LLM_TEXT_ONLY_FORMAT.$output.modifiedText\n\nif( $context.$triggers.REST.$input.summarizeData.trim().length === 0){\ndisplayText = \"The query cannot be processed right now, please try again later\"\n} \n\nlet textComponent = {\n      \"display_type\": \"text\",\n      \"display_sequence\": 1,\n      \"text\":  displayText\n}\n\n\nlet agentResponse = [textComponent]\n\nlet agentSummary = {}\n\nagentSummary['agent'] = $context.$triggers.REST.$input.agentName \n\n  agentSummary['schema_version']= \"1\"\n  agentSummary['timestamp']= $context.$system.$currentDateTime \n\nagentSummary['agent_response'] = agentResponse\n\n\n\nreturn agentSummary"
          },
