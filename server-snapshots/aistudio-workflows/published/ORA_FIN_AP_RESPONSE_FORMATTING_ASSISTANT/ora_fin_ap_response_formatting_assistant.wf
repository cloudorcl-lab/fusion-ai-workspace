                  "code": "FIN_AP_CODE_CALCULATE_FORMATHINT",
                  "id": "1769508373588",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "errorNodeId": "1765961014063",
                    "name": "Table Code Formatter",
                    "returnType": "array",
                    "sourceCode": "var input = $context.$nodes.FIN_AP_LOOP_SUMMARY_ITEMS.$currentItem ; \nlet formatHintExists = $context.$nodes.FIN_AP_LOOP_SUMMARY_ITEMS.FIN_AP_CODE_CALCULATE_FORMATHINT.$output.result \nlet meta = $context.$nodes.FIN_AP_LOOP_SUMMARY_ITEMS.FIN_AP_CODE_GENERATE_TABLE_FORMAT.$output.result; \n\nvar rawRows = input.content;\nvar columnsMeta = meta.columns;\nvar primaryKey = meta.primaryKey;\n\nvar formattedRows = [];\nvar i = 0;\nvar currencyField = \"\";\nlet sameField = false;   // currency and amount in same field\nlet sameCurrencyFields = new Set(   //Fields that have both amount and currency\n  columnsMeta\n  .filter(\n    (column) => \n      column.valueType === \"amount\" &&\n    ( !column.currencyField || column.currencyField === \"\" || column.currencyField === column.field)\n  )\n  .map((column) => column.field)\n);\nlet currencyFields = new Set(\n  columnsMeta\n  .filter(\n    (column) => \n      column.valueType === \"amount\" &&\n    column.currencyField &&\n    column.currencyField !== column.field\n  )\n  .map((column) => column.currencyField)\n);\nconst moneyRegex = /^\\s*([+-]?\\d+(?:\\.\\d+)?)\\s+([A-Z]{3})\\s*$/;\n\nwhile (i < rawRows.length) {\n  var row = rawRows[i];\n  var outRow = {};\n  var j = 0;\n\n  while (j < columnsMeta.length) {\n    var column = columnsMeta[j];\n    var field = column.field;\n    var value = row[field];\n    if(currencyFields.has(field)){\n        j++;\n        continue;\n    }\n\n    if (column.valueType === \"amount\") {\n      var currency = row[column.currencyField];\n      \n      if(sameCurrencyFields.has(field)){\n        //when currency and amount are present in same field\n        value = (typeof value === \"number\") ? String(value) : value;\n        const cleanedValue = String(value ?? \"\").replace(/,/g, \"\").trim();\n        const matches = cleanedValue.match(moneyRegex);\n        if(!matches){\n          let amount = cleanedValue\n            outRow[field] = amount\n            if(currencyFields.size==1){\n                let currencyFieldName = [...currencyFields][0]\n                let currencyFieldValue = row[currencyFieldName]\n                outRow[field] =\n            \"{amount:\" + Number(amount).toFixed(2) + \",currency:\" + currencyFieldValue + \"}\";\n            }\n        }else{\n            let amount = Number(matches[1]).toFixed(2)\n            currency = matches[2];\n            if(currency===undefined){\n              outRow[field] = amount;\n            }else{\n              outRow[field] =\n            \"{amount:\" + amount + \",currency:\" + currency + \"}\";\n            }\n            \n        }\n\n      }else{\n        if(currency===undefined){\n          outRow[field] =Number(value).toFixed(2);\n        }else{\n          outRow[field] =\n        \"{amount:\" + Number(value).toFixed(2) + \",currency:\" + currency + \"}\";\n        }\n        \n      }\n      \n    } else if (column.valueType === \"date\") {\n        let dateValue;\n        if(!value || !value.toString().trim()){\n            dateValue = \"\";\n        }else{\n            dateValue = \"{date:\" + value + \"}\" \n        }\n      outRow[field] = dateValue;\n    } else {\n      let stringValue = typeof value === \"object\" ? '' : value;\n      outRow[field] = String(stringValue);\n    }\n\n    j++;\n  }\n  \n  for(currencyField of currencyFields){\n    delete outRow[currencyField]\n  }\n\n  formattedRows.push(outRow);\n  i++;\n}\n\nvar columns = [];\nvar k = 0;\n\n\nwhile (k < columnsMeta.length) {\n  var colMeta = columnsMeta[k];\n  var template = \"\";\n  if(currencyFields.has(colMeta.field)){\n    k++;\n    continue;\n  }\n\n  if (colMeta.valueType === \"amount\") {\n    template = \"monetaryTemplate\";\n    currencyField = colMeta.currencyField;\n  } else if (colMeta.valueType === \"date\") {\n    template = \"dateTemplate\";\n  } else if (colMeta.valueType === \"link\") {\n    template = \"deepLinkTemplate\";\n  }\n\n  columns.push({\n    headerText: colMeta.headerText,\n    field: colMeta.field,\n    id: colMeta.field,\n    resizable: \"enabled\",\n    className: \"\",\n    template: template\n  });\n\n  k++;\n}\n\n\n\nvar output = {\n  display_type: \"table\",\n  display_sequence: input.sequence,\n  heading: meta.heading,\n  rows: {\n    items: formattedRows\n  },\n  columns: {\n    items: columns\n  },\n  keyAttributes: {\n    items: [primaryKey]\n  },\n  accessibility: {\n    \"aria-label\": meta.ariaLabel,\n    \"row.accessible-row-header\": primaryKey\n  }\n};\n\nif( 'contextData' in input){\n output['contextData'] = input.contextData\n}\n\n\n\nreturn output;"
                  },
