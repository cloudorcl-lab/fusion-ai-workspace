          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}"
        },
        {
          "id": "1778220267739",
          "code": "VALIDATE_RISK_SCORING_AGENT_OUTPUT",
          "type": "CODE",
          "metadata": {
            "description": "To validate if risk scoring agent output is clean",
            "name": "Validate Risk Scoring Agent Output",
            "sourceCode": "const riskNodeOutput = $context.$nodes.INVOKE_RISK_SCORING_AGENT_WORKFLOW?.$output || {};\n\nconst rawResult = riskNodeOutput.output;\n\nlet parsedResult = {};\n\nparsedResult = JSON.parse(rawResult);\n\nconst evaluatedCount = Number(\n  parsedResult?.result?.NumberOfContractsEvaluatedForRiskSeverity ?? -1\n);\n\nif (evaluatedCount === 0) {\n  const htmlMessage =\n    '<div style=\"font-family:Arial,Helvetica,sans-serif;line-height:1.5;color:#111;\">' +\n      '<p>Hi,</p>' +\n      '<p>The contract risk severity could not be evaluated for the contract.</p>' +\n      '<p>Please ensure the following conditions are met:</p>' +\n      '<ul>' +\n        '<li>The Contract Risk Scoring evaluation file is uploaded in Contract Risk Scoring Policy.</li>' +\n        '<li>The file is not blank.</li>' +\n        '<li>Rules are defined for the specific contract type.</li>' +\n        '<li>The contract falls under at least one of the defined criteria.</li>' +\n        '<li>The mandatory fields, Contract Amount, Clause Deviation Conditions, and Contract Risk Severity are not blank.</li>' +\n        '<li>Correct values are populated in the Contract Amount, Clause Deviation Conditions, and Contract Risk Severity fields.</li>' +\n        '<li>Severity values are defined as per the file.</li>' +\n      '</ul>' +\n    '</div>';\n\n  throw new Error(htmlMessage);\n}\n\nreturn riskNodeOutput;",
            "returnType": "array",
            "errorNodeId": "1778218163783"
          },
