                },
                {
                  "id": "1775612000002",
                  "code": "OUT_OF_POLICY_NO_RULE_MATCH",
                  "type": "CODE",
                  "metadata": {
                    "name": "Out of Policy No Rule Match",
                    "returnType": "object",
                    "description": "Builds an out-of-policy fallback deviation and recommendation when no policy rule is matched.",
                    "sourceCode": "const row = $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.$currentItem || {};\nconst active = $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.SELECT_ACTIVE_CHANGE_REQUEST.$output.result || {};\nconst gate = $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.BUILD_CLAUSE_CHANGE_REQUEST_GATE.$output.result || {};\nconst perspective = (($context.$nodes.EXTRACT_CONTRACT_METADATA_ATTRIBUTES_VALUES?.$output?.result?.Perspective) || '').toString().toUpperCase();\n\nconst toText = (v) => (v == null ? '' : v.toString().trim());\nconst toIntOrNull = (v) => {\n  if (v == null || v === '') return null;\n  const n = Number(v);\n  return Number.isFinite(n) ? Math.trunc(n) : null;\n};\n\nconst clauseTitle = toText(row.clause_name || row.clause_title || row.issue_clause_title || row.doc_clause_title || 'Unknown');\nconst issueNumber = toIntOrNull(row.id ?? row.issue_id ?? row.issue_number);\nconst clauseNumber = toText(row.clause_number);\n\nconst fallbackChangeRequest = [\n  active.active_change_request_text,\n  row.change_request,\n  row.change_request_text,\n  row.requested_change,\n  row.requested_change_text,\n  row.proposed_change,\n  row.proposed_clause,\n  row.counterparty_change_request,\n  row.supplier_message,\n  row.latest_supplier_message,\n  row.buyer_message,\n  row.latest_buyer_message,\n  row.reason\n].map(toText).find(Boolean) || '';\n\nconst exactCounterpartyRequest = perspective === 'BUYER'\n  ? toText(active.latest_supplier_change_request || row.latest_supplier_message || row.supplier_message)\n  : toText(active.latest_buyer_change_request || row.latest_buyer_message || row.buyer_message);\n\nconst verbatimRequest = exactCounterpartyRequest || fallbackChangeRequest;\nconst requestType = perspective === 'BUYER' ? 'SUPPLIER_REQUEST' : 'CUSTOMER_REQUEST';\n\nlet result;\n\nif (gate.is_supported_change_request === false) {\n  result = {\n    unsupported_change_request: true,\n    intent_type: toText(gate.intent_type || 'UNKNOWN') || 'UNKNOWN',\n    issue_id: issueNumber,\n    clause_name: clauseTitle || 'Unknown',\n    reason: 'Ignoring unsupported add/delete clause change request as per product decision.',\n    change_request_summary: verbatimRequest || ''\n  };\n} else {\n  result = {\n    policy_deviation: {\n      doc_clause_title: clauseTitle || 'Unknown',\n      issue_clause_title: clauseTitle || 'Unknown',\n      issue_number: issueNumber,\n      clause_number: clauseNumber,\n      rule_code: '-1',\n      rule_description: null,\n      matched_position_code: 'OUT_OF_POLICY',\n      issue: 'No matching policy rule was found for this clause and latest counterparty change request.',\n      severity_code: '4_CRITICAL',\n      standard_position_summary: 'No policy rule available for comparison.',\n      change_request_summary: verbatimRequest\n    },\n    policy_recommendations: [\n      {\n        recommendation_type: requestType,\n        severity_code: '4_CRITICAL',\n        approval: null,\n        clause_number: null,\n        recommendation_text: 'No rule found for this change request to generate the recommandation text',\n        position_text: verbatimRequest || ''\n      }\n    ]\n  };\n\n  console.log(JSON.stringify({\n    node: 'NO_MATCHED_RULE_FOUND',\n    event: 'fallback_response_generated',\n    issueNumber,\n    clauseNumber: clauseNumber || null,\n    perspective,\n    requestType,\n    hasVerbatimRequest: !!verbatimRequest\n  }));\n}\n\nreturn result;",
                    "errorNodeId": "1777879914368"
                  },
                  "diagram": {
                    "x": 5069,
                    "y": 14765
                  },
                  "outcomes": {
                    "success": "end_1775324556632"
                  },
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "id": "1776062696521",
                  "code": "GET_POLICY_RULE_BY_ID",
                  "type": "CODE",
                  "metadata": {
                    "name": "Get Policy Rule By Id",
                    "returnType": "object",
                    "description": "Resolves the full policy rule record from policy data using the selected rule identifier.",
                    "sourceCode": "const selectedRuleCode = (($context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.GET_SINGLE_MATCHED_RULE_ID.$output.result) || '').toString().trim();\n\nconst allRulesRaw = $context.$nodes.GET_DEVIATION_POLICY_RULES.$output?.result;\nconst allRules = Array.isArray(allRulesRaw)\n  ? allRulesRaw\n  : (allRulesRaw && Array.isArray(allRulesRaw.result)\n    ? allRulesRaw.result\n    : (allRulesRaw?.collection && Array.isArray(allRulesRaw.collection.result)\n      ? allRulesRaw.collection.result\n      : []));\n\nconst normalizeRuleId = (v) => {\n  const s = (v == null ? '' : v.toString().trim());\n  if (!s) return '';\n  const numeric = s.match(/^0*([0-9]+)$/);\n  if (numeric) return numeric[1];\n  return s.toUpperCase();\n};\n\nconst selectedNormalized = normalizeRuleId(selectedRuleCode);\n\nconst matched = allRules.find((r) => {\n  if (!r || typeof r !== 'object') return false;\n\n  const ruleCodeRaw = r.rule_code ?? r.ruleCode;\n  const ruleCode = ruleCodeRaw == null ? '' : ruleCodeRaw.toString().trim();\n  if (ruleCode && (ruleCode === selectedRuleCode || normalizeRuleId(ruleCode) === selectedNormalized)) {\n    return true;\n  }\n\n  const fallbackCandidates = [r.rule_id, r.ruleId, r.id]\n    .filter((v) => v != null && v !== '')\n    .map((v) => v.toString().trim());\n\n  if (fallbackCandidates.includes(selectedRuleCode)) return true;\n\n  const normalizedCandidates = fallbackCandidates.map(normalizeRuleId);\n  return !!selectedNormalized && normalizedCandidates.includes(selectedNormalized);\n});\n\nconsole.log(JSON.stringify({\n  node: 'GET_POLICY_RULE_BY_ID',\n  event: 'policy_rule_resolved',\n  issueNumber: $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.$currentItem?.id ?? null,\n  selectedRuleCode,\n  selectedNormalized,\n  totalRules: allRules.length,\n  found: !!matched,\n  resolvedRuleCode: matched?.rule_code ?? matched?.rule_id ?? matched?.id ?? null,\n  resolvedRuleDescription: matched?.rule_description ?? matched?.ruledescription ?? matched?.ruleDescription ?? null\n}));\n\nreturn matched || {};",
                    "errorNodeId": "1777879914368"
                  },
                  "diagram": {
                    "x": 5522,
                    "y": 14765
                  },
                  "outcomes": {
                    "success": "1775546372124"
