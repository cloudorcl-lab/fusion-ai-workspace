                  },
                  "inputs": [
                    {
                      "id": "1775612000001_condition",
                      "name": "condition",
                      "type": "string",
                      "value": "{{(($context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.GET_SINGLE_MATCHED_RULE_ID.$output.result || '').toString().trim().length > 0)}}"
