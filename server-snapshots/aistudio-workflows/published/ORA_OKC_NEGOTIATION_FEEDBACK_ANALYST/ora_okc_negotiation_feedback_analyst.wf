        },
        {
          "id": "1776505459730",
          "code": "AGGREGATE_FETCHED_CLAUSES",
          "type": "CODE",
          "metadata": {
            "description": "Aggregate the fetched clauses",
            "name": "Aggregate Fetched Clauses",
            "returnType": "array",
            "sourceType": "code",
            "sourceCode": "const fetchedItems = $context.$nodes.LOOP_OVER_CLAUSE_TITLES?.$output;\nconst result = [];\nconst seenTitles = new Set();\n\nconst toText = (v) => (v == null ? '' : v.toString().trim());\n\nfor (const itemStr of fetchedItems || []) {\n  if (!itemStr) continue;\n\n  let parsed;\n  try {\n    parsed = JSON.parse(itemStr);\n  } catch (e) {\n    continue;\n  }\n\n  const mapObj = parsed?.result && typeof parsed.result === 'object' ? parsed.result : null;\n  if (!mapObj) continue;\n\n  for (const [titleRaw, textRaw] of Object.entries(mapObj)) {\n    const clauseTitle = toText(titleRaw);\n    const clauseText = toText(textRaw);\n\n    if (!clauseTitle || !clauseText) continue;\n    if (seenTitles.has(clauseTitle)) continue;\n\n    result.push({\n      clause_title: clauseTitle,\n      clause_text: clauseText\n    });\n    seenTitles.add(clauseTitle);\n  }\n}\n\nreturn result;",
            "errorNodeId": "1777879914368"
          },
          "diagram": {
            "x": 5295.5,
            "y": 7480
          },
          "outcomes": {
            "success": "1778000000008"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1778000000008",
          "code": "ENRICH_ISSUES_WITH_ORIGINAL_CLAUSE_TEXT",
          "type": "CODE",
          "metadata": {
            "name": "Enrich Issues With Original Clause Text",
            "description": "Maps each validated issue row to the fetched original clause text before sub-issue splitting.",
            "returnType": "array",
            "sourceCode": "const rowsRaw = $context.$nodes.VALIDATE_NEGOTIATION_HEADERS_AND_VALUES?.$output?.result;\nconst clausesRaw = $context.$nodes.AGGREGATE_FETCHED_CLAUSES?.$output?.result;\n\nconst rows = Array.isArray(rowsRaw)\n  ? rowsRaw\n  : (rowsRaw && Array.isArray(rowsRaw.result) ? rowsRaw.result : []);\nconst clauses = Array.isArray(clausesRaw)\n  ? clausesRaw\n  : (clausesRaw && Array.isArray(clausesRaw.result) ? clausesRaw.result : []);\n\nconst toText = (v) => (v == null ? '' : v.toString().trim());\nconst normalize = (v) => toText(v).toLowerCase().replace(/[^a-z0-9]+/g, ' ').replace(/\\s+/g, ' ').trim();\n\nconst result = rows.map((row) => {\n  const title = normalize(row?.clause_name || row?.clause_title || row?.issue_clause_title || row?.doc_clause_title);\n\n  const matchedClause = clauses.find((c) => {\n    const ct = normalize(c?.clause_title);\n    if (!title || !ct) return false;\n    return ct === title || ct.includes(title) || title.includes(ct);\n  });\n\n  const existingClauseText = toText(row?.original_clause_text || row?.original_clause || row?.doc_clause_text);\n  const fetchedClauseText = toText(matchedClause?.clause_text);\n\n  return {\n    ...row,\n    original_clause_text: existingClauseText || fetchedClauseText || null,\n    original_clause: existingClauseText || fetchedClauseText || null\n  };\n});\n\nreturn result;",
            "errorNodeId": "1777879914368"
          },
          "diagram": {
