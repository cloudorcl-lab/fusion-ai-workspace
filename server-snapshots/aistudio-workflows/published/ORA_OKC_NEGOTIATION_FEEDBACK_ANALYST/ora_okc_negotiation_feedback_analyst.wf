        {
          "id": "1775381056114",
          "code": "PREPARE_CLAUSE_LEVEL_DATA_BASE",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Clause Level Data",
            "returnType": "array",
            "description": "Aggregates issue-level outputs into clause-level deviation groups with normalized severity and fields.",
            "sourceCode": "let result = [];\ntry {\n  const severityRank = {\n    \"4_CRITICAL\": 5,\n    \"3_HIGH_RISK\": 4,\n    \"2_MEDIUM_RISK\": 3,\n    \"1_LOW_RISK\": 2,\n    \"0_NO_RISK\": 1\n  };\n\n  const toIntOrNull = (v) => {\n    if (v == null || v === '') return null;\n    const n = Number(v);\n    return Number.isFinite(n) ? Math.trunc(n) : null;\n  };\n  const toText = (v) => (v == null ? '' : v.toString().trim());\n  const normalizeCode = (v) => toText(v).replace(/[^A-Za-z0-9]+/g, '_').replace(/^_+|_+$/g, '').toUpperCase();\n  const toSeverityCode = (v) => {\n    const code = normalizeCode(v);\n    return {\n      CRITICAL: '4_CRITICAL',\n      HIGH_RISK: '3_HIGH_RISK',\n      MEDIUM_RISK: '2_MEDIUM_RISK',\n      LOW_RISK: '1_LOW_RISK',\n      NO_RISK: '0_NO_RISK'\n    }[code] || code;\n  };\n\n  const loopOutput = $context.$nodes?.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC?.$output;\n  const rawList = Array.isArray(loopOutput)\n    ? loopOutput\n    : (loopOutput ? [loopOutput] : []);\n\n  const parsedItems = rawList.map((item) => {\n    if (item == null) return null;\n    if (typeof item === 'string') {\n      try {\n        const parsed = JSON.parse(item);\n        if (parsed?.result) return parsed.result;\n        return parsed;\n      } catch (e) {\n        return null;\n      }\n    }\n    if (item?.result) return item.result;\n    return item;\n  }).filter(Boolean);\n\n  const grouped = {};\n\n  for (const item of parsedItems) {\n    if (item?.unsupported_change_request === true) {\n      continue;\n    }\n\n    const policyDeviation = item.policy_deviation || item.policyDeviation || {};\n    const clauseTitle = policyDeviation.doc_clause_title || policyDeviation.docclausetitle || policyDeviation.docClauseTitle || item.doc_clause_title || item.docclausetitle || 'Unknown';\n\n    if (!grouped[clauseTitle]) grouped[clauseTitle] = [];\n\n    const polDev = { ...policyDeviation };\n    const issueNumberFallback = polDev.issue_number ?? polDev.issue_id ?? polDev.issueId;\n    polDev.issue_number = toIntOrNull(issueNumberFallback);\n    polDev.clause_number = toText(polDev.clause_number ?? polDev.clausenumber);\n    polDev.rule_code = toText(polDev.rule_code ?? polDev.rulecode) || '-1';\n    polDev.rule_description = polDev.rule_description ?? polDev.ruledescription ?? null;\n    polDev.issue = toText(polDev.issue);\n    polDev.matched_position_code = normalizeCode(polDev.matched_position_code ?? polDev.matchedpositioncode ?? polDev.matchedPositionCode) || 'OUT_OF_POLICY';\n    polDev.severity_code = toSeverityCode(polDev.severity_code ?? polDev.severitycode ?? polDev.severityCode) || '4_CRITICAL';\n    polDev.standard_position_summary = toText(polDev.standard_position_summary ?? polDev.standardpositionsummary ?? polDev.standardPositionSummary);\n    polDev.change_request_summary = toText(polDev.change_request_summary ?? polDev.changerequestsummary ?? polDev.changeRequestSummary);\n    polDev.original_clause_text = polDev.original_clause_text ?? polDev.originalclausetext ?? null;\n\n    delete polDev.issue_id;\n    delete polDev.issueId;\n    delete polDev.doc_clause_title;\n    delete polDev.docclausetitle;\n    delete polDev.docClauseTitle;\n    delete polDev.clausenumber;\n    delete polDev.rulecode;\n    delete polDev.ruledescription;\n    delete polDev.matchedpositioncode;\n    delete polDev.matchedPositionCode;\n    delete polDev.severitycode;\n    delete polDev.severityCode;\n    delete polDev.standardpositionsummary;\n    delete polDev.standardPositionSummary;\n    delete polDev.changerequestsummary;\n    delete polDev.changeRequestSummary;\n    delete polDev.supplier_request;\n    delete polDev.supplierrequest;\n    delete polDev.supplierRequest;\n    delete polDev.customer_request;\n    delete polDev.customerrequest;\n    delete polDev.customerRequest;\n    delete polDev.originalclausetext;\n\n    const recommendationsRaw = item.policy_recommendations || item.policyrecommendations || item.policyRecommendations || [];\n    const recommendations = Array.isArray(recommendationsRaw) ? recommendationsRaw : [];\n    polDev.policy_recommendations = recommendations.map((rec) => {\n      const r = rec && typeof rec === 'object' ? { ...rec } : {};\n      r.recommendation_type = normalizeCode(r.recommendation_type ?? r.recommendationtype ?? r.recommendationType);\n      r.severity_code = toSeverityCode(r.severity_code ?? r.severitycode ?? r.severityCode);\n      if (r.recommendation_type === 'SUPPLIER_REQUEST' || r.recommendation_type === 'CUSTOMER_REQUEST') {\n        r.severity_code = '4_CRITICAL';\n      }\n      if (r.recommendation_type === 'STANDARD_POSITION' && !r.severity_code) {\n        r.severity_code = '0_NO_RISK';\n      }\n      r.approval = r.approval ?? null;\n\t  r.approval_authority = r.approval_authority ?? null;\n      r.clause_number = r.clause_number ?? r.clausenumber ?? null;\n      r.recommendation_text = r.recommendation_text ?? r.recommendationtext ?? null;\n      r.position_text = r.position_text ?? r.positiontext ?? '';\n      delete r.recommendationtype;\n      delete r.recommendationType;\n      delete r.severitycode;\n      delete r.severityCode;\n      delete r.clausenumber;\n      delete r.recommendationtext;\n      delete r.positiontext;\n      return r;\n    });\n\n    grouped[clauseTitle].push(polDev);\n  }\n\n  result = Object.entries(grouped).map(([doc_clause_title, deviations]) => {\n    const stdSummaryItems = deviations\n      .map((pd) => toText(pd.standard_position_summary || pd.standardPositionSummary))\n      .filter(Boolean);\n\n    const crSummaryItems = deviations\n      .map((pd) => toText(pd.change_request_summary || pd.changeRequestSummary))\n      .filter(Boolean);\n\n    const uniqueStdSummaries = [...new Set(stdSummaryItems)];\n    const uniqueCrSummaries = [...new Set(crSummaryItems)];\n    const firstClauseText = deviations\n      .map((pd) => pd.original_clause_text)\n      .find((txt) => txt != null && txt !== '');\n\n    let highestSeverity = '0_NO_RISK';\n    let highestRank = 0;\n\n    for (const pd of deviations) {\n      const sev = toSeverityCode(pd.severity_code || pd.severityCode || '0_NO_RISK');\n      const rank = severityRank[sev] || 0;\n      if (rank > highestRank) {\n        highestRank = rank;\n        highestSeverity = sev;\n      }\n    }\n\n    return {\n      doc_clause_title,\n      original_clause_text: firstClauseText == null || firstClauseText === '' ? null : firstClauseText,\n      deviation_summary: uniqueCrSummaries.join('\\n'),\n      severity_code: highestSeverity,\n      std_position_summary: uniqueStdSummaries.join('\\n'),\n      policy_deviations: deviations\n    };\n  });\n} catch (error) {\n  result = [];\n}\n\nreturn result;",
