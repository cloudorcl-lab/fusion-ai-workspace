            "sourceCode": "const preparedData = $context.$nodes.PREPARE_CLAUSE_LEVEL_DATA.$output.result || [];\n\nconst mapped = preparedData.map(item => ({\n  doc_clause_title: item.doc_clause_title,\n  deviation_summary: item.deviation_summary,\n  standard_position_summary: item.std_position_summary\n}));\n\nreturn mapped;",
