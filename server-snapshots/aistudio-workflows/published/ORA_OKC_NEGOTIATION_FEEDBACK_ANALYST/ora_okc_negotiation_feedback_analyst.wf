                {
                  "id": "1775379344402",
                  "code": "GET_SINGLE_MATCHED_RULE_ID",
                  "type": "CODE",
                  "metadata": {
                    "name": "Get Single Matched Rule Id",
                    "returnType": "string",
                    "description": "Chooses the best matched rule identifier using rule_found and highest match_score ordering.",
                    "sourceCode": "const results = Array.isArray($context.$variables.matchedRules) ? $context.$variables.matchedRules : [];\n\nconst scored = results\n  .filter(item => item && item.rule_id)\n  .map(item => ({\n    ...item,\n    score: Number(item.match_score ?? 0),\n    normalizedRuleId: (item.rule_id ?? '').toString().trim()\n  }))\n  .sort((a, b) => {\n    const scoreDiff = b.score - a.score;\n    if (scoreDiff !== 0) return scoreDiff;\n    return a.normalizedRuleId.localeCompare(b.normalizedRuleId);\n  });\n\nconst foundOnly = scored.filter(item => item.rule_found === true);\nconst preferred = foundOnly[0] || scored[0] || null;\nconst selectedRuleId = preferred ? preferred.normalizedRuleId : null;\n\nconsole.log(JSON.stringify({\n  node: 'GET_SINGLE_MATCHED_RULE_ID',\n  event: 'best_rule_selected',\n  issueNumber: $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.$currentItem?.id ?? null,\n  candidateCount: results.length,\n  scoredCount: scored.length,\n  selectedRuleId\n}));\n\nreturn selectedRuleId;",
                    "errorNodeId": "1777879914368"
                  },
                  "diagram": {
                    "x": 5295.5,
                    "y": 14321
                  },
                  "outcomes": {
                    "success": "1775612000001"
                  },
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
