                    }
                  ]
                },
                {
                  "id": "1776505091971",
                  "code": "MAP_CLAUSE_TITLE_TO_CLAUSE_TEXT",
                  "type": "CODE",
                  "metadata": {
                    "description": "Maps clause title to clause text",
                    "name": "Map clause title to clause text",
                    "returnType": "object",
                    "sourceCode": "let result = {};\n\nconst toText = (v) => (v == null ? '' : v.toString().trim());\nconst clauseName = toText($context.$nodes?.LOOP_OVER_CLAUSE_TITLES?.$currentItem);\nconst apiOut = $context.$nodes?.GET_CLAUSE_TEXT_USING_CLAUSE_TITLE?.$output;\n\nconst readClauseText = (obj) => {\n  if (!obj || typeof obj !== 'object') return '';\n  return toText(\n    obj.ArticleText\n  );\n};\n\nlet clauseText = readClauseText(apiOut);\n\nif (!clauseText && Array.isArray(apiOut?.items) && apiOut.items.length > 0) {\n  clauseText = readClauseText(apiOut.items[0]);\n}\n\nif (clauseName && clauseText) {\n  result = { [clauseName]: clauseText };\n}\n\nreturn result;",
                    "errorNodeId": "1777879914368"
                  },
                  "diagram": {
                    "x": 5276,
                    "y": 7223
                  },
                  "outcomes": {
                    "success": "end_1776503962395"
                  },
                  "inputs": [],
