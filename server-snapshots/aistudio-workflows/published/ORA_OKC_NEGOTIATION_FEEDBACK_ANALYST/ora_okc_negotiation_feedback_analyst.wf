        {
          "id": "1779000000001",
          "code": "PREPARE_CLAUSE_LEVEL_DATA",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Clause Level Data Closest Match Wrapper",
            "returnType": "array",
            "description": "Preserves PREPARE_CLAUSE_LEVEL_DATA node code while applying closest fallback match behavior.",
            "sourceCode": "const clauses = $context.$nodes.PREPARE_CLAUSE_LEVEL_DATA_BASE?.$output?.result || [];\nconst perspective = (($context.$nodes.EXTRACT_CONTRACT_METADATA_ATTRIBUTES_VALUES?.$output?.result?.Perspective) || '').toString().trim().toUpperCase();\nconst requestType = perspective === 'BUYER' ? 'SUPPLIER_REQUEST' : 'CUSTOMER_REQUEST';\nconst OOP = 'OUT_OF_POLICY';\n\nconst toText = (v) => (v == null ? '' : String(v).trim());\nconst normalizeCode = (v) => toText(v).replace(/[^A-Za-z0-9]+/g, '_').replace(/^_+|_+$/g, '').toUpperCase();\n\nreturn clauses.map((clause) => {\n  const safeClause = clause && typeof clause === 'object' ? { ...clause } : {};\n  const issues = Array.isArray(safeClause.policy_deviations) ? safeClause.policy_deviations : [];\n\n  safeClause.policy_deviations = issues.map((issue) => {\n    const safeIssue = issue && typeof issue === 'object' ? { ...issue } : {};\n\n    const matched = normalizeCode(safeIssue.matched_position_code);\n    const closest = toText(safeIssue.closest_fallback_position_code);\n    const closestApplied = safeIssue.closest_fallback_applied === true;\n    const closestCode = normalizeCode(closest);\n\n    const shouldUseClosest =\n      matched === OOP &&\n      closestApplied &&\n      !!closest &&\n      closestCode !== OOP;\n\n    if (!shouldUseClosest) return safeIssue;\n\n    safeIssue.matched_position_code = closest;\n\n    const recs = Array.isArray(safeIssue.policy_recommendations) ? [...safeIssue.policy_recommendations] : [];\n    const hasRequest = recs.some((r) => normalizeCode(r?.recommendation_type) === requestType);\n\n    if (!hasRequest) {\n      const requestText = toText(safeIssue.change_request_summary) || toText(safeIssue.issue) || '';\n      recs.push({\n        recommendation_type: requestType,\n        recommendation_text: requestText,\n        severity_code: safeIssue.severity_code || '',\n        issue_level_severity: safeIssue.severity_code || ''\n      });\n    }\n\n    safeIssue.policy_recommendations = recs;\n    return safeIssue;\n  });\n\n  return safeClause;\n});",
