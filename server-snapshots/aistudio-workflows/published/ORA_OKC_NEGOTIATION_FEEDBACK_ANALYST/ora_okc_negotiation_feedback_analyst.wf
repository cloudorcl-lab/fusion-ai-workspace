        {
          "id": "1776064462928",
          "code": "AGGREGATE_FETCHED_CLAUSE_TEXTS",
          "type": "CODE",
          "metadata": {
            "name": "Aggregate Fetched Clause Texts",
            "returnType": "object",
            "sourceCode": "const startedAt = Date.now();\nconst contractId = $context.$variables.contractId || null;\nconst fetchedItems = $context.$nodes.LOOP_OVER_UNIQUE_CLAUSE_NUMBERS.$output;\n\nconst clauseTextMap = {};\nlet parsedCount = 0;\n\nfor (const itemStr of fetchedItems || []) {\n  if (!itemStr) continue;\n  let item;\n  try {\n    item = JSON.parse(itemStr);\n  } catch (e) {\n    continue;\n  }\n  if (item && item.result) {\n    const entries = Object.entries(item.result);\n    if (entries.length === 1) {\n      const [clauseNumber, articleText] = entries[0];\n      clauseTextMap[clauseNumber] = articleText;\n      parsedCount += 1;\n    }\n  }\n}\n\nconsole.log(JSON.stringify({\n  node: 'AGGREGATE_FETCHED_CLAUSE_TEXTS',\n  event: 'article_texts_aggregated',\n  contractId,\n  counts: {\n    fetchedItemsCount: Array.isArray(fetchedItems) ? fetchedItems.length : 0,\n    mappedClauseTextCount: Object.keys(clauseTextMap).length,\n    parsedCount\n  },\n  durationMs: Date.now() - startedAt,\n  status: 'ok',\n  error: null\n}));\n\nreturn clauseTextMap;",
            "description": "Aggregate all the clause numbers with its clause texts in a map",
            "errorNodeId": "1777879914368"
          },
