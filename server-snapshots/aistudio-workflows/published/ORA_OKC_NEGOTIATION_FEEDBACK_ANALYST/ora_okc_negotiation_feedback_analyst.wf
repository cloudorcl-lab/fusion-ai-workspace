          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1778000000005",
          "code": "AGGREGATE_EXPANDED_SUB_ISSUES",
          "type": "CODE",
          "metadata": {
            "name": "Aggregate Expanded Sub Issues",
            "description": "Flattens sub-issue expansion loop output into one array consumed by downstream loops.",
            "returnType": "array",
            "sourceCode": "const loopOutput = $context.$nodes.EXPAND_ISSUES_TO_SUB_ISSUES.$output;\nconst result = [];\n\nconst parseItem = (item) => {\n  if (item == null) return null;\n  if (typeof item === 'string') {\n    try {\n      return JSON.parse(item);\n    } catch (e) {\n      return null;\n    }\n  }\n  return item;\n};\n\nfor (const rawItem of (Array.isArray(loopOutput) ? loopOutput : [])) {\n  const parsed = parseItem(rawItem);\n  const arr = Array.isArray(parsed?.result)\n    ? parsed.result\n    : (Array.isArray(parsed) ? parsed : []);\n  for (const row of arr) {\n    if (row && typeof row === 'object') result.push(row);\n  }\n}\n\nreturn result;",
            "errorNodeId": "1777879914368"
          },
