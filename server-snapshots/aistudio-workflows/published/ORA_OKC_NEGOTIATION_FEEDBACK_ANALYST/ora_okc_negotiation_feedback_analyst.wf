        {
          "id": "1776062057483",
          "code": "GET_DEVIATION_POLICY_RULES",
          "type": "CODE",
          "metadata": {
            "name": "Get Deviation Policy Rules",
            "sourceCode": "const startedAt = Date.now();\nconst contractId = $context.$variables.contractId || null;\nlet result;\nlet status = 'ok';\nlet errorMessage = null;\n\nconst toArray = (raw) => {\n  if (Array.isArray(raw)) return raw;\n  if (!raw || typeof raw !== 'object') return [];\n\n  if (Array.isArray(raw.result)) return raw.result;\n  if (raw.collection && Array.isArray(raw.collection.result)) return raw.collection.result;\n  if (raw.output && Array.isArray(raw.output.result)) return raw.output.result;\n\n  return [];\n};\n\ntry {\n  const isProcurement = $context.$nodes?.IS_PROCUREMENT_CONTRACT?.$output === true;\n  const selectedOutput = isProcurement\n    ? $context.$nodes?.PROCUREMENT_CONTRACT_DEVIATION_POLICY?.$output\n    : $context.$nodes?.SALES_CONTRACT_DEVIATION_POLICY?.$output;\n\n  result = toArray(selectedOutput);\n\n  const shape = Array.isArray(selectedOutput)\n    ? 'array'\n    : (selectedOutput && Array.isArray(selectedOutput?.result))\n      ? 'result'\n      : (selectedOutput?.collection && Array.isArray(selectedOutput.collection.result))\n        ? 'collection.result'\n        : 'unknown';\n\n  const ruleCount = Array.isArray(result) ? result.length : 0;\n  console.log(JSON.stringify({\n    node: 'GET_DEVIATION_POLICY_RULES',\n    event: 'policy_rules_selected',\n    contractId,\n    isProcurement,\n    shape,\n    counts: { ruleCount },\n    durationMs: Date.now() - startedAt,\n    status: 'ok',\n    error: null\n  }));\n} catch (error) {\n  status = 'error';\n  errorMessage = String(error?.message || error);\n  result = [];\n  console.log(JSON.stringify({\n    node: 'GET_DEVIATION_POLICY_RULES',\n    event: 'policy_rules_selected',\n    contractId,\n    counts: { ruleCount: 0 },\n    durationMs: Date.now() - startedAt,\n    status,\n    error: errorMessage\n  }));\n  throw new Error(errorMessage || 'Failed to fetch policy rules');\n}\n\nreturn result;",
            "returnType": "object",
            "description": "Gets the policy rules and store",
            "errorNodeId": "1777879914368"
          },
          "diagram": {
            "x": 5295.5,
            "y": 8368
          },
          "outcomes": {
            "success": "1779000000002"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1779000000002",
          "code": "VALIDATE_POLICY_JSON_HEADERS_AND_VALUES",
          "type": "CODE",
          "metadata": {
            "name": "Validate Policy JSON Headers and Values",
            "returnType": "array",
            "description": "Validates required policy JSON columns, mandatory values, and fallback position-risk configuration.",
            "sourceCode": "const rules = $context.$nodes.GET_DEVIATION_POLICY_RULES.$output?.result;\n\nconst REQUIRED_HEADERS = [\n  'clause_title',\n  'rule_code',\n  'rule_description',\n  'standard_position',\n  'contract_type'\n];\n\nconst ALLOWED_RISKS = ['no risk', 'low risk', 'medium risk', 'high risk', 'critical'];\nconst ALLOWED_APPROVALS = ['yes', 'no'];\n\nconst normalize = (value) => String(value ?? '').trim();\nconst isBlank = (value) => normalize(value) === '';\nconst dedupe = (items) => Array.from(new Set((items || []).filter(Boolean)));\n\nconst contractType = normalize($context.$nodes.EXTRACT_CONTRACT_METADATA_ATTRIBUTES_VALUES?.$output?.result?.ContractTypeName) || 'selected contract type';\nconst fileLabel = normalize($context.$variables?.fileName) || 'uploaded_file';\n\nconst buildPolicyValidationEmail = (sections) => {\n  const esc = (v) => String(v ?? '')\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\n\n  let message = '';\n  message += '<div style=\"font-family:Arial,Helvetica,sans-serif;line-height:1.5;color:#111;\">';\n  message += '<p>Hi,</p>';\n  message += '<p>Your recent file upload <strong>' + esc(fileLabel) + '</strong> could not be processed due to validation errors in policy file. Please review the details below and correct the policy file before re-uploading.</p>';\n  message += '<h3>Summary of Issues</h3>';\n  message += '<p>The uploaded file does not match the required format for the selected contract type.</p>';\n  message += '<hr/>';\n  message += '<h3>What Needs Attention</h3>';\n\n  let sectionIndex = 1;\n  for (const section of sections) {\n    if (!section) continue;\n    message += '<p><strong>' + sectionIndex + '. ' + esc(section.title) + '</strong></p>';\n\n    let openList = false;\n    for (const line of section.lines || []) {\n      const resolved = String(line || '');\n      if (resolved.trim().startsWith('* ')) {\n        if (!openList) {\n          message += '<ul>';\n          openList = true;\n        }\n        message += '<li>' + esc(resolved.trim().slice(2)) + '</li>';\n      } else {\n        if (openList) {\n          message += '</ul>';\n          openList = false;\n        }\n        message += '<p>' + esc(resolved) + '</p>';\n      }\n    }\n    if (openList) message += '</ul>';\n\n    sectionIndex += 1;\n  }\n\n  message += '<hr/>';\n  message += '<h3>Required Fields</h3>';\n  message += '<p><strong>For Policy Files:</strong></p>';\n  message += '<ul>';\n  message += '<li>clause_title</li>';\n  message += '<li>rule_code</li>';\n  message += '<li>rule_description</li>';\n  message += '<li>standard_position</li>';\n  message += '<li>contract_type</li>';\n  message += '<li>At least one fallback_x_position and fallback_x_risk</li>';\n  message += '</ul>';\n  message += '<hr/>';\n  message += '<h3>Next Steps</h3>';\n  message += '<ol>';\n  message += '<li>Download the latest template</li>';\n  message += '<li>Update your file to match the required format</li>';\n  message += '<li>Ensure all mandatory fields are populated</li>';\n  message += '<li>Re-upload the corrected file</li>';\n  message += '</ol>';\n  message += '<hr/>';\n  message += '<p>If the issue persists, please contact support with your file and contract type details.</p>';\n  message += '</div>';\n\n  return message;\n};\n\nif (!Array.isArray(rules) || rules.length === 0) {\n  throw new Error(buildPolicyValidationEmail([\n    {\n      title: 'Policy Rules Missing',\n      lines: [\n        'No policy rules were found for the contract type ' + contractType + '.',\n        'At least one valid policy rule row is required for processing.'\n      ]\n    }\n  ]));\n}\n\nconst ruleObjects = rules.filter((item) => item && typeof item === 'object' && !Array.isArray(item));\nif (ruleObjects.length === 0) {\n  throw new Error(buildPolicyValidationEmail([\n    {\n      title: 'Policy Rules Missing',\n      lines: [\n        'No policy rules were found for the contract type ' + contractType + '.',\n        'At least one valid policy rule row is required for processing.'\n      ]\n    }\n  ]));\n}\n\nconst missingRequiredHeaders = new Set();\nconst invalidMandatoryFields = new Set();\nconst missingRiskForProvidedPosition = [];\nconst invalidRiskValues = [];\nconst invalidApprovalValues = [];\nconst missingFallbackPairs = [];\n\nfor (let rowIndex = 0; rowIndex < ruleObjects.length; rowIndex += 1) {\n  const row = ruleObjects[rowIndex];\n\n  for (const header of REQUIRED_HEADERS) {\n    if (!Object.prototype.hasOwnProperty.call(row, header)) {\n      missingRequiredHeaders.add(header);\n    }\n  }\n\n  for (const field of REQUIRED_HEADERS) {\n    if (isBlank(row[field])) {\n      invalidMandatoryFields.add(field);\n    }\n  }\n\n  const rowHeaders = Object.keys(row);\n  const fallbackIndexes = new Set();\n  for (const header of rowHeaders) {\n    const match = /^fallback_(\\d+)_/.exec(header);\n    if (match) fallbackIndexes.add(match[1]);\n  }\n\n  let hasFallbackPositionRiskPair = false;\n\n  for (const index of fallbackIndexes) {\n    const positionValue = normalize(row['fallback_' + index + '_position']);\n    const riskValue = normalize(row['fallback_' + index + '_risk']);\n    const approvalValue = normalize(row['fallback_' + index + '_approval']);\n\n    if (!isBlank(positionValue)) {\n      if (isBlank(riskValue)) {\n        missingRiskForProvidedPosition.push('fallback_' + index + '_risk');\n      } else if (!ALLOWED_RISKS.includes(riskValue.toLowerCase())) {\n        invalidRiskValues.push('fallback_' + index + '_risk');\n      } else {\n        hasFallbackPositionRiskPair = true;\n      }\n    }\n\n    if (!isBlank(approvalValue) && !ALLOWED_APPROVALS.includes(approvalValue.toLowerCase())) {\n      invalidApprovalValues.push('fallback_' + index + '_approval');\n    }\n  }\n\n  if (!hasFallbackPositionRiskPair) {\n    missingFallbackPairs.push('fallback_1_position + fallback_1_risk');\n  }\n}\n\nconst finalMissingHeaders = Array.from(missingRequiredHeaders);\nconst finalMissingFields = Array.from(invalidMandatoryFields);\nconst finalMissingRiskForPosition = dedupe(missingRiskForProvidedPosition);\nconst finalInvalidRisks = dedupe(invalidRiskValues);\nconst finalInvalidApprovals = dedupe(invalidApprovalValues);\nconst finalFallbackPairs = dedupe(missingFallbackPairs);\n\nconst hasHeaderIssue = finalMissingHeaders.length > 0;\nconst hasFieldIssue = finalMissingFields.length > 0;\nconst hasFallbackPairIssue = finalFallbackPairs.length > 0;\nconst hasRiskDependencyIssue = finalMissingRiskForPosition.length > 0;\nconst hasRiskValueIssue = finalInvalidRisks.length > 0;\nconst hasApprovalIssue = finalInvalidApprovals.length > 0;\n\nif (hasHeaderIssue || hasFieldIssue || hasFallbackPairIssue || hasRiskDependencyIssue || hasRiskValueIssue || hasApprovalIssue) {\n  const sections = [];\n\n  if (hasHeaderIssue) {\n    sections.push({\n      title: 'Missing or Incorrect Column Headers',\n      lines: [\n        'Some required columns ' + finalMissingHeaders.join(', ') + ' are missing or incorrectly named.',\n        'Ensure headers exactly match the template (including underscores).'\n      ]\n    });\n  }\n\n  if (hasFieldIssue) {\n    sections.push({\n      title: 'Mandatory Fields Not Populated',\n      lines: [\n        'Mandatory fields ' + finalMissingFields.join(', ') + ' contain empty or invalid values for the contract type ' + contractType + '.',\n        'All mandatory fields must be completed for every row.'\n      ]\n    });\n  }\n\n  if (hasFallbackPairIssue) {\n    sections.push({\n      title: 'Fallback Configuration Missing',\n      lines: [\n        'At least one fallback position and risk pair is required:',\n        '* fallback_1_position + fallback_1_risk (or equivalent)'\n      ]\n    });\n  }\n\n  if (hasRiskDependencyIssue) {\n    sections.push({\n      title: 'Fallback Risk Missing for Position',\n      lines: [\n        'fallback_x_risk cannot be empty when corresponding fallback_x_position is provided.',\n        'Impacted fields: ' + finalMissingRiskForPosition.join(', ') + '.'\n      ]\n    });\n  }\n\n  if (hasRiskValueIssue) {\n    sections.push({\n      title: 'Invalid Fallback Risk Values',\n      lines: [\n        'fallback_x_risk must be one of: No Risk, Low Risk, Medium Risk, High Risk, Critical.',\n        'Impacted fields: ' + finalInvalidRisks.join(', ') + '.'\n      ]\n    });\n  }\n\n  if (hasApprovalIssue) {\n    sections.push({\n      title: 'Invalid Fallback Approval Values',\n      lines: [\n        'fallback_x_approval must be Yes, No, or blank.',\n        'Impacted fields: ' + finalInvalidApprovals.join(', ') + '.'\n      ]\n    });\n  }\n\n  throw new Error(buildPolicyValidationEmail(sections));\n}\n\nreturn ruleObjects;",
            "errorNodeId": "1777880048574"
          },
          "diagram": {
            "x": 5240,
            "y": 8590
          },
          "outcomes": {
            "success": "1778000000001"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1778000000001",
          "code": "EXPAND_ISSUES_TO_SUB_ISSUES",
          "type": "LOOP",
          "metadata": {
            "name": "Expand Issues to Sub Issues",
            "returnType": "array",
            "description": "Expands each negotiation issue into one or more atomic sub-issues for one-rule-per-sub-issue matching.",
            "sourceCode": "return [];",
            "dataPipeline": {
              "rootNode": "start_1778000000001",
              "pipelineNodes": [
                {
                  "id": "start_1778000000001",
                  "code": "START",
                  "type": "START",
                  "metadata": {
                    "description": "Start of data pipeline",
                    "name": "Start"
                  },
                  "diagram": {
                    "x": 5445,
                    "y": 8902
                  },
                  "outcomes": {
                    "success": "1778000000002"
                  },
                  "inputs": []
                },
                {
                  "id": "1778000000002",
                  "code": "PREPARE_SPLIT_CONTEXT",
                  "type": "CODE",
                  "metadata": {
                    "name": "Prepare Split Context",
                    "description": "Builds canonical active change request text and context for sub-issue splitting.",
                    "returnType": "object",
                    "sourceCode": "const row = $context.$nodes.EXPAND_ISSUES_TO_SUB_ISSUES.$currentItem || {};\nconst perspective = (($context.$nodes.EXTRACT_CONTRACT_METADATA_ATTRIBUTES_VALUES?.$output?.result?.Perspective) || '').toString().trim().toUpperCase() || 'UNKNOWN';\n\nconst toText = (v) => (v == null ? '' : v.toString().trim());\nconst toLower = (v) => toText(v).toLowerCase();\n\nconst parentIssueId = toText(row.id || row.issue_id || row.issue_number || '');\nconst override = toText(row.active_change_request_override || row.sub_issue_text);\n\nconst pickLatestFromArray = (arr) => {\n  if (!Array.isArray(arr)) return '';\n  let latest = '';\n  for (const item of arr) {\n    const t = toText(item);\n    if (t) latest = t;\n  }\n  return latest;\n};\n\nlet latestSupplier = toText(row.latest_supplier_message);\nlet latestBuyer = toText(row.latest_buyer_message);\n\nif (!latestSupplier) latestSupplier = pickLatestFromArray(row.supplier_messages);\nif (!latestBuyer) latestBuyer = pickLatestFromArray(row.buyer_messages);\n\nif (Array.isArray(row.round_messages)) {\n  for (const entry of row.round_messages) {\n    const s = toText(entry?.supplier_message);\n    const b = toText(entry?.buyer_message);\n    if (s) latestSupplier = s;\n    if (b) latestBuyer = b;\n  }\n}\n\nif (!latestSupplier) latestSupplier = toText(row.supplier_message);\nif (!latestBuyer) latestBuyer = toText(row.buyer_message);\n\nif (!latestSupplier || !latestBuyer) {\n  for (const key of Object.keys(row || {})) {\n    const value = toText(row[key]);\n    if (!value) continue;\n    const lk = toLower(key);\n    if (!latestSupplier && lk.includes('supplier')) latestSupplier = value;\n    if (!latestBuyer && (lk.includes('buyer') || lk.includes('customer') || lk.includes('company'))) latestBuyer = value;\n  }\n}\n\nconst preferredSide = perspective === 'SUPPLIER' ? 'BUYER' : 'SUPPLIER';\nlet activeText = preferredSide === 'SUPPLIER'\n  ? (latestSupplier || latestBuyer || '')\n  : (latestBuyer || latestSupplier || '');\n\nif (!activeText) {\n  const fallbackCandidates = [\n    row.change_request,\n    row.change_request_text,\n    row.requested_change,\n    row.requested_change_text,\n    row.proposed_change,\n    row.proposed_clause,\n    row.counterparty_change_request,\n    row.message,\n    row.comment,\n    row.remarks,\n    row.reason\n  ].map(toText);\n  activeText = fallbackCandidates.find(Boolean) || '';\n}\n\nif (override) {\n  activeText = override;\n}\n\nconst result = {\n  parent_issue_id: parentIssueId,\n  clause_name: toText(row.clause_name || row.clause_title || row.issue_clause_title || row.doc_clause_title || 'Unknown'),\n  clause_number: toText(row.clause_number || '') || null,\n  status: toText(row.status || ''),\n  perspective,\n  active_change_request_text: activeText,\n  latest_supplier_change_request: latestSupplier || null,\n  latest_buyer_change_request: latestBuyer || null,\n  original_clause_text: toText(row.original_clause_text || row.original_clause || ''),\n  original_row: row\n};\n\nreturn result;",
                    "errorNodeId": "1777879914368"
                  },
