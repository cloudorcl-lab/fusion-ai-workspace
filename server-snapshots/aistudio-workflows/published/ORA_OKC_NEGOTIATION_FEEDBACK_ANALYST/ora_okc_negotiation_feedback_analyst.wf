        },
        {
          "id": "1776063685508",
          "code": "EXTRACT_UNIQUE_CLAUSE_NUMBERS_FROM_POLICY",
          "type": "CODE",
          "metadata": {
            "name": "Extract Unique Clause Numbers from Policy",
            "returnType": "object",
            "sourceCode": "const startedAt = Date.now();\nconst contractId = $context.$variables.contractId || null;\nconst inputCollection = $context.$nodes.GET_DEVIATION_POLICY_RULES.$output.result;\n\nconst clauseNumbersSet = new Set();\nfor (const rule of inputCollection || []) {\n  if (rule.standard_clause_number && rule.standard_clause_number.trim() !== '') {\n    clauseNumbersSet.add(rule.standard_clause_number);\n  }\n  for (let i = 1; i <= 10; i++) {\n    const fallbackKey = `fallback_${i}_clause_number`;\n    if (rule[fallbackKey] && rule[fallbackKey].trim() !== '') {\n      clauseNumbersSet.add(rule[fallbackKey].trim());\n    }\n  }\n}\n\nconst uniqueClauseNumbers = Array.from(clauseNumbersSet);\nconsole.log(JSON.stringify({\n  node: 'EXTRACT_UNIQUE_CLAUSE_NUMBERS',\n  event: 'unique_clause_numbers_extracted',\n  contractId,\n  counts: {\n    ruleCount: Array.isArray(inputCollection) ? inputCollection.length : 0,\n    uniqueClauseNumberCount: uniqueClauseNumbers.length\n  },\n  durationMs: Date.now() - startedAt,\n  status: 'ok',\n  error: null\n}));\n\nconst result = { uniqueClauseNumbers };\nreturn result;",
            "description": "Extracts the Clause Numbers from policy document",
            "errorNodeId": "1777879914368"
          },
