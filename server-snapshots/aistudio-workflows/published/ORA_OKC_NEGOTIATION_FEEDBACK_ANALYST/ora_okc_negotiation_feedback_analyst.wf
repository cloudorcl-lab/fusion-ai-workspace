                            "name": "Add Matched Rule",
                            "returnType": "array",
                            "description": "Adds the current policy row to matched rules when rule-issue matching confirms a valid match.",
                            "sourceCode": "let combinedRules = [];\ntry {\n  const ruleIssueMatcherOutput = $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.FOR_EACH_POLICY_IN_POLICY_JSON.RULE_ISSUE_MATCHER.$output;\n  const policyRow = $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.FOR_EACH_POLICY_IN_POLICY_JSON.$currentItem || {};\n  combinedRules = [...$context.$variables.matchedRules];\n\n  if (ruleIssueMatcherOutput?.rule_found === true) {\n    const resolvedRuleId = (ruleIssueMatcherOutput.rule_id || policyRow.rule_id || policyRow.ruleId || policyRow.rule_code || policyRow.id || '').toString().trim();\n    combinedRules.push({\n      ...ruleIssueMatcherOutput,\n      rule_id: resolvedRuleId || null\n    });\n  }\n\n  console.log(JSON.stringify({\n    node: 'ADD_MATCHED_RULE',\n    event: 'rule_evaluated',\n    issueNumber: $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.$currentItem?.id ?? null,\n    policyRuleCode: policyRow.rule_code ?? policyRow.rule_id ?? policyRow.id ?? null,\n    rule_found: !!ruleIssueMatcherOutput?.rule_found,\n    matchedRulesCount: combinedRules.length\n  }));\n} catch (error) {\n  combinedRules = $context.$variables.matchedRules;\n  console.log(JSON.stringify({\n    node: 'ADD_MATCHED_RULE',\n    event: 'rule_evaluation_error',\n    issueNumber: $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.$currentItem?.id ?? null,\n    matchedRulesCount: Array.isArray(combinedRules) ? combinedRules.length : 0,\n    error: String(error?.message || error)\n  }));\n}\n\nreturn combinedRules;",
