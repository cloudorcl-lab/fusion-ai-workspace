                          "inputs": []
                        },
                        {
                          "id": "1775468610353",
                          "code": "CLAUSE_NAME_MATCHER",
                          "type": "CODE",
                          "metadata": {
                            "name": "Clause Name Matcher",
                            "sourceCode": "const normalize = (v) => (v || '').toString().toLowerCase().replace(/[^a-z0-9]+/g, ' ').replace(/\\s+/g, ' ').trim();\n\nconst current = $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.$currentItem || {};\nconst policy = $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.FOR_EACH_POLICY_IN_POLICY_JSON.$currentItem || {};\nconst policyKeys = Object.keys(policy || {});\n\nconst clauseTitle = normalize(current.clause_name || current.clause_title || current.issue_clause_title || current.doc_clause_title);\nconst clauseName = normalize(policy.clause_title || policy.doc_clause_title || policy.clause_name);\n\nlet isMatched = false;\nlet overlapScore = 0;\n\nif (clauseTitle && clauseName) {\n  if (clauseTitle === clauseName) {\n    isMatched = true;\n    overlapScore = 1;\n  } else if (clauseTitle.includes(clauseName) || clauseName.includes(clauseTitle)) {\n    isMatched = true;\n    overlapScore = 0.9;\n  } else {\n    const a = new Set(clauseTitle.split(' ').filter(Boolean));\n    const b = clauseName.split(' ').filter(Boolean);\n    const overlap = b.filter(t => a.has(t)).length;\n    const score = overlap / Math.max(b.length, 1);\n    overlapScore = score;\n    isMatched = score >= 0.6;\n  }\n}\n\nconsole.log(JSON.stringify({\n  node: 'CLAUSE_NAME_MATCHER',\n  event: 'clause_title_compared',\n  issueNumber: current.id ?? current.issue_id ?? current.issue_number ?? null,\n  policyRuleCode: policy.rule_code ?? policy.rule_id ?? policy.id ?? null,\n  policyKeysCount: policyKeys.length,\n  hasPolicyClauseTitle: !!(policy.clause_title || policy.doc_clause_title || policy.clause_name),\n  clauseTitle,\n  policyClauseTitle: clauseName,\n  overlapScore,\n  isMatched\n}));\n\nreturn isMatched;",
                            "description": "Compares the issue clause title with the current policy row clause title to filter candidate rule rows.",
                            "returnType": "boolean",
                            "errorNodeId": "1777879914368"
                          },
                          "diagram": {
                            "x": 5295.5,
                            "y": 13176
                          },
                          "outcomes": {
