                  "id": "1775380366258",
                  "code": "CR_RECOMMANDATION_GENERATOR",
                  "type": "LLM",
                  "metadata": {
                    "name": "CR Recommandation Generator",
                    "description": "Generates policy recommendation candidates for the determined change-request position.",
                    "modelConfiguration": {
                      "code": "ORA_MODEL_CONFIG_PREMIUM_OPEN_AI_GPT_4_1_MINI",
                      "modelName": "Gpt-5 Mini",
                      "provider": "CERT_PREMIUM",
