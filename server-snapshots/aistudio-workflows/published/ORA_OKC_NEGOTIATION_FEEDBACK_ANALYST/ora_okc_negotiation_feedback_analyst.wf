        {
          "metadata": {
            "name": "Extract Contract Metadata Attributes Values",
            "returnType": "array",
            "sourceCode": "let result = {\n  ContractNumber: \"\",\n  ContractTypeName: \"\"\n};\ntry {\n  const contractDetails = $context.$nodes?.GET_CONTRACT_DETAILS?.$output || {};\n  const contractNumber = contractDetails.ContractNumber;\n  const contractTypeName = contractDetails.ContractTypeName;\n  const documentType = contractDetails.DocumentType;\n  const buyOrSell = contractDetails.BuyOrSell;\n  const perspective = buyOrSell == \"B\" ? \"BUYER\" : \"SUPPLIER\";\n  const orgId = Number(contractDetails.OrgId);\n  const chrId = Number(contractDetails.Id);\n  const majorVersion = Number(contractDetails.MajorVersion);\n  result = {\n    ContractNumber: contractNumber,\n    ContractTypeName: contractTypeName,\n    Perspective: perspective,\n    DocumentType: documentType,\n    BuyOrSell: buyOrSell,\n    OrgId: orgId,\n\tChrId: chrId,\n\tMajorVersion: majorVersion\n  };\n}\ncatch( error) {\n  result = {\n    ContractNumber: \"\",\n    ContractTypeName: \"\",\n    Perspective: \"\",\n    DocumentType: \"\",\n    BuyOrSell: \"\",\n    OrgId: \"\",\n\tChrId: \"\",\n\tMajorVersion: \"\"\n  };\n}\nreturn result;",
            "description": "Extract the required contract attribute values",
            "errorNodeId": "1777879914368"
          },
          "outcomes": {
