          "outcomes": {
            "success": "1775493355029"
          },
          "inputs": [
            {
              "id": "1775457700543_prompt",
              "name": "prompt",
              "type": "string",
              "value": "You are given an array of clause-level data objects.\n\nDATA: {{$context.$nodes.MAP_CLAUSE_TITLE_AND_ISSUES.$output.result}}\n\nTASK\nFor each doc_clause_title, generate a synthesized clause-level standard_position_summary from the combined issue-level standard position summaries.\n\nSTRICT RULES\n- Summarize only standard position intent.\n- Do not include fallback positions, approvals, or risk explanations.\n- Produce a concise synthesized summary, not a copy/merge of input text.\n- 1 to 3 sentences maximum.\n- Do not use numbering/bullets.\n- Ignore formatting-only noise (newlines, tabs, repeated spaces, special symbols).\n- If input for a clause is empty, return an empty string for standard_position_summary.\n\nOUTPUT\nReturn valid JSON array only:\n[\n  {\n    \"doc_clause_title\": \"<string>\",\n    \"standard_position_summary\": \"<string>\"\n  }\n]\nNo extra text."
            }
          ],
          "outputSpecification": "{\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"doc_clause_title\": { \"type\": \"string\" },\n      \"standard_position_summary\": { \"type\": \"string\" }\n    },\n    \"required\": [\"doc_clause_title\", \"standard_position_summary\"]\n  }\n}"
        },
        {
          "id": "1775493355029",
          "code": "FINAL_FEEDBACK_RESULT",
          "type": "CODE",
          "metadata": {
            "name": "Final Feedback Result",
            "returnType": "array",
            "description": "Builds the final normalized feedback payload per clause for persistence and downstream consumption.",
            "sourceCode": "const preparedData = $context.$nodes.PREPARE_CLAUSE_LEVEL_DATA.$output.result || [];\n\nconst normalize = (v) => (v || '').toString().toLowerCase().replace(/[^a-z0-9]+/g, ' ').replace(/\\s+/g, ' ').trim();\nconst toText = (v) => (v == null ? '' : v.toString().trim());\nconst normalizeCode = (v) => toText(v).replace(/[^A-Za-z0-9]+/g, '_').replace(/^_+|_+$/g, '').toUpperCase();\nconst toSeverityCode = (v) => {\n  const code = normalizeCode(v);\n  return {\n    CRITICAL: '4_CRITICAL',\n    HIGH_RISK: '3_HIGH_RISK',\n    MEDIUM_RISK: '2_MEDIUM_RISK',\n    LOW_RISK: '1_LOW_RISK',\n    NO_RISK: '0_NO_RISK'\n  }[code] || code;\n};\nconst canonicalRecommendationType = (v) => {\n  const code = normalizeCode(v);\n  if (code === 'STANDARDPOSITION' || code === 'STANDARD_POSITION') return 'STANDARD_POSITION';\n  const fallbackMatch = code.match(/^FALLBACK_?([0-9]+)_?POSITION$/);\n  if (fallbackMatch) return `FALLBACK_${fallbackMatch[1]}_POSITION`;\n  return code;\n};\nconst toMatchedPositionDisplay = (v) => {\n  const code = normalizeCode(v);\n  if (code === 'STANDARD_POSITION') return 'STANDARD';\n  if (code === 'OUT_OF_POLICY') return 'OUT_OF_POLICY';\n  const fallbackMatch = code.match(/^FALLBACK_?([0-9]+)_?POSITION$/);\n  if (fallbackMatch) return `FALLBACK_${fallbackMatch[1]}`;\n  return code;\n};\nconst toRecommendationTypeDisplay = (v) => {\n  const code = normalizeCode(v);\n  if (code === 'STANDARD_POSITION') return 'STANDARD';\n  if (code === 'SUPPLIER_REQUEST') return 'SUPPLIER_REQUEST';\n  if (code === 'CUSTOMER_REQUEST') return 'CUSTOMER_REQUEST';\n  const fallbackMatch = code.match(/^FALLBACK_?([0-9]+)_?POSITION$/);\n  if (fallbackMatch) return `FALLBACK_${fallbackMatch[1]}`;\n  return code;\n};\n\nconst normList = (value) => {\n  if (Array.isArray(value)) return value;\n  if (value == null) return [];\n  if (typeof value === 'string') {\n    try {\n      const parsed = JSON.parse(value);\n      return Array.isArray(parsed) ? parsed : [];\n    } catch (e) {\n      return [];\n    }\n  }\n  return [];\n};\n\nconst sourceFileName = ($context.$variables.fileName || '').toString();\nconst llmSummaries = normList($context.$nodes.GENERATE_CLAUSE_LEVEL_DEVIATION_SUMMARY.$output);\nconst stdPosSummaries = normList($context.$nodes.GENERATE_STANDARD_POSITION_SUMMARY_FOR_ISSUES.$output);\n\nconst byTitle = (list, title) => {\n  const key = normalize(title);\n  return list.find((item) => {\n    const candidateTitle = item?.doc_clause_title ?? item?.docclausetitle ?? item?.docClauseTitle;\n    return normalize(candidateTitle) === key;\n  }) || {};\n};\n\nreturn preparedData.map((clause) => {\n  const llmSummary = byTitle(llmSummaries, clause.doc_clause_title);\n  const stdPosSummary = byTitle(stdPosSummaries, clause.doc_clause_title);\n\n  const deviationSummary = toText(\n    llmSummary.deviation_summary\n    ?? llmSummary.deviationsummary\n    ?? clause.deviation_summary\n  );\n  const standardPositionSummary = toText(\n    stdPosSummary.standard_position_summary\n    ?? stdPosSummary.standardpositionsummary\n    ?? clause.std_position_summary\n  ) || 'No policy rule available for comparison.';\n\n  const policyDeviationsRaw = clause.policy_deviations ?? clause.policydeviations ?? clause.policyDeviations;\n  const policyDeviations = Array.isArray(policyDeviationsRaw) ? policyDeviationsRaw : [];\n  const normalizedPolicyDeviations = policyDeviations.map((issue) => {\n    const safeIssue = issue && typeof issue === 'object' ? { ...issue } : {};\n\n    const internalMatchedPositionCode = normalizeCode(\n      safeIssue.matched_position_code\n      ?? safeIssue.matchedpositioncode\n      ?? safeIssue.matchedPositionCode\n    ) || 'OUT_OF_POLICY';\n    safeIssue.matched_position_code = toMatchedPositionDisplay(internalMatchedPositionCode);\n\n    const recsRaw = safeIssue.policy_recommendations ?? safeIssue.policyrecommendations ?? safeIssue.policyRecommendations;\n    const recs = Array.isArray(recsRaw) ? recsRaw : [];\n\n    safeIssue.policy_recommendations = recs.map((rec) => {\n      const safeRec = rec && typeof rec === 'object' ? { ...rec } : {};\n      const type = canonicalRecommendationType(safeRec.recommendation_type ?? safeRec.recommendationtype ?? safeRec.recommendationType);\n      const severity = toSeverityCode(safeRec.severity_code ?? safeRec.severitycode ?? safeRec.severityCode);\n\n      if (type === 'SUPPLIER_REQUEST' || type === 'CUSTOMER_REQUEST') {\n        safeRec.severity_code = '4_CRITICAL';\n      } else if (type === 'STANDARD_POSITION' && !severity) {\n        safeRec.severity_code = '0_NO_RISK';\n      } else {\n        safeRec.severity_code = severity || toText(safeRec.severity_code);\n      }\n      safeRec.recommendation_type = toRecommendationTypeDisplay(type || 'STANDARD_POSITION');\n\n      delete safeRec.recommendationtype;\n      delete safeRec.recommendationType;\n      delete safeRec.severitycode;\n      delete safeRec.severityCode;\n      return safeRec;\n    });\n\n    delete safeIssue.policyrecommendations;\n    delete safeIssue.policyRecommendations;\n    delete safeIssue.matchedpositioncode;\n    delete safeIssue.matchedPositionCode;\n    delete safeIssue.supplier_request;\n    delete safeIssue.supplierrequest;\n    delete safeIssue.supplierRequest;\n    delete safeIssue.customer_request;\n    delete safeIssue.customerrequest;\n    delete safeIssue.customerRequest;\n    return safeIssue;\n  });\n\n  return {\n    doc_clause_title: clause.doc_clause_title,\n    source_file_name: sourceFileName,\n    source_of_deviation: 'CHANGE_REQUEST',\n    doc_clause_text: clause.original_clause_text == null || clause.original_clause_text === '' ? null : clause.original_clause_text,\n    deviation_summary: deviationSummary,\n    standard_position_summary: standardPositionSummary,\n    severity_code: toSeverityCode(clause.severity_code) || '0_NO_RISK',\n    policy_deviations: normalizedPolicyDeviations\n  };\n});",
            "errorNodeId": "1777879914368"
          },
          "diagram": {
            "x": 5295.5,
            "y": 17242
          },
          "outcomes": {
            "success": "1778000000007"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1778000000007",
          "code": "NORMALIZE_OUT_OF_POLICY_CLOSEST_MATCH_SEVERITY",
          "type": "CODE",
          "metadata": {
            "name": "Normalize Out Of Policy Closest Match Severity",
            "returnType": "array",
            "description": "Applies closest-fallback severity override to out-of-policy supplier/customer recommendations and clause severity.",
            "sourceCode": "const clauses = $context.$nodes.FINAL_FEEDBACK_RESULT.$output?.result || [];\n\nconst toText = (v) => (v == null ? '' : v.toString().trim());\nconst normalizeCode = (v) => toText(v).replace(/[^A-Za-z0-9]+/g, '_').replace(/^_+|_+$/g, '').toUpperCase();\nconst toSeverityCode = (v) => {\n  const code = normalizeCode(v);\n  return {\n    CRITICAL: '4_CRITICAL',\n    HIGH_RISK: '3_HIGH_RISK',\n    MEDIUM_RISK: '2_MEDIUM_RISK',\n    LOW_RISK: '1_LOW_RISK',\n    NO_RISK: '0_NO_RISK'\n  }[code] || code;\n};\nconst rank = {\n  '4_CRITICAL': 5,\n  '3_HIGH_RISK': 4,\n  '2_MEDIUM_RISK': 3,\n  '1_LOW_RISK': 2,\n  '0_NO_RISK': 1\n};\n\nreturn (Array.isArray(clauses) ? clauses : []).map((clause) => {\n  const safeClause = clause && typeof clause === 'object' ? { ...clause } : {};\n  const issuesRaw = safeClause.policy_deviations;\n  const issues = Array.isArray(issuesRaw) ? issuesRaw : [];\n\n  const normalizedIssues = issues.map((issue) => {\n    const safeIssue = issue && typeof issue === 'object' ? { ...issue } : {};\n    const matchedPositionCode = normalizeCode(\n      safeIssue.matched_position_code\n      ?? safeIssue.matchedpositioncode\n      ?? safeIssue.matchedPositionCode\n    );\n\n    const closestApplied = safeIssue.closest_fallback_applied === true;\n    const closestSeverityCode = toSeverityCode(\n      safeIssue.closest_fallback_severity_code\n      ?? safeIssue.closestfallbackseveritycode\n      ?? safeIssue.closestFallbackSeverityCode\n    );\n\n    const currentIssueSeverity = toSeverityCode(\n      safeIssue.severity_code\n      ?? safeIssue.severitycode\n      ?? safeIssue.severityCode\n    ) || '4_CRITICAL';\n\n    const effectiveIssueSeverity =\n      matchedPositionCode === 'OUT_OF_POLICY' && closestApplied && !!closestSeverityCode\n        ? closestSeverityCode\n        : currentIssueSeverity;\n\n    safeIssue.severity_code = effectiveIssueSeverity;\n\n    const recsRaw = safeIssue.policy_recommendations;\n    const recs = Array.isArray(recsRaw) ? recsRaw : [];\n    safeIssue.policy_recommendations = recs.map((rec) => {\n      const safeRec = rec && typeof rec === 'object' ? { ...rec } : {};\n      const recType = normalizeCode(safeRec.recommendation_type ?? safeRec.recommendationtype ?? safeRec.recommendationType);\n      const recSeverity = toSeverityCode(safeRec.severity_code ?? safeRec.severitycode ?? safeRec.severityCode);\n\n      if (recType === 'SUPPLIER_REQUEST' || recType === 'CUSTOMER_REQUEST') {\n        safeRec.severity_code = effectiveIssueSeverity;\n      } else {\n        safeRec.severity_code = recSeverity || safeRec.severity_code || '';\n      }\n\n      return safeRec;\n    });\n\n    return safeIssue;\n  });\n\n  safeClause.policy_deviations = normalizedIssues;\n\n  let highest = '0_NO_RISK';\n  let highestRank = 0;\n  for (const issue of normalizedIssues) {\n    const sev = toSeverityCode(issue?.severity_code) || '0_NO_RISK';\n    const sevRank = rank[sev] || 0;\n    if (sevRank > highestRank) {\n      highestRank = sevRank;\n      highest = sev;\n    }\n  }\n\n  if (normalizedIssues.length > 0) {\n    safeClause.severity_code = highest;\n  }\n\n  return safeClause;\n});",
            "errorNodeId": "1777879914368"
          },
          "diagram": {
            "x": 5208.5,
            "y": 17464
          },
          "outcomes": {
            "success": "1776076039905"
