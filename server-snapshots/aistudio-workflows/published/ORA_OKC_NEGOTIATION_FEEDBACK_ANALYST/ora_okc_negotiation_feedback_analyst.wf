                {
                  "id": "1775490825526",
                  "code": "COMBINE_CR_POSITION_AND_RECOMMANDATIONS",
                  "type": "CODE",
                  "metadata": {
                    "name": "Combine CR Position and Recommandations",
                    "returnType": "object",
                    "description": "Combines position analysis, matched rule context, clause text, and recommendations into one issue result.",
                    "sourceCode": "let poldev = $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.DETERMINE_CHANGE_REQUEST_POSITION.$output;\nconst matchedRuleNodeOutput = $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.GET_POLICY_RULE_BY_ID.$output;\nconst matchedRule = (matchedRuleNodeOutput && typeof matchedRuleNodeOutput === 'object' && 'result' in matchedRuleNodeOutput)\n  ? (matchedRuleNodeOutput.result || {})\n  : (matchedRuleNodeOutput || {});\nconst selectedRuleIdRaw = $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.GET_SINGLE_MATCHED_RULE_ID.$output?.result;\nconst clauseTextNodeOutput = $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.GET_THE_CLAUSE_TEXT.$output;\nconst activeSelection = $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.SELECT_ACTIVE_CHANGE_REQUEST.$output?.result || {};\nconst row = $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.$currentItem || {};\nconst perspective = (($context.$nodes.EXTRACT_CONTRACT_METADATA_ATTRIBUTES_VALUES?.$output?.result?.Perspective) || '').toString().toUpperCase();\n\nif (!poldev || typeof poldev !== 'object') {\n  poldev = {};\n}\nif (!poldev.policy_deviation || typeof poldev.policy_deviation !== 'object') {\n  poldev.policy_deviation = {};\n}\n\nconst toText = (v) => (v == null ? '' : v.toString().trim());\nconst normalizeCode = (v) => toText(v).replace(/[^A-Za-z0-9]+/g, '_').replace(/^_+|_+$/g, '').toUpperCase();\nconst toSeverityCode = (v) => {\n  const code = normalizeCode(v);\n  return {\n    CRITICAL: '4_CRITICAL',\n    HIGH_RISK: '3_HIGH_RISK',\n    MEDIUM_RISK: '2_MEDIUM_RISK',\n    LOW_RISK: '1_LOW_RISK',\n    NO_RISK: '0_NO_RISK'\n  }[code] || code;\n};\nconst toIntOrNull = (v) => {\n  if (v == null || v === '') return null;\n  const n = Number(v);\n  return Number.isFinite(n) ? Math.trunc(n) : null;\n};\n\nconst fallbackChangeRequestSummary = [\n  activeSelection.active_change_request_text,\n  row.change_request,\n  row.change_request_text,\n  row.requested_change,\n  row.requested_change_text,\n  row.proposed_change,\n  row.proposed_clause,\n  row.counterparty_change_request,\n  row.supplier_message,\n  row.latest_supplier_message,\n  row.buyer_message,\n  row.latest_buyer_message,\n  row.reason\n].map(toText).find(Boolean) || '';\n\nconst exactCounterpartyRequest = perspective === 'BUYER'\n  ? toText(activeSelection.latest_supplier_change_request || row.latest_supplier_message || row.supplier_message)\n  : toText(activeSelection.latest_buyer_change_request || row.latest_buyer_message || row.buyer_message);\n\nconst resolvedRuleId = toText(matchedRule.rule_id ?? matchedRule.ruleId ?? matchedRule.rule_code ?? matchedRule.id ?? selectedRuleIdRaw);\nconst ruleCode = toText(matchedRule.rule_code ?? matchedRule.rule_id ?? matchedRule.ruleId ?? matchedRule.id);\nconst ruleDescriptionRaw = matchedRule.rule_description ?? matchedRule.ruleDescription ?? matchedRule.ruledescription ?? matchedRule.rule_desc;\nconst clauseTextRaw = (clauseTextNodeOutput && typeof clauseTextNodeOutput === 'object' && 'result' in clauseTextNodeOutput)\n  ? clauseTextNodeOutput.result\n  : clauseTextNodeOutput;\n\nconst issueNumberFallback = poldev.policy_deviation.issue_number ?? poldev.policy_deviation.issue_id ?? poldev.policy_deviation.issueId;\npoldev.policy_deviation.issue_number = toIntOrNull(issueNumberFallback);\ndelete poldev.policy_deviation.issue_id;\ndelete poldev.policy_deviation.issueId;\n\nconst matchedPositionCode = normalizeCode(\n  poldev.policy_deviation.matched_position_code\n  ?? poldev.policy_deviation.matchedpositioncode\n  ?? poldev.policy_deviation.matchedPositionCode\n);\nconst severityCode = toSeverityCode(\n  poldev.policy_deviation.severity_code\n  ?? poldev.policy_deviation.severitycode\n  ?? poldev.policy_deviation.severityCode\n);\n\npoldev.policy_deviation.matched_position_code = matchedPositionCode || 'OUT_OF_POLICY';\npoldev.policy_deviation.severity_code = severityCode || '4_CRITICAL';\npoldev.policy_deviation.rule_code = ruleCode || '-1';\ndelete poldev.policy_deviation.rule_id;\npoldev.policy_deviation.rule_description = (ruleDescriptionRaw == null || ruleDescriptionRaw === '') ? null : ruleDescriptionRaw;\npoldev.policy_deviation.original_clause_text = (clauseTextRaw == null || clauseTextRaw === '') ? null : clauseTextRaw;\n\nconst existingStdSummary = toText(\n  poldev.policy_deviation.standard_position_summary\n  ?? poldev.policy_deviation.standardpositionsummary\n  ?? poldev.policy_deviation.standardPositionSummary\n);\npoldev.policy_deviation.standard_position_summary = existingStdSummary || toText(matchedRule.standard_position);\n\nconst existingChangeRequestSummary = toText(\n  poldev.policy_deviation.change_request_summary\n  ?? poldev.policy_deviation.changerequestsummary\n  ?? poldev.policy_deviation.changeRequestSummary\n);\npoldev.policy_deviation.change_request_summary = existingChangeRequestSummary || fallbackChangeRequestSummary;\n\nlet outOfPolicyRequestType = '';\nlet outOfPolicyRequestText = '';\nif (poldev.policy_deviation.matched_position_code === 'OUT_OF_POLICY') {\n  const verbatimRequest = exactCounterpartyRequest || fallbackChangeRequestSummary;\n  poldev.policy_deviation.change_request_summary = verbatimRequest;\n  outOfPolicyRequestType = perspective === 'BUYER' ? 'SUPPLIER_REQUEST' : 'CUSTOMER_REQUEST';\n  outOfPolicyRequestText = verbatimRequest;\n}\n\ndelete poldev.policy_deviation.matchedpositioncode;\ndelete poldev.policy_deviation.matchedPositionCode;\ndelete poldev.policy_deviation.severitycode;\ndelete poldev.policy_deviation.severityCode;\ndelete poldev.policy_deviation.standardpositionsummary;\ndelete poldev.policy_deviation.standardPositionSummary;\ndelete poldev.policy_deviation.changerequestsummary;\ndelete poldev.policy_deviation.changeRequestSummary;\ndelete poldev.policy_deviation.supplier_request;\ndelete poldev.policy_deviation.supplierrequest;\ndelete poldev.policy_deviation.supplierRequest;\ndelete poldev.policy_deviation.customer_request;\ndelete poldev.policy_deviation.customerrequest;\ndelete poldev.policy_deviation.customerRequest;\n\nconst setNodeOutput = $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.SET_RECOMMONDATION_TEXT_FOR_CLAUSE_NUMBER.$output;\nconst setNodeRecommendations = Array.isArray(setNodeOutput)\n  ? setNodeOutput\n  : (setNodeOutput && Array.isArray(setNodeOutput.result) ? setNodeOutput.result : null);\n\nconst recommendations = Array.isArray(setNodeRecommendations) ? setNodeRecommendations : [];\n\nconst getPolicyClauseNumberByType = (typeCode) => {\n  const t = normalizeCode(typeCode);\n  if (t === 'STANDARD_POSITION') {\n    return toText(matchedRule.standard_clause_number || matchedRule.standardclausenumber) || null;\n  }\n  const fallbackMatch = t.match(/^FALLBACK_([0-9]+)_POSITION$/);\n  if (fallbackMatch) {\n    const idx = fallbackMatch[1];\n    const key = `fallback${idx}_clause_number`;\n    const altKey = `fallback${idx}ClauseNumber`;\n    return toText(matchedRule[key] ?? matchedRule[altKey]) || null;\n  }\n  return null;\n};\n\npoldev.policy_recommendations = recommendations.map((rec) => {\n  const recommendation = rec && typeof rec === 'object' ? { ...rec } : {};\n\n  const recommendationType = normalizeCode(\n    recommendation.recommendation_type\n    ?? recommendation.recommendationtype\n    ?? recommendation.recommendationType\n  );\n  const recommendationSeverity = toSeverityCode(\n    recommendation.severity_code\n    ?? recommendation.severitycode\n    ?? recommendation.severityCode\n  );\n\n  recommendation.recommendation_type = recommendationType || 'STANDARD_POSITION';\n  recommendation.severity_code = recommendationSeverity || recommendation.severity_code || '';\n  recommendation.approval = recommendation.approval ?? null;\n  recommendation.approval_authority = recommendation.approval_authority ?? null;\n  recommendation.clause_number = getPolicyClauseNumberByType(recommendation.recommendation_type);\n  recommendation.recommendation_text = recommendation.recommendation_text ?? recommendation.recommendationtext ?? null;\n  recommendation.position_text = recommendation.position_text ?? recommendation.positiontext ?? '';\n\n  if (recommendation.recommendation_type === 'STANDARD_POSITION') {\n    recommendation.severity_code = '0_NO_RISK';\n  }\n\n  if (/^FALLBACK_[0-9]+_POSITION$/.test(recommendation.recommendation_type) && !toText(recommendation.recommendation_text)) {\n    recommendation.recommendation_text = recommendation.position_text || null;\n  }\n\n  if (recommendation.recommendation_type === 'SUPPLIER_REQUEST' || recommendation.recommendation_type === 'CUSTOMER_REQUEST') {\n    recommendation.clause_number = null;\n    recommendation.severity_code = '4_CRITICAL';\n  }\n\n  delete recommendation.recommendationtype;\n  delete recommendation.recommendationType;\n  delete recommendation.severitycode;\n  delete recommendation.severityCode;\n  delete recommendation.clausenumber;\n  delete recommendation.recommendationtext;\n  delete recommendation.positiontext;\n\n  return recommendation;\n});\n\nif (outOfPolicyRequestType) {\n  poldev.policy_recommendations.push({\n    recommendation_type: outOfPolicyRequestType,\n    severity_code: '4_CRITICAL',\n    approval: null,\n\tapproval_authority: null,\n    clause_number: null,\n    recommendation_text: 'No rule found for this change request to generate the recommandation text',\n    position_text: outOfPolicyRequestText || ''\n  });\n}\n\nconsole.log(JSON.stringify({\n  node: 'COMBINE_CR_POSITION_AND_RECOMMANDATIONS',\n  event: 'issue_result_combined',\n  issueNumber: poldev.policy_deviation.issue_number ?? null,\n  perspective,\n  rule_code: poldev.policy_deviation.rule_code ?? null,\n  has_rule_description: poldev.policy_deviation.rule_description != null && poldev.policy_deviation.rule_description !== '',\n  matched_position_code: poldev.policy_deviation.matched_position_code ?? null,\n  has_standard_position_summary: !!toText(poldev.policy_deviation.standard_position_summary),\n  has_change_request_summary: !!toText(poldev.policy_deviation.change_request_summary),\n  has_out_of_policy_request_recommendation: poldev.policy_recommendations.some((r) => ['SUPPLIER_REQUEST', 'CUSTOMER_REQUEST'].includes(normalizeCode(r?.recommendation_type))),\n  recommendationCount: Array.isArray(poldev.policy_recommendations) ? poldev.policy_recommendations.length : 0\n}));\n\nreturn poldev;",
