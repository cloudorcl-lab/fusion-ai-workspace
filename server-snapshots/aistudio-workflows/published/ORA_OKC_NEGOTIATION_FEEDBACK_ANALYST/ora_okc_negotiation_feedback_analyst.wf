                    "y": 9053
                  },
                  "outcomes": {
                    "success": "1778486432909"
                  },
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "id": "1778486432909",
                  "code": "GET_POLICY_RULES_BY_CLAUSE_NAME",
                  "type": "CODE",
                  "metadata": {
                    "description": "Returns the array of rules by clause name",
                    "name": "Get Policy rules by Clause Name",
                    "errorNodeId": "1777879914368",
                    "returnType": "array",
                    "sourceCode": "const policyRowsRaw = $context.$nodes.GET_DEVIATION_POLICY_RULES?.$output?.result || [];\nconst currentRow = $context.$nodes.EXPAND_ISSUES_TO_SUB_ISSUES.PREPARE_SPLIT_CONTEXT?.$output?.result || {};\n\nconst toText = (v) => (v == null ? '' : String(v).trim());\n\nconst issueNorm = toText(currentRow.clause_name);\nconst policyRows = Array.isArray(policyRowsRaw) ? policyRowsRaw : [];\n\nlet filtered = [];\nif (issueNorm) {\n  filtered = policyRows.filter((r) => {\n    const ruleTitle = toText(r?.clause_title || r?.doc_clause_title || r?.clause_name);\n    return ruleTitle === issueNorm;\n  });\n}\n\nreturn filtered;"
                  },
                  "diagram": {
                    "x": 5276,
                    "y": 9275
                  },
                  "outcomes": {
                    "success": "1778000000003"
                  },
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "id": "1778000000003",
                  "code": "SPLIT_CHANGE_REQUEST_INTO_SUB_ISSUES",
                  "type": "LLM",
                  "metadata": {
                    "name": "Split Change Request Into Sub Issues",
                    "description": "Splits a single change request into atomic policy-comparable sub-issues.",
                    "modelConfiguration": {
                      "code": "ORA_MODEL_CONFIG_PREMIUM_OPEN_AI_GPT_4_1_MINI",
                      "modelName": "Gpt-5 Mini",
                      "provider": "CERT_PREMIUM",
                      "model": "OCI_GPT_5_MINI",
                      "modelProperties": {
                        "k": 0,
                        "max_completion_tokens": 32000,
                        "reasoning_effort": "medium"
                      }
                    },
                    "errorNodeId": "1777879914368"
                  },
                  "diagram": {
                    "x": 5253.5,
                    "y": 9497
                  },
                  "outcomes": {
                    "success": "1778000000004"
                  },
                  "inputs": [
                    {
                      "id": "1778000000003_prompt",
                      "name": "prompt",
                      "type": "string",
                      "value": "You are a strict contract change-request splitter for policy evaluation.\n\nGOAL\nSplit ONE change request into sub-issues so each sub-issue can be evaluated against ONE policy rule/dimension.\nIf multiple policy-rule dimensions are truly implicated, create multiple sub-issues.\nIf no meaningful policy-based split is possible, return exactly one sub-issue (the original request text).\n\nINPUTS\n1) Change Request Text:\n{{$context.$nodes.EXPAND_ISSUES_TO_SUB_ISSUES.PREPARE_SPLIT_CONTEXT.$output.result}}\n\n2) Clause-Title Matched Policy Rules JSON (already filtered to relevant clause title):\n{{$context.$nodes.EXPAND_ISSUES_TO_SUB_ISSUES.GET_POLICY_RULES_BY_CLAUSE_NAME.$output.result}}\n\nSPLITTING LOGIC\n- Split by policy-evaluable dimensions, not by sentence grammar.\n- A sub-issue must represent exactly one negotiable ask that can map to one rule intent/dimension.\n- Preserve exact legal meaning; do not materially rewrite.\n- Do not invent asks.\n- Remove duplicates and heavy overlaps.\n- Do not infer implicit asks.\n- Create a new sub-issue only if the request explicitly contains another independent change.\n- If the request has one explicit obligation/position only, return exactly one sub-issue.\n- DO NOT split into 2 sub-issues that point to the same primary rule.\n\nRULE-CARDINALITY GATE (MANDATORY)\n- Split into multiple sub_issues ONLY when BOTH are true:\n  1) The change request contains 2+ explicit independent asks, AND\n  2) Those asks map to 2+ DISTINCT rule_code values from matched policy rules.\n- If asks map to the same rule_code (or same rule intent), return ONE sub_issue only.\n- If no clear split is supported by matched rules, output one sub-issue equal to full request.\n- If uncertain whether asks map to distinct rules, prefer ONE sub-issue.\n\nCOMPOSITE-ASK HANDLING (MANDATORY)\n- Treat one legal position expressed with multiple components as ONE sub-issue.\n- Never split components like trigger + duration, condition + threshold, scope + cap, timing + amount when they belong to the same rule intent.\n- Example that MUST remain ONE sub-issue:\n  \"The trial period begins upon successful installation and continues for forty (40) days.\"\n  Do not split into start-condition and duration if both map to the same trial-period rule.\n\nANTI-OVER-SPLIT RULES\n- Do not split just because of conjunctions (\"and\", \"or\"), commas, semicolons, or multi-clause sentence structure.\n- Do not split unless each resulting sub-issue has a different primary rule_code.\n- If two fragments would share the same primary rule_code, merge them into one sub-issue.\n\nMAPPING GUIDANCE\n- For each sub-issue, include likely candidate rule codes from matched-rules JSON.\n- candidate_rule_codes[0] must be the best primary rule_code for that sub-issue.\n- Across multiple sub-issues, primary rule codes must be different.\n- If uncertain, include best-effort candidates and lower confidence.\n\nOUTPUT FORMAT (JSON ONLY)\n{\n  \"sub_issues\": [\n    {\n      \"sub_issue_text\": \"<atomic ask text>\",\n      \"dimension_type\": \"<e.g., LD_WEEKLY_RATE | LD_MAX_CAP | PAYMENT_TERM | LIABILITY_CAP | TRIAL_PERIOD | OTHER>\",\n      \"candidate_rule_codes\": [\"<rule_code1>\", \"<rule_code2>\"],\n      \"confidence\": <0.0 to 1.0>\n    }\n  ],\n  \"unsplittable\": <true|false>,\n  \"split_reason\": \"<short reason>\"\n}\n\nSTRICT RULES\n- Return valid JSON only. No markdown, no prose.\n- Must output at least one sub_issue.\n- Output multiple sub_issues if and only if there are multiple explicit independent asks mapping to distinct rule_code values.\n- Otherwise output exactly one sub_issue.\n- If exactly one sub_issue is returned, set unsplittable=true unless the request was split-and-merged by deduplication."
                    },
                    {
                      "id": "1778000000003_systemPrompt",
                      "name": "systemPrompt",
                      "type": "string",
                      "value": ""
                    }
                  ],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"sub_issues\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"properties\": {\n          \"sub_issue_text\": { \"type\": \"string\", \"minLength\": 1 },\n          \"dimension_type\": { \"type\": \"string\", \"minLength\": 1 },\n          \"candidate_rule_codes\": {\n            \"type\": \"array\",\n            \"minItems\": 1,\n            \"items\": { \"type\": \"string\", \"minLength\": 1 }\n          },\n          \"confidence\": { \"type\": \"number\", \"minimum\": 0, \"maximum\": 1 },\n          \"topic_hint\": { \"type\": \"string\" }\n        },\n        \"required\": [\n          \"sub_issue_text\",\n          \"dimension_type\",\n          \"candidate_rule_codes\",\n          \"confidence\"\n        ]\n      }\n    },\n    \"unsplittable\": { \"type\": \"boolean\" },\n    \"split_reason\": { \"type\": \"string\", \"minLength\": 1 }\n  },\n  \"required\": [\"sub_issues\", \"unsplittable\", \"split_reason\"]\n}"
                },
                {
                  "id": "1778000000004",
                  "code": "NORMALIZE_SUB_ISSUES",
                  "type": "CODE",
                  "metadata": {
                    "name": "Normalize Sub Issues",
                    "description": "Normalizes and deduplicates split output, then expands one parent issue row into N sub-issue rows.",
                    "returnType": "array",
                    "sourceCode": "const ctx = $context.$nodes.PREPARE_SPLIT_CONTEXT.$output?.result || {};\nconst row = ctx.original_row || {};\nconst split = $context.$nodes.SPLIT_CHANGE_REQUEST_INTO_SUB_ISSUES.$output || {};\n\nconst toText = (v) => (v == null ? '' : v.toString().trim());\nconst toNum = (v) => {\n  const n = Number(v);\n  return Number.isFinite(n) ? n : null;\n};\n\nconst norm = (v) => toText(v)\n  .toLowerCase()\n  .replace(/change\\s+to\\s+read\\s*:/g, '')\n  .replace(/[^a-z0-9]+/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst parentIssueId = toText(ctx.parent_issue_id || row.id || row.issue_id || row.issue_number || '');\nconst baseText = toText(ctx.active_change_request_text);\n\nlet candidates = [];\nif (Array.isArray(split?.sub_issues)) {\n  candidates = split.sub_issues\n    .map((s) => ({\n      sub_issue_text: toText(s?.sub_issue_text),\n      dimension_type: toText(s?.dimension_type || s?.topic_hint || ''),\n      candidate_rule_codes: Array.isArray(s?.candidate_rule_codes)\n        ? s.candidate_rule_codes.map((r) => toText(r)).filter(Boolean)\n        : [],\n      confidence: toNum(s?.confidence)\n    }))\n    .filter((s) => s.sub_issue_text);\n}\n\nif (candidates.length === 0 && baseText) {\n  candidates = [{\n    sub_issue_text: baseText,\n    dimension_type: '',\n    candidate_rule_codes: [],\n    confidence: null\n  }];\n}\n\n// Lightweight dedupe only (do not re-judge split quality)\nconst seen = new Set();\nconst normalized = [];\nfor (const c of candidates) {\n  const text = toText(c.sub_issue_text);\n  if (!text) continue;\n\n  // Keep distinct rule-mapped asks even if wording is similar.\n  const primaryRule = toText(c.candidate_rule_codes?.[0] || '');\n  const key = `${primaryRule}::${norm(text)}`;\n\n  if (seen.has(key)) continue;\n  seen.add(key);\n  normalized.push(c);\n}\n\nif (normalized.length === 0) {\n  normalized.push({\n    sub_issue_text: baseText || toText(row.reason) || '',\n    dimension_type: '',\n    candidate_rule_codes: [],\n    confidence: null\n  });\n}\n\nreturn normalized\n  .filter((s) => toText(s.sub_issue_text))\n  .map((s, idx) => ({\n    ...row,\n    id: row.id ?? row.issue_id ?? row.issue_number ?? parentIssueId,\n    parent_issue_id: parentIssueId,\n    sub_issue_seq: idx + 1,\n    sub_issue_key: `${parentIssueId || 'issue'}#${idx + 1}`,\n    sub_issue_text: toText(s.sub_issue_text),\n    active_change_request_override: toText(s.sub_issue_text),\n\n    // pass-through splitter metadata for downstream traceability\n    split_dimension_type: toText(s.dimension_type),\n    split_candidate_rule_codes: Array.isArray(s.candidate_rule_codes) ? s.candidate_rule_codes : [],\n    split_confidence: s.confidence\n  }));",
                    "errorNodeId": "1777879914368"
                  },
                  "diagram": {
