                    }
                  ]
                },
                {
                  "id": "1775609991001",
                  "code": "SELECT_ACTIVE_CHANGE_REQUEST_BASE",
                  "type": "CODE",
                  "metadata": {
                    "name": "Select Active Change Request",
                    "returnType": "object",
                    "description": "Selects the latest counterparty change request text based on contract perspective and negotiation rounds.",
                    "sourceCode": "const row = $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.$currentItem || {};\nconst perspective = (($context.$nodes.EXTRACT_CONTRACT_METADATA_ATTRIBUTES_VALUES?.$output?.result?.Perspective) || '').toString().toUpperCase();\n\nconst toText = (v) => (v == null ? '' : v.toString().trim());\nconst asRound = (key) => {\n  const m = key.match(/(\\d+)/);\n  return m ? Number(m[1]) : 0;\n};\n\nlet latestSupplier = '';\nlet latestSupplierRound = -1;\nlet latestBuyer = '';\nlet latestBuyerRound = -1;\n\nconst assignCandidate = (side, text, round) => {\n  const val = toText(text);\n  if (!val) return;\n  if (side === 'SUPPLIER' && round >= latestSupplierRound) {\n    latestSupplier = val;\n    latestSupplierRound = round;\n  }\n  if (side === 'BUYER' && round >= latestBuyerRound) {\n    latestBuyer = val;\n    latestBuyerRound = round;\n  }\n};\n\nif (Array.isArray(row.round_messages)) {\n  for (const entry of row.round_messages) {\n    const round = Number(entry?.round ?? 0);\n    assignCandidate('SUPPLIER', entry?.supplier_message, round);\n    assignCandidate('BUYER', entry?.buyer_message, round);\n  }\n}\n\nif (Array.isArray(row.supplier_messages)) {\n  row.supplier_messages.forEach((m, idx) => assignCandidate('SUPPLIER', m, idx + 1));\n}\n\nif (Array.isArray(row.buyer_messages)) {\n  row.buyer_messages.forEach((m, idx) => assignCandidate('BUYER', m, idx + 1));\n}\n\nfor (const [rawKey, rawVal] of Object.entries(row)) {\n  const key = rawKey.toLowerCase();\n  const round = asRound(key);\n  const isSupplier = key.includes('supplier');\n  const isBuyer = key.includes('buyer') || key.includes('company');\n\n  if (isSupplier) assignCandidate('SUPPLIER', rawVal, round);\n  if (isBuyer) assignCandidate('BUYER', rawVal, round);\n}\n\nif (!latestSupplier) {\n  assignCandidate('SUPPLIER', row.latest_supplier_message, 9000);\n}\nif (!latestBuyer) {\n  assignCandidate('BUYER', row.latest_buyer_message, 9000);\n}\nif (!latestSupplier) {\n  assignCandidate('SUPPLIER', row.supplier_message, 8000);\n}\nif (!latestBuyer) {\n  assignCandidate('BUYER', row.buyer_message, 8000);\n}\n\nconst genericChangeRequestFromRow = (() => {\n  const direct = [\n    row.change_request,\n    row.change_request_text,\n    row.requested_change,\n    row.requested_change_text,\n    row.proposed_change,\n    row.proposed_clause,\n    row.counterparty_change_request,\n    row.message,\n    row.comment,\n    row.remarks\n  ].map(toText).find(Boolean);\n  if (direct) return direct;\n\n  let best = '';\n  for (const [k, v] of Object.entries(row)) {\n    const key = (k || '').toString().toLowerCase();\n    const val = toText(v);\n    if (!val) continue;\n    const looksLikeChangeRequest = key.includes('change request') || key.includes('change_request') || key.includes('requested change') || key.includes('proposed');\n    const notReasonOnly = !(key === 'reason' || key.includes('justification'));\n    if (looksLikeChangeRequest && notReasonOnly && val.length > best.length) {\n      best = val;\n    }\n  }\n  return best;\n})();\n\nconst preferredSide = perspective === 'SUPPLIER' ? 'BUYER' : 'SUPPLIER';\nlet activeText = preferredSide === 'SUPPLIER'\n  ? (latestSupplier || latestBuyer || '')\n  : (latestBuyer || latestSupplier || '');\n\nif (!toText(activeText)) {\n  activeText = genericChangeRequestFromRow || toText(row.reason) || '';\n}\n\nconst result = {\n  active_change_request_text: activeText,\n  active_request_side: preferredSide,\n  latest_supplier_change_request: latestSupplier,\n  latest_buyer_change_request: latestBuyer\n};\n\nconsole.log(JSON.stringify({\n  node: 'SELECT_ACTIVE_CHANGE_REQUEST',\n  event: 'active_change_request_selected',\n  issueNumber: row.id ?? row.issue_id ?? row.issue_number ?? null,\n  perspective,\n  active_request_side: preferredSide,\n  has_active_text: !!activeText,\n  used_generic_fallback: !latestSupplier && !latestBuyer && !!activeText,\n  latest_supplier_round: latestSupplierRound,\n  latest_buyer_round: latestBuyerRound\n}));\n\nreturn result;",
                    "errorNodeId": "1777879914368"
                  },
                  "diagram": {
                    "x": 5289.5,
                    "y": 12047
                  },
                  "outcomes": {
                    "success": "1778000000006"
                  },
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "id": "1778000000006",
                  "code": "SELECT_ACTIVE_CHANGE_REQUEST",
                  "type": "CODE",
                  "metadata": {
                    "name": "Resolve Active Change Request",
                    "description": "Overrides active change request with sub-issue text when available.",
                    "returnType": "object",
                    "sourceCode": "const row = $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.$currentItem || {};\nconst selected = $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.SELECT_ACTIVE_CHANGE_REQUEST_BASE.$output?.result || {};\n\nconst toText = (v) => (v == null ? '' : v.toString().trim());\nconst override = toText(row.active_change_request_override || row.sub_issue_text);\nconst activeText = override || toText(selected.active_change_request_text);\n\nconst result = {\n  ...selected,\n  active_change_request_text: activeText,\n  latest_supplier_change_request: override ? activeText : toText(selected.latest_supplier_change_request),\n  latest_buyer_change_request: override ? activeText : toText(selected.latest_buyer_change_request)\n};\n\nreturn result;",
                    "errorNodeId": "1777879914368"
                  },
                  "diagram": {
                    "x": 5285,
                    "y": 12269
                  },
                  "outcomes": {
                    "success": "1777001000001"
                  },
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "id": "1777001000001",
                  "code": "DETECT_CLAUSE_CHANGE_REQUEST_INTENT",
                  "type": "LLM",
                  "metadata": {
                    "name": "Detect Clause Change Request Intent",
                    "description": "Classifies whether the active change request is add clause, delete clause, or modify clause.",
                    "modelConfiguration": {
                      "code": "ORA_MODEL_CONFIG_PREMIUM_OPEN_AI_GPT_4_1_MINI",
                      "modelName": "Gpt-5 Mini",
                      "provider": "CERT_PREMIUM",
                      "model": "OCI_GPT_5_MINI",
                      "modelProperties": {
                        "k": 0,
                        "max_completion_tokens": 32000,
                        "reasoning_effort": "low"
                      }
                    },
                    "errorNodeId": "1777879914368"
                  },
                  "diagram": {
                    "x": 5258,
                    "y": 12491
                  },
                  "outcomes": {
                    "success": "1777001000002"
                  },
                  "inputs": [
                    {
                      "id": "1777001000001_prompt",
                      "name": "prompt",
                      "type": "string",
                      "value": "You are a strict classifier for contract negotiation change request intent.\n\nINPUT JSON ROW:\n{{$context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.$currentItem}}\n\nAUTHORITATIVE ACTIVE CHANGE REQUEST TEXT:\n{{$context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.SELECT_ACTIVE_CHANGE_REQUEST.$output.result.active_change_request_text}}\n\nTASK\nClassify the active change request into exactly one intent_type:\n- ADD_CLAUSE\n- DELETE_CLAUSE\n- MODIFY\n- UNKNOWN\n\nCLASSIFICATION POLICY (HARD RULES)\n\t\t\t\t\t\t\t\t\t\t\t  \n\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t  \n\n1) ADD_CLAUSE\nClassify as ADD_CLAUSE ONLY when the request explicitly asks to add/insert/include/create a new clause.\nExamples of explicit signals:\n- \"add clause\"\n- \"insert a new clause\"\n- \"introduce a new clause\"\n\n2) DELETE_CLAUSE\nClassify as DELETE_CLAUSE ONLY when the request explicitly asks to delete/remove/strike an existing clause/section/provision entirely.\nExamples of explicit signals:\n- \"delete clause\"\n- \"remove this clause\"\n- \"drop clause\"\n\n3) MODIFY\nClassify as MODIFY for all other requests that change wording, scope, rights, obligations, liabilities, remedies, caps, limits, timelines, percentages, conditions, or any extra addition within the current clause text.\nIMPORTANT:\n- Even if user asks to add extra sentence/content inside current clause, classify as MODIFY.\n- Do NOT classify semantic additions inside existing clause as ADD_CLAUSE.\n- Do NOT infer ADD_CLAUSE/DELETE_CLAUSE unless explicitly requested.\n\n4) UNKNOWN\nUse UNKNOWN only if request text is missing, unintelligible, or cannot be reliably interpreted.\n\nDECISION ORDER (MANDATORY)\n- First check explicit ADD_CLAUSE signals.\n- Else check explicit DELETE_CLAUSE signals.\n- Else if meaningful edit exists, return MODIFY.\n- Else return UNKNOWN.\n\nCONFIDENCE\n- Return confidence between 0 and 1.\n- High confidence only when explicit signals are present.\n- For MODIFY-default cases without explicit add/delete terms, use moderate-high confidence.\n\nSTRICT OUTPUT\nReturn JSON object only:\n{\n  \"intent_type\": \"<ADD_CLAUSE|DELETE_CLAUSE|MODIFY|UNKNOWN>\",\n  \"confidence\": <number 0 to 1>\n}"
                    },
                    {
                      "id": "1777001000001_systemPrompt",
                      "name": "systemPrompt",
                      "type": "string",
                      "value": ""
                    }
                  ],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"intent_type\": { \"type\": \"string\" },\n    \"confidence\": { \"type\": \"number\" }\n  },\n  \"required\": [\"intent_type\"]\n}"
                },
                {
                  "id": "1777001000002",
                  "code": "BUILD_CLAUSE_CHANGE_REQUEST_GATE",
                  "type": "CODE",
                  "metadata": {
                    "name": "Build Clause Change Request Gate",
                    "returnType": "object",
                    "description": "Builds support gate from classified intent; ADD/DELETE clause requests are unsupported.",
                    "sourceCode": "const classification = $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.DETECT_CLAUSE_CHANGE_REQUEST_INTENT.$output || {};\nconst active = $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.SELECT_ACTIVE_CHANGE_REQUEST.$output?.result || {};\nconst row = $context.$nodes.FOR_EACH_ISSUE_IN_NEGOTIATIONS_DOC.$currentItem || {};\n\nconst toText = (v) => (v == null ? '' : v.toString().trim());\nconst normalizedIntent = toText(classification.intent_type).toUpperCase();\nconst intentType = ['ADD_CLAUSE', 'DELETE_CLAUSE', 'MODIFY', 'UNKNOWN'].includes(normalizedIntent)\n  ? normalizedIntent\n  : 'UNKNOWN';\n\nconst isSupported = !(intentType === 'ADD_CLAUSE' || intentType === 'DELETE_CLAUSE');\n\nconst result = {\n  intent_type: intentType,\n  is_supported_change_request: isSupported,\n  confidence: Number(classification.confidence ?? 0),\n  active_change_request_text: toText(active.active_change_request_text),\n  issue_id: row.id ?? row.issue_id ?? row.issue_number ?? null,\n  clause_name: toText(row.clause_name || row.clause_title || row.issue_clause_title || row.doc_clause_title || 'Unknown')\n};\n\nreturn result;",
                    "errorNodeId": "1777879914368"
                  },
                  "diagram": {
                    "x": 5271.5,
                    "y": 12713
                  },
                  "outcomes": {
                    "success": "1775366702460"
                  },
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "id": "1775366702460",
                  "code": "FOR_EACH_POLICY_IN_POLICY_JSON",
                  "type": "LOOP",
                  "metadata": {
                    "name": "For Each Policy in Policy JSON",
                    "description": "Loops through policy rules to evaluate and collect matches for the current negotiation issue.",
                    "dataPipeline": {
                      "rootNode": "start_1775366702460",
                      "pipelineNodes": [
                        {
                          "id": "start_1775366702460",
                          "code": "START",
                          "type": "START",
                          "metadata": {
                            "description": "Start of data pipeline",
