                {
                  "id": "1776504716881",
                  "code": "GET_CLAUSE_TEXT_USING_CLAUSE_TITLE",
                  "type": "BO_FUNCTION",
                  "metadata": {
                    "description": "Gets the clause text using clause title from a contract",
                    "name": "Get Clause Text using Clause Title",
                    "businessObjectCode": "ORA_CX_CONTRACTS_CONTRACTTERMSLIBRARY",
                    "functionName": "getClauseTextByClauseTitleFromContract",
                    "errorNodeId": "1777879914368"
                  },
                  "diagram": {
                    "x": 5262.5,
                    "y": 7001
                  },
                  "outcomes": {
                    "success": "1776505091971"
                  },
                  "inputs": [
                    {
                      "id": "1776504716881_UniqContractId",
                      "name": "UniqContractId",
                      "value": "{{$context.$variables.contractId}}",
                      "required": false,
                      "type": "string"
                    },
                    {
                      "id": "1776504716881_ArticleTitle",
                      "name": "ArticleTitle",
                      "value": "{{$context.$nodes.LOOP_OVER_CLAUSE_TITLES.$currentItem}}",
                      "required": false,
