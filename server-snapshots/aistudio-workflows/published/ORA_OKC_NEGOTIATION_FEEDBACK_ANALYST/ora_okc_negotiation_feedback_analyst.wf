                  "type": "CODE",
                  "metadata": {
                    "name": "Map Clause Number To Article Text",
                    "returnType": "object",
                    "sourceCode": "let result = {};\ntry {\n  // Safely access the output of FETCH_CLAUSE_TEXT from LOOP_OVER_UNIQUE_CLAUSE_NUMBERS node\n  const fetchClauseTextOut = $context.$nodes?.FETCH_CLAUSE_TEXT?.$output;\n  const currentItem = $context.$nodes?.LOOP_OVER_UNIQUE_CLAUSE_NUMBERS?.$currentItem;\n\n  // Validate that fetchClauseTextOut and currentItem exist and items array is not empty\n  if (fetchClauseTextOut?.items && fetchClauseTextOut.items.length > 0 && currentItem !== undefined) {\n    // Map current item to the ArticleText of the first item in fetchClauseTextOut.items\n    result = { [currentItem]: fetchClauseTextOut.items[0].ArticleText };\n  } else {\n    // Return empty object if data is missing\n    result = {};\n  }\n} catch (error) {\n  // On error, return empty object\n  result = {};\n}\n\nreturn result;",
                    "description": "Creates map of clause number and clause text",
