            "returnType": "object",
            "description": "Builds batch payload to mark the contract eligible for risk scoring.",
            "sourceCode": "const payload = {\n  id: \"part1\",\n  operation: \"upsert\",\n  path: \"/contracts\",\n  payload: {\n    ContractId: $context.$variables.contractId,\n    EligibleForRiskScoringYn: \"Y\"\n  }\n};\n\nconst payloadArray = [];\npayloadArray.push(payload);\nreturn payloadArray;",
