        {
          "id": "1776076183841",
          "code": "RETURN_GROUPED_OUTPUT",
          "type": "CODE",
          "metadata": {
            "name": "Return Grouped Output",
            "returnType": "object",
            "description": "Assembles workflow response with feedback results, upsert status, and risk-scoring workflow outcome.",
            "sourceCode": "const startedAt = Date.now();\nconst contractId = $context.$variables.contractId || null;\nconst groupedResult = $context.$nodes.NORMALIZE_OUT_OF_POLICY_CLOSEST_MATCH_SEVERITY.$output.result || [];\nconst upsertStatus = $context.$nodes.UPSERT_DEVIATING_CLAUSES.$output?.result || 'unknown';\nconst riskScoringAgentOutcome = $context.$nodes.INVOKE_RISK_SCORING_AGENT_WORKFLOW.$output\n\nconst result = {\n  contract_id: contractId,\n  upsert_status: upsertStatus,\n  feedback_agent: groupedResult,\n  risk_scoring_agent: riskScoringAgentOutcome  \n};\n\nreturn result;\n",
            "errorNodeId": "1777879914368"
          },
