        {
          "id": "1775306922637",
          "code": "NEGOTIATION_JSON_DATA",
          "type": "LLM",
          "metadata": {
            "description": "Converts Negotiation feed back spread sheet to JSON data",
            "name": "Negotiation JSON Data",
            "modelConfiguration": {
              "code": "ORA_MODEL_CONFIG_PREMIUM_OPEN_AI_GPT_4_1_MINI",
              "modelName": "Gpt-5 Mini",
              "provider": "CERT_PREMIUM",
