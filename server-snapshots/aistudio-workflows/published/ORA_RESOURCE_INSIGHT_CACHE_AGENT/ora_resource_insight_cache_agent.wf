        {
          "metadata": {
            "name": "validateCacheDate",
            "returnType": "string",
            "sourceCode": "const cacheDateTime = $context.$nodes.GETINSIGHTSCACHE.$output?.items?.[0]?.lastProcessedTime;\n\nconst maxDays = $context.$triggers.REST.$input.action?.config?.maxAgeDays;\n\nlet isValidCache = false;\n\nif (cacheDateTime && maxDays !== undefined) {\n    const cacheTime = new Date(cacheDateTime).getTime();\n    const now = Date.now();\n\n    const ageInDays = (now - cacheTime) / (1000 * 60 * 60 * 24);\n\n    isValidCache = ageInDays <= maxDays;\n}\n\nreturn isValidCache;"
          },
          "outcomes": {
            "success": "1773085376992"
          },
          "code": "VALIDATECACHEDATE",
          "id": "1773085025166",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
