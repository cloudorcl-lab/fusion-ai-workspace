          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"description\": \"\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"OrganizationId\",\n          \"ItemId\",\n          \"ItemClassId\",\n          \"OrganizationCode\",\n          \"ItemClass\",\n          \"ItemNumber\",\n          \"ItemDescription\",\n          \"PrimaryUOMCode\",\n          \"InventoryItemStatusCode\",\n          \"CurrentPhaseCode\",\n          \"ItemType\",\n          \"ApprovalStatus\",\n          \"ItemDefinitionOrgId\",\n          \"Keyword\",\n          \"PlanningMethodValue\",\n          \"BackToBackEnabledFlag\",\n          \"SerialNumberControlCode\",\n          \"SerialGenerationValue\",\n          \"UserItemTypeValue\",\n          \"ItemStatusValue\",\n          \"AssetTrackedFlag\",\n          \"RequestId\",\n          \"CreationDate\",\n          \"CreatedBy\",\n          \"LastUpdateDate\",\n          \"LastUpdatedBy\",\n          \"LotControlCode\",\n          \"AutoCreatedConfigurationFlag\",\n          \"CustomerOrderEnabledFlag\",\n          \"CustomerOrderFlag\",\n          \"EffectivityControl\",\n          \"InternallyTransferableFlag\",\n          \"PickComponentsFlag\",\n          \"RevisionQuantityControlFlag\",\n          \"ServiceableProductFlag\",\n          \"ShippableFlag\",\n          \"StockEnabledFlag\",\n          \"TransactionEnabledFlag\",\n          \"TransferOrdersEnabledFlag\",\n          \"AssembleToOrderFlag\",\n          \"RestrictSubinventoriesFlag\",\n          \"MaterialTransactionEnabledFlag\",\n          \"BOMItemType\",\n          \"ChildLotEnabledFlag\",\n          \"CycleCountEnabledFlag\",\n          \"GradeControlledFlag\",\n          \"InventoryItemFlag\",\n          \"StockLocatorControl\",\n          \"RestrictLocatorsFlag\",\n          