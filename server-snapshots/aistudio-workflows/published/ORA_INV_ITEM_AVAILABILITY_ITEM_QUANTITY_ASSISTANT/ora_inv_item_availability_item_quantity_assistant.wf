            "name": "ExtractOraAppContext",
            "returnType": "object",
            "sourceCode": "let oraAppContext;\nlet obj;\n\nif ($context.$app && $context.$app.$OraAppContext) {\n  oraAppContext = $context.$app.$OraAppContext;\n} else {\n  let inputStr = $context.$triggers.REST.$input?.Dummy;\n\n  let inputObj =\n    typeof inputStr === \"string\" &&\n    inputStr.trim() !== \"\"\n      ? JSON.parse(inputStr)\n      : inputStr || {};\n\n  oraAppContext = inputObj?.[\"$OraAppContext\"] ?? null;\n}\n\n// Parse oraAppContext if it exists\nif (\n  oraAppContext &&\n  typeof oraAppContext === \"string\" &&\n  oraAppContext.trim() !== \"\"\n) {\n  obj = JSON.parse(oraAppContext);\n} else if (typeof oraAppContext === \"object\") {\n  obj = oraAppContext;\n}\n\nreturn obj;"
          },
          "outcomes": {
            "success": "1779782523685"
          },
