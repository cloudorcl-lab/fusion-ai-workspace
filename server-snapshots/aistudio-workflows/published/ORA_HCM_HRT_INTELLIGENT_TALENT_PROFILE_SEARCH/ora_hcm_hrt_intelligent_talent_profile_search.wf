          "metadata": {
            "errorNodeId": "1770903985469",
            "name": "List PersonIds",
            "returnType": "array",
            "sourceCode": "// Your input variable\nconst inputData = $context.$nodes.FOR_EACH_SEARCH_COMBINATION.$output;\nconst personIds = [];\n\n// Loop through each JSON string in the main array\nfor (const jsonString of inputData) {\n  // Convert the string into a JavaScript object\n  const parsedData = JSON.parse(jsonString);\n  \n  // Access the 'results' array inside the object\n  const results = parsedData.results;\n  \n  // Loop through each result object to find the personId in metadata\n  for (const item of results) {\n    const id = item.metadata.personId;\n    \n    // Add to result array if it exists\n    if (id) {\n      personIds.push(id);\n    }\n  }\n}\n\n// If exactly one personId was found, force-add -1 to avoid downstream issues\nif (personIds.length === 1) {\n  personIds.push(-1);\n}\n\n// Output the final array\nreturn personIds;"
          },
