{
  "workflowId": "300000331062505",
  "workflowCode": "ORA_HCM_HRT_INTELLIGENT_TALENT_PROFILE_SEARCH",
  "name": "Intelligent Talent Profile Search",
  "description": "Assists HR specialists and line managers in finding employees who match the specified criteria by combining talent profiles and assignment details with flexible queries. It can also summarize an individual employee’s talent profile and compare talent profiles side by side.",
  "specification": {
    "allowAllEmployeeAccess": true,
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
