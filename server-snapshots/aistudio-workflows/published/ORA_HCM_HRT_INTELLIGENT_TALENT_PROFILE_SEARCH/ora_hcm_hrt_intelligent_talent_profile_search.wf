        {
          "metadata": {
            "name": "Set talent person profile payload from query planner",
            "returnType": "object",
            "sourceCode": "const personId = $context.$nodes.QUERY_PLANNER.$output.personId;\n\nconst personPayload = {\n privilegeCode: \"MATCH_TALENT_PROFILE\",\n filterCriteria: {\n vectorKey: \"ORA_PERSON_TALENT_PROFILE\",\n personId: personId\n },\n query: \".\",\n answerConfiguration: {\n useHybridSearch: true,\n includeSupportingChunks: true,\n minimumSimilarityPercentage: 1\n },\n finder: \"findSemanticMatch\"\n};\n\nreturn personPayload;"
          },
          "outcomes": {
            "success": "1770902445441"
          },
          "code": "SET_TALENT_PERSON_PROFILE_PAYLOAD_FROM_QUERY_PLANNER",
          "id": "1770902408917",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_WORKERSEARCH",
            "functionName": "search_for_workers",
            "name": "Find Person"
          },
          "outcomes": {
            "success": "1770902626679"
          },
          "code": "FIND_PERSON",
          "id": "1770902528790",
          "inputs": [
            {
              "id": "1770902587993_1",
              "name": "vQuery",
              "type": "string",
              "value": "{{$context.$nodes.QUERY_PLANNER.$output.personQuery}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Prepare Talent Profile Search Combinations",
            "returnType": "array",
            "sourceCode": "const queryPlan = $context.$nodes.QUERY_PLANNER.$output || {};\nconst rawOrgs = $context.$nodes.CLEAN_UP_ORG_STRUCTURES.$output;\nconst rawLocs = $context.$nodes.CLEAN_UP_LOCATIONS.$output;\n\n/*\nORG NORMALIZATION RULES\n- resolveOrgStructureFlag !== true (handles false, null, undefined) ? ignore org dimension ? [null]\n- resolveOrgStructureFlag === true AND no orgs resolved ? hard stop ? []\n*/\nlet orgs;\nif (queryPlan.resolveOrgStructureFlag !== true) {\n    orgs = [null];\n} else {\n    if (Array.isArray(rawOrgs) && rawOrgs.length > 0) {\n        orgs = rawOrgs;\n    } else {\n        return [];\n    }\n}\n\n/*\nLOCATION NORMALIZATION RULES\n- resolveLocationFlag !== true (handles false, null, undefined) ? ignore location dimension ? [null]\n- resolveLocationFlag === true AND no locations resolved ? hard stop ? []\n*/\nlet locations;\nif (queryPlan.resolveLocationFlag !== true) {\n    locations = [null];\n} else {\n    if (Array.isArray(rawLocs) && rawLocs.length > 0) {\n        locations = rawLocs;\n    } else {\n        return [];\n    }\n}\n\nconst talentSearches = queryPlan.talentProfileSearches || [];\nconst finalPayloads = [];\n\n// Build the cross-product payloads\nfor (const org of orgs) {\n    for (const loc of locations) {\n        for (const talent of talentSearches) {\n            \n            // Base payload structure\n            const payload = {\n                finder: \"findSemanticMatch\",\n                query: talent.query,\n                privilegeCode: \"MATCH_TALENT_PROFILE\",\n                answerConfiguration: {\n                    maximumChunks: 500,\n                    minimumSimilarityPercentage: 70,\n                    includeSupportingChunks: true,\n                    useHybridSearch: false\n                },\n                filterCriteria: {\n                    vectorKey: \"ORA_PERSON_TALENT_PROFILE\"\n                }\n            };\n\n            // Content type (Safely ignores undefined/null from LLM)\n            if (talent.contentType) {\n                payload.filterCriteria.contentType = talent.contentType;\n            }\n\n            // Org filter\n            if (org && org.orgId) {\n                const { orgId, orgType } = org;\n                if (orgType === \"LE\") {\n                    payload.filterCriteria.legalEntityId = orgId;\n                } else if (orgType === \"DEP\") {\n                    payload.filterCriteria.departmentId = orgId;\n                } else if (orgType === \"BU\") {\n                    payload.filterCriteria.businessUnitId = orgId;\n                }\n            }\n\n            // Location filter\n            if (loc) {\n                payload.filterCriteria.locationId = loc;\n            }\n\n            finalPayloads.push(payload);\n        }\n    }\n}\n\nreturn finalPayloads;"
          },
          "outcomes": {
            "success": "1770903527811"
          },
          "code": "SEARCH_COMBINATIONS",
          "id": "1770903476107",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
