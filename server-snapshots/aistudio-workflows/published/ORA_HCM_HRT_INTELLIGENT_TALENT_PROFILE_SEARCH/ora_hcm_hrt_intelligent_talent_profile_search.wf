          "inputs": [
            {
              "id": "1770902458335",
              "name": "personIdPayload",
              "scope": "JOB",
              "type": "object",
              "value": "{{$context.$nodes.SET_TALENT_PERSON_PROFILE_PAYLOAD_FROM_QUERY_PLANNER.$output.result}}"
