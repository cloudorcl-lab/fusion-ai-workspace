{
  "workflowId": "100002355226947",
  "workflowCode": "ORA_FIN_AP_PAYMENT_OPTIONS_SCOPE_MONITOR",
  "name": "Payment Options Scope Monitor",
  "description": "The Payment Options Scope Monitor responds to greetings, general inquiries, acknowledgments, off-topic questions, and impolite messages with polite, professional replies.",
  "specification": {
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
