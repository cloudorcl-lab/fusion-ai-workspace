            "name": "GetDynamicFilter",
            "returnType": "object",
            "sourceCode": "const appContext=$context.$triggers.REST.$input.OraAppContext;\nconst values = appContext.split(':');\nlet [itemId,orgCode,eff] = values;\nif(!itemId && !orgCode){\nthrow new Error(\"Item or Org not found in context\");\n}\nconst filterValues = {\nitemId: `${itemId}`,\norgCode: `${orgCode}`,\nitemSearchParams:`ItemId=${itemId} and OrganizationCode='${orgCode}'&fields=BillSequenceId,OrganizationId,ItemId&onlyData=true`\n};\nreturn filterValues ;"
          },
          "outcomes": {
            "success": "1760415863350"
          },
