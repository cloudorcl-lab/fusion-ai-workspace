        {
          "metadata": {
            "errorNodeId": "1769550576668",
            "name": "CreateItemList",
            "returnType": "object",
            "sourceCode": "const orgId = $context.$nodes.GETBILLSEQID.$output.items[0].OrganizationId;\nconst items = $context.$nodes.GETALLCOMPONENTSFORITEM.$output.items;\nvar csv = \"\";\nfor (var i = 0; i < items.length; i++) {\nvar id = items[i] && items[i].ComponentItemId;\nif (!id) continue;\nif (csv.length > 0) csv += \",\";\ncsv += \"'\" + id + \"'\";\n}\n\nconst filterValues = {\nitemList: `${csv}`,\nitemSearchParams:`ItemId in  (${csv}) AND ChangeLineOrganizationId=${orgId} AND BaseChangeType in ('CR','ENG_CO') AND ChangeStatusTypeValue in ('Open' , 'Submitted', 'Draft') AND ChangePriorityValue in ('High','Medium')&fields=ChangeNotice,ChangeId,ChangeOrganizationId,BaseChangeType,ChangeTypeName,ChangeName,ChangeDescription,ChangeStatusCodeValue,ChangeStatusTypeValue,ChangeStatusType,ChangeAssignedTo,ChangeRequestedBy,ChangePriorityValue,ChangeReasonValue,ItemNumber,ItemDescription,ItemId&onlyData=true`\n};\nreturn filterValues ;"
          },
          "outcomes": {
            "success": "1760397649540"
          },
          "code": "CREATEITEMLIST",
          "convergenceTargetId": "1769552195100",
          "id": "1760567395003",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
