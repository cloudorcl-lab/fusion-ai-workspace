            {
              "id": "1760843045854_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a change management analyst. Given the following data on change requests (CRs), summarize dataset into concise on-to-two sentence executive summary. Focus on the most critical issues, overarching trends, and high level risks or recommendations.\n\nFollow Instruction: {{$context.$system.$inputMessage}}\n\nData:\n {{$context.$nodes.GETCHANGEREQUETSFORPRODUCT.$output}}"
