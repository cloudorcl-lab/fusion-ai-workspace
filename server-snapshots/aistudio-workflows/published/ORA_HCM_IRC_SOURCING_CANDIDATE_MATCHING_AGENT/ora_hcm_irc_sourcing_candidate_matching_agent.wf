        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_RECRUITING_SAJOBREQUISITION",
            "functionName": "find_jobRequisition_using_id",
            "name": "Fetch Job Requisition Details"
          },
          "outcomes": {
            "success": "1766338824906"
          },
          "code": "FETCH_JOB_REQUISITION_DETAILS",
          "id": "1766338621959",
          "inputs": [
            {
              "id": "1766338642305_1",
              "name": "job_requisition_Id",
              "type": "string",
              "value": "{{$context.$variables.JobRequisitionId}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"JobRequisition\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"RequisitionId\": { \"type\": \"number\" },\n    \"RequisitionNumber\": { \"type\": \"string\" },\n    \"Title\": { \"type\": \"string\" },\n    \"GeographyNodeId\": { \"type\": \"number\" },\n    \"PrimaryLocationName\": { \"type\": \"string\" },\n    \"LocationId\": { \"type\": \"number\" },\n    \"PrimaryWorkLocationName\": { \"type\": \"string\" },\n\n    \"HiringManagerId\": { \"type\": \"number\" },\n    \"HiringManagerAssignmentId\": { \"type\": \"number\" },\n    \"HiringManagerDisplayName\": { \"type\": \"string\" },\n\n    \"RecruiterId\": { \"type\": \"number\" },\n    \"RecruiterAssignmentId\": { \"type\": \"number\" },\n    \"RecruiterDisplayName\": { \"type\": \"string\" },\n\n    \"InternalDescription\": { \"type\": \"string\" },\n    \"InternalShortDescription\": { \"type\": \"string\" },\n    \"ExternalDescription\": { \"type\": \"string\" },\n    \"ExternalShortDescription\": { \"type\": \"string\" },\n\n    \"InternalQual\": { \"type\": [\"string\", \"null\"] },\n    \"ExternalQual\": { \"type\": [\"string\", \"null\"] },\n    \"InternalResp\": { \"type\": [\"string\", \"null\"] },\n    \"ExternalResp\": { \"type\": [\"string\", \"null\"] },\n\n    \"languages\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"items\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"LanguageId\": { \"type\": \"number\" },\n              \"RequisitionId\": { \"type\": \"number\" },\n              \"LanguageCode\": { \"type\": \"string\" },\n              \"IsBaseFlag\": { \"type\": \"boolean\" },\n              \"LanguageDescription\": { \"type\": \"string\" },\n              \"LanguageCodeISO\": { \"type\": \"string\" }\n            }\n          }\n        }\n      }\n    },\n\n    \"collaborators\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"items\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"CollaboratorId\": { \"type\": \"number\" },\n              \"CollaboratorTypeCode\": { \"type\": \"string\" },\n              \"CollaboratorTypeName\": { \"type\": \"string\" },\n              \"ObjectId\": { \"type\": \"number\" },\n              \"PersonId\": { \"type\": \"number\" },\n              \"CollaboratorName\": { \"type\": \"string\" },\n              \"AssignmentId\": { \"type\": \"number\" },\n              \"AssignmentName\": { \"type\": \"string\" }\n            }\n          }\n        }\n      }\n    },\n\n    \"secondaryLocations\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"items\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"RequisitionLocationId\": { \"type\": \"number\" },\n              \"GeographyNodeId\": { \"type\": \"number\" },\n              \"RequisitionId\": { \"type\": \"number\" },\n              \"GeographyName\": { \"type\": \"string\" }\n            }\n          }\n        }\n      }\n    },\n\n    \"secondaryWorkLocations\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"items\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"RequisitionWorkLocationId\": { \"type\": \"number\" },\n              \"LocationId\": { \"type\": \"number\" },\n              \"RequisitionId\": { \"type\": \"number\" },\n              \"LocationName\": { \"type\": \"string\" }\n            }\n          }\n        }\n      }\n    }\n  }\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Process Job Requisition Data",
            "returnType": "object",
            "sourceCode": "// Fetch requisition data\nlet data = $context.$nodes.FETCH_JOB_REQUISITION_DETAILS.$output;\n\n/* ---------------------------\n   Unified TEAM (HM + Recruiter + Collaborators)\n---------------------------- */\n\n// Hiring Manager\nlet hiringManagerObj = {\n  role: \"ORA_HIRING_MANAGER\",\n  personId: Number(data.HiringManagerId),\n  assignmentId: Number(data.HiringManagerAssignmentId),\n  displayName: data.HiringManagerDisplayName\n};\n\n// Recruiter\nlet recruiterObj = {\n  role: \"ORA_RECRUITER\",\n  personId: Number(data.RecruiterId),\n  assignmentId: Number(data.RecruiterAssignmentId),\n  displayName: data.RecruiterDisplayName\n};\n\n// Collaborators\nlet collaboratorObjs = (data.collaborators?.items || []).map(col => ({\n  role: col.CollaboratorTypeCode,\n  personId: Number(col.PersonId),\n  assignmentId: Number(col.AssignmentId),\n  displayName: col.CollaboratorName,\n  collaboratorId: Number(col.CollaboratorId),\n  collaboratorTypeCode: col.CollaboratorTypeCode,\n  collaboratorTypeName: col.CollaboratorTypeName,\n  assignmentName: col.AssignmentName\n}));\n\n// Unified team array\nlet team = [\n  hiringManagerObj,\n  recruiterObj,\n  ...collaboratorObjs\n];\n\n/* ---------------------------\n   Unified LOCATIONS (PRIMARY + SECONDARY + WORK LOCATIONS)\n---------------------------- */\n\n// PRIMARY LOCATION\nlet primaryLocationObj = {\n  type: \"PRIMARY\",\n  geographyNodeId: Number(data.GeographyNodeId),\n  locationName: data.PrimaryLocationName,\n};\n\n\n// PRIMARY WORK LOCATION\nlet primaryworkLocationObj = {\n  type: \"PRIMARY_WORK_LOCATION\",\n  workLocationId: Number(data.LocationId),\n  workLocationName: data.PrimaryWorkLocationName\n};\n\n\n// SECONDARY GEOGRAPHY LOCATIONS\nlet secondaryLocationObjs = (data.secondaryLocations?.items || []).map(loc => ({\n  type: \"SECONDARY_LOCATION\",\n  requisitionLocationId: Number(loc.RequisitionLocationId),\n  geographyNodeId: Number(loc.GeographyNodeId),\n  requisitionId: Number(loc.RequisitionId),\n  locationName: loc.GeographyName\n}));\n\n// SECONDARY WORK LOCATIONS\nlet secondaryWorkLocationObjs = (data.secondaryWorkLocations?.items || []).map(wl => ({\n  type: \"SECONDARY_WORK_LOCATION\",\n  requisitionWorkLocationId: Number(wl.RequisitionWorkLocationId),\n  workLocationId: Number(wl.LocationId),\n  requisitionId: Number(wl.RequisitionId),\n  workLocationName: wl.LocationName  // treat as work location\n}));\n\n// Unified locations array\nlet locations = [\n  primaryLocationObj,\n  primaryworkLocationObj,\n  ...secondaryLocationObjs,\n  ...secondaryWorkLocationObjs\n];\n\n/* ---------------------------\n   External-first fallback fields\n---------------------------- */\n\nlet description =\n  data.ExternalDescription != null ? data.ExternalDescription : data.InternalDescription;\n\nlet shortDescription =\n  data.ExternalShortDescription != null ? data.ExternalShortDescription : data.InternalShortDescription;\n\nlet qualifications =\n  data.ExternalQual != null ? data.ExternalQual : data.InternalQual;\n\nlet responsibilities =\n  data.ExternalResp != null ? data.ExternalResp : data.InternalResp;\n\n/* ---------------------------\n   Final Result Object\n---------------------------- */\n\nlet resultObject = {\n  requisitionId: Number(data.RequisitionId),\n  requisitionNumber: data.RequisitionNumber,\n  title: data.Title,\n\n  // Single external-first fields\n  description: description,\n  shortDescription: shortDescription,\n  qualifications: qualifications,\n  responsibilities: responsibilities,\n\n  // Unified outputs\n  team: team,\n  locations: locations,\n\n  // Languages\n  languages: data.languages?.items?.map(lang => ({\n    languageId: Number(lang.LanguageId),\n    requisitionId: Number(lang.RequisitionId),\n    languageCode: lang.LanguageCode,\n    isBaseFlag: lang.IsBaseFlag,\n    languageDescription: lang.LanguageDescription,\n    languageCodeISO: lang.LanguageCodeISO\n  })) || []\n};\n\n// Return final object\nreturn resultObject;"
          },
          "outcomes": {
            "success": "1766339050589"
          },
          "code": "PROCESS_JOB_REQUISITION_DATA",
          "id": "1766338824906",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
