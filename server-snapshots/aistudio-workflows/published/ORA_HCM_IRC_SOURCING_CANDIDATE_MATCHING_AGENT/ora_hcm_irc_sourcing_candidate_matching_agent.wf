        },
        {
          "metadata": {
            "name": "Process Applied Filters Data",
            "returnType": "object",
            "sourceCode": "let filters = $context.$nodes.FIND_MATCHING_CANDIDATES.$output.filters;\n\n// Result array\nlet result = [];\n\n// Loop through each filter\nfor (let i = 0; i < filters.length; i++) {\n  let filter = filters[i];\n\n  // Skip if values array is missing or empty\n  if (!filter.values || filter.values.length === 0) {\n    continue;\n  }\n\n  // Create an array to hold values\n  let values = [];\n\n  // Loop through values inside the filter\n  for (let j = 0; j < filter.values.length; j++) {\n    values.push(filter.values[j].displayValue);\n  }\n\n  // Add to result\n  result.push({\n    name: filter.name,\n    values: values\n  });\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1766343293845"
          },
          "code": "PROCESS_APPLIED_FILTERS_DATA",
          "id": "1766342810821",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "set Filters Applied Variable"
          },
          "outcomes": {
            "success": "1766339742801"
          },
          "code": "SET_FILTERS_APPLIED_VARIABLE",
          "id": "1766343293845",
          "inputs": [
            {
              "id": "1766343295499",
              "name": "filtersApplied",
              "type": "object",
              "value": "{{$context.$nodes.PROCESS_APPLIED_FILTERS_DATA.$output.result}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Return Workflow Result",
            "returnType": "object",
            "sourceCode": "let matchingMode = $context.$variables.MatchingMode;\nlet nlQueryApplied = $context.$variables.NaturalLanguageQuery;\n\nlet jobRequisitionId = $context.$variables.JobRequisitionId;\nlet jobRequisitionData = $context.$variables.JobRequisitionData;\n\nlet estimatedCandidateMatchCount =\n  $context.$variables.estimatedCandidateMatchCount ?? 0;\n\nlet matchedCandidates =\n  $context.$variables.matchedCandidates ?? [];\n\nlet filtersApplied =\n  $context.$variables.filtersApplied ?? [];\n\nlet isSuccess =\n  matchingMode != null &&\n  (nlQueryApplied != null || jobRequisitionId != null);\n\nlet result = {\n  status: isSuccess ? \"SUCCESS\" : \"FAILURE\",\n  matchingMode,\n  nlQueryApplied,\n  estimatedCandidateMatchCount,\n  matchedCandidates,\n  filtersApplied,\n  jobRequisitionId,\n  jobRequisitionData\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "RETURN_WORKFLOW_RESULT",
          "id": "1766343433440",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
      ],
      "rootNode": "start",
      "variables": [
        {
          "id": "1766342030222",
