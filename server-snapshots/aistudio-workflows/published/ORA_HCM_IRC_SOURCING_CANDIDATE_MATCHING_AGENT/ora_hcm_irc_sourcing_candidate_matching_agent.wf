          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"OraCandidateSearchResponse\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"summary\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"totalCount\": { \"type\": \"number\" }\n      }\n    },\n    \"filters\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": { \"type\": \"string\" },\n          \"values\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"displayValue\": { \"type\": \"string\" },\n                \"value\": { \"type\": \"string\" },\n                \"count\": { \"type\": \"number\" }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"results\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"PersonId\": { \"type\": \"number\" },\n          \"CandidateNumber\": { \"type\": \"string\" }\n        }\n      }\n    },\n    \"savedSearchInfo\": { \"type\": \"object\" }\n  }\n}",
