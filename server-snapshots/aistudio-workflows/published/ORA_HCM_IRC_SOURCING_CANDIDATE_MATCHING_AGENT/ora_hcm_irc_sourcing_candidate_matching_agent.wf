        {
          "metadata": {
            "name": "Derive Matching Intent Using Job Requisition"
          },
          "outcomes": {
            "success": "1766339470495"
          },
          "code": "DERIVE_MATCHING_INTENT_USING_JOB_REQUISITION",
          "id": "1766339228416",
          "inputs": [
            {
              "id": "1766339228421_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an agent who is going to convert Job requisition Input data to a Matching intent to find candidates\n\nUse following Input Data: \n {{$context.$variables.JobRequisitionData}} \n\n\nGenerate a one-sentence description of the type of candidate we are looking for, formatted as a structured candidate search string:\n\n1) Attributes allowed: Location, Job Title, Skills, Employer, Degree, Major, Licenses and Certifications, CandidateType, Radius but doesn't have to use all of them\n2) Must appear in that order\n3) Provide a maximum of 7 values per attribute.\n4) Expand with synonyms where helpful\n5) Only specific values, no phrases/sentences\n6) Max length: 450 characters\n7) Values for CandidateType are fixed to \"External\",\"Ex-Employee\",\"Ex-Contingent\" only\n8) Values for Radius is fixed to \"100 Miles\" only\n9) The output has to be a string and cannot be null\n\nExample: \nLocation: [\"value1\", \"value 2\"] ;  Job Title: [\"value1\", \"value2\"]; Skills: [\"value1\", \"value2\"]; Employer: [\"value1\", \"value2\"]; Degree: [\"value1\", \"value2\"]; Major: [\"value1\", \"value2\"]; Licenses and Certifications: [\"value1\", \"value2\"]; CandidateType:[\"External\",\"Ex-Employee\",\"Ex-Contingent\"]; Radius: [\"100 Miles\"]"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"MatchingIntent\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
