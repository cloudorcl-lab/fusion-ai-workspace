        {
          "metadata": {
            "name": "NormalizeCategoryBuyerBreakdown",
            "returnType": "array",
            "sourceCode": "const responsePayload = $context.$nodes.GETBUYERBREAKDOWNBYCATEGORY.$output;\n\nconst aggs = responsePayload?.aggregations ?? {};\n\nconst getBuyerName = (bucket) =>\n  bucket?.buyer_label?.hits?.hits?.[0]?._source?.buyer?.name ?? null;\n\nconst overallByBuyerBuckets = aggs.overall_by_buyer?.buckets ?? [];\nconst buyersInCategoryBuckets = aggs.selected_category?.buyers_in_category?.buckets ?? [];\n\nconst overallByBuyerMap = new Map(\n  overallByBuyerBuckets.map((bucket) => [\n    String(bucket.key),\n    {\n      buyerId: bucket.key,\n      buyerName: getBuyerName(bucket),\n      requisitionLinesFromAllCategory: bucket.doc_count ?? 0\n    }\n  ])\n);\n\nconst rows = buyersInCategoryBuckets\n  .filter((bucket) => (bucket?.doc_count ?? 0) > 0)\n  .map((bucket) => {\n    const buyerIdKey = String(bucket.key);\n    const overall = overallByBuyerMap.get(buyerIdKey);\n\n    return {\n      buyerId: bucket.key,\n      buyerName: getBuyerName(bucket) ?? overall?.buyerName ?? null,\n      requisitionLinesFromCategory: bucket.doc_count ?? 0,\n      requisitionLinesFromAllCategory: overall?.requisitionLinesFromAllCategory ?? 0\n    };\n  });\n\nconst unassignedInCategory = aggs.selected_category?.unassigned_in_category?.doc_count ?? 0;\nconst unassignedOverall = aggs.unassigned_overall?.doc_count ?? 0;\n\nrows.sort((a, b) => b.requisitionLinesFromCategory - a.requisitionLinesFromCategory);\n\nif (unassignedInCategory > 0) {\n  rows.push({\n    buyerName: 'No Buyer Assigned',\n    requisitionLinesFromCategory: unassignedInCategory,\n    requisitionLinesFromAllCategory: unassignedOverall\n  });\n}\n\nreturn rows;"
          },
          "outcomes": {
            "success": "1776700511155"
          },
          "code": "NORMALIZECATEGORYBUYERBREAKDOWN",
          "id": "1775355120649",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "CheckResponses",
            "returnType": "object",
            "sourceCode": "let result;\ntry {\n  const parsedActionPayload = $context.$nodes?.PARSEORAACTION?.$output?.result?.payload || {};\n  const buyerIdNameMapping = parsedActionPayload.buyerIdNameMapping || {};\n  const reassignmentPayloads = Array.isArray(parsedActionPayload.reassignment_payloads)\n    ? parsedActionPayload.reassignment_payloads\n    : [];\n  const responses = $context.$nodes?.REASSIGNBUYERS?.$output || [];\n  const total = Math.max(responses.length, reassignmentPayloads.length);\n\n  let failedBuyers = [];\n  let failureCount = 0;\n\n  function getBuyerName(buyerId) {\n    return buyerIdNameMapping[buyerId] || buyerId;\n  }\n\n  for (let i = 0; i < total; i++) {\n    let response = responses[i];\n    let parsed = null;\n    let isFailure = false;\n\n    if (typeof response === 'string') {\n      try {\n        parsed = JSON.parse(response);\n      } catch (e) {\n        isFailure = true;\n      }\n    } else if (response && typeof response === 'object') {\n      parsed = response;\n    } else {\n      isFailure = true;\n    }\n\n    if (!isFailure) {\n      const code = parsed?.result?.STATUS?.[0]?.CODE || parsed?.STATUS?.[0]?.CODE || null;\n      if (String(code).toUpperCase() !== 'SUCCESS') {\n        isFailure = true;\n      }\n    }\n\n    if (isFailure) {\n      failureCount++;\n      const failedBuyerId = reassignmentPayloads[i]?.reassignToBuyerId || reassignmentPayloads[i]?.buyerId;\n      if (failedBuyerId) {\n        failedBuyers.push(getBuyerName(failedBuyerId));\n      }\n    }\n  }\n\n  failedBuyers = [...new Set(failedBuyers)];\n  const successCount = total - failureCount;\n\n  let status;\n  if (failureCount === 0) {\n    status = 'ALL_SUCCESS';\n  } else if (successCount === 0) {\n    status = 'ALL_FAILED';\n  } else {\n    status = 'PARTIAL_SUCCESS';\n  }\n\n  result = {\n    status,\n    total,\n    successCount,\n    failureCount,\n    failedBuyers\n  };\n} catch (error) {\n  result = {\n    status: 'ERROR',\n    total: 0,\n    successCount: 0,\n    failureCount: 0,\n    failedBuyers: []\n  };\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776399366150"
          },
          "code": "CHECKRESPONSES",
