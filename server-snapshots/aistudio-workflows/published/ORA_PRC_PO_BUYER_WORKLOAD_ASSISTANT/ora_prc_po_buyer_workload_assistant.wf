        {
          "metadata": {
            "name": "Build Read Only Elastic Query",
            "returnType": "object",
            "sourceCode": "const request = $context.$nodes.NORMALIZE_READ_ONLY_QUERY_REQUEST?.$output?.result || {};\nconst filters = [];\nconst mustNot = [];\nconst reasons = [];\nlet gracefulFail = false;\nlet gracefulFailMessage = null;\n\nfunction blank(value) {\n  return value === null || value === undefined || String(value).trim() === '';\n}\n\nfunction numericOrString(value) {\n  if (blank(value)) return value;\n  const numberValue = Number(value);\n  return Number.isFinite(numberValue) && String(value).trim() !== '' ? numberValue : String(value);\n}\n\nfunction isWorkloadRelated(request) {\n  const message = String(request.originalMessage || '').toLowerCase();\n  if (request.status === 'unassigned') return true;\n  if (request.processingStatus === 'unprocessed') return true;\n  if (!blank(request.assigneeName)) return true;\n  if (!blank(request.categoryName)) return true;\n  if (!blank(request.deliverToLocation)) return true;\n  if (/\\b(workload|buyer|assigned|assignee|owner|unassigned|unprocessed|pool|actionable|reassign|reassignment|rebalance|deliver-to|deliver to|category|categories)\\b/.test(message)) return true;\n  return false;\n}\n\nfunction workloadScopeFailMessage() {\n  return 'I can help with buyer workload requisition lines, such as unassigned, unprocessed, assigned buyer, category, deliver-to location, or reassignment-related lines. I can\\'t reliably answer queries outside that workload scope from this workflow.';\n}\n\nfunction namedBusinessUnitFailMessage(request) {\n  const current = blank(request.procurementBUName) ? 'the current Procurement BU' : String(request.procurementBUName).trim();\n  const requested = blank(request.businessUnitName) ? 'the requested Procurement BU' : String(request.businessUnitName).trim();\n  return 'I can answer buyer workload queries only for the current Procurement BU. You are currently in ' + current + '. To query ' + requested + ', switch the Procurement BU context first.';\n}\n\nif (!isWorkloadRelated(request)) {\n  gracefulFail = true;\n  gracefulFailMessage = workloadScopeFailMessage();\n  reasons.push('This query is outside the buyer workload scope.');\n} else if (!blank(request.businessUnitName)) {\n  gracefulFail = true;\n  gracefulFailMessage = namedBusinessUnitFailMessage(request);\n  reasons.push('This query names a Procurement BU outside the current context.');\n}\n\nif (!blank(request.unsupportedReason)) reasons.push(request.unsupportedReason);\nif (blank(request.procurementBUId)) reasons.push('Missing current Procurement BU context.');\n\nconst mode = request.mode === 'list' ? 'list' : 'count';\n\nfilters.push({ term: { reqsInPoolFlag: 'Y' } });\nmustNot.push({ nested: { path: 'stagedDocumentLines', query: { match_all: {} } } });\n\nif (!blank(request.creationDateFrom) || !blank(request.creationDateTo)) {\n  const creationDateRange = {};\n  if (!blank(request.creationDateFrom)) creationDateRange.gte = String(request.creationDateFrom).trim();\n  if (!blank(request.creationDateTo)) creationDateRange.lte = String(request.creationDateTo).trim();\n  filters.push({ range: { creationDate: creationDateRange } });\n}\n\nif (!blank(request.requisitionNumber)) {\n  filters.push({ term: { 'header.requisitionNumber': String(request.requisitionNumber).trim() } });\n}\n\nif (request.lineNumber !== null && request.lineNumber !== undefined && !Number.isNaN(Number(request.lineNumber))) {\n  filters.push({ term: { lineNumber: Number(request.lineNumber) } });\n}\n\nif (!blank(request.assigneeName)) {\n  filters.push({ match_phrase: { 'buyer.name': String(request.assigneeName).trim() } });\n}\n\nif (!blank(request.categoryName)) {\n  filters.push({ match_phrase: { 'itemCategory.name': String(request.categoryName).trim() } });\n}\n\nif (!blank(request.deliverToLocation)) {\n  filters.push({ match_phrase: { 'deliverToLocation.name': String(request.deliverToLocation).trim() } });\n}\n\nif (request.status === 'unassigned') {\n  mustNot.push({ exists: { field: 'buyerId' } });\n} else if (!blank(request.status)) {\n  reasons.push(\"Status '\" + request.status + \"' is not supported by the deterministic query path.\");\n}\n\nif (request.processingStatus === 'unprocessed') {\n  // Base query already scopes unprocessed lines to reqsInPoolFlag = 'Y'.\n} else if (!blank(request.processingStatus)) {\n  reasons.push(\"Processing status '\" + request.processingStatus + \"' is not supported by the deterministic query path.\");\n}\n\nconst hasAnyUserFilter = Boolean(\n  request.status === 'unassigned' ||\n  request.processingStatus === 'unprocessed' ||\n  !blank(request.creationDateFrom) ||\n  !blank(request.creationDateTo) ||\n  !blank(request.requisitionNumber) ||\n  !blank(request.assigneeName) ||\n  !blank(request.categoryName) ||\n  !blank(request.deliverToLocation)\n);\n\nif (!hasAnyUserFilter && mode === 'count') {\n  reasons.push('A count query needs at least one line filter such as unassigned, assignee, category, deliver-to, creation date, or requisition.');\n}\n\nconst ready = reasons.length === 0;\nconst payload = {\n  size: mode === 'count' ? 1 : 25,\n  track_total_hits: true,\n  _source: mode === 'count' ? ['requisitionLineId'] : [\n    'requisitionLineId',\n    'header.requisitionNumber',\n    'requisitionNumber',\n    'lineNumber',\n    'buyerId',\n    'buyer.name',\n    'itemCategory.name',\n    'deliverToLocation.name',\n    'creationDate'\n  ],\n  query: ready ? { bool: { filter: filters, must_not: mustNot } } : { match_none: {} }\n};\n\nif (mode === 'list') {\n  payload.sort = [{ creationDate: { order: 'desc' } }];\n}\n\nreturn {\n  ready,\n  gracefulFail,\n  gracefulFailMessage,\n  reason: ready ? null : reasons.join(' '),\n  mode,\n  payload: JSON.stringify(payload),\n  payloadBody: JSON.stringify(payload),\n  request\n};"
          },
          "outcomes": {
            "success": "1781000000004"
          },
