            "success": "1781000000006"
          },
          "code": "PREPARE_READONLY_QUERY_DISPLAY_DATA",
          "id": "1781000000008",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "BuildReassignmentPayloads",
            "returnType": "array",
            "sourceCode": "// MODE A - Node 2 of 2\n// ------------------------------------------------------------\n// BuildReassignmentPayloadsModeA\n//\n// Purpose:\n// - Consume transferPlan from GenerateReassignmentPlanModeA\n// - Materialize concrete line moves using donor buyer pools\n// - Build final payloads and apply chunking\n//\n// Final output shape (same as original node):\n// [\n//   { reassignToBuyerId: number|string, requisitionLineIds: \"id1,id2,id3\" }\n// ]\n// ------------------------------------------------------------\n\nconst lines = $context.$nodes.NORMALIZEREQLINESTOREASSIGN.$output.result || [];\n\n// IMPORTANT:\n// If your plan node has a different name, update this reference.\nconst rawPlanOutput = $context.$nodes.GENERATEREASSIGNMENT.$output;\nconst plan = rawPlanOutput?.result || rawPlanOutput || {};\n\nconst isBalanced = !!plan?.isBalanced;\nconst transferPlan = Array.isArray(plan?.transferPlan) ? plan.transferPlan : [];\nconst hasLines = Array.isArray(lines) && lines.length > 0;\nconst canBuildPayloads = hasLines && !isBalanced && transferPlan.length > 0;\n\nlet payloads = [];\n\nif (canBuildPayloads) {\n  let maxLinesPerPayload = Number(plan?.maxLinesPerPayload);\n  const shouldChunk = Number.isFinite(maxLinesPerPayload) && maxLinesPerPayload > 0;\n  if (shouldChunk) {\n    maxLinesPerPayload = Math.floor(maxLinesPerPayload);\n  }\n\n  const eligibleBuyerIds = Array.isArray(plan?.eligibleBuyerIds)\n    ? plan.eligibleBuyerIds.map((x) => String(x))\n    : [];\n\n  // Build donor pools from source lines\n  const buyerLines = {};\n\n  for (const row of lines) {\n    const buyerId = String(row?.buyerId);\n    const lineId = String(row?.requisitionLineId);\n\n    if (!buyerLines[buyerId]) buyerLines[buyerId] = [];\n    buyerLines[buyerId].push(lineId);\n  }\n\n  // Materialize transfer counts into concrete lineIds\n  const moveToBuyer = {}; // destBuyerId -> [lineId]\n\n  for (const t of transferPlan) {\n    const fromBuyerId = String(t?.fromBuyerId);\n    const toBuyerId = String(t?.toBuyerId);\n    const count = Number(t?.count);\n\n    if (!Number.isFinite(count) || count <= 0) continue;\n    if (fromBuyerId === toBuyerId) continue;\n\n    const donorArr = buyerLines[fromBuyerId] || [];\n    if (donorArr.length === 0) continue;\n\n    let destArr = moveToBuyer[toBuyerId];\n    if (!destArr) {\n      destArr = [];\n      moveToBuyer[toBuyerId] = destArr;\n    }\n\n    let moved = 0;\n\n    while (moved < count && donorArr.length > 0) {\n      const lineId = donorArr.pop(); // deterministic + O(1)\n      if (lineId === undefined) break;\n      destArr.push(lineId);\n      moved++;\n    }\n  }\n\n  const buyerIdToOutput = {};\n  const destBuyerOrder =\n    eligibleBuyerIds.length > 0\n      ? eligibleBuyerIds\n      : Object.keys(moveToBuyer);\n\n  for (const destBuyerId of destBuyerOrder) {\n    const list = moveToBuyer[destBuyerId] || [];\n    if (list.length === 0) continue;\n\n    let outBuyer = buyerIdToOutput[destBuyerId];\n    if (outBuyer === undefined) {\n      const num = Number(destBuyerId);\n      if (Number.isSafeInteger(num) && String(num) === String(destBuyerId)) outBuyer = num;\n      else outBuyer = String(destBuyerId);\n      buyerIdToOutput[destBuyerId] = outBuyer;\n    }\n\n    if (shouldChunk) {\n      let start = 0;\n      while (start < list.length) {\n        let end = start + maxLinesPerPayload;\n        if (end > list.length) end = list.length;\n\n        payloads.push({\n          reassignToBuyerId: outBuyer,\n          requisitionLineIds: list.slice(start, end).join(\",\")\n        });\n\n        start = end;\n      }\n    } else {\n      payloads.push({\n        reassignToBuyerId: outBuyer,\n        requisitionLineIds: list.join(\",\")\n      });\n    }\n  }\n}\n\nreturn payloads;"
          },
          "outcomes": {
            "success": "1775114169256"
          },
          "code": "BUILDREASSIGNMENTPAYLOADS",
          "id": "1775847503648",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "enableActions": true,
              "layouts": [
                "ORA_LAYOUT_MULTIRECORD"
              ]
            }
          },
          "metadata": {
            "description": "",
            "name": "DisplayBuyerBreakdwonByCategory"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "DISPLAYBUYERBREAKDWONBYCATEGORY",
          "id": "1776696965349",
          "inputs": [
            {
              "id": "1775355393422_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a specialized UI rendering assistant for Procurement Workload by Buyer. You must\nadhere to the standard oraInfoDisplay Knowledge Base.\n\n**DIRECTIVE:** Your sole purpose is to transform the provided input data into a valid\n`oraInfoDisplay` XML block using the `multiRecordWidget` pattern and an optional oraInsight\nif the criteria are met.\n\n## INSIGHTS TEXT\n**MUST NOT** generate or include any insights text in the output.\n\n## ROOT CONFIGURATION\n1. `title`: Use the input `category_name` and the workload status from\n{{$context.$nodes.PARSEORAACTION.$output.result.payload.Workload}} to generate a concise,\nrelevant headline as follows:\n   - If workload is \"Balanced\", title is `Workload for {category_name} is balanced`.\n   - If workload is \"Not Balanced\", title is `Workload for {category_name} is not balanced`.\n\n2. `description`: create it using ONLY this value:\nunassignedCount = {{$context.$nodes.FILTER_NO_BUYER_ASSIGNED.$output.result.unassignedCount}}\n\n2.1 Conversion rule:\n- Treat `unassignedCount` as a number after parsing it.\n- If `unassignedCount` is greater than 0:\n  - If it equals 1, output:\n    \"There is 1 requisition line not assigned to any buyer.\"\n  - If it is greater than 1, output:\n    \"There are {unassignedCount} requisition lines not assigned to any buyer.\"\n- If `unassignedCount` is 0, null, missing, empty, undefined, or not a valid number, output:\n  \"There are no requisition lines not assigned to any buyer.\"\n\n\n## STRICT MAPPING RULES (multiRecordWidget)\n\n### Data inputs to expect\n- `category_name`: {{$context.$nodes.PARSEORAACTION.$output.result.payload.CategoryName}}\n- `category_id`: {{$context.$nodes.GETCATEGORYID2.$output.result}}\n- `buyers` (object list): each element contains `buyerId`, `buyerName`,\n  `requisitionLinesFromCategory`, `requisitionLinesFromAllCategory`:\n  {{$context.$nodes.FILTER_NO_BUYER_ASSIGNED.$output.result.filteredBuyers}}\n\n### Widget selection validation\n- Use exactly one `multiRecordWidget` as the primary display for the tabular buyer list.\n\n### Column mapping (`multiRecordWidget.cols`)\nSet `cols` to exactly these 3 column headers, in order:\n1. `Buyer`\n2. `Requisition Lines in this Category`\n3. `Total Requisition Lines`\n\n### Row mapping (`multiRecordWidget.rows`)\nFor each element in the buyers list, create one row:\n- `rows[].cells[0]`: map from `buyerName` (if `buyerName` is empty, fall back to\n  displaying `buyerId`)\n- `rows[].cells[1]`: map from `requisitionLinesFromCategory`\n- `rows[].cells[2]`: map from `requisitionLinesFromAllCategory`\n- Do **not** include `rows[].action` (no row-level drilldown was requested).\n\n### Order\nThe rows must have the same order as the elements in `buyers`.\n\n## ADDITIONAL INSTRUCTIONS\n1. Only if the following result is true:\n   {{$context.$nodes.PARSEORAACTION.$output.result.payload.Workload==='Not Balanced'}}\n   Generate an oraInsight element with:\n   1.1 actionText as \"Rebalance Workload\".\n   1.2 followUpCommand as\n       `ora.Invoke(\"PreviewReassignment\", PreviewReassignment:{\"categoryId\":{category_id},\"CategoryName\":\"{category_name}\"})`\n   1.3 It's very important to make sure that the second element of Invoke first includes\n       PreviewReassignment followed by colon and then the\n       {\"categoryId\":{category_id},\"CategoryName\":\"{category_name}\"}\n\nEnsure the output includes in this exact order:\n1. The oraInfoDisplay XML block with the multiRecordWidget.\n2. The optional oraInsight element if applicable.\n\nFormat the output exactly as valid XML with embedded JSON for oraInfoDisplay and oraInsight\nelements as specified.\n"
            },
            {
              "id": "1776696965349_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": ""
            }
          ],
          "type": "LLM"
        },
