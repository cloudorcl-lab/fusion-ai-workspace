        {
          "metadata": {
            "name": "NormalizeTop5CategoriesResponse",
            "returnType": "object",
            "sourceCode": "const buckets = $context.$nodes.GETTOP5CATEGORIES.$output?.aggregations?.top_categories?.buckets ?? [];\n\nconst toFiniteNumber = (value) => {\n  const numberValue = Number(value);\n  return Number.isFinite(numberValue) ? numberValue : undefined;\n};\n\nconst result = {\n  topCategories: buckets.map((bucket) => {\n    const topHitSource = bucket?.category_label?.hits?.hits?.[0]?._source;\n    const nameByLocale = topHitSource?.itemCategory?.name ?? {};\n    const availableLocale = Object.keys(nameByLocale)[0];\n    const categoryName = availableLocale ? nameByLocale[availableLocale] : undefined;\n    const buyerLoadStats = bucket?.buyer_load_stats ?? {};\n\n    return {\n      categoryId: bucket?.key,\n      categoryName,\n      docCount: bucket?.doc_count ?? 0,\n      distinctBuyerCount: toFiniteNumber(buyerLoadStats.count) ?? 0,\n      buyerLoadStats: {\n        min: toFiniteNumber(buyerLoadStats.min),\n        max: toFiniteNumber(buyerLoadStats.max),\n        avg: toFiniteNumber(buyerLoadStats.avg)\n      }\n    };\n  })\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1774450251924"
          },
          "code": "NORMALIZETOP5CATEGORIESRESPONSE",
          "id": "1774450214754",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
