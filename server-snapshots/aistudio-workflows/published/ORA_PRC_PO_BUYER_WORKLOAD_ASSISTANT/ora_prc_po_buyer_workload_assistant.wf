        {
          "metadata": {
            "description": "Validates that a reassignment request has enough information before downstream API calls.",
            "name": "Validate Reassignment Request",
            "returnType": "object",
            "sourceCode": "const request = $context.$nodes.NORMALIZE_REASSIGNMENT_REQUEST?.$output?.result || {};\nconst missingFields = [];\nconst unsupportedFields = [];\nconst warnings = [];\n\nfunction blank(value) {\n  return value === null || value === undefined || String(value).trim() === '';\n}\n\nif (blank(request.assigneeName)) {\n  missingFields.push('target buyer');\n}\n\nif (blank(request.procurementBUId)) {\n  missingFields.push('procurement business unit');\n}\n\nconst hasRequisition = !blank(request.requisitionNumber);\nconst hasCategory = !blank(request.categoryName);\nconst hasDeliverTo = !blank(request.deliverToLocation);\nconst hasSourceBuyer = !blank(request.sourceBuyerName);\nconst hasSupportedStatus = request.status === 'unassigned';\nconst hasAnyStatus = !blank(request.status);\nconst hasLineNumber = request.lineNumber !== null && request.lineNumber !== undefined && !Number.isNaN(Number(request.lineNumber));\n\nif (request.lineNumber !== null && request.lineNumber !== undefined && Number.isNaN(Number(request.lineNumber))) {\n  unsupportedFields.push('line number must be numeric');\n}\n\nif (hasAnyStatus && !hasSupportedStatus) {\n  unsupportedFields.push(\"status '\" + request.status + \"' is not supported for reassignment\");\n}\n\nif (hasLineNumber && !hasRequisition) {\n  missingFields.push('requisition number for the line');\n}\n\nconst hasSelectionCriteria = hasRequisition || hasCategory || hasDeliverTo || hasSupportedStatus || hasSourceBuyer;\nif (!hasSelectionCriteria) {\n  missingFields.push('requisition, category, deliver-to location, source buyer, or unassigned status');\n}\n\nif (request.scope === 'bulk' && !hasCategory && !hasDeliverTo && !hasSupportedStatus && !hasSourceBuyer) {\n  warnings.push('bulk reassignment needs a limiting filter such as unassigned status, category, deliver-to location, or source buyer');\n  if (!hasRequisition) {\n    missingFields.push('bulk reassignment filter');\n  }\n}\n\nconst uniqueMissingFields = [...new Set(missingFields)];\nconst ready = uniqueMissingFields.length === 0 && unsupportedFields.length === 0;\nconst reason = ready\n  ? null\n  : [\n      uniqueMissingFields.length ? 'Missing ' + uniqueMissingFields.join(', ') + '.' : null,\n      unsupportedFields.length ? unsupportedFields.join('. ') + '.' : null,\n      warnings.length ? warnings.join('. ') + '.' : null\n    ].filter(Boolean).join(' ');\n\nreturn {\n  ready,\n  reason,\n  missingFields: uniqueMissingFields,\n  unsupportedFields,\n  warnings,\n  request\n};"
          },
          "outcomes": {
            "success": "1777390322589"
          },
          "code": "VALIDATE_REASSIGNMENT_REQUEST",
          "id": "1777390295999",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
