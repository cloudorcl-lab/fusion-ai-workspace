          "code": "FORMAT_READONLY_QUERY_RESPONSE",
          "id": "1781000000006",
          "inputs": [
            {
              "id": "1781000000006_prompt",
              "name": "prompt",
              "type": "string",
              "value": "You are a specialized UI rendering assistant for Procurement requisition line query results.\nYour sole purpose is to transform the prepared display data into a user-friendly response.\n\n## DATA\nPrepared read-only requisition line query display data:\n{{$context.$nodes.PREPARE_READONLY_QUERY_DISPLAY_DATA.$output.result}}\n\n## TASK\nGenerate the response from the prepared display data.\n\nIf mode is \"error\", return only the countMessage as plain text.\nIf mode is \"count\", return only the countMessage as plain text.\nIf mode is \"list\" and rows is empty, return only the emptyMessage as plain text.\nIf mode is \"list\" and rows has values, generate a multi-record widget for the requisition line details.\n\n## WIDGET GUIDANCE\n- Use a multi-record/table-style widget because requisition line details are tabular data.\n- Set the widget subtitle or equivalent supporting text to the prepared description so users can see how many matching lines are being shown.\n- Do not include row actions.\n- Do not include drilldown actions.\n\n## COLUMN RULES\n- If request.assigneeName has a value, do not include the Buyer column because all rows are already scoped to that buyer.\n- If request.status is \"unassigned\", do not include the Buyer column because all rows are unassigned.\n- Otherwise include the Buyer column.\n- Always include Requisition, Line, Category, and Deliver-to Location.\n\n## DATA MAPPING\nFor each row in prepared rows:\n- Requisition maps from row.requisition\n- Line maps from row.line\n- Buyer maps from row.buyer only when the Buyer column is included\n- Category maps from row.category\n- Deliver-to Location maps from row.deliverToLocation\n\n## RULES\n- Return only plain text for error mode, count mode, or empty list mode.\n- Never create a widget unless mode is \"list\" and rows has values.\n- Return only the widget response for non-empty list mode.\n- Do not output explanations before or after the result."
            },
            {
              "id": "1781000000006_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": ""
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "description": "Builds the fa-prc-por Elasticsearch payload needed to find requisition lines for reassignment.",
            "name": "Build Elastic Search Query",
            "returnType": "object",
            "sourceCode": "const request = $context.$nodes.NORMALIZE_REASSIGNMENT_REQUEST?.$output?.result || {};\nconst buyerOutput = $context.$nodes.GET_BUYER_INFO?.$output || {};\nconst sourceBuyerOutput = $context.$nodes.GET_SOURCE_BUYER_INFO?.$output || {};\nconst filters = [];\nconst mustNot = [];\nconst readinessReasons = [];\n\nfunction firstDefined(...values) {\n  return values.find(value => value !== null && value !== undefined && value !== '');\n}\n\nfunction numericOrString(value) {\n  if (value === null || value === undefined || value === '') {\n    return value;\n  }\n  const numberValue = Number(value);\n  return Number.isFinite(numberValue) && String(value).trim() !== '' ? numberValue : String(value);\n}\n\nfunction blank(value) {\n  return value === null || value === undefined || String(value).trim() === '';\n}\n\nfunction buyerIdFrom(item) {\n  return firstDefined(\n    item?.AgentId,\n    item?.agentId,\n    item?.BuyerId,\n    item?.buyerId,\n    item?.id\n  );\n}\n\nfunction buyerItemsFrom(output) {\n  const root = output.result || output;\n  return Array.isArray(root.items)\n    ? root.items\n    : (root && typeof root === 'object' && Object.keys(root).length ? [root] : []);\n}\n\nfunction buyerMatchesFrom(output) {\n  return buyerItemsFrom(output).filter(item => buyerIdFrom(item) !== null && buyerIdFrom(item) !== undefined && buyerIdFrom(item) !== '');\n}\n\nconst buyerMatches = buyerMatchesFrom(buyerOutput);\nconst targetBuyerId = buyerIdFrom(buyerMatches[0] || {});\nconst sourceBuyerMatches = request.sourceBuyerName ? buyerMatchesFrom(sourceBuyerOutput) : [];\nconst sourceBuyerId = request.sourceBuyerName ? buyerIdFrom(sourceBuyerMatches[0] || {}) : null;\n\nif (!blank(request.assigneeName) && buyerMatches.length !== 1) {\n  readinessReasons.push(buyerMatches.length === 0\n    ? 'Could not find target buyer ' + request.assigneeName + '.'\n    : 'Found multiple target buyers named ' + request.assigneeName + '.');\n}\n\nif (!blank(request.sourceBuyerName) && sourceBuyerMatches.length !== 1) {\n  readinessReasons.push(sourceBuyerMatches.length === 0\n    ? 'Could not find source buyer ' + request.sourceBuyerName + '.'\n    : 'Found multiple source buyers named ' + request.sourceBuyerName + '.');\n}\n\nfilters.push({ term: { reqsInPoolFlag: 'Y' } });\n\nif (request.requisitionNumber) {\n  filters.push({ term: { 'header.requisitionNumber': String(request.requisitionNumber) } });\n}\n\nif (request.lineNumber !== null && request.lineNumber !== undefined && !Number.isNaN(Number(request.lineNumber))) {\n  filters.push({ term: { lineNumber: Number(request.lineNumber) } });\n}\n\nif (request.categoryName) {\n  filters.push({ match_phrase: { 'itemCategory.name': request.categoryName } });\n}\n\nif (request.deliverToLocation) {\n  filters.push({ match_phrase: { 'deliverToLocation.name': request.deliverToLocation } });\n}\n\nif (sourceBuyerId !== null && sourceBuyerId !== undefined && sourceBuyerId !== '') {\n  filters.push({ term: { buyerId: numericOrString(sourceBuyerId) } });\n}\n\nmustNot.push({ nested: { path: 'stagedDocumentLines', query: { match_all: {} } } });\n\nif (request.status === 'unassigned') {\n  mustNot.push({ exists: { field: 'buyerId' } });\n}\n\nconst isBulk = request.scope === 'bulk' && !request.requisitionNumber;\nconst hasBusinessUnitScope = request.procurementBUId !== null && request.procurementBUId !== undefined && request.procurementBUId !== '';\nconst hasLineCriteria = Boolean(request.requisitionNumber || request.categoryName || request.deliverToLocation || request.status === 'unassigned' || sourceBuyerId);\nconst ready = Boolean(request.assigneeName) && hasLineCriteria && (!isBulk || hasBusinessUnitScope) && readinessReasons.length === 0;\n\nconst query = ready\n  ? { bool: { filter: filters } }\n  : { match_none: {} };\n\nif (ready && mustNot.length) {\n  query.bool.must_not = mustNot;\n}\n\nconst targetBuyerCountFilters = [\n  { term: { reqsInPoolFlag: 'Y' } }\n];\nconst targetBuyerCountMustNot = [\n  { nested: { path: 'stagedDocumentLines', query: { match_all: {} } } }\n];\n\nif (targetBuyerId !== null && targetBuyerId !== undefined && targetBuyerId !== '') {\n  targetBuyerCountFilters.push({ term: { buyerId: numericOrString(targetBuyerId) } });\n}\n\nconst payload = {\n  size: isBulk ? 1000 : 100,\n  track_total_hits: true,\n  _source: [\n    'requisitionHeaderId',\n    'requisitionLineId',\n    'header.requisitionNumber',\n    'lineNumber',\n    'procurementBuId',\n    'buyerId',\n    'buyer.name',\n    'categoryId',\n    'itemCategory.name',\n    'deliverToLocation.name'\n  ],\n  query\n};\n\nif (targetBuyerId !== null && targetBuyerId !== undefined && targetBuyerId !== '') {\n  payload.aggs = {\n    targetBuyerCurrentLoad: {\n      global: {},\n      aggs: {\n        targetBuyerLines: {\n          filter: {\n            bool: {\n              filter: targetBuyerCountFilters,\n              must_not: targetBuyerCountMustNot\n            }\n          }\n        }\n      }\n    }\n  };\n}\n\nconst fallbackReason = 'Missing target buyer, line selection criteria, Procurement BU scope for bulk reassignment, or unique source buyer.';\n\nreturn {\n  ready,\n  reason: ready ? null : (readinessReasons.length ? readinessReasons.join(' ') : fallbackReason),\n  payload: JSON.stringify(payload),\n  request,\n  targetBuyerId: targetBuyerId != null ? Number(targetBuyerId) : null,\n  sourceBuyerId: sourceBuyerId != null ? Number(sourceBuyerId) : null,\n  sourceBuyerMatchCount: sourceBuyerMatches.length\n};"
          },
          "outcomes": {
            "success": "1777315492360"
          },
          "code": "BUILD_ELASTIC_SEARCH_QUERY",
          "id": "1777315477014",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "description": "Stops before search when the request is missing required scope.",
            "name": "Check Query Ready"
          },
          "outcomes": {
            "false": "1777315521569",
            "true": "1777315503386"
          },
          "code": "CHECK_QUERY_READY",
          "convergenceTargetId": "1777315521569",
          "id": "1777315492360",
          "inputs": [
            {
              "id": "1777100000005_condition",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.BUILD_ELASTIC_SEARCH_QUERY.$output.result.ready}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "CalculateWorkloadBeforeReassignment",
            "returnType": "array",
            "sourceCode": "// ------------------------------------------------------------\n// Agentic App JS Code Node\n//\n// Goal:\n// 1) Read original req-line ownership data (already scoped to category).\n// 2) Build initial buyer docCount from those lines.\n// 3) Apply reassignment payloads line-by-line:\n//    - decrement original owner\n//    - increment destination owner\n// 4) Return: [ { buyerId, buyerName, docCountBeforeRebalancing, docCountAfterRebalancing } ]\n//\n// NOTE:\n// - REST success-response filtering is intentionally NOT included yet,\n//   per your request. You can add that filter later.\n// ------------------------------------------------------------\n\n// Inputs (adjust node paths if your flow uses different names)\nconst reassignmentData = $context.$nodes.BUILDREASSIGNMENTPAYLOADS.$output.result || [];\nconst originalReqLines = $context.$nodes.NORMALIZEREQLINESTOREASSIGN.$output.result || [];\n\n// Debug logging (commented out)\n// const DEBUG = true;\n// const log = (...args) => {\n//   if (DEBUG) {\n//     console.log(\"[ComputeCategoryBuyerDocCountAfterReassign]\", ...args);\n//   }\n// };\n\n// Helper: convert id to stable key for maps\nconst toKey = (value) => String(value);\n\nconst NO_BUYER_ASSIGNED_NAME = \"No Buyer Assigned\";\n\n// Helper: buyer name policy (never expose buyerId in name)\nconst getSafeBuyerName = (name) => {\n  if (typeof name === \"string\" && name.trim() !== \"\") {\n    return name.trim();\n  }\n  return NO_BUYER_ASSIGNED_NAME;\n};\n\n// Helper: normalize requisition line IDs from supported formats\nconst normalizeRequisitionLineIds = (value) => {\n  if (Array.isArray(value)) {\n    return value\n      .map((x) => String(x).trim())\n      .filter((x) => x !== \"\");\n  }\n\n  if (typeof value === \"string\") {\n    if (value.trim() === \"\") return [];\n    return value\n      .split(\",\")\n      .map((x) => x.trim())\n      .filter((x) => x !== \"\");\n  }\n\n  return [];\n};\n\nconst hasValidOriginalReqLines = Array.isArray(originalReqLines);\n\n// log(\"Starting computation\", {\n//   originalReqLinesCount: Array.isArray(originalReqLines) ? originalReqLines.length : 0,\n//   reassignmentDataCount: Array.isArray(reassignmentData) ? reassignmentData.length : 0\n// });\n\n// Build initial buyer workload map directly from original req lines\nconst buyerMap = {};\n\n// Build lineId -> original buyer map from NormalizeReqLinesToReassign output\nconst originalBuyerByLineId = {};\n\nif (hasValidOriginalReqLines) {\n  for (const row of originalReqLines) {\n    const lineId = row?.requisitionLineId;\n    const buyerId = row?.buyerId;\n    if (lineId === null || lineId === undefined || buyerId === null || buyerId === undefined) {\n      // log(\"Skipping original row due to missing lineId/buyerId\", { row });\n      continue;\n    }\n\n    const lineKey = toKey(lineId);\n    const originalBuyerKey = toKey(buyerId);\n\n    originalBuyerByLineId[lineKey] = {\n      buyerId,\n      buyerName: getSafeBuyerName(row?.buyerName)\n    };\n\n    if (!buyerMap[originalBuyerKey]) {\n      buyerMap[originalBuyerKey] = {\n        buyerId,\n        buyerName: getSafeBuyerName(row?.buyerName),\n        docCountBeforeRebalancing: 0,\n        docCountAfterRebalancing: 0\n      };\n    }\n\n    // baseline count = number of original lines assigned to this buyer\n    buyerMap[originalBuyerKey].docCountBeforeRebalancing += 1;\n    buyerMap[originalBuyerKey].docCountAfterRebalancing += 1;\n\n    // log(\"Baseline increment\", {\n    //   lineId: lineKey,\n    //   buyerId: buyerMap[originalBuyerKey].buyerId,\n    //   buyerName: buyerMap[originalBuyerKey].buyerName,\n    //   docCountBeforeRebalancing: buyerMap[originalBuyerKey].docCountBeforeRebalancing,\n    //   docCountAfterRebalancing: buyerMap[originalBuyerKey].docCountAfterRebalancing\n    // });\n  }\n\n  // log(\"Completed baseline build\", {\n  //   buyersInMap: Object.keys(buyerMap).length,\n  //   lineOwnersTracked: Object.keys(originalBuyerByLineId).length\n  // });\n\n  // 5) Apply reassignment movements (decrement original + increment destination)\n  const processedLineIds = {};\n\n  if (Array.isArray(reassignmentData)) {\n    for (const item of reassignmentData) {\n      const targetBuyerId = item?.reassignToBuyerId;\n      if (targetBuyerId === null || targetBuyerId === undefined) {\n        // log(\"Skipping reassignment item: missing reassignToBuyerId\", { item });\n        continue;\n      }\n\n      const targetBuyerKey = toKey(targetBuyerId);\n      const lineIds = normalizeRequisitionLineIds(item?.requisitionLineIds);\n      if (lineIds.length === 0) {\n        // log(\"Skipping reassignment item: no valid requisitionLineIds\", { item });\n        continue;\n      }\n\n      // log(\"Processing reassignment item\", {\n      //   targetBuyerId,\n      //   lineIdsCount: lineIds.length,\n      //   lineIds\n      // });\n\n      // If buyer not originally in category list, create fallback entry\n      if (!buyerMap[targetBuyerKey]) {\n        buyerMap[targetBuyerKey] = {\n          buyerId: targetBuyerId,\n          buyerName: NO_BUYER_ASSIGNED_NAME,\n          docCountBeforeRebalancing: 0,\n          docCountAfterRebalancing: 0\n        };\n      }\n\n      for (const lineId of lineIds) {\n        const lineKey = toKey(lineId);\n\n        // Avoid double-processing duplicated line IDs across payload items\n        if (processedLineIds[lineKey]) {\n          // log(\"Skipping duplicate lineId already processed\", { lineId: lineKey });\n          continue;\n        }\n        processedLineIds[lineKey] = true;\n\n        const originalInfo = originalBuyerByLineId[lineKey];\n        if (originalInfo) {\n          const originalBuyerKey = toKey(originalInfo.buyerId);\n\n          if (!buyerMap[originalBuyerKey]) {\n            buyerMap[originalBuyerKey] = {\n              buyerId: originalInfo.buyerId,\n              buyerName: getSafeBuyerName(originalInfo.buyerName),\n              docCountBeforeRebalancing: 0,\n              docCountAfterRebalancing: 0\n            };\n          }\n\n          // Decrease original owner count\n          buyerMap[originalBuyerKey].docCountAfterRebalancing -= 1;\n\n          // log(\"Moved line from original buyer\", {\n          //   lineId: lineKey,\n          //   originalBuyerId: originalInfo.buyerId,\n          //   originalBuyerName: getSafeBuyerName(originalInfo.buyerName),\n          //   newOriginalBuyerAfterCount: buyerMap[originalBuyerKey].docCountAfterRebalancing\n          // });\n        } else {\n          // log(\"No original buyer found for lineId; only incrementing target buyer\", {\n          //   lineId: lineKey,\n          //   targetBuyerId\n          // });\n        }\n\n        // Increase destination owner count\n        buyerMap[targetBuyerKey].docCountAfterRebalancing += 1;\n\n        // log(\"Incremented target buyer\", {\n        //   lineId: lineKey,\n        //   targetBuyerId,\n        //   targetBuyerName: buyerMap[targetBuyerKey].buyerName,\n        //   targetBuyerAfterCount: buyerMap[targetBuyerKey].docCountAfterRebalancing\n        // });\n      }\n    }\n  } else {\n    // log(\"reassignmentData is not an array; skipping reassignment phase\", {\n    //   type: typeof reassignmentData\n    // });\n  }\n} else {\n  // log(\"originalReqLines is not an array; returning empty result\", {\n  //   type: typeof originalReqLines\n  // });\n}\n\n// 6) Return the requested shape\nconst result = Object.values(buyerMap).map((entry) => ({\n  buyerId: entry.buyerId,\n  buyerName: entry.buyerName,\n  docCountBeforeRebalancing: entry.docCountBeforeRebalancing,\n  docCountAfterRebalancing: entry.docCountAfterRebalancing\n}));\n\nconst filteredRows = result\n  .filter((entry) => String(entry.buyerId) !== \"-1\")\n  .sort((a, b) => b.docCountAfterRebalancing - a.docCountAfterRebalancing);\n\n// log(\"Final buyerMap snapshot\", buyerMap);\n// log(\"Final result\", result);\n\nreturn filteredRows;"
          },
          "outcomes": {
            "success": "1776229305677"
          },
          "code": "CALCULATEWORKLOADBEFOREREASSIGNMENT",
          "id": "1775114169256",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
