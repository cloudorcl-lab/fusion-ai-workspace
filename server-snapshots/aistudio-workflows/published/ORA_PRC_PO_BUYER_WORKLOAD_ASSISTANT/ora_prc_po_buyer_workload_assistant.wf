        {
          "metadata": {
            "name": "DirectToPutPayloadsAsTheyAre",
            "returnType": "string",
            "sourceCode": "const llmOutput = outputToString($context.$nodes.DIRECTPREVIEWPROPOSEDREASSIGNMENT.$output);\nconst prepared = $context.$nodes.PREPARE_REASSIGNMENT_PAYLOAD?.$output?.result || {};\nconst payloadArray = prepared.payloadObject ? [prepared.payloadObject] : [];\nconst mappingObj = $context.$nodes.DIRECT_EXTRACTBUYERIDNAMEMAPPING.$output.result || {};\n\nfunction outputToString(output) {\n  if (typeof output === 'string') return output;\n\n  const value = output?.result ?? output?.text ?? output?.message ?? output?.content ?? output?.output;\n  if (typeof value === 'string') return value;\n\n  if (Array.isArray(value)) {\n    return value\n      .map(item => typeof item === 'string' ? item : firstString(item))\n      .filter(item => item !== '')\n      .join('');\n  }\n\n  const nested = firstString(value ?? output);\n  return nested || '';\n}\n\nfunction firstString(value) {\n  if (typeof value === 'string') return value;\n  if (!value || typeof value !== 'object') return '';\n\n  for (const key of ['result', 'text', 'message', 'content', 'output']) {\n    if (typeof value[key] === 'string') return value[key];\n  }\n\n  return '';\n}\n\nconst payloadJson = JSON.stringify(payloadArray);\nconst escapedPayload = JSON.stringify(payloadJson).slice(1, -1);\n\nconst mappingJson = JSON.stringify(mappingObj);\nconst escapedMapping = JSON.stringify(mappingJson).slice(1, -1);\n\nlet finalOutput = llmOutput.replace('__REASSIGNMENT_PAYLOAD__', escapedPayload);\nfinalOutput = finalOutput.replace('__BUYER_ID_NAME_MAPPING__', escapedMapping);\n\nreturn finalOutput;"
          },
