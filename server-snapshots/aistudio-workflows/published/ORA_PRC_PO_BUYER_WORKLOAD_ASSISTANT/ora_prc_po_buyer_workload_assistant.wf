              "value": "{{$context.$variables.effectivePrcBUName}}"
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "name": "Intent Router"
          },
          "outcomes": {
            "success": "1777067457062"
          },
          "code": "INTENT_ROUTER",
          "id": "1777067434746",
          "inputs": [
            {
              "id": "1776741963666_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": ""
            },
            {
              "id": "1776741963666_prompt",
              "name": "prompt",
              "type": "string",
              "value": "You are a strict routing classifier for Oracle Ask Oracle procurement requests.\n\nYour task is to read the current user message and relevant chat history, then output exactly one of these intent values:\n\nSWITCH_CONTEXT\nQUERY\nREASSIGN\n\nDo not explain your answer.\nDo not output JSON.\nDo not output anything except one of the three values.\n\n================================\nINPUT DATA\n================================\n\nChat History:\n{{$context.$system.$chatHistory}}\n\nCurrent User Input:\n{{$context.$system.$inputMessage}}\n\n================================\nTERMINOLOGY NORMALIZATION\n================================\n\n\"req\" = \"requisition\"\n\"line\" = \"requisition line\"\n\"BU\" = \"business unit\"\n\"procurement BU\" = \"procurement business unit\"\n\n================================\nINTENT VALUES\n================================\n\nSWITCH_CONTEXT =\nThe user is directly asking to change, set, switch, select, choose, update, open, load, display, or refresh the active Procurement Business Unit context or workspace.\n\nQUERY =\nAnything read-only or informational, including viewing, listing, counting, searching, analyzing, asking who/what/where/which/how, asking for help, or ambiguous requests.\n\nREASSIGN =\nThe user is directly asking to change the assignment, ownership, assignee, or buyer of one or more requisitions or requisition lines.\n\n================================\nDECISION PRIORITY\n================================\n\nEvaluate in this exact order:\n\n1. HELP / INSTRUCTION REQUEST -> QUERY\n2. READ-ONLY RETRIEVAL / ANALYSIS WITH LINE, BUYER, CATEGORY, COUNT, OR RECORD OBJECT -> QUERY\n3. PROCUREMENT BU CONTEXT CHANGE -> SWITCH_CONTEXT\n4. REQUISITION OR LINE ASSIGNMENT CHANGE -> REASSIGN\n5. DEFAULT / AMBIGUOUS -> QUERY\n\n================================\nOBJECT TEST BEFORE SWITCHING\n================================\n\nBefore outputting SWITCH_CONTEXT, identify what the user is asking to change, open, load, display, or refresh.\n\nOutput SWITCH_CONTEXT only when that object is the Procurement BU context, workspace, dashboard, panels, app context, or broad workload view.\n\nOutput QUERY when the object is requisition lines, records, counts, assigned or unassigned lines, buyer workload details for a category, a buyer, a category, a supplier, a location, or another filter value.\n\nA named value after words like in, from, or for is not enough to infer a Procurement BU switch. It may be a category, buyer, supplier, location, requisition, or other business value.\n\nExamples:\n\"How many lines are assigned to Clare Furey in Miscellaneous_1 category?\" -> QUERY\n\"Show lines assigned to Pat Stock in Office Supplies category.\" -> QUERY\n\"Show buyer workload for Miscellaneous_1 category.\" -> QUERY\n\"Display workload for Vision Operations.\" -> SWITCH_CONTEXT\n\"Show workload data from Vision Services.\" -> SWITCH_CONTEXT\n\"Open the workspace for Vision Services.\" -> SWITCH_CONTEXT\n\"Switch Procurement BU to Vision Services.\" -> SWITCH_CONTEXT\n\n================================\nSTEP 1 - HELP / INSTRUCTION REQUEST\n================================\n\nIf the user is asking how to do something, requesting instructions, or asking for help, output QUERY.\n\nThis rule has highest priority, even if the message mentions switching BU, reassignment, requisitions, buyers, or specific numbers.\n\nTrigger patterns include:\n- \"how do I ...\"\n- \"how to ...\"\n- \"how can I ...\"\n- \"how would I ...\"\n- \"where do I ...\"\n- \"where can I ...\"\n- \"what's the way to ...\"\n- \"what is the process for ...\"\n- \"help me understand ...\"\n- \"can you show me how to ...\"\n- \"walk me through ...\"\n- \"explain how to ...\"\n\nExamples:\n\"How do I switch business unit?\" -> QUERY\n\"How to change procurement BU?\" -> QUERY\n\"Help me switch business unit\" -> QUERY\n\"Where do I change business unit?\" -> QUERY\n\"How do I reassign req 123 to John?\" -> QUERY\n\"Can you show me how to change buyer?\" -> QUERY\n\n================================\nSTEP 2 - PROCUREMENT BU CONTEXT CHANGE\n================================\n\nOutput SWITCH_CONTEXT only when the user is directly instructing the system to change, set, switch, refresh, open, load, or display the active Procurement Business Unit context or workspace.\n\nThis includes explicit context changes:\n- \"switch procurement BU to Vision Services\"\n- \"set BU to Vision Services\"\n- \"change business unit to Vision Operations\"\n- \"select Vision City Operations\"\n- \"update procurement business unit to Vision Services\"\n\nThis also includes implicit workspace refresh requests when the user names or implies a target Procurement BU and asks for workspace-level data, dashboard, panels, broad workload view, or the workspace itself:\n- \"show workspace data from Vision Services\"\n- \"show workload data from Vision Operations\"\n- \"display workload for Vision Operations\"\n- \"display the dashboard for Vision Services\"\n- \"open the workspace for Vision Services\"\n- \"load panels for Vision Services\"\n- \"show me Vision Services workspace\"\n\nThis also includes short follow-up confirmations when chat history shows an active BU switch flow:\n- \"Vision Operations\"\n- \"yes\"\n- \"go ahead\"\n- \"switch it\"\n- \"proceed\"\n\nImportant exclusions:\nIf the user is asking a question about switching, output QUERY.\nIf the user is asking what BU is currently set, output QUERY.\nIf the user is asking for specific requisition-line data, counts, filters, or records in a named BU, output QUERY rather than SWITCH_CONTEXT.\nExamples that remain QUERY even with a named BU:\n- \"show unassigned lines in Vision Operations\"\n- \"how many unprocessed lines are in Vision Operations\"\n- \"show lines assigned to Pat Stock in Vision Operations\"\n- \"show requisition 10505501 lines in Vision Operations\"\n- \"show buyer workload for a category\"\n- \"show buyers in a category\"\n- \"show workload details for a category\"\n- \"why is a category not balanced?\"\n\nCategory workload questions must remain QUERY. Do not classify buyer workload, buyer breakdown, buyers in a category, category workload details, or balanced/not balanced category questions as SWITCH_CONTEXT. Category names are not Procurement Business Unit names.\nIf the user is changing anything other than the procurement business unit, do not output SWITCH_CONTEXT.\n\nExamples:\n\"Switch procurement BU to Vision Services\" -> SWITCH_CONTEXT\n\"Set BU to Vision Operations\" -> SWITCH_CONTEXT\n\"Show workspace data from Vision Services\" -> SWITCH_CONTEXT\n\"Show workload data from Vision Operations\" -> SWITCH_CONTEXT\n\"Display workload for Vision Operations\" -> SWITCH_CONTEXT\n\"Open the workspace for Vision Services\" -> SWITCH_CONTEXT\n\"Show unassigned lines in Vision Operations\" -> QUERY\n\"How many lines are assigned to Clare Furey in Miscellaneous_1 category?\" -> QUERY\n\"Show buyer workload for Miscellaneous_1 category\" -> QUERY\n\"Show unassigned lines in Vision Operations\" -> QUERY\n\"How many unprocessed lines are in Vision Operations?\" -> QUERY\n\"What BU is currently set?\" -> QUERY\n\"Which procurement business unit am I in?\" -> QUERY\n\"How do I switch business unit?\" -> QUERY\n\"Change buyer to Vision Operations\" -> REASSIGN or QUERY depending on whether it is a requisition assignment command\n\"Reassign requisition 123 to Clare Furey\" -> REASSIGN\n\n================================\nSTEP 3 - READ-ONLY RETRIEVAL / ANALYSIS\n================================\n\nIf the user's primary request is to retrieve, view, list, count, search, compare, summarize, or analyze data, output QUERY.\n\nRetrieval verbs and patterns include:\n- show\n- list\n- view\n- display\n- see\n- find\n- search\n- look up\n- pull up\n- pull\n- count\n- how many\n- how much\n- get me\n- give me\n- fetch\n- tell me\n- who is\n- what is\n- where is\n- when is\n- which\n- filter\n- sort\n- group by\n- summarize\n- analyze\n- report on\n\nThe presence of words like \"assigned\", \"buyer\", or \"owner\" in a retrieval sentence does not make it REASSIGN.\n\nExamples:\n\"How many lines are unassigned?\" -> QUERY\n\"Show all requisition lines assigned to Pat Stock\" -> QUERY\n\"Who is req 123 assigned to?\" -> QUERY\n\"List unassigned lines\" -> QUERY\n\"How many lines does John have?\" -> QUERY\n\"Show all lines assigned to Clare Furey\" -> QUERY\n\"Which procurement business unit am I in?\" -> QUERY\n\"What BU is currently set?\" -> QUERY\n\"Show top categories for unassigned lines\" -> QUERY\n\"Show buyer workload for a category\" -> QUERY\n\"Show buyers in a category\" -> QUERY\n\"Why is a category not balanced?\" -> QUERY\n\n================================\nSTEP 4 - REQUISITION OR LINE ASSIGNMENT CHANGE\n================================\n\nOutput REASSIGN when the user is directly commanding a change to assignment, ownership, assignee, or buyer for requisitions or requisition lines.\n\nState-change verbs include:\n- reassign\n- assign\n- move\n- transfer\n- change buyer\n- change assignee\n- change owner\n- set buyer to\n- set assignee to\n- give, as in \"give req 123 to John\"\n\nThis rule applies to:\n- direct imperatives\n- polite imperatives\n- question-form commands\n- statements of intent\n- incomplete or imperfect reassignment commands\n\nExamples:\n\"Reassign req 10505734 to John Smith\" -> REASSIGN\n\"Please reassign req 123 to John\" -> REASSIGN\n\"Can you reassign req 123 to John?\" -> REASSIGN\n\"I need to reassign req 123 to John\" -> REASSIGN\n\"Assign req 123 line 1 to Jane Doe\" -> REASSIGN\n\"Change buyer on req 123 to John Smith\" -> REASSIGN\n\"Move all unassigned lines to Clare Furey\" -> REASSIGN\n\"Transfer req 555 to Pat Stock\" -> REASSIGN\n\"Set buyer on req 123 to John\" -> REASSIGN\n\nDo not validate correctness.\nIncomplete, misspelled, or imperfect commands still count as REASSIGN if the intent is to change assignment.\n\n================================\nTIE-BREAKERS\n================================\n\n1. Help or instruction phrasing always outputs QUERY.\n2. Retrieval/read-only phrasing with a line, buyer, category, count, record, or workload-detail object outputs QUERY.\n3. Procurement BU context change outputs SWITCH_CONTEXT only when the object is the Procurement BU context, workspace, dashboard, panels, app context, or broad workload view.\n4. Direct requisition or line assignment change outputs REASSIGN.\n5. If the message contains both a retrieval request and a separate reassignment command, classify by the primary request. If unclear, output QUERY.\n6. If ambiguous, output QUERY.\n\n================================\nFINAL INSTRUCTION\n================================\n\nOutput exactly one value:\n\nSWITCH_CONTEXT\n\nor\n\nQUERY\n\nor\n\nREASSIGN"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "DetermineBalancedNotBalanced",
            "returnType": "object",
            "sourceCode": "const input = $context.$nodes.NORMALIZETOP5CATEGORIESRESPONSE.$output.result;\nconst categories = Array.isArray(input?.topCategories) ? input.topCategories : [];\nconst results = [];\nlet finalResults = {};\n\nconst PCT = 0.15;\nconst ABS_SPREAD = 2;  // absolute threshold (req lines)\n\nfor (let i = 0; i < categories.length; i++) {\n  const c = categories[i];\n  const categoryId = c?.categoryId;\n  const categoryName = c?.categoryName;\n  const stats = c?.buyerLoadStats;\n\n  const avg = stats?.avg;\n  const min = stats?.min;\n  const max = stats?.max;\n\n  const avgOk = typeof avg === \"number\" && Number.isFinite(avg);\n  const minOk = typeof min === \"number\" && Number.isFinite(min);\n  const maxOk = typeof max === \"number\" && Number.isFinite(max);\n\n  let status, reason;\n\n  if (!avgOk || !minOk || !maxOk) {\n    status = \"Balanced\";\n    reason = \"Missing/invalid buyerLoadStats; defaulted to Balanced per policy\";\n  } else if (avg <= 0) {\n    status = \"Balanced\";\n    reason = \"Non-positive avg; defaulted to Balanced per policy\";\n  } else {\n    const lower = avg * (1 - PCT);\n    const upper = avg * (1 + PCT);\n\n    const pctBalanced = (min >= lower) && (max <= upper);\n    const absBalanced = (max - min) <= ABS_SPREAD;\n\n    const balanced = pctBalanced || absBalanced;\n\n    if (balanced) {\n      status = \"Balanced\";\n      if (pctBalanced && absBalanced) {\n        reason = `Both thresholds met: within ��${Math.round(PCT * 100)}% and spread ���${ABS_SPREAD} req lines`;\n      } else if (pctBalanced) {\n        reason = `All buyer loads within ��${Math.round(PCT * 100)}% of the mean`;\n      } else {\n        reason = `Spread within absolute threshold (���${ABS_SPREAD} req lines)`;\n      }\n    } else {\n      status = \"Not Balanced\";\n      reason = `Outside ��${Math.round(PCT * 100)}% band and spread exceeds absolute threshold (>${ABS_SPREAD} req lines)`;\n    }\n  }\n\n  results.push({ categoryId, categoryName, status, reason });\n}\n\nfinalResults = { results };\nreturn finalResults;"
          },
          "outcomes": {
            "success": "1774466255326"
          },
          "code": "DETERMINEBALANCEDNOTBALANCED",
          "id": "1774450251924",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "ParseOraAction",
            "returnType": "object",
            "sourceCode": "function baseResult(error, extra) {\n  const result = {\n    isValid: false,\n    error: error || \"Invalid OraAction\",\n    actionName: \"\",\n    sourceType: \"unknown\",\n    payload: {}\n  };\n\n  if (extra && typeof extra === \"object\") {\n    for (const key of Object.keys(extra)) {\n      result[key] = extra[key];\n    }\n  }\n\n  return result;\n}\n\nfunction parseJsonWithEscapedFallbacks(text) {\n  try {\n    return { parsed: true, value: JSON.parse(text) };\n  } catch (e1) {\n    try {\n      return { parsed: true, value: JSON.parse(String(text).replace(/\\\\\\\\\\\"/g, '\\\\\"')) };\n    } catch (e2) {\n      try {\n        return { parsed: true, value: JSON.parse(String(text).replace(/\\\\\\\"/g, '\"')) };\n      } catch (e3) {\n        return { parsed: false, value: null };\n      }\n    }\n  }\n}\n\nfunction tryParseJsonLoose(value) {\n  let current = value;\n  for (let i = 0; i < 3; i++) {\n    if (typeof current !== \"string\") return current;\n    const trimmed = current.trim();\n    if (!trimmed) return current;\n    try {\n      current = JSON.parse(trimmed);\n    } catch (e) {\n      return current;\n    }\n  }\n  return current;\n}\n\nfunction normalizeReassignmentPayloads(value) {\n  if (Array.isArray(value)) return value;\n\n  const parsedValue = tryParseJsonLoose(value);\n  if (Array.isArray(parsedValue)) return parsedValue;\n\n  if (parsedValue && typeof parsedValue === \"object\" && !Array.isArray(parsedValue)) {\n    return [parsedValue];\n  }\n\n  if (typeof parsedValue === \"string\" && parsedValue.trim() !== \"\") {\n    const wrapped = tryParseJsonLoose(\"[\" + parsedValue + \"]\");\n    if (Array.isArray(wrapped)) return wrapped;\n  }\n\n  return [];\n}\n\nfunction normalizeBuyerIdNameMapping(value) {\n  if (value && typeof value === \"object\" && !Array.isArray(value)) return value;\n\n  const parsedValue = tryParseJsonLoose(value);\n  if (parsedValue && typeof parsedValue === \"object\" && !Array.isArray(parsedValue)) {\n    return parsedValue;\n  }\n\n  return {};\n}\n\nfunction normalizeActionPayload(actionName, actionBody) {\n  const normalizedPayload = actionBody && typeof actionBody === \"object\" && !Array.isArray(actionBody)\n    ? { ...actionBody }\n    : {};\n\n  if (actionName === \"ExecuteReassignment\") {\n    normalizedPayload.reassignment_payloads = normalizeReassignmentPayloads(normalizedPayload.reassignment_payloads);\n    normalizedPayload.buyerIdNameMapping = normalizeBuyerIdNameMapping(normalizedPayload.buyerIdNameMapping);\n  }\n\n  return normalizedPayload;\n}\n\nfunction payloadFromFormFields(fields) {\n  const formPayload = {};\n  const entries = Array.isArray(fields) ? fields : [];\n\n  for (const item of entries) {\n    if (item && typeof item === \"object\" && Object.prototype.hasOwnProperty.call(item, \"id\")) {\n      formPayload[String(item.id)] = item.value;\n    }\n  }\n\n  return formPayload;\n}\n\nfunction parseActionString(text) {\n  const separatorIndex = text.indexOf(\":\");\n\n  if (separatorIndex <= 0) {\n    return baseResult(\"Invalid format. Expected <ActionName>:{...}\", { rawAction: text });\n  }\n\n  const actionName = text.slice(0, separatorIndex).trim();\n  const payloadText = text.slice(separatorIndex + 1).trim();\n\n  if (!actionName) {\n    return baseResult(\"Action name is missing\", { rawAction: text });\n  }\n\n  if (!payloadText) {\n    return baseResult(\"Request body is missing\", { actionName, sourceType: \"actionString\", rawAction: text });\n  }\n\n  const parsedPayload = parseJsonWithEscapedFallbacks(payloadText);\n  if (!parsedPayload.parsed) {\n    return baseResult(\"Request body is not valid JSON\", {\n      actionName,\n      sourceType: \"actionString\",\n      payloadText\n    });\n  }\n\n  if (parsedPayload.value === null || Array.isArray(parsedPayload.value) || typeof parsedPayload.value !== \"object\") {\n    return baseResult(\"Request body must be a JSON object\", { actionName, sourceType: \"actionString\" });\n  }\n\n  return {\n    isValid: true,\n    actionName,\n    sourceType: \"actionString\",\n    payload: normalizeActionPayload(actionName, parsedPayload.value)\n  };\n}\n\nfunction parseObjectAction(actionObject, sourceType) {\n  const actionName = String(actionObject.actionName || actionObject.name || \"\").trim();\n  if (!actionName) {\n    return baseResult(\"Object OraAction is missing actionName\", { sourceType, payload: actionObject });\n  }\n\n  const objectPayload = actionObject.payload && typeof actionObject.payload === \"object\" && !Array.isArray(actionObject.payload)\n    ? { ...actionObject.payload }\n    : { ...actionObject };\n  delete objectPayload.actionName;\n  delete objectPayload.name;\n\n  return {\n    isValid: true,\n    actionName,\n    sourceType,\n    payload: normalizeActionPayload(actionName, objectPayload)\n  };\n}\n\nconst rawValue = $context.$app.$OraAction;\n\nif (rawValue && typeof rawValue === \"object\" && !Array.isArray(rawValue)) {\n  return parseObjectAction(rawValue, \"object\");\n}\n\nconst text = String(rawValue || \"\").trim();\nif (!text) {\n  return baseResult(\"Input text is empty\");\n}\n\nif (text[0] === \"{\") {\n  const parsedObjectText = parseJsonWithEscapedFallbacks(text);\n  if (parsedObjectText.parsed && parsedObjectText.value && typeof parsedObjectText.value === \"object\" && !Array.isArray(parsedObjectText.value)) {\n    return parseObjectAction(parsedObjectText.value, \"objectString\");\n  }\n}\n\nconst formSubmitMatch = text.match(/<oraFormSubmit\\s+id=[\"']([^\"']*)[\"'][^>]*>([\\s\\S]*?)<\\/oraFormSubmit>/);\nif (formSubmitMatch) {\n  const formId = String(formSubmitMatch[1] || \"\").trim();\n  const formContent = String(formSubmitMatch[2] || \"\").trim();\n  const parsedFields = parseJsonWithEscapedFallbacks(formContent);\n\n  if (!parsedFields.parsed || !Array.isArray(parsedFields.value)) {\n    return baseResult(\"Form submit payload is not a valid JSON field array\", {\n      actionName: \"ExecuteReassignment\",\n      sourceType: \"formSubmit\",\n      formId\n    });\n  }\n\n  return {\n    isValid: true,\n    actionName: \"ExecuteReassignment\",\n    sourceType: \"formSubmit\",\n    formId,\n    payload: normalizeActionPayload(\"ExecuteReassignment\", payloadFromFormFields(parsedFields.value))\n  };\n}\n\nreturn parseActionString(text);"
          },
          "outcomes": {
            "success": "1775334873032"
          },
