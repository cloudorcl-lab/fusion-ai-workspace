        {
          "metadata": {
            "name": "GenerateReassignment",
            "returnType": "object",
            "sourceCode": "// MODE A - Node 1 of 2\n// ------------------------------------------------------------\n// GenerateReassignmentPlanModeA\n//\n// Purpose:\n// - Read normalized requisition lines\n// - Compute current loads per buyer\n// - Decide if workload is already balanced\n// - If not balanced, create transferPlan with counts only:\n//     [{ fromBuyerId, toBuyerId, count }]\n//\n// NOTE:\n// - This node is MODE A only (line-level reassignment allowed)\n// - This node does NOT materialize lineIds and does NOT chunk payloads\n// ------------------------------------------------------------\n\nconst lines = $context.$nodes.NORMALIZEREQLINESTOREASSIGN.$output.result || [];\n\nconst PCT = 0.15;\nconst ABS_SPREAD = 2;\nconst UNASSIGNED_BUYER_ID = \"-1\";\n\n// Set this value directly when you want chunking (example: 30).\n// Keep it null/undefined/0 to disable chunking.\nconst MANUAL_MAX_LINES_PER_PAYLOAD = null;\n\nconst inputMax = Number(MANUAL_MAX_LINES_PER_PAYLOAD);\nconst maxLinesPerPayload =\n  Number.isFinite(inputMax) && inputMax > 0\n    ? Math.floor(inputMax)\n    : null;\n\nconst compareIds = (a, b) => {\n  const as = String(a);\n  const bs = String(b);\n  if (as === bs) return 0;\n\n  const an = Number(as);\n  const bn = Number(bs);\n  const safeInts =\n    Number.isSafeInteger(an) &&\n    Number.isSafeInteger(bn) &&\n    String(an) === as &&\n    String(bn) === bs;\n\n  if (safeInts) return an - bn;\n\n  try {\n    const ab = BigInt(as);\n    const bb = BigInt(bs);\n    return ab < bb ? -1 : 1;\n  } catch (e) {\n    return as < bs ? -1 : 1;\n  }\n};\n\nconst checkBalanced = (loads, eligibleBuyerIds, mean) => {\n  let maxLoad = -Infinity;\n  let minLoad = Infinity;\n  let withinPct = true;\n\n  for (const bid of eligibleBuyerIds) {\n    const v = loads[bid] || 0;\n    if (v > maxLoad) maxLoad = v;\n    if (v < minLoad) minLoad = v;\n\n    if (mean !== 0 && Math.abs(v - mean) > PCT * mean) {\n      withinPct = false;\n    }\n  }\n\n  const spreadOk = (maxLoad - minLoad) <= ABS_SPREAD;\n  return withinPct || spreadOk;\n};\n\nlet result = {\n  isBalanced: true,\n  eligibleBuyerIds: [],\n  transferPlan: [],\n  maxLinesPerPayload\n};\n\nif (Array.isArray(lines) && lines.length > 0) {\n  // Build buyer set and loads from input lines\n  const buyerSet = {};\n  const loads = {};\n\n  for (const row of lines) {\n    const buyerId = String(row?.buyerId);\n    if (!buyerSet[buyerId]) buyerSet[buyerId] = true;\n    loads[buyerId] = (loads[buyerId] || 0) + 1;\n  }\n\n  const buyerIds = Object.keys(buyerSet).sort(compareIds);\n  const eligibleBuyerIds = buyerIds.filter((bid) => bid !== UNASSIGNED_BUYER_ID);\n\n  if (eligibleBuyerIds.length === 0) {\n    result = {\n      isBalanced: true,\n      eligibleBuyerIds,\n      transferPlan: [],\n      maxLinesPerPayload\n    };\n  } else {\n    const total = lines.length;\n    const mean = total / eligibleBuyerIds.length;\n\n    let balanced = checkBalanced(loads, eligibleBuyerIds, mean);\n    if ((loads[UNASSIGNED_BUYER_ID] || 0) > 0) balanced = false;\n\n    if (balanced) {\n      result = {\n        isBalanced: true,\n        eligibleBuyerIds,\n        transferPlan: [],\n        maxLinesPerPayload\n      };\n    } else {\n      // Deterministic target distribution across eligible buyers\n      const base = Math.floor(total / eligibleBuyerIds.length);\n      const rem = total - base * eligibleBuyerIds.length;\n\n      const target = {};\n      for (let i = 0; i < eligibleBuyerIds.length; i++) {\n        target[eligibleBuyerIds[i]] = base + (i < rem ? 1 : 0);\n      }\n\n      // Build donors/receivers from load deltas\n      const donors = [];\n      const receivers = [];\n\n      for (const bid of buyerIds) {\n        const t = target[bid] || 0;\n        const s = (loads[bid] || 0) - t;\n\n        if (s > 0) donors.push({ buyerId: bid, surplus: s, load: loads[bid] || 0 });\n        if (s < 0 && bid !== UNASSIGNED_BUYER_ID) {\n          receivers.push({ buyerId: bid, deficit: -s, load: loads[bid] || 0 });\n        }\n      }\n\n      donors.sort((x, y) => {\n        if (x.load !== y.load) return y.load - x.load; // desc\n        return compareIds(x.buyerId, y.buyerId); // asc\n      });\n\n      receivers.sort((x, y) => {\n        if (x.load !== y.load) return x.load - y.load; // asc\n        return compareIds(x.buyerId, y.buyerId); // asc\n      });\n\n      // Count-only transfer plan\n      const transferPlan = [];\n      let dIdx = 0;\n      let rIdx = 0;\n\n      while (dIdx < donors.length && rIdx < receivers.length) {\n        const donor = donors[dIdx];\n        const recv = receivers[rIdx];\n\n        if (donor.surplus <= 0) {\n          dIdx++;\n          continue;\n        }\n        if (recv.deficit <= 0) {\n          rIdx++;\n          continue;\n        }\n\n        const moveCount = donor.surplus < recv.deficit ? donor.surplus : recv.deficit;\n        if (moveCount > 0) {\n          transferPlan.push({\n            fromBuyerId: donor.buyerId,\n            toBuyerId: recv.buyerId,\n            count: moveCount\n          });\n        }\n\n        donor.surplus -= moveCount;\n        recv.deficit -= moveCount;\n      }\n\n      result = {\n        isBalanced: false,\n        eligibleBuyerIds,\n        transferPlan,\n        maxLinesPerPayload\n      };\n    }\n  }\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1775847503648"
          },
