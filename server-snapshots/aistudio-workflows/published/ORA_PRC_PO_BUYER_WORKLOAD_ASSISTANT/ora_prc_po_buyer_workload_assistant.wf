          "id": "1782000000005",
          "code": "VALIDATE_REASSIGNMENT_REASON",
          "type": "CODE",
          "metadata": {
            "name": "Validate Reassignment Reason",
            "description": "Validates submitted reassignment reason before invoking ReassignBuyer.",
            "sourceCode": "function text(value) {\n  return value == null ? \"\" : String(value);\n}\n\nconst payload = $context.$nodes.PARSEORAACTION?.$output?.result?.payload || {};\nconst rawReason = text(payload.reassignment_reason);\nconst trimmedReason = rawReason.trim();\n\nif (!trimmedReason) {\n  return {\n    isValid: false,\n    validationCode: \"POR-2011498\",\n    validationMessage: \"You must provide a reason for reassigning the assigned buyer on requisition lines. (POR-2011498)\"\n  };\n}\n\nif (rawReason.length > 240) {\n  return {\n    isValid: false,\n    validationCode: \"POR-2011488\",\n    validationMessage: \"The reason for returning requisition lines or reassigning the buyer can't exceed 240 characters. (POR-2011488)\"\n  };\n}\n\nreturn {\n  isValid: true,\n  validationCode: \"\",\n  validationMessage: \"\"\n};",
            "returnType": "object"
          },
