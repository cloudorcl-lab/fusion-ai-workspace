            "sourceCode": "const response = $context.$nodes.GETREQLINESTOREASSIGN.$output;\n\nconst results = response.hits.hits.map(hit => ({\n    buyerName: hit._source.buyer?.name ?? null,\n    buyerId: hit._source.buyerId ?? -1,\n    requisitionHeaderId: hit._source.requisitionHeaderId,\n    requisitionLineId: hit._source.requisitionLineId\n}));\n\nreturn results;"
