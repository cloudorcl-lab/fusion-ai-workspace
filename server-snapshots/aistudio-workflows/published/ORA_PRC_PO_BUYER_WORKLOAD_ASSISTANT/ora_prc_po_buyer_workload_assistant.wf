        },
        {
          "metadata": {
            "name": "DirectCalculateTargetBuyerPreview",
            "returnType": "array",
            "sourceCode": "const prepared = $context.$nodes.PREPARE_REASSIGNMENT_PAYLOAD?.$output?.result || {};\nconst searchOutput = $context.$nodes.INVOKE_ELASTIC_SEARCH?.$output || {};\n\nfunction firstDefined(...values) {\n  return values.find(value => value !== null && value !== undefined && value !== '');\n}\n\nconst searchRoot = searchOutput.result || searchOutput;\nconst beforeValue = firstDefined(\n  searchRoot?.aggregations?.targetBuyerCurrentLoad?.targetBuyerLines?.doc_count,\n  searchRoot?.result?.aggregations?.targetBuyerCurrentLoad?.targetBuyerLines?.doc_count,\n  searchRoot?.aggregations?.target_buyer_current_load?.target_buyer_lines?.doc_count,\n  searchRoot?.result?.aggregations?.target_buyer_current_load?.target_buyer_lines?.doc_count,\n  0\n);\nconst targetBeforeCount = Number.isFinite(Number(beforeValue)) ? Number(beforeValue) : 0;\nconst lineCount = Number.isFinite(Number(prepared.lineCount)) ? Number(prepared.lineCount) : 0;\nconst targetBuyerId = prepared.reassignToBuyerId ?? prepared.payloadObject?.reassignToBuyerId;\nconst targetBuyerName = prepared.targetBuyerName || 'Target buyer';\nconst sourceBuyerId = prepared.sourceBuyerId;\nconst sourceBuyerName = prepared.sourceBuyerName;\n\nconst rows = [];\n\nif (sourceBuyerId || sourceBuyerName) {\n  rows.push({\n    buyerId: sourceBuyerId,\n    buyerName: sourceBuyerName || 'Source buyer',\n    docCountBeforeRebalancing: lineCount,\n    docCountAfterRebalancing: 0,\n    reassignableLineCount: lineCount,\n    alreadyAssignedLineCount: 0,\n    role: 'Source'\n  });\n}\n\nrows.push({\n  buyerId: targetBuyerId,\n  buyerName: targetBuyerName,\n  docCountBeforeRebalancing: targetBeforeCount,\n  docCountAfterRebalancing: targetBeforeCount + lineCount,\n  reassignableLineCount: lineCount,\n  alreadyAssignedLineCount: Number.isFinite(Number(prepared.alreadyAssignedLineCount)) ? Number(prepared.alreadyAssignedLineCount) : 0,\n  role: 'Target'\n});\n\nreturn rows;"
          },
