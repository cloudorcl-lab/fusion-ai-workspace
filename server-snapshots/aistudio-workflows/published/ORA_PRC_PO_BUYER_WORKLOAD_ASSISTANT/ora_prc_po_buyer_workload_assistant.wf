        {
          "metadata": {
            "name": "ExtractBuyerIdNameMapping",
            "returnType": "object",
            "sourceCode": "const inputArray = $context.$nodes.CALCULATEWORKLOADBEFOREREASSIGNMENT.$output.result || [];\nconst mapping = {};\nfor (const item of inputArray) {\n  if (item.buyerId && item.buyerName) {\n    mapping[item.buyerId] = item.buyerName;\n  }\n}\nreturn mapping;"
          },
          "outcomes": {
            "success": "1775114092871"
          },
          "code": "EXTRACTBUYERIDNAMEMAPPING",
          "id": "1776229305677",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "description": "Builds the reassignBuyer payload from buyer lookup output and ES hits.",
            "name": "Prepare Reassignment Payload",
            "returnType": "object",
            "sourceCode": "const request = $context.$nodes.NORMALIZE_REASSIGNMENT_REQUEST?.$output?.result || {};\nconst buyerOutput = $context.$nodes.GET_BUYER_INFO?.$output || {};\nconst sourceBuyerOutput = $context.$nodes.GET_SOURCE_BUYER_INFO?.$output || {};\nconst builtQuery = $context.$nodes.BUILD_ELASTIC_SEARCH_QUERY?.$output?.result || {};\nconst searchOutput = $context.$nodes.INVOKE_ELASTIC_SEARCH?.$output || {};\n\nfunction firstDefined(...values) {\n  return values.find(value => value !== null && value !== undefined && value !== '');\n}\n\nfunction compact(value) {\n  return value === null || value === undefined ? '' : String(value).trim();\n}\n\nfunction buyerIdFrom(item) {\n  return firstDefined(\n    item?.AgentId,\n    item?.agentId,\n    item?.BuyerId,\n    item?.buyerId,\n    item?.id\n  );\n}\n\nfunction buyerItemsFrom(output) {\n  const root = output.result || output;\n  return Array.isArray(root.items)\n    ? root.items\n    : (root && typeof root === 'object' && Object.keys(root).length ? [root] : []);\n}\n\nfunction buyerDisplayName(item, fallback) {\n  return compact(firstDefined(\n    item?.DisplayName,\n    item?.displayName,\n    item?.Name,\n    item?.name,\n    item?.AgentName,\n    item?.agentName,\n    fallback\n  ));\n}\n\nfunction lineIdFrom(row) {\n  return firstDefined(row?.requisitionLineId, row?.RequisitionLineId, row?.lineId, row?.LineId);\n}\n\nfunction currentBuyerIdFrom(row) {\n  return firstDefined(row?.buyerId, row?.BuyerId, row?.buyer?.id, row?.buyer?.Id);\n}\n\nconst buyerMatches = buyerItemsFrom(buyerOutput).filter(item => buyerIdFrom(item) !== null && buyerIdFrom(item) !== undefined && buyerIdFrom(item) !== '');\nconst buyerItem = buyerMatches[0] || {};\nconst reassignToBuyerId = buyerIdFrom(buyerItem);\nconst targetBuyerKey = compact(reassignToBuyerId);\nconst buyerMatchCount = buyerMatches.length;\nconst resolvedBuyerName = buyerDisplayName(buyerItem, request.assigneeName);\n\nconst sourceBuyerMatches = request.sourceBuyerName\n  ? buyerItemsFrom(sourceBuyerOutput).filter(item => buyerIdFrom(item) !== null && buyerIdFrom(item) !== undefined && buyerIdFrom(item) !== '')\n  : [];\nconst sourceBuyerItem = sourceBuyerMatches[0] || {};\nconst sourceBuyerId = firstDefined(builtQuery.sourceBuyerId, buyerIdFrom(sourceBuyerItem));\nconst sourceBuyerName = request.sourceBuyerName ? buyerDisplayName(sourceBuyerItem, request.sourceBuyerName) : '';\n\nconst searchRoot = searchOutput.result || searchOutput;\nconst esHits = searchRoot?.hits?.hits || searchRoot?.result?.hits?.hits || [];\nconst itemRows = Array.isArray(searchRoot.items) ? searchRoot.items : [];\nconst rows = esHits.length ? esHits.map(hit => hit?._source || hit) : itemRows;\nconst totalHitsValue = searchRoot?.hits?.total?.value ?? searchRoot?.result?.hits?.total?.value ?? searchRoot?.hits?.total;\nconst totalHits = Number.isFinite(Number(totalHitsValue)) ? Number(totalHitsValue) : rows.length;\n\nconst lineIds = [];\nconst reassignmentLineIds = [];\nconst alreadyAssignedLineIds = [];\nconst seenLineIds = {};\n\nfor (const row of rows) {\n  const rawLineId = lineIdFrom(row);\n  if (rawLineId === null || rawLineId === undefined || rawLineId === '') continue;\n\n  const lineId = String(rawLineId);\n  if (seenLineIds[lineId]) continue;\n  seenLineIds[lineId] = true;\n  lineIds.push(lineId);\n\n  const currentBuyerKey = compact(currentBuyerIdFrom(row));\n  if (targetBuyerKey && currentBuyerKey && currentBuyerKey === targetBuyerKey) {\n    alreadyAssignedLineIds.push(lineId);\n  } else {\n    reassignmentLineIds.push(lineId);\n  }\n}\n\nconst uniqueLineIds = lineIds;\nconst uniqueReassignmentLineIds = reassignmentLineIds;\nconst hasExactLine = Boolean(request.requisitionNumber) && request.lineNumber !== null && request.lineNumber !== undefined && !Number.isNaN(Number(request.lineNumber));\nconst isReqOnly = Boolean(request.requisitionNumber) && !hasExactLine;\nconst isBulk = request.scope === 'bulk' && !request.requisitionNumber;\nconst hasFuzzyScope = Boolean(request.categoryName || request.deliverToLocation);\nconst resultCount = Math.max(uniqueLineIds.length, totalHits || 0);\n\nconst buyerAmbiguous = buyerMatchCount !== 1;\nconst sourceBuyerAmbiguous = Boolean(request.sourceBuyerName) && sourceBuyerMatches.length !== 1;\nconst lineSelectionAmbiguous =\n  uniqueLineIds.length !== 1 ||\n  isBulk ||\n  hasFuzzyScope ||\n  Boolean(request.sourceBuyerName) ||\n  (isReqOnly && uniqueLineIds.length > 1);\n\nconst guardrailReasons = [];\nif (buyerMatchCount === 0) guardrailReasons.push('Target buyer could not be uniquely resolved.');\nif (buyerMatchCount > 1) guardrailReasons.push('Target buyer name matched more than one buyer.');\nif (request.sourceBuyerName && sourceBuyerMatches.length === 0) guardrailReasons.push('Source buyer could not be uniquely resolved.');\nif (request.sourceBuyerName && sourceBuyerMatches.length > 1) guardrailReasons.push('Source buyer name matched more than one buyer.');\nif (isBulk) guardrailReasons.push('Bulk reassignment requires preview and submit before modifying requisition lines.');\nif (hasFuzzyScope) guardrailReasons.push('Category or deliver-to location filters require preview and submit because they can match multiple values.');\nif (request.sourceBuyerName) guardrailReasons.push('Source buyer filters require preview and submit before modifying requisition lines.');\nif (isReqOnly && uniqueLineIds.length > 1) guardrailReasons.push('The requisition contains multiple matching lines and no specific line was provided.');\nif (!isBulk && !hasFuzzyScope && !request.sourceBuyerName && uniqueLineIds.length > 1 && !isReqOnly) guardrailReasons.push('More than one requisition line matched the request.');\nif (uniqueLineIds.length === 0) guardrailReasons.push('No matching requisition lines were found.');\nif (uniqueLineIds.length > 0 && uniqueReassignmentLineIds.length === 0 && !buyerAmbiguous) guardrailReasons.push('All matching requisition lines are already assigned to the target buyer.');\n\nconst linePreview = rows.slice(0, 10).map(row => ({\n  requisitionNumber: compact(firstDefined(row?.header?.requisitionNumber, row?.requisitionNumber, row?.RequisitionNumber)),\n  lineNumber: compact(firstDefined(row?.lineNumber, row?.LineNumber)),\n  requisitionLineId: compact(lineIdFrom(row)),\n  currentBuyer: compact(firstDefined(row?.buyerName, row?.buyer?.name, row?.buyerId)) || 'Unassigned',\n  category: compact(firstDefined(row?.itemCategory?.name, row?.categoryId)),\n  deliverToLocation: compact(firstDefined(row?.deliverToLocation, row?.deliverToLocationName)),\n  alreadyAssignedToTargetBuyer: targetBuyerKey !== '' && compact(currentBuyerIdFrom(row)) === targetBuyerKey\n}));\n\nconst canPreviewAndSubmit = Boolean(reassignToBuyerId) && !buyerAmbiguous && !sourceBuyerAmbiguous && uniqueReassignmentLineIds.length > 0;\nconst payloadObject = canPreviewAndSubmit ? {\n  reassignToBuyerId: Number(reassignToBuyerId),\n  requisitionLineIds: uniqueReassignmentLineIds.join(','),\n  reassignReason: 'Reassigned for workload balancing'\n} : null;\n\nreturn {\n  ready: canPreviewAndSubmit,\n  executable: false,\n  reason: canPreviewAndSubmit ? null : guardrailReasons.join(' ') || 'The request needs clarification before any requisition line is modified.',\n  guardrail: {\n    requiresConfirmation: canPreviewAndSubmit,\n    buyerAmbiguous,\n    sourceBuyerAmbiguous,\n    lineSelectionAmbiguous,\n    reasons: guardrailReasons,\n    matchedLineCount: resultCount,\n    reassignableLineCount: uniqueReassignmentLineIds.length,\n    alreadyAssignedLineCount: alreadyAssignedLineIds.length,\n    alreadyAssignedLineIds,\n    previewLineCount: linePreview.length,\n    linePreview,\n    buyerMatchCount,\n    sourceBuyerMatchCount: sourceBuyerMatches.length,\n    buyerMatches: buyerMatches.slice(0, 5).map(item => ({\n      displayName: buyerDisplayName(item, ''),\n      agentId: compact(buyerIdFrom(item)),\n      procurementBU: compact(firstDefined(item?.ProcurementBU, item?.procurementBU, item?.ProcurementBuId, item?.procurementBuId))\n    })),\n    sourceBuyerMatches: sourceBuyerMatches.slice(0, 5).map(item => ({\n      displayName: buyerDisplayName(item, ''),\n      agentId: compact(buyerIdFrom(item)),\n      procurementBU: compact(firstDefined(item?.ProcurementBU, item?.procurementBU, item?.ProcurementBuId, item?.procurementBuId))\n    }))\n  },\n  targetBuyerName: resolvedBuyerName,\n  sourceBuyerName,\n  sourceBuyerId: sourceBuyerId != null && sourceBuyerId !== '' ? Number(sourceBuyerId) : null,\n  sourceBuyerMatchCount: sourceBuyerMatches.length,\n  reassignToBuyerId: reassignToBuyerId != null ? Number(reassignToBuyerId) : null,\n  lineCount: uniqueReassignmentLineIds.length,\n  matchedLineCount: resultCount,\n  alreadyAssignedLineCount: alreadyAssignedLineIds.length,\n  payloadObject,\n  request\n};"
          },
          "outcomes": {
            "success": "1777315565440"
          },
          "code": "PREPARE_REASSIGNMENT_PAYLOAD",
