          "code": "CHECK_SOURCE_BUYER_LOOKUP_NEEDED",
          "convergenceTargetId": "1777315477014",
          "id": "1782000000001",
          "inputs": [
            {
              "id": "1782000000001_condition",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.NORMALIZE_REASSIGNMENT_REQUEST.$output.result.sourceBuyerName !== null && $context.$nodes.NORMALIZE_REASSIGNMENT_REQUEST.$output.result.sourceBuyerName !== undefined && $context.$nodes.NORMALIZE_REASSIGNMENT_REQUEST.$output.result.sourceBuyerName !== ''}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Prepare Read Only Query Display Data",
            "returnType": "object",
            "sourceCode": "const built = $context.$nodes.BUILD_READONLY_ELASTIC_QUERY?.$output?.result || {};\nconst request = built.request || {};\nconst searchOutput = $context.$nodes.INVOKE_READONLY_ELASTIC_SEARCH?.$output || {};\nconst root = searchOutput.result || searchOutput;\n\nfunction firstDefined(...values) {\n  return values.find(value => value !== null && value !== undefined && value !== '');\n}\n\nfunction compact(value) {\n  return value === null || value === undefined ? '' : String(value).trim();\n}\n\nfunction totalHitsFrom(value) {\n  const total = firstDefined(value?.hits?.total?.value, value?.result?.hits?.total?.value, value?.hits?.total, 0);\n  return Number.isFinite(Number(total)) ? Number(total) : 0;\n}\n\nfunction localizedName(value) {\n  if (!value || typeof value !== 'object') return compact(value);\n  const keys = Object.keys(value);\n  return keys.length ? compact(value[keys[0]]) : '';\n}\n\nfunction buyerName(row) {\n  return compact(firstDefined(row?.buyerName, row?.buyer?.name)) || 'Unknown buyer';\n}\n\nfunction searchErrorMessage() {\n  return 'I could not retrieve requisition line data right now. Please try again.';\n}\n\nfunction hasSearchError(value) {\n  const status = Number(firstDefined(value?.status, value?.statusCode, value?.result?.status, value?.result?.statusCode));\n  return Boolean(value?.error || value?.errors || value?.result?.error || value?.result?.errors || (Number.isFinite(status) && status >= 400));\n}\n\nfunction hasHitsEnvelope(value) {\n  return Boolean(value?.hits || value?.result?.hits);\n}\n\nfunction filterLabel() {\n  const parts = [];\n  if (request.status === 'unassigned') parts.push('unassigned');\n  if (request.processingStatus === 'unprocessed') parts.push('unprocessed');\n  if (request.assigneeName) parts.push('assigned to ' + request.assigneeName);\n  if (request.categoryName) parts.push('in category ' + request.categoryName);\n  if (request.deliverToLocation) parts.push('with deliver-to location ' + request.deliverToLocation);\n  if (request.requisitionNumber) parts.push('for requisition ' + request.requisitionNumber);\n  return parts.length ? parts.join(' ') : 'matching';\n}\n\nfunction dateQualifier() {\n  return request.creationDateLabel ? request.creationDateLabel : '';\n}\n\nfunction resultNounPhrase() {\n  const before = [];\n  const after = [];\n\n  if (request.status === 'unassigned') before.push('unassigned');\n  if (request.processingStatus === 'unprocessed') before.push('unprocessed');\n  if (request.assigneeName) after.push('assigned to ' + request.assigneeName);\n  if (request.categoryName) after.push('in category ' + request.categoryName);\n  if (request.deliverToLocation) after.push('with deliver-to location ' + request.deliverToLocation);\n  if (request.requisitionNumber) after.push('for requisition ' + request.requisitionNumber);\n  if (dateQualifier()) after.push(dateQualifier());\n\n  const noun = 'requisition lines';\n  return before.concat(noun, after).filter(Boolean).join(' ');\n}\n\nif (built.mode === 'error' || hasSearchError(searchOutput) || !hasHitsEnvelope(searchOutput)) {\n  const message = searchErrorMessage();\n  return {\n    mode: 'error',\n    request,\n    title: 'Requisition Line Query Unavailable',\n    description: message,\n    emptyMessage: message,\n    countMessage: message,\n    total: 0,\n    displayedCount: 0,\n    filterLabel: filterLabel(),\n    dateQualifier: dateQualifier(),\n    procurementBUName: compact(request.procurementBUName) || 'the current Procurement BU',\n    rows: []\n  };\n}\n\nconst total = totalHitsFrom(root);\nconst buName = compact(request.procurementBUName) || 'the current Procurement BU';\nconst title = request.assigneeName\n  ? 'Requisition Lines Assigned to ' + request.assigneeName\n  : 'Matching Requisition Lines';\nconst countMessage = 'There are ' + total + ' ' + resultNounPhrase() + ' in ' + buName + '.';\nconst emptyMessage = 'I did not find any ' + resultNounPhrase() + ' in ' + buName + '.';\n\nif (built.mode === 'count') {\n  return {\n    mode: 'count',\n    request,\n    title,\n    description: countMessage,\n    emptyMessage,\n    countMessage,\n    total,\n    displayedCount: 0,\n    filterLabel: filterLabel(),\n    dateQualifier: dateQualifier(),\n    procurementBUName: buName,\n    rows: []\n  };\n}\n\nconst hits = root?.hits?.hits || root?.result?.hits?.hits || [];\nconst defaultDisplayLimit = 10;\nconst remainingAfterDefault = Math.max(0, total - defaultDisplayLimit);\nconst displayLimit = remainingAfterDefault > 0 && remainingAfterDefault < 5\n  ? Math.min(total, hits.length)\n  : defaultDisplayLimit;\nconst sourceRows = hits.map(hit => hit?._source || hit).slice(0, displayLimit);\nconst rows = sourceRows.map(row => ({\n  requisition: compact(firstDefined(row?.header?.requisitionNumber, row?.requisitionNumber, row?.RequisitionNumber)) || 'Unknown req',\n  line: compact(firstDefined(row?.lineNumber, row?.LineNumber)) || 'Unknown line',\n  buyer: buyerName(row),\n  category: compact(firstDefined(localizedName(row?.itemCategory?.name), row?.categoryName, row?.categoryId)) || '-',\n  deliverToLocation: compact(firstDefined(localizedName(row?.deliverToLocation?.name), row?.deliverToLocationName)) || '-'\n}));\n\nreturn {\n  mode: built.mode,\n  request,\n  title,\n  description: rows.length >= total\n    ? 'Showing all ' + total + ' ' + resultNounPhrase() + ' in ' + buName + '.'\n    : 'Showing ' + rows.length + ' of ' + total + ' ' + resultNounPhrase() + ' in ' + buName + '.',\n  emptyMessage,\n  countMessage,\n  total,\n  displayedCount: rows.length,\n  filterLabel: filterLabel(),\n  dateQualifier: dateQualifier(),\n  procurementBUName: buName,\n  rows\n};"
          },
