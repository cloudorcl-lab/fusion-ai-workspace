        {
          "metadata": {
            "description": "Normalizes reassignment payloads from the submitted preview form before invoking the shared ReassignBuyer loop.",
            "name": "AddReassignReason",
            "returnType": "array",
            "sourceCode": "// Normalizes reassignment payloads from the submitted preview form before invoking ReassignBuyer.\n// Direct reassignment requests must go through preview first; execution starts only from oraFormSubmit.\n\nlet actionPayload = $context.$nodes.PARSEORAACTION?.$output?.result?.payload || {};\nlet payloads = Array.isArray(actionPayload.reassignment_payloads)\n  ? actionPayload.reassignment_payloads\n  : [];\nlet reassignmentReason = actionPayload.reassignment_reason;\n\nlet idx = 0;\nlet output = [];\n\nwhile (idx < payloads.length) {\n  let item = payloads[idx] || {};\n  output.push({\n    ...item,\n    reassignReason: reassignmentReason\n  });\n  idx++;\n}\n\nreturn output;"
          },
