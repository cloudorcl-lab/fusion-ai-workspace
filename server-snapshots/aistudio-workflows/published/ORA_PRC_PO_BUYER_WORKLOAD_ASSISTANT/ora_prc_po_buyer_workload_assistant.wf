        {
          "metadata": {
            "description": "",
            "name": "Normalize Read Only Query Request",
            "returnType": "object",
            "sourceCode": "const raw = $context.$nodes.EXTRACT_READ_ONLY_QUERY_REQUEST?.$output;\nlet parsed = raw;\n\nfunction parseJsonLoose(value) {\n  let current = value;\n  for (let i = 0; i < 3; i++) {\n    if (current && typeof current === 'object' && current.result !== undefined) {\n      current = current.result;\n      continue;\n    }\n    if (typeof current !== 'string') return current;\n    const trimmed = current.trim().replace(/^\\`\\`\\`json\\s*/i, '').replace(/^\\`\\`\\`\\s*/i, '').replace(/\\`\\`\\`$/i, '').trim();\n    try {\n      return JSON.parse(trimmed);\n    } catch (error) {\n      const match = trimmed.match(/\\{[\\s\\S]*\\}/);\n      if (!match) return {};\n      current = match[0];\n    }\n  }\n  return {};\n}\n\nparsed = parseJsonLoose(parsed);\nparsed = parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};\n\nconst message = String($context.$system?.$inputMessage || '');\nconst normalizedMessage = message.toLowerCase();\nconst currentBUId = $context.$variables?.effectivePrcBUId ?? null;\nconst currentBUName = $context.$variables?.effectivePrcBUName ?? null;\n\nfunction compact(value) {\n  return value === null || value === undefined ? null : String(value).trim() || null;\n}\n\nfunction sameText(left, right) {\n  return compact(left)?.toLowerCase() === compact(right)?.toLowerCase();\n}\n\nfunction normalizeMode(value) {\n  if (/\\b(how many|count|number of)\\b/i.test(message)) return 'count';\n  if (/\\b(show|list|view|find|search|pull up|get me|display)\\b/i.test(message)) return 'list';\n\n  const mode = compact(value)?.toLowerCase();\n  if (mode === 'count' || mode === 'list' || mode === 'summary') return mode;\n  return 'count';\n}\n\nfunction normalizeQueryType(value) {\n  const explicit = compact(value)?.toLowerCase();\n  if (explicit === 'workloadinsightquery' || explicit === 'workload_insight_query') return 'workloadInsightQuery';\n  if (explicit === 'unsupported') return 'workloadInsightQuery';\n  if (explicit === 'linequery' || explicit === 'line_query') return 'lineQuery';\n\n  const lineQueryPattern = /\\b(req(?:uisition)?\\s+)?lines?\\b|\\bunassigned\\b|\\bunprocessed\\b|\\bassigned to\\b|\\bdeliver-to\\b|\\bdeliver to\\b|\\brequisition\\b|\\breq\\b/i;\n  const topCategoryPattern = /\\b(top|highest|largest|most)\\b[\\s\\S]*\\b(workload\\s+)?categor(?:y|ies)\\b|\\b(workload\\s+)?categor(?:y|ies)\\b[\\s\\S]*\\b(top|highest|largest|most)\\b/i;\n  const categoryInsightPattern = /\\b(balance|balanced|not balanced|breakdown|buyers?|why)\\b[\\s\\S]*\\b(category|categories)\\b|\\bcategory\\b[\\s\\S]*\\b(balance|balanced|not balanced|breakdown|buyers?|why)\\b/i;\n  const namedCategoryBreakdownPattern = /\\bbuyers?\\s+(?:in|for)\\s+[a-z0-9_ -]+/i;\n  const whyBalancedPattern = /\\bwhy\\b[\\s\\S]*\\b(balance|balanced|not balanced)\\b|\\b(balance|balanced|not balanced)\\b[\\s\\S]*\\bwhy\\b/i;\n  const workloadInsightPattern = /\\bworkload\\b[\\s\\S]*\\b(balance|balanced|not balanced|top|highest|largest|most|categor(?:y|ies)|breakdown)\\b/i;\n  const broadWorkloadPattern = /\\bworkload\\b/i;\n\n  if ((topCategoryPattern.test(message) || categoryInsightPattern.test(message) || namedCategoryBreakdownPattern.test(message) || whyBalancedPattern.test(message) || workloadInsightPattern.test(message) || broadWorkloadPattern.test(message)) && !lineQueryPattern.test(message)) {\n    return 'workloadInsightQuery';\n  }\n  if (topCategoryPattern.test(message) || /\\b(is workload balanced|workload balanced|workload needs balancing)\\b/i.test(message)) return 'workloadInsightQuery';\n  return 'lineQuery';\n}\n\nfunction isDateLikeBusinessUnitCandidate(value) {\n  const text = compact(value)?.toLowerCase();\n  if (!text) return false;\n\n  return (\n    /^(the\\s+)?(?:last|past|previous)\\s+\\d+\\s+(?:days?|weeks?|months?)$/.test(text) ||\n    /^(?:this|last)\\s+(?:week|month)$/.test(text) ||\n    /^(?:today|yesterday)$/.test(text) ||\n    /^since\\s+yesterday$/.test(text) ||\n    /^created\\s+/.test(text)\n  );\n}\n\nfunction isNotBusinessUnitCandidate(value) {\n  const text = compact(value)?.toLowerCase();\n  if (!text) return true;\n\n  return (\n    /\\b(category|categories)\\b/.test(text) ||\n    /^(req|requisition|line|lines|po|purchase order)\\b/.test(text) ||\n    /^(buyer|assignee|owner|requester|deliver-to|deliver to|location)\\b/.test(text)\n  );\n}\n\nfunction inferNamedBusinessUnit() {\n  const explicit = compact(parsed.businessUnitName);\n  if (!explicit) return null;\n\n  const hasExplicitBuWording = /\\b(procurement\\s+bu|procurement\\s+business\\s+unit|business\\s+unit|bu)\\b/i.test(message);\n  if (!hasExplicitBuWording) return null;\n\n  if (sameText(explicit, parsed.categoryName)) return null;\n  if (isDateLikeBusinessUnitCandidate(explicit)) return null;\n  if (isNotBusinessUnitCandidate(explicit)) return null;\n\n  return explicit;\n}\n\nconst request = {\n  queryType: normalizeQueryType(parsed.queryType),\n  mode: normalizeMode(parsed.mode),\n  requisitionNumber: compact(parsed.requisitionNumber),\n  lineNumber: parsed.lineNumber !== null && parsed.lineNumber !== undefined && parsed.lineNumber !== '' ? Number(parsed.lineNumber) : null,\n  assigneeName: compact(parsed.assigneeName),\n  categoryId: parsed.categoryId !== null && parsed.categoryId !== undefined && parsed.categoryId !== '' ? Number(parsed.categoryId) : null,\n  categoryName: compact(parsed.categoryName),\n  deliverToLocation: compact(parsed.deliverToLocation),\n  status: compact(parsed.status)?.toLowerCase() || null,\n  processingStatus: compact(parsed.processingStatus)?.toLowerCase() || null,\n  creationDateFrom: compact(parsed.creationDateFrom),\n  creationDateTo: compact(parsed.creationDateTo),\n  creationDateLabel: compact(parsed.creationDateLabel),\n  businessUnitName: inferNamedBusinessUnit(),\n  groupBy: compact(parsed.groupBy)?.toLowerCase() || null,\n  unsupportedReason: compact(parsed.unsupportedReason),\n  procurementBUId: currentBUId,\n  procurementBUName: currentBUName,\n  originalMessage: message\n};\n\nfunction setCreationDateRange(from, to, label) {\n  if (!request.creationDateFrom) request.creationDateFrom = from;\n  if (!request.creationDateTo) request.creationDateTo = to;\n  if (!request.creationDateLabel) request.creationDateLabel = label;\n}\n\nif (sameText(request.businessUnitName, currentBUName)) {\n  request.businessUnitName = null;\n}\n\nif (!request.status && /\\bunassigned\\b/.test(normalizedMessage)) {\n  request.status = 'unassigned';\n}\n\nif (!request.processingStatus && /\\bunprocessed\\b/.test(normalizedMessage)) {\n  request.processingStatus = 'unprocessed';\n}\n\nif (\n  /\\bcreated\\b/.test(normalizedMessage) ||\n  /\\bsince yesterday\\b/.test(normalizedMessage) ||\n  /\\b(?:last|past|previous)\\s+\\d+\\s+(?:days?|weeks?|months?)\\b/.test(normalizedMessage) ||\n  /\\b(?:this|last)\\s+(?:week|month)\\b/.test(normalizedMessage)\n) {\n  const relativeAmount = normalizedMessage.match(/\\b(?:last|past|previous)\\s+(\\d+)\\s+(days?|weeks?|months?)\\b/) ||\n    normalizedMessage.match(/\\bcreated\\s+(?:in|within)\\s+the\\s+last\\s+(\\d+)\\s+(days?|weeks?|months?)\\b/);\n\n  if (/\\bsince yesterday\\b/.test(normalizedMessage) || /\\bcreated\\s+since\\s+yesterday\\b/.test(normalizedMessage)) {\n    setCreationDateRange('now-1d/d', 'now', 'created since yesterday');\n  } else if (/\\bcreated\\s+yesterday\\b/.test(normalizedMessage) || /\\byesterday\\b/.test(normalizedMessage)) {\n    setCreationDateRange('now-1d/d', 'now/d', 'created yesterday');\n  } else if (/\\bcreated\\s+today\\b/.test(normalizedMessage) || /\\btoday\\b/.test(normalizedMessage)) {\n    setCreationDateRange('now/d', 'now', 'created today');\n  } else if (/\\bthis\\s+week\\b/.test(normalizedMessage)) {\n    setCreationDateRange('now/w', 'now', 'created this week');\n  } else if (/\\blast\\s+week\\b/.test(normalizedMessage)) {\n    setCreationDateRange('now-1w/w', 'now/w', 'created last week');\n  } else if (/\\bthis\\s+month\\b/.test(normalizedMessage)) {\n    setCreationDateRange('now/M', 'now', 'created this month');\n  } else if (/\\blast\\s+month\\b/.test(normalizedMessage)) {\n    setCreationDateRange('now-1M/M', 'now/M', 'created last month');\n  } else if (relativeAmount) {\n    const requestedAmount = Math.max(1, Number(relativeAmount[1]) || 1);\n    const unit = relativeAmount[2];\n\n    if (/^days?/.test(unit)) {\n      const amount = Math.min(365, requestedAmount);\n      setCreationDateRange('now-' + amount + 'd/d', 'now', 'created in the last ' + amount + ' days');\n    } else if (/^weeks?/.test(unit)) {\n      const amount = Math.min(52, requestedAmount);\n      setCreationDateRange('now-' + amount + 'w/w', 'now', 'created in the last ' + amount + ' weeks');\n    } else if (/^months?/.test(unit)) {\n      const amount = Math.min(24, requestedAmount);\n      setCreationDateRange('now-' + amount + 'M', 'now', 'created in the last ' + amount + ' months');\n    }\n  }\n}\n\nif (!request.unsupportedReason && /\\b(top|group|grouped|by category|categories|trend|balance|balanced|rebalance|recommend|recommendation|analy[sz]e|analysis|summary)\\b/.test(normalizedMessage) && request.mode !== 'count' && request.mode !== 'list') {\n  request.unsupportedReason = 'This query needs grouped or analytical handling.';\n}\n\nreturn request;"
          },
