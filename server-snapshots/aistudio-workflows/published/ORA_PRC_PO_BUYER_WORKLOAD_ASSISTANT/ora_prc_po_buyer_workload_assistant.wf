            "sourceCode": "const buyers = $context.$nodes.NORMALIZECATEGORYBUYERBREAKDOWN.$output.result || [];\nconst lastBuyer = buyers.length > 0 ? buyers[buyers.length - 1] : null;\nlet filteredBuyers = buyers;\nlet unassignedCount = 0;\nif (lastBuyer && lastBuyer.buyerName === 'No Buyer Assigned') {\n  filteredBuyers = buyers.slice(0, buyers.length - 1);\n  unassignedCount = lastBuyer.requisitionLinesFromCategory || 0;\n}\nconst result = { filteredBuyers, unassignedCount };\nreturn result;"
