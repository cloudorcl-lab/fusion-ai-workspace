        {
          "metadata": {
            "name": "Parse Data",
            "returnType": "array",
            "sourceCode": "var data = $context.$nodes.GET_STORED_DATA.$output;\nvar result = [];\nif (data && data !== '\"\"' && data !== '') {\n  if (data.length > 2 && data.charAt(0) === '\"') { data = data.slice(1, -1); }\n  try { result = JSON.parse(data); } catch(e) { result = []; }\n}\nreturn result;"
          },
          "outcomes": {
            "success": "SWITCH_MESSAGE_HINT"
          },
          "code": "PARSE_DATA_V2",
          "id": "PARSE_DATA_V2",
          "inputs": [],
