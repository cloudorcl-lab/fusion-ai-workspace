          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Return From Resume"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "RETURN_FROM_RESUME",
          "id": "1779830880269",
          "inputs": [
            {
              "id": "1779830880269_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": ""
            },
            {
              "id": "1779830880269_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Check the return value from:\n{{$context.$nodes.RESUME_NEGOTIATION_TIME_MANAGEMENT.$output}}\n\nIf the return value is SUCCESS, respond with a friendly confirmation message informing the user that the resume action was executed successfully for negotiation:\n{{$context.$nodes.SUPPLIER_NEGOTIATION_DETAILS_FOR_ACTIONS.$output.Negotiation}}. In addition mention that the negotiation is now active again.\n\nIf the return value is anything other than SUCCESS, respond with a clear error message informing the user that the resume action could not be executed."
            }
          ],
          "type": "LLM"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_MESSAGES_LIST"
              ]
            }
          },
          "metadata": {
            "name": "Show Error For Actions"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "SHOW_ERROR_FOR_ACTIONS",
          "id": "1779842275299",
          "inputs": [
            {
              "id": "1779842275299_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": ""
            },
            {
              "id": "1779842275299_prompt",
              "name": "prompt",
              "type": "string",
              "value": "You received the following error message:\n\n{{$context.$error.$errorMessage}}\n\nAnalyze the error message and respond to the user based on its content.\n\nRules:\n1. If the error message is related to the RESUME action, inform the user:\n   \"The RESUME action couldn't be executed because the negotiation is no longer paused.\"\n\n2. If the error message is related to the EXTEND action, inform the user:\n   \"The EXTEND action couldn't be executed successfully.\"\n\n3. If the error message is not related to RESUME or EXTEND, provide a clear and concise explanation of the error using the message provided.\n\nKeep the response user-friendly and avoid exposing unnecessary technical details."
            }
          ],
          "type": "LLM"
        },
