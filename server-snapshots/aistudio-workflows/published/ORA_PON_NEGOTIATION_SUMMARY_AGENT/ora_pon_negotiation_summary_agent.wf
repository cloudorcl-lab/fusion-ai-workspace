          "id": "1779826952236",
          "inputs": [
            {
              "id": "1779826952236_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Analyze the user's input message:\n\n{{$context.$system.$inputMessage}}\n\nDetermine whether the message already contains a negotiation number.\n\nThe negotiation number to check against is:\n\n{{$context.$nodes.GET_NEGOTIATION_DETAILS.$output.Negotiation}}\n\nIf the user's message already includes a negotiation number, return the original user message unchanged.\n\nIf the user's message does not include a negotiation number, add the negotiation number to the message in a clear and natural way.\n\nReturn only the final updated message as the output. Do not include explanations, comments, or extra formatting."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Format Rules Message",
            "returnType": "string",
            "sourceCode": "let formattingRulesForOutput =\n  \"#Formatting Rules For Output\\n\" +\n  \"-Must Generate the content in \" + $context.$variables.Language + \" language.\\n\" +\n  \"-Show all monetary amounts in \" + $context.$variables.Currency +\n  \" currency and format the currency using \" + $context.$variables.NumberFormat +\n  \" formatting style (for example, symbol placement, decimal separators, etc.).\\n\" +\n  \"-Format all dates using \" + $context.$variables.DateFormat +\n  \" date format and if there is time you can use this \" + $context.$variables.TimeFormat +\n  \" time format.\";\n\nreturn formattingRulesForOutput;"
          },
          "outcomes": {
            "success": "1779828369078"
          },
