                     \"ToPartyId\": {\n                        \"type\": \"number\"\n                      }\n                    },\n                    \"required\": [\n                      \"CompanyName\",\n                      \"RecipientId\",\n                      \"MessageFlag\"\n                    ]\n                  }\n                },\n                \"Content\": {\n                  \"type\": \"string\"\n                },\n                \"ContentWithoutHtmlTags\": {\n                  \"type\": \"string\"\n                },\n                \"MessageSentDate\": {\n                  \"type\": \"string\"\n                },\n                \"HasAttachments\": {\n                  \"type\": \"string\"\n                },\n                \"MessageType\": {\n                  \"type\": \"string\"\n                },\n                \"MessageId\": {\n                  \"type\": \"number\"\n                },\n                \"BroadcastType\": {\n                  \"type\": \"string\"\n                },\n                \"FromPartyId\": {\n                  \"type\": \"number\"\n                },\n                \"FromSupplierName\": {\n                  \"type\": \"string\"\n                },\n                \"FromTradingPartnerId\": {\n                  \"type\": \"number\"\n                }\n              },\n              \"required\": [\n                \"MessageSubject\",\n                \"SenderName\",\n                \"Recipients\",\n                \"Content\",\n                \"ContentWithoutHtmlTags\",\n                \"MessageSentDate\",\n                \"HasAttachments\",\n                \"MessageType\",\n                \"MessageId\",\n                \"BroadcastType\"\n              ]\n            }\n          },\n          \"ThreadId\": {\n            \"type\": \"number\"\n          },\n          \"DocumentNumber\": {\n            \"type\": \"string\"\n          },\n          \"UnreadMessagesCount\": {\n            \"type\": \"number\"\n          }\n        },\n        \"required\": [\n          \"AuctionHeaderId\",\n          \"CreationDate\",\n          \"ThreadSubject\",\n          \"Messages\",\n          \"ThreadId\",\n          \"DocumentNumber\",\n          \"UnreadMessagesCount\"\n        ]\n      }\n    },\n    \"totalResults\": {\n      \"type\": \"number\"\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"searchStatus\": {},\n    \"unreadMessagesCountNeg\": {\n      \"type\": \"number\"\n    },\n    \"allMessagesCountNeg\": {\n      \"type\": \"number\"\n    },\n    \"message\": {}\n  },\n  \"required\": [\n    \"items\",\n    \"totalResults\",\n    \"count\",\n    \"limit\",\n    \"offset\",\n    \"hasMore\",\n    \"searchStatus\",\n    \"unreadMessagesCountNeg\",\n    \"allMessagesCountNeg\",\n    \"message\"\n  ]\n}",
