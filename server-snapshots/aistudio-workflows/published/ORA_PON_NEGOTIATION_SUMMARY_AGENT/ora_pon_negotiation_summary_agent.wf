              "value": "{{$context.$nodes.GET_SUGGESTED_ACTION.$output.result.Action}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
            "name": "Extend Request",
            "returnType": "object",
            "sourceCode": "const details = $context.$nodes.SUPPLIER_NEGOTIATION_DETAILS_FOR_ACTIONS.$output;\nif (!details || !details.CloseDate) {\n  throw new Error(\"CloseDate is required to extend negotiation.\");\n}\nconst baseDate = new Date(details.CloseDate);\nif (Number.isNaN(baseDate.getTime())) {\n  throw new Error(\"Unable to parse CloseDate: \" + details.CloseDate);\n}\nconst extendedDate = new Date(baseDate.getTime() + 24 * 60 * 60 * 1000);\nconst isoCloseDate = extendedDate.toISOString();\nreturn {\n  parameters: {\n    ActionIntent: \"EXTEND\",\n    CloseDate: isoCloseDate\n  }\n};"
          },
          "outcomes": {
            "success": "1779830266596"
          },
          "code": "EXTEND_REQUEST",
          "id": "1766163122815",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Resume Request",
            "returnType": "object",
            "sourceCode": "return {\"parameters\":{\"ActionIntent\":\"RESUME\"}};"
          },
          "outcomes": {
            "success": "1779830789988"
          },
          "code": "RESUME_REQUEST",
