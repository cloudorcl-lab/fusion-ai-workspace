          "id": "1774522636009",
          "inputs": [
            {
              "id": "1774522636010_1",
              "name": "prompt",
              "type": "string",
              "value": "Given the following user's message: {{$context.$system.$inputMessage}} and following chat History: {{$context.$system.$chatHistory}}\nHere's the related products available for this query: {{$context.$nodes.GET_RELATED_PRODUCTS.$output}}\nHere are the all BGDs: {{$context.$nodes.GET_ALL_BGDS.$output}} \n\nIf there are no related products for the query your job is to write output that there are no related products available in the system and ask user to provide accurate product name.\nOther than that your job is also to provide accurate summary of the user's message, chat history and relevant information needed for the BGD create agent, like BGD payload information, segments information, etc. Keep it very brief. DO NOT use/assume any other information that is not provided."
            }
          ],
          "type": "LLM"
        },
