          "code": "SUP_REQ_QUERY_FOR_A_RECOMMENDATION",
          "id": "1774438621119",
          "inputs": [
            {
              "id": "1774438656863_1",
              "name": "payload",
              "type": "string",
              "value": "{{$context.$nodes.SUP_REQ_RECOMMENDATIONS_PREP_REQ.$output.result}}"
