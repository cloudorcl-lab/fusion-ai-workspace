          "code": "BATCH_REQUEST_DATA_PREPARE",
          "convergenceTargetId": "1774324194498",
          "id": "1774324224304",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "prepare supply request data",
            "returnType": "object",
            "sourceCode": "const log = (...args) => console.log('[createSupplyRequestPayload]', ...args);\n\n// Legacy createSupplyRequestPayload is now obsolete with fullRecommendation\n// If you want to keep compatibility, wrap the above logic in a function as needed\n\n// Entrypoint for local/demo run\nlet fullRecommendation, organizationId = 207, emailAddress;\ntry {\n  log('Attempting to load ./fullRecommendation.json');\n  fullRecommendation = require(\"./fullRecommendation.json\");\n  emailAddress = 'test@test.com';\n  log('Loaded ./fullRecommendation.json, set test email', { emailAddress, hasData: !!fullRecommendation });\n} catch (error) {\n  \n}\n\ntry {\n  log('Attempting context-based assignment for publishedRecord/orgId/email');\n  fullRecommendation = $context.$nodes.SUP_REQ_QUERY_FOR_A_RECOMMENDATION.$output;\n  organizationId = $context.$variables.OrganizationId;\n  emailAddress = $context.$nodes.SELF_DETAILS?.$output.items[0].EmailAddress;\n  log('Context assignment completed', { fullRecommendation: !!fullRecommendation, organizationId, emailAddress });\n} catch (error) {\n  \n}\n\nlet orgId = organizationId;\n\nlog('Starting payload generation:', { orgId, emailAddress });\nlet itemsRaw = fullRecommendation?.result?.data?.data ?? [];\nlog('Loaded itemsRaw, count:', itemsRaw.length);\n\n/**\n * Consolidation: Instead of pushing directly, group by ItemNumber + UOMCode + SourceOrganizationCode [+ any other desired fields].\n * For each group, sum Quantity and aggregate demandDetails (for NoteToReceiver). Use a key to group.\n */\nconst lineMap = {};\n\nitemsRaw.forEach(item => {\n  log('Processing item:', { OrganizationId: item.OrganizationId, ItemNumber: item.ItemNumber });\n\n  if (Array.isArray(item.recommendations)) {\n    item.recommendations.forEach(rec => {\n      const params = rec.RecommendedActionParameters || {};\n      log('Evaluating recommendation:', { TransferOrganizationId: params.TransferOrganizationId, DemandDocumentQuantity: params.DemandDocumentQuantity });\n      // Only keep recommendations where TransferOrganizationId matches orgId\n      if (params.TransferOrganizationId && params.TransferOrganizationId !== orgId) {\n        log(`Recommendation skipped - TransferOrganizationId ${params.TransferOrganizationId} does not match orgId ${orgId}`);\n        return;\n      }\n      log('Recommendation included - will consolidate line');\n\n      // Consolidation Key: item, uom, source org, lot, subinventory (to avoid incorrect merging across attributes)\n      const lotNumber = item.LotNumber || '';\n      const subinventoryCode = item.SubinventoryCode || '';\n      const key = [\n        item.ItemNumber || '',\n        item.PrimaryUnitOfMeasureCode || '',\n        params.TransferOrganizationCode || '',\n        lotNumber,\n        subinventoryCode\n      ].join('|');\n\n      // Collect DemandDocumentNumber and DemandDocumentTypeMeaning for NoteToReceiver\n      let demandDocEntry = null;\n      if (params.DemandDocumentNumber && params.DemandDocumentTypeMeaning) {\n        demandDocEntry = `${params.DemandDocumentNumber} (${params.DemandDocumentTypeMeaning})`;\n      } else if (params.DemandDocumentNumber) {\n        demandDocEntry = `${params.DemandDocumentNumber}`;\n      }\n\n      // Add or update entry in lineMap\n      if (!lineMap[key]) {\n        lineMap[key] = {\n          InterfaceBatchNumber: `INV_${Date.now()}`,\n          ItemNumber: item.ItemNumber || '',\n          DestinationOrganizationId: orgId,\n          Quantity: 0,\n          UOMCode: item.PrimaryUnitOfMeasureCode || '',\n          NeedByDate: item.ExpirationDate || '', // Set to ExpirationDate if present\n          SourceOrganizationId: item.OrganizationId || '',\n          DestinationTypeCode: \"INVENTORY\",\n          DeliverToRequesterEmail: emailAddress || '',\n          PreparerEmail: emailAddress || '',\n          SupplyType: \"TRANSFER\",\n          NoteToSupplier: [\n            lotNumber ? `Lot: ${lotNumber}` : '',\n            subinventoryCode ? `Subinventory: ${subinventoryCode}` : ''\n          ].filter(Boolean).join(' | '),\n          NoteToReceiver: [],\n          distributionDetails: [\n            {\n              DistributionNumber: `${Date.now()}`,\n              projectDFF: []\n            }\n          ]\n        };\n      }\n\n      // Sum up quantities\n      lineMap[key].Quantity += params.DemandDocumentQuantity || 1;\n      // Collect DemandDocumentNumber + DemandDocumentType\n      if (demandDocEntry) {\n        lineMap[key].NoteToReceiver.push(demandDocEntry);\n      }\n    });\n  } else {\n    log('No recommendations array found for this item');\n  }\n});\n\n/**\n * Flatten final supplyRequestLines from consolidated map, and join NoteToReceiver arrays with separator (unique DemandDocumentNumbers)\n */\nconst filteredLines = Object.values(lineMap).map(line => {\n  const docNumbers = Array.from(new Set(line.NoteToReceiver));\n  return {\n    ...line,\n    NoteToReceiver: docNumbers.length > 0 ? docNumbers.join(' | ') : ''\n  };\n});\n\nif (filteredLines.length === 0) {\n  log('No supplyRequestLines found, returning undefined');\n  return undefined;\n} else {\n  log('SupplyRequestLines generated:', filteredLines.length);\n}\n\nconst finalPayload = {\n  parts: [\n    {\n      path: \"/supplyRequests\",\n      operation: \"create\",\n      id: \"id-1\",\n      payload: {\n        InterfaceBatchNumber: `INV_${Date.now()}`,\n        InterfaceSourceCode: \"DOS\",\n        SupplyRequestStatus: \"NEW\",\n        SupplyRequestDate: new Date().toISOString(),\n        SupplyOrderSource: \"INV\",\n        SupplyOrderReferenceNumber: `INV_${Date.now()}`,\n        SupplyOrderReferenceId: Date.now(),\n        TrustedSource: 1,\n        ProcessRequestFlag: \"Y\",\n        supplyRequestLines: filteredLines\n      }\n    }\n  ]\n};\n\nlog('Result from fullRecommendation-based supplyRequestPayload()', JSON.stringify(finalPayload, null, 2));\nconsole.log(JSON.stringify(finalPayload, null, 2));\n\nreturn finalPayload;"
          },
