        {
          "metadata": {
            "name": "Batch Request Data Prepare",
            "returnType": "object",
            "sourceCode": "let requestPayload = {};\n\nlet P_ORGANIZATION_ID =  $context?.$variables?.OraAction?.parameters?.row?.OrganizationId;\nlet P_ITEM_NUMBER= $context?.$variables?.OraAction?.parameters?.row?.ItemNumber;\n\nconsole.log(JSON.stringify($context?.$variables?.OraAction,null,2));\n\nrequestPayload = {\n  \"parts\": [\n    {\n      \"path\": `/itemsV2?q=OrganizationId='${P_ORGANIZATION_ID}' and ItemNumber='${P_ITEM_NUMBER}'`,\n      \"operation\": \"get\",\n      \"id\": \"ItemDetails\"\n    }\n  ]\n}\n\n\nreturn requestPayload;"
