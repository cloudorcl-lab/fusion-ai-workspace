        {
          "metadata": {
            "name": "Sup Req - Recommendations Prep Req",
            "returnType": "string",
            "sourceCode": "/**\n * New payload builder for full recommendation request (Lot Expiration - CreateSupplyRequest)\n * Extracts fields as per required mapping and creates a payload JSON in the updated format.\n * Fields are extracted using helpers.\n */\n\n// Helper functions\nconst get_string_if_exists = (obj, key) => {\n  if (obj && typeof obj[key] === 'string') return obj[key];\n  if (obj && typeof obj[key] === 'number') return obj[key].toString();\n  return '';\n};\nconst get_number_if_exists = (obj, key) => {\n  if (obj && (typeof obj[key] === 'number' || (typeof obj[key] === 'string' && obj[key].trim() !== ''))) {\n    const n = Number(obj[key]);\n    return isNaN(n) ? null : n;\n  }\n  return null;\n};\nconst upper_trim = (str) => {\n  if (typeof str !== 'string') return '';\n  return str.trim().toUpperCase();\n};\n\nconst log = (...args) => console.log('[createFullRecommendationRequest]', ...args);\n\nconst createFullRecommendationRequest = (dataArr) => {\n  log('Function entry:', { dataArrType: Array.isArray(dataArr), count: dataArr?.length });\n\n  if (!Array.isArray(dataArr) || dataArr.length === 0) {\n    throw new Error('Input data must be a non-empty array');\n  }\n  const entry = dataArr[0];\n\n  let l_input;\n  try {\n    l_input = JSON.parse(entry.text);\n  } catch (e) {\n    throw new Error('Failed to parse entry.text as JSON: ' + e.message);\n  }\n\n  // Field extraction as per mapping\n  const l_item_number            = get_string_if_exists(l_input, 'ItemNumber');\n  const l_inventory_item_id      = get_number_if_exists(l_input, 'InventoryItemId');\n  const l_item_revision          = get_string_if_exists(l_input, 'ItemRevision');\n  const l_organization_id        = get_number_if_exists(l_input, 'OrganizationId');\n  const l_organization_code      = get_string_if_exists(l_input, 'OrganizationCode');\n  const l_lot_number             = get_string_if_exists(l_input, 'LotNumber');\n  const l_subinventory           = get_string_if_exists(l_input, 'Subinventory');\n  const l_locator                = get_number_if_exists(l_input, 'Locator');\n  const l_lpn_id                 = get_number_if_exists(l_input, 'LpnId');\n  const l_project_id             = get_number_if_exists(l_input, 'ProjectId');\n  const l_project_number         = get_string_if_exists(l_input, 'ProjectNumber');\n  const l_task_id                = get_number_if_exists(l_input, 'TaskId');\n  const l_task_number            = get_string_if_exists(l_input, 'TaskNumber');\n  const l_country_of_origin      = get_string_if_exists(l_input, 'CountryOfOrigin');\n  const l_country_of_origin_code = get_string_if_exists(l_input, 'CountryOfOriginCode');\n  let l_recommended_action_code  = get_string_if_exists(l_input, 'RecommendedActionCode');\n  if (!l_recommended_action_code) l_recommended_action_code = 'TRANSFER_MATERIAL';\n  l_recommended_action_code = upper_trim(l_recommended_action_code);\n\n  // Build the final payload, omitting any field with null or empty value\n  const fullRequestRaw = {\n    ItemNumber: l_item_number,\n    InventoryItemId: l_inventory_item_id,\n    ItemRevision: l_item_revision,\n    OrganizationId: l_organization_id,\n    OrganizationCode: l_organization_code,\n    LotNumber: l_lot_number,\n    Subinventory: l_subinventory,\n    Locator: l_locator,\n    LpnId: l_lpn_id,\n    ProjectId: l_project_id,\n    ProjectNumber: l_project_number,\n    TaskId: l_task_id,\n    TaskNumber: l_task_number,\n    CountryOfOrigin: l_country_of_origin,\n    CountryOfOriginCode: l_country_of_origin_code,\n    RecommendedActionCode: l_recommended_action_code\n  };\n\n  // Remove any property whose value is null, undefined, or empty string\n  const fullRequest = {};\n  Object.keys(fullRequestRaw).forEach((k) => {\n    const v = fullRequestRaw[k];\n    if (\n      v !== null &&\n      v !== undefined &&\n      !(typeof v === \"string\" && v.trim() === \"\")\n    ) {\n      fullRequest[k] = v;\n    }\n  });\n\n  log('Returning full recommendation request:', JSON.stringify(fullRequest, null, 2));\n  return fullRequest;\n};\n\n// Entrypoint for local/demo run\nlet publishedRecord;\n\ntry {\n  publishedRecord = require(\"./publishedRecord.json\");\n} catch (error) {}\n\ntry {\n  publishedRecord = $context?.$nodes?.EXECUTE_SUPPLY_REQ_DB_READER?.$output;\n} catch (error) {}\n\nlet result = createFullRecommendationRequest(publishedRecord);\n\nlog('Result from createFullRecommendationRequest()', JSON.stringify(result, null, 2));\n\nlet resp = {};\n\nresp.input = JSON.stringify(result, null, 2);\n\nreturn resp;"
          },
          "outcomes": {
            "success": "1774438621119"
          },
