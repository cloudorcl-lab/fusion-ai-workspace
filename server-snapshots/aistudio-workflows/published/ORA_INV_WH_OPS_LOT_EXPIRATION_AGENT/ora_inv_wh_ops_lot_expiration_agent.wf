          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Create Summary"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "CREATE_SUMMARY",
          "id": "1773814050881",
          "inputs": [
            {
              "id": "1773814050883_1",
              "name": "prompt",
              "type": "string",
              "value": "SYSTEM:\nYou are an enterprise assistant. Follow security and privacy best practices. Do not invent data. Keep responses concise.\n\nUSER:\nContext:\nYou will receive a JSON object that summarizes inventory lots that are expiring soon or already expired, along with system-recommended actions to address them. The JSON is a condensed summary, not the full detailed list.\n\nInput JSON fields:\n- hasMore (boolean): whether additional recommendations exist beyond this summary payload\n- count (number): number of unique itemNumbers included in this summary\n- itemNumbers (array of strings): unique item numbers that have expiring/expired lots in this summary\n\nTASK:\nGenerate a business-friendly summary (MAX 2 sentences) describing the expiring/expired-lot situation and what to do next.\n\nREQUIREMENTS:\n- Sentence 1: Mention that there are expiring/expired lots, state the count of unique item numbers, and list up to the first 5 item numbers from itemNumbers (comma-separated). If there are more than 5, append “…” after the 5th item.\n- Sentence 2: Indicate next steps by referencing recommended actions and the hasMore flag:\n  - If hasMore is true: say “More recommendations are available.”\n  - If hasMore is false: say “No additional recommendations are available.”\n- Do not claim specific lots, dates, quantities, or action types (since they are not provided in this summary JSON).\n- Output only the 1–2 sentence summary; no bullets, headings, or JSON.\n- If itemNumbers is empty or missing: say “0 unique item numbers were found with expiring/expired lots.” and still include the hasMore sentence.\n\nINPUT:\n{{$context.$nodes.SUMMARY_PREPAREDATAFORLLM.$output.result}}"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Summary- PrepareDataForLLM",
            "returnType": "object",
            "sourceCode": "const resp = $context.$nodes.EXPIRY_LOT_RECOMMENDATIONS_CALL.$output; \n\nconst recs = resp?.result?.data?.recommendations ?? [];\n\nconst hasMore =\n  String(resp?.result?.data?.haveMoreRecommendations).toLowerCase() === \"true\";\n\nconst uniqueItemNumbers = [...new Set(\n  recs\n    .map(r => r?.ItemNumber)\n    .filter(Boolean) // remove null/undefined/empty\n)];\n\nconst output = {\n  hasMore,                    // boolean\n  count: uniqueItemNumbers.length,\n  itemNumbers: uniqueItemNumbers\n};\n\n\nreturn output;"
          },
          "outcomes": {
            "success": "1773814050881"
          },
          "code": "SUMMARY_PREPAREDATAFORLLM",
          "id": "1773814126819",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_SCM_INVENTORYM_INVENTORYITEMLOTSINVWHOPS",
            "functionName": "recommendationsForExpiryLots",
            "name": "Expiry Lot Recommendations Call"
          },
          "outcomes": {
            "success": "1773814126819"
          },
          "code": "EXPIRY_LOT_RECOMMENDATIONS_CALL",
          "id": "1773815897011",
          "inputs": [
            {
              "id": "1773823985944_1",
              "name": "payload",
              "type": "string",
              "value": "{{$context.$nodes.SUMMARYPREPARE_REQUEST.$output.result}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Additional Content-Prepare Request",
            "returnType": "string",
            "sourceCode": "// Parse org id safely\nconst orgIdRaw = $context?.$variables?.OrganizationId;\nconst orgId = orgIdRaw != null ? Number(orgIdRaw) : null;\n\nconst now = new Date();\n\n// Default Start = 3 months ago\nlet startDate = new Date(now);\nstartDate.setMonth(startDate.getMonth() - 3);\n\n// Default End = 1 month from now\nlet endDate = new Date(now);\nendDate.setMonth(endDate.getMonth() + 1);\n\n// Extract values from user intent\nconst intentData =\n  $context?.$nodes?.EXTRACT_QUERY_DATA_FROM_USER_INPUT?.$output;\n\nconst ItemNumber = intentData?.ItemNumber;\nconst LotNumber = intentData?.LotNumber;\n\n// User-provided dates\nconst userStartDate = intentData?.StartDate;\nconst userEndDate = intentData?.EndDate;\n\n// Helper to normalize date input\nconst normalizeDate = (input) => {\n  if (!input) return null;\n\n  // If already a Date object\n  if (input instanceof Date) return input;\n\n  // If it's a valid date string/number\n  const parsed = new Date(input);\n  return isNaN(parsed.getTime()) ? null : parsed;\n};\n\n// Override defaults if valid user input exists\nconst parsedStart = normalizeDate(userStartDate);\nconst parsedEnd = normalizeDate(userEndDate);\n\nif (parsedStart) startDate = parsedStart;\nif (parsedEnd) endDate = parsedEnd;\n\n// YYYY-MM-DD (UTC)\nconst startExp = startDate.toISOString().slice(0, 10);\nconst endExp = endDate.toISOString().slice(0, 10);\n\nlet requestPayload = {\n  OrganizationId: orgId,\n  LotControlCode: 2,\n  LotExpirationStartDate: startExp,\n  LotExpirationEndDate: endExp,\n  ItemNumber,\n  LotNumber,\n  NoOfRecommendations: 10\n};\n\nlet modifedPayload = {};\n\nmodifedPayload.input = JSON.stringify(requestPayload);\n\nreturn modifedPayload;"
          },
          "outcomes": {
            "success": "1774413922960"
          },
          "code": "ADDITIONAL_CONTENTPREPARE_REQUEST",
          "id": "1773981415352",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Variable Syncher",
            "returnType": "object",
            "sourceCode": "let output = {};\n\nconst maybeParseJson = (value) => {\n  if (value !== null && typeof value === \"object\") return value;\n  if (typeof value !== \"string\") return value;\n\n  const s = value.trim();\n\n  try {\n    return JSON.parse(s);\n  } catch(ex) {\n   console.log('Error parsing json '+ex);\n\n   console.log(s);\n    return value;\n  }\n};\n\nconst oraActionRaw =\n  $context.$app.$OraAction ?? $context.$triggers?.REST?.$input?.OraAction;\n\noutput.OraAction = maybeParseJson(oraActionRaw);\n\n// If OraAction.parameters might be JSON (string), parse and update it\nif (\n  output.OraAction &&\n  typeof output.OraAction === \"object\" &&\n  \"parameters\" in output.OraAction\n) {\n  console.log(`Parsing parameters `);\n  output.OraAction.parameters = maybeParseJson(output.OraAction.parameters);\n  console.log(` ${output.OraAction.parameters} `);\n}\n\n\n\n\n\noutput.OraMessageHint =\n  $context.$app.$OraMessageHint ??\n  $context.$triggers?.REST?.$input?.OraMessageHint;\n\noutput.OraUserContext =\n  $context.$app.$OraUserContext ??\n  $context.$triggers?.REST?.$input?.OraUserContext;\n\noutput.OraAppContext=\n  $context.$app.$OraAppContext??\n  $context.$triggers?.REST?.$input?.OraAppContext;\n\nif (\n  output.OraAppContext&&\n  typeof output.OraAppContext=== \"object\" \n) {\n  console.log(`Parsing App Context`);\n  output.OraAppContext = maybeParseJson(output.OraAppContext);\n  console.log(` ${output.OraAppContext} `);\n}\n\noutput.triggerType =\n  $context.$app.$triggerType ?? $context.$triggers?.REST?.$input?.triggerType;\n\noutput.aiAppOutputSpecification =\n  $context.$app.$aiAppOutputSpecification ??\n  $context.$triggers?.REST?.$input?.aiAppOutputSpecification;\n\nif(output.OraMessageHint == 'Query'){\n\n  output.OraMessageHint = 'AdditionalContent';\n}\n\noutput.OrganizationId = $context.$nodes?.INVOKE_ORGANIZATION_CHOOSER_PARSER?.$output?.result?.organizationId ?? $context.$triggers?.REST?.$input?.OrganizationId;\n\n\nreturn output;"
          },
          "outcomes": {
            "success": "1774097513077"
          },
