          "code": "READ_VECTOR",
          "id": "1774430672456",
          "inputs": [
            {
              "id": "1774430672461_1",
              "name": "indexName",
              "type": "string",
              "value": "Onhand Data"
            },
            {
              "id": "1774430672462_2",
              "name": "query",
              "type": "string",
              "value": "-"
            },
            {
              "id": "1774430672463_3",
              "name": "documentId",
              "type": "string",
              "value": ""
            },
            {
              "id": "1774430672464_4",
              "name": "fields",
              "type": "array",
              "value": ""
            },
            {
              "id": "1774430672465_5",
              "name": "filterCriteria",
              "type": "object",
              "value": ""
            },
            {
              "id": "1774430672466_6",
              "name": "maximumResults",
              "type": "integer",
              "value": ""
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"index\": {\n        \"type\": \"integer\"\n      },\n      \"text\": {\n        \"type\": \"string\"\n      }\n    },\n    \"required\": [\n      \"index\",\n      \"text\"\n    ]\n  }\n}",
          "type": "VECTOR_DB_READER"
        },
        {
          "metadata": {
            "name": "Prepare Publish Record Data",
            "returnType": "object",
            "sourceCode": "let rowData;\n\ntry {\n    rowData = require(\"./publishRecord.json\");\n} catch (ex) {}\n\ntry {\n    rowData = $context.$variables.OraAction?.parameters;\n} catch (ex) {}\n\n// Define mapping of preferred keys and their source field names in the data\nconst keyMap = {\n    ItemNumber: \"ItemNumber\",\n    InventoryItemId: \"InventoryItemId\",\n    ItemRevision: \"ItemRevision\",\n    OrganizationId: \"OrganizationId\",\n    OrganizationCode: \"OrganizationCode\",\n    LotNumber: \"LotNumber\",\n    Subinventory: \"SubinventoryCode\",\n    Locator: \"Locator\",\n    LpnId: \"LpnId\",\n    ProjectId: \"ProjectId\",\n    ProjectNumber: \"ProjectNumber\",\n    TaskId: \"TaskId\",\n    TaskNumber: \"TaskNumber\",\n    CountryOfOrigin: \"CountryOfOrigin\",\n    CountryOfOriginCode: \"CountryOfOriginCode\",\n    RecommendedActionCode: \"RecommendedActionCode\"\n};\n\nconst get_string_if_exists = (obj, key) => {\n    const v = obj[key];\n    return (typeof v === 'string' && v.trim() !== '') ? v : undefined;\n};\n\nconst get_number_if_exists = (obj, key) => {\n    const v = obj[key];\n    return (typeof v === 'number') ? v : undefined;\n};\n\nconst upperTrim = (str) => (\n    typeof str === 'string' ? str.trim().toUpperCase() : undefined\n);\n\nconst extractInterestedOrganizations = (recommendations) => {\n    // recommendations is an array of objects, each may have RecommendedActionParameters.TransferOrganizationId and TransferOrganizationCode\n    if (!Array.isArray(recommendations)) return [];\n    const orgSet = new Set();\n    const orgObjs = [];\n    for (const rec of recommendations) {\n        const params = rec.RecommendedActionParameters || {};\n        const id = params.TransferOrganizationId;\n        const code = params.TransferOrganizationCode;\n        if (typeof id === 'number' && typeof code === 'string' && code.trim() !== '') {\n            const key = `${id}:${code.trim()}`;\n            if (!orgSet.has(key)) {\n                orgSet.add(key);\n                orgObjs.push({ id, code: code.trim() });\n            }\n        }\n    }\n    return orgObjs;\n};\n\n// Defensive: allow for rowData.row or rowData direct\nconst raw = rowData?.row ? rowData.row : rowData;\n\nconst result = {};\n// Define all fields to keep, using mapped keys\nconst keepFields = [\n    { attr: \"ItemNumber\", type: \"string\" },\n    { attr: \"InventoryItemId\", type: \"number\" },\n    { attr: \"ItemRevision\", type: \"string\" },\n    { attr: \"OrganizationId\", type: \"number\" },\n    { attr: \"OrganizationCode\", type: \"string\" },\n    { attr: \"LotNumber\", type: \"string\" },\n    { attr: \"Subinventory\", type: \"string\" },\n    { attr: \"Locator\", type: \"number\" },\n    { attr: \"LpnId\", type: \"number\" },\n    { attr: \"ProjectId\", type: \"number\" },\n    { attr: \"ProjectNumber\", type: \"string\" },\n    { attr: \"TaskId\", type: \"number\" },\n    { attr: \"TaskNumber\", type: \"string\" },\n    { attr: \"CountryOfOrigin\", type: \"string\" },\n    { attr: \"CountryOfOriginCode\", type: \"string\" },\n    // RecommendedActionCode: treated specially if needed\n];\n\nif (raw) {\n    for (const { attr, type } of keepFields) {\n        const sourceField = keyMap[attr];\n        if (!sourceField) continue;\n        let value;\n        if (type === \"string\") {\n            value = get_string_if_exists(raw, sourceField);\n        } else if (type === \"number\") {\n            value = get_number_if_exists(raw, sourceField);\n        }\n        if (attr === \"RecommendedActionCode\" && value) {\n            value = upperTrim(value);\n        }\n        if (value !== undefined && value !== null) {\n            result[attr] = value;\n        }\n    }\n\n    // Add interestedOrganizations as array of objects {id, code}, unique values from recommendations\n    result.interestedOrganizations = extractInterestedOrganizations(raw.recommendations);\n\n    // Do NOT include recommendations attribute itself\n}\n\n\nconsole.log(JSON.stringify(result, null, 2));\n\n\nreturn result;"
          },
          "outcomes": {
            "success": "1774326331816"
          },
          "code": "PREPARE_PUBLISH_RECORD_DATA",
          "convergenceTargetId": "1774326331816",
          "id": "1774434356645",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
