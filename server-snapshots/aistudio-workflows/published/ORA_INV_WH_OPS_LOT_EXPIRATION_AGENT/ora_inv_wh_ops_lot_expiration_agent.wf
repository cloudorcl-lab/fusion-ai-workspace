          "id": "1774330304440",
          "inputs": [
            {
              "id": "1774330304441_1",
              "name": "prompt",
              "type": "string",
              "value": "Extract the following fields from the user input:\n\n- itemNumber\n- LotNumber\n- StartDate\n- EndDate\n\nInstructions:\n1. Parse the input carefully and identify values corresponding to each field.\n2. If a field is not explicitly mentioned or cannot be confidently determined, return null.\n3. Do not infer or assume missing values.\n4. Dates must be resolved even when the input uses relative expressions such as:\n   - \"next 3 months\"\n   - \"next year\"\n   - \"this month\"\n   - \"this year\"\n   - \"last 30 days\"\n5. Convert all relative date expressions into absolute dates based on the current date at the time of processing.\n6. If the input specifies only a time span and not exact dates, derive StartDate and EndDate from that span.\n7. If a relative date expression is still ambiguous and cannot be reliably converted, return null for that field.\n8. Keep the extracted date values in a consistent absolute date format.\n\nInput:\nInput Message : {{$context.$system.$inputMessage}}\n\nCurrent Date : {{$context.$system.$currentDateTime}}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"EndDate\": {\n            \"type\": \"date\"\n        },\n        \"StartDate\": {\n            \"type\": \"date\"\n        },\n        \"LotNumber\": {\n            \"type\": \"string\"\n        },\n        \"ItemNumber\": {\n            \"type\": \"object\",\n            \"properties\": {}\n        }\n    }\n}",
          "type": "LLM"
        },
