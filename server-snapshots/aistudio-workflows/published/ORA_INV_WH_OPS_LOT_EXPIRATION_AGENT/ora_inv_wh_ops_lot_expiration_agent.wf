        {
          "metadata": {
            "name": "Init Actions Prepare Data",
            "returnType": "object",
            "sourceCode": "const log = (...args) => console.log('[LOG]', ...args);\n\nlet publishedRecords;\nlet organizationId = 207;\n\ntry {\n  publishedRecords = require(\"./recommendations.json\");\n  log(\"Loaded publishedRecords from recommendations.json:\", publishedRecords);\n} catch (error) {\n  log(\"Failed to load recommendations.json, will try to fall back to local files.\", error);\n  // ignore and fall back to local files\n}\n\ntry {\n  publishedRecords = $context.$nodes.READ_ALL_PUBLISHED_RECORDS.$output;\n  log(\"Loaded publishedRecords from $context:\", publishedRecords);\n  organizationId = $context.$variables.OrganizationId;\n  log(\"organizationId set from $context:\", organizationId);\n} catch (error) {\n  log(\"Context loading failed, organizationId and publishedRecords may be defaults.\", error);\n  // ignore and fall back to local files\n}\n\n// Ensure an array\nif (!Array.isArray(publishedRecords)) {\n  log(\"publishedRecords is not an array, initializing as empty array\");\n  publishedRecords = [];\n} else {\n  log(\"publishedRecords is a valid array with length:\", publishedRecords.length);\n}\n\nlog(\"Filtering publishedRecords array...\");\npublishedRecords = publishedRecords\n.map(record=>{\n  try{\n  record.text = JSON.parse(record.text);\n  }catch(ex){}\n  return record;\n})\n.filter(record => {\n  if (!record || !record.text) {\n    log(\"Filtered out record due to missing record or text:\", record);\n    return false;\n  }\n  // Allow match where OrganizationId matches OR interestedOrganizations includes organizationId\n  const interestedOrgs = record.text.interestedOrganizations;\n  const result =\n    Array.isArray(interestedOrgs) &&\n    interestedOrgs.some(org => org && typeof org.id === 'number' && org.id === organizationId);\n\n  if (!result) {\n    log(\"Filtered out record due to interest mismatch. Org ID:\", organizationId, \"Record:\", record);\n  }\n  return result;\n});\nlog(\"Filtered publishedRecords count:\", publishedRecords.length);\n\nlog(\"Final publishedRecords to return:\", publishedRecords);\nreturn publishedRecords;"
          },
          "outcomes": {
            "success": "1774419878241"
          },
