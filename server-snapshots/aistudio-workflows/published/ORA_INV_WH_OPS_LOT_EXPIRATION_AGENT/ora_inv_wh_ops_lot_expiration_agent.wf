          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"index\": {\n        \"type\": \"integer\"\n      },\n      \"text\": {\n        \"type\": \"string\"\n      }\n    },\n    \"required\": [\n      \"index\",\n      \"text\"\n    ]\n  }\n}",
          "type": "VECTOR_DB_READER"
        },
        {
          "metadata": {
            "name": "Additional Information Prepare Data",
            "returnType": "object",
            "sourceCode": "// --- Step helpers (split as required) ---\n\nconst log = (...args) => console.log('[INFO]', ...args);\n\nconst parseJsonIfString = data =>\n  !data ? undefined :\n  (typeof data === \"string\" ? (() => { try { return JSON.parse(data); } catch { return undefined; } })() : data);\n\n/**\n * Step 1: For each recommendation row, group recommendations by action code (ALLOC_MATERIAL, TRANSFER_MATERIAL).\n * Output: For each row, produce at most one row per action type with grouped recommendations.\n * @param {Array} recommendations\n * @returns {Array}\n */\nconst groupRecommendationsByType = (recommendations) => {\n  if (!Array.isArray(recommendations)) return [];\n\n  const result = [];\n  recommendations.forEach(row => {\n    const recos = row.recommendations || [];\n    const grouped = recos.reduce((acc, reco) => {\n      if (!reco || !reco.RecommendedActionCode) return acc;\n      const type = reco.RecommendedActionCode;\n      acc[type] = acc[type] || [];\n      acc[type].push(reco);\n      return acc;\n    }, {});\n    // Make a new row for each action code\n    Object.keys(grouped).forEach(type => {\n      result.push({\n        ...row,\n        recommendations: grouped[type]\n      });\n    });\n  });\n  return result;\n};\n\n/**\n * Helper to build SKU key (match identity with publishedOnhandData).\n */\nconst toSkuKey = r => [\n  r.OrganizationId,\n  r.ItemNumber,\n  r.LotNumber,\n  r.LotGrade,\n  r.SubinventoryCode,\n  r.LocatorId,\n  r.LocatorName,\n  r.LpnId,\n  r.LicensePlateNumber,\n  r.ProjectId,\n  r.ProjectNumber,\n  r.TaskId,\n  r.TaskNumber\n].map(x => (x !== undefined && x !== null) ? x : \"\").join(\"|\");\n\n/**\n * Step 2: For rows with RecommendedActionCode === TRANSFER_MATERIAL, filter out if SKU is present in publishedOnhandData (match SKU only)\n * Leave rows with ALLOC_MATERIAL untouched. \n * @param {Array} recRows - Array of rows (grouped by action type)\n * @param {Array} publishedOnhandData - Published onhand for SKU match\n * @returns {Array}\n */\nconst filterTransferMaterialByPublished = (recRows, publishedOnhandData) => {\n  // Normalize published rows to a Set of SKU keys\n  const publishedSkuSet = new Set(\n    (Array.isArray(publishedOnhandData) ? publishedOnhandData : [])\n      .map(row => toSkuKey(row))\n  );\n\n  // Filter: if row contains only TRANSFER_MATERIAL, skip if present in publishedOnhandData\n  return recRows.filter(row => {\n    const recos = row.recommendations || [];\n    const isTransfer = recos.length > 0 && recos.every(r => r.RecommendedActionCode === \"TRANSFER_MATERIAL\");\n    if (isTransfer) {\n      return !publishedSkuSet.has(toSkuKey(row));\n    }\n    // Always keep ALLOC_MATERIAL or mixed/other types\n    return true;\n  });\n};\n\n// --- Main logic ---\n\nlet recommendations;\nlet publishedOnhandData;\n\ntry {\n  recommendations = parseJsonIfString($context.$nodes.EXPIRY_LOT_RECOMMENDATIONS.$output?.result?.data?.data); \n  publishedOnhandData = parseJsonIfString($context.$nodes.PUBLISHED_ONHAND_DATA.$output);\n  log('Parsed from context:', {\n    recommendations,\n    publishedOnhandData,\n  });\n} catch {\n  log('Failed to parse data from context, will use local files or defaults.');\n  // ignore and fall back to local files\n}\n\ntry{\nif (!recommendations || typeof recommendations !== \"object\") {\n  log('Loading recommendations from recommendations.json');\n  recommendations = require(\"./recommendations.json\");\n}\n\nif (!publishedOnhandData || typeof publishedOnhandData !== \"object\") {\n  log('Loading publishedOnhandData from onhandData.json');\n  publishedOnhandData = require(\"./onhandData.json\");\n  // publishedOnhandData=[];\n}\n}catch(ex){}\n\n\n\nconst normalizePublishedData = publishedOnhandData =>\n  Array.isArray(publishedOnhandData)\n    ? publishedOnhandData.map(entry =>\n        (entry && typeof entry.text === \"string\"\n          ? (() => { try { return JSON.parse(entry.text); } catch { return null; } })()\n          : (entry && typeof entry === \"object\" ? entry : null))\n      ).filter(Boolean)\n    : [];\n\n// Normalize published onhand\nconst publishedRows = normalizePublishedData(publishedOnhandData);\nlog('Normalized published rows count:', publishedRows.length);\nlog('Published onhandData:', publishedRows);\n\n// --- Step 1: Group recommendations by action type, one row per type per SKU ---\nconst groupedRows = groupRecommendationsByType(recommendations);\n\n// --- Step 2: Filter out TRANSFER_MATERIAL rows present in publishedOnhandData (by SKU) ---\nconst finalRows = filterTransferMaterialByPublished(groupedRows, publishedRows);\n\n/**\n * Additional Step: Filter out recommendations with DemandDocumentTypeId === 8 or 18.\n * If no recommendations remain after filtering, remove the row.\n * @param {Array} rows\n * @returns {Array}\n */\nconst filterOutDemandDocumentType = rows =>\n  Array.isArray(rows)\n    ? rows\n        .map(row => ({\n          ...row,\n          recommendations: Array.isArray(row.recommendations)\n            ? row.recommendations.filter(\n                r =>\n                  !(\n                    r &&\n                    r.RecommendedActionParameters &&\n                    (r.RecommendedActionParameters.DemandDocumentTypeId === 8 ||\n                     r.RecommendedActionParameters.DemandDocumentTypeId === 18)\n                  )\n              )\n            : []\n        }))\n        .filter(row => Array.isArray(row.recommendations) && row.recommendations.length > 0)\n    : [];\n\n// --- Additional Step: Remove recommendations with DemandDocumentTypeId 8 or 18 and empty rows ---\nconst filteredRows = filterOutDemandDocumentType(finalRows);\n\n// Output and return, structure matching old code\nlet result = { recommendationsFiltered: filteredRows };\nlog(\n  `Returning filter result. recommendationsFiltered=${filteredRows.length}`\n);\n\nconsole.log(JSON.stringify(result, \" \", 2));\n\nreturn result;"
          },
          "outcomes": {
            "success": "1774427819317"
          },
          "code": "ADDITIONAL_INFORMATION_PREPARE_DATA",
