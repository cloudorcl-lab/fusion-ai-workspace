        {
          "metadata": {
            "errorNodeId": "1774104825022",
            "name": "Create MR Payload",
            "returnType": "object",
            "sourceCode": "const buildMovementRequestPayload = (input, opts = {}) => {\n  const submitRequestFlag = opts.submitRequestFlag ?? true;\n  const requiredDate = opts.requiredDate ?? new Date().toISOString();\n  const transactionTypeName = opts.transactionTypeName ?? \"Movement Request Transfer\";\n\n  const row = input?.row ?? {};\n\n  // ---- Extract input into variables ----\n  const organizationId = row.OrganizationId;\n  const sourceSubinventory = row.SubinventoryCode;\n  const inventoryItemId = row.InventoryItemId;\n  const itemRevision = row.Revision;\n  const requestedQuantity = row.PrimaryTransactionQuantity;\n  const secondaryRequestedQuantity = row.SecondaryTransactionQuantity;\n  const uomCode = row.PrimaryUnitOfMeasureCode;\n  const lotNumber = row.LotNumber;\n  const sourceLocatorId = row.LocatorId;\n  const projectId = row.ProjectId;\n  const taskId = row.TaskId;\n  const countryOfOriginCode = row.CountryOfOriginCode;\n\n  const mrRec = (row.recommendations ?? []).find((r) => r?.RecommendedActionCode === \"CR_MR\");\n  const destinationSubinventory = mrRec?.RecommendedActionParameters?.TransferSubinventory;\n\n  // ---- Minimal validations ----\n  if (!organizationId) throw new Error(\"Missing OrganizationId\");\n  if (!inventoryItemId) throw new Error(\"Missing InventoryItemId\");\n  if (requestedQuantity === null || requestedQuantity === undefined) throw new Error(\"Missing PrimaryTransactionQuantity\");\n  if (!uomCode) throw new Error(\"Missing PrimaryUnitOfMeasureCode\");\n  if (!sourceSubinventory) throw new Error(\"Missing SubinventoryCode (source)\");\n  if (!destinationSubinventory) throw new Error(\"Missing Quarantine subinventory. Please setup quarantine subinventory in Organization parameters\");\n\n  const clean = (obj) =>\n    Object.fromEntries(Object.entries(obj).filter(([, v]) => v !== null && v !== undefined && v !== \"\"));\n\n  const inventoryStripingDetail = clean({\n    projectId,\n    taskId,\n    countryOfOriginCode,\n  });\n\n  const lineDetail = clean({\n    InventoryItemId: inventoryItemId,\n    ItemRevision: itemRevision,\n    TransactionType: transactionTypeName,\n    RequiredDate: requiredDate,\n    RequestedQuantity: requestedQuantity,\n    SecondaryRequestedQuantity:\n      secondaryRequestedQuantity !== null &&\n      secondaryRequestedQuantity !== undefined &&\n      Number(secondaryRequestedQuantity) > 0\n        ? secondaryRequestedQuantity\n        : undefined,\n    UOMCode: uomCode,\n    SourceSubinventory: sourceSubinventory,\n    SourceLocatorId: sourceLocatorId,\n    DestinationSubinventory: destinationSubinventory,\n    LotNumber: lotNumber,\n    inventoryStripingDFF: Object.keys(inventoryStripingDetail).length ? [inventoryStripingDetail] : undefined,\n  });\n\n  return clean({\n    \"OrganizationId\": organizationId,\n    \"SubmitRequestFlag\": submitRequestFlag,\n   \"AllocationFlag\" : true,\n    lines: [lineDetail],\n  });\n};\n\nlet actionInput = undefined;\n\ntry {\n  actionInput = $context?.$variables?.OraAction?.parameters;\n}catch(ex){}\n\ntry {\nif (actionInput === null || actionInput === undefined) {\n  actionInput = require(\"./actionInput.json\");\n}\n}catch(ex){}\n\nlet payload;\ntry {\n  payload = buildMovementRequestPayload(actionInput);\n} catch (err) {\n  // If error thrown, forward as system error\n  throw err;\n}\n\nconst response = {\n  parts: [\n    {\n      path: \"/inventoryMovementRequests\",\n      operation: \"create\",\n      payload,\n      id: \"MR-1\",\n    },\n  ],\n};\n\nconsole.log(JSON.stringify(response, \" \", 2));\n\nreturn response;"
          },
          "outcomes": {
            "success": "1774104776799"
          },
