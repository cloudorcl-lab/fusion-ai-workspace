          },
          "code": "MR_CREATION_RESULT_OUTPUT",
          "id": "1774104825022",
          "inputs": [
            {
              "id": "1774104825024_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an assistant that communicates directly with a business user about a Movement Request status.\n\nGoal:\nConvert the Movement Request REST API response into a clear, business-friendly status update. Do NOT expose internal identifiers or technical metadata.\n\nInputs:\n- API_RESPONSE: {{$context.$nodes.MRFLOW_EXECUTE_REQUEST.$output}}\n- ERROR: {{$context.$error}}\n\nInstructions:\n1) If ERROR is present (non-empty), respond with:\n   - A concise statement that the request couldn’t be completed.\n   - A plain-English reason (summarize the error; avoid stack traces and internal codes/IDs).\n   - A suggested next step (retry later or contact support with the time of attempt).\n   - Do not include payload dumps, request IDs, correlation IDs, internal object IDs, or URLs.\n\n2) If no ERROR:\n   - Determine the business status from API_RESPONSE (e.g., Submitted, In Progress, Approved, Rejected, Completed, Failed).\n   - Provide a short update using this format:\n     - Status: <business-friendly status>\n     - Summary: 1–2 lines describing what this status means for the user\n     - Next step: what the user should do (if anything)\n   - If dates are available, include only user-meaningful dates (e.g., submitted date, expected completion), formatted clearly.\n   - If there are validation issues or warnings, summarize them in user language and provide actionable guidance.\n   - Do not display internal IDs (any fields like id, requestId, movementId, correlationId, GUIDs), system names, raw JSON, or technical field names.\n\n3) Tone & formatting:\n   - Keep it concise, professional, and easy to understand.\n   - Prefer short sentences and bullets where helpful.\n\n4) Include movement request number in the output\n\nOutput:\nReturn ONLY the final message that should be shown to the business user."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Create Reservation Payload",
            "returnType": "object",
            "sourceCode": "const DEFAULT_SUPPLY_SOURCE_TYPE_ID = 13;\nconst RESERVATION_ACTION_CODE = \"ALLOC_MATERIAL\";\n\nconst isBlank = (value) => value === null || value === undefined || value === \"\";\n\nconst clean = (obj) =>\n  Object.fromEntries(Object.entries(obj).filter(([, value]) => !isBlank(value)));\n\nconst toNumberOrUndefined = (value) => {\n  if (isBlank(value)) return undefined;\n\n  const asNumber = Number(value);\n  return Number.isFinite(asNumber) ? asNumber : undefined;\n};\n\nconst toStringOrUndefined = (value) => {\n  if (isBlank(value)) return undefined;\n  return String(value);\n};\n\nconst toBooleanOrUndefined = (value) => {\n  if (isBlank(value)) return undefined;\n  if (typeof value === \"boolean\") return value;\n\n  if (typeof value === \"number\") {\n    if (value === 1) return true;\n    if (value === 0) return false;\n    return undefined;\n  }\n\n  if (typeof value === \"string\") {\n    const normalized = value.trim().toLowerCase();\n    if ([\"true\", \"y\", \"yes\", \"1\"].includes(normalized)) return true;\n    if ([\"false\", \"n\", \"no\", \"0\"].includes(normalized)) return false;\n  }\n\n  return undefined;\n};\n\nconst parseJsonIfString = (value) => {\n  if (typeof value !== \"string\") return value;\n\n  const text = value.trim();\n  if (!text) return undefined;\n\n  try {\n    return JSON.parse(text);\n  } catch (error) {\n    return undefined;\n  }\n};\n\nconst firstDefined = (...values) => values.find((value) => !isBlank(value));\n\nconst getBatchItems = (batchRequestData) => {\n  const parts = Array.isArray(batchRequestData?.parts) ? batchRequestData.parts : [];\n  const partItems = parts.flatMap((part) => {\n    if (Array.isArray(part?.payload?.items)) return part.payload.items;\n    if (Array.isArray(part?.items)) return part.items;\n    return [];\n  });\n\n  if (partItems.length) return partItems;\n  return Array.isArray(batchRequestData?.items) ? batchRequestData.items : [];\n};\n\nconst getMatchingBatchItem = (batchRequestData, row = {}) => {\n  const itemCandidates = getBatchItems(batchRequestData);\n  if (!itemCandidates.length) return undefined;\n\n  const rowItemId = toStringOrUndefined(row.InventoryItemId);\n  const rowOrgId = toStringOrUndefined(row.OrganizationId);\n\n  return (\n    itemCandidates.find(\n      (item) =>\n        toStringOrUndefined(item?.ItemId ?? item?.InventoryItemId) === rowItemId &&\n        toStringOrUndefined(item?.OrganizationId) === rowOrgId\n    ) ||\n    itemCandidates.find(\n      (item) => toStringOrUndefined(item?.ItemId ?? item?.InventoryItemId) === rowItemId\n    ) ||\n    itemCandidates[0]\n  );\n};\n\nconst getLotDivisibleFlag = (batchRequestData, row = {}) => {\n  const item = getMatchingBatchItem(batchRequestData, row);\n  return toBooleanOrUndefined(item?.LotDivisibleFlag);\n};\n\nconst getReservationRecommendations = (recommendations) => {\n  const recommendationList = Array.isArray(recommendations) ? recommendations : [];\n  return recommendationList.filter(\n    (rec) => rec?.RecommendedActionCode === RESERVATION_ACTION_CODE\n  );\n};\n\nconst getRecommendationParams = (recommendation) => {\n  const params = recommendation?.RecommendedActionParameters;\n  return typeof params === \"object\" && params !== null ? params : {};\n};\n\nconst getOpenDemandQuantity = (recParams = {}) => {\n  const demandQty = toNumberOrUndefined(recParams.DemandDocumentQuantity);\n  const alreadyReservedQty = toNumberOrUndefined(recParams.DemandDocumentReservedQuantity) ?? 0;\n\n  if (demandQty === undefined) return undefined;\n  return Math.max(demandQty - alreadyReservedQty, 0);\n};\n\nconst resolveReservationQuantity = ({ row, recParams, optsReservationQuantity, lotDivisibleFlag }) => {\n  const fullQuantity = toNumberOrUndefined(row.PrimaryTransactionQuantity);\n  const openDemandQuantity = getOpenDemandQuantity(recParams);\n  const demandQuantity = openDemandQuantity ?? toNumberOrUndefined(recParams.DemandDocumentQuantity);\n  const explicitReservationQuantity = toNumberOrUndefined(row.ReservationQuantity);\n  const overrideReservationQuantity = toNumberOrUndefined(optsReservationQuantity);\n\n  // Preserve the current behavior:\n  // - For indivisible lots (LotDivisibleFlag=false), prefer full lot quantity.\n  // - For divisible lots (LotDivisibleFlag=true), prefer demand/open quantity.\n  const lotIndivisible =\n    lotDivisibleFlag === false ? true : lotDivisibleFlag === true ? false : undefined;\n\n  const preferredQuantity =\n    lotIndivisible === true ? fullQuantity : lotIndivisible === false ? demandQuantity : undefined;\n  const fallbackQuantity =\n    lotIndivisible === true ? demandQuantity : lotIndivisible === false ? fullQuantity : undefined;\n\n  return firstDefined(\n    overrideReservationQuantity,\n    preferredQuantity,\n    fallbackQuantity,\n    openDemandQuantity,\n    explicitReservationQuantity,\n    fullQuantity\n  );\n};\n\nconst getTotalAvailableQuantity = (row = {}, opts = {}) => {\n  return toNumberOrUndefined(\n    firstDefined(opts.reservationQuantity, row.ReservationQuantity, row.PrimaryTransactionQuantity)\n  );\n};\n\nconst getProportionalSecondaryQuantity = ({ row = {}, reservationQuantity, totalAvailableQuantity }) => {\n  const totalSecondaryQuantity = toNumberOrUndefined(row.SecondaryTransactionQuantity);\n  const totalPrimaryQuantity = toNumberOrUndefined(totalAvailableQuantity);\n\n  if (totalSecondaryQuantity === undefined || totalSecondaryQuantity <= 0) return undefined;\n  if (totalPrimaryQuantity === undefined || totalPrimaryQuantity <= 0) return undefined;\n\n  const proportionalSecondaryQty = (reservationQuantity / totalPrimaryQuantity) * totalSecondaryQuantity;\n  return Number.isFinite(proportionalSecondaryQty) && proportionalSecondaryQty > 0\n    ? proportionalSecondaryQty\n    : undefined;\n};\n\nconst buildReservationPayload = (input, opts = {}) => {\n  const row = typeof input?.row === \"object\" && input?.row !== null ? input.row : {};\n\n  const fallbackRecommendation = getReservationRecommendations(row.recommendations)[0];\n  const recParams =\n    typeof opts.recParams === \"object\" && opts.recParams !== null\n      ? opts.recParams\n      : getRecommendationParams(fallbackRecommendation);\n\n  const organizationId = row.OrganizationId;\n  const inventoryItemId = row.InventoryItemId;\n  const subinventoryCode = row.SubinventoryCode;\n  const locatorId = row.LocatorId;\n  const lotNumber = row.LotNumber;\n  const revision = row.Revision;\n  const reservationUOMCode = row.PrimaryUnitOfMeasureCode;\n  const secondaryReservationQuantity = toNumberOrUndefined(\n    firstDefined(opts.secondaryReservationQuantity, row.SecondaryTransactionQuantity)\n  );\n\n  const demandSourceTypeId = firstDefined(\n    recParams.DemandDocumentTypeId,\n    row.DemandSourceTypeId,\n    opts.demandSourceTypeId\n  );\n  const demandSourceType = firstDefined(\n    recParams.DemandDocumentTypeMeaning,\n    row.DemandSourceType,\n    opts.demandSourceType\n  );\n  const demandSourceHeaderNumber = firstDefined(\n    recParams.DemandDocumentNumber,\n    row.DemandSourceHeaderNumber,\n    opts.demandSourceHeaderNumber\n  );\n  const demandSourceLineNumber = firstDefined(\n    recParams.DemandDocumentLineNumber,\n    row.DemandSourceLineNumber,\n    opts.demandSourceLineNumber\n  );\n\n  const supplySourceTypeId = firstDefined(\n    recParams.SupplySourceTypeId,\n    row.SupplySourceTypeId,\n    opts.supplySourceTypeId,\n    DEFAULT_SUPPLY_SOURCE_TYPE_ID\n  );\n\n  const lotDivisibleFlag = getLotDivisibleFlag(opts.batchRequestData, row);\n  const defaultReservationQuantity =\n    getTotalAvailableQuantity(row, opts) ?? toNumberOrUndefined(row.PrimaryTransactionQuantity);\n  const reservationQuantity = resolveReservationQuantity({\n    row,\n    recParams,\n    optsReservationQuantity: firstDefined(opts.reservationQuantity, defaultReservationQuantity),\n    lotDivisibleFlag,\n  });\n\n  if (isBlank(organizationId)) return { error: \"Missing OrganizationId\", data: input };\n  if (isBlank(inventoryItemId)) return { error: \"Missing InventoryItemId\" };\n  if (isBlank(demandSourceTypeId)) {\n    return {\n      error:\n        \"Missing DemandSourceTypeId. Pass it in recommendation.RecommendedActionParameters.DemandDocumentTypeId or opts.demandSourceTypeId.\",\n    };\n  }\n  if (isBlank(supplySourceTypeId)) {\n    return {\n      error:\n        \"Missing SupplySourceTypeId. Pass it in recommendation.RecommendedActionParameters.SupplySourceTypeId or opts.supplySourceTypeId.\",\n    };\n  }\n\n  const reservationQuantityAsNumber = toNumberOrUndefined(reservationQuantity);\n  if (reservationQuantityAsNumber === undefined) {\n    return { error: \"Missing ReservationQuantity (or PrimaryTransactionQuantity)\" };\n  }\n  if (reservationQuantityAsNumber <= 0) {\n    return { error: \"ReservationQuantity must be greater than 0\" };\n  }\n\n  return clean({\n    OrganizationId: toStringOrUndefined(organizationId),\n    InventoryItemId: toStringOrUndefined(inventoryItemId),\n    DemandSourceTypeId: toStringOrUndefined(demandSourceTypeId),\n    DemandSourceType: toStringOrUndefined(demandSourceType),\n    DemandSourceHeaderNumber: toStringOrUndefined(demandSourceHeaderNumber),\n    DemandSourceLineNumber: toStringOrUndefined(demandSourceLineNumber),\n    SupplySourceTypeId: toStringOrUndefined(supplySourceTypeId),\n    SubinventoryCode: toStringOrUndefined(subinventoryCode),\n    LocatorId: toStringOrUndefined(locatorId),\n    LotNumber: toStringOrUndefined(lotNumber),\n    Revision: toStringOrUndefined(revision),\n    ReservationQuantity: toStringOrUndefined(reservationQuantityAsNumber),\n    ReservationUOMCode: toStringOrUndefined(reservationUOMCode),\n    SecondaryReservationQuantity:\n      secondaryReservationQuantity !== undefined && secondaryReservationQuantity > 0\n        ? toStringOrUndefined(secondaryReservationQuantity)\n        : undefined,\n    SupplyProjectId: toStringOrUndefined(row.ProjectId),\n    SupplyTaskId: toStringOrUndefined(row.TaskId),\n  });\n};\n\nconst buildReservationParts = (input, opts = {}) => {\n  const row = typeof input?.row === \"object\" && input?.row !== null ? input.row : {};\n  const recommendations = getReservationRecommendations(row.recommendations);\n  const lotDivisibleFlag = getLotDivisibleFlag(opts.batchRequestData, row);\n\n  if (!recommendations.length) {\n    return {\n      error: `No ${RESERVATION_ACTION_CODE} recommendations found for reservation creation.`,\n    };\n  }\n\n  const totalAvailableQuantity = getTotalAvailableQuantity(row, opts);\n  if (totalAvailableQuantity === undefined) {\n    return { error: \"Missing ReservationQuantity (or PrimaryTransactionQuantity)\" };\n  }\n  if (totalAvailableQuantity <= 0) {\n    return { error: \"ReservationQuantity must be greater than 0\" };\n  }\n\n  // If lot is indivisible, the lot cannot be split across multiple demands.\n  // Reserve against only the first eligible ALLOC_MATERIAL demand.\n  if (lotDivisibleFlag === false) {\n    const firstEligibleRecommendation = recommendations.find((recommendation) => {\n      const recParams = getRecommendationParams(recommendation);\n      const openDemandQuantity = getOpenDemandQuantity(recParams);\n      return openDemandQuantity === undefined || openDemandQuantity > 0;\n    });\n\n    if (!firstEligibleRecommendation) {\n      return {\n        error: `No open demand quantity found in ${RESERVATION_ACTION_CODE} recommendations.`,\n      };\n    }\n\n    const payload = buildReservationPayload(input, {\n      ...opts,\n      recParams: getRecommendationParams(firstEligibleRecommendation),\n      reservationQuantity: totalAvailableQuantity,\n    });\n\n    return [\n      {\n        path: \"/inventoryReservations\",\n        operation: \"create\",\n        payload,\n        id: \"RSV-1\",\n      },\n    ];\n  }\n\n  let remainingQuantity = totalAvailableQuantity;\n  const parts = [];\n  let firstPayloadError;\n\n  recommendations.forEach((recommendation) => {\n    if (remainingQuantity <= 0) return;\n\n    const recParams = getRecommendationParams(recommendation);\n    const openDemandQuantity = getOpenDemandQuantity(recParams);\n\n    if (openDemandQuantity === undefined || openDemandQuantity <= 0) return;\n\n    const reservationQuantity = Math.min(remainingQuantity, openDemandQuantity);\n    if (reservationQuantity <= 0) return;\n\n    const secondaryReservationQuantity = getProportionalSecondaryQuantity({\n      row,\n      reservationQuantity,\n      totalAvailableQuantity,\n    });\n\n    const payload = buildReservationPayload(input, {\n      ...opts,\n      recParams,\n      reservationQuantity,\n      secondaryReservationQuantity,\n    });\n\n    if (payload?.error) {\n      if (!firstPayloadError) firstPayloadError = payload;\n      return;\n    }\n\n    parts.push({\n      path: \"/inventoryReservations\",\n      operation: \"create\",\n      payload,\n      id: `RSV-${parts.length + 1}`,\n    });\n\n    remainingQuantity -= reservationQuantity;\n  });\n\n  if (!parts.length) {\n    if (firstPayloadError) return firstPayloadError;\n    return {\n      error: `No open demand quantity found in ${RESERVATION_ACTION_CODE} recommendations.`,\n    };\n  }\n\n  return parts;\n};\n\nlet actionInput;\nlet batchRequestData;\n\ntry {\n  actionInput = parseJsonIfString($context?.$variables?.OraAction?.parameters);\n  batchRequestData = parseJsonIfString($context?.$nodes?.BATCH_REQUEST_DATA_PREPARE?.$output?.result);\n} catch (error) {\n  // ignore and fall back to local files\n}\n\nif (!actionInput || typeof actionInput !== \"object\") {\n  actionInput = require(\"./actionInput.json\");\n}\n\nif (!batchRequestData || typeof batchRequestData !== \"object\") {\n  batchRequestData = require(\"./batchRequestData.json\");\n}\n\nconst builtParts = buildReservationParts(actionInput, { batchRequestData });\n\nconst response = {\n  parts: Array.isArray(builtParts)\n    ? builtParts\n    : [\n        {\n          path: \"/inventoryReservations\",\n          operation: \"create\",\n          payload: builtParts,\n          id: \"RSV-1\",\n        },\n      ],\n};\n\nconsole.log(JSON.stringify(response, null, 2));\n\nreturn response;"
          },
