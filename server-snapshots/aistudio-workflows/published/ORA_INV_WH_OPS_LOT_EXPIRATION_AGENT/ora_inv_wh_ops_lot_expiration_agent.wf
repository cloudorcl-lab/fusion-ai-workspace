            "sourceCode": "let payload = {};\n\n\n\npayload.OrganizationId = $context.$variables.OrganizationId;\n\npayload.NoOfRecommendations = 25;\n\n\nlet retVal = {\n\"input\" : JSON.stringify(payload)\n};\n\nreturn retVal;"
