        },
        {
          "metadata": {
            "name": "Display Output",
            "returnType": "string",
            "sourceCode": "const node = $context?.$nodes?.CREATE_MODEL_WF;\nconst out  = node?.$output;\nconst globalErr = $context?.$error?.$errorMessage;\n\nif (out?.error || globalErr) return \"Model creation is failed\";\nif (out?.output) return \"Model is created\";\nreturn \"Not executed\";   // or \"Pending\"/\"Unknown\""
          },
          "outcomes": {
            "success": "end"
          },
          "code": "DISPLAY_OUTPUT",
