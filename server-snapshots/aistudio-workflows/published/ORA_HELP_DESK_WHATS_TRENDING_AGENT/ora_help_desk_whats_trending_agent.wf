            "name": "get SRNumber",
            "returnType": "string",
            "sourceCode": "const htmlString = $context.$nodes.INVOKETICKETLOGGER.$output.output;\n\nconst match = htmlString.match(/SR\\s+([A-Z]+\\d+)/);\n\nconst output = match ? \"The SR is logged, you can refer the SR for tracking: \" + match[1].trim() : htmlString.trim();\n\nreturn output;"
          },
          "outcomes": {
            "success": "1770810756868"
          },
