          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1779253780971",
          "code": "GETARTICLECONTENTBODY",
          "type": "CODE",
          "metadata": {
            "name": "getArticleContentBody",
            "returnType": "string",
            "sourceCode": "let articleContent = \"\";\n\ntry {\n  const contentBody = $context.$nodes.GET_ARTICLE_CONTENT.$output?.contentBody || {};\n  const keys = Object.keys(contentBody);\n  const firstKey = keys.length > 0 ? keys[0] : null;\n\n  if (firstKey) {\n    articleContent = contentBody[firstKey]?.value || \"\";\n\n    if (typeof articleContent === \"string\") {\n      articleContent = articleContent.replace(/<img\\b[^>]*>/gi, \"\").replace(/<[^>]*>/g, \"\").replace(/\\\\*\"/g, \"'\").replace(/(?:\\u202F|\\u00A0|\\u0000|[\\x00-\\x1F]|[\"\"'']|\\\\u[0-9A-Fa-f]{4})/g, \" \").replace(/\\s+/g, \" \").trim();\n   }\n  }\n} catch (error) {\n  articleContent = \"\";\n}\n\nreturn articleContent;\n\n"
          },
          "diagram": {
            "x": 7859.543645035193,
            "y": 10620.869696894073
          },
          "outcomes": {
            "success": "1771405743706"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1779253895562",
          "code": "CLEAN_ARTICLECONTENT",
          "type": "CODE",
          "metadata": {
            "name": "clean articleContent",
            "returnType": "string",
            "sourceCode": "let articleContent = \"\";\ntry {\n  const contentBody = $context.$nodes.OPENARTICLE.$output?.contentBody || {};\n  const keys = Object.keys(contentBody);\n  const firstKey = keys.length > 0 ? keys[0] : null;\n\n  if (firstKey) {\n    articleContent = contentBody[firstKey]?.value || \"\";\n\n    articleContent = articleContent.replace(/\\n/g, \"\").replace(/\\s{2,}/g, \"\").replace(/>\\s+</g, \"><\").replace(/<table\\b[^>]*>/gi, '<table style=\"border-collapse: collapse; width: 100%; border: 1px solid #ccc;\">').replace(/<a\\b[^>]*>(.*?)<\\/a>/gi, \"$1\").replace(/<th\\b([^>]*)>/gi, '<th style=\"border: 1px solid #ccc; padding: 8px; text-align: left;\">').replace(/<td\\b([^>]*)>/gi, '<td style=\"border: 1px solid #ccc; padding: 8px;\">').replace(/<img\\b[^>]*>/gi, (imgTag) => {\n        const widthMatch = imgTag.match(/\\bwidth\\s*=\\s*\"?(\\d+)\"?/i);\n        const heightMatch = imgTag.match(/\\bheight\\s*=\\s*\"?(\\d+)\"?/i);\n\n        const width = widthMatch ? parseInt(widthMatch[1], 10) : null;\n        const height = heightMatch ? parseInt(heightMatch[1], 10) : null;\n\n        if (width !== null && height !== null && width < 500 && height < 500) {\n          return imgTag;\n        }\n\n        let updatedTag = imgTag.replace(/\\sstyle\\s*=\\s*\"[^\"]*\"/gi, \"\").replace(/\\sstyle\\s*=\\s*'[^']*'/gi, \"\").replace(/\\swidth\\s*=\\s*\"[^\"]*\"/gi, \"\").replace(/\\swidth\\s*=\\s*'[^']*'/gi, \"\").replace(/\\sheight\\s*=\\s*\"[^\"]*\"/gi, \"\").replace(/\\sheight\\s*=\\s*'[^']*'/gi, \"\");\n\n        updatedTag = updatedTag.replace(/<img/i, '<img width=\"500\" height=\"500\"');\n\n        return updatedTag;\n      })\n      .trim();\n  }\n} catch (error) {\n  articleContent = \"\";\n}\n\nreturn articleContent;\n"
          },
          "diagram": {
            "x": 10425.608551228363,
            "y": 5828.6416298902905
          },
          "outcomes": {
            "success": "1779253919573"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
