        {
          "id": "1779253694337",
          "code": "SETISSUEFILTERSROUTPUT",
          "type": "CODE",
          "metadata": {
            "name": "setIssueFilterSROutput",
            "returnType": "string",
            "sourceCode": "const hrItems = $context.$nodes.GETISSUEHRREQUESTS?.$output?.items ?? [];\nconst isrItems = $context.$nodes.GETISSUEISRREQUESTS?.$output?.items ?? [];\n\nreturn JSON.stringify([...hrItems, ...isrItems]);"
          },
