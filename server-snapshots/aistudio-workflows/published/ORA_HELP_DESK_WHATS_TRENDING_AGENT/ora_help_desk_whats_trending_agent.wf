            "sourceCode": "const intent = $context.$nodes.FINDSRROUTE.$output.route;\nlet newIntent = intent;\nif (intent === \"default\")\n{ newIntent = \"open\"; }\nreturn newIntent;"
          },
          "outcomes": {
            "success": "1770812811207"
          },
