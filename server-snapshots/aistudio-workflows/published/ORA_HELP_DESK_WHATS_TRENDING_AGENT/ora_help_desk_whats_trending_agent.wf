        {
          "metadata": {
            "name": "SalutationResponse"
          },
          "outcomes": {
            "success": "1770811244836"
          },
          "code": "SALUTATIONRESPONSE",
          "id": "1770811159120",
          "inputs": [
            {
              "id": "1770811159121_1",
              "name": "prompt",
              "type": "string",
              "value": "### Goal\nGenerate a short, friendly reply to a pure salutation.\n\n### Input\n- userQuery: {{$context.$system.$inputMessage}} \n\n### Rules\n- Treat userQuery as a greeting or acknowledgment only.\n- Reply warm, natural, concise (1–2 lines).\n- No new topics, no explanations.\n- If closing salutation (e.g., \"thanks\", \"thank you\", \"ok\", \"noted\") → brief courteous reply.\n- If opening salutation (e.g., \"hi\", \"hello\") → greet and invite to continue.\n- If userQuery asks about your capabilities (e.g., \"how can you help?\", \"what can you do?\") → respond with:\n     \"I am a Help Desk Assistant here to assist with your requests. I can provide popular knowledge articles, answer employee questions, help you log help desk tickets, and fetch your ticket details. How can I help you today?\"\n\n### OUTPUT_FORMAT (STRICT)\n- Must Generate the output in {{$context.$triggers.REST.$input.OraUserContext.locale}} language."
            }
          ],
          "type": "LLM",
          "diagram": {
            "x": 8310,
            "y": 6592
          }
        },
