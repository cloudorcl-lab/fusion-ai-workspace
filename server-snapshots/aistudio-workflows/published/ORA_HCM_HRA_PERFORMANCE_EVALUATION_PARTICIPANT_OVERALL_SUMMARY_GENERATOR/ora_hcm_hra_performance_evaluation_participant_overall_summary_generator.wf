{
  "workflowId": "300000331067925",
  "workflowCode": "ORA_HCM_HRA_PERFORMANCE_EVALUATION_PARTICIPANT_OVERALL_SUMMARY_GENERATOR",
  "name": "Performance Evaluation Participant Overall Summary Generator",
  "description": "Generates evaluation comments for a participant on an overall summary in a performance document.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
