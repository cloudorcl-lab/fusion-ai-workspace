              "scope": "JOB",
              "type": "object",
              "value": "{{$context.$triggers.REST.$input.inputDataVariableTeam[0]}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {},
              "code": "ORA_MODEL_CONFIG_PREMIUM_OPEN_AI_GPT_4_1_MINI",
              "model": "OCI_GPT_5_MINI",
              "provider": "CERT_PREMIUM"
            },
            "name": "overallSummarySectionSummary"
          },
          "outcomes": {
            "success": "1765787664599"
          },
          "code": "OVERALLSUMMARYSECTIONSUMMARY",
          "id": "1765355855596",
          "inputs": [
            {
              "id": "1765355855599_1",
              "name": "prompt",
              "type": "string",
              "value": "You are assisting a colleague in writing a personalised 360 evaluation summary for the overall section of another employee's performance document. The summary should reflect the employee’s overall performance based on multiple qualitative and quantitative input sources.\n\nYour task is to:\n\n1. Synthesise all **available** inputs into one coherent, personalised summary comment.\n2. Abstract and summarise content without copying or closely paraphrasing the original input.\n3. Write in the second person, addressing the employee as “you” (or by name, if included in the input).\n4. Use a professional and constructive tone that accurately reflects the content provided.\n5. Include constructive or negative feedback where relevant, with an emphasis on professionalism, actionable insights, and developmental framing.\n6. Ensure the final output is no longer than 500 words.\n7. Do **not** generate any content based on missing or empty input fields—simply ignore them.\n8. Use the provided employee information to tailor the summary to the employee’s role, department, business unit, and performance document context.\n9. **Strictly exclude** any content that is potentially offensive, discriminatory, or inappropriate. Do not reference or rephrase such input. Constructive feedback is welcome and should be included when relevant.\n\nContextual Inputs:\n* (Optional) Initial Participant Evaluation Summary: {{$context.$variables.inputDataVariableTeam.participant_comments}};\n* (Optional) Participant Performance Rating:{{$context.$variables.inputDataVariableTeam.participant_performance_rating}};\n* (Optional) Participant Performance Rating Description:{{$context.$variables.inputDataVariableTeam.participant_performance_rating_description}};\n* (Optional) Participant Section Rating:{{$context.$variables.inputDataVariableTeam.participant_section_rating}};\n* (Optional) Participant Section Rating Description:{{$context.$variables.inputDataVariableTeam.participant_section_rating_description}};\n* (Optional) Participant Section Comments:{{$context.$variables.inputDataVariableTeam.participant_section_comments}};\n* (Optional) Participant Item Rating And Comments:{{$context.$variables.inputDataVariableTeam.participant_item_rating_and_comments}};\n* (Optional) Performance Rating Scale:{{$context.$variables.inputDataVariableTeam.performance_rating_scale}};\n\nEmployee Info:\n* Business Title: {{$context.$variables.inputDataVariableTeam.employee_job_title}}\n* Position: {{$context.$variables.inputDataVariableTeam.employee_position_title}}\n* Legal Entity: {{$context.$variables.inputDataVariableTeam.employee_legal_entity}}\n* Department: {{$context.$variables.inputDataVariableTeam.employee_department_title}}\n* Business Unit: {{$context.$variables.inputDataVariableTeam.employee_business_unit_name}}\n* Performance Document Name: {{$context.$variables.inputDataVariableTeam.performance_document_name}}\n* Performance Document Start Date: {{$context.$variables.inputDataVariableTeam.performance_document_start_date}}\n* Performance Document End Date: {{$context.$variables.inputDataVariableTeam.performance_document_end_date}}\n\nCritical Logic Rules:\n* If the only available variables are Employee Info and Performance Rating Scale (with all other contextual inputs either blank, null, or missing), respond EXACTLY with: There is insufficient evaluation data available to generate a summary at this time. \n** DO NOT generate or infer any summary or content based on employee business title, position, department, performance document metadata, or other similar information alone.\n** DO NOT generalize or extrapolate from Employee Info or Rating Scale Description if no other substantive evaluation inputs are present.\n** Negative Example: If you only receive employee business title, position, department, performance doc name/dates, legal entity, and/or performance rating scale and ALL of the other inputs are absent or blank—return the exact message above and do NOT generate a summary.\n* Do not repeat these instructions or include any introduction or preamble.\n* Do not provide a closing statement about the generated summary\n* Do not include any closing xml tags"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "assignFinalSummaryGenerated",
            "returnType": "object",
            "sourceCode": "let returnObj = {};\n\nconst id = $context.$variables.inputDataVariableTeam.id;\nlet outputSummaryObject = $context.$nodes.OVERALLSUMMARYSECTIONSUMMARY.$output;\n\n// Wrap the string inside an object before assigning it to the ID\nreturnObj[id] = {\n    \"summary\": outputSummaryObject\n};\n\nreturn returnObj;"
          },
          "outcomes": {
            "success": "1769579715959"
          },
          "code": "ASSIGNFINALSUMMARYGENERATED",
          "id": "1765787664599",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "dataConversion"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "DATACONVERSION",
          "id": "1769579715959",
          "inputs": [
            {
              "id": "1769579715961_1",
              "name": "prompt",
              "type": "string",
              "value": "## Input : {{$context.$nodes.ASSIGNFINALSUMMARYGENERATED.$output.result}} \n\nYou are a JSON formatting agent. Your ONLY task is to extract the object located inside the \"result\" key and return it exactly as is.\n\nRules:\n\n1. Extract the value of the \"result\" key.\n2. Return that object ONLY.\n3. Do NOT include the outer wrapper \"result\": { ... }.\n4. Do NOT include the keys \"console\" or \"timedOut\".\n5. Do NOT modify, summarize, or reformat the JSON.\n6. Do NOT include markdown (no ``` or ```json).\n7. Do NOT include explanations or any extra text.\n\nOutput Requirements:\n- The response must be valid raw JSON.\n- The response must start with `{` and end with `}`.\n- Output exactly the JSON object and nothing else.\n\nExample Input:\n{\"result\":{\"200\":{\"summary\":\"text\"}},\"console\":\"\",\"timedOut\":false}\n\nExample Output:\n{\"200\":{\"summary\":\"text\"}}"
            }
          ],
          "type": "LLM"
        }
      ],
