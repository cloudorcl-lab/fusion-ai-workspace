{
  "workflowId": "100002355227053",
  "workflowCode": "ORA_RMC_USERS_DATA_ENRICHMENT_ASSISTANT",
  "name": "RMC Users Data Enrichment Assistant",
  "description": "Identifies the top five accounts by violation volume, enriches each profile with workforce attributes, and summarizes investigation context.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "node_get_clob"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "description": "End of data pipeline",
            "name": "End"
          },
          "outcomes": {},
          "code": "END",
          "id": "end",
          "inputs": [],
          "type": "END"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_GRC_OTHER_DESCRIPTIONCLOB",
            "functionName": "get_announcements-DescriptionClob",
            "name": "Get User Violation Details from CLOB"
          },
          "outcomes": {
            "success": "node_compute_top5"
          },
          "code": "GET_USER_VIOLATION_DETAILS_FROM_CLOB",
          "id": "node_get_clob",
          "inputs": [
            {
              "id": "input_announcement_id",
              "name": "announcements_Id",
              "type": "string",
              "value": "894871897531003"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Compute Top 5 User Summary",
            "returnType": "array",
            "sourceCode": "var data = $context.$nodes.GET_USER_VIOLATION_DETAILS_FROM_CLOB.$output;\n\nvar result = null;\nif (data) {\n    var parsedData = data;\n    if (typeof data === 'string') {\n        try {\n            parsedData = JSON.parse(data);\n        } catch (e) {\n            var trimmed = data.trim();\n            if ((trimmed.startsWith('\"') && trimmed.endsWith('\"')) ||\n                (trimmed.startsWith(\"'\") && trimmed.endsWith(\"'\"))) {\n                try {\n                    parsedData = JSON.parse(trimmed.slice(1, -1));\n                } catch (e2) {\n                    parsedData = null;\n                }\n            } else {\n                parsedData = null;\n            }\n        }\n    }\n\n    if (Array.isArray(parsedData)) {\n        var userSummaryArray = parsedData;\n        var finalUserSummaryMap = new Map();\n\n        userSummaryArray.forEach(function(item) {\n            var key = item.UserName;\n            if (!finalUserSummaryMap.has(key)) {\n                finalUserSummaryMap.set(key, {\n                    UserName: item.UserName,\n                    Controls: new Set(),\n                    NumIncidents: 0,\n                    NumControls: 0\n                });\n            }\n            var group = finalUserSummaryMap.get(key);\n            group.Controls.add(item.ControlName);\n            group.NumIncidents += item.NumIncidents;\n            group.NumControls = group.Controls.size;\n        });\n\n        result = Array.from(finalUserSummaryMap.values()).map(function(group) {\n            return {\n                UserName: group.UserName,\n                Controls: Array.from(group.Controls).join(','),\n                NumControls: group.NumControls,\n                NumIncidents: group.NumIncidents\n            };\n        });\n\n        result = result.sort(function(a, b) { return b.NumIncidents - a.NumIncidents; });\n        result = result.slice(0, 5);\n    }\n}\nreturn result;"
          },
          "outcomes": {
            "success": "node_enrich_loop"
          },
          "code": "COMPUTE_TOP_5_USER_SUMMARY",
          "id": "node_compute_top5",
          "inputs": [],
          "outputSpecification": "{}",
          "type": "CODE"
        },
        {
          "metadata": {
            "dataPipeline": {
              "pipelineNodes": [
                {
                  "metadata": {
                    "name": "Start",
                    "description": "Start of loop iteration"
                  },
                  "outcomes": {
                    "success": "loop_call_enrich"
                  },
                  "id": "loop_start",
                  "code": "LOOP_START",
                  "type": "START"
                },
                {
                  "metadata": {
                    "name": "End",
                    "description": "End of loop iteration"
                  },
                  "id": "loop_end",
                  "code": "LOOP_END",
                  "type": "END"
                },
                {
                  "metadata": {
                    "workflowCode": "ORA_RMC_USER_DATA_ENRICHMENT_ASSISTANT",
                    "name": "Enrich User Data"
                  },
                  "outcomes": {
                    "success": "loop_end"
                  },
                  "code": "ENRICH_USER_DATA",
                  "id": "loop_call_enrich",
                  "inputs": [
                    {
                      "id": "input_username",
                      "name": "username",
                      "type": "string",
                      "value": "{{$context.$nodes.ENRICH_USERS_LOOP.$currentItem.UserName}}"
                    }
                  ],
                  "outputSpecification": "{}",
                  "type": "WORKFLOW"
                }
              ],
              "rootNode": "loop_start"
            },
            "loopType": "PARALLEL",
            "name": "Enrich Users Loop"
          },
          "outcomes": {
            "success": "node_merge_results"
          },
          "code": "ENRICH_USERS_LOOP",
          "id": "node_enrich_loop",
          "inputs": [
            {
              "id": "loop_collection",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.COMPUTE_TOP_5_USER_SUMMARY.$output.result}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "Merge Enrichment Results",
            "returnType": "array",
            "sourceCode": "var loopOutput = $context.$nodes.ENRICH_USERS_LOOP.$output;\nvar summaryData = $context.$nodes.COMPUTE_TOP_5_USER_SUMMARY.$output.result;\nvar result = [];\nif (loopOutput && summaryData) {\n    var enrichmentArray = [];\n    if (Array.isArray(loopOutput)) {\n        loopOutput.forEach(function(item) {\n            var outer = item;\n            if (typeof item === 'string') {\n                try { outer = JSON.parse(item); } catch(e) { outer = null; }\n            }\n            if (outer && outer.output) {\n                var inner = outer.output;\n                if (typeof inner === 'string') {\n                    try { inner = JSON.parse(inner); } catch(e) { inner = null; }\n                }\n                if (inner && inner.result) {\n                    enrichmentArray.push(inner.result);\n                }\n            }\n        });\n    }\n    var enrichmentMap = {};\n    enrichmentArray.forEach(function(e) {\n        if (e && e.username) {\n            enrichmentMap[e.username] = e;\n        }\n    });\n    result = summaryData.map(function(user) {\n        var enrichment = enrichmentMap[user.UserName] || {};\n        var r = { UserName: user.UserName, Controls: user.Controls, NumControls: user.NumControls, NumIncidents: user.NumIncidents, position: enrichment.position || 'N/A', manager: enrichment.manager || 'N/A', displayname: enrichment.displayname || user.UserName };\n        return r;\n    });\n}\nvar finalResult = result;\nreturn finalResult;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "MERGE_ENRICHMENT_RESULTS",
          "id": "node_merge_results",
          "inputs": [],
          "outputSpecification": "{}",
          "type": "CODE"
        }
      ],
      "rootNode": "start",
      "variables": [],
      "errorHandlers": []
    },
