          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}"
        },
        {
          "id": "1779841438282",
          "code": "GET_CONFIGURATION",
          "type": "CODE",
          "metadata": {
            "name": "Get Configuration",
            "sourceCode": "let result = {};\ntry {\n  // Access runtime settings output safely\n  let runtimeOutput = $context.$nodes?.GET_RUNTIME_SETTINGS?.$output?.output || {};\n\n  // If runtimeOutput is a string, attempt to parse it as JSON\n  if (typeof runtimeOutput === \"string\") {\n    try {\n      runtimeOutput = JSON.parse(runtimeOutput);\n    } catch (parseError) {\n      // If parsing fails, fallback to empty object\n      runtimeOutput = {};\n    }\n  }\n\n  // Extract filterConfiguration and commonConfiguration with fallback to empty objects\n  const filterConfiguration = runtimeOutput.filterConfiguration || {};\n  const commonConfiguration = runtimeOutput.commonConfiguration || {};\n\n  // Construct the action object with accountIds from workflow variable\n  const accountId = $context.$variables?.accountId || null;\n\n  result = {\n    action: {\n      name: \"GET_OWNED_PRODUCTS_BY_PRODUCT_HIERARCHY\",\n      config: {\n        accountIds: accountId\n      }\n    },\n    filterConfiguration: filterConfiguration,\n    commonConfiguration: commonConfiguration\n  };\n} catch (error) {\n  // Return empty object on error\n  result = {};\n}\n\nreturn result;\n",
            "returnType": "object"
          },
          "diagram": {
