        {
          "metadata": {
            "name": "Account Summary Parameter",
            "returnType": "array",
            "sourceCode": "let result = [];\ntry {\n  const items = $context.$nodes?.RETRIEVE_ACCOUNT_SUMMARY?.$output?.items || [];\n  result = items.map(item => {\n    try {\n      return JSON.parse(item.payload);\n    } catch (parseError) {\n      return null;\n    }\n  }).filter(parsedItem => parsedItem !== null);\n} catch (error) {\n  result = [];\n}\nreturn result;"
          },
