          "id": "1775863432863",
          "code": "PROCESS_ACCOUNT_SUMMARY",
          "type": "LLM",
          "inputs": [
            {
              "id": "1775863432863_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Use all rows in {{$context.$variables.summaryArray}} as a single consolidated input. Card generation logic:\n- Do not process rows independently.\n- Consolidate all rows first.\n- Based on the combined RollupMetrics across the full array, generate an array of rows that indicate:\n  - alert\n  - risk\n  - opportunity\nRules:\n- Use RollupMetrics as the primary source for identifying whether a card should be shown.\n- If RollupMetrics is unclear or incomplete, use the combined meaning of summaries, titles, and key fact signals across all rows.\n- Merge overlapping themes into consolidated cards.\n- Do not create duplicate cards for the same theme.\n- Each card should represent a distinct consolidated business signal.\nFor each consolidated card, generate:\n1. BadgeText - Determine severity based on urgency and business impact\n   - Use concise business labels such as:\n     - Needs Attention\n     - Opportunity\n     - High Risk\n     - Watchlist\n     - Positive Signal\n2. Subject - Generate a short, scannable title with count and type\n   - Examples:\n     - 1 Open Opportunity\n     - 2 Critical Service Requests\n     - 3 Expansion Signals\n     - 1 Engagement Risk\n3. Summary - Write 1 to 2 concise sentences\n   - Summarize what is happening, why it matters, and the likely business impact\n   - Use consolidated evidence from summaries, facts, and RollupMetrics\n   - Do not dump raw data\n4. Variant - Populate this property based on the severity category:\n   - Use \"warning\" for alerts\n   - Use \"error\" for risks\n   - Use \"info\" for opportunities\nEnsure each card includes this Variant property reflecting its severity classification."
            },
            {
              "id": "1775863432863_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "Return an array of rows with the mentioned properties"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"BadgeText\": {\n        \"type\": \"string\"\n      },\n      \"Subject\": {\n        \"type\": \"string\"\n      },\n      \"Summary\": {\n        \"type\": \"string\"\n      },\n      \"Variant\": {\n        \"type\": \"string\"\n      }\n    },\n    \"required\": [\n      \"BadgeText\",\n      \"Subject\",\n      \"Summary\",\n      \"Variant\"\n    ],\n    \"additionalProperties\": false\n  }\n}"
        },
        {
          "metadata": {
            "name": "Refine Accounts",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  // Access items array from GET_COMPANY_NEWS node output\n  const items = $context.$nodes?.GET_COMPANY_NEWS?.$output?.items || [];\n\n  if (items.length > 0) {\n    const firstItem = items[0];\n    const payloadStr = firstItem?.payload || \"\";\n\n    // Parse payload string as JSON safely\n    let payloadObj = {};\n    try {\n      payloadObj = JSON.parse(payloadStr);\n    } catch (parseError) {\n      // If parsing fails, keep payloadObj as empty object\n      payloadObj = {};\n    }\n\n    // Access nested property: payload.what.facts.accountSummary\n    // Use optional chaining for safety\n    const accountSummary = payloadObj?.what?.facts?.accountSummary || null;\n\n    result = { accountSummary };\n  } else {\n    // No items, return accountSummary as null\n    result = { accountSummary: null };\n  }\n} catch (error) {\n  // On error, return accountSummary as null\n  result = { accountSummary: null };\n}\n\nreturn result;"
          },
