        {
          "metadata": {
            "name": "Parse AppContext",
            "sourceCode": "let result = {};\ntry {\n  const appContext = $context.$app?.$OraAppContext || \"\";\n  if (!appContext) {\n    result = {};\n  } else {\n    const decoded = decodeURIComponent(appContext);\n    const jsonString = decoded.replace(/([\\w]+):/g, '\"$1\":');\n    const obj = JSON.parse(jsonString);\n    const accountId = obj.accountId || null;\n    const accountNumber = obj.accountNumber || null;\n    const activityNumber = obj.activityNumber || null;\n    result = { accountId, accountNumber, activityNumber };\n  }\n} catch (error) {\n  result = {};\n}\n\nreturn result;",
            "returnType": "object"
          },
          "diagram": {
            "x": 6165.5,
            "y": 5206
          },
          "outcomes": {
            "success": "1775861249327"
          },
          "id": "1775861245471",
          "code": "PARSE_APPCONTEXT",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
