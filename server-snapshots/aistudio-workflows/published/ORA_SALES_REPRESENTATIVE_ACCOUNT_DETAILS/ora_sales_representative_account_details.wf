          "typeSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"schemaVersion\": {\n      \"type\": \"string\",\n      \"pattern\": \"^\\\\d+\\\\.\\\\d+$\"\n    },\n    \"what\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"title\": {\n          \"type\": \"string\"\n        },\n        \"summary\": {\n          \"type\": \"string\"\n        },\n        \"facts\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"opportunity_engagement\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"summary\": {\n                  \"type\": \"string\"\n                },\n                \"sentiment\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"summary\": {\n                      \"type\": \"string\"\n                    }\n                  },\n                  \"required\": [\n                    \"summary\"\n                  ],\n                  \"additionalProperties\": false\n                },\n                \"product_focus\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"summary\": {\n                      \"type\": \"string\"\n                    },\n                    \"details\": {\n                      \"type\": \"string\"\n                    }\n                  },\n                  \"required\": [\n                    \"summary\",\n                    \"details\"\n                  ],\n                  \"additionalProperties\": false\n                },\n                \"industry_focus\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"summary\": {\n                      \"type\": \"string\"\n                    },\n                    \"details\": {\n                      \"type\": \"string\"\n                    }\n                  },\n                  \"required\": [\n                    \"summary\",\n                    \"details\"\n                  ],\n                  \"additionalProperties\": false\n                },\n                \"signals\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"summary\": {\n                      \"type\": \"string\"\n                    },\n                    \"details\": {\n                      \"type\": \"string\"\n                    }\n                  },\n                  \"required\": [\n                    \"summary\",\n                    \"details\"\n                  ],\n                  \"additionalProperties\": false\n                }\n              },\n              \"required\": [\n                \"summary\",\n                \"sentiment\",\n                \"product_focus\",\n                \"industry_focus\",\n                \"signals\"\n              ],\n              \"additionalProperties\": false\n            },\n            \"contact_engagement\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"summary\": {\n                  \"type\": \"string\"\n                },\n                \"sentiment\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"summary\": {\n                      \"type\": \"string\"\n                    }\n                  },\n                  \"required\": [\n                    \"summary\"\n                  ],\n                  \"additionalProperties\": false\n                },\n                \"product_focus\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"summary\": {\n                      \"type\": \"string\"\n                    },\n                    \"details\": {\n                      \"type\": \"string\"\n                    }\n                  },\n                  \"required\": [\n                    \"summary\",\n                    \"details\"\n                  ],\n                  \"additionalProperties\": false\n                },\n                \"industry_focus\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"summary\": {\n                      \"type\": \"string\"\n                    },\n                    \"details\": {\n                      \"type\": \"string\"\n                    }\n                  },\n                  \"required\": [\n                    \"summary\",\n                    \"details\"\n                  ],\n                  \"additionalProperties\": false\n                },\n                \"signals\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"summary\": {\n                      \"type\": \"string\"\n                    },\n                    \"details\": {\n                      \"type\": \"string\"\n                    }\n                  },\n                  \"required\": [\n                    \"summary\",\n                    \"details\"\n                  ],\n                  \"additionalProperties\": false\n                }\n              },\n              \"required\": [\n                \"summary\",\n                \"sentiment\",\n                \"product_focus\",\n                \"industry_focus\",\n                \"signals\"\n              ],\n              \"additionalProperties\": false\n            },\n            \"direct_account_engagement\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"summary\": {\n                  \"type\": \"string\"\n                },\n                \"sentiment\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"summary\": {\n                      \"type\": \"string\"\n                    }\n                  },\n                  \"required\": [\n                    \"summary\"\n                  ],\n                  \"additionalProperties\": false\n                },\n                \"product_focus\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"summary\": {\n                      \"type\": \"string\"\n                    },\n                    \"details\": {\n                      \"type\": \"string\"\n                    }\n                  },\n                  \"required\": [\n                    \"summary\",\n                    \"details\"\n                  ],\n                  \"additionalProperties\": false\n                },\n                \"industry_focus\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"summary\": {\n                      \"type\": \"string\"\n                    },\n                    \"details\": {\n                      \"type\": \"string\"\n                    }\n                  },\n                  \"required\": [\n                    \"summary\",\n                    \"details\"\n                  ],\n                  \"additionalProperties\": false\n                },\n                \"signals\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"summary\": {\n                      \"type\": \"string\"\n                    },\n                    \"details\": {\n                      \"type\": \"string\"\n                    }\n                  },\n                  \"required\": [\n                    \"summary\",\n                    \"details\"\n                  ],\n                  \"additionalProperties\": false\n                }\n              },\n              \"required\": [\n                \"summary\",\n                \"sentiment\",\n                \"product_focus\",\n                \"industry_focus\",\n                \"signals\"\n              ],\n              \"additionalProperties\": false\n            }\n          },\n          \"required\": [\n            \"opportunity_engagement\",\n            \"contact_engagement\",\n            \"direct_account_engagement\"\n          ],\n          \"additionalProperties\": false\n        }\n      },\n      \"required\": [\n        \"title\",\n        \"summary\",\n        \"facts\"\n      ],\n      \"additionalProperties\": false\n    }\n  },\n  \"required\": [\n    \"schemaVersion\",\n    \"what\"\n  ],\n  \"additionalProperties\": false\n}"
