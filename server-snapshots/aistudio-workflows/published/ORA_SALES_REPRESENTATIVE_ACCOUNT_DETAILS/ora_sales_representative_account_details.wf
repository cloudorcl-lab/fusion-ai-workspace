            "name": "Retrieve Insights Array",
            "sourceCode": "let result = [];\ntry {\n  const items = $context.$nodes?.ACCOUNT_INSIGHTS?.$output?.items || [];\n  result = items.reduce((insights, item) => {\n    const payloadStr = item?.payload;\n    if (typeof payloadStr === 'string') {\n      try {\n        const parsed = JSON.parse(payloadStr);\n        insights.push(parsed);\n      } catch (e) {\n      }\n    }\n    return insights;\n  }, []);\n} catch (error) {\n  result = [];\n}\nreturn result;",
            "returnType": "array"
