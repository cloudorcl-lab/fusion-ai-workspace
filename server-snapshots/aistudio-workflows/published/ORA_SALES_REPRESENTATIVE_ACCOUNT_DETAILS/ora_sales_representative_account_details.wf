        {
          "id": "1779823162698",
          "code": "PAYLOAD_FOR_RECOMMENDATIONS",
          "type": "CODE",
          "metadata": {
            "name": "Payload for Recommendations",
            "sourceCode": "let result = {};\ntry {\n  // Access the array of opportunity rows safely\n  const opportunityRows = $context.$nodes?.GET_OPPORTUNITIES_FOR_ACCOUNT?.$output || [];\n\n  // Extract OptyNumber from each row to build objectAltKeys array\n  const objectAltKeys = opportunityRows\n    .map(row => row?.OptyNumber)\n    .filter(optyNumber => typeof optyNumber === 'string');\n\n  // Build standardParameters JSON string\n  const standardParameters = JSON.stringify({\n    objectType: \"OPPORTUNITY\",\n    objectAltKeys: objectAltKeys\n  });\n\n  // Build optionalParameters string as specified\n  const optionalParameters = \"outcomeType = 'RECOMMENDATION' and outcomeReferences[primaryRef='Y']\";\n\n  // Assign to result object\n  result = {\n    standardParameters: standardParameters,\n    optionalParameters: optionalParameters\n  };\n} catch (error) {\n  // Fallback empty object on error\n  result = {\n    standardParameters: JSON.stringify({ objectType: \"OPPORTUNITY\", objectAltKeys: [] }),\n    optionalParameters: \"outcomeType = 'RECOMMENDATION' and outcomeReferences[primaryRef='Y']\"\n  };\n}\n\nreturn result;",
            "returnType": "object"
          },
          "diagram": {
            "x": 5009,
            "y": 7204
          },
          "outcomes": {
            "success": "1779823426670"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
