        {
          "id": "1779838098943",
          "code": "REFINE_RECOMMENDATIONS",
          "type": "CODE",
          "metadata": {
            "name": "Refine Recommendations",
            "sourceCode": "let result = [];\ntry {\n  const recommendationItems = $context.$nodes?.GET_RECOMMENDATIONS?.$output?.items || [];\n  for (const item of recommendationItems) {\n    const payload = item?.payload;\n\n    if (!payload) continue;\n\n    const payloadObj =\n      typeof payload === \"string\"\n        ? JSON.parse(payload)\n        : payload;\n\n    const actions = payloadObj?.next?.actions || [];\n    const opportunityId = item?.primaryObjectKey || null; \n    for (const action of actions) {\n      result.push({\n        Type: action?.type || \"\",\n        Title: action?.label || \"\",\n        Task: action?.description || \"\",\n        opportunityId: opportunityId\n      });\n    }\n  }\n} catch (error) {\n  result = [];\n}\nreturn result;",
            "returnType": "array"
          },
          "diagram": {
            "x": 5010.5,
            "y": 7648
          },
          "outcomes": {
            "success": "1779838342584"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
