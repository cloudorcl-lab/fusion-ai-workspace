        {
          "metadata": {
            "name": "ChunkAccountIds",
            "returnType": "object",
            "sourceCode": "const rawAccountIds = $context.$triggers.REST.$input.action.config.listOfAccountIds;\n\nconst accountIdsArray = Array.isArray(rawAccountIds)\n  ? rawAccountIds\n  : (rawAccountIds != null && rawAccountIds.trim() !== \"\"\n      ? rawAccountIds.split(\",\").map(id => id.trim()).filter(id => id !== \"\")\n      : []);\n\nconst batchSizeRaw = $context.$triggers.REST.$input.action.config.accountBatchSize;\nconst accBatchSize = Number(batchSizeRaw) || 1;\n\nconst collections = [];\n\nfor (let i = 0; i < accountIdsArray.length; i += accBatchSize) {\n    const batch = accountIdsArray.slice(i, i + accBatchSize);\n\n    if (accountIdsArray.length === 1 && batch.length === 1) {\n        collections.push([-1, ...batch]);\n    } else {\n        collections.push(batch);\n    }\n}\n\nreturn collections;"
          },
          "outcomes": {
            "success": "1769635930350"
          },
          "code": "CHUNKACCOUNTIDS",
          "convergenceTargetId": "1764199334721",
          "id": "1764196388937",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
