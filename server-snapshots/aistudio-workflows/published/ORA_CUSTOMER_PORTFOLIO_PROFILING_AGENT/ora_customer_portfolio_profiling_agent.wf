            "sourceCode": "const rawAccountIds = $context.$triggers.REST.$input.action.config.listOfAccountIds;\n\nconst accountIds = Array.isArray(rawAccountIds)\n  ? rawAccountIds\n  : (rawAccountIds != null && rawAccountIds !== \"\"\n      ? rawAccountIds.split(\",\").map(id => id.trim()).filter(id => id !== \"\")\n      : []);\n\nreturn accountIds.length > 0;"
          },
