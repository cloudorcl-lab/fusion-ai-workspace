                    "returnType": "string",
                    "sourceCode": "let inClause = \"\";\n\nconst raw = $context.$nodes.LOOPACCOUNTS.$currentItem;\n\nconst ids = Array.isArray(raw) ? raw.flat(Infinity) : [];\n\nif (ids.length > 0) {\n    inClause = `fusionAccount.id IN (${ids.join(\",\")}) and (productFitStrength='Strong' or ownershipStatus='ORA_ACTIVE')`;\n}\n\nreturn inClause;"
