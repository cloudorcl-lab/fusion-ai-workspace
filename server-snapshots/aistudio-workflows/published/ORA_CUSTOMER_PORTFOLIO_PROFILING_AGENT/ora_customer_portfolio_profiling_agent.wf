                    "returnType": "object",
                    "sourceCode": "const batchSize =  $context.$triggers.REST.$input.action.config.productBatchSize;\nconst totalRows = $context.$nodes.LOOPACCOUNTS.COUNTPRODUCTS.$output.result ;\n\nconst collections = [];\nconst totalBatches = Math.ceil(totalRows / batchSize);\n\nfor (let i = 1; i <= totalBatches; i++) {\n  collections.push(i);\n}\n\nreturn collections;"
                  },
                  "outcomes": {
                    "success": "1769730820186"
                  },
                  "code": "CHUNKPRODUCTS",
