        {
          "metadata": {
            "name": "Prepare Resolved Organization Input",
            "returnType": "object",
            "sourceCode": "const q = $context.$nodes.SET_QUERY_ORG_FIELDS?.$output?.result || {};\nconst a = $context.$nodes.SET_APP_CONTEXT_ORG_FIELDS?.$output?.result || {};\nconst d = $context.$nodes.SET_DEFAULT_ORG_FROM_PROFILE?.$output?.result || {};\n\nconst clean = (v) => (v == null ? null : String(v).trim()) || null;\nconst pick = (...vals) => {\n  for (const v of vals) {\n    const c = clean(v);\n    if (c) return c;\n  }\n  return null;\n};\n\nconst pickNum = (...vals) => {\n  for (const v of vals) {\n    if (v == null || v === \"\") continue;\n    const n = Number(v);\n    if (Number.isFinite(n)) return Math.trunc(n);\n  }\n  return null;\n};\n\nconst mode = pick(q.mode, a.mode, d.mode, \"default\");\nconst organizationId = pick(q.organizationId, a.organizationId, d.organizationId);\nconst organizationCode = pick(q.organizationCode, a.organizationCode, d.organizationCode);\nconst age = pickNum(q.age, a.age, d.age, 30);\n\nreturn {\n  mode,\n  organizationId,\n  organizationCode,\n  age\n};"
          },
          "outcomes": {
            "success": "16"
          },
