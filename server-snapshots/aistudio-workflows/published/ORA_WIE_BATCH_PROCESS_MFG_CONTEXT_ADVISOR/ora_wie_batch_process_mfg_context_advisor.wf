        {
          "metadata": {
            "name": "Set App Context Org Fields",
            "returnType": "object",
            "sourceCode": "const req = $context.$nodes.DETECT_REQUEST_MODE.$output.result || {};\nconst toInt = (v) => {\n  if (v == null || v === \"\") return null;\n  const n = Number(v);\n  return Number.isFinite(n) ? Math.trunc(n) : null;\n};\n\nreturn {\n  mode: \"appContext\",\n  organizationId: req.appContextOrganizationId || null,\n  organizationCode: null,\n  age: toInt(req.age) ?? toInt(req.appContextAge) ?? 30\n};"
          },
          "outcomes": {
            "success": "4"
