{
  "workflowId": "300000331068579",
  "workflowCode": "ORA_WIE_BATCH_PROCESS_MFG_CONTEXT_ADVISOR",
  "name": "Batch Process Manufacturing Context Advisor",
  "description": "Resolves Manufacturing Plant and Age context for Batch Process Manufacturing Workspace.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "name": "Detect Request Mode",
            "returnType": "object",
            "sourceCode": "const oraMessageHint =\n  $context?.$app?.$OraMessageHint ??\n  $context?.$triggers?.REST?.$input?.OraMessageHint ??\n  null;\n\nconst inputMessage = String($context?.$system?.$inputMessage ?? \"\").trim();\nconst appContext = String(\n  $context?.$app?.$OraAppContext ??\n    $context?.$triggers?.REST?.$input?.OraAppContext ??\n    \"\"\n).trim();\n\nconst clean = (v) =>\n  v == null ? null : String(v).trim().replace(/^[:\\s\"']+|[\"']+$/g, \"\") || null;\n\nconst extractByPattern = (text, pattern) => {\n  const m = text.match(pattern);\n  return m && m[1] ? clean(m[1]) : null;\n};\n\nconst durationToDays = (value, unit) => {\n  const parsedValue = Number(value);\n  if (!Number.isFinite(parsedValue)) return null;\n\n  const normalizedUnit = String(unit || \"days\").trim().toLowerCase();\n  const multiplier = normalizedUnit.startsWith(\"year\")\n    ? 365\n    : normalizedUnit.startsWith(\"month\")\n      ? 30\n      : normalizedUnit.startsWith(\"week\")\n        ? 7\n        : 1;\n\n  return Math.round(parsedValue * multiplier);\n};\n\nconst hasUpdateVerb = /\\b(set|change|update|switch|reset)\\b/i.test(inputMessage);\nconst hasOrgKeyword = /\\b(org|organization|plant|mfg\\s*org|manufacturing\\s*org|manufacturing\\s*plant)\\b/i.test(inputMessage);\nconst hasAgeKeyword = /\\b(age|duration)\\b/i.test(inputMessage);\nconst hasContextKeyword = /\\b(context)\\b/i.test(inputMessage);\nconst hasDefaultKeyword = /\\b(default)\\b/i.test(inputMessage);\n\nconst useDefaultContext =\n  oraMessageHint === \"Query\" && hasUpdateVerb && hasDefaultKeyword && (hasContextKeyword || hasOrgKeyword);\n\nconst isQueryContextIntent =\n  oraMessageHint === \"Query\" && (useDefaultContext || (hasUpdateVerb && hasOrgKeyword) || (hasUpdateVerb && hasAgeKeyword));\n\nconst orgPattern =\n  /\\b(?:mfg\\s*org|manufacturing\\s*org|manufacturing\\s*plant|organization|org|plant)\\b\\s*(?:context)?\\s*(?:name|code)?\\s*(?:to|is|=|:)?\\s*([^,;]+?)(?=\\s*(?:,|;|\\band\\b|&|\\bage\\b|\\bduration\\b|$))/i;\nconst agePattern =\n  /\\b(?:age|duration)\\b\\s*(?:to|is|=|:)?\\s*(-?\\d+(?:\\.\\d+)?)\\s*(days?|weeks?|months?|years?)?\\b/i;\nconst relativeDurationPattern = /\\b(?:for|last|past)\\s+(?:the\\s+)?(-?\\d+(?:\\.\\d+)?)\\s*(days?|weeks?|months?|years?)\\b/i;\n\nconst isOrgCatalogRequest =\n  /\\b(show|display|list|search|find|get|view)\\b/i.test(inputMessage) &&\n  /\\b(plant|plants|org|orgs|organization|organizations|mfg\\s*org|mfg\\s*orgs|mfg\\s*plant|mfg\\s*plants|manufacturing\\s*org|manufacturing\\s*orgs|manufacturing\\s*organization|manufacturing\\s*organizations|manufacturing\\s*plant|manufacturing\\s*plants)\\b/i.test(inputMessage) &&\n  /\\b(all|access|available|starting\\s+with|starts\\s+with|prefix|plant\\s+codes?|org\\s+codes?|organization\\s+codes?|process\\s+manufacturing|non[-\\s]*process|discrete)\\b/i.test(inputMessage);\n\nfunction cleanCandidate(value) {\n  const candidate = clean(value);\n  if (!candidate) return null;\n\n  const normalized = candidate.toLowerCase();\n  if (/^(all|any|the|current|selected|default)$/.test(normalized)) return null;\n  if (/^for\\s+-?\\d+(?:\\.\\d+)?\\s*(days?|weeks?|months?|years?)?\\b/i.test(candidate)) return null;\n  if (/\\b(access|available|starting\\s+with|starts\\s+with|prefix|codes?)\\b/i.test(candidate)) return null;\n  if (/\\b(process\\s+manufacturing\\s+organizations?|non[-\\s]*process\\s+manufacturing\\s+organizations?)\\b/i.test(candidate)) return null;\n\n  return candidate;\n}\n\nfunction extractQueryOrganization(text) {\n  const boundary = String.raw`\\s*(?:,|;|\\band\\b|&|\\bage\\b|\\bduration\\b|\\bfor\\s+(?:the\\s+)?(?:last|past|-?\\d+(?:\\.\\d+)?\\s*(?:days?|weeks?|months?|years?)?)\\b|$)`;\n  const patterns = [\n    new RegExp(String.raw`\\b(?:for|in|at)\\s+[\"“]([^\"”]+?)[\"”](?=${boundary})`, \"i\"),\n    new RegExp(String.raw`\\b(?:for|in|at)\\s+([^,;\"”]+?(?:plant|org|organization))(?=${boundary})`, \"i\"),\n    new RegExp(String.raw`\\b(?:for|in|at)\\s+(?:the\\s+)?(?:mfg\\s*org|manufacturing\\s*org|manufacturing\\s*plant|organization|org|plant)\\s*(?:name|code)?\\s*(?:called|named)?\\s*[\"“]?([^,;\"”]+?)[\"”]?(?=${boundary})`, \"i\"),\n    new RegExp(String.raw`\\b(?:mfg\\s*org|manufacturing\\s*org|manufacturing\\s*plant|organization|org|plant)\\b\\s*(?:name|code)?\\s*(?:is|=|:)?\\s*[\"“]?([^,;\"”]+?)[\"”]?(?=${boundary})`, \"i\"),\n    new RegExp(String.raw`\\b(?:for|in|at)\\s+([A-Z][A-Z0-9_-]{1,30})(?=${boundary})`)\n  ];\n\n  for (const pattern of patterns) {\n    const candidate = cleanCandidate(extractByPattern(text, pattern));\n    if (candidate) return candidate;\n  }\n\n  return null;\n}\n\nconst contextOrganizationCode = extractByPattern(inputMessage, orgPattern);\nconst queryOverrideOrganizationCode =\n  oraMessageHint === \"Query\" && !isQueryContextIntent && !isOrgCatalogRequest\n    ? extractQueryOrganization(inputMessage)\n    : null;\n\nconst organizationCode = isQueryContextIntent ? contextOrganizationCode : queryOverrideOrganizationCode;\nlet age = null;\n\nconst ageMatch = inputMessage.match(agePattern);\nif (ageMatch && ageMatch[1]) {\n  age = durationToDays(ageMatch[1], ageMatch[2]);\n}\n\nconst relativeDurationMatch = inputMessage.match(relativeDurationPattern);\nif (age == null && relativeDurationMatch && relativeDurationMatch[1]) {\n  age = durationToDays(relativeDurationMatch[1], relativeDurationMatch[2]);\n}\n\nlet appContextOrganizationId = null;\nlet appContextAge = null;\n\nif (appContext && appContext.includes(\":\")) {\n  const [orgIdRaw, ageRaw] = appContext.split(\":\");\n  appContextOrganizationId = clean(orgIdRaw);\n\n  const parsedAge = Number(ageRaw);\n  appContextAge = Number.isFinite(parsedAge) ? Math.trunc(parsedAge) : null;\n}\n\nlet mode = \"default\";\nif (isQueryContextIntent) {\n  mode = \"query\";\n} else if (queryOverrideOrganizationCode) {\n  mode = \"queryOverride\";\n} else if (appContextOrganizationId) {\n  mode = \"appContext\";\n}\n\nreturn {\n  mode,\n  isQueryContextIntent,\n  useDefaultContext,\n  organizationCode,\n  age,\n  appContextOrganizationId,\n  appContextAge\n};"
          },
          "outcomes": {
            "success": "15"
          },
          "code": "DETECT_REQUEST_MODE",
          "id": "1",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
