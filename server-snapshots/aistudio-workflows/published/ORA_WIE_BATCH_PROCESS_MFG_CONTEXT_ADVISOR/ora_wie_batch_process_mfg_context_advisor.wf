          "inputs": [
            {
              "id": "7_condition",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.DETECT_REQUEST_MODE.$output.result.appContextOrganizationId != null && $context.$nodes.DETECT_REQUEST_MODE.$output.result.appContextOrganizationId != \"\"}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Set Query Org Fields",
            "returnType": "object",
            "sourceCode": "const req = $context.$nodes.DETECT_REQUEST_MODE.$output.result || {};\nconst toInt = (v) => {\n  if (v == null || v === \"\") return null;\n  const n = Number(v);\n  return Number.isFinite(n) ? Math.trunc(n) : null;\n};\n\nconst queryOrgCode = req.organizationCode || null;\nconst appContextOrgId = req.appContextOrganizationId || null;\nconst mode = req.mode === \"queryOverride\" ? \"queryOverride\" : \"query\";\n\nif (req.useDefaultContext === true) {\n  return {\n    mode: \"query\",\n    organizationId: null,\n    organizationCode: null,\n    age: 30\n  };\n}\n\nreturn {\n  mode,\n  organizationId: queryOrgCode ? null : appContextOrgId,\n  organizationCode: queryOrgCode,\n  age: toInt(req.age) ?? toInt(req.appContextAge) ?? 30\n};"
          },
          "outcomes": {
            "success": "4"
          },
          "code": "SET_QUERY_ORG_FIELDS",
          "id": "8",
