          "inputs": [
            {
              "id": "6_condition",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.DETECT_REQUEST_MODE.$output.result.isQueryContextIntent || $context.$nodes.DETECT_REQUEST_MODE.$output.result.mode == \"queryOverride\"}}"
            }
