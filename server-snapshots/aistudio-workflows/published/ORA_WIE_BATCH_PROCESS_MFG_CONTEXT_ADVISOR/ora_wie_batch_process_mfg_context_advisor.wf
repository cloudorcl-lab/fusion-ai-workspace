          "metadata": {
            "name": "Return Invalid Organization",
            "returnType": "object",
            "sourceCode": "const resolved = $context.$nodes.PREPARE_RESOLVED_ORG_INPUT?.$output?.result || {};\n\nconst byNameOrg = $context.$nodes.GET_MANUFACTURING_ORGANIZATION_BY_NAME?.$output?.items?.[0];\nconst byIdOrg = $context.$nodes.GET_MANUFACTURING_ORGANIZATION_BY_ID?.$output?.items?.[0];\nconst processMfgPlantsOutput = $context.$nodes.GET_PROCESS_MFG_PLANTS?.$output || {};\n\nfunction parseJsonObject(value) {\n  if (value == null) return null;\n  if (typeof value === \"object\") return value;\n  if (typeof value !== \"string\") return null;\n\n  const trimmed = value.trim();\n  if (!trimmed) return null;\n\n  try {\n    return JSON.parse(trimmed);\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction getItems(value) {\n  const parsed = parseJsonObject(value);\n  if (!parsed) return [];\n\n  if (Array.isArray(parsed.items)) return parsed.items;\n  if (Array.isArray(parsed.result?.items)) return parsed.result.items;\n  if (Array.isArray(parsed.output?.items)) return parsed.output.items;\n\n  const responseObject = parseJsonObject(parsed.output?.response);\n  if (Array.isArray(responseObject?.items)) return responseObject.items;\n\n  return [];\n}\n\nfunction getPlantParameter(row) {\n  if (Array.isArray(row?.plantParameters)) {\n    return row.plantParameters[0] || null;\n  }\n\n  if (Array.isArray(row?.plantParameters?.items)) {\n    return row.plantParameters.items[0] || null;\n  }\n\n  return null;\n}\n\nconst processMfgPlantRows = getItems(processMfgPlantsOutput);\n\nconst validProcessManufacturingOrganizations = processMfgPlantRows\n  .filter(row => getPlantParameter(row)?.EnableProcessManufacturingFlag === true)\n  .map(row => ({\n    organizationCode: row?.OrganizationCode ?? null,\n    organizationName: row?.OrganizationName ?? null\n  }))\n  .filter(row => row.organizationCode || row.organizationName);\n\nconst orgDisplay =\n  byNameOrg?.OrganizationCode ||\n  byIdOrg?.OrganizationCode ||\n  byNameOrg?.OrganizationName ||\n  byIdOrg?.OrganizationName ||\n  resolved.organizationCode ||\n  resolved.organizationId ||\n  $context.$variables.appContextOrganizationId ||\n  \"\";\n\nconst baseError = {\n  ok: false,\n  status: \"error\",\n  mode: resolved.mode || \"query\",\n  data: {\n    validProcessManufacturingOrganizations\n  }\n};\n\nif (byNameOrg || byIdOrg) {\n  return {\n    ...baseError,\n    errorCode: \"INVALID_PROCESS_MANUFACTURING_ORG\",\n    errorMessage: `The provided organization (${orgDisplay}) is not enabled for process manufacturing.`\n  };\n}\n\nreturn {\n  ...baseError,\n  errorCode: \"INVALID_ORGANIZATION\",\n  errorMessage: `The provided organization (${orgDisplay}) is invalid.`\n};"
