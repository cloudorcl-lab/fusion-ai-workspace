            "name": "Return Context JSON",
            "returnType": "object",
            "sourceCode": "const clean = (v) => {\n  if (v == null) return null;\n  const t = String(v).trim();\n  return !t || t.toLowerCase() === \"null\" ? null : t;\n};\n\nconst resolved = $context.$nodes.PREPARE_RESOLVED_ORG_INPUT?.$output?.result || {};\nconst organizationId = clean($context.$variables.organizationId);\nconst organizationCode = clean($context.$variables.organizationCode);\nconst organizationName = clean($context.$variables.organizationName);\nconst appContextOrganizationId = clean($context.$variables.appContextOrganizationId);\nconst contextOrg = organizationId || organizationCode || organizationName || appContextOrganizationId;\n\nconst ageNum = Number(resolved.age);\nconst age = Number.isFinite(ageNum) ? Math.trunc(ageNum) : 30;\nconst mode = clean(resolved.mode) || \"default\";\n\nconst appContextAgeNum = Number($context.$variables.appContextAge);\nconst appContextAge = Number.isFinite(appContextAgeNum) ? Math.trunc(appContextAgeNum) : null;\nconst effectiveContext = contextOrg ? `${contextOrg}:${age}` : null;\nconst currentAppContext = appContextOrganizationId ? `${appContextOrganizationId}:${appContextAge ?? age}` : null;\nconst outputContext = mode === \"queryOverride\" ? currentAppContext : effectiveContext;\n\nif (age <= 0) {\n  return {\n    ok: false,\n    status: \"error\",\n    mode,\n    data: null,\n    errorCode: \"INVALID_DURATION\",\n    errorMessage: \"Analysis duration must be positive integer.\"\n  };\n}\n\nreturn {\n  ok: true,\n  status: \"success\",\n  mode,\n  data: {\n    OrganizationId: organizationId,\n    OrganizationCode: organizationCode,\n    OrganizationName: organizationName,\n    Age: age,\n    Context: outputContext\n  },\n  errorCode: null,\n  errorMessage: null\n};"
