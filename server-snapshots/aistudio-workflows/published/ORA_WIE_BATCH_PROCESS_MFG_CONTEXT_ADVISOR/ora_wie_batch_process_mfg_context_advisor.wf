          "code": "SET_APP_CONTEXT_ORG_FIELDS",
          "id": "9",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Set Default Org From Profile",
            "returnType": "object",
            "sourceCode": "const profileOutput = $context.$nodes.GET_DEFAULT_MFG_PLANT_PROFILE.$output || {};\n\nconst clean = (v) => (v == null ? null : String(v).trim()) || null;\nconst pickFirstValue = (items) => {\n  if (!Array.isArray(items)) return null;\n  for (const item of items) {\n    const val = clean(item?.ProfileOptionValue ?? item?.profileOptionValue);\n    if (val) return val;\n  }\n  return null;\n};\n\nconst directItemsValue = pickFirstValue(profileOutput?.items);\nconst userLevelValue = pickFirstValue(profileOutput?.userProfileOptionValues?.items);\nconst productLevelValue = pickFirstValue(profileOutput?.productProfileOptionValues?.items);\nconst siteLevelValue = pickFirstValue(profileOutput?.siteProfileOptionValues?.items);\n\nconst defaultOrg =\n  directItemsValue || userLevelValue || productLevelValue || siteLevelValue || null;\n\nconst modeFromContext = clean($context?.$variables?.mode);\nconst finalMode =\n  modeFromContext === \"query\" || modeFromContext === \"queryOverride\"\n    ? modeFromContext\n    : \"default\";\n\nconst parsedAge = Number($context?.$variables?.age);\nconst finalAge =\n  Number.isFinite(parsedAge) && Math.trunc(parsedAge) > 0\n    ? Math.trunc(parsedAge)\n    : 30;\n\nreturn {\n  profileFound: !!defaultOrg,\n  mode: finalMode,\n  organizationId: defaultOrg,\n  organizationCode: null,\n  age: finalAge\n};"
          },
          "outcomes": {
            "success": "11"
          },
          "code": "SET_DEFAULT_ORG_FROM_PROFILE",
          "id": "10",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
