            "sourceCode": "return {\n  ok: false,\n  status: \"error\",\n  mode: \"default\",\n  data: null,\n  errorCode: \"DEFAULT_PROFILE_MISSING\",\n  errorMessage: \"Unable to resolve default manufacturing organization from profile option RCS_DEFAULT_MFG_PLANT_ORG. Provide organization explicitly.\"\n};"
          },
