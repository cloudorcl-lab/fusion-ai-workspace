                {
                  "metadata": {
                    "name": "validateProductSearchKeyWords2",
                    "returnType": "array",
                    "sourceCode": "let keywordsArray = $context.$nodes.LOOPPRODUCTS.$currentItem.HighProbableSearchKeywords;\n\n// Step 1: Normalize to array\nif (typeof keywordsArray === 'string') {\n    try {\n        keywordsArray = JSON.parse(keywordsArray);\n    } catch (e) {\n        keywordsArray = [keywordsArray];\n    }\n}\n\nif (!Array.isArray(keywordsArray)) {\n    keywordsArray = keywordsArray ? [keywordsArray] : [];\n}\n\n// Step 2: Split keywords that contain commas\nlet expandedKeywords = [];\n\nkeywordsArray.forEach(keyword => {\n    keyword = String(keyword);\n\n    if (keyword.includes(',')) {\n        // Split and push each part separately\n        keyword.split(',').forEach(part => expandedKeywords.push(part));\n    } else {\n        expandedKeywords.push(keyword);\n    }\n});\n\n// Step 3 & 4: Trim + remove short keywords\nexpandedKeywords = expandedKeywords\n    .map(k => k.trim())\n    .filter(k => k.length >= 3);\n\nreturn expandedKeywords;"
                  },
                  "outcomes": {
                    "success": "1771851917578"
                  },
                  "code": "VALIDATEPRODUCTSEARCHKEYWORDS2",
                  "id": "1768812315390",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "productSearchBoPayload2",
                    "returnType": "string",
                    "sourceCode": "let keywordsArray = $context.$nodes.LOOPPRODUCTS.VALIDATEPRODUCTSEARCHKEYWORDS2.$output.result;\nlet priceBook = $context.$variables.defaultPriceBookVarName;\n\nlet context = $context.$triggers.REST.$input.context;\nif (!context || typeof context !== \"object\") {\n  context = {};\n}\n\n// If pricebookVarName is missing or empty → set it\nif (!context.pricebookVarName || !context.pricebookVarName.toString().trim()) {\n  context.pricebookVarName = priceBook;\n}\n\n\nlet payload = {\n    \"operation\": {\n        \"method\": \"POST\",\n        \"path\": \"rest/v19/products/actions/search\"\n    },\n    \"payload\": {\n        \"criteria\": {\n            \"offset\": 0,\n            \"limit\": 500,\n            \"totalResults\": true,\n            \"keywords\" : keywordsArray\n        },\n        \"context\": context\n    }\n};\n                 \nreturn JSON.stringify(payload);"
                  },
                  "outcomes": {
                    "success": "1768812486098"
                  },
                  "code": "PRODUCTSEARCHBOPAYLOAD2",
