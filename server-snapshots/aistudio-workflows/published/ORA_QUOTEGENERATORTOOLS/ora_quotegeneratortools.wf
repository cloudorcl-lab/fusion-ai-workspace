                    "true": "add_true_1768812119265",
                    "false": "1768812315390"
                  },
                  "code": "HASRESULT",
                  "convergenceTargetId": "1768812573999",
                  "id": "1768812119265",
                  "inputs": [
                    {
                      "id": "1768812119268_1",
