        {
          "metadata": {
            "name": "setLLMOutputCode2",
            "returnType": "object",
            "sourceCode": "let loopedResult = $context.$nodes.FORLOOPSEARCHOUTPUT1.$output;\nlet products = $context.$triggers.REST.$input.callToolArgument.productSearch;\n\nlet allParts = [];\nlet hasSuccess = false;\nlet counter = 0;\n\nfor (const prd of products) {\n\n  const item = loopedResult[counter];\n  counter = counter + 1;\n\n  let obj;\n  try {\n    obj = JSON.parse(item);\n\n    if (obj.status === \"success\") hasSuccess = true;\n\n    // Merge parts if available\n    if (obj.output && Array.isArray(obj.output.products)) {\n\n      obj.output.products = obj.output.products.map(p => {\n\n        if (Array.isArray(p.topMatchesInCatalog)) {\n          p.topMatchesInCatalog = p.topMatchesInCatalog.map(match => {\n            if (match.listPrice === \"Not Defined\" || match.listPrice === \"On Demand\") {\n              match.listPrice = \"\";\n            }\n            return match;\n          });\n\n          // Sort matches inside each product by match %\n          p.topMatchesInCatalog.sort((a, b) => b.matchPercentage - a.matchPercentage);\n        }\n\n        return p;\n      });\n\n      allParts.push(...obj.output.products);\n    }\n  } catch (error) {\n    allParts.push(prd);\n    continue; // Skip this iteration if parsing fails\n  }\n}\n\nlet totalResults = allParts.length;\n\n// Product is considered matched if it has at least one catalog match\nlet matchedInCatalog = allParts.filter(p =>\n  Array.isArray(p.topMatchesInCatalog) &&\n  p.topMatchesInCatalog.length > 0 &&\n  p.topMatchesInCatalog[0].matchPercentage > 0\n).length;\n\n// Eligible if at least one match is sellable\nlet eligibleToSell = allParts.filter(p =>\n  Array.isArray(p.topMatchesInCatalog) &&\n  p.topMatchesInCatalog.some(m => m.matchPercentage > 0 && m.eligibleToSell != \"N\")\n).length;\n\nlet notFoundInCatalog = totalResults - matchedInCatalog;\n\n// Sort products by their BEST match (top of their list)\nallParts.sort((a, b) => {\n  const matchA = (a.topMatchesInCatalog && a.topMatchesInCatalog[0])\n    ? a.topMatchesInCatalog[0].matchPercentage\n    : -1;\n\n  const matchB = (b.topMatchesInCatalog && b.topMatchesInCatalog[0])\n    ? b.topMatchesInCatalog[0].matchPercentage\n    : -1;\n\n  return matchB - matchA;\n});\n\nlet finalResult = {\n  type: \"completedTask\",\n  status: hasSuccess ? \"success\" : \"failure\",\n  totalResults: totalResults,\n  notFoundInCatalog: notFoundInCatalog,\n  matchedInCatalog: matchedInCatalog,\n  eligibleToSell: eligibleToSell,\n  output: {\n    products: allParts\n  }\n};\n\nreturn finalResult;"
          },
          "outcomes": {
            "success": "1771608341018"
          },
          "code": "SETLLMOUTPUTCODE2",
