        {
          "metadata": {
            "name": "setLLMOutput",
            "returnType": "object",
            "sourceCode": "let resultArray = $context.$nodes.LOOPPRODUCTS.$output;\n\nlet inputProducts = $context.$triggers.REST.$input.callToolArgument.productSearch;\n\nconst products = [];\nlet counter = 0;\nlet hasAtLeastOneResult = false;\nfor (const inputProduct of inputProducts) {\n\n   const item = resultArray[counter];\n   counter = counter + 1;\n                  \n   if (!item) continue;\n\n   const parsed = JSON.parse(item);\n   const result = parsed?.result;\n   if (!result) {\n      continue;\n   }\n   const toolArg = inputProduct;\n   const toolRes = result.toolResponse || {};\n   const results = toolRes.result.items || [];\n\n\n   if (results.length > 0) {\n      hasAtLeastOneResult = true;\n   }\n\n   products.push({\n      productName: toolArg.productName,\n      description: toolArg.description,\n      quantity: toolArg.quantity,\n      results: results.map(r => ({\n         productIdentifier: r.productIdentifier,\n         modelPath: r.modelPath,\n         description: r.description,\n         label: r.label,\n         bomItemVariableName: r.bomItemVariableName,\n         model: r.model,\n         partNumber: r.partNumber,\n         id: r.id,\n             itemType: r.itemType,\n             inventoryOrganizationId: r.inventoryOrganizationId,\n         productType: r.productType?.displayValue, // flatten\n         listPrice: r.listPrice\n      }))\n   });\n\n}\n\nconst out = {\n   type: \"completedTask\",\n   status: hasAtLeastOneResult ? \"success\" : \"failure\",\n   output: {\n      products\n   }\n};\n\n\nreturn out;"
          },
          "outcomes": {
            "success": "1771608341027"
          },
          "code": "SETLLMOUTPUT",
          "id": "1771608341029",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
