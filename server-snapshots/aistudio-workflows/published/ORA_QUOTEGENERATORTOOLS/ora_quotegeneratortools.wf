        {
          "metadata": {
            "name": "validateInput",
            "returnType": "object",
            "sourceCode": "// Extract inputs\n\nlet match = $context.$triggers.REST.$input.callToolArgument.match;\n\nlet result = {};\n\nconst value = String(match).toUpperCase();\nlet topK = null;\n\nif (value === \"BEST\" || value === \"ALL\") {\n    match = value;\n} else {\n    const m = value.match(/^TOP(\\d+)$/);\n    if (m) {\n        topK = parseInt(m[1], 10);\n        match = \"TOPK\"; // normalized type\n    } else {\n        match = \"BEST\";\n    }\n}\nresult.match = match;\nresult.topK = topK;\n\nreturn result;"
          },
          "outcomes": {
            "success": "1768304620015"
          },
          "code": "VALIDATEINPUT",
