                {
                  "metadata": {
                    "name": "doUniqueSearch"
                  },
                  "outcomes": {
                    "true": "1768305399956",
                    "false": "add_false_1768305068755"
                  },
                  "code": "DOUNIQUESEARCH",
                  "convergenceTargetId": "1768812119265",
                  "id": "1768305068755",
                  "inputs": [
                    {
                      "id": "1768305068756_1",
                      "name": "condition",
                      "type": "string",
                      "value": "{{$context.$nodes.LOOPPRODUCTS.$currentItem.PartNumber != null || $context.$nodes.LOOPPRODUCTS.$currentItem.ModelPath != null || $context.$nodes.LOOPPRODUCTS.$currentItem.BomItemVariableName != null}}"
                    }
                  ],
                  "type": "CONDITION"
                },
                {
                  "metadata": {
                    "name": "productSearchBoPayload1",
                    "returnType": "string",
                    "sourceCode": "let partNumber = $context.$nodes.LOOPPRODUCTS.$currentItem.PartNumber;\nlet modelPath = $context.$nodes.LOOPPRODUCTS.$currentItem.ModelPath;\nlet bomItemVariableName = $context.$nodes.LOOPPRODUCTS.$currentItem.BomItemVariableName;\nlet priceBook = $context.$variables.defaultPriceBookVarName;\nlet context = $context.$triggers.REST.$input.context;\n\n\nif (!context || typeof context !== \"object\") {\n  context = {};\n}\n\n// If pricebookVarName is missing or empty → set it\nif (!context.pricebookVarName || !context.pricebookVarName.toString().trim()) {\n  context.pricebookVarName = priceBook;\n}\n\n\n// Build OR conditions dynamically\nlet orConditions = [];\n\nif (partNumber != null && partNumber !== \"\") {\n  orConditions.push({\n    \"partNumber\": { \"$eq\": partNumber }\n  });\n}\n\nif (modelPath != null && modelPath !== \"\") {\n  orConditions.push({\n    \"modelPath\": { \"$eq\": modelPath }\n  });\n}\n\nif (bomItemVariableName != null && bomItemVariableName !== \"\") {\n  orConditions.push({\n    \"bomItemVariableName\": { \"$eq\": bomItemVariableName }\n  });\n}\n\n// Build criteria\nlet criteria = {\n  totalResults: true,\n  offset: 0,\n  limit: 50\n};\n\n// Add q only if at least one condition exists\nif (orConditions.length > 0) {\n  criteria.q = JSON.stringify({\n    \"$or\": orConditions\n  });\n}\n\nlet payload = {\n  \"operation\": {\n    \"method\": \"POST\",\n    \"path\": \"rest/v19/products/actions/search\"\n  },\n  \"payload\": {\n    \"criteria\": criteria,\n    \"context\": context\n  }\n};\n\nreturn JSON.stringify(payload);"
                  },
                  "outcomes": {
                    "success": "1768305512557"
                  },
                  "code": "PRODUCTSEARCHBOPAYLOAD1",
                  "id": "1768305399956",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "businessObjectCode": "ORA_CX_CPQCOMMERC_PRODUCTSEARCHV4",
