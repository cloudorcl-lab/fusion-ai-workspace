          "code": "ISEXTRACCUSTOMERENTITY",
          "convergenceTargetId": "end",
          "id": "1767954560406",
          "inputs": [
            {
              "id": "1767954560406_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.callToolArgument.read == 'Customer'}}"
