          "id": "1774463691788",
          "inputs": [
            {
              "id": "1774463691790_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.GET_PRICE_LIST_FROM_NAME.$output.items.length == 1}}"
