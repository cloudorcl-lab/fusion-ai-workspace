        },
        {
          "metadata": {
            "name": "Show Values from previous session",
            "returnType": "object",
            "sourceCode": "const priceList = $context.$variables.userSessionObject.priceList;\nlet priceListId = 0;\nlet inventoryItemId = 0;\nif (priceList != null) {\n  priceListId = $context.$variables.userSessionObject.priceList.PriceListId;\n  if (priceList.PriceListItems?.length > 0) {\n    inventoryItemId = $context.$variables.userSessionObject.priceList.PriceListItems[0].InventoryItemId;\n  }\n}\n  \n\nconst retObj = {\n \"userMessage\": $context.$system.$inputMessage,\n \"userSessionObj\": $context.$variables.userSessionObject,\n \"priceListIdentifier\": priceListId,\n \"ItemIdentifier\": inventoryItemId\n};\nreturn retObj;"
          },
          "outcomes": {
            "success": "1779098494189"
          },
          "code": "SHOW_VALUES_FROM_PREVIOUS_SESSION",
          "id": "1772744327520",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 6901.085671581305,
            "y": 5734.1174015552615
          }
        },
        {
          "metadata": {
            "name": "Check PriceList and Item Identifier does not exist"
          },
          "outcomes": {
