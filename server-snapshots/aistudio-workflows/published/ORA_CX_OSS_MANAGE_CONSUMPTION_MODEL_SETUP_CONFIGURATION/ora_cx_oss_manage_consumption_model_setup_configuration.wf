                 \"CalculationMethodCode\": \"PRICE\",\n                  \"UsageUOMCode\": \"MNS\",\n                  \"UsageUOM\": \"MNS\",\n                  \"ChargePeriodCode\": \"0zG\",\n                  \"ChargePeriod\": \"MONTH\"\n                }\n              ]\n            }\n          ]\n        }\n      ]\n    }\n  }\n}",
