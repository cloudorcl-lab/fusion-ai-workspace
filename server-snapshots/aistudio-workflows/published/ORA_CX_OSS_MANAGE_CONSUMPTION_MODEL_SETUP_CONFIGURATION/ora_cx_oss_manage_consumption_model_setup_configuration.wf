        {
          "metadata": {
            "name": "Fix Any Lookup Code which wasnt correctly",
            "returnType": "object",
            "sourceCode": "let userSessionObject = $context.$nodes.UNDERSTAND_USER_INPUT_FOR_RATE_PLAN_AND_ITS_ENTITLEMENTS.$output;\nconst originalSessionObject = $context.$variables.userSessionObject || {};\n\nfunction hasValue( value) {\n  return !( value === null || value === undefined || value === \"\" || ( typeof value === \"string\" && value.trim() === \"\"));\n}\n\nfunction syncIdentityField( target, source, field) {\n  if( ! target || typeof target !== \"object\") {\n    return;\n  }\n  const sourceValue = source?.[ field];\n  if( hasValue(sourceValue)) {\n    target[ field] = sourceValue;\n  } else {\n    delete target[ field];\n  }\n}\n\nfunction findPricingDefChargeDefCode(chargeDefinitionCode) {\n    return pricingChargeDefinitions.find(pricingChargeDefinition => pricingChargeDefinition.PricingChargeDefinitionCode === chargeDefinitionCode) || null;\n}\n \n\nconst pricingDefsPayload = $context.$nodes.RETREIVE_REQUIRED_SETUP_DATA_BEFORE_PROCESSING.$output[0];\nconst uomsPayload = $context.$nodes.RETREIVE_REQUIRED_SETUP_DATA_BEFORE_PROCESSING.$output[1];\nconst pricingChargeDefinitions = Array.isArray( pricingDefsPayload?.items) ? pricingDefsPayload.items : Array.isArray( pricingDefsPayload) ? pricingDefsPayload : [];\nconst unitsOfMeasureList = Array.isArray( uomsPayload?.items) ? uomsPayload.items : Array.isArray( uomsPayload) ? uomsPayload : [];\nconst priceListItems = userSessionObject?.priceList?.PriceListItems || [];\nconst originalItems = originalSessionObject?.priceList?.PriceListItems || [];\nfor( let itemIndex = 0; itemIndex < priceListItems.length; itemIndex++) {\n  const item = priceListItems[ itemIndex];\n  const originalItem = originalItems[ itemIndex] || {};\n  const ratePlans = item.ratePlans || [];\n  const originalRatePlans = originalItem.ratePlans || [];\n  for( let planIndex = 0; planIndex < ratePlans.length; planIndex++) {\n    const plan = ratePlans[ planIndex];\n    const originalPlan = originalRatePlans[ planIndex] || {};\n    // RatePlanId is valid only when copied from original userSessionObject.\n    syncIdentityField( plan, originalPlan, \"RatePlanId\");\n    const ratePlanCharges = plan.ratePlanCharges || [];\n    const originalRatePlanCharges = originalPlan.ratePlanCharges || [];\n    const entitlementPlan = plan.entitlementPlan;\n    const originalEntitlementPlan = originalPlan.entitlementPlan || {};\n    syncIdentityField( entitlementPlan, originalEntitlementPlan, \"UsageEntitlementNumber\");\n    syncIdentityField( entitlementPlan, originalEntitlementPlan, \"UsageEntitlementPlanNumber\");\n    syncIdentityField( entitlementPlan, originalEntitlementPlan, \"EntitlementPlanNumber\");\n    const allowances = entitlementPlan?.allowances || [];\n    const originalAllowances = originalEntitlementPlan.allowances || [];\n    for( let allowanceIndex = 0; allowanceIndex < allowances.length; allowanceIndex++) {\n      syncIdentityField( allowances[ allowanceIndex], originalAllowances[ allowanceIndex] || {}, \"EntitlementPlanDetailNumber\");\n      const allowance = allowances[ allowanceIndex];\n      const priceChargeDef = findPricingDefChargeDefCode(allowance.ChargeDefinitionCode);\n      if( ! priceChargeDef || priceChargeDef.PriceTypeCode !== \"ONE_TIME\") {\n        allowance.AllowancePeriodicity = null;\n      } \n\n    }\n    const estimates = entitlementPlan?.estimates || [];\n    const originalEstimates = originalEntitlementPlan.estimates || [];\n    for( let estimateIndex = 0; estimateIndex < estimates.length; estimateIndex++) {\n      syncIdentityField( estimates[ estimateIndex], originalEstimates[ estimateIndex] || {}, \"EntitlementPlanEstimateNumber\");\n    }\n    const commitments = entitlementPlan?.commitments || [];\n    const originalCommitments = originalEntitlementPlan.commitments || [];\n    for( let commitmentIndex = 0; commitmentIndex < commitments.length; commitmentIndex++) {\n      syncIdentityField( commitments[ commitmentIndex], originalCommitments[ commitmentIndex] || {}, \"EntitlementPlanCommitmentNumber\");\n    }\n    const volumePricingRules = entitlementPlan?.volumePricingRules || [];\n    const originalVolumePricingRules = originalEntitlementPlan.volumePricingRules || [];\n    for( let ruleIndex = 0; ruleIndex < volumePricingRules.length; ruleIndex++) {\n      syncIdentityField( volumePricingRules[ ruleIndex], originalVolumePricingRules[ ruleIndex] || {}, \"EntitlementPlanChargeRuleNumber\");\n    }\n    const volumePricing = entitlementPlan?.volumePricing || [];\n    const originalVolumePricing = originalEntitlementPlan.volumePricing || [];\n    for( let ruleIndex = 0; ruleIndex < volumePricing.length; ruleIndex++) {\n      syncIdentityField( volumePricing[ ruleIndex], originalVolumePricing[ ruleIndex] || {}, \"EntitlementPlanChargeRuleNumber\");\n    }\n    const conversions = entitlementPlan?.unitOfMeasureConversions || [];\n    const originalConversions = originalEntitlementPlan.unitOfMeasureConversions || [];\n    for( let conversionIndex = 0; conversionIndex < conversions.length; conversionIndex++) {\n      syncIdentityField( conversions[ conversionIndex], originalConversions[ conversionIndex] || {}, \"EntitlementPlanUOMConversionNumber\");\n    }\n    for( let chargeIndex = 0; chargeIndex < ratePlanCharges.length; chargeIndex++) {\n      const charge = ratePlanCharges[ chargeIndex];\n      const originalCharge = originalRatePlanCharges[ chargeIndex] || {};\n      syncIdentityField( charge, originalCharge, \"RatePlanChargeId\");\n      if( ! charge.PricingChargeDefinitionCode) {\n        continue;\n      }\n      const matchedPricingChargeDef = pricingChargeDefinitions.find( d => d.PricingChargeDefinitionCode === charge.PricingChargeDefinitionCode);\n      if( ! matchedPricingChargeDef || ! matchedPricingChargeDef.UsageUOMClass) {\n        continue;\n      }\n      const filteredUoms = unitsOfMeasureList.filter( u => u.UOMClass === matchedPricingChargeDef.UsageUOMClass);\n      if( ! filteredUoms.length) {\n        continue;\n      }\n      if( charge.UsageUOMCode) {\n        const validCodeMatch = filteredUoms.find( u => u.UOMCode === charge.UsageUOMCode);\n        if( validCodeMatch) {\n          charge.UsageUOM = validCodeMatch.UOM;\n          charge.UsageUOMCode = validCodeMatch.UOMCode;\n          continue;\n        }\n      }\n      if( charge.UsageUOM) {\n        const uomMatch = filteredUoms.find( u => u.UOM === charge.UsageUOM);\n        if( uomMatch) {\n          charge.UsageUOMCode = uomMatch.UOMCode;\n          charge.UsageUOM = uomMatch.UOM;\n        }\n      }\n    }\n  }\n}\nreturn userSessionObject;"
          },
          "outcomes": {
            "success": "1772793479984"
          },
