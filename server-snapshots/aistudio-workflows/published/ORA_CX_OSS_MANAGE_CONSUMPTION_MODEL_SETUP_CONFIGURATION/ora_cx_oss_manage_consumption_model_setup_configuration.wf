        {
          "metadata": {
            "name": "Parse Input Context and set Defaults",
            "returnType": "object",
            "sourceCode": "let sessionObject;\nif ($context.$variables.userSessionObject  === undefined || $context.$variables.userSessionObject  === null || $context.$variables.userSessionObject === \"\") {\n  if ($context.$triggers.REST.$input.priceListObject === null || $context.$triggers.REST.$input.priceListObject === undefined || $context.$triggers.REST.$input.priceListObject === \"\") {\n    sessionObject = {firstTimeModelGenerated: true};\n  } else {\n    sessionObject = $context.$triggers.REST.$input.priceListObject;\n    sessionObject.firstTimeModelGenerated = false;\n  }\n} else {\n  sessionObject = $context.$variables.userSessionObject;\n  sessionObject.firstTimeModelGenerated = false;\n} \nsessionObject.retreiveDataCollection = [{\"name\" : \"Get Data\"}];\nsessionObject.errorMessage = null;\nreturn sessionObject;"
          },
          "outcomes": {
            "success": "1773158987844"
          },
          "code": "PARSE_INPUT_CONTEXT_AND_SET_DEFAULTS",
          "id": "1773158733961",
