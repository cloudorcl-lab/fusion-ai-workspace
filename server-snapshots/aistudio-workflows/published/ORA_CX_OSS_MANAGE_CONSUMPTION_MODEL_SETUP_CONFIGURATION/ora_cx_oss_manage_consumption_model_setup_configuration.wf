        {
          "metadata": {
            "name": "Save Balance Profile data into Session Object",
            "returnType": "object",
            "sourceCode": "let userSessionObject =  $context.$variables.userSessionObject;\nlet balanceProfileNumber = $context.$nodes.GET_BALANCE_PROFILE_TO_CHECK_IF_IT_EXISTS.$output.items[0].BalanceProfileNumber;\nlet balanceProfileName = $context.$nodes.GET_BALANCE_PROFILE_TO_CHECK_IF_IT_EXISTS.$output.items[0].BalanceProfileName;\n\nconst priceListItems = userSessionObject?.priceList?.PriceListItems || [];\n\nfor (const item of priceListItems) {\n  const ratePlans = item.ratePlans || [];\n\n  for (const plan of ratePlans) {\n    let entitlementPlan = plan.entitlementPlan;\n    entitlementPlan.BalanceProfileNumber = balanceProfileNumber;\n    entitlementPlan.BalanceProfileName = balanceProfileName;\n  }\n}\n\nreturn $context.$variables.userSessionObject;"
          },
          "outcomes": {
            "success": "1777374174156"
          },
          "code": "SAVE_BALANCE_PROFILE_DATA_INTO_SESSION_OBJECT",
