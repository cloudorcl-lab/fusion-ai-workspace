            "name": "Retreive setup data",
            "returnType": "object",
            "sourceCode": "const rawOutputs = $context.$nodes.RETREIVE_REQUIRED_SETUP_DATA_BEFORE_PROCESSING.$output || [];\n\nconst result = {\n  pricingChargeDefinitions: null,\n  unitsOfMeasureList: null,\n  balanceCodes: null,\n  balanceProfiles: null,\n  pricingPeriodicUnitsOfMeasureList: null,\n  timeUnitsOfMeasureList: null,\n  balanceCategories: null\n};\n\nconst keyMap = {\n  GET_EXISTING_PRICING_CHARGE_DEFINITIONS: \"pricingChargeDefinitions\",\n  GET_ALL_PRICING_UNITS_OF_MEASURE: \"unitsOfMeasureList\",\n  GET_ALL_ACTIVE_BALANCE_CODES: \"balanceCodes\",\n  GET_ALL_ACTIVE_BALANCE_PROFILES: \"balanceProfiles\",\n  GET_PRICING_PERIODIC_UNITS_OF_MEASURE: \"pricingPeriodicUnitsOfMeasureList\",\n  GET_TIME_UNIT_OF_MEASURES: \"timeUnitsOfMeasureList\",\n  GET_ALL_BALANCE_CATEGORIES: \"balanceCategories\"\n};\n\nconst collection = $context.$nodes.GENERATE_COLLECTION_TO_RETREIVE_SETUP_DATA.$output.result || [];\n\nfor (let i = 0; i < collection.length; i++) {\n  const key = keyMap[collection[i]];\n  if (key) {\n    result[key] = rawOutputs[i];\n  }\n}\n\nreturn result;"
          },
