{
  "workflowId": "300000331068168",
  "workflowCode": "ORA_TRANSACTION_CONFLICT_DETECTOR_WORKFLOW",
  "name": "Transaction Conflict Detector Workflow",
  "description": "This agent checks if there are any conflict transactions or pending transactions for the given object and objectId.If there are any pending transactions, then it returns transactionId and number of pending transactions.",
  "specification": {
