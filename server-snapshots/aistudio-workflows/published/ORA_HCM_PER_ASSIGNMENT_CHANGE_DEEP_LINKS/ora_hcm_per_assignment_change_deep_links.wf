        {
          "metadata": {
            "name": "fetchAssignmentDetails",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  const employmentSession = $context.$variables?.employmentDetails || {};\n\n  // Helper function to URL encode and replace spaces with %20\n  function encodeValue(value) {\n    if (typeof value !== 'string') return '';\n    // encodeURIComponent encodes spaces as %20 already\n    return encodeURIComponent(value);\n  }\n\n  result.EmploymentProcess = employmentSession.SelectedEmploymentProcess || null;\n  result.EffectiveDate = employmentSession.EffectiveDate || null;\n\n  // Access nested properties safely with optional chaining\n  const assignmentMap = employmentSession.InitialAssignmentRecord?.AssignmentMap || {};\n\n  // AssignmentId and PersonId wrapped in quotes as in original code\n  result.AssignmentId = assignmentMap.AssignmentId ? encodeValue(assignmentMap.AssignmentId) : null;\n  result.PersonId = assignmentMap.PersonId ? encodeValue(assignmentMap.PersonId) : null;\n result.PersonNumber = assignmentMap.PersonNumber?encodeValue(assignmentMap.PersonNumber):null;\n\n  // TODO: Inferred 'BusinessTitle' from user text 'BusinessTitle'\n  result.BusinessTitle = encodeValue(assignmentMap.BusinessTitle);\n\n  result.AssignmentNumber = encodeValue(assignmentMap.AssignmentNumber) || null;\n\n  // TODO: Inferred 'DisplayName' from user text 'DisplayName'\n  result.DisplayName = encodeValue(employmentSession.DisplayName);\n\n} catch (error) {\n  // Return safe fallback object with nulls\n  result = {\n    EmploymentProcess: null,\n    EffectiveDate: null,\n    AssignmentId: null,\n    PersonId: null,\n    BusinessTitle: '',\n    AssignmentNumber: null,\n    DisplayName: '',\n    PersonNumber:null\n  };\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1772530071758"
          },
          "code": "FETCH_ASSIGNMENT_DETAILS",
          "convergenceTargetId": "1772521416514",
          "id": "1773077504371",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
