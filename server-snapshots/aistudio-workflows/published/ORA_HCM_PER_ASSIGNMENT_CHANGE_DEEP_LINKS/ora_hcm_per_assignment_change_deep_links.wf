            "name": "ChangeWorkingHoursDeepLink",
            "returnType": "string",
            "sourceCode": "var employmentProcess = $context.$nodes.FETCH_ASSIGNMENT_DETAILS.$output.result.EmploymentProcess;\nvar deepLink = $context.$variables.DeepLink;\nvar effectiveDate = $context.$nodes.FETCH_ASSIGNMENT_DETAILS.$output.result.EffectiveDate;\nvar employeeName = $context.$nodes.FETCH_ASSIGNMENT_DETAILS.$output.result.DisplayName;\nvar action = \"Change Working hours\";\n\nreturn `This request must be completed in the Change Working hours flow for ${employeeName} on ${effectiveDate}, ${deepLink}`;"
          },
          "outcomes": {
            "success": "1773136927418"
          },
