          "inputs": [
            {
              "id": "1770091705309_1",
              "name": "batchPayload",
              "type": "string",
              "value": "{{$context.$nodes.INSERT_SERIAL_IN_MERGE_PAYLOAD.$output.result}}"
            }
          ],
          "outputSpecification": "{}",
