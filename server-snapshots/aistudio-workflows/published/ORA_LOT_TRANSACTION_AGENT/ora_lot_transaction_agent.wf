          },
          "outcomes": {
            "success": "1770897461673"
          },
          "code": "INVENTORY_ITEM_SERIAL_NUMBERS_SPLIT",
          "id": "1770828471623",
          "inputs": [
            {
              "id": "1770828497489_1",
              "name": "queryParam",
              "type": "string",
              "value": "{{$context.$nodes.SERIAL_NUMBER_QUERY_CREATOR_SPLIT.$output.query}}"
