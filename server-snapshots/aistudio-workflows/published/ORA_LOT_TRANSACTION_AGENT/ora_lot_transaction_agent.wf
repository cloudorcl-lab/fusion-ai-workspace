              "id": "1770820679876_1",
              "name": "queryParam",
              "type": "string",
              "value": "{{$context.$nodes.SERIAL_NUMBER_QUERY_CREATOR.$output.query}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
