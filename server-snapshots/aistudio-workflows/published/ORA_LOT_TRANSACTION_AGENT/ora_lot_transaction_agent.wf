{
  "workflowId": "300000327004236",
  "workflowCode": "ORA_LOT_TRANSACTION_AGENT",
  "name": "Lot Transaction Agent",
  "description": "Lot management agent that handles all lot related transactions like lot split, lot merge and lot translate.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
