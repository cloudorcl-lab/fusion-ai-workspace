        {
          "metadata": {
            "name": "Build Best Fit Person Search Payload",
            "returnType": "array",
            "sourceCode": "const shiftObj = $context.$nodes.GET_SHIFT_DETAILS.$output;\nconst schedule = $context.$nodes.GET_SCHEDULE_DETAILS.$output.result.items[0];\n\nlet filters = [];\n\nif (schedule) {\n//Add ScheduleUnits filter\n    if (schedule.DepartmentId) {\n        let filter = {};\n        let keyValuePairs = [];\n        filter = {\n            \"name\": \"ScheduleUnits\"\n        };\n        let schUnit = {};\n        schUnit.departmentId = schedule.DepartmentId;\n        schUnit.locationId = schedule.LocationId;\n\n        keyValuePairs.push(schUnit);\n        filter.keyValuePairs = keyValuePairs;\n\n        filters.push(filter);\n\n    }\n}\n\nif (shiftObj) {\n    const jobProfileType = schedule.JobProfileTypeCode;\n    const contentTypeName = shiftObj.ContentTypeName; \n    //Add RefDate filter\n    if (shiftObj.RefDate) {\n        let refDateFilter = {};\n        let refDateTerms = [];\n        refDateFilter = {\n            \"name\": \"EffectiveAsOf\"\n        };\n        refDateTerms.push(shiftObj.RefDate);\n        refDateFilter.terms = refDateTerms;\n\n        filters.push(refDateFilter);\n\n    }\n    //Add ShiftTimeRange filter\n    if (shiftObj.ShiftStartDateTime) {\n        let shiftRangeFilter = {};\n        let shiftRangeTerms = [];\n        shiftRangeFilter = {\n            \"name\": \"ShiftTimeRange\"\n        };\n        shiftRangeTerms.push(shiftObj.ShiftStartDateTime);\n        shiftRangeTerms.push(shiftObj.ShiftEndDateTime);\n        shiftRangeFilter.values = shiftRangeTerms;\n\n        filters.push(shiftRangeFilter);\n\n    }\n    //Add Shift Type filters\n    if (shiftObj.ShiftTypeLookupCode) {\n        let shiftTypeFilter = {};\n        let shiftTypeTerms = [];\n        shiftTypeFilter = {\n            \"name\": \"ShiftTypeCode\"\n        };\n        shiftTypeTerms.push(shiftObj.ShiftTypeLookupCode ? shiftObj.ShiftTypeLookupCode : 'ORA_HTS_WORK');\n        shiftTypeFilter.terms = shiftTypeTerms;\n\n        filters.push(shiftTypeFilter);\n\n    }\n    //add Job Profile Type filter by checking JPT from shiftObj\n    if (jobProfileType) {\n        let jptFilter = {};\n        let jptTerms = [];\n        if (\"ORA_JOB\" == jobProfileType) {\n            jptFilter = {\n                \"name\":\n                    \"JobId\"\n\n            };\n        } else if (\"ORA_POSITION\" == jobProfileType) {\n            jptFilter = {\n                \"name\":\n                    \"PositionId\"\n\n            };\n        } else if (\"ORA_JOB_FAMILY\" == jobProfileType) {\n            jptFilter = {\n                \"name\":\n                    \"JobFamilyId\"\n\n            };\n        } else {\n            jptFilter = {\n                \"name\":\n                    \"SchedulingGroup\"\n\n            };\n        }\n        jptTerms.push(\"ORA_PER_SCH_GROUP\" == jobProfileType ? shiftObj.JobProfileCode : shiftObj.JobProfileId);\n        jptFilter.terms = jptTerms;\n\n        filters.push(jptFilter);\n    }\n\n    //add Content Item filter by checking ContentTypeId from shiftObj\n    if (shiftObj.CompetencyId) {\n        let contentItemFilter = {};\n        let contentItemTerms = [];\n        if (\"Languages\" == contentTypeName) {\n            contentItemFilter = {\n                \"name\":\n                    \"LanguageId\"\n\n            };\n        } else if (\"Competencies\" == contentTypeName) {\n            contentItemFilter = {\n                \"name\":\n                    \"CompetencyId\"\n\n            };\n        } else if (\"Licenses and Certifications\" == contentTypeName) {\n            contentItemFilter = {\n                \"name\":\n                    \"CertificationId\"\n\n            };\n        }\n        contentItemTerms.push(shiftObj.CompetencyId);\n        contentItemFilter.terms = contentItemTerms;\n\n        filters.push(contentItemFilter);\n    }\n\n\n}\n\nreturn filters;"
          },
          "outcomes": {
            "success": "1767639509092"
          },
          "code": "BUILD_BEST_FIT_PERSON_SEARCH_PAYLOAD",
          "id": "1771020379429",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
