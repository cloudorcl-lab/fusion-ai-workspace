          },
          "code": "LLM_ANALYZE_WORKER_DATA_FOR_REASSIGNMENT",
          "convergenceTargetId": "1771019369118",
          "id": "1769144129135",
          "inputs": [
            {
              "id": "1769144129136_1",
              "name": "prompt",
              "type": "string",
              "value": "Data:\n\nWorkerList: {{$context.$nodes.FETCH_WORKER_FOR_SHIFT_REASSIGNMENT.$output.items}}\n\nWorkerData: Combination of {{$context.$nodes.GET_WORKERS_DATA_WITH_SHIFTS.$output}}  and  {{$context.$nodes.GET_WORKERS_DATA_WITHOUT_SHIFTS.$output}}\n\nTask: You are an accurate data processing agent. Your task is to analyze above input data and populate parameters into the WorkerList.\n\nFor each record in the WorkerList, fetch the personId and fetch worker data from WorkerData. Add attributes WorkDuration, FTEDuration attributes from WorkerData into WorkerList.\n\nupdate the {{$context.$nodes.FETCH_WORKER_FOR_SHIFT_REASSIGNMENT.$output.items}} with new attributes."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Build Worker List for Reassignment",
            "returnType": "array",
            "sourceCode": "const workersList = $context.$nodes.LLM_ANALYZE_WORKER_DATA_FOR_REASSIGNMENT.$output;\nreturn workersList;"
          },
          "outcomes": {
            "success": "1767426574889"
          },
          "code": "BUILD_WORKER_LIST_FOR_REASSIGNMENT",
          "convergenceTargetId": "1771019369118",
          "id": "1767643493272",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
