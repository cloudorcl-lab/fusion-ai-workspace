            {
              "id": "1761801314682_1",
              "name": "prompt",
              "type": "string",
              "value": "Give message in following format:\n\nLine-1: \"I'm sorry, but I cannot provide information on the requested query, as it is either too sensitive or outside my scope. My expertise is limited to supporting the team coaching on team goals, check-ins, feedbacks, celebration and performance evaluation data.\"\nLine-2: <line-break>\nLine-2: \"Error Message: \" \nLine-3: {{$context.$nodes.USER_INPUT_VALIDITY_CHECK.$output.UserRequestPolicyErrorMessage}}"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Use Existing Manage Edge Agent"
          },
          "outcomes": {
