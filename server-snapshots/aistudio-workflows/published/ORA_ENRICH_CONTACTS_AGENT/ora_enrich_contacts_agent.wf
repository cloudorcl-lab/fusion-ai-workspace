{
  "workflowId": "100002355226938",
  "workflowCode": "ORA_ENRICH_CONTACTS_AGENT",
  "name": "Enrich Contacts Agent",
  "description": "Identifies contact information from email signatures in a given email conversation for specified email addresses. Automates the creation of new contacts not yet in Sales and the updating of existing Sales contacts with fields like first name, last name, account, job title, and phone numbers.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1765860334644"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "description": "End of data pipeline",
            "name": "End"
          },
          "outcomes": {},
          "code": "END",
