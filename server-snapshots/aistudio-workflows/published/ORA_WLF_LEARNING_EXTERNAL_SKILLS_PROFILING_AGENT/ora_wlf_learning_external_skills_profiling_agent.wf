type\": \"integer\" },\n                        \"hasMore\": { \"type\": \"boolean\" },\n                        \"limit\": { \"type\": \"integer\" },\n                        \"offset\": { \"type\": \"integer\" }\n                      },\n                      \"required\": [\"items\", \"count\", \"hasMore\", \"limit\", \"offset\"]\n                    }\n                  },\n                  \"required\": [\"properties\"]\n                }\n              },\n              \"count\": { \"type\": \"integer\" },\n              \"hasMore\": { \"type\": \"boolean\" },\n              \"limit\": { \"type\": \"integer\" },\n              \"offset\": { \"type\": \"integer\" }\n            },\n            \"required\": [\"items\", \"count\", \"hasMore\", \"limit\", \"offset\"]\n          }\n        },\n        \"required\": [\"contentSections\"]\n      }\n    },\n    \"count\": { \"type\": \"integer\" },\n    \"hasMore\": { \"type\": \"boolean\" },\n    \"limit\": { \"type\": \"integer\" },\n    \"offset\": { \"type\": \"integer\" }\n  },\n  \"required\": [\"items\", \"count\", \"hasMore\", \"limit\", \"offset\"]\n}",
