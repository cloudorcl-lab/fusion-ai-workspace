                        {
                          "metadata": {
                            "name": "Prepare skill association result",
                            "returnType": "object",
                            "sourceCode": "let inputSkill = $context.$nodes.FOR_EACH_LEARNING_ITEM.FOR_EACH_RAW_SKILL.$currentItem;\nlet associatedCount = $context.$nodes.FOR_EACH_LEARNING_ITEM.FOR_EACH_RAW_SKILL.FETCH_ASSOCIATED_SKILL_ENTRY.$output.count;\nlet action = associatedCount > 0 ? \"ALREADY_ASSOCIATED\" : \"ASSOCIATED\";\nlet matchType = $context.$nodes.FOR_EACH_LEARNING_ITEM.FOR_EACH_RAW_SKILL.FETCH_SKILL_MAPPING_ENTRY.$output.items[0].dispositionMethod;\nlet skillId = $context.$variables.skillCatalogItemId;\nlet skillResult = {\n  inputSkill: inputSkill,\n  action: action,\n  matchType: matchType,\n  skillId: skillId,\n  skillName: \"\",\n  skillSource: \"CATALOG\",\n  reason: \"\"\n};\nskillResult;"
                          },
                          "outcomes": {
                            "success": "end_1765281844690"
                          },
                          "code": "PREPARE_SKILL_ASSOCIATION_RESULT",
                          "id": "1769676912353",
                          "inputs": [],
                          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                          "type": "CODE"
                        },
                        {
                          "metadata": {
                            "name": "Prepare new catalog skill association result ",
                            "returnType": "object",
                            "sourceCode": "let inputSkill = $context.$nodes.FOR_EACH_LEARNING_ITEM.FOR_EACH_RAW_SKILL.$currentItem;\nlet matchType = $context.$nodes.FOR_EACH_LEARNING_ITEM.FOR_EACH_RAW_SKILL.FETCH_SKILL_MAPPING_ENTRY.$output.items[0].dispositionMethod;\nlet skillId = $context.$nodes.FOR_EACH_LEARNING_ITEM.FOR_EACH_RAW_SKILL.CREATE_CATALOG_SKILL.$output.ContentItemId ;\nlet matchingSkill = $context.$nodes.FOR_EACH_LEARNING_ITEM.FOR_EACH_RAW_SKILL.FETCH_SKILL_MAPPING_ENTRY.$output.items[0].matchingSkill;\nlet skillResult = {\n  inputSkill: inputSkill,\n  action: \"CREATED_ASSOCIATED\",\n  matchType: matchType,\n  skillId: skillId,\n  skillName: matchingSkill,\n  skillSource: \"CATALOG\",\n  reason: \"\"\n};\nskillResult;"
                          },
                          "outcomes": {
                            "success": "end_1765281844690"
                          },
                          "code": "PREPARE_NEW_CATALOG_SKILL_ASSOCIATION_RESULT_",
                          "id": "1769677190799",
                          "inputs": [],
                          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                          "type": "CODE"
                        },
                        {
                          "metadata": {
                            "name": "Prepare new non catalog skill association result",
                            "returnType": "object",
                            "sourceCode": "let inputSkill = $context.$nodes.FOR_EACH_LEARNING_ITEM.FOR_EACH_RAW_SKILL.$currentItem;\nlet action = \"CREATED_ASSOCIATED\";\nlet matchType = $context.$nodes.FOR_EACH_LEARNING_ITEM.FOR_EACH_RAW_SKILL.FETCH_SKILL_MAPPING_ENTRY.$output.items[0].dispositionMethod;\nlet skillId = $context.$nodes.FOR_EACH_LEARNING_ITEM.FOR_EACH_RAW_SKILL.ASSOCIATE_NOT_CATALOG_SKILL_WITH_LEARNING_ITEM.$output.ContentItemId;\nlet matchingSkill = $context.$nodes.FOR_EACH_LEARNING_ITEM.FOR_EACH_RAW_SKILL.FETCH_SKILL_MAPPING_ENTRY.$output.items[0].matchingSkill;\nlet skillResult = {\n  inputSkill: inputSkill,\n  action: \"CREATED_ASSOCIATED\",\n  matchType: matchType,\n  skillId: skillId,\n  skillName: \"\",\n  skillSource: \"NON-CATALOG\",\n  reason: \"\"\n};\nskillResult;"
