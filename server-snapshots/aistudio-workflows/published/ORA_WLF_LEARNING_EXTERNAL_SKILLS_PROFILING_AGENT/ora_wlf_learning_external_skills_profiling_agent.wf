                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "Compute Leanring Item Status",
                    "returnType": "string",
                    "sourceCode": "let item = $context.$nodes.FOR_EACH_LEARNING_ITEM.$currentItem;\nlet expectedCount = item.skills.length;\nlet raw = $context.$nodes.FOR_EACH_LEARNING_ITEM.FOR_EACH_RAW_SKILL.$output;\nlet rawArr = [];\nif (Array.isArray(raw)) {\n  rawArr = raw;\n} else if (raw && raw.result) {\n  rawArr = raw.result;\n} else if (typeof raw === \"string\") {\n  try {\n    let parsed = JSON.parse(raw);\n    rawArr = parsed.result || [];\n  } catch (e) {\n    rawArr = [];\n  }\n}\nlet normalizedSkillResults = [];\nfor (let sr of rawArr) {\n  let parsed = sr;\n  while (typeof parsed === \"string\") {\n    try {\n      parsed = JSON.parse(parsed);\n    } catch (e) {\n      parsed = null;\n      break;\n    }\n  }\n  parsed = parsed && parsed.result ? parsed.result : parsed;\n  normalizedSkillResults.push({\n    inputSkill: parsed && parsed.inputSkill || \"\",\n    action: parsed && parsed.action || \"FAILED\",\n    matchType: parsed && parsed.matchType || \"\",\n    skillId: parsed && parsed.skillId != null ? parsed.skillId : -1,\n    skillName: parsed && parsed.skillName || \"\",\n    skillSource: parsed && parsed.skillSource || \"NONE\",\n    reason: parsed && parsed.reason || \"\"\n  });\n}\nlet profileStatus = \"P\";\nif (\n  expectedCount > 0 &&\n  normalizedSkillResults.length === expectedCount\n) {\n  profileStatus = \"Y\";\n  for (let sr of normalizedSkillResults) {\n    if (\n      sr.action !== \"ASSOCIATED\" &&\n      sr.action !== \"ALREADY_ASSOCIATED\" &&\n      sr.action !== \"CREATED_ASSOCIATED\"\n    ) {\n      profileStatus = \"P\";\n      break;\n    }\n  }\n}\nitem.profileStatus = profileStatus;\nprofileStatus;"
                  },
                  "outcomes": {
                    "success": "1768556468071"
                  },
                  "code": "COMPUTE_LEANRING_ITEM_STATUS",
                  "id": "1770283387852",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                }
              ],
              "rootNode": "start_1765278631476"
            },
            "loopType": "PARALLEL",
            "name": "For Each learning item"
          },
          "outcomes": {
            "success": "1765532384596"
          },
          "code": "FOR_EACH_LEARNING_ITEM",
          "id": "1765278631476",
          "inputs": [
            {
              "id": "1765278631478_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$variables.SkillsAssociationInput.learningItems}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "Output association results JSON",
            "returnType": "object",
            "sourceCode": "let raw = $context.$nodes.FOR_EACH_LEARNING_ITEM.$output;\n\nlet finalOutput = raw.map(itemStr => {\n  let item = typeof itemStr === \"string\" ? JSON.parse(itemStr) : itemStr;\n  item = item.result || item;\n  let normalizedSkillResults = [];\n  for (let sr of item.skillResults) {\n    if (typeof sr === \"string\" && !sr.trim().startsWith(\"{\")) {\n      normalizedSkillResults.push({\n        inputSkill: \"\",\n        action: \"FAILED\",\n        matchType: \"\",\n        skillId: -1,\n        skillName: \"\",\n        skillSource: \"NONE\",\n        reason: sr\n      });\n      continue;\n    }\n    let parsed = typeof sr === \"string\" ? JSON.parse(sr) : sr;\n    parsed = parsed.result || parsed;\n    normalizedSkillResults.push({\n      inputSkill: parsed.inputSkill || \"\",\n      action: parsed.action || \"FAILED\",\n      matchType: parsed.matchType || \"\",\n      skillId: parsed.skillId != null ? parsed.skillId : -1,\n      skillName: parsed.skillName || \"\",\n      skillSource: parsed.skillSource || \"NONE\",\n      reason: parsed.reason || \"\"\n    });\n  }\n  return {\n    learningItemId: item.learningItemId,\n    skillResults: normalizedSkillResults,\n    profileStatus: item.profileStatus\n  };\n});\nfinalOutput;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "CONVERT_TO_JSON_OBJECT",
          "id": "1765532384596",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
