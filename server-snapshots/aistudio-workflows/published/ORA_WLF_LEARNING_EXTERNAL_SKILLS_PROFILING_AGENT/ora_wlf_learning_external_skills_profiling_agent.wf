            "returnType": "object",
            "sourceCode": "let contentSectionProperties = $context.$nodes.FETCH_RATING_MODEL_ID.$output.items[0].contentSections.items[0].properties.items;\nconst skillLevelObj = contentSectionProperties.find(item => item.FieldName === \"SKILL_LEVEL_ID\");\nconst skillRaringModelId = skillLevelObj ? skillLevelObj.ValueSetName : null;\nconst skillDisplayModelCode = skillLevelObj ? skillLevelObj.DisplayModeCode : null;\nreturn {\"skillRaringModelId\":skillRaringModelId,\"skillDisplayModelCode\":skillDisplayModelCode};"
