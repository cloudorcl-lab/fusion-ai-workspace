                        {
                          "metadata": {
                            "name": "Find Rating Level and Target outcome`",
                            "returnType": "object",
                            "sourceCode": "let updatePersonProfile = $context.$variables.SkillsAssociationInput.updatePersonProfile;\nlet useAISkillLevel = $context.$variables.SkillsAssociationInput.useAISkillLevel;\nlet skillDisplayModelCode = $context.$variables.skillLevelDisplayModeCode;\nlet providerSkill = $context.$nodes.FOR_EACH_LEARNING_ITEM.FOR_EACH_RAW_SKILL.$currentItem;\nlet relatedItemFlag = \"Y\";\nlet llmResultsForLevel = $context.$nodes.FOR_EACH_LEARNING_ITEM.PROMPT_TO_GET_PROFICOENCY_LEVELS_AND_TARGET_OUTCOME.$output;\nlet skillLevel = null;\n\nif (useAISkillLevel === 'true' || updatePersonProfile === 'true') {\n     const foundItem = llmResultsForLevel.find(item => item.skill === providerSkill); \n     if (foundItem != null) {\n     if (useAISkillLevel === 'true' && skillDisplayModelCode !== 'N') {\n      skillLevel = foundItem.proficiency_rating;\n    }\n         relatedItemFlag = (foundItem.outcome_validation === true && updatePersonProfile === 'true') ? \"N\" : \"Y\";\n     }\n}\nreturn {\"proficiencyLevelId\":skillLevel,\"relatedItemFlag\":relatedItemFlag};"
                          },
                          "outcomes": {
                            "success": "1765535907980"
                          },
                          "code": "FIND_RATING_LEVEL_AND_TARGET_OUTCOME",
                          "id": "1768111898276",
                          "inputs": [],
                          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                          "type": "CODE"
                        },
