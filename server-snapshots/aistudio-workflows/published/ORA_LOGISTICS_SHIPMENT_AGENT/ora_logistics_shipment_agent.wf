        {
          "metadata": {
            "name": "extractDockFromForm",
            "returnType": "object",
            "sourceCode": "let dock_shipment_obj;\nlet dock;\nlet estimatedUnits;\nconst oraAction = $context.$app.$OraAction;\nconst match = oraAction.match(/<oraFormSubmit\\s+id=[\"']([^\"']*)[\"'][^>]*>(.*?)<\\/oraFormSubmit>/s);\nif(match){\nconst id = match[1]; // The ID value\ndock_shipment_obj = JSON.parse(match[2]); // The JSON content\n}\nlet startTime;\ndock = dock_shipment_obj[0].value;\nconst shipmentXid = dock_shipment_obj[1].value;\nconst shipData = $context.$variables.shipmentData ?? {};\nfor (let j = 0; j < shipData.items.length; j++) \n{\n    const item = shipData.items[j];\n    if((item.shipmentXid ?? item[\"shipmentXid\"]) == shipmentXid)\n    {\n        startTime = (item.startTime.value ?? item[\"startTime\"].value);\n        estimatedUnits = item.totalItemPackageCount;\n        break;\n    }\n}\n\nconst dateObj = new Date(startTime);\nconst now = new Date();\nconst diffInMinutes = Math.round((dateObj - now) / (1000 * 60));\nreturn { shipmentXid, dock_number: dock, startTime: startTime.slice(0,19), estimatedUnits: estimatedUnits, diffInMinutes:diffInMinutes};"
          },
          "outcomes": {
            "success": "1772097930604"
          },
