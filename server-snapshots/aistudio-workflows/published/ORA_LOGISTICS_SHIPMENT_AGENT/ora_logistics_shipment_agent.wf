          "id": "1768359918652",
          "inputs": [],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Map Appointment Time with Shipment",
            "returnType": "array",
            "sourceCode": "const shipData = $context.$variables.shipmentData ?? {};\nconst apData = $context?.$nodes?.GET_APPOINTMENTS?.$output?.results ?? [];\nconst resultPair = $context?.$nodes?.EXTRACTWMSLOADANDEXTERNALLYPLANNEDLOADNBR?.$output?.result ?? [];\nconst extPlannedLoadNbrWMSLoadMap = resultPair[0] || {}; // map: key -> { loadNbr, loadStatus }\nconst percentageDict = resultPair[1] || {}; // map: key -> [pctLoaded, pctPacked]\nconst now = new Date();\nconst THIRTY_MIN = 30 * 60 * 1000;\nconst results = [];\n\nconst toMinutesFromMs = (ms) => Math.floor(ms / 60000);\nconst toMinutes = (d) => Math.floor(d.getTime() / 60000);\n\n// Normalize any timestamp to UTC ms; returns null if invalid\nconst parseToUtcMs = (ts) => {\n  if (!ts) return null;\n  const d = new Date(ts);\n  const ms = d.getTime();\n  return isNaN(ms) ? null : ms;\n};\n\n// Helper to keep only desired location fields\nconst pickLoc = (loc) => {\n  if (!loc || typeof loc !== \"object\") return null;\n  return {\n    locationName: loc.locationName ?? null,\n    city: loc.city ?? null,\n    country: loc.countryCode3Gid ?? null,\n    timeZoneGid: loc.timeZoneGid ?? null\n  };\n};\n\n// Case: no appointments at all\nif (!Array.isArray(apData) || apData.length === 0) {\n  if (Array.isArray(shipData.items)) {\n    for (let k = 0; k < shipData.items.length; k++) {\n      const item = shipData.items[k];\n      const shipmentGid = item?.shipmentGid;\n      const pctInfo = shipmentGid ? percentageDict[shipmentGid] : null;\n      const loadInfo = shipmentGid ? extPlannedLoadNbrWMSLoadMap[shipmentGid] : null;\n\n      let appointmentStatus = \"Appointment Missing\";\n      let loadedPerc = Array.isArray(pctInfo) ? (pctInfo[0] ?? 0) : 0;\n      let packedPerc = Array.isArray(pctInfo) ? (pctInfo[1] ?? 0) : 0;\n\n      if (loadInfo?.loadStatus === \"Shipped\") {\n        appointmentStatus = \"Complete\";\n        loadedPerc = 100;\n        packedPerc = 100;\n      }\n\n      let numericPriority = 3;\n\n      // Start time parsing for priority adjustment\n      const startTimeRaw =\n        (item && item.startTime && item.startTime.value) ??\n        (item && item[\"startTime\"] && item[\"startTime\"].value) ??\n        item?.startTime ??\n        item?.[\"startTime\"] ??\n        null;\n      const startMs = parseToUtcMs(startTimeRaw);\n      const startValid = startMs != null;\n\n      let diffInHours = null;\n      if (startValid) {\n        const startDiffMin = toMinutesFromMs(startMs) - toMinutes(now);\n        diffInHours = startDiffMin / 60;\n      }\n\n      if (\n        appointmentStatus === \"Appointment Missing\" &&\n        diffInHours !== null &&\n        diffInHours > 0.5 &&\n        diffInHours <= 24\n      ) {\n        numericPriority = 1;\n      }\n\n      results.push({\n        loadedPerc: loadedPerc,\n        packedPerc: packedPerc,\n        shipmentXid: item?.shipmentXid ?? null,\n        status: appointmentStatus,\n        delayMinutes: null,\n        sourceLocation: pickLoc(item?.sourceLocation),\n        destLocation: pickLoc(item?.destLocation),\n        loadNbr: loadInfo?.loadNbr ?? null,\n        loadStatus: loadInfo?.loadStatus ?? null,\n        totalShipUnitCount: item?.totalShipUnitCount ?? null,\n        totalItemPackageCount: item?.totalItemPackageCount ?? null,\n        loadedDistance: item?.loadedDistance ?? null,\n        unloadedDistance: item?.unloadedDistance ?? item?.unLoadedDistance ?? null,\n        startTime: item?.startTime ?? null,\n        endTime: item?.endTime ?? null,\n        numericPriority: numericPriority\n      });\n    }\n  }\n} else if (Array.isArray(shipData.items)) {\n  // Build lookup: externally_planned_load_nbr -> planned_start_ts (ISO, keep raw but we will parse to ms consistently)\n  const apLookup = {};\n  for (let i = 0; i < apData.length; i++) {\n    const a = apData[i];\n    const keyRaw = a?.externally_planned_load_nbr ?? a?.[\"externally_planned_load_nbr\"];\n    const tsRaw = a?.planned_start_ts ?? a?.[\"planned_start_ts\"];\n    if (keyRaw != null && tsRaw) {\n      const ms = parseToUtcMs(tsRaw);\n      if (ms != null) {\n        apLookup[String(keyRaw)] = ms; // store as ms\n      }\n    }\n  }\n\n  for (let j = 0; j < shipData.items.length; j++) {\n    let numericPriority;\n    const item = shipData.items[j];\n    const shipmentGid = item?.shipmentGid;\n    const key = shipmentGid != null ? String(shipmentGid) : null;\n\n    const apMs = key && (key in apLookup) ? apLookup[key] : null;\n    const apValid = apMs != null;\n\n    const pctInfo = shipmentGid ? percentageDict[shipmentGid] : null;\n    const loadInfo = shipmentGid ? extPlannedLoadNbrWMSLoadMap[shipmentGid] : null;\n\n    // Parse start time; support both raw and nested .value; normalize to ms\n    const startTimeRaw =\n      (item && item.startTime && item.startTime.value) ??\n      (item && item[\"startTime\"] && item[\"startTime\"].value) ??\n      item?.startTime ??\n      item?.[\"startTime\"] ??\n      null;\n    const startMs = parseToUtcMs(startTimeRaw);\n    const startValid = startMs != null;\n\n    let status;\n    let delayMinutes = null;\n    let diffMs = null;\n\n    if (!apValid || !startValid) {\n      status = \"Appointment Missing\";\n      numericPriority = 3;\n    } else {\n      const apMin = toMinutesFromMs(apMs);\n      const startMin = toMinutesFromMs(startMs);\n      const diffMin = apMin - startMin; // planned minus start\n      const msUntilAppt = apMs - now.getTime();\n      const within30Min = msUntilAppt >= 0 && msUntilAppt <= THIRTY_MIN;\n      const msSinceAppt = now.getTime() - apMs;\n      const missed = msSinceAppt > THIRTY_MIN;\n\n      if (missed) {\n        status = \"Appointment Missed\";\n        numericPriority = 2;\n      } else if (within30Min) {\n        status = \"Appointment at Risk\";\n        numericPriority = 1;\n      } else {\n        status = diffMin < 0 ? \"Delayed\" : \"On-Time\";\n      }\n      delayMinutes = diffMin;\n      diffMs = diffMin * 60000;\n    }\n\n    let appointmentStatus = status;\n    let loadedPerc = Array.isArray(pctInfo) ? (pctInfo[0] ?? 0) : 0;\n    let packedPerc = Array.isArray(pctInfo) ? (pctInfo[1] ?? 0) : 0;\n\n    if (loadInfo?.loadStatus === \"Shipped\") {\n      appointmentStatus = \"Complete\";\n      loadedPerc = 100;\n      packedPerc = 100;\n      delayMinutes = null;\n      numericPriority = 4;\n      diffMs = null;\n    }\n\n    // Adjust priority for missing appointment but near start time (minute-level)\n    let diffInHours = null;\n    if (startValid) {\n      const startDiffMin = toMinutesFromMs(startMs) - toMinutes(now);\n      diffInHours = startDiffMin / 60;\n    }\n    if (\n      appointmentStatus === \"Appointment Missing\" &&\n      diffInHours !== null &&\n      diffInHours > 0.5 &&\n      diffInHours <= 24\n    ) {\n      numericPriority = 1;\n    }\n    if (appointmentStatus === \"Appointment Missing\" && numericPriority !== 1) {\n      numericPriority = 3;\n    }\n\n    results.push({\n      loadedPerc: loadedPerc,\n      packedPerc: packedPerc,\n      shipmentXid: item?.shipmentXid ?? null,\n      status: appointmentStatus,\n      delayMinutes: delayMinutes,\n      sourceLocation: pickLoc(item?.sourceLocation),\n      destLocation: pickLoc(item?.destLocation),\n      loadNbr: loadInfo?.loadNbr ?? null,\n      loadStatus: loadInfo?.loadStatus ?? null,\n      totalShipUnitCount: item?.totalShipUnitCount ?? null,\n      totalItemPackageCount: item?.totalItemPackageCount ?? null,\n      loadedDistance: item?.loadedDistance ?? null,\n      unloadedDistance: item?.unloadedDistance ?? item?.unLoadedDistance ?? null,\n      startTime: item?.startTime ?? null,\n      endTime: item?.endTime ?? null,\n      numericPriority: numericPriority\n    });\n  }\n}\n\n// Sort: by numericPriority, then startTime\nresults.sort((a, b) => {\n  const pa = typeof a.numericPriority === \"number\" ? a.numericPriority : Number.POSITIVE_INFINITY;\n  const pb = typeof b.numericPriority === \"number\" ? b.numericPriority : Number.POSITIVE_INFINITY;\n  if (pa !== pb) return pa - pb;\n  const aStart = a.startTime ? new Date(a.startTime).getTime() : Number.POSITIVE_INFINITY;\n  const bStart = b.startTime ? new Date(b.startTime).getTime() : Number.POSITIVE_INFINITY;\n  return aStart - bStart;\n});\n\nreturn results;"
          },
          "outcomes": {
            "success": "1768221128111"
          },
          "code": "MAP_APPOINTMENT_TIME_WITH_SHIPMENT",
          "id": "1768397357233",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Data for appointment action",
            "returnType": "array",
            "sourceCode": "const shipData = $context.$nodes.MAP_APPOINTMENT_TIME_WITH_SHIPMENT.$output.result;\n// Ensure we have an array\nconst items = Array.isArray(shipData) ? shipData : (shipData?.items ?? []);\nconst reducedShipments = [];\nconst now = Date.now();\nfor (const shipment of items) \n{\n    const status = shipment?.status;\n    const startTime = shipment?.startTime?.value;\n    if (!startTime) continue;\n    const startTs = new Date(startTime).getTime();\n    if (!Number.isFinite(startTs)) continue;\n    const diffInHours = parseFloat((startTs - now) / (1000 * 60 * 60));\n    if (status === \"Appointment Missing\" && (diffInHours > 0.5 && diffInHours <= 24)) \n    {\n        reducedShipments.push({\n        shipmentXid: shipment?.shipmentXid ?? null,\n        status,\n        diffInHours,\n        startTs // keep for sorting\n        });\n    }\n}\n\n// Sort by earliest start time\nreducedShipments.sort((a, b) => a.startTs - b.startTs);\n\n// Optionally remove startTs if you don’t want it in the output\nfor (const r of reducedShipments) delete r.startTs;\n\nreturn reducedShipments;"
          },
          "outcomes": {
            "success": "1771417672582"
          },
          "code": "DATA_FOR_APPOINTMENT_ACTION",
          "convergenceTargetId": "1768422607823",
          "id": "1768428097087",
