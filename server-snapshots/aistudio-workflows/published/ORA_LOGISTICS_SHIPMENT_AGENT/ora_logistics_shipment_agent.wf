        {
          "metadata": {
            "name": "extractOTMShipmentGids",
            "returnType": "string",
            "sourceCode": "const response = $context.$variables.shipmentData;\nconst data = (typeof response === \"string\") ? JSON.parse(response) : response;\n\nconst shipmentGids = (data && data.items ? data.items : [])\n.map(item => (item && item.shipmentGid != null ? String(item.shipmentGid) : null))\n.filter(gid => gid && gid.length > 0);\n\nreturn shipmentGids.join(\",\");"
          },
          "outcomes": {
            "success": "1771617249281"
          },
          "code": "EXTRACTOTMSHIPMENTGIDS",
          "convergenceTargetId": "1768358385605",
          "id": "1771617096161",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_WMSLOGISTICSAPPBO",
            "functionName": "getLoadNbrsForExternallyPlannedLoadNbrs",
            "name": "getWMSLoadFromShipmentGids"
          },
          "outcomes": {
            "success": "1771618180483"
          },
          "code": "GETWMSLOADFROMSHIPMENTGIDS",
          "convergenceTargetId": "1768358385605",
          "id": "1771617249281",
          "inputs": [
            {
              "id": "1771617273698_1",
              "name": "ePlannedLoadNbrs",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACTOTMSHIPMENTGIDS.$output.result}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "extractWMSLoadAndExternallyPlannedLoadNbr",
            "returnType": "object",
            "sourceCode": "const src = $context.$nodes.GETWMSLOADFROMSHIPMENTGIDS.$output || {};\nconst loadData = Array.isArray(src) ? src : (src.results || src.items || []);\n\n// Map of externally planned load → latest loadNbr/loadStatus\nconst externallyPlannedLoadWMSLoadMap = {};\n\n// Aggregates per externally planned load\nconst aggregates = {}; // { extPlanned: { total, loaded, packed } }\n\nfor (let i = 0; i < loadData.length; i++) {\nconst r = loadData[i] || {};\nconst extPlanned = r.externally_planned_load_nbr;\nif (!extPlanned) continue;\n\n// Build/update map (keeps last seen; adjust to keep first if desired)\nexternallyPlannedLoadWMSLoadMap[extPlanned] = {\nloadNbr: r.load_nbr || null,\nloadStatus: r.load_status || null\n};\n\n// Determine status for aggregation\n// Prefer the detailed status if present; else fall back to load_status\nconst status =\nr.obstop__obstopdtl__container_id__status_id__description ||\nr.load_status ||\nnull;\n\nif (!aggregates[extPlanned]) {\naggregates[extPlanned] = { total: 0, loaded: 0, packed: 0 };\n}\nconst agg = aggregates[extPlanned];\nagg.total += 1;\n\n// Count rows with Loaded/Packed; other statuses just increase total\nif (status === \"Loaded\") agg.loaded += 1;\nif (status === \"Packed\") agg.packed += 1;\n}\n\n// Build percentageDict: { extPlanned: [pct_loaded, pct_packed] }\nconst percentageDict = {};\nfor (const key in aggregates) {\nconst { total, loaded, packed } = aggregates[key];\nconst pctLoaded = total ? +(100 * loaded / total).toFixed(2) : 0;\nconst pctPacked = total ? +(100 * packed / total).toFixed(2) : 0;\npercentageDict[key] = [pctLoaded, pctPacked];\n}\n\nreturn [externallyPlannedLoadWMSLoadMap, percentageDict];"
          },
          "outcomes": {
            "success": "1768359918652"
          },
          "code": "EXTRACTWMSLOADANDEXTERNALLYPLANNEDLOADNBR",
          "id": "1771618180483",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get Current Date",
            "returnType": "array",
            "sourceCode": "const now = new Date($context.$system.$currentDateTime);\nconst threeDaysMs = 7 * 24 * 60 * 60 * 1000;\n\nconst start = new Date(now.getTime() - threeDaysMs); // 3 days before\nconst end = new Date(now.getTime() + threeDaysMs); // 3 days after\n\nconst dateWindow = [start.toISOString(), end.toISOString()];\nreturn dateWindow;"
          },
          "outcomes": {
            "success": "1771410915707"
          },
