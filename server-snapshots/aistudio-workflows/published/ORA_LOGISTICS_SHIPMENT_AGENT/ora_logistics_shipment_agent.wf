          "code": "GENERATEFORM",
          "convergenceTargetId": "1770809221123",
          "id": "1770762644630",
          "inputs": [
            {
              "id": "1770762644631_1",
              "name": "prompt",
              "type": "string",
              "value": "Generate a form like this:\n{\n\"title\": \"Select a dock to assign\",\n\"fields\": [\n{\n\"type\": \"select\",\n\"name\": \"dock\",\n\"title\": \"Select a dock to assign\",\n\"options\": {{$context.$nodes.GETFREEDOCKS.$output.results.slice(0,6).map(r => ({label: r.dock_nbr, value: r.dock_nbr}))}},\n},\n{\n\"type\":\"hidden\",\n\"name\":\"shipmentXid\",\n\"value\": \"{{$context.$variables.shipmentXid}}\"\n}\n]\n}\n\nDo not put any other fields on this form"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
