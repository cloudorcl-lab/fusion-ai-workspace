        {
          "metadata": {
            "name": "Build Workflow Complete Audit Payload",
            "returnType": "object",
            "sourceCode": "// =====================================================================\n// JavaScript: Build Workflow Audit Save Payload (COMPLETED)\n// Output: WorkflowAgentAuditSaveRequest JSON object\n// =====================================================================\n\nvar payload = {};\n\n// ---------------------------------------------------------------------\n// Required inputs from trigger/system\n// ---------------------------------------------------------------------\nvar contentId = $context.$triggers.REST.$input.contentId;\nvar operation = $context.$triggers.REST.$input.operation;\nvar contentFormat = $context.$variables.contentFormat;\n\nvar currentTime = Date.now();\nvar nowIso = new Date(Number(currentTime)).toISOString();\nvar conversationId = $context.$workflow.$conversationId;\nvar latestProcessingStatus = \"WORKFLOW_COMPLETED\";\nvar outputMessage = $context.$variables.outputMessage;\n\n// ---------------------------------------------------------------------\n// Runtime fields (best-effort)\n// ---------------------------------------------------------------------\nvar workflowCode = null;\nvar workflowId = null;\nvar jobId = null;\nvar traceId = null;\n\ntry {\n  if ($context.$workflow) {\n    if ($context.$workflow.$name != null) {\n      workflowCode = $context.$workflow.$name;\n    }\n    if ($context.$workflow.$workflowId != null) {\n      workflowId = $context.$workflow.$workflowId;\n    }\n    if ($context.$workflow.$jobId != null) {\n      jobId = $context.$workflow.$jobId;\n    }\n    if ($context.$workflow.$traceId != null) {\n      traceId = $context.$workflow.$traceId;\n    }\n  }\n\n  if (jobId == null && $context.$job && $context.$job.$id != null) {\n    jobId = $context.$job.$id;\n  }\n  if (jobId == null && $context.$system && $context.$system.$jobId != null) {\n    jobId = $context.$system.$jobId;\n  }\n} catch (e) {\n  // ignore - best-effort\n}\n\n// ---------------------------------------------------------------------\n// Normalize strings (trim + null for blank)\n// ---------------------------------------------------------------------\nif (workflowCode != null) { workflowCode = String(workflowCode).trim(); if (workflowCode.length === 0) workflowCode = null; }\nif (workflowId != null) { workflowId = String(workflowId).trim(); if (workflowId.length === 0) workflowId = null; }\nif (jobId != null) { jobId = String(jobId).trim(); if (jobId.length === 0) jobId = null; }\nif (traceId != null) { traceId = String(traceId).trim(); if (traceId.length === 0) traceId = null; }\nif (conversationId != null) { conversationId = String(conversationId).trim(); if (conversationId.length === 0) conversationId = null; }\nif (operation != null) { operation = String(operation).trim(); if (operation.length === 0) operation = null; }\nif (contentFormat != null) { contentFormat = String(contentFormat).trim(); if (contentFormat.length === 0) contentFormat = null; }\nif (nowIso != null) { nowIso = String(nowIso).trim(); if (nowIso.length === 0) nowIso = null; }\n\n// ---------------------------------------------------------------------\n// Build payload per WorkflowAgentAuditSaveRequest\n// (include only non-null attributes)\n// ---------------------------------------------------------------------\nif (workflowCode != null) {\n  payload.workflowCode = workflowCode;\n}\nif (workflowId != null) {\n  payload.workflowId = workflowId;\n}\nif (jobId != null) {\n  payload.jobId = jobId;\n}\nif (conversationId != null) {\n  payload.conversationId = conversationId;\n}\nif (traceId != null) {\n  payload.traceId = traceId;\n}\nif (operation != null) {\n  payload.operation = operation;\n}\nif (contentFormat != null) {\n  payload.contentFormat = contentFormat;\n}\n\n// processingStart is intentionally NOT set here.\n// Existing value in DB is preserved due to merge logic.\n\nif (nowIso != null) {\n  payload.processingEnd = nowIso;\n  payload.latestProcessedDate = nowIso;\n}\n\n// Always set status (never null in this node)\npayload.latestProcessingStatus = latestProcessingStatus;\n\n// Human-readable completion message\npayload.message = \"[\" + nowIso + \"] \" + latestProcessingStatus +  \" - \" + outputMessage;\n// ---------------------------------------------------------------------\n// Return payload\n// ---------------------------------------------------------------------\nreturn payload;"
          },
