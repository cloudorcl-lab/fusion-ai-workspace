        {
          "metadata": {
            "name": "Build Workflow Start Audit Payload",
            "returnType": "object",
            "sourceCode": "// =====================================================================\n// JavaScript: Build Workflow Audit Save Payload (START)\n// Output: WorkflowAgentAuditSaveRequest JSON object\n// =====================================================================\n\nvar payload = {};\n\n// ---------------------------------------------------------------------\n// Required inputs from trigger/system\n// ---------------------------------------------------------------------\nvar contentId = $context.$triggers.REST.$input.contentId;\nvar operation = $context.$triggers.REST.$input.operation;\n\nvar currentTime = Date.now();\nvar nowIso = new Date(Number(currentTime)).toISOString();\nvar conversationId = $context.$workflow.$conversationId;\nvar latestProcessingStatus = \"WORKFLOW_RUNNING\";\n\n// ---------------------------------------------------------------------\n// Best-effort runtime fields (may vary by runtime)\n// ---------------------------------------------------------------------\nvar workflowCode = null;\nvar workflowId = null;\nvar jobId = null;\nvar traceId = null;\n\ntry {\n  if ($context.$workflow) {\n    if ($context.$workflow.$name != null) {\n      workflowCode = $context.$workflow.$name;\n    }\n    if ($context.$workflow.$jobId != null) {\n      jobId = $context.$workflow.$jobId;\n    }\n    if ($context.$workflow.$traceId != null) {\n      traceId = $context.$workflow.$traceId;\n    }\n  }\n\n  if (jobId == null && $context.$job && $context.$job.$id != null) {\n    jobId = $context.$job.$id;\n  }\n  if (jobId == null && $context.$system && $context.$system.$jobId != null) {\n    jobId = $context.$system.$jobId;\n  }\n} catch (e) {\n  // ignore - best-effort\n}\n\n// ---------------------------------------------------------------------\n// Normalize strings (trim + null for blank)\n// ---------------------------------------------------------------------\nif (workflowCode != null) {\n  workflowCode = String(workflowCode).trim();\n  if (workflowCode.length === 0) workflowCode = null;\n}\nif (workflowId != null) {\n  workflowId = String(workflowId).trim();\n  if (workflowId.length === 0) workflowId = null;\n}\nif (jobId != null) {\n  jobId = String(jobId).trim();\n  if (jobId.length === 0) jobId = null;\n}\nif (traceId != null) {\n  traceId = String(traceId).trim();\n  if (traceId.length === 0) traceId = null;\n}\nif (conversationId != null) {\n  conversationId = String(conversationId).trim();\n  if (conversationId.length === 0) conversationId = null;\n}\nif (operation != null) {\n  operation = String(operation).trim();\n  if (operation.length === 0) operation = null;\n}\nif (nowIso != null) {\n  nowIso = String(nowIso).trim();\n  if (nowIso.length === 0) nowIso = null;\n}\n\n// ---------------------------------------------------------------------\n// Build payload per WorkflowAgentAuditSaveRequest\n// (include only non-null attributes)\n// ---------------------------------------------------------------------\nif (workflowCode != null) {\n  payload.workflowCode = workflowCode;\n}\nif (workflowId != null) {\n  payload.workflowId = workflowId;\n}\nif (jobId != null) {\n  payload.jobId = jobId;\n}\nif (conversationId != null) {\n  payload.conversationId = conversationId;\n}\nif (traceId != null) {\n  payload.traceId = traceId;\n}\nif (operation != null) {\n  payload.operation = operation;\n}\nif (nowIso != null) {\n  payload.processingStart = nowIso;\n}\n\n// Always set status (never null in this node)\npayload.latestProcessingStatus = latestProcessingStatus;\n\n// message stored in OBJECT_DETAILS\npayload.message =\n  \"[\" + nowIso + \"] \" + latestProcessingStatus + \" - Workflow running.\";\n\n// ---------------------------------------------------------------------\n// Return payload (caller uses contentId in REST URL)\n// ---------------------------------------------------------------------\nreturn payload;"
          },
          "outcomes": {
            "success": "1770671176925"
          },
