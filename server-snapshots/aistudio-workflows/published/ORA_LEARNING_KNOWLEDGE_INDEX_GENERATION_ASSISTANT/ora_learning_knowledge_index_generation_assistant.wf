{
  "workflowId": "300000331062508",
  "workflowCode": "ORA_LEARNING_KNOWLEDGE_INDEX_GENERATION_ASSISTANT",
  "name": "Learning Knowledge Index Generation Assistant",
  "description": "This workflow agent orchestrates end-to-end indexing of learning content through REST-driven coordination. It identifies the content format (PDF, Video, or SCORM), resolves the applicable files, and delegates file-level processing to downstream agents. The agent manages iteration across SCORM containers, ensures consistent handling for both single-file and multi-file content, and provides a unified entry point for indexing and deletion operations without performing file-level extraction itself.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
