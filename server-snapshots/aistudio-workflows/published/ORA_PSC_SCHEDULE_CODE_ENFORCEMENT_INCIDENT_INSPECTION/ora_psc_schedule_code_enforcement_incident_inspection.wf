                  "inputs": [
                    {
                      "id": "1774966704260_1",
                      "name": "prompt",
                      "type": "string",
                      "value": "Input date: {{$context.$variables.CurrentDate}}\n\nTask:\nAdd exactly 1 day to the input date.\n\nRules:\n- Do NOT change month unless required by normal calendar rollover\n- Do NOT jump weeks or months\n- Only increment by 1 day\n- Preserve the same date format as original string\n- Return ONLY the new date string\n\nExample:\n2026-03-30 : 2026-03-31\n2026-03-31 : 2026-04-01"
                    }
                  ],
                  "outputSpecification": "{\n  \"currentDate\" : \"[string]\"\n}",
                  "type": "LLM",
                  "diagram": {
                    "x": 5545.5,
                    "y": 7072
                  }
                },
                {
                  "id": "1780332578199",
                  "code": "INCREMENT_DATE",
                  "type": "CODE",
                  "metadata": {
                    "name": "Increment Date",
                    "returnType": "object",
                    "sourceCode": "  const inputDate = $context.$variables.CurrentDate;\n\n    // Preserve YYYY-MM-DD format\n    const [year, month, day] = inputDate.split('-').map(Number);\n\n    const date = new Date(year, month - 1, day);\n    date.setDate(date.getDate() + 1);\n\n    const newDate =\n        `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;\n\n    return {\n        currentDate: newDate\n    };"
                  },
                  "diagram": {
                    "x": 5020,
                    "y": 8182
                  },
                  "outcomes": {
                    "success": "1774966935410"
                  },
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
