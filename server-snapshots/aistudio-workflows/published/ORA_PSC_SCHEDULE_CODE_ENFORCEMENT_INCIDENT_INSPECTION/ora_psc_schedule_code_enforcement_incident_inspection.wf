        {
          "id": "1780332368992",
          "code": "CONVERT_DUE_DATE",
          "type": "CODE",
          "metadata": {
            "name": "Convert Due Date",
            "sourceCode": "    const dueDate = $context.$variables.DueDate;\n\n    // Return as-is if already in YYYY-MM-DD format\n    if (/^\\d{4}-\\d{2}-\\d{2}$/.test(dueDate)) {\n        return {\n            DueDate: dueDate\n        };\n    }\n\n    const d = new Date(dueDate);\n\n    if (isNaN(d.getTime())) {\n        throw new Error(`Invalid date: ${dueDate}`);\n    }\n\n    const formattedDate =\n        `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;\n\n    return {\n        DueDate: formattedDate\n    };",
            "returnType": "object"
          },
          "diagram": {
            "x": 5282.75,
            "y": 6538
          },
          "outcomes": {
            "success": "1774985059774"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
