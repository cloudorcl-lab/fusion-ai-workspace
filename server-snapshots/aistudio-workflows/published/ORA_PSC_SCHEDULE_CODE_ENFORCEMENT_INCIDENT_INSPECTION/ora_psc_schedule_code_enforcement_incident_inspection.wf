        {
          "id": "1780332050258",
          "code": "CONVERT_DATE",
          "type": "CODE",
          "metadata": {
            "name": "Convert Date",
            "sourceCode": "\n const currentDateRaw = $context.$system.$currentDate;\n    const reviewDateRaw = $context.$nodes.GET_INCIDENT_DETAILS.$output.items[0].ReviewDueDate;\n    const submitDateRaw = $context.$nodes.GET_INCIDENT_DETAILS.$output.items[0].SubmitDate;\n\n    // DD-MM-YYYY\n    function formatDDMMYYYY(dateValue) {\n        const d = new Date(dateValue);\n        const dd = String(d.getDate()).padStart(2, '0');\n        const mm = String(d.getMonth() + 1).padStart(2, '0');\n        const yyyy = d.getFullYear();\n        return `${dd}-${mm}-${yyyy}`;\n    }\n\n    // YYYY-MM-DD\n    function formatYYYYMMDD(dateValue) {\n        const d = new Date(dateValue);\n        const yyyy = d.getFullYear();\n        const mm = String(d.getMonth() + 1).padStart(2, '0');\n        const dd = String(d.getDate()).padStart(2, '0');\n        return `${yyyy}-${mm}-${dd}`;\n    }\n\n    // yyyy-MM-ddTHH:mm:ssXXX\n    // Ensures timezone offset is always represented with \"-\" sign\n    function formatSubmitDate(dateValue) {\n        const d = new Date(dateValue);\n\n        const yyyy = d.getFullYear();\n        const mm = String(d.getMonth() + 1).padStart(2, '0');\n        const dd = String(d.getDate()).padStart(2, '0');\n\n        const hh = String(d.getHours()).padStart(2, '0');\n        const mi = String(d.getMinutes()).padStart(2, '0');\n        const ss = String(d.getSeconds()).padStart(2, '0');\n\n        const offsetMinutes = Math.abs(d.getTimezoneOffset());\n        const offsetHours = String(Math.floor(offsetMinutes / 60)).padStart(2, '0');\n        const offsetMins = String(offsetMinutes % 60).padStart(2, '0');\n\n        // Always use \"-\" as requested\n        return `${yyyy}-${mm}-${dd}T${hh}:${mi}:${ss}-${offsetHours}:${offsetMins}`;\n    }\n\n    return {\n        currentDate: formatDDMMYYYY(currentDateRaw),\n        ReviewDueDate: formatYYYYMMDD(reviewDateRaw),\n        SubmitDate: formatSubmitDate(submitDateRaw),\n        InspDueDate: formatYYYYMMDD(submitDateRaw)\n    };",
            "returnType": "object"
          },
          "diagram": {
            "x": 5282.75,
            "y": 5650
          },
          "outcomes": {
            "success": "1774968052988"
