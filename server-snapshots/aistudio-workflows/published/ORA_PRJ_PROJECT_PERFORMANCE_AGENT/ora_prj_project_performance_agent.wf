{
  "workflowId": "300000331058293",
  "workflowCode": "ORA_PRJ_PROJECT_PERFORMANCE_AGENT",
  "name": "Project Performance Agent",
  "description": "Enables proactive monitoring of project health and execution performance across schedule, cost, resources, and progress against plan. Analyzes actual project signals against approved baselines, targets, and expected outcomes to identify meaningful variances, emerging risks, and exceptions that require attention. Reduces manual effort in tracking project status by surfacing the most relevant performance insights and highlighting the issues most likely to affect delivery. Supports faster, more informed decisions through real-time visibility into project trends, guided variance analysis, and recommended focus areas, helping project teams maintain control, improve predictability, and keep projects aligned with business objectives.",
  "specification": {
