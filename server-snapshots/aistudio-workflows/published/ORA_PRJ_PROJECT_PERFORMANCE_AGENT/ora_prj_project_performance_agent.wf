          "metadata": {
            "name": "Combine User Message and Assistant Output",
            "returnType": "array",
            "sourceCode": "const userMessage = $context.$system.$inputMessage || null;\nconst commonAssistantOutput = $context.$variables.finalOutput || null;\n\n// Initialize context array if not present\n//if (!Array.isArray($context.context)) {\n //$context.context = [];\n//}\n\n// Create new entry\nconst newEntry = { userMessage, commonAssistantOutput };\nconst finalArray = [...($context.$variables.context || []), newEntry];\n// Append new entry to context\n// $context.$variables.context.push(newEntry); \n//$context.context.push(newEntry);\n\n// Return updated context\n//return finalArray;\n//const result = { context: finalArray };\nreturn finalArray;"
          },
