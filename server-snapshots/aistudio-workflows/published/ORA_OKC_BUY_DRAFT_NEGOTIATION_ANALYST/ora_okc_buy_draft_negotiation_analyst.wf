            "returnType": "array",
            "sourceCode": "const restQueryOutput = $context.$nodes.BUILD_REST_QUERY.$output || {};\nconst encodedQParam = String(\n  restQueryOutput &&\n  restQueryOutput.result &&\n  restQueryOutput.result.encodedQParam\n    ? restQueryOutput.result.encodedQParam\n    : \"\"\n).trim();\n\nif (!encodedQParam) {\n  throw new Error(\"BUILD_REST_QUERY output encodedQParam is required\");\n}\n\nconst fields = \"PartyName,Assignee,SeverityCode,Description,AssignedDate,ContractId,ContractNumber,ContractTypeName,BuyOrSell,AccessLevel;ContractDeviatingClauses:Status,SeverityCode\";\nconst path =\n  \"/contracts?onlyData=true&\" +\n  encodedQParam +\n  \"&orderBy=AccessLevel:desc,SeverityCode:desc,AssignedDate:asc&fields=\" +\n  encodeURIComponent(fields);\n\nreturn [\n  {\n    id: \"contractListSelectedFields\",\n    path,\n    operation: \"get\"\n  }\n];"
