          "metadata": {
            "name": "Resolve Contract Intent",
            "returnType": "object",
            "sourceCode": "const forcedIntent = 'buy';\nconst buyOrSellCode = 'B';\nconst partyLabel = 'Supplier';\n\nreturn {\n  discriminator: forcedIntent,\n  intent: forcedIntent,\n  buyOrSellCode,\n  partyLabel\n};"
