          "code": "BUILD_QUERY_ANSWER_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Build Query Answer Context",
            "returnType": "object",
            "sourceCode": "const nodes = ($context || {}).$nodes || {};\nconst parsed = ((nodes.PARSE_QUERY_UI_CONTEXT || {}).$output || {}).result || {};\nconst router = ((nodes.NORMALIZE_UI_QUERY_ROUTER || {}).$output || {}).result || {};\nconst batchOutputRaw = (nodes.GET_QUERY_CONTRACT_DEVIATIONS_FROM_REST || {}).$output || {};\n\nfunction compact(value) {\n  return String(value === null || value === undefined ? '' : value)\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nfunction parseIfJson(value) {\n  if (typeof value !== 'string') {\n    return value;\n  }\n\n  const trimmed = value.trim();\n  if (!trimmed) {\n    return null;\n  }\n\n  try {\n    return JSON.parse(trimmed);\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction asObject(value) {\n  const parsedValue = parseIfJson(value);\n  if (parsedValue && typeof parsedValue === 'object' && !Array.isArray(parsedValue)) {\n    return parsedValue;\n  }\n\n  if (value && typeof value === 'object' && !Array.isArray(value)) {\n    return value;\n  }\n\n  return {};\n}\n\nfunction payloadItems(payload) {\n  const payloadObject = asObject(payload);\n  if (Array.isArray(payloadObject.items)) {\n    return payloadObject.items;\n  }\n\n  if (payloadObject.result && Array.isArray(payloadObject.result.items)) {\n    return payloadObject.result.items;\n  }\n\n  return [];\n}\n\nfunction extractFetchedContracts(rawBatch) {\n  const rawObject = asObject(rawBatch);\n\n  if (Array.isArray(rawBatch)) {\n    return rawBatch;\n  }\n\n  if (Array.isArray(rawObject.items)) {\n    return rawObject.items;\n  }\n\n  if (rawObject.result && Array.isArray(rawObject.result.items)) {\n    return rawObject.result.items;\n  }\n\n  const parts = Array.isArray(rawObject.parts) ? rawObject.parts : [];\n  let i = 0;\n\n  for (i = 0; i < parts.length; i += 1) {\n    const part = parts[i] || {};\n    if (part.id === 'queryContractsWithDeviations') {\n      const items = payloadItems(part.payload || part.result);\n      if (items.length > 0) {\n        return items;\n      }\n    }\n  }\n\n  for (i = 0; i < parts.length; i += 1) {\n    const items = payloadItems((parts[i] || {}).payload || (parts[i] || {}).result);\n    if (items.length > 0) {\n      return items;\n    }\n  }\n\n  return [];\n}\n\nfunction childDeviationRows(contractRecord) {\n  const record = asObject(contractRecord);\n  const child = record.ContractDeviatingClauses || record.contractDeviatingClauses;\n  if (Array.isArray(child)) {\n    return child;\n  }\n\n  if (child && Array.isArray(child.items)) {\n    return child.items;\n  }\n\n  return [];\n}\n\nfunction normalizeToken(value) {\n  return compact(value).toUpperCase().replace(/[\\s_-]+/g, '');\n}\n\nfunction humanizeCode(value) {\n  const raw = compact(value);\n  if (!raw) {\n    return '';\n  }\n\n  return raw\n    .replace(/[_-]+/g, ' ')\n    .toLowerCase()\n    .replace(/\\b\\w/g, function (ch) {\n      return ch.toUpperCase();\n    });\n}\n\nfunction normalizeDeviation(row) {\n  const item = asObject(row);\n  return {\n    id: compact(item.Id || item.DeviatingClauseId || item.deviatingClauseId || ''),\n    clauseTitle: compact(item.ClauseTitle || item.clauseTitle || ''),\n    deviationSummary: compact(item.DeviationSummary || item.deviationSummary || item.ChangeRequestSummary || item.changeRequestSummary || ''),\n    severityCode: compact(item.SeverityCode || item.severityCode || ''),\n    severity: humanizeCode(item.SeverityCode || item.severityCode || ''),\n    status: compact(item.Status || item.status || '')\n  };\n}\n\nfunction countDeviationBuckets(deviations) {\n  const counters = {\n    open: 0,\n    reviewed: 0,\n    closed: 0,\n    critical: 0,\n    highRisk: 0,\n    mediumRisk: 0,\n    lowRisk: 0\n  };\n\n  let i = 0;\n  for (i = 0; i < deviations.length; i += 1) {\n    const row = deviations[i] || {};\n    const statusToken = normalizeToken(row.status);\n    const severityToken = normalizeToken(row.severityCode || row.severity);\n\n    if (statusToken === 'OPEN') {\n      counters.open += 1;\n    } else if (statusToken === 'REVIEWED') {\n      counters.reviewed += 1;\n    } else if (\n      statusToken === 'CLOSED' ||\n      statusToken === 'RESOLVED' ||\n      statusToken === 'COMPLETED' ||\n      statusToken === 'APPROVED' ||\n      statusToken === 'ACCEPTED'\n    ) {\n      counters.closed += 1;\n    }\n\n    if (severityToken === '4CRITICAL' || severityToken === 'CRITICAL') {\n      counters.critical += 1;\n    } else if (severityToken === '3HIGHRISK' || severityToken === 'HIGHRISK' || severityToken === 'HIGH') {\n      counters.highRisk += 1;\n    } else if (severityToken === '2MEDIUMRISK' || severityToken === 'MEDIUMRISK' || severityToken === 'MEDIUM') {\n      counters.mediumRisk += 1;\n    } else if (severityToken === '1LOWRISK' || severityToken === 'LOWRISK' || severityToken === 'LOW') {\n      counters.lowRisk += 1;\n    }\n  }\n\n  return counters;\n}\n\nconst childDataNeed = compact(router.childDataNeed) === 'clause_details' ? 'clause_details' : 'deviation_counts';\nconst includeClauseDetails = childDataNeed === 'clause_details';\nconst visibleContracts = Array.isArray(parsed.visibleContracts) ? parsed.visibleContracts : [];\nconst fetchedContracts = router.route === 'FETCH_CHILD_DATA' ? extractFetchedContracts(batchOutputRaw) : [];\nconst fetchedById = {};\n\nlet fetchedIndex = 0;\nfor (fetchedIndex = 0; fetchedIndex < fetchedContracts.length; fetchedIndex += 1) {\n  const record = asObject(fetchedContracts[fetchedIndex]);\n  const contractId = compact(record.ContractId || record.contractId || '');\n  if (contractId) {\n    fetchedById[contractId] = record;\n  }\n}\n\nconst contracts = [];\nlet rowIndex = 0;\nfor (rowIndex = 0; rowIndex < visibleContracts.length; rowIndex += 1) {\n  const uiRow = asObject(visibleContracts[rowIndex]);\n  const contractId = compact(uiRow.contractId || '');\n  const fetchedRecord = contractId ? fetchedById[contractId] : null;\n  const hasFetchedRecord = Boolean(fetchedRecord);\n  const deviations = hasFetchedRecord ? childDeviationRows(fetchedRecord).map(normalizeDeviation) : [];\n  const counters = countDeviationBuckets(deviations);\n  const contract = {\n    rowOrder: rowIndex,\n    panelId: compact(uiRow.panelId),\n    panelName: compact(uiRow.panelName),\n    agentCode: compact(uiRow.agentCode),\n    intent: compact(uiRow.intent),\n    partyLabel: compact(uiRow.partyLabel),\n    contractId,\n    contractNumber: compact((fetchedRecord || {}).ContractNumber || uiRow.contractNumber),\n    description: compact((fetchedRecord || {}).Description || uiRow.description),\n    party: compact((fetchedRecord || {}).PartyName || uiRow.party),\n    assignee: compact((fetchedRecord || {}).Assignee || uiRow.assignee),\n    severity: compact((fetchedRecord || {}).SeverityCodeMeaning || (fetchedRecord || {}).SeverityCode || uiRow.severity),\n    assignedSince: compact((fetchedRecord || {}).AssignedDate || uiRow.assignedSince),\n    childDataAvailable: router.route === 'FETCH_CHILD_DATA' ? hasFetchedRecord : false,\n    deviationCount: router.route === 'FETCH_CHILD_DATA' && hasFetchedRecord ? deviations.length : null,\n    deviationCounters: counters\n  };\n\n  if (includeClauseDetails) {\n    contract.deviations = deviations;\n  }\n\n  contracts.push(contract);\n}\n\nconst knownDeviationContracts = contracts.filter(function (contract) {\n  return contract.childDataAvailable;\n});\n\nlet maxDeviationCount = null;\nlet maxDeviationContracts = [];\nlet i = 0;\n\nfor (i = 0; i < knownDeviationContracts.length; i += 1) {\n  const count = knownDeviationContracts[i].deviationCount;\n  if (maxDeviationCount === null || count > maxDeviationCount) {\n    maxDeviationCount = count;\n    maxDeviationContracts = [knownDeviationContracts[i]];\n  } else if (count === maxDeviationCount) {\n    maxDeviationContracts.push(knownDeviationContracts[i]);\n  }\n}\n\nconst childDataContractIds = contracts.filter(function (contract) {\n  return contract.contractId;\n});\n\nconst allChildDataReturned = knownDeviationContracts.length === childDataContractIds.length;\n\nlet answerHint = '';\nif (maxDeviationContracts.length > 0) {\n  const names = maxDeviationContracts.map(function (contract) {\n    return compact(contract.contractNumber || contract.contractId) +\n      (contract.panelId ? ' (' + contract.panelId + ' panel)' : '');\n  });\n  const plural = maxDeviationContracts.length > 1 ? ' have ' : ' has ';\n  answerHint = names.join(', ') + plural + 'the most deviations with ' + String(maxDeviationCount) + '.';\n}\n\nreturn {\n  question: compact(parsed.question),\n  source: 'OraUiContext + ContractDeviatingClauses',\n  route: compact(router.route),\n  answerLanguage: compact(router.answerLanguage),\n  childDataNeed,\n  visibleContractCount: contracts.length,\n  contractIdCount: Array.isArray(parsed.contractIds) ? parsed.contractIds.length : 0,\n  fetchedContractCount: fetchedContracts.length,\n  allChildDataReturned,\n  contracts,\n  maxDeviationCount,\n  maxDeviationContracts,\n  answerHint\n};"
          },
