          "id": "1776607143066",
          "code": "CHECK_CONTRUCT_QUERY_INTERPRETATION",
          "type": "CODE",
          "metadata": {
            "name": "check contruct query interpretation",
            "returnType": "object",
            "sourceCode": "const llmOutput = $context.$nodes.CONTRUCT_QUERY_NODE.$output || {};\n\nfunction hasNonEmptyString(value) {\n  return typeof value === 'string' && value.trim().length > 0;\n}\n\nfunction hasNonEmptyBusinessUnitName(value) {\n  if (!Array.isArray(value)) {\n    return false;\n  }\n\n  return value.some((item) => String(item !== null && item !== undefined ? item : '').trim().length > 0);\n}\n\nconst queryStrings = Array.isArray(llmOutput.queryStrings) ? llmOutput.queryStrings : [];\nconst hasQueryStrings = queryStrings.some((item) => hasNonEmptyString(item));\nconst hasLegacyQueryString = hasNonEmptyString(llmOutput.queryString);\nconst hasInterpretableQuery = hasQueryStrings || hasLegacyQueryString;\nconst hasBusinessUnitNames = hasNonEmptyBusinessUnitName(llmOutput.businessUnitNames);\n\nconst result = {\n  route: hasInterpretableQuery\n    ? (hasBusinessUnitNames ? 'PROCEED' : 'SKIP_BU_LOOKUP')\n    : 'SKIP_UNINTERPRETABLE',\n  hasInterpretableQuery,\n  hasBusinessUnitNames\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776607143067"
          },
          "inputs": [],
          "diagram": {
            "x": 5900,
            "y": 6800
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
