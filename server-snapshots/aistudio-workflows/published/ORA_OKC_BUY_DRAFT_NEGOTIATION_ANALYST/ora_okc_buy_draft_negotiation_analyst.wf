        {
          "metadata": {
            "name": "normalize contract fields from batch",
            "returnType": "object",
            "sourceCode": "const batchOutputRaw = $context.$nodes.GET_CONTRACT_FIELDS_DATA_FROM_REST.$output || {};\nconst intentOutput = (($context.$nodes.RESOLVE_CONTRACT_INTENT || {}).$output || {}).result || {};\nconst severityLookupOutput = (($context.$nodes.GET_SEVERITY_CODE_MEANINGS || {}).$output || {}).result || [];\nconst intent = intentOutput.intent === \"sell\" ? \"sell\" : \"buy\";\nconst buyOrSellCode = intent === \"sell\" ? \"S\" : \"B\";\nconst partyLabel = intent === \"sell\" ? \"Customer\" : \"Supplier\";\nconst messageHint = compact(($context.$app || {}).$OraMessageHint);\nconst defaultPayload = { items: [], intent, buyOrSellCode, partyLabel };\nlet normalizedPayload = defaultPayload;\nlet directOutput = null;\nlet parsedValue = null;\nlet partsContainer = null;\nlet parts = [];\nlet payload = null;\nlet i = 0;\nlet partPayloadRaw = null;\nlet partPayloadObject = null;\nconst keysToDrop = new Set([\n  'links',\n  '@context',\n  'key',\n  'headers',\n  'totalResults',\n  'count',\n  'hasMore',\n  'limit',\n  'offset'\n]);\n\nfunction compact(value) {\n  return String(value === null || value === undefined ? '' : value)\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nfunction normalizeToken(value) {\n  return compact(value).toUpperCase().replace(/[\\s_-]+/g, '');\n}\n\nfunction asArray(value) {\n  return Array.isArray(value) ? value : [];\n}\n\nfunction severityRows(rawLookup) {\n  if (Array.isArray(rawLookup)) {\n    return rawLookup;\n  }\n\n  if (rawLookup && Array.isArray(rawLookup.items)) {\n    return rawLookup.items;\n  }\n\n  if (rawLookup && rawLookup.result) {\n    return severityRows(rawLookup.result);\n  }\n\n  return [];\n}\n\nfunction buildSeverityMap(rawLookup) {\n  const rows = severityRows(rawLookup);\n  const map = {};\n  let i = 0;\n\n  for (i = 0; i < rows.length; i += 1) {\n    const row = rows[i] || {};\n    const code = compact(row.LookupCode || row.lookupCode || row.Code || row.code);\n    const meaning = compact(row.Meaning || row.meaning || row.DisplayValue || row.displayValue || row.LookupMeaning || row.lookupMeaning);\n    const token = normalizeToken(code);\n\n    if (token && meaning) {\n      map[token] = meaning;\n    }\n  }\n\n  return map;\n}\n\nconst severityMeaningByCode = buildSeverityMap(severityLookupOutput);\n\nfunction severityPriority(severityCode) {\n  const lookupCode = compact(severityCode);\n\n  switch (lookupCode) {\n    case '4_CRITICAL':\n      return 'alert';\n    case '3_HIGH_RISK':\n      return 'warning';\n    case '2_MEDIUM_RISK':\n      return 'medium';\n    case '1_LOW_RISK':\n      return 'neutral';\n    case '0_NO_RISK':\n      return 'success';\n    default:\n      return 'medium';\n  }\n}\n\nfunction canonicalSeverityMeaning(severityCode, existingMeaning) {\n  const code = compact(severityCode);\n  const mapped = severityMeaningByCode[normalizeToken(code)];\n\n  if (mapped) {\n    return mapped;\n  }\n\n  const meaning = compact(existingMeaning);\n  if (meaning && normalizeToken(meaning) !== normalizeToken(code)) {\n    return meaning;\n  }\n\n  return '';\n}\n\nfunction canonicalizeSeverityFields(record) {\n  if (!record || typeof record !== 'object' || Array.isArray(record)) {\n    return;\n  }\n\n  const severityCode = compact(record.SeverityCode || record.severityCode);\n  if (severityCode) {\n    const severityMeaning = canonicalSeverityMeaning(severityCode);\n    record.SeverityCodeMeaning = severityMeaning;\n    record.SeverityBadgeText = severityMeaning;\n    record.SeverityPriority = severityPriority(severityCode);\n  }\n\n  const keys = Object.keys(record);\n  let keyIndex = 0;\n  for (keyIndex = 0; keyIndex < keys.length; keyIndex += 1) {\n    const value = record[keys[keyIndex]];\n    if (Array.isArray(value)) {\n      let arrayIndex = 0;\n      for (arrayIndex = 0; arrayIndex < value.length; arrayIndex += 1) {\n        canonicalizeSeverityFields(value[arrayIndex]);\n      }\n    } else if (value && typeof value === 'object') {\n      canonicalizeSeverityFields(value);\n    }\n  }\n}\n\nfunction isOpenRequestedChange(record) {\n  return /OPEN/i.test(compact(record && record.Status));\n}\n\nfunction requestedChangeSeverityCode(record) {\n  return compact(record && (record.SeverityCode || record.severityCode)).toUpperCase();\n}\n\nfunction isCriticalRequestedChange(record) {\n  return requestedChangeSeverityCode(record) === '4_CRITICAL';\n}\n\nfunction isHighRiskRequestedChange(record) {\n  return requestedChangeSeverityCode(record) === '3_HIGH_RISK';\n}\n\nfunction contractSummaryCounts(contract, sourceIndex) {\n  const childContainer = contract && contract.ContractDeviatingClauses;\n  const requestedChanges = asArray(childContainer && childContainer.items);\n  let openCriticalCount = 0;\n  let openHighRiskCount = 0;\n  let changeIndex = 0;\n\n  for (changeIndex = 0; changeIndex < requestedChanges.length; changeIndex += 1) {\n    const requestedChange = requestedChanges[changeIndex];\n\n    if (!isOpenRequestedChange(requestedChange)) {\n      continue;\n    }\n\n    if (isCriticalRequestedChange(requestedChange)) {\n      openCriticalCount += 1;\n    } else if (isHighRiskRequestedChange(requestedChange)) {\n      openHighRiskCount += 1;\n    }\n  }\n\n  return {\n    sourceIndex,\n    contractNumber: compact(contract && contract.ContractNumber),\n    partyName: compact(contract && contract.PartyName),\n    openCriticalCount,\n    openHighRiskCount,\n    openCriticalOrHighRiskCount: openCriticalCount + openHighRiskCount\n  };\n}\n\nfunction buildContractSummary(items) {\n  const counts = [];\n  let itemIndex = 0;\n  let totalOpenCriticalCount = 0;\n  let totalOpenHighRiskCount = 0;\n\n  for (itemIndex = 0; itemIndex < items.length; itemIndex += 1) {\n    const row = contractSummaryCounts(items[itemIndex], itemIndex);\n    counts.push(row);\n    totalOpenCriticalCount += row.openCriticalCount;\n    totalOpenHighRiskCount += row.openHighRiskCount;\n  }\n\n  const ranked = counts\n    .filter(function (row) {\n      return row.openCriticalOrHighRiskCount > 0;\n    })\n    .sort(function (left, right) {\n      return right.openCriticalCount - left.openCriticalCount\n        || right.openHighRiskCount - left.openHighRiskCount\n        || left.sourceIndex - right.sourceIndex;\n    });\n\n  return {\n    totalVisibleContracts: items.length,\n    contractsWithOpenCriticalOrHighRiskCount: ranked.length,\n    totalOpenCriticalCount,\n    totalOpenHighRiskCount,\n    hasOpenCriticalOrHighRisk: ranked.length > 0,\n    hasOpenCritical: totalOpenCriticalCount > 0,\n    hasOpenHighRisk: totalOpenHighRiskCount > 0,\n    topContracts: ranked.slice(0, 3).map(function (row, index) {\n      return {\n        rank: index + 1,\n        contractNumber: row.contractNumber,\n        partyName: row.partyName,\n        openCriticalCount: row.openCriticalCount,\n        openHighRiskCount: row.openHighRiskCount,\n        openCriticalOrHighRiskCount: row.openCriticalOrHighRiskCount\n      };\n    })\n  };\n}\n\nfunction buildPanelSummaryFromItems(items) {\n  const ranked = [];\n  let hasOpenCritical = false;\n  let hasOpenHighRisk = false;\n  let itemIndex = 0;\n\n  for (itemIndex = 0; itemIndex < items.length; itemIndex += 1) {\n    const row = contractSummaryCounts(items[itemIndex], itemIndex);\n    if (row.openCriticalCount > 0) {\n      hasOpenCritical = true;\n    }\n    if (row.openHighRiskCount > 0) {\n      hasOpenHighRisk = true;\n    }\n    if (row.openCriticalOrHighRiskCount > 0) {\n      ranked.push(row);\n    }\n  }\n\n  ranked.sort(function (left, right) {\n    return right.openCriticalCount - left.openCriticalCount\n      || right.openHighRiskCount - left.openHighRiskCount\n      || left.sourceIndex - right.sourceIndex;\n  });\n\n  return {\n    hasOpenCriticalOrHighRisk: ranked.length > 0,\n    hasOpenCritical,\n    hasOpenHighRisk,\n    topContracts: ranked.slice(0, 3).map(function (row, index) {\n      return {\n        rank: index + 1,\n        contractNumber: row.contractNumber,\n        partyName: row.partyName,\n        openCriticalCount: row.openCriticalCount,\n        openHighRiskCount: row.openHighRiskCount\n      };\n    })\n  };\n}\n\nfunction buildPanelSummary(summary) {\n  const topContracts = asArray(summary && summary.topContracts).map(function (row) {\n    return {\n      rank: row.rank,\n      contractNumber: compact(row.contractNumber),\n      openCriticalCount: Number(row.openCriticalCount || 0),\n      openHighRiskCount: Number(row.openHighRiskCount || 0)\n    };\n  });\n\n  return {\n    hasOpenCriticalOrHighRisk: Boolean(summary && summary.hasOpenCriticalOrHighRisk),\n    hasOpenCritical: Boolean(summary && summary.hasOpenCritical),\n    hasOpenHighRisk: Boolean(summary && summary.hasOpenHighRisk),\n    topContracts\n  };\n}\n\nfunction buildDisplayRow(contract) {\n  return {\n    ContractNumber: compact(contract && contract.ContractNumber),\n    Description: compact(contract && contract.Description),\n    PartyName: compact(contract && contract.PartyName),\n    Assignee: compact(contract && (contract.Assignee || contract.assignee)),\n    AssignedDate: compact(contract && contract.AssignedDate),\n    ContractId: compact(contract && contract.ContractId),\n    SeverityBadgeText: compact(contract && contract.SeverityBadgeText),\n    SeverityPriority: compact(contract && contract.SeverityPriority)\n  };\n}\n\nfunction buildListData(payload) {\n  const summarySource = payload.panelSummary || payload.summary || buildPanelSummaryFromItems(asArray(payload.items));\n\n  return {\n    items: asArray(payload.items).map(buildDisplayRow),\n    summary: buildPanelSummary(summarySource),\n    intent: payload.intent,\n    buyOrSellCode: payload.buyOrSellCode,\n    partyLabel: payload.partyLabel\n  };\n}\n\nfunction buildSummaryData(payload) {\n  return {\n    summary: payload.summary,\n    intent: payload.intent,\n    buyOrSellCode: payload.buyOrSellCode,\n    partyLabel: payload.partyLabel\n  };\n}\n\nif (batchOutputRaw && typeof batchOutputRaw === 'object') {\n  directOutput = batchOutputRaw;\n} else if (typeof batchOutputRaw === 'string') {\n  try {\n    parsedValue = JSON.parse(batchOutputRaw);\n  } catch (e) {\n    parsedValue = null;\n  }\n\n  if (parsedValue && typeof parsedValue === 'object') {\n    directOutput = parsedValue;\n  }\n}\n\nif (directOutput && Array.isArray(directOutput.items)) {\n  payload = directOutput;\n} else {\n  partsContainer = directOutput && typeof directOutput === 'object' ? directOutput : {};\n  parts = Array.isArray(partsContainer.parts) ? partsContainer.parts : [];\n\n  for (i = 0; i < parts.length; i += 1) {\n    partPayloadRaw = parts[i] && parts[i].payload;\n    partPayloadObject = null;\n\n    if (partPayloadRaw && typeof partPayloadRaw === 'object') {\n      partPayloadObject = partPayloadRaw;\n    } else if (typeof partPayloadRaw === 'string') {\n      try {\n        parsedValue = JSON.parse(partPayloadRaw);\n      } catch (e) {\n        parsedValue = null;\n      }\n\n      if (parsedValue && typeof parsedValue === 'object') {\n        partPayloadObject = parsedValue;\n      }\n    }\n\n    if (parts[i] && parts[i].id === 'contractListSelectedFields' && partPayloadObject) {\n      payload = partPayloadObject;\n      break;\n    }\n  }\n\n  if (!payload) {\n    for (i = 0; i < parts.length; i += 1) {\n      partPayloadRaw = parts[i] && parts[i].payload;\n      partPayloadObject = null;\n\n      if (partPayloadRaw && typeof partPayloadRaw === 'object') {\n        partPayloadObject = partPayloadRaw;\n      } else if (typeof partPayloadRaw === 'string') {\n        try {\n          parsedValue = JSON.parse(partPayloadRaw);\n        } catch (e) {\n          parsedValue = null;\n        }\n\n        if (parsedValue && typeof parsedValue === 'object') {\n          partPayloadObject = parsedValue;\n        }\n      }\n\n      if (partPayloadObject) {\n        payload = partPayloadObject;\n        break;\n      }\n    }\n  }\n}\n\nif (payload && typeof payload === 'object') {\n  const sourcePayloadItems = Array.isArray(payload.items) ? payload.items : [];\n  const payloadItems = sourcePayloadItems.filter((item) => {\n    const accessLevel = String(item && item.AccessLevel !== null && item.AccessLevel !== undefined ? item.AccessLevel : '')\n      .trim()\n      .toUpperCase();\n    return accessLevel === 'UPDATE';\n  });\n  const sanitizedItems = [];\n  let itemIndex = 0;\n\n  for (itemIndex = 0; itemIndex < payloadItems.length; itemIndex += 1) {\n    const sourceItem = payloadItems[itemIndex];\n\n    if (sourceItem && typeof sourceItem === 'object') {\n      const targetItem = Array.isArray(sourceItem) ? [] : {};\n      const stack = [{ source: sourceItem, target: targetItem }];\n\n      while (stack.length > 0) {\n        const frame = stack.pop();\n        const sourceNode = frame.source;\n        const targetNode = frame.target;\n\n        if (Array.isArray(sourceNode)) {\n          let arrIndex = 0;\n\n          for (arrIndex = 0; arrIndex < sourceNode.length; arrIndex += 1) {\n            const arrValue = sourceNode[arrIndex];\n\n            if (arrValue && typeof arrValue === 'object') {\n              const arrChild = Array.isArray(arrValue) ? [] : {};\n              targetNode.push(arrChild);\n              stack.push({ source: arrValue, target: arrChild });\n            } else {\n              targetNode.push(arrValue);\n            }\n          }\n        } else {\n          const objectKeys = Object.keys(sourceNode);\n          let keyIndex = 0;\n\n          for (keyIndex = 0; keyIndex < objectKeys.length; keyIndex += 1) {\n            const objectKey = objectKeys[keyIndex];\n\n            if (keysToDrop.has(objectKey)) {\n              continue;\n            }\n\n            const objectValue = sourceNode[objectKey];\n\n            if (objectValue && typeof objectValue === 'object') {\n              const objectChild = Array.isArray(objectValue) ? [] : {};\n              targetNode[objectKey] = objectChild;\n              stack.push({ source: objectValue, target: objectChild });\n            } else {\n              targetNode[objectKey] = objectValue;\n            }\n          }\n        }\n      }\n\n      canonicalizeSeverityFields(targetItem);\n      sanitizedItems.push(targetItem);\n    } else {\n      sanitizedItems.push(sourceItem);\n    }\n  }\n\n  normalizedPayload = {\n    items: sanitizedItems,\n    intent,\n    buyOrSellCode,\n    partyLabel\n  };\n}\n\nconst normalizedItems = asArray(normalizedPayload.items);\nconst normalizedMessageHint = normalizeToken(messageHint);\n\nif (normalizedMessageHint === \"SUMMARY\") {\n  normalizedPayload.summary = buildContractSummary(normalizedItems);\n  return {\n    summaryData: buildSummaryData(normalizedPayload)\n  };\n}\n\nif (normalizedMessageHint === \"INITDISPLAY\") {\n  normalizedPayload.panelSummary = buildPanelSummaryFromItems(normalizedItems);\n  return {\n    listData: buildListData(normalizedPayload)\n  };\n}\n\nnormalizedPayload.summary = buildContractSummary(normalizedItems);\n\nreturn {\n  listData: buildListData(normalizedPayload),\n  summaryData: buildSummaryData(normalizedPayload)\n};"
          },
          "outcomes": {
            "success": "1776607143060"
          },
          "code": "NORMALIZE_CONTRACT_FIELDS_FROM_BATCH",
