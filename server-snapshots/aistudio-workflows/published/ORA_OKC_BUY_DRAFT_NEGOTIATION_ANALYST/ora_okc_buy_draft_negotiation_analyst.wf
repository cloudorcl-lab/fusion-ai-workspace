        {
          "metadata": {
            "name": "prepare businessplan names query",
            "returnType": "array",
            "sourceCode": "const llmOutput = $context.$nodes.CONTRUCT_QUERY_NODE.$output || {};\nconst businessUnitNames = Array.isArray(llmOutput.businessUnitNames)\n  ? llmOutput.businessUnitNames\n  : [];\n\nfunction escapeFusionString(value) {\n  return String(value || \"\").replace(/'/g, \"''\");\n}\n\nconst uniqueNames = [];\nconst seen = new Set();\nlet i = 0;\nlet name = \"\";\nlet key = \"\";\nlet inList = \"\";\nlet path = \"\";\nlet result = { parts: [] };\n\nfor (i = 0; i < businessUnitNames.length; i += 1) {\n  name = String(\n    businessUnitNames[i] !== null && businessUnitNames[i] !== undefined\n      ? businessUnitNames[i]\n      : \"\"\n  ).trim();\n\n  if (!name) {\n    continue;\n  }\n\n  key = name.toLowerCase();\n  if (seen.has(key)) {\n    continue;\n  }\n\n  seen.add(key);\n  uniqueNames.push(name);\n}\n\nif (uniqueNames.length > 0) {\n  inList = uniqueNames\n    .map((value) => escapeFusionString(value))\n    .map((value) => `'${value}'`)\n    .join(\",\");\n\n  path = `/finBusinessUnitsLOV?onlyData=true&fields=BusinessUnitId,BusinessUnitName&q=BusinessUnitName in (${inList})`;\n\n  result = [\n    {\n      id: \"buLookup\",\n      path,\n      operation: \"get\"\n    }\n  ];\n}\n\nreturn result;"
          },
