        },
        {
          "id": "1776607143069",
          "code": "PARSE_PREVIEW_ACTION_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Parse Preview Action Context",
            "returnType": "object",
            "sourceCode": "const app = $context.$app || {};\nconst rawAction = app.$OraAction;\nconst rawAppContext = app.$OraAppContext;\n\nfunction compact(value) {\n  return String(value === null || value === undefined ? '' : value).trim();\n}\n\nfunction parseObjectIfJson(value) {\n  if (value && typeof value === 'object' && !Array.isArray(value)) {\n    return value;\n  }\n\n  if (typeof value !== 'string') {\n    return {};\n  }\n\n  function parseCandidate(text, depth) {\n    const trimmed = String(text || '').trim();\n    if (!trimmed || depth > 3) {\n      return null;\n    }\n\n    try {\n      const parsed = JSON.parse(trimmed);\n      if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {\n        return parsed;\n      }\n\n      if (typeof parsed === 'string') {\n        return parseCandidate(parsed, depth + 1);\n      }\n    } catch (e) {\n      // Try a conservative unescape below for object strings such as {\\\"contractId\\\":\\\"123\\\"}.\n    }\n\n    if (trimmed.indexOf('\\\\\"') !== -1 && /^\\s*\\{/.test(trimmed)) {\n      const unescaped = trimmed.replace(/\\\\\"/g, '\"');\n      if (unescaped !== trimmed) {\n        return parseCandidate(unescaped, depth + 1);\n      }\n    }\n\n    return null;\n  }\n\n  return parseCandidate(value, 0) || {};\n}\n\nconst action = parseObjectIfJson(rawAction);\nconst appContext = parseObjectIfJson(rawAppContext);\nconst contractId = compact(action.contractId || action.ContractId || appContext.contractId || appContext.ContractId);\n\nreturn {\n  contractId,\n  rawAction,\n  rawAppContext\n};"
          },
          "outcomes": {
            "success": "1776607143071"
          },
          "inputs": [],
          "diagram": {
            "x": 6125,
            "y": 5912
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1778000001001",
          "code": "PARSE_QUERY_UI_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Parse Query UI Context",
            "returnType": "object",
            "sourceCode": "const app = $context.$app || {};\nconst system = $context.$system || {};\n\nfunction compact(value) {\n  return String(value === null || value === undefined ? '' : value)\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nfunction parseObjectIfJson(value) {\n  if (value && typeof value === 'object' && !Array.isArray(value)) {\n    return value;\n  }\n\n  if (typeof value !== 'string') {\n    return {};\n  }\n\n  const trimmed = value.trim();\n  if (!trimmed) {\n    return {};\n  }\n\n  try {\n    const parsed = JSON.parse(trimmed);\n    if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {\n      return parsed;\n    }\n  } catch (e) {\n    return {};\n  }\n\n  return {};\n}\n\nfunction cellText(value) {\n  if (value && typeof value === 'object' && !Array.isArray(value)) {\n    return compact(value.text || value.label || value.value || value.displayValue || value.name || '');\n  }\n\n  return compact(value);\n}\n\nfunction normalizeIntent(value) {\n  const token = compact(value).toLowerCase();\n  if (token === 's' || token.indexOf('sell') !== -1 || token.indexOf('customer') !== -1 || token.indexOf('sales') !== -1) {\n    return 'sell';\n  }\n\n  return 'buy';\n}\n\nfunction recognizedPanel(panel) {\n  const token = compact(\n    (panel && panel.panelId ? panel.panelId : '') + ' ' +\n    (panel && panel.agentCode ? panel.agentCode : '') + ' ' +\n    (panel && panel.panelName ? panel.panelName : '')\n  ).toLowerCase();\n\n  return token.indexOf('buy') !== -1 ||\n    token.indexOf('procurement') !== -1 ||\n    token.indexOf('sell') !== -1 ||\n    token.indexOf('sales') !== -1 ||\n    token.indexOf('ora_okc_buy_draft_negotiation_analyst') !== -1 ||\n    token.indexOf('ora_okc_sell_draft_negotiation_analyst') !== -1;\n}\n\nfunction panelIntent(panel) {\n  const token = compact(\n    (panel && panel.panelId ? panel.panelId : '') + ' ' +\n    (panel && panel.agentCode ? panel.agentCode : '') + ' ' +\n    (panel && panel.panelName ? panel.panelName : '')\n  ).toLowerCase();\n\n  if (token.indexOf('sell') !== -1 || token.indexOf('sales') !== -1 || token.indexOf('ora_okc_sell_draft_negotiation_analyst') !== -1) {\n    return 'sell';\n  }\n\n  return 'buy';\n}\n\nfunction parseDrillDownAction(actionText) {\n  const text = compact(actionText);\n  const start = text.indexOf('{');\n  const end = text.lastIndexOf('}');\n  if (start === -1 || end <= start) {\n    return {};\n  }\n\n  const candidate = text.slice(start, end + 1).replace(/\\\\\"/g, '\"');\n  try {\n    const parsed = JSON.parse(candidate);\n    return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};\n  } catch (e) {\n    return {};\n  }\n}\n\nfunction buildColumnIndex(cols) {\n  const result = {};\n  let i = 0;\n  for (i = 0; i < cols.length; i += 1) {\n    const key = compact(cols[i]).toLowerCase();\n    if (key) {\n      result[key] = i;\n    }\n  }\n  return result;\n}\n\nfunction valueFor(cells, columnIndex, names) {\n  let i = 0;\n  for (i = 0; i < names.length; i += 1) {\n    const index = columnIndex[compact(names[i]).toLowerCase()];\n    if (index !== undefined && index !== null && index >= 0 && index < cells.length) {\n      return cellText(cells[index]);\n    }\n  }\n\n  return '';\n}\n\nconst uiContext = parseObjectIfJson(app.$OraUiContext);\nconst panels = Array.isArray(uiContext.panels) ? uiContext.panels : [];\nconst question = compact(system.$inputMessage || app.$message || app.message || '');\nconst visibleContracts = [];\nconst contractIds = [];\nconst seenContractIds = {};\n\nlet panelIndex = 0;\nfor (panelIndex = 0; panelIndex < panels.length; panelIndex += 1) {\n  const panel = panels[panelIndex] || {};\n  if (!recognizedPanel(panel)) {\n    continue;\n  }\n\n  const intentFromPanel = panelIntent(panel);\n  const partyColumn = intentFromPanel === 'sell' ? 'Customer' : 'Supplier';\n  const widgets = Array.isArray(panel.widgets) ? panel.widgets : [];\n  let widgetIndex = 0;\n\n  for (widgetIndex = 0; widgetIndex < widgets.length; widgetIndex += 1) {\n    const widget = widgets[widgetIndex] || {};\n    if (compact(widget.type).toLowerCase() !== 'multirecordwidget') {\n      continue;\n    }\n\n    const config = widget.config || {};\n    const cols = Array.isArray(config.cols) ? config.cols : [];\n    const widgetRowItems = Array.isArray(config['ro' + 'ws']) ? config['ro' + 'ws'] : [];\n    const columnIndex = buildColumnIndex(cols);\n    let rowIndex = 0;\n\n    for (rowIndex = 0; rowIndex < widgetRowItems.length; rowIndex += 1) {\n      const row = widgetRowItems[rowIndex] || {};\n      const cells = Array.isArray(row.cells) ? row.cells : [];\n      const actionPayload = parseDrillDownAction(row.drillDownAction);\n      const contractId = compact(actionPayload.contractId || actionPayload.ContractId || '');\n      const actionIntent = normalizeIntent(actionPayload.intent || actionPayload.Intent || actionPayload.buyOrSell || actionPayload.BuyOrSell || intentFromPanel);\n      const rowPartyColumn = actionIntent === 'sell' ? 'Customer' : 'Supplier';\n\n      if (contractId && !seenContractIds[contractId]) {\n        seenContractIds[contractId] = true;\n        contractIds.push(contractId);\n      }\n\n      visibleContracts.push({\n        rowOrder: visibleContracts.length,\n        panelIndex,\n        widgetIndex,\n        rowIndex,\n        panelId: compact(panel.panelId || ''),\n        panelName: compact(panel.panelName || ''),\n        agentCode: compact(panel.agentCode || ''),\n        intent: actionIntent,\n        partyLabel: rowPartyColumn,\n        contractId,\n        contractNumber: valueFor(cells, columnIndex, ['Contract', 'Contract Number', 'ContractNumber']),\n        description: valueFor(cells, columnIndex, ['Description']),\n        party: valueFor(cells, columnIndex, [rowPartyColumn, partyColumn, 'Supplier', 'Customer', 'Party']),\n        assignee: valueFor(cells, columnIndex, ['Assignee']),\n        severity: valueFor(cells, columnIndex, ['Severity']),\n        assignedSince: valueFor(cells, columnIndex, ['Assigned Since', 'AssignedDate', 'Assigned Date']),\n        drillDownAction: compact(row.drillDownAction || '')\n      });\n    }\n  }\n}\n\nlet hasBuyRows = false;\nlet hasSellRows = false;\nlet answerRowIndex = 0;\n\nfor (answerRowIndex = 0; answerRowIndex < visibleContracts.length; answerRowIndex += 1) {\n  if (visibleContracts[answerRowIndex].intent === 'sell') {\n    hasSellRows = true;\n  } else {\n    hasBuyRows = true;\n  }\n}\n\nconst includePanelLabel = hasBuyRows && hasSellRows;\nconst answerRows = [];\n\nfor (answerRowIndex = 0; answerRowIndex < visibleContracts.length; answerRowIndex += 1) {\n  const sourceRow = visibleContracts[answerRowIndex] || {};\n  answerRows.push({\n    displayOrder: answerRowIndex + 1,\n    contractNumber: compact(sourceRow.contractNumber),\n    description: compact(sourceRow.description),\n    partyLabel: compact(sourceRow.partyLabel),\n    party: compact(sourceRow.party),\n    assignee: compact(sourceRow.assignee),\n    severity: compact(sourceRow.severity),\n    assignedSince: compact(sourceRow.assignedSince),\n    panelLabel: includePanelLabel ? (sourceRow.intent === 'sell' ? 'Sales' : 'Procurement') : ''\n  });\n}\n\nreturn {\n  question,\n  answerRows,\n  visibleContracts,\n  contractIds,\n  visibleContractCount: visibleContracts.length,\n  contractIdCount: contractIds.length,\n  panelsInspected: panels.length,\n  emptyReason: visibleContracts.length === 0 ? 'No buy or sell contracts were found in OraUiContext.' : ''\n};"
          },
          "outcomes": {
            "success": "1778000001007"
          },
          "inputs": [],
          "diagram": {
            "x": 6575,
            "y": 5912
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1776607143064",
          "code": "CHECK_FILTER_POLICY_EMPTY",
          "type": "CODE",
          "metadata": {
            "name": "check filter policy empty",
            "returnType": "object",
            "sourceCode": "const policyOutput = $context.$nodes.GET_FILTER_POLICY.$output || {};\n\nfunction toTrimmedStringArray(value) {\n  if (Array.isArray(value)) {\n    return value\n      .map((item) => String(item !== null && item !== undefined ? item : '').trim())\n      .filter(Boolean);\n  }\n\n  if (typeof value === 'string') {\n    const trimmed = value.trim();\n    if (!trimmed) {\n      return [];\n    }\n\n    try {\n      const parsed = JSON.parse(trimmed);\n      if (Array.isArray(parsed)) {\n        return parsed\n          .map((item) => String(item !== null && item !== undefined ? item : '').trim())\n          .filter(Boolean);\n      }\n    } catch (e) {\n      // Fall through to treat as plain string.\n    }\n\n    return [trimmed];\n  }\n\n  return [];\n}\n\nconst fromFilterStrings = toTrimmedStringArray(policyOutput.filter_strings);\nconst fromFilterString = toTrimmedStringArray(policyOutput.filter_string);\nconst allFilters = fromFilterStrings.concat(fromFilterString).filter(Boolean);\n\nconst result = {\n  route: allFilters.length > 0 ? 'PROCEED' : 'SKIP_EMPTY'\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776607143065"
          },
          "inputs": [],
          "diagram": {
            "x": 5450,
            "y": 6134
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1776607143071",
          "code": "GET_CONTRACT_DOCUMENTS",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Get Contract Documents",
            "businessObjectCode": "ORA_CX_CONTRACTS_CONTRACTDETAIL",
            "functionName": "getContractDocuments"
          },
          "outcomes": {
            "success": "1776607143072"
          },
          "inputs": [
            {
              "id": "1776607143071_contractId",
              "name": "contractId",
              "type": "string",
              "value": "{{$context.$nodes.PARSE_PREVIEW_ACTION_CONTEXT.$output.result.contractId}}"
            }
          ],
          "diagram": {
            "x": 5900,
            "y": 6134
          },
          "outputSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"FileUrl\": { \"type\": \"string\" },\n          \"CreationDate\": { \"type\": \"string\" },\n          \"LastUpdateDate\": { \"type\": \"string\" },\n          \"links\": {\n            \"type\": \"array\",\n            \"items\": { \"type\": \"object\" }\n          }\n        }\n      }\n    },\n    \"count\": { \"type\": \"integer\" },\n    \"hasMore\": { \"type\": \"boolean\" },\n    \"limit\": { \"type\": \"integer\" },\n    \"offset\": { \"type\": \"integer\" },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"object\" }\n    }\n  }\n}"
        },
        {
          "id": "1778000001007",
          "code": "ANSWER_OR_ROUTE_QUERY_FROM_UI",
          "type": "LLM",
          "metadata": {
            "name": "Answer Or Route Query From UI",
            "prompt": "UI_ANSWER_ROWS:\n{{$context.$nodes.PARSE_QUERY_UI_CONTEXT.$output.result.answerRows}}\n\nUI_COUNTS:\nvisibleContractCount={{$context.$nodes.PARSE_QUERY_UI_CONTEXT.$output.result.visibleContractCount}}\ncontractIdCount={{$context.$nodes.PARSE_QUERY_UI_CONTEXT.$output.result.contractIdCount}}\nemptyReason={{$context.$nodes.PARSE_QUERY_UI_CONTEXT.$output.result.emptyReason}}\n\nUSER QUESTION:\n{{$context.$system.$inputMessage}}\n\nTASK:\nYou are the first-pass multilingual query router and friendly UI-data answerer for a contracts workspace.\n\nDecide whether the user's question can be fully answered from UI_ANSWER_ROWS only.\n\nIf UI_ANSWER_ROWS is sufficient:\n- Set route to \"ANSWER_FROM_UI_CONTEXT\".\n- Put the final user-facing answer in answer.\n- Answer in the same language as the user question.\n- Infer the requested operation from the question: lookup, filter, count, group, rank, compare, summarize, or list.\n- Infer grouping and filtering fields from the wording using the visible fields: contractNumber, description, partyLabel, party, assignee, severity, assignedSince, and panelLabel.\n- For count, group, rank, comparison, highest, maximum, largest, top, or \"most\" questions, compute from all relevant UI_ANSWER_ROWS and give the direct result with its count.\n- For list questions, provide the relevant list concisely and completely when the question calls for a list.\n- Keep the answer concise, relevant, and insight-focused: lead with the answer and avoid unnecessary detail.\n- Prefer one short sentence when possible.\n- Include only fields needed to answer the question.\n- Avoid verbose explanations, raw JSON, markdown tables, widgets, row-by-row detail, and process commentary.\n- Do not include raw labels such as \"Contract Number:\", \"Description:\", \"Panel Name:\", or \"Intent:\" unless the user explicitly asks for that exact field-by-field format.\n- Do not mention panelLabel unless it is non-empty and needed to distinguish Procurement versus Sales matches.\n- Never mention panelId, panelName, agentCode, intent, contractId, rowOrder, displayOrder, or drillDownAction.\n- Do not request child data for UI-only questions such as assignee, severity, supplier/customer, assigned since, panel, visible contract counts, visible contract lists, or UI-visible rankings/counts.\n\nFriendly answer examples:\n- Costco Wholesale Corp. has the most contracts (5): PC-2026-094, PC-2026-1209, ISP-08605-23R, PC-2026-102, and CN-20488.\n- There are 3 critical contracts visible.\n- SELL-1 is assigned to Blair.\n\nIf UI_ANSWER_ROWS is not sufficient because the question asks about child clause/deviation/requested-change/policy-issue data:\n- Set route to \"FETCH_CHILD_DATA\".\n- Leave answer empty.\n- Set childDataNeed to \"deviation_counts\" for counts, rankings, \"most\", totals, comparisons, or summaries over child deviations/requested changes/clauses.\n- Set childDataNeed to \"clause_details\" only when the user asks for clause names, issue details, requested-change details, policy issue details, or why/reason details.\n\nImportant:\n- The user may ask in any language. Classify by meaning, not by English keywords.\n- If there are no visible contracts or no contract IDs, set route to \"ANSWER_FROM_UI_CONTEXT\" and answer with a brief explanation in the user's language.\n- Preserve contract numbers, names, party names, assignee names, and dates exactly as data values.\n- Do not hardcode or depend on any specific question wording. Reason from the current user question and UI_ANSWER_ROWS.\n\nReturn strict JSON only with exactly these keys:\n{\n  \"route\": \"ANSWER_FROM_UI_CONTEXT\" | \"FETCH_CHILD_DATA\",\n  \"answer\": \"<final answer only when route is ANSWER_FROM_UI_CONTEXT, otherwise empty string>\",\n  \"answerLanguage\": \"<language of the user question>\",\n  \"childDataNeed\": \"none\" | \"deviation_counts\" | \"clause_details\",\n  \"reason\": \"<short internal reason>\"\n}"
          },
          "outcomes": {
            "success": "1778000001008"
          },
          "inputs": [
            {
              "id": "1778000001007_prompt",
              "name": "prompt",
              "type": "string",
              "value": "UI_ANSWER_ROWS:\n{{$context.$nodes.PARSE_QUERY_UI_CONTEXT.$output.result.answerRows}}\n\nUI_COUNTS:\nvisibleContractCount={{$context.$nodes.PARSE_QUERY_UI_CONTEXT.$output.result.visibleContractCount}}\ncontractIdCount={{$context.$nodes.PARSE_QUERY_UI_CONTEXT.$output.result.contractIdCount}}\nemptyReason={{$context.$nodes.PARSE_QUERY_UI_CONTEXT.$output.result.emptyReason}}\n\nUSER QUESTION:\n{{$context.$system.$inputMessage}}\n\nTASK:\nYou are the first-pass multilingual query router and friendly UI-data answerer for a contracts workspace.\n\nDecide whether the user's question can be fully answered from UI_ANSWER_ROWS only.\n\nIf UI_ANSWER_ROWS is sufficient:\n- Set route to \"ANSWER_FROM_UI_CONTEXT\".\n- Put the final user-facing answer in answer.\n- Answer in the same language as the user question.\n- Infer the requested operation from the question: lookup, filter, count, group, rank, compare, summarize, or list.\n- Infer grouping and filtering fields from the wording using the visible fields: contractNumber, description, partyLabel, party, assignee, severity, assignedSince, and panelLabel.\n- For count, group, rank, comparison, highest, maximum, largest, top, or \"most\" questions, compute from all relevant UI_ANSWER_ROWS and give the direct result with its count.\n- For list questions, provide the relevant list concisely and completely when the question calls for a list.\n- Keep the answer concise, relevant, and insight-focused: lead with the answer and avoid unnecessary detail.\n- Prefer one short sentence when possible.\n- Include only fields needed to answer the question.\n- Avoid verbose explanations, raw JSON, markdown tables, widgets, row-by-row detail, and process commentary.\n- Do not include raw labels such as \"Contract Number:\", \"Description:\", \"Panel Name:\", or \"Intent:\" unless the user explicitly asks for that exact field-by-field format.\n- Do not mention panelLabel unless it is non-empty and needed to distinguish Procurement versus Sales matches.\n- Never mention panelId, panelName, agentCode, intent, contractId, rowOrder, displayOrder, or drillDownAction.\n- Do not request child data for UI-only questions such as assignee, severity, supplier/customer, assigned since, panel, visible contract counts, visible contract lists, or UI-visible rankings/counts.\n\nFriendly answer examples:\n- Costco Wholesale Corp. has the most contracts (5): PC-2026-094, PC-2026-1209, ISP-08605-23R, PC-2026-102, and CN-20488.\n- There are 3 critical contracts visible.\n- SELL-1 is assigned to Blair.\n\nIf UI_ANSWER_ROWS is not sufficient because the question asks about child clause/deviation/requested-change/policy-issue data:\n- Set route to \"FETCH_CHILD_DATA\".\n- Leave answer empty.\n- Set childDataNeed to \"deviation_counts\" for counts, rankings, \"most\", totals, comparisons, or summaries over child deviations/requested changes/clauses.\n- Set childDataNeed to \"clause_details\" only when the user asks for clause names, issue details, requested-change details, policy issue details, or why/reason details.\n\nImportant:\n- The user may ask in any language. Classify by meaning, not by English keywords.\n- If there are no visible contracts or no contract IDs, set route to \"ANSWER_FROM_UI_CONTEXT\" and answer with a brief explanation in the user's language.\n- Preserve contract numbers, names, party names, assignee names, and dates exactly as data values.\n- Do not hardcode or depend on any specific question wording. Reason from the current user question and UI_ANSWER_ROWS.\n\nReturn strict JSON only with exactly these keys:\n{\n  \"route\": \"ANSWER_FROM_UI_CONTEXT\" | \"FETCH_CHILD_DATA\",\n  \"answer\": \"<final answer only when route is ANSWER_FROM_UI_CONTEXT, otherwise empty string>\",\n  \"answerLanguage\": \"<language of the user question>\",\n  \"childDataNeed\": \"none\" | \"deviation_counts\" | \"clause_details\",\n  \"reason\": \"<short internal reason>\"\n}"
            },
            {
              "id": "1778000001007_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "You classify multilingual contract workspace questions and answer immediately in a concise, insight-focused style when visible UI data is sufficient. Return strict JSON only."
            }
          ],
