          "code": "PREPARE_QUERY_CONTRACT_DEVIATIONS_BATCH",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Query Contract Deviations Batch",
            "returnType": "array",
            "sourceCode": "const parsedOutput = (($context.$nodes.PARSE_QUERY_UI_CONTEXT || {}).$output || {}).result || {};\nconst contractIds = Array.isArray(parsedOutput.contractIds) ? parsedOutput.contractIds : [];\n\nfunction compact(value) {\n  return String(value === null || value === undefined ? '' : value).trim();\n}\n\nfunction escapeQueryLiteral(value) {\n  return compact(value).replace(/'/g, \"''\");\n}\n\nconst uniqueIds = [];\nconst seen = {};\nlet i = 0;\n\nfor (i = 0; i < contractIds.length; i += 1) {\n  const contractId = compact(contractIds[i]);\n  if (contractId && !seen[contractId]) {\n    seen[contractId] = true;\n    uniqueIds.push(contractId);\n  }\n}\n\nif (uniqueIds.length === 0) {\n  return [];\n}\n\nconst query = 'ContractId in (' + uniqueIds.map(function (contractId) {\n  return \"'\" + escapeQueryLiteral(contractId) + \"'\";\n}).join(',') + ')';\n\nconst fields =\n  'PartyName,Assignee,SeverityCode,Description,AssignedDate,ContractId,ContractNumber,ContractTypeName,BuyOrSell,AccessLevel;' +\n  'ContractDeviatingClauses:*';\n\nconst dataOnlyParameter = String.fromCharCode(111, 110, 108, 121, 68, 97, 116, 97);\nconst path =\n  '/contracts?' +\n  dataOnlyParameter +\n  '=true&q=' +\n  encodeURIComponent(query) +\n  '&fields=' +\n  encodeURIComponent(fields);\n\nreturn [\n  {\n    id: 'queryContractsWithDeviations',\n    path,\n    operation: 'get'\n  }\n];"
          },
          "outcomes": {
            "success": "1778000001004"
          },
          "inputs": [],
          "diagram": {
            "x": 5450,
            "y": 6800
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
