        {
          "metadata": {
            "name": "Init Subtitle Contracts",
            "returnType": "string",
            "sourceCode": "const raw = $context.$app?.$OraUserContext;\nlet fullName = '';\nif (raw && typeof raw === 'object') {\n  fullName = String(raw.fullName || raw.displayName || raw.name || '');\n} else if (typeof raw === 'string') {\n  const trimmed = raw.trim();\n  if (trimmed) {\n    try {\n      const parsed = JSON.parse(trimmed);\n      if (parsed && typeof parsed === 'object') {\n        fullName = String(parsed.fullName || parsed.displayName || parsed.name || '');\n      } else {\n        fullName = trimmed;\n      }\n    } catch (e) {\n      fullName = trimmed;\n    }\n  }\n}\nreturn fullName;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "INIT_SUBTITLE_CONTRACTS",
          "id": "10",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
