          "metadata": {
            "name": "Build REST Query",
            "returnType": "object",
            "sourceCode": "const transformerOutput = $context.$nodes.CONTRUCT_QUERY_NODE.$output || {};\nconst realBuLookupOutput = (($context.$nodes.GET_ORGID_FOR_BUSINESSPLAN_NAMES || {}).$output) || {};\nconst emptyBuLookupOutput = ((($context.$nodes.RETURN_EMPTY_ORGID_FOR_BUSINESSPLAN_NAMES || {}).$output || {}).result) || {};\n\nfunction hasLookupParts(value) {\n  return value && typeof value === \"object\" && Array.isArray(value.parts);\n}\n\nconst buLookupOutput = hasLookupParts(realBuLookupOutput)\n  ? realBuLookupOutput\n  : (hasLookupParts(emptyBuLookupOutput) ? emptyBuLookupOutput : { parts: [] });\nconst intentOutput = (($context.$nodes.RESOLVE_CONTRACT_INTENT || {}).$output || {}).result || {};\nconst buyOrSellCode = intentOutput.buyOrSellCode === \"S\" ? \"S\" : \"B\";\nconst resolvedIntent = buyOrSellCode === \"S\" ? \"sell\" : \"buy\";\nconst partyLabel = resolvedIntent === \"sell\" ? \"Customer\" : \"Supplier\";\n\nfunction normalizeText(value) {\n  return String(value !== null && value !== undefined ? value : \"\")\n    .trim()\n    .replace(/\\s+/g, \" \")\n    .toLowerCase();\n}\n\nfunction hasSingleOuterWrapper(text) {\n  if (!text || text.length < 2) {\n    return false;\n  }\n\n  if (text[0] !== \"(\" || text[text.length - 1] !== \")\") {\n    return false;\n  }\n\n  let depth = 0;\n  for (let i = 0; i < text.length; i += 1) {\n    if (text[i] === \"(\") {\n      depth += 1;\n      continue;\n    }\n\n    if (text[i] === \")\") {\n      depth -= 1;\n\n      if (depth < 0) {\n        return false;\n      }\n\n      if (depth === 0 && i < text.length - 1) {\n        return false;\n      }\n    }\n  }\n\n  return depth === 0;\n}\n\nfunction isWordChar(ch) {\n  return /[A-Za-z0-9_]/.test(String(ch || \"\"));\n}\n\nfunction isLogicalOrAt(text, index) {\n  if (String(text || \"\").slice(index, index + 2).toLowerCase() !== \"or\") {\n    return false;\n  }\n\n  const prev = index > 0 ? text[index - 1] : \" \";\n  const next = index + 2 < text.length ? text[index + 2] : \" \";\n\n  return !isWordChar(prev) && !isWordChar(next);\n}\n\nfunction splitTopLevelOr(query) {\n  let text = String(query || \"\").trim();\n\n  while (hasSingleOuterWrapper(text)) {\n    text = text.slice(1, -1).trim();\n  }\n\n  const branches = [];\n  let depth = 0;\n  let segmentStart = 0;\n\n  for (let i = 0; i < text.length; i += 1) {\n    if (text[i] === \"(\") {\n      depth += 1;\n      continue;\n    }\n\n    if (text[i] === \")\" && depth > 0) {\n      depth -= 1;\n      continue;\n    }\n\n    if (depth === 0 && isLogicalOrAt(text, i)) {\n      branches.push(text.slice(segmentStart, i).trim());\n      segmentStart = i + 2;\n    }\n  }\n\n  branches.push(text.slice(segmentStart).trim());\n  return branches.filter(Boolean);\n}\n\nfunction normalizeBranch(query) {\n  let text = String(query || \"\").trim();\n\n  while (hasSingleOuterWrapper(text)) {\n    text = text.slice(1, -1).trim();\n  }\n\n  return text ? \"(\" + text + \")\" : \"\";\n}\n\nfunction hasAssignedDateCondition(query) {\n  return /\\bAssignedDate\\b/i.test(String(query || \"\"));\n}\n\nfunction hasAssigneeTypeCondition(query) {\n  return /\\bAssigneeType\\b/i.test(String(query || \"\"));\n}\n\nfunction addAssigneeTypeGuardToAssignedDatePredicates(query) {\n  let text = String(query || \"\").trim();\n\n  if (!hasAssignedDateCondition(text) || hasAssigneeTypeCondition(text)) {\n    return normalizeBranch(text);\n  }\n\n  while (hasSingleOuterWrapper(text)) {\n    text = text.slice(1, -1).trim();\n  }\n\n  const guardedText = text.replace(/\\bAssignedDate\\s*(<=|>=|=|<|>)\\s*\\'([^\\']*)\\'/gi, function (_match, operator, value) {\n    return \"(AssignedDate \" + operator + \" \\'\" + value + \"\\' and AssigneeType = \\'OKX_RESOURCE\\')\";\n  });\n\n  return normalizeBranch(guardedText);\n}\n\nfunction buildInitialQueryItems() {\n  const explicitItems = Array.isArray(transformerOutput.queryStrings)\n    ? transformerOutput.queryStrings\n    : [];\n\n  const normalizedExplicitItems = explicitItems\n    .map((item) => normalizeBranch(item))\n    .filter(Boolean);\n\n  if (normalizedExplicitItems.length > 0) {\n    return normalizedExplicitItems;\n  }\n\n  const legacyQuery = String(transformerOutput.queryString || \"\").trim();\n  if (!legacyQuery) {\n    return [];\n  }\n\n  return splitTopLevelOr(legacyQuery)\n    .map((item) => normalizeBranch(item))\n    .filter(Boolean);\n}\n\nconst initialQueryItems = buildInitialQueryItems();\n\nconst orgPlaceholders = Array.isArray(transformerOutput.orgPlaceholders)\n  ? transformerOutput.orgPlaceholders\n  : [];\n\nconst buLookupParts = Array.isArray(buLookupOutput.parts) ? buLookupOutput.parts : [];\nlet buLookupPart = null;\n\nfor (let i = 0; i < buLookupParts.length; i += 1) {\n  if (buLookupParts[i] && buLookupParts[i].id === \"buLookup\") {\n    buLookupPart = buLookupParts[i];\n    break;\n  }\n}\n\nif (!buLookupPart && buLookupParts.length > 0) {\n  buLookupPart = buLookupParts[0];\n}\n\nconst businessUnitRestRows =\n  buLookupPart && buLookupPart.payload && Array.isArray(buLookupPart.payload.items)\n    ? buLookupPart.payload.items\n    : [];\n\nconst businessUnitNameToId = new Map();\nfor (let i = 0; i < businessUnitRestRows.length; i += 1) {\n  const row = businessUnitRestRows[i] || {};\n  const normalizedName = normalizeText(row.BusinessUnitName);\n  const exactName = String(row.BusinessUnitName !== null && row.BusinessUnitName !== undefined ? row.BusinessUnitName : \"\").trim();\n  const businessUnitId = String(row.BusinessUnitId !== null && row.BusinessUnitId !== undefined ? row.BusinessUnitId : \"\").trim();\n\n  if (exactName && businessUnitId) {\n    businessUnitNameToId.set(exactName, businessUnitId);\n  }\n\n  if (normalizedName && businessUnitId) {\n    businessUnitNameToId.set(normalizedName, businessUnitId);\n  }\n}\n\nconst unresolvedTokens = new Set();\nconst queryItemsAfterBuFiltering = [];\n\nfor (let i = 0; i < initialQueryItems.length; i += 1) {\n  let itemQuery = initialQueryItems[i];\n  let hasUnresolvedTokenInItem = false;\n\n  for (let j = 0; j < orgPlaceholders.length; j += 1) {\n    const placeholderNameRaw = String(orgPlaceholders[j] && orgPlaceholders[j].name ? orgPlaceholders[j].name : \"\").trim();\n    const placeholderName = normalizeText(placeholderNameRaw);\n    const placeholderToken = String(\n      orgPlaceholders[j] && orgPlaceholders[j].placeholder ? orgPlaceholders[j].placeholder : \"\"\n    ).trim();\n\n    if (!placeholderToken || itemQuery.indexOf(placeholderToken) === -1) {\n      continue;\n    }\n\n    const orgId = businessUnitNameToId.get(placeholderNameRaw) || businessUnitNameToId.get(placeholderName);\n    if (orgId) {\n      itemQuery = itemQuery.replaceAll(placeholderToken, orgId);\n    } else {\n      unresolvedTokens.add(placeholderToken);\n      hasUnresolvedTokenInItem = true;\n    }\n  }\n\n  if (!hasUnresolvedTokenInItem) {\n    queryItemsAfterBuFiltering.push(itemQuery);\n  }\n}\n\nconst currentDateSource = String((($context || {}).$system || {}).$currentDateTime || \"\").trim();\nconst currentDateMatch = /^(\\d{4}-\\d{2}-\\d{2})/.exec(currentDateSource);\nconst currentDate = currentDateMatch ? currentDateMatch[1] : new Date().toISOString().slice(0, 10);\n\nconst dateMatch = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(currentDate);\nif (!dateMatch) {\n  throw new Error(\"currentDate must be in YYYY-MM-DD format\");\n}\n\nconst baseDate = new Date(\n  Date.UTC(\n    Number(dateMatch[1]),\n    Number(dateMatch[2]) - 1,\n    Number(dateMatch[3])\n  )\n);\n\nfunction formatAdfDateTimeFromYmd(ymd) {\n  return String(ymd || \"\").slice(0, 10) + \"T00:00:00.000+00:00\";\n}\n\nfunction formatAdfDateTime(date) {\n  return formatAdfDateTimeFromYmd(date.toISOString().slice(0, 10));\n}\n\nconst currentDateTimeLiteral = formatAdfDateTimeFromYmd(currentDate);\n\nconst queryItemsAfterDateResolution = queryItemsAfterBuFiltering.map((queryItem) => {\n  let nextQuery = String(queryItem || \"\");\n\n  if (nextQuery.indexOf(\"__TODAY_PLUS_\") !== -1) {\n    throw new Error(\"Future AssignedDate placeholders are not allowed\");\n  }\n\n  nextQuery = addAssigneeTypeGuardToAssignedDatePredicates(nextQuery);\n\n  nextQuery = nextQuery.replaceAll(\"__TODAY__\", currentDateTimeLiteral);\n  nextQuery = nextQuery.replaceAll(\"__CURRENT_DATE__\", currentDateTimeLiteral);\n\n  nextQuery = nextQuery.replace(/__TODAY_MINUS_(\\d+)_DAYS__/g, function (_match, daysText) {\n    const days = Number(daysText);\n    const tempDate = new Date(baseDate.getTime());\n    tempDate.setUTCDate(tempDate.getUTCDate() - days);\n    return formatAdfDateTime(tempDate);\n  });\n\n  nextQuery = nextQuery.replace(/\\bAssignedDate\\s*(=|<=|>=|<|>)\\s*'((?:\\d{4}-\\d{2}-\\d{2})(?!T))'/g, function (_match, operator, ymd) {\n    return \"AssignedDate \" + operator + \" '\" + formatAdfDateTimeFromYmd(ymd) + \"'\";\n  });\n\n  return normalizeBranch(nextQuery);\n}).filter(Boolean);\n\nconst llmQuery = queryItemsAfterDateResolution.join(\" or \");\nconst hasAdditionalQuery = llmQuery.trim().length > 0;\n\nconst baseQuery = \"BuyOrSell='\" + buyOrSellCode + \"' and StsCode in ('DRAFT','UNDER_AMENDMENT') and VersionType='C'\";\nconst finalQuery = hasAdditionalQuery\n  ? \"((\" + baseQuery + \") and (\" + llmQuery + \"))\"\n  : \"((\" + baseQuery + \"))\";\n\nconst unresolvedPlaceholderTokens = Array.from(unresolvedTokens);\nconst buLookupPartId = buLookupPart && buLookupPart.id ? String(buLookupPart.id) : \"\";\n\nconst finalResult = {\n  route: hasAdditionalQuery ? \"PROCEED\" : \"SKIP_DEFAULT_ONLY\",\n  rawQuery: finalQuery,\n  encodedQParam: \"q=\" + encodeURIComponent(finalQuery),\n  intent: resolvedIntent,\n  buyOrSellCode,\n  partyLabel,\n  debugStrings: [\n    \"initialQueryItems=\" + String(initialQueryItems.length),\n    \"queryItemsAfterBuFiltering=\" + String(queryItemsAfterBuFiltering.length),\n    \"queryItemsAfterDateResolution=\" + String(queryItemsAfterDateResolution.length),\n    \"droppedQueryItemsByUnresolvedBu=\" + String(initialQueryItems.length - queryItemsAfterBuFiltering.length),\n    \"hasAdditionalQuery=\" + String(hasAdditionalQuery),\n    \"defaultOnlyQueryDetected=\" + String(!hasAdditionalQuery),\n    \"orgPlaceholdersCount=\" + String(orgPlaceholders.length),\n    \"businessUnitLookupRowsCount=\" + String(businessUnitRestRows.length),\n    \"resolvedPlaceholders=\" + String(orgPlaceholders.length - unresolvedPlaceholderTokens.length),\n    \"unresolvedPlaceholders=\" + String(unresolvedPlaceholderTokens.length),\n    \"unresolvedTokens=\" + (unresolvedPlaceholderTokens.join(\",\") || \"<none>\"),\n    \"buLookupPartId=\" + (buLookupPartId || \"<none>\")\n  ]\n};\n\nreturn finalResult;"
