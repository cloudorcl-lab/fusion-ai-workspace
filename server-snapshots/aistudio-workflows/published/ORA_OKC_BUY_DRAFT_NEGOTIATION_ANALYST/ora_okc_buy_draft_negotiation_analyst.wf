            "sourceCode": "const router = (($context.$nodes.NORMALIZE_UI_QUERY_ROUTER || {}).$output || {}).result || {};\nconst answer = String(router.answer || '').trim();\n\nif (answer) {\n  return answer;\n}\n\nreturn 'I could not determine the answer from the visible contract rows.';"
          },
