            "name": "OrgCount",
            "returnType": "string",
            "sourceCode": "let OrgSwitch;\nlet OrgList = $context.$nodes.SEARCH_FOR_ORGANIZATIONS.$output?.items ?? [];\n\nif (OrgList.length === 0) {\n    OrgSwitch = 'NoOrg';\n} else if (OrgList.length === 1) {\n    OrgSwitch = 'SingleOrg';\n} else {\n    OrgSwitch = 'MultipleOrgs';\n}\nreturn OrgSwitch;"
          },
          "outcomes": {
            "success": "1773385876878"
          },
          "code": "ORGCOUNT",
          "id": "1773385843051",
          "inputs": [],
