            "sourceCode": "var result;\nvar collectorId = $context.$nodes.FETCH_COLLECTOR_ID.$output.result;\n\nvar analyticalView = {\n  \"analyticViews\": {\n    \"ReceivablesBalance\": {\n      \"module\": \"oraErpCoreReceivablesBilling\",\n      \"name\": \"ReceivablesBalance\",\n      \"measureAliases\": {\n        \"invoiceRemainingAmount\": \"invoiceRemainingAmount\"\n      },\n      \"dimensions\": {\n        \"customer\": {\n          \"customerHierarchy\": {\n            \"aliases\": {\n              \"$depth\": \"customerHierarchydepth\",\n              \"customerName\": \"customerName\",\n              \"customerAccountId\": \"customerAccountId\"\n            }\n          }\n        },\n        \"collector\": {\n          \"collectorHierarchy\": {\n            \"aliases\": {\n              \"$depth\": \"collectorHierarchydepth\",\n              \"customerCollectorId\": \"customerCollectorId\"\n            }\n          }\n        },\n        \"invoiceCurrency\": {\n          \"invoiceCurrencyHierarchy\": {\n            \"aliases\": {\n              \"$depth\": \"invoiceCurrencyHierarchydepth\",\n              \"currencyCode\": \"currencyCode\"\n            }\n          }\n        }\n      },\n      \"filter\": \" ((invoiceCurrency.invoiceCurrencyHierarchy.$depth IN (1))) AND ((customer.customerHierarchy.$depth IN (1)))\"\n    }\n  },\n  \"viewQueries\": {},\n  \"return\": [\n    { \"name\": \"TOTALOPENBALANCE\" },\n    { \"name\": \"CUSTOMERACCOUNTID\" },\n    { \"name\": \"CUSTOMERNAME\" },\n    { \"name\": \"TOTALOPENBALANCECURRENCY\" }\n  ],\n  \"select\": \"SELECT TOTALOPENBALANCE, CUSTOMERACCOUNTID, CUSTOMERNAME, TOTALOPENBALANCECURRENCY FROM ( SELECT currencyCode AS TOTALOPENBALANCECURRENCY, invoiceRemainingAmount AS TOTALOPENBALANCE, customerAccountId AS CUSTOMERACCOUNTID, ReceivablesBalance.customerName AS CUSTOMERNAME, ROW_NUMBER() OVER ( PARTITION BY customerAccountId ORDER BY invoiceRemainingAmount DESC ) AS RN FROM ReceivablesBalance WHERE customerCollectorId = \" + collectorId + \" ) t WHERE 1 = 1 ORDER BY TOTALOPENBALANCE DESC\"\n};\n\nresult = JSON.stringify(analyticalView);\nreturn result;"
