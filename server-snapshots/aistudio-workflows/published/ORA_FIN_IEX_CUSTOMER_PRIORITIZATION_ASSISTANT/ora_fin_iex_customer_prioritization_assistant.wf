            "name": "Extract Customer Details",
            "returnType": "string",
            "sourceCode": "let suggestedAction = $context.$app.$OraAction;\n\nif (!suggestedAction) {\n  throw new Error(\"OraAction is empty\");\n}\n\nsuggestedAction = String(suggestedAction).trim();\n\nlet match = suggestedAction.match(/^<oraFormSubmit\\b[^>]*>\\s*([\\s\\S]*?)\\s*<\\/oraFormSubmit>$/i);\nif (match) {\n  return match[1].trim();\n}\n\nmatch = suggestedAction.match(/^ora\\.Agent\\(\\s*\"?[A-Za-z0-9_]+\"?\\s*,\\s*([\\s\\S]*)\\)\\s*$/);\nif (match) {\n  return match[1].trim();\n}\n\nmatch = suggestedAction.match(/^\"?[A-Za-z0-9_]+\"?\\s*,\\s*([\\s\\S]*)$/);\nif (match) {\n  return match[1].trim();\n}\n\nreturn null;"
