        {
          "metadata": {
            "errorNodeId": "1780612841595",
            "name": "Format Business Term Fields",
            "returnType": "object",
            "sourceCode": "const data =\n  Array.isArray($context.$nodes.REMOVE_COMMON?.$output?.result)\n    ? $context.$nodes.REMOVE_COMMON.$output.result\n    : Array.isArray($context.$nodes.REMOVE_COMMON?.$output)\n      ? $context.$nodes.REMOVE_COMMON.$output\n      : [];\n\nfunction isMoneyArray(value) {\n  return Array.isArray(value) &&\n    value.length > 0 &&\n    value.every(function (item) {\n      return item &&\n        typeof item === \"object\" &&\n        (\"amount\" in item) &&\n        (\"currency\" in item);\n    });\n}\n\nfunction formatCurrency(amount, currencyCode) {\n  amount = Number(amount || 0);\n\n  const fixed = amount.toFixed(2);\n  const parts = fixed.split(\".\");\n  let integerPart = parts[0];\n  const decimalPart = parts[1];\n\n  integerPart = integerPart.replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\");\n\n  return integerPart + \".\" + decimalPart;\n}\n\nfunction formatMoneyItem(item) {\n  const code = String(item.currency || \"\").toUpperCase();\n  const formatted = formatCurrency(item.amount);\n\n  return code\n    ? formatted + \" \" + code\n    : formatted;\n}\n\nconst formattedData = [];\n\nfor (let i = 0; i < data.length; i++) {\n  const record = data[i] || {};\n  const newRecord = {};\n\n  for (const key in record) {\n    if (!Object.prototype.hasOwnProperty.call(record, key)) continue;\n\n    const value = record[key];\n\n    if (isMoneyArray(value)) {\n      newRecord[key] = value\n        .map(function (item) {\n          if (key === \"AGINGBUCKETS\" && item.bucket) {\n            return item.bucket + \": \" + formatMoneyItem(item);\n          }\n    \n          return formatMoneyItem(item);\n        })\n        .join(\"; \");\n    } else {\n      newRecord[key] = value;\n    }\n  }\n\n  formattedData.push(newRecord);\n}\n\nreturn formattedData;"
