            "name": "Prepare Priority Rules",
            "returnType": "object",
            "sourceCode": "var priorityNode = $context.$nodes.PRIORITY_CATEGORIZATION_DATA;\nvar priorityData = getResultValue(priorityNode);\n\nvar priorityRules = [];\nif (priorityData && Array.isArray(priorityData.priorityCategorization)) {\n  priorityRules = priorityData.priorityCategorization;\n} else if (Array.isArray(priorityData)) {\n  priorityRules = priorityData;\n}\n\nvar neededMetricCodes = Object.create(null);\nfor (var i = 0; i < priorityRules.length; i++) {\n  collectMetricCodes(priorityRules[i], neededMetricCodes);\n}\n\nreturn {\n  priorityRules: priorityRules,\n  neededMetricCodes: neededMetricCodes\n};\n\nfunction getResultValue(node) {\n  if (!node || !node.$output) {\n    return null;\n  }\n\n  var out = node.$output;\n\n  if (out && out.result !== undefined) {\n    return out.result;\n  }\n\n  return out || null;\n}\n\nfunction collectMetricCodes(node, bucket) {\n  if (!node) {\n    return;\n  }\n\n  if (Array.isArray(node.rules)) {\n    for (var i = 0; i < node.rules.length; i++) {\n      collectMetricCodes(node.rules[i], bucket);\n    }\n    return;\n  }\n\n  if (node.metric_code) {\n    bucket[String(node.metric_code)] = true;\n  }\n}"
          },
