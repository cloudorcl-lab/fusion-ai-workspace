            "name": "Merge with Currency Code",
            "returnType": "object",
            "sourceCode": "var customerMap = Object.create(null);\nvar customerIds = [];\n\ningestRows(\"HIGHEST_AMOUNT_PER_CUSTOMER_FOR_CONSOLIDATION\");\ningestRows(\"TOTAL_OPEN_BALANCE_EXTRACT\");\ningestRows(\"TOTAL_PAST_DUE_BALANCE_EXTRACT\");\ningestRows(\"FLATTEN_AGING_BUCKETS\");\n\nvar output = [];\n\nfor (var i = 0; i < customerIds.length; i++) {\n  output.push(customerMap[customerIds[i]]);\n}\n\nreturn output;\n\nfunction getRows(nodeName) {\n  var node = $context.$nodes[nodeName];\n\n  if (!node || !node.$output) {\n    return [];\n  }\n\n  var out = node.$output;\n\n  if (typeof out === \"string\") {\n    try {\n      out = JSON.parse(out);\n    } catch (e) {\n      return [];\n    }\n  }\n\n  if (Array.isArray(out)) {\n    return out;\n  }\n\n  return out.result ||\n    out.rows ||\n    out.data ||\n    out.items ||\n    out.body ||\n    out.value ||\n    out.records ||\n    [];\n}\n\nfunction ingestRows(nodeName) {\n  var rows = getRows(nodeName);\n\n  for (var i = 0; i < rows.length; i++) {\n    var row = rows[i];\n\n    if (!row) {\n      continue;\n    }\n\n    var customerAccountId = getCustomerAccountId(row);\n\n    if (\n      customerAccountId === undefined ||\n      customerAccountId === null ||\n      customerAccountId === \"\"\n    ) {\n      continue;\n    }\n\n    var idKey = String(customerAccountId);\n    var record = customerMap[idKey];\n\n    if (!record) {\n      record = {\n        CUSTOMERACCOUNTID: customerAccountId,\n        CUSTOMERNAME: row.CUSTOMERNAME || row.customerName || null,\n\n        TOTALOPENBALANCE: [],\n        TOTALPASTDUEBALANCE: [],\n        AGINGBUCKETS: []\n      };\n\n      customerMap[idKey] = record;\n      customerIds.push(idKey);\n    } else if (!record.CUSTOMERNAME && (row.CUSTOMERNAME || row.customerName)) {\n      record.CUSTOMERNAME = row.CUSTOMERNAME || row.customerName;\n    }\n\n    mergeRow(record, row, nodeName);\n    cleanupInternalFields(record);\n  }\n}\n\nfunction getCustomerAccountId(row) {\n  if (\n    row.CUSTOMERACCOUNTID !== undefined &&\n    row.CUSTOMERACCOUNTID !== null &&\n    row.CUSTOMERACCOUNTID !== \"\"\n  ) {\n    return row.CUSTOMERACCOUNTID;\n  }\n\n  if (\n    row.customerAccountId !== undefined &&\n    row.customerAccountId !== null &&\n    row.customerAccountId !== \"\"\n  ) {\n    return row.customerAccountId;\n  }\n\n  if (\n    row.__customerKey !== undefined &&\n    row.__customerKey !== null &&\n    row.__customerKey !== \"\"\n  ) {\n    return row.__customerKey;\n  }\n\n  return null;\n}\n\nfunction mergeRow(record, row, nodeName) {\n  if (nodeName === \"TOTAL_OPEN_BALANCE_EXTRACT\") {\n    addMoney(\n      record.TOTALOPENBALANCE,\n      row.TOTALOPENBALANCE,\n      row.TOTALOPENBALANCECURRENCY\n    );\n\n    copyNonConsolidatedFields(record, row);\n    return;\n  }\n\n  if (nodeName === \"TOTAL_PAST_DUE_BALANCE_EXTRACT\") {\n    addMoney(\n      record.TOTALPASTDUEBALANCE,\n      row.TOTALPASTDUEBALANCE,\n      row.TOTALPASTDUEBALANCECURRENCY\n    );\n\n    copyNonConsolidatedFields(record, row);\n    return;\n  }\n\n  if (nodeName === \"FLATTEN_AGING_BUCKETS\") {\n    addAgingBuckets(record, row);\n    copyNonConsolidatedFields(record, row);\n    return;\n  }\n\n  copyNonConsolidatedFields(record, row);\n}\n\nfunction addMoney(list, amount, currency) {\n  currency = normalizeCurrency(currency);\n\n  if (amount === undefined || amount === null || amount === \"\") {\n    return;\n  }\n\n  if (!currency) {\n    return;\n  }\n\n  amount = Number(amount);\n\n  if (isNaN(amount)) {\n    return;\n  }\n\n  for (var i = 0; i < list.length; i++) {\n    if (list[i].currency === currency) {\n      list[i].amount += amount;\n      return;\n    }\n  }\n\n  list.push({\n    amount: amount,\n    currency: currency\n  });\n}\n\nfunction addAgingBuckets(record, row) {\n  for (var key in row) {\n    if (!Object.prototype.hasOwnProperty.call(row, key)) {\n      continue;\n    }\n\n    var match = key.match(/^AGINGBUCKETS (.+) ([A-Z]{3}) AMOUNT$/);\n\n    if (!match) {\n      continue;\n    }\n\n    var bucket = match[1];\n    var currency = match[2];\n    var amount = Number(row[key] || 0);\n\n    if (isNaN(amount)) {\n      continue;\n    }\n\n    upsertAgingBucket(record.AGINGBUCKETS, bucket, amount, currency);\n  }\n}\n\nfunction upsertAgingBucket(list, bucket, amount, currency) {\n  currency = normalizeCurrency(currency);\n\n  if (!currency) {\n    return;\n  }\n\n  for (var i = 0; i < list.length; i++) {\n    if (\n      list[i].bucket === bucket &&\n      list[i].currency === currency\n    ) {\n      list[i].amount += amount;\n      return;\n    }\n  }\n\n  list.push({\n    bucket: bucket,\n    amount: amount,\n    currency: currency\n  });\n}\n\nfunction copyNonConsolidatedFields(record, row) {\n  for (var key in row) {\n    if (!Object.prototype.hasOwnProperty.call(row, key)) {\n      continue;\n    }\n\n    if (\n      key === \"CUSTOMERACCOUNTID\" ||\n      key === \"customerAccountId\" ||\n      key === \"CUSTOMERNAME\" ||\n      key === \"customerName\" ||\n      key === \"TOTALOPENBALANCE\" ||\n      key === \"TOTALOPENBALANCECURRENCY\" ||\n      key === \"TOTALPASTDUEBALANCE\" ||\n      key === \"TOTALPASTDUEBALANCECURRENCY\" ||\n      key.indexOf(\"AGINGBUCKETS \") === 0\n    ) {\n      continue;\n    }\n\n    record[key] = row[key];\n  }\n}\n\nfunction normalizeCurrency(value) {\n  var currency = String(value == null ? \"\" : value).trim().toUpperCase();\n\n  if (!currency || currency === \"COMMON\") {\n    return \"\";\n  }\n\n  return currency;\n}\n\nfunction cleanupInternalFields(record) {\n  delete record.__customerKey;\n  delete record.__metricKey;\n  delete record.__sourceNode;\n  delete record.__originalAmount;\n  delete record.__originalCurrency;\n  delete record.__targetCurrency;\n  delete record.__compareAmount;\n  delete record.__fxMissing;\n}"
          },
          "outcomes": {
            "success": "1778868369359"
          },
