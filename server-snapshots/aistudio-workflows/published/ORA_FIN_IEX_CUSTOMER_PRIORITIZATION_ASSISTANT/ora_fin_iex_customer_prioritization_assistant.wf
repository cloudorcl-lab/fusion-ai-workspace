            "sourceCode": "var policyCurrencyCode = getPolicyCurrency();\n\nvar data = getRows(\"MERGE_WITH_CURRENCY_CODE\");\nvar sourceNodeUsed = \"MERGE_WITH_CURRENCY_CODE\";\n\nif (!data.length) {\n  data = getRows(\"CONSOLIDATE_BUSINESS_TERMS\");\n  sourceNodeUsed = \"CONSOLIDATE_BUSINESS_TERMS\";\n}\n\nvar currencies = Object.create(null);\n\nfor (var i = 0; i < data.length; i++) {\n  scanKnownCurrencyFields(data[i] || {}, currencies);\n}\n\nvar allCurrencies = [];\n\nfor (var curr in currencies) {\n  if (Object.prototype.hasOwnProperty.call(currencies, curr)) {\n    allCurrencies.push(curr);\n  }\n}\n\nif (!allCurrencies.length && policyCurrencyCode) {\n  allCurrencies.push(policyCurrencyCode);\n}\n\nallCurrencies.sort();\n\nvar fxCurrencies = [];\n\nfor (var j = 0; j < allCurrencies.length; j++) {\n  if (allCurrencies[j] !== policyCurrencyCode) {\n    fxCurrencies.push(allCurrencies[j]);\n  }\n}\n\nreturn {\n  policyCurrencyCode: policyCurrencyCode,\n  currencies: allCurrencies,\n  fxCurrencies: fxCurrencies,\n  isMultiCurrencyInStructure: fxCurrencies.length > 0,\n  sourceNodeUsed: sourceNodeUsed,\n  scannedRowCount: data.length\n};\n\nfunction scanKnownCurrencyFields(row, bucket) {\n  scanMoneyArray(row.TOTALOPENBALANCE, bucket);\n  scanMoneyArray(row.TOTALPASTDUEBALANCE, bucket);\n  scanMoneyArray(row.AGINGBUCKETS, bucket);\n\n  addCurrency(bucket, row.TOTALOPENBALANCECURRENCY);\n  addCurrency(bucket, row.TOTALPASTDUEBALANCECURRENCY);\n  addCurrency(bucket, row.LARGEINVOICECURRENCY);\n  addCurrency(bucket, row.LARGESTOVERDUEBALCURRENCY);\n  addCurrency(bucket, row.UPCOMINGLARGEINVOICECURRENCY);\n  addCurrency(bucket, row.UPCOMINGLARGEDUEAMOUNTREMAININGCURRENCY);\n\n  scanConsolidatedAgingBucketCurrencyFields(row, bucket);\n}\n\nfunction scanMoneyArray(value, bucket) {\n  if (!Array.isArray(value) || !value.length) {\n    return;\n  }\n\n  for (var i = 0; i < value.length; i++) {\n    var item = value[i] || {};\n\n    addCurrency(\n      bucket,\n      item.currency ||\n      item.currencyCode ||\n      item.code ||\n      \"\"\n    );\n  }\n}\n\nfunction scanConsolidatedAgingBucketCurrencyFields(row, bucket) {\n  for (var key in row) {\n    if (!Object.prototype.hasOwnProperty.call(row, key)) {\n      continue;\n    }\n\n    var match = String(key).match(/^AGINGBUCKETS .+ ([A-Z]{3}) AMOUNT$/);\n\n    if (match) {\n      addCurrency(bucket, match[1]);\n    }\n  }\n}\n\nfunction addCurrency(bucket, value) {\n  var curr = normalizeCurrency(value);\n\n  if (!curr) {\n    return;\n  }\n\n  bucket[curr] = true;\n}\n\nfunction getRows(nodeName) {\n  var node = $context.$nodes[nodeName];\n\n  if (!node || !node.$output) {\n    return [];\n  }\n\n  var out = node.$output;\n\n  if (typeof out === \"string\") {\n    try {\n      out = JSON.parse(out);\n    } catch (e) {\n      return [];\n    }\n  }\n\n  if (Array.isArray(out)) return out;\n  if (out && Array.isArray(out.result)) return out.result;\n  if (out && Array.isArray(out.rows)) return out.rows;\n  if (out && Array.isArray(out.data)) return out.data;\n  if (out && Array.isArray(out.items)) return out.items;\n  if (out && Array.isArray(out.body)) return out.body;\n  if (out && Array.isArray(out.value)) return out.value;\n  if (out && Array.isArray(out.records)) return out.records;\n\n  return [];\n}\n\nfunction getPolicyCurrency() {\n  var node = $context.$nodes.CURRENCY_CODE_FROM_POLICY_DATA;\n  var output = node && node.$output ? node.$output : null;\n  var raw = output && output.result !== undefined ? output.result : output;\n\n  if (typeof raw === \"string\") {\n    return normalizeCurrency(raw);\n  }\n\n  if (raw && typeof raw === \"object\") {\n    return normalizeCurrency(\n      raw.currencyCode ||\n      raw.code ||\n      raw.value ||\n      raw.result ||\n      raw.currency ||\n      \"\"\n    );\n  }\n\n  return \"\";\n}\n\nfunction normalizeCurrency(value) {\n  var curr = String(value == null ? \"\" : value).trim().toUpperCase();\n\n  if (!curr || curr === \"COMMON\") {\n    return \"\";\n  }\n\n  if (!/^[A-Z]{3}$/.test(curr)) {\n    return \"\";\n  }\n\n  return curr;\n}"
