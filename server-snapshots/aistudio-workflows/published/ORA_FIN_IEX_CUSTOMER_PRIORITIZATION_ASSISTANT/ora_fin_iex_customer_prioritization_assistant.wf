        {
          "metadata": {
            "name": "Largest Overdue Balance Data",
            "returnType": "object",
            "sourceCode": "var result;\nvar collectorId = $context.$nodes.FETCH_COLLECTOR_ID.$output.result;\n\nvar extractionView = {\n  \"viewQueries\": {\n    \"recPaySchedule\": {\n      \"module\": \"oraErpCoreReceivablesBilling\",\n      \"businessObject\": \"ReceivablesTransactionPaymentSchedule\",\n      \"view\": \"receivablesPaymentSchedule\",\n      \"fieldAliases\": {\n        \"transactionNumber\": \"transactionNumber\",\n        \"amountRemaining\": \"amountRemaining\",\n        \"originalAmount\": \"originalAmount\",\n        \"overdueFlag\": \"overdueFlag\",\n        \"installmentDueDate\": \"installmentDueDate\",\n        \"customerAccount.customer.registryId\": \"partyNumber\",\n        \"customerAccount.customerAccountId\": \"customerAccountId\",\n        \"customerAccount.customer.name\": \"customerName\",\n        \"customerAccount.accountNumber\": \"accountNumber\",\n        \"customerAccount.customerAccountProfile.collector.collectorId\": \"collectorId\",\n        \"customerAccount.customerAccountProfile.collector.name\": \"collectorName\",\n        \"invoiceCurrency.currencyCode\": \"currency\"\n      }\n    }\n  },\n  \"select\": \"SELECT CUSTOMERACCOUNTID, CUSTOMERNAME, PARTYNUMBER, ACCOUNTNUMBER, COLLECTORNAME, CURRENCY AS LARGESTOVERDUEBALCURRENCY, INSTALLMENTDUEDATE AS LARGESTOVERDUEBALDUEDATE, TRANSACTIONNUMBER AS LARGESTOVERDUEBALTRANSACTIONNUMBER, AMOUNTREMAINING AS LARGESTOVERDUEBALAMOUNTREMAINING, ORIGINALAMOUNT AS LARGESTOVERDUEINVOICE FROM ( SELECT CUSTOMERACCOUNTID, CUSTOMERNAME, PARTYNUMBER, ACCOUNTNUMBER, COLLECTORNAME, CURRENCY, INSTALLMENTDUEDATE, TRANSACTIONNUMBER, AMOUNTREMAINING, ORIGINALAMOUNT, ROW_NUMBER() OVER (PARTITION BY CUSTOMERACCOUNTID, CURRENCY ORDER BY AMOUNTREMAINING DESC, TRANSACTIONNUMBER) AS RN FROM RECPAYSCHEDULE WHERE COLLECTORID = \" + collectorId + \" AND OVERDUEFLAG = 'Y' AND AMOUNTREMAINING > 0) T WHERE RN = 1 ORDER BY LARGESTOVERDUEBALAMOUNTREMAINING DESC\"\n};\n\nresult = JSON.stringify(extractionView);\nreturn result;"
