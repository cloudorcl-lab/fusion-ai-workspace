          "metadata": {
            "errorNodeId": "1780612841595",
            "name": "Dynamic Sorting",
            "returnType": "object",
            "sourceCode": "const multiCurrencyData =\n  Array.isArray($context.$nodes.NORMALIZE_CURRENCY_FOR_MULTI_CURRENCY?.$output?.result)\n    ? $context.$nodes.NORMALIZE_CURRENCY_FOR_MULTI_CURRENCY.$output.result\n    : Array.isArray($context.$nodes.NORMALIZE_CURRENCY_FOR_MULTI_CURRENCY?.$output)\n      ? $context.$nodes.NORMALIZE_CURRENCY_FOR_MULTI_CURRENCY.$output\n      : [];\n\nconst singleCurrencyData =\n  Array.isArray($context.$nodes.NORMALIZE_CURRENCY_FOR_SINGLE_CURRENCY?.$output?.result)\n    ? $context.$nodes.NORMALIZE_CURRENCY_FOR_SINGLE_CURRENCY.$output.result\n    : Array.isArray($context.$nodes.NORMALIZE_CURRENCY_FOR_SINGLE_CURRENCY?.$output)\n      ? $context.$nodes.NORMALIZE_CURRENCY_FOR_SINGLE_CURRENCY.$output\n      : [];\n\nconst data = [\n  ...multiCurrencyData,\n  ...singleCurrencyData\n];\n\nconst orderBy =\n  $context.$nodes.DYNAMIC_SORTING_ORDERING_DATA.$output.result || [];\n\nif (!Array.isArray(data)) {\n  throw new Error(\"data must be an array\");\n}\n\nif (!Array.isArray(orderBy) || orderBy.length === 0) {\n  return data.slice();\n}\n\nfunction getComparableValue(record, field) {\n\n  const commonField =\n    field + \"COMMON\";\n\n  // Prefer normalized/common value\n  if (\n    record[commonField] !== null &&\n    record[commonField] !== undefined\n  ) {\n    return record[commonField];\n  }\n\n  // fallback\n  if (\n    record[field] !== null &&\n    record[field] !== undefined\n  ) {\n    return record[field];\n  }\n\n  return null;\n}\n\nconst sorted = data.slice();\n\nsorted.sort((a, b) => {\n\n  for (let i = 0; i < orderBy.length; i++) {\n\n    const {\n      field,\n      direction = \"asc\"\n    } = orderBy[i] || {};\n\n    if (!field) {\n      continue;\n    }\n\n    const sign =\n      String(direction).toLowerCase() === \"desc\"\n        ? -1\n        : 1;\n\n    let aVal =\n      getComparableValue(a, field);\n\n    let bVal =\n      getComparableValue(b, field);\n\n    const aMissing =\n      aVal === null ||\n      aVal === undefined;\n\n    const bMissing =\n      bVal === null ||\n      bVal === undefined;\n\n    if (aMissing && bMissing) {\n      continue;\n    }\n\n    if (aMissing) {\n      return 1;\n    }\n\n    if (bMissing) {\n      return -1;\n    }\n\n    aVal = Number(aVal);\n    bVal = Number(bVal);\n\n    if (\n      Number.isNaN(aVal) &&\n      Number.isNaN(bVal)\n    ) {\n      continue;\n    }\n\n    if (Number.isNaN(aVal)) {\n      return 1;\n    }\n\n    if (Number.isNaN(bVal)) {\n      return -1;\n    }\n\n    if (aVal < bVal) {\n      return -1 * sign;\n    }\n\n    if (aVal > bVal) {\n      return 1 * sign;\n    }\n\n  }\n\n  return String(a.customerAccountId || a.CUSTOMERACCOUNTID || \"\")\n  .localeCompare(String(b.customerAccountId || b.CUSTOMERACCOUNTID || \"\"));\n\n});\n\nreturn sorted;"
