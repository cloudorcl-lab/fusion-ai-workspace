          "metadata": {
            "errorNodeId": "1780612415695",
            "name": "Extract Policy Document ID",
            "returnType": "string",
            "sourceCode": "const documentIdStr = $context.$nodes.GET_POLICY_DOCUMENT_NAME.$output.items[0].DocumentId;\n\nconst documentIds = documentIdStr\n  .split(',')\n  .map(id => Number(id.trim()))\n  .filter(id => !isNaN(id));\n\n// Get the latest (assuming the highest ID is the latest)\nconst latestDocumentId = Math.max(...documentIds);\n\nreturn latestDocumentId;"
