        {
          "metadata": {
            "errorNodeId": "1780612841595",
            "name": "Remove Completed NBA",
            "returnType": "object",
            "sourceCode": "var assignOutput = $context.$nodes.ASSIGN_NEXT_BEST_ACTIONS_TO_CUSTOMERS_WITHOUT_COMPLETED_TASK_REMOVAL.$output || {};\nvar customers = getArray(assignOutput);\n\nvar recentTasksOutput = $context.$nodes.FIN_IEX_BO_EXECUTE_PAYLOAD_TO_GET_COLLECTOR_RECENT_TASKS.$output || {};\nvar recentTasksData = getArray(recentTasksOutput);\n\nvar recentTaskMap = {};\nbuildRecentTaskMap(recentTasksData);\n\nvar result = [];\n\nfor (var i = 0; i < customers.length; i++) {\n  var customer = customers[i] || {};\n  var accountId = customer.customerAccountId || customer.CUSTOMERACCOUNTID;\n  var existingTaskCodes = recentTaskMap[accountId] || {};\n  var actions = Array.isArray(customer.primaryActions) ? customer.primaryActions : [];\n  var filteredActions = [];\n\n  for (var a = 0; a < actions.length; a++) {\n    var actionObj = actions[a] || {};\n    var actionCode = String(actionObj.code || \"\").toUpperCase();\n\n    if (actionCode && existingTaskCodes[actionCode]) {\n      continue;\n    }\n\n    filteredActions.push(actionObj);\n  }\n\n  if (filteredActions.length === 0) {\n    continue;\n  }\n\n  var outputRecord = Object.assign({}, customer);\n  outputRecord.primaryActions = filteredActions;\n  result.push(outputRecord);\n}\n\nreturn {\n  customers: result,\n  totalCustomers: result.length\n};\n\nfunction getArray(output) {\n  if (!output) {\n    return [];\n  }\n\n  if (typeof output === \"string\") {\n    try {\n      output = JSON.parse(output);\n    } catch (e) {\n      return [];\n    }\n  }\n\n  if (Array.isArray(output)) {\n    return output;\n  }\n\n  if (Array.isArray(output.result)) {\n    return output.result;\n  }\n\n  if (Array.isArray(output.customers)) {\n    return output.customers;\n  }\n\n  if (output.result && Array.isArray(output.result.customers)) {\n    return output.result.customers;\n  }\n\n  if (output.body && Array.isArray(output.body.customers)) {\n    return output.body.customers;\n  }\n\n  if (output.data && Array.isArray(output.data.customers)) {\n    return output.data.customers;\n  }\n\n  return [];\n}\n\nfunction buildRecentTaskMap(recentTasksData) {\n  for (var i = 0; i < recentTasksData.length; i++) {\n    var recentTask = recentTasksData[i] || {};\n    var recentAccountId = recentTask.CUSTOMERACCOUNTID || recentTask.customerAccountId;\n    var recentTaskCode = recentTask.TASKCODE || recentTask.taskCode || \"\";\n\n    if (!recentAccountId || !recentTaskCode) {\n      continue;\n    }\n\n    if (!recentTaskMap[recentAccountId]) {\n      recentTaskMap[recentAccountId] = {};\n    }\n\n    recentTaskMap[recentAccountId][String(recentTaskCode).toUpperCase()] = true;\n  }\n}"
