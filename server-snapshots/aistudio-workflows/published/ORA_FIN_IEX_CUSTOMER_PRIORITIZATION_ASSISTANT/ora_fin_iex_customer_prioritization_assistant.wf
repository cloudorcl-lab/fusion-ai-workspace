        {
          "metadata": {
            "errorNodeId": "1780612841595",
            "name": "Assign Next Best Actions to Customers without Completed Task Removal",
            "returnType": "object",
            "sourceCode": "var data = $context.$nodes.DYNAMIC_SORTING.$output.result || [];\nvar rulesData = $context.$nodes.NEXT_BEST_ACTION_RULE_DATA.$output.result || [];\nvar emailMessagesOutput = $context.$nodes.FIN_IEX_BO_EXECUTE_PAYLOAD_TO_FETCH_EMAIL_MESSAGES.$output || [];\nvar emailMessages = Array.isArray(emailMessagesOutput) ? emailMessagesOutput : (emailMessagesOutput.result || []);\n\nvar rules = [];\nif (Array.isArray(rulesData)) {\n  if (rulesData[0] && Array.isArray(rulesData[0].nextBestActions)) {\n    rules = rulesData[0].nextBestActions;\n  } else {\n    rules = rulesData;\n  }\n} else if (rulesData && Array.isArray(rulesData.nextBestActions)) {\n  rules = rulesData.nextBestActions;\n}\n\nvar result = [];\nvar emailActionMap = {};\n\nbuildEmailActionMap(emailMessages);\n\nfunction getMetricValue(record, metricCode) {\n  var candidates = [\n    metricCode,\n    metricCode + \"COMMON\"\n  ];\n\n  if (String(metricCode).indexOf(\"TOTAL\") !== 0) {\n    candidates.push(\"TOTAL\" + metricCode);\n    candidates.push(\"TOTAL\" + metricCode + \"COMMON\");\n  } else {\n    var stripped = String(metricCode).replace(/^TOTAL/i, \"\");\n    if (stripped) {\n      candidates.push(stripped);\n      candidates.push(stripped + \"COMMON\");\n    }\n  }\n\n  for (var i = 0; i < candidates.length; i++) {\n    var key = candidates[i];\n    if (record[key] !== null && record[key] !== undefined) {\n      var raw = record[key];\n      if (Array.isArray(raw)) {\n        return raw.reduce(function (sum, item) {\n          var value = item && item.convertedAmount !== undefined ? item.convertedAmount : item && item.amount;\n          return sum + Number(value || 0);\n        }, 0);\n      }\n      return raw;\n    }\n  }\n\n  return 0;\n}\n\nfunction evaluateCondition(record, cond) {\n  var recordValue = Number(getMetricValue(record, cond.metric_code));\n  var matched = false;\n  var conditionLabel = \"\";\n\n  if (!isNaN(recordValue)) {\n    if (cond.operator === \"between\") {\n      var min = Number(cond.value[0]);\n      var max = Number(cond.value[1]);\n      if (!isNaN(min) && !isNaN(max)) {\n        matched = recordValue >= min && recordValue <= max;\n        conditionLabel = \"between \" + min + \" AND \" + max;\n      }\n    } else {\n      var ruleValue = Number(cond.value);\n      if (!isNaN(ruleValue)) {\n        if (cond.operator === \">\") matched = recordValue > ruleValue;\n        else if (cond.operator === \"<\") matched = recordValue < ruleValue;\n        else if (cond.operator === \">=\") matched = recordValue >= ruleValue;\n        else if (cond.operator === \"<=\") matched = recordValue <= ruleValue;\n        else if (cond.operator === \"==\") matched = recordValue === ruleValue;\n        conditionLabel = cond.operator + \" \" + ruleValue;\n      }\n    }\n  }\n\n  var conditionObj = null;\n  if (matched) {\n    conditionObj = {};\n    conditionObj[cond.metric_code] = conditionLabel;\n  }\n\n  return {\n    matched: matched,\n    conditions: conditionObj ? [conditionObj] : []\n  };\n}\n\nfunction evaluateRuleNode(record, node) {\n  if (!node) {\n    return { matched: false, conditions: [] };\n  }\n\n  if (Array.isArray(node.rules)) {\n    var childResults = [];\n    var matchedConditions = [];\n\n    for (var i = 0; i < node.rules.length; i++) {\n      var childResult = evaluateRuleNode(record, node.rules[i]);\n      childResults.push(childResult.matched);\n      if (childResult.matched) {\n        matchedConditions = matchedConditions.concat(childResult.conditions);\n      }\n    }\n\n    var logic = String(node.logic || \"AND\").toUpperCase();\n    var matched = logic === \"OR\"\n      ? childResults.some(Boolean)\n      : childResults.every(Boolean);\n\n    return {\n      matched: matched,\n      conditions: matched ? matchedConditions : []\n    };\n  }\n\n  return evaluateCondition(record, node);\n}\n\nfunction buildEmailActionMap(emailMessages) {\n  for (var em = 0; em < emailMessages.length; em++) {\n    var emailMessage = emailMessages[em] || {};\n    var emailAccountId = emailMessage.CUSTOMERACCOUNTID || emailMessage.customerAccountId;\n\n    if (!emailAccountId) {\n      continue;\n    }\n\n    var requestData = emailMessage.REQUESTDATA || emailMessage.requestData || {};\n    if (typeof requestData === \"string\") {\n      try {\n        requestData = JSON.parse(requestData);\n      } catch (e) {\n        requestData = {};\n      }\n    }\n\n    var summary = requestData.summary || requestData.SUMMARY || {};\n    var messageId = emailMessage.MESSAGEID || emailMessage.messageId || \"\";\n    var intentCode = emailMessage.INTENTCODE || emailMessage.intentCode || \"\";\n    var intentMeaning = emailMessage.INTENTMEANING || emailMessage.intentMeaning || \"\";\n    var statusMeaning = emailMessage.STATUSMEANING || emailMessage.statusMeaning || \"\";\n    var summaryText = summary.summaryText || summary.SUMMARYTEXT || \"\";\n\n    var customerName = emailMessage.CUSTOMERNAME || emailMessage.customerName || \"\";\n    var customerAccountId = emailMessage.CUSTOMERACCOUNTID || emailMessage.customerAccountId || \"\";\n    var accountNumber = emailMessage.ACCOUNTNUMBER || emailMessage.accountNumber || \"\";\n    var siteName = emailMessage.SITENAME || emailMessage.siteName || \"\";\n    var siteUseId = emailMessage.SITEUSEID || emailMessage.siteUseId || \"\";\n    var partyId = emailMessage.PARTYID || emailMessage.partyId || \"\";\n    var customerMessageDetailId = emailMessage.CUSTOMERMESSAGEDETAILID || emailMessage.customerMessageDetailId || \"\";\n    var customerAccountSiteId = emailMessage.CUSTOMERACCOUNTSITEID || emailMessage.customerAccountSiteId || \"\";\n\n    var normalizedIntentCode = String(intentCode).toUpperCase();\n    var emailActionTitle = intentMeaning ? intentMeaning + \" (email)\" : \"Email Action\";\n    var emailActionText = \"\";\n\n    if (normalizedIntentCode === \"ORA_PROMISE_TO_PAY\") {\n      emailActionText = \"Record Promise to Pay\";\n    } else if (normalizedIntentCode === \"ORA_DISPUTE_REQUEST\") {\n      emailActionText = \"Create Dispute\";\n    } else if (normalizedIntentCode === \"ORA_PO_UPDATE\") {\n      emailActionText = \"Update Purchase order\";\n    } else if (normalizedIntentCode === \"ORA_INVOICE_REPRINT\") {\n      emailActionText = \"Resend Invoice\";\n    }\n\n    var followUpPayload = {\n      messageId: messageId,\n      intentCode: intentCode,\n      actionType: \"getDetails\"\n    };\n\n    var emailPriorityAction = {\n      title: emailActionTitle,\n      shortDescription: summaryText,\n      actionText: emailActionText || \"Email Action Pending\",\n      code: \"emailActions\",\n      additionalContext: {\n        customerName: customerName,\n        customerAccountId: customerAccountId,\n        accountNumber: accountNumber,\n        siteName: siteName,\n        siteUseId: siteUseId,\n        partyId: partyId,\n        intentCode: intentCode,\n        intentMeaning: intentMeaning,\n        statusMeaning: statusMeaning,\n        messageId: messageId,\n        customerMessageDetailId: customerMessageDetailId,\n        customerAccountSiteId: customerAccountSiteId,\n        summaryText: summaryText\n      },\n      followUpPayload: JSON.stringify(followUpPayload),\n      followUpCommand: \"ora.Agent(\\\"emailActions\\\", \" + JSON.stringify(followUpPayload) + \")\",\n      priority: true\n    };\n\n    if (!emailActionMap[emailAccountId]) {\n      emailActionMap[emailAccountId] = [];\n    }\n\n    emailActionMap[emailAccountId].push(emailPriorityAction);\n  }\n}\n\nfor (var i = 0; i < data.length; i++) {\n  var record = data[i] || {};\n  var accountId = record.customerAccountId || record.CUSTOMERACCOUNTID;\n  var matchedActions = [];\n  var matchedConditions = [];\n  var addedActionCodes = {};\n\n  for (var r = 0; r < rules.length; r++) {\n    var rule = rules[r] || {};\n    var conditionResult = evaluateRuleNode(record, rule);\n\n    if (!conditionResult.matched) {\n      continue;\n    }\n\n    for (var a = 0; a < (rule.nextBestAction || []).length; a++) {\n      var actionObj = rule.nextBestAction[a] || {};\n      var actionCode = String(actionObj.code || \"\").toUpperCase();\n\n      if (actionCode && addedActionCodes[actionCode]) {\n        continue;\n      }\n\n      matchedActions.push({\n        action: actionObj.label || \"\",\n        command: actionObj.invokeAction || \"defaultAction\",\n        code: actionObj.code || \"\",\n        description: actionObj.description || \"\"\n      });\n\n      if (actionCode) {\n        addedActionCodes[actionCode] = true;\n      }\n    }\n\n    matchedConditions = matchedConditions.concat(conditionResult.conditions);\n  }\n\n  if (emailActionMap[accountId] && emailActionMap[accountId].length > 0) {\n    matchedActions = emailActionMap[accountId].concat(matchedActions);\n  }\n\n  var outputRecord = Object.assign({}, record);\n  outputRecord._debugSortIndex = i;\n  outputRecord.primaryActions = matchedActions;\n  outputRecord.matchedConditions = matchedConditions;\n  result.push(outputRecord);\n}\n\nreturn result;"
          },
