            "sourceCode": "var sourceConfigs = [\n  {\n    node: \"TOTAL_OPEN_BALANCE_EXTRACT\",\n    amountField: \"TOTALOPENBALANCE\",\n    currencyField: \"TOTALOPENBALANCECURRENCY\"\n  },\n  {\n    node: \"TOTAL_PAST_DUE_BALANCE_EXTRACT\",\n    amountField: \"TOTALPASTDUEBALANCE\",\n    currencyField: \"TOTALPASTDUEBALANCECURRENCY\"\n  },\n  {\n    node: \"FLATTEN_AGING_BUCKETS\",\n    dynamicPrefix: \"AGINGBUCKETS \"\n  },\n  {\n    node: \"LARGE_OPEN_INVOICE_EXTRACT\",\n    amountField: \"LARGESTOPENINVOICE\",\n    currencyField: \"LARGEINVOICECURRENCY\"\n  },\n  {\n    node: \"LARGEST_OVERDUE_BALANCE_EXTRACT\",\n    amountField: \"LARGESTOVERDUEINVOICE\",\n    currencyField: \"LARGESTOVERDUEBALCURRENCY\"\n  },\n  {\n    node: \"UPCOMING_LARGE_DUE_INVOICE_EXTRACT\",\n    amountField: \"UPCOMINGLARGEINVOICE\",\n    currencyField: \"UPCOMINGLARGEINVOICECURRENCY\"\n  }\n];\n\nvar customerMap = Object.create(null);\n\nfor (var s = 0; s < sourceConfigs.length; s++) {\n  var cfg = sourceConfigs[s];\n  var rows = getRows(cfg.node);\n\n  for (var i = 0; i < rows.length; i++) {\n    var row = rows[i] || {};\n\n    var customerAccountId =\n      row.CUSTOMERACCOUNTID ||\n      row.customerAccountId ||\n      row.__customerKey ||\n      null;\n\n    if (!customerAccountId) {\n      continue;\n    }\n\n    var idKey = String(customerAccountId);\n    var record = customerMap[idKey];\n\n    if (!record) {\n      var customerName = row.CUSTOMERNAME || row.customerName || null;\n\n      record = {\n        CUSTOMERACCOUNTID: customerAccountId,\n        customerAccountId: customerAccountId,\n        CUSTOMERNAME: customerName,\n        customerName: customerName\n      };\n\n      customerMap[idKey] = record;\n    } else if (!record.CUSTOMERNAME && (row.CUSTOMERNAME || row.customerName)) {\n      var laterCustomerName = row.CUSTOMERNAME || row.customerName;\n      record.CUSTOMERNAME = laterCustomerName;\n      record.customerName = laterCustomerName;\n    }\n\n    if (\n      row.PARTYNUMBER !== undefined &&\n      row.PARTYNUMBER !== null &&\n      record.PARTYNUMBER === undefined\n    ) {\n      record.PARTYNUMBER = row.PARTYNUMBER;\n    }\n\n    if (\n      row.ACCOUNTNUMBER !== undefined &&\n      row.ACCOUNTNUMBER !== null &&\n      record.ACCOUNTNUMBER === undefined\n    ) {\n      record.ACCOUNTNUMBER = row.ACCOUNTNUMBER;\n    }\n\n    if (\n      row.COLLECTORNAME !== undefined &&\n      row.COLLECTORNAME !== null &&\n      record.COLLECTORNAME === undefined\n    ) {\n      record.COLLECTORNAME = row.COLLECTORNAME;\n    }\n\n    if (cfg.dynamicPrefix) {\n      copyPrefixedFields(record, row, cfg.dynamicPrefix);\n    } else if (cfg.amountField) {\n      copyAmountField(record, row, cfg.amountField);\n      copyCurrencyField(record, row, cfg.currencyField);\n      if (cfg.node === \"LARGE_OPEN_INVOICE_EXTRACT\") {\n        copyFieldIfPresent(record, row, \"CUSTOMERTRANSACTIONID\");\n      }\n    }\n  }\n}\n\nvar output = [];\nfor (var key in customerMap) {\n  if (Object.prototype.hasOwnProperty.call(customerMap, key)) {\n    output.push(customerMap[key]);\n  }\n}\n\nreturn output;\n\nfunction getRows(nodeName) {\n  var node = $context.$nodes[nodeName];\n\n  if (!node || !node.$output) {\n    return [];\n  }\n\n  var out = node.$output;\n\n  if (Array.isArray(out)) {\n    return out;\n  }\n\n  if (out && Array.isArray(out.result)) {\n    return out.result;\n  }\n\n  if (out && Array.isArray(out.rows)) {\n    return out.rows;\n  }\n\n  if (out && Array.isArray(out.data)) {\n    return out.data;\n  }\n\n  if (out && Array.isArray(out.items)) {\n    return out.items;\n  }\n\n  if (out && Array.isArray(out.body)) {\n    return out.body;\n  }\n\n  if (out && Array.isArray(out.value)) {\n    return out.value;\n  }\n\n  if (out && Array.isArray(out.records)) {\n    return out.records;\n  }\n\n  return [];\n}\n\nfunction copyAmountField(record, row, fieldName) {\n  if (!fieldName) {\n    return;\n  }\n\n  var value = row[fieldName];\n\n  if (value === undefined || value === null || value === \"\") {\n    return;\n  }\n\n  record[fieldName] = value;\n}\n\nfunction copyCurrencyField(record, row, fieldName) {\n  if (!fieldName) {\n    return;\n  }\n\n  var value = row[fieldName];\n\n  if (value === undefined || value === null || value === \"\") {\n    return;\n  }\n\n  record[fieldName] = value;\n}\n\nfunction copyPrefixedFields(record, row, prefix) {\n  for (var key in row) {\n    if (!Object.prototype.hasOwnProperty.call(row, key)) {\n      continue;\n    }\n\n    if (key.indexOf(prefix) !== 0) {\n      continue;\n    }\n\n    var value = row[key];\n\n    if (value === undefined || value === null || value === \"\") {\n      continue;\n    }\n\n    record[key] = value;\n  }\n}\n\nfunction copyFieldIfPresent(record, row, fieldName) {\n  if (\n    row[fieldName] !== undefined &&\n    row[fieldName] !== null &&\n    row[fieldName] !== \"\" &&\n    record[fieldName] === undefined\n  ) {\n    record[fieldName] = row[fieldName];\n  }\n}"
