            "name": "Normalize Currency for Multi Currency",
            "returnType": "object",
            "sourceCode": "var rows = getRows(\"CONVERT_TO_POLICY_CURRENCY\");\nvar output = [];\n\nfor (var i = 0; i < rows.length; i++) {\n  var record = rows[i] || {};\n  var out = Object.assign({}, record);\n\n  normalizeConvertedMoneyArray(\n    out,\n    \"TOTALOPENBALANCECONVERTED\",\n    \"TOTALOPENBALANCE\"\n  );\n\n  normalizeConvertedMoneyArray(\n    out,\n    \"TOTALPASTDUEBALANCECONVERTED\",\n    \"TOTALPASTDUEBALANCE\"\n  );\n\n  normalizeConvertedAgingBuckets(out);\n\n  normalizeScalarCurrencyFields(out);\n\n  delete out.TOTALOPENBALANCECONVERTED;\n  delete out.TOTALPASTDUEBALANCECONVERTED;\n  delete out.AGINGBUCKETSCONVERTED;\n\n  output.push(out);\n}\n\nreturn output;\n\nfunction normalizeConvertedMoneyArray(record, convertedKey, baseKey) {\n  var value = record[convertedKey];\n\n  if (!Array.isArray(value) || !value.length) {\n    return;\n  }\n\n  var total = 0;\n\n  for (var i = 0; i < value.length; i++) {\n    var item = value[i] || {};\n    total += toNumber(item.convertedAmount);\n  }\n\n  record[baseKey + \"COMMON\"] = total;\n  record[baseKey + \"CURRENCYCOMMON\"] = \"COMMON\";\n}\n\nfunction normalizeConvertedAgingBuckets(record) {\n  var value = record.AGINGBUCKETSCONVERTED;\n\n  if (!Array.isArray(value) || !value.length) {\n    return;\n  }\n\n  var bucketMap = Object.create(null);\n  var bucketOrder = [];\n  var total = 0;\n\n  for (var i = 0; i < value.length; i++) {\n    var item = value[i] || {};\n    var bucket = item.bucket || item.DAYSLATE || \"UNKNOWN\";\n    var amount = toNumber(item.convertedAmount);\n\n    total += amount;\n\n    if (!bucketMap[bucket]) {\n      bucketMap[bucket] = 0;\n      bucketOrder.push(bucket);\n    }\n\n    bucketMap[bucket] += amount;\n  }\n\n  if (bucketOrder.length === 1) {\n    record.AGINGBUCKETSBUCKETCOMMON = bucketOrder[0];\n  } else {\n    record.AGINGBUCKETSBUCKETCOMMON = bucketOrder.join(\", \");\n  }\n\n  record.AGINGBUCKETSCOMMON = total;\n  record.AGINGBUCKETSCURRENCYCOMMON = \"COMMON\";\n}\n\nfunction normalizeScalarCurrencyFields(record) {\n  var keys = Object.keys(record);\n\n  for (var j = 0; j < keys.length; j++) {\n    var currencyKey = keys[j];\n\n    if (currencyKey.indexOf(\"CURRENCY\") === -1) {\n      continue;\n    }\n\n    if (currencyKey.indexOf(\"COMMON\") !== -1) {\n      continue;\n    }\n\n    var currencyValue = record[currencyKey];\n\n    if (\n      currencyValue === undefined ||\n      currencyValue === null ||\n      currencyValue === \"\"\n    ) {\n      continue;\n    }\n\n    var amountKey = getAmountKeyFromCurrencyKey(currencyKey, record);\n\n    if (!amountKey) {\n      continue;\n    }\n\n    var amountValue = record[amountKey];\n\n    if (\n      amountValue === undefined ||\n      amountValue === null ||\n      amountValue === \"\"\n    ) {\n      continue;\n    }\n\n    record[amountKey + \"COMMON\"] = toNumber(amountValue);\n    record[amountKey + \"CURRENCYCOMMON\"] = currencyValue;\n  }\n}\n\nfunction getAmountKeyFromCurrencyKey(currencyKey, record) {\n  currencyKey = String(currencyKey || \"\");\n\n  var knownPairs = {\n    LARGEINVOICECURRENCY: \"LARGEINVOICEORIGINALAMOUNT\",\n    LARGESTOVERDUEBALCURRENCY: \"LARGESTOVERDUEBALAMOUNTREMAINING\",\n    UPCOMINGLARGEDUEAMOUNTREMAININGCURRENCY: \"UPCOMINGLARGEDUEAMOUNTREMAINING\",\n    UPCOMINGLARGEINVOICECURRENCY: \"UPCOMINGLARGEINVOICE\"\n  };\n\n  if (\n    knownPairs[currencyKey] &&\n    record[knownPairs[currencyKey]] !== undefined &&\n    record[knownPairs[currencyKey]] !== null &&\n    record[knownPairs[currencyKey]] !== \"\"\n  ) {\n    return knownPairs[currencyKey];\n  }\n\n  if (currencyKey.indexOf(\" CURRENCY\") !== -1) {\n    return currencyKey.replace(\" CURRENCY\", \" AMOUNT\");\n  }\n\n  if (endsWith(currencyKey, \"CURRENCY\")) {\n    return currencyKey.slice(0, currencyKey.length - \"CURRENCY\".length);\n  }\n\n  return \"\";\n}\n\nfunction getRows(nodeName) {\n  var node = $context.$nodes[nodeName];\n\n  if (!node || !node.$output) {\n    return [];\n  }\n\n  var out = node.$output;\n\n  if (typeof out === \"string\") {\n    try {\n      out = JSON.parse(out);\n    } catch (e) {\n      return [];\n    }\n  }\n\n  if (Array.isArray(out)) return out;\n  if (out && Array.isArray(out.result)) return out.result;\n  if (out && Array.isArray(out.rows)) return out.rows;\n  if (out && Array.isArray(out.data)) return out.data;\n  if (out && Array.isArray(out.items)) return out.items;\n  if (out && Array.isArray(out.body)) return out.body;\n  if (out && Array.isArray(out.value)) return out.value;\n  if (out && Array.isArray(out.records)) return out.records;\n\n  return [];\n}\n\nfunction toNumber(value) {\n  if (value === null || value === undefined || value === \"\") {\n    return 0;\n  }\n\n  var n = Number(value);\n  return isFinite(n) ? n : 0;\n}\n\nfunction endsWith(value, suffix) {\n  value = String(value || \"\");\n  suffix = String(suffix || \"\");\n\n  if (suffix.length > value.length) {\n    return false;\n  }\n\n  return value.slice(value.length - suffix.length) === suffix;\n}"
