            "name": "Assign Next Best Actions to Customers",
            "returnType": "object",
            "sourceCode": "const data =\n  $context.$nodes.FORMAT_BUSINESS_TERM_FIELDS?.$output?.result ||\n  $context.$nodes.FORMAT_BUSINESS_TERM_FIELDS?.$output ||\n  [];\n\n\nfunction addCompatibilityAliases(record) {\n  copyAlias(record, \"CUSTOMERACCOUNTID\", \"customerAccountId\");\n  copyAlias(record, \"CUSTOMERNAME\", \"customerName\");\n  copyAlias(record, \"PARTYNUMBER\", \"partyNumber\");\n  copyAlias(record, \"ACCOUNTNUMBER\", \"accountNumber\");\n  copyAlias(record, \"COLLECTORNAME\", \"collectorName\");\n  copyAlias(record, \"CUSTOMERTRANSACTIONID\", \"customerTransactionId\");\n}\n\nfunction copyAlias(record, upperKey, lowerKey) {\n  if (\n    record &&\n    record[lowerKey] === undefined &&\n    record[upperKey] !== undefined &&\n    record[upperKey] !== null &&\n    record[upperKey] !== \"\"\n  ) {\n    record[lowerKey] = record[upperKey];\n  }\n}\nfunction formatAmount(value) {\n  var num = Number(value);\n\n  if (!Number.isFinite(num)) {\n    return value;\n  }\n\n  var fixed = num.toFixed(2);\n  var parts = fixed.split(\".\");\n\n  var integerPart = parts[0];\n  var decimalPart = parts[1];\n\n  integerPart = integerPart.replace(\n    /\\B(?=(\\d{3})+(?!\\d))/g,\n    \",\"\n  );\n\n  return integerPart + \".\" + decimalPart;\n}\n\nconst currencyFieldMap = {\n  TOTALOPENBALANCE: \"TOTALOPENBALANCECURRENCY\",\n  TOTALPASTDUEBALANCE: \"TOTALPASTDUEBALANCECURRENCY\",\n  LARGESTOPENINVOICE: \"LARGEINVOICECURRENCY\",\n  LARGESTOVERDUEINVOICE: \"LARGESTOVERDUEBALCURRENCY\",\n  LARGESTOVERDUEBALAMOUNTREMAINING: \"LARGESTOVERDUEBALCURRENCY\",\n  UPCOMINGLARGEINVOICE: \"UPCOMINGLARGEINVOICECURRENCY\",\n  UPCOMINGLARGEDUEAMOUNTREMAINING: \"UPCOMINGLARGEINVOICECURRENCY\"\n};\n\nconst formattedData = [];\n\nfor (let i = 0; i < data.length; i++) {\n  const record = data[i] || {};\n  addCompatibilityAliases(record);\n  const newRecord = {};\n\n  for (const key in record) {\n    if (!Object.prototype.hasOwnProperty.call(record, key)) {\n      continue;\n    }\n\n    const value = record[key];\n\n    if (\n      typeof value === \"number\" &&\n      currencyFieldMap[key]\n    ) {\n      const currencyCode =\n        String(record[currencyFieldMap[key]] || \"USD\").toUpperCase();\n\n      newRecord[key] =\n        formatAmount(value) +\n        \" \" +\n        currencyCode;\n    } else {\n      newRecord[key] = value;\n    }\n  }\n\n  formattedData.push(newRecord);\n}\nvar currencySymbolPattern = /[\\u0024\\u00A2-\\u00A5\\u058F\\u060B\\u07FE\\u07FF\\u09F2\\u09F3\\u09FB\\u0AF1\\u0BF9\\u0E3F\\u17DB\\u20A0-\\u20BF\\uA838\\uFDFC\\uFE69\\uFF04\\uFFE0\\uFFE1\\uFFE5\\uFFE6]/g;\nvar sanitizedOutput = JSON.stringify(formattedData).replace(currencySymbolPattern, \"\");\nreturn JSON.parse(sanitizedOutput);"
          },
