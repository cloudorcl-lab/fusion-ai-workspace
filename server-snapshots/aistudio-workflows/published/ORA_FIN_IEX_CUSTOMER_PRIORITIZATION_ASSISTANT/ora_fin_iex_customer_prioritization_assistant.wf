        {
          "metadata": {
            "errorNodeId": "1780612612159",
            "name": "Detect Currencies for Conversion",
            "returnType": "object",
            "sourceCode": "var datasetCodes = [\n  \"LARGE_OPEN_INVOICE_EXTRACT\",\n  \"LARGEST_OVERDUE_BALANCE_EXTRACT\",\n  \"UPCOMING_LARGE_DUE_INVOICE_EXTRACT\"\n];\n\nfunction getPolicyCurrency() {\n  var raw = $context.$nodes.CURRENCY_CODE_FROM_POLICY_DATA &&\n            $context.$nodes.CURRENCY_CODE_FROM_POLICY_DATA.$output &&\n            $context.$nodes.CURRENCY_CODE_FROM_POLICY_DATA.$output.result;\n\n  if (typeof raw === \"string\") {\n    return raw.trim().toUpperCase();\n  }\n\n  if (raw && typeof raw === \"object\") {\n    return String(\n      raw.currencyCode ||\n      raw.code ||\n      raw.value ||\n      raw.result ||\n      raw.currency ||\n      \"\"\n    ).trim().toUpperCase();\n  }\n\n  return \"\";\n}\n\nfunction getRows(code) {\n  var node = $context.$nodes[code];\n  var output = node ? node.$output : null;\n\n  if (!output) return [];\n\n  if (Array.isArray(output.result)) return output.result;\n  if (Array.isArray(output)) return output;\n\n  return [];\n}\n\nfunction findCurrency(row) {\n  for (var key in row) {\n    if (!Object.prototype.hasOwnProperty.call(row, key)) {\n      continue;\n    }\n\n    if (String(key).toLowerCase().indexOf(\"curr\") !== -1) {\n      return row[key];\n    }\n  }\n\n  return null;\n}\n\nvar policyCurrencyCode = getPolicyCurrency();\nvar currencies = {};\nvar i, j, row, curr;\n\nfor (i = 0; i < datasetCodes.length; i++) {\n  var rows = getRows(datasetCodes[i]);\n\n  for (j = 0; j < rows.length; j++) {\n    row = rows[j] || {};\n\n    curr = findCurrency(row);\n\n    if (curr) {\n      currencies[\n        String(curr).trim().toUpperCase()\n      ] = true;\n    }\n  }\n}\n\nvar allCurrencies = Object.keys(currencies);\nallCurrencies.sort();\n\nvar fxCurrencies = [];\n\nfor (i = 0; i < allCurrencies.length; i++) {\n  if (allCurrencies[i] !== policyCurrencyCode) {\n    fxCurrencies.push(allCurrencies[i]);\n  }\n}\n\nreturn {\n  policyCurrencyCode: policyCurrencyCode,\n  currencies: allCurrencies,\n  fxCurrencies: fxCurrencies,\n\n  // Existing flag\n  needsFx: fxCurrencies.length > 0,\n\n  // New flags\n  hasMultipleCurrencies: allCurrencies.length > 1,\n  hasForeignCurrencies: fxCurrencies.length > 0\n};"
          },
          "outcomes": {
            "success": "1780544113441"
          },
          "diagram": {
            "x": 6803.5,
            "y": 11086
          },
          "code": "DETECT_CURRENCIES_FOR_CONVERSION",
          "id": "1780523183558",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
