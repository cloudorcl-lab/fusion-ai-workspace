        {
          "metadata": {
            "errorNodeId": "1780612841595",
            "name": "Assign Priority to Customers",
            "returnType": "array",
            "sourceCode": "var preparedNode = $context.$nodes.PREPARE_PRIORITY_RULES;\nvar customersNode = $context.$nodes.REMOVE_COMPLETED_NBA;\n\nvar prepared = getResultValue(preparedNode) || {};\nvar customers = getResultArray(customersNode);\n\nvar priorityRules = Array.isArray(prepared.priorityRules) ? prepared.priorityRules : [];\n\nif (!Array.isArray(customers) || !customers.length) {\n  return [];\n}\n\nif (!Array.isArray(priorityRules) || !priorityRules.length) {\n  return customers;\n}\n\nfor (var i = 0; i < customers.length; i++) {\n  var customer = customers[i] || {};\n  var metricCache = Object.create(null);\n  customer.priority = getPriorityForCustomer(customer, metricCache, priorityRules);\n}\n\nreturn customers;\n\nfunction getResultArray(node) {\n  if (!node || !node.$output) {\n    return [];\n  }\n\n  var out = node.$output;\n\n  if (Array.isArray(out)) {\n    return out;\n  }\n\n  if (out && Array.isArray(out.result)) {\n    return out.result;\n  }\n\n  if (out && out.result && Array.isArray(out.result.customers)) {\n    return out.result.customers;\n  }\n\n  if (out && Array.isArray(out.customers)) {\n    return out.customers;\n  }\n\n  return [];\n}\n\nfunction getResultValue(node) {\n  if (!node || !node.$output) {\n    return null;\n  }\n\n  var out = node.$output;\n\n  if (out && out.result !== undefined) {\n    return out.result;\n  }\n\n  return out || null;\n}\n\nfunction getPriorityForCustomer(customer, metricCache, priorityRules) {\n  for (var i = 0; i < priorityRules.length; i++) {\n    if (evaluateRuleGroup(customer, metricCache, priorityRules[i])) {\n      return priorityRules[i].priority;\n    }\n  }\n\n  return \"Requires Review\";\n}\n\nfunction evaluateRuleGroup(customer, metricCache, ruleGroup) {\n  if (!ruleGroup) {\n    return false;\n  }\n\n  if (Array.isArray(ruleGroup.rules)) {\n    var logic = String(ruleGroup.logic || \"AND\").toUpperCase();\n    var rules = ruleGroup.rules;\n\n    if (logic === \"OR\") {\n      for (var i = 0; i < rules.length; i++) {\n        if (evaluateRuleGroup(customer, metricCache, rules[i])) {\n          return true;\n        }\n      }\n      return false;\n    }\n\n    for (var j = 0; j < rules.length; j++) {\n      if (!evaluateRuleGroup(customer, metricCache, rules[j])) {\n        return false;\n      }\n    }\n\n    return true;\n  }\n\n  return evaluateCondition(customer, metricCache, ruleGroup);\n}\n\nfunction evaluateCondition(customer, metricCache, rule) {\n  var actualValue = toNumeric(getMetricValue(customer, metricCache, rule.metric_code));\n  var expectedValue = rule.value;\n  var operator = rule.operator;\n\n  switch (operator) {\n    case \">\":\n      return actualValue > toNumeric(expectedValue);\n\n    case \">=\":\n      return actualValue >= toNumeric(expectedValue);\n\n    case \"<\":\n      return actualValue < toNumeric(expectedValue);\n\n    case \"<=\":\n      return actualValue <= toNumeric(expectedValue);\n\n    case \"=\":\n    case \"==\":\n      return actualValue === toNumeric(expectedValue);\n\n    case \"!=\":\n      return actualValue !== toNumeric(expectedValue);\n\n    case \"between\":\n      if (!Array.isArray(expectedValue) || expectedValue.length !== 2) {\n        return false;\n      }\n      return actualValue >= toNumeric(expectedValue[0]) &&\n             actualValue <= toNumeric(expectedValue[1]);\n\n    default:\n      return false;\n  }\n}\n\nfunction getMetricValue(record, metricCache, metricCode) {\n  var key = String(metricCode);\n\n  if (Object.prototype.hasOwnProperty.call(metricCache, key)) {\n    return metricCache[key];\n  }\n\n  var commonKey = key + \"COMMON\";\n  var raw;\n\n  if (record[commonKey] !== null && record[commonKey] !== undefined) {\n    raw = record[commonKey];\n  } else if (record[key] !== null && record[key] !== undefined) {\n    raw = record[key];\n  } else {\n    metricCache[key] = 0;\n    return 0;\n  }\n\n  if (Array.isArray(raw)) {\n    var sum = 0;\n\n    for (var i = 0; i < raw.length; i++) {\n      var item = raw[i] || {};\n      var value = item.convertedAmount;\n      if (value === undefined) {\n        value = item.amount;\n      }\n      sum += toNumeric(value);\n    }\n\n    metricCache[key] = sum;\n    return sum;\n  }\n\n  var num = toNumeric(raw);\n  metricCache[key] = num;\n  return num;\n}\n\nfunction toNumeric(value) {\n  if (value === null || value === undefined || value === \"\") {\n    return 0;\n  }\n\n  if (typeof value === \"number\") {\n    return Number.isFinite(value) ? value : 0;\n  }\n\n  if (typeof value === \"string\") {\n    var cleaned = value.replace(/,/g, \"\").replace(/[^0-9.\\-]/g, \"\");\n    if (!cleaned) {\n      return 0;\n    }\n\n    var parsed = Number(cleaned);\n    return Number.isFinite(parsed) ? parsed : 0;\n  }\n\n  var num = Number(value);\n  return Number.isFinite(num) ? num : 0;\n}"
          },
