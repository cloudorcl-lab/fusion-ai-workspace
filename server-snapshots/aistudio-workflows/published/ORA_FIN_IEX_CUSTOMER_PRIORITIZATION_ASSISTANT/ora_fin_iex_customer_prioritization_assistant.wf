        {
          "metadata": {
            "errorNodeId": "1780612612159",
            "name": "Currency Conversion Rate for Consolidation",
            "returnType": "object",
            "sourceCode": "var result;\n\nfunction getCurrencyCode(value) {\n  if (typeof value === \"string\") {\n    return value;\n  }\n\n  if (value && typeof value === \"object\") {\n    return (\n      value.currencyCode ||\n      value.code ||\n      value.value ||\n      value.result ||\n      value.currency ||\n      \"\"\n    );\n  }\n\n  return \"\";\n}\n\nvar detect =\n  $context.$nodes.DETECT_CURRENCIES_FOR_CONVERSION &&\n  $context.$nodes.DETECT_CURRENCIES_FOR_CONVERSION.$output &&\n  $context.$nodes.DETECT_CURRENCIES_FOR_CONVERSION.$output.result\n    ? $context.$nodes.DETECT_CURRENCIES_FOR_CONVERSION.$output.result\n    : {};\n\nvar policyCurrencyCode = getCurrencyCode(\n  $context.$nodes.CURRENCY_CODE_FROM_POLICY_DATA.$output.result\n)\n  .trim()\n  .toUpperCase();\n\nvar sourceCurrencies = Array.isArray(detect.fxCurrencies)\n  ? detect.fxCurrencies\n  : [];\n\n/*\n * No currencies detected:\n * Return a valid extraction query against the extract view\n * that intentionally returns no rows.\n */\nif (!sourceCurrencies.length) {\n  result = JSON.stringify({\n    viewQueries: {\n      currencyConversionRates: {\n        module: \"oraErpCoreCurrencySetup\",\n        businessObject: \"CurrencyConversionRate\",\n        view: \"currencyConversionRatesExtract\",\n        fieldAliases: {\n          fromCurrency: \"fromCurrency\",\n          toCurrency: \"toCurrency\",\n          conversionDate: \"conversionDate\",\n          conversionType: \"conversionType\",\n          conversionRate: \"conversionRate\"\n        }\n      }\n    },\n    select:\n      \"SELECT FROMCURRENCY, TOCURRENCY, CONVERSIONDATE, CONVERSIONTYPE, CONVERSIONRATE \" +\n      \"FROM currencyConversionRates WHERE 1 = 0\"\n  });\n\n  return result;\n}\n\nvar fromCurrencyList = sourceCurrencies\n  .map(function (c) {\n    return \"'\" + String(c || \"\").trim().toUpperCase() + \"'\";\n  })\n  .join(\", \");\n\nvar extractionView = {\n  viewQueries: {\n    currencyConversionRates: {\n      module: \"oraErpCoreCurrencySetup\",\n      businessObject: \"CurrencyConversionRate\",\n      view: \"currencyConversionRatesExtract\",\n      fieldAliases: {\n        fromCurrency: \"fromCurrency\",\n        toCurrency: \"toCurrency\",\n        conversionDate: \"conversionDate\",\n        conversionType: \"conversionType\",\n        conversionRate: \"conversionRate\"\n      }\n    }\n  },\n\n  select:\n    \"SELECT FROMCURRENCY, TOCURRENCY, CONVERSIONDATE, CONVERSIONTYPE, CONVERSIONRATE \" +\n    \"FROM (\" +\n    \" SELECT FROMCURRENCY, TOCURRENCY, CONVERSIONDATE, CONVERSIONTYPE, CONVERSIONRATE, \" +\n    \" ROW_NUMBER() OVER (PARTITION BY FROMCURRENCY ORDER BY CONVERSIONDATE DESC) AS RN \" +\n    \" FROM currencyConversionRates \" +\n    \" WHERE FROMCURRENCY IN (\" + fromCurrencyList + \") \" +\n    \" AND TOCURRENCY = '\" + policyCurrencyCode + \"' \" +\n    \" AND CONVERSIONDATE >= TRUNC(SYSDATE - 1)\" +\n    \") T \" +\n    \"WHERE RN = 1 \" +\n    \"ORDER BY FROMCURRENCY\"\n};\n\nresult = JSON.stringify(extractionView);\nreturn result;"
          },
