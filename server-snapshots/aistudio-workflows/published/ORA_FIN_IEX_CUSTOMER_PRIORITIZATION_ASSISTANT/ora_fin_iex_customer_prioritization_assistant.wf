          "metadata": {
            "name": "Total Past Due Balance Data",
            "returnType": "object",
            "sourceCode": "var result;\nvar collectorId = $context.$nodes.FETCH_COLLECTOR_ID.$output.result;\n\nvar analyticalView = {\n  \"analyticViews\": {\n    \"ReceivablesBalance\": {\n      \"module\": \"oraErpCoreReceivablesBilling\",\n      \"name\": \"ReceivablesBalance\",\n      \"measureAliases\": {\n        \"invoiceRemainingAmount\": \"invoiceRemainingAmount\"\n      },\n      \"dimensions\": {\n        \"overdue\": {\n          \"overdueHierarchy\": {\n            \"aliases\": {\n              \"$depth\": \"overdueHierarchydepth\",\n              \"overdueCode\": \"overdueCode\"\n            },\n            \"filter\": \"($memberName='Y')\"\n          }\n        },\n        \"customer\": {\n          \"customerHierarchy\": {\n            \"aliases\": {\n              \"$depth\": \"customerHierarchydepth\",\n              \"customerName\": \"customerName\",\n              \"customerAccountId\": \"customerAccountId\"\n            }\n          }\n        },\n        \"collector\": {\n          \"collectorHierarchy\": {\n            \"aliases\": {\n              \"$depth\": \"collectorHierarchydepth\",\n              \"customerCollectorId\": \"customerCollectorId\"\n            }\n          }\n        },\n        \"invoiceCurrency\": {\n          \"invoiceCurrencyHierarchy\": {\n            \"aliases\": {\n              \"$depth\": \"invoiceCurrencyHierarchydepth\",\n              \"currencyCode\": \"currencyCode\"\n            }\n          }\n        }\n      },\n      \"filter\": \"((overdue.overdueHierarchy.$depth IN (1))) AND ((invoiceCurrency.invoiceCurrencyHierarchy.$depth IN (1))) AND ((customer.customerHierarchy.$depth IN (1)))\"\n    }\n  },\n  \"viewQueries\": {},\n  \"return\": [\n    { \"name\": \"TOTALPASTDUEBALANCE\" },\n    { \"name\": \"TOTALPASTDUEBALANCECURRENCY\" },\n    { \"name\": \"CUSTOMERACCOUNTID\" },\n    { \"name\": \"CUSTOMERNAME\" }\n  ],\n  \"select\": \"SELECT TOTALPASTDUEBALANCE, TOTALPASTDUEBALANCECURRENCY, CUSTOMERACCOUNTID, CUSTOMERNAME FROM ( SELECT invoiceRemainingAmount AS TOTALPASTDUEBALANCE, currencyCode AS TOTALPASTDUEBALANCECURRENCY, customerAccountId AS CUSTOMERACCOUNTID, customerCollectorId AS CUSTOMERCOLLECTORID, customerName AS CUSTOMERNAME, ROW_NUMBER() OVER ( PARTITION BY customerAccountId ORDER BY invoiceRemainingAmount DESC ) AS RN FROM ReceivablesBalance WHERE customerCollectorId = \" + collectorId + \" ) t WHERE 1 = 1 ORDER BY TOTALPASTDUEBALANCE DESC\"\n};\n\nresult = JSON.stringify(analyticalView);\nreturn  result;"
          },
