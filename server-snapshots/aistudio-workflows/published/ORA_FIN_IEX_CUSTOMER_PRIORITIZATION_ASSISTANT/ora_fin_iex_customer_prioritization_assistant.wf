        {
          "metadata": {
            "name": "Large Open Invoice Data",
            "returnType": "object",
            "sourceCode": "var result;\nvar collectorId = $context.$nodes.FETCH_COLLECTOR_ID.$output.result;\n\nvar extractionView = {\n  \"viewQueries\": {\n    \"recPaySchedule\": {\n      \"module\": \"oraErpCoreReceivablesBilling\",\n      \"businessObject\": \"ReceivablesTransactionPaymentSchedule\",\n      \"view\": \"receivablesPaymentSchedule\",\n      \"fieldAliases\": {\n        \"transactionNumber\": \"transactionNumber\",\n        \"amountRemaining\": \"amountRemaining\",\n        \"originalAmount\": \"originalAmount\",\n        \"installmentDueDate\": \"installmentDueDate\",\n        \"overdueFlag\": \"overdueFlag\",\n        \"customerAccount.customerAccountId\": \"customerAccountId\",\n        \"customerAccount.customer.name\": \"customerName\",\n        \"customerAccount.customerAccountProfile.collector.collectorId\": \"collectorId\",\n        \"customerTransaction.customerTransactionId\": \"customerTransactionId\",\n        \"invoiceCurrency.currencyCode\": \"currency\"\n      }\n    }\n  },\n  \"select\": \"SELECT CUSTOMERACCOUNTID, CUSTOMERNAME, CURRENCY AS LARGEINVOICECURRENCY, TRANSACTIONNUMBER AS LARGEINVOICETRANSACTIONNUMBER, CUSTOMERTRANSACTIONID, AMOUNTREMAINING AS LARGESTOPENINVOICE, INSTALLMENTDUEDATE AS LARGESTOPENINVOICEDUEDATE, ORIGINALAMOUNT AS LARGEINVOICEORIGINALAMOUNT FROM ( SELECT CUSTOMERACCOUNTID, CUSTOMERNAME, TRIM(UPPER(CURRENCY)) AS CURRENCY, TRANSACTIONNUMBER, CUSTOMERTRANSACTIONID, AMOUNTREMAINING, INSTALLMENTDUEDATE, ORIGINALAMOUNT, ROW_NUMBER() OVER (PARTITION BY CUSTOMERACCOUNTID, TRIM(UPPER(CURRENCY)) ORDER BY AMOUNTREMAINING DESC, CUSTOMERTRANSACTIONID) AS RN FROM RECPAYSCHEDULE WHERE COLLECTORID = \" + collectorId + \" AND AMOUNTREMAINING > 0) T WHERE RN = 1 ORDER BY CUSTOMERACCOUNTID, LARGEINVOICECURRENCY, LARGESTOPENINVOICE DESC\"\n};\n\nresult = JSON.stringify(extractionView);\nreturn result;"
          },
          "outcomes": {
            "success": "1773326457548"
          },
          "diagram": {
            "x": 7198.922174223036,
            "y": 7359.572563083888
          },
          "code": "LARGE_OPEN_INVOICE_DATA",
