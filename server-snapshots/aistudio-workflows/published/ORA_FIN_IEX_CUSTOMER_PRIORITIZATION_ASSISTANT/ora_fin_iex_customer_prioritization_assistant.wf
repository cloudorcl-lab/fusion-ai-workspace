            "name": "Extract Exchange Rates",
            "returnType": "object",
            "sourceCode": "var node = $context.$nodes.CURRENCY_CONVERSION_RATE_EXTRACT;\nvar output = node && node.$output ? node.$output : null;\n\nvar raw =\n  output && output.result !== undefined ? output.result :\n  output && output.body !== undefined ? output.body :\n  output && output.data !== undefined ? output.data :\n  output && output.items !== undefined ? output.items :\n  output && output.rows !== undefined ? output.rows :\n  output && output.value !== undefined ? output.value :\n  output && output.records !== undefined ? output.records :\n  output;\n\nvar rows = normalizeRows(raw);\n\nfunction getCurrencyCode(value) {\n  if (typeof value === \"string\") return value;\n  if (value && typeof value === \"object\") {\n    return value.currencyCode || value.code || value.value || value.result || value.currency || \"\";\n  }\n  return \"\";\n}\n\nvar targetCurrency = getCurrencyCode($context.$nodes.CURRENCY_CODE_FROM_POLICY_DATA.$output.result)\n  .trim()\n  .toUpperCase();\n\nvar ratesByFromCurrency = {};\n\nfor (var i = 0; i < rows.length; i++) {\n  var row = rows[i] || {};\n\n  var fromCurrency = String(row.FROMCURRENCY || row.fromCurrency || \"\").trim().toUpperCase();\n  var toCurrency = String(row.TOCURRENCY || row.toCurrency || \"\").trim().toUpperCase();\n\n  var rawRate =\n    row.CONVERSIONRATE !== undefined\n      ? row.CONVERSIONRATE\n      : row.conversionRate;\n\n  var conversionRate = Number(rawRate);\n\n  if (fromCurrency && toCurrency && Number.isFinite(conversionRate)) {\n    ratesByFromCurrency[fromCurrency] = {\n      fromCurrency: fromCurrency,\n      toCurrency: toCurrency,\n      conversionDate: row.CONVERSIONDATE || row.conversionDate || null,\n      conversionType: row.CONVERSIONTYPE || row.conversionType || null,\n      conversionRate: conversionRate\n    };\n  }\n}\n\nreturn {\n  targetCurrency: targetCurrency,\n  ratesByFromCurrency: ratesByFromCurrency\n};\n\nfunction normalizeRows(value) {\n  var rows = value;\n\n  if (typeof rows === \"string\") {\n    try {\n      rows = JSON.parse(rows);\n    } catch (e) {\n      return [];\n    }\n  }\n\n  if (Array.isArray(rows)) {\n    return rows;\n  }\n\n  if (rows && typeof rows === \"object\") {\n    var candidates = [\n      rows.result,\n      rows.body,\n      rows.data,\n      rows.items,\n      rows.rows,\n      rows.value,\n      rows.records\n    ];\n\n    for (var i = 0; i < candidates.length; i++) {\n      var candidate = candidates[i];\n\n      if (typeof candidate === \"string\") {\n        try {\n          candidate = JSON.parse(candidate);\n        } catch (e2) {\n          candidate = null;\n        }\n      }\n\n      if (Array.isArray(candidate)) {\n        return candidate;\n      }\n    }\n\n    return [rows];\n  }\n\n  return [];\n}"
