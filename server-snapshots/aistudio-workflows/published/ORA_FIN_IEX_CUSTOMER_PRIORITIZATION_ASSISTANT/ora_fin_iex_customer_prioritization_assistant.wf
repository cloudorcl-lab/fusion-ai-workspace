        {
          "metadata": {
            "errorNodeId": "1780612724388",
            "name": "Normalize Currency for Single Currency",
            "returnType": "object",
            "sourceCode": "var data = Array.isArray($context.$nodes.RESOLVE_CURRENCY_DATASET?.$output?.result)\n  ? $context.$nodes.RESOLVE_CURRENCY_DATASET.$output.result\n  : Array.isArray($context.$nodes.RESOLVE_CURRENCY_DATASET?.$output)\n    ? $context.$nodes.RESOLVE_CURRENCY_DATASET.$output\n    : [];\n\nfunction isMoneyArray(value) {\n  return Array.isArray(value) &&\n    value.length > 0 &&\n    value.every(function (item) {\n      return item &&\n        typeof item === \"object\" &&\n        (\"amount\" in item) &&\n        (\"currency\" in item);\n    });\n}\n\nfunction toNumber(value) {\n\n  if (\n    value === null ||\n    value === undefined ||\n    value === \"\"\n  ) {\n    return 0;\n  }\n\n  var n = Number(value);\n\n  return Number.isFinite(n)\n    ? n\n    : 0;\n}\n\nvar output = [];\n\nfor (var i = 0; i < data.length; i++) {\n\n  var record = data[i] || {};\n  var out = { ...record };\n\n  for (var key in record) {\n\n    if (\n      !Object.prototype.hasOwnProperty.call(record, key)\n    ) {\n      continue;\n    }\n\n    if (isMoneyArray(record[key])) {\n\n      var total = 0;\n\n      for (\n        var j = 0;\n        j < record[key].length;\n        j++\n      ) {\n\n        total += toNumber(\n          record[key][j].amount\n        );\n\n      }\n\n      out[key + \"COMMON\"] = total;\n\n      out[key + \"CURRENCYCOMMON\"] =\n        \"COMMON\";\n\n    }\n\n  }\n\n  output.push(out);\n\n}\n\nreturn output;"
          },
