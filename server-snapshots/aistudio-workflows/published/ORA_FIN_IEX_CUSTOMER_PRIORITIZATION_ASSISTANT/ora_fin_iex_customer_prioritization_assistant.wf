            "name": "Aging Buckets Data",
            "returnType": "object",
            "sourceCode": "var result;\nvar collectorId = $context.$nodes.FETCH_COLLECTOR_ID.$output.result;\n\nvar analyticalView = {\n    \"analyticViews\": {\n        \"ReceivablesBalance\": {\n            \"module\": \"oraErpCoreReceivablesBilling\",\n            \"name\": \"ReceivablesBalance\",\n            \"measureAliases\": {\n                \"invoiceRemainingAmount\": \"invoiceRemainingAmount\"\n            },\n            \"dimensions\": {\n                \"overdue\": {\n                    \"overdueHierarchy\": {\n                        \"aliases\": {\n                            \"$depth\": \"overdueHierarchyDepth\",\n                            \"overdueCode\": \"overdueCode\"\n                        },\n                        \"filter\": \"($memberName='Y')\"\n                    }\n                },\n                \"customer\": {\n                    \"customerHierarchy\": {\n                        \"aliases\": {\n                            \"$depth\": \"customerHierarchyDepth\",\n                            \"customerName\": \"customerName\",\n                            \"customerAccountId\": \"customerAccountId\"\n                        }\n                    }\n                },\n                \"collector\": {\n                    \"collectorHierarchy\": {\n                        \"aliases\": {\n                            \"$depth\": \"collectorHierarchydepth\",\n                            \"customerCollectorId\": \"customerCollectorId\"\n                        }\n                    }\n                },\n                \"invoiceCurrency\": {\n                    \"invoiceCurrencyHierarchy\": {\n                        \"aliases\": {\n                            \"$depth\": \"invoiceCurrencyHierarchyDepth\",\n                            \"currencyCode\": \"currencyCode\"\n                        } \n                    }\n                },\n                \"agingBucket\": {\n                    \"agingBucketHierarchy\": {\n                        \"aliases\": {\n                            \"$depth\": \"agingBucketHierarchyDepth\",\n                            \"daysLate\": \"daysLate\"\n                        }\n                    }\n                }\n            },\n            \"filter\": \"((overdue.overdueHierarchy.$depth IN (1))) AND ((invoiceCurrency.invoiceCurrencyHierarchy.$depth IN (1))) AND ((customer.customerHierarchy.$depth IN (1))) AND ((agingBucket.agingBucketHierarchy.$depth IN (1)))\"\n        }\n    },\n    \"viewQueries\": {},\n    \"return\": [\n        { \"name\": \"CUSTOMERACCOUNTID\" },\n        { \"name\": \"CUSTOMERNAME\" },\n        { \"name\": \"INVOICEREMAININGAMOUNT\" },\n        { \"name\": \"INVOICEREMAININGAMOUNTCURRENCY\" },\n        { \"name\": \"DAYSLATE\" }\n    ],\n    \"select\": \"SELECT CUSTOMERACCOUNTID, CUSTOMERNAME, INVOICEREMAININGAMOUNT, INVOICEREMAININGAMOUNTCURRENCY, DAYSLATE FROM ( SELECT customerAccountId AS CUSTOMERACCOUNTID, invoiceRemainingAmount AS INVOICEREMAININGAMOUNT, currencyCode AS INVOICEREMAININGAMOUNTCURRENCY, ReceivablesBalance.customerName AS CUSTOMERNAME, ReceivablesBalance.daysLate AS DAYSLATE, ROW_NUMBER() OVER ( PARTITION BY customerAccountId ORDER BY invoiceRemainingAmount DESC ) AS RN FROM ReceivablesBalance WHERE customerCollectorId = \" + collectorId + \") t ORDER BY DAYSLATE ASC\"\n};\n\nresult = JSON.stringify(analyticalView);\nreturn result;"
          },
