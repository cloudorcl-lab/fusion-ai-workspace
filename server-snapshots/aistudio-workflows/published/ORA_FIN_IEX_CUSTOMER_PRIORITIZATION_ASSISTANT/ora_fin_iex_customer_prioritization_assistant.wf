        {
          "metadata": {
            "errorNodeId": "1780612612159",
            "name": "Extract Conversion Rates for Consolidation",
            "returnType": "object",
            "sourceCode": "var fxNode = $context.$nodes.EXTRACT_CONVERSION_RATES_FOR_CONSOLIDATION;\nvar fxPayload = fxNode && fxNode.$output ? fxNode.$output : {};\n\nif (typeof fxPayload === \"string\") {\n  fxPayload = JSON.parse(fxPayload);\n}\n\nvar targetCurrency = getCurrencyCode(\n  fxPayload.targetCurrency ||\n  (fxPayload.result && fxPayload.result.targetCurrency) ||\n  \"\"\n).trim().toUpperCase();\n\nvar ratesByFromCurrency =\n  fxPayload.ratesByFromCurrency ||\n  (fxPayload.result && fxPayload.result.ratesByFromCurrency) ||\n  {};\n\nvar staged = [];\n\nvar configs = [\n  {\n    node: \"LARGE_OPEN_INVOICE_EXTRACT\",\n    metricKey: \"LARGESTOPENINVOICE\",\n    amountKey: \"LARGESTOPENINVOICE\",\n    currencyKey: \"LARGEINVOICECURRENCY\"\n  },\n  {\n    node: \"LARGEST_OVERDUE_BALANCE_EXTRACT\",\n    metricKey: \"LARGESTOVERDUEINVOICE\",\n    amountKey: \"LARGESTOVERDUEINVOICE\",\n    currencyKey: \"LARGESTOVERDUEBALCURRENCY\"\n  },\n  {\n    node: \"UPCOMING_LARGE_DUE_INVOICE_EXTRACT\",\n    metricKey: \"UPCOMINGLARGEINVOICE\",\n    amountKey: \"UPCOMINGLARGEINVOICE\",\n    currencyKey: \"UPCOMINGLARGEINVOICECURRENCY\"\n  }\n];\n\nfor (var c = 0; c < configs.length; c++) {\n  var cfg = configs[c];\n  var rows = readRowsFromNode(cfg.node);\n\n  for (var i = 0; i < rows.length; i++) {\n    var row = rows[i] || {};\n\n    var amount = Number(row[cfg.amountKey]);\n    if (!isFinite(amount)) {\n      continue;\n    }\n\n    var currency = normalizeCurrency(row[cfg.currencyKey]);\n\n    var customerAccountId =\n      row.CUSTOMERACCOUNTID !== undefined && row.CUSTOMERACCOUNTID !== null\n        ? row.CUSTOMERACCOUNTID\n        : row.customerAccountId;\n\n    var customerName = row.CUSTOMERNAME || row.customerName || null;\n\n    if (\n      (customerAccountId === undefined ||\n        customerAccountId === null ||\n        customerAccountId === \"\") &&\n      !customerName\n    ) {\n      continue;\n    }\n\n    row.__customerKey = String(\n      customerAccountId !== undefined &&\n        customerAccountId !== null &&\n        customerAccountId !== \"\"\n        ? customerAccountId\n        : customerName\n    );\n\n    row.__metricKey = cfg.metricKey;\n    row.__sourceNode = cfg.node;\n    row.__originalAmount = amount;\n    row.__originalCurrency = currency;\n    row.__compareAmount = convertToTarget(\n      amount,\n      currency,\n      targetCurrency,\n      ratesByFromCurrency\n    );\n    row.__fxMissing = shouldFlagMissingFx(\n      currency,\n      targetCurrency,\n      ratesByFromCurrency\n    );\n\n    staged.push(row);\n  }\n}\n\nvar metricCounts = {};\nvar sourceCounts = {};\nvar fxMissingCounts = {};\nvar sampleByMetric = {};\nvar firstFxMissingByCurrency = {};\n\nfor (var s = 0; s < staged.length; s++) {\n  var stagedRow = staged[s] || {};\n  var metricKey = stagedRow.__metricKey || \"UNKNOWN\";\n  var sourceNode = stagedRow.__sourceNode || \"UNKNOWN\";\n  var originalCurrency = stagedRow.__originalCurrency || \"UNKNOWN\";\n\n  metricCounts[metricKey] = (metricCounts[metricKey] || 0) + 1;\n  sourceCounts[sourceNode] = (sourceCounts[sourceNode] || 0) + 1;\n\n  if (!sampleByMetric[metricKey]) {\n    sampleByMetric[metricKey] = stagedRow;\n  }\n\n  if (stagedRow.__fxMissing) {\n    fxMissingCounts[originalCurrency] = (fxMissingCounts[originalCurrency] || 0) + 1;\n\n    if (!firstFxMissingByCurrency[originalCurrency]) {\n      firstFxMissingByCurrency[originalCurrency] = stagedRow;\n    }\n  }\n}\n\nreturn {\n  targetCurrency: targetCurrency,\n  ratesKeys: Object.keys(ratesByFromCurrency || {}),\n  totalStagedRows: staged.length,\n  metricCounts: metricCounts,\n  sourceCounts: sourceCounts,\n  fxMissingCounts: fxMissingCounts,\n  sampleByMetric: sampleByMetric,\n  boundaryRows: {\n    firstRow: staged[0] || null,\n    row208: staged[208] || null,\n    row209: staged[209] || null,\n    row416: staged[416] || null,\n    row417: staged[417] || null,\n    lastRow: staged.length ? staged[staged.length - 1] : null\n  },\n  firstFxMissingByCurrency: firstFxMissingByCurrency,\n  result: staged\n};\n\nfunction readRowsFromNode(nodeName) {\n  var node = $context.$nodes[nodeName];\n\n  if (!node || !node.$output) {\n    return [];\n  }\n\n  var out = node.$output;\n\n  if (typeof out === \"string\") {\n    try {\n      out = JSON.parse(out);\n    } catch (e) {\n      return [];\n    }\n  }\n\n  if (Array.isArray(out)) {\n    return out;\n  }\n\n  var candidates = [\n    out.result,\n    out.rows,\n    out.body,\n    out.data,\n    out.items,\n    out.value,\n    out.records\n  ];\n\n  for (var i = 0; i < candidates.length; i++) {\n    var candidate = candidates[i];\n\n    if (typeof candidate === \"string\") {\n      try {\n        candidate = JSON.parse(candidate);\n      } catch (e2) {\n        candidate = null;\n      }\n    }\n\n    if (Array.isArray(candidate)) {\n      return candidate;\n    }\n\n    if (candidate && typeof candidate === \"object\") {\n      if (Array.isArray(candidate.result)) return candidate.result;\n      if (Array.isArray(candidate.rows)) return candidate.rows;\n      if (Array.isArray(candidate.body)) return candidate.body;\n      if (Array.isArray(candidate.data)) return candidate.data;\n      if (Array.isArray(candidate.items)) return candidate.items;\n      if (Array.isArray(candidate.value)) return candidate.value;\n      if (Array.isArray(candidate.records)) return candidate.records;\n    }\n  }\n\n  return [];\n}\n\nfunction normalizeCurrency(value) {\n  return String(getCurrencyCode(value) || \"\").trim().toUpperCase();\n}\n\nfunction getCurrencyCode(value) {\n  if (typeof value === \"string\") {\n    return value;\n  }\n\n  if (value && typeof value === \"object\") {\n    return (\n      value.currencyCode ||\n      value.code ||\n      value.value ||\n      value.result ||\n      value.currency ||\n      \"\"\n    );\n  }\n\n  return \"\";\n}\n\nfunction convertToTarget(amount, fromCurrency, targetCurrency, ratesByFromCurrency) {\n  if (!i