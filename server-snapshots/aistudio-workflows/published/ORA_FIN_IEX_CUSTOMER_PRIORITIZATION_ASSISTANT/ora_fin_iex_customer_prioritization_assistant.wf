            "returnType": "object",
            "sourceCode": "const data = Array.isArray($context.$nodes.ASSIGN_PRIORITY_TO_CUSTOMERS?.$output?.result)\n  ? $context.$nodes.ASSIGN_PRIORITY_TO_CUSTOMERS.$output.result\n  : Array.isArray($context.$nodes.ASSIGN_PRIORITY_TO_CUSTOMERS?.$output)\n    ? $context.$nodes.ASSIGN_PRIORITY_TO_CUSTOMERS.$output\n    : [];\n\nfunction shouldRemoveKey(key) {\n  const upper = String(key || \"\").toUpperCase();\n  return (\n    upper.endsWith(\"COMMON\") ||\n    upper.endsWith(\"CURRENCYCOMMON\") ||\n    upper.endsWith(\"CONVERTED\") ||\n    upper.endsWith(\"CURRENCYCONVERTED\")\n  );\n}\n\nfunction stripInternalFields(record) {\n  const out = {};\n\n  for (const key in record) {\n    if (!Object.prototype.hasOwnProperty.call(record, key)) continue;\n    if (shouldRemoveKey(key)) continue;\n    out[key] = record[key];\n  }\n\n  return out;\n}\n\nreturn data.map((record) => stripInternalFields(record || {}));"
