            "sourceCode": "var result;\n\nfunction getCurrencyCode(value) {\n  if (typeof value === \"string\") {\n    return value;\n  }\n\n  if (value && typeof value === \"object\") {\n    return (\n      value.currencyCode ||\n      value.code ||\n      value.value ||\n      value.result ||\n      value.currency ||\n      \"\"\n    );\n  }\n\n  return \"\";\n}\n\nvar policyCurrencyCode = getCurrencyCode($context.$nodes.CURRENCY_CODE_FROM_POLICY_DATA.$output.result)\n  .trim()\n  .toUpperCase();\n\nvar currencyResult = $context.$nodes.DETECT_CURRENCY_TYPE.$output.result || {};\nvar dataCurrencyCodes = Array.isArray(currencyResult.currencies) ? currencyResult.currencies : [];\n\nvar fromCurrencyList = dataCurrencyCodes\n  .map(function (c) { return \"'\" + String(c || \"\").trim().toUpperCase() + \"'\"; })\n  .join(\", \");\n\nvar extractionView = {\n  \"viewQueries\": {\n    \"currencyConversionRates\": {\n      \"module\": \"oraErpCoreCurrencySetup\",\n      \"businessObject\": \"CurrencyConversionRate\",\n      \"view\": \"currencyConversionRatesExtract\",\n      \"fieldAliases\": {\n        \"fromCurrency\": \"fromCurrency\",\n        \"toCurrency\": \"toCurrency\",\n        \"conversionDate\": \"conversionDate\",\n        \"conversionType\": \"conversionType\",\n        \"conversionRate\": \"conversionRate\"\n      }\n    }\n  },\n  \"select\": \"SELECT FROMCURRENCY, TOCURRENCY, CONVERSIONDATE, CONVERSIONTYPE, CONVERSIONRATE FROM ( SELECT FROMCURRENCY, TOCURRENCY, CONVERSIONDATE, CONVERSIONTYPE, CONVERSIONRATE, ROW_NUMBER() OVER (PARTITION BY FROMCURRENCY ORDER BY CONVERSIONDATE DESC) AS RN FROM currencyConversionRates WHERE FROMCURRENCY IN (\" + fromCurrencyList + \") AND TOCURRENCY = '\" + policyCurrencyCode + \"' AND CONVERSIONDATE >= TRUNC(SYSDATE - 1)) T WHERE RN = 1 ORDER BY FROMCURRENCY\"\n};\n\nresult = JSON.stringify(extractionView);\nreturn result;"
