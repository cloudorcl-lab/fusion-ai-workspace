        {
          "metadata": {
            "description": "Construct payload to check recent tasks performed by collector",
            "name": "Construct payload to Check Collector Recent Tasks",
            "returnType": "object",
            "sourceCode": "/* collector id from previous node */\nlet collectorId = $context.$nodes.FETCH_COLLECTOR_ID.$output.result;\n\n/* static strategy template id */\nlet strategyTemplateId = 124;\n\n/* request payload for query execution */\nlet result = {\n  parameters: {\n    bindCollectorId: collectorId,\n    bindStrategyTemplateId: strategyTemplateId\n  },\n  viewQueries: {\n    collectionsStrategy: {\n      module: \"oraErpCoreAdvancedCollections\",\n      businessObject: \"CustomerCollectionsTaskDetail\",\n      view: \"collectionsStrategy\",\n      fieldAliases: {\n        workItemId: \"workItemId\",\n        executeStart: \"executeStart\",\n        \"strategyWorkItem.workItemTemplateId\": \"workItemTemplateId\",\n        \"strategy.customerAccount.accountNumber\": \"accountNumber\",\n        \"strategy.customerAccount.customerAccountId\": \"customerAccountId\",\n        \"strategy.customer.id\": \"partyId\",\n        \"strategy.strategyId\": \"strategyId\",\n        \"statusCodeLookup.lookupCode\": \"statusLookupCode\",\n        \"strategy.strategyTemplate.strategyTemplateId\": \"strategyTemplateId\"\n      }\n    },\n    customerAccountProfileDetail: {\n      module: \"oraErpCoreCustomerAccountSetup\",\n      businessObject: \"CustomerProfile\",\n      view: \"customerAccountProfileDetail\",\n      fieldAliases: {\n        \"customerAccount.customerAccountId\": \"customerAccountId\",\n        \"collector.collectorId\": \"collectorId\"\n      }\n    }\n  },\n  select: \"SELECT DISTINCT collectionsStrategy.accountNumber, DECODE(collectionsStrategy.workItemTemplateId, 109, 'CALLCUSTOMER', 110, 'REQUESTPROMISETOPAY', collectionsStrategy.workItemTemplateId) taskCode, DECODE(collectionsStrategy.statusLookupCode, 'COMPLETE', 'Completed', 'CANCELLED', 'Skipped') taskStatus, collectionsStrategy.customerAccountId, collectionsStrategy.partyId, TO_CHAR(collectionsStrategy.executeStart, 'YYYY-MM-DD') taskDate FROM collectionsStrategy collectionsStrategy, (SELECT DISTINCT customerAccountProfileDetail.customerAccountId customerAccountId, customerAccountProfileDetail.collectorId collectorId FROM customerAccountProfileDetail customerAccountProfileDetail) customerAccountProfileDetail WHERE customerAccountProfileDetail.customerAccountId = collectionsStrategy.customerAccountId AND customerAccountProfileDetail.collectorId = :bindCollectorId AND collectionsStrategy.executeStart >= TRUNC(SYSDATE) - 7 AND collectionsStrategy.strategyTemplateId = :bindStrategyTemplateId ORDER BY collectionsStrategy.customerAccountId\"\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1777527555140"
          },
          "diagram": {
            "x": 9583.922174223044,
            "y": 7359.572563083888
          },
          "code": "FIN_IEX_CODE_CONSTRUCT_PAYLOAD_TO_CHECK_COLLECTOR_RECENT_TASKS",
          "id": "1777527383059",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "description": "Constructs the extraction payload to fetch the inbound email messages",
            "name": "Construct Payload to Fetch Email Messages",
            "returnType": "object",
            "sourceCode": "let result = {};\n\ntry {\n  let collectorId = $context.$nodes.FETCH_COLLECTOR_ID.$output.result;\n\n  let payload = {\n    parameters: {\n      bindCollectorId: collectorId\n    },\n    viewQueries: {\n      CollectionsCustomerMsgDetails: {\n        module: \"oraErpCoreAdvancedCollections\",\n        businessObject: \"CollectionsCustomerMessage\",\n        view: \"collectionsCustomerMessageDetails\",\n        fieldAliases: {\n          \"customerMessageDetailId\": \"customerMessageDetailId\",\n          \"intent.lookupCode\": \"intentCode\",\n          \"intent.meaning\": \"intentMeaning\",\n          \"processingStatus.lookupCode\": \"processingStatusCode\",\n          \"processingStatus.meaning\": \"statusMeaning\",\n          \"customer.id\": \"partyId\",\n          \"customer.name\": \"customerName\",\n          \"customerAccount.customerAccountId\": \"customerAccountId\",\n          \"customerAccount.accountNumber\": \"accountNumber\",\n          \"accountSitePurpose.siteUseId\": \"siteUseId\",\n          \"accountSitePurpose.site\": \"siteName\",\n          \"emailMessage.messageId\": \"messageId\",\n          \"requestData\": \"requestData\",\n          \"responseData\": \"responseData\",\n          \"accountSitePurpose.customerAccountSite.customerAccountSiteId\": \"customerAccountSiteId\"\n        }\n      },\n      customerAccountProfileDetail: {\n        module: \"oraErpCoreCustomerAccountSetup\",\n        businessObject: \"CustomerProfile\",\n        view: \"customerAccountProfileDetail\",\n        fieldAliases: {\n          \"customerAccount.customerAccountId\": \"customerAccountId\",\n          \"collector.collectorId\": \"collectorId\"\n        }\n      }\n    },\n    select: \"SELECT CollectionsCustomerMsgDetails.customerMessageDetailId, CollectionsCustomerMsgDetails.intentCode, decode(CollectionsCustomerMsgDetails.intentCode,'ORA_INVOICE_REPRINT','Invoice Copy Request',CollectionsCustomerMsgDetails.intentMeaning) intentMeaning, CollectionsCustomerMsgDetails.processingStatusCode, CollectionsCustomerMsgDetails.statusMeaning, CollectionsCustomerMsgDetails.partyId, CollectionsCustomerMsgDetails.customerName, CollectionsCustomerMsgDetails.customerAccountId, CollectionsCustomerMsgDetails.accountNumber, CollectionsCustomerMsgDetails.siteUseId, CollectionsCustomerMsgDetails.siteName, CollectionsCustomerMsgDetails.messageId, CollectionsCustomerMsgDetails.requestData, CollectionsCustomerMsgDetails.responseData, CollectionsCustomerMsgDetails.customerAccountSiteId FROM CollectionsCustomerMsgDetails CollectionsCustomerMsgDetails, (SELECT DISTINCT customerAccountProfileDetail.customerAccountId customerAccountId, customerAccountProfileDetail.collectorId collectorId FROM customerAccountProfileDetail customerAccountProfileDetail) customerAccountProfileDetail WHERE customerAccountProfileDetail.customerAccountId = CollectionsCustomerMsgDetails.customerAccountId AND customerAccountProfileDetail.collectorId = :bindCollectorId AND CollectionsCustomerMsgDetails.responseData LIKE '%firstRecord%' AND CollectionsCustomerMsgDetails.processingStatusCode IN ('ORA_ACTION_PENDING','ORA_REVIEW_PENDING','ORA_ERROR_REVIEW_PENDING') AND CollectionsCustomerMsgDetails.intentCode IN ('ORA_PROMISE_TO_PAY','ORA_DISPUTE_REQUEST','ORA_PO_UPDATE')\"\n  };\n\n  result = payload;\n} catch (error) {\n  result = {};\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1777616187913"
          },
          "diagram": {
            "x": 10234.922174223033,
            "y": 7359.572563083888
          },
