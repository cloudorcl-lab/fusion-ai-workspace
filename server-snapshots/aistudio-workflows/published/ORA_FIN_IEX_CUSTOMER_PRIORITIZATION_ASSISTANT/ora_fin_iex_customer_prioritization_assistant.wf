            "sourceCode": "var rows = readRowsFromNode(\"CONVERT_METRICS_FOR_CONSOLIDATION\");\nvar winnerMap = Object.create(null);\n\nvar inputMetricCounts = {};\nvar skippedCounts = {\n  missingCustomerKey: 0,\n  missingMetricKey: 0,\n  invalidCompareAmount: 0\n};\n\nvar skippedSamples = [];\nvar candidateCountsByGroup = {};\nvar replacementSamples = [];\n\nfor (var i = 0; i < rows.length; i++) {\n  var row = rows[i] || {};\n\n  var inputMetricKey = row.__metricKey || \"UNKNOWN\";\n  inputMetricCounts[inputMetricKey] = (inputMetricCounts[inputMetricKey] || 0) + 1;\n\n  var customerKey =\n    row.__customerKey !== undefined && row.__customerKey !== null && row.__customerKey !== \"\"\n      ? row.__customerKey\n      : row.CUSTOMERACCOUNTID !== undefined && row.CUSTOMERACCOUNTID !== null && row.CUSTOMERACCOUNTID !== \"\"\n        ? row.CUSTOMERACCOUNTID\n        : row.customerAccountId;\n\n  var metricKey = row.__metricKey;\n  var compareAmount = Number(row.__compareAmount);\n\n  var skipReason = \"\";\n\n  if (customerKey === undefined || customerKey === null || customerKey === \"\") {\n    skippedCounts.missingCustomerKey++;\n    skipReason = \"missingCustomerKey\";\n  } else if (!metricKey) {\n    skippedCounts.missingMetricKey++;\n    skipReason = \"missingMetricKey\";\n  } else if (!isFinite(compareAmount)) {\n    skippedCounts.invalidCompareAmount++;\n    skipReason = \"invalidCompareAmount\";\n  }\n\n  if (skipReason) {\n    if (skippedSamples.length < 10) {\n      skippedSamples.push({\n        index: i,\n        reason: skipReason,\n        customerKey: customerKey,\n        metricKey: metricKey,\n        compareAmount: row.__compareAmount,\n        row: row\n      });\n    }\n    continue;\n  }\n\n  var mapKey = String(customerKey) + \"|\" + metricKey;\n  candidateCountsByGroup[mapKey] = (candidateCountsByGroup[mapKey] || 0) + 1;\n\n  var current = winnerMap[mapKey];\n\n  if (!current) {\n    winnerMap[mapKey] = row;\n    continue;\n  }\n\n  var currentCompare = Number(current.__compareAmount);\n\n  if (!isFinite(currentCompare) || compareAmount > currentCompare) {\n    if (replacementSamples.length < 20) {\n      replacementSamples.push({\n        mapKey: mapKey,\n        previousWinner: {\n          customerKey: current.__customerKey,\n          metricKey: current.__metricKey,\n          currency: current.__originalCurrency,\n          compareAmount: current.__compareAmount,\n          originalAmount: current.__originalAmount,\n          sourceNode: current.__sourceNode,\n          transactionNumber:\n            current.LARGEINVOICETRANSACTIONNUMBER ||\n            current.LARGESTOVERDUEBALTRANSACTIONNUMBER ||\n            current.TRANSACTIONNUMBER ||\n            null\n        },\n        newWinner: {\n          customerKey: row.__customerKey,\n          metricKey: row.__metricKey,\n          currency: row.__originalCurrency,\n          compareAmount: row.__compareAmount,\n          originalAmount: row.__originalAmount,\n          sourceNode: row.__sourceNode,\n          transactionNumber:\n            row.LARGEINVOICETRANSACTIONNUMBER ||\n            row.LARGESTOVERDUEBALTRANSACTIONNUMBER ||\n            row.TRANSACTIONNUMBER ||\n            null\n        }\n      });\n    }\n\n    winnerMap[mapKey] = row;\n  }\n}\n\nvar winners = [];\n\nfor (var key in winnerMap) {\n  if (Object.prototype.hasOwnProperty.call(winnerMap, key)) {\n    winners.push(winnerMap[key]);\n  }\n}\n\nvar winnerMetricCounts = {};\nvar winnerSourceCounts = {};\nvar winnerFxMissingCounts = {};\nvar sampleWinnerByMetric = {};\nvar multiCandidateGroups = [];\nvar maxCandidatesInGroup = 0;\n\nfor (var w = 0; w < winners.length; w++) {\n  var winner = winners[w] || {};\n  var winnerMetricKey = winner.__metricKey || \"UNKNOWN\";\n  var winnerSourceNode = winner.__sourceNode || \"UNKNOWN\";\n  var winnerCurrency = winner.__originalCurrency || \"UNKNOWN\";\n  var winnerGroupKey = String(winner.__customerKey) + \"|\" + winnerMetricKey;\n  var candidateCount = candidateCountsByGroup[winnerGroupKey] || 0;\n\n  winnerMetricCounts[winnerMetricKey] = (winnerMetricCounts[winnerMetricKey] || 0) + 1;\n  winnerSourceCounts[winnerSourceNode] = (winnerSourceCounts[winnerSourceNode] || 0) + 1;\n\n  if (winner.__fxMissing) {\n    winnerFxMissingCounts[winnerCurrency] = (winnerFxMissingCounts[winnerCurrency] || 0) + 1;\n  }\n\n  if (!sampleWinnerByMetric[winnerMetricKey]) {\n    sampleWinnerByMetric[winnerMetricKey] = winner;\n  }\n\n  if (candidateCount > maxCandidatesInGroup) {\n    maxCandidatesInGroup = candidateCount;\n  }\n\n  if (candidateCount > 1 && multiCandidateGroups.length < 20) {\n    multiCandidateGroups.push({\n      groupKey: winnerGroupKey,\n      candidateCount: candidateCount,\n      winningCurrency: winner.__originalCurrency,\n      winningOriginalAmount: winner.__originalAmount,\n      winningCompareAmount: winner.__compareAmount,\n      sourceNode: winner.__sourceNode,\n      transactionNumber:\n        winner.LARGEINVOICETRANSACTIONNUMBER ||\n        winner.LARGESTOVERDUEBALTRANSACTIONNUMBER ||\n        winner.TRANSACTIONNUMBER ||\n        null\n    });\n  }\n}\n\nreturn winners;\n\nfunction readRowsFromNode(nodeName) {\n  var node = $context.$nodes[nodeName];\n\n  if (!node || !node.$output) {\n    return [];\n  }\n\n  var out = node.$output;\n\n  if (typeof out === \"string\") {\n    try {\n      out = JSON.parse(out);\n    } catch (e) {\n      return [];\n    }\n  }\n\n  if (Array.isArray(out)) {\n    return out;\n  }\n\n  var candidates = [\n    out.result,\n    out.rows,\n    out.body,\n    out.data,\n    out.items,\n    out.value,\n    out.records\n  ];\n\n  for (var i = 0; i < candidates.length; i++) {\n    var candidate = candidates[i];\n\n    if (typeof candidate === \"string\") {\n      try {\n        candidate = JSON.parse(candidate);\n      } catch (e2) {\n        candidate = null;\n      }\n    }\n\n    if (Array.isArray(candidate)) {\n      return candidate;\n    }\n\n    if (candidate 