        {
          "metadata": {
            "errorNodeId": "1780612724388",
            "name": "Convert to Policy Currency",
            "returnType": "object",
            "sourceCode": "var data = Array.isArray($context.$nodes.RESOLVE_CURRENCY_DATASET?.$output?.result)\n  ? $context.$nodes.RESOLVE_CURRENCY_DATASET.$output.result\n  : Array.isArray($context.$nodes.RESOLVE_CURRENCY_DATASET?.$output)\n    ? $context.$nodes.RESOLVE_CURRENCY_DATASET.$output\n    : [];\n\nvar fxPayload = $context.$nodes.EXTRACT_EXCHANGE_RATES?.$output?.result || {};\nvar targetCurrency = String(fxPayload.targetCurrency || \"USD\").trim().toUpperCase();\nvar fxRates = fxPayload.ratesByFromCurrency || {};\n\nfunction isMoneyArray(value) {\n  return Array.isArray(value) &&\n    value.length > 0 &&\n    value.every(function (item) {\n      return item &&\n        typeof item === \"object\" &&\n        (\"amount\" in item) &&\n        (\"currency\" in item);\n    });\n}\n\nfunction toNumber(value) {\n  if (value === null || value === undefined || value === \"\") {\n    return 0;\n  }\n\n  var n = Number(value);\n  return Number.isFinite(n) ? n : 0;\n}\n\nfunction convertAmount(amount, fromCurrency, toCurrency) {\n  var from = String(fromCurrency || \"\").trim().toUpperCase();\n  var to = String(toCurrency || \"\").trim().toUpperCase();\n  var numericAmount = toNumber(amount);\n\n  if (!from || !to || from === to) {\n    return numericAmount;\n  }\n\n  var rateInfo = fxRates[from];\n\n  if (!rateInfo) {\n    return numericAmount;\n  }\n\n  if (String(rateInfo.toCurrency || \"\").trim().toUpperCase() !== to) {\n    return numericAmount;\n  }\n\n  var rate = Number(rateInfo.conversionRate);\n\n  if (!Number.isFinite(rate)) {\n    return numericAmount;\n  }\n\n  return numericAmount * rate;\n}\n\nvar output = [];\n\nfor (var i = 0; i < data.length; i++) {\n  var record = data[i] || {};\n  var out = { ...record };\n\n  for (var key in record) {\n    if (!Object.prototype.hasOwnProperty.call(record, key)) {\n      continue;\n    }\n\n    if (isMoneyArray(record[key])) {\n      var convertedArray = [];\n\n      for (var j = 0; j < record[key].length; j++) {\n        var item = record[key][j] || {};\n        var originalCurrency = String(item.currency || \"\").trim().toUpperCase();\n\n        convertedArray.push({\n          ...item,\n          originalAmount: item.amount,\n          originalCurrency: originalCurrency,\n          convertedAmount: convertAmount(item.amount, originalCurrency, targetCurrency),\n          convertedCurrency: targetCurrency\n        });\n      }\n\n      out[key + \"CONVERTED\"] = convertedArray;\n    }\n  }\n\n  output.push(out);\n}\n\nreturn output;"
