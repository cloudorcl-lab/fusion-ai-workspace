            "sourceCode": "let personIdOutput = $context.$nodes.GET_PERSON_ID && $context.$nodes.GET_PERSON_ID.$output ? $context.$nodes.GET_PERSON_ID.$output : {};\nlet personIdItems = personIdOutput.items ? personIdOutput.items : [];\nlet personId = personIdItems.length > 0 ? personIdItems[0].PersonId : null;\n\nlet fallbackOutput = $context.$nodes.FIN_IEX_BO_GET_PERSON_ID_FOR_FAILURE && $context.$nodes.FIN_IEX_BO_GET_PERSON_ID_FOR_FAILURE.$output ? $context.$nodes.FIN_IEX_BO_GET_PERSON_ID_FOR_FAILURE.$output : {};\nlet fallbackItems = fallbackOutput.items ? fallbackOutput.items : [];\nlet fallbackPersonId = fallbackItems.length > 0 ? fallbackItems[0].PersonId : null;\n\nlet finalPersonId = personId !== undefined && personId !== null && personId !== \"\" ? personId : fallbackPersonId;\n\nreturn finalPersonId;"
