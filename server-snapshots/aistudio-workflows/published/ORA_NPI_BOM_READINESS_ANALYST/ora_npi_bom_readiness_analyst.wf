          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"ItemNumber\": {\n            \"type\": \"string\"\n          },\n          \"ItemId\": {\n            \"type\": \"string\"\n          },\n          \"ItemAttachment\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"items\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"AttachedDocumentId\": {\n                      \"type\": \"string\"\n                    },\n                    \"LastUpdateDate\": {\n                      \"type\": \"string\"\n                    },\n                    \"LastUpdatedBy\": {\n                      \"type\": \"string\"\n                    },\n                    \"EntityName\": {\n                      \"type\": \"string\"\n                    },\n                    \"DatatypeCode\": {\n                      \"type\": \"string\"\n                    },\n                    \"DatabaseDescription\": {\n                      \"type\": \"string\"\n                    },\n                    \"FileName\": {\n                      \"type\": \"string\"\n                    },\n                    \"DmFolderPath\": {},\n                    \"DmDocumentId\": {\n                      \"type\": \"string\"\n                    },\n                    \"DmVersionNumber\": {\n                      \"type\": \"string\"\n                    },\n                    \"Url\": {},\n                    \"DatabaseTitle\": {\n                      \"type\": \"string\"\n                    },\n                    \"CategoryName\": {\n                      \"type\": \"string\"\n                    },\n                    \"UserName\": {\n                      \"type\": \"string\"\n                    },\n                    \"Uri\": {},\n                    \"PrimaryCategoryFlag\": {\n                      \"type\": \"string\"\n                    },\n                    \"FileUrl\": {\n                      \"type\": \"string\"\n                    },\n                    \"UploadedText\": {},\n                    \"UploadedFileContentType\": {\n                      \"type\": \"string\"\n                    },\n                    \"UploadedFileLength\": {\n                      \"type\": \"string\"\n                    },\n                    \"UploadedFileName\": {},\n                    \"ContentRepositoryFileCheckedOutBy\": {\n                      \"type\": \"string\"\n                    },\n                    \"ContentRepositoryFileShared\": {\n                      \"type\": \"string\"\n                    },\n                    \"Title\": {\n                      \"type\": \"string\"\n                    },\n                    \"Description\": {\n                      \"type\": \"string\"\n                    },\n                    \"ErrorStatusCode\": {},\n                    \"ErrorStatusMessage\": {},\n                    \"CreatedBy\": {\n                      \"type\": \"string\"\n                    },\n                    \"CreationDate\": {\n                      \"type\": \"string\"\n                    },\n                    \"ExpirationDate\": {},\n                    \"LastUpdatedByUserName\": {\n                      \"type\": \"string\"\n                    },\n                    \"CreatedByUserName\": {\n                      \"type\": \"string\"\n                    },\n                    \"DownloadInfo\": {\n                      \"type\": \"string\"\n                    },\n                    \"DocumentURL\": {\n                      \"type\": \"string\"\n                    },\n                    \"ItemId\": {\n                      \"type\": \"string\"\n                    },\n                    \"OrganizationId\": {\n                      \"type\": \"string\"\n                    },\n                    \"RevisionId\": {},\n                    \"DataTypeName\": {\n                      \"type\": \"string\"\n                    },\n                    \"DocumentPreviewURL\": {\n                      \"type\": \"string\"\n                    },\n                    \"@context\": {\n                      \"type\": \"object\",\n                      \"properties\": {\n                        \"key\": {\n                          \"type\": \"string\"\n                        }\n                      },\n                      \"required\": [\n                        \"key\"\n                      ]\n                    }\n                  },\n                  \"required\": [\n                    \"AttachedDocumentId\",\n                    \"LastUpdateDate\",\n                    \"LastUpdatedBy\",\n                    \"EntityName\",\n                    \"DatatypeCode\",\n                    \"DatabaseDescription\",\n                    \"FileName\",\n                    \"DmFolderPath\",\n                    \"DmDocumentId\",\n                    \"DmVersionNumber\",\n                    \"Url\",\n                    \"DatabaseTitle\",\n                    \"CategoryName\",\n                    \"UserName\",\n                    \"Uri\",\n                    \"PrimaryCategoryFlag\",\n                    \"FileUrl\",\n                    \"UploadedText\",\n                    \"UploadedFileContentType\",\n                    \"UploadedFileLength\",\n                    \"UploadedFileName\",\n                    \"ContentRepositoryFileCheckedOutBy\",\n                    \"ContentRepositoryFileShared\",\n                    \"Title\",\n                    \"Description\",\n                    \"ErrorStatusCode\",\n                    \"ErrorStatusMessage\",\n                    \"CreatedBy\",\n                    \"CreationDate\",\n                    \"ExpirationDate\",\n                    \"LastUpdatedByUserName\",\n                    \"CreatedByUserName\",\n                    \"DownloadInfo\",\n                    \"DocumentURL\",\n                    \"ItemId\",\n                    \"OrganizationId\",\n                    \"RevisionId\",\n                    \"DataTypeName\",\n                    \"DocumentPreviewURL\",\n                    \"@context\"\n                  ]\n                }\n              },\n              \"count\": {\n                \"type\": \"number\"\n              },\n              \"hasMore\": {\n                \"type\": \"boolean\"\n              },\n              \"limit\": {\n                \"type\": \"number\"\n              },\n              \"offset\": {\n                \"type\": \"number\"\n              },\n              \"links\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"rel\": {\n                      \"type\": \"string\"\n                    },\n                    \"href\": {\n                      \"type\": \"string\"\n                    },\n                    \"name\": {\n                      \"type\": \"string\"\n                    },\n                    \"kind\": {\n                      \"type\": \"string\"\n                    }\n                  },\n                  \"required\": [\n                    \"rel\",\n                    \"href\",\n                    \"name\",\n                    \"kind\"\n                  ]\n                }\n              }\n            },\n            \"required\": [\n              \"items\",\n              \"count\",\n              \"hasMore\",\n              \"limit\",\n              \"offset\",\n              \"links\"\n            ]\n          },\n          \"@context\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"key\": {\n                \"type\": \"string\"\n              },\n              \"headers\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"ETag\": {\n                    \"type\": \"string\"\n                  }\n                },\n                \"required\": [\n                  \"ETag\"\n                ]\n              }\n            },\n            \"required\": [\n              \"key\",\n              \"headers\"\n            ]\n          }\n        },\n        \"required\": [\n          \"ItemNumber\",\n          \"ItemId\",\n          \"ItemAttachment\",\n          \"@context\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"items\"\n  ]\n}",
