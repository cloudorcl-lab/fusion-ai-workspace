            "sourceCode": "const appContext=$context.$triggers.REST.$input.OraAppContext;\nconst values = appContext.split(':');\nlet [itemId,orgCode,eff] = values;\nif(!itemId && !orgCode){\nthrow new Error(\"Item or Org not found in context\");\n}\nconst filterValues = {\nitemId: `${itemId}`,\norgCode: `${orgCode}`,\nitemSearchParams:`ItemId=${itemId} and OrganizationCode='${orgCode}'&fields=BillSequenceId,OrganizationId,ItemId,ItemNumber&onlyData=true`\n};\nreturn filterValues ;"
          },
