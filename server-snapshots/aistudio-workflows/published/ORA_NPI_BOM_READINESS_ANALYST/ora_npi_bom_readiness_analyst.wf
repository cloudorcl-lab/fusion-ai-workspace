        {
          "metadata": {
            "errorNodeId": "1769548355672",
            "name": "ExtractComponentImage",
            "returnType": "object",
            "sourceCode": "const payload = $context.$nodes.GETCOMPONENTIMAGE.$output;\nconst result = {}; \nconst items = payload && Array.isArray(payload.items) ? payload.items : []; \nfor (let i = 0; i < items.length; i++) { \nconst item = items[i]; if (!item || !item.ItemNumber) continue;\n\nconst attachments = item.ItemAttachment && Array.isArray(item.ItemAttachment.items) ? item.ItemAttachment.items : [];\nlet url = null;\nfor (let j = 0; j < attachments.length; j++) {\n  const a = attachments[j];\n  const flag = (a && a.PrimaryCategoryFlag != null ? String(a.PrimaryCategoryFlag) : '').toLowerCase();\n  const category = (a && a.CategoryName != null ? String(a.CategoryName) : '').toLowerCase();\n\n  if (a && typeof a.DocumentPreviewURL === \"string\" && flag === 'y' && category === 'image'){\n    url = a.DocumentPreviewURL;\n    break;\n  }\n}\n\nif (url) {\n  result[item.ItemNumber] = url.replace(/([?&]preview=)true\\b/g, \"$1false\");\n}\n\n} \nreturn result;"
          },
          "outcomes": {
            "success": "1761339623803"
          },
          "code": "EXTRACTCOMPONENTIMAGE",
