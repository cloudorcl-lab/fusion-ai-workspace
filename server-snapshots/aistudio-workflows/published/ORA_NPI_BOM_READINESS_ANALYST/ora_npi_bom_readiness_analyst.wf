        {
          "metadata": {
            "errorNodeId": "1769548355672",
            "name": "CreateItemList",
            "returnType": "object",
            "sourceCode": "var items = $context.$nodes.GETITEMDETAILSFROMBOM.$output.items;\nvar csv = \"\";\nfor (var i = 0; i < items.length; i++) {\nvar id = items[i] && items[i].ComponentItemId;\nif (!id) continue;\nif (csv.length > 0) csv += \",\";\ncsv += id;\n}\n\nconst filterValues = {\nitemList: `${csv}`,\nitemSearchParams:`Item.InventoryItemId in (${csv})&fields=Item.ItemNumber,Item.InventoryItemId,Item.Description.US,Item.ItemClass.ItemClassName.US,Item.CurrentPhaseCodeDisp.PhaseName.US,Item.ForcePurchaseLeadTimeFlag,Item.MustUseApprovedVendorFlag,ItemLevelDataPresenceIndicator.PendingChangeFlag,ItemLevelDataPresenceIndicator.QualityIssueFlag,ItemRevisionVersion.RevisionLevelDataPresenceIndicator.ItemRevAttachmentsFlag,ManufacturerItemRelation.MfgRelationshipStatus,ManufacturerItemRelation.ManufacturerItem.ManufacturerItemNumber,ManufacturerItemRelation.ManufacturerItem.Manufacturer.ManufacturerName`\n};\nreturn filterValues ;"
          },
          "outcomes": {
            "success": "1761231985521"
          },
