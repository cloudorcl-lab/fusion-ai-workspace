        {
          "metadata": {
            "name": "scenarioStatus",
            "returnType": "string",
            "sourceCode": "var data = $context.$nodes.VALIDATEINPUT.$output;\nvar scenarios = data && data.NextBestAction && data.NextBestAction.scenarios ? data.NextBestAction.scenarios : [];\nvar prioritization = data && data.CustomerPrioritization ? data.CustomerPrioritization : [];\nvar hasScenarioError = false;\nvar hasPrioritizationError = false;\nvar i;\n\nfor (i = 0; i < scenarios.length; i++) {\n  if (scenarios[i] && scenarios[i].status === \"ERROR\") {\n    hasScenarioError = true;\n    break;\n  }\n}\n\nfor (i = 0; i < prioritization.length; i++) {\n  if (prioritization[i] && prioritization[i].status === \"ERROR\") {\n    hasPrioritizationError = true;\n    break;\n  }\n}\n\nreturn (hasScenarioError || hasPrioritizationError) ? \"ERROR\" : \"SUCCESS\";",
            "language": "JAVASCRIPT",
            "errorNodeId": "1780642704822"
