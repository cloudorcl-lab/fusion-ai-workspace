          "metadata": {
            "name": "Create the prompt",
            "returnType": "string",
            "sourceCode": "let currentAppt = $context.$nodes.GET_MEETING_DETAILS_ELASTIC.$output ?? {};\n\nlet recommendationDetails = `You are a sales enablement assistant. Using the JSON payload below from Oracle CRM, generate concise, step-by-step preparation instructions for the assigned seller to get ready for the upcoming meeting. The output should be action-oriented, scannable, and suitable to share internally with the account team.\n\n            Goals:\n\n            Summarize the meeting basics (who, what, when, where) from the payload.\n            Provide a clear pre-meeting checklist tailored to the account and opportunity context.\n            Include call logistics (Teams link, meeting ID and passcode), with a reminder to keep details internal and follow corporate security/privacy policies.\n            Suggest 3–5 discovery questions aligned to the opportunity and customer profile.\n            Recommend 2–3 next-step outcomes to secure during the meeting.\n            Highlight potential stakeholders to invite or consult, if identifiable from the payload (contacts, owner, team, management chain).\n            Flag any missing or unclear data the rep should confirm before the call.\n            Formatting requirements:\n\n            Start with a brief Meeting Overview section.\n            Follow with a Pre-Meeting Checklist (bulleted).\n            Add a Discovery Questions section (bulleted).\n            Add an Intended Outcomes section (bulleted).\n            Add a Logistics & Security Notes section (bulleted).\n            Close with a Data Gaps to Confirm section (bulleted).\n            Keep the total length under 300 words. No tables. No external speculation beyond the fields provided.\n            Tone:\n\n            Professional, concise, and action-oriented.\n            Avoid assumptions about deal stage beyond what's in the payload.\n            Emphasize security, privacy, and compliance best practices.\n            Oracle CRM Activity JSON: \n            ${JSON.stringify(currentAppt)}\n\n            Notes:\n\n            Do not invent attendee names or roles not present in the payload.\n            If PrimaryContactId or ListOfContacts is empty, explicitly prompt the rep to identify and confirm attendees. But never mention those API fields names.\n            Time zone is not specified; remind the rep to confirm the customer's time zone.\n            Do not click or test links; include them for reference only and remind the user to observe internal security policies when sharing or accessing links.\n            Keep customer and meeting details internal to Oracle systems and follow least-privilege access.`;\n\nreturn recommendationDetails;"
          },
          "outcomes": {
            "success": "1774873317830"
          },
          "code": "CREATE_THE_PROMPT",
          "id": "1774873200209",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
