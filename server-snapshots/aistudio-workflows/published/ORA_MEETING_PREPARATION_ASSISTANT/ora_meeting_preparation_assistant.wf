        {
          "metadata": {
            "name": "Query for PMB Context",
            "returnType": "object",
            "sourceCode": "let leadNumber;\nlet optyNumber;\n\n// none has been set so that in case of only Contact in the meeting, it shouldn't give improper results.\nconst output = {\n    primaryId: \"-1\",\n    primaryObject: \"none\",\n    partyNumber: \"none\",\n    primaryTypeActivities: \"none\",\n    primaryTypeEmails: \"none\",\n    primaryTypeWrapups: \"none\",\n    primaryTypeNotes: \"none\",\n    QExpressionActivityAppointments: null,\n    QExpressionActivityTasks: null\n};\n\nconst appt = $context.$nodes.GET_MEETING_DETAILS_ELASTIC.$output?.[0] ?? null;\nconst oppty = $context.$nodes.GET_OPPORTUNITY_DETAILS_ELASTIC.$output?.[0] ?? null;\nconst lead = $context.$nodes.GET_LEAD_DETAILS_ELASTIC.$output?.[0] ?? null;\n\nif (!appt || typeof appt !== 'object' || Object.keys(appt).length === 0) {\n    return output;\n}\nif (oppty) {\n    optyNumber = $context.$nodes.GET_OPPORTUNITY_DETAILS_ELASTIC.$output?.[0]?.OptyNumber ?? null;\n}\nif (lead ) {\n    leadNumber = $context.$nodes.GET_LEAD_DETAILS_ELASTIC.$output?.[0]?.LeadNumber ?? null;\n}\n\nlet targetAttribute = \"ActivityId\";\n\n// 1. OPPORTUNITY\nif (appt.OpportunityId && typeof appt.OpportunityId === 'object' && appt.OpportunityId.OptyId) {\n    let opptyNum = appt?.OpportunityId?.OptyNumber;\n    output.primaryId = String(appt.OpportunityId.OptyId);\n    output.partyNumber = opptyNum ? String(opptyNum) : '';\n    output.primaryTypeActivities = \"OpportunityId\";\n    output.primaryTypeEmails = \"ORA_MOO_OPTY\";\n    output.primaryTypeWrapups = \"MOO_OPTY\";\n    output.primaryTypeNotes = \"opportunities\";\n    output.primaryObject = \"Opportunity\";\n\n    targetAttribute = \"OpportunityId.OptyId\";\n} \n\n// 2. LEAD\nelse if (appt.LeadId) {\n\n    const leadIdValue = appt.LeadId.LeadId ?? appt.LeadId;\n    let leadNum = appt.LeadId.LeadNumber || leadNumber || '';\n\n    output.primaryId = String(leadIdValue);\n    output.partyNumber = leadNum ? String(leadNum) : '';\n    output.primaryTypeActivities = \"LeadId\";\n    output.primaryTypeEmails = \"ORA_MKL_LM_LEADS\";\n    output.primaryTypeWrapups = \"MKL_LM_LEADS\";\n    output.primaryTypeNotes = \"leads\";\n    output.primaryObject = \"Lead\";\n\n    targetAttribute = \"LeadId\";\n} \n\n// 3. ACCOUNT\nelse {\n\n    const acct = appt.CustomerAccount || {};\n\n    if (acct.PartyId || appt.AccountId) {\n\n        output.primaryId = acct.PartyId ? String(acct.PartyId) : String(appt.AccountId);\n        output.partyNumber = acct.PartyNumber ? String(acct.PartyNumber) : \"\";\n        output.primaryTypeActivities = \"AccountId\";\n        output.primaryTypeEmails = \"ORA_HZ_ORGANIZATION_PROFILES\";\n        output.primaryTypeWrapups = \"HZ_ORGANIZATION_PROFILES\";\n        output.primaryTypeNotes = \"account\";\n        output.primaryObject = \"Account\";\n\n        targetAttribute = \"AccountId\";\n    }\n}\n\n// Compile Queries\nif (output.primaryId && targetAttribute) {\n\n    output.QExpressionActivityAppointments = {\n        op: '$and',\n        criteria: [\n            {\n                op: '$eq',\n                attribute: targetAttribute,\n                value: Number(output.primaryId)\n            },\n            {\n                op: '$eq',\n                attribute: \"ActivityFunctionCode\",\n                value: \"APPOINTMENT\"\n            }\n        ]\n    };\n\n    output.QExpressionActivityTasks = {\n        op: '$and',\n        criteria: [\n            {\n                op: '$eq',\n                attribute: targetAttribute,\n                value: Number(output.primaryId)\n            },\n            {\n                op: '$eq',\n                attribute: \"ActivityFunctionCode\",\n                value: \"TASK\"\n            }\n        ]\n    };\n}\n\n// ==============================\nconst extractedPartyNumber = appt.CustomerAccount?.PartyNumber;\nconst customerPartyId = appt.CustomerAccount?.PartyId;\n\n\n// -------------------------------\n// SUBSCRIPTIONS\n// -------------------------------\n\nlet listOfFinParties = [];\nlet listOfFinPartyNumbers = [];\nlet customerPartyIdsString='';\ncustomerPartyIdsString +=customerPartyId \n\ntry {\n  listOfFinParties = $context.$nodes.GET_FINANCIAL_PARTY_DATA.$output;\n} catch(e) {\n  listOfFinParties = [];\n}\n\n// Extract PartyNumbers safely\nif (listOfFinParties && listOfFinParties.items && listOfFinParties.items.length) {\n  for (let i = 0; i < listOfFinParties.items.length; i++) {\n    const party = listOfFinParties.items[i];\t\n    if (party && party.PartyNumber) {\n      listOfFinPartyNumbers.push(String(party.PartyNumber));\n\t  if (customerPartyIdsString ) {\n      customerPartyIdsString += ',';\n    }\n\t  customerPartyIdsString +=party.PartyId\n    }\n  }\n} else {\n  listOfFinPartyNumbers.push(String(extractedPartyNumber ));\n}\n\noutput.CustomerPartyIdsString = customerPartyIdsString ;\n\n\n\n\n\n// Build Subscription Query Expression\noutput.QExpressionSubscription = {\n  op: '$and',\n  criteria: [{\n    op: '$in',\n    attribute: 'ListOfParties.PartyNumber',\n    values: listOfFinPartyNumbers\n  },\n{\n        \"op\": \"$in\",\n      \"attribute\": \"Status\",\n      \"values\": [\"ORA_ACTIVE\",\"ORA_HOLD\",\"ORA_SUSPENDED\",\"ORA_UNDER_AMENDMENT\",\"ORA_EXPIRED\"]\n    }\n]\n};\n\noutput.SubscriptionPartyNumbers = listOfFinPartyNumbers;\n\n\n// -------------------------------\n// ASSETS\n// -------------------------------\n\noutput.QExpressionAssets = {\n  op: '$and',\n  criteria: [{\n    op: '$eq',\n    attribute: 'CustomerAccount.PartyNumber',\n    value: extractedPartyNumber \n  },\n{\n      \"op\": \"$eq\",\n      \"attribute\": \"StatusCode\",\n      \"value\": \"ACTIVE\"\n    }\n]\n};\n\n\n// -------------------------------\n// RETURN\n// -------------------------------\n\n\n\nreturn output;"
          },
          "outcomes": {
            "success": "1773752691385"
          },
          "code": "QUERY_FOR_PMB_CONTEXT",
          "convergenceTargetId": "1773316009919",
          "id": "1770714674204",
