{
  "workflowId": "300000331067874",
  "workflowCode": "ORA_MEETING_PREPARATION_ASSISTANT",
  "name": "Meeting Preparation Assistant",
  "description": "Eliminates manual meeting prep by distilling sales information from multiple records and recent customer interactions into a streamlined, actionable briefing for upcoming sales appointments, so sellers save time and focus on the conversation.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
