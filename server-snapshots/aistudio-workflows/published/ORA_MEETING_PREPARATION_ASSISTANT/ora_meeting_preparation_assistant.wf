        {
          "metadata": {
            "name": "Fetch Opty Details",
            "returnType": "array",
            "sourceCode": "const appt = $context.$nodes.GET_MEETING_DETAILS_ELASTIC.$output?.[0] ?? {};\nlet optyId = appt.OpportunityId.OptyId;\n\nlet filter = `opportunity.id = ${optyId} and sourceObjectCode='opportunities'`;\n\nlet payload = {\n  \"collection\": {\n    \"limit\": 1,\n    \"offset\": 0,\n    \"filter\": filter\n  },\n  \"fields\": [\n    \"progressionSummary\",\n    \"priorityReason\",\n    \"engagementInsightNumber\",\n    \"id\"\n  ],\n  \"accessors\": {\n    \"opportunity\": {\n      \"fields\": [\n        \"id\"\n      ]\n    },\n    \"salesPlay\": {\n      \"fields\": [\n        \"id\"\n      ]\n    }\n  }\n}\n\nreturn payload;"
          },
