        {
          "metadata": {
            "name": "Parse Input",
            "returnType": "object",
            "sourceCode": "/*Input Message Format - {\n    \"action\": {\n        \"config\": {\n            \"activityId\": 300100649514256,\n            \"checkOutcome\": \"N\"\n        }\n    }\n}*/\n\nconst inputMessage = $context.$triggers.REST.$input.action.config;\n\nconst extractedActivityId = inputMessage.activityId;\nconst checkOutcome= inputMessage.checkOutcome;\nconst scheduler= inputMessage.scheduler;\n\nconst output = {};\n\noutput.ActivityId = extractedActivityId;\noutput.CheckOutcome = checkOutcome;\n\n// Activity\noutput.QExpressionActivity = {\n  op: '$and',\n  criteria: [{\n    op: '$eq',\n    attribute: 'ActivityId',\n    value: extractedActivityId\n  }]\n};\n\nreturn output;"
          },
          "outcomes": {
            "success": "1770977084741"
          },
          "code": "PARSE_INPUT",
          "id": "1770981410844",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_CX_SALESFORCE_CXOBJECTSEARCHB",
            "functionName": "SEARCH_OBJECTS",
            "name": "Get meeting details elastic"
          },
          "outcomes": {
            "success": "1770984178036"
          },
          "code": "GET_MEETING_DETAILS_ELASTIC",
          "convergenceTargetId": "1770282051029",
          "id": "1770977084741",
          "inputs": [
            {
              "id": "1774513849514_1",
              "name": "object",
              "type": "string",
              "value": "Activity"
            },
            {
              "id": "1774513849515_2",
              "name": "q",
              "type": "string",
              "value": "{{$context.$nodes.PARSE_INPUT.$output.result.QExpressionActivity}}"
            },
            {
              "id": "1774513849516_3",
              "name": "sort",
              "type": "string"
            },
            {
              "id": "1774513849517_4",
              "name": "limit",
              "type": "integer"
            },
            {
              "id": "1774513849518_5",
              "name": "fields",
              "type": "string",
              "value": "[\"ActivityId\",\"Owner\",\"OpportunityId\",\"ListOfResourcesForTheTeam\",\"CallReportCount\",\"ListOfContacts\",\"PrimaryContactId\",\"CurrencyCode\",\"ListOfAttachments\",\"ActivityFunctionCode_localizedValue\",\"ActivityTypeCode_localizedValue\",\"CustomerAccount\",\"LeadId\",\"RecurRecType_localizedValue\",\"StatusCode\",\"ActivityStartDate\",\"ActivityEndDate\",\"SrId\",\"AppointmentStatus_localizedValue\",\"PriorityCode_localizedValue\",\"ActivityDescription\",\"AccountId\",\"PartnerPartyId\",\"Subject\",\"Location\",\"PriorityCode\",\"CustPartyType\",\"PrivateFlag\",\"ActivityNumber\"]"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Query for Common Context",
            "returnType": "object",
            "sourceCode": "// Access the direct object from the new Elastic node\nconst appt = $context.$nodes.GET_MEETING_DETAILS_ELASTIC.$output?.[0] ?? {};\n\n// Safe extraction using Optional Chaining (?.) to prevent \"null\" errors\nconst extractedPartyNumber = appt.CustomerAccount?.PartyNumber || \"\";\nconst extractedOpportunityId = appt.OpportunityId?.OptyId || \"\";\nconst extractedLeadId = appt.LeadId?.LeadId || appt.LeadId || \"\";\nconst extractedActivityId = appt.ActivityId || \"\";\nconst extractedPrimaryContactId = appt.PrimaryContactId?.PartyId || \"\";\n\nconst output = {};\nconst hasLead = (extractedLeadId  != null && extractedLeadId  !== \"\") ? \"Y\" : \"N\";\nconst hasOpty = (extractedOpportunityId  != null && extractedOpportunityId  !== \"\") ? \"Y\" : \"N\";\nconst hasAccount = (extractedPartyNumber != null && extractedPartyNumber !== \"\") ? \"Y\" : \"N\";\n\noutput.hasLead = hasLead ;\noutput.hasOpty = hasOpty;\noutput.hasAccount=hasAccount ;\n\n\n// Account\noutput.QExpressionAccount = {\n  op: '$and',\n  criteria: [{\n    op: '$eq',\n    attribute: 'PartyNumber',\n    value: extractedPartyNumber\n  }]\n};\n\n// Contacts\nlet listOfContacts = [];\nlet listOfPartyNumber = [];\nlet listOfPartyId = [];\n\n// Parse and validate the contacts list\ntry {\n  listOfContacts = $context.$nodes.GET_MEETING_DETAILS_ELASTIC.$output?.[0].ListOfContacts;\n} catch(e) {\n  // If parsing fails, set to empty array\n  listOfContacts = [];\n}\n\n// Extract PartyNumber from each contact, if structured as expected\nlistOfContacts?.forEach(contact => {\n  if (contact && contact.ContactId && contact.ContactId.PartyNumber) {\n    listOfPartyNumber.push(contact.ContactId.PartyNumber);\n  }\n});\n\n// Extract PartyId from each contact, if structured as expected\nlistOfContacts?.forEach(contact => {\n  if (contact && contact.ContactId && contact.ContactId.PartyId) {\n    listOfPartyId.push(contact.ContactId.PartyId);\n  }\n});\n\nlet ActivityContactPartyIdsString = '';\n// To fetch Activity contact engagement summary\nlistOfContacts?.forEach(contact => {\n if (contact && contact.ContactId && contact.ContactId.PartyId) {\n    if (ActivityContactPartyIdsString ) {\n      ActivityContactPartyIdsString += ',';\n    }\n    ActivityContactPartyIdsString += contact.ContactId.PartyId;\n  }\n});\n\noutput.ActivityContactPartyIdsString = ActivityContactPartyIdsString;\n\n// If any party numbers found, build the expression\n\n  output.QExpressionContact = {\n    op: '$and',\n    criteria: [{\n      op: '$in',\n      attribute: 'PartyNumber',\n      values: listOfPartyNumber\n    }]\n  };\n\noutput.ContactPartyNumbers = listOfPartyNumber;\noutput.ContactPartyIds = listOfPartyId;\n\n// Opportunity Query Expression\noutput.QExpressionOpportunity = {\n    op: \"$and\",\n    criteria: [{\n        op: \"$eq\",\n        attribute: \"OptyId\",\n        value: extractedOpportunityId\n    }]\n};\n\n// Lead Query Expression\noutput.QExpressionLead = {\n    op: \"$and\",\n    criteria: [{\n        op: \"$eq\",\n        attribute: \"LeadId\",\n        value: extractedLeadId\n    }]\n};\n\n// Primary Contact Query Expression\noutput.QExpressionPrimaryContact = {\n    op: \"$and\",\n    criteria: [{\n        op: \"$eq\",\n        attribute: \"PartyId\",\n        value: extractedPrimaryContactId\n    }]\n};\n\n// Activity for Talking Points Query Expression\noutput.QExpressionActivity = {\n    op: \"$and\",\n    criteria: [{\n        op: \"$eq\",\n        attribute: \"ActivityId\",\n        value: extractedActivityId\n    }]\n};\n\nreturn output;"
          },
          "outcomes": {
            "success": "1775983094850"
          },
          "code": "QUERY_FOR_COMMON_CONTEXT",
          "id": "1770984178036",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Compile Router Context",
            "returnType": "string",
            "sourceCode": "/// 1. Meeting Details\nvar appointment = $context.$nodes.GET_MEETING_DETAILS_ELASTIC.$output?.[0] ?? {};\n\n/// 2. Opportunity + Lead\nvar opportunity = appointment.OpportunityId || null;\nvar lead = appointment.LeadId || null;\n\nvar hasOpportunity = (opportunity && (opportunity.OptyId || opportunity.Name)) ? \"YES\" : \"NO\";\nvar hasLead = (lead && (lead.LeadId || lead.Name)) ? \"YES\" : \"NO\";\n\nvar opportunityName = opportunity ? (opportunity.Name || \"N/A\") : \"None\";\nvar leadName = lead ? (lead.Name || \"N/A\") : \"None\";\n\n/// 3. Account + Metadata\nvar accountName = (appointment.CustomerAccount && appointment.CustomerAccount.PartyName) ? appointment.CustomerAccount.PartyName : \"Unknown Account\";\nvar meetingType = appointment.ActivityTypeCode_localizedValue || \"Meeting\";\n\n/// 4. Clean Description\nvar description = appointment.ActivityDescription\n    ? appointment.ActivityDescription.replace(/<[^>]*>/g, ' ')\n    : \"N/A\";\n\ndescription = description.replace(/\\s+/g, ' ').trim();\nif (description.length > 800) {\n    description = description.substring(0, 800);\n}\n\n/// 5. Internal Attendees (from Elastic Response)\nvar internalTeam = [];\nif (appointment.ListOfResourcesForTheTeam && Array.isArray(appointment.ListOfResourcesForTheTeam)) {\n    internalTeam = appointment.ListOfResourcesForTheTeam.map(function(res) {\n        var p = res.AssigneeId || {};\n        var role = p.ResourceRoleName || \"Internal\";\n        return (p.PartyName || \"Unknown\").trim() + \" [\" + role + \"]\";\n    });\n}\n\nvar internalAttendeesString = internalTeam.length > 0 ? internalTeam.join(\"; \") : \"None listed\";\n\n/// 6. External Contacts (from GET_CONTACT_DETAILS)\nvar contactsRaw = $context.$nodes.GET_CONTACT_DETAILS.$output;\nvar externalContacts = [];\n\nif (contactsRaw && Array.isArray(contactsRaw)) {\n    externalContacts = contactsRaw.map(function(c) {\n        var name = c.PersonName || \"Unknown\";\n        var title = c.JobTitle || \"External\";\n        return name.trim() + \" [\" + title + \"]\";\n    });\n}\n\nvar externalAttendeesString = externalContacts.length > 0 ? externalContacts.join(\"; \") : \"None listed\";\n\n/// 7. Build Router Context\nvar router_context =\n    \"Account: \" + accountName + \"\\n\" +\n    \"Title: \" + (appointment.Subject || \"N/A\") + \" (\" + meetingType + \")\\n\" +\n    \"Opportunity: \" + opportunityName + \" (Has Opty: \" + hasOpportunity + \")\\n\" +\n    \"Lead: \" + leadName + \" (Has Lead: \" + hasLead + \")\\n\" +\n    \"Internal Attendees: \" + internalAttendeesString + \"\\n\" +\n    \"External Attendees: \" + externalAttendeesString + \"\\n\" +\n    \"Description: \" + description;\n\nreturn router_context;"
          },
          "outcomes": {
            "success": "1773315853145"
          },
          "code": "COMPILE_ROUTER_CONTEXT",
          "convergenceTargetId": "1770983825084",
          "id": "1770613202957",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
