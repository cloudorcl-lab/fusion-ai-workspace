            "sourceCode": "const insightId = $context.$variables.engagementinsightid ;\nlet factsObject = {}\n\nif (insightId){\nfactsObject = $context.$nodes.GENERATE_BRIEF_WITH_ORCHESTRATION.$output;\n} else {\nfactsObject = $context.$nodes.GENERATE_PREMEETING_BRIEF.$output ;\n}\n\nfactsObject.meetingDetails = $context.$nodes.ADD_MEETING_DETAILS.$output.meetingDetails ;\nfactsObject.footer= $context.$nodes.ADD_MEETING_DETAILS.$output.footer;\n\nif( $context.$triggers.REST.$input.action.config.scheduler !== \"Y\" ) {\n      return factsObject ;\n} else {\n      return {\"action\":\"success\"};\n}"
