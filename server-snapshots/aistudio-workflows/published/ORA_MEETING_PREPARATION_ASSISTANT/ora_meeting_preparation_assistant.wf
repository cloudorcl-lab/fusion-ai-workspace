          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"Generated schema for Root\",\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"_entity\": {\n        \"type\": \"string\"\n      },\n      \"PartyId\": {\n        \"type\": \"number\"\n      },\n      \"PersonName\": {\n        \"type\": \"string\"\n      },\n      \"PrimaryAddress\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"CountryCode_localizedValue\": {\n            \"type\": \"string\"\n          },\n          \"FormattedAddress\": {\n            \"type\": \"string\"\n          },\n          \"PostalCode\": {\n            \"type\": \"string\"\n          },\n          \"City\": {\n            \"type\": \"string\"\n          },\n          \"LocationEOObjectVersionNumber\": {\n            \"type\": \"number\"\n          },\n          \"Province\": {\n            \"type\": \"string\"\n          },\n          \"CurrencyCode\": {\n            \"type\": \"string\"\n          },\n          \"PartySiteNumber\": {\n            \"type\": \"string\"\n          },\n          \"ObjectVersionNumber\": {\n            \"type\": \"number\"\n          },\n          \"State\": {\n            \"type\": \"string\"\n          },\n          \"PartySiteId\": {\n            \"type\": \"number\"\n          },\n          \"CurrencyCode_localizedValue\": {\n            \"type\": \"string\"\n          },\n          \"CountryCode\": {\n            \"type\": \"string\"\n          },\n          \"ListOfPartySiteUses\": {},\n          \"OverallPrimary\": {\n            \"type\": \"boolean\"\n          }\n        },\n        \"required\": [\n          \"CountryCode_localizedValue\",\n          \"FormattedAddress\",\n          \"PostalCode\",\n          \"City\",\n          \"LocationEOObjectVersionNumber\",\n          \"Province\",\n          \"CurrencyCode\",\n          \"PartySiteNumber\",\n          \"ObjectVersionNumber\",\n          \"State\",\n          \"PartySiteId\",\n          \"CurrencyCode_localizedValue\",\n          \"CountryCode\",\n          \"ListOfPartySiteUses\",\n          \"OverallPrimary\"\n        ]\n      },\n      \"ContactRollup\": {},\n      \"PrimaryAccount\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"AccountHierarchySummary\": {},\n          \"PartyNumber\": {\n            \"type\": \"string\"\n          },\n          \"PrimaryAddress\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"CountryCode_localizedValue\": {\n                \"type\": \"string\"\n              },\n              \"PartySiteNumber\": {\n                \"type\": \"string\"\n              },\n              \"State\": {\n                \"type\": \"string\"\n              },\n              \"PartySiteId\": {\n                \"type\": \"number\"\n              },\n              \"FormattedAddress\": {\n                \"type\": \"string\"\n              },\n              \"PostalCode\": {\n                \"type\": \"string\"\n              },\n              \"City\": {\n                \"type\": \"string\"\n              },\n              \"CountryCode\": {\n                \"type\": \"string\"\n              },\n              \"ListOfPartySiteUses\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"SiteUseType_localizedValue\": {\n                      \"type\": \"string\"\n                    },\n                    \"SiteUseType\": {\n                      \"type\": \"string\"\n                    },\n                    \"PrimaryPerType\": {\n                      \"type\": \"boolean\"\n                    }\n                  },\n                  \"required\": [\n                    \"SiteUseType_localizedValue\",\n                    \"SiteUseType\",\n                    \"PrimaryPerType\"\n                  ]\n                }\n              },\n              \"Province\": {\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\n              \"CountryCode_localizedValue\",\n              \"PartySiteNumber\",\n              \"State\",\n              \"PartySiteId\",\n              \"FormattedAddress\",\n              \"PostalCode\",\n              \"City\",\n              \"CountryCode\",\n              \"ListOfPartySiteUses\",\n              \"Province\"\n            ]\n          },\n          \"PromotedAccount\": {},\n          \"PartyId\": {\n            \"type\": \"number\"\n          },\n          \"PromotedFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"PartyUniqueName\": {\n            \"type\": \"string\"\n          },\n          \"PartyName\": {\n            \"type\": \"string\"\n          },\n          \"ListOfPartyUsageAssignments\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"PartyUsageCode_localizedValue\": {\n                  \"type\": \"string\"\n                },\n                \"PartyUsageCode\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"required\": [\n                \"PartyUsageCode_localizedValue\",\n                \"PartyUsageCode\"\n              ]\n            }\n          },\n          \"OrganizationProfileId\": {\n            \"type\": \"number\"\n          }\n        },\n        \"required\": [\n          \"AccountHierarchySummary\",\n          \"PartyNumber\",\n          \"PrimaryAddress\",\n          \"PromotedAccount\",\n          \"PartyId\",\n          \"PromotedFlag\",\n          \"PartyUniqueName\",\n          \"PartyName\",\n          \"ListOfPartyUsageAssignments\",\n          \"OrganizationProfileId\"\n        ]\n      },\n      \"SalesAffinityCode_localizedValue\": {},\n      \"SalesBuyingRoleCode_localizedValue\": {},\n      \"JobTitle\": {\n        \"type\": \"string\"\n      },\n      \"SalesAffinityCode\": {},\n      \"SalesBuyingRoleCode\": {},\n      \"PartyNumber\": {\n        \"type\": \"string\"\n      }\n    },\n    \"required\": [\n      \"_entity\",\n      \"PartyId\",\n      \"PersonName\",\n      \"ContactRollup\",\n      \"PrimaryAccount\",\n      \"SalesAffinityCode_localizedValue\",\n      \"SalesBuyingRoleCode_localizedValue\",\n      \"JobTitle\",\n      \"SalesAffinityCode\",\n      \"SalesBuyingRoleCode\",\n      \"PartyNumber\"\n    ]\n  }\n}",
