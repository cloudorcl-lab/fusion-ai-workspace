            "sourceCode": "const payload= $context.$nodes.GET_OUTCOME.$output?.items?.[0].payload;\nlet facts = JSON.parse(payload).what.facts;\n\nfacts.meetingDetails = $context.$nodes.MODIFY_OUTCOME_CONTENT.$output.meetingDetails;\nfacts.footer = $context.$nodes.MODIFY_OUTCOME_CONTENT.$output.footer;\n\nreturn facts;"
