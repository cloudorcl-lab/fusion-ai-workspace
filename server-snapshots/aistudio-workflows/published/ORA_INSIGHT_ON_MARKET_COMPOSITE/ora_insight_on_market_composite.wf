  "workflowId": "300000331068247",
  "workflowCode": "ORA_INSIGHT_ON_MARKET_COMPOSITE",
  "name": "Insight on Market Composite",
  "description": "Translates market survey percentiles and target data into clear compensation explanations for managers.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
