        {
          "metadata": {
            "name": "AV BV Request Metadata",
            "returnType": "array",
            "sourceCode": "let sources = $context.$triggers.REST.$input.inputParams.journalSource;\nsources = Array.isArray(sources) ? sources : [sources].filter(Boolean);\n\nlet chartOfAccountsId = $context.$triggers.REST.$input.inputParams.chartOfAccountsId;\nlet insightDetails = $context.$triggers.REST.$input.inputParams.insightDetails;\n\nlet others = [\n  {\n    journalSource: 'Others',\n    module: 'oraErpCoreAccountingEntries',\n    businessObject: 'JournalLine',\n    view: 'generalLedgerJournalDetail',\n    key: 'generalLedgerJournalDetail',\n    fieldAliases: {\n      \"header.batch.description\": \"batchDescription\",\n      \"ledger.ledgerId\": \"ledgerId\",\n      // [`account<${chartOfAccountsId}>.ora_flex_aff__xVfUAccount.description`]: \"accountDescription\",\n      \"header.batch.errorMessage\": \"errorMessage\",\n      \"periodName\": \"periodName\",\n      \"description\": \"lineDescription\",\n      // [`account<${chartOfAccountsId}>.ora_flex_aff__xVfUCostUCenter.value`]: \"costCenter\",\n      \"header.batch.name\": \"batchName\",\n      \"netEnteredAmount\": \"netEnteredAmount\",\n      \"ledger.name\": \"ledgerName\",\n      \"netAccountedAmount\": \"netAccountedAmount\",\n      // [`account<${chartOfAccountsId}>.ora_flex_aff__xVfUCostUCenter.description`]: \"costCenterDescription\",\n      \"header.name\": \"journalName\",\n      \"dateCreated\": \"dateCreated\",\n      \"currency.currencyCode\": \"enteredCurrency\",\n      \"account.concatenatedSegments\": \"concatenatedSegments\",\n      \"journalLineNumber\": \"journalLineNumber\",\n      \"currencyConversionDate\": \"currencyConversionDate\",\n      \"accountingDate\": \"accountingDate\",\n      \"updatedBy\": \"updatedBy\",\n      \"accountedCredit\": \"accountedCredit\",\n      \"header.journalSource.userJeSourceName\": \"journalSource\",\n      \"header.description\": \"journalDescription\",\n      \"ledger.currency.currencyCode\": \"ledgerCurrencyCode\",\n      \"header.batch.lookupBatchStatus.meaning\": \"batchStatus\",\n      \"dateUpdated\": \"dateUpdated\",\n      // [`account<${chartOfAccountsId}>.ora_flex_aff__xVfUCompany.value`]: \"company\",\n      \"createdBy\": \"createdBy\",\n      \"header.batch.lookupBatchStatus.lookupCode\": \"batchStatusCode\",\n      \"accountedDebit\": \"accountedDebit\",\n      // [`account<${chartOfAccountsId}>.ora_flex_aff__xVfUCompany.description`]: \"companyDescription\",\n      // [`account<${chartOfAccountsId}>.ora_flex_aff__xVfUAccount.value`]: \"account\",\n      \"enteredDebit\": \"enteredDebit\",\n      \"enteredCredit\": \"enteredCredit\",\n      \"currencyConversionRate\": \"currencyConversionRate\",\n      \"header.journalCategory.userJeCategoryName\": \"journalCategory\"\n    },\n    type: 'bv'\n  }\n];\n\nlet receivables = [\n  {\n    journalSource: 'Receivables',\n    module: 'oraErpCoreReceivablesPayments',\n    businessObject: 'ReceivablesCoreTransactionAccountingEntryDistribution',\n    view: 'receivablesAccountedCoreTransactionDetail',\n    key: 'receivablesAccountedCoreTransactionDetail',\n    fieldAliases: {\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUCostUCenter.value`]: \"costCenter\",\n      \"unroundedAccountedDebit\": \"accountedDebit\",\n      \"coreTransactionDistribution.transactionHeader.billToCustomerAccount.customer.name\": \"billToCustomerName\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUCompany.value`]: \"company\",\n      \"subledgerAccountingEntryLine.subledgerAccountingEntryHeader.accountingEntryStatusLookup.meaning\": \"accountingEntryStatus\",\n      \"unroundedEnteredCredit\": \"enteredCredit\",\n      \"subledgerAccountingEntryLine.subledgerAccountingEntryHeader.legalEntity.legalEntityName\": \"legalEntity\",\n      \"subledgerAccountingEntryLine.ledger.name\": \"ledgerName\",\n      \"coreTransactionDistribution.accountClass\": \"accountClass\",\n      \"coreTransactionDistribution.transactionLine.inventoryItem.itemNumber\": \"ItemNumber\",\n      \"accountingPeriod\": \"accountingPeriod\",\n      \"coreTransactionDistribution.transactionHeader.transactionDate\": \"transactionDate\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUAccount.description`]: \"accountDescription\",\n      \"subledgerAccountingEntryLine.ledger.currency.currencyCode\": \"ledgerCurrencyCode\",\n      \"coreTransactionDistribution.transactionLine.description\": \"ctlDesc\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUCompany.description`]: \"companyDescription\",\n      \"coreTransactionDistribution.transactionHeader.customerTransactionType.name\": \"transactionTypeName\",\n      \"subledgerAccountingEntryLine.accountingDate\": \"accountingDate\",\n      \"coreTransactionDistribution.transactionLine.lineNumber\": \"ctlLineNum\",\n      \"coreTransactionDistribution.transactionHeader.comments\": \"transactionComments\",\n      \"subledgerAccountingEntryLine.enteredCurrency.currencyCode\": \"EnteredCurrency\",\n      \"unroundedEnteredDebit\": \"enteredDebit\",\n      \"subledgerAccountingEntryLine.accountingClassLookup.lookupCode\": \"accountingClassCode\",\n      \"coreTransactionDistribution.amount\": \"distributionAmount\",\n      \"subledgerAccountingEntryLine.ledger.ledgerId\": \"ledgerId\",\n      \"coreTransactionDistribution.transactionHeader.transactionNumber\": \"transactionNumber\",\n      \"unroundedAccountedCredit\": \"accountedCredit\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUCostUCenter.description`]: \"costCenterDescription\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUAccount.value`]: \"account\",\n      \"coreTransactionDistribution.businessUnit.name\": \"businessName\"\n    },\n    type: 'bv'\n  },\n  {\n    journalSource: 'Receivables',\n    module: 'oraErpCoreReceivablesPayments',\n    businessObject: 'ReceivablesAdjustmentAccountingEntryDistribution',\n    view: 'receivablesAccountedAdjustmentDetail',\n    key: 'receivablesAccountedAdjustmentDetail',\n    fieldAliases: {\n      \"subledgerAccountingEntryLine.ledger.name\": \"ledgerName\",\n      \"subledgerAccountingEntryLine.ledger.currency.currencyCode\": \"ledgerCurrencyCode\",\n      \"receivablesAdjustmentDistribution.billingAdjustment.number\": \"baNumber\",\n      \"receivablesAdjustmentDistribution.billingAdjustment.adjustmentType.meaning\": \"baType\",\n      \"receivablesAdjustmentDistribution.billingAdjustment.customerTransaction.billToCustomerAccount.customer.name\": \"billToCustomerName\",\n      \"receivablesAdjustmentDistribution.billingAdjustment.adjustmentDate\": \"adjustmentDate\",\n      \"receivablesAdjustmentDistribution.billingAdjustment.activity.name\": \"activityName\",\n      \"receivablesAdjustmentDistribution.billingAdjustment.reason\": \"adjustmentReason\",\n      \"receivablesAdjustmentDistribution.billingAdjustment.customerTransaction.transactionNumber\": \"baTransNumber\",\n      \"receivablesAdjustmentDistribution.billingAdjustment.adjustmentAmount\": \"adjustmentAmount\",\n      \"subledgerAccountingEntryLine.enteredCurrency.currencyCode\": \"EnteredCurrency\",\n      \"unroundedEnteredDebit\": \"enteredDebit\",\n      \"unroundedEnteredCredit\": \"enteredCredit\",\n      \"unroundedAccountedDebit\": \"accountedDebit\",\n      \"unroundedAccountedCredit\": \"accountedCredit\",\n      \"subledgerAccountingEntryLine.subledgerAccountingEntryHeader.legalEntity.legalEntityName\": \"legalEntity\",\n      \"receivablesAdjustmentDistribution.businessUnit.name\": \"buName\",\n      \"subledgerAccountingEntryLine.subledgerAccountingEntryHeader.accountingEntryStatusLookup.meaning\": \"accountingEntryStatus\",\n      \"accountingPeriod\": \"accountingPeriod\",\n      \"subledgerAccountingEntryLine.accountingClassLookup.lookupCode\": \"accountingClassCode\",\n      \"subledgerAccountingEntryLine.accountingClassLookup.meaning\": \"accountingClass\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUCostUCenter.value`]: \"costCenter\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUCompany.value`]: \"company\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUAccount.description`]: \"accountDescription\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUCompany.description`]: \"companyDescription\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUCostUCenter.description`]: \"costCenterDescription\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUAccount.value`]: \"account\"\n    },\n    type: 'bv'\n  },\n  {\n    journalSource: 'Receivables',\n    module: 'oraErpCoreReceivablesPayments',\n    businessObject: 'ReceivablesCreditMemoApplicationAccountingEntryDistribution',\n    view: 'receivablesAccountedCreditMemoApplicationDetail',\n    key: 'receivablesAccountedCreditMemoApplicationDetail',\n    fieldAliases: {\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUCostUCenter.value`]: \"costCenter\",\n      \"creditMemoApplicationDistribution.creditMemoApplication.appliedCustomerTransaction.transactionNumber\": \"appliedTrxNumber\",\n      \"unroundedAccountedDebit\": \"accountedDebit\",\n      \"creditMemoApplicationDistribution.creditMemoApplication.customerTransaction.customerTransactionType.name\": \"trxTypeName\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUCompany.value`]: \"company\",\n      \"subledgerAccountingEntryLine.subledgerAccountingEntryHeader.accountingEntryStatusLookup.meaning\": \"accountingEntryStatus\",\n      \"creditMemoApplicationDistribution.creditMemoApplication.customerTransaction.transactionDate\": \"trxDate\",\n      \"unroundedEnteredCredit\": \"enteredCredit\",\n      \"subledgerAccountingEntryLine.subledgerAccountingEntryHeader.legalEntity.legalEntityName\": \"legalEntityName\",\n      \"subledgerAccountingEntryLine.ledger.name\": \"ledgerName\",\n      \"accountingPeriod\": \"accountingPeriod\",\n      \"creditMemoApplicationDistribution.creditMemoApplication.transactionLine.description\": \"trxLineDesc\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUAccount.description`]: \"accountDescription\",\n      \"creditMemoApplicationDistribution.creditMemoApplication.customerTransaction.transactionNumber\": \"trxNumber\",\n      \"subledgerAccountingEntryLine.ledger.currency.currencyCode\": \"ledgerCurrencyCode\",\n      \"creditMemoApplicationDistribution.creditMemoApplication.transactionLine.lineNumber\": \"trxLineNumber\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUCompany.description`]: \"companyDescription\",\n      \"subledgerAccountingEntryLine.accountingDate\": \"accountingDate\",\n      \"creditMemoApplicationDistribution.businessUnit.name\": \"buName\",\n      \"subledgerAccountingEntryLine.enteredCurrency.currencyCode\": \"enteredCurrCode\",\n      \"unroundedEnteredDebit\": \"enteredDebit\",\n      \"subledgerAccountingEntryLine.ledger.ledgerId\": \"ledgerId\",\n      \"creditMemoApplicationDistribution.creditMemoApplication.customerTransaction.billToCustomerAccount.customer.name\": \"customerName\",\n      \"unroundedAccountedCredit\": \"accountedCredit\",\n      \"creditMemoApplicationDistribution.creditMemoApplication.appliedAmount\": \"appliedAmount\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUCostUCenter.description`]: \"costCenterDescription\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUAccount.value`]: \"account\"\n    },\n    type: 'bv'\n  },\n  {\n    journalSource: 'Receivables',\n    module: 'oraErpCoreReceivablesPayments',\n    businessObject: 'ReceivablesReceiptAccountingEntryDistribution',\n    view: 'receivablesAccountedMiscellaneousReceiptDetail',\n    key: 'receivablesAccountedMiscellaneousReceiptDetail',\n    fieldAliases: {\n      \"subledgerAccountingEntryLine.ledger.name\": \"ledgerName\",\n      \"subledgerAccountingEntryLine.ledger.currency.currencyCode\": \"ledgerCurrencyCode\",\n      \"receivablesMiscellaneousReceiptDistribution.miscellaneousReceiptDistribution.receipt.receiptNumber\": \"receiptNumber\",\n      \"receivablesMiscellaneousReceiptDistribution.miscellaneousReceiptDistribution.receipt.activity.name\": \"activityName\",\n      \"receivablesMiscellaneousReceiptDistribution.miscellaneousReceiptDistribution.receipt.receiptStatus.meaning\": \"receiptStatus\",\n      \"receivablesMiscellaneousReceiptDistribution.miscellaneousReceiptDistribution.receipt.receiptDate\": \"receiptDate\",\n      \"receivablesMiscellaneousReceiptDistribution.miscellaneousReceiptDistribution.receipt.receiptAmount\": \"receiptAmount\",\n      \"subledgerAccountingEntryLine.enteredCurrency.currencyCode\": \"EnteredCurrency\",\n      \"unroundedEnteredDebit\": \"enteredDebit\",\n      \"unroundedEnteredCredit\": \"enteredCredit\",\n      \"unroundedAccountedDebit\": \"accountedDebit\",\n      \"unroundedAccountedCredit\": \"accountedCredit\",\n      \"subledgerAccountingEntryLine.subledgerAccountingEntryHeader.legalEntity.legalEntityName\": \"legalEntity\",\n      \"receivablesMiscellaneousReceiptDistribution.businessUnit.name\": \"businessName\",\n      \"subledgerAccountingEntryLine.accountingDate\": \"accountingDate\",\n      \"receivablesMiscellaneousReceiptDistribution.miscellaneousReceiptDistribution.receipt.bankAccountUse.bankAccount.bank.name\": \"bankName\",\n      \"receivablesMiscellaneousReceiptDistribution.miscellaneousReceiptDistribution.receipt.receiptMethod.name\": \"receiptMethodName\",\n      \"subledgerAccountingEntryLine.subledgerAccountingEntryHeader.accountingEntryStatusLookup.meaning\": \"accountingEntryStatus\",\n      \"accountingPeriod\": \"accountingPeriod\",\n      \"subledgerAccountingEntryLine.accountingClassLookup.lookupCode\": \"accountingClassCode\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUCostUCenter.value`]: \"costCenter\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUCompany.value`]: \"company\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUAccount.description`]: \"accountDescription\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUCompany.description`]: \"companyDescription\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUCostUCenter.description`]: \"costCenterDescription\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUAccount.value`]: \"account\"\n    },\n    type: 'bv'\n  },\n  {\n    journalSource: 'Receivables',\n    module: 'oraErpCoreReceivablesPayments',\n    businessObject: 'ReceivablesReceiptAccountingEntryDistribution',\n    view: 'receivablesAccountedStandardReceiptDetail',\n    key: 'receivablesAccountedStandardReceiptDetail',\n    fieldAliases: {\n      \"subledgerAccountingEntryLine.ledger.name\": \"ledgerName\",\n      \"subledgerAccountingEntryLine.ledger.currency.currencyCode\": \"ledgerCurrencyCode\",\n      \"receivablesReceiptDistribution.receiptApplication.receipt.receiptNumber\": \"receiptNumber\",\n      \"receivablesReceiptDistribution.receiptApplication.receipt.customerAccount.customer.name\": \"customerName\",\n      \"receivablesReceiptDistribution.receiptApplication.receipt.receiptStatus.meaning\": \"receiptStatus\",\n      \"receivablesReceiptDistribution.receiptApplication.receipt.receiptDate\": \"receiptDate\",\n      \"receivablesReceiptDistribution.receiptApplication.appliedCustomerTransaction.transactionNumber\": \"appliedTransactionNumber\",\n      \"receivablesReceiptDistribution.receiptApplication.receipt.receiptAmount\": \"receiptAmount\",\n      \"subledgerAccountingEntryLine.enteredCurrency.currencyCode\": \"EnteredCurrency\",\n      \"unroundedEnteredDebit\": \"enteredDebit\",\n      \"unroundedEnteredCredit\": \"enteredCredit\",\n      \"unroundedAccountedDebit\": \"accountedDebit\",\n      \"unroundedAccountedCredit\": \"accountedCredit\",\n      \"subledgerAccountingEntryLine.subledgerAccountingEntryHeader.legalEntity.legalEntityName\": \"legalEntity\",\n      \"receivablesReceiptDistribution.businessUnit.name\": \"businessName\",\n      \"subledgerAccountingEntryLine.accountingDate\": \"accountingDate\",\n      \"receivablesReceiptDistribution.receiptApplication.receipt.bankAccountUse.bankAccount.bank.name\": \"bankName\",\n      \"receivablesReceiptDistribution.receiptApplication.receipt.receiptMethod.name\": \"receiptMethodName\",\n      \"subledgerAccountingEntryLine.subledgerAccountingEntryHeader.accountingEntryStatusLookup.meaning\": \"accountingEntryStatus\",\n      \"accountingPeriod\": \"accountingPeriod\",\n      \"subledgerAccountingEntryLine.accountingClassLookup.lookupCode\": \"accountingClassCode\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUCostUCenter.value`]: \"costCenter\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUCompany.value`]: \"company\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUAccount.description`]: \"accountDescription\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUCompany.description`]: \"companyDescription\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUCostUCenter.description`]: \"costCenterDescription\",\n      // [`subledgerAccountingEntryLine.account<${chartOfAccountsId}>.ora_flex_aff__xVfUAccount.value`]: \"account\"\n    },\n    type: 'bv'\n  },\n  {\n    journalSource: 'Receivables',\n    module: 'oraErpCoreReceivablesPayments',\n    businessObject: 'ReceivablesReceiptAccountingEntryDistribution',\n    view: 'receivablesAccountedCashReceiptHistoryDetail',\n    key: 'receivablesAccountedCashReceiptHistoryDetail',\n    fieldAliases: {\n      \"subledgerAccountingEntryLine.ledger.name\": \"ledgerName\",\n      \"subledgerAccountingEntryLine.ledger.currency.currencyCode\": \"ledgerCurrencyCode\",\n      \"receivablesCashReceiptHistoryDistribution.receiptHistory.cashReceipt.receiptNumber\": \"receiptNumber\",\n      \"receivablesCashReceiptHistoryDistribution.receiptHistory.cashReceipt.customerAccount.customer.name\": \"customerName\",\n      \"receivablesCashReceiptHistoryDistribution.receiptHistory.cashReceipt.receiptStatus.meaning\": \"receiptStatus\",\n      \"receivablesCashReceiptHistoryDistribution.receiptHistory.cashReceipt.receiptDate\": \"receiptDate\",\n      \"receivablesCashReceiptHistoryDistribution.receiptHistory.cashReceipt.receiptAmount\": \"receiptAmount\",\n      \"subledgerAccountingEntryLine.enteredCurrency.currencyCode\": \"EnteredCurrency\",\n      \"unroundedEnteredDebit\": \"enteredDebit\",\n      \"unroundedEnteredCredit\": \"enteredCredit\",\n      \"unroundedAccountedDebit\": \"accountedDebit\",\n      \"unroundedAccountedCredit\": \"accountedCredit\",\n      \"subledgerAccountingEntryLine.subledgerAccountingEntryHeader.legalEntity.legalEntityName\": \"legalEntity\",\n      \"receivablesCashReceiptHistoryDistribution.businessUnit.name\": \"businessName\",\n      \"subledgerAccountingEntryLine.accountingDate\": \"accountingDate\",\n      \"receivablesCashReceiptHistoryDistribution.receiptHistory.cashReceipt.bankAccountUse.bankAccount.bank.name\": \"bankName\",\n      \"receivablesCashReceiptHistoryDistribution.receiptHistory.cashReceipt.receiptMethod.name\": \"re