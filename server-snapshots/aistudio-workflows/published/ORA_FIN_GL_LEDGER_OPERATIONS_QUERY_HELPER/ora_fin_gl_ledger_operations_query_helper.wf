                    "sourceCode": "const hierarchies = $context.$nodes.BUILD_HIERARCHIES_1.$output.result;\nconst chartOfAccountsId = $context.$input.inputParams.chartOfAccountsId;\nconst fieldAliases = $context.$nodes.GET_FIELDALIASES.$output.result;\nconst select = $context.$nodes.PREPARE_SELECT_1.$output.result;\n\nconst returnArr = Object.values(fieldAliases).map((name) => ({\n  name,\n  type: \"string\",\n}));\n\nconst buildAccountingPayload = ({ hierarchies, chartOfAccountsId, select }) => ({\n  hierarchies,\n  viewQueries: {\n    fact: {\n      module: $context.$input.inputParams.module,\n      businessObject: $context.$input.inputParams.businessObject,\n      view: $context.$input.inputParams.view,\n      fieldAliases: fieldAliases,\n      viewParamMappings: {\n        chartOfAccountsId: [String(chartOfAccountsId)],\n      },\n    },\n  },\n  return: returnArr,\n  select,\n});\n\nreturn buildAccountingPayload({\n  hierarchies,\n  chartOfAccountsId,\n  select\n});"
