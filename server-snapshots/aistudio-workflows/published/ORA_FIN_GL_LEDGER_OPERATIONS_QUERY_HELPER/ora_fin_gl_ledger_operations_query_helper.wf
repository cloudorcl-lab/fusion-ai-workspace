                    "sourceCode": "let computedQualifiers = $context.$nodes.PROCESS_SEGMENT_QUALIFIERS_FOR_BALANCES_AV.$output.result\n\nconst defaultQualifiers = $context.$input.inputParams.defaultQualifiers;\n/*\nconst defaultQualifiers = {\n  currency: \"currency\",\n  accountingPeriod: \"fiscalDate\"\n};\n*/\nlet output = {...computedQualifiers, ...defaultQualifiers};\nreturn output;"
