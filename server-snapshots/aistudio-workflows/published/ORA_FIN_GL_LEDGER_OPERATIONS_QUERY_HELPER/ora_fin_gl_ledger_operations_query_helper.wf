                  },
                  "id": "1780038282107",
                  "code": "IF_SOURCE_IS_VARIANCE_1",
                  "type": "CONDITION",
                  "convergenceTargetId": "1780038282110",
                  "inputs": [
                    {
                      "id": "1779276196514_condition",
                      "name": "condition",
                      "type": "string",
                      "value": "{{$context.$input?.inputParams?.queryByPeriod == true}}"
                    }
                  ]
                },
                {
                  "metadata": {
                    "name": "Get Periods 1",
                    "returnType": "array",
                    "sourceCode": "const inputParams = $context.$input.inputParams;\n\nif (!inputParams.queryByPeriod) {\n  return [];\n}\n\nconst insightDetails = inputParams.insightDetails;\nconst journalSource = inputParams.journalSource;\n\nlet periodKey = 'accountingPeriod';\nlet queryByEntities = [];\n\nif (insightDetails?.categoryCode?.includes('ORA_VARIANCE')) {\n  if (journalSource != 'Payables' && journalSource != 'Receivables') {\n    periodKey = 'periodName';\n  } \n  else if (journalSource === 'Payables') {\n    periodKey = 'accountingPeriod';\n    queryByEntities.push('$ora_query_by_entity');\n  } \n  else if (journalSource === 'Receivables') {\n    periodKey = 'accountingPeriod';\n    queryByEntities.push('$ora_query_by_entity');\n  }\n}\n\nconst currPeriod = $context.$nodes.PROCESS_ACCOUNTING_PERIODS.$output.currPeriod || inputParams.PARSE_APP_CONTEXT?.periodName;\n\nif (!currPeriod) {\n  return [];\n}\n\nconst parsedBalancesAVFilter =\n  $context.$nodes.PARSE_BALANCES_AV_FILTER_1.$output.result ?? {};\n\nconst periodFilter =\n  parsedBalancesAVFilter[periodKey] ??\n  parsedBalancesAVFilter.accountingPeriod;\n\nlet periods = periodFilter?.$memberName?.value ?? [];\n\nif (!Array.isArray(periods)) {\n  periods = [periods];\n}\n\nlet targetPeriod = currPeriod;\n\nif (!inputParams.isCurrentPeriod) {\n  const currIdx = periods.indexOf(currPeriod);\n\n  if (periods.length === 2 && currIdx !== -1) {\n    targetPeriod = periods.find(period => period !== currPeriod) ?? currPeriod;\n  }\n}\n\nreturn [\n  `${periodKey} IN ('${targetPeriod}')`,\n  ...queryByEntities\n];"
                  },
                  "diagram": {
                    "x": 10959,
                    "y": 6795
                  },
                  "outcomes": {
                    "success": "1780038282110"
                  },
                  "id": "1780038282108",
                  "code": "GET_PERIODS_1",
                  "type": "CODE",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "metadata": {
                    "name": "Remap Parsed Balances Filter",
                    "sourceCode": "const replaceTreeVersionNameWithTreeFilter = (payload) => {\n  const parsedFilter = payload?.result ?? payload ?? {};\n  const result = {};\n\n  Object.entries(parsedFilter).forEach(([dimension, attributes]) => {\n    result[dimension] = {};\n\n    Object.entries(attributes ?? {}).forEach(([attribute, condition]) => {\n      const updatedAttribute =\n        attribute === \"treeVersionName\" ? \"treeFilter\" : attribute;\n\n      result[dimension][updatedAttribute] = condition;\n    });\n  });\n\n  return result;\n};\n\nlet parsedBalancesFilter =\n  $context.$nodes.PARSE_BALANCES_AV_FILTER_1.$output.result;\n\nreturn replaceTreeVersionNameWithTreeFilter(parsedBalancesFilter);",
                    "returnType": "object"
                  },
                  "diagram": {
                    "x": 10503,
                    "y": 7017
                  },
                  "outcomes": {
                    "success": "1780038282111"
                  },
                  "id": "1780038282110",
                  "code": "REMAP_PARSED_BALANCES_FILTER",
                  "type": "CODE",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "metadata": {
                    "name": "Build Hierarchies 1",
                    "returnType": "object",
                    "sourceCode": "const parseJsonIfNeeded = (value) => {\n  if (typeof value !== \"string\") {\n    return value ?? {};\n  }\n\n  try {\n    return JSON.parse(value);\n  } catch (error) {\n    return {};\n  }\n};\n\nconst getDimensionsFromPayload = (payload) => {\n  const analyticViews = payload?.analyticViews;\n\n  if (!analyticViews || typeof analyticViews !== \"object\") {\n    return {};\n  }\n\n  const firstAnalyticView = Object.values(analyticViews)[0];\n\n  if (\n    !firstAnalyticView?.dimensions ||\n    typeof firstAnalyticView.dimensions !== \"object\" ||\n    Array.isArray(firstAnalyticView.dimensions)\n  ) {\n    return {};\n  }\n\n  return firstAnalyticView.dimensions;\n};\n\nconst isPresent = (v) => v !== undefined && v !== null && v !== \"\";\n\nconst formatValue = (value) => {\n  const quote = (v) => `'${String(v).replace(/'/g, \"\\\\'\")}'`;\n\n  if (Array.isArray(value)) {\n    return `(${value.map(quote).join(\", \")})`;\n  }\n\n  return quote(value);\n};\n\nconst levelNameToField = (levelName) => {\n  const lower = String(levelName || \"\").toLowerCase();\n\n  if (lower === \"treeversionname\") {\n    return \"treeFilter\";\n  }\n\n  return lower.endsWith(\"value\")\n    ? lower.slice(0, -5) + \"Value\"\n    : lower;\n};\n\nconst buildFilter = (parsedFilter) => {\n  const conditions = [];\n\n  for (const [, attributes] of Object.entries(parsedFilter || {})) {\n    const treeAttr = attributes?.treeFilter;\n    const memberAttr = attributes?.$memberName;\n    const levelAttr = attributes?.$levelName;\n\n    if (isPresent(treeAttr?.value)) {\n      conditions.push(\n        `treeFilter ${treeAttr.operator || \"=\"} ${formatValue(treeAttr.value)}`\n      );\n    }\n\n    if (isPresent(levelAttr?.value)) {\n      const fieldName = levelNameToField(levelAttr.value);\n\n      if (fieldName !== \"treeFilter\") {\n        conditions.push(`$levelName = 'LEVEL0VALUE'`);\n\n        const rhsValue = isPresent(memberAttr?.value)\n          ? memberAttr.value\n          : levelAttr.value;\n\n        const operator = isPresent(memberAttr?.value)\n          ? memberAttr.operator || \"=\"\n          : levelAttr.operator || \"=\";\n\n        conditions.push(\n          `${fieldName} ${operator} ${formatValue(rhsValue)}`\n        );\n      }\n    }\n  }\n\n  return conditions.join(\" AND \");\n};\n\nconst upperFirst = (value) => {\n  const str = String(value || \"\");\n  return str.charAt(0).toUpperCase() + str.slice(1);\n};\n\nconst buildAliasName = (sourceDim, aliasKey) => {\n  if (aliasKey === \"treeVersionName\") {\n    return `${sourceDim}TreeFilter`;\n  }\n\n  if (aliasKey === \"$memberName\") {\n    return sourceDim;\n  }\n\n  if (aliasKey === \"$memberDescription\") {\n    return `${sourceDim}Description`;\n  }\n\n  if (aliasKey === \"$levelName\") {\n    return `${sourceDim}LevelName`;\n  }\n\n  const aliasName = aliasKey.replace(\"$\", \"\");\n\n  return `${sourceDim}${aliasName.charAt(0).toUpperCase()}${aliasName.slice(1)}`;\n};\n\nconst buildHierarchyAliases = (sourceAliases = {}, sourceDim) => {\n  const aliases = {};\n\n  Object.keys(sourceAliases).forEach((aliasKey) => {\n    const targetAliasKey =\n      aliasKey === \"treeVersionName\" ? \"treeFilter\" : aliasKey;\n\n    aliases[targetAliasKey] = buildAliasName(sourceDim, aliasKey);\n  });\n\n  return aliases;\n};\n\nconst buildHierarchies = ({\n  dimensions,\n  segmentMetadata,\n  remappedBalancesFilter\n}) => {\n  const hierarchies = {};\n\n  Object.entries(segmentMetadata ?? {}).forEach(([sourceDim, segmentInfo]) => {\n    const qualifierName = segmentInfo?.qualifier;\n\n    if (!qualifierName) {\n      return;\n    }\n\n    if (String(segmentInfo?.isLeaf) !== \"0\") {\n      return;\n    }\n\n    const sourceAliases = dimensions?.[sourceDim]?.[sourceDim]?.aliases;\n    const dimensionFilter = remappedBalancesFilter?.[sourceDim];\n\n    if (!sourceAliases || !dimensionFilter) {\n      return;\n    }\n\n    const memberAttr = dimensionFilter?.$memberName;\n    const levelAttr = dimensionFilter?.$levelName;\n\n    if (!isPresent(memberAttr?.value) || !isPresent(levelAttr?.value)) {\n      return;\n    }\n\n    if (levelNameToField(levelAttr.value) === \"treeFilter\") {\n      return;\n    }\n\n    const filter = buildFilter({\n      [sourceDim]: dimensionFilter\n    });\n\n    if (!filter) {\n      return;\n    }\n\n    hierarchies[qualifierName] = {\n      module: \"oraErpCoreStructureRuntime\",\n      name: `ora_erp_core_structure_runtime_x__${upperFirst(qualifierName)}`,\n      aliases: buildHierarchyAliases(sourceAliases, sourceDim),\n      filter\n    };\n  });\n\n  return hierarchies;\n};\n\nlet balancesAvRequest = $context.$input.inputParams.balancesAVRequest;\n// balancesAvRequest = parseJsonIfNeeded(balancesAvRequest);\n\nconst dimensions = getDimensionsFromPayload(balancesAvRequest);\n\nconst segmentMetadata =\n  $context.$nodes.MAP_REDUCE_SEGMENTS.$output.result || {};\n\nconst remappedBalancesFilter =\n  $context.$nodes.REMAP_PARSED_BALANCES_FILTER.$output.result || {};\n\nconst hierarchies = buildHierarchies({\n  dimensions,\n  segmentMetadata,\n  remappedBalancesFilter\n});\n\nreturn hierarchies;"
                  },
