                  "id": "1780038282111",
                  "code": "BUILD_HIERARCHIES_1",
                  "type": "CODE",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "metadata": {
                    "name": "Fetch values from Balances AV Filter",
                    "sourceCode": "const chartOfAccountsMetadata = $context.$input.inputParams.chartOfAccountsMetadata;\n\nconst avMetadata = $context.$input.inputParams.avMetadata;\n\nconst chartOfAccountsId = $context.$input.inputParams.chartOfAccountsId;\n\nconst parsedBalancesFilter = $context.$nodes.REMAP_PARSED_BALANCES_FILTER.$output.result;\n\nconst fieldAliases = $context.$nodes.GET_FIELDALIASES.$output.result;\n\nconst hierarchyConfigs = $context.$nodes.BUILD_HIERARCHIES_1.$output.result;\n\nconst buildFieldNameToDimensionAttribute = (coaMeta = [], avMeta = []) => {\n  return coaMeta.reduce((acc, row) => {\n    const avRow = avMeta.find(\n      x => String(x.DIMENSIONSEQUENCENUMBER) === String(row.sequenceNumber)\n    );\n\n    if (avRow) {\n      acc[row.fieldName] = avRow.DIMENSIONATTRIBUTENAME;\n    }\n\n    return acc;\n  }, {});\n};\n\nconst getFieldNamesWithValue = (aliases = {}) => {\n  const result = {};\n\n  for (const key of Object.keys(aliases)) {\n    if (key === \"accountingPeriod\" || key == \"periodName\") {\n      result[\"accountingPeriod\"] = aliases[key];\n      continue;\n    }\n\n    const parts = key.split(\".\");\n    const leafKey = parts[parts.length - 1];\n    const fieldName = parts[parts.length - 2];\n\n    if (leafKey !== \"value\") continue;\n    if (!fieldName) continue;\n\n    result[fieldName] = aliases[key];\n  }\n\n  return result;\n};\n\nconst mapFieldNamesWithValueToDimensionAttribute = (\n  fieldNamesWithValue = {},\n  fieldNameToDimensionAttribute = {}\n) => {\n  const result = {};\n\n  for (const [fieldName, value] of Object.entries(fieldNamesWithValue)) {\n    if (fieldName === \"accountingPeriod\") {\n      result[fieldName] = value;\n      continue;\n    }\n\n    const dimensionAttributeName = fieldNameToDimensionAttribute[fieldName];\n\n    if (dimensionAttributeName) {\n      result[dimensionAttributeName] = value;\n    }\n  }\n\n  return result;\n};\n\nconst formatFilterValue = value => {\n  if (Array.isArray(value)) {\n    return `(${value.map(v => `'${v}'`).join(\", \")})`;\n  }\n\n  return `'${value}'`;\n};\n\nconst buildMemberNameExpressions = (mappedFields = {}, parsedFilter = {}, hierarchyConfigs = {}) => {\n  const expressions = [];\n\n  const hierarchyMemberNameAliases = new Set(\n    Object.values(hierarchyConfigs)\n      .map(config => config?.aliases?.$memberName)\n      .filter(Boolean)\n  );\n\n  for (const [dimensionAttributeName, alias] of Object.entries(mappedFields)) {\n    // Ignore mapped field if it is already present as $memberName in hierarchy aliases\n    if (hierarchyMemberNameAliases.has(dimensionAttributeName)) {\n      continue;\n    }\n    \n    const memberFilter = parsedFilter?.[dimensionAttributeName]?.$memberName;\n    if (!memberFilter) continue;\n\n    const { operator, value } = memberFilter;\n    expressions.push(`${alias} ${operator} ${formatFilterValue(value)}`);\n  }\n  return expressions;\n};\n\nconst buildHierarchyFactExpressions = ({\n  hierarchyConfigs = {},\n  chartOfAccountsMetadata = [],\n  avMetadata = [],\n  fieldAliases = {},\n  factAlias = \"fact\"\n}) => {\n  return chartOfAccountsMetadata\n    .map(coaItem => {\n      const avRow = avMetadata.find(\n        av =>\n          String(av.DIMENSIONSEQUENCENUMBER) ===\n          String(coaItem.sequenceNumber)\n      );\n\n      const hierarchyName = avRow?.HIERARCHYNAME;\n\n      if (!hierarchyName) return null;\n\n      const fieldAlias = Object.entries(fieldAliases).find(([fieldPath]) => {\n        const parts = fieldPath.split(\".\");\n        const leafKey = parts[parts.length - 1];\n\n        return parts.includes(coaItem.fieldName) && leafKey === \"value\";\n      })?.[1];\n\n      if (!fieldAlias) return null;\n\n      const mainKey = Object.entries(hierarchyConfigs).find(\n        ([, config]) => config?.aliases?.$memberName === hierarchyName\n      )?.[0];\n\n      if (!mainKey) return null;\n\n      return `${mainKey}.${hierarchyName} = ${factAlias}.${fieldAlias}`;\n    })\n    .filter(Boolean);\n};\n\nconst fieldNameToDimensionAttribute = buildFieldNameToDimensionAttribute(\n  chartOfAccountsMetadata,\n  avMetadata\n);\n\nconst fieldNamesWithValue = getFieldNamesWithValue(fieldAliases);\n\nconst mappedFields = mapFieldNamesWithValueToDimensionAttribute(\n  fieldNamesWithValue,\n  fieldNameToDimensionAttribute\n);\n\nconst memberNameExpressions = buildMemberNameExpressions(\n  mappedFields,\n  parsedBalancesFilter,\n  hierarchyConfigs\n);\n\nconst hierarchyFactExpressions = buildHierarchyFactExpressions({\n  hierarchyConfigs,\n  chartOfAccountsMetadata,\n  avMetadata,\n  fieldAliases,\n  factAlias: \"fact\"\n});\n\nreturn ( {\n  expWhere: [...memberNameExpressions, ...hierarchyFactExpressions]\n});",
                    "returnType": "object"
                  },
