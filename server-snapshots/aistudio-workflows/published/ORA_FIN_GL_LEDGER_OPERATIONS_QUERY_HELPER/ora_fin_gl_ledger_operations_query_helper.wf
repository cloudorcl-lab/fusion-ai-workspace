                  "id": "1780037090255",
                  "code": "CONSTRUCT_FILTER_FOR_JOURNALS_AV",
                  "type": "CODE",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "metadata": {
                    "name": "Construct dimensions for Journals AV",
                    "returnType": "object",
                    "sourceCode": "function convertDimensions(dimensions, qualifiers) {\n  const output = {\n    dimensions: {}\n  };\n\n  for (const sourceDim in qualifiers) {\n    const targetDim = qualifiers[sourceDim];\n    const sourceAliases = dimensions?.[sourceDim]?.[sourceDim]?.aliases;\n\n    if (!sourceAliases) {\n      continue;\n    }\n\n    output.dimensions[targetDim] = {\n      [targetDim]: {\n        aliases: {}\n      }\n    };\n\n    for (const aliasKey in sourceAliases) {\n      if (aliasKey === \"treeVersionName\") {\n        output.dimensions[targetDim][targetDim].aliases.treeFilter =\n          `${sourceDim}TreeFilter`;\n      } else if (aliasKey === \"$memberName\") {\n        output.dimensions[targetDim][targetDim].aliases[aliasKey] =\n          sourceDim;\n      } else if (aliasKey === \"$memberDescription\") {\n        output.dimensions[targetDim][targetDim].aliases[aliasKey] =\n          `${sourceDim}Description`;\n      } else if (aliasKey === \"$levelName\") {\n        output.dimensions[targetDim][targetDim].aliases[aliasKey] =\n          `${sourceDim}LevelName`;\n      } else {\n        const aliasName = aliasKey.replace(\"$\", \"\");\n\n        output.dimensions[targetDim][targetDim].aliases[aliasKey] =\n          `${sourceDim}${aliasName.charAt(0).toUpperCase()}${aliasName.slice(1)}`;\n      }\n    }\n  }\n\n  return output;\n}\n\nconst parseDimensionsFromPayload = (payload) => {\n  const dimensions = getDimensionsFromPayload(payload);\n\n  if (!dimensions) {\n    return {};\n  }\n\n  return dimensions;\n};\n\n// Fetches dimensions object from the Balances AV query\nconst getDimensionsFromPayload = (payload) => {\n  const analyticViews = payload?.analyticViews;\n\n  if (!analyticViews || typeof analyticViews !== \"object\") {\n    return {};\n  }\n\n  const firstAnalyticView = Object.values(analyticViews)[0];\n\n  if (\n    !firstAnalyticView?.dimensions ||\n    typeof firstAnalyticView.dimensions !== \"object\" ||\n    Array.isArray(firstAnalyticView.dimensions)\n  ) {\n    return {};\n  }\n\n  return firstAnalyticView.dimensions;\n};\n\n// let bossQ =  $context.$input.inputParams.balancesAVRequest || {};\nlet bossQ =  $context.$input.inputParams.balancesAVRequest;\nlet dimensions = parseDimensionsFromPayload(bossQ) || {};\nlet qualifiers = $context.$nodes.ADD_DEFAULT_QUALIFIERS_FOR_JOURNALS_AV.$output.result || {};\n\nlet computedDimensions = convertDimensions(dimensions, qualifiers);\nconst defaultDimensions = $context.$input.inputParams.defaultDimensions;\n\nlet hardcodedDimensions = {\n  \"ledger\": {\n    \"ledger\": {\n      \"aliases\": {\n        \"$memberName\": \"ledger\",\n        \"ledgerCurrency\": \"ledgerCurrency\",\n        \"ledgerSetName\": \"ledgerSetName\"\n      }\n    }\n  }\n};\n\nlet output = {\n  ...computedDimensions.dimensions,\n  ...hardcodedDimensions,\n  ...defaultDimensions\n}\nreturn {\n  dimensions: output\n};"
                  },
                  "diagram": {
                    "x": 9523,
                    "y": 7017
                  },
                  "outcomes": {
                    "success": "1780037667888"
                  },
                  "id": "1780037482761",
                  "code": "CONSTRUCT_DIMENSIONS_FOR_JOURNALS_AV",
                  "type": "CODE",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "metadata": {
                    "name": "Prepare Payload for Journals AV",
                    "returnType": "object",
                    "sourceCode": "const filter = $context.$nodes.CONSTRUCT_FILTER_FOR_JOURNALS_AV.$output.result;\n\nconst dimensions = $context.$nodes.CONSTRUCT_DIMENSIONS_FOR_JOURNALS_AV.$output.result?.dimensions;\n\nlet chartOfAccountsId = $context.$input.inputParams.chartOfAccountsId;\nconst measureAliases = $context.$input.inputParams.measureAliases;\nconst module = $context.$input.inputParams.module;\nconst name = $context.$input.inputParams.name;\nconst orderBy = $context.$input.inputParams.orderBy;\nconst groupBy = $context.$input.inputParams.groupBy ?? [];\nconst queryByPeriod = $context.$input.inputParams.queryByPeriod;\n\nconst dimensionAliasValues = Object.values(dimensions).flatMap(dimension =>\n  Object.values(dimension).flatMap(item =>\n    Object.values(item.aliases || {})\n  )\n);\n\nlet attributes = [\n  ...dimensionAliasValues.map(name => ({\n    type: \"string\",\n    name\n  })),\n  ...Object.values(measureAliases).map(name => ({\n    type: \"big-decimal\",\n    name\n  }))\n];\n\nlet measureSelectValues = Object.values(measureAliases);\n\n\nlet select = [\n  ...dimensionAliasValues,\n  ...measureSelectValues\n].join(\",\");\n\nlet groupByValue = '';\n\nif( groupBy && groupBy.length > 0){\n\n  measureSelectValues = Object.values(measureAliases).map(name =>\n    `SUM(${name}) AS ${name}`\n  );\n\n  attributes = [\n    ...groupBy.map(name => ({\n    type: \"string\",\n    name\n  })),\n  ...Object.values(measureAliases).map(name => ({\n    type: \"big-decimal\",\n    name\n  }))\n  ];\n\n  select = [\n    ...groupBy,\n    ...measureSelectValues\n  ].join(\",\");\n  groupByValue = `GROUP BY ${groupBy.join(\",\")}`\n}\n\n\nconst query = {\n  analyticViews: {\n    avUsage1: {\n      module,\n      name,\n      measureAliases,\n      dimensions,\n      filter,\n    },\n  },\n\n  return: attributes,\n\n  select:\n    `SELECT ${select} from avUsage1 ${groupByValue} ORDER BY ${orderBy} DESC fetch first 25 rows only`,\n};\n\n\nlet payload = {\n  \"chartOfAccountsId\": String(chartOfAccountsId),\n  \"includeData\": true,\n  \"expandBasedOnAccountType\": false,\n  \"expandAggregateDataByOneLevel\": false,\n  \"expandSubledgerData\": false,\n  \"queries\": [ query ]\n};\n\nreturn payload;"
                  },
                  "diagram": {
                    "x": 9545.5,
                    "y": 7239
                  },
                  "outcomes": {
                    "success": "1780037775844"
                  },
                  "id": "1780037667888",
