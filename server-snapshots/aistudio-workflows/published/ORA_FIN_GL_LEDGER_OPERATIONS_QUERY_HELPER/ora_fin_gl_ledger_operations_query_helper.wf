                  "type": "CODE",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "metadata": {
                    "name": "Process Segment Qualifiers for Balances AV",
                    "returnType": "object",
                    "sourceCode": "const toCamelCase = (str) => {\n  return str\n    .toLowerCase()\n    .replace(/[^a-zA-Z0-9]+(.)/g, (m, chr) => chr.toUpperCase());\n};\n\n\nconst getSegmentQualifierMap = (payload) => {\n  const segments =\n    payload?.avExtractResult?.metaData?.chartOfAccounts?.segments ?? {};\n\n  return Object.entries(segments).reduce((result, [segmentName, segmentData]) => {\n    const qualifier = segmentData?.qualifiers?.[0];\n\n    result[segmentName] = qualifier\n      ? toCamelCase(qualifier)\n      : undefined;\n\n    return result;\n  }, {});\n};\n\nconst computedQualifiers = getSegmentQualifierMap($context.$input.inputParams.balancesAVResponse);\n\n/*\nconst defaultQualifiers = {\n  currency: \"currency\",\n  accountingPeriod: \"fiscalDate\"\n};\nlet output = {...computedQualifiers, ...defaultQualifiers};\nreturn output;\n*/\nreturn computedQualifiers;"
                  },
