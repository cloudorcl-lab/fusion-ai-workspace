                  "id": "1780037090254",
                  "code": "ADD_DEFAULT_QUALIFIERS_FOR_JOURNALS_AV",
                  "type": "CODE",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "metadata": {
                    "name": "Construct filter for Journals AV",
                    "returnType": "string",
                    "sourceCode": "const buildFilter = (parsedFilter) => {\n  const conditions = [];\n  const filter = parsedFilter;\n\n  for (const [dimension, attributes] of Object.entries(filter)) {\n    const hasTreeVersionName = Object.prototype.hasOwnProperty.call(\n      attributes,\n      \"treeVersionName\"\n    );\n\n    const normalizedAttributes = {};\n    let shouldForceLevel0Value = false; // resets for each dimension\n\n    for (const [attribute, condition] of Object.entries(attributes)) {\n      const normalizedAttribute =\n        attribute === \"treeVersionName\" ? \"treeFilter\" : attribute;\n\n      let normalizedCondition =\n        hasTreeVersionName &&\n        attribute === \"$levelName\" &&\n        condition.value === \"TREEVERSIONNAME\"\n          ? {\n              ...condition,\n              value: \"TREEFILTER\"\n            }\n          : condition;\n\n      // Normalize treeFilter values like:\n      // \"All Cost_Center Values\" -> \"All Values\"\n      // \"All Intercompany Values\" -> \"All Values\"\n      if (\n        normalizedAttribute === \"treeFilter\" &&\n        typeof normalizedCondition?.value === \"string\" &&\n        /^All\\s+.+\\s+Values$/i.test(normalizedCondition.value)\n      ) {\n        normalizedCondition = {\n          ...normalizedCondition,\n          value: \"All Values\"\n        };\n\n        shouldForceLevel0Value = true;\n      }\n\n      normalizedAttributes[normalizedAttribute] = normalizedCondition;\n    }\n\n    // If this dimension's treeFilter became \"All Values\",\n    // force only this dimension's $levelName to \"LEVEL0VALUE\"\n    if (shouldForceLevel0Value && normalizedAttributes.$levelName) {\n      normalizedAttributes.$levelName = {\n        ...normalizedAttributes.$levelName,\n        value: \"LEVEL0VALUE\"\n      };\n    }\n\n    for (const [attribute, condition] of Object.entries(normalizedAttributes)) {\n      if (dimension === \"currency\" && attribute === \"$memberName\") {\n        continue;\n      }\n\n      conditions.push(\n        buildCondition(dimension, attribute, condition)\n      );\n    }\n  }\n\n  return conditions.join(\" AND \");\n};\n\nconst buildCondition = (dimension, attribute, condition) => {\n  const leftSide = `${dimension}.${attribute}`;\n\n  if (condition.operator === \"IN\" || condition.operator === \"NOT IN\") {\n    const values = condition.value\n      .map((value) => `'${value}'`)\n      .join(\", \");\n\n    return `${leftSide} ${condition.operator} (${values})`;\n  }\n\n  return `${leftSide} ${condition.operator} '${condition.value}'`;\n};\n\nconst remapOnlyMappedFilters = (parsedFilter = {}, qualifierMap = {}) => {\n  const result = {};\n\n  Object.entries(parsedFilter).forEach(([dimensionName, dimensionData]) => {\n    const mappedKey = qualifierMap[dimensionName];\n\n    // Keep only dimensions that have a valid qualifier mapping\n    if (!mappedKey) {\n      return;\n    }\n\n    result[mappedKey] = dimensionData;\n  });\n\n  return result;\n};\n\nconst parsedBalancesFilter =\n  $context.$nodes?.PARSE_BALANCES_AV_FILTER?.$output?.result?.parsedFilter || {};\n\nconst processedSegmentQualifiers =\n  $context.$nodes?.ADD_DEFAULT_QUALIFIERS_FOR_JOURNALS_AV?.$output?.result || {};\n\nconst mappedFilters = remapOnlyMappedFilters(\n  parsedBalancesFilter,\n  processedSegmentQualifiers\n);\n\nconst ledgerName = $context.$input.inputParams.ledgerName;\n\nconst updatedFilterStr = buildFilter(mappedFilters);\n\nconst conditionClauseFiltersResult =\n  $context.$nodes?.PARSE_BALANCES_AV_FILTER?.$output?.result?.ora_condition_clause;\n\nconst conditionClauseFilters = Array.isArray(conditionClauseFiltersResult)\n  ? conditionClauseFiltersResult\n  : [];\n\nconst defaultFiltersInput =\n  $context.$input.inputParams.defaultFilters;\n\nconst defaultFilters = Array.isArray(defaultFiltersInput)\n  ? defaultFiltersInput\n  : [];\n\nconst periodFiltersResult =\n  $context.$nodes?.GET_PERIODS?.$output?.result;\n\nconst periodFilters = Array.isArray(periodFiltersResult)\n  ? periodFiltersResult\n  : [];\n\nconst joinWithHardCodedFilters = [\n  updatedFilterStr,\n  ...conditionClauseFilters,\n  ...defaultFilters,\n  ...periodFilters,\n  `ledger.$levelName = 'LEDGER'`,\n  `ledger.$memberName = '${ledgerName}'`,\n  `ledger.ledgerSetName = 'All Ledgers'`\n].filter((condition) => condition && condition.trim());\n\nreturn joinWithHardCodedFilters.join(\" AND \");"
                  },
