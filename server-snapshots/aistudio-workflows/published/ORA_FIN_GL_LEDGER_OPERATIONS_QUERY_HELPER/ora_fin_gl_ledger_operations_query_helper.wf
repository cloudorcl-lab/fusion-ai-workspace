                {
                  "metadata": {
                    "name": "Parse Journals BV Payload",
                    "returnType": "object",
                    "sourceCode": "const parseStringSafely = (input) => {\n  let payload = input;\n  let parseDepth = 0;\n  const maxParseDepth = 10;\n\n  try {\n    while (typeof payload === \"string\" && parseDepth < maxParseDepth) {\n      const trimmed = payload.trim();\n\n      if (!trimmed) {\n        return {};\n      }\n\n      payload = JSON.parse(trimmed);\n      parseDepth++;\n    }\n\n    return payload ?? {};\n  } catch (error) {\n    return {};\n  }\n};\n\nconst outputString = $context.$nodes.FETCH_PAYLOADS.VAR_PREPARE_JOURNALS_BV_FROM_BALANCES_AV.$output;\n\nconst result = parseStringSafely(outputString);\n\nconst currentItem = $context.$nodes.FETCH_PAYLOADS.$currentItem;\n\nlet updatedKey = currentItem.key;\n\nif (currentItem.key === \"generalLedgerJournalDetail\") {\n  updatedKey = currentItem.journalSource;\n}\n\nreturn {\n  [updatedKey]: result\n};"
                  },
