                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "metadata": {
                    "name": "Prepare Select 1",
                    "returnType": "string",
                    "sourceCode": "let hierarchies = $context.$nodes.BUILD_HIERARCHIES_1.$output.result;\n\nlet sortCriteria = 'fetch first 15 rows only'; \n\nlet views = ['fact', ...Object.keys(hierarchies)].join(\",\");\nconst ledgerName = $context.$input.inputParams.ledgerName;\nconst fieldAliases = $context.$nodes.GET_FIELDALIASES.$output.result;\nconst select = Object.values(fieldAliases).join(\", \");\n\nconst { expWhere } = $context.$nodes.FETCH_VALUES_FROM_BALANCES_AV_FILTER.$output.result;\n\n\n\nconst query = $context.$nodes?.GET_PERIODS_1?.$output?.result || [];\n\nlet where = [\n  ...expWhere,\n  ...( $context.$nodes.GET_DEFAULT_QUERIES_FOR_JOURNALS_BV.$output.result || [] ),\n  ...query,\n  [`ledgerName = '${ledgerName}'`]\n].join(\" AND \");\n\n\nconst sql = `select ${select} from ${views} where ${where} ORDER BY (accountedDebit - accountedCredit) desc ${sortCriteria}`;\nreturn sql;"
                  },
