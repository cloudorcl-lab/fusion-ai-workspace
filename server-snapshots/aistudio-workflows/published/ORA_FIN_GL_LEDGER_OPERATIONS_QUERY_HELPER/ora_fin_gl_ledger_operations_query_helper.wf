                  "inputs": []
                },
                {
                  "metadata": {
                    "name": "Get Default Queries for Journals BV",
                    "sourceCode": "const journalSource = $context.$input.inputParams.journalSource;\nconst queryByJournalSourceFlag = $context.$input.inputParams.queryByJournalSourceFlag;\n\nconst defaultQueries = [\n  \"(accountedCredit != 0 OR accountedDebit != 0 OR enteredDebit != 0 OR enteredCredit != 0)\"\n];\n\nif (!['Payables', 'Receivables'].includes(journalSource)) {\n  defaultQueries.push(\"batchStatusCode = 'P'\");\n}\n\nconst journalSourceQuery = [];\n\nif (\n  journalSource &&\n  queryByJournalSourceFlag\n) {\n  journalSourceQuery.push(`journalSource = '${journalSource}'`);\n}\n\nreturn [...defaultQueries, ...journalSourceQuery];",
                    "returnType": "array"
                  },
                  "diagram": {
                    "x": 10471.5,
                    "y": 5463
                  },
                  "outcomes": {
                    "success": "1780038282105"
                  },
                  "id": "1780038282103",
                  "code": "GET_DEFAULT_QUERIES_FOR_JOURNALS_BV",
                  "type": "CODE",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "metadata": {
                    "name": "Get fieldAliases",
                    "returnType": "object",
                    "sourceCode": "const parseSegmentLabels = segmentLabels => {\n  if (Array.isArray(segmentLabels)) {\n    return segmentLabels;\n  }\n\n  if (typeof segmentLabels === \"string\") {\n    return segmentLabels\n      .replace(\"[\", \"\")\n      .replace(\"]\", \"\")\n      .split(\",\")\n      .map(label => label.trim())\n      .filter(Boolean);\n  }\n\n  return [];\n};\n\nconst toAliasName = (value, suffix) =>\n  String(value || \"\")\n    .split(\"_\")\n    .filter(Boolean)\n    .map(part => part.charAt(0).toUpperCase() + part.slice(1))\n    .join(\"\") + suffix;\n\nconst toAliasValueName = value => toAliasName(value, \"Value\");\n\nconst toAliasDescriptionName = value => toAliasName(value, \"Description\");\n\nconst hasQualifierOverlap = (segmentQualifiers = [], coaSegmentLabels = []) =>\n  segmentQualifiers.some(qualifier => coaSegmentLabels.includes(qualifier));\n\nconst findMatchingCoaSegment = (segmentInfo, coaMetadata) => {\n  const qualifiers = segmentInfo?.qualifiers || [];\n\n  if (qualifiers.length === 0) {\n    return null;\n  }\n\n  return coaMetadata.find(coaItem =>\n    hasQualifierOverlap(qualifiers, coaItem.parsedSegmentLabels)\n  );\n};\n\nconst getAccountPathRoot = ({ view, journalSource, chartOfAccountsId }) => {\n  if (\n    view !== \"generalLedgerJournalDetail\" &&\n    (journalSource === \"Payables\" || journalSource === \"Receivables\")\n  ) {\n    return `subledgerAccountingEntryLine.account<${chartOfAccountsId}>`;\n  }\n\n  return `account<${chartOfAccountsId}>`;\n};\n\nconst buildCoaSegmentAliasMap = ({\n  balancesAVResponse = {},\n  chartOfAccountsMetadata = [],\n  chartOfAccountsId,\n  journalSource,\n  view,\n}) => {\n  const segments =\n    balancesAVResponse?.avExtractResult?.metaData?.chartOfAccounts?.segments || {};\n\n  const accountPathRoot = getAccountPathRoot({\n    view,\n    journalSource,\n    chartOfAccountsId,\n  });\n\n  const coaMetadata = chartOfAccountsMetadata.map(item => ({\n    ...item,\n    parsedSegmentLabels: parseSegmentLabels(item.segmentLabels),\n  }));\n\n  return Object.entries(segments).reduce((result, [, segmentInfo]) => {\n    const matchedCoaSegment = findMatchingCoaSegment(segmentInfo, coaMetadata);\n\n    if (!matchedCoaSegment?.fieldName || !matchedCoaSegment?.segmentName) {\n      return result;\n    }\n\n    const segmentPath = `${accountPathRoot}.${matchedCoaSegment.fieldName}`;\n    const segmentName = matchedCoaSegment.segmentName;\n\n    result[`${segmentPath}.value`] = toAliasValueName(segmentName);\n    result[`${segmentPath}.description`] = toAliasDescriptionName(segmentName);\n\n    return result;\n  }, {});\n};\n\nconst balancesAVResponse =\n  $context.$input.inputParams.balancesAVResponse;\n\nconst chartOfAccountsMetadata =\n  $context.$input.inputParams.chartOfAccountsMetadata;\n\nconst chartOfAccountsId =\n  $context.$input.inputParams.chartOfAccountsId;\n\nconst journalSource =\n  $context.$input.inputParams.journalSource;\n\nconst view =\n  $context.$input.inputParams.view;\n\nconst fieldAliases =\n  $context.$input.inputParams.fieldAliases;\n\nconst computedFieldAliases = buildCoaSegmentAliasMap({\n  balancesAVResponse,\n  chartOfAccountsMetadata,\n  chartOfAccountsId,\n  journalSource,\n  view,\n}) || {};\n\nreturn { ...fieldAliases, ...computedFieldAliases };"
                  },
                  "diagram": {
                    "x": 10509,
                    "y": 5241
                  },
                  "outcomes": {
                    "success": "1780038282103"
                  },
                  "id": "1780038282104",
                  "code": "GET_FIELDALIASES",
                  "type": "CODE",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "metadata": {
                    "name": "Map Reduce Segments",
                    "returnType": "object",
                    "sourceCode": "const balancesAvResponse = $context.$input.inputParams.balancesAVResponse;\n\nconst currentLevelAvData = balancesAvResponse?.avExtractResult?.ledgerLevelAvData?.[0]?.currentLevelAvData?.records?.[0] || {};\n\nconst segments = balancesAvResponse?.avExtractResult?.metaData?.chartOfAccounts?.segments;\n\nconst toCamelCase = (value) => {\n  return String(value)\n    .toLowerCase()\n    .split(\"_\")\n    .map((part, index) => {\n      if (index === 0) {\n        return part;\n      }\n\n      return part.charAt(0).toUpperCase() + part.slice(1);\n    })\n    .join(\"\");\n};\n\nconst childMetadata = {};\n\nObject.entries(segments).forEach(([segmentKey, segmentObj]) => {\n  const qualifier = segmentObj.qualifiers?.[0];\n\n  childMetadata[segmentKey] = {\n    isLeaf: currentLevelAvData[`${segmentKey}IsLeaf`],\n    qualifier: qualifier ? toCamelCase(qualifier) : null\n  };\n});\n\nreturn childMetadata;"
                  },
                  "diagram": {
                    "x": 10509,
                    "y": 5685
                  },
                  "outcomes": {
                    "success": "1780038282106"
                  },
                  "id": "1780038282105",
                  "code": "MAP_REDUCE_SEGMENTS",
                  "type": "CODE",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "metadata": {
                    "name": "Parse Balances AV Filter 1",
                    "returnType": "object",
                    "sourceCode": "const parseFilterFromPayload = (payload) => {\n  const filter = getFilterFromPayload(payload);\n  return filter ? parseFilter(filter) : {};\n};\n\n// Fetches filter string from the Balances AV query\nconst getFilterFromPayload = (payload) => {\n  const analyticViews = payload?.analyticViews;\n\n  if (!analyticViews || typeof analyticViews !== \"object\") {\n    return \"\";\n  }\n\n  const firstAnalyticView = Object.values(analyticViews)[0];\n\n  return typeof firstAnalyticView?.filter === \"string\"\n    ? firstAnalyticView.filter\n    : \"\";\n};\n\nconst parseFilter = (filter) => {\n  const conditions = splitByLogicalAnd(filter);\n  const result = {};\n\n  for (const condition of conditions) {\n\n    let parsedCondition;\n    try {\n      parsedCondition = parseCondition(condition);\n    } catch (error) {\n      continue; // skip conditions like periodNetBalance > 10000000\n    }\n\n    const {\n      dimension,\n      attribute,\n      operator,\n      value,\n      original,\n      expression\n    } = parsedCondition;\n\n    result[dimension] ??= {};\n\n    result[dimension][attribute] = {\n      operator,\n      value,\n      original,\n      expression\n    };\n  }\n\n  return result;\n};\n\n// Splits by AND, but ignores AND inside quotes or parentheses.\nconst splitByLogicalAnd = (filter) => {\n  const conditions = [];\n\n  let current = \"\";\n  let insideQuote = false;\n  let parenthesesDepth = 0;\n\n  for (let i = 0; i < filter.length; i++) {\n    const char = filter[i];\n\n    if (char === \"'\") {\n      insideQuote = !insideQuote;\n      current += char;\n      continue;\n    }\n\n    if (!insideQuote) {\n      if (char === \"(\") {\n        parenthesesDepth++;\n      } else if (char === \")\") {\n        parenthesesDepth--;\n      }\n\n      const remaining = filter.slice(i);\n      const andMatch = remaining.match(/^\\s+\\band\\b\\s+/i);\n\n      if (parenthesesDepth === 0 && andMatch) {\n        conditions.push(current.trim());\n        current = \"\";\n\n        i += andMatch[0].length - 1;\n        continue;\n      }\n    }\n\n    current += char;\n  }\n\n  if (current.trim()) {\n    conditions.push(current.trim());\n  }\n\n  return conditions;\n};\n\n// Parses one condition like: currency.$memberName = 'USD'\nconst parseCondition = (condition) => {\n  const original = condition.trim();\n  const operatorMatch = findOperator(original);\n\n  if (!operatorMatch) {\n    throw new Error(`Unsupported condition: ${condition}`);\n  }\n\n  \n  const operator = normalizeOperator(operatorMatch.operator);\n\n  const leftSide = original.slice(0, operatorMatch.index).trim();\n\n  const rightSide = original\n    .slice(operatorMatch.index + operatorMatch.raw.length)\n    .trim();\n\n  const { dimension, attribute } = parseLeftSide(leftSide);\n\n  return {\n    dimension,\n    attribute,\n    operator,\n    value: parseValue(operator, rightSide),\n    original,\n    expression: `${operator} ${rightSide}`\n  };\n};\n\n// Finds supported operators: =, !=, IN, NOT IN\nconst findOperator = (condition) => {\n  const match = condition.match(\n     /\\s+(not\\s+in|in)\\s*(?=\\()|\\s+(not\\s+in|in)\\s+|\\s*(>=|<=|!=|>|<|=)\\s*/i\n  );\n\n  if (!match) {\n    return null;\n  }\n\n  return {\n    index: match.index,\n    raw: match[0],\n    operator: match[1] || match[2] || match[3]\n  };\n};\n\n// Normalizes operator casing: \"not   in\" -> \"NOT IN\"\nconst normalizeOperator = (operator) => {\n  return operator\n    .trim()\n    .replace(/\\s+/g, \" \")\n    .toUpperCase();\n};\n\n// Splits left side into dimension and attribute.\nconst parseLeftSide = (leftSide) => {\n  const dotIndex = leftSide.indexOf(\".\");\n\n  if (dotIndex === -1) {\n    throw new Error(`Invalid condition left side: ${leftSide}`);\n  }\n\n  return {\n    dimension: leftSide.slice(0, dotIndex).trim(),\n    attribute: leftSide.slice(dotIndex + 1).trim()\n  };\n};\n\n// Parses right-side value based on operator.\nconst parseValue = (operator, rawValue) => {\n  if (operator === \"IN\" || operator === \"NOT IN\") {\n    return parseListValue(rawValue);\n  }\n\n  return stripOuterQuotes(rawValue);\n};\n\n// Parses values inside IN (...).\nconst parseListValue = (rawValue) => {\n  const trimmed = rawValue.trim();\n\n  if (!trimmed.startsWith(\"(\") || !trimmed.endsWith(\")\")) {\n    throw new Error(`Invalid list value: ${rawValue}`);\n  }\n\n  const innerValue = trimmed.slice(1, -1);\n  const parts = splitCommaSeparatedValues(innerValue);\n\n  return parts.map(stripOuterQuotes);\n};\n\n// Splits comma-separated values, ignoring commas inside quotes.\nconst splitCommaSeparatedValues = (value) => {\n  const result = [];\n\n  let current = \"\";\n  let insideQuote = false;\n\n  for (let i = 0; i < value.length; i++) {\n    const char = value[i];\n\n    if (char === \"'\") {\n      insideQuote = !insideQuote;\n      current += char;\n      continue;\n    }\n\n    if (char === \",\" && !insideQuote) {\n      result.push(current.trim());\n      current = \"\";\n      continue;\n    }\n\n    current += char;\n  }\n\n  if (current.trim()) {\n    result.push(current.trim());\n  }\n\n  return result;\n};\n\n// Removes surrounding single quotes.\nconst stripOuterQuotes = (value) => {\n  const trimmed = String(value).trim();\n\n  if (trimmed.startsWith(\"'\") && trimmed.endsWith(\"'\")) {\n    return trimmed.slice(1, -1);\n  }\n\n  return trimmed;\n};\n\nlet balancesAVRequest = $context.$input.inputParams.balancesAVRequest;\n\nreturn parseFilterFromPayload(balancesAVRequest);",
                    "sourceType": "code"
                  },
                  "diagram": {
                    "x": 10509,
                    "y": 5907
                  },
                  "outcomes": {
                    "success": "1780038282107"
                  },
                  "id": "1780038282106",
                  "code": "PARSE_BALANCES_AV_FILTER_1",
                  "type": "CODE",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "metadata": {
                    "name": "If Source is Variance 1"
                  },
                  "diagram": {
