                {
                  "metadata": {
                    "name": "Get Periods",
                    "returnType": "array",
                    "sourceCode": "if($context.$input.inputParams.queryByPeriod){\n  \n}\nelse{\n return[];\n}\n\nlet defaultQualifiers = $context.$input.inputParams.defaultQualifiers;\nlet defaultQualifierKeys = Object.keys(defaultQualifiers);\n\nlet periodKey;\nif (defaultQualifierKeys.includes('accountingPeriod')) {\n  periodKey = 'accountingPeriod';\n} else {\n  periodKey = 'periodName';\n}\n\n\nconst currPeriod = $context.$nodes.PROCESS_ACCOUNTING_PERIODS_1.$output.currPeriod || inputParams.PARSE_APP_CONTEXT?.periodName;\n\nlet prevPeriod = currPeriod;\n\nlet parsedBalancesAVFilter = $context.$nodes.PARSE_BALANCES_AV_FILTER.$output.result.parsedFilter;\n\nlet periodFilter = parsedBalancesAVFilter[periodKey];\nlet periods = periodFilter?.$memberName?.value ?? [];\n\nlet currIdx = periods.indexOf(currPeriod);\nif(currIdx != -1)\n  prevPeriod = periods[(1 + currIdx) % 2];\n\nlet query = [];\n\nlet periodVal = defaultQualifiers[periodKey];\nif($context.$input.inputParams.isCurrentPeriod){\n  query.push(`${periodVal}.$memberName IN ('${currPeriod}')`);\n}\nelse{\n  query.push(`${periodVal}.$memberName IN ('${prevPeriod}')`);\n}\n\nreturn query;"
                  },
