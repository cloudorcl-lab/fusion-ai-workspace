            "sourceCode": "let output = $context.$nodes.EXECUTE_JOURNALS_BV_FOR_EACH_SOURCE.$output;\n// return output;\nlet parsed = [];\nfor( let resp of output){\n  if(typeof resp == 'string')\n    resp = JSON.parse(resp);\n  parsed.push(resp);\n}\n\nreturn parsed;"
