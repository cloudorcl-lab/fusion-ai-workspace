                  "code": "FILTER_SEGMENT_METADATA",
                  "type": "CODE",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "metadata": {
                    "name": "Get Field Aliases",
                    "returnType": "object",
                    "sourceCode": "const buildSegmentAliasMap = (filterSegmentMetadata = {}, chartOfAccountId) =>\n  Object.values(filterSegmentMetadata).reduce((result, obj) => {\n    const segmentPath = `account<${chartOfAccountId}>.${obj.fieldName}`;\n\n    result[`${segmentPath}.value`] = `${obj.DIMENSIONATTRIBUTENAME}`;\n    result[`${segmentPath}.description`] = `${obj.DIMENSIONATTRIBUTENAME}Description`;\n\n    return result;\n  }, {});\n\nlet parsedFilter = $context.$nodes.PARSE_JOURNALS_AV_FILTER.$output.result.parsedFilter;\n\nlet chartOfAccountsId = $context.$triggers.REST.$input.inputParams.chartOfAccountsId;\n\nlet chartOfAccountsMetadata = $context.$triggers.REST.$input.inputParams.chartOfAccountsMetadata;\n\nlet avMetadata = $context.$triggers.REST.$input.inputParams.avMetadata;\n\nconst filterSegmentMetadata = $context.$nodes.FILTER_SEGMENT_METADATA.$output.result;\n\nconst dyn_field_aliases = buildSegmentAliasMap(\n  filterSegmentMetadata,\n  chartOfAccountsId\n);\n\nconst static_field_aliases = $context.$triggers.REST.$input.inputParams.fieldAliases;\n\nreturn { ...(dyn_field_aliases || {}), ...static_field_aliases };"
                  },
