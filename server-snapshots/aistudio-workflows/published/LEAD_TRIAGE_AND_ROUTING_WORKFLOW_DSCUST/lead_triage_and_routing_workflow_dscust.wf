          "code": "CREATELEADDESCRIPTION",
          "id": "1764180813785",
          "inputs": [
            {
              "id": "1764180813787_1",
              "name": "prompt",
              "type": "string",
              "value": "produce a lead description based on {{$context.$nodes.REFRESHCACHEDLEADINFO.$output}} \nusing information about the Lead, get as many details as you can from the Lead Account (CustomerPartyName) and the lead Primary Contact (PrimaryContactPartyName), the lead product, the lead rank, lead score and the lead amount please outline a brief description.\nreturn the Summary onto the return string property leadAIDescription\n\n## Requisites\nThe lead summary may not exceed 2000 characters should be formatted for text and not for HTML"
            },
            {
              "id": "1764180813787_2",
              "name": "temperature",
              "type": "number",
              "value": ".3"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"leadAIDescription\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
