        {
          "metadata": {
            "name": "Generate Bill Transactions List Redwood",
            "returnType": "string",
            "sourceCode": "const rawData = $context.$nodes.PRJ_PJB_BO_LIST_BT.$output;\nconst invalidCntMsg = $context.$variables.prjPjbVarUqPartialInvalidContList;\nconst projName = $context.$nodes.PRJ_PJB_LLM_EXTRACT_CONTEXT.$output.ProjectNumber;\nconst contNum = $context.$variables.prjPjbVarUqValidContractList;\nconst btSts = $context.$variables.prjPjbVarUqStatusCode;\nconst btStsComma = $context.$variables.prjPjbVarUqBtStsNameList;\nconst projectId = $context.$variables.prjPjbVarUqProjectId;\nconst fromDate = $context.$nodes.PRJ_PJB_LLM_EXTRACT_CONTEXT.$output.FromDate;\nconst toDate = $context.$nodes.PRJ_PJB_LLM_EXTRACT_CONTEXT.$output.ToDate;\nconst intent = $context.$variables.prjPjbVarUqIntent == null ? 'List' : String($context.$variables.prjPjbVarUqIntent);\nconst data = Array.isArray(rawData) ? rawData : Array.isArray(rawData?.items) ? rawData.items : Array.isArray(rawData?.output) ? rawData.output : [];\n\nfunction isBlank(value) {\n  return value === null || value === undefined || String(value).trim() === '';\n}\n\nfunction escapeHtml(value) {\n  return String(value)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\n}\n\nfunction formatTimestamp(value) {\n  const date = value ? new Date(value) : new Date();\n  if (Number.isNaN(date.getTime())) {\n    return '';\n  }\n  const pad = (num) => String(num).padStart(2, '0');\n  return pad(date.getUTCDate()) + '-' + pad(date.getUTCMonth() + 1) + '-' + date.getUTCFullYear() + ' ' + pad(date.getUTCHours()) + ':' + pad(date.getUTCMinutes());\n}\n\nfunction buildManageLink(statusCode, projectIdValue, fromDateValue, toDateValue) {\n  const params = [];\n  if (!isBlank(statusCode)) {\n    params.push('billing_status=' + encodeURIComponent(String(statusCode).trim()));\n  }\n  if (!isBlank(projectIdValue)) {\n    params.push('project_id=' + encodeURIComponent(String(projectIdValue).trim()));\n  }\n  const hasFromDate = !isBlank(fromDateValue);\n  const hasToDate = !isBlank(toDateValue);\n  if (hasFromDate || hasToDate) {\n    const left = hasFromDate ? String(fromDateValue).trim() : '';\n    const right = hasToDate ? String(toDateValue).trim() : '';\n    params.push('transacti%6Fn_date=' + encodeURIComponent(left + '|' + right));\n  }\n  return '/fscmUI/faces/redwood/project-billing/bill-transactions/manage' + (params.length ? '?' + params.join('&') : '');\n}\n\nfunction buildRowLink(billTransactionId) {\n  if (isBlank(billTransactionId)) {\n    return '';\n  }\n  return '/fscmUI/faces/redwood/project-billing/bill-transactions/edit?' +\n    'BillTransacti%6FnId=' + encodeURIComponent(String(billTransactionId));\n}\n\nfunction formatCurrency(value, currencyCode) {\n  const numeric = Number(value);\n  const safeValue = Number.isFinite(numeric) ? numeric : 0;\n  const code = isBlank(currencyCode) ? '' : String(currencyCode).trim();\n  const zeroDecimalCurrencies = ['JPY', 'KRW', 'ISK', 'UGX', 'VND', 'DJF', 'GNF', 'PYG', 'XAF', 'XOF', 'XPF'];\n  const threeDecimalCurrencies = ['YDD','BHD','TND','JOD','KWD','LYD','OMR','IQD'];\n  let fractionDigits = 2;\n  if (zeroDecimalCurrencies.includes(code)) {\n    fractionDigits = 0;\n  } else if (threeDecimalCurrencies.includes(code)) {\n    fractionDigits = 3;\n  }\n  const sign = safeValue < 0 ? '-' : ''; const absValue = Math.abs(safeValue); const fixed = absValue.toFixed(fractionDigits); const parts = fixed.split('.'); const integerPart = parts[0].replace(/\\B(?=(\\d{3})+(?!\\d))/g, ','); const decimalPart = parts.length > 1 ? '.' + parts[1] : ''; return sign + integerPart + decimalPart;\n}\n\nfunction makeTextBlock(displaySequence, text) {\n  return {\n    display_type: 'text',\n    display_sequence: displaySequence,\n    text: String(text)\n  };\n}\n\nfunction canonicalizeJsonText(value) {\n  const jsonText = typeof value === 'string' ? value : JSON.stringify(value);\n  try {\n    return JSON.stringify(JSON.parse(jsonText));\n  } catch (error) {\n    return jsonText;\n  }\n}\n\nfunction buildAtomicAgentDetails() {\n  const extractOutput = $context.$nodes.PRJ_PJB_LLM_EXTRACT_CONTEXT.$output || {};\n  const contextDetails = {};\n  Object.keys(extractOutput).forEach((key) => {\n    contextDetails[key] = extractOutput[key];\n  });\n  return {\n    atomicAgentName: 'ORA_PRJ_PJB_BILL_TRANSACTIONS_ASSISTANT',\n    atomicAgentContext: intent,\n    contextDetails,\n    filters: Object.assign({}, contextDetails)\n  };\n}\n\nfunction buildAgentJson(title, description, blocks) {\n  return canonicalizeJsonText({\n    agent: 'ORA_PRJ_PJB_BILL_TRANSACTIONS_ASSISTANT',\n    intent,\n    schema_version: '1',\n    title,\n    description,\n    timestamp: formatTimestamp($context.$system.$currentDate),\n    agent_response: blocks,\n    atomicAgentDetails: buildAtomicAgentDetails()\n  });\n}\n\nconst totalBillTrans = rawData?.totalResults != null && Number.isFinite(Number(rawData.totalResults)) ? Number(rawData.totalResults) : data.length;\nif (!totalBillTrans) {\n  const noDataMsg = 'I found 0 bill transactions matching your criteria.';\n  return buildAgentJson('Bill Transactions', noDataMsg, [makeTextBlock(1, noDataMsg)]);\n}\n\nconst listUrl = buildManageLink(btSts, projectId, fromDate, toDate);\nconst currencyCode = isBlank(data[0]?.InvoiceCurrencyCode) ? '' : String(data[0].InvoiceCurrencyCode).trim();\n\nconst totalPendingAmt = data.reduce((sum, row) => {\n  const numeric = Number(row?.AmountToBillInInvoiceCurrency);\n  return sum + (Number.isFinite(numeric) ? numeric : 0);\n}, 0);\n\nconst currencyCount = new Set(data.map((row) => {\n  return !isBlank(row?.InvoiceCurrencyCode) ? String(row.InvoiceCurrencyCode).trim() : '';\n}).filter((value) => value)).size;\n\nconst subjectParts = [];\nif (!isBlank(projName)) {\n  subjectParts.push('project ' + escapeHtml(String(projName).trim()));\n}\nif (!isBlank(contNum)) {\n  subjectParts.push('contract ' + escapeHtml(String(contNum).trim()));\n}\n\nlet subjectText = subjectParts.join(', ');\nconst statusText = !isBlank(btStsComma) ? String(btStsComma).trim() : !isBlank(btSts) ? String(btSts).trim() : '';\nif (statusText) {\n  subjectText += (subjectText ? ' with status ' : 'with status ') + escapeHtml(statusText);\n}\n\nconst intro = totalBillTrans > 25\n  ? currencyCount > 1\n    ? 'I found more than 25 bill transactions' + (subjectText ? ' for ' + subjectText : '') + '. Here are the first 25 transactions.'\n    : 'I found more than 25 bill transactions' + (subjectText ? ' for ' + subjectText : '') + '. Here are the first 25 transactions with total of ' + escapeHtml(formatCurrency(totalPendingAmt, currencyCode)) + ' ' + currencyCode + '.'\n  : currencyCount > 1\n    ? 'I found ' + totalBillTrans + ' bill transactions' + (subjectText ? ' for ' + subjectText : '') + '.'\n    : 'I found ' + totalBillTrans + ' bill transactions' + (subjectText ? ' for ' + subjectText : '') + ' with total of ' + escapeHtml(formatCurrency(totalPendingAmt, currencyCode)) + ' ' + currencyCode + '.';\n\nconst blocks = [];\nlet displaySequence = 1;\nif (!isBlank(invalidCntMsg)) {\n  blocks.push(makeTextBlock(displaySequence++, String(invalidCntMsg)));\n}\nblocks.push(makeTextBlock(displaySequence++, intro));\nblocks.push({\n  display_type: 'table',\n  display_sequence: displaySequence++,\n  rows: {\n    items: data.slice(0, 25).map((row, index) => {\n      const invCurrencyCode = !isBlank(row?.InvoiceCurrencyCode) ? String(row.InvoiceCurrencyCode).trim() : currencyCode;\n      const billTransactionId = isBlank(row?.BillTransactionId) ? '' : String(row.BillTransactionId);\n      return {\n        sequenceId: index + 1,\n        transactionNumber: billTransactionId,\n        date: isBlank(row?.TransactionDate) ? '' : String(row.TransactionDate),\n        status: isBlank(row?.BillingStatus) ? '' : String(row.BillingStatus),\n        quantity: isBlank(row?.InvoiceQuantity) ? '' : String(row.InvoiceQuantity),\n        unitPrice: formatCurrency(row?.UnitPriceInInvoiceCurrency, invCurrencyCode),\n        amountToBill: formatCurrency(row?.AmountToBillInInvoiceCurrency, invCurrencyCode),\n        currency: invCurrencyCode,\n        transactionUrl: buildRowLink(billTransactionId)\n      };\n    })\n  },\n  columns: {\n    items: [\n      {\n        headerText: 'Transaction Number',\n        field: 'transactionNumber',\n        id: 'transactionNumber',\n        resizable: 'enabled',\n        template: 'linkTemplate'\n      },\n      {\n        headerText: 'Date',\n        field: 'date',\n        id: 'date',\n        resizable: 'enabled',\n        template: 'dateTemplate'\n      },\n      {\n        headerText: 'Status',\n        field: 'status',\n        id: 'status',\n        resizable: 'enabled',\n        template: ''\n      },\n      {\n        headerText: 'Quantity',\n        field: 'quantity',\n        id: 'quantity',\n        resizable: 'enabled',\n        className: 'oj-helper-text-align-end',\n        template: ''\n      },\n      {\n        headerText: 'Unit Price',\n        field: 'unitPrice',\n        id: 'unitPrice',\n        resizable: 'enabled',\n        className: 'oj-helper-text-align-end',\n        template: 'cellTemplate'\n      },\n      {\n        headerText: 'Amount To Bill',\n        field: 'amountToBill',\n        id: 'amountToBill',\n        resizable: 'enabled',\n        className: 'oj-helper-text-align-end',\n        template: 'cellTemplate'\n      },\n      {\n        headerText: 'Currency',\n        field: 'currency',\n        id: 'currency',\n        resizable: 'enabled',\n        template: ''\n      }\n    ]\n  },\n  keyAttributes: {\n    items: ['sequenceId']\n  },\n  accessibility: {\n    'aria-label': 'Bill transactions list',\n    'row.accessible-row-header': 'transactionNumber'\n  }\n});\nblocks.push(makeTextBlock(\n  displaySequence++,\n  'To review the full list, navigate to <a href=\\'' + escapeHtml(listUrl) + '\\' target=\\'_blank\\'>Bill Transactions</a> UI'\n));\nreturn buildAgentJson('Bill Transactions', intro, blocks);"
          },
          "outcomes": {
