        {
          "metadata": {
            "name": "Set List BT Payload",
            "returnType": "string",
            "sourceCode": "function toQuotedInList(value, upperCase) {\n  if (value == null || String(value).trim() === \"\") {\n    return \"\";\n  }\n\n  return String(value)\n    .split(\",\")\n    .map((item) => item.trim())\n    .filter((item) => item !== \"\")\n    .map((item) => {\n      const unquoted = item.replace(/^'(.*)'$/, \"$1\");\n      const normalized = upperCase ? unquoted.toUpperCase() : unquoted;\n      return `'${normalized.replace(/'/g, \"''\")}'`;\n    })\n    .join(\", \");\n}\n\nconst projNum = toQuotedInList(\n  $context.$nodes.PRJ_PJB_LLM_EXTRACT_CONTEXT.$output.ProjectNumber,\n  true\n);\n\nconst statusCode =\n  $context.$variables.prjPjbVarUqBtSrvStatus == null\n    ? \"\"\n    : String($context.$variables.prjPjbVarUqBtSrvStatus);\n\nconst contNum = toQuotedInList(\n  $context.$variables.prjPjbVarUqValidContractList,\n  true\n);\n\nconst fromDate =\n  $context.$nodes.PRJ_PJB_LLM_EXTRACT_CONTEXT.$output.FromDate == null\n    ? \"\"\n    : String($context.$nodes.PRJ_PJB_LLM_EXTRACT_CONTEXT.$output.FromDate);\n\nconst toDate =\n  $context.$nodes.PRJ_PJB_LLM_EXTRACT_CONTEXT.$output.ToDate == null\n    ? \"\"\n    : String($context.$nodes.PRJ_PJB_LLM_EXTRACT_CONTEXT.$output.ToDate);\n\nconst clauses = [];\n\nif (projNum) {\n  clauses.push(`(upper(ProjectNumber) IN (${projNum}) OR upper(ProjectName) IN (${projNum}))`);\n}\n\nif (statusCode) {\n  clauses.push(`(BillingStatusCode IN (${statusCode}) OR BillingStatus IN (${statusCode}))`);\n}\n\nif (contNum) {\n  clauses.push(`(upper(ContractNumber) IN (${contNum}) OR upper(ContractName) IN (${contNum}))`);\n}\n\nif (fromDate && toDate) {\n  clauses.push(`TransactionDate BETWEEN '${fromDate}' AND '${toDate}'`);\n} else if (fromDate) {\n  clauses.push(`TransactionDate >= '${fromDate}'`);\n} else if (toDate) {\n  clauses.push(`TransactionDate <= '${toDate}'`);\n}\n\nconst whereClause = clauses.length ? `q=${encodeURIComponent(clauses.join(\" AND \"))}` : \"q=\";\n\nreturn `${whereClause}&totalResults=true&fields=ContractBusinessUnitName,BillTransactionId,ContractNumber,ContractLineNumber,ProjectNumber,TaskNumber,SourceTransactionId,TransactionDate,BillingTypeCode,BillToCustomer,BillingStatus,AmountToBillInContractCurrency,ContractCurrencyInvoiceAmount,ProjectId,ContractId,AmountToBillInTransactionCurrency,AmountToBillInInvoiceCurrency,ContractCurrencyCode,TransactionCurrencyCode,InvoiceCurrencyCode,UnitPriceInContractCurrency,InvoiceQuantity,TransactionCurrencyInvoiceUnitPrice,UnitPriceInInvoiceCurrency`;"
          },
          "outcomes": {
            "success": "1772455821785"
          },
          "code": "PRJ_PJB_CODE_SET_LIST_BT_PAYLOAD",
          "id": "1778524741935",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
