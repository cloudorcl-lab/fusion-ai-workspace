        {
          "metadata": {
            "name": "Generate Bill Transactions Summary Redwood",
            "returnType": "string",
            "sourceCode": "const rawData = $context.$nodes.PRJ_PJB_BO_FUNCTION_BT_SUMMARY.$output;\nconst invalidCntMsg = $context.$variables.prjPjbVarUqPartialInvalidContList;\nconst statusCode = $context.$variables.prjPjbVarUqStatusCode;\nconst projectId = $context.$variables.prjPjbVarUqProjectId;\nconst fromDate = $context.$nodes.PRJ_PJB_LLM_EXTRACT_CONTEXT.$output.FromDate;\nconst toDate = $context.$nodes.PRJ_PJB_LLM_EXTRACT_CONTEXT.$output.ToDate;\nconst intent = $context.$variables.prjPjbVarUqIntent == null ? 'Summarize' : String($context.$variables.prjPjbVarUqIntent);\nconst isRedwoodUi = true;\nconst data = Array.isArray(rawData) ? rawData : Array.isArray(rawData?.items) ? rawData.items : Array.isArray(rawData?.output) ? rawData.output : [];\nfunction isBlank(value) {\n  return value === null || value === undefined || String(value).trim() === '';\n}\nfunction escapeHtml(value) {\n  return String(value)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\n}\nfunction formatTimestamp(value) {\n  const date = value ? new Date(value) : new Date();\n  if (Number.isNaN(date.getTime())) {\n    return '';\n  }\n  const pad = (num) => String(num).padStart(2, '0');\n  return pad(date.getUTCDate()) + '-' + pad(date.getUTCMonth() + 1) + '-' + date.getUTCFullYear() + ' ' + pad(date.getUTCHours()) + ':' + pad(date.getUTCMinutes());\n}\nfunction buildManageLink(statusCodeValue, projectIdValue, fromDateValue, toDateValue) {\n  const params = [];\n  if (!isBlank(statusCodeValue)) {\n    params.push('billing_status=' + encodeURIComponent(String(statusCodeValue).trim()));\n  }\n  if (!isBlank(projectIdValue)) {\n    params.push('project_id=' + encodeURIComponent(String(projectIdValue).trim()));\n  }\n  const hasFromDate = !isBlank(fromDateValue);\n  const hasToDate = !isBlank(toDateValue);\n  if (hasFromDate || hasToDate) {\n    const left = hasFromDate ? String(fromDateValue).trim() : '';\n    const right = hasToDate ? String(toDateValue).trim() : '';\n    params.push('transacti%6Fn_date=' + encodeURIComponent(left + '|' + right));\n  }\n  return '/fscmUI/faces/redwood/project-billing/bill-transactions/manage' + (params.length ? '?' + params.join('&') : '');\n}\nfunction findKey(obj, candidates) {\n  if (!obj || typeof obj !== 'object') {\n    return null;\n  }\n  const normalizedCandidates = candidates.map((candidate) => candidate.toLowerCase());\n  for (const key of Object.keys(obj)) {\n    if (normalizedCandidates.includes(String(key).toLowerCase())) {\n      return key;\n    }\n  }\n  return null;\n}\nfunction formatCurrency(value, currencyCode) {\n  const numeric = Number(value);\n  const safeValue = Number.isFinite(numeric) ? numeric : 0;\n  const code = isBlank(currencyCode) ? '' : String(currencyCode).trim();\n  const zeroDecimalCurrencies = ['JPY', 'KRW', 'ISK', 'UGX', 'VND', 'DJF', 'GNF', 'PYG', 'XAF', 'XOF', 'XPF'];\n  const threeDecimalCurrencies = ['YDD','BHD','TND','JOD','KWD','LYD','OMR','IQD'];\n  let fractionDigits = 2;\n  if (zeroDecimalCurrencies.includes(code)) {\n    fractionDigits = 0;\n  } else if (threeDecimalCurrencies.includes(code)) {\n    fractionDigits = 3;\n  }\n  const sign = safeValue < 0 ? '-' : ''; const absValue = Math.abs(safeValue); const fixed = absValue.toFixed(fractionDigits); const parts = fixed.split('.'); const integerPart = parts[0].replace(/\\B(?=(\\d{3})+(?!\\d))/g, ','); const decimalPart = parts.length > 1 ? '.' + parts[1] : ''; return sign + integerPart + decimalPart;\n}\nfunction makeTextBlock(displaySequence, text) {\n  return {\n    display_type: 'text',\n    display_sequence: displaySequence,\n    text: String(text)\n  };\n}\nfunction canonicalizeJsonText(value) {\n  const jsonText = typeof value === 'string' ? value : JSON.stringify(value);\n  try {\n    return JSON.stringify(JSON.parse(jsonText));\n  } catch (error) {\n    return jsonText;\n  }\n}\nfunction buildAtomicAgentDetails() {\n  const contextDetails = {};\n  const extractOutput = $context.$nodes.PRJ_PJB_LLM_EXTRACT_CONTEXT.$output || {};\n  if (!isBlank(extractOutput.ProjectNumber)) {\n    contextDetails.Project = String(extractOutput.ProjectNumber);\n  }\n  if (!isBlank(extractOutput.ContractNumber)) {\n    contextDetails.Contract = String(extractOutput.ContractNumber);\n  }\n  if (!isBlank(extractOutput.Status)) {\n    contextDetails.Status = String(extractOutput.Status);\n  }\n  if (!isBlank(extractOutput.FromDate)) {\n    contextDetails.FromDate = String(extractOutput.FromDate);\n  }\n  if (!isBlank(extractOutput.ToDate)) {\n    contextDetails.ToDate = String(extractOutput.ToDate);\n  }\n  return {\n    atomicAgentName: 'ORA_PRJ_PJB_BILL_TRANSACTIONS_ASSISTANT',\n    atomicAgentContext: intent,\n    contextDetails,\n    filters: Object.assign({}, contextDetails)\n  };\n}\nfunction buildAgentJson(title, description, blocks) {\n  return canonicalizeJsonText({\n    agent: 'ORA_PRJ_PJB_BILL_TRANSACTIONS_ASSISTANT',\n    intent,\n    schema_version: '1',\n    title,\n    description,\n    timestamp: formatTimestamp($context.$system.$currentDate),\n    agent_response: blocks,\n    atomicAgentDetails: buildAtomicAgentDetails()\n  });\n}\nconst columnDefs = [\n  { label: 'Contract Number', keys: ['ContractNumber'], field: 'contractNumber', template: '' },\n  { label: 'Project Number', keys: ['ProjectNumber'], field: 'projectNumber', template: '' },\n  { label: 'Status', keys: ['BillingStatusName', 'BillingStatus', 'BillingStatusCode'], field: 'status', template: '' },\n  { label: 'Count of Bill Transactions', keys: ['BillTransCount'], field: 'billTransCount', template: '' },\n  { label: 'Amount To Bill', keys: ['pendingAmtToInvoice'], field: 'amountToBill', template: 'cellTemplate' },\n  { label: 'Currency', keys: ['trxCurrencyCode'], field: 'currency', template: '' }\n];\nconst validRows = data.filter((row) => {\n  const amountKey = findKey(row, ['pendingAmtToInvoice']);\n  const currencyKey = findKey(row, ['trxCurrencyCode']);\n  return amountKey && currencyKey && !isBlank(row[currencyKey]);\n});\nif (!validRows.length) {\n  const noDataMsg = 'I couldn’t find any bill transactions matching your criteria.';\n  if (isRedwoodUi) {\n    return buildAgentJson('Bill Transactions Summary', noDataMsg, [makeTextBlock(1, noDataMsg)]);\n  }\n  return '<div>' + noDataMsg + '</div>';\n}\nconst summaryUrl = buildManageLink(statusCode, projectId, fromDate, toDate);\nconst totalPendingAmt = validRows.reduce((sum, row) => {\n  const amountKey = findKey(row, ['pendingAmtToInvoice']);\n  const numeric = Number(amountKey ? row[amountKey] : 0);\n  return sum + (Number.isFinite(numeric) ? numeric : 0);\n}, 0);\nconst firstCurrencyKey = findKey(validRows[0], ['trxCurrencyCode']);\nconst currencyCode = firstCurrencyKey ? validRows[0][firstCurrencyKey] : '';\nconst currencyCount = new Set(\n  validRows\n    .map((row) => {\n      const currencyKey = findKey(row, ['trxCurrencyCode']);\n      return currencyKey && !isBlank(row[currencyKey]) ? String(row[currencyKey]).trim() : '';\n    })\n    .filter((value) => value)\n).size;\n\nconst columns = columnDefs.filter((column) =>\n  validRows.some((row) => Boolean(findKey(row, column.keys)))\n);\nconst summaryMessage = currencyCount > 1\n  ? 'I have found ' + validRows.length + ' rows.'\n  : 'I have found ' + validRows.length + ' rows with a total of ' + escapeHtml(formatCurrency(totalPendingAmt, currencyCode)) + ' ' + currencyCode + '.';\n\nif (isRedwoodUi) {\n  const blocks = [];\n  let displaySequence = 1;\n  if (!isBlank(invalidCntMsg)) {\n    blocks.push(makeTextBlock(displaySequence++, String(invalidCntMsg)));\n  }\n  blocks.push(makeTextBlock(displaySequence++, summaryMessage));\n  blocks.push({\n    display_type: 'table',\n    display_sequence: displaySequence++,\n    rows: {\n      items: validRows.slice(0, 25).map((row, index) => {\n        const amountKey = findKey(row, ['pendingAmtToInvoice']);\n        const currencyKey = findKey(row, ['trxCurrencyCode']);\n        const statusKey = findKey(row, ['BillingStatusName', 'BillingStatus', 'BillingStatusCode']);\n        const contractKey = findKey(row, ['ContractNumber']);\n        const countKey = findKey(row, ['BillTransCount']);\n        const projectKey = findKey(row, ['ProjectNumber']);\n        const rowCurrency = currencyKey ? row[currencyKey] : currencyCode;\n        return {\n          sequenceId: index + 1,\n          contractNumber: contractKey && !isBlank(row[contractKey]) ? String(row[contractKey]) : '',\n          projectNumber: projectKey && !isBlank(row[projectKey]) ? String(row[projectKey]) : '',\n          status: statusKey && !isBlank(row[statusKey]) ? String(row[statusKey]) : '',\n          billTransCount: countKey && !isBlank(row[countKey]) ? String(row[countKey]) : '',\n          amountToBill: amountKey && !isBlank(row[amountKey]) ? formatCurrency(row[amountKey], rowCurrency) : '',\n          currency: currencyKey && !isBlank(row[currencyKey]) ? String(row[currencyKey]) : ''\n        };\n      })\n    },\n    columns: {\n      items: columns.map((column) => ({\n        headerText: column.label,\n        field: column.field,\n        id: column.field,\n        resizable: 'enabled',\n        className: column.field === 'amountToBill' ? 'oj-typography-heading-xs' : undefined,\n        template: column.template\n      }))\n    },\n    keyAttributes: {\n      items: ['sequenceId']\n    },\n    accessibility: {\n      'aria-label': 'Bill transactions summary',\n      'row.accessible-row-header': 'contractNumber'\n    }\n  });\n  if (validRows.length > 25) {\n    blocks.push(makeTextBlock(displaySequence++, 'Data returned is more than 25 records.'));\n  }\n  blocks.push(makeTextBlock(\n  displaySequence++,\n  'To review the data, navigate to <a href=\\'' + escapeHtml(summaryUrl) + '\\' target=\\'_blank\\'>Bill Transactions</a> UI'\n));\n  return buildAgentJson('Bill Transactions Summary', summaryMessage, blocks);\n}\n\nconst bodyRows = validRows.slice(0, 25).map((row) => {\n  const cells = columns.map((column) => {\n    const key = findKey(row, column.keys);\n    if (!key || row[key] === null || row[key] === undefined) {\n      return '<td></td>';\n    }\n    if (column.label === 'Amount To Bill' || column.label === 'Quantity' || column.label === 'Unit Price') {\n  if (column.label === 'Amount To Bill') {\n    const currencyKey = findKey(row, ['trxCurrencyCode']);\n    const rowCurrency = currencyKey ? row[currencyKey] : currencyCode;\n    return '<td style=\\\"text-align:right; white-space:nowrap;\\\">' + escapeHtml(formatCurrency(row[key], rowCurrency)) + '</td>';\n  }\n  return '<td style=\\\"text-align:right; white-space:nowrap;\\\">' + (isBlank(row[key]) ? '' : escapeHtml(row[key])) + '</td>';\n}\nreturn '<td style=\\\"text-align:left; white-space:nowrap;\\\">' + (isBlank(row[key]) ? '' : escapeHtml(row[key])) + '</td>';\n  }).join('');\n  return '<tr>' + cells + '</tr>';\n}).join('');\nconst headerCells = columns.map((column) =>\n  '<th style=\\\"text-align:left; white-space:nowrap;\\\"><font face=\\\"Arial\\\" size=\\\"4\\\">' + column.label + '</font></th>'\n).join('');\n\nlet html = '';\nhtml += '<div>' + (isBlank(invalidCntMsg) ? '' : String(invalidCntMsg)) + '</div>';\nhtml += '<div>' + summaryMessage + '</div>';\nhtml += '<div style=\"height:8px;\"></div>';\nhtml += '<div style=\"height:8px;\"></div>';\nhtml += '<table border=\"1\" cellpadding=\"4\" cellspacing=\"0\" width=\"100%\">';\nhtml += '<thead><tr>' + headerCells + '</tr></thead>';\nhtml += '<tbody>' + bodyRows + '</tbody>';\nhtml += '</table>';\nhtml += '<div style=\"height:8px;\"></div>';\nif (validRows.length > 25) {\n  html += '<div>Data returned is more than 25 records.</div>';\n  html += '<div style=\"height:8px;\"></div>';\n}\nhtml += '<div>To review the data, navigate to <a href=\\'' + escapeHtml(summaryUrl) + '\\' target=\\'_blank\\'>Bill Transactions</a> UI</div>';\nreturn html;"
          },
