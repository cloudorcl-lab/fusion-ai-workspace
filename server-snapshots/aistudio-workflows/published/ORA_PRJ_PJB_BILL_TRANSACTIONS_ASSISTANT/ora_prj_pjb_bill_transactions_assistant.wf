        {
          "metadata": {
            "name": "Seed Prompt Summary Redwood",
            "returnType": "string",
            "sourceCode": "return JSON.stringify((() => {\n  const rawData = $context.$nodes.PRJ_PJB_BO_FUNCTION_BT_SUMMARY.$output;\n  const invalidCntMsg = $context.$variables.prjPjbVarUqPartialInvalidContList;\n  const statusCode = $context.$variables.prjPjbVarUqStatusCode;\n  const projectId = $context.$variables.prjPjbVarUqProjectId;\n  const fromDate = $context.$nodes.PRJ_PJB_LLM_EXTRACT_CONTEXT.$output.FromDate;\n  const toDate = $context.$nodes.PRJ_PJB_LLM_EXTRACT_CONTEXT.$output.ToDate;\n  const intent = $context.$variables.prjPjbVarUqIntent == null ? 'Summarize' : String($context.$variables.prjPjbVarUqIntent);\n  const data = Array.isArray(rawData) ? rawData : Array.isArray(rawData?.items) ? rawData.items : Array.isArray(rawData?.output) ? rawData.output : [];\n\n  function isBlank(value) {\n    return value === null || value === undefined || String(value).trim() === '';\n  }\n\n  function formatTimestamp(value) {\n    const date = value ? new Date(value) : new Date();\n    if (Number.isNaN(date.getTime())) return '';\n    const pad = (num) => String(num).padStart(2, '0');\n    return pad(date.getUTCDate()) + '-' + pad(date.getUTCMonth() + 1) + '-' + date.getUTCFullYear() + ' ' + pad(date.getUTCHours()) + ':' + pad(date.getUTCMinutes());\n  }\n\n  function findKey(obj, candidates) {\n    if (!obj || typeof obj !== 'object') return null;\n    const normalizedCandidates = candidates.map((candidate) => candidate.toLowerCase());\n    for (const key of Object.keys(obj)) {\n      if (normalizedCandidates.includes(String(key).toLowerCase())) return key;\n    }\n    return null;\n  }\n\n  const STATUS_LABELS = {\n  ready: 'Ready',\n  'on hold': 'On hold',\n  'insufficient funds': 'Insufficient funds',\n  error: 'Error',\n  'in progress': 'In Progress',\n  'action pending': 'Action Pending',\n  'non billable': 'Nonbillable'\n};\n\n  function normalizeStatus(status) {\n    return String(status || '')\n      .trim()\n      .toLowerCase()\n      .replace(/[_-]+/g, ' ')\n      .replace(/\\s+/g, ' ');\n  }\n\n  function getStatusValue(row) {\n    const key = findKey(row, ['BillingStatusName', 'BillingStatus', 'BillingStatusCode']);\n    return key && !isBlank(row[key]) ? String(row[key]).trim() : '';\n  }\n\n  function getStatusLabel(rowOrValue) {\n    const value = typeof rowOrValue === 'object' ? getStatusValue(rowOrValue) : rowOrValue;\n    const normalized = normalizeStatus(value);\n    return STATUS_LABELS[normalized] || String(value || '');\n  }\n\n  function isStatus(row, statuses) {\n    const normalized = normalizeStatus(getStatusValue(row));\n    return statuses.some((status) => normalizeStatus(status) === normalized);\n  }\n\n  function formatCurrency(value, currencyCode) {\n    const numeric = Number(value);\n    const safeValue = Number.isFinite(numeric) ? numeric : 0;\n    const code = isBlank(currencyCode) ? '' : String(currencyCode).trim();\n    const zeroDecimalCurrencies = ['JPY', 'KRW', 'ISK', 'UGX', 'VND', 'DJF', 'GNF', 'PYG', 'XAF', 'XOF', 'XPF'];\n  const threeDecimalCurrencies = ['YDD','BHD','TND','JOD','KWD','LYD','OMR','IQD'];\n    let fractionDigits = 2;\n\n    if (zeroDecimalCurrencies.includes(code)) {\n      fractionDigits = 0;\n    } else if (threeDecimalCurrencies.includes(code)) {\n      fractionDigits = 3;\n    }\n\n    const sign = safeValue < 0 ? '-' : ''; const absValue = Math.abs(safeValue); const fixed = absValue.toFixed(fractionDigits); const parts = fixed.split('.'); const integerPart = parts[0].replace(/\\B(?=(\\d{3})+(?!\\d))/g, ','); const decimalPart = parts.length > 1 ? '.' + parts[1] : ''; return sign + integerPart + decimalPart;\n  }\n\n  function getCount(row) {\n    const key = findKey(row, ['BillTransCount']);\n    const value = key ? Number(row[key]) : 0;\n    return Number.isFinite(value) ? value : 0;\n  }\n\n  function getAmount(row) {\n    const key = findKey(row, ['pendingAmtToInvoice']);\n    const value = key ? Number(row[key]) : 0;\n    return Number.isFinite(value) ? value : 0;\n  }\n\n  function getCurrency(row) {\n    const key = findKey(row, ['trxCurrencyCode']);\n    return key && !isBlank(row[key]) ? String(row[key]).trim() : '';\n  }\n\n  function summarizeRows(rows) {\n    const summary = {};\n\n    rows.forEach((row) => {\n      const currency = getCurrency(row);\n      if (!summary[currency]) {\n        summary[currency] = { count: 0, amount: 0 };\n      }\n      summary[currency].count += getCount(row);\n      summary[currency].amount += getAmount(row);\n    });\n\n    return Object.keys(summary).map((currency) => ({\n      currency,\n      count: summary[currency].count,\n      amount: summary[currency].amount\n    }));\n  }\n\n  function formatCountSummary(rows) {\n    return summarizeRows(rows).reduce((sum, item) => sum + item.count, 0);\n  }\n\n  function formatAmountText(item) {\n    return formatCurrency(item.amount, item.currency) + (item.currency ? ' ' + item.currency : '');\n  }\n\n  function formatAmountSummary(rows) {\n    return summarizeRows(rows)\n      .map((item) => formatAmountText(item))\n      .join(', ');\n  }\n\n  function makeBulletLine(text) {\n    return '&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;' + text;\n  }\n\n  function formatProcessingLines(rows, statusLabel, description) {\n    return summarizeRows(rows).map((item) =>\n      makeBulletLine(\n        '<b>' + item.count + ' transactions</b> are <b>' + statusLabel + '</b> (<b>' +\n          formatAmountText(item) + '</b>). ' + description\n      )\n    );\n  }\n\n  function makeTextBlock(displaySequence, text) {\n    return {\n      display_type: 'text',\n      display_sequence: displaySequence,\n      text: String(text)\n    };\n  }\n\n  function buildManageLink(statusCodeValue, projectIdValue, fromDateValue, toDateValue) {\n    const params = [];\n\n    if (!isBlank(statusCodeValue)) {\n      params.push('billing_status=' + encodeURIComponent(String(statusCodeValue).trim()));\n    }\n\n    if (!isBlank(projectIdValue)) {\n      params.push('project_id=' + encodeURIComponent(String(projectIdValue).trim()));\n    }\n\n    const hasFromDate = !isBlank(fromDateValue);\n    const hasToDate = !isBlank(toDateValue);\n\n    if (hasFromDate || hasToDate) {\n      const left = hasFromDate ? String(fromDateValue).trim() : '';\n      const right = hasToDate ? String(toDateValue).trim() : '';\n      params.push('transacti%6Fn_date=' + encodeURIComponent(left + '|' + right));\n    }\n\n    return '/fscmUI/faces/redwood/project-billing/bill-transactions/manage' + (params.length ? '?' + params.join('&') : '');\n  }\n\n  function cleanDisplayValue(value) {\n    return String(value || '').trim().replace(/^['\"]+|['\"]+$/g, '');\n  }\n\n  const contextDetails = {};\n  const extractOutput = $context.$nodes.PRJ_PJB_LLM_EXTRACT_CONTEXT.$output || {};\n  const requestedEntityLabel = !isBlank(extractOutput.ProjectNumber) ? 'project' : 'contract number';\n  const requestedEntityValue = !isBlank(extractOutput.ProjectNumber)\n    ? cleanDisplayValue(extractOutput.ProjectNumber)\n    : (!isBlank(extractOutput.ContractNumber) ? cleanDisplayValue(extractOutput.ContractNumber) : '');\n  const requestedEntityText = requestedEntityLabel + (isBlank(requestedEntityValue) ? '' : ' <b>' + requestedEntityValue + '</b>');\n\n  if (!isBlank(extractOutput.ProjectNumber)) contextDetails.Project = String(extractOutput.ProjectNumber);\n  if (!isBlank(extractOutput.ContractNumber)) contextDetails.Contract = String(extractOutput.ContractNumber);\n  if (!isBlank(extractOutput.Status)) contextDetails.Status = String(extractOutput.Status);\n  if (!isBlank(extractOutput.FromDate)) contextDetails.FromDate = String(extractOutput.FromDate);\n  if (!isBlank(extractOutput.ToDate)) contextDetails.ToDate = String(extractOutput.ToDate);\n\n  const validRows = data.filter((row) => {\n    const amountKey = findKey(row, ['pendingAmtToInvoice']);\n    const currencyKey = findKey(row, ['trxCurrencyCode']);\n    return amountKey && currencyKey && !isBlank(row[amountKey]) && !isBlank(row[currencyKey]);\n  });\n\n  const tableRows = validRows.filter((row) =>\n    isStatus(row, ['Ready', 'On hold', 'Insufficient funds'])\n  );\n\n  const errorRows = data.filter((row) => isStatus(row, ['Error']));\n  const inProgressRows = data.filter((row) => isStatus(row, ['In Progress']));\n  const actionPendingRows = data.filter((row) => isStatus(row, ['Action Pending']));\n  const onHoldRows = data.filter((row) => isStatus(row, ['On hold']));\n  const readyRows = data.filter((row) => isStatus(row, ['Ready']));\n\n  const blocks = [];\n  let displaySequence = 1;\n\n  if (!validRows.length && !errorRows.length && !inProgressRows.length && !actionPendingRows.length) {\n    const noDataMsg = 'I couldn’t find any bill transactions matching your criteria.';\n\n    blocks.push(makeTextBlock(displaySequence++, noDataMsg));\n\n    return {\n      agent: 'ORA_PRJ_PJB_BILL_TRANSACTIONS_ASSISTANT',\n      intent,\n      schema_version: '1',\n      title: 'Bill Transactions Summary',\n      description: noDataMsg,\n      timestamp: formatTimestamp($context.$system.$currentDate),\n      agent_response: blocks,\n      atomicAgentDetails: {\n        atomicAgentName: 'ORA_PRJ_PJB_BILL_TRANSACTIONS_ASSISTANT',\n        atomicAgentContext: intent,\n        contextDetails,\n        filters: Object.assign({}, contextDetails)\n      }\n    };\n  }\n\n  const summaryRows = validRows.filter((row) => !isStatus(row, ['In Progress']));\n  const currencyCode = validRows.length ? getCurrency(validRows[0]) : '';\n  const summaryAmountText = formatAmountSummary(summaryRows) ||\n    (formatCurrency(0, currencyCode) + (currencyCode ? ' ' + currencyCode : ''));\n\n  const summaryMessage = 'The total unbilled amount for ' + requestedEntityText + ' is <b>' +\n    summaryAmountText + '</b>. All amounts in my response are in invoice currency.';\n\n  if (!isBlank(invalidCntMsg)) {\n    blocks.push(makeTextBlock(displaySequence++, String(invalidCntMsg)));\n  }\n\n  blocks.push(makeTextBlock(displaySequence++, summaryMessage));\n   const columnDefs = [\n  { label: 'Status', field: 'status', keys: ['BillingStatusName', 'BillingStatus', 'BillingStatusCode'] },\n  { label: 'Transaction Count', field: 'billTransCount', keys: ['BillTransCount'] },\n  { label: 'Amount', field: 'amountToBill', keys: ['pendingAmtToInvoice'] }\n];\n\nconst columns = columnDefs.filter((column) =>\n  tableRows.some((row) => {\n    const key = findKey(row, column.keys);\n    return key && !isBlank(row[key]);\n  })\n);\n  if (tableRows.length) {\n    blocks.push(makeTextBlock(displaySequence++, '<b>Bill Transaction Summary</b>'));\n    blocks.push({\n      display_type: 'table',\n      display_sequence: displaySequence++,\n      rows: {\n        items: tableRows.slice(0, 25).map((row, index) => ({\n          sequenceId: index + 1,\n          status: getStatusLabel(row),\n          billTransCount: String(getCount(row)),\n          amountToBill: formatCurrency(getAmount(row), getCurrency(row)) + (getCurrency(row) ? ' ' + getCurrency(row) : '')\n        }))\n      },\n      columns: {\n  items: columns.map((column) => ({\n    headerText: column.label,\n    field: column.field,\n    id: column.field,\n    resizable: 'enabled',\n    className:\n      column.field === 'billTransCount' || column.field === 'amountToBill'\n        ? 'oj-helper-text-align-end'\n        : undefined,\n    template: column.field === 'amountToBill' ? 'cellTemplate' : ''\n  }))\n},\n      keyAttributes: {\n        items: ['sequenceId']\n      },\n      accessibility: {\n        'aria-label': 'Bill transactions summary',\n        'row.accessible-row-header': 'status'\n      }\n    });\n  }\n\n  if (tableRows.length) {\n  }\n\n  if (tableRows.length > 25) {\n    blocks.push(makeTextBlock(displaySequence++, 'Data returned is more than 25 records.'));\n  }\n\n  if (errorRows.length) {\n    blocks.push(makeTextBlock(displaySequence++, '<b>Requires Attention</b>'));\n    blocks.push(makeTextBlock(\n      displaySequence++,\n      makeBulletLine('<b>' + formatCountSummary(errorRows) +\n        ' transactions</b> are in <b>Error</b> status and are not included on invoices.')\n    ));\n  }\n\n  if (inProgressRows.length || actionPendingRows.length) {\n    blocks.push(makeTextBlock(displaySequence++, '<b>Processing Status</b>'));\n    if (inProgressRows.length) {\n      formatProcessingLines(\n        inProgressRows,\n        'In Progress',\n        'They have been added to invoices and are progressing through the invoice processing lifecycle.'\n      ).forEach((line) => blocks.push(makeTextBlock(displaySequence++, line)));\n    }\n\n    if (actionPendingRows.length) {\n      formatProcessingLines(\n        actionPendingRows,\n        'Action Pending',\n        'An adjustment has been made to these previously billed transactions, and additional processing is required before the action can be completed.'\n      ).forEach((line) => blocks.push(makeTextBlock(displaySequence++, line)));\n    }\n  }\n\n  const suggestedActions = [];\n  if (onHoldRows.length) {\n    suggestedActions.push('Review On hold Bill Transactions');\n  }\n  if (errorRows.length) {\n    suggestedActions.push('Review Error Bill Transactions');\n  }\n  if (!errorRows.length && !onHoldRows.length && readyRows.length) {\n    suggestedActions.push('Review Ready Bill Transactions');\n  }\n\n  if (suggestedActions.length) {\n    blocks.push(makeTextBlock(displaySequence++, '<b>Suggested Actions:</b>'));\n    blocks.push({\n      display_type: 'action',\n      display_sequence: displaySequence++,\n      actions: {\n        items: suggestedActions\n      }\n    });\n  }\n\n  blocks.push(makeTextBlock(\n    displaySequence++,\n    'To review the data, navigate to <a href=\\'' +\n      buildManageLink(statusCode, projectId, fromDate, toDate) +\n      '\\' target=\\'_blank\\'>Bill Transactions</a> UI'\n  ));\n\n  return {\n    agent: 'ORA_PRJ_PJB_BILL_TRANSACTIONS_ASSISTANT',\n    intent,\n    schema_version: '1',\n    title: 'Bill Transactions Summary',\n    description: summaryMessage,\n    timestamp: formatTimestamp($context.$system.$currentDate),\n    agent_response: blocks,\n    atomicAgentDetails: {\n      atomicAgentName: 'ORA_PRJ_PJB_BILL_TRANSACTIONS_ASSISTANT',\n      atomicAgentContext: intent,\n      contextDetails,\n      filters: Object.assign({}, contextDetails)\n    }\n  };\n})());"
