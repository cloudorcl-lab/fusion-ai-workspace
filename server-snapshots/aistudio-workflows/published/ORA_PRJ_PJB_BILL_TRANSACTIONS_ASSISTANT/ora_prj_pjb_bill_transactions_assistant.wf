            "sourceCode": "const contextDetails = {};\nconst extractOutput = $context.$nodes.PRJ_PJB_LLM_EXTRACT_CONTEXT.$output || {};\n\nif (extractOutput.ProjectNumber != null && String(extractOutput.ProjectNumber).trim() !== '') {\n  contextDetails.Project = extractOutput.ProjectNumber;\n}\nif (extractOutput.ContractNumber != null && String(extractOutput.ContractNumber).trim() !== '') {\n  contextDetails.Contract = extractOutput.ContractNumber;\n}\nif (extractOutput.Status != null && String(extractOutput.Status).trim() !== '') {\n  contextDetails.Status = extractOutput.Status;\n}\nif (extractOutput.FromDate != null && String(extractOutput.FromDate).trim() !== '') {\n  contextDetails.FromDate = extractOutput.FromDate;\n}\nif (extractOutput.ToDate != null && String(extractOutput.ToDate).trim() !== '') {\n  contextDetails.ToDate = extractOutput.ToDate;\n}\n\nconst atomicAgentContext =\n  $context.$variables.prjPjbVarUqIntent == null\n    ? 'None'\n    : String($context.$variables.prjPjbVarUqIntent);\n\nconst message =\n  $context.$nodes.PRJ_PJB_LLM_REQUEST_TO_CORRECT_INTENT.$output.MessageToDisplay == null\n    ? ''\n    : String($context.$nodes.PRJ_PJB_LLM_REQUEST_TO_CORRECT_INTENT.$output.MessageToDisplay);\n\nconst date = $context.$system.$currentDate ? new Date($context.$system.$currentDate) : new Date();\nconst pad = (num) => String(num).padStart(2, '0');\nconst timestamp =\n  pad(date.getUTCDate()) + '-' +\n  pad(date.getUTCMonth() + 1) + '-' +\n  date.getUTCFullYear() + ' ' +\n  pad(date.getUTCHours()) + ':' +\n  pad(date.getUTCMinutes());\n\nreturn JSON.stringify({\n  agent: 'ORA_PRJ_PJB_BILL_TRANSACTIONS_ASSISTANT',\n  intent: atomicAgentContext,\n  schema_version: '1',\n  title: 'Bill Transactions Assistant Response',\n  description: message,\n  timestamp: timestamp,\n  agent_response: [\n    {\n      display_type: 'text',\n      display_sequence: 1,\n      text: message\n    }\n  ],\n  atomicAgentDetails: {\n    atomicAgentName: 'ORA_PRJ_PJB_BILL_TRANSACTIONS_ASSISTANT',\n    atomicAgentContext: atomicAgentContext,\n    contextDetails: contextDetails,\n    filters: Object.assign({}, contextDetails)\n  }\n});"
