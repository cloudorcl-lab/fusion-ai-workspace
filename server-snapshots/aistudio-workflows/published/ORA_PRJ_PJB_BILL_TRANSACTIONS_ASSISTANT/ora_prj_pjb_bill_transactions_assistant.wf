            "sourceCode": "let summary = $context.$nodes.PRJ_PJB_LLM_GENERATE_BT_SUMMARY_SQL.$output;\nlet extract = $context.$nodes.PRJ_PJB_LLM_GENERATE_BT_SUMMARY_EXTRACTION_DATA.$output;\n\nconst payload =  {\n  viewQueries: {\n    bo: {\n      module: \"oraErpCoreProjectBillingTransactions\", businessObject: \"ProjectContractBillTransaction\", view: \"projectContractBillTransactionDetails\", fieldAliases: { sourceObjectTypeCode: \"sourceObjectTypeCode\", \"project.id\": \"projectId\", \"project.name\": \"projectName\",  \"project.projectNumber\": \"projectNumber\",  \"contractBusinessUnit.id\": \"businessUnitId\",   \"contract.id\": \"contractId\",  \"contract.contractNumber\": \"contractNumber\",\n        \"billingStatus.code\": \"billingStatusCode\",\n        \"billingStatus.name\": \"billingStatusName\",\n        \"invoiceCurrency.currencyCode\": \"trxCurrencyCode\",\n        \"amountToBillInInvoiceCurrency\": \"amtToBillTransCcy\",\n       \"transactionDate\":\"transactionDate\",\n        \"id\":\"id\"\n      },\n    },\n  },\n  select: summary\n};\n\nreturn JSON.stringify(payload);"
