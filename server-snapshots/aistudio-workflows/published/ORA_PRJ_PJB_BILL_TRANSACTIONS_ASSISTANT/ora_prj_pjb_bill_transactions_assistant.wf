        {
          "metadata": {
            "name": "WrongIntentJson",
            "returnType": "string",
            "sourceCode": "let content =   $context.$nodes.PRJ_PJB_LLM_REQUEST_TO_CORRECT_INTENT.$output.MessageToDisplay == null\n    ? ''\n    : String($context.$nodes.PRJ_PJB_LLM_REQUEST_TO_CORRECT_INTENT.$output.MessageToDisplay);\nconst intent = \"Agent Intro\"\nconst agent = \"Project Bill Transactions Assistant 26D\";\n\nif (content === null || content === undefined) {\n  content = \"\";\n}\n\nif (typeof content !== \"string\") {\n  try {\n    content = JSON.stringify(content);\n  } catch (e) {\n    content = String(content);\n  }\n}\n\nfunction decodeHtmlEntities(str) {\n  return String(str)\n    .replace(/&nbsp;/g, \" \")\n    .replace(/&amp;/g, \"&\")\n    .replace(/&lt;/g, \"<\")\n    .replace(/&gt;/g, \">\")\n    .replace(/&quot;/g, '\"')\n    .replace(/&#39;/g, \"'\");\n}\n\nfunction stripTags(str) {\n  return decodeHtmlEntities(\n    String(str)\n      .replace(/<br\\s*\\/?>/gi, \"\\n\")\n      .replace(/<\\/div>\\s*<div[^>]*>/gi, \"\\n\")\n      .replace(/<\\/p>\\s*<p[^>]*>/gi, \"\\n\")\n      .replace(/<li[^>]*>/gi, \"- \")\n      .replace(/<\\/li>/gi, \"\\n\")\n      .replace(/<[^>]+>/g, \"\")\n  )\n    .replace(/\\n{3,}/g, \"\\n\\n\")\n    .trim();\n}\n\nfunction hasVisibleText(str) {\n  return stripTags(str).length > 0;\n}\n\nfunction looksNumeric(value) {\n  return /^-?\\$?\\d+(,\\d{3})*(\\.\\d+)?$/.test(String(value).trim());\n}\n\nfunction normalizeAmount(value) {\n  return String(value).trim().replace(/^\\$/, \"\").replace(/,/g, \"\");\n}\n\nconst response = {\n  schema_version: \"1.0\",\n  agent,\n  intent,\n  agent_response: []\n};\n\nlet displaySequence = 1;\n\nfunction addTextBlock(text, heading) {\n  if (!text || !hasVisibleText(text)) {\n    return;\n  }\n\n  const block = {\n    display_type: \"text\",\n    display_sequence: displaySequence++,\n    text: String(text).trim()\n  };\n\n  if (heading) {\n    block.heading = heading;\n  }\n\n  response.agent_response.push(block);\n}\n\nif (/<table[\\s>]/i.test(content)) {\n  const tableMatch = content.match(/<table[\\s\\S]*?<\\/table>/i);\n  const tableHtml = tableMatch ? tableMatch[0] : \"\";\n  const tableIndex = tableMatch && typeof tableMatch.index === \"number\" ? tableMatch.index : -1;\n  const before = tableIndex >= 0 ? content.slice(0, tableIndex) : content;\n  const after = tableIndex >= 0 ? content.slice(tableIndex + tableHtml.length) : \"\";\n\n  if (hasVisibleText(before)) {\n    addTextBlock(before);\n  }\n\n  const headers = [...tableHtml.matchAll(/<th\\b[^>]*>([\\s\\S]*?)<\\/th>/gi)].map(match => stripTags(match[1]));\n  const rawRows = [...tableHtml.matchAll(/<tr\\b[^>]*>([\\s\\S]*?)<\\/tr>/gi)].map(match => match[1]);\n  const bodyRows = [];\n\n  for (const rawRow of rawRows) {\n    if (/<th\\b/i.test(rawRow)) {\n      continue;\n    }\n\n    const cells = [...rawRow.matchAll(/<td\\b[^>]*>([\\s\\S]*?)<\\/td>/gi)].map(match => stripTags(match[1]));\n    if (cells.length > 0) {\n      bodyRows.push(cells);\n    }\n  }\n\n  let normalizedHeaders = headers.slice();\n  if (normalizedHeaders.length === 0 && bodyRows.length > 0) {\n    normalizedHeaders = bodyRows.shift().map((value, index) => value || `Column ${index + 1}`);\n  }\n\n  if (normalizedHeaders.length === 0 && bodyRows.length > 0) {\n    normalizedHeaders = bodyRows[0].map((_, index) => `Column ${index + 1}`);\n  }\n\n  const heading = hasVisibleText(before) ? stripTags(before).split(\"\\n\").map(line => line.trim()).find(Boolean) : \"\";\n  const currencyMatch = content.match(/Receiver Ledger Currency<\\/b>\\s*\\(<b>([^<]+)<\\/b>\\)/i);\n  const currencyCode = currencyMatch ? stripTags(currencyMatch[1]) : \"\";\n\n  const columns = normalizedHeaders.map((headerText, index) => {\n    const field = `col${index + 1}`;\n    const column = {\n      id: field,\n      field,\n      headerText: headerText || `Column ${index + 1}`,\n      className: \"\",\n      resizable: true,\n      template: \"cellTemplate\"\n    };\n\n    if (/date/i.test(column.headerText)) {\n      column.template = \"dateTemplate\";\n    } else if (currencyCode && /amount|cost|total/i.test(column.headerText)) {\n      column.template = \"monetaryTemplate\";\n      column.monetaryTemplateInfo = {\n        currencyField: `${field}_currency`\n      };\n    }\n\n    return column;\n  });\n\n  const rows = bodyRows.map((cells, rowIndex) => {\n    const row = {\n      id: `row${rowIndex + 1}`\n    };\n\n    columns.forEach((column, columnIndex) => {\n      const value = cells[columnIndex] ?? \"\";\n      if (column.template === \"monetaryTemplate\" && looksNumeric(value)) {\n        row[column.field] = `{amount:${normalizeAmount(value)},currency:${currencyCode}}`;\n        row[`${column.field}_currency`] = currencyCode;\n      } else if (column.template === \"dateTemplate\" && /^\\d{4}-\\d{2}-\\d{2}$/.test(value)) {\n        row[column.field] = `{date:${value}}`;\n      } else {\n        row[column.field] = value;\n      }\n    });\n\n    return row;\n  });\n\n  response.agent_response.push({\n    display_type: \"table\",\n    display_sequence: displaySequence++,\n    heading: heading || undefined,\n    rows: {\n      items: rows\n    },\n    columns: {\n      items: columns\n    },\n    keyAttributes: {\n      items: [\"id\"]\n    },\n    accessibility: {\n      \"aria-label\": heading || `${intent} table`,\n      row: {\n        \"accessible-row-header\": columns.length > 0 ? columns[0].field : \"id\"\n      }\n    }\n  });\n\n  if (hasVisibleText(after)) {\n    addTextBlock(after);\n  }\n} else {\n  addTextBlock(content);\n}\n\nif (response.agent_response.length === 0) {\n  addTextBlock(stripTags(content) || \"No response available.\");\n}\n\nreturn JSON.stringify(response);"
          },
