{
  "workflowId": "100002355226967",
  "workflowCode": "ORA_FIN_AP_VIEW_OFFERS_ANALYST",
  "name": "View Offers Analyst",
  "description": "The View Offers Analyst retriever provides a clear, professional summary of retrieved offer data for payment specialists.",
  "specification": {
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
