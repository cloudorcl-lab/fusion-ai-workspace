        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_PAYABLES_OFFERDETAILS",
            "functionName": "retrieve_offer_details",
            "name": "Offer Details Retriever"
          },
          "outcomes": {
            "success": "1771085766225"
          },
          "code": "FIN_AP_BO_OFFER_DETAILS_RETRIEVER",
          "id": "1770011163424",
          "inputs": [
            {
              "id": "1770026445502_1",
              "name": "filter",
              "type": "string",
              "value": "{{$context.$nodes.FIN_AP_LLM_OFFER_INTENT_ANALYZER.$output.filter}}"
            },
            {
              "id": "1770026445503_2",
              "name": "sortCriteria",
              "type": "string",
              "value": "{{$context.$nodes.FIN_AP_LLM_OFFER_INTENT_ANALYZER.$output.sortCriteria}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Construct table data",
            "returnType": "array",
            "sourceCode": "// Inputs from context\nconst rawResponse = $context.$nodes.FIN_AP_BO_OFFER_DETAILS_RETRIEVER.$output || [];\nconst isAprView = $context.$nodes.FIN_AP_LLM_OFFER_INTENT_ANALYZER.$output.isAPRRequired; \nconst currencyCode = $context.$triggers.REST.$input.currencyCode; \n\n// LLM block response\nconst llmResponse = $context.$nodes.FIN_AP_LLM_RESULT_FORMATTER.$output || {};\nconst summaryText = llmResponse.summary || null;\nconst actionsList = llmResponse.actions || [];\n\n// 1. Filter and Slice (Max 10 rows)\nconst dataToProcess = rawResponse.slice(0, 10);\n\nlet outputBlocks = [];\n\n// 2. Add Summary Block (Sequence 1)\nif (summaryText) {\n    outputBlocks.push({\n        type: \"text\",\n        content: summaryText,\n        sequence: 1\n    });\n}\n\n// 3. Table OR Empty State Block (Sequence 2)\nif (dataToProcess.length > 0) {\n\n    const columnOrder = [\n        \"Supplier Name\",\n        \"Number of Installments\",\n        \"Total Outstanding Amount\",\n        \"Program Type\"\n    ];\n\n    if (isAprView) {\n        columnOrder.push(\"APR %\");\n    }\n\n    columnOrder.push(\"Email Address\");\n\n    const tableContent = dataToProcess.map(item => {\n        const row = {\n            \"Supplier Name\": item.supplierName || \"Not provided\",\n            \"Number of Installments\": String(item.noOfInstallments || 0),\n            \"Total Outstanding Amount\": `${(item.totalUnpaidAmount || 0).toLocaleString()} ${item.currencyCode || currencyCode}`,\n            \"Program Type\": item.financingOptionType || \"Not provided\",\n            \"Email Address\": item.emailAddress || \"Not provided\"\n        };\n\n        if (isAprView) {\n            let aprDisplay = \"Not available\";\n            if (item.minDiscountRate != null && item.maxDiscountRate != null) {\n                aprDisplay = (item.minDiscountRate === item.maxDiscountRate)\n                    ? `${item.minDiscountRate}%`\n                    : `${item.minDiscountRate}% – ${item.maxDiscountRate}%`;\n            }\n            row[\"APR %\"] = aprDisplay;\n        }\n\n        return row;\n    });\n\n    outputBlocks.push({\n        type: \"table\",\n        heading: \"Offer Details\",\n        content: tableContent,\n        sequence: 2,\n        columnOrder: columnOrder\n    });\n\n} else {\n\n    // Empty state fallback\n    outputBlocks.push({\n        type: \"text\",\n        content: \"At this time, no offers match your selected criteria. Please adjust your filters and try again.\",\n        sequence: 2\n    });\n}\n\n// 4. Add Actions Block (Sequence 3)\nif (actionsList.length > 0) {\n    outputBlocks.push({\n        type: \"actions\",\n        content: actionsList,\n        sequence: 3\n    });\n}\n\n// 5. Return structured output\nreturn outputBlocks;"
          },
          "outcomes": {
            "success": "1767692445771"
          },
          "code": "FIN_AP_CODE_CONSTRUCT_TABLE_DATA",
          "id": "1771085659114",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.25
              },
              "code": "ORA_LLM_MODEL_PROVIDER_CERT_BASIC_LLAMA_3_3_70B",
              "model": "ORA_LLM_MODEL_GPT_OSS_120B",
              "modelName": "GPT OSS 120B (Basic)",
              "provider": "CERT_BASIC"
            },
            "name": "Result Formatter"
          },
          "outcomes": {
            "success": "1771085659114"
          },
          "code": "FIN_AP_LLM_RESULT_FORMATTER",
          "convergenceTargetId": "1771085766225",
          "id": "1766136008941",
          "inputs": [
            {
              "id": "1766136008943_1",
              "name": "prompt",
              "type": "string",
              "value": "# ROLE\nYou are the Offer Results Summarization Agent. Your responsibility is to analyze retrieved offer data and provide a professional summary and suggested next steps in a structured JSON format.\n\n# STRICT SCOPE\n- You are ONLY responsible for summarizing data and suggesting next actions.\n- You must NOT build HTML tables.\n- You must NOT mention backend field names or system logic.\n- You must NOT infer, calculate, or fabricate values.\n\n# AVAILABLE INPUTS\n- isMoreOffersPresent : {{$context.$nodes.FIN_AP_CODE_CHECK_FOR_VALID_ITEMS.$output.result}} \n- User Message: {{$context.$system.$inputMessage}}\n- Applied filters : {{$context.$nodes.FIN_AP_LLM_OFFER_INTENT_ANALYZER.$output.filter}}\n- sortCriteria : {{$context.$nodes.FIN_AP_LLM_OFFER_INTENT_ANALYZER.$output.sortCriteria}} \n\n# SUMMARY SENTENCE RULES\n\n- Describe applied filters in clear, human-readable language using the Applied filters and sortCriteria inputs.\n- Do not reference backend field names or system logic.\n- Keep the tone professional, neutral, and concise.\n\n# CRITICAL BEHAVIOR RULE\n\n- The summary must describe the selection criteria only.\n- Do NOT state or imply whether results exist.\n- Do NOT use phrases such as:\n  - \"Showing offers\"\n  - \"The following offers\"\n  - \"No offers found\"\n  - \"X offers match\"\n  - Any language that suggests result availability\n\n- The summary should read as a neutral description of the current query context and filtering conditions.\n\n# TRUNCATION RULE\n\n- If `isMoreOffersPresent=true`, you MUST append EXACTLY:\n\n  \"More than 10 offers match your criteria. Only the first 10 are shown. Please narrow down your filters to see more specific results.\"\n\n- Do NOT include this sentence otherwise.\n\n# FOLLOW-UP ACTIONS \n\n- Provide suggested queries as imperative statements (e.g., \"Show...\", \"List...\"). \n- Supported Filters ONLY: Offer Status, Financing Option Type, Supplier Name, Total Outstanding Amount, Currency, Recipient. \n- Eg: Follow patterns like Show Dynamic Discount offers, Show offers for a specific supplier, Show offers without having a recipient, Show offers in {{$context.$triggers.REST.$input.currencyCode}} etc. \n- In actions only mention Financing Option Type as Dynamic Discounting and Offer status as Shortlisted \n- Disallowed: APR, installments, dates, or exports.\n- Do NOT copy supplier names from the input into actions.\n\n# OUTPUT FORMAT (MANDATORY JSON)\nReturn ONLY a valid JSON object. Do not include markdown headers, explanations, or backticks.\n\n{\n  \"summary\": \"The concise summary sentence string here\",\n  \"actions\": [\n    \"Action suggestion 1\",\n    \"Action suggestion 2\"\n  ]\n}"
            }
          ],
          "outputSpecification": "{\n\"type\": \"object\",\n\"description\": \"Structured summary response for retrieved offer results including a concise summary and suggested next actions.\",\n\"properties\": {\n\"summary\": {\n\"type\": \"string\",\n\"description\": \"A professional, human-readable summary sentence that includes the Business Unit and Currency, explains applied filters and sorting in plain language, and includes the mandatory truncation sentence if more than 10 offers are present.\"\n},\n\"actions\": {\n\"type\": \"array\",\n\"description\": \"List of suggested follow-up queries written as imperative statements. Suggestions must only use supported filters: Offer Status, Financing Option Type, Supplier Name, Total Outstanding Amount, Currency, and Recipient.\",\n\"items\": {\n\"type\": \"string\"\n}\n}\n},\n\"required\": [\"summary\", \"actions\"],\n\"additionalProperties\": false\n}",
