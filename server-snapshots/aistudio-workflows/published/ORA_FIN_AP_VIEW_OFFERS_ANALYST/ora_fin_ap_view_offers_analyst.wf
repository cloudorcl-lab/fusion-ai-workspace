            "sourceCode": "let outputBlocks = [];\n\n outputBlocks.push({\n        type: \"text\",\n        content: $context.$nodes.FIN_AP_LLM_UNSUPPORTED_QUERY_HANDLER.$output.replace(/\\n/g, \"<br>\"),\n        sequence: 1\n    });\n\nreturn outputBlocks;"
          },
