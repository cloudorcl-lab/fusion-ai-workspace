            "sourceCode": "const raw = $context.$nodes.CHECK_SUBSTITUTES_FOR_ITEMS_IN_WORK_ORDER.$output ?? [];\n\nconst objectsArr = (Array.isArray(raw) ? raw : [])\n  .map(s => { try { return JSON.parse(String(s)); } catch { return null; } })\n  .map(o => o?.result)\n  .filter(r => r != null);\n \nreturn objectsArr;"
          },
