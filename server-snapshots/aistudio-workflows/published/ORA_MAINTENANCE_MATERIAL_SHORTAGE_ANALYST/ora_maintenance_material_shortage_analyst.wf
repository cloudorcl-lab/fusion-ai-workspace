                  "metadata": {
                    "name": "Append Additional Information",
                    "returnType": "object",
                    "sourceCode": "let retValue = {};\n\nlet WorkOrderNumber = $context.$nodes.MATERIAL_SHORTAGE_DETAILS_FOR_WORK_ORDER.$output.items[0].WorkOrderNumber;\nlet WorkOrderId = $context.$nodes.MATERIAL_SHORTAGE_DETAILS_FOR_WORK_ORDER.$output.items[0].WorkOrderId;\nlet WorkOrderType = $context.$nodes.MATERIAL_SHORTAGE_DETAILS_FOR_WORK_ORDER.$output.items[0].WorkOrderType;\nlet WorkOrderSubType = $context.$nodes.MATERIAL_SHORTAGE_DETAILS_FOR_WORK_ORDER.$output.items[0].WorkOrderSubType;\nlet OrganizationId = $context.$nodes.MATERIAL_SHORTAGE_DETAILS_FOR_WORK_ORDER.$output.items[0].OrganizationId;\nlet WorkOrderDescription = $context.$nodes.MATERIAL_SHORTAGE_DETAILS_FOR_WORK_ORDER.$output.items[0].WorkOrderDescription;\nlet AssetNumber = $context.$nodes.MATERIAL_SHORTAGE_DETAILS_FOR_WORK_ORDER.$output.items[0].AssetNumber;\nlet RequiredDate = $context.$nodes.CHECK_SUBSTITUTES_FOR_ITEMS_IN_WORK_ORDER.$currentItem.RequiredDate;\nlet OperationSequenceNumber =   $context.$nodes.CHECK_SUBSTITUTES_FOR_ITEMS_IN_WORK_ORDER.$currentItem.OperationSequenceNumber;\nlet WoOperationId =   $context.$nodes.CHECK_SUBSTITUTES_FOR_ITEMS_IN_WORK_ORDER.$currentItem.WoOperationId;\nlet OperationName =   $context.$nodes.CHECK_SUBSTITUTES_FOR_ITEMS_IN_WORK_ORDER.$currentItem.OperationName;\nlet OperationDescription =   $context.$nodes.CHECK_SUBSTITUTES_FOR_ITEMS_IN_WORK_ORDER.$currentItem.OperationDescription;\nlet WoOperationMaterialId =   $context.$nodes.CHECK_SUBSTITUTES_FOR_ITEMS_IN_WORK_ORDER.$currentItem.WoOperationMaterialId;\nlet MaterialSequenceNumber = $context.$nodes.CHECK_SUBSTITUTES_FOR_ITEMS_IN_WORK_ORDER.$currentItem.MaterialSequenceNumber;\nlet ItemNumber =   $context.$nodes.CHECK_SUBSTITUTES_FOR_ITEMS_IN_WORK_ORDER.$currentItem.ItemNumber;\nlet InventoryItemId =   $context.$nodes.CHECK_SUBSTITUTES_FOR_ITEMS_IN_WORK_ORDER.$currentItem.InventoryItemId;\nlet ItemDescription =   $context.$nodes.CHECK_SUBSTITUTES_FOR_ITEMS_IN_WORK_ORDER.$currentItem.Description;\nlet UOM =   $context.$nodes.CHECK_SUBSTITUTES_FOR_ITEMS_IN_WORK_ORDER.$currentItem.UnitOfMeasure;\nlet RequiredQuantity =   $context.$nodes.CHECK_SUBSTITUTES_FOR_ITEMS_IN_WORK_ORDER.$currentItem.RequiredQuantity;\nlet OpenQuantity =   $context.$nodes.CHECK_SUBSTITUTES_FOR_ITEMS_IN_WORK_ORDER.$currentItem.OpenQuantity;\nlet ShortageQuantity =   $context.$nodes.CHECK_SUBSTITUTES_FOR_ITEMS_IN_WORK_ORDER.$currentItem.ShortageQuantity;\nlet SubstituteItem = null;\nif (RequiredQuantity === OpenQuantity && OpenQuantity === ShortageQuantity) {\n  SubstituteItem = ((($context.$nodes.CHECK_SUBSTITUTES_FOR_ITEMS_IN_WORK_ORDER.CHECK_SUBSTITUTE_FOR_ITEM.$output?.items) || []).find(it => Number(it?.AvailableToTransactQuantity) >= RequiredQuantity) || {}).ItemNumber ?? null;\n}\nlet OrgsWithStock = ( $context.$nodes.CHECK_SUBSTITUTES_FOR_ITEMS_IN_WORK_ORDER.CHECK_ON_HAND_FOR_ORIGINAL_ITEM_ACROSS_ORGS?.$output?.items ?? []).filter(r => (Number(r?.OnhandQuantity ?? 0) || 0) > 0).length;\nlet LeadTime = $context.$nodes.CHECK_SUBSTITUTES_FOR_ITEMS_IN_WORK_ORDER.LEAD_TIME.$output?.items?.[0]?.FixedLeadTime ?? null;\n\nretValue = {WorkOrderNumber,WorkOrderId,WorkOrderType,WorkOrderSubType,OrganizationId,WorkOrderDescription,AssetNumber,RequiredDate,OperationSequenceNumber,WoOperationId,OperationName,OperationDescription,WoOperationMaterialId,MaterialSequenceNumber,ItemNumber,InventoryItemId,ItemDescription,UOM,RequiredQuantity,OpenQuantity,ShortageQuantity,SubstituteItem,OrgsWithStock,LeadTime};\n\nreturn retValue;"
                  },
