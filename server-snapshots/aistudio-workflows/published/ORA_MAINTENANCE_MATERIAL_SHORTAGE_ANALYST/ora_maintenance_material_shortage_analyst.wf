        {
          "metadata": {
            "name": "Extract Context",
            "returnType": "object",
            "sourceCode": "const appContext =\n  $context?.$app?.$OraAppContext ??\n  $context?.$triggers?.REST?.$input?.OraAppContext ??\n  null;\n\nlet OrganizationId = null;\nlet WorkOrderNumber = null;\n\nif (appContext != null) {\n  if (typeof appContext === 'object') {\n    OrganizationId = appContext?.OrganizationId ?? null;\n    WorkOrderNumber = appContext?.WorkOrderNumber ?? null;\n  } else if (typeof appContext === 'number') {\n    OrganizationId = String(appContext);\n  } else if (typeof appContext === 'string') {\n    const s = appContext.trim();\n    if (s) {\n      if (s.startsWith('{') || s.startsWith('[')) {\n        // JSON string\n        try {\n          const obj = JSON.parse(s);\n          OrganizationId = obj?.OrganizationId ?? null;\n          WorkOrderNumber = obj?.WorkOrderNumber ?? null;\n        } catch {\n          // Malformed JSON -> fall through to plain handling\n          const parts = s.split(',').map(p => p.trim());\n          OrganizationId = parts[0] || s || null;\n          WorkOrderNumber = parts[1] || null;\n        }\n      } else if (s.includes(',')) {\n        const parts = s.split(',').map(p => p.trim());\n        OrganizationId = parts[0] || null;\n        WorkOrderNumber = parts[1] || null;\n      } else {\n        // Plain single value -> treat as OrganizationId\n        OrganizationId = s;\n      }\n    }\n  } else {\n    const s = String(appContext).trim();\n    if (s) OrganizationId = s;\n  }\n}\n\nreturn { OrganizationId, WorkOrderNumber };"
          },
          "outcomes": {
            "success": "1771401821360"
          },
          "code": "EXTRACT_CONTEXT",
