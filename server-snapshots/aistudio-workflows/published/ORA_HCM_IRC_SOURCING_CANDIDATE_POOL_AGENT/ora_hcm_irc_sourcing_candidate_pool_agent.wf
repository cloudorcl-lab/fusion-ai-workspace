          "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"CandidatePoolDetails\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"PoolId\": { \"type\": \"integer\" },\n    \"PoolName\": { \"type\": \"string\" },\n    \"PoolTypeCode\": { \"type\": \"string\" },\n    \"Status\": { \"type\": \"string\" },\n    \"OwnerEditFlag\": { \"type\": [\"string\", \"null\"] },\n    \"CreationDate\": { \"type\": \"string\", \"format\": \"date-time\" },\n    \"ObjectTypeCode\": { \"type\": [\"string\", \"null\"] },\n    \"Description\": { \"type\": [\"string\", \"null\"] },\n    \"CreatedBy\": { \"type\": \"string\" },\n    \"CandidateOptedForMarketingEmails\": { \"type\": \"integer\" },\n    \"TotalCandidates\": { \"type\": \"integer\" },\n    \"IsLoggedInUserCreatorFlag\": { \"type\": \"boolean\" },\n    \"Owners\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"PoolId\": { \"type\": \"integer\" },\n          \"PoolOwnerId\": { \"type\": \"integer\" },\n          \"OwnerPersonId\": { \"type\": \"integer\" },\n          \"OwnerDisplayName\": { \"type\": \"string\" },\n          \"OwnerAssignmentName\": { \"type\": \"string\" },\n          \"EnterpriseId\": { \"type\": \"integer\" }\n        }\n      }\n    },\n    \"PoolRules\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"RuleId\": { \"type\": \"integer\" },\n          \"PoolId\": { \"type\": \"integer\" },\n          \"Criteria\": { \"type\": \"string\" },\n          \"RuleModifiedFlag\": { \"type\": [\"string\", \"null\"] }\n        }\n      }\n    }\n  }\n}",
