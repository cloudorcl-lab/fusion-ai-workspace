            {
              "id": "1767987330313_6",
              "name": "includeResults",
              "type": "string",
              "value": "true"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"CandidateSavedSearchResponse\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"summary\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"totalCount\": { \"type\": \"integer\" }\n      }\n    },\n    \"filters\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": { \"type\": \"string\" },\n          \"values\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"displayValue\": { \"type\": \"string\" },\n                \"value\": { \"type\": \"string\" },\n                \"count\": { \"type\": \"integer\" }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"results\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"PersonId\": { \"type\": \"integer\" },\n          \"CandidateNumber\": { \"type\": \"string\" }\n        }\n      }\n    },\n    \"savedSearchInfo\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"savedSearchId\": { \"type\": \"integer\" },\n        \"savedSearchToken\": { \"type\": \"string\" }\n      }\n    }\n  }\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Required field validation check",
            "returnType": "boolean",
            "sourceCode": "const input = $context.$triggers.REST.$input.oraRecruitingCandidatePoolInput;\n\nlet isValid = \n    // Top-level required\n    input &&\n    'basicInfo' in input &&\n    'owners' in input &&\n    'audience' in input &&\n    'businessObject' in input &&\n\n    // basicInfo.type required\n    input.basicInfo && 'type' in input.basicInfo &&\n\n    // owners: array, at least 1, and each has PersonId & AssignmentId\n    Array.isArray(input.owners) &&\n    input.owners.length > 0 &&\n    input.owners.every(owner => owner && 'PersonId' in owner && 'AssignmentId' in owner) &&\n\n    // audience.candidateSearchCriteria required\n    input.audience && 'candidateSearchCriteria' in input.audience &&\n\n    // candidates (if present): each has PersonId and CandidateNumber\n    (\n      !Array.isArray(input.audience.candidates) ||\n      input.audience.candidates.every(cand => cand && 'PersonId' in cand && 'CandidateNumber' in cand)\n    ) &&\n\n    // businessObject.boNumber & businessObject.boContext required\n    input.businessObject && 'boNumber' in input.businessObject && 'boContext' in input.businessObject;\n\nreturn isValid;"
          },
          "outcomes": {
            "success": "1767014412836"
          },
          "code": "REQUIRED_FIELD_VALIDATION_CHECK",
          "id": "1767857549045",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
