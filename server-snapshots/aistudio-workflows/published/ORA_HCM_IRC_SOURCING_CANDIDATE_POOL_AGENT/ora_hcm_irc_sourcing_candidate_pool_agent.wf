            "name": "GetStandardPoolOwnerEmail",
            "returnType": "string",
            "sourceCode": "// Input array\nconst input = $context.$nodes.GET_STANDARD_POOL_SOURCER_EMAIL.$output ;\n\n// Extract unique emails\nconst uniqueEmails = [\n  ...new Set(\n    input\n      .map(str => JSON.parse(str).result)  // parse & extract email\n      .filter(email => !!email)            // ignore null/empty\n  )\n];\n\n// Convert to comma-separated string\nconst emailList = uniqueEmails.join(\",\");\n\nreturn emailList;"
          },
          "outcomes": {
            "success": "1767089359454"
          },
