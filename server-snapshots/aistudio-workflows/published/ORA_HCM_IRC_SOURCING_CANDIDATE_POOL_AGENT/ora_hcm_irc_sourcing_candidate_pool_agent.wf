              "name": "prompt",
              "type": "string",
              "value": "Generate a candidate saved search name using the information below:\n\nSearch Criteria: {{$context.$triggers.REST.$input.oraRecruitingCandidatePoolInput.audience.candidateSearchCriteria}} \n\nFollow these rules:\n\t1.\tPrefix the name with {agent}.\n\t2.\tAppend the current timestamp at the end.\n\t3.\tEnsure the final name does not exceed 50 characters."
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"name\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
