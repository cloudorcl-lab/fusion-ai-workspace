        {
          "metadata": {
            "name": "extract standard Candidates",
            "returnType": "object",
            "sourceCode": "// Results array from the Invoke Candidate Saved Search node\n\nconst results =  $context.$nodes.INVOKE_CANDIDATE_SAVED_SEARCH.$output.results || [];\n\n// Track uniqueness\nconst uniq = new Set();\nconst candidates = [];\n\nresults.forEach(item => {\n    if (!item) return;\n\n    const pid = String(item.PersonId || \"\");\n    const cnum = String(item.CandidateNumber || \"\");\n\n    if (!pid || !cnum) return;\n\n    // Unique key by PersonId\n    if (uniq.has(pid)) return;\n\n    uniq.add(pid);\n\n    candidates.push({\n        PersonId: pid,\n        CandidateNumber: cnum\n    });\n});\n\n// Return clean array of candidates\nreturn candidates;"
          },
          "outcomes": {
            "success": "1767087678675"
          },
          "code": "EXTRACT_STANDARD_CANDIDATES",
          "id": "1767087462570",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
