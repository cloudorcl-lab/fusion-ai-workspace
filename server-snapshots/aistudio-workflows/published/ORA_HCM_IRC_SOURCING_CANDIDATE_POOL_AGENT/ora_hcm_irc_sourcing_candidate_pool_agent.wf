        {
          "metadata": {
            "name": "Prepare pool owners",
            "returnType": "object",
            "sourceCode": "let owners = $context.$triggers.REST.$input.oraRecruitingCandidatePoolInput.owners;\nconst loggedInPersonId = $context.$nodes.GET_USER_DETAILS.$output.items[0].PersonId;\n\n// Step 1: Convert to desired output format\nlet poolOwners = owners.map(owner => ({\n  OwnerPersonId: owner.PersonId\n}));\n\n// Step 2: Check if logged-in user is already an owner\nconst isLoggedInUserPresent = poolOwners.some(\n  owner => owner.OwnerPersonId === loggedInPersonId\n);\n\n// Step 3: If not present, add the logged-in user\nif (!isLoggedInUserPresent) {\n   poolOwners.push({\n    OwnerPersonId: loggedInPersonId\n  });\n}\n\nreturn poolOwners;"
          },
          "outcomes": {
            "success": "1767019624054"
          },
          "code": "PREPARE_POOL_OWNERS",
          "id": "1768298718625",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Prepare saved search criteria",
            "returnType": "string",
            "sourceCode": "let savedSearchId = $context.$nodes.CREATE_SAVED_SEARCH.$output.savedSearchInfo.SavedSearchId;\n\nlet criteriaObj = {\n  filters: [\n    {\n      operator: \"ORA_IS\",\n      name: \"ORA_SAVED_SEARCH\",\n      orderSequence: 1,\n      terms: [\n        {\n          id: savedSearchId,\n          value: savedSearchId\n        }\n      ]\n    }\n  ]\n};\n\nlet criteria = JSON.stringify(criteriaObj);\nreturn  criteria;"
          },
          "outcomes": {
            "success": "1767028779032"
          },
          "code": "PREPARE_SAVED_SEARCH_CRITERIA",
          "id": "1768316169795",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Pepare Deep Link",
            "returnType": "string",
            "sourceCode": "const data = $context.$nodes.GET_USER_DETAILS.$output.links[0].href;\nconst matches = data.match(/^(https?:\\/\\/[^\\/:]+(?:\\.[^\\/:]+)*)(?::\\d+)?/);\nconst baseURL = matches ? matches[1] : null;\nconst candpoolURL = \"/fscmUI/redwood/recruiting-sourcing/sourcing/landing?selectedTab=candidatePools\";\nreturn baseURL + candpoolURL;"
          },
          "outcomes": {
            "success": "1767015383846"
          },
          "code": "PEPARE_DEEP_LINK",
          "id": "1769184194945",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
      ],
