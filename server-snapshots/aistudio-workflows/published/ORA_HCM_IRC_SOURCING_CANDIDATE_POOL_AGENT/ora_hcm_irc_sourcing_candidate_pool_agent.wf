          "metadata": {
            "name": "extract pool details",
            "returnType": "object",
            "sourceCode": "let poolName = $context.$triggers.REST.$input.oraRecruitingCandidatePoolInput.basicInfo.name;\nlet poolDescription = $context.$triggers.REST.$input.oraRecruitingCandidatePoolInput.basicInfo.description;\nlet poolDetails = [];\n\nif (poolName == null) {\n    poolName = $context.$triggers.REST.$input.oraRecruitingCandidatePoolInput.businessObject.boName + \" \" + $context.$triggers.REST.$input.oraRecruitingCandidatePoolInput.businessObject.boNumber + \" - Sourcing Pool\";\n}\nif (poolDescription == null) {\n    poolDescription =$context.$triggers.REST.$input.oraRecruitingCandidatePoolInput. audience.candidateSearchCriteria; \n}\n\npoolDetails.push({\n    name: poolName,\n    description: poolDescription\n});\n\nreturn poolDetails;"
          },
          "outcomes": {
            "success": "1769184194945"
          },
          "code": "EXTRACT_POOL_DETAILS",
          "id": "1767019624054",
          "inputs": [],
