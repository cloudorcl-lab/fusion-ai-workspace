        {
          "metadata": {
            "name": "Return Workflow Result",
            "returnType": "object",
            "sourceCode": "let isSuccess = $context.$variables.PoolId  != null &&  $context.$variables.PoolId > 0;\n\nlet result = {\n status: isSuccess ? \"SUCCESS\" : \"FAILURE\",\n statusCode: isSuccess ? \"POOL_CAMPAIGN_SUCCESS\" :  \"POOL_CAMPAIGN_FAILURE\",\n statusMessage: isSuccess? \"Candidate pool processed and campaign triggered successfully\" : \"Candidate pool processing failed\",\n poolId: $context.$variables.PoolId,\n poolName: $context.$nodes.EXTRACT_POOL_DETAILS.$output.result[0]?.name\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "end"
          },
