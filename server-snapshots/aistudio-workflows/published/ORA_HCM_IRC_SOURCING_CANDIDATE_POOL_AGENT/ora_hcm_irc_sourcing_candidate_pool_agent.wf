        {
          "metadata": {
            "name": "extractWorkEmailAddressForTeam",
            "returnType": "string",
            "sourceCode": "// Input array\nconst input = $context.$nodes.GET_POOL_OWNERS_EMAIL.$output \n// Extract unique emails\nconst uniqueEmails = [\n  ...new Set(\n    input\n      .map(str => JSON.parse(str).result)  // parse & extract email\n      .filter(email => !!email)            // ignore null/empty\n  )\n];\n\n// Convert to comma-separated string\nconst emailList = uniqueEmails.join(\",\");\n\nreturn emailList;"
          },
          "outcomes": {
            "success": "1767031236047"
          },
          "code": "EXTRACT_WORK_EMAIL_ADDRESS_FOR_TEAM",
          "id": "1767030993324",
          "inputs": [],
