            "name": "oraRecruitingCandidatePoolInput",
            "type": "object",
            "typeSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"basicInfo\": {\n      \"type\": \"object\",\n      \"required\": [\"name\", \"type\"],\n      \"properties\": {\n        \"poolId\": {\n          \"type\": \"string\"\n        },\n        \"name\": {\n          \"type\": \"string\"\n        },\n        \"description\": {\n          \"type\": \"string\"\n        },\n        \"type\": {\n          \"type\": \"string\",\n          \"enum\": [\"STANDARD\", \"RULE_BASED\"]\n        }\n      },\n      \"additionalProperties\": false\n    },\n    \"owners\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"PersonId\", \"AssignmentId\"],\n        \"properties\": {\n          \"PersonId\": {\n            \"type\": \"string\"\n          },\n          \"AssignmentId\": {\n            \"type\": \"string\"\n          },\n          \"MemberTypeCode\": {\n            \"type\": \"string\"\n          }\n        },\n        \"additionalProperties\": false\n      }\n    },\n    \"audience\": {\n      \"type\": \"object\",\n      \"required\": [\"candidateSearchCriteria\"],\n      \"properties\": {\n        \"candidateCount\": {\n          \"type\": \"integer\",\n          \"minimum\": 0\n        },\n        \"candidateSearchCriteria\": {\n          \"type\": \"object\",\n          \"additionalProperties\": true\n        },\n        \"candidates\": {  \n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"required\": [\"PersonId\", \"CandidateNumber\"], \n            \"properties\": {\n              \"PersonId\": {\n                \"type\": \"string\"\n              },\n              \"CandidateNumber\": { \n                \"type\": \"string\"\n              }\n            },\n            \"additionalProperties\": false\n          }\n        }\n      },\n      \"additionalProperties\": false\n    },\n    \"businessObject\": {\n      \"type\": \"object\",\n      \"required\": [\"boNumber\", \"boContext\"],\n      \"properties\": {\n        \"boNumber\": {\n          \"type\": \"string\"\n        },\n        \"boContext\": {\n          \"type\": \"string\"\n        },\n        \"boName\": {\n          \"type\": \"string\"\n        },\n        \"boDescription\": {\n          \"type\": \"string\"\n        }\n      },\n      \"additionalProperties\": false\n    },\n    \"messageContent\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"isSourcerNotification\": {\n          \"type\": \"boolean\"\n        },\n        \"subject\": {\n          \"type\": \"string\"\n        },\n        \"body\": {\n          \"type\": \"string\"\n        },\n        \"mode\": {\n          \"type\": \"string\",\n          \"enum\": [\"EMAIL\"]\n        }\n      },\n      \"additionalProperties\": false\n    }\n  },\n  \"required\": [\"basicInfo\", \"owners\", \"audience\", \"businessObject\"],\n  \"additionalProperties\": false\n}"
          }
        ]
      }
