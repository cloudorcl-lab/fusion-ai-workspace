                {
                  "metadata": {
                    "name": "PrepareStandardPoolMembersEmail",
                    "returnType": "string",
                    "sourceCode": "const workEmail = $context.$nodes.GET_STANDARD_POOL_SOURCER_EMAIL.STANDARD_POOL_WORKER_EMAIL.$output.WorkEmail \n\nlet emails = ( $context.$variables.emailOfPoolOwners || \"\")\n  .split(\",\")\n  .map(e => e.trim())\n  .filter(e => e.length > 0);\n\nif (workEmail && !emails.includes(workEmail)) {\n  emails.push(workEmail);\n}\n\nreturn emails.join(\",\");"
                  },
                  "outcomes": {
                    "success": "end_1767089074114"
                  },
                  "code": "PREPARE_STANDARD_POOL_MEMBERS_EMAIL",
                  "id": "1767089198793",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
