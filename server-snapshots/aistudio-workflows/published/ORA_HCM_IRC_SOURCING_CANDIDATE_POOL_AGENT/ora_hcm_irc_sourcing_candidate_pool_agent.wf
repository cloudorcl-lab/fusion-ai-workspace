                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "preparePoolTeamWorkEmails",
                    "returnType": "string",
                    "sourceCode": "const workEmail = $context.$nodes.GET_POOL_OWNERS_EMAIL.GET_WORKER_EMAIL_ADDRESS.$output.WorkEmail \nlet emails = ( $context.$variables.emailOfPoolOwners || \"\")\n  .split(\",\")\n  .map(e => e.trim())\n  .filter(e => e.length > 0);\n\nif (workEmail && !emails.includes(workEmail)) {\n  emails.push(workEmail);\n}\n\nreturn emails.join(\",\");"
                  },
                  "outcomes": {
                    "success": "end_1767030376715"
                  },
                  "code": "PREPARE_POOL_TEAM_WORK_EMAILS",
                  "id": "1767030634487",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                }
