        {
          "metadata": {
            "name": "retrieve org context",
            "returnType": "object",
            "sourceCode": "const appCtx = $context && $context.$app ? $context.$app.$OraAppContext : null;\n\n// appCtx might already be a JSON string, or it might be an object/proxy.\n// Normalize to a plain object:\nlet plain = {};\nif (typeof appCtx === 'string') {\n  try {\n    plain = JSON.parse(appCtx) || {};\n  } catch (e) {\n    plain = {};\n  }\n} else {\n  plain = JSON.parse(JSON.stringify(appCtx || {}));\n}\n\nconst orgCode = plain.OrganizationCode || null;\nconst orgName = plain.OrganizationName || null;\n\nreturn {\n  OrganizationCode: orgCode,\n  OrganizationName: orgName\n};"
          },
          "outcomes": {
            "success": "1775035725828"
          },
          "code": "RETRIEVE_ORG_CONTEXT",
          "id": "1775035647059",
