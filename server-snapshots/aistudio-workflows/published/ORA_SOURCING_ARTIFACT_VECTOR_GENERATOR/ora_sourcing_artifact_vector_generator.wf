                  },
                  "code": "FETCH_SUPPLIERS",
                  "id": "1767121540501",
                  "inputs": [
                    {
                      "id": "1767121561971_1",
                      "name": "limit",
                      "type": "string",
                      "value": "500"
                    },
                    {
                      "id": "1767121561972_2",
                      "name": "offset",
                      "type": "string",
                      "value": "{{500 * $context.$nodes.KEEP_FETCHING_SUPPLIERS_IN_LOOP.$currentItemIndex}}"
                    },
                    {
                      "id": "1767121561973_3",
                      "name": "fields",
                      "type": "string",
                      "value": "SupplierId,ParentSupplier,SupplierPartyId,Supplier,SupplierNumber,DUNSNumber,AlternateName;businessClassifications:Classification;"
                    },
                    {
                      "id": "1767121561974_4",
                      "name": "expand",
                      "type": "string",
                      "value": "businessClassifications"
                    }
                  ],
                  "outputSpecification": "{}",
