                {
                  "metadata": {
                    "name": "Parse Suppliers",
                    "returnType": "array",
                    "sourceCode": "let suppliersList = [];\n$context.$nodes.KEEP_FETCHING_SUPPLIERS_IN_LOOP.FETCH_SUPPLIERS.$output.items.forEach((currentSupplier, index) => {\n        let businessClassifications = currentSupplier.businessClassifications.items.map(item => item.Classification).join(\" : \");\n        let concatText = currentSupplier.Supplier;\n        if(currentSupplier.AlternateName != null) concatText += \" : \" + currentSupplier.AlternateName;\n        if(businessClassifications != null && businessClassifications.length > 0) concatText += \" : \" +businessClassifications;\n        if(currentSupplier.ParentSupplier != null) concatText += \" : \" + currentSupplier.ParentSupplier;\n        if(currentSupplier.SupplierNumber != null) concatText += \" : \" + currentSupplier.SupplierNumber;\n        if(currentSupplier.DUNSNumber != null) concatText += \" : \" + currentSupplier.DUNSNumber;\n\n\tsuppliersList.push(\n\t\t{\n                        \"SupplierId\": currentSupplier.SupplierId,\n                        \"SupplierPartyId\": currentSupplier.SupplierPartyId,\n                        \"ParentSupplier\": currentSupplier.ParentSupplier,\n\t\t\t\"Supplier\": currentSupplier.Supplier,\n\t\t\t\"SupplierNumber\":currentSupplier.SupplierNumber,\n\t\t\t\"DUNSNumber\": currentSupplier.DUNSNumber,\n\t\t\t\"AlternateName\": currentSupplier.AlternateName,\n                        \"BusinessClassifications\":  businessClassifications,\n                        \"concatedText\": concatText\n\t\t}\n\t);\n});\nreturn suppliersList;"
                  },
                  "outcomes": {
                    "success": "end_1767121514536"
                  },
                  "code": "PARSE_SUPPLIERS",
                  "id": "1767121717615",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                }
              ],
