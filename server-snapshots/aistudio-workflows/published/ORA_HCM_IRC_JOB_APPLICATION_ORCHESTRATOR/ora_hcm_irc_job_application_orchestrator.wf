{
  "workflowId": "300000326918426",
  "workflowCode": "ORA_HCM_IRC_JOB_APPLICATION_ORCHESTRATOR",
  "name": "Job Application Advisor Orchestrator",
  "description": "Manages the job application advisor and its actions. It's designed for the hiring manager workspace.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
