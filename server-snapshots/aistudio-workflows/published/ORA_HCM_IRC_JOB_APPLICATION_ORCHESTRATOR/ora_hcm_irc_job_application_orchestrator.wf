            "InitCommunications": "1765226050287"
          },
          "code": "SWITCH_FOR_ORAMESSAGEHINT",
          "convergenceTargetId": "end",
          "id": "1765224461108",
          "inputs": [
            {
              "id": "1765224461111_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.OraMessageHint}}"
            }
          ],
