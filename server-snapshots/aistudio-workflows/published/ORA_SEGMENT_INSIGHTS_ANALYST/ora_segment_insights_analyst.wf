          "id": "1771269706302",
          "inputs": [
            {
              "id": "1771269706303_1",
              "name": "prompt",
              "type": "string",
              "value": "SourceSegment: {{$context.$nodes.SOURCE_SEGMENT_DATA.$output}}\nTargetSegment: {{$context.$nodes.TARGET_SEGMENT_DETAILS.$output}}\nUserSegmentName: {{$context.$nodes.COMPARISON_ANALYSER.$output.SourceSegment}} \n \nParse TargetSegment and if `items` is empty  then set validate=FALSE  and isTargetSegmentExist=FALSE\nParse TargetSegment data and get items[0].name as TargetSegmentName , get items[0].baseObject as TargetSegmentBaseObject and append msid_ to items[0].id and store as TargetSegmentID\nParse SourceSegment data and get items[0].name as SourceSegmentName , get items[0].baseObject as SourceSegmentBaseObject and append msid_ to items[0].id and store as SourceSegmentID\nParse SourceSegment data and get items[0].materializedFlag as SourceSegmentMaterialized\nParse TargetSegment data and get items[0].materializedFlag as TargetSegmentMaterialized, \n\n\nIf TargetSegmentBaseObject and SourceSegmentBaseObject matches (ignore case) then set validate=TRUE , if it does not match then set validate=FALSE and baseObjectDifferent=TRUE\nIf SourceSegmentMaterialized doesn't matches TargetSegmentMaterialized  set validate=FALSE and targetSegmentNotMaterialized=TRUE\n\nIf UserSegmentName and SourceSegmentName matches (ignore case) then set validate=TRUE , if it does not match then set validate=FALSE and sourceSegmentNameMismatch=TRUE"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"targetSegmentNotMaterialized\": {\n            \"type\": \"string\"\n        },\n        \"sourceSegmentNameMismatch\": {\n            \"type\": \"string\"\n        },\n        \"baseObjectDifferent\": {\n            \"type\": \"string\"\n        },\n        \"isTargetSegmentExist\": {\n            \"type\": \"string\"\n        },\n        \"SourceSegmentID\": {\n            \"type\": \"string\"\n        },\n        \"TargetSegmentID\": {\n            \"type\": \"string\"\n        },\n        \"validate\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
