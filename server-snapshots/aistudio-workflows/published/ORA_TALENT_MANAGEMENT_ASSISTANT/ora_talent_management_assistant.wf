              "name": "prompt",
              "type": "string",
              "value": "Look for selected employee from {{$context.$system.$inputMessage}} in {{$context.$variables.employeeSearchResults}} by comparing DisplayName or Assignment Number or Person Number only and set the corresponding employee's PersonId and AssignmentId into multipleMatchSelectedPersonId and multipleMatchSelectedAssignmentId variables and set employeeFoundInSearchResults variable to true. If not found do not set any value into multipleMatchSelectedPersonId and multipleMatchSelectedAssignmentId. Set employeeFoundInSearchResults variable to false.\n\nDO NOT compare with ManagerName or ManagerDisplayName. Employee and manager are different. Here we are trying to find matching employee record only."
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"employeeFoundInSearchResults\": {\n            \"type\": \"boolean\"\n        },\n        \"multipleMatchSelectedAssignmentId\": {\n            \"type\": \"number\"\n        },\n        \"multipleMatchSelectedPersonId\": {\n            \"type\": \"number\"\n        }\n    }\n}",
