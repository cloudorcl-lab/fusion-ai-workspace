                            "name": "RetrieveAnswer",
                            "toolCode": "ORA_RECRUITING_KNOWLEDGE_FACTORY"
                          },
                          "outcomes": {
                            "success": "1767926073532"
                          },
                          "code": "RETRIEVE_ANSWER",
                          "id": "1767925958204",
                          "inputs": [
                            {
                              "id": "1767925958207_1",
                              "name": "question",
                              "type": "string",
                              "value": "{{$context.$nodes.PROCESS_EACH_BATCH.PROCESS_EACH_MESSAGE.QUERY_EXTRACTION.$output.CommaSeparatedInquiries}}"
                            }
                          ],
                          "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"AnswerWithCitations\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"value\": {\n      \"type\": \"string\",\n      \"description\": \"The answer text.\"\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"description\": \"List of citations relevant to the answer.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"citedText\": {\n            \"type\": \"string\",\n            \"description\": \"The cited text.\"\n          }\n        },\n        \"required\": [\n          \"citedText\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"value\",\n    \"citations\"\n  ],\n  \"additionalProperties\": false\n}",
                          "type": "RAG_DOCUMENT_TOOL"
                        },
                        {
                          "metadata": {
                            "name": "ConsolidateQueryResponses"
                          },
                          "outcomes": {
                            "success": "1767926262166"
                          },
                          "code": "CONSOLIDATE_QUERY_RESPONSES",
                          "id": "1767926073532",
                          "inputs": [
                            {
                              "id": "1767926073534_1",
                              "name": "prompt",
                              "type": "string",
                              "value": "You are an AI assistant designed to consolidate questions and answers into a structured JSON response.\n \nInputs:\nQuestions: {{$context.$nodes.PROCESS_EACH_BATCH.PROCESS_EACH_MESSAGE.QUERY_EXTRACTION.$output.CommaSeparatedInquiries}}\nAnswers: {{$context.$nodes.PROCESS_EACH_BATCH.PROCESS_EACH_MESSAGE.RETRIEVE_ANSWER.$output.value}} \n\n1. List out all questions that were being asked.\n2. If no exact, document-grounded answer is found, return \"NO_ANSWER_AVAILABLE\".\n3. If an answer contains information not found from the documents, return the string \"NO_ANSWER_AVAILABLE\" in the answer field.\n4. If the answer includes unsupported inference, outside knowledge, speculation, or hypothetical content, return \"NO_ANSWER_AVAILABLE\".\n5. Set UnansweredInquiries with the list of all unanswered questions.\n6. After processing all questions, set the top-level ResponseCode:\n   i.  \"SUCCESS\" if all questions have valid answers\n   ii. \"FAILURE\" if at least one question has \"NO_ANSWER_AVAILABLE\"\n\nConsolidate all the questions and answers as a list of question and answer pairs in the following format.\n {\n  \"ResponseCode\": \"\",\n  \"QnAPairs\": [\n    {\n      \"question\": \"\",\n      \"answer\": \"\"\n    }\n  ],\n  \"UnansweredInquiries\": [\"\"]\n}\n\n\nExample Outputs:\n1. SUCCESS \n{\n  \"ResponseCode\": \"SUCCESS\",\n  \"QnAPairs\": [\n    {\n      \"question\": \"What is the company’s refund policy?\",\n      \"answer\": \"You can request a refund within 30 days of purchase by contacting support.\"\n    },\n    {\n      \"question\": \"How do I reset my password?\",\n      \"answer\": \"Go to the login page and click 'Forgot Password' to reset your password.\"\n    }\n  ],\n  \"UnansweredInquiries\": []\n}\n\n2. FAILURE \n{\n  \"ResponseCode\": \"FAILURE\",\n  \"QnAPairs\": [\n    {\n      \"question\": \"Does your company have unlimited leave policy?\",\n      \"answer\": \"NO_ANSWER_AVAILABLE.\"\n    },\n    {\n      \"question\": \"How do I reset my password?\",\n      \"answer\": \"Go to the login page and click 'Forgot Password' to reset your password.\"\n    }\n  ],\n  \"UnansweredInquiries\": [\"Does your company have unlimited leave policy?\"]\n}"
                            }
                          ],
                          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"ResponseCode\": {\n      \"type\": \"string\"\n    },\n    \"QnAPairs\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"question\": { \"type\": \"string\" },\n          \"answer\": { \"type\": \"string\" }\n        }\n      }\n    },\n    \"UnansweredInquiries\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" }\n    }\n  }\n}",
                          "type": "LLM"
                        },
