                        {
                          "metadata": {
                            "name": "CheckForEmailAgentAutoSkipTimeout",
                            "returnType": "boolean",
                            "sourceCode": "const creationDate = $context.$nodes.PROCESS_EACH_BATCH.PROCESS_EACH_MESSAGE.$currentItem.CreationDate; \nconst profileValue = $context.$nodes.PROCESS_EACH_BATCH.PROCESS_EACH_MESSAGE.$currentItem.AgentAutoSkipTimeoutMins;\n\nlet result = false;\n\nif (creationDate && profileValue) {\n    const maxAllowedDurationPO = parseFloat(profileValue);\n    if (!isNaN(maxAllowedDurationPO) && maxAllowedDurationPO > 0) {\n        const creationTime = new Date(creationDate).getTime();\n        const currentTime = Date.now();\n        const diffMin = (currentTime - creationTime) / (1000 * 60);\n        result = diffMin > maxAllowedDurationPO;\n    }\n}\n\nreturn result;"
                          },
                          "outcomes": {
                            "success": "1762819986777"
                          },
                          "code": "CHECK_FOR_EMAIL_AGENT_AUTO_SKIP_TIMEOUT",
                          "id": "1762819311920",
                          "inputs": [],
                          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                          "type": "CODE",
                          "convergenceTargetId": "1775745257720"
                        },
