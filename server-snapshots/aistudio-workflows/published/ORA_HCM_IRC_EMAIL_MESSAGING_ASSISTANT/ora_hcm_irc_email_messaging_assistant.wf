          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"CandMsgLogId\": {\n            \"type\": \"string\"\n          },\n          \"MessageBody\": {\n            \"type\": \"string\"\n          },\n          \"ReferenceId\": {\n            \"type\": \"string\"\n          },\n          \"CreationDate\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "BatchAndParseEmailData",
            "returnType": "array",
            "sourceCode": "const items = $context.$nodes.GET_EMAIL_MESSAGES_FOR_AGENT_PROCESSING.$output?.items ?? [];\nconst batchSize = 5;\n\nconst transformed = items.map(item => {\n    let messageBody = \"\";\n    let autoSkipTimeOutMins = 15;\n    let candidatePersonId = null;\n    let interactionId = null;\n    let outreachId = null;\n    let isOutreachEmail = false;\n    let isOutreachOnlyEmail = false;\n    let isAgentResponseEligible = false;\n\n    try {\n      const parsedBody = JSON.parse(item.MessageBody ?? \"{}\");\n      messageBody = parsedBody.bodyPlainText ?? \"\";\n      autoSkipTimeOutMins = parseInt(parsedBody.agentAutoSkipTimeoutMins ?? 15);\n      candidatePersonId = parsedBody.senderPerson?.personId ?? null;\n      interactionId = parsedBody.interactionId ?? null;\n      outreachId = parsedBody.outreachId ?? null;\n      isAgentResponseEligible = parsedBody.isAgentResponseEligible ?? false;\n      \n    } catch (e) {\n      messageBody = \"\";\n      autoSkipTimeOutMins = 15;\n      candidatePersonId = null;\n      interactionId = null;\n      outreachId = null;\n      isAgentResponseEligible = false;\n    }\n\n    isOutreachEmail = outreachId !== null && outreachId !== undefined;\n    isOutreachOnlyEmail = isOutreachEmail && !isAgentResponseEligible;\n\n    return {\n      CandMsgLogId: item.CandMsgLogId ?? \"\",\n      CandEmailMsgId: item.ReferenceId ?? \"\",\n      MessageBody: messageBody,\n      CreationDate: item.CreationDate ?? \"\",\n      AgentAutoSkipTimeoutMins: autoSkipTimeOutMins,\n      CandidatePersonId: candidatePersonId,\n      InteractionId: interactionId,\n      OutreachId: outreachId,\n      IsOutreachEmail: isOutreachEmail,\n      IsOutreachOnlyEmail: isOutreachOnlyEmail \n    };\n  });\n\nconst batches = [];\nfor (let i = 0; i < transformed.length; i += batchSize) {\n    batches.push(transformed.slice(i, i + batchSize));\n}\n\nreturn batches;"
          },
          "outcomes": {
            "success": "1780017255816"
          },
          "code": "BATCH_AND_PARSE_EMAIL_DATA",
          "convergenceTargetId": "1762818662556",
          "id": "1762818891597",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
