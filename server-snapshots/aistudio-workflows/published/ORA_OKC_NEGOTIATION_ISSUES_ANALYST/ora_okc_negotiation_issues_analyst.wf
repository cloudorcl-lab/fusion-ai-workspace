            "sourceCode": "const action = (($context.$nodes.PARSE_ACTION_CONTEXT.$output || {}).result) || {};\n\nfunction compact(value) {\n  return String(value || '').trim();\n}\n\nconst contractId = compact(action.contractId || action.ContractId);\nconst deviatingClauseId = compact(action.deviatingClauseId || action.deviationClauseId || action.DeviatingClauseId);\nconst proposedClauseText = compact(\n  action.proposedClauseText ||\n  action.ProposedClauseText ||\n  action.newValue ||\n  action.value\n);\n\nconst batchPayload = [];\n\nif (contractId && deviatingClauseId && proposedClauseText) {\n  const clausePath =\n    '/contracts/' + encodeURIComponent(contractId) +\n    '/child/ContractDeviatingClauses/' + encodeURIComponent(deviatingClauseId);\n\n  batchPayload.push({\n    id: 'updateClauseProposedText',\n    path: clausePath,\n    operation: 'upsert',\n    payload: {\n      ProposedClauseText: proposedClauseText\n    }\n  });\n\n  const clauseFields = 'Id,ClauseTitle,OriginalClauseText,ProposedClauseText,Status';\n  batchPayload.push({\n    id: 'fetchClauseAfterEditLanguage',\n    path: clausePath + '?onlyData=true&fields=' + encodeURIComponent(clauseFields),\n    operation: 'get'\n  });\n}\n\nconst ready = batchPayload.length > 0;\r\n\r\nconst result = {\n  status: ready ? 'ready' : 'skipped',\n  action: 'SaveEditedClauseLanguage',\n  contractId,\n  deviatingClauseId,\n  proposedClauseText,\n  batchPayload,\n  updateCount: batchPayload.length,\n  note: ready\n    ? 'Prepared edit language clause update payload.'\n    : 'Missing contractId, deviatingClauseId, or proposed clause text.'\n};\r\n\r\nreturn result;"
