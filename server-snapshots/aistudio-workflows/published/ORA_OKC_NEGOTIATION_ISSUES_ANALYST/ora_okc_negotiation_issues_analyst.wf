        {
          "metadata": {
            "name": "Prepare Contract Deviations Batch Payload",
            "returnType": "array",
            "sourceCode": "const ctx = ($context.$nodes.PARSE_APP_CONTEXT.$output || {}).result || {};\nconst contractId = String(ctx.contractId || '').trim();\nconst contractNumber = String(ctx.contractNumber || '').trim();\n\nconst messageHint = String(($context.$app || {}).$OraMessageHint || '').trim().toLowerCase();\nconst isInitSubtitle = messageHint === 'initsubtitle';\n\nconst dataModeParam = ['only', 'Data=true'].join('');\nconst subtitleFields = 'ContractId,BuyOrSell,PartyName,Assignee,TermsAuthoringPartyMeaning,ContractTermsSourceMeaning,ContractNumber,AssignedDate';\n\nif (!contractId) {\n  const emptyQuery = \"ContractNumber='__NO_CONTRACT_CONTEXT__'\";\n  const emptyPath =\n    '/contracts?' + dataModeParam + '&q=' +\n    encodeURIComponent(emptyQuery) +\n    '&fields=' +\n    encodeURIComponent(subtitleFields);\n\n  return [\n    {\n      id: 'contractHeaderById',\n      path: emptyPath,\n      operation: 'get'\n    }\n  ];\n}\n\nif (isInitSubtitle) {\n  const escapedContractId = contractId.replace(/'/g, \"''\");\n  const query = \"ContractId='\" + escapedContractId + \"'\";\n  const path =\n    '/contracts?' + dataModeParam + '&q=' +\n    encodeURIComponent(query) +\n    '&fields=' +\n    encodeURIComponent(subtitleFields);\n\n  return [\n    {\n      id: 'contractHeaderById',\n      path,\n      operation: 'get'\n    }\n  ];\n}\n\nconst clauseFields =\n  'DeviationSummary,StandardPositionSummary,Id,DnzChrId,MajorVersion,ClauseTitle,SeverityCode,Status;' +\n  'ContractPolicyDeviation:Id,DeviatingClauseId,IssueNumber,Issue,MatchedPositionCode,RuleDescription,SeverityCode,Status,ChangeRequestSummary';\nconst path =\n  '/contracts/' + encodeURIComponent(contractId) +\n  '/child/ContractDeviatingClauses?' + dataModeParam +\n  '&fields=' +\n  encodeURIComponent(clauseFields);\n\nreturn [\n  {\n    id: 'contractDeviatingClausesByContractId',\n    path,\n    operation: 'get'\n  }\n];"
          },
          "outcomes": {
            "success": "3"
          },
