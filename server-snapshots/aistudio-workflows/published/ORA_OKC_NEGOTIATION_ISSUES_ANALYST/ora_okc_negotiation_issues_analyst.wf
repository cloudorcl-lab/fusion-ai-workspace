        {
          "metadata": {
            "name": "Parse App Context",
            "returnType": "object",
            "sourceCode": "function compact(value) {\n  return String(value === null || value === undefined ? '' : value).trim();\n}\n\nfunction parseObjectIfJson(value) {\n  if (value && typeof value === 'object' && !Array.isArray(value)) {\n    return value;\n  }\n\n  if (typeof value !== 'string') {\n    return {};\n  }\n\n  const trimmed = value.trim();\n  if (!trimmed) {\n    return {};\n  }\n\n  const candidates = [trimmed];\n  const unescapedQuotes = trimmed.replace(/\\\\\"/g, '\"');\n  if (unescapedQuotes !== trimmed) {\n    candidates.push(unescapedQuotes);\n  }\n\n  for (let i = 0; i < candidates.length; i += 1) {\n    let current = candidates[i];\n\n    for (let depth = 0; depth < 3; depth += 1) {\n      try {\n        const parsed = JSON.parse(current);\n        if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {\n          return parsed;\n        }\n\n        if (typeof parsed === 'string' && parsed.trim()) {\n          current = parsed.trim();\n          continue;\n        }\n      } catch (e) {\n        break;\n      }\n\n      break;\n    }\n  }\n\n  return {};\n}\n\nfunction noContractRouteForMessageHint(messageHint) {\n  switch (messageHint) {\n    case 'Summary':\n      return 'SUMMARY_NO_CONTRACT_ID';\n    case 'InitDisplay':\n      return 'INIT_DISPLAY_NO_CONTRACT_ID';\n    case 'InitActions':\n      return 'INIT_ACTIONS_NO_CONTRACT_ID';\n    case 'Query':\n      return 'QUERY_NO_CONTRACT_ID';\n    case 'InitSubtitle':\n      return 'INIT_SUBTITLE_NO_CONTRACT_ID';\n    default:\n      return 'NO_CONTRACT_ID';\n  }\n}\n\nconst app = $context.$app || {};\nconst raw = app.$OraAppContext;\nconst parsed = parseObjectIfJson(raw);\nconst messageHint = compact(app.$OraMessageHint);\nconst intentValue = compact(parsed.intent || parsed.Intent || parsed.buyOrSell || parsed.BuyOrSell).toLowerCase();\nconst intent = intentValue === 's' || intentValue === 'sell' ? 'sell' : 'buy';\nconst partyLabel = intent === 'sell' ? 'Customer' : 'Supplier';\nconst contractId = compact(parsed.contractId || parsed.ContractId);\nconst contractNumber = compact(parsed.contractNumber || parsed.ContractNumber);\nconst contextRoute = contractId ? 'HAS_CONTRACT_ID' : noContractRouteForMessageHint(messageHint);\n\nconst result = {\n  contractId,\n  contractNumber,\n  intent,\n  partyLabel,\n  messageHint,\n  hasContractContext: Boolean(contractId || contractNumber),\n  contextRoute\n};\n\nreturn result;\n"
          },
          "outcomes": {
            "success": "1778051806281"
          },
          "code": "PARSE_APP_CONTEXT",
          "id": "2",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 7720,
            "y": 5690
          }
        },
        {
          "metadata": {
            "name": "Parse Action Context",
            "returnType": "object",
            "sourceCode": "let result = {};\nconst app = $context.$app || {};\nconst rawAction = app.$OraAction;\nconst rawAppContext = app.$OraAppContext;\n\nfunction compact(value) {\n  return String(value || '').trim();\n}\n\nfunction parseObjectIfJson(value) {\n  if (value && typeof value === 'object' && !Array.isArray(value)) {\n    return value;\n  }\n\n  if (typeof value !== 'string') {\n    return null;\n  }\n\n  function parseCandidate(text, depth) {\n    const trimmed = String(text || '').trim();\n    if (!trimmed || depth > 3) {\n      return null;\n    }\n\n    try {\n      const parsed = JSON.parse(trimmed);\n      if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {\n        return parsed;\n      }\n\n      if (typeof parsed === 'string') {\n        return parseCandidate(parsed, depth + 1);\n      }\n    } catch (e) {\n      // Try a conservative unescape below for object strings such as {\\\"action\\\":\\\"ViewOptions\\\"}.\n    }\n\n    if (trimmed.indexOf('\\\\\"') !== -1 && /^\\s*\\{/.test(trimmed)) {\n      const unescaped = trimmed.replace(/\\\\\"/g, '\"');\n      if (unescaped !== trimmed) {\n        return parseCandidate(unescaped, depth + 1);\n      }\n    }\n\n    return null;\n  }\n\n  return parseCandidate(value, 0);\n}\n\nlet appContext = {};\nconst parsedAppContext = parseObjectIfJson(rawAppContext);\nif (parsedAppContext) {\n  appContext = parsedAppContext;\n}\n\nfunction buyOrSellFromAppContext(context) {\n  const direct = compact(\n    (context || {}).BuyOrSell ||\n    (context || {}).buyOrSell ||\n    (context || {}).BuyOrsell ||\n    (context || {}).buyOrsell\n  );\n  const directToken = direct.toUpperCase();\n  if (directToken === 'S' || directToken === 'SELL') {\n    return 'S';\n  }\n  if (directToken === 'B' || directToken === 'BUY') {\n    return 'B';\n  }\n  if (direct) {\n    return direct;\n  }\n\n  const intent = compact(\n    (context || {}).intent ||\n    (context || {}).Intent ||\n    (context || {}).buyOrSellIntent ||\n    (context || {}).BuyOrSellIntent\n  );\n  const intentToken = intent.toUpperCase();\n  if (intentToken === 'S' || intentToken === 'SELL') {\n    return 'S';\n  }\n  if (intentToken === 'B' || intentToken === 'BUY') {\n    return 'B';\n  }\n  return '';\n}\nconst contextBuyOrSell = buyOrSellFromAppContext(appContext);\n\nif (typeof rawAction === 'string' && rawAction.trim()) {\n  const trimmedAction = rawAction.trim();\n  const submitMatch = trimmedAction.match(/^<oraFormSubmit\\b([^>]*)>([\\s\\S]*)<\\/oraFormSubmit>$/i);\n\n  if (submitMatch) {\n    const attrs = submitMatch[1] || '';\n    const payloadRaw = compact(submitMatch[2] || '');\n\n    let submittedFields = {};\n    if (payloadRaw) {\n      const parsedFields = parseObjectIfJson(payloadRaw);\n      if (parsedFields) {\n        submittedFields = parsedFields;\n      }\n    }\n\n    let submitId = '';\n    const idMatch = attrs.match(/\\bid\\s*=\\s*\"([^\"]*)\"/i) || attrs.match(/\\bid\\s*=\\s*'([^']*)'/i);\n    if (idMatch && idMatch[1]) {\n      submitId = compact(idMatch[1]);\n    }\n\n    let idDeviatingClauseId = '';\n    let idPolicyDeviationId = '';\n    const taggedIdMatch = submitId.match(/ContractDeviatingClause\\.([^.:|]+)[.:|]ContractPolicyDeviation\\.([^.:|]+)/i);\n    if (taggedIdMatch) {\n      idDeviatingClauseId = compact(taggedIdMatch[1]);\n      idPolicyDeviationId = compact(taggedIdMatch[2]);\n    } else {\n      const idParts = submitId.split(/[|:]/);\n      if (idParts.length > 0) {\n        idDeviatingClauseId = compact(idParts[0]);\n      }\n      if (idParts.length > 1) {\n        idPolicyDeviationId = compact(idParts[1]);\n      }\n    }\n\n    const editLanguageIdMatch = submitId.match(/^edit-language-txt\\.([^.:|]+)\\.([^.:|]+)/i);\n    const editContractIdFromId = compact(editLanguageIdMatch ? editLanguageIdMatch[1] : '');\n    const editClauseIdFromId = compact(editLanguageIdMatch ? editLanguageIdMatch[2] : '');\n\n    const reviewedFlagMatch = submitId.match(/SetClauseReviewed\\.([YN01]|TRUE|FALSE|YES|NO)\\b/i);\n    const reviewedFlagToken = reviewedFlagMatch ? compact(reviewedFlagMatch[1]).toUpperCase() : '';\n    const reviewedFlagFromId =\n      reviewedFlagToken === 'Y' ||\n      reviewedFlagToken === '1' ||\n      reviewedFlagToken === 'TRUE' ||\n      reviewedFlagToken === 'YES';\n\n    const payloadContractId = compact(submittedFields.contractId || submittedFields.ContractId);\n    const contextContractId = compact(appContext.contractId || appContext.ContractId);\n    const submittedValue = compact(\n      submittedFields.newValue ||\n      submittedFields.value ||\n      submittedFields.proposedClauseText ||\n      submittedFields.ProposedClauseText ||\n      submittedFields.rejectionReason ||\n      submittedFields.RejectionReason\n    );\n\n    if (editLanguageIdMatch) {\n      result = {\n        action: 'SaveEditedClauseLanguage',\n        submitType: 'oraFormSubmit',\n        formSubmitId: submitId,\n        contractId: payloadContractId || editContractIdFromId || contextContractId,\n        deviatingClauseId: compact(\n          submittedFields.deviatingClauseId ||\n          submittedFields.deviationClauseId ||\n          submittedFields.DeviatingClauseId ||\n          editClauseIdFromId ||\n          idDeviatingClauseId\n        ),\n        proposedClauseText: submittedValue,\n        newValue: submittedValue,\n        rawAction: rawAction\n      };\n    } else {\n      result = {\n        action: 'RejectIssue',\n        submitType: 'oraFormSubmit',\n        formSubmitId: submitId,\n        contractId: payloadContractId || contextContractId,\n        deviatingClauseId: compact(\n          submittedFields.deviatingClauseId ||\n          submittedFields.deviationClauseId ||\n          submittedFields.DeviatingClauseId ||\n          idDeviatingClauseId\n        ),\n        policyDeviationId: compact(\n          submittedFields.policyDeviationId ||\n          submittedFields.PolicyDeviationId ||\n          idPolicyDeviationId\n        ),\n        shouldSetClauseReviewedOnReject:\n          submittedFields.shouldSetClauseReviewedOnReject === true ||\n          compact(submittedFields.shouldSetClauseReviewedOnReject).toUpperCase() === 'TRUE' ||\n          compact(submittedFields.shouldSetClauseReviewedOnReject).toUpperCase() === 'Y' ||\n          reviewedFlagFromId,\n        BuyOrSell: compact(submittedFields.BuyOrSell || submittedFields.buyOrSell) || contextBuyOrSell,\n        changeRequestSummary: compact(\n          submittedFields.changeRequestSummary ||\n          submittedFields.ChangeRequestSummary ||\n          submittedFields.issueText ||\n          submittedFields.Issue\n        ),\n        proposedClauseText: compact(submittedFields.proposedClauseText || submittedFields.ProposedClauseText),\n        newValue: submittedValue,\n        rejectionReason: submittedValue,\n        rawAction: rawAction\n      };\n    }\n  } else {\n    const parsedAction = parseObjectIfJson(trimmedAction);\n    if (parsedAction) {\n      result = parsedAction;\n    } else {\n      result = { action: rawAction };\n    }\n  }\n} else if (rawAction && typeof rawAction === 'object' && !Array.isArray(rawAction)) {\n  result = rawAction;\n}\n\nif (!result || typeof result !== 'object' || Array.isArray(result)) {\n  result = {};\n}\n\nif (!compact(result.contractId)) {\n  const fallbackContractId = compact(appContext.contractId || appContext.ContractId);\n  if (fallbackContractId) {\n    result.contractId = fallbackContractId;\n  }\n}\n\nif (!compact(result.BuyOrSell || result.buyOrSell) && contextBuyOrSell) {\n  result.BuyOrSell = contextBuyOrSell;\n}\n\nreturn result;\r\n"
          },
          "outcomes": {
            "success": "11"
          },
