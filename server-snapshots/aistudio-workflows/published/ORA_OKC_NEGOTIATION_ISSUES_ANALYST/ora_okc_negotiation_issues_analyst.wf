        {
          "metadata": {
            "name": "Normalize Policy Deviation Messages",
            "returnType": "object",
            "sourceCode": "const action = (($context.$nodes.PARSE_ACTION_CONTEXT.$output || {}).result) || {};\nconst batchOutput = $context.$nodes.GET_CONTRACT_POLICY_DEVIATIONS.$output || {};\nconst staticLookups = ($context.$nodes.STATIC_CONTRACT_LOOKUPS.$output || {}).result || {};\nconst severityLookup = staticLookups.contractTermsRisks || [];\n\nfunction parseIfJson(value) {\n  if (typeof value !== 'string') {\n    return value;\n  }\n\n  const trimmed = value.trim();\n  if (!trimmed) {\n    return null;\n  }\n\n  try {\n    return JSON.parse(trimmed);\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction asObject(value) {\n  const parsed = parseIfJson(value);\n  if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {\n    return parsed;\n  }\n\n  if (value && typeof value === 'object' && !Array.isArray(value)) {\n    return value;\n  }\n\n  return {};\n}\n\nfunction asArray(value) {\n  const parsed = parseIfJson(value);\n  if (Array.isArray(parsed)) {\n    return parsed;\n  }\n\n  if (Array.isArray(value)) {\n    return value;\n  }\n\n  return [];\n}\n\nfunction compact(value) {\n  return String(value || '').replace(/\\s+/g, ' ').trim();\n}\n\nfunction normalizeToken(value) {\n  return compact(value).toUpperCase().replace(/[\\s_-]+/g, '');\n}\n\nfunction humanizeCode(value) {\n  return compact(value)\n    .replace(/[_-]+/g, ' ')\n    .toLowerCase()\n    .replace(/\\b\\w/g, function (ch) {\n      return ch.toUpperCase();\n    });\n}\n\nfunction getPartPayload(parts, partId) {\n  let i = 0;\n  for (i = 0; i < parts.length; i += 1) {\n    const part = parts[i] || {};\n    if (part.id !== partId) {\n      continue;\n    }\n\n    const payload = parseIfJson(part.payload);\n    if (payload !== null && payload !== undefined) {\n      return payload;\n    }\n\n    const result = parseIfJson(part.result);\n    if (result !== null && result !== undefined) {\n      return result;\n    }\n  }\n\n  return null;\n}\n\nfunction getFirstPartPayload(parts) {\n  let i = 0;\n  for (i = 0; i < parts.length; i += 1) {\n    const part = parts[i] || {};\n    const payload = parseIfJson(part.payload);\n    if (payload !== null && payload !== undefined) {\n      return payload;\n    }\n\n    const result = parseIfJson(part.result);\n    if (result !== null && result !== undefined) {\n      return result;\n    }\n  }\n\n  return null;\n}\n\nfunction extractDeviationRows(clausePayload, deviationPayload) {\n  const directRows = asArray((deviationPayload || {}).items);\n  if (directRows.length > 0) {\n    return directRows;\n  }\n\n  const clauseObj = asObject(clausePayload);\n  const expandedDirect = asArray(clauseObj.ContractPolicyDeviation || clauseObj.contractPolicyDeviation);\n  if (expandedDirect.length > 0) {\n    return expandedDirect;\n  }\n\n  const expandedObj = asObject(clauseObj.ContractPolicyDeviation || clauseObj.contractPolicyDeviation);\n  const expandedItems = asArray(expandedObj.items);\n  if (expandedItems.length > 0) {\n    return expandedItems;\n  }\n\n  return [];\n}\n\nfunction buildSeverityMap(rawLookup) {\n  const directRows = asArray(rawLookup);\n  const payload = asObject(rawLookup);\n  const rows = directRows.length > 0\n    ? directRows\n    : asArray(payload.items || ((payload.result || {}).items));\n  const map = {};\n  let i = 0;\n\n  for (i = 0; i < rows.length; i += 1) {\n    const row = rows[i] || {};\n    const code = compact(row.LookupCode || row.lookupCode || row.Code || row.code);\n    const meaning = compact(row.Meaning || row.meaning || row.DisplayValue || row.displayValue || row.LookupMeaning);\n    const key = normalizeToken(code);\n\n    if (key) {\n      map[key] = meaning || humanizeCode(code);\n    }\n  }\n\n  return map;\n}\n\nfunction severityRank(value) {\n  const token = normalizeToken(value);\n\n  if (!token) {\n    return 0;\n  }\n\n  if (token.indexOf('CRITICAL') !== -1) {\n    return 4;\n  }\n\n  if (token.indexOf('HIGH') !== -1) {\n    return 3;\n  }\n\n  if (token.indexOf('MEDIUM') !== -1) {\n    return 2;\n  }\n\n  if (token.indexOf('LOW') !== -1) {\n    return 1;\n  }\n\n  return 0;\n}\n\nfunction priorityFromSeverity(severityCode) {\n  const lookupCode = String(severityCode || '').trim();\n\n  switch (lookupCode) {\n    case '4_CRITICAL':\n      return 'alert';\n    case '3_HIGH_RISK':\n      return 'warning';\n    case '2_MEDIUM_RISK':\n      return 'medium';\n    case '1_LOW_RISK':\n      return 'neutral';\n    case '0_NO_RISK':\n      return 'success';\n    default:\n      return 'medium';\n  }\n}\n\nfunction rejectedLabel(buyOrSell) {\n  const side = normalizeToken(buyOrSell);\n\n  if (side === 'S' || side === 'SELL') {\n    return 'Customer Request Rejected';\n  }\n\n  return 'Supplier Request Rejected';\n}\n\nfunction recommendationRows(deviationRow) {\n  const raw = (deviationRow || {}).ContractPolicyRecommendation || (deviationRow || {}).contractPolicyRecommendation;\n  const rows = asArray(raw);\n  if (rows.length > 0) {\n    return rows;\n  }\n\n  const asObj = asObject(raw);\n  return asArray(asObj.items);\n}\n\nfunction isRecommendedFlag(flagValue) {\n  const token = normalizeToken(flagValue);\n  return token === 'Y' || token === 'YES' || token === 'TRUE' || token === '1';\n}\n\nfunction recommendedTypeForRow(deviationRow) {\n  const rows = recommendationRows(deviationRow);\n  let i = 0;\n  for (i = 0; i < rows.length; i += 1) {\n    const rec = rows[i] || {};\n    if (!isRecommendedFlag(rec.RecommendedFlag || rec.recommendedFlag)) {\n      continue;\n    }\n\n    const rawType = compact(rec.RecommendationType || rec.recommendationType);\n    if (rawType) {\n      return humanizeCode(rawType);\n    }\n  }\n\n  return '';\n}\n\nfunction recommendedPositionTextForRow(deviationRow) {\n  const rows = recommendationRows(deviationRow);\n  let i = 0;\n  for (i = 0; i < rows.length; i += 1) {\n    const rec = rows[i] || {};\n    if (!isRecommendedFlag(rec.RecommendedFlag || rec.recommendedFlag)) {\n      continue;\n    }\n\n    const positionText = typeof rec.PositionText === 'string'\n      ? rec.PositionText.trim()\n      : (typeof rec.positionText === 'string' ? rec.positionText.trim() : '');\n    if (positionText) {\n      return positionText;\n    }\n  }\n\n  return '';\n}\n\nfunction isAddressedStatusToken(token) {\n  return token === 'ADDRESSED' || token.indexOf('ADDRESSEDTO') === 0;\n}\n\nfunction isFinalDeviationStatusToken(token) {\n  return isAddressedStatusToken(token) || token === 'REJECTED';\n}\n\nfunction statusText(statusValue, buyOrSell) {\n  const token = normalizeToken(statusValue);\n\n  if (!token || token === 'OPEN') {\n    return '';\n  }\n\n  if (token === 'REJECTED') {\n    return rejectedLabel(buyOrSell);\n  }\n\n  if (isAddressedStatusToken(token)) {\n    return 'Addressed';\n  }\n\n  if (\n    token === 'CLOSED' ||\n    token === 'RESOLVED' ||\n    token === 'COMPLETED' ||\n    token === 'APPROVED' ||\n    token === 'ACCEPTED'\n  ) {\n    return humanizeCode(statusValue);\n  }\n\n  return humanizeCode(statusValue);\n}\n\nfunction statusPriority(statusValue) {\n  const token = normalizeToken(statusValue);\n\n  if (token === 'REJECTED') {\n    return 'warning';\n  }\n\n  if (isAddressedStatusToken(token)) {\n    return 'success';\n  }\n\n  return '';\n}\n\nfunction policyDeviationIdOfRow(row) {\n  return compact((row || {}).Id || (row || {}).PolicyDeviationId || (row || {}).policyDeviationId);\n}\n\nconst payload = asObject(batchOutput);\nconst parts = asArray(payload.parts);\n\nconst clauseHeaderPart = asObject(getPartPayload(parts, 'clauseHeaderById'));\nconst legacySinglePart = asObject(getPartPayload(parts, 'deviatingClauseWithPolicyDeviations'));\nconst fallbackFirstPart = asObject(getFirstPartPayload(parts));\nconst clausePart = Object.keys(clauseHeaderPart).length > 0\n  ? clauseHeaderPart\n  : Object.keys(legacySinglePart).length > 0\n    ? legacySinglePart\n    : fallbackFirstPart;\n\nconst directDeviationPayload = asObject(getPartPayload(parts, 'policyDeviationRowsByClause'));\nconst directDeviationRows = asArray(directDeviationPayload.items);\nconst deviationRows = directDeviationRows.length > 0\n  ? directDeviationRows\n  : extractDeviationRows(clausePart, null);\n\nconst clauseTitle = compact(clausePart.ClauseTitle || clausePart.clauseTitle || action.clauseTitle || action.ClauseTitle || 'Policy Deviations');\nconst clauseId = compact(clausePart.Id || clausePart.id || action.deviatingClauseId || action.deviationClauseId);\nconst contractId = compact(action.contractId || action.ContractId);\nconst actionBuyOrSell = compact(action.BuyOrSell || action.buyOrSell || action.BuyOrSEll || action.buyOrSEll);\nconst buyOrSell = actionBuyOrSell;\n\nconst validDeviationRows = deviationRows.filter(function (row) {\n  return Boolean(policyDeviationIdOfRow(row));\n});\n\nlet hasAtLeastOneAddressed = false;\nlet allValidRowsAddressedOrRejected = validDeviationRows.length > 0;\n\nlet i = 0;\nfor (i = 0; i < validDeviationRows.length; i += 1) {\n  const statusToken = normalizeToken((validDeviationRows[i] || {}).Status || (validDeviationRows[i] || {}).status);\n  if (isAddressedStatusToken(statusToken)) {\n    hasAtLeastOneAddressed = true;\n  }\n\n  if (!isFinalDeviationStatusToken(statusToken)) {\n    allValidRowsAddressedOrRejected = false;\n  }\n}\n\nconst showReviewClauseInsight = allValidRowsAddressedOrRejected && hasAtLeastOneAddressed;\n\nlet autoViewRecommendationsEligible = false;\nif (validDeviationRows.length === 1) {\n  const onlyRow = validDeviationRows[0] || {};\n  const onlyStatusToken = normalizeToken(onlyRow.Status || onlyRow.status);\n  autoViewRecommendationsEligible = Boolean(policyDeviationIdOfRow(onlyRow)) && onlyStatusToken === 'OPEN';\n}\n\nconst severityMap = buildSeverityMap(severityLookup);\n\nconst items = [];\nfor (i = 0; i < deviationRows.length; i += 1) {\n  const row = deviationRows[i] || {};\n  const issueNumber = compact(row.IssueNumber);\n  const issueText = compact(row.Issue || row.issue);\n  const changeSummary = compact(row.ChangeRequestSummary);\n  const rawChangeRequestSummary = changeSummary || issueText || 'No change request summary available.';\n  const severityCode = compact(row.SeverityCode);\n  const severityMeaning = severityMap[normalizeToken(severityCode)] || humanizeCode(severityCode);\n  const policyDeviationId = policyDeviationIdOfRow(row);\n  const issueLabel = issueNumber ? ('Issue #' + issueNumber) : 'Issue';\n  const recommendationType = recommendedTypeForRow(row);\n  const recommendedPositionText = recommendedPositionTextForRow(row);\n  const computedStatus = statusText(row.Status, buyOrSell);\n\n  const item = {\n    issueNumber,\n    changeRequestSummary: rawChangeRequestSummary,\n    title: issueLabel,\n    summary: rawChangeRequestSummary,\n    contractId,\n    deviatingClauseId: clauseId,\n    policyDeviationId,\n    BuyOrSell: buyOrSell,\n    recommendationType,\n    viewOptionsPayload: {\n      contractId,\n      deviatingClauseId: clauseId,\n      policyDeviationId,\n      BuyOrSell: buyOrSell,\n      action: 'ViewOptions'\n    },\n    additionalAction: {\n      text: 'View Positions',\n      command: ''\n    }\n  };\n\n  item.viewOptionsPayloadJson = JSON.stringify(item.viewOptionsPayload);\n  item.viewOptionsCommandPrefix = 'ora.Invoke(SendAgentCommandNoRefresh,';\n\n  if (severityMeaning) {\n    item.badgeText = severityMeaning;\n  }\n\n  item.priority = priorityFromSeverity(severityCode);\n\n  if (computedStatus) {\n    item.status = computedStatus;\n    const computedStatusPriority = statusPriority(row.Status);\n    if (computedStatusPriority) {\n      item.statusPriority = computedStatusPriority;\n    }\n  }\n\n  if (recommendedPositionText) {\n    item.recommendedPositionText = recommendedPositionText;\n  }\n\n  items.push(item);\n}\n\nconst reviewClausePayload = {\n  contractId,\n  deviatingClauseId: clauseId,\n  clauseTitle,\n  BuyOrSell: actionBuyOrSell || buyOrSell,\n  action: 'ReviewClause'\n};\nconst reviewClausePayloadJson = JSON.stringify(reviewClausePayload);\nconst reviewClauseCommand = 'ora.Invoke(SendAgentCommandNoRefresh,' + reviewClausePayloadJson + ')';\n\nconst result = {\n  contractId,\n  deviatingClauseId: clauseId,\n  clauseTitle,\n  subtitle: clauseTitle,\n  buyOrSell: actionBuyOrSell || buyOrSell,\n  showReviewClauseInsight,\n  autoViewRecommendationsEligible,\n  reviewClausePayload,\n  reviewClausePayloadJson,\n  reviewClauseCommand,\n  items\n};\n\nreturn result;"
          },
