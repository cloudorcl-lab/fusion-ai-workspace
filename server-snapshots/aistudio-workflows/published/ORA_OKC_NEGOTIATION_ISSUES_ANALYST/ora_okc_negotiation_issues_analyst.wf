          "metadata": {
            "name": "Build Reject Issue Payload",
            "returnType": "object",
            "sourceCode": "const action = (($context.$nodes.PARSE_ACTION_CONTEXT.$output || {}).result) || {};\nconst rawAppContext = ($context.$app || {}).$OraAppContext;\n\nfunction compact(value) {\n  return String(value || '').trim();\n}\n\nfunction parseObjectIfJson(value) {\n  if (value && typeof value === 'object' && !Array.isArray(value)) {\n    return value;\n  }\n  if (typeof value !== 'string') {\n    return {};\n  }\n  const trimmed = value.trim();\n  if (!trimmed) {\n    return {};\n  }\n  try {\n    const parsed = JSON.parse(trimmed);\n    return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};\n  } catch (e) {\n    return {};\n  }\n}\n\nfunction buyOrSellFromAppContext(context) {\n  const direct = compact(\n    (context || {}).BuyOrSell ||\n    (context || {}).buyOrSell ||\n    (context || {}).BuyOrsell ||\n    (context || {}).buyOrsell\n  );\n  const directToken = direct.toUpperCase();\n  if (directToken === 'S' || directToken === 'SELL') {\n    return 'S';\n  }\n  if (directToken === 'B' || directToken === 'BUY') {\n    return 'B';\n  }\n  if (direct) {\n    return direct;\n  }\n\n  const intent = compact(\n    (context || {}).intent ||\n    (context || {}).Intent ||\n    (context || {}).buyOrSellIntent ||\n    (context || {}).BuyOrSellIntent\n  );\n  const intentToken = intent.toUpperCase();\n  if (intentToken === 'S' || intentToken === 'SELL') {\n    return 'S';\n  }\n  if (intentToken === 'B' || intentToken === 'BUY') {\n    return 'B';\n  }\n  return '';\n}\n\nconst appContext = parseObjectIfJson(rawAppContext);\nconst contextBuyOrSell = buyOrSellFromAppContext(appContext);\n\nconst contractId = compact(action.contractId || action.ContractId);\nconst deviatingClauseId = compact(action.deviatingClauseId || action.deviationClauseId || action.DeviatingClauseId);\nconst policyDeviationId = compact(action.policyDeviationId || action.PolicyDeviationId);\nconst buyOrSell = compact(action.BuyOrSell || action.buyOrSell) || contextBuyOrSell;\n\nfunction rejectRequestLabel(value) {\n  const token = compact(value).toUpperCase();\n  return token === 'S' || token === 'SELL' ? 'Customer Request Rejected' : 'Supplier Request Rejected';\n}\n\nfunction rejectRequestSubtitle(value, topic) {\n  const token = compact(value).toUpperCase();\n  const prefix = token === 'S' || token === 'SELL' ? 'Reject Customer Request' : 'Reject Supplier Request';\n  return topic ? prefix + ' - ' + topic : prefix;\n}\n\nconst rejectionReason = compact(\n  action.newValue ||\n  action.rejectionReason ||\n  action.RejectionReason ||\n  action.value ||\n  action.deviationSummary ||\n  'Deviation rejected'\n);\nconst changeRequestSummary = compact(\n  action.changeRequestSummary ||\n  action.ChangeRequestSummary ||\n  action.issueText ||\n  action.Issue\n);\nconst rejectFormId =\n  'ContractDeviatingClause.' + deviatingClauseId +\n  '.ContractPolicyDeviation.' + policyDeviationId;\nconst rejectFormPayloadBase = {\n  id: rejectFormId,\n  type: 'richtext',\n  title: 'Reject Response',\n  subtitle: 'Force Majuere',\n  commitText: 'Save'\n};\nconst rejectFormPayloadBaseJson = JSON.stringify(rejectFormPayloadBase);\n\nconst rejectionSummary = rejectRequestLabel(buyOrSell);\nconst rejectSubtitle = rejectRequestSubtitle(buyOrSell, changeRequestSummary);\n\nconst batchPayload = [];\n\nif (contractId && deviatingClauseId && policyDeviationId) {\n  const policyDeviationPath =\n    '/contracts/' + encodeURIComponent(contractId) +\n    '/child/ContractDeviatingClauses/' + encodeURIComponent(deviatingClauseId) +\n    '/child/ContractPolicyDeviation/' + encodeURIComponent(policyDeviationId);\n\n  const deviatingClausePath =\n    '/contracts/' + encodeURIComponent(contractId) +\n    '/child/ContractDeviatingClauses/' + encodeURIComponent(deviatingClauseId);\n\n  batchPayload.push({\n    id: 'rejectPolicyDeviation',\n    path: policyDeviationPath,\n    operation: 'upsert',\n    payload: {\n      Status: 'REJECTED',\n      RejectionReason: rejectionReason\n    }\n  });\n\n  batchPayload.push({\n    id: 'clearClauseProposedTextAfterReject',\n    path: deviatingClausePath,\n    operation: 'upsert',\n    payload: {\n      ProposedClauseText: null\n    }\n  });\n\n  const policyDeviationFields = 'Id,DeviatingClauseId,IssueNumber,Issue,ChangeRequestSummary,Status,RejectionReason';\n  batchPayload.push({\n    id: 'fetchRejectedPolicyDeviation',\n    path: policyDeviationPath + '?onlyData=true&fields=' + encodeURIComponent(policyDeviationFields),\n    operation: 'get'\n  });\n\n  const contractHeaderFields = 'ContractId,BuyOrSell';\n  batchPayload.push({\n    id: 'fetchContractHeader',\n    path: '/contracts/' + encodeURIComponent(contractId) + '?onlyData=true&fields=' + encodeURIComponent(contractHeaderFields),\n    operation: 'get'\n  });\n}\n\nconst ready = batchPayload.length > 0;\n\nconst result = {\n  status: ready ? 'ready' : 'skipped',\n  action: 'RejectIssue',\n  contractId: contractId,\n  deviatingClauseId: deviatingClauseId,\n  policyDeviationId: policyDeviationId,\n  BuyOrSell: buyOrSell,\n  rejectionSummary: rejectionSummary,\n  rejectSubtitle: rejectSubtitle,\n  changeRequestSummary: changeRequestSummary,\n  rejectionReason: rejectionReason,\n  rejectFormId: rejectFormId,\n  rejectFormPayloadBase: rejectFormPayloadBase,\n  rejectFormPayloadBaseJson: rejectFormPayloadBaseJson,\n  targetStatus: 'REJECTED',\n  batchPayload: batchPayload,\n  updateCount: batchPayload.length,\n  note: ready\n    ? 'Prepared rejection update and confirmation fetch payload.'\n    : 'Missing one or more required identifiers for rejection update.'\n};\n\nreturn result;"
