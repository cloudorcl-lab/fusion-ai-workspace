        {
          "metadata": {
            "name": "Init Subtitle Clause Deviations",
            "returnType": "object",
            "sourceCode": "const headerNormalized = (($context.$nodes.NORMALIZE_INIT_SUBTITLE_CONTRACT_HEADER || {}).$output || {}).result || {};\nconst noContractNormalized = (($context.$nodes.NORMALIZE_INIT_SUBTITLE_NO_CONTRACT_CONTEXT || {}).$output || {}).result || {};\nconst ctx = (($context.$nodes.PARSE_APP_CONTEXT || {}).$output || {}).result || {};\n\nfunction hasSubtitleSource(normalized) {\n  return Boolean(normalized && normalized.contractSubtitleSource);\n}\n\nconst normalized = hasSubtitleSource(headerNormalized) ? headerNormalized : noContractNormalized;\nconst fallbackBuyOrSell = String(ctx.intent || '').trim() === 'sell' ? 'S' : 'B';\nconst source = normalized.contractSubtitleSource || { BuyOrSell: fallbackBuyOrSell };\n\nfunction formatDate(value) {\n  const raw = String(value || '').trim();\n  if (!raw) {\n    return '-';\n  }\n\n  const match = /^(\\d{4})-(\\d{2})-(\\d{2})/.exec(raw);\n  return match ? match[2] + '/' + match[3] + '/' + match[1] : raw;\n}\n\nconst buyOrSell = String(source.BuyOrSell || fallbackBuyOrSell).trim().toUpperCase();\nconst partyLabel = buyOrSell === 'S' ? 'Customer' : 'Supplier';\n\nconst partyName = String(source.PartyName || '').trim() || '-';\nconst assignee = String(source.Assignee || '').trim() || '-';\nconst assignedSince = formatDate(source.AssignedDate);\nconst authoringPartyAndSource = [\n  String(source.TermsAuthoringPartyMeaning || source.AuthoringPartyMeaning || '').trim(),\n  String(source.ContractTermsSourceMeaning || '').trim()\n].filter(function (value) {\n  return Boolean(value);\n}).join(' ') || '-';\n\nreturn (\n  partyLabel + ': ' + partyName +\n  ' | Assignee: ' + assignee +\n  ' | Assigned Since: ' + assignedSince +\n  ' | Authoring Party and Source: ' + authoringPartyAndSource\n);\n"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "INIT_SUBTITLE_CLAUSE_DEVIATIONS",
          "id": "7",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
