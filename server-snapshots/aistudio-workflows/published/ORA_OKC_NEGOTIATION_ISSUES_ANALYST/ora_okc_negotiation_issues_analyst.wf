          },
          "outputSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"FileUrl\": {\n            \"type\": \"string\"\n          },\n          \"CreationDate\": {\n            \"type\": \"string\"\n          },\n          \"LastUpdateDate\": {\n            \"type\": \"string\"\n          },\n          \"links\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\"\n            }\n          }\n        }\n      }\n    },\n    \"count\": {\n      \"type\": \"integer\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"integer\"\n    },\n    \"offset\": {\n      \"type\": \"integer\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\"\n      }\n    }\n  }\n}",
          "diagram": {
            "x": 5470,
            "y": 6597
          }
        },
        {
          "id": "1779012800011",
          "code": "PREPARE_INIT_SUBTITLE_CONTRACT_HEADER_BATCH_PAYLOAD",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Init Subtitle Contract Header Batch Payload",
            "returnType": "array",
            "sourceCode": "const ctx = ($context.$nodes.PARSE_APP_CONTEXT.$output || {}).result || {};\nconst contractId = String(ctx.contractId || '').trim();\nconst dataModeParam = ['only', 'Data=true'].join('');\nconst subtitleFields = 'ContractId,BuyOrSell,PartyName,Assignee,TermsAuthoringPartyMeaning,ContractTermsSourceMeaning,ContractNumber,AssignedDate';\n\nif (!contractId) {\n  return [];\n}\n\nconst escapedContractId = contractId.replace(/'/g, \"''\");\nconst query = \"ContractId='\" + escapedContractId + \"'\";\nconst path =\n  '/contracts?' + dataModeParam + '&q=' +\n  encodeURIComponent(query) +\n  '&fields=' +\n  encodeURIComponent(subtitleFields);\n\nreturn [\n  {\n    id: 'initSubtitleContractHeaderById',\n    path,\n    operation: 'get'\n  }\n];\n"
          },
          "outcomes": {
            "success": "1779012800012"
          },
          "inputs": [],
          "diagram": {
            "x": 5920,
            "y": 6597
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1779012800005",
          "code": "CHECK_CONTRACT_DOCUMENTS_EMPTY_FOR_INIT_SUBTITLE",
          "type": "CODE",
          "metadata": {
            "name": "Check Contract Documents Empty For Init Subtitle",
            "returnType": "object",
            "sourceCode": "const documentsOutput = $context.$nodes.GET_CONTRACT_DOCUMENTS_FOR_INIT_SUBTITLE.$output || {};\nconst contextOutput = (($context.$nodes.PARSE_APP_CONTEXT || {}).$output || {}).result || {};\n\nfunction asArray(value) {\n  if (Array.isArray(value)) {\n    return value;\n  }\n\n  return [];\n}\n\nconst contractId = String(contextOutput.contractId || '').trim();\nconst directItems = asArray(documentsOutput.items);\nconst resultItems = asArray((documentsOutput.result || {}).items);\nconst items = directItems.length > 0 ? directItems : resultItems;\nconst documentCount = items.length;\nconst hasExistingDocuments = documentCount > 0;\n\nreturn {\n  route: contractId && !hasExistingDocuments ? 'PREVIEW' : 'SKIP_EXISTING',\n  contractId,\n  hasExistingDocuments,\n  documentCount,\n  firstDocument: hasExistingDocuments ? (items[0] || {}) : {}\n};\n"
          },
          "inputs": [],
          "outcomes": {
            "success": "1779012800006"
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "diagram": {
            "x": 5470,
            "y": 6819
          }
        },
        {
          "id": "1779012800012",
          "code": "GET_INIT_SUBTITLE_CONTRACT_HEADER",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Get Init Subtitle Contract Header",
            "businessObjectCode": "ORA_CX_CONTRACTS_CONTRACTDETAIL",
            "functionName": "UpdateContractsInBatch",
            "outputSpecification": "{\n  \"type\": \"object\"\n}\n"
          },
          "outcomes": {
            "success": "1779012800013"
          },
          "inputs": [
            {
              "id": "1779012800012_batchPayload",
              "name": "batchPayload",
              "type": "string",
              "value": "{{$context.$nodes.PREPARE_INIT_SUBTITLE_CONTRACT_HEADER_BATCH_PAYLOAD.$output.result}}"
            }
          ],
          "diagram": {
            "x": 5920,
            "y": 6819
          },
          "outputSpecification": "{\n  \"type\": \"object\"\n}\n"
        },
        {
          "id": "1779012800006",
          "code": "ROUTE_INIT_SUBTITLE_DOCUMENT_CHECK",
          "type": "SWITCH",
          "metadata": {
            "name": "Route Init Subtitle Document Check"
          },
          "inputs": [
            {
              "id": "1779012800006_caseExpression",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$nodes.CHECK_CONTRACT_DOCUMENTS_EMPTY_FOR_INIT_SUBTITLE.$output.result.route}}"
            }
          ],
          "outcomes": {
            "PREVIEW": "1779012800007",
            "SKIP_EXISTING": "7",
            "success": "7"
          },
          "convergenceTargetId": "end",
          "diagram": {
            "x": 5470,
            "y": 7041
          }
        },
        {
          "id": "1779012800013",
          "code": "NORMALIZE_INIT_SUBTITLE_CONTRACT_HEADER",
          "type": "CODE",
          "metadata": {
            "name": "Normalize Init Subtitle Contract Header",
            "returnType": "object",
            "sourceCode": "const rawBatchOutput = (($context.$nodes.GET_INIT_SUBTITLE_CONTRACT_HEADER || {}).$output) || {};\nconst ctx = (($context.$nodes.PARSE_APP_CONTEXT || {}).$output || {}).result || {};\n\nfunction asObject(value) {\n  if (value && typeof value === 'object') {\n    return value;\n  }\n\n  if (typeof value === 'string') {\n    try {\n      const parsed = JSON.parse(value);\n      return parsed && typeof parsed === 'object' ? parsed : null;\n    } catch (e) {\n      return null;\n    }\n  }\n\n  return null;\n}\n\nfunction getParts(rawBatch) {\n  const rawObject = asObject(rawBatch) || {};\n  return Array.isArray(rawObject.parts) ? rawObject.parts : [];\n}\n\nfunction payloadItems(payload) {\n  const payloadObject = asObject(payload) || {};\n\n  if (Array.isArray(payloadObject.items)) {\n    return payloadObject.items;\n  }\n\n  if (payloadObject.result && Array.isArray(payloadObject.result.items)) {\n    return payloadObject.result.items;\n  }\n\n  return [];\n}\n\nfunction getPartPayload(parts, partId) {\n  let i = 0;\n\n  for (i = 0; i < parts.length; i += 1) {\n    const part = parts[i] || {};\n    if (part.id !== partId) {\n      continue;\n    }\n\n    const payloadObject = asObject(part.payload);\n    if (payloadObject) {\n      return payloadObject;\n    }\n\n    const resultObject = asObject(part.result);\n    if (resultObject) {\n      return resultObject;\n    }\n  }\n\n  return null;\n}\n\nconst directItems = payloadItems(rawBatchOutput);\nconst partItems = payloadItems(getPartPayload(getParts(rawBatchOutput), 'initSubtitleContractHeaderById'));\nconst items = partItems.length > 0 ? partItems : directItems;\nconst contract = items[0] || {};\n\nconst resolvedIntent = String(ctx.intent || '').trim();\nconst fallbackBuyOrSell = resolvedIntent === 'sell' ? 'S' : (resolvedIntent === 'buy' ? 'B' : '');\nconst resolvedContractId = String(ctx.contractId || contract.ContractId || '').trim();\nconst resolvedContractNumber = String(ctx.contractNumber || contract.ContractNumber || '').trim();\n\nconst subtitleSource = {\n  BuyOrSell: String(contract.BuyOrSell || fallbackBuyOrSell).trim(),\n  PartyName: String(contract.PartyName || '').trim(),\n  Assignee: String(contract.Assignee || '').trim(),\n  TermsAuthoringPartyMeaning: String(contract.TermsAuthoringPartyMeaning || contract.AuthoringPartyMeaning || '').trim(),\n  ContractTermsSourceMeaning: String(contract.ContractTermsSourceMeaning || '').trim(),\n  AssignedDate: String(contract.AssignedDate || '').trim()\n};\n\nreturn {\n  contractId: resolvedContractId,\n  contractNumber: resolvedContractNumber,\n  contractSubtitleSource: subtitleSource,\n  emptyState: items.length === 0 ? 'No contract header was returned for this contract.' : ''\n};\n"
          },
          "outcomes": {
            "success": "7"
          },
          "inputs": [],
          "diagram": {
            "x": 5920,
            "y": 7041
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
