        {
          "metadata": {
            "name": "Normalize Review Clause Messages",
            "returnType": "object",
            "sourceCode": "const action = (($context.$nodes.PARSE_ACTION_CONTEXT.$output || {}).result) || {};\nconst batchOutput = $context.$nodes.GET_REVIEW_CLAUSE_DATA.$output || {};\nconst contractDocumentsOutput = $context.$nodes.GET_CONTRACT_DOCUMENTS.$output || {};\n\nfunction parseIfJson(value) {\n  if (typeof value !== 'string') {\n    return value;\n  }\n\n  const trimmed = value.trim();\n  if (!trimmed) {\n    return String();\n  }\n\n  try {\n    return JSON.parse(trimmed);\n  } catch (e) {\n    return trimmed;\n  }\n}\n\nfunction asObject(value) {\n  const parsed = parseIfJson(value);\n  if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {\n    return parsed;\n  }\n\n  if (value && typeof value === 'object' && !Array.isArray(value)) {\n    return value;\n  }\n\n  return {};\n}\n\nfunction asArray(value) {\n  const parsed = parseIfJson(value);\n  if (Array.isArray(parsed)) {\n    return parsed;\n  }\n\n  if (Array.isArray(value)) {\n    return value;\n  }\n\n  return [];\n}\n\nfunction compact(value) {\n  return String(value || '').replace(/\\s+/g, ' ').trim();\n}\n\nfunction plainTextForPreviewHighlight(value) {\n  let text = String(value || '');\n  if (!text) {\n    return '';\n  }\n\n  text = text\n    .replace(/<\\s*(br|p|div|li|tr|table|tbody|thead|section|article|header|footer|h[1-6])\\b[^>]*>/gi, ' ')\n    .replace(/<\\s*\\/(p|div|li|tr|table|tbody|thead|section|article|header|footer|h[1-6])\\s*>/gi, ' ')\n    .replace(/<[^>]*>/g, ' ')\n    .replace(/&nbsp;/gi, ' ')\n    .replace(/&amp;/gi, '&')\n    .replace(/&lt;/gi, '<')\n    .replace(/&gt;/gi, '>')\n    .replace(/&quot;/gi, '\"')\n    .replace(/&#39;/g, \"'\")\n    .replace(/&#x27;/gi, \"'\")\n    .replace(/\\s+/g, ' ')\n    .trim();\n\n  return text;\n}\n\nfunction normalizeToken(value) {\n  return compact(value).toUpperCase().replace(/[\\s_-]+/g, '');\n}\n\nfunction humanizeCode(value) {\n  return compact(value)\n    .replace(/[_-]+/g, ' ')\n    .toLowerCase()\n    .replace(/\\b\\w/g, function (ch) {\n      return ch.toUpperCase();\n    });\n}\n\nfunction getPartPayload(parts, partId) {\n  let i = 0;\n  for (i = 0; i < parts.length; i += 1) {\n    const part = parts[i] || {};\n    if (part.id !== partId) {\n      continue;\n    }\n\n    if (part.payload !== undefined && part.payload !== null) {\n      const payload = parseIfJson(part.payload);\n      if (payload !== undefined && payload !== null && payload !== '') {\n        return payload;\n      }\n    }\n\n    if (part.result !== undefined && part.result !== null) {\n      const result = parseIfJson(part.result);\n      if (result !== undefined && result !== null && result !== '') {\n        return result;\n      }\n    }\n  }\n\n  return null;\n}\n\nfunction getFirstPartPayload(parts) {\n  let i = 0;\n  for (i = 0; i < parts.length; i += 1) {\n    const part = parts[i] || {};\n\n    if (part.payload !== undefined && part.payload !== null) {\n      const payload = parseIfJson(part.payload);\n      if (payload !== undefined && payload !== null && payload !== '') {\n        return payload;\n      }\n    }\n\n    if (part.result !== undefined && part.result !== null) {\n      const result = parseIfJson(part.result);\n      if (result !== undefined && result !== null && result !== '') {\n        return result;\n      }\n    }\n  }\n\n  return null;\n}\n\nfunction recommendationRows(deviationRow) {\n  const raw = (deviationRow || {}).ContractPolicyRecommendation || (deviationRow || {}).contractPolicyRecommendation;\n  const rows = asArray(raw);\n  if (rows.length > 0) {\n    return rows;\n  }\n\n  const asObj = asObject(raw);\n  return asArray(asObj.items);\n}\n\nfunction isRecommendedFlag(flagValue) {\n  const token = normalizeToken(flagValue);\n  return token === 'Y' || token === 'YES' || token === 'TRUE' || token === '1';\n}\n\nfunction uniqueNonEmpty(values) {\n  const out = [];\n  const seen = {};\n  let i = 0;\n\n  for (i = 0; i < values.length; i += 1) {\n    const value = compact(values[i]);\n    if (!value) {\n      continue;\n    }\n\n    const token = normalizeToken(value);\n    if (seen[token]) {\n      continue;\n    }\n\n    seen[token] = true;\n    out.push(value);\n  }\n\n  return out;\n}\n\nfunction parseDateValue(value) {\n  if (value === null || value === undefined) {\n    return 0;\n  }\n\n  if (typeof value === 'number' && isFinite(value)) {\n    return value;\n  }\n\n  const text = compact(value);\n  if (!text) {\n    return 0;\n  }\n\n  const parsed = Date.parse(text);\n  if (!isNaN(parsed)) {\n    return parsed;\n  }\n\n  const numeric = Number(text);\n  if (isFinite(numeric)) {\n    return numeric;\n  }\n\n  return 0;\n}\n\nfunction chooseLatestDocument(rows) {\n  let latest = null;\n  let latestValue = 0;\n  let i = 0;\n\n  for (i = 0; i < rows.length; i += 1) {\n    const row = asObject(rows[i]);\n    const dateValue = parseDateValue(\n      row.CreationDate ||\n      row.creationDate ||\n      row.CreationDateTime ||\n      row.creationDateTime ||\n      row.LastUpdateDate ||\n      row.lastUpdateDate\n    );\n\n    if (!latest || dateValue >= latestValue) {\n      latest = row;\n      latestValue = dateValue;\n    }\n  }\n\n  return latest;\n}\n\nfunction getLinksArray(obj) {\n  const directLinks = asArray((obj || {}).links);\n  if (directLinks.length > 0) {\n    return directLinks;\n  }\n\n  const contextObj = asObject((obj || {})['@context']);\n  return asArray(contextObj.links);\n}\n\nfunction buildPreviewUrlFromDocument(doc) {\n  const row = asObject(doc);\n  const links = getLinksArray(row);\n\n  let selfHref = '';\n  let i = 0;\n  for (i = 0; i < links.length; i += 1) {\n    const link = asObject(links[i]);\n    if (compact(link.rel).toLowerCase() === 'self' && compact(link.href)) {\n      selfHref = compact(link.href);\n      break;\n    }\n  }\n\n  const fileUrl = compact(row.FileUrl || row.fileUrl);\n  if (/^https?:\\/\\//i.test(fileUrl)) {\n    return fileUrl;\n  }\n\n  if (!selfHref || !fileUrl) {\n    return String();\n  }\n\n  const marker = '/fscmRestApi';\n  const idx = selfHref.indexOf(marker);\n  if (idx < 0) {\n    return String();\n  }\n\n  const host = selfHref.substring(0, idx);\n  const normalized = fileUrl.charAt(0) === '/' ? fileUrl : '/' + fileUrl;\n\n  return host + '/fscmUI' + normalized;\n}\n\nconst payload = asObject(batchOutput);\nconst parts = asArray(payload.parts);\n\nconst singleReviewPart = asObject(getPartPayload(parts, 'reviewClauseWithPolicyDeviations'));\nconst clauseHeader = asObject(\n  getPartPayload(parts, 'reviewClauseHeader') ||\n  singleReviewPart ||\n  getFirstPartPayload(parts)\n);\n\nconst originalClausePayload = getPartPayload(parts, 'reviewOriginalClauseTextEnclosure');\nconst originalClausePayloadObj = asObject(originalClausePayload);\nconst deviationPayload = asObject(getPartPayload(parts, 'reviewPolicyDeviations') || singleReviewPart);\n\nlet deviationRows = asArray(deviationPayload.items);\nif (deviationRows.length === 0) {\n  deviationRows = asArray(deviationPayload.ContractPolicyDeviation || deviationPayload.contractPolicyDeviation);\n}\nif (deviationRows.length === 0) {\n  const expanded = asObject(deviationPayload.ContractPolicyDeviation || deviationPayload.contractPolicyDeviation);\n  deviationRows = asArray(expanded.items);\n}\n\nconst firstDeviationRow = deviationRows.length > 0 ? asObject(deviationRows[0]) : {};\n\nconst contractId = compact(action.contractId || action.ContractId);\nconst deviatingClauseId = compact(\n  action.deviatingClauseId ||\n  action.deviationClauseId ||\n  clauseHeader.Id ||\n  firstDeviationRow.DeviatingClauseId ||\n  firstDeviationRow.deviatingClauseId\n);\nconst clauseTitle = compact(\n  action.clauseTitle ||\n  action.ClauseTitle ||\n  clauseHeader.ClauseTitle ||\n  clauseHeader.clauseTitle ||\n  firstDeviationRow.ClauseTitle ||\n  firstDeviationRow.clauseTitle ||\n  'Clause Review'\n);\nconst buyOrSell = compact(action.BuyOrSell || action.buyOrSell);\n\nconst enclosureText = typeof originalClausePayload === 'string'\n  ? compact(originalClausePayload)\n  : compact(\n      originalClausePayloadObj.OriginalClauseText ||\n      originalClausePayloadObj.originalClauseText ||\n      originalClausePayloadObj.OriginalClauseTExt ||\n      originalClausePayloadObj.OriginalclauseText ||\n      originalClausePayloadObj.originalclauseText ||\n      originalClausePayloadObj.text ||\n      originalClausePayloadObj.value\n    );\n\nconst originalClauseText = compact(\n  enclosureText ||\n  clauseHeader.OriginalClauseText ||\n  clauseHeader.originalClauseText ||\n  clauseHeader.OriginalClauseTExt ||\n  clauseHeader.OriginalclauseText ||\n  clauseHeader.originalclauseText ||\n  firstDeviationRow.OriginalClauseText ||\n  firstDeviationRow.originalClauseText ||\n  firstDeviationRow.OriginalClauseTExt ||\n  firstDeviationRow.OriginalclauseText ||\n  firstDeviationRow.originalclauseText ||\n  firstDeviationRow.ChangeRequestSummary\n);\n\nconst storedProposedClauseText = compact(\n  clauseHeader.ProposedClauseText ||\n  clauseHeader.proposedClauseText ||\n  firstDeviationRow.ProposedClauseText ||\n  firstDeviationRow.proposedClauseText\n);\n\nconst addressedSelections = [];\nconst implementationTargets = [];\nconst implementationSeen = {};\n\nlet i = 0;\nfor (i = 0; i < deviationRows.length; i += 1) {\n  const deviationRow = asObject(deviationRows[i]);\n  const deviationStatusToken = normalizeToken(deviationRow.Status || deviationRow.status);\n  const rowPolicyDeviationId = compact(deviationRow.Id || deviationRow.PolicyDeviationId || deviationRow.policyDeviationId);\n  const rowChangeRequestSummary = compact(deviationRow.ChangeRequestSummary);\n\n  const recommendations = recommendationRows(deviationRow);\n  let j = 0;\n  for (j = 0; j < recommendations.length; j += 1) {\n    const recommendation = asObject(recommendations[j]);\n    if (!isRecommendedFlag(recommendation.RecommendedFlag || recommendation.recommendedFlag)) {\n      continue;\n    }\n\n    const recommendationId = compact(recommendation.Id || recommendation.RecommendationId || recommendation.recommendationId);\n    if (deviationStatusToken === 'ADDRESSED') {\n      addressedSelections.push({\n        issueNumber: compact(deviationRow.IssueNumber),\n        changeRequestSummary: rowChangeRequestSummary,\n        requestedChangeSummary: rowChangeRequestSummary,\n        recommendationType: humanizeCode(recommendation.RecommendationType || recommendation.recommendationType),\n        positionText: compact(recommendation.PositionText || recommendation.positionText),\n        recommendationText: compact(recommendation.RecommendationText || recommendation.recommendationText),\n        policyDeviationId: rowPolicyDeviationId,\n        recommendationId: recommendationId\n      });\n    }\n\n    if (rowPolicyDeviationId && recommendationId) {\n      const key = rowPolicyDeviationId + '|' + recommendationId;\n      if (!implementationSeen[key]) {\n        implementationSeen[key] = true;\n        implementationTargets.push({\n          policyDeviationId: rowPolicyDeviationId,\n          recommendationId: recommendationId\n        });\n      }\n    }\n  }\n}\n\nconst uniquePositionTexts = uniqueNonEmpty(addressedSelections.map(function (item) {\n  return item.positionText;\n}));\n\nconst uniqueRecommendationTexts = uniqueNonEmpty(addressedSelections.map(function (item) {\n  return item.recommendationText;\n}));\n\nconst addressedSelectionCount = addressedSelections.length;\nconst hasAddressedSelections = addressedSelectionCount > 0;\nconst hasSingleAddressedSelection = addressedSelectionCount === 1;\nconst hasMultipleAddressedSelections = addressedSelectionCount > 1;\nconst hasStoredProposedClauseText = Boolean(storedProposedClauseText);\n\nconst singleAddressedSelection = hasSingleAddressedSelection ? asObject(addressedSelections[0]) : {};\nconst singleAddressedRecommendationText = compact(singleAddressedSelection.recommendationText);\nconst singleAddressedPositionText = compact(singleAddressedSelection.positionText);\nconst singleAddressedResolvedProposedClauseText = compact(\n  singleAddressedRecommendationText ||\n  singleAddressedPositionText ||\n  originalClauseText\n);\n\nlet normalizedProposedClauseText = '';\nif (hasStoredProposedClauseText) {\n  normalizedProposedClauseText = storedProposedClauseText;\n} else if (hasSingleAddressedSelection) {\n  normalizedProposedClauseText = singleAddressedResolvedProposedClauseText;\n} else if (!hasAddressedSelections) {\n  normalizedProposedClauseText = originalClauseText;\n}\n\nconst requiresLlmGeneratedProposedClauseText = !hasStoredProposedClauseText && hasMultipleAddressedSelections;\n\nconst documentsPayload = asObject(contractDocumentsOutput);\nconst documentsRows = asArray(\n  Array.isArray(documentsPayload.items)\n    ? documentsPayload.items\n    : asObject(documentsPayload.result).items\n);\nconst latestDocument = chooseLatestDocument(documentsRows);\nconst previewContractUrl = buildPreviewUrlFromDocument(latestDocument);\n\nconst editLanguageFormId =\n  'edit-language-txt.' +\n  compact(contractId) +\n  '.' +\n  compact(deviatingClauseId);\n\nconst safeOriginalClauseText = originalClauseText || 'Original clause text is unavailable.';\nconst previewHighlightText = plainTextForPreviewHighlight(originalClauseText) || 'Original clause text is unavailable.';\nconst acceptInsightPayloadBase = {\n  contractId,\n  deviatingClauseId,\n  clauseTitle,\n  originalClauseText: safeOriginalClauseText,\n  action: 'ImplementReviewedClause',\n  implementationTargets\n};\nconst acceptInsightPayloadBaseJson = JSON.stringify(acceptInsightPayloadBase);\nconst editLanguagePayloadBase = {\n  id: editLanguageFormId,\n  type: 'richtext',\n  title: 'Edit Language',\n  commitText: 'Save'\n};\nconst editLanguagePayloadBaseJson = JSON.stringify(editLanguagePayloadBase);\nconst previewContractPayload = {\n  id: 'artifact-editor-pdf',\n  type: 'pdf',\n  title: 'Preview Contract',\n  highlightText: previewHighlightText,\n  url: previewContractUrl,\n  useApplicationSecurity: true\n};\nconst previewContractPayloadJson = JSON.stringify(previewContractPayload);\n\nconst result = {\n  contractId,\n  deviatingClauseId,\n  clauseTitle,\n  buyOrSell,\n  staticTitle: 'The key differences between the current and the proposed language',\n  originalClauseText: originalClauseText || 'Original clause text is unavailable.',\n  proposedClauseText: normalizedProposedClauseText,\n  storedProposedClauseText,\n  hasStoredProposedClauseText,\n  addressedSelectionCount,\n  hasAddressedSelections,\n  hasSingleAddressedSelection,\n  hasMultipleAddressedSelections,\n  requiresLlmGeneratedProposedClauseText,\n  singleAddressedRecommendationText,\n  singleAddressedPositionText,\n  singleAddressedResolvedProposedClauseText,\n  addressedSelections,\n  positionTexts: uniquePositionTexts,\n  recommendationTexts: uniqueRecommendationTexts,\n  aggregatedPositionText: uniquePositionTexts.join('\\n- '),\n  aggregatedRecommendationText: uniqueRecommendationTexts.join('\\n- '),\n  editLanguageFormId,\n  implementationTargets,\n  acceptInsightPayloadBase,\n  acceptInsightPayloadBaseJson,\n  editLanguagePayloadBase,\n  editLanguagePayloadBaseJson,\n  previewContractPayload,\n  previewContractPayloadJson,\n  previewContractUrl\n};\n\nreturn result;\r\n"
          },
          "outcomes": {
            "success": "1776762555815"
          },
          "code": "NORMALIZE_REVIEW_CLAUSE_MESSAGES",
          "id": "1776762555814",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
