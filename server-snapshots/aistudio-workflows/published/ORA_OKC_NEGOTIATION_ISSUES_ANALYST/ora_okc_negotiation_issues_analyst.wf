            "sourceCode": "const action = (($context.$nodes.PARSE_ACTION_CONTEXT.$output || {}).result) || {};\n\nfunction compact(value) {\n  return String(value || '').trim();\n}\n\nlet contractId = compact(action.contractId || action.ContractId);\nlet deviatingClauseId = compact(action.deviatingClauseId || action.deviationClauseId || action.DeviatingClauseId);\nlet policyDeviationId = compact(action.policyDeviationId || action.PolicyDeviationId);\n\nlet batchPayload = [];\n\nif (contractId && deviatingClauseId && policyDeviationId) {\n  const recommendationFields =\n    'Id,DeviatingClauseId,IssueNumber,Issue,MatchedPositionCode,SeverityCode,Status,ChangeRequestSummary;' +\n    'ContractPolicyRecommendation:Id,RecommendationType,PositionText,SeverityCode,RecommendedFlag,RecommendedBy';\n  const clauseFields = 'Id,Status';\n  const policyDeviationStatusFields = 'Id,Status';\n\n  const baseClausePath =\n    '/contracts/' + encodeURIComponent(contractId) +\n    '/child/ContractDeviatingClauses/' + encodeURIComponent(deviatingClauseId);\n\n  const policyDeviationPath =\n    baseClausePath +\n    '/child/ContractPolicyDeviation/' + encodeURIComponent(policyDeviationId) +\n    '?onlyData=true&fields=' + encodeURIComponent(recommendationFields);\n\n  const clauseHeaderPath =\n    baseClausePath +\n    '?onlyData=true&fields=' + encodeURIComponent(clauseFields);\n\n  const policyDeviationStatusesPath =\n    baseClausePath +\n    '/child/ContractPolicyDeviation?onlyData=true&fields=' + encodeURIComponent(policyDeviationStatusFields);\n\n  batchPayload = [\n    {\n      id: 'policyDeviationWithRecommendations',\n      path: policyDeviationPath,\n      operation: 'get'\n    },\n    {\n      id: 'clauseHeaderById',\n      path: clauseHeaderPath,\n      operation: 'get'\n    },\n    {\n      id: 'policyDeviationStatusesByClause',\n      path: policyDeviationStatusesPath,\n      operation: 'get'\n    }\n  ];\n}\n\nreturn batchPayload;"
