          "inputs": [
            {
              "id": "6_prompt",
              "name": "prompt",
              "type": "string",
              "value": "CONTEXT: Contract number is {{$context.$nodes.NORMALIZE_CLAUSE_DEVIATIONS.$output.result.contractNumber}}. DATA: {{$context.$nodes.NORMALIZE_CLAUSE_DEVIATIONS.$output.result.rows}}.\nTASK: Summarize the clause deviations that need immediate review for this contract.\nOUTPUT: Return 2 to 4 sentences. Mention the number of impacted clauses, the most severe issue pattern, and the most urgent clause names."
            },
            {
              "id": "6_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "You summarize clause deviation queues without inventing facts."
            }
          ],
          "type": "LLM",
          "diagram": {
            "x": 6820,
