        {
          "metadata": {
            "name": "Prepare Accept Post Update Review Batch",
            "returnType": "array",
            "sourceCode": "const action = (($context.$nodes.PARSE_ACTION_CONTEXT.$output || {}).result) || {};\n\nfunction compact(value) {\n  return String(value || '').trim();\n}\n\nconst contractId = compact(action.contractId || action.ContractId);\nconst deviatingClauseId = compact(action.deviatingClauseId || action.deviationClauseId || action.DeviatingClauseId);\n\nlet batchPayload = [];\n\nif (contractId && deviatingClauseId) {\n  const clauseFields = 'Id,Status';\n  const policyDeviationStatusFields = 'Id,Status';\n\n  const baseClausePath =\n    '/contracts/' + encodeURIComponent(contractId) +\n    '/child/ContractDeviatingClauses/' + encodeURIComponent(deviatingClauseId);\n\n  batchPayload = [\n    {\n      id: 'clauseHeaderById',\n      path: baseClausePath + '?onlyData=true&fields=' + encodeURIComponent(clauseFields),\n      operation: 'get'\n    },\n    {\n      id: 'policyDeviationStatusesByClause',\n      path: baseClausePath + '/child/ContractPolicyDeviation?onlyData=true&fields=' + encodeURIComponent(policyDeviationStatusFields),\n      operation: 'get'\n    }\n  ];\n}\n\nreturn batchPayload;\r\n"
          },
          "outcomes": {
