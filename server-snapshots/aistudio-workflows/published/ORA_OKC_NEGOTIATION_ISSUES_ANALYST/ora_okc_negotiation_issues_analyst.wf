        {
          "metadata": {
            "name": "Build Accept Recommendation Payload",
            "returnType": "object",
            "sourceCode": "const action = (($context.$nodes.PARSE_ACTION_CONTEXT.$output || {}).result) || {};\nconst userContextRaw = ($context.$app || {}).$OraUserContext;\n\nfunction compact(value) {\n  return String(value || '').trim();\n}\n\nfunction parseIfJson(value) {\n  if (value && typeof value === 'object') {\n    return value;\n  }\n\n  if (typeof value !== 'string') {\n    return null;\n  }\n\n  const trimmed = value.trim();\n  if (!trimmed) {\n    return null;\n  }\n\n  try {\n    return JSON.parse(trimmed);\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction asArray(value) {\n  if (Array.isArray(value)) {\n    return value;\n  }\n\n  const parsed = parseIfJson(value);\n  if (Array.isArray(parsed)) {\n    return parsed;\n  }\n\n  return [];\n}\n\nfunction uniqStringArray(values) {\n  const seen = {};\n  const out = [];\n  let i = 0;\n\n  for (i = 0; i < values.length; i += 1) {\n    const token = compact(values[i]);\n    if (!token || seen[token]) {\n      continue;\n    }\n\n    seen[token] = true;\n    out.push(token);\n  }\n\n  return out;\n}\n\nfunction pickFirstNonEmpty(obj, keys) {\n  let i = 0;\n  for (i = 0; i < keys.length; i += 1) {\n    const value = compact((obj || {})[keys[i]]);\n    if (value) {\n      return value;\n    }\n  }\n\n  return '';\n}\n\nfunction extractRecommendedBy(raw) {\n  const parsed = parseIfJson(raw);\n\n  if (parsed && typeof parsed === 'object') {\n    const preferred = pickFirstNonEmpty(parsed, [\n      'userName',\n      'username',\n      'UserName',\n      'userLogin',\n      'login',\n      'LoginName',\n      'userId',\n      'personNumber',\n      'email'\n    ]);\n\n    if (preferred) {\n      return preferred;\n    }\n  }\n\n  const asText = compact(raw);\n  if (!asText) {\n    return 'current.user';\n  }\n\n  if (asText.charAt(0) === '{') {\n    return 'current.user';\n  }\n\n  return asText;\n}\n\nconst contractId = compact(action.contractId || action.ContractId);\nconst deviatingClauseId = compact(action.deviatingClauseId || action.deviationClauseId || action.DeviatingClauseId);\nconst policyDeviationId = compact(action.policyDeviationId || action.PolicyDeviationId);\nconst selectedRecommendationId = compact(action.recommendationId || action.selectedRecommendationId || action.RecommendationId || action.id);\nconst actionTopic = compact(action.topic || action.Topic);\nconst actionRecommendationType = compact(action.recommendationType || action.RecommendationType);\n\nconst allIdsRaw = action.allRecommendationIds || action.recommendationIds || action.policyRecommendationIds;\nconst siblingIdsRaw = action.siblingRecommendationIds || action.otherRecommendationIds;\n\nconst allRecommendationIds = uniqStringArray(\n  asArray(allIdsRaw)\n    .concat(asArray(siblingIdsRaw))\n    .concat(selectedRecommendationId ? [selectedRecommendationId] : [])\n);\n\nconst siblingRecommendationIds = allRecommendationIds.filter(function (id) {\n  return id !== selectedRecommendationId;\n});\n\nconst recommendedBy = extractRecommendedBy(userContextRaw);\nconst batchPayload = [];\n\nfunction buildPolicyDeviationPath() {\n  if (!contractId || !deviatingClauseId || !policyDeviationId) {\n    return '';\n  }\n\n  return '/contracts/' + encodeURIComponent(contractId) +\n    '/child/ContractDeviatingClauses/' + encodeURIComponent(deviatingClauseId) +\n    '/child/ContractPolicyDeviation/' + encodeURIComponent(policyDeviationId);\n}\n\nconst policyDeviationPath = buildPolicyDeviationPath();\nconst deviatingClausePath =\n  '/contracts/' + encodeURIComponent(contractId) +\n  '/child/ContractDeviatingClauses/' + encodeURIComponent(deviatingClauseId);\n\nif (policyDeviationPath && selectedRecommendationId) {\n  batchPayload.push({\n    id: 'acceptSelectedRecommendation',\n    path: policyDeviationPath + '/child/ContractPolicyRecommendation/' + encodeURIComponent(selectedRecommendationId),\n    operation: 'upsert',\n    payload: {\n      RecommendedFlag: 'Y',\n      RecommendedBy: recommendedBy\n    }\n  });\n\n  let i = 0;\n  for (i = 0; i < siblingRecommendationIds.length; i += 1) {\n    const recommendationId = siblingRecommendationIds[i];\n\n    batchPayload.push({\n      id: 'clearSiblingRecommendation_' + (i + 1),\n      path: policyDeviationPath + '/child/ContractPolicyRecommendation/' + encodeURIComponent(recommendationId),\n      operation: 'upsert',\n      payload: {\n        RecommendedFlag: 'N',\n        RecommendedBy: recommendedBy\n      }\n    });\n  }\n\n  batchPayload.push({\n    id: 'markPolicyDeviationAddressed',\n    path: policyDeviationPath,\n    operation: 'upsert',\n    payload: {\n      Status: 'ADDRESSED',\n      RejectionReason: ''\n    }\n  });\n\n  batchPayload.push({\n    id: 'clearClauseProposedTextAfterAccept',\n    path: deviatingClausePath,\n    operation: 'upsert',\n    payload: {\n      ProposedClauseText: null\n    }\n  });\n\n  const recommendationFields = 'Id,RecommendationType,PositionText,RecommendedFlag';\n  batchPayload.push({\n    id: 'fetchAcceptedRecommendation',\n    path: policyDeviationPath + '/child/ContractPolicyRecommendation/' + encodeURIComponent(selectedRecommendationId) +\n      '?onlyData=true&fields=' + encodeURIComponent(recommendationFields),\n    operation: 'get'\n  });\n}\n\nconst ready = batchPayload.length > 0;\n\nconst result = {\n  status: ready ? 'ready' : 'skipped',\n  action: 'AcceptRecommendation',\n  contractId,\n  deviatingClauseId,\n  policyDeviationId,\n  recommendationId: selectedRecommendationId,\n  topic: actionTopic,\n  acceptedRecommendationType: actionRecommendationType,\n  allRecommendationIds,\n  siblingRecommendationIds,\n  recommendedBy,\n  batchPayload,\n  updateCount: batchPayload.length,\n  note: ready\n    ? 'Prepared accept recommendation batch updates.'\n    : 'Missing one or more required identifiers for acceptance update.'\n};\n\nreturn result;\r\n"
