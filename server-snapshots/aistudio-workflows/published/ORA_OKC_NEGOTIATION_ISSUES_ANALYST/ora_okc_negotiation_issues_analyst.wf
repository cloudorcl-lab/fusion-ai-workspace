        {
          "metadata": {
            "name": "Normalize Policy Recommendation Messages",
            "returnType": "object",
            "sourceCode": "const action = (($context.$nodes.PARSE_ACTION_CONTEXT.$output || {}).result) || {};\nconst directRecommendationNode = $context.$nodes.GET_CONTRACT_POLICY_RECOMMENDATION || {};\nconst directRecommendationOutput = directRecommendationNode.$output || {};\nconst policyDeviationNode = $context.$nodes.GET_CONTRACT_POLICY_DEVIATIONS || {};\nconst policyDeviationOutput = policyDeviationNode.$output || {};\nconst normalizedPolicyDeviationNode = $context.$nodes.NORMALIZE_POLICY_DEVIATION_MESSAGES || {};\nconst normalizedPolicyDeviationOutput = (normalizedPolicyDeviationNode.$output || {}).result || {};\nconst staticLookups = ($context.$nodes.STATIC_CONTRACT_LOOKUPS.$output || {}).result || {};\nconst severityLookupOutput = staticLookups.contractTermsRisks || [];\nconst recommendationTypeLookupOutput = staticLookups.rulePositions || [];\n\nfunction compact(value) {\n  return String(value || '').replace(/\\s+/g, ' ').trim();\n}\n\nfunction normalizeToken(value) {\n  return compact(value).toUpperCase().replace(/[\\s_-]+/g, '');\n}\n\nfunction parseIfJson(value) {\n  if (value && typeof value === 'object') {\n    return value;\n  }\n\n  if (typeof value !== 'string') {\n    return null;\n  }\n\n  const trimmed = value.trim();\n  if (!trimmed) {\n    return null;\n  }\n\n  try {\n    return JSON.parse(trimmed);\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction asObject(value) {\n  const parsed = parseIfJson(value);\n  if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {\n    return parsed;\n  }\n\n  if (value && typeof value === 'object' && !Array.isArray(value)) {\n    return value;\n  }\n\n  return {};\n}\n\nfunction asArray(value) {\n  const parsed = parseIfJson(value);\n  if (Array.isArray(parsed)) {\n    return parsed;\n  }\n\n  if (Array.isArray(value)) {\n    return value;\n  }\n\n  return [];\n}\n\nfunction humanizeCode(value) {\n  const cleaned = compact(value);\n  if (!cleaned) {\n    return '';\n  }\n\n  return cleaned\n    .replace(/[_-]+/g, ' ')\n    .toLowerCase()\n    .replace(/\\b\\w/g, function (ch) {\n      return ch.toUpperCase();\n    });\n}\n\nfunction displayRecommendationType(value) {\n  const raw = compact(value);\n  const token = normalizeToken(raw);\n  const fallbackMatch = token.match(/^FALLBACK(\\d+)$/);\n  if (fallbackMatch) {\n    return 'Fallback ' + fallbackMatch[1];\n  }\n\n  if (token === 'STANDARD' || token === 'STANDARDPOSITION') {\n    return 'Standard';\n  }\n\n  if (token === 'OUTOFPOLICY') {\n    return 'Out of policy';\n  }\n\n  if (token === 'SUPPLIERREQUEST') {\n    return 'Supplier request';\n  }\n\n  if (token === 'CUSTOMERREQUEST') {\n    return 'Customer request';\n  }\n\n  return humanizeCode(raw);\n}\n\nfunction getPartPayload(parts, partId) {\n  let i = 0;\n  for (i = 0; i < parts.length; i += 1) {\n    const part = parts[i] || {};\n    if (part.id !== partId) {\n      continue;\n    }\n\n    const parsedPayload = parseIfJson(part.payload);\n    if (parsedPayload !== null && parsedPayload !== undefined) {\n      return parsedPayload;\n    }\n\n    const parsedResult = parseIfJson(part.result);\n    if (parsedResult !== null && parsedResult !== undefined) {\n      return parsedResult;\n    }\n  }\n\n  return null;\n}\n\nfunction getFirstPartPayload(parts) {\n  let i = 0;\n  for (i = 0; i < parts.length; i += 1) {\n    const part = parts[i] || {};\n    const parsedPayload = parseIfJson(part.payload);\n    if (parsedPayload !== null && parsedPayload !== undefined) {\n      return parsedPayload;\n    }\n\n    const parsedResult = parseIfJson(part.result);\n    if (parsedResult !== null && parsedResult !== undefined) {\n      return parsedResult;\n    }\n  }\n\n  return null;\n}\n\nfunction buildLookupMap(rawLookup) {\n  const directRows = asArray(rawLookup);\n  const payload = asObject(rawLookup);\n  const rows = directRows.length > 0\n    ? directRows\n    : asArray(Array.isArray(payload.items) ? payload.items : ((payload.result || {}).items));\n  const map = {};\n  let i = 0;\n\n  for (i = 0; i < rows.length; i += 1) {\n    const row = rows[i] || {};\n    const code = compact(row.LookupCode || row.lookupCode || row.Code || row.code || row.Value || row.value);\n    const meaning = compact(\n      row.DisplayValue ||\n      row.displayValue ||\n      row.Meaning ||\n      row.meaning ||\n      row.LookupMeaning ||\n      row.lookupMeaning ||\n      row.Description ||\n      row.description ||\n      row.Label ||\n      row.label\n    );\n    const codeToken = normalizeToken(code);\n\n    if (!codeToken) {\n      continue;\n    }\n\n    map[codeToken] = {\n      code: code,\n      meaning: meaning || humanizeCode(code)\n    };\n  }\n\n  return map;\n}\n\nfunction buildSeverityMap(rawLookup) {\n  const lookupMap = buildLookupMap(rawLookup);\n  const map = {};\n\n  Object.keys(lookupMap).forEach(function (key) {\n    map[key] = lookupMap[key].meaning || humanizeCode(lookupMap[key].code);\n  });\n\n  return map;\n}\n\nfunction resolveRecommendationTypeEntry(rawType, lookupMap) {\n  const token = normalizeToken(rawType);\n  if (!token) {\n    return null;\n  }\n\n  if (lookupMap[token]) {\n    return lookupMap[token];\n  }\n\n  const keys = Object.keys(lookupMap);\n  let i = 0;\n  for (i = 0; i < keys.length; i += 1) {\n    const key = keys[i];\n    const entry = lookupMap[key] || {};\n    if (normalizeToken(entry.meaning) === token) {\n      return entry;\n    }\n  }\n\n  return null;\n}\n\nfunction recommendationTitle(rawType, lookupEntry, index) {\n  const byLookup = displayRecommendationType((lookupEntry || {}).meaning);\n  if (byLookup) {\n    return byLookup;\n  }\n\n  const byCode = displayRecommendationType((lookupEntry || {}).code);\n  if (byCode) {\n    return byCode;\n  }\n\n  const byRaw = displayRecommendationType(rawType);\n  if (byRaw) {\n    return byRaw;\n  }\n\n  return 'Recommendation ' + String(index + 1);\n}\n\nfunction removeUndefined(value) {\n  if (!value || typeof value !== 'object' || Array.isArray(value)) {\n    return value;\n  }\n\n  const clone = {};\n  Object.keys(value).forEach(function (key) {\n    if (value[key] !== undefined && value[key] !== null && value[key] !== '') {\n      clone[key] = value[key];\n    }\n  });\n\n  return clone;\n}\n\nfunction requestPartyLabel(buyOrSell) {\n  const side = normalizeToken(buyOrSell);\n  if (side === 'S' || side === 'SELL') {\n    return 'Customer';\n  }\n\n  if (side === 'B' || side === 'BUY') {\n    return 'Supplier';\n  }\n\n  return 'Requester';\n}\n\nfunction rejectRequestLabel(buyOrSell) {\n  const side = normalizeToken(buyOrSell);\n  if (side === 'S' || side === 'SELL') {\n    return 'Reject Customer Request';\n  }\n\n  return 'Reject Supplier Request';\n}\n\nfunction requestedStatusLabel(buyOrSell) {\n  const side = normalizeToken(buyOrSell);\n  if (side === 'S' || side === 'SELL') {\n    return 'Customer Requested';\n  }\n\n  if (side === 'B' || side === 'BUY') {\n    return 'Supplier Requested';\n  }\n\n  return '';\n}\n\nfunction intentRequestTypeToken(buyOrSell) {\n  const side = normalizeToken(buyOrSell);\n  if (side === 'S' || side === 'SELL') {\n    return 'CUSTOMERREQUEST';\n  }\n\n  if (side === 'B' || side === 'BUY') {\n    return 'SUPPLIERREQUEST';\n  }\n\n  return '';\n}\n\nfunction closelyMatchesStatusLabel(buyOrSell) {\n  const side = normalizeToken(buyOrSell);\n  if (side === 'S' || side === 'SELL') {\n    return 'Closely matches to customer request';\n  }\n\n  if (side === 'B' || side === 'BUY') {\n    return 'Closely matches to supplier request';\n  }\n\n  return '';\n}\n\nfunction hasRecommendationType(recommendations, typeToken) {\n  if (!typeToken) {\n    return false;\n  }\n\n  let i = 0;\n  for (i = 0; i < recommendations.length; i += 1) {\n    const row = recommendations[i] || {};\n    const recommendationType = row.RecommendationType || row.recommendationType;\n    if (normalizeToken(recommendationType) === typeToken) {\n      return true;\n    }\n  }\n\n  return false;\n}\n\nfunction isRecommendedFlag(value) {\n  const token = normalizeToken(value);\n  return token === 'Y' || token === 'YES' || token === 'TRUE' || token === '1';\n}\n\nfunction recommendationHasFlagValue(row) {\n  return compact((row || {}).RecommendedFlag || (row || {}).recommendedFlag) !== '';\n}\n\nfunction recommendationRecommendedBy(row) {\n  return compact((row || {}).RecommendedBy || (row || {}).recommendedBy);\n}\n\nfunction acceptedRecommendationRow(rows) {\n  let i = 0;\n  for (i = 0; i < rows.length; i += 1) {\n    const row = rows[i] || {};\n    if (isRecommendedFlag(row.RecommendedFlag || row.recommendedFlag)) {\n      return row;\n    }\n  }\n\n  const hasAnyFlag = rows.some(recommendationHasFlagValue);\n  if (hasAnyFlag) {\n    return null;\n  }\n\n  const rowsWithRecommendedBy = rows.filter(function (row) {\n    return Boolean(recommendationRecommendedBy(row));\n  });\n\n  return rowsWithRecommendedBy.length === 1 ? rowsWithRecommendedBy[0] : null;\n}\n\nfunction acceptedRecommendationTitle(rows, lookupMap) {\n  const accepted = acceptedRecommendationRow(rows);\n  if (!accepted) {\n    return '';\n  }\n\n  const rawType = compact(accepted.RecommendationType || accepted.recommendationType);\n  const lookupEntry = resolveRecommendationTypeEntry(rawType, lookupMap);\n  return recommendationTitle(rawType, lookupEntry, 0);\n}\n\nfunction selectionGuidanceText(requestParty, acceptedTitle) {\n  if (acceptedTitle) {\n    return 'Previously accepted position: ' + acceptedTitle + '.';\n  }\n\n  const party = compact(requestParty) || 'requester';\n  return 'Select the position to use for this ' + party + ' Request.';\n}\n\nfunction recommendationMatchesType(recommendationTypeRaw, lookupEntry, typeToken) {\n  if (!typeToken) {\n    return false;\n  }\n\n  const candidates = [\n    normalizeToken(recommendationTypeRaw),\n    normalizeToken((lookupEntry || {}).code),\n    normalizeToken((lookupEntry || {}).meaning)\n  ];\n\n  let i = 0;\n  for (i = 0; i < candidates.length; i += 1) {\n    if (candidates[i] && candidates[i] === typeToken) {\n      return true;\n    }\n  }\n\n  return false;\n}\n\nfunction priorityFromSeverity(severityCode) {\n  const lookupCode = String(severityCode || '').trim();\n\n  switch (lookupCode) {\n    case '4_CRITICAL':\n      return 'alert';\n    case '3_HIGH_RISK':\n      return 'warning';\n    case '2_MEDIUM_RISK':\n      return 'medium';\n    case '1_LOW_RISK':\n      return 'neutral';\n    case '0_NO_RISK':\n      return 'success';\n    default:\n      return 'medium';\n  }\n}\n\nfunction isRequestedPositionCode(code) {\n  const token = normalizeToken(code);\n  return token === 'STANDARD' || /^FALLBACK\\d+$/.test(token);\n}\n\nfunction isOutOfPolicy(code) {\n  return normalizeToken(code) === 'OUTOFPOLICY';\n}\n\nfunction matchesPositionCode(matchedPositionCode, recommendationTypeRaw, lookupEntry) {\n  const matchedToken = normalizeToken(matchedPositionCode);\n  if (!matchedToken) {\n    return false;\n  }\n\n  const candidates = [\n    normalizeToken(recommendationTypeRaw),\n    normalizeToken((lookupEntry || {}).code),\n    normalizeToken((lookupEntry || {}).meaning)\n  ];\n\n  let i = 0;\n  for (i = 0; i < candidates.length; i += 1) {\n    if (candidates[i] && candidates[i] === matchedToken) {\n      return true;\n    }\n  }\n\n  return false;\n}\n\nfunction recommendationSortInfo(row, originalIndex, lookupMap, requestTypeToken) {\n  const recommendationTypeRaw = compact((row || {}).RecommendationType || (row || {}).recommendationType);\n  const lookupEntry = resolveRecommendationTypeEntry(recommendationTypeRaw, lookupMap);\n  const candidates = [\n    normalizeToken(recommendationTypeRaw),\n    normalizeToken((lookupEntry || {}).code),\n    normalizeToken((lookupEntry || {}).meaning)\n  ].filter(function (token) {\n    return Boolean(token);\n  });\n  let i = 0;\n  let fallbackNumber = 9999;\n\n  for (i = 0; i < candidates.length; i += 1) {\n    if (candidates[i] === 'STANDARD') {\n      return { group: 0, rank: 0, originalIndex: originalIndex };\n    }\n  }\n\n  for (i = 0; i < candidates.length; i += 1) {\n    const match = candidates[i].match(/^FALLBACK(\\d+)$/);\n    if (match) {\n      fallbackNumber = Math.min(fallbackNumber, Number(match[1]));\n    }\n  }\n  if (fallbackNumber !== 9999) {\n    return { group: 1, rank: fallbackNumber, originalIndex: originalIndex };\n  }\n\n  for (i = 0; i < candidates.length; i += 1) {\n    if (candidates[i] === 'OUTOFPOLICY') {\n      return { group: 2, rank: 0, originalIndex: originalIndex };\n    }\n  }\n\n  for (i = 0; i < candidates.length; i += 1) {\n    if (requestTypeToken && candidates[i] === requestTypeToken) {\n      return { group: 3, rank: 0, originalIndex: originalIndex };\n    }\n  }\n\n  return { group: 4, rank: 0, originalIndex: originalIndex };\n}\n\n\nfunction extractPolicyDeviationRows(parts, deviation) {\n  const directPayload = asObject(\n    getPartPayload(parts, 'policyDeviationStatusesByClause') ||\n    getPartPayload(parts, 'policyDeviationRowsByClause')\n  );\n  const directRows = asArray(Array.isArray(directPayload.items) ? directPayload.items : ((directPayload.result || {}).items));\n  if (directRows.length > 0) {\n    return directRows;\n  }\n\n  const fallback = asObject(deviation);\n  const embeddedRows = asArray(fallback.ContractPolicyDeviation || fallback.contractPolicyDeviation);\n  if (embeddedRows.length > 0) {\n    return embeddedRows;\n  }\n\n  const embeddedObject = asObject(fallback.ContractPolicyDeviation || fallback.contractPolicyDeviation);\n  return asArray(embeddedObject.items);\n}\n\nfunction extractDeviatingClauseStatus(parts, deviation) {\n  const clausePayload = asObject(\n    getPartPayload(parts, 'clauseHeaderById') ||\n    getPartPayload(parts, 'deviatingClauseHeader')\n  );\n  const statusFromHeader = compact(clausePayload.Status || clausePayload.status);\n  if (statusFromHeader) {\n    return statusFromHeader;\n  }\n\n  const fallback = asObject(deviation);\n  return compact(fallback.DeviatingClauseStatus || fallback.deviatingClauseStatus);\n}\n\nfunction shouldRefreshAcceptCommand(policyDeviationRows, currentPolicyDeviationId) {\n  const currentId = compact(currentPolicyDeviationId);\n  const rows = asArray(policyDeviationRows).filter(function (row) {\n    return Boolean(compact((row || {}).Id || (row || {}).PolicyDeviationId || (row || {}).policyDeviationId));\n  });\n\n  if (rows.length === 0) {\n    return false;\n  }\n\n  let openCount = 0;\n  let currentIsOpen = false;\n  let i = 0;\n\n  for (i = 0; i < rows.length; i += 1) {\n    const row = rows[i] || {};\n    const rowId = compact(row.Id || row.PolicyDeviationId || row.policyDeviationId);\n    const statusToken = normalizeToken(row.Status || row.status);\n\n    if (statusToken === 'OPEN') {\n      openCount += 1;\n      if (currentId && rowId === currentId) {\n        currentIsOpen = true;\n      }\n      continue;\n    }\n\n    if (statusToken !== 'ADDRESSED' && statusToken !== 'REJECTED') {\n      return false;\n    }\n  }\n\n  const currentIsLastOpen = Boolean(currentId) && currentIsOpen && openCount === 1;\n  const staleCompleteOutOfSync = openCount === 0;\n\n  return currentIsLastOpen || staleCompleteOutOfSync;\n}\n\nfunction policyDeviationIdOfRow(row) {\n  return compact((row || {}).Id || (row || {}).PolicyDeviationId || (row || {}).policyDeviationId);\n}\n\nfunction hasRecommendationData(value) {\n  const output = asObject(value);\n  const parts = asArray(output.parts);\n  if (parts.length > 0) {\n    return true;\n  }\n\n  const recommendationsRaw = output.ContractPolicyRecommendation || output.contractPolicyRecommendation;\n  const recommendationObject = asObject(recommendationsRaw);\n  const recommendationRows = asArray(recommendationsRaw);\n  return recommendationRows.length > 0 || asArray(recommendationObject.items).length > 0;\n}\n\nfunction targetPolicyDeviationIdFromContext() {\n  const normalizedItems = asArray(normalizedPolicyDeviationOutput.items);\n  const singleNormalizedItem = normalizedItems.length === 1 ? (normalizedItems[0] || {}) : {};\n\n  return compact(\n    action.policyDeviationId ||\n    action.PolicyDeviationId ||\n    singleNormalizedItem.policyDeviationId ||\n    singleNormalizedItem.PolicyDeviationId ||\n    normalizedPolicyDeviationOutput.policyDeviationId ||\n    normalizedPolicyDeviationOutput.PolicyDeviationId\n  );\n}\n\nfunction extractPolicyDeviationSourceRows() {\n  const output = asObject(policyDeviationOutput);\n  const parts = asArray(output.parts);\n  const clauseHeader = asObject(getPartPayload(parts, 'clauseHeaderById'));\n  const deviationPayload = asObject(getPartPayload(parts, 'policyDeviationRowsByClause'));\n  let rows = asArray(deviationPayload.items || ((deviationPayload.result || {}).items));\n\n  if (rows.length === 0) {\n    const clauseRows = asArray(clauseHeader.ContractPolicyDeviation || clauseHeader.contractPolicyDeviation);\n    if (clauseRows.length > 0) {\n      rows = clauseRows;\n    }\n  }\n\n  if (rows.length === 0) {\n    const embeddedRows = asObject(clauseHeader.ContractPolicyDeviation || clauseHeader.contractPolicyDeviation);\n    rows = asArray(embeddedRows.items);\n  }\n\n  const result = {\n    parts: parts,\n    clauseHeader: clauseHeader,\n    rows: rows\n  };\n  return result;\n}\n\nfunction compactStatusRow(row) {\n  const source = row || {};\n  const id = policyDeviationIdOfRow(source);\n  const status = compact(source.Status || source.status);\n  const result = {};\n\n  if (id) {\n    result.Id = id;\n  }\n\n  if (status) {\n    result.Status = status;\n  }\n\n  return result;\n}\n\nfunction buildRecommendationOutputFromPolicyDeviations() {\n  const source = extractPolicyDeviationSourceRows();\n  const rows = asArray(source.rows);\n  const targetId = targetPolicyDeviationIdFromContext();\n  let selectedRow = null;\n  let i = 0;\n\n  for (i = 0; i < rows.length; i += 1) {\n    const row = rows[i] || {};\n    if (targetId && policyDeviationIdOfRow(row) === targetId) {\n      selectedRow = row;\n      break;\n    }\n  }\n\n  if (!selectedRow && !targetId && rows.length === 1) {\n    selectedRow = rows[0] || null;\n  }\n\n  if (!selectedRow) {\n    const emptyResult = {};\n    return emptyResult;\n  }\n\n  const clauseHeader = Object.keys(source.clauseHeader).length > 0\n    ? source.clauseHeader\n    : {\n        Id: compact(action.deviatingClauseId || action.deviationClauseId || selectedRow.DeviatingClauseId),\n        Status: compact(selectedRow.DeviatingClauseStatus || selectedRow.deviatingClauseStatus)\n      };\n  const statusRows = rows.map(compactStatusRow).filter(function (row) {\n    return Object.keys(row || {}).length > 0;\n  });\n  const result = {\n    parts: [\n      {\n        id: 'policyDeviationWithRecommendations',\n        payload: selectedRow\n      },\n      {\n        id: 'clauseHeaderById',\n        payload: clauseHeader\n      },\n      {\n        id: 'policyDeviationStatusesByClause',\n        payload: {\n          items: statusRows\n        }\n      }\n    ]\n  };\n  return result;\n}\n\nconst recommendationOutput = hasRecommendationData(directRecommendationOutput)\n  ? directRecommendationOutput\n  : buildRecommendationOutputFromPolicyDeviations();\n\nconst outputObj = asObject(recommendationOutput);\nconst parts = asArray(outputObj.parts);\nconst partPayload = asObject(\n  getPartPayload(parts, 'policyDeviationWithRecommendations') ||\n  getPartPayload(parts, 'contractPolicyDeviationWithRecommendations') ||\n  getFirstPartPayload(parts)\n);\nconst deviation = Object.keys(partPayload).length > 0 ? partPayload : outputObj;\n\nconst recommendationsRaw = deviation.ContractPolicyRecommendation || deviation.contractPolicyRecommendation;\nconst recommendations = asArray(recommendationsRaw.items || recommendationsRaw);\n\nconst contractId = compact(action.contractId || action.ContractId);\nconst deviatingClauseId = compact(action.deviatingClauseId || action.deviationClauseId || deviation.DeviatingClauseId);\nconst policyDeviationId = compact(action.policyDeviationId || action.PolicyDeviationId || deviation.Id || deviation.PolicyDeviationId);\nconst rejectFormId =\n  'ContractDeviatingClause.' + deviatingClauseId +\n  '.ContractPolicyDeviation.' + policyDeviationId;\nconst rejectFormPayloadBase = {\n  id: rejectFormId,\n  type: 'richtext',\n  title: 'Reject Response',\n  subtitle: 'Force Majuere',\n  commitText: 'Save'\n};\nconst rejectFormPayloadBaseJson = JSON.stringify(rejectFormPayloadBase);\nconst buyOrSell = compact(action.BuyOrSell || action.buyOrSell || action.BuyOrSEll || action.buyOrSEll);\nconst issueText = compact(deviation.Issue || deviation.ChangeRequestSummary || action.clauseTitle || action.ClauseTitle || 'Policy deviation');\nconst issueNumber = compact(deviation.IssueNumber);\nconst matchedPositionCode = compact(deviation.MatchedPositionCode || deviation.matchedPositionCode);\nconst actionTopic = compact(action.topic || action.Topic);\n\nconst policyDeviationRows = extractPolicyDeviationRows(parts, deviation);\nconst isLastOpenPolicyDeviation = shouldRefreshAcceptCommand(policyDeviationRows, policyDeviationId);\nconst deviatingClauseStatus = extractDeviatingClauseStatus(parts, deviation);\nconst shouldRefreshAfterAccept = normalizeToken(deviatingClauseStatus) === 'OPEN' && isLastOpenPolicyDeviation;\nconst acceptCommandCode = shouldRefreshAfterAccept ? 'SendAgentCommandRefresh' : 'SendAgentCommandNoRefresh';\n\nconst severityMap = buildSeverityMap(severityLookupOutput);\nconst recommendationTypeMap = buildLookupMap(recommendationTypeLookupOutput);\nconst requestParty = requestPartyLabel(buyOrSell);\nconst requestedStatus = requestedStatusLabel(buyOrSell);\nconst intentRequestType = intentRequestTypeToken(buyOrSell);\nconst hasIntentRequestRecommendation = hasRecommendationType(recommendations, intentRequestType);\nconst closelyMatchesStatus = hasIntentRequestRecommendation ? closelyMatchesStatusLabel(buyOrSell) : '';\nconst rejectActionLabel = rejectRequestLabel(buyOrSell);\n\nconst recommendationIds = recommendations.map(function (row) {\n  return compact((row || {}).Id || (row || {}).RecommendationId || (row || {}).recommendationId);\n}).filter(function (id) {\n  return Boolean(id);\n});\n\nconst sortedRecommendations = recommendations\n  .map(function (row, index) {\n    return {\n      row: row,\n      sortInfo: recommendationSortInfo(row, index, recommendationTypeMap, intentRequestType)\n    };\n  })\n  .sort(function (left, right) {\n    const groupDiff = left.sortInfo.group - right.sortInfo.group;\n    if (groupDiff !== 0) {\n      return groupDiff;\n    }\n\n    const rankDiff = left.sortInfo.rank - right.sortInfo.rank;\n    if (rankDiff !== 0) {\n      return rankDiff;\n    }\n\n    return left.sortInfo.originalIndex - right.sortInfo.originalIndex;\n  })\n  .map(function (entry) {\n    return entry.row;\n  });\n\nconst acceptedTitle = acceptedRecommendationTitle(sortedRecommendations, recommendationTypeMap);\nconst sectionDescription = selectionGuidanceText(requestParty, acceptedTitle);\n\nconst items = sortedRecommendations.map(function (row, index) {\n  const item = row || {};\n  const recommendationId = compact(item.Id || item.RecommendationId || item.recommendationId);\n  const recommendationTypeRaw = compact(item.RecommendationType || item.recommendationType);\n  const lookupEntry = resolveRecommendationTypeEntry(recommendationTypeRaw, recommendationTypeMap);\n  const title = recommendationTitle(recommendationTypeRaw, lookupEntry, index);\n  const positionText = compact(item.PositionText || item.positionText || 'No position text available.');\n\n  const severityCode = compact(item.SeverityCode || item.severityCode || deviation.SeverityCode);\n  const severityMeaning = severityMap[normalizeToken(severityCode)] || humanizeCode(severityCode) || 'Risk';\n  const priority = priorityFromSeverity(severityCode);\n\n  const acceptPayload = removeUndefined({\n    contractId,\n    deviatingClauseId,\n    policyDeviationId,\n    recommendationId,\n    allRecommendationIds: recommendationIds,\n    BuyOrSell: buyOrSell,\n    topic: actionTopic,\n    recommendationType: title,\n    action: 'AcceptRecommendation'\n  });\n\n  \n  const normalizedItem = {\n    title: title,\n    summary: positionText,\n    badgeText: severityMeaning,\n    priority: priority,\n    recommendationTypeCode: compact((lookupEntry || {}).code || recommendationTypeRaw),\n    recommendationId: recommendationId\n  };\n\n\n    normalizedItem.additionalAction = {\n      text: 'Accept',\n      command: \"ora.Invoke('\" + acceptCommandCode + \"',\" + JSON.stringify(acceptPayload) + \")\"\n    };\n  \n\n  if (\n    requestedStatus &&\n    !isOutOfPolicy(matchedPositionCode) &&\n    matchesPositionCode(matchedPositionCode, recommendationTypeRaw, lookupEntry)\n  ) {\n    if (closelyMatchesStatus) {\n      normalizedItem.status = closelyMatchesStatus;\n      normalizedItem.statusPriority = 'warning';\n    } else if (isRequestedPositionCode(matchedPositionCode)) {\n      normalizedItem.status = requestedStatus;\n      normalizedItem.statusPriority = 'warning';\n    }\n  }\n\n\n  return normalizedItem;\n});\n\nconst sectionTitleContext = {\n  requestParty: requestParty,\n  issueText: issueText,\n  BuyOrSell: buyOrSell\n};\n\nconst result = {\n  contractId,\n  deviatingClauseId,\n  policyDeviationId,\n  clauseStatus: deviatingClauseStatus,\n  shouldRefreshAfterAccept,\n  rejectFormId,\n  rejectFormPayloadBase,\n  rejectFormPayloadBaseJson,\n  BuyOrSell: buyOrSell,\n  issueNumber,\n  issueText,\n  matchedPositionCode,\n  requestParty,\n  sectionTitleContext,\n  sectionDescription,\n  sectionSubtitle: sectionDescription,\n  sectionSummary: sectionDescription,\n  acceptedRecommendationTitle: acceptedTitle,\n  rejectActionLabel: rejectActionLabel,\n  rejectSubtitle: 'Force Majuere',\n  items\n};\n\nreturn result;"
          },
