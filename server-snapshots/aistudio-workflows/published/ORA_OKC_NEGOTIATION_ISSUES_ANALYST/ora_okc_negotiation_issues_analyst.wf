          "metadata": {
            "name": "Build Accept Clause Review Update Payload",
            "returnType": "object",
            "sourceCode": "const action = (($context.$nodes.PARSE_ACTION_CONTEXT.$output || {}).result) || {};\nconst checkOutput = $context.$nodes.GET_ACCEPT_POST_UPDATE_REVIEW_STATUS.$output || {};\n\nfunction compact(value) {\n  return String(value || '').trim();\n}\n\nfunction normalizeToken(value) {\n  return compact(value).toUpperCase().replace(/[\\s_-]+/g, '');\n}\n\nfunction parseIfJson(value) {\n  if (value && typeof value === 'object') {\n    return value;\n  }\n\n  if (typeof value !== 'string') {\n    return null;\n  }\n\n  const trimmed = value.trim();\n  if (!trimmed) {\n    return null;\n  }\n\n  try {\n    return JSON.parse(trimmed);\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction asObject(value) {\n  const parsed = parseIfJson(value);\n  if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {\n    return parsed;\n  }\n\n  if (value && typeof value === 'object' && !Array.isArray(value)) {\n    return value;\n  }\n\n  return {};\n}\n\nfunction asArray(value) {\n  const parsed = parseIfJson(value);\n  if (Array.isArray(parsed)) {\n    return parsed;\n  }\n\n  if (Array.isArray(value)) {\n    return value;\n  }\n\n  return [];\n}\n\nfunction getPartPayload(parts, partId) {\n  let i = 0;\n  for (i = 0; i < parts.length; i += 1) {\n    const part = parts[i] || {};\n    if (part.id !== partId) {\n      continue;\n    }\n\n    const payload = parseIfJson(part.payload);\n    if (payload !== null && payload !== undefined) {\n      return payload;\n    }\n\n    const result = parseIfJson(part.result);\n    if (result !== null && result !== undefined) {\n      return result;\n    }\n  }\n\n  return null;\n}\n\nconst contractId = compact(action.contractId || action.ContractId);\nconst deviatingClauseId = compact(action.deviatingClauseId || action.deviationClauseId || action.DeviatingClauseId);\n\nconst outputObj = asObject(checkOutput);\nconst parts = asArray(outputObj.parts);\nconst clauseHeader = asObject(getPartPayload(parts, 'clauseHeaderById'));\nconst statusPayload = asObject(getPartPayload(parts, 'policyDeviationStatusesByClause'));\nconst statusRows = asArray(statusPayload.items);\n\nconst clauseStatus = compact(clauseHeader.Status || clauseHeader.status);\nconst validRows = statusRows.filter(function (row) {\n  return Boolean(compact((row || {}).Id || (row || {}).PolicyDeviationId || (row || {}).policyDeviationId));\n});\n\nlet shouldMarkClauseReviewed = normalizeToken(clauseStatus) === 'OPEN' && validRows.length > 0;\n\nif (shouldMarkClauseReviewed) {\n  let i = 0;\n  for (i = 0; i < validRows.length; i += 1) {\n    const row = validRows[i] || {};\n    const token = normalizeToken(row.Status || row.status);\n    if (token !== 'ADDRESSED' && token !== 'REJECTED') {\n      shouldMarkClauseReviewed = false;\n      break;\n    }\n  }\n}\n\nconst batchPayload = [];\n\nif (shouldMarkClauseReviewed && contractId && deviatingClauseId) {\n  const path =\n    '/contracts/' + encodeURIComponent(contractId) +\n    '/child/ContractDeviatingClauses/' + encodeURIComponent(deviatingClauseId);\n\n  batchPayload.push({\n    id: 'markDeviatingClauseReviewedAfterAccept',\n    path: path,\n    operation: 'upsert',\n    payload: {\n      Status: 'REVIEWED',\n      ProposedClauseText: null\n    }\n  });\n}\n\nconst result = {\r\n  status: batchPayload.length > 0 ? 'ready' : 'skipped',\n  action: 'AcceptRecommendationPostCheck',\n  contractId,\n  deviatingClauseId,\n  clauseStatus,\n  policyDeviationCount: validRows.length,\n  shouldMarkClauseReviewed,\n  batchPayload,\n  updateCount: batchPayload.length,\n  note: batchPayload.length > 0\n    ? 'Prepared clause review update after acceptance.'\n    : 'Clause review update not required after acceptance.'\r\n};\r\n\r\nreturn result;\r\n\r\n"
          },
