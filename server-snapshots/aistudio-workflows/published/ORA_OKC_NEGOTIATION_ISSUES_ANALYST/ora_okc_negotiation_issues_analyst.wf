        {
          "metadata": {
            "name": "Normalize Clause Deviations",
            "returnType": "object",
            "sourceCode": "const rawBatchOutput = (($context.$nodes.GET_CONTRACT_DEVIATING_CLAUSES || {}).$output) || {};\nconst ctx = ($context.$nodes.PARSE_APP_CONTEXT.$output || {}).result || {};\n\nfunction asObject(value) {\n  if (value && typeof value === 'object') {\n    return value;\n  }\n\n  if (typeof value === 'string') {\n    try {\n      const parsed = JSON.parse(value);\n      return parsed && typeof parsed === 'object' ? parsed : null;\n    } catch (e) {\n      return null;\n    }\n  }\n\n  return null;\n}\n\nfunction normalizeToken(value) {\n  return String(value || '')\n    .trim()\n    .toUpperCase()\n    .replace(/[\\s_-]+/g, '');\n}\n\nfunction humanizeCode(value) {\n  const raw = String(value || '').trim();\n  if (!raw) {\n    return '';\n  }\n\n  return raw\n    .replace(/[_-]+/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .toLowerCase()\n    .replace(/\\b\\w/g, function (ch) {\n      return ch.toUpperCase();\n    });\n}\n\nfunction compactText(value) {\n  return String(value || '').replace(/\\s+/g, ' ').trim();\n}\n\nfunction extractItemsFromLookup(rawLookup) {\n  if (Array.isArray(rawLookup)) {\n    return rawLookup;\n  }\n\n  const rawObject = asObject(rawLookup) || {};\n\n  if (Array.isArray(rawObject.items)) {\n    return rawObject.items;\n  }\n\n  if (rawObject.result && Array.isArray(rawObject.result.items)) {\n    return rawObject.result.items;\n  }\n\n  return [];\n}\n\nfunction buildLookupMap(rawLookup) {\n  const items = extractItemsFromLookup(rawLookup);\n  const map = {};\n  let i = 0;\n\n  for (i = 0; i < items.length; i += 1) {\n    const item = items[i] || {};\n    const code = String(item.LookupCode || item.lookupCode || item.Code || item.code || '').trim();\n    const meaning = String(item.Meaning || item.meaning || item.DisplayValue || item.displayValue || item.LookupMeaning || '').trim();\n    const key = normalizeToken(code);\n\n    if (key) {\n      map[key] = meaning || humanizeCode(code);\n    }\n  }\n\n  return map;\n}\n\nfunction getParts(rawBatch) {\n  const rawObject = asObject(rawBatch) || {};\n  return Array.isArray(rawObject.parts) ? rawObject.parts : [];\n}\n\nfunction getPartPayload(parts, partId) {\n  let i = 0;\n  for (i = 0; i < parts.length; i += 1) {\n    const part = parts[i] || {};\n    if (part.id !== partId) {\n      continue;\n    }\n\n    const payloadObject = asObject(part.payload);\n    if (payloadObject) {\n      return payloadObject;\n    }\n\n    const resultObject = asObject(part.result);\n    if (resultObject) {\n      return resultObject;\n    }\n  }\n\n  return null;\n}\n\nfunction payloadItems(payload) {\n  const payloadObject = asObject(payload) || {};\n\n  if (Array.isArray(payloadObject.items)) {\n    return payloadObject.items;\n  }\n\n  if (payloadObject.result && Array.isArray(payloadObject.result.items)) {\n    return payloadObject.result.items;\n  }\n\n  return [];\n}\n\nfunction childClauseItemsFromContractRecord(contractRecord) {\n  const clauseContainer = contractRecord && contractRecord.ContractDeviatingClauses;\n  if (Array.isArray(clauseContainer)) {\n    return clauseContainer;\n  }\n\n  if (Array.isArray((clauseContainer || {}).items)) {\n    return clauseContainer.items;\n  }\n\n  return [];\n}\nfunction childPolicyDeviationItemsFromClauseRecord(clauseRecord) {\n  const policyContainer = clauseRecord && (\n    clauseRecord.ContractPolicyDeviation ||\n    clauseRecord.contractPolicyDeviation ||\n    clauseRecord.ContractPolicyDeviations ||\n    clauseRecord.contractPolicyDeviations\n  );\n\n  if (Array.isArray(policyContainer)) {\n    return policyContainer;\n  }\n\n  if (Array.isArray((policyContainer || {}).items)) {\n    return policyContainer.items;\n  }\n\n  return [];\n}\n\nfunction policyDeviationIdOfRow(row) {\n  const source = row || {};\n  return String(\n    source.Id ||\n    source.PolicyDeviationId ||\n    source.policyDeviationId ||\n    source.ContractPolicyDeviationId ||\n    source.contractPolicyDeviationId ||\n    ''\n  ).trim();\n}\n\nfunction firstNonEmpty(values) {\n  let i = 0;\n  for (i = 0; i < values.length; i += 1) {\n    const value = compactText(values[i]);\n    if (value) {\n      return value;\n    }\n  }\n\n  return '';\n}\n\nfunction priorityFromSeverity(severityCode) {\n  const lookupCode = String(severityCode || '').trim();\n\n  switch (lookupCode) {\n    case '4_CRITICAL':\n      return 'alert';\n    case '3_HIGH_RISK':\n      return 'warning';\n    case '2_MEDIUM_RISK':\n      return 'medium';\n    case '1_LOW_RISK':\n      return 'neutral';\n    case '0_NO_RISK':\n      return 'success';\n    default:\n      return 'medium';\n  }\n}\n\nfunction priorityFromClauseStatus(value) {\n  const token = normalizeToken(value);\n\n  if (token === 'OPEN') {\n    return 'warning';\n  }\n\n  if (token === 'REVIEWED') {\n    return 'medium';\n  }\n\n  if (token === 'COMPLETED') {\n    return 'success';\n  }\n\n  return 'medium';\n}\n\nfunction initActionPriorityLevelFromSeverity(value) {\n  const rank = severitySortOrder(value);\n\n  if (rank === 0) {\n    return 'critical';\n  }\n\n  return '';\n}\n\nfunction looksLikeClauseRow(item) {\n  const row = item || {};\n  return Boolean(row.ClauseTitle || row.DeviationSummary || row.StandardPositionSummary || row.DnzChrId || row.Id);\n}\n\nfunction looksLikeContractRow(item) {\n  const row = item || {};\n  return Boolean(row.ContractId || row.ContractNumber || row.BuyOrSell || row.ContractDeviatingClauses);\n}\n\nfunction extractContractRecord(rawBatch) {\n  const rawObject = asObject(rawBatch) || {};\n\n  if (Array.isArray(rawObject.items) && rawObject.items.length > 0 && looksLikeContractRow(rawObject.items[0])) {\n    return rawObject.items[0];\n  }\n\n  const parts = getParts(rawBatch);\n\n  const headerItems = payloadItems(getPartPayload(parts, 'contractHeaderById'));\n  if (headerItems.length > 0 && looksLikeContractRow(headerItems[0])) {\n    return headerItems[0];\n  }\n\n  const legacyItems = payloadItems(getPartPayload(parts, 'contractDeviationsByContractId'));\n  if (legacyItems.length > 0 && looksLikeContractRow(legacyItems[0])) {\n    return legacyItems[0];\n  }\n\n  return {};\n}\n\nfunction extractClauseItems(rawBatch, contractRecord) {\n  const parts = getParts(rawBatch);\n\n  const openItems = payloadItems(getPartPayload(parts, 'contractDeviatingClausesOpen'));\n  const reviewedItems = payloadItems(getPartPayload(parts, 'contractDeviatingClausesReviewed'));\n  const closedItems = payloadItems(getPartPayload(parts, 'contractDeviatingClausesClosed'));\n\n  const orderedByStatus = []\n    .concat(openItems)\n    .concat(reviewedItems)\n    .concat(closedItems)\n    .filter(function (item) {\n      return looksLikeClauseRow(item);\n    });\n\n  if (orderedByStatus.length > 0) {\n    return orderedByStatus;\n  }\n\n  const backendSortedItems = payloadItems(getPartPayload(parts, 'contractDeviatingClausesByContractId'));\n  if (backendSortedItems.length > 0 && looksLikeClauseRow(backendSortedItems[0])) {\n    return backendSortedItems;\n  }\n\n  const legacyItems = payloadItems(getPartPayload(parts, 'contractDeviationsByContractId'));\n  if (legacyItems.length > 0) {\n    if (looksLikeClauseRow(legacyItems[0])) {\n      return legacyItems;\n    }\n\n    if (looksLikeContractRow(legacyItems[0])) {\n      const embedded = childClauseItemsFromContractRecord(legacyItems[0]);\n      if (embedded.length > 0) {\n        return embedded;\n      }\n    }\n  }\n\n  const rawObject = asObject(rawBatch) || {};\n  if (Array.isArray(rawObject.items) && rawObject.items.length > 0 && looksLikeClauseRow(rawObject.items[0])) {\n    return rawObject.items;\n  }\n\n  return childClauseItemsFromContractRecord(contractRecord);\n}\n\nfunction statusSortOrder(statusCode) {\n  const token = normalizeToken(statusCode);\n\n  if (token === 'OPEN') {\n    return 0;\n  }\n\n  if (token === 'REVIEWED') {\n    return 1;\n  }\n\n  if (\n    token === 'CLOSED' ||\n    token === 'RESOLVED' ||\n    token === 'COMPLETED' ||\n    token === 'APPROVED' ||\n    token === 'ACCEPTED'\n  ) {\n    return 2;\n  }\n\n  return 3;\n}\n\nfunction severitySortOrder(severityCode) {\n  const token = normalizeToken(severityCode);\n\n  if (token === '4CRITICAL' || token === 'CRITICAL') {\n    return 0;\n  }\n\n  if (token === '3HIGHRISK' || token === 'HIGHRISK' || token === 'HIGH') {\n    return 1;\n  }\n\n  if (token === '2MEDIUMRISK' || token === 'MEDIUMRISK' || token === 'MEDIUM') {\n    return 2;\n  }\n\n  if (token === '1LOWRISK' || token === 'LOWRISK' || token === 'LOW') {\n    return 3;\n  }\n\n  if (token === '0NORISK' || token === 'NORISK') {\n    return 4;\n  }\n\n  return 5;\n}\n\nconst staticLookups = ($context.$nodes.STATIC_CONTRACT_LOOKUPS.$output || {}).result || {};\nconst severityLookupMap = buildLookupMap(staticLookups.contractTermsRisks || []);\nconst statusLookupMap = buildLookupMap(staticLookups.clauseStatuses || []);\n\nconst contract = extractContractRecord(rawBatchOutput);\nconst clauseItems = extractClauseItems(rawBatchOutput, contract);\n\nconst contractAssignedSince = String(contract.AssignedDate || '').trim();\nconst resolvedContractId = String(ctx.contractId || contract.ContractId || '').trim();\nconst resolvedContractNumber = String(ctx.contractNumber || contract.ContractNumber || '').trim();\nconst resolvedIntent = String(ctx.intent || '').trim();\nconst fallbackBuyOrSell = resolvedIntent === 'sell' ? 'S' : (resolvedIntent === 'buy' ? 'B' : '');\nconst resolvedBuyOrSell = String(contract.BuyOrSell || fallbackBuyOrSell).trim();\n\nconst rows = clauseItems.map((item) => {\n  const severityCode = String((item || {}).SeverityCode || '').trim();\n  const statusCode = String((item || {}).Status || '').trim();\n  const severityDisplay = severityLookupMap[normalizeToken(severityCode)] || humanizeCode(severityCode);\n  const statusDisplay = statusLookupMap[normalizeToken(statusCode)] || humanizeCode(statusCode);\n  const deviatingClauseId = String((item || {}).Id || (item || {}).DnzChrId || '').trim();\n  const clauseTitle = String((item || {}).ClauseTitle || 'Clause').trim() || 'Clause';\n  const assignedSince = String((item || {}).AssignedDate || contractAssignedSince).trim();\n  const policyDeviationRows = childPolicyDeviationItemsFromClauseRecord(item);\n\n  return {\n    clauseTitle,\n    deviationSummary: compactText((item || {}).DeviationSummary),\n    standardPositionSummary: compactText((item || {}).StandardPositionSummary),\n    severityCode,\n    severityDisplay,\n    severityPriority: priorityFromSeverity(severityCode),\n    status: statusCode,\n    statusDisplay,\n    statusPriority: priorityFromClauseStatus(statusCode || statusDisplay),\n    assignedSince,\n    contractId: resolvedContractId,\n    deviatingClauseId,\n    majorVersion: String((item || {}).MajorVersion || '').trim(),\n    policyDeviationRows,\n    actionPayload: {\n      contractId: resolvedContractId,\n      contractNumber: resolvedContractNumber,\n      intent: resolvedIntent,\n      BuyOrSell: resolvedBuyOrSell,\n      deviatingClauseId,\n      clauseTitle,\n      action: 'ViewDeviations'\n    }\n  };\n});\n\nlet hardenedRowIndex = 0;\nfor (hardenedRowIndex = 0; hardenedRowIndex < rows.length; hardenedRowIndex += 1) {\n  const row = rows[hardenedRowIndex] || {};\n  const actionPayload = asObject(row.actionPayload) || {};\n  const actionPayloadJson = JSON.stringify(actionPayload);\n  const agentReviewPayload = {};\n  Object.keys(actionPayload).forEach(function (key) {\n    agentReviewPayload[key] = actionPayload[key];\n  });\n  agentReviewPayload.action = 'Review';\n\n  row.actionPayload = actionPayload;\n  row.actionPayloadJson = actionPayloadJson;\n  row.reviewInvokeCommand = \"ora.Invoke('SendAgentCommandNoRefresh',\" + actionPayloadJson + \")\";\n  row.agentReviewPayload = agentReviewPayload;\n  row.agentReviewPayloadJson = JSON.stringify(agentReviewPayload);\n  row.agentReviewCommand = 'ora.Agent(' + row.agentReviewPayloadJson + ')';\n}\n\nconst initDisplayRows = rows\n  .map(function (row, index) {\n    return {\n      row: row,\n      index: index\n    };\n  })\n  .sort(function (left, right) {\n    const statusDiff = statusSortOrder(left.row.status) - statusSortOrder(right.row.status);\n    if (statusDiff !== 0) {\n      return statusDiff;\n    }\n\n    const severityDiff = severitySortOrder(left.row.severityCode || left.row.severityDisplay) - severitySortOrder(right.row.severityCode || right.row.severityDisplay);\n    if (severityDiff !== 0) {\n      return severityDiff;\n    }\n\n    const titleDiff = String(left.row.clauseTitle || '').localeCompare(String(right.row.clauseTitle || ''));\n    if (titleDiff !== 0) {\n      return titleDiff;\n    }\n\n    const idDiff = String(left.row.deviatingClauseId || '').localeCompare(String(right.row.deviatingClauseId || ''));\n    if (idDiff !== 0) {\n      return idDiff;\n    }\n\n    return left.index - right.index;\n  })\n  .map(function (entry) {\n    return entry.row;\n  });\n\n\nfunction initDisplayPolicyIssue(policyRow, clauseRow) {\n  const policySeverityCode = firstNonEmpty([\n    policyRow.SeverityCode,\n    policyRow.severityCode,\n    clauseRow.severityCode,\n    clauseRow.severityDisplay\n  ]);\n  const policySeverityDisplay =\n    severityLookupMap[normalizeToken(policySeverityCode)] ||\n    clauseRow.severityDisplay ||\n    humanizeCode(policySeverityCode);\n\n  return {\n    status: String(policyRow.Status || policyRow.status || '').trim(),\n    severityDisplay: policySeverityDisplay,\n    issue: compactText(policyRow.Issue || policyRow.issue),\n    changeRequestSummary: compactText(policyRow.ChangeRequestSummary || policyRow.changeRequestSummary)\n  };\n}\n\nfunction isOpenCriticalPolicyIssue(issue) {\n  const statusToken = normalizeToken((issue || {}).status);\n  const severityToken = normalizeToken((issue || {}).severityDisplay);\n  return statusToken === 'OPEN' && severityToken === 'CRITICAL';\n}\n\nfunction toInitDisplayTableRow(row) {\n  const actionPayload = asObject(row.actionPayload) || {};\n\n  return {\n    clauseTitle: row.clauseTitle,\n    deviationSummary: row.deviationSummary,\n    standardPositionSummary: row.standardPositionSummary,\n    severityDisplay: row.severityDisplay,\n    severityPriority: row.severityPriority,\n    statusDisplay: row.statusDisplay,\n    statusPriority: row.statusPriority,\n    BuyOrSell: String(actionPayload.BuyOrSell || '').trim(),\n    reviewInvokeCommand: row.reviewInvokeCommand\n  };\n}\n\nconst initDisplayTableRows = initDisplayRows.map(function (row) {\n  return toInitDisplayTableRow(row || {});\n});\n\nconst initDisplaySummaryRows = initDisplayRows\n  .slice(0, 2)\n  .map(function (row) {\n    const policyRows = Array.isArray(row.policyDeviationRows) ? row.policyDeviationRows : [];\n    const policyIssues = policyRows\n      .map(function (policyRow) {\n        return initDisplayPolicyIssue(policyRow || {}, row || {});\n      })\n      .filter(function (issue) {\n        return Boolean(isOpenCriticalPolicyIssue(issue));\n      });\n\n    if (policyIssues.length === 0) {\n      return null;\n    }\n\n    return {\n      clauseTitle: row.clauseTitle,\n      policyIssues: policyIssues.map(function (issue) {\n        return {\n          status: issue.status,\n          severityDisplay: issue.severityDisplay\n        };\n      })\n    };\n  })\n  .filter(function (row) {\n    return Boolean(row);\n  });\n\nconst initDisplayLlmRows = initDisplayTableRows;\n\nconst initActionPolicyDeviationRows = [];\nlet actionClauseIndex = 0;\nlet actionPolicyIndex = 0;\nfor (actionClauseIndex = 0; actionClauseIndex < initDisplayRows.length; actionClauseIndex += 1) {\n  if (initActionPolicyDeviationRows.length >= 3) {\n    break;\n  }\n\n  const clauseRow = initDisplayRows[actionClauseIndex] || {};\n  if (normalizeToken(clauseRow.status) !== 'OPEN') {\n    continue;\n  }\n\n  const policyRows = Array.isArray(clauseRow.policyDeviationRows) ? clauseRow.policyDeviationRows : [];\n  for (actionPolicyIndex = 0; actionPolicyIndex < policyRows.length; actionPolicyIndex += 1) {\n    if (initActionPolicyDeviationRows.length >= 3) {\n      break;\n    }\n\n    const policyRow = policyRows[actionPolicyIndex] || {};\n    if (normalizeToken(policyRow.Status || policyRow.status) !== 'OPEN') {\n      continue;\n    }\n\n    const policyDeviationId = policyDeviationIdOfRow(policyRow);\n    if (!resolvedContractId || !clauseRow.deviatingClauseId || !policyDeviationId) {\n      continue;\n    }\n\n    const policySeverityCode = firstNonEmpty([\n      policyRow.SeverityCode,\n      policyRow.severityCode,\n      clauseRow.severityCode,\n      clauseRow.severityDisplay\n    ]);\n    const policySeverityDisplay =\n      severityLookupMap[normalizeToken(policySeverityCode)] ||\n      clauseRow.severityDisplay ||\n      humanizeCode(policySeverityCode);\n    const changeRequestSummary = firstNonEmpty([\n      policyRow.ChangeRequestSummary,\n      policyRow.changeRequestSummary,\n      policyRow.Issue,\n      policyRow.issue,\n      policyRow.RuleDescription,\n      policyRow.ruleDescription,\n      clauseRow.deviationSummary\n    ]);\n    const insightPriorityLevel = initActionPriorityLevelFromSeverity(policySeverityCode || policySeverityDisplay);\n    if (!insightPriorityLevel) {\n      continue;\n    }\n\n    const viewOptionsPayload = {\n      contractId: resolvedContractId,\n      contractNumber: resolvedContractNumber,\n      intent: resolvedIntent,\n      BuyOrSell: resolvedBuyOrSell,\n      deviatingClauseId: clauseRow.deviatingClauseId,\n      policyDeviationId,\n      clauseTitle: clauseRow.clauseTitle,\n      action: 'ViewOptions'\n    };\n    const viewOptionsPayloadJson = JSON.stringify(viewOptionsPayload);\n    const viewOptionsInvokeCommand = \"ora.Invoke('SendAgentCommandNoRefresh',\" + viewOptionsPayloadJson + \")\";\n\n    initActionPolicyDeviationRows.push({\n      contractId: resolvedContractId,\n      contractNumber: resolvedContractNumber,\n      intent: resolvedIntent,\n      BuyOrSell: resolvedBuyOrSell,\n      deviatingClauseId: clauseRow.deviatingClauseId,\n      policyDeviationId,\n      clauseTitle: clauseRow.clauseTitle,\n      severityCode: policySeverityCode,\n      severityDisplay: policySeverityDisplay,\n      badgeText: policySeverityDisplay,\n      priority: priorityFromSeverity(policySeverityCode),\n      status: String(policyRow.Status || policyRow.status || '').trim(),\n      changeRequestSummary,\n      issueNumber: String(policyRow.IssueNumber || policyRow.issueNumber || '').trim(),\n      viewOptionsPayload,\n      viewOptionsPayloadJson,\n      viewOptionsInvokeCommand,\n      viewOptionsCommand: viewOptionsInvokeCommand,\n      insightTitle: clauseRow.clauseTitle,\n      insightActionText: 'View Options',\n      insightFollowUpCommand: viewOptionsInvokeCommand,\n      insightPriority: true,\n      insightPriorityLevel\n    });\n  }\n}\n\nconst subtitleSource = {\n  BuyOrSell: String(contract.BuyOrSell || fallbackBuyOrSell).trim(),\n  PartyName: String(contract.PartyName || '').trim(),\n  Assignee: String(contract.Assignee || '').trim(),\n  TermsAuthoringPartyMeaning: String(contract.TermsAuthoringPartyMeaning || contract.AuthoringPartyMeaning || '').trim(),\n  ContractTermsSourceMeaning: String(contract.ContractTermsSourceMeaning || '').trim(),\n  AssignedDate: String(contract.AssignedDate || '').trim()\n};\n\nconst result = {\n  contractId: resolvedContractId,\n  contractNumber: resolvedContractNumber,\n  count: rows.length,\n  rows,\n  initDisplayRows,\n  initDisplayTableRows,\n  initDisplaySummaryRows,\n  initDisplayLlmRows,\n  initActionPolicyDeviationRows,\n  contractSubtitleSource: subtitleSource,\n  emptyState: rows.length === 0 ? 'No clause deviations were returned for this contract.' : ''\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "5"
          },
          "code": "NORMALIZE_CLAUSE_DEVIATIONS",
