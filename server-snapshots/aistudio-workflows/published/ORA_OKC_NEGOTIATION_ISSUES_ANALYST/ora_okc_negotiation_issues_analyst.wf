              "id": "1776762555907_caseExpression",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$nodes.PARSE_ACTION_CONTEXT.$output.result.action === \"ViewDeviations\" && (($context.$nodes.NORMALIZE_POLICY_DEVIATION_MESSAGES.$output.result || {}).autoViewRecommendationsEligible === true) ? \"AutoViewRecommendations\" : \"ShowPolicyDeviations\"}}"
