        {
          "id": "1779012800004",
          "code": "GET_CONTRACT_DOCUMENTS_FOR_INIT_SUBTITLE",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Get Contract Documents For Init Subtitle",
            "businessObjectCode": "ORA_CX_CONTRACTS_CONTRACTDETAIL",
            "functionName": "getContractDocuments"
          },
          "inputs": [
            {
              "id": "1779012800004_contractId",
              "name": "contractId",
              "type": "string",
              "value": "{{$context.$nodes.PARSE_APP_CONTEXT.$output.result.contractId}}"
            }
          ],
          "outcomes": {
