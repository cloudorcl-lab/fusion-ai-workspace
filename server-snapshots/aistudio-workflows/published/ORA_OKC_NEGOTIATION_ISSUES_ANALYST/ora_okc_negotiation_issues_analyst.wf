          "metadata": {
            "name": "Build Implement Recommendation Payload",
            "returnType": "object",
            "sourceCode": "const action = (($context.$nodes.PARSE_ACTION_CONTEXT.$output || {}).result) || {};\nconst userContextRaw = ($context.$app || {}).$OraUserContext;\n\nfunction compact(value) {\n  return String(value || '').trim();\n}\n\nfunction parseIfJson(value) {\n  if (value && typeof value === 'object') {\n    return value;\n  }\n  if (typeof value !== 'string') {\n    return null;\n  }\n  const trimmed = value.trim();\n  if (!trimmed) {\n    return null;\n  }\n  try {\n    return JSON.parse(trimmed);\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction asArray(value) {\n  if (Array.isArray(value)) {\n    return value;\n  }\n  const parsed = parseIfJson(value);\n  return Array.isArray(parsed) ? parsed : [];\n}\n\nfunction asObject(value) {\n  const parsed = parseIfJson(value);\n  if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {\n    return parsed;\n  }\n  if (value && typeof value === 'object' && !Array.isArray(value)) {\n    return value;\n  }\n  return {};\n}\n\nfunction pickFirstNonEmpty(obj, keys) {\n  let i = 0;\n  for (i = 0; i < keys.length; i += 1) {\n    const value = compact((obj || {})[keys[i]]);\n    if (value) {\n      return value;\n    }\n  }\n  return '';\n}\n\nfunction extractImplementedBy(raw) {\n  const parsed = parseIfJson(raw);\n  if (parsed && typeof parsed === 'object') {\n    const preferred = pickFirstNonEmpty(parsed, [\n      'userName',\n      'username',\n      'UserName',\n      'userLogin',\n      'login',\n      'LoginName',\n      'userId',\n      'personNumber',\n      'email'\n    ]);\n    if (preferred) {\n      return preferred;\n    }\n  }\n  const text = compact(raw);\n  if (!text || text.charAt(0) === '{') {\n    return 'current.user';\n  }\n  return text;\n}\n\nfunction normalizeTargets(rawTargets) {\n  const sourceRows = asArray(rawTargets);\n  const out = [];\n  const seen = {};\n  let i = 0;\n  for (i = 0; i < sourceRows.length; i += 1) {\n    const row = sourceRows[i];\n    let policyDeviationId = '';\n    let recommendationId = '';\n    if (row && typeof row === 'object' && !Array.isArray(row)) {\n      const obj = asObject(row);\n      policyDeviationId = compact(obj.policyDeviationId || obj.PolicyDeviationId || obj.deviationId);\n      recommendationId = compact(obj.recommendationId || obj.RecommendationId || obj.id);\n    } else {\n      const split = compact(row).split(/[|:.]/);\n      if (split.length > 1) {\n        policyDeviationId = compact(split[0]);\n        recommendationId = compact(split[1]);\n      }\n    }\n    if (!policyDeviationId || !recommendationId) {\n      continue;\n    }\n    const key = policyDeviationId + '|' + recommendationId;\n    if (seen[key]) {\n      continue;\n    }\n    seen[key] = true;\n    out.push({ policyDeviationId, recommendationId });\n  }\n  return out;\n}\n\nfunction encodeBase64Utf8(value) {\n  const text = String(value || '');\n  if (!text) {\n    return '';\n  }\n  if (typeof TextEncoder !== 'undefined' && typeof btoa === 'function') {\n    const bytes = new TextEncoder().encode(text);\n    let binary = '';\n    let i = 0;\n    for (i = 0; i < bytes.length; i += 1) {\n      binary += String.fromCharCode(bytes[i]);\n    }\n    return btoa(binary);\n  }\n  if (typeof btoa === 'function') {\n    return btoa(unescape(encodeURIComponent(text)));\n  }\n  return text;\n}\n\nconst contractId = compact(action.contractId || action.ContractId);\nconst deviatingClauseId = compact(action.deviatingClauseId || action.deviationClauseId || action.DeviatingClauseId);\nconst implementationTargets = normalizeTargets(action.implementationTargets || action.recommendationTargets || action.targets);\nconst implementedBy = extractImplementedBy(userContextRaw);\nconst clauseTitle = compact(action.clauseTitle || action.ClauseTitle) || 'Clause';\nconst originalClauseText = compact(action.originalClauseText || action.OriginalClauseText);\nconst proposedClauseText = compact(\n  action.proposedClauseText ||\n  action.ProposedClauseText ||\n  action.generatedProposedClauseText ||\n  action.newValue ||\n  action.value\n);\nconst clauseTextBase64 = proposedClauseText ? encodeBase64Utf8(proposedClauseText) : '';\nconst batchPayload = [];\n\nif (contractId && deviatingClauseId) {\n  let i = 0;\n  for (i = 0; i < implementationTargets.length; i += 1) {\n    const target = implementationTargets[i] || {};\n    const policyDeviationId = compact(target.policyDeviationId);\n    const recommendationId = compact(target.recommendationId);\n    if (!policyDeviationId || !recommendationId) {\n      continue;\n    }\n    const recommendationPath =\n      '/contracts/' + encodeURIComponent(contractId) +\n      '/child/ContractDeviatingClauses/' + encodeURIComponent(deviatingClauseId) +\n      '/child/ContractPolicyDeviation/' + encodeURIComponent(policyDeviationId) +\n      '/child/ContractPolicyRecommendation/' + encodeURIComponent(recommendationId);\n    batchPayload.push({\n      id: 'markRecommendationImplemented_' + String(i + 1),\n      path: recommendationPath,\n      operation: 'upsert',\n      payload: {\n        RecImplementedFlag: 'Y',\n        RecImplementedBy: implementedBy\n      }\n    });\n  }\n\n  const deviatingClausePath =\n    '/contracts/' + encodeURIComponent(contractId) +\n    '/child/ContractDeviatingClauses/' + encodeURIComponent(deviatingClauseId);\n  const clausePayload = { Status: 'COMPLETED' };\n  if (proposedClauseText) {\n    clausePayload.ProposedClauseText = proposedClauseText;\n  }\n  batchPayload.push({\n    id: 'markDeviatingClauseCompletedAfterReviewAccept',\n    path: deviatingClausePath,\n    operation: 'upsert',\n    payload: clausePayload\n  });\n}\n\nconst ready = batchPayload.length > 0;\nconst clauseTextUpdateReady = Boolean(contractId && clauseTitle && clauseTextBase64);\n\nconst result = {\n  status: ready ? 'ready' : 'skipped',\n  action: 'ImplementReviewedClause',\n  contractId,\n  deviatingClauseId,\n  clauseTitle,\n  originalClauseText,\n  proposedClauseText,\n  clauseTextBase64,\n  clauseTextUpdateReady,\n  implementationTargets,\n  implementedBy,\n  batchPayload,\n  updateCount: batchPayload.length,\n  note: ready\n    ? 'Prepared recommendation implementation updates, clause completion update, proposed clause text update, and clause text by title update inputs.'\n    : 'Missing contractId or deviatingClauseId for implementation updates.'\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776762555911"
          },
          "code": "BUILD_IMPLEMENT_RECOMMENDATION_PAYLOAD",
          "id": "1776762555903",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
