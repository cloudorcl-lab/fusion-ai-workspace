            "returnType": "string",
            "sourceCode": "let hint = $context?.$app?.$OraMessageHint;\nif (hint === \"InitDisplay\" || hint === \"Summary\" || hint == null) hint = \"Init\";\nreturn hint;"
          },
          "outcomes": {
