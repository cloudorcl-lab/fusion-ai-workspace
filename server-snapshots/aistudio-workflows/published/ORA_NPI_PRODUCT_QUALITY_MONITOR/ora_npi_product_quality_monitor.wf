          "convergenceTargetId": "1770717223181",
          "id": "1760830109365",
          "inputs": [
            {
              "id": "1770679467162_1",
              "name": "dynamicFilter",
              "type": "string",
              "value": "{{$context.$nodes.CREATEITEMLIST.$output.result.itemSearchParams}}"
            }
          ],
          "outputSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [],\n        \"properties\": {\n          \"ChangeNotice\": {\n            \"type\": \"string\"\n          },\n          \"ChangeId\": {\n            \"type\": \"number\"\n          },\n          \"ChangeOrganizationId\": {\n            \"type\": \"number\"\n          },\n          \"BaseChangeType\": {\n            \"type\": \"string\"\n          },\n          \"ChangeTypeName\": {\n            \"type\": \"string\"\n          },\n          \"ChangeName\": {\n            \"type\": \"string\"\n          },\n          \"ChangeDescription\": {\n            \"type\": \"string\"\n          },\n          \"ChangeStatusCodeValue\": {\n            \"type\": \"string\"\n          },\n          \"ChangeStatusTypeValue\": {\n            \"type\": \"string\"\n          },\n          \"ChangeStatusType\": {\n            \"type\": \"string\"\n          },\n          \"ChangeAssignedTo\": {\n            \"type\": \"string\"\n          },\n          \"ChangeRequestedBy\": {\n            \"type\": \"string\"\n          },\n          \"ChangePriorityValue\": {\n            \"type\": \"string\"\n          },\n          \"ChangeReasonValue\": {\n            \"type\": \"string\"\n          },\n \"ItemNumber\": {\n            \"type\": \"string\"\n          },\n \"ItemDescription\": {\n            \"type\": \"string\"\n          },\n \"ItemId\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "errorNodeId": "1771252422989",
            "name": "CreateItemList",
            "returnType": "object",
            "sourceCode": "var orgId = $context.$nodes.GETBILLSEQID.$output.items[0].OrganizationId;\nvar items = $context.$nodes.GETALLCOMPONENTSFORITEM.$output.items;\nvar csv = \"\";\nfor (var i = 0; i < items.length; i++) {\nvar id = items[i] && items[i].ComponentItemId;\nif (!id) continue;\nif (csv.length > 0) csv += \",\";\ncsv +=id;\n}\n\nconst filterValues = {\nitemList: `${csv}`,\nitemSearchParams:`ItemId in  (${csv}) AND ChangeLineOrganizationId=${orgId} AND BaseChangeType in ('PR','CA')&fields=ChangeNotice,ChangeId,ChangeOrganizationId,BaseChangeType,ChangeTypeName,ChangeName,ChangeDescription,ChangeStatusCodeValue,ChangeStatusTypeValue,ChangeStatusType,ChangeAssignedTo,ChangeRequestedBy,ChangePriorityValue,ChangeReasonValue,ItemNumber,ItemDescription,ItemId&onlyData=true`\n};\nreturn filterValues ;"
          },
          "outcomes": {
            "success": "1760830109365"
          },
          "code": "CREATEITEMLIST",
          "convergenceTargetId": "1760830109365",
          "id": "1760830026454",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
