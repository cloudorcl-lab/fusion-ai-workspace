          "metadata": {
            "errorNodeId": "1771252422989",
            "name": "GetDynamicFilter",
            "returnType": "object",
            "sourceCode": "const appContext=$context.$triggers.REST.$input.OraAppContext;\nconst values = appContext.split(':');\nlet [itemId,orgCode] = values;\nif(!itemId && !orgId){\nthrow new Error(\"Item or Org not found in context\");\n}\nconst filterValues = {\nitemId: `${itemId}`,\norgCode: `${orgCode}`,\nitemSearchParams:`ItemId=${itemId} and OrganizationCode='${orgCode}'&fields=BillSequenceId,OrganizationId,ItemId,ItemNumber&onlyData=true`\n};\nreturn filterValues ;"
          },
          "outcomes": {
            "success": "1760829762359"
          },
          "code": "GETDYNAMICFILTER",
          "id": "1770673757299",
          "inputs": [],
