          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"ComponentItemId\": {\n            \"type\": \"number\"\n          },\n          \"ComponentItemNumber\": {\n            \"type\": \"string\"\n          },\n          \"@context\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"key\": {\n                \"type\": \"string\"\n              }\n            },\n            \"required\": [\"key\"],\n            \"additionalProperties\": false\n          }\n        },\n        \"required\": [\"ComponentItemId\", \"ComponentItemNumber\", \"@context\"],\n        \"additionalProperties\": false\n      }\n    },\n    \"count\": {\n      \"type\": \"integer\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"integer\"\n    },\n    \"offset\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": [\"items\", \"count\", \"hasMore\", \"limit\", \"offset\"],\n  \"additionalProperties\": false\n}",
          "type": "BO_FUNCTION"
        },
