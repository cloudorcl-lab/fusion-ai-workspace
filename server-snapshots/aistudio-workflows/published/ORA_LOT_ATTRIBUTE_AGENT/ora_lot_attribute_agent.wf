{
  "workflowId": "300000327004234",
  "workflowCode": "ORA_LOT_ATTRIBUTE_AGENT",
  "name": "Lot Attribute Agent",
  "description": "AI Agent for managing lot attribute maintenance. This can do following operations\n\n1. Inquire lot attributes -\tFetch attributes for a given lot, item and org\n2. Update lot attributes -  Update set of attributes for a given lot, item and org",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
