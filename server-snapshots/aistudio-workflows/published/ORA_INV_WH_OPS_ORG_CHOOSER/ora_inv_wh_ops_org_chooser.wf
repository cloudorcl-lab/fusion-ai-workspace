        },
        {
          "metadata": {
            "name": "ExtractUserInput"
          },
          "outcomes": {
            "success": "1772026917213"
          },
          "code": "EXTRACTUSERINPUT",
          "id": "1772026481665",
          "inputs": [
            {
              "id": "1772026481666_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an intent extraction agent.\n\nRead the user message from:\n{{$context.$system.$inputContext.message}} OR\n{{$context.$system.$inputMessage}} OR\n{{$context.$triggers.REST.$input.message}}\n\nYour task:\n1. Determine whether the user wants to CHANGE or SET an organization.\n2. If the message contains phrases like:\n   - \"change organization\"\n   - \"set organization\"\n   - \"switch organization\"\n   - \"change org\"\n   - \"set org\"\n   - \"switch org\"\n   - \"organization to <value>\"\nThen treat it as an organization change request.\n\nRules:\n- If organization change intent is detected, set:\n  ChangeOrg to Y\n- Otherwise, set:\n  ChangeOrg to N\n\n3. If ChangeOrg = \"Y\":\n   - Extract the organization code (example: M1, US1, IN02, Vision Operations, Seattle Manufacturing)\n   - Store it in variable OrganizationCode ONLY if an explicit organization value is present (e.g., \"to M1\", \"as M1\", \"organization M1\"). If no organization value is mentioned, do NOT guess or infer. In that case, leave OrganizationCode empty or null.\n\nOutput:\nReturn only the following variables:\n- ChangeOrg\n- OrganizationCode\n\nDo not add explanations or extra text."
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"OrganizationCode\": {\n            \"type\": \"string\"\n        },\n        \"ChangeOrg\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "PrepareQueryString",
            "returnType": "string",
            "sourceCode": "let organizationCode = $context.$nodes.EXTRACTUSERINPUT.$output.OrganizationCode;\nlet query = '';\n\nif (organizationCode) {\n    query = `q=UPPER(OrganizationName) like UPPER('${organizationCode}') or UPPER(OrganizationCode) = UPPER('${organizationCode}')`;\n}\n\nreturn query;"
          },
          "outcomes": {
            "success": "1770887027275"
          },
          "code": "PREPAREQUERYSTRING",
          "id": "1772026917213",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
