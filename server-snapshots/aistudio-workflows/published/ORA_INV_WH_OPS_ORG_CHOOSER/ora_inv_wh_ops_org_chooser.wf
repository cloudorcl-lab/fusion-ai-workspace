          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"description\": \"\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"OrganizationId\",\n          \"OrganizationCode\",\n          \"OrganizationName\",\n          \"ProjectReferenceEnabled\",\n          \"LotUOMConversionEnabledFlag\",\n          \"AutoCreateLotUOMConversionFlag\"\n        ],\n        \"properties\": {\n          \"OrganizationId\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"OrganizationCode\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"OrganizationName\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"ProjectReferenceEnabled\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"TrackCountryOfOriginFlag\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"LotUOMConversionEnabledFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"AutoCreateLotUOMConversionFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"TimezoneCode\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"advancedInvParams\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"items\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"required\": [],\n                  \"properties\": {}\n                }\n              },\n              \"count\": {\n                \"type\": \"number\"\n              },\n              \"hasMore\": {\n                \"type\": \"boolean\"\n    