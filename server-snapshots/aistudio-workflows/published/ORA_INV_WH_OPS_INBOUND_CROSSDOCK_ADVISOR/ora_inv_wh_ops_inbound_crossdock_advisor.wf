            "y": 5872
          }
        },
        {
          "metadata": {
            "name": "Gather Orders Information",
            "returnType": "string",
            "sourceCode": "let result = \"\";\ntry {\n  // Safely access items array from upstream node output\n  const items = $context.$nodes?.LINES_TO_PUTAWAY_SUGGESTIONS?.$output?.items || [];\n\n  if (items.length > 0) {\n    // Map to extract CrossDockOrderNumber, filter out falsy values\n    const orderNumbers = items\n      .map(item => item.CrossDockOrderNumber)\n      .filter(order => order) // Remove falsy values\n      .map(order => `'${order}'`); // Wrap each order in single quotes\n\n    if (orderNumbers.length > 0) {\n      // Construct query string\n      result = `q=Order in (${orderNumbers.join(\",\")})`;\n    }\n  }\n} catch (error) {\n  // On error, return empty string as per return type\n  result = \"\";\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1771400180685"
          },
          "code": "GATHER_ORDERS_INFORMATION",
          "id": "1771400713551",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 5930,
            "y": 6094
          }
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_SCM_INVENTORYM_SHIPMENTLINESINVENTORYWAREHOUSEMANAGEMENTWORKSPACE",
            "functionName": "getByRawQuery",
            "processJson": true,
            "name": "Shipment Lines Records Fetch"
          },
          "outcomes": {
            "success": "1771402782176"
          },
          "code": "SHIPMENT_LINES_RECORDS_FETCH",
          "id": "1771400180685",
          "inputs": [
            {
              "id": "1771400674276_1",
              "name": "QUERY_PARAM",
              "type": "string",
              "value": "{{$context.$nodes.GATHER_ORDERS_INFORMATION.$output.result}}"
