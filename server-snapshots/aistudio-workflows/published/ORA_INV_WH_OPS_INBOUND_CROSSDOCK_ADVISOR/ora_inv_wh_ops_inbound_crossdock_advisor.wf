          "id": "1771580555963",
          "inputs": [
            {
              "id": "1771580582488_1",
              "name": "P_ORGANIZATION_ID",
              "type": "string",
              "value": "{{$context.$nodes.GET_PUTAWAY_LINE.$output.ToOrganizationId}}"
            },
            {
              "id": "1771580582489_2",
