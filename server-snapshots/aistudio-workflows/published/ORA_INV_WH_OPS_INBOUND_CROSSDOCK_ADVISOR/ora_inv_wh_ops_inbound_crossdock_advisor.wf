        {
          "metadata": {
            "name": "Prepare Code for lines to putaway",
            "returnType": "string",
            "sourceCode": "const data = $context.$nodes.LINES_TO_PUTAWAY.$output;\n\nconst uniqueTransactionIds = Array.from(\n  new Set(data.items.map(item => item.TransactionId))\n);\nconst sqlString = `q=ParentTransactionId in (${uniqueTransactionIds.join(',')})`;\nreturn sqlString;"
          },
          "outcomes": {
            "success": "1771390028653"
