        {
          "metadata": {
            "name": "Prepare Putaway Payload",
            "returnType": "object",
            "sourceCode": "let item = $context.$nodes.GET_ITEM_DETAIL?.$output.items[0];\n\nlet putaway =  $context.$nodes.GET_PUTAWAY_LINE?.$output;\n \nlet shippingParameter = $context.$nodes.GET_SHIPPING_PARAMETER_REST?.$output ;\n\nlet subinventories = $context.$nodes.GET_STORAGE_SUBINVENTORIES_?.$output.items[0] ;\n\n\nlet orderLineRecord = $context.$nodes.SHIPMENTLINEREQUESTRECORD?.$output.items[0] ;\n\n\nconst availableQuantity = Number(putaway?.AvailableQuantity ?? 0);\nconst orderLineQuantity = Number(\n  orderLineRecord?.RequestedQuantity ??\n    orderLineRecord?.SourceRequestedQuantity ??\n    orderLineRecord?.PendingQuantity ??\n    0\n);\nconst transactionQuantity =\n  orderLineQuantity > 0\n    ? Math.min(orderLineQuantity, availableQuantity)\n    : availableQuantity;\n\n\n/**\n * {\n  \"LotNumber\" : \"PDSCV1352079\",\n  }\n */\nlet newGeneratedLot = $context.$nodes.GENERATE_NEW_LOT?.$output;\n\n\n/**\n * {\n *   \"StartSerialNumber\" : \"WLS-10000416\",\n *   \"EndSerialNumber\" : \"WLS-10000425\"\n * }\n */\nlet newGeneratedSerial = $context.$nodes.GENERATE_SERIAL_NUMBERS?.$output;\n\nconst lotControlledCodes = new Set([\"2\"]);\nconst serialControlledCodes = new Set([\"2\", \"5\"]);\n\n\n\n\nlet putawayPayload = {\n  ItemRevision: putaway.ItemRevision ?? null,\n  ReceiptSourceCode: putaway.ReceiptSourceCode ?? \"VENDOR\",\n  SourceDocumentCode: putaway.SourceDocumentCode ?? \"PO\",\n  OrganizationId: putaway.ToOrganizationId ?? putaway.OrganizationId ?? null,\n  ParentTransactionId: putaway.ParentTransactionId ?? null,\n  ShipmentHeaderId: putaway.ShipmentHeaderId ?? null,\n  ShipmentLineId: putaway.ShipmentLineId ?? null,\n  POHeaderId: putaway.POHeaderId ?? null,\n  POLineId: putaway.POLineId ?? null,\n  POLineLocationId: putaway.POLineLocationId ?? null,\n  PODistributionId: putaway.PODistributionId ?? null,\n  VendorId: putaway.VendorId ?? null,\n  VendorSiteId: putaway.VendorSiteId ?? null,\n  ItemId: putaway.ItemId ?? null,\n  ItemDescription: putaway.ItemDescription ?? null,\n  TransactionType: \"DELIVER\",\n  Quantity: transactionQuantity || null,\n  UOMCode: putaway.UOMCode ?? null,\n  TransactionDate: new Date().toISOString(),\n  EmployeeId: putaway.EmployeeId ?? null,\n  Subinventory:\n    shippingParameter?.StagingSubinventory ??\n    subinventories?.[0]?.SubinventoryName ??\n    null,\n  LocatorId: shippingParameter?.StagingLocatorId, \n  InterfaceSourceCode: \"INV_WH_OPS_AGENTIC_APP\",\n  InsertAndProcessFlag: true,\n  LPNId: null\n};\n\nif($context.$variables.aiCrossDockModeEnabled){\n putawayPayload.CrossDockSuggestionId= $context.$triggers.REST.$input.parameters?.PutAwaySuggestionId??$context.$triggers.REST.$input.parameters?.putAwaySuggestionId;\n}\n\nconst lotNumber = newGeneratedLot?.LotNumber ?? null;\nconst serialRange = newGeneratedSerial ?? null;\n\nconst isLotControlled = lotControlledCodes.has(String(item?.LotControlCode ?? \"\"));\nconst isSerialControlled = serialControlledCodes.has(\n  String(item?.SerialNumberControlCode ?? \"\")\n);\n\nif (isLotControlled && isSerialControlled) {\n  putawayPayload.lotSerialItemLots = [\n    {\n      LotNumber: lotNumber,\n      TransactionQuantity: transactionQuantity || null,\n      lotSerialItemSerials: serialRange\n        ? [\n            {\n              FromSerialNumber: serialRange.StartSerialNumber ?? null,\n              ToSerialNumber: serialRange.EndSerialNumber ?? null,\n            },\n          ]\n        : [],\n    },\n  ];\n} else if (isLotControlled) {\n  putawayPayload.lotItemLots = [\n    {\n      LotNumber: lotNumber,\n      TransactionQuantity: transactionQuantity || null,\n      SecondaryTransactionQuantity: null,\n    },\n  ];\n} else if (isSerialControlled) {\n  putawayPayload.serialItemSerials = serialRange\n    ? [\n        {\n          FromSerialNumber: serialRange.StartSerialNumber ?? null,\n          ToSerialNumber: serialRange.EndSerialNumber ?? null,\n        },\n      ]\n    : [];\n}\n\nconst shipmentLine = {\n  ShipmentLine: orderLineRecord.ShipmentLine ?? null,\n  Subinventory: putawayPayload.Subinventory ?? null,\n  Locator: putaway.Locator ?? null,\n  ItemRevision: putaway.ItemRevision ?? null,\n  ShippedQuantity: transactionQuantity,\n};\n\nif (isLotControlled) {\n  shipmentLine.Lot = lotNumber;\n}\n\nif (isSerialControlled) {\n  shipmentLine.serials = serialRange\n    ? [\n        {\n          FromSerialNumber: serialRange.StartSerialNumber ?? null,\n          ToSerialNumber: serialRange.EndSerialNumber ?? null,\n        },\n      ]\n    : [];\n}\n\nconst shipmentAssignPayload = {\n  ActionCode: \"updateAndStage\",\n  shipmentLines: [shipmentLine],\n};\n\nlet returnData = {\n  putawayPayload,\n  shipmentAssignPayload,\n};\n\nreturn returnData;"
          },
