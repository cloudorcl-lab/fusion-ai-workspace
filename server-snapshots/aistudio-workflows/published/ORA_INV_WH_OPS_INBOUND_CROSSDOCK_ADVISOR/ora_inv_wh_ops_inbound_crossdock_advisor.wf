        {
          "metadata": {
            "name": "Prepare Query Data",
            "returnType": "object",
            "sourceCode": "let payload = {};\n\nlet itemId= $context.$nodes.GET_PUTAWAY_LINE.$output?.ItemId; \nlet organizationId = $context.$nodes.GET_PUTAWAY_LINE.$output?.ToOrganizationId;\nlet itemNumber = $context.$nodes.GET_PUTAWAY_LINE.$output?.ItemNumber;\n\nlet crossDockOrderNumber = $context.$triggers.REST.$input.parameters.crossDockOrderNumber;\n\nlet crossDockLineNumber= $context.$triggers.REST.$input.parameters.crossDockLineNumber;\n\npayload.itemQuery= `q=ItemId=${itemId} and OrganizationId=${organizationId} and ItemNumber = '${itemNumber}'`;\n\npayload.subinventoriesQuery= `q=OrganizationId=${organizationId }`;\n\npayload.shipmentsLinesRequest= `q=Order='${crossDockOrderNumber}' and OrderLine='${crossDockLineNumber}'`;\n\npayload.essRequestBody = {\n    \"jobDefinitionId\": \"JobDefinition://oracle/apps/ess/scm/receiving/receiptsInterface/transactions/processor/GeneratePutAwaySuggestionJob\",\n    \"product\": \"RCV\",\n    \"application\": \"FscmEss\",\n    \"requestParameters\": [\n        {\n            \"name\": \"submit.argument1\",\n            \"paramType\": \"STRING\",\n            \"value\": organizationId\n        }\n    ]\n};\n\npayload.advancedParametersReqBody = {\n  \"parts\": [\n    {\n      \"id\": \"org_advanced_params\",\n      \"path\": `/inventoryAccessibleOrganizations?q=OrganizationId='${organizationId}'&expand=advancedInvParams&onlyData=true`,\n      \"operation\": \"get\"\n    }\n]\n}\n\nreturn payload;"
          },
          "outcomes": {
            "success": "1771564599075"
          },
