          "id": "1771390028653",
          "inputs": [
            {
              "id": "1771390069581_1",
              "name": "QUERY_PARAM",
              "value": "{{$context.$nodes.PREPARE_CODE_FOR_LINES_TO_PUTAWAY.$output.result}}",
              "required": true
