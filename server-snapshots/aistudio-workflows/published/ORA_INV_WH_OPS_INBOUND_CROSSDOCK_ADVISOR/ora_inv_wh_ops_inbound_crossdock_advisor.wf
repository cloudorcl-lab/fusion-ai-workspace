        {
          "metadata": {
            "name": "Cross Dock Completion Prompt",
            "returnType": "string",
            "sourceCode": "let putawayResponse = $context.$nodes.PUTAWAY_RECORD.$output;\nlet updateShipmentLineRes = $context.$nodes.UPDATE_SHIPMENT_LINE.$output;\n\n\nlet parameters = {\n  crossDockOrderNumber: $context.$triggers.REST.$input.parameters.crossDockOrderNumber,\n  crossDockLineNumber: $context.$triggers.REST.$input.parameters.crossDockLineNumber\n};\n\n\nlet prompt = `\n\nYou are an AI agent invoked after a Cross Dock transaction has been successfully completed.\n\nBelow are the system responses:\n\n<putawayRecordResponse>\n${JSON.stringify(putawayResponse)}\n</putawayRecordResponse>\n\n<shipmentLineUpdateResponse>\n${JSON.stringify(updateShipmentLineRes)}\n</shipmentLineUpdateResponse>\n\n<crossDockTargetDocumentDetails>\n${JSON.stringify(parameters)}\n</crossDockTargetDocumentDetails>\n\n==================================================\nCRITICAL OUTPUT INSTRUCTION\n==================================================\n\nYou MUST generate PURE MARKDOWN TEXT ONLY.\n\n⚠️ DO NOT:\n- Generate any widgets\n- Generate any record components\n- Generate structured UI components\n- Generate HTML\n- Generate JSON\n- Generate tables in proprietary widget format\n- Wrap content inside code blocks\n- Return a single consolidated widget\n\nReturn plain Markdown text only.\n\n==================================================\nREQUIRED MARKDOWN STRUCTURE\n==================================================\n\n1️⃣ Top Success Message (bold)\n\nExample format:\n**Cross Dock completed successfully for Order <OrderNumber>.**\n\n==================================================\nReturn ONLY the Markdown content.\n==================================================\n\n`;\n\nreturn prompt;"
          },
          "outcomes": {
            "success": "end"
          },
