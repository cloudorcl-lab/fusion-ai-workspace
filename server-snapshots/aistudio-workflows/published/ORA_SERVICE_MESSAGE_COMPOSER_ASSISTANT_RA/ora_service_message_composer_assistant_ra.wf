        {
          "metadata": {
            "name": "createComposeContext",
            "returnType": "string",
            "sourceCode": "const srAttributesRaw = $context.$nodes.SR_ATTRIBUTES.$output;\n\n\nconst srAttributes = srAttributesRaw && srAttributesRaw.content\n  ? srAttributesRaw.content\n  : srAttributesRaw || {};   \n\nconst messagesResponse = $context.$nodes.GET_ALL_CONTEXT.$output;\n\nconst result = {};\n\n\nfor (const key in srAttributes) {\n  if (key !== \"@context\") {\n    result[key] = srAttributes[key];\n  }\n}\n\n\nconst items = messagesResponse?.items || [];\n\nconst flattenedMessages = items.map(m => {\n  const sender = m?.MessageTypeCd\n    ? (m.MessageTypeCd.includes(\"CUSTOMER\") ? \"Customer\" :\n       m.MessageTypeCd.includes(\"RESPONSE\") ? \"Agent\" : \"System\")\n    : \"Unknown\";\n\n  const timestamp = m?.CreationDate || \"\";\n\n  const text = m?.MessageContent\n    ? m.MessageContent.replace(/<[^>]+>/g, \"\").trim()\n    : \"\";\n\n  return `${sender}${timestamp ? \" (\" + timestamp + \")\" : \"\"}: ${text}`;\n});\n\nresult.Messages = flattenedMessages;\nresult.MessageCount = flattenedMessages.length;\n\nreturn JSON.stringify(result, null, 2);"
          },
          "outcomes": {
            "success": "1766403236712"
          },
          "code": "CREATECOMPOSECONTEXT",
          "id": "1764154541415",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
