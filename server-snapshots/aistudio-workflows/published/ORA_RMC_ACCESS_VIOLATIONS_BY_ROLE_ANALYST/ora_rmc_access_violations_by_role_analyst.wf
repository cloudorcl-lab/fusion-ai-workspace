        {
          "metadata": {
            "businessObjectCode": "ORA_GRC_OTHER_DESCRIPTIONCLOB",
            "functionName": "get_announcements-DescriptionClob",
            "name": "Get Role Summary From Clob"
          },
          "outcomes": {
            "success": "1768424117391"
          },
          "code": "GET_ROLE_SUMMARY_FROM_CLOB",
          "id": "1767123970802",
          "inputs": [
            {
              "id": "1767124002112_1",
              "name": "announcements_Id",
              "type": "string",
              "value": "894871897531002"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Get Top 5 Role Violations",
            "returnType": "object",
            "sourceCode": "var data = $context.$nodes.GET_ROLE_SUMMARY_FROM_CLOB.$output;\nif (!data) return null;\nvar parsedData = data;\nif (typeof data === 'string') {\n    try {\n        parsedData = JSON.parse(data);\n    } catch (e) {\n        var trimmed = data.trim();\n        if ((trimmed.startsWith('\"') && trimmed.endsWith('\"')) || (trimmed.startsWith(\"'\") && trimmed.endsWith(\"'\"))) {\n            try { parsedData = JSON.parse(trimmed.slice(1, -1)); } catch (e2) { return null; }\n        } else { return null; }\n    }\n}\nif (!Array.isArray(parsedData)) return null;\nvar top5 = parsedData.sort(function(a, b) { return b.NumUsers - a.NumUsers; }).slice(0, 5);\n\nvar abbrMap = { 'Accounts': 'AP', 'Payable': '', 'Payables': '', 'Application': 'App', 'Implementation': 'Impl', 'Human': 'HR', 'Resource': '', 'Resources': '', 'Receivable': 'AR', 'Receivables': '' };\nvar abbreviate = function(role) {\n    var words = role.split(' ');\n    if (words.length === 1) return role;\n    var result = [];\n    for (var i = 0; i < words.length; i++) {\n        var w = words[i];\n        if (i < 2 && abbrMap[w] !== undefined) {\n            if (abbrMap[w] !== '') result.push(abbrMap[w]);\n        } else {\n            result.push(w);\n        }\n    }\n    return result.join(' ');\n};\n\nvar chartLabels = [];\nvar chartValues = [];\nvar labelLegend = [];\nfor (var i = 0; i < top5.length; i++) {\n    var r = top5[i];\n    var abbr = abbreviate(r.Role);\n    chartLabels.push(abbr);\n    chartValues.push(r.NumUsers);\n    labelLegend.push(abbr + ' = ' + r.Role);\n}\n\nvar chartWidgetJson = JSON.stringify({\n    title: 'Top 5 Roles with Intra-role Violations',\n    patternId: 'chartWidget',\n    description: 'User count by role. Legend: ' + labelLegend.join(' | '),\n    properties: {\n        type: 'bar',\n        data: {\n            labels: chartLabels,\n            datasets: [{ label: 'Number of Users', data: chartValues }]\n        }\n    }\n});\n\nvar dataForLLM = [];\nfor (var j = 0; j < top5.length; j++) {\n    var role = top5[j];\n    dataForLLM.push({\n        Abbr: abbreviate(role.Role),\n        Role: role.Role,\n        Controls: role.Controls,\n        NumUsers: role.NumUsers,\n        NumControls: role.NumControls\n    });\n}\n\nvar result = { data: top5, chartWidgetJson: chartWidgetJson, dataForLLM: JSON.stringify(dataForLLM), _debug: { totalRoles: parsedData.length, top5Count: top5.length } };\nreturn result;"
          },
          "outcomes": {
            "success": "1763407352667"
          },
          "code": "GET_TOP_5_ROLE_VIOLATIONS",
          "id": "1767124014945",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
