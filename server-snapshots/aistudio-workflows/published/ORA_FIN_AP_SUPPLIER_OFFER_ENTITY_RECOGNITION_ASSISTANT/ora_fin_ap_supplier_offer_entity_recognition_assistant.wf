          "inputs": [],
          "type": "ADD"
        },
        {
          "metadata": {
            "name": "Calculate Supplier Count",
            "returnType": "number",
            "sourceCode": "let suppliersString = $context.$nodes.FIN_AP_CODE_PARSE_SUPPLIERS.$output.result;\n//if (typeof suppliersString !== \"string\") return suppliersString.length;\n\n//let cleanedString = suppliersString.replace(/^\\(\\d+\\)/, \"\");\n\n//let suppliers = JSON.parse(cleanedString);\n\n//return suppliers.length;\n\nreturn suppliersString.length"
          },
          "outcomes": {
            "success": "1767722405878"
          },
          "code": "FIN_AP_CODE_CALCULATE_SUPPLIER_COUNT",
          "id": "1767724542886",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Parse Suppliers",
            "returnType": "array",
            "sourceCode": "let matches = $context.$nodes.FIN_AP_BO_NER_RESOLVE.$output.matches\n\nlet suppliers = []\n\n\nmatches.forEach(match => {\n\n     match.entities.forEach(entity => {\n           let supplier = {\n             supplierName: entity['name'],\n             id: entity['id'],\n             score: entity['score']\n           }\n          suppliers.push(supplier)\n      })\n});\n\n//if(suppliers.length === 1){\n//let returnData = []\n//returnData.push(suppliers[0])\n //return returnData;\n//} else if(suppliers.length === 0){\n//return suppliers;\n//}\n\nlet sortedSuppliers = suppliers.sort((a,b) => b['score']-a['score']);\n\n//if(sortedSuppliers[0].score - sortedSuppliers[1].score >= 10){\n// let returnData = []\n//returnData.push(sortedSuppliers[0])\n//return returnData\n//}\n\n// its important that we create an empty array and add objects into that, else the return is considered a string in Code Node\n//let returnData = []\n\n//sortedSuppliers.forEach(supplier => {\n//returnData.push(supplier)\n//})\n\n//return returnData;\n\n//return suppliers;\nreturn sortedSuppliers.slice(0,7);"
          },
          "outcomes": {
            "success": "1767724542886"
          },
          "code": "FIN_AP_CODE_PARSE_SUPPLIERS",
          "id": "1767725810852",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.25
              },
              "code": "ORA_LLM_MODEL_PROVIDER_CERT_BASIC_LLAMA_3_3_70B",
              "model": "ORA_LLM_MODEL_GPT_OSS_120B",
              "modelName": "GPT OSS 120B (Basic)",
              "provider": "CERT_BASIC"
            },
            "name": "User Query Generator"
          },
          "outcomes": {
            "success": "1767780340496"
          },
          "code": "FIN_AP_LLM_USER_QUERY_GENERATOR",
          "id": "1767780110942",
          "inputs": [
            {
              "id": "1767780110943_1",
              "name": "prompt",
              "type": "string",
              "value": "You are ERP Functional Consultant tasked with understanding the suppliers in user query\n\nYou were able to associate user query with more than one supplier and now need further clarification from user on which supplier the user wants\n\nGenerat a text to check which supplier is the one user refers to\n\nAssociated suppliers: {{$context.$nodes.FIN_AP_CODE_PARSE_SUPPLIERS.$output.result}}\n\nIn response text.\nAsk which supplier is meant \nShow each supplier as a bulleted list in html format\nDo not show the score or supplier id in the result"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"textResponse\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Format User Query",
            "returnType": "object",
            "sourceCode": "let textData = {\ntype: \"text\",\n\t\tcontent:[$context.$nodes.FIN_AP_LLM_USER_QUERY_GENERATOR.$output.textResponse ],\n\t\tsequence:1 ,\n                formatHint:\"\"\n}\nlet ambigousSuppliers = $context.$nodes.FIN_AP_CODE_PARSE_SUPPLIERS.$output.result.map(supplier => supplier.supplierName)\nlet returnData = {\nstatus: \"ambiguous\",\ndata: [textData],\nambigousSuppliers: ambigousSuppliers\n}\n\nreturn returnData;"
          },
          "outcomes": {
            "success": "1771571369357"
          },
          "code": "FIN_AP_CODE_FORMAT_USER_QUERY",
          "id": "1767780340496",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Identified Supplier",
            "returnType": "object",
            "sourceCode": "let suppliers = $context.$variables.suppliers\n\nlet returnData = {\nstatus:\"success\",\nsuppliers: suppliers\n}\n\nreturn returnData;"
          },
          "outcomes": {
            "success": "1767723164134"
          },
          "code": "FIN_AP_CODE_IDENTIFIED_SUPPLIER",
          "convergenceTargetId": "1767723164134",
