          "code": "FIN_AP_BO_NER_RESOLVE",
          "id": "1767701180923",
          "inputs": [
            {
              "id": "1768459202784_1",
              "name": "payload",
              "type": "string",
              "value": "{{$context.$nodes.FIN_AP_CODE_GENERATE_PAYLOAD.$output.result}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Generate Payload",
            "returnType": "object",
            "sourceCode": "let unidentifiedSuppliers = $context.$triggers.REST.$input.unidentifiedSuppliers; \nlet data ={\n    input: $context.$system.$inputMessage ,\n    useCaseKey: \"SupplierOfferAgent\",\n    keywords: unidentifiedSuppliers ,\n    limit: 20\n}\n\nreturn data;"
          },
          "outcomes": {
            "success": "1767701180923"
          },
          "code": "FIN_AP_CODE_GENERATE_PAYLOAD",
          "id": "1767701210740",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Check Suppliers"
          },
          "outcomes": {
            "true": "1767780110942",
            "false": "1767722749273"
          },
          "code": "FIN_AP_IF_CONDITION_CHECK_SUPPLIERS",
          "convergenceTargetId": "1767723164134",
          "id": "1767722405878",
          "inputs": [
            {
              "id": "1767722405879_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.FIN_AP_CODE_PARSE_SUPPLIERS.$output.result.length>1}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Add new supplier",
            "returnType": "array",
            "sourceCode": "//let suppliers = $context.$variables.suppliers === null ? [] : $context.$variables.suppliers ;\nlet suppliers = $context.$variables.suppliers || []\n\nlet newSuppliersString = $context.$nodes.FIN_AP_CODE_PARSE_SUPPLIERS.$output.result\nlet newSuppliers = Array.isArray(newSuppliersString) ? newSuppliersString : JSON.parse(newSuppliersString)\n\nif(newSuppliers.length ==1){\n suppliers.push(newSuppliers[0]['supplierName'])\n}\n\nreturn suppliers;"
          },
          "outcomes": {
            "success": "1767722943936"
          },
          "code": "FIN_AP_CODE_ADD_SUPPLIER",
          "id": "1767722749273",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Assign Supplier"
          },
          "outcomes": {
            "success": "1767781157054"
          },
