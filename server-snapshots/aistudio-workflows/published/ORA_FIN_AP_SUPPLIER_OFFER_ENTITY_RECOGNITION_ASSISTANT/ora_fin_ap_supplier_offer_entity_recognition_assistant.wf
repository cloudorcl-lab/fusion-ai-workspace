          "id": "1767722943936",
          "inputs": [
            {
              "id": "1767722951763",
              "name": "suppliers",
              "type": "array",
              "value": "{{$context.$nodes.FIN_AP_CODE_ADD_SUPPLIER.$output.result}}"
            }
