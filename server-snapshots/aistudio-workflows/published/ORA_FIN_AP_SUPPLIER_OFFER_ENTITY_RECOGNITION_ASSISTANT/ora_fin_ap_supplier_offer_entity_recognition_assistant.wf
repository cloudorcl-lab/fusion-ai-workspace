{
  "workflowId": "100002355226956",
  "workflowCode": "ORA_FIN_AP_SUPPLIER_OFFER_ENTITY_RECOGNITION_ASSISTANT",
  "name": "Supplier Offer Named Entity Recognition Assistant",
  "description": "Resolves the named entities present in user queries into ERP specific entities like supplier, business unit, legal entity, etc.",
  "specification": {
    "dataPipeline": {
      "pipelineNodes": [
