        {
          "metadata": {
            "name": "Retrieve Program Id from Context",
            "returnType": "string",
            "sourceCode": "let result = \"\";\ntry {\n  let appInput = $context.$triggers.REST?.$input?.OraAppContext || $context.$app?.$OraAppContext || \"\";\n  appInput = decodeURIComponent(appInput);\n  const pairs = appInput.split(\",\");\n  const data = pairs.reduce((acc, pair) => {\n    const [key, value] = pair.split(\"=\");\n    if (key && value) {\n      acc[key.trim()] = value.trim();\n    }\n    return acc;\n  }, {});\n  if (data.programId) {\n    result = data.programId;\n  } else {\n    result = \"\";\n  }\n} catch (error) {\n  result = \"\";\n}\nreturn result;"
          },
          "outcomes": {
            "success": "1779244698483"
          },
          "code": "RETRIEVE_PROGRAM_ID_FROM_CONTEXT",
          "id": "1765704209499",
          "inputs": [],
