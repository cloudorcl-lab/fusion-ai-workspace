        },
        {
          "id": "1779243428007",
          "code": "REFINE_PROGRAM_DATA",
          "type": "CODE",
          "metadata": {
            "name": "Refine Program Data",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  // Access the first program item safely\n  const firstProgram = $context.$nodes?.GET_PROGRAM_DETAILS?.$output?.items?.[0] || null;\n\n  if (firstProgram) {\n    // Find attribute with key 'product'\n    const targetProductAttr = firstProgram.programAttributes?.items?.find(attr => attr.key === \"product\");\n    // Find attribute with key 'ownedproduct'\n    const ownedProductAttr = firstProgram.programAttributes?.items?.find(attr => attr.key === \"ownedproduct\");\n // Find attribute with key 'programType'\n    const programTypeAttr = firstProgram.programAttributes?.items?.find(attr => attr.key === \"programType\");\n\n    result = {\n      ProgramId: firstProgram.id || null,\n      ProgramName: firstProgram.name || null,\n      ProgramObjective: firstProgram.objective || null,\n      ProgramType: programTypeAttr ? programTypeAttr.value : null,\n      TargetProductId: targetProductAttr ? targetProductAttr.value : null,\n      TargetProductName: targetProductAttr ? targetProductAttr.displayValue : null,\n      OwnedProductId: ownedProductAttr ? ownedProductAttr.value : null,\n      OwnedProductName: ownedProductAttr ? ownedProductAttr.displayValue : null\n    };\n  } else {\n    // No program found, return empty object\n    result = {};\n  }\n} catch (error) {\n  // On error, return empty object\n  result = {};\n}\n\ntry {\n  let appInput = $context.$triggers.REST?.$input?.OraAppContext || \"\";\n\n  const pairs = appInput.split(\",\");\n\n  const data = pairs.reduce((acc, pair) => {\n    const [key, value] = pair.split(\"=\");\n    if (key && value) {\n      acc[key.trim()] = value.trim();\n    }\n    return acc;\n  }, {});\n\n  if (data.programType) {\n    result.ProgramType = data.programType;\n  }\n} catch (error) {\n  result = \"\";\n}\nif(result.ProgramType==\"Renewal\"){\nresult.Action=\"launchRenewalTactic\";\n}else{\nresult.Action=\"launchTactic\";\n}\nreturn result;"
          },
          "diagram": {
            "x": 5426.496020259887,
            "y": 5736.41396353547
          },
          "outcomes": {
            "success": "1765704233079"
          },
