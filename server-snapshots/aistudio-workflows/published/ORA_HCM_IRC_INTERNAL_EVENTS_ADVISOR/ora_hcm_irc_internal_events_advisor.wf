          "code": "RECOMMEND_EVENT_KEYWORDS",
          "id": "1764858841561",
          "inputs": [
            {
              "id": "1764858841563_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an intelligent internal career development agent. Your sole purpose is to analyze a user's current employment details, skills and their recent job application history. Based on this data, you must generate a list of 3 to 5 highly specific, short keywords. These keywords should cover:\n\nCurrent Domain Expertise: Topics and skills related to the user's current job function (e.g., 'Python Development', 'Cloud Architecture').\n\nAspirational Skill Gaps: Topics and skills that relate to the roles the user applied for but may not fully possess yet (e.g., 'Product Strategy', 'Financial Modeling', 'Team Leadership'). Derive these gaps by comparing the current employment information details with recent job applications summary.\n\nGenerate only a comma separated list of skill keywords, without any introductory or concluding text. The keywords should be short such as the examples mentioned in the *Aspirational Skill Gaps*. \n\nCURRENT EMPLOYMENT INFORMATION:\nPosition: {{$context.$nodes.GET_EMPLOYMENT_INFO.$output.items[0].PositionName}} \nDepartment: {{$context.$nodes.GET_EMPLOYMENT_INFO.$output.items[0].DepartmentName}} \nDomain/Focus: {{$context.$nodes.GET_EMPLOYMENT_INFO.$output.items[0].JobName}} \n\nRECENT JOB APPLICATIONS SUMMARY:\n{{$context.$nodes.COLLATE_OPPORTUNITIES.$output.result}}\n\nCURRENT SKILLS:\n{{$context.$nodes.GET_SKILLS.$output.output}}"
            }
          ],
          "type": "LLM"
        },
