                {
                  "metadata": {
                    "name": "Extract Gig Details",
                    "returnType": "object",
                    "sourceCode": "const gigItems = $context.$nodes.COLLECT_GIG_DETAILS.GET_GIG_DETAILS.$output || {};\nconst gigSkills = $context.$nodes.COLLECT_GIG_DETAILS.GET_GIG_SKILLS.$output.gigSkills;\n\nconst gig = {\n    Description: gigItems.DescriptionStr,\n    Title: gigItems.Title,\n    Type: \"Gig\"\n};\n\nif (Array.isArray(gigSkills)) {\n    gig.Skills = gigSkills.map(item => item.Skills != null ? item.Skills : item.SkillName);\n}\n\nreturn gig;"
                  },
                  "outcomes": {
