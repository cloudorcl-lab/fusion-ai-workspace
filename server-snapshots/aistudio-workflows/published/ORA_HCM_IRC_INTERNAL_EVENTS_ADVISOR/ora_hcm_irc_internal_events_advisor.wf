            "returnType": "array",
            "sourceCode": "const jobArr = $context.$nodes.COLLECT_JOB_DETAILS.$output || []; \nconst gigArr = $context.$nodes.COLLECT_GIG_DETAILS.$output || []; \n\nconst gigs = gigArr.map(gig => JSON.parse(gig).result );\n\nconst jobs = jobArr.map(job => JSON.parse(job).result);\n\nvar oppArr = [...gigs,...jobs];\n \nreturn oppArr;"
          },
