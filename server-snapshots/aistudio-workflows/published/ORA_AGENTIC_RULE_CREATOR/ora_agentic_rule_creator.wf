          "outcomes": {
            "success": "1775613218649"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "name": "Validate Rule Summary",
            "returnType": "object",
            "sourceCode": "// Input variables (provided by the node runtime)\nconst ruleInstance = $context.$variables.currentRuleInstance;\nconst summaryInput = $context.$nodes.GENERATE_RULE_SUMMARY_LLM.$output;\n\n// ---------- helpers ----------\nfunction deepClone(v) {\n  return v == null ? v : JSON.parse(JSON.stringify(v));\n}\n\nfunction encodePointerSegment(seg) {\n  return String(seg).split(\"~\").join(\"~0\").split(\"/\").join(\"~1\");\n}\n\nfunction decodePointerSegment(seg) {\n  return String(seg).split(\"~1\").join(\"/\").split(\"~0\").join(\"~\");\n}\n\nfunction normalizePointer(ptr) {\n  if (typeof ptr !== \"string\" || !ptr.trim()) return null;\n  return ptr.startsWith(\"/\") ? ptr : `/${ptr}`;\n}\n\nfunction getByPointer(obj, ptr) {\n  if (ptr === \"\") return obj;\n  if (typeof ptr !== \"string\" || !ptr.startsWith(\"/\")) return undefined;\n  const parts = ptr.split(\"/\").slice(1).map(decodePointerSegment);\n  let cur = obj;\n  for (const p of parts) {\n    if (cur == null) return undefined;\n    if (Array.isArray(cur)) {\n      const i = Number(p);\n      if (!Number.isInteger(i) || i < 0 || i >= cur.length) return undefined;\n      cur = cur[i];\n    } else if (typeof cur === \"object\" && p in cur) {\n      cur = cur[p];\n    } else {\n      return undefined;\n    }\n  }\n  return cur;\n}\n\nfunction relGet(base, relPath) {\n  if (relPath === \".\" || relPath === \"\") return base;\n  if (typeof relPath !== \"string\" || !relPath.trim()) return undefined;\n  const parts = relPath.split(\"/\").filter(Boolean);\n  let cur = base;\n  for (const p of parts) {\n    if (cur == null) return undefined;\n    if (Array.isArray(cur)) {\n      const i = Number(p);\n      if (!Number.isInteger(i) || i < 0 || i >= cur.length) return undefined;\n      cur = cur[i];\n    } else if (typeof cur === \"object\" && p in cur) {\n      cur = cur[p];\n    } else {\n      return undefined;\n    }\n  }\n  return cur;\n}\n\nfunction pathExists(base, relPath) {\n  return relGet(base, relPath) !== undefined;\n}\n\nfunction isObject(v) {\n  return v && typeof v === \"object\" && !Array.isArray(v);\n}\n\nfunction collectPaths(obj, currentPath, out, maxDepth) {\n  if (maxDepth < 0 || obj == null) return;\n  if (typeof obj !== \"object\") return;\n\n  if (Array.isArray(obj)) {\n    for (let i = 0; i < obj.length; i++) {\n      const next = currentPath ? `${currentPath}/${i}` : String(i);\n      out.push(next);\n      collectPaths(obj[i], next, out, maxDepth - 1);\n    }\n    return;\n  }\n\n  for (const k of Object.keys(obj)) {\n    const next = currentPath ? `${currentPath}/${k}` : k;\n    out.push(next);\n    collectPaths(obj[k], next, out, maxDepth - 1);\n  }\n}\n\nfunction findFirstExistingPath(base, preferredPaths) {\n  for (const p of preferredPaths) {\n    if (pathExists(base, p)) return p;\n  }\n  return null;\n}\n\nfunction findPathByTailAlias(base, aliases, maxDepth = 8) {\n  if (base == null || typeof base !== \"object\") return null;\n  const all = [];\n  collectPaths(base, \"\", all, maxDepth);\n\n  const exact = all\n    .filter((p) => aliases.includes(p.split(\"/\").pop()))\n    .sort((a, b) => a.split(\"/\").length - b.split(\"/\").length);\n\n  for (const p of exact) {\n    if (pathExists(base, p)) return p;\n  }\n\n  const loose = all\n    .filter((p) => p.split(\"/\").some((s) => aliases.includes(s)))\n    .sort((a, b) => a.split(\"/\").length - b.split(\"/\").length);\n\n  for (const p of loose) {\n    if (pathExists(base, p)) return p;\n  }\n\n  return null;\n}\n\nfunction findBestRelPath(base, kind) {\n  if (base == null) return null;\n\n  if (typeof base !== \"object\") {\n    if (kind === \"attribute\" || kind === \"value\" || kind === \"message\") return \".\";\n    return null;\n  }\n\n  const kindPref = {\n    attribute: [\"criteria/attribute\", \"attribute\", \"attr\", \"field\", \"name\"],\n    operator: [\"operator\", \"value/operator\", \"op\"],\n    value: [\"value/values\", \"values\", \"value/value\", \"value\"],\n    message: [\"message/staticMessage\", \"staticMessage\", \"message\"],\n    setType: [\"value/setType\", \"setType\"],\n    rangeOperator: [\"value/rangeOperator\", \"rangeOperator\"],\n    rangeValue: [\"value/rangeValue\", \"rangeValue\"],\n    behavior: [\"value/constraintBehavior\", \"constraintBehavior\"],\n    level: [\"messageLevel\", \"level\"]\n  };\n\n  const aliases = {\n    attribute: [\"attribute\", \"attr\", \"field\", \"name\"],\n    operator: [\"operator\", \"op\"],\n    value: [\"values\", \"value\"],\n    message: [\"staticMessage\", \"message\"],\n    setType: [\"setType\"],\n    rangeOperator: [\"rangeOperator\"],\n    rangeValue: [\"rangeValue\"],\n    behavior: [\"constraintBehavior\", \"behavior\"],\n    level: [\"messageLevel\", \"level\"]\n  };\n\n  const preferred = kindPref[kind] || [];\n  const p1 = findFirstExistingPath(base, preferred);\n  if (p1) return p1;\n\n  const p2 = findPathByTailAlias(base, aliases[kind] || []);\n  if (p2) return p2;\n\n  return null;\n}\n\nfunction sortedClauseKeys(clausesObj) {\n  return Object.keys(clausesObj || {}).sort((a, b) => {\n    const na = Number((a.match(/^c(\\d+)$/) || [])[1] || 999999);\n    const nb = Number((b.match(/^c(\\d+)$/) || [])[1] || 999999);\n    return na - nb;\n  });\n}\n\nfunction detectActionType(rule) {\n  const a = rule && rule.action ? rule.action : {};\n  if (a && a.hidingAction && Array.isArray(a.hidingAction.attributes) && a.hidingAction.attributes.length) return \"hidingAction\";\n  if (a && a.messageAction) return \"messageAction\";\n  if (a && a.constraintAction && a.constraintAction.constraints && Array.isArray(a.constraintAction.constraints.items) && a.constraintAction.constraints.items.length) return \"constraintAction\";\n  if (a && a.recommendationAction && a.recommendationAction.recommendations && Array.isArray(a.recommendationAction.recommendations.items) && a.recommendationAction.recommendations.items.length) return \"recommendationAction\";\n  return \"none\";\n}\n\nfunction expectedConditionBind(i) {\n  const path1 = `/ruleCondition/conditions/items/${i}`;\n  if (getByPointer(ruleInstance, path1) !== undefined) return path1;\n\n  const path2 = `/whenConditions/${i}`;\n  if (getByPointer(ruleInstance, path2) !== undefined) return path2;\n\n  return null;\n}\n\nfunction expectedActionBind(actionType, i) {\n  if (actionType === \"hidingAction\") {\n    const p = `/action/hidingAction/attributes/${i}`;\n    return getByPointer(ruleInstance, p) !== undefined ? p : null;\n  }\n  if (actionType === \"messageAction\") {\n    const p = `/action/messageAction`;\n    return getByPointer(ruleInstance, p) !== undefined ? p : null;\n  }\n  if (actionType === \"constraintAction\") {\n    const p = `/action/constraintAction/constraints/items/${i}`;\n    return getByPointer(ruleInstance, p) !== undefined ? p : null;\n  }\n  if (actionType === \"recommendationAction\") {\n    const p = `/action/recommendationAction/recommendations/items/${i}`;\n    return getByPointer(ruleInstance, p) !== undefined ? p : null;\n  }\n  return null;\n}\n\nfunction chooseValidBind(existingBind, fallbackBind) {\n  const n = normalizePointer(existingBind);\n  if (n && getByPointer(ruleInstance, n) !== undefined) return n;\n  if (fallbackBind && getByPointer(ruleInstance, fallbackBind) !== undefined) return fallbackBind;\n  return null;\n}\n\nfunction repairSlotsForClause(boundObj, slots) {\n  if (!isObject(slots)) return {};\n  const repaired = {};\n\n  for (const [slotName, slotDef] of Object.entries(slots)) {\n    if (!isObject(slotDef)) continue;\n    const kind = slotDef.kind;\n    if (typeof kind !== \"string\" || !kind) continue;\n\n    let relPath = slotDef.relPath;\n    if (!pathExists(boundObj, relPath)) {\n      relPath = findBestRelPath(boundObj, kind);\n    }\n    if (!relPath || !pathExists(boundObj, relPath)) continue;\n\n    // Normalize current-node relPath \".\" to empty string\n    const normalizedRelPath = relPath === \".\" ? \"\" : relPath;\n\n    const out = { relPath: normalizedRelPath, kind };\n    if (typeof slotDef.dependsOn === \"string\" && slotDef.dependsOn) out.dependsOn = slotDef.dependsOn;\n    repaired[slotName] = out;\n  }\n\n  return repaired;\n}\n\nfunction repairClauseBlock(blockName, clausesObj, actionType) {\n  if (!isObject(clausesObj)) return {};\n\n  const keys = sortedClauseKeys(clausesObj);\n  const repairedArr = [];\n\n  for (let i = 0; i < keys.length; i++) {\n    const key = keys[i];\n    const clause = clausesObj[key];\n    if (!isObject(clause)) continue;\n\n    const fallbackBind =\n      blockName === \"conditions\"\n        ? expectedConditionBind(i)\n        : expectedActionBind(actionType, i);\n\n    const bindItem = chooseValidBind(clause.bindItem, fallbackBind);\n    if (!bindItem) continue;\n\n    const boundObj = getByPointer(ruleInstance, bindItem);\n    if (boundObj === undefined) continue;\n\n    const slots = repairSlotsForClause(boundObj, clause.slots);\n    if (Object.keys(slots).length === 0) continue;\n\n    repairedArr.push({\n      bindItem,\n      clauseTemplate:\n        typeof clause.clauseTemplate === \"string\" && clause.clauseTemplate.trim()\n          ? clause.clauseTemplate\n          : \"[[attr]] [[op]] [[value]]\",\n      slots\n    });\n  }\n\n  const out = {};\n  for (let i = 0; i < repairedArr.length; i++) {\n    out[`c${i + 1}`] = repairedArr[i];\n  }\n  return out;\n}\n\nfunction normalizeTemplate(template, clauseCount) {\n  let t = typeof template === \"string\" && template.trim() ? template.trim() : \"\";\n  if (!t) return t;\n\n  t = t.replace(/\\[\\[c(\\d+)\\]\\]/g, (m, n) => {\n    const num = Number(n);\n    if (num >= 1 && num <= clauseCount) return m;\n    if (clauseCount >= 1) return `[[c${Math.min(num, clauseCount)}]]`;\n    return \"\";\n  });\n\n  t = t.replace(/\\s+/g, \" \").replace(/\\s+([,.])/g, \"$1\").trim();\n  return t;\n}\n\n// ---------- main ----------\nconst summary = deepClone(summaryInput || {});\nif (!isObject(summary.conditions)) summary.conditions = { template: \"Always run this rule.\", clauses: {} };\nif (!isObject(summary.actions)) summary.actions = { template: \"\", clauses: {} };\nif (!isObject(summary.conditions.clauses)) summary.conditions.clauses = {};\nif (!isObject(summary.actions.clauses)) summary.actions.clauses = {};\n\nconst actionType = detectActionType(ruleInstance);\n\n// Repair condition clauses\nsummary.conditions.clauses = repairClauseBlock(\"conditions\", summary.conditions.clauses, actionType);\nsummary.conditions.template = normalizeTemplate(summary.conditions.template, Object.keys(summary.conditions.clauses).length);\n\n// Repair action clauses\nsummary.actions.clauses = repairClauseBlock(\"actions\", summary.actions.clauses, actionType);\nsummary.actions.template = normalizeTemplate(summary.actions.template, Object.keys(summary.actions.clauses).length);\n\n// If condition clauses are empty, enforce always-run sentence\nif (Object.keys(summary.conditions.clauses).length === 0) {\n  summary.conditions.template = \"Always run this rule.\";\n}\n\n// Optional: if action template is blank, set a type-based fallback\nif (!summary.actions.template || !summary.actions.template.trim()) {\n  if (actionType === \"constraintAction\") summary.actions.template = \"Constrain [[c1]].\";\n  else if (actionType === \"recommendationAction\") summary.actions.template = \"Recommend [[c1]].\";\n  else if (actionType === \"hidingAction\") summary.actions.template = \"Hide [[c1]].\";\n  else if (actionType === \"messageAction\") summary.actions.template = \"Message [[c1]].\";\n}\n\n// Return corrected summary payload\nreturn summary;"
          },
