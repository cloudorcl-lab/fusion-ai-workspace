        {
          "metadata": {
            "name": "Get Conditions Array",
            "returnType": "array",
            "sourceCode": "var ruleInstance = $context.$variables.currentRuleInstance || {};\nvar ruleCondition = ruleInstance.ruleCondition || {};\n\nvar conditionContainer = ruleCondition.conditions || [];\nvar conditions = Array.isArray(conditionContainer.items)\n  ? conditionContainer.items\n  : Array.isArray(conditionContainer)\n  ? conditionContainer\n  : [];\n\nvar catalog = $context.$triggers.REST.$input.attributes || {};\nif (catalog && catalog.attributes) {\n  catalog = catalog.attributes;\n}\n\nvar LEVEL_KEY_MAP = {\n  allProductFamiliesAttr: 'allProductFamilies',\n  productFamilyAttr: 'productFamily',\n  productLineAttr: 'productLine',\n  modelAttr: 'model'\n};\n\nvar attrLevelLookup = {};\n\n['configurable', 'nonConfigurable', 'system', 'account', 'user'].forEach(function (bucket) {\n  var section = catalog[bucket];\n  if (!section) { return; }\n\n  Object.keys(LEVEL_KEY_MAP).forEach(function (levelKey) {\n    var levelName = LEVEL_KEY_MAP[levelKey];\n    var list = section[levelKey];\n    if (!Array.isArray(list)) { return; }\n\n    list.forEach(function (attr) {\n      if (!attr || !attr.variableName) { return; }\n      var key = String(attr.variableName).trim().toLowerCase();\n      if (!key) { return; }\n      attrLevelLookup[key] = levelName;\n    });\n  });\n});\n\nconditions.forEach(function (cond) {\n  if (!cond || !cond.criteria || !cond.criteria.attribute) { return; }\n  var key = String(cond.criteria.attribute).trim().toLowerCase();\n  var level = attrLevelLookup[key];\n  if (level) {\n    cond.level = level;\n  }\n});\n\nreturn conditions;"
          },
