"Before\", \"OnOrBefore\"] : [\"LessThan\", \"LessThanEqualTo\"];\n\n  var lower = normalizeActionOp(srcVal.operator, lowerOps) || lowerOps[0];\n  var upper = normalizeActionOp(srcVal.rangeOperator, upperOps) || upperOps[0];\n\n  out.value.values = normalizeArrayValues(spec, meta, srcVal.values, false, meta.attrVar);\n  out.value.operator = lower;\n  out.value.rangeOperator = upper;\n  var upperVals = normalizeArrayValues(spec, meta, srcVal.rangeValue, false, meta.attrVar);\n  out.value.rangeValue = upperVals[0];\n\n  return out;\n}\n\nfunction normalizeConstraintAction(constraintAction) {\n  if (!constraintAction || !constraintAction.constraints || !Array.isArray(constraintAction.constraints.items)) return null;\n  var outItems = [];\n  constraintAction.constraints.items.forEach(function (it) {\n    var cleaned = normalizeConstraintItem(it);\n    if (cleaned) outItems.push(cleaned);\n  });\n  if (!outItems.length) return null;\n  return { constraints: { items: outItems } };\n}\n\nfunction normalizeRecommendationItem(item) {\n  if (!item || !item.attribute) return null;\n\n  var originalAttr = item.attribute;\n  var meta = getMeta(originalAttr);\n  if (!meta) {\n    trackRemovedAttribute(originalAttr);\n    return null;\n  }\n\n  var spec = actionTypeSpec(meta);\n  if (!spec) {\n    trackRemovedAttribute(originalAttr);\n    return null;\n  }\n\n  var srcVal = item.value && typeof item.value === \"object\" ? item.value : {};\n  var setType = srcVal.setType;\n  if (setType !== \"None\" && setType !== \"Set\" && setType !== \"ForcedSet\") setType = \"None\";\n\n  var values;\n  if (spec.isMenu) values = cleanSelectableValues(meta, srcVal.values, meta.attrVar);\n  else if (spec.key === \"TextField:Text\") values = normalizeArrayValues(spec, meta, srcVal.values, true, meta.attrVar);\n  else values = normalizeArrayValues(spec, meta, srcVal.values, false, meta.attrVar);\n\n  if (!values || !values.length) values = [defaultForSpec(spec, meta)];\n\n  var out = {\n    attribute: meta.attrVar,\n    value: {\n      setType: setType,\n      valueType: \"Simple\",\n      values: values\n    },\n    message: {\n      messageType: \"Simple\",\n      staticMessage: normalizeStaticMessage(item.message && item.message.staticMessage)\n    }\n  };\n\n  if (item.priority !== undefined && item.priority !== null) {\n    var p = Number(item.priority);\n    if (isFinite(p) && p >= 1 && Math.floor(p) === p) out.priority = p;\n  }\n\n  return out;\n}\n\nfunction normalizeRecommendationAction(recommendationAction) {\n  if (!recommendationAction || !recommendationAction.recommendations || !Array.isArray(recommendationAction.recommendations.items)) return null;\n  var outItems = [];\n  recommendationAction.recommendations.items.forEach(function (it) {\n    var cleaned = normalizeRecommendationItem(it);\n    if (cleaned) outItems.push(cleaned);\n  });\n  if (!outItems.length) return null;\n  return { recommendations: { items: outItems } };\n}\n\n// Enforce exactly one action subtype\nvar srcAction = rulePayload.action || {};\nvar candidates = {\n  hidingAction: normalizeHidingAction(srcAction.hidingAction),\n  messageAction: normalizeMessageAction(srcAction.messageAction),\n  constraintAction: normalizeConstraintAction(srcAction.constraintAction),\n  recommendationAction: normalizeRecommendationAction(srcAction.recommendationAction)\n};\n\nvar presenceOrder = [];\nif (srcAction.hidingAction) presenceOrder.push(\"hidingAction\");\nif (srcAction.messageAction) presenceOrder.push(\"messageAction\");\nif (srcAction.constraintAction) presenceOrder.push(\"constraintAction\");\nif (srcAction.recommendationAction) presenceOrder.push(\"recommendationAction\");\nif (!presenceOrder.length) presenceOrder = [\"constraintAction\", \"recommendationAction\", \"hidingAction\", \"messageAction\"];\n\nvar chosen = null;\nfor (var i = 0; i < presenceOrder.length; i++) {\n  var t = presenceOrder[i];\n  if (candidates[t]) {\n    chosen = t;\n    break;\n  }\n}\n\nvar actionOut = 