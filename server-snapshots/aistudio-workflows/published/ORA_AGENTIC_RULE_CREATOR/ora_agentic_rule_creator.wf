            "y": 5468
          },
          "code": "INTENT_CLASSIFIER",
          "id": "1774305080429",
          "inputs": [
            {
              "id": "1774305080429_prompt",
              "name": "prompt",
              "type": "string",
              "value": "You are the intent classifier for a multi-turn CPQ rule authoring assistant. \nDecide whether the latest user turn is asking to create a brand-new rule, to modify the existing draft rule, or to ask for clarification/other conversation.\n\nContext\n-----------\nFull chat transcript:\n{{$context.$system.$chatHistory}}\n\nLatest user turn (already included in the transcript, repeated for convenience):\n{{$context.$system.$inputMessage}}\n\nCurrent draft rule JSON (empty or null when no rule exists yet):\n{{$context.$variables.currentRuleInstance}}\n\nInstructions\n-----------\n1. If the user wants to start a new rule OR explicitly abandons the old one, emit intent `\"createNew\"`.\n   - Any mention of “create another rule”, “start over”, “new rule”, etc. counts as createNew.\n   - When no draft rule exists and the user describes a rule, treat it as createNew.\n\n2. If the user wants to change, add to, remove from, or otherwise refine the current draft rule, emit intent `\"editExisting\"`.\n   - Assume the draft is editable only when `currentRule` is non-empty.\n   - Minor corrections (“also add…”, “change the action…”, “make it red instead of blue”, etc.) must be editExisting.\n\n3. Output only a compact JSON object with two fields:\n   {\n     \"intent\": \"<createNew|editExisting>\",\n     \"reason\": \"<one-sentence rationale referencing key phrases; stay under 200 characters>\"\n   }\n\n5. Do not include markdown, comments, or extra text."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"intent\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"createNew\",\n        \"editExisting\",\n        \"clarify\"\n      ]\n    },\n    \"reason\": {\n      \"type\": \"string\",\n      \"maxLength\": 200,\n      \"description\": \"One-sentence rationale referencing key phrases\"\n    }\n  },\n  \"required\": [\n    \"intent\",\n    \"reason\"\n  ],\n  \"additionalProperties\": false\n}",
          "type": "LLM"
        },
