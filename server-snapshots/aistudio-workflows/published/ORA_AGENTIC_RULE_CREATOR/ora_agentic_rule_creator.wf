          "restConfigJson": "{\n    \"currentRuleInstance\": {},\n    \"ruleVariableNameList\": [],\n    \"attributes\": {\n        \"configurable\": {\n            \"allProductFamiliesAttr\": [],\n            \"productFamilyAttr\": [],\n            \"productLineAttr\": [],\n            \"modelAttr\": [\n                {\n                    \"variableName\": \"vColor\",\n                    \"label\": \"Vehicle Color\",\n                    \"inputTypeCode\": \"SingleSelectMenu\",\n                    \"menuItems\": [\n                        {\n                            \"itemValue\": \"black\"\n                        },\n                        {\n                            \"itemValue\": \"white\"\n                        }\n                    ]\n                },\n                {\n                    \"variableName\": \"vInterior\",\n                    \"label\": \"Vehicle Interior\",\n                    \"inputTypeCode\": \"SingleSelectMenu\",\n                    \"menuItems\": [\n                        {\n                            \"itemValue\": \"black\"\n                        },\n                        {\n                            \"itemValue\": \"white\"\n                        }\n                    ]\n                }\n            ]\n        }\n    },\n    \"productFamily\": \"visionVehicles\",\n    \"productLine\": \"consumerVehicles\",\n    \"model\": \"sUV\"\n}",
