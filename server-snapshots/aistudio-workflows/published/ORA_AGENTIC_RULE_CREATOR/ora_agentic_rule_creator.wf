            "sourceCode": "var existingNames = $context.$triggers.REST.$input.ruleVariableNameList || [];\nvar currentRule = $context.$variables.currentRuleInstance || {};\nvar originalName = String(currentRule.variableName || '');\nvar nameParts = originalName.match(/^(.*?)(?:_(\\d+))?$/) || ['', originalName, null];\nvar baseName = nameParts[1];\nvar startingSuffix = nameParts[2] ? parseInt(nameParts[2], 10) : 0;\n\nfunction escapeRegExp(str) {\n  return str.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n}\n\nvar pattern = new RegExp('^' + escapeRegExp(baseName) + '(?:_(\\\\d+))?$');\nvar usedSuffixes = Object.create(null);\n\nfor (var i = 0; i < existingNames.length; i++) {\n  var name = String(existingNames[i]);\n  var match = name.match(pattern);\n  if (match) {\n    var suffix = match[1] ? parseInt(match[1], 10) : 0;\n    usedSuffixes[suffix] = true;\n  }\n}\n\nvar nextSuffix = startingSuffix;\nif (usedSuffixes[nextSuffix]) {\n  nextSuffix = nextSuffix === 0 ? 1 : nextSuffix + 1;\n  while (usedSuffixes[nextSuffix]) {\n    nextSuffix++;\n  }\n}\n\nvar uniqueName = nextSuffix === 0 ? baseName : baseName + '_' + nextSuffix;\n\ncurrentRule.variableName = uniqueName;\n\nreturn currentRule;"
