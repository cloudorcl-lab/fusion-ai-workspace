            "name": "Create Rule Output",
            "returnType": "object",
            "sourceCode": "var rulePayload = $context.$variables.currentRuleInstance;\nvar summary = $context.$nodes.VALIDATE_RULE_SUMMARY.$output.result;\n\nvar simOut = (($context.$nodes.RULE_SIMILARITY_CHECK || {}).$output);\nvar raw = simOut && (simOut.output !== undefined ? simOut.output : simOut);\nif (raw && typeof raw === \"string\") {\n  try { raw = JSON.parse(raw); } catch (e) { raw = {}; }\n}\nvar tiersObj = (raw && raw.result) ? raw.result : (raw || {});\nvar tier1 = Array.isArray(tiersObj.tier1) ? tiersObj.tier1 : [];\nvar tier1_1 = Array.isArray(tiersObj.tier1_1) ? tiersObj.tier1_1 : [];\nvar tier2 = Array.isArray(tiersObj.tier2) ? tiersObj.tier2 : [];\nvar tier3 = Array.isArray(tiersObj.tier3) ? tiersObj.tier3 : [];\n\nvar updateRule = null;\nif (tier1.length > 0) {\n  updateRule = tier1[0];\n} else if (tier1_1.length > 0) {\n  updateRule = tier1_1[0];\n} else if (tier2.length > 0) {\n  updateRule = tier2[0];\n} else if (tier3.length > 0) {\n  updateRule = tier3[0];\n}\nvar hasUpdateOption = !!updateRule;\n\nfunction asText(value) {\n  if (Array.isArray(value)) {\n    return value.join(\", \");\n  }\n  if (value && typeof value === \"object\") {\n    if (Array.isArray(value.values)) {\n      return value.values.join(\", \");\n    }\n    if (value.label) {\n      return String(value.label);\n    }\n    if (value.value !== undefined && value.value !== null) {\n      return asText(value.value);\n    }\n    if (value.sentence) {\n      return String(value.sentence);\n    }\n  }\n  return value == null ? \"\" : String(value);\n}\n\nfunction buildCreatePanelPayload(rulePayload, summary) {\n  var suggestedRuleName = asText(summary && summary.suggestedRuleName);\n  var actionSentence = asText(summary && summary.actions && summary.actions.sentence);\n  var conditionSentence = asText(summary && summary.conditions && summary.conditions.sentence);\n  var ruleDescription = asText(rulePayload && rulePayload.ruleDescription);\n  var ruleName = asText(rulePayload && rulePayload.ruleName);\n\n  var items = {\n    title: \"New Rule based on Prompt\",\n    suggestedRuleName: suggestedRuleName,\n    action: actionSentence,\n    condition: conditionSentence,\n    summary: summary\n  };\n\n  return {\n    primary: {\n      style: \"\",\n      sections: [{\n        style: \"section\",\n        title: \"Review and Create\",\n        primaryText: suggestedRuleName,\n        secondaryText: ruleDescription || ruleName,\n        items: items,\n        actions: [{\n          id: \"save_rule\",\n          icon: \"oj-ux-ico-save\",\n          label: \"Save Rule\"\n        }]\n      }]\n    },\n    secondary: {\n      style: \"\",\n      sections: []\n    },\n    rawData: {\n      rulePayload: rulePayload,\n      summary: summary\n    }\n  };\n}\n\nfunction buildUpdatePanelPayload(updateRule, tiersObj) {\n  var updateName = asText(updateRule && updateRule.name);\n  var updateDesc = asText(updateRule && (updateRule.description || updateRule.ruleDescription));\n\n  var items = {\n    updateRule: updateRule,\n    title: \"Review existing rule\",\n    existingRule: updateName,\n    action: \"\",\n    condition: \"\"\n  };\n\n  return {\n    primary: {\n      style: \"\",\n      sections: [{\n        style: \"section\",\n        title: \"Review and Update\",\n        primaryText: updateName,\n        secondaryText: updateDesc,\n        items: items,\n        actions: [{\n          id: \"edit_rule\",\n          icon: \"oj-ux-ico-edit\",\n          label: \"Edit\"\n        }]\n      }]\n    },\n    secondary: {\n      style: \"\",\n      sections: []\n    },\n    rawData: {\n      updateRule: updateRule,\n      similarRules: tiersObj\n    }\n  };\n}\n\nvar messages = [];\n\nmessages.push({\n  type: \"chip\",\n  id: \"create_rule\",\n  primaryText: \"Review and Create\",\n  secondaryText: (rulePayload && rulePayload.name) ? rulePayload.name : \"\",\n  icon: \"oj-ux-ico-file-view-details\",\n  headerText: hasUpdateOption\n    ? \"Certainly. Here are some options to consider\"\n    : \"Certainly. Here’s a new rule based on your prompt\",\n  payload: buildCreatePanelPayload(rulePayload, summary)\n});\n\nif (hasUpdateOption) {\n  messages.push({\n    type: \"chip\",\n    id: \"update_rule\",\n    primaryText: \"Review and Update\",\n    secondaryText: updateRule && updateRule.name ? updateRule.name : \"\",\n    icon: \"oj-ux-ico-edit\",\n    headerText: \"You can also review and update an existing rule that is similar\",\n    payload: buildUpdatePanelPayload(updateRule, tiersObj)\n  });\n}\n\nreturn { messages: messages };"
          },
