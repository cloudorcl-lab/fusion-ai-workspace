          "restConfigJson": "{\n  \"message\": \"When color is black, interior is white\",\n  \"currentRuleInstance\": \"\",\n  \"ruleVariableNameList\": [\n    \"allPFLevelAjax\",\n    \"setSystemJSON\",\n    \"allPFLevel\",\n    \"setSystemConfigModelPath\"\n  ],\n  \"attributes\": {\n    \"system\": {\n      \"productFamilyAttr\": [],\n      \"productLineAttr\": [],\n      \"modelAttr\": [],\n      \"allProductFamiliesAttr\": [\n        {\n          \"variableName\": \"_config_operation_context\",\n          \"inputTypeCode\": \"SingleSelectMenu\",\n          \"menuItems\": [\n            {\n              \"itemValue\": \"modify_asset\",\n              \"id\": 3023136086,\n              \"itemText\": \"modify_asset\"\n            },\n            {\n              \"itemValue\": \"new\",\n              \"id\": 3023136084,\n              \"itemText\": \"new\"\n            },\n            {\n              \"itemValue\": \"reconfigure\",\n              \"id\": 3023136085,\n              \"itemText\": \"reconfigure\"\n            },\n            {\n              \"itemValue\": \"search_flow\",\n              \"id\": 3023136087,\n              \"itemText\": \"search_flow\"\n            }\n          ],\n          \"label\": \"Config Operation Context\"\n        },\n        {\n          \"variableName\": \"_system_config_model_path\",\n          \"inputTypeCode\": \"TextField\",\n          \"dataType\": \"Text\",\n          \"label\": \"System Config Model Path\"\n        },\n        {\n          \"variableName\": \"_price_book_var_name\",\n          \"inputTypeCode\": \"SingleSelectMenu\",\n          \"menuItems\": [\n            {\n              \"itemValue\": \"_default_price_book\",\n              \"itemText\": \"Base Price [_default_price_book]\"\n            },\n            {\n              \"itemValue\": \"pricebook1\",\n              \"itemText\": \"Pricebook 1: Multiplier of Base Price\"\n            },\n            {\n              \"itemValue\": \"pricebook2\",