          "type": "CODE",
          "metadata": {
            "name": "Construct Invalid Instruction Message",
            "returnType": "string",
            "sourceCode": "var baseMessage = \"The rule you are trying to create is invalid either because the provided description is incomplete (missing required actions or conditions) or because the referenced attributes do not exist in this hierarchy. Please try again with a valid rule instruction.\";\n\nvar validateOut = (($context.$nodes.VALIDATE_RULE || {}).$output || {}).result || {};\nvar validateErr = validateOut.error || {};\n\nvar improperOut = (($context.$nodes.CHECK_IMPROPER_ATTRIBUTES_LLM || {}).$output || {});\nvar improperErr = (improperOut.error) ? improperOut.error : (((improperOut.result || {}).error) || {});\n\nfunction q(s) {\n  return '\"' + String(s) + '\"';\n}\n\nfunction joinWithAnd(list) {\n  if (!list.length) return \"\";\n  if (list.length === 1) return list[0];\n  if (list.length === 2) return list[0] + \" and \" + list[1];\n  return list.slice(0, -1).join(\", \") + \", and \" + list[list.length - 1];\n}\n\nfunction normalizeAttrList(arr) {\n  var out = [];\n  var seen = {};\n  (Array.isArray(arr) ? arr : []).forEach(function (a) {\n    if (a === undefined || a === null) return;\n    var s = String(a).trim();\n    if (!s) return;\n    var k = s.toLowerCase();\n    if (!seen[k]) {\n      seen[k] = true;\n      out.push(s);\n    }\n  });\n  return out;\n}\n\nfunction mergeValueEntries(aVals, bVals) {\n  var byAttr = {};\n\n  function addEntries(vals) {\n    (Array.isArray(vals) ? vals : []).forEach(function (entry) {\n      if (!entry) return;\n      var attr = entry.attribute;\n      var list = entry.valueList;\n      if (attr === undefined || attr === null) return;\n\n      var attrText = String(attr).trim();\n      if (!attrText) return;\n\n      var attrKey = attrText.toLowerCase();\n      if (!byAttr[attrKey]) {\n        byAttr[attrKey] = { attribute: attrText, valuesMap: {} };\n      }\n\n      (Array.isArray(list) ? list : []).forEach(function (v) {\n        if (v === undefined || v === null) return;\n        var s = String(v).trim();\n        if (!s) return;\n        var vk = s.toLowerCase();\n        if (!byAttr[attrKey].valuesMap[vk]) {\n          byAttr[attrKey].valuesMap[vk] = s;\n        }\n      });\n    });\n  }\n\n  addEntries(aVals);\n  addEntries(bVals);\n\n  var out = [];\n  Object.keys(byAttr).forEach(function (k) {\n    var rec = byAttr[k];\n    var valueList = Object.keys(rec.valuesMap).map(function (vk) { return rec.valuesMap[vk]; });\n    if (valueList.length) {\n      out.push({\n        attribute: rec.attribute,\n        valueList: valueList\n      });\n    }\n  });\n\n  return out;\n}\n\nvar attrs = normalizeAttrList((validateErr.attributes || []).concat(improperErr.attributes || []));\nvar vals = mergeValueEntries(validateErr.values || [], improperErr.values || []);\n\nvar lines = [baseMessage];\n\nif (attrs.length) {\n  var attrList = joinWithAnd(attrs.map(q));\n  lines.push(\"Could not find the attributes \" + attrList + \" in this hierarchy.\");\n}\n\nif (vals.length) {\n  var valueChunks = [];\n\n  vals.forEach(function (entry) {\n    if (!entry) return;\n    var attribute = entry.attribute;\n    var valueList = Array.isArray(entry.valueList) ? entry.valueList : [];\n    if (!attribute || !valueList.length) return;\n\n    var quotedValues = joinWithAnd(valueList.map(q));\n    valueChunks.push(quotedValues + \" in the attribute \" + q(attribute));\n  });\n\n  if (valueChunks.length) {\n    lines.push(\"Could not find the values \" + joinWithAnd(valueChunks) + \".\");\n  }\n}\n\nreturn lines.join(\"\\n\\n\");"
          },
