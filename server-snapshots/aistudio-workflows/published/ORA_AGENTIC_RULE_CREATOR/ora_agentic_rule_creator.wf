        {
          "metadata": {
            "name": "Validate Rule",
            "returnType": "object",
            "sourceCode": "var attrs = $context.$variables.attributes || $context.$triggers.REST.$input.attributes || {};\nvar sourceRule = $context.$variables.currentRuleInstance;\n\n// currentRuleInstance is expected to be an object; defensive fallback if string is passed.\nvar rulePayload = {};\nif (sourceRule && typeof sourceRule === \"object\") {\n  rulePayload = JSON.parse(JSON.stringify(sourceRule));\n} else if (typeof sourceRule === \"string\") {\n  try {\n    rulePayload = JSON.parse(sourceRule);\n  } catch (e) {\n    rulePayload = {};\n  }\n}\n\n// -------------------------\n// Removed-data tracking\n// -------------------------\nvar removedAttributesMap = {}; // { attrName: true }\nvar removedValuesMap = {};     // { attrName: {valueLower: originalValue} }\n\nfunction trackRemovedAttribute(attrName) {\n  if (attrName === undefined || attrName === null) return;\n  var s = String(attrName).trim();\n  if (!s) return;\n  removedAttributesMap[s] = true;\n}\n\nfunction trackRemovedValues(attrName, valueList) {\n  if (attrName === undefined || attrName === null) return;\n  var attr = String(attrName).trim();\n  if (!attr || !Array.isArray(valueList) || !valueList.length) return;\n\n  if (!removedValuesMap[attr]) removedValuesMap[attr] = {};\n  valueList.forEach(function (v) {\n    if (v === undefined || v === null) return;\n    var s = String(v).trim();\n    if (!s) return;\n    var k = s.toLowerCase();\n    if (!removedValuesMap[attr][k]) removedValuesMap[attr][k] = s;\n  });\n}\n\n// -------------------------\n// Helpers\n// -------------------------\nfunction uniqueStrings(arr) {\n  var seen = {};\n  var out = [];\n  (arr || []).forEach(function (v) {\n    var s = String(v);\n    var k = s.toLowerCase();\n    if (!seen[k]) {\n      seen[k] = true;\n      out.push(s);\n    }\n  });\n  return out;\n}\n\nfunction normalizeStaticMessage(msg) {\n  if (msg === undefined || msg === null) return null;\n  var s = String(msg).trim();\n  return s.length ? s : null;\n}\n\n// Strict menu parser: accepts ONLY objects with itemValue.\nfunction extractMenuValues(menuItems) {\n  if (!Array.isArray(menuItems)) return [];\n  var out = [];\n\n  menuItems.forEach(function (m) {\n    if (!m || typeof m !== \"object\") return;\n    if (m.itemValue === undefined || m.itemValue === null) return;\n\n    var s = String(m.itemValue).trim();\n    if (!s) return;\n    if (s.toLowerCase() === \"undefined\" || s.toLowerCase() === \"null\") return;\n\n    out.push(s);\n  });\n\n  return uniqueStrings(out);\n}\n\n// -------------------------\n// Build attribute metadata\n// -------------------------\nvar attrMeta = {};\n\n[\"configurable\", \"nonConfigurable\", \"system\", \"account\", \"user\"].forEach(function (bucket) {\n  var section = attrs.attributes ? attrs.attributes[bucket] : attrs[bucket];\n  if (!section) return;\n\n  Object.keys(section).forEach(function (levelKey) {\n    var list = section[levelKey];\n    if (!Array.isArray(list)) return;\n\n    list.forEach(function (attr) {\n      if (!attr || !attr.variableName) return;\n\n      var key = String(attr.variableName).trim().toLowerCase();\n      if (!key) return;\n\n      var menu = [];\n      if (Array.isArray(attr.menuItems)) {\n        menu = extractMenuValues(attr.menuItems);\n      } else if (attr.menuItems && Array.isArray(attr.menuItems.items)) {\n        menu = extractMenuValues(attr.menuItems.items);\n      }\n\n      attrMeta[key] = {\n        attrVar: attr.variableName,\n        inputTypeCode: attr.inputTypeCode || \"\",\n        dataType: attr.dataType || \"\",\n        menuValues: menu\n      };\n    });\n  });\n});\n\nfunction getMeta(attrVar) {\n  if (!attrVar) return null;\n  return attrMeta[String(attrVar).trim().toLowerCase()] || null;\n}\n\n// -------------------------\n// Specs + defaults\n// -------------------------\nfunction conditionTypeSpec(meta) {\n  if (!meta || !meta.inputTypeCode) return null;\n  var t = meta.inputTypeCode;\n  var dt = String(meta.dataType || \"\");\n\n  if (t === \"SingleSelectMenu\") return { key: \"SingleSelectMenu\", isMenu: true, ops: [\"EqualTo\", \"NotEqualTo\"], between: false };\n  if (t === \"MultiSelectMenu\") return { key: \"MultiSelectMenu\", isMenu: true, ops: [\"EqualTo\", \"NotEqualTo\", \"Contains\", \"NotContains\"], between: false };\n  if (t === \"TextField\" && dt === \"Text\") return { key: \"TextField:Text\", isMenu: false, ops: [\"EqualTo\", \"NotEqualTo\", \"Contains\", \"NotContains\", \"StartsWith\", \"NotStartsWith\", \"EndsWith\", \"NotEndsWith\"], between: false };\n  if (t === \"TextField\" && (dt === \"Integer\" || dt === \"Float\")) return { key: \"TextField:Number\", isMenu: false, ops: [\"LessThan\", \"LessThanEqualTo\", \"EqualTo\", \"NotEqualTo\", \"GreaterThan\", \"GreaterThanEqualTo\", \"Between\"], between: true };\n  if (t === \"Date\") return { key: \"Date\", isMenu: false, ops: [\"EqualTo\", \"NotEqualTo\", \"Before\", \"OnOrBefore\", \"After\", \"OnOrAfter\", \"Between\"], between: true };\n  if (t === \"Currency\") return { key: \"Currency\", isMenu: false, ops: [\"LessThan\", \"LessThanEqualTo\", \"EqualTo\", \"NotEqualTo\", \"GreaterThan\", \"GreaterThanEqualTo\", \"Between\"], between: true };\n  if (t === \"Boolean\") return { key: \"Boolean\", isMenu: false, ops: [\"EqualTo\"], between: false };\n\n  return null;\n}\n\nfunction actionTypeSpec(meta) {\n  if (!meta || !meta.inputTypeCode) return null;\n  var t = meta.inputTypeCode;\n  var dt = String(meta.dataType || \"\");\n\n  if (t === \"SingleSelectMenu\") return { key: \"SingleSelectMenu\", isMenu: true, ops: [], between: false };\n  if (t === \"MultiSelectMenu\") return { key: \"MultiSelectMenu\", isMenu: true, ops: [], between: false };\n  if (t === \"TextField\" && dt === \"Text\") return { key: \"TextField:Text\", isMenu: false, ops: [\"EqualTo\"], between: false };\n  if (t === \"TextField\" && (dt === \"Integer\" || dt === \"Float\")) return { key: \"TextField:Number\", isMenu: false, ops: [\"LessThan\", \"LessThanEqualTo\", \"EqualTo\", \"NotEqualTo\", \"GreaterThan\", \"GreaterThanEqualTo\", \"Between\"], between: true };\n  if (t === \"Date\") return { key: \"Date\", isMenu: false, ops: [\"EqualTo\", \"NotEqualTo\", \"Before\", \"OnOrBefore\", \"After\", \"OnOrAfter\", \"Between\"], between: true };\n  if (t === \"Currency\") return { key: \"Currency\", isMenu: false, ops: [\"LessThan\", \"LessThanEqualTo\", \"EqualTo\", \"NotEqualTo\", \"GreaterThan\", \"GreaterThanEqualTo\", \"Between\"], between: true };\n  if (t === \"Boolean\") return { key: \"Boolean\", isMenu: false, ops: [\"EqualTo\"], between: false };\n\n  return null;\n}\n\nfunction defaultForSpec(spec, meta) {\n  if (!spec) return \"undefined\";\n  if (spec.isMenu) {\n    if (meta && Array.isArray(meta.menuValues) && meta.menuValues.length > 0) return String(meta.menuValues[0]);\n    return \"undefined\";\n  }\n  if (spec.key === \"Boolean\") return \"false\";\n  if (spec.key === \"TextField:Number\" || spec.key === \"Currency\") return \"0\";\n  if (spec.key === \"Date\") return \"1970-01-01 00:00:00\";\n  if (spec.key === \"TextField:Text\") return \"undefined\";\n  return \"undefined\";\n}\n\nfunction pickDefaultOperator(ops) {\n  if (!Array.isArray(ops) || !ops.length) return null;\n  if (ops.indexOf(\"EqualTo\") >= 0) return \"EqualTo\";\n  return ops[0];\n}\n\nfunction normalizeConditionOp(rawOp, allowedOps) {\n  if (!rawOp) return null;\n  var op = String(rawOp);\n  if (allowedOps.indexOf(op) >= 0) return op;\n\n  var aliases = {\n    Equals: \"EqualTo\",\n    NotEquals: \"NotEqualTo\",\n    GreaterThanOrEqualTo: \"GreaterThanEqualTo\",\n    LessThanOrEqualTo: \"LessThanEqualTo\"\n  };\n\n  var mapped = aliases[op];\n  if (mapped && allowedOps.indexOf(mapped) >= 0) return mapped;\n\n  return null;\n}\n\nfunction normalizeActionOp(rawOp, allowedOps) {\n  if (!rawOp) return null;\n  var op = String(rawOp);\n  if (allowedOps.indexOf(op) >= 0) return op;\n\n  var aliases = {\n    Equals: \"EqualTo\",\n    NotEquals: \"NotEqualTo\",\n    GreaterThanOrEqualTo: \"GreaterThanEqualTo\",\n    LessThanOrEqualTo: \"LessThanEqualTo\"\n  };\n\n  var mapped = aliases[op];\n  if (mapped && allowedOps.indexOf(mapped) >= 0) return mapped;\n  return null;\n}\n\nfunction normalizeScalarBySpec(spec, meta, v) {\n  var raw = (v === undefined || v === null) ? \"\" : String(v).trim();\n  if (!raw) return null;\n\n  if (spec.key === \"Boolean\") {\n    var low = raw.toLowerCase();\n    if (low === \"true\" || low === \"false\") return low;\n    return null;\n  }\n\n  if (spec.key === \"TextField:Number\" || spec.key === \"Currency\") {\n    var dt = String((meta && meta.dataType) || \"\");\n    if (dt === \"Integer\") return /^-?\\d+$/.test(raw) ? raw : null;\n    return /^-?\\d+(\\.\\d+)?$/.test(raw) ? raw : null;\n  }\n\n  if (spec.key === \"Date\") {\n    return isNaN(Date.parse(raw)) ? null : raw;\n  }\n\n  return raw;\n}\n\nfunction normalizeArrayValues(spec, meta, values, allowMany, attrNameForError) {\n  var arr = Array.isArray(values) ? values : [];\n  var out = [];\n  var removed = [];\n\n  for (var i = 0; i < arr.length; i++) {\n    var raw = arr[i];\n    var nv = normalizeScalarBySpec(spec, meta, raw);\n    if (nv !== null) out.push(nv);\n    else removed.push(raw);\n  }\n\n  if (removed.length) trackRemovedValues(attrNameForError, removed);\n\n  if (!out.length) out = [defaultForSpec(spec, meta)];\n\n  out = uniqueStrings(out);\n  if (!allowMany && out.length > 1) {\n    trackRemovedValues(attrNameForError, out.slice(1));\n    out = [out[0]];\n  }\n\n  return out;\n}\n\nfunction cleanSelectableValues(meta, values, attrNameForError) {\n  var list = Array.isArray(values) ? values.map(String) : [];\n  var menu = (meta && Array.isArray(meta.menuValues)) ? meta.menuValues : [];\n\n  if (!menu.length) {\n    if (list.length) trackRemovedValues(attrNameForError, list);\n    return [\"undefined\"];\n  }\n\n  var menuSet = {};\n  menu.forEach(function (v) { menuSet[String(v).toLowerCase()] = String(v); });\n\n  var filtered = [];\n  var removed = [];\n  list.forEach(function (val) {\n    var hit = menuSet[String(val).toLowerCase()];\n    if (hit !== undefined) filtered.push(hit);\n    else removed.push(val);\n  });\n\n  if (removed.length) trackRemovedValues(attrNameForError, removed);\n\n  if (!filtered.length) filtered = [String(menu[0])];\n  return uniqueStrings(filtered);\n}\n\n// -------------------------\n// Condition cleaning\n// -------------------------\nfunction normalizeConditionValue(spec, meta, rawValueObj, attrNameForError) {\n  var valObj = rawValueObj && typeof rawValueObj === \"object\" ? rawValueObj : {};\n  var values = Array.isArray(valObj.values) ? valObj.values : [];\n\n  if (spec.isMenu) {\n    return { valueType: \"Static\", values: cleanSelectableValues(meta, values, attrNameForError) };\n  }\n\n  var normalized = normalizeArrayValues(spec, meta, values, false, attrNameForError);\n  return { valueType: \"Static\", values: [normalized[0]] };\n}\n\n// Between encoding: lower comparator + rangeOperator + rangeValue (no literal \"Between\" output)\nfunction normalizeConditionBetween(spec, meta, item, attrNameForError) {\n  var valueObj = item.value && typeof item.value === \"object\" ? item.value : {};\n  var lowerOps = spec.key === \"Date\" ? [\"After\", \"OnOrAfter\"] : [\"GreaterThan\", \"GreaterThanEqualTo\"];\n  var upperOps = spec.key === \"Date\" ? [\"Before\", \"OnOrBefore\"] : [\"LessThan\", \"LessThanEqualTo\"];\n\n  var lower = normalizeConditionOp(item.operator, lowerOps) || lowerOps[0];\n  var upper = normalizeConditionOp(valueObj.rangeOperator, upperOps) || upperOps[0];\n\n  var lowVals = normalizeArrayValues(spec, meta, valueObj.values, false, attrNameForError);\n  var highVals = normalizeArrayValues(spec, meta, valueObj.rangeValue, false, attrNameForError);\n\n  return {\n    operator: lower,\n    value: {\n      valueType: \"Static\",\n      values: [lowVals[0]],\n      rangeOperator: upper,\n      rangeValue: [highVals[0]]\n    }\n  };\n}\n\nvar ruleCondition = rulePayload.ruleCondition || {};\nvar condItems = (ruleCondition.conditions && Array.isArray(ruleCondition.conditions.items)) ? ruleCondition.conditions.items : [];\nif (!Array.isArray(condItems)) condItems = [];\n\nif (condItems.length > 0) {\n  var cleanedCondItems = [];\n\n  condItems.forEach(function (item) {\n    if (!item || !item.criteria || item.criteria.criteriaType !== \"Attribute\") return;\n\n    var originalAttr = item.criteria.attribute;\n    var meta = getMeta(originalAttr);\n    if (!meta) {\n      trackRemovedAttribute(originalAttr);\n      return;\n    }\n\n    var spec = conditionTypeSpec(meta);\n    if (!spec) {\n      trackRemovedAttribute(originalAttr);\n      return;\n    }\n\n    var op = normalizeConditionOp(item.operator, spec.ops) || pickDefaultOperator(spec.ops);\n    if (!op) return;\n\n    var isBetween = spec.between && (op === \"Between\" || (item.value && (item.value.rangeOperator !== undefined || item.value.rangeValue !== undefined)));\n\n    var outItem = {\n      criteria: { criteriaType: \"Attribute\", attribute: meta.attrVar },\n      index: cleanedCondItems.length + 1,\n      operator: op,\n      value: normalizeConditionValue(spec, meta, item.value, meta.attrVar)\n    };\n\n    if (isBetween) {\n      var bt = normalizeConditionBetween(spec, meta, item, meta.attrVar);\n      outItem.operator = bt.operator;\n      outItem.value = bt.value;\n    } else {\n      if (outItem.value) {\n        delete outItem.value.rangeOperator;\n        delete outItem.value.rangeValue;\n      }\n    }\n\n    cleanedCondItems.push(outItem);\n  });\n\n  if (cleanedCondItems.length > 0) {\n    var originalExpr = String(ruleCondition.conditionExpression || \"\");\n    var joiner = /\\bOR\\b/i.test(originalExpr) ? \" OR \" : \" AND \";\n    rulePayload.ruleCondition = {\n      conditionType: \"SimpleCondition\",\n      conditions: { items: cleanedCondItems },\n      conditionExpressi