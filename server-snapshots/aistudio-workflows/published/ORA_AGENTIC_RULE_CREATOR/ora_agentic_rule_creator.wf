          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"ruleCondition\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"conditionType\": {\n          \"type\": \"string\",\n          \"enum\": [\"AlwaysTrue\", \"SimpleCondition\"]\n        },\n        \"conditions\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"items\": {\n              \"type\": \"array\",\n              \"minItems\": 1,\n              \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"criteria\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                      \"criteriaType\": {\n                        \"type\": \"string\",\n                        \"const\": \"Attribute\"\n                      },\n                      \"attribute\": {\n                        \"type\": \"string\",\n                        \"minLength\": 1\n                      }\n                    },\n                    \"required\": [\"criteriaType\", \"attribute\"],\n                    \"additionalProperties\": false\n                  },\n                  \"index\": {\n                    \"type\": \"integer\",\n                    \"minimum\": 1\n                  },\n                  \"operator\": {\n                    \"type\": \"string\",\n                    \"minLength\": 1\n                  },\n                  \"value\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                      \"valueType\": {\n                        \"type\": \"string\",\n                        \"const\": \"Static\"\n                      },\n                      \"values\": {\n                        \"type\": \"array\",\n                        \"minItems\": 1,\n                        \"items\": {\n                          \"type\": \"string\",\n                          \"minLength\": 1\n                        }\n                      },\n                      \"rangeOperator\": {\n                        \"type\": \"string\",\n                        \"minLength\": 1\n                      },\n                      \"rangeValue\": {\n                        \"type\": \"array\",\n                        \"minItems\": 1,\n                        \"items\": {\n                          \"type\": \"string\",\n                          \"minLength\": 1\n                        }\n                      }\n                    },\n                    \"required\": [\"valueType\", \"values\"],\n                    \"dependencies\": {\n                      \"rangeOperator\": [\"rangeValue\"],\n                      \"rangeValue\": [\"rangeOperator\"]\n                    },\n                    \"additionalProperties\": false\n                  }\n                },\n                \"required\": [\"criteria\", \"index\", \"operator\", \"value\"],\n                \"additionalProperties\": false\n              }\n            }\n          },\n          \"required\": [\"items\"],\n          \"additionalProperties\": false\n        },\n        \"conditionExpression\": {\n          \"type\": \"string\",\n          \"minLength\": 1\n        }\n      },\n      \"required\": [\"conditionType\"],\n      \"additionalProperties\": false,\n      \"allOf\": [\n        {\n          \"if\": {\n            \"properties\": {\n              \"conditionType\": {\n                \"const\": \"SimpleCondition\"\n              }\n            }\n          },\n          \"then\": {\n            \"required\": [\"conditions\", \"conditionExpression\"]\n          },\n          \"else\": {\n            \"not\": {\n              \"anyOf\": [\n                { \"required\": [\"conditions\"] },\n                { \"required\": [\"conditionExpression\"] }\n              ]\n            }\n          }\n        }\n      ]\n    }\n  },\n  \"required\": [\"ruleCondition\"],\n  \"additionalProperties\": false\n}",
