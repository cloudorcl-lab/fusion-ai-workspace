        {
          "metadata": {
            "name": "Code Technician Validation",
            "sourceCode": "let personDetail = $context.$nodes.GET_PERSON_JOB_FUNCTION.$output;\n\ntry {\n const assignments =\n    personDetail?.items?.[0]?.PersonJobFuncAssignmentP?.items || [];\n\nconst codeTechnicianJobAssignment  = assignments.find(\n      item => item.JobFuncId === \"ORA_CODE_ENFORCEMENT_TECHNICIAN\"\n    ) || null\nreturn codeTechnicianJobAssignment ? true: false;\n\n}catch(error){\nreturn false;\n}",
            "returnType": "boolean"
          },
