          "inputs": [
            {
              "id": "1762469402226",
              "name": "searchContextCode",
              "type": "string",
              "value": "{{((ival => ival == null || ival === '' || (typeof ival === 'string' && ival.trim() === '') || ival === '<provide a value>')($context.$triggers.REST.$input.searchContextCode)) ? 'GEN_AI_ANSWER_LI_USECASE_LEARNING_FIT' : $context.$triggers.REST.$input.searchContextCode}}"
            },
            {
              "id": "1762469364356",
              "name": "searchContextText",
              "type": "string",
              "value": "{{((ival => ival == null || ival === '' || (typeof ival === 'string' && ival.trim() === '') || ival === '<provide a value>')($context.$triggers.REST.$input.searchContext)) ? null : $context.$triggers.REST.$input.searchContext}}"
            },
            {
              "id": "1762469313365",
              "name": "userQuery",
              "type": "string",
              "value": "{{$context.$system.$inputMessage}}"
            },
            {
              "id": "1762469238294",
              "name": "limit",
              "type": "integer",
              "value": "{{((ival => ival == null || ival === '' || ival < 0 || ival > 5 || ival === '<provide a number value>')($context.$triggers.REST.$input.limit)) ? 5 : $context.$triggers.REST.$input.limit}}"
            },
            {
              "id": "1762469170552",
              "name": "subjectId",
              "type": "string",
              "value": "{{((id => id == null || id === '' || (typeof id === 'string' && id.trim() === '') || id === '<provide a value>')($context.$triggers.REST.$input.subjectId)) ? null : $context.$triggers.REST.$input.subjectId}}"
            },
            {
              "id": "1762469120536",
              "name": "subjectType",
              "type": "string",
              "value": "{{((ival => ival== null || ival === '' || (typeof ival === 'string' && ival.trim() === '') || ival=== '<provide a value>')($context.$triggers.REST.$input.subjectType)) ? 'ORA_GEN_AI_OBJ_TYPE_PERSON' : $context.$triggers.REST.$input.subjectType}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "If V1"
          },
          "outcomes": {
            "true": "1762469473901",
            "false": "add_false_1762469455674"
          },
          "code": "IF_V1",
          "convergenceTargetId": "end",
          "id": "1762469455674",
          "inputs": [
            {
              "id": "1762469455675_1",
              "name": "condition",
              "type": "string",
              "value": "true"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "description": "Add node for false branch",
            "name": "Add (False Branch)"
          },
          "outcomes": {
            "success": "end"
          },
          "id": "add_false_1762469455674",
          "inputs": [],
          "type": "ADD"
        },
        {
          "metadata": {
            "name": "Construct Search Payload",
            "returnType": "string",
            "sourceCode": "//set variables\nlet useCaseCode = $context.$variables.searchContextCode;\nlet maxResults = $context.$variables.limit;\nlet userQuery = $context.$variables.userQuery; \nlet personId = $context.$variables.subjectId;\n\nuserQuery.replace(/\"/g, '\\\"');               //Escape double quotes.\nJSON.stringify(userQuery).slice(1, -1);      // Remove wrapping quotes.\n\n// Start empty payload\nlet payload = {}; \n\n// Add top-level fields\npayload.query = userQuery;\n\npayload.context = \"HOVER_CARD\";\npayload.offset = 0; \npayload.limit = maxResults;\n\n// Add nested finder object\npayload.finder = {};\npayload.finder.name = \"ai\"; \n\n// Add parameters array and push entries programmatically\npayload.finder.parameters = [];\n\n//if code is unrecognized then default to catalog search.\nif (useCaseCode != 'GEN_AI_ANSWER_LI_USECASE_LEARNING_FIT' \n     &&  useCaseCode != 'GEN_AI_ANSWER_LI_USECASE_EMPLOYEE_CHECKIN' \n     && useCaseCode != 'GEN_AI_ANSWER_LI_USECASE_MANAGER_CHECKIN') { \n  useCaseCode = 'GEN_AI_ANSWER_LI_USECASE_LEARNING_FIT'; \n}\n\npayload.finder.parameters.push({\n  name: \"consumer\",\n  value: useCaseCode\n}); \n\n//add person id if manager checkin. \nif (useCaseCode == 'GEN_AI_ANSWER_LI_USECASE_MANAGER_CHECKIN' ) {\n    payload.finder.parameters.push({\n        name: \"personId\",\n        value: personId  + \"\"\n    });\n}\n\n// Convert to JSON string\nlet jsonPayload = JSON.stringify(payload); \n\nreturn jsonPayload;"
          },
          "outcomes": {
            "success": "1762469753475"
          },
          "code": "CONSTRUCT_SEARCH_PAYLOAD",
          "id": "1762469473901",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
