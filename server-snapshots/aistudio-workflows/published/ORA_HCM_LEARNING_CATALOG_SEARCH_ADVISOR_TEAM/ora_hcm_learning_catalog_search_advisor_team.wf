  "workflowCode": "ORA_HCM_LEARNING_CATALOG_SEARCH_ADVISOR_TEAM",
  "name": "Learning Catalog Search Advisor",
  "description": "Semantically search the learning catalog, grounding the user query in the provided search context for personalized results.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
