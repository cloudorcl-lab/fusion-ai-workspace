            "name": "Reply to User's Query"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "REPLY_TO_USERS_QUERY",
          "id": "1768489591417",
          "inputs": [
            {
              "id": "1768489591418_1",
              "name": "prompt",
              "type": "string",
              "value": "Answer to user's query: \n{{$context.$triggers.REST.$input}}\n {{$context.$system.$inputMessage}}\n\nUsing only and only the below data. Do not make up any data. Do not request for clarifications - answer based on the information you have. Only use messageLists and cards if absolutely necessary. Always try to ensure the answer contains multiple recommendations with ranking in different criterias if applicable:\n {{$context.$nodes.FETCH_SUPPLIER_RESPONSES.$output.output}}"
            }
          ],
          "type": "LLM"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [],
              "enableActions": false,
              "enableCommunications": true
            }
          },
