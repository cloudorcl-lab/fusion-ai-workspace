{
  "workflowId": "300000327042011",
  "workflowCode": "ORA_COMPONENT_BID_ANALYZER",
  "name": "Component Bid Analyzer",
  "description": "Aggregates and analyzes bid submissions from suppliers, comparing them against requirements, costs, and risk criteria. Provides clear, actionable summaries to accelerate decision-making and ensure optimal supplier selection.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
