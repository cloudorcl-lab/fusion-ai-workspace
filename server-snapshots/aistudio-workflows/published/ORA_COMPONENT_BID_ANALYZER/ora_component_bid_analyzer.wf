          },
          "code": "GENERATE_COMMUNICATIONS",
          "id": "1768562027233",
          "inputs": [
            {
              "id": "1768562027234_1",
              "name": "prompt",
              "type": "string",
              "value": "You need to generate email communications for the supplier responses that are Not compliant or are missing compliance information. Create an email for it with Subject and body (an example below):\nRFQ-39602 - Compliance information missing from supplier CV_SuppA07. Request Supplier to provide compliance information for the RFQ\n\nBased on the above data generate a email communication to the supplier. \nFor sender email use: EmailAddress Field. If not present then leave it as empty\n\n\nSupplier Responses: \n {{$context.$nodes.FETCH_SUPPLIER_RESPONSES.$output.output}}"
            }
          ],
          "type": "LLM"
        },
