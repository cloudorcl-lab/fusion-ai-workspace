          "inputs": [
            {
              "id": "1781496759181_prjPjcVarUqOraErpCoreProjectCostTransactionsUnprocessedProjectCostTransactionDetailsBVMetadata",
              "name": "prjPjcVarUqOraErpCoreProjectCostTransactionsUnprocessedProjectCostTransactionDetailsBVMetadata",
              "value": "{\"bvLabel\":\"Unprocessed Project Cost Transaction Detail\",\"bvDescription\":\"This view lists details associated with unprocessed project cost transactions.\",\"boQualifiedLabel\":\"Unprocessed Project Cost Transaction\",\"boDescription\":\"Project cost transactions that are pending successful validations and processing are considered to be in an unprocessed status. Project costs in an unprocessed status can belong to both predefined and third-party transaction sources.\",\"synonyms\":[],\"fields\":[{\"fieldPath\":\"unprocessedTransactionReferenceId\",\"label\":\"Unprocessed Transaction Reference\",\"description\":\"The original transaction reference of an unprocessed project cost that originated from a third-party source or an external system.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"transactionNumber\",\"label\":\"Transaction Number\",\"description\":\"The transaction number of the project cost transaction.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"batchName\",\"label\":\"Project Cost Batch\",\"description\":\"Name of the batch containing a specific set of project costs.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"transactionDate\",\"label\":\"Transaction Date\",\"description\":\"The date on which a project cost was incurred.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"originalTransactionReference\",\"label\":\"Original Transaction Reference\",\"description\":\"The original transaction reference of the project cost.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"transferredFromTransactionNumber\",\"label\":\"Transferred from Transaction Number\",\"description\":\"The transaction number of the original project cost, which was transferred from a different project, task, contract, or funding source resulting in the creation of this project cost.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"adjustingTransactionNumber\",\"label\":\"Adjusted Transaction Number\",\"description\":\"The transaction number of the project cost that was adjusted to result in this project cost transaction.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"burdenedCostInTransactionCurrency\",\"label\":\"Burdened Cost in Transaction Currency\",\"description\":\"The burdened cost of an unprocessed project cost transaction, denoted in the transaction currency.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"rawCostInProviderLedgerCurrency\",\"label\":\"Provider Ledger Raw Cost\",\"description\":\"The raw cost of an unprocessed project cost transaction, denoted in the provider ledger currency.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"burdenedCostInProviderLedgerCurrency\",\"label\":\"Burdened Cost\",\"description\":\"The burdened costs of an unprocessed project cost transaction, denoted in the provider ledger currency.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"rawCostInProjectCurrency\",\"label\":\"Raw Cost in Project Currency\",\"description\":\"The raw cost of an unprocessed project cost transaction, denoted in the project currency.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"rawCostInTransactionCurrency\",\"label\":\"Raw Cost in Transaction Currency\",\"description\":\"The raw cost of an unprocessed project cost transaction, denoted in the transaction currency.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"burdenedCostInProjectCurrency\",\"label\":\"Burdened Cost in Project Currency\",\"description\":\"The burdened cost of an unprocessed project cost transaction, denoted in the project currency.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"rawCostInReceiverLedgerCurrency\",\"label\":\"Raw Cost in Receiver Ledger Currency\",\"description\":\"The raw cost of an unprocessed project cost transaction, denoted in the receiver ledger currency.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"burdenedCostInReceiverLedgerCurrency\",\"label\":\"Burdened Cost in Receiver Ledger Currency\",\"description\":\"The burdened cost of an unprocessed project cost transaction, denoted in the receiver ledger currency.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"receiverProjectAccountingDate\",\"label\":\"Receiver Project Accounting Date\",\"description\":\"The date used to determine the project accounting period of a project cost transaction in the receiver organization's project accounting calendar. The receiver is the organization that owns the project that incurred the cost.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"providerAccountingPeriod\",\"label\":\"Accounting Period\",\"description\":\"The accounting period of a project cost transaction in the provider organization's accounting calendar. The provider is the organization that owns the labor or nonlabor resource that incurred the project cost.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"providerProjectAccountingPeriod\",\"label\":\"Project Accounting Period\",\"description\":\"The project accounting period of a project cost transaction in the provider organization's project accounting calendar. The provider is the organization that owns the labor or nonlabor resource that incurred the project cost.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"providerAccountingDate\",\"label\":\"Accounting Date\",\"description\":\"The date used to determine the accounting period of a transaction.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"receiverAccountingDate\",\"label\":\"Receiver Accounting Date\",\"description\":\"The date used to determine the accounting period of a project cost transaction in the receiver organization's accounting calendar. The receiver is the organization that owns the project that incurred the cost.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAccountingDate\",\"label\":\"Project Accounting Date\",\"description\":\"The date used to determine the project accounting period of a project cost transaction in the provider organization's project accounting calendar. The provider is the organization that owns the labor or nonlabor resource that incurred the project cost.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"providerAccrualDate\",\"label\":\"Provider Accrual Date\",\"description\":\"The date used when a project cost transaction is included in an accrual batch in the receiver organization's calendar.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"receiverAccrualDate\",\"label\":\"Receiver Accrual Date\",\"description\":\"The date used when a project cost transaction is included in an accrual batch in the receiver organization's calendar.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"accrualFlag\",\"label\":\"Accrual Item\",\"description\":\"A project cost transaction that accrues costs in one period and is automatically reversed in the next.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"netZeroItemFlag\",\"label\":\"Net Zero Item\",\"description\":\"Indicates that the project cost transaction is fully reversed or is one of the adjusting transactions that fully reverses another transaction.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"quantity\",\"label\":\"Quantity\",\"description\":\"The quantity associated with an unprocessed project cost transaction.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"unmatchedTransactionFlag\",\"label\":\"Unmatched Transaction\",\"description\":\"Indicates whether the unprocessed project cost should be imported as an independent transaction or as a reversal of an existing project cost that has matching attributes. If true, then the application will import the unprocessed project cost as an independent transaction. If false, then the application attempts to find and reverse an existing project cost with matching attributes. If null, and the unprocessed project cost's quantity is negative, the application considers this attribute as false. If null, and the unprocessed project cost's quantity is positive or zero, the application considers this attribute as true.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"createdBy\",\"label\":\"Created By\",\"description\":\"The user who created the record.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"timeCreated\",\"label\":\"Creation Date\",\"description\":\"The date and time when the record was created.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"date-time\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"updatedBy\",\"label\":\"Last Updated By\",\"description\":\"The user who last updated the record.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"timeUpdated\",\"label\":\"Last Updated Date\",\"description\":\"The date and time when the record was last updated.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"date-time\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"businessUnit\":{\"accessorLabel\":\"Business Unit\",\"accessorDescription\":\"A business unit represents a unit of an enterprise that performs one or more business functions and may have service provider relationships between the units. It typically focuses on a specific market segment, product line, geographic region, or set of services. The business transactions are recorded, reported, and accounted against the business unit.\",\"fields\":[{\"fieldPath\":\"businessUnit.id\",\"label\":\"Business Unit ID\",\"description\":\"The unique identifier of the business unit.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"businessUnit.name\",\"label\":\"Business Unit\",\"description\":\"The translated name for the business unit.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"businessUnit.effectiveStartDate\",\"label\":\"Start Date\",\"description\":\"The start date of the date range within which the business unit is effective.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"businessUnit.effectiveEndDate\",\"label\":\"End Date\",\"description\":\"The end date of the date range within which the business unit is effective.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"information\":{\"accessorLabel\":\"Business Unit Information\",\"accessorDescription\":\"A business unit information that contains additional details about the business unit, such as manager, primary ledger, default legal entity, default reference date set, and legal entity option.\",\"fields\":[{\"fieldPath\":\"businessUnit.information.id\",\"label\":\"Organization Unit Classification ID\",\"description\":\"\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"businessUnit.information.effectiveStartDate\",\"label\":\"Effective Start Date\",\"description\":\"Effective start date of the organization information.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"businessUnit.information.effectiveEndDate\",\"label\":\"Effective End Date\",\"description\":\"Effective end date of the organization information.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"primaryLedger\":{\"accessorLabel\":\"Ledger\",\"accessorDescription\":\"A ledger represents a record-keeping book used to track financial transactions. It serves as a central repository for all financial activities within an organization, providing a chronological and systematic account of debits, credits, and balances. Ledgers play a crucial role in financial management, budgeting, and maintaining accurate financial records, tracking expenses, revenues, assets, liabilities, and equity.\",\"fields\":[{\"fieldPath\":\"businessUnit.information.primaryLedger.ledgerId\",\"label\":\"Ledger ID\",\"description\":\"The unique identifier of the ledger for which the accounting entry is created.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"calendar\":{\"accessorLabel\":\"Accounting Calendar\",\"accessorDescription\":\"An accounting calendar contains the periods of an accounting year. For example, one company can have a fiscal calendar that starts in May and ends in June. Another company can use calendars based on the calendar year, January to December.\",\"fields\":[{\"fieldPath\":\"businessUnit.information.primaryLedger.calendar.calendarId\",\"label\":\"Calendar ID\",\"description\":\"The unique identifier of an accounting or commitment calendar.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"businessUnit.information.primaryLedger.calendar.periodSetName\",\"label\":\"Accounting Calendar\",\"description\":\"Name of the accounting calendar.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"businessUnit.information.primaryLedger.calendar.periodType\",\"label\":\"Period Type\",\"description\":\"The frequency of the accounting period, such as, Weekly, Monthly, and Quarterly. The list of accepted values for period frequency can be found in the lookup type CAL_NON_ADJ_FREQ. When creating a calendar with period frequency codes, the period type is concatenated with a unique number. For example, MONTH2558721688.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{}}}}}}}},\"contract\":{\"accessorLabel\":\"Contract\",\"accessorDescription\":\"The contracts resource is used to view the details of a contract. A contract is an agreement between two or more parties to fulfill an agreed scope of work.\",\"fields\":[{\"fieldPath\":\"contract.id\",\"label\":\"ID\",\"description\":\"The internal identifier of the contract custom child record.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"contract.contractName\",\"label\":\"Cognomen\",\"description\":\"The translation of the contract name.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"contract.contractNumber\",\"label\":\"Number\",\"description\":\"The alternate key identifier for the contract. Contract numbers can be automatically assigned, or entered manually.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"contract.publicIdentifier\",\"label\":\"Contract PUID\",\"description\":\"The public unique identifier of a contract.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{}},\"transactionSource\":{\"accessorLabel\":\"Cost Transaction Source\",\"accessorDescription\":\"The source where the project cost transaction originated.\",\"fields\":[{\"fieldPath\":\"transactionSource.id\",\"label\":\"Project Cost Transaction Source ID\",\"description\":\"Identifier of the project cost transaction source.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"transactionSource.name\",\"label\":\"Transaction Source\",\"description\":\"The transaction source name associated with the cost.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Cost Transaction Source\"},\"document\":{\"accessorLabel\":\"Document\",\"accessorDescription\":\"The document where the project cost transaction originated. Documents describe the type of transaction, such as time cards or expense reports, that resulted in a project cost. Documents also contain business rules that determine how the project subledger will treat transactions originating from the document.\",\"fields\":[{\"fieldPath\":\"document.id\",\"label\":\"Project Cost Transaction Document ID\",\"description\":\"Identifier of the project cost transaction document.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"document.name\",\"label\":\"Name\",\"description\":\"Name of the project cost transaction document.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Cost Transaction Source Document\"},\"documentEntry\":{\"accessorLabel\":\"Document Entry\",\"accessorDescription\":\"The document entry where the project cost transaction originated. Document entries further describe the type of transaction, such as item costs and nonrecoverable taxes, that resulted in a project cost. Document entries are assigned an expenditure type class that controls the expenditure types that can be included on project cost transactions, as well as additional business rules that determine how the project subledger will treat transactions originating from the document.\",\"fields\":[{\"fieldPath\":\"documentEntry.id\",\"label\":\"Project Cost Transaction Document Entry ID\",\"description\":\"Identifier of the project cost transaction document entry.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"documentEntry.name\",\"label\":\"Name\",\"description\":\"Name of the project cost transaction document entry.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Cost Transaction Source Document Entry\"},\"fundingSource\":{\"accessorLabel\":\"Funding Source\",\"accessorDescription\":\"Funding sources are external sponsors, internal organizations, and other sources that fund projects.\",\"fields\":[{\"fieldPath\":\"fundingSource.id\",\"label\":\"Funding Source ID\",\"description\":\"The unique identifier of the funding source.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"fundingSource.fundingSourceNumber\",\"label\":\"Number\",\"description\":\"The number of the funding source.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"fundingSource.type\",\"label\":\"Type\",\"description\":\"Type of the funding source.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Funding Source\"},\"nonlaborResource\":{\"accessorLabel\":\"Nonlabor Resource\",\"accessorDescription\":\"A nonlabor resource represents an asset or a pool of assets used for projects. For example, company-owned equipment like printers that produce physical output and internal telecommunications services where usage is tracked in hours. All usage-based costs are associated with a nonlabor resource.\",\"fields\":[{\"fieldPath\":\"nonlaborResource.id\",\"label\":\"Nonlabor Resource ID\",\"description\":\"Unique identifier of the nonlabor resource.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"nonlaborResource.name\",\"label\":\"Name\",\"description\":\"The name of the nonlabor resource.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Nonlabor Resource\"},\"nonlaborResourceOrganization\":{\"accessorLabel\":\"Nonlabor Resource Organization\",\"accessorDescription\":\"The organization that owns the nonlabor resource.\",\"fields\":[{\"fieldPath\":\"nonlaborResourceOrganization.id\",\"label\":\"Organization ID\",\"description\":\"Unique identifier of the organization.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"nonlaborResourceOrganization.name\",\"label\":\"Name\",\"description\":\"Name of the organization.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"nonlaborResourceOrganization.effectiveStartDate\",\"label\":\"Effective Start Date\",\"description\":\"Effective start date of the organization.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"nonlaborResourceOrganization.effectiveEndDate\",\"label\":\"Effective End Date\",\"description\":\"Effective end date of the organization.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Organization Extract\",\"boDescription\":\"The organization resource provides the details about all organizations including their classifications and extended attributes.\"},\"person\":{\"accessorLabel\":\"Worker\",\"accessorDescription\":\"A worker is a person who has a working relationship with a legal entity defined in human resources. Persons with contingent worker and employee work relationships can be assigned to projects.\",\"fields\":[{\"fieldPath\":\"person.id\",\"label\":\"Id\",\"description\":\"Unique identifier of person business object.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"names\":{\"accessorLabel\":\"Person Names\",\"accessorDescription\":\"The personNames resource provides the name details of a person. A person can have multiple name records. This resource manages a specific person name record at a specific point in time. By default, the current date is retained.\",\"fields\":[{\"fieldPath\":\"person.names.id\",\"label\":\"Person Name ID\",\"description\":\"Surrogate identifier for the contact's name.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"person.names.effectiveStartDate\",\"label\":\"Effective Start Date\",\"description\":\"Start date of the date-effective changes to the global name record.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"person.names.effectiveEndDate\",\"label\":\"Effective End Date\",\"description\":\"End date of the date-effective changes to the global name record.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"person.names.displayName\",\"label\":\"Name\",\"description\":\"Contact's display name.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Names\"},\"personDetail\":{\"accessorLabel\":\"Person Detail\",\"accessorDescription\":\"Person detail accessor for worker business object.\",\"fields\":[{\"fieldPath\":\"person.personDetail.id\",\"label\":\"Id\",\"description\":\"Unique identifier of person detail.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"person.personDetail.effectiveStartDate\",\"label\":\"Effective Start Date\",\"description\":\"Effective start date of person detail.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"person.personDetail.effectiveEndDate\",\"label\":\"Effective End Date\",\"description\":\"Effective end date of person detail.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"person.personDetail.personNumber\",\"label\":\"Person Number\",\"description\":\"Person number accessor for person detail.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boDescription\":\"The personDetail provides additional person-related information, such as demographic or legislative attributes, associated with the person record.\"}},\"boDescription\":\"The worker provides employment-related information about a person who has a work relationship within the enterprise.\"},\"personJob\":{\"accessorLabel\":\"Job\",\"accessorDescription\":\"A job is part of a workforce structure that's assigned to a worker. A job is typically used without positions where the organization is fluid, for example, Technical Writer.\",\"fields\":[{\"fieldPath\":\"personJob.id\",\"label\":\"Job Identifier\",\"description\":\"Surrogate identifier for the job.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"personJob.effectiveStartDate\",\"label\":\"Effective Start Date\",\"description\":\"Date at the beginning of the period within which the job is effective.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"personJob.effectiveEndDate\",\"label\":\"Effective End Date\",\"description\":\"Date at the end of the period within which the job is effective.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"personJob.name\",\"label\":\"Name\",\"description\":\"Name accessor for the job.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boDescription\":\"The jobs resource provides the details of all jobs as on a specified date. You can retrieve, create, and update the jobs.\"},\"project\":{\"accessorLabel\":\"Project\",\"accessorDescription\":\"A project represents the effort and resources required to achieve a significant business objective within a specific time frame. Projects are used to plan, track, manage, and control both the financial aspects and the work effort required.\",\"fields\":[{\"fieldPath\":\"project.id\",\"label\":\"Project ID\",\"description\":\"Unique identifier of the project.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.name\",\"label\":\"Project Name\",\"description\":\"Name of the project.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectNumber\",\"label\":\"Project Number\",\"description\":\"Number of the project.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.finishDate\",\"label\":\"Finish Date\",\"description\":\"The date that work or information tracking completes for a project.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"projectUnit\":{\"accessorLabel\":\"Project Unit\",\"accessorDescription\":\"A project unit is an operational subset of an enterprise that conducts business operations using projects and enforces consistent project planning, management, analysis, and reporting. Project units often represent lines of business, such as Consulting Services, Sales, and Research and Development. Maintain independent setup data for each project unit while sharing a common approach to financial management across all project units.\",\"fields\":[{\"fieldPath\":\"project.projectUnit.name\",\"label\":\"Name\",\"description\":\"The name of the project unit.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{}},\"projectType\":{\"accessorLabel\":\"Project Type\",\"accessorDescription\":\"A project type is part of the classification for a project and provides the basic options for burdening, capitalization, billing, and sponsorship. Options at the project type level are inherited by each project associated with that project type. It can be used to group projects for reporting and to allocate costs.\",\"fields\":[{\"fieldPath\":\"project.projectType.name\",\"label\":\"Name\",\"description\":\"Name of the project type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectType.enableBurdeningFlag\",\"label\":\"Enable Burdening\",\"description\":\"Indicates whether projects with this project type are enabled for burdening. Burdening is a method of applying one or more burden cost components to the raw cost amount of each transaction to calculate burden cost amounts. If true, then the project type is used to control how burden transactions are created and accounted for the project. If false, then costs are processed as raw costs. You can't change this option after creating projects or project templates using the project type.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{}}}},\"projectBusinessUnitConfiguration\":{\"accessorLabel\":\"Project Business Unit Configuration\",\"accessorDescription\":\"Business unit level settings that control specific aspects of how the Project Management application functions. The Project Business Unit Configuration business object is accessed for retrieving accounting period related information to process project cost transactions.\",\"fields\":[{\"fieldPath\":\"projectBusinessUnitConfiguration.businessUnitId\",\"label\":\"Business Unit ID\",\"description\":\"The unique identifier of the business unit in which the Project Management application is configured.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"projectFinancialCalendar\":{\"accessorLabel\":\"Project Accounting Calendar\",\"accessorDescription\":\"A calendar used for financial project planning, costing, billing, budgeting, forecasting, and performance reporting.\",\"fields\":[{\"fieldPath\":\"projectBusinessUnitConfiguration.projectFinancialCalendar.calendarId\",\"label\":\"Calendar ID\",\"description\":\"The unique identifier of an accounting or commitment calendar.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectBusinessUnitConfiguration.projectFinancialCalendar.periodSetName\",\"label\":\"Accounting Calendar\",\"description\":\"Name of the accounting calendar.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectBusinessUnitConfiguration.projectFinancialCalendar.periodType\",\"label\":\"Period Type\",\"description\":\"The frequency of the accounting period, such as, Weekly, Monthly, and Quarterly. The list of accepted values for period frequency can be found in the lookup type CAL_NON_ADJ_FREQ. When creating a calendar with period frequency codes, the period type is concatenated with a unique number. For example, MONTH2558721688.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Accounting Calendar\",\"boDescription\":\"An accounting calendar contains the periods of an accounting year. For example, one company can have a fiscal calendar that starts in May and ends in June. Another company can use calendars based on the calendar year, January to December.\"}},\"boDescription\":\"Business unit-level settings which control specific aspects of how the Project Management application functions, such as which project organization trees to use, how to convert currencies, and how to process cross-charges within a legal entity.\"},\"projectCostClassification\":{\"accessorLabel\":\"Cost Classification\",\"accessorDescription\":\"The cost classification is used to provide an additional classification for cost types and drive cost processing. Examples include burden transactions, expense reports, and straight time.\",\"fields\":[{\"fieldPath\":\"projectCostClassification.code\",\"label\":\"Cost Classification Code\",\"description\":\"The code that uniquely identifies the cost classification.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectCostClassification.name\",\"label\":\"Name\",\"description\":\"The name of the cost classification.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Cost Classification\"},\"projectCostOrganization\":{\"accessorLabel\":\"Cost Organization\",\"accessorDescription\":\"An organization that's responsible for incurring project cost transactions. For worker-related project costs, such as time cards or expenses, the department on a worker's primary assignment must also be classified as a project cost organization. A project cost organization can be used to derive project cost amounts, as a source for project cost and revenue accounting, to identify and process cross-charges, and to group project costs for reporting purposes.\",\"fields\":[{\"fieldPath\":\"projectCostOrganization.effectiveEndDate\",\"label\":\"Effective End Date\",\"description\":\"The latest effective end date of the organization that's classified as a project cost organization.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectCostOrganization.id\",\"label\":\"Project Cost Organization ID\",\"description\":\"The unique identifier of the project cost organization.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectCostOrganization.name\",\"label\":\"Name\",\"description\":\"The name of the project cost organization.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectCostOrganization.effectiveStartDate\",\"label\":\"Effective Start Date\",\"description\":\"The earliest effective start date of the organization that's classified as a project cost organization.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Cost Organization\"},\"projectCostType\":{\"accessorLabel\":\"Cost Type\",\"accessorDescription\":\"A cost type is a classification of cost for a project expenditure.\",\"fields\":[{\"fieldPath\":\"projectCostType.id\",\"label\":\"Cost Type ID\",\"description\":\"Unique identifier of the cost type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectCostType.name\",\"label\":\"Expenditure Type\",\"description\":\"Name of the cost type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"costCategory\":{\"accessorLabel\":\"Cost Category\",\"accessorDescription\":\"A project cost category describes and groups project costs. For example, a cost category named Labor is used to group labor-related cost types, and a cost category named Supplier is for costs incurred on supplier invoices.\",\"fields\":[{\"fieldPath\":\"projectCostType.costCategory.id\",\"label\":\"Cost Category ID\",\"description\":\"Unique identifier of the project cost category.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectCostType.costCategory.name\",\"label\":\"Name\",\"description\":\"Name of the project cost category.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Cost Category\"}},\"boQualifiedLabel\":\"Project Cost Type\",\"boDescription\":\"A cost type is a classification of project cost used in planning, budgeting, forecasting, and reporting. It's a primary driver for cost processing, such as calculating raw and burden costs, controlling which charges are allowed for a project, capturing retirement costs in a capital project, and tracking miscellaneous costs like asset depreciation, allocations, and interest charges.\"},\"projectCurrency\":{\"accessorLabel\":\"Project Currency\",\"accessorDescription\":\"The project currency code.\",\"fields\":[{\"fieldPath\":\"projectCurrency.currencyCode\",\"label\":\"Currency Code\",\"description\":\"The currency in which an amount or a conversion rate is denominated.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectCurrency.name\",\"label\":\"Name\",\"description\":\"The user-defined name of the currency.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Currency\",\"boDescription\":\"Currencies are defined and populated through seed data and used to create transactions within the application. This object encapsulates various properties and functionalities related to a specific currency.\"},\"providerLedgerCurrency\":{\"accessorLabel\":\"Provider Ledger Currency\",\"accessorDescription\":\"The provider ledger currency code.\",\"fields\":[{\"fieldPath\":\"providerLedgerCurrency.currencyCode\",\"label\":\"Currency Code\",\"description\":\"The currency in which an amount or a conversion rate is denominated.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"providerLedgerCurrency.name\",\"label\":\"Name\",\"description\":\"The user-defined name of the currency.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Currency\",\"boDescription\":\"Currencies are defined and populated through seed data and used to create transactions within the application. This object encapsulates various properties and functionalities related to a specific currency.\"},\"receiverLedgerCurrency\":{\"accessorLabel\":\"Receiver Ledger Currency\",\"accessorDescription\":\"The receiver ledger currency code.\",\"fields\":[{\"fieldPath\":\"receiverLedgerCurrency.currencyCode\",\"label\":\"Currency Code\",\"description\":\"The currency in which an amount or a conversion rate is denominated.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"receiverLedgerCurrency.name\",\"label\":\"Name\",\"description\":\"The user-defined name of the currency.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Currency\",\"boDescription\":\"Currencies are defined and populated through seed data and used to create transactions within the application. This object encapsulates various properties and functionalities related to a specific currency.\"},\"transactionCurrency\":{\"accessorLabel\":\"Transaction Currency\",\"accessorDescription\":\"The transaction currency code.\",\"fields\":[{\"fieldPath\":\"transactionCurrency.currencyCode\",\"label\":\"Currency Code\",\"description\":\"The currency in which an amount or a conversion rate is denominated.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"transactionCurrency.name\",\"label\":\"Name\",\"description\":\"The user-defined name of the currency.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Currency\",\"boDescription\":\"Currencies are defined and populated through seed data and used to create transactions within the application. This object encapsulates various properties and functionalities related to a specific currency.\"},\"receiverBusinessUnit\":{\"accessorLabel\":\"Receiver Business Unit\",\"accessorDescription\":\"A business unit represents a unit of an enterprise that performs one or more business functions and may have service provider relationships between the units. It typically focuses on a specific market segment, product line, geographic region, or set of services. The business transactions are recorded, reported, and accounted against the business unit.\",\"fields\":[{\"fieldPath\":\"receiverBusinessUnit.id\",\"label\":\"Business Unit ID\",\"description\":\"The unique identifier of the business unit.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"receiverBusinessUnit.name\",\"label\":\"Business Unit\",\"description\":\"The translated name for the business unit.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"receiverBusinessUnit.effectiveStartDate\",\"label\":\"Start Date\",\"description\":\"The start date of the date range within which the business unit is effective.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"receiverBusinessUnit.effectiveEndDate\",\"label\":\"End Date\",\"description\":\"The end date of the date range within which the business unit is effective.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Business Unit\"},\"supplier\":{\"accessorLabel\":\"Supplier\",\"accessorDescription\":\"A supplier is a person or company that the deploying organization uses to procure items or services. For example, an office supplies provider or a consulting service provider.\",\"fields\":[{\"fieldPath\":\"supplier.supplierId\",\"label\":\"Supplier ID\",\"description\":\"Value that uniquely identifies the supplier.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"supplier.name\",\"label\":\"Name\",\"description\":\"The name of the organization.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"supplier.supplierNumber\",\"label\":\"Supplier Number\",\"description\":\"Number that identifies the supplier.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{}},\"task\":{\"accessorLabel\":\"Task\",\"accessorDescription\":\"A project task is a subdivision of project work to be performed within a defined period.\",\"fields\":[{\"fieldPath\":\"task.id\",\"label\":\"Task ID\",\"description\":\"Identifier of the project task.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"task.name\",\"label\":\"Task Name\",\"description\":\"Name of the project task.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"task.taskNumber\",\"label\":\"Task Number\",\"description\":\"Number of the project task that identifies it uniquely in the project task hierarchy.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Task\"},\"workType\":{\"accessorLabel\":\"Work Type\",\"accessorDescription\":\"A work type is a classification of actual and scheduled work. Used to identify work for processing purposes, including billing, cross-charging between organizations, and labor utilization tracking.\",\"fields\":[{\"fieldPath\":\"workType.id\",\"label\":\"Work Type ID\",\"description\":\"Unique identifier of the work type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"workType.name\",\"label\":\"Work Type\",\"description\":\"Name of the work type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Work Type\"},\"budgetPeriod\":{\"accessorLabel\":\"Budget Period\",\"accessorDescription\":\"Budget periods are time intervals that are used to fund and budget an award project. A typical budget period is 12 months.\",\"fields\":[{\"fieldPath\":\"budgetPeriod.id\",\"label\":\"Budget Period ID\",\"description\":\"The unique identifier of the award budget period.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"budgetPeriod.name\",\"label\":\"Name\",\"description\":\"Name of the budget period for the award.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Award Budget Period\"},\"billable\":{\"accessorLabel\":\"Billable\",\"accessorDescription\":\"Indicates the billable status of the cost transaction.\",\"fields\":[{\"fieldPath\":\"billable.lookupType\",\"label\":\"Lookup Type ID\",\"description\":\"The unique identifier of the Lookup Type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"billable.lookupCode\",\"label\":\"Lookup Code ID\",\"description\":\"The unique identifier of the Lookup Code.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"billable.meaning\",\"label\":\"Lookup Code Meaning\",\"description\":\"The translated meaning of the Lookup Code.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Standard Lookup Code\",\"boDescription\":\"The standard lookup codes list of values resource is used to query the list of standard lookup codes.\"},\"capitalizable\":{\"accessorLabel\":\"Capitalizable\",\"accessorDescription\":\"Indicates the capitalizable status of the cost transaction.\",\"fields\":[{\"fieldPath\":\"capitalizable.lookupType\",\"label\":\"Lookup Type ID\",\"description\":\"The unique identifier of the Lookup Type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"capitalizable.lookupCode\",\"label\":\"Lookup Code ID\",\"description\":\"The unique identifier of the Lookup Code.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"capitalizable.meaning\",\"label\":\"Lookup Code Meaning\",\"description\":\"The translated meaning of the Lookup Code.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Standard Lookup Code\",\"boDescription\":\"The standard lookup codes list of values resource is used to query the list of standard lookup codes.\"}}}"
            },
            {
              "id": "1781496759181_prjPjcVarUqBvExtractPayloadGenerationRules",
              "name": "prjPjcVarUqBvExtractPayloadGenerationRules",
              "value": "{\"purpose\":\"Rules for caonstructing a BOSS extraction query request payload from a natural language question using business view metadata.\",\"payloadShape\":{\"parameters\":{\"type\":\"object\",\"required\":false,\"description\":\"Runtime scalar values that can be referenced from BQL or view parameter mappings.\"},\"viewQueries\":{\"type\":\"object\",\"required\":true,\"description\":\"Source business object or business view declarations exposed as BQL virtual tables.\"},\"namedSelects\":{\"type\":\"array\",\"required\":false,\"description\":\"Ordered intermediate BQL views.\"},\"select\":{\"type\":\"string\",\"required\":true,\"description\":\"Top-level BQL SELECT statement.\"}},\"globalRules\":[\"Only fields exposed by the selected business view can be used in fieldAliases, filters, grouping, sorting, namedSelects, or select.\",\"A natural language phrase must first resolve to a business view and then to one or more exposed business view field paths.\",\"If the business view does not expose a field, do not use it even if the underlying business object has it.\",\"BQL uses Oracle SQL-like SELECT syntax.\",\"BQL must reference field aliases exposed through viewQueries.fieldAliases, not raw business object field paths.\",\"Every selected, filtered, grouped, sorted, joined, or computed field must be exposed through fieldAliases or produced by an earlier namedSelect.\",\"Filtering can use only fields marked searchable in the business view metadata.\",\"Sorting can use only fields marked sortable in the business view metadata.\",\"Alias computed output columns so downstream result mapping is deterministic.\",\"Every fieldAliases value must match ^[A-Za-z0-9]+$ and contain only ASCII letters and digits.\"],\"parameters\":{\"purpose\":[\"Carry runtime scalar values for bind variables in BQL.\",\"Provide values to business view parameters through viewParamMappings.\",\"Avoid duplicating user-provided literals across multiple BQL fragments.\",\"Keep user-provided values separate from BQL text where possible.\"],\"requestShape\":{\"parameterName\":\"scalarValue\"},\"nameRule\":\"Parameter names should start with a lowercase letter and contain only letters or digits.\",\"valueRule\":\"Use JSON scalar values unless the target contract explicitly allows arrays.\",\"bqlReference\":\":parameterName\",\"viewParamReference\":\"$parameters[\\\"parameterName\\\"]\",\"includeWhen\":[\"The natural language question includes concrete filter values.\",\"The same value is used in multiple filters or source view parameters.\",\"The value should remain separate from the BQL string.\",\"A business view parameter must be supplied at runtime.\"],\"omitWhen\":[\"The query has no runtime values.\",\"A value is a fixed artifact-level constant and not user supplied.\"],\"example\":{\"parameters\":{\"businessUnitId\":300000001234567,\"startDate\":\"2026-01-01\",\"status\":\"APPROVED\"}}},\"viewQueries\":{\"purpose\":\"Declare each business object or business view that BQL reads from. Each map key is a BQL table alias used in FROM clauses.\",\"fields\":{\"module\":{\"required\":false,\"description\":\"Use when needed to identify the business object module.\"},\"businessObject\":{\"required\":true,\"description\":\"Source business object name.\"},\"view\":{\"required\":false,\"description\":\"Business view name. Use the selected business view; omit only when the default view is intended.\"},\"filter\":{\"required\":false,\"description\":\"Optional BOSS $filter-style source-level restriction.\",\"constraints\":[\"Use only fields exposed by the selected business view.\",\"Use only fields marked searchable.\",\"Prefer source-level filter for business-view-local row restriction.\"]},\"viewParamMappings\":{\"required\":false,\"description\":\"Map business view parameter names to static scalar values or $parameters references.\"},\"fieldAliases\":{\"required\":true,\"description\":\"Map exposed business view field paths to BQL-safe aliases.\",\"constraints\":[\"Expose every field needed by output, filters, grouping, ordering, joins, or computations.\",\"Use accessor chains only when those exact field paths are exposed by the business view.\",\"Use simple BQL-safe aliases and reference only these aliases in BQL.\",\"Every fieldAliases value must match ^[A-Za-z0-9]+$; do not use spaces, underscores, hyphens, dots, punctuation, or special characters.\"]}},\"example\":{\"viewQueries\":{\"costs\":{\"module\":\"moduleName\",\"businessObject\":\"BusinessObjectName\",\"view\":\"businessViewName\",\"viewParamMappings\":{\"businessUnitId\":\"$parameters[\\\"businessUnitId\\\"]\"},\"fieldAliases\":{\"transactionNumber\":\"transactionNumber\",\"project.name\":\"projectName\",\"amount\":\"amount\"}}}}},\"namedSelects\":{\"purpose\":\"Define ordered intermediate BQL views.\",\"shape\":[{\"name\":\"intermediateName\",\"select\":\"SELECT ...\"}],\"orderingRule\":\"Each namedSelect may reference viewQueries and earlier namedSelects. Later namedSelects and the top-level select can reference it by name.\",\"includeWhen\":[\"The query needs staged aggregation or de-duplication.\",\"The query combines multiple sources with UNION or joins.\",\"The query benefits from projection, normalization, CASE, DECODE, NVL, or pre-filtering.\",\"The top-level select would otherwise be hard to read or validate.\"],\"omitWhen\":[\"A single SELECT from one or more view query aliases is sufficient.\"],\"constraints\":[\"Reference only viewQueries aliases and earlier namedSelects in FROM clauses.\",\"Reference only field aliases or columns produced by prior namedSelects.\",\"Filter predicates in namedSelects can use only fields that came from searchable business view fields unless filtering on a derived namedSelect column.\",\"ORDER BY in namedSelects can use only fields that came from sortable business view fields unless sorting on a derived namedSelect column.\"]},\"select\":{\"language\":\"BQL with Oracle SQL-like SELECT syntax\",\"rules\":[\"Use a SELECT statement only.\",\"Reference only viewQueries aliases and namedSelects in FROM clauses.\",\"Reference field aliases, not raw business object field paths.\",\"Use Oracle SQL-style WHERE, GROUP BY, ORDER BY, UNION, UNION ALL, joins, CASE, DECODE, NVL, aggregate functions, date functions, subqueries, and bind variables when needed.\",\"WHERE predicates can use only fields exposed by the business view and marked searchable, unless filtering on a derived namedSelect output.\",\"ORDER BY can use only fields exposed by the business view and marked sortable, unless sorting on a derived namedSelect output.\",\"GROUP BY fields must be exposed by the business view or produced by a namedSelect.\",\"Alias computed output columns.\"]},\"nlToPayloadAlgorithm\":[\"Resolve the target business view from the natural language question.\",\"Load the business view metadata, including exposed field paths, labels, descriptions, data types, searchable, sortable, and enum metadata.\",\"Map natural language phrases to exposed business view field paths using labels, descriptions, field names, and curated synonyms only where needed.\",\"Reject or omit fields that are not exposed by the business view.\",\"Identify output fields, filter fields, grouping fields, sorting fields, joins, aggregations, and runtime values.\",\"Validate that every filter field is searchable.\",\"Validate that every sort field is sortable.\",\"Choose one or more viewQueries aliases for the required source business views.\",\"Populate fieldAliases for every field BQL needs.\",\"Add parameters for runtime values and wire them into viewParamMappings or BQL bind variables.\",\"Create namedSelects only when intermediate logic is useful or necessary.\",\"Create the top-level select using aliases declared earlier.\",\"Validate that every FROM source is declared and every selected, filtered, grouped, sorted, or joined field is available through fieldAliases or a namedSelect output.\"],\"validationChecklist\":[\"The payload has viewQueries and select.\",\"Every viewQueries entry has businessObject and fieldAliases.\",\"The selected business view is included in view when a non-default view is required.\",\"Every fieldAliases key is an exposed business view field path.\",\"Every field referenced in BQL appears as a fieldAliases value or namedSelect output.\",\"No BQL references raw accessor paths directly.\",\"Every filter field is searchable.\",\"Every sort field is sortable.\",\"Every parameter referenced as :parameterName or $parameters[\\\"parameterName\\\"] exists in parameters.\",\"Every namedSelect references only viewQueries aliases or earlier namedSelects.\",\"The top-level select returns deterministically aliased output columns.\",\"Every fieldAliases value matches ^[A-Za-z0-9]+$ with only ASCII letters and digits.\"]}"
            },
            {
              "id": "1781496759181_prjPjcVarUqOraErpCoreProjectAssetProjectAssetAssignmentsViewBVMetadata",
              "name": "prjPjcVarUqOraErpCoreProjectAssetProjectAssetAssignmentsViewBVMetadata",
              "value": "{\"bvLabel\":\"Project Asset Assignment\",\"bvDescription\":\"A project asset assignment determines how costs are collected and allocated for a project asset, whether as a specific asset allocation or as common costs allocation for related assets. A task assignment of project assets allocates all its capital costs to that asset, or you can designate these costs to be shared as common costs. When all task cost is shared across all assets or considered common cost, you can simply assign the assets to the project or mark the project as common cost.\",\"boQualifiedLabel\":\"Project Asset Assignment\",\"boDescription\":\"A project asset assignment determines how costs are collected and allocated for a project asset, whether as a specific asset allocation or as common costs allocation for related assets. A task assignment of project assets allocates all its capital costs to that asset, or you can designate these costs to be shared as common costs. When all task cost is shared across all assets or considered common cost, you can simply assign the assets to the project or mark the project as common cost.\",\"synonyms\":[],\"fields\":[{\"fieldPath\":\"id\",\"label\":\"Asset Assignment ID\",\"description\":\"Number that uniquely identifies the project asset assignment.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"timeUpdated\",\"label\":\"Last Updated Date\",\"description\":\"The date and time when the record was last updated.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"date-time\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"updatedBy\",\"label\":\"Last Updated By\",\"description\":\"The user who last updated the record.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"timeCreated\",\"label\":\"Creation Date\",\"description\":\"The date and time when the record was created.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"date-time\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"createdBy\",\"label\":\"Created By\",\"description\":\"The user who created the record.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"commonCostFlag\",\"label\":\"Common Cost\",\"description\":\"The common cost flag indicates whether this project asset assignment is for collecting common costs. If true, this project asset assignment is for collecting common costs. If false, this project asset assignment isn't for collecting common costs. The default value is False.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"project\":{\"accessorLabel\":\"Project\",\"accessorDescription\":\"A project represents the effort and resources required to achieve a significant business objective within a specific time frame. Projects are used to plan, track, manage, and control both the financial aspects and the work effort required.\",\"fields\":[{\"fieldPath\":\"project.id\",\"label\":\"Project ID\",\"description\":\"Unique identifier of the project.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.name\",\"label\":\"Project Name\",\"description\":\"Name of the project.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectNumber\",\"label\":\"Project Number\",\"description\":\"Number of the project.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.capitalEventProcessingMethod\",\"label\":\"Capital Event Processing Method\",\"description\":\"Indicates the capital event processing method used to control whether and how assets and costs are grouped over time.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"enumeration\",\"enumDescription\":\"Indicates the capital event processing method used to control whether and how assets and costs are grouped over time.\",\"enumValues\":{\"M\":{\"display\":\"Manual\",\"description\":\"Users manually create and manage each capital event for capitalization and retirement processing.\"},\"N\":{\"display\":\"Not used\",\"description\":\"Capital events aren't used. Capitalization and retirement processing occur without grouping by events.\"},\"P\":{\"display\":\"Periodic\",\"description\":\"Capital events are automatically created at scheduled intervals for capitalization and retirement processing.\"}},\"synonyms\":[]}],\"accessors\":{\"projectType\":{\"accessorLabel\":\"Project Type\",\"accessorDescription\":\"A project type is part of the classification for a project and provides the basic options for burdening, capitalization, billing, and sponsorship. Options at the project type level are inherited by each project associated with that project type. It can be used to group projects for reporting and to allocate costs.\",\"fields\":[{\"fieldPath\":\"project.projectType.id\",\"label\":\"Project Type ID\",\"description\":\"Unique identifier of the project type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectType.name\",\"label\":\"Name\",\"description\":\"Name of the project type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectType.enableBillingFlag\",\"label\":\"Enable Billing\",\"description\":\"Indicates whether projects with this project type are enabled for billing. If true, then cost transactions for the project can be billed. If false, then cost transactions are nonbillable. You can't change this option after creating projects or project templates using the project type.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectType.enableCapitalizationFlag\",\"label\":\"Enable Capitalization\",\"description\":\"Indicates whether projects with this project type are enabled for capitalization. If true, then cost transactions for the project can be capitalized as assets. If false, then cost transactions aren't capitalizable. You can't change this option after creating projects or project templates using the project type.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectType.enableBurdeningFlag\",\"label\":\"Enable Burdening\",\"description\":\"Indicates whether projects with this project type are enabled for burdening. Burdening is a method of applying one or more burden cost components to the raw cost amount of each transaction to calculate burden cost amounts. If true, then the project type is used to control how burden transactions are created and accounted for the project. If false, then costs are processed as raw costs. You can't change this option after creating projects or project templates using the project type.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectType.enableSponsoredProjectsFlag\",\"label\":\"Enable Sponsored Projects\",\"description\":\"Indicates whether projects with this project type are enabled for sponsorship. If true, then external sponsors, internal organizations, and other sources can fund the project. Only sponsored projects can be associated with awards. If false, then the project can't be sponsored. You can't change this option after creating projects or project templates using the project type.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectType.constructionInProgressCostBasis\",\"label\":\"Construction in Progress Cost Basis\",\"description\":\"Indicates whether construction in progress costs are capitalized at their burdened cost amount, which includes indirect expenses, or at their raw cost amount.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"enumeration\",\"enumDescription\":\"Indicates whether construction in progress costs are capitalized at their burdened cost amount, which includes indirect expenses, or at their raw cost amount.\",\"enumValues\":{\"B\":{\"display\":\"Burdened\",\"description\":\"Indicates construction in progress costs are capitalized at their burdened cost amount, which includes both direct costs and indirect costs, such as overhead and benefits.\"},\"R\":{\"display\":\"Raw\",\"description\":\"Indicates construction in progress costs are capitalized at their raw cost amount, without including any indirect expenses like overhead or benefits.\"}},\"synonyms\":[]}],\"accessors\":{}}}},\"task\":{\"accessorLabel\":\"Project Task\",\"accessorDescription\":\"A project task is a subdivision of project work to be performed within a defined period.\",\"fields\":[{\"fieldPath\":\"task.id\",\"label\":\"Task ID\",\"description\":\"Identifier of the project task.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"task.name\",\"label\":\"Task Name\",\"description\":\"Name of the project task.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"task.taskNumber\",\"label\":\"Task Number\",\"description\":\"Number of the project task that identifies it uniquely in the project task hierarchy.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"task.retirementCostFlag\",\"label\":\"Retirement Cost\",\"description\":\"Name of the project task.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"task.capitalizableFlag\",\"label\":\"Capitalizable Flag\",\"description\":\"Indicates whether the task is capitalizable.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"topTask\":{\"accessorLabel\":\"Project Task\",\"accessorDescription\":\"A project task is a subdivision of project work to be performed within a defined period.\",\"fields\":[{\"fieldPath\":\"task.topTask.id\",\"label\":\"Task ID\",\"description\":\"Identifier of the project task.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"task.topTask.name\",\"label\":\"Task Name\",\"description\":\"Name of the project task.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"task.topTask.taskNumber\",\"label\":\"Task Number\",\"description\":\"Number of the project task that identifies it uniquely in the project task hierarchy.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{}}}},\"projectAsset\":{\"accessorLabel\":\"Project Asset\",\"accessorDescription\":\"A project asset represents an asset, such as a building or software, that a capital project creates. A project asset is used to collect project costs on behalf of the asset. Once the project is complete, costs captured against project assets are transferred to corresponding final assets, where they represent their actual cost.\",\"fields\":[{\"fieldPath\":\"projectAsset.assetNumber\",\"label\":\"Asset Number\",\"description\":\"Number that uniquely identifies the project asset.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAsset.actualUnits\",\"label\":\"Actual Units\",\"description\":\"The number of asset units.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAsset.capitalHoldFlag\",\"label\":\"Capital Hold\",\"description\":\"The Capital Hold flag indicates if the generation of new asset lines should be prevented. If true, asset lines won't be generated. If false, asset lines will be generated. The default value is False.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAsset.capitalizedCost\",\"label\":\"Capitalized Cost\",\"description\":\"The project cost amount that has been capitalized.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAsset.capitalizedDate\",\"label\":\"Capitalized Date\",\"description\":\"The date on which project asset costs were last capitalized.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAsset.capitalizedFlag\",\"label\":\"Capitalized\",\"description\":\"The Capitalized flag indicates if a project asset has been capitalized. If true, the project asset has been capitalized. If false, it hasn't been capitalized. The default value is False.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAsset.assetPeriod\",\"label\":\"Asset Period\",\"description\":\"The name of the period in which the project asset was capitalized.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAsset.totalAssetCost\",\"label\":\"Total Asset Cost\",\"description\":\"The total asset cost, grouped into asset lines.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAsset.id\",\"label\":\"Project Asset ID\",\"description\":\"Unique identifier of the asset.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAsset.assetName\",\"label\":\"Asset Name\",\"description\":\"Name of the project asset.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"capitalEvent\":{\"accessorLabel\":\"Capital Event\",\"accessorDescription\":\"A capital event is an action that a project accountant must execute, either manually or periodically, to transfer project costs to designated project assets. You use capital events to group assets and costs on a project before you generate asset lines for capitalization and retirement cost processing.\",\"fields\":[{\"fieldPath\":\"projectAsset.capitalEvent.id\",\"label\":\"Capital Event ID\",\"description\":\"The unique identifier of the capital event.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAsset.capitalEvent.eventNumber\",\"label\":\"Event Number\",\"description\":\"The number of the capital event.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAsset.capitalEvent.createdBy\",\"label\":\"Created By\",\"description\":\"The user who created the record.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAsset.capitalEvent.timeCreated\",\"label\":\"Creation Date\",\"description\":\"The date and time when the record was created.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"date-time\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAsset.capitalEvent.eventName\",\"label\":\"Event Name\",\"description\":\"The name of the capital event.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAsset.capitalEvent.eventPeriod\",\"label\":\"Event Period\",\"description\":\"The period for which the capital event was created.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAsset.capitalEvent.timeUpdated\",\"label\":\"Last Updated Date\",\"description\":\"The date and time when the record was last updated.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"date-time\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAsset.capitalEvent.updatedBy\",\"label\":\"Last Updated By\",\"description\":\"The user who last updated the record.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{}},\"businessUnit\":{\"accessorLabel\":\"Business Unit\",\"accessorDescription\":\"A business unit represents a unit of an enterprise that performs one or more business functions and may have service provider relationships between the units. It typically focuses on a specific market segment, product line, geographic region, or set of services. The business transactions are recorded, reported, and accounted against the business unit.\",\"fields\":[{\"fieldPath\":\"projectAsset.businessUnit.id\",\"label\":\"Business Unit ID\",\"description\":\"The unique identifier of the business unit.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAsset.businessUnit.name\",\"label\":\"Business Unit\",\"description\":\"The translated name for the business unit.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAsset.businessUnit.effectiveStartDate\",\"label\":\"Start Date\",\"description\":\"The start date of the date range within which the business unit is effective.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAsset.businessUnit.effectiveEndDate\",\"label\":\"End Date\",\"description\":\"The end date of the date range within which the business unit is effective.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{}}}}}}"
            },
            {
              "id": "1781496759181_prjPjcVarUqOraErpCoreProjectAssetProjectAssetsViewBVMetadata",
              "name": "prjPjcVarUqOraErpCoreProjectAssetProjectAssetsViewBVMetadata",
              "value": "{\"bvLabel\":\"Project Assets\",\"bvDescription\":\"A project asset represents an asset, such as a building or software, that a capital project creates. A project asset is used to collect project costs on behalf of the asset. Once the project is complete, costs captured against project assets are transferred to corresponding final assets, where they represent their actual cost.\",\"boQualifiedLabel\":\"Project Assets\",\"boDescription\":\"A project asset represents an asset, such as a building or software, that a capital project creates. A project asset is used to collect project costs on behalf of the asset. Once the project is complete, costs captured against project assets are transferred to corresponding final assets, where they represent their actual cost.\",\"synonyms\":[],\"fields\":[{\"fieldPath\":\"amortizeAdjustmentsFlag\",\"label\":\"Amortize Adjustments\",\"description\":\"The Amortize flag indicates whether cost adjustments to project assets will be amortized. If true, cost adjustments will be amortized. If false, cost adjustments won't be amortized. The default value is True.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"description\",\"label\":\"Description\",\"description\":\"Description of the project asset.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"assetNumber\",\"label\":\"Asset Number\",\"description\":\"Number that uniquely identifies the project asset.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"actualUnits\",\"label\":\"Actual Units\",\"description\":\"The number of asset units.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"capitalHoldFlag\",\"label\":\"Capital Hold\",\"description\":\"The Capital Hold flag indicates if the generation of new asset lines should be prevented. If true, asset lines won't be generated. If false, asset lines will be generated. The default value is False.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"capitalizedCost\",\"label\":\"Capitalized Cost\",\"description\":\"The project cost amount that has been capitalized.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"capitalizedDate\",\"label\":\"Capitalized Date\",\"description\":\"The date on which project asset costs were last capitalized.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"capitalizedFlag\",\"label\":\"Capitalized\",\"description\":\"The Capitalized flag indicates if a project asset has been capitalized. If true, the project asset has been capitalized. If false, it hasn't been capitalized. The default value is False.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"costAdjustmentFlag\",\"label\":\"Cost Adjustment\",\"description\":\"The Cost Adjustment flag indicates whether asset cost adjustments have been capitalized. If true, cost adjustments have been capitalized. If false, cost adjustments haven't been capitalized. The default value is False.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"createdBy\",\"label\":\"Created By\",\"description\":\"The user who created the record.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"timeCreated\",\"label\":\"Creation Date\",\"description\":\"The date and time when the record was created.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"date-time\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"actualInServiceOrRetirementDate\",\"label\":\"Actual In-Service or Retirement Date\",\"description\":\"The actual in-service date is the date on which you begin using an asset or the date of the retirement adjustment. This date must be specified before the asset is capitalized.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"depreciateFlag\",\"label\":\"Depreciate\",\"description\":\"The Depreciate flag indicates whether an asset will be depreciated. If true, this asset should be depreciated. If false, it won't be depreciated. The default value is True.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"estimatedUnits\",\"label\":\"Estimated Units\",\"description\":\"The estimated number of asset units.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"estimatedCost\",\"label\":\"Estimated Cost\",\"description\":\"The estimated cost of the asset.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"estimatedInServiceOrRetirementDate\",\"label\":\"Estimated In-Service or Retirement Date\",\"description\":\"The estimated in-service or retirement date is the date on which an asset is planned to be placed in service or retired.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"assetPeriod\",\"label\":\"Asset Period\",\"description\":\"The name of the period in which the project asset was capitalized.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"totalAssetCost\",\"label\":\"Total Asset Cost\",\"description\":\"The total asset cost, grouped into asset lines.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"timeUpdated\",\"label\":\"Last Updated Date\",\"description\":\"The date and time when the record was last updated.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"date-time\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"updatedBy\",\"label\":\"Last Updated By\",\"description\":\"The user who last updated the record.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"manufacturerName\",\"label\":\"Manufacturer\",\"description\":\"Name of the manufacturer of the asset.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"modelNumber\",\"label\":\"Model Number\",\"description\":\"The model number of the asset.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"overrideCategoryAndDescriptionFlag\",\"label\":\"Override Category and Description\",\"description\":\"Determines whether a cost adjustment will reclassify the already capitalized asset to another asset category. If true, the category will be reclassified. If false, the update to the asset category will be ignored. The default value is False.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"sourceReference\",\"label\":\"Source Reference\",\"description\":\"Identifier of the project in the external project management system from which the project asset was imported.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"id\",\"label\":\"Project Asset ID\",\"description\":\"Unique identifier of the asset.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"assetName\",\"label\":\"Asset Name\",\"description\":\"Name of the project asset.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"reversalDate\",\"label\":\"Reversal Date\",\"description\":\"The last date on which reversing asset lines were created. This is a system-generated date.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"reverseFlag\",\"label\":\"Reverse\",\"description\":\"The Reverse flag indicates if the project asset should be reversed. If true, the project asset will be reversed. If false, the project asset won't be reversed. The default value is False.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"serialNumber\",\"label\":\"Serial Number\",\"description\":\"The serial number of the asset, as provided by the manufacturer of the asset.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"tagNumber\",\"label\":\"Tag Number\",\"description\":\"A tag number is a unique value created by the team that owns the asset. A tag number is used to identify the asset within the deploying organization.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"project\":{\"accessorLabel\":\"Project\",\"accessorDescription\":\"A project represents the effort and resources required to achieve a significant business objective within a specific time frame. Projects are used to plan, track, manage, and control both the financial aspects and the work effort required.\",\"fields\":[{\"fieldPath\":\"project.id\",\"label\":\"Project ID\",\"description\":\"Unique identifier of the project.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.name\",\"label\":\"Project Name\",\"description\":\"Name of the project.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectNumber\",\"label\":\"Project Number\",\"description\":\"Unique identifier of the project.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.capitalEventProcessingMethod\",\"label\":\"Capital Event Processing Method\",\"description\":\"Method used to process capital events.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"enumeration\",\"enumDescription\":\"Method used to process capital events.\",\"enumValues\":{\"M\":{\"display\":\"Manual\",\"description\":\"\"},\"N\":{\"display\":\"Not used\",\"description\":\"\"},\"P\":{\"display\":\"Periodic\",\"description\":\"\"}},\"synonyms\":[]}],\"accessors\":{\"projectType\":{\"accessorLabel\":\"Project Type\",\"accessorDescription\":\"A project type is part of the classification for a project and provides the basic options for burdening, capitalization, billing, and sponsorship. Options at the project type level are inherited by each project associated with that project type. It can be used to group projects for reporting and to allocate costs.\",\"fields\":[{\"fieldPath\":\"project.projectType.id\",\"label\":\"Project Type ID\",\"description\":\"Unique identifier of the project type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectType.name\",\"label\":\"Name\",\"description\":\"Name of the project type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectType.enableBillingFlag\",\"label\":\"Enable Billing\",\"description\":\"Indicates whether projects with this project type are enabled for billing. If true, then cost transactions for the project can be billed. If false, then cost transactions are nonbillable. You can't change this option after creating projects or project templates using the project type.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectType.enableCapitalizationFlag\",\"label\":\"Enable Capitalization\",\"description\":\"Indicates whether projects with this project type are enabled for capitalization. If true, then cost transactions for the project can be capitalized as assets. If false, then cost transactions aren't capitalizable. You can't change this option after creating projects or project templates using the project type.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectType.enableBurdeningFlag\",\"label\":\"Enable Burdening\",\"description\":\"Indicates whether projects with this project type are enabled for burdening. Burdening is a method of applying one or more burden cost components to the raw cost amount of each transaction to calculate burden cost amounts. If true, then the project type is used to control how burden transactions are created and accounted for the project. If false, then costs are processed as raw costs. You can't change this option after creating projects or project templates using the project type.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectType.enableSponsoredProjectsFlag\",\"label\":\"Enable Sponsored Projects\",\"description\":\"Indicates whether projects with this project type are enabled for sponsorship. If true, then external sponsors, internal organizations, and other sources can fund the project. Only sponsored projects can be associated with awards. If false, then the project can't be sponsored. You can't change this option after creating projects or project templates using the project type.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectType.constructionInProgressCostBasis\",\"label\":\"Construction in Progress Cost Basis\",\"description\":\"Cost basis for construction in progress.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"enumeration\",\"enumDescription\":\"Cost basis for construction in progress.\",\"enumValues\":{\"B\":{\"display\":\"Burdened\",\"description\":\"\"},\"R\":{\"display\":\"Raw\",\"description\":\"\"}},\"synonyms\":[]}],\"accessors\":{}}}},\"businessUnit\":{\"accessorLabel\":\"Business Unit\",\"accessorDescription\":\"A business unit represents a unit of an enterprise that performs one or more business functions and may have service provider relationships between the units. It typically focuses on a specific market segment, product line, geographic region, or set of services. The business transactions are recorded, reported, and accounted against the business unit.\",\"fields\":[{\"fieldPath\":\"businessUnit.id\",\"label\":\"Business Unit ID\",\"description\":\"The unique identifier of the business unit.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"businessUnit.name\",\"label\":\"Business Unit\",\"description\":\"The translated name for the business unit.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"businessUnit.effectiveStartDate\",\"label\":\"Start Date\",\"description\":\"The start date of the date range within which the business unit is effective.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"businessUnit.effectiveEndDate\",\"label\":\"End Date\",\"description\":\"The end date of the date range within which the business unit is effective.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{}},\"assetType\":{\"accessorLabel\":\"Asset Type\",\"accessorDescription\":\"An asset type indicates whether an asset's costs are used as estimates for planning purposes, actively being collected as construction progresses, or used to collect retirement adjustment costs.\",\"fields\":[{\"fieldPath\":\"assetType.lookupType\",\"label\":\"Lookup Type ID\",\"description\":\"The unique identifier of the Lookup Type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"assetType.lookupCode\",\"label\":\"Lookup Code ID\",\"description\":\"The unique identifier of the Lookup Code.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"assetType.meaning\",\"label\":\"Lookup Code Meaning\",\"description\":\"The translated meaning of the Lookup Code.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Standard Lookup Code\",\"boDescription\":\"The standard lookup codes list of values resource is used to query the list of standard lookup codes.\"},\"assetBook\":{\"accessorLabel\":\"Book\",\"accessorDescription\":\"A book represents the grouping in which fixed assets of the entity are recorded, tracked, depreciated, reported, and accounted for in the primary ledger.\",\"fields\":[{\"fieldPath\":\"assetBook.name\",\"label\":\"Book\",\"description\":\"The name of the asset book.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"assetBook.description\",\"label\":\"Description\",\"description\":\"Asset book description.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Asset Book\"},\"assetCategoryStandardUnitCost\":{\"accessorLabel\":\"Asset Category Standard Unit Cost\",\"accessorDescription\":\"The standard unit cost is a monetary value assigned to a specific combination of an asset category and an asset book. The standard unit cost is multiplied by actual units as an option for allocating costs.\",\"fields\":[{\"fieldPath\":\"assetCategoryStandardUnitCost.id\",\"label\":\"Asset Category Standard Unit Cost ID\",\"description\":\"The unique identifier of the asset category standard unit cost.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"assetCategoryStandardUnitCost.assetBookName\",\"label\":\"Asset Book Name\",\"description\":\"The name of the asset book.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"assetCategoryStandardUnitCost.assetCategoryId\",\"label\":\"Asset Category ID\",\"description\":\"The identifier of the asset category.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Asset Category Standard Unit Cost\"},\"capitalEvent\":{\"accessorLabel\":\"Capital Event\",\"accessorDescription\":\"A capital event is an action that a project accountant must execute, either manually or periodically, to transfer project costs to designated project assets. You use capital events to group assets and costs on a project before you generate asset lines for capitalization and retirement cost processing.\",\"fields\":[{\"fieldPath\":\"capitalEvent.id\",\"label\":\"Capital Event ID\",\"description\":\"The unique identifier of the capital event.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"capitalEvent.eventNumber\",\"label\":\"Event Number\",\"description\":\"The number of the capital event.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"capitalEvent.eventName\",\"label\":\"Event Name\",\"description\":\"The name of the capital event.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"capitalEvent.eventPeriod\",\"label\":\"Event Period\",\"description\":\"The period for which the capital event was created.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Capital Event\"},\"assetCategory\":{\"accessorLabel\":\"Asset Category\",\"accessorDescription\":\"A category represents the classification of assets, such as buildings, computer equipment, furniture and fixtures, and land. Assets are grouped based on the financial accounts and depreciation rules.\",\"fields\":[{\"fieldPath\":\"assetCategory.categoryId\",\"label\":\"Category ID\",\"description\":\"The identifier of the asset category.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"assetCategory.structureInstanceNumber\",\"label\":\"Instance Number\",\"description\":\"Code that identifies the Asset Category flexfield structure.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{}},\"location\":{\"accessorLabel\":\"Location\",\"accessorDescription\":\"A location stores the location information of a fixed asset, such as the country, state or province, county, city, and building.\",\"fields\":[{\"fieldPath\":\"location.locationId\",\"label\":\"Location ID\",\"description\":\"Code that identifies the asset location.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"location.structureInstanceNumber\",\"label\":\"Instance Number\",\"description\":\"The structure instance number of a location flexfield structure.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Asset Location\"},\"custodian\":{\"accessorLabel\":\"Custodian\",\"accessorDescription\":\"An asset custodian is the person responsible for safeguarding the asset assigned to them.\",\"fields\":[{\"fieldPath\":\"custodian.id\",\"label\":\"Person ID\",\"description\":\"Unique identifier of the person.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"personDetail\":{\"accessorLabel\":\"Person Detail\",\"accessorDescription\":\"Person details for the worker.\",\"fields\":[{\"fieldPath\":\"custodian.personDetail.id\",\"label\":\"Person Detail ID\",\"description\":\"Unique identifier of the person detail.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"custodian.personDetail.effectiveStartDate\",\"label\":\"Effective Start Date\",\"description\":\"Date when the person detail becomes effective.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"custodian.personDetail.effectiveEndDate\",\"label\":\"Effective End Date\",\"description\":\"Date when the person detail is no longer effective.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"custodian.personDetail.personNumber\",\"label\":\"Person Number\",\"description\":\"Number that identifies the person.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boDescription\":\"Person detail.\"}},\"boQualifiedLabel\":\"Worker\",\"boDescription\":\"Worker resource.\"},\"depreciationExpenseAccount\":{\"accessorLabel\":\"Depreciation Expense Account\",\"accessorDescription\":\"A depreciation expense account periodically records the expense representing the usage of an asset over its life. This account contains a series of accounting codes that indicate where this expense must be recorded.\",\"fields\":[{\"fieldPath\":\"depreciationExpenseAccount.codeCombinationId\",\"label\":\"Account ID\",\"description\":\"The unique identifier of the account combination.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"depreciationExpenseAccount.chartOfAccountsId\",\"label\":\"Chart of Accounts\",\"description\":\"The unique identifier of the chart of accounts.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"depreciationExpenseAccount.concatenatedSegments\",\"label\":\"Concatenated Segment Values\",\"description\":\"The concatenated full account combination.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"General Ledger Account\",\"boDescription\":\"A general ledger account combination represents the specific grouping of segment values within the Oracle General Ledger. It provides details of all the valid account combinations for each accounting flexfield structure within the General Ledger.\"},\"assetKey\":{\"accessorLabel\":\"Asset Key\",\"accessorDescription\":\"An asset key is a company defined field that's used for grouping and reporting on assets. For example, you can use asset keys to group together project assets that are associated with the same asset, such as assets with a 160CC stroke gas engine.\",\"fields\":[{\"fieldPath\":\"assetKey.codeCombinationId\",\"label\":\"Asset Key ID\",\"description\":\"The identifier of the asset key code combinations. The unique identifier of the asset that contains the information for an asset.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"assetKey.structureInstanceNumber\",\"label\":\"Instance Number\",\"description\":\"structure instance for a particular flexfield structure.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"assetKey.assetKeyConcatenatedSegment\",\"label\":\"Asset Key Concatenated Segment\",\"description\":\"Concatenated asset key segment values.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boDescription\":\"An asset key contains valid asset key flexfield segment value combinations in the segment columns for an asset in the asset book.\"},\"parentAsset\":{\"accessorLabel\":\"Parent Asset\",\"accessorDescription\":\"A parent asset is an asset that contains child assets. For example, a truck is a parent asset, and an dump body is a child asset.\",\"fields\":[{\"fieldPath\":\"parentAsset.assetId\",\"label\":\"Asset ID\",\"description\":\"Number that identifies the asset.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"parentAsset.assetNumber\",\"label\":\"Asset Number\",\"description\":\"Unique identifier of the asset.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Asset\",\"boDescription\":\"An asset contains the descriptive information such as units, asset type, tag number, manufacturer number, serial number, and model number added in the asset book.\"},\"targetAsset\":{\"accessorLabel\":\"Target Asset\",\"accessorDescription\":\"A target asset is a group asset that's used to capture asset retirement adjustment costs.\",\"fields\":[{\"fieldPath\":\"targetAsset.assetId\",\"label\":\"Asset ID\",\"description\":\"Number that identifies the asset.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"targetAsset.assetNumber\",\"label\":\"Asset Number\",\"description\":\"Unique identifier of the asset.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Asset\",\"boDescription\":\"An asset contains the descriptive information such as units, asset type, tag number, manufacturer number, serial number, and model number added in the asset book.\"},\"asset\":{\"accessorLabel\":\"Asset\",\"accessorDescription\":\"An asset is an item of value that you plan to build. Once constructed, it becomes property and can be tracked and depreciated. Examples of assets include buildings and software. An asset contains attributes, such as unit, asset type, tag number, manufacturer number, serial number, and model number, which are added in the asset book.\",\"fields\":[{\"fieldPath\":\"asset.assetId\",\"label\":\"Asset ID\",\"description\":\"Number that identifies the asset.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"asset.assetNumber\",\"label\":\"Asset Number\",\"description\":\"Unique identifier of the asset.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boDescription\":\"An asset contains the descriptive information such as units, asset type, tag number, manufacturer number, serial number, and model number added in the asset book.\"},\"sourceApplication\":{\"accessorLabel\":\"Source Application\",\"accessorDescription\":\"Application, either Oracle Fusion or a third party that integrates with Project Financial Management.\",\"fields\":[{\"fieldPath\":\"sourceApplication.lookupType\",\"label\":\"Lookup Type ID\",\"description\":\"The unique identifier of the Lookup Type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"sourceApplication.lookupCode\",\"label\":\"Lookup Code ID\",\"description\":\"The unique identifier of the Lookup Code.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"sourceApplication.meaning\",\"label\":\"Lookup Code Meaning\",\"description\":\"The translated meaning of the Lookup Code.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Standard Lookup Code\",\"boDescription\":\"The standard lookup codes list of values resource is used to query the list of standard lookup codes.\"}}}"
            },
            {
              "id": "1781496759181_prjPjcVarUqOraErpCoreProjectCostTransactionsProjectCostTransactionDetailsBVMetadata",
              "name": "prjPjcVarUqOraErpCoreProjectCostTransactionsProjectCostTransactionDetailsBVMetadata",
              "value": "{\"bvLabel\":\"Project Cost Transactions\",\"bvDescription\":\"This view lists transaction details associated with project costs from all transaction sources.\",\"boQualifiedLabel\":\"Project Cost Transaction\",\"boDescription\":\"A project cost transaction is a record of the cost attributable to a project. Additional transactional information on quantity, effort, unit of measure, cost type, cost organization, and transaction source are also captured for each project cost transaction. Project cost transactions form the basis of actual cost and effort measurements in the project management lifecycle. They're integral to the creation of construction-in-process (CIP) asset lines, project contract revenue transactions, project contract bill transactions, and invoices. Project cost transactions are also critical for project financial analysis, budgeting, and forecasting.\",\"synonyms\":[],\"fields\":[{\"fieldPath\":\"transactionNumber\",\"label\":\"Transaction Number\",\"description\":\"The transaction number of the project cost transaction.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"transactionDate\",\"label\":\"Transaction Date\",\"description\":\"Date on which the actions or activity resulting in the project cost was performed. The transaction date can be different from the creation date. It can be pre- or post-dated to achieve business requirements if needed. The transaction date is also used to perform accounting period related validations on project cost transactions.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"originalTransactionReference\",\"label\":\"Original Transaction Reference\",\"description\":\"The original transaction reference of the project cost.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"netZeroItemFlag\",\"label\":\"Net Zero Item\",\"description\":\"Indicates whether the project cost transaction is fully reversed or the transaction is one of the adjusting transactions that fully reverses another transaction.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"transferredFromTransactionNumber\",\"label\":\"Transferred from Transaction Number\",\"description\":\"The transaction number of the original project cost, which was transferred from a different project, task, contract, or funding source resulting in the creation of this project cost.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"adjustingTransactionNumber\",\"label\":\"Adjusted Transaction Number\",\"description\":\"Identifies the transaction number of the project cost whose adjustment resulted in a reversal that's this project cost transaction.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"accrualFlag\",\"label\":\"Accrual\",\"description\":\"A project cost transaction that accrues project cost in one period and reverses it automatically in the next period.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"providerAccrualDate\",\"label\":\"Provider Accrual Date\",\"description\":\"The date on which the project cost transaction was included in an accrual batch in the provider organization.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"receiverAccrualDate\",\"label\":\"Receiver Accrual Date\",\"description\":\"The date on which the project cost transaction was included in an accrual batch in the receiver organization.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"createdBy\",\"label\":\"Created By\",\"description\":\"The user who created the record.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"timeCreated\",\"label\":\"Creation Date\",\"description\":\"The date and time when the record was created.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"date-time\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"updatedBy\",\"label\":\"Last Updated By\",\"description\":\"The user who last updated the record.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"timeUpdated\",\"label\":\"Last Updated Date\",\"description\":\"The date and time when the record was last updated.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"date-time\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"burdenedCostInReceiverLedgerCurrency\",\"label\":\"Burdened Cost in Receiver Ledger Currency\",\"description\":\"The burdened cost of a transaction in the project ledger currency.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"rawCostInReceiverLedgerCurrency\",\"label\":\"Raw Cost in Receiver Ledger Currency\",\"description\":\"The raw cost of a transaction in the receiver ledger currency.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"salesOrderNumber\",\"label\":\"Sales Order Number\",\"description\":\"A number that uniquely identifies a sales order.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"shipmentNumber\",\"label\":\"Shipment Number\",\"description\":\"A number that uniquely identifies a shipment.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"workOrderNumber\",\"label\":\"Work Order Number\",\"description\":\"A number that uniquely identifies a work order.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"invoiceNumber\",\"label\":\"Invoice Number\",\"description\":\"A number that uniquely identifies an invoice in the Payables application.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"receiptNumber\",\"label\":\"Receipt Number\",\"description\":\"A number that uniquely identifies a receipt associated with an item or service.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"purchaseOrderNumber\",\"label\":\"Purchase Order Number\",\"description\":\"A number that uniquely identifies a purchase order in the Purchasing application.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"paymentNumber\",\"label\":\"Payment Number\",\"description\":\"A number that uniquely identifies a payment made to a supplier, in the Payables application.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"transferOrderNumber\",\"label\":\"Transfer Order Number\",\"description\":\"A number that uniquely identifies an order for the transfer of materials in or out of a warehouse.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"includedInAssetLine\",\"label\":\"Included in Asset Line\",\"description\":\"Indicates whether the cost is grouped into asset lines. When true, it's included in one or more asset lines. When false, it's not included.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"burdenedCostInProviderLedgerCurrency\",\"label\":\"Burdened Cost in Provider Ledger Currency\",\"description\":\"The burdened cost for the transaction in the ledger currency of the provider organization.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"rawCostInProviderLedgerCurrency\",\"label\":\"Raw Cost in Provider Ledger Currency\",\"description\":\"The raw cost for the transaction in the ledger currency of the provider organization.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"burdenedCostInTransactionCurrency\",\"label\":\"Burdened Cost in Transaction Currency\",\"description\":\"The burdened cost of a transaction in the transaction currency.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"rawCostInTransactionCurrency\",\"label\":\"Raw Cost in Transaction Currency\",\"description\":\"The raw cost of a transaction in the transaction currency.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"quantity\",\"label\":\"Quantity\",\"description\":\"The quantity associated with a project cost transaction.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"project\":{\"accessorLabel\":\"Project\",\"accessorDescription\":\"A project represents the effort and resources required to achieve a significant business objective within a specific time frame. Projects are used to plan, track, manage, and control both the financial aspects and the work effort required.\",\"fields\":[{\"fieldPath\":\"project.id\",\"label\":\"Project ID\",\"description\":\"Unique identifier of the project.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.name\",\"label\":\"Project Name\",\"description\":\"Name of the project.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectNumber\",\"label\":\"Project Number\",\"description\":\"Number of the project.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.capitalEventProcessingMethod\",\"label\":\"Capital Event Processing Method\",\"description\":\"Indicates the capital event processing method used to control whether and how assets and costs are grouped over time.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"enumeration\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"projectBusinessUnitConfiguration\":{\"accessorLabel\":\"Project Business Unit Configuration\",\"accessorDescription\":\"Business unit-level settings which control specific aspects of how the Project Management application functions, such as which project organization trees to use, how to convert currencies, and how to process cross-charges within a legal entity.\",\"fields\":[{\"fieldPath\":\"project.projectBusinessUnitConfiguration.businessUnitId\",\"label\":\"Business Unit ID\",\"description\":\"The unique identifier of the business unit in which the Project Management application is configured.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"projectFinancialCalendar\":{\"accessorLabel\":\"Project Accounting Calendar\",\"accessorDescription\":\"A calendar used for financial project planning, costing, billing, budgeting, forecasting, and performance reporting.\",\"fields\":[{\"fieldPath\":\"project.projectBusinessUnitConfiguration.projectFinancialCalendar.calendarId\",\"label\":\"Calendar ID\",\"description\":\"The unique identifier of an accounting or commitment calendar.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectBusinessUnitConfiguration.projectFinancialCalendar.periodSetName\",\"label\":\"Accounting Calendar\",\"description\":\"Name of the accounting calendar.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectBusinessUnitConfiguration.projectFinancialCalendar.periodType\",\"label\":\"Period Type\",\"description\":\"The frequency of the accounting period, such as, Weekly, Monthly, and Quarterly. The list of accepted values for period frequency can be found in the lookup type CAL_NON_ADJ_FREQ. When creating a calendar with period frequency codes, the period type is concatenated with a unique number. For example, MONTH2558721688.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Accounting Calendar\",\"boDescription\":\"An accounting calendar contains the periods of an accounting year. For example, one company can have a fiscal calendar that starts in May and ends in June. Another company can use calendars based on the calendar year, January to December.\"}}},\"projectType\":{\"accessorLabel\":\"Project Type\",\"accessorDescription\":\"A project type is part of the classification for a project and provides the basic options for burdening, capitalization, billing, and sponsorship. Options at the project type level are inherited by each project associated with that project type. It can be used to group projects for reporting and to allocate costs.\",\"fields\":[{\"fieldPath\":\"project.projectType.id\",\"label\":\"Project Type ID\",\"description\":\"Unique identifier of the project type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectType.name\",\"label\":\"Name\",\"description\":\"Name of the project type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectType.enableBillingFlag\",\"label\":\"Enable Billing\",\"description\":\"Indicates whether projects with this project type are enabled for billing. If true, then cost transactions for the project can be billed. If false, then cost transactions are nonbillable. You can't change this option after creating projects or project templates using the project type.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectType.enableCapitalizationFlag\",\"label\":\"Enable Capitalization\",\"description\":\"Indicates whether projects with this project type are enabled for capitalization. If true, then cost transactions for the project can be capitalized as assets. If false, then cost transactions aren't capitalizable. You can't change this option after creating projects or project templates using the project type.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectType.enableBurdeningFlag\",\"label\":\"Enable Burdening\",\"description\":\"Indicates whether projects with this project type are enabled for burdening. Burdening is a method of applying one or more burden cost components to the raw cost amount of each transaction to calculate burden cost amounts. If true, then the project type is used to control how burden transactions are created and accounted for the project. If false, then costs are processed as raw costs. You can't change this option after creating projects or project templates using the project type.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectType.enableSponsoredProjectsFlag\",\"label\":\"Enable Sponsored Projects\",\"description\":\"Indicates whether projects with this project type are enabled for sponsorship. If true, then external sponsors, internal organizations, and other sources can fund the project. Only sponsored projects can be associated with awards. If false, then the project can't be sponsored. You can't change this option after creating projects or project templates using the project type.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectType.constructionInProgressCostBasis\",\"label\":\"Construction in Progress Cost Basis\",\"description\":\"Indicates whether construction in progress costs are capitalized at their burdened cost amount, which includes indirect expenses, or at their raw cost amount.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"enumeration\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{}},\"status\":{\"accessorLabel\":\"Status\",\"accessorDescription\":\"The status management settings for projects. It includes available status values, such as Draft, Active, and Closed. It also includes the next allowable statuses and action controls that determine the actions allowed for a project in a given status.\",\"fields\":[{\"fieldPath\":\"project.status.code\",\"label\":\"Status Code\",\"description\":\"The code that uniquely identifies a status value.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Status\"}}},\"providerLegalEntity\":{\"accessorLabel\":\"Provider Legal Entity\",\"accessorDescription\":\"A legal entity represents an entity created under a commercial law which can own property, create obligation, recruit people, trade, account for themselves to regulators, taxation authorities, and owners. It identifies the legal owner or custodian for each business transaction for legal compliance and reporting.\",\"fields\":[{\"fieldPath\":\"providerLegalEntity.legalEntityId\",\"label\":\"Legal Entity ID\",\"description\":\"The unique identifier of the legal entity. This is the primary key of the Legal Entities view object.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"providerLegalEntity.legalEntityName\",\"label\":\"Legal Entity Name\",\"description\":\"The name of the legal entity.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Legal Entity\"},\"providerLedgerCurrency\":{\"accessorLabel\":\"Provider Ledger Currency\",\"accessorDescription\":\"The currency of the provider ledger.\",\"fields\":[{\"fieldPath\":\"providerLedgerCurrency.currencyCode\",\"label\":\"Currency Code\",\"description\":\"The currency in which an amount or a conversion rate is denominated.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Currency\",\"boDescription\":\"Currencies are defined and populated through seed data and used to create transactions within the application. This object encapsulates various properties and functionalities related to a specific currency.\"},\"receiverLedgerCurrency\":{\"accessorLabel\":\"Receiver Ledger Currency\",\"accessorDescription\":\"The currency of the receiver ledger.\",\"fields\":[{\"fieldPath\":\"receiverLedgerCurrency.currencyCode\",\"label\":\"Currency Code\",\"description\":\"The currency in which an amount or a conversion rate is denominated.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"receiverLedgerCurrency.symbol\",\"label\":\"Symbol\",\"description\":\"The symbol used to represent the currency.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Currency\",\"boDescription\":\"Currencies are defined and populated through seed data and used to create transactions within the application. This object encapsulates various properties and functionalities related to a specific currency.\"},\"task\":{\"accessorLabel\":\"Project Task\",\"accessorDescription\":\"A project task is a subdivision of project work to be performed within a defined period.\",\"fields\":[{\"fieldPath\":\"task.id\",\"label\":\"Task ID\",\"description\":\"Identifier of the project task.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"task.name\",\"label\":\"Task Name\",\"description\":\"Name of the project task.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"task.taskNumber\",\"label\":\"Task Number\",\"description\":\"Number of the project task that identifies it uniquely in the project task hierarchy.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"task.retirementCostFlag\",\"label\":\"Retirement Cost\",\"description\":\"Name of the project task.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"task.capitalizableFlag\",\"label\":\"Capitalizable Flag\",\"description\":\"Indicates whether the task is capitalizable.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"topTask\":{\"accessorLabel\":\"Project Task\",\"accessorDescription\":\"A project task is a subdivision of project work to be performed within a defined period.\",\"fields\":[{\"fieldPath\":\"task.topTask.id\",\"label\":\"Task ID\",\"description\":\"Identifier of the project task.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"task.topTask.name\",\"label\":\"Task Name\",\"description\":\"Name of the project task.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"task.topTask.taskNumber\",\"label\":\"Task Number\",\"description\":\"Number of the project task that identifies it uniquely in the project task hierarchy.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{}}}},\"billable\":{\"accessorLabel\":\"Billable\",\"accessorDescription\":\"Indicates the billable status of the cost transaction.\",\"fields\":[{\"fieldPath\":\"billable.lookupType\",\"label\":\"Lookup Type ID\",\"description\":\"The unique identifier of the Lookup Type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"billable.lookupCode\",\"label\":\"Lookup Code ID\",\"description\":\"The unique identifier of the Lookup Code.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"billable.meaning\",\"label\":\"Lookup Code Meaning\",\"description\":\"The translated meaning of the Lookup Code.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Standard Lookup Code\",\"boDescription\":\"The standard lookup codes list of values resource is used to query the list of standard lookup codes.\"},\"capitalizable\":{\"accessorLabel\":\"Capitalizable\",\"accessorDescription\":\"Indicates the capitalizable status of the cost transaction.\",\"fields\":[{\"fieldPath\":\"capitalizable.lookupType\",\"label\":\"Lookup Type ID\",\"description\":\"The unique identifier of the Lookup Type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"capitalizable.lookupCode\",\"label\":\"Lookup Code ID\",\"description\":\"The unique identifier of the Lookup Code.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"capitalizable.meaning\",\"label\":\"Lookup Code Meaning\",\"description\":\"The translated meaning of the Lookup Code.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Standard Lookup Code\",\"boDescription\":\"The standard lookup codes list of values resource is used to query the list of standard lookup codes.\"},\"adjustmentStatus\":{\"accessorLabel\":\"Adjustment Status\",\"accessorDescription\":\"Indicates whether the related adjustment is pending or rejected.\",\"fields\":[{\"fieldPath\":\"adjustmentStatus.lookupType\",\"label\":\"Lookup Type ID\",\"description\":\"The unique identifier of the Lookup Type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"adjustmentStatus.lookupCode\",\"label\":\"Lookup Code ID\",\"description\":\"The unique identifier of the Lookup Code.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"adjustmentStatus.meaning\",\"label\":\"Lookup Code Meaning\",\"description\":\"The translated meaning of the Lookup Code.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Standard Lookup Code\",\"boDescription\":\"The standard lookup codes list of values resource is used to query the list of standard lookup codes.\"},\"projectRole\":{\"accessorLabel\":\"Project Role\",\"accessorDescription\":\"The role that a worker performs on a project. Project roles can be used to request, fulfill, and manage labor resources on projects, as well as secure user access to projects and related transactions.\",\"fields\":[{\"fieldPath\":\"projectRole.id\",\"label\":\"Project Role ID\",\"description\":\"The unique identifier of the project role.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectRole.name\",\"label\":\"Name\",\"description\":\"The name of the project role.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{}},\"unitOfMeasure\":{\"accessorLabel\":\"Unit of Measure\",\"accessorDescription\":\"The unit of measure, such as hours or currency.\",\"fields\":[{\"fieldPath\":\"unitOfMeasure.code\",\"label\":\"Code\",\"description\":\"The unique code of the unit of measure.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"unitOfMeasure.name\",\"label\":\"Name\",\"description\":\"Name of the unit of measure.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boDescription\":\"This view lists units of measure used for project-related activities such as planning, rate calculations, and cost transactions. Values include currency and hours plus those defined for supply chain management.\"},\"projectCostType\":{\"accessorLabel\":\"Cost Type\",\"accessorDescription\":\"A cost type is a classification of cost for a project expenditure.\",\"fields\":[{\"fieldPath\":\"projectCostType.id\",\"label\":\"Cost Type ID\",\"description\":\"Unique identifier of the cost type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectCostType.name\",\"label\":\"Expenditure Type\",\"description\":\"Name of the cost type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"revenueCategory\":{\"accessorLabel\":\"Revenue Category\",\"accessorDescription\":\"A revenue category describes a source of revenue for the organization and helps to classify and group revenue streams. Examples of revenue categories include project labor, fixed price contracts, and billable indirect costs.\",\"fields\":[{\"fieldPath\":\"projectCostType.revenueCategory.lookupType\",\"label\":\"Lookup Type ID\",\"description\":\"The unique identifier of the Lookup Type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectCostType.revenueCategory.lookupCode\",\"label\":\"Lookup Code ID\",\"description\":\"The unique identifier of the Lookup Code.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectCostType.revenueCategory.meaning\",\"label\":\"Lookup Code Meaning\",\"description\":\"The translated meaning of the Lookup Code.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Standard Lookup Code\",\"boDescription\":\"The standard lookup codes list of values resource is used to query the list of standard lookup codes.\"},\"costCategory\":{\"accessorLabel\":\"Cost Category\",\"accessorDescription\":\"A project cost category describes and groups project costs. For example, a cost category named Labor is used to group labor-related cost types, and a cost category named Supplier is for costs incurred on supplier invoices.\",\"fields\":[{\"fieldPath\":\"projectCostType.costCategory.id\",\"label\":\"Cost Category ID\",\"description\":\"Unique identifier of the project cost category.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectCostType.costCategory.name\",\"label\":\"Name\",\"description\":\"Name of the project cost category.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Cost Category\"}},\"boQualifiedLabel\":\"Project Cost Type\",\"boDescription\":\"A cost type is a classification of project cost used in planning, budgeting, forecasting, and reporting. It's a primary driver for cost processing, such as calculating raw and burden costs, controlling which charges are allowed for a project, capturing retirement costs in a capital project, and tracking miscellaneous costs like asset depreciation, allocations, and interest charges.\"},\"projectCostOrganization\":{\"accessorLabel\":\"Cost Organization\",\"accessorDescription\":\"An organization that's responsible for incurring project cost transactions. For worker-related project costs, such as time cards or expenses, the department on a worker's primary assignment must also be classified as a project cost organization. A project cost organization can be used to derive project cost amounts, as a source for project cost and revenue accounting, to identify and process cross-charges, and to group project costs for reporting purposes.\",\"fields\":[{\"fieldPath\":\"projectCostOrganization.id\",\"label\":\"Project Cost Organization ID\",\"description\":\"The unique identifier of the project cost organization.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectCostOrganization.name\",\"label\":\"Name\",\"description\":\"The name of the project cost organization.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectCostOrganization.effectiveStartDate\",\"label\":\"Effective Start Date\",\"description\":\"The earliest effective start date of the organization that's classified as a project cost organization.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectCostOrganization.effectiveEndDate\",\"label\":\"Effective End Date\",\"description\":\"The latest effective end date of the organization that's classified as a project cost organization.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Cost Organization\"},\"fundingSource\":{\"accessorLabel\":\"Funding Source\",\"accessorDescription\":\"Funding sources are external sponsors, internal organizations, and other sources that fund projects.\",\"fields\":[{\"fieldPath\":\"fundingSource.id\",\"label\":\"Funding Source ID\",\"description\":\"The unique identifier of the funding source.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"fundingSource.fundingSourceNumber\",\"label\":\"Number\",\"description\":\"The number of the funding source.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"fundingSource.type\",\"label\":\"Type\",\"description\":\"Type of the funding source.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"fundingSource.name\",\"label\":\"Name\",\"description\":\"Name of the funding source.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"fundingSource.fromDate\",\"label\":\"From Date\",\"description\":\"The date from which the funding source is active.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"fundingSource.toDate\",\"label\":\"To Date\",\"description\":\"The date till which the funding source is active.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"fundingSource.description\",\"label\":\"Description\",\"description\":\"The description for a funding source that isn't a sponsor or internal organization.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"typeLookup\":{\"accessorLabel\":\"Number\",\"accessorDescription\":\"Type of the funding source.\",\"fields\":[{\"fieldPath\":\"fundingSource.typeLookup.lookupCode\",\"label\":\"Lookup Code ID\",\"description\":\"The unique identifier of the Lookup Code.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"fundingSource.typeLookup.lookupType\",\"label\":\"Lookup Type ID\",\"description\":\"The unique identifier of the Lookup Type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"fundingSource.typeLookup.meaning\",\"label\":\"Lookup Code Meaning\",\"description\":\"The translated meaning of the Lookup Code.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Standard Lookup Code\",\"boDescription\":\"The standard lookup codes list of values resource is used to query the list of standard lookup codes.\"},\"customer\":{\"accessorLabel\":\"Customer\",\"accessorDescription\":\"The Customer party represents an entity (either an individual or an organization) that purchases goods or services and to whom invoices and payment requests are issued.\",\"fields\":[{\"fieldPath\":\"fundingSource.customer.id\",\"label\":\"Party ID\",\"description\":\"The unique identifier of the party.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"fundingSource.customer.registryId\",\"label\":\"Registry ID\",\"description\":\"The public key generated or user-entered for a given party.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"fundingSource.customer.name\",\"label\":\"Party Name\",\"description\":\"The name of the party.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{}},\"organization\":{\"accessorLabel\":\"Project Organization\",\"accessorDescription\":\"An organization that owns project-related business objects such as programs, projects, project tasks, and project contracts. A project organization can be used as a source for project cost and revenue accounting, to identify and process cross-charges, to control data access to projects, and to group project-related business objects for reporting purposes.\",\"fields\":[{\"fieldPath\":\"fundingSource.organization.id\",\"label\":\"Project Organization ID\",\"description\":\"The unique identifier of the project organization.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"fundingSource.organization.name\",\"label\":\"Name\",\"description\":\"The name of the project organization.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"fundingSource.organization.effectiveStartDate\",\"label\":\"Effective Start Date\",\"description\":\"The earliest effective start date of the organization that's classified as a project organization.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"fundingSource.organization.effectiveEndDate\",\"label\":\"Effective End Date\",\"description\":\"The latest effective end date of the organization that's classified as a project organization.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{}}},\"boQualifiedLabel\":\"Project Funding Source\"},\"businessUnit\":{\"accessorLabel\":\"Business Unit\",\"accessorDescription\":\"A business unit represents a unit of an enterprise that performs one or more business functions and may have service provider relationships between the units. It typically focuses on a specific market segment, product line, geographic region, or set of services. The business transactions are recorded, reported, and accounted against the business unit.\",\"fields\":[{\"fieldPath\":\"businessUnit.id\",\"label\":\"Business Unit ID\",\"description\":\"The unique identifier of the business unit.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"businessUnit.name\",\"label\":\"Business Unit\",\"description\":\"The translated name for the business unit.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"businessUnit.effectiveStartDate\",\"label\":\"Start Date\",\"description\":\"The start date of the date range within which the business unit is effective.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"businessUnit.effectiveEndDate\",\"label\":\"End Date\",\"description\":\"The end date of the date range within which the business unit is effective.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"information\":{\"accessorLabel\":\"Business Unit Information\",\"accessorDescription\":\"A business unit information that contains additional details about the business unit, such as manager, primary ledger, default legal entity, default reference date set, and legal entity option.\",\"fields\":[{\"fieldPath\":\"businessUnit.information.id\",\"label\":\"Organization Unit Classification ID\",\"description\":\"\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"businessUnit.information.effectiveStartDate\",\"label\":\"Effective Start Date\",\"description\":\"Effective start date of the organization information.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"businessUnit.information.effectiveEndDate\",\"label\":\"Effective End Date\",\"description\":\"Effective end date of the organization information.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"primaryLedger\":{\"accessorLabel\":\"Ledger\",\"accessorDescription\":\"A ledger represents a record-keeping book used to track financial transactions. It serves as a central repository for all financial activities within an organization, providing a chronological and systematic account of debits, credits, and balances. Ledgers play a crucial role in financial management, budgeting, and maintaining accurate financial records, tracking expenses, revenues, assets, liabilities, and equity.\",\"fields\":[{\"fieldPath\":\"businessUnit.information.primaryLedger.ledgerId\",\"label\":\"Ledger ID\",\"description\":\"The unique identifier of the ledger for which the accounting entry is created.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"calendar\":{\"accessorLabel\":\"Accounting Calendar\",\"accessorDescription\":\"An accounting calendar contains the periods of an accounting year. For example, one company can have a fiscal calendar that starts in May and ends in June. Another company can use calendars based on the calendar year, January to December.\",\"fields\":[{\"fieldPath\":\"businessUnit.information.primaryLedger.calendar.calendarId\",\"label\":\"Calendar ID\",\"description\":\"The unique identifier of an accounting or commitment calendar.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"businessUnit.information.primaryLedger.calendar.periodSetName\",\"label\":\"Accounting Calendar\",\"description\":\"Name of the accounting calendar.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"businessUnit.information.primaryLedger.calendar.periodType\",\"label\":\"Period Type\",\"description\":\"The frequency of the accounting period, such as, Weekly, Monthly, and Quarterly. The list of accepted values for period frequency can be found in the lookup type CAL_NON_ADJ_FREQ. When creating a calendar with period frequency codes, the period type is concatenated with a unique number. For example, MONTH2558721688.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{}}}}}}}},\"projectBusinessUnitConfiguration\":{\"accessorLabel\":\"Project Business Unit Configuration\",\"accessorDescription\":\"Business unit level settings that control specific aspects of how the Project Management application functions. The Project Business Unit Configuration business object is accessed for retrieving accounting period related information to process project cost transactions.\",\"fields\":[{\"fieldPath\":\"projectBusinessUnitConfiguration.businessUnitId\",\"label\":\"Business Unit ID\",\"description\":\"The unique identifier of the business unit in which the Project Management application is configured.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"projectFinancialCalendar\":{\"accessorLabel\":\"Project Accounting Calendar\",\"accessorDescription\":\"A calendar used for financial project planning, costing, billing, budgeting, forecasting, and performance reporting.\",\"fields\":[{\"fieldPath\":\"projectBusinessUnitConfiguration.projectFinancialCalendar.calendarId\",\"label\":\"Calendar ID\",\"description\":\"The unique identifier of an accounting or commitment calendar.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectBusinessUnitConfiguration.projectFinancialCalendar.periodSetName\",\"label\":\"Accounting Calendar\",\"description\":\"Name of the accounting calendar.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectBusinessUnitConfiguration.projectFinancialCalendar.periodType\",\"label\":\"Period Type\",\"description\":\"The frequency of the accounting period, such as, Weekly, Monthly, and Quarterly. The list of accepted values for period frequency can be found in the lookup type CAL_NON_ADJ_FREQ. When creating a calendar with period frequency codes, the period type is concatenated with a unique number. For example, MONTH2558721688.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Accounting Calendar\",\"boDescription\":\"An accounting calendar contains the periods of an accounting year. For example, one company can have a fiscal calendar that starts in May and ends in June. Another company can use calendars based on the calendar year, January to December.\"}},\"boDescription\":\"Business unit-level settings which control specific aspects of how the Project Management application functions, such as which project organization trees to use, how to convert currencies, and how to process cross-charges within a legal entity.\"},\"receiverBusinessUnit\":{\"accessorLabel\":\"Receiver Business Unit\",\"accessorDescription\":\"A business unit represents a unit of an enterprise that performs one or more business functions and may have service provider relationships between the units. It typically focuses on a specific market segment, product line, geographic region, or set of services. The business transactions are recorded, reported, and accounted against the business unit.\",\"fields\":[{\"fieldPath\":\"receiverBusinessUnit.id\",\"label\":\"Business Unit ID\",\"description\":\"The unique identifier of the business unit.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"receiverBusinessUnit.name\",\"label\":\"Business Unit\",\"description\":\"The translated name for the business unit.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"receiverBusinessUnit.effectiveStartDate\",\"label\":\"Start Date\",\"description\":\"The start date of the date range within which the business unit is effective.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"receiverBusinessUnit.effectiveEndDate\",\"label\":\"End Date\",\"description\":\"The end date of the date range within which the business unit is effective.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"information\":{\"accessorLabel\":\"Business Unit Information\",\"accessorDescription\":\"A business unit information that contains additional details about the business unit, such as manager, primary ledger, default legal entity, default reference date set, and legal entity option.\",\"fields\":[{\"fieldPath\":\"receiverBusinessUnit.information.id\",\"label\":\"Organization Unit Classification ID\",\"description\":\"\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"receiverBusinessUnit.information.effectiveStartDate\",\"label\":\"Effective Start Date\",\"description\":\"Effective start date of the organization information.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"receiverBusinessUnit.information.effectiveEndDate\",\"label\":\"Effective End Date\",\"description\":\"Effective end date of the organization information.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"primaryLedger\":{\"accessorLabel\":\"Ledger\",\"accessorDescription\":\"A ledger represents a record-keeping book used to track financial transactions. It serves as a central repository for all financial activities within an organization, providing a chronological and systematic account of debits, credits, and balances. Ledgers play a crucial role in financial management, budgeting, and maintaining accurate financial records, tracking expenses, revenues, assets, liabilities, and equity.\",\"fields\":[{\"fieldPath\":\"receiverBusinessUnit.information.primaryLedger.ledgerId\",\"label\":\"Ledger ID\",\"description\":\"The unique identifier of the ledger for which the accounting entry is created.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"calendar\":{\"accessorLabel\":\"Accounting Calendar\",\"accessorDescription\":\"An accounting calendar contains the periods of an accounting year. For example, one company can have a fiscal calendar that starts in May and ends in June. Another company can use calendars based on the calendar year, January to December.\",\"fields\":[{\"fieldPath\":\"receiverBusinessUnit.information.primaryLedger.calendar.calendarId\",\"label\":\"Calendar ID\",\"description\":\"The unique identifier of an accounting or commitment calendar.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"receiverBusinessUnit.information.primaryLedger.calendar.periodSetName\",\"label\":\"Accounting Calendar\",\"description\":\"Name of the accounting calendar.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"receiverBusinessUnit.information.primaryLedger.calendar.periodType\",\"label\":\"Period Type\",\"description\":\"The frequency of the accounting period, such as, Weekly, Monthly, and Quarterly. The list of accepted values for period frequency can be found in the lookup type CAL_NON_ADJ_FREQ. When creating a calendar with period frequency codes, the period type is concatenated with a unique number. For example, MONTH2558721688.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{}}}}}}},\"boQualifiedLabel\":\"Business Unit\"},\"transactionSource\":{\"accessorLabel\":\"Cost Transaction Source\",\"accessorDescription\":\"The source where the project cost transaction originated.\",\"fields\":[{\"fieldPath\":\"transactionSource.id\",\"label\":\"Project Cost Transaction Source ID\",\"description\":\"Identifier of the project cost transaction source.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"transactionSource.name\",\"label\":\"Transaction Source\",\"description\":\"The transaction source name associated with the cost.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Cost Transaction Source\"},\"document\":{\"accessorLabel\":\"Document\",\"accessorDescription\":\"The document where the project cost transaction originated. Documents describe the type of transaction, such as time cards or expense reports, that resulted in a project cost. Documents also contain business rules that determine how the project subledger will treat transactions originating from the document.\",\"fields\":[{\"fieldPath\":\"document.id\",\"label\":\"Project Cost Transaction Document ID\",\"description\":\"Identifier of the project cost transaction document.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"document.name\",\"label\":\"Name\",\"description\":\"Name of the project cost transaction document.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"document.createAdjustmentAccountingJournalEntriesFlag\",\"label\":\"Create Adjustment Accounting Journal Entries\",\"description\":\"Specifies whether adjustments made to project cost transactions that belong to this document must be accounted, and whether the Project Costing application must create corresponding journal entries.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Cost Transaction Source Document\"},\"documentEntry\":{\"accessorLabel\":\"Document Entry\",\"accessorDescription\":\"The document entry where the project cost transaction originated. Document entries further describe the type of transaction, such as item costs and nonrecoverable taxes, that resulted in a project cost. Document entries are assigned an expenditure type class that controls the expenditure types that can be included on project cost transactions, as well as additional business rules that determine how the project subledger will treat transactions originating from the document.\",\"fields\":[{\"fieldPath\":\"documentEntry.id\",\"label\":\"Project Cost Transaction Document Entry ID\",\"description\":\"Identifier of the project cost transaction document entry.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"documentEntry.name\",\"label\":\"Name\",\"description\":\"Name of the project cost transaction document entry.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Cost Transaction Source Document Entry\"},\"supplier\":{\"accessorLabel\":\"Supplier\",\"accessorDescription\":\"A supplier is a person or company that the deploying organization uses to procure items or services. For example, an office supplies provider or a consulting service provider.\",\"fields\":[{\"fieldPath\":\"supplier.supplierId\",\"label\":\"Supplier ID\",\"description\":\"Value that uniquely identifies the supplier.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"supplier.name\",\"label\":\"Name\",\"description\":\"The name of the organization.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"supplier.supplierNumber\",\"label\":\"Supplier Number\",\"description\":\"Number that identifies the supplier.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{}},\"nonlaborResource\":{\"accessorLabel\":\"Nonlabor Resource\",\"accessorDescription\":\"A nonlabor resource represents an asset or a pool of assets used for projects. For example, company-owned equipment like printers that produce physical output and internal telecommunications services where usage is tracked in hours. All usage-based costs are associated with a nonlabor resource.\",\"fields\":[{\"fieldPath\":\"nonlaborResource.id\",\"label\":\"Nonlabor Resource ID\",\"description\":\"Unique identifier of the nonlabor resource.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"nonlaborResource.name\",\"label\":\"Name\",\"description\":\"The name of the nonlabor resource.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"nonlaborResource.equipmentResourceClassFlag\",\"label\":\"Equipment Resource Class\",\"description\":\"Indicates whether the nonlabor resource is classified as an equipment resource class. A resource class is a high-level grouping that drives how resources are used for planning and reporting. If true, the nonlabor resource can be used in both reporting and planning resource breakdown structures that include the equipment resource class. If false, the nonlabor resource is available for reporting purposes only.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Nonlabor Resource\"},\"nonlaborResourceOrganization\":{\"accessorLabel\":\"Nonlabor Resource Organization\",\"accessorDescription\":\"The organization that owns the nonlabor resource.\",\"fields\":[{\"fieldPath\":\"nonlaborResourceOrganization.id\",\"label\":\"Organization ID\",\"description\":\"Unique identifier of the organization.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"nonlaborResourceOrganization.name\",\"label\":\"Name\",\"description\":\"Name of the organization.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"nonlaborResourceOrganization.effectiveStartDate\",\"label\":\"Effective Start Date\",\"description\":\"Effective start date of the organization.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"nonlaborResourceOrganization.effectiveEndDate\",\"label\":\"Effective End Date\",\"description\":\"Effective end date of the organization.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Organization Extract\",\"boDescription\":\"The organization resource provides the details about all organizations including their classifications and extended attributes.\"},\"projectCostClassification\":{\"accessorLabel\":\"Cost Classification\",\"accessorDescription\":\"The cost classification is used to provide an additional classification for cost types and drive cost processing. Examples include burden transactions, expense reports, and straight time.\",\"fields\":[{\"fieldPath\":\"projectCostClassification.code\",\"label\":\"Cost Classification Code\",\"description\":\"The code that uniquely identifies the cost classification.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectCostClassification.name\",\"label\":\"Name\",\"description\":\"The name of the cost classification.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Cost Classification\"},\"person\":{\"accessorLabel\":\"Worker\",\"accessorDescription\":\"A worker is a person who has a working relationship with a legal entity defined in human resources. Persons with contingent worker and employee work relationships can be assigned to projects.\",\"fields\":[{\"fieldPath\":\"person.id\",\"label\":\"Id\",\"description\":\"Unique identifier of person business object.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"personDetail\":{\"accessorLabel\":\"Person Detail\",\"accessorDescription\":\"Person detail accessor for worker business object.\",\"fields\":[{\"fieldPath\":\"person.personDetail.id\",\"label\":\"Id\",\"description\":\"Unique identifier of person detail.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"person.personDetail.effectiveStartDate\",\"label\":\"Effective Start Date\",\"description\":\"Effective start date of person detail.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"person.personDetail.effectiveEndDate\",\"label\":\"Effective End Date\",\"description\":\"Effective end date of person detail.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"person.personDetail.personNumber\",\"label\":\"Person Number\",\"description\":\"Person number accessor for person detail.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boDescription\":\"The personDetail provides additional person-related information, such as demographic or legislative attributes, associated with the person record.\"},\"names\":{\"accessorLabel\":\"Person Names\",\"accessorDescription\":\"The personNames resource provides the name details of a person. A person can have multiple name records. This resource manages a specific person name record at a specific point in time. By default, the current date is retained.\",\"fields\":[{\"fieldPath\":\"person.names.id\",\"label\":\"Person Name ID\",\"description\":\"Surrogate identifier for the contact's name.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"person.names.effectiveStartDate\",\"label\":\"Effective Start Date\",\"description\":\"Start date of the date-effective changes to the global name record.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"person.names.effectiveEndDate\",\"label\":\"Effective End Date\",\"description\":\"End date of the date-effective changes to the global name record.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"person.names.displayName\",\"label\":\"Name\",\"description\":\"Contact's display name.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Names\"}},\"boDescription\":\"The worker provides employment-related information about a person who has a work relationship within the enterprise.\"},\"personJob\":{\"accessorLabel\":\"Job\",\"accessorDescription\":\"A job is part of a workforce structure that's assigned to a worker. A job is typically used without positions where the organization is fluid, for example, Technical Writer.\",\"fields\":[{\"fieldPath\":\"personJob.id\",\"label\":\"Job Identifier\",\"description\":\"Surrogate identifier for the job.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"personJob.name\",\"label\":\"Name\",\"description\":\"Name accessor for the job.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"personJob.effectiveStartDate\",\"label\":\"Effective Start Date\",\"description\":\"Date at the beginning of the period within which the job is effective.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"personJob.effectiveEndDate\",\"label\":\"Effective End Date\",\"description\":\"Date at the end of the period within which the job is effective.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"date\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boDescription\":\"The jobs resource provides the details of all jobs as on a specified date. You can retrieve, create, and update the jobs.\"},\"contract\":{\"accessorLabel\":\"Contract\",\"accessorDescription\":\"The contracts resource is used to view the details of a contract. A contract is an agreement between two or more parties to fulfill an agreed scope of work.\",\"fields\":[{\"fieldPath\":\"contract.id\",\"label\":\"ID\",\"description\":\"The internal identifier of the contract custom child record.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"contract.contractName\",\"label\":\"Cognomen\",\"description\":\"The translation of the contract name.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"contract.contractNumber\",\"label\":\"Number\",\"description\":\"The alternate key identifier for the contract. Contract numbers can be automatically assigned, or entered manually.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"contract.publicIdentifier\",\"label\":\"Contract PUID\",\"description\":\"The public unique identifier of a contract.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{}},\"workType\":{\"accessorLabel\":\"Work Type\",\"accessorDescription\":\"A work type is a classification of actual and scheduled work. Used to identify work for processing purposes, including billing, cross-charging between organizations, and labor utilization tracking.\",\"fields\":[{\"fieldPath\":\"workType.id\",\"label\":\"Work Type ID\",\"description\":\"Unique identifier of the work type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"workType.name\",\"label\":\"Work Type\",\"description\":\"Name of the work type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"workType.description\",\"label\":\"Description\",\"description\":\"Description of the work type.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Work Type\"},\"fundsStatus\":{\"accessorLabel\":\"Funds Status\",\"accessorDescription\":\"The budgetary control validation status of a project cost transaction in the Projects application.\",\"fields\":[{\"fieldPath\":\"fundsStatus.lookupType\",\"label\":\"Lookup Type ID\",\"description\":\"The unique identifier of the Lookup Type.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"fundsStatus.lookupCode\",\"label\":\"Lookup Code ID\",\"description\":\"The unique identifier of the Lookup Code.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"fundsStatus.meaning\",\"label\":\"Lookup Code Meaning\",\"description\":\"The translated meaning of the Lookup Code.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Standard Lookup Code\",\"boDescription\":\"The standard lookup codes list of values resource is used to query the list of standard lookup codes.\"},\"capitalEvent\":{\"accessorLabel\":\"Capital Event\",\"accessorDescription\":\"A capital event is an action that a project accountant must execute, either manually or periodically, to transfer project costs to designated project assets. You use capital events to group assets and costs on a project before you generate asset lines for capitalization and retirement cost processing.\",\"fields\":[{\"fieldPath\":\"capitalEvent.id\",\"label\":\"Capital Event ID\",\"description\":\"The unique identifier of the capital event.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"capitalEvent.eventNumber\",\"label\":\"Event Number\",\"description\":\"The number of the capital event.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"capitalEvent.eventName\",\"label\":\"Event Name\",\"description\":\"The name of the capital event.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Capital Event\"}}}"
            },
            {
              "id": "1781496759181_prjPjcVarUqOraErpCoreProjectAssetProjectAssetLinesViewBVMetadata",
              "name": "prjPjcVarUqOraErpCoreProjectAssetProjectAssetLinesViewBVMetadata",
              "value": "{\"bvLabel\":\"Project Asset Lines\",\"bvDescription\":\"This view lists project asset lines. Project asset lines are a consolidated grouping of project costs that are allocated to project assets.\",\"boQualifiedLabel\":\"Project Asset Lines\",\"boDescription\":\"Project asset lines are a consolidated grouping of project costs that are allocated to project assets.\",\"synonyms\":[],\"fields\":[{\"fieldPath\":\"id\",\"label\":\"Line Number\",\"description\":\"The identifier of the project asset line.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"description\",\"label\":\"Description\",\"description\":\"Description of the project asset line, derived from the CIP grouping method.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"timeUpdated\",\"label\":\"Last Updated Date\",\"description\":\"The date and time when the record was last updated.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"date-time\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"updatedBy\",\"label\":\"Last Updated By\",\"description\":\"The user who last updated the record.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"timeCreated\",\"label\":\"Creation Date\",\"description\":\"The date and time when the record was created.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"date-time\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"createdBy\",\"label\":\"Created By\",\"description\":\"The user who created the record.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"originalAmount\",\"label\":\"Original Amount\",\"description\":\"The original asset cost on the project asset line before it was split.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"assetPeriodName\",\"label\":\"Asset Period Name\",\"description\":\"Period into which an asset was posted in Fixed Assets.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"amount\",\"label\":\"Amount\",\"description\":\"The project asset line's current cost. Split lines have a current cost that's greater or less than the original cost, but never equal to it.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAssetLineGroupIdentifier\",\"label\":\"Project Asset Line Group Identifier\",\"description\":\"The identifier of the asset line detail linking this project asset line to cost distribution lines.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"unassignedAssetLineFlag\",\"label\":\"Unassigned Asset Line\",\"description\":\"Indicates whether the project asset line is currently unassigned. If the value is true, it means that the project asset line hasn't yet been assigned to a project asset. The line remains unassigned until it's manually assigned to a project asset or assigned by the Generate Asset Lines process.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"project\":{\"accessorLabel\":\"Project\",\"accessorDescription\":\"A project represents the effort and resources required to achieve a significant business objective within a specific time frame. Projects are used to plan, track, manage, and control both the financial aspects and the work effort required.\",\"fields\":[{\"fieldPath\":\"project.id\",\"label\":\"Project ID\",\"description\":\"Unique identifier of the project.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.name\",\"label\":\"Name\",\"description\":\"Name of the project.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.projectNumber\",\"label\":\"Project Number\",\"description\":\"Number of the project.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.capitalEventProcessingMethod\",\"label\":\"Capital Event Processing Method\",\"description\":\"WSAttr Dsc 472c35ea Ad12 468b B9e2 144a0c2e5669\",\"searchable\":false,\"sortable\":false,\"dataType\":\"enumeration\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"businessUnit\":{\"accessorLabel\":\"Business Unit\",\"accessorDescription\":\"A business unit represents a unit of an enterprise that performs one or more business functions and may have service provider relationships between the units. It typically focuses on a specific market segment, product line, geographic region, or set of services. The business transactions are recorded, reported, and accounted against the business unit.\",\"fields\":[{\"fieldPath\":\"project.businessUnit.id\",\"label\":\"Business Unit ID\",\"description\":\"The unique identifier of the business unit.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.businessUnit.name\",\"label\":\"Business Unit\",\"description\":\"The translated name for the business unit.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.businessUnit.effectiveStartDate\",\"label\":\"Start Date\",\"description\":\"The start date of the date range within which the business unit is effective.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.businessUnit.effectiveEndDate\",\"label\":\"End Date\",\"description\":\"The end date of the date range within which the business unit is effective.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"information\":{\"accessorLabel\":\"Business Unit Information\",\"accessorDescription\":\"A business unit information that contains additional details about the business unit, such as manager, primary ledger, default legal entity, default reference date set, and legal entity option.\",\"fields\":[{\"fieldPath\":\"project.businessUnit.information.id\",\"label\":\"Id\",\"description\":\"\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.businessUnit.information.effectiveStartDate\",\"label\":\"Effective Start Date\",\"description\":\"\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.businessUnit.information.effectiveEndDate\",\"label\":\"Effective End Date\",\"description\":\"\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"primaryLedger\":{\"accessorLabel\":\"Ledger\",\"accessorDescription\":\"A ledger represents a record-keeping book used to track financial transactions. It serves as a central repository for all financial activities within an organization, providing a chronological and systematic account of debits, credits, and balances. Ledgers play a crucial role in financial management, budgeting, and maintaining accurate financial records, tracking expenses, revenues, assets, liabilities, and equity.\",\"fields\":[{\"fieldPath\":\"project.businessUnit.information.primaryLedger.ledgerId\",\"label\":\"Ledger ID\",\"description\":\"The unique identifier of the ledger for which the accounting entry is created.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"currency\":{\"accessorLabel\":\"Currency\",\"accessorDescription\":\"A currency is a standardization of money used for displaying monetary amounts, assigning to ledgers, entering transactions, recording balances, and reporting. All currencies listed in the International Organization for Standardization 4217 standard are supported. The statistical unit currency is used for financial statistics in financial reports, allocation formulas, and other calculations.\",\"fields\":[{\"fieldPath\":\"project.businessUnit.information.primaryLedger.currency.currencyCode\",\"label\":\"Currency Code\",\"description\":\"The currency in which an amount or a conversion rate is denominated.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Currency\",\"boDescription\":\"A currency is a standardization of money used for displaying monetary amounts, assigning to ledgers, entering transactions, recording balances, and reporting. All currencies listed in the International Organization for Standardization 4217 standard are supported. The statistical unit currency is used for financial statistics in financial reports, allocation formulas, and other calculations.\"},\"calendar\":{\"accessorLabel\":\"Accounting Calendar\",\"accessorDescription\":\"An accounting calendar contains the periods of an accounting year. For example, one company can have a fiscal calendar that starts in May and ends in June. Another company can use calendars based on the calendar year, January to December.\",\"fields\":[{\"fieldPath\":\"project.businessUnit.information.primaryLedger.calendar.calendarId\",\"label\":\"Calendar ID\",\"description\":\"The unique identifier of an accounting or commitment calendar.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.businessUnit.information.primaryLedger.calendar.periodSetName\",\"label\":\"Accounting Calendar\",\"description\":\"Name of the accounting calendar.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"project.businessUnit.information.primaryLedger.calendar.periodType\",\"label\":\"Period Type\",\"description\":\"The frequency of the accounting period, such as, Weekly, Monthly, and Quarterly. The list of accepted values for period frequency can be found in the lookup type CAL_NON_ADJ_FREQ. When creating a calendar with period frequency codes, the period type is concatenated with a unique number. For example, MONTH2558721688.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Accounting Calendar\",\"boDescription\":\"An accounting calendar contains the periods of an accounting year. For example, one company can have a fiscal calendar that starts in May and ends in June. Another company can use calendars based on the calendar year, January to December.\"}},\"boQualifiedLabel\":\"Ledger\",\"boDescription\":\"A ledger represents a record-keeping book used to track financial transactions. It serves as a central repository for all financial activities within an organization, providing a chronological and systematic account of debits, credits, and balances. Ledgers play a crucial role in financial management, budgeting, and maintaining accurate financial records, tracking expenses, revenues, assets, liabilities, and equity.\"}},\"boQualifiedLabel\":\"Business Unit Information\",\"boDescription\":\"A business unit information that contains additional details about the business unit, such as manager, primary ledger, default legal entity, default reference date set, and legal entity option.\"}},\"boQualifiedLabel\":\"Business Unit\",\"boDescription\":\"A business unit represents a unit of an enterprise that performs one or more business functions and may have service provider relationships between the units. It typically focuses on a specific market segment, product line, geographic region, or set of services. The business transactions are recorded, reported, and accounted against the business unit.\"}},\"boQualifiedLabel\":\"Project\",\"boDescription\":\"A project represents the effort and resources required to achieve a significant business objective within a specific time frame. Projects are used to plan, track, manage, and control both the financial aspects and the work effort required.\"},\"projectAsset\":{\"accessorLabel\":\"Project Asset\",\"accessorDescription\":\"A project asset represents an asset, such as a building or software, that a capital project creates. A project asset is used to collect project costs on behalf of the asset. Once the project is complete, costs captured against project assets are transferred to corresponding final assets, where they represent their actual cost.\",\"fields\":[{\"fieldPath\":\"projectAsset.id\",\"label\":\"Project Asset ID\",\"description\":\"Unique identifier of the asset.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAsset.assetNumber\",\"label\":\"Asset Number\",\"description\":\"Number that uniquely identifies the project asset.\",\"searchable\":true,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAsset.assetName\",\"label\":\"Asset Name\",\"description\":\"Name of the project asset.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"assetCategoryStandardUnitCost\":{\"accessorLabel\":\"Asset Category Standard Unit Cost\",\"accessorDescription\":\"The standard unit cost is a monetary value assigned to a specific combination of an asset category and an asset book. The standard unit cost is multiplied by actual units as an option for allocating costs.\",\"fields\":[{\"fieldPath\":\"projectAsset.assetCategoryStandardUnitCost.id\",\"label\":\"Asset Category Standard Unit Cost ID\",\"description\":\"The unique identifier of the asset category standard unit cost.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectAsset.assetCategoryStandardUnitCost.costPerUnit\",\"label\":\"Cost per Unit\",\"description\":\"The standard cost per unit for a given asset book and asset category combination.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"big-decimal\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Asset Category Standard Unit Cost\",\"boDescription\":\"The standard unit cost is a monetary value assigned to a specific combination of an asset category and an asset book. The standard unit cost is multiplied by actual units as an option for allocating costs.\"}},\"boQualifiedLabel\":\"Project Asset\",\"boDescription\":\"A project asset represents an asset, such as a building or software, that a capital project creates. A project asset is used to collect project costs on behalf of the asset. Once the project is complete, costs captured against project assets are transferred to corresponding final assets, where they represent their actual cost.\"},\"cipCostAccount\":{\"accessorLabel\":\"CIP Cost Account\",\"accessorDescription\":\"The general ledger account to which a construction-in-progress cost is charged.\",\"fields\":[{\"fieldPath\":\"cipCostAccount.codeCombinationId\",\"label\":\"Code Combination Id\",\"description\":\"\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"cipCostAccount.chartOfAccountsId\",\"label\":\"Chart Of Accounts Id\",\"description\":\"\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"cipCostAccount.concatenatedSegments\",\"label\":\"Concatenated Segments\",\"description\":\"\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"CIP Cost Account\",\"boDescription\":\"A general ledger account combination represents the specific grouping of segment values within the Oracle General Ledger. It provides details of all the valid account combinations for each accounting flexfield structure within the General Ledger.\"},\"assetCategory\":{\"accessorLabel\":\"Asset Category\",\"accessorDescription\":\"A category represents the classification of assets, such as buildings, computer equipment, furniture and fixtures, and land. Assets are grouped based on the financial accounts and depreciation rules.\",\"fields\":[{\"fieldPath\":\"assetCategory.categoryId\",\"label\":\"Category Id\",\"description\":\"\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"assetCategory.categoryConcatenatedSegment\",\"label\":\"Category Concatenated Segment\",\"description\":\"\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"assetCategory.structureInstanceNumber\",\"label\":\"Instance Number\",\"description\":\"\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"assetCategory.assetOwnership\",\"label\":\"Asset Ownership\",\"description\":\"\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"assetCategory.categoryType\",\"label\":\"Category Type\",\"description\":\"\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Asset Category\",\"boDescription\":\"A category represents the classification of assets, such as buildings, computer equipment, furniture and fixtures, and land. Assets are grouped based on the financial accounts and depreciation rules.\"},\"projectTask\":{\"accessorLabel\":\"Project Task\",\"accessorDescription\":\"A project task is a subdivision of project work to be performed within a defined period.\",\"fields\":[{\"fieldPath\":\"projectTask.id\",\"label\":\"Task ID\",\"description\":\"Identifier of the project task.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectTask.name\",\"label\":\"Name\",\"description\":\"Name of the project task.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectTask.taskNumber\",\"label\":\"Task Number\",\"description\":\"Number of the project task that identifies it uniquely in the project task hierarchy.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectTask.retirementCostFlag\",\"label\":\"Retirement Cost Flag\",\"description\":\"Name of the project task.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectTask.capitalizableFlag\",\"label\":\"Capitalizable Flag\",\"description\":\"WSAttr Dsc C32af5fd 9968 46b3 Baf0 939da5c5e2c8\",\"searchable\":false,\"sortable\":false,\"dataType\":\"boolean\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{\"topTask\":{\"accessorLabel\":\"Project Task\",\"accessorDescription\":\"A project task is a subdivision of project work to be performed within a defined period.\",\"fields\":[{\"fieldPath\":\"projectTask.topTask.id\",\"label\":\"Task ID\",\"description\":\"Identifier of the project task.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectTask.topTask.name\",\"label\":\"Name\",\"description\":\"Name of the project task.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"projectTask.topTask.taskNumber\",\"label\":\"Task Number\",\"description\":\"Number of the project task that identifies it uniquely in the project task hierarchy.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Task\",\"boDescription\":\"A project task is a subdivision of project work to be performed within a defined period.\"}},\"boQualifiedLabel\":\"Project Task\",\"boDescription\":\"A project task is a subdivision of project work to be performed within a defined period.\"},\"status\":{\"accessorLabel\":\"Status\",\"accessorDescription\":\"The asset line status that appears when cost information is transferred to Oracle Fixed Assets. The available values are Pending, Rejected, and Transferred.\",\"fields\":[{\"fieldPath\":\"status.lookupType\",\"label\":\"Lookup Type\",\"description\":\"\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"status.lookupCode\",\"label\":\"Lookup Code\",\"description\":\"\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"status.meaning\",\"label\":\"Meaning\",\"description\":\"\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Status\",\"boDescription\":\"The asset line status that appears when cost information is transferred to Oracle Fixed Assets. The available values are Pending, Rejected, and Transferred.\"},\"assetLineType\":{\"accessorLabel\":\"Asset Line Type\",\"accessorDescription\":\"Classifies project asset lines as Capital or Retirement.\",\"fields\":[{\"fieldPath\":\"assetLineType.lookupType\",\"label\":\"Lookup Type\",\"description\":\"\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"assetLineType.lookupCode\",\"label\":\"Lookup Code\",\"description\":\"\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"assetLineType.meaning\",\"label\":\"Meaning\",\"description\":\"\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Asset Line Type\",\"boDescription\":\"Classifies project asset lines as Capital or Retirement.\"},\"businessUnit\":{\"accessorLabel\":\"Business Unit\",\"accessorDescription\":\"A business unit represents a unit of an enterprise that performs one or more business functions and may have service provider relationships between the units. It typically focuses on a specific market segment, product line, geographic region, or set of services. The business transactions are recorded, reported, and accounted against the business unit.\",\"fields\":[{\"fieldPath\":\"businessUnit.id\",\"label\":\"Business Unit ID\",\"description\":\"The unique identifier of the business unit.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"businessUnit.name\",\"label\":\"Business Unit\",\"description\":\"The translated name for the business unit.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"businessUnit.effectiveStartDate\",\"label\":\"Start Date\",\"description\":\"The start date of the date range within which the business unit is effective.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"businessUnit.effectiveEndDate\",\"label\":\"End Date\",\"description\":\"The end date of the date range within which the business unit is effective.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Business Unit\",\"boDescription\":\"A business unit represents a unit of an enterprise that performs one or more business functions and may have service provider relationships between the units. It typically focuses on a specific market segment, product line, geographic region, or set of services. The business transactions are recorded, reported, and accounted against the business unit.\"},\"capitalEvent\":{\"accessorLabel\":\"Capital Event\",\"accessorDescription\":\"A capital event is an action that a project accountant must execute, either manually or periodically, to transfer project costs to designated project assets. You use capital events to group assets and costs on a project before you generate asset lines for capitalization and retirement cost processing.\",\"fields\":[{\"fieldPath\":\"capitalEvent.id\",\"label\":\"Capital Event ID\",\"description\":\"The unique identifier of the capital event.\",\"searchable\":true,\"sortable\":true,\"dataType\":\"int64\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]},{\"fieldPath\":\"capitalEvent.eventName\",\"label\":\"Event Name\",\"description\":\"The name of the capital event.\",\"searchable\":false,\"sortable\":false,\"dataType\":\"string\",\"enumDescription\":\"\",\"enumValues\":{},\"synonyms\":[]}],\"accessors\":{},\"boQualifiedLabel\":\"Project Capital Event\",\"boDescription\":\"A capital event is an action that a project accountant must execute, either manually or periodically, to transfer project costs to designated project assets. You use capital events to group assets and costs on a project before you generate asset lines for capitalization and retirement cost processing.\"}}}"
            },
            {
              "id": "1781496759181_prjPjcVarUqAnalyticViewFieldLabelsMetadata",
              "name": "prjPjcVarUqProjectCostTransactionSummaryAVMetadata",
              "type": "string",
              "value": "{\"rawCostInTransactionCurrency\":\"Raw Cost in Transaction Currency\",\"burdenedCostInTransactionCurrency\":\"Burdened Cost in Transaction Currency\",\"rawCostInProjectCurrency\":\"Raw Cost in Project Currency\",\"burdenedCostInProjectCurrency\":\"Burdened Cost in Project Currency\",\"rawCostInProviderLedgerCurrency\":\"Raw Cost in Provider Ledger Currency\",\"burdenedCostInProviderLedgerCurrency\":\"Burdened Cost in Provider Ledger Currency\",\"rawCostInReceiverLedgerCurrency\":\"Raw Cost in Receiver Ledger Currency\",\"burdenedCostInReceiverLedgerCurrency\":\"Burdened Cost in Receiver Ledger Currency\",\"project.$memberName\":\"Project Number\",\"project.$memberDescription\":\"Project Name\",\"providerProjectAccountingPeriod.$memberName\":\"Project Accounting Period\",\"providerProjectAccountingPeriod.$memberDescription\":\"Project Accounting Period\",\"providerAccountingPeriod.$memberName\":\"Provider Accounting Period\",\"providerAccountingPeriod.$memberDescription\":\"Provider Accounting Period\",\"providerLedger.$memberName\":\"Provider Ledger\",\"providerLedger.$memberDescription\":\"Provider Ledger\",\"costOrganization.$memberName\":\"Cost Organization\",\"costOrganization.$memberDescription\":\"Cost Organization\",\"costType.$memberName\":\"Cost Type\",\"costType.$memberDescription\":\"Cost Type\",\"costCategory.$memberName\":\"Cost Category\",\"costCategory.$memberDescription\":\"Cost Category\",\"workType.$memberName\":\"Work Type\",\"workType.$memberDescription\":\"Work Type\",\"nonlaborResource.$memberName\":\"Nonlabor Resource\",\"nonlaborResource.$memberDescription\":\"Nonlabor Resource\",\"businessUnit.$memberName\":\"Business Unit\",\"businessUnit.$memberDescription\":\"Business Unit\",\"transactionCurrency.$memberName\":\"Transaction Currency\",\"transactionCurrency.$memberDescription\":\"Transaction Currency\",\"providerLedgerCurrency.$memberName\":\"Provider Ledger Currency\",\"providerLedgerCurrency.$memberDescription\":\"Provider Ledger Currency\",\"projectCurrency.$memberName\":\"Project Currency\",\"projectCurrency.$memberDescription\":\"Project Currency\",\"receiverLedgerCurrency.$memberName\":\"Receiver Ledger Currency\",\"receiverLedgerCurrency.$memberDescription\":\"Receiver Ledger Currency\",\"providerLegalEntity.$memberName\":\"Provider Legal Entity\",\"providerLegalEntity.$memberDescription\":\"Provider Legal Entity\",\"projectTask.$memberName\":\"Project Task Number\",\"projectTask.$memberDescription\":\"Project Task Name\",\"billable.$memberName\":\"Billable\",\"billable.$memberDescription\":\"Billable\",\"capitalizable.$memberName\":\"Capitalizable\",\"capitalizable.$memberDescription\":\"Capitalizable\"}"
            },
            {
              "id": "1781496759181_prjPjcVarUqAnalyticViewFieldLabelsMetadata_assetLine",
              "name": "prjPjcVarUqProjectAssetLineSummaryAVMetadata",
              "type": "string",
              "value": "{\"amount\":\"Amount\",\"assetLineCount\":\"Asset Line Count\",\"project.$memberName\":\"Project Number\",\"project.$memberDescription\":\"Project Name\",\"businessUnit.$memberName\":\"Business Unit\",\"businessUnit.$memberDescription\":\"Business Unit\",\"projectTask.$memberName\":\"Project Task Number\",\"projectTask.$memberDescription\":\"Project Task Name\",\"projectAssetLineStatus.$memberName\":\"Project Asset Line Status\",\"projectAssetLineStatus.$memberDescription\":\"Project Asset Line Status\",\"projectLedgerCurrency.$memberName\":\"Project Ledger Currency\",\"projectLedgerCurrency.$memberDescription\":\"Project Ledger Currency\",\"projectAsset.$memberName\":\"Project Asset\",\"projectAsset.$memberDescription\":\"Project Asset\",\"accountingPeriod.$memberName\":\"Asset Period\",\"accountingPeriod.$memberDescription\":\"Asset Period\"}"
            }
