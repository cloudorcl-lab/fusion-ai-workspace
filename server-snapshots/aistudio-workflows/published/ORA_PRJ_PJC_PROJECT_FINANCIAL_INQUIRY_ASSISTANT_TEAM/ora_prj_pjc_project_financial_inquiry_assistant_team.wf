        {
          "metadata": {
            "description": "Prepare a json response for failure scenarios.",
            "name": "Format Error Response",
            "returnType": "object",
            "sourceCode": "const workflowCode = ($context.$workflow?.$name ?? 'ORA_PRJ_PJC_PROJECT_FINANCIAL_INQUIRY_ASSISTANT_TEAM').trim();\nconst workflowDescription = 'Provides instant and clear explanations for any project financial transaction status using natural language dialogue and direct access to detailed audit trails and supporting data.';\nconst userMessage = ($context.$system.$inputMessage ?? '').trim();\nconst atomicAgentContext = $context.$nodes.PRJ_PJC_LLM_IDENTIFY_ARTIFACT?.$output?.artifact ?? null;\n\nfunction formatTimestamp(date) {\n  const pad = (value) => String(value).padStart(2, '0');\n  return `${pad(date.getDate())}-${pad(date.getMonth() + 1)}-${date.getFullYear()} ${pad(date.getHours())}:${pad(date.getMinutes())}`;\n}\n\nconst errorInfos = [\n  $context.$nodes.PRJ_PJC_TOOL_GET_USER_SESSION?.$error?.$info,\n  $context.$nodes.PRJ_PJC_BO_FUNCTION_PERFORM_INTELLIGENT_SEARCH?.$error?.$info,\n  $context.$nodes.PRJ_PJC_BO_FUNCTION_PERFORM_EXTRACT_QUERY?.$error?.$info,\n  $context.$nodes.PRJ_PJC_BO_FUNCTION_RUN_ANALYTICS_EXTRACT_QUERY?.$error?.$info\n];\n\nconst errorText = errorInfos\n  .map((errorInfo) => String(errorInfo ?? \"\").toLowerCase())\n  .join(\" \");\n\nconst rephraseMessage = \"I couldn't understand your request. Try rephrasing it with more specific details. If the issue continues, contact your help desk.\";\nlet message = \"Sorry, the assistant is unavailable right now. If the issue persists, contact your help desk.\";\n\nif (errorText.includes(\"400\")) {\n  message = rephraseMessage;\n} else if (errorText.includes(\"504\")) {\n  message = \"The request timed out. If the issue persists, contact your help desk.\";\n} else if (errorText.includes(\"401\") || errorText.includes(\"403\")) {\n  message = \"One or more required security permissions are missing. Contact your help desk.\";\n} else if (errorText.includes(\"rephrasing\") || errorText.includes(\"specific\")) {\n  message = rephraseMessage;\n}\n\nreturn {\n  agent: workflowCode.toLowerCase(),\n  intent: 'ProjectFinancialInquiry',\n  schema_version: '1',\n  title: 'Project Financial Inquiry',\n  description: workflowDescription,\n  timestamp: formatTimestamp(new Date()),\n  topicName: 'Project Financial Inquiry',\n  atomicAgentDetails: {\n    atomicAgentCode: workflowCode,\n    atomicAgentContext: atomicAgentContext,\n    contextDetails: {\n      searchQuery: userMessage\n    },\n    filters: null,\n    atomicAgentResponse: {}\n  },\n  agent_response: [{\n    display_type: 'text',\n    display_sequence: 1,\n    text: message,\n    expand: { display: 'true', headerText: 'Summary' }\n  }]\n};"
          },
          "outcomes": {
            "success": "1781496759183"
          },
          "code": "PRJ_PJC_CODE_FORMAT_ERROR_RESPONSE",
          "id": "1781496759182",
