              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.PRJ_PJC_LLM_IDENTIFY_ARTIFACT.$output.artifact === \"ProjectCostTransactionSummary\" || $context.$nodes.PRJ_PJC_LLM_IDENTIFY_ARTIFACT.$output.artifact === \"ProjectAssetLineSummary\"}}"
            }
