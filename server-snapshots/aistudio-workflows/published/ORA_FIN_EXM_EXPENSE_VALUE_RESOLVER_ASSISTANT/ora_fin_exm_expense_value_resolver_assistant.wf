          "code": "LOW_VOLUME_RESOLUTION",
          "convergenceTargetId": "1770112331608",
          "id": "1770112704848",
          "inputs": [
            {
              "id": "1770112704851_1",
              "name": "prompt",
              "type": "string",
              "value": "let LowVolumeFieldsArrayVar - {{$context.$nodes.FILTERLOWVOLUMEFIELDS.$output.result}}\nlet FlightClassLovVar - {{$context.$variables.flightClassLov}}\nlet FlightTypeVar- {{$context.$variables.flightTypeLov}}\nlet GetAllReceiptCurrenciesVar- {{$context.$nodes.GETALLRECEIPTCURRENCIES.$output}} \nlet isReplyFlow - {{$context.$triggers.REST.$input.isReplyFlow}}\n\n\n\n\n{{$context.$nodes.DEFAULTLOWVOLRESOLVERPROMPT.$output.result.expensePrompt}}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"title\": \"ResolvedInstructions\",\n    \"type\": \"object\",\n    \"description\": \"List of decomposed user instructions derived from the original message\",\n    \"required\": [\n        \"ResolvedInstructions\"\n    ],\n    \"properties\": {\n        \"ResolvedInstructions\": {\n            \"type\": \"array\",\n            \"items\": {\n                \"$ref\": \"#/definitions/ResolvedInstructions\"\n            },\n            \"minItems\": 1\n        }\n    },\n    \"definitions\": {\n        \"ResolvedInstructions\": {\n            \"type\": \"object\",\n            \"required\": [\n                \"message\",\n                \"type\",\n                \"field\",\n                \"value\",\n                \"reasoning\"\n            ],\n            \"properties\": {\n                \"message\": {\n                    \"type\": \"string\",\n                    \"description\": \"Sub-message extracted from the original user instruction\"\n                },\n                \"type\": {\n                    \"type\": \"string\",\n                    \"description\": \"Resolution status of the instruction\",\n                    \"enum\": [\n                        \"resolved\",\n                        \"unsupported\",\n                        \"irrelevant\"\n                    ]\n                },\n                \"field\": {\n                    \"description\": \"Target field(s) identified in the instruction\",\n                    \"oneOf\": [\n                        {\n                            \"type\": \"string\"\n                        },\n                        {\n                            \"type\": \"array\",\n                            \"items\": {\n                                \"type\": \"string\"\n                            },\n                            \"minItems\": 1\n                        }\n                    ]\n                },\n                \"value\": {\n                    \"description\": \"Value(s) associated with the identified field(s)\",\n                    \"oneOf\": [\n                        {\n                            \"type\": \"string\"\n                        },\n                        {\n                            \"type\": \"array\",\n                            \"items\": {\n                                \"type\": \"string\"\n                            },\n                            \"minItems\": 1\n                        },\n                        {\n                            \"type\": \"object\"\n                        }\n                    ]\n                },\n                \"reasoning\": {\n                    \"type\": \"string\",\n                    \"description\": \"Explanation of how the instruction was interpreted and classified\"\n                }\n            },\n            \"additionalProperties\": false\n        }\n    }\n}",
          "type": "LLM"
        },
