            "name": "filterLowVolumeFields",
            "returnType": "array",
            "sourceCode": "//let raw = $context.$nodes.EXPENSE_MESSAGE_DECOMPOSITION_AGENT;\n let raw=$context.$triggers.REST.$input.userDecompositionAgentOutput; \n// Step 1: parse output if needed\nlet output = raw;\n\nif (typeof output === \"string\") {\n  try {\n    output = JSON.parse(output);\n  } catch (e) {\n    output = {};\n  }\n}\n\n// Step 2: extract result\nlet DecomposedInstructionsArray =\n  output?.result?.DecomposedInstructions || [];\n\n\nlet LowVolumeFields = [\"receiptCurrency\",\"flightClass\",\"flightType\",\"expenseType\",\"spendAuthorizationLine\"];\nlet LowVolumeFieldsArray = DecomposedInstructionsArray.filter(inst => inst?.field && LowVolumeFields.includes(inst.field));\nreturn LowVolumeFieldsArray;"
          },
          "outcomes": {
            "success": "1772636516837"
          },
