            "name": "Prepare Input Payload for Defaulting",
            "returnType": "object",
            "sourceCode": "let decompositionOutput =\n  $context.$nodes.FILTERLOWVOLUMEFIELDS.$output.result || [];\n\nlet expenseTypeValue = \"\";\n\nif (Array.isArray(decompositionOutput)) {\n  let expenseTypeInstruction = decompositionOutput.find(\n    inst => inst?.field === \"expenseType\"\n  );\n\n  expenseTypeValue = expenseTypeInstruction?.value\n    ? \"Expense Type is \" + String(expenseTypeInstruction.value)\n    : \"\";\n}\n\nlet payload = {\n  partnerExpense: {\n    endDate: $context.$triggers.REST.$input.expenseData.expenseDate\n  },\n  expenseTypeValue: expenseTypeValue\n};\n\nreturn payload;"
          },
