        {
          "metadata": {
            "name": "Add Predicted Expense Type",
            "returnType": "object",
            "sourceCode": "let resolvedInstructions =\n  $context.$nodes.LOW_VOLUME_RESOLUTION.$output.ResolvedInstructions || [];\n\nlet expenseTypeAssistantOutput =\n  $context.$nodes.EXPENSE_DEFAULTING_ASSISTANT.$output;\n\nlet emptyObject = new Object();\n\nlet rawOutput = expenseTypeAssistantOutput\n  ? expenseTypeAssistantOutput.output\n  : null;\n\nlet rawPrediction =\n  typeof rawOutput === \"string\"\n    ? JSON.parse(rawOutput)\n    : rawOutput || emptyObject;\n\nlet expenseTypePrediction =\n  rawPrediction && rawPrediction.result\n    ? rawPrediction.result\n    : rawPrediction;\n\nlet predictedExpenseType =\n  expenseTypePrediction.predictedExpenseType || new Object();\n\nlet expenseTypeId = predictedExpenseType.expenseTypeId;\nlet expenseTypeName = predictedExpenseType.name;\n\nlet rawInput = expenseTypeAssistantOutput\n  ? expenseTypeAssistantOutput.input\n  : null;\n\nlet expenseTypeAssistantInput =\n  typeof rawInput === \"string\"\n    ? JSON.parse(rawInput)\n    : rawInput || new Object();\n\nresolvedInstructions = resolvedInstructions.filter(\n  instruction => instruction && instruction.field !== \"expenseType\"\n);\n\nlet expenseTypeValue = new Object();\n\nif (expenseTypeId != null) {\n  expenseTypeValue.id = expenseTypeId;\n  expenseTypeValue.name = expenseTypeName;\n}\n\nlet resolvedExpenseType = new Object();\nresolvedExpenseType.message =\n  expenseTypeAssistantInput.parameters &&\n  expenseTypeAssistantInput.parameters.userMessage\n    ? expenseTypeAssistantInput.parameters.userMessage\n    : \"<sentence>\";\nresolvedExpenseType.type =\n  expenseTypeId == null ? \"notResolved\" : \"resolved\";\nresolvedExpenseType.field = \"expenseType\";\nresolvedExpenseType.value = expenseTypeValue;\nresolvedExpenseType.reasoning = expenseTypePrediction.reason;\n\nresolvedInstructions.push(resolvedExpenseType);\n\nlet finalOutput = new Object();\nfinalOutput.ResolvedInstructions = resolvedInstructions;\n\nreturn finalOutput;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "ADD_PREDICTED_EXPENSE_TYPE",
          "id": "1782382561566",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Add Irrelevant Expense Type Prediction",
            "returnType": "object",
            "sourceCode": "let resolvedInstructions =\n  $context.$nodes.LOW_VOLUME_RESOLUTION.$output.ResolvedInstructions || [];\n\nlet decompositionOutput =\n  $context.$nodes.FILTERLOWVOLUMEFIELDS.$output.result || [];\n\nlet isExpenseTypePresent =\n  Array.isArray(decompositionOutput) &&\n  decompositionOutput.some(inst => inst?.field === \"expenseType\");\n\nlet isReplyFlow =\n  $context.$triggers.REST.$input.isReplyFlow === true;\n\nif (isExpenseTypePresent && !isReplyFlow) {\n  // Remove existing expense type instruction, if already present\n  resolvedInstructions = resolvedInstructions.filter(\n    instruction => instruction?.field !== \"expenseType\"\n  );\n\n  resolvedInstructions.push({\n    message: $context.$triggers.REST.$input.userMessage,\n    type: \"irrelevant\",\n    field: \"expenseType\",\n    value: $context.$triggers.REST.$input.userMessage,\n    reasoning: \"reply flow is false\"\n  });\n}\n\nlet finalOutput = {\n  ResolvedInstructions: resolvedInstructions\n};\n\nreturn finalOutput;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "ADD_IRRELEVANT_EXPENSE_TYPE_PREDICTION",
          "id": "1782382677258",
