        {
          "metadata": {
            "name": "Merge Data Pipeline Results",
            "returnType": "object",
            "sourceCode": "var isFollowUp = $context.$nodes.INTENT_CLASSIFIER.$output.isFollowUp === true;\nvar prevState = $context.$variables.conversationState || {};\nvar prevModel = prevState.lastModelData || {};\n\n\n// Start with previous model if follow-up, else fresh\nvar modelData = isFollowUp ? JSON.parse(JSON.stringify(prevModel)) : {};\nvar resultsList = $context.$nodes.EXECUTE_DATA_PIPELINES.$output;\nfor (var i = 0; i < resultsList.length; i++) {\n  var envelope = resultsList[i];\n  var itemParent = JSON.parse(envelope);\n  var item = itemParent.result;\n\n  if (!item || !item.taskId) continue;\n\n  if (item.taskId === \"SUMMARY\") {\n    modelData.summaryMetrics = item.summaryMetrics;\n    if (item.isRootNodeRequired === true) {\n      modelData.diagnosticRootData = item.diagnosticRootData;\n      modelData.expandedTruncatedNodes = item.expandedTruncatedNodes;\n    }\n  }\n\n  if (item.taskId === \"FAILURE\") {\n    //modelData.failureTreeData = item.failureTreeData;\n    modelData.dominantFailedPaths = item.dominantFailedPaths;\n    modelData.expandedDominantFailedNodes = item.expandedDominantFailedNodes;\n  }\n\n  if (item.taskId === \"MULTISTOP\") {\n    modelData.multistopData = item.multistopData;\n    modelData.isMultiStopDataLoadedAlready = item.isMultiStopDataLoadedAlready;\n  }\n\n  if (item.taskId === \"ENTITY\") {\n    modelData.entityImpact = item.entityImpact;\n    modelData.failureTreeData = item.failureTreeData;\n    modelData.dominantFailedPaths = item.dominantFailedPaths;\n    modelData.expandedDominantFailedNodes = item.expandedDominantFailedNodes;\n  }\n\n  if (item.taskId === \"PROCESS\") {\n    modelData.processImpact = item.processImpact;\n    modelData.failureTreeData = item.failureTreeData;\n    modelData.dominantFailedPaths = item.dominantFailedPaths;\n    modelData.expandedDominantFailedNodes = item.expandedDominantFailedNodes;\n  }\n\n  if (item.taskId === \"TUNING\") {\n    modelData.tuningRecommendations = item.tuningRecommendations;\n  }\n}\n\nvar merged = {\n  modelData: modelData,\n  diagnosticViewFlow: $context.$nodes.INTENT_CLASSIFIER.$output.diagnosticViewFlow,\n  primaryMode: $context.$nodes.INTENT_CLASSIFIER.$output.primaryMode,\n  modes: $context.$nodes.INTENT_CLASSIFIER.$output.modes,\n  focus: $context.$nodes.INTENT_CLASSIFIER.$output.focus,\n  entityQuery: $context.$nodes.INTENT_CLASSIFIER.$output.entityQuery,\n  processQuery: $context.$nodes.INTENT_CLASSIFIER.$output.processQuery\n};\n\nreturn merged;"
          },
