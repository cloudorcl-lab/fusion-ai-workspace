        {
          "metadata": {
            "name": "Build Data Pipeline Tasks",
            "returnType": "object",
            "sourceCode": "const TASKS = {\n  SUMMARY: \"SUMMARY\",\n  FAILURE: \"FAILURE\",\n  MULTISTOP: \"MULTISTOP\",\n  TUNING: \"TUNING\",\n  ENTITY: \"ENTITY\",\n  PROCESS: \"PROCESS\"\n};\n\nconst tasks = [];\nconst added = {};\n\nconst dataNeeds = $context.$nodes.INTENT_CLASSIFIER.$output.dataNeeds;\nconst entityQuery = $context.$nodes.INTENT_CLASSIFIER.$output.entityQuery;\nconst processQuery = $context.$nodes.INTENT_CLASSIFIER.$output.processQuery;\nconst isFollowUp = $context.$nodes.INTENT_CLASSIFIER.$output.isFollowUp === true;\nconst last = $context.$variables.conversationState || {};\nconst lastData = last.lastModelData || {};\n\n// ---------- SUMMARY ----------\nif (dataNeeds.needSummaryMetrics && !added[TASKS.SUMMARY]) {\n  const hasAll =\n    lastData.diagnosticRootData &&\n    lastData.expandedTruncatedNodes;\n\n  if (!(isFollowUp && hasAll)) {\n    tasks.push({ id: TASKS.SUMMARY });\n    added[TASKS.SUMMARY] = true;\n  }\n}\n\n// ---------- FAILURE ----------\nif ((dataNeeds.needFailureTree || dataNeeds.needDominantFailurePaths) && !added[TASKS.FAILURE]) {\n  const hasAll =\n    lastData.failureTreeData &&\n    lastData.dominantFailedPaths &&\n    lastData.expandedDominantFailedNodes;\n\n  if (!(isFollowUp && hasAll)) {\n    tasks.push({ id: TASKS.FAILURE });\n    added[TASKS.FAILURE] = true;\n  }\n}\n\n// ---------- MULTISTOP ----------\nif (dataNeeds.needMultistopData && !added[TASKS.MULTISTOP]) {\n  if (!(isFollowUp && lastData.multistopData)) {\n    tasks.push({ id: TASKS.MULTISTOP });\n    added[TASKS.MULTISTOP] = true;\n  }\n}\n\n// ---------- ENTITY ----------\nif (entityQuery && entityQuery.type && !added[TASKS.ENTITY]) {\n  const hasAll =\n    lastData.entityImpact &&\n    lastData.dominantFailedPaths &&\n    lastData.expandedDominantFailedNodes;\n\n  if (!(isFollowUp && hasAll)) {\n    tasks.push({ id: TASKS.ENTITY });\n    added[TASKS.ENTITY] = true;\n  }\n}\n\n// ---------- PROCESS ----------\nif (processQuery && processQuery.processType && !added[TASKS.PROCESS]) {\n  const hasAll =\n    lastData.processImpact &&\n    lastData.dominantFailedPaths &&\n    lastData.expandedDominantFailedNodes;\n\n  if (!(isFollowUp && hasAll)) {\n    tasks.push({ id: TASKS.PROCESS });\n    added[TASKS.PROCESS] = true;\n  }\n}\n\nreturn tasks;"
          },
