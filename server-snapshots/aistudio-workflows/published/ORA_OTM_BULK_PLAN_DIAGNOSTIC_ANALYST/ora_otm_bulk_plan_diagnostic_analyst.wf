          "id": "1768554775336",
          "name": "failurePropagationTree",
          "type": "object",
          "typeSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"required\": [\n    \"actualDepth\",\n    \"completeTree\",\n    \"requestedDepth\",\n    \"returnedDepth\",\n    \"status\",\n    \"tree\"\n  ],\n  \"properties\": {\n    \"actualDepth\": {\n      \"type\": \"integer\",\n      \"description\": \"The total depth of the given diagnostic tree data.\"\n    },\n    \"completeTree\": {\n      \"type\": \"boolean\"\n    },\n    \"reason\": {\n      \"type\": \"string\",\n      \"description\": \"Specifies the reason in case the status is FAILURE.\"\n    },\n    \"requestedDepth\": {\n      \"type\": \"integer\",\n      \"description\": \"The requested depth of the tree.\"\n    },\n    \"returnedDepth\": {\n      \"type\": \"integer\",\n      \"description\": \"The returned depth of the tree.\"\n    },\n    \"status\": {\n      \"type\": \"string\",\n      \"description\": \"The status of the process. SUCCESS or FAILURE.\"\n    },\n    \"tree\": {\n      \"$ref\": \"#/definitions/TreeNode\"\n    }\n  },\n  \"definitions\": {\n    \"TreeNode\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"id\",\n        \"processType\",\n        \"status\",\n        \"duration\",\n        \"remarks\",\n        \"reasonCodeList\",\n        \"nonDBEntities\",\n        \"entities\",\n        \"childIds\",\n        \"children\"\n      ],\n      \"properties\": {\n        \"id\": {\n          \"type\": \"string\",\n          \"description\": \"The ID of the diagnostic tree node.\"\n        },\n        \"status\": {\n          \"type\": \"string\",\n          \"description\": \"The status of the process.\"\n        },\n        \"processType\": {\n          \"type\": \"string\",\n          \"description\": \"The name of the process the node represents.\"\n        },\n        \"duration\": {\n          \"type\": \"string\",\n          \"description\": \"Execution duration (e.g., 35.35S).\"\n        },\n        \"childIds\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" }\n        },\n        \"children\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"$ref\": \"#/definitions/TreeNode\"\n          }\n        },\n        \"entities\": {\n          \"type\": \"object\",\n          \"additionalProperties\": {\n            \"type\": \"array\",\n            \"items\": { \"type\": \"string\" }\n          }\n        },\n        \"nonDBEntities\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" }\n        },\n        \"reasonCodeList\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" }\n        },\n        \"remarks\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" }\n        },\n        \"exportFiles\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" }\n        },\n        \"isTruncated\": {\n          \"type\": \"boolean\",\n          \"description\": \"True if children are truncated due to depth limit.\"\n        }\n      }\n    }\n  },\n  \"additionalProperties\": false\n}"
