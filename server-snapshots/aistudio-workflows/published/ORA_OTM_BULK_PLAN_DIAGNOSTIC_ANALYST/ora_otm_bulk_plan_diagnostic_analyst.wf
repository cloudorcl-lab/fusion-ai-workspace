                          "type": "BO_FUNCTION"
                        },
                        {
                          "metadata": {
                            "name": "Pre Process Fetched Dominant Process Node",
                            "returnType": "object",
                            "sourceCode": "var fetchNode = $context.$nodes.EXECUTE_DATA_PIPELINES.EXPAND_DOMINANT_FAILED_PROCESS_NODES.FETCH_TRUNCATED_DOMINANT_FAILED_PROCESS_NODE.$output;\nvar root = fetchNode && fetchNode.tree ? fetchNode.tree : null;\n\nvar stack = root ? [root] : [];\nwhile (stack.length > 0) {\n  var node = stack.pop();\n  if (!node || typeof node !== \"object\") continue;\n\n  // Remove empty arrays / objects\n  if (node.remarks && node.remarks.length === 0) delete node.remarks;\n  if (node.reasonCodeList && node.reasonCodeList.length === 0) delete node.reasonCodeList;\n  if (node.nonDBEntities && node.nonDBEntities.length === 0) delete node.nonDBEntities;\n  if (node.exportFiles && node.exportFiles.length === 0) delete node.exportFiles;\n\n  if (node.entities && Object.keys(node.entities).length === 0) delete node.entities;\n  if (node.childIds && node.childIds.length === 0) delete node.childIds;\n\n  if (node.children && node.children.length > 0) {\n    for (var i = 0; i < node.children.length; i++) {\n      stack.push(node.children[i]);\n    }\n  }\n}\n\nroot;"
                          },
                          "outcomes": {
                            "success": "end_1768702802039"
                          },
                          "code": "PRE_PROCESS_FETCHED_DOMINANT_PROCESS_NODE",
                          "id": "1768703066602",
                          "inputs": [],
                          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                          "type": "CODE"
                        }
                      ],
                      "rootNode": "start_1768702802039"
                    },
                    "loopType": "PARALLEL",
                    "name": "Expand Dominant Failed Process Nodes"
                  },
                  "outcomes": {
                    "success": "1768655736432"
                  },
                  "code": "EXPAND_DOMINANT_FAILED_PROCESS_NODES",
                  "id": "1768702802039",
                  "inputs": [
                    {
                      "id": "1768702802041_1",
                      "name": "collection",
                      "type": "string",
                      "value": "{{$context.$nodes.EXECUTE_DATA_PIPELINES.IDENTIFY_DOMINANT_FAILED_PROCESS_NODES.$output.result}}"
                    }
                  ],
                  "type": "LOOP"
                },
                {
                  "metadata": {
                    "name": "Identify Dominant Root Cause Nodes",
                    "returnType": "object",
                    "sourceCode": "var fetchNode = $context.$nodes.EXECUTE_DATA_PIPELINES.FETCH_ONLY_FAILED_NODES_TREE_DATA.$output;\nvar root = fetchNode && fetchNode.tree ? fetchNode.tree : null;\n\nvar dominantFailures = [];\nvar MAX_DOMINANT = 20;\nvar dominantIdMap = {};\n\nvar stack = [];\nif (root) stack.push({ node: root, path: [] });\n\n// First pass: find dominant root-cause nodes + propagation paths\nwhile (stack.length > 0 && dominantFailures.length < MAX_DOMINANT) {\n  var current = stack.pop();\n  var node = current.node;\n  var path = current.path.concat(node);\n\n  if (node.status === \"FAILURE\") {\n\n    // Check: no visible failed children\n    var hasFailedChild = false;\n    if (node.children && node.children.length > 0) {\n      for (var i = 0; i < node.children.length; i++) {\n        if (node.children[i].status === \"FAILURE\") {\n          hasFailedChild = true;\n          break;\n        }\n      }\n    }\n\n    // Check: propagates to root (all parents FAILURE)\n    var propagatesToRoot = true;\n    for (var j = 0; j < path.length; j++) {\n      if (path[j].status !== \"FAILURE\") {\n        propagatesToRoot = false;\n        break;\n      }\n    }\n\n    if (!hasFailedChild && propagatesToRoot) {\n      // Build slim dominantFailedPath\n      var slimPath = [];\n      for (var k = 0; k < path.length; k++) {\n        slimPath.push({\n          nodeId: path[k].id,\n          process: path[k].processType,\n          status: path[k].status\n        });\n      }\n\n      dominantFailures.push({\n        id: node.id,\n        process: node.processType,\n        status: node.status,\n        isTruncated: node.isTruncated === true,\n        remarks: node.remarks || [],\n        pathToRoot: slimPath,\n        childrenSummary: []   // filled in second pass\n      });\n\n      dominantIdMap[node.id] = true;\n    }\n  }\n\n  if (node.children && node.children.length > 0) {\n    for (var m = 0; m < node.children.length; m++) {\n      stack.push({\n        node: node.children[m],\n        path: path\n      });\n    }\n  }\n}\n\n// Second pass: add one-level expansion (childrenSummary)\nif (root) {\n  var stack2 = [root];\n\n  while (stack2.length > 0) {\n    var n = stack2.pop();\n\n    if (dominantIdMap[n.id]) {\n      for (var d = 0; d < dominantFailures.length; d++) {\n        if (dominantFailures[d].id === n.id) {\n          if (n.children && n.children.length > 0) {\n            for (var c = 0; c < n.children.length; c++) {\n              dominantFailures[d].childrenSummary.push({\n                nodeId: n.children[c].id,\n                process: n.children[c].processType,\n                status: n.children[c].status,\n                isTruncated: n.children[c].isTruncated === true,\n                remarks: n.children[c].remarks || []\n              });\n            }\n          }\n          break;\n        }\n      }\n    }\n\n    if (n.children && n.children.length > 0) {\n      for (var x = 0; x < n.children.length; x++) {\n        stack2.push(n.children[x]);\n      }\n    }\n  }\n}\n\ndominantFailures;"
                  },
                  "outcomes": {
                    "success": "1768649961197"
                  },
                  "code": "IDENTIFY_DOMINANT_ROOT_CAUSE_NODES",
                  "id": "1768836926026",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "Merge Expanded Dominant Cause Nodes",
                    "returnType": "object",
                    "sourceCode": "var dominantFailuresWrapper = $context.$nodes.EXECUTE_DATA_PIPELINES.IDENTIFY_DOMINANT_ROOT_CAUSE_NODES.$output;\nvar dominantFailures = dominantFailuresWrapper.result;\nvar expandedMap = {};\n\nvar resultsList = $context.$nodes.EXECUTE_DATA_PIPELINES.EXPAND_DOMINANT_FAILED_TRUNCATED_NODES.$output;\nfor (var i = 0; i < resultsList.length; i++) {\n  var envelope = resultsList[i];\n  var itemParent = JSON.parse(envelope);\n  var item = itemParent.result;\n\n  if (!item || !item.id) continue;\n  expandedMap[item.id] = item;\n}\n\n// Merge into dominantFailures\nfor (var d = 0; d < dominantFailures.length; d++) {\n  var dom = dominantFailures[d];\n  \n  if (dom.isTruncated === true && expandedMap[dom.id]) {\n    var expNode = expandedMap[dom.id];\n\n    dom.childrenSummary = [];\n\n    if (expNode.children && expNode.children.length > 0) {\n      for (var c = 0; c < expNode.children.length; c++) {\n        var child = expNode.children[c];\n        dom.childrenSummary.push(child);\n      }\n    }\n  }\n}\n\nreturn dominantFailures;"
                  },
                  "outcomes": {
                    "success": "1768655736432"
                  },
                  "code": "MERGE_EXPANDED_DOMINANT_CAUSE_NODES",
                  "id": "1768847558233",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                }
