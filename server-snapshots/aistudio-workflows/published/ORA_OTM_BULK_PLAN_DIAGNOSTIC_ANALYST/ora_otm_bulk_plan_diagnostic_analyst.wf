                  "id": "1768663733145",
                  "inputs": [
                    {
                      "id": "1768674478339_1",
                      "name": "diag_log_file_id",
                      "type": "string",
                      "value": "{{$context.$variables.diagnosticLogFileId}}"
                    },
                    {
                      "id": "1768674478340_2",
