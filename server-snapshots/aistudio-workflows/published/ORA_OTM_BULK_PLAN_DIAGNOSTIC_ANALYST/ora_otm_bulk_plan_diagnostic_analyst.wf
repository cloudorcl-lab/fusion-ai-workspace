                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"shipments\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"shipmentId\": { \"type\": \"string\" },\n          \"name\": { \"type\": \"string\" },\n          \"serviceProvider\": { \"type\": [\"string\", \"null\"] },\n          \"rateOffering\": { \"type\": [\"string\", \"null\"] },\n          \"equipmentGroup\": { \"type\": [\"string\", \"null\"] },\n          \"combinedFrom\": {\n            \"type\": \"array\",\n            \"items\": { \"type\": \"string\" }\n          },\n          \"orderGids\": {\n            \"type\": \"array\",\n            \"items\": { \"type\": \"string\" }\n          },\n          \"stops\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"stopNumber\": { \"type\": \"integer\" },\n                \"locationGid\": { \"type\": \"string\" }\n              },\n              \"required\": [\"stopNumber\", \"locationGid\"]\n            }\n          }\n        },\n        \"required\": [\"shipmentId\", \"name\", \"orderGids\", \"stops\"]\n      }\n    },\n    \"iterations\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"iterationNo\": { \"type\": \"integer\" },\n          \"shipmentGids\": {\n            \"type\": \"array\",\n            \"items\": { \"type\": \"string\" }\n          },\n          \"savingsMatrix\": {\n            \"type\": [\"object\", \"null\"],\n            \"properties\": {\n              \"firstShipment\": { \"type\": \"string\" },\n              \"secondShipment\": { \"type\": \"string\" },\n              \"savingsValue\": { \"type\": \"number\" }\n            }\n          },\n          \"combinedShipment\": {\n            \"type\": [\"object\", \"null\"],\n            \"properties\": {\n              \"shipmentId\": { \"type\": \"string\" },\n              \"name\": { \"type\": \"string\" },\n              \"serviceProvider\": { \"type\": [\"string\", \"null\"] },\n              \"rateOffering\": { \"type\": [\"string\", \"null\"] },\n              \"equipmentGroup\": { \"type\": [\"string\", \"null\"] },\n              \"combinedFrom\": {\n                \"type\": \"array\",\n                \"items\": { \"type\": \"string\" }\n              },\n              \"orderGids\": {\n                \"type\": \"array\",\n                \"items\": { \"type\": \"string\" }\n              },\n              \"stops\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"stopNumber\": { \"type\": \"integer\" },\n                    \"locationGid\": { \"type\": \"string\" }\n                  },\n                  \"required\": [\"stopNumber\", \"locationGid\"]\n                }\n              }\n            }\n          }\n        },\n        \"required\": [\"iterationNo\", \"shipmentGids\"]\n      }\n    }\n  }\n}",
