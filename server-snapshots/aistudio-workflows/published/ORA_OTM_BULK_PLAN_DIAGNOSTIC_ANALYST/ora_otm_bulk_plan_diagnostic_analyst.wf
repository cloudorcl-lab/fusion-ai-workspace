                  "metadata": {
                    "name": "Identify Failed Truncated Nodes",
                    "returnType": "object",
                    "sourceCode": "var truncatedNodes = [];\nvar rootNodeOutput = $context.$nodes.EXECUTE_DATA_PIPELINES.FETCH_DIAGNOSTIC_ROOT_NODE_DATA;\nvar stack = [];\n//var MAX_NODES = $context.$nodes.EXECUTE_DATA_PIPELINES.DEPTH_EVALUATOR.$output.maxTruncatedNodesToExpand ;\nvar MAX_NODES = 1 ;\n\nif (rootNodeOutput && rootNodeOutput.$output && rootNodeOutput.$output.tree) {\n  stack.push(rootNodeOutput.$output.tree);\n}\n\nwhile (stack.length && truncatedNodes.length < MAX_NODES) {\n  var node = stack.pop();\n  if (!node || typeof node !== \"object\") continue;\n\n  if (node.isTruncated === true ) {\n    truncatedNodes.push({\n      id: node.id,\n      processType: node.processType,\n      status: node.status\n    });\n  }\n\n  if (node.children && node.children.length > 0) {\n    for (var i = 0; i < node.children.length; i++) {\n      stack.push(node.children[i]);\n    }\n  }\n}\n\ntruncatedNodes;"
                  },
