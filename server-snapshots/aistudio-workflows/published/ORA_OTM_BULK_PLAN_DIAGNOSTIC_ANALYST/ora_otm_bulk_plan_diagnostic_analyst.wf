          "name": "multistopData",
          "type": "object",
          "typeSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"iterations\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"iterationNo\",\n          \"shipmentGids\"\n        ],\n        \"properties\": {\n          \"iterationNo\": {\n            \"type\": \"integer\"\n          },\n          \"shipmentGids\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"combinedShipment\": {\n            \"type\": [\n              \"object\",\n              \"null\"\n            ],\n            \"properties\": {\n              \"combinedFrom\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"equipmentGroup\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              },\n              \"name\": {\n                \"type\": \"string\"\n              },\n              \"orderGids\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"rateOffering\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              },\n              \"serviceProvider\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ]\n              },\n              \"shipmentId\": {\n                \"type\": \"string\"\n              },\n              \"stops\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"required\": [\n                    \"locationGid\",\n                    \"stopNumber\"\n                  ],\n                  \"properties\": {\n                    \"locationGid\": {\n                      \"type\": \"string\"\n                    },\n                    \"stopNumber\": {\n                      \"type\": \"integer\"\n                    }\n                  }\n                }\n              }\n            }\n          },\n          \"savingsMatrix\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"firstShipment\": {\n                \"type\": \"string\"\n              },\n              \"secondShipment\": {\n                \"type\": \"string\"\n              },\n              \"savingsValue\": {\n                \"type\": \"number\"\n              }\n            }\n          }\n        }\n      }\n    },\n    \"shipments\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"combinedFrom\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"equipmentGroup\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"orderGids\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"rateOffering\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          },\n          \"serviceProvider\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          },\n          \"shipmentId\": {\n            \"type\": \"string\"\n          },\n          \"stops\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"required\": [\n                \"locationGid\",\n                \"stopNumber\"\n              ],\n              \"properties\": {\n                \"locationGid\": {\n                  \"type\": \"string\"\n                },\n                \"stopNumber\": {\n                  \"type\": \"integer\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"
