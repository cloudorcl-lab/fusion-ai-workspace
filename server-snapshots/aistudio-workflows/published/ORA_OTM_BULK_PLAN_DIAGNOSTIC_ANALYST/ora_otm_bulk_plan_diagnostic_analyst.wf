                    "name": "Return Model Data",
                    "returnType": "object",
                    "sourceCode": "var taskId = $context.$nodes.EXECUTE_DATA_PIPELINES.$currentItem.id;\nvar views = $context.$nodes.INTENT_CLASSIFIER.$output.diagnosticViewFlow;\nvar results = { taskId: taskId, views: views };\n\nif (taskId === \"SUMMARY\") {\n  var isRootNodeRequired = $context.$nodes.EXECUTE_DATA_PIPELINES.IS_DIAGNOSTIC_ROOT_DATA_NEEDED.$output;\n  results.isRootNodeRequired = isRootNodeRequired;\n  results.diagnosticRootData = isRootNodeRequired\n    ? $context.$nodes.EXECUTE_DATA_PIPELINES.PRE_PROCESS_ROOT_NODE_DATA.$output.result\n    : null;\n  results.expandedTruncatedNodes = isRootNodeRequired\n    ? $context.$nodes.EXECUTE_DATA_PIPELINES.PROCESS_TRUNCATED_NODES.$output\n    : null;\n}\n\nif (taskId === \"FAILURE\") {\n  results.failureTreeData = $context.$nodes.EXECUTE_DATA_PIPELINES.PRE_PROCESS_FAILED_TREE_DATA.$output.result;\n  results.dominantFailedPaths = $context.$nodes.EXECUTE_DATA_PIPELINES.IDENTIFY_DOMINANT_ROOT_CAUSE_NODES.$output.result;\n  results.expandedDominantFailedNodes = $context.$nodes.EXECUTE_DATA_PIPELINES.MERGE_EXPANDED_DOMINANT_CAUSE_NODES.$output.result;\n}\n\nif (taskId === \"MULTISTOP\") {\n  results.multistopData = ($context.$variables.multistopDataLoaded === true)\n    ? $context.$variables.multistopData\n    : $context.$nodes.EXECUTE_DATA_PIPELINES.FETCH_MULTISTOP_DATA.$output;\n  results.isMultiStopDataLoadedAlready = ($context.$variables.multistopDataLoaded === true);\n}\n\nif (taskId === \"ENTITY\") {\n  results.entity = {\n    type: $context.$nodes.INTENT_CLASSIFIER.$output.entityQuery.type,\n    value: $context.$nodes.INTENT_CLASSIFIER.$output.entityQuery.value\n  };\n\n  results.failureTreeData = $context.$nodes.EXECUTE_DATA_PIPELINES.PRE_PROCESS_FAILED_ENTITY_DATA.$output;\n  results.dominantFailedPaths = $context.$nodes.EXECUTE_DATA_PIPELINES.IDENTIFY_DOMINANT_FAILED_ENTITY_NODES.$output.result;\n  results.expandedDominantFailedNodes = $context.$nodes.EXECUTE_DATA_PIPELINES.EXPAND_DOMINANT_FAILED_ENTITY_NODES.$output;\n}\n\nif (taskId === \"PROCESS\") {\n  results.processType = $context.$nodes.INTENT_CLASSIFIER.$output.processQuery.processType ;\n  results.failureTreeData = $context.$nodes.EXECUTE_DATA_PIPELINES.PRE_PROCESS_FAILED_PROCESS_DATA.$output;\n  results.dominantFailedPaths = $context.$nodes.EXECUTE_DATA_PIPELINES.IDENTIFY_DOMINANT_FAILED_PROCESS_NODES.$output.result;\n  results.expandedDominantFailedNodes = $context.$nodes.EXECUTE_DATA_PIPELINES.EXPAND_DOMINANT_FAILED_PROCESS_NODES.$output;\n}\n\nresults;"
                  },
