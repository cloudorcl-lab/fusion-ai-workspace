                    },
                    {
                      "id": "1768674478345_5",
                      "name": "entityType",
                      "type": "string",
                      "value": "{{$context.$nodes.INTENT_CLASSIFIER.$output.entityQuery.type}}"
                    },
                    {
                      "id": "1768674478346_6",
                      "name": "entityValue",
                      "type": "string",
                      "value": "{{$context.$nodes.INTENT_CLASSIFIER.$output.entityQuery.value}}"
                    }
                  ],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"required\": [\n    \"actualDepth\",\n    \"completeTree\",\n    \"requestedDepth\",\n    \"returnedDepth\",\n    \"status\",\n    \"tree\"\n  ],\n  \"properties\": {\n    \"actualDepth\": {\n      \"type\": \"integer\",\n      \"description\": \"The total depth of the given diagnostic tree data.\"\n    },\n    \"completeTree\": {\n      \"type\": \"boolean\"\n    },\n    \"reason\": {\n      \"type\": \"string\",\n      \"description\": \"Specifies the reason in case the status is FAILURE.\"\n    },\n    \"requestedDepth\": {\n      \"type\": \"integer\",\n      \"description\": \"The requested depth of the tree.\"\n    },\n    \"returnedDepth\": {\n      \"type\": \"integer\",\n      \"description\": \"The returned depth of the tree.\"\n    },\n    \"status\": {\n      \"type\": \"string\",\n      \"description\": \"The status of the process. SUCCESS or FAILURE.\"\n    },\n    \"tree\": {\n      \"$ref\": \"#/definitions/TreeNode\"\n    }\n  },\n  \"definitions\": {\n    \"TreeNode\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"id\",\n        \"processType\",\n        \"status\",\n        \"duration\",\n        \"remarks\",\n        \"reasonCodeList\",\n        \"nonDBEntities\",\n        \"entities\",\n        \"childIds\",\n        \"children\"\n      ],\n      \"properties\": {\n        \"id\": {\n          \"type\": \"string\",\n          \"description\": \"The ID of the diagnostic tree node.\"\n        },\n        \"status\": {\n          \"type\": \"string\",\n          \"description\": \"The status of the process.\"\n        },\n        \"processType\": {\n          \"type\": \"string\",\n          \"description\": \"The name of the process the node represents.\"\n        },\n        \"duration\": {\n          \"type\": \"string\",\n          \"description\": \"Execution duration (e.g., 35.35S).\"\n        },\n        \"childIds\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" }\n        },\n        \"children\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"$ref\": \"#/definitions/TreeNode\"\n          }\n        },\n        \"entities\": {\n          \"type\": \"object\",\n          \"additionalProperties\": {\n            \"type\": \"array\",\n            \"items\": { \"type\": \"string\" }\n          }\n        },\n        \"nonDBEntities\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" }\n        },\n        \"reasonCodeList\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" }\n        },\n        \"remarks\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" }\n        },\n        \"exportFiles\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" }\n        },\n        \"isTruncated\": {\n          \"type\": \"boolean\",\n          \"description\": \"True if children are truncated due to depth limit.\"\n        }\n      }\n    }\n  },\n  \"additionalProperties\": false\n}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "Pre Process Failed Entity Data",
                    "returnType": "object",
                    "sourceCode": "var fetchNode = $context.$nodes.EXECUTE_DATA_PIPELINES.FETCH_ENTITY_RELATED_FAILURE_DATA.$output;\nvar root = fetchNode && fetchNode.tree ? fetchNode.tree : null;\n\nvar stack = root ? [root] : [];\nwhile (stack.length > 0) {\n  var node = stack.pop();\n  if (!node || typeof node !== \"object\") continue;\n\n  // Remove empty arrays / objects\n  if (node.remarks && node.remarks.length === 0) delete node.remarks;\n  if (node.reasonCodeList && node.reasonCodeList.length === 0) delete node.reasonCodeList;\n  if (node.nonDBEntities && node.nonDBEntities.length === 0) delete node.nonDBEntities;\n  if (node.exportFiles && node.exportFiles.length === 0) delete node.exportFiles;\n\n  if (node.entities && Object.keys(node.entities).length === 0) delete node.entities;\n  if (node.childIds && node.childIds.length === 0) delete node.childIds;\n\n  if (node.children && node.children.length > 0) {\n    for (var i = 0; i < node.children.length; i++) {\n      stack.push(node.children[i]);\n    }\n  }\n}\n\nroot;"
                  },
                  "outcomes": {
                    "success": "1768698468891"
                  },
                  "code": "PRE_PROCESS_FAILED_ENTITY_DATA",
                  "id": "1768698419008",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "Identify Truncated Entity Nodes",
                    "returnType": "object",
                    "sourceCode": "var rootNodeOutput = $context.$nodes.EXECUTE_DATA_PIPELINES.FETCH_ENTITY_RELATED_FAILURE_DATA;\nvar results = [];\n\nif (!rootNodeOutput || !rootNodeOutput.$output || !rootNodeOutput.$output.tree) {\n  results;\n}\n\nvar root = rootNodeOutput.$output.tree;\nvar stack = [];\n\nstack.push({\n  node: root,\n  path: [{\n    id: root.id,\n    processType: root.processType,\n    status: root.status\n  }]\n});\n\nwhile (stack.length > 0) {\n  var item = stack.pop();\n  var node = item.node;\n  var path = item.path;\n\n  if (!node || typeof node !== \"object\") continue;\n\n  // If this node is truncated and a leaf in this reduced tree, capture its path\n  if (node.isTruncated === true && (!node.children || node.children.length === 0)) {\n    results.push({\n      id: node.id,\n      process: node.processType,\n      status: node.status,\n      pathToRoot: path\n    });\n  }\n\n  if (node.children && node.children.length > 0) {\n    for (var i = 0; i < node.children.length; i++) {\n      var child = node.children[i];\n      var newPath = path.slice(); // clone\n      newPath.push({\n        id: child.id,\n        processType: child.processType,\n        status: child.status\n      });\n\n      stack.push({\n        node: child,\n        path: newPath\n      });\n    }\n  }\n}\n\nresults;"
                  },
                  "outcomes": {
                    "success": "1768698530942"
                  },
                  "code": "IDENTIFY_TRUNCATED_ENTITY_NODES",
                  "id": "1768698468891",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "Identify Dominant Failed Entity Nodes",
                    "returnType": "object",
                    "sourceCode": "var data = $context.$nodes.EXECUTE_DATA_PIPELINES.IDENTIFY_TRUNCATED_ENTITY_NODES.$output.result;\nvar dominantPaths = [];\nvar MAX_DOMINANT = 3; //TODO\n\nfor (var i = 0; i < data.length; i++) {\n  var item = data[i];\n  var path = item.pathToRoot;\n\n  var allFailed = true;\n  for (var j = 0; j < path.length; j++) {\n    if (path[j].status === \"SUCCESS\") {\n      allFailed = false;\n      break;\n    }\n  }\n\n  if (allFailed) {\n    dominantPaths.push({\n      id: item.id,\n      process: item.process,\n      status: item.status,\n      pathToRoot: path\n    });\n  }\n\n  if (dominantPaths.length >= MAX_DOMINANT) break;\n}\n\ndominantPaths;"
                  },
                  "outcomes": {
                    "success": "1768698613306"
                  },
                  "code": "IDENTIFY_DOMINANT_FAILED_ENTITY_NODES",
                  "id": "1768698530942",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
