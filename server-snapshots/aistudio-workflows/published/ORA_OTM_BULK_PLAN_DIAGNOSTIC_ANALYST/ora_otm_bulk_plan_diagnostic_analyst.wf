            "returnType": "object",
            "sourceCode": "var intentClassifier = $context.$nodes.INTENT_CLASSIFIER.$output ;\nvar merged = $context.$nodes.MERGE_DATA_PIPELINE_RESULTS.$output.result;\n\nvar conversationState = {\n  lastDiagnosticLogFileId: $context.$variables.diagnosticLogFileId || null,\n  lastPrimaryMode: intentClassifier.primaryMode || null,\n  lastModes: intentClassifier.modes || [],\n  lastFocus: intentClassifier.focus || [],\n  lastEntityQuery: intentClassifier.entityQuery || null,\n  lastProcessQuery: intentClassifier.processQuery || null,\n  lastModelData: merged.modelData || null,\n  lastIntentClassifier: intentClassifier\n};\n\nconversationState;"
