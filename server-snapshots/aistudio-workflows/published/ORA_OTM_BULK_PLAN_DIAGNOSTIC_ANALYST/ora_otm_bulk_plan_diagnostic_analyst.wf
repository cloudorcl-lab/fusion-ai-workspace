                    "name": "Identify Truncated Process Nodes",
                    "returnType": "object",
                    "sourceCode": "var rootNodeOutput = $context.$nodes.EXECUTE_DATA_PIPELINES.FETCH_PROCESS_RELATED_FAILURE_DATA;\nvar results = [];\n\nif (!rootNodeOutput || !rootNodeOutput.$output || !rootNodeOutput.$output.tree) {\n  results;\n}\n\nvar root = rootNodeOutput.$output.tree;\nvar stack = [];\n\nstack.push({\n  node: root,\n  path: [{\n    id: root.id,\n    processType: root.processType,\n    status: root.status\n  }]\n});\n\nwhile (stack.length > 0) {\n  var item = stack.pop();\n  var node = item.node;\n  var path = item.path;\n\n  if (!node || typeof node !== \"object\") continue;\n\n  // If this node is truncated and a leaf in this reduced tree, capture its path\n  if (node.isTruncated === true && (!node.children || node.children.length === 0)) {\n    results.push({\n      id: node.id,\n      process: node.processType,\n      status: node.status,\n      pathToRoot: path\n    });\n  }\n\n  if (node.children && node.children.length > 0) {\n    for (var i = 0; i < node.children.length; i++) {\n      var child = node.children[i];\n      var newPath = path.slice(); // clone\n      newPath.push({\n        id: child.id,\n        processType: child.processType,\n        status: child.status\n      });\n\n      stack.push({\n        node: child,\n        path: newPath\n      });\n    }\n  }\n}\n\nresults;"
                  },
                  "outcomes": {
                    "success": "1768702724892"
                  },
                  "code": "IDENTIFY_TRUNCATED_PROCESS_NODES",
                  "id": "1768702665384",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "Identify Dominant Failed Process Nodes",
                    "returnType": "object",
                    "sourceCode": "var data = $context.$nodes.EXECUTE_DATA_PIPELINES.IDENTIFY_TRUNCATED_PROCESS_NODES.$output.result;\nvar dominantPaths = [];\nvar MAX_DOMINANT = 3; //TODO\n\nfor (var i = 0; i < data.length; i++) {\n  var item = data[i];\n  var path = item.pathToRoot;\n\n  var allFailed = true;\n  for (var j = 0; j < path.length; j++) {\n    if (path[j].status === \"SUCCESS\") {\n      allFailed = false;\n      break;\n    }\n  }\n\n  if (allFailed) {\n    dominantPaths.push({\n      id: item.id,\n      process: item.process,\n      status: item.status,\n      pathToRoot: path\n    });\n  }\n\n  if (dominantPaths.length >= MAX_DOMINANT) break;\n}\n\ndominantPaths;"
                  },
                  "outcomes": {
                    "success": "1768702802039"
                  },
                  "code": "IDENTIFY_DOMINANT_FAILED_PROCESS_NODES",
                  "id": "1768702724892",
