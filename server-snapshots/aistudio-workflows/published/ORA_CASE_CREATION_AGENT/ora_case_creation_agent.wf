        {
          "metadata": {
            "name": "Build grievance case payload",
            "returnType": "object",
            "sourceCode": "const contriFactors = $context.$nodes.GENERATE_CORE_CASE_ATTRIBUTES.$output.contributingFactors;\n\nconst factorsArray = contriFactors ? contriFactors.split(',').map(f => f.trim()).filter(f => f !== \"\") : [];\nconst categoryKey = $context.$nodes.GET_CASE_CATEGORY_ID.$output?.items?.[0]?.[\"@context\"]?.key;\n\nconst additionalAttributes = $context.$triggers.REST.$input.additionalAttributes ;\n\nconst payload= {\n        \"Title\": $context.$nodes.GENERATE_CORE_CASE_ATTRIBUTES.$output.caseTitle ,\n        \"Description\": $context.$nodes.GENERATE_CORE_CASE_ATTRIBUTES.$output.caseDescription ,\n        \"PrimaryContactPartyId\": $context.$variables.loggedInUserPartyId ,\n        \"CaseTypeCd\": \"ORA_SVC_CASE_GRIEVANCE\",\n        \"StripeCd\": $context.$nodes.GENERATE_CORE_CASE_ATTRIBUTES.$output?.stripeCd,\n        \"CaseCategoryId\" : categoryKey ,\n        \"IncidentOccurrenceDate\": $context.$nodes.SET_GRIEVANCE_RELATED_FIELDS.$output.incidentOccurrenceDate ,\n        \"ContributingFactorsCd\": factorsArray ,\n        \"FiledByTypeCd\": $context.$triggers.REST.$input.FiledByTypeCd ,\n        \"IncidentTypeCd\": $context.$nodes.SET_GRIEVANCE_RELATED_FIELDS.$output.incidentType ,\n        \"AllegationCd\": $context.$nodes.SET_GRIEVANCE_RELATED_FIELDS.$output.allegation \n    };\n\nlet finalPayload = { \n  ...payload, \n  ...(additionalAttributes || {}) \n};\n\nreturn finalPayload;"
          },
          "outcomes": {
            "success": "1772776753146"
          },
          "code": "BUILD_GRIEVANCE_CASE_PAYLOAD",
          "id": "1771499253267",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "CleanedUp Allegations Data",
            "returnType": "object",
            "sourceCode": "const rawOutput = $context.$nodes.GET_ALLEGATIONS.$output;\nconst parsed = (typeof rawOutput === 'string') ? JSON.parse(rawOutput) : rawOutput;\n\nconst cleanItems = (parsed.items || []).map(item => ({\n    Meaning: item.Meaning,\n    LookupCode: item.LookupCode\n}));\n\nreturn cleanItems;"
          },
          "outcomes": {
            "success": "1771323035074"
          },
          "code": "CLEANEDUP_ALLEGATIONS_DATA",
          "id": "1771579393118",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
