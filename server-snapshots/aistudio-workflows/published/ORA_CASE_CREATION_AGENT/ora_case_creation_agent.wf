            "returnType": "object",
            "sourceCode": "const rawOutput = $context.$nodes.GET_INCIDENT_TYPE.$output;\nconst parsed = (typeof rawOutput === 'string') ? JSON.parse(rawOutput) : rawOutput;\n\nconst cleanItems = (parsed.items || []).map(item => ({\n    Meaning: item.Meaning,\n    LookupCode: item.LookupCode\n}));\n\nreturn cleanItems;"
          },
          "outcomes": {
            "success": "1771323035074"
