          "id": "1771580933343",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Build create case payload",
            "returnType": "object",
            "sourceCode": "const categoryKey = $context.$nodes.GET_CASE_CATEGORY_ID.$output?.items?.[0]?.[\"@context\"]?.key;\nconst additionalAttributes = $context.$triggers.REST.$input.additionalAttributes ;\n\nconst payload= {\n        \"Title\": $context.$nodes.GENERATE_CORE_CASE_ATTRIBUTES.$output.caseTitle ,\n        \"Description\": $context.$nodes.GENERATE_CORE_CASE_ATTRIBUTES.$output.caseDescription ,\n        \"PrimaryContactPartyId\": $context.$variables.loggedInUserPartyId ,\n        \"StripeCd\": $context.$nodes.GENERATE_CORE_CASE_ATTRIBUTES.$output?.stripeCd,\n        \"CaseCategoryId\" : categoryKey \n    };\n\nlet finalPayload = { \n  ...payload, \n  ...(additionalAttributes || {}) \n};\n\nreturn finalPayload;"
          },
          "outcomes": {
            "success": "1772776663288"
          },
          "code": "BUILD_CREATE_CASE_PAYLOAD",
          "convergenceTargetId": "1771322915422",
          "id": "1771587077624",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Build DA case payload",
            "returnType": "object",
            "sourceCode": "const contriFactors = $context.$nodes.GENERATE_CORE_CASE_ATTRIBUTES.$output.contributingFactors;\nconst factorsArray = contriFactors ? contriFactors.split(',').map(f => f.trim()).filter(f => f !== \"\") : [];\n\nconst categoryKey = $context.$nodes.GET_CASE_CATEGORY_ID.$output?.items?.[0]?.[\"@context\"]?.key;\n\nconst measuresTaken = $context.$nodes.SET_DA_RELATED_FIELDS.$output.measuresTaken ;\nconst measuresTakenArray = measuresTaken ? measuresTaken.split(',').map(f => f.trim()).filter(f => f !== \"\") : [];\n\nconst reviewedBy = $context.$nodes.SET_DA_RELATED_FIELDS.$output.reviewedBy ;\nconst reviewedByArray = reviewedBy ? reviewedBy.split(',').map(f => f.trim()).filter(f => f !== \"\") : [];\n\nconst additionalAttributes = $context.$triggers.REST.$input.additionalAttributes ;\n\n\nconst payload= {\n        \"Title\": $context.$nodes.GENERATE_CORE_CASE_ATTRIBUTES.$output.caseTitle ,\n        \"Description\": $context.$nodes.GENERATE_CORE_CASE_ATTRIBUTES.$output.caseDescription ,\n        \"PrimaryContactPartyId\": $context.$variables.loggedInUserPartyId ,\n        \"CaseTypeCd\": \"ORA_SVC_CASE_DISCIPLINARY_ACT\",\n        \"StripeCd\": $context.$nodes.GENERATE_CORE_CASE_ATTRIBUTES.$output?.stripeCd,\n        \"CaseCategoryId\" : categoryKey ,\n        \"IncidentOccurrenceDate\": $context.$nodes.SET_DA_RELATED_FIELDS.$output.incidentOccurrenceDate ,\n        \"ContributingFactorsCd\": factorsArray ,\n        \"FiledByTypeCd\": $context.$triggers.REST.$input.FiledByTypeCd ,\n        \"MeasuresTakenCd\":  measuresTakenArray,\n        \"ReviewedByCd\": reviewedByArray\n    };\n\nlet finalPayload = { \n  ...payload, \n  ...(additionalAttributes || {}) \n};\n\nreturn finalPayload;"
          },
          "outcomes": {
            "success": "1772776710808"
          },
          "code": "BUILD_DA_CASE_PAYLOAD",
