            "name": "Prepare copy attachments payload",
            "returnType": "object",
            "sourceCode": "\nconst CaseId = $context.$nodes.CREATE_CASE.$output.CaseId;\nconst idArray = $context.$triggers.REST.$input.attachedDocumentIdList;\n\nconst sanitizedIds = (idArray && idArray.length > 0) \n    ? idArray.map(id => String(id).trim()) \n    : [];\n\nconst payload = {\n    \"caseId\": String(CaseId),\n    \"attachedDocumentIdList\": sanitizedIds\n};\n\nreturn payload;"
          },
          "outcomes": {
            "success": "1775561965374"
          },
