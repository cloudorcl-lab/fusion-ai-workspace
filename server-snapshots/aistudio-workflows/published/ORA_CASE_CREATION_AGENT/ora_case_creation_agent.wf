          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"Meaning\": { \"type\": \"string\" },\n          \"LookupCode\": { \"type\": \"string\" }\n        }\n      }\n    }\n  }\n}",
