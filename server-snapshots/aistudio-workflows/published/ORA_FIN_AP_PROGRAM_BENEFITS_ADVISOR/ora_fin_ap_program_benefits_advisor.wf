          "code": "FIN_AP_RAG_DOCUMENT_TOOL_FINANCING_PROGRAMS_RAG",
          "id": "1767867574054",
          "inputs": [
            {
              "id": "1767867574057_1",
              "name": "question",
              "type": "string",
              "value": "what are the complete details of each financing programs (Virtual Card, Dynamic Discounting and Supply Chain Financing) ?"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"AnswerWithCitations\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"value\": {\n      \"type\": \"string\",\n      \"description\": \"The answer text.\"\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"description\": \"List of citations relevant to the answer.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"citedText\": {\n            \"type\": \"string\",\n            \"description\": \"The cited text.\"\n          }\n        },\n        \"required\": [\n          \"citedText\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"value\",\n    \"citations\"\n  ],\n  \"additionalProperties\": false\n}",
          "type": "RAG_DOCUMENT_TOOL"
        },
        {
          "metadata": {
            "name": "Remove SCF Programs",
            "returnType": "object",
            "sourceCode": "const programBenefits = $context.$nodes.FIN_AP_BUSINESS_OBJECT_FUNCTION_PAYMENT_BENEFIT_SERVICE.$output || [];\n\n// Initialize trackers for the highest programs\nlet maxInternalVCC = null;\nlet maxExternalVCC = null;\nlet maxInternalDD = null;\nlet maxExternalDD = null;\n\n// 1. Filter out SCF and find highest benefits inline\nconst filteredBenefits = programBenefits\n  .map(item => {\n    let validRois = (item.roiResults || []).filter(\n      result => result.programType !== \"SUPPLY_CHAIN_FINANCING\"\n    );\n\n    // 2a. First Pass: Create a map of base program names to their origins (internal/external)\n    const categoryMap = {};\n    validRois.forEach(roi => {\n      if (roi.programCategory !== \"what-if\") {\n        const name = String(roi.programName || \"\").trim();\n        // Default to internal if programCategory is missing\n        categoryMap[name] = roi.programCategory || \"internal\";\n      }\n    });\n\n    // NEW STEP: Filter out orphaned what-if programs that have no base program\n    validRois = validRois.filter(roi => {\n      if (roi.programCategory === \"what-if\") {\n        const baseName = String(roi.programName || \"\").replace(/^what-if\\s*::\\s*/i, \"\").trim();\n        // Only keep this what-if if its base name was found in the categoryMap\n        return categoryMap.hasOwnProperty(baseName);\n      }\n      return true; // Keep all normal programs\n    });\n\n    // 2b. Second Pass: Scan valid results and evaluate totalBenefit\n    validRois.forEach(roi => {\n      let category = roi.programCategory || \"internal\";\n      \n      // If it's a what-if, look up its category from the base program map\n      if (category === \"what-if\") {\n        const baseName = String(roi.programName || \"\").replace(/^what-if\\s*::\\s*/i, \"\").trim();\n        category = categoryMap[baseName]; // No fallback needed now, we know it exists\n      }\n\n      const roiBenefit = Number(roi.totalBenefit) || 0;\n      const roiName = String(roi.programName || \"\").replace(/^what-if\\s*::\\s*/i, \"\").trim().toLowerCase();\n\n      if (roi.programType === \"VIRTUAL_CREDIT_CARD\") {\n        if (category === \"internal\") {\n          const currentBenefit = maxInternalVCC ? (Number(maxInternalVCC.totalBenefit) || 0) : null;\n          const currentName = maxInternalVCC ? String(maxInternalVCC.programName || \"\").replace(/^what-if\\s*::\\s*/i, \"\").trim().toLowerCase() : \"\";\n\n          if (!maxInternalVCC || roiBenefit > currentBenefit || (roiBenefit === currentBenefit && roiName < currentName)) {\n            maxInternalVCC = roi;\n          }\n        } else if (category === \"external\") {\n          const currentBenefit = maxExternalVCC ? (Number(maxExternalVCC.totalBenefit) || 0) : null;\n          const currentName = maxExternalVCC ? String(maxExternalVCC.programName || \"\").replace(/^what-if\\s*::\\s*/i, \"\").trim().toLowerCase() : \"\";\n\n          if (!maxExternalVCC || roiBenefit > currentBenefit || (roiBenefit === currentBenefit && roiName < currentName)) {\n            maxExternalVCC = roi;\n          }\n        }\n      } \n      \n      else if (roi.programType === \"DYNAMIC_DISCOUNTING\") {\n        if (category === \"internal\") {\n          const currentBenefit = maxInternalDD ? (Number(maxInternalDD.totalBenefit) || 0) : null;\n          const currentName = maxInternalDD ? String(maxInternalDD.programName || \"\").replace(/^what-if\\s*::\\s*/i, \"\").trim().toLowerCase() : \"\";\n\n          if (!maxInternalDD || roiBenefit > currentBenefit || (roiBenefit === currentBenefit && roiName < currentName)) {\n            maxInternalDD = roi;\n          }\n        } else if (category === \"external\") {\n          const currentBenefit = maxExternalDD ? (Number(maxExternalDD.totalBenefit) || 0) : null;\n          const currentName = maxExternalDD ? String(maxExternalDD.programName || \"\").replace(/^what-if\\s*::\\s*/i, \"\").trim().toLowerCase() : \"\";\n\n          if (!maxExternalDD || roiBenefit > currentBenefit || (roiBenefit === currentBenefit && roiName < currentName)) {\n            maxExternalDD = roi;\n          }\n        }\n      }\n    });\n\n    return {\n      ...item,\n      roiResults: validRois,\n    };\n  })\n  .filter(item => item.roiResults.length > 0); // remove empty suppliers\n\n// 3. Return the payload with the raw names intact\nreturn {\n  filteredBenefits: filteredBenefits,\n  \n  highestInternalVCC: maxInternalVCC ? maxInternalVCC.programName : \"N/A\",\n  highestExternalVCC: maxExternalVCC ? maxExternalVCC.programName : \"N/A\",\n  highestInternalDD: maxInternalDD ? maxInternalDD.programName : \"N/A\",\n  highestExternalDD: maxExternalDD ? maxExternalDD.programName : \"N/A\",\n  \n  highestInternalVCCBenefit: maxInternalVCC ? maxInternalVCC.totalBenefit : \"N/A\",\n  highestExternalVCCBenefit: maxExternalVCC ? maxExternalVCC.totalBenefit : \"N/A\",\n  highestInternalDDBenefit: maxInternalDD ? maxInternalDD.totalBenefit : \"N/A\",\n  highestExternalDDBenefit: maxExternalDD ? maxExternalDD.totalBenefit : \"N/A\"\n};"
          },
          "outcomes": {
            "success": "1774849459722"
          },
          "diagram": {
            "x": 5483,
            "y": 9034
          },
          "code": "FIN_AP_CODE_REMOVE_SCF_PROGRAMS",
          "convergenceTargetId": "1765868765203",
          "id": "1774945802098",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Capturing all Financing Programs",
            "returnType": "object",
            "sourceCode": "// Get signed financing programs\nconst data = $context.$nodes.FIN_AP_BUSINESS_OBJECT_FUNCTION_GET_SIGNED_FINANCING_PROGRAMS.$output;\nconst signedPrograms = (data.items || []).map(item => {\n  const obj = {\n    financingProgramId: item.financingProgramId,\n    financingProgramName: item.name,\n    financingProgramType: item.financingOptionTypeCode,\n    financingProgramCode: item.financingProgramCode,\n    financingProgramCategory: \"internal\",\n  };\n  if (item.maximumDiscountRate !== undefined) obj.maxAPR = item.maximumDiscountRate;\n  if (item.minimumDiscountRate !== undefined) obj.minAPR = item.minimumDiscountRate;\n  if (item.defaultDiscountRate !== undefined) obj.defaultAPR = item.defaultDiscountRate;\n  if (item.defaultCurrencyCode !== undefined) obj.defaultCurrencyCode = item.defaultCurrencyCode;\n  return obj;\n});\n\nconst signedCodesSet = new Set(signedPrograms.map(p => p.financingProgramCode));\n\n// Get and normalize rag programs\nconst ragOutput = $context.$nodes.FIN_AP_LLM_RAG_OUTPUT_PROCESSING_AGENT.$output.ragDocument ?? [];\nconst ragPrograms = ragOutput.map(item => {\n  const obj = {\n    financingProgramName: item.financingProgramName,\n    financingProgramType: item.financingProgramType,\n    financingProgramCode: item.financingProgramCode,\n  };\n  if (item.defaultAPR !== undefined) obj.defaultAPR = item.defaultAPR;\n  if (item.marketBorrowingInterestRate !== undefined) obj.marketBorrowingInterestRate = item.marketBorrowingInterestRate;\n  if (item.marketShortTermInvestmentInterestRate !== undefined) obj.marketShortTermInvestmentInterestRate = item.marketShortTermInvestmentInterestRate;\n  if (item.instruments !== undefined) obj.instruments = item.instruments;\n  return obj;\n});\n\n// Filter rag programs to avoid duplicates and mark as external\nconst uniqueRagPrograms = ragPrograms\n  .filter(program => !signedCodesSet.has(program.financingProgramCode))\n  .map(program => ({\n    ...program,\n    financingProgramCategory: \"external\",\n  }));\n\nconst allPrograms = signedPrograms.concat(uniqueRagPrograms);\n\nreturn allPrograms;"
          },
          "outcomes": {
            "success": "1774847018737"
          },
          "diagram": {
            "x": 5459,
            "y": 9256
          },
          "code": "FIN_AP_CODE_CAPTURING_ALL_FINANCING_PROGRAMS",
          "convergenceTargetId": "1765868765203",
          "id": "1774849459722",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.25
              },
              "code": "ORA_LLM_MODEL_PROVIDER_CERT_BASIC_LLAMA_3_3_70B",
              "model": "ORA_LLM_MODEL_GPT_OSS_120B",
              "modelName": "GPT OSS 120B (Basic)",
              "provider": "CERT_BASIC"
            },
            "name": "User Intent Identifier"
          },
          "outcomes": {
            "success": "1765868765203"
          },
          "diagram": {
            "x": 5483,
            "y": 9478
          },
          "code": "FIN_AP_LLM_USER_INTENT_IDENTIFIER",
          "convergenceTargetId": "1765868765203",
          "id": "1774847018737",
          "inputs": [
            {
              "id": "1774847018738_1",
              "name": "prompt",
              "type": "string",
              "value": "# System Role\nYou are an expert Named Entity Recognition (NER) and financial data extraction agent. Your sole objective is to analyze a user's message, identify if they are asking to analyze a specific single financing program by name, and map it to a provided list of available programs.\n\n# Inputs\nUser Message:\n{{$context.$system.$inputMessage}}\n\nAvailable Financing Programs:\n{{$context.$nodes.FIN_AP_CODE_CAPTURING_ALL_FINANCING_PROGRAMS.$output.result}}\n(Assume this contains a list of valid program names and their associated categories, e.g., \"internal\" or \"external\")\n\n# Execution Rules\n\n    Analyze Intent: Determine if the user is explicitly naming a single, specific program (e.g., \"Show me the Corporate VCC program\") rather than stating a general goal or asking for a whole category (e.g., \"Show me signed programs\").\n\n    Fuzzy Matching: If a specific name is mentioned, find the closest match in the Available Financing Programs list.\n\n        You MUST account for common abbreviations (e.g., \"VCC\" for \"Virtual Card\", \"DD\" for \"Dynamic Discounting\").\n\n        You MUST account for partial matches (e.g., \"Global Vendor\" matches \"Global Vendor VCC 2024\").\n\n        Ignore case sensitivity and minor punctuation differences.\n\n        Important: treat a phrase as a specific program name when it contains a distinguishing proper-noun modifier around a generic token. For example, \"VCC Financing Program\" is a specific candidate name, while \"VCC\" alone is generic.\n\n    CRITICAL CATEGORY GUARDRAIL (Negative Constraint): Words like \"signed\", \"internal\", \"external\", \"all\", or plural nouns like \"programs\", \"options\", and \"cards\" indicate a request for a filter or category, NOT a specific program name.\n\n        If the user asks for \"signed financing programs\", \"external DD programs\", or \"internal options\", you MUST treat this as a general intent. DO NOT guess or fuzzy-match it to a specific program like \"Signed Dynamic Discounting Program\". Return matchFound: false.\n\n    Ambiguity Guardrail: If the user uses a generic term like \"Dynamic Discounting\" and there are multiple DD programs in the available list, DO NOT guess. Treat it as no specific match found unless their wording clearly points to one distinct item.\n\n    Unrecognized Names (Missing from List): If the user clearly names a specific program (e.g., using proper nouns, capital letters, or phrasing like \"the X program\") but it does NOT map to anything in the Available Financing Programs list, you must flag unrecognizedNameDetected as true, but keep matchFound as false.\n\n    Strict Output: You must return ONLY a raw JSON object. Do not include markdown formatting (like ```json), conversational text, or explanations.\n\n# Output Schema\nYou must strictly adhere to this JSON structure:\n{\n\"matchFound\": boolean, // true if a specific program is identified and matched to the list, false otherwise.\n\"unrecognizedNameDetected\": boolean, // true ONLY if the user explicitly named a program that does NOT exist in the Available list.\n\"financingProgramName\": string | null, // The EXACT name of the program exactly as it appears in the Available list. Null if matchFound is false.\n\"financingProgramCategory\": string | null // \"internal\" or \"external\" based on the matched item in the Available list. Null if matchFound is false.\n}\n\n# Examples\n\nExample 1: Exact Match\nUser Message: \"Can we look at the benefits for Global Vendor VCC 2024?\"\nAvailable Programs: [{\"name\": \"Global Vendor VCC 2024\", \"category\": \"internal\"}, {\"name\": \"Standard DD\", \"category\": \"external\"}]\nOutput:\n{\n\"matchFound\": true,\n\"unrecognizedNameDetected\": false,\n\"financingProgramName\": \"Global Vendor VCC 2024\",\n\"financingProgramCategory\": \"internal\"\n}\n\nExample 2: Generic Goal (No Match)\nUser Message: \"How can I improve my ROI with early payments?\"\nAvailable Programs: [{\"name\": \"Standard VCC\", \"category\": \"internal\"}, {\"name\": \"MegaCorp Dynamic Discounting Program\", \"category\": \"external\"}]\nOutput:\n{\n\"matchFound\": false,\n\"unrecognizedNameDetected\": false,\n\"financingProgramName\": null,\n\"financingProgramCategory\": null\n}\n\nExample 3: Unrecognized Specific Program Name\nUser Message: \"Run the numbers for the Super Fast Cash 3000 program.\"\nAvailable Programs: [{\"name\": \"Standard VCC\", \"category\": \"internal\"}, {\"name\": \"Standard DD\", \"category\": \"external\"}]\nOutput:\n{\n\"matchFound\": false,\n\"unrecognizedNameDetected\": true,\n\"financingProgramName\": null,\n\"financingProgramCategory\": null\n}\n\nExample 4: Category/Origin Request (No Match - Plural/Status Filter)\nUser Message: \"Perform a benefit analysis for Supplier Advanced Network Devices, Business Unit Vision Operations, and Currency USD for signed financing programs\"\nAvailable Programs: [{\"name\": \"Signed Dynamic Discounting Program\", \"category\": \"internal\"}, {\"name\": \"Corporate Virtual Card Program\", \"category\": \"internal\"}]\nOutput:\n{\n\"matchFound\": false,\n\"unrecognizedNameDetected\": false,\n\"financingProgramName\": null,\n\"financingProgramCategory\": null\n}\n\n# Execution\nProcess the Inputs and generate the JSON output now."
            }
          ],
          "outputSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"matchFound\": {\n      \"type\": \"boolean\"\n    },\n    \"unrecognizedNameDetected\": {\n      \"type\": \"boolean\"\n    },\n    \"financingProgramName\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"financingProgramCategory\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ],\n      \"enum\": [\n        \"internal\",\n        \"external\",\n        null\n      ]\n    }\n  },\n  \"required\": [\n    \"matchFound\",\n    \"unrecognizedNameDetected\",\n    \"financingProgramName\",\n    \"financingProgramCategory\"\n  ],\n  \"additionalProperties\": false\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Validate Benefit Table Has Program Data",
            "returnType": "boolean",
            "sourceCode": "var response = $context.$variables.summarizerInput;\nvar output = response && response.output;\n\nif (!Array.isArray(output)) {\n  return true;\n}\n\nvar table = null;\n\nfor (var i = 0; i < output.length; i++) {\n  if (output[i] && output[i].type === \"table\") {\n    table = output[i];\n    break;\n  }\n}\n\nif (!table) {\n  return true;\n}\n\nvar columns = [];\n\nif (Array.isArray(table.columnOrder)) {\n  columns = table.columnOrder;\n} else if (Array.isArray(table.content) && table.content.length > 0 && table.content[0]) {\n  columns = Object.keys(table.content[0]);\n}\n\nif (columns.length === 2\n  && columns.indexOf(\"Supplier\") !== -1\n  && columns.indexOf(\"Total Amount Due\") !== -1) {\n  return false;\n}\n\nreturn true;"
          },
