            "y": 9922
          },
          "code": "FIN_AP_CODE_RETURN_BENEFIT_ANALYSIS_SUCCESS_RESULT",
          "id": "1770985024653",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Return Benefit Analysis Error Result",
            "returnType": "object",
            "sourceCode": "const result = {\n  output: [\n    {\n      type: \"text\",\n      content: [\n        `We were unable to find any installments eligible for benefit analysis for the Business Unit and Currency you requested within the range from the next {{$context.$variables.startDate}} to {{$context.$triggers.REST.$input.endNoOfDays}} days.`\n      ],\n      sequence: 1\n    },\n    {\n      type: \"text\",\n      content: [\n        \"<b>Excluded from results</b> <ul> <li>Invoices not ready or available for payment</li> <li>Non-standard invoice type</li> <li>Intercompany invoices, credit memos, and payment requests</li> <li>Payments to suppliers in these categories: Government, Public Sector, Insurance, Utility Services, Banks, Corporate Card Providers</li> <li>Installments due in less than 7 days</li> <li>Installments already enrolled in a program</li> <li>Installments with an early discount already applied</li> </ul>\"\n      ],\n      sequence: 2\n    }\n  ],\n  payablesBalance: null\n};\n\nreturn result;"
          },
