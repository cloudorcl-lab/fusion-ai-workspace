        {
          "metadata": {
            "name": "Process Payment Instruments",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.FIN_AP_BUSINESS_OBJECT_FUNCTION_GET_PAYMENT_INSTRUMENT_DETAILS.$output\n\n// ensure items is always an array\nconst programs = data.items || [];\n\nconst result = programs.flatMap(program => {\n  const financingProgramId = Number(\n    program.financingProgram.financingProgramId\n  );\n\n  const instruments =\n    program.virtualCardProgramPaymentInstrumentUses?.items || [];\n\n  return instruments.flatMap(use => {\n    const instrument = use.paymentInstrument;\n    const instrumentName = instrument?.paymentInstrumentAlias;\n    const instrumentId = Number(instrument?.id);\n    const currency = instrument?.currency?.currencyCode;\n    const billingCycleDayNumber = instrument?.nextBillingDate;\n    const billingCycleFrequency = instrument?.billingCycleFrequency;\n    const paymentTermsId = instrument?.paymentTerm?.termId;\n\n    const assignments =\n      instrument.paymentInstrumentBusinessUnitAssignments?.items || [];\n\n    // create one record per business unit assignment\n    return assignments.map(assign => {\n      const record = {\n        instrumentName,\n        instrumentId,\n        currency,\n        financingProgramId,\n        businessUnitId: Number(assign.businessUnit?.id)\n      };\n\n      if (\n        billingCycleDayNumber !== undefined &&\n        billingCycleDayNumber !== null\n      ) {\n        record.billingCycleDayNumber = Number(billingCycleDayNumber);\n      }\n\n      if (\n        billingCycleFrequency !== undefined &&\n        billingCycleFrequency !== null &&\n        billingCycleFrequency !== \"\"\n      ) {\n        record.billingCycleFrequency = billingCycleFrequency;\n      }\n\n      if (\n        paymentTermsId !== undefined &&\n        paymentTermsId !== null &&\n        paymentTermsId !== \"\"\n      ) {\n        record.paymentTermsId = Number(paymentTermsId);\n      }\n\n      return record;\n    });\n  });\n});\n\nreturn result;"
          },
          "outcomes": {
            "success": "1784116494257"
          },
          "diagram": {
            "x": 5728.130171428571,
