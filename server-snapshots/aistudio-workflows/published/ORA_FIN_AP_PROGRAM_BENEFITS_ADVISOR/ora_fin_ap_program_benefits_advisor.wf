  "name": "Program Benefits Advisor",
  "description": "The Program Benefits Advisor evaluates financing programs, calculates savings, discounts and payment flexibility, then recommends the best payment option for the user’s goals.",
  "specification": {
    "dataPipeline": {
      "pipelineNodes": [
        {
