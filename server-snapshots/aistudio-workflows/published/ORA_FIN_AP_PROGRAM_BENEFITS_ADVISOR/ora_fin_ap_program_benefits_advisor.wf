          },
          "code": "FIN_AP_IF_CONDITION_VALIDATE_IF_TOP_20_SUPPLIERS_LIST_IS_EMPTY",
          "convergenceTargetId": "end",
          "id": "1770980856462",
          "inputs": [
            {
              "id": "1770980856464_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.FIN_AP_CODE_GET_SUPPLIER_IDS.$output.result == \"\"}}"
            }
