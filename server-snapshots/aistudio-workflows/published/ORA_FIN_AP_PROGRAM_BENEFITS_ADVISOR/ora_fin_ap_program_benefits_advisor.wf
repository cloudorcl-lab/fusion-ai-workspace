          "code": "FIN_AP_CODE_PROCESS_PAYMENT_INSTRUMENTS",
          "convergenceTargetId": "1767630170154",
          "id": "1765866703570",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Process Signed Financing Program",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.FIN_AP_BUSINESS_OBJECT_FUNCTION_GET_SIGNED_FINANCING_PROGRAMS.$output;\n\nconst programs = (data.items || []).map(item => {\n  const obj = {\n    financingProgramId: item.financingProgramId,\n    financingProgramName: item.name,\n    financingProgramType: item.financingOptionTypeCode,\n    financingProgramCode: item.financingProgramCode,\n  };\n\n  // Add APR fields only if present\n  if (item.maximumDiscountRate !== undefined) {\n    obj.maxAPR = item.maximumDiscountRate;\n  }\n\n  if (item.minimumDiscountRate !== undefined) {\n    obj.minAPR = item.minimumDiscountRate;\n  }\n\n  if (item.defaultDiscountRate !== undefined) {\n    obj.defaultAPR = item.defaultDiscountRate;\n  }\n\n  // Add currency code only if present\n  if (item.defaultCurrencyCode !== undefined) {\n    obj.defaultCurrencyCode = item.defaultCurrencyCode;\n  }\n\n  return obj;\n});\n\n// Count the VCC programs\nconst vccCount = programs.filter(program => program.financingProgramType === \"VIRTUAL_CREDIT_CARD\").length;\n\nreturn { programs : programs,vccCount : vccCount};"
          },
          "outcomes": {
            "success": "1784116106423"
          },
          "diagram": {
            "x": 5219,
            "y": 8070.0675199999805
          },
          "code": "FIN_AP_CODE_PROCESS_SIGNED_FINANCING_PROGRAM",
          "convergenceTargetId": "1765864850515",
          "id": "1765866582919",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.01
              },
              "code": "ORA_LLM_MODEL_PROVIDER_CERT_BASIC_LLAMA_3_3_70B",
              "model": "ORA_LLM_MODEL_GPT_OSS_120B",
              "modelName": "GPT OSS 120B (Basic)",
              "provider": "CERT_BASIC"
            },
            "name": "Override Financing Programs"
          },
          "outcomes": {
            "success": "1784116494257"
          },
          "diagram": {
            "x": 5241.5,
            "y": 8363.162377142835
          },
          "code": "FIN_AP_LLM_OVERRIDE_FINANCING_PROGRAMS",
          "convergenceTargetId": "1765864850515",
          "id": "1767950300507",
          "inputs": [
            {
              "id": "1767950300508_1",
              "name": "prompt",
              "type": "string",
              "value": "# Input\nYou will receive:\n\n- User request:\n  {{$context.$system.$inputMessage}}\n\n- Primary financing programs list:\n  {{$context.$nodes.FIN_AP_CODE_PROCESS_SIGNED_FINANCING_PROGRAM.$output.result.programs}}\n\n- Secondary financing programs list (RAG output, may include external programs and enriched duplicates):\n  {{$context.$nodes.FIN_AP_LLM_RAG_OUTPUT_PROCESSING_AGENT.$output}}\n\n- Authoritative override intent identified from the user request:\n  {{$context.$nodes.FIN_AP_LLM_IDENTIFY_OVERRIDE_REQUEST.$output.overrideRequest}}\n\nUse the authoritative override intent above to determine the program type, property, target program scope, and exact value. If it says no supported override was requested, return { \"overrides\": [] }. Do not independently replace its value with a value from any program list, RAG output, default, or example.\n\n--------------------------------------------------\n\n# Supported Properties by Program Type\n\nVIRTUAL_CREDIT_CARD (VC):\n- rebateRate\n- billingDate\n- gracePeriod\n- marketBorrowingInterestRate\n\nDYNAMIC_DISCOUNTING (DD):\n- defaultAPR\n- accelerateByDays\n- paymentDate\n- marketShortTermInvestmentInterestRate\n\nSUPPLY_CHAIN_FINANCING (SCF):\n- extendedPaymentDate\n- marketBorrowingInterestRate\n\n--------------------------------------------------\n\n# Task\n\nIf the user:\n- Requests to change/update/set/modify any supported property, OR\n- Asks a hypothetical question about changing a property\n\nReturn:\n{\n  \"overrides\": [ ... ]\n}\n\nEach object must include:\n- financingProgramType\n- financingProgramName\n- financingProgramCode\n  - If programCategory = \"external\" and no code → use programName\n- ONLY the overridden properties with new values\n\n--------------------------------------------------\n\n# Special Formatting Rules\n\nFor VIRTUAL_CREDIT_CARD (VC):\n\n- marketBorrowingInterestRate → outside instruments\n- rebateRate → inside instruments as a number\n- billingDate → inside instruments as an ISO YYYY-MM-DD string\n\nExample structure:\n{\n  \"marketBorrowingInterestRate\": <value>,\n  \"instruments\": [\n    {\n      \"rebateRate\": <value>,\n      \"billingDate\": <value>\n    }\n  ]\n}\n\n--------------------------------------------------\n\n# Override Detection Rules\n\nTreat as override if user uses:\n\n1. Action verbs:\n- change\n- update\n- set\n- modify\n- increase\n- decrease\n- revise\n- make it\n- adjust\n\n2. Hypothetical phrases:\n- what if\n- if the rate is\n- assume the rate is\n- suppose the rate is\n\n3. Direct value statements:\n- \"with rebate rate 17%\"\n- \"using APR 14%\"\n- \"at interest rate 8%\"\n\nIf a supported property is mentioned with a new value, treat it as override.\n\n--------------------------------------------------\n\n# Interest Rate Mapping Rules\n\nIf user says \"interest rate\":\n\n- VC / VCC / virtual credit card → marketBorrowingInterestRate\n- DD / dynamic discount → marketShortTermInvestmentInterestRate\n- SCF / supply chain financing → marketBorrowingInterestRate\n- No context → apply to ALL program types that support interest rates\n\n--------------------------------------------------\n\n# Processing Logic\n\n1. Identify property\n   Example: \"rebate rate\" → rebateRate\n\n2. Identify program type\n   Based on property or wording\n\n3. Merge program lists\n   Combine primary + secondary\n\n4. Deduplication (CRITICAL)\n   - Same financingProgramCode → same program\n   - Do NOT duplicate overrides\n\n5. Identify external programs\n   Only if:\n   \"programCategory\": \"external\"\n\n6. Apply overrides\n\n- If user specifies program name/code → apply only to that program\n- If multiple programs exist for that type → apply to ALL\n- If property is type-specific → apply to all programs of that type\n\n7. Output rules\n\n- If override detected AND matching programs exist → MUST return overrides\n- If no override detected → return:\n\n  { \"overrides\": [] }\n\n--------------------------------------------------\n\n# Mandatory Semantic Numeric Override Rules\n\n- The user request is authoritative for every explicitly supplied override value.\n- Do not replace a user-supplied value with a default, RAG value, program-list value, calculated value, or value from an example.\n- Treat \"assuming\", \"assume\", \"with\", \"using\", \"at\", \"suppose\", and \"what if\" followed by a supported property and value as an override.\n- Map \"assuming a virtual card rebate rate of N%\" to instruments[0].rebateRate = N for every matching VIRTUAL_CREDIT_CARD program unless a specific program is named.\n- Extract N from the user request itself. For example, 2% means numeric 2 and 0% means numeric 0.\n- Treat 0 and 0.0 as valid numeric override values. Never omit an override because its value is zero, never treat zero as false, and never replace zero with a default.\n- Before returning, verify that every overridden numeric value exactly matches the corresponding value stated in the user request.\n\n--------------------------------------------------\n\n# Mandatory Date Override Rules\n\n- Date-valued overrides are strings, not numbers.\n- For billingDate, paymentDate, and extendedPaymentDate, preserve the complete ISO YYYY-MM-DD value supplied by the authoritative override intent.\n- Never reduce an ISO date to only its day-of-month component. For example, 2026-07-20 MUST remain \"2026-07-20\" and MUST NOT become 20.\n- For VIRTUAL_CREDIT_CARD billingDate, output instruments[0].billingDate as the complete ISO YYYY-MM-DD string.\n- Before returning, verify that every date override exactly matches the complete date in the authoritative override intent.\n\n--------------------------------------------------\n\n# Examples\n\nExample 1 – VC override:\n{\n  \"overrides\": [\n    {\n      \"financingProgramType\": \"VIRTUAL_CREDIT_CARD\",\n      \"financingProgramName\": \"Corp VCC\",\n      \"financingProgramCode\": \"VC100\",\n      \"marketBorrowingInterestRate\": 11,\n      \"instruments\": [\n        {\n          \"rebateRate\": 15,\n          \"billingDate\": \"2026-07-20\"\n        }\n      ]\n    }\n  ]\n}\n\nExample 2 – Dynamic Discount APR:\n{\n  \"overrides\": [\n    {\n      \"financingProgramType\": \"DYNAMIC_DISCOUNTING\",\n      \"financingProgramName\": \"Standard Dynamic Discounting\",\n      \"financingProgramCode\": \"DD_FINANCING_PROGRAM\",\n      \"defaultAPR\": 6\n    }\n  ]\n}\n\nExample 3 – Interest rate applied to all VC programs:\n{\n  \"overrides\": [\n    {\n      \"financingProgramType\": \"VIRTUAL_CREDIT_CARD\",\n      \"financingProgramName\": \"Internal VCC Program\",\n      \"financingProgramCode\": \"VC100\",\n      \"marketBorrowingInterestRate\": 8\n    },\n    {\n      \"financingProgramType\": \"VIRTUAL_CREDIT_CARD\",\n      \"financingProgramName\": \"External Partner VCC\",\n      \"financingProgramCode\": \"EXT_VC_200\",\n      \"marketBorrowingInterestRate\": 8\n    }\n  ]\n}\n\nExample 4 – Semantic VC rebate override, including zero:\n\nUser request:\n\"Calculate potential benefits assuming a virtual card rebate rate of 0%.\"\n\nRequired override fragment:\n{\n  \"instruments\": [\n    {\n      \"rebateRate\": 0\n    }\n  ]\n}\n\nReturn only raw, valid JSON. Do not use Markdown fences. Do not include analysis, explanations, comments, or text before or after the JSON."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"overrides\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"financingProgramType\": {\n            \"type\": \"string\"\n          },\n          \"financingProgramName\": {\n            \"type\": \"string\"\n          },\n          \"financingProgramCode\": {\n            \"type\": \"string\"\n          },\n          \"marketBorrowingInterestRate\": {\n            \"type\": \"number\"\n          },\n          \"instruments\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"rebateRate\": {\n                  \"type\": \"number\"\n                },\n                \"billingDate\": {\n                  \"type\": \"string\"\n                },\n                \"gracePeriod\": {\n                  \"type\": \"number\"\n                }\n              },\n              \"additionalProperties\": false\n            }\n          }\n        },\n        \"required\": [\n          \"financingProgramType\",\n          \"financingProgramName\",\n          \"financingProgramCode\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"overrides\"\n  ],\n  \"additionalProperties\": false\n}",
          "type": "LLM"
        },
        {
