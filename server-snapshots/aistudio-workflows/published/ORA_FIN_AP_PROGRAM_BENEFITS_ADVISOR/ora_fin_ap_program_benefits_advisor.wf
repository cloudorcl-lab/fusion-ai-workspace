        },
        {
          "metadata": {
            "name": "Return Benefit Analysis Success Result",
            "returnType": "object",
            "sourceCode": "// Get input data and currency code\nvar input =  $context.$nodes.FIN_AP_CODE_REMOVE_SCF_PROGRAMS.$output.result.filteredBenefits || [];\nif (Array.isArray(input)) {\n  input.forEach(item => {\n    if (Array.isArray(item.roiResults)) {\n      item.roiResults.forEach(roi => {\n        if (roi.extendedDays !== undefined && roi.extendedDays !== null) {\n          roi.extendedDays = Math.round(roi.extendedDays);\n        }\n        if (roi.acceleratedDays !== undefined && roi.acceleratedDays !== null) {\n          roi.acceleratedDays = Math.abs(Math.round(Number(roi.acceleratedDays)));\n        }\n      });\n    }\n  });\n}\nvar currencyCode = $context.$triggers.REST.$input.currencyCode || \"USD\";\nvar vccCount = $context.$nodes.FIN_AP_CODE_PROCESS_SIGNED_FINANCING_PROGRAM.$output.result.vccCount;\n\n// Amount fields for DD and VCC needing currency formatting (by pretty label)\nvar ddAmountLabels = [\"Discounts\", \"Interest Lost\", \"Total Benefit\"];\nvar vccAmountLabels = [\"Rebate\", \"Working Capital\", \"Total Benefit\"];\n\n// Field definitions and display labels for DD and VCC\nvar ddFields = [\"programName\", \"acceleratedDays\", \"discounts\", \"interestLost\", \"totalBenefit\"];\nvar ddLabels = {\n    \"programName\": \"Program\",\n    \"acceleratedDays\": \"Accelerated Days\",\n    \"discounts\": \"Discounts\",\n    \"interestLost\": \"Interest Lost\",\n    \"totalBenefit\": \"Total Benefit\"\n};\n\nvar vccFields = [\"programName\", \"instrumentName\", \"extendedDays\", \"rebate\", \"workingCapital\", \"totalBenefit\"];\nvar vccLabels = {\n    \"programName\": \"Program\",\n    \"instrumentName\": \"Instrument\",\n    \"extendedDays\": \"Extended Days\",\n    \"rebate\": \"Rebate\",\n    \"workingCapital\": \"Working Capital Benefit\",\n    \"totalBenefit\": \"Total Benefit\"\n};\n\n// Scan max DD/VCC variants (Internal, External, What-Ifs)\nvar maxDDInternal = 0, maxDDExternal = 0, maxDDWhatIfs = 0;\nvar maxVCCInternal = 0, maxVCCExternal = 0, maxVCCWhatIfs = 0;\n\ninput.forEach(function(supplier) {\n    // DD Scanning\n    var ddRois = (supplier.roiResults || []).filter(x => x.programType === \"DYNAMIC_DISCOUNTING\");\n    var ddInternal = ddRois.filter(roi => roi.programCategory === \"internal\" || !roi.programCategory);\n    var ddExternal = ddRois.filter(roi => roi.programCategory === \"external\");\n    var ddWhatIfs = ddRois.filter(roi => roi.programCategory === \"what-if\");\n\n    if (ddInternal.length > maxDDInternal) maxDDInternal = ddInternal.length;\n    if (ddExternal.length > maxDDExternal) maxDDExternal = ddExternal.length;\n    if (ddWhatIfs.length > maxDDWhatIfs) maxDDWhatIfs = ddWhatIfs.length;\n\n    // VCC Scanning\n    var vccRois = (supplier.roiResults || []).filter(x => x.programType === \"VIRTUAL_CREDIT_CARD\");\n    var vccInternal = vccRois.filter(roi => roi.programCategory === \"internal\" || !roi.programCategory);\n    var vccExternal = vccRois.filter(roi => roi.programCategory === \"external\");\n    var vccWhatIfs = vccRois.filter(roi => roi.programCategory === \"what-if\");\n\n    if (vccInternal.length > maxVCCInternal) maxVCCInternal = vccInternal.length;\n    if (vccExternal.length > maxVCCExternal) maxVCCExternal = vccExternal.length;\n    if (vccWhatIfs.length > maxVCCWhatIfs) maxVCCWhatIfs = vccWhatIfs.length;\n});\n\nvar hasMoreThanOneRealVCC = maxVCCInternal > 1;\nvar columnOrder = $context.$nodes.FIN_AP_LLM_SUPPLIER_PROGRAM_BENEFIT_TABLE_GENERATOR.$output.columnOrder || [];\nvar content = [];\n\nconst hasAcceleratedDaysColumn = columnOrder.some(col => col.toLowerCase().includes(\"accelerated days\"));\n\n// Helper function to map ONLY the best data to a row\nfunction mapBestDataToRow(rowObj, dataArray, prefix, fields, labelsMap, amountLabels) {\n    if (dataArray.length > 0) {\n        var roi = dataArray[0]; // ONLY take the best one\n        fields.forEach(function(fld) {\n            var label = prefix + labelsMap[fld];\n            if (columnOrder.indexOf(label) !== -1) {\n                if (amountLabels.indexOf(labelsMap[fld]) >= 0 && roi && roi[fld] !== undefined && roi[fld] !== \"\") {\n                    rowObj[label] = Number(roi[fld]).toFixed(2) + \" \" + currencyCode;\n                } else {\n                    rowObj[label] = (roi && fld && roi[fld] !== undefined) ? String(roi[fld]) : \"\";\n                }\n            }\n        });\n    }\n}\n\n// Build table rows\ninput.forEach(function(supplier) {\n    var row = {};\n    row[\"Supplier\"] = supplier.supplierName;\n\n    var totalAmtLabel = \"Total Amount Due\";\n    if (columnOrder.indexOf(totalAmtLabel) !== -1) {\n        var amt = Number(supplier.amount);\n        row[totalAmtLabel] = Number(amt).toFixed(2) + \" \" + currencyCode;\n    }\n\n    // --------- DD ---------\n    var ddRois = (supplier.roiResults || []).filter(x => x.programType === \"DYNAMIC_DISCOUNTING\");\n\n    // Filter and SORT descending by What-If totalBenefit (if present), else base totalBenefit\n    var ddWhatIfs = ddRois.filter(roi => roi.programCategory === \"what-if\");\n    var ddInternal = ddRois.filter(roi => roi.programCategory === \"internal\" || !roi.programCategory)\n        .sort((a, b) => {\n            let aWhatIf = ddWhatIfs.find(w => String(w.programName).replace(/^what-if\\s*::\\s*/i, \"\").trim() === String(a.programName).trim());\n            let bWhatIf = ddWhatIfs.find(w => String(w.programName).replace(/^what-if\\s*::\\s*/i, \"\").trim() === String(b.programName).trim());\n            let aScore = aWhatIf ? Number(aWhatIf.totalBenefit) : Number(a.totalBenefit);\n            let bScore = bWhatIf ? Number(bWhatIf.totalBenefit) : Number(b.totalBenefit);\n            aScore = Number(aScore) || 0;\n            bScore = Number(bScore) || 0;\n\n            if (bScore !== aScore) {\n                return bScore - aScore;\n            }\n\n            let aName = String(a.programName || \"\").replace(/^what-if\\s*::\\s*/i, \"\").trim().toLowerCase();\n            let bName = String(b.programName || \"\").replace(/^what-if\\s*::\\s*/i, \"\").trim().toLowerCase();\n\n            return aName.localeCompare(bName);\n        });\n\n    var ddExternal = ddRois.filter(roi => roi.programCategory === \"external\")\n        .sort((a, b) => {\n            let aWhatIf = ddWhatIfs.find(w => String(w.programName).replace(/^what-if\\s*::\\s*/i, \"\").trim() === String(a.programName).trim());\n            let bWhatIf = ddWhatIfs.find(w => String(w.programName).replace(/^what-if\\s*::\\s*/i, \"\").trim() === String(b.programName).trim());\n            let aScore = aWhatIf ? Number(aWhatIf.totalBenefit) : Number(a.totalBenefit);\n            let bScore = bWhatIf ? Number(bWhatIf.totalBenefit) : Number(b.totalBenefit);\n            aScore = Number(aScore) || 0;\n            bScore = Number(bScore) || 0;\n\n            if (bScore !== aScore) {\n                return bScore - aScore;\n            }\n\n            let aName = String(a.programName || \"\").replace(/^what-if\\s*::\\s*/i, \"\").trim().toLowerCase();\n            let bName = String(b.programName || \"\").replace(/^what-if\\s*::\\s*/i, \"\").trim().toLowerCase();\n\n            return aName.localeCompare(bName);\n        });\n\n    // Match what-if rows to the selected base program names\n    var ddInternalWhatIfs = [];\n    var ddExternalWhatIfs = [];\n\n    if (ddInternal.length > 0) {\n        var ddInternalBaseName = String(ddInternal[0].programName || \"\").replace(/^what-if\\s*::\\s*/i, \"\").trim();\n        for (var di = 0; di < ddWhatIfs.length; di++) {\n            var ddi = ddWhatIfs[di];\n            var ddiName = String(ddi.programName || \"\").replace(/^what-if\\s*::\\s*/i, \"\").trim();\n            if (ddiName === ddInternalBaseName) {\n                ddInternalWhatIfs.push(ddi);\n            }\n        }\n    }\n\n    if (ddExternal.length > 0) {\n        var ddExternalBaseName = String(ddExternal[0].programName || \"\").replace(/^what-if\\s*::\\s*/i, \"\").trim();\n        for (var de = 0; de < ddWhatIfs.length; de++) {\n            var dde = ddWhatIfs[de];\n            var ddeName = String(dde.programName || \"\").replace(/^what-if\\s*::\\s*/i, \"\").trim();\n            if (ddeName === ddExternalBaseName) {\n                ddExternalWhatIfs.push(dde);\n            }\n        }\n    }\n\n    // Map the BEST DD Internal & BEST External\n    mapBestDataToRow(row, ddInternal, \"DD: \", ddFields, ddLabels, ddAmountLabels);\n    mapBestDataToRow(row, ddExternal, \"External DD: \", ddFields, ddLabels, ddAmountLabels);\n\n    // Map DD What-Ifs to the correct internal/external columns\n    for (var dwi = 0; dwi < ddInternalWhatIfs.length; dwi++) {\n        var roi = ddInternalWhatIfs[dwi];\n        ddFields.forEach(function(fld) {\n            var labelMatch = columnOrder.find(col => col.includes(\"DD What-If\") && !col.includes(\"External DD\") && col.endsWith(ddLabels[fld]));\n            if (labelMatch && roi && roi[fld] !== undefined && roi[fld] !== \"\") {\n                if (ddAmountLabels.indexOf(ddLabels[fld]) >= 0) {\n                    row[labelMatch] = Number(roi[fld]).toFixed(2) + \" \" + currencyCode;\n                } else {\n                    row[labelMatch] = String(roi[fld]);\n                }\n            }\n        });\n    }\n\n    for (var dwe = 0; dwe < ddExternalWhatIfs.length; dwe++) {\n        var roi = ddExternalWhatIfs[dwe];\n        ddFields.forEach(function(fld) {\n            var labelMatch = columnOrder.find(col => col.includes(\"External DD What-If\") && col.endsWith(ddLabels[fld]));\n            if (labelMatch && roi && roi[fld] !== undefined && roi[fld] !== \"\") {\n                if (ddAmountLabels.indexOf(ddLabels[fld]) >= 0) {\n                    row[labelMatch] = Number(roi[fld]).toFixed(2) + \" \" + currencyCode;\n                } else {\n                    row[labelMatch] = String(roi[fld]);\n                }\n            }\n        });\n    }\n\n    // --------- VCC ---------\n    var vccRois = (supplier.roiResults || []).filter(x => x.programType === \"VIRTUAL_CREDIT_CARD\");\n\n    // Filter and SORT descending by What-If totalBenefit (if present), else base totalBenefit\n    var vccWhatIfs = vccRois.filter(roi => roi.programCategory === \"what-if\");\n    var vccInternal = vccRois.filter(roi => roi.programCategory === \"internal\" || !roi.programCategory)\n        .sort((a, b) => {\n            let aWhatIf = vccWhatIfs.find(w => String(w.programName).replace(/^what-if\\s*::\\s*/i, \"\").trim() === String(a.programName).trim());\n            let bWhatIf = vccWhatIfs.find(w => String(w.programName).replace(/^what-if\\s*::\\s*/i, \"\").trim() === String(b.programName).trim());\n            let aScore = aWhatIf ? Number(aWhatIf.totalBenefit) : Number(a.totalBenefit);\n            let bScore = bWhatIf ? Number(bWhatIf.totalBenefit) : Number(b.totalBenefit);\n            aScore = Number(aScore) || 0;\n            bScore = Number(bScore) || 0;\n\n            if (bScore !== aScore) {\n                return bScore - aScore;\n            }\n\n            let aName = String(a.programName || \"\").replace(/^what-if\\s*::\\s*/i, \"\").trim().toLowerCase();\n            let bName = String(b.programName || \"\").replace(/^what-if\\s*::\\s*/i, \"\").trim().toLowerCase();\n\n            return aName.localeCompare(bName);\n        });\n\n    var vccExternal = vccRois.filter(roi => roi.programCategory === \"external\")\n        .sort((a, b) => {\n            let aWhatIf = vccWhatIfs.find(w => String(w.programName).replace(/^what-if\\s*::\\s*/i, \"\").trim() === String(a.programName).trim());\n            let bWhatIf = vccWhatIfs.find(w => String(w.programName).replace(/^what-if\\s*::\\s*/i, \"\").trim() === String(b.programName).trim());\n            let aScore = aWhatIf ? Number(aWhatIf.totalBenefit) : Number(a.totalBenefit);\n            let bScore = bWhatIf ? Number(bWhatIf.totalBenefit) : Number(b.totalBenefit);\n            aScore = Number(aScore) || 0;\n            bScore = Number(bScore) || 0;\n\n            if (bScore !== aScore) {\n                return bScore - aScore;\n            }\n\n            let aName = String(a.programName || \"\").replace(/^what-if\\s*::\\s*/i, \"\").trim().toLowerCase();\n            let bName = String(b.programName || \"\").replace(/^what-if\\s*::\\s*/i, \"\").trim().toLowerCase();\n\n            return aName.localeCompare(bName);\n        });\n\n    // Match what-if rows to the selected base program names\n    var vccInternalWhatIfs = [];\n    var vccExternalWhatIfs = [];\n\n    if (vccInternal.length > 0) {\n        var vccInternalBaseName = String(vccInternal[0].programName || \"\").replace(/^what-if\\s*::\\s*/i, \"\").trim();\n        for (var vi = 0; vi < vccWhatIfs.length; vi++) {\n            var vwi = vccWhatIfs[vi];\n            var vwiName = String(vwi.programName || \"\").replace(/^what-if\\s*::\\s*/i, \"\").trim();\n            if (vwiName === vccInternalBaseName) {\n                vccInternalWhatIfs.push(vwi);\n            }\n        }\n    }\n\n    if (vccExternal.length > 0) {\n        var vccExternalBaseName = String(vccExternal[0].programName || \"\").replace(/^what-if\\s*::\\s*/i, \"\").trim();\n        for (var ve = 0; ve < vccWhatIfs.length; ve++) {\n            var vwe = vccWhatIfs[ve];\n            var vweName = String(vwe.programName || \"\").replace(/^what-if\\s*::\\s*/i, \"\").trim();\n            if (vweName === vccExternalBaseName) {\n                vccExternalWhatIfs.push(vwe);\n            }\n        }\n    }\n\n    // Map the BEST VCC Internal & BEST External\n    mapBestDataToRow(row, vccInternal, \"VCC: \", vccFields, vccLabels, vccAmountLabels);\n    mapBestDataToRow(row, vccExternal, \"External VCC: \", vccFields, vccLabels, vccAmountLabels);\n\n    // Map VCC What-Ifs to the correct internal/external columns\n    for (var vwi1 = 0; vwi1 < vccInternalWhatIfs.length; vwi1++) {\n        var roi = vccInternalWhatIfs[vwi1];\n        var selectedVccFields = [\"programName\", \"instrumentName\", \"extendedDays\", \"rebate\", \"workingCapital\", \"totalBenefit\"];\n        selectedVccFields.forEach(function(fld) {\n            var labelMatch = columnOrder.find(col => col.includes(\"VCC What-If\") && !col.includes(\"External VCC\") && col.endsWith(vccLabels[fld]));\n            if (labelMatch && roi && roi[fld] !== undefined && roi[fld] !== \"\") {\n                if (vccAmountLabels.indexOf(vccLabels[fld]) >= 0) {\n                    row[labelMatch] = Number(roi[fld]).toFixed(2) + \" \" + currencyCode;\n                } else {\n                    row[labelMatch] = String(roi[fld]);\n                }\n            }\n        });\n    }\n\n    for (var vwi2 = 0; vwi2 < vccExternalWhatIfs.length; vwi2++) {\n        var roi = vccExternalWhatIfs[vwi2];\n        var selectedVccFields = [\"programName\", \"instrumentName\", \"extendedDays\", \"rebate\", \"workingCapital\", \"totalBenefit\"];\n        selectedVccFields.forEach(function(fld) {\n            var labelMatch = columnOrder.find(col => col.includes(\"External VCC What-If\") && col.endsWith(vccLabels[fld]));\n            if (labelMatch && roi && roi[fld] !== undefined && roi[fld] !== \"\") {\n                if (vccAmountLabels.indexOf(vccLabels[fld]) >= 0) {\n                    row[labelMatch] = Number(roi[fld]).toFixed(2) + \" \" + currencyCode;\n                } else {\n                    row[labelMatch] = String(roi[fld]);\n                }\n            }\n        });\n    }\n\n    content.push(row);\n});\n\n// Output result table format\nvar result = {\n    type: \"table\",\n    heading: \"\",\n    content: content,\n    sequence: 2,\n    columnOrder: columnOrder\n};\n\n// Adjust Sequence 3 text and apply table\nlet arr = $context.$nodes.FIN_AP_LLM_SUPPLIER_PROGRAM_BENEFIT_TABLE_GENERATOR.$output.content || [];\narr = Array.isArray(arr) ? arr.filter(Boolean) : [];\n\n// Collapsing text messages to all suppliers\nfor (let i = 0; i < arr.length; i++) {\n    const item = arr[i];\n    if (!item) continue;\n\n    if (item.sequence === 3 && item.type === \"text\" && Array.isArray(item.content)) {\n        let normalizedContent = [];\n        let genericMessageAdded = false;\n\n        for (let j = 0; j < item.content.length; j++) {\n            let originalText = String(item.content[j] || \"\");\n            let plainText = originalText.replace(/<[^>]*>/g, \" \").replace(/\\s+/g, \" \").trim();\n            let lowerText = plainText.toLowerCase();\n\n            let startMarker = \"the considered financing programs included \";\n            let endMarker = \". among these\";\n\n            let startIndex = lowerText.indexOf(startMarker);\n            let endIndex = lowerText.indexOf(endMarker);\n\n            if (startIndex >= 0 && endIndex > startIndex) {\n                let programText = plainText.substring(startIndex + startMarker.length, endIndex).trim();\n                let genericConsideredMessage = \"The considered financing programs included \" + programText + \". The highest-benefit program for each supplier is shown in the table.\";\n\n                if (!genericMessageAdded) {\n                    normalizedContent.push(genericConsideredMessage);\n                    genericMessageAdded = true;\n                }\n            } else if (plainText !== \"\") {\n                normalizedContent.push(originalText);\n            }\n        }\n\n        item.content = normalizedContent;\n    }\n}\n\nfor (let i = 0; i < arr.length; i++) {\n    const item = arr[i];\n    if (!item) continue;\n\n    if (item.sequence === 3 && item.type === \"text\" && !hasMoreThanOneRealVCC && Array.isArray(item.content)) {\n        item.content = item.content.filter(\n            c => !(typeof c === \"string\" && c.toLowerCase().includes(\"there are no vcc programs available\"))\n        );\n    }\n\n    if (item.sequence === 3 && item.type === \"text\" && vccCount > 1 && Array.isArray(item.content)) {\n        const vccExistsInColumnOrder = columnOrder.some(col => col.toLowerCase().includes(\"vcc\"));\n        if (vccExistsInColumnOrder) {\n            item.content.push(\"Additional VCC program options are available for some suppliers but are not shown in the table above.\");\n        }\n    }\n\n    if (item.type === \"table\") {\n        arr[i] = result;\n    }\n}\n\n// Remove any prior hardcoded footer blocks before appending fresh ones.\narr = arr.filter(item => {\n    if (!item) return false;\n\n    if (\n        item.type === \"text\" &&\n        Array.isArray(item.content) &&\n        item.content.some(c => typeof c === \"string\" && c.includes(\"Excluded from results\"))\n    ) {\n        return false;\n    }\n\n    if (\n        item.type === \"actions\" &&\n        Array.isArray(item.content) &&\n        item.content.some(c => typeof c === \"string\" && c.includes(\"Create a draft DD offer\"))\n    ) {\n        return false;\n    }\n\n    return true;\n});\n\n// Hardcoded appends\n// Append footer blocks only when a benefit table was actually produced.\nconst hasEligibleBenefitRows = Array.isArray(input) && input.length > 0;\nconst hasGeneratedColumns = Array.isArray(columnOrder) && columnOrder.length > 0;\nconst hasBenefitTable = hasEligibleBenefitRows && hasGeneratedColumns;\n\nif (hasBenefitTable) {\n    arr.push({\n        type: \"text\",\n        content: [\n            \"<b>Excluded from results</b> <ul> <li>Invoices not ready or available for payment</li> <li>Non-standard invoice type</li><li>Intercompany invoices, credit memos, and payment requests</li> <li>Payments to suppliers in these categories: Government, Public Sector, Insurance, Utility Services, Banks, Corporate Card Providers</li> <li>Installments due in less than 7 days</li> <li>Installments already enrolled in a program</li> <li>Installments with an early discount already applied</li> </ul>\"\n        ],\n        sequence: arr.length + 1\n    });\n\n    const actions = [\n        \"Visualize your new cash flow to better understand liquidity impact.\",\n        \"Create a draft DD offer for these suppliers.\"\n    ];\n\n    arr.push({\n        type: \"actions\",\n        content: actions,\n        sequence: arr.length + 1\n    });\n}\n\nconst acceleratedDaysNote =\n  \"Accelerated Days are calculated using weekly buckets and bucket midpoints, not individual invoice-level days.\";\n\narr.forEach(item => {\n  if (item && Array.isArray(item.content)) {\n    item.content = item.content.filter(\n      c => !(typeof c === \"string\" && c.includes(acceleratedDaysNote))\n    );\n  }\n});\n\nif (hasAcceleratedDaysColumn) {\n  const noteBlock = {\n    type: \"text\",\n    content: [`<b>Note:</b> ${acceleratedDaysNote}`],\n    sequence: 4\n  };\n\n  const excludedIndex = arr.findIndex(item =>\n    item &&\n    item.type === \"text\" &&\n    Array.isArray(item.content) &&\n    item.content.some(c => typeof c === \"string\" && c.includes(\"Excluded from results\"))\n  );\n\n  if (excludedIndex >= 0) {\n    arr.splice(excludedIndex, 0, noteBlock);\n  } else {\n    arr.push(noteBlock);\n  }\n}\n\n// Filter empty tables and apply final table result\narr = arr.filter(item => {\n    if (!item) return false;\n\n    if (item.type === \"table\") {\n        if (!Array.isArray(item.content) || item.content.length === 0) {\n            return false;\n        } else {\n            Object.assign(item, result);\n        }\n    }\n\n    return true;\n});\n\n// Re-sequence final output after all insertions/removals\narr.forEach((item, index) => {\n    if (item) {\n        item.sequence = index + 1;\n    }\n});\n\n// Final Output\nlet finalResult = {\n    \"output\": arr,\n    \"payablesBalance\": $context.$variables.payablesBalance,\n    \"filteredBenefits\": $context.$nodes.FIN_AP_CODE_REMOVE_SCF_PROGRAMS.$output.result.filteredBenefits\n};\n\nreturn finalResult;"
          },
