        {
          "metadata": {
            "name": "Merged Negotiations Lists",
            "returnType": "object",
            "sourceCode": "const sources = [\n   $context.$nodes.SIMPLIFY_CLOSED_DATA.$output.result,\n   $context.$nodes.SIMPLIFY_AWARD_APPROVAL_DATA.$output.result,\n   $context.$nodes.SIMPLIFY_AWARD_IN_PROGRESS_DATA.$output.result,\n   $context.$nodes.SIMPLIFY_NOT_AWARD_DATA.$output.result,\n   $context.$nodes.SIMPLIFY_AWARD_BY_DATE_DATA.$output.result\n];\n\nconst result = sources.reduce((acc, sourceObj) => {\n    \n    const currentList = sourceObj.NegotiationsList || [];\n\n    currentList.forEach(item => {\n        if (item.AuctionHeaderId && !acc.seenIds.has(item.AuctionHeaderId)) {\n            acc.seenIds.add(item.AuctionHeaderId);\n            acc.mergedList.push(item);\n        }\n    });\n\n    return acc;\n\n}, { seenIds: new Set(), mergedList: [] });\n\nlet obj = {\n    NegotiationsList: result.mergedList,\n    NegotiationsCount: result.mergedList.length\n};\nreturn obj ;"
