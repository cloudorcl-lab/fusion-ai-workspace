            "name": "Simplify Not Award Data",
            "returnType": "object",
            "sourceCode": "const rawList =  $context.$nodes.GET_NOT_AWARD_APPROVED.$output.items &&  $context.$nodes.GET_NOT_AWARD_APPROVED.$output.items ?  $context.$nodes.GET_NOT_AWARD_APPROVED.$output.items : ( $context.$nodes.GET_NOT_AWARD_APPROVED.$output.items || []);\n\nconst result = rawList.reduce((acc, item) => {\n\n    const created = new Date(item.AwardApprovalSubmitDate);\n    const now = new Date(item.CurrentDateTime);\n    const diffInMs = now - created;\n    const diffInDays = (diffInMs / (1000 * 60 * 60 * 24)).toFixed(3);\n    \n    if (!acc.seenIds.has(item.AuctionHeaderId)) { \n        acc.seenIds.add(item.AuctionHeaderId);\n\n   \n\n        acc.uniqueList.push({\n             AuctionHeaderId: item.AuctionHeaderId,\n             NegotiationStatus: item.NegotiationStatusCode,\n             BadgeText: item.NegotiationStatus,\n             DifferenceInDays: diffInDays,\n             ProcurementBU: item.ProcurementBU,\n             TimeRemaining: item.TimeRemaining,\n             NegotiationTitle: item.NegotiationType + ' '+ item.Negotiation+ ' - '+ (item.NegotiationTitle || \" \"),\n             BuyerName: item.Buyer || \" \"\n        });\n    }\n\n    return acc;\n\n}, { seenIds: new Set(), uniqueList: [] }); \n\nlet obj= {\n    NegotiationsList: result.uniqueList,\n    NegotiationsCount: result.uniqueList.length\n\n  };\n\n \n  return obj;"
          },
          "outcomes": {
            "success": "1771259602921"
          },
          "code": "SIMPLIFY_NOT_AWARD_DATA",
