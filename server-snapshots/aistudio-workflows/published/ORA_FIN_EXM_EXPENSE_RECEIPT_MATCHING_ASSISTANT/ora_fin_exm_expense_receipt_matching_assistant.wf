        },
        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_EXPENSES_GETAGENTINITPARAMS",
            "errorNodeId": "1770155084056",
            "functionName": "getAgentInitParams",
            "name": "Get Agent Initial Parameters"
          },
          "outcomes": {
            "success": "1770155084056"
          },
          "code": "GET_AGENT_INIT_PARAMS",
          "convergenceTargetId": "1769794963640",
          "id": "1770154986953",
          "inputs": [
            {
              "id": "1770155007432_1",
              "name": "agentName",
              "type": "string",
              "value": "{{$context.$workflow.$name}}"
            }
