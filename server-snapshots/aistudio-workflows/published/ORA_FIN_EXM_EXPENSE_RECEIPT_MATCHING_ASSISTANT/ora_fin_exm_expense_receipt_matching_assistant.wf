{
  "workflowId": "300000325175907",
  "workflowCode": "ORA_FIN_EXM_EXPENSE_RECEIPT_MATCHING_ASSISTANT",
  "name": "Expense Receipt Matching Assistant",
  "description": "Receives employee receipts via email, accurately matches them to the correct expense, enriches the expense with receipt data, and provides reasoning for successful or unsuccessful matches or expense creation.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
