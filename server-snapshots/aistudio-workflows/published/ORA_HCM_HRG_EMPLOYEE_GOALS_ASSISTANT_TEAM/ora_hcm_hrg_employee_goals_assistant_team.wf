            "name": "Set User Input Message",
            "returnType": "string",
            "sourceCode": "$context.$variables.pUserQuery = \" Earlier User Chat History Context:  \" + $context.$system.$chatHistory + \"  :  Latest User Input Query:  \" +  $context.$system.$inputMessage \n\nif( $context.$nodes.GET_USER_INPUT_CONTEXT_PARAMS.$output.result  && $context.$nodes.GET_USER_INPUT_CONTEXT_PARAMS.$output.result.PersonId){\n    $context.$variables.pUserQuery =  $context.$variables.pUserQuery + \" Using this input parameters JSON object:  \" +   JSON.stringify($context.$nodes.GET_USER_INPUT_CONTEXT_PARAMS.$output.result);\n}\n\nreturn $context.$variables.pUserQuery;"
          },
          "outcomes": {
            "success": "1767441084796"
          },
          "code": "SET_USER_INPUT_MESSAGE",
          "id": "1767446443288",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
