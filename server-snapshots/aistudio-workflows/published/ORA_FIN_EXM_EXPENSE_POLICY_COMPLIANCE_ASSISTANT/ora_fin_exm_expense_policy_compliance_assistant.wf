            "returnType": "boolean",
            "sourceCode": "const expenseTypeId =\n  $context.$nodes.GETEXPENSEDETAILS?.$output?.expenseType?.id;\n\n// const expenseTypeId = \"300100639648742\";\n\nconst mappings =\n  $context.$nodes.GET_SIMPLIFIED_EXPENSE_TYPE_MAP?.$output;\n\nconst mappingItems =\n  mappings?.items ||\n  mappings?.response?.items ||\n  [];\n\nconst result =\n  Array.isArray(mappingItems) &&\n  mappingItems.some(\n    item => String(item?.description || \"\").trim() === String(expenseTypeId || \"\").trim()\n  );\n\nreturn result;"
          },
