            "errorNodeId": "1775134455269",
            "name": "Set user message",
            "returnType": "string",
            "sourceCode": "let userMessage=$context.$triggers.REST.$input.userMessage;\nlet inputMessage=$context.$system.$inputMessage;\n\nif( $context.$triggers.REST.$input.channel==\"Email\" || $context.$triggers.REST.$input.channel==\"EMAIL\"  || $context.$triggers.REST.$input.userMessage!=\"\" ){\nreturn userMessage; \n}\nreturn inputMessage;"
          },
          "outcomes": {
            "success": "1770979076475"
          },
