            "name": "Check Expense Status",
            "returnType": "string",
            "sourceCode": "const expenseData = $context.$nodes.GETEXPENSEDETAILS.$output ;\n\nif (\n  expenseData?.expenseReport?.id != null &&\n  ![\"SAVED\", \"WITHDRAWN\", \"RETURNED\", \"IND_REJECTED\", \"MGR_REJECTED\"].includes(\n    expenseData.expenseReport.expenseStatusCode\n  )\n) {\n  return \"EXPENSE_SUBMITTED\";\n}\n\nreturn \"EXPENSE_NOT_SUBMITTED\";"
          },
          "outcomes": {
            "success": "1773061668671"
          },
          "code": "CHECK_EXPENSE_STATUS",
          "id": "1772508875020",
