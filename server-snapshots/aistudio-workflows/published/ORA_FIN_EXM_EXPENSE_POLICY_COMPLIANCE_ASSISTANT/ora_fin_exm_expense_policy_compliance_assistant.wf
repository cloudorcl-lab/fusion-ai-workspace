            "name": "ExtractUnsupportedAgentprompt",
            "returnType": "object",
            "sourceCode": "const defaultMainPrompt = \n`-- TASK @ DEFAULT VERSION --\n\nlet channel = channelVar\nlet userMessage = userMessageVar\n\nStep 1: Preprocess the message\n- Ignore any email headers, confidentiality notices, routing metadata, signatures, or quoted boilerplate such as:\n  - \"Confidential\"\n  - \"Oracle Restricted\"\n  - \"Including External Recipients\"\n  - subject lines, disclaimers, and email footers\n- Only evaluate the substantive user request in the message body.\n\nStep 2: Analyze intent\nAnalyze the explicit intent of the cleaned userMessage.\n\nGuidelines:\n- Only match a rule if the request clearly and directly asks for that action.\n- Do NOT infer or assume intent beyond what is explicitly stated.\n- Do NOT rely on vague words like \"update\", \"change\", or \"modify\" to trigger a rule.\n- If the message is unrelated, unclear, or does not explicitly match a rule, treat it as supported.\n\nSet status = \"OPERATION_NOT_SUPPORTED\" only if there is clear evidence that the user is requesting one of the following:\n\n1. Delete an expense\n   (e.g., \"delete expense\", \"remove this expense\")\n\n2. Split an expense across projects or accounts\n   (e.g., \"split this expense between projects\", \"allocate across accounts\")\n   - Do NOT match if the request is about splitting the expense amount between attendees or participants\n\n3. Merge or unmerge expenses\n\n4. Add itemization lines to an expense\n\n5. Create an expense report\n   (e.g., \"create expense report\", \"new report\")\n\n6. Submit an expense report\n   (e.g., \"submit report\", \"file expense report\")\n\nOtherwise:\n- Set status = \"OPERATION_SUPPORTED\"\n\nAdditional Rules:\n- \"Create expense report\" and \"submit expense report\" are always NOT_SUPPORTED.\n- \"Update an expense\" is SUPPORTED unless it explicitly includes one of the restricted operations above.\n- Do NOT confuse \"update expense\" with \"create\" or \"submit\" expense report — they are different intents.\n- If multiple actions are mentioned, and ANY one of them is unsupported → set status = \"OPERATION_NOT_SUPPORTED\".\n\nOutput:\nReturn a JSON object with:\n{\n  \"status\": \"<OPERATION_SUPPORTED or OPERATION_NOT_SUPPORTED>\",\n  \"reasoning\": \"<brief explanation>\"\n}\n\nReasoning Rules:\n- If NOT_SUPPORTED → explicitly mention the matched rule and quote the relevant part of the userMessage.\n- If SUPPORTED → return: \"No restricted operation detected\"\n`;\n\nconst out = $context.$nodes.GETUNSPPORTEDAGENTPROMPT.$output ;\nconst prompts = Array.isArray(out?.prompts) ? out.prompts : [];\nlet mainPrompt = prompts?.find(p => p.promptType === \"MAIN\")?.prompt || defaultMainPrompt;\n\nlet prompt = {\n  mainPrompt: mainPrompt,\n};\n\nreturn prompt;"
          },
          "outcomes": {
            "success": "1772508909925"
          },
          "code": "EXTRACTUNSUPPORTEDAGENTPROMPT",
          "id": "1773061733565",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1775134455269",
            "name": "createPredictionsPayload",
            "returnType": "object",
            "sourceCode": "let predictionsPayload = {};\nlet itemsArray = [];\nlet personId = $context.$nodes.GETEXPENSEDETAILS.$output.person.id;\nlet partnerExpenseId = $context.$triggers.REST.$input.partnerExpenseId; // Corrected typo\nlet partnerExpenseObject = {\n    \"id\": partnerExpenseId\n};\n\n// Prepare the single prediction object\nlet itemPayload = {\n    \"$operation\": \"CREATE\",\n    \"partnerExpense\": partnerExpenseObject,\n    \"sourceObjectCode\": \"ORA_PARTNER_EXPENSE\",\n    \"fieldName\": \"\",                  // Not available without instructions\n    \"fieldValue\": \"\",                 // Not available without instructions\n    \"predictionRank\": \"\",\n    \"driverName1\": \"ORA_INSTRUCTION\",\n    \"driverValue1\": \"\",               // Not available without instructions\n    \"driverName2\": \"ORA_ENTITY_VALUE\",\n    \"driverValue2\": \"\",\n    \"driverName3\": \"ORA_AGENT_REASONING\",\n    \"driverValue3\": \"\",\n    \"driverName4\": \"\",\n    \"driverValue4\": \"\",\n    \"driverName5\": \"\",\n    \"driverValue5\": \"\",\n    \"predictionSource\": \"ORA_COMPLETION_ASSISTANT\",\n    \"ruleCode\": \"ORA_LLM_EXTRACTED\",\n    \"person\": { id: personId },\n    \"predictionTypeCode\": \"ORA_OPERATION_NOT_SUPPORTED\",\n    \"predictionDisplayRule\": \"ORA_NOTIFY_USER\"\n};\n\n// Add the object to the items array\nitemsArray.push(itemPayload);\n\npredictionsPayload[\"items\"] = itemsArray;\nreturn predictionsPayload;"
          },
          "outcomes": {
            "success": "1775045260255"
          },
