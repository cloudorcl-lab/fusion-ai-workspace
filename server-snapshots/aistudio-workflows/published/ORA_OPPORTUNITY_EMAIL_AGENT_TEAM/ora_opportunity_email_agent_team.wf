            "returnType": "object",
            "sourceCode": "let output = {\"insightId\": null, \"insightNumber\": null};\nconst insightRecords = $context.$nodes.GETENGAGEMENTINSIGHT.$output.items;\nif(insightRecords.length > 0) {\n   output.insightId = insightRecords[0]?.id;\n   output.insightNumber = insightRecords[0]?.engagementInsightNumber;\n}\nreturn output;"
          },
          "outcomes": {
            "success": "1765922001733"
