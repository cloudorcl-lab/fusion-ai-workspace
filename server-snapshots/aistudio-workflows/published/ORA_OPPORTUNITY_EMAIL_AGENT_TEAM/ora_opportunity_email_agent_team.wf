            "functionName": "getSalesPlayChunks",
            "processJson": true,
            "name": "Invoke Sales Play"
          },
          "outcomes": {
            "success": "1776231968940"
          },
          "code": "INVOKE_SALES_PLAY",
          "id": "1770851797657",
          "inputs": [
            {
              "id": "1770851813360_1",
              "name": "question",
              "type": "string",
              "value": "{{$context.$nodes.SANITIZE_SALES_PLAY_INPUT_QUESTION.$output.result}}"
            },
            {
              "id": "1770851813361_2",
              "name": "sales_play_param",
              "type": "string",
              "value": "{{$context.$nodes.GET_SALES_PLAY_PARAM.$output.result}}"
