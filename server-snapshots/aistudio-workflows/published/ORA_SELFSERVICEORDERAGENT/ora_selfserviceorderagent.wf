            "sourceCode": "const defaultCustomerData= $context.$nodes.GET_DEFAULT_CUSTOMER_DATA.$output; \nconst pRequestedDate = new Date().toISOString().replace(\"Z\", \"+00:00\");\n\nreturn {\n  pRequestedDate: pRequestedDate,\n  pBusinessUnitId: Number($context.$nodes.EXTRACT_USER_DETAILS.$output.result.BusinessUnitId),\n  pPartyId: Number($context.$nodes.EXTRACT_USER_DETAILS.$output.result.AccountPartyId),\n  pTxnCurrencyCode: \"\" + $context.$nodes.EXTRACT_USER_DETAILS.$output.result.DefaultCurrencyCode + \"\",\n  pAppliedCurrencyCode: \"\" + $context.$nodes.EXTRACT_USER_DETAILS.$output.result.DefaultCurrencyCode + \"\",\n  pBillToPartyId: defaultCustomerData.BillToPartyId,\n  pBillToAccountId: defaultCustomerData.BillToAccountId,\n  pBillToAccountSiteUseId: defaultCustomerData.BillToAccountSiteUseId,\n  pShipToPartyId: defaultCustomerData.ShipToPartyId,\n  pShipToPartySiteId: defaultCustomerData.ShipToPartySiteId,\n  pShipToContactId: defaultCustomerData.ShipToContactId,\n  pShipToContactPointId: defaultCustomerData.ShipToContactPointId\n};"
