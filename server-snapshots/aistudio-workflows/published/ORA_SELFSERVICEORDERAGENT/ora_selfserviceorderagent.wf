            "sourceCode": "const BUDetails=$context.$nodes.GET_BUSINESS_UNIT_ID.$output;\nconst SelfServiceUserDetails= $context.$nodes.GET_SELFSERVICE_USER.$output?.items[0]; \nconst SelfServiceUserInfo= $context.$nodes.GET_USER_DETAILS.$output?.items[0]; \n\n\nreturn {\n  BusinessUnitId: BUDetails?.items?.[0]?.BusinessUnitId,\n  DefaultCurrencyCode: BUDetails?.items?.[0]?.DefaultCurrencyCode,\n  AccountPartyNumber: SelfServiceUserDetails?.AccountPartyNumber,\n  AccountPartyId: SelfServiceUserDetails?.AccountPartyId,\n  ContactPartyId: SelfServiceUserDetails?.ContactPartyId,\n  ContactPartyNumber: SelfServiceUserDetails?.ContactPartyNumber,\n  AccountPartyName: SelfServiceUserDetails?.AccountPartyName,\n  ContactPartyName: SelfServiceUserDetails?.ContactPartyName,\n  FirstName: SelfServiceUserInfo?.FirstName,\n  LastName: SelfServiceUserInfo?.LastName\n};"
          },
