            "sourceCode": "var userInputMap = {};\nconst jobNameFromUser = $context.$nodes.PARSEUSERINPUT.$output.JobName;\nconst jobCodeFromUser = $context.$nodes.PARSEUSERINPUT.$output.JobCode;\n\nvar jobName = $context.$variables.JobName;\nvar jobCode = $context.$variables.JobCode;\n\nif(jobNameFromUser != \"\" && jobNameFromUser != null){\njobName = jobNameFromUser;\n}\n\nif(jobCodeFromUser != \"\" && jobCodeFromUser != null){\njobCode = jobCodeFromUser;\n}\n\nuserInputMap[\"JobName\"] = jobName;\nuserInputMap[\"JobCode\"] = jobCode;\n\n\nreturn userInputMap;"
          },
