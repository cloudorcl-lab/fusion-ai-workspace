        {
          "metadata": {
            "name": "Process Metadata",
            "returnType": "object",
            "sourceCode": "let output = $context.$nodes.FETCH_METADATA.$output;\nlet appContext = $context.$nodes.PROCESS_APPLICATION_CONTEXT.$output.result;\nif(typeof output == 'string'){\n  output = JSON.parse(output);\n}\n\nlet mdEntry = output?.[0] || {};\nlet dimensionAttr = mdEntry.DIMENSIONATTRIBUTES;\n\nif(typeof dimensionAttr == 'string'){\n  dimensionAttr = JSON.parse(dimensionAttr);\n}\nlet bossAv = { bossAvName : dimensionAttr.avMetadata.bossAvName };\nreturn {...appContext, ...bossAv};"
          },
          "outcomes": {
            "success": "1780665961569"
          },
          "code": "PROCESS_METADATA",
          "id": "1780658456102",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 5042,
            "y": 6982
          }
        },
        {
          "metadata": {
            "name": "Prepare Additional Context for Query",
            "returnType": "object",
            "sourceCode": "const parseMaybeJson = (value) => {\n  if (value === null || value === undefined) return value;\n  if (typeof value !== \"string\") return value;\n  const trimmed = value.trim();\n  if (!trimmed) return value;\n  try {\n    return JSON.parse(trimmed);\n  } catch (error) {\n    return value;\n  }\n};\n\nconst isRecord = (value) => value !== null && typeof value === \"object\" && !Array.isArray(value);\n\nconst stateLooksUsable = (value) =>\n  isRecord(value) &&\n  (\n    isRecord(value.private?.lastUsedQuery) ||\n    isRecord(value.private?.lastUsedData) ||\n    isRecord(value.domains) ||\n    isRecord(value.shared)\n  );\n\nconst extractLedgerStateMarkers = (value) => {\n  const text = typeof value === \"string\" ? value : JSON.stringify(value || \"\");\n  const matches = [...text.matchAll(/<!--LEDGER_AGENT_STATE:([\\s\\S]*?)-->/g)];\n  return matches\n    .map((match) => {\n      try {\n        const decoded = decodeURIComponent(match[1]);\n        const parsed = JSON.parse(decoded);\n        return parsed && typeof parsed === \"object\" && !Array.isArray(parsed) ? parsed : {};\n      } catch (error) {\n        return {};\n      }\n    })\n    .filter((item) => Object.keys(item).length > 0);\n};\n\nconst findFirst = (value, predicate, seen = new Set()) => {\n  const parsed = parseMaybeJson(value);\n\n  if (predicate(parsed)) {\n    return parsed;\n  }\n\n  if (Array.isArray(parsed)) {\n    for (const item of parsed) {\n      const found = findFirst(item, predicate, seen);\n      if (found !== undefined) return found;\n    }\n    return undefined;\n  }\n\n  if (isRecord(parsed)) {\n    if (seen.has(parsed)) return undefined;\n    seen.add(parsed);\n\n    if (predicate(parsed.state)) return parsed.state;\n    if (predicate(parsed.ledgerAgentState)) return parsed.ledgerAgentState;\n    if (predicate(parsed.previousLedgerState)) return parsed.previousLedgerState;\n\n    for (const value of Object.values(parsed)) {\n      const found = findFirst(value, predicate, seen);\n      if (found !== undefined) return found;\n    }\n  }\n\n  return undefined;\n};\n\nconst appContext = $context.$nodes.PROCESS_METADATA?.$output?.result || $context.$nodes.PROCESS_APPLICATION_CONTEXT.$output.result || {};\nconst obj = {\n  ledgerContext: appContext.ledgerName || \"\",\n  analyticView: appContext.bossAvName || \"\",\n  ledgerId: appContext.ledgerId || \"\",\n  ledgerCategory: appContext.ledgerCategory || \"\",\n  chartOfAccountsId: appContext.chartOfAccountsId || \"\",\n  conversationId: $context.$workflow?.$conversationId || \"\",\n  queries: [\n    {\n      query: {\n        filter: \"\",\n        time_period: [],\n        currency: []\n      }\n    }\n  ]\n};\n\nlet systemChatHistory = $context.$system?.$chatHistory || \"\";\nlet parsedChatHistory = systemChatHistory;\n\nif (systemChatHistory && typeof systemChatHistory === \"object\") {\n  parsedChatHistory = systemChatHistory;\n  try {\n    systemChatHistory = JSON.stringify(systemChatHistory);\n  } catch (error) {\n    systemChatHistory = \"\";\n  }\n} else if (typeof systemChatHistory !== \"string\") {\n  systemChatHistory = String(systemChatHistory || \"\");\n} else {\n  parsedChatHistory = parseMaybeJson(systemChatHistory);\n}\n\nobj.handoffChatHistory = systemChatHistory;\n\nconst stateMarkers = [\n    ...extractLedgerStateMarkers(appContext),\n    ...extractLedgerStateMarkers(parsedChatHistory),\n    ...extractLedgerStateMarkers(systemChatHistory)\n  ];\nconst latestStateMarker = stateMarkers.length > 0 ? stateMarkers[stateMarkers.length - 1] : {};\n\nconst priorState =\n    latestStateMarker.state ||\n    findFirst(appContext, stateLooksUsable) ||\n    findFirst(parsedChatHistory, stateLooksUsable) ||\n    findFirst(systemChatHistory, stateLooksUsable);\n\nif (stateLooksUsable(priorState)) {\n  obj.state = priorState;\n}\n\nconst priorCompactedChatHistory =\n    (Array.isArray(latestStateMarker.compactedChatHistory) ? latestStateMarker.compactedChatHistory : undefined) ||\n    findFirst(appContext, (value) => Array.isArray(value?.compactedChatHistory))?.compactedChatHistory ||\n    findFirst(parsedChatHistory, (value) => Array.isArray(value?.compactedChatHistory))?.compactedChatHistory;\n\nif (Array.isArray(priorCompactedChatHistory)) {\n  obj.compactedChatHistory = priorCompactedChatHistory;\n}\n\nreturn obj;"
          },
          "outcomes": {
            "success": "1780666150668"
          },
          "code": "PREPARE_ADDITIONAL_CONTEXT_FOR_QUERY",
          "id": "1780665961569",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
