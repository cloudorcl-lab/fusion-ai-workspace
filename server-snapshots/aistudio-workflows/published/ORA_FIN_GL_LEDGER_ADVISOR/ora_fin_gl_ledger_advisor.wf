          "inputs": [
            {
              "id": "1780939597914_message",
              "name": "message",
              "type": "string",
              "value": "{{$context.$system.$inputMessage}}"
            },
            {
              "id": "1780939597914_OraAppContext",
              "name": "OraAppContext",
              "type": "string",
              "value": "{{$context.$app.$OraAppContext}}"
