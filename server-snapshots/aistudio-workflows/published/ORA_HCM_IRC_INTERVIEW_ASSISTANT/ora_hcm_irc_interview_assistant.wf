        {
          "metadata": {
            "name": "Final_Data",
            "returnType": "array",
            "sourceCode": "var exactData = $context.$nodes.EXACTANDFORMATINTERVIEWSDATA.$output.result;\nvar actionDetailsInput = $context.$nodes.GET_INTERVIEW_ACTION_DETAILS.$output;\nvar actionDetails = Array.isArray(actionDetailsInput) ? actionDetailsInput : [];\n\nfunction normalizeBoolean(value) {\n  if (value === true || value === 'true' || value === 'TRUE' || value === 'Y' || value === 'y' || value === 'Yes' || value === 'YES') {\n    return true;\n  }\n  return false;\n}\n\nfunction findExplicitO365Flag(value) {\n  if (!value || typeof value !== 'object') {\n    return false;\n  }\n  var stack = [value];\n  while (stack.length > 0) {\n    var current = stack.pop();\n    if (!current || typeof current !== 'object') {\n      continue;\n    }\n    var keys = Object.keys(current);\n    for (var i = 0; i < keys.length; i += 1) {\n      var key = keys[i];\n      var lower = key.toLowerCase();\n      var candidate = current[key];\n      var namesIntegration = lower.indexOf('o365') >= 0 ||\n        lower.indexOf('office365') >= 0 ||\n        lower.indexOf('outlook') >= 0 ||\n        lower.indexOf('calendarintegration') >= 0 ||\n        lower.indexOf('calendar') >= 0;\n      var namesEnabled = lower.indexOf('enabled') >= 0 ||\n        lower.indexOf('integrated') >= 0 ||\n        lower.indexOf('available') >= 0;\n      if (namesIntegration && namesEnabled && normalizeBoolean(candidate)) {\n        return true;\n      }\n      if (candidate && typeof candidate === 'object') {\n        stack.push(candidate);\n      }\n    }\n  }\n  return false;\n}\n\nif (!Array.isArray(exactData)) {\n  exactData = [];\n}\n\nfor (var j = 0; j < exactData.length; j += 1) {\n  var actionResult = {};\n  if (actionDetails[j]) {\n    try {\n      var parsed = typeof actionDetails[j] === 'string' ? JSON.parse(actionDetails[j]) : actionDetails[j];\n      actionResult = parsed && parsed.result ? parsed.result : parsed;\n    } catch (error) {\n      actionResult = {};\n    }\n  }\n  var isEditInterviewAllowed = normalizeBoolean(actionResult && actionResult.isEditInterviewAllowed);\n  var isO365IntegrationEnabled = findExplicitO365Flag(actionResult);\n  exactData[j].isEditInterviewAllowed = isEditInterviewAllowed;\n  exactData[j].isO365IntegrationEnabled = isO365IntegrationEnabled;\n  exactData[j].canReschedule = isEditInterviewAllowed && isO365IntegrationEnabled;\n}\n\nreturn exactData;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "FINALDATA",
          "convergenceTargetId": "1766101197706",
          "id": "1765568157746",
