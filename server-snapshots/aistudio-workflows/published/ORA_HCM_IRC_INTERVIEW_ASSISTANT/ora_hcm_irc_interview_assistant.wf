        {
          "metadata": {
            "name": "GetTop6UpcoimgInterviews",
            "returnType": "array",
            "sourceCode": "const output = $context?.$nodes?.GET_ALL_INTERVIEWS?.$output || {};\nconst items = output?.result?.items;\n\nif (!Array.isArray(items)) {\n  // Be defensive: return empty list if payload isn't as expected\n  return null;\n}\n\nconst top6 = items\n  .filter((it) => it && typeof it.StartDate === \"string\" && !Number.isNaN(Date.parse(it.StartDate)))\n  .sort((a, b) => Date.parse(a.StartDate) - Date.parse(b.StartDate))\n  .slice(0, 6);\nreturn top6;"
          },
          "outcomes": {
            "success": "1764881348311"
          },
          "code": "GETTOP6UPCOIMGINTERVIEWS",
          "convergenceTargetId": "1765561141562",
          "id": "1765475146078",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
