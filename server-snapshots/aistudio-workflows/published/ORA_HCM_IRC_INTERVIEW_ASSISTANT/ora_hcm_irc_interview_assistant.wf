        {
          "metadata": {
            "name": "Format Data",
            "returnType": "object",
            "sourceCode": "const rawDetails = $context.$nodes.GETALLINTERVIEWDETAILS.$output;\nconst timeSlots = $context.$nodes.GETTOP6UPCOIMGINTERVIEWS.$output.result;\nlet formatted = [];\n\nfor (let i = 0; i < rawDetails.length; i++) {\n  let item;\n  try {\n    item = JSON.parse(rawDetails[i]);\n  } catch (e) {\n    continue;\n  }\n\n  // Skip interviews with NO candidates\n  if (\n    !item.interviewCandidates ||\n    !item.interviewCandidates.items ||\n    item.interviewCandidates.items.length === 0\n  ) {\n    continue;\n  }\n\n  const title = item.InterviewTitle || \"\";\n\n  // ------------------------------\n  // Candidate / Requisition\n  // ------------------------------\n  let candidateName = \"\";\n  let submissionId = \"\";\n  let requisitionTitle = \"\";\n  let requisitionNumber = \"\";\n\n  if (item.interviewCandidates.items && item.interviewCandidates.items.length > 0) {\n    const candidate = item.interviewCandidates.items[0];\n    candidateName = candidate.DisplayName || \"\";\n    submissionId = candidate.SubmissionId || \"\";\n    requisitionTitle = candidate.RequisitionTitle || \"\";\n    requisitionNumber = candidate.RequisitionNumber || \"\";\n  }\n\n  // Build \"Requisition: Title (Number)\" as a single field\n  let requisitionDetail = \"\";\n  if (requisitionTitle && requisitionNumber) {\n    requisitionDetail = `${requisitionTitle} (${requisitionNumber})`;\n  } else if (requisitionTitle) {\n    requisitionDetail = requisitionTitle;\n  } else if (requisitionNumber) {\n    requisitionDetail  = `(${requisitionNumber})`;\n  }\n\n  // ------------------------------\n  // Interviewers (names + personIds)\n  // ------------------------------\n  let interviewerNames = \"\";\n  let interviewerPersonIds = [];\n\n  if (item.interviewInterviewers && item.interviewInterviewers.items && item.interviewInterviewers.items.length > 0) {\n    interviewerNames = item.interviewInterviewers.items\n      .map(iv => iv.InterviewerDisplayName)\n      .filter(Boolean)\n      .join(\", \");\n\n    interviewerPersonIds = item.interviewInterviewers.items\n      .map(iv => iv.PersonId)\n      .filter(Boolean);\n  }\n\n  // ------------------------------\n  // Location (per rules)\n  // - If LocationType is ORA_IS_LOCATION_WEBCONFERENCE -> WebConferenceLink\n  // - Else prefer FormattedSingleLineAddress, then FormattedMultiLineAddress\n  // - Else fallback to LocationTypeName\n  // ------------------------------\n  let location = \"\";\n  let locationType = \"\";\n  let locationTypeName = \"\";\n  let webConferenceLink = \"\";\n  let formattedSingleLineAddress = \"\";\n  let formattedMultiLineAddress = \"\";\n\n  if (item.interviewLocation && item.interviewLocation.items && item.interviewLocation.items.length > 0) {\n    const loc = item.interviewLocation.items[0] || {};\n    locationType = loc.LocationType || \"\";\n    locationTypeName = loc.LocationTypeName || \"\";\n    webConferenceLink = loc.WebConferenceLink || \"\";\n    formattedSingleLineAddress = loc.FormattedSingleLineAddress || \"\";\n    formattedMultiLineAddress = loc.FormattedMultiLineAddress || \"\";\n\n    if (locationType === \"ORA_IS_LOCATION_WEBCONFERENCE\") {\n      location = webConferenceLink || locationTypeName || \"Web Conference\";\n    } else {\n      location =\n        formattedSingleLineAddress ||\n        formattedMultiLineAddress ||\n        locationTypeName ||\n        \"\";\n    }\n  }\n\n  // ------------------------------\n  // Time slot info (UTC)\n  // ------------------------------\n  let interviewResponseStatus = \"\";\n  let utcStartTime = \"\";\n  let utcEndTime = \"\";\n\n  const slot = timeSlots && timeSlots[i] ? timeSlots[i] : null;\n  if (slot) {\n    const startUtc = new Date(slot.StartDate);\n    const endUtc = new Date(slot.EndDate);\n\n    interviewResponseStatus = slot.InterviewResponseStatusName || \"\";\n    utcStartTime = startUtc.toISOString();\n    utcEndTime = endUtc.toISOString();\n  }\n\n  formatted.push({\n    interviewTitle: title,\n    candidateName,\n    interviewerNames,\n    interviewerPersonIds,\n    requisitionDetail,\n    submissionId,\n    InterviewResponseStatus: interviewResponseStatus,\n    location, // <-- new field\n    utcStartTime,\n    utcEndTime\n  });\n}\n\nreturn formatted;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "FORMAT_DATA",
          "id": "1765910428879",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
