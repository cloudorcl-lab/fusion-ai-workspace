        {
          "metadata": {
            "name": "SetuserIntent",
            "returnType": "object",
            "sourceCode": "// ============================================================\n// setuserIntent \n// ============================================================\n// Purpose: Validates and normalizes the raw LLM output from\n//          ClassifyIntent into a clean, structured result.\n//\n// What it does:\n// 1. Reads the raw ClassifyIntent output\n// 2. Handles null/empty/malformed responses gracefully\n// 3. Filters out any hallucinated categories not in our whitelist\n// 4. Normalizes each intent to {category} and dedupes by category\n// 5. Separates routable intents (CMP, ABS, BEN, PAY, POL) from signal intents (GEN)\n// 6. Sets isGreeting + greetingType + hasOffTopic flags\n// 7. Passes through the rewritten message (the worker's input)\n//\n// Output:\n//   .userIntent        - array of routable domain intents; each has .category\n//   .parseError        - true if ClassifyIntent returned null/invalid JSON\n//   .isGreeting        - true if user said hello/thanks/small talk\n//   .greetingType      - validated greeting subtype or null\n//   .hasOffTopic       - true if message had non-HCM/non-GEN content\n//   .switchAssignment  - true if user asked to switch work assignment\n//   .rewrittenMessage  - self-contained version of user's question (worker input)\n//\n// ============================================================\n\n// --- Step 1: Read raw LLM output ---\nvar raw = $context.$nodes.CLASSIFY_INTENT.$output;\n\n// --- Step 2: Define valid categories ---\nvar VALID_CATEGORIES = ['CMP', 'ABS', 'BEN', 'PAY', 'POL', 'GEN'];\nvar VALID_GREETING_TYPES = ['greeting', 'thanks', 'abandonment', 'farewell', 'identity', 'capabilities', 'frustration', 'reset'];\n\n// --- Step 3: Null/empty guard ---\n// Build result as a plain object then return it (26B mangles inline `return {...};`)\nif (!raw) {\n  var nullResult = {};\n  nullResult.userIntent = [];\n  nullResult.parseError = true;\n  nullResult.isGreeting = false;\n  nullResult.greetingType = null;\n  nullResult.hasOffTopic = false;\n  nullResult.switchAssignment = false;\n  nullResult.rewrittenMessage = '';\n  return nullResult;\n}\n\n// --- Step 4: Parse the response ---\nvar parsed = null;\ntry {\n  if (typeof raw === 'string') {\n    parsed = JSON.parse(raw);\n  } else {\n    parsed = raw;\n  }\n} catch (e) {\n  parsed = null;\n}\n\nif (!parsed) {\n  // Parse failed - return same shape as null guard\n  var parseFailResult = {};\n  parseFailResult.userIntent = [];\n  parseFailResult.parseError = true;\n  parseFailResult.isGreeting = false;\n  parseFailResult.greetingType = null;\n  parseFailResult.hasOffTopic = false;\n  parseFailResult.switchAssignment = false;\n  parseFailResult.rewrittenMessage = '';\n  return parseFailResult;\n}\n\n// --- Step 5: Pass-through fields ---\nvar rewrittenMessage = '';\nif (parsed.rewrittenMessage) {\n  rewrittenMessage = parsed.rewrittenMessage;\n}\n\nvar hasOffTopic = false;\nif (parsed.hasOffTopic === true) {\n  hasOffTopic = true;\n}\n\nvar switchAssignment = false;\nif (parsed.switchAssignment === true) {\n  switchAssignment = true;\n}\n\n// --- Step 6: Validate categories and dedup ---\n// Whitelist filter + dedupe by category (preserves first occurrence)\nvar intents = [];\nvar seenCategories = [];\nif (parsed.userIntent && parsed.userIntent.length != null) {\n  for (var i = 0; i < parsed.userIntent.length; i++) {\n    var item = parsed.userIntent[i];\n    if (!item || !item.category) {\n      continue;\n    }\n    var category = item.category;\n\n    // Whitelist check\n    var validCat = false;\n    for (var c = 0; c < VALID_CATEGORIES.length; c++) {\n      if (VALID_CATEGORIES[c] === category) {\n        validCat = true;\n        break;\n      }\n    }\n    if (!validCat) {\n      continue;\n    }\n\n    // Dedupe\n    var alreadySeen = false;\n    for (var s = 0; s < seenCategories.length; s++) {\n      if (seenCategories[s] === category) {\n        alreadySeen = true;\n        break;\n      }\n    }\n    if (!alreadySeen) {\n      var intentObj = {};\n      intentObj.category = category;\n      intents.push(intentObj);\n      seenCategories.push(category);\n    }\n  }\n}\n\n// --- Step 7: Separate routable intents from signals ---\n// GEN is a signal intent (greeting/thanks/etc.) — kept out of worker routing.\n// Other categories (CMP/ABS/BEN/PAY/POL) are routable.\nvar routableIntents = [];\nvar isGreeting = false;\nfor (var r = 0; r < intents.length; r++) {\n  if (intents[r].category === 'GEN') {\n    isGreeting = true;\n  } else {\n    routableIntents.push(intents[r]);\n  }\n}\n\n// Validate greetingType against the allowed list\nvar greetingType = null;\nif (parsed.greetingType) {\n  for (var g = 0; g < VALID_GREETING_TYPES.length; g++) {\n    if (VALID_GREETING_TYPES[g] === parsed.greetingType) {\n      greetingType = parsed.greetingType;\n      break;\n    }\n  }\n}\n\n// If GEN was returned but greetingType is missing/invalid, the classifier was uncertain.\n// Demote to OOS (off-topic refusal) rather than firing a wrong greeting reply.\nif (isGreeting && !greetingType) {\n  isGreeting = false;\n  hasOffTopic = true;\n}\n\n// --- Step 8: Cross-domain keyword injection safety net ---\n// Fires ONLY when classifier returned empty routable intents but raw input\n// contains an HCM keyword. Catches cases where the LLM omitted a category\n// it should have flagged.\nvar inputMsg = '';\nvar inputMessageVal = $context.$system.$inputMessage;\nif (inputMessageVal) {\n  inputMsg = String(inputMessageVal).toLowerCase();\n}\n\nvar cmpTerms = ['salary', 'annual salary', 'compensation', 'base pay', 'income', 'wage', 'stock', 'allowance', 'raise', 'net worth', 'bonus', 'awards', 'recurring payments'];\nvar payTerms = ['net pay', 'take-home', 'take home', 'gross pay', 'payslip', 'paycheck', 'earnings', 'deduction', 'biweekly', 'bi-weekly'];\nvar benTerms = ['benefits', 'insurance', 'coverage', 'premium', 'fsa', 'benefits paid', 'benefits cost', 'enrollment', 'ad&d', 'life insurance'];\nvar absTerms = ['pto', 'leave', 'time off', 'vacation', 'sick', 'absence'];\nvar polTerms = ['policy', 'policies', 'rule', 'rules', 'eligible', 'eligibility', 'according to policy', 'per policy'];\n\n// Scan for keyword presence in each domain\nvar hasCmpRef = false;\nfor (var x1 = 0; x1 < cmpTerms.length; x1++) {\n  if (inputMsg.indexOf(cmpTerms[x1]) !== -1) { hasCmpRef = true; break; }\n}\nvar hasPayRef = false;\nfor (var x2 = 0; x2 < payTerms.length; x2++) {\n  if (inputMsg.indexOf(payTerms[x2]) !== -1) { hasPayRef = true; break; }\n}\nvar hasBenRef = false;\nfor (var x3 = 0; x3 < benTerms.length; x3++) {\n  if (inputMsg.indexOf(benTerms[x3]) !== -1) { hasBenRef = true; break; }\n}\nvar hasAbsRef = false;\nfor (var x4 = 0; x4 < absTerms.length; x4++) {\n  if (inputMsg.indexOf(absTerms[x4]) !== -1) { hasAbsRef = true; break; }\n}\nvar hasPolRef = false;\nfor (var x5 = 0; x5 < polTerms.length; x5++) {\n  if (inputMsg.indexOf(polTerms[x5]) !== -1) { hasPolRef = true; break; }\n}\n\nvar hasAnyDomainKeyword = hasCmpRef || hasPayRef || hasBenRef || hasAbsRef || hasPolRef;\n\n// If LLM produced no routable intents but a keyword exists, inject the matching categories\nif (routableIntents.length === 0 && hasAnyDomainKeyword) {\n  if (hasCmpRef) { var o1 = {}; o1.category = 'CMP'; routableIntents.push(o1); }\n  if (hasPayRef) { var o2 = {}; o2.category = 'PAY'; routableIntents.push(o2); }\n  if (hasBenRef) { var o3 = {}; o3.category = 'BEN'; routableIntents.push(o3); }\n  if (hasAbsRef) { var o4 = {}; o4.category = 'ABS'; routableIntents.push(o4); }\n  if (hasPolRef) { var o5 = {}; o5.category = 'POL'; routableIntents.push(o5); }\n}\n\n// --- Step 9: Return structured result ---\nvar finalResult = {};\nfinalResult.userIntent = routableIntents;\nfinalResult.parseError = false;\nfinalResult.isGreeting = isGreeting;\nfinalResult.greetingType = greetingType;\nfinalResult.hasOffTopic = hasOffTopic;\nfinalResult.switchAssignment = switchAssignment;\nfinalResult.rewrittenMessage = rewrittenMessage;\nreturn finalResult;"
          },
          "outcomes": {
            "success": "2000000006001"
          },
          "code": "SETUSERINTENT",
          "id": "1772064214042",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "FilterActiveAssignments",
            "returnType": "object",
            "sourceCode": "// Filters Get Workers Assignments to ACTIVE/SUSPENDED and identifies the primary.\n// Invariant: every worker has >=1 active assignment, exactly one carries AssignmentPrimaryFlag=true.\n// Outputs: activeItems, count, primary, listText.\n\nvar raw = $context.$nodes.GET_WORKERS_ASSIGNMENTS.$output;\n\nvar items = [];\nif (raw && raw.items && raw.items.length != null) {\n  items = raw.items;\n}\n\nvar ACTIVE_STATUSES = ['ACTIVE', 'SUSPENDED'];\n\nvar activeItems = [];\nfor (var i = 0; i < items.length; i++) {\n  var a = items[i];\n  if (a) {\n    var matched = false;\n    for (var s = 0; s < ACTIVE_STATUSES.length; s++) {\n      if (ACTIVE_STATUSES[s] === a.AssignmentStatusType) {\n        matched = true;\n        break;\n      }\n    }\n    if (matched) {\n      activeItems.push(a);\n    }\n  }\n}\n\nvar primaryItem = null;\nfor (var j = 0; j < activeItems.length; j++) {\n  if (activeItems[j] && activeItems[j].AssignmentPrimaryFlag === true) {\n    primaryItem = activeItems[j];\n    break;\n  }\n}\n\nvar lineArr = [];\nfor (var k = 0; k < activeItems.length; k++) {\n  var item = activeItems[k];\n  var name = (item && item.AssignmentName) ? item.AssignmentName : ('Assignment ' + (k + 1));\n  var emp = (item && item.LegalEmployerName) ? item.LegalEmployerName : '';\n  var suffix = '';\n  if (emp) {\n    suffix = ' - ' + emp;\n  }\n  lineArr.push((k + 1) + '. ' + name + suffix);\n}\nvar listText = lineArr.join('\\n');\n\nvar result = {};\nresult.activeItems = activeItems;\nresult.count = activeItems.length;\nresult.primary = primaryItem;\nresult.listText = listText;\nreturn result;"
          },
          "outcomes": {
            "success": "2000000004002"
          },
          "code": "FILTER_ACTIVE_ASSIGNMENTS",
          "id": "2000000004001",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": { \"type\": \"object\" },\n    \"timeout\": { \"type\": \"boolean\" },\n    \"error\": { \"type\": \"string\" }\n  }\n}",
          "type": "CODE"
        },
