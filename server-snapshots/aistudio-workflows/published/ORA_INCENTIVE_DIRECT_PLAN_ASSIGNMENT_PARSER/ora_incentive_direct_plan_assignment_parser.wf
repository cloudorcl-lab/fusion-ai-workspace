        {
          "metadata": {
            "name": "Prepare Input For Analysis",
            "returnType": "object",
            "sourceCode": "// PREPARE_INPUT_FOR_ANALYSIS: Get first 2K chars and metadata for LLM\n\nconst rawInput = $context.$triggers.REST.$input.inputData;\nconst INPUT_BUFFER_LIMIT = 2000;\n\nconst fullLength = rawInput.length;\nconst isLargeInput = fullLength > INPUT_BUFFER_LIMIT;\n\nlet inputBuffer = rawInput;\nif (isLargeInput) {\n  inputBuffer = rawInput.substring(0, INPUT_BUFFER_LIMIT);\n  // Try to cut at line boundary\n  const lastNewline = inputBuffer.lastIndexOf('\\n');\n  if (lastNewline > INPUT_BUFFER_LIMIT * 0.8) {\n    inputBuffer = inputBuffer.substring(0, lastNewline + 1);\n  }\n}\n\nconst lines = inputBuffer.split(/\\r?\\n/).filter(l => l.trim() !== '');\n\nconst dataObject = {\n    inputBuffer: inputBuffer,\n    fullLength: fullLength,\n    isLargeInput: isLargeInput,\n    lineCount: lines.length\n  };\n\n  return JSON.stringify(dataObject);"
          },
          "outcomes": {
            "success": "1764611677200"
          },
          "code": "PREPARE_INPUT_FOR_ANALYSIS",
          "id": "1764605964394",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
