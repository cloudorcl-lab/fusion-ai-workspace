          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1767793439921",
            "name": "On Hand Values",
            "returnType": "object",
            "sourceCode": "let onhandDataItems = $context.$nodes.TECHNICIAN_ON_HAND_JSON_FORMATTER.$output.result;\nlet onhandMap = Object.create(null);\nlet uomMap = Object.create(null);\n\nfor (let l = 0; l < onhandDataItems.length; l++) {\n\n  let onhandData = onhandDataItems[l].items;\n  if (typeof onhandData === \"string\") onhandData = JSON.parse(onhandData);\n\n  let onhandItems = [];\n  if (onhandData && Array.isArray(onhandData.items)) onhandItems = onhandData.items;\n  else if (Array.isArray(onhandData)) onhandItems = onhandData;\n\n  for (let i = 0; i < onhandItems.length; i++) {\n    let o = onhandItems[i] || null;\n    let k = o && o.ItemNumber ? String(o.ItemNumber).trim() : \"\";\n    if (!k) continue;\n    let q = Number(o.AvailableToTransact != null ? o.AvailableToTransact : o.PrimaryOnhandQuantity) || 0;\n    onhandMap[k] = (onhandMap[k] || 0) + q;\n    if (!uomMap[k]) uomMap[k] = String(o.PrimaryUOMCode || \"\");\n  }\n}\n\nlet out = Object.create(null);\nout.onhandMap = Object.create(null);\nout.uomMap = Object.create(null);\nout.onhandMap = onhandMap;\nout.uomMap = uomMap;\n\nreturn out;"
          },
          "outcomes": {
            "success": "1767718756143"
          },
