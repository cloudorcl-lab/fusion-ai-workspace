                        {
                          "metadata": {
                            "name": "Reserve Payload",
                            "returnType": "object",
                            "sourceCode": "// Node: BUILD_RESERVATION_PAYLOAD_FROM_CHOSEN_SOURCE (blindly follow chosenSource)\n// - No takeQty math based on required/supplied.\n// - For each chosenSource entry, build one payload part using chosen.Quantity.\n// - Only does mapping: chosen (subinv|org|invId) -> supply row to copy transport/ETA/etc.\n\nlet supply = $context.$nodes.RESERVEPARTS.RESERVE_EACH_PART_LINE.GET_AVAILABLE_PARTS.$output.result;\nlet destOrgId = String($context.$nodes.TECHNICIAN_SUBINVENTORY_CHECK.$output.items[0].OrganizationId || \"\");\nlet destSub = String($context.$nodes.TECHNICIAN_SUBINVENTORY_CHECK.$output.items[0].Subinventory || \"\");\nlet partItem = $context.$nodes.RESERVEPARTS.RESERVE_EACH_PART_LINE.$currentItem;\nlet activities = $context.$nodes.SHOW_ACTIVITIES.$output.result;\n\n\n// ---------- Parse inputs if string ----------\nif (typeof partItem === \"string\") { try { partItem = JSON.parse(partItem); } catch (e) { partItem = null; } }\nif (typeof supply === \"string\") { try { supply = JSON.parse(supply); } catch (e) { supply = []; } }\n\nif (!partItem) partItem = Object.create(null);\nif (!Array.isArray(supply)) supply = [];\n\n// ---------- Context fields ----------\nlet requirementHeaderId = null;\nlet requirementLineDetailId = null;\nlet sourceId = null;\nlet sourceType = null;\nlet requirementLineId = partItem.RequirementLineId;\nlet parentEntityId = partItem.svcWorkOrderId;\nlet needByDate = partItem.NeedByDate;\n\nlet partMeta =\n    ($context.$nodes.RESERVEPARTS.PARTTORESERVE && $context.$nodes.RESERVEPARTS.PARTTORESERVE.$output)\n        ? $context.$nodes.RESERVEPARTS.PARTTORESERVE.$output.result\n        : null;\n\nif (typeof partMeta === \"string\") { try { partMeta = JSON.parse(partMeta); } catch (e) { partMeta = null; } }\nif (!partMeta) partMeta = Object.create(null);\n\nlet oInventoryItemNumber = String(partMeta.InventoryItemNumber || partMeta.ItemNumber || \"\");\nlet oInventoryItemDescription = String(partMeta.InventoryItemDescription || \"\");\nlet totalOnHand = partMeta.TotalOnHandQty != null ? Number(partMeta.TotalOnHandQty) : 0;\nlet totalNeeded = partMeta.ReservationNeededQty != null ? Number(partMeta.ReservationNeededQty) : 0;\nlet totalRequired = partMeta.TotalRequiredQty != null ? Number(partMeta.TotalRequiredQty) : 0;\nlet lineOnHand = partItem.OnHandQty != null ? Number(partItem.OnHandQty) : 0;\nlet onHandSplitCreated = false;\nlet currentWorkOrderId = String(parentEntityId || partItem.svcWorkOrderId || \"\").trim();\nlet sameItemSameWOLineCount = 0;\nlet partLinesForItem = Array.isArray(partMeta.partLines) ? partMeta.partLines : [];\nfor (let pli = 0; pli < partLinesForItem.length; pli++) {\n    let pl = partLinesForItem[pli];\n    if (!pl || typeof pl !== \"object\") continue;\n    let plWoId = String(pl.svcWorkOrderId || pl.ParentEntityId || \"\").trim();\n    if (currentWorkOrderId && plWoId === currentWorkOrderId) sameItemSameWOLineCount++;\n}\nlet suppressCreateForSameItemSameWOMultiline = sameItemSameWOLineCount > 1;\n\n\n// Derive ShipToLocationId (shipLoc) and ShipToPartyId (shipParty) by mapping:\n// (partItem.RequirementLineId + partItem.svcWorkOrderId) -> activities[].items[]\n//\n// Fallbacks:\n// - shipLoc: activities item HRLocationId -> else LOCATION_MAPPINGS[0].HRLocationId -> else null\n// - shipParty: activities item AccountPartyId -> else GET_ACCOUNT_PARTY_ID[0].AccountPartyId -> else null\n\nif (typeof partItem === \"string\") { try { partItem = JSON.parse(partItem); } catch (e) { partItem = null; } }\nif (typeof activities === \"string\") { try { activities = JSON.parse(activities); } catch (e) { activities = []; } }\n\nif (!partItem) partItem = Object.create(null);\nif (!Array.isArray(activities)) activities = [];\n\n// Normalize keys\nlet rid = partItem.RequirementLineId != null ? String(partItem.RequirementLineId).trim() : \"\";\nlet wo = partItem.svcWorkOrderId != null ? String(partItem.svcWorkOrderId).trim() : \"\";\n\n// Defaults (fallbacks)\nlet fallbackLoc = null;\ntry { fallbackLoc = $context.$nodes.LOCATION_MAPPINGS.$output.items[0].HRLocationId; } catch (e) { fallbackLoc = null; }\n\nlet fallbackParty = null;\ntry { fallbackParty = $context.$nodes.RESERVEPARTS.RESERVE_EACH_PART_LINE.GET_ACCOUNT_PARTY_ID.$output.items[0].AccountPartyId; } catch (e) { fallbackParty = null; }\n\n// Find matching activity item\nlet shipLoc = null;\nlet shipParty = null;\n\n\nif (rid && wo) {\n    for (let a = 0; a < activities.length; a++) {\n        let act = activities[a];\n        if (!act) continue;\n\n        let actWo = act.svcWorkOrderId != null ? String(act.svcWorkOrderId).trim() : \"\";\n        if (actWo !== wo) continue;\n\n        let items = Array.isArray(act.items) ? act.items : [];\n        for (let i = 0; i < items.length; i++) {\n            let it = items[i];\n            if (!it) continue;\n\n            let itRid = it.RequirementLineId != null ? String(it.RequirementLineId).trim() : \"\";\n            if (itRid !== rid) continue;\n\n            // Found the exact line\n            shipLoc = it.ShipToLocationId != null ? it.ShipToLocationId : null;\n            shipParty = it.ShipToPartyId != null ? it.ShipToPartyId : null;\n\n            requirementLineDetailId = it.lineDetails?.items?.[0]?.RequirementLineDetailId ?? null;\n            sourceId = it.lineDetails?.items?.[0]?.SourceId ?? null;\n            sourceType = it.lineDetails?.items?.[0]?.sourceType ?? null;\n            break;\n        }\n        if (shipLoc != null || shipParty != null) break;\n    }\n}\n\n// Apply fallbacks\nif (shipLoc == null || shipLoc === \"\") shipLoc = fallbackLoc;\nif (shipParty == null || shipParty === \"\") shipParty = fallbackParty;\n\n// ---------- Build supply index by (subinv|org|invId) ----------\nlet supplyIndex = Object.create(null);\n\nfor (let i = 0; i < supply.length; i++) {\n    let s = supply[i];\n    if (!s) continue;\n\n    let sub = s.SourceSubinventory != null ? String(s.SourceSubinventory).trim() : \"\";\n    let org = s.SourceOrganizationCode != null ? String(s.SourceOrganizationCode).trim() : \"\";\n    let inv = s.InventoryItemId != null ? String(s.InventoryItemId).trim() : \"\";\n\n    if (!sub || !org || !inv) continue;\n\n    let key = sub + \"|\" + org + \"|\" + inv;\n    if (supplyIndex[key] == null) supplyIndex[key] = s;\n}\n\n\n// ---------- chosenSource (blindly follow) ----------\nlet chosen = Array.isArray(partItem.chosenSource) ? partItem.chosenSource : [];\nfor (let i = 0; i < chosen.length; i++) {\n    if (typeof chosen[i] === \"string\") {\n        try { chosen[i] = JSON.parse(chosen[i]); } catch (e) { chosen[i] = null; }\n    }\n}\n\n// ---------- Build parts ----------\nlet parts = [];\nlet partId = 0;\nlet missingChosen = [];\nlet totalAvailable = 0;\n\n\nfor (let i = 0; i < chosen.length; i++) {\n    let c = chosen[i];\n    if (!c) continue;\n\n    let cSub = c.SourceSubinventory != null ? String(c.SourceSubinventory).trim() : \"\";\n    let cOrg = c.SourceOrganizationCode != null ? String(c.SourceOrganizationCode).trim() : \"\";\n    let cInv = c.InventoryItemId != null ? String(c.InventoryItemId).trim() : \"\";\n    let cQty = c.Quantity != null ? Number(c.Quantity) : 0;\n    totalAvailable += cQty;\n\n    if (isNaN(cQty) || cQty <= 0) continue;\n    if (!cSub || !cOrg || !cInv) continue;\n\n    let key = cSub + \"|\" + cOrg + \"|\" + cInv;\n    let s = supplyIndex[key] || null;\n\n    // ---------- MISSING SOURCE: update + optional create ----------\n    if (s && requirementLineDetailId != null) {\n        let uomCode = String(s.UOMCode || \"\");\n\n        if (isNaN(totalOnHand)) totalOnHand = 0;\n\n        // --- UPDATE: always, with full cQty ---\n        let updateObj = Object.create(null);\n        updateObj.payload = Object.create(null);\n        updateObj.payload.lineDetails = Object.create(null);\n        updateObj.payload.lineDetails.items = [];\n\n        let ldUpdate = Object.create(null);\n        ldUpdate.ExpectedArrivalDate = String(s.ExpectedArrivalDate || \"\");\n        ldUpdate.ExpectedShipDate = String(s.ExpectedShipDate || \"\");\n\n\n        if (partId === 0) ldUpdate.RequirementLineId = requirementLineId;\n        ldUpdate.RequirementLineDetailId = requirementLineDetailId;\n        ldUpdate.SourceCarrierId = s.SourceCarrierId != null ? s.SourceCarrierId : null;\n        ldUpdate.SourceId = sourceId;\n        ldUpdate.SourceModeOfTransport = s.SourceModeOfTransport != null ? s.SourceModeOfTransport : null;;\n        ldUpdate.SourceOrganizationId = String(s.SourceOrganizationId || \"\");;\n        ldUpdate.SourceServiceLevels = s.SourceServiceLevels != null ? s.SourceServiceLevels : null;;\n        ldUpdate.SourceSubinventory = String(s.SourceSubinventory || \"\");;\n        ldUpdate.SourceType = sourceType;\n        updateObj.payload.lineDetails.items.push(ldUpdate);\n\n        updateObj.payload.DestinationOrganizationId = destOrgId;\n        updateObj.payload.DestinationSubinventory = destSub;\n        updateObj.payload.InventoryItemId = cInv;\n        updateObj.payload.InventoryItemNumber = oInventoryItemNumber;\n        updateObj.payload.ItemRevision = null;\n        updateObj.payload.NeedByDate = needByDate;\n        updateObj.payload.ParentEntityCode = \"WO\";\n        updateObj.payload.ParentEntityId = parentEntityId;\n        updateObj.payload.Quantity = String(cQty);\n        updateObj.payload.RequirementHeaderId = requirementHeaderId;\n        if (partId === 0) updateObj.payload.RequirementLineId = requirementLineId;\n        updateObj.payload.RequirementLineLinkId = null;\n        updateObj.payload.ShipToAddressType = \"CUSTOMER\";\n        updateObj.payload.ShipToContactId = null;\n        updateObj.payload.ShipToLocationId = shipLoc;\n        updateObj.payload.ShipToPartyId = shipParty;\n        updateObj.payload.UOMCode = uomCode;\n\n        updateObj.id = String(partId);\n        updateObj.operation = \"update\";\n        updateObj.path = \"/partRequirementLines/\" + requirementLineId;\n        parts.push(updateObj);\n        partId++;\n\n        if (!isNaN(lineOnHand) && lineOnHand > 0 && !onHandSplitCreated && !suppressCreateForSameItemSameWOMultiline) {\n            let createObj = Object.create(null);\n            createObj.payload = Object.create(null);\n            createObj.payload.lineDetails = Object.create(null);\n            createObj.payload.lineDetails.items = [];\n\n            let ldCreate = Object.create(null);\n            ldCreate.SourceOrganizationId = \"-1\";\n            createObj.payload.lineDetails.items.push(ldCreate);\n\n            createObj.payload.DestinationOrganizationId = destOrgId;\n            createObj.payload.DestinationSubinventory = destSub;\n            createObj.payload.InventoryItemId = cInv;\n            createObj.payload.InventoryItemNumber = oInventoryItemNumber;\n            createObj.payload.ItemRevision = null;\n            createObj.payload.NeedByDate = needByDate;\n            createObj.payload.ParentEntityCode = \"WO\";\n            createObj.payload.ParentEntityId = parentEntityId;\n            createObj.payload.Quantity = String(lineOnHand);\n            createObj.payload.RequirementHeaderId = requirementHeaderId;\n            createObj.payload.RequirementLineLinkId = null;\n            createObj.payload.ShipToAddressType = \"CUSTOMER\";\n            createObj.payload.ShipToContactId = null;\n            createObj.payload.ShipToLocationId = shipLoc;\n            createObj.payload.ShipToPartyId = shipParty;\n            createObj.payload.UOMCode = uomCode;\n\n            createObj.id = String(partId);\n            createObj.operation = \"create\";\n            createObj.path = \"/partRequirementLines\";\n            parts.push(createObj);\n            partId++;\n            onHandSplitCreated = true;\n        }\n\n        continue;\n    }\n\n    if (!s) {\n        let miss = Object.create(null);\n        miss.SourceSubinventory = cSub;\n        miss.SourceOrganizationCode = cOrg;\n        miss.InventoryItemId = cInv;\n        miss.Quantity = cQty;\n        missingChosen.push(miss);\n        continue;\n    }\n\n\n    let inventoryItemId = String(s.InventoryItemId || cInv || \"\");\n    let inventoryItemNumber = String(s.InventoryItemNumber || oInventoryItemNumber || \"\");\n    let uomCode = String(s.UOMCode || \"\");\n    let allowCreateForAdditionalSplits = !suppressCreateForSameItemSameWOMultiline;\n    let op = partId === 0 ? \"upsert\" : (allowCreateForAdditionalSplits ? \"create\" : \"update\");\n    let path = partId === 0\n        ? (\"/partRequirementLines/\" + requirementLineId)\n        : (allowCreateForAdditionalSplits ? \"/partRequirementLines\" : (\"/partRequirementLines/\" + requirementLineId));\n\n    let obj = Object.create(null);\n    obj.payload = Object.create(null);\n    obj.payload.lineDetails = Object.create(null);\n    obj.payload.lineDetails.items = [];\n\n    let ld = Object.create(null);\n    ld.ExpectedArrivalDate = String(s.ExpectedArrivalDate || \"\");\n    ld.ExpectedShipDate = String(s.ExpectedShipDate || \"\");\n    if (partId === 0) ld.RequirementLineId = requirementLineId;\n    ld.SourceCarrierId = s.SourceCarrierId != null ? s.SourceCarrierId : null;\n    ld.SourceId = sourceId;\n    ld.SourceModeOfTransport = s.SourceModeOfTransport != null ? s.SourceModeOfTransport : null;\n    ld.SourceOrganizationId = String(s.SourceOrganizationId || \"\");\n    ld.SourceServiceLevels = s.SourceServiceLevels != null ? s.SourceServiceLevels : null;\n    ld.SourceSubinventory = String(s.SourceSubinventory || \"\");\n    ld.SourceType = sourceType;\n    obj.payload.lineDetails.items.push(ld);\n\n    obj.payload.AssetId = null;\n    obj.payload.BillToAccountId = null;\n    obj.payload.BillToPartyId = null;\n    obj.payload.BillToPartySiteId = null;\n    obj.payload.BusinessProcessCode = null;\n    obj.payload.DestinationOrganizationId = destOrgId;\n    obj.payload.DestinationSubinventory = destSub;\n    obj.payload.InventoryItemId = inventoryItemId;\n    obj.payload.InventoryItemNumber = inventoryItemNumber;\n    obj.payload.ItemRevision = null;\n    obj.payload.NeedByDate = needByDate;\n    obj.payload.ParentEntityCode = \"WO\";\n    obj.payload.ParentEntityId = parentEntityId;\n    obj.payload.Quantity = String(cQty);\n    obj.payload.RepriceFlag = null;\n    obj.payload.RequirementHeaderId = requirementHeaderId;\n    if (partId === 0) obj.payload.RequirementLineId = requirementLineId;\n    obj.payload.RequirementLineLinkId = null;\n    obj.payload.ReturnFromPartyId = null;\n    obj.payload.ReturnFromPartySiteId = null;\n    obj.payload.ServiceActivityId = null;\n    obj.payload.ShipToAddressType = \"CUSTOMER\";\n    obj.payload.ShipToContactId = null;\n    obj.payload.ShipToLocationId = shipLoc;\n    obj.payload.ShipToPartyId = shipParty;\n    obj.payload.UOMCode = uomCode;\n\n    obj.id = String(partId);\n    obj.operation = op;\n    obj.path = path;\n\n    parts.push(obj);\n    partId++;\n\n}\n\n// ---------- Output ----------\nlet out = Object.create(null);\nout.result = Object.create(null);\nout.result.parts = parts;\nout.InventoryItemNumber = oInventoryItemNumber;\nout.InventoryItemDescription = oInventoryItemDescription;\n\nif (missingChosen.length > 0) { // when on stocking source doesn't have enough supplies.\n    out.error = \"NO_MATCHING_SOURCE\";\n    out.message = \"Some chosenSource entries did not match any supply row.\";\n    out.missingChosen = missingChosen;\n} else {\n    out.error = \"SUPPLY\";\n    out.message = \"\";\n}\n\nreturn out;\n\n"
                          },
