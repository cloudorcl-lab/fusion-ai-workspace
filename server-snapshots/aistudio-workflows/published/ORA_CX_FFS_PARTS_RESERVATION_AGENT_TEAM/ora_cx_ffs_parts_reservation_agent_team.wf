          "id": "1775554478893",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1767793439921",
            "name": "Build Reservation Response",
            "returnType": "object",
            "sourceCode": "var evaluatedRows = $context.$nodes.EVALUATE_RESERVATIONS.$output.result.rows || [];\nvar groupedItemsByStatus = {\n  r: {},\n  s: {},\n  n: {}\n};\nvar displayOnHandByItem = {};\n\n// Aggregate evaluated line decisions into response buckets while rolling one shared display on-hand pool per item.\nfor (var rowIndex = 0; rowIndex < evaluatedRows.length; rowIndex++) {\n  var row = evaluatedRows[rowIndex];\n  var bucket = groupedItemsByStatus[row.k];\n  var itemNumber = row.i || \"\";\n  var requiredQty = +row.r || 0;\n  var lineShortage = 0;\n\n  if (!bucket || !itemNumber) {\n    continue;\n  }\n\n  if (requiredQty < 0) {\n    requiredQty = 0;\n  }\n\n  if (displayOnHandByItem[itemNumber] === undefined) {\n    var initialOnHand = +row.o || 0;\n    displayOnHandByItem[itemNumber] = initialOnHand > 0 ? initialOnHand : 0;\n  }\n\n  var availableOnHand = displayOnHandByItem[itemNumber] || 0;\n\n  if (row.k === \"r\" || row.k === \"s\") {\n    lineShortage = requiredQty > availableOnHand\n      ? requiredQty - availableOnHand\n      : 0;\n  }\n\n  displayOnHandByItem[itemNumber] = availableOnHand > requiredQty\n    ? availableOnHand - requiredQty\n    : 0;\n\n  var itemGroup = bucket[itemNumber];\n\n  if (!itemGroup) {\n    itemGroup = {\n      ItemNumber: itemNumber,\n      InventoryItemDescription: row.d || itemNumber + \"_Desc\",\n      TotalRequiredQty: 0,\n      TotalOnHandQty: availableOnHand,\n      ReservationNeededQty: 0,\n      UOMCode: row.u || \"Ea\",\n      partLines: [],\n      reason: row.k === \"n\"\n        ? \"Technician on-hand quantity is sufficient; no reservation is needed.\"\n        : row.k === \"r\"\n          ? \"Reserved using the nearest valid stocking source set while minimizing pickup sources for the activity.\"\n          : row.b\n            ? \"Activity skipped because at least one required part is short and the work order includes a non-open status line.\"\n            : \"Activity skipped because at least one required part could not be fully fulfilled.\"\n    };\n    bucket[itemNumber] = itemGroup;\n  }\n\n  itemGroup.TotalRequiredQty += requiredQty;\n\n  if (row.k === \"r\" || row.k === \"s\") {\n    itemGroup.ReservationNeededQty += lineShortage;\n  }\n\n  itemGroup.partLines.push({\n    NeedByDate: row.t,\n    RequirementLineId: row.q,\n    ActivityId: row.a,\n    svcWorkOrderId: row.w,\n    WoNumber: row.n,\n    OnHandQty: availableOnHand,\n    chosenSource: row.k === \"n\" ? [] : row.c\n  });\n}\n\nvar response = {\n  reservation_needed_items: [],\n  notGoingToBeReserved: [],\n  noReservationNeeded: []\n};\n\nfor (var itemNumberKey in groupedItemsByStatus.r) {\n  response.reservation_needed_items.push(groupedItemsByStatus.r[itemNumberKey]);\n}\n\nfor (itemNumberKey in groupedItemsByStatus.s) {\n  response.notGoingToBeReserved.push(groupedItemsByStatus.s[itemNumberKey]);\n}\n\nfor (itemNumberKey in groupedItemsByStatus.n) {\n  response.noReservationNeeded.push(groupedItemsByStatus.n[itemNumberKey]);\n}\n\nreturn response;\n"
          },
