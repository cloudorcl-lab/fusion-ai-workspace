  "name": "Parts Reservation Agent Team",
  "description": "Provides information about missing parts that are required by Field Service mobile worker for the day and automatically reserves items at the nearest stocking location.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
