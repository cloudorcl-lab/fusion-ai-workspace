        {
          "metadata": {
            "name": "Generic Exception Handler",
            "returnType": "object",
            "sourceCode": "let nodes = $context && $context.$nodes ? $context.$nodes : Object.create(null);\n\nlet msgs = [];\nlet keys = Object.keys(nodes);\n\nfor (let i = 0; i < keys.length; i++) {\n  let name = keys[i];\n  let n = nodes[name];\n\n  if (!n) continue;\n\n  let status = n.$status != null ? String(n.$status) : \"\";\n  let err = n.$error != null ? n.$error : null;\n\n  let info = \"\";\n  let code = \"\";\n\n  if (err) {\n    if (err.$info != null && String(err.$info).trim()) info = String(err.$info).trim();\n    if (err.$code != null && String(err.$code).trim()) code = String(err.$code).trim();\n    if (!info && err.info != null && String(err.info).trim()) info = String(err.info).trim();\n    if (!code && err.code != null && String(err.code).trim()) code = String(err.code).trim();\n  }\n\n  if (!info && status && status.toLowerCase() === \"failure\") info = \"Node failed\";\n\n  if (info) {\n    let line = name + \": \" + info;\n    if (code) line = line + \" (code: \" + code + \")\";\n    msgs.push(line);\n  }\n}\n\nlet out = Object.create(null);\n\nif (msgs.length > 0) {\n  out.error = true;\n  out.message = String(($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input && $context.$triggers.REST.$input.PartyId) || \"\") + \" Trace Id: \" + String(($context.$workflow && $context.$workflow.$traceId) || \"\") + \" Errors: \" + msgs.join(\" | \");\n} else {\n  out.error = true;\n  out.message = String(($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input && $context.$triggers.REST.$input.PartyId) || \"\") + \" Trace Id: \" +    String(($context.$workflow && $context.$workflow.$traceId) || \"\");\n}\n\nreturn out;"
          },
          "outcomes": {
            "success": "1767936702711"
          },
          "code": "GENERIC_EXCEPTION_HANDLER",
