          "metadata": {
            "errorNodeId": "1767793439921",
            "name": "Technician On Hand JSON Formatter",
            "returnType": "object",
            "sourceCode": "let results = $context.$nodes.COLLECT_ALL_ON_HAND_ITEMS.$output;\n\nif (!Array.isArray(results)) {\n  results = [];\n}\n\nfor (let i = 0; i < results.length; i++) {\n  let r = results[i];\n\n  if (typeof r === \"string\") {\n    try { r = JSON.parse(r); } catch (e) {}\n  }\n\n  if (r && typeof r.result === \"string\") {\n    try { r.result = JSON.parse(r.result); } catch (e) {}\n  }\n\n  results[i] = r;\n}\n\nreturn results;"
          },
          "outcomes": {
