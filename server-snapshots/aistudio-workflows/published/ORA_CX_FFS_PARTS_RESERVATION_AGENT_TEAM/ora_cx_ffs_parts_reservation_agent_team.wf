            "name": "Activities JSON Formatter",
            "returnType": "object",
            "sourceCode": "let results = $context.$nodes.PROCESS_ALL_WORK_ACTIVITIES.$output;\nif (!Array.isArray(results)) results = [];\n\nfor (let i = 0; i < results.length; i++) {\n  let r = results[i];\n  if (typeof r === \"string\") { try { r = JSON.parse(r); } catch (e) {} }\n  if (r && typeof r.result === \"string\") { try { r.result = JSON.parse(r.result); } catch (e) {} }\n  results[i] = r;\n}\n\nif (typeof results === \"string\") results = JSON.parse(results);\nif (!Array.isArray(results)) input = [];\n\nlet validResults = [];\nfor (let i = 0; i < results.length; i++) {\n  let el = results[i];\n  if (el && typeof el === \"object\" && el.result && typeof el.result === \"object\" && Array.isArray(el.result.items)) validResults.push(el.result);\n}\n\nvalidResults.sort((a, b) => Date.parse(a.startTime || \"\") - Date.parse(b.startTime || \"\"));\nreturn validResults;"
          },
