                        {
                          "metadata": {
                            "name": "Set Stocking Locations",
                            "returnType": "object",
                            "sourceCode": "let out = Object.create(null);\nout.stockingLocation = Object.create(null);\nout.stockingLocation = []\n\nlet stLocs = Array.isArray($context.$nodes.GET_NEAR_BY_WH_FROM_WO.FOR_EACH_PART_UNDER_WO.GETSTOCKINGLOCATIONS.$output.result) ? $context.$nodes.GET_NEAR_BY_WH_FROM_WO.FOR_EACH_PART_UNDER_WO.GETSTOCKINGLOCATIONS.$output.result : [];\n\nfor (let i = 0; i < stLocs.length; i++) {\n    let stLoc = stLocs[i];\n    let stockingSource = Object.create(null);\n    let availQuantity = Number(stLoc && stLoc.SuppliedQuantity ? stLoc.SuppliedQuantity : 0);\n    if (availQuantity <= 0) continue;\n    stockingSource.InventoryItemId = stLoc.InventoryItemId;\n    stockingSource.InventoryItemNumber = stLoc.InventoryItemNumber;\n    stockingSource.SourceSubinventory = stLoc.SourceSubinventory; \n    stockingSource.RequirementLineId = $context.$nodes.GET_NEAR_BY_WH_FROM_WO.FOR_EACH_PART_UNDER_WO.$currentItem.RequirementLineId;\n    stockingSource.InventoryItemDescription = stLoc.InventoryItemDescription;\n    stockingSource.SourceOrganizationId = stLoc.SourceOrganizationId;\n    stockingSource.SourceOrganizationCode = stLoc.SourceOrganizationCode;\n    stockingSource.RequiredQuantity = stLoc.RequiredQuantity;\n    stockingSource.SuppliedQuantity = availQuantity;\n    stockingSource.SourceOrganizationCode = stLoc.SourceOrganizationCode;\n    stockingSource.UOMCode = stLoc.UOMCode;\n    stockingSource.UnitOfMeasure = stLoc.UnitOfMeasure;\n    stockingSource.SourceType = stLoc.SourceType;\n    stockingSource.Distance = Number(stLoc && stLoc.Distance ? stLoc.Distance : 5);\n    out.stockingLocation.push(stockingSource);\n}\n\nreturn out;"
                          },
