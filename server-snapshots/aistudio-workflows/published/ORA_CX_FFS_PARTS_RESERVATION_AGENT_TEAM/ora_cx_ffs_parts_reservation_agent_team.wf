            "returnType": "object",
            "sourceCode": "var parseResult = $context.$nodes.PARSE_REQUIREMENT_ROWS.$output.result;\nvar rows = parseResult.rs || [];\nvar onHandMap = parseResult.m || {};\nvar activityMap = {};\nvar activityIds = [];\nvar rawOnHandMap = {};\nvar sourceSupplyMap = {};\n\n// Group rows by activity while preserving the compact payload contract used later.\nfor (var rowIndex = 0; rowIndex < rows.length; rowIndex++) {\n  var row = rows[rowIndex];\n  var sourceKey = row.i + \"|\" + row.ii + \"|\" + row.su + \"|\" + row.og;\n\n  if (!row.q || !row.i) {\n    continue;\n  }\n\n  if (rawOnHandMap[row.i] === undefined) {\n    rawOnHandMap[row.i] = +(onHandMap[row.i] === undefined ? 0 : onHandMap[row.i]);\n  }\n\n  if (sourceSupplyMap[sourceKey] === undefined || sourceSupplyMap[sourceKey] < row.sq) {\n    sourceSupplyMap[sourceKey] = +row.sq;\n  }\n\n  var activity = activityMap[row.a];\n  if (!activity) {\n    activity = {\n      t: row.t,\n      w: row.w,\n      b: 0,\n      o: [],\n      l: {}\n    };\n    activityMap[row.a] = activity;\n\n    for (\n      var activityInsertIndex = activityIds.length;\n      activityInsertIndex > 0 && String(activityMap[activityIds[activityInsertIndex - 1]].t) > String(row.t);\n      activityInsertIndex--\n    ) {\n      activityIds[activityInsertIndex] = activityIds[activityInsertIndex - 1];\n    }\n    activityIds[activityInsertIndex] = row.a;\n  }\n\n  var line = activity.l[row.q];\n  if (!line) {\n    line = {\n      t: row.t,\n      w: row.w,\n      n: row.n,\n      a: row.a,\n      q: row.q,\n      i: row.i,\n      d: row.d,\n      r: row.r,\n      u: row.u,\n      p: []\n    };\n    activity.l[row.q] = line;\n    activity.o.push(row.q);\n  }\n\n  line.p.push(row);\n\n  if (row.sc && row.sc !== \"OP\" && row.sc !== \"OPEN\" && row.sc !== \"RESERVATION_CANCELED\" && row.sc !== \"NULL\") {\n    activity.b = 1;\n  }\n}\n\nvar activityState = {\n  ao: activityIds,\n  acts: activityMap,\n  raw: rawOnHandMap,\n  sm: sourceSupplyMap\n};\n\nreturn activityState;"
