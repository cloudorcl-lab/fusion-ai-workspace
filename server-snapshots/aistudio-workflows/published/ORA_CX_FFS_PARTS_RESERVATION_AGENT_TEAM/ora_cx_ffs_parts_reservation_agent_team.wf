          "metadata": {
            "errorNodeId": "1767793439921",
            "name": "Evaluate Reservations",
            "returnType": "object",
            "sourceCode": "var stateResult = $context.$nodes.BUILD_ACTIVITY_STATE.$output.result;\nvar activityIds = stateResult.ao || [];\nvar activityMap = stateResult.acts || {};\nvar rawOnHandMap = stateResult.raw || {};\nvar sourceSupplyMap = stateResult.sm || {};\nvar remainingOnHandMap = {};\nvar evaluatedRows = [];\n\nfor (var itemNumber in rawOnHandMap) {\n  remainingOnHandMap[itemNumber] = rawOnHandMap[itemNumber] > 0 ? rawOnHandMap[itemNumber] : 0;\n}\n\n// Evaluate each activity in order so on-hand and source consumption stay deterministic.\nfor (var activityIndex = 0; activityIndex < activityIds.length; activityIndex++) {\n  var activity = activityMap[activityIds[activityIndex]];\n  var tentativeOnHandMap = {};\n  var tentativeSourceUsageMap = {};\n  var shortageLines = [];\n  var allLines = [];\n  var shouldSkipActivity = 0;\n  var hasBlockedStatus = activity.b ? 1 : 0;\n\n  for (var lineOrderIndex = 0; lineOrderIndex < activity.o.length; lineOrderIndex++) {\n    var line = activity.l[activity.o[lineOrderIndex]];\n    var availableOnHand = tentativeOnHandMap[line.i];\n\n    if (availableOnHand === undefined) {\n      availableOnHand = remainingOnHandMap[line.i] || 0;\n    }\n\n    allLines.push(line);\n    line.m = 0;\n    line.c = [];\n    line.k = availableOnHand >= line.r ? \"n\" : \"r\";\n\n    if (line.k === \"n\") {\n      tentativeOnHandMap[line.i] = availableOnHand - line.r;\n    } else {\n      line.m = line.r - availableOnHand;\n      tentativeOnHandMap[line.i] = 0;\n      shortageLines.push(line);\n    }\n  }\n\n  if (shortageLines.length && hasBlockedStatus) {\n    shouldSkipActivity = 1;\n  }\n\n  var supplyGroupCandidates = [];\n\n  for (lineOrderIndex = 0; lineOrderIndex < shortageLines.length; lineOrderIndex++) {\n    line = shortageLines[lineOrderIndex];\n    line.v = [];\n\n    for (var partIndex = 0; partIndex < line.p.length; partIndex++) {\n      var part = line.p[partIndex];\n      var distance = +part.di;\n      var sourceSubinventory = part.su;\n      var sourceOrganization = part.og;\n      var availableSupply = sourceSupplyMap[\n        part.i + \"|\" + part.ii + \"|\" + sourceSubinventory + \"|\" + sourceOrganization\n      ] || 0;\n      var sourcePriority = part.ty === \"SITE_DDCTD\"\n        ? 3\n        : part.ty === \"REPLENISH\"\n          ? 2\n          : part.ty === \"MANUFACTURING\"\n            ? 1\n            : 0;\n\n      if (\n        !(availableSupply > 0) ||\n        isNaN(distance) ||\n        !sourceSubinventory ||\n        sourceSubinventory === \"-\" ||\n        !sourceOrganization ||\n        sourceOrganization === \"-\"\n      ) {\n        continue;\n      }\n\n      var supplyOption = {\n        k: part.i + \"|\" + part.ii + \"|\" + sourceSubinventory + \"|\" + sourceOrganization,\n        l: sourceSubinventory + \"|\" + sourceOrganization,\n        d: distance,\n        y: sourcePriority,\n        q: availableSupply,\n        ii: part.ii,\n        su: sourceSubinventory,\n        og: sourceOrganization\n      };\n\n      for (\n        var optionInsertIndex = line.v.length;\n        optionInsertIndex > 0 && (\n          line.v[optionInsertIndex - 1].d > distance ||\n          (\n            line.v[optionInsertIndex - 1].d === distance && (\n              line.v[optionInsertIndex - 1].y < sourcePriority ||\n              (\n                line.v[optionInsertIndex - 1].y === sourcePriority &&\n                line.v[optionInsertIndex - 1].q < availableSupply\n              )\n            )\n          )\n        );\n        optionInsertIndex--\n      ) {\n        line.v[optionInsertIndex] = line.v[optionInsertIndex - 1];\n      }\n\n      line.v[optionInsertIndex] = supplyOption;\n\n      if (supplyGroupCandidates.indexOf(supplyOption.l) < 0) {\n        supplyGroupCandidates.push(supplyOption.l);\n      }\n    }\n\n    if (!line.v.length) {\n      shouldSkipActivity = 1;\n    }\n  }\n\n  var sharedSupplyGroup = \"\";\n  if (!shouldSkipActivity && shortageLines.length > 1) {\n    for (\n      var supplyGroupCandidateIndex = 0;\n      supplyGroupCandidateIndex < supplyGroupCandidates.length && !sharedSupplyGroup;\n      supplyGroupCandidateIndex++\n    ) {\n      var canUseSingleSupplyGroup = 1;\n\n      for (partIndex = 0; partIndex < shortageLines.length; partIndex++) {\n        var availableFromSupplyGroup = 0;\n        var supplyOptions = shortageLines[partIndex].v;\n\n        for (optionInsertIndex = 0; optionInsertIndex < supplyOptions.length; optionInsertIndex++) {\n          if (supplyOptions[optionInsertIndex].l === supplyGroupCandidates[supplyGroupCandidateIndex]) {\n            availableFromSupplyGroup += supplyOptions[optionInsertIndex].q - (tentativeSourceUsageMap[supplyOptions[optionInsertIndex].k] || 0);\n          }\n        }\n\n        if (availableFromSupplyGroup < shortageLines[partIndex].m) {\n          canUseSingleSupplyGroup = 0;\n          break;\n        }\n      }\n\n      if (canUseSingleSupplyGroup) {\n        sharedSupplyGroup = supplyGroupCandidates[supplyGroupCandidateIndex];\n      }\n    }\n  }\n\n  if (!shouldSkipActivity) {\n    for (lineOrderIndex = 0; lineOrderIndex < shortageLines.length; lineOrderIndex++) {\n      line = shortageLines[lineOrderIndex];\n\n      for (\n        var remainingNeed = line.m, optionIndex = 0;\n        optionIndex < line.v.length && remainingNeed > 0;\n        optionIndex++\n      ) {\n        var selectedOption = line.v[optionIndex];\n        var remainingSupply = selectedOption.q - (tentativeSourceUsageMap[selectedOption.k] || 0);\n\n        if (remainingSupply < 1 || (sharedSupplyGroup && selectedOption.l !== sharedSupplyGroup)) {\n          continue;\n        }\n\n        var allocatedQuantity = remainingSupply < remainingNeed ? remainingSupply : remainingNeed;\n        tentativeSourceUsageMap[selectedOption.k] = (tentativeSourceUsageMap[selectedOption.k] || 0) + allocatedQuantity;\n        remainingNeed -= allocatedQuantity;\n\n        line.c.push({\n          InventoryItemId: selectedOption.ii,\n          Distance: String(selectedOption.d),\n          SourceSubinventory: selectedOption.su,\n          SourceOrganizationCode: selectedOption.og,\n          Quantity: allocatedQuantity\n        });\n      }\n\n      if (remainingNeed > 0) {\n        shouldSkipActivity = 1;\n      }\n    }\n  }\n\n  if (!shouldSkipActivity) {\n    for (itemNumber in tentativeOnHandMap) {\n      remainingOnHandMap[itemNumber] = tentativeOnHandMap[itemNumber];\n    }\n\n    for (var sourceKey in tentativeSourceUsageMap) {\n      sourceSupplyMap[sourceKey] -= tentativeSourceUsageMap[sourceKey];\n    }\n  }\n\n  for (lineOrderIndex = 0; lineOrderIndex < allLines.length; lineOrderIndex++) {\n    line = allLines[lineOrderIndex];\n    evaluatedRows.push({\n      k: shouldSkipActivity ? \"s\" : line.k,\n      i: line.i,\n      d: line.d,\n      u: line.u,\n      t: line.t,\n      q: line.q,\n      a: line.a,\n      w: line.w,\n      n: line.n,\n      r: line.r,\n      o: rawOnHandMap[line.i] === undefined ? 0 : rawOnHandMap[line.i],\n      m: line.m,\n      c: shouldSkipActivity ? [] : line.c,\n      b: hasBlockedStatus\n    });\n  }\n}\n\nvar evaluationResult = {\n  rows: evaluatedRows\n};\n\nreturn evaluationResult;"
          },
