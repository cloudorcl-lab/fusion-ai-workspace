        {
          "metadata": {
            "errorNodeId": "1767793439921",
            "name": "Prep Formatter JSON For No Reserve",
            "returnType": "object",
            "sourceCode": "const reservationResponse = $context.$nodes.BUILD_RESERVATION_RESPONSE.$output.result || {};\n\nconst output = {\n  title: \"## Missing Required Parts\",\n  hasOutput: false,\n  result: {\n    reserved_items: [],\n    reservation_needed_items: [],\n    notGoingToBeReserved: [],\n    noReservationNeeded: [],\n    output_map: []\n  }\n};\n\nconst aggregatedItems = {};\n\nconst sections = {\n  reserved_items: [reservationResponse.reserved_items || [], \"RESERVED\", \"Reserved\"],\n  reservation_needed_items: [reservationResponse.reservation_needed_items || [], \"NOT_RESERVED\", \"Not Reserved\"],\n  notGoingToBeReserved: [reservationResponse.notGoingToBeReserved || [], \"NOT_RESERVED\", \"Not Reserved\"],\n  noReservationNeeded: [reservationResponse.noReservationNeeded || [], \"SKIP\", \"\"]\n};\n\nfor (const sectionKey in sections) {\n  const [items, action, status] = sections[sectionKey];\n  for (let i = 0; i < items.length; i++) {\n    const item = items[i];\n    const partLines = item.partLines || [];\n    let description = (item.InventoryItemDescription || \"\") + \"\";\n    const totalRequiredQty = +item.TotalRequiredQty || 0;\n    const totalOnHandQty = +item.TotalOnHandQty || 0;\n    const reservationNeededQty = +item.ReservationNeededQty || 0;\n    const shortageQty = totalRequiredQty - totalOnHandQty;\n\n    const requiredQty = action === \"RESERVED\"\n      ? (reservationNeededQty || totalRequiredQty || 0)\n      : (reservationNeededQty > 0 ? reservationNeededQty : shortageQty > 0 ? shortageQty : 0);\n\n    const workOrders = [];\n    const workOrderSet = {};\n\n    description = description ? description.replace(/_Desc$/, \"\") : item.ItemNumber || \"\";\n\n    for (let j = 0; j < partLines.length; j++) {\n      const woNumber = partLines[j].WoNumber || partLines[j].svcWorkOrderId || \"\";\n      if (woNumber && !workOrderSet[woNumber]) {\n        workOrderSet[woNumber] = true;\n        workOrders.push(woNumber);\n      }\n    }\n\n    const formattedItem = {\n      ItemNumber: item.ItemNumber || \"\",\n      InventoryItemDescription: description,\n      UOMCode: item.UOMCode || \"Ea\",\n      TotalRequiredQty: totalRequiredQty,\n      TotalOnHandQty: totalOnHandQty,\n      ReservationNeededQty: reservationNeededQty,\n      RequiredQty: requiredQty,\n      NormalizedStatus: status,\n      Action: action,\n      partLines: partLines,\n      workOrders: workOrders\n    };\n\n    output.result[sectionKey].push(formattedItem);\n\n    if (action !== \"SKIP\" && requiredQty > 0) {\n      const mapKey = formattedItem.ItemNumber + \"|\" + action;\n      const mapEntry = aggregatedItems[mapKey] || (aggregatedItems[mapKey] = {\n        ItemNumber: formattedItem.ItemNumber,\n        InventoryItemDescription: formattedItem.InventoryItemDescription,\n        UOMCode: formattedItem.UOMCode,\n        RequiredQty: 0,\n        Action: action,\n        NormalizedStatus: status,\n        WOs: []\n      });\n\n      var reservedQtyFromChosenSource = 0;\n\n\n      if (action === \"RESERVED\") {\n        for (var partLineIndex = 0; partLineIndex < partLines.length; partLineIndex++) {\n          var chosenSource = Array.isArray(partLines[partLineIndex] && partLines[partLineIndex].chosenSource)\n            ? partLines[partLineIndex].chosenSource\n            : [];\n\n\n          for (var chosenSourceIndex = 0; chosenSourceIndex < chosenSource.length; chosenSourceIndex++) {\n            var chosen = chosenSource[chosenSourceIndex] || {};\n            var qty = Number(chosen.Quantity);\n            var sourceSubinventory = (chosen.SourceSubinventory || \"\") + \"\";\n            var sourceOrganizationCode = (chosen.SourceOrganizationCode || \"\") + \"\";\n            if (!isNaN(qty) && qty > 0) {\n              reservedQtyFromChosenSource += qty;\n              if (!mapEntry.SourceSubinventory && sourceSubinventory && sourceSubinventory !== \"-\") {\n                mapEntry.SourceSubinventory = sourceSubinventory;\n              }\n              if (!mapEntry.SourceOrganizationCode && sourceOrganizationCode && sourceOrganizationCode !== \"-\") {\n                mapEntry.SourceOrganizationCode = sourceOrganizationCode;\n              }\n            }\n          }\n        }\n      }\n\n\n      var mapContribution = action === \"RESERVED\" && reservedQtyFromChosenSource > 0\n        ? reservedQtyFromChosenSource\n        : requiredQty;\n\n\n      mapEntry.RequiredQty += mapContribution;\n\n      const woPresence = {};\n      for (let k = 0; k < mapEntry.WOs.length; k++) {\n        woPresence[mapEntry.WOs[k]] = true;\n      }\n\n      for (let k = 0; k < workOrders.length; k++) {\n        if (!woPresence[workOrders[k]]) {\n          mapEntry.WOs.push(workOrders[k]);\n        }\n      }\n    }\n  }\n}\n\nfor (const key in aggregatedItems) {\n  output.result.output_map.push(aggregatedItems[key]);\n}\n\noutput.hasOutput = output.result.output_map.length > 0;\n\nif (!output.hasOutput) {\n  output.title = \"\";\n}\n\nreturn output;\n"
          },
