            "errorNodeId": "1767793439921",
            "name": "Parse Requirement Rows",
            "returnType": "object",
            "sourceCode": "var onHandMap = $context.$variables.onHandMap || {};\nvar markdown = $context.$nodes.SHOW_MD_TABLE.$output.result.markdown || \"\";\nvar markdownLines = markdown.split(/\\r?\\n/);\nvar headers = [];\nvar parsedRows = [];\n\nif (typeof onHandMap === \"string\") {\n  onHandMap = JSON.parse(onHandMap || \"{}\");\n}\n\n// Parse markdown table rows into the compact record shape used downstream.\nfor (var lineIndex = 0; lineIndex < markdownLines.length; lineIndex++) {\n  var lineText = markdownLines[lineIndex].trim();\n  if (!lineText || lineText.charAt(0) !== \"|\") {\n    continue;\n  }\n\n  var rawCells = lineText.split(\"|\");\n  var cells = [];\n  for (var cellIndex = 1; cellIndex < rawCells.length - 1; cellIndex++) {\n    cells.push(rawCells[cellIndex].trim());\n  }\n\n  var isSeparator = 1;\n  for (cellIndex = 0; cellIndex < cells.length; cellIndex++) {\n    if (cells[cellIndex].replace(/[-: ]/g, \"\")) {\n      isSeparator = 0;\n      break;\n    }\n  }\n\n  if (isSeparator) {\n    continue;\n  }\n\n  if (!headers.length) {\n    headers = cells;\n    continue;\n  }\n\n  var row = {};\n  for (cellIndex = 0; cellIndex < headers.length && cellIndex < cells.length; cellIndex++) {\n    row[headers[cellIndex]] = cells[cellIndex];\n  }\n\n  var statusCode = ((\n    row.StatusCode ||\n    row[\"Status Code\"] ||\n    row.RequirementStatusCode ||\n    row[\"Line Status\"] ||\n    \"\"\n  ) + \"\").trim().toUpperCase();\n\n  if (statusCode === \"—\") {\n    statusCode = \"\";\n  }\n\n  parsedRows.push({\n    t: row.NeedByDate || row.StartTime || row[\"StartTime (Activity)\"] || \"\",\n    w: row.svcWorkOrderId || row[\"Work Order Id\"] || \"\",\n    n: row.WoNumber || row[\"Work Order Number\"] || \"\",\n    a: row.ActivityId || row[\"Activity Id\"] || \"\",\n    q: row.RequirementLineId || \"\",\n    i: row.ItemNumber || row[\"Item / InventoryItemNumber\"] || row.InventoryItemNumber || row.Item || \"\",\n    d: row.InventoryItemDescription || row[\"Item Description\"] || \"\",\n    r: +(row[\"Required Qty\"] || row.RequiredQty || 0),\n    ii: row[\"StockingLocation InventoryItemId\"] || row.InventoryItemId || \"\",\n    di: row[\"StockingLocation Distance\"] || row.Distance || \"\",\n    su: row[\"StockingLocation SourceSubinventory\"] || row.SourceSubinventory || row.Subinventory || \"\",\n    og: row[\"Best Source Org\"] || row.Org || row.SourceOrganizationCode || \"\",\n    sq: +(row.SuppliedQuantity || row[\"Supplied Quantity\"] || 0),\n    ty: row[\"Source Type\"] || row.SourceType || \"\",\n    sc: statusCode,\n    u: row.UOMCode || row[\"UOM Code\"] || \"Ea\"\n  });\n}\n\nvar parsedResult = {\n  m: onHandMap,\n  rs: parsedRows\n};\n\nreturn parsedResult;"
