          "code": "RESERVEPARTS",
          "id": "1766323038397",
          "inputs": [
            {
              "id": "1766323038398_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.BUILD_RESERVATION_RESPONSE.$output.result.reservation_needed_items}}"
            }
          ],
