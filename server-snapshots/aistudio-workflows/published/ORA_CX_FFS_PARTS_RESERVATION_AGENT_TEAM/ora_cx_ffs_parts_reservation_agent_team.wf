          "metadata": {
            "errorNodeId": "1767793439921",
            "name": "Show Activities",
            "returnType": "object",
            "sourceCode": "let stockResp = $context.$nodes.FORMAT_NEAR_BY_WO_JSON.$output.result;\nlet activities = $context.$variables.activities;\n\nif (typeof stockResp === \"string\") stockResp = JSON.parse(stockResp);\nif (typeof activities === \"string\") activities = JSON.parse(activities);\n\nlet reqToStock = Object.create(null);\n\nlet outer = Array.isArray(stockResp) ? stockResp : [];\n\nfor (let i = 0; i < outer.length; i++) {\n  let o = outer[i];\n\n  if (typeof o === \"string\") {\n    try { o = JSON.parse(o); } catch (e) { o = null; }\n  }\n  if (!o) continue;\n\n  let inner = o.result;\n\n  if (typeof inner === \"string\") {\n    try { inner = JSON.parse(inner); } catch (e) { inner = null; }\n  }\n  if (!inner) continue;\n\n  if (Array.isArray(inner)) {\n    for (let j = 0; j < inner.length; j++) {\n      let entry = inner[j];\n\n      if (typeof entry === \"string\") {\n        try { entry = JSON.parse(entry); } catch (e) { entry = null; }\n      }\n      if (!entry) continue;\n\n      let r = entry.result;\n\n      if (typeof r === \"string\") {\n        try { r = JSON.parse(r); } catch (e) { r = null; }\n      }\n      if (!r) continue;\n\n      let locs = Array.isArray(r.stockingLocation) ? r.stockingLocation : [];\n      for (let k = 0; k < locs.length; k++) {\n        let loc = locs[k];\n        let rid = String(loc && loc.RequirementLineId ? loc.RequirementLineId : \"\").trim();\n        if (!rid) continue;\n        if (!reqToStock[rid]) reqToStock[rid] = [];\n        reqToStock[rid].push(loc);\n      }\n    }\n  } else {\n    let r2 = inner && inner.result ? inner.result : inner;\n\n    if (typeof r2 === \"string\") {\n      try { r2 = JSON.parse(r2); } catch (e) { r2 = null; }\n    }\n    if (!r2) continue;\n\n    let locs2 = Array.isArray(r2.stockingLocation) ? r2.stockingLocation : [];\n    for (let k2 = 0; k2 < locs2.length; k2++) {\n      let loc2 = locs2[k2];\n      let rid2 = String(loc2 && loc2.RequirementLineId ? loc2.RequirementLineId : \"\").trim();\n      if (!rid2) continue;\n      if (!reqToStock[rid2]) reqToStock[rid2] = [];\n      reqToStock[rid2].push(loc2);\n    }\n  }\n}\n\nlet acts = Array.isArray(activities) ? activities : [];\n\nfor (let a = 0; a < acts.length; a++) {\n  let act = acts[a];\n  let items = act && Array.isArray(act.items) ? act.items : [];\n  for (let b = 0; b < items.length; b++) {\n    let it = items[b];\n\n    let rid = String(it && it.RequirementLineId ? it.RequirementLineId : \"\").trim();\n\n    if (!it.stockingLocation) it.stockingLocation = [];\n    if (rid && reqToStock[rid]) it.stockingLocation = reqToStock[rid];\n  }\n}\n\nreturn acts;"
