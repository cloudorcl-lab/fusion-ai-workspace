        },
        {
          "metadata": {
            "name": "ShowReservationResult",
            "returnType": "object",
            "sourceCode": "let results = $context.$nodes.RESERVEPARTS.$output;\n\nif (!Array.isArray(results)) {\n  results = [];\n}\n\nfunction parseMaybe(value) {\n  if (typeof value !== \"string\") return value;\n  try { return JSON.parse(value); } catch (e) { return value; }\n}\n\nfor (let i = 0; i < results.length; i++) {\n  let outer = parseMaybe(results[i]);\n  if (!outer || typeof outer !== \"object\") {\n    results[i] = outer;\n    continue;\n  }\n\n  if (typeof outer.result === \"string\") {\n    outer.result = parseMaybe(outer.result);\n  }\n\n  let innerArr = Array.isArray(outer.result) ? outer.result : [];\n  for (let j = 0; j < innerArr.length; j++) {\n    let inner = parseMaybe(innerArr[j]);\n    if (!inner || typeof inner !== \"object\") {\n      innerArr[j] = inner;\n      continue;\n    }\n\n    if (typeof inner.result === \"string\") {\n      inner.result = parseMaybe(inner.result);\n    }\n\n    let payload = inner.result;\n    if (payload && typeof payload === \"object\") {\n      // Remove internal-only transport fields from final business output.\n      delete payload._postReserveShouldRecreate;\n      delete payload._postReserveRecreateParts;\n      delete payload._postReserveRecreateLineIds;\n      delete payload._postReserveCleanupWarnings;\n      delete payload._postReserveExistingPartsCount;\n    }\n\n    innerArr[j] = inner;\n  }\n\n  outer.result = innerArr;\n  results[i] = outer;\n}\n\nreturn results;\n"
          },
          "outcomes": {
            "success": "1767691948600"
          },
          "code": "SHOWRESERVATIONRESULT",
          "id": "1767684971456",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Show Consolidated Response",
            "returnType": "object",
            "sourceCode": "// Node: MERGE_RESERVED_ITEMS_INTO_LLM_OUTPUT\n// Goal:\n// - Read LLM output: $context.$nodes.BUILD_RESERVATION_RESPONSE.$output.result\n// - Read reservationOutput (set your node name below): $context.$nodes.SHOWRESERVATIONRESULT.$output (adjust if different)\n// - For each reservationOutput entry where inner.result.error === false:\n//     - push that inner.result into llmOut.reserved_items[]\n//     - remove matching lines from llmOut.reservation_needed_items (match by RequirementLineId; also remove from partLines)\n// - If error === true: ignore (do nothing)\n\nlet llmOut = $context.$nodes.BUILD_RESERVATION_RESPONSE.$output.result;\nlet reservationOutput =  $context.$nodes.SHOWRESERVATIONRESULT.$output.result;\n\n// -------- Parse if string --------\nif (typeof llmOut === \"string\") { try { llmOut = JSON.parse(llmOut); } catch (e) { llmOut = null; } }\nif (typeof reservationOutput === \"string\") { try { reservationOutput = JSON.parse(reservationOutput); } catch (e) { reservationOutput = null; } }\n\nif (!llmOut || typeof llmOut !== \"object\") llmOut = Object.create(null);\nif (!Array.isArray(llmOut.reservation_needed_items)) llmOut.reservation_needed_items = [];\nif (!Array.isArray(llmOut.reserved_items)) llmOut.reserved_items = [];\n\n// -------- Normalize reservationOutput to array --------\nlet ro = [];\nif (Array.isArray(reservationOutput)) ro = reservationOutput;\nelse if (reservationOutput && Array.isArray(reservationOutput.result)) ro = reservationOutput.result;\nelse ro = [];\n\n// -------- Helper: collect success RequirementLineIds, and payloads to push --------\nlet successIds = Object.create(null);\nlet successes = [];\n\nfor (let i = 0; i < ro.length; i++) {\n  let outer = ro[i];\n\n  // outer may be stringified JSON\n  if (typeof outer === \"string\") {\n    try { outer = JSON.parse(outer); } catch (e) { outer = null; }\n  }\n  if (!outer) continue;\n\n  // outer.result is usually an array like [{result:{...}}]\n  let innerArr = outer && Array.isArray(outer.result) ? outer.result : [];\n  for (let j = 0; j < innerArr.length; j++) {\n    let inner = innerArr[j];\n\n    if (typeof inner === \"string\") {\n      try { inner = JSON.parse(inner); } catch (e) { inner = null; }\n    }\n    if (!inner) continue;\n\n    let payload = inner.result ? inner.result : null;\n    if (!payload || typeof payload !== \"object\") continue;\n\n    // Only error === false\n    if (payload.error !== false) continue;\n\n    // Determine RequirementLineId (prefer top-level, else from first partLine)\n    let rid = payload.RequirementLineId != null ? String(payload.RequirementLineId).trim() : \"\";\n    if (!rid) {\n      let pls = Array.isArray(payload.partLines) ? payload.partLines : [];\n      if (pls.length > 0 && pls[0] && pls[0].RequirementLineId != null) {\n        rid = String(pls[0].RequirementLineId).trim();\n      }\n    }\n    if (!rid) continue;\n\n    successIds[rid] = 1;\n    successes.push(payload);\n  }\n}\n\n// -------- Push successes into reserved_items (dedupe by RequirementLineId) --------\nlet already = Object.create(null);\nfor (let i = 0; i < llmOut.reserved_items.length; i++) {\n  let x = llmOut.reserved_items[i];\n  if (!x || typeof x !== \"object\") continue;\n  let rid = x.RequirementLineId != null ? String(x.RequirementLineId).trim() : \"\";\n  if (rid) already[rid] = 1;\n}\n\nfor (let i = 0; i < successes.length; i++) {\n  let s = successes[i];\n  let rid = s.RequirementLineId != null ? String(s.RequirementLineId).trim() : \"\";\n  if (!rid) continue;\n  if (already[rid]) continue;\n  llmOut.reserved_items.push(s);\n  already[rid] = 1;\n}\n\n// -------- Remove successful lines from reservation_needed_items --------\n// Behavior:\n// - For each item group: remove partLines whose RequirementLineId is in successIds\n// - If a group has no remaining partLines -> remove the group\nlet filteredGroups = [];\nfor (let g = 0; g < llmOut.reservation_needed_items.length; g++) {\n  let grp = llmOut.reservation_needed_items[g];\n  if (!grp || typeof grp !== \"object\") continue;\n\n  let partLines = Array.isArray(grp.partLines) ? grp.partLines : [];\n  let kept = [];\n\n  for (let p = 0; p < partLines.length; p++) {\n    let pl = partLines[p];\n    if (!pl || typeof pl !== \"object\") continue;\n\n    let rid = pl.RequirementLineId != null ? String(pl.RequirementLineId).trim() : \"\";\n    if (rid && successIds[rid]) {\n      // remove this partLine\n      continue;\n    }\n    kept.push(pl);\n  }\n\n  if (kept.length > 0) {\n    grp.partLines = kept;\n    filteredGroups.push(grp);\n  }\n}\nllmOut.reservation_needed_items = filteredGroups;\nllmOut.error=false;\nreturn llmOut;"
          },
          "outcomes": {
            "success": "1775554612455"
          },
          "code": "SHOW_CONSOLIDATED_RESPONSE",
          "id": "1767691948600",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1767793439921",
            "name": "Prep Formatter JSON",
            "returnType": "object",
            "sourceCode": "var consolidatedResponse = $context.$nodes.SHOW_CONSOLIDATED_RESPONSE.$output.result || {};\n\nvar output = {\n  title: \"## Missing Required Parts\",\n  hasOutput: 0,\n  result: {\n    reserved_items: [],\n    reservation_needed_items: [],\n    notGoingToBeReserved: [],\n    noReservationNeeded: [],\n    output_map: []\n  }\n};\n\nvar aggregatedItems = {};\n\nvar sections = {\n  reserved_items: [consolidatedResponse.reserved_items || [], \"RESERVED\", \"Reserved\"],\n  reservation_needed_items: [consolidatedResponse.reservation_needed_items || [], \"NOT_RESERVED\", \"Not Reserved\"],\n  notGoingToBeReserved: [consolidatedResponse.notGoingToBeReserved || [], \"NOT_RESERVED\", \"Not Reserved\"],\n  noReservationNeeded: [consolidatedResponse.noReservationNeeded || [], \"SKIP\", \"\"]\n};\n\n// Format the consolidated response for the final chat/output payload.\nfor (var sectionKey in sections) {\n  var sectionConfig = sections[sectionKey];\n  var items = sectionConfig[0];\n  var action = sectionConfig[1];\n  var status = sectionConfig[2];\n\n  for (var itemIndex = 0; itemIndex < items.length; itemIndex++) {\n    var item = items[itemIndex];\n    var partLines = item.partLines || [];\n    var description = (item.InventoryItemDescription || \"\") + \"\";\n    var totalRequiredQty = +item.TotalRequiredQty || 0;\n    var totalOnHandQty = +item.TotalOnHandQty || 0;\n    var reservationNeededQty = +item.ReservationNeededQty || 0;\n    var shortageQty = totalRequiredQty - totalOnHandQty;\n    var requiredQty = action === \"RESERVED\"\n      ? (reservationNeededQty || totalRequiredQty || 0)\n      : (reservationNeededQty > 0 ? reservationNeededQty : shortageQty > 0 ? shortageQty : 0);\n    var workOrders = [];\n    var workOrderSet = {};\n\n    description = description ? description.replace(/_Desc$/, \"\") : \"\";\n\n    for (var partIndex = 0; partIndex < partLines.length; partIndex++) {\n      var workOrderNumber = partLines[partIndex].WoNumber || partLines[partIndex].svcWorkOrderId || \"\";\n      if (workOrderNumber && !workOrderSet[workOrderNumber]) {\n        workOrderSet[workOrderNumber] = workOrders.push(workOrderNumber);\n      }\n    }\n\n    var itemNumber = item.ItemNumber || description || ((partLines[0] && partLines[0].RequirementLineId) || \"\");\n    if (!description) {\n      description = itemNumber;\n    }\n\n    var formattedItem = {\n      ItemNumber: itemNumber,\n      InventoryItemDescription: description,\n      UOMCode: item.UOMCode || \"Ea\",\n      TotalRequiredQty: totalRequiredQty,\n      TotalOnHandQty: totalOnHandQty,\n      ReservationNeededQty: reservationNeededQty,\n      RequiredQty: requiredQty,\n      NormalizedStatus: status,\n      Action: action,\n      partLines: partLines,\n      workOrders: workOrders\n    };\n\n    output.result[sectionKey].push(formattedItem);\n\n    if (action !== \"SKIP\" && requiredQty > 0) {\n      var mapKey = formattedItem.ItemNumber + \"|\" + action;\n      var mapEntry = aggregatedItems[mapKey] || (aggregatedItems[mapKey] = {\n        ItemNumber: formattedItem.ItemNumber,\n        InventoryItemDescription: formattedItem.InventoryItemDescription,\n        UOMCode: formattedItem.UOMCode,\n        RequiredQty: 0,\n        Action: action,\n        NormalizedStatus: status,\n        WOs: []\n      });\n      var existingWorkOrders = {};\n\n      var chosenQtyFromPartLines = 0;\n\n\n      for (var partLineIndex = 0; partLineIndex < partLines.length; partLineIndex++) {\n        var chosenSource = Array.isArray(partLines[partLineIndex] && partLines[partLineIndex].chosenSource)\n          ? partLines[partLineIndex].chosenSource\n          : [];\n\n\n        for (var chosenSourceIndex = 0; chosenSourceIndex < chosenSource.length; chosenSourceIndex++) {\n          var chosen = chosenSource[chosenSourceIndex] || {};\n          var qty = Number(chosen.Quantity);\n          var sourceSubinventory = (chosen.SourceSubinventory || \"\") + \"\";\n          var sourceOrganizationCode = (chosen.SourceOrganizationCode || \"\") + \"\";\n          if (!isNaN(qty) && qty > 0) {\n            chosenQtyFromPartLines += qty;\n            if (action === \"RESERVED\") {\n              if (!mapEntry.SourceSubinventory && sourceSubinventory && sourceSubinventory !== \"-\") {\n                mapEntry.SourceSubinventory = sourceSubinventory;\n              }\n              if (!mapEntry.SourceOrganizationCode && sourceOrganizationCode && sourceOrganizationCode !== \"-\") {\n                mapEntry.SourceOrganizationCode = sourceOrganizationCode;\n              }\n            }\n          }\n        }\n      }\n\n\n      var mapContribution = ((action === \"RESERVED\" || action === \"NOT_RESERVED\") && chosenQtyFromPartLines > 0)\n        ? chosenQtyFromPartLines\n        : requiredQty;\n\n\n      mapEntry.RequiredQty += mapContribution;\n\n      for (var existingIndex = 0; existingIndex < mapEntry.WOs.length; existingIndex++) {\n        existingWorkOrders[mapEntry.WOs[existingIndex]] = 1;\n      }\n\n      for (var workOrderIndex = 0; workOrderIndex < workOrders.length; workOrderIndex++) {\n        if (!existingWorkOrders[workOrders[workOrderIndex]]) {\n          mapEntry.WOs.push(workOrders[workOrderIndex]);\n        }\n      }\n    }\n  }\n}\n\nfor (var mapKey in aggregatedItems) {\n  output.result.output_map.push(aggregatedItems[mapKey]);\n}\n\noutput.hasOutput = !!output.result.output_map.length;\n\nif (!output.hasOutput) {\n  output.title = \"\";\n}\n\nreturn output;\n"
          },
