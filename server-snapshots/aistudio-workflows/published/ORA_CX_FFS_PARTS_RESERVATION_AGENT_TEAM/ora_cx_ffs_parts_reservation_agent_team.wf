                  },
                  "code": "GETWORKORDERDETAILS",
                  "id": "1767854556413",
                  "inputs": [
                    {
                      "id": "1767854574689_1",
                      "name": "svcWorkOrderId",
                      "type": "string",
                      "value": "{{$context.$nodes.PROCESS_ALL_WORK_ACTIVITIES.$currentItem.svcWorkOrderId}}"
                    }
                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "Prepare Activity Parts",
                    "returnType": "object",
                    "sourceCode": "let out = Object.create(null);\nout.items = Object.create(null);\nout.items = []\nout.id = $context.$nodes.PROCESS_ALL_WORK_ACTIVITIES.$currentItem.id;\nout.svcWorkOrderId = $context.$nodes.PROCESS_ALL_WORK_ACTIVITIES.$currentItem.svcWorkOrderId;\nout.duration = $context.$nodes.PROCESS_ALL_WORK_ACTIVITIES.$currentItem.duration;\nout.startTime = $context.$nodes.PROCESS_ALL_WORK_ACTIVITIES.$currentItem.startTime;\nout.travelTime = $context.$nodes.PROCESS_ALL_WORK_ACTIVITIES.$currentItem.travelTime;\n\n\nlet results = Array.isArray($context.$nodes.PROCESS_ALL_WORK_ACTIVITIES.LIST_PARTS_FOR_WORK_ORDER.$output.items) ? $context.$nodes.PROCESS_ALL_WORK_ACTIVITIES.LIST_PARTS_FOR_WORK_ORDER.$output.items : [];\n\nfor (let i = 0; i < results.length; i++) {\n    let partLine = results[i];\n    let part = Object.create(null);\n    part.InventoryItemNumber = partLine.InventoryItemNumber;\n    part.RequirementLineId = partLine.RequirementLineId;\n    part.InventoryItemDescription = partLine.InventoryItemDescription;\n    part.ParentEntityId = partLine.ParentEntityId;\n    part.Quantity = partLine.Quantity;\n    part.UnitOfMeasure = partLine.UnitOfMeasure;\n    part.NeedByDate = partLine.NeedByDate;\n    part.ShipToLocationId = partLine.ShipToLocationId;\n    part.ShipToPartyId = partLine.ShipToPartyId;\n\n\n    let src = String(partLine.NeedByDate || \"\");\n\n    // extract date part\n    let baseDate = src.slice(0, 10);\n\n    let d = new Date(baseDate);\n    d.setDate(d.getDate() + 1);\n\n    // build YYYY-MM-DD\n    let nextDay =\n        d.getFullYear() + \"-\" +\n        String(d.getMonth() + 1).padStart(2, \"0\") + \"-\" +\n        String(d.getDate()).padStart(2, \"0\");\n\n    // keep original time + timezone part if present\n    part.ApproxNeedByDate = src.length > 10\n        ? nextDay + src.slice(10)\n        : nextDay;\n\n    part.DestinationOrganizationCode = partLine.DestinationOrganizationCode;\n    part.HRLocationId = $context.$nodes.LOCATION_MAPPINGS.$output.items[0].HRLocationId;\n    part.AccountPartyId = $context.$nodes.PROCESS_ALL_WORK_ACTIVITIES.GETWORKORDERDETAILS.$output.items[0].AccountPartyId;\n    part.WoNumber = $context.$nodes.PROCESS_ALL_WORK_ACTIVITIES.GETWORKORDERDETAILS.$output.items[0].WoNumber;\n\n\n\n    part.lineDetails = Object.create(null);\n    part.lineDetails.items = Object.create(null);\n    part.lineDetails.items = []\n\n    if (!part.lineDetails) part.lineDetails = Object.create(null);\n    let lineDetails = Array.isArray(partLine.lineDetails.items) ? partLine.lineDetails.items : [];\n\n    let cancelledLine = 0;\n\n    for (let j = 0; j < lineDetails.length; j++) {\n        let lineDetail = lineDetails[j];\n        let st = lineDetail && lineDetail.LineStatus ? String(lineDetail.LineStatus) : \"\";\n        let stCode = lineDetail && lineDetail.LineStatusCode ? String(lineDetail.LineStatusCode) : \"\";\n        let partDetail = Object.create(null);\n        partDetail.SourceOrganizationCode = lineDetail.SourceOrganizationCode;\n        partDetail.SourceOrganizationName = lineDetail.SourceOrganizationName;\n        partDetail.RequirementLineDetailId = lineDetail.RequirementLineDetailId;\n        partDetail.SourceId = lineDetail.SourceId;\n        partDetail.SourceType = lineDetail.SourceType;\n        partDetail.Quantity = part.Quantity;\n        partDetail.UnitOfMeasure = part.UnitOfMeasure;\n        partDetail.LineStatus = st;\n        partDetail.LineStatusCode = stCode;\n        part.lineDetails.items.push(partDetail);\n        if (stCode.indexOf(\"CANCELED\") >= 0 || [\"RESERVED\", \"FULLY RECEIVED\", \"CL\", \"CLOSED\", \"CANCEL_SUBMITTED\"].indexOf(stCode) >= 0) cancelledLine = 1;\n    }\n\n    if (cancelledLine == 0) {\n        out.items.push(part);\n    }\n\n}\n\nreturn out;"
                  },
                  "outcomes": {
                    "success": "end_1766482872998"
                  },
                  "diagram": {
                    "x": 5682.5,
                    "y": 9734
                  },
                  "code": "PREPARE_ACTIVITY_PARTS",
