        {
          "metadata": {
            "errorNodeId": "1767793439921",
            "name": "Show MD Table",
            "returnType": "object",
            "sourceCode": "// -------------------------\n// INPUTS\n// -------------------------\nlet activities = $context.$nodes.SHOW_ACTIVITIES.$output.result;\nlet onHandMap = $context.$variables.onHandMap;\n\nif (typeof activities === \"string\") activities = JSON.parse(activities);\nif (typeof onHandMap === \"string\") onHandMap = JSON.parse(onHandMap);\n\n// -------------------------\n// 1) Flatten requirement lines with activity context\n// -------------------------\nlet flat = [];\nif (Array.isArray(activities)) {\n  for (let a = 0; a < activities.length; a++) {\n    let act = activities[a];\n    if (!act) continue;\n\n    let startTime = act.startTime != null ? String(act.startTime) : \"\";\n    let activityId = act.id != null ? String(act.id) : \"\";\n    let wo = act.svcWorkOrderId != null ? String(act.svcWorkOrderId) : \"\";\n\n    let items = Array.isArray(act.items) ? act.items : [];\n    for (let i = 0; i < items.length; i++) {\n      let p = items[i];\n      if (!p) continue;\n\n      let itemNum = p.InventoryItemNumber != null ? String(p.InventoryItemNumber).trim() : \"\";\n      let itemDesc = p.InventoryItemDescription != null ? String(p.InventoryItemDescription).trim() : \"N/A\";\n      if (!itemNum) continue;\n\n      let qty = p.Quantity != null ? Number(p.Quantity) : 0;\n      if (isNaN(qty) || qty <= 0) continue;\n\n      let r = Object.create(null);\n      r._startTime = startTime;\n      r.StartTime = startTime;\n      r.WorkOrderId = wo;\n      r.WoNumber = p.WoNumber != null ? String(p.WoNumber) : \"N/A\";\n      r.NeedByDate = p.NeedByDate != null ? String(p.NeedByDate) : startTime;\n      r.ActivityId = activityId;\n      r.RequirementLineId = p.RequirementLineId != null ? String(p.RequirementLineId) : \"\";\n      r.Item = itemNum;\n      r.ItemDesc = itemDesc;\n      r.RequiredQty = qty;\n      r._part = p;\n      flat.push(r);\n    }\n  }\n}\n\n// -------------------------\n// 2) Sort by startTime\n// -------------------------\nflat.sort((a, b) => {\n  let x = a && a._startTime != null ? String(a._startTime) : \"\";\n  let y = b && b._startTime != null ? String(b._startTime) : \"\";\n  if (x < y) return -1;\n  if (x > y) return 1;\n  return 0;\n});\n\n// -------------------------\n// 3) Explode stockingLocation rows\n// -------------------------\nlet outRows = [];\nlet seq = 0;\n\nfor (let i = 0; i < flat.length; i++) {\n  let r = flat[i];\n  let part = r._part;\n\n  // baseline onhand\n  let onHandInitial = onHandMap && onHandMap[r.Item] != null ? Number(onHandMap[r.Item]) : 0;\n  if (isNaN(onHandInitial)) onHandInitial = 0;\n\n  // ---- Normalize stockingLocation into an array (NO FUNCTIONS)\n  let sl = [];\n  let rawSL = part ? part.stockingLocation : null;\n\n  if (typeof rawSL === \"string\") {\n    try { rawSL = JSON.parse(rawSL); } catch (e) { rawSL = null; }\n  }\n\n  if (Array.isArray(rawSL)) {\n    sl = rawSL;\n  } else if (rawSL && Array.isArray(rawSL.items)) {\n    sl = rawSL.items;\n  } else {\n    sl = [];\n  }\n\n  // ---- Determine fallback best org/type from lineDetails (when needed)\n  let fallbackOrg = \"—\";\n  let fallbackType = \"—\";\n  let lineStatus = \"\";\n\n  let ld = part && part.lineDetails ? part.lineDetails : null;\n  let li = Array.isArray(ld) ? ld : (ld && Array.isArray(ld.items) ? ld.items : []);\n  if (li.length > 0) {\n    fallbackOrg = li[0] && li[0].SourceOrganizationCode != null ? String(li[0].SourceOrganizationCode) : \"—\";\n    fallbackType = \"Manufacturing\";\n    lineStatus = li[0] && li[0].LineStatusCode != null ? String(li[0].LineStatusCode) : \"\";\n  }\n\n  // If stockingLocation has entries: create one output row per stockingLocation entry\n  if (sl.length > 0) {\n    for (let j = 0; j < sl.length; j++) {\n      let s = sl[j];\n      if (!s) continue;\n\n      seq += 1;\n\n      let invId = s.InventoryItemId != null ? String(s.InventoryItemId) : \"—\";\n      let dist = s.Distance != null ? String(s.Distance) : \"—\";\n      let subinv = s.SourceSubinventory != null ? String(s.SourceSubinventory) : \"—\";\n\n      let suppliedQty = s.SuppliedQuantity != null ? Number(s.SuppliedQuantity) : \"—\";\n      if (suppliedQty !== \"—\" && isNaN(suppliedQty)) suppliedQty = \"—\";\n\n      let srcOrg = s.SourceOrganizationCode != null ? String(s.SourceOrganizationCode) : \"—\";\n      let srcType = s.SourceType != null ? String(s.SourceType) : \"—\";\n\n      let out = Object.create(null);\n      out[\"Seq (by StartTime)\"] = seq;\n      out[\"StartTime\"] = r.StartTime;\n      out[\"NeedByDate\"] = r.NeedByDate;\n      out[\"Work Order Id\"] = r.WorkOrderId;\n      out[\"Work Order Number\"] = r.WoNumber;\n      out[\"Activity Id\"] = r.ActivityId;\n      out[\"RequirementLineId\"] = r.RequirementLineId;\n      out[\"Item\"] = r.Item;\n      out[\"ItemDesc\"] = r.ItemDesc;\n      out[\"Required Qty\"] = r.RequiredQty;\n      out[\"On-Hand (Initial)\"] = onHandInitial;\n\n      out[\"StockingLocation InventoryItemId\"] = invId;\n      out[\"StockingLocation Distance\"] = dist;\n      out[\"StockingLocation SourceSubinventory\"] = subinv;\n      out[\"SuppliedQuantity\"] = suppliedQty;\n\n      out[\"Best Source Org\"] = srcOrg;\n      out[\"Source Type\"] = srcType;\n      out[\"Status Code\"] = lineStatus;\n\n      outRows.push(out);\n    }\n  } else {\n    // No stockingLocation: produce a single row with —, but keep lineDetails org/type\n    seq += 1;\n\n    let out = Object.create(null);\n    out[\"Seq (by StartTime)\"] = seq;\n    out[\"StartTime\"] = r.StartTime;\n    out[\"NeedByDate\"] = r.NeedByDate;\n    out[\"Work Order Id\"] = r.WorkOrderId;\n    out[\"Work Order Number\"] = r.WoNumber;\n    out[\"Activity Id\"] = r.ActivityId;\n    out[\"RequirementLineId\"] = r.RequirementLineId;\n    out[\"Item\"] = r.Item;\n    out[\"ItemDesc\"] = r.ItemDesc;\n    out[\"Required Qty\"] = r.RequiredQty;\n    out[\"On-Hand (Initial)\"] = onHandInitial;\n\n    out[\"StockingLocation InventoryItemId\"] = \"—\";\n    out[\"StockingLocation Distance\"] = \"—\";\n    out[\"StockingLocation SourceSubinventory\"] = \"—\";\n    out[\"SuppliedQuantity\"] = \"—\";\n\n    out[\"Best Source Org\"] = fallbackOrg;\n    out[\"Source Type\"] = fallbackType;\n    out[\"Status Code\"] = lineStatus;\n\n    outRows.push(out);\n  }\n}\n\n// -------------------------\n// 4) Markdown output (pipes)\n// -------------------------\nlet headers = [\n  \"Seq (by StartTime)\",\n  \"StartTime\",\n  \"NeedByDate\",\n  \"Work Order Id\",\n  \"Work Order Number\",\n  \"Activity Id\",\n  \"RequirementLineId\",\n  \"Item\",\n  \"Item Description\",\n  \"Required Qty\",\n  \"On-Hand (Initial)\",\n  \"StockingLocation InventoryItemId\",\n  \"StockingLocation Distance\",\n  \"StockingLocation SourceSubinventory\",\n  \"SuppliedQuantity\",\n  \"Best Source Org\",\n  \"Source Type\",\n  \"Status Code\"\n];\n\nlet md = \"\";\nmd += \"| \" + headers.join(\" | \") + \" |\\n\";\nmd += \"|\";\nfor (let h = 0; h < headers.length; h++) md += \" --- |\";\nmd += \"\\n\";\n\nfor (let i = 0; i < outRows.length; i++) {\n  let rr = outRows[i];\n\n  let vals = [\n    rr[\"Seq (by StartTime)\"],\n    rr[\"StartTime\"],\n    rr[\"NeedByDate\"],\n    rr[\"Work Order Id\"],\n    rr[\"Work Order Number\"],\n    rr[\"Activity Id\"],\n    rr[\"RequirementLineId\"],\n    rr[\"Item\"],\n    rr[\"ItemDesc\"],\n    rr[\"Required Qty\"],\n    rr[\"On-Hand (Initial)\"],\n    rr[\"StockingLocation InventoryItemId\"],\n    rr[\"StockingLocation Distance\"],\n    rr[\"StockingLocation SourceSubinventory\"],\n    rr[\"SuppliedQuantity\"],\n    rr[\"Best Source Org\"],\n    rr[\"Source Type\"],\n    rr[\"Status Code\"]\n  ];\n\n  for (let j = 0; j < vals.length; j++) {\n    let s = vals[j] == null ? \"—\" : String(vals[j]);\n    if (s === \"\") s = \"—\";\n    s = s.replace(/\\|/g, \"\\\\|\").replace(/\\r?\\n/g, \" \");\n    vals[j] = s;\n  }\n\n  md += \"| \" + vals.join(\" | \") + \" |\\n\";\n}\n\nlet result = Object.create(null);\nresult.table = outRows;\nresult.markdown = md;\nreturn result;"
