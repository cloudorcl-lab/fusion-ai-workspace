                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"categorizedAttachedDocId\": { \"type\": \"string\" },\n          \"interactionId\": { \"type\": \"string\" },\n          \"emailAttachedDocumentId\": { \"type\": \"string\" },\n          \"entityName\": { \"type\": \"string\" },\n          \"candEmailMessageId\": { \"type\": \"string\" },\n          \"createdByInEmailAttachment\": { \"type\": \"string\" },\n          \"creationDate\": { \"type\": \"string\" },\n          \"entityContextIdPk1Value\": { \"type\": \"string\" },\n          \"categoryName\": { \"type\": \"string\" },\n          \"categorizationStatus\": { \"type\": \"string\" }\n        }\n      }\n    }\n  }\n}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "UpdateAllAttachmentCategorizationStatuesInMessage",
                    "returnType": "object",
                    "sourceCode": "let attachments = $context.$nodes.PROCESSEACHMESSAGE.$currentItem.attachments;\nlet attachmentStatuses = $context.$nodes.PROCESSEACHMESSAGE.GETEXISTINGATTACHMENTCATEGORIZATIONSTATUS.$output.result;\nlet statusMap = {};\n\nif (Array.isArray(attachmentStatuses)) {\n  attachmentStatuses.forEach(item => {\n    statusMap[item.emailAttachedDocumentId] = item.categorizationStatus;\n  });\n}\n\nif (Array.isArray(attachments)) {\n  attachments = attachments.map(attachment => {\n    // If mapping found, overwrite categorizationStatus, else keep existing\n    if (statusMap[attachment.attachedDocumentId] !== undefined) {\n      return {\n        ...attachment,\n        categorizationStatus: statusMap[attachment.attachedDocumentId]\n      };\n    } else {\n      return attachment; \n    }\n  });\n}\n\nreturn attachments;"
                  },
                  "outcomes": {
                    "success": "1765974691933"
                  },
                  "code": "UPDATEALLATTACHMENTCATEGORIZATIONSTATUESINMESSAGE",
