          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "DeriveEligibleCategoriesForProcessing",
            "returnType": "object",
            "sourceCode": "const EXCLUDED_CATEGORIES = new Set([\"IRC_INTERNAL\", \"IRC_INTERNAL_MERGE\"]);\n\n// Helper: safely convert items to map { UserName : CategoryName }\nconst toUserToCategoryMap = (items) => {\n    const safeItems = Array.isArray(items) ? items : [];\n    return safeItems.reduce((map, item) => {\n        const userName = item?.UserName;\n        const categoryName = item?.CategoryName;\n\n        if (userName && categoryName && !EXCLUDED_CATEGORIES.has(categoryName)) {\n            map[userName] = categoryName;\n        }\n        return map;\n    }, {});\n};\n\n// Safe hasOwnProperty check\nconst hasKey = (obj, key) =>\n    Object.prototype.hasOwnProperty.call(obj || {}, key);\n\n// 1) Supported categories (Submissions)\nconst submissionItems =\n    $context?.$nodes?.GETSUPPORTEDATTACHMENTCATEGORIESFORSUBMISSIONS?.$output\n        ?.items;\nconst supportedCategoryMapForSubmissions = toUserToCategoryMap(submissionItems);\n\n// 2) Supported categories (Candidates)\nconst candidateItems =\n    $context?.$nodes?.GETSUPPORTEDATTACHMENTCATEGORIESFORCANDIDATES?.$output\n        ?.items;\nconst supportedCategoryMapForCandidates = toUserToCategoryMap(candidateItems);\n\n// 3) Inactive recruiting categories\nconst recruitingItems =\n    $context?.$nodes?.GETDOCUMENTCATEGORIESINRECRUITING?.$output?.items;\nconst inactiveRecruitingCategoryMap = toUserToCategoryMap(\n    Array.isArray(recruitingItems)\n        ? recruitingItems.filter((item) => item?.ActiveFlag === false)\n        : []\n);\n\n// 4) Eligible maps (exclude inactive categories)\nconst eligibleCategoryMapForCandidates = Object.fromEntries(\n    Object.entries(supportedCategoryMapForCandidates || {}).filter(\n        ([userName]) => !hasKey(inactiveRecruitingCategoryMap, userName)\n    )\n);\nconst eligibleCategoryMapForSubmissions = Object.fromEntries(\n    Object.entries(supportedCategoryMapForSubmissions || {}).filter(\n        ([userName]) => !hasKey(inactiveRecruitingCategoryMap, userName)\n    )\n);\n\n// 5) Eligible lists (UserNames only)\nconst eligibleCategoryUserNamesListForCandidates = Object.keys(\n    eligibleCategoryMapForCandidates\n);\nconst eligibleCategoryUserNamesListForSubmissions = Object.keys(\n    eligibleCategoryMapForSubmissions\n);\n// Return everything for downstream nodes\nconst eligibleData = {\n    eligibleCategoryMapForCandidates,\n    eligibleCategoryMapForSubmissions,\n    eligibleCategoryUserNamesListForCandidates,\n    eligibleCategoryUserNamesListForSubmissions,\n};\nreturn eligibleData;"
          },
          "outcomes": {
            "success": "1765932889766"
          },
          "code": "DERIVEELIGIBLECATEGORIESFORPROCESSING",
          "convergenceTargetId": "1765941752269",
