tring\" },\n          \"href\": { \"type\": \"string\" },\n          \"name\": { \"type\": \"string\" },\n          \"kind\": { \"type\": \"string\" }\n        }\n      }\n    }\n  }\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "ParseMessageDumpForAttachmentInfo",
            "returnType": "object",
            "sourceCode": "const items = $context.$nodes.GETNEWATTACHMENTAGENTMESSAGELOGS.$output?.items || [];\nconst eligibleCategoryUserNamesListForSubmissions = $context.$nodes.DERIVEELIGIBLECATEGORIESFORPROCESSING.$output.result.eligibleCategoryUserNamesListForSubmissions;\nconst eligibleCategoryUserNamesListForCandidates = $context.$nodes.DERIVEELIGIBLECATEGORIESFORPROCESSING.$output.result.eligibleCategoryUserNamesListForCandidates;\nconst eligibleCategoryMapForSubmissions = $context.$nodes.DERIVEELIGIBLECATEGORIESFORPROCESSING.$output.result.eligibleCategoryMapForSubmissions;\nconst eligibleCategoryMapForCandidates = $context.$nodes.DERIVEELIGIBLECATEGORIESFORPROCESSING.$output.result.eligibleCategoryMapForCandidates;\n\nconst transformed = items.map(item => {\n    let message_dump = \"\";\n\n    try {\n        message_dump = JSON.parse(item.MessageBody || \"{}\");\n    } catch (e) {\n        messageBody = \"\";\n    }\n\n    const contextType = message_dump.contextType;\n    // Pick list based on contextType\n    const eligibleCategoryUserNamesList =\n        (contextType && String(contextType).toUpperCase() === \"ORA_SUBMISSION\")\n            ? eligibleCategoryUserNamesListForSubmissions\n            : eligibleCategoryUserNamesListForCandidates;\n    const eligibleCategoryMap =\n        (contextType && String(contextType).toUpperCase() === \"ORA_SUBMISSION\")\n            ? eligibleCategoryMapForSubmissions\n            : eligibleCategoryMapForCandidates;\n\n // Process attachments:\n  // 1) Ensure array\n  // 2) Exclude filenames including  'NOT_PROCESSED'\n  // 3) Add empty categorizationStatus\n  let attachments = [];\n  if (Array.isArray(message_dump?.attachments)) {\n    attachments = message_dump.attachments\n      .filter(att =>\n        typeof att?.fileName === \"string\"\n          ? !att.fileName.includes(\"NOT_PROCESSED\")\n          : true\n      )\n      .map(att => ({\n        ...att,\n        categorizationStatus: \"\"\n      }));\n  }\n\n    return {\n        hasAttachments: message_dump.attachments && message_dump.attachments.length > 0,\n        attachments: attachments,\n        candEmailMessageId: message_dump.candEmailMessageId,\n        contextId: message_dump.contextId,\n        contextType: contextType,\n        interactionId: message_dump.interactionId,\n        CandMsgLogId: item.CandMsgLogId,\n        eligibleCategoryUserNamesList: eligibleCategoryUserNamesList,\n        eligibleCategoryMap : eligibleCategoryMap,\n  candidatePersonId: message_dump.candidatePersonId\n    };\n});\n\nreturn transformed;"
          },
          "outcomes": {
            "success": "1766101703230"
          },
