        {
          "metadata": {
            "name": "joinAllToolCalls",
            "returnType": "object",
            "sourceCode": "let resultArray = $context.$nodes.FORLOOPPRODUCTS.$output;\n\n// Step 1: Parse all JSON strings into objects\nlet parsedArray = resultArray.map(item => JSON.parse(item));\n\n// Step 2: Collect and merge all productSearch arrays\nlet mergedProductSearch = parsedArray.flatMap(obj => {\n    return (obj.toolArgument && Array.isArray(obj.toolArgument.productSearch))\n        ? obj.toolArgument.productSearch\n        : [];\n});\n\n// Step 3: Replace productSearch in the FIRST object\nif (parsedArray.length > 0) {\n    if (!parsedArray[0].toolArgument) {\n        parsedArray[0].toolArgument = {};\n    }\n    parsedArray[0].toolArgument.productSearch = mergedProductSearch;\n    parsedArray[0].toolArgument.match = $context.$variables.match;\n}\n\nreturn  parsedArray[0];"
          },
          "outcomes": {
            "success": "1769605576254"
          },
          "code": "JOINALLTOOLCALLS",
