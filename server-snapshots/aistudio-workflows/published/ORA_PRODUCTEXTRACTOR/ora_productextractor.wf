        {
          "metadata": {
            "name": "validateInput",
            "returnType": "object",
            "sourceCode": "// Extract inputs\nlet processVarName = $context.$triggers.REST.$input.processVarName;\nlet mainDocumentId = $context.$triggers.REST.$input.mainDocumentId;\nlet attachmentAttributeName = $context.$triggers.REST.$input.attachmentAttributeName;\nlet transactionId = $context.$triggers.REST.$input.transactionId;\nlet documentNumber = $context.$triggers.REST.$input.documentNumber;\nlet documentTrackerId = $context.$triggers.REST.$input.documentTrackerId;\nlet documentUrl = $context.$triggers.REST.$input.documentUrl;\nlet cacheInstanceId = $context.$triggers.REST.$input.cacheInstanceId;\nlet priceBookVarName = $context.$triggers.REST.$input.priceBookVarName;\nlet defaultPriceBookVarName = $context.$variables.defaultPriceBookVarName;\nlet match = $context.$triggers.REST.$input.match;\n\nlet result = {\n    success: true,\n    message: \"All inputs are valid.\"\n};\n\n// --- Validation begins ---\n\n\n\n// documentTrackerId\nif (result.success) {\n    if (!documentTrackerId || typeof documentTrackerId !== 'string' || !documentTrackerId.trim()) {\n        result = {\n            success: false,\n            message: \"Invalid or missing 'documentTrackerId'. Expected a non-empty string.\"\n        };\n    } else {\n        result = {\n            success: true,\n            documentTrackerId: documentTrackerId\n        };\n    }\n}\n\n// documentUrl\nif (!result.success) {\n    if (!documentUrl || typeof documentUrl !== 'string' || !documentUrl.trim()) {\n        result = {\n            success: false,\n            message: \"Invalid or missing 'documentUrl'. Expected a non-empty string.\"\n        };\n    } else {\n        result = {\n            success: true,\n            documentUrl: documentUrl\n        };\n    }\n}\n\n// other parameters\nif (!result.success) {\n    let allFailed = true;\n    // processVarName\n    if (!processVarName || typeof processVarName !== 'string' || !processVarName.trim()) {\n        result = {\n            success: false,\n            message: \"Invalid or missing 'processVarName'. Expected a non-empty string.\"\n        };\n    } else {\n        allFailed = false;\n        result = {\n            success: true\n        };\n    }\n\n\n    // mainDocumentId\n    if (\n        mainDocumentId === undefined ||\n        mainDocumentId === null ||\n        mainDocumentId === \"\" ||\n        isNaN(mainDocumentId) ||\n        parseInt(mainDocumentId) != mainDocumentId\n    ) {\n        result = {\n            success: false,\n            message: \"Invalid or missing 'mainDocumentId'. Expected an integer value.\"\n        };\n    } else {\n        allFailed = false;\n        mainDocumentId = parseInt(mainDocumentId);\n    }\n\n\n    // attachmentAttributeName\n    if (!attachmentAttributeName || typeof attachmentAttributeName !== 'string' || !attachmentAttributeName.trim()) {\n        result = {\n            success: false,\n            message: \"Invalid or missing 'attachmentAttributeName'. Expected a non-empty string.\"\n        };\n    } else {\n        allFailed = false;\n    }\n\n    // transactionId\n    if (\n        transactionId === undefined ||\n        transactionId === null ||\n        isNaN(transactionId) ||\n        parseInt(transactionId) != transactionId\n    ) {\n        result = {\n            success: false,\n            message: \"Invalid or missing 'transactionId'. Expected an integer value.\"\n        };\n    } else {\n        allFailed = false;\n        transactionId = parseInt(transactionId);\n    }\n\n    // documentNumber\n    if (\n        documentNumber === undefined ||\n        documentNumber === null ||\n        isNaN(documentNumber) ||\n        parseInt(documentNumber) != documentNumber\n    ) {\n        result = {\n            success: false,\n            message: \"Invalid or missing 'documentNumber'. Expected an integer value.\"\n        };\n    } else {\n        allFailed = false;\n        documentNumber = parseInt(documentNumber);\n    }\n\n    // Construct URL\n    if (result.success) {\n\n        const hasValue = v => v !== null && v !== undefined && String(v).trim() !== \"\";\n\n        let context = {};\n\n        if (hasValue(priceBookVarName)) {\n            context.pricebookVarName = priceBookVarName;\n        }\n        else {\n            context.pricebookVarName = defaultPriceBookVarName;\n        }\n\n        const commerce = {};\n\n        if (hasValue(transactionId)) {\n            commerce.id = transactionId;\n        }\n\n        if (hasValue(cacheInstanceId)) {\n            commerce.cacheInstanceId = cacheInstanceId;\n        }\n\n        if (hasValue(processVarName)) {\n            commerce.process = {\n                variableName: processVarName\n            };\n        }\n\n        // Only attach commerce if it has at least one property\n        if (Object.keys(commerce).length > 0) {\n            context.commerce = commerce;\n        }\n\n\n\n\n        // If context is still empty, return null\n        context = Object.keys(context).length > 0 ? context : null;\n        let fullUrl = `/rest/v17/commerceProcesses/${processVarName}/documents/${mainDocumentId}/attachmentAttributes/${attachmentAttributeName}/transactions/${transactionId}/documentNumbers/${documentNumber}`;\n        result = {\n            success: true,\n            documentUrl: fullUrl,\n            context: context\n        };\n    } else if (allFailed) {\n        result = {\n            success: false,\n            message: \"Specify document tracker id or document url or other params processVarName,mainDocumentId,attachmentAttributeName,transactionId,documentNumber\"\n        };\n    }\n}\n\n/** \nconst value = String(match).toUpperCase();\nlet topK = null;\n\nif (value === \"BEST\" || value === \"ALL\") {\n    match = value;\n} else {\n    const m = value.match(/^TOP(\\d+)$/);\n    if (m) {\n        topK = parseInt(m[1], 10);\n        match = \"TOPK\"; // normalized type\n    } else {\n        match = \"BEST\";\n    }\n}\n*/\nresult.match = match;\n//result.topK = topK;\n\nreturn result;"
          },
          "outcomes": {
            "success": "1762414341306"
          },
