        {
          "metadata": {
            "name": "constructLlmOutput",
            "returnType": "object",
            "sourceCode": "let documentTrackerId = $context.$variables.documentTrackerId;\nlet documentUrl = $context.$variables.documentUrl;\nlet toolName = \"\";\nlet processVarName = $context.$triggers.REST.$input.processVarName;\nlet mainDocumentId = $context.$triggers.REST.$input.mainDocumentId;\nlet attachmentAttributeName = $context.$triggers.REST.$input.attachmentAttributeName;\nlet transactionId = $context.$triggers.REST.$input.transactionId;\nlet documentNumber = $context.$triggers.REST.$input.documentNumber;\n\nif(documentTrackerId != null && documentTrackerId != \"\"){\n   toolName = \"documentTrackerIDTool\";\n}\nelse{\n   toolName = \"documentURLTool\";\n}\n\nlet llmOutput = {\"type\":\"toolCall\",\"toolName\" : toolName , \"toolArgument\":{\"documentTrackerId\":documentTrackerId,\"documentUrl\":documentUrl,\"processVarName\":processVarName,\"mainDocumentId\":mainDocumentId,\"attachmentAttributeName\":attachmentAttributeName,\"transactionId\":transactionId,\"documentNumber\":documentNumber}};\n\nreturn llmOutput;"
          },
          "outcomes": {
            "success": "1762420522096"
          },
