                    }
                  ]
                },
                {
                  "id": "1781685476821",
                  "code": "PROCESS_SPREADSHEET_URL",
                  "type": "CODE",
                  "metadata": {
                    "name": "Process Spreadsheet Url",
                    "returnType": "object",
                    "sourceCode": "let result = {};\ntry {\n  let spreadsheetOutput = $context.$nodes.GET_SPREADSHEET_BLOB.DOWNLOAD_SPEARSHEET.$output;\n\n  if (typeof spreadsheetOutput === 'string') {\n    try {\n      spreadsheetOutput = JSON.parse(spreadsheetOutput);\n    } catch (parseError) {\n      spreadsheetOutput = {};\n    }\n  }\n\n  const currentItem = $context.$nodes?.GET_SPREADSHEET_BLOB?.$currentItem || {};\n\n  result = {\n    ...currentItem,\n    actionURL: spreadsheetOutput?.downloadUrl || \"\"\n  };\n} catch (error) {\n  result = {};\n}\n\nreturn result;"
                  },
                  "diagram": {
