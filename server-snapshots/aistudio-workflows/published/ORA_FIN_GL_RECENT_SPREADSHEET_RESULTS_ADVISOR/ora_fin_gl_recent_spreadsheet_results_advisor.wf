        {
          "id": "1781622741960",
          "code": "FILTER_BY_EXPORT_AVAILABLE",
          "type": "CODE",
          "metadata": {
            "name": "Filter by export available",
            "sourceCode": "const decodeRequestParameters = (encoded) => {\n  const empty = {};\n  if (!encoded) {\n    return empty;\n  }\n\n  try {\n    const decodedString = atob(encoded);\n    const parsed = JSON.parse(decodedString);\n    const result = parsed && typeof parsed === \"object\" && !Array.isArray(parsed) ? parsed : empty;\n    return result;\n  } catch (error) {\n    return empty;\n  }\n};\n\nconst asString = (value) => String(value || \"\").trim();\n\nfunction getExcelExportJobs(response) {\n  const result = [];\n  const seen = new Set();\n  const items = Array.isArray(response?.items) ? response.items : [];\n\n  const addJob = ({ title, timeUpdated, processId }) => {\n    const normalizedProcessId = asString(processId);\n    if (!normalizedProcessId || seen.has(normalizedProcessId)) {\n      return;\n    }\n\n    seen.add(normalizedProcessId);\n    result.push({\n      title: asString(title) || \"Spreadsheet Export\",\n      timeUpdated,\n      processId: normalizedProcessId\n    });\n  };\n\n  for (const item of items) {\n    const timeUpdated = item?.timeUpdated;\n    const decoded = decodeRequestParameters(item?.requestParameterInformation);\n    const additionalInfo = decoded?.additionalInfo || {};\n    const itemProcessExecutionId = asString(item?.processExecutionId);\n\n    if (\n      itemProcessExecutionId &&\n      (\n        item?.processContextCode === \"EXPORT_TO_EXCEL\" ||\n        additionalInfo?.jobType === \"EXPORT_TO_EXCEL\"\n      )\n    ) {\n      addJob({\n        title: additionalInfo?.title || decoded?.title,\n        timeUpdated,\n        processId: itemProcessExecutionId\n      });\n      continue;\n    }\n\n    const asyncJobs = Array.isArray(decoded?.asyncJobs) ? decoded.asyncJobs : [];\n    for (const job of asyncJobs) {\n      if (job?.jobType === \"EXPORT_TO_EXCEL\") {\n        addJob({\n          title: job?.subtitle || job?.title,\n          timeUpdated,\n          processId: job?.processExecutionId || job?.processId || job?.requestId\n        });\n      }\n    }\n  }\n\n  return result;\n}\n\nconst result = getExcelExportJobs($context.$nodes.GET_RECENT_ACTIVITY_INSIGHTS.$output);\nreturn result;",
            "returnType": "array",
            "sourceType": "code"
          },
          "diagram": {
            "x": 5170.25,
            "y": 5650
          },
          "outcomes": {
            "success": "1781685173556"
          },
