          "code": "INIT_ACTIONS",
          "id": "1776916639326",
          "inputs": [
            {
              "id": "1776916639326_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "Output should adhere to <oraInsight> standards\n\n<oraInsight>\n{\n  \"title\": ,\n  \"shortDescription\":,\n  \"actionText\": ,\n  \"followUpCommand\":,\n  \"priority\": true/false\n}\n</oraInsight>"
            },
            {
              "id": "1776916639326_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Generate exactly two oraInsight actions and no other text.\n\nHigh-priority action:\n{\n  \"title\": \"Review Critical and High Accounts\",\n  \"shortDescription\": \"Conduct a thorough review of all critical and high accounts to identify potential issues and opportunities for retention.\",\n  \"actionText\": \"Send for Review\",\n  \"followUpCommand\": \"ora.Invoke(\\\"showRiskAccounts\\\",\\\"showRiskAccounts({\\\\\\\"accountType\\\\\\\":\\\\\\\"CriticalHigh\\\\\\\"})\\\")\",\n  \"priority\": true\n}\n\nSecond action:\n{\n  \"title\": \"Create program for all renewal accounts\",\n  \"shortDescription\": \"Create a renewal program for all renewal accounts associated with the selected product.\",\n  \"actionText\": \"Create Program\",\n  \"followUpCommand\": \"ora.Invoke(\\\"createProgram\\\",\\\"createProgram({\\\\\\\"accountType\\\\\\\":\\\\\\\"All\\\\\\\"})\\\")\",\n  \"priority\": true\n}\n\nDo not include raw data, identifiers, or technical details in the output."
            }
          ],
          "type": "LLM",
          "diagram": {
            "x": 8337.5,
            "y": 6592
          }
        },
        {
          "metadata": {
