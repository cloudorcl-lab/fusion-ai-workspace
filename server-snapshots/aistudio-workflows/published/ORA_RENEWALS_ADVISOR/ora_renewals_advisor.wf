        {
          "id": "1781627600846",
          "code": "IS_FORM_SUBMIT",
          "type": "CONDITION",
          "convergenceTargetId": "1778524057041",
          "metadata": {
            "name": "Is Form Submit"
          },
          "diagram": {
            "x": 6537.5,
            "y": 6814
          },
          "outcomes": {
            "true": "1781627627328",
            "false": "1778524057041"
          },
          "inputs": [
            {
              "id": "1781627600846_condition",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.IDENTIFY_ACTION.$output.result=='oraFormSubmit'}}"
            }
          ]
        },
        {
          "id": "1781627627328",
          "code": "RETRIEVE_FORM_PARAMETERS",
          "type": "CODE",
          "metadata": {
            "name": "Retrieve Form Parameters",
            "returnType": "object",
            "sourceCode": "let result = {\n  formId: \"\",\n  targetProductId: null,\n  targetProductName: null,\n  ownedProductId: null,\n  ownedProductName: null,\n  accountId: null,\n  accountIdList: null,\n  accountIdsList: null,\n  attributes: {}\n};\n\ntry {\n  const restInput = $context.$triggers?.REST?.$input || {};\n  let rawAction = restInput.OraAction || $context.$app?.$OraAction || \"\";\n\n  if (typeof rawAction !== \"string\") {\n    if (rawAction && typeof rawAction === \"object\") {\n      rawAction = rawAction.OraAction || JSON.stringify(rawAction);\n    } else {\n      rawAction = String(rawAction || \"\");\n    }\n  }\n\n  try {\n    const parsed = JSON.parse(rawAction);\n    if (parsed && typeof parsed === \"object\" && parsed.OraAction) {\n      rawAction = parsed.OraAction;\n    }\n  } catch (e) {\n  }\n\n  const formMatch = rawAction.match(\n    /<oraFormSubmit\\s+id=[\"']([^\"']*)[\"'][^>]*>([\\s\\S]*?)<\\/oraFormSubmit>/\n  );\n\n  const cleanValue = value => {\n    if (value === null || value === undefined) {\n      return null;\n    }\n    const text = decodeURIComponent(String(value)).replace(/\\+/g, \" \").trim();\n    return text === \"\" ? null : text;\n  };\n\n  const extractBetween = (text, startToken, endToken) => {\n    if (!text || !text.includes(startToken)) {\n      return null;\n    }\n\n    const afterStart = text.split(startToken)[1] || \"\";\n    if (!endToken || !afterStart.includes(endToken)) {\n      return cleanValue(afterStart);\n    }\n\n    return cleanValue(afterStart.split(endToken)[0]);\n  };\n\n  if (formMatch) {\n    const formId = formMatch[1] || \"\";\n    const jsonString = formMatch[2] || \"[]\";\n\n    let attributes = {};\n    try {\n      const parsedArray = JSON.parse(jsonString);\n      if (Array.isArray(parsedArray)) {\n        attributes = parsedArray.reduce((acc, item) => {\n          if (item && item.id) {\n            acc[item.id] = item.value;\n          }\n          return acc;\n        }, {});\n      }\n    } catch (e) {\n      attributes = {};\n    }\n\n    const targetProductId =\n      extractBetween(formId, \"targetProductId_\", \"_targetProductName_\") ||\n      extractBetween(formId, \"targetProductId_\", \"_ownedProductId_\") ||\n      extractBetween(formId, \"targetProductId_\", \"_accountIdList_\") ||\n      extractBetween(formId, \"targetProductId_\", \"_accountIdsList_\") ||\n      extractBetween(formId, \"targetProductId_\", null);\n\n    const targetProductName =\n      extractBetween(formId, \"_targetProductName_\", \"_ownedProductId_\") ||\n      extractBetween(formId, \"_targetProductName_\", \"_accountIdList_\") ||\n      extractBetween(formId, \"_targetProductName_\", \"_accountIdsList_\") ||\n      extractBetween(formId, \"_targetProductName_\", \"_accountId_\") ||\n      extractBetween(formId, \"_targetProductName_\", null);\n\n    const ownedProductId =\n      extractBetween(formId, \"ownedProductId_\", \"_targetProductId_\") ||\n      extractBetween(formId, \"ownedProductId_\", \"_targetProductName_\") ||\n      extractBetween(formId, \"ownedProductId_\", null);\n\n    const ownedProductName =\n      extractBetween(formId, \"_ownedProductName_\", \"_accountIdList_\") ||\n      extractBetween(formId, \"_ownedProductName_\", \"_accountIdsList_\") ||\n      extractBetween(formId, \"_ownedProductName_\", null);\n\n    const accountId =\n      extractBetween(formId, \"_accountId_\", null) ||\n      extractBetween(formId, \"accountId_\", null);\n\n    const accountIdList =\n      extractBetween(formId, \"accountIdList_\", \"_ownedProductName_\") ||\n      extractBetween(formId, \"accountIdList_\", null);\n\n    const accountIdsList =\n      extractBetween(formId, \"accountIdsList_\", \"_ownedProductName_\") ||\n      extractBetween(formId, \"accountIdsList_\", null) ||\n      accountIdList;\n\n    result = {\n      formId: formId,\n      targetProductId: targetProductId,\n      targetProductName: targetProductName,\n      ownedProductId: ownedProductId,\n      ownedProductName: ownedProductName,\n      accountId: accountId,\n      accountIdList: accountIdList,\n      accountIdsList: accountIdsList,\n      attributes: attributes\n    };\n  }\n} catch (error) {\n  result = {\n    formId: \"\",\n    targetProductId: null,\n    targetProductName: null,\n    ownedProductId: null,\n    ownedProductName: null,\n    accountId: null,\n    accountIdList: null,\n    accountIdsList: null,\n    attributes: {}\n  };\n}\n\nreturn result;"
          },
          "diagram": {
            "x": 6087.5,
            "y": 7036
          },
          "outcomes": {
            "success": "1778524057041"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "name": "InvokeAction Switch"
          },
          "outcomes": {
