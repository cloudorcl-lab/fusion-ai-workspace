            }
          ]
        },
        {
          "id": "1781887128880",
          "code": "FETCHING_SEGMENT_ID",
          "type": "CODE",
          "metadata": {
            "description": "",
            "name": "Fetching Segment Id",
            "returnType": "object",
            "sourceCode": "let result = [];\ntry {\n\n  let segmentId = null;\n  const responseHeaders = $context.$nodes?.CREATE_SEGMENT?.$responseHeaders;\n  if (responseHeaders) {\n    const location = responseHeaders['location'];\n    if (location && Array.isArray(location) && location.length > 0) {\n      segmentId = location[0].split(\"/\").pop();\n    }\n  }\n  return segmentId || \"Empty\";\n} catch (error) {\n  // On error, return empty array as per return type\n  result = {};\n}"
          },
          "diagram": {
            "x": 5010.5,
            "y": 8368
          },
          "outcomes": {
            "success": "1781205614299"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1781205614299",
          "code": "BUILD_CREATE_PROGRAM_PAYLOAD",
          "type": "CODE",
          "metadata": {
            "description": "",
            "name": "Build Create Program Payload",
            "returnType": "object",
            "sourceCode": "let result = {};\n\ntry {\n  const input = $context.$triggers.REST.$input || {};\n  const oraAction = input.OraAction || \"\";\n  const oraAppContext = input.OraAppContext || \"\";\n\n  function getValue(attributes, key) {\n    return attributes[key] !== undefined && attributes[key] !== \"\"\n      ? attributes[key]\n      : null;\n  }\n\n  function getContextValue(contextString, key) {\n    if (!contextString) {\n      return null;\n    }\n\n    const regex = new RegExp(key + \"\\\\s*[=:]\\\\s*([\\\\s\\\\S]*?)(?=,\\\\s*\\\\w+\\\\s*[=:]|$)\");\n    const match = contextString.match(regex);\n\n    return match ? match[1].trim() : null;\n  }\n\n  function getTargetProductIdFromFormId(formId) {\n    const match = formId.match(/targetProductId_([\\s\\S]*?)_targetProductName_/);\n    return match ? match[1] : null;\n  }\n\n  function getTargetProductNameFromFormId(formId) {\n    const match = formId.match(/_targetProductName_([\\s\\S]*)$/);\n    return match ? match[1] : null;\n  }\n\n  const formMatch = oraAction.match(\n    /<oraFormSubmit\\s+id=[\"']([^\"']*)[\"'][^>]*>([\\s\\S]*?)<\\/oraFormSubmit>/\n  );\n\n  if (!formMatch) {\n    result = {};\n  } else {\n    const formId = formMatch[1] || \"\";\n    const jsonString = formMatch[2] || \"[]\";\n\n    let targetProductId = getTargetProductIdFromFormId(formId)\n     || getContextValue(oraAppContext, \"targetProductId\");\n\n    let targetProductName = getTargetProductNameFromFormId(formId)\n     || getContextValue(oraAppContext, \"targetProductName\");\n      \n    let segmentId = $context.$nodes.FETCHING_SEGMENT_ID.$output.result || \"\";\n    let attributes = {};\n\n    try {\n      const parsedArray = JSON.parse(jsonString);\n\n      attributes = parsedArray.reduce((acc, item) => {\n        acc[item.id] = item.value;\n        return acc;\n      }, {});\n    } catch (e) {\n      attributes = {};\n    }\n\n    result = {\n      name: getValue(attributes, \"ProgramName\"),\n      objective: getValue(attributes, \"ProgramObjective\"),\n      externalCode: getValue(attributes, \"ExternalTrackingCode\"),\n\n      programAttributes: {\n        items: [\n          {\n            key: \"product\",\n            value: targetProductId,\n            displayValue: targetProductName\n          },\n          {\n            key: \"regions\",\n            value: \"all\",\n            displayValue: \"All\"\n          },\n          {\n            key: \"industry\",\n            value: \"all\",\n            displayValue: \"All\"\n          },\n          {\n            key: \"programType\",\n            value: \"renewal\",\n            displayValue: \"Renewal\"\n          }\n        ]\n      },\n      programSegments: {\n        items: [\n          {\n            \"segment\": {\n              id: segmentId\n            }\n          }\n        ]\n      }\n    };\n  }\n} catch (error) {\n  result = {};\n}\n\nreturn result;",
            "sourceType": "code"
          },
          "diagram": {
            "x": 5004.5,
            "y": 8590
          },
          "outcomes": {
            "success": "1781205614300"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
