          }
        },
        {
          "metadata": {
            "name": "Process Data for CSM Email",
            "returnType": "object",
            "sourceCode": "let result = {\n  accounts: [],\n  count: 0,\n  riskGroup: \"Critical and High\",\n  accountType: \"CriticalHigh\",\n  selectedRiskGroups: [\"Critical\", \"High\"],\n  subject: \"Critical and High Accounts Risk Summary\",\n  firstLine: \"Below is a summary of 0 accounts currently classified as critical and high risk:\",\n  emailBodyHtml: \"\"\n};\n\ntry {\n  const normalizeRisk = value => {\n    const risk = String(value || \"\").trim().toLowerCase();\n    if (risk === \"critical\") return \"Critical\";\n    if (risk === \"high\") return \"High\";\n    if (risk === \"medium\" || risk === \"moderate\") return \"Medium\";\n    if (risk === \"stable\") return \"Stable\";\n    return \"\";\n  };\n\n  const parseAmount = value => {\n    if (value === null || value === undefined || value === \"\") return 0;\n    if (typeof value === \"number\") return Number.isFinite(value) ? value : 0;\n\n    const text = String(value).trim().replace(/[$,\\s]/g, \"\").toUpperCase();\n    const match = text.match(/^(-?\\d+(?:\\.\\d+)?)([KMB])?$/);\n    if (!match) return Number(text) || 0;\n\n    const amount = Number(match[1]);\n    const suffix = match[2] || \"\";\n    if (!Number.isFinite(amount)) return 0;\n    if (suffix === \"B\") return amount * 1000000000;\n    if (suffix === \"M\") return amount * 1000000;\n    if (suffix === \"K\") return amount * 1000;\n    return amount;\n  };\n\n  const formatArr = value => {\n    const amount = parseAmount(value);\n    const abs = Math.abs(amount);\n    if (abs >= 1000000000) return (amount / 1000000000).toFixed(2) + \"B\";\n    if (abs >= 1000000) return (amount / 1000000).toFixed(2) + \"M\";\n    if (abs >= 1000) return (amount / 1000).toFixed(2) + \"K\";\n    return amount.toFixed(2);\n  };\n\n  const buildAccountDescription = account => {\n    const normalizeSentence = value => {\n      let text = String(value || \"\").replace(/\\s+/g, \" \").trim();\n      if (!text) return \"\";\n      text = text.replace(/\\s+([,.;:!?])/g, \"$1\");\n      if (!/[.!?]$/.test(text)) text += \".\";\n      return text;\n    };\n\n    const isTechnicalRiskText = value => /top risk driver|model importance|strong influence|weak influence|shap|=\\s*[^,;]+\\s*\\(model/i.test(String(value || \"\"));\n\n    const risk = normalizeRisk(account?.riskClassification) || \"Product\";\n    const friendlyFields = [\n      account?.accountDescription,\n      account?.accountRiskDescription,\n      account?.riskDescription,\n      account?.riskSummary,\n      account?.summary,\n      account?.description,\n      account?.riskReason\n    ];\n\n    for (const value of friendlyFields) {\n      const candidate = normalizeSentence(value);\n      const wordCount = candidate.split(\" \").filter(Boolean).length;\n      if (candidate && wordCount > 3 && !isTechnicalRiskText(candidate)) {\n        return candidate;\n      }\n    }\n\n    const entriesText = Object.keys(account || {})\n      .map(key => key + \" \" + String(account?.[key] ?? \"\"))\n      .join(\" \");\n    const detailText = String(account?.riskDetailedExplainer || account?.riskFactors || \"\");\n    const allText = (detailText + \" \" + entriesText).replace(/\\s+/g, \" \");\n    const lower = allText.toLowerCase();\n\n    const addUnique = (items, value) => {\n      if (value && !items.includes(value)) items.push(value);\n    };\n\n    const prettifyDriver = value => {\n      const raw = String(value || \"\")\n        .replace(/_/g, \" \")\n        .replace(/\\s*=\\s*[\\s\\S]*$/, \"\")\n        .replace(/\\s*\\([^)]*\\)/g, \"\")\n        .replace(/\\s+/g, \" \")\n        .trim();\n      const text = raw.toLowerCase();\n      if (!text) return \"\";\n      if (text.includes(\"open sev1\")) return \"open Sev1 tickets\";\n      if (text.includes(\"sev1\")) return \"Sev1 ticket history\";\n      if (text.includes(\"system stability\")) return \"poor system stability\";\n      if (text.includes(\"engagement\")) return \"low engagement\";\n      if (text.includes(\"usage\")) return \"usage trends\";\n      if (text === \"arr\" || text.includes(\"annual recurring revenue\")) return \"ARR exposure\";\n      if (text.includes(\"renewal\")) return \"renewal timing\";\n      return text;\n    };\n\n    const joinPhrases = items => {\n      const unique = items.filter(Boolean).filter((item, index, source) => source.indexOf(item) === index);\n      if (unique.length === 0) return \"\";\n      if (unique.length === 1) return unique[0];\n      if (unique.length === 2) return unique[0] + \" and \" + unique[1];\n      return unique.slice(0, -1).join(\", \") + \", and \" + unique[unique.length - 1];\n    };\n\n    const drivers = [];\n    const trends = [];\n    const topDriverMatch = allText.match(/Top Risk Driver:\\s*([^;]+)/i);\n    if (topDriverMatch) addUnique(drivers, prettifyDriver(topDriverMatch[1]));\n\n    if (/open\\s+sev\\s*1|open\\s+sev1|opensev1/i.test(allText)) {\n      addUnique(drivers, \"open Sev1 tickets\");\n    }\n    if (/system\\s+stability/i.test(allText)) {\n      addUnique(drivers, /downsell|poor|issue|low|risk/i.test(allText) ? \"poor system stability\" : \"system stability concerns\");\n    }\n    if (/\\barr\\b|annual\\s+recurring\\s+revenue/i.test(allText)) {\n      if (/Top Risk Driver:\\s*ARR/i.test(allText) || /low\\s+arr|arr\\s*=\\s*0/i.test(allText)) {\n        addUnique(drivers, \"ARR exposure\");\n      }\n    }\n    if (/engagement[^.;,]*low|low[^.;,]*engagement/i.test(lower)) {\n      addUnique(trends, \"low engagement\");\n    }\n    if (/usage[^.;,]*low|low[^.;,]*usage|adoption[^.;,]*low|low[^.;,]*adoption/i.test(lower)) {\n      addUnique(trends, \"usage trends\");\n    }\n\n    const driverText = joinPhrases(drivers);\n    const trendText = joinPhrases(trends);\n    if (driverText && trendText) {\n      return risk + \" risk driven by \" + driverText + \" with \" + trendText + \".\";\n    }\n    if (driverText) {\n      return risk + \" risk driven by \" + driverText + \".\";\n    }\n    if (trendText) {\n      return risk + \" risk driven by \" + trendText + \".\";\n    }\n\n    const fallback = normalizeSentence(detailText || account?.riskReason || account?.riskFactors);\n    if (fallback && !isTechnicalRiskText(fallback)) return fallback;\n    return risk + \" risk requires review based on product renewal, usage, and account health signals.\";\n  };\n\n  const escapeHtml = value => String(value ?? \"\")\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n\n  const compactText = value => {\n    const words = String(value || \"Not available\").replace(/\\s+/g, \" \").trim().split(\" \").filter(Boolean);\n    if (words.length <= 18) return words.join(\" \") || \"Not available\";\n    return words.slice(0, 18).join(\" \") + \"...\";\n  };\n\n  const getActionString = () => {\n    const restInput = $context.$triggers?.REST?.$input || {};\n    let rawAction = restInput.OraAction || $context.$app?.$OraAction || \"\";\n\n    if (typeof rawAction !== \"string\") {\n      if (rawAction && typeof rawAction === \"object\") {\n        rawAction = rawAction.OraAction || JSON.stringify(rawAction);\n      } else {\n        rawAction = String(rawAction || \"\");\n      }\n    }\n\n    try {\n      const parsed = JSON.parse(rawAction);\n      if (parsed && typeof parsed === \"object\" && parsed.OraAction) {\n        rawAction = parsed.OraAction;\n      }\n    } catch (e) {\n    }\n\n    return rawAction;\n  };\n\n  const resolveGroups = accountType => {\n    const normalized = String(accountType || \"CriticalHigh\").trim().toLowerCase().replace(/[\\s_+-]/g, \"\");\n    if (normalized === \"criticalhigh\" || normalized === \"criticalandhigh\" || normalized === \"priorityaction\") {\n      return [\"Critical\", \"High\"];\n    }\n    if (normalized === \"critical\") return [\"Critical\"];\n    if (normalized === \"high\") return [\"High\"];\n    if (normalized === \"medium\" || normalized === \"moderate\") return [\"Medium\"];\n    if (normalized === \"stable\") return [\"Stable\"];\n    return [\"Critical\", \"High\"];\n  };\n\n  let selectedAccountType = \"CriticalHigh\";\n  const actionValue = getActionString();\n  const actionMatch = actionValue.match(/sendEmailToCSM\\(([\\s\\S]*)\\)/);\n  if (actionMatch && actionMatch[1]) {\n    let payloadText = actionMatch[1].trim();\n    if ((payloadText.startsWith(\"\\\"\") && payloadText.endsWith(\"\\\"\")) || (payloadText.startsWith(\"'\") && payloadText.endsWith(\"'\"))) {\n      payloadText = payloadText.slice(1, -1);\n    }\n\n    try {\n      const parsedPayload = JSON.parse(payloadText);\n      selectedAccountType = parsedPayload?.accountType || selectedAccountType;\n    } catch (e1) {\n      try {\n        const parsedPayload = JSON.parse(payloadText.replace(/\\\\\\\"/g, \"\\\"\").replace(/\\\\\\\\/g, \"\\\\\"));\n        selectedAccountType = parsedPayload?.accountType || selectedAccountType;\n      } catch (e2) {\n      }\n    }\n  }\n  const accountType = selectedAccountType;\n  const selectedRiskGroups = resolveGroups(accountType);\n  const riskGroup = selectedRiskGroups.length === 2 ? \"Critical and High\" : selectedRiskGroups[0];\n  const riskGroupForSentence = riskGroup.toLowerCase();\n  const normalizedAccountType = selectedRiskGroups.length === 2 ? \"CriticalHigh\" : selectedRiskGroups[0];\n\n  const accounts = $context.$nodes?.GET_RENEWAL_ACCOUNTS?.$output?.items || [];\n  const filteredAccounts = accounts\n    .map(account => {\n      const arrRaw = parseAmount(account?.arr ?? account?.ARR ?? account?.annualRecurringRevenue ?? 0);\n      const normalizedAccount = {\n        ...account,\n        riskClassification: normalizeRisk(account?.riskClassification),\n        arrRaw: arrRaw,\n        arr: formatArr(arrRaw)\n      };\n      normalizedAccount.accountDescription = buildAccountDescription(normalizedAccount);\n      return normalizedAccount;\n    })\n    .filter(account => selectedRiskGroups.includes(account.riskClassification))\n    .sort((a, b) => Number(b?.arrRaw ?? 0) - Number(a?.arrRaw ?? 0))\n    .slice(0, 50);\n\n  const subject = riskGroup + \" Accounts Risk Summary\";\n  const firstLine = \"Below is a summary of \" + filteredAccounts.length + \" accounts currently classified as \" + riskGroupForSentence + \" risk:\";\n\n  const rowsHtml = filteredAccounts.map(account => {\n    const usage = account?.usageLevel || account?.usage || account?.engagementLevel || account?.adoptionLevel || \"Not available\";\n    const riskScore = account?.riskScore ?? account?.score ?? account?.riskClassification ?? \"Not available\";\n    const accountName = account?.accountName || account?.name || \"Unnamed account\";\n    const renewalDate = account?.renewalDate || \"Not available\";\n    const keyRisks = account?.accountDescription || buildAccountDescription(account);\n\n    return \"<tr>\" +\n      \"<td style=\\\"border:1px solid #d0d5dd;padding:8px;text-align:left;\\\">\" + escapeHtml(accountName) + \"</td>\" +\n      \"<td style=\\\"border:1px solid #d0d5dd;padding:8px;text-align:left;\\\">\" + escapeHtml(account?.arr || \"0.00\") + \"</td>\" +\n      \"<td style=\\\"border:1px solid #d0d5dd;padding:8px;text-align:left;\\\">\" + escapeHtml(renewalDate) + \"</td>\" +\n      \"<td style=\\\"border:1px solid #d0d5dd;padding:8px;text-align:left;\\\">\" + escapeHtml(usage) + \"</td>\" +\n      \"<td style=\\\"border:1px solid #d0d5dd;padding:8px;text-align:left;\\\">\" + escapeHtml(riskScore) + \"</td>\" +\n      \"<td style=\\\"border:1px solid #d0d5dd;padding:8px;text-align:left;\\\">\" + escapeHtml(keyRisks) + \"</td>\" +\n      \"</tr>\";\n  }).join(\"\");\n\n  const emailBodyHtml =\n    \"<p>\" + escapeHtml(firstLine) + \"</p>\" +\n    \"<table style=\\\"border-collapse:collapse;width:100%;font-family:Arial,sans-serif;font-size:13px;\\\">\" +\n    \"<thead><tr>\" +\n    \"<th style=\\\"border:1px solid #d0d5dd;background:#f2f4f7;padding:8px;text-align:left;\\\">Account</th>\" +\n    \"<th style=\\\"border:1px solid #d0d5dd;background:#f2f4f7;padding:8px;text-align:left;\\\">ARR</th>\" +\n    \"<th style=\\\"border:1px solid #d0d5dd;background:#f2f4f7;padding:8px;text-align:left;\\\">Renewal Date</th>\" +\n    \"<th style=\\\"border:1px solid #d0d5dd;background:#f2f4f7;padding:8px;text-align:left;\\\">Usage</th>\" +\n    \"<th style=\\\"border:1px solid #d0d5dd;background:#f2f4f7;padding:8px;text-align:left;\\\">Risk Score</th>\" +\n    \"<th style=\\\"border:1px solid #d0d5dd;background:#f2f4f7;padding:8px;text-align:left;\\\">Key Risks</th>\" +\n    \"</tr></thead><tbody>\" +\n    rowsHtml +\n    \"</tbody></table>\" +\n    \"<p>Sent from Marketing Command Center</p>\";\n\n  result = {\n    accounts: filteredAccounts,\n    count: filteredAccounts.length,\n    riskGroup: riskGroup,\n    accountType: normalizedAccountType,\n    selectedRiskGroups: selectedRiskGroups,\n    subject: subject,\n    firstLine: firstLine,\n    emailBodyHtml: emailBodyHtml\n  };\n} catch (error) {\n  result = {\n    accounts: [],\n    count: 0,\n    riskGroup: \"Critical and High\",\n    accountType: \"CriticalHigh\",\n    selectedRiskGroups: [\"Critical\", \"High\"],\n    subject: \"Critical and High Accounts Risk Summary\",\n    firstLine: \"Below is a summary of 0 accounts currently classified as critical and high risk:\",\n    emailBodyHtml: \"<p>Below is a summary of 0 accounts currently classified as critical and high risk:</p><p>Sent from Marketing Command Center</p>\"\n  };\n}\n\nreturn result;",
            "sourceType": "code"
          },
          "outcomes": {
            "success": "1778538581275"
          },
          "code": "PROCESS_DATA_FOR_CSM_EMAIL",
