        {
          "metadata": {
            "name": "Get Top Critical Accounts",
            "returnType": "object",
            "sourceCode": "let result = {\n  accounts: [],\n  count: 0,\n  riskGroup: \"Critical and High\",\n  accountType: \"CriticalHigh\",\n  selectedRiskGroups: [\"Critical\", \"High\"],\n  subject: \"Critical and High Accounts Risk Summary\",\n  firstLine: \"Below is a summary of 0 accounts currently classified as critical and high risk:\",\n  emailBodyHtml: \"\"\n};\n\ntry {\n  const normalizeRisk = value => {\n    const risk = String(value || \"\").trim().toLowerCase();\n    if (risk === \"critical\") return \"Critical\";\n    if (risk === \"high\") return \"High\";\n    if (risk === \"medium\" || risk === \"moderate\") return \"Medium\";\n    if (risk === \"stable\") return \"Stable\";\n    return \"\";\n  };\n\n  const parseAmount = value => {\n    if (value === null || value === undefined || value === \"\") return 0;\n    if (typeof value === \"number\") return Number.isFinite(value) ? value : 0;\n\n    const text = String(value).trim().replace(/[$,\\s]/g, \"\").toUpperCase();\n    const match = text.match(/^(-?\\d+(?:\\.\\d+)?)([KMB])?$/);\n    if (!match) return Number(text) || 0;\n\n    const amount = Number(match[1]);\n    const suffix = match[2] || \"\";\n    if (!Number.isFinite(amount)) return 0;\n    if (suffix === \"B\") return amount * 1000000000;\n    if (suffix === \"M\") return amount * 1000000;\n    if (suffix === \"K\") return amount * 1000;\n    return amount;\n  };\n\n  const formatArr = value => {\n    const amount = parseAmount(value);\n    const abs = Math.abs(amount);\n    if (abs >= 1000000000) return (amount / 1000000000).toFixed(2) + \"B\";\n    if (abs >= 1000000) return (amount / 1000000).toFixed(2) + \"M\";\n    if (abs >= 1000) return (amount / 1000).toFixed(2) + \"K\";\n    return amount.toFixed(2);\n  };\n\n  const buildAccountDescription = account => {\n    const normalizeSentence = value => {\n      let text = String(value || \"\").replace(/\\s+/g, \" \").trim();\n      if (!text) return \"\";\n      text = text.replace(/\\s+([,.;:!?])/g, \"$1\");\n      if (!/[.!?]$/.test(text)) text += \".\";\n      return text;\n    };\n\n    const isTechnicalRiskText = value => /top risk driver|model importance|strong influence|weak influence|shap|=\\s*[^,;]+\\s*\\(model/i.test(String(value || \"\"));\n\n    const risk = normalizeRisk(account?.riskClassification) || \"Product\";\n    const friendlyFields = [\n      account?.accountDescription,\n      account?.accountRiskDescription,\n      account?.riskDescription,\n      account?.riskSummary,\n      account?.summary,\n      account?.description,\n      account?.riskReason\n    ];\n\n    for (const value of friendlyFields) {\n      const candidate = normalizeSentence(value);\n      const wordCount = candidate.split(\" \").filter(Boolean).length;\n      if (candidate && wordCount > 3 && !isTechnicalRiskText(candidate)) {\n        return candidate;\n      }\n    }\n\n    const entriesText = Object.keys(account || {})\n      .map(key => key + \" \" + String(account?.[key] ?? \"\"))\n      .join(\" \");\n    const detailText = String(account?.riskDetailedExplainer || account?.riskFactors || \"\");\n    const allText = (detailText + \" \" + entriesText).replace(/\\s+/g, \" \");\n    const lower = allText.toLowerCase();\n\n    const addUnique = (items, value) => {\n      if (value && !items.includes(value)) items.push(value);\n    };\n\n    const prettifyDriver = value => {\n      const raw = String(value || \"\")\n        .replace(/_/g, \" \")\n        .replace(/\\s*=\\s*[\\s\\S]*$/, \"\")\n        .replace(/\\s*\\([^)]*\\)/g, \"\")\n        .replace(/\\s+/g, \" \")\n        .trim();\n      const text = raw.toLowerCase();\n      if (!text) return \"\";\n      if (text.includes(\"open sev1\")) return \"open Sev1 tickets\";\n      if (text.includes(\"sev1\")) return \"Sev1 ticket history\";\n      if (text.includes(\"system stability\")) return \"poor system stability\";\n      if (text.includes(\"engagement\")) return \"low engagement\";\n      if (text.includes(\"usage\")) return \"usage trends\";\n      if (text === \"arr\" || text.includes(\"annual recurring revenue\")) return \"ARR exposure\";\n      if (text.includes(\"renewal\")) return \"renewal timing\";\n      return text;\n    };\n\n    const joinPhrases = items => {\n      const unique = items.filter(Boolean).filter((item, index, source) => source.indexOf(item) === index);\n      if (unique.length === 0) return \"\";\n      if (unique.length === 1) return unique[0];\n      if (unique.length === 2) return unique[0] + \" and \" + unique[1];\n      return unique.slice(0, -1).join(\", \") + \", and \" + unique[unique.length - 1];\n    };\n\n    const drivers = [];\n    const trends = [];\n    const topDriverMatch = allText.match(/Top Risk Driver:\\s*([^;]+)/i);\n    if (topDriverMatch) addUnique(drivers, prettifyDriver(topDriverMatch[1]));\n\n    if (/open\\s+sev\\s*1|open\\s+sev1|opensev1/i.test(allText)) {\n      addUnique(drivers, \"open Sev1 tickets\");\n    }\n    if (/system\\s+stability/i.test(allText)) {\n      addUnique(drivers, /downsell|poor|issue|low|risk/i.test(allText) ? \"poor system stability\" : \"system stability concerns\");\n    }\n    if (/\\barr\\b|annual\\s+recurring\\s+revenue/i.test(allText)) {\n      if (/Top Risk Driver:\\s*ARR/i.test(allText) || /low\\s+arr|arr\\s*=\\s*0/i.test(allText)) {\n        addUnique(drivers, \"ARR exposure\");\n      }\n    }\n    if (/engagement[^.;,]*low|low[^.;,]*engagement/i.test(lower)) {\n      addUnique(trends, \"low engagement\");\n    }\n    if (/usage[^.;,]*low|low[^.;,]*usage|adoption[^.;,]*low|low[^.;,]*adoption/i.test(lower)) {\n      addUnique(trends, \"usage trends\");\n    }\n\n    const driverText = joinPhrases(drivers);\n    const trendText = joinPhrases(trends);\n    if (driverText && trendText) {\n      return risk + \" risk driven by \" + driverText + \" with \" + trendText + \".\";\n    }\n    if (driverText) {\n      return risk + \" risk driven by \" + driverText + \".\";\n    }\n    if (trendText) {\n      return risk + \" risk driven by \" + trendText + \".\";\n    }\n\n    const fallback = normalizeSentence(detailText || account?.riskReason || account?.riskFactors);\n    if (fallback && !isTechnicalRiskText(fallback)) return fallback;\n    return risk + \" risk requires review based on product renewal, usage, and account health signals.\";\n  };\n\n  const escapeHtml = value => String(value ?? \"\")\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n\n  const getActionString = () => {\n    const restInput = $context.$triggers?.REST?.$input || {};\n    let rawAction = restInput.OraAction || $context.$app?.$OraAction || \"\";\n\n    if (typeof rawAction !== \"string\") {\n      if (rawAction && typeof rawAction === \"object\") {\n        rawAction = rawAction.OraAction || JSON.stringify(rawAction);\n      } else {\n        rawAction = String(rawAction || \"\");\n      }\n    }\n\n    try {\n      const parsed = JSON.parse(rawAction);\n      if (parsed && typeof parsed === \"object\" && parsed.OraAction) {\n        rawAction = parsed.OraAction;\n      }\n    } catch (e) {\n    }\n\n    return rawAction;\n  };\n\n  const resolveGroups = accountType => {\n    const normalized = String(accountType || \"CriticalHigh\").trim().toLowerCase().replace(/[\\s_+-]/g, \"\");\n    if (normalized === \"criticalhigh\" || normalized === \"criticalandhigh\" || normalized === \"priorityaction\") {\n      return [\"Critical\", \"High\"];\n    }\n    if (normalized === \"critical\") return [\"Critical\"];\n    if (normalized === \"high\") return [\"High\"];\n    if (normalized === \"medium\" || normalized === \"moderate\") return [\"Medium\"];\n    if (normalized === \"stable\") return [\"Stable\"];\n    return [\"Critical\", \"High\"];\n  };\n\n  let selectedAccountType = \"CriticalHigh\";\n  const actionValue = getActionString();\n  const actionMatch = actionValue.match(/showRiskAccounts\\(([\\s\\S]*)\\)/);\n  if (actionMatch && actionMatch[1]) {\n    let payloadText = actionMatch[1].trim();\n    if ((payloadText.startsWith(\"\\\"\") && payloadText.endsWith(\"\\\"\")) || (payloadText.startsWith(\"'\") && payloadText.endsWith(\"'\"))) {\n      payloadText = payloadText.slice(1, -1);\n    }\n\n    try {\n      const parsedPayload = JSON.parse(payloadText);\n      selectedAccountType = parsedPayload?.accountType || selectedAccountType;\n    } catch (e1) {\n      try {\n        const parsedPayload = JSON.parse(payloadText.replace(/\\\\\\\"/g, \"\\\"\").replace(/\\\\\\\\/g, \"\\\\\"));\n        selectedAccountType = parsedPayload?.accountType || selectedAccountType;\n      } catch (e2) {\n      }\n    }\n  }\n  const accountType = selectedAccountType;\n  const selectedRiskGroups = resolveGroups(accountType);\n  const riskGroup = selectedRiskGroups.length === 2 ? \"Critical and High\" : selectedRiskGroups[0];\n  const riskGroupForSentence = riskGroup.toLowerCase();\n  const normalizedAccountType = selectedRiskGroups.length === 2 ? \"CriticalHigh\" : selectedRiskGroups[0];\n\n  const accounts = $context.$nodes?.GET_RENEWAL_ACCOUNTS?.$output?.items || [];\n  const filteredAccounts = accounts\n    .map(account => {\n      const arrRaw = parseAmount(account?.arr ?? account?.ARR ?? account?.annualRecurringRevenue ?? 0);\n      const normalizedAccount = {\n        ...account,\n        riskClassification: normalizeRisk(account?.riskClassification),\n        arrRaw: arrRaw,\n        arr: formatArr(arrRaw)\n      };\n      normalizedAccount.accountDescription = buildAccountDescription(normalizedAccount);\n      return normalizedAccount;\n    })\n    .filter(account => selectedRiskGroups.includes(account.riskClassification))\n    .sort((a, b) => Number(b?.arrRaw ?? 0) - Number(a?.arrRaw ?? 0))\n    .slice(0, 50);\n\n  const subject = riskGroup + \" Accounts Risk Summary\";\n  const firstLine = \"Below is a summary of \" + filteredAccounts.length + \" accounts currently classified as \" + riskGroupForSentence + \" risk:\";\n\n  const rowsHtml = filteredAccounts.map(account => {\n    const usage = account?.usageLevel || account?.usage || account?.engagementLevel || account?.adoptionLevel || \"Not available\";\n    const riskScore = account?.riskScore ?? account?.score ?? account?.riskClassification ?? \"Not available\";\n    const accountName = account?.accountName || account?.name || \"Unnamed account\";\n    const renewalDate = account?.renewalDate || \"Not available\";\n    const keyRisks = account?.accountDescription || buildAccountDescription(account);\n\n    return \"<tr>\" +\n      \"<td style=\\\"border:1px solid #d0d5dd;padding:8px;text-align:left;\\\">\" + escapeHtml(accountName) + \"</td>\" +\n      \"<td style=\\\"border:1px solid #d0d5dd;padding:8px;text-align:left;\\\">\" + escapeHtml(account?.arr || \"0.00\") + \"</td>\" +\n      \"<td style=\\\"border:1px solid #d0d5dd;padding:8px;text-align:left;\\\">\" + escapeHtml(renewalDate) + \"</td>\" +\n      \"<td style=\\\"border:1px solid #d0d5dd;padding:8px;text-align:left;\\\">\" + escapeHtml(usage) + \"</td>\" +\n      \"<td style=\\\"border:1px solid #d0d5dd;padding:8px;text-align:left;\\\">\" + escapeHtml(riskScore) + \"</td>\" +\n      \"<td style=\\\"border:1px solid #d0d5dd;padding:8px;text-align:left;\\\">\" + escapeHtml(keyRisks) + \"</td>\" +\n      \"</tr>\";\n  }).join(\"\");\n\n  const emailBodyHtml =\n    \"<p>\" + escapeHtml(firstLine) + \"</p>\" +\n    \"<table style=\\\"border-collapse:collapse;width:100%;font-family:Arial,sans-serif;font-size:13px;\\\">\" +\n    \"<thead><tr>\" +\n    \"<th style=\\\"border:1px solid #d0d5dd;background:#f2f4f7;padding:8px;text-align:left;\\\">Account</th>\" +\n    \"<th style=\\\"border:1px solid #d0d5dd;background:#f2f4f7;padding:8px;text-align:left;\\\">ARR</th>\" +\n    \"<th style=\\\"border:1px solid #d0d5dd;background:#f2f4f7;padding:8px;text-align:left;\\\">Renewal Date</th>\" +\n    \"<th style=\\\"border:1px solid #d0d5dd;background:#f2f4f7;padding:8px;text-align:left;\\\">Usage</th>\" +\n    \"<th style=\\\"border:1px solid #d0d5dd;background:#f2f4f7;padding:8px;text-align:left;\\\">Risk Score</th>\" +\n    \"<th style=\\\"border:1px solid #d0d5dd;background:#f2f4f7;padding:8px;text-align:left;\\\">Key Risks</th>\" +\n    \"</tr></thead><tbody>\" +\n    rowsHtml +\n    \"</tbody></table>\" +\n    \"<p>Sent from Marketing Command Center</p>\";\n\n  result = {\n    accounts: filteredAccounts,\n    count: filteredAccounts.length,\n    riskGroup: riskGroup,\n    accountType: normalizedAccountType,\n    selectedRiskGroups: selectedRiskGroups,\n    subject: subject,\n    firstLine: firstLine,\n    emailBodyHtml: emailBodyHtml\n  };\n} catch (error) {\n  result = {\n    accounts: [],\n    count: 0,\n    riskGroup: \"Critical and High\",\n    accountType: \"CriticalHigh\",\n    selectedRiskGroups: [\"Critical\", \"High\"],\n    subject: \"Critical and High Accounts Risk Summary\",\n    firstLine: \"Below is a summary of 0 accounts currently classified as critical and high risk:\",\n    emailBodyHtml: \"<p>Below is a summary of 0 accounts currently classified as critical and high risk:</p><p>Sent from Marketing Command Center</p>\"\n  };\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1782125695104"
          },
          "code": "GET_TOP_CRITICAL_ACCOUNTS",
          "id": "1776917215970",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 5481.5,
            "y": 7702
          }
        },
        {
          "id": "1782125695104",
          "code": "PAGINATE_RISK_REVIEW_ACCOUNTS",
          "type": "CODE",
          "metadata": {
            "name": "Paginate Risk Review Accounts",
            "returnType": "object",
            "sourceCode": "let result = {\n  rows: [],\n  accounts: [],\n  totalCount: 0,\n  displayedCount: 0,\n  pageNumber: 1,\n  pageSize: 7,\n  totalPages: 0,\n  startIndex: 0,\n  endIndex: 0,\n  titleCount: 0,\n  hasNext: false,\n  hasPrevious: false,\n  nextPageNumber: 1,\n  previousPageNumber: 1,\n  accountType: \"CriticalHigh\",\n  riskGroup: \"Critical and High\",\n  selectedRiskGroups: [\"Critical\", \"High\"],\n  subject: \"Critical and High Accounts Risk Summary\",\n  firstLine: \"Below is a summary of 0 accounts currently classified as critical and high risk:\",\n  emailBodyHtml: \"\",\n  displayedAccountIdList: \"\",\n  allAccountIdList: \"\"\n};\n\ntry {\n  const raw = $context.$nodes.GET_TOP_CRITICAL_ACCOUNTS?.$output?.result || {};\n\n  const toRows = value => {\n    if (Array.isArray(value)) return value;\n    if (Array.isArray(value?.accounts)) return value.accounts;\n    if (Array.isArray(value?.items)) return value.items;\n    if (Array.isArray(value?.rows)) return value.rows;\n    if (Array.isArray(value?.result)) return value.result;\n    if (Array.isArray(value?.result?.accounts)) return value.result.accounts;\n    if (Array.isArray(value?.result?.items)) return value.result.items;\n    return [];\n  };\n\n  const positiveInteger = (value, fallback) => {\n    const parsed = Number.parseInt(value, 10);\n    return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;\n  };\n\n  const normalizeActionText = value => {\n    if (value == null) return \"\";\n\n    if (typeof value === \"object\") {\n      value = value.OraAction || value.oraAction || JSON.stringify(value);\n    }\n\n    let text = String(value || \"\").trim();\n\n    try {\n      const parsed = JSON.parse(text);\n      if (parsed && typeof parsed === \"object\" && parsed.OraAction) {\n        text = String(parsed.OraAction || \"\").trim();\n      }\n    } catch (e) {\n    }\n\n    for (let i = 0; i < 3; i++) {\n      text = text.replace(/\\\\\"/g, \"\\\"\");\n    }\n\n    return text;\n  };\n\n  const parseActionPayload = () => {\n    const candidates = [\n      $context.$triggers?.REST?.$input?.OraAction,\n      $context.$app?.$OraAction\n    ];\n\n    let actionText = \"\";\n    for (const candidate of candidates) {\n      const normalized = normalizeActionText(candidate);\n      if (normalized.includes(\"showRiskAccounts\")) {\n        actionText = normalized;\n        break;\n      }\n    }\n\n    if (!actionText) return {};\n\n    const jsonStart = actionText.indexOf(\"{\");\n    const jsonEnd = actionText.lastIndexOf(\"}\");\n    if (jsonStart === -1 || jsonEnd <= jsonStart) return {};\n\n    let payloadText = actionText.slice(jsonStart, jsonEnd + 1)\n      .replace(/\"\"(\\w+)\"\"/g, \"\\\"$1\\\"\")\n      .replace(/:\\s*\"\"([^\"]+)\"\"/g, \": \\\"$1\\\"\");\n\n    try {\n      let parsed = JSON.parse(payloadText);\n      if (typeof parsed === \"string\") {\n        parsed = JSON.parse(parsed);\n      }\n      return parsed && typeof parsed === \"object\" ? parsed : {};\n    } catch (e) {\n      return {};\n    }\n  };\n\n  const params = parseActionPayload();\n  const configuredPageSize = positiveInteger($context.$variables?.accountDisplayPageSize, 7);\n  const requestedPageSize = positiveInteger(params.pageSize, 0);\n  const pageSize = Math.min(25, Math.max(1, requestedPageSize || configuredPageSize));\n\n  const orderedRows = toRows(raw)\n    .filter(row => row && String(row.accountName || row.name || \"\").trim() !== \"\");\n\n  const totalCount = orderedRows.length;\n  const totalPages = totalCount > 0 ? Math.ceil(totalCount / pageSize) : 0;\n  const pageNumber = Math.min(\n    Math.max(1, positiveInteger(params.pageNumber, 1)),\n    Math.max(totalPages, 1)\n  );\n  const zeroBasedStart = (pageNumber - 1) * pageSize;\n  const pageRows = orderedRows.slice(zeroBasedStart, zeroBasedStart + pageSize);\n  const normalizedAccountType = String(raw.accountType || params.accountType || \"CriticalHigh\");\n\n  result = {\n    rows: pageRows,\n    accounts: pageRows,\n    totalCount,\n    displayedCount: pageRows.length,\n    pageNumber,\n    pageSize,\n    totalPages,\n    startIndex: pageRows.length ? zeroBasedStart + 1 : 0,\n    endIndex: zeroBasedStart + pageRows.length,\n    titleCount: zeroBasedStart + pageRows.length,\n    hasNext: pageNumber < totalPages,\n    hasPrevious: pageNumber > 1,\n    nextPageNumber: Math.min(pageNumber + 1, Math.max(totalPages, 1)),\n    previousPageNumber: Math.max(pageNumber - 1, 1),\n    accountType: normalizedAccountType,\n    riskGroup: raw.riskGroup || \"Critical and High\",\n    selectedRiskGroups: Array.isArray(raw.selectedRiskGroups) ? raw.selectedRiskGroups : [\"Critical\", \"High\"],\n    subject: raw.subject || \"Critical and High Accounts Risk Summary\",\n    firstLine: raw.firstLine || \"Below is a summary of \" + totalCount + \" accounts currently selected for review:\",\n    emailBodyHtml: raw.emailBodyHtml || \"\",\n    displayedAccountIdList: pageRows.map(row => row.accountId || row.accountIdentifier).filter(Boolean).join(\"##\"),\n    allAccountIdList: orderedRows.map(row => row.accountId || row.accountIdentifier).filter(Boolean).join(\"##\")\n  };\n} catch (error) {\n  result.error = String(error?.message || error);\n}\n\nreturn result;"
          },
          "diagram": {
            "x": 5471,
            "y": 7924
          },
          "outcomes": {
            "success": "1776917397847"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_MESSAGES_LIST"
              ],
              "enableActions": true,
              "enableCommunications": true,
              "customNotes": "Render the account overview message list and one direct email oraComms. Do not route email through an intermediate oraInsight follow-up action.",
              "enablePowerPoints": false
            }
          },
          "metadata": {
            "name": "Generate Accounts Display"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "GENERATE_ACCOUNTS_DISPLAY",
          "id": "1776917397847",
          "inputs": [
            {
              "id": "1776917397847_prompt",
              "name": "prompt",
              "type": "string",
              "value": "DATA: {{$context.$nodes.PAGINATE_RISK_REVIEW_ACCOUNTS.$output.result}}\n\nCreate the Send for Review state with:\n1. One oraInfoDisplay messageListWidget.\n2. Low-priority oraInsight action blocks after the oraInfoDisplay for pagination when applicable.\n3. One direct email communication suggestion.\n\nDo not output any text before, between, or after these structured blocks.\n\nData handling:\n- Use only DATA.accounts. DATA.accounts is already sliced for the current page.\n- Preserve the incoming account order exactly. Do not re-sort, group, or replace accounts.\n- Display every valid account in DATA.accounts unless accountName is empty.\n- Do not show more accounts than DATA.displayedCount.\n- Keep the selected risk group from DATA.accountType in all pagination follow-up commands and in the direct email communication.\n\noraInfoDisplay requirements:\n  - key: \"list\"\n  - patternId: \"messageListWidget\"\n  - title:\n    - If DATA.displayedCount is 0: \"No Accounts Found\"\n    - If DATA.displayedCount > 0: generate a 1-line heading showing the top DATA.totalCount renewal accounts ranked by ARR impact,\n    reflecting the account risk status in the heading, and explicitly including the current page range DATA.startIndex-DATA.endIndex.\n    - For critical-risk accounts, use wording like: \"Top <totalCount> Critical-Risk Accounts by ARR Impact (Accounts\n    <startIndex>-<endIndex>)\".\n    - For stable accounts, use wording like: \"Top <totalCount> Stable Renewal Accounts by ARR Impact (Accounts <startIndex>-<endIndex>)\".\n    - For other risk statuses, follow the same pattern using the risk status, ARR impact, and page range.\n  - Replace <totalCount>, <startIndex>, and <endIndex> with DATA.totalCount, DATA.startIndex, and DATA.endIndex. Do not spell them out.\n  - description: exactly two short paragraphs in the same JSON description field, separated by \"\\n\\n\".\n\n  Description requirements:\n  Paragraph 1:\n  Generate exactly 2 sentences forming an executive summary. Explain that these accounts represent the displayed page/sample of the specified renewal risk category, and explain why the accounts fall into that risk status using risk signals shown in this widget or otherwise available in DATA.accounts.\n\n  Paragraph 2:\n  Generate exactly 2 sentences forming a concise renewal action plan for these accounts. Recommend specific renewal actions, outreach strategies, and renewal messaging based on the risk status and visible signals; for critical-risk accounts, emphasize immediate intervention, executive and Customer Success outreach, adoption barriers, stakeholder concerns, renewal confidence, churn prevention, workforce efficiency, compliance, and maximizing Oracle HCM value when supported by the data; for stable accounts, emphasize reinforcing realized value, sustaining adoption, expansion readiness, broader Oracle capability positioning, and future business growth.\n\n  The full description must be similar in length and density to the provided examples: approximately 450-700 characters total across both paragraphs. Do not hardcode the sample descriptions. Generate fresh, business-oriented wording using the current DATA.\n\n  Do not output the description content outside the oraInfoDisplay description field. Do not use bullets, headings, markdown, raw identifiers, or technical field names in the description.\n\nFor each account, create one messageListWidget row:\n- title: accountName.\n- subtitle: \"ARR Impact \" followed by arr. The arr field is already formatted with K for thousands, M for millions, B for billions, exactly two decimal places, and no space before the suffix.\n- summary: use accountDescription exactly. Do not rewrite, shorten, regenerate, or derive a different summary from riskDetailedExplainer.\n- badgeText: riskClassification. Display exactly Critical, High, Medium, or Stable.\n- priority: \"alert\" for Critical or High, \"warning\" for Medium, and \"info\" for Stable.\n- action: \"ora.Invoke(\\\"launchAccount\\\",{\\\"targetProductId\\\":\\\"{{$context.$variables.targetProductId}}\\\",\\\"targetProductName\\\":\\\"{{$context.$variables.targetProductName}}\\\",\\\"accountId\\\":\\\"<accountId>\\\"})\". Replace <accountId> with accountId if present, otherwise accountIdentifier.\n\nPagination action requirements:\n- All pagination oraInsight blocks created by this prompt must be emitted consecutively after the oraInfoDisplay.\n- All pagination oraInsight blocks created by this prompt must use priority false so the pagination buttons render together in the same action row/group.\n- Do not create email oraInsight blocks.\n\nPagination oraInsight requirements:\nIf DATA.hasPrevious is true, create one low-priority oraInsight:\n- title: \"Previous Accounts\"\n- shortDescription: \"Review the previous page of accounts in the same ARR order.\"\n- actionText: \"Previous Accounts\"\n- priority: false\n- followUpCommand: \"ora.Invoke(\\\"showRiskAccounts\\\",\\\"showRiskAccounts({\\\"accountType\\\":\\\"<accountType>\\\",\\\"pageNumber\\\":\\\"<previousPageNumber>\\\",\\\"pageSize\\\":\\\"<pageSize>\\\"})\\\")\"\n\nIf DATA.hasNext is true, create one low-priority oraInsight:\n- title: \"Next Accounts\"\n- shortDescription: \"Review the next page of accounts in the same ARR order.\"\n- actionText: \"Next Accounts\"\n- priority: false\n- followUpCommand: \"ora.Invoke(\\\"showRiskAccounts\\\",\\\"showRiskAccounts({\\\"accountType\\\":\\\"<accountType>\\\",\\\"pageNumber\\\":\\\"<nextPageNumber>\\\",\\\"pageSize\\\":\\\"<pageSize>\\\"})\\\")\"\n\nDirect email communication requirement:\nAfter the oraInfoDisplay and pagination oraInsights, create exactly one raw <oraComms> email communication.\nThis communication is the \"Send Email with Account Summary\" control and must open the Send Email page directly.\nDo not create an oraInsight, followUpCommand, sendEmailToCSM action, or secondary button for this email control.\n\nThe <oraComms> JSON object must use this runtime shape:\n- title: \"Send Email with Account Summary\".\n- shortDescription: \"Email the account summary for the displayed product risk group.\"\n- actionText: \"Send Email\".\n- type: \"email\".\n- priority: true.\n- content: the actual DATA.emailBodyHtml value exactly. Do not use the literal string \"DATA.emailBodyHtml\".\n- params: exactly these first three parameters, in this order:\n  1. {\"id\":\"email\",\"title\":\"To\",\"description\":\"Recipient email address\",\"defaultValue\":\"\",\"editable\":true}\n  2. {\"id\":\"cc\",\"title\":\"CC\",\"description\":\"CC list\",\"defaultValue\":\"\",\"editable\":true}\n  3. {\"id\":\"subject\",\"title\":\"Subject\",\"description\":\"Email subject\",\"defaultValue\":\"<subject>\",\"editable\":true}\n\nReplace <subject> with the actual DATA.subject value. Use DATA.subject only for the email subject field/default; do not use DATA.subject as the visible communication title, launcher label, card title, or action label.\nFor pagination commands only, replace <accountType>, <previousPageNumber>, <nextPageNumber>, and <pageSize> with DATA.accountType, DATA.previousPageNumber, DATA.nextPageNumber, and DATA.pageSize. Do not invent page values.\n\nHard constraints:\n- Output only the oraInfoDisplay, applicable pagination oraInsight blocks, and the one oraComms email communication.\n- Do not create more than two pagination oraInsight blocks.\n- Do not create an oraInsight, followUpCommand, sendEmailToCSM action, secondary \"Send ...\" button, markdown link, or workflow-invoking email action for the email control.\n- Do not create per-row email actions.\n- Do not output oraImmediateInsight or refresh.\n- Do not output null. Use an empty string for missing values."
            },
