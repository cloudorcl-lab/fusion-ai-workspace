        {
          "id": "1782104070885",
          "code": "NORMALIZE_RISK_SUMMARY",
          "type": "CODE",
          "metadata": {
            "name": "Normalize Risk Summary",
            "returnType": "object",
            "sourceCode": "let result = {\n  items: [],\n  count: 0,\n  totalArr: \"0.00\",\n  riskGroups: [\"Critical\", \"High\", \"Medium\", \"Stable\"]\n};\n\ntry {\n  const riskOrder = [\"Critical\", \"High\", \"Medium\", \"Stable\"];\n\n  const normalizeRisk = value => {\n    const risk = String(value || \"\").trim().toLowerCase();\n    if (risk === \"critical\") return \"Critical\";\n    if (risk === \"high\") return \"High\";\n    if (risk === \"medium\" || risk === \"moderate\") return \"Medium\";\n    if (risk === \"stable\") return \"Stable\";\n    return \"\";\n  };\n\n  const parseAmount = value => {\n    if (value === null || value === undefined || value === \"\") return 0;\n    if (typeof value === \"number\") return Number.isFinite(value) ? value : 0;\n\n    const text = String(value).trim().replace(/[$,\\s]/g, \"\").toUpperCase();\n    const match = text.match(/^(-?\\d+(?:\\.\\d+)?)([KMB])?$/);\n    if (!match) return Number(text) || 0;\n\n    const amount = Number(match[1]);\n    const suffix = match[2] || \"\";\n    if (!Number.isFinite(amount)) return 0;\n    if (suffix === \"B\") return amount * 1000000000;\n    if (suffix === \"M\") return amount * 1000000;\n    if (suffix === \"K\") return amount * 1000;\n    return amount;\n  };\n\n  const formatArr = value => {\n    const amount = parseAmount(value);\n    const abs = Math.abs(amount);\n    if (abs >= 1000000000) return (amount / 1000000000).toFixed(2) + \"B\";\n    if (abs >= 1000000) return (amount / 1000000).toFixed(2) + \"M\";\n    if (abs >= 1000) return (amount / 1000).toFixed(2) + \"K\";\n    return amount.toFixed(2);\n  };\n\n  const groups = riskOrder.reduce((acc, risk) => {\n    acc[risk] = {\n      riskClassification: risk,\n      productRisk: risk,\n      accounts: 0,\n      arrRaw: 0,\n      arr: \"0.00\"\n    };\n    return acc;\n  }, {});\n\n  const summaryOutput = $context.$nodes?.GET_ACCOUNTS_BY_RISK?.$output || {};\n  const summaryRows = Array.isArray(summaryOutput?.items)\n    ? summaryOutput.items\n    : (Array.isArray(summaryOutput) ? summaryOutput : []);\n\n  summaryRows.forEach(row => {\n    const risk = normalizeRisk(\n      row?.riskClassification ||\n      row?.productRisk ||\n      row?.ProductRisk ||\n      row?.risk ||\n      row?.category ||\n      row?.name\n    );\n    if (!risk || !groups[risk]) return;\n\n    const accounts = Number(row?.accounts ?? row?.accountCount ?? row?.count ?? 0);\n    groups[risk].accounts += Number.isFinite(accounts) ? accounts : 0;\n    groups[risk].arrRaw += parseAmount(row?.arr ?? row?.ARR ?? row?.arrImpact ?? row?.annualRecurringRevenue ?? 0);\n  });\n\n  const items = riskOrder.map(risk => {\n    const row = groups[risk];\n    return {\n      riskClassification: row.riskClassification,\n      productRisk: row.productRisk,\n      accounts: row.accounts,\n      arr: formatArr(row.arrRaw),\n      arrRaw: row.arrRaw\n    };\n  });\n\n  result = {\n    items: items,\n    count: items.reduce((sum, row) => sum + row.accounts, 0),\n    totalArr: formatArr(items.reduce((sum, row) => sum + row.arrRaw, 0)),\n    riskGroups: riskOrder\n  };\n} catch (error) {\n  result = {\n    items: [\"Critical\", \"High\", \"Medium\", \"Stable\"].map(risk => ({\n      riskClassification: risk,\n      productRisk: risk,\n      accounts: 0,\n      arr: \"0.00\",\n      arrRaw: 0\n    })),\n    count: 0,\n    totalArr: \"0.00\",\n    riskGroups: [\"Critical\", \"High\", \"Medium\", \"Stable\"]\n  };\n}\n\nreturn result;"
          },
          "diagram": {
            "x": 7212.5,
            "y": 6113
          },
          "outcomes": {
            "success": "1776914882434"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "name": "Refine Accounts for Program",
            "returnType": "array",
            "sourceCode": "let result = [];\ntry {\n  const actionString = $context.$app?.$OraAction || \"\";\n  const match = actionString.match(/addToProgram\\((.*)\\)/);\n  let accountType = null;\n  if (match && match[1]) {\n    try {\n      let jsonString = match[1];\n      if ((jsonString.startsWith('\"') && jsonString.endsWith('\"')) || (jsonString.startsWith(\"'\") && jsonString.endsWith(\"'\"))) {\n        jsonString = jsonString.slice(1, -1);\n      }\n      jsonString = jsonString.replace(/\\\\\"/g, '\"').replace(/\\\\\\\\/g, '\\\\');\n      const parsed = JSON.parse(jsonString);\n      accountType = parsed.accountType || null;\n    } catch (e) {\n      accountType = null;\n    }\n  }\n  const renewalAccounts = $context.$nodes?.GET_RENEWAL_ACCOUNTS?.$output?.items || [];\n  // Filter by accountType if specified\n  let filteredAccounts = accountType\n    ? renewalAccounts.filter(row => row.riskClassification === accountType)\n    : [];\n\n  // Sort filtered accounts by 'arr' descending\n  // TODO: Inferred 'arr' property from user text 'arr'\n  filteredAccounts.sort((a, b) => {\n    const aArr = a.arr ?? 0;\n    const bArr = b.arr ?? 0;\n    return bArr - aArr;\n  });\n\n  // Return only top 8 accounts\n  result = filteredAccounts.slice(0, 8);\n} catch (error) {\n  result = [];\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1778525084180"
          },
          "code": "REFINE_ACCOUNTS_FOR_PROGRAM",
          "id": "1778524062918",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
