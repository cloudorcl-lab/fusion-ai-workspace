        {
          "metadata": {
            "name": "Retrieve the Program Name",
            "returnType": "string",
            "sourceCode": "let result = \"\";\ntry {\n  const oraFormSubmitString = $context.$app?.$OraAction || \"\";\n  const regex = /<oraFormSubmit[^>]*>(\\[.*?\\])<\\/oraFormSubmit>/;\n  const match = oraFormSubmitString.match(regex);\n  let programId = null;\n  if (match && match[1]) {\n    const formArray = JSON.parse(match[1]);\n    const programObj = formArray.find(obj => obj.id === \"ProgramName\");\n    if (programObj) {\n      programId = programObj.value;\n    }\n  }\n  const programs = $context.$nodes?.GET_ACTIVE_PROGRAMS_FOR_CONFIRMATION?.$output?.items || [];\n  const matchedProgram = programs.find(prog => prog.id === programId);\n  result = matchedProgram?.name || \"\";\n} catch (error) {\n  result = \"\";\n}\nreturn result;"
          },
