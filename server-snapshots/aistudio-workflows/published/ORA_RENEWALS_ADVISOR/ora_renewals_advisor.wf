          },
          "metadata": {
            "name": "CSM Email Response"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "CSM_EMAIL_RESPONSE",
          "id": "1778538581275",
          "inputs": [
            {
              "id": "1778538581275_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "Create exactly one HTML email communication from the provided data. The primary send button label must be Send Email."
            },
            {
              "id": "1778538581275_prompt",
              "name": "prompt",
              "type": "string",
              "value": "DATA: {{$context.$nodes.PROCESS_DATA_FOR_CSM_EMAIL.$output.result}}\n\nProduce exactly one email communication for the account-risk summary.\n\nCommunication requirements:\n- The email subject must be exactly DATA.subject.\n- The email body must be HTML and must use DATA.emailBodyHtml exactly as the body content.\n- The primary send/submit button next to Cancel must be labeled exactly \"Send Email\".\n- Do not label that primary send/submit button \"Send Email with Account Summary\".\n- DATA.emailBodyHtml already includes the first visible line, a table, and the final \"Sent from Marketing Command Center\" line.\n- Do not add a greeting, salutation, signature, markdown table, bullet list, numbered list, or repeated per-account sections.\n- Include no more than the accounts already present in DATA.accounts.\n\nThe first visible line of the email body must remain exactly:\nDATA.firstLine\n\nDo not alter ARR values. They are already formatted with K for thousands, M for millions, B for billions, exactly two decimal places, and no space before the suffix."
            }
          ],
          "type": "LLM",
          "diagram": {
            "x": 7140.5,
            "y": 7702
          }
        },
        {
          "metadata": {
            "name": "Refine Send to Sales Data",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  let rawAction = $context.$app?.$OraAction || \"\";\n\n  if (typeof rawAction !== \"string\") {\n    try {\n      if (typeof rawAction === \"object\" && rawAction !== null) {\n        rawAction = JSON.stringify(rawAction);\n      }\n      const parsed = JSON.parse(rawAction);\n      if (parsed && typeof parsed === \"object\" && parsed.OraAction) {\n        rawAction = parsed.OraAction;\n      } else {\n        rawAction = rawAction;\n      }\n    } catch (e) {\n      rawAction = rawAction;\n    }\n  }\n\n  let unescapedOnce = rawAction.replace(/\\\\/g, \"\\\\\").replace(/\\\"/g, '\"');\n\n  const match = rawAction.match(/sendToSales\\((.*)\\)/);\n  let jsonString = \"\";\n  if (match && match[1]) {\n    jsonString = match[1];\n    jsonString = jsonString.trim();\n    jsonString = jsonString.replace(/\\\\\"/g, '\"').replace(/\\\\\\\\/g, '\\\\');\n  }\n\n  let actionObj = {};\n  try {\n    actionObj = JSON.parse(jsonString);\n  } catch (e) {\n    actionObj = {};\n  }\n\n  const accountId = actionObj.AccountId || \"\";\n\n  const accounts = $context.$nodes?.GET_RENEWAL_ACCOUNTS?.$output?.items || [];\n\n  const matchedAccount = accounts.find(acc => acc.accountIdentifier === accountId) || {};\n\n  result = matchedAccount;\n} catch (error) {\n  result = {};\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1778534901776"
          },
