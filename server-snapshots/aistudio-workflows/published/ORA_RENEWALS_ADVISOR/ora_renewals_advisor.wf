        {
          "metadata": {
            "name": "Empty Add Account To Program",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  const targetProductId = $context.$variables?.targetProductId || \"\";\n  const targetProductName = $context.$variables?.targetProductName || \"\";\n\n  let rawAction = $context.$app?.$OraAction || \"\";\n\n  if (typeof rawAction !== 'string') {\n    try {\n      if (typeof rawAction === 'object' && rawAction !== null) {\n        rawAction = JSON.stringify(rawAction);\n      } else {\n        rawAction = String(rawAction);\n      }\n    } catch (e) {\n      rawAction = \"\";\n    }\n  }\n\n  try {\n    const parsed = JSON.parse(rawAction);\n    if (parsed && typeof parsed === 'object' && parsed.OraAction) {\n      rawAction = parsed.OraAction;\n    }\n  } catch (e) {\n  }\n\n  let unescapedOnce = rawAction.replace(/\\\\/g, \"\\\\\").replace(/\\\"/g, '\"');\n\n  const match = rawAction.match(/addAccountToProgram\\((.*)\\)/);\n  let jsonString = \"\";\n  if (match && match[1]) {\n    jsonString = match[1];\n    jsonString = jsonString.trim();\n    jsonString = jsonString.replace(/\\\\\\\"/g, '\"').replace(/\\\\\\\\/g, '\\\\');\n  }\n\n  let actionObj = {};\n  try {\n    actionObj = JSON.parse(jsonString);\n  } catch (e) {\n    actionObj = {};\n  }\n\n  const accountId = actionObj.AccountId || \"\";\n\n  const encodedProductName = targetProductName.replace(/ /g, \"%20\");\n\n  result = {\n    targetProductId: targetProductId,\n    targetProductName: targetProductName,\n    accountId: accountId\n  };\n\n  const parts = [\n    'targetProductId', targetProductId,\n    'targetProductName', encodedProductName,\n    'accountId', accountId\n  ];\n  result.id = parts.join('_');\n\n} catch (error) {\n  result = {\n    targetProductId: \"\",\n    targetProductName: \"\",\n    accountId: \"\",\n    id: \"targetProductId__targetProductName__accountId_\"\n  };\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1778535993073"
          },
