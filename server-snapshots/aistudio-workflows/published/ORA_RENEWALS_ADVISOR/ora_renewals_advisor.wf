        {
          "metadata": {
            "name": "Retrieve Product Name and Id",
            "returnType": "object",
            "sourceCode": "let result = { targetProductId: \"\", targetProductName: \"\", startDate: \"\", endDate: \"\" };\ntry {\n  const appInput = $context.$app.$OraAppContext;\n\n  let appContextRaw = appInput;\n  let appContextStr = \"\";\n\n  const appContextMatch = appContextRaw.match(/appContext=([^\\s]+)/);\n  if (appContextMatch) {\n    appContextStr = decodeURIComponent(appContextMatch[1]);\n  } else {\n    appContextStr = appContextRaw;\n  }\n\n  if ((appContextStr.startsWith('\"') && appContextStr.endsWith('\"')) || (appContextStr.startsWith(\"'\") && appContextStr.endsWith(\"'\"))) {\n    appContextStr = appContextStr.slice(1, -1);\n  }\n\n  let targetProductId = \"\";\n  let targetProductName = \"\";\n\n  if (appContextStr.startsWith('{') && appContextStr.endsWith('}')) {\n    try {\n      const obj = JSON.parse(appContextStr);\n      targetProductId = obj.targetProductId || \"\";\n      targetProductName = obj.targetProductName || \"\";\n    } catch (jsonError) {\n      const pairs = appContextStr.slice(1, -1).split(',');\n      pairs.forEach(pair => {\n        const [key, value] = pair.split(':').map(s => s.trim());\n        if (key === 'targetProductId') targetProductId = value || \"\";\n        else if (key === 'targetProductName') targetProductName = value || \"\";\n      });\n    }\n  } else {\n    const pairs = appContextStr.split(',');\n    pairs.forEach(pair => {\n      let key = \"\";\n      let value = \"\";\n      if (pair.includes('=')) {\n        [key, value] = pair.split('=').map(s => s.trim());\n      } else if (pair.includes(':')) {\n        [key, value] = pair.split(':').map(s => s.trim());\n      }\n      if (key === 'targetProductId') targetProductId = value || \"\";\n      else if (key === 'targetProductName') targetProductName = value || \"\";\n    });\n  }\n\n  targetProductName = targetProductName.replace(/\\+/g, ' ');\n\n  const currentDateStr = $context.$system?.$currentDate || \"2024-01-01\";\n  const currentDate = new Date(currentDateStr);\n  const endDateObj = new Date(currentDate);\n  endDateObj.setDate(endDateObj.getDate() + 90);\n\n  const yearStart = currentDate.getFullYear();\n  const monthStart = String(currentDate.getMonth() + 1).padStart(2, \"0\");\n  const dayStart = String(currentDate.getDate()).padStart(2, \"0\");\n  const startDate = `${yearStart}-${monthStart}-${dayStart}`;\n\n  const yearEnd = endDateObj.getFullYear();\n  const monthEnd = String(endDateObj.getMonth() + 1).padStart(2, \"0\");\n  const dayEnd = String(endDateObj.getDate()).padStart(2, \"0\");\n  const endDate = `${yearEnd}-${monthEnd}-${dayEnd}`;\n\n  result = { targetProductId, targetProductName, startDate, endDate };\n} catch (error) {\n  result = { targetProductId: \"\", targetProductName: \"\", startDate: \"\", endDate: \"\" };\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776912032216"
          },
          "code": "RETRIEVE_PRODUCT_NAME_AND_ID",
          "id": "1776911955606",
