        {
          "id": "1781887128881",
          "code": "BUILD_SEGMENT_DATA",
          "type": "CODE",
          "metadata": {
            "name": "Build Segment Data",
            "sourceCode": "let result = {};\n\ntry {\n  let targetProductName = \"\";\n  let renewalDays = 180;\n\n  const input = $context.$triggers.REST.$input || {};\n  const oraAction = input.OraAction || \"\";\n\n  const formMatch = oraAction.match(/<oraFormSubmit\\s+id=[\"']([^\"']*)[\"'][^>]*>/);\n\n  if (formMatch) {\n    const formId = formMatch[1] || \"\";\n    const nameMatch = formId.match(/_targetProductName_([\\s\\S]*)$/);\n\n    if (nameMatch) {\n      targetProductName = nameMatch[1];\n    }\n  }\n  const escapeSqlValue = (value) => {\n    return String(value || \"\").split(\"'\").join(\"''\");\n  };\n\n  const timestamp = Date.now();\n  const name = `Renewals_${targetProductName}_${timestamp}`;\n  const sqlTemplate = `SELECT DISTINCT \"A0\".\"ID\" AS \"AccountID\"\nFROM \"Default.Accounts\" \"A0\"\nJOIN \"Default.AccountProductIntelligence\" \"A1\" ON \"A0\".\"ID\" = \"A1\".\"AccountID\"\nWHERE TRUNC(\"A1\".\"RenewalDate\") BETWEEN TRUNC(SYSDATE) AND TRUNC(SYSDATE) + <renewalDays>\nAND \"A1\".\"ProductLevel7Name\" IN (\n  '<targetProductName>'\n)\nAND \"A1\".\"OwnershipStatus\" IN (\n  'ORA_ACTIVE'\n)`;\n\n  const sqlData = sqlTemplate\n    .replaceAll(\"<targetProductName>\",escapeSqlValue(targetProductName))\n    .replaceAll(\"<renewalDays>\", escapeSqlValue(renewalDays));\n\n  const jsonModelObj = {\n    canvases: {\n      sqlQuery: {\n        sql: sqlData\n      }\n    }\n  };\n\n  result = {\n    name: name,\n    description: \"\",\n    explanation: \"\",\n    jsonModel: JSON.stringify(jsonModelObj),\n    type: \"SQLQUERY\",\n    baseObject: \"Contacts\",\n    model: \"Default\",\n    context: \"program\",\n    count: null\n  };\n\n} catch (error) {\n  result = {\n    error: error.message\n  };\n}\n\nreturn result;",
            "returnType": "object"
          },
          "diagram": {
            "x": 5010.5,
            "y": 7924
          },
          "outcomes": {
            "success": "1781887128879"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
