          "inputs": [
            {
              "id": "1778534901776_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Generate a cardWidget with the following properties:\n\nsubject: Account {{$context.$nodes.REFINE_SEND_TO_SALES_DATA.$output.result.accountName}} was successfully to Sales\n\nsummary:\n  <Generate a professional message about how sending the account to the sales would bring in additional boost for the accounts>.\n\nbadgeText: \"Success\"\npriority: \"success\""
            }
