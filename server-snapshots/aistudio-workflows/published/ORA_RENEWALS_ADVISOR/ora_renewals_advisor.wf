            "sourceCode": "let result = [];\ntry {\n  const renewalAccounts = $context.$nodes?.GET_RENEWAL_ACCOUNTS?.$output?.items || [];\n  result = renewalAccounts.slice(0, 10);\n} catch (error) {\n  result = [];\n}\nreturn result;"
          },
          "outcomes": {
            "success": "1776919544055"
          },
