        {
          "metadata": {
            "name": "Refine Data for All Accounts Create Program",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  const targetProductId = $context.$variables?.targetProductId || \"\";\n  const targetProductName = $context.$variables?.targetProductName || \"\";\n\n  let accountIdsList = [];\n  const renewalAccountsOutput = $context.$nodes?.GET_RENEWAL_ACCOUNTS?.$output;\n  if (renewalAccountsOutput) {\n    accountIdsList = renewalAccountsOutput.accountIdsList || [];\n    if (!Array.isArray(accountIdsList)) {\n      accountIdsList = [];\n    }\n  }\n\n  // Replace spaces in targetProductName with ASCII code for space (%20)\n  const encodedProductName = targetProductName.replace(/ /g, \"%20\");\n\n  result = {\n    targetProductId: targetProductId,\n    targetProductName: targetProductName,\n    accountIdsList: accountIdsList\n  };\n\n  const parts = [\n    'targetProductId', targetProductId,\n    'targetProductName', encodedProductName,\n    'accountIdsList', Array.isArray(accountIdsList) ? accountIdsList.join('-') : ''\n  ];\n  result.id = parts.join('_');\n\n} catch (error) {\n  result = {\n    targetProductId: \"\",\n    targetProductName: \"\",\n    accountIdsList: [],\n    id: \"targetProductId__targetProductName__accountIdsList_\"\n  };\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1778535803458"
          },
          "code": "REFINE_DATA_FOR_ALL_ACCOUNTS_CREATE_PROGRAM",
          "id": "1778525913049",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
