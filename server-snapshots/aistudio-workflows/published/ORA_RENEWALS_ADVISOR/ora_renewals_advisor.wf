        {
          "id": "1781205614301",
          "code": "GETLOCATIONHEADER",
          "type": "CODE",
          "metadata": {
            "name": "GetLocationHeader",
            "returnType": "string",
            "sourceCode": "let result = \"\";\ntry {\n  const responseHeaders = $context.$nodes?.CREATE_PROGRAM?.$responseHeaders;\n  const locationHeader = responseHeaders?.['location'];\n\n  if (Array.isArray(locationHeader) && locationHeader.length > 0) {\n    const programIdStr = locationHeader[0].split(\"/\").pop();\n    result = String(programIdStr);\n  } else {\n    result = \"\";\n  }\n} catch (error) {\n  result = \"\";\n}\n\nreturn result;"
          },
          "diagram": {
            "x": 5010.5,
