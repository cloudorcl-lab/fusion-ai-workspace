            {
              "id": "1778526509280_prompt",
              "name": "prompt",
              "type": "string",
              "value": "### 1) Generate recordWidget\nGenerate an editable recordWidget with the following exact\nspecifications:\n\nid: as \nfields: [\n  {\n    id: \"ProgramName\",\n    label: \"Program Name\",\n    options: {{$context.$nodes.GET_PROGRAMS.$output}} ,\n    type: \"select\"\n  }\n]\n\ntitle: <Generate a Profession text to select a program to associate the\naccounts with the program for renewals>\n\ndescription: Add the accounts to the Selected Program\n\nHard Constraints:\n- Do not include any additional fields.\n- Do not omit any of the listed fields.\n- Do not change field names, labels, or types.\n- Do not add comments, explanations, or formatting outside this\n  structure."
            }
          ],
          "type": "LLM",
          "diagram": {
            "x": 6575,
            "y": 7924
          }
        },
        {
          "id": "1781205540874",
          "code": "GENERATE_CREATE_PROGRAM_WIDGET",
          "type": "LLM",
          "metadata": {
            "name": "Generate Create Program Widget"
          },
          "diagram": {
            "x": 8040.5,
            "y": 7480
          },
          "outcomes": {
            "success": "end"
          },
          "inputs": [
            {
              "id": "1780937202310_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": ""
            },
            {
              "id": "1780937202310_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Generate exactly one editable recordWidget and no other widget or text.\n\nUse this recordWidget id exactly:\n`targetProductId_{{$context.$variables.targetProductId}}_targetProductName_{{$context.$variables.targetProductName}}`\n\nThe recordWidget must have:\n- title: `Review Key Program Details`\n- description: `Program Type: Renewals, Regions: All, Industries: <comma-separated unique industries>. After creating the program, you can review the audience, tactics, and finish configuring the program.`\n- readOnly: false\n- exactly these three fields in this order:\n  1. id: `ProgramName`, label: `Program Name`, value: `{{$context.$variables.targetProductName}}`, type: `text`\n  2. id: `ProgramObjective`, label: `Program Objective`, value: one sentence objective to perform renewals for {{$context.$variables.targetProductName}}, type: `text`\n  3. id: `ExternalTrackingCode`, label: `External Tracking Code`, value: `\"\"`, type: `text`\n\nWhere:\n- <comma-separated unique industries> is derived from {{$context.$nodes.GET_RENEWAL_ACCOUNTS.$output}}.\n- Remove duplicate, null, empty, and unknown industry values. If no industries are available, use `All`.\n\nHard constraints:\n- Output only the recordWidget.\n- Do not output oraImmediateInsight.\n- Do not output followUpCommand.\n- Do not output any additional action or automatic follow-up instruction.\n- Do not include any additional fields.\n- Do not omit any listed field.\n- Do not change field ids, labels, or types.\n- Do not output the word null anywhere.\n- Do not add comments, explanations, or text outside the widget."
            }
          ],
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "enableActions": true,
              "layouts": [
                "ORA_LAYOUT_RECORD"
              ]
            }
          }
        },
        {
          "id": "1781627734537",
          "code": "IDENTIFY_FORM_ACTION",
          "type": "CODE",
          "metadata": {
            "name": "Identify Form Action",
            "returnType": "string",
            "sourceCode": "let result = \"createProgram\";\ntry {\n  const restInput = $context.$triggers?.REST?.$input || {};\n  let rawAction = restInput.OraAction || $context.$app?.$OraAction || \"\";\n\n  if (typeof rawAction !== \"string\") {\n    if (rawAction && typeof rawAction === \"object\") {\n      rawAction = rawAction.OraAction || JSON.stringify(rawAction);\n    } else {\n      rawAction = String(rawAction || \"\");\n    }\n  }\n\n  try {\n    const parsed = JSON.parse(rawAction);\n    if (parsed && typeof parsed === \"object\" && parsed.OraAction) {\n      rawAction = parsed.OraAction;\n    }\n  } catch (e) {\n  }\n\n  const match = rawAction.match(/<oraFormSubmit\\s+id=[\"']([^\"']*)[\"'][^>]*>([\\s\\S]*?)<\\/oraFormSubmit>/);\n  if (match) {\n    const formId = match[1] || \"\";\n    const body = match[2] || \"[]\";\n    let attributes = {};\n    try {\n      const parsedArray = JSON.parse(body);\n      if (Array.isArray(parsedArray)) {\n        attributes = parsedArray.reduce((acc, item) => {\n          if (item && item.id) {\n            acc[item.id] = item.value;\n          }\n          return acc;\n        }, {});\n      }\n    } catch (e) {\n      attributes = {};\n    }\n\n    const hasCreateProgramFields =\n      Object.prototype.hasOwnProperty.call(attributes, \"ProgramName\") ||\n      Object.prototype.hasOwnProperty.call(attributes, \"ProgramObjective\") ||\n      Object.prototype.hasOwnProperty.call(attributes, \"ExternalTrackingCode\");\n\n    if (hasCreateProgramFields || formId.includes(\"targetProductId_\") || formId.includes(\"targetProductName_\")) {\n      result = \"createProgram\";\n    }\n  }\n} catch (error) {\n  result = \"createProgram\";\n}\n\nreturn result;"
          },
          "diagram": {
            "x": 5010.5,
            "y": 7480
          },
          "outcomes": {
            "success": "1781627797364"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
