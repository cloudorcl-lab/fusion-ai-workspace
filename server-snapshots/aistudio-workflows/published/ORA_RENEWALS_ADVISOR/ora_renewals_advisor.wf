                    "sourceCode": "let result = [];\ntry {\n  const programItems = $context.$nodes.GET_ACTIVE_PROGRAMS.$output.items || [];\n  result = programItems.map(item => {\n    const id = item?.id;\n    const name = item?.name;\n    return { value: id, label: name };\n  });\n} catch (error) {\n  result = [];\n}\nreturn result;",
