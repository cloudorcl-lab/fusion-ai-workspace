            "returnType": "object",
            "sourceCode": "let validatedLedgerandPeriods = Array.isArray($context.$nodes.VALIDATE_PERIOD_STATUS.$output) ? $context.$nodes.VALIDATE_PERIOD_STATUS.$output : [];\n\nlet message = String($context.$nodes.EXTRACT_LEDGER_INFORMATION.$output.message) || \"\";\n\nif (validatedLedgerandPeriods.length === 0) {\n    return {\n        message: \"No open periods, when \" + message,\n//        message: \"Validation failed, No Open Periods when \" + message,\n        hasMany: false,\n        appContextUpdated: true,\n        refreshApp: false\n    };\n}\n\n\n\nlet currentLedgerId = validatedLedgerandPeriods[0].LEDGERID;\nlet currentPeriodName = validatedLedgerandPeriods[0].PERIODNAME;\n\nconst context = {\n  ledgerId: currentLedgerId,\n  periodName: currentPeriodName,\n  message: message,\n  hasMany: false,\n  appContextUpdated: true,\n  refreshApp: true\n};\n\nreturn context;"
          },
