          "code": "FETCH_METADATA_INFORMATION",
          "id": "1781000252396",
          "inputs": [
            {
              "id": "1780658417935_payload",
              "name": "payload",
              "value": "{{$context.$nodes.PREPARE_PAYLOAD_FOR_METADATA.$output.result}}",
