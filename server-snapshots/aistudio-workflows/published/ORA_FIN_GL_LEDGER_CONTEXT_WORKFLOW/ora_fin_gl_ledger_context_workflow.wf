        {
          "metadata": {
            "name": "Prepare Payload For Metadata",
            "returnType": "object",
            "sourceCode": "let currentLedger = $context.$nodes.PROCESS_DEFAULT_LEDGER.$output.result;\n\nlet query = {\n    \"select\": `SELECT  funAvMetadata.analyticViewName,funAvMetadata.analyticViewId,funAvMetadata.setupFlag,funAvMetadata.usageCode,funAvMetadata.userDefinedName,funAvMetadata.chartOfAccountId,funAvMetadata.accountingCalendarId,funAvMetadataDetail.segmentTypeCode,funAvMetadataDetail.dimensionDisplayName,funAvMetadataDetail.dimensionSequenceNumber,funAvMetadataDetail.dimensionAttributes,funAvMetadataDetail.hierarchyDisplayName,funAvMetadataDetail.hierarchyName,funAvMetadataDetail.dimensionLevelAttributes,funAvMetadataDetail.hierarchyAttributes,funAvMetadataDetail.uiFlag,funAvMetadataDetail.dimensionLevelDescriptions,funAvMetadataDetail.dimensionAttributeName,funAvMetadataDetail.valueSetId,funAvMetadataDetail.treeVersionId  FROM  funAvMetadata,funAvMetadataDetail  WHERE funAvMetadata.analyticViewId IN (SELECT analyticViewId from funAvMetadata WHERE chartOfAccountId='${currentLedger.chartOfAccountsId}' AND usageCode='GL_BALANCES_AV' AND accountingCalendarId='${currentLedger.calendarId}') AND funAvMetadata.analyticViewId =funAvMetadataDetail.analyticViewId`,\n    \"viewQueries\": {\n        \"funAvMetadata\": {\n            \"module\": \"oraErpCoreCommonObjects\",\n            \"businessObject\": \"AnalyticViewMetadata\",\n            \"view\": \"analyticViewMetadataList\",\n            \"fieldAliases\": {\n                \"usageCode\": \"usageCode\",\n                \"setupFlag\": \"setupFlag\",\n                \"userDefinedName\": \"userDefinedName\",\n                \"analyticViewName\": \"analyticViewName\",\n                \"calendar.calendarId\": \"accountingCalendarId\",\n                \"structureInstance.structureInstanceNumber\": \"chartOfAccountId\",\n                \"analyticViewId\": \"analyticViewId\"\n            }\n        },\n        \"funAvMetadataDetail\": {\n            \"module\": \"oraErpCoreCommonObjects\",\n            \"businessObject\": \"AnalyticViewMetadataDetail\",\n            \"view\": \"analyticViewMetadataDetailList\",\n            \"fieldAliases\": {\n                \"segmentTypeCode\": \"segmentTypeCode\",\n                \"dimensionLevelAttributes\": \"dimensionLevelAttributes\",\n                \"hierarchyDisplayName\": \"hierarchyDisplayName\",\n                \"dimensionLevelDescriptions\": \"dimensionLevelDescriptions\",\n                \"dimensionSequenceNumber\": \"dimensionSequenceNumber\",\n                \"dimensionAttributes\": \"dimensionAttributes\",\n                \"hierarchyName\": \"hierarchyName\",\n                \"valueSet.valueSetId\": \"valueSetId\",\n                \"dimensionDisplayName\": \"dimensionDisplayName\",\n                \"hierarchyAttributes\": \"hierarchyAttributes\",\n                \"uiFlag\": \"uiFlag\",\n                \"dimensionAttributeName\": \"dimensionAttributeName\",\n                \"tree.treeVersionGUID\": \"treeVersionId\",\n                \"analyticViewId\": \"analyticViewId\"\n            }\n        }\n    }\n}\n\nreturn query;"
          },
          "outcomes": {
            "success": "1781000252396"
          },
          "code": "PREPARE_PAYLOAD_FOR_METADATA",
          "id": "1781000252395",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
