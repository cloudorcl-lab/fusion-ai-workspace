        {
          "metadata": {
            "name": "Extract Intent for Selecting Ledger",
            "answerInUserLanguage": true
          },
          "outcomes": {
            "success": "1778591184091"
          },
          "code": "EXTRACT_INTENT_FOR_SELECTING_LEDGER",
          "id": "1781183665623",
          "inputs": [
            {
              "id": "1781183665623_prompt",
              "name": "prompt",
              "type": "string",
              "value": "You are an intent classification assistant.\n\nClassify whether the user is trying to set, change, update, select, choose, switch, or use an accounting context.\n\nThe accounting context may include:\n- ledger\n- period\n- both ledger and period\n\nReturn only one boolean value:\ntrue\nfalse\n\nReturn true when the user message expresses an intent to set, change, update, select, choose, switch, or use a ledger, period, or both.\n\nReturn true when the message includes a ledger or period reference together with wording that suggests the user wants that ledger or period to be applied, used, selected, or changed.\n\nReturn false when the user is only asking to create alerts, view insights, analyze balances, fetch reports, monitor activity, compare data, summarize information, or update non-context content\n\nRules:\n- The action words set, change, update, select, choose, switch, and use may indicate intent when they are connected to a ledger, period, or both.\n- A ledger name, ledger ID, period name, month, quarter, or year can help identify intent, but should not automatically return true unless the message suggests applying or using it as context.\n- Ledger or period references used only as report filters, analysis filters, comparison inputs, or monitoring criteria should return false.\n- Do not match substrings inside other words.\n- Do not infer ledger or period intent from OraMessageHint alone.\n- If OraAction command is exactly \"selectLedger\", return true.\n- If the user message reasonably indicates changing, selecting, using, or applying a ledger, period, or both, return true.\n- If the message is only informational, analytical, or reporting-related, return false.\n- If uncertain, prefer false.\n\nInput:\nUser message: {{$context.$system.$inputMessage}}\nOraMessageHint: {{$context.$app.$OraMessageHint}}\nOraAction command: {{$context.$nodes.PROCESS_ACTION_CODE.$output.result.command}}\n\nOutput:\nReturn only true or false."
            }
          ],
          "outputSpecification": "",
          "type": "LLM",
          "diagram": {
            "x": 5995.75,
            "y": 7258
          }
        },
        {
          "metadata": {
            "name": "Determine Intent Route",
            "returnType": "boolean",
            "sourceCode": "const oraMessageHint =\n  $context?.$app?.$OraMessageHint ??\n  $context?.$triggers?.REST?.$input?.OraMessageHint ??\n  null;\n\nconst extractLedger = $context.$nodes.EXTRACT_INTENT_FOR_SELECTING_LEDGER.$output || false;\n\nconst inputMessage = String($context?.$system?.$inputMessage ?? \"\").trim();\n\nconst isQueryContextIntent = (oraMessageHint === \"Query\" && extractLedger) || (oraMessageHint === \"InvokeAction\" && $context.$nodes.PROCESS_ACTION_CODE.$output.result?.command === \"selectLedger\");\n\nreturn isQueryContextIntent;"
          },
          "outcomes": {
            "success": "1778591408829"
          },
