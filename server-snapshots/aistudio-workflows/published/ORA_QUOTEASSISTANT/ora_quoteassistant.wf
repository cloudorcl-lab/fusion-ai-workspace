          "code": "SUPERVISOR",
          "id": "1771499556502",
          "inputs": [
            {
              "id": "1771499556503",
              "name": "prompt",
              "type": "string",
              "value": "{{$context.$nodes.SUPERVISORPROMPT.$output.result}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"type\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"agentCall\",\n        \"userCall\"\n      ]\n    },\n    \"agentName\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"productSearchAgent\",\n        \"createQuoteAgent\",\n        \"customerLookUpAgent\",\n        \"generateQuoteCreationPayLoadAgent\",\n        \"processLookUpAgent\",\n        \"generateQuoteUpdatePayLoadAgent\",\n        \"updateQuoteAgent\",\n        \"quoteSummarizationAgent\",\n        \"quoteAdvisorAgent\"\n      ]\n    },\n    \"reason\": {\n      \"type\": \"string\"\n    },\n    \"yourResponseToUser\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"type\"\n  ],\n  \"additionalProperties\": false\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "quoteSummarizeOutputConstructor",
            "returnType": "object",
            "sourceCode": "const output = $context.$nodes.QUOTESUMMARIZE.$output.output;\nconst outputObj = JSON.parse(output);\nconst summary = outputObj.summary;\nconst title = outputObj.title;\nconst nextSteps = Array.isArray(outputObj.nextSteps) ? outputObj.nextSteps : [];\nconst nextStepsText = nextSteps\n  .map((step, index) => `${step}`)\n  .join(\"<br>\");\nconst summaryWithNextSteps = nextStepsText\n  ? `${summary}<br><br><b>Next Steps</b><br>${nextStepsText}`\n  : summary;\n\nlet obj = {\n  \"headerText\": summary,\n  \"payload\": {\n    \"primary\": {\n      \"sections\": [\n        {\n          \"style\": \"section\",\n          \"title\": \"Summary\",\n          \"primaryText\": title,\n          \"secondaryText\": \"\",\n          \"items\": [\n            {\n              \"type\": \"richText\",\n              \"data\": summaryWithNextSteps\n            }\n          ]\n        }\n      ]\n    },\n    \"actions\": [\n      {\n        \"id\": \"copyQuoteSummary\",\n        \"icon\": \"\",\n        \"label\": \"Copy\"\n      },\n      {\n        \"id\": \"emailQuoteSummary\",\n        \"icon\": \"\",\n        \"label\": \"Email\"\n      }\n    ]\n  },\n  \"primaryText\": \"View more\",\n  \"icon\": \"oj-ux-ico-summary\",\n  \"type\": \"chip\"\n};\n\nconst llmOutput = {\n    \"type\":\"userCall\",\n    \"yourResponseToUser\": obj\n};\nreturn llmOutput;"
          },
          "outcomes": {
            "success": "1772453570003"
          },
          "code": "QUOTESUMMARIZEOUTPUTCONSTRUCTOR",
          "id": "1772452350593",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "quoteSummarize",
            "workflowCode": "ORA_QUOTE_SUMMARIZATION_AGENT"
          },
          "outcomes": {
            "success": "1772452350593"
          },
          "code": "QUOTESUMMARIZE",
          "id": "1772452350594",
          "inputs": [
            {
              "id": "1772628059530_1",
              "name": "message",
              "type": "string"
            },
            {
              "id": "1772628059531_2",
              "name": "revisionId",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.revisionId}}"
            },
            {
              "id": "1772628059532_3",
              "name": "subDocName",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.subDocName}}"
            },
            {
              "id": "1772628059533_4",
              "name": "mainDocName",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.mainDocName}}"
            },
            {
              "id": "1772628059534_5",
              "name": "processName",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.processVarName}}"
            },
            {
              "id": "1772628059534_6",
              "name": "cacheInstanceId",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.cacheInstanceId}}"
