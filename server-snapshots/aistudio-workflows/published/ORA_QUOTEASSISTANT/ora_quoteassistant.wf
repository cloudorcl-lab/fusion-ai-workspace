            "loopType": "PARALLEL",
            "name": "fetchDocAttrs"
          },
          "outcomes": {
            "success": "1774258392490"
          },
          "code": "FETCHDOCATTRS",
          "convergenceTargetId": "1774258392490",
          "id": "1774258392492",
          "inputs": [
            {
              "id": "1774258392493",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.POPULATEPARAMSFORGETQUOTE.$output.result}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "populateParamsForGetQuote",
            "returnType": "object",
            "sourceCode": "let fieldsMap = $context.$triggers.REST.$input.fieldsMap;\n\nif (fieldsMap == null || fieldsMap == {} || typeof fieldsMap === \"string\") {\n  fieldsMap = $context.$variables.defaultFieldsMap;\n}\n\nconst result = Object.entries(fieldsMap || {}).map(([key, val]) => {\n  const transformedVal = Array.isArray(val) ? `\"${val.join('\",\"')}\"` : val;\n\n  let processVarName = $context.$triggers.REST.$input.processVarName;\n  let mainDocVarName = $context.$triggers.REST.$input.mainDocName;\n\n  var varProcessVarName = processVarName.charAt(0).toUpperCase() + processVarName.slice(1);\n\n    // Default for mainDocVarName (There is no default)\n  var varMainDocVarName = mainDocVarName.charAt(0).toUpperCase() + mainDocVarName.slice(1);\n\n    // Combined URI var name\n  var uriMainDocVarName = \"commerceDocuments\" + varProcessVarName + varMainDocVarName;\n\n  // returns: [{ field: <key>, property: <value> }, ...]\n  return {\n    docName: key,\n    attrs: transformedVal,\n    attrsArray:val,\n    docUri:uriMainDocVarName\n  };\n});\n\nreturn result;"
          },
          "outcomes": {
            "success": "1774258392492"
          },
          "code": "POPULATEPARAMSFORGETQUOTE",
          "id": "1774258392512",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "quoteAdvisorInput",
            "returnType": "string",
            "sourceCode": "let query = $context.$nodes.QUOTEADVISORHELPER.$output.input;\nlet quote = $context.$variables.quoteDetail;\n\nlet text = `${query}\n              \nAdditional Details: The values of different attributes of the current quote am in is qiven below\n              \n${JSON.stringify(quote)}`\n\nreturn text;"
          },
          "outcomes": {
            "success": "1773055495369"
          },
          "code": "QUOTEADVISORINPUT",
          "id": "1774264963023",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
