        {
          "metadata": {
            "name": "initConversation",
            "returnType": "array",
            "sourceCode": "let conversational = $context.$triggers.REST.$input.conversational;\nlet invocationMode = $context.$triggers.REST.$input.invocationMode;\nlet invocationType = $context.$triggers.REST.$input.invocationType;\nlet transactionId  = $context.$triggers.REST.$input.transactionId;\n\nlet callAgent;\n\nif (typeof conversational !== \"boolean\") {\n   if ($context.$triggers.REST.$input.chatMessage != null && $context.$triggers.REST.$input.chatMessage != '') {\n      conversational = false;\n   }\n   else {\n      conversational = true;\n   }\n}\n\nif(transactionId != null && transactionId > 0){\n  invocationMode = \"Supervised\";\n  callAgent = \"supervisor\";\n  invocationType = \"ModifyQuote\";\n}\nelse {\n   callAgent = 'processLookUpAgent';\n   if(invocationMode == null || invocationMode == ''){\n    invocationMode = \"NonSupervised\";\n   }\n   if(invocationType == null || invocationType == ''){\n    invocationType = \"CreateQuote\";\n   }\n                   \n}\nreturn [conversational, callAgent, invocationMode, invocationType];"
          },
          "outcomes": {
            "success": "1768930231544"
          },
          "code": "INITCONVERSATION",
          "id": "1768912498963",
