            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"type\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"userCall\",\n        \"completedTask\",\n        \"agentCall\"\n      ]\n    },\n    \"status\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"failure\",\n        \"success\"\n      ]\n    },\n    \"toolName\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"documentTrackerIDTool\",\n        \"documentURLTool\"\n      ]\n    },\n    \"toolArgument\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"documentTrackerId\": {\n          \"type\": \"string\"\n        },\n        \"documentURL\": {\n          \"type\": \"string\"\n        },\n        \"read\": {\n          \"type\": \"string\"\n        }\n      },\n      \"additionalProperties\": false\n    },\n    \"step\": {\n      \"type\": \"string\",\n      \"description\": \"State step reached before the tool call\"\n    },\n    \"yourResponseToUser\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"partyNumber\": {\n          \"type\": \"string\"\n        },\n        \"partyUniqueName\": {\n          \"type\": \"string\"\n        },\n        \"noCustomerSpecified\": {\n          \"type\": \"string\"\n        },\n        \"customerDetails\": {\n          \"type\": \"object\"\n        },\n        \"addressDetails\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\"\n          }\n        }\n      },\n      \"additionalProperties\": false\n    },\n    \"agentName\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"supervisor\"\n      ]\n    },\n    \"reason\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"type\"\n  ],\n  \"additionalProperties\": false\n}",
          "type": "AGENT"
        },
        {
          "metadata": {
            "name": "setProcessLookupPrompt",
            "returnType": "string",
            "sourceCode": "let nonConversationPrompt = `\nYou are processSearchAgent.\nUser will give you chathistory between ${$context.$variables.actor} and assistant.\n${$context.$variables.actor} is trying create a quote.\nYour ultimate goal is to find the variable name of the process for which ${$context.$variables.actor} want to create quote.\nYou may or may not be given the default process variable Name as variable defaultProcessVarName.\n\nThe steps you should follow is given below.\nSome times, you will be also given the last executed step. follow execution from that step.\n\n===\nstateDiagram-v2\n    [*] --> s1\n\n    s1: Check if user specified process name or process variable name\n    s1 --> s2: User specified\n    s1 --> s8: User did not specify\n\n    s2: Search cached getProcessTool output\n    s2 --> s3: Found in cache\n    s2 --> s4: Not found in cache\n\n    s3: Get variableName from cache\n    s3 --> s7\n\n    s4: Call getProcessTool\n    s4 --> s5\n\n    s5: Found in getProcessTool output?\n    s5 --> s6: Yes\n    s5 --> s9: No\n\n    s6: Extract variableName from tool output\n    s6 --> s7\n\n    s7: Invoke taskCompletionTool as success with variableName\n    s7 --> [*]\n\n    s8: No process specified\n    s8 --> s7: Set variableName = oraclecpqo (default success)\n\n    s9: Invoke taskCompletionTool as failure with reason\n    s9 --> [*]\n\n===\n\nA cached output of getProcessTool is given below.\n===\n ${JSON.stringify($context.$nodes.POPULATEPROCESS.$output.result)}\n===\ndefaultProcessVarName is : ${$context.$variables.defaultProcess}\n\n-------\n\nYou can do the different invocations as below.\n1. getProcessTool.\nUse this tool to get the different process and their variable names\n\n\n2.Once you accomplished your task then respond\n===\n{\n    \"type\":\"completedTask\",\n    \"status\":\"success\",\n    \"output\": {\n        \"quoteVarName\":\"<variableName of the process>\"\n    }, \n    \"step\" : \"<step in state diagram you reached for this output>\"\n}\n===\n3.if you cant identify the process variable name then respond\n===\n{\n    \"type\":\"completedTask\",\n    \"status\":\"failure\",\n    \"reason\": \"<reason for failure>\",\n    \"step\" : \"<step in state diagram you reached for this output>\"\n}\n===\n\n4. to invoke supervisor agent , respond in below format\n===\n{\n    \"type\":\"agentCall\",\n    \"agentName\":\"supervisor\",\n    \"reason\":\"<reason for transferring call to supervisor>\",\n    \"step\" : \"<step in state diagram you reached for this output>\"\n}\n===\n\n\nSTRICT RULE:\n1.Your response to ${$context.$variables.actor} should be in minimum words.\n2.Your response must be only and only one of toolCall or completedTask or agentCall.\n3.Your response must be a valid json.Dont include any comments or remarks, because your response is directly json parsed.\n\nlast executed Step is = ${$context.$variables.lastExecutedStep}\n`;\n\nlet conversationPrompt = `\nYou are processSearchAgent.\nUser will give you chathistory between ${$context.$variables.actor} and assistant.\n${$context.$variables.actor} is trying create a quote.\nYour ultimate goal is to find the variable name of the process for which ${$context.$variables.actor} want to create quote.\nYou may or may not be given the default process variable Name as variable defaultProcessVarName.\n\nThe steps you should follow is given below.\nSome times, you will be also given the last executed step. follow execution from that step.\n\n===\nstateDiagram-v2\n    [*] --> s1\n\n    s1: Check if user specified process name or variable name\n    s1 --> s2: User specified\n    s1 --> s8: User did not specify\n\n    s2: Search cached getProcessTool output\n    s2 --> s3: Found in cache\n    s2 --> s4: Not found in cache\n\n    s3: Get variableName from cache\n    s3 --> s7\n\n    s4: Call getProcessTool\n    s4 --> s5\n\n    s5: Found in getProcessTool output?\n    s5 --> s6: Yes\n    s5 --> s9: No\n\n    s6: Extract variableName from tool output\n    s6 --> s7\n\n    s7: Invoke taskCompletionTool success with variableName\n    s7 --> [*]\n\n    s8: No process specified\n    s8 --> s10\n\n    s9: Ask user to provide valid process name or variable name\n    s9 --> s1\n\n    s10: Set variableName = oraclecpqo (default)\n    s10 --> s7\n\n===\n\nA cached output of getProcessTool is given below.\n===\n ${JSON.stringify($context.$nodes.POPULATEPROCESS.$output.result)}\n===\ndefaultProcessVarName is : ${$context.$variables.defaultProcess}\n\n-------\n\nYou can do the different invocations as below.\n1. getProcessTool.\nUse this tool to get the different process and their variable names\n\n\n2.Once you accomplished your task then respond\n===\n{\n    \"type\":\"completedTask\",\n    \"status\":\"success\",\n    \"output\": {\n        \"quoteVarName\":\"<variableName of the process>\"\n    },\n    \"step\" : \"<step in state diagram you reached for this output>\"\n}\n===\n3. you **Ask or respond to user** is below format. use this format to ask follow up questions or you need a feedback or response from user to continue your task.\n===\n{\n   \"type\":\"userCall\",\n   \"yourResponseToUser\":\"<your Response To User in good readable stylish format>\",\n   \"step\" : \"<step in state diagram you reached for this output>\"\n}\n===\n\n4. to invoke supervisor agent , respond in below format. use this format to terminate the task. Usually this is done if user's  chat is not related to process identification.\n===\n{\n    \"type\":\"agentCall\",\n    \"agentName\":\"supervisor\",\n    \"reason\":\"<reason for transferring call to supervisor>\",\n    \"step\" : \"<step in state diagram you reached for this output>\"\n===\n\nSTRICT RULE:\n1.Your response to ${$context.$variables.actor} should be in minimum words.\n2.Your response must be only and only one of toolCall or completedTask or userCall or agentCall.\n3.Your response must be a valid json.Dont include any comments or remarks, because your response is directly json parsed.\n\nlast executed Step is = ${$context.$variables.lastExecutedStep}\n`;\n\nlet prompt = nonConversationPrompt;\nif($context.$variables.conversational == true){\n   prompt = conversationPrompt;\n}\nreturn prompt;"
          },
