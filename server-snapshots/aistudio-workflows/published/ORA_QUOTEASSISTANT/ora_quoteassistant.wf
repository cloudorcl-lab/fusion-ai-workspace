          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"type\": {\n      \"type\": \"string\",\n      \"enum\": [\"userCall\", \"completedTask\", \"agentCall\"]\n    },\n    \"status\": {\n      \"type\": \"string\",\n      \"enum\": [\"success\", \"failure\"]\n    },\n    \"yourResponseToUser\": { \"type\": \"string\" },\n    \"output\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"bsid\": { \"type\": \"string\" },\n        \"html\": { \"type\": \"string\" }\n      },\n      \"required\": [\"bsid\", \"html\"],\n      \"additionalProperties\": false\n    },\n    \"agentName\": {\n      \"type\": \"string\",\n      \"enum\": [\"supervisor\"]\n    },\n    \"reason\": { \"type\": \"string\" }\n  },\n  \"required\": [\"type\"],\n  \"additionalProperties\": false\n}",
          "type": "AGENT"
        },
        {
          "metadata": {
            "name": "setConstructLLMOutputForCompletedTask",
            "sourceCode": "let llmOutputType = $context.$nodes.CREATEQUOTEAGENT.$output.type;\nlet llmOutput = $context.$nodes.CREATEQUOTEAGENT.$output;\nlet conversational = $context.$variables.conversational;\n\nif (llmOutputType == 'completedTask' && conversational){\n   llmOutput = {\"type\" : \"userCall\",\"yourResponseToUser\" : $context.$nodes.CREATEQUOTEAGENT.$output.output.html};\n}\n\nreturn JSON.stringify(llmOutput);"
          },
