            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "dataPipeline": {
              "rootNode": "start_1774258392492",
              "pipelineNodes": [
                {
                  "metadata": {
                    "name": "Start",
                    "description": "Start of data pipeline"
                  },
                  "outcomes": {
                    "success": "1774258392509"
                  },
                  "id": "start_1774258392492",
                  "code": "START_1774258392492",
                  "type": "START"
                },
                {
                  "outcomes": {
                    "success": "end_1774258392492"
                  },
                  "metadata": {
                    "name": "constructQuoteDetailsOutput",
                    "returnType": "string",
                    "sourceCode": "\n// ============================================================\n// Output format (simple):\n//   { \"<docName>\": <enrichedFields> }\n//\n// If main doc: <enrichedFields> is an array of enriched field objects\n// If child doc: <enrichedFields> is an array where each element is\n//               an array of enriched field objects (one per item)\n//               (no identifier wrapper object)\n// ============================================================\n\n// --- STEP 1: GET ATTRIBUTES TO INCLUDE (already an array) ---\nvar includeAttrsRaw = (($context.$nodes.FETCHDOCATTRS.$currentItem || {}).attrsArray) || [];\nvar includeAttrsArray = [];\n\nfor (var a = 0; a < includeAttrsRaw.length; a++) {\n  var attrName = includeAttrsRaw[a];\n\n  // If attrsArray contains objects, try common properties\n  if (attrName && typeof attrName === \"object\") {\n    attrName = attrName.variableName || attrName.name || attrName.fieldName || \"\";\n  }\n\n  attrName = String(attrName).split('\"').join(\"\").trim();\n  if (attrName.length > 0) includeAttrsArray.push(attrName);\n}\n\n// --- STEP 2: BUILD DOC ATTRIBUTE MAP (from getDocAttrs) ---\nvar attrItems = ($context.$nodes.FETCHDOCATTRS.GETDOCATTRS.$output && $context.$nodes.FETCHDOCATTRS.GETDOCATTRS.$output.items) ? $context.$nodes.FETCHDOCATTRS.GETDOCATTRS.$output.items : [];\nvar mainAttrMap = {};\n\nfor (var i = 0; i < attrItems.length; i++) {\n  var attr = attrItems[i];\n  var varName = attr.variableName;\n\n  mainAttrMap[varName] = {\n    label: attr.label || varName,\n    dataType: attr.type ? attr.type.displayValue : \"Text\",\n    required: attr.required || false,\n    readOnly: attr.readOnly || false\n  };\n}\n\n// --- STEP 3: PICK THE RIGHT QUOTE SOURCE ---\nvar currentDocName = ($context.$nodes.FETCHDOCATTRS.$currentItem || {}).docName;\nvar mainDocName = $context.$triggers.REST.$input.mainDocName;\nvar isMainDoc = (currentDocName === mainDocName);\n\n// --- STEP 4: ENRICH + SIMPLE OUTPUT ---\nvar output = {};\n\nif (isMainDoc) {\n  // MAIN DOC: getQuoteDetails.output.documents OR getQuoteDetails.output\n  var quoteDataRaw = $context.$nodes.FETCHDOCATTRS.GETQUOTEDETAILS.$output;\n  var quoteDoc = (quoteDataRaw && quoteDataRaw.documents) ? quoteDataRaw.documents : quoteDataRaw;\n\n  var enrichedQuote = [];\n\n  for (var q = 0; q < includeAttrsArray.length; q++) {\n    var fieldName = includeAttrsArray[q];\n\n    if (!quoteDoc || !Object.prototype.hasOwnProperty.call(quoteDoc, fieldName)) continue;\n\n    var fieldValue = quoteDoc[fieldName];\n    var meta = mainAttrMap[fieldName];\n\n    // isNull logic (kept consistent with your original script)\n    var isNull = false;\n    if (fieldValue === null || fieldValue === undefined || fieldValue === \"\") {\n      isNull = true;\n    } else if (typeof fieldValue === \"object\" && fieldValue !== null && fieldValue.value !== undefined) {\n      isNull = (fieldValue.value === null || fieldValue.value === 0);\n    }\n\n    // displayValue logic\n    var displayValue = fieldValue;\n    if (typeof fieldValue === \"object\" && fieldValue !== null) {\n      if (fieldValue.displayValue !== undefined) {\n        displayValue = fieldValue.displayValue;\n      } else if (fieldValue.value !== undefined && fieldValue.currency !== undefined) {\n        displayValue = fieldValue.currency + \" \" + fieldValue.value;\n      }\n    }\n\n    enrichedQuote.push({\n      fieldName: fieldName,\n      label: meta ? meta.label : fieldName,\n      dataType: meta ? meta.dataType : \"Unknown\",\n      required: meta ? meta.required : false,\n      readOnly: meta ? meta.readOnly : false,\n      value: displayValue,\n      isNull: isNull\n    });\n  }\n\n  output[currentDocName] = enrichedQuote;\n\n} else {\n  // CHILD DOC: getQuoteDetailsWithChildren.output.documents[docName].items[]\n  var quoteDataRawChild = $context.$nodes.FETCHDOCATTRS.GETQUOTEDETAILSWITHCHILDREN.$output;\n  var documents = quoteDataRawChild ? quoteDataRawChild.documents : null;\n\n  var childContainer = (documents && currentDocName && documents[currentDocName]) ? documents[currentDocName] : null;\n  var items = (childContainer && Array.isArray(childContainer.items)) ? childContainer.items : [];\n\n  // Array-of-arrays: each entry corresponds to one item, containing enriched fields\n  var enrichedItems = [];\n\n  for (var k = 0; k < items.length; k++) {\n    var itemDoc = items[k];\n    var enrichedFieldsForItem = [];\n\n    for (var r = 0; r < includeAttrsArray.length; r++) {\n      var itemFieldName = includeAttrsArray[r];\n\n      if (!itemDoc || !Object.prototype.hasOwnProperty.call(itemDoc, itemFieldName)) continue;\n\n      var itemFieldValue = itemDoc[itemFieldName];\n      var itemMeta = mainAttrMap[itemFieldName];\n\n      // isNull logic\n      var itemIsNull = false;\n      if (itemFieldValue === null || itemFieldValue === undefined || itemFieldValue === \"\") {\n        itemIsNull = true;\n      } else if (typeof itemFieldValue === \"object\" && itemFieldValue !== null && itemFieldValue.value !== undefined) {\n        itemIsNull = (itemFieldValue.value === null || itemFieldValue.value === 0);\n      }\n\n      // displayValue logic\n      var itemDisplayValue = itemFieldValue;\n      if (typeof itemFieldValue === \"object\" && itemFieldValue !== null) {\n        if (itemFieldValue.displayValue !== undefined) {\n          itemDisplayValue = itemFieldValue.displayValue;\n        } else if (itemFieldValue.value !== undefined && itemFieldValue.currency !== undefined) {\n          itemDisplayValue = itemFieldValue.currency + \" \" + itemFieldValue.value;\n        }\n      }\n\n      enrichedFieldsForItem.push({\n        fieldName: itemFieldName,\n        label: itemMeta ? itemMeta.label : itemFieldName,\n        dataType: itemMeta ? itemMeta.dataType : \"Unknown\",\n        required: itemMeta ? itemMeta.required : false,\n        readOnly: itemMeta ? itemMeta.readOnly : false,\n        value: itemDisplayValue,\n        isNull: itemIsNull\n      });\n    }\n\n    // Push ONLY the array of fields (no wrapper object)\n    enrichedItems.push(enrichedFieldsForItem);\n  }\n\n  output[currentDocName] = enrichedItems;\n}\noutput = JSON.stringify(output);\nreturn output;\n              "
                  },
