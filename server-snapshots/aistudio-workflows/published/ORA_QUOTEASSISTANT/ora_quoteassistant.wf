          "metadata": {
            "name": "setProductSearchOutput"
          },
          "outcomes": {
            "success": "1759142566318"
          },
          "code": "SETPRODUCTSEARCHOUTPUT",
          "id": "1774258392487",
          "inputs": [
            {
              "id": "1774258392488",
              "name": "llmOutput",
              "scope": "JOB",
              "type": "object",
              "value": "{{$context.$nodes.PRODUCTSEARCHOUTPUTCONSTRUCTOR.$output.result}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "productSearchOutputConstructor",
            "returnType": "object",
            "sourceCode": "const agentOutput = $context.$nodes.PRODUCTSEARCHAGENT.$output;\n\nlet output = null;\nif(agentOutput.type == 'userCall' && agentOutput.yourResponseToUser.payloadType == 'productSearchCustomTool') {\n  const payload = agentOutput.yourResponseToUser.payload;\n  const sectionText = agentOutput.yourResponseToUser.productNameText\n  const sectionSecondaryTextInput = agentOutput.yourResponseToUser.productNameSecondaryText;\n  let maxNumberOfResults = agentOutput.yourResponseToUser.maxNumberOfResults;\n  maxNumberOfResults = typeof maxNumberOfResults === \"number\" ? maxNumberOfResults : 5;\n\n  delete agentOutput.yourResponseToUser.payloadType;\n  delete agentOutput.yourResponseToUser.productNameText;\n  delete agentOutput.yourResponseToUser.productNameSecondaryText;\n  delete agentOutput.yourResponseToUser.maxNumberOfResults;\n\n  const src = typeof payload === \"string\" ? JSON.parse(payload) : payload;\n  const products = src?.output?.products ?? src?.products ?? [];\n\n  const getMatches = (p) => {\n    const quantity = p?.quantity;\n\n    // Priority: array fields first\n    if (Array.isArray(p?.results)) {\n      return p.results.map((m) => ({ ...m, quantity }));\n    }\n    if (Array.isArray(p?.topMatchesInCatalog)) {\n      return p.topMatchesInCatalog.map((m) => ({ ...m, quantity }));\n    }\n\n    // Sometimes a single best match object is provided\n    if (p?.bestMatchInCatalog && typeof p.bestMatchInCatalog === \"object\") {\n      return [{ ...p.bestMatchInCatalog, quantity }];\n    }\n\n    return [];\n  };\n\n  const productNames = products\n    .map((p) => p?.productName)\n    .filter((name) => typeof name === \"string\" && name.trim() !== \"\");\n\n  const topMatches = products\n    .flatMap((p) => getMatches(p))\n    .sort((a, b) => (b?.matchPercentage ?? 0) - (a?.matchPercentage ?? 0))\n    .slice(0, maxNumberOfResults);\n\n  const totalCount = topMatches.length;\n\n  const sectionPrimaryText = (typeof sectionText === \"string\" && sectionText.trim() !== \"\")\n    ? sectionText\n    : \"Matching products\";\n\n  const defaultSectionSecondaryText = \"Products matching your requested items have been identified. Please review and select the items to add to your quote.\";\n  const sectionSecondaryText = (typeof sectionSecondaryTextInput === \"string\" && sectionSecondaryTextInput.trim() !== \"\")\n    ? sectionSecondaryTextInput\n    : defaultSectionSecondaryText;\n\n  const newPayload = {\n    primary: {\n      sections: [\n        {\n          style: \"section\",\n          title: \"Choose Products\",\n          primaryText: sectionPrimaryText,\n          secondaryText: sectionSecondaryText,\n          items: [\n            {\n              type: \"productCard\",\n              data: topMatches,\n            },\n          ],\n        },\n      ],\n    },\n    actions: [\n      {\n        id: \"_update_line_items\",\n        icon: \"\",\n        label: \"Add Products\",\n      },\n    ],\n  };\n\n  agentOutput.yourResponseToUser.primaryText = `${totalCount} Results`;\n\n  agentOutput.yourResponseToUser.payload = newPayload;\n  output = agentOutput;\n\n}\nif (output == null){\n  output = $context.$nodes.PRODUCTSEARCHAGENT.$output;\n}\nreturn output;\n"
          },
          "outcomes": {
            "success": "1774258392487"
          },
          "code": "PRODUCTSEARCHOUTPUTCONSTRUCTOR",
          "id": "1774258392489",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
