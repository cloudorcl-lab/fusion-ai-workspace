        {
          "metadata": {
            "name": "decideToStopWorkflow",
            "returnType": "boolean",
            "sourceCode": "let invocationType = $context.$variables.invocationType;\nlet llmMakes = $context.$variables.llmMakes;\nlet llmOutput = $context.$variables.llmOutput;\n\nlet taskMap = $context.$variables.taskMap;\nlet output = false;\nlet actedByAgent = $context.$variables.actedByAgent;\nlet conversational = $context.$variables.conversational;\n\nif(llmMakes == null || llmMakes == \"\"){\n   llmMakes = $context.$variables.llmOutput.type;\n}\nif (llmMakes == 'completedTask' && conversational === false) {\n    if (llmOutput.status == 'failure') {\n        output = true;\n    } else {\n        const mappedAgent = taskMap[invocationType];\n        if (mappedAgent === actedByAgent) {\n            output = true;\n        } else if (actedByAgent == 'createQuoteAgent') {\n            output = true;\n        }\n    }\n\n}\nelse if(llmMakes == 'userCall'){\n   output = true;\n}\nreturn output;"
          },
          "outcomes": {
            "success": "1768934045628"
          },
