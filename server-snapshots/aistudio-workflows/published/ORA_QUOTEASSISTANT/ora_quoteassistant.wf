              "value": "{{$context.$variables.llmInput}}"
            },
            {
              "id": "1775048523455_2",
              "name": "customPrompt",
              "type": "string",
              "value": "{{$context.$nodes.SETPRODUCTSEARCHAGENTPROMPT.$output.result}}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"type\": {\n            \"type\": \"string\",\n            \"enum\": [\n                \"toolCall\",\n                \"userCall\",\n                \"agentCall\",\n                \"completedTask\"\n            ]\n        },\n        \"status\": {\n            \"type\": \"string\",\n            \"enum\": [\n                \"failure\",\n                \"success\"\n            ]\n        },\n        \"toolName\": {\n            \"type\": \"string\",\n            \"enum\": [\n                \"documentTrackerIDTool\",\n                \"documentURLTool\"\n            ]\n        },\n        \"toolArgument\": {\n            \"type\": \"object\",\n            \"properties\": {\n                \"documentTrackerId\": {\n                    \"type\": \"string\"\n                },\n                \"documentURL\": {\n                    \"type\": \"string\"\n                }\n            },\n            \"additionalProperties\": false\n        },\n        \"step\": {\n            \"type\": \"string\",\n            \"description\": \"State step reached before the tool call\"\n        },\n        \"yourResponseToUser\": {\n            \"type\": \"string\"\n        },\n        \"output\": {\n            \"type\": \"object\",\n            \"properties\": {\n                \"products\": {\n                    \"type\": \"array\",\n                    \"items\": {\n                        \"type\": \"object\",\n                        \"properties\": {\n                            \"productName\": {\n                                \"type\": \"string\"\n                            },\n                            \"description\": {\n                                \"type\": \"string\"\n                            },\n                            \"quantity\": {\n                                \"type\": \"string\"\n                            },\n                            \"bestMatchInCatalogue\": {\n                                \"type\": \"object\",\n                                \"properties\": {\n                                    \"description\": {\n                                        \"type\": \"string\"\n                                    },\n                                    \"label\": {\n                                        \"type\": \"string\"\n                                    },\n                                    \"partNumber\": {\n                                        \"type\": \"string\"\n                                    },\n                                    \"model\": {\n                                        \"type\": \"string\"\n                                    },\n                                    \"modelPath\": {\n                                        \"type\": \"string\"\n                                    },\n                                    \"matchPercentage\": {\n                                        \"type\": \"integer\"\n                                    }\n                                },\n                                \"required\": [\n                                    \"partNumber\"\n                                ],\n                                \"additionalProperties\": false\n                            }\n                        },\n                        \"required\": [\n                            \"productName\",\n                            \"description\",\n                            \"quantity\",\n                            \"bestMatchInCatalogue\"\n                        ],\n                        \"additionalProperties\": false\n                    }\n                }\n            },\n            \"required\": [\n                \"products\"\n            ],\n            \"additionalProperties\": false\n        },\n        \"reason\": {\n            \"type\": \"string\"\n        },\n        \"agentName\": {\n            \"type\": \"string\",\n            \"enum\": [\n                \"supervisor\"\n            ]\n        }\n    },\n    \"required\": [\n        \"type\"\n    ]\n}",
