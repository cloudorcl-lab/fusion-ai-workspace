        {
          "metadata": {
            "name": "formatChatHistory",
            "returnType": "object",
            "sourceCode": "let incomingMessage = $context.$triggers.REST.$input.chatMessage;\nlet lineBreak = '\\n';\nlet transactionId   = $context.$triggers.REST.$input.transactionId;\nlet processVarName  = $context.$triggers.REST.$input.processVarName;\n\nlet cacheInstanceId  = $context.$triggers.REST.$input.cacheInstanceId;\nlet priceBookVarName = $context.$triggers.REST.$input.priceBookVarName;\nlet defaultPriceBookVarName = $context.$variables.defaultPriceBookVarName;\n\nif(incomingMessage == null || incomingMessage === ''){\n   incomingMessage = $context.$system.$inputMessage;\n}\nlet formattedInputMessage =\n  \"<\" +$context.$variables.actor + \">\" + incomingMessage + \"</\" + $context.$variables.actor + \">\";\n\nlet chatHistory = $context.$variables.chatHistory;\nif(chatHistory == null || chatHistory ===''){\n   if(transactionId != null && transactionId > 0){\n    // user is already in context of a quteo\n    let systemMessage = \"<SystemMessage>User is already in Context of a Quote. Quote Id is \" + transactionId + \"</SystemMessage>\";\n    chatHistory = systemMessage + lineBreak + formattedInputMessage;\n   }\n   else{\n    chatHistory = formattedInputMessage;\n   }\n}\nelse{\n   chatHistory = chatHistory + lineBreak + formattedInputMessage;\n}\n\nlet callAgent = $context.$variables.callAgent || $context.$variables.actedByAgent;\nlet actedByAgent = $context.$variables.callAgent || $context.$variables.actedByAgent;\n\nif(callAgent == 'quoteSummarizationAgent'){\n  callAgent = 'supervisor';\n  actedByAgent = 'supervisor';\n}\n\nconst hasValue = v => v !== null && v !== undefined && String(v).trim() !== \"\";\n\nlet context = {};\n\nif (hasValue(priceBookVarName)) {\n    context.pricebookVarName = priceBookVarName;\n}\nelse {\n    context.pricebookVarName = defaultPriceBookVarName;\n}\n\nconst commerce = {};\n\nif (hasValue(transactionId)) {\n    commerce.id = transactionId;\n}\n\nif (hasValue(cacheInstanceId)) {\n    commerce.cacheInstanceId = cacheInstanceId;\n}\n\nif (hasValue(processVarName)) {\n    commerce.process = {\n        variableName: processVarName\n    };\n}\n\n// Only attach commerce if it has at least one property\nif (Object.keys(commerce).length > 0) {\n    context.commerce = commerce;\n}\n\n// If context is still empty, return null\ncontext = Object.keys(context).length > 0 ? context : null;\n\nlet outputObj = {\n  chatHistory:chatHistory,\n  callAgent:callAgent,\n  actedByAgent:actedByAgent,\n  context:context\n}\nreturn outputObj;"
          },
          "outcomes": {
            "success": "1759137529302"
          },
          "code": "FORMATCHATHISTORY",
