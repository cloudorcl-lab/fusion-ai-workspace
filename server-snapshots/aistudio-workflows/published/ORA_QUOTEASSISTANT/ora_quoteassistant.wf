            {
              "id": "1774956855710",
              "name": "customerProperties",
              "scope": "JOB",
              "type": "string",
              "value": "Customer-related properties\n======================\n_customer_id\n_customer_t_state\n_customer_t_address\n_customer_t_country\n_customer_t_email\n_customer_t_city\n_customer_t_zip\n_customer_t_fax\n_customer_t_company_name\n_customer_t_phone\n_customer_t_last_name\n_customer_t_first_name\n_customer_t_company_name_2\n_customer_t_address_2\n_customer_t_status_t\n_s_customerStatus_t\n_s_customerVisibilityIdentifier_t\n_s_customerPartySiteID_t\n\nGeneral Account Address\n===================\naccountAddressLine1_t\naccountAddressLine2_t\naccountAddressLine3_t\naccountAddressLine4_t\naccountAddressElementAttribute1_t\naccountAddressElementAttribute2_t\naccountAddressElementAttribute3_t\naccountAddressElementAttribute4_t\naccountAddressElementAttribute5_t\naccountCity_t\naccountState_t\naccountProvince_t\naccountCountry_t\naccountPostalCode_t\n\n\n\nBill To Address\n=============\n_s_billTo_t_address\n_s_billTo_t_address_2\n_s_billTo_t_city\n_s_billTo_t_state\n_s_billTo_t_zip\n_s_billTo_t_country\n\n\nShip To Address\n============\n_shipTo_t_address\n_shipTo_t_address_2\n_shipTo_t_city\n_shipTo_t_state\n_shipTo_t_zip\n_shipTo_t_country\n\n\nInvoice To Address\n==============\n_invoiceTo_t_address\n_invoiceTo_t_address_2\n_invoiceTo_t_city\n_invoiceTo_t_state\n_invoiceTo_t_zip\n_invoiceTo_t_country"
