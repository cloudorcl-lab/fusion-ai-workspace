          "inputs": [
            {
              "id": "1769759093235_1",
              "name": "P_ITEM_NUMBERS",
              "type": "string",
              "value": "{{$context.$nodes.UNIQUE_ITEMS_AND_ORGANIZATIONS_EXTRACTOR.$output.result.Items}}"
