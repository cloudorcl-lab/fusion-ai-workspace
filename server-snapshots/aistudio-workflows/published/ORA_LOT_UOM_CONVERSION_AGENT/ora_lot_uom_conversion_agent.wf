{
  "workflowId": "300000327004237",
  "workflowCode": "ORA_LOT_UOM_CONVERSION_AGENT",
  "name": "Lot UOM Conversion Agent",
  "description": "AI Agent for handling Lot UOM Conversions. This can do following operations\n\n1. Update lot uom conversion -\tCreate or Update the lot unit of measure conversion for a given lot, item and org\n2. Adjust lot onhand as new conversion - Update onhand for a given lot, item and org by recalculating based on the new lot uom conversion rate",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
