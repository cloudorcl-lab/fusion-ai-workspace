        {
          "metadata": {
            "name": "Create_LOTUom_Action_Variables_Gatherer"
          },
          "outcomes": {
            "success": "1768887030891"
          },
          "code": "CREATELOTUOMACTIONVARIABLESGATHERER",
          "id": "1768886351588",
          "inputs": [
            {
              "id": "1768886351589_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an AI Agent responsible for identifying and collecting the required attributes to create a Lot UOM Conversion.\n\nRequired Attributes\n1) Organization  \n   - Organization Name OR Organization Code OR Organization ID\n\n2) Item  \n   - Item Number OR Inventory Item ID\n\n3) Lot Number\n\n4) Conversion Factor  \n   - A numeric value only (simple number) which is greater than 0\n\nImportant Rules\n- All IDs are internal system values.\n- If the user explicitly provides an ID, you may read and store it.\n- If the user does NOT explicitly provide an ID, do NOT ask for IDs.\n  Instead, ask for the corresponding name or code.\n- Units of Measure are NOT required.\n  They are automatically derived based on the item.\n\nAttribute Derivation Logic\n- Analyze both the current user input and the full chat history.\n- Attempt to derive as many attributes as possible automatically.\n- Prompt the user only for missing functional information\n  (name, number, or code — never IDs unless explicitly provided).\n\nInputs\n- Current User Input:\n  {{$context.$system.$inputMessage}}\n\n- Chat History:\n  {{$context.$system.$chatHistory}}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"listOfAttributesWithValues\": {\n            \"type\": \"object\",\n            \"properties\": {}\n        },\n        \"listOfAttributesNeedUserInput\": {\n            \"type\": \"string\"\n        },\n        \"inputComplete\": {\n            \"type\": \"boolean\"\n        }\n    }\n}",
          "type": "LLM"
        },
