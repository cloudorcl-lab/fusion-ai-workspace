              "value": "You are an AI Agent for preparing the payload for creating Lot UOM.\n\nVariables - {{$context.$nodes.CREATELOTUOMACTIONVARIABLESGATHERER.$output.listOfAttributesWithValues}}\n\n{\n\"ItemNumber\" : \"<ItemNumber>\"\n\"OrganizationName\" : \"<OrganizationName> or <OrganizationCode>\",\n\"LotNumber\": \"<Lot Number>\",\n\"ConversionFactor\": \"<Lot Conversion Factor>\"\n}\n\nDo not include any null values"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"ConversionFactor\": {\n            \"type\": \"number\"\n        },\n        \"LotNumber\": {\n            \"type\": \"string\"\n        },\n        \"OrganizationName\": {\n            \"type\": \"string\"\n        },\n        \"ItemNumber\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
