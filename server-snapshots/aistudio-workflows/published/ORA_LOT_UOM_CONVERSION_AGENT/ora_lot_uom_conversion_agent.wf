            "name": "Missing Update Action",
            "returnType": "object",
            "sourceCode": "let payload = {};\n\nthrow new Error(`Ask user on how to update onhand after uom update. \n\nPossible Options\n\n--------------------------------------------------\nUPDATE ACTION DEFINITIONS\n--------------------------------------------------\nORA_RECALCPRIMQTY  → Recalculate Primary Quantity based on Secondary Quantity\n\nORA_RECALCSECQTY  → Recalculate Secondary Quantity based on Primary Quantity\n\nSKIP → Skip this step\n\n------------------------\n\nPresent the user with the definition not the code. Once the option is selected, it will be applied for all recommendations. Mention this to the user.\n`);\n\nreturn payload;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "MISSING_UPDATE_ACTION",
          "id": "1769743988298",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
