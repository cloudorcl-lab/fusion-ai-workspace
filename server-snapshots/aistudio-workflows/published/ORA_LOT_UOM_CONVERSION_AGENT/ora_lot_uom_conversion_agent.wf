        {
          "metadata": {
            "errorNodeId": "1769672444297",
            "name": "Lot UOM Conversion Payload Creator",
            "returnType": "object",
            "sourceCode": "let payload = {};\n\n\npayload.OrganizationId= $context.$nodes.ORGANIZATION_ID_FINDER.$output?.items[0]?.OrganizationId;\npayload.InventoryItemId= $context.$nodes.ITEM_ID_FINDER.$output.items[0]?.ItemId; \npayload.LotNumber= $context.$nodes.JSON_REQUEST_CREATOR.$output.LotNumber;\npayload.ConversionFactor= $context.$nodes.JSON_REQUEST_CREATOR.$output.ConversionFactor;\n\nif(!payload.OrganizationId){\n    throw new Error (`\nError - Enter a valid organization \n\nVariables -  ${JSON.stringify($context.$nodes.JSON_REQUEST_CREATOR.$output)}\n\n`);\n}\n\n\nif(!payload.InventoryItemId){\n\n    throw new Error (`\nError - Enter a valid Item\n\nVariables -  ${JSON.stringify($context.$nodes.JSON_REQUEST_CREATOR.$output)}\n\n`);\n}\n\nreturn payload;"
          },
          "outcomes": {
            "success": "1769659382226"
          },
          "code": "LOT_UOM_CONVERSION_PAYLOAD_CREATOR",
          "id": "1769660286228",
          "inputs": [],
