        {
          "metadata": {
            "name": "Unique Items and Organizations Extractor",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.BULK_EXECUTE_LLM_.$output.payload;\n\n// Unique Organization Codes\nconst uniqueOrgCodes = [...new Set(data.map(item => `'${item.OrganizationCode}'`))];\n// Unique Item Numbers\nconst uniqueItems = [...new Set(data.map(item => `'${item.ItemNumber}'`))];\n// Comma-separated strings\nconst orgCodesStr = uniqueOrgCodes.join(', ');\nconst itemsStr = uniqueItems.join(', ');\nlet payload = {};\npayload.Organizations = orgCodesStr;\npayload.Items = itemsStr;\n\n\nreturn payload;"
          },
          "outcomes": {
            "success": "1769758973924"
          },
          "code": "UNIQUE_ITEMS_AND_ORGANIZATIONS_EXTRACTOR",
          "id": "1769755105283",
          "inputs": [],
