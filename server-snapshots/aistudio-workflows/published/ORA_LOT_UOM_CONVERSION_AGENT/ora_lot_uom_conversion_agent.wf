        {
          "metadata": {
            "name": "Bulk Update Payload Creator",
            "returnType": "object",
            "sourceCode": "const itemsResponse = $context.$nodes.BULD_ITEM_IDS_RESOLVER.$output;\n\nconst itemMap = {};\nfor (const item of itemsResponse.items) {\n  itemMap[item.ItemNumber] = item.ItemId;\n}\n\nconst orgsResponse = $context.$nodes.BULK_ORGANIZATION_ID_FINDER.$output;\n\nconst orgsMap = {};\nfor (const org of orgsResponse.items) {\n  orgsMap[org.OrganizationCode] = org.OrganizationId;\n}\n\nconst data = $context.$nodes.BULK_EXECUTE_LLM_.$output.payload;\n\nfor (let idx = 0; idx < data.length; idx++) {\n  const eachData = data[idx];\n\n  // Prepare transformed values\n  const OrganizationId = orgsMap[eachData.OrganizationCode];\n  const InventoryItemId = itemMap[eachData.ItemNumber];\n  const LotNumber = eachData.LotNumber;\n  const ConversionFactor = eachData.ConversionFactor;\n  const UpdateAction = eachData.UpdateAction;\n\n  // Attach Lot UOM Conversion request\n  eachData.lotUOMConversionRequest = {\n    OrganizationId,\n    InventoryItemId,\n    LotNumber,\n    ConversionFactor\n  };\n\n  // Attach Onhand Lot UOM Conversion request\n  eachData.onHandLotUOMConvRequest = {\n    updateAction: UpdateAction,\n    organizationId: OrganizationId,\n    lotNumber: LotNumber,\n    inventoryItemId: InventoryItemId,\n    lotConversionId: \"-2\"\n  };\n}\n\nreturn data;"
          },
          "outcomes": {
            "success": "1769765119299"
          },
          "code": "BULK_UPDATE_PAYLOAD_CREATOR",
          "id": "1769760528556",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
