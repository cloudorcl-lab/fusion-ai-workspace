          "code": "HISTORY_SECTION_1",
          "convergenceTargetId": "1771465148583",
          "id": "1771462206116",
          "inputs": [
            {
              "id": "1771462206118_1",
              "name": "prompt",
              "type": "string",
              "value": "Consider the following building inspection:\n```\n{{$context.$nodes.SET_INSPECTION_TYPE_DESCRIPTION.$output.result}}\n```\nAnd the following inspection comments:\n```\n{{$context.$nodes.GET_INSP_COMMENTS.$output}} \n\nProvide a short paragraph summary of the above containing a brief high-level summary in natural language. Make sure to mention any Major Violations. Also make sure to mention the Inspection ID and the Inspection Type.\nDo not use a list format, but be succinct.\nDo not output the SystemResult, only output the Result.\nDo not include any internal identifiers e.g. numeric codes\nDo not provide any advice - only summarize the data in the tree structure, do not add anything other information or advice.\nDo not refer to 'data', 'tree', or any other technical terms in this prompt.\nIf any dates or times are included, make sure to use these formatting Preferences:  {{$context.$variables.Preferences}}"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "set inspection type description",
            "returnType": "object",
            "sourceCode": "const reinspection = $context.$variables.ReinspectionOf;\nconst inspectionTypeDesc = $context.$nodes.GET_INSPECTION_TYPE.$output.items[0].Description;\nreinspection.InspectionType = inspectionTypeDesc;\nreturn reinspection;"
          },
          "outcomes": {
            "success": "1771462206116"
          },
          "code": "SET_INSPECTION_TYPE_DESCRIPTION",
          "convergenceTargetId": "1771462206116",
          "id": "1771465148583",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "summarize checklists",
            "returnType": "string",
            "sourceCode": "const inspectionId = $context.$variables.ReinspectionIdOf;\nconst allChecklists = $context.$nodes.GET_ALL_CHECKLISTS.$output.items || [];\nconst allChecklistItems = $context.$nodes.GET_ALL_CHECKLIST_ITEMS.$output.items || [];\nconst assessResponse = $context.$nodes.GET_ASSESSMENT_DETAILS.$output.items || [];\n\nconst makeKey = (a, b) => `${a}||${b}`;\nconst escapeHtml = (value) =>\n  String(value ?? '')\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\n\nconst getSystemResult = (assessmentMap, assessmentType, assessmentCode) => {\n  if (!assessmentType || !assessmentCode) return null;\n  return assessmentMap.get(makeKey(assessmentType, assessmentCode)) || null;\n};\n\nconst checklists = allChecklists.filter(\n  (c) => c.InspectionId === inspectionId\n);\nconst checklistItems = allChecklistItems.filter(\n  (i) => i.InspectionId === inspectionId\n);\n\nconst assessmentMap = new Map(\n  assessResponse.map((a) => [makeKey(a.AssessmentType, a.AssessmentCode), a.SystemResult])\n);\n\nconst checklistKey = (inspectionId, checklistId) => makeKey(inspectionId, checklistId);\n\nconst checklistByKey = new Map(\n  checklists.map((c) => [checklistKey(c.InspectionId, c.ChecklistId), c])\n);\n\nconst failedItemsByChecklist = checklistItems.reduce((acc, item) => {\n  const key = checklistKey(item.InspectionId, item.ChecklistId);\n  const parentChecklist = checklistByKey.get(key);\n  if (!parentChecklist) return acc;\n\n  const itemSystemResult = getSystemResult(\n    assessmentMap,\n    parentChecklist.AssessmentType,\n    item.ChecklistItemResult\n  );\n\n  if (itemSystemResult !== 'FAIL') return acc;\n\n  if (!acc[key]) acc[key] = [];\n  acc[key].push(item);\n  return acc;\n}, {});\n\nconst failedChecklists = checklists.filter((c) => {\n  const key = checklistKey(c.InspectionId, c.ChecklistId);\n  const checklistSystemResult = getSystemResult(assessmentMap, c.AssessmentType, c.ChecklistResult);\n  const hasFailedItems = (failedItemsByChecklist[key] || []).length > 0;\n  return checklistSystemResult === 'FAIL' || hasFailedItems;\n});\n\nconst checklistToHtml = (c) => {\n  const key = checklistKey(c.InspectionId, c.ChecklistId);\n  const failedItems = failedItemsByChecklist[key] || [];\n\n  const itemsHtml = failedItems.length\n    ? `<ul>${failedItems\n        .map(\n          (i) =>\n            `<li>${escapeHtml(i.ChecklistItemName)} - <b>${escapeHtml(i.ChecklistItemResult)}</b></li>`\n        )\n        .join('')}</ul>`\n    : '';\n\n  return `<li>${escapeHtml(c.ChecklistName)} - <b>${escapeHtml(c.ChecklistResult)}</b>${itemsHtml}</li>`;\n};\n\nconst failedChecklistsHtml = `<ul>${failedChecklists.map(checklistToHtml).join('')}</ul>`;\n\nreturn failedChecklistsHtml;\n"
          },
          "outcomes": {
            "success": "1769107771760"
          },
          "code": "SUMMARIZE_CHECKLISTS",
          "id": "1774542550308",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
      ],
