        },
        {
          "metadata": {
            "name": "at least one comment"
          },
          "outcomes": {
            "true": "1765592829987",
            "false": "1767913565949"
          },
          "code": "AT_LEAST_ONE_COMMENT",
          "convergenceTargetId": "1769107771760",
          "id": "1765592757216",
          "inputs": [
            {
              "id": "1765592757219_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.PRIOR_INSPECTION_CL_COMMENTS.$output.items.length>0}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "summarize comments"
          },
          "outcomes": {
            "success": "1769107771760"
          },
          "code": "SUMMARIZE_COMMENTS",
          "id": "1765592829987",
          "inputs": [
            {
              "id": "1765592829989_1",
              "name": "prompt",
              "type": "string",
              "value": "Summarize the following checklist comments:\n```\n{{$context.$nodes.CLEANUP_COMMENTS_REST_RESULT.$output.result}}\n```\nOutput using HTML formatting suitable to place inside a <div>. Do not include <head> or <body> tags.\nOutput the results in well-formatted HTML list <ul><li> bullet-point form, for example: <b>Pipe size:</b> the pipe size is incorrect\nPreface the results with a <b>Checklist Comments</b> and <br/> so that \"Checklist Comments\" makes it clear the following is a summarization of comments.\nDo not include include extraneous words like \"this is a summary\".\nDo not include carriage returns or newlines since those are extraneous in HTML formatting."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "no comments llm"
          },
          "outcomes": {
            "success": "1769107771760"
          },
          "code": "NO_COMMENTS_LLM",
          "id": "1767913565949",
          "inputs": [
            {
              "id": "1767913565950_1",
              "name": "prompt",
              "type": "string",
              "value": "Say 'There are no comments'"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "generate overall summary"
          },
          "outcomes": {
            "success": "1765240758722"
          },
          "code": "GENERATE_OVERALL_SUMMARY",
          "convergenceTargetId": "1769047843954",
          "id": "1769107771760",
          "inputs": [
            {
              "id": "1769107771761_1",
              "name": "prompt",
              "type": "string",
              "value": "You are providing a building inspector with a concise and accurate summary of inspection history for a particular Permit or Building License.\n\nHere is the list of inspection and prior failed inspections data:\n```\n{{$context.$variables.Inspections}}\n```\nHere is a JSON tree structure data of Inspection Checklist results, it contains a list of Checklists, and under each Checklist there may be one or more Checklist items child nodes:\n```\n{{$context.$nodes.CLEANUP_CHECKLISTS.$output.result}}\n```\nHere is the prior inspection comments:\n```\n{{$context.$nodes.GET_ALL_INSP_COMMENTS.$output}}\n\nGiven the above data, provide a short paragraph summary of the above containing a brief high-level summary in natural language. Highlight any recurring issues. Display key points in bullet points as necessary for easy reading. Output using HTML formatting suitable to place inside a <div>. Never output the SystemResult, only output the Result. When the Result is \"None\" that means the checklist has not yet been Resulted by the inspector. Only include failed checklist and failed checklist items. Ignore checklist and checklist items that are Pass.\n\n- Do not list out any Result that is \"None\".\n- Do not provide any advice - only summarize the provided data, do not add any other information or advice. Do not refer to 'JSON', 'node', 'tree', 'data' or any other technical terms contained in this prompt.\n- Do not output the SystemResult, only output the Result.\n- Do not mention the word \"SystemResult\".\n- Do not include any internal identifiers.\n- Do not include include extraneous words like \"this is a summary\".\n- Do not include <head> or <body> tags. \n- Do not include carriage returns or newlines since those are extraneous in HTML formatting.\n- Do not add any advice or extraneous information that is not part of the JSON data provided above.\n- If any dates or times are included, make sure to use these formatting Preferences:  {{$context.$variables.Preferences}}"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "final output",
            "returnType": "string",
            "sourceCode": "const checklists = $context.$nodes.SUMMARIZE_CHECKLISTS?.$output?.result ?? $context.$nodes.NO_CHECKLISTS_LLM.$output;\nconst comments = $context.$nodes.SUMMARIZE_COMMENTS?.$output ?? $context.$nodes.NO_COMMENTS_LLM.$output;\nconst historySection1 = $context.$nodes.HISTORY_SECTION_1.$output;\nconst summary = $context.$nodes.GENERATE_OVERALL_SUMMARY.$output;\nconst history = historySection1 + checklists + comments;\nconst outputJson = { \"summary\": summary, \"history\": history };\nconst outputString = JSON.stringify(outputJson);\nreturn outputString;"
          },
          "outcomes": {
            "success": "1769374950407"
          },
          "code": "FINAL_OUTPUT",
          "convergenceTargetId": "1769047843954",
          "id": "1765240758722",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_PSC_PMT_INSPECTIONS",
            "functionName": "query_publicSectorInspections",
            "name": "find prior inspections"
          },
          "outcomes": {
            "success": "1769716087557"
          },
          "code": "FIND_PRIOR_INSPECTIONS",
          "id": "1769119027419",
          "inputs": [
            {
              "id": "1769119361503_1",
              "name": "Query",
              "type": "string",
              "value": "{{$context.$nodes.QUERY_CRITERIA.$output.result}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "query criteria",
            "returnType": "string",
            "sourceCode": "const inspectionId = $context.$variables.InspectionId;\nconst lnpRecordKey = $context.$variables.LnpRecordKey;\n\nconst query = `LnpRecordKey=${lnpRecordKey} AND (InspectionId='${inspectionId}' OR ReinspectionIdOf IS NOT NULL OR ReinspectionIdBy IS NOT NULL)`;\nreturn query;"
          },
          "outcomes": {
            "success": "1769119027419"
          },
          "code": "QUERY_CRITERIA",
          "id": "1769119185985",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "cleanup prior inspections",
            "returnType": "object",
            "sourceCode": "const priorInspections = $context.$nodes.FIND_PRIOR_INSPECTIONS.$output.items;\nconst currInspection = priorInspections.find(x => x.InspectionKey+'' === $context.$variables.InspectionKey+'')\nconst cleanupPriorInspections = priorInspections.map(x => {delete x['@context']; return x;});\n\n// there may be other unrelated reinspections for this application, remove those from consideration\nconst extractChain = (objects, startId) => {\n  const idMap = Object.fromEntries(objects.map(obj => [obj.InspectionId, obj]));\n  const result = [];\n  let current = idMap[startId];\n  while (current) {\n    result.push(current);\n    current = idMap[current.ReinspectionIdOf];\n  }\n  return result;\n};\n\nconst prunedCleanedInspections = extractChain(cleanupPriorInspections, currInspection.InspectionId);\n\nreturn {\"InspectionId\": currInspection.InspectionId, \"Inspections\": prunedCleanedInspections};"
          },
          "outcomes": {
            "success": "1769121548469"
          },
          "code": "CLEANUP_PRIOR_INSPECTIONS",
          "id": "1769120946783",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
