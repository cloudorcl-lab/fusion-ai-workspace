        {
          "metadata": {
            "description": "Create product hierarchy SQL expressions from configured hierarchy and group levels.",
            "name": "RESOLVE_PRODUCT_HIERARCHY_PARAMS",
            "language": "JAVASCRIPT",
            "returnType": "object",
            "sourceCode": "var c=$context.$triggers.REST.$input.commonConfiguration||{};\n\nfunction resolveLevel(value, defaultLevel, errorMessage){\n  var level=value==null||String(value).trim()===''?defaultLevel:Number(String(value).trim());\n  if(!Number.isInteger(level)||level<1||level>8)throw new Error(errorMessage);\n  return level;\n}\n\nfunction levelNameExpr(level){\n  return \"DECODE(level\"+level+\"Name, NULL, pr.itemName, level\"+level+\"Name)\";\n}\n\nfunction levelIdExpr(level){\n  return \"DECODE(level\"+level+\"Id, NULL, pr.itemId, level\"+level+\"Id)\";\n}\n\nvar raw=c.productHierarchyPathLevels;\nif(raw==null||String(raw).trim()==='')raw='8,7,6';\n\nvar parts=String(raw).split(','),levels=[],seen={};\nfor(var i=0;i<parts.length;i++){\n  var part=String(parts[i]).trim(),level=Number(part);\n  if(part===''||!Number.isInteger(level)||level<1||level>8)throw new Error('Invalid productHierarchyPathLevels');\n  if(!seen[level]){seen[level]=true;levels.push(level);}\n}\n\nif(levels.length>4)throw new Error('Too many productHierarchyPathLevels');\n\nlevels.sort().reverse();\n\nvar names=[],ids=[];\nfor(var j=0;j<levels.length;j++){\n  names.push('level'+levels[j]+'Name');\n  ids.push('level'+levels[j]+'Id');\n}\n\nvar namePath=\"'['||\"+names.join(\"||']->['||\")+\"||']'\";\nvar idPath=\"'['||\"+ids.join(\"||']->['||\")+\"||']'\";\n\nvar categoryLevel=resolveLevel(c.productCategoryLevel,7,'Invalid productCategoryLevel');\n\nvar high=levels[0],low=levels[levels.length-1];\n\nreturn {\n  productHierarchyPathLevels:levels.join(','),\n  productCategoryLevel:categoryLevel,\n\n  productHierarchyName:\"DECODE(level\"+high+\"Name, NULL, ('['||pr.itemName||']'), (\"+namePath+\"))\",\n  productHierarchyId:\"DECODE(level\"+high+\"Id, NULL, ('['||pr.itemId||']'), (\"+idPath+\"))\",\n\n  productHierarchyGroupName:levelNameExpr(low),\n  productHierarchyGroupId:levelIdExpr(low),\n\n  productCategoryName:levelNameExpr(categoryLevel),\n  productCategoryId:levelIdExpr(categoryLevel)\n};\n"
          },
          "outcomes": {
            "success": "1777856367258"
          },
          "diagram": {
            "x": 8256,
