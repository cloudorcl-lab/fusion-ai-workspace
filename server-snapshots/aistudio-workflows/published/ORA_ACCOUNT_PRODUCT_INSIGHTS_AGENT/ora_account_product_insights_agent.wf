            "type": "object",
            "typeSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"filterProductByTerritory\": {\n      \"type\": \"boolean\",\n      \"description\": \"Optional caller-provided territory filtering decision. When true, product records are filtered by the territories assigned to the logged-in user. When false, territory filtering is skipped. When omitted or null, the workflow may determine whether territory filtering should be applied based on the logged-in user's assigned territories.\"\n    }\n  },\n  \"additionalProperties\": false\n}",
            "value": ""
          }
