            "scope": "JOB",
            "type": "object",
            "typeSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"corporateCurrency\": {\n      \"type\": \"string\",\n      \"description\": \"The corporate currency code used for monetary normalization and aggregation.\"\n    },\n    \"corporateConversionType\": {\n      \"type\": \"string\",\n      \"description\": \"The currency conversion type used when converting monetary amounts into the corporate currency.\"\n    },\n    \"productHierarchyPathLevels\": {\n      \"type\": \"string\",\n      \"description\": \"A comma-separated list of product hierarchy levels, from most specific to broader context, used to build the hierarchy path for summaries and interpretation, for example \\\"8,7,6\\\". For hierarchy aggregation, the lowest configured level is also used as the grouping label. Defaults to \\\"8,7,6\\\".\"\n    },\n    \"productCategoryLevel\": {\n      \"type\": \"string\",\n      \"description\": \"The product hierarchy level, from 1 to 8, used as the product category label in product and asset detail results. This is typically a broader parent category for the product, but it does not need to be the direct parent. Defaults to 7.\"\n    },\n    \"persona\": {\n      \"type\": \"string\",\n      \"description\": \"The target audience for the summary, used to tailor the wording, emphasis, and business focus of the output for roles such as sales reps or executives. Default is sales reps.\"\n    },\n    \"personaInstructions\": {\n      \"type\": \"string\",\n      \"description\": \"Optional free-text guidance used to further tailor the summary for the target audience. This can be used to refine the emphasis, tone, terminology, or business priorities beyond the selected persona, such as highlighting renewals, whitespace opportunities, risk areas, or strategic product themes.\"\n    }\n  },\n  \"additionalProperties\": false\n}",
            "value": ""
          },
