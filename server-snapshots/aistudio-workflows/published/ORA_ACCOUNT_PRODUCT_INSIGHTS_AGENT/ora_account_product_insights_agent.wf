        {
          "metadata": {
            "description": "Merge PartyId values from the account search response into a comma-separated accountId list.",
            "name": "MERGE_ACCOUNTIDS",
            "language": "JAVASCRIPT",
            "returnType": "string",
            "sourceCode": "let response = $context.$nodes.CALL_ES_API.$output;\n\nlet partyIds = response\n  .map(function (item) {\n    return item.PartyId;\n  })\n  .filter(function (partyId) {\n    return partyId != null && String(partyId).trim() !== '';\n  });\n\nreturn partyIds.join(',');"
          },
