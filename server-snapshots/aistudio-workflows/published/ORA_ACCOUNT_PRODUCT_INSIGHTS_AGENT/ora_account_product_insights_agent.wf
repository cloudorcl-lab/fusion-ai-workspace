              "value": "{{$context.$nodes.SHOULD_APPLY_TERRITORY_FILTER.$output == null || String($context.$nodes.SHOULD_APPLY_TERRITORY_FILTER.$output).trim() == '' || JSON.stringify($context.$nodes.SHOULD_APPLY_TERRITORY_FILTER.$output) == '{}' ? false : true}}"
            }
