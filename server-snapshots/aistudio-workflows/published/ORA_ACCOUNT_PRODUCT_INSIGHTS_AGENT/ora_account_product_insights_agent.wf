                  "inputs": []
                },
                {
                  "metadata": {
                    "description": "Group subscription and installed-base records by accountId and remove duplicate account fields.",
                    "name": "GROUP_ACCOUNT",
                    "sourceCode": "var subscriptionRecords = $context.$input.subscriptions;\nvar installedBaseRecords = $context.$input.installedBase;\nvar summaryType = $context.$input.summaryType;\n\nfunction parseRecords(value) {\n  if (value == null) {\n    return [];\n  }\n\n  if (typeof value === 'string') {\n    var trimmed = value.trim();\n    if (trimmed === '') {\n      return [];\n    }\n    return parseRecords(JSON.parse(trimmed));\n  }\n\n  if (Array.isArray(value)) {\n    return value;\n  }\n\n  if (Array.isArray(value.items)) {\n    return value.items;\n  }\n\n  if (value.result != null) {\n    return parseRecords(value.result);\n  }\n\n  if (value.value != null) {\n    return parseRecords(value.value);\n  }\n\n  return [];\n}\n\nfunction isAccountIdKey(key) {\n  return String(key).replace(/[_\\s-]/g, '').toLowerCase() === 'accountid';\n}\n\nfunction getAccountId(record) {\n  var keys = Object.keys(record);\n\n  for (var i = 0; i < keys.length; i++) {\n    var key = keys[i];\n\n    if (isAccountIdKey(key)) {\n      return record[key];\n    }\n  }\n\n  return null;\n}\n\nfunction removeAccountId(record) {\n  var output = {};\n  var keys = Object.keys(record);\n\n  for (var i = 0; i < keys.length; i++) {\n    var key = keys[i];\n\n    if (isAccountIdKey(key)) {\n      continue;\n    }\n\n    output[key] = record[key];\n  }\n\n  return output;\n}\n\nfunction getAccount(accountsById, results, accountId) {\n  var key = String(accountId);\n\n  if (accountsById[key] == null) {\n    accountsById[key] = {\n      accountId: accountId\n    };\n    results.push(accountsById[key]);\n  }\n\n  return accountsById[key];\n}\n\nfunction seedAccountsFromAccountIds(accountsById, results, collections) {\n  var parts = String($context.$variables.pAccountIds).split(',');\n\n  for (var i = 0; i < parts.length; i++) {\n    var accountId = String(parts[i]).trim();\n\n    if (accountId !== '') {\n      var account = getAccount(accountsById, results, accountId);\n\n      for (var j = 0; j < collections.length; j++) {\n        account[collections[j].name] = [];\n      }\n    }\n  }\n}\n\nfunction getCollections() {\n  if (summaryType === 'subscriptionDetail') {\n    return [\n      {\n        name: 'subscriptions',\n        records: subscriptionRecords\n      }\n    ];\n  }\n\n  if (summaryType === 'installedBaseDetail') {\n    return [\n      {\n        name: 'installedBase',\n        records: installedBaseRecords\n      }\n    ];\n  }\n\n  return [\n    {\n      name: 'subscriptions',\n      records: subscriptionRecords\n    },\n    {\n      name: 'installedBase',\n      records: installedBaseRecords\n    }\n  ];\n}\n\nvar accountsById = {};\nvar results = [];\nvar collections = getCollections();\n\nseedAccountsFromAccountIds(accountsById, results, collections);\n\nfor (var i = 0; i < collections.length; i++) {\n  var collection = collections[i];\n\n  if (collection == null || collection.name == null) {\n    continue;\n  }\n\n  var collectionName = String(collection.name);\n  var records = parseRecords(collection.records);\n\n  for (var j = 0; j < records.length; j++) {\n    var record = records[j];\n\n    if (record == null || typeof record !== 'object' || Array.isArray(record)) {\n      continue;\n    }\n\n    var accountId = getAccountId(record);\n\n    if (accountId == null) {\n      continue;\n    }\n\n    var account = getAccount(accountsById, results, accountId);\n\n    if (account[collectionName] == null) {\n      account[collectionName] = [];\n    }\n\n    account[collectionName].push(removeAccountId(record));\n  }\n}\n\nreturn results;\n",
                    "returnType": "object"
                  },
                  "diagram": {
                    "x": 9344,
                    "y": 5241
                  },
                  "outcomes": {
                    "success": "1778169516259"
                  },
                  "id": "1778134223968",
                  "code": "GROUP_ACCOUNT",
                  "type": "CODE",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "metadata": {
                    "description": "Generate concise persona-aware product insight summaries for each grouped account.",
                    "name": "ADD_SUMMARY",
                    "modelConfiguration": {
                      "code": "ORA_MODEL_CONFIG_PREMIUM_OPEN_AI_GPT_4_1_MINI",
                      "modelName": "GPT-5 Mini (Premium)",
                      "provider": "CERT_PREMIUM",
                      "model": "OCI_GPT_5_MINI",
                      "modelProperties": {
                        "k": 0,
                        "max_completion_tokens": 32000,
                        "reasoning_effort": "low"
                      }
                    }
                  },
                  "diagram": {
                    "x": 9344,
                    "y": 5463
                  },
                  "outcomes": {
                    "success": "1778176928322"
                  },
                  "id": "1778169516259",
                  "code": "ADD_SUMMARY",
                  "type": "LLM",
                  "inputs": [
                    {
                      "id": "1778169516259_systemPrompt",
                      "name": "systemPrompt",
                      "type": "string",
                      "value": ""
                    },
                    {
                      "id": "1778169516259_prompt",
                      "name": "prompt",
                      "type": "string",
                      "value": "# Task\n\nGenerate concise sales-oriented summaries for each account in {{$context.$nodes.GROUP_ACCOUNT.$output.result}}.\n\nPersona: {{$context.$triggers.REST.$input.commonConfiguration == null || $context.$triggers.REST.$input.commonConfiguration.persona == null || String($context.$triggers.REST.$input.commonConfiguration.persona).trim() == '' ? 'Sales Rep' : $context.$triggers.REST.$input.commonConfiguration.persona}}\n\npersonaInstructions: {{$context.$triggers.REST.$input.commonConfiguration == null || $context.$triggers.REST.$input.commonConfiguration.personaInstructions == null ? '' : $context.$triggers.REST.$input.commonConfiguration.personaInstructions}}\n\nqueryIntent:\n{{$context.$triggers.REST.$input.action == null || $context.$triggers.REST.$input.action.config == null || $context.$triggers.REST.$input.action.config.queryIntent == null ? '' : $context.$triggers.REST.$input.action.config.queryIntent}}\n\nSummary type: {{$context.$input.summaryType}}\n\n# Output Rules\n\n- Return valid JSON only.\n- Return a JSON array.\n- Always return one object per input account, even when no subscriptions or installedBase records are present for that account.\n- Each output object must contain exactly these fields:\n  - accountId\n  - summary\n- Preserve each input `accountId` exactly.\n- Do not return subscriptions, installedBase, or any other detail records.\n- Do not invent fields, values, products, dates, quantities, statuses, or conclusions.\n- Do not calculate record-level numeric fields.\n- If no records are present for an account, preserve the `accountId` and return a concise neutral `summary`.\n\n# Persona Instruction Rules\n\n- Apply `personaInstructions` when present.\n- `personaInstructions` override the default summary rules and summary type focus.\n- If `personaInstructions` says not to include monetary information, do not print currency amounts, ARR, MRR, total value, spend, contract value, monetary exposure, or any other money figures in the summary.\n- If monetary information is restricted, focus instead on product mix, leading products or hierarchy groups, renewal timing, tenure, installed footprint, product coverage, expansion or refresh signals, retention risk, and missing data supported by the records.\n- Do not mention that monetary information was omitted.\n\n# Query Intent Rules\n\n- Apply `queryIntent` when present.\n- Use `queryIntent` to decide which supported insights to emphasize in the summary.\n- When `queryIntent` is present, make the summary explicitly reflect the requested criteria.\n- If returned records match the query intent, summarize them in the context of that intent. For example, if `queryIntent` asks for subscriptions expiring in 60 days, describe the matching renewal exposure and timing.\n- If no records match the query intent for an account, say that no qualifying records matched the requested criteria, using wording specific to the intent when possible.\n- If `queryIntent` conflicts with `personaInstructions`, follow `personaInstructions`.\n- Do not add facts, filters, products, values, dates, risks, or recommendations that are not supported by the account records.\n- Do not imply the account has no subscriptions, assets, or product footprint overall when the result is empty because of `queryIntent`.\n- If `queryIntent` is missing, summarize the most useful seller-oriented insights from the records.\n\n# Summary Rules\n\n- Keep each summary brief, sales-oriented, polished, and useful to the persona.\n- Summarize only collections that contain records.\n- Do not mention a collection that is missing, null, empty, or has no returned records.\n- Do not write absence statements such as `No installed base records present`, `No subscriptions found`, or `No records were returned for installed base`.\n- If neither subscriptions nor installedBase contains records for an account, use consistent neutral wording across summary types:\n  - With `queryIntent`: `No qualifying product footprint matched the requested criteria for this account.`\n  - Without `queryIntent`: `No qualifying product footprint was returned for this account under the requested scope.`\n- Do not change the empty-summary wording just because `summaryType` is `subscriptionDetail`, `installedBaseDetail`, `byProductAggregate`, or `byProductHierarchyAggregate`.\n- Use collection-specific empty wording only when the user's `queryIntent` explicitly names that collection, such as `No subscriptions matched the requested expiration window for this account.`\n- For query-intent requests, treat an empty collection as no matching records under the requested criteria; do not imply the account has no subscriptions, assets, or product footprint overall.\n- In empty or no-match summaries, do not mention internal query shapes or implementation labels such as `product hierarchy`, `hierarchy-level`, `byProductHierarchyAggregate`, `aggregate`, `collections`, or `records` unless the user explicitly used those terms.\n- In empty or no-match summaries, do not list insight types that cannot be reported, such as concentration, whitespace, cross-sell opportunities, or expansion signals.\n- Use professional lead-ins, but do not force every sentence to start with `For ...`.\n- Good lead-in examples:\n  - `Subscription portfolio: ...`\n  - `The subscription footprint is led by ...`\n  - `Subscription exposure is concentrated in ...`\n  - `Installed footprint: ...`\n  - `The installed base is concentrated in ...`\n  - `Installed assets are led by ...`\n- When both subscriptions and installedBase are present, use one concise sentence or two short sentences, one focused on each collection.\n- Focus on seller-actionable insights supported by the records: spend concentration, leading products or hierarchy groups, ARR/MRR exposure, renewal timing, installed footprint, expansion/refresh signals, cross-sell potential, retention risk, and missing data that limits confidence.\n- Do not recommend an action unless the records directly support it.\n- Unless restricted by `personaInstructions`, use compact currency wording such as `$258.3K`.\n- Show date-time values as `YYYY-MM-DD`.\n\n# Summary Type Focus\n\n- byProductAggregate: products, product mix, value concentration, ARR/MRR exposure, whitespace, expansion potential; do not imply records are detail rows.\n- byProductHierarchyAggregate: hierarchy groups, hierarchy concentration, value concentration, ARR/MRR exposure, whitespace, expansion potential; do not imply records are detail rows.\n- subscriptionDetail: active/inactive status, renewal timing, tenure, ARR/MRR exposure, subscription value, retention or expansion signals; do not imply records are aggregated totals unless source fields show aggregation.\n- installedBaseDetail: highest-value assets, installed footprint, product group concentration, unit price, quantity, asset age, start/end dates, installed dates, purchase dates, refresh or expansion signals; do not imply records are aggregated totals unless source fields show aggregation.\n\n# Label Rules\n\n- In the summary only, use concise business-friendly product labels.\n- Prefer `itemName` when meaningful; otherwise use `productCategoryName`; otherwise use `productGroupName`; otherwise use a meaningful level from `productHierarchyName`.\n- For `productHierarchyName` paths with `->`, prefer the most business-meaningful non-empty level after removing brackets and whitespace.\n- Do not use hardcoded customer-specific cleanup rules.\n\n# Final Output\n\nReturn only the JSON array.\nDo not include markdown, comments, or explanatory text.\n"
                    }
                  ],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"object\",\n    \"required\": [\"accountId\", \"summary\"],\n    \"additionalProperties\": true,\n    \"properties\": {\n      \"accountId\": {\n        \"type\": \"string\"\n      },\n      \"summary\": {\n        \"type\": \"string\"\n      },\n      \"subscriptions\": {\n        \"type\": \"array\",\n        \"items\": {\n          \"type\": \"object\",\n          \"additionalProperties\": true\n        }\n      },\n      \"installedBase\": {\n        \"type\": \"array\",\n        \"items\": {\n          \"type\": \"object\",\n          \"additionalProperties\": true\n        }\n      }\n    }\n  }\n}"
                },
                {
                  "metadata": {
                    "description": "Attach generated summaries back onto the grouped account result objects.",
                    "name": "MERGE_SUMMARY",
                    "sourceCode": "var groupedResponse = $context.$nodes.GROUP_ACCOUNT.$output.result;\nvar summaryResponse = $context.$nodes.ADD_SUMMARY.$output;\n\nfunction parseJsonValue(value) {\n  if (value == null) return [];\n\n  if (typeof value === 'string') {\n    var trimmed = value.trim();\n    if (trimmed === '') return [];\n    return parseJsonValue(JSON.parse(trimmed));\n  }\n\n  if (value.result != null) return parseJsonValue(value.result);\n  if (value.value != null) return parseJsonValue(value.value);\n  if (value.returnValue != null) return parseJsonValue(value.returnValue);\n  if (value.response != null) return parseJsonValue(value.response);\n  if (value.text != null) return parseJsonValue(value.text);\n\n  return value;\n}\n\nfunction asArray(value) {\n  value = parseJsonValue(value);\n  if (Array.isArray(value)) return value;\n  if (value != null && Array.isArray(value.items)) return value.items;\n  if (value != null && value.accountId != null) return [value];\n  return [];\n}\n\nvar accounts = asArray(groupedResponse);\nvar summaries = asArray(summaryResponse);\nvar summariesByAccountId = {};\n\nfor (var i = 0; i < summaries.length; i++) {\n  var summaryRecord = summaries[i];\n  if (summaryRecord == null || summaryRecord.accountId == null) continue;\n\n  summariesByAccountId[String(summaryRecord.accountId)] =\n    summaryRecord.summary == null ? '' : String(summaryRecord.summary);\n}\n\nfor (var j = 0; j < accounts.length; j++) {\n  var account = accounts[j];\n  if (account == null || account.accountId == null) continue;\n\n  var accountId = String(account.accountId);\n  account.summary = summariesByAccountId[accountId] || '';\n}\n\nreturn accounts;\n",
                    "returnType": "object"
                  },
                  "diagram": {
