        {
          "metadata": {
            "description": "Build the product visibility filter from the caller territory configuration.",
            "name": "RESOLVE_PRODUCT_TERRITORY_FILTER",
            "language": "JAVASCRIPT",
            "returnType": "string",
            "sourceCode": "const filterConfiguration = $context.$triggers.REST.$input.filterConfiguration || {};\nlet filterProductByTerritory = filterConfiguration.filterProductByTerritory;\n\nif (filterProductByTerritory == null || String(filterProductByTerritory).trim() === '') {\n  filterProductByTerritory = $context.$variables.pFilterByTerritory;\n}\n\nconst shouldFilterByTerritory = filterProductByTerritory == null || filterProductByTerritory === true || filterProductByTerritory === \"true\";\n\nconst territoryProductFilter = \"territoryCoverages[territory[territoryResources[resource.partyId=@faContext.partyId]]] or parentProductGroups[activeFlag = true and startDate < @currentDateTime and endDate > @currentDateTime and productGroup[parentProductGroupHierarchies[baseUsageFlag = true and firstProductGroup[territoryCoverages[territory[territoryResources[resource.partyId=@faContext.partyId]]]]]]]\";\n\nlet productFilter = shouldFilterByTerritory ? territoryProductFilter : \"1=1\";\n\nreturn productFilter;\n"
          },
          "outcomes": {
            "success": "1777855662876"
          },
          "diagram": {
            "x": 6873,
            "y": 7277
          },
          "code": "RESOLVE_PRODUCT_TERRITORY_FILTER",
          "id": "1777855564827",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
