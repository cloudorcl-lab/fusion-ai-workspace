          "inputs": [
            {
              "id": "1778274222600_condition",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.action.config == null || $context.$triggers.REST.$input.action.config.queryIntent == null || String($context.$triggers.REST.$input.action.config.queryIntent).trim() == ''}}"
            }
          ]
