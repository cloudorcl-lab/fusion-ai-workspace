        {
          "metadata": {
            "description": "Normalize the merge block output by unwrapping result, returnValue, or value containers.",
            "name": "PARSE_RESPONSE",
            "language": "JAVASCRIPT",
            "sourceCode": "var value =\n  $context.$nodes.MERGE_BY_PRODUCTHIERARCHY_RESPONSE.$output ||\n  $context.$nodes.MERGE_BY_PRODUCT_RESPONSE.$output ||\n  $context.$nodes.MERGE_GET_SUBSCRIPTION_RESPONSE.$output ||\n  $context.$nodes.MERGE_GET_IBASSET_RESPONSE.$output;\nvar done = false;\nwhile (!done) {\n  if (value == null) {\n    done = true;\n  } else if (typeof value === 'string') {\n    var trimmed = value.trim();\n    value = trimmed === '' ? [] : JSON.parse(trimmed);\n  } else if (value.result != null) {\n    value = value.result;\n  } else if (value.returnValue != null) {\n    value = value.returnValue;\n  } else if (value.value != null) {\n    value = value.value;\n  } else {\n    done = true;\n  }\n}\nreturn value;",
            "returnType": "object"
          },
          "diagram": {
