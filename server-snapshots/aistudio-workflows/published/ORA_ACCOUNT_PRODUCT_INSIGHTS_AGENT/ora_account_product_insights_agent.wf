        {
          "metadata": {
            "description": "Map the requested action to the query profile used for filter generation.",
            "name": "MAP_ACTION_TO_QUERY_PROFILE",
            "language": "JAVASCRIPT",
            "sourceCode": "var isQueryAction = $context.$triggers.REST.$input.action != null && $context.$triggers.REST.$input.action.name !== 'GET_RUNTIME_SETTINGS';\n\nif (!isQueryAction) return null;\n\nvar actionName = $context.$triggers.REST.$input.action.name\n\nvar queryProfileByAction = {\n  GET_OWNED_PRODUCTS_BY_PRODUCT_HIERARCHY: 'aggregateByProductHierarchy',\n  GET_OWNED_PRODUCTS_BY_PRODUCT: 'aggregateByProduct',\n  GET_SUBSCRIPTIONS: 'subscriptionDetail',\n  GET_IBASSETS: 'installedBaseDetail'\n};\n\nvar queryProfile = queryProfileByAction[actionName];\n\nif (queryProfile == null) {\n  throw new Error('Unsupported actionName: ' + actionName);\n}\n\nreturn queryProfile",
            "returnType": "string"
          },
          "diagram": {
