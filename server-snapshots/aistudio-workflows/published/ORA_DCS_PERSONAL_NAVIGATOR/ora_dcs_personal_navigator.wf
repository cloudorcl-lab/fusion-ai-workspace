{
  "workflowId": "300000331058027",
  "workflowCode": "ORA_DCS_PERSONAL_NAVIGATOR",
  "name": "DCS Personal Navigator",
  "description": "Generate a personalized, pertinent set of navigation items to guide the user to relevant information.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
