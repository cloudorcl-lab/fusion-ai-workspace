          "inputs": [
            {
              "id": "1771929151813_1",
              "name": "prompt",
              "type": "string",
              "value": "## topic name\n {{$context.$triggers.REST.$input.questionnaireName}}\n\n## topic description\n {{$context.$triggers.REST.$input.questionnaireName}}\n\n## instructions\nWrite 10 survey questions about the topic for a survey described by the topic description above.\n\nGenerate at least one question of the following question types: single_choice, multiple_choice or free_text.\n\nFormat the response as an RFC8259 compliant JSON object in the following format:\n[\n    {\n        \"question\": \"1. &lt;insert question>\",\n        \"answer_type\": \"&lt;insert answer type: single_choice, multiple_choice, or free_text>\",\n        \"answers\": \"&lt;insert a list of answer choices for single choice and multiple choice questions, ignore this key for free text question>\"\n    },\n    {\n        \"question\": \"2. &lt;insert question>\",\n        \"answer_type\": \"&lt;insert answer type: single_choice, multiple_choice, or free_text>\",\n        \"answers\": \"&lt;insert a list of answer choices for single choice and multiple choice questions, ignore this key for free text question>\"\n    },\n    \"...\"\n]"
            }
          ],
          "type": "LLM"
        }
      ],
