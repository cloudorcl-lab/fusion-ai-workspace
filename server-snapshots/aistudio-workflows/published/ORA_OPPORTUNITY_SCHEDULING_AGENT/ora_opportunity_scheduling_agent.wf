        {
          "metadata": {
            "name": "extractOptyNumbers",
            "returnType": "array",
            "sourceCode": "const optyUpdated = ($context.$nodes.OPPORTUNITIES_UPDATED_IN_THE_LAST_1_DAY.$output || []).map(items => ({\n  id: items.OptyId,\n  puid: items.OptyNumber\n}));\n\nconst optiesForAccount = ($context.$nodes.OPPORTUNITIES_FOR_THE_ACCOUNT.$output || []).map(items => ({\n  id: items.OptyId,\n  puid: items.OptyNumber\n}));\n\nconst optiesForActivities = ($context.$nodes.ACTIVITIES_CREATED_LAST_1_DAY.$output || []).map(items => ({\n  id: items.OpportunityId?.OptyId,\n  puid: items.OpportunityId?.OptyNumber\n}));\n\nconst optiesForEngagements = ($context.$nodes.FETCH_OPPORTUNITIES_WITH_LATEST_ENGAGEMENTS.$output?.result || []).map(items => ({\n  id: items.OptyId ?? items.id,\n  puid: items.OptyNumber ?? items.puid\n}));\n\nconst itemsAll = optyUpdated.concat(optiesForAccount, optiesForActivities, optiesForEngagements);\n\n// Deduplicate by OptyNumber\n\nconst seenPuid = new Set();\nconst items = itemsAll.filter(x => {\n  const key = x?.puid;\n  if (!key) return false; // drop entries without OptyNumber\n  if (seenPuid.has(key)) return false;\n  seenPuid.add(key);\n  return true;\n});\n\n// Chunk the array into arrays of max length 50\nconst chunkSize = 50;\nconst chunked = [];\nfor (let i = 0; i < items.length; i += chunkSize) {\n  chunked.push(items.slice(i, i + chunkSize));\n}\nreturn chunked;"
          },
          "outcomes": {
            "success": "1769821411869"
          },
          "code": "EXTRACTOPTYNUMBERS",
          "id": "1764724024844",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
