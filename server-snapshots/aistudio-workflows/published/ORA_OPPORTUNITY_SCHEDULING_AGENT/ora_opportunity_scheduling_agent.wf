        {
          "metadata": {
            "name": "Extract the account",
            "returnType": "object",
            "sourceCode": "let accList = $context.$nodes.ACCOUNTS_UPDATED_IN_THE_LAST_1_DAY.$output;\nlet accNumber = accList.map(acc=>acc.PartyNumber);\nlet q = {\n    \"op\": \"$and\",\n    \"criteria\": [\n        {\n            \"op\": \"$in\",\n            \"attribute\": \"StatusCode\",\n            \"values\": [\n                \"OPEN\"\n            ]\n        },\n        {\n            \"op\": \"$in\",\n            \"attribute\": \"CustomerAccount.PartyNumber\",\n            \"values\": accNumber\n        },\n        {\n            \"op\": \"$wi\",\n            \"attribute\": \"EffectiveDate\",\n            \"value1\": \"now/q\",\n            \"value2\": \"now/q+1q\"\n        }\n    ]\n}\n\nreturn q;"
          },
          "outcomes": {
            "success": "1771391703295"
          },
