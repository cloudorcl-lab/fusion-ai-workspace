            "sourceCode": "const d = new Date(\"2026-02-12T13:51:54Z\");\nconst prev = new Date(d);\nprev.setUTCDate(d.getUTCDate() - 1);\nconst iso = prev.toISOString().replace('.000', '');\nreturn `lastSynchedTime > '${iso}'`;"
