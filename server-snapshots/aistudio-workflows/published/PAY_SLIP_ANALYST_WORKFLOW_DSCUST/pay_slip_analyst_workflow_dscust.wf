            {
              "id": "1769175818413_1",
              "name": "prompt",
              "type": "string",
              "value": "Select payslips matching user request. Return JSON only.\n\nREQUEST: {{$context.$system.$inputMessage}}\nPAYSLIPS: {{$context.$nodes.GETPAYSLIPS.$output.items}}\n\nRULES:\n- \"last N months\" → PaymentDate ≥ today minus N months\n- \"recent/latest\" → highest PaymentDate\n- \"last N payslips\" → N most recent by PaymentDate\n- ambiguous → return all"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"$id\": \"https://example.com/payslip-ids.schema.json\",\n  \"title\": \"Payslip ID Collection\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"paysliplds\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"properties\": {\n          \"DocumentsOfRecordId\": {\n            \"type\": \"integer\",\n            \"minimum\": 1\n          }\n        },\n        \"required\": [\"DocumentsOfRecordId\"]\n      }\n    }\n  },\n  \"required\": [\"paysliplds\"]\n}",
