    "modelConfiguration": null,
    "humanApprovalFlag": false,
    "waitFlag": false,
    "triggers": [
      {
        "type": "REST",
        "inputs": [
          {
            "id": "1772093939710",
            "name": "SummaryBatchInput",
            "scope": "JOB",
            "type": "object",
            "typeSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://example.com/schemas/summary-request-batch.json\",\n  \"title\": \"Summary Request Batch\",\n  \"type\": \"object\",\n  \"required\": [\"items\"],\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"items\": { \"$ref\": \"#/$defs/SummaryRequestItem\" }\n    }\n  },\n  \"$defs\": {\n    \"SummaryRequestItem\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\n        \"summaryRequestItemId\",\n        \"primaryObject\",\n        \"engagementType\",\n        \"engagementId\",\n        \"summarizationInputMode\",\n        \"participants\",\n        \"engagementPayload\"\n      ],\n      \"properties\": {\n        \"summaryRequestItemId\": { \"type\": \"string\", \"minLength\": 1 },\n\n        \"primaryObject\": { \"$ref\": \"#/$defs/CRMObject\" },\n\n        \"relatedObjects\": {\n          \"type\": \"array\",\n          \"items\": { \"$ref\": \"#/$defs/CRMObject\" },\n          \"default\": []\n        },\n\n        \"engagementType\": {\n          \"type\": \"string\",\n          \"enum\": [\"Conversation\", \"Interaction\"]\n        },\n\n        \"engagementId\": { \"type\": \"string\", \"minLength\": 1 },\n\n        \"summarizationInputMode\": {\n          \"type\": \"string\",\n          \"enum\": [\"FULL\", \"INCREMENTAL\"]\n        },\n\n        \"participants\": {\n          \"type\": \"array\",\n          \"items\": { \"$ref\": \"#/$defs/Participant\" },\n          \"default\": []\n        },\n\n        \"engagementPayload\": { \"$ref\": \"#/$defs/EngagementPayload\" },\n\n        \"previousSummaryContext\": { \"$ref\": \"#/$defs/PreviousSummaryContext\" }\n      },\n      \"allOf\": [\n        {\n          \"if\": {\n            \"properties\": { \"engagementType\": { \"const\": \"Conversation\" } },\n            \"required\": [\"engagementType\"]\n          },\n          \"then\": {\n            \"properties\": {\n              \"engagementPayload\": {\n                \"required\": [\"conversation\"],\n                \"properties\": {\n                  \"conversation\": { \"$ref\": \"#/$defs/ConversationPayload\" }\n                }\n              }\n            }\n          }\n        },\n        {\n          \"if\": {\n            \"properties\": { \"engagementType\": { \"const\": \"Interaction\" } },\n            \"required\": [\"engagementType\"]\n          },\n          \"then\": {\n            \"properties\": {\n              \"engagementPayload\": {\n                \"required\": [\"interaction\"],\n                \"properties\": {\n                  \"interaction\": { \"$ref\": \"#/$defs/InteractionPayload\" }\n                }\n              }\n            }\n          }\n        }\n      ]\n    },\n\n    \"CRMObject\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"objectType\", \"objectId\"],\n      \"properties\": {\n        \"objectType\": {\n          \"type\": \"string\",\n          \"enum\": [\"Opportunity\", \"Account\", \"Lead\", \"Contact\", \"ServiceRequest\"]\n        },\n        \"objectId\": { \"type\": \"string\", \"minLength\": 1 },\n        \"objectDisplayName\": { \"type\": \"string\" },\n        \"objectData\": {\n          \"type\": \"object\",\n          \"description\": \"Arbitrary key/value data for the object\",\n          \"additionalProperties\": true\n        }\n      }\n    },\n\n    \"Participant\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"participantName\": { \"type\": \"string\" },\n        \"participantRole\": { \"type\": \"string\" },\n        \"participantOrganizationType\": { \"type\": \"string\" }\n      }\n    },\n\n    \"EngagementPayload\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"conversation\": { \"$ref\": \"#/$defs/ConversationPayload\" },\n        \"interaction\": { \"$ref\": \"#/$defs/InteractionPayload\" }\n      }\n    },\n\n    \"ConversationPayload\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"conversationMessages\"],\n      \"properties\": {\n        \"subject\": { \"type\": \"string\" },\n        \"conversationMessages\": {\n          \"type\": \"array\",\n          \"minItems\": 1,\n          \"items\": { \"$ref\": \"#/$defs/ConversationMessage\" }\n        }\n      }\n    },\n\n    \"ConversationMessage\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"MessageId\", \"SentAt\", \"Direction\", \"From\", \"To\", \"BodyText\"],\n      \"properties\": {\n        \"MessageId\": { \"type\": \"string\", \"minLength\": 1 },\n        \"SentAt\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"Direction\": {\n          \"type\": \"string\",\n          \"enum\": [\"INBOUND\", \"OUTBOUND\", \"UNKNOWN\"]\n        },\n        \"From\": { \"$ref\": \"#/$defs/EmailParty\" },\n        \"To\": {\n          \"type\": \"array\",\n          \"items\": { \"$ref\": \"#/$defs/EmailParty\" },\n          \"default\": []\n        },\n        \"Cc\": {\n          \"type\": \"array\",\n          \"items\": { \"$ref\": \"#/$defs/EmailParty\" },\n          \"default\": []\n        },\n        \"BodyText\": { \"type\": \"string\" }\n      }\n    },\n\n    \"EmailParty\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"name\": { \"type\": \"string\" },\n        \"email\": { \"type\": \"string\" }\n      }\n    },\n\n    \"InteractionPayload\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"interactionType\"],\n      \"properties\": {\n        \"interactionType\": {\n          \"type\": \"string\",\n          \"enum\": [\"WebConference\", \"Call\"]\n        },\n        \"topic\": { \"type\": \"string\" },\n        \"notes\": { \"type\": \"string\" },\n\n        \"transcript\": {\n          \"type\": \"array\",\n          \"description\": \"Typically used for web conferences (optional for calls). Prefer transcript OR callNotes.\",\n          \"items\": { \"$ref\": \"#/$defs/TranscriptItem\" }\n        },\n\n        \"callNotes\": {\n          \"type\": \"string\",\n          \"description\": \"Typically used for calls (optional for web conferences). Prefer callNotes OR transcript.\"\n        }\n      },\n      \"allOf\": [\n        {\n          \"description\": \"Ensure at least one of transcript or callNotes is provided when interactionType is present.\",\n          \"anyOf\": [\n            { \"required\": [\"transcript\"] },\n            { \"required\": [\"callNotes\"] }\n          ]\n        },\n        {\n          \"description\": \"Prevent providing both transcript and callNotes at the same time (optional constraint).\",\n          \"not\": {\n            \"allOf\": [{ \"required\": [\"transcript\"] }, { \"required\": [\"callNotes\"] }]\n          }\n        }\n      ]\n    },\n\n    \"TranscriptItem\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"timestamp\", \"speaker\", \"text\"],\n      \"properties\": {\n        \"timestamp\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"speaker\": { \"type\": \"string\" },\n        \"text\": { \"type\": \"string\" }\n      }\n    },\n\n    \"PreviousSummaryContext\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"SummaryText\": { \"type\": \"string\" },\n        \"SummaryGeneratedAt\": {\n          \"type\": \"string\",\n          \"description\": \"ISO-8601 timestamp\",\n          \"format\": \"date-time\"\n        }\n      }\n    }\n  }\n}"
          }
        ]
      }
