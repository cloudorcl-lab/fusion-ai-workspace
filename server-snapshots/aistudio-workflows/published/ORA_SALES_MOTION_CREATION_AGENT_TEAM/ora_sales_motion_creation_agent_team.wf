          },
          "code": "DOCUMENT_EXTRACT",
          "id": "1768194544058",
          "inputs": [
            {
              "id": "1768194544059_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an agent to parse documents and answer questions based ONLY on the attached documents.\n\nYou will be given document metadata and extracted plain text.\nAnswer the questions strictly using the document content.\n\nCRITICAL OUTPUT RULES (MUST FOLLOW):\n- Output MUST be valid JSON only.\n- Do NOT include markdown, comments, or explanatory text.\n- Do NOT include unescaped double quotes (\") inside any string value.\n- If a double quote is required inside text, escape it as \\\".\n- Prefer paraphrasing over verbatim quotes, especially in evidence fields.\n- Evidence text MUST NOT contain raw quotation marks.\n\nCONFIDENCE RULES:\n- Confidence must be a number between 0 and 1.\n- Maximum 2 decimal places.\n- Allowed examples: 0, 0.5, 0.85, 0.9, 1\n- Do NOT use words (e.g., “high”, “low”, “0.Nine”).\n\nQUESTIONS TO ANSWER:\n1. Who is the seller / business? Which industry does the seller / business belong to?\n2. What types of customers or industries do you sell to? Who is your ideal customer?\n3. What types of products does your business sell?\n4. Where do they sell? Is it global or regional?\n5. What is the campaign objective, if sales motion is part of a campaign?\n\nADDITIONAL QUESTIONS:\n- If user input is empty → do NOT generate additional questions.\n- If user input contains questions → answer ONLY those questions.\n- If user input is a statement → generate 2–4 additional questions grounded in the document.\n\nAttached Document Content (Contains content from one or more files as key value pairs in an object):\n{{$context.$nodes.DOCUMENT_TOOL.$output}}\n\nUser Input:\n{{$context.$system.$inputMessage}}\n\nRESPONSE FORMAT (STRICT — NO DEVIATIONS):\n\n{\n  \"QnA\": [\n    {\n      \"question\": \"<question 1 here>\",\n      \"answer\": \"<answer for question 1 here>\",\n      \"references\": [\"<file name 1>\", \"<file name 2>\"],\n      \"confidence\": 0.85,\n      \"evidence\": [\n        \"<short supporting snippet or paraphrased evidence 1>\",\n        \"<short supporting snippet or paraphrased evidence 2>\"\n      ]   },\n    {\n      \"question\": \"<question 2 here>\",\n      \"answer\": \"<answer for question 2 here>\",\n      \"references\": [\"<file name 1>\"],\n      \"confidence\": 0.42,\n      \"evidence\": [\n        \"<short supporting snippet or paraphrased evidence>\"\n      ]\n    }\n  ],\n  \"additionalQnA\": [\n    {\n      \"question\": \"<generated question 1 here>\",\n      \"answer\": \"<answer for generated question 1 here>\",\n      \"references\": [\"<file name 1>\", \"<file name 2>\"],\n      \"confidence\": 0.85,\n      \"evidence\": [\n        \"<short supporting snippet or paraphrased evidence 1>\",\n        \"<short supporting snippet or paraphrased evidence 2>\"\n      ]\n    },\n    {\n      \"question\": \"<generated question 2 here>\",\n      \"answer\": \"<answer for generated question 2 here>\",\n      \"references\": [\"<file name 1>\"],\n      \"confidence\": 0.42,\n      \"evidence\": [\n        \"<short supporting snippet or paraphrased evidence>\"\n      ]\n    }\n  ],\n  \"files\": [\n    {\n      \"name\": \"<file name 1>\",\n      \"tags\": [\"<tag1>\", \"<tag2>\"],\n      \"summary\": \"3–4 line summary of the document.\"\n    },\n    {\n      \"name\": \"<file name 2>\",\n      \"tags\": [\"<tag1>\", \"<tag2>\"],\n      \"summary\": \"3–4 line summary of the document.\"\n    }\n  ],\n  \"overallConfidence\": 0.73\n}\n\nERROR HANDLING:\n- If a question cannot be answered from the document, state why in the answer field.\n- If no documents are attached, return:\n  - \"QnA\": []\n  - \"additionalQnA\": []\n  - \"files\": []\n  - \"overallConfidence\": 0\n\nFINAL CHECK (MANDATORY):\nBefore responding, validate that:\n- JSON is syntactically valid\n- All strings are properly escaped\n- No raw quotation marks appear inside string values\n- Confidence values MUST be written as JSON numbers only. If unsure, round to one decimal place. Never spell out numbers in confidence fields."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://example.com/qna-response.schema.json\",\n  \"title\": \"QnA Response Schema\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"QnA\", \"additionalQnA\", \"files\", \"overallConfidence\"],\n\n  \"properties\": {\n    \"QnA\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"items\": { \"$ref\": \"#/$defs/qnaItem\" }\n    },\n\n    \"additionalQnA\": {\n      \"type\": \"array\",\n      \"items\": { \"$ref\": \"#/$defs/qnaItem\" }\n    },\n\n    \"files\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"items\": { \"$ref\": \"#/$defs/fileItem\" }\n    },\n\n    \"overallConfidence\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1\n    }\n  },\n\n  \"$defs\": {\n    \"qnaItem\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"question\", \"answer\", \"references\", \"confidence\", \"evidence\"],\n\n      \"properties\": {\n        \"question\": {\n          \"type\": \"string\",\n          \"minLength\": 1\n        },\n        \"answer\": {\n          \"type\": \"string\",\n          \"minLength\": 1\n        },\n        \"references\": {\n          \"type\": \"array\",\n          \"minItems\": 1,\n          \"items\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          }\n        },\n        \"confidence\": {\n          \"type\": \"number\",\n          \"minimum\": 0,\n          \"maximum\": 1\n        },\n        \"evidence\": {\n          \"type\": \"array\",\n          \"minItems\": 1,\n          \"items\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          }\n        }\n      }\n    },\n\n    \"fileItem\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"name\", \"tags\", \"summary\"],\n\n      \"properties\": {\n        \"name\": {\n          \"type\": \"string\",\n          \"minLength\": 1\n        },\n        \"tags\": {\n          \"type\": \"array\",\n          \"minItems\": 1,\n          \"items\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          }\n        },\n        \"summary\": {\n          \"type\": \"string\",\n          \"minLength\": 1\n        }\n      }\n    }\n  }\n}",
          "type": "LLM",
          "diagram": {
            "x": 5000,
            "y": 5600
          }
        },
        {
          "metadata": {
            "name": "Prepare Response",
            "returnType": "object",
            "sourceCode": "// PREPARE CHAT HISTORY TO PERSIST\n\nconst chatHistory = $context.$variables.chatHistory === null || $context.$variables.chatHistory === \"\" ? [] :  $context.$variables.chatHistory;\n\nconst historyItem =  {\nuserPrompt: $context.$system.$inputMessage,\nagentResponse: $context.$nodes.SALES_MOTION_AGENT.$output.agentResponse,\nuserRequest: $context.$nodes.SALES_MOTION_AGENT.$output.userRequest,\nfollowups: $context.$nodes.SALES_MOTION_AGENT.$output.followups\n}\n\nchatHistory.push(historyItem);\n\n\n// PREPARE agentSalesMotionJSON to persist\n// Check and update if changed\nlet agentSalesMotionJSON = $context.$variables.agentSalesMotionJSON \nif($context.$nodes.SALES_MOTION_AGENT.$output.hasSalesMotionChange) {\n    agentSalesMotionJSON = $context.$nodes.SALES_MOTION_AGENT.$output.salesMotionJSON;\n}\n\n\n// PREPARE RESPONSE TO OUTPUT\n\nlet postback = $context.$nodes.SALES_MOTION_AGENT.$output;\ndelete postback.context;\n\nlet responseText = $context.$nodes.SALES_MOTION_AGENT.$output.agentResponse \nif($context.$nodes.SALES_MOTION_AGENT.$output.userRequest) {\n    responseText += \"\\n\\n\" + $context.$nodes.SALES_MOTION_AGENT.$output.userRequest;\n}\n\nconst date = new Date($context.$system.$currentDateTime);\nconst localeDate = date.toLocaleString(\"en-IN\");\n\nlet workflowResponse = {\n  \"postback\": postback\n}\n\nif($context.$nodes.SALES_MOTION_AGENT.$output.hasSalesMotionChange) {\n  workflowResponse.type = \"chip\";\n  workflowResponse.headerText = responseText;\n  workflowResponse.primaryText = $context.$nodes.SALES_MOTION_AGENT.$output.motionTag;\n  workflowResponse.secondaryText = localeDate;\n  workflowResponse.icon = \"oj-ux-ico-activity-list\";\n} else {\n  workflowResponse.type = \"text\";\n  workflowResponse.text = responseText;\n}\n\nreturn {workflowResponse, agentSalesMotionJSON, chatHistory};"
          },
          "outcomes": {
            "success": "1768195504702"
          },
          "code": "PREPARE_RESPONSE",
          "id": "1763547679264",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
