            "name": "Parse Input",
            "returnType": "object",
            "sourceCode": "const partyNumber = $context.$variables.accountNumber;\nconst partyNumberValue = partyNumber == null ? \"\" : String(partyNumber);\n\nconst searchFilterObj = {\n  op: \"$and\",\n  criteria: [\n    {\n      op: \"$eq\",\n      attribute: \"PartyNumber\",\n      value: partyNumberValue\n    }\n  ]\n};\n\nvar output = {\n  searchFilter: JSON.stringify(searchFilterObj)\n};\n\nreturn output;"
