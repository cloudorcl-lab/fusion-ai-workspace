        {
          "metadata": {
            "name": "Get Account Attributes",
            "returnType": "object",
            "sourceCode": "var input= $context.$nodes.GET_ACCOUNT.$output[0];\n\nif (!input) {\n  throw new Error(\"Business Object output not found. Check the node reference/path.\");\n}\n\nconst payload = {\n  \"PartyId\": input.PartyId ?? null,\n  \"PartyNumber\": input.PartyNumber ?? null,\n  \"CompanyName\": input.PartyName ?? null,\n  \"Address\": input.PrimaryAddress?.FormattedAddress ?? null,\n  \"City\": input.PrimaryAddress?.City ?? null,\n  \"State\": input.PrimaryAddress?.State ?? null,\n  \"Country\": input.PrimaryAddress?.CountryCode ?? null,\n  \"ParentCompany\": input.AccountHierarchySummary?.ParentAccount?.PartyUniqueName ?? null,\n  \"Website\": input.PrimaryURL?.URL ?? null,\n  \"Industry\": input.PrimaryIndustry?.ClassCode_localizedValue ?? null\n};\n\n\nreturn JSON.stringify(payload);"
          },
          "outcomes": {
            "success": "1778182104174"
