        {
          "metadata": {
            "name": "Open Immediately Request",
            "returnType": "object",
            "sourceCode": "const details = $context.$nodes.SUPPLIER_NEGOTIATION_DETAILS.$output;\nif (!details) {\n  throw new Error(\"Supplier negotiation details are required.\");\n}\nconst { OpenDate, CloseDate } = details;\nconst currentDate = new Date();\nconst toIsoUtc = (date) => {\n  if (!date || Number.isNaN(date.getTime())) {\n    return null;\n  }\n  return date.toISOString().replace(/\\.\\d{3}Z$/, \"Z\");\n};\nlet newCloseDate = null;\nlet newAwardDate = null;\nconst closeDateObj = CloseDate ? new Date(CloseDate) : null;\nconst openDateObj = OpenDate ? new Date(OpenDate) : null;\nif (closeDateObj && !Number.isNaN(closeDateObj.getTime()) && closeDateObj < currentDate) {\n  let diffDays = 1;\n  if (openDateObj && !Number.isNaN(openDateObj.getTime())) {\n    const diffMs = closeDateObj.getTime() - openDateObj.getTime();\n    const days = Math.round(diffMs / (24 * 60 * 60 * 1000));\n    if (days > 0) {\n      diffDays = days;\n    }\n  }\n  const adjustedClose = new Date(currentDate.getTime() + diffDays * 24 * 60 * 60 * 1000);\n  newCloseDate = toIsoUtc(adjustedClose);\n  const awardDate = new Date(adjustedClose.getTime() + 7 * 24 * 60 * 60 * 1000);\n  newAwardDate = toIsoUtc(awardDate);\n}\nconst result = {\n  OpenImmediatelyFlag: true,\n  OpenDate: null\n};\nif (newCloseDate) {\n  result.CloseDate = newCloseDate;\n  if (newAwardDate) {\n    result.AwardByDate = newAwardDate;\n  }\n}\nreturn result;"
          },
          "outcomes": {
            "success": "1779395526827"
          },
          "code": "OPEN_IMMEDIATELY_REQUEST",
