        {
          "metadata": {
            "name": "Merge Data For Actions",
            "returnType": "object",
            "sourceCode": "const sources = [\n   $context.$nodes.SIMPLIFY_ACTIVE_DATA.$output.result,\n   $context.$nodes.SIMPLIFY_APPROVED_NOT_PUBLISHED.$output.result,\n   $context.$nodes.SIMPLIFY_PAUSED_DATA.$output.result\n];\n\nconst result = sources.reduce((acc, sourceObj) => {\n    \n    const currentList = sourceObj.NegotiationsList || [];\n\n    currentList.forEach(item => {\n        if (item.AuctionHeaderId && !acc.seenIds.has(item.AuctionHeaderId)) {\n            acc.seenIds.add(item.AuctionHeaderId);\n            acc.mergedList.push(item);\n        }\n    });\n\n    return acc;\n\n}, { seenIds: new Set(), mergedList: [] });\n\nlet obj = {\n    NegotiationsList: result.mergedList,\n    NegotiationsCount: result.mergedList.length\n};\nreturn obj ;"
          },
