          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n      \"AuctionHeaderId\": { \"type\": \"number\" },\n      \"Negotiation\":     { \"type\": \"number\" },\n      \"NegotiationTitle\": { \"type\": \"string\" },\n      \"NegotiationType\": { \"type\": \"string\" },\n      \"OpenDate\": { \"type\": \"string\" },\n      \"CloseDate\": { \"type\": \"string\" },\n      \"ProcurementBUId\": { \"type\": \"number\" },\n      \"ProcurementBU\": { \"type\": \"string\" },\n      \"BuyerId\": { \"type\": \"number\" },\n      \"Buyer\": { \"type\": \"string\" }\n  },\n  \"required\": [\n      \"AuctionHeaderId\",\n      \"Negotiation\",\n      \"NegotiationTitle\",\n      \"NegotiationType\",\n      \"OpenDate\",\n      \"CloseDate\",\n      \"ProcurementBUId\",\n      \"ProcurementBU\",\n      \"BuyerId\",\n      \"Buyer\"\n  ]\n}",
          "type": "BO_FUNCTION",
          "diagram": {
            "x": 6675.5,
            "y": 6982
          }
        },
        {
          "metadata": {
            "name": "Extend Request",
            "returnType": "object",
            "sourceCode": "const details = $context.$nodes.SUPPLIER_NEGOTIATION_DETAILS.$output;\nif (!details || !details.CloseDate) {\n  throw new Error(\"CloseDate is required to extend negotiation.\");\n}\nconst baseDate = new Date(details.CloseDate);\nif (Number.isNaN(baseDate.getTime())) {\n  throw new Error(\"Unable to parse CloseDate: \" + details.CloseDate);\n}\nconst extendedDate = new Date(baseDate.getTime() + 24 * 60 * 60 * 1000);\nconst isoCloseDate = extendedDate.toISOString();\nreturn {\n  parameters: {\n    ActionIntent: \"EXTEND\",\n    CloseDate: isoCloseDate\n  }\n};"
          },
          "outcomes": {
            "success": "1779395526825"
          },
          "code": "EXTEND_REQUEST",
          "id": "1764911378672",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
