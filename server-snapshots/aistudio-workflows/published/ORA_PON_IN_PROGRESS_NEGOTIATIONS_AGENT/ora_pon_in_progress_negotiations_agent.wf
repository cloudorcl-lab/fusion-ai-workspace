        {
          "metadata": {
            "name": "Simplify Paused Data",
            "returnType": "object",
            "sourceCode": "const rawList =  $context.$nodes.GET_PAUSED_NEGOTIATIONS.$output.items &&  $context.$nodes.GET_PAUSED_NEGOTIATIONS.$output.items ?  $context.$nodes.GET_PAUSED_NEGOTIATIONS.$output.items : ( $context.$nodes.GET_PAUSED_NEGOTIATIONS.$output.items || []);\n\nconst result = rawList.reduce((acc, item) => {\n\n    const created = new Date(item.CloseDate);\n    const now = new Date(item.CurrentDateTime);\n    const diffInMs = created - now;\n    const diffInDays = Math.floor(diffInMs / (1000 * 60 * 60 * 24));\n    \n    if (!acc.seenIds.has(item.AuctionHeaderId)) { \n        acc.seenIds.add(item.AuctionHeaderId);\n\n   \n\n        acc.uniqueList.push({\n             AuctionHeaderId: item.AuctionHeaderId,\n             NegotiationStatus: item.NegotiationStatusCode,\n             DifferenceInDays: diffInDays,\n             ProcurementBU: item.ProcurementBU,\n             SupplierResponses: item.SupplierResponses,\n             TimeRemaining: item.TimeRemaining,\n             SuppliersCount: item.SuppliersCount,\n             RestrictToInvitedSuppliersFlag: item.RestrictToInvitedSuppliersFlag,\n             NegotiationTitle: item.NegotiationType + ' '+ item.Negotiation+ ' - '+ (item.NegotiationTitle || \" \"),\n             BuyerName: item.Buyer || \" \"\n        });\n    }\n\n    return acc;\n\n}, { seenIds: new Set(), uniqueList: [] }); \n\nlet obj= {\n    NegotiationsList: result.uniqueList,\n    NegotiationsCount: result.uniqueList.length\n\n  };\n\n \n  return obj;"
          },
