            "returnType": "object",
            "sourceCode": "const normalizeSortAlias = (value) => String(value ?? \"\").toLowerCase().replace(/[^a-z0-9]+/g, \"\");\nconst genericSortAliasSuffixes = new Set([\"account\", \"date\", \"status\", \"number\", \"amount\", \"type\"]);\nconst normalizeSortBy = (value) => {\n  const seen = new Set();\n  return (Array.isArray(value) ? value : []).reduce((result, item) => {\n    if (!item || typeof item !== \"object\" || Array.isArray(item)) return result;\n    const field = String(item.field ?? \"\").trim();\n    const key = normalizeSortAlias(field);\n    if (!field || seen.has(key)) return result;\n    seen.add(key);\n    result.push({ field, order: String(item.order ?? \"\").trim().toLowerCase() === \"desc\" ? \"desc\" : \"asc\" });\n    return result;\n  }, []);\n};\nconst mergeSortBy = (base, updates) => {\n  const result = normalizeSortBy(base);\n  const positions = new Map(result.map((item, index) => [normalizeSortAlias(item.field), index]));\n  for (const item of normalizeSortBy(updates)) {\n    const key = normalizeSortAlias(item.field);\n    if (positions.has(key)) result[positions.get(key)].order = item.order;\n    else { positions.set(key, result.length); result.push(item); }\n  }\n  return result;\n};\nconst splitSelectColumns = (value) => {\n  const columns = [];\n  let current = \"\";\n  let depth = 0;\n  let quote = \"\";\n  for (const character of String(value || \"\")) {\n    if (quote) { current += character; if (character === quote) quote = \"\"; }\n    else if (character === \"'\" || character === '\"') { quote = character; current += character; }\n    else if (character === \"(\") { depth += 1; current += character; }\n    else if (character === \")\") { depth = Math.max(0, depth - 1); current += character; }\n    else if (character === \",\" && depth === 0) { columns.push(current.trim()); current = \"\"; }\n    else current += character;\n  }\n  if (current.trim()) columns.push(current.trim());\n  return columns;\n};\nconst maskNestedSql = (value) => {\n  const sql = String(value || \"\");\n  const masked = Array(sql.length).fill(\" \");\n  let depth = 0;\n  let state = \"\";\n  for (let index = 0; index < sql.length; index += 1) {\n    const current = sql[index];\n    const next = sql[index + 1] || \"\";\n    if (state === \"single\" || state === \"double\") {\n      const quote = state === \"single\" ? \"'\" : '\"';\n      if (current === quote && next === quote) index += 1;\n      else if (current === quote) state = \"\";\n      continue;\n    }\n    if (state === \"line\") { if (current === \"\\n\" || current === \"\\r\") state = \"\"; continue; }\n    if (state === \"block\") {\n      if (current === \"*\" && next === \"/\") { index += 1; state = \"\"; }\n      continue;\n    }\n    if (current === \"'\" || current === '\"') { state = current === \"'\" ? \"single\" : \"double\"; continue; }\n    if (current === \"-\" && next === \"-\") { state = \"line\"; index += 1; continue; }\n    if (current === \"/\" && next === \"*\") { state = \"block\"; index += 1; continue; }\n    if (current === \"(\") { masked[index] = current; depth += 1; continue; }\n    if (current === \")\") { depth = Math.max(0, depth - 1); masked[index] = current; continue; }\n    if (depth === 0) masked[index] = current;\n  }\n  return masked.join(\"\");\n};\nconst findLastSqlMatch = (value, expression) => {\n  let result = null;\n  let match;\n  while ((match = expression.exec(value)) !== null) result = match;\n  return result;\n};\nconst normalizeOrderByField = (value) =>\n  normalizeSortAlias(\n    String(value || \"\")\n      .replace(/\\s+NULLS\\s+(?:FIRST|LAST)\\s*$/i, \"\")\n      .replace(/\\s+(?:ASC|DESC)\\s*$/i, \"\")\n  );\nconst mergeOrderByFields = (requestedSortBy, existingOrderBy) => {\n  const fields = [];\n  const seen = new Set();\n  const add = (value) => {\n    const field = String(value || \"\").trim();\n    const key = normalizeOrderByField(field);\n    if (!field || !key || seen.has(key)) return;\n    seen.add(key);\n    fields.push(field);\n  };\n  for (const item of requestedSortBy) add(`${item.field} ${item.order.toUpperCase()}`);\n  for (const item of splitSelectColumns(existingOrderBy)) add(item);\n  return fields.join(\", \");\n};\nconst applySortToSelect = (value, requestedSortBy) => {\n  const sql = String(value || \"\");\n  const sortBy = normalizeSortBy(requestedSortBy);\n  if (!sql.trim() || sortBy.length === 0) return sql;\n  const masked = maskNestedSql(sql);\n  const fromMatch = /\\bFROM\\b/i.exec(masked);\n  if (!fromMatch) return sql;\n  const orderMatch = findLastSqlMatch(masked, /\\bORDER\\s+BY\\b/gi);\n  const tailPattern = /\\bOFFSET\\s+(?:\\d+|:[A-Za-z_$#][A-Za-z0-9_$#]*|\\?)\\s+ROWS?\\b|\\bFETCH\\s+(?:FIRST|NEXT)\\b/gi;\n  tailPattern.lastIndex = orderMatch\n    ? orderMatch.index + orderMatch[0].length\n    : fromMatch.index;\n  const tailMatch = tailPattern.exec(masked);\n  let statementEnd = masked.length;\n  while (statementEnd > 0 && /\\s/.test(masked[statementEnd - 1])) statementEnd -= 1;\n  const terminator = statementEnd > 0 && masked[statementEnd - 1] === \";\"\n    ? statementEnd - 1\n    : statementEnd;\n  const prefixEnd = orderMatch ? orderMatch.index : tailMatch ? tailMatch.index : terminator;\n  const suffixStart = tailMatch ? tailMatch.index : terminator;\n  const existingOrderBy = orderMatch\n    ? sql.slice(orderMatch.index + orderMatch[0].length, suffixStart).trim()\n    : \"\";\n  const orderBy = mergeOrderByFields(sortBy, existingOrderBy);\n  if (!orderBy) return sql;\n  const prefix = sql.slice(0, prefixEnd).trimEnd();\n  const suffix = sql.slice(suffixStart).trimStart();\n  return `${prefix} ORDER BY ${orderBy}${suffix ? `${suffix.startsWith(\";\") ? \"\" : \" \"}${suffix}` : \"\"}`;\n};\nconst extractSelectAliases = (value) => {\n  const select = String(value || \"\").replace(/\\/\\*[\\s\\S]*?\\*\\//g, \" \");\n  const match = select.match(/\\bselect\\b([\\s\\S]*?)\\bfrom\\b/i);\n  if (!match) return [];\n  return splitSelectColumns(match[1].replace(/^\\s*distinct\\s+/i, \"\"))\n    .map((column) => {\n      const asMatch = column.match(/\\bas\\s+[\"\\[]?([A-Za-z_$][A-Za-z0-9_$]*)[\"\\]]?\\s*$/i);\n      if (asMatch) return asMatch[1];\n      const plainMatch = column.match(/(?:^|[\\s.])[\"\\[]?([A-Za-z_$][A-Za-z0-9_$]*)[\"\\]]?\\s*$/);\n      return plainMatch ? plainMatch[1] : \"\";\n    })\n    .filter(Boolean);\n};\nconst resolveSortByWithIndexes = (requestedSortBy, indexes) => {\n  if (indexes.length === 0) return { acceptedSortBy: [], appliedSortBy: [] };\n  const acceptedSortBy = [];\n  const acceptedPositions = new Map();\n  let appliedSortBy = [];\n  for (const item of normalizeSortBy(requestedSortBy)) {\n    const key = normalizeSortAlias(item.field);\n    const resolvedFields = [];\n    let valid = true;\n    for (const index of indexes) {\n      const owners = index.get(key);\n      if (!owners || owners.size !== 1) { valid = false; break; }\n      resolvedFields.push(Array.from(owners)[0]);\n    }\n    if (!valid) continue;\n    const uniqueResolvedFields = [...new Set(resolvedFields)];\n    const signature = uniqueResolvedFields.map(normalizeSortAlias).sort().join(\"|\");\n    if (acceptedPositions.has(signature)) acceptedSortBy[acceptedPositions.get(signature)].order = item.order;\n    else {\n      acceptedPositions.set(signature, acceptedSortBy.length);\n      acceptedSortBy.push(item);\n    }\n    appliedSortBy = mergeSortBy(appliedSortBy, uniqueResolvedFields.map((field) => ({ field, order: item.order })));\n  }\n  return { acceptedSortBy, appliedSortBy };\n};\nconst addQueryAliasVariants = (owners, alias, field) => {\n  const add = (value) => {\n    const key = normalizeSortAlias(value);\n    if (!key) return;\n    if (!owners.has(key)) owners.set(key, new Set());\n    owners.get(key).add(field);\n  };\n  const tokens = String(alias || \"\")\n    .replace(/^\\$/, \"\")\n    .replace(/([A-Z]+)([A-Z][a-z])/g, \"$1 $2\")\n    .replace(/([a-z0-9])([A-Z])/g, \"$1 $2\")\n    .replace(/[_-]+/g, \" \")\n    .split(/\\s+/)\n    .filter(Boolean);\n  add(alias);\n  const addTokenVariants = (values) => {\n    if (values[0]?.toLowerCase() === \"general\" && values[1]?.toLowerCase() === \"ledger\") add([\"GL\", ...values.slice(2)].join(\" \"));\n    for (let index = 1; index < values.length; index += 1) {\n      const suffix = values.slice(index);\n      if (suffix.length === 1 && genericSortAliasSuffixes.has(suffix[0].toLowerCase())) continue;\n      add(suffix.join(\" \"));\n    }\n  };\n  addTokenVariants(tokens);\n  const withoutUnrounded = tokens.filter((token) => token.toLowerCase() !== \"unrounded\");\n  if (withoutUnrounded.length !== tokens.length) {\n    add(withoutUnrounded.join(\" \"));\n    addTokenVariants(withoutUnrounded);\n  }\n};\nconst createQueryAliasOwners = (query, metadata) => {\n  const owners = new Map();\n  const selectedAliases = new Map(extractSelectAliases(query?.select).map((alias) => [normalizeSortAlias(alias), alias]));\n  const dimensionAttributes = new Map();\n  const add = (alias, physicalAlias) => {\n    const selectedAlias = selectedAliases.get(normalizeSortAlias(physicalAlias));\n    if (selectedAlias) addQueryAliasVariants(owners, alias, selectedAlias);\n  };\n  const rememberDimensionAttribute = (dimensionName, attributeName, physicalAlias) => {\n    const selectedAlias = selectedAliases.get(normalizeSortAlias(physicalAlias));\n    const dimensionKey = normalizeSortAlias(dimensionName);\n    const attributeKey = normalizeSortAlias(attributeName);\n    if (!selectedAlias || !dimensionKey || !attributeKey) return;\n    if (!dimensionAttributes.has(dimensionKey)) dimensionAttributes.set(dimensionKey, new Map());\n    if (!dimensionAttributes.get(dimensionKey).has(attributeKey)) dimensionAttributes.get(dimensionKey).set(attributeKey, selectedAlias);\n  };\n  for (const selectedAlias of selectedAliases.values()) addQueryAliasVariants(owners, selectedAlias, selectedAlias);\n  const visit = (source, seen = new Set()) => {\n    if (!source || typeof source !== \"object\" || seen.has(source)) return;\n    seen.add(source);\n    for (const property of [\"measureAliases\", \"fieldAliases\"]) {\n      const aliases = source[property];\n      if (!aliases || typeof aliases !== \"object\" || Array.isArray(aliases)) continue;\n      for (const [semanticName, physicalAlias] of Object.entries(aliases)) {\n        if (typeof physicalAlias !== \"string\") continue;\n        if (selectedAliases.has(normalizeSortAlias(physicalAlias))) add(semanticName, physicalAlias);\n        else if (selectedAliases.has(normalizeSortAlias(semanticName))) add(physicalAlias, semanticName);\n      }\n    }\n    const dimensions = source.dimensions;\n    if (dimensions && typeof dimensions === \"object\" && !Array.isArray(dimensions)) {\n      for (const [dimensionName, hierarchies] of Object.entries(dimensions)) {\n        if (!hierarchies || typeof hierarchies !== \"object\" || Array.isArray(hierarchies)) continue;\n        for (const [hierarchyName, definition] of Object.entries(hierarchies)) {\n          const hierarchyBaseName = hierarchyName.replace(/Hierarchy$/i, \"\");\n          const aliases = definition?.aliases;\n          if (!aliases || typeof aliases !== \"object\" || Array.isArray(aliases)) continue;\n          for (const [attributeName, physicalAlias] of Object.entries(aliases)) {\n            if (typeof physicalAlias !== \"string\") continue;\n            const cleanAttributeName = attributeName.replace(/^\\$/, \"\");\n            const suffix = cleanAttributeName.charAt(0).toUpperCase() + cleanAttributeName.slice(1);\n            add(attributeName, physicalAlias);\n            add(cleanAttributeName, physicalAlias);\n            add(dimensionName + suffix, physicalAlias);\n            add(hierarchyName + suffix, physicalAlias);\n            if (hierarchyBaseName !== hierarchyName) add(hierarchyBaseName + suffix, physicalAlias);\n            if (cleanAttributeName === \"memberName\") {\n              add(dimensionName + \"Name\", physicalAlias);\n              add(hierarchyName + \"Name\", physicalAlias);\n            } else if (cleanAttributeName === \"memberDescription\") {\n              add(dimensionName + \"Description\", physicalAlias);\n              add(hierarchyName + \"Description\", physicalAlias);\n            }\n            rememberDimensionAttribute(dimensionName, cleanAttributeName, physicalAlias);\n            rememberDimensionAttribute(hierarchyName, cleanAttributeName, physicalAlias);\n          }\n          const preferredAlias = [\n            aliases.$memberName,\n            aliases.$memberDescription,\n            ...Object.entries(aliases)\n              .filter(([name]) => !/levelname|treefilter/i.test(name))\n              .map(([, physicalAlias]) => physicalAlias)\n          ].find((physicalAlias) => selectedAliases.has(normalizeSortAlias(physicalAlias)));\n          if (typeof preferredAlias === \"string\") {\n            add(dimensionName, preferredAlias);\n            add(hierarchyName, preferredAlias);\n            if (hierarchyBaseName !== hierarchyName) add(hierarchyBaseName, preferredAlias);\n          }\n        }\n      }\n    }\n    for (const child of Object.values(source)) visit(child, seen);\n  };\n  visit(query);\n  const addDimensionAlias = (dimensionName, alias, attributeNames) => {\n    const attributes = dimensionAttributes.get(normalizeSortAlias(dimensionName));\n    if (!attributes) return;\n    for (const attributeName of attributeNames) {\n      const physicalAlias = attributes.get(normalizeSortAlias(attributeName));\n      if (physicalAlias) { add(alias, physicalAlias); return; }\n    }\n  };\n  addDimensionAlias(\"fiscalDate\", \"accountingPeriod\", [\"memberName\"]);\n  addDimensionAlias(\"fiscalDate\", \"accountingDate\", [\"memberName\"]);\n  addDimensionAlias(\"paymentCurrency\", \"currency\", [\"currencyCode\", \"memberName\"]);\n  addDimensionAlias(\"paymentCurrency\", \"enteredCurrency\", [\"currencyCode\", \"memberName\"]);\n  const addCoaSegments = (source, seen = new Set()) => {\n    if (!source || typeof source !== \"object\" || seen.has(source)) return;\n    seen.add(source);\n    const segments = source.chartOfAccounts?.segments;\n    if (segments && typeof segments === \"object\" && !Array.isArray(segments)) {\n      for (const [segmentName, definition] of Object.entries(segments)) {\n        const attributes = dimensionAttributes.get(normalizeSortAlias(definition?.dimensionName));\n        if (!attributes) continue;\n        const memberName = attributes.get(normalizeSortAlias(\"memberName\"));\n        const memberDescription = attributes.get(normalizeSortAlias(\"memberDescription\"));\n        const treeFilter = attributes.get(normalizeSortAlias(\"treeFilter\"));\n        const defaultMember = memberName || memberDescription;\n        if (defaultMember) {\n          add(segmentName, defaultMember);\n          add(definition?.label, defaultMember);\n          add(definition?.dimensionName, defaultMember);\n          for (const qualifier of Array.isArray(definition?.qualifiers) ? definition.qualifiers : []) add(qualifier, defaultMember);\n        }\n        if (memberDescription) { add(segmentName + \"Description\", memberDescription); add(String(definition?.label || \"\") + \" Description\", memberDescription); }\n        if (treeFilter) add(segmentName + \"TreeFilter\", treeFilter);\n      }\n    }\n    for (const child of Object.values(source)) addCoaSegments(child, seen);\n  };\n  addCoaSegments(metadata);\n  addCoaSegments(query);\n  return owners;\n};\nconst collectQueryAliasIndexes = (value) => (Array.isArray(value?.queries) ? value.queries : [])\n  .map((query) => createQueryAliasOwners(query, value?.metadata)).filter((owners) => owners.size > 0);\n\nconst additionalContext = $context.$triggers.REST.$input.additionalContext ?? {};\nconst dataRetrievalNodeResponse =\n  $context.$nodes.FIN_GL_BO_FUNCTION_GET_BUSINESS_VIEW_DATA?.$output ?? {};\nconst dataRetrievalResponseValue =\n  dataRetrievalNodeResponse?.output?.response ??\n  dataRetrievalNodeResponse?.response ??\n  dataRetrievalNodeResponse;\nlet dataRetrievalResponse = dataRetrievalResponseValue;\nif (typeof dataRetrievalResponseValue === \"string\") {\n  try {\n    dataRetrievalResponse = JSON.parse(dataRetrievalResponseValue);\n  } catch (error) {\n    dataRetrievalResponse = {};\n  }\n}\nconst isRecord = (value) => value !== null && typeof value === \"object\" && !Array.isArray(value);\nconst dataRetrievalResultStatuses = [];\nif (isRecord(dataRetrievalResponse)) {\n  if (isRecord(dataRetrievalResponse.resultStatus)) dataRetrievalResultStatuses.push(dataRetrievalResponse.resultStatus);\n  for (const value of Object.values(dataRetrievalResponse)) if (isRecord(value?.resultStatus)) dataRetrievalResultStatuses.push(value.resultStatus);\n}\nconst dataRetrievalRecoveryStatus = [dataRetrievalResponse, ...dataRetrievalResultStatuses]\n  .find((value) => typeof value?.recovery?.retryAttemptCount !== \"undefined\");\nconst retryAttemptCount = dataRetrievalRecoveryStatus?.recovery?.retryAttemptCount ?? additionalContext.retryAttemptCount ?? 0;\n\nconst queryResponse = $context.$variables.lastUsedQueryResponse;\nconst firstQuery = { ...queryResponse.queries[0] };\ndelete firstQuery.intentDetails;\ndelete firstQuery.hierarchyResolverMessage;\ndelete firstQuery.reasoning;\nconst title = $context.$variables.queryTitle.slice(0, 100);\nconst expandSubledgerBvData = $context.$variables.expandSubledgerBvData === true;\nconst flowRequirements =\n  $context.$nodes.FIN_GL_CODE_PARSE_ANALYTIC_VIEW_FLOW_REQUIREMENTS?.$output?.result ?? {};\nconst hasFlowRequirements = Object.keys(flowRequirements).length > 0;\nconst previousSortBy = !hasFlowRequirements || flowRequirements.sameObject === true ? normalizeSortBy($context.$variables.sortBy) : [];\nconst currentSortBy = flowRequirements.sortRequired === true && flowRequirements.sortAction !== \"clear\" ? normalizeSortBy(flowRequirements.sortBy) : [];\nconst requestedSortBy =\n  flowRequirements.sortAction === \"clear\"\n    ? []\n    : flowRequirements.sortAction === \"replace\"\n      ? currentSortBy\n      : flowRequirements.sortAction === \"append\"\n        ? mergeSortBy(previousSortBy, currentSortBy)\n        : previousSortBy;\nconst queryAliasIndexes = requestedSortBy.length > 0 ? collectQueryAliasIndexes(queryResponse) : [];\nconst { acceptedSortBy, appliedSortBy } = resolveSortByWithIndexes(requestedSortBy, queryAliasIndexes);\nconst stateSortBy =\n  flowRequirements.scopeChanged === true && queryAliasIndexes.length === 0\n    ? requestedSortBy\n    : acceptedSortBy;\nconst canApplySortOverride = !hasFlowRequirements || flowRequirements.scopeChanged === false;\n\nif (canApplySortOverride && appliedSortBy.length > 0) firstQuery.select = applySortToSelect(firstQuery.select, appliedSortBy);\n\nconst payload = {\n  chartOfAccountsId: additionalContext.chartOfAccountsId,\n  targetObject: \"subledger_bv\",\n  expandSubledgerBvData,\n  retryAttemptCount,\n  useEnhancedErrorResponse: true,\n  queries: [firstQuery],\n  additionalInfo: {\n    conversationId: additionalContext.conversationId,\n    title,\n    processExecutionId: additionalContext.processExecutionId,\n    jobType: \"EXPORT_TO_EXCEL\"\n  }\n};\n\nif (canApplySortOverride && appliedSortBy.length > 0) payload.sortBy = appliedSortBy;\nreturn { dataPayload: payload, sortBy: stateSortBy };"
          },
