        {
          "metadata": {
            "errorNodeId": "1778057000005",
            "name": "Resolve Subledger Object Selection",
            "returnType": "object",
            "sourceCode": "const selectionOutput = $context.$nodes.FIN_GL_LLM_OBJECT_SELECTOR.$output;\nconst candidates = $context.$nodes.FIN_GL_CODE_PARSE_INPUT.$output.result.candidates;\nconst candidateContext = $context.$nodes.FIN_GL_CODE_PARSE_INPUT.$output.result;\nconst fallbackObjectName = \"ora_erp_core_accountedTransactions_runtime_x__PayablesAccountedTransactionSummary\";\n\nconst asString = (value) => (typeof value === \"string\" ? value.trim() : \"\");\n\nconst parseIndex = (value) => {\n  if (typeof value === \"number\" && Number.isInteger(value)) {\n    return value;\n  }\n\n  const text = asString(value);\n  if (text === \"\") {\n    return null;\n  }\n\n  if (/^-?\\d+$/.test(text)) {\n    return Number(text);\n  }\n\n  try {\n    const parsed = JSON.parse(text);\n    if (typeof parsed === \"number\" && Number.isInteger(parsed)) {\n      return parsed;\n    }\n  } catch (error) {\n  }\n\n  return null;\n};\n\nconst getCandidateObjectName = (candidate) =>\n  candidate.objectName || candidate.analyticView || candidate.businessView || \"\";\n\nconst candidateCount = candidates.length;\nconst fallbackIndex = candidates.findIndex(\n  (candidate) => getCandidateObjectName(candidate) === fallbackObjectName\n);\nconst parsedIndex = parseIndex(selectionOutput);\nconst selectedIndex =\n  Number.isInteger(parsedIndex) && parsedIndex >= 0 && parsedIndex < candidateCount\n    ? parsedIndex\n    : fallbackIndex;\nconst selectedCandidate = candidates[selectedIndex];\nconst viewType = selectedCandidate.viewType;\nconst requestType = selectedCandidate.requestType;\nconst selectedView = {\n  ...selectedCandidate,\n  viewType,\n  subledgerKey: candidateContext.subledgerKey\n};\n\nconst res = {\n  requestType,\n  selectedIndex,\n  candidateCount,\n  followupRequired: false,\n  followupStage: \"\",\n  followupMessage: \"\",\n  selectedSubledgerName: candidateContext.subledgerName,\n  selectedSubledgerKey: candidateContext.subledgerKey,\n  viewType,\n  analyticView: viewType === \"AV\" ? selectedCandidate.analyticView || \"\" : \"\",\n  businessView: viewType === \"BV\" ? selectedCandidate.businessView || \"\" : \"\",\n  displayName: selectedCandidate.displayName || \"\",\n  selectedView\n};\n\nreturn res;"
          },
