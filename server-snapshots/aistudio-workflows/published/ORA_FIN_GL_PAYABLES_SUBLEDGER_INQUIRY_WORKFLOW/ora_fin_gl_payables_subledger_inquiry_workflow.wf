            "name": "Parse Analytic View Flow Requirements",
            "returnType": "object",
            "sourceCode": "const rawOutput = $context.$nodes.FIN_GL_LLM_ANALYTIC_VIEW_FLOW_CLASSIFIER.$output;\nconst priorRequestType = String($context.$nodes.FIN_GL_CODE_PARSE_INPUT.$output.result.requestType || \"\").trim().toUpperCase();\nconst currentRequestType = String($context.$variables.requestType || \"\").trim().toUpperCase();\nconst previousObject = String($context.$variables.previousAnalyticViewNameUsed || $context.$variables.previousBusinessViewNameUsed || \"\").trim();\nconst currentObject = String($context.$variables.analyticViewNameUsed || $context.$variables.businessViewNameUsed || \"\").trim();\n\nconst isObject = (value) => value !== null && typeof value === \"object\" && !Array.isArray(value);\nconst parseOutput = (value) => {\n  if (isObject(value)) return value;\n  if (typeof value !== \"string\" || !value.trim()) return null;\n  try {\n    const parsed = JSON.parse(value.trim());\n    return isObject(parsed) ? parsed : null;\n  } catch { return null; }\n};\nconst normalizeSortAlias = (value) => String(value || \"\").toLowerCase().replace(/[^a-z0-9]+/g, \"\");\nconst genericSortAliasSuffixes = new Set([\"account\", \"date\", \"status\", \"number\", \"amount\", \"type\"]);\n\nconst parsed = parseOutput(rawOutput);\nconst llmScopeChanged = typeof parsed?.scopeChanged === \"boolean\" ? parsed.scopeChanged : true;\nconst sameObject =\n  !!previousObject &&\n  previousObject === currentObject &&\n  priorRequestType === currentRequestType &&\n  [\"SUMMARY\", \"DETAIL\"].includes(currentRequestType);\nconst sortRequired = parsed?.sortRequired === true;\nconst rawSortAction = String(parsed?.sortAction || \"\").trim().toLowerCase();\nconst requestedSortAction = !sortRequired ? \"none\" : [\"append\", \"clear\"].includes(rawSortAction) ? rawSortAction : \"replace\";\nconst normalizeSortBy = (value) => {\n  const seen = new Set();\n  return (Array.isArray(value) ? value : []).reduce((result, item) => {\n    if (!isObject(item)) return result;\n    const field = String(item.field || \"\").trim();\n    const key = normalizeSortAlias(field);\n    if (!field || seen.has(key)) return result;\n    seen.add(key);\n    result.push({ field, order: String(item.order || \"\").trim().toLowerCase() === \"desc\" ? \"desc\" : \"asc\" });\n    return result;\n  }, []);\n};\nconst collectKeyOrderGroups = (value, groups = []) => {\n  if (Array.isArray(value)) {\n    const fields = value.map((item) => String(item ?? \"\").trim()).filter(Boolean);\n    if (fields.length) groups.push(fields);\n    return groups;\n  }\n  if (value && typeof value === \"object\") for (const child of Object.values(value)) collectKeyOrderGroups(child, groups);\n  return groups;\n};\nconst createAliasOwners = (fields) => {\n  const owners = new Map();\n  const add = (alias, field) => {\n    const key = normalizeSortAlias(alias);\n    if (!key) return;\n    if (!owners.has(key)) owners.set(key, new Set());\n    owners.get(key).add(field);\n  };\n  for (const field of fields) {\n    add(field, field);\n    const tokens = String(field)\n      .replace(/([A-Z]+)([A-Z][a-z])/g, \"$1 $2\")\n      .replace(/([a-z0-9])([A-Z])/g, \"$1 $2\")\n      .replace(/[_-]+/g, \" \")\n      .split(/\\s+/)\n      .filter(Boolean);\n    if (tokens[0]?.toLowerCase() === \"general\" && tokens[1]?.toLowerCase() === \"ledger\") add([\"GL\", ...tokens.slice(2)].join(\" \"), field);\n    for (let index = 1; index < tokens.length; index += 1) {\n      const suffix = tokens.slice(index);\n      if (suffix.length === 1 && genericSortAliasSuffixes.has(suffix[0].toLowerCase())) continue;\n      add(suffix.join(\" \"), field);\n    }\n  }\n  return owners;\n};\nconst normalizedCurrentSortBy = sortRequired && requestedSortAction !== \"clear\" ? normalizeSortBy(parsed?.sortBy) : [];\nconst sortAction = sortRequired && requestedSortAction !== \"clear\" && !normalizedCurrentSortBy.length ? \"none\" : requestedSortAction;\nconst currentSortBy = sortAction !== \"clear\" ? normalizedCurrentSortBy : [];\nconst availableFieldIndexes = collectKeyOrderGroups($context.$nodes.FIN_GL_CODE_PARSE_INPUT.$output.result.lastUsedDataKeyOrder).map(createAliasOwners);\nconst allCurrentSortFieldsAvailable = currentSortBy.length > 0 && availableFieldIndexes.length > 0 &&\n  currentSortBy.every(({ field }) => availableFieldIndexes.every((index) => index.get(normalizeSortAlias(field))?.size === 1));\nconst sortNeedsProjection =\n  sortRequired && requestedSortAction !== \"clear\" &&\n  (currentSortBy.length === 0 || !sameObject || !allCurrentSortFieldsAvailable);\n\nconst res = {\n  scopeChanged: requestedSortAction === \"clear\" || !sameObject || sortNeedsProjection ? true : llmScopeChanged,\n  breakdownRequired: currentRequestType === \"SUMMARY\" && typeof parsed?.breakdownRequired === \"boolean\" ? parsed.breakdownRequired : false,\n  sortRequired,\n  sortAction,\n  sortBy: currentSortBy,\n  sameObject,\n  priorRequestType,\n  currentRequestType\n};\n\nreturn res;"
