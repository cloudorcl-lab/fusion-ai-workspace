};\n\nconst collectAnalyticViewDataRecords = (avExtractResult) => {\n  const dataRecords = [];\n  collectFromAvContainer(avExtractResult.homogenousLedgerSetAvData, dataRecords);\n\n  if (Array.isArray(avExtractResult.ledgerLevelAvData)) {\n    for (const ledgerLevelData of avExtractResult.ledgerLevelAvData) {\n      collectFromAvContainer(ledgerLevelData, dataRecords);\n    }\n  }\n\n  return dataRecords;\n};\n\nconst classifyAnalyticViewExtract = (data) => {\n  if (!isObject(data) || Object.keys(data).length === 0) {\n    return \"no_data\";\n  }\n  if (hasProcessingMessage(data)) {\n    return \"async\";\n  }\n  if (!hasOwn(data, \"avExtractResult\")) {\n    return \"no_data\";\n  }\n\n  const avExtractResult = isObject(data.avExtractResult) ? data.avExtractResult : {};\n  const dataRecords = collectAnalyticViewDataRecords(avExtractResult);\n\n  let hasData = false;\n  let hasError = false;\n  let countObjectCount = 0;\n  let noDataCountObjectCount = 0;\n\n  for (const dataRecord of dataRecords) {\n    const records = dataRecord.records;\n    const errorCode = Number(dataRecord.error?.errorCode);\n\n    if (Array.isArray(records) && records.length > 0) {\n      hasData = true;\n    }\n\n    if (!Number.isNaN(errorCode) && errorCode >= 300) {\n      hasError = true;\n    }\n\n    if (hasOwn(dataRecord, \"count\")) {\n      countObjectCount += 1;\n\n      if (Number(dataRecord.count) === 0 && errorCode === 204) {\n        noDataCountObjectCount += 1;\n      }\n    }\n  }\n\n  if (hasData) {\n    return \"data\";\n  }\n  if (hasError) {\n    return \"error\";\n  }\n  if (countObjectCount > 0 && countObjectCount === noDataCountObjectCount) {\n    return \"no_data\";\n  }\n  return \"no_data\";\n};\n\nconst isBusinessViewDataRecord = (value) =>\n  isObject(value) && (hasOwn(value, \"records\") || hasOwn(value, \"count\") || hasOwn(value, \"error\"));\n\nconst collectBusinessViewDataRecords = (data) => {\n  const dataRecords = [];\n  if (!isObject(data)) {\n    return dataRecords;\n  }\n\n  if (isBusinessViewDataRecord(data)) {\n    dataRecords.push(data);\n  }\n\n  for (const value of Object.values(data)) {\n    if (isBusinessViewDataRecord(value)) {\n      dataRecords.push(value);\n    }\n  }\n\n  return dataRecords;\n};\n\nconst classifyBusinessViewExtract = (data) => {\n  if (!isObject(data) || Object.keys(data).length === 0) {\n    return \"no_data\";\n  }\n  if (hasProcessingMessage(data)) {\n    return \"async\";\n  }\n  if (hasOwn(data, \"errorCode\")) {\n    return String(data.errorCode) === \"204\" ? \"no_data\" : \"error\";\n  }\n\n  const statusCode = getNumber(data.statusCode);\n  if (statusCode === 204) {\n    return \"no_data\";\n  }\n  if (statusCode !== null && statusCode >= 300) {\n    return \"error\";\n  }\n\n  const dataRecords = collectBusinessViewDataRecords(data);\n  let hasData = false;\n  let hasError = false;\n  let countObjectCount = 0;\n  let noDataCountObjectCount = 0;\n\n  for (const dataRecord of dataRecords) {\n    const records = dataRecord.records;\n    const errorCode = getNumber(dataRecord.error?.errorCode);\n\n    if (Array.isArray(records) && records.length > 0) {\n      hasData = true;\n    }\n\n    if (errorCode !== null && errorCode !== 204) {\n      hasError = true;\n    }\n\n    if (hasOwn(dataRecord, \"count\")) {\n      countObjectCount += 1;\n\n      if (Number(dataRecord.count) === 0 && (errorCode === 204 || dataRecord.resultStatus?.category === \"Information\")) {\n        noDataCountObjectCount += 1;\n      }\n    }\n  }\n\n  if (hasData) {\n    return \"data\";\n  }\n  if (hasError) {\n    return \"error\";\n  }\n  if (countObjectCount > 0 && countObjectCount === noDataCountObjectCount) {\n    return \"no_data\";\n  }\n  return \"data\";\n};\n\nconst getColumnOrderFromFirstRow = (records) => {\n  if (!Array.isArray(records)) {\n    return [];\n  }\n\n  for (const record of records) {\n    if (!isObject(record)) {\n      continue;\n    }\n\n    const keys = Object.keys(record);\n    if (keys.length > 0) {\n      return keys;\n    }\n  }\n\n  return [];\n};\n\nconst getColumnOrderFromAvBucket = (bucket) =>\n  getColumnOrderFromFirstRow(isObject(bucket) ? bucket.records : []);\n\nconst multiAvBuckets = [\n  \"currentLevelAvDataPrimary\",\n  \"currentLevelAvDataSecondary\",\n  \"childLevelAvDataPrimary\",\n  \"childLevelAvDataSecondary\"\n];\n\nconst hasMultiAvBuckets = (ledgerLevelAvData) =>\n  Array.isArray(ledgerLevelAvData) &&\n  ledgerLevelAvData.some(\n    (ledgerLevelData) =>\n      isObject(ledgerLevelData) && multiAvBuckets.some((bucket) => hasOwn(ledgerLevelData, bucket))\n  );\n\nconst getColumnOrderFromFirstAvBucket = (ledgerLevelAvData, buckets) => {\n  if (!Array.isArray(ledgerLevelAvData)) {\n    return [];\n  }\n\n  for (const ledgerLevelData of ledgerLevelAvData) {\n    if (!isObject(ledgerLevelData)) {\n      continue;\n    }\n\n    for (const bucket of buckets) {\n      const columnOrder = getColumnOrderFromAvBucket(ledgerLevelData[bucket]);\n      if (columnOrder.length > 0) {\n        return columnOrder;\n      }\n    }\n  }\n\n  return [];\n};\n\nconst buildMultiAvKeyOrder = (ledgerLevelAvData) => {\n  const keyOrder = {};\n  const primaryColumnOrder = getColumnOrderFromFirstAvBucket(ledgerLevelAvData, [\n    \"currentLevelAvDataPrimary\",\n    \"childLevelAvDataPrimary\"\n  ]);\n  const secondaryColumnOrder = getColumnOrderFromFirstAvBucket(ledgerLevelAvData, [\n    \"currentLevelAvDataSecondary\",\n    \"childLevelAvDataSecondary\"\n  ]);\n\n  if (primaryColumnOrder.length > 0) {\n    keyOrder.primary = primaryColumnOrder;\n  }\n  if (secondaryColumnOrder.length > 0) {\n    keyOrder.secondary = secondaryColumnOrder;\n  }\n\n  return keyOrder;\n};\n\nconst buildRegularAvKeyOrder = (data) => {\n  if (!isObject(data) || !hasOwn(data, \"avExtractResult\")) {\n    return [];\n  }\n\n  const avExtractResult = isObject(data.avExtractResult) ? data.avExtractResult : {};\n  const homogenousColumnOrder = getColumnOrderFromAvBucket(avExtractResult.homogenousLedgerSetAvData);\n  if (homogenousColumnOrder.length > 0) {\n    return homogenousColumnOrder;\n  }\n\n  if (!Array.isArray(avExtractResult.ledgerLevelAvData)) {\n    return [];\n  }\n\n  return getColumnOrderFromFirstAvBucket(avExtractResult.ledgerLevelAvData, [\n    \"currentLevelAvData\",\n    \"childLevelAvData\"\n  ]);\n};\n\nconst buildAvKeyOrder = (data) => {\n  if (!isObject(data) || !hasOwn(data, \"avExtractResult\")) {\n    return [];\n  }\n\n  const avExtractResult = isObject(data.avExtractResult) ? data.avExtractResult : {};\n  if (hasMultiAvBuckets(avExtractResult.ledgerLevelAvData)) {\n    return buildMultiAvKeyOrder(avExtractResult.ledgerLevelAvData);\n  }\n\n  return buildRegularAvKeyOrder(data);\n};\n\nconst dataSuffix = \"Data\";\n\nconst getBusinessViewDataKeys = (data) =>\n  isObject(data)\n    ? Object.keys(data).filter((key) => key.endsWith(dataSuffix) && Array.isArray(data[key]))\n    : [];\n\nconst buildMultiBvKeyOrder = (data, dataKeys) => {\n  const keyOrder = {};\n\n  for (const dataKey of dataKeys) {\n    const columnOrder = getColumnOrderFromFirstRow(data[dataKey]);\n    if (columnOrder.length > 0) {\n      keyOrder[dataKey.slice(0, -dataSuffix.length)] = columnOrder;\n    }\n  }\n\n  return keyOrder;\n};\n\nconst buildRegularBvKeyOrder = (data, businessViewName) => {\n  if (!isObject(data) || !businessViewName) {\n    return [];\n  }\n\n  const dataKey = `${businessViewName}${dataSuffix}`;\n  return Array.isArray(data[dataKey]) ? getColumnOrderFromFirstRow(data[dataKey]) : [];\n};\n\nconst buildBvKeyOrder = (data, businessViewName) => {\n  const dataKeys = getBusinessViewDataKeys(data);\n  if (dataKeys.length > 1) {\n    return buildMultiBvKeyOrder(data, dataKeys);\n  }\n\n  return buildRegularBvKeyOrder(data, businessViewName);\n};\n\nconst buildSubledgerKeyOrder = (data, isBusinessView, businessViewName) =>\n  isBusinessView ? buildBvKeyOrder(data, businessViewName) : buildAvKeyOrder(data);\n\nconst getHierarchyResolverMessage = (value) =>\n  String(value?.queries?.[0]?.hierarchyResolverMessage ?? \"\").trim();\n\nconst buildNerFooterMessages = (value) => {\n  const ner = value?.queries?.[0]?.reasoning?.ner || {};\n  const text = String(ner.clarificationResponse ?? \"\").trim();\n  const status = String(ner.status ?? \"\").trim().toLowerCase();\n\n  if (status !== \"multi_step\" || text === \"\") {\n    return [];\n  }\n\n  return [\n    {\n      code: \"NER_CLARIFICATION\",\n      type: \"clarification\",\n      severity: \"info\",\n      placement: \"footer\",\n      text\n    }\n  ];\n};\n\nconst isBusinessView = Boolean($context.$variables.businessViewNameUsed);\nconst rawDataForKeyOrder = isBusinessView\n  ? $context.$nodes.FIN_GL_BO_FUNCTION_GET_BUSINESS_VIEW_DATA?.$output\n  : $context.$nodes.FIN_GL_BO_FUNCTION_GET_ANALYTIC_VIEW_DATA?.$output;\nconst dataForKeyOrder = rawDataForKeyOrder ?? $context.$variables.lastUsedDataResponse;\nconst successMessage = isBusinessView\n  ? classifyBusinessViewExtract(unwrapResponse(rawData))\n  : classifyAnalyticViewExtract(rawData);\n\nconst lastUsedQuery = {\n  queryResponse: $context.$variables.lastUsedQueryResponse,\n  queryPayload: $context.$variables.lastUsedQueryPayload,\n  queryTitle: $context.$variables.queryTitle,\n  selectedSubledgerName: $context.$variables.selectedSubledgerName,\n  selectedSubledgerKey: $context.$variables.selectedSubledgerKey,\n  requestType: $context.$variables.requestType,\n  sortBy: normalizeSortBy($context.$variables.sortBy)\n};\n\nif (isBusinessView) {\n  lastUsedQuery.businessViewNameUsed = $context.$variables.businessViewNameUsed;\n} else {\n  lastUsedQuery.analyticViewNameUsed = $context.$variables.analyticViewNameUsed;\n}\n\nconst response = {\n  status: \"success\",\n  successMessage,\n  state: {\n    private: {\n      lastUsedQuery,\n      lastUsedData: {\n        dataResponse: $context.$variables.lastUsedDataResponse,\n        dataPayload: $context.$variables.lastUsedDataPayload,\n        keyOrder: buildSubledgerKeyOrder(\n          dataForKeyOrder,\n          isBusinessView,\n          $context.$variables.businessViewNameUsed\n        )\n      }\n    },\n    shared: {\n      coaBreakdown: $context.$variables.coaBreakdown\n    }\n  }\n};\n\nconst hierarchyResolverMessage = getHierarchyResolverMessage($context.$variables.lastUsedQueryResponse);\nif (hierarchyResolverMessage) {\n  response.hierarchyResolverMessage = hierarchyResolverMessage;\n}\n\nconst messages = buildNerFooterMessages($context.$variables.lastUsedQueryResponse);\nif (messages.length > 0) {\n  response.messages = messages;\n}\n\nreturn response;"
