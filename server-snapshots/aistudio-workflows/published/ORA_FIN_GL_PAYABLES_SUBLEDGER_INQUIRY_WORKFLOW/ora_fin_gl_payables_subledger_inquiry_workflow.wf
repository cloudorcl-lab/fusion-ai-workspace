        {
          "metadata": {
            "errorNodeId": "1778057000005",
            "name": "Add Spoofed Analytic View Metadata",
            "returnType": "object",
            "sourceCode": "const queryResponse = $context.$variables.lastUsedQueryResponse;\nconst avMetaData = $context.$nodes.FIN_GL_BO_FUNCTION_GET_ANALYTIC_VIEW_DATA.$output?.avExtractResult?.metadata;\nconst isSpoofedAnalyticViewQuery = $context.$variables.performQueryGeneration === false && Boolean($context.$variables.analyticViewNameUsed);\n\nconst isObject = (value) => value !== null && typeof value === \"object\" && !Array.isArray(value);\nconst clone = (value) => JSON.parse(JSON.stringify(value));\n\nlet updatedQueryResponse = queryResponse;\nif (isSpoofedAnalyticViewQuery && isObject(queryResponse) && isObject(avMetaData)) {\n  updatedQueryResponse = {\n    ...clone(queryResponse),\n    metadata: clone(avMetaData)\n  };\n}\n\nconst res = { queryResponse: updatedQueryResponse };\n\nreturn res;"
          },
          "outcomes": {
            "success": "1778056075746"
          },
