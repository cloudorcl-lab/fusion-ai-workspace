            "name": "Prepare Query Spoof State",
            "returnType": "object",
            "sourceCode": "const additionalContext = $context.$triggers.REST.$input.additionalContext ?? {};\nlet bossExtract = additionalContext.bossExtract;\nconst userQuestion = $context.$system.$inputMessage;\nconst queryTitle = String(userQuestion).slice(0, 100);\n\nconst isObject = (value) => value !== null && typeof value === \"object\" && !Array.isArray(value);\nconst firstObjectValue = (value) => Object.values(value)[0] ?? {};\nconst errors = [];\n\nif (!isObject(bossExtract)) {\n  errors.push(\"additionalContext.bossExtract must be an object.\");\n}\n\nconst queries = errors.length === 0\n  ? Array.isArray(bossExtract.queries) ? bossExtract.queries : [ bossExtract.queries ]\n  : [];\nif (errors.length === 0) {\n  bossExtract.queries = queries;\n}\nconst firstQuery = queries[0];\n\nif (errors.length === 0 && !isObject(firstQuery)) {\n  errors.push(\"additionalContext.bossExtract.queries[0] must be an object.\");\n}\n\nconst hasAnalyticViews = isObject(firstQuery?.analyticViews);\nconst hasViewQueries = isObject(firstQuery?.viewQueries);\nconst isAv = additionalContext.queryType === \"avExtract\" || (\n  additionalContext.queryType !== \"bvExtract\" && hasAnalyticViews\n);\nlet analyticViewNameUsed = \"\";\nlet businessViewNameUsed = \"\";\nlet queryPayload = {};\n\nif (isAv) {\n  if (!hasAnalyticViews) {\n    errors.push(\"additionalContext.bossExtract.queries[0].analyticViews must be an object.\");\n  } else {\n    const analyticViewQuery = firstObjectValue(firstQuery.analyticViews);\n    analyticViewNameUsed = analyticViewQuery.name ?? \"\";\n  }\n  if (!Object.prototype.hasOwnProperty.call(firstQuery ?? {}, \"select\")) {\n    errors.push(\"additionalContext.bossExtract.queries[0].select is required.\");\n  }\n  queryPayload = {\n    targetObject: \"subledger_av\",\n    userQuestion,\n    directLLM: false,\n    chartOfAccountsId: additionalContext.chartOfAccountsId,\n    expandSubledgerData: false,\n    queries,\n    additionalInfo: {\n      processExecutionId: additionalContext.processExecutionId\n    }\n  };\n} else {\n  if (!hasViewQueries) {\n    errors.push(\"additionalContext.bossExtract.queries[0].viewQueries must be an object.\");\n  } else {\n    const businessViewQuery = firstObjectValue(firstQuery.viewQueries);\n    businessViewNameUsed = businessViewQuery.view ?? \"\";\n  }\n  if (!Object.prototype.hasOwnProperty.call(firstQuery ?? {}, \"select\")) {\n    errors.push(\"additionalContext.bossExtract.queries[0].select is required.\");\n  }\n  queryPayload = {\n    targetObject: \"subledger_bv\",\n    userQuestion,\n    directLLM: false,\n    includeHeaderOnly: \"N\",\n    chartOfAccountsId: additionalContext.chartOfAccountsId,\n    expandSubledgerBvData: false,\n    queries,\n    dataGrain: \"\",\n    additionalInfo: {\n      processExecutionId: additionalContext.processExecutionId\n    }\n  };\n}\n\nif (typeof additionalContext.templateId !== \"undefined\") {\n  queryPayload.templateId = additionalContext.templateId;\n}\nif (typeof additionalContext.templateDetails !== \"undefined\") {\n  queryPayload.templateDetails = additionalContext.templateDetails;\n}\nif (typeof additionalContext.allPlaceholdersSelected !== \"undefined\") {\n  queryPayload.allPlaceholdersSelected = additionalContext.allPlaceholdersSelected;\n}\n\nconst lastUsedQueryResponse = {\n  ...(isObject(bossExtract) ? bossExtract : {}),\n  timeStamp: bossExtract?.timeStamp ?? bossExtract?.timestamp ?? new Date().toISOString(),\n  question: bossExtract?.question ?? userQuestion,\n  queries\n};\n\nconst res = {\n  valid: errors.length === 0,\n  errors,\n  lastUsedQueryPayload: queryPayload,\n  lastUsedQueryResponse,\n  queryTitle,\n  analyticViewNameUsed,\n  businessViewNameUsed\n};\n\nreturn res;"
