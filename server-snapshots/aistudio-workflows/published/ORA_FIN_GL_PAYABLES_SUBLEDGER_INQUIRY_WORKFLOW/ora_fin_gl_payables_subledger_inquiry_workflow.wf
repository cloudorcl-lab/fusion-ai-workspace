 let appliedSortBy = [];\n  for (const item of normalizeSortBy(requestedSortBy)) {\n    const key = normalizeSortAlias(item.field);\n    const resolvedFields = [];\n    let valid = true;\n    for (const index of indexes) {\n      const owners = index.get(key);\n      if (!owners || owners.size !== 1) { valid = false; break; }\n      resolvedFields.push(Array.from(owners)[0]);\n    }\n    if (!valid) continue;\n    const uniqueResolvedFields = [...new Set(resolvedFields)];\n    const signature = uniqueResolvedFields.map(normalizeSortAlias).sort().join(\"|\");\n    if (acceptedPositions.has(signature)) acceptedSortBy[acceptedPositions.get(signature)].order = item.order;\n    else {\n      acceptedPositions.set(signature, acceptedSortBy.length);\n      acceptedSortBy.push(item);\n    }\n    appliedSortBy = mergeSortBy(appliedSortBy, uniqueResolvedFields.map((field) => ({ field, order: item.order })));\n  }\n  return { acceptedSortBy, appliedSortBy };\n};\nconst buildAmountTieBreaker = (sortBy, indexes) => {\n  const appliedFields = new Set(normalizeSortBy(sortBy).map((item) => normalizeSortAlias(item.field)));\n  for (const field of [\"netUnroundedAccountedAmount\", \"netAccountedAmount\"]) {\n    const amountSort = resolveSortByWithIndexes([{ field, order: \"desc\" }], indexes).appliedSortBy[0];\n    if (!amountSort) continue;\n    if (appliedFields.has(normalizeSortAlias(amountSort.field))) return [];\n    return [{ field: `ABS(${amountSort.field})`, order: \"desc\" }];\n  }\n  return [];\n};\nconst addQueryAliasVariants = (owners, alias, field) => {\n  const add = (value) => {\n    const key = normalizeSortAlias(value);\n    if (!key) return;\n    if (!owners.has(key)) owners.set(key, new Set());\n    owners.get(key).add(field);\n  };\n  const tokens = String(alias || \"\")\n    .replace(/^\\$/, \"\")\n    .replace(/([A-Z]+)([A-Z][a-z])/g, \"$1 $2\")\n    .replace(/([a-z0-9])([A-Z])/g, \"$1 $2\")\n    .replace(/[_-]+/g, \" \")\n    .split(/\\s+/)\n    .filter(Boolea