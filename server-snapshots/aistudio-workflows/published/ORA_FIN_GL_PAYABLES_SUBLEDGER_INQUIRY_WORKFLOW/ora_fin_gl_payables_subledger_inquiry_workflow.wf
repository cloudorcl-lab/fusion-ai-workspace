            "returnType": "object",
            "sourceCode": "const additionalContext = $context.$triggers.REST.$input.additionalContext;\nconst resolveHierarchyOverrides = () => {\n  const inputState = $context.$triggers.REST.$input.state || {};\n  const stateOverrides =\n    inputState?.domainSlice?.shared?.hierarchy?.hierarchyOverrides ||\n    inputState?.shared?.hierarchy?.hierarchyOverrides;\n  if (Array.isArray(stateOverrides) && stateOverrides.length > 0) {\n    return stateOverrides;\n  }\n  return [];\n};\nconst hierarchyOverrides = resolveHierarchyOverrides();\nconst rephrasedRequest = $context.$nodes.FIN_GL_CODE_PREPARE_ANALYTIC_VIEW_REPHRASED_REQUEST.$output.result;\nconst selectedView = $context.$nodes.FIN_GL_CODE_RESOLVE_OBJECT_SELECTION.$output.result.selectedView;\nconst analyticView = $context.$variables.analyticViewNameUsed;\nconst module = selectedView.viewModule;\n\nconst nlResolverNodeResponse =\n  $context.$nodes.FIN_GL_BO_FUNCTION_GENERATE_ANALYTIC_VIEW_QUERY?.$output ?? {};\nconst nlResolverResponseValue =\n  nlResolverNodeResponse?.output?.response ??\n  nlResolverNodeResponse?.response ??\n  nlResolverNodeResponse;\nlet nlResolverResponse = nlResolverResponseValue;\nif (typeof nlResolverResponseValue === \"string\") {\n  try {\n    nlResolverResponse = JSON.parse(nlResolverResponseValue);\n  } catch (error) {\n    nlResolverResponse = {};\n  }\n}\nconst retryAttemptCount =\n  nlResolverResponse?.recovery?.retryAttemptCount ??\n  additionalContext.retryAttemptCount ??\n  0;\n\nconst contextQueries = Array.isArray(additionalContext.queries)\n  ? additionalContext.queries\n  : [];\nconst firstContextQuery = contextQueries[0];\nconst contextQueryCandidate =\n  firstContextQuery && typeof firstContextQuery === \"object\"\n    ? firstContextQuery.query\n    : undefined;\nconst contextQuery =\n  contextQueryCandidate &&\n  typeof contextQueryCandidate === \"object\" &&\n  !Array.isArray(contextQueryCandidate)\n    ? contextQueryCandidate\n    : {};\n\nconst contextFilter = contextQuery.filter ?? \"\";\nconst contextTimePeriod = Array.isArray(contextQuery.time_period)\n  ? contextQuery.time_period\n  : [];\nconst contextCurrency = Array.isArray(contextQuery.currency)\n  ? contextQuery.currency[0] ?? \"\"\n  : typeof contextQuery.currency === \"string\"\n    ? contextQuery.currency\n    : \"\";\n\nconst query = {\n  filter: contextFilter\n};\n\nconst hasUsableLedgerValue = (value) =>\n  value !== null &&\n  typeof value !== \"undefined\" &&\n  !(typeof value === \"string\" && value.trim() === \"\");\nconst normalizeLedgerContext = (value) => {\n  if (Array.isArray(value)) {\n    return value.filter(hasUsableLedgerValue);\n  }\n  return hasUsableLedgerValue(value) ? [value] : [];\n};\nconst ledgerContext = normalizeLedgerContext(additionalContext.ledgerContext);\nconst queryEntry = {\n  analyticView,\n  module,\n  ledgerContext,\n  query,\n  segmentTreeVersionMappings: hierarchyOverrides,\n  time_period: contextTimePeriod,\n  currency: contextCurrency\n};\nif (hasUsableLedgerValue(additionalContext.ledgerCategory)) {\n  queryEntry.ledgerCategory = additionalContext.ledgerCategory;\n}\n\nconst payload = {\n  targetObject: \"subledger_av\",\n  userQuestion: rephrasedRequest.userQuestion,\n  directLLM: false,\n  retryAttemptCount,\n  useEnhancedErrorResponse: true,\n  chartOfAccountsId: additionalContext.chartOfAccountsId,\n  queries: [queryEntry],\n  additionalInfo: {\n    processExecutionId: additionalContext.processExecutionId\n  }\n};\n\nif (typeof additionalContext.templateId !== \"undefined\") {\n  payload.templateId = additionalContext.templateId;\n}\nif (typeof additionalContext.templateDetails !== \"undefined\") {\n  payload.templateDetails = additionalContext.templateDetails;\n}\nif (typeof additionalContext.allPlaceholdersSelected !== \"undefined\") {\n  payload.allPlaceholdersSelected = additionalContext.allPlaceholdersSelected;\n}\n\nconst res = {\n  queryPayload: payload\n};\n\nreturn res;"
