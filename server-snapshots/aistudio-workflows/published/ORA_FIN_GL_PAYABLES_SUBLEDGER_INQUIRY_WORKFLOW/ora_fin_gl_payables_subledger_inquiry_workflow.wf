{
  "workflowId": "300000331067530",
  "workflowCode": "ORA_FIN_GL_PAYABLES_SUBLEDGER_INQUIRY_WORKFLOW",
  "name": "Accounts Payable Supporting Details Assistance",
  "description": "The Accounts Payable Supporting Details Assistance agent is designed to address payables subledger journal related queries within Oracle Fusion, focusing on journal entries for payables invoices, payments, pre-payments.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "errorNodeId": "1778057000005",
