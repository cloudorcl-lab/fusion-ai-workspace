        {
          "metadata": {
            "errorNodeId": "1778057000005",
            "name": "Parse User Input",
            "returnType": "object",
            "sourceCode": "const inputState = $context.$triggers.REST.$input.state ?? {};\n\nconst isObject = (value) =>\n  value !== null && typeof value === \"object\" && !Array.isArray(value);\nconst asObject = (value) => (isObject(value) ? value : {});\nconst asString = (value) => (typeof value === \"string\" ? value : \"\");\nconst asArray = (value) => (Array.isArray(value) ? value : []);\nconst hasOwn = (value, key) => isObject(value) && Object.prototype.hasOwnProperty.call(value, key);\nconst normalizeSortBy = (value) => {\n  const seen = new Set();\n  return (Array.isArray(value) ? value : []).reduce((result, item) => {\n    if (!isObject(item)) return result;\n    const field = asString(item.field).trim();\n    const key = field.toLowerCase().replace(/[^a-z0-9]+/g, \"\");\n    if (!field || seen.has(key)) return result;\n    seen.add(key);\n    result.push({ field, order: asString(item.order).trim().toLowerCase() === \"desc\" ? \"desc\" : \"asc\" });\n    return result;\n  }, []);\n};\n\nconst sharedState = asObject(inputState.shared);\nconst privateState = asObject(inputState.private);\nconst lastUsedQuery = asObject(privateState.lastUsedQuery);\nconst lastUsedData = asObject(privateState.lastUsedData);\nconst queryPayload = asObject(lastUsedQuery.queryPayload);\nconst lastUsedDataPayload = asObject(lastUsedData.dataPayload);\nconst firstQuery = asObject(Array.isArray(queryPayload.queries) ? queryPayload.queries[0] : {});\nconst sortBy = normalizeSortBy(hasOwn(lastUsedQuery, \"sortBy\") ? lastUsedQuery.sortBy : lastUsedDataPayload.sortBy);\n\nconst priorAnalyticViewName = asString(lastUsedQuery.analyticViewNameUsed);\nconst priorBusinessViewName = asString(lastUsedQuery.businessViewNameUsed);\nconst fallbackAnalyticViewName = asString(firstQuery.analyticView);\nconst fallbackBusinessViewName = asString(firstQuery.businessView);\nconst analyticViewNameUsed = priorAnalyticViewName || fallbackAnalyticViewName;\nconst businessViewNameUsed = analyticViewNameUsed\n  ? \"\"\n  : priorBusinessViewName || fallbackBusinessViewName;\nconst queryTitle = asString(lastUsedQuery.queryTitle) || asString($context.$system.$inputMessage).slice(0, 100);\nconst selectedSubledgerName = asString(lastUsedQuery.selectedSubledgerName);\nconst selectedSubledgerKey = asString(lastUsedQuery.selectedSubledgerKey);\nconst requestType = asString(lastUsedQuery.requestType).toUpperCase() === \"DETAIL\" ? \"DETAIL\" : asString(lastUsedQuery.requestType).toUpperCase() === \"SUMMARY\" ? \"SUMMARY\" : \"\";\n\nconst additionalContext = $context.$triggers.REST.$input.additionalContext;\n\nconst hasBossExtract =\n  additionalContext &&\n  Object.prototype.hasOwnProperty.call(additionalContext, \"bossExtract\") &&\n  additionalContext.bossExtract !== null;\n\nconst performObjectDetermination = !hasBossExtract;\nconst performQueryGeneration = !hasBossExtract;\nconst performDataRetrieval = true;\n\nconst selectedSubledger = {\n  \"name\": \"Payables\",\n  \"subledgerKey\": \"payables\",\n  \"analyticViews\": [\n    {\n      \"analyticView\": \"ora_erp_core_accountedTransactions_runtime_x__PayablesAccountedPaymentSummary\",\n      \"supportsMultiObjectRetrieval\": false,\n      \"displayName\": \"Payables Accounted Payment Summary\",\n      \"description\": \"Aggregates accounted payment-related activity for Payables, including payments, reconciled payments, future-dated payments, refunds, discounts, gain or loss, and interest. Use this view for summary questions about supplier cash disbursement activity, payment clearing, refund totals, or breakdowns by payment method, payment status, bank account, or payment distribution type. This is the strongest Payables summary choice when the user is explicitly asking about payments instead of invoices.\",\n      \"importantAttributes\": [\n        \"supplier\",\n        \"ledger\",\n        \"legalEntity\",\n        \"businessUnit\",\n        \"fiscalDate\",\n        \"accountingPeriod\",\n        \"currency\",\n        \"accountingClass\",\n        \"eventClass\",\n        \"eventType\",\n        \"paymentType\",\n        \"paymentDistributionType\",\n        \"paymentMethod\",\n        \"paymentStatus\",\n        \"bankAccount\",\n        \"glTransferStatus\"\n      ],\n      \"journalCategories\": [\n        \"Reconciled Payments\",\n        \"Payments\"\n      ],\n      \"eventClasses\": [\n        \"Payments\",\n        \"Reconciled Payments\",\n        \"Future Dated Payments\",\n        \"Refunds\"\n      ],\n      \"accountTypes\": [\n        \"Liability\",\n        \"Asset\"\n      ],\n      \"selectionHints\": \"Use this view for summary questions about supplier payments, cleared payments, reconciled payments, refunds, or payment activity by bank account. Prefer it when payment method, payment status, payment type, payment distribution type, or bank account is central to the request. Do not use it as the default for generic supplier invoice questions.\",\n      \"anchoringDimensions\": [\n        \"Supplier\",\n        \"Account\"\n      ],\n      \"viewModule\": \"oraErpCoreAccountedTransactionsRuntime\"\n    },\n    {\n      \"analyticView\": \"ora_erp_core_accountedTransactions_runtime_x__PayablesAccountedTransactionSummary\",\n      \"supportsMultiObjectRetrieval\": true,\n      \"displayName\": \"Payables Accounted Transaction Summary\",\n      \"description\": \"Aggregates accounted invoice-related activity for Payables, including standard invoices, prepayments, prepayment invoices, credit memos, debit memos, and distribution line types such as freight, miscellaneous, tax, and withholding tax. Use this view for summary questions about supplier invoice activity, liability and expense movement, invoice counts or totals, and breakdowns by invoice attributes or supplier-facing accounting dimensions. This is the default Payables summary choice when the user is clearly in supplier context but has not explicitly shifted the question to payments.\",\n      \"importantAttributes\": [\n        \"supplier\",\n        \"ledger\",\n        \"legalEntity\",\n        \"businessUnit\",\n        \"fiscalDate\",\n        \"accountingPeriod\",\n        \"currency\",\n        \"accountingClass\",\n        \"eventClass\",\n        \"accountingEventType\",\n        \"invoiceSource\",\n        \"invoiceType\",\n        \"paymentMethod\",\n        \"paymentStatus\",\n        \"glTransferStatus\"\n      ],\n      \"journalCategories\": [\n        \"Supplier Cost\",\n        \"Purchase Invoices\"\n      ],\n      \"eventClasses\": [\n        \"Credit Memos\",\n        \"Debit Memos\",\n        \"Invoices\",\n        \"Prepayment Applications\",\n        \"Prepayments\"\n      ],\n      \"accountTypes\": [\n        \"Liability\",\n        \"Expense\",\n        \"Asset\"\n      ],\n      \"selectionHints\": \"Use this view for summary questions about supplier invoices, credit memos, debit memos, prepayments, withholding, or invoice distributions. Prefer it over the Payables payment summary when invoice type, invoice source, invoice currency, or invoice status is central to the request. If the request is clearly Payables but does not clearly distinguish invoices from payments, default to this view.\",\n      \"anchoringDimensions\": [\n        \"Supplier\",\n        \"Account\"\n      ],\n      \"viewModule\": \"oraErpCoreAccountedTransactionsRuntime\"\n    }\n  ],\n  \"businessViews\": [\n    {\n      \"businessView\": \"payablesAccountedInvoiceDetail\",\n      \"supportsMultiObjectRetrieval\": true,\n      \"displayName\": \"Payables Accounted Invoice Detail\",\n      \"viewBO\": \"PayablesInvoiceAccountingEntryDistribution\",\n      \"viewModule\": \"oraErpCorePayablesInvoices\",\n      \"description\": \"Returns invoice-distribution-level accounted detail for Payables invoices, including standard invoices, prepayments, prepayment invoices, credit memos, debit memos, and invoice distribution line types such as freight, miscellaneous, tax, and withholding tax. Use this view when the user wants line-level or accounting-level evidence for invoice-oriented supplier transactions rather than prepayment application-only activity.\",\n      \"importantAttributes\": [\n        \"supplier\",\n        \"invoiceNumber\",\n        \"invoiceSource\",\n        \"invoiceType\",\n        \"ledger\",\n        \"legalEntity\",\n        \"businessUnit\",\n        \"fiscalDate\",\n        \"accountingPeriod\",\n        \"currency\",\n        \"accountingClass\",\n        \"eventClass\",\n        \"eventType\",\n        \"paymentMethod\",\n        \"paymentStatus\",\n        \"purchasingCategory\",\n        \"glTransferStatus\"\n      ],\n      \"selectionHints\": \"Use this view for detail requests about invoices, credit memos, debit memos, prepayment invoices, or supplier invoice distributions. Do not use it for prepayment application-only questions. When the user asks to list or show invoice detail without explicitly requesting accounting distribution lines, downstream logic can still apply header-only behavior.\",\n      \"journalCategories\": [\n        \"Supplier Cost\",\n        \"Purchase Invoices\"\n      ],\n      \"eventClasses\": [\n        \"Credit Memos\",\n        \"Debit Memos\",\n        \"Invoices\",\n        \"Prepayment Invoices\",\n        \"Prepayments\"\n      ],\n      \"accountTypes\": [\n        \"Liability\",\n        \"Expense\",\n        \"Asset\"\n      ],\n      \"anchoringDimensions\": [\n        \"Supplier\",\n        \"Account\"\n      ]\n    },\n    {\n      \"businessView\": \"payablesAccountedPaymentDetail\",\n      \"supportsMultiObjectRetrieval\": false,\n      \"displayName\": \"Payables Accounted Payment Detail\",\n      \"viewBO\": \"PayablesPaymentAccountingEntryDistribution\",\n      \"viewModule\": \"oraErpCorePayablesPayments\",\n      \"description\": \"Returns payment-distribution-level accounting detail for Payables payments. Use this view when the user wants payment transaction numbers, accounting dates, code combinations, payment accounting references, accounting status, GL transfer status, or supplier payment detail rather than invoice-distribution detail.\",\n      \"importantAttributes\": [\n        \"supplier\",\n        \"paymentNumber\",\n        \"paymentType\",\n        \"paymentDistributionType\",\n        \"paymentMethod\",\n        \"paymentStatus\",\n        \"bankAccount\",\n        \"ledger\",\n        \"legalEntity\",\n        \"businessUnit\",\n        \"fiscalDate\",\n        \"accountingPeriod\",\n        \"currency\",\n        \"accountingClassLookup\",\n        \"eventClass\",\n        \"eventType\",\n        \"glTransferStatus\",\n        \"reversalFlag\"\n      ],\n      \"selectionHints\": \"Use this view for payment detail, payment accounting lines, refunds, future-dated payments, and reconciled payment detail. Prefer it whenever payment number, payment method, payment status, or bank account is central to the request. Do not use it for invoice detail or prepayment application detail.\",\n      \"journalCategories\": [\n        \"Supplier Cost\",\n        \"Purchase Invoices\"\n      ],\n      \"eventClasses\": [\n        \"Payments\",\n        \"Refunds\",\n        \"Future dated payments\",\n        \"Reconciled payments\"\n      ],\n      \"accountTypes\": [\n        \"Liability\",\n        \"Expense\",\n        \"Asset\"\n      ],\n      \"anchoringDimensions\": [\n        \"Supplier\",\n        \"Account\"\n      ]\n    },\n    {\n      \"businessView\": \"payablesAccountedPrepaymentDetail\",\n      \"supportsMultiObjectRetrieval\": false,\n      \"displayName\": \"Payables Accounted Prepayment Application Detail\",\n      \"viewBO\": \"PayablesPrepaymentApplicationAccountingEntryDistribution\",\n      \"viewModule\": \"oraErpCorePayablesInvoices\",\n      \"description\": \"Returns accounted prepayment-application distribution detail only. Use this view when the user is specifically asking about the application of a prepayment against an invoice, not the original prepayment invoice or other supplier invoice activity.\",\n      \"importantAttributes\": [\n        \"supplier\",\n        \"invoiceSource\",\n        \"invoiceType\",\n        \"ledger\",\n        \"legalEntity\",\n        \"businessUnit\",\n        \"fiscalDate\",\n        \"accountingPeriod\",\n        \"currency\",\n        \"accountingClass\",\n        \"eventClass\",\n        \"eventType\",\n        \"paymentMethod\",\n        \"paymentStatus\",\n        \"glTransferStatus\"\n      ],\n      \"selectionHints\": \"Use this view specifically for prepayment application detail. Do not use it for standard invoices, prepayment invoices, standalone prepayments, credit memos, or debit memos. Mentions of applying a prepayment to an invoice, or of unapplied prepayments in that context, are strong signals for this view.\",\n      \"journalCategories\": [\n        \"Supplier Cost\",\n        \"Purchase Invoices\"\n      ],\n      \"eventClasses\": [\n        \"Prepayment Applications\"\n      ],\n      \"accountTypes\": [\n        \"Liability\",\n        \"Expense\",\n        \"Asset\"\n      ],\n      \"anchoringDimensions\": [\n        \"Supplier\",\n        \"Account\"\n      ]\n    }\n  ]\n};\n\nconst addArrayLine = (lines, label, values) => {\n  if (Array.isArray(values) && values.length > 0) {\n    lines.push(`${label}: ${values.join(\", \")}`);\n  }\n};\n\nconst analyticCandidates = selectedSubledger.analyticViews.map((candidate) => ({\n  ...candidate,\n  viewType: \"AV\",\n  requestType: \"SUMMARY\",\n  objectName: candidate.analyticView,\n  subledgerKey: selectedSubledger.subledgerKey\n}));\n\nconst businessCandidates = selectedSubledger.businessViews.map((candidate) => ({\n  ...candidate,\n  viewType: \"BV\",\n  requestType: \"DETAIL\",\n  objectName: candidate.businessView,\n  subledgerKey: selectedSubledger.subledgerKey\n}));\n\nconst candidates = [...analyticCandidates, ...businessCandidates].map((candidate, index) => ({\n  index,\n  ...candidate\n}));\n\nconst promptText = candidates\n  .map((candidate) => {\n    const technicalName = candidate.viewType === \"AV\" ? candidate.analyticView : candidate.businessView;\n    const label = candidate.displayName || technicalName;\n    const objectKind = candidate.viewType === \"AV\" ? \"SUMMARY\" : \"DETAIL\";\n    const lines = [\n      `[${candidate.index}] ${objectKind} - ${label} - ${technicalName}`,\n      `Description: ${candidate.description || \"No description provided.\"}`\n    ];\n\n    addArrayLine(lines, \"Important attributes\", candidate.importantAttributes || []);\n\n    if (candidate.selectionHints) {\n      lines.push(`Selection hints: ${candidate.selectionHints}`);\n    }\n\n    addArrayLine(lines, \"Journal categories\", candidate.journalCategories || []);\n    addArrayLine(lines, \"Event classes\", candidate.eventClasses || []);\n    addArrayLine(lines, \"Account types\", candidate.accountTypes || []);\n    addArrayLine(lines, \"Anchoring dimensions\", candidate.anchoringDimensions || []);\n\n    return lines.join(\"\\n\");\n  })\n  .join(\"\\n\\n\");\n\nconst response = {\n  lastUsedQueryResponse: lastUsedQuery.queryResponse ?? {},\n  lastUsedQueryPayload: queryPayload,\n  queryTitle,\n  analyticViewNameUsed,\n  businessViewNameUsed,\n  selectedSubledgerName,\n  selectedSubledgerKey,\n  requestType,\n  lastUsedDataResponse: lastUsedData.dataResponse ?? {},\n  lastUsedDataPayload,\n  lastUsedDataKeyOrder: lastUsedData.keyOrder ?? [],\n  coaBreakdown: asArray(sharedState.coaBreakdown),\n  sortBy,\n  expandSubledgerData: lastUsedDataPayload.expandSubledgerData === true,\n  expandSubledgerBvData: lastUsedDataPayload.expandSubledgerBvData === true,\n  performObjectDetermination,\n  performQueryGeneration,\n  performDataRetrieval,\n  subledgerName: selectedSubledger.name,\n  subledgerKey: selectedSubledger.subledgerKey,\n  analyticViews: analyticCandidates,\n  businessViews: businessCandidates,\n  candidates,\n  promptText,\n  candidateCount: candidates.length,\n};\n\nreturn response;"
          },
          "outcomes": {
            "success": "1778038978437"
          },
