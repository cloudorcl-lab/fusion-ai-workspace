              "value": "{{$context.$nodes.FIN_GL_CODE_PARSE_ANALYTIC_VIEW_FLOW_REQUIREMENTS.$output.result.breakdownRequired === true && !!$context.$variables.lastUsedQueryResponse?.metadata?.chartOfAccounts?.segments}}"
