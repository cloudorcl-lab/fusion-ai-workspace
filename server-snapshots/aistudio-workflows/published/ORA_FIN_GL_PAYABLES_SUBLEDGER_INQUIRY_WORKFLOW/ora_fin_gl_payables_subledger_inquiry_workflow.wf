          "metadata": {
            "errorNodeId": "1778057000005",
            "name": "Parse Breakdown Dimensions",
            "returnType": "object",
            "sourceCode": "const llmOutput = $context.$nodes.FIN_GL_LLM_BREAKDOWN_DIMENSION_SELECTOR.$output;\nconst segments = $context.$variables.lastUsedQueryResponse?.metadata?.chartOfAccounts?.segments;\n\nconst isObject = (value) => value !== null && typeof value === \"object\" && !Array.isArray(value);\n\nconst parseOutputObject = (value) => {\n  if (isObject(value)) {\n    return value;\n  }\n  if (typeof value === \"string\") {\n    const text = value.trim();\n    if (!text) {\n      return null;\n    }\n    try {\n      const parsed = JSON.parse(text);\n      return isObject(parsed) ? parsed : null;\n    } catch (error) {\n      return null;\n    }\n  }\n  return null;\n};\n\nconst normalizeMemberNames = (value) => {\n  let values = value;\n\n  if (typeof values === \"string\") {\n    const text = values.trim();\n    if (!text) {\n      return [];\n    }\n    try {\n      const parsed = JSON.parse(text);\n      values = Array.isArray(parsed) ? parsed : text.split(\",\");\n    } catch (error) {\n      values = text.split(\",\");\n    }\n  }\n\n  if (!Array.isArray(values)) {\n    return [];\n  }\n\n  const memberNames = [];\n  for (const value of values) {\n    if (value === null || typeof value === \"undefined\") {\n      continue;\n    }\n\n    const memberName = String(value).trim();\n    if (memberName && !memberNames.includes(memberName)) {\n      memberNames.push(memberName);\n    }\n  }\n\n  return memberNames;\n};\n\nconst normalizeExpandLevel = (value) => {\n  if (value === -1 || value === \"-1\") {\n    return \"-1\";\n  }\n  return \"1\";\n};\n\nconst normalizeBreakdown = (value) => {\n  if (!isObject(value)) {\n    return null;\n  }\n\n  const dimensionName = String(value.dimensionName ?? \"\").trim();\n  const isSegmentKey =\n    Object.prototype.hasOwnProperty.call(segments, dimensionName);\n  const isSegmentDimensionName = Object.values(segments).some(\n    (segment) => String(segment?.dimensionName ?? \"\").trim() === dimensionName\n  );\n  if (!isSegmentKey && !isSegmentDimensionName) {\n    return null;\n  }\n\n  return {\n    dimensionName,\n    memberNames: normalizeMemberNames(value.memberNames),\n    expandLevel: normalizeExpandLevel(value.expandLevel)\n  };\n};\n\nconst breakdowns = [];\nconst byDimension = {};\n\nif (isObject(segments)) {\n  const parsed = parseOutputObject(llmOutput);\n  const rawBreakdowns = Array.isArray(parsed?.breakdowns) ? parsed.breakdowns : [];\n\n  for (const rawBreakdown of rawBreakdowns) {\n    const breakdown = normalizeBreakdown(rawBreakdown);\n    if (!breakdown) {\n      continue;\n    }\n\n    const existingBreakdown = byDimension[breakdown.dimensionName];\n    if (!existingBreakdown) {\n      byDimension[breakdown.dimensionName] = breakdown;\n      breakdowns.push(breakdown);\n      continue;\n    }\n\n    if (breakdown.expandLevel === \"-1\") {\n      existingBreakdown.expandLevel = \"-1\";\n    }\n\n    for (const memberName of breakdown.memberNames) {\n      if (!existingBreakdown.memberNames.includes(memberName)) {\n        existingBreakdown.memberNames.push(memberName);\n      }\n    }\n  }\n}\n\nconst res = {\n  breakdowns\n};\n\nreturn res;"
