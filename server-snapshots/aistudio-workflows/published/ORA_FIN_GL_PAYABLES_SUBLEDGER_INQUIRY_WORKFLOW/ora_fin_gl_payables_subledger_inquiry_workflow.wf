            "sourceCode": "const rawData = $context.$variables.lastUsedDataResponse;\n\nconst isObject = (value) => value !== null && typeof value === \"object\" && !Array.isArray(value);\nconst hasOwn = (value, key) => isObject(value) && Object.prototype.hasOwnProperty.call(value, key);\nconst hasEnhancedErrorCategory = (value) =>\n  isObject(value) &&\n  (value.category === \"SystemError\" ||\n    value.category === \"UserError\");\nconst unwrapResponse = (data) => {\n  const responseValue = data?.output?.response ?? data?.response ?? data;\n\n  if (typeof responseValue !== \"string\") {\n    return responseValue;\n  }\n\n  try {\n    return JSON.parse(responseValue);\n  } catch (error) {\n    return {};\n  }\n};\nconst hasProcessingMessage = (value) =>\n  isObject(value) && typeof value.message === \"string\" && value.message.includes(\"Recent\");\n\nconst isAvDataRecord = (value) =>\n  isObject(value) &&\n  (hasOwn(value, \"records\") ||\n    hasOwn(value, \"count\") ||\n    hasOwn(value, \"error\") ||\n    hasOwn(value, \"resultStatus\"));\n\nconst collectFromAvContainer = (container, dataRecords) => {\n  if (!isObject(container)) {\n    return;\n  }\n\n  if (isAvDataRecord(container)) {\n    dataRecords.push(container);\n  }\n\n  for (const value of Object.values(container)) {\n    if (isAvDataRecord(value)) {\n      dataRecords.push(value);\n    }\n  }\n};\n\nconst collectAnalyticViewDataRecords = (avExtractResult) => {\n  const dataRecords = [];\n  collectFromAvContainer(avExtractResult.homogenousLedgerSetAvData, dataRecords);\n\n  if (Array.isArray(avExtractResult.ledgerLevelAvData)) {\n    for (const ledgerLevelData of avExtractResult.ledgerLevelAvData) {\n      collectFromAvContainer(ledgerLevelData, dataRecords);\n    }\n  }\n\n  return dataRecords;\n};\n\nconst classifyAnalyticViewExtract = (data) => {\n  if (!hasOwn(data, \"avExtractResult\")) {\n    return \"error\";\n  }\n\n  const avExtractResult = isObject(data.avExtractResult) ? data.avExtractResult : {};\n  const dataRecords = collectAnalyticViewDataRecords(avExtractResult);\n\n  let hasData = false;\n  let hasError = false;\n  let countObjectCount = 0;\n  let noDataCountObjectCount = 0;\n\n  for (const dataRecord of dataRecords) {\n    const records = dataRecord.records;\n    const errorCode = Number(dataRecord.error?.errorCode);\n    const resultStatus = isObject(dataRecord.resultStatus) ? dataRecord.resultStatus : {};\n\n    if (Array.isArray(records) && records.length > 0) {\n      hasData = true;\n    }\n\n    if (\n      (!Number.isNaN(errorCode) && errorCode >= 300) ||\n      hasEnhancedErrorCategory(resultStatus)\n    ) {\n      hasError = true;\n    }\n\n    if (hasOwn(dataRecord, \"count\")) {\n      countObjectCount += 1;\n\n      if (Number(dataRecord.count) === 0 && (errorCode === 204 || resultStatus.category === \"Information\")) {\n        noDataCountObjectCount += 1;\n      }\n    }\n  }\n\n  if (hasData) {\n    return \"data\";\n  }\n  if (hasError) {\n    return \"error\";\n  }\n  if (countObjectCount > 0 && countObjectCount === noDataCountObjectCount) {\n    return \"no_data\";\n  }\n  return \"error\";\n};\n\nconst normalizedData = unwrapResponse(rawData);\n\nlet res = hasEnhancedErrorCategory(normalizedData);\nif (!res && !hasProcessingMessage(normalizedData)) {\n  res = classifyAnalyticViewExtract(normalizedData) === \"error\";\n}\n\nreturn res;"
