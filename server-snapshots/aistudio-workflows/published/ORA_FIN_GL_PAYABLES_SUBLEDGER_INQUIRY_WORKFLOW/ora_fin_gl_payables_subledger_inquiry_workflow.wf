        },
        {
          "metadata": {
            "errorNodeId": "1777619990217",
            "name": "Construct Analytic View Query Error",
            "returnType": "object",
            "sourceCode": "const inputState = $context.$triggers.REST.$input.state ?? {};\nconst rawResponse = $context.$nodes.FIN_GL_BO_FUNCTION_GENERATE_ANALYTIC_VIEW_QUERY.$output ?? {};\n\nconst isObject = (value) => value !== null && typeof value === \"object\" && !Array.isArray(value);\nconst clone = (value) => {\n  try {\n    return JSON.parse(JSON.stringify(value));\n  } catch (error) {\n    return value;\n  }\n};\nconst getNumber = (value) => {\n  if (typeof value === \"number\" && Number.isFinite(value)) {\n    return value;\n  }\n  if (typeof value === \"string\" && value.trim() !== \"\") {\n    const parsed = Number(value);\n    if (Number.isFinite(parsed)) {\n      return parsed;\n    }\n  }\n  return null;\n};\nconst toErrorDetails = (value) => (isObject(value) || Array.isArray(value) ? clone(value) : { value });\nconst getCause = (value) => {\n  const statusCode = getNumber(value?.statusCode);\n  const title = value?.title;\n  if (statusCode !== null && statusCode >= 300 && (title === \"VALUE_NOT_IN_HIERARCHY\" || title === \"HIERARCHY_NOT_FOUND\")) {\n    return title;\n  }\n  return \"QUERY_GENERATION\";\n};\n\nif (rawResponse?.recovery?.recoverable === true && rawResponse.recovery.retryAttemptCount === 1) {\n  throw new Error(rawResponse.message ?? \"A recoverable query-generation error occurred.\");\n}\n\nconst response = {\n  status: \"error\",\n  errorDetails: {\n    message: rawResponse.message ?? \"A recoverable query-generation error occurred.\",\n    cause: getCause(rawResponse),\n    details: toErrorDetails(rawResponse)\n  },\n  state: inputState\n};\n\nreturn response;"
          },
          "outcomes": {
            "success": "1776127445397"
          },
          "code": "FIN_GL_CODE_CONSTRUCT_ANALYTIC_VIEW_QUERY_ERROR",
          "id": "1776234051591",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
