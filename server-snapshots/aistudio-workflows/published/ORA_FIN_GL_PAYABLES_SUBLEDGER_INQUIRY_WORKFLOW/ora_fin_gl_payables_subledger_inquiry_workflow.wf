        },
        {
          "metadata": {
            "errorNodeId": "1778057000005",
            "name": "Prepare Analytic View Data Payload",
            "returnType": "object",
            "sourceCode": "const buildHierarchyOverrideMap = (hierarchyOverrides) => {\n  const map = {};\n  const normalizeKey = (value) => String(value || \"\")\n    .replace(/([A-Z]+)([A-Z][a-z])/g, \"$1 $2\")\n    .replace(/([a-z0-9])([A-Z])/g, \"$1 $2\")\n    .replace(/[_-]+/g, \" \")\n    .replace(/[^a-zA-Z0-9]+/g, \" \")\n    .toLowerCase()\n    .trim()\n    .replace(/\\s+/g, \"\");\n  const add = (key, treeVersionName) => {\n    if (!key || !treeVersionName) return;\n    map[String(key)] = String(treeVersionName);\n    map[normalizeKey(key)] = String(treeVersionName);\n  };\n  if (Array.isArray(hierarchyOverrides)) {\n    for (const item of hierarchyOverrides) {\n      const treeVersionName = item?.treeVersionName || item?.treeVersion || item?.treeNameHyphenVersion || \"\";\n      add(item?.segmentCode, treeVersionName);\n      add(item?.dimensionName, treeVersionName);\n      add(item?.normalizedSegmentName, treeVersionName);\n      add(item?.segmentName, treeVersionName);\n    }\n  } else if (hierarchyOverrides && typeof hierarchyOverrides === \"object\") {\n    for (const [segmentCode, treeVersionName] of Object.entries(hierarchyOverrides)) {\n      add(segmentCode, treeVersionName);\n    }\n  }\n  return { map, normalizeKey };\n};\n\nconst applyHierarchyOverridesToExpandOnMember = (expandOnMember, hierarchyOverrides) => {\n  const { map, normalizeKey } = buildHierarchyOverrideMap(hierarchyOverrides);\n  if (!Object.keys(map).length || expandOnMember === undefined || expandOnMember === null || expandOnMember === \"\") {\n    return expandOnMember;\n  }\n  const resolveTreeVersion = (dimensionName) => map[String(dimensionName || \"\")] || map[normalizeKey(dimensionName)] || \"\";\n\n  if (typeof expandOnMember === \"string\") {\n    const text = expandOnMember.trim();\n    if (!text) return expandOnMember;\n    const wrapped = text.startsWith(\"(\") ? text : \"(\" + text;\n    const normalized = wrapped.endsWith(\")\") ? wrapped : wrapped + \")\";\n    const tuples = normalized.split(/\\)\\s*,\\s*\\(/).map((tuple) => tuple.replace(/^\\(/, \"\").replace(/\\)$/, \"\"));\n    const updatedTuples = tuples.map((tuple) => {\n      const parts = tuple.split(\"||\");\n      const treeVersionName = resolveTreeVersion((parts[0] || \"\").trim());\n      if (!treeVersionName) return tuple;\n      while (parts.length < 4) parts.push(\"\");\n      parts[3] = treeVersionName;\n      return parts.join(\"||\");\n    });\n    return updatedTuples.map((tuple) => \"(\" + tuple + \")\").join(\",\");\n  }\n\n  if (Array.isArray(expandOnMember)) {\n    return expandOnMember.map((item) => {\n      if (!item || typeof item !== \"object\") return item;\n      const dimensionName = item.dimensionName || item.segmentCode || item.normalizedSegmentName || item.segmentName || \"\";\n      const treeVersionName = resolveTreeVersion(dimensionName);\n      return treeVersionName ? { ...item, treeVersionInfo: treeVersionName } : item;\n    });\n  }\n\n  if (typeof expandOnMember === \"object\") {\n    const dimensionName = expandOnMember.dimensionName || expandOnMember.segmentCode || expandOnMember.normalizedSegmentName || expandOnMember.segmentName || \"\";\n    const treeVersionName = resolveTreeVersion(dimensionName);\n    return treeVersionName ? { ...expandOnMember, treeVersionInfo: treeVersionName } : expandOnMember;\n  }\n\n  return expandOnMember;\n};\n\nconst normalizeSortAlias = (value) => String(value ?? \"\").toLowerCase().replace(/[^a-z0-9]+/g, \"\");\nconst genericSortAliasSuffixes = new Set([\"account\", \"date\", \"status\", \"number\", \"amount\", \"type\"]);\nconst normalizeSortBy = (value) => {\n  const seen = new Set();\n  return (Array.isArray(value) ? value : []).reduce((result, item) => {\n    if (!item || typeof item !== \"object\" || Array.isArray(item)) return result;\n    const field = String(item.field ?? \"\").trim();\n    const key = normalizeSortAlias(field);\n    if (!field || seen.has(key)) return result;\n    seen.add(key);\n    result.push({ field, order: String(item.order ?? \"\").trim().toLowerCase() === \"desc\" ? \"desc\" : \"asc\" });\n    return result;\n  }, []);\n};\nconst mergeSortBy = (base, updates) => {\n  const result = normalizeSortBy(base);\n  const positions = new Map(result.map((item, index) => [normalizeSortAlias(item.field), index]));\n  for (const item of normalizeSortBy(updates)) {\n    const key = normalizeSortAlias(item.field);\n    if (positions.has(key)) result[positions.get(key)].order = item.order;\n    else { positions.set(key, result.length); result.push(item); }\n  }\n  return result;\n};\nconst splitSelectColumns = (value) => {\n  const columns = [];\n  let current = \"\";\n  let depth = 0;\n  let quote = \"\";\n  for (const character of String(value || \"\")) {\n    if (quote) { current += character; if (character === quote) quote = \"\"; }\n    else if (character === \"'\" || character === '\"') { quote = character; current += character; }\n    else if (character === \"(\") { depth += 1; current += character; }\n    else if (character === \")\") { depth = Math.max(0, depth - 1); current += character; }\n    else if (character === \",\" && depth === 0) { columns.push(current.trim()); current = \"\"; }\n    else current += character;\n  }\n  if (current.trim()) columns.push(current.trim());\n  return columns;\n};\nconst maskNestedSql = (value) => {\n  const sql = String(value || \"\");\n  const masked = Array(sql.length).fill(\" \");\n  let depth = 0;\n  let state = \"\";\n  for (let index = 0; index < sql.length; index += 1) {\n    const current = sql[index];\n    const next = sql[index + 1] || \"\";\n    if (state === \"single\" || state === \"double\") {\n      const quote = state === \"single\" ? \"'\" : '\"';\n      if (current === quote && next === quote) index += 1;\n      else if (current === quote) state = \"\";\n      continue;\n    }\n    if (state === \"line\") { if (current === \"\\n\" || current === \"\\r\") state = \"\"; continue; }