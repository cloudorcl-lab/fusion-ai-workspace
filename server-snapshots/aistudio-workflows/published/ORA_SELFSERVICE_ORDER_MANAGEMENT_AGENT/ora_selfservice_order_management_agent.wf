  "name": "SelfService Order Management Agent",
  "description": "Self Service Order Management Agent helps create orders, retrieve order details, and list orders using different criteria.\nIt provides a simple, guided way to manage order-related requests quickly and accurately.\n",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
