        {
          "metadata": {
            "name": "extractReqIdFromAppContext",
            "returnType": "array",
            "sourceCode": "// 1. Get the raw string\nvar appStr = $context.$triggers.REST.$input.OraAppContext || \"\";\n\n// 2. Normalize common \"bad\" patterns:\n//    - remove \"+ before a key\" like ,+\"issue\"  -> ,\"issue\"\n//    - keep \"+\" inside values (we'll convert those to spaces later)\nvar normalized = appStr.replace(/,\\s*\\+\\s*\"/g, ',\"');\n\n// 3. Extract requisitionId: \"requisitionId\":\"123\"\nvar reqMatch = normalized.match(/\"requisitionId\"\\s*:\\s*\"(\\d+)\"/);\nvar requisitionId = reqMatch ? reqMatch[1] : \"\";\n\n// 4. Extract issue: \"issue\":\"Value\"\nvar issueMatch = normalized.match(/\"issue\"\\s*:\\s*\"([^\"]*)\"/);\nvar rawIssue = issueMatch ? issueMatch[1] : \"\";\n\n// 5. Convert \"+\" in the issue value to spaces (e.g., Low+Volume -> Low Volume)\nvar cleanIssue = rawIssue.replace(/\\+/g, \" \").trim();\n\n// 6. Output object\nvar output = [ requisitionId];\n\n// 7. Return stringified (Agent Studio wraps it in { result: \"...\" })\nreturn JSON.stringify(output);"
          },
          "outcomes": {
            "success": "1768245392227"
          },
          "code": "EXTRACTREQIDFROMAPPCONTEXT",
          "id": "1768245351882",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
