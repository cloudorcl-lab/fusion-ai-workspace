          "code": "LOOPPERUNAVAILITEM",
          "id": "1772076870644",
          "inputs": [
            {
              "id": "1772076870645_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.ATRPERITEMCHECK.$output.result.UnAvailList}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "CurateSubItemsData",
            "returnType": "object",
            "sourceCode": "let unAvailList = $context.$nodes.ATRPERITEMCHECK.$output.result.UnAvailList;\nlet subItemsData = $context.$nodes.LOOPPERUNAVAILITEM.$output;  // subItemsData is a list of JSON objects, each with 'items'\n\nlet result = {\n  \"res\": false,        // Set default result to false\n  \"subcount\": 0,       // Number of unavailable items\n  \"Item\": [],      // Empty list to store all substitute items\n  \"subItemsCuratedList\": []  // Empty list to hold curated substitute items\n};\n\n// Loop through each item in unAvailList (the distinct items list)\nunAvailList.forEach((item, index) => {\n    // Ensure there's a corresponding subItemsData entry for this index\n    if (index < subItemsData.length) {\n        try {\n            // Parse the corresponding JSON string from subItemsData\n            let parsedItem = JSON.parse(subItemsData[index]);\n\n            // Check if parsedItem has a valid \"items\" array\n            if (parsedItem && Array.isArray(parsedItem.items) && parsedItem.items.length > 0) {\n                result.res = true;  // Set result to true as we found substitutes\n                // result.subcount += parsedItem.items.length;  // Increment substitute count\n                // result.subItems.push(...parsedItem.items);  // Add items to the substitute list\n                 result.Item = unAvailList[index].Item;\n                // Add curated information (Subinventory and ItemNumber) to subItemsCuratedList\n                parsedItem.items.forEach(substitute => {\n                    // Push only relevant data (Subinventory and ItemNumber) to curated list\n                    result.subItemsCuratedList.push({\n                        Subinventory: substitute.Subinventory,\n                        ItemNumber: substitute.ItemNumber,\n                        AvailableToTransactQuantity: substitute.AvailableToTransactQuantity,\n                        PrimaryUnitOfMeasure: substitute.PrimaryUnitOfMeasure\n                    });\n                });\n            }\n        } catch (error) {\n            console.error(`Error parsing subItem data at index ${index}:`, error);\n        }\n    }\n});\n\n// Convert the result object into a JSON string\nlet jsonString = JSON.stringify(result);\n\n// Return the final JSON string\nreturn jsonString;"
          },
          "outcomes": {
            "success": "1771496128936"
          },
          "code": "CURATESUBITEMSDATA",
