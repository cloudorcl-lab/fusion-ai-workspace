                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"description\": \"\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"OrganizationId\",\n          \"InventoryItemId\",\n          \"Subinventory\",\n          \"SubinventoryName\",\n          \"SubinventoryId\",\n          \"PrimaryUnitOfMeasureCode\",\n          \"RevisionQuantityControlFlag\",\n          \"PrimaryUnitOfMeasure\",\n          \"AvailableToTransactQuantity\",\n          \"SecondaryAvailableToTransactQuantity\",\n          \"ItemMinimumQuantity\",\n          \"SuggestedQuantityForReplenishment\",\n          \"InterSubinventoryParametersFlag\"\n        ],\n        \"properties\": {\n          \"OrganizationId\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"InventoryItemId\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"Subinventory\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"SubinventoryName\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"SubinventoryId\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"LocatorId\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"Locator\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"PrimaryUnitOfMeasureCode\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"Revision\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"RevisionQuantityControlFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"SecondaryUnitOfMeasureCode\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"PrimaryUnitOfMeasure\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"SecondaryUnitOfMeasure\": {\n            \"type\": \"object\",\n            \"properties\": {},\n            \"required\": []\n          },\n          \"AvailableToTransactQuantity\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"SecondaryAvailableToTransactQuantity\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"ItemMinimumQuantity\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"SuggestedQuantityForReplenishment\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"InterSubinventoryParametersFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"@context\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"key\": {\n                \"type\": \"string\",\n                \"minLength\": 1\n              }\n            },\n            \"required\": [\n              \"key\"\n            ]\n          }\n        }\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"href\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"name\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"kind\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ]\n}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "SummariseItemAvailabilitySnapshot",
                    "returnType": "object",
                    "sourceCode": "// Assuming 'itemsnapshot' is received for each item\nconst itemsnapshot =\n  $context.$nodes.GETONHANDAVAILPERITEM.GETEACHITEMSNAPSHOT.$output.items;\n\n//const onhandAvailSnapshot =\n // $context.$nodes.INITIALISEITEMSNAPSHOTVARVALUE.$output.result;\n\nconst onhandAvailSnapshot =\n $context.$variables.OnhandAvailSnapshot ;\n\n\n// Process each snapshot for a specific item and group them by InventoryItemId\nitemsnapshot.forEach(item => {\n\n  // Extract InventoryItemId from the current item snapshot\n  const inventoryItemId = item.InventoryItemId;\n\n  // Find if the InventoryItemId already exists in the result array\n  let inventoryItem =\n    onhandAvailSnapshot.OnhandAvailSnapshot.InventoryItems.find(\n      inventory => inventory.InventoryItemId === inventoryItemId\n    );\n\n  // If the InventoryItemId doesn't exist, create a new entry\n  if (!inventoryItem) {\n    inventoryItem = {\n      InventoryItemId: inventoryItemId,\n      Items: [] // Holds subinventory-level snapshots\n    };\n\n    // Add the new inventory item to the result\n    onhandAvailSnapshot.OnhandAvailSnapshot.InventoryItems.push(inventoryItem);\n  }\n\n  // Push the current item's subinventory details\n  inventoryItem.Items.push({\n    OrganizationId: item.OrganizationId,\n    Subinventory: item.Subinventory,\n    SubinventoryName: item.SubinventoryName,\n    SubinventoryId: item.SubinventoryId,\n    LocatorId: item.LocatorId,\n    Locator: item.Locator,\n    PrimaryUnitOfMeasureCode: item.PrimaryUnitOfMeasureCode,\n    Revision: item.Revision,\n    AvailableToTransactQuantity: item.AvailableToTransactQuantity,\n    \"@context\": item[\"@context\"]\n  });\n});\n\n$context.$variables.OnhandAvailSnapshot = onhandAvailSnapshot ;\n// Return the cumulative structured result\nreturn onhandAvailSnapshot;"
                  },
                  "outcomes": {
                    "success": "end_1771860237159"
                  },
                  "code": "SUMMARISEITEMAVAILABILITYSNAPSHOT",
                  "id": "1771860862404",
