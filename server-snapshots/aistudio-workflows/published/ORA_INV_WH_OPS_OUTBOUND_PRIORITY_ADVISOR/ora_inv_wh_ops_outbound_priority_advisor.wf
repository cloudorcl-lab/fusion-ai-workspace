            "returnType": "string",
            "sourceCode": "const context = $context.$triggers.REST.$input.context;\nconst appContext = $context.$app.$OraMessageHint;\n\nlet result = null;\n\nif (context === 'Query') {\n    result = context;\n} else if (appContext === 'InvokeAction') {\n    result = appContext;\n} \nreturn result;"
          },
