{
  "workflowId": "300000331058763",
  "workflowCode": "ORA_FIN_AP_PAYABLES_AGENT",
  "name": "Payables Agent",
  "description": "The Payables Agent supports invoice ingestion, PO and receipt matching, compliance and control execution, invoice inquiry, exception resolution, payment readiness, lifecycle activities, and supplier self-service. The solution combines ingestion using Document IO, user adaptive learning, workflow orchestration, policy-based controls, guided user experiences, and APIs to improve invoice accuracy, reduce manual effort, strengthen compliance, and accelerate exception resolution.",
