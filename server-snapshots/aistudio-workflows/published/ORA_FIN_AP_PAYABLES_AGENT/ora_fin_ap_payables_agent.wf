            "returnType": "object",
            "sourceCode": "return {\n  agent_response: [\n    {\n      display_type: \"text\",\n      display_sequence: 1,\n      text:\n        \"I cannot process the request at this time.\"\n    },\n    {\n      display_type: \"canvas\",\n      display_sequence: 2,\n      canvas_content: \"\"\n    }\n  ]\n};"
