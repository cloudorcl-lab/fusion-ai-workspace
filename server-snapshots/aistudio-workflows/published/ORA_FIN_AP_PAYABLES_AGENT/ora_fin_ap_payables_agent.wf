        {
          "metadata": {
            "name": "Format Output Valid",
            "returnType": "object",
            "sourceCode": "const nodeOut = $context.$nodes.FIN_AP_INVOICE_INQUIRY_ASSISTANT.$output;\n\nlet childOutput = nodeOut?.output;\n\nif (typeof childOutput === \"string\") {\n  childOutput = JSON.parse(childOutput);\n}\n\nreturn childOutput?.result || childOutput;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "FIN_AP_FORMAT_OUTPUT_VALID",
          "id": "1777619571733",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
