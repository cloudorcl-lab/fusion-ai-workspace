        {
          "metadata": {
            "name": "Total Targetable Accounts",
            "returnType": "string",
            "sourceCode": "let result = \"0\";\ntry {\n  // Access items array safely from GET_CROSS_SELL_PRODUCTS_COUNT node output\n  const itemsForTotalCount = $context.$nodes?.GET_CROSS_SELL_PRODUCTS_COUNT?.$output?.items || [];\n\n  if (Array.isArray(itemsForTotalCount) && itemsForTotalCount.length > 0) {\n    // Access 'accounts' property from the first item\n    const accounts = itemsForTotalCount[0]?.accounts;\n    // Ensure accounts is a number, fallback to 0 if null/undefined or not a number\n    result = typeof accounts === 'number' ? String(accounts) : \"0\";\n  }\n} catch (error) {\n  result = \"0\";\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1765514487098"
          },
          "code": "TOTAL_TARGETABLE_ACCOUNTS",
          "id": "1779163100755",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
