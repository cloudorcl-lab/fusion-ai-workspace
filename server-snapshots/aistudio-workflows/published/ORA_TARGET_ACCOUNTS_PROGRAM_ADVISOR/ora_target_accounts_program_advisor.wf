        {
          "metadata": {
            "name": "Identify Form Action",
            "returnType": "string",
            "sourceCode": "const rawInput = $context.$triggers.REST.$input.OraAction;\n\nconst match = rawInput.match(/<oraFormSubmit\\s+id=[\"']([^\"']*)[\"'][^>]*>(.*?)<\\/oraFormSubmit>/s);\n\nif (match) {\n  const id = match[1];\n  const jsonString = match[2];\n\n  const obj = {\n    id: id,\n    json: jsonString\n  };\n\n  let action;\n\n  if (obj.id.includes(\"_accountIdList_\")) {\n    action = \"createOpportunity\";\n  } else {\n    action = \"createProgram\";\n  }\n\n  return action;\n}\n\nreturn null;"
          },
          "outcomes": {
            "success": "1765585408131"
          },
