        {
          "metadata": {
            "name": "Build Create Program Payload",
            "returnType": "object",
            "sourceCode": "let result = {};\n\ntry {\n  const rawInput = $context.$triggers.REST.$input.OraAction;\n\n  const match = rawInput.match(/<oraFormSubmit\\s+id=[\"']([^\"']*)[\"'][^>]*>(.*?)<\\/oraFormSubmit>/s);\n\n  if (!match) {\n    result = {};\n  } else {\n    const id = match[1];\n    const jsonString = match[2];\n\n    let ownedProductId = null;\n    let targetProductId = null;\n\n    if (id.includes(\"ownedProductId_\") && id.includes(\"_targetProductId_\")) {\n      ownedProductId = id.split(\"ownedProductId_\")[1].split(\"_targetProductId_\")[0];\n      targetProductId = id.split(\"_targetProductId_\")[1];\n    }\n\n    let attributes = {};\n\n    try {\n      const parsedArray = JSON.parse(jsonString);\n\n      attributes = parsedArray.reduce((acc, item) => {\n        acc[item.id] = item.value;\n        return acc;\n      }, {});\n    } catch (e) {\n      attributes = {};\n    }\n\n    const rows = $context.$nodes?.GET_OWNED_ACCOUNT_DETAILS_2?.$output?.items || [];\n    const firstRow = rows[0] || {};\n\n    let industriesValue = firstRow.industries;\n\n    if (!industriesValue) {\n      industriesValue = \"\";\n    } else if (typeof industriesValue === \"string\" && industriesValue.length > 255) {\n      let truncated = industriesValue.substring(0, 255);\n      const lastCommaIndex = truncated.lastIndexOf(\",\");\n\n      if (lastCommaIndex !== -1) {\n        truncated = truncated.substring(0, lastCommaIndex);\n      }\n\n      industriesValue = truncated;\n    }\n\n    let industriesArray = [];\n\n    if (Array.isArray(industriesValue)) {\n      industriesArray = industriesValue\n        .map(industry => String(industry).trim())\n        .filter(industry => industry);\n    } else if (typeof industriesValue === \"string\") {\n      industriesArray = industriesValue\n        .split(\",\")\n        .map(industry => industry.trim())\n        .filter(industry => industry);\n    }\n\n    const industryItems = industriesArray.map(industry => ({\n      key: \"industry\",\n      value: industry,\n      displayValue: industry\n    }));\n\n    const targetProductName = $context.$variables?.targetProductName || null;\n    const ownedProductName = $context.$nodes.RETRIEVE_FORM_PARAMETERS.$output.result.ownedProductName || null;\n\n    result = {\n      name: attributes.ProgramName || null,\n      objective: attributes.ProgramObjective || null,\n      externalCode: attributes.ExternalTrackingCode || null,\n      programAttributes: {\n        items: [\n          {\n            key: \"product\",\n            value: targetProductId,\n            displayValue: targetProductName\n          },\n          {\n            key: \"regions\",\n            value: \"all\",\n            displayValue: \"All\"\n          },\n          ...industryItems,\n          {\n            key: \"programType\",\n            value: \"cross-sell\",\n            displayValue: \"\"\n          },\n          {\n            key: \"ownedproduct\",\n            value: ownedProductId,\n            displayValue: ownedProductName\n          }\n        ]\n      }\n    };\n  }\n} catch (error) {\n  result = {};\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1765590652489"
          },
          "code": "BUILD_CREATE_PROGRAM_PAYLOAD",
          "id": "1765585687385",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 5004.5,
            "y": 8536
          }
        },
