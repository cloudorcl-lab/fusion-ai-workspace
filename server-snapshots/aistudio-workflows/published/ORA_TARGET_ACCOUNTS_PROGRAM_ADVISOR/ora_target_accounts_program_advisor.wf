        },
        {
          "metadata": {
            "name": "Determine Action",
            "returnType": "string",
            "sourceCode": "let action = undefined;\n\nif ($context.$triggers.REST.$input.OraAction.includes(\"reviewProgramBrief\"))\n  action = \"reviewProgramBrief\";\nelse if ($context.$triggers.REST.$input.OraAction.includes(\"showInsights\"))\n  action = \"showInsights\";\nelse if ($context.$triggers.REST.$input.OraAction.includes(\"reviewSalesReadyOpportunity\"))\n  action = \"reviewSalesReadyOpportunity\";\nelse if ($context.$triggers.REST.$input.OraAction.includes(\"sendAllOpportunitiesToSales\"))\n  action = \"sendAllOpportunitiesToSales\";\nelse if ($context.$triggers.REST.$input.OraAction.includes(\"oraFormSubmit\"))\n  action = \"oraFormSubmit\";\nelse if ($context.$triggers.REST.$input.OraAction.includes(\"createProgram\"))\n  action = \"createProgram\";\n\n\nreturn action;"
          },
          "outcomes": {
            "success": "1776888091165"
          },
          "code": "DETERMINE_ACTION",
          "id": "1765320444271",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
