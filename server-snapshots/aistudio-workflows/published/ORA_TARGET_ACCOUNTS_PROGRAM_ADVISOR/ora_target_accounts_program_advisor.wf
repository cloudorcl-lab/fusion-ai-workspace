              "id": "1765306278725_1",
              "name": "prompt",
              "type": "string",
              "value": "Use only the provided products data from:\n`{{$context.$nodes.RESTRICT_THE_ACCOUNTS.$output}}`\nwhere `ownedProductName` is the Existing Product name.\n\n* **3 high priority actionable insights** (or fewer if < 3 exist).\n\n\ngenerate high priority actionable insights for each row with these fields:\n\n  title: \"{{$context.$variables.targetProductName}} to <Existing Product> cross sell\",\n  shortDescription: \"Initiate a cross sell program for {{$context.$variables.targetProductName}}, targeting accounts that own <Existing Product>, to leverage strong fit and maximize revenue potential.\",\n  actionText: \"Create Program\",\n  priority: true,\n  followUpCommand: \"ora.Invoke(createProgram, createProgram({\\\"targetProductId\\\":\\\"{{$context.$variables.targetProductId}}\\\",\\\"ownedProductId\\\":\\\"<ownedProductId>\\\",\\\"ownedProductName\\\":\\\"<ownedProductName>\\\"}))\"\n"
            },
            {
