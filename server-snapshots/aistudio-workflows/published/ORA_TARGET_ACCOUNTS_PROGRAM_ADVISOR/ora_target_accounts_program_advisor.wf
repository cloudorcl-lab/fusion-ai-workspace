        },
        {
          "id": "1782124209795",
          "code": "PAGINATE_SALES_READY_ACCOUNTS",
          "type": "CODE",
          "metadata": {
            "name": "Paginate Sales Ready Accounts",
            "returnType": "object",
            "sourceCode": "let result = {\n  rows: [],\n  totalCount: 0,\n  displayedCount: 0,\n  pageNumber: 1,\n  pageSize: 7,\n  totalPages: 0,\n  startIndex: 0,\n  endIndex: 0,\n  hasNext: false,\n  hasPrevious: false,\n  nextPageNumber: 1,\n  previousPageNumber: 1,\n  displayedAccountIdList: \"\",\n  allAccountIdList: \"\"\n};\n\ntry {\n  const raw = $context.$nodes.GET_SALES_READY_ACCOUNTS?.$output;\n  const params = $context.$nodes.RETRIEVE_ACTION_PARAMETERS?.$output?.result || {};\n\n  const toRows = (value) => {\n    if (Array.isArray(value)) return value;\n    if (Array.isArray(value?.items)) return value.items;\n    if (Array.isArray(value?.result)) return value.result;\n    if (Array.isArray(value?.data)) return value.data;\n    if (Array.isArray(value?.result?.items)) return value.result.items;\n    return [];\n  };\n\n  const toNumber = (value) => {\n    if (typeof value === \"number\" && Number.isFinite(value)) return value;\n    if (value == null) return 0;\n    const parsed = Number.parseFloat(String(value).replace(/[^0-9.-]/g, \"\"));\n    return Number.isFinite(parsed) ? parsed : 0;\n  };\n\n  const positiveInteger = (value, fallback) => {\n    const parsed = Number.parseInt(value, 10);\n    return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;\n  };\n\n  const configuredPageSize = positiveInteger($context.$variables.salesReadyAccountsPageSize, 7);\n  const requestedPageSize = positiveInteger(params.pageSize, 0);\n\n  const sortedRows = toRows(raw)\n    .filter((row) => row && String(row.accountName || \"\").trim() !== \"\")\n    .sort((a, b) => {\n      const revenueDiff = toNumber(b.potentialRevenueAmount) - toNumber(a.potentialRevenueAmount);\n      if (revenueDiff !== 0) return revenueDiff;\n      const coverageDiff = toNumber(b.buyingGroupCoverage) - toNumber(a.buyingGroupCoverage);\n      if (coverageDiff !== 0) return coverageDiff;\n      return toNumber(b.buyingGroupEngagement) - toNumber(a.buyingGroupEngagement);\n    });\n\n  const pageSize = Math.min(25, Math.max(1, requestedPageSize || configuredPageSize));\n  const totalCount = sortedRows.length;\n  const totalPages = totalCount > 0 ? Math.ceil(totalCount / pageSize) : 0;\n  const pageNumber = Math.min(\n    Math.max(1, positiveInteger(params.pageNumber, 1)),\n    Math.max(totalPages, 1)\n  );\n  const zeroBasedStart = (pageNumber - 1) * pageSize;\n  const pageRows = sortedRows.slice(zeroBasedStart, zeroBasedStart + pageSize);\n\n  result = {\n    rows: pageRows,\n    totalCount,\n    displayedCount: pageRows.length,\n    pageNumber,\n    pageSize,\n    totalPages,\n    startIndex: pageRows.length ? zeroBasedStart + 1 : 0,\n    endIndex: zeroBasedStart + pageRows.length,\n    hasNext: pageNumber < totalPages,\n    hasPrevious: pageNumber > 1,\n    nextPageNumber: Math.min(pageNumber + 1, Math.max(totalPages, 1)),\n    previousPageNumber: Math.max(pageNumber - 1, 1),\n    displayedAccountIdList: pageRows.map((row) => row.accountId).filter(Boolean).join(\"##\"),\n    allAccountIdList: sortedRows.map((row) => row.accountId).filter(Boolean).join(\"##\")\n  };\n} catch (error) {\n  result.error = String(error?.message || error);\n}\n\nreturn result;"
          },
          "diagram": {
            "x": 5918.75,
            "y": 8314
          },
          "outcomes": {
            "success": "1765442748320"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_MESSAGES_LIST"
              ],
              "enableActions": true,
              "enableCommunications": false,
