        {
          "metadata": {
            "name": "Restrict the accounts",
            "returnType": "array",
            "sourceCode": "let result = [];\n\ntry {\n  const items = $context.$nodes?.FETCH_EXISTING_PRODUCTS?.$output?.items || [];\n\n  const fitCategoryOrder = { Strong: 1, Moderate: 2 };\n\n  const sortedItems = items\n    .filter(item => item.fitCategory === \"Strong\" || item.fitCategory === \"Moderate\")\n    .sort((a, b) => {\n      const fitA = fitCategoryOrder[a.fitCategory] || 99; // Default low priority if not found\n      const fitB = fitCategoryOrder[b.fitCategory] || 99;\n      if (fitA !== fitB) {\n        return fitA - fitB; // Strong first, then Moderate\n      }\n      return (b.accounts || 0) - (a.accounts || 0);\n    });\n\n  const formattedItems = sortedItems.slice(0, 3).map(item => {\n    const formattedItem = { ...item };\n    const arrValue = Number(item.potentialRevenueAmount) || 0;\n    if (arrValue >= 1000000000) {\n      formattedItem.arr = (arrValue / 1000000000).toFixed(2) + \"B\";\n    } else if (arrValue >= 1000000) {\n      formattedItem.arr = (arrValue / 1000000).toFixed(2) + \"M\";\n    } else {\n      formattedItem.arr = arrValue.toFixed(2);\n    }\n\n    // Process industries attribute: keep only first 10 comma-separated values\n    if (typeof item.industries === \"string\" && item.industries.trim() !== \"\") {\n      const industriesArray = item.industries.split(\",\").map(s => s.trim());\n      const firstTenIndustries = industriesArray.slice(0, 10);\n      formattedItem.industries = firstTenIndustries.join(\", \");\n    } else {\n      formattedItem.industries = \"\";\n    }\n\n    return formattedItem;\n  });\n\n  result = formattedItems;\n} catch (error) {\n  result = [];\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1765155339101"
          },
          "code": "RESTRICT_THE_ACCOUNTS",
          "id": "1776875373171",
