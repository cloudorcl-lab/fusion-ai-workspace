          "metadata": {
            "name": "Build Opportunity Payload",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  const rawInput = $context.$triggers?.REST?.$input?.OraAction || \"\";\n\n  const match = rawInput.match(/<oraFormSubmit\\s+id=[\"']([^\"']*)[\"'][^>]*>(.*?)<\\/oraFormSubmit>/s);\n\n  if (match) {\n    const id = match[1];\n    const jsonString = match[2];\n\n    const productId = id.split(\"productId_\")[1]?.split(\"_accountIdList_\")[0] || null;\n\n    const accountIdSegment = id.split(\"_accountIdList_\")[1]?.split(\"_ownedProductName_\")[0] || \"\";\n    const accountIds = accountIdSegment ? accountIdSegment.split(\"##\") : [];\n\n    // Create items array with required structure for each accountId\n    const items = accountIds.map(accountId => ({\n      \"$operation\": \"CREATE\",\n      \"targetAccountIdentifier\": accountId,\n      \"productIdentifier\": productId,\n      \"descriptionText\": \"Sales ready account with Buying Group Contact Coverage >= 40% and Buying Group Engagement Converage >= 40%\"\n    }));\n\n    result = { items };\n  } else {\n    result = { items: [] };\n  }\n} catch (error) {\n  result = { items: [] };\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1765585530645"
          },
