          "code": "IS_FORM_SUBMIT",
          "convergenceTargetId": "1765320566106",
          "id": "1776888091165",
          "inputs": [
            {
              "id": "1776888091165_condition",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.DETERMINE_ACTION.$output.result=='oraFormSubmit'}}"
            }
          ],
          "type": "CONDITION",
          "diagram": {
            "x": 6194,
            "y": 6982
          }
        },
        {
          "metadata": {
            "name": "Retrieve Action Parameters",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  const payload = $context.$triggers.REST.$input.OraAction;\n  let obj = {};\n\n  const parseTextPayload = (value) => {\n    let text = String(value || \"\").trim();\n    const invokeMatch = text.match(/^ora\\.Invoke\\(\\s*[\"'][^\"']+[\"']\\s*,\\s*([\"'])([\\s\\S]*)\\1\\s*\\)\\s*$/);\n    if (invokeMatch && invokeMatch[2]) {\n      text = invokeMatch[2];\n    }\n\n    for (let i = 0; i < 3; i++) {\n      text = text.replace(/\\\\\"/g, '\"');\n    }\n\n    const fnMatch = text.match(/^[^(]+\\(\\s*(\\{[\\s\\S]*\\})\\s*\\)\\s*$/);\n    if (fnMatch && fnMatch[1]) {\n      text = fnMatch[1];\n    }\n\n    text = text.replace(/\"\"(\\w+)\"\"/g, '\"$1\"');\n    text = text.replace(/:\\s*\"\"([^\"]+)\"\"/g, ': \"$1\"');\n\n    let parsed = JSON.parse(text);\n    if (typeof parsed === \"string\") {\n      parsed = JSON.parse(parsed);\n    }\n    return parsed && typeof parsed === \"object\" ? parsed : {};\n  };\n\n  if (payload != null) {\n    if (typeof payload === \"object\") {\n      obj = payload;\n    } else {\n      obj = parseTextPayload(payload);\n    }\n  }\n\n  const cleanString = (val) => {\n    if (val == null) return null;\n    if (typeof val === \"number\" || typeof val === \"boolean\") return String(val);\n    if (typeof val !== \"string\") return null;\n    const cleaned = val.replace(/^\"+|\"+$/g, \"\").trim();\n    return cleaned === \"\" ? null : cleaned;\n  };\n\n  const positiveInteger = (val, fallback) => {\n    const cleaned = cleanString(val);\n    const parsed = Number.parseInt(cleaned == null ? val : cleaned, 10);\n    return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;\n  };\n\n  result = {\n    targetProductId: cleanString(obj.targetProductId),\n    ownedProductId: cleanString(obj.ownedProductId),\n    ownedProductName: cleanString(obj.ownedProductName),\n    accountIdList: cleanString(obj.accountIdList),\n    pageNumber: positiveInteger(obj.pageNumber, 1),\n    pageSize: positiveInteger(obj.pageSize, null)\n  };\n} catch (error) {\n  result = {\n    targetProductId: null,\n    ownedProductId: null,\n    ownedProductName: null,\n    accountIdList: null,\n    pageNumber: 1,\n    pageSize: null\n  };\n}\n\nreturn result;"
          },
