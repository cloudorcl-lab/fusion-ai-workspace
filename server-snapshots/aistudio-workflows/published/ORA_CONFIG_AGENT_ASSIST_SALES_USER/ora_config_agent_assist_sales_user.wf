            "name": "Filter Fam level Results With Threshold",
            "returnType": "string",
            "sourceCode": "const retrievedDocuments = $context.$nodes.READ_FAMILY_LEVEL_RESULTS.$output;\n\nconst vectorScoreThreshold =\n  (typeof $context.$variables.vectorScoreThreshold === \"number\")\n    ? $context.$variables.vectorScoreThreshold\n    : null;\n\nconst textScoreThreshold =\n  (typeof $context.$variables.textScoreThreshold === \"number\")\n    ? $context.$variables.textScoreThreshold\n    : null;\n\nlet bestVectorDoc = null;\nlet bestVectorScore = -Infinity;\n\nlet bestTextDoc = null;\nlet bestTextScore = -Infinity;\n\nfor (let i = 0; i < retrievedDocuments.length; i++) {\n  const doc = retrievedDocuments[i];\n\n  if (\n    typeof doc.vectorSearchScore === \"number\" &&\n    doc.vectorSearchScore !== -1 &&\n    (vectorScoreThreshold === null || doc.vectorSearchScore >= vectorScoreThreshold)\n  ) {\n    if (doc.vectorSearchScore > bestVectorScore) {\n      bestVectorScore = doc.vectorSearchScore;\n      bestVectorDoc = doc;\n    }\n  }\n\n  if (\n    typeof doc.textSearchScore === \"number\" &&\n    doc.textSearchScore !== -1 &&\n    (textScoreThreshold === null || doc.textSearchScore >= textScoreThreshold)\n  ) {\n    if (doc.textSearchScore > bestTextScore) {\n      bestTextScore = doc.textSearchScore;\n      bestTextDoc = doc;\n    }\n  }\n}\n\n// Prefer vector best; otherwise fall back to text best\nconst bestDoc = bestVectorDoc !== null ? bestVectorDoc : bestTextDoc;\n\nconst output = {\n  bestResult: bestDoc,\n  text: bestDoc ? bestDoc.text : \"\",\n  chosenBy: bestVectorDoc !== null ? \"vector\" : (bestTextDoc !== null ? \"text\" : \"none\")\n};\n\nreturn output;"
