              "type": "string",
              "value": "{{\"_allProductFamilies_\"+ $context.$triggers.REST.$input.productFamName+\"_\"+$context.$triggers.REST.$input.productLineName+\"_\"+$context.$triggers.REST.$input.modelName}}"
            },
