                    "returnType": "object",
                    "sourceCode": "const finder = \"findSupplyDetails;bindSupplySourceTypeId=\" + $context.$variables.SupplySourceTypeId + \",bindInventoryItemId=\" + $context.$nodes.CREATE_RSV_FOR_LINE.$currentItem.InventoryItemId + \",bindOrganizationId=\" + $context.$variables.OrganizationId + \",bindOrderedUOM='ORDERED'\";\nconst query = \"q=TotalAtr > 0\";\nreturn { \"finder\": finder, \"query\": query }"
                  },
                  "outcomes": {
                    "success": "1762988017256"
                  },
                  "code": "CA_SUPPLY_LINES_FINDER_BUILDER",
