                    "sourceCode": "const res = $context.$nodes.CREATE_RSV_FOR_LINE.CA_AUTORESERVE_BO.$output ;\nconst nextActions = [\n  \"View all reservations for this demand\",\n  \"Update/Delete reservations\",\n  \"Return to home\"\n];\nconst modified_res = {\n    \"data\": res,\n    \"error\": \"\",\n    \"status\": \"success\",\n    \"header\": \"Auto-reserve Flow\",\n    \"formatted\": false,\n    \"deeplink\": $context.$nodes.CREATE_RSV_FOR_LINE.AUTO_RESERVATION_DEEPLINK.$output ?? null,\n    nextActions\n}\nreturn modified_res;"
                  },
