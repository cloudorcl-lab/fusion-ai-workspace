            "sourceCode": "const res = $context.$nodes.CA_IMR_CREATE_RESERVATIONS_BO.$output;\nconst nextActions = [\n  \"Review remaining unreserved lines for the demand?\",\n  \"View all reservations for this demand\",\n  \"Update/Delete reservations\",\n  \"Return to home\"\n];\nconst modified_res = {\n    \"data\": res,\n    \"error\": \"\",\n    \"header\": \"Detailed Reservation Flow\",\n    \"status\": \"success\",\n    \"formatted\": false,\n    \"deeplink\": $context.$nodes.RESERVATION_DEEPLINK.$output,\n    nextActions\n}\nreturn modified_res;"
          },
          "outcomes": {
            "success": "end"
          },
