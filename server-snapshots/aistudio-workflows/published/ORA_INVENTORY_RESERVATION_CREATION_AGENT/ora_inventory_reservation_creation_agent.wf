                  },
                  "code": "CA_VERIFY_ONHAND_BO",
                  "id": "1763076205867",
                  "inputs": [
                    {
                      "id": "1763078061501_1",
                      "name": "pFinder",
                      "type": "string",
                      "value": "{{$context.$nodes.CREATE_RSV_FOR_LINE.BUILD_VERIFY_ON_HAND_FINDER.$output.result.finder}}"
