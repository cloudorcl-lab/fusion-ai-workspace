                    "name": "CA No Unreserved Line Formatter",
                    "returnType": "object",
                    "sourceCode": "const modified_res = {\n    \"data\": \"\",\n    \"error\": \"Unfortunately the line:\" + $context.$nodes.CREATE_RSV_FOR_LINE.$currentItem?.DemandSourceLineNumber ?? $context.$nodes.CREATE_RSV_FOR_LINE.$currentItem.OperationSequenceNumber+ \" is already reserved for the following demand document:\" + $context.$nodes.CREATE_RSV_FOR_LINE.$currentItem.DemandSourceHeaderNumber,\n    \"status\": \"failure\",\n    \"header\": \"No Unreserved Line Flow\",\n    \"formatted\": true\n}\nreturn modified_res;"
