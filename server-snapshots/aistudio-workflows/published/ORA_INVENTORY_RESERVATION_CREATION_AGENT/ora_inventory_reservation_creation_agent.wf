                  "metadata": {
                    "name": "Build Verify On Hand Params",
                    "returnType": "object",
                    "sourceCode": "const finder = \"FindByDemandAndUOMType;bindDemandSourceTypeId=\" + $context.$variables.DemandSourceTypeId + \n\",bindDemandSourceHeaderId=\" + $context.$nodes.CREATE_RSV_FOR_LINE.$currentItem.DemandSourceHeaderId;\n\nconst DemandSourceTypeId = $context.$triggers.REST.$input.DemandSourceTypeId;\nlet query = \"OrganizationId=\" + $context.$variables.OrganizationId + \n\" and InventoryItemId=\" + $context.$nodes.CREATE_RSV_FOR_LINE.$currentItem.InventoryItemId + \n\" and DemandSourceTypeId=\" + $context.$triggers.REST.$input.DemandSourceTypeId + \n\" and DemandSourceLineNumber='\" + $context.$nodes.CREATE_RSV_FOR_LINE.$currentItem.DemandSourceLineNumber + \"'\";\n\nif (DemandSourceTypeId == 5) {\n  query = \"OrganizationId=\" + $context.$variables.OrganizationId + \n  \" and InventoryItemId=\" + $context.$nodes.CREATE_RSV_FOR_LINE.$currentItem.InventoryItemId + \n  \" and DemandSourceTypeId=\" + $context.$triggers.REST.$input.DemandSourceTypeId + \n  \" and OperationSequenceNumber='\" + $context.$nodes.CREATE_RSV_FOR_LINE.$currentItem.OperationSequenceNumber + \"'\";\n}\n\nconst params = {\n  finder: finder,\n  query: query\n};\n\nreturn params;"
                  },
                  "outcomes": {
                    "success": "1763076205867"
                  },
                  "code": "BUILD_VERIFY_ON_HAND_FINDER",
                  "id": "1771886163343",
                  "inputs": [],
