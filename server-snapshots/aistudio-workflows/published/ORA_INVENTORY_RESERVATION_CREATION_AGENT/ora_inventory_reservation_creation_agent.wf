                    "returnType": "array",
                    "sourceCode": "const numberOfRecords = $context.$nodes.CREATE_RSV_FOR_LINE.CA_GET_SUPPLY_LINES.$output.items.length;\nlet recommendations = [\n  \"Select a supply line from the above table to reserve the current demand\",\n  \"Cancel\"\n];\n\nlet error = \"\";\n\nif (numberOfRecords == 0) {\n  recommendations = []\n  error = \"No Supply Lines are available for the following demand line: \" + $context.$nodes.CREATE_RSV_FOR_LINE.$currentItem.DemandSourceLineNumber\n}\n\nconst output = {\n  recommendations,\n  error\n}\n\nreturn output;"
                  },
