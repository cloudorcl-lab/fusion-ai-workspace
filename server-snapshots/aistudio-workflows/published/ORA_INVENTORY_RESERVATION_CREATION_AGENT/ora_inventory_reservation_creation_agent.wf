                    }
                  ],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"SupplySourceTypeId\": { \"type\": \"string\" },\n          \"ItemNumber\": { \"type\": \"string\" },\n          \"OrganizationCode\": { \"type\": \"string\" },\n          \"SupplySourceHeaderId\": { \"type\": \"string\" },\n          \"SupplySourceLineId\": { \"type\": \"string\" },\n          \"SupplySourceHeaderNumber\": { \"type\": \"string\" },\n          \"SupplySourceLineNumber\": { \"type\": \"string\" },\n          \"InventoryItemId\": { \"type\": \"string\" },\n          \"OrganizationId\": { \"type\": \"string\" },\n          \"ProjectId\": { \"type\": [\"null\", \"string\"] },\n          \"TaskId\": { \"type\": [\"null\", \"string\"] },\n          \"ProjectNumber\": { \"type\": [\"null\", \"string\"] },\n          \"TaskNumber\": { \"type\": [\"null\", \"string\"] },\n          \"SupplierName\": { \"type\": [\"null\", \"string\"] },\n          \"SourceOrganizationId\": { \"type\": \"string\" },\n          \"SourceOrganizationCode\": { \"type\": \"string\" },\n          \"TotalAtr\": { \"type\": \"string\" },\n          \"PrimaryUOMCode\": { \"type\": \"string\" },\n          \"ReservedQuantity\": { \"type\": \"string\" },\n          \"ExpectedDate\": { \"type\": \"string\", \"format\": \"date-time\" },\n          \"ExpectedDeliveryDate\": { \"type\": \"string\" },\n          \"ReservationStatus\": { \"type\": \"string\" },\n          \"ReservationStatusCode\": { \"type\": \"string\" },\n          \"SecondaryUOMName\": { \"type\": \"string\" }\n        }\n      }\n    },\n    \"count\": { \"type\": \"integer\" },\n    \"hasMore\": { \"type\": \"boolean\" },\n    \"limit\": { \"type\": \"integer\" },\n    \"offset\": { \"type\": \"integer\" },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": { \"type\": \"string\" },\n          \"href\": { \"type\": \"string\" },\n          \"name\": { \"type\": \"string\" },\n          \"kind\": { \"type\": \"string\" }\n        }\n      }\n    }\n  }\n}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "CA Format Supply Lines",
                    "returnType": "object",
                    "sourceCode": "const res = $context.$nodes.CREATE_RSV_FOR_LINE.CA_GET_SUPPLY_LINES.$output.items;\nconst supply = $context.$nodes.CREATE_RSV_FOR_LINE.CA_SUPPLY_LINES_SUGGESTIONS.$output.result;\nconst modified_res = res.map(item => {\n  return {\n    \"ItemNumber\": item.ItemNumber,\n    \"SupplySourceHeaderNumber\": item.SupplySourceHeaderNumber,\n    \"SupplySourceLineNumber\": item.SupplySourceLineNumber,\n    \"TotalAtr\": item.TotalAtr,\n    \"ExpectedDate\": item.ExpectedDate,\n    \"ReservationStatus\": item.ReservationStatus\n  };\n});\nconst supplyInfo = {\n  \"SupplyLines\": modified_res,\n  \"DemandSourceHeaderNumber\": $context.$nodes.CREATE_RSV_FOR_LINE.$currentItem.DemandSourceHeaderNumber,\n  \"DemandSourceLineNumber\": $context.$nodes.CREATE_RSV_FOR_LINE.$currentItem.DemandSourceLineNumber,\n  \"DemandSourceTypeId\": $context.$variables.DemandSourceTypeId,\n  \"UOM\": $context.$nodes.CREATE_RSV_FOR_LINE.$currentItem.ReservationUnitOfMeasure\n}\nconst output = {\n    \"data\": supplyInfo,\n    \"nextActions\": supply.recommendations,\n    \"error\": supply.error,\n    \"header\": \"Supply Line Options\",\n    \"status\": \"success\",\n    \"formatted\": false\n};\nreturn output"
                  },
                  "outcomes": {
                    "success": "end_1762552070743"
                  },
                  "code": "CA_TEST1",
