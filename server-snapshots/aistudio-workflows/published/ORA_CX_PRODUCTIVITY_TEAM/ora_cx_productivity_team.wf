            "name": "Supervisor",
            "returnType": "object",
            "sourceCode": "let parsed = $context.$triggers.REST.$input.data\nconst workflowcode_str = $context.$variables.validworkflowcode;\nconst valid_workflowcode = workflowcode_str.split(',');\nif (!parsed.workflowcode || !parsed.payload) {\n  return 'The workflowcode and payload is required'\n} else if (!valid_workflowcode.includes(parsed.workflowcode)) {\n  return  `Invalid workflowcode. Supported codes:${valid_workflowcode.join(',')}`\n}\nreturn parsed;"
          },
          "outcomes": {
            "success": "1764657216054"
          },
          "code": "SUPERVISOR",
          "id": "1764649630956",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
