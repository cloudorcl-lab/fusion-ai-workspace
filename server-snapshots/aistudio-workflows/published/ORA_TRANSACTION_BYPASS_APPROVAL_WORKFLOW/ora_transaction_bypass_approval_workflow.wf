              "id": "1763971873396_1",
              "name": "prompt",
              "type": "string",
              "value": "Take this response as input {{$context.$nodes.PROCESS_ID_FINDER.$output}}\n\nFrom this response try to find the object which contains process name {{$context.$nodes.PROCESS_IDENTIFIER.$output.processName}} and return the process id,  approvalOptionsId, TransactionModuleIdentifier and TransactionSubModuleIdentifier from the same object. \n\nIncase process id is not found then return an empty string."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"ProcessIdString\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"processId\": { \"type\": \"string\" },\n    \"TransactionModuleIdentifier\": { \"type\": \"string\" },\n    \"TransactionSubModuleIdentifier\": { \"type\": \"string\" },\n    \"approvalOptionsId\": { \"type\": \"string\" }\n  },\n  \"required\": [\"processId\", \"TransactionModuleIdentifier\", \"TransactionSubModuleIdentifier\", \n    \"approvalOptionsId\"],\n  \"additionalProperties\": false\n}",
          "type": "LLM"
        },
