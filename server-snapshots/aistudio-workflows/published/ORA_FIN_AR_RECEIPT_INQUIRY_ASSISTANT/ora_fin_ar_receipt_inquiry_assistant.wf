        {
          "metadata": {
            "name": "createFinalData",
            "returnType": "object",
            "sourceCode": "function buildReceiptSummary() {\n  const receiptData = $context.$variables.receiptData;\n\n  const referenceData =\n    $context.$nodes.EXTRACTREMITREFERENCE &&\n    $context.$nodes.EXTRACTREMITREFERENCE.$output;\n\n  const applicationData =\n    $context.$nodes.EXTRACTAPPLICATIONDATA &&\n    $context.$nodes.EXTRACTAPPLICATIONDATA.$output;\n\n  function safeParse(input, fallback) {\n    if (input === null || input === undefined) return fallback;\n\n    if (typeof input === \"string\") {\n      const trimmed = input.trim();\n\n      if (\n        trimmed === \"\" ||\n        trimmed === \"null\" ||\n        trimmed === \"undefined\"\n      ) {\n        return fallback;\n      }\n\n      try {\n        return JSON.parse(trimmed);\n      } catch (e) {\n        return fallback;\n      }\n    }\n\n    return input;\n  }\n\n  function isPresent(value) {\n    return value !== null && value !== undefined && String(value).trim() !== \"\";\n  }\n\n  function getField(rec, fieldName) {\n    if (!rec || typeof rec !== \"object\") return \"\";\n    return Object.prototype.hasOwnProperty.call(rec, fieldName) ? rec[fieldName] : \"\";\n  }\n\n  function getReceiptSource(rec) {\n  const statementLineId = getField(rec, \"STATEMENTLINEID\");\n  const sourceCode = getField(rec, \"RECEIPTSOURCECODE\");\n  const lockboxId = getField(rec, \"RECEIPTBATCHLOCKBOXID\");\n\n  if (isPresent(statementLineId)) return \"Bank Statement\";\n\n  if (sourceCode === \"ARCABP\") {\n    return isPresent(lockboxId) ? \"Lockbox\" : \"Spreadsheet\";\n  }\n\n  if (sourceCode === \"ADFBc\" || sourceCode === \"UI\") return \"Manual\";\n  if (sourceCode === \"RestService\") return \"Rest API\";\n  if (sourceCode === \"HED\") return \"Higher Education\";\n  if (sourceCode === \"SERVICE\" || sourceCode === \"Service\") return \"Web Service\";\n  if (sourceCode === \"IREC\") return \"Bill Management\";\n  if (sourceCode === \"AUTORECAPI\" || sourceCode === \"AUTORECAPI2\") return \"Automatic Receipt\";\n  if (String(sourceCode).indexOf(\"IEXPAY\") === 0) return \"Collections\";\n\n  return \"Others\";\n}\n\n  const parsed = safeParse(receiptData, { records: [], recordCount: 0 });\n  const refParsed = safeParse(referenceData, []);\n  const appParsed = safeParse(applicationData, []);\n\n  const FIELD_ORDER = [\n    \"CASHRECEIPTID\",\n    \"CUSTOMERNAME\",\n    \"CUSTOMERACCOUNTNUMBER\",\n    \"RECEIPTNUMBER\",\n    \"RECEIPTDATE\",\n    \"RECEIPTMETHODNAME\",\n    \"AMOUNTREMAINING\",\n    \"RECEIPTCURRENCYCODE\",\n    \"BANKNAME\",\n    \"BUSINESSUNITNAME\",\n    \"RECEIPTSOURCE\"\n  ];\n\n  const records = Array.isArray(parsed.records) ? parsed.records : [];\n\n  const MAX_RECEIPTS = 500;\n  const MAX_APPLICATIONS = 500;\n\n  const limitedRecords = records.slice(0, MAX_RECEIPTS);\n\n  const receipts = limitedRecords.map(function (rec) {\n    const ordered = {};\n    const receiptSource = getReceiptSource(rec);\n\n    for (const field of FIELD_ORDER) {\n      if (field === \"RECEIPTSOURCE\") {\n        ordered[field] = receiptSource;\n      } else {\n        ordered[field] = rec && rec[field] !== undefined ? rec[field] : null;\n      }\n    }\n\n    return ordered;\n  });\n\n  const refArray = Array.isArray(refParsed)\n    ? refParsed\n    : refParsed\n      ? [refParsed]\n      : [];\n\n  const refRecord = refArray.length > 0 ? refArray[0] : null;\n\n  const referenceParts = [];\n\n  if (refRecord) {\n    if (refRecord.INVOICEREFERENCE != null) {\n      referenceParts.push(\"Invoice Reference - \" + refRecord.INVOICEREFERENCE);\n    }\n\n    if (refRecord.PURCHASEORDERNUMBER != null) {\n      referenceParts.push(\"Purchase Order# - \" + refRecord.PURCHASEORDERNUMBER);\n    }\n\n    if (refRecord.WAYBILLNUMBER != null) {\n      referenceParts.push(\"Waybill # - \" + refRecord.WAYBILLNUMBER);\n    }\n\n    if (refRecord.SALESORDER != null) {\n      referenceParts.push(\"Sales Order# - \" + refRecord.SALESORDER);\n    }\n\n    if (refRecord.CONTRACTNUMBER != null) {\n      referenceParts.push(\"Contract# - \" + refRecord.CONTRACTNUMBER);\n    }\n\n    if (refRecord.BALANCEFWDBILLNUMBER != null) {\n      referenceParts.push(\"Balance Forward Bill# - \" + refRecord.BALANCEFWDBILLNUMBER);\n    }\n\n    if (refRecord.STRUCTUREDPAYMENTREFERENCE != null) {\n      referenceParts.push(\"Purchase Order - \" + refRecord.STRUCTUREDPAYMENTREFERENCE);\n    }\n  }\n\n  const reference = referenceParts.join(\" | \");\n\n  const appArray = Array.isArray(appParsed)\n    ? appParsed.slice(0, MAX_APPLICATIONS)\n    : appParsed\n      ? [appParsed]\n      : [];\n\n  return {\n    count: parsed.recordCount || records.length,\n    receipts: receipts,\n    application: appArray,\n    reference: reference\n  };\n}\n\nreturn buildReceiptSummary();"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "CREATEFINALDATA",
          "convergenceTargetId": "1779391731816",
          "id": "1776991975223",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
