            {
              "id": "1769896971754",
              "name": "ReceiptAttributeCatalog",
              "scope": "JOB",
              "type": "object",
              "value": "{\n  \"attributeCatalog\": {\n    \"_meta\": {\n      \"contractVersion\": \"1.0\",\n      \"source\": \"CashReceiptBO\"\n    },\n    \"attributes\": [\n      {\n        \"attributeName\": \"cashReceiptId\",\n        \"description\": \"Unique cash receipt identifier\",\n        \"dataType\": \"Integer\"\n      },\n      {\n        \"attributeName\": \"receiptDate\",\n        \"description\": \"Receipt date\",\n        \"dataType\": \"Date\"\n      },\n      {\n        \"attributeName\": \"depositDate\",\n        \"description\": \"Deposit date for the receipt\",\n        \"dataType\": \"Date\"\n      },\n      {\n        \"attributeName\": \"receiptNumber\",\n        \"description\": \"Receipt number\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"type\",\n        \"description\": \"Receipt type code\",\n        \"dataType\": \"String\",\n        \"allowedValues\": [\n          {\n            \"code\": \"CASH\",\n            \"meaning\": \"Standard\"\n          },\n          {\n            \"code\": \"MISC\",\n            \"meaning\": \"Miscellaneous\"\n          }\n        ]\n      },\n      {\n        \"attributeName\": \"conversionRate\",\n        \"description\": \"Exchange rate used for currency conversion\",\n        \"dataType\": \"Number\"\n      },\n      {\n        \"attributeName\": \"conversionDate\",\n        \"description\": \"Date used to derive the exchange rate\",\n        \"dataType\": \"Date\"\n      },\n      {\n        \"attributeName\": \"cashReceiptStatus\",\n        \"description\": \"Receipt status code\",\n        \"dataType\": \"String\",\n        \"allowedValues\": [\n          {\n            \"code\": \"CORRECTED\",\n            \"meaning\": \"Corrected\"\n          },\n          {\n            \"code\": \"ERROR\",\n            \"meaning\": \"Error status\"\n          },\n          {\n            \"code\": \"APP\",\n            \"meaning\": \"Applied\"\n          },\n          {\n            \"code\": \"CCRR\",\n            \"meaning\": \"Credit card refund reversal\"\n          },\n          {\n            \"code\": \"CC_CHARGEBACK_REV\",\n            \"meaning\": \"Credit card chargeback reversal\"\n          },\n          {\n            \"code\": \"NSF\",\n            \"meaning\": \"Nonsufficient funds\"\n          },\n          {\n            \"code\": \"REV\",\n            \"meaning\": \"Reversal user error\"\n          },\n          {\n            \"code\": \"UNAPP\",\n            \"meaning\": \"Unapplied\"\n          },\n          {\n            \"code\": \"UNID\",\n            \"meaning\": \"Unidentified\"\n          },\n          {\n            \"code\": \"STOP\",\n            \"meaning\": \"Stopped payment\"\n          }\n        ]\n      },\n      {\n        \"attributeName\": \"receiptAmount\",\n        \"description\": \"Receipt amount\",\n        \"dataType\": \"Number\"\n      },\n      {\n        \"attributeName\": \"reversalDate\",\n        \"description\": \"Date the receipt was reversed\",\n        \"dataType\": \"Date\"\n      },\n      {\n        \"attributeName\": \"reversalCategory\",\n        \"description\": \"Receipt reversal category\",\n        \"dataType\": \"String\",\n        \"allowedValues\": [\n          {\n            \"code\": \"CCRR\",\n            \"meaning\": \"Credit card refund reversal\"\n          },\n          {\n            \"code\": \"CC_CHARGEBACK_REV\",\n            \"meaning\": \"Credit card chargeback reversal\"\n          },\n          {\n            \"code\": \"NSF\",\n            \"meaning\": \"Nonsufficient funds\"\n          },\n          {\n            \"code\": \"REV\",\n            \"meaning\": \"Reverse payment\"\n          },\n          {\n            \"code\": \"STOP\",\n            \"meaning\": \"Stop payment\"\n          }\n        ]\n      },\n      {\n        \"attributeName\": \"reversalComments\",\n        \"description\": \"Comments entered for the reversal\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"isSelectedForFactoring\",\n        \"description\": \"Indicator showing whether the receipt was selected for factoring\",\n        \"dataType\": \"String\",\n        \"allowedValues\": [\n          {\n            \"code\": \"Y\",\n            \"meaning\": \"Yes\"\n          },\n          {\n            \"code\": \"N\",\n            \"meaning\": \"No\"\n          }\n        ]\n      },\n      {\n        \"attributeName\": \"factorDiscountAmount\",\n        \"description\": \"Factoring or bank discount amount\",\n        \"dataType\": \"Number\"\n      },\n      {\n        \"attributeName\": \"recommendationCount\",\n        \"description\": \"Count of application recommendations for the receipt\",\n        \"dataType\": \"Integer\"\n      },\n      {\n        \"attributeName\": \"anticipatedClearingDate\",\n        \"description\": \"Anticipated clearing date for the receipt\",\n        \"dataType\": \"Date\"\n      },\n      {\n        \"attributeName\": \"documentNumber\",\n        \"description\": \"Document sequence value for the receipt\",\n        \"dataType\": \"Integer\"\n      },\n      {\n        \"attributeName\": \"timeUpdated\",\n        \"description\": \"Last update timestamp\",\n        \"dataType\": \"DateTime\"\n      },\n      {\n        \"attributeName\": \"timeCreated\",\n        \"description\": \"Creation timestamp\",\n        \"dataType\": \"DateTime\"\n      },\n      {\n        \"attributeName\": \"actualValueDate\",\n        \"description\": \"Actual bank value date\",\n        \"dataType\": \"Date\"\n      },\n      {\n        \"attributeName\": \"postmarkDate\",\n        \"description\": \"Receipt postmark date\",\n        \"dataType\": \"Date\"\n      },\n      {\n        \"attributeName\": \"reversalReasonLookupType\",\n        \"description\": \"Lookup type used for the reversal reason\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"reversalReasonLookupCategoryId\",\n        \"description\": \"Lookup category or reference-set identifier for the reversal reason\",\n        \"dataType\": \"Integer\"\n      },\n      {\n        \"attributeName\": \"reversalReasonLookupCode\",\n        \"description\": \"Lookup code for the reversal reason\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"reversalReasonMeaning\",\n        \"description\": \"Display meaning for the reversal reason lookup code\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"receiptCurrencyCode\",\n        \"description\": \"Receipt currency code\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"receiptCurrencyName\",\n        \"description\": \"Receipt currency name\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"currentCashReceiptHistoryId\",\n        \"description\": \"Identifier of the current cash receipt history row\",\n        \"dataType\": \"Integer\"\n      },\n      {\n        \"attributeName\": \"statusDate\",\n        \"description\": \"Transaction date of the current receipt history row\",\n        \"dataType\": \"Date\"\n      },\n      {\n        \"attributeName\": \"currentCashReceiptHistoryCurrentRecord\",\n        \"description\": \"Indicator showing whether the history row is the current record\",\n        \"dataType\": \"String\",\n        \"allowedValues\": [\n          {\n            \"code\": \"Y\",\n            \"meaning\": \"Yes\"\n          },\n          {\n            \"code\": \"N\",\n            \"meaning\": \"No\"\n          }\n        ]\n      },\n      {\n        \"attributeName\": \"ledgerCurrencyCode\",\n        \"description\": \"Ledger currency code\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"ledgerCurrencyName\",\n        \"description\": \"Ledger currency name\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"ledgerCurrencyPrecision\",\n        \"description\": \"Ledger currency precision\",\n        \"dataType\": \"Integer\"\n      },\n      {\n        \"attributeName\": \"legalEntityName\",\n        \"description\": \"Legal entity name\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"legalEntityIdentifier\",\n        \"description\": \"Legal entity identifier\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"legalEntityGeographyId\",\n        \"description\": \"Legal entity geography identifier\",\n        \"dataType\": \"Integer\"\n      },\n      {\n        \"attributeName\": \"legalEntityCountryCode\",\n        \"description\": \"Legal entity country or territory code\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"customerSiteAddress1\",\n        \"description\": \"Customer site address line 1\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"customerSiteAddress2\",\n        \"description\": \"Customer site address line 2\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"customerSiteAddress3\",\n        \"description\": \"Customer site address line 3\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"customerSiteAddress4\",\n        \"description\": \"Customer site address line 4\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"customerSiteCity\",\n        \"description\": \"Customer site city\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"customerSiteState\",\n        \"description\": \"Customer site state\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"customerSiteProvince\",\n        \"description\": \"Customer site province\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"customerSitePostalCode\",\n        \"description\": \"Customer site postal code\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"customerSiteAddressNumber\",\n        \"description\": \"Customer site address number or address identifier\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"customerSiteAddressName\",\n        \"description\": \"Customer site address display name\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"customerSiteCountryCode\",\n        \"description\": \"Customer site country or territory code\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"customerSiteCountryName\",\n        \"description\": \"Customer site country or territory short name\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"customerAccountId\",\n        \"description\": \"Customer account identifier\",\n        \"dataType\": \"Integer\"\n      },\n      {\n        \"attributeName\": \"customerAccountNumber\",\n        \"description\": \"Account number\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"customerName\",\n        \"description\": \"Customer Name\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"receiptMethodId\",\n        \"description\": \"Receipt method identifier\",\n        \"dataType\": \"Integer\"\n      },\n      {\n        \"attributeName\": \"receiptMethodName\",\n        \"description\": \"Receipt method name\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"receiptClassId\",\n        \"description\": \"Receipt class identifier\",\n        \"dataType\": \"Integer\"\n      },\n      {\n        \"attributeName\": \"receiptClassCreationMethodCode\",\n        \"description\": \"Receipt class creation method code\",\n        \"dataType\": \"String\",\n        \"allowedValues\": [\n          {\n            \"code\": \"AUTOMATIC\",\n            \"meaning\": \"Automatic\"\n          },\n          {\n            \"code\": \"BR\",\n            \"meaning\": \"Bill Receivables\"\n          },\n          {\n            \"code\": \"MANUAL\",\n            \"meaning\": \"Manual\"\n          },\n          {\n            \"code\": \"BR_REMIT\",\n            \"meaning\": \"Bills Receivable Remittance\"\n          },\n          {\n            \"code\": \"ORA_NETTING\",\n            \"meaning\": \"AP/AR Netting\"\n          }\n        ]\n      },\n      {\n        \"attributeName\": \"receiptBatchId\",\n        \"description\": \"Receipt batch identifier\",\n        \"dataType\": \"Integer\"\n      },\n      {\n        \"attributeName\": \"receiptBatchName\",\n        \"description\": \"Receipt batch name\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"receiptBatchDate\",\n        \"description\": \"Receipt batch date\",\n        \"dataType\": \"Date\"\n      },\n      {\n        \"attributeName\": \"bankAccountName\",\n        \"description\": \"Bank account name\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"bankAccountNumber\",\n        \"description\": \"Bank account number\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"bankBranchName\",\n        \"description\": \"Bank branch name\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"bankName\",\n        \"description\": \"Bank name\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"bankAccountCurrencyCode\",\n        \"description\": \"Bank account currency code\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"businessUnitId\",\n        \"description\": \"Business unit identifier\",\n        \"dataType\": \"Integer\"\n      },\n      {\n        \"attributeName\": \"businessUnitName\",\n        \"description\": \"Business unit name\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"paymentScheduleId\",\n        \"description\": \"Payment schedule identifier\",\n        \"dataType\": \"Integer\"\n      },\n      {\n        \"attributeName\": \"receiptInternalStatus\",\n        \"description\": \"Payment schedule installment status for the receipt\",\n        \"dataType\": \"String\",\n        \"allowedValues\": [\n          {\n            \"code\": \"CL\",\n            \"meaning\": \"Closed\"\n          },\n          {\n            \"code\": \"OP\",\n            \"meaning\": \"Open\"\n          }\n        ]\n      },\n      {\n        \"attributeName\": \"amountRemaining\",\n        \"description\": \"Remaining amount on the receipt payment schedule\",\n        \"dataType\": \"Number\"\n      },\n      {\n        \"attributeName\": \"amountRemainingOffset\",\n        \"description\": \"Remaining offset amount on the receipt payment schedule\",\n        \"dataType\": \"Number\"\n      },\n      {\n        \"attributeName\": \"amountOtherAccount\",\n        \"description\": \"Other-account amount on the receipt payment schedule\",\n        \"dataType\": \"Number\"\n      },\n      {\n        \"attributeName\": \"amountOnAccount\",\n        \"description\": \"On-account amount on the receipt payment schedule\",\n        \"dataType\": \"Number\"\n      },\n      {\n        \"attributeName\": \"conversionRateType\",\n        \"description\": \"Currency conversion rate type\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"statementLineId\",\n        \"description\": \"Bank statement line identifier\",\n        \"dataType\": \"Integer\"\n      },\n      {\n        \"attributeName\": \"statementLineAdditionalEntryInformation\",\n        \"description\": \"Additional entry information from the bank statement line\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"statementLineCheckNumber\",\n        \"description\": \"Check number from the bank statement line\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"statementLineStructuredPaymentReference\",\n        \"description\": \"Structured payment reference from the bank statement line\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"statementLineBookingDate\",\n        \"description\": \"Booking date of the bank statement line\",\n        \"dataType\": \"Date\"\n      },\n      {\n        \"attributeName\": \"receiptSourceCode\",\n        \"description\": \"Source code from the first posted cash receipt history record\",\n        \"dataType\": \"String\"\n      },\n      {\n        \"attributeName\": \"receiptBatchLockboxId\",\n        \"description\": \"Lockbox identifier from the receipt batch associated with the first posted cash receipt history record\",\n        \"dataType\": \"Integer\"\n      }\n    ]\n  }\n}"
