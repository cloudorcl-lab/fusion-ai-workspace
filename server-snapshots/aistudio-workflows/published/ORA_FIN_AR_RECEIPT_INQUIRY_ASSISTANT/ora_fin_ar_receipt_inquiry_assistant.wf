        {
          "metadata": {
            "name": "prepareAdditionalData",
            "returnType": "object",
            "sourceCode": "function buildDataShapeQueries() {\n  const cashReceiptId = $context.$nodes.PREPARERECEIPTDATA.$output.result.CASHRECEIPTID \n  const datashape    = $context.$variables.datashapes \n\n  const parsed =\n    typeof datashape === \"string\" ? JSON.parse(datashape) : datashape;\n\n  const shapeMap = {};\n  for (const shape of parsed.data_shapes) {\n    shapeMap[shape.name] = shape.value;\n  }\n\n  const targetNames = [\n    \"receivablesHistory\",\n    \"receivablesRemittanceReferenceDetail\"\n  ];\n\n  const result = targetNames.map((name) => {\n    const value = shapeMap[name];\n\n    if (!value) {\n      return { name, error: `Shape '${name}' not found` };\n    }\n\n    const resolvedSelect = value.select.replace(\n      /cash_receipt_id/g,\n      cashReceiptId\n    );\n\n    // Return object directly — no JSON.stringify wrapping\n    return {\n      name,\n      value: {\n        select: resolvedSelect,\n        viewQueries: value.viewQueries\n      }\n    };\n  });\n\n  return result;\n}\n\nconst output = buildDataShapeQueries();\nreturn output;"
          },
          "outcomes": {
            "success": "1776987771341"
          },
          "code": "PREPAREADDITIONALDATA",
