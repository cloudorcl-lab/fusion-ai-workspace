          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"Output\": {\n            \"type\": \"object\",\n            \"properties\": {}\n        }\n    }\n}",
