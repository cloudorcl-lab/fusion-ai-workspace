              "value": "{\n    \"data_shapes\": [\n        {\n            \"name\": \"receivablesReceiptDetail\",\n            \"value\": {\n                \"select\": \"SELECT customerName, customerAccountNumber, receiptNumber, receiptDate, (-1 * amountRemaining) AS AmountRemaining,'USD' receiptCurrency,businessUnitName FROM ReceivablesReceiptDetail order by amountRemaining desc\",\n                \"viewQueries\": {\n                    \"ReceivablesReceiptDetail\": {\n                        \"view\": \"receivablesReceiptDetail\",\n                        \"businessObject\": \"ReceivablesReceipt\",\n                        \"module\": \"oraErpCoreReceivablesPayments\",\n                        \"fieldAliases\": {\n                            \"cashReceiptId\": \"cashReceiptId\",\n                            \"receiptDate\": \"receiptDate\",\n                            \"depositDate\": \"depositDate\",\n                            \"receiptNumber\": \"receiptNumber\",\n                            \"type\": \"type\",\n                            \"conversionRate\": \"conversionRate\",\n                            \"conversionDate\": \"conversionDate\",\n                            \"status\": \"cashReceiptStatus\",\n                            \"receiptAmount\": \"receiptAmount\",\n                            \"reversalDate\": \"reversalDate\",\n                            \"reversalCategory\": \"reversalCategory\",\n                            \"reversalComments\": \"reversalComments\",\n                            \"anticipatedClearingDate\": \"anticipatedClearingDate\",\n                            \"documentNumber\": \"documentNumber\",\n                            \"timeCreated\": \"timeCreated\",\n                            \"timeUpdated\": \"timeUpdated\",\n                            \"actualValueDate\": \"actualValueDate\",\n                            \"postmarkDate\": \"postmarkDate\",\n                            \"factorDiscountAmount\": \"factorDiscountAmount\",\n                            \"isSelectedForFactoring\": \"isSelectedForFactoring\",\n                            \"recommendationCount\": \"recommendationCount\",\n                            \"currentCashReceiptHistory.transactionDate\": \"statusDate\",\n                            \"currentCashReceiptHistory.status\": \"receiptStatus\",\n                            \"currentCashReceiptHistory.currentRecord\": \"currentCashReceiptHistoryCurrentRecord\",\n                            \"customerAccount.customerAccountId\": \"customerAccountId\",\n                            \"customerAccount.accountNumber\": \"customerAccountNumber\",\n                            \"customerAccount.customer.name\": \"customerName\",\n                            \"receiptBatch.name\": \"receiptBatchName\",\n                            \"receiptBatch.batchDate\": \"receiptBatchDate\",\n                            \"bankAccountUse.bankAccount.name\": \"bankAccountName\",\n                            \"bankAccountUse.bankAccount.accountNumber\": \"bankAccountNumber\",\n                            \"bankAccountUse.bankAccount.bankBranch.name\": \"bankBranchName\",\n                            \"bankAccountUse.bankAccount.bankBranch.bank.name\": \"bankName\",\n                            \"businessUnit.id\": \"businessUnitId\",\n                            \"businessUnit.name\": \"businessUnitName\",\n                            \"paymentSchedule.paymentScheduleId\": \"paymentScheduleId\",\n                            \"paymentSchedule.installmentStatus\": \"receiptInternalStatus\",\n                            \"paymentSchedule.amountRemaining\": \"amountRemaining\",\n                            \"paymentSchedule.amountRemainingOffset\": \"amountRemainingOffset\",\n                            \"paymentSchedule.amountOtherAccount\": \"amountOtherAccount\",\n                            \"paymentSchedule.amountOnAccount\": \"amountOnAccount\",\n                            \"statementLine.id\": \"statementLineId\",\n                            \"statementLine.additionalEntryInformation\": \"statementLineAdditionalEntryInformation\",\n                            \"statementLine.checkNumber\": \"statementLineCheckNumber\",\n                            \"statementLine.structuredPaymentReference\": \"statementLineStructuredPaymentReference\",\n                            \"statementLine.bookingDate\": \"statementLineBookingDate\"\n                        }\n                    }\n                }\n            }\n        },\n        {\n            \"name\": \"receivablesHistory\",\n            \"value\": {\n  \"select\":  \"select rta.applicationType, rta.invoiceNumber, invoiceAmount,invoiceBalance,invCurrencyCode,rta.invoiceDueDate,rta.appliedAmount, rta.applicationDate  from ReceivablesReceiptDetail hr inner join receivablesTransactionApplication rta on hr.cashReceiptId = rta.cashReceiptId and rta.latestApplication = 'Y' where hr.cashreceiptid =cash_receipt_id order by applicationDate\",\n  \"viewQueries\": {\n    \"receivablesTransactionApplication\": {\n            \"view\": \"receivablesTransactionApplication\",\n            \"businessObject\": \"ReceivablesReceiptActivity\",\n            \"module\": \"oraErpCoreReceivablesBilling\",\n            \"fieldAliases\": {\n                \"appliedCustomerTransaction.transactionNumber\": \"invoiceNumber\",\n                \"appliedPaymentSchedule.installmentDueDate\": \"invoiceDueDate\",\n                \"appliedAmount\": \"appliedAmount\",\n                \"cashReceipt.cashReceiptId\": \"cashReceiptId\",\n                \"applicationDate\": \"applicationDate\",\n                \"latestApplication\": \"latestApplication\",\n                \"applicationType\": \"applicationType\",\n                \"appliedPaymentSchedule.amountRemaining\" : \"invoiceBalance\",\n                \"appliedPaymentSchedule.originalAmount\" : \"invoiceAmount\",\n                \"appliedPaymentSchedule.invoiceCurrency.currencyCode\": \"invCurrencyCode\"\n            }\n        },\n    \"ReceivablesReceiptDetail\": {\n      \"view\": \"receivablesReceiptDetail\",\n      \"businessObject\": \"ReceivablesReceipt\",\n      \"module\": \"oraErpCoreReceivablesPayments\",\n      \"fieldAliases\": {\n         \"cashReceiptId\": \"cashReceiptId\",\n         \"receiptAmount\": \"receiptAmount\",\n        \"customerAccount.customer.name\": \"customerName\",\n        \"receiptDate\": \"receiptDate\",\n        \"receiptNumber\": \"receiptNumber\",\n        \"customerAccount.accountNumber\": \"customerAccountNumber\",\n        \"status\": \"cashReceiptStatus\"\n      }\n    }\n  }\n}\n        }, \n        {\n            \"name\": \"receivablesRemittanceReferenceDetail\",\n            \"value\": {\n                \"select\": \"select invoiceReference, purchaseOrderNumber, waybillNumber, salesOrder, contractNumber, balanceFwdBillNumber, structuredPaymentReference from ReceivablesRemittanceReferenceDetail where cashReceiptId=cash_receipt_id\",\n                \"viewQueries\": {\n                    \"ReceivablesRemittanceReferenceDetail\": {\n                        \"view\": \"receivablesRemittanceReferenceDetail\",\n                        \"businessObject\": \"ReceivablesRemittanceReference\",\n                        \"module\": \"oraErpCoreReceivablesPayments\",\n                        \"fieldAliases\": {\n                             \"cashReceipt.cashReceiptId\": \"cashReceiptId\",\n                            \"cashReceipt.receiptNumber\": \"receiptNumber\",\n                            \"cashReceipt.receiptDate\": \"receiptDate\",\n                            \"cashReceipt.receiptAmount\": \"receiptAmount\",\n                            \"transactionNumber\": \"transactionNumber\",\n                            \"invoiceReference\": \"invoiceReference\",\n                            \"purchaseOrderNumber\": \"purchaseOrderNumber\",\n                            \"waybillNumber\": \"waybillNumber\",\n                            \"salesOrder\": \"salesOrder\",\n                            \"contractNumber\": \"contractNumber\",\n                            \"balanceFwdBillNumber\": \"balanceFwdBillNumber\",\n                            \"structuredPaymentReference\": \"structuredPaymentReference\",\n                            \"receiptReferenceStatus\": \"receiptReferenceStatus\"\n                        }\n                    }\n                }\n            }\n        },\n        {\n            \"name\": \"receivablesRemittanceAdviceDetail\",\n            \"value\": {\n                \"select\": \"select customerName, customerAccountNumber, receiptNumber, receiptDate, receiptAmount, checkNumber, depositDate, comments, customerReason, customerReference, customerDetails from ReceivablesRemittanceAdviceDetail where UPPER(statusCode) in ('NEW', 'IN_PROCESS')\",\n                \"viewQueries\": {\n                    \"ReceivablesRemittanceAdviceDetail\": {\n                        \"view\": \"receivablesRemittanceAdviceDetail\",\n                        \"businessObject\": \"ReceivablesRemittanceAdvice\",\n                        \"module\": \"oraErpCoreReceivablesPayments\",\n                        \"fieldAliases\": {\n                            \"customerAccount.customer.name\": \"customerName\",\n                            \"customerAccount.accountNumber\": \"customerAccountNumber\",\n                            \"cashReceipt.receiptNumber\": \"receiptNumber\",\n                            \"cashReceipt.receiptDate\": \"receiptDate\",\n                            \"cashReceipt.receiptAmount\": \"receiptAmount\",\n                            \"checkNumber\": \"checkNumber\",\n                            \"depositDate\": \"depositDate\",\n                            \"comments\": \"comments\",\n                            \"customerReason\": \"customerReason\",\n                            \"customerReference\": \"customerReference\",\n                            \"customerDetails\": \"customerDetails\",\n                            \"statusCode\": \"statusCode\"\n                        }\n                    }\n                }\n            }\n        }\n    ]\n}"
            },
