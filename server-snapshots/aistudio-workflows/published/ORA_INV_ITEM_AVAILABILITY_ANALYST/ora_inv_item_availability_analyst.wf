        {
          "metadata": {
            "name": "OrgCount",
            "returnType": "string",
            "sourceCode": "let OrgSwitch;\nlet OrgList = $context.$nodes.SEARCH_FOR_ORGANIZATIONS.$output?.items ?? [];\n\nif (OrgList.length === 0) {\n    OrgSwitch = 'NoOrg';\n} else if (OrgList.length === 1) {\n    OrgSwitch = 'SingleOrg';\n} else {\n    OrgSwitch = 'MultipleOrgs';\n}\nreturn OrgSwitch;"
          },
          "outcomes": {
            "success": "1772794597217"
          },
          "code": "ORGCOUNT",
          "id": "1772794549204",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "CheckOrgCount"
          },
          "outcomes": {
