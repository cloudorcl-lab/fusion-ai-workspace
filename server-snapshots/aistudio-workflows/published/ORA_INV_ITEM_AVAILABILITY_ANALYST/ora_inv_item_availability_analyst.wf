{
  "workflowId": "300000331057964",
  "workflowCode": "ORA_INV_ITEM_AVAILABILITY_ANALYST",
  "name": "Inventory Item Availability Analyst",
  "description": "Assists warehouse operators and inventory planners to evaluate item availability within the selected organization. Retrieves item availability, demand details, supply information, and supports organization context changes, helping operations teams analyze inventory conditions to make informed sourcing and fulfillment decisions.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
