            "sourceCode": "// let input = $context.$variables.userQueshion;\n// const result = {\n//   context: \"NOTHING\",\n//   items: [],\n//   point_of_use: {\n//     subinventory: [],\n//     locator: [],\n//     lpn: []\n//   },\n//   kanban_card: [],\n//   days: []\n// };\n\n// // Existing regexes\n// const itemRegex = /\\b(?:item|SKU|product|material)\\s*[:-=\\s]\\s*([A-Za-z0-9-_]+(?:[,\\s]+[A-Za-z0-9-_]+)*)/i;\n// const subinventoryRegex = /\\bsubinventory(?:code)?\\s*[:-=\\s]\\s*([A-Za-z0-9-_]+(?:[,\\s]+[A-Za-z0-9-_]+)*)/i;\n// const locatorRegex = /\\blocator\\s*[:-=\\s]\\s*([A-Za-z0-9._-]+(?:[,\\s]+[A-Za-z0-9._-]+)*)/i;\n// const lpnRegex = /\\blpn\\s*[:-=\\s]\\s*([A-Za-z0-9-_]+(?:[,\\s]+[A-Za-z0-9-_]+)*)/i;\n// // Kanban card regex\n// const kanbanCardRegex = /(?<!unmoved\\s)(?:\\bkanban\\s+card|\\bcard)(?:\\s+number)?\\s*[:-]?\\s*([A-Za-z0-9\\-]+)/gi;\n// // Unmoved card regex (looks for \"unmoved card\" followed by number and 'day'/'days')\n// const unmovedCardRegex = /\\bunmoved\\s*card\\b.*?\\b(\\d+)\\s*days?\\b/i;\n\n// // Main matching logic (unchanged)\n// const itemMatch = input.match(itemRegex);\n// if (itemMatch) {\n//   result.context = \"ITEM\";\n//   result.items = itemMatch[1]\n//     .split(/[\\s,]+/)\n//     .map(item => item.trim())\n//     .filter(item => item !== \"\");\n// }\n// if (!itemMatch) {\n//   const subinventoryMatch = input.match(subinventoryRegex);\n//   if (subinventoryMatch) {\n//     result.context = \"POINT_OF_USE\";\n//     result.point_of_use.subinventory = subinventoryMatch[1]\n//       .split(/[\\s,]+/)\n//       .map(item => item.trim())\n//       .filter(item => item !== \"\");\n//   }\n//   const locatorMatch = input.match(locatorRegex);\n//   if (locatorMatch) {\n//     result.context = \"POINT_OF_USE\";\n//     result.point_of_use.locator = locatorMatch[1]\n//       .split(/[\\s,]+/)\n//       .map(item => item.trim())\n//       .filter(item => item !== \"\");\n//   }\n//   const lpnMatch = input.match(lpnRegex);\n//   if (lpnMatch) {\n//     result.context = \"POINT_OF_USE\";\n//     result.point_of_use.lpn = lpnMatch[1]\n//       .split(/[\\s,]+/)\n//       .map(item => item.trim())\n//       .filter(item => item !== \"\");\n//   }\n// }\n\n// if (\n//   result.context === \"NOTHING\" &&\n//   result.items.length === 0 &&\n//   result.point_of_use.subinventory.length === 0 &&\n//   result.point_of_use.locator.length === 0 &&\n//   result.point_of_use.lpn.length === 0\n// ) {\n//   // Try to match Kanban card if nothing else\n//   let kanbanCardMatch;\n//   while ((kanbanCardMatch = kanbanCardRegex.exec(input)) !== null) {\n//     result.context = \"KANBAN_CARD\";\n//     result.kanban_card.push(kanbanCardMatch[1]);\n//   }\n// }\n\n// // UNMOVED_CARD check (runs only if context is STILL NOTHING)\n// if (\n//   result.context === \"NOTHING\" &&\n//   result.items.length === 0 &&\n//   result.point_of_use.subinventory.length === 0 &&\n//   result.point_of_use.locator.length === 0 &&\n//   result.point_of_use.lpn.length === 0 &&\n//   result.kanban_card.length === 0\n// ) {\n//   const unmovedCardMatch = input.match(unmovedCardRegex);\n//   if (unmovedCardMatch) {\n//     result.context = \"UNMOVED_CARD\";\n//     result.days = [unmovedCardMatch[1]];\n//   }\n// }\n\n// // If still nothing, clear all arrays\n// if (result.context === \"NOTHING\") {\n//   result.items = [];\n//   result.point_of_use.subinventory = [];\n//   result.point_of_use.locator = [];\n//   result.point_of_use.lpn = [];\n//   result.kanban_card = [];\n//   result.days = [];\n// }\n\nconst fallback = {\n  context: \"NOTHING\",\n  items: [],\n  point_of_use: { subinventory: [], locator: [], lpn: [] },\n  kanban_card: [],\n  days: [],\nthresholdPercent: []\n};\n\nlet raw = $context.$nodes.CONTEXT_INDETIFYING_LLM.$output;\n\n// If already object, pass through\nif (raw && typeof raw === \"object\") {\n  if (raw.context) return raw;\n  if (raw.result && typeof raw.result === \"object\" && raw.result.context) return raw.result;\n  if (typeof raw.result === \"string\") raw = raw.result;\n  else return fallback;\n}\n\n// If string, parse JSON block\nif (typeof raw !== \"string\") return fallback;\n\nconst m = raw.match(/\\{[\\s\\S]*\\}/);\nif (!m) return fallback;\n\ntry { return JSON.parse(m[0]); } catch (e) { return fallback; }\n"
