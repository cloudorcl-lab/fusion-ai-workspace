            "name": "Remove Unnessary field",
            "returnType": "object",
            "sourceCode": "let kanbanCardDetails = $context.$nodes.GET_THE_KANBAN_CARD_ACTIVITIES_DETAILS.$output;\nif (\n  !kanbanCardDetails ||\n  !kanbanCardDetails.items ||\n  kanbanCardDetails.items.length === 0\n) {\n  return [];\n}\n\nconst response = {\n  KanbanCardNumber: kanbanCardDetails.items[0].KanbanCardNumber,\n  ItemNumber: kanbanCardDetails.items[0].ItemNumber,\n  SubinventoryCode: kanbanCardDetails.items[0].SubinventoryCode,\n  Locator: kanbanCardDetails.items[0].Locator,\n  SupplierName: kanbanCardDetails.items[0].SupplierName,\n  SupplierSiteCode: kanbanCardDetails.items[0].SupplierSiteCode,\n  KanbanSize: kanbanCardDetails.items[0].KanbanSize,\n  activities: kanbanCardDetails.items[0].KanbanCardActivity.items.map(activity => ({\n    FromSupplyStatusMeaning: activity.FromSupplyStatusMeaning,\n    ToSupplyStatusMeaning: activity.ToSupplyStatusMeaning,\n    CreationDate: activity.CreationDate,\n    LastUpdateDate: activity.LastUpdateDate\n  }))\n};\nreturn response;"
          },
