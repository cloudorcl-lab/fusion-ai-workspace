            "errorNodeId": "1768296666835",
            "name": "Sort and filter Top 5 Valid Kanban Activities",
            "returnType": "array",
            "sourceCode": "let data =  $context.$nodes.ITERATE_FILTER_KANBAN_CARDS.$output;\nlet parseData =  $context.$nodes.ITERATE_FILTER_KANBAN_CARDS.$output.map(item=>{let outerObj = JSON.parse(item); return outerObj});\nparseData = parseData.filter(item => Object.keys(item.result).length > 0);\nparseData = parseData.map(item => ({\n  ...item,\n  result: typeof item.result === \"string\" ? JSON.parse(item.result) : item.result\n}));\n\nconst itemCounts = {};\nparseData.forEach(item => {\n    const {\n        ItemNumber,\n        KanbanCardNumber,\n        PullSequenceId,\n        cardStuckInStatusDurationInMs,\n        cardStuckInStatusDuration\n    } = item.result;\n    if (!itemCounts[ItemNumber]) {\n        itemCounts[ItemNumber] = {\n            uniqueKanbanCards: new Set(),\n            uniquePullSequences: new Set(),\n            maxCardStuckInStatusDurationInMs: 0,\n            maxCardStuckInStatusDuration: null,\n            results: []\n        };\n    }\n    itemCounts[ItemNumber].uniqueKanbanCards.add(KanbanCardNumber);\n    itemCounts[ItemNumber].uniquePullSequences.add(PullSequenceId);\n    itemCounts[ItemNumber].results.push(item.result); \n    const durationMs = Number(cardStuckInStatusDurationInMs);\n    if (\n        !Number.isNaN(durationMs) &&\n        durationMs > itemCounts[ItemNumber].maxCardStuckInStatusDurationInMs\n    ) {\n        itemCounts[ItemNumber].maxCardStuckInStatusDurationInMs = durationMs;\n        itemCounts[ItemNumber].maxCardStuckInStatusDuration =\n            cardStuckInStatusDuration;\n    }\n});\n\n// Convert the map to summary results\nconst summary = Object.entries(itemCounts).map(([ItemNumber, counts]) => ({\n    ItemNumber,\n    uniqueKanbanCardCount: counts.uniqueKanbanCards.size,\n    uniquePullSequenceCount: counts.uniquePullSequences.size,\n    maxCardStuckInStatusDurationInMs: counts.maxCardStuckInStatusDurationInMs,\n    maxCardStuckInStatusDuration: counts.maxCardStuckInStatusDuration,\n    listOfCardDetails : counts.results\n}));\nconst top5Summary = summary\n  .sort((a, b) => b.maxCardStuckInStatusDurationInMs - a.maxCardStuckInStatusDurationInMs)\n  .slice(0, 5);\n\nreturn top5Summary;"
          },
