                {
                  "metadata": {
                    "businessObjectCode": "ORA_SCM_MANUFACTUR_KSEKANBANCANDDETAILSBYKANBANIDBO",
                    "errorNodeId": "1774001278531",
                    "functionName": "get_kanbanCards",
                    "processJson": true,
                    "name": "Get Kanban Card Details By Id"
                  },
                  "outcomes": {
                    "success": "1767088466880"
                  },
                  "code": "GET_KANBAN_CARD_DETAILS_BY_ID",
                  "convergenceTargetId": "1774002528403",
                  "id": "1767086862836",
                  "inputs": [
                    {
                      "id": "1767086889041_1",
                      "name": "kanbanCards_Id",
                      "type": "string",
                      "value": "{{$context.$nodes.ITERATE_FILTER_KANBAN_CARDS.$currentItem.KANBANCARDID}}"
                    }
                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "errorNodeId": "1768296666835",
                    "name": "filter kanban card activities on lead time",
                    "returnType": "object",
                    "sourceCode": "let queryEnabled = $context.$nodes.CONTEXT_IDENTIFYING_CODE.$output ? true : false;\nlet validActivity = true;\n\nif(queryEnabled){\nlet context  = $context.$nodes.CONTEXT_IDENTIFYING_CODE.$output.result.context;\nlet subInventoryCodeCheck =$context.$nodes.CONTEXT_IDENTIFYING_CODE.$output.result.point_of_use.subinventory.length !== 0;\nlet locatorCheck =  $context.$nodes.CONTEXT_IDENTIFYING_CODE.$output.result.point_of_use.locator.length !== 0;\nlet subInventoryCodeCheckValue =$context.$nodes.CONTEXT_IDENTIFYING_CODE.$output.result.point_of_use.subinventory[0];\nlet locatorCheckValue =  $context.$nodes.CONTEXT_IDENTIFYING_CODE.$output.result.point_of_use.locator[0];\nlet kanbanSubInventoryCodeValue = $context.$nodes.ITERATE_FILTER_KANBAN_CARDS.GET_KANBAN_CARD_DETAILS_BY_ID.$output.SubinventoryCode;\nlet kanbanLocatorValue = $context.$nodes.ITERATE_FILTER_KANBAN_CARDS.GET_KANBAN_CARD_DETAILS_BY_ID.$output.Locator; \nlet itemValue =  $context.$nodes.CONTEXT_IDENTIFYING_CODE.$output.result.items[0];\nlet kanbanItemValue = $context.$nodes.ITERATE_FILTER_KANBAN_CARDS.GET_KANBAN_CARD_DETAILS_BY_ID.$output.ItemNumber;\nlet pullSequenceId = $context.$nodes.ITERATE_FILTER_KANBAN_CARDS.GET_KANBAN_CARD_DETAILS_BY_ID.$output.PullSequenceId;\n\nvalidActivity = false;\n \nif(context == \"ITEM\" && itemValue == kanbanItemValue)\n validActivity = true;\n\n\nif(context == \"POINT_OF_USE\" && subInventoryCodeCheck && locatorCheck)\n validActivity = (subInventoryCodeCheckValue == kanbanSubInventoryCodeValue) && (locatorCheckValue == kanbanLocatorValue) ? true : false;\n\n\nelse if(context == \"POINT_OF_USE\"  && subInventoryCodeCheck && subInventoryCodeCheckValue == kanbanSubInventoryCodeValue)\n validActivity = true;\n\nelse if(context == \"UNMOVED_CARD\")\n  validActivity = true;\n\n\n}\n\nlet currentDate = new Date($context.$system.$currentDateTime);\nlet lastUpdatedDate = new Date($context.$nodes.ITERATE_FILTER_KANBAN_CARDS.$currentItem.TIMEUPDATED);\nlet replenishTime = $context.$nodes.ITERATE_FILTER_KANBAN_CARDS.$currentItem.REPLENISHMENTLEADTIME??0;\n\nconst thresholdPct = Number($context.$variables.thresholdPercent || \"2\");\nconst factor = 1 + (thresholdPct / 100);\nlet extraTimeInMs = currentDate - lastUpdatedDate -  (factor * replenishTime * 24 * 60 * 60 * 1000);\nlet extraTimeInMsInt = extraTimeInMs;\nconst days = Math.floor(extraTimeInMs / (24 * 60 * 60 * 1000)); // Calculate days\nextraTimeInMs = extraTimeInMs % (24 * 60 * 60 * 1000); // Remaining milliseconds\nconst hours = Math.floor(extraTimeInMs / (60 * 60 * 1000)); // Calculate hours\n\nlet daysStuckInMs = currentDate - lastUpdatedDate;\nlet daysStuckInMsInt = daysStuckInMs;\nconst daysStuck = Math.floor(daysStuckInMs / (24 * 60 * 60 * 1000)); // Calculate days\ndaysStuckInMs = daysStuckInMs % (24 * 60 * 60 * 1000); // Remaining milliseconds\nconst hoursStuck = Math.floor(daysStuckInMs / (60 * 60 * 1000)); // Calculate hours\n\n\nlet output =\n  $context.$nodes.ITERATE_FILTER_KANBAN_CARDS.GET_KANBAN_CARD_DETAILS_BY_ID.$output;\nlet kanbandetails = {};\n\nkanbandetails = {\n  KanbanCardNumber: output.KanbanCardNumber,\n  SupplierName: output.SupplierName,\n  KanbanCardId: output.KanbanCardId,\n  ToSupplyStatusMeaning: output.SupplyStatusMeaning,\n  ReplenishmentLeadTime: replenishTime,\n   ItemNumber: output.ItemNumber,\n  SubinventoryCode : output.SubinventoryCode,\n  cardStuckInStatusDuration : {days :daysStuck,hours: hoursStuck},\n  cardStuckInStatusDurationInMs: daysStuckInMsInt,\n  ItemDescription : output.ItemDescription,\n  SourceTypeMeaning : output.SourceTypeMeaning,\n  KanbanSize : output.KanbanSize,\n pullSequenceId: output.PullSequenceId\n};\n\nif (validActivity && (currentDate - lastUpdatedDate) > (factor * replenishTime * 24 * 60 * 60 * 1000) && ($context.$nodes.ITERATE_FILTER_KANBAN_CARDS.GET_KANBAN_CARD_DETAILS_BY_ID.$output.SupplyStatus != \"2\")) \n    return  kanbandetails\nelse \n    return {};"
                  },
