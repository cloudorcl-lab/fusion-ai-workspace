{
  "workflowId": "300000331068321",
  "workflowCode": "ORA_MSC_INVENTORY_OPTIMIZATION_ADVISOR",
  "name": "Inventory Optimization Advisor",
  "description": "The Inventory Optimization Planning AI Agent assists supply chain planners in identifying and resolving service level shortfalls for finished goods by analyzing safety stock sensitivity across the distribution network. The agent is integrated into the planning dashboards and is launched through a guided workflow starting from supply chain network visualizations.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
