        {
          "metadata": {
            "name": "GetOnlyTop5",
            "returnType": "array",
            "sourceCode": "let input = $context.$nodes.GETSERVICECOSTREST.$output;\n\nconst result = Array.isArray(input?.items)\n  ? [...input.items]\n      .sort((a, b) => {\n        const aVal = Number(a?.[\"Percentage Service Level Sensitivity to Safety Stock Value in Millions\"] ?? 0);\n        const bVal = Number(b?.[\"Percentage Service Level Sensitivity to Safety Stock Value in Millions\"] ?? 0);\n\n        if (bVal !== aVal) return bVal - aVal;\n\n        return String(b?.Item ?? \"\").localeCompare(String(a?.Item ?? \"\"));\n      })\n      .slice(0, 5)\n  : [];\n\n  return result;\n  "
          },
          "outcomes": {
            "success": "1774373279311"
          },
          "code": "GETONLYTOP5",
          "id": "1774423355754",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
