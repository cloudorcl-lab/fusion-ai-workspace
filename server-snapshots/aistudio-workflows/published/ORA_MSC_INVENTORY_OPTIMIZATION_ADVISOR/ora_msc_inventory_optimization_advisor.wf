        {
          "metadata": {
            "name": "GenerateDrillContext",
            "returnType": "array",
            "sourceCode": "const data = $context.$variables.ServiceQueryRestResponse;\n\n\nif (!data || !Array.isArray(data)) {\n    return \"W10=\";\n}\n\n// agent is expected to show these deep links - one deep link for all item-org combinations together. And Also, individual deep link for each item-org separately. In this method we build the encoded drill contexts\n\n// finalArray has encoded drill contexts. At index 0, we will have single context for all combinations together. From index 1 till end, we will have individual encoded drill contexts for each item-org\nlet finalArray = []; \n\n// fullArray is for accumulation of combinations. This is the array yet-to-be-encoded. It will be encoded after the looping is done.\nconst fullArray = [];\n\nfor (let i = 0; i < data.length; i++) {\n    const item = data[i];\n\n    const obj = [\n        {\n            levelId: 40,\n            memberIds: [Number(item.OrganizationId)],\n            levelName: \"Organization\"\n        },\n        {\n            levelId: 1,\n            memberIds: [Number(item.ItemId)],\n            levelName: \"Item\"\n        }\n    ];\n\n    // Add to full array\n    fullArray.push(obj);\n\n    let singleCombination = [obj];\n\n    // Encode individual item and push to final array\n    const encodedItem = btoa(JSON.stringify(singleCombination));\n    finalArray.push(encodedItem);\n}\n\n// Encode full array and insert at index 0\nconst encodedFullArray = btoa(JSON.stringify(fullArray));\nfinalArray.unshift(encodedFullArray);\n\n\nreturn finalArray;"
          },
          "outcomes": {
            "success": "1772612902320"
          },
          "code": "GENERATEDRILLCONTEXT",
          "id": "1775404414537",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "generateDrillContextString",
            "returnType": "array",
            "sourceCode": "const data = $context.$variables.ServiceQueryRestResponse;\n\n\nif (!data || !Array.isArray(data)) {\n    return \"W10=\";\n}\n\n// agent is expected to show these deep links - one deep link for all item-org combinations together. And Also, individual deep link for each item-org separately. In this method we build the encoded drill contexts\n\n// finalArray has encoded drill contexts. At index 0, we will have single context for all combinations together. From index 1 till end, we will have individual encoded drill contexts for each item-org\nlet finalArray = []; \n\n// fullArray is for accumulation of combinations. This is the array yet-to-be-encoded. It will be encoded after the looping is done.\nconst fullArray = [];\n\nfor (let i = 0; i < data.length; i++) {\n    const item = data[i];\n\n    const obj = [\n        {\n            levelId: 40,\n            memberIds: [Number(item.OrganizationId)],\n            levelName: \"Organization\"\n        },\n        {\n            levelId: 1,\n            memberIds: [Number(item.ItemId)],\n            levelName: \"Item\"\n        }\n    ];\n\n    // Add to full array\n    fullArray.push(obj);\n\n    let singleCombination = [obj];\n\n    // Encode individual item and push to final array\n    const encodedItem = btoa(JSON.stringify(singleCombination));\n    finalArray.push(encodedItem);\n}\n\n// Encode full array and insert at index 0\nconst encodedFullArray = btoa(JSON.stringify(fullArray));\nfinalArray.unshift(encodedFullArray);\n\n\nreturn finalArray;"
          },
          "outcomes": {
            "success": "1774848852041"
          },
          "code": "GENERATEDRILLCONTEXTSTRING",
          "id": "1775405797186",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
