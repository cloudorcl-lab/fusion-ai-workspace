{
  "workflowId": "300000331067885",
  "workflowCode": "ORA_HCM_HRA_FEEDBACK_CENTER_FEEDBACK_SUMMARY_GENERATOR",
  "name": "Feedback Center Feedback Summary Generator",
  "description": "Generates a combined summary of anytime and requested feedback to display on a workers Feedback Center.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1768986693250"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "description": "End of data pipeline",
            "name": "End"
          },
          "outcomes": {},
          "code": "END",
          "id": "end",
          "inputs": [],
          "type": "END"
        },
        {
          "metadata": {
            "name": "switchFeedbackCenter"
          },
          "outcomes": {
            "feedbackSummaryForWorker": "1768986744326",
            "feedbackSummaryAboutWorker": "1768986774656"
          },
          "code": "SWITCHFEEDBACKCENTER",
          "convergenceTargetId": "end",
          "id": "1768986693250",
          "inputs": [
            {
              "id": "1768986693252_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.useCase}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
            "name": "LLM_Feedback Summary For Worker"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "LLMFEEDBACK_SUMMARY_FOR_WORKER",
          "id": "1768986744326",
          "inputs": [
            {
              "id": "1768986744327_1",
              "name": "prompt",
              "type": "string",
              "value": "## Input\n- Requested Feedback {{$context.$triggers.REST.$input.requestedFeedback}} : Questionnaire questions and responses about the employee’s performance, entered by colleagues.\n- Unsolicited Feedback {{$context.$triggers.REST.$input.anytimeFeedback}} : - Unsolicited feedback from colleagues\n\n## Instructions\n- Drawing on the provided input, provide a summary for an employee of unsolicited feedback given to them or requested from other colleagues in response to specific questions\n- Use the input as your sole point of knowledge.\n- If there is no requested or unsolicited feedback, return the following message instead of a summary:\nThere's insufficient feedback, for the period, to generate a summary at this time.\n- The summary should be clear, concise, and neutral in tone.\n- Identify and highlight key strengths, areas for development, progress made, challenges noted, and any recurring themes or notable insights across the unsolicited feedback and question responses.\n- Exclude any content that is offensive or inappropriate.\n\n## Acceptance Criteria\n- Provide the summary in the second person.\n- The summary must not exceed 500 words.\n- Convey the employee’s overall progress and key discussion points without quoting or closely paraphrasing original comments.\n- Do not repeat these instructions or include any introduction or preamble."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "LLM_Feedback Center Summary About Worker"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "LLMFEEDBACK_CENTER_SUMMARY_ABOUT_WORKER",
          "id": "1768986774656",
          "inputs": [
            {
              "id": "1768986774657_1",
              "name": "prompt",
              "type": "string",
              "value": "## Input\n- Workers First Name {{$context.$triggers.REST.$input.workersFirstName}} \n- Requested Feedback {{$context.$triggers.REST.$input.requestedFeedback}}: Questionnaire questions and responses about the employee’s performance, entered by colleagues.\n- Unsolicited Feedback {{$context.$triggers.REST.$input.anytimeFeedback}}  : - Unsolicited feedback from colleagues\n\n## Instructions\n- Drawing on the provided input, provide a summary about an employee of unsolicited feedback given to them or requested from other colleagues in response to specific questions\n- Use the input as your sole point of knowledge.\n- If there is no requested or unsolicited feedback, return the following message instead of a summary:\nThere's insufficient feedback, for the period, to generate a summary at this time.\n- The summary should be clear, concise, and neutral in tone.\n- Identify and highlight key strengths, areas for development, progress made, challenges noted, and any recurring themes or notable insights across the unsolicited feedback and question responses.\n- Exclude any content that is offensive or inappropriate.\n\n## Acceptance Criteria\n- Provide the summary in the third person\n- The summary must not exceed 500 words.\n- Convey the employee’s overall progress and key discussion points without quoting or closely paraphrasing original comments.\n- Do not repeat these instructions or include any introduction or preamble."
            }
          ],
          "type": "LLM"
        }
      ],
      "rootNode": "start",
