              "id": "1771584412452_1",
              "name": "prompt",
              "type": "string",
              "value": "Return the following - \n\nTitle: How to Set or Switch Focus Using Ask Oracle for this application\nUse Ask Oracle to switch focus to a particular item and organization. \nEnter this prompt: Switch focus to [ItemNumber],  [OrganizationCode] Example: Switch Focus to Item OXIM-1, V1"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Extract Item and Org",
            "returnType": "object",
            "sourceCode": "const appContext=$context.$triggers.REST.$input.OraAppContext;\nconst values = appContext.split(':');\nlet [itemId,billSequenceId, orgCode,eff] = values;\nif(!itemId && !orgCode){\nthrow new Error(\"Item or Org not found in context\");\n}\nconst filterValues = {\nItemId:`${itemId}`,\nBillSequenceId: `${billSequenceId}`,\nOrganizationCode: `${orgCode}`,\n};\nreturn filterValues ;"
          },
          "outcomes": {
            "success": "1771498784404"
          },
          "code": "EXTRACT_ITEM_AND_ORG",
          "id": "1771585251987",
          "inputs": [],
