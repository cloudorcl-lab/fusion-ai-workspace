            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
        },
        {
          "metadata": {
            "name": "Calculate Varience",
            "returnType": "array",
            "sourceCode": "const calculateVariance = (supplierResponses, currentPurchaseAgreement, { multiplier = 1000 } = {}) => {\n  const parseJsonIfString = (v) => {\n    if (v == null) return v;\n    if (typeof v === \"string\") {\n      const s = v.trim();\n      if (!s) return v;\n      try {\n        return JSON.parse(s);\n      } catch {\n        return v;\n      }\n    }\n    return v;\n  };\n\n  const parseNum = (v) => {\n    if (v === null || v === undefined) return NaN;\n    if (typeof v === \"number\") return Number.isFinite(v) ? v : NaN;\n    const s = String(v).trim();\n    if (!s) return NaN;\n    const normalized = s\n      .replace(/No Additional Cost/i, \"0\")\n      .replace(/[,\\s]/g, \"\")\n      .replace(/[^0-9.+-]/g, \"\");\n    const n = Number(normalized);\n    return Number.isFinite(n) ? n : NaN;\n  };\n\n  const fmtPct = (n) => `${n.toFixed(2)}%`;\n\n  const sr = parseJsonIfString(supplierResponses);\n  const pa = parseJsonIfString(currentPurchaseAgreement);\n\n  const supplierRows = Array.isArray(sr?.result) ? sr.result : Array.isArray(sr) ? sr : [];\n  const agreementLines = Array.isArray(pa?.items) ? pa.items : Array.isArray(pa) ? pa : [];\n\n  // target by item: prefer TargetPrice; fallback Quote; choose the minimum available\n  const targetByItem = new Map();\n  for (const r of supplierRows) {\n    const item = r?.Item ?? r?.item;\n    if (!item) continue;\n\n    const targetCandidate = parseNum(r?.TargetPrice);\n    const quoteCandidate = parseNum(r?.Quote);\n    const chosen = Number.isFinite(targetCandidate) ? targetCandidate : quoteCandidate;\n    if (!Number.isFinite(chosen)) continue;\n\n    const prev = targetByItem.get(String(item));\n    if (prev === undefined || chosen < prev) targetByItem.set(String(item), chosen);\n  }\n\n  // current by item: choose minimum agreement price for item\n  const currentByItem = new Map();\n  for (const l of agreementLines) {\n    const item = l?.Item ?? l?.item;\n    if (!item) continue;\n    const price = parseNum(l?.Price ?? l?.price);\n    if (!Number.isFinite(price)) continue;\n    const key = String(item);\n    const prev = currentByItem.get(key);\n    if (prev === undefined || price < prev) currentByItem.set(key, price);\n  }\n\n  const items = [...new Set([...targetByItem.keys(), ...currentByItem.keys()])].sort();\n\n  let totalTarget = 0;\n  let totalCurrent = 0;\n\n  const rows = items.map((item) => {\n    const tUnit = targetByItem.get(item);\n    const cUnit = currentByItem.get(item);\n\n    const hasT = Number.isFinite(tUnit);\n    const hasC = Number.isFinite(cUnit);\n\n    const targetBOM = hasT ? Math.round(tUnit * multiplier) : \"N/A\";\n    const currentBOM = hasC ? Math.round(cUnit * multiplier) : \"N/A\";\n\n    if (hasT && hasC) {\n      totalTarget += targetBOM;\n      totalCurrent += currentBOM;\n      const savings = currentBOM - targetBOM;\n      const variancePct = targetBOM !== 0 ? ((currentBOM - targetBOM) / targetBOM) * 100 : 0;\n      return {\n        Item: item,\n        targetBOM,\n        currentBOM,\n        variance: fmtPct(variancePct),\n        savings,\n      };\n    }\n\n    return {\n      Item: item,\n      targetBOM,\n      currentBOM,\n      variance: \"N/A\",\n      savings: \"N/A\",\n    };\n  });\n\n  const totalRow = (() => {\n    if (totalTarget === 0 && totalCurrent === 0) {\n      return {\n        Item: \"Total\",\n        targetBOM: 0,\n        currentBOM: 0,\n        variance: \"N/A\",\n        savings: \"N/A\",\n      };\n    }\n    const totalSavings = totalCurrent - totalTarget;\n    const totalVarPct = totalTarget !== 0 ? ((totalCurrent - totalTarget) / totalTarget) * 100 : 0;\n    return {\n      Item: \"Total\",\n      targetBOM: totalTarget,\n      currentBOM: totalCurrent,\n      variance: fmtPct(totalVarPct),\n      savings: totalSavings,\n    };\n  })();\n\n  return [...rows, totalRow];\n};\nreturn calculateVariance($context.$nodes.SUPPLIER_RESPONSES.$output.output, $context.$nodes.CURRENT_BOM_PRICE.$output.items )"
          },
          "outcomes": {
            "success": "1769407188764"
          },
          "code": "CALCULATE_VARIENCE",
          "convergenceTargetId": "1771583187862",
          "id": "1769407102702",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
