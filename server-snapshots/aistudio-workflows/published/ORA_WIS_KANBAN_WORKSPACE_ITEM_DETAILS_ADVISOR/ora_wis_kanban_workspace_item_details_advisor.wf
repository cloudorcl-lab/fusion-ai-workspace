        {
          "metadata": {
            "name": "Extract Action Data",
            "returnType": "object",
            "sourceCode": "const action = $context.$triggers.REST.$input.OraAction;\nlet [actionType, kanbanId, toSupplyStatus] = action.split(\"-\");\nif(toSupplyStatus.toLowerCase() == \"empty\")\n  toSupplyStatus = '4'\nelse if(toSupplyStatus.toLowerCase() == \"full\") \n  toSupplyStatus = '2'\nelse if(toSupplyStatus.toLowerCase() == \"in process\")\n  toSupplyStatus = '5'\nreturn {actionType, kanbanId, toSupplyStatus};"
          },
          "outcomes": {
            "success": "1768300368140"
          },
          "code": "EXTRACT_ACTION_DATA",
          "id": "1768300314082",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
