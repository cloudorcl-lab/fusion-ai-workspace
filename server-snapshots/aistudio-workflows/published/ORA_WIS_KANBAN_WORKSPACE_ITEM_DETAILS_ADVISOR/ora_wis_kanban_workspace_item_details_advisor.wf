          "code": "SET_KANBAN_CARD_DETAILS",
          "id": "1769681613386",
          "inputs": [
            {
              "id": "1769681627258",
              "name": "kanbanCardDetails",
              "scope": "JOB",
              "type": "object",
              "value": "{{$context.$nodes.FILTER_KANBAN_CARDS.$output.result}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Filter Kanban Cards",
            "returnType": "array",
            "sourceCode": "const input = $context.$nodes.FOR_EACH_PULL_SEQUENCE.$output;\n\n// Normalize FOR_EACH output into an array we can iterate\nconst rows = Array.isArray(input) ? input : (input ? [input] : []);\n\nconst filteredKanbanCards = [];\n\nfor (const row of rows) {\n  // Each row might be:\n  // 1) an object like { items: [...] }\n  // 2) already the payload like { items: [...] }\n  // 3) a JSON string (either of the above)\n\n  let payload = row;\n\n  // If the row itself is a JSON string, parse it\n  if (typeof payload === \"string\") {\n    try {\n      payload = JSON.parse(payload);\n    } catch (e) {\n      continue; // skip unparseable row\n    }\n  }\n\n  // If the row is a wrapper with \"items[0]\" holding the JSON/payload, unwrap it\n  if (payload && Array.isArray(payload.items) && payload.items.length > 0 && typeof payload.items[0] === \"string\") {\n    try {\n      payload = JSON.parse(payload.items[0]);\n    } catch (e) {\n      // If items[0] isn't JSON, keep going (we'll handle below)\n    }\n  }\n\n  // At this point payload should be an object with payload.items = kanban card array\n  const cards = payload?.items;\n  if (!Array.isArray(cards) || cards.length === 0) continue;\n\n  for (const card of cards) {\n    // Keep cards whose SourceType is NOT 1 (handle numeric or string)\n    const sourceType = String(card?.SourceType ?? \"\");\n   const supplyStatus = String(card?.SupplyStatus ?? \"\");\n    if (sourceType !== \"4\" && supplyStatus !== \"2\") {\n      filteredKanbanCards.push(card);\n    }\n  }\n}\n\nreturn filteredKanbanCards;"
          },
          "outcomes": {
            "success": "1769681613386"
          },
          "code": "FILTER_KANBAN_CARDS",
          "id": "1769683377129",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
