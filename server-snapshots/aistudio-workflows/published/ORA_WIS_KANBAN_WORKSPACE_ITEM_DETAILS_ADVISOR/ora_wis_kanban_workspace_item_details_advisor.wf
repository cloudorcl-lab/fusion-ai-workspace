            "sourceCode": "let hint = $context.$app.$OraMessageHint;\nif (hint === \"InitDisplay\" || hint === \"InitActions\" || hint === \"InitCommunications\" || hint===\"Summary\" )\n  hint = \"Init\";\nif (hint === \"Query\" || hint === \"FillParameters\")\n  hint = \"Query\";\nreturn hint;"
          },
          "outcomes": {
            "success": "1768299384299"
          },
          "code": "PREPARE_SWITCH",
          "id": "1768299292778",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Decide Flow"
          },
          "outcomes": {
            "Init": "1767806748894",
            "InvokeAction": "1768300314082",
