        {
          "metadata": {
            "name": "Set Payload Prospects",
            "returnType": "object",
            "sourceCode": "// 1. Get the payload Object\nvar payloadObj = $context.$nodes.PARSEACTIONCODE.$output.result.actionPayload;\n\n// 2. Prepare Requisition IDs (Ensure it is always an Array)\nvar reqIdsArray = [];\nif (payloadObj.requisitionIds) {\n    reqIdsArray = payloadObj.requisitionIds;\n} else if (payloadObj.requisitionId) {\n    reqIdsArray = [payloadObj.requisitionId];\n}\n\n// 3. Prepare Person IDs (Ensure it is always an Array)\nvar personIdsArray = [];\nif (payloadObj.personIds) {\n    personIdsArray = payloadObj.personIds;\n} else if (payloadObj.personId) {\n    // Check if it's already an array, otherwise wrap it\n    personIdsArray = Array.isArray(payloadObj.personId) ? payloadObj.personId : [payloadObj.personId];\n}\n\n// 4. Create the EXACT response structure required by the service\nvar response = {\n    \"addedByContextType\": \"ORA_CAND_PROFILE\",\n    \"requisitionIds\": reqIdsArray,\n    \"personIds\": personIdsArray\n};\n\n// 5. Return result\nresponse;"
          },
          "outcomes": {
            "success": "1765827052743"
          },
          "code": "SET_PAYLOAD_PROSPECTS",
          "id": "1765827099306",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
