        {
          "metadata": {
            "name": "Set Payload For Close Requisition",
            "returnType": "object",
            "sourceCode": "var payloadObj = {};\nvar parseOutput = $context.$nodes.PARSEACTIONCODE.$output || {};\nvar parseResult = parseOutput.result || {};\n\nif (parseResult.actionPayload !== undefined && parseResult.actionPayload !== null) {\n    payloadObj = parseResult.actionPayload;\n}\n\nvar reqId = '';\nif (payloadObj.requisitionId !== undefined && payloadObj.requisitionId !== null) {\n    reqId = payloadObj.requisitionId;\n}\n\nif (Array.isArray(reqId)) {\n    var selectedReqId = '';\n    for (var i = 0; i < reqId.length; i++) {\n        if (reqId[i] !== undefined && reqId[i] !== null && reqId[i] !== '') {\n            selectedReqId = reqId[i];\n            break;\n        }\n    }\n    reqId = selectedReqId;\n}\n\nvar response = {\n    requisitionId: reqId\n};\n\nreturn response;"
          },
