          },
          "code": "CHECKMODE",
          "convergenceTargetId": "end",
          "id": "1765431744667",
          "inputs": [
            {
              "id": "1765431744668_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.Mode eq 'InitAction'}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "prepare-list-of-action"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "PREPARELISTOFACTION",
          "id": "1765431939533",
          "inputs": [
            {
              "id": "1765431939535_1",
              "name": "prompt",
              "type": "string",
              "value": "you have access to {{$context.$triggers.REST.$input.RequisitionData}} \n\n\nEnsure the followUp Command always have ora.Invoke has the same format as in the example. You can substitute only the properties - key value pair but not change the signature..  \n\n\nYou will only support 4 actions and their name and code are as follows. Keep the action name Req Title under 10 characters - \n\n1. Action Name - Cancel, Action Code - CANCEL, FollowupCommandPayload - {requisitionId}\n2. Action Name - Add_Prospect, Action Code - ADD_PROSPECT, FollowupCommandPayload - {requisitionId}\n3. Action Name - Sourcing Boost, Action Code - SOURCING_BOOST, FollowupCommandPayload - {requisitionId}\n4. Action Name - Suspend, Action Code - SUSPEND, FollowupCommandPayload - {requisitionId}\n\n\nGet the requisitionId from the data object..\n\nYou can send actions back as part of your response. Actions follow this format:\n\n{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"title\": {\n      \"type\": \"string\",\n      \"description\": \"The main title of the notification. Must be a concise phrase, under 10 words.\"\n    },\n    \"shortDescription\": {\n      \"type\": \"string\",\n      \"description\": \"A brief description of the notification, written as a single, complete sentence.\"\n    },\n    \"actionText\": {\n      \"type\": \"string\",\n      \"description\": \"The text to display on the action button.\"\n    },\n    \"followUpCommand\": {\n      \"type\": \"string\",\n      \"description\": \"A command string to be executed. Must follow one of three standardized formats: ora.App.*(params) or ora.Agent(content). The exact content will be specified by the prompting instructions.\"\n    },\n    \"priority\": {\n      \"type\": \"boolean\",\n      \"description\": \"Optional. Controls whether this action should be prioritized in the display. If undefined or false, the action will not be prioritized. Only when set to true will the action be prioritized. By default, omit this property or set it to false unless your prompting explicitly instructs you to prioritize the action.\"\n    }\n  },\n  \"required\": [\"title\", \"shortDescription\", \"actionText\", \"followUpCommand\"],\n  \"additionalProperties\": false\n}\n\nAs an example:\n\n{\n    \"title\": \"Suspend Job Requisition\",\n    \"shortDescription\": \"Moves the Requisition to the Suspended state\",\n    \"actionText\": \"Suspend Job Requisition\",\n    \"followUpCommand\": \"ora.Invoke(\\\"Suspend\\\", {\\n  \\\"requisitionId\\\": 101,\\n})\"\n}"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "parse_action_code",
            "returnType": "object",
            "sourceCode": "var inputObj = $context.$triggers.REST.$input || {};\nvar rawInput = inputObj.OraAction || inputObj.oraAction;\nvar payloadData = {};\nvar detectedAction = '';\nvar requisitionId = '';\n\nif (typeof rawInput === 'string') {\n    var cleanInput = rawInput.trim();\n    if (cleanInput.indexOf('{') === 0) {\n        try {\n            payloadData = JSON.parse(cleanInput);\n            if (payloadData.action !== undefined && payloadData.action !== null) {\n                detectedAction = payloadData.action;\n            }\n            if (payloadData.requisitionId !== undefined && payloadData.requisitionId !== null) {\n                requisitionId = payloadData.requisitionId;\n            }\n        } catch (e) {\n            payloadData = {};\n        }\n    } else {\n        detectedAction = cleanInput;\n    }\n} else if (rawInput && typeof rawInput === 'object') {\n    payloadData = rawInput;\n    if (rawInput.action !== undefined && rawInput.action !== null) {\n        detectedAction = rawInput.action;\n    } else if (rawInput.followUpCommand !== undefined && rawInput.followUpCommand !== null) {\n        detectedAction = rawInput.followUpCommand;\n    }\n    if (rawInput.requisitionId !== undefined && rawInput.requisitionId !== null) {\n        requisitionId = rawInput.requisitionId;\n    }\n}\n\nif (Array.isArray(requisitionId)) {\n    var selectedReqId = '';\n    for (var i = 0; i < requisitionId.length; i++) {\n        if (requisitionId[i] !== undefined && requisitionId[i] !== null && requisitionId[i] !== '') {\n            selectedReqId = requisitionId[i];\n            break;\n        }\n    }\n    requisitionId = selectedReqId;\n}\n\nvar cleanAction = '';\nif (detectedAction !== undefined && detectedAction !== null && detectedAction !== '') {\n    cleanAction = String(detectedAction).toUpperCase().replace(/_/g, '').replace(/\\s/g, '');\n}\n\nvar actionCode = 'UNKNOWN';\nif (cleanAction.indexOf('FILL') >= 0 || cleanAction.indexOf('MOVE') >= 0) {\n    actionCode = 'FILL';\n} else if (cleanAction.indexOf('SUSPEND') >= 0) {\n    actionCode = 'SUSPEND';\n} else if (cleanAction.indexOf('ADDPROSPECT') >= 0 || cleanAction.indexOf('ADDASPROSPECT') >= 0 || cleanAction.indexOf('ADTOPROSPECT') >= 0) {\n    actionCode = 'ADD_PROSPECT';\n} else if (cleanAction.indexOf('SOURCINGBOOST') >= 0) {\n    actionCode = 'SOURCING_BOOST';\n} else if (cleanAction.indexOf('CLOSE') >= 0) {\n    actionCode = 'CLOSE';\n}\n\nvar actionPayload = {};\nif (requisitionId !== undefined && requisitionId !== null && requisitionId !== '') {\n    actionPayload = {\n        requisitionId: requisitionId\n    };\n}\n\nvar result = {\n    actionCode: actionCode,\n    actionPayload: actionPayload\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1765432071159"
          },
          "code": "PARSEACTIONCODE",
          "id": "1765431996084",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Requisition Actions"
          },
