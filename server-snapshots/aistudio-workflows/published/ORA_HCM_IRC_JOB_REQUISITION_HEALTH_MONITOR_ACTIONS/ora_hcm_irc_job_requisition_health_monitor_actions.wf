        {
          "metadata": {
            "name": "Build Close Response",
            "returnType": "object",
            "sourceCode": "var statusValue = $context.$nodes.CANCEL_REQUISITION_BO.$status;\nvar reqId = '';\nvar nodeInput = $context.$nodes.CANCEL_REQUISITION_BO.$input || {};\nvar payload = nodeInput.payload || {};\n\nif (payload.requisitionId !== undefined && payload.requisitionId !== null) {\n    reqId = payload.requisitionId;\n}\n\nvar requisitionTitle = '';\nvar requisitionNumber = '';\nvar requisitionInfo = $context.$triggers.REST.$input.RequisitionInfo || {};\n\nif (requisitionInfo.RequisitionTitle !== undefined && requisitionInfo.RequisitionTitle !== null) {\n    requisitionTitle = requisitionInfo.RequisitionTitle;\n}\nif (requisitionInfo.RequisitionNumber !== undefined && requisitionInfo.RequisitionNumber !== null) {\n    requisitionNumber = requisitionInfo.RequisitionNumber;\n}\n\nvar normalizedStatus = 'success';\nif (statusValue !== undefined && statusValue !== null && statusValue !== '') {\n    normalizedStatus = statusValue;\n}\n\nvar responseResult = {\n    status: normalizedStatus,\n    action: 'Close',\n    requisitionTitle: requisitionTitle,\n    requisitionNumber: requisitionNumber,\n    payload: reqId\n};\n\nreturn responseResult;"
          },
          "outcomes": {
            "success": "end"
