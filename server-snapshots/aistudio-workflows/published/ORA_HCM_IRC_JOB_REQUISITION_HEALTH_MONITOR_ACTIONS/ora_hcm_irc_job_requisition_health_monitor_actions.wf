{
  "workflowId": "300000326918432",
  "workflowCode": "ORA_HCM_IRC_JOB_REQUISITION_HEALTH_MONITOR_ACTIONS",
  "name": "Job Requisition Health Monitor Actions",
  "description": "Manages the job requisition health monitor actions performed on underperforming and stalled job requisitions.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
