        {
          "metadata": {
            "name": "Set PayLoad For Fill Requisition",
            "returnType": "object",
            "sourceCode": "// 1. Get the payload Object (It is now a full object, not just an ID string)\nvar payloadObj = $context.$nodes.PARSEACTIONCODE.$output.result.actionPayload;\n\n// 2. Extract specific fields safely\nvar reqId = payloadObj.requisitionId || \"\";\n// 3. Return what you need\nvar response = {\n    \"requisitionId\": reqId\n};\n\nresponse;"
          },
          "outcomes": {
            "success": "1765828390970"
          },
