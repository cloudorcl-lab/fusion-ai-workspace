          "metadata": {
            "businessObjectCode": "ORA_CX_SALESFORCE_OBJECTIVES",
            "functionName": "get_all_objectives_for_an_opportunity",
            "name": "Get Updated Objectives"
          },
          "outcomes": {
            "success": "1776173557168"
          },
          "code": "GET_UPDATED_OBJECTIVES",
          "id": "1766212941193",
          "inputs": [
            {
              "id": "1766212961697_1",
              "name": "id",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.id}}"
