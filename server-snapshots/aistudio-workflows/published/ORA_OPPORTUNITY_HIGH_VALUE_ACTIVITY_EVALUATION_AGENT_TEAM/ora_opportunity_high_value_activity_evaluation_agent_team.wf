          "metadata": {
            "name": "Construct Elastic Payload",
            "returnType": "object",
            "sourceCode": "const payload = {\n    \"limit\": 1,\n    \"offset\": 0,\n    \"sort\": [],\n    \"entity\": \"Opportunity\",\n    \"q\": {\n        \"op\": \"$and\",\n        \"criteria\": [\n            {\n                \"op\": \"$eq\",\n                \"attribute\": \"OptyId\",\n                \"value\": $context.$triggers.REST.$input.id\n            }\n        ]\n    },\n    \"fields\": [\n        \"PrCmptPartyId\",\n        \"PrimaryCampaignId.CampaignName\",\n        \"PrimaryCampaignId.CampaignId\",\n        \"PrimaryCampaignId.CampaignNumber\",\n        \"PrimaryRevenue.RevnAmountCurcyCode\",\n        \"ReasonWonLostCode\",\n        \"OptyId\",\n        \"OptyNumber\",\n        \"Owner.PartyId\",\n        \"SalesMethodId\",\n        \"SalesStage.StgOrderEnum\",\n        \"StatusCode\",\n        \"PrConPartyId.PartyId\",\n        \"PrConPartyId.PartyName\",\n        \"CustomerAccount.PartyId\",\n        \"CustomerAccount.PartyUniqueName\",\n        \"EffectiveDate\",\n        \"PrimaryRevenue.RevnAmount\",\n        \"PrimaryRevenue.WinProb\",\n        \"LastUpdatedBy\",\n        \"CreatedBy\",\n        \"CreationDate\",\n        \"LastUpdateDate\",\n        \"Name\",\n        \"CustomerAccount.PartyNumber\",\n        \"ListOfLeads.LeadId.LeadId\",\n        \"ListOfResourcesForTheTeam.OptyResourceId\",\n        \"ListOfResourcesForTheTeam.ResourceId.PartyId\",\n        \"ListOfResourcesForTheTeam.ResourceId.PartyName\",\n        \"ListOfResourcesForTheTeam.ResourceId.PrimaryEmail.EmailAddress\",\n        \"ListOfResourcesForTheTeam.ResourceId.PrimaryPhone.FormattedPhone\",\n        \"ListOfRevenues.Quantity\",\n        \"ListOfRevenues.RevnAmount\",\n        \"ListOfRevenues.RevnAmountCurcyCode\",\n        \"ListOfRevenues.Primary\",\n        \"ListOfRevenues.RevnNumber\",\n        \"ListOfRevenues.ProdGroupId.ProductGroupId\",\n        \"ListOfRevenues.ProdGroupId.Name\",\n        \"ListOfRevenues.CrmCurcyCode\",\n        \"ListOfRevenues.RevnId\",\n        \"ListOfRevenues.UnitPrice\",\n        \"ListOfRevenues.InventoryItemId.InventoryItemId\",\n        \"ListOfRevenues.InventoryItemId.Name\",\n        \"ListOfContacts.OptyConId\",\n        \"ListOfContacts.PerPartyId.PartyId\",\n        \"ListOfContacts.PerPartyId.PartyName\",\n        \"ListOfContacts.PerPartyId.JobTitle\",\n        \"ListOfContacts.PerPartyId.PrimaryEmail.EmailAddress\",\n        \"ListOfContacts.PerPartyId.PrimaryPhone.FormattedPhone\",\n        \"ListOfContacts.PerPartyId.PrimaryAddress.FormattedAddress\",\n        \"ListOfContacts.PerPartyId.DoNotContactFlag\",\n        \"ListOfContacts.RoleCd\"\n    ]\n};\n\nreturn payload;"
