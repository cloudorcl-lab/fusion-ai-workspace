        {
          "metadata": {
            "name": "Construct Output",
            "returnType": "array",
            "sourceCode": "const responseItems = Array.isArray($context.$nodes.GET_UPDATED_OBJECTIVES.$output?.items)\n  ? $context.$nodes.GET_UPDATED_OBJECTIVES.$output.items\n  : [];\n\nconst objectiveRows = [];\n\nfor (const objectiveRecord of responseItems) {\n  const objectiveStatus = String(objectiveRecord.objectiveStatus || \"NOT_STARTED\").toUpperCase();\n\n  // Hide completed objectives from the response.\n  if (objectiveStatus === \"COMPLETE\" || objectiveStatus === \"COMPLETED\") {\n    continue;\n  }\n\n  objectiveRows.push(objectiveRecord);\n}\n\n// Sort objectives by objective design-time display sequence.\nfor (let i = 0; i < objectiveRows.length; i += 1) {\n  for (let j = i + 1; j < objectiveRows.length; j += 1) {\n    const leftSequence = Number(objectiveRows[i].objectiveDesignTime?.displaySequence || 0);\n    const rightSequence = Number(objectiveRows[j].objectiveDesignTime?.displaySequence || 0);\n\n    if (rightSequence < leftSequence) {\n      const tempObjective = objectiveRows[i];\n      objectiveRows[i] = objectiveRows[j];\n      objectiveRows[j] = tempObjective;\n    }\n  }\n}\n\nconst mappedObjectives = [];\n\nfor (const objectiveRecord of objectiveRows) {\n  const runtimeHvas = Array.isArray(objectiveRecord.highValueActivities?.items)\n    ? objectiveRecord.highValueActivities.items\n    : [];\n\n  const designTimeHvas = Array.isArray(objectiveRecord.objectiveDesignTime?.salesMotionObjectiveHvas?.items)\n    ? objectiveRecord.objectiveDesignTime.salesMotionObjectiveHvas.items\n    : [];\n\n  const sortedHvas = [];\n  let runtimeIndex = 0;\n\n  for (const runtimeHva of runtimeHvas) {\n    const hvaStatus = String(runtimeHva.highValueActivityStatus || \"NOT_STARTED\").toUpperCase();\n\n    // Prefer the HVA design-time data attached to the runtime HVA.\n    // Fall back to the objective-level design-time HVA list when needed.\n    let designHva = runtimeHva.highValueActivityDesignTime;\n\n    if (!designHva) {\n      designHva = designTimeHvas[runtimeIndex];\n    }\n\n    if (!designHva) {\n      designHva = {};\n    }\n\n    runtimeIndex += 1;\n\n    // Hide completed HVAs from the response.\n    if (hvaStatus === \"COMPLETE\" || hvaStatus === \"COMPLETED\") {\n      continue;\n    }\n\n    sortedHvas.push({\n      highValueActivityId: runtimeHva.id,\n      highValueActivityStatus: runtimeHva.highValueActivityStatus,\n      justification: runtimeHva.justification,\n      name: designHva.name ?? null,\n      description: designHva.description ?? null,\n      evaluationText: designHva.evaluationText ?? null,\n      displaySequence: designHva.displaySequence ?? null\n    });\n  }\n\n  if (sortedHvas.length === 0) {\n    continue;\n  }\n\n  // Sort HVAs by design-time display sequence.\n  for (let i = 0; i < sortedHvas.length; i += 1) {\n    for (let j = i + 1; j < sortedHvas.length; j += 1) {\n      const leftSequence = Number(sortedHvas[i].displaySequence || 0);\n      const rightSequence = Number(sortedHvas[j].displaySequence || 0);\n\n      if (rightSequence < leftSequence) {\n        const tempHva = sortedHvas[i];\n        sortedHvas[i] = sortedHvas[j];\n        sortedHvas[j] = tempHva;\n      }\n    }\n  }\n\n  const hvaItems = [];\n\n  for (const sortedHva of sortedHvas) {\n    hvaItems.push({\n      highValueActivityId: sortedHva.highValueActivityId,\n      highValueActivityStatus: sortedHva.highValueActivityStatus,\n      justification: sortedHva.justification,\n      name: sortedHva.name,\n      description: sortedHva.description,\n      evaluationText: sortedHva.evaluationText\n    });\n  }\n\n  mappedObjectives.push({\n    objectiveId: objectiveRecord.id,\n    objectiveStatus: objectiveRecord.objectiveStatus,\n    name: objectiveRecord.objectiveDesignTime?.name ?? null,\n    highValueActivities: {\n      items: hvaItems\n    }\n  });\n}\n\nreturn mappedObjectives;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "CONSTRUCT_OUTPUT",
