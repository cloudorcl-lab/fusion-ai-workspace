        {
          "metadata": {
            "name": "Construct Full Context",
            "returnType": "object",
            "sourceCode": "var output = {};\n    output.opty_data = $context.$nodes.GET_ELASTIC_CONTEXT.$output.items;\n    output.engagements = $context.$nodes.GET_ENGAGEMENTS.$output.items;\n let parsedPayload;\n\nlet AIOutcomeResp=$context.$nodes.FETCH_FROM_AI_OUTCOME.$output;\nlet payload = AIOutcomeResp?.items[0]?.payload ?? {};\ntry {\n  parsedPayload = JSON.parse(payload);\n} catch (e) {\n  parsedPayload = {};\n}\nlet summary = parsedPayload?.what?.summary??\"\";\noutput.insight_data = summary?summary:$context.$nodes.GET_OPPORTUNITY_SUMMARY.$output.items??\"\";\n\n// list of properties to remove\nvar propsToRemove = [\"count\", \"hasMore\", \"limit\", \"offset\", \"links\", \"@context\",\"$context\"];\n\n// recursive cleanup\nvar stack = [output];\nwhile(stack.length > 0){\n    var current = stack.pop();\n    if(current && typeof current === \"object\"){\n        for(var key in current){\n            if(propsToRemove.indexOf(key) !== -1){\n                delete current[key];\n            } else if(typeof current[key] === \"object\"){\n                stack.push(current[key]);\n            }\n        }\n    }\n}\n\n// Clean HTML only from output.engagements[*].engagementRawText\nif (output.engagements && output.engagements.length) {\n    for (var i = 0; i < output.engagements.length; i++) {\n        var item = output.engagements[i];\n\n        if (\n            item &&\n            typeof item === \"object\" &&\n            typeof item.engagementRawText === \"string\" &&\n            /<\\/?[a-z][\\s\\S]*?>/i.test(item.engagementRawText)\n        ) {\n            var text = item.engagementRawText;\n\n            // Convert escaped REST newlines to real newlines\n            text = text.replace(/\\\\n/g, \"\\n\");\n\n            // Remove HTML comments\n            text = text.replace(/<!--[\\s\\S]*?-->/g, \"\");\n\n            // Remove non-visible HTML/CSS/JS sections\n            text = text.replace(/<style\\b[^>]*>[\\s\\S]*?<\\/style\\s*>/gi, \"\");\n            text = text.replace(/<script\\b[^>]*>[\\s\\S]*?<\\/script\\s*>/gi, \"\");\n            text = text.replace(/<head\\b[^>]*>[\\s\\S]*?<\\/head\\s*>/gi, \"\");\n\n            // Remove standalone technical tags\n            text = text.replace(/<meta\\b[^>]*\\/?>/gi, \"\");\n            text = text.replace(/<link\\b[^>]*\\/?>/gi, \"\");\n\n            // Preserve readable structure before removing tags\n            text = text.replace(/<br\\b[^>]*\\/?>/gi, \"\\n\");\n            text = text.replace(/<\\/p\\s*>/gi, \"\\n\");\n            text = text.replace(/<\\/div\\s*>/gi, \"\\n\");\n            text = text.replace(/<\\/li\\s*>/gi, \"\\n\");\n            text = text.replace(/<\\/tr\\s*>/gi, \"\\n\");\n            text = text.replace(/<\\/h[1-6]\\s*>/gi, \"\\n\");\n\n            // Add spacing for table cells\n            text = text.replace(/<\\/td\\s*>/gi, \" \");\n            text = text.replace(/<\\/th\\s*>/gi, \" \");\n\n            // Remove remaining HTML tags only when they look like real tags.\n            // This avoids damaging normal text such as \"amount < 100 > 50\".\n            text = text.replace(/<\\/?[a-z][a-z0-9:-]*(?:\\s[^<>]*)?>/gi, \"\");\n\n            // Decode common HTML entities\n            text = text.replace(/&nbsp;/gi, \" \");\n            text = text.replace(/&amp;/gi, \"&\");\n            text = text.replace(/&lt;/gi, \"<\");\n            text = text.replace(/&gt;/gi, \">\");\n            text = text.replace(/&quot;/gi, \"\\\"\");\n            text = text.replace(/&#39;/gi, \"'\");\n            text = text.replace(/&apos;/gi, \"'\");\n\n            // Decode numeric entities\ntext = text.replace(/&#(\\d+);/g, (match, code) =>\n    String.fromCharCode(Number(code))\n);\n\n       text = text.replace(/&#x([0-9a-f]+);/gi, (match, code) =>\n    String.fromCharCode(parseInt(code, 16))\n);\n\n            // Normalize whitespace but preserve the email content\n            text = text.replace(/\\r/g, \"\");\n            text = text.replace(/\\u00a0/g, \" \");\n            text = text.replace(/[ \\t]+/g, \" \");\n            text = text.replace(/[ \\t]+\\n/g, \"\\n\");\n            text = text.replace(/\\n[ \\t]+/g, \"\\n\");\n            text = text.replace(/\\n\\s*\\n\\s*\\n+/g, \"\\n\\n\");\n            text = text.trim();\n\n            item.engagementRawText = text;\n        }\n    }\n}\n\nreturn output;"
          },
