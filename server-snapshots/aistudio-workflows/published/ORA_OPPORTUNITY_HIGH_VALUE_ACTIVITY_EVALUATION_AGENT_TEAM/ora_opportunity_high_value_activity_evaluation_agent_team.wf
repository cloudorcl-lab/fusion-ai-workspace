        {
          "metadata": {
            "name": "Construct Context",
            "returnType": "object",
            "sourceCode": "let optyData;\nlet optySummary;\nlet engagementsData;\n\nlet incomingContext = $context.$triggers.REST.$input.context;\nlet contextBuilderData = null;\n\nif (incomingContext && incomingContext !== \"\") {\n    if (typeof incomingContext === \"string\") {\n        try {\n            contextBuilderData = JSON.parse(incomingContext);\n        } catch (e) {\n            contextBuilderData = null;\n        }\n    } else {\n        contextBuilderData = incomingContext;\n    }\n}\n\nif (contextBuilderData && contextBuilderData.result) {\n    optyData = contextBuilderData.result?.OPPORTUNITY ?? [];\n    optySummary = contextBuilderData.result?.ENGAGEMENT?.insight_data ?? \"\";\n    engagementsData = contextBuilderData.result?.ENGAGEMENT?.engagements ?? [];\n} else {\n    const fullContextResult = $context.$nodes.CONSTRUCT_FULL_CONTEXT.$output.result ?? {};\n\n    optyData = fullContextResult?.opty_data ?? [];\n    optySummary = fullContextResult?.insight_data ?? \"\";\n    engagementsData = fullContextResult?.engagements ?? [];\n}\n\nlet rawObjectivesData = $context.$nodes.GET_OBJECTIVES.$output ?? {};\nlet rawObjectiveItems = Array.isArray(rawObjectivesData.items) ? rawObjectivesData.items : [];\nlet filteredObjectiveItems = [];\n\nfor (let objectiveIndex = 0; objectiveIndex < rawObjectiveItems.length; objectiveIndex += 1) {\n    const sourceObjective = rawObjectiveItems[objectiveIndex];\n\n    if (!sourceObjective) {\n        continue;\n    }\n\n    // Child HVA status is the source of truth, not objectiveStatus.\n    let runtimeHvas = [];\n\n    if (\n        sourceObjective.highValueActivities &&\n        Array.isArray(sourceObjective.highValueActivities.items)\n    ) {\n        runtimeHvas = sourceObjective.highValueActivities.items;\n    }\n\n    if (runtimeHvas.length === 0) {\n        continue;\n    }\n\n    let completeCount = 0;\n    let notStartedCount = 0;\n\n    for (let statusIndex = 0; statusIndex < runtimeHvas.length; statusIndex += 1) {\n        const statusHva = runtimeHvas[statusIndex];\n        let childHvaStatus = \"NOT_STARTED\";\n\n        if (statusHva && statusHva.highValueActivityStatus) {\n            childHvaStatus = String(statusHva.highValueActivityStatus).toUpperCase();\n        }\n\n        if (childHvaStatus === \"COMPLETE\" || childHvaStatus === \"COMPLETED\") {\n            completeCount += 1;\n        }\n\n        if (childHvaStatus === \"NOT_STARTED\") {\n            notStartedCount += 1;\n        }\n    }\n\n    // Recalculate objective status from child HVAs.\n    let derivedObjectiveStatus = \"IN_PROGRESS\";\n\n    if (completeCount === runtimeHvas.length) {\n        derivedObjectiveStatus = \"COMPLETE\";\n    } else if (notStartedCount === runtimeHvas.length) {\n        derivedObjectiveStatus = \"NOT_STARTED\";\n    }\n\n    // Only send objectives that still have open HVAs.\n    if (derivedObjectiveStatus === \"COMPLETE\") {\n        continue;\n    }\n\n    let designTimeHvas = [];\n\n    if (\n        sourceObjective.objectiveDesignTime &&\n        sourceObjective.objectiveDesignTime.salesMotionObjectiveHvas &&\n        Array.isArray(sourceObjective.objectiveDesignTime.salesMotionObjectiveHvas.items)\n    ) {\n        designTimeHvas = sourceObjective.objectiveDesignTime.salesMotionObjectiveHvas.items;\n    }\n\n    let filteredHvas = [];\n\n    for (let hvaIndex = 0; hvaIndex < runtimeHvas.length; hvaIndex += 1) {\n        const runtimeHva = runtimeHvas[hvaIndex];\n\n        if (!runtimeHva) {\n            continue;\n        }\n\n        const hvaStatus = String(runtimeHva.highValueActivityStatus || \"NOT_STARTED\").toUpperCase();\n\n        // Completed HVAs should not be sent back to the AI for re-evaluation.\n        if (hvaStatus === \"COMPLETE\" || hvaStatus === \"COMPLETED\") {\n            continue;\n        }\n\n        let designHva = runtimeHva.highValueActivityDesignTime;\n\n        if (!designHva) {\n            designHva = designTimeHvas[hvaIndex];\n        }\n\n        if (!designHva) {\n            designHva = {};\n        }\n\n        filteredHvas.push({\n            id: runtimeHva.id,\n            highValueActivityStatus: runtimeHva.highValueActivityStatus || \"NOT_STARTED\",\n            justification: hvaStatus === \"IN_PROGRESS\" ? \"\" : runtimeHva.justification || \"\",\n            name: designHva.name != null ? designHva.name : null,\n            description: designHva.description != null ? designHva.description : null,\n            evaluationText: designHva.evaluationText != null ? designHva.evaluationText : null,\n            displaySequence: designHva.displaySequence != null ? designHva.displaySequence : null\n        });\n    }\n\n    if (filteredHvas.length === 0) {\n        continue;\n    }\n\n    const objectiveDesign = sourceObjective.objectiveDesignTime || {};\n\n    filteredObjectiveItems.push({\n        id: sourceObjective.id,\n        objectiveStatus: derivedObjectiveStatus,\n        name: objectiveDesign.name != null ? objectiveDesign.name : null,\n        description: objectiveDesign.description != null ? objectiveDesign.description : null,\n        displaySequence: objectiveDesign.displaySequence != null ? objectiveDesign.displaySequence : null,\n        highValueActivities: {\n            items: filteredHvas\n        }\n    });\n}\n\nconst objectivesData = {\n    items: filteredObjectiveItems,\n    hasMore: false\n};\n\nconst fullContext = {\n    opportunity_data: optyData,\n    opportunity_summary: optySummary,\n    engagements_data: engagementsData,\n    objectives_data: objectivesData\n};\n\nreturn fullContext;"
          },
          "outcomes": {
            "success": "1766212742914"
          },
          "code": "CONSTRUCT_CONTEXT",
          "id": "1766212706185",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
