            "sourceCode": "//Assumption: AssetNumber at: item.WoaInformation[0].WoaInformation.AssetInformation.AssetNumber\n// result => [{ AssetId, AssetNumber, OrganizationCode, PreviousCount, CurrentCount, WorkOrderNumber[], WorkOrderDescription[] }, ...]\n\nconst items = $context?.$nodes?.RETRIEVE_WORK_ORDERS?.$output?.items ?? [];\nconst arr = Array.isArray(items) ? items : [];\n\nconst today = new Date();\nconst daysAgo = d => new Date(today.getTime() - d * 24 * 60 * 60 * 1000);\n\nconst startPrev = daysAgo(90); \nconst endPrev   = daysAgo(45); \nconst startCurr = daysAgo(44); \nconst endCurr   = today;\n\nconst inRange = (d, start, end) => d >= start && d <= end;\n\nconst byAsset = new Map();\n\nfor (const it of arr) {\n  if (it?.WorkOrderType !== 'CORRECTIVE') continue;\n \n  const assetId = it?.WoaInformation?.[0]?.['WoaInformation.AssetInformation.AssetId'];\n  const assetNum = it?.WoaInformation?.[0]?.['WoaInformation.AssetInformation.AssetNumber'];\n  const OrgCode = it?.['WorkOrderOrganizationInformation.WorkOrderOrganizationCode'];\n  if (!assetNum) continue;\n\n  const d = it?.PlannedStartDate ? new Date(it.PlannedStartDate) : null;\n  if (!(d instanceof Date) || isNaN(d)) continue;\n\n  const rec = byAsset.get(assetNum) || { AssetId: assetId, AssetNumber: assetNum, OrganizationCode: OrgCode, PreviousCount: 0, CurrentCount: 0, WorkOrderNumber:[] , WorkOrderDescription:[] };\n\n  if (inRange(d, startPrev, endPrev)) {\n       rec.PreviousCount += 1;\n       rec.WorkOrderNumber.push(it?.WorkOrderNumber);\n       rec.WorkOrderDescription.push(it?.WorkOrderDescription);\n   }\n  else if (inRange(d, startCurr, endCurr)) {\n    rec.CurrentCount += 1;\n    rec.WorkOrderNumber.push(it?.WorkOrderNumber);\n    rec.WorkOrderDescription.push(it?.WorkOrderDescription);\n  }\n\n  byAsset.set(assetNum, rec);\n}\n\nconst assetArray = Array.from(byAsset.values()).sort((a, b) => (b?.CurrentCount ?? 0) - (a?.CurrentCount ?? 0));\n\nreturn assetArray;"
