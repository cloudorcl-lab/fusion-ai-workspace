        {
          "metadata": {
            "name": "Get Date Ranges",
            "returnType": "object",
            "sourceCode": "// Get current date (may be string or Date depending on platform)\nconst today = $context.$system.$currentDate ;\n\n// StartDate = today - 90 days\nconst startDateObj = new Date(today);\nstartDateObj.setDate(startDateObj.getDate() - 90);\n\n// EndDate = today\nconst endDateObj = new Date(today);\nendDateObj.setDate(endDateObj.getDate());\n\nconst StartDate = startDateObj.toISOString().split('T')[0];\nconst EndDate = endDateObj.toISOString().split('T')[0];\n\nconst result = {StartDate, EndDate};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1767829131449"
          },
