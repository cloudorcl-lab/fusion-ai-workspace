          "metadata": {
            "name": "Get Context Data",
            "returnType": "object",
            "sourceCode": "//Get Org Context\nconst appContext = $context.$app.$OraAppContext ?? $context.$triggers.REST.$input.OraAppContext;\nlet OrganizationId;\n\n// Check for all empty cases: undefined, null, empty string, and whitespace only\nif (appContext && String(appContext).trim() !== '') {\n    try {\n        // Try parsing as JSON\n        const contextObj = JSON.parse(appContext);\n        OrganizationId = contextObj.OrganizationId;\n    } catch (e) {\n        // Fallback: comma-separated string\n       OrganizationId= String(appContext).trim();\n    }\n}\n\nlet Limit = 100;\nlet Query ='CORRECTIVE';\nlet SearchFieldsArr =['WorkOrderType'];\n\nif ((($context?.$app?.$OraMessageHint ?? $context?.$triggers?.REST?.$input?.OraMessageHint) === 'AdditionalContent')) {\n  Limit = 200;\n  Query = null;\n  SearchFieldsArr = null;\n}\n\nreturn {OrganizationId,Limit,Query,SearchFieldsArr};"
          },
          "outcomes": {
            "success": "1767830696580"
          },
          "code": "GET_CONTEXT_DATA",
          "id": "1769778727085",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
