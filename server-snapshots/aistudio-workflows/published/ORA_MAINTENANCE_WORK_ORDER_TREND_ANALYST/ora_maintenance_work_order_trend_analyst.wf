            {
              "id": "1768330027217_1",
              "name": "prompt",
              "type": "string",
              "value": "Given the data in `{{$context.$nodes.RETRIEVE_WORK_ORDERS.$output.items}}`, generate an automated email highlighting the top 3 assets with the highest count of recurring corrective work orders. Recommend that the recipient reviews these assets to determine whether continued repair or asset replacement is more appropriate.\n\n- `title`: Assets with the Highest Increase in Corrective Work Orders\n- `description`: Provide a one-sentence summary of the findings.\n- `actionText`: Send\n- Email content should include the count of corrective work orders for each of the top assets.\n- Write the email content using rich text and include appropriate HTML tags for formatting (such as `<b>`, `<ul>`, `<li>`, etc.).\n\nReturn only the completed email with HTML formatting, ready to send."
            }
          ],
          "type": "LLM"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_CHART"
              ],
              "enableActions": false,
              "enableCommunications": false,
              "customNotes": "Display the total number of Preventive (planned) work orders and Corrective (unplanned) work orders in a bar chart widget.  \nGroup the data by month and stack planned and unplanned work orders in each month's bar.  \nSet the chart title as a short headline: \"Planned and Unplanned Work Orders\".  \nGenerate 1–2 concise insights based on the data to highlight notable trends or comparisons.  \nNote: The chart reflects work orders retrieved through the current data integration, so some work orders in the system may not be shown due to data retrieval limits.  \nShow only the bar chart and generated insights."
            }
          },
          "metadata": {
            "name": "VisualizePlannedUnplanned"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "VISUALIZE_PLANNED_UNPLANNED",
          "id": "1768334909751",
          "inputs": [
            {
              "id": "1768334909753_1",
              "name": "prompt",
              "type": "string",
              "value": "Use {{$context.$nodes.POPULATE_PLANNED_VS_CORRECTIVE_WORK_ORDERS.$output.result}} for displaying.\nEach row in above Array\nkey : month - year\ncorrective: Work orders with `WorkOrderType` equal to `\"CORRECTIVE\"`. These are considered Corrective (Unplanned) work orders.\npreventive: Work orders with `WorkOrderType` equal to `\"PREVENTIVE\"`. These considered Preventive (Planned) work orders.\n\n**Widget Requirements:**\n- **Title:** Planned vs Unplanned Work Orders — Last 90 Days\n- **Subtitle/Summary** Distribution of preventive and corrective work orders over the past three months\n"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Aggregate record for Each Asset",
            "returnType": "array",
            "sourceCode": "//Assumption: AssetNumber at: item.WoaInformation[0].WoaInformation.AssetInformation.AssetNumber\n// result => [{ AssetId, AssetNumber, OrganizationCode, PreviousCount, CurrentCount, WorkOrderNumber[], WorkOrderDescription[] }, ...]\n\nconst items = $context?.$nodes?.RETRIEVE_WORK_ORDERS?.$output?.items ?? [];\nconst arr = Array.isArray(items) ? items : [];\n\nconst today = new Date();\nconst daysAgo = d => new Date(today.getTime() - d * 24 * 60 * 60 * 1000);\n\nconst startPrev = daysAgo(90); \nconst endPrev   = daysAgo(45); \nconst startCurr = daysAgo(44); \nconst endCurr   = today;\n\nconst inRange = (d, start, end) => d >= start && d <= end;\n\nconst byAsset = new Map();\n\nfor (const it of arr) {\n  if (it?.WorkOrderType !== 'CORRECTIVE') continue;\n \n  const assetId = it?.WoaInformation?.[0]?.['WoaInformation.AssetInformation.AssetId'];\n  const assetNum = it?.WoaInformation?.[0]?.['WoaInformation.AssetInformation.AssetNumber'];\n  const OrgCode = it?.['WorkOrderOrganizationInformation.WorkOrderOrganizationCode'];\n  if (!assetNum) continue;\n\n  const d = it?.PlannedStartDate ? new Date(it.PlannedStartDate) : null;\n  if (!(d instanceof Date) || isNaN(d)) continue;\n\n  const rec = byAsset.get(assetNum) || { AssetId: assetId, AssetNumber: assetNum, OrganizationCode: OrgCode, PreviousCount: 0, CurrentCount: 0, WorkOrderNumber:[] , WorkOrderDescription:[] };\n\n  if (inRange(d, startPrev, endPrev)) {\n       rec.PreviousCount += 1;\n       rec.WorkOrderNumber.push(it?.WorkOrderNumber);\n       rec.WorkOrderDescription.push(it?.WorkOrderDescription);\n   }\n  else if (inRange(d, startCurr, endCurr)) {\n    rec.CurrentCount += 1;\n    rec.WorkOrderNumber.push(it?.WorkOrderNumber);\n    rec.WorkOrderDescription.push(it?.WorkOrderDescription);\n  }\n\n  byAsset.set(assetNum, rec);\n}\n\nconst assetArray = Array.from(byAsset.values()).sort((a, b) => (b?.CurrentCount ?? 0) - (a?.CurrentCount ?? 0));\n\nreturn assetArray;"
          },
          "outcomes": {
            "success": "1765904708021"
          },
          "code": "AGGREGATE_RECORD_FOR_EACH_ASSET",
          "id": "1770907564411",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Populate Planned vs Corrective Work Orders",
            "returnType": "array",
            "sourceCode": "const items = $context?.$nodes?.RETRIEVE_WORK_ORDERS?.$output?.items ?? [];\n\n// Month key like \"Nov 2025\" (UTC to avoid TZ drift)\nconst monthKey = (d) => {\n  const m = d.getMonth()+1; // 0=Jan, 11=Dec\n  const y = d.getUTCFullYear();\n  return `${m} - ${y}`;\n};\n\nconst monthMap = new Map(); // key -> { corr, prev }\n\nfor (const it of items) {\n  const ds = String(it?.PlannedStartDate ?? '').trim();\n  if (!ds) continue;\n  const d = new Date(ds);\n  if (Number.isNaN(d.getTime())) continue;\n\n  const key = monthKey(d);\n  const agg = monthMap.get(key) || { key: key, corrective: 0, preventive: 0 };\n\n  const type = it?.WorkOrderType;\n  if (type === 'CORRECTIVE') {\n      agg.corrective += 1;\n  }\n  else if (type === 'PREVENTIVE') {\n    agg.preventive += 1;\n  }\n\n  monthMap.set(key, agg);\n}\n\nreturn Array.from(monthMap.values());"
          },
          "outcomes": {
            "success": "1768334909751"
          },
          "code": "POPULATE_PLANNED_VS_CORRECTIVE_WORK_ORDERS",
          "id": "1770967702988",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Data for Each Asset",
            "returnType": "array",
            "sourceCode": "//Assumption: AssetNumber at: item.WoaInformation[0].WoaInformation.AssetInformation.AssetNumber\n// result => [{ AssetId, AssetNumber, OrganizationCode, PreviousCount, CurrentCount, WorkOrderDescription[] }, ...]\n\nconst items = $context?.$nodes?.RETRIEVE_WORK_ORDERS?.$output?.items ?? [];\nconst arr = Array.isArray(items) ? items : [];\n\nconst today = new Date();\nconst daysAgo = d => new Date(today.getTime() - d * 24 * 60 * 60 * 1000);\n\nconst startPrev = daysAgo(90); \nconst endPrev   = daysAgo(45); \nconst startCurr = daysAgo(44); \nconst endCurr   = today;\n\nconst inRange = (d, start, end) => d >= start && d <= end;\n\nconst byAsset = new Map();\n\nfor (const it of arr) {\n  if (it?.WorkOrderType !== 'CORRECTIVE') continue;\n \n  const assetId = it?.WoaInformation?.[0]?.['WoaInformation.AssetInformation.AssetId'];\n  const assetNum = it?.WoaInformation?.[0]?.['WoaInformation.AssetInformation.AssetNumber'];\n  const OrgCode = it?.['WorkOrderOrganizationInformation.WorkOrderOrganizationCode'];\n  if (!assetNum) continue;\n\n  const d = it?.PlannedStartDate ? new Date(it.PlannedStartDate) : null;\n  if (!(d instanceof Date) || isNaN(d)) continue;\n\n  const rec = byAsset.get(assetNum) || { AssetId: assetId, AssetNumber: assetNum, OrganizationCode: OrgCode, PreviousCount: 0, CurrentCount: 0, WorkOrderDescription:[] };\n\n  if (inRange(d, startPrev, endPrev)) {\n       rec.PreviousCount += 1;\n       rec.WorkOrderDescription.push(it?.WorkOrderDescription);\n   }\n  else if (inRange(d, startCurr, endCurr)) {\n    rec.CurrentCount += 1;\n    rec.WorkOrderDescription.push(it?.WorkOrderDescription);\n  }\n\n  byAsset.set(assetNum, rec);\n}\n\nreturn Array.from(byAsset.values());"
          },
          "outcomes": {
            "success": "1766508063274"
          },
          "code": "DATA_FOR_EACH_ASSET",
          "id": "1771689169079",
