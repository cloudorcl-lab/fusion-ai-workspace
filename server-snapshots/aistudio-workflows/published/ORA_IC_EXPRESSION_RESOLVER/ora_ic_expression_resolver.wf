{
  "workflowId": "300000331067433",
  "workflowCode": "ORA_IC_EXPRESSION_RESOLVER",
  "name": "IC Expression Resolver",
  "description": "Resolves {variables} in formulas to IC attribute paths using the IC catalog. Returns plan with _resolution metadata merged into formulas and rate table dimensions.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "id": "start",
          "code": "START",
          "type": "START",
          "metadata": {
            "name": "Start",
            "description": "Start of data pipeline"
          },
          "outcomes": {
            "success": "1"
          },
          "inputs": [],
          "diagram": {
            "x": 5000,
            "y": 5000
          }
        },
        {
          "id": "1",
          "code": "STORE_INPUTS",
          "type": "SET_FIELDS",
          "metadata": {
            "name": "Store Inputs"
          },
          "outcomes": {
            "success": "2"
          },
          "inputs": [
            {
              "id": "1_assembledPlan",
              "name": "assembledPlan",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.assembledPlan}}"
            },
            {
              "id": "1_orgCatalog",
              "name": "orgCatalog",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.orgCatalog || null}}"
            },
            {
              "id": "1_icCatalogFallback",
              "name": "icCatalogFallback",
              "type": "string",
              "value": "{\"icFunctionCatalog\": {\"comparisonFunctions\": [{\"name\": \"CHOICE\", \"signature\": \"CHOICE(Condition 1*, Value 1*, Condition 2, Value 2, ...Condition n, Value n, Value Z*)\", \"description\": \"IF-THEN-ELSE logic for conditional values\"}, {\"name\": \"IS_EQUAL\", \"signature\": \"IS_EQUAL(Value 1*, Value 2*)\"}, {\"name\": \"IS_GREATER\", \"signature\": \"IS_GREATER(Value 1*, Value 2*)\"}, {\"name\": \"IS_LESS\", \"signature\": \"IS_LESS(Value 1*, Value 2*)\"}, {\"name\": \"IS_BETWEEN\", \"signature\": \"IS_BETWEEN(Value*, Min*, Max*)\"}, {\"name\": \"IS_IN\", \"signature\": \"IS_IN(Value*, In Value 1*, ...In Value n)\"}, {\"name\": \"IS_LIKE\", \"signature\": \"IS_LIKE(Value 1*, Value 2*)\"}, {\"name\": \"GREATEST\", \"signature\": \"GREATEST(Value 1*, Value 2*, ...Value n)\"}, {\"name\": \"LEAST\", \"signature\": \"LEAST(Value 1*, Value 2*, ...Value n)\"}], \"logicalOperations\": [{\"name\": \"AND\", \"signature\": \"AND(Condition 1*, Condition 2, ...Condition n)\"}, {\"name\": \"OR\", \"signature\": \"OR(Condition 1*, Condition 2, ...Condition n)\"}, {\"name\": \"NOT\", \"signature\": \"NOT(Condition*)\"}], \"nullFunctions\": [{\"name\": \"IS_NULL\", \"signature\": \"IS_NULL(Value*)\"}, {\"name\": \"NVL\", \"signature\": \"NVL(Value*, Default Value*)\"}], \"aggregateFunctions\": [{\"name\": \"SUM\", \"signature\": \"SUM(Value*)\"}, {\"name\": \"AVG\", \"signature\": \"AVG(Value*)\"}, {\"name\": \"COUNT\", \"signature\": \"COUNT(Value*)\"}, {\"name\": \"MAX\", \"signature\": \"MAX(Value*)\"}, {\"name\": \"MIN\", \"signature\": \"MIN(Value*)\"}, {\"name\": \"MEDIAN\", \"signature\": \"MEDIAN(Value*)\"}, {\"name\": \"STDDEV\", \"signature\": \"STDDEV(Value*)\"}, {\"name\": \"VARIANCE\", \"signature\": \"VARIANCE(Value*)\"}], \"numberFunctions\": [{\"name\": \"ROUND\", \"signature\": \"ROUND(Value*, Decimal Places)\"}, {\"name\": \"TRUNC\", \"signature\": \"TRUNC(Value*, Decimal Places)\"}, {\"name\": \"EXP\", \"signature\": \"EXP(Value*)\"}, {\"name\": \"SIGN\", \"signature\": \"SIGN(Value*)\"}, {\"name\": \"ABS\", \"signature\": \"ABS(Value*)\"}, {\"name\": \"CEIL\", \"signature\": \"CEIL(Value*)\"}, {\"name\": \"FLOOR\", \"signature\": \"FLOOR(Value*)\"}, {\"name\": \"MOD\", \"signature\": \"MOD(Value 1*, Value 2*)\"}, {\"name\": \"POWER\", \"signature\": \"POWER(Base*, Exponent*)\"}, {\"name\": \"SQRT\", \"signature\": \"SQRT(Value*)\"}], \"textFunctions\": [{\"name\": \"CONCAT\", \"signature\": \"CONCAT(String 1*, String 2*, ...)\"}, {\"name\": \"INSTR\", \"signature\": \"INSTR(String*, Substring*)\"}, {\"name\": \"LPAD\", \"signature\": \"LPAD(String*, Length, Pad)\"}, {\"name\": \"RPAD\", \"signature\": \"RPAD(String*, Length, Pad)\"}, {\"name\": \"SUBSTRING\", \"signature\": \"SUBSTRING(String*, Start*, Length)\"}, {\"name\": \"SUBSTR\", \"signature\": \"SUBSTR(String*, Start*, Length)\"}, {\"name\": \"UPPER\", \"signature\": \"UPPER(String*)\"}, {\"name\": \"LOWER\", \"signature\": \"LOWER(String*)\"}, {\"name\": \"LENGTH\", \"signature\": \"LENGTH(String*)\"}, {\"name\": \"REPLACE\", \"signature\": \"REPLACE(String*, Search*, Replacement)\"}, {\"name\": \"TRIM\", \"signature\": \"TRIM(String*)\"}], \"dateFunctions\": [{\"name\": \"ADD_MONTHS\", \"signature\": \"ADD_MONTHS(Date*, Months*)\"}, {\"name\": \"MONTHS_BETWEEN\", \"signature\": \"MONTHS_BETWEEN(Date 1*, Date 2*)\"}, {\"name\": \"TO_DATE\", \"signature\": \"TO_DATE(String*, Format)\"}, {\"name\": \"LAST_DAY\", \"signature\": \"LAST_DAY(Date*)\"}, {\"name\": \"SYSDATE\", \"signature\": \"SYSDATE\"}], \"conversionFunctions\": [{\"name\": \"TO_NUMBER\", \"signature\": \"TO_NUMBER(Value*)\"}, {\"name\": \"TO_CHAR\", \"signature\": \"TO_CHAR(Value*, Format)\"}, {\"name\": \"DECODE\", \"signature\": \"DECODE(Expression*, Search 1*, Result 1*, ..., Default)\"}], \"valueSetFunctions\": [{\"name\": \"SUM_VALUE_SET\", \"signature\": \"SUM_VALUE_SET(UDQ) | SUM_VALUE_SET(UDQ(param1, param2, ...))\", \"description\": \"Sum values from a UDQ result set\"}, {\"name\": \"COUNT_VALUE_SET\", \"signature\": \"COUNT_VALUE_SET(UDQ) | COUNT_VALUE_SET(UDQ(param1, param2, ...))\", \"description\": \"Count values in a UDQ result set\"}, {\"name\": \"MAX_VALUE_SET\", \"signature\": \"MAX_VALUE_SET(UDQ) | MAX_VALUE_SET(UDQ(param1, param2, ...))\", \"description\": \"Max value from a UDQ result set\"}, {\"name\": \"MIN_VALUE_SET\", \"signature\": \"MIN_VALUE_SET(UDQ) | MIN_VALUE_SET(UDQ(param1, param2, ...))\", \"description\": \"Min value from a UDQ result set\"}, {\"name\": \"AVG_VALUE_SET\", \"signature\": \"AVG_VALUE_SET(UDQ) | AVG_VALUE_SET(UDQ(param1, param2, ...))\", \"description\": \"Average of values from a UDQ result set\"}, {\"name\": \"COUNT_DISTINCT_VALUE_SET\", \"signature\": \"COUNT_DISTINCT_VALUE_SET(UDQ) | COUNT_DISTINCT_VALUE_SET(UDQ(param1, param2, ...))\", \"description\": \"Count distinct values in a UDQ result set\"}], \"rateTable\": [{\"name\": \"RTR\", \"signature\": \"RTR\", \"description\": \"Rate table reference token; IC resolves against the associated rate table\"}]}, \"icBaseAttributes\": {\"creditAttributes\": [{\"name\": \"Credit.Participant\", \"description\": \"Participant associated with the credit\"}, {\"name\": \"Credit.Area Code\", \"description\": \"Area code from credit\"}, {\"name\": \"Credit.City\", \"description\": \"City from credit\"}, {\"name\": \"Credit.State\", \"description\": \"State from credit\"}, {\"name\": \"Credit.Country\", \"description\": \"Country from credit\"}, {\"name\": \"Credit.Transaction Type\", \"description\": \"Type of transaction\"}, {\"name\": \"Credit.Model Number\", \"description\": \"Model number from credit\"}, {\"name\": \"Credit.Split Percent\", \"description\": \"Split percentage for credit\"}, {\"name\": \"Credit.Revenue Type\", \"description\": \"Type of revenue\"}, {\"name\": \"Credit.Credit Amount\", \"description\": \"Credit amount value\"}], \"planAttributes\": [{\"name\": \"Plan.Plan Payout Type\", \"description\": \"Payout type for the plan\"}, {\"name\": \"Plan.Target Incentive\", \"description\": \"Target incentive amount\"}, {\"name\": \"Plan.Customer Creation\", \"description\": \"Customer creation indicator\"}], \"participantAttributes\": [{\"name\": \"Participant.Salary\", \"description\": \"Participant salary\"}, {\"name\": \"Participant.Currency Code\", \"description\": \"Currency code\"}, {\"name\": \"Participant.Country Code\", \"description\": \"Country code\"}, {\"name\": \"Participant.Cost Center\", \"description\": \"Cost center\"}], \"planComponentAttributes\": [{\"name\": \"Plan component.TI Weight\", \"description\": \"Target incentive weight\"}], \"measureAttributes\": [{\"name\": \"Measure.Weight\", \"description\": \"Measure weight\"}, {\"name\": \"Measure.Event Factor\", \"description\": \"Event factor\"}, {\"name\": \"Measure.Credit Factor\", \"description\": \"Credit factor\"}, {\"name\": \"Measure.Interval Target\", \"description\": \"Interval target\"}, {\"name\": \"Measure.Target\", \"description\": \"Target value\"}, {\"name\": \"Measure.ITD Target\", \"description\": \"Interval-to-date target\"}, {\"name\": \"Measure.Period Target\", \"description\": \"Period target\"}]}, \"measureResultAttributes\": [{\"name\": \"Output Achieved\", \"description\": \"Output achieved for per-event context\"}, {\"name\": \"PTD Output Achieved\", \"description\": \"Period-to-date output achieved\"}, {\"name\": \"ITD Output Achieved\", \"description\": \"Interval-to-date output achieved\"}, {\"name\": \"Attainment\", \"description\": \"Attainment percentage for current period\"}, {\"name\": \"ITD Attainment\", \"description\": \"Interval-to-date attainment\"}, {\"name\": \"Target\", \"description\": \"Target for current period\"}, {\"name\": \"ITD Target\", \"description\": \"Interval-to-date target\"}], \"componentResultAttributes\": [{\"name\": \"Calculated Amount\", \"description\": \"Calculated incentive amount\"}, {\"name\": \"Input Achieved\", \"description\": \"Input achieved for per-event processing\"}, {\"name\": \"ITD Input Achieved\", \"description\": \"Input achieved aggregated to interval-to-date\"}, {\"name\": \"PTD Input Achieved\", \"description\": \"Input achieved aggregated to period-to-date\"}, {\"name\": \"Target Incentive\", \"description\": \"Target incentive for the component\"}, {\"name\": \"Paid Amount\", \"description\": \"Amount paid out\"}]}"
            },
            {
              "id": "1_orgId",
              "name": "orgId",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.orgId || 204}}"
            },
            {
              "id": "1_scopedExpressionRequests",
              "name": "scopedExpressionRequests",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.scopedExpressionRequests || null}}"
            }
          ],
          "diagram": {
            "x": 5000,
            "y": 5246
          }
        },
        {
          "id": "2",
          "code": "RESOLVE_CATALOG",
          "type": "CODE",
          "metadata": {
            "name": "Resolve Catalog",
            "returnType": "object",
            "sourceCode": "// RESOLVE_CATALOG - Extract catalog only from caller-provided orgCatalog.\n\nvar orgCatalogInput = $context.$variables.orgCatalog;\n\nvar parseJson = function(value) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n  if (typeof value !== 'string') {\n    return value;\n  }\n  try {\n    return JSON.parse(value);\n  } catch (_err) {\n    return null;\n  }\n};\n\nvar extractCatalog = function(candidate) {\n  var obj = parseJson(candidate);\n  if (!obj || typeof obj !== 'object') {\n    return null;\n  }\n\n  if (obj.expressionCatalog && typeof obj.expressionCatalog === 'object') {\n    return obj.expressionCatalog;\n  }\n\n  if (obj.catalog && typeof obj.catalog === 'object') {\n    if (obj.catalog.expressionCatalog && typeof obj.catalog.expressionCatalog === 'object') {\n      return obj.catalog.expressionCatalog;\n    }\n    return obj.catalog;\n  }\n\n  if (obj.result) {\n    var fromResult = extractCatalog(obj.result);\n    if (fromResult) {\n      return fromResult;\n    }\n  }\n\n  if (obj.output) {\n    var fromOutput = extractCatalog(obj.output);\n    if (fromOutput) {\n      return fromOutput;\n    }\n  }\n\n  return null;\n};\n\nvar sliceCatalog = function(catalog) {\n  if (!catalog || typeof catalog !== 'object') {\n    return null;\n  }\n  var out = new Object();\n  if (catalog.expressionDetailTypes) {\n    out.expressionDetailTypes = catalog.expressionDetailTypes;\n  }\n  if (catalog.icBaseAttributes) {\n    out.icBaseAttributes = catalog.icBaseAttributes;\n  }\n  if (catalog.measureResultAttributes) {\n    out.measureResultAttributes = catalog.measureResultAttributes;\n  }\n  if (catalog.componentResultAttributes) {\n    out.componentResultAttributes = catalog.componentResultAttributes;\n  }\n  if (catalog.icFunctionCatalog) {\n    out.icFunctionCatalog = catalog.icFunctionCatalog;\n  }\n  return out;\n};\n\nvar catalog = extractCatalog(orgCatalogInput);\nvar result = new Object();\n\nif (catalog) {\n  result.icCatalog = JSON.stringify(sliceCatalog(catalog));\n  result.source = 'orgCatalog';\n} else {\n  result.icCatalog = '';\n  result.source = 'missing';\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "3"
          },
          "inputs": [],
          "diagram": {
            "x": 5000,
            "y": 5468
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "3",
          "code": "SET_CATALOG",
          "type": "SET_FIELDS",
          "metadata": {
            "name": "Set Catalog"
          },
          "outcomes": {
            "success": "4"
          },
          "inputs": [
            {
              "id": "3_icCatalog",
              "name": "icCatalog",
              "type": "string",
              "value": "{{$context.$nodes.RESOLVE_CATALOG.$output.result.icCatalog}}"
            }
          ],
          "diagram": {
            "x": 5000,
            "y": 5690
          }
        },
        {
          "id": "4",
          "code": "RESOLVE_EXPRESSIONS",
          "type": "LLM",
          "metadata": {
            "name": "Resolve Expressions",
            "temperature": 0.1,
            "maxTokens": 8000,
            "reasoningEffort": "low"
          },
          "outcomes": {
            "success": "5"
          },
          "inputs": [
            {
              "id": "4_prompt",
              "name": "prompt",
              "type": "string",
              "value": "You are the Expression LLM Agent. Your task is to MAP business-friendly variable names to IC attribute paths and return the fully ordered expression token stream.\n\n=== CRITICAL OUTPUT REQUIREMENT ===\nReturn ONLY raw JSON. No markdown code fences (```). No explanations. No text before or after.\nIf you return anything except pure JSON, the system will fail.\n\n=== TASK SUMMARY ===\nFor EACH formula or dimensional input in the plan:\n0. copy the exact builder-generated expression id for that instance into `expressionId`\n1. map EACH {variable} to the correct IC attribute path\n2. return the FULL ordered token stream for the resolved or partially resolved expression\n3. return a concise, non-empty business-facing `description` of the canonical token expression\n\n**Four input types to process:**\n1. **Incentive Formulas** - Located at: planComponents[].formulas[] (component-level payout formulas)\n2. **Measure Formulas** - Located at: planComponents[].performanceMeasures[].formula (measure calculation formulas)\n3. **Rate Table Input Expressions** - Located at: planComponents[].rateTables[].dimensions[].inputExpression (determines tier selection)\n4. **Measure Dimensional Inputs** - Located at: planComponents[].performanceMeasures[].rateDimensionalInputs[].inputExpression (scorecard dimension inputs)\n\nThis is a LOOKUP task - all data is provided explicitly below.\n\n=== CANONICALIZATION AUTHORITY (CRITICAL) ===\nYou are the canonical constructor of executable expression tokens for this workflow.\n- Builder/editor inputs may contain business wording, partially normalized pseudo-IC syntax, direct IC-like text, or draft simpleExpression text.\n- Do NOT assume the incoming `simpleExpression`, `displayText`, variable list, or upstream function names are already canonical.\n- Reconstruct the executable token stream from the full expression intent and the provided catalog/context, then return the canonical tokens.\n- If upstream text is only partially canonical, use it as evidence but still return the nearest supported executable tokenization.\n- Treat upstream text as evidence, not as the final executable authority.\n\n=== EXPRESSION IDENTITY (CRITICAL) ===\nEvery resolvable instance in the assembled plan includes a builder-generated identity:\n- Formula expressions use `expression.expressionId`\n- Rate-table and scorecard dimensional inputs use the top-level `expressionId` field on that input row\n\nYou MUST copy that exact id into the returned `expressionId` field for the matching resolution row.\nDo not invent ids. Do not omit ids. Do not merge repeated-looking expressions that have different ids.\n\n=== ASSEMBLED PLAN (Full Context) ===\n{{$context.$variables.assembledPlan}}\n\n=== SCOPED EXPRESSION REQUESTS (Optional) ===\n{{$context.$variables.scopedExpressionRequests}}\n\nIf this value is a non-empty JSON array, resolve ONLY those requested expression carriers. Use the full assembled plan as context, but return `resolutions[]` rows only for the listed `expressionId` values. Do not return rows for non-target formulas or input expressions.\n\nScoped edit requests may include `dependencyRefs` or `resolverAuthority.dependencyRefs`. Treat those refs as the complete Brain-authorized business dependency scope for that expression edit. Use the full assembled plan for lookup context, but do not introduce measure, component, rate table, scorecard, or rate dimension references outside the request dependency refs. If the requested expression cannot be resolved within that dependency scope, return unresolved details for that expression rather than selecting a similarly named entity elsewhere in the plan.\n\nFor unscoped build/full-plan resolution, the carrier expression fields (`simpleExpression`, `inputExpression`, and `displayText`) are the source expression to canonicalize. These requests may not include `currentTokens`; create the canonical tokens from the expression fields and available context.\n\nFor scoped edit requests, resolve each listed `expressionId` independently. If the request includes `editInstruction`, first establish the current expression from the best available existing expression evidence, in this order: request `currentTokens`, carrier `tokens` in the assembled plan, then `expressionText`/carrier `simpleExpression`/`inputExpression`/`displayText`. Existing tokens are the source of truth for edit-instruction requests, so do not ignore them just because `expressionText` is empty. Apply `editInstruction` to that current expression to produce the new expression before resolving it. If there is no `editInstruction`, treat that request's `expressionText`/carrier `simpleExpression`/`inputExpression` as the expression being resolved, and use `userMessage` only as context for disambiguation and canonicalization. Do not copy formula logic from another expression in the same user message into the current `expressionId`.\nWhen scoped `expressionText` is supplied as an exact/direct formula replacement, including pasted IC-style formula text, parse and canonicalize that expression itself. Preserve its arithmetic and reference semantics; do not reinterpret it as a natural-language instruction and do not substitute a different business formula. If a referenced attribute, measure, component, rate table, scorecard, function, or syntax element cannot be resolved within the authorized context, return unresolved details for that expression instead of inventing a substitute.\nScoped `expressionText`/`simpleExpression` may be planner shorthand. Do not echo unsupported planner shorthand; repair it into canonical IC tokens.\nWhen an `editInstruction` is present, canonicalization is only the starting point. First normalize the current expression into the closest executable IC expression, then apply the requested transformation to that normalized expression. The final returned tokens must reflect the transformed expression, not merely a canonicalized version of the original expression.\nFor whole-expression arithmetic transformations, preserve the whole current expression as the operand. Parenthesize the operand when needed to preserve precedence, then apply the requested arithmetic operation outside it.\nFor `editInstruction` requests, the returned `description` must describe the final transformed expression, not the prior expression. Do not reuse an old carrier or formula description when the final tokens add, remove, divide, multiply, cap, floor, round, default, or otherwise transform the prior expression. Mention the business effect of the transformation and any material arithmetic factor or threshold introduced by the edit.\n\n=== PERCENT-SCALE NUMBERS ===\nWhen the intended value is a percentage used as a rate, factor, commission rate, payout rate, weight, or multiplier, emit the equivalent fractional numeric token in the executable expression. For example, N percent as a multiplier is N / 100.\n\nWhen the intended operation is to convert a ratio or attainment value into percent-scale output, emit the explicit conversion operation requested by the user, such as multiplying by 100.\n\nDo not conflate these two cases:\n- percent-as-multiplier: use the fractional rate\n- ratio-to-percent conversion: use the requested scale conversion\n\n=== IC CATALOG (Available Attributes) ===\n{{$context.$variables.icCatalog}}\n\n=== ATTRIBUTE LABELS (MANDATORY) ===\nUse the provided attribute lists for measure/component result labels. You are responsible for semantic catalog matching; downstream code will preserve your selected label and will not infer missing time grain from user wording.\n\nProcess:\n1. Choose semantic intent first (for example: BASE, PTD, ITD).\n2. Pick the closest label from provided attributes:\n   - measureResultAttributes for measureResultAttribute\n   - componentResultAttributes for componentResultAttribute\n   - for cross-component measure references, use measureResultAttributes for componentMeasureResultAttribute\n   - use componentResultAttributes only for pure component-level results that do not name a measure\n3. Match labels by meaning (case-insensitive, token-order-insensitive).\n   - Example: \"ITD Output Achieved\" and \"Output Achieved ITD\" are equivalent.\n4. Return the selected catalog label text exactly.\n5. If no suitable label exists, mark that attribute unresolved.\n\n=== MAPPING RULES ===\n\nFollow these rules IN STRICT ORDER. Stop at the FIRST matching rule.\n\n**RULE 0a: LHS/OUTPUT VARIABLE CHECK (CRITICAL - ALWAYS CHECK FIRST)**\nIf formula is an assignment (contains \"=\"):\n- The variable on the LEFT side of \"=\" is the OUTPUT being DEFINED\n- Do NOT resolve this variable - it is the formula's result, not an input\n- Do NOT include this LHS/output label in `_resolution.mappings`\n- Skip to the next variable\n\nExample:\n- Formula: {totalARR} = SUM({ARR})\n  - {totalARR} is LHS (output) → do not add a mapping, skip resolution\n  - {ARR} is RHS (input) → resolve using RULES 1-6\n- Formula: {payout} = {revenue} * {rate}\n  - {payout} is LHS (output) → do not add a mapping, skip resolution\n  - {revenue}, {rate} are RHS (inputs) → resolve using RULES 1-6\n\n**RULE 0b: MEASURE FORMULA SELF-REFERENCE CHECK**\nFor MEASURE formulas ONLY (formulaType = \"MEASURE\"):\n- A measure CANNOT reference its OWN output (circular reference!)\n- If variable matches the SAME measure name as the current formula → Skip to RULE 2 (use BASE ATTRIBUTES)\n- If variable matches a DIFFERENT measure name → proceed to RULE 1 (SIBLING_MEASURE is allowed)\n- If the whole measure formula is a terminal scorecard/rate-table lookup that returns the measure value directly, emit a `RateTable` token, not `Measure result.[CurrentMeasure].*`.\n\nExample:\n- Measure \"Revenue\" with formula {revenue} * 0.08:\n  - {revenue} matches \"Revenue\" (same measure) → CANNOT use Measure result.Revenue.* → use Credit.Credit Amount\n- Measure \"Bonus\" with formula {revenue} * {quota}:\n  - {revenue} matches \"Revenue\" (different measure) → CAN use Measure result.Revenue.[selected output attribute]\n  - {quota} matches \"Quota\" (different measure) → CAN use Measure result.Quota.[selected output attribute]\n- A different measure in the same component is still a `Measure result`, not a `Plan component result`.\n\n**RULE 0d: COMPONENT FORMULA SELF-REFERENCE CHECK**\nFor INCENTIVE formulas ONLY (formulaType = \"INCENTIVE\"):\n- A component payout formula CANNOT reference its OWN plan component result as an input (circular reference!)\n- Do NOT emit `Plan component result.[CurrentComponent].*` for the component that owns the formula.\n- Same-component measure outputs are valid inputs and MUST use `Measure result.[MeasureName].[MeasureResultAttribute]`.\n- Cross-component component or measure results are valid inputs and MUST use the `Plan component result...` shapes below.\n- If the whole incentive formula is a terminal component rate-table lookup such as `RTR`, `Rate Table Rate`, or equivalent lookup wording, emit a `RateTable` token.\n\n**RULE 0c: DIMENSION-CONTEXT DISAMBIGUATION FOR GENERIC ACHIEVED VARIABLES**\nFor RATE_TABLE_INPUT and SCORECARD_INPUT formulas only:\n- If the variable is a bare achieved-style token such as {outputAchieved}, {ptdOutputAchieved}, {itdOutputAchieved}, {ytdOutputAchieved}, {attainment}, or {achievement}\n- And the current component has multiple plausible measures\n- Then use dimensionName and nearby rate-table binding intent to identify the UNIQUE best-matching measure.\n\nMatching guidance:\n- If dimensionName shares key business terms with exactly one measure name in the current component, resolve to that measure.\n- Example:\n  - dimensionName = \"Accessories Revenue Band\"\n  - measures = \"Accessories Attainment Driver\", \"Accessories Revenue Band Driver\"\n  - {outputAchieved} should resolve to \"Accessories Revenue Band Driver\"\n- If dimensionName does not uniquely identify one measure, do NOT guess. Mark the variable unresolved.\n\nThis rule is a fallback only. If the variable already includes a measure hint such as {accessoriesRevenueBandDriverOutputAchieved}, use RULE 1 normally.\n\n**SUPPORTED EXECUTABLE REFERENCE FLAVORS (CRITICAL)**\nThere are only three valid executable reference shapes:\n- Same-component measure result:\n  - `Measure result.[MeasureName].[MeasureResultAttribute]`\n- Cross-component component result:\n  - `Plan component result.[ComponentName].[ComponentResultAttribute]`\n- Cross-component measure result:\n  - `Plan component result.[ComponentName].[MeasureName].[MeasureResultAttribute]`\n\nDo not emit `Measure result` for a measure that belongs to a different component.\nDo not emit `Plan component result` for a same-component measure reference.\n\n**SUPPORTED FUNCTION SELECTION (CRITICAL)**\nYou must choose the executable IC function family; downstream code will preserve your choice.\n\n- Do NOT emit `IF`. Convert if/then/else intent to `NVL`, `DECODE`, or `CHOICE`.\n- Do NOT emit `ISNULL` or `ISBLANK`. Use `IS_NULL` inside predicates, or `NVL(expr, default)` for simple missing-value defaulting.\n- Use `NVL` for null/defaulting when the else branch is the original expression.\n- Do not add `NVL` unless the user asks for missing/null/defaulting behavior.\n- Use `DECODE(expr, match, then, else)` for equality-only branching on one expression with discrete matches.\n- Use `CHOICE(predicate, then, else)` for predicates: greater/less than, between, in, like, null checks, and/or/not, ranges, or mixed conditions.\n- Logical operations are IC functions. Emit `AND(predicate1, predicate2, ...)`, `OR(predicate1, predicate2, ...)`, and `NOT(predicate)` as Function tokens/calls.\n- Never emit `AND`, `OR`, or `NOT` as infix Operator tokens between predicates. Convert `X AND Y` to `AND(X, Y)` before returning tokens.\n- For \"when X is blank/null then A otherwise B\", use `CHOICE(IS_NULL(X), A, B)`. Do not wrap `IS_NULL(X)` in `NVL`.\n- Use scalar `LEAST(a, b, ...)` / `GREATEST(a, b, ...)` for smaller-of/larger-of, cap, floor, minimum payout, and maximum payout wording.\n- Use aggregate `MIN` / `MAX` only when aggregating over a set, list, value set, or population.\n- Apply these rules even when `simpleExpression` contains pseudo-functions or Excel-style wording.\n- If `simpleExpression` says `IF(x = y, a, b)`, return `DECODE(x, y, a, b)` tokens.\n- If `simpleExpression` says `MIN(a, b)` for smaller-of/cap wording, return `LEAST(a, b)` tokens.\n- If `simpleExpression` says `MAX(a, b)` for larger-of/floor/minimum-payout wording, return `GREATEST(a, b)` tokens.\n- Pronouns such as \"that output\", \"that amount\", or \"it\" refer to the nearest explicitly named quantity in the same request; use that same reference consistently in conditions and results unless the user names a different quantity.\n- Never interpret \"that output\" as the current target formula/component output when the request explicitly named another measure or amount earlier in the same sentence.\n\nAmbiguity resolution:\n- Resolve ambiguous business wording from the LOCAL owner context first: current component, current measure, formulaType, dimensionName, nearby rate-table or scorecard binding, and local neighboring measures.\n- Do not let a similar term elsewhere in the assembled plan override a stronger local-owner interpretation.\n- When wording could mean either a raw base attribute or a local/cross-component result, prefer the result reference if the phrase describes achieved/output/attainment/lookup-driver behavior; use a base attribute only when the phrase truly refers to a raw catalog-backed attribute.\n\n**RULE 1: SAME-COMPONENT MEASURE RESULTS**\nALWAYS check for measure matches FIRST, before anything else.\n\n*** CRITICAL: If the referenced measure is in the SAME component, use MEASURE RESULT - NOT INTERMEDIATE_VALUE ***\n\nStep 1a: Find which component contains this formula\nStep 1b: Look at that component's performanceMeasures array\nStep 1c: Check if variable name contains ANY measure name (case-insensitive partial match)\n\nMatching logic:\n- Convert measure name to camelCase hint (e.g., \"Product Line A\" → \"productLineA\")\n- Check if variable contains measure hint (e.g., {productLineARevenue} matches \"Product Line A\")\n- Match key words from measure name against variable name\n\n| Variable Pattern | IC Path | semantic key |\n|-----------------|---------|--------------|\n| {[measureHint]}Revenue, {[measureHint]}Sales | Measure result.[MatchedMeasure].[selected measure result attribute] | MEASURE_OUTPUT_BASE |\n| {[measureHint]}Rate, {[measureHint]}Score | Measure result.[MatchedMeasure].[selected measure result attribute] | MEASURE_OUTPUT_BASE |\n| {attainment}, {achievement} | Measure result.[MeasureName].[selected measure result attribute] | MEASURE_ATTAINMENT_BASE |\n| {output}, {outputAchieved} | Measure result.[MeasureName].[selected measure result attribute] | MEASURE_OUTPUT_BASE |\n| {ptdOutput}, {periodOutput} | Measure result.[MeasureName].[selected measure result attribute] | MEASURE_OUTPUT_PTD |\n| {itdAttainment} | Measure result.[MeasureName].[selected measure result attribute] | MEASURE_ATTAINMENT_ITD |\n| {itdOutput}, {ytdOutput} | Measure result.[MeasureName].[selected measure result attribute] | MEASURE_OUTPUT_ITD |\n\nSet referenceType based on where measure is found:\n- Same component → \"SELF_MEASURE\" or \"SIBLING_MEASURE\"\n- Different component → do NOT emit Measure result; continue to RULE 3b\n\n**RULE 1b: ACHIEVED ATTRIBUTE SELECTION (CRITICAL)**\nWhen resolving measure-result references, choose semantic intent based on time grain:\n\n- Use **MEASURE_OUTPUT_BASE** for per-event or transaction-level intent.\n- Use **MEASURE_OUTPUT_PTD** only when BRD explicitly says period-to-date (PTD) or equivalent.\n- Use **MEASURE_OUTPUT_ITD** when BRD indicates interval-to-date, quarter-to-date, year-to-date, cumulative, or true-up behavior.\n\nAfter selecting semantic intent, map it to the selected attribute label from provided lists.\n\nFor RATE_TABLE_INPUT and SCORECARD_INPUT formulas:\n- If input lookup is based on aggregated interval performance, prefer MEASURE_OUTPUT_ITD.\n- If lookup is explicitly period-to-date, prefer MEASURE_OUTPUT_PTD.\n- If lookup is explicitly per event/per transaction, use MEASURE_OUTPUT_BASE.\n\nUse Input Achieved variants only when BRD explicitly references prior component input-achieved style results.\n\n**RULE 2: BASE ATTRIBUTES (Only if NO measure match)**\nOnly use base attributes if the variable does NOT match any measure name in the component.\n\nIMPORTANT: The \"Maps To\" column shows \"Group.Attribute\" format. Split this into TWO separate fields:\n- basicAttributesGroup = the part BEFORE the dot (e.g., \"Credit\", \"Plan\", \"Measure\")\n- basicAttributeName = the part AFTER the dot (e.g., \"Credit Amount\", \"Target Incentive\", \"Interval Target\")\nExample: \"Plan.Target Incentive\" → basicAttributesGroup: \"Plan\", basicAttributeName: \"Target Incentive\"\n\nBusiness-label guidance for base attributes:\n- Infer the intended attribute scope first from formula context and variable role: Credit vs Plan vs Participant vs Plan component vs Measure.\n- Then choose the closest matching attribute that is actually present in the provided catalog within that scope.\n- Treat business wording as directional only. Resolve to the closest matching attribute that is actually present in the provided catalog.\n- Do NOT invent or assume an attribute just because the wording sounds familiar.\n- If multiple scopes remain plausible after reading the formula context, do NOT force a generic mapping from variable name alone.\n- If no suitable catalog-backed attribute exists, leave that variable unresolved rather than forcing a mapping.\n\n| Variable Pattern | Maps To | expressionDetailType |\n|-------------------|---------|---------------------|\n| {credit}, {revenue} (generic only) | Credit.Credit Amount | Primary object attribute |\n| {amount}, {creditAmount} | Credit.Credit Amount | Primary object attribute |\n| {targetIncentive}, {target}, {ti} | Plan.Target Incentive | Primary object attribute |\n| {salary} | Participant.Salary | Primary object attribute |\n| {componentWeight}, {weight}, {tiWeight} | Plan component.TI Weight | Primary object attribute |\n| {measureWeight} | Measure.Weight | Primary object attribute |\n| {intervalTarget}, {periodTarget}, {quota} | Measure.Interval Target | Primary object attribute |\n\nIMPORTANT: Do NOT use Credit.Credit Amount if variable hints at a specific measure!\n- If variable contains measure name keywords → Use RULE 1 (Measure result)\n- If variable is generic with no measure hint → Use RULE 2 (Credit.Credit Amount)\n\nSet referenceType = \"BASE_ATTRIBUTE\"\n\n**RULE 2.5: CONSTANTS / PLAN PARAMETERS**\nIf variable represents a configurable constant or plan parameter with a known numeric value in the assembled plan:\n\nHow to identify:\n1. Search the assembledPlan for a numeric value associated with this variable name\n2. Look in: component configurations, extracted parameters, caps, thresholds, limits\n3. If a specific numeric value exists for this variable → treat as Constant\n\nIf RULE 2.5 matches:\n- Set referenceType = \"PLAN_PARAMETER\"\n- Set resolvedTo = the actual numeric value as a string\n- Set expressionDetailType = \"Constant\"\n- Set confidence = 0.95\n\n**RULE 3a: CROSS-COMPONENT COMPONENT RESULTS**\nIf variable contains: amount, payout, calculated, result AND matches a different component name:\n\n| Variable Pattern | IC Path | semantic key |\n|-----------------|---------|--------------|\n| [componentHint]Amount | Plan component result.[ComponentName].[selected component result attribute] | COMPONENT_CALCULATED_AMOUNT |\n| [componentHint]Paid | Plan component result.[ComponentName].[selected component result attribute] | COMPONENT_PAID_AMOUNT |\n| [componentHint]InputAchieved | Plan component result.[ComponentName].[selected component result attribute] | COMPONENT_INPUT_BASE |\n| [componentHint]ITDInputAchieved, [componentHint]YTDInputAchieved | Plan component result.[ComponentName].[selected component result attribute] | COMPONENT_INPUT_ITD |\n| [componentHint]PTDInputAchieved | Plan component result.[ComponentName].[selected component result attribute] | COMPONENT_INPUT_PTD |\n\nSet referenceType = \"COMPONENT_RESULT\"\nAdd to dependencies array\n\n**RULE 3b: CROSS-COMPONENT MEASURE RESULTS**\nIf the reference points to a specific measure in a DIFFERENT component:\n- Use `Plan component result.[ComponentName].[MeasureName].[selected measure result attribute]`\n- Set `referenceType = \"COMPONENT_RESULT\"`\n- Set `expressionDetailType = \"Plan component result\"`\n- Fill `componentName`\n- Fill `componentMeasureName`\n- Fill `componentMeasureResultAttribute` with the selected label from `measureResultAttributes`\n- Do not use `componentResultAttribute` as a substitute for the measure-result attribute in this case\n- Add to dependencies array\n\nExamples:\n- `Plan component result.Accessories Base Commission.Accessories Base Credit Amount.ITD Output Achieved`\n\n**RULE 4: RATE TABLE (RTR TOKEN)**\nIf formula contains RTR:\n- RTR is a rate table reference token, not a lookup function\n- Find the component's rateTables array\n- Match to rateTableName exactly\n- Set rateTable.validated = true only when exact match is found\n- If the expression is a standalone lookup such as `RTR`, `Rate Table Rate`, or equivalent business wording that clearly means only the lookup result, emit exactly one `RateTable` token.\n\n**RULE 4d: DIRECT EXECUTABLE EXPRESSION TOKENIZATION**\nIf the expression already contains literal IC executable fragments, tokenize those fragments directly in order even when the variables array is empty or only partially populated.\n\nTokenization requirements:\n- Parse the FULL expression, not just the `{variables}` placeholders.\n- Emit one token per executable fragment in the original order.\n- Keep canonical executable references as structured tokens instead of collapsing the whole expression to a single `BasicAttribute`.\n- If the expression mixes literal executable references with `{variables}`, tokenize the literal fragments directly and resolve the remaining placeholders with RULES 0-6.\n- If a direct literal fragment names an unsupported or unknown reference, preserve it as `Unresolved` rather than silently rewriting the whole expression to a generic attribute.\n\n**RULE 4b: MALFORMED RTR FUNCTION DETECTION**\nIf formula contains `RTR(` or `LOOKUP_RATETABLE(`:\n- This is malformed syntax for this system\n- Do NOT treat RTR arguments as normal formula variables\n- Do NOT map RTR argument variables to IC attributes\n- For any RTR-argument variable that appears in the variables list:\n  - Set `referenceType = \"UNRESOLVED\"`\n  - Set `resolvedTo = null`\n  - Set `expressionDetailType = null`\n  - Set `confidence = 0.0`\n- Set `_resolution.status = \"PARTIAL\"` (never `RESOLVED`)\n- Add malformed argument variable names to `unresolvedVariables`\n- If first RTR argument looks like a table name, you may copy it to `rateTable.resolvedTo`, but keep `rateTable.validated = false` unless it exactly matches a configured table name\n\n**RULE 4c: USER DEFINED QUERY (UDQ) TOKENS**\nIf formula uses a value-set aggregate function such as `SUM_VALUE_SET`, `COUNT_VALUE_SET`, `MAX_VALUE_SET`, `MIN_VALUE_SET`, `AVG_VALUE_SET`, or `COUNT_DISTINCT_VALUE_SET`:\n- Check `icFunctionCatalog.userDefinedQueries` from the catalog for the argument name\n- If the argument matches a known UDQ/value set code, emit a token with:\n  - `tokenType = \"USER_DEFINED_QUERY\"`\n  - `userDefinedQueryName = exact catalog/query code`\n  - `renderedValue = \"Query:<exact catalog/query code>\"`\n- Preserve the surrounding function token as a normal `Function` token\n- Do NOT downgrade a known UDQ argument to `Unresolved`\n\n**RULE 5: EXTERNAL DATA REFERENCES**\nUse EXTERNAL_DATA for variables that reference source/transaction data fields:\n- Pattern: {Entity.Field} or {entity.field} (dot notation indicating external object)\n- Pattern: {accounts}, {transactions}, {customers} (collection references)\n- Pattern: {Account.Status}, {Order.Amount}, {Customer.Region} (entity field references)\n\nExamples:\n| Variable | resolvedTo |\n|----------|------------|\n| Account.Risk_Status | External data: Account.Risk_Status (source field) |\n| assigned accounts | External data: Participant assigned accounts (territory) |\n| Account.Health_Score | External data: Account.Health_Score (source field) |\n| totalAccounts | External data: COUNT(assigned accounts) |\n\nIf RULE 5 matches:\n- Set referenceType = \"EXTERNAL_DATA\"\n- Set resolvedTo = \"External data: [description of data source]\"\n- Set expressionDetailType = \"External source data\"\n- Set confidence = 0.80\n- NOTE: External data requires credit/transaction setup in IC\n\n**RULE 6: UNRESOLVED (Default fallback)**\nIf a variable is not skipped by RULE 0a or RULE 0b, and does NOT match any applicable resolution rule above, including RULE 0c, RULE 1, RULE 2, RULE 2.5, RULE 3a, RULE 3b, RULE 4c, or RULE 5:\n- Set referenceType = \"UNRESOLVED\"\n- Set resolvedTo = null\n- Set expressionDetailType = null\n- Set confidence = 0.0\n- Add variable to unresolvedVariables array\n\n*** REMEMBER: Rule 1 (Measure Results) ALWAYS takes priority! ***\nIf a variable matches a measure name, use SELF_MEASURE or SIBLING_MEASURE, NOT UNRESOLVED, except for the RULE 0b same-measure self-reference case.\n\n**RULE 7: RATE TABLE INPUT EXPRESSIONS**\nFor rate table dimension inputExpressions, use the standard variable-resolution rules above to resolve each variable, including RULE 0c when applicable.\n\nOutput requirements for RATE_TABLE_INPUT formulas:\n- Set formulaType = \"RATE_TABLE_INPUT\"\n- Include rateTableName and dimensionName in resolution output\n- If the inputExpression is a measure-result binding, prefer measure-specific canonical variables over bare generic achieved variables\n- Resolve each variable in the inputExpression using the standard rules above\n\n**RULE 8: SCORECARD DIMENSIONAL INPUTS**\nFor scorecard dimensional inputs on measures (rateDimensionalInputs[].inputExpression), use the standard variable-resolution rules above to resolve each variable, including RULE 0c when applicable.\n\nOutput requirements for SCORECARD_INPUT formulas:\n- Set formulaType = \"SCORECARD_INPUT\"\n- Include measureName, rateTableId, and dimensionSequence in resolution output\n- If the inputExpression is a measure-result binding, prefer measure-specific canonical variables over bare generic achieved variables\n- Resolve each variable in the inputExpression using the standard rules above\n\nNote: Scorecard inputs are on MEASURES, not on component-level rate tables. They determine what value is looked up in the scorecard attached to that measure.\n\n=== OUTPUT FORMAT ===\n\nReturn ONE JSON object with resolutions for ALL formulas and dimensional inputs:\n\n{\n  \"resolutions\": [\n    {\n      \"expressionId\": \"Exact builder-generated expression id for this specific formula/input instance\",\n      \"componentName\": \"Name of component containing this formula\",\n      \"formulaName\": \"Name of the formula (or inputExpression variable for RATE_TABLE_INPUT/SCORECARD_INPUT)\",\n      \"formulaType\": \"INCENTIVE | MEASURE | RATE_TABLE_INPUT | SCORECARD_INPUT\",\n      \"measureName\": \"Name of measure (for MEASURE formulas, null otherwise)\",\n      \"rateTableName\": \"Name of rate table (for RATE_TABLE_INPUT, null otherwise)\",\n      \"dimensionName\": \"Name of dimension (for RATE_TABLE_INPUT, null otherwise)\",\n      \"rateTableId\": \"Rate table ID for SCORECARD_INPUT when available, null otherwise\",\n      \"scorecardId\": \"Scorecard ID when available, null otherwise\",\n      \"dimensionSequence\": \"1-based dimension sequence for RATE_TABLE_INPUT or SCORECARD_INPUT, null otherwise\",\n      \"description\": \"One concise, non-empty business-facing sentence explaining the canonical token expression\",\n      \"tokens\": [\n        {\n          \"sequence\": 1,\n          \"tokenType\": \"BasicAttribute | MEASURE_RESULT | PLAN_COMPONENT_RESULT | RateTable | Function | USER_DEFINED_QUERY | Operator | Constant | Unresolved\",\n          \"renderedValue\": \"Exact display value for this token\",\n          \"group\": \"Include only for BasicAttribute\",\n          \"attribute\": \"Include only for BasicAttribute\",\n          \"measureName\": \"Include only for MEASURE_RESULT\",\n          \"measureResultAttribute\": \"Include only for MEASURE_RESULT\",\n          \"componentName\": \"Include only for PLAN_COMPONENT_RESULT\",\n          \"componentMeasureName\": \"Include only for PLAN_COMPONENT_RESULT when applicable\",\n          \"componentResultAttribute\": \"Include only for PLAN_COMPONENT_RESULT that points to a component-level result\",\n          \"componentMeasureResultAttribute\": \"Include only for PLAN_COMPONENT_RESULT when componentMeasureName is present\",\n          \"functionName\": \"Include only for Function\",\n          \"functionsGroup\": \"Include only for Function\",\n          \"userDefinedQueryName\": \"Include only for USER_DEFINED_QUERY\",\n          \"operator\": \"Include only for Operator\",\n          \"constantValue\": \"Include only for Constant\",\n          \"variableName\": \"Include only for Unresolved\"\n        }\n      ],\n      \"_resolution\": {\n        \"status\": \"RESOLVED\",\n        \"resolvedAt\": \"2025-12-08T00:00:00Z\",\n        \"mappings\": [\n          {\n            \"variable\": \"variableName\",\n            \"resolvedTo\": \"Full.IC.Path\",\n            \"expressionDetailType\": \"Primary object attribute | Measure result | Plan component result | Constant | External source data | null\",\n            \"referenceType\": \"BASE_ATTRIBUTE | SELF_MEASURE | SIBLING_MEASURE | COMPONENT_RESULT | PLAN_PARAMETER | EXTERNAL_DATA | UNRESOLVED\",\n            \"basicAttributesGroup\": \"Credit | Plan | Participant | Plan component | Measure\",\n            \"basicAttributeName\": \"Attribute name\",\n            \"measureName\": \"Measure name if applicable\",\n            \"measureResultAttribute\": \"Selected measure result attribute label\",\n            \"componentName\": \"Component name if COMPONENT_RESULT\",\n            \"componentResultAttribute\": \"Selected component result attribute label for pure component-level results\",\n            \"componentMeasureName\": \"Measure name if COMPONENT_RESULT points to a measure in another component\",\n            \"componentMeasureResultAttribute\": \"Selected measure result attribute label for cross-component measure references\",\n            \"sourceComponent\": \"Source component for cross-references\",\n            \"confidence\": 0.95,\n            \"origin\": \"AI_RESOLVED\"\n          }\n        ],\n        \"rateTable\": {\n          \"reference\": \"RTR\",\n          \"resolvedTo\": \"Rate table name\",\n          \"validated\": true\n        },\n        \"dependencies\": [\n          {\n            \"type\": \"CROSS_COMPONENT_MEASURE | COMPONENT_RESULT\",\n            \"sourceComponent\": \"Current component\",\n            \"targetComponent\": \"Referenced component\",\n            \"targetElement\": \"Referenced element name\",\n            \"reason\": \"Why this creates a dependency\"\n          }\n        ],\n        \"unresolvedVariables\": []\n      }\n    }\n  ],\n  \"planDependencies\": {\n    \"deployOrder\": [\"Component1\", \"Component2\", \"Component3\"],\n    \"reason\": \"Explanation of deployment order\"\n  }\n}\n\n=== EXAMPLE ===\n\nNote: Example labels are illustrative. In actual output, use labels from the provided attribute lists.\nThe `tokens` array is mandatory for RESOLVED and PARTIAL formulas.\nThe `description` field is required for every returned resolution. It must explain the canonical token expression in business language, not repeat unsupported draft syntax. Keep it short, non-empty, aligned to the final returned tokens, and free of implementation-only token details.\nFor edited expressions, this sentence must be newly aligned to the returned tokens. If the tokens include a new arithmetic constant such as `* 100` or `/ 4`, the description must reflect that effect in business language.\nPreserve every operator, bracket, constant, function, and unresolved fragment in order.\nDo not reconstruct expressions from mappings only.\nIf part of the expression cannot be resolved, emit `tokenType = \"Unresolved\"` for that token and keep it in sequence.\nOmit token fields that do not apply. Do not emit irrelevant metadata with `null` values.\nFor function calls, emit the executable punctuation tokens too: a `Function` token, then `Operator` `(`, argument tokens separated by `Operator` `,`, and `Operator` `)`. Nested functions must preserve their own parentheses.\nFor assignment-style business prose such as `Measure Name = Credit Amount (for each eligible transaction)`:\n- do NOT emit the output label token\n- do NOT emit the assignment operator `=`\n- do NOT emit explanatory parentheses that are not part of executable IC syntax\n- emit only the executable resolved expression tokens\n\nExample:\n- Input prose: `Qualified Peripheral Credit Amount = Credit Amount (for each eligible Accessories credit transaction)`\n  - Correct tokens: one `BasicAttribute` token for `Credit.Credit Amount`\n\nIf plan has:\n- Component \"NRR Bonus\" with:\n  - Incentive formula: {targetIncentive} * {componentWeight} * RTR\n\nOutput:\n{\n  \"resolutions\": [\n    {\n      \"componentName\": \"NRR Bonus\",\n      \"formulaName\": \"Tiered NRR Bonus\",\n      \"formulaType\": \"INCENTIVE\",\n      \"measureName\": null,\n      \"description\": \"Calculates payout from target incentive, component weight, and the applicable rate table result.\",\n      \"tokens\": [\n        {\n          \"sequence\": 1,\n          \"tokenType\": \"BasicAttribute\",\n          \"renderedValue\": \"Plan.Target Incentive\",\n          \"group\": \"Plan\",\n          \"attribute\": \"Target Incentive\"\n        },\n        {\n          \"sequence\": 2,\n          \"tokenType\": \"Operator\",\n          \"renderedValue\": \" * \",\n          \"operator\": \"*\"\n        },\n        {\n          \"sequence\": 3,\n          \"tokenType\": \"RateTable\",\n          \"renderedValue\": \"RTR\"\n        }\n      ],\n      \"_resolution\": {\n        \"status\": \"RESOLVED\",\n        \"resolvedAt\": \"2025-12-08T00:00:00Z\",\n        \"mappings\": [\n          {\n            \"variable\": \"targetIncentive\",\n            \"resolvedTo\": \"Plan.Target Incentive\",\n            \"expressionDetailType\": \"Primary object attribute\",\n            \"referenceType\": \"BASE_ATTRIBUTE\",\n            \"basicAttributesGroup\": \"Plan\",\n            \"basicAttributeName\": \"Target Incentive\",\n            \"confidence\": 0.98,\n            \"origin\": \"AI_RESOLVED\"\n          },\n          {\n            \"variable\": \"componentWeight\",\n            \"resolvedTo\": \"Plan component.TI Weight\",\n            \"expressionDetailType\": \"Primary object attribute\",\n            \"referenceType\": \"BASE_ATTRIBUTE\",\n            \"basicAttributesGroup\": \"Plan component\",\n            \"basicAttributeName\": \"TI Weight\",\n            \"confidence\": 0.95,\n            \"origin\": \"AI_RESOLVED\"\n          }\n        ],\n        \"rateTable\": {\"reference\": \"RTR\", \"resolvedTo\": \"NRR Achievement Multiplier Table\", \"validated\": true},\n        \"dependencies\": [],\n        \"unresolvedVariables\": []\n      }\n    }\n  ],\n  \"planDependencies\": {\n    \"deployOrder\": [\"NRR Bonus\"],\n    \"reason\": \"Single component, no cross-component dependencies\"\n  }\n}\n\n=== IMPORTANT ===\n\n1. Process ALL formulas from ALL components:\n   - Incentive formulas: planComponents[].formulas[]\n   - Measure formulas: planComponents[].performanceMeasures[].formula (if exists)\n   - Rate table inputs: planComponents[].rateTables[].dimensions[].inputExpression (if has {variables})\n   - Scorecard inputs: planComponents[].performanceMeasures[].rateDimensionalInputs[].inputExpression (if exists and has {variables})\n2. For each formula, map EVERY variable in the variables array\n3. Copy the exact builder-generated expression id for every returned row into `expressionId`\n4. Set formulaType: \"INCENTIVE\" for component formulas, \"MEASURE\" for measure formulas, \"RATE_TABLE_INPUT\" for dimension inputs, \"SCORECARD_INPUT\" for scorecard dimensional inputs\n5. Set measureName for MEASURE/SCORECARD_INPUT, rateTableName+dimensionName for RATE_TABLE_INPUT, null otherwise\n6. Use ONLY the data provided - do not invent measures or components\n7. Set status: RESOLVED (all mapped), PARTIAL (some unmapped), UNRESOLVED (none mapped)\n8. Return ONLY valid JSON - no markdown, no explanations\n9. Include planDependencies with suggested deployment order if cross-references exist"
            }
          ],
          "diagram": {
            "x": 5000,
            "y": 5912
          },
          "outputSpecification": "{\"$schema\": \"http://json-schema.org/draft-07/schema#\", \"type\": \"object\", \"properties\": {\"resolutions\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"expressionId\": {\"type\": [\"string\", \"null\"]}, \"componentName\": {\"type\": \"string\"}, \"formulaName\": {\"type\": \"string\"}, \"formulaType\": {\"type\": \"string\", \"enum\": [\"INCENTIVE\", \"MEASURE\", \"RATE_TABLE_INPUT\", \"SCORECARD_INPUT\"]}, \"measureName\": {\"type\": [\"string\", \"null\"]}, \"rateTableName\": {\"type\": [\"string\", \"null\"]}, \"dimensionName\": {\"type\": [\"string\", \"null\"]}, \"rateTableId\": {\"type\": [\"string\", \"null\"]}, \"scorecardId\": {\"type\": [\"string\", \"null\"]}, \"dimensionSequence\": {\"type\": [\"integer\", \"null\"]}, \"description\": {\"type\": \"string\", \"minLength\": 1}, \"tokens\": {\"type\": [\"array\", \"null\"], \"items\": {\"type\": \"object\", \"properties\": {\"sequence\": {\"type\": [\"integer\", \"null\"]}, \"tokenType\": {\"type\": \"string\", \"enum\": [\"BasicAttribute\", \"MEASURE_RESULT\", \"PLAN_COMPONENT_RESULT\", \"RateTable\", \"Function\", \"USER_DEFINED_QUERY\", \"Operator\", \"Constant\", \"Unresolved\"]}, \"renderedValue\": {\"type\": [\"string\", \"null\"]}, \"group\": {\"type\": [\"string\", \"null\"]}, \"attribute\": {\"type\": [\"string\", \"null\"]}, \"measureName\": {\"type\": [\"string\", \"null\"]}, \"measureResultAttribute\": {\"type\": [\"string\", \"null\"]}, \"componentName\": {\"type\": [\"string\", \"null\"]}, \"componentMeasureName\": {\"type\": [\"string\", \"null\"]}, \"componentMeasureResultAttribute\": {\"type\": [\"string\", \"null\"]}, \"componentResultAttribute\": {\"type\": [\"string\", \"null\"]}, \"functionName\": {\"type\": [\"string\", \"null\"]}, \"functionsGroup\": {\"type\": [\"string\", \"null\"]}, \"userDefinedQueryName\": {\"type\": [\"string\", \"null\"]}, \"operator\": {\"type\": [\"string\", \"null\"]}, \"constantValue\": {\"type\": [\"number\", \"string\", \"null\"]}, \"variableName\": {\"type\": [\"string\", \"null\"]}}, \"required\": [\"tokenType\"]}}, \"_resolution\": {\"type\": \"object\", \"properties\": {\"status\": {\"type\": \"string\", \"enum\": [\"RESOLVED\", \"PARTIAL\", \"UNRESOLVED\"]}, \"resolvedAt\": {\"type\": \"string\"}, \"mappings\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"variable\": {\"type\": \"string\"}, \"resolvedTo\": {\"type\": \"string\"}, \"expressionDetailType\": {\"type\": \"string\"}, \"referenceType\": {\"type\": \"string\", \"enum\": [\"BASE_ATTRIBUTE\", \"SELF_MEASURE\", \"SIBLING_MEASURE\", \"CROSS_COMPONENT_MEASURE\", \"COMPONENT_RESULT\", \"PLAN_PARAMETER\", \"INTERMEDIATE_VALUE\", \"EXTERNAL_DATA\", \"RATE_TABLE_INPUT\", \"UNRESOLVED\"]}, \"basicAttributesGroup\": {\"type\": [\"string\", \"null\"]}, \"basicAttributeName\": {\"type\": [\"string\", \"null\"]}, \"measureName\": {\"type\": [\"string\", \"null\"]}, \"measureResultAttribute\": {\"type\": [\"string\", \"null\"]}, \"componentName\": {\"type\": [\"string\", \"null\"]}, \"componentMeasureName\": {\"type\": [\"string\", \"null\"]}, \"componentMeasureResultAttribute\": {\"type\": [\"string\", \"null\"]}, \"componentResultAttribute\": {\"type\": [\"string\", \"null\"]}, \"sourceComponent\": {\"type\": [\"string\", \"null\"]}, \"confidence\": {\"type\": \"number\", \"minimum\": 0.0, \"maximum\": 1.0}, \"origin\": {\"type\": \"string\"}}, \"required\": [\"variable\", \"resolvedTo\", \"expressionDetailType\", \"referenceType\", \"confidence\", \"origin\"]}}, \"rateTable\": {\"type\": [\"object\", \"null\"], \"properties\": {\"reference\": {\"type\": \"string\"}, \"resolvedTo\": {\"type\": \"string\"}, \"validated\": {\"type\": \"boolean\"}}}, \"dependencies\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"type\": {\"type\": \"string\", \"enum\": [\"CROSS_COMPONENT_MEASURE\", \"COMPONENT_RESULT\"]}, \"sourceComponent\": {\"type\": \"string\"}, \"targetComponent\": {\"type\": \"string\"}, \"targetElement\": {\"type\": \"string\"}, \"reason\": {\"type\": \"string\"}}, \"required\": [\"type\", \"sourceComponent\", \"targetComponent\", \"targetElement\"]}}, \"unresolvedVariables\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}, \"required\": [\"status\", \"resolvedAt\", \"mappings\", \"dependencies\", \"unresolvedVariables\"]}}, \"required\": [\"componentName\", \"formulaName\", \"description\", \"tokens\", \"_resolution\"]}}, \"planDependencies\": {\"type\": [\"object\", \"null\"], \"properties\": {\"deployOrder\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"reason\": {\"type\": \"string\"}}}}, \"required\": [\"resolutions\"]}"
        },
        {
          "id": "5",
          "code": "MERGE_RESOLUTIONS",
          "type": "CODE",
          "metadata": {
            "name": "Merge Resolutions",
            "returnType": "object",
            "sourceCode": "// MERGE_RESOLUTIONS - Shared Expression Resolver CODE node\n// Merges Expression LLM Agent resolutions into the assembled plan\n//\n// Input:  $context.$variables.assembledPlan (JSON string of plan)\n// Input:  $context.$nodes.RESOLVE_EXPRESSIONS.$output (LLM resolution output)\n// Output: { planWithResolutions, metadata }\n// Error handling: If LLM output is empty/invalid, return plan as-is without resolutions\n\nvar assembledPlanRaw = $context.$variables.assembledPlan;\nvar resolutionOutput = $context.$nodes.RESOLVE_EXPRESSIONS.$output;\nvar icCatalogRaw = $context.$variables.icCatalog;\nvar scopedExpressionRequestsRaw = $context.$variables.scopedExpressionRequests;\nvar resolvedCatalogOutput = $context.$nodes.RESOLVE_CATALOG ? $context.$nodes.RESOLVE_CATALOG.$output : null;\n\nvar parseMaybeJson = function(value) {\n    if (value === null || value === undefined) {\n        return null;\n    }\n    if (typeof value !== 'string') {\n        return value;\n    }\n    try {\n        return JSON.parse(value);\n    } catch (_err) {\n        return null;\n    }\n};\n\nvar extractExpressionCatalog = function(value) {\n    var obj = parseMaybeJson(value);\n    if (!obj || typeof obj !== 'object') {\n        return new Object();\n    }\n    if (obj.expressionCatalog && typeof obj.expressionCatalog === 'object') {\n        return obj.expressionCatalog;\n    }\n    if (obj.catalog && typeof obj.catalog === 'object') {\n        if (obj.catalog.expressionCatalog && typeof obj.catalog.expressionCatalog === 'object') {\n            return obj.catalog.expressionCatalog;\n        }\n        return obj.catalog;\n    }\n    if (obj.result !== undefined) {\n        var fromResult = extractExpressionCatalog(obj.result);\n        if (fromResult && Object.keys(fromResult).length > 0) {\n            return fromResult;\n        }\n    }\n    if (obj.output !== undefined) {\n        var fromOutput = extractExpressionCatalog(obj.output);\n        if (fromOutput && Object.keys(fromOutput).length > 0) {\n            return fromOutput;\n        }\n    }\n    return obj;\n};\n\nvar normalizePathKey = function(value) {\n    return String(value || '').trim();\n};\n\nvar scopedExpressionRequestsParsed = parseMaybeJson(scopedExpressionRequestsRaw);\nvar scopedExpressionRequests = [];\nif (scopedExpressionRequestsParsed && scopedExpressionRequestsParsed.length !== undefined && typeof scopedExpressionRequestsParsed !== 'string') {\n    scopedExpressionRequests = scopedExpressionRequestsParsed;\n}\n\nvar scopedExpressionIds = new Object();\nvar scopedExpressionPathKeys = new Object();\nfor (var scopeIdx = 0; scopeIdx < scopedExpressionRequests.length; scopeIdx += 1) {\n    var scopedRequest = scopedExpressionRequests[scopeIdx] ? scopedExpressionRequests[scopeIdx] : new Object();\n    var scopedExpressionId = scopedRequest.expressionId !== undefined && scopedRequest.expressionId !== null\n        ? String(scopedRequest.expressionId).trim()\n        : '';\n    if (scopedExpressionId) {\n        scopedExpressionIds[scopedExpressionId] = true;\n    }\n    var scopedPathKey = normalizePathKey(scopedRequest.pathKey);\n    if (scopedPathKey) {\n        scopedExpressionPathKeys[scopedPathKey] = true;\n    }\n}\nvar hasScopedExpressionRequests = scopedExpressionRequests.length > 0;\n\nvar scopeAllowsExpression = function(expressionId, pathKey) {\n    if (!hasScopedExpressionRequests) {\n        return true;\n    }\n    var id = expressionId !== undefined && expressionId !== null ? String(expressionId).trim() : '';\n    if (id && scopedExpressionIds[id]) {\n        return true;\n    }\n    var key = normalizePathKey(pathKey);\n    return !!(key && scopedExpressionPathKeys[key]);\n};\n\nvar extractCatalogSource = function(value) {\n    var obj = parseMaybeJson(value);\n    if (!obj || typeof obj !== 'object') {\n        return null;\n    }\n    if (obj.source !== undefined && obj.source !== null && String(obj.source).trim()) {\n        return String(obj.source).trim();\n    }\n    if (obj.result !== undefined) {\n        var fromResult = extractCatalogSource(obj.result);\n        if (fromResult) {\n            return fromResult;\n        }\n    }\n    if (obj.output !== undefined) {\n        var fromOutput = extractCatalogSource(obj.output);\n        if (fromOutput) {\n            return fromOutput;\n        }\n    }\n    return null;\n};\n\nvar expressionCatalog = extractExpressionCatalog(icCatalogRaw);\nvar resolvedCatalogSource = extractCatalogSource(resolvedCatalogOutput) || (String(icCatalogRaw || '').trim() ? 'provided' : 'unknown');\nvar catalogAttributeNamesCache = new Object();\nvar catalogAttributeWordSignatureCache = new Object();\n\n// Parse inputs - handle both string and object forms\nvar plan = null;\ntry {\n    plan = typeof assembledPlanRaw === 'string' ? JSON.parse(assembledPlanRaw) : assembledPlanRaw;\n} catch (e) {\n    return JSON.stringify({\n        planWithResolutions: '{}',\n        metadata: {\n            resolutionConfidence: null,\n            lowConfidenceItems: [],\n            catalogSource: resolvedCatalogSource,\n            skipped: true,\n            skipReason: 'Failed to parse assembled plan'\n        }\n    });\n}\n\n// Helper to return plan without resolutions (fallback)\nvar returnPlanWithoutResolutions = (reason) => {\n    var safePlan = plan || {};\n    return JSON.stringify({\n        planWithResolutions: JSON.stringify(safePlan),\n        metadata: {\n            resolutionConfidence: null,\n            lowConfidenceItems: [],\n            catalogSource: resolvedCatalogSource,\n            skipped: true,\n            skipReason: reason || 'LLM resolution failed'\n        }\n    });\n};\n\nvar normalizeEntityLookupKey = function(value) {\n    return String(value || '')\n        .toUpperCase()\n        .replace(/[^A-Z0-9]/g, '');\n};\n\nvar buildPlanReferenceIndex = function(planObj) {\n    var index = {\n        componentRecords: [],\n        componentsByKey: new Object(),\n        componentsById: new Object(),\n        measureRecords: [],\n        measuresByKey: new Object(),\n        measuresById: new Object(),\n        measuresByComponentKey: new Object()\n    };\n\n    if (!planObj || !planObj.planComponents || planObj.planComponents.length === undefined) {\n        return index;\n    }\n\n    for (var componentIdx = 0; componentIdx < planObj.planComponents.length; componentIdx += 1) {\n        var componentRow = planObj.planComponents[componentIdx] ? planObj.planComponents[componentIdx] : new Object();\n        var componentId = componentRow.componentId !== undefined && componentRow.componentId !== null\n            ? String(componentRow.componentId).trim()\n            : '';\n        var componentName = componentRow.componentName !== undefined && componentRow.componentName !== null\n            ? String(componentRow.componentName).trim()\n            : '';\n        if (!componentName) {\n            continue;\n        }\n\n        var componentKey = normalizeEntityLookupKey(componentName);\n        if (!componentKey) {\n            continue;\n        }\n\n        var componentRecord = {\n            componentId: componentId || null,\n            componentName: componentName,\n            component: componentRow\n        };\n\n        if (!index.componentsByKey[componentKey]) {\n            index.componentsByKey[componentKey] = componentRecord;\n        }\n        index.componentRecords.push(componentRecord);\n        if (componentId) {\n            index.componentsById[componentId] = componentRecord;\n        }\n        if (!index.measuresByComponentKey[componentKey]) {\n            index.measuresByComponentKey[componentKey] = new Object();\n        }\n\n        var measures = componentRow.performanceMeasures && componentRow.performanceMeasures.length !== undefined\n            ? componentRow.performanceMeasures\n            : [];\n        for (var measureIdx = 0; measureIdx < measures.length; measureIdx += 1) {\n            var measureRow = measures[measureIdx] ? measures[measureIdx] : new Object();\n            var measureId = measureRow.measureId !== undefined && measureRow.measureId !== null\n                ? String(measureRow.measureId).trim()\n                : '';\n            var measureName = measureRow.measureName !== undefined && measureRow.measureName !== null\n                ? String(measureRow.measureName).trim()\n                : '';\n            if (!measureName) {\n                continue;\n            }\n\n            var measureKey = normalizeEntityLookupKey(measureName);\n            if (!measureKey) {\n                continue;\n            }\n\n            var measureRecord = {\n                measureId: measureId || null,\n                measureName: measureName,\n                measure: measureRow,\n                componentId: componentId || null,\n                componentName: componentName\n            };\n\n            if (!index.measuresByComponentKey[componentKey][measureKey]) {\n                index.measuresByComponentKey[componentKey][measureKey] = measureRecord;\n            }\n            index.measureRecords.push(measureRecord);\n            if (!index.measuresByKey[measureKey]) {\n                index.measuresByKey[measureKey] = [];\n            }\n            index.measuresByKey[measureKey].push(measureRecord);\n            if (measureId) {\n                index.measuresById[measureId] = measureRecord;\n            }\n        }\n    }\n\n    return index;\n};\n\nvar planReferenceIndex = buildPlanReferenceIndex(plan);\n\n// If no plan or no components, return as-is with minimal metadata\nif (!plan || !plan.planComponents || plan.planComponents.length === 0) {\n    return JSON.stringify({\n        planWithResolutions: JSON.stringify(plan),\n        metadata: {\n            resolutionConfidence: 1.0,\n            lowConfidenceItems: [],\n            catalogSource: resolvedCatalogSource\n        }\n    });\n}\n\n// Check if resolution output exists and is valid\nif (!resolutionOutput || resolutionOutput === '' || resolutionOutput === 'null') {\n    return returnPlanWithoutResolutions('Empty LLM resolution output');\n}\n\n// Parse resolution output if it's a string - with error handling\nvar resolutions = null;\ntry {\n    resolutions = typeof resolutionOutput === 'string' ? JSON.parse(resolutionOutput) : resolutionOutput;\n} catch (e) {\n    return returnPlanWithoutResolutions('Failed to parse LLM resolution output');\n}\n\n// Validate resolutions structure\nif (!resolutions || typeof resolutions !== 'object') {\n    return returnPlanWithoutResolutions('Invalid LLM resolution output structure');\n}\n\n// Build lookup maps for incentive, measure, rate table input, and scorecard input formula resolutions\nvar incentiveResolutionMap = {};\nvar measureResolutionMap = {};\nvar rateTableInputResolutionMap = {};\nvar scorecardInputResolutionMap = {};\nvar incentiveTokensMap = {};\nvar measureTokensMap = {};\nvar rateTableInputTokensMap = {};\nvar scorecardInputTokensMap = {};\nvar incentiveDescriptionMap = {};\nvar measureDescriptionMap = {};\nvar rateTableInputDescriptionMap = {};\nvar scorecardInputDescriptionMap = {};\nvar expressionResolutionById = {};\nvar expressionTokensById = {};\nvar expressionDescriptionById = {};\nvar expectedExpressionIds = {};\nvar returnedExpressionIds = {};\n\nvar hasOwnKey = function(obj, key) {\n    return Object.prototype.hasOwnProperty.call(obj, key);\n};\n\nvar listItems = function(value) {\n    return value && value.length !== undefined ? value : [];\n};\n\nvar getExpressionId = function(expressionObj) {\n    if (!expressionObj) {\n        return '';\n    }\n    var id = expressionObj.expressionId || expressionObj.inputExpressionId || expressionObj.inputId;\n    return id !== null && id !== undefined ? String(id) : '';\n};\n\nvar registerExpectedExpressionId = function(value) {\n    var id = value !== null && value !== undefined ? String(value).trim() : '';\n    if (!id) {\n        return;\n    }\n    expectedExpressionIds[id] = true;\n};\n\nvar registerExpectedExpression = function(expressionObj) {\n    registerExpectedExpressionId(getExpressionId(expressionObj));\n};\n\nvar normalizeResolutionDescription = function(value) {\n    if (value === null || value === undefined) {\n        return null;\n    }\n    var trimmed = String(value).replace(/\\s+/g, ' ').trim();\n    return trimmed || null;\n};\n\nvar syncResolutionDescription = function(targetObj, resolverDescription) {\n    if (!targetObj || typeof targetObj !== 'object') {\n        return;\n    }\n    var normalized = normalizeResolutionDescription(resolverDescription);\n    if (normalized) {\n        targetObj.description = normalized;\n        return;\n    }\n    if (!hasOwnKey(targetObj, 'description')) {\n        return;\n    }\n    if (targetObj.description !== null && targetObj.description !== undefined && String(targetObj.description).trim()) {\n        return;\n    }\n    delete targetObj.description;\n};\n\nvar setNestedResolutionEntry = function(resolutionMap, tokensMap, descriptionMap, outerKey, innerKey, res) {\n    if (!resolutionMap[outerKey]) {\n        resolutionMap[outerKey] = {};\n        tokensMap[outerKey] = {};\n        descriptionMap[outerKey] = {};\n    }\n    resolutionMap[outerKey][innerKey] = res._resolution;\n    tokensMap[outerKey][innerKey] = res.tokens || null;\n    descriptionMap[outerKey][innerKey] = normalizeResolutionDescription(res.description);\n};\n\nvar setFlatResolutionEntry = function(resolutionMap, tokensMap, descriptionMap, key, res) {\n    resolutionMap[key] = res._resolution;\n    tokensMap[key] = res.tokens || null;\n    descriptionMap[key] = normalizeResolutionDescription(res.description);\n};\n\nvar registerScorecardInputResolution = function(componentName, res) {\n    // Prefer rateTableId-based keys. Assembled plans may not have a stable scorecardId,\n    // but rateTableId is stable and is what the resolver prompt asks the LLM to return.\n    var scRateTableId = res.rateTableId || null;\n    var scScorecardId = res.scorecardId || null;\n    var scDimSequence = res.dimensionSequence;\n\n    if (scRateTableId) {\n        setFlatResolutionEntry(\n            scorecardInputResolutionMap,\n            scorecardInputTokensMap,\n            scorecardInputDescriptionMap,\n            componentName + '_' + res.measureName + '_' + scRateTableId + '_' + scDimSequence,\n            res\n        );\n    }\n    if (scScorecardId) {\n        setFlatResolutionEntry(\n            scorecardInputResolutionMap,\n            scorecardInputTokensMap,\n            scorecardInputDescriptionMap,\n            componentName + '_' + res.measureName + '_' + scScorecardId + '_' + scDimSequence,\n            res\n        );\n    }\n    if (!scRateTableId && !scScorecardId) {\n        setFlatResolutionEntry(\n            scorecardInputResolutionMap,\n            scorecardInputTokensMap,\n            scorecardInputDescriptionMap,\n            componentName + '_' + res.measureName + '__' + scDimSequence,\n            res\n        );\n    }\n};\n\nif (plan && plan.planComponents && plan.planComponents.length !== undefined) {\n    if (hasScopedExpressionRequests) {\n        for (var scopedId in scopedExpressionIds) {\n            if (scopedExpressionIds[scopedId]) {\n                registerExpectedExpressionId(scopedId);\n            }\n        }\n    } else {\n        for (var ecIdx = 0; ecIdx < plan.planComponents.length; ecIdx += 1) {\n            var expectedComponent = plan.planComponents[ecIdx] ? plan.planComponents[ecIdx] : new Object();\n            var expectedFormulas = listItems(expectedComponent.formulas);\n            for (var efIdx = 0; efIdx < expectedFormulas.length; efIdx += 1) {\n                registerExpectedExpression(expectedFormulas[efIdx] ? expectedFormulas[efIdx].expression : null);\n            }\n\n            var expectedMeasures = listItems(expectedComponent.performanceMeasures);\n            for (var emIdx = 0; emIdx < expectedMeasures.length; emIdx += 1) {\n                var expectedMeasure = expectedMeasures[emIdx] ? expectedMeasures[emIdx] : new Object();\n                registerExpectedExpression(expectedMeasure.formula ? expectedMeasure.formula.expression : null);\n\n                var expectedScorecardInputs = listItems(expectedMeasure.rateDimensionalInputs);\n                for (var esiIdx = 0; esiIdx < expectedScorecardInputs.length; esiIdx += 1) {\n                    registerExpectedExpressionId(expectedScorecardInputs[esiIdx] ? expectedScorecardInputs[esiIdx].expressionId : null);\n                }\n            }\n\n            var expectedComponentInputs = listItems(expectedComponent.rateDimensionalInputs);\n            for (var eciIdx = 0; eciIdx < expectedComponentInputs.length; eciIdx += 1) {\n                registerExpectedExpressionId(expectedComponentInputs[eciIdx] ? expectedComponentInputs[eciIdx].expressionId : null);\n            }\n        }\n    }\n}\n\nvar resolutionsList = resolutions.resolutions || [];\nfor (var i = 0; i < resolutionsList.length; i++) {\n    var res = resolutionsList[i];\n    var compKey = res.componentName;\n    var formKey = res.formulaName;\n    var formulaType = res.formulaType || 'INCENTIVE';\n    var expressionId = res.expressionId !== null && res.expressionId !== undefined ? String(res.expressionId).trim() : '';\n\n    if (hasScopedExpressionRequests && expressionId && !scopeAllowsExpression(expressionId, null)) {\n        continue;\n    }\n\n    if (expressionId) {\n        expressionResolutionById[expressionId] = res._resolution || null;\n        expressionTokensById[expressionId] = res.tokens || null;\n        expressionDescriptionById[expressionId] = normalizeResolutionDescription(res.description);\n        returnedExpressionIds[expressionId] = true;\n    }\n\n    if (formulaType === 'MEASURE' && res.measureName) {\n        setNestedResolutionEntry(measureResolutionMap, measureTokensMap, measureDescriptionMap, compKey, res.measureName, res);\n    } else if (formulaType === 'RATE_TABLE_INPUT' && res.rateTableName && res.dimensionName) {\n        setFlatResolutionEntry(\n            rateTableInputResolutionMap,\n            rateTableInputTokensMap,\n            rateTableInputDescriptionMap,\n            compKey + '_' + res.rateTableName + '_' + res.dimensionName,\n            res\n        );\n    } else if (formulaType === 'SCORECARD_INPUT' && res.measureName && res.dimensionSequence) {\n        registerScorecardInputResolution(compKey, res);\n    } else {\n        setNestedResolutionEntry(incentiveResolutionMap, incentiveTokensMap, incentiveDescriptionMap, compKey, formKey, res);\n    }\n}\n\nvar missingResolutionIds = [];\nfor (var expectedExpressionId in expectedExpressionIds) {\n    if (expectedExpressionIds[expectedExpressionId] && !returnedExpressionIds[expectedExpressionId]) {\n        missingResolutionIds.push(expectedExpressionId);\n    }\n}\n\nvar containsMalformedRtrFunction = (expression) => {\n    if (typeof expression !== 'string') {\n        return false;\n    }\n    return /\\bRTR\\s*\\(/i.test(expression) || /\\bLOOKUP_RATETABLE\\s*\\(/i.test(expression);\n};\n\nvar extractVariablesFromExpression = (expression) => {\n    if (typeof expression !== 'string') {\n        return [];\n    }\n\n    var variables = [];\n    var seen = {};\n    var regex = /\\{([^}]+)\\}/g;\n    var match = null;\n\n    while ((match = regex.exec(expression)) !== null) {\n        var variable = String(match[1] || '').trim();\n        if (!variable || seen[variable]) {\n            continue;\n        }\n        seen[variable] = true;\n        variables.push(variable);\n    }\n\n    return variables;\n};\n\nvar normalizeComparableToken = (value) => {\n    if (value === null || value === undefined) {\n        return '';\n    }\n    return String(value)\n        .replace(/^\\{+|\\}+$/g, '')\n        .replace(/\\s+/g, ' ')\n        .trim()\n        .toLowerCase();\n};\n\nvar extractAssignmentOutputLabel = (expression) => {\n    if (typeof expression !== 'string') {\n        return null;\n    }\n\n    var eqIndex = expression.indexOf('=');\n    if (eqIndex <= 0) {\n        return null;\n    }\n\n    var lhs = String(expression.slice(0, eqIndex) || '').trim();\n    if (!lhs) {\n        return null;\n    }\n\n    if (lhs.charAt(0) === '{' && lhs.charAt(lhs.length - 1) === '}') {\n        lhs = lhs.slice(1, lhs.length - 1).trim();\n    }\n\n    return lhs || null;\n};\n\nvar stripSyntheticFormulaOutputMappings = (expressionObj, resolution) => {\n    if (!resolution || !resolution.mappings || !Array.isArray(resolution.mappings) || resolution.mappings.length === 0) {\n        return resolution;\n    }\n\n    var simpleExpression = expressionObj && expressionObj.simpleExpression ? String(expressionObj.simpleExpression) : '';\n    var assignmentOutputLabel = extractAssignmentOutputLabel(simpleExpression);\n    if (!assignmentOutputLabel) {\n        return resolution;\n    }\n\n    var normalizedOutputLabel = normalizeComparableToken(assignmentOutputLabel);\n    if (!normalizedOutputLabel) {\n        return resolution;\n    }\n\n    var filteredMappings = [];\n    var removed = false;\n    for (var i = 0; i < resolution.mappings.length; i++) {\n        var mapping = resolution.mappings[i] ? resolution.mappings[i] : new Object();\n        var normalizedReferenceType = normalizeComparableToken(mapping.referenceType);\n        var normalizedDetailType = normalizeComparableToken(mapping.expressionDetailType);\n        var normalizedVariable = normalizeComparableToken(mapping.variable);\n        var isFormulaOutputMapping = normalizedReferenceType.indexOf('formula') >= 0 || normalizedDetailType.indexOf('formula') >= 0;\n        var matchesAssignmentOutput = normalizedVariable === normalizedOutputLabel;\n        var hasResolvedTarget = mapping.resolvedTo !== null && mapping.resolvedTo !== undefined && String(mapping.resolvedTo).trim() !== '';\n\n        if (isFormulaOutputMapping && matchesAssignmentOutput && !hasResolvedTarget) {\n            removed = true;\n            continue;\n        }\n\n        filteredMappings.push(mapping);\n    }\n\n    if (removed) {\n        resolution.mappings = filteredMappings;\n    }\n\n    return resolution;\n};\n\nvar collectFunctionCallArguments = (expression, functionName) => {\n    if (typeof expression !== 'string') {\n        return [];\n    }\n\n    var source = expression;\n    var lower = source.toLowerCase();\n    var fnLower = String(functionName || '').toLowerCase();\n    var index = 0;\n    var argumentsList = [];\n\n    while (index < source.length) {\n        var fnIndex = lower.indexOf(fnLower, index);\n        if (fnIndex === -1) {\n            break;\n        }\n\n        var before = fnIndex > 0 ? source.charAt(fnIndex - 1) : '';\n        if (before && /[A-Za-z0-9_]/.test(before)) {\n            index = fnIndex + fnLower.length;\n            continue;\n        }\n\n        var argStart = fnIndex + fnLower.length;\n        while (argStart < source.length && /\\s/.test(source.charAt(argStart))) {\n            argStart++;\n        }\n\n        if (source.charAt(argStart) !== '(') {\n            index = argStart;\n            continue;\n        }\n\n        var depth = 0;\n        var argEnd = argStart;\n        while (argEnd < source.length) {\n            var ch = source.charAt(argEnd);\n            if (ch === '(') {\n                depth++;\n            } else if (ch === ')') {\n                depth--;\n                if (depth === 0) {\n                    break;\n                }\n            }\n            argEnd++;\n        }\n\n        if (argEnd >= source.length) {\n            break;\n        }\n\n        argumentsList.push(source.slice(argStart + 1, argEnd));\n        index = argEnd + 1;\n    }\n\n    return argumentsList;\n};\n\nvar uniquePush = (arrayRef, value) => {\n    if (!arrayRef || arrayRef.indexOf(value) !== -1) {\n        re