';\n            if (!scopeAllowsExpression(formulaExpressionId, formulaPathKey)) {\n                continue;\n            }\n            resolution = getResolutionByExpressionId(formulaExpressionId, resolution);\n\n            resolution = applyMalformedRtrGuard(\n                formula,\n                resolution,\n                componentPath + '.formulas[' + fIdx + ']',\n                lowConfidenceResolutions\n            );\n\n            if (resolution) {\n                var incentiveTokens = incentiveTokensMap[compName] ? incentiveTokensMap[compName][formula.formulaName] || null : null;\n                var incentiveDescription = incentiveDescriptionMap[compName] ? incentiveDescriptionMap[compName][formula.formulaName] || null : null;\n                incentiveTokens = getTokensByExpressionId(formulaExpressionId, incentiveTokens);\n                incentiveDescription = getDescriptionByExpressionId(formulaExpressionId, incentiveDescription);\n                mergeFormulaExpressionResolution(\n                    formula,\n                    formula.expression,\n                    resolution,\n                    incentiveTokens,\n                    incentiveDescription,\n                    compName,\n                    formulaPathKey + '.tokens',\n                    formulaPathKey + '._resolution.mappings',\n                    {\n                        formulaType: 'INCENTIVE',\n                        componentId: component.componentId,\n                        componentName: compName\n                    }\n                );\n            }\n        }\n    }\n\n    // 2. Merge MEASURE formula resolutions\n    if (component.performanceMeasures) {\n        for (var pmIdx = 0; pmIdx < component.performanceMeasures.length; pmIdx++) {\n            var measure = component.performanceMeasures[pmIdx];\n\n            if (measure.formula && measure.formula.expression) {\n                var measureResolution = measureResolutionMap[compName] ? measureResolutionMap[compName][measure.measureName] : null;\n                var measureExpressionId = getExpressionId(measure.formula.expression);\n                var measureExpressionPathKey = componentPath + '.performanceMeasures[' + pmIdx + '].formula.expression';\n                if (!scopeAllowsExpression(measureExpressionId, measureExpressionPathKey)) {\n                    continue;\n                }\n                measureResolution = getResolutionByExpressionId(measureExpressionId, measureResolution);\n\n                measureResolution = applyMalformedRtrGuard(\n                    measure.formula,\n                    measureResolution,\n                    componentPath + '.performanceMeasures[' + pmIdx + '].formula',\n                    lowConfidenceResolutions\n                );\n\n                if (measureResolution) {\n                    var measureTokens = measureTokensMap[compName] ? measureTokensMap[compName][measure.measureName] || null : null;\n                    var measureDescription = measureDescriptionMap[compName] ? measureDescriptionMap[compName][measure.measureName] || null : null;\n                    measureTokens = getTokensByExpressionId(measureExpressionId, measureTokens);\n                    measureDescription = getDescriptionByExpressionId(measureExpressionId, measureDescription);\n                    mergeFormulaExpressionResolution(\n                        measure.formula,\n                        measure.formula.expression,\n                        measureResolution,\n                        measureTokens,\n                        measureDescription,\n                        compName,\n                        measureExpressionPathKey + '.tokens',\n                        measureExpressionPathKey + '._resolution.mappings',\n                        {\n                            formulaType: 'MEASURE',\n                            componentId: component.componentId,\n                            componentName: compName,\n                            measureId: measure.measureId,\n                            measureName: measure.measureName\n                        }\n                    );\n                }\n            }\n        }\n    }\n\n    // 3. Merge COMPONENT RATE INPUT resolutions\n    var rateTableNameById = buildRateTableNameById(component);\n    if (component.rateDimensionalInputs) {\n        for (var cInputIdx = 0; cInputIdx < component.rateDimensionalInputs.length; cInputIdx++) {\n            var cInput = component.rateDimensionalInputs[cInputIdx];\n            if (!cInput || !cInput.inputExpression) {\n                continue;\n            }\n            var rateTableName = rateTableNameById[cInput.rateTableId] || cInput.rateTableId;\n            var dimensionName = cInput.dimensionName || ('DIM_' + cInput.dimensionSequence);\n            var rtKey = compName + '_' + rateTableName + '_' + dimensionName;\n            var rtResolution = rateTableInputResolutionMap[rtKey];\n            var rtTokens = rateTableInputTokensMap[rtKey] || null;\n            var rtDescription = rateTableInputDescriptionMap[rtKey] || null;\n            var componentInputExpressionId = getExpressionId(cInput);\n            var componentInputPathKey = componentPath + '.rateDimensionalInputs[' + cInputIdx + ']';\n            if (!scopeAllowsExpression(componentInputExpressionId, componentInputPathKey)) {\n                continue;\n            }\n            rtResolution = getResolutionByExpressionId(componentInputExpressionId, rtResolution);\n            rtTokens = getTokensByExpressionId(componentInputExpressionId, rtTokens);\n            rtDescription = getDescriptionByExpressionId(componentInputExpressionId, rtDescription);\n\n            if (rtResolution) {\n                mergeInputExpressionResolution(\n                    cInput,\n                    componentInputExpressionId,\n                    rtResolution,\n                    rtTokens,\n                    rtDescription,\n                    compName,\n                    componentInputPathKey + '.tokens',\n                    componentInputPathKey + '._resolution.mappings'\n                );\n            }\n        }\n    }\n\n    // 4. Merge SCORECARD INPUT resolutions\n    if (component.performanceMeasures) {\n        for (var scMeasureIdx = 0; scMeasureIdx < component.performanceMeasures.length; scMeasureIdx++) {\n            var scMeasure = component.performanceMeasures[scMeasureIdx];\n\n            if (scMeasure.rateDimensionalInputs) {\n                for (var scInputIdx = 0; scInputIdx < scMeasure.rateDimensionalInputs.length; scInputIdx++) {\n                    var scInput = scMeasure.rateDimensionalInputs[scInputIdx];\n\n                    // Check if this scorecard input has an inputExpression\n                    if (scInput.inputExpression) {\n                        var scorecard0 = (scMeasure.scorecards && scMeasure.scorecards[0]) ? scMeasure.scorecards[0] : null;\n                        var scorecardInputExpressionId = getExpressionId(scInput);\n                        var scorecardInputPathKey = componentPath + '.performanceMeasures[' + scMeasureIdx + '].rateDimensionalInputs[' + scInputIdx + ']';\n                        if (!scopeAllowsExpression(scorecardInputExpressionId, scorecardInputPathKey)) {\n                            continue;\n                        }\n                        var scorecardMatch = findScorecardInputResolution(\n                            compName,\n                            scMeasure.measureName,\n                            scInput,\n                            scorecard0,\n                            scorecardInputExpressionId\n                        );\n                        var scResolution = scorecardMatch.resolution;\n                        var scTokens = scorecardMatch.tokens;\n                        var scDescription = scorecardMatch.description;\n\n                        if (scResolution) {\n                            // NOTE: inputExpressionId remains null for BRD_PARSED plans.\n                            // The deployer/transformer will create real IC Expression objects\n                            // and populate inputExpressionId with the actual expression ID.\n                            mergeInputExpressionResolution(\n                                scInput,\n                                scorecardInputExpressionId,\n                                scResolution,\n                                scTokens,\n                                scDescription,\n                                compName,\n                                scorecardInputPathKey + '.tokens',\n                                scorecardInputPathKey + '._resolution.mappings'\n                            );\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\n// Temporarily suppress plan-level dependency scaffolding from emitted plan JSON.\n// if (resolutions.planDependencies) {\n//     plan._planDependencies = resolutions.planDependencies;\n// }\n\n// Calculate average resolution confidence\nvar avgResolutionConfidence = 1.0;\nif (resolutionConfidences.length > 0) {\n    var sum = 0;\n    for (var j = 0; j < resolutionConfidences.length; j++) {\n        sum += resolutionConfidences[j];\n    }\n    avgResolutionConfidence = Math.round((sum / resolutionConfidences.length) * 100) / 100;\n}\n\n// Return the merged plan with metadata\nvar resultMetadata = {\n    resolutionConfidence: avgResolutionConfidence,\n    lowConfidenceItems: lowConfidenceResolutions,\n    catalogSource: resolvedCatalogSource,\n    missingResolutionIds: missingResolutionIds\n};\nif (hasScopedExpressionRequests) {\n    resultMetadata.scopedExpressionResolution = true;\n}\n\nvar result = {\n    planWithResolutions: JSON.stringify(plan),\n    metadata: resultMetadata\n};\n\nreturn JSON.stringify(result);"
