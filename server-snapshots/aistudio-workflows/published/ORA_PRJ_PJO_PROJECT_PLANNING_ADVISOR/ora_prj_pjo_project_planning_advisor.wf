ng(variables.PendingOldResourceName || variables.ResourceName || request.resourceName || '');\n    request.replacementResourceName = trimmedMessage;\n  }\n}\n\nif (rejectSuggestedProject) {\n  request.projectName = '';\n  request.canProceed = false;\n  request.userMessage = 'Provide the correct project name.';\n  return request;\n}\n\nif (budgetFollowUpPending && intent !== 'OUT_OF_SCOPE' && !changeImplementationBridge) {\n  if (budgetFollowUpProceed) {\n    request.budgetFollowUpAction = 'PROCEED';\n  } else if (budgetFollowUpSkip) {\n    request.budgetFollowUpAction = 'SKIP';\n  } else {\n    request.canProceed = false;\n    request.userMessage = 'Reply yes to continue with budget follow-up, or reply no to skip.';\n    return request;\n  }\n}\n\nif (crossProjectBudgetFollowUpPending) {\n  request.projectName = existingProjectName || '';\n}\nsuggestionProjectName = String(request.projectName || parsed.projectName || '').trim();\nif (suggestionProjectName && !listProjects && intent !== 'OUT_OF_SCOPE' && !crossProjectBudgetFollowUpPending) {\n  suggestionParts = suggestionProjectName.toUpperCase().split(/[^A-Z0-9]+/);\n  for (i = 0; i < suggestionParts.length; i++) {\n    token = String(suggestionParts[i] || '').trim();\n    if (token.length > 1) {\n      suggestionTokens.push(token);\n    }\n  }\n  suggestionParts = [];\n  if (suggestionTokens.length > 0) {\n    suggestionParts.push(suggestionTokens[0]);\n  }\n  if (suggestionTokens.length > 1) {\n    suggestionParts.push(suggestionTokens[1]);\n  }\n  if (suggestionTokens.length > 2) {\n    suggestionParts.push(suggestionTokens[suggestionTokens.length - 1]);\n  }\n  for (i = 0; i < suggestionParts.length; i++) {\n    token = suggestionParts[i];\n    if (token && !suggestionSeen[token]) {\n      suggestionSeen[token] = true;\n      suggestionPattern += (suggestionPattern ? '*' : '') + token;\n    }\n  }\n  if (!suggestionPattern) {\n    suggestionPattern = suggestionProjectName.toUpperCase().replace(/[^A-Z0-9]+/g, '*