            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\nfunction toNumber(value) {\n  var num;\n  if (value == null || value === '') {\n    return null;\n  }\n  num = Number(value);\n  return isNaN(num) ? null : num;\n}\nfunction pickFirstNumber() {\n  var i;\n  var parsed;\n  for (i = 0; i < arguments.length; i++) {\n    parsed = toNumber(arguments[i]);\n    if (parsed !== null) {\n      return parsed;\n    }\n  }\n  return null;\n}\nfunction getPlanningAmountItems(item) {\n  if (!item || typeof item !== 'object') {\n    return [];\n  }\n  if (item.PlanningAmounts && Array.isArray(item.PlanningAmounts.items)) {\n    return item.PlanningAmounts.items;\n  }\n  if (Array.isArray(item.PlanningAmounts)) {\n    return item.PlanningAmounts;\n  }\n  return [];\n}\nfunction summarize(plan, assignments) {\n  var items = assignments && Array.isArray(assignments.items) ? assignments.items : [];\n  var quantitySum = 0;\n  var rawCostSum = 0;\n  var burdenedCostSum = 0;\n  var revenueSum = 0;\n  var hasQuantity = false;\n  var hasRawCost = false;\n  var hasBurdenedCost = false;\n  var hasRevenue = false;\n  var i;\n  var j;\n  var assignment;\n  var amountItems;\n  var amount;\n  var qty;\n  var rawCost;\n  var burdenedCost;\n  var revenue;\n  for (i = 0; i < items.length; i++) {\n    assignment = items[i] || {};\n    amountItems = getPlanningAmountItems(assignment);\n    if (!amountItems.length) {\n      amountItems = [assignment];\n    }\n    for (j = 0; j < amountItems.length; j++) {\n      amount = amountItems[j] || {};\n      qty = pickFirstNumber(amount.PlannedQuantity, amount.Quantity);\n      rawCost = pickFirstNumber(amount.RawCostInProjectCurrency, amount.RawCost);\n      burdenedCost = pickFirstNumber(amount.BurdenedCostInProjectCurrency, amount.BurdenedCost);\n      revenue = pickFirstNumber(amount.RevenueInProjectCurrency, amount.Revenue);\n      if (qty !== null) {\n        quantitySum += qty;\n        hasQuantity = true;\n      }\n      if (rawCost !== null) {\n        rawCostSum += rawCost;\n        hasRawCost = true;\n      }\n      if (burdenedCost !== null) {\n        burdenedCostSum += burdenedCost;\n        hasBurdenedCost = true;\n      }\n      if (revenue !== null) {\n        revenueSum += revenue;\n        hasRevenue = true;\n      }\n    }\n  }\n  var rawCostValue = pickFirstNumber(plan.PCRawCostAmounts, plan.RawCostInProjectCurrency, plan.RawCostInProjectLedgerCurrency, hasRawCost ? rawCostSum : null);\n  var burdenedCostValue = pickFirstNumber(plan.PCBurdenedCostAmounts, plan.BurdenedCostInProjectCurrency, plan.BurdenedCostInProjectLedgerCurrency, hasBurdenedCost ? burdenedCostSum : null);\n  var revenueValue = pickFirstNumber(plan.PCRevenueAmounts, plan.RevenueInProjectCurrency, plan.RevenueInProjectLedgerCurrency, hasRevenue ? revenueSum : null);\n  var marginValue = pickFirstNumber(plan.Margin, revenueValue !== null && burdenedCostValue !== null ? (revenueValue - burdenedCostValue) : null);\n  var marginPercentValue = pickFirstNumber(plan.MarginPercentage, revenueValue !== null && marginValue !== null && revenueValue !== 0 ? ((marginValue / revenueValue) * 100) : null);\n  return {\n    projectName: trimString(plan.ProjectName || plan.projectName || ''),\n    projectNumber: trimString(plan.ProjectNumber || plan.projectNumber || ''),\n    planVersionId: trimString(plan.PlanVersionId || plan.planVersionId || ''),\n    quantity: hasQuantity ? quantitySum : null,\n    rawCost: rawCostValue,\n    burdenedCost: burdenedCostValue,\n    revenue: revenueValue,\n    margin: marginValue,\n    marginPercent: marginPercentValue\n  };\n}\nvar plan = $context.$nodes.PROJECT_PLAN_ADVISOR_SELECT_PLAN.$output.result || {};\nvar assignments = $context.$nodes.PROJECT_PLAN_ADVISOR_FETCH_PRE_ACTION_ASSIGNMENTS_V1.$output || {};\nreturn summarize(plan, assignments);"
