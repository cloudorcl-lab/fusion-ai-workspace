            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\n\nfunction cleanName(value) {\n  return trimString(value)\n    .replace(/^(?:a|an|the)\\s+/i, '')\n    .replace(/^planning\\s+/i, '')\n    .replace(/^(?:resource|employee|person)\\s+/i, '')\n    .replace(/\\s+/g, ' ')\n    .replace(/^[^A-Za-z0-9]+|[^A-Za-z0-9]+$/g, '')\n    .trim();\n}\n\nfunction parseSingleProjectReplacement(messageText) {\n  var message = trimString(messageText);\n  var lower = message.toLowerCase();\n  var prefixMatch;\n  var suffixMatch;\n  var match;\n  var result = null;\n\n  if (!/\\breplace\\b/.test(lower) || !/\\bwith\\b/.test(lower)) {\n    return null;\n  }\n  if (/\\bacross\\s+(?:all\\s+)?(?:my\\s+)?projects\\b|\\ball\\s+my\\s+projects\\b|\\ball\\s+projects\\b/.test(lower)) {\n    return null;\n  }\n\n  prefixMatch = message.match(/^(?:in|for)\\s+(.+?)\\s+replace\\s+(?:the\\s+)?(?:planning\\s+)?(?:resource|employee|person)?\\s*(.+?)\\s+with\\s+(.+?)(?=\\s+(?:for\\s+all\\s+(?:impacted\\s+)?(?:assignments|tasks)|all\\s+(?:impacted\\s+)?(?:assignments|tasks)|from|effective|starting|as\\s+of)\\b|$)/i);\n  suffixMatch = message.match(/^replace\\s+(?:the\\s+)?(?:planning\\s+)?(?:resource|employee|person)?\\s*(.+?)\\s+with\\s+(.+?)\\s+(?:in|on)\\s+(.+?)(?=\\s+(?:for\\s+all\\s+(?:impacted\\s+)?(?:assignments|tasks)|all\\s+(?:impacted\\s+)?(?:assignments|tasks)|from|effective|starting|as\\s+of|across)\\b|$)/i);\n  match = prefixMatch || suffixMatch;\n\n  if (match) {\n    result = prefixMatch\n      ? {\n          projectName: cleanName(match[1]),\n          resourceName: cleanName(match[2]),\n          replacementResourceName: cleanName(match[3])\n        }\n      : {\n          projectName: cleanName(match[3]),\n          resourceName: cleanName(match[1]),\n          replacementResourceName: cleanName(match[2])\n        };\n  }\n\n  if (!result || !result.projectName || !result.resourceName || !result.replacementResourceName) {\n   