        {
          "metadata": {
            "errorNodeId": "1779952000199",
            "name": "Build Plan Comparison Table",
            "returnType": "object",
            "sourceCode": "function trimString(value) { return String(value == null ? '' : value).trim(); }\nfunction toNumber(value) { var num; if (value == null || value === '') { return null; } num = Number(value); return isNaN(num) ? null : num; }\nfunction formatAmount(value, isPercent, isCurrency) {\n  var num = toNumber(value);\n  var text;\n  var parts;\n  var sign;\n  if (num === null) { return 'N/A'; }\n  sign = num < 0 ? '-' : '';\n  text = Math.abs(num).toFixed(2);\n  parts = text.split('.');\n  parts[0] = parts[0].replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',');\n  return (isCurrency ? sign + '$' : sign) + parts[0] + '.' + parts[1] + (isPercent ? '%' : '');\n}\nfunction formatQuantity(value) {\n  var num = toNumber(value);\n  if (num === null) { return 'N/A'; }\n  return Math.abs(num).toFixed(2);\n}\nfunction formatQuantityDelta(beforeValue, afterValue) {\n  var beforeNum = toNumber(beforeValue);\n  var afterNum = toNumber(afterValue);\n  if (beforeNum === null || afterNum === null) { return 'N/A'; }\n  return Math.abs(afterNum - beforeNum).toFixed(2);\n}\nfunction formatDelta(beforeValue, afterValue, isPercent, isCurrency) {\n  var beforeNum = toNumber(beforeValue);\n  var afterNum = toNumber(afterValue);\n  if (beforeNum === null || afterNum === null) { return 'N/A'; }\n  return formatAmount(afterNum - beforeNum, isPercent, isCurrency);\n}\nfunction cellText(value, isPercent, isCurrency) { return formatAmount(value, isPercent, isCurrency); }\nvar before = $context.$nodes.PROJECT_PLAN_ADVISOR_BUILD_PRE_ACTION_SUMMARY_V1.$output.result || {};\nvar after = $context.$nodes.PROJECT_PLAN_ADVISOR_BUILD_POST_ACTION_SUMMARY_V1.$output.result || {};\nvar rows = [\n  ['Quantity', before.quantity, after.quantity, false, false],\n  ['Raw cost', before.rawCost, after.rawCost, false, true],\n  ['Burdened cost', before.burdenedCost, after.burdenedCost, false, true],\n  ['Revenue', before.revenue, after.revenue, false, true],\n  ['Margin', before.margin, after.margin, false, true],\n  ['Margin %', before.marginPercent, after.marginPercent, true, false]\n];\nvar lines = [\n  '| Measure | Before | After | Delta |',\n  '| --- | --- | --- | --- |'\n];\nvar i;\nvar row;\nfor (i = 0; i < rows.length; i++) {\n  row = rows[i];\n  if (row[1] === null && row[2] === null) {\n    continue;\n  }\n  if (row[0] === 'Quantity') {\n    lines.push('| ' + row[0] + ' | ' + formatQuantity(row[1]) + ' | ' + formatQuantity(row[2]) + ' | ' + formatQuantityDelta(row[1], row[2]) + ' |');\n  } else {\n    lines.push('| ' + row[0] + ' | ' + cellText(row[1], row[3], row[4]) + ' | ' + cellText(row[2], row[3], row[4]) + ' | ' + formatDelta(row[1], row[2], row[3], row[4]) + ' |');\n  }\n}\nreturn {\n  projectName: trimString(after.projectName || before.projectName || ''),\n  projectNumber: trimString(after.projectNumber || before.projectNumber || ''),\n  planVersionId: trimString(after.planVersionId || before.planVersionId || ''),\n  comparisonTable: lines.join('\\n')\n};"
          },
          "outcomes": {
            "success": "1791000000010"
          },
