            "sourceCode": "function trimString(value) {\n  return String(value === null || value === undefined ? '' : value).trim();\n}\n\nfunction parseJsonSafe(value, fallback) {\n  if (value && typeof value === 'object') {\n    return value;\n  }\n  if (typeof value === 'string' && trimString(value) !== '') {\n    try {\n      return JSON.parse(value);\n    } catch (e) {}\n  }\n  return fallback;\n}\n\nfunction firstNonEmpty(values) {\n  for (var i = 0; i < values.length; i++) {\n    var value = trimString(values[i]);\n    if (value) {\n      return value;\n    }\n  }\n  return '';\n}\n\nfunction restInput() {\n  try {\n    if ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input && typeof $context.$triggers.REST.$input === 'object') {\n      return $context.$triggers.REST.$input;\n    }\n  } catch (e) {}\n  return {};\n}\n\nfunction nodeResult(code) {\n  try {\n    var node = $context.$nodes[code];\n    if (node && node.$output) {\n      return node.$output.result || node.$output;\n    }\n  } catch (e) {}\n  return {};\n}\n\nfunction readPath(code, fields) {\n  var value = nodeResult(code);\n  for (var i = 0; i < fields.length; i++) {\n    if (value === null || value === undefined) {\n      return '';\n    }\n    value = value[fields[i]];\n  }\n  return value === null || value === undefined ? '' : value;\n}\n\nfunction pickResponse() {\n  var candidates = [\n    ['PROJECT_PLAN_ADVISOR_BUILD_ENVELOPED_RESPONSE_V1', ['response']],\n    ['PROJECT_PLAN_ADVISOR_BUILD_CLARIFICATION_RESPONSE_V1', ['response']],\n    ['PROJECT_PLAN_ADVISOR_FORMAT_OFF_TOPIC_RESPONSE_V1', ['response']],\n    ['PROJECT_PLAN_ADVISOR_FORMAT_PLAN_NOT_FOUND_V2', ['response']],\n    ['PROJECT_PLAN_ADVISOR_RESOLVE_BASELINE_INPUTS', ['userMessage']],\n    ['PROJECT_PLAN_ADVISOR_RESOLVE_ADJUST_INPUTS', ['userMessage']],\n    ['PROJECT_PLAN_ADVISOR_RESOLVE_REFRESH_INPUTS_V2', ['userMessage']],\n    ['PROJECT_PLAN_ADVISOR_FORMAT_QA_RESPONSE', ['response']],\n    ['PPA_FORMAT_REPL_RESPONSE_FORCE1', ['response']],\n    ['PROJECT_PLAN_ADVISOR_VALIDATE_REFRESH_PERIOD_V1', ['userMessage']],\n    ['PROJECT_PLAN_ADVISOR_BUILD_REPLACEMENT_CONTEXT', ['message']],\n    ['PROJECT_PLAN_ADVISOR_FORMAT_RECOMMENDATIONS', ['response']],\n    ['PROJECT_PLAN_ADVISOR_FORMAT_REFRESH_FAILURE_RESPONSE_V1', ['response']],\n    ['PROJECT_PLAN_ADVISOR_RESOLVE_APPROVAL_RESOURCE', ['message']],\n    ['PROJECT_PLAN_ADVISOR_FORMAT_APPROVAL_RESPONSE', ['response']]\n  ];\n  for (var i = 0; i < candidates.length; i++) {\n    var value = readPath(candidates[i][0], candidates[i][1]);\n    if (trimString(value)) {\n      return String(value);\n    }\n  }\n  return '';\n}\n\nfunction stateFromReturnValue() {\n  var candidateCodes = [\n    'PROJECT_PLAN_ADVISOR_BUILD_ENVELOPED_RESPONSE_V1',\n    'PROJECT_PLAN_ADVISOR_FORMAT_PLAN_NOT_FOUND_V2',\n    'PPA_FORMAT_REPL_RESPONSE_FORCE1',\n    'PROJECT_PLAN_ADVISOR_FORMAT_APPROVAL_RESPONSE'\n  ];\n  for (var i = 0; i < candidateCodes.length; i++) {\n    var result = nodeResult(candidateCodes[i]);\n    var parsed = parseJsonSafe(result.returnValue, null);\n    if (parsed && parsed.stateJson) {\n      var state = parseJsonSafe(parsed.stateJson, {});\n      if (state && typeof state === 'object' && !Array.isArray(state)) {\n        return state;\n      }\n    }\n  }\n  return {};\n}\n\nfunction varString(name, fallback) {\n  try {\n    var value = $context.$variables[name];\n    if (value !== null && value !== undefined) {\n      if (typeof value === 'object') {\n        try {\n          return JSON.stringify(value);\n        } catch (ignore1) {\n          return fallback || '';\n        }\n      }\n      if (String(value).trim() !== '') {\n        return String(value);\n      }\n    }\n  } catch (e) {}\n  return fallback || '';\n}\n\nfunction buildContextDetails() {\n  var override = stateFromReturnValue();\n  function choose(name, fallback) {\n    if (override && Object.prototype.hasOwnProperty.call(override, name)) {\n      return override[name];\n    }\n    return varString(name, fallback || '');\n  }\n  var details = {\n    Intent: String(choose('Intent', '')),\n    IntentReason: String(choose('IntentReason', '')),\n    ProjectName: String(choose('ProjectName', '')),\n    TaskNumber: String(choose('TaskNumber', '')),\n    ResourceName: String(choose('ResourceName', '')),\n    ReplacementResourceName: String(choose('ReplacementResourceName', '')),\n    UnavailabilityDate: String(choose('UnavailabilityDate', '')),\n    CreateBudgetOnBaselineFlag: String(choose('CreateBudgetOnBaselineFlag', '')),\n    BudgetFinancialPlanType: String(choose('BudgetFinancialPlanType', '')),\n    AutoBaselineFlag: String(choose('AutoBaselineFlag', '')),\n    AdjustmentType: String(choose('AdjustmentType', '')),\n    AdjustmentPercentage: choose('AdjustmentPercentage', ''),\n    FromPeriod: String(choose('FromPeriod', '')),\n    ToPeriod: String(choose('ToPeriod', '')),\n    RefreshOnlyConversionRates: String(choose('RefreshOnlyConversionRates', '')),\n    RefreshRatesPeriodForward: String(choose('RefreshRatesPeriodForward', '')),\n    RetainRateOverride: String(choose('RetainRateOverride', '')),\n    INTENT_START: String(choose('INTENT_START', 'N')),\n    INTENT_END: String(choose('INTENT_END', 'Y')),\n    PendingAction: String(choose('PendingAction', '')),\n    PendingReplacementItemsJson: String(choose('PendingReplacementItemsJson', '[]')),\n    PendingProjectName: String(choose('PendingProjectName', '')),\n    PendingOldResourceName: String(choose('PendingOldResourceName', '')),\n    PendingNewResourceName: String(choose('PendingNewResourceName', '')),\n    PendingNewResourceElementId: choose('PendingNewResourceElementId', ''),\n    PendingPlanVersionId: String(choose('PendingPlanVersionId', '')),\n    PendingAssignmentSkeletons: String(choose('PendingAssignmentSkeletons', '')),\n    PendingCandidateListJson: String(choose('PendingCandidateListJson', '')),\n    PendingUnavailabilityDate: String(choose('PendingUnavailabilityDate', '')),\n    ReplacementAssistantStateJson: String(choose('ReplacementAssistantStateJson', '')),\n    EffectiveInputMessage: varString('EffectiveInputMessage', '')\n  };\n\n  var stateForNextTurn = {};\n  function copyStateFields(source) {\n    if (!source || typeof source !== 'object' || Array.isArray(source)) {\n      return;\n    }\n    for (var key in source) {\n      if (Object.prototype.hasOwnProperty.call(source, key) && key !== 'stateJson') {\n        stateForNextTurn[key] = source[key];\n      }\n    }\n  }\n  copyStateFields(details);\n  copyStateFields(override);\n  if (!Object.prototype.hasOwnProperty.call(stateForNextTurn, 'ReplacementAssistantStateJson')) {\n    stateForNextTurn.ReplacementAssistantStateJson = details.ReplacementAssistantStateJson || '';\n  }\n  details.stateJson = JSON.stringify(stateForNextTurn);\n  return details;\n}\n\nfunction titleForIntent(intent) {\n  var value = trimString(intent);\n  if (value === 'PLAN_BASELINE') return 'Project Plan Baseline';\n  if (value === 'PLAN_ADJUST') return 'Project Plan Adjustment';\n  if (value === 'PLAN_REFRESH_RATES') return 'Project Plan Rate Refresh';\n  if (value === 'RESOURCE_REPLACEMENT_REQUEST' || value.indexOf('REPLACE_') === 0) return 'Project Resource Replacement';\n  if (value === 'RESOURCE_ASSIGNMENT_LOOKUP') return 'Resource Assignments';\n  if (value === 'RESOURCE_ALLOCATION') return 'Resource Allocation';\n  if (value === 'OUT_OF_SCOPE') return 'Project Planning Request';\n  return 'Project Planning Advisor';\n}\n\nfunction cleanMarkdown(value) {\n  var text = trimString(value);\n  text = text.replace(/`/g, '');\n  text = text.replace(/\\*\\*/g, '');\n  text = text.replace(/__/g, '');\n  text = text.replace(/\\s+/g, ' ');\n  return trimString(text);\n}\n\nfunction splitLines(value) {\n  return String(value || '').replace(/\\r\\n/g, '\\n').replace(/\\r/g, '\\n').split('\\n');\n}\n\nfunction isTableLine(line) {\n  var text = trimString(line);\n  return text.charAt(0) === '|' && text.lastIndexOf('|') > 0;\n}\n\nfunction parseTableCells(line) {\n  var text = trimString(line);\n  if (text.charAt(0) === '|') {\n    text = text.substring(1);\n  }\n  if (text.charAt(text.length - 1) === '|') {\n    text = text.substring(0, text.length - 1);\n  }\n  var raw = text.split('|');\n  var cells = [];\n  for (var i = 0; i < raw.length; i++) {\n    cells.push(cleanMarkdown(raw[i]));\n  }\n  return cells;\n}\n\nfunction isTableSeparator(line) {\n  if (!isTableLine(line)) {\n    return false;\n  }\n  var cells = parseTableCells(line);\n  if (!cells.length) {\n    return false;\n  }\n  for (var i = 0; i < cells.length; i++) {\n    if (!/^:?-{2,}:?$/.test(cells[i].replace(/\\s/g, ''))) {\n      return false;\n    }\n  }\n  return true;\n}\n\nfunction toCamelId(value, fallback) {\n  var text = cleanMarkdown(value).toLowerCase();\n  var special = {\n    'version': 'version',\n    'version name': 'versionName',\n    'plan version id': 'planVersionId',\n    'financial plan type': 'financialPlanType',\n    'total cost': 'totalCost',\n    'revenue': 'revenue',\n    'margin': 'margin',\n    'margin %': 'marginPercent',\n    'option': 'option',\n    'resource': 'resource',\n    'coverage': 'coverage',\n    'best': 'best',\n    'task cost impact': 'taskCostImpact',\n    'task margin impact': 'taskMarginImpact',\n    'project cost impact': 'projectCostImpact',\n    'project margin impact': 'projectMarginImpact',\n    'task': 'task',\n    'task number': 'taskNumber',\n    'task name': 'taskName',\n    'resource name': 'resourceName'\n  };\n  if (special[text]) {\n    return special[text];\n  }\n  var parts = text.replace(/[^a-z0-9]+/g, ' ').trim().split(/\\s+/);\n  var id = '';\n  for (var i = 0; i < parts.length; i++) {\n    if (!parts[i]) {\n      continue;\n    }\n    if (!id) {\n      id = parts[i];\n    } else {\n      id += parts[i].charAt(0).toUpperCase() + parts[i].slice(1);\n    }\n  }\n  return id || fallback;\n}\n\nfunction uniqueFieldId(base, used) {\n  var id = base || 'value';\n  var candidate = id;\n  var index = 2;\n  while (used[candidate]) {\n    candidate = id + index;\n    index++;\n  }\n  used[candidate] = true;\n  return candidate;\n}\n\nfunction inferTableHeading(headers, title) {\n  var joined = headers.join('|').toLowerCase();\n  if (joined.indexOf('version') >= 0 && joined.indexOf('margin') >= 0) {\n    return 'Plan Version Comparison';\n  }\n  if (joined.indexOf('option') >= 0 && joined.indexOf('resource') >= 0) {\n    return 'Replacement Options';\n  }\n  if (joined.indexOf('task') >= 0 && joined.indexOf('resource') >= 0) {\n    return 'Resource Assignment Details';\n  }\n  return title || 'Project Planning Details';\n}\n\nfunction buildTableBlock(headers, rowCells, sequence, title) {\n  var used = {};\n  var columns = [];\n  var rows = [];\n  var i;\n  for (i = 0; i < headers.length; i++) {\n    var header = cleanMarkdown(headers[i]) || ('Column ' + (i + 1));\n    var field = uniqueFieldId(toCamelId(header, 'column' + (i + 1)), used);\n    columns.push({\n      headerText: header,\n      field: field,\n      className: '',\n      resizable: 'enabled',\n      id: field,\n      template: ''\n    });\n  }\n  for (i = 0; i < rowCells.length; i++) {\n    var row = {};\n    for (var c = 0; c < columns.length; c++) {\n      row[columns[c].field] = cleanMarkdown(rowCells[i][c] || '');\n    }\n    rows.push(row);\n  }\n  var key = columns.length ? columns[0].field : 'id';\n  var heading = inferTableHeading(headers, title);\n  return {\n    display_type: 'table',\n    display_sequence: sequence,\n    heading: heading,\n    rows: { items: rows },\n    columns: { items: columns },\n    keyAttributes: { items: [key] },\n    accessibility: {\n      'aria-label': 'This table lists ' + heading + ' for project planning review',\n      'row.accessible-row-header': key\n    }\n  };\n}\n\nfunction isListLine(line) {\n  return /^\\s*(?:[-*]\\s+|\\d+[.)]\\s+)/.test(line || '');\n}\n\nfunction listItemText(line) {\n  return cleanMarkdown(String(line || '').replace(/^\\s*(?:[-*]\\s+|\\d+[.)]\\s+)/, ''));\n}\n\nfunction buildListBlock(items, sequence, header) {\n  var listItems = [];\n  for (var i = 0; i < items.length; i++) {\n    var text = cleanMarkdown(items[i]);\n    if (text) {\n      listItems.push({\n        id: 'item' + (listItems.length + 1),\n        Default: text,\n        value: text\n      });\n    }\n  }\n  return {\n    display_type: 'list',\n    display_sequence: sequence,\n    header: header || 'Suggested Options',\n    fields: { items: listItems },\n    selection_mode: 'none',\n    keyAttributes: { items: ['id'] },\n    accessibility: {\n      'aria-label': 'This list displays ' + (header || 'Suggested Options') + ' for project planning'\n    }\n  };\n}\n\nfunction buildTextBlock(text, sequence, heading) {\n  var block = {\n    display_type: 'text',\n    display_sequence: sequence,\n    text: cleanMarkdown(text)\n  };\n  if (heading) {\n    block.heading = heading;\n  }\n  return block;\n}\n\nfunction actionItemsFor(contextDetails, response) {\n  var pending = trimString(contextDetails.PendingAction || '');\n  var text = String(response || '').toLowerCase();\n  if (pending === 'BUDGET_FOLLOWUP_CONFIRM') {\n    return ['Yes, continue', 'No, skip'];\n  }\n  if (pending === 'BUDGET_GENERATE_CONFIRM') {\n    return ['Yes, generate budget', 'No, skip'];\n  }\n  if (pending === 'PROJECT_MATCH_CONFIRM') {\n    return ['Yes, proceed', 'No, use another project'];\n  }\n  if (pending === 'COMMIT_REPLACEMENT' || text.indexOf('reply approve') >= 0) {\n    return ['Approve', 'Request changes'];\n  }\n  if (text.indexOf('reply go ahead') >= 0 || text.indexOf('select the replacement resource') >= 0 || text.indexOf('best recommendation') >= 0) {\n    return ['Go ahead', 'Choose another option', 'Request changes'];\n  }\n  return [];\n}\n\nfunction buildActionBlock(actions, sequence) {\n  return {\n    display_type: 'action',\n    display_sequence: sequence,\n    recommendations: { items: actions }\n  };\n}\n\nfunction responseDescription(response, fallback) {\n  var lines = splitLines(response);\n  var pieces = [];\n  for (var i = 0; i < lines.length; i++) {\n    if (isTableLine(lines[i]) || isTableSeparator(lines[i]) || isListLine(lines[i])) {\n      continue;\n    }\n    var text = cleanMarkdown(lines[i]);\n    if (text) {\n      pieces.push(text);\n    }\n    if (pieces.join(' ').length > 280) {\n      break;\n    }\n  }\n  var summary = cleanMarkdown(pieces.join(' '));\n  if (summary.length > 320) {\n    summary = summary.substring(0, 317) + '...';\n  }\n  return summary || fallback;\n}\n\nfunction buildBlocksFromResponse(response, title, contextDetails) {\n  var lines = splitLines(response);\n  var blocks = [];\n  var textBuffer = [];\n  var sequence = 1;\n\n  function flushText() {\n    var text = cleanMarkdown(textBuffer.join('\\n'));\n    textBuffer = [];\n    if (text) {\n      blocks.push(buildTextBlock(text, sequence, blocks.length ? '' : title));\n      sequence++;\n    }\n  }\n\n  for (var i = 0; i < lines.length; i++) {\n    if (isTableLine(lines[i]) && i + 1 < lines.length && isTableSeparator(lines[i + 1])) {\n      flushText();\n      var headers = parseTableCells(lines[i]);\n      i += 2;\n      var rows = [];\n      while (i < lines.length && isTableLine(lines[i])) {\n        rows.push(parseTableCells(lines[i]));\n        i++;\n      }\n      i--;\n      if (headers.length && rows.length) {\n        blocks.push(buildTableBlock(headers, rows, sequence, title));\n        sequence++;\n      }\n      continue;\n    }\n\n    if (isListLine(lines[i])) {\n      flushText();\n      var items = [];\n      while (i < lines.length && isListLine(lines[i])) {\n        items.push(listItemText(lines[i]));\n        i++;\n      }\n      i--;\n      if (items.length) {\n        blocks.push(buildListBlock(items, sequence, 'Suggested Options'));\n        sequence++;\n      }\n      continue;\n    }\n\n    textBuffer.push(lines[i]);\n  }\n\n  flushText();\n\n  var actions = actionItemsFor(contextDetails, response);\n  if (actions.length) {\n    blocks.push(buildActionBlock(actions, sequence));\n    sequence++;\n  }\n\n  if (!blocks.length) {\n    blocks.push(buildTextBlock('I could not produce a project planning response for this request.', sequence, title));\n  }\n\n  return blocks;\n}\n\nfunction buildRedwoodContent(response, contextDetails) {\n  var parsedResponse = parseJsonSafe(response, null);\n  if (parsedResponse && parsedResponse.agent && parsedResponse.agent_response) {\n    return parsedResponse;\n  }\n\n  var title = titleForIntent(contextDetails.Intent);\n  var description = responseDescription(response, title);\n  return {\n    agent: 'PRJ_PJO_PROJECT_PLANNING_ADVISOR',\n    intent: contextDetails.Intent || 'PROJECT_PLANNING_RESPONSE',\n    schema_version: '1',\n    title: title,\n    description: description,\n    timestamp: new Date().toISOString(),\n    agent_response: buildBlocksFromResponse(response, title, contextDetails)\n  };\n}\n\nvar input = restInput();\nvar routingContext = firstNonEmpty([input.prjPjfRoutingContext, $context.$variables.prjPjfRoutingContext]);\nvar response = pickResponse();\nvar contextDetails = buildContextDetails();\nvar content = buildRedwoodContent(response, contextDetails);\nvar atomicAgentDetails = {\n  atomicAgentCode: 'PRJ_PJO_PROJECT_PLANNING_ADVISOR',\n  atomicAgentContext: 'Project Planning Advisor',\n  contextDetails: contextDetails,\n  filters: null,\n  atomicAgentResponse: content\n};\nvar contract = {\n  redwoodResponse: {\n    type: 'redwood',\n    content: content\n  },\n  atomicAgentDetails: atomicAgentDetails\n};\n\nreturn {\n  response: response,\n  redwoodResponse: contract.redwoodResponse,\n  atomicAgentDetails: atomicAgentDetails,\n  returnValue: routingContext.toLowerCase() === 'redwoodui' ? JSON.stringify(contract) : response\n};\n"
