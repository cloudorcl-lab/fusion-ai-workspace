            "sourceCode": "($context.__codeTmp={r:null},eval(\"try{var items = $context.$nodes.PROJECT_PLAN_ADVISOR_FETCH_ASSIGNMENTS.$output.items || [];\\nvar oldResourceName = ($context.$variables.ResourceName || '').toLowerCase();\\nvar affectedAssignments = [];\\nfor (var i = 0; i < items.length; i++) {\\n  var item = items[i];\\n  var assignmentName = String(item.ResourceName || '').toLowerCase();\\n  if (oldResourceName === '' || assignmentName === oldResourceName) {\\n    affectedAssignments.push({\\n      planVersionId: String($context.$nodes.PROJECT_PLAN_ADVISOR_SELECT_PLAN.$output.result.planVersionId || ''),\\n      taskId: item.TaskId,\\n      taskNumber: item.TaskNumber || '',\\n      taskName: item.TaskName || '',\\n      oldResourceElementId: item.RbsElementId,\\n      oldResourceName: item.ResourceName || ''\\n    });\\n  }\\n}\\nvar result = {\\n  hasAssignments: affectedAssignments.length > 0,\\n  message: '',\\n  affectedAssignments: affectedAssignments\\n};\\nif (affectedAssignments.length === 0) {\\n  result.message = 'I could not find any matching resource assignments for ' + ($context.$variables.ResourceName || 'the requested resource') + ' in project ' + ($context.$nodes.PROJECT_PLAN_ADVISOR_SELECT_PLAN.$output.result.projectName || '') + '.';\\n}\\n$context.__codeTmp.r=(result);throw 0;}catch(e){if(e!==0)throw e;}\"),$context.__codeTmp.r)"
