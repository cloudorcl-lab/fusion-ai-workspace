            "name": "Format Budget Sync Response",
            "returnType": "object",
            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\nfunction toNumber(value) {\n  var num;\n  if (value == null || value === '') { return null; }\n  num = Number(value);\n  return isNaN(num) ? null : num;\n}\nfunction formatAmount(value) {\n  var num = toNumber(value);\n  var parts;\n  var text;\n  var sign;\n  if (num === null) { return 'N/A'; }\n  sign = num < 0 ? '-' : '';\n  text = Math.abs(num).toFixed(2);\n  parts = text.split('.');\n  parts[0] = parts[0].replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',');\n  return sign + '$' + parts[0] + '.' + parts[1];\n}\nfunction computeMargin(revenue, cost) {\n  var revenueNum = toNumber(revenue);\n  var costNum = toNumber(cost);\n  if (revenueNum === null || costNum === null) { return { amount: null, percent: null }; }\n  return { amount: revenueNum - costNum, percent: revenueNum === 0 ? null : ((revenueNum - costNum) / revenueNum) * 100 };\n}\nfunction formatPercent(value) {\n  var num = toNumber(value);\n  if (num === null) { return 'N/A'; }\n  return num.toFixed(2) + '%';\n}\nfunction tableText(value) {\n  var text = trimString(value);\n  return text ? text.replace(/\\|/g, '/') : 'N/A';\n}\nfunction buildRow(label, versionName, planVersionId, financialPlanType, cost, revenue) {\n  var margin = computeMargin(revenue, cost);\n  return '| ' + tableText(label) + ' | ' + tableText(versionName) + ' | ' + tableText(planVersionId) + ' | ' + tableText(financialPlanType) + ' | ' + formatAmount(cost) + ' | ' + formatAmount(revenue) + ' | ' + formatAmount(margin.amount) + ' | ' + formatPercent(margin.percent) + ' |';\n}\nfunction buildComparisonTable(rows) {\n  var lines = ['| Version | Version Name | Plan Version Id | Financial Plan Type | Total Cost | Revenue | Margin | Margin % |','| --- | --- | --- | --- | --- | --- | --- | --- |'];\n  var i;\n  for (i = 0; i < rows.length; i++) { lines.push(rows[i]); }\n  return lines.join('\\n');\n}\nfunction hasSummaryRow(item, prefix) {\n  return !!(trimString(item[prefix + 'PlanVersionName'] || '') || trimString(item[prefix + 'PlanVersionId'] || '') || trimString(item.FinancialPlanType || '') || toNumber(item[prefix + 'PCBurdenedCostAmounts']) !== null || toNumber(item[prefix + 'PCRevenueAmounts']) !== null);\n}\nfunction extractText(value) {\n  var text;\n  if (value == null) { return ''; }\n  if (typeof value === 'string') {\n    text = trimString(value);\n    if (!text) { return ''; }\n    if (text.charAt(0) === '{' || text.charAt(0) === '[') {\n      try { return extractText(JSON.parse(text)); } catch (ignore1) {}\n    }\n    return text;\n  }\n  if (Array.isArray(value)) { return trimString(JSON.stringify(value)); }\n  if (typeof value === 'object') {\n    if (value.response !== undefined) { text = extractText(value.response); if (text) { return text; } }\n    if (value.output !== undefined) { text = extractText(value.output); if (text) { return text; } }\n    if (value.result !== undefined) { text = extractText(value.result); if (text) { return text; } }\n    return trimString(JSON.stringify(value));\n  }\n  return trimString(value);\n}\nfunction extractSummaryItems(value) {\n  var items;\n  if (value == null) { return []; }\n  if (Array.isArray(value)) { return value; }\n  if (typeof value === 'string') {\n    value = trimString(value);\n    if (!value) { return []; }\n    if (value.charAt(0) === '{' || value.charAt(0) === '[') {\n      try { return extractSummaryItems(JSON.parse(value)); } catch (ignore1) { return []; }\n    }\n    return [];\n  }\n  if (typeof value === 'object') {\n    if (value.result !== undefined) { items = extractSummaryItems(value.result); if (items.length) { return items; } }\n    if (value.output !== undefined) { items = extractSummaryItems(value.output); if (items.length) { return items; } }\n    if (value.response !== undefined) { items = extractSummaryItems(value.response); if (items.length) { return items; } }\n    if (Array.isArray(value.items)) { return value.items; }\n    if (value.PlanVersionName !== undefined || value.PlanVersionDescription !== undefined || value.OlderVersionPlanVersionName !== undefined || value.ErrorMessage !== undefined) { return [value]; }\n  }\n  return [];\n}\nvar raw = $context.$nodes.PROJECT_PLAN_ADVISOR_CALL_BUDGET_SYNCHRONIZER_V1.$output || {};\nvar items = extractSummaryItems(raw);\nvar summaryText = extractText(raw);\nvar tables = [];\nvar response;\nvar i;\nvar item;\nvar rows;\nvar projectName = String(($context.$nodes.PROJECT_PLAN_ADVISOR_SELECT_PLAN.$output.result || {}).projectName || $context.$variables.ProjectName || 'the selected project');\nfor (i = 0; i < items.length; i++) {\n  item = items[i] || {};\n  if (trimString(item.ErrorMessage || '')) {\n    summaryText = trimString(item.ErrorMessage);\n    items = [];\n    break;\n  }\n}\nif (items.length) {\n  for (i = 0; i < items.length; i++) {\n    item = items[i] || {};\n    rows = [];\n    if (hasSummaryRow(item, 'OlderVersion')) {\n      rows.push(buildRow('Previous', item.OlderVersionPlanVersionName || 'Previous budget version', item.OlderVersionPlanVersionId || '', item.FinancialPlanType || '', item.OlderVersionPCBurdenedCostAmounts, item.OlderVersionPCRevenueAmounts));\n    }\n    rows.push(buildRow('Generated', item.PlanVersionName || item.PlanVersionDescription || 'Generated budget version', item.PlanVersionId || '', item.FinancialPlanType || '', item.PCBurdenedCostAmounts, item.PCRevenueAmounts));\n    tables.push(buildComparisonTable(rows));\n  }\n  response = 'Budget follow-up completed for project ' + projectName + '.' + '\\n\\n' + tables.join('\\n\\n');\n  return { response: response };\n}\nif (!summaryText || /not completed|could not|failed|no summary da(?:ta) was available/i.test(summaryText)) {\n  response = 'Budget follow-up could not be completed for project ' + projectName + '. ' + (summaryText || 'The synchronizer did not return a usable summary.');\n} else {\n  response = 'Budget follow-up completed for project ' + projectName + '. ' + summaryText;\n}\nreturn { response: response };"
