            "sourceCode": "var items = ($context.$nodes.PROJECT_PLAN_ADVISOR_FETCH_POST_ACTION_PLAN_V1.$output || {}).items || [];\nvar projectName = String(($context.$nodes.PROJECT_PLAN_ADVISOR_SELECT_PLAN.$output.result || {}).projectName || $context.$variables.ProjectName || '').trim();\nvar selected = null;\nvar i;\nvar item;\nvar plan = { planFound:false, planVersionId:'', projectId:null, projectName:projectName, projectNumber:'', projectPlanType:'', planVersionStatus:'', planningOptions:{} };\nfor (i = 0; i < items.length; i++) {\n  item = items[i] || {};\n  if (String(item.ProjectName || '').trim() === projectName && String(item.PlanVersionStatus || '') === 'Current Working') {\n    selected = item;\n    break;\n  }\n}\nif (!selected) {\n  for (i = 0; i < items.length; i++) {\n    item = items[i] || {};\n    if (String(item.ProjectName || '').trim() === projectName) {\n      selected = item;\n      break;\n    }\n  }\n}\nif (!selected && items.length) {\n  selected = items[0] || null;\n}\nif (selected) {\n  plan.planFound = true;\n  plan.planVersionId = String(selected.PlanVersionId || '');\n  plan.projectId = selected.ProjectId;\n  plan.projectName = selected.ProjectName || '';\n  plan.projectNumber = selected.ProjectNumber || '';\n  plan.projectPlanType = selected.ProjectPlanType || '';\n  plan.planVersionStatus = selected.PlanVersionStatus || '';\n  plan.PCRawCostAmounts = selected.PCRawCostAmounts;\n  plan.PCBurdenedCostAmounts = selected.PCBurdenedCostAmounts;\n  plan.PCRevenueAmounts = selected.PCRevenueAmounts;\n  plan.Margin = selected.Margin;\n  plan.MarginPercentage = selected.MarginPercentage;\n  if (selected.PlanningOptions && selected.PlanningOptions.items && selected.PlanningOptions.items.length > 0) {\n    plan.planningOptions = selected.PlanningOptions.items[0];\n  }\n}\nreturn plan;"
