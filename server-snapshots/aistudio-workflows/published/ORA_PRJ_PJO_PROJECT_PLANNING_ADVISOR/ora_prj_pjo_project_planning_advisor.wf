            "sourceCode": "function trimString(value) { return String(value == null ? '' : value).trim(); }\nfunction parseBoolean(value) {\n  var text;\n  var nested;\n  var keys;\n  var i;\n  if (typeof value === 'boolean') { return value; }\n  if (value == null) { return null; }\n  if (typeof value === 'string') {\n    text = trimString(value).toLowerCase();\n    if (!text) { return null; }\n    if (text === 'true' || text === 'yes' || text === 'y') { return true; }\n    if (text === 'false' || text === 'no' || text === 'n') { return false; }\n    if (text.charAt(0) === '{' || text.charAt(0) === '[') {\n      try { nested = JSON.parse(text); return parseBoolean(nested); } catch (ignore1) {}\n    }\n    return null;\n  }\n  if (Array.isArray(value)) {\n    for (i = 0; i < value.length; i++) {\n      nested = parseBoolean(value[i]);\n      if (nested !== null) { return nested; }\n    }\n    return value.length ? null : false;\n  }\n  if (typeof value === 'object') {\n    keys = ['IsProjectBudgetWithSourceFromFPPExists','isProjectBudgetWithSourceFromFPPExists','hasBudgetSource','result','output','response'];\n    for (i = 0; i < keys.length; i++) {\n      if (value[keys[i]] !== undefined) {\n        nested = parseBoolean(value[keys[i]]);\n        if (nested !== null) { return nested; }\n      }\n    }\n  }\n  return null;\n}\nvar raw = $context.$nodes.PROJECT_PLAN_ADVISOR_CALL_BUDGET_SOURCE_VALIDATOR_V1.$output || {};\nreturn { hasBudgetSource: parseBoolean(raw) === true };"
