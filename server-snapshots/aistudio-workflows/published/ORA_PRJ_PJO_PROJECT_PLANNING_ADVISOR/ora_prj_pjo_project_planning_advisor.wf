            "sourceCode": "function chooseActionOutput() {\n  if ($context.$nodes.PROJECT_PLAN_ADVISOR_CALL_BASELINE && $context.$nodes.PROJECT_PLAN_ADVISOR_CALL_BASELINE.$output) {\n    return { intent: 'PLAN_BASELINE', raw: $context.$nodes.PROJECT_PLAN_ADVISOR_CALL_BASELINE.$output };\n  }\n  if ($context.$nodes.PROJECT_PLAN_ADVISOR_CALL_ADJUST && $context.$nodes.PROJECT_PLAN_ADVISOR_CALL_ADJUST.$output) {\n    return { intent: 'PLAN_ADJUST', raw: $context.$nodes.PROJECT_PLAN_ADVISOR_CALL_ADJUST.$output };\n  }\n  if ($context.$nodes.PROJECT_PLAN_ADVISOR_CALL_REFRESH_RATES_V2 && $context.$nodes.PROJECT_PLAN_ADVISOR_CALL_REFRESH_RATES_V2.$output) {\n    return { intent: 'PLAN_REFRESH_RATES', raw: $context.$nodes.PROJECT_PLAN_ADVISOR_CALL_REFRESH_RATES_V2.$output };\n  }\n  return { intent: 'PLAN_REFRESH_RATES', raw: ($context.$nodes.PROJECT_PLAN_ADVISOR_CALL_REFRESH_RATES || {}).$output || {} };\n}\nvar selected = chooseActionOutput();\nvar table = ($context.$nodes.PROJECT_PLAN_ADVISOR_BUILD_PLAN_COMPARISON_TABLE_V1.$output.result || {}).comparisonTable || '';\nvar summary = $context.$nodes.PROJECT_PLAN_ADVISOR_BUILD_PLAN_COMPARISON_TABLE_V1.$output.result || {};\nvar projectName = summary.projectName || (($context.$nodes.PROJECT_PLAN_ADVISOR_SELECT_POST_ACTION_PLAN_V1.$output.result || {}).projectName || ($context.$nodes.PROJECT_PLAN_ADVISOR_SELECT_PLAN.$output.result || {}).projectName || 'the selected project');\nvar actionMessage = selected.intent === 'PLAN_BASELINE'\n  ? ('Baseline completed for project ' + projectName + '.')\n  : (selected.intent === 'PLAN_ADJUST'\n      ? ('Successfully adjusted the plan for project ' + projectName + '.')\n      : ('Refresh rates completed for project ' + projectName + '.'));\nvar budgetMessage = 'I can now check whether any budget versions are sourced from this project plan and synchronize them, or generate a new budget from the latest project plan if none exists. Reply yes to continue or no to skip.';\nreturn {\n  response