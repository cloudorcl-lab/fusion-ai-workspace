ctNumber:num});}if(suggestions.length){for(i=0;i<suggestions.length;i++)lines.push(String(suggestions[i].optionIndex)+'. '+suggestions[i].projectName+(suggestions[i].projectNumber?' ('+suggestions[i].projectNumber+')':''));if(suggestions.length===1)msg='Could not find the matching project name provided by you: '+requested+'.'+String.fromCharCode(10)+String.fromCharCode(10)+'I found one close match:'+String.fromCharCode(10)+lines[0]+String.fromCharCode(10)+String.fromCharCode(10)+'Reply yes to proceed with this project, or provide the correct project name.';else msg='Could not find the matching project name provided by you: '+requested+'.'+String.fromCharCode(10)+String.fromCharCode(10)+'These project names closely match:'+String.fromCharCode(10)+lines.join(String.fromCharCode(10))+String.fromCharCode(10)+String.fromCharCode(10)+'Reply with one of the project names above and I will continue.';}else msg='Could not find a financial project plan for project '+requested+'. Please verify the project name and try again.';}}else{for(i=0;i<items.length;i++){item=items[i]||{};if(String(item.PlanVersionStatus||'')==='Current Working'){selected=item;break;}}if(selected===null&&items.length>0)selected=items[0]||null;}if(selected!==null){plan.planFound=true;plan.planVersionId=String(selected.PlanVersionId||'');plan.projectId=selected.ProjectId;plan.projectName=selected.ProjectName||'';plan.projectNumber=selected.ProjectNumber||'';plan.projectPlanType=selected.ProjectPlanType||'';plan.planVersionStatus=selected.PlanVersionStatus||'';if(selected.PlanningOptions&&selected.PlanningOptions.items&&selected.PlanningOptions.items.length>0)plan.planningOptions=selected.PlanningOptions.items[0];}else{if(!msg)msg='Could not find a financial project plan for project '+(requested||'the provided project')+'. Please correct the project name and try again.';plan.notFoundMessage=msg;}$context.__codeTmp.r=plan;throw 0;}catch(e){if(e!==0)throw e;}\"),$context.__codeTmp.r)"
