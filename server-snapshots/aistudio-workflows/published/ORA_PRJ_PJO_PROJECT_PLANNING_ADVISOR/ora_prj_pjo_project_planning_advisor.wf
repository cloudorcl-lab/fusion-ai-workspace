 --- |']; var i; for (i = 0; i < rows.length; i++) { lines.push(rows[i]); } return lines.join('\\n'); }\nvar template = $context.$nodes.PROJECT_PLAN_ADVISOR_SELECT_BUDGET_TEMPLATE_V1.$output.result || {};\nvar created = ($context.$nodes.PROJECT_PLAN_ADVISOR_CREATE_BUDGET_FROM_PROJECT_PLAN_V1.$output || {}).result || $context.$nodes.PROJECT_PLAN_ADVISOR_CREATE_BUDGET_FROM_PROJECT_PLAN_V1.$output || {};\nvar projectName = trimString(($context.$nodes.PROJECT_PLAN_ADVISOR_SELECT_PLAN.$output.result || {}).projectName || $context.$variables.ProjectName || '');\nvar errorText = trimString(created._budgetCreateError || '');\nvar newVersionName;\nvar newVersionId;\nvar financialPlanType;\nvar previousName;\nvar previousId;\nvar previousCost;\nvar previousRevenue;\nvar newCost;\nvar newRevenue;\nvar rows = [];\nif (errorText) { return { response: 'Budget follow-up could not be completed for project ' + (projectName || 'the selected project') + '. ' + errorText }; }\nnewVersionName = trimString(created.PlanVersionName || created.PlanVersionDescription || 'Agent Generated Budget Version');\nnewVersionId = trimString(created.PlanVersionId || '');\nfinancialPlanType = trimString(created.FinancialPlanType || template.financialPlanType || '');\npreviousName = trimString(created.OlderVersionPlanVersionName || template.olderVersionPlanVersionName || '');\npreviousId = trimString(created.OlderVersionPlanVersionId || template.olderVersionPlanVersionId || '');\npreviousCost = created.OlderVersionPCBurdenedCostAmounts != null ? created.OlderVersionPCBurdenedCostAmounts : template.olderVersionPCBurdenedCostAmounts;\npreviousRevenue = created.OlderVersionPCRevenueAmounts != null ? created.OlderVersionPCRevenueAmounts : template.olderVersionPCRevenueAmounts;\nnewCost = created.PCBurdenedCostAmounts;\nnewRevenue = created.PCRevenueAmounts;\nif (hasRowData(previousName, previousId, financialPlanType, previousCost, previousRevenue)) { rows.push(buildRow('Previous', previousName || 'Previous budget version', previousId, financialPlanType, previousCost, previousRevenue)); }\nrows.push(buildRow('Generated', newVersionName, newVersionId, financialPlanType, newCost, newRevenue));\nreturn { response: 'Budget generation completed for project ' + (projectName || 'the selected project') + '.' + '\\n\\n' + buildComparisonTable(rows) };"
