            "returnType": "object",
            "sourceCode": "function trimString(value) { return String(value == null ? '' : value).trim(); }\nfunction nodeResponse(code) {\n  var node;\n  try {\n    node = $context.$nodes[code];\n    if (node && node.$output && node.$output.result && node.$output.result.response) {\n      return String(node.$output.result.response || '');\n    }\n  } catch (e) {}\n  return '';\n}\nfunction firstNodeResponse(candidates) {\n  var i;\n  var response;\n  for (i = 0; i < candidates.length; i++) {\n    response = nodeResponse(candidates[i]);\n    if (trimString(response)) {\n      return response;\n    }\n  }\n  return '';\n}\nfunction joinResponses(first, second) {\n  first = trimString(first);\n  second = trimString(second);\n  if (first && second) {\n    return first + '\\n\\n' + second;\n  }\n  return first || second;\n}\nfunction budgetPrompt() {\n  return 'I can now check whether any budget versions are sourced from this project plan and synchronize them, or generate a new budget from the latest project plan if none exists. Reply yes to continue or no to skip.';\n}\nfunction appendBudgetPrompt(response) {\n  response = trimString(response);\n  if (!response) {\n    return budgetPrompt();\n  }\n  if (/reply\\s+yes\\s+to\\s+continue\\s+or\\s+no\\s+to\\s+skip/i.test(response)) {\n    return response;\n  }\n  if (/continue\\s+with\\s+budget\\s+generation\\s+or\\s+synchronization/i.test(response)) {\n    return response + ' Reply yes to continue or no to skip.';\n  }\n  return response + '\\n\\n' + budgetPrompt();\n}\nfunction getResponse() {\n  var replacementResponse = nodeResponse('PPA_FORMAT_REPL_RESPONSE_FORCE1');\n  var approvalResponse = nodeResponse('PROJECT_PLAN_ADVISOR_FORMAT_APPROVAL_RESPONSE');\n  var budgetResponse = firstNodeResponse([\n    'PROJECT_PLAN_ADVISOR_FORMAT_BUDGET_SYNC_RESPONSE_V2',\n    'PROJECT_PLAN_ADVISOR_FORMAT_BUDGET_SYNC_RESPONSE_V1',\n    'PROJECT_PLAN_ADVISOR_FORMAT_BUDGET_GENERATE_RESPONSE_V2',\n    'PROJECT_PLAN_ADVISOR_FORMAT_BUDGET_GENERATE_UNAVAILABLE_V2',\n    'PROJECT_PLAN_ADVISOR_FORMAT_BUDGET_SYNC_SKIPPED_V2',\n    'PROJECT_PLAN_ADVISOR_FORMAT_BUDGET_GENERATE_RESPONSE_V1',\n    'PROJECT_PLAN_ADVISOR_FORMAT_BUDGET_GENERATE_UNAVAILABLE_V1',\n    'PROJECT_PLAN_ADVISOR_FORMAT_BUDGET_SYNC_SKIPPED_V1',\n    'PROJECT_PLAN_ADVISOR_FORMAT_BUDGET_CHECK_UNAVAILABLE_V1'\n  ]);\n  if (budgetResponse && replacementResponse) {\n    return joinResponses(replacementResponse, budgetResponse);\n  }\n  if (budgetResponse && approvalResponse) {\n    return joinResponses(approvalResponse, budgetResponse);\n  }\n  if (!budgetResponse && trimString($context.$variables.PendingAction || '') === 'BUDGET_FOLLOWUP_CONFIRM') {\n    return appendBudgetPrompt(replacementResponse || approvalResponse);\n  }\n  return firstNodeResponse([\n    'PPA_FORMAT_REPL_RESPONSE_FORCE1',\n    'PROJECT_PLAN_ADVISOR_FORMAT_APPROVAL_RESPONSE',\n    'PROJECT_PLAN_ADVISOR_FORMAT_PLAN_MUTATION_RESPONSE_V1',\n    'PROJECT_PLAN_ADVISOR_FORMAT_BUDGET_SYNC_RESPONSE_V2',\n    'PROJECT_PLAN_ADVISOR_FORMAT_BUDGET_SYNC_RESPONSE_V1',\n    'PROJECT_PLAN_ADVISOR_FORMAT_BUDGET_GENERATE_RESPONSE_V2',\n    'PROJECT_PLAN_ADVISOR_FORMAT_BUDGET_GENERATE_UNAVAILABLE_V2',\n    'PROJECT_PLAN_ADVISOR_FORMAT_BUDGET_SYNC_SKIPPED_V2',\n    'PROJECT_PLAN_ADVISOR_FORMAT_BUDGET_GENERATE_RESPONSE_V1',\n    'PROJECT_PLAN_ADVISOR_FORMAT_BUDGET_GENERATE_UNAVAILABLE_V1',\n    'PROJECT_PLAN_ADVISOR_FORMAT_BUDGET_SYNC_SKIPPED_V1',\n    'PROJECT_PLAN_ADVISOR_FORMAT_BUDGET_CHECK_UNAVAILABLE_V1'\n  ]);\n}\nvar response = getResponse();\nvar advisorState = {\n  Intent: trimString($context.$variables.Intent || ''),\n  IntentReason: trimString($context.$variables.IntentReason || ''),\n  ProjectName: trimString($context.$variables.ProjectName || ''),\n  TaskNumber: trimString($context.$variables.TaskNumber || ''),\n  ResourceName: trimString($context.$variables.ResourceName || ''),\n  ReplacementResourceName: trimString($context.$variables.ReplacementResourceName || ''),\n  UnavailabilityDate: trimString($context.$variables.UnavailabilityDate || ''),\n  INTENT_START: trimString($context.$variables.INTENT_START || 'N'),\n  INTENT_END: trimString($context.$variables.INTENT_END || 'Y'),\n  PendingAction: trimString($context.$variables.PendingAction || ''),\n  PendingReplacementItemsJson: String($context.$variables.PendingReplacementItemsJson || '[]'),\n  PendingProjectName: trimString($context.$variables.PendingProjectName || ''),\n  PendingOldResourceName: trimString($context.$variables.PendingOldResourceName || ''),\n  PendingNewResourceName: trimString($context.$variables.PendingNewResourceName || ''),\n  PendingUnavailabilityDate: trimString($context.$variables.PendingUnavailabilityDate || ''),\n  PendingPlanVersionId: trimString($context.$variables.PendingPlanVersionId || ''),\n  ReplacementAssistantStateJson: String($context.$variables.ReplacementAssistantStateJson || '')\n};\nvar returnValue = response;\nif (String($context.$variables.ReturnEnvelopeFlag || 'N') === 'Y') {\n  returnValue = JSON.stringify({ response: response, stateJson: JSON.stringify(advisorState) });\n}\nreturn { response: response, returnValue: returnValue };"
