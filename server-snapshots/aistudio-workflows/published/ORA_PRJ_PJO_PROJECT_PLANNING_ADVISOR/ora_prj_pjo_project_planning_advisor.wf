            "name": "Format Replacement Assistant Response",
            "returnType": "object",
            "sourceCode": "function trimString(value) {\n  return String(value == null ? '' : value).trim();\n}\n\nfunction formatCurrencyDisplay(value) {\n  var text = trimString(value);\n  var sign = '';\n  var numericText;\n  if (!text || /^n\\/?a$/i.test(text) || text === '-') {\n    return 'N/A';\n  }\n  if (text.indexOf('$') > -1 || text.indexOf('%') > -1) {\n    return text;\n  }\n  if (text.charAt(0) === '+' || text.charAt(0) === '-') {\n    sign = text.charAt(0);\n    text = trimString(text.slice(1));\n  }\n  if (text.charAt(0) === '(' && text.charAt(text.length - 1) === ')') {\n    sign = '-';\n    text = trimString(text.slice(1, text.length - 1));\n  }\n  numericText = text.replace(/,/g, '');\n  if (!/^\\d+(?:\\.\\d+)?$/.test(numericText)) {\n    return sign + text;\n  }\n  return sign + '$' + text;\n}\n\nfunction parseJsonObject(raw, fallback) {\n  if (raw && typeof raw === 'object') {\n    return raw;\n  }\n  if (typeof raw === 'string' && trimString(raw) !== '') {\n    try { return JSON.parse(raw); } catch (ignore1) {}\n  }\n  return fallback;\n}\n\nfunction parseJsonArray(raw) {\n  if (Array.isArray(raw)) {\n    return raw;\n  }\n  if (typeof raw === 'string' && trimString(raw) !== '') {\n    try {\n      var parsed = JSON.parse(raw);\n      return Array.isArray(parsed) ? parsed : [];\n    } catch (ignore1) {}\n  }\n  return [];\n}\n\nfunction extractPlanVersionIdFromItems(raw) {\n  var items = parseJsonArray(raw);\n  var i;\n  var item;\n  var payload;\n  var value;\n  for (i = 0; i < items.length; i++) {\n    item = items[i] || {};\n    value = trimString(item.PlanVersionId || item.planVersionId || item.FPPplanVersionId || item.fppPlanVersionId || '');\n    if (value) {\n      return value;\n    }\n    payload = parseJsonObject(item.Payload || item.payload, {});\n    value = trimString(payload.PlanVersionId || payload.planVersionId || payload.FPPplanVersionId || payload.fppPlanVersionId || '');\n    if (value) {\n      return value;\n    }\n  }\n  return '';\n}\n\nfunction outputPayloadFromNodeEntry(nodeEntry) {\n  var parsed;\n  if (!nodeEntry || nodeEntry.output === null || nodeEntry.output === undefined) {\n    return null;\n  }\n  parsed = parseJsonObject(nodeEntry.output, null);\n  if (parsed && parsed.result && parsed.result.response !== undefined) {\n    return parsed.result;\n  }\n  if (parsed && parsed.response !== undefined) {\n    return parsed;\n  }\n  return null;\n}\n\nfunction recoverChildResponseFromNodes(rawOutput) {\n  var nodes = rawOutput && Array.isArray(rawOutput.nodes) ? rawOutput.nodes : [];\n  var preferredCodes = {\n    PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_RETURN_CROSS_PROJECT_COMMIT_RESPONSE_V1: true,\n    PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FORMAT_CROSS_PROJECT_COMMIT_RESPONSE_V1: true,\n    PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_RETURN_CROSS_PROJECT_BUDGET_PENDING_V1: true,\n    PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_RETURN_ACROSS_PROJECTS: true,\n    PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_FORMAT_ACROSS_PROJECTS: true,\n    PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_RETURN_RESPONSE: true,\n    PROJECT_RESOURCE_REPLACEMENT_ASSISTANT_RETURN_REPLACEMENT_RESPONSE: true\n  };\n  var i;\n  var payload;\n  for (i = nodes.length - 1; i >= 0; i--) {\n    if (preferredCodes[String(nodes[i].code || '')]) {\n      payload = outputPayloadFromNodeEntry(nodes[i]);\n      if (payload && trimString(payload.response || '') && trimString(payload.response || '') !== 'Done') {\n        return payload;\n      }\n    }\n  }\n  for (i = nodes.length - 1; i >= 0; i--) {\n    payload = outputPayloadFromNodeEntry(nodes[i]);\n    if (payload && trimString(payload.response || '') && trimString(payload.response || '') !== 'Done') {\n      return payload;\n    }\n  }\n  return null;\n}\n\nfunction normalizeNameKey(value) {\n  return trimString(value).toLowerCase().replace(/[^a-z0-9]+/g, '');\n}\n\nfunction tokenizeName(value) {\n  var cleaned = trimString(value)\n    .replace(/\\b(?:mr|mrs|ms|miss|dr)\\.?/ig, ' ')\n    .replace(/[^A-Za-z0-9]+/g, ' ')\n    .toLowerCase();\n  var rawTokens = cleaned.split(/\\s+/);\n  var seen = {};\n  var tokens = [];\n  var i;\n  var token;\n  for (i = 0; i < rawTokens.length; i++) {\n    token = trimString(rawTokens[i]);\n    if (token.length < 2 || seen[token]) {\n      continue;\n    }\n    seen[token] = true;\n    tokens.push(token);\n  }\n  return tokens;\n}\n\nfunction buildFallbackTaskOptions(items, requestedResourceName) {\n  var tokens = tokenizeName(requestedResourceName);\n  var exactKey = normalizeNameKey(requestedResourceName);\n  var groups = {};\n  var order = [];\n  var chosen;\n  var i;\n  var item;\n  var resourceName;\n  var group;\n  var nameKey;\n  var token;\n  var j;\n  var seenTaskIds = {};\n  var options = [];\n  var plan = ($context.$nodes.PROJECT_PLAN_ADVISOR_SELECT_PLAN.$output || {}).result || {};\n  for (i = 0; i < items.length; i++) {\n    item = items[i] || {};\n    resourceName = trimString(item.ResourceName || '');\n    nameKey = normalizeNameKey(resourceName);\n    if (!resourceName || !nameKey || !trimString(item.TaskId || '')) {\n      continue;\n    }\n    if (!groups[nameKey]) {\n      groups[nameKey] = {\n        resourceName: resourceName,\n        score: 0,\n        matchedTokenCount: 0,\n        items: []\n      };\n      order.push(groups[nameKey]);\n    }\n    groups[nameKey].items.push(item);\n  }\n  for (i = 0; i < order.length; i++) {\n    group = order[i];\n    nameKey = normalizeNameKey(group.resourceName);\n    if (exactKey && nameKey === exactKey) {\n      group.score += 100;\n    }\n    for (j = 0; j < tokens.length; j++) {\n      token = tokens[j];\n      if (nameKey.indexOf(token) > -1) {\n        group.score += 10;\n        group.matchedTokenCount += 1;\n        if (nameKey.indexOf(token) === 0) {\n          group.score += 2;\n        }\n      }\n    }\n  }\n  order = order.filter(function (candidate) {\n    return candidate.score > 0 || (!tokens.length && trimString(candidate.resourceName) !== '');\n  });\n  order.sort(function (left, right) {\n    if (right.score !== left.score) {\n      return right.score - left.score;\n    }\n    if (right.matchedTokenCount !== left.matchedTokenCount) {\n      return right.matchedTokenCount - left.matchedTokenCount;\n    }\n    return trimString(left.resourceName).length - trimString(right.resourceName).length;\n  });\n  chosen = order.length ? order[0] : null;\n  if (!chosen) {\n    return { resourceName: '', options: [] };\n  }\n  for (i = 0; i < chosen.items.length; i++) {\n    item = chosen.items[i] || {};\n    if (seenTaskIds[String(item.TaskId || '')]) {\n      continue;\n    }\n    seenTaskIds[String(item.TaskId || '')] = true;\n    options.push({\n      optionIndex: options.length + 1,\n      taskId: trimString(item.TaskId || ''),\n      taskNumber: trimString(item.TaskNumber || ''),\n      taskName: trimString(item.TaskName || ''),\n      planningElementId: trimString(item.PlanningElementId || ''),\n      rbsElementId: trimString(item.RbsElementId || ''),\n      oldResourceElementId: trimString(item.RbsElementId || ''),\n      resourceName: trimString(chosen.resourceName || ''),\n      projectId: trimString(plan.projectId || ''),\n      planVersionId: trimString(plan.planVersionId || ''),\n      planClassCode: '0'\n    });\n  }\n  return {\n    resourceName: trimString(chosen.resourceName || ''),\n    options: options\n  };\n}\n\nvar raw = (($context.$nodes || {}).PROJECT_PLAN_ADVISOR_CALL_RESOURCE_REPLACEMENT_CORE_V3 || {}).$output || {};\nvar out = raw.output;\nvar responsePayload = {};\nvar previousState = parseJsonObject($context.$variables.ReplacementAssistantStateJson, {});\nvar fallbackInfo = (($context.$nodes.PROJECT_PLAN_ADVISOR_BUILD_REPLACEMENT_FALLBACK_ASSIGNMENTS_FILTER_V1 || {}).$output || {}).result || {};\nvar fallbackAssignments = ((($context.$nodes.PROJECT_PLAN_ADVISOR_FETCH_REPLACEMENT_FALLBACK_ASSIGNMENTS_V1 || {}).$output || {}).items);\nvar fallbackResolvedResourceName = '';\nvar fallbackRequestedResourceName = trimString($context.$variables.ResourceName || previousState.ResourceName || '');\nvar message = trimString($context.$variables.EffectiveInputMessage || '');\nvar lower = message.toLowerCase();\nvar nl = String.fromCharCode(10);\nvar returnValue;\nvar childIntent;\nvar state;\nvar advisorState;\nvar taskOptions;\nvar roleOptions;\nvar recommendationOptions;\nvar currentResourceName;\nvar currentRoleName;\nvar currentRoleOptions;\nvar currentReplacementResourceName;\nvar currentUnavailabilityDate;\nvar pendingPlanVersionId;\nvar messageLooksLikeDate;\nvar resourcePlaceholderSignal;\nvar replacementPlaceholderSignal;\nvar bulkRoleSignal;\nvar roleIntentSignal;\nvar i;\n\nif (out && typeof out === 'object') {\n  responsePayload = out;\n} else if (typeof out === 'string' && trimString(out) !== '') {\n  responsePayload = parseJsonObject(out, { response: String(out) });\n} else if (raw && typeof raw === 'object' && raw.response !== undefined) {\n  responsePayload = raw;\n} else {\n  responsePayload = { response: String(raw.error || '') };\n}\nif (trimString(responsePayload.response || '') === '' || trimString(responsePayload.response || '') === 'Done') {\n  var recoveredChildPayload = recoverChildResponseFromNodes(raw);\n  if (recoveredChildPayload) {\n    responsePayload = recoveredChildPayload;\n  }\n}\nvar responseText = trimString(responsePayload.response || '');\nif (/^Provide project name and unavailability date\\./i.test(responseText) && responseText.indexOf('resource name') === -1) {\n  responsePayload.response = responseText.replace(/^Provide project name and unavailability date\\./i, 'Provide project name, resource name, and unavailability date.');\n}\n\nif (fallbackInfo.shouldRecover === true && Array.isArray(fallbackAssignments)) {\n  var fallbackText = trimString(responsePayload.response || '');\n  var fallbackResult;\n  if (fallbackText === '' || fallbackText === 'Done' || fallbackText.indexOf('I could not find any roles or jobs with task assignments in ') === 0 || fallbackText.indexOf('I could not find tasks for ') === 0) {\n    fallbackResult = buildFallbackTaskOptions(fallbackAssignments, fallbackRequestedResourceName);\n    fallbackResolvedResourceName = trimString(fallbackResult.resourceName || '');\n    if (fallbackResult.options && fallbackResult.options.length) {\n      responsePayload = {\n        response: '',\n        intentStart: 'Y',\n        intentEnd: 'N',\n        nextStage: 'TASK_SELECTION',\n        roleOptionsJson: '[]',\n        taskOptionsJson: JSON.stringify(fallbackResult.options),\n        taskCount: fallbackResult.options.length,\n        roleCount: 0\n      };\n    } else if (fallbackText === '' || fallbackText === 'Done') {\n      responsePayload = {\n        response: 'I could not find tasks for ' + (fallbackRequestedResourceName || 'the requested resource') + ' in ' + (trimString($context.$variables.ProjectName || responsePayload.pendingProjectName || previousState.ProjectName || '') || 'the selected project') + '.',\n        intentStart: 'N',\n        intentEnd: 'Y',\n        nextStage: '',\n        pendingAction: '',\n        pendingItemsJson: '[]',\n        roleOptionsJson: '[]',\n        taskOptionsJson: '[]',\n        taskCount: 0,\n        roleCount: 0\n      };\n    }\n  }\n}\n\ntaskOptions = parseJsonArray(responsePayload.taskOptionsJson);\nif (taskOptions.length) {\n  var existingTaskResponse = trimString(responsePayload.response || '');\n  var hasDetailedTaskFields = false;\n  var firstTask = taskOptions[0] || {};\n  var taskHeaderDate = trimString(responsePayload.terminationDate || responsePayload.pendingUnavailabilityDate || previousState.UnavailabilityDate || $context.$variables.UnavailabilityDate || '');\n  var projectDisplay = trimString(firstTask.projectName || responsePayload.pendingProjectName || previousState.ProjectName || $context.$variables.ProjectName || 'the selected project');\n  var resourceDisplay = trimString($context.$variables.ResourceName || responsePayload.pendingOldResourceName || previousState.ResourceName || fallbackRequestedResourceName || 'The resource');\n  var formattedDate = advisorFormatLongDate(taskHeaderDate);\n  var taskLines = [];\n  for (i = 0; i < taskOptions.length; i++) {\n    if (taskOptions[i] && (taskOptions[i].plannedEffortHours !== undefined || taskOptions[i].remainingEffortHours !== undefined || taskOptions[i].planningStartDate !== undefined || taskOptions[i].planningFinishDate !== undefined)) {\n      hasDetailedTaskFields = true;\n    }\n  }\n  if (existingTaskResponse.indexOf('Impacted Assignments') > -1 || existingTaskResponse.indexOf('Please enter the effective start date for this replacement.') === 0) {\n    responsePayload.response = existingTaskResponse;\n  } else if (hasDetailedTaskFields) {\n    var assignmentNoun = taskOptions.length === 1 ? 'assignment' : 'assignments';\n    responsePayload.response =\n      resourceDisplay + ' currently has ' + String(taskOptions.length) + ' ' + assignmentNoun + ' in ' + projectDisplay +\n      (taskHeaderDate ? ' that are impacted by this replacement effective ' + formattedDate + '.' : ' that are impacted by this replacement.') +\n      ' These assignments were identified based on the effective date and include active assignments that continue on or after that date. Assignments that have already ended or belong to closed projects are not included. For assignments already in progress, the remaining effort will be reassigned from the effective date onward, and any existing effort adjustments will be preserved.' +\n      nl + nl + 'Impacted Assignments' + nl + nl +\n      '| S No. | Project | Summary Task | Planned Effort (Hours) | Remaining Effort (Hours) | Assignment Start Date | Assignment Finish Date |' + nl +\n      '| --- | --- | --- | --- | --- | --- | --- |';\n    for (i = 0; i < taskOptions.length; i++) {\n      responsePayload.response += nl +\n        '| ' + advisorTableCell(taskOptions[i].optionIndex || i + 1) +\n        ' | ' + advisorTableCell(taskOptions[i].projectName || projectDisplay) +\n        ' | ' + advisorTableCell(taskOptions[i].taskName || taskOptions[i].taskNumber || ('Task ' + String(i + 1))) +\n        ' | ' + advisorFormatEffort(taskOptions[i].plannedEffortHours) +\n        ' | ' + advisorFormatEffort(taskOptions[i].remainingEffortHours) +\n        ' | ' + advisorFormatShortDate(taskOptions[i].planningStartDate) +\n        ' | ' + advisorFormatShortDate(taskOptions[i].planningFinishDate) + ' |';\n    }\n    responsePayload.response += nl + nl + 'Would you like to proceed with the replacement across all impacted assignments in ' + projectDisplay + ', or only specific task assignments? Reply yes/all for all, or reply with S. No., first/second, a range like 1-4, task number, or task name for specific assignments.';\n  } else {\n    for (i = 0; i < taskOptions.length; i++) {\n      taskLines.push('| ' + String(taskOptions[i].optionIndex || i + 1) + ' | ' + String(taskOptions[i].taskNumber || '') + ' | ' + String(taskOptions[i].taskName || '') + ' |');\n    }\n    responsePayload.response =\n      (taskHeaderDate\n        ? 'Select the impacted task option number(s), task name(s), or all for termination date ' + taskHeaderDate + '.'\n        : 'Select task option number(s), task name(s), or all.') +\n      nl + nl +\n      '| S No. | Task No. | Task Name |' + nl +\n      '| --- | --- | --- |' + nl +\n      taskLines.join(nl) + nl + nl +\n      'Reply with option number(s), task number(s), task name(s), or all.';\n  }\n}\n\nfunction advisorTableCell(value) {\n  value = trimString(value);\n  return value ? value.replace(/\\|/g, '/') : 'N/A';\n}\n\nfunction advisorFormatEffort(value) {\n  var num;\n  value = trimString(value);\n  if (!value) {\n    return 'N/A';\n  }\n  num = Number(value);\n  if (isNaN(num)) {\n    return advisorTableCell(value);\n  }\n  return Math.abs(num - Math.round(num)) < 0.005 ? String(Math.round(num)) : String(Math.round(num * 100) / 100);\n}\n\nfunction advisorToIsoDate(rawValue) {\n  var raw = trimString(rawValue);\n  var match;\n  var parsedDate;\n  if (!raw) {\n    return '';\n  }\n  match = raw.match(/^(\\d{4})[-\\/](\\d{1,2})[-\\/](\\d{1,2})/);\n  if (match) {\n    return match[1] + '-' + ('0' + match[2]).slice(-2) + '-' + ('0' + match[3]).slice(-2);\n  }\n  match = raw.match(/^(\\d{1,2})[\\/](\\d{1,2})[\\/](\\d{4})$/);\n  if (match) {\n    return match[3] + '-' + ('0' + match[1]).slice(-2) + '-' + ('0' + match[2]).slice(-2);\n  }\n  parsedDate = new Date(raw);\n  if (!isNaN(parsedDate.getTime())) {\n    return parsedDate.getUTCFullYear() + '-' + ('0' + (parsedDate.getUTCMonth() + 1)).slice(-2) + '-' + ('0' + parsedDate.getUTCDate()).slice(-2);\n  }\n  return '';\n}\n\nfunction advisorFormatShortDate(rawValue) {\n  var iso = advisorToIsoDate(rawValue);\n  var parts = iso.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);\n  if (!parts) {\n    return advisorTableCell(rawValue);\n  }\n  return parts[2] + '/' + parts[3] + '/' + parts[1];\n}\n\nfunction advisorFormatLongDate(rawValue) {\n  var iso = advisorToIsoDate(rawValue);\n  var parts = iso.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);\n  var names = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];\n  if (!parts) {\n    return trimString(rawValue);\n  }\n  return names[Number(parts[2]) - 1] + ' ' + String(Number(parts[3])) + ', ' + parts[1];\n}\n\nroleOptions = parseJsonArray(responsePayload.roleOptionsJson);\nif (roleOptions.length) {\n  var hasRoleTaskContext = false;\n  var roleLines = [];\n  for (i = 0; i < roleOptions.length; i++) {\n    if (trimString(roleOptions[i].taskSummary || '') || String(roleOptions[i].taskCount || '') !== '') {\n      hasRoleTaskContext = true;\n    }\n  }\n  for (i = 0; i < roleOptions.length; i++) {\n    if (hasRoleTaskContext) {\n      roleLines.push('| ' + String(roleOptions[i].optionIndex || i + 1) + ' | ' + String(roleOptions[i].displayName || roleOptions[i].roleName || '') + ' | ' + String(roleOptions[i].taskSummary || (String(roleOptions[i].taskCount || '') ? String(roleOptions[i].taskCount) + ' task(s)' : '')) + ' |');\n    } else {\n      roleLines.push('| ' + String(roleOptions[i].optionIndex || i + 1) + ' | ' + String(roleOptions[i].displayName || roleOptions[i].roleName || '') + ' |');\n    }\n  }\n  responsePayload.response =\n    'Select the role or job you want to replace.' + nl + nl +\n    (hasRoleTaskContext\n      ? '| S No. | Role / Job | Task Context |' + nl + '| --- | --- | --- |' + nl\n      : '| S No. | Role / Job |' + nl + '| --- | --- |' + nl) +\n    roleLines.join(nl) + nl + nl +\n    'Reply with the role name or option number.';\n}\n\nrecommendationOptions = parseJsonArray(responsePayload.recommendationOptionsJson);\nif (recommendationOptions.length && !(recommendationOptions[0] && recommendationOptions[0].roleName !== undefined)) {\n  var bestOption = null;\n  var recommendationLines = [];\n  var recommendationNote = 'Cost impact uses burdened cost in project currency. Margin is shown only when revenue is available.';\n  var intakeSummary = trimString(responsePayload.resourceIntakeSummary || '');\n  var addResourceNote = '**Type: add <name> <email> <name> <email>** to add one or more resources to the project planning RBS and refresh recommendations. You can also paste or upload a CSV with Resource and Email columns.';\n  for (i = 0; i < recommendationOptions.length; i++) {\n    if (!bestOption && (recommendationOptions[i].isBest === true || String(responsePayload.bestRecommendationOptionIndex || '') === String(recommendationOptions[i].optionIndex || ''))) {\n      bestOption = recommendationOptions[i];\n    }\n  }\n  if (!bestOption) {\n    bestOption = recommendationOptions[0];\n  }\n  for (i = 0; i < recommendationOptions.length; i++) {\n    var option = recommendationOptions[i] || {};\n    var coverageDisplay = trimString(option.coverageDisplay || '');\n    if (!coverageDisplay) {\n      coverageDisplay = String(option.matchCount || '') + ' task' + (String(option.matchCount || '') === '1' ? '' : 's');\n    }\n    recommendationLines.push(\n      '| ' + String(option.optionIndex || i + 1) + ' | ' +\n      String(option.resourceName || '') + ' | ' +\n      coverageDisplay + ' | ' +\n      (option.isBest === true || String(bestOption.optionIndex || '') === String(option.optionIndex || '') ? 'Yes' : '') + ' | ' +\n      formatCurrencyDisplay(option.taskCostImpactDisplay) + ' | ' +\n      formatCurrencyDisplay(option.taskMarginImpactDisplay) + ' | ' +\n      formatCurrencyDisplay(option.projectCostImpactDisplay) + ' | ' +\n      formatCurrencyDisplay(option.projectMarginImpactDisplay) + ' |'\n    );\n  }\n  responsePayload.response =\n    (intakeSummary ? intakeSummary + nl + nl : '') +\n    'Select the replacement resource.' + nl + nl +\n    '| S No. | Resource | Coverage | Best | Task Cost Impact | Task Margin Impact | Project Cost Impact | Project Margin Impact |' + nl +\n    '| --- | --- | --- | --- | --- | --- | --- | --- |' + nl +\n    recommendationLines.join(nl) + nl + nl +\n    'Best recommendation: ' + String(bestOption.resourceName || responsePayload.bestRecommendationResourceName || '') + '. Reply go ahead to use it, or reply with another option number or resource name.' + nl +\n    recommendationNote + nl +\n    addResourceNote;\n}\n\nif ((!responsePayload.response || trimString(responsePayload.response) === '') && responsePayload.pendingAction === 'COMMIT_REPLACEMENT') {\n  responsePayload.response = 'Replacement proposal is ready. Reply approve to commit.';\n}\n\nresourcePlaceholderSignal = /^role\\.?$/i.test(trimString($context.$variables.ResourceName || previousState.ResourceName || ''));\nreplacementPlaceholderSignal = /^named person\\.?$/i.test(trimString($context.$variables.ReplacementResourceName || previousState.ReplacementResourceName || ''));\nbulkRoleSignal = trimString(previousState.Intent || '') === 'REPLACE_ALL_ROLES_WI