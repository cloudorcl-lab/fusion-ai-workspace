responsePayload = out;\n} else if (typeof out === 'string' && trimString(out) !== '') {\n  responsePayload = parseJsonObject(out, { response: String(out) });\n} else if (raw && typeof raw === 'object' && raw.response !== undefined) {\n  responsePayload = raw;\n} else {\n  responsePayload = { response: String(raw.error || '') };\n}\nresponseText = trimString(responsePayload.response || '');\nshouldRecover =\n  bypassInfo.shouldBypass === true ||\n  (\n    intent !== 'REPLACE_ROLE_WITH_NAMED_PERSON' &&\n    projectName !== '' &&\n    resourceName !== '' &&\n    (responseText === '' ||\n     responseText === 'Done' ||\n     responseText.indexOf('I could not find any roles or jobs with task assignments in ') === 0 ||\n     responseText.indexOf('I could not find tasks for ') === 0)\n  );\nreturn {\n  shouldRecover: shouldRecover,\n  filterCriteria: shouldRecover ? '?expand=PlanningAmounts&limit=500&onlyData=true' : '?limit=1&onlyData=true'\n};"
