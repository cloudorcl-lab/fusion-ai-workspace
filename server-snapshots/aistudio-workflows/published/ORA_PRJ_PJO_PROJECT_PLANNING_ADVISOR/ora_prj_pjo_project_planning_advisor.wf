            "sourceCode": "var req = (($context.$nodes.PROJECT_PLAN_ADVISOR_RESOLVE_REFRESH_INPUTS_V2 || {}).$output || {}).result || {}; var period = String(req.refreshRatesPeriodForward || '').trim(); var monthMap = { january: 'Jan', february: 'Feb', march: 'Mar', april: 'Apr', may: 'May', june: 'Jun', july: 'Jul', august: 'Aug', september: 'Sep', october: 'Oct', november: 'Nov', december: 'Dec' }; var match = period.match(/^([A-Za-z]{3})-(\\d{4})$/); if (match) { period = match[1].charAt(0).toUpperCase() + match[1].substring(1).toLowerCase() + '-' + String(match[2] || '').slice(2); } else { match = period.match(/^(January|February|March|April|May|June|July|August|September|October|November|December)\\s+(\\d{4})$/i); if (match) { period = (monthMap[String(match[1] || '').toLowerCase()] || String(match[1] || '').substring(0, 3)) + '-' + String(match[2] || '').slice(2); } } return { Payload: JSON.stringify({ refreshOnlyConversionRates: req.refreshOnlyConversionRates, refreshRatesPeriodForward: period, retainRateOverride: req.retainRateOverride }) };"
