            "returnType": "object",
            "sourceCode": "function parseJsonSafe(value, fallback) {\n  if (typeof value === 'string') {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return fallback;\n    }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\n\nfunction asObject(value) {\n  var parsed = parseJsonSafe(value, null);\n  return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};\n}\n\nfunction hasOwn(objectValue, fieldName) {\n  return objectValue && typeof objectValue === 'object' && Object.prototype.hasOwnProperty.call(objectValue, fieldName);\n}\n\nfunction restInput() {\n  try {\n    if ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input && typeof $context.$triggers.REST.$input === 'object') {\n      return $context.$triggers.REST.$input;\n    }\n  } catch (e) {}\n  return {};\n}\n\nfunction workflowVar(fieldName) {\n  try {\n    if ($context.$variables && Object.prototype.hasOwnProperty.call($context.$variables, fieldName)) {\n      var value = $context.$variables[fieldName];\n      return value === undefined ? null : value;\n    }\n  } catch (e) {}\n  return null;\n}\n\nfunction firstNonEmpty(values) {\n  for (var i = 0; i < values.length; i++) {\n    var value = values[i];\n    if (value !== null && value !== undefined && String(value).trim() !== '') {\n      return String(value).trim();\n    }\n  }\n  return '';\n}\n\nfunction normalizeString(value) {\n  return String(value === null || value === undefined ? '' : value);\n}\n\nfunction stateValue(state, fieldName, fallback) {\n  if (hasOwn(state, fieldName)) {\n    return state[fieldName];\n  }\n  return fallback;\n}\n\nvar input = restInput();\nvar raw = normalizeString($context.$system.$inputMessage || '');\nvar candidate = String(raw || '').trim();\nvar msg = raw;\nvar parsed = null;\nvar envelope = null;\nvar state = {};\nvar hasState = false;\nvar returnEnvelopeFlag = 'N';\nvar replacementState = '';\nvar routingContext = firstNonEmpty([\n  hasOwn(input, 'prjPjfRoutingContext') ? input.prjPjfRoutingContext : null,\n  workflowVar('prjPjfRoutingContext')\n]);\n\nvar activeAtomicDetails = asObject(hasOwn(input, 'prjPjfActiveAtomicAgentDetails') ? input.prjPjfActiveAtomicAgentDetails : workflowVar('prjPjfActiveAtomicAgentDetails'));\nif (activeAtomicDetails.atomicAgentCode === 'PRJ_PJO_PROJECT_PLANNING_ADVISOR') {\n  var contextDetails = asObject(activeAtomicDetails.contextDetails);\n  var nestedState = asObject(contextDetails.stateJson);\n  state = Object.keys(nestedState).length ? nestedState : contextDetails;\n  hasState = Object.keys(state).length > 0;\n}\n\nif (candidate !== '') {\n  try {\n    parsed = JSON.parse(candidate);\n    if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {\n      envelope = parsed;\n    } else if (typeof parsed === 'string') {\n      msg = parsed;\n      parsed = String(parsed || '').trim();\n      if (parsed && parsed.charAt(0) === '{') {\n        try {\n          envelope = JSON.parse(parsed);\n        } catch (e3) {}\n      }\n    }\n  } catch (e) {}\n}\n\nif (envelope && envelope.__codexStateEnvelope === true && typeof envelope.message === 'string') {\n  msg = String(envelope.message || '');\n  returnEnvelopeFlag = 'Y';\n  if (envelope.stateJson && typeof envelope.stateJson === 'object') {\n    state = envelope.stateJson;\n    hasState = true;\n  } else if (typeof envelope.stateJson === 'string' && String(envelope.stateJson).trim() !== '') {\n    var parsedState = parseJsonSafe(envelope.stateJson || '{}', {});\n    state = asObject(parsedState);\n    hasState = Object.keys(state).length > 0;\n  }\n}\n\nif (routingContext.toLowerCase() === 'redwoodui') {\n  returnEnvelopeFlag = 'Y';\n}\n\nvar projectName = String((state && state.ProjectName) || '').trim();\nif (projectName && msg.toLowerCase().indexOf(projectName.toLowerCase()) === -1 && /\\bchange\\s+orders?\\b/i.test(msg)) {\n  if (/for the project/i.test(msg)) {\n    msg = msg.replace(/for the project/ig, 'for project ' + projectName);\n  } else if (!/\\bproject\\s+[A-Za-z0-9_-]+/i.test(msg)) {\n    msg = msg + ' for project ' + projectName;\n  }\n}\n\nif (state.ReplacementAssistantStateJson && typeof state.ReplacementAssistantStateJson === 'object') {\n  replacementState = JSON.stringify(state.ReplacementAssistantStateJson);\n} else {\n  replacementState = String(state.ReplacementAssistantStateJson || '');\n}\n\nreturn {\n  message: msg,\n  returnEnvelopeFlag: returnEnvelopeFlag,\n  hasState: hasState,\n  Intent: String(stateValue(state, 'Intent', '')),\n  IntentReason: String(stateValue(state, 'IntentReason', '')),\n  ProjectName: String(stateValue(state, 'ProjectName', '')),\n  TaskNumber: String(stateValue(state, 'TaskNumber', '')),\n  ResourceName: String(stateValue(state, 'ResourceName', '')),\n  ReplacementResourceName: String(stateValue(state, 'ReplacementResourceName', '')),\n  UnavailabilityDate: String(stateValue(state, 'UnavailabilityDate', '')),\n  CreateBudgetOnBaselineFlag: String(stateValue(state, 'CreateBudgetOnBaselineFlag', '')),\n  BudgetFinancialPlanType: String(stateValue(state, 'BudgetFinancialPlanType', '')),\n  AutoBaselineFlag: String(stateValue(state, 'AutoBaselineFlag', '')),\n  AdjustmentType: String(stateValue(state, 'AdjustmentType', '')),\n  AdjustmentPercentage: stateValue(state, 'AdjustmentPercentage', ''),\n  FromPeriod: String(stateValue(state, 'FromPeriod', '')),\n  ToPeriod: String(stateValue(state, 'ToPeriod', '')),\n  RefreshOnlyConversionRates: String(stateValue(state, 'RefreshOnlyConversionRates', '')),\n  RefreshRatesPeriodForward: String(stateValue(state, 'RefreshRatesPeriodForward', '')),\n  RetainRateOverride: String(stateValue(state, 'RetainRateOverride', '')),\n  INTENT_START: String(stateValue(state, 'INTENT_START', '')),\n  INTENT_END: String(stateValue(state, 'INTENT_END', '')),\n  PendingAction: String(stateValue(state, 'PendingAction', '')),\n  PendingReplacementItemsJson: String(stateValue(state, 'PendingReplacementItemsJson', '')),\n  PendingProjectName: String(stateValue(state, 'PendingProjectName', '')),\n  PendingOldResourceName: String(stateValue(state, 'PendingOldResourceName', '')),\n  PendingNewResourceName: String(stateValue(state, 'PendingNewResourceName', '')),\n  PendingNewResourceElementId: stateValue(state, 'PendingNewResourceElementId', null),\n  PendingPlanVersionId: String(stateValue(state, 'PendingPlanVersionId', '')),\n  PendingAssignmentSkeletons: String(stateValue(state, 'PendingAssignmentSkeletons', '')),\n  PendingCandidateListJson: String(stateValue(state, 'PendingCandidateListJson', '')),\n  PendingUnavailabilityDate: String(stateValue(state, 'PendingUnavailabilityDate', '')),\n  ReplacementAssistantStateJson: replacementState\n};"
