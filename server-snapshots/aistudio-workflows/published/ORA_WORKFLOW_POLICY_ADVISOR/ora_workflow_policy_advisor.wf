              "name": "prompt",
              "type": "string",
              "value": "You are extract a raw string (not valid JSON) from {{$context.$system.$inputContext}}  .\n\nTask:\n1. Treat the input as plain text\n2. Extract the value inside additional_context=\"...\"\n3. Unescape the string (remove backslashes)\n4. Convert it into a valid JSON object\n5. Return ONLY the final JSON object"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"ChangeType\": {\n            \"type\": \"string\"\n        },\n        \"OrganizationCode\": {\n            \"type\": \"string\"\n        },\n        \"ChangeName\": {\n            \"type\": \"string\"\n        },\n        \"ChangeNumber\": {\n            \"type\": \"string\"\n        },\n        \"ChangeId\": {\n            \"type\": \"number\"\n        }\n    }\n}",
          "type": "LLM",
          "diagram": {
            "x": 5485,
            "y": 5690
          }
