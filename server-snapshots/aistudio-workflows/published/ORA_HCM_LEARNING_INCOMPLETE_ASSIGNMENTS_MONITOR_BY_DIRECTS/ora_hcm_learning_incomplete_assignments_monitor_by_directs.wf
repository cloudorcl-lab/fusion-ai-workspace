          "code": "GET_INCOMPLETE_ASSIGNMENTS",
          "id": "1767828302985",
          "inputs": [
            {
              "id": "1772043282624_1",
              "name": "payload",
              "type": "string",
              "value": "{{$context.$nodes.BUILD_INCOMPLETE_ASSIGNMENTS_PAYLOAD.$output.result}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Prepare Incomplete Assignments Display",
            "returnType": "object",
            "sourceCode": "const raw = $context.$nodes.GET_INCOMPLETE_ASSIGNMENTS.$output;\nconst learningItemTitle = $context.$variables.learningItemTitle || '';\nconst nowIso = $context.$system.$currentDateTime || new Date().toISOString();\nconst asOfDate = new Date(nowIso).toISOString().slice(0, 10);\n\nconst clean = (value) => {\n  if (value == null) return '';\n  return String(value).trim();\n};\n\nconst toStatusKey = (badgeText) => {\n  const value = clean(badgeText);\n  if (value === 'Overdue') return 'overdue';\n  if (value === 'Due within 30 days') return 'dueSoon';\n  return '';\n};\n\nconst toStatusText = (statusKey) => {\n  if (statusKey === 'overdue') return 'Overdue';\n  if (statusKey === 'dueSoon') return 'Due within 30 days';\n  return '';\n};\n\nconst records = Array.isArray(raw.items) ? raw.items : [];\nconst preparedRows = [];\n\nfor (const record of records) {\n  const statusKey = toStatusKey(record.badgeText);\n  if (!statusKey) continue;\n\n  const learnerName = clean(record.assignedToDisplayName);\n  const dueDate = clean(record.assignmentDueDate);\n  if (!learnerName || !dueDate) continue;\n\n  preparedRows.push({\n    learnerName,\n    dueDate,\n    statusKey,\n    statusText: toStatusText(statusKey),\n    sortPrimary: statusKey === 'overdue' ? 0 : 1,\n    sortDueDate: dueDate,\n    sortName: learnerName.toLowerCase()\n  });\n}\n\npreparedRows.sort((left, right) => {\n  if (left.sortPrimary !== right.sortPrimary) return left.sortPrimary - right.sortPrimary;\n  if (left.sortDueDate !== right.sortDueDate) return left.sortDueDate.localeCompare(right.sortDueDate);\n  return left.sortName.localeCompare(right.sortName);\n});\n\nconst rows = preparedRows.map(({ learnerName, dueDate, statusKey, statusText }) => ({\n  learnerName,\n  dueDate,\n  statusKey,\n  statusText\n}));\n\nconst overdueCount = rows.filter((row) => row.statusKey === 'overdue').length;\nconst dueSoonCount = rows.filter((row) => row.statusKey === 'dueSoon').length;\n\nconst result = {\n  learningItemTitle,\n  asOfDate,\n  totalFiltered: rows.length,\n  overdueCount,\n  dueSoonCount,\n  rows\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1766441452432"
          },
          "code": "PREPARE_INCOMPLETE_ASSIGNMENTS_DISPLAY",
          "id": "1772050000000",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
