          "metadata": {
            "name": "Prepare return payload budget",
            "returnType": "object",
            "sourceCode": "function variable(name) {\n  try {\n    return $context.$variables ? $context.$variables[name] : null;\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction resolver() {\n  try {\n    return $context.$nodes.PRJ_PJO_CODE_CONTEXT_RESOLVER.$output.result || {};\n  } catch (e) {\n    return {};\n  }\n}\n\nfunction asString(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  if (typeof value === 'string') {\n    return value;\n  }\n  try {\n    return JSON.stringify(value);\n  } catch (e) {\n    return String(value);\n  }\n}\n\nfunction formatTimestamp(date) {\n  function pad(value) {\n    return String(value).padStart(2, '0');\n  }\n  return pad(date.getDate()) + '-' + pad(date.getMonth() + 1) + '-' + date.getFullYear() + ' ' + pad(date.getHours()) + ':' + pad(date.getMinutes());\n}\n\nfunction buildPayload() {\n  return {\n    agent: 'PROJECT_PLANNING_INQUIRY_AGENT',\n    intent: 'BudgetInquiry',\n    schema_version: '1',\n    title: 'Project Budget Inquiry',\n    description: 'Project budget inquiry response',\n    timestamp: formatTimestamp(new Date()),\n    topicName: 'Project Budget Inquiry',\n    agent_response: [\n      {\n        display_type: 'text',\n        display_sequence: 1,\n        text: asString($context.$nodes.PRJ_PJO_LLM_RESPONSE_GENERATOR_BUDGET.$output),\n        expand: {\n          display: 'true',\n          headerText: 'Summary'\n        }\n      }\n    ]\n  };\n}\n\nvar resolved = resolver();\nvar payload = buildPayload();\nvar contextDetails = {\n  message: resolved.message || '',\n  intent: 'BudgetInquiry',\n  state: resolved.state || null,\n  stateJson: asString(resolved.state || {})\n};\nvar contract = {\n  redwoodResponse: {\n    type: 'redwood',\n    content: payload\n  },\n  atomicAgentDetails: {\n    atomicAgentCode: 'PROJECT_PLANNING_INQUIRY_AGENT',\n    atomicAgentContext: 'Project Planning Inquiry Agent',\n    contextDetails: contextDetails,\n    filters: null,\n    atomicAgentResponse: payload\n  }\n};\n\nreturn {\n  payload: payload,\n  redwoodResponse: contract.redwoodResponse,\n  atomicAgentDetails: contract.atomicAgentDetails,\n  returnValue: String(resolved.returnEnvelopeFlag || '').toUpperCase() === 'Y' ? JSON.stringify(contract) : payload\n};"
          },
