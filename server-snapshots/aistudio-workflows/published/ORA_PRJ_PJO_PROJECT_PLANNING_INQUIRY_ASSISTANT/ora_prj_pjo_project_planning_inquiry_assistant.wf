            "name": "Context Resolver",
            "returnType": "object",
            "sourceCode": "function restInput() {\n  try {\n    return ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input) || {};\n  } catch (e) {\n    return {};\n  }\n}\n\nfunction variable(name) {\n  try {\n    return $context.$variables ? $context.$variables[name] : null;\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction systemInputMessage() {\n  try {\n    return $context.$system && $context.$system.$inputMessage;\n  } catch (e) {\n    return null;\n  }\n}\n\n\nfunction parseMaybe(value) {\n  if (value === null || value === undefined || value === '') {\n    return null;\n  }\n  if (typeof value === 'object') {\n    return value;\n  }\n  if (typeof value !== 'string') {\n    return null;\n  }\n  try {\n    return JSON.parse(value);\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction firstNonEmpty(values) {\n  for (var i = 0; i < values.length; i++) {\n    var value = values[i];\n    if (value !== null && value !== undefined && String(value).trim() !== '') {\n      return value;\n    }\n  }\n  return '';\n}\n\nvar input = restInput();\nvar activeAtomicAgentDetails = parseMaybe(input.prjPjfActiveAtomicAgentDetails) || parseMaybe(variable('prjPjfActiveAtomicAgentDetails')) || null;\nvar retainedForThisAgent = !!(activeAtomicAgentDetails && activeAtomicAgentDetails.atomicAgentCode === 'PROJECT_PLANNING_INQUIRY_AGENT');\nvar contextDetails = retainedForThisAgent ? (parseMaybe(activeAtomicAgentDetails.contextDetails) || activeAtomicAgentDetails.contextDetails || {}) : {};\nvar nestedState = parseMaybe(contextDetails && contextDetails.stateJson);\nvar restoredState = nestedState || contextDetails || {};\nvar routingContext = firstNonEmpty([input.prjPjfRoutingContext, variable('prjPjfRoutingContext'), input.source, variable('source')]);\nvar message = firstNonEmpty([input.message, input.inputMessage, input.userMessage, variable('message'), systemInputMessage()]);\nvar chatHistory = parseMaybe(input.prjPjfStrategicAgentChatHistory) || input.prjPjfStrategicAgentChatHistory || variable('prjPjfStrategicAgentChatHistory') || [];\nvar attachContent = parseMaybe(input.prjPjfStrategicAttachContent) || input.prjPjfStrategicAttachContent || variable('prjPjfStrategicAttachContent') || null;\n\nreturn {\n  message: message,\n  routingContext: routingContext,\n  returnEnvelopeFlag: String(routingContext || '').toLowerCase() === 'redwoodui' ? 'Y' : 'N',\n  strategicAgentChatHistory: chatHistory,\n  activeAtomicAgentDetails: activeAtomicAgentDetails,\n  strategicAttachContent: attachContent,\n  hasState: retainedForThisAgent && !!restoredState,\n  state: restoredState\n};"
          },
