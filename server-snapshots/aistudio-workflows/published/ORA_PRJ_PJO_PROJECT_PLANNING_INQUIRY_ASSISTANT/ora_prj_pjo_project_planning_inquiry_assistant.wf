        {
          "metadata": {
            "name": "Normalize Boss AI Output",
            "returnType": "object",
            "sourceCode": "const cloneJson = (value) => {\n  if (value == null) return value;\n  try {\n    return JSON.parse(JSON.stringify(value));\n  } catch (e) {\n    return value;\n  }\n};\n\nconst formatCurrentDate = (value) => {\n  const text = value == null ? \"\" : String(value);\n  const isoMatch = text.match(/\\d{4}-\\d{2}-\\d{2}/);\n  if (isoMatch) return isoMatch[0];\n\n  const parsed = new Date(text);\n  if (!Number.isNaN(parsed.getTime())) {\n    return parsed.toISOString().slice(0, 10);\n  }\n\n  return new Date().toISOString().slice(0, 10);\n};\n\nconst output = cloneJson($context.$nodes.PRJ_PJO_BO_FUNCTION_CALL_BOSS_OBJECT_PERFORMANCE.$output);\nconst firstQuery = Array.isArray(output?.queries) ? output.queries[0] : null;\nconst avUsage = firstQuery?.analyticViews?.avUsage1;\nconst filter = typeof avUsage?.filter === \"string\" ? avUsage.filter : \"\";\n\nif (filter.includes(\"accountingPeriod.$levelName = 'CALENDAR'\")) {\n  if (!avUsage.dimensions || typeof avUsage.dimensions !== \"object\") {\n    avUsage.dimensions = {};\n  }\n\n  if (!avUsage.dimensions.accountingPeriod || typeof avUsage.dimensions.accountingPeriod !== \"object\") {\n    avUsage.dimensions.accountingPeriod = {};\n  }\n\n  if (!avUsage.dimensions.accountingPeriod.accountingPeriod || typeof avUsage.dimensions.accountingPeriod.accountingPeriod !== \"object\") {\n    avUsage.dimensions.accountingPeriod.accountingPeriod = {};\n  }\n\n  avUsage.dimensions.accountingPeriod.accountingPeriod.filter = \"periodStartDate <= '\" + formatCurrentDate($context.$system.$currentDate) + \"'\";\n}\n\nreturn output;"
          },
          "outcomes": {
            "success": "1780592660188"
          },
          "code": "PRJ_PJO_CODE_NORMALIZE_BOSS_AI_OUTPUT",
          "id": "1782110115262",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Create Column to field mapping",
            "returnType": "object",
            "sourceCode": "const mapFieldToName = (bql) => {\n  const mapping = {};\n\n  const firstQuery = Array.isArray(bql.queries) ? bql.queries[0] : null;\n  if (!firstQuery || typeof firstQuery.select !== 'string') {\n    return mapping; // No valid query/select found.\n  }\n\n  const columnSet = new Set();\n  const matches = firstQuery.select.match(/C\\d+/g);\n  if (matches) {\n    matches.forEach((m) => columnSet.add(m));\n  }\n\n  const traverse = (node, path = [], insideDimensions = false) => {\n    if (Array.isArray(node)) {\n      node.forEach((item) => traverse(item, path, insideDimensions));\n    } else if (node && typeof node === 'object') {\n      for (const [key, value] of Object.entries(node)) {\n        const nextInsideDimensions = insideDimensions || key === 'dimensions';\n        const nextPath = nextInsideDimensions && key !== 'dimensions' ? [...path, key] : path;\n\n        if (typeof value === 'string' && columnSet.has(value)) {\n          mapping[value] = nextInsideDimensions ? nextPath.join('.') : key;\n        } else {\n          traverse(value, nextPath, nextInsideDimensions);\n        }\n      }\n    }\n  };\n\n  traverse(firstQuery);\n  return mapping;\n};\n\nreturn mapFieldToName($context.$nodes.PRJ_PJO_CODE_NORMALIZE_BOSS_AI_OUTPUT.$output.result);"
          },
          "outcomes": {
            "success": "1780592723314"
          },
          "code": "PRJ_PJO_CODE_CREATE_COLUMN_TO_FIELD_MAPPING",
          "id": "1780592660188",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
