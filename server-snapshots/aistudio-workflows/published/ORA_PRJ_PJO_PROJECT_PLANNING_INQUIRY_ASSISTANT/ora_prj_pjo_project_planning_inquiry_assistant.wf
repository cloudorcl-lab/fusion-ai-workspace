          "code": "PRJ_PJO_BO_FUNCTION_CALLING_BOSS_EXTRACT",
          "id": "1780592723314",
          "inputs": [
            {
              "id": "1780592768295_1",
              "name": "payload",
              "type": "string",
              "value": "{{$context.$nodes.PRJ_PJO_BO_FUNCTION_CALL_BOSS_OBJECT_PERFORMANCE.$output.queries[0]}}{{$context.$nodes.PRJ_PJO_CODE_NORMALIZE_BOSS_AI_OUTPUT.$output.result}}"
            }
          ],
          "outputSpecification": "{}",
