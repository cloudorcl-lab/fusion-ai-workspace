        {
          "metadata": {
            "name": "Updated Boss extract response field",
            "returnType": "array",
            "sourceCode": "const updateFieldNames = (data, mapping) => {\n  if(!data) return [];\n\n  return data.map((item) => {\n    const transformed = {};\n\n    for (const [key, value] of Object.entries(item)) {\n      const newKey = mapping[key] ?? key;\n      transformed[newKey] = value;\n    }\n\n    return transformed;\n  });\n}\n\nconst bossExtractResponse = $context.$nodes.PRJ_PJO_BO_FUNCTION_CALLING_BOSS_EXTRACT.$output ;\nconst colToFieldMapping =  $context.$nodes.PRJ_PJO_CODE_CREATE_COLUMN_TO_FIELD_MAPPING.$output.result ;\n\nreturn updateFieldNames(bossExtractResponse, colToFieldMapping);"
          },
          "outcomes": {
            "success": "1780593107435"
          },
          "code": "PRJ_PJO_CODE_UPDATED_BOSS_EXTRACT_RESPONSE_FIELD",
          "id": "1780593001359",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
