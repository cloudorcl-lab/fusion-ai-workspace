            "sourceCode": "let payload = {\n    \"question\": $context.$nodes.PRJ_PJO_LLM_CONTEXTUAL_QUERY_REWRITER.$output,\n    \"queries\": [\n        {\n            \"target\": {\n                \"module\": \"oraErpCoreProjectPlanning\",\n                \"businessObject\": \"ProjectBudget\",\n                \"businessView\": \"projectBudgetDetails\"\n            },\n            \"query\": {\n                \"fields\": [\n                    \"id\",\n                    \"budgetVersionNumber\",\n                    \"name\",\n                    \"rawCostInProjectCurrency\",\n                    \"burdenedCostInProjectCurrency\",\n                    \"revenueInProjectCurrency\",\n                    \"revenueInProjectLedgerCurrency\",\n                    \"rawCostInProjectLedgerCurrency\",\n                    \"burdenedCostInProjectLedgerCurrency\",\n                    \"planVersionStatus\",\n                    \"laborQuantity\",\n                    \"equipmentQuantity\"\n                ],\n                \"accessors\": {\n                    \"project\": {\n                        \"fields\": [\n                            \"projectNumber\",\n                            \"name\",\n                            \"id\"\n                        ],\n                        \"accessors\": {\n                            \"projectCurrency\": {\n                                \"fields\": [\n                                    \"currencyCode\"\n                                ]\n                            }\n                        }\n                    },\n                    \"resources\": {\n                        \"fields\": [\n                            \"id\"\n                        ],\n                        \"accessors\": {\n                            \"task\": {\n                                \"fields\": [\n                                    \"id\",\n                                    \"name\",\n                                    \"taskNumber\"\n                                ]\n                            },\n                            \"resource\": {\n                                \"fields\": [\n                                    \"id\",\n                                    \"name\"\n                                ]\n                            },\n                            \"amounts\": {\n                                \"fields\": [\n                                    \"id\",\n                                    \"quantity\",\n                                    \"rawCost\",\n                                    \"burdenedCost\",\n                                    \"revenue\",\n                                    \"rawCostInProjectCurrency\",\n                                    \"burdenedCostInProjectCurrency\",\n                                    \"revenueInProjectCurrency\",\n                                    \"rawCostInProjectLedgerCurrency\",\n                                    \"burdenedCostInProjectLedgerCurrency\",\n                                    \"revenueInProjectLedgerCurrency\",\n                                    \"standardRawCostRate\",\n                                    \"standardBurdenedCostRate\",\n                                    \"standardRevenueRate\",\n                                    \"effectiveRawCostRate\",\n                                    \"effectiveBurdenedCostRate\",\n                                    \"effectiveRevenueRate\"\n                                ]\n                            }\n                        }\n                    },\n                    \"financialPlanType\": {\n                        \"fields\": [\n                            \"name\"\n                        ]\n                    }\n                }\n            }\n        }\n    ]\n};\nreturn payload;"
