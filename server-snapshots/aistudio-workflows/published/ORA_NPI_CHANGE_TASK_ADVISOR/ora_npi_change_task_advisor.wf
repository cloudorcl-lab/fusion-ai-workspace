            "name": "ExtractTask",
            "returnType": "string",
            "sourceCode": "const str = $context.$system.$inputMessage;\nif (str !== null && str !== undefined && typeof str === 'string' && str.includes(\"Task\")) {\n        let match = str.match(/\\d+/);\n        if (match) {\n            return match[0];\n        }\n    }\n    return \"NO_TASK\";"
          },
          "outcomes": {
            "success": "1762180468253"
          },
