            "sourceCode": "const changeId= $context.$variables.ChangeId;\n\nif(!changeId){\nthrow new Error(\"Item or Org not found in context\");\n}\nconst filterValues = {\nchangeId: `${changeId}`,\nitemChangeOrderV2UsingId:`ChangeId='${changeId}'&onlyData=true&fields=ChangeId,ChangeNotice,PriorityCodeValue,ApprovalStatusValue,ChangeTypeNameValue,CategoryCode,StatusComments,InitiationDateTime,AssignedToRole,NeedByDateTime`,\nitemSearchParams:`changeOrderTasks?fields=Name,Description,RequiredFlag,AssignedTo,StartAfterStatusCodeValue,CompleteBeforeStatusCodeValue,StatusCodeValue,NeedByDateTime&onlyData=true`\n};\nreturn filterValues ;"
          },
          "outcomes": {
            "success": "1770939848442"
          },
