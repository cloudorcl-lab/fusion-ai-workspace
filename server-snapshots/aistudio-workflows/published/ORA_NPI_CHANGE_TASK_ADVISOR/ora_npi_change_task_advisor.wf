          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"Name\": {\n            \"type\": \"string\",\n            \"description\": \"Name of the task\"\n          },\n          \"Description\": {\n            \"type\": \"string\",\n            \"description\": \"Description of the task\"\n          },\n          \"RequiredFlag\": {\n            \"type\": [\"boolean\", \"null\"],\n            \"description\": \"Flag indicating if the task is required\"\n          },\n          \"AssignedTo\": {\n            \"type\": \"string\",\n            \"description\": \"User or role the task is assigned to\"\n          },\n          \"StartAfterStatusCodeValue\": {\n            \"type\": \"string\",\n            \"description\": \"Status code after which the task should start\"\n          },\n          \"CompleteBeforeStatusCodeValue\": {\n            \"type\": \"string\",\n            \"description\": \"Status code before which the task should be completed\"\n          },\n          \"StatusCodeValue\": {\n            \"type\": \"string\",\n            \"description\": \"Current status code of the task\"\n          },\n          \"NeedByDateTime\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\",\n            \"description\": \"Date and time by which the task is needed\"\n          },\n          \"@context\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"key\": {\n                \"type\": \"string\",\n                \"description\": \"Context key\"\n              },\n              \"headers\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"ETag\": {\n                    \"type\": \"string\",\n                    \"description\": \"Entity tag for concurrency control\"\n                  }\n                },\n                \"required\": [\"ETag\"]\n              }\n            },\n            \"required\": [\"key\", \"headers\"]\n          }\n        },\n        \"required\": [\n          \"Name\",\n          \"Description\",\n          \"RequiredFlag\",\n          \"AssignedTo\",\n          \"StartAfterStatusCodeValue\",\n          \"CompleteBeforeStatusCodeValue\",\n          \"StatusCodeValue\",\n          \"NeedByDateTime\",\n          \"@context\"\n        ]\n      }\n    },\n    \"count\": {\n      \"type\": \"integer\",\n      \"description\": \"Total number of tasks\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\",\n      \"description\": \"Indicates if there are more records\"\n    },\n    \"limit\": {\n      \"type\": \"integer\",\n      \"description\": \"Pagination limit\"\n    },\n    \"offset\": {\n      \"type\": \"integer\",\n      \"description\": \"Pagination offset\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\",\n            \"description\": \"Relationship type\"\n          },\n          \"href\": {\n            \"type\": \"string\",\n            \"format\": \"uri\",\n            \"description\": \"Hyperlink reference\"\n          },\n          \"name\": {\n            \"type\": \"string\",\n            \"description\": \"Name of the link\"\n          },\n          \"kind\": {\n            \"type\": \"string\",\n            \"description\": \"Kind of the linked resource\"\n          }\n        },\n        \"required\": [\"rel\", \"href\", \"name\", \"kind\"]\n      }\n    }\n  }\n}",
