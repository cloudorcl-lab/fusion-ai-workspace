                {
                  "metadata": {
                    "name": "Filter CSV",
                    "returnType": "string",
                    "sourceCode": "const excludeSet = new Set(($context.$nodes.GET_OPTY_CONTACT_EMAILS.$output.result).map(e => e.toLowerCase()));\n\nconst filteredCsv = ($context.$nodes.FOR_EACH_ENGAGEMENT.$currentItem.participants)\n  .split(\",\")\n  .map(s => s.trim())\n  .filter(Boolean)\n  .filter(email => !excludeSet.has(email.toLowerCase()))\n  .join(\",\");\n\nreturn filteredCsv;"
                  },
                  "outcomes": {
                    "success": "1770691529146"
                  },
                  "diagram": {
                    "x": 4625,
                    "y": 6153
                  },
                  "code": "FILTER_CSV",
                  "id": "1770688776672",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "If New Contacts Found"
