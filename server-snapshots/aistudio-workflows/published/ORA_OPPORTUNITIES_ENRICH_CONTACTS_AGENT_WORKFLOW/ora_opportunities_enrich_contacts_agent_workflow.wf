                      "value": "{{$context.$nodes.FOR_EACH_ENGAGEMENT.FILTER_CSV.$output.result != \"\" && $context.$nodes.FOR_EACH_ENGAGEMENT.FILTER_CSV.$output.result != null}}"
                    }
                  ],
                  "type": "CONDITION"
                },
                {
                  "metadata": {
                    "name": "Get Enriched Contacts",
                    "workflowCode": "ORA_ENRICH_CONTACTS_AGENT"
                  },
