          },
          "code": "IS_CONTEXT_PROVIDED",
          "convergenceTargetId": "1770431118229",
          "id": "1770430830364",
          "inputs": [
            {
              "id": "1770430830365_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.context?.result !== null}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Get Opty Contact Emails",
            "returnType": "array",
            "sourceCode": "let result = [];\ntry {\n  // Access the raw context string safely\n  const rawContextString = $context.$triggers?.REST?.$input?.context??null;\n  \n  // Parse JSON safely\n  const parsedContext = rawContextString;\n\n  // Extract arrays safely with optional chaining and default empty arrays\n  const opportunity = parsedContext?.result?.OPPORTUNITY?.[0] || {};\n  const listOfContacts = opportunity.ListOfContacts || [];\n  const listOfResourcesForTheTeam = opportunity.ListOfResourcesForTheTeam || [];\n\n  // Access engagement insight data safely\n  const engagementInsightData = parsedContext?.result?.ENGAGEMENT?.insight_data?.items[0] || {};\n  const additionalInsightDataRaw = engagementInsightData.additionalInsightData || null;\n\n  // Parse additionalInsightData JSON safely\n  let additionalInsightData = { recommendedContacts: [] };\n  if (additionalInsightDataRaw) {\n    try {\n      additionalInsightData = JSON.parse(additionalInsightDataRaw);\n    } catch (e) {\n      // If parsing fails, fallback to empty recommendedContacts\n      additionalInsightData = { recommendedContacts: [] };\n    }\n  }\n\n  // Extract emails from ListOfContacts\n  const contactEmails = listOfContacts\n    .map(c => c.PerPartyId?.PrimaryEmail?.EmailAddress)\n    .filter(email => typeof email === 'string' && email.length > 0);\n\n  // Extract emails from ListOfResourcesForTheTeam\n  const resourceEmails = listOfResourcesForTheTeam\n    .map(r => r.ResourceId?.PrimaryEmail?.EmailAddress)\n    .filter(email => typeof email === 'string' && email.length > 0);\n\n  // Extract emails from recommendedContacts\n  const recommendedEmails = (additionalInsightData.recommendedContacts\n    ??[]).map(a => a.EmailAddress)\n    .filter(email => typeof email === 'string' && email.length > 0);\n\n  // Combine all emails and remove duplicates\n  const uniqueEmails = Array.from(new Set([...contactEmails, ...resourceEmails, ...recommendedEmails]));\n\n  result = uniqueEmails;\n} catch (error) {\n  result = [];\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776487393767"
          },
          "code": "GET_OPTY_CONTACT_EMAILS",
          "id": "1770687997877",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Filter Email Engagements",
            "returnType": "array",
            "sourceCode": "const allEngagements = $context.$triggers.REST.$input.context.result.ENGAGEMENT.engagements || [];\nconst emailEngagements = allEngagements.filter(e => e.engagementType === 'EMAIL');\nreturn emailEngagements;"
          },
          "outcomes": {
            "success": "1770430860730"
          },
          "code": "FILTER_EMAIL_ENGAGEMENTS",
