              ],
              "rootNode": "start_1770430860730"
            },
            "loopType": "PARALLEL",
            "name": "For Each Engagement"
          },
          "outcomes": {
            "success": "1770431118229"
          },
          "code": "FOR_EACH_ENGAGEMENT",
          "id": "1770430860730",
          "inputs": [
            {
              "id": "1770430860732_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.FILTER_EMAIL_ENGAGEMENTS.$output.result}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "Return All Contacts",
            "returnType": "object",
            "sourceCode": "const result = JSON.parse($context.$triggers.REST.$input.context.result.ENGAGEMENT?.insight_data?.items[0].additionalInsightData || null)?.recommendedContacts ?? [];\nconst seen = new Set();\n\n$context.$nodes.FOR_EACH_ENGAGEMENT.$output?.forEach(arr => {\n    try {\n        const set = JSON.parse(arr)?.result.result.response || [];\n\n        set.forEach(item => {\n            const email = item?.EmailAddress;\n            if (!email) return;\n\n            const key = email.toLowerCase();\n            if (seen.has(key)) return;\n\n            seen.add(key);\n            result.push(item);\n        });\n    } catch(error) {\n    }\n});\nreturn {\"recommendedContacts\": result};"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "RETURN_ALL_CONTACTS",
          "id": "1770431118229",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
