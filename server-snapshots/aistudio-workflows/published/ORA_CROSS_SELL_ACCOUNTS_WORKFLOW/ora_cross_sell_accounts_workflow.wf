        {
          "id": "1782219394348",
          "code": "KNOWLEDGE_ARTIFACTS",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Knowledge Artifacts",
            "businessObjectCode": "ORA_CX_MARKETING_DATAOBJECTS",
