          "restConfigJson": "{\n    \"OraAppContext\": \"{\\\"parentProductId\\\":\\\"FUSION_300100642865089\\\",\\\"parentProductName\\\":\\\"Fusion ERP\\\"}\",\n    \"OraMessageHint\": \"InitDisplay\",\n    \"OraUserContext\": \"{\\\"userId\\\":\\\"\\\",\\\"guId\\\":\\\"351CE5FA5E864DB2BFA4EE87FE35993A\\\",\\\"fullName\\\":\\\"Abhi Bichala\\\",\\\"userName\\\":\\\"abhishek.bichala@oracle.com\\\",\\\"isAuthenticated\\\":true,\\\"loginUrl\\\":\\\"https://cpdcfvnqy.fusionappspreprod.ocs.oc-test.com:443/fscmUI/faces/FuseWelcome\\\",\\\"isAdmin\\\":true,\\\"idcsTimeOut\\\":30,\\\"locale\\\":\\\"en\\\"}\",\n    \"triggerType\": \"REST\",\n    \"aiAppOutputSpecification\": \"[\\\"infoDisplay\\\",\\\"actions\\\",\\\"enableCommunications\\\"]\"\n}"
        },
        {
