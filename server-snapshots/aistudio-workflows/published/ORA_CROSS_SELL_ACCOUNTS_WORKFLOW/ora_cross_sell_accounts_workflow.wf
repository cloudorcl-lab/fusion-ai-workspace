        {
          "id": "1782219394349",
          "code": "PREPARE_KNOWLEDGE_ARTIFACT",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Knowledge Artifact",
            "sourceType": "code",
            "returnType": "object",
            "sourceCode": "let result = {};\n\ntry {\n  const rawOutput = $context.$nodes?.KNOWLEDGE_ARTIFACTS?.$output || {};\n\n  let payload = rawOutput;\n\n  // If full output is a string\n  if (typeof payload === \"string\") {\n    payload = JSON.parse(payload);\n  }\n\n  // Handle BO wrapper: { output: { responseStatus, response } }\n  if (payload?.output) {\n    payload = payload.output;\n  }\n\n  // Handle response/result if they are strings or objects\n  if (typeof payload?.response === \"string\") {\n    payload = JSON.parse(payload.response);\n  } else if (payload?.response && typeof payload.response === \"object\") {\n    payload = payload.response;\n  } else if (typeof payload?.result === \"string\") {\n    payload = JSON.parse(payload.result);\n  } else if (payload?.result && typeof payload.result === \"object\") {\n    payload = payload.result;\n  }\n\n  const artifacts = payload?.items || [];\n\n  const artifact =\n    artifacts.find(item => item?.artifactCode === \"mcc.bootstrap\") ||\n    artifacts[0] ||\n    {};\n\n  let contentJson = artifact?.contentJson || {};\n\n  // contentJson from BO is a JSON string, so parse it\n  if (typeof contentJson === \"string\") {\n    contentJson = JSON.parse(contentJson);\n  }\n\n  const productHierarchyConfig =\n    contentJson?.items?.find(\n      item => item?.name === \"productHierarchies\"\n    ) || {};\n\n  const children = productHierarchyConfig?.operations?.children || {};\n\n  result = children;\n\n} catch (error) {\n  console.log(error);\n  result = {\n  };\n}\n\nreturn result;"
          },
          "diagram": {
            "x": 5435.837333867253,
            "y": 5721.516480916413
          },
          "outcomes": {
            "success": "1782219394347"
          },
