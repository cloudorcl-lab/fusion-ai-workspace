            "name": "Slice the top 5 Rows",
            "returnType": "array",
            "sourceCode": "let result = [];\ntry {\n  const items = $context.$nodes?.GET_CROSS_SELL_PRODUCTS?.$output?.items || [];\n\n  // Slice the top 5 rows from existing items\n  const topFiveRows = items.slice(0, 5);\n\n  // Add the new row as the first element\n  result = items;\n} catch (error) {\n  result = [];\n}\n\nreturn result;"
          },
