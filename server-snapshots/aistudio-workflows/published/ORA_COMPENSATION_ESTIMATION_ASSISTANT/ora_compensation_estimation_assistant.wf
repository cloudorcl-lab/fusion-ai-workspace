                                  "inputs": [
                                    {
                                      "id": "1773431902421_1",
                                      "name": "LOVResource",
                                      "type": "string",
                                      "value": "{{$context.$nodes.FOR_EACH_TRANSACTION.FOR_EACH_CREDIT.FOR_EACH_REQUIRED_CREDIT_FIELD.$currentItem.lovResourcePath.resource}}"
                                    },
                                    {
                                      "id": "1773431902424_2",
                                      "name": "Filter",
                                      "type": "string",
                                      "value": "{{$context.$nodes.FOR_EACH_TRANSACTION.FOR_EACH_CREDIT.FOR_EACH_REQUIRED_CREDIT_FIELD.BUILD_CREDIT_FIELD_LOV_FILTER_JS.$output.result}}"
                                    }
                                  ],
                                  "outputSpecification": "{}",
                                  "type": "BO_FUNCTION"
                                },
                                {
                                  "metadata": {
                                    "name": "Read credit fields LOV values JS",
                                    "returnType": "object",
                                    "sourceCode": "const reqField =\n  $context.$nodes.FOR_EACH_TRANSACTION.FOR_EACH_CREDIT.FOR_EACH_REQUIRED_CREDIT_FIELD.$currentItem;\n\nconst lovResponse =\n  $context.$nodes.FOR_EACH_TRANSACTION.FOR_EACH_CREDIT.FOR_EACH_REQUIRED_CREDIT_FIELD\n    .GET_CREDIT_FIELD_LOV_VALUES_BO.$output;\n\nconst items = lovResponse.items;\n\nconst idKey = reqField.lovAttributeMap.source;\nconst labelKey = reqField.lovDisplayAttributes;\n\nreqField.lovValues = items.map(r => ({\n  id: r[idKey],\n  label: r[labelKey]\n}));\n\nreturn reqField;"
                                  },
                                  "outcomes": {
                                    "success": "end_1773429420508"
                                  },
                                  "code": "READ_CREDIT_FIELDS_LOV_VALUES_JS",
                                  "id": "1773435309974",
                                  "inputs": [],
                                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                                  "type": "CODE"
                                },
                                {
                                  "metadata": {
