                        {
                          "metadata": {
                            "name": "Read txn fields LOV values JS",
                            "returnType": "object",
                            "sourceCode": "const reqField = $context.$nodes.FOR_EACH_TRANSACTION.FOR_EACH_REQUIRED_TXN_FIELD.$currentItem;\n\nconst lovResponse = $context.$nodes.FOR_EACH_TRANSACTION.FOR_EACH_REQUIRED_TXN_FIELD.GET_TXN_FIELD_LOV_VALUES_BO.$output;\n\nconst items = lovResponse.items;\n\nconst idKey = reqField.lovAttributeMap.source;\nconst labelKey = reqField.lovDisplayAttributes;\n\nreqField.lovValues = items.map(r => ({\n  id: r[idKey],\n  label: r[labelKey]\n}));\n\nreturn reqField;"
                          },
                          "outcomes": {
                            "success": "end_1773785339485"
                          },
