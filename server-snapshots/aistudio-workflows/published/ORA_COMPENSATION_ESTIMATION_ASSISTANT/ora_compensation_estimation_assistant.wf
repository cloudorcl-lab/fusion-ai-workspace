                {
                  "metadata": {
                    "name": "Find txn date JS",
                    "returnType": "string",
                    "sourceCode": "  const transaction = $context.$nodes.FOR_EACH_TRANSACTION.$currentItem ;\n  const fields = transaction?.populatedFields || [];\n  const match = fields.find(f => f?.name === \"SourceEventDate\");\n  if (!match || match.value == null) return null;\n\n  const d = new Date(match.value);\n  if (Number.isNaN(d.getTime())) return null;\n\n  const yyyy = d.getFullYear();\n  const mm = String(d.getMonth() + 1).padStart(2, \"0\");\n  const dd = String(d.getDate()).padStart(2, \"0\");\n  return `${yyyy}-${mm}-${dd}`;"
                  },
                  "outcomes": {
                    "success": "1773164053244"
                  },
                  "code": "FIND_TXN_DATE_JS",
                  "id": "1773163433304",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "IF txn date found"
                  },
                  "outcomes": {
                    "true": "1773175666784",
                    "false": "1773164556386"
                  },
                  "code": "IF_TXN_DATE_FOUND",
                  "convergenceTargetId": "end_1773160387751",
                  "id": "1773164053244",
                  "inputs": [
                    {
                      "id": "1773164053246_1",
                      "name": "condition",
                      "type": "string",
                      "value": "{{$context.$nodes.FOR_EACH_TRANSACTION.FIND_TXN_DATE_JS.$output.result && !($context.$nodes.FOR_EACH_TRANSACTION.FIND_TXN_DATE_JS.$output.error)}}"
                    }
                  ],
                  "type": "CONDITION"
                },
                {
                  "metadata": {
                    "name": "Build error in txn date JS",
                    "returnType": "object",
                    "sourceCode": "const date_found =\n  $context.$nodes.FOR_EACH_TRANSACTION.FIND_TXN_DATE_JS.$output.result;\nconst error_found =\n  $context.$nodes.FOR_EACH_TRANSACTION.FIND_TXN_DATE_JS.$output.error;\nconst transaction = $context.$nodes.FOR_EACH_TRANSACTION.$currentItem;\n\n// ensure errors array exists\nif (!Array.isArray(transaction.errors)) transaction.errors = [];\n\n// build ONE error entry covering both cases (missing date or extraction error)\nconst hasDate =\n  date_found !== null &&\n  date_found !== undefined &&\n  !(typeof date_found === \"string\" && date_found.trim() === \"\");\n\nif (!hasDate || error_found) {\n  transaction.errors.push(\n    error_found\n      ? `Could not determine SourceEventDate: ${error_found}`\n      : \"SourceEventDate is missing or empty\"\n  );\n}\n\nreturn transaction;"
                  },
                  "outcomes": {
                    "success": "end_1773160387751"
                  },
                  "code": "BUILD_ERROR_IN_TXN_DATE_JS",
                  "id": "1773164556386",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "Mark txn validated JS",
                    "returnType": "object",
                    "sourceCode": "let transaction = $context.$nodes.FOR_EACH_TRANSACTION.MATCH_USER_INPUT_TO_TXN_FIELDS_LLM.$output;\nlet credits = $context.$nodes.FOR_EACH_TRANSACTION.READ_CREDITS_LOOP_JS.$output.result.credits;\n\ntransaction.credits = Array.isArray(credits) ? credits : [];\n\n// Ensure transaction.errors exists and do not delete existing errors\nif (!Array.isArray(transaction.errors)) transaction.errors = [];\n\n// ---- Validate transaction required fields ----\nconst txnFields = Array.isArray(transaction.populatedFields) ? transaction.populatedFields : [];\nconst requiredTxnFields = txnFields.filter(f => f && f.required === true);\nconst txnRequiredValid = requiredTxnFields.every(f => f.validated === true);\n\n// ---- Validate credits ----\nconst creditsValid = transaction.credits.every(c => c && c.validated === true);\n\n// Transaction is validated only if required txn fields are valid AND all credits are valid\ntransaction.validated = txnRequiredValid && creditsValid;\n\nreturn transaction;"
                  },
                  "outcomes": {
                    "success": "end_1773160387751"
                  },
                  "code": "MARK_TXN_VALIDATED_JS",
                  "convergenceTargetId": "1773169735196",
                  "id": "1773164950180",
                  "inputs": [],
