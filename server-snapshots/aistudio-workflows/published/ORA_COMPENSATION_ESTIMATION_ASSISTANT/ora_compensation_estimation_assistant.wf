          "id": "1772575359499",
          "name": "SimulationSummary",
          "scope": "CONVERSATION",
          "type": "object",
          "typeSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"Simulation Summary\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"userObjective\", \"transactions\", \"unusedData\"],\n  \"properties\": {\n    \"userObjective\": { \"type\": \"string\" },\n    \"transactions\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"populatedFields\", \"credits\", \"validated\", \"errors\"],\n        \"properties\": {\n          \"populatedFields\": { \"$ref\": \"#/$defs/populatedFields\" },\n          \"credits\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"additionalProperties\": true,\n              \"required\": [\"populatedFields\", \"validated\", \"errors\"],\n              \"properties\": {\n                \"populatedFields\": { \"$ref\": \"#/$defs/populatedFields\" },\n                \"validated\": { \"type\": \"boolean\" },\n                \"errors\": {\n                  \"type\": \"array\",\n                  \"items\": { \"type\": \"string\" }\n                }\n              }\n            }\n          },\n          \"validated\": { \"type\": \"boolean\" },\n          \"errors\": {\n            \"type\": \"array\",\n            \"items\": { \"type\": \"string\" }\n          }\n        }\n      }\n    },\n    \"unusedData\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"name\", \"value\", \"validValues\", \"problem\"],\n        \"properties\": {\n          \"name\": { \"type\": \"string\" },\n          \"value\": {},\n          \"validValues\": { \"type\": \"string\" },\n          \"problem\": { \"type\": \"string\" }\n        }\n      }\n    }\n  },\n  \"$defs\": {\n    \"populatedFields\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"name\", \"value\", \"dbColumn\", \"validated\", \"required\", \"errors\"],\n        \"properties\": {\n          \"name\": { \"type\": \"string\" },\n          \"value\": {},\n          \"userFriendlyValue\": {},\n          \"dbColumn\": { \"type\": \"string\" },\n          \"validated\": { \"type\": \"boolean\" },\n          \"required\": { \"type\": \"boolean\" },\n          \"errors\": {\n            \"type\": \"array\",\n            \"items\": { \"type\": \"string\" }\n          },\n          \"isDFF\": { \"type\": \"boolean\" }\n        }\n      }\n    }\n  }\n}"
