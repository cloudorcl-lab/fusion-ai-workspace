            "sourceCode": "let simulation_summary = $context.$variables.SimulationSummary;\n\nlet txnsOut = $context.$nodes.FOR_EACH_TRANSACTION.$output;\n\nconst txnsUpdated = txnsOut.map(x => JSON.parse(x).result);\n\nsimulation_summary.transactions = txnsUpdated;\n\nreturn simulation_summary;"
          },
