          "type": "array",
          "typeSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"StructuredChatHistory\",\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"object\",\n    \"additionalProperties\": false,\n    \"required\": [\"role\", \"content\"],\n    \"properties\": {\n      \"role\": {\n        \"type\": \"string\",\n        \"enum\": [\"user\", \"assistant\"]\n      },\n      \"content\": {\n        \"type\": \"string\"\n      },\n      \"timestamp\": {\n        \"type\": \"string\"\n      }\n    }\n  }\n}"
