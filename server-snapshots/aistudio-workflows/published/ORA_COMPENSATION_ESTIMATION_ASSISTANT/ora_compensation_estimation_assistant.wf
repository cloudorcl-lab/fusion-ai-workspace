                {
                  "metadata": {
                    "name": "Read credits loop JS",
                    "returnType": "object",
                    "sourceCode": "let creditsOut = $context.$nodes.FOR_EACH_TRANSACTION.FOR_EACH_CREDIT.$output;\n\n// Each loop item is a JSON string; after JSON.parse it has shape:\n// { result: { credit, transactionRequiredFields } }\nconst results = creditsOut.map(x => JSON.parse(x).result);\n\n// 1) Collect credits\nconst credits = results.map(r => r.credit);\n\n// 2) Collect and de-duplicate transaction required fields across all credits\nconst allTxnReqFields = results.flatMap(r => r.transactionRequiredFields || []);\n\n// Unique by EntityName + FieldName\nconst uniqueMap = new Map();\nfor (const f of allTxnReqFields) {\n  const key = `${f.EntityName}|${f.FieldName}`;\n  if (!uniqueMap.has(key)) uniqueMap.set(key, f);\n}\n\nconst transactionRequiredFields = Array.from(uniqueMap.values());\n\nreturn { credits, transactionRequiredFields };"
                  },
                  "outcomes": {
                    "success": "1773785339485"
                  },
                  "code": "READ_CREDITS_LOOP_JS",
                  "id": "1773770947964",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
