        {
          "metadata": {
            "name": "Get Distinct Orgs JS",
            "returnType": "object",
            "sourceCode": "  let input = $context.$variables.ParticipantsCache \n  let participants = (typeof input === \"string\") ? JSON.parse(input) : input;\n\n  let uniqueOrgIds = [\n    ...new Set(\n      participants\n        .map(p => p.OrgId)\n        .filter(v => v !== undefined && v !== null)\n    )\n  ];\n\nvar output = {\n  numberOfOrgIds: uniqueOrgIds.length,\n  orgIds: uniqueOrgIds.join(\",\")\n};\n\nreturn output;"
          },
          "outcomes": {
            "success": "1773955682793"
          },
          "code": "GET_DISTINCT_ORGS_JS",
