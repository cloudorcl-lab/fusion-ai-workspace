                          },
                          "code": "BUILD_MISSING_ELIGIBLE_CAT_JS",
                          "id": "1773416557048",
                          "inputs": [],
                          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                          "type": "CODE"
                        },
                        {
                          "metadata": {
                            "name": "Build credited participant error JS",
                            "returnType": "object",
                            "sourceCode": "const participants = Array.isArray($context.$variables.ParticipantsCache)\n  ? $context.$variables.ParticipantsCache\n  : [];\n\nconst credit = $context.$nodes.FOR_EACH_TRANSACTION.FOR_EACH_CREDIT.$currentItem;\n\n// ensure errors array exists\nif (!Array.isArray(credit.errors)) credit.errors = [];\n\n// build list of valid participant names (max 10)\nconst names = participants.map(p => p?.ParticipantName).filter(Boolean);\n\nconst first10 = names.slice(0, 10);\nconst hasMoreThan10 = names.length > 10;\n\nconst validNamesText = first10.length\n  ? first10.join(\", \") + (hasMoreThan10 ? \" (showing first 10 only)\" : \"\")\n  : \"(no valid participants available)\";\n\ncredit.errors.push(\n  `Selected participant is invalid. Valid participants: ${validNamesText}`\n);\n\nconst transactionRequiredFields = [];\n\nreturn { credit, transactionRequiredFields };"
                          },
                          "outcomes": {
                            "success": "end_1773175666784"
                          },
                          "code": "BUILD_CREDITED_PARTICIPANT_ERROR_JS",
                          "id": "1773176647211",
                          "inputs": [],
                          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                          "type": "CODE"
                        },
                        {
                          "metadata": {
                            "name": "Skip validated credit JS",
                            "returnType": "object",
                            "sourceCode": "const credit = $context.$nodes.FOR_EACH_TRANSACTION.FOR_EACH_CREDIT.$currentItem;\n\nconst response =\n  $context.$nodes.FOR_EACH_TRANSACTION.FOR_EACH_CREDIT\n    .GET_REQUIRED_FIELDS_FOR_VALIDATED_CREDIT_BO.$output;\n\nconst items = Array.isArray(response?.items) ? response.items : [];\n\n// Keep ONLY required transaction fields\nlet txnItems = items.filter(r => r?.EntityName === \"CN_TP_TRANSACTIONS_ALL\");\n\n// Add common required txn fields if missing (same pattern as READ_REQUIRED_TXN_FIELDS_JS)\nconst ensureTxnField = (FieldName, FieldAlias, FieldType) => {\n  const exists = txnItems.some(\n    r => r?.EntityName === \"CN_TP_TRANSACTIONS_ALL\" && r?.FieldName === FieldName\n  );\n  if (!exists) {\n    txnItems.push({\n      FieldName,\n      EntityName: \"CN_TP_TRANSACTIONS_ALL\",\n      FieldAlias,\n      FieldType\n    });\n  }\n};\n\nensureTxnField(\"TRANSACTION_TYPE\", \"Transaction Type\", \"VARCHAR2\");\nensureTxnField(\"SOURCE_EVENT_DATE\", \"Source Event Date\", \"DATE\");\nensureTxnField(\"TRANSACTION_AMT_SOURCE_CURR\", \"Transaction Amount\", \"NUMBER\");\n\n// De-duplicate by EntityName + FieldName\nconst unique = new Map();\nfor (const r of txnItems) {\n  const key = `${r?.EntityName}|${r?.FieldName}`;\n  if (!unique.has(key)) {\n    unique.set(key, {\n      FieldName: r?.FieldName ?? null,\n      EntityName: r?.EntityName ?? \"CN_TP_TRANSACTIONS_ALL\",\n      FieldAlias: r?.FieldAlias ?? null,\n      FieldType: r?.FieldType ?? null\n    });\n  }\n}\n\nconst transactionRequiredFieldsBase = Array.from(unique.values());\n\n// ---- Enrich required fields using FieldsCache (same idea as READ_REQUIRED_TXN_FIELDS_JS) ----\nconst fieldsCache = Array.isArray($context.$variables.FieldsCache)\n  ? $context.$variables.FieldsCache\n  : [];\n\n// Build lookup: \"<entity>|<columnName>\" -> FieldsCache metadata needed downstream\nconst fcLookup = new Map();\nfor (const f of fieldsCache) {\n  const key = `${f?.entity}|${f?.columnName}`;\n  if (!fcLookup.has(key)) {\n    fcLookup.set(key, {\n      isDFF: f?.isDFF ?? false,\n      name: f?.name ?? null,\n      lovAttributeMap: Array.isArray(f?.lovAttributeMap) ? f.lovAttributeMap[0] : null,\n      lovDisplayAttributes: Array.isArray(f?.lovDisplayAttributes) ? f.lovDisplayAttributes[0] : null,\n      lovResourcePath: Array.isArray(f?.lovResourcePath) ? f.lovResourcePath[0] : null\n    });\n  }\n}\n\nconst transactionRequiredFields = transactionRequiredFieldsBase.map(r => {\n  const key = `${r?.EntityName}|${r?.FieldName}`;\n  const fc = fcLookup.get(key) || {\n    isDFF: false,\n    name: null,\n    lovAttributeMap: null,\n    lovDisplayAttributes: null,\n    lovResourcePath: null\n  };\n\n  return {\n    ...r,\n    isDFF: fc.isDFF,\n    name: fc.name,\n    lovAttributeMap: fc.lovAttributeMap,\n    lovDisplayAttributes: fc.lovDisplayAttributes,\n    lovResourcePath: fc.lovResourcePath\n  };\n});\n\nreturn { credit, transactionRequiredFields };"
                          },
                          "outcomes": {
                            "success": "end_1773175666784"
                          },
                          "code": "SKIP_VALIDATED_CREDIT_JS",
