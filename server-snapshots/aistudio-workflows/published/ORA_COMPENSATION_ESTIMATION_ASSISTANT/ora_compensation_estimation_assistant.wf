        {
          "metadata": {
            "businessObjectCode": "ORA_CX_INCENTIVEC_ICCOMPENSATIONESTIMATIONS",
            "functionName": "getTransactionDFF",
            "name": "DFF Fields BO"
          },
          "outcomes": {
            "success": "1772659487818"
          },
          "code": "DFF_FIELDS_BO",
          "convergenceTargetId": "1773955799238",
          "id": "1772660773040",
          "inputs": [
            {
              "id": "1772660789692_1",
              "name": "OrgId",
              "type": "integer",
              "value": "{{$context.$variables.OrgId}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"attributes\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"properties\": {\n          \"name\": { \"type\": \"string\" },\n          \"type\": { \"type\": \"string\" },\n          \"title\": { \"type\": \"string\" },\n\n          \"properties\": {\n            \"type\": \"object\",\n            \"additionalProperties\": false,\n            \"properties\": {\n              \"DESCRIPTION\": { \"type\": \"string\" },\n              \"FND_ACFF_ColumnName\": { \"type\": \"string\" },\n              \"FND_ACFF_MaximumLength\": { \"type\": [\"string\", \"integer\"] },\n              \"FND_ACFF_Precision\": { \"type\": [\"string\", \"integer\"] },\n              \"FND_ACFF_Scale\": { \"type\": [\"string\", \"integer\"] },\n              \"TOOLTIP\": { \"type\": \"string\" }\n            },\n            \"required\": [\"FND_ACFF_ColumnName\"]\n          },\n\n          \"lov\": {\n            \"type\": \"object\",\n            \"additionalProperties\": false,\n            \"properties\": {\n              \"attributeMap\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"additionalProperties\": false,\n                  \"properties\": {\n                    \"source\": { \"type\": \"string\" },\n                    \"target\": { \"type\": \"string\" },\n                    \"derived\": { \"type\": \"boolean\" }\n                  },\n                  \"required\": [\"source\", \"target\"]\n                }\n              },\n              \"displayAttributes\": {\n                \"type\": \"array\",\n                \"items\": { \"type\": \"string\" }\n              },\n              \"lovResourcePath\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"additionalProperties\": false,\n                  \"properties\": {\n                    \"resource\": { \"type\": \"string\" },\n                    \"filter\": { \"type\": \"string\" }\n                  },\n                  \"required\": [\"resource\"]\n                }\n              }\n            },\n            \"required\": [\"attributeMap\", \"displayAttributes\", \"lovResourcePath\"]\n          }\n        },\n        \"required\": [\"name\", \"type\"]\n      }\n    }\n  },\n  \"required\": [\"attributes\"]\n}\n",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Read DFF Fields JS",
            "returnType": "object",
            "sourceCode": "const response = $context.$nodes.DFF_FIELDS_BO.$output;\nconst attrs = response.attributes || [];\n\n// Helper: only set the key if the value is not null/undefined\nconst setIfPresent = (obj, key, val) => {\n  if (val !== null && val !== undefined) obj[key] = val;\n};\n\n// Helper: only set array key if it's a non-empty array\nconst setIfNonEmptyArray = (obj, key, arr) => {\n  if (Array.isArray(arr) && arr.length > 0) obj[key] = arr;\n};\n\nconst flattenedAttributes = attrs\n  // keep only attributes with a non-empty FND_ACFF_ColumnName\n  .filter(a => {\n    const col = a?.properties?.FND_ACFF_ColumnName;\n    return col !== null && col !== undefined && String(col).trim() !== \"\";\n  })\n  .map(a => {\n    const p = a.properties || {};\n    const lov = a.lov || {};\n    const out = {};\n\n    // DFF-derived flag\n    out.isDFF = true;\n\n    // top-level fields\n    setIfPresent(out, \"name\", a.name);\n    setIfPresent(out, \"type\", a.type);\n    setIfPresent(out, \"title\", a.title);\n\n    // flattened \"properties\" fields\n    setIfPresent(out, \"description\", p.DESCRIPTION);\n\n    // will always be present due to the filter, but set it explicitly anyway\n    setIfPresent(out, \"columnName\", p.FND_ACFF_ColumnName);\n    setIfPresent(out, \"entity\", \"CN_TP_TRANSACTIONS_ALL\");\n    setIfPresent(out, \"maxLength\", p.FND_ACFF_MaximumLength);\n    setIfPresent(out, \"precision\", p.FND_ACFF_Precision);\n    setIfPresent(out, \"scale\", p.FND_ACFF_Scale);\n\n    // flattened lov fields (only include if present and non-empty)\n    setIfNonEmptyArray(out, \"lovAttributeMap\", lov.attributeMap);\n    setIfNonEmptyArray(out, \"lovDisplayAttributes\", lov.displayAttributes);\n    setIfNonEmptyArray(out, \"lovResourcePath\", lov.lovResourcePath);\n\n    return out;\n  });\n\nconst extraTxnAttributes = [\n  {\n    isDFF: false,\n    name: \"TransactionNumber\",\n    type: \"string\",\n    title: \"TransactionNumber\",\n    description: \"Transaction number\",\n    columnName: \"SOURCE_TRX_NUMBER\",\n    entity: \"CN_TP_TRANSACTIONS_ALL\",\n    precision: 30\n  },\n  {\n    isDFF: false,\n    name: \"TransactionType\",\n    type: \"string\",\n    title: \"TransactionType\",\n    description: \"The transaction type identifying the source of the transaction.\",\n    columnName: \"TRANSACTION_TYPE\",\n    entity: \"CN_TP_TRANSACTIONS_ALL\",\n    maxLength: \"30\",\n    precision: 30,\n    lovAttributeMap: [{ source: \"LookupCode\", target: \"TransactionType\" }],\n    lovDisplayAttributes: [\"Meaning\"],\n    lovResourcePath: [\n      {\n        resource: \"standardLookupsLOV\",\n        filter: \"?finder=LookupTypeFinder%3BLookupType%3DCN_TP_TRANSACTION_TYPE\"\n      }\n    ]\n  },\n  {\n    isDFF: false,\n    name: \"SourceEventDate\",\n    type: \"datetime\",\n    title: \"SourceEventDate\",\n    description: \"The date when transaction was processed.\",\n    columnName: \"SOURCE_EVENT_DATE\",\n    entity: \"CN_TP_TRANSACTIONS_ALL\"\n  },\n  {\n    isDFF: false,\n    name: \"TransactionAmountSource\",\n    type: \"number\",\n    title: \"TransactionAmountSource\",\n    description: \"Transaction amount in source currency\",\n    columnName: \"TRANSACTION_AMT_SOURCE_CURR\",\n    entity: \"CN_TP_TRANSACTIONS_ALL\"\n  },\n  {\n    isDFF: false,\n    name: \"SourceCurrencyCode\",\n    type: \"string\",\n    title: \"SourceCurrencyCode\",\n    description: \"Currency code in which the source amounts are specified.\",\n    columnName: \"SOURCE_CURRENCY_CODE\",\n    entity: \"CN_TP_TRANSACTIONS_ALL\",\n    maxLength: \"15\",\n    precision: 15,\n    lovAttributeMap: [{ source: \"CurrencyCode\", target: \"SourceCurrencyCode\" }],\n    lovDisplayAttributes: [\"CurrencyCode\", \"Name\"],\n    lovResourcePath: [{ resource: \"currenciesLOV\", filter: \"?finder=CurrencyCodeFinder\" }]\n  },\n  {\n    isDFF: false,\n    name: \"AdjustmentComments\",\n    type: \"string\",\n    title: \"AdjustmentComments\",\n    description: \"Reason for adjustment\",\n    columnName: \"ADJUSTMENT_COMMENTS\",\n    entity: \"CN_TP_TRANSACTIONS_ALL\",\n    precision: 1000\n  },\n  {\n    isDFF: false,\n    name: \"AdjustmentStatus\",\n    type: \"string\",\n    title: \"AdjustmentStatus\",\n    description: \"Adjustment status\",\n    columnName: \"ADJUSTMENT_STATUS\",\n    entity: \"CN_TP_TRANSACTIONS_ALL\",\n    precision: 30\n  },\n  {\n    isDFF: false,\n    name: \"BookedDate\",\n    type: \"datetime\",\n    title: \"BookedDate\",\n    description: \"Date order gets booked\",\n    columnName: \"BOOKED_DATE\",\n    entity: \"CN_TP_TRANSACTIONS_ALL\"\n  },\n  {\n    isDFF: false,\n    name: \"CreditDate\",\n    type: \"datetime\",\n    title: \"CreditDate\",\n    description: \"Date based on which crediting rule will be determined.\",\n    columnName: \"CREDIT_DATE\",\n    entity: \"CN_TP_TRANSACTIONS_ALL\"\n  },\n  {\n    isDFF: false,\n    name: \"DiscountPercentage\",\n    type: \"number\",\n    title: \"DiscountPercentage\",\n    description: \"Discount percentage, exposed in UI\",\n    columnName: \"DISCOUNT_PERCENTAGE\",\n    entity: \"CN_TP_TRANSACTIONS_ALL\"\n  },\n  {\n    isDFF: false,\n    name: \"EligibleCategoryId\",\n    type: \"integer\",\n    title: \"EligibleCategoryId\",\n    description: \"The unique identifier of the eligible credit category.\",\n    columnName: \"ELIGIBLE_CAT_ID\",\n    entity: \"CN_TP_TRANSACTIONS_ALL\",\n    precision: 18,\n    lovAttributeMap: [{ source: \"EligibleCategoryId\", target: \"EligibleCategoryId\" }],\n    lovDisplayAttributes: [\"EligibleCategoryName\"],\n    lovResourcePath: [{ resource: \"incentiveCompensationSalesrepEligibleCategoriesLOV\" }]\n  },\n  {\n    isDFF: false,\n    name: \"InvoiceDate\",\n    type: \"datetime\",\n    title: \"InvoiceDate\",\n    description: \"Invoice date\",\n    columnName: \"INVOICE_DATE\",\n    entity: \"CN_TP_TRANSACTIONS_ALL\"\n  },\n  {\n    isDFF: false,\n    name: \"InvoiceNumber\",\n    type: \"string\",\n    title: \"InvoiceNumber\",\n    description: \"Unique identifier for invoice\",\n    columnName: \"INVOICE_NUMBER\",\n    entity: \"CN_TP_TRANSACTIONS_ALL\",\n    precision: 30\n  },\n  {\n    isDFF: false,\n    name: \"MarginPercentage\",\n    type: \"number\",\n    title: \"MarginPercentage\",\n    description: \"Margin Percentage, exposed in UI\",\n    columnName: \"MARGIN_PERCENTAGE\",\n    entity: \"CN_TP_TRANSACTIONS_ALL\"\n  },\n  {\n    isDFF: false,\n    name: \"OrderNumber\",\n    type: \"string\",\n    title: \"OrderNumber\",\n    description: \"Unique identifier for order\",\n    columnName: \"ORDER_NUMBER\",\n    entity: \"CN_TP_TRANSACTIONS_ALL\",\n    precision: 30\n  },\n  {\n    isDFF: false,\n    name: \"ParticipantId\",\n    type: \"integer\",\n    title: \"ParticipantId\",\n    description: \"The unique identifier of the participant with whom the earnings are associated.\",\n    columnName: \"PARTICIPANT_ID\",\n    entity: \"CN_TP_TRANSACTIONS_ALL\",\n    precision: 18,\n    lovAttributeMap: [{ source: \"ParticipantId\", target: \"ParticipantId\" }],\n    lovDisplayAttributes: [\"ParticipantName\"],\n    lovResourcePath: [{ resource: \"incentiveCompensationSalesrepsLOV\" }]\n  },\n  {\n    isDFF: false,\n    name: \"AdjustmentReasonCode\",\n    type: \"string\",\n    title: \"AdjustmentReasonCode\",\n    description: \"Adjustment reason code\",\n    columnName: \"REASON_CODE\",\n    entity: \"CN_TP_TRANSACTIONS_ALL\",\n    maxLength: \"30\",\n    precision: 30,\n    lovAttributeMap: [{ source: \"LookupCode\", target: \"AdjustmentReasonCode\" }],\n    lovDisplayAttributes: [\"Meaning\"],\n    lovResourcePath: [\n      {\n        resource: \"standardLookupsLOV\",\n        filter: \"?finder=LookupTypeFinder%3BLookupType%3DCN_TP_ADJUSTMENT_REASON\"\n      }\n    ]\n  },\n  {\n    isDFF: false,\n    name: \"RollupDate\",\n    type: \"datetime\",\n    title: \"RollupDate\",\n    description: \"Date based on which rollup hierarchy will be determined\",\n    columnName: \"ROLLUP_DATE\",\n    entity: \"CN_TP_TRANSACTIONS_ALL\"\n  },\n  {\n    isDFF: false,\n    name: \"TerrId\",\n    type: \"integer\",\n    title: \"TerrId\",\n    description: \"Unique identifier of territory\",\n    columnName: \"TERR_ID\",\n    entity: \"CN_TP_TRANSACTIONS_ALL\",\n    precision: 18\n  },\n  {\n    isDFF: false,\n    name: \"TerrName\",\n    type: \"string\",\n    title: \"TerrName\",\n    description: \"Territory name\",\n    columnName: \"TERR_NAME\",\n    entity: \"CN_TP_TRANSACTIONS_ALL\",\n    precision: 1000\n  },\n  {\n    isDFF: false,\n    name: \"TransactionQuantity\",\n    type: \"number\",\n    title: \"TransactionQuantity\",\n    description: \"The quantity of the unit sold in the transaction.\",\n    columnName: \"TRANSACTION_QTY\",\n    entity: \"CN_TP_TRANSACTIONS_ALL\"\n  },\n  {\n    isDFF: false,\n    name: \"UOMCode\",\n    type: \"string\",\n    title: \"UOMCode\",\n    description: \"Unit of Measure\",\n    columnName: \"UOM_CODE\",\n    entity: \"CN_TP_TRANSACTIONS_ALL\",\n    maxLength: \"10\",\n    precision: 10,\n    lovAttributeMap: [{ source: \"LookupCode\", target: \"UOMCode\" }],\n    lovDisplayAttributes: [\"Meaning\"],\n    lovResourcePath: [\n      {\n        resource: \"standardLookupsLOV\",\n        filter: \"?finder=LookupTypeFinder%3BLookupType%3DORA_CN_TP_TRANSACTION_UOM\"\n      }\n    ]\n  }\n];\n\nconst extraCreditAttributes = [\n  {\n    isDFF: false,\n    name: \"AdjustmentComments\",\n    type: \"string\",\n    title: \"AdjustmentComments\",\n    description: \"Reason for adjustment\",\n    columnName: \"ADJUSTMENT_COMMENTS\",\n    entity: \"CN_TP_CREDITS_ALL\",\n    precision: 1000\n  },\n  {\n    isDFF: false,\n    name: \"AdjustmentStatus\",\n    type: \"string\",\n    title: \"AdjustmentStatus\",\n    description: \"Adjustment status\",\n    columnName: \"ADJUSTMENT_STATUS\",\n    entity: \"CN_TP_CREDITS_ALL\",\n    precision: 30\n  },\n  {\n    isDFF: false,\n    name: \"CollectionStatus\",\n    type: \"string\",\n    title: \"CollectionStatus\",\n    description: \"Collection status of the transaction\",\n    columnName: \"COLLECTION_STATUS\",\n    entity: \"CN_TP_CREDITS_ALL\",\n    precision: 30\n  },\n  {\n    isDFF: false,\n    name: \"CreditAmountCalculation\",\n    type: \"number\",\n    title: \"CreditAmountCalculation\",\n    description: \"Credit amount in calculation currency\",\n    columnName: \"CREDIT_AMT_CALC_CURR\",\n    entity: \"CN_TP_CREDITS_ALL\"\n  },\n  {\n    isDFF: false,\n    name: \"CreditDate\",\n    type: \"datetime\",\n    title: \"CreditDate\",\n    description: \"Date based on which crediting rule will be determined.\",\n    columnName: \"CREDIT_DATE\",\n    entity: \"CN_TP_CREDITS_ALL\"\n  },\n  {\n    isDFF: false,\n    name: \"CreditType\",\n    type: \"string\",\n    title: \"CreditType\",\n    description: \"Possible values: Direct, Indirect, and Summarized\",\n    columnName: \"CREDIT_TYPE\",\n    entity: \"CN_TP_CREDITS_ALL\",\n    maxLength: \"30\",\n    precision: 30,\n    lovAttributeMap: [{ source: \"LookupCode\", target: \"CreditType\" }],\n    lovDisplayAttributes: [\"Meaning\"],\n    lovResourcePath: [\n      {\n        resource: \"standardLookupsLOV\",\n        filter: \"?finder=LookupTypeFinder%3BLookupType%3DCN_TP_CREDIT_TYPE\"\n      }\n    ]\n  },\n  {\n    isDFF: false,\n    name: \"CreditedParticipantId\",\n    type: \"integer\",\n    title: \"CreditedParticipantId\",\n    description: \"Unique identifier for credited sales rep\",\n    columnName: \"CREDITED_PARTICIPANT_ID\",\n    entity: \"CN_TP_CREDITS_ALL\",\n    precision: 18,\n    lovAttributeMap: [{ source: \"ParticipantId\", target: \"CreditedParticipantId\" }],\n    lovDisplayAttributes: [\"ParticipantName\"],\n    lovResourcePath: [{ resource: \"incentiveCompensationSalesrepsLOV\" }]\n  },\n  {\n    isDFF: false,\n    name: \"EligibleCategoryId\",\n    type: \"integer\",\n    title: \"EligibleCategoryId\",\n    description: \"The unique identifier of the eligible credit category.\",\n    columnName: \"ELIGIBLE_CAT_ID\",\n    entity: \"CN_TP_CREDITS_ALL\",\n    precision: 18,\n    lovAttributeMap: [{ source: \"EligibleCategoryId\", target: \"EligibleCategoryId\" }],\n    lovDisplayAttributes: [\"EligibleCategoryName\"],\n    lovResourcePath: [{ resource: \"incentiveCompensationSalesrepEligibleCategoriesLOV\" }]\n  },\n  {\n    isDFF: false,\n    name: \"ParticipantId\",\n    type: \"integer\",\n    title: \"ParticipantId\",\n    description: \"The unique identifier of the participant with whom the earnings are associated.\",\n    columnName: \"PARTICIPANT_ID\",\n    entity: \"CN_TP_CREDITS_ALL\",\n    precision: 18,\n    lovAttributeMap: [{ source: \"ParticipantId\", target: \"ParticipantId\" }],\n    lovDisplayAttributes: [\"ParticipantName\"],\n    lovResourcePath: [{ resource: \"incentiveCompensationSalesrepsLOV\" }]\n  },\n  {\n    isDFF: false,\n    name: \"AdjustmentReasonCode\",\n    type: \"string\",\n    title: \"AdjustmentReasonCode\",\n    description: \"Adjustment reason code\",\n    columnName: \"REASON_CODE\",\n    entity: \"CN_TP_CREDITS_ALL\",\n    maxLength: \"30\",\n    precision: 30,\n    lovAttributeMap: [{ source: \"LookupCode\", target: \"AdjustmentReasonCode\" }],\n    lovDisplayAttributes: [\"Meaning\"],\n    lovResourcePath: [\n      {\n        resource: \"standardLookupsLOV\",\n        filter: \"?finder=LookupTypeFinder%3BLookupType%3DCN_TP_ADJUSTMENT_REASON\"\n      }\n    ]\n  },\n  {\n    isDFF: false,\n    name: \"RevenueType\",\n    type: \"string\",\n    title: \"RevenueType\",\n    description: \"The possible values are revenue, nonrevenue, and custom revenue types.\",\n    columnName: \"REVENUE_TYPE\",\n    entity: \"CN_TP_CREDITS_ALL\",\n    maxLength: \"30\",\n    precision: 30,\n    lovAttributeMap: [{ source: \"LookupCode\", target: \"RevenueType\" }],\n    lovDisplayAttributes: [\"Meaning\"],\n    lovResourcePath: [\n      {\n        resource: \"standardLookupsLOV\",\n        filter: \"?finder=LookupTypeFinder%3BLookupType%3DCN_RS_REVENUE_TYPE\"\n      }\n    ]\n  },\n  {\n    isDFF: false,\n    name: \"RollupDate\",\n    type: \"datetime\",\n    title: \"RollupDate\",\n    description: \"Date based on which rollup hierarchy will be determined\",\n    columnName: \"ROLLUP_DATE\",\n    entity: \"CN_TP_CREDITS_ALL\"\n  },\n  {\n    isDFF: false,\n    name: \"RollupLevel\",\n    type: \"integer\",\n    title: \"RollupLevel\",\n    description: \"Level in the hierarchy in case of rollup credits\",\n    columnName: \"ROLLUP_LEVEL\",\n    entity: \"CN_TP_CREDITS_ALL\",\n    precision: 18\n  },\n  {\n    isDFF: false,\n    name: \"SourceCurrencyCode\",\n    type: \"string\",\n    title: \"SourceCurrencyCode\",\n    description: \"Currency code in which the source amounts are specified.\",\n    columnName: \"SOURCE_CURRENCY_CODE\",\n    entity: \"CN_TP_CREDITS_ALL\",\n    maxLength: \"15\",\n    precision: 15,\n    lovAttributeMap: [{ source: \"CurrencyCode\", target: \"SourceCurrencyCode\" }],\n    lovDisplayAttributes: [\"CurrencyCode\", \"Name\"],\n    lovResourcePath: [{ resource: \"currenciesLOV\", filter: \"?finder=CurrencyCodeFinder\" }]\n  },\n  {\n    isDFF: false,\n    name: \"SourceEventDate\",\n    type: \"datetime\",\n    title: \"SourceEventDate\",\n    description: \"The date when transaction was processed.\",\n    columnName: \"SOURCE_EVENT_DATE\",\n    entity: \"CN_TP_CREDITS_ALL\"\n  },\n  {\n    isDFF: false,\n    name: \"SplitPct\",\n    type: \"number\",\n    title: \"SplitPct\",\n    description: \"Split percentage\",\n    columnName: \"SPLIT_PCT\",\n    entity: \"CN_TP_CREDITS_ALL\"\n  }\n];\n\nconst merged = [\n  ...flattenedAttributes,\n  ...extraTxnAttributes,\n  ...extraCreditAttributes\n];\n\nreturn JSON.stringify(merged);"
          },
          "outcomes": {
