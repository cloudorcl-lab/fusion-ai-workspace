          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Generate simulation payload",
            "returnType": "string",
            "sourceCode": "const summary = $context.$variables.SimulationSummary;\nconst orgId = String($context.$variables.OrgId);\n\nconst transactionsPayload = (summary.transactions || []).map(txn => {\n  const txnObj = {};\n  const dffObj = {};\n\n  // Transaction required fields only\n  const txnFields = (txn.populatedFields || []).filter(pf => pf && pf.required === true);\n\n  for (const pf of txnFields) {\n    if (pf.isDFF === true) dffObj[pf.name] = pf.value;\n    else txnObj[pf.name] = pf.value;\n  }\n\n  // Credits (required fields only)\n  const creditsPayload = (txn.credits || []).map(cr => {\n    const crObj = {};\n    const crFields = (cr.populatedFields || []).filter(pf => pf && pf.required === true);\n\n    for (const pf of crFields) {\n      crObj[pf.name] = pf.value;\n    }\n    return crObj;\n  });\n\n  if (creditsPayload.length) txnObj.Credits = creditsPayload;\n  if (Object.keys(dffObj).length) txnObj.SimulationTransactionDFF = [dffObj];\n\n  return txnObj;\n});\n\nconst payload = {\n  SimulationType: \"ORA_CN_ESTIMATION_LIMITED\",\n  OrgId: orgId,\n  ProcessingStatus: \"ORA_CN_READY\",\n  Transactions: transactionsPayload\n};\n\nreturn JSON.stringify(payload);"
          },
          "outcomes": {
            "success": "1773929843575"
          },
          "code": "GENERATE_SIMULATION_PAYLOAD",
          "id": "1773810165354",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
