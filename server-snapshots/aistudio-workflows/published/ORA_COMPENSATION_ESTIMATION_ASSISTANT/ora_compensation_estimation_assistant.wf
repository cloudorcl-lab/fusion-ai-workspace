          "code": "IF_SIMULATION_IS_READY",
          "convergenceTargetId": "1773982192688",
          "id": "1773807539813",
          "inputs": [
            {
              "id": "1773807539815_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.CHECK_ALL_TXNS_ARE_VALIDATED_JS.$output.result}}"
