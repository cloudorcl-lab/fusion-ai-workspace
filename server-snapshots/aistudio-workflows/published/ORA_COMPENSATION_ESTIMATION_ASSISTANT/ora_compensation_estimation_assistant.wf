          "code": "SUBMIT_ESTIMATION_BO",
          "id": "1773929843575",
          "inputs": [
            {
              "id": "1773929863700_1",
              "name": "Payload",
              "type": "string",
              "value": "{{$context.$nodes.GENERATE_SIMULATION_PAYLOAD.$output.result}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"type\": \"object\",\n  \"additionalProperties\": true,\n  \"properties\": {\n    \"SimulationId\": { \"type\": \"integer\" },\n    \"CreatedBy\": { \"type\": \"string\" },\n    \"CreationDate\": { \"type\": \"string\" },\n    \"LastUpdatedBy\": { \"type\": \"string\" },\n    \"LastUpdateDate\": { \"type\": \"string\" },\n    \"LastUpdateLogin\": { \"type\": \"string\" },\n    \"ProcessAuditId\": { \"type\": \"integer\" },\n    \"ProcessingDate\": { \"type\": \"string\" },\n    \"ProcessingStatus\": { \"type\": \"string\" },\n    \"ErrorCode\": { \"type\": [\"string\", \"null\"] },\n    \"SimulationType\": { \"type\": \"string\" },\n    \"CurrentEarningsSumCalculation\": { \"type\": \"number\" },\n    \"CurrentEarningsSumHome\": { \"type\": \"number\" },\n    \"GainSumCalculation\": { \"type\": \"number\" },\n    \"GainSumHome\": { \"type\": \"number\" },\n    \"CalculationCurrencyCode\": { \"type\": \"string\" },\n    \"HomeCurrencyCode\": { \"type\": \"string\" },\n    \"StartPayPeriodId\": { \"type\": \"integer\" },\n    \"EndPayPeriodId\": { \"type\": \"integer\" },\n    \"AsynchronousRequestId\": { \"type\": [\"integer\", \"string\", \"null\"] },\n    \"OrgId\": { \"type\": \"integer\" }\n  }\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Build incomplete simulation questions JS",
            "returnType": "string",
            "sourceCode": "const summary = $context.$variables.SimulationSummary;\nconst fieldsCache = Array.isArray($context.$variables.FieldsCache) ? $context.$variables.FieldsCache : [];\n\nconst MAX_LEN = 80;\n\nconst splitPascalCase = (s) =>\n  String(s || \"\").replace(/([a-z0-9])([A-Z])/g, \"$1 $2\");\n\nconst escapeHtml = (s) =>\n  String(s ?? \"\")\n    .replaceAll(\"&\", \"&amp;\")\n    .replaceAll(\"<\", \"<\")\n    .replaceAll(\">\", \">\");\n\nconst hasText = (v) => v !== null && v !== undefined && String(v).trim() !== \"\";\n\nconst truncate = (s) => {\n  const str = String(s ?? \"\").trim();\n  return str.length > MAX_LEN ? str.slice(0, MAX_LEN - 3) + \"...\" : str;\n};\n\nconst renderError = (msg) => {\n  const full = String(msg ?? \"\").trim();\n  if (full.length <= MAX_LEN) {\n    return escapeHtml(full);\n  }\n  const preview = truncate(full);\n  return (\n    `${escapeHtml(preview)} ` +\n    `<details>` +\n    `<summary style=\"cursor:pointer; font-size:12px; color:#555;\">More</summary>` +\n    `<div style=\"margin-top:6px; font-size:12px; color:#555; white-space:pre-wrap;\">${escapeHtml(full)}</div>` +\n    `</details>`\n  );\n};\n\n// Build lookup from FieldsCache: \"<entity>|<columnName>\" -> friendly label (title preferred)\nconst fcLookup = new Map();\nfor (const f of fieldsCache) {\n  const key = `${f?.entity}|${f?.columnName}`;\n  if (!fcLookup.has(key)) fcLookup.set(key, f?.title || f?.name || f?.columnName);\n}\n\nconst fieldLabel = (entityName, pf) => {\n  const db = String(pf?.dbColumn ?? \"\").trim();\n  if (entityName && db) {\n    const key = `${entityName}|${db}`;\n    const lbl = fcLookup.get(key);\n    if (hasText(lbl)) return splitPascalCase(String(lbl));\n  }\n  // Fallbacks if we can't resolve via FieldsCache\n  return splitPascalCase( pf?.name || pf?.dbColumn );\n};\n\nconst renderFieldErrorsAsBullets = (entityName, populatedFields) => {\n  const fields = Array.isArray(populatedFields) ? populatedFields : [];\n  let out = \"\";\n\n  for (const pf of fields) {\n    const errs = Array.isArray(pf?.errors) ? pf.errors.filter((e) => hasText(e)) : [];\n    if (errs.length === 0) continue;\n\n    const label = fieldLabel(entityName, pf);\n\n    // Show first error inline with the field, any additional errors as nested bullets\n    out += `<li><i>${escapeHtml(label)}</i>. ${renderError(errs[0])}</li>\\n`;\n\n    if (errs.length > 1) {\n      out += `<ul style=\"margin:6px 0 10px 18px; padding:0;\">\\n`;\n      for (let i = 1; i < errs.length; i++) {\n        out += `<li>${renderError(errs[i])}</li>\\n`;\n      }\n      out += `</ul>\\n`;\n    }\n  }\n\n  return out;\n};\n\nconst transactions = Array.isArray(summary?.transactions) ? summary.transactions : [];\n\nlet html = \"\";\nhtml += `<div>Please review the items below and provide the missing or corrected values.</div>\\n`;\n\nfor (let t = 0; t < transactions.length; t++) {\n  const txn = transactions[t];\n\n  const txnErrors = Array.isArray(txn?.errors) ? txn.errors.filter((e) => hasText(e)) : [];\n  const txnFieldHasErrors = (Array.isArray(txn?.populatedFields) ? txn.populatedFields : []).some(\n    (pf) => Array.isArray(pf?.errors) && pf.errors.some((e) => hasText(e))\n  );\n\n  const credits = Array.isArray(txn?.credits) ? txn.credits : [];\n  const creditHasErrors = credits.some(\n    (cr) =>\n      (Array.isArray(cr?.errors) && cr.errors.some((e) => hasText(e))) ||\n      (Array.isArray(cr?.populatedFields) &&\n        cr.populatedFields.some((pf) => Array.isArray(pf?.errors) && pf.errors.some((e) => hasText(e))))\n  );\n\n  // Only show transactions that have issues\n  if (txnErrors.length === 0 && !txnFieldHasErrors && !creditHasErrors) continue;\n\n  html += `<div style=\"margin-top:12px;\"><b>Transaction ${t + 1}</b></div>\\n`;\n\n  // One parent list for the transaction: include txn-level errors (if any) and field errors as bullets\n  html += `<ul style=\"margin:6px 0 10px 18px; padding:0;\">\\n`;\n  for (const e of txnErrors) {\n    html += `<li>${renderError(e)}</li>\\n`;\n  }\n  html += renderFieldErrorsAsBullets(\"CN_TP_TRANSACTIONS_ALL\", txn?.populatedFields);\n  html += `</ul>\\n`;\n\n  // Credits nested under the transaction\n  for (let c = 0; c < credits.length; c++) {\n    const cr = credits[c];\n\n    const crErrors = Array.isArray(cr?.errors) ? cr.errors.filter((e) => hasText(e)) : [];\n    const crFieldHasErrors = (Array.isArray(cr?.populatedFields) ? cr.populatedFields : []).some(\n      (pf) => Array.isArray(pf?.errors) && pf.errors.some((e) => hasText(e))\n    );\n\n    if (crErrors.length === 0 && !crFieldHasErrors) continue;\n\n    html += `<div style=\"margin-top:8px; margin-left:12px;\"><b>Credit ${c + 1}</b></div>\\n`;\n    html += `<ul style=\"margin:6px 0 10px 30px; padding:0;\">\\n`;\n\n    for (const e of crErrors) {\n      html += `<li>${renderError(e)}</li>\\n`;\n    }\n\n    html += renderFieldErrorsAsBullets(\"CN_TP_CREDITS_ALL\", cr?.populatedFields);\n    html += `</ul>\\n`;\n  }\n}\n\nhtml += `<div style=\"margin-top:12px;\">Reply with the updated values and I’ll re-run the estimate.</div>\\n`;\n\nreturn html.trim();"
          },
          "outcomes": {
