          "id": "1772743111451",
          "inputs": [
            {
              "id": "1772743120200",
              "name": "ChatHistory",
              "scope": "JOB",
              "type": "object",
              "value": "{{$context.$nodes.GET_USER_INPUT_JS.$output.result}}"
