                        {
                          "metadata": {
                            "name": "Read required txn fields JS",
                            "returnType": "object",
                            "sourceCode": "const response =\n  $context.$nodes.FOR_EACH_TRANSACTION.FOR_EACH_CREDIT.REQUIRED_TXN_FIELDS_BO.$output;\n\n//const items = response.items || [];\n// Filter out CREDIT_AMT_CALC_CURR for credits\nconst items = (response.items || []).filter(\n  r => !(r?.EntityName === \"CN_TP_CREDITS_ALL\" && r?.FieldName === \"CREDIT_AMT_CALC_CURR\")\n);\n\n// Add TRANSACTION_TYPE if missing\nconst hasTransactionType = items.some(\n  r => r?.EntityName === \"CN_TP_TRANSACTIONS_ALL\" && r?.FieldName === \"TRANSACTION_TYPE\"\n);\n\nif (!hasTransactionType) {\n  items.push({\n    FieldName: \"TRANSACTION_TYPE\",\n    EntityName: \"CN_TP_TRANSACTIONS_ALL\",\n    FieldAlias: \"Transaction Type\",\n    FieldType: \"VARCHAR2\"\n  });\n}\n\n// Add SOURCE_EVENT_DATE if missing\nconst hasSourceEventDate = items.some(\n  r => r?.EntityName === \"CN_TP_TRANSACTIONS_ALL\" && r?.FieldName === \"SOURCE_EVENT_DATE\"\n);\n\nif (!hasSourceEventDate) {\n  items.push({\n    FieldName: \"SOURCE_EVENT_DATE\",\n    EntityName: \"CN_TP_TRANSACTIONS_ALL\",\n    FieldAlias: \"Source Event Date\",\n    FieldType: \"DATE\"\n  });\n}\n\n// Add TRANSACTION_AMT_SOURCE_CURR if missing\nconst hasTxnAmt = items.some(\n  r => r?.EntityName === \"CN_TP_TRANSACTIONS_ALL\" && r?.FieldName === \"TRANSACTION_AMT_SOURCE_CURR\"\n);\n\nif (!hasTxnAmt) {\n  items.push({\n    FieldName: \"TRANSACTION_AMT_SOURCE_CURR\",\n    EntityName: \"CN_TP_TRANSACTIONS_ALL\",\n    FieldAlias: \"Transaction Amount\",\n    FieldType: \"NUMBER\"\n  });\n}\n\nconst fieldsCache = $context.$variables.FieldsCache;\n\n// Build a lookup: \"<entity>|<columnName>\" -> selected FieldsCache attributes\nconst fcLookup = new Map();\nfor (const f of fieldsCache) {\n  const key = `${f?.entity}|${f?.columnName}`;\n  fcLookup.set(key, {\n    isDFF: f?.isDFF ?? false,\n    name: f?.name ?? null,\n    lovAttributeMap: Array.isArray(f?.lovAttributeMap) ? f.lovAttributeMap[0] : null,\n    lovDisplayAttributes: Array.isArray(f?.lovDisplayAttributes) ? f.lovDisplayAttributes[0] : null,\n    lovResourcePath: Array.isArray(f?.lovResourcePath) ? f.lovResourcePath[0] : null\n  });\n}\n\nconst mapped = items.map(r => {\n  const key = `${r?.EntityName}|${r?.FieldName}`;\n  const fc = fcLookup.get(key) || {\n    isDFF: false,\n    name: null,\n    lovAttributeMap: null,\n    lovDisplayAttributes: null,\n    lovResourcePath: null\n  };\n\n  return {\n    FieldName: r?.FieldName ?? null,\n    EntityName: r?.EntityName ?? null,\n    FieldAlias: r?.FieldAlias ?? null,\n    FieldType: r?.FieldType ?? null,\n    isDFF: fc.isDFF,\n    name: fc.name,\n    lovAttributeMap: fc.lovAttributeMap,\n    lovDisplayAttributes: fc.lovDisplayAttributes,\n    lovResourcePath: fc.lovResourcePath\n  };\n});\n\nconst result = {\n  transactions: mapped.filter(x => x.EntityName === \"CN_TP_TRANSACTIONS_ALL\"),\n  credits: mapped.filter(x => x.EntityName === \"CN_TP_CREDITS_ALL\")\n};\n\nreturn result;"
                          },
                          "outcomes": {
                            "success": "1773429420508"
                          },
                          "code": "READ_REQUIRED_TXN_FIELDS_JS",
                          "id": "1773357828351",
                          "inputs": [],
                          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                          "type": "CODE"
                        },
                        {
                          "metadata": {
                            "name": "Mark credit validated JS",
                            "returnType": "object",
                            "sourceCode": "const credit =\n  $context.$nodes.FOR_EACH_TRANSACTION.FOR_EACH_CREDIT.MATCH_USER_INPUT_TO_CREDIT_FIELDS_LLM.$output;\n\n// Ensure credit.errors exists and we don't wipe existing errors\nif (!Array.isArray(credit.errors)) credit.errors = [];\n\n// Validate credit: all REQUIRED populated fields must be validated === true\nconst fields = Array.isArray(credit.populatedFields) ? credit.populatedFields : [];\nconst requiredFields = fields.filter(f => f && f.required === true);\ncredit.validated = requiredFields.every(f => f.validated === true);\n\nconst transactionRequiredFields =\n  $context.$nodes.FOR_EACH_TRANSACTION.FOR_EACH_CREDIT.READ_REQUIRED_TXN_FIELDS_JS.$output.result.transactions;\n\nreturn { credit, transactionRequiredFields };"
                          },
                          "outcomes": {
                            "success": "end_1773175666784"
                          },
                          "code": "MARK_CREDIT_VALIDATED_JS",
                          "convergenceTargetId": "1773358212370",
                          "id": "1773336014433",
                          "inputs": [],
                          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                          "type": "CODE"
                        },
                        {
                          "metadata": {
                            "name": "Build missing eligible cat JS",
                            "returnType": "object",
                            "sourceCode": "const credit =\n  $context.$nodes.FOR_EACH_TRANSACTION.FOR_EACH_CREDIT.MATCH_ELIGIBLE_CATEGORIES_LLM.$output;\n\nconst transactionRequiredFields = [];\n\nreturn { credit, transactionRequiredFields };"
                          },
