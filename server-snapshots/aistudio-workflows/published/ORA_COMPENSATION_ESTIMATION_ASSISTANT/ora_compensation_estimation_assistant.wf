            "name": "Read Participants JS",
            "returnType": "object",
            "sourceCode": "const response = $context.$nodes.FIND_PARTICIPANTS_BO.$output;\n\nconst result = (response.items || []).map(r => ({\n  ParticipantId: r.ParticipantId ?? null,\n  ParticipantName: r.ParticipantName ?? null,\n  ParticipantFirstName: r.ParticipantFirstName ?? null,\n  ParticipantLastName: r.ParticipantLastName ?? null,\n  EmailAddress: r.EmailAddress ?? null,\n  OrgId: r.OrgId ?? null\n}));\n\nreturn JSON.stringify(result);"
          },
