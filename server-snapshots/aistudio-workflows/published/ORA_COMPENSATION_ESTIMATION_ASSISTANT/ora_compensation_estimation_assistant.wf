        {
          "metadata": {
            "name": "Return complete result"
          },
          "outcomes": {},
          "code": "RETURN_COMPLETE_RESULT",
          "convergenceTargetId": "1773982192688",
          "id": "1773957297081",
          "inputs": [
            {
              "id": "1773957297089_1",
