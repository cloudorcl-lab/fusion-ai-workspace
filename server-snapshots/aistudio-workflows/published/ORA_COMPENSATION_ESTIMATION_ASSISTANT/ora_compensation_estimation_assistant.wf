                  "convergenceTargetId": "end_1773160387751",
                  "id": "1773162135537",
                  "inputs": [
                    {
                      "id": "1773162135540_1",
                      "name": "condition",
                      "type": "string",
                      "value": "{{$context.$nodes.FOR_EACH_TRANSACTION.$currentItem.validated}}"
                    }
                  ],
