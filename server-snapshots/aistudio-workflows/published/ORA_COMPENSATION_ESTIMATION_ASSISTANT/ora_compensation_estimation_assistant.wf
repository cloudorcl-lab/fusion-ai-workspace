        {
          "metadata": {
            "name": "Get user input JS",
            "returnType": "array",
            "sourceCode": "const safe = (v) => (v === null || v === undefined ? \"\" : String(v).trim());\n\n// ChatHistory is now an array of { role: \"user\"|\"assistant\", content: \"...\", timestamp?: \"...\" }\nconst prevHistory = Array.isArray($context.$variables.ChatHistory)\n  ? $context.$variables.ChatHistory\n  : [];\n\nconst nowIso = () => new Date().toISOString();\n\nconst msg = (role, content) => ({\n  role,\n  content: safe(content),\n  timestamp: nowIso()\n});\n\nlet assistantMsg = safe($context.$variables.LastAssistantMessage);;\nlet userMsg = safe($context.$system.$inputMessage);\n\n// Build the new messages to append (0, 1, or 2 items)\nconst toAppend = [];\nif (safe(assistantMsg)) toAppend.push(msg(\"assistant\", assistantMsg));\nif (safe(userMsg)) toAppend.push(msg(\"user\", userMsg));\n\n// If nothing new, return history unchanged\nif (toAppend.length === 0) return prevHistory;\n\n// Append and return updated array\nreturn prevHistory.concat(toAppend);"
          },
          "outcomes": {
            "success": "1772743111451"
          },
          "code": "GET_USER_INPUT_JS",
          "id": "1772742624346",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
