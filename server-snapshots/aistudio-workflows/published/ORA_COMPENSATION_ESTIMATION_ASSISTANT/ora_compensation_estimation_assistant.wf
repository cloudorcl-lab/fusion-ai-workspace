          "metadata": {
            "name": "Build initial clarifications JS",
            "returnType": "string",
            "sourceCode": "const feedback = $context.$nodes.INTENT_IDENTIFIER_LLM.$output.feedback || {};\n\nconst message = feedback.message || \"\";\nconst details = feedback.details || \"\";\n\n// If details is present, show it as a \"More information\" expandable section\nif (details && String(details).trim() !== \"\") {\n  return (\n    `${message}\\n\\n` +\n    `<details>\\n` +\n    `<summary><b>More information</b></summary>\\n` +\n    `<div style=\"margin-top:6px; white-space:pre-wrap;\">${details}</div>\\n` +\n    `</details>`\n  );\n}\n\nreturn message;"
          },
