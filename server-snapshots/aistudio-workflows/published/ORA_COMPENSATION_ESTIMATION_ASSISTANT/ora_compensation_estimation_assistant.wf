        {
          "metadata": {
            "name": "IF simulation executed fine"
          },
          "outcomes": {
            "true": "1773877019515",
            "false": "1773981993611"
          },
          "code": "IF_SIMULATION_EXECUTED_FINE",
          "convergenceTargetId": "1773982192688",
          "id": "1773867892267",
          "inputs": [
            {
              "id": "1773867892271_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.READ_SIMULATION_ID_JS.$output.result != null && $context.$nodes.SUBMIT_ESTIMATION_BO.$output.ProcessingStatus === \"ORA_CN_COMPLETE\"}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Display result JS",
            "returnType": "string",
            "sourceCode": "const overall = $context.$nodes.SUBMIT_ESTIMATION_BO.$output;\nconst summaryByPc = $context.$nodes.GET_SUMMARY_BY_PC_BO.$output;\nconst simSummary = $context.$variables.SimulationSummary;\nconst fieldsCache = Array.isArray($context.$variables.FieldsCache) ? $context.$variables.FieldsCache : [];\n\nconst splitPascalCase = (s) => String(s || \"\").replace(/([a-z0-9])([A-Z])/g, \"$1 $2\");\n\nconst fmt2 = (n) => {\n  const num = Number(n);\n  if (Number.isNaN(num)) return \"0.00\";\n  return num.toFixed(2);\n};\n\nconst hasValue = (v) => v !== null && v !== undefined && String(v).trim() !== \"\";\n\nconst formatValueForUi = (pf) => {\n  const v = pf?.value;\n  const uf = pf?.userFriendlyValue;\n\n  const vStr = v === null || v === undefined ? \"\" : String(v).trim();\n  const ufStr = uf === null || uf === undefined ? \"\" : String(uf).trim();\n\n  if (ufStr && vStr) {\n    const ufLower = ufStr.toLowerCase();\n    const vLower = vStr.toLowerCase();\n\n    // 1) Only casing differs\n    if (ufLower === vLower) return ufStr;\n\n    // 2) Substring check (either direction)\n    if (ufLower.includes(vLower) || vLower.includes(ufLower)) return ufStr;\n\n    // 3) Normalized string equality (remove whitespace + common punctuation)\n    const norm = (s) => s.toLowerCase().replace(/[\\s,()_\\-\\/\\\\]/g, \"\");\n    if (norm(ufStr) === norm(vStr)) return ufStr;\n\n    // 4) Numeric equivalence (covers currency/percent formatting too)\n    const toNumber = (s) => {\n      const cleaned = s\n        .replace(/[%$€£¥]/g, \"\")  // strip common symbols\n        .replace(/,/g, \"\")        // strip thousands separators\n        .trim();\n      if (!cleaned) return NaN;\n      return Number(cleaned);\n    };\n\n    const nUf = toNumber(ufStr);\n    const nV = toNumber(vStr);\n    if (Number.isFinite(nUf) && Number.isFinite(nV) && nUf === nV) return ufStr;\n\n    // Otherwise show both\n    return `${ufStr} <span style=\"font-size:12px; color:#777;\">(${vStr})</span>`;\n  }\n\n  return ufStr || vStr || \"\";\n};\n\n// Field label lookup from FieldsCache (uses title; fallback to name/dbColumn)\nconst fcLookup = new Map(); // \"<entity>|<columnName>\" -> title\nfor (const f of fieldsCache) {\n  const key = `${f.entity}|${f.columnName}`;\n  if (!fcLookup.has(key)) fcLookup.set(key, f.title || f.name || f.columnName);\n}\n\nconst fieldLabel = (entityName, pf) => {\n  const key = `${entityName}|${pf.dbColumn}`;\n  const raw = fcLookup.get(key) || pf.name || pf.dbColumn || \"Field\";\n  return splitPascalCase(raw);\n};\n\n// Shared section header style (for <summary>)\nconst sectionSummary = (title) =>\n  `<summary style=\"cursor:pointer; font-size:12px; color:#555;\"><b>${title}</b></summary>`;\n\n// ---------- Overall summary ----------\nconst currency = overall.HomeCurrencyCode || \"\";\nconst currentHome = fmt2(overall.CurrentEarningsSumHome);\n\nconst gainHomeNum = Number(overall.GainSumHome);\nconst gainHomeAbs = fmt2(Math.abs(gainHomeNum));\n\nconst gainLabel =\n  gainHomeNum < 0\n    ? `<b>Estimated decrease from this scenario</b>`\n    : `<b>Additional earnings from this scenario</b>`;\n\nconst gainValue =\n  gainHomeNum < 0\n    ? `<b>${gainHomeAbs} ${currency}</b>`\n    : `<b>${fmt2(overall.GainSumHome)} ${currency}</b>`;\n\nlet html = \"\";\n\n// IMPORTANT: keep <table>/<tr> at column 0 (no indentation) to avoid Markdown code blocks\nhtml += `<table style=\"border-collapse:collapse; width:100%; font-size:13px;\">\\n`;\nhtml += `<tbody>\\n`;\nhtml += `<tr>`;\nhtml += `<th style=\"text-align:left; padding:6px 8px; border-bottom:1px solid #ddd; font-size:14px;\">Estimated compensation summary</th>`;\nhtml += `<th style=\"text-align:right; padding:6px 8px; border-bottom:1px solid #ddd;\"></th>`;\nhtml += `</tr>\\n`;\nhtml += `<tr>`;\nhtml += `<td style=\"padding:6px 8px; border-bottom:1px solid #f0f0f0;\">Current earnings</td>`;\nhtml += `<td style=\"padding:6px 8px; text-align:right; border-bottom:1px solid #f0f0f0;\">${currentHome} ${currency}</td>`;\nhtml += `</tr>\\n`;\nhtml += `<tr>`;\nhtml += `<td style=\"padding:6px 8px;\">${gainLabel}</td>`;\nhtml += `<td style=\"padding:6px 8px; text-align:right;\">${gainValue}</td>`;\nhtml += `</tr>\\n`;\nhtml += `</tbody>\\n`;\nhtml += `</table>\\n`;\n\n// ---------- Breakdown by compensation plan (collapsed) ----------\nhtml += `<div style=\"margin-top:12px;\"></div>\\n`;\nhtml += `<details>\\n`;\nhtml += `${sectionSummary(\"Breakdown by compensation plan\")}\\n`;\nhtml += `<div style=\"margin-top:8px;\">\\n`;\n\nconst items = Array.isArray(summaryByPc?.items) ? summaryByPc.items : [];\nconst byPlan = new Map();\n\nfor (const it of items) {\n  const planName = it?.CompensationPlanDisplayName || it?.CompensationPlanName || \"Compensation plan\";\n  if (!byPlan.has(planName)) byPlan.set(planName, []);\n  byPlan.get(planName).push(it);\n}\n\nconst planNames = Array.from(byPlan.keys()).sort((a, b) => a.localeCompare(b));\n\nfor (const planName of planNames) {\n  const rows = byPlan.get(planName) || [];\n\n  rows.sort((a, b) => {\n    const aPc = (a?.PlanComponentDisplayName || a?.PlanComponentName || \"\").toString();\n    const bPc = (b?.PlanComponentDisplayName || b?.PlanComponentName || \"\").toString();\n    const cmpPc = aPc.localeCompare(bPc);\n    if (cmpPc !== 0) return cmpPc;\n\n    const aPp = (a?.PayPeriodName || \"\").toString();\n    const bPp = (b?.PayPeriodName || \"\").toString();\n    return aPp.localeCompare(bPp);\n  });\n\n  html += `<div style=\"margin-top:8px;\"><b>${planName}</b></div>\\n`;\n  html += `<table style=\"border-collapse:collapse; width:100%; font-size:13px; margin-top:6px;\">\\n`;\n  html += `<tbody>\\n`;\n  html += `<tr>`;\n  html += `<th style=\"text-align:left; padding:6px 8px; border-bottom:1px solid #ddd;\">Plan component</th>`;\n  html += `<th style=\"text-align:right; padding:6px 8px; border-bottom:1px solid #ddd;\">Current</th>`;\n  html += `<th style=\"text-align:right; padding:6px 8px; border-bottom:1px solid #ddd;\">Gain</th>`;\n  html += `</tr>\\n`;\n\n  for (const r of rows) {\n    const comp = r?.PlanComponentDisplayName || r?.PlanComponentName || \"Plan component\";\n    const payPeriod = r?.PayPeriodName || \"\";\n    const cur = fmt2(r?.CurrentEarningsSumHome);\n    const gain = fmt2(r?.GainSumHome);\n\n    html += `<tr>`;\n    html += `<td style=\"padding:6px 8px; border-bottom:1px solid #f0f0f0;\">${comp}<br/><span style=\"font-size:12px; color:#555;\">${payPeriod}</span></td>`;\n    html += `<td style=\"padding:6px 8px; text-align:right; border-bottom:1px solid #f0f0f0;\">${cur}</td>`;\n    html += `<td style=\"padding:6px 8px; text-align:right; border-bottom:1px solid #f0f0f0;\">${gain}</td>`;\n    html += `</tr>\\n`;\n  }\n\n  html += `</tbody>\\n</table>\\n`;\n}\n\nhtml += `</div>\\n`;\nhtml += `</details>\\n`;\n\n// ---------- Inputs used (collapsed) ----------\nconst transactions = Array.isArray(simSummary?.transactions) ? simSummary.transactions : [];\n\nhtml += `<div style=\"margin-top:12px;\"></div>\\n`;\nhtml += `<details>\\n`;\nhtml += `${sectionSummary(\"Inputs used for this estimate\")}\\n`;\nhtml += `<div style=\"margin-top:8px;\">\\n`;\n\ntransactions.forEach((txn, txnIdx) => {\n  const txnFields = Array.isArray(txn.populatedFields) ? txn.populatedFields : [];\n  const credits = Array.isArray(txn.credits) ? txn.credits : [];\n\n  const requiredTxn = txnFields.filter(\n    pf => pf && pf.required === true && hasValue(formatValueForUi(pf))\n  );\n\n  const ignoredTxn = txnFields.filter(\n    pf => pf && pf.required === false && hasValue(formatValueForUi(pf))\n  );\n\n  html += `<div style=\"margin-top:8px;\"><b>Transaction ${txnIdx + 1}</b></div>\\n`;\n\n  // Required transaction fields\n  html += `<table style=\"border-collapse:collapse; width:100%; font-size:13px; margin-top:6px;\">\\n`;\n  html += `<tbody>\\n`;\n  html += `<tr>`;\n  html += `<th style=\"text-align:left; padding:6px 8px; border-bottom:1px solid #ddd;\">Field</th>`;\n  html += `<th style=\"text-align:left; padding:6px 8px; border-bottom:1px solid #ddd;\">Value</th>`;\n  html += `</tr>\\n`;\n\n  if (requiredTxn.length === 0) {\n    html += `<tr><td style=\"padding:6px 8px; color:#555;\" colspan=\"2\">No required transaction fields were provided.</td></tr>\\n`;\n  } else {\n    for (const pf of requiredTxn) {\n      const label = fieldLabel(\"CN_TP_TRANSACTIONS_ALL\", pf);\n      html += `<tr>`;\n      html += `<td style=\"padding:6px 8px; border-bottom:1px solid #f0f0f0;\">${label}</td>`;\n      html += `<td style=\"padding:6px 8px; border-bottom:1px solid #f0f0f0;\">${formatValueForUi(pf)}</td>`;\n      html += `</tr>\\n`;\n    }\n  }\n\n  html += `</tbody>\\n</table>\\n`;\n\n  // Track not-required fields across txn + credits\n  let ignoredCombined = ignoredTxn.map(pf => ({ pf, entity: \"CN_TP_TRANSACTIONS_ALL\" }));\n\n  credits.forEach((cr, crIdx) => {\n    const crFields = Array.isArray(cr.populatedFields) ? cr.populatedFields : [];\n\n    const requiredCr = crFields.filter(\n      pf => pf && pf.required === true && hasValue(formatValueForUi(pf))\n    );\n\n    const ignoredCr = crFields.filter(\n      pf => pf && pf.required === false && hasValue(formatValueForUi(pf))\n    );\n\n    html += `<div style=\"margin-top:8px;\"><b>Credit ${crIdx + 1}</b></div>\\n`;\n    html += `<table style=\"border-collapse:collapse; width:100%; font-size:13px; margin-top:6px;\">\\n`;\n    html += `<tbody>\\n`;\n    html += `<tr>`;\n    html += `<th style=\"text-align:left; padding:6px 8px; border-bottom:1px solid #ddd;\">Field</th>`;\n    html += `<th style=\"text-align:left; padding:6px 8px; border-bottom:1px solid #ddd;\">Value</th>`;\n    html += `</tr>\\n`;\n\n    if (requiredCr.length === 0) {\n      html += `<tr><td style=\"padding:6px 8px; color:#555;\" colspan=\"2\">No required credit fields were provided.</td></tr>\\n`;\n    } else {\n      for (const pf of requiredCr) {\n        const label = fieldLabel(\"CN_TP_CREDITS_ALL\", pf);\n        html += `<tr>`;\n        html += `<td style=\"padding:6px 8px; border-bottom:1px solid #f0f0f0;\">${label}</td>`;\n        html += `<td style=\"padding:6px 8px; border-bottom:1px solid #f0f0f0;\">${formatValueForUi(pf)}</td>`;\n        html += `</tr>\\n`;\n      }\n    }\n\n    html += `</tbody>\\n</table>\\n`;\n\n    ignoredCombined = ignoredCombined.concat(ignoredCr.map(pf => ({ pf, entity: \"CN_TP_CREDITS_ALL\" })));\n  });\n\n  // Not required (ignored)\n  if (ignoredCombined.length > 0) {\n    html += `<div style=\"margin-top:10px; font-size:12px; color:#555;\"><b>Not required (ignored)</b></div>\\n`;\n    html += `<table style=\"border-collapse:collapse; width:100%; font-size:12px; margin-top:6px;\">\\n`;\n    html += `<tbody>\\n`;\n    html += `<tr>`;\n    html += `<th style=\"text-align:left; padding:6px 8px; border-bottom:1px solid #eee;\">Field</th>`;\n    html += `<th style=\"text-align:left; padding:6px 8px; border-bottom:1px solid #eee;\">Value</th>`;\n    html += `</tr>\\n`;\n\n    for (const x of ignoredCombined) {\n      const pf = x.pf;\n      const label = fieldLabel(x.entity, pf);\n      html += `<tr>`;\n      html += `<td style=\"padding:6px 8px; border-bottom:1px solid #f7f7f7;\">${label}</td>`;\n      html += `<td style=\"padding:6px 8px; border-bottom:1px solid #f7f7f7;\">${formatValueForUi(pf)}</td>`;\n      html += `</tr>\\n`;\n    }\n\n    html += `</tbody>\\n</table>\\n`;\n  }\n});\n\nhtml += `</div>\\n`;\nhtml += `</details>\\n`;\n\n// Next step\nhtml += `<br/>Let me know if you’d like to update this estimate or start a new one.`;\n\nreturn html.trim();"
          },
