          },
          "code": "BUILD_INITIAL_CLARIFICATIONS_JS",
          "id": "1773942449128",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Read chat history JS",
            "returnType": "string",
            "sourceCode": "const history = Array.isArray($context.$variables.ChatHistory)\n  ? $context.$variables.ChatHistory\n  : [];\n\nconst transcript = history\n  .map(m => `${m.role === \"user\" ? \"User\" : \"Assistant\"}: ${m.content}`)\n  .join(\"\\n\");\n\nreturn transcript;"
          },
          "outcomes": {
            "success": "1772746288714"
          },
          "code": "READ_CHAT_HISTORY_JS",
          "id": "1773945999200",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Build extract questions JS",
            "returnType": "string",
            "sourceCode": "const summary = $context.$variables.SimulationSummary;\nconst unused = Array.isArray(summary?.unusedData) ? summary.unusedData : [];\n\nconst safe = (v) => (v === null || v === undefined ? \"\" : String(v));\nconst escapeHtml = (s) =>\n  String(s)\n    .replaceAll(\"&\", \"&amp;\")\n    .replaceAll(\"<\", \"<\")\n    .replaceAll(\">\", \">\");\n\nconst hasText = (v) => safe(v).trim() !== \"\";\n\nif (unused.length === 0) {\n  return \"\";\n}\n\nlet html = \"\";\nhtml += `<div><b>I need a bit more information to continue.</b></div>\\n`;\nhtml += `<ol style=\"margin:6px 0 0 18px; padding:0;\">\\n`;\n\nfor (const item of unused) {\n  const problem = hasText(item?.problem) ? safe(item.problem).trim() : \"Please provide more information.\";\n  const value = safe(item?.value).trim();\n  const validValues = safe(item?.validValues).trim();\n\n  html += `<li style=\"margin:6px 0;\">${escapeHtml(problem)}`;\n\n  // Per-item expandable details (only when there's something useful to show)\n  if (hasText(value) || hasText(validValues)) {\n    html += `<details>\\n`;\n    html += `<summary style=\"cursor:pointer; font-size:12px; color:#555;\">More information</summary>\\n`;\n    html += `<div style=\"margin-top:6px; font-size:12px; color:#555; white-space:pre-wrap;\">`;\n\n    if (hasText(value)) {\n      html += `<b>Provided:</b> ${escapeHtml(value)}\\n`;\n    }\n    if (hasText(validValues)) {\n      html += `${hasText(value) ? `\\n` : ``}<b>Options:</b> ${escapeHtml(validValues)}`;\n    }\n\n    html += `</div>\\n`;\n    html += `</details>`;\n  }\n\n  html += `</li>\\n`;\n}\n\nhtml += `</ol>\\n`;\nhtml += `<div style=\"margin-top:10px;\">Reply with the missing or corrected values, and I’ll continue.</div>\\n`;\n\nreturn html.trim();"
          },
          "outcomes": {
            "success": "1773956896910"
          },
          "code": "BUILD_EXTRACT_QUESTIONS_JS",
          "id": "1773948628429",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
