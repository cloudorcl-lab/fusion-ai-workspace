                                  },
                                  "code": "RETURN_CREDIT_FIELD_WITH_NO_LOV",
                                  "id": "1773439633054",
                                  "inputs": [],
                                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                                  "type": "CODE"
                                },
                                {
                                  "metadata": {
                                    "name": "Build credit field LOV filter JS",
                                    "returnType": "string",
                                    "sourceCode": "const field = $context.$nodes.FOR_EACH_TRANSACTION.FOR_EACH_CREDIT.FOR_EACH_REQUIRED_CREDIT_FIELD.$currentItem;\n\nconst filter = field.lovResourcePath.filter || \"\";\nconst id = field.lovAttributeMap.source;\nconst label = field.lovDisplayAttributes;\n\nif (filter.trim() !== \"\") {\n  return `${filter}&onlyData=true&fields=${id},${label}&limit=1000`;\n}\n\nreturn `?onlyData=true&fields=${id},${label}&limit=1000`;"
                                  },
                                  "outcomes": {
                                    "success": "1773431833904"
                                  },
                                  "code": "BUILD_CREDIT_FIELD_LOV_FILTER_JS",
                                  "id": "1773796740267",
                                  "inputs": [],
                                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                                  "type": "CODE"
                                }
                              ],
                              "rootNode": "start_1773429420508"
                            },
                            "loopType": "PARALLEL",
                            "name": "For each required Credit field"
                          },
                          "outcomes": {
                            "success": "1773439981392"
                          },
                          "code": "FOR_EACH_REQUIRED_CREDIT_FIELD",
                          "id": "1773429420508",
                          "inputs": [
                            {
                              "id": "1773429420510_1",
                              "name": "collection",
                              "type": "string",
                              "value": "{{$context.$nodes.FOR_EACH_TRANSACTION.FOR_EACH_CREDIT.READ_REQUIRED_TXN_FIELDS_JS.$output.result.credits}}"
                            }
                          ],
                          "type": "LOOP"
                        },
                        {
                          "metadata": {
                            "modelConfiguration": {
                              "modelProperties": {
                                "k": 0,
                                "max_completion_tokens": 32000,
                                "reasoning_effort": "medium"
                              },
                              "code": "ORA_MODEL_CONFIG_PREMIUM_OPEN_AI_GPT_4_1_MINI",
                              "model": "OCI_GPT_5_MINI",
                              "modelName": "GPT-5 mini",
                              "provider": "CERT_PREMIUM"
                            },
                            "name": "Match user input to credit fields LLM"
                          },
                          "outcomes": {
                            "success": "1773336014433"
                          },
                          "code": "MATCH_USER_INPUT_TO_CREDIT_FIELDS_LLM",
                          "id": "1773439981392",
                          "inputs": [
                            {
                              "id": "1773439981394_1",
                              "name": "prompt",
                              "type": "string",
                              "value": "You are an LLM agent in an Oracle Fusion Incentive Compensation estimation workflow.\n\nTask\nUpdate ONE Credit object by aligning its populatedFields to the required credit fields:\n- mark each populated field as required or not required\n- validate required fields\n- add missing required fields\n- write errors only at the populatedFields item level\n\nInputs\n\nCredit to update:\n{{$context.$nodes.FOR_EACH_TRANSACTION.FOR_EACH_CREDIT.MATCH_ELIGIBLE_CATEGORIES_LLM.$output}}\n\nRequired credit fields list:\n{{$context.$nodes.FOR_EACH_TRANSACTION.FOR_EACH_CREDIT.FOR_EACH_REQUIRED_CREDIT_FIELD.$output}}\n\nRequired fields notes\nEach required field entry includes:\n- name (a field identifier; may be a friendly field name OR may be a DB-like name depending on upstream steps)\n- FieldName (DB column name; use as populatedFields[].dbColumn)\n- lovResourcePath (present when the field is LOV-controlled)\n- lovValues (array of { id, label } when available; may be empty even when lovResourcePath exists)\n\nOutput (STRICT)\n- Return ONLY the updated credit as valid JSON.\n- Do not output any extra text.\n- Do not add or modify credit.errors in this step (field-level errors only).\n\npopulatedFields item shape\nEach populatedFields item must have:\n- name\n- value\n- userFriendlyValue\n- dbColumn\n- validated (boolean)\n- required (boolean)\n- errors (array of strings)\n- isDFF (boolean, may be present; preserve if present)\n\nRules\n\n1) Prepare\n- Ensure credit.populatedFields exists as an array.\n- For every populatedFields item:\n  - ensure errors is an array\n  - ensure required is a boolean (you will set it)\n- Preserve isDFF:\n  - If populatedFields[i].isDFF is present, keep its value unchanged.\n  - Do not invent isDFF for fields where it is missing.\n\n2) How to identify whether a field is required (IMPORTANT)\nA populatedFields item is required=true if ANY of these is true:\nA) It matches a required field by DB column:\n   - pf.dbColumn is non-empty AND matches any req.FieldName (exact string match), OR\nB) It matches a required field by name:\n   - pf.name matches any req.name (exact string match), OR\nC) pf.name is \"EligibleCategoryId\", OR\nD) pf.name is \"CreditedParticipantId\"\n\nOtherwise required=false.\n\n3) Consolidate duplicates by dbColumn (IMPORTANT)\nIt is possible the credit already contains multiple populatedFields entries that represent the same required field (for example one entry has the value but a different name, and another entry was added later with name equal to the DB column and value null).\n- You must NOT leave multiple populatedFields entries with the same non-empty dbColumn.\n- If multiple entries share the same non-empty dbColumn:\n  - Keep exactly ONE “winner” entry:\n    - Prefer the entry that has a non-blank value; if multiple, prefer the one with validated=true; otherwise keep the first.\n  - Merge required/validation onto the winner (per rules below).\n  - Remove the other duplicates from populatedFields.\n\n4) Mark required vs not required\n- After applying the required matching in rule (2) and de-duplication in rule (3):\n  - For any populatedFields item that is NOT required:\n    - set validated=false\n    - keep value and userFriendlyValue as-is\n    - do not add new errors (keep existing errors as-is)\n\n5) Ensure required fields exist in populatedFields (match by dbColumn first)\nFor each required field definition (req):\n- First try to find an existing populatedFields item where pf.dbColumn == req.FieldName (primary match).\n- If not found, try to find an item where pf.name == req.name (secondary match). If found and its dbColumn is empty, set dbColumn = req.FieldName.\n- If still not found, add a new populatedFields item:\n  - name = req.name (if req.name is present/non-blank; otherwise name = req.FieldName)\n  - dbColumn = req.FieldName\n  - value = null\n  - userFriendlyValue = null\n  - required = true\n  - validated = false\n  - errors = [\"Missing required field.\"]\n  - Do not add isDFF unless it already exists (do not invent isDFF)\n\nAlso ensure these two required populatedFields entries exist even if they are not in the required list:\n- \"EligibleCategoryId\"\n- \"CreditedParticipantId\"\n\nFor each of these two:\n- If missing, add it with:\n  - name = the field name exactly (\"EligibleCategoryId\" or \"CreditedParticipantId\")\n  - dbColumn = \"\" (empty string) UNLESS you can find a matching req entry (by req.name) and then use req.FieldName\n  - value = null\n  - userFriendlyValue = null\n  - required = true\n  - validated = false\n  - errors = [\"Missing required field.\"]\n\n6) Validate required fields\nFor each required populatedFields item:\n- Find its matching req entry using this priority:\n  1) match by dbColumn == req.FieldName\n  2) else match by name == req.name\n- Then validate using these rules:\n\nA) LOV-controlled required fields\nTreat as LOV-controlled only when req entry exists AND req.lovResourcePath exists and is non-empty.\n- validated can be true ONLY if the value is mapped to one of the LOV entries in req.lovValues.\n\nIf req.lovValues is empty or missing:\n- If value is missing/blank:\n  - validated=false\n  - errors=[\"Missing required field.\"]\n- If value is present:\n  - validated=false\n  - errors=[\"Invalid value. Valid values are unavailable.\"]\n  - if userFriendlyValue is empty, set it to value\n\nIf req.lovValues is non-empty:\n- If value is missing/blank:\n  - validated=false\n  - errors must contain exactly one message listing all valid labels:\n    \"Missing required field. Valid values: <comma-separated labels>\"\n- Else try to match the provided value to EXACTLY ONE LOV entry:\n  - Accept either:\n    - exact id match, or\n    - an educated human-like match to the label (flexible semantic match allowed) ONLY when there is a single clear best match\n- If matched:\n  - value = matched.id\n  - userFriendlyValue = matched.label\n  - validated=true\n  - errors=[]\n- If not matched or ambiguous:\n  - validated=false\n  - if userFriendlyValue is empty, set it to value\n  - errors=[\"Invalid value. Valid values: <comma-separated labels>\"]\n\nB) Non-LOV required fields\nIf the field is not LOV-controlled (no req entry, or req.lovResourcePath is missing/empty):\n- If value is present (non-null and not blank):\n  - validated=true\n  - errors=[]\n  - if userFriendlyValue is empty, set it to value\n- Else:\n  - validated=false\n  - errors=[\"Missing required field.\"]\n\n7) No duplicates\n- Do not create multiple populatedFields entries with the same name. Always update the existing one.\n- Do not create or leave multiple populatedFields entries with the same non-empty dbColumn (see rule 3).\n\n8) Error placement\n- Write errors only to populatedFields[i].errors.\n- Do not write credit-level errors in this step.\n\nReturn the updated credit JSON."
                            }
                          ],
                          "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"Credit\",\n  \"type\": \"object\",\n  \"additionalProperties\": true,\n  \"required\": [\"populatedFields\", \"validated\", \"errors\"],\n  \"properties\": {\n    \"populatedFields\": { \"$ref\": \"#/$defs/populatedFields\" },\n    \"validated\": { \"type\": \"boolean\" },\n    \"errors\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" }\n    }\n  },\n  \"$defs\": {\n    \"populatedFields\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"name\", \"value\", \"dbColumn\", \"validated\", \"required\", \"errors\"],\n        \"properties\": {\n          \"name\": { \"type\": \"string\" },\n          \"value\": {},\n          \"userFriendlyValue\": {},\n          \"dbColumn\": { \"type\": \"string\" },\n          \"validated\": { \"type\": \"boolean\" },\n          \"required\": { \"type\": \"boolean\" },\n          \"errors\": {\n            \"type\": \"array\",\n            \"items\": { \"type\": \"string\" }\n          },\n          \"isDFF\": { \"type\": \"boolean\" }\n        }\n      }\n    }\n  }\n}",
                          "type": "LLM"
                        },
                        {
                          "metadata": {
                            "name": "Read elig cat JS",
                            "returnType": "object",
                            "sourceCode": "//Needed to add this because for some reason {{$context.$nodes.FOR_EACH_TRANSACTION.FOR_EACH_CREDIT.MATCH_ELIGIBLE_CATEGORIES_LLM.$output.EligibleCategoryId !=null }} does not work in the IF condition\n//return $context.$nodes.FOR_EACH_TRANSACTION.FOR_EACH_CREDIT.MATCH_ELIGIBLE_CATEGORIES_LLM.$output.EligibleCategoryId != null ;\n\nconst credit = $context.$nodes.FOR_EACH_TRANSACTION.FOR_EACH_CREDIT.MATCH_ELIGIBLE_CATEGORIES_LLM.$output;\nif (!credit || !Array.isArray(credit.populatedFields)) return null;\n\nfor (const f of credit.populatedFields) {\n  if (f && f.name === \"EligibleCategoryId\") {\n    return f.value ?? null;\n  }\n}\nreturn null;"
                          },
                          "outcomes": {
                            "success": "1773351733670"
                          },
                          "code": "READ_ELIG_CAT_JS",
                          "id": "1773780020492",
                          "inputs": [],
                          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                          "type": "CODE"
                        },
                        {
                          "metadata": {
                            "name": "Find credited participant JS",
                            "returnType": "number",
                            "sourceCode": "const participants = $context.$variables.ParticipantsCache || [];\nconst credit = $context.$nodes.FOR_EACH_TRANSACTION.FOR_EACH_CREDIT.$currentItem;\n\nconst pf = (credit.populatedFields || []).find(f => f?.name === \"CreditedParticipantId\");\nconst creditParticipantId = pf?.value;\n\nconst match = participants.find(p => String(p?.ParticipantId) === String(creditParticipantId));\nreturn match ? Number(match.ParticipantId) : null;"
                          },
                          "outcomes": {
                            "success": "1773422895071"
                          },
                          "code": "FIND_CREDITED_PARTICIPANT_JS",
