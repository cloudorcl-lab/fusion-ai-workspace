                                    "sourceCode": "const reqField =\n  $context.$nodes.FOR_EACH_TRANSACTION.FOR_EACH_CREDIT.FOR_EACH_REQUIRED_CREDIT_FIELD.$currentItem;\n\nreqField.lovValues = [];\n\nreturn reqField;"
                                  },
