            },
            {
              "id": "1762387808049_3",
              "name": "pQuery",
              "type": "string",
              "value": "{{$context.$nodes.MA_FETCH_RESERVATIONS_QUERY_GENERATOR.$output.result}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"ReservationId\": { \"type\": \"string\" },\n          \"InventoryItemId\": { \"type\": \"string\" },\n          \"ItemNumber\": { \"type\": \"string\" },\n          \"OrganizationId\": { \"type\": \"string\" },\n          \"OrganizationCode\": { \"type\": \"string\" },\n          \"DemandSourceTypeId\": { \"type\": \"string\" },\n          \"DemandSourceType\": { \"type\": \"string\" },\n          \"SupplySourceTypeId\": { \"type\": \"string\" },\n          \"SupplySourceType\": { \"type\": \"string\" },\n          \"DemandSourceHeaderId\": { \"type\": \"string\" },\n          \"DemandSourceHeaderNumber\": { \"type\": \"string\" },\n          \"DemandSourceLineId\": { \"type\": \"string\" },\n          \"DemandSourceLineNumber\": { \"type\": [\"string\", \"null\"] },\n          \"DemandSourceName\": { \"type\": [\"string\", \"null\"] },\n          \"SourceFulfillmentLineId\": { \"type\": [\"string\", \"null\"] },\n          \"DemandQuantity\": { \"type\": \"string\" },\n          \"DemandUOMCode\": { \"type\": \"string\" },\n          \"DemandUnitOfMeasure\": { \"type\": \"string\" },\n          \"SupplySourceHeaderId\": { \"type\": [\"string\", \"null\"] },\n          \"SupplySourceHeaderNumber\": { \"type\": [\"string\", \"null\"] },\n          \"SupplySourceLineId\": { \"type\": [\"string\", \"null\"] },\n          \"SupplySourceLineNumber\": { \"type\": [\"string\", \"null\"] },\n          \"ExpectedDate\": { \"type\": \"string\", \"format\": \"date\" },\n          \"Revision\": { \"type\": [\"string\", \"null\"] },\n          \"LotNumber\": { \"type\": [\"string\", \"null\"] },\n          \"SubinventoryCode\": { \"type\": [\"string\", \"null\"] },\n          \"SubinventoryName\": { \"type\": [\"string\", \"null\"] },\n          \"LocatorId\": { \"type\": [\"string\", \"null\"] },\n          \"LocatorName\": { \"type\": [\"string\", \"null\"] },\n          \"OperationSequenceNumber\": { \"type\": \"string\" },\n          \"MaterialSequenceNumber\": { \"type\": [\"string\", \"null\"] },\n          \"WorkOrderProductId\": { \"type\": \"string\" },\n          \"WorkOrderProductNumber\": { \"type\": \"string\" },\n          \"DemandProjectId\": { \"type\": [\"string\", \"null\"] },\n          \"DemandProjectNumber\": { \"type\": [\"string\", \"null\"] },\n          \"DemandTaskId\": { \"type\": [\"string\", \"null\"] },\n          \"DemandTaskNumber\": { \"type\": [\"string\", \"null\"] },\n          \"SupplyProjectId\": { \"type\": [\"string\", \"null\"] },\n          \"SupplyProjectNumber\": { \"type\": [\"string\", \"null\"] },\n          \"SupplyTaskId\": { \"type\": [\"string\", \"null\"] },\n          \"SupplyTaskNumber\": { \"type\": [\"string\", \"null\"] },\n          \"ShipToPartyId\": { \"type\": [\"string\", \"null\"] },\n          \"ShipToCustomer\": { \"type\": [\"string\", \"null\"] },\n          \"SupplierName\": { \"type\": [\"string\", \"null\"] },\n          \"RequirementDate\": { \"type\": \"string\", \"format\": \"date\" },\n          \"OrderInterfaceStatus\": { \"type\": \"string\" },\n          \"OrderInterfaceStatusMeaning\": { \"type\": \"string\" },\n          \"Staged\": { \"type\": [\"string\", \"null\"] },\n          \"StagedMeaning\": { \"type\": [\"string\", \"null\"] },\n          \"BackToBack\": { \"type\": [\"string\", \"null\"] },\n          \"BackToBackMeaning\": { \"type\": [\"string\", \"null\"] },\n          \"PrimaryReservationQuantity\": { \"type\": \"string\" },\n          \"PrimaryUOMCode\": { \"type\": \"string\" },\n          \"PrimaryUnitOfMeasure\": { \"type\": \"string\" },\n          \"SecondaryReservationQuantity\": { \"type\": [\"string\", \"null\"] },\n          \"SecondaryUOMCode\": { \"type\": [\"string\", \"null\"] },\n          \"SecondaryUnitOfMeasure\": { \"type\": [\"string\", \"null\"] },\n          \"ReservationQuantity\": { \"type\": \"string\" },\n          \"ReservationUOMCode\": { \"type\": \"string\" },\n          \"ReservationUnitOfMeasure\": { \"type\": \"string\" },\n          \"DetailedQuantity\": { \"type\": [\"string\", \"null\"] },\n          \"SerialReservationQuantity\": { \"type\": [\"string\", \"null\"] },\n          \"Grade\": { \"type\": [\"string\", \"null\"] },\n          \"@context\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"key\": { \"type\": \"string\" }\n            },\n            \"required\": [\"key\"]\n          }\n        }\n     }\n    }\n  },\n  \"required\": [\"items\"]\n}",
          "type": "BO_FUNCTION"
