                {
                  "metadata": {
                    "name": "Format Input Bulk Update",
                    "returnType": "object",
                    "sourceCode": "let supplyHeader = $context.$nodes.ITERATE_UPDATE_BULK_REQUEST.$currentItem?.SupplySourceHeaderNumber ?? \"\";\nif (supplyHeader) {\n  supplyHeader = \"'\" + supplyHeader + \"'\";\n}\nlet supplyLine = $context.$nodes.ITERATE_UPDATE_BULK_REQUEST.$currentItem?.SupplySourceLineNumber ?? \"\";\nif (supplyLine) {\n  supplyLine = \"'\" + supplyLine + \"'\";\n}\nreturn {\n  supplyHeader,\n  supplyLine\n}"
                  },
                  "outcomes": {
                    "success": "1773373442640"
                  },
                  "code": "FORMAT_INPUT_BULK_UPDATE",
                  "id": "1773436441340",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                }
