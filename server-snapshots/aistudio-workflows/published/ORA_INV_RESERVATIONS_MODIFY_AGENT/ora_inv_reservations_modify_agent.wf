            "loopType": "PARALLEL",
            "name": "MA Update Reservations Multiple Loop"
          },
          "outcomes": {
            "success": "1762456880980"
          },
          "code": "MA_UPDATE_RESERVATIONS_MULTIPLE_LOOP",
          "id": "1762542200652",
          "inputs": [
            {
              "id": "1762542200653_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$variables.Reservations}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "MA View Reservation"
          },
          "outcomes": {
            "success": "1763589118131"
          },
          "code": "MA_VIEW_RESERVATION",
          "id": "1762554803303",
          "inputs": [
            {
              "id": "1762554803304_1",
              "name": "prompt",
              "type": "string",
              "value": "The output must contain **only** HTML content without any markdown or descriptive text.\n---\n\n### Input Data\n**Table Data:**  \n`{{$context.$nodes.MA_FETCH_RESERVATIONS.$output.items}}`\n\n**Recommendations Data:**  \n`{{$context.$nodes.MA_VIEW_RESERVATIONS_NEXT_ACTIONS.$output.result}}`\n\n---\n\n### Row inclusion rule (mandatory)\n- **Include ONLY reservation rows that have a corresponding recommendation**.\n\n---\n\n### Output format (mandatory)\nRender **one** HTML table using the template below, with a **single “Supply Recommendation”** column.\n\n---\n\n## HTML Table Template (with conditional Supply Recommendation display)\n\n<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse: collapse; width: 100%;\">\n  <thead>\n    <tr>\n      <th>Reservation ID</th>\n      <th>Demand Header</th>\n      <!-- Conditional Demand Line Rendering\n        {#if (ne DemandSourceTypeId 5)}\n          <th>Demand Line</th>\n        {else}\n          <th>Operation Sequence Number</th>\n        {/if}\n      -->\n      <th>Demand Source Type</th>\n      <th>Quantity</th>\n      <th>UOM</th>\n      <th>Required Date</th>\n      <th>Item Number</th>\n      <th>Supply Recommendation</th>\n    </tr>\n  </thead>\n\n  <tbody>\n    <!-- Repeat this <tr> ONLY for rows that have corresponding recommendations -->\n    <tr>\n      <td>{ReservationId}</td>\n      <td>{DemandSourceHeaderNumber}</td>\n\n      <!-- CONDITIONAL DEMAND COLUMN -->\n      <!--\n      {#if (eq DemandSourceTypeId 5)}\n        <td>{OperationSequenceNumber}</td>\n      {else}\n        <td>{DemandSourceLineNumber}</td>\n      {/if}\n      -->\n\n      <td>{DemandSourceType}</td>\n      <td>{ReservationQuantity}</td>\n      <td>{PrimaryUnitOfMeasure}</td>\n      <td>{RequirementDate}</td>\n      <td>{ItemNumber}</td>\n      <!-- Supply Recommendation (single column) -->\n      <td>\n        <!-- Always show supply type -->\n<div><b>Type:</b> {SupplySourceType extract from mapping of SupplySourceTypeId}</div>\n\n        <!-- Show Header ONLY when supply is NOT Onhand AND SupplySourceTypeId != 13 -->\n        <!--\n        {#if (and (ne SupplySourceType \"Onhand\") (ne SupplySourceTypeId 13))}\n          <div><b>Header:</b> {SupplySourceHeaderNumber}</div>\n\n          <!-- Show Line ONLY when also SupplySourceTypeId != 5 -->\n          {#if (ne SupplySourceTypeId 5)}\n            <div><b>Line:</b> {SupplySourceLineNumber}</div>\n          {/if}\n        {/if}\n        -->\n\n        <!-- <div><b>Delivery Date:</b> {ExpectedDeliveryDate}</div> -->\n      </td>\n\n    </tr>\n  </tbody>\n</table>\n\n<h5>Recommendations</h5>\n<ul>\n  <!-- Render the matched recommendation(s) for the included reservations.\n       If recommendations are global strings, list them all here. -->\n  <li>{RecommendationText}</li>\n</ul>"
            },
            {
              "id": "1762554803305_2",
              "name": "temperature",
              "type": "number"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "MA View Reservations Next Actions",
            "returnType": "object",
            "sourceCode": "const response = $context.$nodes.MA_FETCH_RESERVATIONS.$output.items;\nconst requirementDate = $context.$variables.RequirementDate;\nlet nextActions = [\n\"Refine search\",\n  \"Get lines for document {number}\",\n  \"Delete reservation for {document/line}\",\n  \"Update supply source\",\n\"Create new reservation\",\n\"Return to home\"\n];\n\nconst suggestions = $context.$nodes.FITLER_SUGGESTIONS.$output?.result ?? [];\nif (($context.$variables.PastDue || $context.$variables.FindRunningLateReservations) && suggestions.length > 0) {\n  return suggestions;\n}\n\nreturn nextActions"
          },
          "outcomes": {
            "success": "1762554803303"
          },
          "code": "MA_VIEW_RESERVATIONS_NEXT_ACTIONS",
          "id": "1763160631956",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "MA format deletion confirmation",
            "returnType": "string",
            "sourceCode": "let response = $context.$variables.Reservations;\nif ( $context.$variables.DemandSourceType === 'User defined') {\n    response = response.map((item) => {\n        return \"DemandSourceName: \" + item.DemandSourceName + \", ReservationQuantity: \" + item.ReservationQuantity;\n    });\n} else {\n    response = response.map((item) => {\n        return \"DemandSourceHeaderNumber: \" + item.DemandSourceHeaderNumber + \", DemandSourceLineNumber: \" + item.DemandSourceLineNumber + \", ReservationQuantity: \" + item.ReservationQuantity;\n    });\n}\nconst output = response.join('\\n');\nreturn output;"
          },
          "outcomes": {
            "success": "1762387027153"
          },
          "code": "MA_FORMAT_DELETION_CONFIRMATION",
          "id": "1763495254632",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "MA Delete formatter",
            "returnType": "string",
            "sourceCode": "let response = $context.$nodes.MA_DELETION_LOOP.$output;\nconst nextActions = [\n\"Refine search\",\n  \"Create a new reservation for this line?\",\n  \"View reservations\",\n\"Return to home\"\n];\nlet failed = [];\nif (Array.isArray(response)) {\n    response = response.map((item) => {\n        try {\n            return JSON.parse(item).result;\n        } catch (error) {\n            let failure = item?.toString() || \"\";\n            failed.push(failure);\n            return failure;\n        }\n    }).join(\"\\n\");\n}  else {\n    response = \"\";\n}\nconst output = {\n    \"data\": response,\n    \"status\": \"success\",\n    \"error\": failed.join(\"\\n\"),\n    \"formatted\": true,\n    \"header\": \"Reservation Deletion\",\nnextActions\n}\nreturn output;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "MA_DELETE_FORMATTER",
          "id": "1763511757365",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
