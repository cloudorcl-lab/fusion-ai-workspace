        {
          "metadata": {
            "businessObjectCode": "ORA_SCM_INVENTORYM_RESERVATIONDETA",
            "functionName": "getall_inventoryReservationDetails",
            "name": "MA Fetch Reservations"
          },
          "outcomes": {
