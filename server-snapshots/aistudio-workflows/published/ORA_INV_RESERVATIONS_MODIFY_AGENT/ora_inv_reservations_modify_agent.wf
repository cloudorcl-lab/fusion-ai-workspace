        {
          "metadata": {
            "name": "MA Fetch Reservations Query Generator",
            "returnType": "string",
            "sourceCode": "const OrganizationId = $context.$variables.OrganizationId;\nconst InventoryItemId = $context.$variables.InventoryItemId;\nconst DemandSourceHeaderNumber = $context.$variables.DemandSourceHeaderNumber;\nconst DemandSourceTypeId = $context.$variables.DemandSourceTypeId;\nconst ReservationId = $context.$variables.ReservationId;\nconst RequirementDate = $context.$variables.RequirementDate;\nconst RunningLateFlag = $context.$variables.FindRunningLateReservations;\nconst PastDueFlag = $context.$variables.PastDue;\n\nlet filters = []\nlet query=\"\";\nif (OrganizationId !== null && OrganizationId !== \"\") {\n    filters.push('OrganizationId=' + OrganizationId);\n}\nif (InventoryItemId !== null && InventoryItemId !== \"\" && Number.isInteger(InventoryItemId)) {\n    filters.push('InventoryItemId=' + InventoryItemId);\n}\nif (DemandSourceTypeId !== null && DemandSourceTypeId !== \"\") {\n    filters.push('DemandSourceTypeId=' + DemandSourceTypeId);\n}\nif (DemandSourceHeaderNumber !== null && DemandSourceHeaderNumber !== \"\") {\n    filters.push(\"DemandSourceHeaderNumber='\" + DemandSourceHeaderNumber + \"'\");\n}\nif (ReservationId !== null && ReservationId !== \"\") {\n    filters.push('ReservationId='+ReservationId);\n}\nif (PastDueFlag && RequirementDate != null && RequirementDate != \"\") {\n  filters.push(\"RequirementDate<\" + \"'\" + RequirementDate + \"'\");\n}\nif (PastDueFlag) {\n  // Ignore on hand supply reservations when querying for past due date reservations.\n  filters.push(\"SupplySourceTypeId!=13\");\n}\n\nquery=filters.join(\" and \");\n\nif (RunningLateFlag != null && RunningLateFlag) {\n  query=query+\"&finder=findPastDue\"\n}\nreturn query;"
          },
          "outcomes": {
            "success": "1762387790021"
          },
          "code": "MA_FETCH_RESERVATIONS_QUERY_GENERATOR",
          "id": "1762194599023",
          "inputs": [],
          "type": "CODE"
        },
        {
