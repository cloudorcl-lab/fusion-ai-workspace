                  "metadata": {
                    "name": "MA Delete Response Checker",
                    "returnType": "string",
                    "sourceCode": "const response = $context.$nodes.MA_DELETION_LOOP.MA_DELETE_RESERVATION_BO.$output;\nif (response === undefined)  {\n    return \"Successfully deleted line:\" + $context.$nodes.MA_DELETION_LOOP.$currentItem.DemandSourceLineNumber + \" of demand document:\" + $context.$nodes.MA_DELETION_LOOP.$currentItem.DemandSourceHeaderNumber + \" with ReservationId: \" + $context.$nodes.MA_DELETION_LOOP.$currentItem.ReservationId ;\n}\nreturn \"Failed to delete line:\" + $context.$nodes.MA_DELETION_LOOP.$currentItem.DemandSourceLineNumber + \" of demand document:\" + $context.$nodes.MA_DELETION_LOOP.$currentItem.DemandSourceHeaderNumber + \" with ReservationId: \" + $context.$nodes.MA_DELETION_LOOP.$currentItem.ReservationId ;"
                  },
                  "outcomes": {
                    "success": "end_1762387027153"
                  },
                  "code": "MA_DELETE_RESPONSE_CHECKER",
                  "id": "1763498738615",
