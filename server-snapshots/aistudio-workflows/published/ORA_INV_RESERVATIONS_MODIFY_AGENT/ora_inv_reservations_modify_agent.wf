                    "returnType": "string",
                    "sourceCode": "return \"Update Reservation \" +  $context.$nodes.MA_UPDATE_RESERVATIONS_MULTIPLE_LOOP.$currentItem.ReservationId + \" for \"+ $context.$nodes.MA_UPDATE_RESERVATIONS_MULTIPLE_LOOP.$currentItem.DemandSourceType + \" \" + $context.$nodes.MA_UPDATE_RESERVATIONS_MULTIPLE_LOOP.$currentItem.DemandSourceHeaderNumber + \" from organization \" + $context.$nodes.MA_UPDATE_RESERVATIONS_MULTIPLE_LOOP.$currentItem.OrganizationId +  \" with Quantity:(insert quantity here)\";"
                  },
