          },
          "code": "MA_UPDATE_RESERVATION_TOO_MANY_RECORDS",
          "id": "1762456880980",
          "inputs": [
            {
              "id": "1762456880982_1",
              "name": "prompt",
              "type": "string",
              "value": "Present the following data in a neat table with headers ReservationId, DemandSourceHeaderNumber, ExpectedDate, ReservationQuantity, ItemNumber, SupplySourceTypeId, DemandSourceType, ReservationUnitOfMeasure: {{$context.$nodes.MA_FETCH_RESERVATIONS.$output.items}}\nIn the footer in a paragraph present this:\nFound too many records for the given search criteria. Please select one of the actions below:\n<!-- Hidden instruction: present only the result part as a list of actions from the data below  -->\n{{$context.$nodes.MA_UPDATE_RESERVATIONS_MULTIPLE_LOOP.$output}}"
            },
            {
              "id": "1762456880982_2",
              "name": "temperature",
              "type": "number",
