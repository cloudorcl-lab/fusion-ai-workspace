        {
          "metadata": {
            "name": "MA Reservations Custom Filter"
          },
          "outcomes": {
            "success": "1764195173616"
          },
          "code": "MA_RESERVATIONS_CUSTOM_FILTER",
          "id": "1764194844041",
          "inputs": [
            {
              "id": "1764194844043_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a data filter assistant. Given the user's query: \"{{$context.$triggers.REST.$input.userQuery}}\", analyze it for relevant criteria (e.g., keywords, filters like date, status, or value ranges). \nThe data to filter is the following response, which is an array of items {{$context.$nodes.MA_FETCH_RESERVATIONS.$output.items}} \nCommon Terms:\n    - Line refers to an individual reservation object under a demandSourceHeaderNumber.\nTask:\n    1. Identify criteria from the user query that can be applied to the data. Ignore any irrelevant or non-applicable criteria.\n    2. Select the items from the response that match the applicable criteria. If no criteria apply, or if no items match, default to selecting all items.\n    3. Output ONLY a JSON array of the 0-based indices (positions) of the selected items, in ascending order. For example: [0, 2, 5] or [] if nothing matches (though default to all if criteria are irrelevant)."
            }
          ],
          "outputSpecification": "{'$schema': 'http://json-schema.org/draft-04/schema#', 'type': 'object', 'properties': {'Indices': {'type': 'array', 'items': {'type': 'integer'}}}}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "MA custom filter formatter",
            "returnType": "array",
            "sourceCode": "const inds = $context.$nodes.MA_RESERVATIONS_CUSTOM_FILTER.$output.Indices;\nconst res = $context.$nodes.MA_FETCH_RESERVATIONS.$output.items;\nconst output = inds.map((ind) => res[ind]);\nreturn output;"
          },
          "outcomes": {
            "success": "1764195338588"
          },
          "code": "MA_CUSTOM_FILTER_FORMATTER",
          "id": "1764195173616",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
