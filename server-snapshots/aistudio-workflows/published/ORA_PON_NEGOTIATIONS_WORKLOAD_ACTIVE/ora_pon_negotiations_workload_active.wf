          "type": "ADD"
        },
        {
          "metadata": {
            "name": "Simplify Active Data",
            "returnType": "object",
            "sourceCode": "const rawList =  $context.$nodes.GET_ACTIVE_NEGOTIATIONS.$output.items &&  $context.$nodes.GET_ACTIVE_NEGOTIATIONS.$output.items ?  $context.$nodes.GET_ACTIVE_NEGOTIATIONS.$output.items : ( $context.$nodes.GET_ACTIVE_NEGOTIATIONS.$output.items || []);\n\nconst result = rawList.reduce((acc, item) => {\n\n    const created = new Date(item.CloseDate);\n    const now = new Date(item.CurrentDateTime);\n    const diffInMs = created - now;\n    const diffInDays = (diffInMs / (1000 * 60 * 60 * 24)).toFixed(3);\n    \n    if (!acc.seenIds.has(item.AuctionHeaderId) && diffInDays>=0 &&  diffInDays <= 5.000) { \n        acc.seenIds.add(item.AuctionHeaderId);\n\n   \n\n        acc.uniqueList.push({\n             AuctionHeaderId: item.AuctionHeaderId,\n             NegotiationStatus: item.NegotiationStatusCode,\n             BadgeText: item.NegotiationStatus,\n             DifferenceInDays: diffInDays,\n             ProcurementBU: item.ProcurementBU,\n             TimeRemaining: item.TimeRemaining,\n             NegotiationTitle: item.NegotiationType + ' '+ item.Negotiation+ ' - '+ (item.NegotiationTitle || \" \"),\n             BuyerName: item.Buyer || \" \"\n        });\n    }\n\n    return acc;\n\n}, { seenIds: new Set(), uniqueList: [] }); \n\nlet obj= {\n    NegotiationsList: result.uniqueList,\n    NegotiationsCount: result.uniqueList.length\n\n  };\n\n \n  return obj;"
          },
          "outcomes": {
            "success": "1770997745871"
          },
          "code": "SIMPLIFY_ACTIVE_DATA",
          "id": "1770945056666",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Simplify Paused Data",
            "returnType": "object",
            "sourceCode": "const rawList =  $context.$nodes.GET_PAUSED_NEGOTIATIONS.$output.items &&  $context.$nodes.GET_PAUSED_NEGOTIATIONS.$output.items ?  $context.$nodes.GET_PAUSED_NEGOTIATIONS.$output.items : ( $context.$nodes.GET_PAUSED_NEGOTIATIONS.$output.items || []);\n\nconst result = rawList.reduce((acc, item) => {\n    \n    if (!acc.seenIds.has(item.AuctionHeaderId)) { \n        acc.seenIds.add(item.AuctionHeaderId);\n\n        const created = new Date(item.CloseDate);\n        const now = new Date(item.CurrentDateTime);\n        const diffInMs = created - now;\n        const diffInDays = diffInMs / (1000 * 60 * 60 * 24);\n\n        acc.uniqueList.push({\n             AuctionHeaderId: item.AuctionHeaderId,\n             NegotiationStatus: item.NegotiationStatusCode,\n             BadgeText: item.NegotiationStatus,\n             DifferenceInDays: diffInDays.toFixed(3),\n             ProcurementBU: item.ProcurementBU,\n             TimeRemaining: item.TimeRemaining,\n             NegotiationTitle: item.NegotiationType + ' '+ item.Negotiation+ ' - '+ (item.NegotiationTitle || \" \"),\n             BuyerName: item.Buyer || \" \"\n        });\n    }\n\n    return acc;\n\n}, { seenIds: new Set(), uniqueList: [] }); \n\nlet obj= {\n    NegotiationsList: result.uniqueList,\n    NegotiationsCount: result.uniqueList.length\n\n  };\n\n \n  return obj;"
          },
          "outcomes": {
            "success": "1770997745871"
          },
          "code": "SIMPLIFY_PAUSED_DATA",
          "id": "1770945088283",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Merged Negotiations Lists",
            "returnType": "object",
            "sourceCode": "const sources = [\n    $context.$nodes.SIMPLIFY_ACTIVE_DATA.$output.result,\n   $context.$nodes.SIMPLIFY_PAUSED_DATA.$output.result\n];\n\nconst result = sources.reduce((acc, sourceObj) => {\n    \n    const currentList = sourceObj.NegotiationsList || [];\n\n    currentList.forEach(item => {\n        if (item.AuctionHeaderId && !acc.seenIds.has(item.AuctionHeaderId)) {\n            acc.seenIds.add(item.AuctionHeaderId);\n            acc.mergedList.push(item);\n        }\n    });\n\n    return acc;\n\n}, { seenIds: new Set(), mergedList: [] });\n\nlet obj = {\n    NegotiationsList: result.mergedList,\n    NegotiationsCount: result.mergedList.length\n};\nreturn obj ;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "MERGED_NEGOTIATIONS_LISTS",
