          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"AuctionHeaderId\": { \"type\": \"number\" },\n          \"Negotiation\":     { \"type\": \"number\" },\n          \"NegotiationTitle\": { \"type\": \"string\" },\n          \"NegotiationStatus\": { \"type\": \"string\" },\n          \"NegotiationStatusCode\": { \"type\": \"string\" },\n          \"OpenDate\": { \"type\": \"string\" },\n          \"CloseDate\": { \"type\": \"string\" },\n          \"TimeRemaining\": { \"type\": \"string\" },\n          \"SuppliersCount\": { \"type\": \"number\" },\n          \"SupplierResponses\": { \"type\": \"number\" },\n          \"ProcurementBUId\": { \"type\": \"number\" },\n          \"ProcurementBU\": { \"type\": \"string\" },\n          \"BuyerId\": { \"type\": \"number\" },\n          \"Buyer\": { \"type\": \"string\" }\n        },\n        \"required\": [\n          \"AuctionHeaderId\",\n          \"Negotiation\",\n          \"NegotiationTitle\",\n          \"NegotiationStatus\",\n          \"NegotiationStatusCode\",\n          \"OpenDate\",\n          \"CloseDate\",\n          \"TimeRemaining\",\n          \"SuppliersCount\",\n          \"SupplierResponses\",\n          \"ProcurementBUId\",\n          \"ProcurementBU\",\n          \"BuyerId\",\n          \"Buyer\"\n        ]\n      }\n    }\n  },\n  \"required\": [\"items\"]\n}",
