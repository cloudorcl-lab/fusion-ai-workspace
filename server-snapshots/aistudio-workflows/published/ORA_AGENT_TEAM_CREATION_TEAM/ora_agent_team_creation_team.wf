        {
          "metadata": {
            "name": "return workflow",
            "returnType": "object",
            "sourceCode": "const workflow = $context.$nodes.CREATE_WORKFLOW2 && $context.$nodes.CREATE_WORKFLOW2.$output ? $context.$nodes.CREATE_WORKFLOW2.$output : $context.$nodes.CREATE_WORKFLOW_WORKFLOW.$output ;\nif (!workflow) {\n   return {\"Error\": $context.$nodes.CREATE_WORKFLOW2.$error|| $context.$nodes.CREATE_WORKFLOW_WORKFLOW.$error, \"isError\": \"true\"};\n}\nconst obj =  {\n  \"Name\": workflow.Name,\n  \"WorkflowId\": workflow.WorkflowId,\n  \"WorkflowCode\": workflow.WorkflowCode\n};\nreturn obj;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "RETURN_WORKFLOW_",
          "id": "1764620463507",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Remap Agent Codes",
            "returnType": "object",
            "sourceCode": "if ( !$context.$triggers.REST.$input.agentTeam || !$context.$triggers.REST.$input.agentTeam.Specification \n  || !$context.$triggers.REST.$input.agentTeam.Specification.dataPipeline || !$context.$triggers.REST.$input.agentTeam.Specification.dataPipeline.pipelineNodes ) {\n  return {};\n}\nconst agentIds = [];\nconst test = [];\nconst agents = $context.$triggers.REST.$input.agents ;\nconst oldAgentCodeToNew = {};\n($context.$nodes.FOREACH_AGENTS.$output || []).forEach((output, index) => {\n  const parsedOutput = output ?  JSON.parse(output)  : {};\n  if (parsedOutput && parsedOutput.output ) {\n    const res = JSON.parse(parsedOutput.output );\n    if (res && res.result && res.result.AgentCode && res.result.AgentCode !== agents[index].AgentCode) {\n      oldAgentCodeToNew[agents[index].AgentCode] =  res.result.AgentCode;\n    }\n  }\n});\nconst pipelineNodes = $context.$triggers.REST.$input.agentTeam.Specification.dataPipeline.pipelineNodes;\n(pipelineNodes|| []).forEach((node, index) => {\n  if (node && node.metadata && node.metadata.agentCode && oldAgentCodeToNew[node.metadata.agentCode]) {\n    node.metadata.agentCode =  oldAgentCodeToNew[node.metadata.agentCode];\n  }\n});\nconst spec = $context.$triggers.REST.$input.agentTeam.Specification;\nspec.dataPipeline.pipelineNodes = pipelineNodes;\nreturn spec;"
          },
