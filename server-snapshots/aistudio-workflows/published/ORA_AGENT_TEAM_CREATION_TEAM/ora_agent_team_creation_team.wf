          "metadata": {
            "name": "processAgentWorkflowMappings",
            "returnType": "array",
            "sourceCode": "const agentIds = [];\nconst test = [];\n($context.$nodes.FOREACH_AGENTS.$output || []).forEach((output) => {\n  const parsedOutput = output && output.length > 0 ?  JSON.parse(output)  : {};\n  if (parsedOutput && parsedOutput.output &&  parsedOutput.output.length) {\n    const res = JSON.parse(parsedOutput.output );\n    if (res && res.result && res.result.AgentId) {\n      agentIds.push({ \"AgentId\": res.result.AgentId, \"AgentTargetId\": res.result.AgentId});\n    }\n  }\n});\nreturn agentIds;"
          },
          "outcomes": {
            "success": "1764705217310"
          },
          "code": "SETTEAMS",
          "id": "1763758019230",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
