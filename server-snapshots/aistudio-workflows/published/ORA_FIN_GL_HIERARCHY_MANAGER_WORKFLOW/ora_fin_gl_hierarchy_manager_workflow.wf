        {
          "metadata": {
            "name": "Prepare User Preferences Payload",
            "returnType": "object",
            "sourceCode": "var buildCtx = $context.$nodes.FIN_GL_CODE_BUILD_CONTEXT && $context.$nodes.FIN_GL_CODE_BUILD_CONTEXT.$output && $context.$nodes.FIN_GL_CODE_BUILD_CONTEXT.$output.result ? $context.$nodes.FIN_GL_CODE_BUILD_CONTEXT.$output.result : {};\nvar resolvedCtx = $context.$nodes.FIN_GL_CODE_RESOLVE_INTENT_CONTEXT && $context.$nodes.FIN_GL_CODE_RESOLVE_INTENT_CONTEXT.$output && $context.$nodes.FIN_GL_CODE_RESOLVE_INTENT_CONTEXT.$output.result ? $context.$nodes.FIN_GL_CODE_RESOLVE_INTENT_CONTEXT.$output.result : {};\nvar ctx = { ...buildCtx, ...resolvedCtx };\n\nvar requestedSegments = Array.isArray(ctx.requestedSegments) ? ctx.requestedSegments : [];\nvar segmentDimensionByCode = {};\n(Array.isArray(buildCtx.segments) ? buildCtx.segments : []).forEach(function(segment) {\n  if (segment && segment.segmentCode && segment.dimensionName) {\n    segmentDimensionByCode[segment.segmentCode] = segment.dimensionName;\n  }\n});\nvar segmentsParam = requestedSegments\n  .map(function(segment) { return segment && segmentDimensionByCode[segment.segmentCode]; })\n  .filter(Boolean)\n  .join(\",\");\n\nvar payload = {\n  chartOfAccountsId: String(ctx.chartOfAccountsId !== undefined && ctx.chartOfAccountsId !== null ? ctx.chartOfAccountsId : \"0\"),\n  segments: segmentsParam\n};\n\nreturn payload;"
