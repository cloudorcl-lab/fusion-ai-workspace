        {
          "metadata": {
            "name": "Build Preferences Options Response",
            "returnType": "object",
            "sourceCode": "const buildCtx = $context.$nodes.FIN_GL_CODE_BUILD_CONTEXT.$output.result || {};\nconst resolvedCtx = $context.$nodes.FIN_GL_CODE_RESOLVE_INTENT_CONTEXT?.$output?.result || {};\nconst ctx = { ...buildCtx, ...resolvedCtx };\nconst actionCase = ctx.actionCase || ctx.deterministicCase || \"outOfScope\";\nconst requestType = ctx.requestType || (actionCase === \"change\" ? \"change\" : \"list\");\nconst activeOnly = ctx.activeOnly === true || ctx.activeOnly === \"true\" ? \"true\" : \"false\";\nconst requestedSegments = Array.isArray(ctx.requestedSegments) ? ctx.requestedSegments : [];\nconst requestedSegmentCodes = requestedSegments\n  .map((segment) => segment && segment.segmentCode)\n  .filter(Boolean);\nconst hierarchyState = { ...(ctx.hierarchyState || {}) };\n\nconst overridesToMap = (value) => {\n  const map = {};\n  if (Array.isArray(value)) {\n    for (const item of value) {\n      const segmentCode = item?.segmentCode;\n      const treeVersionName = item?.treeVersionName;\n      if (segmentCode && treeVersionName) map[segmentCode] = treeVersionName;\n    }\n  } else if (value && typeof value === \"object\") {\n    for (const [segmentCode, treeVersionName] of Object.entries(value)) {\n      if (segmentCode && treeVersionName) map[segmentCode] = treeVersionName;\n    }\n  }\n  return map;\n};\n\nconst mapToOverridesArray = (map) => Object.entries(map || {})\n  .filter(([segmentCode, treeVersionName]) => segmentCode && treeVersionName)\n  .map(([segmentCode, treeVersionName]) => ({ segmentCode, treeVersionName }));\n\nhierarchyState.hierarchyOverrides = mapToOverridesArray(overridesToMap(hierarchyState.hierarchyOverrides));\nhierarchyState.pendingOptionsBySegment = {};\nhierarchyState.pendingSelections = {};\n\nlet display = [];\nconst sourceResponse = $context.$nodes.FIN_GL_BO_FUNCTION_GET_USER_PREFERENCES?.$output;\n\nconst response = sourceResponse?.response || sourceResponse?.result?.response || sourceResponse?.result || sourceResponse || {};\nif (Array.isArray(response.display)) {\n  display = response.display;\n} else if (Array.isArray(response?.data?.display)) {\n  display = response.data.display;\n}\n\nconst selectionContext = response?.selectionContext || response?.data?.selectionContext || {};\nconst options = Array.isArray(selectionContext.options) ? selectionContext.options : [];\nconst segmentsByDimension = Object.fromEntries((ctx.segments || []).map((segment) => [segment.dimensionName, segment]));\nconst segmentsByCode = Object.fromEntries((ctx.segments || []).map((segment) => [segment.segmentCode, segment]));\nconst onlyRequestedSegment = requestedSegmentCodes.length === 1 ? segmentsByCode[requestedSegmentCodes[0]] : null;\n\nif (Array.isArray(options)) {\n  for (const option of options) {\n    const dimensionName = option?.dimensionName || option?.requestedDimension || option?.segment || option?.dimension || \"\";\n    let segment = segmentsByDimension[dimensionName] || segmentsByCode[option?.segmentCode];\n    if (!segment && onlyRequestedSegment) {\n      segment = onlyRequestedSegment;\n    }\n    if (!segment) continue;\n    const segmentCode = segment.segmentCode;\n    if (!Array.isArray(hierarchyState.pendingOptionsBySegment[segmentCode])) {\n      hierarchyState.pendingOptionsBySegment[segmentCode] = [];\n    }\n    const treeVersionName = String(option?.treeVersionName || option?.treeVersion || \"\").trim();\n    if (!treeVersionName) continue;\n    const sr = option?.sr || hierarchyState.pendingOptionsBySegment[segmentCode].length + 1;\n    hierarchyState.pendingOptionsBySegment[segmentCode].push({ sr, treeVersionName });\n  }\n}\n\nconst selectedHierarchy = selectionContext?.selectedHierarchy;\nconst selectedTreeVersionName = selectedHierarchy?.treeVersionName || selectedHierarchy?.treeVersion || \"\";\nif (selectedHierarchy && selectedTreeVersionName) {\n  const selectedDimensionName = selectedHierarchy.dimensionName || selectionContext.dimensionName || \"\";\n  let segment = segmentsByDimension[selectedDimensionName] || segmentsByCode[selectedHierarchy.segmentCode];\n  if (!segment && onlyRequestedSegment) {\n    segment = onlyRequestedSegment;\n  }\n  if (segment) {\n    const segmentCode = segment.segmentCode;\n    const selectedEntry = {\n      segmentCode,\n      treeVersionName: selectedTreeVersionName\n    };\n    hierarchyState.pendingSelections = { ...(hierarchyState.pendingSelections || {}) };\n    hierarchyState.pendingSelections[segmentCode] = selectedEntry;\n    hierarchyState.pendingOptionsBySegment[segmentCode] = [{ sr: 1, treeVersionName: selectedTreeVersionName }];\n  }\n}\n\nconst agentOutput = [\n  { type: \"metadata\", intent: \"directResponse\", usePrepareJsonAds: true },\n  ...display\n];\n\nconst returnObj = {\n  agentOutput,\n  hierarchyState,\n  shouldRouteToAgents: false,\n  targetAgentOverride: \"\"\n};\n\nreturn returnObj;"
