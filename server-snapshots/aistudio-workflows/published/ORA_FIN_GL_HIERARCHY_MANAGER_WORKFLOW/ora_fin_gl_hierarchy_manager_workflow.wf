            "name": "Update State No COA",
            "returnType": "object",
            "sourceCode": "var selected = $context.$nodes.FIN_GL_CODE_BUILD_MISSING_CONTEXT_RESPONSE_NO_COA && $context.$nodes.FIN_GL_CODE_BUILD_MISSING_CONTEXT_RESPONSE_NO_COA.$output && $context.$nodes.FIN_GL_CODE_BUILD_MISSING_CONTEXT_RESPONSE_NO_COA.$output.result;\nvar normalizeAgentResponse = (agentOutput) => {\n  var output = Array.isArray(agentOutput) ? agentOutput : [];\n  var response = [];\n\n  for (var i = 0; i < output.length; i += 1) {\n    var item = output[i];\n    if (!item || item.type === \"metadata\") {\n      continue;\n    }\n\n    if (typeof item === \"string\") {\n      response.push({ display_type: \"text\", data: item });\n      continue;\n    }\n\n    if (item.display_type === \"text\") {\n      var textData = \"\";\n      if (item.data !== undefined && item.data !== null) {\n        textData = item.data;\n      } else if (item.text !== undefined && item.text !== null) {\n        textData = item.text;\n      }\n      response.push({ display_type: \"text\", data: textData });\n      continue;\n    }\n\n    if (item.display_type === \"table\") {\n      var tableData = \"\";\n      if (item.data !== undefined && item.data !== null) {\n        tableData = item.data;\n      }\n      response.push({ display_type: \"table\", data: tableData });\n      continue;\n    }\n\n    if (item.display_type === \"action\") {\n      var actionData = [];\n      if (Array.isArray(item.data)) {\n        actionData = item.data;\n      } else if (item.actions && Array.isArray(item.actions.items)) {\n        actionData = item.actions.items;\n      }\n      response.push({ display_type: \"action\", data: actionData });\n      continue;\n    }\n\n    response.push(item);\n  }\n\n  return response;\n};\n\nif (!selected) {\n  throw new Error(\"Hierarchy workflow response builder did not produce output.\");\n}\n\nif (!selected.hierarchyState || typeof selected.hierarchyState !== \"object\" || Array.isArray(selected.hierarchyState)) {\n  throw new Error(\"Hierarchy workflow response builder did not return hierarchyState.\");\n}\nif (!Array.isArray(selected.hierarchyState.hierarchyOverrides)) {\n  throw new Error(\"Hierarchy workflow response builder did not return hierarchyState.hierarchyOverrides.\");\n}\nif (!selected.hierarchyState.pendingOptionsBySegment || typeof selected.hierarchyState.pendingOptionsBySegment !== \"object\" || Array.isArray(selected.hierarchyState.pendingOptionsBySegment)) {\n  throw new Error(\"Hierarchy workflow response builder did not return hierarchyState.pendingOptionsBySegment.\");\n}\nif (!selected.hierarchyState.pendingSelections || typeof selected.hierarchyState.pendingSelections !== \"object\" || Array.isArray(selected.hierarchyState.pendingSelections)) {\n  throw new Error(\"Hierarchy workflow response builder did not return hierarchyState.pendingSelections.\");\n}\n\nvar returnObj = {};\nfor (var key in selected) {\n  if (Object.prototype.hasOwnProperty.call(selected, key)) {\n    returnObj[key] = selected[key];\n  }\n}\nreturnObj.agentResponse = normalizeAgentResponse(selected.agentOutput);\nreturnObj.agentName = \"ora_fin_gl_hierarchy_manager_assistant\";\n\nreturn returnObj;"
