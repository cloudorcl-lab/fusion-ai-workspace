        {
          "metadata": {
            "name": "Build Save or Clear Response No Save",
            "returnType": "object",
            "sourceCode": "const ctx = $context.$nodes.FIN_GL_CODE_BUILD_CONTEXT?.$output?.result || {};\nconst decision = $context.$nodes.FIN_GL_LLM_INTENT_RESOLVER?.$output || {};\nconst resolved = $context.$nodes.FIN_GL_LLM_RESOLVE_SELECTION?.$output?.result || {};\nconst actionCase = ctx.missingCoaContext ? \"missingContext\" : (decision.case || ctx.deterministicCase || \"outOfScope\");\nconst hierarchyState = { ...(ctx.hierarchyState || {}) };\nhierarchyState.pendingOptionsBySegment = { ...(hierarchyState.pendingOptionsBySegment || {}) };\nhierarchyState.pendingSelections = { ...(hierarchyState.pendingSelections || {}) };\n\nconst overridesToMap = (value) => {\n  const map = {};\n  if (Array.isArray(value)) {\n    for (const item of value) {\n      const segmentCode = item?.segmentCode;\n      const treeVersionName = item?.treeVersionName;\n      if (segmentCode && treeVersionName) map[segmentCode] = treeVersionName;\n    }\n  } else if (value && typeof value === \"object\") {\n    for (const [segmentCode, treeVersionName] of Object.entries(value)) {\n      if (segmentCode && treeVersionName) map[segmentCode] = treeVersionName;\n    }\n  }\n  return map;\n};\n\nconst mapToOverridesArray = (map) => Object.entries(map || {})\n  .filter(([segmentCode, treeVersionName]) => segmentCode && treeVersionName)\n  .map(([segmentCode, treeVersionName]) => ({ segmentCode, treeVersionName }));\n\nconst segmentByCode = Object.fromEntries((ctx.segments || []).map((segment) => [segment.segmentCode, segment]));\nconst isValidSegmentCode = (segmentCode) => !!segmentCode && !!segmentByCode[segmentCode];\nconst optionTreeVersionName = (option) => String(option?.treeVersionName || option?.treeNameHyphenVersion || option?.treeVersion || \"\").trim();\nconst itemTreeNameHyphenVersion = (item) => String(item?.treeNameHyphenVersion || \"\").trim();\n\nconst allPendingOptions = [];\nfor (const [segmentCode, options] of Object.entries(hierarchyState.pendingOptionsBySegment || {})) {\n  if (!Array.isArray(options)) continue;\n  for (const option of options) {\n    allPendingOptions.push({ segmentCode, option });\n  }\n}\n\nconst findBySr = (item) => {\n  const sr = Number(item?.sr);\n  if (!Number.isFinite(sr) || sr <= 0) return null;\n  const preferredSegmentCode = isValidSegmentCode(item?.segmentCode) ? item.segmentCode : \"\";\n  if (preferredSegmentCode) {\n    const preferredOptions = hierarchyState.pendingOptionsBySegment?.[preferredSegmentCode] || [];\n    const preferredMatch = preferredOptions.find((option) => Number(option?.sr) === sr);\n    if (preferredMatch) return { segmentCode: preferredSegmentCode, option: preferredMatch };\n  }\n  return allPendingOptions.find(({ option }) => Number(option?.sr) === sr) || null;\n};\n\nconst resolveSelectedItem = (item) => {\n  const match = findBySr(item);\n  if (match) {\n    const treeVersionName = optionTreeVersionName(match.option);\n    if (match.segmentCode && treeVersionName) {\n      return { segmentCode: match.segmentCode, treeVersionName, sr: Number(match.option?.sr || item?.sr || 0) };\n    }\n  }\n\n  const fallbackSegmentCode = isValidSegmentCode(item?.segmentCode) ? item.segmentCode : \"\";\n  const fallbackTreeVersionName = itemTreeNameHyphenVersion(item);\n  if (fallbackSegmentCode && fallbackTreeVersionName) {\n    return { segmentCode: fallbackSegmentCode, treeVersionName: fallbackTreeVersionName, sr: Number(item?.sr || 0) };\n  }\n\n  return null;\n};\n\nconst selectedMappings = [];\nconst seenSegments = new Set();\nfor (const item of Array.isArray(resolved.selectedOptions) ? resolved.selectedOptions : []) {\n  const selected = resolveSelectedItem(item);\n  if (!selected || !selected.segmentCode || !selected.treeVersionName) continue;\n  if (seenSegments.has(selected.segmentCode)) continue;\n  seenSegments.add(selected.segmentCode);\n  selectedMappings.push({ segmentCode: selected.segmentCode, treeVersionName: selected.treeVersionName });\n  hierarchyState.pendingSelections[selected.segmentCode] = {\n    segmentCode: selected.segmentCode,\n    treeVersionName: selected.treeVersionName,\n    sr: selected.sr\n  };\n}\n\nlet hierarchyOverrides = mapToOverridesArray(overridesToMap(hierarchyState.hierarchyOverrides));\nif ([\"saveDefault\", \"sessionOnly\", \"clear\"].includes(actionCase)) {\n  hierarchyState.pendingOptionsBySegment = {};\n  hierarchyState.pendingSelections = {};\n}\n\nconst labels = selectedMappings.map((mapping) => {\n  const segment = segmentByCode[mapping.segmentCode] || {};\n  const label = segment.label || segment.segmentCode || mapping.segmentCode;\n  return label + \" hierarchy changed to \" + mapping.treeVersionName;\n});\nconst priorBusinessFlow = !!ctx.priorBusinessFlow;\n\nconst metadata = {\n  type: \"metadata\",\n  intent: \"directResponse\",\n  usePrepareJsonAds: true\n};\nlet agentOutput;\nlet targetAgentOverride = \"\";\n\nif (actionCase === \"missingContext\") {\n  agentOutput = [metadata, { display_type: \"text\", data: \"<p>I need a chart of accounts context before I can list or change hierarchies. Please select a ledger or pass chartOfAccountsId in additionalContext.</p>\" }];\n} else if (actionCase === \"outOfScope\") {\n  metadata.intent = \"agentRouting\";\n  agentOutput = [metadata];\n} else if (actionCase === \"select\") {\n  const text = labels.length ? labels.join(\"; \") : \"I could not determine which hierarchy option to use\";\n  agentOutput = [\n    metadata,\n    { display_type: \"text\", data: \"<p>\" + text + \". Save this as your new default preference?</p>\" },\n    { display_type: \"action\", data: [\"Save as Default\", \"This Session Only\"] }\n  ];\n} else if (actionCase === \"saveDefault\") {\n  if (priorBusinessFlow) {\n    metadata.intent = \"agentRouting\";\n    metadata.footerText = \"<p>\" + (labels.length ? labels.join(\"; \") : \"Hierarchy changed\") + \" and saved as your default. Results updated.</p>\";\n    metadata.scopeChange = \"true\";\n    targetAgentOverride = ctx.priorBusinessAgent || \"\";\n    agentOutput = [metadata];\n  } else {\n    agentOutput = [metadata, { display_type: \"text\", data: \"<p>I have saved the hierarchy as your default for future inquiries.</p>\" }];\n  }\n} else if (actionCase === \"sessionOnly\") {\n  if (priorBusinessFlow) {\n    metadata.intent = \"agentRouting\";\n    metadata.footerText = \"<p>\" + (labels.length ? labels.join(\"; \") : \"Hierarchy changed\") + \". Results updated.</p>\";\n    metadata.scopeChange = \"true\";\n    targetAgentOverride = ctx.priorBusinessAgent || \"\";\n    agentOutput = [metadata];\n  } else {\n    agentOutput = [metadata, { display_type: \"text\", data: \"<p>I will use this hierarchy for this session only. Your default preference remains unchanged.</p>\" }];\n  }\n} else if (actionCase === \"clear\") {\n  agentOutput = [metadata, { display_type: \"text\", data: \"<p>I have cleared the saved hierarchy preference.</p>\" }];\n} else {\n  agentOutput = [metadata, { display_type: \"text\", data: \"<p>An error occurred while processing your query. Please try again later.</p>\" }];\n}\n\nconst returnObj = {\n  agentOutput,\n  hierarchyState,\n  shouldRouteToAgents: metadata.intent === \"agentRouting\",\n  targetAgentOverride,\n  footerText: metadata.footerText || \"\",\n  scopeChange: metadata.scopeChange || \"\"\n};\n\nreturn returnObj;"
