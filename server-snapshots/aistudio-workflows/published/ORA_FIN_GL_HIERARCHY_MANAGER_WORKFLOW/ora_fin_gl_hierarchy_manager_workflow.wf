          "metadata": {
            "name": "Build Missing Context Response No COA",
            "returnType": "object",
            "sourceCode": "var ctx = ($context.$nodes.FIN_GL_CODE_BUILD_CONTEXT && $context.$nodes.FIN_GL_CODE_BUILD_CONTEXT.$output && $context.$nodes.FIN_GL_CODE_BUILD_CONTEXT.$output.result) || {};\nvar hierarchyState = ctx.hierarchyState || {\n  hierarchyOverrides: [],\n  pendingOptionsBySegment: {},\n  pendingSelections: {}\n};\nvar metadata = {\n  type: \"metadata\",\n  intent: \"directResponse\",\n  usePrepareJsonAds: true\n};\nvar agentOutput = [\n  metadata,\n  {\n    display_type: \"text\",\n    data: \"<p>I need a chart of accounts context before I can list or change hierarchies. Please select a ledger or pass chartOfAccountsId in additionalContext.</p>\"\n  }\n];\n\nvar returnObj = {\n  agentOutput: agentOutput,\n  hierarchyState: hierarchyState,\n  shouldRouteToAgents: false,\n  targetAgentOverride: \"\",\n  footerText: \"\",\n  scopeChange: \"\"\n};\n\nreturn returnObj;"
