]);\n  const tokens = normalized.split(/\\s+/).filter(Boolean);\n  for (let index = 1; index < tokens.length; index++) {\n    const leadingTokens = tokens.slice(0, index);\n    const leadingTokensLookLikePrefix = leadingTokens.every((token) => token.length <= 2);\n    if (!leadingTokensLookLikePrefix) break;\n    const stripped = tokens.slice(index).join(\" \");\n    aliases.push(stripped, stripped.replace(/\\s+/g, \"\"));\n  }\n  for (const alias of aliases) {\n    if (alias) segmentByAlias[alias] = segment.segmentCode;\n  }\n};\n\nfor (const segment of ctx.segments || []) {\n  if (!segment?.segmentCode) continue;\n  segmentByCode[segment.segmentCode] = segment;\n  segmentByAlias[String(segment.segmentCode)] = segment.segmentCode;\n  segmentByAlias[String(segment.segmentCode).toLowerCase()] = segment.segmentCode;\n  addAlias(segment, segment.segmentCode);\n  addAlias(segment, segment.dimensionName);\n  addAlias(segment, segment.label);\n}\n\nconst resolveSegmentCode = (value) => {\n  if (value === undefined || value === null) return \"\";\n  const raw = String(value).trim();\n  if (!raw) return \"\";\n  if (segmentByAlias[raw]) return segmentByAlias[raw];\n  if (segmentByAlias[raw.toLowerCase()]) return segmentByAlias[raw.toLowerCase()];\n  const normalized = normalizeSearchText(raw);\n  if (segmentByAlias[normalized]) return segmentByAlias[normalized];\n  const compact = normalized.replace(/\\s+/g, \"\");\n  if (segmentByAlias[compact]) return segmentByAlias[compact];\n  return \"\";\n};\n\nconst targetCodes = [];\nconst seen = new Set();\nconst addTarget = (value) => {\n  const segmentCode = resolveSegmentCode(value);\n  if (!segmentCode || seen.has(segmentCode)) return;\n  seen.add(segmentCode);\n  targetCodes.push(segmentCode);\n};\n\nif (resolved.clearAll === true || resolved.clearAll === \"true\") {\n  for (const segment of ctx.segments || []) addTarget(segment?.segmentCode);\n} else if (Array.isArray(resolved.segmentCodesToClear)) {\n  for (const segmentCode of resolved.segmentCodesToClear) addTarget(segmentCode);\n}\n\nconst overrideMap = resolved.clearAll === true || resolved.clearAll === \"true\"\n  ? {}\n  : overridesToMap(hierarchyState.hierarchyOverrides);\nif (!(resolved.clearAll === true || resolved.clearAll === \"true\")) {\n  for (const segmentCode of targetCodes) {\n    delete overrideMap[segmentCode];\n  }\n}\nconst hierarchyOverrides = mapToOverridesArray(overrideMap);\nhierarchyState.hierarchyOverrides = hierarchyOverrides;\n\nif (targetCodes.length > 0) {\n  hierarchyState.pendingOptionsBySegment = {};\n  hierarchyState.pendingSelections = {};\n}\n\nconst labels = targetCodes.map((segmentCode) => {\n  const segment = segmentByCode[segmentCode] || {};\n  const label = segment.label || segment.segmentCode || segmentCode;\n  return label + \" hierarchy preference cleared\";\n});\n\nconst metadata = {\n  type: \"metadata\",\n  intent: \"directResponse\",\n  usePrepareJsonAds: true\n};\n\nlet agentOutput;\nlet targetAgentOverride = \"\";\n\nif (actionCase === \"missingContext\") {\n  agentOutput = [metadata, { display_type: \"text\", data: \"<p>I need a chart of accounts context before I can clear hierarchy preferences. Please select a ledger or pass chartOfAccountsId in additionalContext.</p>\" }];\n} else if (actionCase === \"outOfScope\") {\n  metadata.intent = \"agentRouting\";\n  agentOutput = [metadata];\n} else if (actionCase === \"clear\") {\n  if (targetCodes.length > 0) {\n    const text = labels.length ? labels.join(\"; \") : \"I have cleared the saved hierarchy preference.\";\n    agentOutput = [metadata, { display_type: \"text\", data: \"<p>\" + text + \"</p>\" }];\n  } else {\n    agentOutput = [metadata, { display_type: \"text\", data: \"<p>I could not determine which hierarchy preference to clear.</p>\" }];\n  }\n} else {\n  agentOutput = [metadata, { display_type: \"text\", data: \"<p>An error occurred while processing your query. Please try again later.</p>\" }];\n}\n\nconst returnObj = {\n 