        {
          "metadata": {
            "name": "Build Missing Context Response",
            "returnType": "object",
            "sourceCode": "const ctx = $context.$nodes.FIN_GL_CODE_BUILD_CONTEXT?.$output?.result || {};\nconst decision = $context.$nodes.FIN_GL_LLM_INTENT_RESOLVER?.$output || {};\nconst actionCase = ctx.missingCoaContext ? \"missingContext\" : (decision.case || ctx.deterministicCase || \"outOfScope\");\nconst hierarchyState = ctx.hierarchyState || { hierarchyOverrides: [] };\n\nconst overridesToMap = (value) => {\n  const map = {};\n  if (Array.isArray(value)) {\n    for (const item of value) {\n      const segmentCode = item?.segmentCode;\n      const treeVersionName = item?.treeVersionName;\n      if (segmentCode && treeVersionName) map[segmentCode] = treeVersionName;\n    }\n  } else if (value && typeof value === \"object\") {\n    for (const [segmentCode, treeVersionName] of Object.entries(value)) {\n      if (segmentCode && treeVersionName) map[segmentCode] = treeVersionName;\n    }\n  }\n  return map;\n};\n\nconst mapToOverridesArray = (map) => Object.entries(map || {})\n  .filter(([segmentCode, treeVersionName]) => segmentCode && treeVersionName)\n  .map(([segmentCode, treeVersionName]) => ({ segmentCode, treeVersionName }));\n\nconst hierarchyOverrides = mapToOverridesArray(overridesToMap(hierarchyState.hierarchyOverrides));\nhierarchyState.hierarchyOverrides = hierarchyOverrides;\nconst labels = [];\nconst priorBusinessFlow = !!ctx.priorBusinessFlow;\n\nconst metadata = {\n  type: \"metadata\",\n  intent: \"directResponse\",\n  usePrepareJsonAds: true\n};\nlet agentOutput;\nlet targetAgentOverride = \"\";\n\nif (actionCase === \"missingContext\") {\n  agentOutput = [metadata, { display_type: \"text\", data: \"<p>I need a chart of accounts context before I can list or change hierarchies. Please select a ledger or pass chartOfAccountsId in additionalContext.</p>\" }];\n} else if (actionCase === \"outOfScope\") {\n  metadata.intent = \"agentRouting\";\n  agentOutput = [metadata];\n} else if (actionCase === \"select\") {\n  const text = labels.length ? labels.join(\"; \") : \"Hierarchy selection updated\";\n  agentOutput = [\n    metadata,\n    { display_type: \"text\", data: \"<p>\" + text + \". Save this as your new default preference?</p>\" },\n    { display_type: \"action\", data: [\"Save as Default\", \"This Session Only\"] }\n  ];\n} else if (actionCase === \"saveDefault\") {\n  if (priorBusinessFlow) {\n    metadata.intent = \"agentRouting\";\n    metadata.footerText = \"<p>\" + (labels.length ? labels.join(\"; \") : \"Hierarchy changed\") + \" and saved as your default. Results updated.</p>\";\n    metadata.scopeChange = \"true\";\n    targetAgentOverride = ctx.priorBusinessAgent || \"\";\n    agentOutput = [metadata];\n  } else {\n    agentOutput = [metadata, { display_type: \"text\", data: \"<p>I have saved the hierarchy as your default for future inquiries.</p>\" }];\n  }\n} else if (actionCase === \"sessionOnly\") {\n  if (priorBusinessFlow) {\n    metadata.intent = \"agentRouting\";\n    metadata.footerText = \"<p>\" + (labels.length ? labels.join(\"; \") : \"Hierarchy changed\") + \". Results updated.</p>\";\n    metadata.scopeChange = \"true\";\n    targetAgentOverride = ctx.priorBusinessAgent || \"\";\n    agentOutput = [metadata];\n  } else {\n    agentOutput = [metadata, { display_type: \"text\", data: \"<p>I will use this hierarchy for this session only. Your default preference remains unchanged.</p>\" }];\n  }\n} else if (actionCase === \"clear\") {\n  agentOutput = [metadata, { display_type: \"text\", data: \"<p>\" + (labels.length ? labels.join(\"; \") : \"I have cleared the saved hierarchy preference.\") + \"</p>\" }];\n} else {\n  agentOutput = [metadata, { display_type: \"text\", data: \"<p>An error occurred while processing your query. Please try again later.</p>\" }];\n}\n\nconst returnObj = {\n  agentOutput,\n  hierarchyState,\n  shouldRouteToAgents: metadata.intent === \"agentRouting\",\n  targetAgentOverride,\n  footerText: metadata.footerText || \"\",\n  scopeChange: metadata.scopeChange || \"\"\n};\n\nreturn returnObj;"
