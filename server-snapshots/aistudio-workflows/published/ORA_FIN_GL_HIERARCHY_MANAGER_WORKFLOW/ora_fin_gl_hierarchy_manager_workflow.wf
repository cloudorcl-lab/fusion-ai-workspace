        {
          "metadata": {
            "name": "Build Context",
            "returnType": "object",
            "sourceCode": "const input = $context.$system.$inputMessage || \"\";\nconst additionalContext = { ...($context.$triggers.REST.$input.additionalContext || $context.$triggers.REST.$input.additional_context || new Object()) };\nconst selectedLedger = $context.$triggers.REST.$input.selectedLedger ?? null;\n\nif (selectedLedger) {\n  additionalContext.ledgerId = selectedLedger.ledgerId;\n  additionalContext.ledgerContext = selectedLedger.ledgerName;\n  additionalContext.ledgerCategory = selectedLedger.ledgerCategory;\n  additionalContext.chartOfAccountsId = selectedLedger.chartOfAccountsId;\n  additionalContext.analyticView = selectedLedger.avName;\n}\n\nconst overridesToMap = (value) => {\n  const map = new Object();\n  if (Array.isArray(value)) {\n    for (const item of value) {\n      const segmentCode = item?.segmentCode;\n      const treeVersionName = item?.treeVersionName || item?.treeVersion;\n      if (segmentCode && treeVersionName) map[segmentCode] = treeVersionName;\n    }\n  } else if (value && typeof value === \"object\") {\n    for (const [segmentCode, treeVersionName] of Object.entries(value)) {\n      if (segmentCode && treeVersionName) map[segmentCode] = treeVersionName;\n    }\n  }\n  return map;\n};\n\nconst mapToOverridesArray = (map) => Object.entries(map || new Object())\n  .filter(([segmentCode, treeVersionName]) => segmentCode && treeVersionName)\n  .map(([segmentCode, treeVersionName]) => ({ segmentCode, treeVersionName }));\n\nconst normalizeDimensionName = (segmentCode) => {\n  if (!segmentCode) return null;\n  const raw = String(segmentCode).trim();\n  if (!raw) return null;\n  const parts = raw.split(/[\\s_-]+/).filter(Boolean);\n  if (!parts.length) return null;\n  const [firstPart, ...restParts] = parts;\n  const first = firstPart.charAt(0).toLowerCase() + firstPart.slice(1);\n  const rest = restParts.map((part) => part.charAt(0).toUpperCase() + part.slice(1)).join(\"\");\n  return first + rest;\n};\n\nconst getSequence = (segment) => {\n  const candidates = [\n    segment?.sequenceNumber,\n    segment?.segmentSequenceNumber,\n    segment?.segmentSequence,\n    segment?.sequence,\n    segment?.displaySequence,\n    segment?.displayOrder\n  ];\n  for (const candidate of candidates) {\n    const value = Number(candidate);\n    if (Number.isFinite(value)) return value;\n  }\n  return Number.MAX_SAFE_INTEGER;\n};\n\nconst deriveSegmentLabel = (segment) => segment?.segmentName || segment?.label || segment?.segmentCode || segment?.dimensionName || null;\nconst parseMaybeJson = (value) => {\n  if (typeof value !== \"string\") return value;\n  try {\n    return JSON.parse(value);\n  } catch (error) {\n    return value;\n  }\n};\nconst extractCoaResults = (value) => {\n  const seen = new Set();\n  const queue = [value];\n  while (queue.length) {\n    const current = parseMaybeJson(queue.shift());\n    if (!current || seen.has(current)) continue;\n    if (typeof current === \"object\") seen.add(current);\n    if (Array.isArray(current)) return current;\n    if (Array.isArray(current?.result)) return current.result;\n    if (Array.isArray(current?.data?.result)) return current.data.result;\n    if (Array.isArray(current?.states)) {\n      for (const state of current.states) {\n        if (state?.toolCode === \"FIN_GL_BO_FUNCTION_GET_COA_DETAILS\" || state?.parentNodeCode === \"FIN_GL_BO_FUNCTION_GET_COA_DETAILS\" || state?.functionOutput) {\n          queue.push(state?.functionOutput);\n        }\n      }\n    }\n    for (const candidate of [current?.result, current?.response, current?.output, current?.output?.response, current?.data, current?.body]) {\n      if (candidate !== undefined && candidate !== null) queue.push(candidate);\n    }\n  }\n  return [];\n};\nconst coaOutput = $context.$nodes.FIN_GL_BO_FUNCTION_GET_COA_DETAILS?.$output;\nconst rawCoaDetails = coaOutput?.result ?? coaOutput?.output ?? coaOutput?.response ?? $context.$triggers.REST.$input.coaDetails;\nconst coaResults = extractCoaResults(rawCoaDetails);\nconst segmentMap = new Map();\n\nfor (const segment of coaResults) {\n  const segmentCode = segment?.segmentCode || segment?.dimensionName || null;\n  const dimensionName = normalizeDimensionName(segmentCode);\n  const label = deriveSegmentLabel(segment);\n  if (!segmentCode || !dimensionName || !label || segmentMap.has(segmentCode)) continue;\n  segmentMap.set(segmentCode, { segmentCode, dimensionName, label, sequenceNumber: getSequence(segment) });\n}\n\nconst segments = Array.from(segmentMap.values()).sort((a, b) => {\n  if (a.sequenceNumber !== b.sequenceNumber) return a.sequenceNumber - b.sequenceNumber;\n  return String(a.label).localeCompare(String(b.label));\n});\n\nconst segmentKeyByAlias = new Object();\nfor (const segment of segments) {\n  if (segment.segmentCode) segmentKeyByAlias[segment.segmentCode] = segment.segmentCode;\n  if (segment.dimensionName) segmentKeyByAlias[segment.dimensionName] = segment.segmentCode;\n}\nconst normalizeSegmentKey = (segmentCode) => segmentKeyByAlias[segmentCode] || segmentCode;\nconst normalizeOverrideKeys = (map) => {\n  const normalized = new Object();\n  for (const [segmentCode, treeVersionName] of Object.entries(map || new Object())) {\n    const rawSegmentCode = normalizeSegmentKey(segmentCode);\n    if (rawSegmentCode && treeVersionName) normalized[rawSegmentCode] = treeVersionName;\n  }\n  return normalized;\n};\n\nconst normalizeKeyedObject = (value) => {\n  const normalized = new Object();\n  if (!value || typeof value !== \"object\" || Array.isArray(value)) return normalized;\n  for (const [key, entry] of Object.entries(value)) {\n    if (!key) continue;\n    normalized[normalizeSegmentKey(key)] = entry;\n  }\n  return normalized;\n};\n\nconst normalizeSelectionEntries = (value) => {\n  const normalized = new Object();\n  const entries = normalizeKeyedObject(value);\n  for (const [segmentCode, entry] of Object.entries(entries)) {\n    if (entry && typeof entry === \"object\" && !Array.isArray(entry)) {\n      normalized[segmentCode] = { ...entry, segmentCode };\n    } else {\n      normalized[segmentCode] = entry;\n    }\n  }\n  return normalized;\n};\n\nconst state = $context.$triggers.REST.$input.state || new Object();\nconst hierarchyState = {\n  pendingOptionsBySegment: new Object(),\n  pendingSelections: new Object(),\n  ...(state?.shared?.hierarchy || new Object())\n};\n\nhierarchyState.hierarchyOverrides = mapToOverridesArray(\n  normalizeOverrideKeys(overridesToMap(hierarchyState.hierarchyOverrides))\n);\nhierarchyState.pendingOptionsBySegment = normalizeKeyedObject(hierarchyState.pendingOptionsBySegment);\nhierarchyState.pendingSelections = normalizeSelectionEntries(hierarchyState.pendingSelections);\n\nconst lowerInput = String(input).toLowerCase();\nconst isSaveDefault = /\\b(save as default|save default|save .*default|make .*default|update default|set .*default preference|set .*as .*default preference)\\b/i.test(input);\nconst isSessionOnly = /\\b(this session only|session only|use .*this session|don't save|do not save|not now|keep existing)\\b/i.test(input);\nconst isClear = /\\b(clear|remove|reset|delete)\\b/i.test(input) && /\\b(default|saved|preference|hierarch|tree)\\b/i.test(input);\nconst isPreferences = /\\b(show|view|list|retrieve|get|what are)\\b/i.test(input) && /\\b(saved|default|current|using).*\\b(hierarchy|hierarchies|tree|preferences?)\\b/i.test(input);\nconst isChange = /\\b(change|switch|set|use|update)\\b/i.test(input) && /\\b(hierarchy|hierarchies|tree|tree\\s*versions?)\\b/i.test(input);\nconst isList = /\\b(list|show|view)\\b/i.test(input) && /\\b(hierarchy|hierarchies|tree|tree\\s*versions?)\\b/i.test(input);\nconst isNumericSelection = /^\\s*\\d+(\\s*(,|and)\\s*\\d+)*\\s*$/i.test(input);\nconst hasPending = Object.keys(hierarchyState.pendingOptionsBySegment || {}).length > 0 || Object.keys(hierarchyState.pendingSelections || {}).length > 0;\n\nlet deterministicCase = \"outOfScope\";\nif (isSaveDefault) deterministicCase = \"saveDefault\";\nelse if (isSessionOnly) deterministicCase = \"sessionOnly\";\nelse if (isClear) deterministicCase = \"clear\";\nelse if (isPreferences) deterministicCase = \"preferences\";\nelse if ((isNumericSelection || hasPending) && !isList && !isChange) deterministicCase = \"select\";\nelse if (isChange) deterministicCase = \"change\";\nelse if (isList) deterministicCase = \"list\";\n\nconst normalizeTargetObject = (value) => {\n  const text = String(value || \"\").toLowerCase();\n  if (/journal/.test(text)) return \"journals\";\n  if (/subledger|sub-ledger/.test(text)) return \"subledgers\";\n  if (/report/.test(text)) return \"reports\";\n  if (/balance/.test(text)) return \"balances\";\n  return \"\";\n};\nconst latestAgent = (() => {\n  const lastUsedAgent = state?.lastUsedAgent;\n  if (Array.isArray(lastUsedAgent)) return lastUsedAgent[lastUsedAgent.length - 1] || \"\";\n  return typeof lastUsedAgent === \"string\" ? lastUsedAgent : \"\";\n})();\nconst targetObject =\n  normalizeTargetObject(additionalContext.inquiryTargetObjectType) ||\n  normalizeTargetObject($context.$triggers.REST.$input.routingDecision) ||\n  normalizeTargetObject(latestAgent);\n\nconst transcriptInput = $context.$triggers.REST.$input[\"chat\" + \"History\"] ?? $context.$system[\"$chat\" + \"History\"];\nconst hierarchyAgentCode = \"ora_fin_gl_hierarchy_manager_assistant\";\nconst businessAgentCodes = [\n  \"ora_fin_gl_balance_inquiry_and_analysis_assistant\",\n  \"ora_fin_gl_journals_assistant\",\n  \"ora_fin_gl_subledger_supporting_details_assistant\"\n];\nconst parseMaybeJsonValue = (value) => {\n  if (typeof value !== \"string\") return value;\n  try {\n    return JSON.parse(value);\n  } catch (error) {\n    return value;\n  }\n};\nconst normalizeHistoryTurns = (value) => {\n  const parsed = parseMaybeJsonValue(value);\n  if (Array.isArray(parsed)) return parsed;\n  if (Array.isArray(parsed?.messages)) return parsed.messages;\n  if (Array.isArray(parsed?.history)) return parsed.history;\n  if (Array.isArray(parsed?.chatHistory)) return parsed.chatHistory;\n  return [];\n};\nconst getTurnRole = (turn) => String(turn?.role || turn?.author || turn?.type || turn?.speaker || \"\").toLowerCase();\nconst getTurnContent = (turn) => turn?.content ?? turn?.message ?? turn?.text ?? turn?.output ?? turn?.value ?? turn?.payload ?? \"\";\nconst extractAgentCode = (value) => {\n  const parsed = parseMaybeJsonValue(value);\n  if (parsed && typeof parsed === \"object\" && typeof parsed.agent === \"string\") return parsed.agent;\n  return \"\";\n};\nconst findPriorBusinessAgentFromTurns = (value) => {\n  const turns = normalizeHistoryTurns(value);\n\n  for (let index = turns.length - 1; index >= 0; index--) {\n    const turn = turns[index];\n    const role = getTurnRole(turn);\n    if (role !== \"ai\" && role !== \"assistant\") continue;\n\n    const agent = extractAgentCode(getTurnContent(turn));\n    if (!agent) continue;\n    if (agent === hierarchyAgentCode) continue;\n\n    return businessAgentCodes.includes(agent) ? agent : \"\";\n  }\n\n  return \"\";\n};\nconst findPriorBusinessAgentFromSerializedHistory = (value) => {\n  if (typeof value !== \"string\") return \"\";\n\n  const aiSections = String(value).split(/(?:^|\\n)\\s*AI\\s*:/i).slice(1);\n  for (let index = aiSections.length - 1; index >= 0; index--) {\n    const section = aiSections[index];\n    const nextUserIndex = section.search(/(?:^|\\n)\\s*(USER|Human)\\s*:/i);\n    const aiText = nextUserIndex >= 0 ? section.slice(0, nextUserIndex) : section;\n    const match = aiText.match(/[\"']agent[\"']\\s*:\\s*[\"']([^\"']+)[\"']/);\n    const agent = match ? match[1] : \"\";\n    if (!agent) continue;\n    if (agent === hierarchyAgentCode) continue;\n\n    return businessAgentCodes.includes(agent) ? agent : \"\";\n  }\n\n  return \"\";\n};\nconst priorBusinessAgent =\n  findPriorBusinessAgentFromTurns(transcriptInput) ||\n  findPriorBusinessAgentFromSerializedHistory(transcriptInput) ||\n  (businessAgentCodes.includes(latestAgent) ? latestAgent : \"\");\nconst priorBusinessFlow = priorBusinessAgent !== \"\";\n\nconst normalizeIntentKey = (value) => String(value ?? \"\")\n  .replace(/([A-Z]+)([A-Z][a-z])/g, \"$1 $2\")\n  .replace(/([a-z0-9])([A-Z])/g, \"$1 $2\")\n  .replace(/[_-]+/g, \" \")\n  .replace(/[^a-zA-Z0-9]+/g, \" \")\n  .toLowerCase()\n  .trim()\n  .replace(/\\s+/g, \" \");\n\nconst getIntentDetailsObject = (value) => {\n  const parsed = parseMaybeJsonValue(value);\n  if (!parsed || typeof parsed !== \"object\" || Array.isArray(parsed)) return {};\n\n  const nested = parseMaybeJsonValue(parsed.intentDetails);\n  return nested && typeof nested === \"object\" && !Array.isArray(nested) ? nested : parsed;\n};\n\nconst splitIntentValues = (value) => {\n  const parsed = parseMaybeJsonValue(value);\n  if (Array.isArray(parsed)) {\n    return parsed.flatMap(splitIntentValues);\n  }\n  if (parsed && typeof parsed === \"object\") {\n    if (Object.prototype.hasOwnProperty.call(parsed, \"values\")) {\n      return splitIntentValues(parsed.values);\n    }\n    if (Object.prototype.hasOwnProperty.call(parsed, \"value\")) {\n      return splitIntentValues(parsed.value);\n    }\n    return [JSON.stringify(parsed)];\n  }\n\n  return String(parsed ?? \"\")\n    .split(\",\")\n    .map((item) => item.trim())\n    .filter(Boolean);\n};\n\nconst normalizeIntentSegmentValue = (value) => {\n  const text = String(value ?? \"\").trim();\n  if (!text) return text;\n  if (text.startsWith(\"(\") && text.endsWith(\")\")) return \"\";\n\n  const separatorIndex = text.indexOf(\"-\");\n  return separatorIndex > 0 ? text.slice(0, separatorIndex).trim() : text;\n};\n\nconst addUniqueValue = (values, value) => {\n  const normalizedValue = normalizeIntentKey(value);\n  if (!normalizedValue || values.some((existingValue) => normalizeIntentKey(existingValue) === normalizedValue)) return;\n  values.push(value);\n};\n\nconst buildSegmentCodeValuesMapping = () => {\n  if (!priorBusinessAgent) return {};\n\n  const priorPrivateState = state?.domains?.[priorBusinessAgent] || {};\n  const intentDetails = getIntentDetailsObject(\n    priorPrivateState?.lastUsedQuery?.queryResponse?.queries?.[0]?.intentDetails\n  );\n  if (Object.keys(intentDetails).length === 0) return {};\n\n  const intentValuesByKey = {};\n  for (const [key, value] of Object.entries(intentDetails)) {\n    const normalizedKey = normalizeIntentKey(key);\n    if (!normalizedKey) continue;\n    intentValuesByKey[normalizedKey] = splitIntentValues(value)\n      .map(normalizeIntentSegmentValue)\n      .filter(Boolean);\n  }\n\n  const mapping = {};\n  for (const segment of segments) {\n    const values = [];\n    const aliases = [\n      segment?.label,\n      segment?.segmentCode,\n      segment?.dimensionName\n    ].map(normalizeIntentKey).filter(Boolean);\n\n    for (const alias of aliases) {\n      for (const value of intentValuesByKey[alias] || []) {\n        addUniqueValue(values, value);\n      }\n    }\n\n    if (segment?.segmentCode && values.length > 0) {\n      mapping[segment.segmentCode] = values;\n    }\n  }\n\n  return mapping;\n};\n\nconst segmentCodeValuesMapping = buildSegmentCodeValuesMapping();\n\nconst intentResolverLlmContext = {\n  segments: segments.map((segment) => ({\n    segmentCode: segment.segmentCode,\n    label: segment.label\n  })),\n  hierarchyState: {\n    pendingOptionsBySegment: hierarchyState.pendingOptionsBySegment || {},\n    pendingSelections: hierarchyState.pendingSelections || {}\n  },\n  missingCoaContext: String(additionalContext.chartOfAccountsId ?? additionalContext.chartOfAccountsID ?? additionalContext.coaId ?? 0) === \"0\"\n};\n\nconst returnObj = {\n  input,\n  additionalContext,\n  segments,\n  hierarchyState,\n  deterministicCase,\n  intentResolverLlmContext,\n  priorBusinessFlow,\n  priorBusinessAgent,\n  segmentCodeValuesMapping,\n  targetObject,\n  chartOfAccountsId: String(additionalContext.chartOfAccountsId ?? additionalContext.chartOfAccountsID ?? additionalContext.coaId ?? 0),\n  missingCoaContext: intentResolverLlmContext.missingCoaContext\n};\n\nreturn returnObj;"
          },
          "outcomes": {
            "success": "1779000000020"
          },
