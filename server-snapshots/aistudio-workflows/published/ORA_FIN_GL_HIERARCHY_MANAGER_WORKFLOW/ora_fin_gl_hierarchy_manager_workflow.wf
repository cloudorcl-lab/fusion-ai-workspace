          "outputSpecification": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"result\":{\"type\":\"object\",\"properties\":{\"input\":{\"type\":\"string\"},\"additionalContext\":{\"type\":\"object\"},\"actionCase\":{\"type\":\"string\",\"enum\":[\"list\",\"change\",\"preferences\",\"select\",\"saveDefault\",\"sessionOnly\",\"clear\",\"outOfScope\"]},\"activeOnly\":{\"type\":\"string\"},\"selectedText\":{\"type\":\"string\"},\"requestType\":{\"type\":\"string\",\"enum\":[\"list\",\"change\"]},\"requestedSegments\":{\"type\":\"array\",\"items\":{\"type\":\"object\"}},\"hierarchyState\":{\"type\":\"object\"},\"priorBusinessFlow\":{\"type\":\"boolean\"},\"priorBusinessAgent\":{\"type\":\"string\"},\"targetObject\":{\"type\":\"string\"},\"chartOfAccountsId\":{\"type\":\"string\"},\"missingCoaContext\":{\"type\":\"boolean\"}},\"required\":[\"input\",\"additionalContext\",\"actionCase\",\"activeOnly\",\"selectedText\",\"requestType\",\"requestedSegments\",\"hierarchyState\",\"priorBusinessFlow\",\"priorBusinessAgent\",\"targetObject\",\"chartOfAccountsId\",\"missingCoaContext\"],\"additionalProperties\":true},\"timeout\":{\"type\":\"boolean\"},\"error\":{\"type\":\"string\"}},\"additionalProperties\":false,\"required\":[\"result\",\"timeout\",\"error\"]}",
