            "returnType": "object",
            "sourceCode": "var ctx = $context.$nodes.FIN_GL_CODE_BUILD_CONTEXT && $context.$nodes.FIN_GL_CODE_BUILD_CONTEXT.$output && $context.$nodes.FIN_GL_CODE_BUILD_CONTEXT.$output.result ? $context.$nodes.FIN_GL_CODE_BUILD_CONTEXT.$output.result : {};\nvar resolved = $context.$nodes.FIN_GL_LLM_RESOLVE_SAVE_DEFAULT_SELECTION && $context.$nodes.FIN_GL_LLM_RESOLVE_SAVE_DEFAULT_SELECTION.$output && $context.$nodes.FIN_GL_LLM_RESOLVE_SAVE_DEFAULT_SELECTION.$output.result ? $context.$nodes.FIN_GL_LLM_RESOLVE_SAVE_DEFAULT_SELECTION.$output.result : {};\nvar hierarchyState = ctx.hierarchyState || {};\nvar pendingOptionsBySegment = hierarchyState.pendingOptionsBySegment || {};\nvar pendingSelections = hierarchyState.pendingSelections || {};\nvar segments = Array.isArray(ctx.segments) ? ctx.segments : [];\nvar segmentByCode = {};\nfor (var s = 0; s < segments.length; s++) {\n  var segment = segments[s] || {};\n  if (segment.segmentCode) segmentByCode[segment.segmentCode] = segment;\n}\nvar isValidSegmentCode = function(segmentCode) {\n  return !!segmentCode && !!segmentByCode[segmentCode];\n};\nvar optionTreeVersionName = function(option) {\n  option = option || {};\n  return String(option.treeVersionName || option.treeNameHyphenVersion || option.treeVersion || \"\").trim();\n};\nvar itemTreeNameHyphenVersion = function(item) {\n  item = item || {};\n  return String(item.treeNameHyphenVersion || \"\").trim();\n};\nvar allPendingOptions = [];\nfor (var segmentCode in pendingOptionsBySegment) {\n  var options = pendingOptionsBySegment[segmentCode];\n  if (!Array.isArray(options)) continue;\n  for (var optionIndex = 0; optionIndex < options.length; optionIndex++) {\n    allPendingOptions.push({ segmentCode: segmentCode, option: options[optionIndex] });\n  }\n}\nvar findBySr = function(item) {\n  item = item || {};\n  var sr = Number(item.sr);\n  if (!Number.isFinite(sr) || sr <= 0) return null;\n  var preferredSegmentCode = isValidSegmentCode(item.segmentCode) ? item.segmentCode : \"\";\n  if (preferredSegmentCode) {\n    var preferredOptions = pendingOptionsBySegment[preferredSegmentCode] || [];\n    for (var preferredIndex = 0; preferredIndex < preferredOptions.length; preferredIndex++) {\n      if (Number(preferredOptions[preferredIndex] && preferredOptions[preferredIndex].sr) === sr) {\n        return { segmentCode: preferredSegmentCode, option: preferredOptions[preferredIndex] };\n      }\n    }\n  }\n  for (var pendingIndex = 0; pendingIndex < allPendingOptions.length; pendingIndex++) {\n    if (Number(allPendingOptions[pendingIndex].option && allPendingOptions[pendingIndex].option.sr) === sr) {\n      return allPendingOptions[pendingIndex];\n    }\n  }\n  return null;\n};\nvar selectedMappings = [];\nvar seenSegments = {};\nvar addMapping = function(segmentCode, treeVersionName) {\n  if (!segmentCode || !treeVersionName || seenSegments[segmentCode]) return;\n  seenSegments[segmentCode] = true;\n  selectedMappings.push({ segmentCode: segmentCode, treeVersionName: treeVersionName });\n};\nfor (var pendingSegmentCode in pendingSelections) {\n  var pendingSelection = pendingSelections[pendingSegmentCode] || {};\n  addMapping(pendingSelection.segmentCode || pendingSegmentCode, pendingSelection.treeVersionName);\n}\nvar selectedOptions = Array.isArray(resolved.selectedOptions) ? resolved.selectedOptions : [];\nfor (var selectedIndex = 0; selectedIndex < selectedOptions.length; selectedIndex++) {\n  var item = selectedOptions[selectedIndex] || {};\n  var match = findBySr(item);\n  if (match) {\n    addMapping(match.segmentCode, optionTreeVersionName(match.option));\n    continue;\n  }\n  var fallbackSegmentCode = isValidSegmentCode(item.segmentCode) ? item.segmentCode : \"\";\n  var fallbackTreeVersionName = itemTreeNameHyphenVersion(item);\n  addMapping(fallbackSegmentCode, fallbackTreeVersionName);\n}\nvar preferenceUpdates = selectedMappings.map(function(mapping) {\n  return { segmentCode: mapping.segmentCode, treeVersion: mapping.treeVersionName };\n});\n\nvar payload = {\n  chartOfAccountsId: String(ctx.chartOfAccountsId !== undefined && ctx.chartOfAccountsId !== null ? ctx.chartOfAccountsId : \"0\"),\n  targetObject: \"balances\",\n  preferenceUpdates: preferenceUpdates\n};\n\nreturn payload;"
