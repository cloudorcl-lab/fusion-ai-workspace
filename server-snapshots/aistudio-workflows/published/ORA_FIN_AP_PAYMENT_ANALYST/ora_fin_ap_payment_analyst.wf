          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.25
              },
              "code": "ORA_LLM_MODEL_PROVIDER_CERT_BASIC_LLAMA_3_3_70B",
              "model": "ORA_LLM_MODEL_GPT_OSS_120B",
              "modelName": "GPT OSS 120B (Basic)",
              "provider": "CERT_BASIC"
            },
            "name": "Clean user input"
          },
          "outcomes": {
            "success": "1766030339192"
          },
          "code": "FIN_AP_LLM_CLEAN_USER_INPUT",
          "convergenceTargetId": "1766030339192",
          "id": "1771060179976",
          "inputs": [
            {
              "id": "1771060179978_1",
              "name": "prompt",
              "type": "string",
              "value": "# ROLE\nYou are an Entity Normalization Agent. Your sole task is to clean and standardize entity names within the User Message and Chat History by matching them against provided Master Lists.\n\n# INPUTS\n1) User Message: {{$context.$system.$inputMessage}}\n2) Chat History: {{$context.$triggers.REST.$input.chatHistory}}\n3) Suppliers: {{$context.$triggers.REST.$input.suppliers}}\n4) Payment Terms: {{$context.$triggers.REST.$input.paymentTerms}}\n5) Legal Entities: {{$context.$triggers.REST.$input.legalEntities}}\n\n# OBJECTIVE\nScan the User Message and Chat History for any fuzzy mentions of entities. If a match is found in the Master Lists, replace the mention with the EXACT string from the Master List.\n\nIf the matched entity is mentioned without an explicit entity label, and adding the label improves clarity, rewrite it as:\n- \"supplier <Supplier Name>\" for supplier matches\n- \"payment term <Payment Term>\" for payment term matches\n- \"legal entity <Legal Entity Name>\" for legal entity matches\n\nOnly add the label when the text refers to a matched entity and the label is not already present.\n\n# CRITICAL MATCHING & REPLACEMENT RULES\n- Standardization Priority: You MUST replace lowercase or improperly capitalized mentions with the exact casing found in the Master List.\n- Numeric Exception: While you should not change standalone numeric values (like amounts or dates), you MUST update numbers that are part of an entity name if the Master List casing or spacing is different.\n- Strict Replacement: Replace ONLY the entity name and, when applicable, add only the entity label immediately before the matched entity. Do NOT alter punctuation, surrounding grammar, JSON structures, or non-entity numeric values.\n- Closed-World Constraint: Use ONLY the names provided in the Master Lists. If a term is not in the list, leave it exactly as it is.\n- No Commentary: Output ONLY the requested JSON. No explanations.\n\n# CATEGORY-SPECIFIC GUIDANCE\n- Payment Terms: Be highly sensitive to alphanumeric patterns. These take precedence over general \"no number change\" rules.\n- Suppliers & Legal Entities: Match full legal names and formal suffixes exactly as they appear in the source data.\n- Label Injection Rule: Add entity labels only for matched entities, and only when the label is missing and improves clarity. Do not add labels for unmatched terms.\n\n# OUTPUT FORMAT (STRICT JSON)\n{\n  \"userMessage\": \"<standardized user message>\",\n  \"chatHistory\": \"<standardized chat history>\"\n}"
            }
          ],
          "outputSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"userMessage\": {\n      \"type\": \"string\",\n      \"description\": \"The cleaned user message with matched entity names replaced by exact master list values. All other text must remain unchanged.\"\n    },\n    \"chatHistory\": {\n      \"type\": \"string\",\n      \"description\": \"The cleaned chat history with matched entity names replaced by exact master list values. All other content, structure, and formatting must remain unchanged.\"\n    }\n  },\n  \"required\": [\"userMessage\", \"chatHistory\"],\n  \"additionalProperties\": false\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Handle unsupported prompts",
            "returnType": "array",
            "sourceCode": "const generateUnsupportedQueryResponse = () => {\n  const message = \"I'm afraid I can't help with that specific request. My current expertise is limited to payables and upcoming payment information—specifically when looking at suppliers, payment terms, or legal entities. If you have a question regarding those areas, I'm ready to help!\";\n\n  return [\n    {\n      type: \"text\",\n      content: message,\n      sequence: 1\n    }\n  ];\n};\n\n\nconst output = generateUnsupportedQueryResponse();\nreturn output;"
          },
          "outcomes": {
