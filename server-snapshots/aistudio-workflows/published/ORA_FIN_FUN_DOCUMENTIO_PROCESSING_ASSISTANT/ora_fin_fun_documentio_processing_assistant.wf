ageName,\n      code: code,\n      message: message\n    }\n  };\n}\n\nvar node = $context.$nodes.FIN_FUN_BO_DOCUMENT_INGESTION;\nvar nodeStatus = node && typeof node.$status === \"string\" ? node.$status.trim().toUpperCase() : null;\nvar output = node ? normalizeStageOutput(node.$output) : null;\n\nif (nodeStatus === \"FAILURE\") {\n  return executionError(node, \"Document Ingestion\");\n}\nif (!output || typeof output !== \"object\") {\n  return {\n    status: \"ERROR\",\n    error: {\n      stage: \"Document Ingestion\",\n      code: \"MALFORMED_STAGE_RESPONSE\",\n      message: \"Document Ingestion response is missing or invalid.\"\n    }\n  };\n}\nif (output.status && String(output.status).trim().toUpperCase() !== \"SUCCESS\") {\n  return {\n    status: \"ERROR\",\n    error: {\n      stage: \"Document Ingestion\",\n      code: \"STAGE_FAILED\",\n      message: \"Document Ingestion returned failure status.\"\n    }\n  };\n}\n\noutput.status = output.status || \"SUCCESS\";\nreturn output;"
