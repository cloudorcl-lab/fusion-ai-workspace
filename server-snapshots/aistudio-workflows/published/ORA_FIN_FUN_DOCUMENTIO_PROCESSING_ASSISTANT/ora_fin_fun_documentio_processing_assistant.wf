        {
          "metadata": {
            "name": "Document Processor Error",
            "returnType": "object",
            "sourceCode": "function messageFrom(value) {\n  if (value === undefined || value === null || value === \"\") {\n    return null;\n  }\n  if (typeof value === \"string\") {\n    return value;\n  }\n  return JSON.stringify(value);\n}\n\nvar node = $context.$nodes.DOCUMENT_PROCESSOR;\nvar errorInfo = node ? node.$error : null;\nvar message = null;\nvar code = \"DOCUMENT_PROCESSOR_FAILED\";\n\nif (errorInfo && typeof errorInfo === \"object\") {\n  message = messageFrom(errorInfo.$info) || messageFrom(errorInfo.message) || messageFrom(errorInfo.error);\n  code = errorInfo.code || code;\n} else {\n  message = messageFrom(errorInfo);\n}\n\nreturn {\n  status: \"ERROR\",\n  error: {\n    stage: \"Document Processor\",\n    code: code,\n    message: message || \"Document Processor failed.\"\n  }\n};"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "FIN_FUN_CODE_DOCUMENT_PROCESSOR_ERROR",
          "id": "41",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Prepare Payload for GenAI",
            "returnType": "object",
            "sourceCode": "var promptText = $context.$nodes.FIN_FUN_CODE_DOCUMENT_PAYLOAD.$output.result.stageContext.payload.customPrompt + \"\\n Document Text: \\n==================================== \\n\" + $context.$nodes.DOCUMENT_PROCESSOR.$output.text ;\n\nreturn {\n  status: \"SUCCESS\",\n  documentId: $context.$nodes.FIN_FUN_BO_DOCUMENT_CAPTURE.$output.documentId,\n  promptText: promptText\n};"
          },
          "outcomes": {
            "success": "1780048813759"
