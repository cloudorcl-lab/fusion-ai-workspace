          "convergenceTargetId": "15",
          "id": "8",
          "inputs": [
            {
              "id": "8_condition",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.FIN_FUN_CODE_DOCUMENT_PAYLOAD.$output.result.stageContext.payload.transformationRequired }}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Prepare Transformation Payload",
            "returnType": "object",
            "sourceCode": "function parseMaybeJson(value) {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n  var trimmed = value.trim();\n  if (!trimmed) {\n    return value;\n  }\n  if ((trimmed[0] === \"{\" && trimmed[trimmed.length - 1] === \"}\") || (trimmed[0] === \"[\" && trimmed[trimmed.length - 1] === \"]\")) {\n    try {\n      return JSON.parse(trimmed);\n    } catch (e) {\n      return value;\n    }\n  }\n  return value;\n}\n\nfunction normalizeStageOutput(nodeOutput) {\n  var output = parseMaybeJson(nodeOutput);\n  if (output && output.result !== undefined) {\n    output = parseMaybeJson(output.result);\n  }\n  if (output && typeof output.content === \"string\") {\n    output.content = parseMaybeJson(output.content);\n  }\n  return output;\n}\n\nvar verificationResult = $context.$nodes.FIN_FUN_CODE_DOCUMENT_PAYLOAD.$output.result || {};\nvar base = (verificationResult.stageContext && verificationResult.stageContext.payload) || {};\nvar recognition = normalizeStageOutput($context.$nodes.FIN_FUN_BO_DOCUMENT_RECOGNITION.$output) || {};\nvar payload = {};\n\nObject.keys(base).forEach(function (key) {\n  if (key !== \"documentIdentifier\" && key !== \"status\") {\n    payload[key] = base[key];\n  }\n});\nObject.keys(recognition).forEach(function (key) {\n  if (key !== \"error\") {\n    payload[key] = recognition[key];\n  }\n});\npayload.direction = payload.direction || \"ORA_INBOUND\";\nreturn {\n  stageContext: {\n    payload: payload\n  }\n};"
          },
          "outcomes": {
            "success": "10"
          },
          "code": "FIN_FUN_CODE_PREPARE_TRANSFORMATION_PAYLOAD",
          "id": "9",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_FUN_DOCUMENTIO_STAGE_PROCESSOR",
            "functionName": "stage_processor",
            "name": "Document Transformation"
          },
          "outcomes": {
            "success": "11"
          },
          "code": "FIN_FUN_BO_DOCUMENT_TRANSFORMATION",
          "id": "10",
          "inputs": [
            {
              "id": "10_stagename",
              "name": "stagename",
              "type": "string",
              "value": "transform"
            },
            {
              "id": "10_stageContext",
              "name": "stageContext",
              "type": "string",
              "value": "{{$context.$nodes.FIN_FUN_CODE_PREPARE_TRANSFORMATION_PAYLOAD.$output.result.stageContext}}"
            }
          ],
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Validate Transformation Response",
            "returnType": "object",
            "sourceCode": "function parseValue(raw) {\n  if (typeof raw !== \"string\") {\n    return raw;\n  }\n  var parsed = JSON.parse(raw);\n  if (typeof parsed === \"string\") {\n    parsed = JSON.parse(parsed);\n  }\n  return parsed;\n}\n\nfunction normalizeFlag(value, defaultValue) {\n  if (value === undefined || value === null || value === \"\") {\n    return defaultValue;\n  }\n  if (typeof value === \"boolean\") {\n    return value;\n  }\n  return String(value).trim().toLowerCase() !== \"false\";\n}\n\nfunction parseMaybeJson(value) {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n  var trimmed = value.trim();\n  if (!trimmed) {\n    return value;\n  }\n  if ((trimmed[0] === \"{\" && trimmed[trimmed.length - 1] === \"}\") || (trimmed[0] === \"[\" && trimmed[trimmed.length - 1] === \"]\")) {\n    try {\n      return JSON.parse(trimmed);\n    } catch (e) {\n      return value;\n    }\n  }\n  return value;\n}\n\nfunction normalizeStageOutput(nodeOutput) {\n  var output = parseMaybeJson(nodeOutput);\n  if (output && output.result !== undefined) {\n    output = parseMaybeJson(output.result);\n  }\n  if (output && typeof output.content === \"string\") {\n    output.content = parseMaybeJson(output.content);\n  }\n  return output;\n}\n\nfunction executionError(node, stageName) {\n  var errorInfo = node ? node.$error : null;\n  var message = stageName + \" execution failed.\";\n  var code = \"EXECUTION_ERROR\";\n  if (errorInfo && typeof errorInfo === \"object\") {\n    if (typeof errorInfo.$info === \"string\" && errorInfo.$info.trim()) {\n      message = errorInfo.$info;\n    } else if (typeof errorInfo.message === \"string\" && errorInfo.message.trim()) {\n      message = errorInfo.message;\n    } else if (typeof errorInfo.error === \"string\" && errorInfo.error.trim()) {\n      message = errorInfo.error;\n    }\n    if (errorInfo.code) {\n      code = errorInfo.code;\n    }\n  }\n  return {\n    status: \"ERROR\",\n    error: {\n      stage: stageName,\n      code: code,\n      message: message\n    }\n  };\n}\n\nvar node = $context.$nodes.FIN_FUN_BO_DOCUMENT_TRANSFORMATION;\nvar nodeStatus = node && typeof node.$status === \"string\" ? node.$status.trim().toUpperCase() : null;\nvar output = node ? normalizeStageOutput(node.$output) : null;\n\nif (nodeStatus === \"FAILURE\") {\n  return executionError(node, \"Document Transformation\");\n}\nif (!output || typeof output !== \"object\") {\n  return {\n    status: \"ERROR\",\n    error: {\n      stage: \"Document Transformation\",\n      code: \"MALFORMED_STAGE_RESPONSE\",\n      message: \"Document Transformation response is missing or invalid.\"\n    }\n  };\n}\nif (output.status && String(output.status).trim().toUpperCase() !== \"SUCCESS\") {\n  return {\n    status: \"ERROR\",\n    error: {\n      stage: \"Document Transformation\",\n      code: \"STAGE_FAILED\",\n      message: \"Document Transformation returned failure status.\"\n    }\n  };\n}\nif (output.content === undefined || output.content === null || output.content === \"\") {\n  return {\n    status: \"ERROR\",\n    error: {\n      stage: \"Document Transformation\",\n      code: \"MISSING_CONTENT\",\n      message: \"Document Transformation did not return content.\"\n    }\n  };\n}\n\noutput.status = output.status || \"SUCCESS\";\nreturn output;"
          },
          "outcomes": {
            "success": "13"
          },
          "code": "FIN_FUN_CODE_VALIDATE_TRANSFORMATION_RESPONSE",
          "id": "11",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
