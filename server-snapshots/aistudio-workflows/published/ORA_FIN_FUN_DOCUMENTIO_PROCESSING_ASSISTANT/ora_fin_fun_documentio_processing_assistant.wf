          "code": "FIN_FUN_CODE_PREPARE_PAYLOAD_FOR_GENAI",
          "id": "1779799207634",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "DocIO GenAI Response",
            "returnType": "object",
            "sourceCode": "function parseMaybeJson(value) {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n  var trimmed = value.trim();\n  if (trimmed.indexOf(\"```json\") === 0) {\n    trimmed = trimmed.replace(\"```json\", \"\").replace(\"```\", \"\").trim();\n  }\n  if (!trimmed) {\n    return value;\n  }\n  if ((trimmed[0] === \"{\" && trimmed[trimmed.length - 1] === \"}\") || (trimmed[0] === \"[\" && trimmed[trimmed.length - 1] === \"]\")) {\n    try {\n      return JSON.parse(trimmed);\n    } catch (e) {\n      return value;\n    }\n  }\n  return value;\n}\n\nvar llmOutput = $context.$nodes.FIN_FUN_DOCIO_GENERIC_ASSISTANT.$output;\nvar normOutput = parseMaybeJson(llmOutput);\nvar result = {\n  businessObject: \"\",\n  documentType: \"\",\n  status: \"SUCCESS\",\n  content: normOutput\n};\nreturn result;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "FIN_FUN_CODE_DOCIO_GENAI_RESPONSE",
          "id": "36",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
