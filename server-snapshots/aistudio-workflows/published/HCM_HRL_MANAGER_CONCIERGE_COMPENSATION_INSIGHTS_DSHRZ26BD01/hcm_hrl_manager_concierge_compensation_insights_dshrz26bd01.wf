          "metadata": {
            "name": "PrepareVariableValues",
            "returnType": "object",
            "sourceCode": "const userPrompt = $context.$system.$inputMessage;\nconst hint = $context.$app.$OraMessageHint;\nconst strAction = $context.$app.$OraAction;\nconst actionDetails = $context.$variables.actionDetails; \nconst action = $context.$app.$OraAction;\nconst panel = $context.$app.$OraPanelName;\n\n\nlet userMessageHint = \"QUERY\";\nlet addPrompt = '';\nlet newPrompt = userPrompt;\nvar actionCode='' ;\n\nif  (hint === 'InvokeAction')  {\nactionCode='' ;\n\nif (typeof strAction === 'object') {\n    actionCode = strAction.actionCode;  \n} else {\n  var idx = strAction.indexOf('actionCode');\n  if (idx !== -1) {\n  var colonIdx = strAction.indexOf(':', idx);\n  if (colonIdx !== -1) {\n    var quoteStart = strAction.indexOf('\"', colonIdx);\n    if (quoteStart !== -1) {\n      var quoteEnd = strAction.indexOf('\"', quoteStart + 1);\n      if (quoteEnd !== -1) {\n        actionCode = strAction.substring(quoteStart + 1, quoteEnd);\n      }\n    }\n  }\n}\n}\nactionCode = actionCode.replace(/\\\\+$/, '');\nnewPrompt = \"Action is not configured. Showing default response.\";\n\nif (actionCode && actionDetails && Array.isArray(actionDetails.Actions)) {\n  for (var i = 0; i < actionDetails.Actions.length; i++) {\n    if (actionDetails.Actions[i].actionCode === actionCode) {\n      newPrompt = actionDetails.Actions[i].actionPrompt;\n      break;\n    }\n  }\n }\n}\n\nif (hint === \"InitCommunications\") {\n  addPrompt = \"list all employees compensation and talent details\";\n} else if (hint === \"FillParameters\") {\n  if (actionDetails && Array.isArray(actionDetails.Actions)) {\n    for (let i = 0; i < actionDetails.Actions.length; i++) {\n      if (actionDetails.Actions[i].actionCode === \"modelCompensationCycleScenarios\") {\n        addPrompt = actionDetails.Actions[i].actionPrompt;\n        break;\n      }\n    }\n  }\n}\n  \nif (addPrompt !== '') \n  newPrompt = addPrompt; \n\n\n\nif ( hint === \"InitDisplay\" || hint === \"Summary\" ||  hint === \"InitActions\" || hint === \"InitSubtitle\" || hint ===  \"AdditionalContent\") {\n    userMessageHint = \"INIT\";\n} else if ( hint === \"InitCommunications\" || hint === \"FillParameters\" || hint === \"GenerateTemplateContent\" || hint === \"SendCommunication\") {\n    userMessageHint = \"COMM\";\n} else if (typeof action !== \"undefined\") {\n    if (action.includes(\"sendTeamIntroduction\") || action.includes(\"modelingStrategy\") || action.includes(\"modelingOption\") ) {\n        userMessageHint = \"ACTION\";\n    }\n} else {\n    userMessageHint = \"QUERY\";\n}\n\n\nlet flowPath = \"QUERY\";\n\nif ( panel === \"scenerioModeling\" || actionCode.includes(\"modelingOption-Scenerio\")) {\n  flowPath = \"NOQUERY\";\n} \n\nlet result = {actionCode : actionCode, newPrompt: newPrompt, userMessageHint: userMessageHint, flowPath: flowPath}\n\nreturn result;"
          },
