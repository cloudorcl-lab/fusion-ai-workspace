              "name": "condition",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.attachmentTrackerId != null && $context.$triggers.REST.$input.attachmentTrackerId != undefined && $context.$triggers.REST.$input.attachmentTrackerId.trim() !=''}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_RECRUITING_RECRUITINGCANDIDATEATTACHMENTTEXTEXTRACTOR",
