              "type": "string"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"attachmentText\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Set resume content from attachmentTrackerId"
          },
          "outcomes": {
            "success": "1761794358638"
          },
          "code": "SET_RESUME_CONTENT_FROM_ATTACHMENTTRACKERID",
          "id": "1769792968332",
          "inputs": [
            {
              "id": "1769792985043",
              "name": "resumeContent",
              "scope": "JOB",
              "type": "string",
              "value": "{{$context.$nodes.GET_RESUME_TEXT_FROM_ATTACHMENTTRACKERID.$output.attachmentText}}"
            }
          ],
          "type": "SET_FIELDS"
        },
