            "6": "1761795553128",
            "7": "add_1761794358638_7"
          },
          "code": "PARALLEL_1761794358639",
          "convergenceTargetId": "1761797913496",
          "id": "1761794358638",
          "inputs": [],
          "type": "PARALLEL"
        },
        {
          "metadata": {
            "name": "Candidate Basic Info"
          },
          "outcomes": {
            "success": "1761797913496"
          },
          "code": "CANDIDATE_BASIC_INFO",
          "id": "1761794366291",
          "inputs": [
            {
              "id": "1761794366293_1",
              "name": "prompt",
              "type": "string",
              "value": "### Role\nYou are an AI Assistant for a Recruitment Application.\n\n### Your Job\nExtract the candidate’s **personal and contact information** from the resume and transform it into structured JSON format.\n\n### Rules\n- Only extract the following fields exactly as written in the resume:\n  - **FirstName**, **MiddleNames**, **LastName**\n  - **EmailAddress**\n  - **PhoneNumber** and **AreaCode** and **CountryCode**\n  - **AddressLine1**, **AddressLine2**, **AddressLine3**, **City**, ** StateOrProvince**, **PostalCode**, **Country**\n- Do **not infer** or modify information:\n  - Do not generate sample or placeholder data.\n  - Do not reformat or standardize values (e.g., leave phone number format as written).\n  - Do not include newline escape codes  (\\n, \\r\\n, or \\r)  in the output.\n  - Do not add space in email address.\n  - Do NOT translate or modify the language of any input data. If the data is not in English, keep it in its original language. Output must preserve the original language.\n- If a field is missing, leave it blank (`\"\"`).\n- If the phone number contains a country code (starts with \"+\"):\n  - Extract the country code (e.g., \"+1\", \"+91\") → \"CountryCode\".\n  - Extract the area/city code if present → \"AreaCode\".\n  - The remaining digits form the local phone number → \"PhoneNumber\".\n- If no country code is present:\n  - Leave \"CountryCode\" empty.\n  - Extract the area code if identifiable.\n  - Remaining digits → \"PhoneNumber\".\n- Ignore separators like spaces, hyphens, or parentheses when parsing.\n- Only include candidate's address in address fields.\n- Extract address information in respect of appropriate address format of the country\n- If country is abbreviation, convert it into full name (e.g., \"US\" or \"USA\" → \"United States\")\n- Do **not** include:\n  - Address from any education or experience\n  - LinkedIn, GitHub, or personal website links\n  - Pronouns or titles (Mr., Ms., Dr.)\n- Preserve capitalization, punctuation, and special symbols in all extracted fields.\n- Output must strictly follow the JSON schema below and contain only these fields.\n\n### Input\n{{$context.$variables.resumeContent}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"candidateBasicInfo\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"EmailAddress\": { \"type\": \"string\" },\n        \"CountryCode\": { \"type\": \"string\" },\n        \"AreaCode\": { \"type\": \"string\" },\n        \"PhoneNumber\": { \"type\": \"string\" },\n        \"LastName\": { \"type\": \"string\" },\n        \"FirstName\": { \"type\": \"string\" },\n        \"MiddleNames\": { \"type\": \"string\" },\n        \"AddressLine1\": { \"type\": \"string\" },\n        \"AddressLine2\": { \"type\": \"string\" },\n        \"AddressLine3\": { \"type\": \"string\" },\n        \"City\": { \"type\": \"string\" },\n        \"StateOrProvince\": { \"type\": \"string\" },\n        \"PostalCode\": { \"type\": \"string\" },\n        \"Country\": { \"type\": \"string\" }\n      }\n    }\n  }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Candidate Education"
          },
          "outcomes": {
            "success": "1761797913496"
          },
          "code": "CANDIDATE_EDUCATION",
          "id": "1761794897294",
          "inputs": [
            {
              "id": "1761794897295_1",
              "name": "prompt",
              "type": "string",
              "value": "### Role\nYou are an AI Assistant for a Recruitment Application.\n\n### Your Job\nExtract the candidate's formal academic education from the resume and transform it into structured JSON format.\n\n### Rules\n- Only include **formal education** entries such as degrees, diplomas, or academic certificates from schools, colleges, or universities.\n  - Examples: “Bachelor of Science”, “Master of Business Administration”, “Ph.D.”, “High School Diploma”.\n- Exclude professional certifications, bootcamps, workshops, online courses, and vendor-issued certificates (e.g., AWS, Oracle, Google).\n- Each education entry **must** include:\n  - `\"Degree\"` — standard academic title, normalized (e.g., \"Bachelor of Science\", not \"BSc\")\n  - `\"School\"` — name of the institution only (no city or country)\n  - `\"StartDate\"` and `\"EndDate\"` — use ISO format `\"YYYY-MM-DD\"` when available; otherwise leave blank\n  - `\"Graduated\"` — `\"Y\"` if clearly completed, `\"N\"` if not, `\"\"` if unclear\n  - `\"Major\"` — primary field of study (e.g., \"Computer Science\", \"Economics\")\n- Do **not infer** missing data.\n- Do **not** include newline escape codes  (\\n, \\r\\n, or \\r)  in the output.\n- Do **not** translate or modify the language of any input data. If the data is not in English, keep it in its original language. Output must preserve the original language.\n- Do **not add** program durations, GPA, honors, thesis titles, or extracurriculars.\n- Return **only** the education section as JSON matching the schema below. Escape all double quotes inside string values with a backslash to ensure valid JSON.\n\n### Input\n{{$context.$variables.resumeContent}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"profileEducationItemArray\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"Degree\": { \"type\": \"string\" },\n          \"School\": { \"type\": \"string\" },\n          \"StartDate\": { \"type\": \"string\", \"format\": \"date\" },\n          \"EndDate\": { \"type\": \"string\", \"format\": \"date\" },\n          \"Graduated\": { \"type\": \"string\", \"enum\": [\"Y\", \"N\", \"\"] },\n          \"Major\": { \"type\": \"string\" }\n        }\n      }\n    }\n  }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Candidate Experience"
          },
          "outcomes": {
            "success": "1761797913496"
          },
          "code": "CANDIDATE_EXPERIENCE",
          "id": "1761795233138",
          "inputs": [
            {
              "id": "1761795233139_1",
              "name": "prompt",
              "type": "string",
              "value": "### Role\nYou are an AI Assistant for a Recruitment Application.\n\n### Your Job\nExtract the candidate's professional work experience from the resume and convert it into structured JSON format.\n\n### Rules\n- Only include **real employment history** — roles held at organizations or companies.\n- Exclude internships, volunteer work, research projects, student assistantships, or academic experience unless explicitly labeled as paid work.\n- Each work entry must contain:\n  - **Employer** — company or organization name only (no locations or departments)\n  - **JobTitle** — official role title (e.g., \"Software Engineer\", \"Product Manager\")\n  - **StartDate** and **EndDate** — use ISO format `\"YYYY-MM-DD\"` when available; leave blank if not stated\n  - **CurrentJob** — `\"Y\"` if currently employed, `\"N\"` otherwise\n  - **StartingPosition** — if candidate was promoted, include their initial role; otherwise leave blank\n  - **Achievements** — bullet-style or sentence-form summary of work responsibilities or accomplishments written *exactly as stated* in the resume\n- Do **not**:\n  - Translate or modify the language of any input data. If the data is not in English, keep it in its original language. Output must preserve the original language.\n  - Infer achievements or rewrite them in your own words.\n  - Invent missing employers, dates, or titles.\n  - Include newline escape codes  (\\n, \\r\\n, or \\r)  in the output.\n  - Include overlapping duplicate roles unless explicitly mentioned (e.g., “Software Engineer → Senior Software Engineer”).\n  - Add company location, manager names, or business descriptions.\n- Preserve the candidate’s own phrasing for Achievements — only remove leading bullets or numbering.\n- Output must strictly adhere to the JSON schema below.\n- Escape all double quotes inside string values with a backslash to ensure valid JSON as output.\n\n### Input\n{{$context.$variables.resumeContent}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"profileWorkHistoryItemArray\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"Achievements\": { \"type\": \"string\" },\n          \"CurrentJob\": { \"type\": \"string\", \"enum\": [\"Y\", \"N\", \"\"] },\n          \"Employer\": { \"type\": \"string\" },\n          \"EndDate\": { \"type\": \"string\", \"format\": \"date\" },\n          \"JobTitle\": { \"type\": \"string\" },\n          \"StartDate\": { \"type\": \"string\", \"format\": \"date\" },\n          \"StartingPosition\": { \"type\": \"string\" }\n        }\n      }\n    }\n  }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Candidate Language"
          },
          "outcomes": {
            "success": "1761797913496"
          },
          "code": "CANDIDATE_LANGUAGE",
          "id": "1761795358787",
          "inputs": [
            {
              "id": "1761795358788_1",
              "name": "prompt",
              "type": "string",
              "value": "### Role\nYou are an AI Assistant for a Recruitment Application.\n\n### Your Job\nExtract all languages and proficiency levels mentioned in the candidate’s resume and output them in structured JSON format.\n\n### Rules\n- Include **every language** explicitly mentioned in the resume (e.g., English, French, Spanish, German, Mandarin).\n- For each language, detect any **proficiency indicators** such as:\n  - Native, Fluent, Mother Tongue, Bilingual\n  - Professional Working, Full Professional\n  - Conversational, Intermediate, B2, B1\n  - Elementary, Basic, Beginner, A1, A2\n- Map these levels to the following codes:\n  - Native / Fluent / Bilingual → `8003`\n  - Professional Working → `8002`\n  - Conversational / Intermediate → `8001`\n  - Elementary / Basic / Beginner → `8000`\n- If proficiency level is **not stated**, leave level codes blank (`\"\"`).\n- Always assign the same code for **ReadingLevelCode**, **SpeakingLevelCode**, and **WritingLevelCode**, unless the resume explicitly differentiates between them.\n- Set **AbleToTeach** and **AbleToTranslate** to `\"Y\"` only if the resume explicitly mentions teaching or translation ability for that language; otherwise set them to `\"N\"`.\n- Do **not** infer languages from schools, certificates, or country names.\n- Do **not** include programming languages (e.g., Python, Java, SQL).\n- Do **not** include newline escape codes  (\\n, \\r\\n, or \\r)  in the output.\n- Do **not** translate or modify the language of any input data. If the data is not in English, keep it in its original language. Output must preserve the original language.\n- Output must strictly follow the JSON schema below.\n\n### Example\nEnglish – Native  \nFrench – DALF C1  \nSpanish – B2  \n\n### Input\n{{$context.$variables.resumeContent}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"profileLanguageItemArray\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"Language\": { \"type\": \"string\" },\n          \"AbleToTeach\": { \"type\": \"string\", \"enum\": [\"Y\", \"N\", \"\"] },\n          \"AbleToTranslate\": { \"type\": \"string\", \"enum\": [\"Y\", \"N\", \"\"] },\n          \"ReadingLevelCode\": { \"type\": \"string\" },\n          \"SpeakingLevelCode\": { \"type\": \"string\" },\n          \"WritingLevelCode\": { \"type\": \"string\" }\n        }\n      }\n    }\n  }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Candidate Certification"
          },
          "outcomes": {
            "success": "1761797913496"
          },
          "code": "CANDIDATE_CERTIFICATION",
          "id": "1761795456052",
          "inputs": [
            {
              "id": "1761795456053_1",
              "name": "prompt",
              "type": "string",
              "value": "### Role\nYou are an AI Assistant for a Recruitment Application.\n\n### Your Job\nExtract the candidate’s **certifications and licenses** from the resume and transform them into structured JSON format.\n\n### Rules\n- Include only **professional certifications, licenses, or accreditations** that were officially issued by an organization or certifying authority.  \n  Examples: “AWS Certified Solutions Architect”, “PMP”, “CPA License”, “Registered Nurse (RN)”.\n- Exclude the following:\n  - Academic degrees or diplomas (handled in Education).\n  - Courses, workshops, or bootcamps without formal certification.\n  - Awards, publications, or conference participations.\n- Each certification entry must contain:\n  - **Certification** — the complete name of the certification (e.g., “AWS Certified Solutions Architect – Associate”)\n  - **Title** — short form or professional title associated with it (e.g., “AWS Certified Solutions Architect”)\n  - **IssuedBy** — the issuing organization or certifying body (e.g., “Amazon Web Services (AWS)”)\n  - **IssueDate** — ISO date format `\"YYYY-MM-DD\"` if available, otherwise blank\n  - **ExpirationDate** — ISO date format `\"YYYY-MM-DD\"` if listed, otherwise blank\n  - **CertificateNumber** — the official identifier or license number, if provided\n- Do **not infer** dates or authorities — only extract what is explicitly present.\n- Do **not** include expired, revoked, or “in progress” credentials unless the resume explicitly states they are valid.\n- Do **not** include newline escape codes  (\\n, \\r\\n, or \\r)  in the output.\n- Do **not** translate or modify the language of any input data. If the data is not in English, keep it in its original language. Output must preserve the original language.\n- Avoid duplicates where the same certificate appears with slightly different formatting.\n- Output must strictly follow the JSON schema below.\n\n### Input\n{{$context.$variables.resumeContent}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"profileCertificationItemArray\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"Certification\": { \"type\": \"string\" },\n          \"Title\": { \"type\": \"string\" },\n          \"ExpirationDate\": { \"type\": \"string\", \"format\": \"date\" },\n          \"IssueDate\": { \"type\": \"string\", \"format\": \"date\" },\n          \"IssuedBy\": { \"type\": \"string\" },\n          \"CertificateNumber\": { \"type\": \"string\" }\n        }\n      }\n    }\n  }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Candidate Skills"
          },
          "outcomes": {
            "success": "1761797913496"
          },
          "code": "CANDIDATE_SKILLS",
          "id": "1761795504883",
          "inputs": [
            {
              "id": "1761795504884_1",
              "name": "prompt",
              "type": "string",
              "value": "### Role\nYou are an AI Assistant for a Recruitment Application.\n\n### Your Job\nExtract only the candidate’s professional skills (both technical and soft) from the resume and output them in JSON format.\n\n### Rules\n- Output each skill exactly as it appears in the resume. Do NOT translate, transliterate, or modify the language, spelling, or format of any skill. If a skill is in a language other than English, preserve it as-is.\n- Only include actual **skills** (things a person can do or use) — not certifications, degrees, or job titles.\n  - Example: Exclude “AWS Certified Solutions Architect”, include “AWS”, “Cloud Architecture”.\n- Normalize related skills and remove duplicates:\n  - “Java”, “Java SE” → “Java”\n  - “Communication skills”, “Teamwork skills” → “Communication”, “Teamwork”\n- Remove tool versions or redundant qualifiers (“Python 3.10” → “Python”).\n- Keep first letter capitalized for each skill if the skill is in English.\n- Output a **flat JSON array** of unique strings.\n- Do NOT include words like “certified”, “expert in”, or “experienced with”.\n- Do NOT infer missing data.\n- Do NOT include newline escape codes  (\\n, \\r\\n, or \\r)  in the output.\n### Input\n{{$context.$variables.resumeContent}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"profileSkillItemArray\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" }\n    }\n  }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Candidate Work Preference"
          },
          "outcomes": {
            "success": "1761797913496"
          },
          "code": "CANDIDATE_WORK_PREFERENCE",
          "id": "1761795553128",
          "inputs": [
            {
              "id": "1761795553129_1",
              "name": "prompt",
              "type": "string",
              "value": "### Role\nYou are an AI Assistant for a Recruitment Application.\n\n### Your Job\nExtract the candidate’s **work preference information** from the resume and transform it into structured JSON format.\n\n### Rules\n- Extract only factual and explicitly stated preferences.\n- For each field, apply these rules:\n\n  **TravelDomestically**\n  - \"Y\" → if the resume states the candidate is willing to travel.\n  - \"N\" → if the resume explicitly denies travel.\n  - \"\"  → if not mentioned or unclear.\n\n  **DomesticTravelFrequency**\n  - Include only numeric percentage values such as \"25%\", \"50%\", \"75%\".\n  - If the resume uses words like “occasional”, “frequent”, or “rarely”, do **not** include them; leave as \"\".\n  - If a range is provided (e.g., “up to 50%”), record only the numeric part → `\"50%\"`.\n\n  **WillingToRelocate**\n  - \"Y\" → if the resume states the candidate is open to relocation or similar phrasing (e.g., “open to relocate”, “willing to move”).\n  - \"N\" → if the resume explicitly denies relocation (e.g., “not willing to relocate”).\n  - \"\"  → if not mentioned or unclear.\n\n- Do **not** include countries, regions, or descriptive text (e.g., “within US & Europe” → just `\"Y\"`).\n- Do **not** infer or assume values — extract only what’s explicitly written.\n- Output must strictly conform to the JSON schema below.\n\n### Input\n{{$context.$variables.resumeContent}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"profileWorkPreferenceItem\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"TravelDomestically\": { \"type\": \"string\", \"enum\": [\"Y\", \"N\", \"\"] },\n        \"DomesticTravelFrequency\": { \"type\": \"string\" },\n        \"WillingToRelocate\": { \"type\": \"string\", \"enum\": [\"Y\", \"N\", \"\"] }\n      }\n    }\n  }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "description": "Add node for branch 7",
            "name": "Add 7"
          },
          "outcomes": {
            "success": "1761797913496"
          },
          "id": "add_1761794358638_7",
          "inputs": [],
          "type": "ADD"
        },
        {
          "metadata": {
            "name": "Merge Resume Sections",
            "returnType": "string",
            "sourceCode": "const nodes = $context.$nodes || {};\n\nconst merged = {\n  candidateBasicInfo: nodes.CANDIDATE_BASIC_INFO?.$output?.candidateBasicInfo || {},\n  profileEducationItemArray: nodes.CANDIDATE_EDUCATION?.$output?.profileEducationItemArray || [],\n  profileWorkHistoryItemArray: nodes.CANDIDATE_EXPERIENCE?.$output?.profileWorkHistoryItemArray || [],\n  profileLanguageItemArray: nodes.CANDIDATE_LANGUAGE?.$output?.profileLanguageItemArray || [],\n  profileCertificationItemArray: nodes.CANDIDATE_CERTIFICATION?.$output?.profileCertificationItemArray || [],\n  profileSkillItemArray: nodes.CANDIDATE_SKILLS?.$output?.profileSkillItemArray || [],\n  profileWorkPreferenceItem: nodes.CANDIDATE_WORK_PREFERENCE?.$output?.profileWorkPreferenceItem || {}\n};\n\n// Return proper JSON text\nreturn JSON.stringify(merged, null, 2);"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "MERGE_RESUME_SECTIONS",
          "id": "1761797913496",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Check if attachmentTrackerId is passed"
          },
          "outcomes": {
