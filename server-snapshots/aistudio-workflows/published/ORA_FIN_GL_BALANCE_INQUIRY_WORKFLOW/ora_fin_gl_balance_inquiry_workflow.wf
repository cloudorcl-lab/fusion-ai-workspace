        {
          "metadata": {
            "errorNodeId": "1777621780512",
            "name": "Extract Response Processor",
            "returnType": "object",
            "sourceCode": "const getColumnOrderFromFirstRow = (records) => {\n    if (!Array.isArray(records)) {\n        return [];\n    }\n\n    for (const record of records) {\n        if (!record || typeof record !== \"object\" || Array.isArray(record)) {\n            continue;\n        }\n\n        const columnOrder = Object.keys(record);\n\n        if (columnOrder.length > 0) {\n            return columnOrder;\n        }\n    }\n\n    return [];\n};\n\nconst getFirstLedgerLevelColumnOrder = (ledgerLevelAvData, sectionKeys) => {\n    if (!Array.isArray(ledgerLevelAvData)) {\n        return [];\n    }\n\n    for (const ledgerLevelData of ledgerLevelAvData) {\n        for (const sectionKey of sectionKeys) {\n            const columnOrder = getColumnOrderFromFirstRow(ledgerLevelData?.[sectionKey]?.records);\n\n            if (columnOrder.length > 0) {\n                return columnOrder;\n            }\n        }\n    }\n\n    return [];\n};\n\nconst buildAvKeyOrder = (data) => {\n    const avExtractResult = data?.avExtractResult || new Object();\n    const homogenousColumnOrder = getColumnOrderFromFirstRow(avExtractResult.homogenousLedgerSetAvData?.records);\n\n    return homogenousColumnOrder.length > 0\n        ? homogenousColumnOrder\n        : getFirstLedgerLevelColumnOrder(avExtractResult.ledgerLevelAvData, [\"currentLevelAvData\", \"childLevelAvData\"]);\n};\n\nconst getHierarchyResolverMessage = (items) =>\n    String(Array.isArray(items) ? items[0]?.hierarchyResolverMessage ?? \"\" : \"\").trim();\n\nconst isRecordObject = (value) =>\n    value !== null && typeof value === \"object\" && !Array.isArray(value);\n\nconst cloneRecordObject = (value) => JSON.parse(JSON.stringify(value));\n\nconst getUpdatedIntentDetails = (dataResponse) => {\n    const intentDetails = dataResponse?.avExtractResult?.intentDetails;\n\n    return isRecordObject(intentDetails) ? cloneRecordObject(intentDetails) : null;\n};\n\nconst applyUpdatedIntentDetails = (lastUsedQuery, dataResponse) => {\n    const updatedIntentDetails = getUpdatedIntentDetails(dataResponse);\n\n    if (!updatedIntentDetails || !isRecordObject(lastUsedQuery?.queryResponse)) {\n        return;\n    }\n\n    if (!Array.isArray(lastUsedQuery.queryResponse.queries)) {\n        lastUsedQuery.queryResponse.queries = [];\n    }\n\n    if (!isRecordObject(lastUsedQuery.queryResponse.queries[0])) {\n        lastUsedQuery.queryResponse.queries[0] = new Object();\n    }\n\n    lastUsedQuery.queryResponse.queries[0].intentDetails = updatedIntentDetails;\n};\n\n// Keep this collector aligned with the payload builder so retry uses the same failing status.\nconst NO_DATA_RESULT_CODE = \"GL_LA_INQ_DATA_NO_DATA\";\nconst isResultStatus = (value) =>\n    value && typeof value === \"object\" && !Array.isArray(value) &&\n    typeof value.category === \"string\";\nconst addResultStatus = (statuses, value) => {\n    if (isResultStatus(value)) {\n        statuses.push(value);\n    }\n};\nconst collectResultStatuses = (value) => {\n    const container = value?.result ?? value;\n    const statuses = [];\n\n    if (!container || typeof container !== \"object\" || Array.isArray(container)) {\n        return statuses;\n    }\n\n    addResultStatus(statuses, container);\n    addResultStatus(statuses, container.resultStatus);\n\n    const avExtractResult = container.avExtractResult || new Object();\n    addResultStatus(statuses, avExtractResult.homogenousLedgerSetAvData?.resultStatus);\n    if (Array.isArray(avExtractResult.ledgerLevelAvData)) {\n        for (const ledgerLevelData of avExtractResult.ledgerLevelAvData) {\n            addResultStatus(statuses, ledgerLevelData?.currentLevelAvData?.resultStatus);\n            addResultStatus(statuses, ledgerLevelData?.childLevelAvData?.resultStatus);\n        }\n    }\n\n    return statuses;\n};\nconst isNoDataResultStatus = (value) =>\n    isResultStatus(value) && value.code === NO_DATA_RESULT_CODE;\nconst isRetryableResultStatus = (value) =>\n    isResultStatus(value) &&\n    String(value.category).toLowerCase() === \"systemerror\" &&\n    value.recovery?.recoverable === true &&\n    Number(value.recovery?.retryAttemptCount) === 1;\nconst isBlockingResultStatus = (value) =>\n    isResultStatus(value) &&\n    !isNoDataResultStatus(value) &&\n    [\"usererror\", \"systemerror\", \"information\"].includes(String(value.category).toLowerCase());\nconst RETRY_SIGNAL = \"LEDGER_AGENT_RETRY_SIGNAL\";\nconst GENERIC_RESPONSE_PROCESSING_MESSAGE = \"We couldn't complete your request right now. Please try again later.\";\n\nconst getRetryAttemptCount = (value) => {\n    const count = Number(value);\n    return Number.isFinite(count) ? count : 0;\n};\n\nconst isRetrySignal = (error) =>\n    error?.isRetrySignal === true || error?.name === RETRY_SIGNAL;\n\nconst getSentRetryAttemptCount = (requestPayload) =>\n    getRetryAttemptCount(requestPayload?.retryAttemptCount);\n\n// Retry only when BO asks for a newer attempt than the one this request already sent.\nconst shouldRetryResultStatus = (status, requestPayload) => {\n    const backendRetryAttemptCount = getRetryAttemptCount(status?.recovery?.retryAttemptCount);\n    const sentRetryAttemptCount = getSentRetryAttemptCount(requestPayload);\n    return isRetryableResultStatus(status) && backendRetryAttemptCount > sentRetryAttemptCount;\n};\n\nconst createRetryError = (status) => {\n    const err = new Error(status.message || \"Retry requested.\");\n    err.name = RETRY_SIGNAL;\n    err.isRetrySignal = true;\n    err.category = status?.category;\n    err.payload = status;\n    throw err;\n};\n\nlet capturedFetchDataNode;\n\nconst buildGenericProcessingResult = (error) => {\n    const result = new Object();\n    const errorDetails = new Object();\n    const details = new Object();\n    details.message = error?.message;\n    errorDetails.cause = \"DATA_RESPONSE_PROCESSING\";\n    errorDetails.message = GENERIC_RESPONSE_PROCESSING_MESSAGE;\n    errorDetails.details = details;\n    result.success = false;\n    result.temp = capturedFetchDataNode;\n    result.errorDetails = errorDetails;\n    return result;\n};\n\nconst buildResult = () => {\n    const payload = $context.$nodes.PREPARE_EXTRACT_PAYLOAD.$output.result;\n    const response = $context.$nodes.FIN_GL_BO_FUNCTION_BALANCE_INQUIRY_FETCH_DATA.$output;\n    capturedFetchDataNode = $context.$nodes.FIN_GL_BO_FUNCTION_BALANCE_INQUIRY_FETCH_DATA;\n    const result = new Object();\n    const errorDetails = new Object();\n    let successMessage = \"\";\n\n    let responseSuccess = true;\n\n    const statusCode = Number(response?.statusCode);\n    const errorCode = Number(response?.errorCode);\n    const hasTopLevelToolError = (Number.isFinite(statusCode) && statusCode >= 300) || (Number.isFinite(errorCode) && errorCode >= 300);\n    const resultStatuses = collectResultStatuses(response);\n    const retryableResultStatus = resultStatuses.find(isRetryableResultStatus);\n    const blockingResultStatus = resultStatuses.find(isBlockingResultStatus);\n\n    if (shouldRetryResultStatus(retryableResultStatus, payload)) {\n        // Throw so this code node's error path loops back and sends the incremented retryAttemptCount.\n        createRetryError(retryableResultStatus);\n    }\n    else if (blockingResultStatus) {\n        responseSuccess = false;\n        errorDetails.cause = blockingResultStatus.code || blockingResultStatus.category || \"DATA_RETRIEVAL\";\n        errorDetails.message = blockingResultStatus.message || \"We couldn't complete your request right now. Please try again later\";\n        errorDetails.code = blockingResultStatus.code;\n        errorDetails.details = response;\n        result.errorDetails = errorDetails;\n    }\n    else if (hasTopLevelToolError) {\n        responseSuccess = false;\n        errorDetails.cause = response.title || \"DATA_RETRIEVAL\";\n        errorDetails.message = response.errorMessage || response.title || \"We couldn't complete your request right now. Please try again later\";\n        errorDetails.code = response.statusCode || response.errorCode;\n        errorDetails.details = response;\n        result.errorDetails = errorDetails;\n    }\n    else if (response.errorMessage) {\n        responseSuccess = false;\n        errorDetails.cause = \"DATA_RETRIEVAL\";\n        errorDetails.message = response.errorMessage;\n        errorDetails.code = response?.errorCode;\n        result.errorDetails = errorDetails;\n    }\n    else {\n        const checkExtract = (data) => {\n            const avExtractResult = data?.avExtractResult || new Object();\n            const dataRecords = [];\n            let toolErrorMessage = \"\";\n            const topLevelNoData = isNoDataResultStatus(data) ||\n                isNoDataResultStatus(data?.resultStatus);\n\n            const addDataRecord = (dataRecord) => {\n                if (dataRecord && typeof dataRecord === \"object\") {\n                    dataRecords.push(dataRecord);\n                }\n            };\n\n            if (avExtractResult.homogenousLedgerSetAvData) {\n                addDataRecord(avExtractResult.homogenousLedgerSetAvData);\n            } else if (Array.isArray(avExtractResult.ledgerLevelAvData)) {\n                for (const ledgerLevelData of avExtractResult.ledgerLevelAvData) {\n                    addDataRecord(ledgerLevelData?.currentLevelAvData);\n                    addDataRecord(ledgerLevelData?.childLevelAvData);\n                }\n            }\n\n            let hasData = false;\n            let hasError = false;\n            let countObjectCount = 0;\n            let noDataCountObjectCount = 0;\n\n            for (const dataRecord of dataRecords) {\n                const records = dataRecord.records;\n                const errorCode = Number(dataRecord.error?.errorCode);\n                const resultStatus = dataRecord.resultStatus;\n\n                if (Array.isArray(records) && records.length > 0) {\n                    hasData = true;\n                }\n\n                if (!Number.isNaN(errorCode) && errorCode >= 300) {\n                    hasError = true;\n                    toolErrorMessage = dataRecord.error?.errorMessage;\n                }\n\n                if (Object.hasOwn(dataRecord, \"count\")) {\n                    countObjectCount += 1;\n\n                    if (Number(dataRecord.count) === 0 && (errorCode === 204 || isNoDataResultStatus(resultStatus))) {\n                        noDataCountObjectCount += 1;\n                    }\n                }\n            }\n\n            let result = \"error\";\n\n            if (hasError) {\n                result = \"error\";\n            } else if (hasData) {\n                result = \"data\";\n            } else if (countObjectCount > 0 && countObjectCount === noDataCountObjectCount) {\n                result = \"no_data\";\n            } else if (topLevelNoData) {\n                result = \"no_data\";\n            }\n\n            const extractStatus = new Object();\n            extractStatus.result = result;\n            extractStatus.errorMsg = toolErrorMessage;\n            return extractStatus;\n        };\n        let checkExtractResult;\n        let message;\n        if( $context.$nodes.FIN_GL_BO_FUNCTION_BALANCE_INQUIRY_FETCH_DATA.$status === 201 || response?.errorCode === 201 || (response.message && response.message.includes('Recent'))){\n            message = 'async';\n        }else{\n           checkExtractResult = checkExtract(response);\n           message = checkExtractResult.result;\n        }\n\n        if (message === 'error') {\n            responseSuccess = false;\n            errorDetails.cause = \"DATA_RETRIEVAL\"\n            errorDetails.message = checkExtractResult?.errorMsg || \"We couldn't complete your request right now. Please try again later\";\n            result.errorDetails = errorDetails;\n        }\n        else {\n            successMessage = message;\n            const currentState = $context.$variables.state;\n\n            let stateToUpdate = currentState;\n\n            if (!stateToUpdate || typeof stateToUpdate !== \"object\" || Array.isArray(stateToUpdate)) {\n                stateToUpdate = new Object();\n            }\n\n            if (!stateToUpdate.shared || typeof stateToUpdate.shared !== \"object\" || Array.isArray(stateToUpdate.shared)) {\n                stateToUpdate.shared = new Object();\n            }\n\n            const lastUsedQuery = stateToUpdate.private?.lastUsedQuery;\n\n            stateToUpdate.private = new Object();\n\n            if (lastUsedQuery) {\n                stateToUpdate.private.lastUsedQuery = lastUsedQuery;\n            }\n            else if($context.$triggers.REST.$input.additionalContext?.bossExtract){\n                const hierarchyResolverMessage = getHierarchyResolverMessage([$context.$triggers.REST.$input.additionalContext.bossExtract.queries]);\n                const queryResponse = new Object();\n                queryResponse.metadata = response?.avExtractResult?.metadata;\n                queryResponse.queries = [$context.$triggers.REST.$input.additionalContext.bossExtract.queries];\n                stateToUpdate.private.lastUsedQuery = new Object();\n                stateToUpdate.private.lastUsedQuery.queryPayload = $context.$nodes.PREPARE_EXTRACT_PAYLOAD.$output.result;\n                stateToUpdate.private.lastUsedQuery.queryResponse = queryResponse;\n                stateToUpdate.private.lastUsedQuery.analyticViewNameUsed = $context.$triggers.REST.$input.additionalContext.analyticView;\n                if (hierarchyResolverMessage) {\n                    result.hierarchyResolverMessage = hierarchyResolverMessage;\n                }\n            }\n\n            if ($context.$variables.scopePath === \"breakdown\") {\n                applyUpdatedIntentDetails(stateToUpdate.private?.lastUsedQuery, response);\n            }\n\n            const varianceState = $context.$variables.newVarianceState;\n\n            if (varianceState && typeof varianceState === \"object\" && !Array.isArray(varianceState)) {\n                stateToUpdate.private.varianceState = varianceState;\n            } else {\n                stateToUpdate.private.varianceState = new Object();\n                stateToUpdate.private.varianceState.enabled = false;\n                stateToUpdate.private.varianceState.varianceFilters = new Object();\n            }\n\n            stateToUpdate.private.lastUsedData = new Object();\n            stateToUpdate.private.lastUsedData.dataResponse = response;\n            stateToUpdate.private.lastUsedData.dataPayload = payload;\n            stateToUpdate.private.lastUsedData.keyOrder = buildAvKeyOrder(response);\n\n            result.state = stateToUpdate;\n            result.successMessage = successMessage;\n            const generatedQueryHierarchyResolverMessage = $context.$nodes.QUERY_RESPONSE_PROCESSOR?.$output?.result?.hierarchyResolverMessage;\n            if (generatedQueryHierarchyResolverMessage) {\n                result.hierarchyResolverMessage = generatedQueryHierarchyResolverMessage;\n            }\n        }\n    }\n    result.temp = $context.$nodes.FIN_GL_BO_FUNCTION_BALANCE_INQUIRY_FETCH_DATA;\n    result.success = responseSuccess;\n\n    return result;\n};\n\nlet finalResult;\ntry {\n    finalResult = buildResult();\n} catch (error) {\n    if (isRetrySignal(error)) {\n        throw error;\n    }\n\n    finalResult = buildGenericProcessingResult(error);\n}\n\nreturn finalResult;"
