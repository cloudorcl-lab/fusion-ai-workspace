          "metadata": {
            "errorNodeId": "1777591225788",
            "name": "Query Response Processor",
            "returnType": "object",
            "sourceCode": "const getHierarchyResolverMessage = (value) => String(value?.queries?.[0]?.hierarchyResolverMessage ?? \"\").trim();\n\nconst RETRY_SIGNAL = \"LEDGER_AGENT_RETRY_SIGNAL\";\nconst GENERIC_RESPONSE_PROCESSING_MESSAGE = \"We couldn't complete your request right now. Please try again later.\";\n\nconst getRetryAttemptCount = (value) => {\n  const count = Number(value);\n  return Number.isFinite(count) ? count : 0;\n};\n\nconst isRetrySignal = (error) => error?.isRetrySignal === true || error?.name === RETRY_SIGNAL;\n\n// Retry only when BO asks for a newer attempt than the one this request already sent.\nconst shouldRetryEnhancedResponse = (value, sentRetryAttemptCount) => {\n  const backendRetryAttemptCount = getRetryAttemptCount(value?.recovery?.retryAttemptCount);\n  return (\n    String(value?.category ?? \"\").toLowerCase() === \"systemerror\" &&\n    value?.recovery?.recoverable === true &&\n    backendRetryAttemptCount === 1 &&\n    backendRetryAttemptCount > sentRetryAttemptCount\n  );\n};\n\nconst throwRetryError = (value) => {\n  const err = new Error(value?.message || \"Retry requested.\");\n  err.name = RETRY_SIGNAL;\n  err.isRetrySignal = true;\n  err.category = value?.category;\n  err.processExecutionId = value?.processExecutionId;\n  err.payload = value;\n  throw err;\n};\n\nconst buildGenericProcessingResponse = (error) => {\n  const response = new Object();\n  const details = new Object();\n  details.message = error?.message;\n  response.success = false;\n  response.requiresNewBreakdown = false;\n  response.cause = \"QUERY_RESPONSE_PROCESSING\";\n  response.errorMessage = GENERIC_RESPONSE_PROCESSING_MESSAGE;\n  response.details = details;\n  return response;\n};\n\nconst buildResponse = () => {\n  const queryResponse = $context.$nodes.FIN_GL_BO_FUNCTION_BALANCE_INQUIRY_GENERATE_QUERY.$output;\n  const sentRetryAttemptCount = getRetryAttemptCount($context.$nodes.PREPARE_FETCH_QUERY_PAYLOAD?.$output?.result?.retryAttemptCount);\n  const response = new Object();\n\n  response.requiresNewBreakdown = $context.$variables?.requiresNewBreakdown || false;\n\n  response.success = true;\n\n  const category = String(queryResponse?.category ?? \"\").toLowerCase();\n\n  if (shouldRetryEnhancedResponse(queryResponse, sentRetryAttemptCount)) {\n    // Only this marked error should use the workflow retry edge.\n    throwRetryError(queryResponse);\n  }\n\n  if (category === \"usererror\" || category === \"systemerror\" || category === \"information\") {\n    response.success = false;\n    response.errorCode = queryResponse.code;\n    response.cause = queryResponse.category || \"QUERY_GENERATION\";\n    response.errorMessage = queryResponse.message;\n    response.details = queryResponse;\n    response.requiresNewBreakdown = false;\n  } else if (Object.hasOwn(queryResponse, \"errorCode\")) {\n    response.success = false;\n    response.errorCode = queryResponse.errorCode;\n    response.cause = \"QUERY_GENERATION\";\n    if(queryResponse?.errorMessage){\n      response.errorMessage = queryResponse.errorMessage;\n    }\n    response.requiresNewBreakdown = false;\n  } else if (Object.hasOwn(queryResponse, \"statusCode\")) {\n    if (queryResponse.statusCode >= 300) {\n      response.success = false;\n      response.code = queryResponse.statusCode;\n      response.requiresNewBreakdown = false;\n      if(queryResponse.statusCode === 400 && queryResponse?.title && (queryResponse.title === 'VALUE_NOT_IN_HIERARCHY' || queryResponse.title === 'HIERARCHY_NOT_FOUND')){\n          response.cause = queryResponse.title;\n          response.details = queryResponse;\n      }\n      else{\n        response.errorMessage = queryResponse?.title || \"We couldn't complete your request right now. Please try again later\"\n      }\n    }\n  }\n\n  if(response.success){\n    const hierarchyResolverMessage = getHierarchyResolverMessage(queryResponse);\n    const currentState = $context.$variables.state;\n\n    let stateToUpdate = currentState;\n\n    if (!stateToUpdate || typeof stateToUpdate !== \"object\" || Array.isArray(stateToUpdate)) {\n      stateToUpdate = new Object();\n    }\n\n    if (!stateToUpdate.shared || typeof stateToUpdate.shared !== \"object\" || Array.isArray(stateToUpdate.shared)) {\n      stateToUpdate.shared = new Object();\n    }\n\n    const queryPayload = $context.$nodes.PREPARE_FETCH_QUERY_PAYLOAD.$output?.result || new Object();\n\n    const lastUsedQuery = new Object();\n    lastUsedQuery.queryResponse = queryResponse;\n    lastUsedQuery.queryPayload = queryPayload;\n\n    lastUsedQuery.analyticViewNameUsed = $context.$triggers.REST.$input.additionalContext?.analyticView;\n\n\n    stateToUpdate.private = new Object();\n    stateToUpdate.private.lastUsedQuery = lastUsedQuery;\n\n    response.state = stateToUpdate;\n    if (hierarchyResolverMessage) {\n      response.hierarchyResolverMessage = hierarchyResolverMessage;\n    }\n  }\n\n\n  return response;\n};\n\nlet finalResponse;\ntry {\n  finalResponse = buildResponse();\n} catch (error) {\n  if (isRetrySignal(error)) {\n    throw error;\n  }\n\n  finalResponse = buildGenericProcessingResponse(error);\n}\n\nreturn finalResponse;"
