            "sourceCode": "let path = \"requires_llm\";\n\nif($context.$triggers.REST.$input.state){\n    // will be used to check if hiearchy changed and such\n}\n\nif($context.$triggers.REST.$input?.additionalContext){\n    let bossExtract = $context.$triggers.REST.$input.additionalContext?.bossExtract;\n    if(bossExtract && typeof bossExtract === 'object'){\n        path = \"execute_query\";\n    }\n}\n\nconst returnObj = {\n    path: path\n};\n\nreturn returnObj;"
          },
          "outcomes": {
            "success": "1777576933975"
          },
          "code": "PRELIMINARY_NEW_QUERY_CHECK",
          "id": "1777535425402",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
