          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"coaBreakdowns\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"dimensionName\": {\n                \"type\": \"string\"\n              },\n              \"expandLevel\": {\n                \"type\": \"integer\",\n                \"enum\": [\n                  -1,\n                  1\n                ]\n              },\n              \"memberNames\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"string\"\n                }\n              }\n            },\n            \"required\": [\n              \"dimensionName\",\n              \"expandLevel\",\n              \"memberNames\"\n            ]\n          }\n        },\n        \"periodBreakdown\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"expandLevel\": {\n              \"type\": \"integer\",\n              \"enum\": [\n                1,\n                2\n              ]\n            }\n          },\n          \"additionalProperties\": false\n        }\n      },\n      \"required\": [\n        \"coaBreakdowns\",\n        \"periodBreakdown\"\n      ]\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Response Path Processor",
            "returnType": "object",
            "sourceCode": "const path = $context.$variables.scopePath;\nconst domainResponseSchema = new Object();\n\nconst safeParseJson = (value) => {\n    if (typeof value !== \"string\") {\n        return value;\n    }\n    try {\n        return JSON.parse(value);\n    } catch (error) {\n        return value;\n    }\n};\n\nconst getUtilityPayload = () => {\n    const utilityOutput = $context.$nodes.GET_OUT_OF_SCOPE_GUIDANCE?.$output ?? new Object();\n    if (Object.prototype.hasOwnProperty.call(utilityOutput, \"output\")) {\n        return safeParseJson(utilityOutput.output);\n    }\n    if (Object.prototype.hasOwnProperty.call(utilityOutput, \"result\")) {\n        return utilityOutput.result;\n    }\n    return utilityOutput;\n};\n\nconst getUtilityMessage = () => {\n    const payload = getUtilityPayload();\n    if (typeof payload === \"string\") {\n        return payload.trim();\n    }\n    if (payload && typeof payload === \"object\") {\n        return String(\n            payload.final_response ??\n            payload.finalResponse ??\n            payload.message ??\n            payload.result ??\n            \"\"\n        ).trim();\n    }\n    return \"\";\n};\n\nconst normalizeMessages = (value) => Array.isArray(value) ? value : [];\n\nconst buildNerFooterMessages = (queryResponse) => {\n    const ner = queryResponse?.queries?.[0]?.reasoning?.ner || new Object();\n    const text = String(ner.clarificationResponse ?? \"\").trim();\n    const status = String(ner.status ?? \"\").trim().toLowerCase();\n\n    if (status !== \"multi_step\" || text === \"\") {\n        return [];\n    }\n\n    return [{\n        code: \"NER_CLARIFICATION\",\n        type: \"clarification\",\n        severity: \"info\",\n        placement: \"footer\",\n        text\n    }];\n};\n\nconst mergeMessages = (...values) => {\n    const result = [];\n    const seen = new Set();\n\n    for (const value of values) {\n        for (const message of normalizeMessages(value)) {\n            const text = String(message?.text ?? \"\").trim();\n            if (!text) {\n                continue;\n            }\n\n            const normalizedMessage = {\n                code: String(message.code ?? \"INFO\"),\n                type: String(message.type ?? \"info\"),\n                severity: String(message.severity ?? \"info\"),\n                placement: String(message.placement ?? \"footer\"),\n                text\n            };\n            const key = `${normalizedMessage.code}|${normalizedMessage.placement}|${normalizedMessage.text}`;\n            if (seen.has(key)) {\n                continue;\n            }\n\n            seen.add(key);\n            result.push(normalizedMessage);\n        }\n    }\n\n    return result;\n};\n\nif (path === \"out_of_scope\") {\n    domainResponseSchema.status = \"error\";\n\n    const utilityMessage = getUtilityMessage();\n    const errorDetails = new Object();\n    errorDetails.message = utilityMessage || \"Your request is missing key context. Please refine your prompt with specific dimension names and values.\";\n    errorDetails.cause = \"OUT_OF_SCOPE\";\n    domainResponseSchema.errorDetails = errorDetails;\n}\nelse if (path === \"clarification_needed\") {\n    domainResponseSchema.status = \"followup\";\n    domainResponseSchema.followupMessage = \"Need more information\";\n}\nelse if ($context.$variables.requiresNewQuery && $context.$variables.fetchQueryFailed) {\n    domainResponseSchema.status = \"error\";\n\n    const queryResult = $context.$nodes.QUERY_RESPONSE_PROCESSOR.$output?.result;\n    const errorDetails = new Object();\n    errorDetails.message = queryResult?.errorMessage;\n    errorDetails.cause = queryResult?.cause;\n    errorDetails.code = queryResult?.errorCode;\n\n    if (queryResult?.details) {\n        errorDetails.details = queryResult.details;\n    }\n\n    domainResponseSchema.errorDetails = errorDetails;\n}\nelse if ($context.$variables.requiresQueryExecution && $context.$variables.fetchExtractFailed) {\n    domainResponseSchema.status = \"error\";\n    domainResponseSchema.errorDetails =\n        $context.$nodes.EXTRACT_RESPONSE_PROCESSOR.$output.result.errorDetails;\n}\nelse {\n    domainResponseSchema.status = \"success\";\n    domainResponseSchema.successMessage =\n        $context.$nodes.EXTRACT_RESPONSE_PROCESSOR.$output.result.successMessage;\n\n    const isObject = (value) =>\n        value !== null && typeof value === \"object\" && !Array.isArray(value);\n    const currentState = isObject($context.$variables.state)\n        ? $context.$variables.state\n        : new Object();\n    domainResponseSchema.state = Object.assign(new Object(), currentState);\n\n    let rawCoaBreakdown = $context.$variables.newCOABreakdown;\n\n    if (typeof rawCoaBreakdown === \"string\") {\n        try {\n            rawCoaBreakdown = JSON.parse(rawCoaBreakdown);\n        }\n        catch (error) {\n            rawCoaBreakdown = [];\n        }\n    }\n\n    const rawCoaCandidates = Array.isArray(rawCoaBreakdown)\n        ? rawCoaBreakdown\n        : isObject(rawCoaBreakdown)\n            ? [rawCoaBreakdown]\n            : [];\n    const seenBreakdownDimensions = new Object();\n    const coaBreakdown = [];\n\n    for (const rawCandidate of rawCoaCandidates) {\n        let candidate = rawCandidate;\n\n        if (typeof candidate === \"string\") {\n            try {\n                candidate = JSON.parse(candidate);\n            }\n            catch (error) {\n                continue;\n            }\n        }\n\n        if (!isObject(candidate)) {\n            continue;\n        }\n\n        const dimensionName = String(candidate.dimensionName || \"\").trim();\n\n        if (!dimensionName || seenBreakdownDimensions[dimensionName]) {\n            continue;\n        }\n\n        let rawMemberNames = candidate.memberNames;\n\n        if (typeof rawMemberNames === \"string\") {\n            try {\n                rawMemberNames = JSON.parse(rawMemberNames);\n            }\n            catch (error) {\n                rawMemberNames = [];\n            }\n        }\n\n        const seenMemberNames = new Object();\n        const memberNames = [];\n\n        for (const memberName of Array.isArray(rawMemberNames) ? rawMemberNames : []) {\n            if (memberName == null) {\n                continue;\n            }\n\n            const normalizedMemberName = String(memberName).trim();\n\n            if (!normalizedMemberName || seenMemberNames[normalizedMemberName]) {\n                continue;\n            }\n\n            seenMemberNames[normalizedMemberName] = true;\n            memberNames.push(normalizedMemberName);\n        }\n\n        const breakdown = new Object();\n        breakdown.dimensionName = dimensionName;\n        breakdown.expandLevel = Number(candidate.expandLevel) === -1 ? -1 : 1;\n        breakdown.memberNames = memberNames;\n\n        seenBreakdownDimensions[dimensionName] = true;\n        coaBreakdown.push(breakdown);\n    }\n\n    let rawPeriodBreakdown = $context.$variables.newPeriodBreakdown;\n\n    if (typeof rawPeriodBreakdown === \"string\") {\n        try {\n            rawPeriodBreakdown = JSON.parse(rawPeriodBreakdown);\n        }\n        catch (error) {\n            rawPeriodBreakdown = new Object();\n        }\n    }\n\n    const periodBreakdown = new Object();\n\n    if (isObject(rawPeriodBreakdown)) {\n        const expandLevel = Number(rawPeriodBreakdown.expandLevel);\n\n        if (expandLevel === 1 || expandLevel === 2) {\n            periodBreakdown.expandLevel = expandLevel;\n        }\n    }\n\n    const sharedState = isObject(currentState.shared)\n        ? Object.assign(new Object(), currentState.shared)\n        : new Object();\n\n    sharedState.coaBreakdown = coaBreakdown;\n    sharedState.periodBreakdown = periodBreakdown;\n    // Store the effective sort so later follow-ups can reuse or append to it.\n    sharedState.sortBy = Array.isArray($context.$nodes.PREPARE_EXTRACT_PAYLOAD?.$output?.result?.sortBy)\n        ? $context.$nodes.PREPARE_EXTRACT_PAYLOAD.$output.result.sortBy\n        : [];\n    domainResponseSchema.state.shared = sharedState;\n\n    const hierarchyResolverMessage =\n        $context.$nodes.EXTRACT_RESPONSE_PROCESSOR?.$output?.result?.hierarchyResolverMessage ||\n        $context.$nodes.QUERY_RESPONSE_PROCESSOR?.$output?.result?.hierarchyResolverMessage;\n\n    if (hierarchyResolverMessage) {\n        domainResponseSchema.hierarchyResolverMessage = hierarchyResolverMessage;\n    }\n\n    const messages = mergeMessages(\n        $context.$nodes.QUERY_RESPONSE_PROCESSOR?.$output?.result?.messages,\n        $context.$nodes.EXTRACT_RESPONSE_PROCESSOR?.$output?.result?.messages,\n        buildNerFooterMessages(domainResponseSchema.state?.private?.lastUsedQuery?.queryResponse)\n    );\n\n    if (messages.length > 0) {\n        domainResponseSchema.messages = messages;\n    }\n}\n\nreturn domainResponseSchema;"
