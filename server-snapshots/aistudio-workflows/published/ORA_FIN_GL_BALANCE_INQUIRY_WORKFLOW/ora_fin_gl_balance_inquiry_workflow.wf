            "returnType": "object",
            "sourceCode": "const queryArrObj = new Object();\nconst resolveHierarchyOverrides = () => {\n    const inputState = $context.$triggers.REST.$input.state || new Object();\n    const stateOverrides = inputState?.shared?.hierarchy?.hierarchyOverrides ||\n        inputState?.domainSlice?.shared?.hierarchy?.hierarchyOverrides;\n    if (Array.isArray(stateOverrides) && stateOverrides.length > 0) {\n        return stateOverrides;\n    }\n    return [];\n};\nconst hierarchyOverrides = resolveHierarchyOverrides();\n\nconst previousQueryResponse = $context.$nodes.FIN_GL_BO_FUNCTION_BALANCE_INQUIRY_GENERATE_QUERY?.$output ?? new Object();\nconst rawRetryAttemptCount = previousQueryResponse?.recovery?.retryAttemptCount ?? 0;\nconst parsedRetryAttemptCount = Number(rawRetryAttemptCount);\nconst retryAttemptCount = Number.isFinite(parsedRetryAttemptCount)\n    ? parsedRetryAttemptCount\n    : 0;\n\nqueryArrObj.analyticView = $context.$triggers.REST.$input.additionalContext?.analyticView;\nqueryArrObj.module = \"oraErpCoreAccountBalancesRuntime\";\nqueryArrObj.ledgerContext = [$context.$triggers.REST.$input.additionalContext.ledgerContext];\nqueryArrObj.ledgerCategory = $context.$triggers.REST.$input.additionalContext.ledgerCategory;\n\nlet additionalContextQueryObj = $context.$triggers.REST.$input.additionalContext?.queries?.[0]?.query;\n\nqueryArrObj.segmentTreeVersionMappings = \"\";\n\nif(additionalContextQueryObj && additionalContextQueryObj.filter){\n    queryArrObj.query = new Object();\n    queryArrObj.query.filter = additionalContextQueryObj.filter;\n}\nif(additionalContextQueryObj && additionalContextQueryObj.time_period && additionalContextQueryObj.time_period.length > 0){\n    queryArrObj.time_period = additionalContextQueryObj.time_period;\n}\nif(additionalContextQueryObj && additionalContextQueryObj.currency){\n    if(Array.isArray(additionalContextQueryObj.currency) && additionalContextQueryObj.currency.length > 0){\n        queryArrObj.currency = additionalContextQueryObj.currency[0];\n    } else if(typeof additionalContextQueryObj.currency === \"string\" && additionalContextQueryObj.currency.trim() !== \"\"){\n        queryArrObj.currency = additionalContextQueryObj.currency;\n    }\n}\nif(Array.isArray(hierarchyOverrides) && hierarchyOverrides.length > 0){\n    queryArrObj.segmentTreeVersionMappings = hierarchyOverrides;\n}\nif($context.$triggers.REST.$input.additionalContext?.templateDetails){\n    queryArrObj.simplifiedTemplateDetails = $context.$triggers.REST.$input.additionalContext.templateDetails;\n}\n\n\nlet queryPayload = new Object();\nconst additionalInfo = new Object();\nif($context.$triggers.REST.$input.additionalContext?.processExecutionId){\n    additionalInfo.processExecutionId = `${$context.$triggers.REST.$input.additionalContext.processExecutionId}`;\n}\nqueryPayload.userQuestion = `${$context.$nodes.FIN_GL_LLM_BALANCE_INQUIRY_REPHRASE_QUESTION.$output.nlQuestion}`;\nqueryPayload.includeMetaData = true;\nqueryPayload.taskType = \"NL2BQL-DATA\";\nqueryPayload.excludeDummyColumns = true;\nqueryPayload.retryAttemptCount = retryAttemptCount;\nqueryPayload.useEnhancedErrorResponse = true;\nqueryPayload.chartOfAccountsId = $context.$triggers.REST.$input.additionalContext.chartOfAccountsId;\nqueryPayload.queries = [queryArrObj];\nqueryPayload.additionalInfo = additionalInfo;\n\nif($context.$triggers.REST.$input.additionalContext?.templateId){\n    queryPayload.templateId = $context.$triggers.REST.$input.additionalContext.templateId;\n}\n\nreturn queryPayload;"
