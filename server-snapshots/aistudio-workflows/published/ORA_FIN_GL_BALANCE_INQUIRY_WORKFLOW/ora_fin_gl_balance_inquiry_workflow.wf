        {
          "metadata": {
            "name": "Construct Breakdown",
            "returnType": "object",
            "sourceCode": "const scopePath = $context.$variables.scopePath;\nconst selectorRan = $context.$variables.requiresNewBreakdown === true;\nconst questionType =\n  scopePath === \"execute_query\"\n    ? \"base_question\"\n    : scopePath === \"breakdown\" || scopePath === \"sort\"\n      ? \"follow_up\"\n      : $context.$nodes.FIN_GL_LLM_BALANCE_INQUIRY_REPHRASE_QUESTION?.$output?.questionType === \"follow_up\"\n        ? \"follow_up\"\n        : \"base_question\";\n\nconst selectorOutput = selectorRan\n  ? $context.$nodes.FIN_GL_LLM_BALANCE_INQUIRY_BREAKDOWN_SELECTOR?.$output\n  : null;\nconst priorSharedState = $context.$variables.state?.shared;\n\nlet rawCoaBreakdowns = selectorRan\n  ? selectorOutput?.coaBreakdowns\n  : questionType === \"follow_up\"\n    ? priorSharedState?.coaBreakdown\n    : [];\nlet rawPeriodBreakdown = selectorRan\n  ? selectorOutput?.periodBreakdown\n  : questionType === \"follow_up\"\n    ? priorSharedState?.periodBreakdown\n    : new Object();\n\nconst chartOfAccounts =\n  $context.$variables.requiresNewQuery === true\n    ? $context.$nodes.FIN_GL_BO_FUNCTION_BALANCE_INQUIRY_GENERATE_QUERY?.$output?.metadata?.chartOfAccounts\n    : $context.$variables.state?.private?.lastUsedData?.dataResponse?.avExtractResult?.metadata?.chartOfAccounts;\nconst availableSegments = chartOfAccounts?.segments;\nconst hasSegmentMetadata =\n  availableSegments !== null && typeof availableSegments === \"object\" && !Array.isArray(availableSegments);\nconst baseQueryIntent =\n  $context.$variables.requiresNewQuery === true\n    ? $context.$nodes.FIN_GL_BO_FUNCTION_BALANCE_INQUIRY_GENERATE_QUERY?.$output?.queries?.[0]?.intentDetails\n    : $context.$variables.state?.private?.lastUsedQuery?.queryResponse?.queries?.[0]?.intentDetails;\nlet normalizedBaseQueryIntent = baseQueryIntent;\n\nif (typeof normalizedBaseQueryIntent === \"string\") {\n  try {\n    normalizedBaseQueryIntent = JSON.parse(normalizedBaseQueryIntent);\n  }\n  catch (error) {\n    normalizedBaseQueryIntent = new Object();\n  }\n}\n\nconst accountingPeriodIntentValues = [];\nconst addAccountingPeriodIntentValues = (rawValue) => {\n  if (Array.isArray(rawValue)) {\n    for (const value of rawValue) {\n      addAccountingPeriodIntentValues(value);\n    }\n    return;\n  }\n\n  if (rawValue !== null && typeof rawValue === \"object\") {\n    if (Object.prototype.hasOwnProperty.call(rawValue, \"value\")) {\n      addAccountingPeriodIntentValues(rawValue.value);\n    }\n    else if (Object.prototype.hasOwnProperty.call(rawValue, \"values\")) {\n      addAccountingPeriodIntentValues(rawValue.values);\n    }\n    return;\n  }\n\n  const text = String(rawValue ?? \"\").trim();\n\n  if (!text) {\n    return;\n  }\n\n  if (text.startsWith(\"[\") && text.endsWith(\"]\")) {\n    let parsedValue;\n\n    try {\n      parsedValue = JSON.parse(text);\n    }\n    catch (error) {\n      parsedValue = null;\n    }\n\n    if (parsedValue !== null) {\n      addAccountingPeriodIntentValues(parsedValue);\n      return;\n    }\n  }\n\n  for (const value of text.split(\",\")) {\n    const normalizedValue = value.trim();\n\n    if (normalizedValue) {\n      accountingPeriodIntentValues.push(normalizedValue);\n    }\n  }\n};\n\nif (normalizedBaseQueryIntent !== null &&\n    typeof normalizedBaseQueryIntent === \"object\" &&\n    !Array.isArray(normalizedBaseQueryIntent)) {\n  const accountingPeriodEntry = Object.entries(normalizedBaseQueryIntent)\n    .find(([key]) => String(key).replace(/[\\s_-]+/g, \"\").toLowerCase() === \"accountingperiod\");\n\n  if (accountingPeriodEntry) {\n    addAccountingPeriodIntentValues(accountingPeriodEntry[1]);\n  }\n}\n\nconst hasAccountingPeriodIntentValues = accountingPeriodIntentValues.length > 0;\nconst allAccountingPeriodsAreYears =\n  hasAccountingPeriodIntentValues &&\n  accountingPeriodIntentValues.every((value) => /^\\d{4}$/.test(value));\nconst allAccountingPeriodsAreQuarters =\n  hasAccountingPeriodIntentValues &&\n  accountingPeriodIntentValues.every((value) => /^qtr\\d+-\\d+$/i.test(value));\nconst shouldDiscardPeriodBreakdown =\n  hasAccountingPeriodIntentValues &&\n  !allAccountingPeriodsAreYears &&\n  !allAccountingPeriodsAreQuarters;\n\nif (typeof rawCoaBreakdowns === \"string\") {\n  try {\n    rawCoaBreakdowns = JSON.parse(rawCoaBreakdowns);\n  }\n  catch (error) {\n    rawCoaBreakdowns = [];\n  }\n}\n\nconst sourceBreakdowns = Array.isArray(rawCoaBreakdowns)\n  ? rawCoaBreakdowns\n  : rawCoaBreakdowns &&\n      typeof rawCoaBreakdowns === \"object\" &&\n      !Array.isArray(rawCoaBreakdowns)\n    ? [rawCoaBreakdowns]\n    : [];\nconst seenDimensions = new Object();\nconst coaBreakdowns = [];\n\nfor (const sourceBreakdown of sourceBreakdowns) {\n  let value = sourceBreakdown;\n\n  if (typeof value === \"string\") {\n    try {\n      value = JSON.parse(value);\n    }\n    catch (error) {\n      continue;\n    }\n  }\n\n  if (!value || typeof value !== \"object\" || Array.isArray(value)) {\n    continue;\n  }\n\n  const dimensionName = String(value.dimensionName || \"\").trim();\n  const isSegmentKey =\n    hasSegmentMetadata &&\n    Object.prototype.hasOwnProperty.call(availableSegments, dimensionName);\n  const isSegmentDimensionName =\n    hasSegmentMetadata &&\n    Object.values(availableSegments).some(\n      (segment) => String(segment?.dimensionName ?? \"\").trim() === dimensionName\n    );\n\n  if (!dimensionName || seenDimensions[dimensionName]) {\n    continue;\n  }\n\n  if (selectorRan && !hasSegmentMetadata) {\n    continue;\n  }\n\n  if (hasSegmentMetadata && !isSegmentKey && !isSegmentDimensionName) {\n    continue;\n  }\n\n  let rawMemberNames = value.memberNames;\n\n  if (typeof rawMemberNames === \"string\") {\n    try {\n      rawMemberNames = JSON.parse(rawMemberNames);\n    }\n    catch (error) {\n      rawMemberNames = [];\n    }\n  }\n\n  const seenMemberNames = new Object();\n  const memberNames = [];\n\n  for (const memberName of Array.isArray(rawMemberNames) ? rawMemberNames : []) {\n    if (memberName == null) {\n      continue;\n    }\n\n    const normalizedMemberName = String(memberName).trim();\n\n    if (!normalizedMemberName || seenMemberNames[normalizedMemberName]) {\n      continue;\n    }\n\n    seenMemberNames[normalizedMemberName] = true;\n    memberNames.push(normalizedMemberName);\n  }\n\n  const breakdown = new Object();\n  breakdown.dimensionName = dimensionName;\n  breakdown.expandLevel = Number(value.expandLevel) === -1 ? -1 : 1;\n  breakdown.memberNames = memberNames;\n\n  seenDimensions[dimensionName] = true;\n  coaBreakdowns.push(breakdown);\n}\n\nif (typeof rawPeriodBreakdown === \"string\") {\n  try {\n    rawPeriodBreakdown = JSON.parse(rawPeriodBreakdown);\n  }\n  catch (error) {\n    rawPeriodBreakdown = new Object();\n  }\n}\n\nconst periodBreakdown = new Object();\n\nif (rawPeriodBreakdown &&\n    typeof rawPeriodBreakdown === \"object\" &&\n    !Array.isArray(rawPeriodBreakdown)) {\n  const expandLevel = Number(rawPeriodBreakdown.expandLevel);\n\n  if ((expandLevel === 1 || expandLevel === 2) &&\n      !shouldDiscardPeriodBreakdown) {\n    periodBreakdown.expandLevel =\n      allAccountingPeriodsAreQuarters && expandLevel === 2\n        ? 1\n        : expandLevel;\n  }\n}\n\nconst result = new Object();\nresult.coaBreakdowns = coaBreakdowns;\nresult.periodBreakdown = periodBreakdown;\nreturn result;"
