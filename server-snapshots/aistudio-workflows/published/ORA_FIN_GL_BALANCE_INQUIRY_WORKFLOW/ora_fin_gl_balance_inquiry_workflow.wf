        {
          "metadata": {
            "errorNodeId": "1777581874877",
            "name": "Process Scope Classifier",
            "returnType": "object",
            "sourceCode": "let llmOutput = $context.$nodes.FIN_GL_LLM_BALANCE_INQUIRY_SCOPE_CLASSIFIER.$output;\n\nlet chosenScope = llmOutput.scopeType;\n\nlet requiresNewQuery = true;\nlet requiresNewBreakdown = false;\nlet requiresQueryExecution = false;\n// Guardrail: sortRequired only means the user explicitly mentioned sort.\n// It does not mean \"run the sort selector\" for every path. New-query paths\n// still go through query generation, where the generated query owns ORDER BY.\nlet sortRequired = llmOutput.sortRequired === true;\n//\"new_query|breakdown|sort|new_query_plus_breakdown|out_of_scope|clarification_needed\"\n\nif(chosenScope === 'new_query'){\n    requiresNewQuery = true;\n    requiresNewBreakdown = false;\n    requiresQueryExecution = true;\n}\nelse if(chosenScope === 'breakdown'){\n    requiresNewQuery = false;\n    requiresNewBreakdown = true;\n    requiresQueryExecution = true;\n}\nelse if(chosenScope === 'sort'){\n    requiresNewQuery = false;\n    requiresNewBreakdown = false;\n    requiresQueryExecution = true;\n    sortRequired = true;\n}\nelse if(chosenScope === 'new_query_plus_breakdown'){\n    requiresNewQuery = true;\n    requiresNewBreakdown = true;\n    requiresQueryExecution = true;\n}\nelse{\n    requiresNewQuery = false;\n    requiresNewBreakdown = false;\n    requiresQueryExecution = false;\n    sortRequired = false;\n    // defaulting to out of scope of llm returns any unsupported scope\n    // clarification_needed not supported for now\n    chosenScope = \"out_of_scope\";\n}\n\nconst result= {\n    requiresNewQuery: requiresNewQuery,\n    requiresNewBreakdown: requiresNewBreakdown,\n    requiresQueryExecution: requiresQueryExecution,\n    sortRequired: sortRequired,\n    scopePath: chosenScope\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1777582643420"
          },
          "code": "PROCESS_SCOPE_CLASSIFIER",
          "id": "1777582178985",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
