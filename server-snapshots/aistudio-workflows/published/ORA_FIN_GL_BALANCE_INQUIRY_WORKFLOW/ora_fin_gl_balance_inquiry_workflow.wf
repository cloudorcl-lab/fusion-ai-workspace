          "code": "FIN_GL_SET_FIELDS_BALANCE_INQUIRY_SET_COA_BREAKDOWN",
          "id": "1777695536363",
          "inputs": [
            {
              "id": "1777695552697",
              "name": "newCOABreakdown",
              "scope": "JOB",
              "type": "array",
              "value": "{{$context.$nodes.CONSTRUCT_BREAKDOWN.$output.result.coaBreakdowns}}"
            },
            {
              "id": "1777695552698",
