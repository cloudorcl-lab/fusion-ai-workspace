        {
          "metadata": {
            "name": "Prepare Out-of-Scope Guidance Input",
            "returnType": "object",
            "sourceCode": "const scopeOutput = $context.$nodes.FIN_GL_LLM_BALANCE_INQUIRY_SCOPE_CLASSIFIER.$output || new Object();\nconst rawChatHistory = $context.$triggers.REST.$input.chatHistory;\n\nconst asString = (value) => {\n  if (value === null || value === undefined) {\n    return \"\";\n  }\n  return String(value);\n};\n\nconst stringifyChatHistory = (value) => {\n  if (value === null || value === undefined) {\n    return \"[]\";\n  }\n  if (typeof value === \"string\") {\n    return value;\n  }\n  try {\n    return JSON.stringify(value);\n  } catch (error) {\n    return \"[]\";\n  }\n};\n\nconst asyncRequest = {\n  userNlQuestion: asString($context.$system.$inputMessage),\n  chatHistory: stringifyChatHistory(rawChatHistory),\n  justification: asString(scopeOutput.reasoning) || \"Request is outside balance inquiry scope.\"\n};\n\nreturn { asyncRequest };"
          },
          "outcomes": {
            "success": "1777695536365"
          },
          "code": "PREPARE_OUT_OF_SCOPE_GUIDANCE_INPUT",
          "id": "1777695536364",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
