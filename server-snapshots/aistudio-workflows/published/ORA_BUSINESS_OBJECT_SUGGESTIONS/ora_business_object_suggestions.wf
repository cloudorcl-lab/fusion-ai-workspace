        {
          "metadata": {
            "name": "add BO",
            "returnType": "object",
            "sourceCode": "const item = $context.$nodes.GETINFO.$output.items ? $context.$nodes.GETINFO.$output.items[0] : null;\nitem.implementation = JSON.parse(item.ObjectProperties);\n//search for tool\nconst location = item.implementation.tools.find(u => u.name === $context.$nodes.PARSE.$output.result[1]);\nitem.implementation =location;\n\nconst result = {\nimplementation: {},\nbusinessObject: {}\n};\n\nresult.name = item.implementation.name;\nresult.description = item.implementation.description;\n\nresult.implementation.resourcePath = item.implementation.resourcePath;\nresult.implementation.resourceType = item.implementation.resourceType;\nresult.implementation.operationType = item.implementation.operationType;\nresult.implementation.parameters = item.implementation.parameterDefinitions;\n\nresult.businessObject.objectCode = item.ObjectCode;\nresult.businessObject.name = item.Name;\nresult.businessObject.description = item.Description;\n\n\nreturn result;"
          },
          "outcomes": {
            "success": "end"
          },
