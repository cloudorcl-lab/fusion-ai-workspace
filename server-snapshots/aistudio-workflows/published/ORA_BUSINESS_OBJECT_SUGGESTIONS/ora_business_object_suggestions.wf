            "returnType": "object",
            "sourceCode": "const boFunctions =  $context.$nodes.TEMPDATA.$output.result;\nconst name = $context.$nodes.BO_NAME.$output;\nlet retboFunction;\nfor (const boFunction of boFunctions) {\n  if (boFunction.name ===  name) {\n    retboFunction = boFunction;\n  }\n}\nreturn retboFunction;"
