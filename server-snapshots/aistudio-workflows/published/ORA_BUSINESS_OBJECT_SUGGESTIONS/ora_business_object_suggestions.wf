          "metadata": {
            "name": "tempdata",
            "returnType": "array",
            "sourceCode": "const ret = [\n   {\n      \"implementation\":{\n         \"resourcePath\":\"/hcmRestApi/resources/11.13.18.05/recruitingJobRequisitions\",\n         \"resourceType\":\"ADF_BC_FIXED_QUERY\",\n         \"operationType\":\"POST\",\n         \"parameters\": [\n            {\n               \"dataType\":\"string\",\n               \"description\":\"Position Id\",\n               \"id\":97,\n               \"isToken\":true,\n               \"name\":\"PositionId\"\n            },\n            {\n               \"dataType\":\"string\",\n               \"description\":\"Legal Employer Id\",\n               \"id\":96,\n               \"isToken\":true,\n               \"name\":\"LegalEmployerId\"\n            },\n            {\n               \"dataType\":\"string\",\n               \"description\":\"Responsibilities for the requisition\",\n               \"id\":68,\n               \"isToken\":true,\n               \"name\":\"InternalRespHTML\"\n            },\n            {\n               \"dataType\":\"string\",\n               \"description\":\"Qualification for the requisition\",\n               \"id\":69,\n               \"isToken\":true,\n               \"name\":\"InternalQualHTML\"\n            },\n            {\n               \"dataType\":\"string\",\n               \"description\":\"Internal Short Description for the requisition\",\n               \"id\":70,\n               \"isToken\":true,\n               \"name\":\"InternalShortDescription\"\n            },\n            {\n               \"dataType\":\"string\",\n               \"description\":\"Business Justification of the requisition\",\n               \"id\":71,\n               \"isToken\":true,\n               \"name\":\"BusinessJustification\"\n            },\n            {\n               \"dataType\":\"number\",\n               \"description\":\"Sourcing Budget\",\n               \"id\":72,\n               \"isToken\":true,\n               \"name\":\"SourcingBudget\"\n            },\n            {\n               \"dataType\":\"string\",\n               \"description\":\"Budget Currency\",\n               \"id\":73,\n               \"isToken\":true,\n               \"name\":\"BudgetCurrency\"\n            },\n            {\n               \"dataType\":\"string\",\n               \"description\":\"Compensation Currency\",\n               \"id\":74,\n               \"isToken\":true,\n               \"name\":\"CompensationCurrency\"\n            },\n            {\n               \"dataType\":\"string\",\n               \"description\":\"Worker Type\",\n               \"id\":75,\n               \"isToken\":true,\n               \"name\":\"WorkerType\"\n            },\n            {\n               \"dataType\":\"string\",\n               \"description\":\"Regular Or Temporary\",\n               \"id\":76,\n               \"isToken\":true,\n               \"name\":\"RegularOrTemporary\"\n            },\n            {\n               \"dataType\":\"string\",\n               \"description\":\"FullTime Or PartTime\",\n               \"id\":77,\n               \"isToken\":true,\n               \"name\":\"FullTimeOrPartTime\"\n            },\n            {\n               \"dataType\":\"integer\",\n               \"description\":\"Business Unit of the role\",\n               \"id\":78,\n               \"isToken\":true,\n               \"name\":\"BusinessUnitId\"\n            },\n            {\n               \"dataType\":\"integer\",\n               \"description\":\"Department ID of the role\",\n               \"id\":79,\n               \"isToken\":true,\n               \"name\":\"DepartmentId\"\n            },\n            {\n               \"dataType\":\"integer\",\n               \"description\":\"Grade ID of the role\",\n               \"id\":80,\n               \"isToken\":true,\n               \"name\":\"GradeId\"\n            },\n            {\n               \"dataType\":\"integer\",\n               \"description\":\"Job Family ID of the Job\",\n               \"id\":81,\n               \"isToken\":true,\n               \"name\":\"JobFamilyId\"\n            },\n            {\n               \"dataType\":\"string\",\n               \"description\":\"Function Code of the Job\",\n               \"id\":82,\n               \"isToken\":true,\n               \"name\":\"JobFunction\"\n            },\n            {\n               \"dataType\":\"integer\",\n               \"description\":\"Job ID\",\n               \"id\":83,\n               \"isToken\":true,\n               \"name\":\"JobId\"\n            },\n            {\n               \"dataType\":\"integer\",\n               \"description\":\"Assignment ID of the hiring manager\",\n               \"id\":84,\n               \"isToken\":true,\n               \"name\":\"HiringManagerAssignmentId\"\n            },\n            {\n               \"dataType\":\"string\",\n               \"description\":\"Internal Description for the requisition\",\n               \"id\":85,\n               \"isToken\":true,\n               \"name\":\"InternalDescriptionHTML\"\n            },\n            {\n               \"dataType\":\"string\",\n               \"description\":\"Boolean to define if the requisition has an unlimited number of openings\",\n               \"id\":86,\n               \"isToken\":true,\n               \"name\":\"UnlimitedOpenings\"\n            },\n            {\n               \"dataType\":\"integer\",\n               \"description\":\"Number of openings within the requisition\",\n               \"id\":87,\n               \"isToken\":true,\n               \"name\":\"NumberOfOpenings\"\n            },\n            {\n               \"dataType\":\"string\",\n               \"description\":\"Type of the requisition\",\n               \"id\":88,\n               \"isToken\":true,\n               \"name\":\"RecruitingType\"\n            },\n            {\n               \"dataType\":\"integer\",\n               \"description\":\"ID of the current state of the requisition\",\n               \"id\":89,\n               \"isToken\":true,\n               \"name\":\"StateId\"\n            },\n            {\n               \"dataType\":\"integer\",\n               \"description\":\"Id of the current phase of the requisition\",\n               \"id\":90,\n               \"isToken\":true,\n               \"name\":\"PhaseId\"\n            },\n            {\n               \"dataType\":\"integer\",\n               \"description\":\"Id of the primary location for the role\",\n               \"id\":91,\n               \"isToken\":true,\n               \"name\":\"PrimaryLocationId\"\n            },\n            {\n               \"dataType\":\"integer\",\n               \"description\":\"Id of the recruiter for the requisition\",\n               \"id\":92,\n               \"isToken\":true,\n               \"name\":\"RecruiterId\"\n            },\n            {\n               \"dataType\":\"integer\",\n               \"description\":\"Id of the hiring manager\",\n               \"id\":93,\n               \"isToken\":true,\n               \"name\":\"HiringManagerId\"\n            },\n            {\n               \"dataType\":\"string\",\n               \"description\":\"Title of the role that is being filled under the requisition\",\n               \"id\":94,\n               \"isToken\":true,\n               \"name\":\"Title\"\n            },\n            {\n               \"dataType\":\"string\",\n               \"description\":\"Unique identifier for the requisition\",\n               \"id\":95,\n               \"isToken\":true,\n               \"name\":\"RequisitionNumber\"\n            }\n         ]\n      },\n      \"businessObject\":{\n         \"objectCode\":\"ORA_HCM_RECRUITING_CREATEJOBREQUIS\",\n         \"name\":\"Create Job Requisition\",\n         \"description\":\"Business object to create new job requisition\"\n      },\n      \"name\":\"create_recruitingJobRequisitions\",\n      \"description\":\"Submit all recruiting job requisitions\"\n   },\n   {\n      \"implementation\":{\n         \"resourcePath\":\"/hcmRestApi/resources/11.13.18.05/recruitingJobRequisitions/{recruitingJobRequisitions_Id}\",\n         \"resourceType\":\"ADF_BC_FIXED_QUERY\",\n         \"operationType\":\"GET\",\n         \"parameters\":[\n            {\n               \"dataType\":\"string\",\n               \"description\":\"The value of this parameter could be a hash of the key that is used to uniquely identify the resource item. The client should not generate the hash key value. Instead, the client should query on the collection resource with a filter to navigate to a specific resource item. For example: products?q=InventoryItemId=\",\n               \"id\":9,\n               \"isToken\":true,\n               \"name\":\"recruitingJobRequisitions_Id\"\n            }\n         ]\n      },\n      \"businessObject\":{\n         \"objectCode\":\"ORA_HCM_RECRUITING_GETJOBREQUISITIONDETAILS\",\n         \"name\":\"GetJobRequisitionDetails\",\n         \"description\":\"Rest service to get details of a Job Requisition details based on Requisition Id.\"\n      },\n      \"name\":\"get_recruitingJobRequisitions\",\n      \"description\":\"Get a recruiting job requisition\"\n   },\n   {\n      \"implementation\":{\n         \"resourcePath\":\"/hcmRestApi/resources/11.13.18.05/recruitingJobRequisitions/{recruitingJobRequisitions_Id}\",\n         \"resourceType\":\"ADF_BC_FIXED_QUERY\",\n         \"operationType\":\"GET\",\n         \"parameters\":[\n            {\n               \"dataType\":\"string\",\n               \"description\":\"limit\",\n               \"id\": 11,\n               \"isToken\":true,\n               \"name\":\"limit\"\n            },\n            {\n               \"dataType\":\"string\",\n               \"description\":\"offset\",\n               \"id\":12,\n               \"isToken\":true,\n               \"name\":\"offset\"\n            }\n         ]\n      },\n      \"businessObject\":{\n         \"objectCode\":\"ORA_HCM_OTHER_AISTUDIOAGENTTEAMSWITHSPEC\",\n         \"name\":\"AIStudioAgentTeamsWithSpec\",\n         \"description\":\"Business object representing AI Studio Agent Teams artifact.\"\n      },\n      \"name\":\"getall_hcmAgentWorkflowsV2\",\n      \"description\":\"Get all agent workflows\"\n   }\n];\n\nreturn ret;"
          },
