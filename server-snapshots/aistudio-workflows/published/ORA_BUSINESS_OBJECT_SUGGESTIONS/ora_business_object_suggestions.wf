        {
          "metadata": {
            "name": "parse",
            "returnType": "object",
            "sourceCode": "if (!$context.$nodes.READDB.$output || !$context.$nodes.READDB.$output[0] ) {\n  return; \n}\nconst defaultRet = $context.$nodes.READDB.$output[0].text;\nlet bo_code = defaultRet.split(\"¿\")[0];\nlet bo_function_name = defaultRet.split(\"¿\")[1];\nlet bo_function_desc = defaultRet.split(\"¿\")[2];\n\nreturn [bo_code, bo_function_name, bo_function_desc]"
          },
          "outcomes": {
            "success": "1766521164865"
          },
