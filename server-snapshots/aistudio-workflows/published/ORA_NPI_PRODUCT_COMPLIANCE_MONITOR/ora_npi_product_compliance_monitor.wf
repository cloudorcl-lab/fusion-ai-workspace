        {
          "metadata": {
            "errorNodeId": "1760954519105",
            "name": "Extract Details from Action Message",
            "returnType": "string",
            "sourceCode": "const formSubmitString= $context.$triggers.REST.$input.OraAction;\nvar result = {};\nconst contentMatch = formSubmitString.includes(\"update_reach_compliance_form\");\n if (contentMatch) {\n var start = formSubmitString.indexOf('>') + 1;\n  var end = formSubmitString.lastIndexOf('</oraFormSubmit>');\n  var jsonString = formSubmitString.substring(start, end);\n  var data = JSON.parse(jsonString);\n  var manufacturerItem = data.find(function(item) {\n    return item.id === 'pManufacturerItem';\n   });\n   if (!manufacturerItem) return {};\n  var parts = manufacturerItem.value.split('::');\n  var output = {\n  ACTUAL_ITEM_NO: parts[0] || '',\n  MFG_ITEM_NO: parts[1] || ''\n  };\nresult=output;\n\n  }\n\n  return result;"
          },
          "outcomes": {
