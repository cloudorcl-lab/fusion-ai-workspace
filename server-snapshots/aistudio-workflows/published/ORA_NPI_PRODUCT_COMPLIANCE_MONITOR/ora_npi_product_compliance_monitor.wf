            "sourceCode": "const data = $context.$nodes.GETITEMANDCOMPLIANCEINFO.$output;\nconst action = $context.$triggers.REST.$input.OraAction ;\nconst itemNumber = action .split(\":\")[1];\nconst itemAlternate= $context.$nodes.GETALTERNATEITEMS.$output.result ;\nconst matches = itemAlternate.filter(item => item.ItemNumber === itemNumber);\nreturn JSON.stringify(matches);"
