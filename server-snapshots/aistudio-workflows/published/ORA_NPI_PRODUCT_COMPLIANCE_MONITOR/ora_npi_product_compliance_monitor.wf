        {
          "metadata": {
            "errorNodeId": "1760954519105",
            "name": "GetDynamicFilter",
            "returnType": "object",
            "sourceCode": "const appContext=$context.$triggers.REST.$input.OraAppContext;\nconst values = appContext.split(':');\nlet [itemId,orgCode,eff] = values;\nif(!itemId && !orgCode){\nthrow new Error(\"Item or Org not found in context\");\n}\neff = (eff !=null && eff !='')?eff:'';\nconst filterValues = {\nitemId: `${itemId}`,\norgCode: `${orgCode}`,\neff: `${eff}`,\nitemSearchParams:`ItemId=${itemId} and OrganizationCode='${orgCode}'&fields=BillSequenceId,OrganizationId,ItemId`\n};\nreturn filterValues ;"
          },
          "outcomes": {
            "success": "1762442048951"
          },
          "code": "GETDYNAMICFILTER",
          "id": "1769705620843",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
