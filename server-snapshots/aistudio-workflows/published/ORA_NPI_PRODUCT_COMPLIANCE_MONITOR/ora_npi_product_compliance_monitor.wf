        {
          "metadata": {
            "errorNodeId": "1760954519105",
            "name": "CreateItemList",
            "returnType": "object",
            "sourceCode": "var items = $context.$nodes.GETITEMDETAILSFROMBOM.$output.items;\nvar csv = \"\";\nfor (var i = 0; i < items.length; i++) {\nvar id = items[i] && items[i].ComponentItemId;\nif (!id) continue;\nif (csv.length > 0) csv += \",\";\ncsv += id;\n}\n\nconst filterValues = {\nitemList: `${csv}`,\nitemSearchParams:`Item.InventoryItemId in (${csv})&fields=Item.ItemNumber,Item.InventoryItemId,Item.Description.US,ManufacturerItemRelation.ManufacturerItem.ManufacturerItemNumber,ManufacturerItemRelation.ManufacturerItem.Manufacturer.ManufacturerName,ManufacturerItemRelation.ManufacturerItemId,ManufacturerItemRelation.MfgRelationshipStatus,ItemEff.ItemEffBasePVO`\n};\nreturn filterValues ;"
          },
          "outcomes": {
            "success": "1762443018965"
          },
