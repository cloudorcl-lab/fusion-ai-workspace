            "sourceCode": "let output = \"OTHERS\";\nif( $context.$triggers.REST.$input.OraAction !=null){\n\nconst input = $context.$triggers.REST.$input.OraAction;\nif (input && typeof input === 'string') {\nif ( input.includes(\"update_reach_compliance_form\")) {\n output = \"REACH\";\n}\nelse{\noutput = $context.$triggers.REST.$input.OraAction.includes(\"REACH\")?\"REACH\":\"OTHERS\";\n}\n}\n}\n\nreturn output ;"
          },
