          "inputs": [],
          "type": "PARALLEL"
        },
        {
          "metadata": {
            "errorNodeId": "1760954519105",
            "name": "GetAlternateItems",
            "returnType": "object",
            "sourceCode": "const payload= $context.$nodes.GETITEMANDCOMPLIANCEINFO.$output.hits;\nlet result = null;\n  if (!payload || !Array.isArray(payload.hits)) result =[];\n\n  result = payload.hits.flatMap((hit) => {\n    const itemNumber = hit?._source?.Item?.ItemNumber ?? null;\n    const relations = hit?._source?.ManufacturerItemRelation ?? [];\n\n    const alternates = relations\n      .filter((rel) => rel?.MfgRelationshipStatus === \"ORA_ALTERNATE\")\n      .map((rel) => ({\n        ItemNumber: itemNumber,\n        ManufacturerItemNumber: rel?.ManufacturerItem?.ManufacturerItemNumber ?? null,\n      }));\n\n    // If no alternates for this item, contribute nothing\n    return alternates;\n  });\n\nreturn result;"
          },
          "outcomes": {
            "success": "1761344980039"
          },
          "code": "GETALTERNATEITEMS",
          "id": "1771306593993",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "description": "Add node for branch 2",
            "name": "Add 2"
          },
