        },
        {
          "metadata": {
            "errorNodeId": "1760954519105",
            "name": "GetAtttachments",
            "returnType": "object",
            "sourceCode": "const payload= $context.$nodes.GETITEMANDCOMPLIANCEINFO.$output;\nconst payload2= $context.$nodes.GETMPNDECLARATIONATTACHMENTS.$output;\nconst result = [];\n\nconst p1Hits = Array.isArray(payload?.response?.hits?.hits)\n    ? payload.response.hits.hits\n    : Array.isArray(payload?.hits?.hits)\n      ? payload.hits.hits\n      : [];\n\n  const p2Items = Array.isArray(payload2?.items) ? payload2.items : [];\n  const keywords = [\"compliance\", \"certification\", \"reach\", \"rohs\",\"declaration\"];\n  const keywordRe = new RegExp(keywords.join(\"|\"), \"i\");\n  const tpIdsWithQualifiedAttachments = new Set(\n    p2Items\n      .filter((it) => {\n        const attItems = Array.isArray(it?.Attachments?.items) ? it.Attachments.items : [];\n          const hasQualified = attItems.some((att) => {\n          const title = att?.Title?? \"\";\n          const fileName = att?.FileName ?? \"\";\n           const titleStr = String(title);\n           const fileNameStr = String(fileName);\n           const matched = keywordRe.test(fileNameStr) || keywordRe.test(titleStr);\n           return matched;\n        });\n    \n        return hasQualified;\n      })\n      .map((it) => {\n        const idStr = String(it?.TradingPartnerItemId);\n        return idStr;\n      })\n  );\n  for (const hit of p1Hits) {\n       const src = hit?._source;\n       const itemId = src?.Item?.InventoryItemId;\n       const itemIdStr = itemId != null ? String(itemId) : null;\n\n    if (itemId == null) {\n          continue;\n    }\n\n    const relations = Array.isArray(src?.ManufacturerItemRelation)      ? src.ManufacturerItemRelation : [];\n\n    let hasAttachment = \"no\";\n    for (const rel of relations) {\n       const isPreferred = rel?.MfgRelationshipStatus === \"ORA_PREFERRED\";\n      \n      if (isPreferred) {\n        const manufacturingRId = rel?.ManufacturerItemId;\n         const lookupKey = String(manufacturingRId);\n        const inSet =\n          manufacturingRId != null &&\n          tpIdsWithQualifiedAttachments.has(lookupKey);\n    \n\n        if (inSet) {\n          hasAttachment = \"yes\";\n            break;\n        }\n      }\n    }\n\n    const entry = { inventoryItemId: itemIdStr, hasAttachment };\n    result.push(entry);\n   \n  }\n return result;"
          },
          "outcomes": {
            "success": "1761344980039"
          },
          "code": "GETATTTACHMENTS",
          "convergenceTargetId": "1771306741160",
          "id": "1771020497973",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
