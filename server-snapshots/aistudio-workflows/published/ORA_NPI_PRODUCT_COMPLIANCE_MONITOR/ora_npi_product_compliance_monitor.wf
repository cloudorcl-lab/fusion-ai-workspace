            "name": "GetPayload",
            "returnType": "object",
            "sourceCode": "const payload= $context.$nodes.GETITEMANDCOMPLIANCEINFO.$output;\n const context= $context.$nodes.GETDYNAMICFILTER.$output.result.eff;\n const results = [];\n  const stack = [{ node: payload, item: null }];\n  const byKey = Object.create(null);\n\n  // Derive up to two dynamic contexts from the input string\n  let tokens = [];\n  if (typeof context === \"string\") {\n    tokens = context\n      .split(\",\")\n      .map((s) => s.trim())\n      .filter((s) => s.length > 0);\n  }\n  if (tokens.length === 0) {\n    tokens = [\"rohs\", \"reach\"];\n  } else if (tokens.length > 2) {\n    tokens = tokens.slice(0, 2);\n  }\n\n  // Build case-insensitive, escaped regexes for each context\n  const regexes = tokens.map((t) => {\n    const esc = t.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n    return new RegExp(esc, \"i\");\n  });\n\n  // Output keys are the first word (lowercased) of each context\n  const outKeys = tokens.map((t, idx) => {\n    const first = (t.trim().split(/\\s+/)[0] || `context${idx + 1}`).toLowerCase();\n    return first;\n  });\n\n  while (stack.length) {\n    const frame = stack.pop();\n    const current = frame.node;\n    const itemCtx = frame.item;\n\n    if (Array.isArray(current)) {\n      for (let i = 0; i < current.length; i++) {\n        const item = current[i];\n        if (item && (typeof item === \"object\" || Array.isArray(item))) {\n          stack.push({ node: item, item: itemCtx });\n        }\n      }\n      continue;\n    }\n\n    if (current && typeof current === \"object\") {\n      // Update Item context if this object owns an \"Item\" member\n      let nextItemCtx = itemCtx;\n      if (Object.prototype.hasOwnProperty.call(current, \"Item\")) {\n        const maybeItem = current[\"Item\"];\n        if (maybeItem && typeof maybeItem === \"object\" && !Array.isArray(maybeItem)) {\n          nextItemCtx = maybeItem;\n        }\n      }\n\n      // Check if current object is a context node with a matching ContextCode\n      let matchedFlags = new Array(regexes.length).fill(false);\n      let hasAnyMatch = false;\n\n      for (const key in current) {\n        if (!Object.prototype.hasOwnProperty.call(current, key)) continue;\n        const val = current[key];\n        if (typeof key === \"string\" && key.toLowerCase() === \"contextcode\" && typeof val === \"string\") {\n          for (let i = 0; i < regexes.length; i++) {\n            if (regexes[i].test(val)) {\n              matchedFlags[i] = true;\n              hasAnyMatch = true;\n            }\n          }\n          break;\n        }\n      }\n\n      if (hasAnyMatch && nextItemCtx) {\n        // Determine grouping key for the Item (prefer InventoryItemId, else ItemNumber, else serialized object)\n        let itemKey = null;\n        if (Object.prototype.hasOwnProperty.call(nextItemCtx, \"InventoryItemId\")) {\n          itemKey = \"inv:\" + String(nextItemCtx[\"InventoryItemId\"]);\n        } else if (Object.prototype.hasOwnProperty.call(nextItemCtx, \"ItemNumber\")) {\n          itemKey = \"num:\" + String(nextItemCtx[\"ItemNumber\"]);\n        } else {\n          try {\n            itemKey = \"obj:\" + JSON.stringify(nextItemCtx);\n          } catch (e) {\n            itemKey = \"obj:\" + String(Date.now()) + \":\" + String(Math.random());\n          }\n        }\n\n        if (!byKey[itemKey]) {\n          const entry = { Item: JSON.parse(JSON.stringify(nextItemCtx)) };\n          // Initialize only the keys for the provided contexts\n          for (let i = 0; i < outKeys.length; i++) entry[outKeys[i]] = null;\n          byKey[itemKey] = entry;\n        }\n\n        // Attach the matched node(s) into the appropriate dynamic keys (first occurrence only)\n        for (let i = 0; i < matchedFlags.length; i++) {\n          if (matchedFlags[i] && byKey[itemKey][outKeys[i]] === null) {\n            byKey[itemKey][outKeys[i]] = JSON.parse(JSON.stringify(current));\n          }\n        }\n      }\n\n      // Continue traversal\n      for (const key in current) {\n        if (!Object.prototype.hasOwnProperty.call(current, key)) continue;\n        const child = current[key];\n        if (child && (typeof child === \"object\" || Array.isArray(child))) {\n          stack.push({ node: child, item: nextItemCtx });\n        }\n      }\n    }\n  }\n\n  // Emit one entry per grouped Item\n  for (const k in byKey) {\n    if (Object.prototype.hasOwnProperty.call(byKey, k)) {\n      results.push(byKey[k]);\n    }\n  }\n\n  return results;"
          },
          "outcomes": {
            "success": "1771110810252"
          },
          "code": "GETPAYLOAD",
          "convergenceTargetId": "1771110693236",
          "id": "1771092958726",
