          "metadata": {
            "errorNodeId": "1760954519105",
            "name": "GenerateForm",
            "returnType": "string",
            "sourceCode": "var records = [];\nconst payload = $context.$nodes.GET_REPLACEMENT_DETAILS.$output; \nif (payload && payload.result != null) {\nrecords = payload.result;\n}\n\nif (!Array.isArray(records)) records = [];\n\n  var options = [];\n  for (var i = 0; i < records.length; i++) {\n    var rec = records[i] || {};\n    var itemNumber = rec.ItemNumber != null ? String(rec.ItemNumber) : \"\";\n    var manufacturerItemNumber = rec.ManufacturerItemNumber != null ? String(rec.ManufacturerItemNumber) : \"\";\n    var combined = itemNumber + \"::\" + manufacturerItemNumber;\n    options.push({\n      value: combined,\n      label: \"ManufacturerItem - \" + combined\n    });\n  }\nvar output = {\n    fields: [\n      {\n        id: \"pManufacturerItem\",\n        label: \"Manufacturer Item\",\n        value: options.length > 0 ? options[0].value : \"\",\n        type: \"select\",\n        options: options\n      },\n      {\n        id: \"pReplace\",\n        label: \"Confirm\",\n        value: \"Yes\",\n        type: \"select\",\n        options: [\n          { value: \"Yes\", label: \"YES\" }\n        ]\n      }\n    ]\n  };\n  return output ;"
          },
